[st row places shadow-of {:keys [path rel] :as loc}]\\n  1159\\t  (let [[st children']\\n  1160\\t        (reduce (fn [[st acc] [coord c]]\\n  1161\\t                  (if (:error st)\\n  1162\\t                    (reduced [st acc])\\n  1163\\t                    (let [[st c'] (expand-node st c\\n  1164\\t                                               (assoc loc\\n  1165\\t                                                      :path (conj path coord)\\n  1166\\t                                                      :rel (conj rel coord)\\n  1167\\t                                                      :shadow (shadow-of coord)))]\\n  1168\\t                      [st (conj acc c')])))\\n  1169\\t                [st []]\\n  1170\\t                places)]\\n  1171\\t    (if (:error st)\\n  1172\\t      [st (first row)]\\n  1173\\t      (let [[index a'] (rebuild-row (:index st) row places children')]\\n  1174\\t        [(assoc st :index index) a']))))\\n  1175\\t\\n  1176\\t\\n  1177\\t(defn- expand-node\\n  1178\\t  \\\"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\\n  1179\\t   `rel` path within the current `frame` (`{:root r :parent event|nil\\n  1180\\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\\n  1181\\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\\n  1182\\t   answers the origin of the admission or generation event that\\n  1183\\t   produced the syntax of the row at `address`. Every application\\n  1184\\t   occurrence is recorded under its absolute path as it is visited, so\\n  1185\\t   the finalizer can name each occurrence's real origin; an occurrence\\n  1186\\t   replaced by an expansion is re-recorded by the expansion's own walk,\\n  1187\\t   and a stale entry for a path the finished tree no longer applies at\\n  1188\\t   is simply never read. Returns `[st address']`; a failure sets\\n  1189\\t   `(:error st)`.\\\"\\n  1190\\t  [st address {:keys [shadow] :as loc}]\\n  1191\\t  (if (:error st)\\n  1192\\t    [st address]\\n  1193\\t    (let [row (get (:index st) address)\\n  1194\\t          tag (row-tag row)]\\n  1195\\t      (cond\\n  1196\\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\\n  1197\\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\\n  1198\\t\\n  1199\\t        (= :application tag)\\n  1200\\t        (let [st (update-in st [:call-site-origins]\\n  1201\\t                            assoc (:path loc) ((:origin-of loc) address))\\n  1202\\t              op (nth row 2)\\n  1203\\t              [st op'] (expand-node st op (-> loc\\n  1204\\t                                              (update :path conj 2)\\n  1205\\t                                              (update :rel conj 2)))]\\n  1206\\t          (if (:error st)\\n  1207\\t            [st address]\\n  1208\\t            (let [[index app'] (if (= op op')\\n  1209\\t                                 [(:index st) address]\\n  1210\\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\\n  1211\\t                  st (assoc st :index index)\\n  1212\\t                  row' (get index app')]\\n  1213\\t              (if (macro-of st op' shadow)\\n  1214\\t                ;; recognition is not expansion: depth is unchanged\\n  1215\\t                (expand-node st app' loc)\\n  1216\\t                (expand-children st row' (rest (child-places row'))\\n  1217\\t                                 (constantly shadow) loc)))))\\n  1218\\t\\n  1219\\t        :else\\n  1220\\t        (let [shadow' (if (= :lambda tag) (into shadow (nth row 2)) shadow)]\\n  1221\\t          (expand-children st row (child-places row)\\n  1222\\t                           (constantly shadow') loc))))))\\n  1223\\t\\n  1224\\t\\n  1225\\t;; =============================================================================\\n  1226\\t;; The batch (§3.1, §3.2)\\n  1227\\t;; =============================================================================\\n  1228\\t\\n  1229\\t(defn- log-packet\\n  1230\\t  [st]\\n  1231\\t  [:yin.macro/log (:events st) (:produced st)])\\n  1232\\t\\n  1233\\t\\n  1234\\t(defn- with-default-guards\\n  1235\\t  [ctx]\\n  1236\\t  (update ctx :guards #(merge default-guards %)))\\n  1237\\t\\n  1238\\t\\n  1239\\t(defn- batch-call-site-claims\\n  1240\\t  \\\"The per-member call-site (C1) claim verdicts the encoder recorded on\\n  1241\\t   `batch`: nil when no member claimed coverage, otherwise one boolean\\n  1242\\t   per member — the encoder validated every member's markers against\\n  1243\\t   its own tree at the boundary, so a member whose markers do not\\n  1244\\t   exactly cover it was refused there, never delivered here. Each\\n  1245\\t   member's own verdict decides its metadata: only a member that\\n    75\\t               {:name (first missing) :manifest (second missing)})\\n    76\\t\\n    77\\t      :else\\n    78\\t      {:store-keys (:store-keys own)\\n    79\\t       :effects (into (or (:effects own) #{})\\n    80\\t                      (concat (mapcat :yin.k/effects (vals primitives))\\n    81\\t                              (mapcat (fn [address]\\n    82\\t                                        (get-in (jing/get handle address nil)\\n    83\\t                                                [:yin.module/footprint :effects]))\\n    84\\t                                      (vals requires))))})))\\n    85\\t\\n    86\\t\\n    87\\t(def code-formats\\n    88\\t  \\\"The four code format records a module manifest links through.\\\"\\n    89\\t  [linker/ast-format linker/semantic-format\\n    90\\t   linker/stack-format linker/register-format])\\n    91\\t\\n    92\\t\\n    93\\t;; =============================================================================\\n    94\\t;; Call-site occurrence contract C1 (Addendum A, design §2)\\n    95\\t;; =============================================================================\\n    96\\t;;\\n    97\\t;; A module whose frontend finalized its tree (`:yang/call-site 1` on\\n    98\\t;; every final `:application` occurrence) publishes its frontend-metadata\\n    99\\t;; side table with its manifest: the manifest keeps schema 1 (a manifest\\n   100\\t;; address names code) and gains the optional `:yin.module/call-sites`\\n   101\\t;; reference `{table record}` — the module closure follows manifest\\n   102\\t;; references, so only a referenced table travels with the module\\n   103\\t;; through transfer. The reverse record names the tree root, the\\n   104\\t;; publication's recorded admission origin, and the table's address; it\\n   105\\t;; cannot name the manifest (the manifest references it, so the two\\n   106\\t;; addresses would be circular), and custody runs one way, from the\\n   107\\t;; manifest forward. The publication's origin is an ADMISSION identity\\n   108\\t;; (design §2.1): a token the composition pins explicitly, draws from\\n   109\\t;; a composition-owned scope object, or — by default — has derived\\n   110\\t;; from the publication specification's own durable identity; no\\n   111\\t;; counter or other mutable state lives in this namespace. The token\\n   112\\t;; is persisted in the record and retrieved from the record, never\\n   113\\t;; reconstructed from the tree's content. The publisher\\n   114\\t;; extracts the markers from the map AST, refuses the\\n   115\\t;; publication when they do not exactly cover the canonical tree's\\n   116\\t;; application occurrences — or when a marker's value is not version 1 —\\n   117\\t;; and otherwise materializes the table and its record into the same\\n   118\\t;; handle. A module with no markers makes no claim and publishes exactly\\n   119\\t;; as before.\\n   120\\t\\n   121\\t(defn admission-scope\\n   122\\t  \\\"An admission scope for `publish-module!`'s `:yin.link.publish/scope`\\n   123\\t   option. `id` names this publisher — a durable, caller-chosen\\n   124\\t   identity (a string or keyword) that distinguishes this publisher's\\n   125\\t   admissions from every other publisher's; a publisher that must not\\n   126\\t   collide with its own past runs takes a fresh `id` per run. The\\n   127\\t   returned scope object OWNS the publication ordinal counter, so no\\n   128\\t   counter lives in this namespace (no hidden global state): two\\n   129\\t   publications through one scope draw consecutive ordinals, and two\\n   130\\t   independent scopes publishing identical specifications still yield\\n   131\\t   distinct admission identities, because their `id`s differ.\\\"\\n   132\\t  [id]\\n   133\\t  {:yin.link.publish/scope-id id\\n   134\\t   :yin.link.publish/ordinal (atom 0)})\\n   135\\t\\n   136\\t(defn- scope-admission-token\\n   137\\t  \\\"The admission token a scope object draws for one publication: the\\n   138\\t   scope's own `id` plus the ordinal the scope's counter assigns. The\\n   139\\t   counter lives in the caller-owned scope object, never here.\\\"\\n   140\\t  [{:yin.link.publish/keys [scope-id ordinal]}]\\n   141\\t  ;; pr-str keeps the value's full identity — a keyword's namespace, a\\n   142\\t  ;; string's quoting, a symbol's name — so distinct caller-chosen ids\\n   143\\t  ;; (:a/publisher, :b/publisher, \\\"publisher\\\") never mint the same token\\n   144\\t  (keyword \\\"yin.vm.linker.publish.scope\\\"\\n   145\\t           (str (pr-str scope-id) \\\"#\\\" (swap! ordinal inc))))\\n   146\\t\\n   147\\t(defn- spec-admission-token\\n   148\\t  \\\"The default admission token: derived deterministically from the\\n   149\\t   publication specification's own durable identity — the module name\\n   150\\t   and the content address of its compiled tree — never from hidden\\n   151\\t   mutable state. Two publications of the same specification therefore\\n   152\\t   answer the same admission identity (an idempotent re-publication is\\n   153\\t   the same recorded admission), and distinct specifications never\\n   154\\t   share one, in this or any other publisher process. A composition\\n   155\\t   that admits the same specification more than once as separate\\n   156\\t   admissions passes an `:yin.link.publish/scope` (or an explicit\\n   157\\t   `:yin.link.publish/admission`) so the admissions stay distinct.\\\"\\n   158\\t  [{:keys [name]} tree]\\n   159\\t  (keyword \\\"yin.vm.linker.publish.publication\\\"\\n   160\\t           (str name \\\"::\\\" (:root tree))))\\n   161\\t\\n   162\\t(defn- publication-origin\\n   163\\t  \\\"The occurrence origin of the publication admission `token` names:\\n   164\\t   the publisher's own medium, the explicit admission token, member 0.\\n   165\\t   `token` is the publication's admission identity — the\\n   166\\t   `:yin.link.publish/admission` option when the composition pins one,\\n   167\\t   the `:yin.link.publish/scope` option's next drawn token when the\\n   168\\t   composition scopes the publisher, otherwise the token derived from\\n   169\\t   the publication specification's own durable identity. The origin is\\n   170\\t   an admission event's identity, not a function of the tree's content\\n   171\\t   alone: it is persisted in the side record at publication time and\\n   172\\t   retrieved from that record; nothing ever reconstructs it from the\\n   173\\t   root.\\\"\\n   174\\t  [token]\\n   175\\t  [:source :yin.vm.linker.publish/publish token 0])\\n   176\\t\\n   177\\t\\n   178\\t(defn- claims-call-sites?\\n   179\\t  \\\"True when map AST `ast` carries the C1 key anywhere. A hit inside a\\n   180\\t   literal payload is data, not a claim: extraction then finds no\\n   181\\t   markers and the module publishes unannotated, as it should.\\\"\\n   182\\t  [ast]\\n   183\\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\\n   184\\t\\n   185\\t\\n   186\\t(defn- call-site-claim\\n   187\\t  \\\"The C1 claim `ast` makes over its canonical `tree`: nil when it\\n   188\\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\\n   189\\t   when the extracted markers exactly cover the tree's eligible\\n   190\\t   application occurrences; `{:missing [...] :extra [...]}` when they\\n   191\\t   do not; `{:unsupported-version v :path p}` when a marker's value is\\n   192\\t   not version 1 — a claim rejection, never a silent acceptance of a\\n   193\\t   table a retriever would read as version 1.\\\"\\n   194\\t  [ast tree admission]\\n   195\\t  (when (claims-call-sites? ast)\\n   196\\t    (let [origin (publication-origin admission)\\n   197\\t          extracted (filter #(= :yang/call-site (nth % 3))\\n   198\\t                            (:frontend-metadata\\n   199\\t                              (vm/ast-side-tables ast tree origin)))\\n   200\\t          eligible (into #{}\\n   201\\t                         (map (fn [[r p]] [origin r p]))\\n   202\\t                         (vm/application-occurrences tree))\\n   203\\t          marked (into #{}\\n   204\\t                       (map (fn [[o r p _ _]] [o r p]))\\n   205\\t                       extracted)]\\n   206\\t      (or (when-let [[v p] (some (fn [row]\\n   207\\t                                   (let [v (nth row 4)]\\n   208\\t                                     (when (not (and (integer? v) (= 1 v)))\\n   209\\t                                       [v (subvec row 0 3)])))\\n   210\\t                                 extracted)]\\n   211\\t            {:unsupported-version v, :path p})\\n   212\\t          (if (= eligible marked)\\n   213\\t            {:origin origin, :rows (vec (sort-by pr-str extracted))}\\n   214\\t            {:missing (vec (sort-by pr-str (remove marked eligible))),\\n   215\\t             :extra (vec (sort-by pr-str (remove eligible marked)))})))))\\n   216\\t\\n   217\\t\\n   218\\t(defn link-local\\n   219\\t  \\\"Link `format`'s image through the manifest `address` over `handle`'s\\n   220\\t   own content, `:verifying` with discharge deferred, as a serving\\n   221\\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\\n   222\\t   call, so no request reaches any peer.  `opts` overrides the link\\n   223\\t   options; its `:bounds` are the runtime's composition bounds (section\\n   224\\t   4.2 step 2), every one left out taking `linker/default-bounds`.\\\"\\n   225\\t  ([handle address format] (link-local handle address format nil))\\n   226\\t  ([handle address format opts]\\n   227\\t   (linker/link-manifest\\n   228\\t     (linker/local-runtime\\n   229\\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\\n   230\\t                              (conj code-formats linker/manifest-format\\n   231\\t                                    linker/record-format))\\n   232\\t               :bounds (:bounds opts)})\\n   233\\t     address (:format format) {:primitives vm/primitives}\\n   234\\t     (merge {:contract (:contract format)\\n   235\\t             :derivation :verifying\\n   236\\t             :defer-discharge true}\\n   237\\t            (dissoc opts :bounds)))))\\n   238\\t\\n   239\\t\\n   240\\t(defn- publish-closure!\\n   241\\t  \\\"`publish-module!` under the composition bounds of `opts`.\\\"\\n   242\\t  [handle {:keys [name ast exports requires primitives] :as spec} opts]\\n   243\\t  (let [undefined (first (remove (definitions ast) exports))\\n   244\\t        tree (when-not undefined\\n   245\\t               (try (vm/ast->semantic-bytecode ast)\\n   246\\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\\n   247\\t                      (refusal :yin.link.publish/malformed-tree {}))))\\n   248\\t        defect (when (and tree (not= :refused (:status tree)))\\n   249\\t                 (vm/validate-rows tree))\\n   250\\t        ;; each pinned closure is walked before anything is written; an\\n   251\\t        ;; absent pinned manifest is the footprint's missing-requirement\\n   252\\t        requirement\\n   253\\t        (when (and tree (not defect) (not= :refused (:status tree)))\\n   254\\t          (some (fn [[n address]]\\n   255\\t                  (let [w (closure/walk handle address opts)]\\n   256\\t                    (case (:yin.link.closure/outcome w)\\n   257\\t                      :complete nil\\n   258\\t                      :invalid (refusal :yin.link.publish/invalid-requirement\\n   259\\t                                        {:name n})\\n   260\\t                      :missing (when (not= address (:address w))\\n   261\\t                                 (refusal :yin.link.publish/incomplete-requirement\\n   262\\t                                          {:name n :walk w})))))\\n   263\\t                (sort-by (fn [[n _]] (str n)) requires)))\\n   264\\t        fp (when (and tree (not defect) (not requirement)\\n   265\\t                      (not= :refused (:status tree)))\\n   266\\t             (footprint handle (assoc spec :tree tree)))\\n   267\\t        ;; a C1 claim is validated before anything is written: a module\\n   268\\t        ;; whose markers do not cover its tree is never published as\\n   269\\t        ;; though it did. One publication is one admission event\\n   270\\t        ;; (design §2.1): the admission identity is pinned explicitly by\\n   271\\t        ;; the composition when it supplies `:yin.link.publish/admission`,\\n   272\\t        ;; drawn from the composition's own scope object when it supplies\\n   273\\t        ;; `:yin.link.publish/scope`, and otherwise derived from the\\n   274\\t        ;; specification's own durable identity — no counter lives in\\n   275\\t        ;; this namespace. Either way it is persisted in the side record\\n   276\\t        ;; and retrieved from there\\n   277\\t        admission (or (:yin.link.publish/admission opts)\\n   278\\t                      (when-let [scope (:yin.link.publish/scope opts)]\\n   279\\t                        (scope-admission-token scope))\\n   280\\t                      (when tree (spec-admission-token spec tree)))\\n   281\\t        claim (when (and tree (not defect) (not requirement)\\n   282\\t                         (not= :refused (:status tree))\\n   283\\t                         (not= :refused (:status fp)))\\n   284\\t                (call-site-claim ast tree admission))]\\n   285\\t    (cond\\n   286\\t      undefined\\n   287\\t      (refusal :yin.link.publish/undefined-export {:export undefined})\\n   288\\t\\n   289\\t      (= :refused (:status tree)) tree\\n   290\\t\\n   291\\t      defect\\n   292\\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\\n   293\\t\\n   294\\t      requirement requirement\\n   295\\t\\n   296\\t      (= :refused (:status fp)) fp\\n   297\\t\\n   298\\t      ;; dispatch on the key's PRESENCE, not its truthiness: a marker\\n   299\\t      ;; whose value is present but not the integer 1 — nil or false\\n   300\\t      ;; included — carries :unsupported-version nil/false, and its\\n   301\\t      ;; reason is the unsupported version, never incomplete coverage\\n   302\\t      (and claim (contains? claim :unsupported-version))\\n   303\\t      (refusal :yin.link.publish/unsupported-call-site-version claim)\\n   304\\t\\n   305\\t      (and claim (not (:rows claim)))\\n   306\\t      (refusal :yin.link.publish/incomplete-call-site-coverage claim)\\n   307\\t\\n   308\\t      :else\\n   309\\t      (let [tree-address (vm/materialize-tree! handle tree)\\n   310\\t            sem-vector (:vector (linearize/project-rows tree))\\n   311\\t            sem (code/materialize-vector! handle sem-vector)\\n   312\\t            h-image (:image (derive/stack-image sem-vector))\\n   313\\t            r-image (derive/register-image sem-vector)\\n   314\\t            h (dcode/image-hash h-image)\\n   315\\t            r (rcode/register-hash r-image)\\n   316\\t            h-address (jing/materialize! handle h-image)\\n   317\\t            r-address (jing/materialize! handle r-image)\\n   318\\t            mint (fn [input output profile]\\n   319\\t                   (jing/materialize!\\n   320\\t                     handle\\n   321\\t                     (assoc (ledger/derive-record input output)\\n   322\\t                            :yin.ledger/profile profile)))\\n   323\\t            ;; the C1 side table and its reverse record, materialized\\n   324\\t            ;; BEFORE the manifest so the manifest can reference them:\\n   325\\t            ;; the module closure follows manifest references, so only a\\n   326\\t            ;; referenced table travels with the module through transfer\\n   327\\t            call-sites (when (:rows claim)\\n   328\\t                         (let [table (jing/materialize! handle (:rows claim))\\n   329\\t                               record {:yang.call-site/version 1\\n   330\\t                                       :yang.call-site/root tree-address\\n   331\\t                                       :yang.call-site/origin (:origin claim)\\n   332\\t                                       :yang.call-site/table table}]\\n   333\\t                           {:record (jing/materialize! handle record)\\n   334\\t                            :table table\\n   335\\t                            :origin (:origin claim)\\n   336\\t                            :root (:root tree)}))\\n   337\\t            manifest (cond-> {:yin.module/name name\\n   338\\t                              :yin.module/schema linker/manifest-schema\\n   339\\t                              :yin.module/contracts\\n   340\\t                              {:yin.ast/code vm/ast-contract\\n   125\\t        (distinct frontend-metadata)))\\n   126\\t\\n   127\\t\\n   128\\t(defn- marker-row?\\n   129\\t  \\\"True when frontend-metadata `row` claims the C1 key: a sequential row\\n   130\\t   whose fourth coordinate is `call-site-key`. A claiming row of any\\n   131\\t   other arity is malformed, never a row to filter away silently.\\\"\\n   132\\t  [row]\\n   133\\t  (and (sequential? row)\\n   134\\t       (<= 4 (count row))\\n   135\\t       (= call-site-key (nth row 3))))\\n   136\\t\\n   137\\t\\n   138\\t(defn validate-call-site-coverage!\\n   139\\t  \\\"Validate a complete-coverage C1 claim: the marker set of\\n   140\\t   `frontend-metadata` for canonical `tree` under `origin` must equal\\n   141\\t   the eligible application set. Returns true when the claim holds.\\n   142\\t\\n   143\\t   A row that claims the C1 key but is not a five-coordinate\\n   144\\t   `[origin root-address path key value]` row is malformed and is\\n   145\\t   rejected, never silently filtered. The delivery mode is `opts`:\\n   146\\t\\n   147\\t   - default (transport): the relation arrived over a medium, where an\\n   148\\t     at-least-once delivery may repeat a row; duplicate identical\\n   149\\t     deliveries dedupe to the same fact;\\n   150\\t   - `{:declared? true}`: the relation is a declared canonical table —\\n   151\\t     the side table a producer published as the tree's table — where a\\n   152\\t     duplicate entry is a second, conflicting claim to one fact and is\\n   153\\t     rejected;\\n   154\\t   - `{:per-occurrence-origins? true}`: the tree's occurrences do not\\n   155\\t     share one origin — the expander's final tree, whose rows carry\\n   156\\t     each occurrence's own admission or generating-expansion origin\\n   157\\t     (design §2.1, §2.3). Coverage is then compared on the\\n   158\\t     `[root-address path]` projection — the part a consumer derives\\n   159\\t     from canonical rows alone — and every marker's origin is held to\\n   160\\t     a well-formed occurrence origin; the origin VALUES are the\\n   161\\t     producer's correspondence claim, not something a consumer can\\n   162\\t     re-derive.\\n   163\\t\\n   164\\t   Conflicting values at one site, an unsupported marker version, a\\n   165\\t   malformed origin, a marker naming no occurrence, a marker on a\\n   166\\t   non-application occurrence, and missing or extra markers each\\n   167\\t   throw, naming the failed `:rule`.\\\"\\n   168\\t  ([tree frontend-metadata origin]\\n   169\\t   (validate-call-site-coverage! tree frontend-metadata origin {}))\\n   170\\t  ([tree frontend-metadata origin\\n   171\\t    {:keys [declared? per-occurrence-origins?] :as _opts}]\\n   172\\t   (doseq [row frontend-metadata]\\n   173\\t     (when (and (marker-row? row) (not= 5 (count row)))\\n   174\\t       (throw (ex-info \\\"Malformed call-site marker row\\\"\\n   175\\t                       {:rule :yang/call-site-malformed, :row row}))))\\n   176\\t   (when declared?\\n   177\\t     (doseq [[row n] (frequencies (filter marker-row? frontend-metadata))]\\n   178\\t       (when (< 1 n)\\n   179\\t         (throw (ex-info \\\"Duplicate call-site marker in a declared table\\\"\\n   180\\t                         {:rule :yang/call-site-duplicate-entry,\\n   181\\t                          :site (vec (take 3 row)), :row row})))))\\n   182\\t   (let [{:keys [root rows]} tree\\n   183\\t         tag-at (into {}\\n   184\\t                      (map (fn [[r path id]] [[r path] (nth (get rows id) 1)]))\\n   185\\t                      (vm/occurrences tree))\\n   186\\t         eligible ((if per-occurrence-origins?\\n   187\\t                     (fn [_] (vm/application-occurrences tree))\\n   188\\t                     #(eligible-application-sites tree %))\\n   189\\t                   origin)\\n   190\\t         rows (filter (fn [row]\\n   191\\t                        (and (= 5 (count row)) (= call-site-key (nth row 3))))\\n   192\\t                      (distinct frontend-metadata))\\n   193\\t         by-site (group-by (fn [[o r path _ _]] [o r path]) rows)]\\n   194\\t    (doseq [[site srows] by-site]\\n   195\\t      (when (< 1 (count (distinct (map #(nth % 4) srows))))\\n   196\\t        (throw (ex-info \\\"Conflicting call-site marker values\\\"\\n   197\\t                        {:rule :yang/call-site-conflict, :site site,\\n   198\\t                         :values (vec (distinct (map #(nth % 4) srows)))}))))\\n   199\\t    ;; one occurrence — one [root-address path] — has exactly one\\n   200\\t    ;; origin (design §2.1); a second marker with a DIFFERENT, equally\\n   201\\t    ;; well-formed origin for an already-covered occurrence is a\\n   202\\t    ;; second claim to one fact and is rejected, not folded into the\\n   203\\t    ;; [root path] coverage projection. The one-origin-per-occurrence\\n   204\\t    ;; rule holds in EVERY validator mode; the default mode rejects a\\n   205\\t    ;; second claim with the same diagnostic (not a downstream\\n   206\\t    ;; nonexistent-path error) so the failure names the occurrence and\\n   207\\t    ;; both claims.\\n   208\\t    (doseq [[site srows] (group-by (fn [[_ r path]] [r path]) rows)]\\n   209\\t      (let [origins (distinct (map #(nth % 0) srows))]\\n   210\\t        (when (< 1 (count origins))\\n   211\\t          (throw (ex-info\\n   212\\t                   \\\"Call-site occurrence claimed by multiple origins\\\"\\n   213\\t                   {:rule :yang/call-site-multi-claim, :site site,\\n   214\\t                    :origins (vec (sort-by pr-str origins))})))))\\n   215\\t    (doseq [[o r path _ value] rows]\\n   216\\t      (when (not= call-site-version value)\\n   217\\t        (throw (ex-info \\\"Unsupported call-site marker version\\\"\\n   218\\t                        {:rule :yang/call-site-unsupported-version,\\n   219\\t                         :site [o r path], :value value})))\\n   220\\t      (when (and per-occurrence-origins? (not (vm/occurrence-origin? o)))\\n   221\\t        (throw (ex-info \\\"Call-site marker carries a malformed occurrence origin\\\"\\n   222\\t                        {:rule :yang/call-site-invalid-origin,\\n   223\\t                         :site [o r path], :origin o})))\\n   224\\t      (let [tag (when (and (= r root)\\n   225\\t                           (or per-occurrence-origins? (= o origin)))\\n   226\\t                  (get tag-at [r path]))]\\n   227\\t        (cond\\n   228\\t          (nil? tag)\\n   229\\t          (throw (ex-info \\\"Call-site marker names no occurrence\\\"\\n   230\\t                          {:rule :yang/call-site-nonexistent-path,\\n   231\\t                           :site [o r path]}))\\n   232\\t          (not= :application tag)\\n   233\\t          (throw (ex-info \\\"Call-site marker on a non-application occurrence\\\"\\n   234\\t                          {:rule :yang/call-site-non-application,\\n   235\\t                           :site [o r path], :tag tag})))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n16:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'agent_message|P1-a|P1-b|DO NOT LAND' /Users/sto/workspace/datomworld/collab/yang-clojure/1795060000000-architect-p1-recheck.gpt-6-astra.stdout.log /Users/sto/workspace/datomworld/collab/yang-clojure/1795220000000-reviewer-cc1-fix4.codex.stdout.log /Users/sto/workspace/datomworld/collab/yang-clojure/1795050000000-architect-attribution-fix-review.gpt-6-astra.stdout.log | cut -c1-18000\\\"\",\"aggregated_output\":\"/Users/sto/workspace/datomworld/collab/yang-clojure/1795220000000-reviewer-cc1-fix4.codex.stdout.log:4:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_0\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I’ll review the diff and surrounding implementation against the design of record, then check each prior finding and the two specified read paths. I’ll keep the review read-only and won’t run tests.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795220000000-reviewer-cc1-fix4.codex.stdout.log:21:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The global counter is gone, but the replacement’s default identity is derived from the module name and tree. I’m checking how publication is invoked and whether that default can distinguish separate admission events, along with the provenance and validation edge cases.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795220000000-reviewer-cc1-fix4.codex.stdout.log:42:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_20\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"DO NOT LAND\\\\n\\\\n- **P1-a — not closed.** The revised `origin-of` preserves an incoming origin when an output address is found in the input packet, but it still classifies provenance by content address rather than occurrence. If a macro generates an application identical to an input application, the two share an address and the generated occurrence is assigned the input’s origin. The same limitation prevents distinguishing retained occurrences with different origins that share an address. See [macro.cljc:1087](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1087), [macro.cljc:1140](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1140), and [macro.cljc:1200](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1200).\\\\n\\\\n- **P1-b — not closed.** The namespace-global counter is removed, and an explicitly scoped allocator is available. But the default token is derived from module name and tree root, so independent admissions of the same specification receive the same origin, including across processes and restarts. The code treats those calls as a replay without a composition-supplied admission identity establishing that they are one recorded event. The DHT publication entry point uses this default. See [publish.cljc:147](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:147), [publish.cljc:277](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:277), and [dht.cljc:45](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/dht.cljc:45).\\\\n\\\\n- **P2 — partially closed.** Declared tables and per-occurrence-origin validation now reject multiple origins with a diagnostic containing the occurrence and both origins. The default validator mode skips that check; it rejects the foreign-origin row as a nonexistent path instead, without naming both claims. See [clojure.cljc:204](/Users/sto/workspace/datomworld-cc1/src/cljc/yang/clojure.cljc:204) and [clojure.cljc:221](/Users/sto/workspace/datomworld-cc1/src/cljc/yang/clojure.cljc:221).\\\\n\\\\n- **Oracle and closure checks.** The diff does not change the oracle consumer; it still reads the site table and stamps compiled sites at [latte_oracle_test.clj:2394](/Users/sto/workspace/datomworld-cc1/test/yang/latte_oracle_test.clj:2394) and [latte_oracle_test.clj:2464](/Users/sto/workspace/datomworld-cc1/test/yang/latte_oracle_test.clj:2464). Closure walking still reads both manifest references, and the stale comment has been corrected: [closure.cljc:195](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/closure.cljc:195).\\\\n\\\\n- **New finding — scope ID collisions.** The scoped allocator discards keyword namespaces, so distinct caller-chosen IDs such as `:a/publisher` and `:b/publisher` produce the same token at the same ordinal; a string with the same name also collides. See [publish.cljc:140](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:140).\\\\n\\\\nNo tests were run, as requested.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795050000000-architect-attribution-fix-review.gpt-6-astra.stdout.log:3:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_0\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I’ll read the architecture and diff, then trace occurrence identity, member verdicts, and table retrieval through the consumers. I’ll keep the review static and read-only.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795050000000-architect-attribution-fix-review.gpt-6-astra.stdout.log:20:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_9\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The worktree is at `3cd78223`. The saved diff file is absent, so I’m reviewing the commit range directly. The new lookup uses `[origin root]`, and the encoder validates members eagerly; I’m now checking how origins reach callers and how published tables survive transfer.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795050000000-architect-attribution-fix-review.gpt-6-astra.stdout.log:39:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_19\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The overwrite and per-member claim defects are closed, but the origin semantics still conflict with the cited design: every final tree receives the input’s `:source` origin, including trees changed by macro expansion. The publisher also still derives its origin from the content root. I’m separating these remaining identity issues from the fixes that pass review.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795050000000-architect-attribution-fix-review.gpt-6-astra.stdout.log:40:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_20\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"**Request amendments before the codex gate/landing.** The collision and per-member fixes are sound, but the implementation still falls short of §2.1’s origin semantics.\\\\n\\\\n1. **P1 — Generated final trees retain the original source origin.** After expansion, tail marking, and stand-in lowering, the finalizer unconditionally uses `source-origin` ([macro.cljc:1307](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1307)). This distinguishes sequential admissions, but it does not identify generation. [Design §2.1:38](/Users/sto/workspace/datomworld-cc1/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:38) explicitly permits the original source origin for a retained, no-op tree and prohibits labeling generated post-expansion trees as original source. The regression fixture actually asserts a changed final root while expecting the input source origin ([test:264](/Users/sto/workspace/datomworld-cc1/test/yang/clojure_callsite_test.cljc:264)).\\\\n\\\\n   **Amendment:** resolve the real generation provenance and final-root correspondence required by §2.3; retain source origins where applicable. Do not substitute an arbitrary intermediate expansion record or fabricate an expansion event. The new `[origin root]` indexing can remain.\\\\n\\\\n2. **P1 — Published origins still collapse admission into content identity.** `publication-origin` constructs `[:source :yin.vm.linker.publish/publish root 0]` ([publish.cljc:114](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:114)). Consequently, separately published identical trees receive identical origins. Retrieval also reconstructs—and requires—that content-derived origin ([publish.cljc:377](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:377)). This is a residual predecessor issue, not introduced by the new table key, but it contradicts §2.1’s distinct-admission requirement.\\\\n\\\\n   **Amendment:** supply an explicit publication admission identity, persist it in the side record, and retrieve that recorded identity. Add coverage distinguishing two admissions from replay of one recorded admission.\\\\n\\\\nThe remaining requested checks pass static review:\\\\n\\\\n- **Occurrence indexing:** `[origin root]` correctly partitions tables whose rows retain `path`; lookup uses precisely the same pair. Same-root admissions no longer overwrite each other, and an unclaimed later admission cannot retrieve the earlier table ([macro.cljc:1424](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1424), [macro.cljc:1460](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1460)).\\\\n- **Member verdicts:** eager `mapv` validates every member before `some` examines completed verdicts. Finalization reads only `run-index`’s verdict. Both round-3 defects are closed ([encoder.cljc:333](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/encoder.cljc:333), [macro.cljc:1319](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1319)).\\\\n- **Consumers and retrieval:** no stale two-argument callers found. The oracle independently constructs its existing site table ([oracle:2464](/Users/sto/workspace/datomworld-cc1/test/yang/latte_oracle_test.clj:2464)). Manifest references now carry the table and record through closure transfer ([closure.cljc:195](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/closure.cljc:195)).\\\\n- **Boundaries:** canonical code rows remain unchanged; provenance stays in side data. Schema remains `1`, with the optional reference accepted as authorized here. Five-element batches remain valid ([macro.cljc:381](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:381)). Publisher version rejection correctly uses key presence, including `nil` and `false` ([publish.cljc:237](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:237)).\\\\n\\\\nStatic review of `b825498e..3cd78223`; the named saved diff was absent. No files changed or tests run. The supplied Jupiter results support the repaired behaviors, but do not resolve these origin-contract findings.\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795060000000-architect-p1-recheck.gpt-6-astra.stdout.log:3:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_0\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I’ll check the architecture rules, the amendment diff, and the consumer paths, then give a static verdict with file and line citations. I won’t modify files or run tests.\\\\n\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795060000000-architect-p1-recheck.gpt-6-astra.stdout.log:18:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_8\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The retrieval code now reads the stored origin rather than deriving it from the root. I’m checking nested expansions and the oracle’s validator next: those are the main places where mixed provenance could expose a problem.\\\\n\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795060000000-architect-p1-recheck.gpt-6-astra.stdout.log:29:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_14\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I found two blocking residuals. A nested macro that passes through an admitted operand assigns it the enclosing generated call’s origin. The default publication counter also restarts at zero in each process under the same fixed medium, so it can repeat admission identities. The corrected `unless` fixture is valid; it doesn’t exercise the nested case.\\\\n\\\"}}\\n/Users/sto/workspace/datomworld/collab/yang-clojure/1795060000000-architect-p1-recheck.gpt-6-astra.stdout.log:36:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_18\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"**Do not endorse `beb9cc97` for landing yet. Two P1 residuals remain, plus a validator gap.** Reviewed `3cd78223..beb9cc97` statically; no tests run or files modified.\\\\n\\\\n1. **P1-a: nested pass-through loses the operand’s actual origin.**  \\\\n   `expand-call` captures the replaced application’s origin once at [macro.cljc:1087](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1087), then assigns that origin to **every retained input address** at [macro.cljc:1137](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1137). An input packet can already contain mixed origins.\\\\n\\\\n   Static counterexample:\\\\n\\\\n   ```clojure\\\\n   (defmacro pass [x] x)\\\\n   (defmacro wrap [x]\\\\n     (yin/application (yin/variable 'pass) [x]))\\\\n   (wrap (+ 1 2))\\\\n   ```\\\\n\\\\n   `wrap` generates `(pass …)` with origin `Ewrap`, retaining the admitted `(+ 1 2)` operand with source origin `S`. When `pass` expands, `admitted-origin` becomes `Ewrap`; returning `x` incorrectly relabels the admitted `+` application as `Ewrap`.\\\\n\\\\n   Retained occurrences must preserve **their own incoming provenance**, rather than inherit the enclosing call’s origin. The final path walk therefore does not yet establish correct §2.3 correspondence.\\\\n\\\\n2. **P1-b: the default token is not never-repeating.**  \\\\n   [publish.cljc:119](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:119) initializes a namespace-global counter to zero; [publish.cljc:143](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:143) uses the same fixed medium everywhere. Two fresh processes publishing identical specifications at the same counter position produce identical admission origins—and therefore can produce identical tables, records, and manifests. Restarting the publisher has the same problem.\\\\n\\\\n   The new test exercises two calls within one process only ([clojure_callsite_test.cljc:732](/Users/sto/workspace/datomworld-cc1/test/yang/clojure_callsite_test.cljc:732)). Require composition-supplied durable admission identities, or an explicitly scoped allocator whose identities survive independent publishers/restarts. The private global atom also conflicts with the repository’s [no hidden global/shared mutable state rules](/Users/sto/workspace/datomworld-cc1/docs/design/datom.world.md:26).\\\\n\\\\n3. **P2: mixed-origin validation accepts two markers for one occurrence.**  \\\\n   Conflict detection groups by `[origin root path]` at [clojure.cljc:193](/Users/sto/workspace/datomworld-cc1/src/cljc/yang/clojure.cljc:193), but mixed-origin coverage discards origins into a set at [clojure.cljc:220](/Users/sto/workspace/datomworld-cc1/src/cljc/yang/clojure.cljc:220). Consequently, adding another version-1 marker with a different valid origin for an already-covered `[root path]` passes—even with `:declared? true`. Reject multiple origin claims for the same occurrence within the declared table.\\\\n\\\\nThe other parts of the amendments are sound:\\\\n\\\\n- **The corrected `unless` finding is correct.** `yin/if` constructs an `:if` and directly incorporates its operand packets ([macro.cljc:687](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:687)); the admitted `(+ 1 2)` is passed through. A changed enclosing root does not make that application generated. Retaining its source origin is consistent with [§2.1:38](/Users/sto/workspace/datomworld-cc1/collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md:38). I withdraw the earlier fixture-specific objection.\\\\n- **Final-path tracking is appropriate for the final tail/stand-in passes.** Tail marking changes flags while preserving child positions; stand-in lowering replaces leaves with literals ([macro.cljc:877](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:877), [macro.cljc:919](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:919)). The problem is the provenance supplied to that tracking.\\\\n- **Explicit admission tokens and recorded-origin retrieval are the right design.** Given distinct supplied tokens, admissions remain distinct. Retrieval reads `:yang.call-site/origin` from the record, checks its shape and the record’s root/table/version, and does not reconstruct identity from content ([publish.cljc:407](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:407)). Repeated retrieval correctly replays that recorded identity.\\\\n\\\\n**Consumer check:** No direct oracle read-path regression found: it still constructs its own stamped site table and reads that table for attribution ([latte_oracle_test.clj:2464](/Users/sto/workspace/datomworld-cc1/test/yang/latte_oracle_test.clj:2464), [:2394](/Users/sto/workspace/datomworld-cc1/test/yang/latte_oracle_test.clj:2394)). Publication closure traversal still follows both table and record references ([closure.cljc:203](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/closure.cljc:203)); its comment at line 201 about reconstructing origins is now stale. The blocking publication defect is identity allocation, not retrieval.\\\"}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n17:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"agent_message\",\"text\":\"U2 explicitly resolves the deterministic-default objection. U1 still needs scrutiny: `expand-call` selects the incoming origin when an output address appears in the input packet. I’m checking whether the retained records preserve the occurrence distinction that this address-based choice can lose.\"}}\n19:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '136,203p;259,295p;420,495p'\\nnl -ba src/cljc/yin/vm/macro.cljc | sed -n '640,710p;1250,1425p;1500,1575p'\\nnl -ba src/cljc/yang/clojure.cljc | sed -n '135,193p;235,310p'\\nrg -n 'call-site-origins|origin-of|call-site-table|yin.macro/log|expansion-record' src/cljc/yin/vm/macro.cljc src/cljc/yin/vm/encoder.cljc\\\"\",\"aggregated_output\":\"   136\\t(defn- scope-admission-token\\n   137\\t  \\\"The admission token a scope object draws for one publication: the\\n   138\\t   scope's own `id` plus the ordinal the scope's counter assigns. The\\n   139\\t   counter lives in the caller-owned scope object, never here.\\\"\\n   140\\t  [{:yin.link.publish/keys [scope-id ordinal]}]\\n   141\\t  ;; pr-str keeps the value's full identity — a keyword's namespace, a\\n   142\\t  ;; string's quoting, a symbol's name — so distinct caller-chosen ids\\n   143\\t  ;; (:a/publisher, :b/publisher, \\\"publisher\\\") never mint the same token\\n   144\\t  (keyword \\\"yin.vm.linker.publish.scope\\\"\\n   145\\t           (str (pr-str scope-id) \\\"#\\\" (swap! ordinal inc))))\\n   146\\t\\n   147\\t(defn- spec-admission-token\\n   148\\t  \\\"The default admission token: derived deterministically from the\\n   149\\t   publication specification's own durable identity — the module name\\n   150\\t   and the content address of its compiled tree — never from hidden\\n   151\\t   mutable state. Two publications of the same specification therefore\\n   152\\t   answer the same admission identity (an idempotent re-publication is\\n   153\\t   the same recorded admission), and distinct specifications never\\n   154\\t   share one, in this or any other publisher process. A composition\\n   155\\t   that admits the same specification more than once as separate\\n   156\\t   admissions passes an `:yin.link.publish/scope` (or an explicit\\n   157\\t   `:yin.link.publish/admission`) so the admissions stay distinct.\\\"\\n   158\\t  [{:keys [name]} tree]\\n   159\\t  (keyword \\\"yin.vm.linker.publish.publication\\\"\\n   160\\t           (str name \\\"::\\\" (:root tree))))\\n   161\\t\\n   162\\t(defn- publication-origin\\n   163\\t  \\\"The occurrence origin of the publication admission `token` names:\\n   164\\t   the publisher's own medium, the explicit admission token, member 0.\\n   165\\t   `token` is the publication's admission identity — the\\n   166\\t   `:yin.link.publish/admission` option when the composition pins one,\\n   167\\t   the `:yin.link.publish/scope` option's next drawn token when the\\n   168\\t   composition scopes the publisher, otherwise the token derived from\\n   169\\t   the publication specification's own durable identity. The origin is\\n   170\\t   an admission event's identity, not a function of the tree's content\\n   171\\t   alone: it is persisted in the side record at publication time and\\n   172\\t   retrieved from that record; nothing ever reconstructs it from the\\n   173\\t   root.\\\"\\n   174\\t  [token]\\n   175\\t  [:source :yin.vm.linker.publish/publish token 0])\\n   176\\t\\n   177\\t\\n   178\\t(defn- claims-call-sites?\\n   179\\t  \\\"True when map AST `ast` carries the C1 key anywhere. A hit inside a\\n   180\\t   literal payload is data, not a claim: extraction then finds no\\n   181\\t   markers and the module publishes unannotated, as it should.\\\"\\n   182\\t  [ast]\\n   183\\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\\n   184\\t\\n   185\\t\\n   186\\t(defn- call-site-claim\\n   187\\t  \\\"The C1 claim `ast` makes over its canonical `tree`: nil when it\\n   188\\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\\n   189\\t   when the extracted markers exactly cover the tree's eligible\\n   190\\t   application occurrences; `{:missing [...] :extra [...]}` when they\\n   191\\t   do not; `{:unsupported-version v :path p}` when a marker's value is\\n   192\\t   not version 1 — a claim rejection, never a silent acceptance of a\\n   193\\t   table a retriever would read as version 1.\\\"\\n   194\\t  [ast tree admission]\\n   195\\t  (when (claims-call-sites? ast)\\n   196\\t    (let [origin (publication-origin admission)\\n   197\\t          extracted (filter #(= :yang/call-site (nth % 3))\\n   198\\t                            (:frontend-metadata\\n   199\\t                              (vm/ast-side-tables ast tree origin)))\\n   200\\t          eligible (into #{}\\n   201\\t                         (map (fn [[r p]] [origin r p]))\\n   202\\t                         (vm/application-occurrences tree))\\n   203\\t          marked (into #{}\\n   259\\t                                        {:name n})\\n   260\\t                      :missing (when (not= address (:address w))\\n   261\\t                                 (refusal :yin.link.publish/incomplete-requirement\\n   262\\t                                          {:name n :walk w})))))\\n   263\\t                (sort-by (fn [[n _]] (str n)) requires)))\\n   264\\t        fp (when (and tree (not defect) (not requirement)\\n   265\\t                      (not= :refused (:status tree)))\\n   266\\t             (footprint handle (assoc spec :tree tree)))\\n   267\\t        ;; a C1 claim is validated before anything is written: a module\\n   268\\t        ;; whose markers do not cover its tree is never published as\\n   269\\t        ;; though it did. One publication is one admission event\\n   270\\t        ;; (design §2.1): the admission identity is pinned explicitly by\\n   271\\t        ;; the composition when it supplies `:yin.link.publish/admission`,\\n   272\\t        ;; drawn from the composition's own scope object when it supplies\\n   273\\t        ;; `:yin.link.publish/scope`, and otherwise derived from the\\n   274\\t        ;; specification's own durable identity — no counter lives in\\n   275\\t        ;; this namespace. Either way it is persisted in the side record\\n   276\\t        ;; and retrieved from there\\n   277\\t        admission (or (:yin.link.publish/admission opts)\\n   278\\t                      (when-let [scope (:yin.link.publish/scope opts)]\\n   279\\t                        (scope-admission-token scope))\\n   280\\t                      (when tree (spec-admission-token spec tree)))\\n   281\\t        claim (when (and tree (not defect) (not requirement)\\n   282\\t                         (not= :refused (:status tree))\\n   283\\t                         (not= :refused (:status fp)))\\n   284\\t                (call-site-claim ast tree admission))]\\n   285\\t    (cond\\n   286\\t      undefined\\n   287\\t      (refusal :yin.link.publish/undefined-export {:export undefined})\\n   288\\t\\n   289\\t      (= :refused (:status tree)) tree\\n   290\\t\\n   291\\t      defect\\n   292\\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\\n   293\\t\\n   294\\t      requirement requirement\\n   295\\t\\n   420\\t                                         nil))))\\n   421\\t                           (map-indexed vector\\n   422\\t                                        (get vm/semantic-bytecode-grammar\\n   423\\t                                             (nth row 1))))]\\n   424\\t            (recur (into (subvec queue 1)\\n   425\\t                         (remove #(contains? rows %) kids))\\n   426\\t                   (assoc rows address row))))))))\\n   427\\t\\n   428\\t\\n   429\\t(defn published-call-site-table\\n   430\\t  \\\"The C1 side table the module whose manifest is at `address` in\\n   431\\t   `handle` claims: `{:origin o :root r :rows [...] :tree tree}` with\\n   432\\t   the rows exactly as stored and the module's canonical tree, or nil\\n   433\\t   when the module made no C1 claim. The manifest references the table\\n   434\\t   and its reverse record (`:yin.module/call-sites`), so the reference —\\n   435\\t   not a recomputation — is what is resolved here: the rows are fetched\\n   436\\t   from the referenced table address and the ORIGIN is the one the\\n   437\\t   record RECORDED at publication (`:yang.call-site/origin`, held to be\\n   438\\t   a well-formed occurrence origin), beside the record's version, the\\n   439\\t   manifest's own tree, and the referenced table. Nothing reconstructs\\n   440\\t   an origin from content: a replay of this retrieval answers the\\n   441\\t   recorded admission identity, and no other module's admission can be\\n   442\\t   confused with it.\\\"\\n   443\\t  [handle address]\\n   444\\t  (let [manifest (jing/get handle address nil)\\n   445\\t        call-sites (:yin.module/call-sites manifest)]\\n   446\\t    (when (and (map? manifest) (:yin.module/tree manifest)\\n   447\\t               (map? call-sites) (jing/segment-address? (:table call-sites))\\n   448\\t               (jing/segment-address? (:record call-sites)))\\n   449\\t      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\\n   450\\t        (let [stored-rows (jing/get handle (:table call-sites) nil)\\n   451\\t              stored-record (jing/get handle (:record call-sites) nil)\\n   452\\t              origin (:yang.call-site/origin stored-record)]\\n   453\\t          (when (and (vector? stored-rows)\\n   454\\t                     (= {:yang.call-site/version 1\\n   455\\t                         :yang.call-site/root (:yin.module/tree manifest)\\n   456\\t                         :yang.call-site/table (:table call-sites)}\\n   457\\t                        (select-keys stored-record\\n   458\\t                                     [:yang.call-site/version\\n   459\\t                                      :yang.call-site/root\\n   460\\t                                      :yang.call-site/table]))\\n   461\\t                     (vm/occurrence-origin? origin))\\n   462\\t            {:origin origin, :root (:root tree), :rows stored-rows,\\n   463\\t             :tree tree}))))))\\n   464\\t\\n   465\\t\\n   466\\t;; =============================================================================\\n   467\\t;; Deriving a module from indexed code (5.3)\\n   468\\t;; =============================================================================\\n   469\\t\\n   470\\t(defn- indexed-programs\\n   471\\t  \\\"Every program the index `db` holds -- a relation of `[e a v t m]` index\\n   472\\t   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\\n   473\\t   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\\n   474\\t   whose `m` is the program's metadata entity.\\\"\\n   475\\t  [db]\\n   476\\t  (let [by-m (group-by #(nth % 4)\\n   477\\t                       (query/collect\\n   478\\t                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\\n   479\\t                                  db)))]\\n   480\\t    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\\n   481\\t          (sort-by (juxt second first)\\n   482\\t                   (query/collect\\n   483\\t                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\\n   484\\t                              db))))))\\n   485\\t\\n   486\\t\\n   487\\t(defn requirements\\n   488\\t  \\\"The modules `ast` unconditionally requires at module level. Scan literal\\n   489\\t   `(require 'm)` applications outside lambda bodies, except immediately\\n   490\\t   applied lambdas. Conditional branches and try-require remain deferred.\\\"\\n   491\\t  [ast]\\n   492\\t  (requirements/eager ast))\\n   493\\t\\n   494\\t\\n   495\\t(defn- free-of\\n   640\\t(defn- sequence-body\\n   641\\t  \\\"The reference `do` lowering: `(do a b c)` is `((fn [_] ((fn [_] c) b)) a)`;\\n   642\\t   one form is itself and none is the literal nil.\\\"\\n   643\\t  [trees]\\n   644\\t  (let [trees (vec trees)]\\n   645\\t    (doseq [t trees] (need-packet 'yin/sequence-body t))\\n   646\\t    (case (count trees)\\n   647\\t      0 (literal-packet nil)\\n   648\\t      1 (first trees)\\n   649\\t      (application-packet (lambda-packet ['_] (sequence-body (subvec trees 1)))\\n   650\\t                          [(first trees)]))))\\n   651\\t\\n   652\\t\\n   653\\t(defn- slot-of\\n   654\\t  [tree n]\\n   655\\t  (let [row (root-row (need-packet 'yin/slot tree))\\n   656\\t        kinds (into {} (slot-kinds (row-tag row)))\\n   657\\t        index (packet-index tree)]\\n   658\\t    (when-not (and (integer? n) (contains? kinds n))\\n   659\\t      (throw-prelude \\\"yin/slot position names no grammar slot\\\"\\n   660\\t                     {:op 'yin/slot, :position n}))\\n   661\\t    (case (get kinds n)\\n   662\\t      :node (packet-of index (nth row n))\\n   663\\t      :nodes (mapv #(packet-of index %) (nth row n))\\n   664\\t      (nth row n))))\\n   665\\t\\n   666\\t\\n   667\\t(defn prelude\\n   668\\t  \\\"The closed body environment (§5.3): the pure standard primitives (no\\n   669\\t   `require`, no stream or FFI constructor) and the row-native constructors,\\n   670\\t   each consuming and returning self-contained tree packets. `gensym` is the\\n   671\\t   invocation-local `yin/gensym-sym`.\\\"\\n   672\\t  [gensym]\\n   673\\t  (merge\\n   674\\t    (dissoc vm/primitives 'require 'try-require 'bytes->str)\\n   675\\t    {'yin/tag (fn [tree] (row-tag (root-row (need-packet 'yin/tag tree)))),\\n   676\\t     'yin/slot slot-of,\\n   677\\t     'yin/literal literal-packet,\\n   678\\t     'yin/variable (fn [sym]\\n   679\\t                     (when-not (symbol? sym)\\n   680\\t                       (throw-prelude \\\"yin/variable expects a symbol\\\" {:op 'yin/variable}))\\n   681\\t                     (construct [:variable sym] [])),\\n   682\\t     'yin/lambda (fn [params body] (lambda-packet params (need-packet 'yin/lambda body))),\\n   683\\t     'yin/application (fn [operator operands]\\n   684\\t                        (need-packet 'yin/application operator)\\n   685\\t                        (doseq [o operands] (need-packet 'yin/application o))\\n   686\\t                        (application-packet operator (vec operands))),\\n   687\\t     'yin/if (fn [t c a]\\n   688\\t               (doseq [x [t c a]] (need-packet 'yin/if x))\\n   689\\t               (construct [:if (first t) (first c) (first a)] [t c a])),\\n   690\\t     'yin/sequence-body sequence-body,\\n   691\\t     'yin/make-lambda (fn [params-tree body]\\n   692\\t                        (let [row (root-row (need-packet 'yin/make-lambda params-tree))]\\n   693\\t                          (when-not (and (= :literal (row-tag row))\\n   694\\t                                         (vector? (nth row 2))\\n   695\\t                                         (every? symbol? (nth row 2)))\\n   696\\t                            (throw-prelude \\\"yin/make-lambda reads a literal parameter vector\\\"\\n   697\\t                                           {:op 'yin/make-lambda}))\\n   698\\t                          (lambda-packet (nth row 2) (need-packet 'yin/make-lambda body)))),\\n   699\\t     'yin/make-def (fn [name-tree value-tree]\\n   700\\t                     (application-packet (construct [:variable 'yin/def] [])\\n   701\\t                                         [(literal-packet (name-of name-tree))\\n   702\\t                                          (need-packet 'yin/make-def value-tree)])),\\n   703\\t     'yin/name-of name-of,\\n   704\\t     'yin/gensym-sym gensym}))\\n   705\\t\\n   706\\t\\n   707\\t(def ^:private suspending-tags\\n   708\\t  #{:vm/park :vm/resume :dao.stream.apply/call})\\n   709\\t\\n   710\\t\\n  1250\\t\\n  1251\\t\\n  1252\\t(defn- final-call-site-metadata\\n  1253\\t  \\\"The call-site occurrence contract's (C1) side table of an expanded\\n  1254\\t   final tree, as frontend-metadata rows `[origin root path\\n  1255\\t   :yang/call-site 1]` in printed-row order: one row per\\n  1256\\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\\n  1257\\t   that actually executes. The frontend's own markers named the\\n  1258\\t   pre-expansion tree; expansion, tail marking and stand-in lowering\\n  1259\\t   recompute roots and paths, so no pre-expansion table can cover this\\n  1260\\t   tree and the table is finalized here, over the finished rows.\\n  1261\\t\\n  1262\\t   Each row's origin is that occurrence's REAL origin (design §2.1,\\n  1263\\t   §2.3): `occurrence-origins` maps the final occurrence path to the\\n  1264\\t   origin of the admission or generation event that produced the\\n  1265\\t   application syntax at that path — the admitted run member's source\\n  1266\\t   origin for retained syntax (a no-op expansion keeps it valid), and\\n  1267\\t   the `[:expansion record-address]` of the recorded expansion event\\n  1268\\t   whose output introduced generated syntax. No expansion-record\\n  1269\\t   address is fabricated: only event rows the expander actually\\n  1270\\t   recorded appear. The table is therefore the explicit\\n  1271\\t   final-root correspondence §2.3 requires — every generated occurrence\\n  1272\\t   names its producing record, so an attribution consumer can reach the\\n  1273\\t   event (its input root, call path, macro root, output root) from the\\n  1274\\t   row alone.\\\"\\n  1275\\t  [row-set occurrence-origins admission-origin]\\n  1276\\t  (vec (sort-by pr-str\\n  1277\\t                (map (fn [[root path]]\\n  1278\\t                       [(get occurrence-origins path admission-origin)\\n  1279\\t                        root path :yang/call-site 1])\\n  1280\\t                     (vm/application-occurrences row-set)))))\\n  1281\\t\\n  1282\\t\\n  1283\\t(defn expand-batch\\n  1284\\t  \\\"Expand one input batch against `ctx` (§3.2). Returns\\n  1285\\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\\n  1286\\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\\n  1287\\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\\n  1288\\t   success changes the store, to the post-harvest store. A success also\\n  1289\\t   carries `:frontend-metadata` — the C1 side table finalized over the\\n  1290\\t   final tree (`final-call-site-metadata`), covering the tree that\\n  1291\\t   actually executes — when, and only when, the selected member itself\\n  1292\\t   claimed C1 coverage (its own verdict in `batch-call-site-claims`); a\\n  1293\\t   sibling's claim never manufactures a table for it, and an unclaimed\\n  1294\\t   batch carries no table at all, never an empty one. The admission\\n  1295\\t   this expansion produced the tree under rides beside it as\\n  1296\\t   `:call-site-origin` — the source origin of the admitted run member,\\n  1297\\t   the key the table is stored and resolved under beside the final\\n  1298\\t   root address. It is the table's admission key, not a blanket\\n  1299\\t   stamp: each row's origin is that occurrence's own (§2.1, §2.3) —\\n  1300\\t   a retained occurrence keeps its own incoming provenance (its\\n  1301\\t   source origin, or the generating expansion's, however deeply it\\n  1302\\t   was passed through), and generated syntax carries the\\n  1303\\t   `[:expansion record-address]` of the recorded expansion event\\n  1304\\t   whose output introduced it. A context\\n  1305\\t   store binding a\\n  1306\\t   reserved name, or holding an entry without the current AST contract,\\n  1307\\t   is refused (Rule R): it is a composition defect, so it throws rather\\n  1308\\t   than returning an error.\\\"\\n  1309\\t  [batch ctx]\\n  1310\\t  (check-store! (:store ctx))\\n  1311\\t  (let [ctx (with-default-guards ctx)\\n  1312\\t        source-batch (:t ctx)\\n  1313\\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\\n  1314\\t        finish (fn [st]\\n  1315\\t                 (let [ctx' (update (:ctx st) :t inc)]\\n  1316\\t                   (if-let [e (:error st)]\\n  1317\\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\\n  1318\\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\\n  1319\\t                      :frontend-metadata (:frontend-metadata st),\\n  1320\\t                      :call-site-origin (:call-site-origin st),\\n  1321\\t                      :ctx (assoc ctx' :store (:next-store st))})))\\n  1322\\t        {:keys [admitted error]} (admit batch)]\\n  1323\\t    (if error\\n  1324\\t      (let [[st counter] (allocate-attempt base)]\\n  1325\\t        (finish (-> st\\n  1326\\t                    (record-event (event-row (attempt-id ctx counter) source-batch\\n  1327\\t                                             (source-origin ctx source-batch nil)\\n  1328\\t                                             nil nil nil nil nil error))\\n  1329\\t                    (fail error))))\\n  1330\\t      (let [{:keys [trees indexes index run-index definitions]} admitted\\n  1331\\t            store0 (or (:store ctx) {})\\n  1332\\t            store (harvest store0 #(nth indexes %) definitions)\\n  1333\\t            catalogue (into []\\n  1334\\t                            (comp (filter :declared?)\\n  1335\\t                                  (map (fn [{:keys [name tree path value]}]\\n  1336\\t                                         {:name name,\\n  1337\\t                                          :macro-tree (packet-of (nth indexes tree) value),\\n  1338\\t                                          :source [tree path]})))\\n  1339\\t                            definitions)\\n  1340\\t            ;; only the run tree is expanded, so only its declarations are\\n  1341\\t            ;; replaced; every catalogue entry still resolves by index\\n  1342\\t            [index standins]\\n  1343\\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\\n  1344\\t                      (if (= run-index (first source))\\n  1345\\t                        (let [[index s] (intern-body index [standin-tag name k])]\\n  1346\\t                          [index (assoc acc (second source) s)])\\n  1347\\t                        [index acc]))\\n  1348\\t                    [index {}]\\n  1349\\t                    (map-indexed vector catalogue))\\n  1350\\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\\n  1351\\t            st (assoc base :index index :store store)]\\n  1352\\t        (if-let [e (guard-batch-rows st)]\\n  1353\\t          (finish (fail st e))\\n  1354\\t          (let [[st root'] (expand-node st root\\n  1355\\t                                        {:path [], :rel [],\\n  1356\\t                                         :frame {:parent nil, :root root,\\n  1357\\t                                                 :tree-index run-index},\\n  1358\\t                                         :shadow #{}, :depth 0,\\n  1359\\t                                         ;; every syntax of the admitted\\n  1360\\t                                         ;; run tree starts as source\\n  1361\\t                                         ;; (§2.1); expansions override\\n  1362\\t                        