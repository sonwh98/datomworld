 (get (:call-site-tables expander) [origin (first tree)]))\n  1622\t\n  1623\t\n  1624\t(defn load\n  1625\t  \"Expand one observed batch once: keep the returned context, stage the\n  1626\t   tree only on success, stage the log when a log writer exists, and\n  1627\t   accumulate the error of a failed expansion. Expansion failure is\n  1628\t   data, so the cursor advances past it. A successful expansion's C1\n  1629\t   side table (the batch result's `:frontend-metadata`, present only\n  1630\t   when the selected member itself claimed coverage) is retained on the\n  1631\t   consumer under the occurrence identity of the staged tree — its\n  1632\t   admission origin beside its final root address (`call-site-tables`,\n  1633\t   resolved by `call-site-table`) — so the composition that drives this\n  1634\t   expander — the REPL's session — holds every executed occurrence's\n  1635\t   coverage beside the expander that produced it, each load's table\n  1636\t   surviving the next, even when two loads land on the same root.\"\n  1637\t  [expander batch]\n  1638\t  (let [{:keys [status tree log error ctx frontend-metadata\n  1639\t                call-site-origin]}\n  1640\t        (expand-batch batch (:ctx expander))]\n  1641\t    (cond-> (assoc expander :ctx ctx)\n  1642\t      (= :ok status) (assoc :out-staged tree)\n  1643\t      (and (= :ok status) frontend-metadata)\n  1644\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n  1645\t                frontend-metadata)\n  1646\t      (:log expander) (assoc :log-staged log)\n  1647\t      (= :error status) (update :errors conj error))))\n  1648\t\n  1649\t\n  1650\t(defn- flush-slot\n  1651\t  [expander writer-key slot-key on-ok]\n  1652\t  (if-let [payload (get expander slot-key)]\n  1653\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\n  1654\t      (case outcome\n  1655\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\n  1656\t        :