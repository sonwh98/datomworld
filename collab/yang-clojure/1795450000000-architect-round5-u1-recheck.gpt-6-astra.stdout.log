ata? (nth origin 2))\nsrc/cljc/yin/vm.cljc:954:                      (integer? (nth origin 3))\nsrc/cljc/yin/vm.cljc:955:                      (not (neg? (nth origin 3))))\nsrc/cljc/yin/vm.cljc:956:         :expansion (and (= 2 (count origin))\nsrc/cljc/yin/vm.cljc:957:                         (jing/segment-address? (nth origin 1)))\nsrc/cljc/yin/vm.cljc:961:(defn source-origin\nsrc/cljc/yin/vm.cljc:963:   envelope. Throws with `:rule :origin` instead of allowing an incomplete\nsrc/cljc/yin/vm.cljc:966:  (let [origin [:source medium batch-token member-index]]\nsrc/cljc/yin/vm.cljc:967:    (when-not (occurrence-origin? origin)\nsrc/cljc/yin/vm.cljc:968:      (throw (ex-info \"Malformed source occurrence origin\"\nsrc/cljc/yin/vm.cljc:969:                      {:rule :origin, :origin origin})))\nsrc/cljc/yin/vm.cljc:970:    origin))\nsrc/cljc/yin/vm.cljc:1220:   `{:source-positions [[origin root path file line col] ...]\nsrc/cljc/yin/vm.cljc:1221:     :frontend-metadata [[origin root path key value] ...]}`.\nsrc/cljc/yin/vm.cljc:1226:  [ast bc origin]\nsrc/cljc/yin/vm.cljc:1227:  (when-not (occurrence-origin? origin)\nsrc/cljc/yin/vm.cljc:1228:    (throw (ex-info \"Side tables require a ruled occurrence origin\"\nsrc/cljc/yin/vm.cljc:1229:                    {:rule :origin, :origin origin})))\nsrc/cljc/yin/vm.cljc:1242:                         [origin root path (:file position) (:line position)\nsrc/cljc/yin/vm.cljc:1249:                  (swap! metadata conj [origin root path k v]))\nsrc/cljc/yin/vm.cljc:1594:   pure function of the tree and carries no origin; a query fixes origin\nsrc/cljc/yin/vm.cljc:1615:   no origin — a composition fixes the origin from its own side, as with\nsrc/cljc/yin/vm.cljc:1694:   table's tag↔mnemonic correspondence is 1:1 for the effect rows and\nsrc/cljc/yin/vm.cljc:2005:     :origin       this task's origin tag for link ids (default `:t0`)\nsrc/cljc/yin/vm.cljc:2016:     :secret-source (fn [origin] -> secret): the composition's minting 