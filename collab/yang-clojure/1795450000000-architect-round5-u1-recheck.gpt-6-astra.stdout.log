n   341\t      (is (= :ok status))\n   342\t      (testing \"expansion changed the tree: the `(unless …)` call expanded\"\n   343\t        (is (not= (:root input-tree) (:root final))))\n   344\t      (testing \"the changed root carries no fabricated expansion origin\n   345\t                (design §2.1: post-expansion names the pipeline\n   346\t                boundary, not proof that a generating event occurred)\"\n   347\t        (is (seq frontend-metadata))\n   348\t        (is (every? (fn [o]\n   349\t                      (or (= o admission)\n   350\t                          (and (expansion-origin? o)\n   351\t                               (contains? event-addrs (second o)))))\n   352\t                    origins)\n   353\t            \"every origin is the admission's source origin or names a\n   354\t             recorded expansion event — nothing fabricated\")\n   355\t        ;; the `(unless …)` output's generated node is an `:if`, not an\n   356\t        ;; application, and its `(+ 1 2)` operand is the admitted\n   357\t        ;; operand passed through — so every APPLICATION here is\n   358\t        ;; retained admitted syntax and genuinely keeps the source\n   359\t        ;; origin; the source origin is not a blanket stamp, it is the\n   360\t        ;; real provenance of each marked occurrence\n   361\t        (is (= #{admission} origins)\n   362\t            \"no generating event produced an application here, so every\n   363\t             marked occurrence is admitted\"))\n   364\t      (testing \"the retained table covers exactly the executed tree\"\n   365\t        (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\n   366\t        (is (every? (fn [[_ r _ _ _]] (= (:root final) r))\n   367\t                    frontend-metadata))\n   368\t        (is (true? (yang/validate-call-site-coverage!\n   369\t                     final frontend-metadata admission\n   370\t                     {:declared? true :per-occurrence-origins? true}))))\n   371\t      (testing \"the frontend's pre-expansion markers name a tree that no longer exists\"\n   372\t        (is (= :yang/call-site-nonexistent-path\n   373\t               (failure-rule\n   374\t                 #(yang/validate-call-site-coverage!\n   375\t                    final (:frontend-metadata input-tables) admission))))))\n   376\t    (testing \"a generating expansion marks its generated applications\n   377\t              with the recorded expansion record's origin (design §2.1,\n   378\t              §2.3: the correspondence is explicit, never fabricated)\"\n   379\t      (let [ast (yang/compile-program\n   380\t                  '[(defmacro make-call [x]\n   381\t                      (yin/application (yin/variable 'f) [x]))\n   382\t                    (defn f [y] (+ y 1))\n   383\t                    (make-call 2)])\n   384\t            {:keys [ctx result]} (expand-like-the-repl ast)\n   385\t            {:keys [status tree frontend-metadata log]} result\n   386\t            final (macro/packet->row-set tree)\n   387\t            admission [:source :program-in (:t ctx) 0]\n   388\t            event-addrs (into #{} (map first) (nth log 1))\n   389\t            origins (row-origins frontend-metadata)\n   390\t            generated (into #{}\n   391\t                            (comp (filter #(expansion-origin? (first %)))\n   392\t                                  (map #(vec (take 3 %))))\n   393\t                            frontend-metadata)]\n   394\t        (is (= :ok status))\n   395\t        (is (seq frontend-metadata))\n   396\t        (is (seq generated)\n   397\t            \"the macro generated an application, and it is marked\")\n   398\t        (is (contains? origins admission)\n   399\t            \"the admitted applications keep the source origin\")\n   400\t        (is (every? (fn [[o _ _]] (contains? event-addrs (second o))) generated)\n   401\t            \"each generated occurrence names a recorded expansion event\")\n   402\t        (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\n   403\t        (is (true? (yang/validate-call-site-coverage!\n   404\t                     final frontend-metadata admission\n   405\t                     {:declared? true :per-occurrence-origins? true})))))\n   406\t    (testing \"a no-op expansion retains the admitted source origin\"\n   407\t      ;; no macro call at all: the pipeline boundary alone (tail\n   408\t      ;; marking) changes the root without a generating event, so the\n   409\t      ;; final rows legitimately keep the admission's source origin\n   410\t      (let [ast (yang/compile-program '[(defn f [x] (+ x 1)) (f 2)])\n   411\t            {:keys [ctx result]} (expand-like-the-repl ast)\n   412\t            {:keys [status tree frontend-metadata]} result\n   413\t            final (macro/packet->row-set tree)\n   414\t            admission [:source :program-in (:t ctx) 0]]\n   415\t        (is (= :ok status))\n   416\t        (is (seq frontend-metadata))\n   417\t        (is (= #{admission} (row-origins frontend-metadata))\n   418\t            \"no generating event occurred, so the source origin remains\n   419\t             valid for every occurrence (design §2.1)\")\n   420\t        (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\n   421\t        (is (true? (yang/validate-call-site-coverage!\n   422\t                     final frontend-metadata admission\n   423\t                     {:declared? true :per-occurrence-origins? true})))))\n   424\t    (testing \"a nested pass-through keeps the operand's own origin\"\n   425\t      ;; design §2.1: a retained occurrence preserves ITS OWN incoming\n   426\t      ;; provenance. `wrap` generates `(pass x)` retaining the admitted\n   427\t      ;; `(+ 1 2)`; `pass` is a no-op returning `x` — the `+`\n   428\t      ;; application must still carry the source origin, never the\n   429\t      ;; enclosing expansion's origin\n   430\t      (let [ast (yang/compile-program\n   431\t                  '[(defmacro pass [x] x)\n   432\t                    (defmacro wrap [x]\n   433\t                      (yin/application (yin/variable 'pass) [x]))\n   434\t                    (wrap (+ 1 2))])\n   435\t            {:keys [ctx result]} (expand-like-the-repl ast)\n   436\t            {:keys [status tree frontend-metadata]} result\n   437\t            final (macro/packet->row-set tree)\n   438\t            admission [:source :program-in (:t ctx) 0]]\n   439\t        (is (= :ok status))\n   440\t        (is (seq frontend-metadata))\n   441\t        (is (= #{admission} (row-origins frontend-metadata))\n   442\t            \"the admitted `(+ 1 2)` application passed through two\n   443\t             expansions keeps its source origin — it must not be\n   444\t             relabeled with any enclosing expansion's origin\")\n   445\t        (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\n   446\t        (is (true? (yang/validate-call-site-coverage!\n   447\t                     final frontend-metadata admission\n   448\t                     {:declared? true :per-occurrence-origins? true}))))))\n   449\t  (testing \"the expander consumer the REPL threads retains the executed tree's table\"\n   450\t    (let [store (macro/seed-store\n   451\t                  (macro/make-ctx {:token :callsite-test/standard-forms\n   452\t                                   :source-medium :callsite-test/standard-forms})\n   453\t                  [macro/stdlib-forms])\n   454\t          ctx (macro/make-ctx {:token \"callsite-test\"\n   455\t                               :source-medium :program-in\n   456\t                               :store store})\n   457\t          ast (yang/compile-program '[(defn f [x] (+ x 1)) (f 2)])\n   458\t          consumer (macro/load (macro/make-expander ctx nil)\n   459\t                               (encoder/program-batch ast))\n   460\t          final (macro/packet->row-set (:out-staged consumer))\n   461\t          origin [:source :program-in (:t ctx) 0]\n   462\t          rows (macro/call-site-table consumer (:out-staged consumer) origin)]\n   463\t      (is (seq rows))\n   464\t      (is (= (occurrence-pairs final) (marked-pairs rows)))\n   465\t      (is (true? (yang/validate-call-site-coverage!\n   466\t                   final rows origin\n   467\t                   {:declared? true :per-occurrence-origins? true}))))))\n   468\t\n   469\t\n   470\t(deftest twin-identical-content-distinct-origin-test\n   471\t  (testing \"identical-content applications with different histories are\n   472\t            distinguishable by query (ruling U1: an occurrence is\n   473\t            (content address, origin); provenance is read from retained\n   474\t            history, never inferred from content): an expansion whose\n   475\t            output contains an admitted `(f 1)` operand AND a freshly\n   476\t            constructed identical `(f 1)` yields TWO site rows — the\n   477\t            admitted one with its incoming source origin, the\n   478\t            constructed one naming its expansion record\"\n   479\t    (let [ast (yang/compile-program\n   480\t                '[(defmacro twin [x]\n   481\t                    (yin/if (yin/literal true)\n   482\t                            x\n   483\t                            (yin/application (yin/variable 'f) [(yin/literal 1)])))\n   484\t                  (defn f [y] y)\n   485\t                  (twin (f 1))])\n   486\t          {:keys [ctx result]} (expand-like-the-repl ast)\n   487\t          {:keys [status tree frontend-metadata log]} result\n   488\t          final (macro/packet->row-set tree)\n   489\t          admission [:source :program-in (:t ctx) 0]\n   490\t          event-addrs (into #{} (map first) (nth log 1))\n   491\t          rows (filterv #(= :yang/call-site (nth % 3)) frontend-metadata)\n   492\t          ;; the expansion's `:if` output (the run tree's root may carry\n   493\t          ;; the ex