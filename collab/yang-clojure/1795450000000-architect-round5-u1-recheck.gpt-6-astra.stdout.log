_ r path]] [r path]))\\n   239\\t                         (marked-application-sites frontend-metadata))\\n   240\\t                   (marked-application-sites frontend-metadata))]\\n   241\\t      (when (not= eligible marked)\\n   242\\t        (throw (ex-info \\\"Call-site coverage is not complete\\\"\\n   243\\t                        {:rule :yang/call-site-incomplete-coverage,\\n   244\\t                         :missing (vec (sort-by pr-str\\n   245\\t                                                (remove marked eligible))),\\n   246\\t                         :extra (vec (sort-by pr-str\\n   247\\t                                              (remove eligible marked)))}))))\\n   248\\t    true)))\\n   249\\t\\n   250\\t\\n   251\\t(defn validate-ast-call-sites!\\n   252\\t  \\\"Validate the C1 claim of a produced map AST `ast` under `origin`:\\n   253\\t   project it and compare the eligible application set derived from its\\n   254\\t   canonical rows with the marker set of its frontend-metadata side\\n   255\\t   table. The projected table is a declared canonical table, so it is\\n   256\\t   validated strictly (`:declared? true`). Returns true when the sets\\n   257\\t   are equal.\\\"\\n   258\\t  [ast origin]\\n   259\\t  (let [tree (vm/ast->semantic-bytecode ast)\\n   260\\t        tables (vm/ast-side-tables ast tree origin)]\\n   261\\t    (validate-call-site-coverage! tree (:frontend-metadata tables) origin\\n   262\\t                                  {:declared? true})))\\n   263\\t\\n   264\\t\\n   265\\t(defn literal?\\n   266\\t  \\\"Check if a value is a literal (self-evaluating).\\\"\\n   267\\t  [form]\\n   268\\t  (or (number? form)\\n   269\\t      (string? form)\\n   270\\t      (true? form)\\n   271\\t      (false? form)\\n   272\\t      (nil? form)\\n   273\\t      (keyword? form)\\n   274\\t      (vector? form)\\n   275\\t      (set? form)\\n   276\\t      (map? form)))\\n   277\\t\\n   278\\t\\n   279\\t(defn constant-form?\\n   280\\t  \\\"True when compiling `form` yields a fixed value independent of the\\n   281\\t   environment: scalars, quoted forms, and collections built entirely from\\n   282\\t   constants. A symbol is never constant (it is a variable reference). A\\n   283\\t   `quote` counts as constant only at the top level: nested inside a\\n   284\\t   collection it must reach compile-form so the quote is stripped and the\\n   285\\t   inner form evaluated as data.\\\"\\n   286\\t  ([form] (constant-form? form true))\\n   287\\t  ([form top-level?]\\n   288\\t   (cond\\n   289\\t     (or (nil? form) (number? form) (string? form)\\n   290\\t         (true? form) (false? form) (keyword? form)) true\\n   291\\t     (and (seq? form) (empty? form)) true\\n   292\\t     (seq? form) (and top-level? (= 2 (count form)) (= 'quote (first form)))\\n   293\\t     (or (vector? form) (set? form)) (every? #(constant-form? % false) form)\\n   294\\t     (map? form) (and (every? #(constant-form? % false) (keys form))\\n   295\\t                      (every? #(constant-form? % false) (vals form)))\\n   296\\t     :else false)))\\n   297\\t\\n   298\\t\\n   299\\t(defn- compile-constructed-collection\\n   300\\t  \\\"Lower a collection literal with dynamic elements to constructor calls over\\n   301\\t   existing portable primitives, so unquoted vectors/maps/sets evaluate their\\n   302\\t   elements like Clojure. Constant collections stay :literal nodes.\\n   303\\t\\n   304\\t   [e1 e2 ...]  => (conj [] e1 e2 ...)\\n   305\\t   #{e1 e2 ...} => (conj #{} e1 e2 ...)\\n   306\\t   {k1 v1 ...}  => (assoc {} k1 v1 k2 v2 ...)\\\"\\n   307\\t  [form tail? env macro-env]\\n   308\\t  (let [ctor (cond\\n   309\\t               (vector? form) ['conj []]\\n   310\\t               (set? form) ['conj #{}]\\nsrc/cljc/yin/vm/macro.cljc:1075:  [st address entry {:keys [path rel frame shadow depth origin-of]}]\\nsrc/cljc/yin/vm/macro.cljc:1083:        ;; `origin-of` already answers for that address, which need not\\nsrc