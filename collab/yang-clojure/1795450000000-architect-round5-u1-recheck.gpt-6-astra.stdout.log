535\\t  [expander writer-key slot-key on-ok]\\n  1536\\t  (if-let [payload (get expander slot-key)]\\n  1537\\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\\n  1538\\t      (case outcome\\n  1539\\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\\n  1540\\t        :dao.stream/full expander\\n  1541\\t        (throw (ex-info \\\"Expander could not publish a staged value\\\"\\n  1542\\t                        {:dao.stream/outcome outcome,\\n  1543\\t                         :destination slot-key,\\n  1544\\t                         :consumer expander}))))\\n  1545\\t    expander))\\n  1546\\t\\n  1547\\t\\n  1548\\t(defn flush\\n  1549\\t  \\\"Append each staged payload to its own destination (§9): `ok` clears only\\n  1550\\t   that slot (and counts a forwarded program), `full` retains the exact\\n  1551\\t   payload for retry, anything else throws with the outcome and the\\n  1552\\t   consumer's remaining staged slots under `:consumer`.\\\"\\n  1553\\t  [expander]\\n  1554\\t  ;; A log failure after a published program carries the cleared program\\n  1555\\t  ;; slot, so recovery never republishes it.\\n  1556\\t  (-> expander\\n  1557\\t      (flush-slot :out :out-staged #(update % :forwarded inc))\\n  1558\\t      (flush-slot :log :log-staged identity)))\\n  1559\\t\\n  1560\\t\\n  1561\\t(defn step\\n  1562\\t  \\\"Drive one expander session `{:observer o :consumer expander}` over\\n  1563\\t   `program-in` until it blocks, ends, or cannot flush.\\\"\\n  1564\\t  [session]\\n  1565\\t  (observer/run-on-stream session ready? load flush))\\n  1566\\t\\n  1567\\t\\n  1568\\t(defn drain-errors\\n  1569\\t  \\\"Read and reset `:errors` and `:forwarded`. Accepts a session or the bare\\n  1570\\t   consumer and returns `[same-shape' {:errors errors :forwarded n}]`.\\\"\\n  1571\\t  [x]\\n  1572\\t  (let [session? (contains? x :consumer)\\n  1573\\t        c (if session? (:consumer x) x)\\n  1574\\t        summ