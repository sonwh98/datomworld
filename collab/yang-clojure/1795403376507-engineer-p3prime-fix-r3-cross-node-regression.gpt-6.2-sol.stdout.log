       LinkingRunnable job = new LinkingRunnable(task);\n334:        LinkingRunnable old = channel.serialTask;\n335:        channel.serialTask = job;\n336-        try {\n337-            if (old == null) { // No previous job\n338-                execs.submit(job);\n339-            } else {\n340-                if (!old.next.compareAndSet(null, job)) { // successfully append to previous task\n41-    // streaming\n42-    private volatile boolean headerSent = false;\n43-\n44-    // messages sent from a WebSocket client should be handled orderly by server\n45-    // Changed from a Single Thread(IO event thread), no volatile needed\n46:    LinkingRunnable serialTask;\n47-\n48-    public AsyncChannel(SelectionKey key, HttpServer server) {\n49-        this.key = key;\n50-        this.server = server;\n51-    }\n52-\n53-    public void reset(HttpRequest request) {\n54-        this.request = request;\n55:        serialTask = null;\n56-\n57-        headerSent = false;\n58-        closedRan.set(false);\n59-        closeHandler.set(null);\n60-        closeRingHandler.set(null);\n--\n137-        if (close) {\n138-            serverClose(0);\n139-        }\n140-    }\n141-\n142:    public void setReceiveHandler(IFn fn) {\n143-        if (!receiveHandler.compareAndSet(null, fn)) {\n144-            throw new IllegalStateException(\"receive handler exist: \" + receiveHandler);\n145-        }\n146-    }\n147-\n--\n155-        if (!pongHandler.compareAndSet(null, fn)) {\n156-            throw new IllegalStateException(\"pong handler exist: \" + pongHandler);\n157-        }\n158-    }\n159-\n160:    public void messageReceived(final Object mesg) {\n161-        IFn f = receiveHandler.get();\n162-        if (f != null) {\n163-            f.invoke(mesg); // byte[] or String\n164-        }\n165-    }\n--\n179-        if (f != null) {\n180-            f.invoke(mesg);\n181-        }\n182-    }\n183-\n184:    public void sendHandshake(Map<String, Object> headers) {\n185-        HeaderMap map =