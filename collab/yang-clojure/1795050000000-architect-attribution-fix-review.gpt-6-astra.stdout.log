                (encoder/program-batch ast))\n   296\t          final (macro/packet->row-set (:out-staged consumer))\n   297\t          origin [:source :program-in (:t ctx) 0]\n   298\t          rows (macro/call-site-table consumer (:out-staged consumer) origin)]\n   299\t      (is (seq rows))\n   300\t      (is (= (eligible-under final origin) (marked rows)))\n   301\t      (is (true? (yang/validate-call-site-coverage!\n   302\t                   final rows origin\n   303\t                   {:declared? true}))))))\n   304\t\n   305\t\n   306\t(deftest successive-expansions-test\n   307\t  (testing \"two loads over different programs: both trees' tables survive\"\n   308\t    (let [store (macro/seed-store\n   309\t                  (macro/make-ctx {:token :callsite-test/standard-forms\n   310\t                                   :source-medium :callsite-test/standard-forms})\n   311\t                  [macro/stdlib-forms])\n   312\t          ctx (macro/make-ctx {:token \"callsite-test\"\n   313\t                               :source-medium :program-in\n   314\t                               :store store})\n   315\t          first-origin [:source :program-in (:t ctx) 0]\n   316\t          consumer (macro/make-expander ctx nil)\n   317\t          after-first (macro/load consumer\n   318\t                                  (encoder/program-batch\n   319\t                                    (yang/compile-program\n   320\t                                      '[(defn f [x] (+ x 1)) (f 2)])))\n   321\t          first-tree (:out-staged after-first)\n   322\t          second-origin [:source :program-in (:t (:ctx after-first)) 0]\n   323\t          consumer (macro/load after-first\n   324\t                               (encoder/program-batch\n   325\t                                 (yang/compile-program\n   326\t                                   '[(defmacro unless [c a b] (yin/if c b a))\n   327\t                                     (unless false (+ 1 2) 0)])))\n   328\t          second-tree (:out-staged consumer)]\n   329\t      (is (not= (first first-tree) (first second-tree))\n   330\t          \"the two expansions produced different final trees\")\n   331\t      (testing \"the first load's table resolves for its tree after the second load\"\n   332\t        (let [rows (macro/call-site-table consumer first-tree first-origin)]\n   333\t          (is (seq rows))\n   334\t          (is (= (eligible-under (macro/packet->row-set first-tree)\n   335\t                                 first-origin)\n   336\t                 (marked rows)))\n   337\t          (is (true? (yang/validate-call-site-coverage!\n   338\t                       (macro/packet->row-set first-tree) rows\n   339\t                       first-origin {:declared? true})))))\n   340\t      (testing \"the second load's table resolves for its tree\"\n   341\t        (let [rows (macro/call-site-table consumer second-tree second-origin)]\n   342\t          (is (seq rows))\n   343\t          (is (= (eligible-under (macro/packet->row-set second-tree)\n   344\t                                 second-origin)\n   345\t                 (marked rows)))\n   346\t          (is (true? (yang/validate-call-site-coverage!\n   347\t                       (macro/packet->row-set second-tree) rows\n   348\t                       second-origin {:declared? true}))))))))\n   349\t\n   350\t\n   351\t(deftest unclaimed-batch-test\n   352\t  (testing \"a batch whose frontend makes no C1 claim creates no metadata\"\n   353\t    (let [ctx (macro/make-ctx {:token :callsite-test/unclaimed\n   354\t                               :source-medium :program-in})\n   355\t          unmarked {:type :application\n   356\t                    :operator {:type :variable :name 'f}\n   357\t                    :operands [{:type :literal :value 1}\n   358\t                               {:type :literal :value 2}]}\n   359\t          {:keys [status frontend-metadata]}\n   360\t          (macro/expand-batch (encoder/program-batch unmarked) ctx)\n   361\t          consumer (macro/load (macro/make-expander ctx nil)\n   362\t                               (encoder/program-batch unmarked))]\n   363\t      (is (= :ok status))\n   364\t      (is (nil? frontend-metadata)\n   365\t          \"no table, never an empty one, for an unclaimed batch\")\n   366\t      (is (empty? (:call-site-tables consumer))\n   367\t          \"the consumer holds no tables\")\n   368\t      (is (nil? (macro/call-site-table consumer (:out-staged consumer)\n   369\t                                       [:source :program-in 0 0]))))))\n   370\t\n   371\t\n   372\t(defn- strip-call-sites\n   373\t  \"The map AST with every C1 marker removed — canonical rows are\n   374\t   invariant under this (canonical-invariance-test), so stripping a\n   375\t   compiled tree and re-encoding produces the same final tree under a\n   376\t   no-claim batch.\"\n   377\t  [ast]\n   378\t  (clojure.walk/postwalk #(cond-> % (map? %) (dissoc :yang/call-site)) ast))\n   379\t\n   380\t\n   381\t(deftest same-root-coexistence-test\n   382\t  (testing \"two loads landing on the SAME final root from different\n   383\t            admissions: both occurrences' tables coexist, retrievable\n   384\t            by their origin+root pair (design §2.1, K = [origin root\n   385\t            path])\"\n   386\t    (let [store (macro/seed-store\n   387\t                  (macro/make-ctx {:token :callsite-test/standard-forms\n   388\t                                   :source-medium :callsite-test/standard-forms})\n   389\t                  [macro/stdlib-forms])\n   390\t          ctx (macro/make-ctx {:token \"callsite-test\"\n   391\t                               :source-medium :program-in\n   392\t                               :store store})\n   393\t          ast (yang/compile-program '[(defn f [x] (+ x 1)) (f 2)])\n   394\t          first-origin [:source :program-in (:t ctx) 0]\n   395\t          consumer (macro/make-expander ctx nil)\n   396\t          consumer (macro/load consumer (encoder/program-batch ast))\n   397\t          first-tree (:out-staged consumer)\n   398\t          second-origin [:source :program-in (:t (:ctx consumer)) 0]\n   399\t          consumer (macro/load consumer (encoder/program-batch ast))\n   400\t          second-tree (:out-staged consumer)]\n   401\t      ;; the load that exposes the defect: identical programs, so the\n   402\t      ;; final trees are content-identical — same root\n   403\t      (is (= (first first-tree) (first second-tree))\n   404\t          \"two admissions produced the same root address\")\n   405\t      (is (not= first-origin second-origin)\n   406\t          \"the two admissions are different occurrence origins\")\n   407\t      (testing \"each occurrence's table resolves under its own origin\"\n   408\t        (doseq [[label tree origin]\n   409\t                [[\"first\" first-tree first-origin]\n   410\t                 [\"second\" second-tree second-origin]]]\n   411\t          (let [rows (macro/call-site-table consumer tree origin)]\n   412\t            (is (seq rows) (str label \" load's table resolves\"))\n   413\t            (is (= (eligible-under (macro/packet->row-set tree) origin)\n   414\t                   (marked rows)))\n   415\t            (is (true? (yang/validate-call-site-coverage!\n   416\t                         (macro/packet->row-set tree) rows origin\n   417\t                         {:declared? true})))))\n   418\t        (is (= 2 (count (:call-site-tables consumer)))\n   419\t            \"two tables, one per occurrence — neither overwrote the other\")))))\n   420\t\n   421\t\n   422\t(deftest unclaimed-after-claimed-test\n   423\t  (testing \"an unclaimed load of a root previously loaded under a claim\n   424\t            retrieves no stale table\"\n   425\t    (let [store (macro/seed-store\n   426\t                  (macro/make-ctx {:token :callsite-test/standard-forms\n   427\t                                   :source-medium :callsite-test/standard-forms})\n   428\t                  [macro/stdlib-forms])\n   429\t          ctx (macro/make-ctx {:token \"callsite-test\"\n   430\t                               :source-medium :program-in\n   431\t                               :store store})\n   432\t          claimed (yang/compile-program '[(defn f [x] (+ x 1)) (f 2)])\n   433\t          unmarked (strip-call-sites claimed)\n   434\t          first-origin [:source :program-in (:t ctx) 0]\n   435\t          consumer (macro/make-expander ctx nil)\n   436\t          consumer (macro/load consumer (encoder/program-batch claimed))\n   437\t          first-tree (:out-staged consumer)\n   438\t          second-origin [:source :program-in (:t (:ctx consumer)) 0]\n   439\t          consumer (macro/load consumer (encoder/program-batch unmarked))\n   440\t          second-tree (:out-staged consumer)]\n   441\t      (is (= (first first-tree) (first second-tree))\n   442\t          \"the unmarked program lands on the claimed load's root\")\n   443\t      (is (seq (macro/call-site-table consumer first-tree first-origin))\n   444\t          \"the claimed occurrence's table is still held under its origin\")\n   445\t      (is (nil? (macro/call-site-table consumer second-tree second-origin))\n   446\t          \"the unclaimed occurrence retrieves no table — not the stale one\")\n   447\t      (is (= 1 (count (:call-site-tables consumer)))))))\n   448\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md | sed -n '27,80p' && nl -ba src/cljc/yin/vm.cljc | sed -n '940,975p;1190,1258p' && nl -ba src/cljc/yin/vm/linker/closure.cljc | sed -n '195,240p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md | sed -n '27,80p' && nl -ba src/cljc/yin/vm.cljc | sed -n '940,975p;1190,1258p' && nl -ba src/cljc/yin/vm/linker/closure.cljc | sed -n '195,240p'\"","aggregated_output":"    27\t\n    28\t## 2. Occurrence contract C1\n    29\t\n    30\tThe following is the proposed normative contract, grounded in `docs/design/yin.vm.code-as-tuples.md:393-455,658-665,918-931`.\n    31\t\n    32\t### 2.1 Identity and scope\n    33\t\n    34\tAn application site is `K = [origin root-address path]`.\n    35\t\n    36\t- `root-address` is the canonical root of the particular final UAST tree being named, not the application's subtree address or an instrumented runtime-map hash.\n    37\t- `path` is the grammar's structural path: scalar child slot steps are row positions; a child in a `nodes` slot is `[slot-position member-index]`. The root is `[]`. Never substitute map keys, host iteration order, allocation ids, source line numbers, PCs, callee names, or arities.\n    38\t- `origin` identifies the actual admission or generation event. Admitted syntax uses `[:source medium batch-token j]`; generated syntax uses `[:expansion expansion-record-address]`. Generated post-expansion trees must not be mislabeled as original source or given a fabricated expansion address. If a no-op expansion retains an admitted tree, the original source origin remains valid; “post-expansion” names the pipeline boundary, not proof that a generating event occurred.\n    39\t- An origin is supplied by the admitting/generating composition. Two separately admitted identical sources have different origins; two identical applications in one tree have different paths; two expansion attempts with identical output have different producing records. Replaying a single recorded admission is different from admitting the same text again.\n    40\t\n    41\tThe implemented origin validator accepts exactly the source and expansion shapes (`src/cljc/yin/vm.cljc:938-958`). `vm/occurrences` returns `[root path node-id]`, one per place, with origin fixed by the composition; it does not return full keys or count only distinct row ids (`vm.cljc:1589-1609`).\n    42\t\n    43\tCoverage is **every final `:application` occurrence**, including generated wrappers, adapters, dispatcher/helper calls, bundled preludes, imported preludes, recursion, and statically indirect applications. “Source call” and “attributable upstream call” are projections over this coverage, not filters that delete other occurrences. Rule R's `yin/def` is structurally an application but lowers to `:define`; it gets an occurrence annotation and never a fictitious callee-entry event (`semantic/linearize.cljc:106-116`).\n    44\t\n    45\tDedicated operations such as `:dao.stream.apply/call`, stream nodes, and continuation nodes retain existing instruction provenance. They are not silently counted as `:application` sites. Their adapters' application occurrences are covered; an extension to count other node kinds must explicitly version the coverage policy (`vm.cljc:1015-1028`; `semantic/linearize.cljc:126-139`).\n    46\t\n    47\t### 2.2 Minimal persisted annotation\n    48\t\n    49\tReserve `:yang/call-site` in the existing frontend-metadata relation:\n    50\t\n    51\t```clojure\n    52\t[origin root-address path :yang/call-site 1]\n    53\t```\n    54\t\n    55\tThe integer `1` versions this key's coverage/interpretation contract. The first three coordinates ARE the site id; the value does not repeat it. This key is distinct from existing `:yang/site`, whose meaning is safepoint marks (`src/cljc/yang/safepoint.cljc:55-75`). It carries no language name, source arity, ambient-context classification, or callee identity. Those are consumer evidence derived by the oracle or another explicitly versioned consumer.\n    56\t\n    57\tThe marker certifies that a producer preserved this occurrence under C1; the application predicate itself remains derived from canonical rows. There is no new canonical fact asserting what the grammar already says. A consumer can derive the eligible application set and compare it with the complete marker set. Under a C1 publication claim the sets must be equal; mere absence of annotations in an older publication is not false evidence of zero applications.\n    58\t\n    59\tEmit precisely one logical marker per eligible occurrence. Duplicate identical transport deliveries may be deduplicated as the same immutable fact; duplicate entries in a declared canonical table, conflicting values, unsupported versions, nonexistent paths, non-application targets, and missing/extra rows under a complete-coverage claim are validation failures. Other frontend metadata is preserved independently.\n    60\t\n    61\tImplementation may add this marker to temporary frontend map nodes before side-table projection, since the current extractor recognizes namespace `yang` (`vm.cljc:1183-1214`). Prefer deriving the relation directly from validated rows where map attachment would be redundant. `ast->semantic-bytecode` hashes only grammar slots and drops other node keys (`vm.cljc:1113-1123`); no grammar slot, instruction operand, canonical datom slot, or AST contract revision is authorized by C1.\n    62\t\n    63\t### 2.3 Finalization and transformations\n    64\t\n    65\tFinalize paths only after macro expansion, generated-name canonicalization, wrappers, module/SCC assembly, and tail marking that determine the named tree. Source-level annotations alone cannot cover generated calls (base ruling R2 at line 17). Low-level functions returning fragments may defer finalization until an owning root and origin exist; each executable/publication ingress must invoke the common finalizer. A frontend cannot claim adoption by marking just its parser or user-call lowering arm.\n    66\t\n    67\tA subsequent tree-changing transform creates another root and another occurrence relation. It must preserve an explicit old/new occurrence correspondence where it makes an attribution claim, recompute C1 for new applications, and identify generated helper calls separately. It must not retain stale paths or equate every new helper with the nearest source call. If a transform deletes, duplicates, or merges occurrences, its correspondence must record the actual multiplicity; ambiguity refuses attribution.\n    68\t\n    69\tMacro expansion already records input root, call path, macro root, parent, output and attempt (`src/cljc/yin/vm/macro.cljc:997-1000,1062-1119`). However, final tail marking and stand-in lowering happen later (`:1255-1260`). The implementation inventory must resolve how final published roots are related to these expansion outputs. Whether the existing event/record adapters already provide the complete final-root correspondence is **unknown — the implementation round's inventory decides**. Do not assume an intermediate output record identifies every occurrence in the final assembled tree, and do not mint a fake `:expand` merely to satisfy the shape.\n    70\t\n    71\t### 2.4 Lowering, reconstruction, and runtime lookup\n    72\t\n    73\tPersist the existing instruction relation `[segment-address pc origin root-address path]`. The row linearizer already returns `{:address ... :provenance [[pc origin root path] ...]}`; its caller supplies the segment coordinate (`semantic/linearize.cljc:188-214`; code-as-tuples §5.3 at lines 918–931). A call dispatch looks up its **own call instruction's** emitting occurrence, not the preceding operand's instruction or the callee's body. Multiple instructions may belong to one occurrence.\n    74\t\n    75\tSegment+PC alone is insufficient when identical code is loaded under two origins. The runtime must retain its load/admission origin alongside its image reference when selecting provenance. This is an occurrence-scoped runtime context, not a new code hash. The native image derivations must supply or independently reconstruct a mapping from their call PCs back through semantic PCs to K; PC equality across formats must not be assumed. Current semantic `resolve` preserves PCs, register derivation preserves layout, and stack derivation emits a new sequence (`semantic/derive.cljc:21-42,60-93,154-172`).\n    76\t\n    77\tCanonical reconstruction deliberately shares nodes by content (`vm.cljc:1477-1486,1522-1525`). Never cache an occurrence annotation by node-id or mutate a shared canonical reconstruction and expect distinct sites to survive. Keep an occurrence cursor/side lookup, or expand occurrence-specific ephemeral images. The datom linearizer currently returns `[pc entity]`, not K (`semantic/linearize.cljc:283-302`); use an explicit entity-to-occurrence bridge with the owning batch, root and path, refusing ambiguity. `encoder/datom-entity-occurrences` and the envelope's `:yin/entity-occurrences` are the starting machinery (`encoder.cljc:67,115-148`).\n    78\t\n    79\t### 2.5 Ephemeral origin and trace field\n    80\t\n   940\t   an occurrence; it is accepted separately by the legacy bare-row lane.\n   941\t\n   942\t   A source origin is `[:source medium batch-token member-index]`. Medium and\n   943\t   token are opaque non-nil plain data supplied by the admitting composition,\n   944\t   and the member index is a non-negative integer. An expansion origin names\n   945\t   the portable content address of its expansion record.\"\n   946\t  [origin]\n   947\t  (and (vector? origin)\n   948\t       (case (first origin)\n   949\t         :source (and (= 4 (count origin))\n   950\t                      (some? (nth origin 1))\n   951\t                      (plain-data? (nth origin 1))\n   952\t                      (some? (nth origin 2))\n   953\t                      (plain-data? (nth origin 2))\n   954\t                      (integer? (nth origin 3))\n   955\t                      (not (neg? (nth origin 3))))\n   956\t         :expansion (and (= 2 (count origin))\n   957\t                         (jing/segment-address? (nth origin 1)))\n   958\t         false)))\n   959\t\n   960\t\n   961\t(defn source-origin\n   962\t  \"Construct and validate the source occurrence coordinate owned by a batch\n   963\t   envelope. Throws with `:rule :origin` instead of allowing an incomplete\n   964\t   coordinate to enter a provenance or frontend side table.\"\n   965\t  [medium batch-token member-index]\n   966\t  (let [origin [:source medium batch-token member-index]]\n   967\t    (when-not (occurrence-origin? origin)\n   968\t      (throw (ex-info \"Malformed source occurrence origin\"\n   969\t                      {:rule :origin, :origin origin})))\n   970\t    origin))\n   971\t\n   972\t\n   973\t(defn loaded-code-floor\n   974\t  \"The lowest entity id claimed by the segments in a `{segment-id image}`\n   975\t   code map — each segment id minus its length — or 0 when none is loaded.\n  1190\t        node-meta (apply dissoc (or (meta node) {}) source-position-keys)\n  1191\t        yang (for [[k v] node\n  1192\t                   :when (and (= \"yang\" (namespace k))\n  1193\t                              (not= :yang/source-position k))]\n  1194\t               [k v])\n  1195\t        own (concat yang\n  1196\t                    (sort-by (comp pr-str key) node-meta))\n  1197\t        names (mapcat\n  1198\t                (fn [[field kind]]\n  1199\t                  (let [value (get node field)]\n  1200\t                    (case kind\n  1201\t                      :sym (for [[k v] (sort-by (comp pr-str key)\n  1202\t                                                (apply dissoc (or (meta value) {})\n  1203\t                                                       source-position-keys))]\n  1204\t                             [[field k] v])\n  1205\t                      :syms (mapcat\n  1206\t                              (fn [i sym]\n  1207\t                                (for [[k v] (sort-by (comp pr-str key)\n  1208\t                                                     (apply dissoc (or (meta sym) {})\n  1209\t                                                            source-position-keys))]\n  1210\t                                  [[field i k] v]))\n  1211\t                              (range) value)\n  1212\t                      nil)))\n  1213\t                slots)]\n  1214\t    (concat own names)))\n  1215\t\n  1216\t\n  1217\t(defn ast-side-tables\n  1218\t  \"Project occurrence-owned frontend facts from a map AST without putting\n  1219\t   them in canonical rows. Returns the §2.5 relations\n  1220\t   `{:source-positions [[origin root path file line col] ...]\n  1221\t     :frontend-metadata [[origin root path key value] ...]}`.\n  1222\t\n  1223\t   `bc` must be the projection of `ast`; its root makes both relations join\n  1224\t   the canonical row and occurrence relations. Structural paths use the same\n  1225\t   row positions as `occurrences` and lowering.\"\n  1226\t  [ast bc origin]\n  1227\t  (when-not (occurrence-origin? origin)\n  1228\t    (throw (ex-info \"Side tables require a ruled occurrence origin\"\n  1229\t                    {:rule :origin, :origin origin})))\n  1230\t  (let [root (:root bc)\n  1231\t        positions (atom [])\n  1232\t        metadata (atom [])]\n  1233\t    (letfn [(visit\n  1234\t              [node path]\n  1235\t              (let [tag (:type node)\n  1236\t                    slots (or (get semantic-bytecode-grammar tag)\n  1237\t                              (throw (ex-info \"Unknown AST node type\"\n  1238\t                                              {:type tag, :node node})))\n  1239\t                    position (reader-position node)]\n  1240\t                (when position\n  1241\t                  (swap! positions conj\n  1242\t                         [origin root path (:file position) (:line position)\n  1243\t                          (:column position)]))\n  1244\t                (doseq [[k v] (frontend-meta-entries tag node)]\n  1245\t                  (when-not (and (plain-data? k) (plain-data? v))\n  1246\t                    (throw (ex-info \"Frontend metadata is not plain data\"\n  1247\t                                    {:rule :frontend-metadata, :path path,\n  1248\t                                     :key k, :value v})))\n  1249\t                  (swap! metadata conj [origin root path k v]))\n  1250\t                (doseq [[j [field kind]] (map-indexed vector slots)\n  1251\t                        :let [pos (+ j 2)\n  1252\t                              value (get node field)]]\n  1253\t                  (case kind\n  1254\t                    :node (visit value (conj path pos))\n  1255\t                    :nodes (doseq [[i child] (map-indexed vector value)]\n  1256\t                             (visit child (conj path [pos i])))\n  1257\t                    nil))))]\n  1258\t      (visit ast [])\n   195\t(defn- walk-call-sites\n   196\t  \"Step 4b: the C1 side table and its reverse record the manifest\n   197\t   references (`:yin.module/call-sites`, `yin.vm.linker.publish`), read\n   198\t   and held to their own shape — the table is a vector of frontend-\n   199\t   metadata rows, the record is version 1, names the manifest's own\n   200\t   tree, and points at the referenced table. The origin is left to the\n   201\t   retriever, which recomputes it from the tree.\"\n   202\t  [st manifest path]\n   203\t  (if-some [call-sites (:yin.module/call-sites manifest)]\n   204\t    (let [[st table] (read-blob st (:table call-sites) :call-site path)]\n   205\t      (if (:stop st)\n   206\t        st\n   207\t        (let [[st record] (read-blob st (:record call-sites) :call-site path)]\n   208\t          (cond\n   209\t            (:stop st) st\n   210\t\n   211\t            (not (vector? table))\n   212\t            (stop st (invalid (:table call-sites) :call-site path\n   213\t                              :call-site-defect {:code :table-shape}))\n   214\t\n   215\t            (not= {:yang.call-site/version 1\n   216\t                   :yang.call-site/root (:yin.module/tree manifest)\n   217\t                   :yang.call-site/table (:table call-sites)}\n   218\t                  (select-keys record\n   219\t                               [:yang.call-site/version\n   220\t                                :yang.call-site/root\n   221\t                                :yang.call-site/table]))\n   222\t            (stop st (invalid (:record call-sites) :call-site path\n   223\t                              :call-site-defect {:code :record-shape}))\n   224\t\n   225\t            :else st))))\n   226\t    st))\n   227\t\n   228\t\n   229\t(defn- walk-requires\n   230\t  \"Step 5: list every pin with derived eagerness, then descend only into\n   231\t   eager manifests not walked before. Deferred pins load at statement time.\"\n   232\t  [st manifest-address manifest path depth]\n   233\t  (let [eager-set (requirements/eager\n   234\t                    (:yin.module/tree manifest)\n   235\t                    (fn [address]\n   236\t                      (let [[tag & slots] (get (:seen st) address)]\n   237\t                        (into {:type tag}\n   238\t                              (map (fn [[[field _] value]] [field value]))\n   239\t                              (map vector (get vm/semantic-bytecode-grammar tag)\n   240\t                                   slots)))))]\n","exit_code":0,"status":"completed"}}
