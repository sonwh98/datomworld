an empty one, for an unclaimed batch\")\n   366\t      (is (empty? (:call-site-tables consumer))\n   367\t          \"the consumer holds no tables\")\n   368\t      (is (nil? (macro/call-site-table consumer (:out-staged consumer)\n   369\t                                       [:source :program-in 0 0]))))))\n   370\t\n   371\t\n   372\t(defn- strip-call-sites\n   373\t  \"The map AST with every C1 marker removed — canonical rows are\n   374\t   invariant under this (canonical-invariance-test), so stripping a\n   375\t   compiled tree and re-encoding produces the same final tree under a\n   376\t   no-claim batch.\"\n   377\t  [ast]\n   378\t  (clojure.walk/postwalk #(cond-> % (map? %) (dissoc :yang/call-site)) ast))\n   379\t\n   380\t\n   381\t(deftest same-root-coexistence-test\n   382\t  (testing \"two loads landing on the SAME final root from different\n   383\t            admissions: both occurrences' tables coexist, retrievable\n   384\t            by their origin+root pair (design §2.1, K = [origin root\n   385\t            path])\"\n   386\t    (let [store (macro/seed-store\n   387\t                  (macro/make-ctx {:token :callsite-test/standard-forms\n   388\t                                   :source-medium :callsite-test/standard-forms})\n   389\t                  [macro/stdlib-forms])\n   390\t          ctx (macro/make-ctx {:token \"callsite-test\"\n   391\t                               :source-medium :program-in\n   392\t                               :store store})\n   393\t          ast (yang/compile-program '[(defn f [x] (+ x 1)) (f 2)])\n   394\t          first-origin [:source :program-in (:t ctx) 0]\n   395\t          consumer (macro/make-expander ctx nil)\n   396\t          consumer (macro/load consumer (encoder/program-batch ast))\n   397\t          first-tree (:out-staged consumer)\n   398\t          second-origin [:source :program-in (:t (:ctx consumer)) 0]\n   399\t          consumer (macro/load consumer (encoder/program-batch ast))\n   40