:call-sites call-sites))))))))\n   317\t\n   318\t\n   319\t(defn publish-module!\n   320\t  \"Mint all four code formats, derivation records, and one schema-1 manifest.\n   321\t   `opts` `{:bounds {...}}` are the composition bounds (section 4.2 step\n   322\t   2) of every closure walk and local link the publication runs, every\n   323\t   bound left out taking `linker/default-bounds`.\"\n   324\t  ([handle spec] (publish-module! handle spec nil))\n   325\t  ([handle spec opts] (publish-closure! handle spec opts)))\n   326\t\n   327\t\n   328\t(defn- stored-tree\n   329\t  \"The canonical row tree stored under `root` in `handle`, rebuilt\n   330\t   from its individually materialized rows (`vm/materialize-tree!`\n   331\t   stores each row body under its own address), or nil when a reached\n   332\t   row is absent.\"\n   333\t  [handle root]\n   334\t  (loop [queue [root]\n   335\t         rows {}]\n   336\t    (if (empty? queue)\n   337\t      {:root root, :rows rows}\n   338\t      (let [address (first queue)\n   339\t            body (jing/get handle address nil)]\n   340\t        (if-not (vector? body)\n   341\t          nil\n   342\t          (let [row (into [address] body)\n   343\t                kids (into []\n   344\t                           (mapcat (fn [[j [_ kind]]]\n   345\t                                     (let [pos (+ j 2)]\n   346\t                                       (case kind\n   347\t                                         :node [(nth row pos)]\n   348\t                                         :nodes (nth row pos)\n   349\t                                         nil))))\n   350\t                           (map-indexed vector\n   351\t                                        (get vm/semantic-bytecode-grammar\n   352\t                                             (nth row 1))))]\n   353\t            (recur (into (subvec queue 1)\n   354\t                         (remove #(contains? rows %) kids))\n   355\t                   (assoc rows address row))))))))\n   356\t\n   357\t\n   358\t(defn published-call-site-table\n   359\t  \"The C1 side table the module whose manifest is at `address` in\n   360\t   `handle` claims: `{:origin o :root r :rows [...] :tree tree}` with\n   361\t   the rows exactly as stored and the module's canonical tree, or nil\n   362\t   when the module made no C1 claim. The manifest references the table\n   363\t   and its reverse record (`:yin.module/call-sites`), so the reference —\n   364\t   not a recomputation — is what is resolved here: the rows are fetched\n   365\t   from the referenced table address and held to the record the\n   366\t   publication wrote (version 1, the manifest's own tree, the\n   367\t   publisher's origin), so a module whose markers were never retained\n   368\t   answers nil, never a recomputation passed off as the published\n   369\t   table.\"\n   370\t  [handle address]\n   371\t  (let [manifest (jing/get handle address nil)\n   372\t        call-sites (:yin.module/call-sites manifest)]\n   373\t    (when (and (map? manifest) (:yin.module/tree manifest)\n   374\t               (map? call-sites) (jing/segment-address? (:table call-sites))\n   375\t               (jing/segment-address? (:record call-sites)))\n   376\t      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n   377\t        (let [origin (publication-origin (:root tree))\n   378\t              stored-rows (jing/get handle (:table call-sites) nil)\n   379\t              stored-record (jing/get handle (:record call-sites) nil)\n   380\t              expected-record {:yang.call-site/version 1\n   381\t                               :yang.call-site/root (:yin.module/tree manifest)\n   382\t                               :yang.call-site/origin origin\n   383\t                               :yang.call-site/table (:table call-sites)}]\n   384\t          (when (and (vector? stored-rows)\n   385\t                     (= expected-record stored-record))\n   386\t            {:orig