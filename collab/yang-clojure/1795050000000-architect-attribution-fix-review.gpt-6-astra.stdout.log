4\t      (testing \"a defective first member is caught too\"\n   465\t        (is (= :yang/call-site-unsupported-version\n   466\t               (failure-rule\n   467\t                 #(encoder/program-batch\n   468\t                    [(assoc ast :yang/call-site 2) ast] 0)))))))\n   469\t  (testing \"the verdicts ride the batch per member\"\n   470\t    (let [ast (yang/compile '(+ (* 2 3) 4))]\n   471\t      (is (= [true false] (nth (encoder/program-batch\n   472\t                                 [ast (strip-call-sites ast)] 0) 5))\n   473\t          \"one verdict per member: the marked member claims, the\n   474\t           unmarked member does not\")\n   475\t      (is (= 5 (count (encoder/program-batch\n   476\t                        [(strip-call-sites ast) (strip-call-sites ast)] 0)))\n   477\t          \"no member claims: the batch keeps the five-element shape\"))))\n   478\t\n   479\t\n   480\t(deftest per-member-metadata-test\n   481\t  (testing \"a claimed sibling never manufactures a table for an\n   482\t            unmarked selected member — the selected member's own\n   483\t            verdict decides its metadata\"\n   484\t    (let [store (macro/seed-store\n   485\t                  (macro/make-ctx {:token :callsite-test/standard-forms\n   486\t                                   :source-medium :callsite-test/standard-forms})\n   487\t                  [macro/stdlib-forms])\n   488\t          ctx (macro/make-ctx {:token \"callsite-test\"\n   489\t                               :source-medium :program-in\n   490\t                               :store store})\n   491\t          marked (yang/compile '(+ (* 2 3) 4))\n   492\t          unmarked (strip-call-sites marked)\n   493\t          ;; tree 0 claims, tree 1 (the run tree) does not\n   494\t          batch (encoder/program-batch [marked unmarked] 1)]\n   495\t      (is (= [true false] (nth batch 5)))\n   496\t      (let [{:keys [status frontend-metadata]}\n   497\t            (macro/expand-batch batch ctx)]\n   498\t        (is (= :ok status))\n   499\t        (is (nil? frontend-metadata)\n   500\t            \"the unmarked run member's own verdict made no table\"))\n   501\t      (testing \"the same batch with the claimed member selected finalizes its table\"\n   502\t        (let [batch (encoder/program-batch [marked unmarked] 0)\n   503\t              {:keys [status frontend-metadata]}\n   504\t              (macro/expand-batch batch ctx)]\n   505\t          (is (= :ok status))\n   506\t          (is (seq frontend-metadata)))))))\n   507\t\n   508\t\n   509\t(deftest publish-version-reason-test\n   510\t  (testing \"a present-but-wrong marker version refuses with the\n   511\t            unsupported-version reason, never incomplete coverage\"\n   512\t    (doseq [bad-value [false nil 0 \"1\" true]]\n   513\t      (testing (pr-str bad-value)\n   514\t        (let [store (mem/create-content-mem)\n   515\t              ast (assoc (yang/compile-program '[(defn f [x] (inc x)) (f 2)])\n   516\t                         :yang/call-site bad-value)\n   517\t              res (publish/publish-module!\n   518\t                    store {:name 'bad-version-value\n   519\t                           :ast ast\n   520\t                           :exports #{'f}\n   521\t                           :requires {}\n   522\t                           :primitives {'inc {:yin.k/profile :yin.k/pure\n   523\t                                              :yin.k/effects #{}}}})]\n   524\t          (is (= :refused (:status res)))\n   525\t          (is (= :yin.link.publish/unsupported-call-site-version\n   526\t                 (:reason res)))\n   527\t          (is (= bad-value (:unsupported-version res)))\n   528\t          (is (nil? (:address res))))))))\n   529\t\n   530\t\n   531\t(def ^:private publish-registry\n   532\t  \"The host registry the published-module test publishes over: the\n   533\t   `cell` and `data` host modules the `clj` and `yang.call` module\n   534\t   trees read.\"\n   535\t  (-> (module/default-registry)\n   536\t      module/register-cell-module\n   537\t      (data/register-data-module {::data/max-items 1048576})))\n   538\t\n   539\t\n   540\t(deftest published-module-test\n   541\t  (testing \"the markers are retrievable from the published module\"\n   542\t    (let [store (mem/create-content-mem)\n   543\t          call-result (publish/publish-module!\n   544\t                        store (call/module-spec publish-registry))\n   545\t          call-address (:address call-result)\n   546\t          clj-result (publish/publish-module!\n   547\t                       store (clj-prelude/module-spec publish-registry\n   548\t                                                       call-address))\n   549\t          clj-address (:address clj-result)]\n   550\t      (is (some? call-address))\n   551\t      (is (some? clj-address))\n   552\t      (doseq [[label result address]\n   553\t              [[\"yang.call\" call-result call-address]\n   554\t               [\"clj\" clj-result clj-address]]]\n   555\t        (testing label\n   556\t          (is (some? (get-in result [:call-sites :record]))\n   557\t              \"the publication retains its side table beside the manifest\")\n   558\t          (let [{:keys [tree origin rows]}\n   559\t                (publish/published-call-site-table store address)]\n   560\t            (is (some? rows)\n   561\t                \"the markers are retrievable from the published module\")\n   562\t            (is (pos? (count rows)))\n   563\t            (is (= (eligible-under tree origin) (marked rows)))\n   564\t            (is (true? (yang/validate-call-site-coverage!\n   565\t                         tree rows origin {:declared? true}))))))))\n   566\t  (testing \"an unannotated module publishes no table and claims none\"\n   567\t    (let [store (mem/create-content-mem)\n   568\t          plain (publish/publish-module!\n   569\t                  store {:name 'plain\n   570\t                         :ast {:type :application\n   571\t                               :operator {:type :variable :name 'yin/def}\n   572\t                               :operands [{:type :literal :value 'f}\n   573\t                                          {:type :literal :value 42}]}\n   574\t                         :exports #{'f} :requires {} :primitives {}})]\n   575\t      (is (some? (:address plain)))\n   576\t      (is (not (contains? plain :call-sites)))\n   577\t      (is (nil? (publish/published-call-site-table store\n   578\t                                                    (:address plain))))))\n   579\t  (testing \"the manifest references the side table, so the closure carries it\"\n   580\t    (let [store (mem/create-content-mem)\n   581\t          result (publish/publish-module!\n   582\t                   store (clj-prelude/module-spec\n   583\t                           publish-registry\n   584\t                           (:address (publish/publish-module!\n   585\t                                       store\n   586\t                                       (call/module-spec publish-registry)))))\n   587\t          address (:address result)\n   588\t          manifest (jing/get store address nil)\n   589\t          reference (:yin.module/call-sites manifest)]\n   590\t      (is (map? reference)\n   591\t          \"the manifest names the side table and its reverse record\")\n   592\t      (is (every? jing/segment-address? ((juxt :table :record) reference)))\n   593\t      (is (= (:table (:call-sites result)) (:table reference)))\n   594\t      (is (some? (jing/get store (:table reference) nil)))\n   595\t      (is (some? (jing/get store (:record reference) nil)))\n   596\t      ;; transfer: fetch exactly the closure the walk answers missing, as\n   597\t      ;; a dao.space.dht load does, into a fresh store\n   598\t      (let [fresh (mem/create-content-mem)]\n   599\t        (loop [n 0]\n   600\t          (let [w (closure/walk fresh address)]\n   601\t            (if (= :missing (:yin.link.closure/outcome w))\n   602\t              (do (jing/materialize!\n   603\t                    fresh (jing/get store (:address w) ::absent))\n   604\t                  (recur (inc n)))\n   605\t              (do (is (= :complete (:yin.link.closure/outcome w)))\n   606\t                  (is (pos? n) \"the walk fetched the module's blobs\")\n   607\t                  (let [{:keys [tree origin rows]}\n   608\t                        (publish/published-call-site-table fresh address)]\n   609\t                    (is (some? rows)\n   610\t                        \"the side table is retrievable from the transfer\")\n   611\t                    (is (= (:rows (publish/published-call-site-table\n   612\t                                    store address))\n   613\t                           rows))\n   614\t                    (is (= (eligible-under tree origin) (marked rows)))\n   615\t                    (is (true? (yang/validate-call-site-coverage!\n   616\t                                 tree rows origin {:declared? true})))))))))))\n   617\t  (testing \"a version-2 table is a claim rejection, not a silent nil\"\n   618\t    (let [store (mem/create-content-mem)\n   619\t          bump (fn bump [node]\n   620\t                 (if (and (map? node) (= 1 (:yang/call-site node)))\n   621\t                   (assoc node :yang/call-site 2)\n   622\t                   node))\n   623\t          ast (clojure.walk/postwalk bump\n   624\t                (yang/compile-program '[(defn f [x] (inc x)) (f 2)]))\n   625\t          res (publish/publish-module!\n   626\t                store {:name 'bad-version\n   627\t                       :ast ast\n   628\t                       :exports #{'f}\n   629\t                       :requires {}\n   630\t                       :primitives {'inc {:yin.k/profile :yin.k/pure\n   631\t                                          :yin.k/effects #{}}}})]\n   632\t      (is (= :refused (:status res)))\n   633\t      (is (= :yin.link.publish/unsupported-call-site-version (:reason res)))\n   634\t      (is (= 2 (:unsupported-version res)))\n   635\t      (is (nil? (:address res))\n   636\t          \"a claim rejection publishes nothing, so no table exists\"))))\n   220\t\n   221\t\n   222\t(defn- member-ast\n   223\t  [member]\n   224\t  (cond (and (map? member) (contains? member :type)) member\n   225\t        (sequential? member) (vm/datoms->ast (vec member))\n   226\t        :else (throw (ex-info \"Unsupported program batch member\"\n   227\t                              {:rule :batch-member, :member member}))))\n   228\t\n   229\t\n   230\t(def ^:private call-site-key\n   231\t  \"The reserved frontend-metadata key of the call-site occurrence\n   232\t   contract C1 (`yang.clojure`), enforced at this boundary but not\n   233\t   owned by it.\"\n   234\t  :yang/call-site)\n   235\t\n   236\t\n   237\t(defn- marked-call-sites\n   238\t  \"The `[path value]` of every node of map AST `ast` carrying the C1\n   239\t   key, walked by the row grammar. Literal payloads are data, never\n   240\t   syntax, and are not walked. Member ASTs are already projected by the\n   241\t   time this runs, so every tag is a grammar tag.\"\n   242\t  [ast]\n   243\t  (letfn [(walk\n   244\t            [node path]\n   245\t            (into (if (contains? node call-site-key)\n   246\t                    [[path (get node call-site-key)]]\n   247\t                    [])\n   248\t                  (mapcat (fn [[j [field kind]]]\n   249\t                            (let [pos (+ j 2)\n   250\t                                  value (get node field)]\n   251\t                              (case kind\n   252\t                                :node (walk value (conj path pos))\n   253\t                                :nodes (mapcat (fn [[i child]]\n   254\t                                                 (walk child\n   255\t                                                       (conj path [pos i])))\n   256\t                                               (map-indexed vector value))\n   257\t                                nil)))\n   258\t                          (map-indexed vector\n   259\t                                       (get vm/semantic-bytecode-grammar\n   260\t                                            (:type node))))))]\n   261\t    (walk ast [])))\n   262\t\n   263\t\n   264\t(defn- check-call-site-claim!\n   265\t  \"Refuse a batch member whose C1 markers do not exactly cover its\n   266\t   projected tree, naming the failed `:rule`: canonical-row production\n   267\t   must not silently drop a frontend's coverage claim. The claim is\n   268\t   checked root-relatively — admission origins belong to the admitting\n   269\t   expander, not to this projection. A member carrying no markers\n   270\t   makes no claim and passes; the executed tree's table is finalized\n   271\t   after expansion, over the final rows. Answers true when the member\n   272\t   claimed coverage (it passed the check), false when it carried no\n   273\t   markers — one verdict per member, so the selected member's own\n   274\t   verdict, never a sibling's, decides whether the expander finalizes\n   275\t   its side table.\"\n   276\t  [ast tree]\n   277\t  (let [marked (marked-call-sites ast)]\n   278\t    (if (seq marked)\n   279\t      (do (doseq [[path value] marked]\n   280\t            (when (not= 1 value)\n   281\t              (throw (ex-info \"Unsupported call-site marker version\"\n   282\t                              {:rule :yang/call-site-unsupported-version,\n   283\t                               :path path, :value value}))))\n   284\t          (let [eligible (into #{} (map second) (vm/application-occurrences tree))\n   285\t                claimed (into #{} (map first) marked)]\n   286\t            (when (not= eligible claimed)\n   287\t              (throw (ex-info \"Call-site markers do not cover the projected tree\"\n   288\t                              {:rule :yang/call-site-incomplete-coverage,\n   289\t                               :missing (vec (sort-by pr-str\n   290\t                                                      (remove claimed eligible))),\n   291\t                               :extra (vec (sort-by pr-str\n   292\t                                                    (remove eligible claimed)))}))))\n   293\t          true)\n   294\t      false)))\n   295\t\n   296\t\n   297\t(defn program-batch\n   298\t  \"Encode frontend output as the expander's input batch (§2.1):\n   299\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows\n   300\t   call-site-claims]` — the trailing element present only when some\n   301\t   member claimed call-site (C1) coverage, holding one boolean verdict\n   302\t   per member, so every unclaimed batch keeps the five-element shape.\n   303\t   Each member — a map AST or a `:yin/*` datom batch\n   304\t   — projects to one tree packet; `run-index` selects the one that\n   305\t   becomes the program. Harvest rows name every `(yin/def\n   306\t   <literal-symbol> value)` occurrence in source declaration order,\n   307\t   member by member; declaration rows name those whose lambda the\n   308\t   frontend flagged `:macro?`. No syntax object crosses: every code\n   309\t   field is canonical rows. A member whose frontend markers claim\n   310\t   call-site (C1) coverage is checked against its projected tree before\n   311\t   the batch is formed (`check-call-site-claim!`): the markers drop out\n   312\t   of the rows, but never silently — a broken claim refuses the batch,\n   313\t   and the per-member claim verdicts travel with the batch, so the\n   314\t   expander finalizes a member's executed tree's table when, and only\n   315\t   when, that member's own verdict is a claim.\"\n   316\t  ([member] (program-batch [member] 0))\n   317\t  ([members run-index]\n   318\t   (let [asts (mapv member-ast members)\n   319\t         row-sets (mapv vm/ast->semantic-bytecode asts)\n   320\t         trees (mapv (fn [{:keys [root rows]}] [root (vec (vals rows))])\n   321\t                     row-sets)\n   322\t         occurrences (vec (mapcat (fn [j ast]\n   323\t                                    (map #(assoc % :tree j)\n   324\t                                         (definition-occurrences ast)))\n   325\t                                  (range) asts))\n   326\t         ;; A frontend's C1 claim is enforced here, where its markers\n   327\t         ;; would otherwise drop out of canonical-row production unread.\n   328\t         ;; EVERY member is validated — `mapv` is eager, so a defect in\n   329\t         ;; any member refuses the batch, however valid its siblings —\n   330\t         ;; and the per-member verdicts ride with the batch: each\n   331\t         ;; member's own verdict, never a sibling's, decides whether the\n   332\t         ;; expander finalizes that member's side table.\n   333\t         verdicts (mapv check-call-site-claim! asts row-sets)\n   334\t         claims (when (some true? verdicts) verdicts)]\n   335\t     (cond-> [:yin.program/batch\n   336\t              trees\n   337\t              run-index\n   338\t              (into [] (comp (filter :declared?)\n   339\t                             (map (fn [{:keys [tree path]}]\n   340\t                                    [:yin.macro/definition tree path])))\n   341\t                    occurrences)\n   342\t              (into [] (map-indexed (fn [h {:keys [tree path]}]\n   343\t                                      [:yin.macro/harvest h tree path]))\n   344\t                    occurrences)]\n   345\t       claims (conj claims)))))\n   346\t\n   347\t\n   348\t(defn ready?\n   349\t  \"The encoder accepts a batch whenever its row medium can take one. A v2\n   350\t   ring-buffer writer evicts rather than blocking, so it is always ready.\"\n   351\t  [_writer]\n   352\t  true)\n   353\t\n   354\t\n   355\t(defn load\n   356\t  \"The encoder's `load`: project one observed batch and forward it — append\n   357\t   the canonical `{:root … :rows …}` set to the row medium whose writer the\n   358\t   composition handed the session. The consumer is that writer, so it is\n   359\t   returned unchanged. A non-`ok` append throws naming the outcome, so a\n   360\t   batch is never dropped silently.\"\n   361\t  [writer batch]\n   362\t  (let [append (stream/append! writer (project batch))]\n   363\t    (when-not (= :dao.stream/ok (:dao.stream/outcome append))\n   364\t      (throw (ex-info \"Encoder could not forward a batch to the row medium\"\n   365\t                      {:dao.stream/outcome (:dao.stream/outcome append)})))\n","exit_code":0,"status":"completed"}}
