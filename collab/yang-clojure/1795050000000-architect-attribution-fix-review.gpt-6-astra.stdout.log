\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1308\t                    [index root'] (retail (:index st) root')\n  1309\t                    [index root'] (lower-standins index root')\n  1310\t                    tree (packet-of index root')\n  1311\t                    ;; the occurrence origin of this expansion (§2.1):\n  1312\t                    ;; the admission this batch produced the final tree\n  1313\t                    ;; under — the second coordinate of the side table's\n  1314\t                    ;; site identity, beside the final root address\n  1315\t                    origin (source-origin ctx source-batch run-index)\n  1316\t                    ;; the selected member's own verdict decides its\n  1317\t                    ;; metadata; a sibling's claim never manufactures a\n  1318\t                    ;; table for a member that made none\n  1319\t                    claims (batch-call-site-claims batch)\n  1320\t                     metadata (when (and claims (nth claims run-index))\n  1321\t                                (final-call-site-metadata\n  1322\t                                  (packet->row-set tree) origin))]\n  1323\t                (if-let [e (valid-tree? tree)]\n  1324\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1325\t                  (finish (assoc st :tree tree :next-store next-store\n  1326\t                                 :frontend-metadata metadata\n  1327\t                                  :call-site-origin (when metadata origin))))))))))))\n  1328\t\n  1329\t\n  1330\t(defn expand\n  1331\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1332\t   the error data.\"\n  1333\t  [batch ctx]\n  1334\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1335\t    (if (= :ok status)\n  1336\t      tree\n  1337\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1338\t\n  1339\t\n  1340\t(defn make