n   118\t   manifest can be recomputed — and its absence detected — from the\n   119\t   manifest alone.\"\n   120\t  [root]\n   121\t  [:source :yin.vm.linker.publish/publish root 0])\n   122\t\n   123\t\n   124\t(defn- claims-call-sites?\n   125\t  \"True when map AST `ast` carries the C1 key anywhere. A hit inside a\n   126\t   literal payload is data, not a claim: extraction then finds no\n   127\t   markers and the module publishes unannotated, as it should.\"\n   128\t  [ast]\n   129\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n   130\t\n   131\t\n   132\t(defn- call-site-claim\n   133\t  \"The C1 claim `ast` makes over its canonical `tree`: nil when it\n   134\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\n   135\t   when the extracted markers exactly cover the tree's eligible\n   136\t   application occurrences; `{:missing [...] :extra [...]}` when they\n   137\t   do not; `{:unsupported-version v :path p}` when a marker's value is\n   138\t   not version 1 — a claim rejection, never a silent acceptance of a\n   139\t   table a retriever would read as version 1.\"\n   140\t  [ast tree]\n   141\t  (when (claims-call-sites? ast)\n   142\t    (let [origin (publication-origin (:root tree))\n   143\t          extracted (filter #(= :yang/call-site (nth % 3))\n   144\t                            (:frontend-metadata\n   145\t                              (vm/ast-side-tables ast tree origin)))\n   146\t          eligible (into #{}\n   147\t                         (map (fn [[r p]] [origin r p]))\n   148\t                         (vm/application-occurrences tree))\n   149\t          marked (into #{}\n   150\t                       (map (fn [[o r p _ _]] [o r p]))\n   151\t                       extracted)]\n   152\t      (or (when-let [[v p] (some (fn [row]\n   153\t                                   (let [v (nth row 4)]\n   154\t                                     (when (not (and (integer? v) (= 1 v)))\n   155\t     