tree))))))\n@@ -1225,14 +1419,25 @@\n                     [(failed st (invalid :address-conflict)) address]\n                     (if-let [e (guard-batch-rows st')]\n                       [(failed st' e) address]\n-                      (let [;; the output's construction origin function\n-                            ;; (ruling U1); an output the prelude did not\n-                            ;; thread — unreachable through the sanctioned\n-                            ;; constructors — classifies as constructed\n+                      (if (and (nil? (origin-of-fn tree))\n+                               (packet-has-application? tree))\n+                        ;; missing provenance never proves construction\n+                        ;; (P1-1): an application-bearing output no\n+                        ;; sanctioned operation accounted for is refused,\n+                        ;; never relabelled with this expansion's origin\n+                        [(failed st' (invalid :missing-provenance)) address]\n+                        (let [;; the output's construction origin function\n+                            ;; (ruling U1), threaded by the prelude through\n+                            ;; every packet it built or reassembled; the\n+                            ;; fallback is reached only by an output\n+                            ;; without applications, whose correspondence\n+                            ;; never consults it\n                             ofn (or (origin-of-fn tree)\n                                     (fn [_] pending-expansion-origin))\n-                            corr (output-correspondence tree ofn)\n-                            out (first tree)\n+                            corr (output-correspondence tree ofn)]\n+                        (if (some #(= ::missing-provenance %) (vals corr))\n+                          [(failed st' (invalid :missing-provenance)) address]\n+                          (let [out (first tree)\n                             ev (begin out nil corr)\n                             st' (-> st'\n                                     (record-event ev)\n@@ -1260,7 +1465,7 @@\n                                         (let [o (get corr (subvec abs-path (count path)))]\n                                           (if (and (vector? o) (= :retained (first o)))\n                                             (second o)\n-                                            [:expansion (first ev)])))})))))))))))))\n+                                            [:expansion (first ev)])))}))))))))))))))))\n \n \n (defn- expand-children\ndiff --git a/test/yang/clojure_callsite_test.cljc b/test/yang/clojure_callsite_test.cljc\nindex 98dc328a..44a425a9 100644\n--- a/test/yang/clojure_callsite_test.cljc\n+++ b/test/yang/clojure_callsite_test.cljc\n@@ -1038,6 +1038,81 @@\n           (is (true? (yang/validate-call-site-coverage!\n                        tree rows origin {:declared? true}))))))))\n \n+(defn- correspondences\n+  \"Every expansion correspondence the log recorded.\"\n+  [log]\n+  (map #(nth % 11) (nth log 1)))\n+\n+\n+(deftest p1-packet-provenance-test\n+  (testing \"packet reassembly retains the incoming origin (P1-1)\"\n+    (let [ast (yang/compile-program\n+                '[(defmacro repack [x]\n+                    (conj [] (first x) (first (rest x))))\n+                  (repack (+ 1 2))])\n+          {:keys [ctx result]} (expand-like-the-repl ast)\n+          {:keys [status tree frontend-metadata log]} result\n+          final (macro/packet->row-set tree)\n+          admission [:source :program-in (:t ctx) 0]]\n+      (is (= :ok status))\n+      (is (contains? (set (correspondences log))\n+                     {[] [:retained admission]})\n+          \"the reassembled packet records the incoming origin as\n+           retained, never fabricated construction\")\n+      (is (= #{admission} (row-origins frontend-metadata))\n+          \"the retained application keeps its source origin\")\n+      (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\n+      (is (true? (yang/validate-call-site-coverage!\n+                   final frontend-metadata admission\n+                   {:declared? true :per-occurrence-origins? true})))))\n+  (testing \"a reassembled packet inserted as a child retains its origin (P1-1)\"\n+    (let [ast (yang/compile-program\n+                '[(defmacro repack-call [x]\n+                    (yin/application (yin/variable 'f)\n+                                     [(conj [] (first x)\n+                                            (first (rest x)))]))\n+                  (defn f [y] y)\n+                  (repack-call (+ 1 2))])\n+          {:keys [ctx result]} (expand-like-the-repl ast)\n+          {:keys [status tree frontend-metadata log]} result\n+          final (macro/packet->row-set tree)\n+          admission [:source :program-in (:t ctx) 0]\n+          event-addrs (into #{} (map first) (nth log 1))]\n+      (is (= :ok status))\n+      (is (contains? (set (correspondences log))\n+                     {[] :constructed, [[3 0]] [:retained admission]})\n+          \"the built call is constructed; the reassembled child keeps\n+           its incoming origin\")\n+      (is (contains? (row-origins frontend-metadata) admission))\n+      (is (some (fn [o]\n+                  (and (expansion-origin? o)\n+                       (contains? event-addrs (second o))))\n+                (row-origins frontend-metadata))\n+          \"the built call names its recorded expansion event\")\n+      (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\n+      (is (true? (yang/validate-call-site-coverage!\n+                   final frontend-metadata admission\n+                   {:declared? true :per-occurrence-origins? true})))))\n+  (testing \"a packet entering a literal slot encodes cleanly (P1-2)\"\n+    (let [ast (yang/compile-program\n+                '[(defmacro packet-data [x] (yin/literal x))\n+                  (packet-data (+