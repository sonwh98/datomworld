{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,420p' .agents/skills/code-review-pr/scripts/pr_reviewer.py; cat /tmp/cc1-p1/AGENTS.md; nl -ba /tmp/cc1-p1/src/cljc/yin/vm.cljc | sed -n '340,440p'; rg -n 'record\\\\?|meta-bytes|sequential\\\\?|list\\\\?' /tmp/cc1-p1/src/cljc/dao/jing/cbor.cljc\"","aggregated_output":"    return findings\n\n\ndef analyze_git_target(target: str, repo_dir: Optional[str] = None) -> ReviewSummary:\n    \"\"\"Analyzes git target (e.g. main...HEAD, HEAD~1, staged, working).\"\"\"\n    git_args = []\n    log_args = []\n\n    if target == \"staged\":\n        git_args = [\"diff\", \"--cached\"]\n        log_args = [\"log\", \"-n\", \"5\", \"--oneline\"]\n    elif target == \"working\":\n        git_args = [\"diff\", \"HEAD\"]\n        log_args = [\"log\", \"-n\", \"5\", \"--oneline\"]\n    else:\n        git_args = [\"diff\", target]\n        if \"...\" in target:\n            base, head = target.split(\"...\")\n            log_args = [\"log\", \"--oneline\", f\"{base}..{head}\"]\n        elif \"..\" in target:\n            log_args = [\"log\", \"--oneline\", target]\n        else:\n            log_args = [\"log\", \"--oneline\", \"-n\", \"10\", target]\n\n    diff_text = run_git_command(git_args, cwd=repo_dir)\n\n    # Get numstat\n    numstat_raw = run_git_command(git_args + [\"--numstat\"], cwd=repo_dir)\n\n    # Get commit log if available\n    commits = []\n    try:\n        log_raw = run_git_command(log_args, cwd=repo_dir)\n        if log_raw:\n            commits = log_raw.splitlines()\n    except Exception:\n        commits = []\n\n    file_stats: List[FileStat] = []\n    total_additions = 0\n    total_deletions = 0\n    test_additions = 0\n    source_additions = 0\n\n    for line in numstat_raw.splitlines():\n        parts = line.split(\"\\t\")\n        if len(parts) == 3:\n            add_str, del_str, file_path = parts\n            add = int(add_str) if add_str.isdigit() else 0\n            dele = int(del_str) if del_str.isdigit() else 0\n\n            category, risk = categorize_file(file_path)\n            file_stats.append(\n                FileStat(\n                    path=file_path,\n                    additions=add,\n                    deletions=dele,\n                    category=category,\n                    risk_level=risk,\n                )\n            )\n\n            total_additions += add\n            total_deletions += dele\n\n            if category == \"Tests\":\n                test_additions += add\n            elif category in [\"Source Code\", \"Security/Auth\", \"Database/Schema\", \"API/Contract\"]:\n                source_additions += add\n\n    ratio = (test_additions / source_additions) if source_additions > 0 else (1.0 if test_additions > 0 else 0.0)\n\n    findings = scan_diff_content(diff_text)\n\n    # Add meta finding if source added without tests\n    if source_additions > 50 and test_additions == 0:\n        findings.append(\n            Finding(\n                severity=\"P1\",\n                category=\"TestCoverage\",\n                file_path=\"Repository\",\n                line_number=None,\n                message=f\"Significant source changes ({source_additions} lines added) without any new/updated tests.\",\n                snippet=\"\",\n            )\n        )\n\n    return ReviewSummary(\n        target=target,\n        total_files=len(file_stats),\n        total_additions=total_additions,\n        total_deletions=total_deletions,\n        test_additions=test_additions,\n        source_additions=source_additions,\n        test_to_source_ratio=round(ratio, 2),\n        file_stats=file_stats,\n        findings=findings,\n        commits=commits,\n    )\n\n\ndef generate_markdown_report(summary: ReviewSummary) -> str:\n    \"\"\"Formats ReviewSummary into a clean Markdown PR review report.\"\"\"\n    lines = []\n    lines.append(f\"# Code Review Summary for `{summary.target}`\")\n    lines.append(\"\")\n    lines.append(\"## Executive Overview\")\n    lines.append(f\"- **Total Files Changed:** {summary.total_files}\")\n    lines.append(f\"- **Lines Added:** +{summary.total_additions} | **Lines Deleted:** -{summary.total_deletions}\")\n    lines.append(f\"- **Test-to-Source Additions Ratio:** {summary.test_to_source_ratio} ({summary.test_additions} test lines vs {summary.source_additions} source lines)\")\n\n    high_risk_files = [f for f in summary.file_stats if f.risk_level == \"High\"]\n    overall_risk = \"HIGH\" if (high_risk_files or any(f.severity in [\"P0\", \"P1\"] for f in summary.findings)) else (\"MEDIUM\" if summary.total_additions > 100 else \"LOW\")\n    lines.append(f\"- **Overall Change Risk:** `{overall_risk}`\")\n    lines.append(\"\")\n\n    if summary.commits:\n        lines.append(\"### Included Commits\")\n        for c in summary.commits[:10]:\n            lines.append(f\"- {c}\")\n        if len(summary.commits) > 10:\n            lines.append(f\"- ... and {len(summary.commits) - 10} more commits.\")\n        lines.append(\"\")\n\n    lines.append(\"## Automated Scan Findings\")\n    if not summary.findings:\n        lines.append(\"✅ No critical security or code quality smells detected by automated scan.\")\n    else:\n        # Group by severity\n        for sev in [\"P0\", \"P1\", \"P2\", \"P3\"]:\n            sev_findings = [f for f in summary.findings if f.severity == sev]\n            if sev_findings:\n                sev_title = {\"P0\": \"P0 - Critical (Blocker)\", \"P1\": \"P1 - High (Must Address)\", \"P2\": \"P2 - Medium (Recommended)\", \"P3\": \"P3 - Low (Nit / Suggestion)\"}[sev]\n                lines.append(f\"### {sev_title}\")\n                for f in sev_findings:\n                    loc = f\"`{f.file_path}`\" + (f\":L{f.line_number}\" if f.line_number else \"\")\n                    lines.append(f\"- **[{f.category}]** {loc}: {f.message}\")\n                    if f.snippet:\n                        lines.append(f\"  ```\\n  {f.snippet}\\n  ```\")\n    lines.append(\"\")\n\n    lines.append(\"## File Churn & Risk Breakdown\")\n    lines.append(\"| File Path | Category | +Add | -Del | Risk |\")\n    lines.append(\"| :--- | :--- | :--- | :--- | :--- |\")\n    for f in sorted(summary.file_stats, key=lambda x: (x.risk_level != \"High\", x.risk_level != \"Medium\", -(x.additions + x.deletions))):\n        lines.append(f\"| `{f.path}` | {f.category} | +{f.additions} | -{f.deletions} | `{f.risk_level}` |\")\n    lines.append(\"\")\n\n    lines.append(\"## Reviewer Focus & Recommendations\")\n    categories_present = set(f.category for f in summary.file_stats)\n    if \"Security/Auth\" in categories_present:\n        lines.append(\"- 🔒 **Security / Auth:** Double-check credential handling, session management, and authorization checks.\")\n    if \"Database/Schema\" in categories_present:\n        lines.append(\"- 🗄️ **Database:** Verify migration rollback compatibility, index performance, and transaction boundaries.\")\n    if \"API/Contract\" in categories_present:\n        lines.append(\"- 🔌 **API Contract:** Ensure backward compatibility for public endpoints and schema definitions.\")\n    if summary.test_to_source_ratio < 0.3 and summary.source_additions > 30:\n        lines.append(\"- 🧪 **Testing:** Test coverage appears low relative to source code additions. Request unit/integration test additions.\")\n\n    return \"\\n\".join(lines)\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"PR Reviewer & Git Diff Analyzer\")\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Subcommand to run\")\n\n    analyze_parser = subparsers.add_parser(\"analyze\", help=\"Analyze git target and generate report\")\n    analyze_parser.add_argument(\"--target\", default=\"main...HEAD\", help=\"Git ref/range to analyze (e.g. main...HEAD, HEAD~1, staged, working)\")\n    analyze_parser.add_argument(\"--output\", help=\"Output file path (Markdown or JSON depending on format)\")\n    analyze_parser.add_argument(\"--format\", choices=[\"markdown\", \"json\"], default=\"markdown\", help=\"Output format (markdown or json)\")\n    analyze_parser.add_argument(\"--repo-dir\", help=\"Target git repository directory\")\n\n    args = parser.parse_args()\n\n    if not args.command or args.command == \"analyze\":\n        target = getattr(args, \"target\", \"main...HEAD\")\n        output = getattr(args, \"output\", None)\n        fmt = getattr(args, \"format\", \"markdown\")\n        repo_dir = getattr(args, \"repo-dir\", None)\n\n        try:\n            summary = analyze_git_target(target, repo_dir=repo_dir)\n\n            if fmt == \"json\":\n                result = json.dumps(asdict(summary), indent=2)\n            else:\n                result = generate_markdown_report(summary)\n\n            if output:\n                out_path = Path(output)\n                out_path.parent.mkdir(parents=True, exist_ok=True)\n                out_path.write_text(result, encoding=\"utf-8\")\n                print(f\"✅ Review report written to: {out_path.resolve()}\")\n            else:\n                print(result)\n\n        except Exception as e:\n            sys.stderr.write(f\"Error during PR analysis: {e}\\n\")\n            sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\n# ==============================================================================\n# datom.world – Development Rules & Architectural Foundations\n# ==============================================================================\n\nSee [`docs/design/datom.world.md`](./docs/design/datom.world.md) for master architecture, core philosophy, foundational axioms, non-negotiable invariants, code style, development workflow, and operational guides (testing, team roles, agent delegation, website formats).\n   340\t  \"Build UCF §7.5.2's published profile record for `name`.\n   341\t\n   342\t   The address covers the name and all four semantic declarations. The name\n   343\t   remains the registry key rather than being duplicated in the returned\n   344\t   record. Profile values contain no host function objects and are therefore\n   345\t   ordinary portable data.\"\n   346\t  [name class arities effects host-state]\n   347\t  (let [description {:yin.k/name name,\n   348\t                     :yin.k/class class,\n   349\t                     :yin.k/arities (vec arities),\n   350\t                     :yin.k/effects (set effects),\n   351\t                     :yin.k/host-state host-state}\n   352\t        digest (jing/content-hash description {:algorithm :blake3})]\n   353\t    {:yin.k/profile (keyword \"yin.k.pp\" (str \"blake3-\" digest)),\n   354\t     :yin.k/class class,\n   355\t     :yin.k/arities (vec arities),\n   356\t     :yin.k/effects (set effects),\n   357\t     :yin.k/host-state host-state}))\n   358\t\n   359\t\n   360\t(defn primitive-function\n   361\t  \"Return the executable value published by a primitive registry entry.\n   362\t\n   363\t   Bare entries remain supported for composition-supplied legacy registries.\"\n   364\t  [entry]\n   365\t  (if (and (map? entry) (contains? entry :yin.k/function))\n   366\t    (:yin.k/function entry)\n   367\t    entry))\n   368\t\n   369\t\n   370\t(defn- primitive-entry\n   371\t  [name function class arities effects]\n   372\t  (assoc (primitive-profile name class arities effects :none)\n   373\t         :yin.k/function function))\n   374\t\n   375\t\n   376\t(def primitives\n   377\t  \"The standard executable primitive registry, published with UCF §7.5.2\n   378\t   profiles. `:yin.k/function` is host-local; the five profile keys are the\n   379\t   portable publication. `:variadic` means the greatest listed fixed arity\n   380\t   extends to further arguments.\"\n   381\t  (let [pure (fn [name function arities]\n   382\t               [name (primitive-entry name function :pure arities #{})])]\n   383\t    (into {}\n   384\t          [(pure '+ + [0 1 2 :variadic])\n   385\t           (pure '- - [1 2 :variadic])\n   386\t           (pure '* * [0 1 2 :variadic])\n   387\t           (pure '/ checked-divide [1 2 :variadic])\n   388\t           (pure '= = [0 1 2 :variadic])\n   389\t           (pure '== = [0 1 2 :variadic])\n   390\t           (pure '!= not= [1 2 :variadic])\n   391\t           (pure '< < [1 2 :variadic])\n   392\t           (pure '> > [1 2 :variadic])\n   393\t           (pure '<= <= [1 2 :variadic])\n   394\t           (pure '>= >= [1 2 :variadic])\n   395\t           (pure 'not not [1])\n   396\t           (pure 'nil? nil? [1])\n   397\t           (pure 'empty? empty? [1])\n   398\t           (pure 'first first [1])\n   399\t           (pure 'rest (fn [a] (vec (rest a))) [1])\n   400\t           (pure 'conj conj [1 2 :variadic])\n   401\t           (pure 'assoc assoc [3 :variadic])\n   402\t           (pure 'get get [2 3])\n   403\t           (pure 'vec vec [1])\n   404\t           ;; one arity: strict UTF-8 on every host (dao.host.text, slice\n   405\t           ;; H2, ratified OQ11: encoding arity 2 removed from portable profile)\n   406\t           (pure 'bytes->str\n   407\t                 (fn [b] (text/utf8-decode b))\n   408\t                 [1])\n   409\t           ['require (primitive-entry\n   410\t                       'require\n   411\t                       (fn [spec]\n   412\t                         (let [ns-sym (if (vector? spec) (first spec) spec)]\n   413\t                           (effect/make :module/require {:module ns-sym})))\n   414\t                       :effectful [1] #{:module/require})]\n   415\t           ['try-require (primitive-entry\n   416\t                           'try-require\n   417\t                           (fn [spec]\n   418\t                             (let [ns-sym (if (vector? spec) (first spec) spec)]\n   419\t                               (effect/make :module/try-require\n   420\t                                            {:module ns-sym})))\n   421\t                           :effectful [1] #{:module/try-require})]])))\n   422\t\n   423\t\n   424\t(def ^:private primitive-profile-keys\n   425\t  [:yin.k/profile :yin.k/class :yin.k/arities :yin.k/effects\n   426\t   :yin.k/host-state])\n   427\t\n   428\t\n   429\t(def primitive-profiles\n   430\t  \"Portable projection of the standard registry, retained as a convenience.\"\n   431\t  (into {} (map (fn [[name entry]]\n   432\t                  [name (select-keys entry primitive-profile-keys)]))\n   433\t        primitives))\n   434\t\n   435\t\n   436\t(def primitive-canonical-names\n   437\t  \"Canonical-name declarations for intentional aliases in `primitives`.\n   438\t\n   439\t   The table is name -> canonical name, not function -> name, so it remains\n   440\t   plain portable data. `=` and `==` intentionally share one host function.\"\n419:  (or (vector? x) (list? x) (seq? x)))\n818:(defn- meta-bytes\n893:    (symbol? x) (meta-bytes x d #(identifier-bytes \"dao.jing/symbol\" x %))\n902:    (record? x) (refuse :unsupported-value \"record\")\n903:    (map? x) (meta-bytes x d #(map-bytes x %))\n904:    (vector? x) (meta-bytes x d (fn [d]\n908:    (set? x) (meta-bytes x d #(set-bytes x %))\n909:    (or (list? x) (seq? x)) (meta-bytes x d #(list-bytes x %))\n1185:      (when-not (and (or (vector? v) (map? v) (set? v) (list? v) (symbol? v))\n","exit_code":0,"status":"completed"}}
