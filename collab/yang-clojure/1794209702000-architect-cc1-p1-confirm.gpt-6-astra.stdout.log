m→row half of the §9.1 codec pair.\\\"\\n    99\\t  [datoms]\\n   100\\t  (vm/ast->semantic-bytecode (vm/datoms->ast datoms)))\\n   101\\t\\n   102\\t\\n   103\\t(defn- project-member\\n   104\\t  [member origin member-index]\\n   105\\t  (cond\\n   106\\t    (and (map? member) (contains? member :type))\\n   107\\t    (let [tree (vm/ast->semantic-bytecode member)]\\n   108\\t      (merge {:tree tree, :entity-occurrences []}\\n   109\\t             (vm/ast-side-tables member tree origin)))\\n   110\\t\\n   111\\t    (and (map? member) (contains? member :root) (contains? member :rows))\\n   112\\t    {:tree member, :source-positions [], :frontend-metadata [],\\n   113\\t     :entity-occurrences []}\\n   114\\t\\n   115\\t    (sequential? member)\\n   116\\t    (let [datoms (vec member)\\n   117\\t          ast (vm/datoms->ast datoms)\\n   118\\t          tree (vm/ast->semantic-bytecode ast)]\\n   119\\t      (merge {:tree tree\\n   120\\t              :entity-occurrences (datom-entity-occurrences datoms member-index)}\\n   121\\t             (vm/ast-side-tables ast tree origin)))\\n   122\\t\\n   123\\t    :else\\n   124\\t    (throw (ex-info \\\"Unsupported source batch member\\\"\\n   125\\t                    {:rule :batch-member, :member member,\\n   126\\t                     :member-index member-index}))))\\n   127\\t\\n   128\\t\\n   129\\t(defn- project-envelope\\n   130\\t  [{:yin/keys [source-medium batch-token batch root] :as envelope}]\\n   131\\t  (when-not (and (vector? batch)\\n   132\\t                 (seq batch)\\n   133\\t                 (integer? root)\\n   134\\t                 (<= 0 root)\\n   135\\t                 (< root (count batch)))\\n   136\\t    (throw (ex-info \\\"Malformed source batch envelope\\\"\\n   137\\t                    {:rule :batch-envelope, :envelope envelope})))\\n   138\\t  (let [projected (mapv (fn [j member]\\n   139\\t                          (project-member member\\n   140\\t                                          (vm/source-origin source-medium\\n   141\\t                                                            batch-token j)\\n   142\\t                                          j))\\n   143\\t                        (range) batch)]\\n   144\\t    (assoc envelope\\n   145\\t           :yin/batch (mapv :tree projected)\\n   146\\t           :yin/source-positions (into [] (mapcat :source-positions) projected)\\n   147\\t           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\\n   148\\t           :yin/entity-occurrences (into [] (mapcat :entity-occurrences) projected))))\\n   149\\t\\n   150\\t\\n   151\\t(defn project\\n   152\\t  \\\"One program-medium batch to its canonical row set `{:root id, :rows …}`\\n   153\\t   (§6.1). A batch that is neither a map AST nor a datom batch is a defect\\n   154\\t   of the medium and throws here, at the boundary, naming where it failed.\\\"\\n   155\\t  [batch]\\n   225\\t        (sequential? member) (vm/datoms->ast (vec member))\\n   226\\t        :else (throw (ex-info \\\"Unsupported program batch member\\\"\\n   227\\t                              {:rule :batch-member, :member member}))))\\n   228\\t\\n   229\\t\\n   230\\t(defn program-batch\\n   231\\t  \\\"Encode frontend output as the expander's input batch (§2.1):\\n   232\\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows]`.\\n   233\\t   Each member — a map AST or a `:yin/*` datom batch — projects to one tree\\n   234\\t   packet; `run-index` selects the one that becomes the program. Harvest\\n   235\\t   rows name every `(yin/def <literal-symbol> value)` occurrence in source\\n   236\\t   declaration order, member by member; declaration rows name those whose\\n   237\\t   lambda the frontend flagged `:macro?`. No syntax object crosses: every\\n   238\\t   code field is canonical rows.\\\"\\n   239\\t  ([member] (program-batch [member] 0))\\n   240\\t  ([members run-index]\\n   241\\t   (let [asts (mapv member-ast members)\\n   242\\t         trees (mapv (fn [ast]\\n   243\\t                       (let [{:keys [root rows]} (vm/ast->semantic-bytecode ast)]\\n   244\\t                         [root (vec (vals rows))]))\\n   245\\t                     asts)\\n   246\\t         occurrences (vec (mapcat (fn [j ast]\\n   247\\t                                    (map #(assoc % :tree j)\\n   248\\t                                         (definition-occurrences ast)))\\n   249\\t                                  (range) asts))]\\n   250\\t     [:yin.program/batch\\n   251\\t      trees\\n   252\\t      run-index\\n   253\\t      (into [] (comp (filter :declared?)\\n   254\\t                     (map (fn [{:keys [tree path]}] [:yin.macro/definition tree path])))\\n   255\\t            occurrences)\\n   256\\t      (into [] (map-indexed (fn [h {:keys [tree path]}]\\n   257\\t                              [:yin.macro/harvest h tree path]))\\n   258\\t            occurrences)])))\\n   259\\t\\n   260\\t\\n   261\\t(defn ready?\\n   262\\t  \\\"The encoder accepts a batch whenever its row medium can take one. A v2\\n   263\\t   ring-buffer writer evicts rather than blocking, so it is always ready.\\\"\\n   264\\t  [_writer]\\n   265\\t  true)\\n   266\\t\\n   267\\t\\n   268\\t(defn load\\n   269\\t  \\\"The encoder's `load`: project one observed batch and forward it — append\\n   270\\t   the canonical `{:root … :rows …}` set to the row medium whose writer the\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1794970000000-reviewer-cc1.codex.stdout.log:40:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'Clojure|round 1|JVM|Node|Dart|Jolt|acceptance gate' collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md | tail -35\\\"\",\"aggregated_output\":\"8:Citation convention: paths beginning `yang/` or `yin/` are under `src/cljc/`; a shortened filename inherits the nearest explicit namespace/path. `ruling-of-record.md` abbreviates the signed 1794600000000 ruling named in §1; `code-as-tuples.md` abbreviates `docs/design/yin.vm.code-as-tuples.md`. Line ranges identify inspected source, while normative decisions in C1/D1 and the acceptance gates are new design requirements.\\n12:Adopt one language-neutral application-occurrence contract over the existing occurrence relation, one reserved frontend-metadata key, and the already-ruled third trace field. Keep code content, provenance, attribution evidence, and verification results separate. Publish the durable correspondence as an additional addressable record referring to the oracle's evidence **without changing that evidence's format**. Production adoption includes Clojure, TypeScript, PHP, Python, their preludes, and the additional ingress paths inventoried below.\\n132:| Clojure `compile-form`, `compile`, `compile-program`, `lower-unit`: `src/cljc/yang/clojure.cljc:2021,2164,2839,2993` | Cover native and argument-vector/outcome compilation, library/adapters, linked unit wrapping and global publication. Finalize at executable roots, after expansion. Existing fragment APIs need not invent origins. |\\n137:| REPL frontend catalog: `yin/repl/frontends.cljc:24-110` | Covers single-form vs multi-form Clojure, legacy PHP, Python session lowering and Jolt native parser selection. Standard catalog does not currently register TypeScript; direct TS paths still require adoption. |\\n148:| Existing derivation verification: `yin/vm/ledger.cljc:156-215`, `yin/vm/linker.cljc:2164-2255` | Existing verification re-lowers code and compares identities, not side metadata. Keep code verification and add independent provenance/correspondence verification. `:trusted` does not satisfy this new acceptance gate. |\\n161:1. `yang.call`, Clojure `clj` and its library, TypeScript `js/jssp`, Python `py/pysp`, and PHP `php` plus its hook/runtime publications. Shared emitter anchors: `yang/core/call.cljc:184`, `yang/clojure/prelude.cljc:125-143`, TS `prelude.cljc:4168-4260`, Python `prelude.cljc:3645-3739`, PHP `prelude.cljc:5328-5411`. Include PHP's definition lists `prelude_module.cljc:386` and `prelude_p9.cljc:558`; their inclusion must not escape measurement because they are emitted through the main prelude.\\n247:These are acceptance requirements, not claims that current tests already pass. **No frontend may drop Jolt because shared code compiled on another host.** Host lanes and VM execution formats are separate axes.\\n249:| Frontend | JVM | Node | Dart | Jolt |\\n251:| Production Clojure | Reader/source, all production entry points, publication/load/query and trace fixtures | Same portable source/forms and paths, publication/load/query and trace fixtures | Same | Same; run current reader limitations as explicit refusals, not substitute parsers |\\n252:| TypeScript / JS dialect | Local source parser plus portable CST lowering, bundled/linked/prelude publications and load/query | Same pinned source-derived CST through portable lowering; parserless import/load; fresh prelude publication | Same packet/import/publication gate | Same packet/import/publication gate; Jolt load/parity is required |\\n256:TS local parser restriction is recorded at `docs/design/yang.typescript.md:113-116,517-518`; its packet-level execution policy at `:1325-1326`. Python's host selection is implemented in `yin/repl/frontends.cljc:71-110`; Jolt's native Python adapter describes its actual parser and refusal in `src/jolt/yang/antlr/cst.jolt:1-28`. PHP's local ANTLR parser is `src/clj/yang/php/antlr/cst.clj`, while the independent portable legacy compiler remains registered at `yin/repl/frontends.cljc:69-70`. Existing Jolt applicability exclusions are explicit per-test data (`test/resources/yin/repl/jolt-applicability.edn:1-5,46-48`); they cannot be expanded to evade these new gates.\\n266:- Identical final canonical roots and the full set of `[origin root path]` keys on JVM, Node and Dart; include Jolt in the same comparison for the mandatory portable paths.\\n269:- For TS/PHP packet routes, compare compilation of the same source-derived validated CST; record the JVM parser artifact. This proves compilation equality, not nonexistent local-parser parity. Python additionally compares source parsing/export across its real local parsers, following the existing exporter conformance model (`test/yang/antlr/conformance.cljc:1-20`).\\n276:**Clojure.** Inventory native/argument-vector/outcome compile options, `compile` vs `compile-program`, `compile-form` callers, macro expansion, `lower-unit`, `library-for`, direct walker/datoms/rows lanes, REPL single/multi-form and linked runtime publication. Show a non-oracle production fixture traversing the full pipeline, including macro-generated and helper calls. Republish `clj` and `yang.call` on each host. Oracle-specific stamping is instantiation #1 only; it does not close this brief. Anchors: `yang/clojure.cljc:2021-2034,2164-2200,2791,2839-2862,2993-3021`.\\n335:| Clojure | Native and argument-vector/outcome roots, macro outputs, guest library, linked `clj/yang.call`, repeated REPL admissions; `A_clj + L_clj + sum(P_f)` plus retained expansion/input closure | Nested/multi-arity/indirect/helper/tail calls in both production and oracle-specific fixtures; oracle owns its existing ceilings |\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1795010000000-reviewer-cc1-fix.codex.stdout.log:22:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'call-site occurrence|call-site-malformed|declared canonical|transport|Addendum A' docs\\\"\",\"aggregated_output\":\"docs/dao.space.stigmergy.md:93:  coordinate plus manifest address into a transportable exact-bounded d5\\ndocs/dao.space.stigmergy.md:119:`dao.stream.rpc` already provides the transport shape this wants — a WebSocket server\\ndocs/agents/advanced-concepts.md:2:description: Advan