currence: a `:variable` naming\\n  1109\\t   a store entry that no enclosing lambda parameter shadows.\\\"\\n  1110\\t  [st operator shadow]\\n  1111\\t  (let [row (get (:index st) operator)]\\n  1112\\t    (when (and (= :variable (row-tag row))\\n  1113\\t               (not (contains? shadow (nth row 2))))\\n  1114\\t      (get (:store st) (nth row 2)))))\\n  1115\\t\\n  1116\\t\\n  1117\\t(defn- record-event\\n  1118\\t  [st event-row*]\\n  1119\\t  (update st :events conj event-row*))\\n  1120\\t\\n  1121\\t\\n  1122\\t(defn- guard-batch-rows\\n  1123\\t  [st]\\n  1124\\t  (let [limit (get-in st [:ctx :guards :max-rows-per-batch])\\n  1125\\t        n (count (:index st))]\\n  1126\\t    (when (and limit (> n limit))\\n  1127\\t      {:kind :row-guard, :scope :batch, :rows n})))\\n  1128\\t\\n  1129\\t\\n  1130\\t(defn- merge-output\\n  1131\\t  \\\"Merge a validated result packet into the working index; an address whose\\n  1132\\t   working body differs is an `:address-conflict`.\\\"\\n  1133\\t  [st [_ rows]]\\n  1134\\t  (reduce (fn [st row]\\n  1135\\t            (let [prior (get (:index st) (first row))]\\n  1136\\t              (cond (nil? prior) (assoc-in st [:index (first row)] row)\\n  1137\\t                    (same-value? prior row) st\\n  1138\\t                    :else (reduced (assoc st ::conflict (first row))))))\\n  1139\\t          st\\n  1140\\t          rows))\\n  1141\\t\\n  1142\\t\\n  1143\\t(declare expand-node)\\n  1144\\t\\n  1145\\t\\n  1180\\t   origin. The output's per-occurrence correspondence is read from that\\n  1181\\t   construction history, retained in the event record, and the\\n  1182\\t   recursive walk answers origins from the record — never from\\n  1183\\t   comparing content addresses.\\\"\\n  1184\\t  [st address entry {:keys [path rel frame shadow depth origin-of]}]\\n  1185\\t  (let [[st counter] (allocate-attempt st)\\n  1186\\t        ctx (:ctx st)\\n  1187\\t        macro-root (first (:yin.macro/tree entry))\\n  1188\\t        begin (fn [output error correspondence]\\n  1189\\t                (event-row (attempt-id ctx counter)\\n  1190\\t                           (:source-batch st)\\n  1191\\t                           (when-not (:parent frame)\\n  1192\\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\\n  1193\\t                           (:parent frame)\\n  1194\\t                           (:root frame)\\n  1195\\t                           rel\\n  1196\\t                           macro-root\\n  1197\\t                           output\\n  1198\\t                           error\\n  1199\\t                           correspondence))\\n  1200\\t        failed (fn [st error]\\n  1201\\t                 (-> st (record-event (begin nil error nil)) (fail error)))\\n  1202\\t        guards (:guards ctx)]\\n  1203\\t    (if (>= depth (:max-depth guards))\\n  1204\\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\\n  1205\\t      (let [row (get (:index st) address)\\n  1206\\t            operands (map-indexed\\n  1207\\t                      (fn [i a]\\n  1208\\t                        (with-origin-of (packet-of (:index st) a)\\n  1209\\t                          (fn [rel]\\n  1210\\t                            (origin-of (into (conj path [3 i]) rel)))))\\n  1211\\t                      (nth row 3))\\n  1212\\t            {:keys [tree error]} (invoke* entry operands ctx counter)\\n  1213\\t            invalid (fn [reason]\\n  1214\\t                      {:kind :invalid-output, :macro macro-root, :path path,\\n  1215\\t                       :reason reason})]\\n  1216\\t        (if error\\n  1217\\t          [(failed st error) address]\\n  1218\\t          (if-let [e (valid-tree? tree {:working? true})]\\n  1219\\t            [(failed st (invalid (:reason e))) address]\\n  1220\\t            (let [n (count (set (map first (second tree))))]\\n  1221\\t              (if (> n (:max-rows-per-expansion guards))\\n  1222\\t                [(failed st {:kind :row-guard, :scope :expansion, :rows n}) address]\\n  1223\\t                (let [st' (merge-output st tree)]\\n  1224\\t                  (if (::conflict st')\\n  1225\\t                    [(failed st (invalid :address-conflict)) address]\\n  1226\\t                    (if-let [e (guard-batch-rows st')]\\n  1227\\t                      [(failed st' e) address]\\n  1228\\t                      (let [;; the output's construction origin function\\n  1229\\t                            ;; (ruling U1); an output the prelude did not\\n  1230\\t                            ;; thread — unreachable through the sanctioned\\n  1231\\t                            ;; constructors — classifies as constructed\\n  1232\\t                            ofn (or (origin-of-fn tree)\\n  1233\\t                                    (fn [_] pending-expansion-origin))\\n  1234\\t                            corr (output-correspondence tree ofn)\\n  1235\\t                            out (first tree)\\n  1236\\t                            ev (begin out nil corr)\\n  1237\\t                            st' (-> st'\\n  1238\\t                                    (record-event ev)\\n  1239\\t                                    (update :produced\\n  1240\\t                                            (fn [p]\\n  1241\\t                                              (if (some #(= out (first %)) p)\\n  1242\\t                                                p\\n  1243\\t                                                (conj p (packet-of (:index st') out))))))]\\n  1244\\t                        (expand-node st' out\\n  1245\\t                                     {:path path,\\n  1246\\t                                      :rel [],\\n  1247\\t                                      :frame {:parent (first ev), :root out},\\n  1248\\t                                      :shadow shadow,\\n  1249\\t                                      :depth (inc depth),\\n  1250\\t                                      ;; per-occurrence origins read from\\n  1251\\t                                      ;; the RETAINED correspondence (§2.1,\\n  1252\\t                                      ;; §8): a `[:retained origin]` names\\n  1253\\t                                      ;; the incoming origin the syntax\\n  1254\\t                                      ;; already carried, a `:constructed`\\n  1255\\t                                      ;; occurrence names the recorded\\n  1256\\t                                      ;; expansion event — the record the\\n  1257\\t                                      ;; correspondence is retained in\\n  1258\\t                                      :origin-of\\n  1259\\t                                      (fn [abs-path]\\n  1260\\t                                        (let [o (get corr (subvec abs-path (count path)))]\\n  1261\\t                                          (if (and (vector? o) (= :retained (first o)))\\n  1262\\t                                            (second o)\\n  1263\\t                                            [:expansion (first ev)])))})))))))))))))\\n  1264\\t\\n  1265\\t\\n  1266\\t(defn- expand-children\\n  1267\\t  \\\"Expand `row`'s children in order `places` under per-child shadows;\\n  1268\\t   `[st address']`, rebuilding the row when any child changed.\\\"\\n  1269\\t  [st row places shadow-of {:keys [path rel] :as loc}]\\n  1270\\t  (let [[st children']\\n  1271\\t        (reduce (fn [[st acc] [coord c]]\\n  1272\\t                  (if (:error st)\\n  1273\\t                    (reduced [st acc])\\n  1274\\t                    (let [[st c'] (expand-node st c\\n  1275\\t                                               (assoc loc\\n  1276\\t                                                      :path (conj path coord)\\n  1277\\t                                                      :rel (conj rel coord)\\n  1278\\t                                                      :shadow (shadow-of coord)))]\\n  1279\\t                      [st (conj acc c')])))\\n  1280\\t                [st []]\\n  1281\\t                places)]\\n  1282\\t    (if (:error st)\\n  1283\\t      [st (first row)]\\n  1284\\t      (let [[index a'] (rebuild-row (:index st) row places children')]\\n  1285\\t        [(assoc st :index index) a']))))\\n  1286\\t\\n  1287\\t\\n  1288\\t(defn- expand-node\\n  1289\\t  \\\"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\\n  1290\\t   `rel` path within the current `frame` (`{:root r :parent event|nil\\n  1291\\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\\n  1292\\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\\n  1293\\t   answers, for an ABSOLUTE occurrence path, the origin of the\\n  1294\\t   admission or generation event that produced the syntax there.\\n  1295\\t   Every application\\n  1296\\t   occurrence is recorded under its absolute path as it is visited, so\\n  1297\\t   the finalizer can name each occurrence's real origin; an occurrence\\n  1298\\t   replaced by an expansion is re-recorded by the expansion's own walk,\\n  1299\\t   and a stale entry for a path the finished tree no longer applies at\\n  1300\\t   is simply never read. Returns `[st address']`; a failure sets\\n  1301\\t   `(:error st)`.\\\"\\n  1302\\t  [st address {:keys [shadow] :as loc}]\\n  1303\\t  (if (:error st)\\n  1304\\t    [st address]\\n  1305\\t    (let [row (get (:index st) address)\\n  1306\\t          tag (row-tag row)]\\n  1307\\t      (cond\\n  1308\\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\\n  1309\\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\\n  1310\\t\\n  1311\\t        (= :application tag)\\n  1312\\t        (let [st (update-in st [:call-site-origins]\\n  1313\\t                            assoc (:path loc) ((:origin-of loc) (:path loc)))\\n  1314\\t              op (nth row 2)\\n  1315\\t              [st op'] (expand-node st op (-> loc\\n  1316\\t                                              (update :path conj 2)\\n  1317\\t                                              (update :rel conj 2)))]\\n  1318\\t          (if (:error st)\\n  1319\\t            [st address]\\n  1320\\t            (let [[index app'] (if (= op op')\\n  1321\\t                                 [(:index st) address]\\n  1322\\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\\n  1323\\t                  st (assoc st :index index)\\n  1324\\t                  row' (get index app')]\\n  1325\\t              (if (macro-of st op' shadow)\\n  1326\\t                ;; recognition is not expansion: depth is unchanged\\n  1327\\t                (expand-node st app' loc)\\n  1328\\t                (expand-children st row' (rest (child-places row'))\\n  1329\\t                                 (constantly shadow) loc)))))\\n  1330\\t\\n  1331\\t        :else\\n  1332\\t        (let [shadow' (if (= :lambda tag) (into shadow (nth row 2)) shadow)]\\n  1333\\t          (expand-children st row (child-places row)\\n  1334\\t                           (constantly shadow') loc))))))\\n  1335\\t\\n  1336\\t\\n  1337\\t;; =============================================================================\\n  1338\\t;; The batch (§3.1, §3.2)\\n  1339\\t;; =============================================================================\\n  1340\\t\\n  1341\\t(defn- log-packet\\n  1342\\t  [st]\\n  1343\\t  [:yin.macro/log (:events st) (:produced st)])\\n  1344\\t\\n  1345\\t\\n  1346\\t(defn- with-default-guards\\n  1347\\t  [ctx]\\n  1348\\t  (update ctx :guards #(merge default-guards %)))\\n  1349\\t\\n  1350\\t\\n  1351\\t(defn- batch-call-site-claims\\n  1352\\t  \\\"The per-member call-site (C1) claim verdicts the encoder recorded on\\n  1353\\t   `batch`: nil when no member claimed coverage, otherwise one boolean\\n  1354\\t   per member — the encoder validated every member's markers against\\n  1355\\t   its own tree at the boundary, so a member whose markers do not\\n  1356\\t   exactly cover it was refused there, never delivered here. Each\\n  1357\\t   member's own verdict decides its metadata: only a member that\\n  1358\\t   claimed coverage finalizes a side table, whatever its siblings\\n  1359\\t   claimed.\\\"\\n  1360\\t  [batch]\\n  1361\\t  (nth batch 5 nil))\\n  1362\\t\\n  1363\\t\\n  1364\\t(defn- final-call-site-metadata\\n  1365\\t  \\\"The call-site occurrence contract's (C1) side table of an expanded\\n  1366\\t   final tree, as frontend-metadata rows `[origin root path\\n  1367\\t   :yang/call-site 1]` in printed-row order: one row per\\n  1368\\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\\n  1369\\t   that actually executes. The frontend's own markers named the\\n  1370\\t   pre-expansion tree; expansion, tail marking and stand-in lowering\\n  1371\\t   recompute roots and paths, so no pre-expansion table can cover this\\n  1372\\t   tree and the table is finalized here, over the finished rows.\\n  1373\\t\\n  1374\\t   Each row's origin is that occurrence's REAL origin (design §2.1,\\n  1375\\t   §2.3): `occurrence-origins` maps the final occurrence path to the\\n  1376\\t   origin of the admission or generation event that produced the\\n  1377\\t   application syntax at that path — the admitted run member's source\\n  1378\\t   origin for retained syntax (a no-op expansion keeps it valid), and\\n  1379\\t   the `[:expansion record-address]` of the recorded expansion event\\n  1380\\t   whose output introduced generated syntax. No expansion-record\\n  1381\\t   address is fabricated: only event rows the expander actually\\n  1382\\t   recorded appear. The table is therefore the explicit\\n  1383\\t   final-root correspondence §2.3 requires — every generated occurrence\\n  1384\\t   names its producing record, so an attribution consumer can reach the\\n  1385\\t   event (its input root, call path, macro root, output root) from the\\n  1386\\t   row alone.\\\"\\n  1387\\t  [row-set occurrence-origins admission-origin]\\n  1388\\t  (vec (sort-by pr-str\\n  1620\\t  [expander tree origin]\\n  1621\\t  (get (:call-site-tables expander) [origin (first tree)]))\\n  1622\\t\\n  1623\\t\\n  1624\\t(defn load\\n  1625\\t  \\\"Expand one observed batch once: keep the returned context, stage the\\n  1626\\t   tree only on success, stage the log when a log writer exists, and\\n  1627\\t   accumulate the error of a failed expansion. Expansion failure is\\n  1628\\t   data, so the cursor advances past it. A successful expansion's C1\\n  1629\\t   side table (the batch result's `:frontend-metadata`, present only\\n  1630\\t   when the selected member itself claimed coverage) is retained on the\\n  1631\\t   consumer under the occurrence identity of the staged tree — its\\n  1632\\t   admission origin beside its final root address (`call-site-tables`,\\n  1633\\t   resolved by `call-site-table`) — so the composition that drives this\\n  1634\\t   expander — the REPL's session — holds every executed occurrence's\\n  1635\\t   coverage beside the expander that produced it, each load's table\\n  1636\\t   surviving the next, even when two loads land on the same root.\\\"\\n  1637\\t  [expander batch]\\n  1638\\t  (let [{:keys [status tree log error ctx frontend-metadata\\n  1639\\t                call-site-origin]}\\n  1640\\t        (expand-batch batch (:ctx expander))]\\n  1641\\t    (cond-> (assoc expander :ctx ctx)\\n  1642\\t      (= :ok status) (assoc :out-staged tree)\\n  1643\\t      (and (= :ok status) frontend-metadata)\\n  1644\\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\\n  1645\\t                frontend-metadata)\\n  1646\\t      (:log expander) (assoc :log-staged log)\\n  1647\\t      (= :error status) (update :errors conj error))))\\n  1648\\t\\n  1649\\t\\n  1650\\t(defn- flush-slot\\n  1651\\t  [expander writer-key slot-key on-ok]\\n  1652\\t  (if-let [payload (get expander slot-key)]\\n  1653\\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\\n  1654\\t      (case outcome\\n  1655\\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\\n  1656\\t        :dao.stream/full expander\\n  1657\\t        (throw (ex-info \\\"Expander could not publish a staged value\\\"\\n  1658\\t                        {:dao.stream/outcome outcome,\\n  1659\\t                         :destination slot-key,\\n  1660\\t                         :consumer expander}))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1795455000000-reviewer-cc1-fix5.codex.stdout.log:43:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yin/vm.cljc | sed -n '376,430p;895,935p'; nl -ba src/cljc/dao/jing/cbor.cljc | sed -n '905,935p'\\\"\",\"aggregated_output\":\"   376\\t(def primitives\\n   377\\t  \\\"The standard executable primitive registry, published with UCF §7.5.2\\n   378\\t   profiles. `:yin.k/function` is host-local; the five profile keys are the\\n   379\\t   portable publication. `:variadic` means the greatest listed fixed arity\\n   380\\t   extends to further arguments.\\\"\\n   381\\t  (let [pure (fn [name function arities]\\n   382\\t               [name (primitive-entry name function :pure arities #{})])]\\n   383\\t    (into {}\\n   384\\t          [(pure '+ + [0 1 2 :variadic])\\n   385\\t           (pure '- - [1 2 :variadic])\\n   386\\t           (pure '* * [0 1 2 :variadic])\\n   387\\t           (pure '/ checked-divide [1 2 :variadic])\\n   388\\t           (pure '= = [0 1 2 :variadic])\\n   389\\t           (pure '== = [0 1 2 :variadic])\\n   390\\t           (pure '!= not= [1 2 :variadic])\\n   391\\t           (pure '< < [1 2 :variadic])\\n   392\\t           (pure '> > [1 2 :variadic])\\n   393\\t           (pure '<= <= [1 2 :variadic])\\n   394\\t           (pure '>= >= [1 2 :variadic])\\n   395\\t           (pure 'not not [1])\\n   396\\t           (pure 'nil? nil? [1])\\n   397\\t           (pure 'empty? empty? [1])\\n   398\\t           (pure 'first first [1])\\n   399\\t           (pure 'rest (fn [a] (vec (rest a))) [1])\\n   400\\t           (pure 'conj conj [1 2 :variadic])\\n   401\\t           (pure 'assoc assoc [3 :variadic])\\n   402\\t           (pure 'get get [2 3])\\n   403\\t           (pure 'vec vec [1])\\n   404\\t           ;; one arity: strict UTF-8 on every host (dao.host.text, slice\\n   405\\t           ;; H2, ratified OQ11: encoding arity 2 removed from portable profile)\\n   406\\t           (pure 'bytes->str\\n   407\\t                 (fn [b] (text/utf8-decode b))\\n   408\\t                 [1])\\n   409\\t           ['require (primitive-entry\\n   410\\t                       'require\\n   411\\t                       (fn [spec]\\n   412\\t                         (let [ns-sym (if (vector? spec) (first spec) spec)]\\n   413\\t                           (effect/make :module/require {:module ns-sym})))\\n   414\\t                       :effectful [1] #{:module/require})]\\n   415\\t           ['try-require (primitive-entry\\n   416\\t                           'try-require\\n   417\\t                           (fn [spec]\\n   418\\t                             (let [ns-sym (if (vector? spec) (first spec) spec)]\\n   419\\t                               (effect/make :module/try-require\\n   420\\t                                            {:module ns-sym})))\\n   421\\t                           :effectful [1] #{:module/try-require})]])))\\n   422\\t\\n   423\\t\\n   424\\t(def ^:private primitive-profile-keys\\n   425\\t  [:yin.k/profile :yin.k/class :yin.k/arities :yin.k/effects\\n   426\\t   :yin.k/host-state])\\n   427\\t\\n   428\\t\\n   429\\t(def primitive-profiles\\n   430\\t  \\\"Portable projection of the standard registry, retained as a convenience.\\\"\\n   895\\t       :vm/current-continuation base\\n   896\\t       ;; fallback\\n   897\\t       (throw (ex-info \\\"Unknown AST node type in datoms\\\"\\n   898\\t                       {:type node-type, :root-id root-id}))))))\\n   899\\t\\n   900\\t\\n   901\\t(defn plain-data?\\n   902\\t  \\\"True when `x` is data a row or code datom may carry (§2.2, §2.5): scalars\\n   903\\t   and collections of them, never a host function or object. Jing's float64\\n   904\\t   carrier is a scalar: on JS it is how a float keeps its kind in a row.\\n   905\\t   Metadata travels with the value, so it must be plain data too.\\\"\\n   906\\t  [x]\\n   907\\t  (or (nil? x)\\n   908\\t      (and (cond (or (boolean? x) (number? x) (cbor/float64? x) (string? x)\\n   909\\t                     (keyword? x) (symbol? x))\\n   910\\t                 true\\n   911\\t                 (map? x) (and (every? plain-data? (keys x))\\n   912\\t                               (every? plain-data? (vals x)))\\n   913\\t                 (coll? x) (every? plain-data? x)\\n   914\\t                 :else false)\\n   915\\t           (plain-data? (meta x)))))\\n   916\\t\\n   917\\t\\n   918\\t(defn machine-data?\\n   919\\t  \\\"`plain-data?` for a value inside a machine payload: a closure or a\\n   920\\t   continuation, a host type only a kernel mints, counts as its payload,\\n   921\\t   as the plain map it was before D7. Rows and code datoms stay\\n   922\\t   `plain-data?`, plus the exact-integer big carriers (ruling 4).\\\"\\n   923\\t  [x]\\n   924\\t  (or (nil? x)\\n   925\\t      (if (values/host-typed? x)\\n   926\\t        (machine-data? (values/payload x))\\n   927\\t        (and (cond (or (boolean? x) (number? x)\\n   928\\t                       (integer-host/big-carrier? x) (cbor/float64? x)\\n   929\\t                       (string? x) (keyword? x) (symbol? x))\\n   930\\t                   true\\n   931\\t                   (map? x) (and (every? machine-data? (keys x))\\n   932\\t                                 (every? machine-data? (vals x)))\\n   933\\t                   (coll? x) (every? machine-data? x)\\n   934\\t                   :else false)\\n   935\\t             (machine-data? (meta x))))))\\n   905\\t                                  (deep! d :unsupported-value)\\n   906\\t                                  (let [items (mapv #(value-bytes % (inc d)) x)]\\n   907\\t                                    (concat-buffers (cons (write-head 4 (count items)) items)))))\\n   908\\t    (set? x) (meta-bytes x d #(set-bytes x %))\\n   909\\t    (or (list? x) (seq? x)) (meta-bytes x d #(list-bytes x %))\\n   910\\t    :else (refuse :unsupported-value (type-name x))))\\n   911\\t\\n   912\\t\\n   913\\t(defn encode\\n   914\\t  \\\"The canonical CBOR payload bytes of one supported value (byte[] on the\\n   915\\t   JVM, Uint8Array on JavaScript, Uint8List on Dart). Refuses unsupported\\n   916\\t   values, unpaired surrogates, nesting deeper than max-depth, and\\n   917\\t   collections whose members collide after normalization.\\\"\\n   918\\t  [value]\\n   919\\t  (value-bytes value 1))\\n   920\\t\\n   921\\t\\n   922\\t(defn copy-bytes\\n   923\\t  \\\"A fresh copy of host byte array bs, so a holder's snapshot cannot be\\n   924\\t   changed through the array a caller keeps.\\\"\\n   925\\t  [bs]\\n   926\\t  (bytes/slice bs 0 (bytes/length bs)))\\n   927\\t\\n   928\\t\\n   929\\t(defn encoded-compare\\n   930\\t  \\\"Order two supported values by their canonical encodings: the shorter\\n   931\\t   encoding first, then unsigned bytewise (note: canonical map and set encoding\\n   932\\t   uses pure unsigned bytewise lexicographical order per RFC 8949, not length-first).\\n   933\\t   Returns -1, 0 or 1. It encodes both values, so callers reserve it for the\\n   934\\t   rare case that needs it (the min/max tie-break after numeric order has already tied).\\\"\\n   935\\t  [a b]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1795455000000-reviewer-cc1-fix5.codex.stdout.log:44:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"agent_message\",\"text\":\"DO NOT LAND\\n\\n1. **P1-a remains open.** The address-membership check is gone, and directly passed or prelude-constructed packets retain per-occurrence origins. But packets are ordinary vectors and the macro environment exposes collection primitives such as `first`, `rest`, and `conj` ([vm.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm.cljc:398)). A macro can rebuild an identical packet container from an operand without constructing its syntax. That loses the container metadata, so the fallback classifies every application as constructed by the new expansion ([macro.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1232)). The retained syntax consequently receives the wrong origin.\\n\\n2. **U2:** The publisher uses an explicit admission, then a composition-owned scope token, then the deterministic specification default ([publish.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/linker/publish.cljc:277)). The default makes identical undeclared republication one event, as stated in the request. I found no interaction with this round’s expansion changes.\\n\\n3. **Metadata isolation fails at content addressing.** A macro can pass an operand packet as the value to `yin/literal` ([macro.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:667)). The constructor hashes that value before output validation ([macro.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:505)); the packet now carries a function in its metadata, and the CBOR encoder processes collection metadata ([cbor.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/dao/jing/cbor.cljc:908)). This can turn a previously plain packet literal into a body error. In the normal constructor path, final packets are rebuilt from rows, so the tracking metadata itself does not enter the final tree or store.\\n\\n4. **Site table:** The row shape remains `[origin root-address path :yang/call-site 1]` ([macro.cljc](/Users/sto/workspace/datomworld-cc1/src/cljc/yin/vm/macro.cljc:1387)). Origins flow from the recorded correspondence through the occurrence walk, but the metadata-loss case in point 1 causes the record—and therefore the table—to report an incorrect origin.\\n\\n5. **New defects:** The packet-container reconstruction and packet-as-literal cases above are the blockers introduced by the metadata approach.\\n\\nThe ruling file was absent at the supplied path in this checkout; this assessment uses the U1–U3 semantics stated in the request. Review was static and read-only; no tests were run.\"}}\ncollab/yang-clojure/1794207752000-engineer-cc1-p1-metadata-fixes.muse-wonder-1.0-r2.stdout.log:15:- P1-1 reassembly: the prelude collection ops are now provenance-aware. Decomposition registers packet lineage by rows-object identity. Reassembly reattaches the retained origin only when root matches and every row is `identical?` to the registered packet's rows. Content twins recover nothing, so ruling U1 holds. Unaccounted children answer a missing marker. The expander refuses such outputs as `:missing-provenance` instead of fabricating `:constructed`.\n272:                               (when-not (every? vm/plain-data? (get by-addr a))\n","exit_code":0,"status":"completed"}}
