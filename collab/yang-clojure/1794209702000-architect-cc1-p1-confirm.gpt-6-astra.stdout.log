\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba src/cljc/yin/vm/macro.cljc | sed -n '1,200p;820,1068p;1120,1510p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_10\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba src/cljc/yin/vm/macro.cljc | sed -n '1,200p;820,1068p;1120,1510p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\t(ns yin.vm.macro\\\\n     2\\\\t  \\\\\\\"The row-native macro expander (`docs/design/yin.vm.macro.md`, Phase 1).\\\\n     3\\\\t\\\\n     4\\\\t   A process between two media: it observes `program-in` batches\\\\n     5\\\\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows\\\\n     6\\\\t   call-site-claims]` — the trailing element present only when some\\\\n     7\\\\t   member's frontend claimed call-site (C1) coverage, holding one\\\\n     8\\\\t   boolean verdict per member, so every older five-element batch is\\\\n     9\\\\t   still a valid unclaimed batch —\\\\n    10\\\\t   rewrites the selected tree to a fixpoint, and appends one canonical tree\\\\n    11\\\\t   packet `[root rows]` to `program-out`, with one event row per attempt on\\\\n    12\\\\t   an optional log medium. Evaluators know nothing of any of this (decision\\\\n    13\\\\t   1): a macro call is an ordinary `:application` row, macro-ness is an\\\\n    14\\\\t   occurrence declaration beside the tree, and definitions leave as ordinary\\\\n    15\\\\t   syntax or as a literal naming the lowered macro.\\\\n    16\\\\t\\\\n    17\\\\t   Everything here is a value threaded through the step: the macro store,\\\\n    18\\\\t   attempt counter, batch coordinate, and incarnation token live in `ctx`\\\\n    19\\\\t   (§3.1). Expansion failure is data (decision 12); a throw is a defect or a\\\\n    20\\\\t   terminal stream outcome.\\\\\\\"\\\\n    21\\\\t  (:refer-clojure :exclude [flush load])\\\\n    22\\\\t  (:require [dao.jing :as jing]\\\\n    23\\\\t            [dao.stream :as stream]\\\\n    24\\\\t            [dao.stream.observer :as observer]\\\\n    25\\\\t            [yin.vm :as vm]\\\\n    26\\\\t            [yin.vm.ast-walker :as ast-walker]\\\\n    27\\\\t            [yin.vm.engine :as engine]))\\\\n    28\\\\t\\\\n    29\\\\t\\\\n    30\\\\t;; =============================================================================\\\\n    31\\\\t;; Grammar, rows, and packets (§1)\\\\n    32\\\\t;; =============================================================================\\\\n    33\\\\t\\\\n    34\\\\t(def ^:private standin-tag :yin.macro/defined)\\\\n    35\\\\t\\\\n    36\\\\t\\\\n    37\\\\t(def ^:private working-grammar\\\\n    38\\\\t  \\\\\\\"The canonical §2.3 table plus the one working row the expander interns\\\\n    39\\\\t   and lowers itself: `[S :yin.macro/defined name k]` (§3.2 step 3). It is\\\\n    40\\\\t   admitted only in operand and result packets, never in input or output.\\\\\\\"\\\\n    41\\\\t  (assoc vm/semantic-bytecode-grammar standin-tag [[:name :sym] [:k :int]]))\\\\n    42\\\\t\\\\n    43\\\\t\\\\n    44\\\\t(defn- grammar\\\\n    45\\\\t  [working?]\\\\n    46\\\\t  (if working? working-grammar vm/semantic-bytecode-grammar))\\\\n    47\\\\t\\\\n    48\\\\t\\\\n    49\\\\t(defn- row-tag\\\\n    50\\\\t  [row]\\\\n    51\\\\t  (nth row 1))\\\\n    52\\\\t\\\\n    53\\\\t\\\\n    54\\\\t(defn- intern-row\\\\n    55\\\\t  \\\\\\\"The full row for `body`: its content address prepended (§1.1).\\\\\\\"\\\\n    56\\\\t  [body]\\\\n    57\\\\t  (into [(jing/segment-key body)] body))\\\\n    58\\\\t\\\\n    59\\\\t\\\\n    60\\\\t(defn- slot-kinds\\\\n    61\\\\t  \\\\\\\"`[[position kind] ...]` for a tag's grammar slots, positions being full-row\\\\n    62\\\\t   positions (address 0, tag 1, first slot 2).\\\\\\\"\\\\n    63\\\\t  [tag]\\\\n    64\\\\t  (map-indexed (fn [i [_ kind]] [(+ i 2) kind]) (get working-grammar tag)))\\\\n    65\\\\t\\\\n    66\\\\t\\\\n    67\\\\t(defn- child-places\\\\n    68\\\\t  \\\\\\\"`[[coordinate child-address] ...]` of one row in grammar order: a `node`\\\\n    69\\\\t   slot's coordinate is its full-row position, a `nodes` child's is\\\\n    70\\\\t   `[position i]` (§2.1).\\\\\\\"\\\\n    71\\\\t  [row]\\\\n    72\\\\t  (mapcat (fn [[pos kind]]\\\\n    73\\\\t            (case kind\\\\n    74\\\\t              :node [[pos (nth row pos)]]\\\\n    75\\\\t              :nodes (map-indexed (fn [i c] [[pos i] c]) (nth row pos))\\\\n    76\\\\t              nil))\\\\n    77\\\\t          (slot-kinds (row-tag row))))\\\\n    78\\\\t\\\\n    79\\\\t\\\\n    80\\\\t(defn- with-child\\\\n    81\\\\t  \\\\\\\"`row`'s body with the child at coordinate `coord` replaced by `address`.\\\\\\\"\\\\n    82\\\\t  [row coord address]\\\\n    83\\\\t  (let [body (subvec row 1)]\\\\n    84\\\\t    (if (vector? coord)\\\\n    85\\\\t      (let [[pos i] coord]\\\\n    86\\\\t        (assoc body (dec pos) (assoc (nth row pos) i address)))\\\\n    87\\\\t      (assoc body (dec coord) address))))\\\\n    88\\\\t\\\\n    89\\\\t\\\\n    90\\\\t(defn- reachable\\\\n    91\\\\t  \\\\\\\"Addresses reachable from `root` through `index`, first-encounter preorder\\\\n    92\\\\t   in grammar order. Assumes the index is closed and acyclic.\\\\\\\"\\\\n    93\\\\t  [index root]\\\\n    94\\\\t  (loop [stack (list root)\\\\n    95\\\\t         seen #{}\\\\n    96\\\\t         order []]\\\\n    97\\\\t    (if-let [a (first stack)]\\\\n    98\\\\t      (if (contains? seen a)\\\\n    99\\\\t        (recur (rest stack) seen order)\\\\n   100\\\\t        (recur (reduce conj (rest stack) (reverse (map second (child-places (get index a)))))\\\\n   101\\\\t               (conj seen a)\\\\n   102\\\\t               (conj order a)))\\\\n   103\\\\t      order)))\\\\n   104\\\\t\\\\n   105\\\\t\\\\n   106\\\\t(defn- packet-of\\\\n   107\\\\t  \\\\\\\"The self-contained tree packet `[root rows]` rooted at `root` (§1.2). Row\\\\n   108\\\\t   order is preorder, which is deterministic but carries no meaning.\\\\\\\"\\\\n   109\\\\t  [index root]\\\\n   110\\\\t  [root (mapv #(get index %) (reachable index root))])\\\\n   111\\\\t\\\\n   112\\\\t\\\\n   113\\\\t(defn tree-packet\\\\n   114\\\\t  \\\\\\\"Convert a projected row set `{:root id :rows {id row}}` (the shape\\\\n   115\\\\t   `yin.vm/ast->semantic-bytecode` returns) to a tree packet `[root rows]`.\\\\\\\"\\\\n   116\\\\t  [{:keys [root rows]}]\\\\n   117\\\\t  (packet-of rows root))\\\\n   118\\\\t\\\\n   119\\\\t\\\\n   120\\\\t(defn packet->row-set\\\\n   121\\\\t  \\\\\\\"Convert a canonical tree packet to `{:root id :rows {id row}}`, the shape\\\\n   122\\\\t   the evaluator loaders take.\\\\\\\"\\\\n   123\\\\t  [[root rows]]\\\\n   124\\\\t  {:root root, :rows (into {} (map (fn [r] [(first r) r])) rows)})\\\\n   125\\\\t\\\\n   126\\\\t\\\\n   127\\\\t(defn ast->packet\\\\n   128\\\\t  \\\\\\\"Project a map AST to its canonical tree packet.\\\\\\\"\\\\n   129\\\\t  [ast]\\\\n   130\\\\t  (tree-packet (vm/ast->semantic-bytecode ast)))\\\\n   131\\\\t\\\\n   132\\\\t\\\\n   133\\\\t(defn- same-value?\\\\n   134\\\\t  \\\\\\\"`=` that also compares metadata at every depth: the transitional address\\\\n   135\\\\t   encoder does not hash scalar metadata, so two bodies may share an address\\\\n   136\\\\t   while differing there, which is an address conflict (§5.3, §7.2).\\\\\\\"\\\\n   137\\\\t  [a b]\\\\n   138\\\\t  (and (= a b)\\\\n   139\\\\t       (= (meta a) (meta b))\\\\n   140\\\\t       (or (nil? (meta a)) (same-value? (meta a) (meta b)))\\\\n   141\\\\t       (cond (map? a) (every? (fn [[k v]]\\\\n   142\\\\t                                (let [[k' v'] (find b k)]\\\\n   143\\\\t                                  (and (same-value? k k') (same-value? v v'))))\\\\n   144\\\\t                              a)\\\\n   145\\\\t             (set? a) (every? (fn [e] (same-value? e (some #(when (= e %) %) b))) a)\\\\n   146\\\\t             (sequential? a) (every? true? (map same-value? a b))\\\\n   147\\\\t             :else true)))\\\\n   148\\\\t\\\\n   149\\\\t\\\\n   150\\\\t;; =============================================================================\\\\n   151\\\\t;; Packet validation (§7.1, §7.2)\\\\n   152\\\\t;; =============================================================================\\\\n   153\\\\t\\\\n   154\\\\t(defn- standin-shaped?\\\\n   155\\\\t  \\\\\\\"A vector that reads as a working stand-in row or body.\\\\\\\"\\\\n   156\\\\t  [x]\\\\n   157\\\\t  (and (vector? x)\\\\n   158\\\\t       (or (= standin-tag (first x))\\\\n   159\\\\t           (and (< 1 (count x)) (= standin-tag (nth x 1))))))\\\\n   160\\\\t\\\\n   161\\\\t\\\\n   162\\\\t(defn- marker-in?\\\\n   163\\\\t  \\\\\\\"True when a stand-in-shaped vector appears anywhere inside a value.\\\\\\\"\\\\n   164\\\\t  [x]\\\\n   165\\\\t  (or (standin-shaped? x)\\\\n   166\\\\t      (and (map? x) (some (fn [[k v]] (or (marker-in? k) (marker-in? v))) x))\\\\n   167\\\\t      (and (coll? x) (not (map? x)) (some marker-in? x))\\\\n   168\\\\t      (and (some? (meta x)) (marker-in? (meta x)))))\\\\n   169\\\\t\\\\n   170\\\\t\\\\n   171\\\\t(defn- slot-shape-ok?\\\\n   172\\\\t  \\\\\\\"Slot kind check. `data`/`key` admit any value here; plain-ness is the\\\\n   173\\\\t   separate `:host-value` rule.\\\\\\\"\\\\n   174\\\\t  [kind v]\\\\n   175\\\\t  (case kind\\\\n   176\\\\t    :node (jing/segment-address? v)\\\\n   177\\\\t    :nodes (and (vector? v) (every? jing/segment-address? v))\\\\n   178\\\\t    (:data :key) true\\\\n   179\\\\t    :sym (symbol? v)\\\\n   180\\\\t    :syms (and (vector? v) (every? symbol? v))\\\\n   181\\\\t    :kw (keyword? v)\\\\n   182\\\\t    :str (string? v)\\\\n   183\\\\t    :int (and (integer? v) (not (neg? v)))\\\\n   184\\\\t    :bool (or (true? v) (false? v))))\\\\n   185\\\\t\\\\n   186\\\\t\\\\n   187\\\\t(defn- value-slots\\\\n   188\\\\t  [row]\\\\n   189\\\\t  (keep (fn [[pos kind]] (when (contains? #{:data :key} kind) (nth row pos)))\\\\n   190\\\\t        (slot-kinds (row-tag row))))\\\\n   191\\\\t\\\\n   192\\\\t\\\\n   193\\\\t(defn- first-defect\\\\n   194\\\\t  \\\\\\\"Run `check` over `addresses` in order; the first non-nil result.\\\\\\\"\\\\n   195\\\\t  [check addresses]\\\\n   196\\\\t  (some check addresses))\\\\n   197\\\\t\\\\n   198\\\\t\\\\n   199\\\\t(defn- cycle-defect\\\\n   200\\\\t  [index addresses]\\\\n   820\\\\t                (:halted? v) {:error {:kind :suspended}}\\\\n   821\\\\t\\\\n   822\\\\t                (>= steps max-steps) {:error {:kind :fuel-guard, :steps steps}}\\\\n   823\\\\t\\\\n   824\\\\t                (contains? suspending-tags tag) {:error {:kind :suspended}}\\\\n   825\\\\t\\\\n   826\\\\t                (contains? effect-tags tag) {:error {:kind :effect-guard, :tag tag}}\\\\n   827\\\\t\\\\n   828\\\\t                :else (recur (vm/step v) (inc steps)))))\\\\n   829\\\\t      (catch #?(:cljd Object :clj Throwable :cljs :default) e\\\\n   830\\\\t        {:error {:kind :body-error, :message (catch-message e)}}))))\\\\n   831\\\\t\\\\n   832\\\\t\\\\n   833\\\\t(defn- bind-arguments\\\\n   834\\\\t  \\\\\\\"Positional binding of operand packets to lambda parameters; `[a & rest]`\\\\n   835\\\\t   binds `rest` to the vector of remaining packets. `{:env m}` or\\\\n   836\\\\t   `{:expected n :got m}`.\\\\\\\"\\\\n   837\\\\t  [params args]\\\\n   838\\\\t  (let [[fixed [amp rest-sym]] (split-with #(not= '& %) params)\\\\n   839\\\\t        fixed (vec fixed)\\\\n   840\\\\t        n (count fixed)\\\\n   841\\\\t        m (count args)]\\\\n   842\\\\t    (if amp\\\\n   843\\\\t      (if (< m n)\\\\n   844\\\\t        {:expected n, :got m}\\\\n   845\\\\t        {:env (assoc (zipmap fixed args) rest-sym (vec (drop n args)))})\\\\n   846\\\\t      (if (not= m n)\\\\n   847\\\\t        {:expected n, :got m}\\\\n   848\\\\t        {:env (zipmap fixed args)}))))\\\\n   849\\\\t\\\\n   850\\\\t\\\\n   851\\\\t(defn- attempt-id\\\\n   852\\\\t  [ctx counter]\\\\n   853\\\\t  [(get-in ctx [:incarnation :yin.expander/token]) counter])\\\\n   854\\\\t\\\\n   855\\\\t\\\\n   856\\\\t(defn macro-entry\\\\n   857\\\\t  \\\\\\\"A macro-store value: a self-contained lambda tree `packet` with the AST\\\\n   858\\\\t   `contract` it was produced under. The store holds only these. The\\\\n   859\\\\t   transformer runner verifies the contract before it executes the packet\\\\n   860\\\\t   (Rule R: a persistent or supplied code packet is never relabelled), and\\\\n   861\\\\t   the expander stamps only what it harvests itself, under\\\\n   862\\\\t   `vm/ast-contract`.\\\\\\\"\\\\n   863\\\\t  [packet contract]\\\\n   864\\\\t  {:yin.macro/tree packet, :yin.macro/contract contract})\\\\n   865\\\\t\\\\n   866\\\\t\\\\n   867\\\\t(defn- verified-tree\\\\n   868\\\\t  \\\\\\\"The packet of a macro-store value after its contract is verified\\\\n   869\\\\t   against `vm/ast-contract`: `:contract-missing` for a bare packet or an\\\\n   870\\\\t   entry without one, `:contract-mismatch` for an old stamp.\\\\\\\"\\\\n   871\\\\t  [entry]\\\\n   872\\\\t  (vm/check-contract! vm/ast-contract\\\\n   873\\\\t                      (when (map? entry) (:yin.macro/contract entry)))\\\\n   874\\\\t  (:yin.macro/tree entry))\\\\n   875\\\\t\\\\n   876\\\\t\\\\n   877\\\\t(defn- check-store!\\\\n   878\\\\t  \\\\\\\"A supplied macro store: no reserved name is a macro (Rule R), and every\\\\n   879\\\\t   entry carries the current AST contract. Returns `store`.\\\\\\\"\\\\n   880\\\\t  [store]\\\\n   881\\\\t  (vm/check-bindings! :macro store)\\\\n   882\\\\t  (doseq [entry (vals store)] (verified-tree entry))\\\\n   883\\\\t  store)\\\\n   884\\\\t\\\\n   885\\\\t\\\\n   886\\\\t(defn- invoke*\\\\n   887\\\\t  \\\\\\\"Run one macro body. `entry` is a macro-store value (`macro-entry`),\\\\n   888\\\\t   verified before anything runs. `counter` is the attempt counter, which\\\\n   889\\\\t   gensyms read. `{:tree packet}` or `{:error e}`.\\\\\\\"\\\\n   890\\\\t  [entry operands ctx counter]\\\\n   891\\\\t  (let [macro-tree (verified-tree entry)\\\\n   892\\\\t        macro-root (first macro-tree)\\\\n   893\\\\t        params (nth (root-row macro-tree) 2)\\\\n   894\\\\t        {:keys [env expected got]} (bind-arguments params operands)]\\\\n   895\\\\t    (if-not env\\\\n   896\\\\t      {:error {:kind :arity, :macro macro-root, :expected expected, :got got}}\\\\n   897\\\\t      (let [n (volatile! 0)\\\\n   898\\\\t            token (get-in ctx [:incarnation :yin.expander/token])\\\\n   899\\\\t            gensym (fn [prefix]\\\\n   900\\\\t                     (let [i @n]\\\\n   901\\\\t                       (vswap! n inc)\\\\n   902\\\\t                       (symbol (str (if (symbol? prefix) (name prefix) prefix)\\\\n   903\\\\t                                    \\\\\\\"__\\\\\\\" token \\\\\\\"_\\\\\\\" counter \\\\\\\"_\\\\\\\" i))))\\\\n   904\\\\t            run (or (:eval ctx) bounded-row-evaluator)\\\\n   905\\\\t            {:keys [value error]} (run {:macro-tree macro-tree,\\\\n   906\\\\t                                        :contract (:yin.macro/contract entry),\\\\n   907\\\\t                                        :env env,\\\\n   908\\\\t                                        :prelude (prelude gensym),\\\\n   909\\\\t                                        :max-steps (get-in ctx [:guards :max-steps])})]\\\\n   910\\\\t        (if error\\\\n   911\\\\t          {:error (assoc error :macro macro-root)}\\\\n   912\\\\t          {:tree value})))))\\\\n   913\\\\t\\\\n   914\\\\t\\\\n   915\\\\t(def default-guards\\\\n   916\\\\t  {:max-depth 100,\\\\n   917\\\\t   :max-rows-per-expansion 10000,\\\\n   918\\\\t   :max-rows-per-batch nil,\\\\n   919\\\\t   :max-steps 100000})\\\\n   920\\\\t\\\\n   921\\\\t\\\\n   922\\\\t(defn invoke\\\\n   923\\\\t  \\\\\\\"Run `entry`, a macro-store value (`macro-entry`: a self-contained lambda\\\\n   924\\\\t   packet and its AST contract), on `operand-trees` and return its result\\\\n   925\\\\t   tree packet, unvalidated. The contract is verified first\\\\n   926\\\\t   (`:contract-missing`, `:contract-mismatch`, thrown). Gensyms use\\\\n   927\\\\t   `(:attempt ctx)` as the attempt counter. Throws `ex-info` carrying the\\\\n   928\\\\t   error data on an arity, guard, suspension, or body failure.\\\\\\\"\\\\n   929\\\\t  [entry operand-trees ctx]\\\\n   930\\\\t  (let [ctx (update ctx :guards #(merge default-guards %))\\\\n   931\\\\t        {:keys [tree error]} (invoke* entry (vec operand-trees) ctx\\\\n   932\\\\t                                      (:attempt ctx))]\\\\n   933\\\\t    (when error\\\\n   934\\\\t      (throw (ex-info \\\\\\\"Macro invocation failed\\\\\\\" error)))\\\\n   935\\\\t    tree))\\\\n   936\\\\t\\\\n   937\\\\t\\\\n   938\\\\t;; =============================================================================\\\\n   939\\\\t;; Tail marking and lowering (§6, §3.2 steps 6-7)\\\\n   940\\\\t;; =============================================================================\\\\n   941\\\\t\\\\n   942\\\\t(defn- retail\\\\n   943\\\\t  \\\\\\\"Recompute every `tail?` slot below `root`, in context `tail?`, over a\\\\n   944\\\\t   working index; `[index' root']`. Tail-ness is contextual, so one shared\\\\n   945\\\\t   row in two contexts becomes two rows.\\\\\\\"\\\\n   946\\\\t  [index root]\\\\n   947\\\\t  (let [memo (volatile! {})]\\\\n   948\\\\t    (letfn [(go\\\\n   949\\\\t              [index a tail?]\\\\n   950\\\\t              (if-let [hit (get @memo [a tail?])]\\\\n   951\\\\t                [index hit]\\\\n   952\\\\t                (let [row (get index a)\\\\n   953\\\\t                      tag (row-tag row)\\\\n   954\\\\t                      ctxs (case tag\\\\n   955\\\\t                             :lambda [true]\\\\n   956\\\\t                             :if [false tail? tail?]\\\\n   957\\\\t                             (repeat false))\\\\n   958\\\\t                      [index children']\\\\n   959\\\\t                      (reduce (fn [[index acc] [[_ c] t]]\\\\n   960\\\\t                                (let [[index c'] (go index c t)]\\\\n   961\\\\t                                  [index (conj acc c')]))\\\\n   962\\\\t                              [index []]\\\\n   963\\\\t                              (map vector (child-places row) ctxs))\\\\n   964\\\\t                      [index a'] (rebuild-row index row children')\\\\n   965\\\\t                      [index a'] (if (and (= :application tag)\\\\n   966\\\\t                                          (not= tail? (nth (get index a') 4)))\\\\n   967\\\\t                                   (intern-body index (assoc (subvec (get index a') 1) 3 tail?))\\\\n   968\\\\t                                   [index a'])]\\\\n   969\\\\t                  (vswap! memo assoc [a tail?] a')\\\\n   970\\\\t                  [index a'])))]\\\\n   971\\\\t      (go index root true))))\\\\n   972\\\\t\\\\n   973\\\\t\\\\n   974\\\\t(defn mark-tail\\\\n   975\\\\t  \\\\\\\"Recompute all observable tail slots of a tree packet, setting and\\\\n   976\\\\t   clearing marks (§6): the root is in tail context, an `:if` test is\\\\n   977\\\\t   non-tail and its branches inherit, application operators and operands are\\\\n   978\\\\t   non-tail, a lambda body is tail, and every other child is non-tail.\\\\\\\"\\\\n   979\\\\t  [packet]\\\\n   980\\\\t  (let [[index root] (retail (packet-index packet) (first packet))]\\\\n   981\\\\t    (packet-of index root)))\\\\n   982\\\\t\\\\n   983\\\\t\\\\n   984\\\\t(defn- lower-standins\\\\n   985\\\\t  \\\\\\\"Replace every stand-in by the canonical literal of its name.\\\\\\\"\\\\n   986\\\\t  [index root]\\\\n   987\\\\t  (let [memo (volatile! {})]\\\\n   988\\\\t    (letfn [(go\\\\n   989\\\\t              [index a]\\\\n   990\\\\t              (if-let [hit (get @memo a)]\\\\n   991\\\\t                [index hit]\\\\n   992\\\\t                (let [row (get index a)\\\\n   993\\\\t                      [index a']\\\\n   994\\\\t                      (if (= standin-tag (row-tag row))\\\\n   995\\\\t                        (intern-body index [:literal (nth row 2)])\\\\n   996\\\\t                        (let [[index children']\\\\n   997\\\\t                              (reduce (fn [[index acc] [_ c]]\\\\n   998\\\\t                                        (let [[index c'] (go index c)]\\\\n   999\\\\t                                          [index (conj acc c')]))\\\\n  1000\\\\t                                      [index []]\\\\n  1001\\\\t                                      (child-places row))]\\\\n  1002\\\\t                          (rebuild-row index row children')))]\\\\n  1003\\\\t                  (vswap! memo assoc a a')\\\\n  1004\\\\t                  [index a'])))]\\\\n  1005\\\\t      (go index root))))\\\\n  1006\\\\t\\\\n  1007\\\\t\\\\n  1008\\\\t;; =============================================================================\\\\n  1009\\\\t;; Harvest and post-harvest (§3.2 steps 2, 3, 5; §3.5)\\\\n  1010\\\\t;; =============================================================================\\\\n  1011\\\\t\\\\n  1012\\\\t(defn- harvest\\\\n  1013\\\\t  \\\\\\\"Initial harvest: iterate definitions in ordinal order; a declared one\\\\n  1014\\\\t   installs its lambda packet, a plain one removes the name. Last wins.\\\\n  1015\\\\t   A reserved name is never a definition key or a macro name (Rule R).\\\\\\\"\\\\n  1016\\\\t  [store index-of definitions]\\\\n  1017\\\\t  (reduce (fn [store {:keys [tree name value declared?]}]\\\\n  1018\\\\t            (when (vm/reserved-name? name)\\\\n  1019\\\\t              (vm/refuse-reserved! :definition-key name))\\\\n  1020\\\\t            (if declared?\\\\n  1021\\\\t              (assoc store name\\\\n  1022\\\\t                     (macro-entry (packet-of (index-of tree) value)\\\\n  1023\\\\t                                  vm/ast-contract))\\\\n  1024\\\\t              (dissoc store name)))\\\\n  1025\\\\t          store\\\\n  1026\\\\t          definitions))\\\\n  1027\\\\t\\\\n  1028\\\\t\\\\n  1029\\\\t(defn- post-harvest\\\\n  1030\\\\t  \\\\\\\"The next batch's store: start from the store before initial harvest and\\\\n  1031\\\\t   walk the final occurrence tree in declaration order — for an application\\\\n  1032\\\\t   whose operator is a lambda, operands left to right then the lambda body;\\\\n  1033\\\\t   otherwise child slots in grammar order. A plain definition removes its\\\\n  1034\\\\t   name; a stand-in whose `k` exists and whose catalogue name matches\\\\n  1035\\\\t   installs that entry; later occurrences win.\\\\\\\"\\\\n  1036\\\\t  [store index root catalogue]\\\\n  1037\\\\t  (letfn [(children\\\\n  1038\\\\t            [row]\\\\n  1039\\\\t            (let [places (child-places row)]\\\\n  1040\\\\t              (if (and (= :application (row-tag row))\\\\n  1041\\\\t                       (= :lambda (row-tag (get index (nth row 2)))))\\\\n  1042\\\\t                (concat (map second (rest places))\\\\n  1043\\\\t                        [(nth (get index (nth row 2)) 3)])\\\\n  1044\\\\t                (map second places))))\\\\n  1045\\\\t          (walk\\\\n  1046\\\\t            [store a]\\\\n  1047\\\\t            (let [row (get index a)\\\\n  1048\\\\t                  store (cond\\\\n  1049\\\\t                          (= standin-tag (row-tag row))\\\\n  1050\\\\t                          (let [[_ _ nm k] row\\\\n  1051\\\\t                                entry (get catalogue k)]\\\\n  1052\\\\t                            (if (and entry (= nm (:name entry)))\\\\n  1053\\\\t                              (assoc store nm\\\\n  1054\\\\t                                     (macro-entry (:macro-tree entry)\\\\n  1055\\\\t                                                  vm/ast-contract))\\\\n  1056\\\\t                              store))\\\\n  1057\\\\t\\\\n  1058\\\\t                          :else\\\\n  1059\\\\t                          (if-let [{:keys [name]} (definition-at index a)]\\\\n  1060\\\\t                            (dissoc store name)\\\\n  1061\\\\t                            store))]\\\\n  1062\\\\t              (reduce walk store (children row))))]\\\\n  1063\\\\t    (walk store root)))\\\\n  1064\\\\t\\\\n  1065\\\\t\\\\n  1066\\\\t;; =============================================================================\\\\n  1067\\\\t;; Events (§8)\\\\n  1068\\\\t;; =============================================================================\\\\n  1120\\\\t\\\\n  1121\\\\t\\\\n  1122\\\\t(defn- guard-batch-rows\\\\n  1123\\\\t  [st]\\\\n  1124\\\\t  (let [limit (get-in st [:ctx :guards :max-rows-per-batch])\\\\n  1125\\\\t        n (count (:index st))]\\\\n  1126\\\\t    (when (and limit (> n limit))\\\\n  1127\\\\t      {:kind :row-guard, :scope :batch, :rows n})))\\\\n  1128\\\\t\\\\n  1129\\\\t\\\\n  1130\\\\t(defn- merge-output\\\\n  1131\\\\t  \\\\\\\"Merge a validated result packet into the working index; an address whose\\\\n  1132\\\\t   working body differs is an `:address-conflict`.\\\\\\\"\\\\n  1133\\\\t  [st [_ rows]]\\\\n  1134\\\\t  (reduce (fn [st row]\\\\n  1135\\\\t            (let [prior (get (:index st) (first row))]\\\\n  1136\\\\t              (cond (nil? prior) (assoc-in st [:index (first row)] row)\\\\n  1137\\\\t                    (same-value? prior row) st\\\\n  1138\\\\t                    :else (reduced (assoc st ::conflict (first row))))))\\\\n  1139\\\\t          st\\\\n  1140\\\\t          rows))\\\\n  1141\\\\t\\\\n  1142\\\\t\\\\n  1143\\\\t(declare expand-node)\\\\n  1144\\\\t\\\\n  1145\\\\t\\\\n  1146\\\\t(defn- output-correspondence\\\\n  1147\\\\t  \\\\\\\"The per-occurrence correspondence of the expansion's output (ruling\\\\n  1148\\\\t   U1): for every `:application` occurrence of output packet `tree`, at\\\\n  1149\\\\t   its path relative to the output root, `:constructed` when the\\\\n  1150\\\\t   expansion's code built that node, or `[:retained origin]` when the\\\\n  1151\\\\t   node is input syntax retained with its own incoming origin. The\\\\n  1152\\\\t   classification is the construction origin function the prelude\\\\n  1153\\\\t   threaded through the packets the macro's code built — never a\\\\n  1154\\\\t   comparison of content addresses; the recorded expansion event\\\\n  1155\\\\t   retains the answer, and the site table derives each marked\\\\n  1156\\\\t   occurrence's origin from it.\\\\\\\"\\\\n  1157\\\\t  [tree ofn]\\\\n  1158\\\\t  (into {}\\\\n  1159\\\\t        (map (fn [path]\\\\n  1160\\\\t               (let [o (ofn path)]\\\\n  1161\\\\t                 [path (if (= pending-expansion-origin o)\\\\n  1162\\\\t                         :constructed\\\\n  1163\\\\t                         [:retained o])])))\\\\n  1164\\\\t        (sort-by pr-str\\\\n  1165\\\\t                 (map second\\\\n  1166\\\\t                      (vm/application-occurrences (packet->row-set tree))))))\\\\n  1167\\\\t\\\\n  1168\\\\t\\\\n  1169\\\\t(defn- expand-call\\\\n  1170\\\\t  \\\\\\\"One recognized call: allocate an attempt, begin its event before any\\\\n  1171\\\\t   guard or invocation, run the transformer on the operand packets, validate\\\\n  1172\\\\t   and merge the result, finish the event, and reconsider the result at the\\\\n  1173\\\\t   same occurrence with depth + 1.\\\\n  1174\\\\t\\\\n  1175\\\\t   Each operand packet enters the invocation carrying its occurrence\\\\n  1176\\\\t   origin function — the enclosing walk's origin at the operand's own\\\\n  1177\\\\t   absolute path — and the prelude threads it through every node the\\\\n  1178\\\\t   macro's code constructs (ruling U1): a spliced operand retains its\\\\n  1179\\\\t   own incoming origin, a built node carries the pending expansion\\\\n  1180\\\\t   origin. The output's per-occurrence correspondence is read from that\\\\n  1181\\\\t   construction history, retained in the event record, and the\\\\n  1182\\\\t   recursive walk answers origins from the record — never from\\\\n  1183\\\\t   comparing content addresses.\\\\\\\"\\\\n  1184\\\\t  [st address entry {:keys [path rel frame shadow depth origin-of]}]\\\\n  1185\\\\t  (let [[st counter] (allocate-attempt st)\\\\n  1186\\\\t        ctx (:ctx st)\\\\n  1187\\\\t        macro-root (first (:yin.macro/tree entry))\\\\n  1188\\\\t        begin (fn [output error correspondence]\\\\n  1189\\\\t                (event-row (attempt-id ctx counter)\\\\n  1190\\\\t                           (:source-batch st)\\\\n  1191\\\\t                           (when-not (:parent frame)\\\\n  1192\\\\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\\\\n  1193\\\\t                           (:parent frame)\\\\n  1194\\\\t                           (:root frame)\\\\n  1195\\\\t                           rel\\\\n  1196\\\\t                           macro-root\\\\n  1197\\\\t                           output\\\\n  1198\\\\t                           error\\\\n  1199\\\\t                           correspondence))\\\\n  1200\\\\t        failed (fn [st error]\\\\n  1201\\\\t                 (-> st (record-event (begin nil error nil)) (fail error)))\\\\n  1202\\\\t        guards (:guards ctx)]\\\\n  1203\\\\t    (if (>= depth (:max-depth guards))\\\\n  1204\\\\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\\\\n  1205\\\\t      (let [row (get (:index st) address)\\\\n  1206\\\\t            operands (map-indexed\\\\n  1207\\\\t                      (fn [i a]\\\\n  1208\\\\t                        (with-origin-of (packet-of (:index st) a)\\\\n  1209\\\\t                          (fn [rel]\\\\n  1210\\\\t                            (origin-of (into (conj path [3 i]) rel)))))\\\\n  1211\\\\t                      (nth row 3))\\\\n  1212\\\\t            {:keys [tree error]} (invoke* entry operands ctx counter)\\\\n  1213\\\\t            invalid (fn [reason]\\\\n  1214\\\\t                      {:kind :invalid-output, :macro macro-root, :path path,\\\\n  1215\\\\t                       :reason reason})]\\\\n  1216\\\\t        (if error\\\\n  1217\\\\t          [(failed st error) address]\\\\n  1218\\\\t          (if-let [e (valid-tree? tree {:working? true})]\\\\n  1219\\\\t            [(failed st (invalid (:reason e))) address]\\\\n  1220\\\\t            (let [n (count (set (map first (second tree))))]\\\\n  1221\\\\t              (if (> n (:max-rows-per-expansion guards))\\\\n  1222\\\\t                [(failed st {:kind :row-guard, :scope :expansion, :rows n}) address]\\\\n  1223\\\\t                (let [st' (merge-output st tree)]\\\\n  1224\\\\t                  (if (::conflict st')\\\\n  1225\\\\t                    [(failed st (invalid :address-conflict)) address]\\\\n  1226\\\\t                    (if-let [e (guard-batch-rows st')]\\\\n  1227\\\\t                      [(failed st' e) address]\\\\n  1228\\\\t                      (let [;; the output's construction origin function\\\\n  1229\\\\t                            ;; (ruling U1); an output the prelude did not\\\\n  1230\\\\t                            ;; thread — unreachable through the sanctioned\\\\n  1231\\\\t                            ;; constructors — classifies as constructed\\\\n  1232\\\\t                            ofn (or (origin-of-fn tree)\\\\n  1233\\\\t                                    (fn [_] pending-expansion-origin))\\\\n  1234\\\\t                            corr (output-correspondence tree ofn)\\\\n  1235\\\\t                            out (first tree)\\\\n  1236\\\\t                            ev (begin out nil corr)\\\\n  1237\\\\t                            st' (-> st'\\\\n  1238\\\\t                                    (record-event ev)\\\\n  1239\\\\t                                    (update :produced\\\\n  1240\\\\t                                            (fn [p]\\\\n  1241\\\\t                                              (if (some #(= out (first %)) p)\\\\n  1242\\\\t                                                p\\\\n  1243\\\\t                                                (conj p (packet-of (:index st') out))))))]\\\\n  1244\\\\t                        (expand-node st' out\\\\n  1245\\\\t                                     {:path path,\\\\n  1246\\\\t                                      :rel [],\\\\n  1247\\\\t                                      :frame {:parent (first ev), :root out},\\\\n  1248\\\\t                                      :shadow shadow,\\\\n  1249\\\\t                                      :depth (inc depth),\\\\n  1250\\\\t                                      ;; per-occurrence origins read from\\\\n  1251\\\\t                                      ;; the RETAINED correspondence (§2.1,\\\\n  1252\\\\t                                      ;; §8): a `[:retained origin]` names\\\\n  1253\\\\t                                      ;; the incoming origin the syntax\\\\n  1254\\\\t                                      ;; already carried, a `:constructed`\\\\n  1255\\\\t                                      ;; occurrence names the recorded\\\\n  1256\\\\t                                      ;; expansion event — the record the\\\\n  1257\\\\t                                      ;; correspondence is retained in\\\\n  1258\\\\t                                      :origin-of\\\\n  1259\\\\t                                      (fn [abs-path]\\\\n  1260\\\\t                                        (let [o (get corr (subvec abs-path (count path)))]\\\\n  1261\\\\t                                          (if (and (vector? o) (= :retained (first o)))\\\\n  1262\\\\t                                            (second o)\\\\n  1263\\\\t                                            [:expansion (first ev)])))})))))))))))))\\\\n  1264\\\\t\\\\n  1265\\\\t\\\\n  1266\\\\t(defn- expand-children\\\\n  1267\\\\t  \\\\\\\"Expand `row`'s children in order `places` under per-child shadows;\\\\n  1268\\\\t   `[st address']`, rebuilding the row when any child changed.\\\\\\\"\\\\n  1269\\\\t  [st row places shadow-of {:keys [path rel] :as loc}]\\\\n  1270\\\\t  (let [[st children']\\\\n  1271\\\\t        (reduce (fn [[st acc] [coord c]]\\\\n  1272\\\\t                  (if (:error st)\\\\n  1273\\\\t                    (reduced [st acc])\\\\n  1274\\\\t                    (let [[st c'] (expand-node st c\\\\n  1275\\\\t                                               (assoc loc\\\\n  1276\\\\t                                                      :path (conj path coord)\\\\n  1277\\\\t                                                      :rel (conj rel coord)\\\\n  1278\\\\t                                                      :shadow (shadow-of coord)))]\\\\n  1279\\\\t                      [st (conj acc c')])))\\\\n  1280\\\\t                [st []]\\\\n  1281\\\\t                places)]\\\\n  1282\\\\t    (if (:error st)\\\\n  1283\\\\t      [st (first row)]\\\\n  1284\\\\t      (let [[index a'] (rebuild-row (:index st) row places children')]\\\\n  1285\\\\t        [(assoc st :index index) a']))))\\\\n  1286\\\\t\\\\n  1287\\\\t\\\\n  1288\\\\t(defn- expand-node\\\\n  1289\\\\t  \\\\\\\"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\\\\n  1290\\\\t   `rel` path within the current `frame` (`{:root r :parent event|nil\\\\n  1291\\\\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\\\\n  1292\\\\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\\\\n  1293\\\\t   answers, for an ABSOLUTE occurrence path, the origin of the\\\\n  1294\\\\t   admission or generation event that produced the syntax there.\\\\n  1295\\\\t   Every application\\\\n  1296\\\\t   occurrence is recorded under its absolute path as it is visited, so\\\\n  1297\\\\t   the finalizer can name each occurrence's real origin; an occurrence\\\\n  1298\\\\t   replaced by an expansion is re-recorded by the expansion's own walk,\\\\n  1299\\\\t   and a stale entry for a path the finished tree no longer applies at\\\\n  1300\\\\t   is simply never read. Returns `[st address']`; a failure sets\\\\n  1301\\\\t   `(:error st)`.\\\\\\\"\\\\n  1302\\\\t  [st address {:keys [shadow] :as loc}]\\\\n  1303\\\\t  (if (:error st)\\\\n  1304\\\\t    [st address]\\\\n  1305\\\\t    (let [row (get (:index st) address)\\\\n  1306\\\\t          tag (row-tag row)]\\\\n  1307\\\\t      (cond\\\\n  1308\\\\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\\\\n  1309\\\\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\\\\n  1310\\\\t\\\\n  1311\\\\t        (= :application tag)\\\\n  1312\\\\t        (let [st (update-in st [:call-site-origins]\\\\n  1313\\\\t                            assoc (:path loc) ((:origin-of loc) (:path loc)))\\\\n  1314\\\\t              op (nth row 2)\\\\n  1315\\\\t              [st op'] (expand-node st op (-> loc\\\\n  1316\\\\t                                              (update :path conj 2)\\\\n  1317\\\\t                                              (update :rel conj 2)))]\\\\n  1318\\\\t          (if (:error st)\\\\n  1319\\\\t            [st address]\\\\n  1320\\\\t            (let [[index app'] (if (= op op')\\\\n  1321\\\\t                                 [(:index st) address]\\\\n  1322\\\\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\\\\n  1323\\\\t                  st (assoc st :index index)\\\\n  1324\\\\t                  row' (get index app')]\\\\n  1325\\\\t              (if (macro-of st op' shadow)\\\\n  1326\\\\t                ;; recognition is not expansion: depth is unchanged\\\\n  1327\\\\t                (expand-node st app' loc)\\\\n  1328\\\\t                (expand-children st row' (rest (child-places row'))\\\\n  1329\\\\t                  