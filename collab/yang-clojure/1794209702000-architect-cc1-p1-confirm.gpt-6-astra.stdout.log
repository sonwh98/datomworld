              (:call-site-origins st) origin))]\\n  1506\\t                (if-let [e (valid-tree? tree)]\\n  1507\\t                  (throw (ex-info \\\"Expander produced a non-canonical tree\\\" e))\\n  1508\\t                  (finish (assoc st :tree tree :next-store next-store\\n  1509\\t                                 :frontend-metadata metadata\\n  1510\\t                                  :call-site-origin (when metadata origin))))))))))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1795455000000-reviewer-cc1-fix5.codex.stdout.log:29:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yin/vm/macro.cljc | sed -n '210,315p;1085,1145p;1180,1388p;1620,1660p'\\\"\",\"aggregated_output\":\"   210\\t                                      [nil done]\\n   211\\t                                      (child-places (get index a)))]\\n   212\\t                          [err (conj done' a)])))]\\n   213\\t    (loop [as addresses\\n   214\\t           done #{}]\\n   215\\t      (when-let [a (first as)]\\n   216\\t        (let [[err done'] (visit a #{} [] done)]\\n   217\\t          (or err (recur (rest as) done')))))))\\n   218\\t\\n   219\\t\\n   220\\t(defn valid-tree?\\n   221\\t  \\\"Validate a tree packet `[root rows]` (§1.2, §7.1). Returns nil when the\\n   222\\t   packet is a closed, self-contained, acyclic tree of well-formed rows whose\\n   223\\t   addresses match their bodies, else the first error as\\n   224\\t   `{:kind :malformed-input :reason r :address a ...}`.\\n   225\\t\\n   226\\t   Rules run in this order, each over addresses in canonical byte order and\\n   227\\t   slots in grammar order: packet and row shape (`:packet-shape`,\\n   228\\t   `:row-shape`), `:unknown-tag`, `:row-shape` (arity and slot kinds),\\n   229\\t   `:host-value`, `:marker-in-payload`, `:address-mismatch` (after the plain\\n   230\\t   check, so no host value is ever hash