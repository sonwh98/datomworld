n   491\t  \"The ordered definition records of a batch, in harvest order:\n   492\t   `{:ordinal h :tree j :path p :address a :name sym :value v :declared? b}`.\n   493\t   Throws `ex-info` carrying the admission error when the batch is invalid.\"\n   494\t  [batch]\n   495\t  (let [{:keys [admitted error]} (admit batch)]\n   496\t    (when error\n   497\t      (throw (ex-info \"Invalid macro input batch\" error)))\n   498\t    (:definitions admitted)))\n   499\t\n   500\t\n   501\t;; =============================================================================\n   502\t;; Workspace: interning and immutable path rebuilding (§3.3)\n   503\t;; =============================================================================\n   504\t\n   505\t(defn- intern-body\n   506\t  \"Intern `body` into the working index: `[index' address]`. An address\n   507\t   already holding a different body is a defect of the encoder, not input.\"\n   508\t  [index body]\n   509\t  (let [row (intern-row body)\n   510\t        a (first row)\n   511\t        prior (get index a)]\n   512\t    (when (and prior (not (same-value? prior row)))\n   513\t      (throw (ex-info \"Working index address conflict\" {:address a})))\n   514\t    [(if prior index (assoc index a row)) a]))\n   515\t\n   748\t   tracking metadata first (P1-2), before hashing and validation.\n   749\t   Missing child provenance never proves construction (P1-1): the\n   750\t   result's origin function answers the missing marker below an\n   751\t   unaccounted child and the expander refuses such an output.\"\n   752\t  ([body packets] (construct body packets nil))\n   753\t  ([body packets lineage]\n   754\t   (let [recover (fn [child] (lineage-origin-for lineage child))]\n   755\t     (let [tag (first body)\n   756\t           slots (get working-grammar tag)\n   757\t           body (if (and slots (= (count slots) (count (rest body))))\n   758\t                  (into [tag]\n   759\t                        (map (fn [[_ kind] v]\