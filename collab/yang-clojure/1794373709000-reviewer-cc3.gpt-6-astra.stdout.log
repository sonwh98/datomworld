(get slots r)) structural))\n   214\t                      op (first t)\n   215\t                      fields (get rcode/opcode-table op)]\n   216\t                  (into [op]\n   217\t                        (map-indexed (fn [i [k kind]]\n   218\t                                       (if (= k :yin.debruijn.register/live) []\n   219\t                                           (let [x (nth t (inc i))]\n   220\t                                             (case kind\n   221\t                                               :reg (physical x)\n   222\t                                               :regs (mapv physical x)\n   223\t                                               x)))) fields))))\n   224\t              (range (count rv)) rv)\n   225\t        image {:bodies (mapv #(select-keys % [:locals :registers :start :end]) allocations)\n   226\t               :instructions instructions}\n   227\t        image (reduce (fn [image bi]\n   228\t                        (reduce (fn [image [pc live]]\n   229\t                                  (assoc-in image [:instructions pc\n   230\t                                                   (rcode/live-slot-index (first (nth instructions pc)))] live))\n   231\t                                image (rcode/body-liveness image bi)))\n   232\t                      image (range (count bodies)))]\n   233\t    (if (some? call-provenance)\n   234\t      (let [keys-by-pc (call-key-map v call-provenance)]\n   235\t        (assoc image :call-provenance\n   236\t               (mapv (fn [[pc [o r p]]] [segment-address pc o r p])\n   237\t                     (sort-by first keys-by-pc))))\n   238\t      image))))\n","exit_code":0,"status":"completed"}}
