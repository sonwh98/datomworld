{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic/derive.cljc | sed -n '1,280p'\"","aggregated_output":"     1\t(ns yin.vm.semantic.derive\n     2\t  \"Pure native derivations from the admitted semantic register vector A.\"\n     3\t  (:refer-clojure :exclude [resolve])\n     4\t  (:require [yin.vm.semantic.code :as code]\n     5\t            [yin.vm.debruijn :as db]\n     6\t            [yin.vm.semantic.analysis :as analysis]\n     7\t            [yin.vm.debruijn-register-code :as rcode]))\n     8\t\n     9\t\n    10\t(defn- chains\n    11\t  [v bodies]\n    12\t  (letfn [(chain\n    13\t            [i]\n    14\t            (if-let [owner (:owner (nth bodies i))]\n    15\t              (into [(nth (nth v owner) 2)]\n    16\t                    (chain (code/body-index bodies owner)))\n    17\t              []))]\n    18\t    (mapv chain (range (count bodies)))))\n    19\t\n    20\t\n    21\t(defn resolve\n    22\t  \"Rewrite only variables and closure binders. The result is an unhashed\n    23\t   stage value; pcs and virtual registers are preserved.\"\n    24\t  [v]\n    25\t  (let [bodies (code/parse v)\n    26\t        frames (chains v bodies)\n    27\t        names (volatile! {})]\n    28\t    {:vector\n    29\t     (mapv (fn [pc]\n    30\t             (let [[op rd x y :as t] (nth v pc)]\n    31\t               (case op\n    32\t                 :var (let [{:keys [bound free]}\n    33\t                            (db/resolve-name (nth frames (code/body-index bodies pc)) x)]\n    34\t                        (if bound\n    35\t                          (do (vswap! names assoc pc x)\n    36\t                              (into [:load-bound rd] bound))\n    37\t                          [:load-free rd free]))\n    38\t                 :closure [:closure rd (count x) y]\n    39\t                 t)))\n    40\t           (range (count v)))\n    41\t     :bodies bodies\n    42\t     :names @names}))\n    43\t\n    44\t\n    45\t(defn addresses\n    46\t  \"Lexical references in pc order, from A, a resolved vector or a native\n    47\t   instruction vector (register or stack). Returns a vector, no identity.\"\n    48\t  [v]\n    49\t  (let [v (if (map? v) (or (:vector v) (:instructions v)) v)\n    50\t        v (if (some #(= :var (first %)) v) (:vector (resolve v)) v)]\n    51\t    (into []\n    52\t          (keep (fn [t]\n    53\t                  (case (first t)\n    54\t                    :load-bound (into [:bound] (subvec t (- (count t) 2)))\n    55\t                    :load-free [:free (peek t)]\n    56\t                    nil)))\n    57\t          v)))\n    58\t\n    59\t\n    60\t(defn- call-key-map\n    61\t  \"The `{semantic-pc [origin root path]}` map a `:call-provenance`\n    62\t   relation (`linearize/project-rows`' rows) names over vector `v` —\n    63\t   cc3 item 2. A row naming a pc that holds no `:call` in `v` refuses:\n    64\t   native provenance is reconstructed through each format's own PC\n    65\t   derivation, never assumed from PC equality across formats.\"\n    66\t  [v call-provenance]\n    67\t  (reduce (fn [m row]\n    68\t            (when-not (and (vector? row) (= 4 (count row))\n    69\t                           (integer? (nth row 0))\n    70\t                           (<= 0 (nth row 0)) (< (nth row 0) (count v))\n    71\t                           (= :call (first (nth v (nth row 0)))))\n    72\t              (throw (ex-info \"Call provenance names a non-call semantic pc\"\n    73\t                              {:rule :call-provenance, :row row})))\n    74\t            (assoc m (nth row 0) (subvec row 1)))\n    75\t          {}\n    76\t          call-provenance))\n    77\t\n    78\t\n    79\t(defn stack-image\n    80\t  \"Stackify A's parsed expressions, placing closure bodies in FIFO order.\n    81\t   Labels and diagnostics are derived solely from A.\n    82\t\n    83\t   The two-argument form reconstructs call provenance through the\n    84\t   stack derivation's own PC mapping: `opts`' `:call-provenance` is\n    85\t   the semantic vector's `[[pc origin root path] …]` and its\n    86\t   `:segment-address` is the segment coordinate the caller supplies\n    87\t   for this image. The result then carries `:call-provenance`\n    88\t   `[[segment-address pc origin root path] …]` for its `:call` pcs\n    89\t   and a `{:kind :call …}` side-table diagnostic at each (the existing\n    90\t   `:closure`/`:var` diagnostic shapes are undisturbed). The image\n    91\t   itself is identical with or without provenance.\"\n    92\t  ([v] (stack-image v nil))\n    93\t  ([v {:keys [segment-address call-provenance]}]\n    94\t   (let [{rv :vector bodies :bodies} (resolve v)\n    95\t        by-start (into {} (map (juxt :start identity)) bodies)\n    96\t        keys-by-pc (when (some? call-provenance)\n    97\t                     (call-key-map v call-provenance))\n    98\t        call-rows (volatile! [])\n    99\t        image (volatile! [])\n   100\t        side (volatile! {})\n   101\t        labels (volatile! {})\n   102\t        queue (volatile! [])\n   103\t        counter (volatile! 0)\n   104\t        label! (fn [] (vswap! counter inc))\n   105\t        mark! (fn [l] (vswap! labels assoc l (count @image)))\n   106\t        emit! (fn [t] (vswap! image conj t))]\n   107\t    (letfn [(walk\n   108\t              [node]\n   109\t              (let [pc (:pc node)\n   110\t                    [op _ x y z] (nth rv pc)\n   111\t                    children (:children node)\n   112\t                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n   113\t                (case (:op node)\n   114\t                  :if (let [[c th el] children\n   115\t                            else (label!) end (label!)]\n   116\t                        (walk c) (emit! [:branch-false else])\n   117\t                        (walk th) (emit! [:jump end])\n   118\t                        (mark! else) (walk el) (mark! end))\n   119\t                  :closure (let [l (label!)]\n   120\t                             (vswap! queue conj [l (get by-start y)])\n   121\t                             (diagnostic! {:kind :closure :params (nth (nth v pc) 2) :source pc})\n   122\t                             (emit! [:closure x l]))\n   123\t                  :var (do (diagnostic! {:kind :var :source pc})\n   124\t                           (emit! (if (= op :load-bound) [:load-bound x y] [:load-free x])))\n   125\t                  :call (do (doseq [child children] (walk child) (emit! [:push]))\n   126\t                            (when-let [[o r p] (get keys-by-pc pc)]\n   127\t                              (diagnostic! {:kind :call :source pc\n   128\t                                            :origin o :root r :path p})\n   129\t                              (vswap! call-rows conj\n   130\t                                      [segment-address (count @image) o r p]))\n   131\t                            (emit! [:call (count y) z]))\n   132\t                  :ffi-call (do (doseq [child children] (walk child) (emit! [:push]))\n   133\t                                (emit! [:ffi-call x (count y)]))\n   134\t                  :stream-put (do (walk (nth children 0)) (emit! [:push])\n   135\t                                  (walk (nth children 1)) (emit! [:stream-put]))\n   136\t                  (:define :stream-cursor :stream-next :stream-close :resume)\n   137\t                  (do (walk (first children))\n   138\t                      (emit! (case op\n   139\t                               :define [:define x]\n   140\t                               :resume [:resume (nth (nth rv pc) 1)]\n   141\t                               [op])))\n   142\t                  (:const :gensym :store-get :stream-make) (emit! [op x])\n   143\t                  :store-put (emit! [op x y])\n   144\t                  (:current-continuation :park) (emit! [op]))))\n   145\t            (body!\n   146\t              [{:keys [expr owner]}]\n   147\t              (walk expr)\n   148\t              (emit! [(if (nil? owner) :halt :return)]))]\n   149\t      (body! (first bodies))\n   150\t      (loop [i 0]\n   151\t        (when-let [[l body] (get @queue i)]\n   152\t          (mark! l) (body! body) (recur (inc i))))\n   153\t      (cond-> {:image (mapv (fn [t]\n   154\t                              (case (first t)\n   155\t                                (:jump :branch-false) (assoc t 1 (get @labels (nth t 1)))\n   156\t                                :closure (assoc t 2 (get @labels (nth t 2)))\n   157\t                                t)) @image)\n   158\t               :side-table @side}\n   159\t        (some? call-provenance) (assoc :call-provenance @call-rows))))))\n   160\t\n   161\t\n   162\t(defn- allocation\n   163\t  [v a {:keys [start end owner]}]\n   164\t  (let [locals (if (nil? owner) 0 (count (nth (nth v owner) 2)))\n   165\t        defined (into #{} (keep #(code/rd (nth v %))) (range start end))\n   166\t        points (reduce (fn [m pc]\n   167\t                         (reduce (fn [m r] (update m r (fnil conj []) pc)) m\n   168\t                                 (into (analysis/live a pc) (analysis/defs v pc))))\n   169\t                       {} (range start end))\n   170\t        intervals (mapv (fn [r] [r (apply min (get points r)) (apply max (get points r))])\n   171\t                        (sort defined))\n   172\t        starts-by-pc (group-by second intervals)\n   173\t        missing (seq (remove defined (mapcat #(code/uses (nth v %)) (range start end))))]\n   174\t    (loop [pc start active [] free (sorted-set) next-slot 0 slots {}]\n   175\t      (if (= pc end)\n   176\t        {:locals locals :registers (+ locals next-slot (if missing 1 0))\n   177\t         :start start :end (dec end)\n   178\t         :slots slots :structural (+ locals next-slot)}\n   179\t        (let [expired (sort-by (juxt #(nth % 2) first)