(:type node))\n  2035\t             (= :variable (:type (:operator node)))\n  2036\t             (= 'data/nth (:name (:operator node)))\n  2037\t             (= 2 (count (:operands node)))\n  2038\t             (let [one (second (:operands node))]\n  2039\t               (and (map? one) (= :literal (:type one)) (= 1 (:value one))))\n  2040\t             (let [call (first (:operands node))]\n  2041\t               (and (map? call) (= :application (:type call))\n  2042\t                    (= :variable (:type (:operator call)))\n  2043\t                    (= 'dsg__intra_call (:name (:operator call)))\n  2044\t                    (let [args (get-in call [:operands 1])]\n  2045\t                      (and (map? args) (= :application (:type args))\n  2046\t                           (= :variable (:type (:operator args)))\n  2047\t                           (= 'conj (:name (:operator args))))))))\n  2048\t    (get-in node [:operands 0 :operands 1 :operands 2])))\n  2049\t\n  2050\t\n  2051\t(defn- kernel-site-arguments\n  2052\t  \"The argument expression nodes of one compiled call site: the operand\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-KWUSpSIC' (errno=Operation not permitted)\n2026-11-11 12:12:08.902 xcodebuild[67944:122007629]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-11 12:12:09.068 xcodebuild[67944:122007624] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-7vQ94kD0' (errno=Operation not permitted)\n2026-11-11 12:12:09.757 xcodebuild[67948:122007651]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-11 12:12:09