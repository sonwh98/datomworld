ll provenance through the\n    84\t   stack derivation's own PC mapping: `opts`' `:call-provenance` is\n    85\t   the semantic vector's `[[pc origin root path] …]` and its\n    86\t   `:segment-address` is the segment coordinate the caller supplies\n    87\t   for this image. The result then carries `:call-provenance`\n    88\t   `[[segment-address pc origin root path] …]` for its `:call` pcs\n    89\t   and a `{:kind :call …}` side-table diagnostic at each (the existing\n    90\t   `:closure`/`:var` diagnostic shapes are undisturbed). The image\n    91\t   itself is identical with or without provenance.\"\n    92\t  ([v] (stack-image v nil))\n    93\t  ([v {:keys [segment-address call-provenance]}]\n    94\t   (let [{rv :vector bodies :bodies} (resolve v)\n    95\t        by-start (into {} (map (juxt :start identity)) bodies)\n    96\t        keys-by-pc (when (some? call-provenance)\n    97\t                     (call-key-map v call-provenance))\n    98\t        call-rows (volatile! [])\n    99\t        image (volatile! [])\n   100\t        side (volatile! {})\n   101\t        labels (volatile! {})\n   102\t        queue (volatile! [])\n   103\t        counter (volatile! 0)\n   104\t        label! (fn [] (vswap! counter inc))\n   105\t        mark! (fn [l] (vswap! labels assoc l (count @image)))\n   106\t        emit! (fn [t] (vswap! image conj t))]\n   107\t    (letfn [(walk\n   108\t              [node]\n   109\t              (let [pc (:pc node)\n   110\t                    [op _ x y z] (nth rv pc)\n   111\t                    children (:children node)\n   112\t                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n   113\t                (case (:op node)\n   114\t                  :if (let [[c th el] children\n   115\t                            else (label!) end (label!)]\n   116\t                        (walk c) (emit! [:branch-false else])\n   117\t                        (walk th) (emit! [:jump end])\n   118\t                        (mark! else) (walk el) (mark! end))\n   119\t                  :closure (let [l (label!)]\n   120\t                             (vswap! queue conj [l (get by-start y)])\n   121\t                             (diagnostic! {:kind :closure :params (nth (nth v pc) 2) :source pc})\n   122\t                             (emit! [:closure x l]))\n   123\t                  :var (do (diagnostic! {:kind :var :source pc})\n   124\t                           (emit! (if (= op :load-bound) [:load-bound x y] [:load-free x])))\n   125\t                  :call (do (doseq [child children] (walk child) (emit! [:push]))\n   126\t                            (when-let [[o r p] (get keys-by-pc pc)]\n   127\t                              (diagnostic! {:kind :call :source pc\n   128\t                                            :origin o :root r :path p})\n   129\t                              (vswap! call-rows conj\n   130\t                                      [segment-address (count @image) o r p]))\n   131\t                            (emit! [:call (count y) z]))\n   132\t                  :ffi-call (do (doseq [child children] (walk child) (emit! [:push]))\n   133\t                                (emit! [:ffi-call x (count y)]))\n   134\t                  :stream-put (do (walk (nth children 0)) (emit! [:push])\n   135\t                                  (walk (nth children 1)) (emit! [:stream-put]))\n   136\t                  (:define :stream-cursor :stream-next :stream-close :resume)\n   137\t                  (do (walk (first children))\n   138\t                      (emit! (case op\n   139\t                               :define [:define x]\n   140\t                               :resume [:resume (nth (nth rv pc) 1)]\n   141\t                               [op])))\n   142\t                  (:const :gensym :store-get :stream-make) (emit! [op x])\n   143\t                  :store-put (emit! [op x y])\n   144\t                  (:current-continuation :park) (emit! [op]))))\n   145\t            (body!\n   146\t              [{:keys [expr owner]}]\n   147\t              (walk expr)\n   148\t              (emit! [(if (nil? owner) :halt :return)]))]\n   149\t      (body! (first bodies))\n   150\t      (loop [i 0]\n   151\t        (when-let [[l body] (get @queue i)]\n   152\t          (mark! l) (body! body) (recur (inc i))))\n   153\t      (cond-> {:image (mapv (fn [t]\n   154\t                              (case (first t)\n   155\t                                (:jump :branch-false) (assoc t 1 (get @labels (nth t 1)))\n   156\t                                :closure (assoc t 2 (get @labels (nth t 2)))\n   157\t                                t)) @image)\n   158\t               :side-table @side}\n   159\t        (some? call-provenance) (assoc :call-provenance @call-rows))))))\n   160\t\n   161\t\n   162\t(defn- allocation\n   163\t  [v a {:keys [start end owner]}]\n   164\t  (let [locals (if (nil? owner) 0 (count (nth (nth v owner) 2)))\n   165\t        defined (into #{} (keep #(code/rd (nth v %))) (range start end))\n   166\t        points (reduce (fn [m pc]\n   167\t                         (reduce (fn [m r] (update m r (fnil conj []) pc)) m\n   168\t                                 (into (analysis/live a pc) (analysis/defs v pc))))\n   169\t                       {} (range start end))\n   170\t        intervals (mapv (fn [r] [r (apply min (get points r)) (apply max (get points r))])\n   171\t                        (sort defined))\n   172\t        starts-by-pc (group-by second intervals)\n   173\t        missing (seq (remove defined (mapcat #(code/uses (nth v %)) (range start end))))]\n   174\t    (loop [pc start active [] free (sorted-set) next-slot 0 slots {}]\n   175\t      (if (= pc end)\n   176\t        {:locals locals :registers (+ locals next-slot (if missing 1 0))\n   177\t         :start start :end (dec end)\n   178\t         :slots slots :structural (+ locals next-slot)}\n   179\t        (let [expired (sort-by (juxt #(nth % 2) first)\n   180\t                               (filter #(< (nth % 2) pc) active))\n   181\t              free (into free (map #(get slots (first %))) expired)\n   182\t              active (filterv #(>= (nth % 2) pc) active)\n   183\t              starts (get starts-by-pc pc [])\n   184\t              [free next-slot slots]\n   185\t              (reduce (fn [[free next-slot slots] [r]]\n   186\t                        (let [i (if (seq free) (first free) next-slot)]\n   187\t                          [(disj free i) (if (seq free) next-slot (inc next-slot))\n   188\t                           (assoc slots r i)]))\n   189\t                      [free next-slot slots] starts)]\n   190\t          (recur (inc pc) (into active starts) free next-slot slots))))))\n   191\t\n   192\t\n   193\t(defn register-image\n   194\t  \"Allocate temporaries by linear scan over A's live points; preserve A's\n   195\t   layout and fill saved windows using the register format's liveness.\n   196\t\n   197\t   The two-argument form reconstructs call provenance: layout is\n   198\t   preserved, so a semantic `:call` pc IS the register pc — the result\n   199\t   then carries `:call-provenance`\n   200\t   `[[segment-address pc origin root path] …]` under `opts`'\n   201\t   caller-supplied `:segment-address`, mapped from `opts`'\n   202\t   `:call-provenance` (the semantic vector's rows). The image itself\n   203\t   is identical with or without provenance.\"\n   204\t  ([v] (register-image v nil))\n   205\t  ([v {:keys [segment-address call-provenance]}]\n   206\t   (let [{rv :vector bodies :bodies} (resolve v)\n   207\t        a (analysis/analyze v)\n   208\t        allocations (mapv #(allocation v a %) bodies)\n   209\t        instructions\n   210\t        (mapv (fn [pc t]\n   211\t                (let [{:keys [slots locals structural]}\n   212\t                      (nth allocations (code/body-index bodies pc))\n   213\t                      physical (fn [r] (if (contains? slots r) (+ locals (get slots r)) structural))\n   214\t                      op (first t)\n   215\t                      fields (get rcode/opcode-table op)]\n   216\t                  (into [op]\n   217\t                        (map-indexed (fn [i [k kind]]\n   218\t                                       (if (= k :yin.debruijn.register/live) []\n   219\t                                           (let [x (nth t (inc i))]\n   220\t                                             (case kind\n   221\t                                               :reg (physical x)\n   222\t                                               :regs (mapv physical x)\n   223\t                                               x)))) fields))))\n   224\t              (range (count rv)) rv)\n   225\t        image {:bodies (mapv #(select-keys % [:locals :registers :start :end]) allocations)\n   226\t               :instructions instructions}\n   227\t        image (reduce (fn [image bi]\n   228\t                        (reduce (fn [image [pc live]]\n   229\t                                  (assoc-in image [:instructions pc\n   230\t                                                   (rcode/live-slot-index (first (nth instructions pc)))] live))\n   231\t                                image (rcode/body-liveness image bi)))\n   232\t                      image (range (count bodies)))]\n   233\t    (if (some? call-provenance)\n   234\t      (let [keys-by-pc (call-key-map v call-provenance)]\n   235\t        (assoc image :call-provenance\n   236\t               (mapv (fn [[pc [o r p]]] [segment-address pc o r p])\n   237\t                     (sort-by first keys-by-pc))))\n   238\t      image))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic/linearize.cljc | sed -n '1,380p'\"","aggregated_output":"     1\t(ns yin.vm.semantic.linearize\n     2\t  \"`project`: the Universal AST → the register-shaped canonical vector\n     3\t   (`docs/design/yin.vm.semantic.md` §3.3).\n     4\t\n     5\t   One flattening, two lanes: the datom\n     6\t   lane reads `:yin/*` datoms through an entity index, the row lane reads\n     7\t   code-as-tuples rows (§5.1) by the grammar table's positions. Both hand\n     8\t   the same walk a node reader, so the order is shared by construction:\n     9\t   operator, then operands left to right; a conditional's test,\n    10\t   consequent, alternate; occurrences expanded positionally; saturated\n    11\t   defaults; lambda bodies out of line after the main sequence, in one\n    12\t   FIFO queue that bodies discovered inside bodies join at the back.\n    13\t\n    14\t   Registers are body-local and minted pre-order: a destination is minted\n    15\t   when its expression is entered, before its children; a conditional's\n    16\t   arms are lowered into the conditional's destination and mint nothing\n    17\t   themselves; a `:resume` mints like every other expression though no\n    18\t   instruction names its id as a destination. No moves, folds or\n    19\t   rewrites.\n    20\t\n    21\t   Provenance is a side table beside the vector, never inside it; the\n    22\t   code address is `ucf/code-address` of the vector.\"\n    23\t  (:require [yin.vm :as vm]\n    24\t            [yin.vm.ucf :as ucf]))\n    25\t\n    26\t\n    27\t(def unsupported\n    28\t  \"Node types outside the shared supported AST vocabulary, rejected at\n    29\t   projection naming the node.\"\n    30\t  #{:yin/macro-expand :vm/store-update})\n    31\t\n    32\t\n    33\t(def ^:private slot-position\n    34\t  \"`[tag field]` → the field's row position (§2.5: id 0, tag 1, first\n    35\t   slot 2), from `vm/semantic-bytecode-grammar`. Provenance path steps\n    36\t   are these positions in both lanes.\"\n    37\t  (reduce-kv (fn [m tag slots]\n    38\t               (reduce (fn [m i]\n    39\t                         (assoc m [tag (first (nth slots i))] (+ 2 i)))\n    40\t                       m\n    41\t                       (range (count slots))))\n    42\t             {}\n    43\t             vm/semantic-bytecode-grammar))\n    44\t\n    45\t\n    46\t(def ^:private defaults\n    47\t  \"§2.4 / UCF §7.3.2 saturation, applied before lowering. The row lane's\n    48\t   rows are already saturated; the datom lane's facts may omit these.\"\n    49\t  {[:vm/gensym :prefix] \"id\",\n    50\t   [:stream/make :buffer] vm/default-stream-capacity,\n    51\t   [:application :operands] [],\n    52\t   [:dao.stream.apply/call :operands] []})\n    53\t\n    54\t\n    55\t(defn- flatten-tree\n    56\t  \"The §3.3 walk from `root` over `reader`, `{:tag (fn [id]) :slot (fn\n    57\t   [id field]) :check (fn [id])}`. `:check` runs on entering each lowered\n    58\t   node and throws to refuse it. Returns `{:code [tuple …] :sources [[id\n    59\t   path] …]}`, one source per pc, labels resolved to pcs.\"\n    60\t  [{:keys [tag slot check]} root]\n    61\t  (let [code (volatile! [])\n    62\t        sources (volatile! [])\n    63\t        labels (volatile! {})\n    64\t        bodies (volatile! [])\n    65\t        label-count (volatile! 0)\n    66\t        regs (volatile! 0)\n    67\t        fresh-label! (fn [] (vswap! label-count inc))\n    68\t        mark! (fn [l] (vswap! labels assoc l (count @code)))\n    69\t        emit! (fn [id path t]\n    70\t                (vswap! sources conj [id path])\n    71\t                (vswap! code conj t))\n    72\t        field (fn [id f]\n    73\t                (let [x (slot id f)]\n    74\t                  (if (nil? x) (get defaults [(tag id) f]) x)))\n    75\t        pos (fn [id f] (get slot-position [(tag id) f]))]\n    76\t    (letfn\n    77\t      [(definition?\n    78\t         [id]\n    79\t         (let [op (slot id :operator)]\n    80\t           (and (= :variable (tag op))\n    81\t                (= vm/definition-operator (slot op :name)))))\n    82\t       (expr\n    83\t         [id path]\n    84\t         (let [d @regs]\n    85\t           (vswap! regs inc)\n    86\t           (lower id path d)\n    87\t           d))\n    88\t       (exprs\n    89\t         [id f path]\n    90\t         (let [p (pos id f)\n    91\t               ids (field id f)]\n    92\t           (mapv (fn [j] (expr (nth ids j) (conj path [p j])))\n    93\t                 (range (count ids)))))\n    94\t       (child\n    95\t         [id f path]\n    96\t         (expr (slot id f) (conj path (pos id f))))\n    97\t       (lower\n    98\t         [id path d]\n    99\t         (check id)\n   100\t         (case (tag id)\n   101\t           :literal (emit! id path [:const d (slot id :value)])\n   102\t           :variable (emit! id path [:var d (slot id :name)])\n   103\t           :lambda (let [l (fresh-label!)]\n   104\t                     (vswap! bodies conj [l id path])\n   105\t                     (emit! id path [:closure d (vec (slot id :params)) l]))\n   106\t           :application\n   107\t           (if (definition? id)\n   108\t             ;; Rule R: the value operand, then `:define` with the literal\n   109\t             ;; key; neither the operator nor the key is an expression.\n   110\t             (let [[k-id v-id] (field id :operands)\n   111\t                   rs (expr v-id (conj path [(pos id :operands) 1]))]\n   112\t               (emit! id path [:define d (slot k-id :value) rs]))\n   113\t             (let [f (child id :operator path)\n   114\t                   args (exprs id :operands path)]\n   115\t               (emit! id path\n   116\t                      [:call d f args (boolean (slot id :tail?))])))\n   117\t           :if (let [else (fresh-label!)\n   118\t                     end (fresh-label!)\n   119\t                     c (child id :test path)]\n   120\t                 (emit! id path [:branch-false c else])\n   121\t                 (lower (slot id :consequent) (conj path (pos id :consequent)) d)\n   122\t                 (emit! id path [:jump end])\n   123\t                 (mark! else)\n   124\t                 (lower (slot id :alternate) (conj path (pos id :alternate)) d)\n   125\t                 (mark! end))\n   126\t           :dao.stream.apply/call (let [args (exprs id :operands path)]\n   127\t                                    (emit! id path\n   128\t                                           [:ffi-call d (slot id :op) args]))\n   129\t           :stream/make (emit! id path [:stream-make d (field id :buffer)])\n   130\t           :stream/put (let [s (child id :target path)\n   131\t                             x (child id :val path)]\n   132\t                         (emit! id path [:stream-put d s x]))\n   133\t           :stream/cursor (emit! id path\n   134\t                                 [:stream-cursor d (child id :source path)])\n   135\t           :stream/next (emit! id path\n   136\t                               [:stream-next d (child id :source path)])\n   137\t           :stream/close (emit! id path\n   138\t                                [:stream-close d (child id :source path)])\n   139\t           :vm/gensym (emit! id path [:gensym d (field id :prefix)])\n   140\t           :vm/store-get (emit! id path [:store-get d (slot id :key)])\n   141\t           :vm/store-put (emit! id path\n   142\t                                [:store-put d (slot id :key) (slot id :val)])\n   143\t           :vm/park (emit! id path [:park d])\n   144\t           :vm/current-continuation (emit! id path [:current-continuation d])\n   145\t           :vm/resume (let [x (child id :val path)]\n   146\t                        (emit! id path [:resume (slot id :parked-id) x]))\n   147\t           (throw (ex-info (str \"Cannot project node of type \" (tag id))\n   148\t                           {:type (tag id), :id id}))))]\n   149\t      (let [r (expr root [])]\n   150\t        (emit! root [] [:halt r]))\n   151\t      ;; A body may hold lambdas of its own, which join the back of\n   152\t      ;; `bodies` while this loop runs. Each body numbers its registers\n   153\t      ;; from 0, and its `:return` names the lambda, as the stack lane's\n   154\t      ;; does.\n   155\t      (loop [i 0]\n   156\t        (when-let [[l lambda path] (get @bodies i)]\n   157\t          (vreset! regs 0)\n   158\t          (mark! l)\n   159\t          (let [r (expr (slot lambda :body) (conj path (pos lambda :body)))]\n   160\t            (emit! lambda path [:return r]))\n   161\t          (recur (inc i))))\n   162\t      (let [labels @labels]\n   163\t        {:code (mapv (fn [t]\n   164\t                       (case (nth t 0)\n   165\t                         :jump (assoc t 1 (get labels (nth t 1)))\n   166\t                         :branch-false (assoc t 2 (get labels (nth t 2)))\n   167\t                         :closure (assoc t 3 (get labels (nth t 3)))\n   168\t                         t))\n   169\t                     @code),\n   170\t         :sources @sources}))))\n   171\t\n   172\t\n   173\t;; =============================================================================\n   174\t;; The row lane\n   175\t;; =============================================================================\n   176\t\n   177\t(defn- row-reader\n   178\t  \"Rows `{id [id tag & slots]}` already passed `vm/validate-rows`, so\n   179\t   nothing is re-checked.\"\n   180\t  [rows]\n   181\t  {:tag (fn [id] (nth (get rows id) 1)),\n   182\t   :slot (fn [id f]\n   183\t           (let [row (get rows id)]\n   184\t             (nth row (get slot-position [(nth row 1) f]))))\n   185\t   :check (fn [_id])})\n   186\t\n   187\t\n   188\t(defn- validated-call-origins\n   189\t  \"The occurrence key map `{[root path] origin}` a C1 side table\n   190\t   (`[origin root path :yang/call-site 1]` rows, as validated by the\n   191\t   cc2 producers) claims over canonical tree `bc` — cc3 item 1. Every\n   192\t   row is held to the contract before any of it is believed: a\n   193\t   malformed row, an unsupported marker version, a non-occurrence\n   194\t   origin (`[:oracle/fixture <id>]` included), a foreign root, or a\n   195\t   path that names no `:application` occurrence of this tree refuses\n   196\t   with `:rule :call-site-row`; two rows for one occurrence refuse\n   197\t   with `:rule :call-site-conflict`. Nothing is invented: an\n   198\t   occurrence with no row is simply absent from the result.\"\n   199\t  [bc rows]\n   200\t  (let [eligible (vm/application-occurrences bc)\n   201\t        ;; only the C1 key is this contract's business: other frontend\n   202\t        ;; metadata in the same relation is preserved independently\n   203\t        ;; (design §2.2) and is neither believed nor refused here\n   204\t        rows (filter (fn [row]\n   205\t                       (and (vector? row) (< 3 (count row))\n   206\t                            (= :yang/call-site (nth row 3))))\n   207\t                     rows)]\n   208\t    (reduce\n   209\t      (fn [m row]\n   210\t        (when-not (and (vector? row) (= 5 (count row))\n   211\t                       (= :yang/call-site (nth row 3))\n   212\t                       (integer? (nth row 4)) (= 1 (nth row 4))\n   213\t                       (vm/occurrence-origin? (nth row 0))\n   214\t                       (vector? (nth row 2)))\n   215\t          (throw (ex-info \"Cannot project rows with a malformed call-site row\"\n   216\t                          {:rule :call-site-row, :row row})))\n   217\t        (let [[origin root path] row\n   218\t              key [root path]]\n   219\t          (when-not (and (= root (:root bc)) (contains? eligible key))\n   220\t            (throw (ex-info \"Call-site row names no application occurrence of this tree\"\n   221\t                            {:rule :call-site-row, :row row})))\n   222\t          (when (contains? m key)\n   223\t            (throw (ex-info \"Conflicting call-site rows for one occurrence\"\n   224\t                            {:rule :call-site-conflict, :key key, :row row})))\n   225\t          (assoc m key origin)))\n   226\t      {}\n   227\t      rows)))\n   228\t\n   229\t\n   230\t(defn project-rows\n   231\t  \"Project one canonical row set (`vm/ast->semantic-bytecode`'s `{:root\n   232\t   id, :rows {id row}}`) to the register-shaped vector. The rows are\n   233\t   validated (§7.4) first and a defect throws naming it. `origin` is nil\n   234\t   or one of §2.5's ruled occurrence origins.\n   235\t\n   236\t   Returns `{:vector v :address A :provenance [[pc origin root path] …]}`,\n   237\t   one provenance row per pc, `path` being the emitting node's §2.5\n   238\t   structural path from the root row (row-position steps; a `nodes` item\n   239\t   is a `[position i]` pair); a body's `:return` carries its lambda's\n   240\t   path.\n   241\t\n   242\t   The three-argument form additionally resolves `:call-provenance` —\n   243\t   `[[pc origin root path] …]`, one row per `:call` instruction — from\n   244\t   the validated C1 side table `call-site-rows`: each call occurrence\n   245\t   resolves to ITS OWN origin (a tree mixing `[:source …]` and\n   246\t   `[:expansion …]` applications is never stamped with one blanket\n   247\t   origin), and a call occurrence with no validated row yields NO\n   248\t   entry (absence, never invention). Without a side table the relation\n   249\t   is empty: a caller-supplied single `origin` never stamps it — that\n   250\t   origin belongs to the full `:provenance` table alone. Rule R\n   251\t   applications lower to `:define` and yield no call row. Provenance is\n   252\t   a side table: the vector and its address are identical with or\n   253\t   without it.\"\n   254\t  ([bc] (project-rows bc nil nil))\n   255\t  ([bc origin] (project-rows bc origin nil))\n   256\t  ([{:keys [root rows], :as bc} origin call-site-rows]\n   257\t   (when-not (or (nil? origin) (vm/occurrence-origin? origin))\n   258\t     (throw (ex-info \"Cannot project rows with a malformed occurrence origin\"\n   259\t                     {:rule :origin, :origin origin})))\n   260\t   (when-let [{:keys [rule path id]} (vm/validate-rows bc)]\n   261\t     (throw (ex-info \"Cannot project rows that fail validation\"\n   262\t                     (cond-> {:rule rule}\n   263\t                       path (assoc :path path)\n   264\t                       id (assoc :id id)))))\n   265\t   (let [{:keys [code sources]} (flatten-tree (row-reader rows) root)\n   266\t         by-occurrence (when (some? call-site-rows)\n   267\t                         (validated-call-origins bc call-site-rows))]\n   268\t     {:vector code,\n   269\t      :address (ucf/code-address code),\n   270\t      :provenance (mapv (fn [pc [_ path]] [pc origin root path])\n   271\t                        (range)\n   272\t                        sources),\n   273\t      :call-provenance\n   274\t      (if (nil? by-occurrence)\n   275\t        []\n   276\t        (into []\n   277\t              (keep (fn [pc]\n   278\t                      (when (= :call (first (nth code pc)))\n   279\t                        (let [path (second (nth sources pc))]\n   280\t                          (when-let [o (get by-occurrence [root path])]\n   281\t                            [pc o root path])))))\n   282\t              (range (count code))))})))\n   283\t\n   284\t\n   285\t(defn project\n   286\t  \"`project-rows` ∘ `vm/ast->semantic-bytecode`: a map AST to the\n   287\t   register-shaped vector by the row lane.\"\n   288\t  ([ast] (project ast nil))\n   289\t  ([ast origin] (project-rows (vm/ast->semantic-bytecode ast) origin)))\n   290\t\n   291\t\n   292\t;; =============================================================================\n   293\t;; The datom lane\n   294\t;; =============================================================================\n   295\t\n   296\t(defn- datom-attr\n   297\t  \"The `:yin/*` attribute `vm/ast->datoms` writes for a grammar field.\"\n   298\t  [tag f]\n   299\t  (if (= :val f)\n   300\t    (if (= :vm/store-put tag) :yin/value :yin/val-node)\n   301\t    (keyword \"yin\" (name f))))\n   302\t\n   303\t\n   304\t(defn- reject-host-value!\n   305\t  [id f x]\n   306\t  (when-not (vm/plain-data? x)\n   307\t    (throw (ex-info (str \"Cannot project a host value in \" f)\n   308\t                    {:node id, :field f, :value x}))))\n   309\t\n   310\t\n   311\t(defn- datom-reader\n   312\t  \"A reader over `vm/index-datoms`' `get-attr`. Datoms are not validated\n   313\t   as rows are, so `:check` refuses what the row lane's validation would:\n   314\t   unsupported and unknown node types, Rule R, non-symbol binders, and\n   315\t   host values in data operands.\"\n   316\t  [get-attr]\n   317\t  (let [tag (fn [id] (get-attr id :yin/type))\n   318\t        slot (fn [id f] (get-attr id (datom-attr (tag id) f)))]\n   319\t    {:tag tag,\n   320\t     :slot slot,\n   321\t     :check\n   322\t     (fn [id]\n   323\t       (let [t (tag id)]\n   324\t         (when (contains? unsupported t)\n   325\t           (throw (ex-info (str \"Cannot project unsupported node \" t)\n   326\t                           {:type t, :node id})))\n   327\t         (case t\n   328\t           :literal (reject-host-value! id :value (slot id :value))\n   329\t           :variable (let [n (slot id :name)]\n   330\t                       (when (vm/reserved-name? n)\n   331\t                         (vm/refuse-reserved! :variable n {:node id})))\n   332\t           :lambda (vm/check-params! (slot id :params) {:node id})\n   333\t           :application\n   334\t           (let [op (slot id :operator)]\n   335\t             (when (and (= :variable (tag op))\n   336\t                        (= vm/definition-operator (slot op :name)))\n   337\t               (vm/definition-name\n   338\t                 {:operands (mapv (fn [o]\n   339\t                                    {:type (tag o), :value (slot o :value)})\n   340\t                                  (slot id :operands))})))\n   341\t           (:vm/store-get :vm/store-put)\n   342\t           (let [k (slot id :key)]\n   343\t             (when (vm/reserved-name? k)\n   344\t               (vm/refuse-reserved! :store-key k {:node id}))\n   345\t             (reject-host-value! id :key k)\n   346\t             (when (= :vm/store-put t)\n   347\t               (reject-host-value! id :val (slot id :val))))\n   348\t           nil)))}))\n   349\t\n   350\t\n   351\t(defn project-datoms\n   352\t  \"Project one AST program, as `[e a v t m]` `:yin/*` datoms, to the\n   353\t   register-shaped vector by the datom lane. Throws naming the node on an\n   354\t   unsupported or unknown node type, a Rule R violation, or a host value\n   355\t   in a data operand.\n   356\t\n   357\t   Returns `{:vector v :address A :provenance [[pc entity] …]}`, one row\n   358\t   per pc naming the AST entity the instruction came from (the stack\n   359\t   lane's `:yin.code/source`).\n   360\t\n   361\t   cc3 restriction (item 4, recorded in the cc3 findings): this lane\n   362\t   carries NO occurrence key K. The entity→occurrence bridge (design\n   363\t   §2.4: explicit entity-to-occurrence mapping with owning batch/root/\n   364\t   path, refusing ambiguity) is D1's stated dependency; until it lands,\n   365\t   cc3's provenance claims cover the row lane only, and this lane's\n   366\t   `[pc entity]` shape must not be read as a K bridge.\"\n   367\t  [datoms]\n   368\t  (let [{:keys [get-attr root-id error]} (vm/index-datoms (vec datoms))]\n   369\t    (when error\n   370\t      (throw (ex-info \"Cannot project a program with a dangling root\" error)))\n   371\t    (when (nil? root-id)\n   372\t      (throw (ex-info \"Cannot project a program with no root\" {})))\n   373\t    (let [{:keys [code sources]} (flatten-tree (datom-reader get-attr)\n   374\t                                               root-id)]\n   375\t      {:vector code,\n   376\t       :address (ucf/code-address code),\n   377\t       :provenance (mapv (fn [pc [id _]] [pc id]) (range) sources)})))\n","exit_code":0,"status":"completed"}}
