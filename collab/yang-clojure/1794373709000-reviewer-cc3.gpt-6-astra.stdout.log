  3432\t    (reduce (fn [acc [j [field kind]]]\n  3433\t              (let [pos (+ j 2)\n  3434\t                    value (get node field)]\n  3435\t                (case kind\n  3436\t                  :node (if (map? value)\n  3437\t                          (cc3-walk value (conj path pos) acc)\n  3438\t                          acc)\n  3439\t                  :nodes (reduce (fn [a [i child]]\n  3440\t                                   (cc3-walk child (conj path [pos i]) a))\n  3441\t                                 acc\n  3442\t                                 (map-indexed vector (or value [])))\n  3443\t                  acc)))\n  3444\t            (conj acc [path node])\n  3445\t            (map-indexed vector\n  3446\t                         (get vm/semantic-bytecode-grammar (:type node))))\n  3447\t    acc))\n  3448\t\n  3449\t\n  3450\t(defn- cc3-stamp-site-id\n  3451\t  \"The integer site a stamping wrapper carries, or nil.\"\n  3452\t  [wrapper]\n  3453\t  (when (kernel-stamped-args? wrapper)\n  3454\t    (let [k (get-in wrapper [:operands 0 :operands 1 :operands 1 :value])]\n  3455\t      (when (integer? k) k))))\n  3456\t\n  3457\t\n  3458\t(defn- cc3-oracle-binding\n  3459\t  \"Bind each stamped oracle site id to its post-expansion C1 key\n  3460\t   K = [origin root path] in the COMPILED (pre-stamp) tree.\n  3461\t\n  3462\t   Chronology (mob condition 2): `kernel-compile` compiles FIRST and\n  3463\t   stamps by insertion afterward, so the stamped tree is a NEW tree;\n  3464\t   the guest application a stamp wraps keeps its compiled-tree path\n  3465\t   (the stamp only wraps that application's argument node), and the\n  3466\t   binding is read off the compiled tree's validated C1 rows. The\n  3467\t   admission origin is the recorded coordinate\n  3468\t   [:source :program <canonical-source-hash> 0] — a validator-shaped\n  3469\t   recorded admission; [:oracle/fixture <id>] is never minted.\"\n  3470\t  [compiled]\n  3471\t  (let [ast (:compiled-