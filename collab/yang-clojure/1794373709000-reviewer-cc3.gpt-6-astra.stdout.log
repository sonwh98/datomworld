           (u/lit false)))\n  1681\t                       (map #(compile-form % false env macro-env) operands)))\n  1682\t        tail? (assoc :tail? true)))\n  1683\t\n  1684\t    (and (outcomes? env)\n  1685\t         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n  1686\t         (<= 4 (count operands)))\n  1687\t    (let [bindings (into ['dsg__invocation_candidate]\n  1688\t                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n  1689\t                         (range (dec (count operands))))\n  1690\t          compile-operand #(compile-form % false env macro-env)]\n  1691\t      (cond-> (u/mark-tails\n  1692\t                (apply u/app\n  1693\t                       (u/lam bindings\n  1694\t                              (u/if-node\n  1695\t                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n  1696\t                                (apply u/app (u/v operator) (map u/v bindings))\n  1697\t                                (u/app (u/v 'yang.call/transfer)\n  1698\t                                       (u/v (nth bindings 3))\n  1699\t                                       (u/app (u/v 'yang.call/condition)\n  1700\t                                              (u/lit :yang.call/not-callable)\n  1701\t                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n  1702\t                                                     (u/lit :yang.call/callee)\n  1703\t                                                     (u/v (first bindings)))))))\n  1704\t                       (map compile-operand operands)))\n  1705\t        tail? (assoc :tail? true)))\n  1706\t\n  1707\t    ;; a statically intra-unit defn/defn- under the outcome model: apply the\n  1708\t    ;; unit's public entry with the compiler's token packet (a two-element\n  1709\t    ;; vector: [token args]) - the private lane on the same unary entry,\n  1710\t    ;; one conj and one lookup, no record construction\n  1711\t    (in