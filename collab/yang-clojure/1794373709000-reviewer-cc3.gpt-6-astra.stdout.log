urrence-origin? o))))\n  2033\t    (is (nil? (repl/packet-call-provenance {:expander {}} packet))\n  2034\t        \"no retained table: absence, never invention\")\n  2035\t    (is (= :ambiguous-call-site-table\n  2036\t           (failure-rule\n  2037\t             (fn []\n  2038\t               (repl/packet-call-provenance\n  2039\t                 (assoc-in state [:expander :call-site-tables\n  2040\t                                  [[:source :program-in :other 0]\n  2041\t                                   (first packet)]]\n  2042\t                           frontend-metadata)\n  2043\t                 packet))))\n  2044\t        \"two admissions, one root: refuse, never borrow\")))\n   825\t                 (is (= 2 (nth st 2) (count (nth rt 3)))))\n   826\t        :resume (is (= :p1 (nth st 1) (nth rt 1)))\n   827\t        nil)\n   828\t      (is (= (into [] (keep #(when (= :const (first %)) (peek %))) stack)\n   829\t             (into [] (keep #(when (= :const (first %)) (peek %))) register))))))\n   830\t\n   831\t\n   832\t(deftest native-images-reconstruct-call-provenance\n   833\t  ;; cc3 item 2: stack (new sequence) and register (layout-preserving)\n   834\t  ;; images each map their call pcs back through their own derivation\n   835\t  ;; to the semantic occurrence keys; images themselves never change.\n   836\t  (let [src [:source :medium :batch 0]\n   837\t        exp [:source :medium :batch 1]\n   838\t        bc (vm/ast->semantic-bytecode worked-example)\n   839\t        root (:root bc)\n   840\t        apps (vm/application-occurrences bc)\n   841\t        rows (mapv (fn [[r p]] [(if (= p []) src exp) r p :yang/call-site 1])\n   842\t                   (sort-by second apps))\n   843\t        sem (linearize/project-rows bc nil rows)\n   844\t        v (:vector sem)\n   845\t        cp (:call-provenance sem)\n   846\t        stack (derive/stack-image v {:segment-address :seg/stack\n   847\t                                     :call-provenance cp})\n   848\t        stack-plain (derive/stack-image v)\n   849\t        register (derive/register-image v {:segment-address :seg/register\n   850\t                                           :call-provenance cp})\n   851\t        register-plain (derive/register-image v)]\n   852\t    (testing \"images are byte-identical to the provenance-free derivation\"\n   853\t      (is (= (:image stack-plain) (:image stack)))\n   854\t      (is (= (:instructions register-plain) (:instructions register))))\n   855\t    (testing \"register: layout preserved, so call pcs are semantic pcs\"\n   856\t      (is (= (mapv (fn [[pc o r p]] [:seg/register pc o r p]) cp)\n   857\t             (:call-provenance register)))\n   858\t      (doseq [[_ pc] (:call-provenance register)]\n   859\t        (is (= :call (first (nth (:instructions register) pc))))))\n   860\t    (testing \"stack: every semantic call key lands on a stack :call pc\"\n   861\t      (is (= (count cp) (count (:call-provenance stack))))\n   862\t      (is (= (set (map (fn [[_pc o r p]] [o r p]) cp))\n   863\t             (set (map (fn [[_ _ o r p]] [o r p]) (:call-provenance stack)))))\n   864\t      (doseq [[seg pc] (:call-provenance stack)]\n   865\t        (is (= :seg/stack seg))\n   866\t        (is (= :call (first (nth (:image stack) pc))))))\n   867\t    (testing \"stack side-table gains :call diagnostics, old shapes intact\"\n   868\t      (is (some (fn [[_ info]] (= :call (:kind info))) (:side-table stack)))\n   869\t      (is (every? (fn [[_ info]] (contains? #{:closure :var :call} (:kind info)))\n   870\t                  (:side-table stack))))\n   871\t    (testing \"a provenance row naming a non-call pc refuses\"\n   872\t      (let [non-call (first (keep-indexed (fn [pc t] (when (not= :call (first t)) pc)) v))]\n   873\t        (is (= :call-provenance\n   874\t               (try (derive/register-image\n   875\t                      v {:segment-address :seg/register\n   876\t                         :call-provenance [[non-call src root []]]})\n   877\t                    nil\n   878\t                    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   879\t                      (:rule (ex-data e))))))))))\n   390\t      (is (= {:type type :node -20}\n   391\t             (throws-ex-data #(linearize/project-datoms datoms))))))\n   392\t  (is (= {:type :no/such :id -20}\n   393\t         (throws-ex-data #(linearize/project-datoms\n   394\t                            [[-20 :yin/root true 0 :db/add]\n   395\t                             [-20 :yin/type :no/such 0 :db/add]])))))\n   396\t\n   397\t\n   398\t(deftest call-provenance-resolves-per-occurrence-origins\n   399\t  ;; cc3 item 1: a tree whose applications carry DIFFERENT validated\n   400\t  ;; origins (one admitted, one expansion-generated) resolves each call\n   401\t  ;; instruction to its own [origin root path]; an occurrence with no\n   402\t  ;; validated row yields no entry; Rule R lowers to :define and yields\n   403\t  ;; no fictitious call event; the vector/address never move.\n   404\t  (let [src [:source :medium :batch 0]\n   405\t        exp [:expansion (jing/segment-key [:cc3-test-record 1])]\n   406\t        ast (app (v 'f) (app (v 'g) (v 'x)) (def! 'k (lit 1)))\n   407\t        bc (vm/ast->semantic-bytecode ast)\n   408\t        root (:root bc)\n   409\t        apps (vm/application-occurrences bc)\n   410\t        ;; the root application is admitted; every other application\n   411\t        ;; occurrence is expansion-generated — never one blanket origin\n   412\t        rows (mapv (fn [[r p]] [(if (= p []) src exp) r p :yang/call-site 1])\n   413\t                   (sort-by second apps))\n   414\t        plain (linearize/project-rows bc)\n   415\t        resolved (linearize/project-rows bc nil rows)\n   416\t        call-pcs (into [] (keep-indexed (fn [pc t] (when (= :call (first t)) pc)))\n   417\t                       (:vector resolved))\n   418\t        define-pcs (into [] (keep-indexed (fn [pc t] (when (= :define (first t)) pc)))\n   419\t                         (:vector resolved))]\n   420\t    (testing \"canonical invariance: provenance never moves code\"\n   421\t      (is (= (:vector plain) (:vector resolved)))\n   422\t      (is (= (:address plain) (:address resolved))))\n   423\t    (testing \"every call pc resolves to its own occurrence's origin\"\n   424\t      (is (seq call-pcs))\n   425\t      (is (= (count call-pcs) (count (:call-provenance resolved))))\n   426\t      (doseq [[pc origin r path] (:call-provenance resolved)]\n   427\t        (is (= :call (first (nth (:vector resolved) pc))))\n   428\t        (is (= root r))\n   429\t        (is (= (if (= path []) src exp) origin)\n   430\t            (str \"pc \" pc \" at \" (pr-str path) \" keeps its own origin\"))))\n   431\t    (testing \"Rule R: the yin/def application emits :define, no call row\"\n   432\t      (is (seq define-pcs))\n   433\t      (is (not-any? (fn [[pc]] (contains? (set define-pcs) pc))\n   434\t                    (:call-provenance resolved))))\n   435\t    (testing \"absence, never invention: a missing row drops that call only\"\n   436\t      (let [partial (linearize/project-rows bc nil (subvec rows 1))]\n   437\t        (is (= (dec (count (:call-provenance resolved)))\n   438\t               (count (:call-provenance partial)))))\n   439\t      ;; a blanket caller origin never stamps call provenance: only\n   440\t      ;; validated C1 rows do (the full :provenance table keeps the\n   441\t      ;; caller-supplied origin, one row per pc)\n   442\t      (is (= [] (:call-provenance (linearize/project-rows bc src))))\n   443\t      (is (= [] (:call-provenance (linearize/project-rows bc)))))\n   444\t    (testing \"refusals: conflicting, alien, and malformed rows throw\"\n   445\t      (is (= :call-site-conflict\n   446\t             (:rule (throws-ex-data\n   447\t                      #(linearize/project-rows\n   448\t                         bc nil (conj rows [exp root [] :yang/call-site 1]))))))\n   449\t      (is (= :call-site-row\n   450\t             (:rule (throws-ex-data\n   451\t                      #(linearize/project-rows\n   452\t                         bc nil [[src root [[9 9]] :yang/call-site 1]])))))\n   453\t      (is (= :call-site-row\n   454\t             (:rule (throws-ex-data\n   455\t                      #(linearize/project-rows\n   456\t                         bc nil [[src root [] :yang/call-site 2]])))))\n   457\t      (is (= :call-site-row\n   458\t             (:rule (throws-ex-data\n   459\t                      #(linearize/project-rows\n   460\t                         bc nil [[[:oracle/fixture 1] root [] :yang/call-site 1]]))))))))\n   461\t\n   462\t\n   463\t(deftest datom-lane-provenance-names-entities-only\n   464\t  ;; cc3 item 4 (restriction): the datom lane's provenance stays\n   465\t  ;; [pc entity]; it carries NO occurrence key K. The entity->occurrence\n   466\t  ;; bridge is D1's stated dependency, recorded in the cc3 findings —\n   467\t  ;; this lane must not silently grow a half-bridge.\n   468\t  (let [d (datom-lane (app (v 'f) (lit 1)))]\n   469\t    (is (every? (fn [row] (= 2 (count row))) (:provenance d)))\n   470\t    (is (not (contains? d :call-provenance)))))\n","exit_code":0,"status":"completed"}}
