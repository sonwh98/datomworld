ecord) nil)]\n+           (when (and (map? manifest)\n+                      (= (:yang.call-site/root record)\n+                         (:yin.module/tree manifest)))\n+             (let [relation (jing/get handle\n+                                      (:yang.call-site/provenance record)\n+                                      nil)]\n+               (when (and (map? relation)\n+                          (= 1 (:yin.vm.provenance/schema relation))\n+                          (= (:yang.call-site/root record)\n+                             (:yin.vm.provenance/root relation)))\n+                 {:root (:yin.vm.provenance/root relation)\n+                  :semantic (:yin.vm.provenance/semantic relation)\n+                  :stack (:yin.vm.provenance/stack relation)\n+                  :register (:yin.vm.provenance/register relation)})))))))))\n+\n+\n ;; =============================================================================\n ;; Deriving a module from indexed code (5.3)\n ;; =============================================================================\ndiff --git a/src/cljc/yin/vm/semantic/derive.cljc b/src/cljc/yin/vm/semantic/derive.cljc\nindex dec0816c..7899e90c 100644\n--- a/src/cljc/yin/vm/semantic/derive.cljc\n+++ b/src/cljc/yin/vm/semantic/derive.cljc\n@@ -57,12 +57,45 @@\n           v)))\n \n \n+(defn- call-key-map\n+  \"The `{semantic-pc [origin root path]}` map a `:call-provenance`\n+   relation (`linearize/project-rows`' rows) names over vector `v` —\n+   cc3 item 2. A row naming a pc that holds no `:call` in `v` refuses:\n+   native provenance is reconstructed through each format's own PC\n+   derivation, never assumed from PC equality across formats.\"\n+  [v call-provenance]\n+  (reduce (fn [m row]\n+            (when-not (and (vector? row) (= 4 (count row))\n+                           (integer? (nth row 0))\n+                           (<= 0 (nth row 0)) (< (nth row 0) (count v))\n+                           (= :call (first (nth v (nth row 0)))))\