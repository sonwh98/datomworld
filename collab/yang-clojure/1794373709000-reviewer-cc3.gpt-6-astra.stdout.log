her (cc3 item 3: this\n+   choke point used to select `(:vector …)` and discard the rest).\"\n+  [packet]\n+  (linearize/project-rows (macro/packet->row-set packet)))\n+\n+\n (defn- packet->vector\n   [packet]\n-  (:vector (linearize/project-rows (macro/packet->row-set packet))))\n+  (:vector (packet->projection packet)))\n+\n+\n+(defn packet-call-provenance\n+  \"The call provenance of one expanded tree `packet` in session\n+   `state`, resolved from the expander's retained C1 side tables\n+   (`call-site-tables`, keyed `[admission-origin final-root]`):\n+   `{:semantic [[segment pc origin root path] …] :stack […] :register\n+   […]}` over the same images the loaders derive, or nil when the\n+   packet's root claimed no C1 (absence, never invention). Two\n+   retained admissions for one root refuse with\n+   `:rule :ambiguous-call-site-table` — a table is never borrowed\n+   across admissions. Segment coordinates are the images' own\n+   content identities, as the loaders compute them.\"\n+  [state packet]\n+  (let [root (first packet)\n+        tables (:call-site-tables (:expander state))\n+        matches (into []\n+                      (filter (fn [[[_origin r] _rows]] (= r root)))\n+                      tables)]\n+    (cond\n+      (empty? matches) nil\n+      (< 1 (count matches))\n+      (throw (ex-info \"Two retained admissions claim one packet root\"\n+                      {:rule :ambiguous-call-site-table, :root root}))\n+      :else\n+      (let [rows (vec (second (first matches)))\n+            proj (linearize/project-rows (macro/packet->row-set packet)\n+                                         nil rows)\n+            v (:vector proj)\n+            sem-address (ucf/code-address v)\n+            ;; each image is derived ONCE, provenance attached: the\n+            ;; segment coordinate is the image own content identity\n+            ;; (unchanged by provenance), patched into the rows as the\n+            ;; loaders compute it\n+            stack (derive/stack-image\n+                    v {:call-provenance (:call-provenance proj)})\n+            stack-address (dcode/image-hash (:image stack))\n+            register (derive/register-image\n+                       v {:call-provenance (:call-provenance proj)})\n+            register-address (rcode/register-hash register)]\n+        {:semantic (mapv (fn [[pc o r p]] [sem-address pc o r p])\n+                         (:call-provenance proj))\n+         :stack (mapv (fn [row] (assoc row 0 stack-address))\n+                      (:call-provenance stack))\n+         :register (mapv (fn [row] (assoc row 0 register-address))\n+                         (:call-provenance register))}))))\n \n \n (defn- append-stack-image\ndiff --git a/src/cljc/yin/vm/linker/publish.cljc b/src/cljc/yin/vm/linker/publish.cljc\nindex d3dde756..3b7b1986 100644\n--- a/src/cljc/yin/vm/linker/publish.cljc\n+++ b/src/cljc/yin/vm/linker/publish.cljc\n@@ -322,10 +322,27 @@\n \n       :else\n       (let [tree-address (vm/materialize-tree! handle tree)\n-            sem-vector (:vector (linearize/project-rows tree))\n+            ;; cc3 item 3: a claimed publication projects WITH its\n+            ;; validated C1 rows so every image's call provenance is\n+            ;; resolved per-occurrence at lowering time; an unclaimed\n+            ;; publication projects exactly as before\n+            sem-proj (if (:rows claim)\n+                       (linearize/project-rows tree nil (:rows claim))\n+                       (linearize/project-rows tree))\n+            sem-vector (:vector sem-proj)\n             sem (code/materialize-vector! handle sem-vector)\n-            h-image (:image (derive/stack-image sem-vector))\n-            r-image (derive/register-image sem-vector)\n+            stack-full (when (:rows claim)\n+                         (derive/stack-image\n+                           sem-vector {:segment-address sem\n+                                       :call-provenance (:call-provenance sem-proj)