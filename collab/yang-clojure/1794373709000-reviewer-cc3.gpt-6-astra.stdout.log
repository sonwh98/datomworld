{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/latte_oracle_test.clj | sed -n '2050,2265p'; nl -ba test/yang/latte_oracle_test.clj | sed -n '2400,2508p'\"","aggregated_output":"  2050\t\n  2051\t(defn- kernel-site-arguments\n  2052\t  \"The argument expression nodes of one compiled call site: the operand\n  2053\t   vector the argument-vector convention assembles. `node` is either the\n  2054\t   intra-unit fast path `(dsg__intra_call f <args>)` or the routed guest\n  2055\t   call's arguments binding; the arguments are the elements of the\n  2056\t   constructed vector (a constant :literal, or `(conj [] e1 e2 ...)`),\n  2057\t   with any stamping wrapper already applied to inner expressions\n  2058\t   stripped first.\"\n  2059\t  [args-node]\n  2060\t  (let [args-node (or (kernel-stamped-args? args-node) args-node)]\n  2061\t    (cond\n  2062\t      (= :literal (:type args-node)) (:value args-node)\n  2063\t      (and (= :application (:type args-node))\n  2064\t           (= :variable (:type (:operator args-node)))\n  2065\t           (= 'conj (:name (:operator args-node)))\n  2066\t           (= :literal (:type (first (:operands args-node)))))\n  2067\t      (rest (:operands args-node))\n  2068\t      :else nil)))\n  2069\t\n  2070\t\n  2071\t(defn- kernel-intra-call?\n  2072\t  \"The compiled shape of one intra-unit guest call under the\n  2073\t   argument-vector convention: an application of the unit's dispatcher\n  2074\t   whose first operand names the callee and whose second is the assembled\n  2075\t   argument vector.\"\n  2076\t  [node]\n  2077\t  (and (= :application (:type node))\n  2078\t       (= :variable (:type (:operator node)))\n  2079\t       (= 'dsg__intra_call (:name (:operator node)))\n  2080\t       (= 2 (count (:operands node)))))\n  2081\t\n  2082\t\n  2083\t(defn- kernel-routing?\n  2084\t  \"True when `node` mentions the admission routing's own vocabulary —\n  2085\t   the dispatcher predicate or the invocation transfer — distinguishing\n  2086\t   a compiled guest call's routing from an ordinary nested let (the two\n  2087\t   share the let-lowering shape).\"\n  2088\t  [node]\n  2089\t  (letfn [(any?\n  2090\t            [n]\n  2091\t            (or (and (map? n) (= :variable (:type n))\n  2092\t                     (contains? '#{dsg__admitted? yang.call/invoke\n  2093\t                                   yang.call/invoke-with}\n  2094\t                                (:name n)))\n  2095\t                (and (coll? n) (some any? n))))]\n  2096\t    (boolean (any? node))))\n  2097\t\n  2098\t\n  2099\t(defn- kernel-routed-call?\n  2100\t  \"The compiled shape of one non-intra guest call: the admission routing\n  2101\t   binds the evaluated callee, then the evaluated argument vector, then\n  2102\t   routes. Returns the routing's arguments binding node, or nil for any\n  2103\t   other let-shaped chain: the arguments binding must carry a real\n  2104\t   argument-vector construction (a constant or a conj application).\"\n  2105\t  [node]\n  2106\t  (when (and (= :application (:type node))\n  2107\t             (= :lambda (:type (:operator node)))\n  2108\t             (= 1 (count (:params (:operator node))))\n  2109\t             (= 1 (count (:operands node)))\n  2110\t             (map? (:body (:operator node))))\n  2111\t    (let [inner (:body (:operator node))]\n  2112\t      (when (and (= :application (:type inner))\n  2113\t                 (= :lambda (:type (:operator inner)))\n  2114\t                 (= 1 (count (:params (:operator inner))))\n  2115\t                 (= 1 (count (:operands inner)))\n  2116\t                 (kernel-routing? (:body (:operator inner)))\n  2117\t                 (or (= :literal (:type (first (:operands inner))))\n  2118\t                     (and (map? (first (:operands inner)))\n  2119\t                          (kernel-site-arguments (first (:operands inner))))))\n  2120\t        inner))))\n  2121\t\n  2122\t\n  2123\t(defn- kernel-resolve-site-arg\n  2124\t  \"Classify one call-site argument expression for the derived site table:\n  2125\t   :ambient-literal (the adapter-supplied empty-context initialization,\n  2126\t   possibly through let bindings and ambient-state constructors), :literal,\n  2127\t   :variable (a parameter or an unresolvable binding — R2b case 7), or\n  2128\t   :computed. `scope` maps bound names to their init nodes; `params` are\n  2129\t   the enclosing binders.\"\n  2130\t  [node scope params depth]\n  2131\t  (cond\n  2132\t    (or (nil? node) (> depth 8)) :computed\n  2133\t    (= :literal (:type node)) :literal\n  2134\t    ;; constant-argument values (a fully constant argument vector's\n  2135\t    ;; elements arrive as data, not nodes)\n  2136\t    (not (coll? node)) :literal\n  2137\t    (= :variable (:type node))\n  2138\t    (if (contains? params (:name node))\n  2139\t      :variable\n  2140\t      (if-let [init (get scope (:name node))]\n  2141\t        (recur init scope params (inc depth))\n  2142\t        :variable))\n  2143\t    (and (= :application (:type node)) (kernel-intra-call? node)\n  2144\t         (contains? kernel-ambient-state-constructors\n  2145\t                    (get-in node [:operands 0 :name])))\n  2146\t    (let [args-node (second (:operands node))\n  2147\t          arg-nodes (kernel-site-arguments args-node)\n  2148\t          first-arg (if (sequential? arg-nodes) (first arg-nodes)\n  2149\t                        (when (= :literal (:type (or (kernel-stamped-args? args-node) args-node)))\n  2150\t                          (first (:value (or (kernel-stamped-args? args-node) args-node)))))]\n  2151\t      (if (and (= 'kernel-context (get-in node [:operands 0 :name]))\n  2152\t               (map? first-arg) (= :literal (:type first-arg))\n  2153\t               (= [{} {}] (:value first-arg)))\n  2154\t        :ambient-literal\n  2155\t        (if (and (sequential? arg-nodes) (= 1 (count arg