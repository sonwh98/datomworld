n.link.publish/wrapper-provenance (:reason res)))))))\n+\n+\n+(deftest published-instruction-provenance-test\n+  ;; cc3 item 3: when a publication claims C1, the instruction\n+  ;; provenance of all three images is persisted as a side artifact\n+  ;; OUTSIDE the schema-1 manifest hash, retrievable alongside the\n+  ;; images; an unclaimed publication persists none.\n+  (let [store (mem/create-content-mem)\n+        ast (yang/compile-program '[(defn f [x] (inc x)) (f 2)])\n+        spec {:name 'cc3-provenance\n+              :ast ast\n+              :exports #{'f}\n+              :requires {}\n+              :primitives {'inc {:yin.k/profile :yin.k/pure\n+                                 :yin.k/effects #{}}}}\n+        result (publish/publish-module! store spec)\n+        table (publish/published-call-site-table store result)\n+        prov (publish/published-instruction-provenance store result)]\n+    (is (some? (:address result)))\n+    (is (some? prov) \"the claimed publication persists instruction provenance\")\n+    (is (= (:root table) (:root prov)))\n+    (testing \"every persisted row resolves to a claimed occurrence key\"\n+      (doseq [lane [:semantic :stack :register]\n+              [_seg _pc o r p] (get prov lane)]\n+        (is (contains? (marked (:rows table)) [o r p])\n+            (str lane \" row names a claimed C1 occurrence\"))))\n+    (testing \"all three lanes are present and non-empty where calls exist\"\n+      (is (seq (:semantic prov)))\n+      (is (seq (:stack prov)))\n+      (is (seq (:register prov))))\n+    (testing \"the manifest stays the closed schema-1 key set\"\n+      (is (not (contains? (:manifest result) :yang.call-site/provenance)))\n+      (is (= 1 (:yin.module/schema (:manifest result))))))\n+  (testing \"legacy unannotated packets remain fully loadable\"\n+    (let [store (mem/create-content-mem)\n+          result (publish/publish-module!\n+                   store {:name 'cc3-legacy\n+                          :ast {:type :lambda :params '[x]\n+                                :body {:type :variable :name 'x}}\n+                          :exports #{}\n+                          :requires {}\n+                          :primitives {}})]\n+      (is (some? (:address result)))\n+      (is (nil? (publish/published-instruction-provenance store result))))))\n+\n+\n+(deftest repl-packet-call-provenance-test\n+  ;; cc3 item 3 (repl lane): a packet whose expansion claimed C1\n+  ;; resolves its call provenance from the session's retained tables;\n+  ;; an unclaimed packet yields absence, and two retained admissions\n+  ;; for one root refuse as ambiguous rather than borrowing a table.\n+  (let [{:keys [ctx result]} (expand-like-the-repl\n+                               (yang/compile-program\n+                                 '[(defn f [x] (+ x 1)) (f 2)]))\n+        {:keys [status tree frontend-metadata]} result\n+        packet tree\n+        admission [:source :program-in (:t ctx) 0]\n+        state {:expander {:call-site-tables {[admission (first packet)]\n+                                             frontend-metadata}}}]\n+    (is (= :ok status))\n+    (is (seq frontend-metadata) \"precondition: the expansion claimed C1\")\n+    (let [prov (repl/packet-call-provenance state packet)]\n+      (is (some? prov))\n+      (is (seq (:semantic prov)))\n+      (doseq [[_seg _pc o r _p] (:semantic prov)]\n+        (is (= (first packet) r))\n+        (is (vm/occurrence-origin? o))))\n+    (is (nil? (repl/packet-call-provenance {:expander {}} packet))\n+        \"no retained table: absence, never invention\")\n+    (is (= :ambiguous-call-site-table\n+           (failure-rule\n+             (fn []\n+               (repl/packet-call-provenance\n+                 (assoc-in state [:expander :call-site-tables\n+                                  [[:source :program-in :other 0]\n+                                   (first packet)]]\n+                           frontend-metadata)\n+                 packet))))\n+        \"two admissions, one root: refuse, never borrow\")))\ndiff --git a/test/yang/latte_oracle_test.clj b/test/yang/latte_oracle_test.clj\nindex 00fbeed6..8acfd440 100644\n--- a/test/yang/latte_oracle_test.clj\n+++ b/test/yang/latte_oracle_test.clj\n@@ -27,6 +27,7 @@\n             [yin.vm.ucf.rows-support :as rows-support]\n             [yin.vm.values :as values]\n             [yin.vm.semantic :as semantic]\n+            [yin.vm.semantic.derive :as derive]\n             [yin.vm.semantic.linearize :as linearize]\n             [yin.vm.ucf :as ucf]))\n \n@@ -2468,7 +2469,7 @@\n       {:status :blocked :phase :admission :blocked-by (vec (sort missing))\n        :owners (into {} (for [s missing]\n                           [s (mapv second (filter #(some #{s} (tree-seq coll? seq %)) program))]))}\n-      {:status :compiled :ast stamped :forms forms\n+      {:status :compiled :ast stamped :forms forms :compiled-ast compiled\n        :site-table (into {} (map (juxt :site identity)) sites)\n        :site-table-hash (kernel-canonical-source-hash forms call)\n        :sites sites\n@@ -3417,3 +3418,150 @@\n         (run! #(let [f (java.io.File. (str dir \"/\" %))] (when (.exists f) (.delete f)))\n               [\"slice9_evidence.edn\" \"slice9_unexercised.edn\" \"slice9_site_tables.edn\"])\n         (let [d (java.io.File. dir)] (when (.exists d) (.delete d)))))))\n+\n+\n+;; =============================================================================\n+;; cc3: oracle integer sites bound to post-expansion C1 occurrence keys\n+;; =============================================================================\n+\n+(defn- cc3-walk\n+  \"[[row-path node] ...] over a map AST, paths in the row grammar's\n+   positions (the same convention as `vm/occurrences`).\"\n+  [node path acc]\n+  (if (and (map? node) (:type node))\n+    (reduce (fn [acc [j [field kind]]]\n+              (let [pos (+ j 2)\n+                    value (get node field)]\n+                (case kind\n+                  :node (if (map? value)\n+                          (cc3-walk value (conj path pos) acc)\n+                          acc)\n+                  :nodes (reduce (fn [a [i child]]\n+                                   (cc3-walk child (conj path [pos i]) a))\n+                                 acc\n+                                 (map-indexed vector (or value [])))\n+                  acc)))\n+            (conj acc [path node])\n+            (map-indexed vector\n+                         (get vm/semantic-bytecode-grammar (:type node))))\n+    acc))\n+\n+\n+(defn- cc3-stamp-site-id\n+  \"The integer site a stamping wrapper carries, or nil.\"\n+  [wrapper]\n+  (when (kernel-stamped-args? wrapper)\n+    (let [k (get-in wrapper [:operands 0 :operands 1 :operands 1 :value])]\n+      (when (integer? k) k))))\n+\n+\n+(defn- cc3-oracle-binding\n+  \"Bind each stamped oracle site id to its post-expansion C1 key\n+   K = [origin root path] in the COMPILED (pre-stamp) tree.\n+\n+   Chronology (mob condition 2): `kernel-compile` compiles FIRST and\n+   stamps by insertion afterward, so the stamped tree is a NEW tree;\n+   the guest application a stamp wraps keeps its compiled-tree path\n+   (the stamp only wraps that application's argument node), and the\n+   binding is read off the compiled tree's validated C1 rows. The\n+   admission origin is the recorded coordinate\n+   [:source :program <canonical-source-hash> 0] — a validator-shaped\n+   recorded admission; [:oracle/fixture <id>] is never minted.\"\n+  [compiled]\n+  (let [ast (:compiled-ast compiled)\n+        token (:canonical-source-hash compiled)\n+        origin [:source :program token 0]\n+        projected (encoder/project\n+                    (encoder/source-envelope :program token [ast]))\n+        tree (first (:yin/batch projected))\n+        rows (:yin/frontend-metadata projected)\n+        marked (into #{}\n+                     (comp (filter #(= :yang/call-site (nth % 3)))\n+                           (map (fn [[o r p _ _]] [o r p])))\n+                     rows)\n+        eligible (into #{}\n+                       (map (fn [[r p]] [origin r p]))\n+                       (vm/application-occurrences tree))\n+        stamped-sites (into {}\n+                            (comp (filter (fn [[_ node]]\n+                                            (= :application (:type node))))\n+                                  (keep (fn [[path node]]\n+                                          (let [direct (cc3-stamp-site-id\n+                                                         (second (:operands node)))\n+                                                inner (kernel-routed-call? node)\n+                                                routed (when inner\n+                                                         (cc3-stamp-site-id\n+                                                           (first (:operands inner))))]\n+                                            (when-let [k (or direct routed)]\n+                                              [k [origin (:root tree) path]])))))\n+                            (cc3-walk (:ast compiled) [] []))]\n+    {:origin origin :tree tree :rows rows :marked marked\n+     :eligible eligible :binding stamped-sites}))\n+\n+\n+(deftest test-cc3-oracle-site-c1-binding\n+  ;; Bounds for this tagged run are recorded in the cc3 findings'\n+  ;; PREFLIGHT BOUNDS section before this test was first run:\n+  ;; 4,000,000 guest instructions and 1,000,000 trace records per C\n+  ;; lane, restated and not raised.\n+  (let [fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n+        compiled (kernel-compile fixture)]\n+    (is (= :compiled (:status compiled)))\n+    (let [{:keys [origin tree rows marked eligible binding]}\n+          (cc3-oracle-binding compiled)\n+          sites (:sites compiled)]\n+      (testing \"the admission coordinate is a recorded, validator-shaped origin\"\n+        (is (true? (vm/occurrence-origin? origin)))\n+        (is (= :program (nth origin 1)))\n+        (is (false? (vm/occurrence-origin? [:oracle/fixture :cc3-binding]))\n+            \"a fixture id alone is not a persisted origin\"))\n+      (testing \"coverage separation: the full C1 set is verified independently\"\n+        (is (= eligible marked)\n+            \"every final application occurrence carries exactly its marker\")\n+        (is (< (count binding) (count marked))\n+            \"uncredited helpers and generated applications are C1 occurrences but NOT oracle sites\"))\n+      (testing \"bijection: stamped guest sites <-> selected compiled occurrences\"\n+        (is (= (set (map :site sites)) (set (keys binding))))\n+        (is (= (count binding) (count (into #{} (vals binding))))\n+            \"no two sites share an occurrence (duplicate content keeps distinct paths)\")\n+        (is (every? marked (vals binding))\n+            \"every bound key is a validated post-expansion C1 occurrence\"))\n+      (testing \"Rule R: yin/def occurrences are marked but emit no call event\"\n+        (let [sem (linearize/project-rows tree nil rows)\n+              define-paths (into #{}\n+                                 (keep (fn [[pc _o _r p]]\n+                                         (when (= :define (first (nth (:vector sem) pc)))\n+                                           p)))\n+                                 (:provenance sem))\n+              call-keys (set (map (fn [[_ o r p]] [o r p])\n+                                  (:call-provenance sem)))]\n+          (is (seq define-paths))\n+          (is (every? (fn [k] (not (contains? call-keys k)))\n+                      (filter (fn [[_ _ p]] (contains? define-paths p)) marked))\n+              \"a :define occurrence never appears as a call-provenance key\")))\n+      (testing \"lowering: stack and register call pcs resolve to the same Ks\"\n+        (let [sem (linearize/project-rows tree nil rows)\n+              cp (:call-provenance sem)\n+              stack (derive/stack-image\n+                      (:vector sem) {:segment-address :seg/stack\n+                                     :call-provenance cp})\n+              register (derive/register-image\n+                         (:vector sem) {:segment-address :seg/register\n+                                        :call-provenance cp})\n+              sem-keys (set (map (fn [[_pc o r p]] [o r p]) cp))\n+              keys-of (fn [prov] (set (map (fn [[_ _ o r p]] [o r p]) prov)))]\n+          (is (= sem-keys (keys-of (:call-provenance stack))))\n+          (is (= sem-keys (keys-of (:call-provenance register))))))\n+      (testing \"both C lanes resolve each executed call to the identical K\"\n+        (let [lane-keys (fn [lane]\n+                          (let [row (kernel-c compiled lane)]\n+                            (is (= :completed (:status row)) (str lane))\n+                            (into #{}\n+                                  (comp (map #(nth % 2 nil))\n+                                        (filter integer?)\n+                                        (map (fn [k]\n+                                               (is (contains? binding k)\n+                                                   (str \"executed site \" k \" is bound\"))\n+                                               (get binding k))))\n+                                  (:executed-calls row))))]\n+          (is (= (lane-keys :c-walker) (lane-keys :c-semantic))))))))\ndiff --git a/test/yin/vm/semantic/derive_test.cljc b/test/yin/vm/semantic/derive_test.cljc\nindex 1b1e4112..0c5c7ad1 100644\n--- a/test/yin/vm/semantic/derive_test.cljc\n+++ b/test/yin/vm/semantic/derive_test.cljc\n@@ -827,3 +827,53 @@\n         nil)\n       (is (= (into [] (keep #(when (= :const (first %)) (peek %))) stack)\n              (into [] (keep #(when (= :const (first %)) (peek %))) register))))))\n+\n+\n+(deftest native-images-reconstruct-call-provenance\n+  ;; cc3 item 2: stack (new sequence) and register (layout-preserving)\n+  ;; images each map their call pcs back through their own derivation\n+  ;; to the semantic occurrence keys; images themselves never change.\n+  (let [src [:source :medium :batch 0]\n+        exp [:source :medium :batch 1]\n+        bc (vm/ast->semantic-bytecode worked-example)\n+        root (:root bc)\n+        apps (vm/application-occurrences bc)\n+        rows (mapv (fn [[r p]] [(if (= p []) src exp) r p :yang/call-site 1])\n+                   (sort-by second apps))\n+        sem (linearize/project-rows bc nil rows)\n+        v (:vector sem)\n+        cp (:call-provenance sem)\n+        stack (derive/stack-image v {:segment-address :seg/stack\n+                                     :call-provenance cp})\n+        stack-plain (derive/stack-image v)\n+        register (derive/register-image v {:segment-address :seg/register\n+                                           :call-provenance cp})\n+        register-plain (derive/register-image v)]\n+    (testing \"images are byte-identical to the provenance-free derivation\"\n+      (is (= (:image stack-plain) (:image stack)))\n+      (is (= (:instructions register-plain) (:instructions register))))\n+    (testing \"register: layout preserved, so call pcs are semantic pcs\"\n+      (is (= (mapv (fn [[pc o r p]] [:seg/register pc o r p]) cp)\n+             (:call-provenance register)))\n+      (doseq [[_ pc] (:call-provenance register)]\n+        (is (= :call (first (nth (:instructions register) pc))))))\n+    (testing \"stack: every semantic call key lands on a stack :call pc\"\n+      (is (= (count cp) (count (:call-provenance stack))))\n+      (is (= (set (map (fn [[_pc o r p]] [o r p]) cp))\n+             (set (map (fn [[_ _ o r p]] [o r p]) (:call-provenance stack)))))\n+      (doseq [[seg pc] (:call-provenance stack)]\n+        (is (= :seg/stack seg))\n+        (is (= :call (first (nth (:image stack) pc))))))\n+    (testing \"stack side-table gains :call diagnostics, old shapes intact\"\n+      (is (some (fn [[_ info]] (= :call (:kind info))) (:side-table stack)))\n+      (is (every? (fn [[_ info]] (contains? #{:closure :var :call} (:kind info)))\n+                  (:side-table stack))))\n+    (testing \"a provenance row naming a non-call pc refuses\"\n+      (let [non-call (first (keep-indexed (fn [pc t] (when (not= :call (first t)) pc)) v))]\n+        (is (= :call-provenance\n+               (try (derive/register-image\n+                      v {:segment-address :seg/register\n+                         :call-provenance [[non-call src root []]]})\n+                    nil\n+                    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n+                      (:rule (ex-data e))))))))))\ndiff --git a/test/yin/vm/semantic/linearize_test.cljc b/test/yin/vm/semantic/linearize_test.cljc\nindex 858bb380..96fbd29e 100644\n--- a/test/yin/vm/semantic/linearize_test.cljc\n+++ b/test/yin/vm/semantic/linearize_test.cljc\n@@ -1,5 +1,6 @@\n (ns yin.vm.semantic.linearize-test\n   (:require [clojure.test :refer [deftest is testing]]\n+            [dao.jing :as jing]\n             [yin.vm :as vm]\n             [yin.vm.parity-test :as parity]\n             [yin.vm.semantic :as sr]\n@@ -392,3 +393,78 @@\n          (throws-ex-data #(linearize/project-datoms\n                             [[-20 :yin/root true 0 :db/add]\n                              [-20 :yin/type :no/such 0 :db/add]])))))\n+\n+\n+(deftest call-provenance-resolves-per-occurrence-origins\n+  ;; cc3 item 1: a tree whose applications carry DIFFERENT validated\n+  ;; origins (one admitted, one expansion-generated) resolves each call\n+  ;; instruction to its own [origin root path]; an occurrence with no\n+  ;; validated row yields no entry; Rule R lowers to :define and yields\n+  ;; no fictitious call event; the vector/address never move.\n+  (let [src [:source :medium :batch 0]\n+        exp [:expansion (jing/segment-key [:cc3-test-record 1])]\n+        ast (app (v 'f) (app (v 'g) (v 'x)) (def! 'k (lit 1)))\n+        bc (vm/ast->semantic-bytecode ast)\n+        root (:root bc)\n+        apps (vm/application-occurrences bc)\n+        ;; the root application is admitted; every other application\n+        ;; occurrence is expansion-generated — never one blanket origin\n+        rows (mapv (fn [[r p]] [(if (= p []) src exp) r p :yang/call-site 1])\n+                   (sort-by second apps))\n+        plain (linearize/project-rows bc)\n+        resolved (linearize/project-rows bc nil rows)\n+        call-pcs (into [] (keep-indexed (fn [pc t] (when (= :call (first t)) pc)))\n+                       (:vector resolved))\n+        define-pcs (into [] (keep-indexed (fn [pc t] (when (= :define (first t)) pc)))\n+                         (:vector resolved))]\n+    (testing \"canonical invariance: provenance never moves code\"\n+      (is (= (:vector plain) (:vector resolved)))\n+      (is (= (:address plain) (:address resolved))))\n+    (testing \"every call pc resolves to its own occurrence's origin\"\n+      (is (seq call-pcs))\n+      (is (= (count call-pcs) (count (:call-provenance resolved))))\n+      (doseq [[pc origin r path] (:call-provenance resolved)]\n+        (is (= :call (first (nth (:vector resolved) pc))))\n+        (is (= root r))\n+        (is (= (if (= path []) src exp) origin)\n+            (str \"pc \" pc \" at \" (pr-str path) \" keeps its own origin\"))))\n+    (testing \"Rule R: the yin/def application emits :define, no call row\"\n+      (is (seq define-pcs))\n+      (is (not-any? (fn [[pc]] (contains? (set define-pcs) pc))\n+                    (:call-provenance resolved))))\n+    (testing \"absence, never invention: a missing row drops that call only\"\n+      (let [partial (linearize/project-rows bc nil (subvec rows 1))]\n+        (is (= (dec (count (:call-provenance resolved)))\n+               (count (:call-provenance partial)))))\n+      ;; a blanket caller origin never stamps call provenance: only\n+      ;; validated C1 rows do (the full :provenance table keeps the\n+      ;; caller-supplied origin, one row per pc)\n+      (is (= [] (:call-provenance (linearize/project-rows bc src))))\n+      (is (= [] (:call-provenance (linearize/project-rows bc)))))\n+    (testing \"refusals: conflicting, alien, and malformed rows throw\"\n+      (is (= :call-site-conflict\n+             (:rule (throws-ex-data\n+                      #(linearize/project-rows\n+                         bc nil (conj rows [exp root [] :yang/call-site 1]))))))\n+      (is (= :call-site-row\n+             (:rule (throws-ex-data\n+                      #(linearize/project-rows\n+                         bc nil [[src root [[9 9]] :yang/call-site 1]])))))\n+      (is (= :call-site-row\n+             (:rule (throws-ex-data\n+                      #(linearize/project-rows\n+                         bc nil [[src root [] :yang/call-site 2]])))))\n+      (is (= :call-site-row\n+             (:rule (throws-ex-data\n+                      #(linearize/project-rows\n+                         bc nil [[[:oracle/fixture 1] root [] :yang/call-site 1]]))))))))\n+\n+\n+(deftest datom-lane-provenance-names-entities-only\n+  ;; cc3 item 4 (restriction): the datom lane's provenance stays\n+  ;; [pc entity]; it carries NO occurrence key K. The entity->occurrence\n+  ;; bridge is D1's stated dependency, recorded in the cc3 findings —\n+  ;; this lane must not silently grow a half-bridge.\n+  (let [d (datom-lane (app (v 'f) (lit 1)))]\n+    (is (every? (fn [row] (= 2 (count row))) (:provenance d)))\n+    (is (not (contains? d :call-provenance)))))\n","exit_code":0,"status":"completed"}}
