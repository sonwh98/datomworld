  ;; a handle with no byte store (a stub publisher)\n   127\t                       ;; has nowhere to put a set; a backend failure is\n   128\t                       ;; a refusal, not a throw\n   129\t                       (if-not (:put-bytes-fn handle)\n   130\t                         acc\n   131\t                         (try (let [emit1 (fn [acc slot f]\n   132\t                                            (if-let [pub (when f\n   133\t                                                           (f handle (:address r)\n   134\t                                                              (:ast bundle)))]\n   135\t                                              (assoc-in acc [slot k] pub)\n   136\t                                              acc))]\n   137\t                                (-> acc\n   138\t                                    (emit1 :sites site-set)\n   139\t                                    (emit1 :binders binder-table)))\n   140\t                              (catch #?(:cljd Object :clj Exception :cljs :default) e\n   141\t                                (reduced\n   142\t                                  (refused (keyword refusal-ns \"site-set-unpublished\")\n   143\t                                           {:unit k,\n   144\t                                            :message (ex-message e)}))))))]\n   145\t            (if (= :refused (:status result))\n   146\t              (reduced (assoc result :unit (if (vector? step) (str (:name bundle)) step)))\n   147\t              (if (vector? step)\n   148\t                ;; a member alias holds no marks: the marks live in the\n   149\t                ;; bundle, so the bundle alone carries a site set and an\n   150\t                ;; alias import under a hook profile is refused as having none\n   151\t                (let [base (-> acc\n   152\t                               (assoc-in [:bundles (:name bundle)] (:address result))\n   153\t                               (emit (:name bundle) result))]\n   154\t                  (if (reduced? base)\n   155\t                    base\n   156\t                    (let [aliases (reduce (fn [a [n spec]]\n   157\t                                            (let [r (publish-fn\n   158\t                                                      handle (assoc spec :requires\n   159\t                                                                    {(:name bundle) (:address result)}))]\n   160\t                                              (if (= :refused (:status r))\n   161\t                                                (reduced (assoc r :unit n))\n   162\t                                                (assoc-in a [:addresses n] (:address r)))))\n   163\t                                          base\n   164\t                                          (map vector members (rest specs)))]\n   165\t                      (if (= :refused (:status aliases)) (reduced aliases) aliases))))\n   166\t                (-> acc\n   167\t                    (assoc-in [:addresses step] (:address result))\n   168\t                    (emit step result))))))\n   169\t        {:status :ok, :addresses {}, :bundles {}}\n   170\t        (:order plan)))))\n     1\t(ns yang.php.antlr.publication\n     2\t  \"P6 (docs/design/yang.php.md section 11): a set of compiled PHP units\n     3\t   published as linker modules. The ordering, SCC bundling and publish loop\n     4\t   are `yang.core.publication`'s; this namespace supplies the PHP hooks: the\n     5\t   includes `lower/imported-unit-names` folds, the `lower/module-spec` and\n     6\t   `lower/scc-module-specs` emitters, no site set and no binder table (the\n     7\t   PHP hook profile is P7).\n     8\t\n     9\t   A unit is `{:name path :packet p :strict-types b}`, `path` its normalized\n    10\t   relative path; the optional class map entry is `{:name \\\"$classmap\\\"\n    11\t   :classes {class path} :paths [path ...]}`. Name assertions stay the\n    12\t   linker's: this namespace publishes content, it signs nothing.\"\n    13\t  (:require\n    14\t    [yang.core.publication :as core]\n    15\t    [yang.php.antlr.lower :as lower]\n    16\t    [yin.vm.linker.publish :as publish]))\n    17\t\n    18\t\n    19\t(defn- class-map?\n    20\t  \"The autoload class map entry of a unit set, `{:name \\\"$classmap\\\" :classes\n    21\t   {class path} :paths [path ...]}`: it imports every path it lists, so it\n    22\t   publishes last and an unpublished path is refused by name (plan P6 R9).\"\n    23\t  [unit]\n    24\t  (= lower/classmap-name (:name unit)))\n    25\t\n    26\t\n    27\t(defn- config\n    28\t  [publish-fn]\n    29\t  {:imported-names (fn [{:keys [name packet], :as unit}]\n    30\t                     (if (class-map? unit)\n    31\t                       (lower/classmap-paths unit)\n    32\t                       (lower/imported-unit-names packet {:path name}))),\n    33\t   :module-spec (fn [registry {:keys [name packet strict-types], :as unit} php-address deps]\n    34\t                  (if (class-map? unit)\n    35\t                    (lower/classmap-spec registry unit php-address deps)\n    36\t                    (lower/module-spec registry packet\n    37\t                                       {:path name,\n    38\t                                        :strict-types strict-types,\n    39\t                                        :php-address php-address,\n    40\t                                        :deps deps}))),\n    41\t   :scc-module-specs lower/scc-module-specs,\n    42\t   :site-set nil,\n    43\t   :binder-table nil,\n    44\t   :refusal-ns \"yang.php\",\n    45\t   :publish-fn publish-fn})\n    46\t\n    47\t\n    48\t(defn publication-order\n    49\t  \"Dependency-first names, retaining the input order for acyclic units.\n    50\t   Cyclic components appear as sorted member vectors in :order, one\n    51\t   publication step per SCC. An include edge no unit and no `published`\n    52\t   entry supplies is refused `:yang.p