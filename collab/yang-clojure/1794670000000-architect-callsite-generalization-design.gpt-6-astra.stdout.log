e inverse of `ast->semantic-bytecode`.\n  1480\t\n  1481\t   Calls `validate-rows` first; a defect throws `ex-info` carrying its\n  1482\t   `:rule` and `:path` (or `:id`). Every reached row is then rebuilt, which\n  1483\t   still runs its own `:shape` and `:content-address` checks -- the address\n  1484\t   check is not a structural grammar rule (§7.5) and stays separate. Nothing\n  1485\t   is re-defaulted. A row reached through several parents is rebuilt once\n  1486\t   and shared.\"\n  1487\t  [{:keys [root rows], :as bc}]\n  1488\t  (when-let [{:keys [rule path id]} (validate-rows bc)]\n  1489\t    (throw (ex-info \"Semantic bytecode row set failed validation\"\n  1490\t                    (cond-> {:rule rule}\n  1491\t                      path (assoc :path path)\n  1492\t                      id (assoc :id id)))))\n  1493\t  (let [built (atom {})]\n  1494\t    (letfn\n  1495\t      [(defect\n  1496\t         [rule msg data]\n  1497\t         (throw (ex-info msg (assoc data :rule rule))))\n  1498\t       (child\n  1499\t         [kind id v]\n  1500\t         (case kind\n  1501\t           :node (build v)\n  1502\t           ;; as for :syms: projection mints a metadata-free vector\n  1503\t           :nodes (if (and (vector? v) (nil? (meta v)))\n  1504\t                    (mapv build v)\n  1505\t                    (defect :slot-kind\n  1506\t                      \"Semantic bytecode nodes slot is not a metadata-free vector\"\n  1507\t                      {:id id, :value v}))\n  1508\t           ;; projection always mints a metadata-free vector, so a vector\n  1509\t           ;; carrying metadata (which dao.jing hashes) could never re-project\n  1510\t           ;; to its own address\n  1511\t           :syms (if (and (vector? v) (nil? (meta v)) (every? symbol? v))\n  1512\t                   v\n  1513\t                   (defect :slot-kind\n  1514\t                     \"Semantic bytecode syms slot is not a metadata-free vector of symbols\"\n  1515\t                     {:id id, :value v}))\n  1516\t           :bool (if (or (true? v) (false? v))\n  1517\t                   v\n  1518\t                   (defect :slot-kind\n  1519\t                     \"Semantic bytecode bool slot is not true or false\"\n  1520\t                     {:id id, :value v}))\n  1521\t           v))\n  1522\t       (build\n  1523\t         [id]\n  1524\t         (if-let [node (get @built id)]\n  1525\t           node\n  1526\t           (let [row (get rows id)\n  1527\t                 _ (when (nil? row)\n  1528\t                     (defect :id-resolves\n  1529\t                       \"Semantic bytecode id resolves to no row\"\n  1530\t                       {:id id}))\n  1531\t                 _ (when-not (and (vector? row) (<= 2 (count row)))\n  1532\t                     (defect :shape\n  1533\t                       \"Semantic bytecode row is not [id tag & slots]\"\n  1534\t                       {:id id, :row row}))\n  1535\t                 body (subvec row 1)\n  1536\t                 _ (when-not (and (= id (first row))\n  1537\t                                  (jing/segment-matches? id body))\n  1538\t                     (defect :content-address\n  1539\t                       \"Semantic bytecode row id is not its content address\"\n  1540\t                       {:id id, :row row}))\n  2020\t\n  2021\t(defn compile-form\n  2022\t  \"Compile one Clojure form and retain the reader's plain metadata on the\n  2023\t   emitted Universal AST node. The tuple boundary removes it from content\n  2024\t   and writes positions and other frontend facts to occurrence side tables.\"\n  2025\t  ([form] (compile-form form false {} initial-macro-env))\n  2026\t  ([form env] (compile-form form false env initial-macro-env))\n  2027\t  ([form tail? env] (compile-form form tail? env initial-macro-env))\n  2028\t  ([form tail? env macro-env]\n  2029\t   (let [ast (compile-form* form tail? (dissoc env ::top-level) macro-env\n  2030\t                            (::top-level env))\n  2031\t         m (meta form)]\n  2032\t     (if (seq (dissoc m ::fn-loop))\n  2033\t       (vary-meta ast merge (dissoc m ::fn-loop))\n  2034\t       ast))))\n  2035\t\n  2036\t\n  2037\t(defn- top-level-defined-fns\n  2038\t  \"Plain symbols in `forms` whose top-level definitions are exclusively native\n  2164\t(defn compile-program\n  2165\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n  2166\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n  2167\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n  2168\t   with :macro? true on the lambda; the encoder turns that flag into a\n  2169\t   declaration row and the expander, not this compiler, recognizes calls.\n  2170\t   The three-argument form takes `opts` opting into the argument-vector\n  2171\t   convention (see `program-env`); without it the output is the native one.\"\n  2172\t  ([forms] (compile-program forms true))\n  2173\t  ([forms tail?] (compile-program forms tail? nil))\n  2174\t  ([forms tail? opts]\n  2175\t   (run! check-program-symbols! forms)\n  2176\t   (let [env (program-env forms opts)]\n  2177\t     ;; A discarded definition must not become a lexical binding in the\n  2178\t     ;; following definitions. Descriptor entry and body closures both capture\n  2179\t     ;; their environment: retaining the previous descriptor here doubles its\n  2180\t     ;; paths at each definition during machine-data validation and UCF lift.\n  2181\t     (letfn [(discard-result\n  2182\t               [ast]\n  2183\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n  2184\t             (go\n  2185\t               [forms macro-env]\n  2186\t               (if (empty? forms)\n  2187\t                 (compile-literal nil tail?)\n  2188\t                 (let [head       (cond->> (first forms)\n  2189\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\n  2190\t                                    (outcomes? env) (lower-top-form env macro-env))\n  2191\t                       rest-forms (rest forms)]\n  2192\t                   (cond\n  2193\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n  2194\t                     ;; lambda the encoder declares; later forms see the name\n  2195\t                     ;; only so the native defn lowering can yield to it.\n  2196\t                     (and (seq? head) (= 'defmacro (first head)))\n  2197\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n  2198\t                       (cond-> {:type     :application\n  2199\t                                :operator {:type :lambda, :params ['_]\n  2200\t                                           :body (go rest-forms\n  2839\t(defn compile\n  2840\t  \"Main compiler entry point.\n  2841\t\n  2842\t  Compiles a Clojure form into Yin VM Universal AST.\n  2843\t\n  2844\t  Examples:\n  2845\t    (compile 42)\n  2846\t    => {:type :literal, :value 42}\n  2847\t\n  2848\t    (compile '(+ 1 2))\n  2849\t    => {:type :application\n  2850\t        :operator {:type :variable, :name +}\n  2851\t        :operands [{:type :literal, :value 1}\n  2852\t                   {:type :literal, :value 2}]}\n  2853\t\n  2854\t    (compile '(fn [x] (* x 2)))\n  2855\t    => {:type :lambda\n  2856\t        :params [x]\n  2857\t        :body {:type :application\n  2858\t               :operator {:type :variable, :name *}\n  2859\t               :operands [{:type :variable, :name x}\n  2860\t                          {:type :literal, :value 2}]}}\"\n  2861\t  [form]\n  2862\t  (compile-form form true {}))\n  2863\t\n  2864\t\n  2865\t;; =============================================================================\n  2866\t;; The linked runtime entry (the conformance matrix round, yang.antlr.md\n  2867\t;; section 8.10)\n  2868\t;; =============================================================================\n  2869\t;;\n  2870\t;; A linked clojure program is published as an ordinary linker module whose\n  2871\t;; one export, `body`, is its unmodified lowered unit, and run under its own\n  2872\t;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\n  2873\t;; `read-forms` is the frontend's parser — the reader itself — and\n  2874\t;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n  2875\t;; whose call runs the program compiled under the argument-vector\n  2876\t;; convention and the outcome model over the guest library, with every\n  2877\t;; top-level definition published to the runtime global namespace\n  2878\t;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n  2879\t;; its module's globals. No call node is rewritten and no foreign\n  2880\t;; `:code` is extracted: the unit is the program's own lowering,\n  2881\t;; wrapped.\n  2882\t\n  2883\t(def unit-opts\n  2884\t  \"The `compile-program` opts a linked unit compiles with: the\n  2885\t   argument-vector convention with the outcome model over the guest\n  2886\t   library's adapters, every VM primitive callable directly by bare name.\"\n  2887\t  {:convention :arg-vector,\n  2888\t   :outcomes true,\n  2889\t   :adapters library-adapters,\n  2890\t   :native vm/primitive-profiles})\n  2891\t\n  2892\t\n  2893\t(def top-defining-operators\n  2894\t  \"The operators whose second element names a top-level definition.\"\n  2895\t  '#{def defn defn- defmacro})\n  2896\t\n  2897\t\n  2993\t(defn lower-unit\n  2994\t  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n  2995\t   thunk whose call runs the program — `forms` plus the definitions of\n  2996\t   the guest library they need, compiled unmodified under `unit-opts`\n  2997\t   and published to the runtime global namespace by\n  2998\t   `publish-to-globals` — so the helper's export projection can read\n  2999\t   each top-level definition. The two-argument form also takes the\n  3000\t   projected `exports` (names the composition already bound in the\n  3001\t   runtime global namespace): their free reads publish the same way, so\n  3002\t   the projection is the caller's binding for them. The program's own\n  3003\t   `yang.call` call sites need no free-name declaration: the convention\n  3004\t   preamble `compile-program` emits defines those names locally, and\n  3005\t   the donor publication pins the `yang.call` module for the qualified\n  3006\t   reads that remain.\"\n  3007\t  ([forms] (lower-unit forms []))\n  3008\t  ([forms exports]\n  3009\t   (let [source (vec forms)\n  3010\t         library (library-for source)\n  3011\t         program (compile-program (concat source library) true unit-opts)\n  3012\t         macros (into #{}\n  3013\t                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n  3014\t                            (map (comp strip-symbol-meta second)))\n  3015\t                      (concat source library))\n  3016\t         names (reduce disj\n  3017\t                       (into (set (top-level-names source))\n  3018\t                             (concat (map (comp strip-symbol-meta second) library)\n  3019\t                                     (map symbol exports)))\n  3020\t                       macros)]\n  3021\t     (u/lam [] (publish-to-globals program names #{})))))\n  3022\t\n  3023\t\n  3024\t(defn output\n  3025\t  \"The `clj/run-main` value as test data.\"\n  3026\t  [value]\n  3027\t  (pr-str value))\n","exit_code":0,"status":"completed"}}
