n    13\t  (:require [dao.jing :as jing]\n    14\t            [yang.core.publication :as core]\n    15\t            [yang.python.antlr.lower :as lower]\n    16\t            [yang.python.antlr.siteset :as siteset]\n    17\t            [yin.vm.linker.publish :as publish]))\n    18\t\n    19\t\n    20\t(defn- unit-imports\n    21\t  \"The Python modules unit `u` statically imports.\"\n    22\t  [{:keys [name package? packet]}]\n    23\t  (lower/imported-module-names packet\n    24\t                               {:name name, :package? (boolean package?)}))\n    25\t\n    26\t\n    27\t(defn- config\n    28\t  [publish-fn call-address]\n    29\t  {:imported-names unit-imports,\n    30\t   :module-spec (fn [registry {:keys [name package? packet]} py-address deps]\n    31\t                  (lower/module-spec registry packet\n    32\t                                     {:name name, :package? package?,\n    33\t                                      :py-address py-address, :call-address call-address,\n    34\t                                      :deps deps})),\n    35\t   :scc-module-specs (fn [registry units py-address deps]\n    36\t                       (lower/scc-module-specs registry units py-address call-address deps)),\n    37\t   :site-set siteset/publish!,\n    38\t   :binder-table nil,\n    39\t   :refusal-ns \"yang.python.antlr\",\n    40\t   :publish-fn publish-fn})\n    41\t\n    42\t\n    43\t(defn publication-order\n    44\t  \"Dependency-first names, retaining the I3 order for acyclic units.\n    45\t   Cyclic components appear as sorted member vectors in :order, one\n    46\t   publication step per SCC. External imports must be in `published`.\"\n    47\t  [units published]\n    48\t  (core/publication-order (config publish/publish-module! nil) units published))\n    49\t\n    50\t\n    51\t(defn publish-units!\n    52\t  \"Publish `units` (`[{:name :package? :packet}]`) into the content store\n    53\t   `handle` over the host registry `registry`, `py` pinned at\n    54\t   `py-address` and each import outside the set at its address in\n    55\t   `published` ({python-name address}), in `publication-order`. Answers\n    56\t   `{:status :ok :addresses {python-name address}\n    57\t     :bundles {bundle-symbol address}\n    58\t     :sites {python-name-or-bundle-symbol site-publication}}` for the units\n    59\t   of the set (`siteset/publish!`'s answer for each module published beside\n    60\t   its code image, I7; an SCC member alias carries no marks and so no\n    61\t   entry, its bundle does). The publisher that asserts these names\n    62\t   indexes `siteset/signed-entries` of `:sites` in the same index\n    63\t   transaction; a module whose entry is missing is refused by every\n    64\t   hook-profile reader. Or the\n    65\t   first refusal: `publication-order`'s before anything is written, else\n    66\t   `publish-module!`'s with a string `:unit`: the Python name for a member,\n    67\t   or the bundle module name for an SCC bundle. Every bundle name must be\n    68\t   asserted/bound alongside the member names for aliases to deliver.\n    69\t   Optional `publish-fn` takes `[handle spec]`, defaulting to\n    70\t   `publish/publish-module!`, for both bundles and members.\"\n    71\t  ([handle registry py-address units]\n    72\t   (publish-units! handle registry py-address units {}))\n    73\t  ([handle registry py-address units published]\n    74\t   (publish-units! handle registry py-address units published publish/publish-module!))\n    75\t  ([handle registry py-address units published publish-fn]\n    76\t   (let [py-manifest (when (and handle py-address)\n    77\t                       (jing/get handle py-address nil))\n    78\t         call-address (get-in py-manifest [:yin.module/requires 'yang.call])]\n    79\t     (core/publish-units! (config publish-fn call-address)\n    80\t                          handle registry py-address units published))))\n","exit_code":0,"status":"completed"}}
