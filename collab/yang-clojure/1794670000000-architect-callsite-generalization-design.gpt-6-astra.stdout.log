\n    22\t  (packet/byte-offsets cps))\n    23\t\n    24\t\n    25\t(defn offset-at\n    26\t  [offsets i]\n    27\t  (nth offsets (max 0 (min i (dec (count offsets))))))\n    28\t\n    29\t\n    30\t(defn token-span\n    31\t  \"The byte span of a token's code point range [start, stop]; a token whose\n    32\t   stop precedes its start is zero-width.\"\n    33\t  [offsets start stop]\n    34\t  (let [s (offset-at offsets start)]\n    35\t    [s (if (< stop start) s (offset-at offsets (inc stop)))]))\n    36\t\n    37\t\n    38\t(defn syntax-error\n    39\t  [message line column span]\n    40\t  {:kind :syntax-error, :message (str message), :line line, :column column,\n    41\t   :span span})\n    42\t\n    43\t\n    44\t(defn- synthetic-token?\n    45\t  \"Whether a token is synthetic, decided on its type by\n    46\t   `packet/synthetic-policy`. DEDENT and EOF always are. A NEWLINE is only\n    47\t   when the source disagrees with the helper (its text is not the source at\n    48\t   its range, or its range overlaps the previous real token) and it sits at\n    49\t   the end of the source; every other type is never synthetic, so a token\n    50\t   the policy forbids stays real and the validator rejects its text.\"\n    51\t  [cps offsets last-stop {:keys [type-name start stop text]}]\n    52\t  (let [n (dec (count offsets))\n    53\t        policy (get packet/synthetic-policy type-name)]\n    54\t    (case (:when policy)\n    55\t      :always true\n    56\t      :at-end (and (or (not= (when (and (<= 0 start) (<= start stop) (< stop n))\n    57\t                               (subvec cps start (inc stop)))\n    58\t                             (some-> text packet/code-points))\n    59\t                       (<= start last-stop))\n    60\t                   (>= stop (dec n)))\n    61\t      false)))\n    62\t\n    63\t\n    64\t(defn- token-record\n    65\t  \"`last-stop` is the stop index of the previous real token: a NEWLINE that\n     1\t;; Per-deftest exclus