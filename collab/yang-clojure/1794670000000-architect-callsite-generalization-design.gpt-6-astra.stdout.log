 record and the set are\n    22\t   fetched by address and verified against it.\n    23\t\n    24\t   A consumer under a profile requiring hooks `admit`s an import: it\n    25\t   verifies every pin against the published code root and refuses a\n    26\t   missing, empty or mismatched set, naming the profile and the set.\n    27\t   `stage` then applies a verified set at link time, as the linker\n    28\t   composition's `:stage`: it derives the instrumented module `A'` from the\n    29\t   published tree alone, bottom-up over the module's guest requirements,\n    30\t   and publishes it beside its `:derive` record. An explicitly noninterruptible profile imports the module\n    31\t   as published, with none.\"\n    32\t  (:require [dao.jing :as jing]\n    33\t            [yang.python.antlr.lower :as lower]\n    34\t            [yang.safepoint :as safepoint]\n    35\t            [yin.vm :as vm]\n    36\t            [yin.vm.encoder :as encoder]\n    37\t            [yin.vm.linker.publish :as publish]\n    38\t            [yin.vm.linker.sign :as sign]))\n    39\t\n    40\t\n    41\t(def frontend-revision\n    42\t  \"The frontend revision the marks are pinned to: it moves with any change\n    43\t   to which nodes the Python lowering marks, or how.\"\n    44\t  \"yang.python.antlr.lower/sites-1\")\n    45\t\n    46\t\n    47\t(def lowering-profile\n    48\t  \"The transformation profile the marks were made under: the module\n    49\t   emitter over the linked prelude, marking these kinds.\"\n    50\t  {:yang.site/unit :module,\n    51\t   :yang.site/prelude :linked,\n    52\t   :yang.site/kinds [:call :line :loop]})\n    53\t\n    54\t\n    55\t(def profile-address\n    56\t  \"The address the transformation profile is pinned by.\"\n    57\t  (jing/segment-key lowering-profile))\n    58\t\n    59\t\n    60\t(defn- medium\n    61\t  []\n    62\t  :yang.python.antlr/site-set)\n    63\t\n    64\t\n    65\t(defn site-set-of\n    66\t  \"`{:root address :tree tree :set [[path mark] ...]}` for the module map\n    67\t   AST `ast`: the address of its canonical tree, the tree's rows and its\n    68\t   sorted site set.\"\n    69\t  [ast]\n    70\t  (let [env (encoder/project (encoder/source-envelope\n    71\t                               (medium) [:site-set 0] [ast]))\n    72\t        tree (nth (:yin/batch env) (:yin/root env))\n    73\t        origin (vm/source-origin (:yin/source-medium env)\n    74\t                                 (:yin/batch-token env) (:yin/root env))\n    75\t        sites (safepoint/sites (:yin/frontend-metadata env) origin (:root tree))]\n    76\t    {:root (:root tree), :tree tree, :set (safepoint/site-set sites)}))\n    77\t\n    78\t\n    79\t(defn record\n    80\t  \"The publication record associating manifest `manifest` with site set\n    81\t   `set-address` over code root `root`.\"\n    82\t  [manifest root set-address]\n    83\t  {:yang.site/manifest manifest,\n    84\t   :yang.site/root root,\n    85\t   :yang.site/revision frontend-revision,\n    86\t   :yang.site/profile profile-address,\n    87\t   :yang.site/set set-address})\n    88\t\n    89\t\n    90\t(defn publish!\n    91\t  \"Publish the site set of module `ast` (published at manifest address\n    92\t   `manifest`) into `handle`: the set as one blob, then its record. Answers\n    93\t   `{:record r :record-address a :set-address s :set [...]}`.\"\n    94\t  [handle manifest ast]\n    95\t  (let [{:keys [root set]} (site-set-of ast)\n    96\t        set-address (jing/materialize! handle (vec set))\n    97\t        r (record manifest root set-address)]\n    98\t    {:record r,\n    99\t     :record-address (jing/materialize! handle r),\n   100\t     :set-address set-address,\n   101\t     :set set}))\n   102\t\n   103\t\n   104\t(defn- read-at\n   105\t  \"The value at `address` in `handle`: `::absent` when the handle holds no\n   106\t   bytes for a segment address (the handle is asked with a not-found\n   107\t   sentinel, as a byte store is), nil when `address` is no segment address\n   108\t   or its bytes do not hash to it, else the value.\"\n   109\t  [handle address]\n   110\t  (if-not (jing/segment-address? address)\n   111\t    nil\n   112\t    (let [bs ((:get-bytes-fn handle) address ::absent)]\n   113\t      (cond\n   114\t        (= ::absent bs) ::absent\n   115\t        (nil? bs) ::absent\n     1\t;; Generator of test/resources/yang/python/dht-import-v1.edn.\n     2\t;;\n     3\t;; Provenance: the JVM publication of C4 slice I3's DHT import\n     4\t;; (yang.python.antlr.dht-import-fixture). Run from the repository root\n     5\t;; on the JVM, with the test paths on the classpath, to rewrite the\n     6\t;; artifact:\n     7\t;;\n     8\t;;   clojure -Sdeps '{:aliases {:t {:extra-paths [\"test\"]}}}' -M:t \\\n     9\t;;    test/resources/yang/python/dht-import-v1.generate.clj\n    10\t;;\n    11\t;; (not -A:test: that alias's main is the test runner and runs the suite)\n    12\t;;\n    13\t;; It publishes the committed CST packets of the guest units through\n    14\t;; `yang.python.antlr.publication` against `py` as the JVM publishes it,\n    15\t;; signs the name envelopes with the fixture's fixed test seeds, and\n    16\t;; writes the guest blobs, the manifest addresses, the envelopes and the\n    17\t;; importer packets. Every input is checked in, and Ed25519 signatures are\n    18\t;; deterministic, so a rerun on an unchanged tree rewrites the same data.\n    19\t;; Rerun it whenever the prelude, the lowering or the linker's\n    20\t;; publication moves an address; `dht-import-test` fails until it is.\n    21\t\n    22\t(require '[yang.python.antlr.dht-import-fixture :as fixture])\n    23\t\n    24\t\n    25\t(let [{:keys [lines refused]} (fixture/generate)]\n    26\t  (when refused\n    27\t    (throw (ex-info \"the artifact's publication was refused\" refused)))\n    28\t  (spit fixture/path (fixture/text lines))\n    29\t  (println \"wrote\" fixture/path))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^'\"\\\\(defn|:clojure|:python|:typescript|:php|publication|compile-program' src/cljc/yin/repl/frontends.cljc | head -95; rg --files test | rg '(jolt|conformance)' | head -50; rg -n 'version|attribution|trace' test/yang/latte_oracle/slice9_gate.md | head -25; nl -ba collab/yang-clojure/1794630000000-architect-attribution-addendum-a-RECORD.md | head -65\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^'\"\\\\(defn|:clojure|:python|:typescript|:php|publication|compile-program' src/cljc/yin/repl/frontends.cljc | head -95; rg --files test | rg '(jolt|conformance)' | head -50; rg -n 'version|attribution|trace' test/yang/latte_oracle/slice9_gate.md | head -25; nl -ba collab/yang-clojure/1794630000000-architect-attribution-addendum-a-RECORD.md | head -65\"","aggregated_output":"24:(defn- manifest\n39:(defn- clojure-lower\n43:    (yang.clojure/compile-program forms)))\n46:(defn- antlr-manifest\n48:  (assoc (manifest :yang/python :python)\n57:(defn standard\n65:    true (frontend/install (manifest :yang/clojure :clojure)\n69:    true (frontend/install (manifest :yang/php :php)\n113:(defn create-state\ntest/dao/space/datomic_query_conformance_test.cljc\ntest/dao/jing/cbor_conformance_test.cljc\ntest/dao/stream/conformance.cljc\ntest/yang/call/conformance.clj\ntest/resources/yin/repl/jolt-applicability.edn\ntest/dao/host/conformance_test.cljc\ntest/yang/antlr/conformance.cljc\ntest/yang/python/antlr/fixtures/jolt_j0c_corpus.edn\ntest/yang/python/antlr/fixtures/jolt_j0c_input_oracle.edn\ntest/yang/python/antlr/fixtures/jolt_j0c_oracle.edn\ntest/yang/python/antlr/fixtures/jolt_j0c_input_corpus.edn\n18:remain uncredited. The declared departures are carried by the versioned\n108:credited the deliberately uncalled arity and accepted missing C-lane traces.\n109:It now requires both traces and leaves unused arities uncredited. A second\n112:pass; both C traces record `parse/2` and no `parse/1`, and the counter leaves\n146:the two raw C traces. Kondo reports zero errors and warnings. The full oracle\n156:digest, runtime, instruction budget, per-fixture outcomes, diagnostic traces,\n     1\tCreated-GMT: 2026-11-05 04:30:00 GMT (v1)\n     2\tRevised-GMT: 2026-11-06 02:30:00 GMT (v2 — astra's four amendments)\n     3\tRevised-GMT: 2026-11-06 03:20:00 GMT (v3 — qwen3.8-max's four amendments; both reviews endorse for owner signature)\n     4\tStatus: ADDENDUM A v3 to the signed attribution-as-query ruling — SIGNED by the owner (2026-11-06, sign-off after the astra + qwen3.8-max reviews; both endorse)\n     5\t# ADDENDUM A (SIGNED) — call-site annotation generalizes: every yang.* compilation pipeline preserves caller-site provenance\n     6\t\n     7\t## The owner's directive (recorded)\n     8\t\n     9\t\"the other compilers must also add more information to the compilation pipeline by annotating the callsite.\" Caller-site provenance — caller-site identity at post-expansion UAST application occurrences — is the declared standard for every yang.* frontend. The oracle's instantiation is the first consumer; the other frontends' adoption is scheduled direction.\n    10\t\n    11\t## A1 — The annotation attaches to UAST application OCCURRENCES; no canonical node field\n    12\t\n    13\tThe existing architecture defines a call site as `[origin root-address path]` and **excludes provenance from hashed code content** (docs/design/yin.vm.code-as-tuples.md ~:659); occurrence side tables and instruction-provenance mappings already exist. Ruling: every frontend preserves caller-site provenance for post-expansion UAST application **occurrences** through a shared, language-neutral occurrence contract; the design round starts from the existing occurrence and instruction-provenance relations. **The contract must define what occupies the `origin` coordinate in EPHEMERAL instrumentation**: post-expansion occurrences carry origin `[:expansion record-address]` (code-as-tuples.md ~:426), and the oracle's harness-level stamping mints no expansion records — its site ids are occurrence-key-shaped stand-ins, not persisted keys; the shared contract names the stand-in or it is shared in name only. The design round also cites **§2.6 (owner ruling 2026-09-15, code-as-tuples.md ~:470)** — runtime `assoc` into walker map nodes is legal because the held node is an ephemeral image never projected back; that is the clause licensing the oracle's stamping, and it must be on the record before someone flags it as a boundary violation. And the likely minimal form is named as the starting point (not mandated): **one reserved key in the EXISTING frontend-metadata side table** `[origin root-address path key value]` (code-as-tuples.md ~:445-455) for persisted artifacts, plus the 3-vector trace field for ephemeral tracing — the design round may find the \"contract\" is one key and one field. **This addendum does not authorize a new canonical AST slot** — any such proposal requires explicit justification and amendment of the occurrence/content boundary.\n    14\t\n    15\t## A2 — Versioning obligations are separated, and inventoried before anything is revised\n    16\t\n    17\tEvidence schemas, lowering profiles, execution contracts, and module-manifest schemas have **distinct revision rules** (docs/design/yin.vm.linker.md ~:1871; lowering profiles at code-as-tuples.md ~:861); existing machinery detects incompatibility but does not migrate artifacts. The design round must inventory: affected producers, validators, lowering and reconstruction paths, derivation verification, publication, persisted artifacts, and mismatch behavior — and revise only the contracts actually changed. NAMED so they are not skipped: **per-host prelude publication artifacts** (php/python/typescript publication.cljc, prelude_module/prelude_p9 — annotating production compilation means republished prelude artifacts on all four host lanes: the single largest persisted-artifact blast radius); **the oracle's own checked-in EDN evidence schemas** (throw_sites.edn, case_arms.edn — they are evidence schemas too); and the **backward-compat policy**: unannotated persisted artifacts remain loadable (side tables are additive) — stated, or it is re-litigated later.\n    18\t\n    19\t## A3 — Adoption coverage and host verification are explicit\n    20\t\n    21\tAdoption covers **production `yang.clojure`** (oracle instrumentation does not establish coverage of ordinary compilation paths), TypeScript, PHP, and Python, with additional entry points inventoried during design. Each frontend has an acceptance gate; the host lanes are a MANDATORY set per frontend (JVM, Node, Dart, Jolt as applicable — \"applicable\" alone is a loophole that lets a frontend ship under the easiest lane), plus a **cross-host occurrence-key equality gate**: the same source compiled on JVM/Node/Dart must yield identical occurrence coordinates, or the shared contract breaks. One ordering sentence against the in-flight work: the frontend adoption rounds sequence AFTER the in-flight cell-ref sweeps and the J2 re-run land (they revise the same prelude/publication files); the oracle round is unaffected. Current sweeps, the J2 re-run, and the oracle round continue under their existing scopes. The oracle's instantiation is described as **oracle-specific instrumentation** (its signed scope already permits walker changes) — not as production coverage.\n    22\t\n    23\t## A4 — R1 activates at signature; the dependency is precise\n    24\t\n    25\tBy signing this addendum, the owner **activates R1's deferred work** — no shipped second consumer is required. The design round specifies the durable correspondence record, and it **REUSES THE ORACLE EVIDENCE FORMAT VERBATIM** (the base ruling's R1(b) already demands the site tables be in that format — the durable record binds to it, it does not merely relate to it; two rounds independently fixing \"the stable, versioned evidence format\" is a textbook race). Implementation and independent reconstruction complete **BEFORE acceptance of the first additional consumer that relies on it** — \"or atomically with\" is struck: reliance is accepted only after independent verification has passed (the linker's own `:verifying` policy). The oracle round remains unblocked.\n    26\t\n    27\t## Design-round obligations (declared)\n    28\t\n    29\tMeasure: application counts, provenance and trace sizes, peak trace occupancy, instruction overhead, compilation/loading/query time, and memory. Separate static annotation costs from runtime tracing costs; declare bounds before tagged runs. Correctness gates: duplicate occurrences, macro expansion, helper calls, indirect and tail calls, and applicable suspension/resumption paths.\n    30\t\n    31\t## Boundaries\n    32\t\n    33\tThe signed ruling's R1-R7 stand as written. The in-flight sweeps (cell-ref, ts/php/python), the jolt J2 re-run, and the oracle round are unaffected. Budget impact per frontend is a design-round deliverable, not assumed here.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/frontends.cljc | sed -n '1,115p'; nl -ba src/cljc/yang/antlr/export.cljc | head -65; nl -ba test/resources/yin/repl/jolt-applicability.edn | head -70; nl -ba test/yang/antlr/conformance.cljc | head -75; rg -n 'publish|def published' test/yang/{php,python}/antlr/linked_harness.cljc | head -30; nl -ba src/jolt/yang/antlr/cst.jolt | head -40\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/frontends.cljc | sed -n '1,115p'; nl -ba src/cljc/yang/antlr/export.cljc | head -65; nl -ba test/resources/yin/repl/jolt-applicability.edn | head -70; nl -ba test/yang/antlr/conformance.cljc | head -75; rg -n 'publish|def published' test/yang/{php,python}/antlr/linked_harness.cljc | head -30; nl -ba src/jolt/yang/antlr/cst.jolt | head -40\"","aggregated_output":"     1\t(ns yin.repl.frontends\n     2\t  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n     3\t   8.5.6, slice F2): the hand-written Clojure and PHP frontends and the\n     4\t   ANTLR Python frontend installed into a `yang.frontend` catalog. This is\n     5\t   the only place the REPL composition names a language's namespace;\n     6\t   `yin.repl` core steps whatever binding the catalog selects.\n     7\t\n     8\t   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n     9\t   `:input :forms` when the frontend consumes the forms the shell reader\n    10\t   already read, else the source text.\"\n    11\t  (:require\n    12\t    [yang.clojure :as yang.clojure]\n    13\t    [yang.frontend :as frontend]\n    14\t    [yang.php :as yang.php]\n    15\t    #?@(:cljd [[yang.python.antlr.repl :as python.antlr.repl]\n    16\t               [yang.python.antlr.parser :as python.antlr.parser]\n    17\t               [yang.python.antlr.repl-probe :as python.antlr.probe]]\n    18\t        :default [[yang.python.antlr.repl :as python.antlr.repl]\n    19\t                  [yang.python.antlr.parser :as python.antlr.parser]\n    20\t                  [yang.python.antlr.repl-probe :as python.antlr.probe]])\n    21\t    [yin.repl :as repl]))\n    22\t\n    23\t\n    24\t(defn- manifest\n    25\t  [id language]\n    26\t  {:yang.frontend/id id,\n    27\t   :yang.frontend/spi 1,\n    28\t   :yang.frontend/revision \"legacy-1\",\n    29\t   :yang.frontend/language language,\n    30\t   :yang.frontend/grammar {:yang.grammar/package \"none\",\n    31\t                           :yang.grammar/entries {:module \"program\"},\n    32\t                           :yang.grammar/export-profile :yang.cst/v1},\n    33\t   :yang.frontend/options-schema :segment/none,\n    34\t   :yang.frontend/lowering-profile :segment/legacy,\n    35\t   :yang.frontend/runtime-profile :segment/legacy,\n    36\t   :yang.frontend/support-profile :segment/legacy})\n    37\t\n    38\t\n    39\t(defn- clojure-lower\n    40\t  [forms]\n    41\t  (if (= 1 (count forms))\n    42\t    (yang.clojure/compile (first forms))\n    43\t    (yang.clojure/compile-program forms)))\n    44\t\n    45\t\n    46\t(defn- antlr-manifest\n    47\t  []\n    48\t  (assoc (manifest :yang/python :python)\n    49\t         :yang.frontend/revision \"f4\"\n    50\t         :yang.frontend/grammar\n    51\t         {:yang.grammar/package \"python3\",\n    52\t          :yang.grammar/entries {:module \"file_input\"},\n    53\t          :yang.grammar/export-profile :yang.cst/v1,\n    54\t          :yang.grammar/targets #{:java :javascript :dart}}))\n    55\t\n    56\t\n    57\t(defn standard\n    58\t  \"The standard catalog. The Clojure frontend consumes the forms the\n    59\t   shell's own reader read, so its parse stage is the identity.  The ANTLR\n    60\t   frontend is the Python frontend, installed on every host, each running\n    61\t   its own generated target of the one grammar.  It shows what a submission\n    62\t   printed and the value rendered by its `:render` (Python repr).\"\n    63\t  []\n    64\t  (cond-> frontend/empty-catalog\n    65\t    true (frontend/install (manifest :yang/clojure :clojure)\n    66\t                           {:input :forms,\n    67\t                            :parse identity,\n    68\t                            :lower clojure-lower})\n    69\t    true (frontend/install (manifest :yang/php :php)\n    70\t                           {:parse identity, :lower yang.php/compile})\n    71\t    #?@(:cljd [true (frontend/install\n    72\t                      (antlr-manifest)\n    73\t                      {:parse (fn [source]\n    74\t                                (python.antlr.parser/parse-source (str source \"\\n\"))),\n    75\t                       :lower python.antlr.repl/lower,\n    76\t                       :primitives python.antlr.repl/primitives,\n    77\t                       :lower-session python.antlr.repl/lower-session,\n    78\t                       :render python.antlr.repl/display-value,\n    79\t                       :probe python.antlr.probe/probe})]\n    80\t        ;; jolt (J5): installed over the C++ parser when native/jolt-parser\n    81\t        ;; is available; otherwise left out, so (lang :yang/python) answers\n    82\t        ;; unavailable-parser, never another parser\n    83\t        :jolt [(python.antlr.parser/available?)\n    84\t               (frontend/install\n    85\t                 (antlr-manifest)\n    86\t                 {;; a :parser-budget or :unavailable-parser refusal names\n    87\t                  ;; the language it refused\n    88\t                  :parse (fn [source]\n    89\t                           (try (python.antlr.parser/parse-source (str source \"\\n\"))\n    90\t                                (catch Exception e\n    91\t                                  (if (#{:parser-budget :unavailable-parser}\n    92\t                                       (:diagnostic (ex-data e)))\n    93\t                                    (throw (ex-info (ex-message e)\n    94\t                                                    (assoc (ex-data e) :lang :yang/python)\n    95\t                                                    e))\n    96\t                                    (throw e))))),\n    97\t                  :lower python.antlr.repl/lower,\n    98\t                  :primitives python.antlr.repl/primitives,\n    99\t                  :lower-session python.antlr.rep