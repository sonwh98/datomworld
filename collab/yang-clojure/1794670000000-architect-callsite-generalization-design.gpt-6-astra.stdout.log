  53\t                  (case (first t)\n    54\t                    :load-bound (into [:bound] (subvec t (- (count t) 2)))\n    55\t                    :load-free [:free (peek t)]\n    56\t                    nil)))\n    57\t          v)))\n    58\t\n    59\t\n    60\t(defn stack-image\n    61\t  \"Stackify A's parsed expressions, placing closure bodies in FIFO order.\n    62\t   Labels and diagnostics are derived solely from A.\"\n    63\t  [v]\n    64\t  (let [{rv :vector bodies :bodies} (resolve v)\n    65\t        by-start (into {} (map (juxt :start identity)) bodies)\n    66\t        image (volatile! [])\n    67\t        side (volatile! {})\n    68\t        labels (volatile! {})\n    69\t        queue (volatile! [])\n    70\t        counter (volatile! 0)\n    71\t        label! (fn [] (vswap! counter inc))\n    72\t        mark! (fn [l] (vswap! labels assoc l (count @image)))\n    73\t        emit! (fn [t] (vswap! image conj t))]\n    74\t    (letfn [(walk\n    75\t              [node]\n    76\t              (let [pc (:pc node)\n    77\t                    [op _ x y z] (nth rv pc)\n    78\t                    children (:children node)\n    79\t                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n    80\t                (case (:op node)\n   150\t                      [free next-slot slots] starts)]\n   151\t          (recur (inc pc) (into active starts) free next-slot slots))))))\n   152\t\n   153\t\n   154\t(defn register-image\n   155\t  \"Allocate temporaries by linear scan over A's live points; preserve A's\n   156\t   layout and fill saved windows using the register format's liveness.\"\n   157\t  [v]\n   158\t  (let [{rv :vector bodies :bodies} (resolve v)\n   159\t        a (analysis/analyze v)\n   160\t        allocations (mapv #(allocation v a %) bodies)\n   161\t        instructions\n   162\t        (mapv (fn [pc t]\n   163\t                (let [{:keys [slots locals structural]}\n   164\t                      (nth all