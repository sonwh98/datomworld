path)])\n   135\t           :stream/next (emit! id path\n   136\t                               [:stream-next d (child id :source path)])\n   137\t           :stream/close (emit! id path\n   138\t                                [:stream-close d (child id :source path)])\n   139\t           :vm/gensym (emit! id path [:gensym d (field id :prefix)])\n   188\t(defn project-rows\n   189\t  \"Project one canonical row set (`vm/ast->semantic-bytecode`'s `{:root\n   190\t   id, :rows {id row}}`) to the register-shaped vector. The rows are\n   191\t   validated (§7.4) first and a defect throws naming it. `origin` is nil\n   192\t   or one of §2.5's ruled occurrence origins.\n   193\t\n   194\t   Returns `{:vector v :address A :provenance [[pc origin root path] …]}`,\n   195\t   one provenance row per pc, `path` being the emitting node's §2.5\n   196\t   structural path from the root row (row-position steps; a `nodes` item\n   197\t   is a `[position i]` pair); a body's `:return` carries its lambda's\n   198\t   path.\"\n   199\t  ([bc] (project-rows bc nil))\n   200\t  ([{:keys [root rows], :as bc} origin]\n   201\t   (when-not (or (nil? origin) (vm/occurrence-origin? origin))\n   202\t     (throw (ex-info \"Cannot project rows with a malformed occurrence origin\"\n   203\t                     {:rule :origin, :origin origin})))\n   204\t   (when-let [{:keys [rule path id]} (vm/validate-rows bc)]\n   205\t     (throw (ex-info \"Cannot project rows that fail validation\"\n   206\t                     (cond-> {:rule rule}\n   207\t                       path (assoc :path path)\n   208\t                       id (assoc :id id)))))\n   209\t   (let [{:keys [code sources]} (flatten-tree (row-reader rows) root)]\n   210\t     {:vector code,\n   211\t      :address (ucf/code-address code),\n   212\t      :provenance (mapv (fn [pc [_ path]] [pc origin root path])\n   213\t                        (range)\n   214\t                        sources)})))\n   215\t\n   283\t(defn project-da