nd-names-the-runtime\" :owner \"J3\"}\n    45\t                     {:ns \"yin.repl.main-test\" :test \"booting-yields-one-shell-one-input-medium-and-one-cursor\" :owner \"J3\"}]\n    46\t :reader-failures {:owner \"jolt-lang\" :excluded false\n    47\t                   :tests [\"a-percent-reads-alike-in-every-symbol-position\"\n    48\t                           \"tagged-literals-and-reader-conditionals-refuse-alike\"]}}\n     1\t(ns yang.antlr.conformance\n     2\t  \"The per-target, language-free exporter oracle (docs/design/yang.antlr.md\n     3\t   §5.5): a language's fixtures are run against the exporter of the running\n     4\t   host, JVM, Node or Dart, and every one must come out the same. A fixture is\n     5\t   a source string and either its expected `shape` or the error it must\n     6\t   produce. The goldens are the JVM's; they are the cross-target oracle.\"\n     7\t  (:require\n     8\t    [clojure.test :refer [is testing]]\n     9\t    [yang.antlr.packet :as packet]))\n    10\t\n    11\t\n    12\t(defn shape\n    13\t  \"A packet's nodes in preorder: [rule span children] for a rule and\n    14\t   [type text span synthetic?] for a token. The child edges and the synthetic\n    15\t   flags are part of the shape, so a tree that differs only in them differs.\"\n    16\t  [pk]\n    17\t  (mapv (fn [n]\n    18\t          (if (= :rule (:kind n))\n    19\t            [(:rule n) (:span n) (:children n)]\n    20\t            [(:type n) (:text n) (:span n) (boolean (:synthetic n))]))\n    21\t        (:yang.cst/nodes pk)))\n    22\t\n    23\t\n    24\t(defn check-ok\n    25\t  \"`source` parses to an ok packet that validates and conforms (invariants\n    26\t   1-5); with `expected` the packet's shape equals it. Returns the packet.\"\n    27\t  ([parse source] (check-ok parse source nil))\n    28\t  ([parse source expected]\n    29\t   (let [pk (parse source)]\n    30\t     (is (= :yang.cst/ok (:yang.cst/outcome pk)) source)\n    31\t     (is (some? (packet/validate! pk {:source source})) source)\n    32\t     (is (= [] (packet/conform pk source)) source)\n    33\t     (when expected\n    34\t       (is (= expected (shape pk)) source))\n    35\t     pk)))\n    36\t\n    37\t\n    38\t(defn check-error\n    39\t  \"`source` yields a syntax-error packet with no nodes that validates and\n    40\t   whose first error has the given `line`, `column` and `span` (invariant 6).\n    41\t   ANTLR's line and column and the byte span are independent coordinates, so\n    42\t   each is pinned on its own. Returns the packet.\"\n    43\t  [parse source {:keys [line column span]}]\n    44\t  (let [pk (parse source)\n    45\t        e (first (:yang.cst/errors pk))]\n    46\t    (testing source\n    47\t      (is (= :yang.cst/syntax-error (:yang.cst/outcome pk)))\n    48\t      (is (not (contains? pk :yang.cst/nodes)) \"never a partial program\")\n    49\t      (is (not (contains? pk :yang.cst/root)))\n    50\t      (is (true? (:yang.cst/complete pk)))\n    51\t      (is (= :syntax-error (:kind e)))\n    52\t      (is (string? (:message e)))\n    53\t      (is (some? (packet/validate! pk {:source source})))\n    54\t      (is (= [] (packet/conform pk source)))\n    55\t      (when line (is (= line (:line e))))\n    56\t      (when column (is (= column (:column e))))\n    57\t      (when span (is (= span (:span e)))))\n    58\t    pk))\n    59\t\n    60\t\n    61\t(defn check-fixtures\n    62\t  \"Run each fixture {:source s :shape [...]} or {:source s :error {...}}.\"\n    63\t  [parse fixtures]\n    64\t  (doseq [{:keys [source shape error]} fixtures]\n    65\t    (if error\n    66\t      (check-error parse source error)\n    67\t      (check-ok parse source shape))))\n    68\t\n    69\t\n    70\t;; =============================================================================\n    71\t;; The adversarial corpus: packets that must be rejected\n    72\t;; =============================================================================\n    73\t\n    74\t(defn- first-node\n    75\t  [pk pred]\ntest/yang/php/antlr/linked_harness.cljc:4:   publisher of `php`, so it publishes the module once per process into one\ntest/yang/php/antlr/linked_harness.cljc:5:   in-memory content store, publishes a fixture's non-entry units beside it\ntest/yang/php/antlr/linked_harness.cljc:24:    [yin.vm.linker.publish :as publish]\ntest/yang/php/antlr/linked_harness.cljc:38:(def published\ntest/yang/php/antlr/linked_harness.cljc:39:  \"`yang.call` and `php` published once into their own content store.\"\ntest/yang/php/antlr/linked_harness.cljc:42:          call-result (publish/publish-module! store (call/module-spec (registry)))\ntest/yang/php/antlr/linked_harness.cljc:43:          result (publish/publish-module! store (prelude/module-spec (registry)\ntest/yang/php/antlr/linked_harness.cljc:51:(defn publish-units!\ntest/yang/php/antlr/linked_harness.cljc:52:  \"`units` (`[{:name path :packet p :strict-types b}]`) published into\ntest/yang/php/antlr/linked_harness.cljc:54:   `publication/publish-units!`'s answer.\"\ntest/yang/php/antlr/linked_harness.cljc:56:  (publication/publish-units! (:store @published) (registry) (:address @published) units))\ntest/yang/php/antlr/linked_harness.cljc:60:  \"The serving composition over the published store: `name-env` names `php`\ntest/yang/php/antlr/linked_harness.cljc:61:   and each published module, derivation `:trusted`, the test being the\ntest/yang/php/antlr/linked_harness.cljc:62:   publisher.\"\ntest/yang/php/antlr/linked_harness.cljc:64:  (link/composition {:content-store (:store @published),\ntest/yang/php/antlr/linked_harness.cljc:65:                     :name-env (merge {'php (:address @published),\ntest/yang/php/antlr/linked_harness.cljc:66:                                       'yang.call (:call-address @published)} name-env),\ntest/yang/php/antlr/linked_harness.cljc:119:  \"The name environment naming every published module of `result`\ntest/yang/php/antlr/linked_harness.clj