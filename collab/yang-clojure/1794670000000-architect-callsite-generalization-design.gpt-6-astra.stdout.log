    (set? x) (into (empty x) (map strip-reader-positions) x)\n  1052\t                 ;; not (into (empty x) ...): a map entry is vector? but its\n  1053\t                 ;; empty is nil, which would rebuild it as a reversed list\n  1054\t                 (vector? x) (mapv strip-reader-positions x)\n  1055\t                 ;; with-meta nil: ClojureDart's list mints its result with\n  1056\t                 ;; cljd.core's own reader metadata, which is not content\n  1057\t                 (sequential? x) (with-meta\n  1058\t                                   (apply list (map strip-reader-positions x))\n  1059\t                                   nil)\n  1060\t                 :else x)\n  1061\t        m (meta x)]\n  1062\t    (if m\n  1063\t      ;; metadata is itself a value: its entries and its own metadata may\n  1064\t      ;; carry reader positions too\n  1065\t      (let [m' (strip-reader-positions\n  1066\t                 (dissoc m :line :column :end-line :end-column))]\n  1067\t        ;; not (not-empty m'): an entry-less map may still carry metadata\n  1068\t        (with-meta x' (when-not (and (empty? m') (nil? (meta m'))) m')))\n  1069\t      x')))\n  1070\t\n  1071\t\n  1072\t(defn- same-content?\n  1073\t  \"True when `a` and `b` have equal content, comparing leaves by\n  1074\t   `dao.jing.cbor/content=`, the encoder's own kind-strict equality, so canonical\n  1075\t   NaNs are equal and `0.0`/`-0.0` are not,\n  1076\t   and carry `=` metadata at every depth, including inside metadata itself (a metadata value, or a metadata\n  1077\t   map's own metadata, compares through `same-content?` too). `=` alone ignores\n  1078\t   metadata.\n  1079\t\n  1080\t   NaN map keys and set elements inside data payloads are out of scope\n  1081\t   and fail closed when lookup misses.\n  1082\t\n  1083\t   Scope boundary: the set branch assumes ordinary set semantics, at most one\n  1084\t   element per `=`-equivalence class; a set built with a comparator that\n  1085\t   admits several `=`-equal, metadata-distinct elements is out of scope, the\n  1086\t   same class of pathological-input residual `dao.jing.md` documents for its\n  1087\t   own encoder (pathological symbols, scalar metadata). That deferred case is\n  1088\t   silent and order-dependent, not reliably fail-closed: which `=`-equal\n  1089\t   element the lookup picks depends on traversal order, so a metadata\n  1090\t   mismatch may throw or may be silently accepted.\"\n  1091\t  [a b]\n  1092\t  (and (= (meta a) (meta b))\n  1093\t       (or (nil? (meta a)) (same-content? (meta a) (meta b)))\n  1094\t       (cond (map? a) (and (map? b)\n  1095\t                           (= (count a) (count b))\n  1096\t                           (every? (fn [[k v]]\n  1097\t                                     (and (contains? b k)\n  1098\t                                          (let [[k' v'] (find b k)]\n  1099\t                                            (and (same-content? k k')\n  1100\t                                                 (same-content? v v')))))\n  1101\t                                   a))\n  1102\t             (set? a) (and (set? b)\n  1103\t                           (= (count a) (count b))\n  1104\t                           (every? (fn [e]\n  1105\t                                     (same-content? e (some #(when (= e %) %) b)))\n  1106\t                                   a))\n  1107\t             (sequential? a) (and (sequential? b)\n  1108\t                                  (= (count a) (count b))\n  1109\t                                  (every? true? (map same-content? a b)))\n  1110\t             :else (cbor/content= a b))))\n  1111\t\n  1112\t\n  1113\t(defn ast->semantic-bytecode\n  1114\t  \"Project a map AST to flat content-addressed rows (§6.1 codec boundary\n  1115\t   projection). Returns `{:root row-id, :rows {row-id [row-id tag & slots]}}`.\n  1116\t\n  1117\t   Only the §2.3 slots of each node enter its row: `:eid`, `:macro?`,\n  1118\t   `:yang/*` keys, non-`:application` `:tail?` marks, and any other key are\n  1119\t   dropped. `sym`/`syms` slots lose all metadata; `data`/`key` payloads lose\n  1120\t   reader positions at every depth and keep all other metadata. Defaults are\n  1121\t   saturated per §2.4. Children are projected first, so a parent's body\n  1122\t   commits to its children's ids; structurally identical subtrees mint one\n  1123\t   id and are stored as one row (§4.4).\n  1124\t\n  1125\t   Two nodes that mint one id must have one content: the row is checked\n  1126\t   against the stored row with `same-content?` (metadata at every depth,\n  1127\t   leaves by `dao.jing.cbor/content=`), and a mismatch throws\n  1128\t   \\\"Semantic bytecode address collision\\\" rather than letting one row silently\n  1129\t   replace the other. No known input reaches that throw: the encoder hashes\n  1130\t   symbol and collection metadata, and makes every NaN one quiet NaN, so two\n  1170\t\n  1171\t\n  1172\t(defn- reader-position\n  1173\t  [node]\n  1174\t  (let [source (:yang/source-position node)\n  1175\t        m (meta node)\n  1176\t        value (merge (select-keys m source-position-keys)\n  1177\t                     (select-keys node source-position-keys)\n  1178\t                     (when (map? source) source))]\n  1179\t    (when (some #(contains? value %) [:file :line :column])\n  1180\t      value)))\n  1181\t\n  1182\t\n  1183\t(defn- frontend-meta-entries\n  1184\t  \"Ordered `[key value]` entries attached to one Universal AST node. Yang\n  1185\t   keys and non-position map metadata are node facts. Reader metadata on a\n  1186\t   name or parameter is qualified by its semantic field so two parameters\n  1187\t   cannot silently claim the same key at one lambda occurrence.\"\n  1188\t  [tag node]\n  1189\t  (let [slots (get semantic-bytecode-grammar tag)\n  1190\t        node-meta (apply dissoc (or (meta node) {}) source-position-keys)\n  1191\t        yang (for [[k v] node\n  1192\t                   :when (and (= \"yang\" (namespace k))\n  1193\t                              (not= :yang/source-position k))]\n  1194\t               [k v])\n  1195\t        own (concat yang\n  1196\t                    (sort-by (comp pr-str key) node-meta))\n  1197\t        names (mapcat\n  1198\t                (fn [[field kind]]\n  1199\t                  (let [value (get node field)]\n  1200\t                    (case kind\n  1201\t                      :sym (for [[k v] (sort-by (comp pr-str key)\n  1202\t                                                (apply dissoc (or (meta value) {})\n  1203\t                                                       source-position-keys))]\n  1204\t                             [[field k] v])\n  1205\t                      :syms (mapcat\n  1206\t                              (fn [i sym]\n  1207\t                                (for [[k v] (sort-by (comp pr-str key)\n  1208\t                                                     (apply dissoc (or (meta sym) {})\n  1209\t                                                            source-position-keys))]\n  1210\t                                  [[field i k] v]))\n  1211\t                              (range) value)\n  1212\t                      nil)))\n  1213\t                slots)]\n  1214\t    (concat own names)))\n  1215\t\n  1216\t\n  1217\t(defn ast-side-tables\n  1218\t  \"Project occurrence-owned frontend facts from a map AST without putting\n  1219\t   them in canonical rows. Returns the §2.5 relations\n  1220\t   `{:source-positions [[origin root path file line col] ...]\n  1221\t     :frontend-metadata [[origin root path key value] ...]}`.\n  1222\t\n  1223\t   `bc` must be the projection of `ast`; its root makes both relations join\n  1224\t   the canonical row and occurrence relations. Structural paths use the same\n  1225\t   row positions as `occurrences` and lowering.\"\n  1226\t  [ast bc origin]\n  1227\t  (when-not (occurrence-origin? origin)\n  1228\t    (throw (ex-info \"Side tables require a ruled occurrence origin\"\n  1229\t                    {:rule :origin, :origin origin})))\n  1230\t  (let [root (:root bc)\n  1231\t        positions (atom [])\n  1232\t        metadata (atom [])]\n  1233\t    (letfn [(visit\n  1234\t              [node path]\n  1235\t              (let [tag (:type node)\n  1236\t                    slots (or (get semantic-bytecode-grammar tag)\n  1237\t                              (throw (ex-info \"Unknown AST node type\"\n  1238\t                                              {:type tag, :node node})))\n  1239\t                    position (reader-position node)]\n  1240\t                (when position\n  1241\t                  (swap! positions conj\n  1242\t                         [origin root path (:file position) (:line position)\n  1243\t                          (:column position)]))\n  1244\t                (doseq [[k v] (frontend-meta-entries tag node)]\n  1245\t                  (when-not (and (plain-data? k) (plain-data? v))\n  1246\t                    (throw (ex-info \"Frontend metadata is not plain data\"\n  1247\t                                    {:rule :frontend-metadata, :path path,\n  1248\t                                     :key k, :value v})))\n  1249\t                  (swap! metadata conj [origin root path k v]))\n  1250\t                (doseq [[j [field kind]] (map-indexed vector slots)\n  1251\t                        :let [pos (+ j 2)\n  1252\t                              value (get node field)]]\n  1253\t                  (case kind\n  1254\t                    :node (visit value (conj path pos))\n  1255\t                    :nodes (doseq [[i child] (map-indexed vector value)]\n  1256\t                             (visit child (conj path [pos i])))\n  1257\t                    nil))))]\n  1258\t      (visit ast [])\n  1259\t      {:source-positions @positions, :frontend-metadata @metadata})))\n  1260\t\n  1261\t\n  1262\t(defn- semantic-bytecode-slot-kind-ok?\n  1263\t  \"§2.2/§7.4 `:slot-kind`: whether `v` conforms to slot `kind`.\"\n  1264\t  [kind v]\n  1265\t  (case kind\n   728\t;; The manifest and derivation record formats (section 8.1)\n   729\t;; =============================================================================\n   730\t\n   731\t(def manifest-schema\n   732\t  \"The one module-manifest schema version this linker implements (section\n   733\t   8.1): which keys exist and what they mean. The manifest record's\n   734\t   validator implements exactly this version; a manifest of another\n   735\t   version is a `:schema` defect, never migrated.\"\n   736\t  1)\n   737\t\n   738\t\n   739\t(def ^:private manifest-keys\n   740\t  \"The closed key set of a schema-1 manifest: every key of section 8.1's\n   741\t   example, the index alone optional.\"\n   742\t  #{:yin.module/name :yin.module/schema :yin.module/contracts\n   743\t    :yin.module/tree :yin.module/derivations :yin.module/index\n   744\t    :yin.module/exports :yin.module/requires :yin.module/primitives\n   745\t    :yin.module/footprint})\n   746\t\n   747\t\n   748\t(def ^:private derivation-formats\n   749\t  \"The formats a manifest carries derivation records for. The tree itself\n   750\t   is the manifest's one canonical tree and needs no record.\"\n   751\t  #{:yin.semantic/code :yin.debruijn.code :yin.debruijn.register})\n   752\t\n   753\t\n   754\t(defn manifest-defect\n   755\t  \"The schema-1 manifest validator (section 8.1): one schema version, the\n   756\t   closed key set, and each key's own shape -- the name is a symbol, the\n   757\t   contracts map formats to revision strings, the tree and every record\n   758\t   and declaration address is a Jing address, the declarations are\n   759\t   symbol-keyed, and every format named under `:yin.module/derivations`\n   760\t   is named under `:yin.module/contracts`. A declared name may never be\n   761\t   the definition operator (Rule R). Returns the defect map or nil.\"\n   762\t  [manifest]\n   763\t  (let [address? jing/segment-address?\n   764\t        shape (fn [k] {:rule :manifest-shape, :key k})\n   765\t        name-map? (fn [m k p]\n   766\t                    (let [v (get m k)]\n   767\t                      (and (map? v)\n   768\t                           (every? (fn [entry]\n   769\t                                     (and (symbol? (key entry))\n   770\t                                          (p (val entry))))\n   771\t                                   v))))\n   772\t        declared-names (fn [manifest]\n   773\t                         (concat (keys (:yin.module/requires manifest))\n   774\t                                 (keys (:yin.module/primitives manifest))\n   775\t                                 (:yin.module/exports manifest)))]\n   838\t                (declared-names manifest))))))\n   839\t\n   840\t\n   841\t(def ^:private record-keys\n   842\t  \"The closed key set of a derivation record: exactly the keys\n   843\t   `yin.vm.ledger/derive-record` mints.\"\n   844\t  #{:yin.ledger/op :yin.ledger/input :yin.ledger/output\n   845\t    :yin.ledger/function :yin.ledger/profile})\n   846\t\n   847\t\n   848\t(defn record-defect\n   849\t  \"The derivation-record validator (section 8.1): a record is exactly\n   850\t   `yin.vm.ledger/derive-record`'s shape -- one `:derive` op, the tree's\n   851\t   Jing address as input, the lowered image's identity as output (a\n   852\t   segment address for the vector format, a contract-pinned hash for\n   853\t   the two de Bruijn formats), a function name, and the structured\n   854\t   profile map, no more and no less. Returns the defect map or nil.\"\n   855\t  [record]\n   856\t  (let [address? jing/segment-address?\n   857\t        shape (fn [k] {:rule :record-shape, :key k})\n   858\t        output? (fn [o] (or (string? o) (keyword? o)))]\n   859\t    (cond\n   860\t      (not (map? record)) {:rule :record-shape}\n   861\t      (not= record-keys (set (keys record))) {:rule :record-shape}\n   862\t      (not= :derive (:yin.ledger/op record))\n   863\t      {:rule :op, :op (:yin.ledger/op record)}\n   864\t      (not (address? (:yin.ledger/input record)))\n   865\t      (shape :yin.ledger/input)\n   866\t      (not (output? (:yin.ledger/output record)))\n   867\t      (shape :yin.ledger/output)\n   868\t      (not (keyword? (:yin.ledger/function record)))\n   869\t      (shape :yin.ledger/function)\n   870\t      (not (map? (:yin.ledger/profile record)))\n   871\t      (shape :yin.ledger/profile)\n   872\t      :else nil)))\n   873\t\n   874\t\n   875\t(def manifest-format\n   876\t  \"The `:yin.module/manifest` format record (section 8.1): a manifest is\n   877\t   one map, content-addressed at its own segment address and identified\n   878\t   by it, its contract this record's one schema version. No parts, no\n   879\t   obligations: a manifest is a declaration, not an image.\"\n   880\t  {:format              :yin.module/manifest,\n   881\t   :contract            manifest-schema,\n   882\t   :identity-fn         jing/segment-key,\n   883\t   :identity-matches-fn jing/segment-matches?,\n   884\t   :row-defect-fn       manifest-defect,\n   885\t   :validate-fn         manifest-defect,\n   886\t   :obligations-fn      (constantly []),\n   887\t   :definitions-fn      (constantly []),\n   888\t   :applications-fn     (constantly []),\n   889\t   :parts-fn            (constantly nil)})\n   890\t\n   891\t\n   892\t(def record-format\n   893\t  \"The `:yin.ledger/record` format record (section 8.1): a derivation\n   894\t   record minted by `yin.vm.ledger/derive-record`, fetched through the\n   895\t   pipeline so the record itself passes steps 2 to 4 before the linker\n   896\t   believes its claim.\"\n   897\t  {:format              :yin.ledger/record,\n   898\t   :contract            :derive,\n   899\t   :identity-fn         jing/segment-key,\n   900\t   :identity-matches-fn jing/segment-matches?,\n   901\t   :row-defect-fn       record-defect,\n   902\t   :validate-fn         record-defect,\n   903\t   :obligations-fn      (constantly []),\n   904\t   :definitions-fn      (constantly []),\n   905\t   :applications-fn     (constantly []),\n   906\t   :parts-fn            (constantly nil)})\n   907\t\n   908\t\n   909\t(def stack-lowering-profile\n   910\t  \"The lowering profile this linker implements for\n   911\t   `:yin.debruijn.code` (section 8.1): the stack lowering --\n   912\t   `resolve`, then `lower-stack` -- over the datom lane, the row-lane\n   913\t   tree reconstructed first. A derivation record naming this profile\n   914\t   verbatim is one this linker recomputes; any other is never trusted\n   915\t   under `:verifying`.\"\n   916\t  {:yin.lower/profile \"stack-lowering\",\n   917\t   :yin.code/contract vm/stack-contract,\n   918\t   :yin.k/version 0})\n   919\t\n   920\t\n   921\t(def register-lowering-profile\n   922\t  \"The lowering profile this linker implements for\n   923\t   `:yin.debruijn.register` (section 8.1): the register lowering --\n   924\t   `resolve`, then `lower-register` -- over the datom lane, the row-lane\n   925\t   tree reconstructed first.\"\n   926\t  {:yin.lower/profile \"register-lowering\",\n   927\t   :yin.code/contract vm/register-contract,\n   928\t   :yin.k/version 0})\n   929\t\n   930\t\n   931\t(def ^:private implemented-profiles\n   932\t  \"The one profile per lowered format this linker recomputes under the\n   933\t   `:verifying` policy (section 8.1); the semantic format's is\n   934\t   `yin.vm.ledger`'s published profile.\"\n   935\t  {:yin.semantic/code ledger/lowering-profile,\n   936\t   :yin.debruijn.code stack-lowering-profile,\n   937\t   :yin.debruijn.register register-lowering-profile})\n   938\t\n   939\t\n   940\t;; =============================================================================\n","exit_code":0,"status":"completed"}}
