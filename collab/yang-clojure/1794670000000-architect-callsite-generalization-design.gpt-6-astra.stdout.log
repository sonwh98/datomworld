ess opts)]\n   131\t                    (case (:yin.link.closure/outcome w)\n   132\t                      :complete nil\n   133\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n   134\t                                        {:name n})\n   135\t                      :missing (when (not= address (:address w))\n   136\t                                 (refusal :yin.link.publish/incomplete-requirement\n   137\t                                          {:name n :walk w})))))\n   138\t                (sort-by (fn [[n _]] (str n)) requires)))\n   139\t        fp (when (and tree (not defect) (not requirement)\n   140\t                      (not= :refused (:status tree)))\n   141\t             (footprint handle (assoc spec :tree tree)))]\n   142\t    (cond\n   143\t      undefined\n   144\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   145\t\n   146\t      (= :refused (:status tree)) tree\n   147\t\n   148\t      defect\n   149\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\n   150\t\n   151\t      requirement requirement\n   152\t\n   153\t      (= :refused (:status fp)) fp\n   154\t\n   155\t      :else\n   156\t      (let [tree-address (vm/materialize-tree! handle tree)\n   157\t            sem-vector (:vector (linearize/project-rows tree))\n   158\t            sem (code/materialize-vector! handle sem-vector)\n   159\t            h-image (:image (derive/stack-image sem-vector))\n   160\t            r-image (derive/register-image sem-vector)\n   161\t            h (dcode/image-hash h-image)\n   162\t            r (rcode/register-hash r-image)\n   163\t            h-address (jing/materialize! handle h-image)\n   164\t            r-address (jing/materialize! handle r-image)\n   165\t            mint (fn [input output profile]\n   166\t                   (jing/materialize!\n   167\t                     handle\n   168\t                     (assoc (ledger/derive-record input output)\n   169\t                            :yin.ledger/profile profile)))\n   170\t            manifest {:yin.module/name name\n   171\t                      :yin.module/schema linker/manifest-schema\n   172\t                      :yin.module/contracts\n   173\t                      {:yin.ast/code vm/ast-contract\n   174\t                       :yin.semantic/code vm/semantic-contract\n   175\t                       :yin.debruijn.code vm/stack-contract\n   176\t                       :yin.debruijn.register vm/register-contract}\n   177\t                      :yin.module/tree tree-address\n   178\t                      :yin.module/derivations\n   179\t                      {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\n   180\t                       :yin.debruijn.code\n   181\t                       (mint sem h linker/stack-lowering-profile)\n   182\t                       :yin.debruijn.register\n   183\t                       (mint sem r linker/register-lowering-profile)}\n   184\t                      :yin.module/index {:yin.debruijn.code h-address\n   185\t                                         :yin.debruijn.register r-address}\n   186\t                      :yin.module/exports (set exports)\n   187\t                      :yin.module/requires (or requires {})\n   188\t                      :yin.module/primitives\n   189\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   190\t                                    primitives))\n   191\t                      :yin.module/footprint fp}\n   192\t            address (jing/materialize! handle manifest)\n   193\t            walked (closure/walk handle address opts)]\n   194\t        (if (not= :complete (:yin.link.closure/outcome walked))\n   195\t          (refusal :yin.link.publish/incomplete-closure\n   196\t                   {:address address :walk walked})\n   197\t          (let [links (into {}\n   198\t                            (map (fn [f]\n   199\t                                   [(:format f)\n   200\t                                    (link-local handle address f\n   201\t                                                (select-keys opts\n   202\t                                                             [:bounds]))]))\n   203\t                            code-formats)]\n   204\t            {:address address :manifest manifest\n   205\t             :identities {:yin.semantic/code sem\n   206\t                          :yin.debruijn.code sem\n   207\t                          :yin.debruijn.register sem}\n   208\t             :checksums {:yin.debruijn.code h :yin.debruijn.register r}\n   209\t             :links links}))))))\n   210\t\n   211\t\n   212\t(defn publish-module!\n   213\t  \"Mint all four code formats, derivation records, and one schema-1 manifest.\n   214\t   `opts` `{:bounds {...}}` are the composition bounds (section 4.2 step\n   215\t   2) of every closure walk and local link the publication runs, every\n   216\t   bound left out taking `linker/default-bounds`.\"\n   217\t  ([handle spec] (publish-module! handle spec nil))\n   218\t  ([handle spec opts] (publish-closure! handle spec opts)))\n   219\t\n   220\t\n   221\t;; =============================================================================\n   222\t;; Deriving a module from indexed code (5.3)\n   223\t;; =============================================================================\n   224\t\n   225\t(defn- indexed-programs\n     1\t(ns yang.frontend\n     2\t  \"The language frontend catalog (docs/design/yang.antlr.md section 3,\n     3\t   section 8.5.6 slice F1): manifest validation, `install`, and `select`.\n     4\t\n     5\t   A catalog is a plain immutable value. There is no global registry and\n     6\t   no namespace-load registration: `install` returns a new catalog and\n     7\t   never changes its argument, so an in-flight request that pinned a\n     8\t   catalog snapshot keeps its behavior (section 3.3).\n     9\t\n    10\t   A manifest is portable data only: no functions, host handles, records,\n    11\t   or other host objects anywhere in it (section 3.1). The installed\n    12\t   binding is the host's own value, kept beside the manifest and never\n    13\t   inspected here; its shape is the composition's (slice F2).\n    14\t\n    15\t   Revisions of one frontend id coexist (section 3.7): an entry is keyed by\n    16\t   `[id revision]`, and a revision is immutable once installed.\n    17\t\n    18\t   Every refusal is a returned data outcome,\n    19\t   `{:status :refused, :reason :yang.frontend/<reason>}` plus its evidence;\n    20\t   a selection is `{:status :ok, :manifest m, :binding b}`.\")\n    21\t\n    22\t\n    23\t(def supported-spi\n    24\t  \"The SPI revisions (`:yang.frontend/spi`) this catalog admits.\"\n    25\t  #{1})\n    26\t\n    27\t\n    28\t(def refusal-reasons\n    29\t  \"Every reason a catalog refusal may carry.\"\n    30\t  #{:yang.frontend/malformed :yang.frontend/non-portable\n    31\t    :yang.frontend/incompatible-spi :yang.frontend/revision-conflict\n    32\t    :yang.frontend/unknown :yang.frontend/ambiguous\n    33\t    :yang.frontend/incompatible})\n    34\t\n    35\t\n    36\t(defn refused\n    37\t  \"A qualified refusal: `{:status :refused, :reason reason}` merged with\n    38\t   the evidence `data`.\"\n    39\t  ([reason] (refused reason {}))\n    40\t  ([reason data]\n    41\t   (merge data {:status :refused, :reason reason})))\n    42\t\n    43\t\n    44\t(defn refused?\n    45\t  \"True when `res` is a catalog refusal.\"\n    46\t  [res]\n    47\t  (and (map? res) (= :refused (:status res))))\n    48\t\n    49\t\n    50\t(defn ok?\n    51\t  \"True when `res` is a successful selection.\"\n    52\t  [res]\n    53\t  (and (map? res) (= :ok (:status res))))\n    54\t\n    55\t\n    56\t;; =============================================================================\n    57\t;; Manifest validation (sections 3.1, 3.7)\n    58\t;; =============================================================================\n    59\t\n    60\t(defn- non-portable-path\n    61\t  \"The path to the first value in `x` that is not portable data, or nil.\n    62\t   A set member has no stable position, so its path ends at the set, and a\n    63\t   map key's path ends at its map. With several defects the first reported\n    64\t   follows host iteration order.\"\n    65\t  [x path]\n    66\t  (cond (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n    67\t            (number? x) (char? x))\n    68\t        nil\n    69\t        (record? x) path\n    70\t        (map? x) (some (fn [[k v]]\n    71\t                         (or (non-portable-path k path)\n    72\t                             (non-portable-path v (conj path k))))\n    73\t                       x)\n    74\t        (or (vector? x) (seq? x))\n    75\t        (some (fn [[i v]] (non-portable-path v (conj path i)))\n    76\t              (map-indexed vector x))\n    77\t        (set? x) (when (some #(non-portable-path % path) x) path)\n    78\t        :else path))\n    79\t\n    80\t\n    81\t(defn- address?\n    82\t  \"A content address: a `:segment/...` key or a non-empty string.\"\n    83\t  [x]\n    84\t  (or (keyword? x) (and (string? x) (seq x))))\n    85\t\n    86\t\n    87\t(def ^:private manifest-checks\n    88\t  \"`[key valid?]` for every key section 3.7 pins per request. The spi is\n    89\t   `int?`, which on JavaScript also admits an integral float such as 1.0.\"\n    90\t  [[:yang.frontend/id qualified-keyword?]\n    91\t   [:yang.frontend/spi int?]\n    92\t   [:yang.frontend/revision #(and (string? %) (seq %))]\n    93\t   [:yang.frontend/language keyword?]\n    94\t   [:yang.frontend/grammar map?]\n    95\t   [:yang.frontend/options-schema address?]\n    96\t   [:yang.frontend/lowering-profile address?]\n    97\t   [:yang.frontend/runtime-profile address?]\n    98\t   [:yang.frontend/support-profile address?]])\n    99\t\n   100\t\n   101\t(def ^:private grammar-checks\n   102\t  \"`[key valid?]` for the grammar package. The lexer and parser names are\n   103\t   ANTLR's and optional, but a non-empty string when present: the SPI does\n   104\t   not require ANTLR (section 3.6).\"\n   105\t  [[:yang.grammar/package address?]\n   106\t   [:yang.grammar/entries #(and (map? %) (seq %))]\n   107\t   [:yang.grammar/export-profile keyword?]])\n   108\t\n   109\t\n   110\t(defn- optional-name?\n   111\t  [m k]\n   112\t  (or (not (contains? m k))\n   113\t      (let [v (get m k)] (and (string? v) (seq v)))))\n   114\t\n   115\t\n   116\t(defn- first-defect\n   117\t  [m checks path]\n   118\t  (some (fn [[k valid?]]\n   119\t          (let [v (get m k)]\n   120\t            (when-not (valid? v)\n   121\t              (refused :yang.frontend/malformed\n   122\t                       {:path (conj path k),\n   123\t                        :defect (if (contains? m k) :invalid :missing)}))))\n   124\t        checks))\n   125\t\n   126\t\n   127\t(defn validate\n   128\t  \"`{:status :ok, :manifest m}` when `m` is a portable, versioned manifest\n   129\t   this catalog admits, else the refusal naming the first defect.\"\n   130\t  [m]\n   131\t  (if-not (map? m)\n   132\t    (refused :yang.frontend/malformed {:path [], :defect :invalid})\n   133\t    (if-let [path (non-portable-path m [])]\n   134\t      (refused :yang.frontend/non-portable {:path path})\n   135\t      (or (first-defect m manifest-checks [])\n   136\t          (first-defect (:yang.frontend/grammar m)\n   137\t                        grammar-checks\n   138\t                        [:yang.frontend/grammar])\n   139\t          (some (fn [k]\n   140\t                  (when-not (optional-name? (:yang.frontend/grammar m) k)\n   141\t                    (refused :yang.frontend/malformed\n   142\t                             {:path [:yang.frontend/grammar k],\n   143\t                              :defect :invalid})))\n   144\t                [:yang.grammar/lexer :yang.grammar/parser])\n   145\t          (when-not (contains? supported-spi (:yang.frontend/spi m))\n   146\t            (refused :yang.frontend/incompatible-spi\n   147\t                     {:spi (:yang.frontend/spi m),\n   148\t                      :supported supported-spi}))\n   149\t          {:status :ok, :manifest m}))))\n   150\t\n   151\t\n   152\t;; =============================================================================\n   153\t;; Catalog (section 3.3)\n   154\t;; =============================================================================\n   155\t\n   156\t(def empty-catalog\n   157\t  \"The catalog with no frontend installed.\"\n   158\t  {:yang.frontend/entries {}})\n   159\t\n   160\t\n   161\t(defn- entry-key\n   162\t  [m]\n   163\t  [(:yang.frontend/id m) (:yang.frontend/revision m)])\n   164\t\n   165\t\n   166\t(defn install\n   167\t  \"`catalog'`: `catalog` plus `manifest` bound to the host's\n   168\t   `binding`, or the refusal when `manifest` is invalid or its\n   169\t   `[id revision]` is already installed with a different manifest or\n   170\t   binding. Re-installing an identical entry is the identity.\"\n   171\t  [catalog manifest binding]\n   172\t  (let [res (validate manifest)]\n   173\t    (if (refused? res)\n   174\t      res\n   175\t      (let [k (entry-key manifest)\n   176\t            entry {:manifest manifest, :binding binding}\n   177\t            prior (get-in catalog [:yang.frontend/entries k])]\n   178\t        (cond (nil? prior) (assoc-in catalog [:yang.frontend/entries k] entry)\n   179\t              (= prior entry) catalog\n   180\t              :else (refused :yang.frontend/revision-conflict\n   181\t                             {:id (first k), :revision (second k)}))))))\n   182\t\n   183\t\n   184\t(defn revisions\n   185\t  \"The installed revisions of frontend `id`, sorted.\"\n   186\t  [catalog id]\n   187\t  (->> (keys (:yang.frontend/entries catalog))\n   188\t       (keep (fn [[i r]] (when (= i id) r)))\n   189\t       sort\n   190\t       vec))\n   191\t\n   192\t\n   193\t(defn select\n   194\t  \"Select an installed frontend by `request`: `:yang.frontend/id`, and\n   195\t   optionally `:yang.frontend/revision` and any other manifest key\n   196\t   section 3.7 pins (SPI, language, grammar, profiles). Answers\n   197\t   `{:status :ok, :manifest m, :binding b}`, or a refusal:\n   198\t   `:yang.frontend/unknown` when no revision of the id (or the named\n   199\t   revision) is installed, `:yang.frontend/incompatible` when installed\n   200\t   candidates exist but none matches the pins, and\n","exit_code":0,"status":"completed"}}
