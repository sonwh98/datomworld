\"\\\\\\\"(def replay-expectations\\\\n  \\\\\\\"The cc4 cohort's fixed expectations, shared by all hosts. Originally\\\\n   recorded on the JVM at dispatch revision 2687ab0c; re-pinned once under\\\\n   manifest c1-2 (constructed-collections-v1, ruling 1795017757000) after\\\\n   the collection emitter began ordering constructor operands by compiled\\\\n   content -- the argument-vector and lower-unit members changed canonical\\\\n   bytes, the other six members are byte-identical. The pre-fix bundle is\\\\n   retained at test/resources/yang/clojure/cc4-replay-snapshots-prefix-c1-1.edn.\\\\\\\")\\\\\\\"\\\\\\\"\\\\\\\"\\\\nassert old in t; t = t.replace(old, new)\\\\n\\\\n# focused regression addition after the cohort test\\\\nanchor = \\\\\\\"\\\\\\\"\\\\\\\"(deftest portable-replay-cohort-test\\\\n  (let [artifacts (replay-artifacts)\\\\n        snapshots (mapv replay-snapshot artifacts)]\\\\n    (when (not= replay-expectations snapshots)\\\\n      (doseq [[expected actual artifact] (map vector replay-expectations snapshots artifacts)\\\\n              :when (not= expected actual)]\\\\n        ;; Preserve the producer's actual rows and canonical tree. A failed\\\\n        ;; equality gate is a defect report, never permission to re-pin a host.\\\\n        (prn :cc4/replay-divergence\\\\n             {:expected expected :actual actual\\\\n              :artifact (select-keys artifact [:id :tree :rows :expansion-log])})))\\\\n    (is (= replay-expectations snapshots))\\\\n    (doseq [{:keys [id tree rows]} artifacts]\\\\n      (testing (str id)\\\\n        (is (= (occurrence-pairs tree) (marked-pairs rows)))))\\\\n    (let [a (first artifacts) b (nth artifacts 5)]\\\\n      (is (= (:root (:tree a)) (:root (:tree b))))\\\\n      (is (not= (row-origins (:rows a)) (row-origins (:rows b)))))))\\\\\\\"\\\\\\\"\\\\\\\"\\\\naddition = anchor + \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n\\\\n(deftest constructed-collection-operand-order-test\\\\n  \\\\\\\"constructed-collections-v1 (ruling 1795017757000): the reproduced\\\\n   arity-map constructor emits its pairs in compiled-content order --\\\\n   ascending jing/canonical-compare over the children's projected\\\\n   [key-root value-root] -- so both cohort members carrying it compile to\\\\n   one operand vector on every host. The full battery for the ordering\\\\n   lives in yang.clojure-collection-order-test.\\\\\\\"\\\\n  (letfn [(arity-ctors [ast]\\\\n            (->> (collection-constructors ast)\\\\n                 (filter (fn [c]\\\\n                           (some (fn [o] (and (= :literal (:type o))\\\\n                                              (contains? #{:yin.k/fn :yin.k/kind}\\\\n                                                         (:value o))))\\\\n                                 (:operands c))))))\\\\n          (pair-keys [c]\\\\n            (mapv vec (partition 2 (rest (mapv #(get (vm/ast->semantic-bytecode %)\\\\n                                                     :root)\\\\n                                               (:operands c))))))\\\\n          (sorted? [ks]\\\\n            (every? (fn [[a b]] (neg? (jing/canonical-compare a b)))\\\\n                    (partition 2 1 ks)))]\\\\n    (doseq [[label ast] [[:argument-vector\\\\n                          (yang/compile-program\\\\n                            '[(defn replay\\\\n                                [x]\\\\n                                (let [[a b] [x 1.5]]\\\\n                                  (+ (identity ^:replay a)\\\\n                                     (identity ^:replay a) b)))\\\\n                              (replay 2)]\\\\n                            true yang/unit-opts)]\\\\n                         [:lower-unit\\\\n                          (yang/lower-unit\\\\n                            '[(defn replay\\\\n                                [x]\\\\n                                (let [[a b] [x 1.5]]\\\\n                                  (+ (identity ^:replay a)\\\\n                      