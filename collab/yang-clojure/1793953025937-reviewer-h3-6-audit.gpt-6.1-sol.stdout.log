efn stamp-id [n] (when (and (= :application (:type n)) (= 'data/nth (get-in n [:operator :name])) (= 'gate-site! (get-in n [:operands 0 :operands 0 :name]))) (get-in n [:operands 0 :operands 1 :operands 1 :value])))\r\n(defn unstamp [n] (if (stamp-id n) (get-in n [:operands 0 :operands 1 :operands 2]) n))\r\n(defn avargs [n] (let [n (unstamp n)] (if (= :literal (:type n)) (:value n) (when (= 'conj (get-in n [:operator :name])) (rest (:operands n))))))\r\n(def ctors (set (cons 'kernel-context (filter #(re-find #\"^(install-|register-|unregister-)\" (str %)) (map second (ov 'context-forms))))))\r\n(defn argshape [n env ps depth] (cond (or (nil? n) (> depth 8)) :computed (= :literal (:type n)) :literal (not (coll? n)) :literal (= :variable (:type n)) (if (and (not (ps (:name n))) (contains? env (:name n))) (recur (env (:name n)) env ps (inc depth)) :variable) (and (= 'dsg__intra_call (get-in n [:operator :name])) (ctors (get-in n [:operands 0 :name]))) (let [g (get-in n [:operands 0 :name]) a (avargs (second (:operands )) x (first a)] (cond (and (= 'kernel-context g) (= :literal (:type x)) (= [{} {}] (:value x))) :ambient-literal (and (= 1 (count a)) (= :ambient-literal (argshape x env ps (inc depth)))) :ambient-literal :else :computed)) (and (= 'data/nth (get-in n [:operator :name])) (= 2 (count (:operands n))) (let [i (get-in n [:operands 1 :value])] (if (and (number? i) (pos? i)) (recur (first (:operands n)) env ps (inc depth)) :computed)) :else :computed))\r\n(defn independent-sites [ast] (let [found (atom {})] (letfn [(scan [n defname env ps] (when (coll? n) (if (map? n) (let [op (:operator n) ops (:operands n) t (:type n) definition? (and (= 'yin/def (:name op)) (= :literal (:type (first ops)))) d (if definition? (:value (first ops)) defname) intra? (= 'dsg__intra_call (:name op)) args (if intra? (second ops) (when (= :lambda (:type op)) (first ops))) sid (stamp-id args)] (when sid (let [callee (if intra? (:name (first ops)) :dynamic)] (swap! found assoc sid {:si