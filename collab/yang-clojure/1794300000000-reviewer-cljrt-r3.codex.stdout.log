{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '305,379p;2710,2731p'\"","aggregated_output":"   305\t(defn- cursor-cell?\n   306\t  \"True when a resource is a cursor cell, `{:stream-id id :cursor c}`.\n   307\t   A cursor cell is the VM's mutable box (with identity) holding one\n   308\t   immutable `dao.stream` cursor; `:stream/next` overwrites its `:cursor`\n   309\t   with the successor. A guest program holds a sealed `:cursor-ref` naming\n   310\t   it, never the cell itself. Not to be confused with `yin.vm.cell`, the\n   311\t   general heap box. Vocabulary: UCF §7.5.3, \\\"Terminology\\\".\"\n   312\t  [resource]\n   313\t  (and (map? resource) (contains? resource :stream-id)))\n   314\t\n   315\t\n   316\t(defn issue-ref\n   317\t  \"A reference of `kind` (`:stream-ref`, `:cursor-ref`, or `:cell-ref`) to\n   318\t   resource or heap cell `id`, sealed under the task's capability secret.\n   319\t   A task composed\n   320\t   without a secret cannot issue one: it fails closed rather than issue a\n   321\t   reference anyone could forge.\"\n   322\t  [state kind id]\n   323\t  (let [secret (:capability-secret state)]\n   324\t    (when (nil? secret)\n   325\t      (fail (str \"This task has no capability secret, so it cannot issue\"\n   326\t                 \" a resource reference\")\n   327\t            {:reason :no-capability-secret, :kind kind, :id id}))\n   328\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\n   329\t\n   330\t\n   331\t(defn authentic-ref?\n   332\t  \"True when `ref` is a `kind` reference this task issued: its seal\n   333\t   verifies under the task's secret, and it names a live resource of that\n   334\t   kind. A `:cell-ref` is checked against `:heap` instead: its id is live\n   335\t   by `contains?` (a cell may hold nil) and its seal equals the one the\n   336\t   heap entry recorded at allocation, so no hash is computed per access.\"\n   337\t  [state kind ref]\n   338\t  (let [secret (:capability-secret state)\n   339\t        id (when (map? ref) (:id ref))]\n   340\t    (if (= :cell-ref kind)\n   341\t      (let [heap (:heap state)]\n   342\t        (boolean (and (some? secret)\n   343\t                      (= kind (:type ref))\n   344\t                      (contains? heap id)\n   345\t                      (= (:seal ref) (:seal (get heap id))))))\n   346\t      (let [resource (get (:resources state) id)]\n   347\t        (boolean (and (some? secret)\n   348\t                      (= kind (:type ref))\n   349\t                      (some? resource)\n   350\t                      (= (:seal ref) (seal-of secret kind id))\n   351\t                      (= (= :cursor-ref kind) (cursor-cell? resource))))))))\n   352\t\n   353\t\n   354\t(defn check-ref!\n   355\t  \"The resource id a program-supplied `kind` reference names, once its\n   356\t   seal verifies (r10). Anything else fails closed with\n   357\t   `:forged-resource-reference`, naming the effect and the id it named;\n   358\t   a cell ref whose id the heap does not hold is\n   359\t   `:dead-or-forged-reference` instead: its cell was swept, or never was.\n   360\t   Ids are never reused, so such a ref is never silently reallocated.\"\n   361\t  [state effect-kind kind ref]\n   362\t  (if (authentic-ref? state kind ref)\n   363\t    (:id ref)\n   364\t    (let [id (when (map? ref) (:id ref))\n   365\t          dead? (and (= :cell-ref kind) (not (contains? (:heap state) id)))]\n   366\t      (fail (if dead? \"Dead or forged cell reference\" \"Forged resource reference\")\n   367\t            {:reason (if dead?\n   368\t                       :dead-or-forged-reference\n   369\t                       :forged-resource-reference),\n   370\t             :effect effect-kind,\n   371\t             :kind kind,\n   372\t             :id id}))))\n   373\t\n   374\t\n   375\t(declare gensym)\n   376\t\n   377\t\n   378\t(defn attach-resource\n   379\t  \"Install the host stream `handle` a composition hands a task under a\n  2710\t              {:state (:state result),\n  2711\t               :value (:value result),\n  2712\t               :blocked? false}))\n  2713\t          :stream/close\n  2714\t          (let [_ (gate-refuse! state effect)\n  2715\t                close-result (handle-close state effect)]\n  2716\t            {:state (:state close-result), :value nil, :blocked? false})\n  2717\t          ;; `:heap` is VM state, not continuation state: a write is seen\n  2718\t          ;; by every holder of the ref and survives continuation invocation\n  2719\t          :cell/new\n  2720\t          (let [[id s'] (gensym (count-allocation state (:val effect)) \"cell\")\n  2721\t                ref (issue-ref s' :cell-ref id)]\n  2722\t            {:state (heap-write s' id (:seal ref) (:val effect)),\n  2723\t             :value ref,\n  2724\t             :blocked? false})\n  2725\t          :cell/get\n  2726\t          (let [id (check-ref! state :cell/get :cell-ref (:cell effect))]\n  2727\t            ;; the content is answered as data, never re-interpreted\n  2728\t            {:state state,\n  2729\t             :value (get-in state [:heap id :value]),\n  2730\t             :blocked? false})\n  2731\t          :cell/set!\n","exit_code":0,"status":"completed"}}
