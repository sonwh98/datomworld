a clj/global-get inside the caller's run\"\n   124\t    ;; `ts_apply` is no top-level definition of the caller, so its read\n   125\t    ;; inside `apply-it` reaches the runtime global namespace the helper\n   126\t    ;; projected into, not a task-store binding.\n   127\t    (is (= \"22\"\n   128\t           (xl/call [:typescript\n   129\t                     (str \"globalThis.ts_apply = f => { globalThis.stored = f; \"\n   130\t                          \"return stored === f ? f(20n) + 1n : -1n; };\")]\n   131\t                    [\"ts_apply\"]\n   132\t                    [:clojure\n   133\t                     \"(defn apply-it [] (ts_apply (fn [x] (+ x 1)))) (apply-it)\"]))))\n   134\t  (testing \"a second clj/run-main entry still sees the earlier unit's globals\"\n   135\t    (is (= \"42\"\n   136\t           (xl/call [:clojure \"(def answer 42)\"]\n   137\t                    [\"answer\"]\n   138\t                    [:clojure \"(defn get-answer [] answer) (get-answer)\"])))))\n   139\t\n   140\t\n   141\t(deftest clojure-caller-shadows-projected-global-test\n   142\t  (testing \"a caller-defined name shadows the projected one\"\n   143\t    ;; The caller's own `shared` runs: its definition publishes after the\n   144\t    ;; projection, so the runtime global holds the caller's function.\n   145\t    (is (= \"21\"\n   146\t           (xl/call [:clojure \"(defn shared [x] (+ x 100))\"]\n   147\t                    [\"shared\"]\n   148\t                    [:clojure \"(defn shared [x] (+ x 1)) (shared 20)\"])))))\n   149\t\n   150\t\n   151\t(deftest clojure-source-cell-ref-map-invocation-test\n   152\t  (testing \"a source map {:type :cell-ref} is ordinary invocable data\"\n   153\t    ;; The donor's exported function invokes its own source map literal:\n   154\t    ;; the map lookup answers 42, where the structural cell test used to\n   155\t    ;; dereference the map as a cell and fail the VM.\n   156\t    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n   157\t           (xl/call [:clojure\n   158\t                     \"(defn probe [] ({:type :cell-ref :marker 42} :marker))\"]\n   159\t                    [\"probe\"]\n   160\t                    [:typescript \"console.log(probe());\"]))))\n   161\t  (testing \"a source map with the full forged cell-ref shape is ordinary invocable data\"\n   162\t    ;; The map spells every key of an issued reference among its own\n   163\t    ;; entries; it is still data, so the lookup answers 42 where key\n   164\t    ;; presence alone used to dereference it and fail the VM.\n   165\t    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n   166\t           (xl/call [:clojure\n   167\t                     \"(defn probe [] ({:type :cell-ref :id :customer :seal \\\"wax\\\" :marker 42} :marker))\"]\n   168\t                    [\"probe\"]\n   169\t                    [:typescript \"console.log(probe());\"]))))\n   170\t  (testing \"a runtime-built map with the forged cell-ref shape is ordinary invocable data\"\n   171\t    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n   172\t           (xl/call [:clojure\n   173\t                     \"(defn probe [] (let [m {:type :cell-ref :id :customer :seal \\\"wax\\\" :marker 42}] (m :marker)))\"]\n   174\t                    [\"probe\"]\n   175\t                    [:typescript \"console.log(probe());\"])))))\n   176\t\n   177\t\n   178\t(deftest python-function-kind-of-in-typescript-test\n   179\t  (testing \"js/kind-of over a cell-backed foreign callable is :function\"\n   180\t    (is (= {:js/out [\"function\"], :js/uncaught nil}\n","exit_code":0,"status":"completed"}}
