1331\t                                (u/if-node\n  1332\t                                  (u/app (u/v 'dsg__equal)\n  1333\t                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n  1334\t                                                (u/lit :clj/escape-token))\n  1335\t                                         (u/v 'dsg__call_token))\n  1336\t                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n  1337\t                                  (outcome-node\n  1338\t                                    error-tag\n  1339\t                                    (u/app (u/v 'yang.call/condition)\n  1340\t                                           (u/lit :yang.call/invalid-invocation)\n  1341\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n  1342\t                       u/capture)\n  1343\t          routed (if (::invoker env)\n  1344\t                   (u/if-node\n  1345\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n  1346\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n  1347\t                                           (u/lit true)\n  1348\t                                           (cell-ref-shaped-node (u/v callee)))\n  1349\t                                (u/lit false))\n  1350\t                     admitted\n  1351\t                     value-call)\n  1352\t                   admitted)]\n  1353\t      (cond-> (u/mark-tails (u/let1 callee callee-ast\n  1354\t                                    (u/let1 arguments arguments-ast routed)))\n  1355\t        tail? (assoc :tail? true)))))\n  1356\t\n  1357\t\n  1358\t(defn- compile-apply\n  1359\t  \"(apply f a b coll) as one application of f to the assembled argument\n  1360\t   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n  1361\t   serves a guest closure and an adapted native