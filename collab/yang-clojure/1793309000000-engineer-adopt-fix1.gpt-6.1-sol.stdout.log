on-vm [form] (list* 'mk-fresh (map #(list 'quote %) args))))]\n    (testing \"the source carries a multi-arity branch that recurs\"\n      (let [source (get top-forms ['latte_kernel.syntax 'mk-fresh])]\n        (is (= 2 (count (filter #(and (seq? %) (vector? (first %))) source))))\n        (is (contains? (set (walk-symbols source)) 'recur))))\n    (testing \"suffix levels 0 to 5 through collisions, A = C\"\n      (let [forbids [#{}\n                     '#{x}\n                     '#{x x'}\n                     '#{x x' x''}\n                     '#{x x' x'' x'''}\n                     '#{x x' x'' x''' x-4}\n                     '#{x x' x'' x''' x-4 x-5}\n                     '#{y}]]\n        (doseq [forbid forbids]\n          (is (= (a-fn 'x forbid) (c-fn 'x forbid)) (pr-str forbid))\n          (doseq [level (range 6)]\n            (is (= (a-fn 'x level forbid) (c-fn 'x level forbid))\n(ns yang.tails\n  \"Tail marks over the Universal AST, shared by every stage that builds or\n   rewrites a tree. A tail call pushes no frame on the VMs that honour the\n   mark, so a mark is only sound for the tree it was computed over: a stage\n   that wraps a body must strip every mark and recompute them over the whole\n   derived tree, or a wrapped body's old tail calls would skip the wrapper.\"\n  (:require\n    [yin.vm :as vm]))\n\n\n(defn mark-tails\n  \"Set `:tail? true` on every application in tail position of a lambda body,\n   through `if` branches. Definitions are never marked. Lowering relies on\n   this for loops, which are self-applied lambdas: the recursive call and the\n   sequencing lambda around it are both tail calls, so an iteration grows no\n   continuation on the VMs that honour the mark.\"\n  [node]\n  (letfn [(walk\n            [node tail?]\n            (case (:type node)\n              :lambda (assoc node :body (walk (:body node) true))\n              :if (assoc node\n                         :test (walk (:test node) false)\n                         :consequent (walk (:consequent node) tail?)\n                         :alternate (walk (:alternate node) tail?))\n              :application\n              (let [definition? (= 'yin/def (:name (:operator node)))\n                    node (assoc node\n                                :operator (walk (:operator node) false)\n                                :operands (mapv #(walk % false)\n                                                (:operands node)))]\n                (if (and tail? (not definition?))\n                  (assoc node :tail? true)\n                  node))\n              node))]\n    (walk node false)))\n\n\n(defn strip-tails\n  \"`node` with every `:tail?` mark removed, at every depth and under every\n   node type the row grammar knows, so `mark-tails` starts from nothing.\"\n  [node]\n  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\n    (reduce (fn [n [field kind]]\n              (case kind\n                :node (update n field strip-tails)\n                :nodes (update n field #(mapv strip-tails %))\n                n))\n            (dissoc node :tail?)\n            slots)))\n\n\n(defn remark-tails\n  \"Strip every tail mark and recompute them over the whole of `node`.\"\n  [node]\n  (mark-tails (strip-tails node)))\n(ns yin.vm.semantic.frame\n  \"Pure, ordered validation of decoded canonical continuation frames (§3).\"\n  (:require [dao.jing.cbor :as cbor]\n            [yin.vm :as vm]\n            [yin.vm.values :as values]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.semantic.analysis :as analysis]))\n\n\n(defn- problem\n  [kind path]\n  {:yin.k/kind kind :yin.k/path path})\n\n\n(defn- closed?\n  [x required optional]\n  (and (map? x) (every? #(contains? x %) required)\n       (every? (into (set required) optional) (keys x))))\n\n\n(defn task-defect\n  \"X1, once per body, including a halted body with no frames.\"\n  [task]\n  (let [e (:free-env task)]\n    (cond\n      (not (and (map? e) (every? symbol? (keys e))))\n      (problem :free-env-shape [:free-env])\n      (some vm/reserved-name? (keys e))\n      (problem :reserved-name [:free-env]))))\n\n\n(defn- env?\n  [e]\n  (and (closed? e [:yin.k/bindings] [:yin.k/store-of])\n       (or (not (contains? e :yin.k/store-of)) (some? (:yin.k/store-of e)))\n       (map? (:yin.k/bindings e))\n       (every? symbol? (keys (:yin.k/bindings e)))))\n\n\n(defn- lexical-names\n  [v pc]\n  (let [bs (code/body-ranges v)]\n    (loop [b (code/body-index bs pc) names #{}]\n      (if-let [owner (:owner (nth bs b))]\n        (recur (code/body-index bs owner) (into names (nth (nth v owner) 2)))\n        names))))\n\n\n(defn- window-defect\n  [f v rd wanted prefix path]\n  (let [pc (:yin.k/pc f) w (:yin.k/window f)\n        body (nth (code/parse v) (code/body-index (code/body-ranges v) pc))\n        ks (set (keys w))\n        kind (fn [s] (keyword (str prefix s)))\n        p (conj path :yin.k/window)]\n    (cond\n      (some #(>= % (:registers body)) ks) (problem (kind \"window-scope\") p)\n      (and (some? rd) (contains? w rd)) (problem (kind \"window-self\") p)\n      (some #(not (contains? wanted %)) ks) (problem (kind \"window-extra\") p)\n      (some #(not (contains? w %)) wanted) (problem (kind \"window-missing\") p))))\n\n\n(defn- bindings=\n  \"Compare free bindings slotwise by encoder content, retaining host equality\n   for callables and stream, cursor or cell references as data-content= does.\"\n  [a b]\n  (let [opaque? (fn [x]\n                  (or (fn? x) (values/closure? x) (values/continuation? x)\n                      (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x)))))]\n    (and (= (set (keys a)) (set (keys b)))\n         (every? (fn [[k v]]\n                   (let [w (get b k)]\n                     (or (identical? v w)\n                         (if (or (opaque? v) (opaque? w))\n                           (= v w)\n                           (cbor/content= v w))))) a))))\n\n\n(defn defect\n  \"First §3 defect, or nil. Code is already well formed; task is plain\n   {:free-env map :parked-key P :ffi-call-ids set}, plus :completion\n   in the ready context. No engine is read.\n   Values have already passed the carrier's value-domain checks.\"\n  [frame code-map context task]\n  (let [run? (= :run (:yin.k/state frame))\n        act? (= :act (:yin.k/state frame))\n        required (if run?\n                   [:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env :yin.k/window :yin.k/k]\n                   (if act?\n                     [:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env\n                      :yin.k/window :yin.k/deliver :yin.k/k]\n                     [:yin.k/state :yin.k/segment :yin.k/site :yin.k/deliver :yin.k/k]))\n        k (:yin.k/k frame)\n        returns (when (vector? k) (mapv (fn [i] [(nth k i) [:yin.k/k i]]) (range (count k))))\n        all (into [[frame []]] returns)\n        envs (if (or act? run?) all returns)]\n    (or\n      ;; S1-S4, globally before any dependent read.\n      (when-not (and (contains? #{:act :tail :run} (:yin.k/state frame))\n                     (closed? frame required (if run? [] [:yin.k/pending])))\n        (problem :frame-shape []))\n      (when-not (vector? k) (problem :k-shape [:yin.k/k]))\n      (some (fn [[f p]]\n              (when-not (and (closed? f [:yin.k/frame-type :yin.k/segment :yin.k/pc\n                                         :yin.k/env :yin.k/window :yin.k/rd] [])\n                             (= :return (:yin.k/frame-type f)))\n                (problem :k-shape p))) returns)\n      (some (fn [[f p]]\n              (when-not (and (map? (:yin.k/window f))\n                             (every? code/reg? (keys (:yin.k/window f))))\n                (problem :window-representation (conj p :yin.k/window)))) envs)\n      (some (fn [[f p]]\n              (when-not (env? (:yin.k/env f))\n                (problem :env-shape (conj p :yin.k/env)))) envs)\n      (when-not (or run? (map? (:yin.k/deliver frame))) (problem :deliver-shape [:yin.k/deliver]))\n      ;; C1-C3 across the entire continuation.\n      (some (fn [[f p]]\n              (when-not (contains? code-map (:yin.k/segment f))\n                (problem :segment (conj p :yin.k/segment)))) all)\n      (some (fn [[f p]]\n              (let [slot (if (and (empty? p) (not (or act? run?))) :yin.k/site :yin.k/pc)\n                    n (get f slot) v (get code-map (:yin.k/segment f))]\n                (cond\n                  (not (code/reg? n)) (problem :pc-kind (conj p slot))\n                  (not (and (< n (count v)) (or (= slot :yin.k/site) (and run? (empty? p)) (pos? n))))\n                  (problem :pc-bounds (conj p slot))))) all)\n      (some (fn [[f p]]\n              (let [pc (:yin.k/pc f) bs (code/body-ranges (get code-map (:yin.k/segment f)))]\n                (when-not (or (and run? (empty? p)) (= (code/body-index bs (dec pc)) (code/body-index bs pc)))\n                  (problem :pc-body (conj p :yin.k/pc))))) envs)\n      (let [v (get code-map (:yin.k/segment frame))\n            site (cond run? (:yin.k/pc frame) act? (dec (:yin.k/pc frame)) :else (:yin.k/site frame))\n            inst (nth v site) op (first inst) rd (code/rd inst)\n            d (:yin.k/deliver frame)]\n        (or\n          (if run?\n            (window-defect frame v nil (analysis/live (analysis/analyze v) site) \"\" [])\n            (if act?\n              (or\n                (when-not (or (contains? #{:stream-next :stream-put :ffi-call :park :current-continuation} op)\n                              (and (= :call op) (not (code/tail-call? inst))))\n                  (problem :site [:yin.k/pc]))\n                (when-not (= rd (:yin.k/rd d)) (problem :destination [:yin.k/deliver :yin.k/rd]))\n                (when-not (= {:yin.k/deliver :rd :yin.k/rd rd} d) (problem :deliver [:yin.k/deliver]))\n                (window-defect frame v rd (analysis/saved (analysis/analyze v) (:yin.k/pc frame) rd) \"\" []))\n              (or\n            