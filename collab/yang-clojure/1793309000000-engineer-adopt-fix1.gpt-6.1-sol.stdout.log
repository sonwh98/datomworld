{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'machine-data|plain-data|content=' src/cljc/yin/vm/data.cljc; rg -n 'deftest.*mk-fresh|defn-.*syntax|slice4' test/yang/latte_oracle_test.clj; sed -n '515,570p' test/yang/latte_oracle_test.clj; rg -n 'closure|invoke|eligible' collab/1793338209376-engineer-clojure-adoption-s1.kimi-k3.1-pro.findings.md\"","aggregated_output":"484:(defn- data-content=\n493:        (cbor/content= a b))))\n531:   ['content= [2] data-content=]\n434:(deftest test-oracle-slice4-loop-anchors\n469:(deftest test-oracle-slice4-mk-fresh\n          :else f))\n      form)))\n\n\n(defn- a-leg\n  \"The upstream result as a value or a caught ex-info (message and data; a\n   stack trace is never compared).\"\n  [f args]\n  (try {:value (let [v (apply f args)] (if (seq? v) (doall v) v))}\n       (catch clojure.lang.ExceptionInfo e\n         {:thrown {:message (ex-message e), :data (ex-data e)}})))\n\n\n(defn- agrees?\n  \"The outcome `c` is the A leg's value as a success or its exception as the\n   portable error map.\"\n  [a c]\n  (if (contains? a :value)\n    (= [:yin.k/ok (:value a)] c)\n    (= [:yin.k/error {:yin.k/message (get-in a [:thrown :message])\n                      :yin.k/data (get-in a [:thrown :data])}]\n       c)))\n\n\n(defn- ab\n  \"Run upstream `qsym` and the outcome-model C leg (`deps` first) on `args`;\n   returns [a c] and asserts they agree.\"\n  [qsym ns-sym deps args]\n  (let [fname (symbol (name qsym))\n        forms (mapv #(desugar (get top-forms (if (vector? %) % [ns-sym %]))) deps)\n        a (a-leg (upstream-fn qsym) args)\n        c (run-outcome forms (list* fname (map #(list 'quote %) args)))]\n    (is (agrees? a c) (str fname \" \" (pr-str args) \" A=\" (pr-str a) \" C=\" (pr-str c)))\n    [a c]))\n\n\n(deftest test-oracle-slice5-throw-site-fixtures\n  (testing \"utils/safe-get: success and failure\"\n    (let [[a1 _] (ab 'latte-kernel.utils/safe-get 'latte_kernel.utils '[safe-get] ['{:a 1} :a])\n          [a2 c2] (ab 'latte-kernel.utils/safe-get 'latte_kernel.utils '[safe-get] ['{:a 1} :b])]\n      (is (contains? a1 :value))\n      (is (= \"No such value in collection\" (get-in a2 [:thrown :message])))\n      (is (= :yin.k/error (first c2)))))\n  (testing \"utils/zip: even length succeeds, odd length throws\"\n    (doseq [s ['(a b c d) '() '(a b)]]\n      (ab 'latte-kernel.utils/zip 'latte_kernel.utils '[zip] [s]))\n    (let [[a _] (ab 'latte-kernel.utils/zip 'latte_kernel.utils '[zip] ['(a b c)])]\n      ;; upstream is lazy: realizing the sequence is what throws\n      (is (or (contains? a :thrown) (nil? (try (doall (:value a)) nil\n                                               (catch clojure.lang.ExceptionInfo e e)))))))\n  (testing \"defenv/fetch-definition: the non-symbol, non-var branch throws\"\n    (ab 'latte-kernel.defenv/fetch-definition 'latte_kernel.defenv '[fetch-definition]\n        ['[{} {}] 5])\n    (ab 'latte-kernel.defenv/fetch-definition 'latte_kernel.defenv '[fetch-definition]\n        ['[{} {}] 5 true])\n    (ab 'latte-kernel.defenv/fetch-definition 'latte_kernel.defenv '[fetch-definition]\n","exit_code":1,"status":"failed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/yang-oracle-diagnose.clj <<'EOF'\n(require '[yang.latte-oracle-test] '[yin.vm :as vm] '[yin.vm.values :as values] '[clojure.test :as t])\n(def original vm/machine-data?)\n(def \"'^:dynamic *depth* 0)\n(def ''^:dynamic *visits* nil)\n(def ''^:dynamic *seen* nil)\n(defn shape [x]\n  (cond (values/host-typed? x) [:host (shape (values/payload x))]\n        (map? x) [:map (vec (keys x)) (when (:env x) [:env (vec (keys (:env x)))])]\n        (coll? x) [:coll (type x) (count x)]\n        :else (type x)))\n(defn bounded [x]\n  (if (zero? *depth*)\n    (binding [*depth* 1 *visits* (volatile! 0) *seen* (java.util.IdentityHashMap.)]\n      (try (bounded x)\n           (catch Exception e (println \"ROOT\" (shape x)) (throw e))))\n    (binding [*depth* (inc *depth*)]\n      (.put *seen* x true)\n      (when (> (vswap! *visits* inc) 100000)\n        (throw (ex-info \"Validation visit budget exhausted\" {:visits @*visits* :unique (.size *seen*) :depth *depth*})))\n      (original x))))\n(with-redefs [vm/machine-data? bounded]\n  (doseq [v (sort-by #(-> % meta :name) (vals (ns-interns '\"'yang.latte-oracle-test))) :when (:test (meta v))]\n    (println \\\"TEST\\\" (-> v meta :name)) (flush)\n    (t/test-var v)))\n(shutdown-agents)\nEOF\nclj -Sdeps '{:aliases {:diagnose {:main-opts []}}}' -M:test:diagnose /tmp/yang-oracle-diagnose.clj > /tmp/yang-oracle-diagnose.log 2>&1\"","aggregated_output":"","exit_code":130,"status":"failed"}}
