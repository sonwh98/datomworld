{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_1d348552e18b4c068227ab95","type":"tool_result","content":"1080\t          \"MjE1Y2I1YjIzMGMyYTA1Njg2MTZhNTg02BuCcGRhby5qaW5nL2tleXdvcmSCZ3NlZ21lbnR4R2JsYWtlMy02Mjg0OTVmMzY3NTg5\"\n1081\t          \"OGRlMjkwMjVmYzA3ZmE3NWFhMWQxNmRmOWE2M2VkYWYwOGRhZDdjM2MyNzg2MDZjZTYz2BuCcGRhby5qaW5nL2tleXdvcmSCZ3Nl\"\n1082\t          \"Z21lbnR4R2JsYWtlMy0zOThmNjhlMGU1ZWIzMGZkOTYyNTU4MmNiMDYzZjllMDIxMzMzODdkZTdiM2VmZTA3YzUxZWM1ZDUwNDcy\"\n1083\t          \"ODc5\"]))\n1084\t\n1085\t\n1086\t(defn- legacy-payload\n1087\t  \"The decoded pre-fix artifact.\"\n1088\t  []\n1089\t  (cbor/decode (base64/decode legacy-c1-1-payload-b64)))\n1090\t\n1091\t\n1092\t(deftest legacy-artifact-loads-and-runs-test\n1093\t  \"RULING 4: a retained pre-fix artifact loads at its old address and\n1094\t   executes without recompilation, keeping its old operand order and old\n1095\t   behavior; the same source freshly compiled under c1-2 canonicalizes.\"\n1096\t  (let [payload (legacy-payload)\n1097\t        rows (select-keys payload [:root :rows])\n1098\t        program (list (list (quote fn) [(quote x)]\n1099\t                            (insertion-map\n1100\t                              [(list (quote -) (quote x) 1) :a\n1101\t                               (list (quote -) 1 (quote x)) :b]))\n1102\t                      1)\n1103\t        recompiled (yang/compile program)]\n1104\t    (testing \"the artifact is complete and self-consistent\"\n1105\t      (is (= (:root payload) (get-in payload [:rows (:root payload) 0])))\n1106\t      (is (= \"c1-1\" (:manifest-revision payload))))\n1107\t    (testing \"the rows load through the walker loader and run unchanged\"\n1108\t      (let [vm (ast-walker/vm-load-rows (tu/create-vm base-opts)\n1109\t                                        rows vm/ast-contract)]\n1110\t        (is (= (:old-value payload) (vm/value (vm/run vm)))\n1111\t            \"old operand order stays old executable behavior\")))\n1112\t    (testing \"the old order is not the new canonical order\"\n1113\t      (is (pos? (count (get-in payload [:old-operand-roots]))))\n1114\t      (is (not= (:root (vm/ast->semantic-bytecode recompiled))\n1115\t                (:root payload))\n1116\t          \"recompiling the same source mints the canonicalized tree\"))\n1117\t    (testing \"the fresh compilation canonicalizes and changes the winner\"\n1118\t      (let [ctor (first (map-constructors recompiled))]\n1119\t        (is (strictly-ascending? (pair-keys ctor)))\n1120\t        (is (not= (child-roots ctor)\n1121\t                  (vec (:old-operand-roots payload))))\n1122\t        ;; both keys evaluate to 0; the canonically last pair wins now\n1123\t        (is (= (:old-value payload) {0 :b}))\n1124\t        (is (not= {0 :b} (:ast-walker (run-form program {}))))))))\n1125\t\n1126\t\n1127\t(deftest token-admission-distinct-origins-test\n1128\t  \"Admitting the same content under two tokens yields one root and two\n1129\t   distinct origin sets and occurrence-key vectors (the cohort negative\n1130\t   member rule).\"\n1131\t  (let [form {(list (quote tap) :k) (list (quote tap) :v)}\n1132\t        a (project-batch (yang/compile form) \"order-a\")\n1133\t        b (project-batch (yang/compile form) \"order-b\")\n1134\t        origins (fn [batch]\n1135\t                  (into #{} (comp (filter (fn [row] (= :yang/call-site (nth row 3))))\n1136\t                                  (map first))\n1137\t                        (:rows batch)))]\n1138\t    (is (= (:root (:tree a)) (:root (:tree b))))\n1139\t    (is (not= (origins a) (origins b)))\n1140\t    (is (not= (digest-snapshot a) (digest-snapshot b)))))\n1141\t"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"cb80a946-8ba9-4488-901c-1827130cfc04","timestamp":"2026-11-19T15:30:29.133Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_collection_order_test.cljc","content":"          \"MjE1Y2I1YjIzMGMyYTA1Njg2MTZhNTg02BuCcGRhby5qaW5nL2tleXdvcmSCZ3NlZ21lbnR4R2JsYWtlMy02Mjg0OTVmMzY3NTg5\"\n          \"OGRlMjkwMjVmYzA3ZmE3NWFhMWQxNmRmOWE2M2VkYWYwOGRhZDdjM2MyNzg2MDZjZTYz2BuCcGRhby5qaW5nL2tleXdvcmSCZ3Nl\"\n          \"Z21lbnR4R2JsYWtlMy0zOThmNjhlMGU1ZWIzMGZkOTYyNTU4MmNiMDYzZjllMDIxMzMzODdkZTdiM2VmZTA3YzUxZWM1ZDUwNDcy\"\n          \"ODc5\"]))\n\n\n(defn- legacy-payload\n  \"The decoded pre-fix artifact.\"\n  []\n  (cbor/decode (base64/decode legacy-c1-1-payload-b64)))\n\n\n(deftest legacy-artifact-loads-and-runs-test\n  \"RULING 4: a retained pre-fix artifact loads at its old address and\n   executes without recompilation, keeping its old operand order and old\n   behavior; the same source freshly compiled under c1-2 canonicalizes.\"\n  (let [payload (legacy-payload)\n        rows (select-keys payload [:root :rows])\n        program (list (list (quote fn) [(quote x)]\n                            (insertion-map\n                              [(list (quote -) (quote x) 1) :a\n                               (list (quote -) 1 (quote x)) :b]))\n                      1)\n        recompiled (yang/compile program)]\n    (testing \"the artifact is complete and self-consistent\"\n      (is (= (:root payload) (get-in payload [:rows (:root payload) 0])))\n      (is (= \"c1-1\" (:manifest-revision payload))))\n    (testing \"the rows load through the walker loader and run unchanged\"\n      (let [vm (ast-walker/vm-load-rows (tu/create-vm base-opts)\n                                        rows vm/ast-contract)]\n        (is (= (:old-value payload) (vm/value (vm/run vm)))\n            \"old operand order stays old executable behavior\")))\n    (testing \"the old order is not the new canonical order\"\n      (is (pos? (count (get-in payload [:old-operand-roots]))))\n      (is (not= (:root (vm/ast->semantic-bytecode recompiled))\n                (:root payload))\n          \"recompiling the same source mints the canonicalized tree\"))\n    (testing \"the fresh compilation canonicalizes and changes the winner\"\n      (let [ctor (first (map-constructors recompiled))]\n        (is (strictly-ascending? (pair-keys ctor)))\n        (is (not= (child-roots ctor)\n                  (vec (:old-operand-roots payload))))\n        ;; both keys evaluate to 0; the canonically last pair wins now\n        (is (= (:old-value payload) {0 :b}))\n        (is (not= {0 :b} (:ast-walker (run-form program {}))))))))\n\n\n(deftest token-admission-distinct-origins-test\n  \"Admitting the same content under two tokens yields one root and two\n   distinct origin sets and occurrence-key vectors (the cohort negative\n   member rule).\"\n  (let [form {(list (quote tap) :k) (list (quote tap) :v)}\n        a (project-batch (yang/compile form) \"order-a\")\n        b (project-batch (yang/compile form) \"order-b\")\n        origins (fn [batch]\n                  (into #{} (comp (filter (fn [row] (= :yang/call-site (nth row 3))))\n                                  (map first))\n                        (:rows batch)))]\n    (is (= (:root (:tree a)) (:root (:tree b))))\n    (is (not= (origins a) (origins b)))\n    (is (not= (digest-snapshot a) (digest-snapshot b)))))\n","numLines":62,"startLine":1080,"totalLines":1141}},"tool_result_meta":[{"id":"call_1d348552e18b4c068227ab95","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
