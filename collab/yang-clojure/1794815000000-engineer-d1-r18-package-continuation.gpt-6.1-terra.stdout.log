{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/correspondence_manifest_test.clj test/yang/correspondence_dependency_test.clj'","aggregated_output":"(ns yang.correspondence-manifest-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yang.correspondence-dependency :as dependency]\n            [yang.correspondence-manifest :as manifest]))\n\n(defn- sample [handle]\n  (let [source (dependency/store-bundle! handle [[\"src/core.clj\" (.getBytes \"source\" \"UTF-8\")]])\n        binary (dependency/store-bundle! handle [[\"lib/a.jar\" (byte-array [1 2])]])\n        runtime (dependency/store-bundle! handle [[\"runtime.tar\" (byte-array [3 4])]])]\n    {:schema 1\n     :target {:os \"test-os\" :arch \"test-arch\"}\n     :bundles {:sources source :binaries binary :runtime runtime}\n     :classpath [[:sources \"src\"] [:binaries \"lib/a.jar\"]]\n     :runtime-archive [:runtime \"runtime.tar\"]\n     :launch {:entrypoint \"example.main\" :jvm-options [\"-Xss64m\"]\n              :working-directory \".\" :properties {\"file.encoding\" \"UTF-8\"}\n              :environment {\"LANG\" \"C.UTF-8\"}}\n     :pipeline {:compiler-argument true :expansion :unresolved}\n     :retention {:owner \"example\" :discovery \"example-store\"}}))\n\n(deftest manifest-roundtrip-and-transitive-fetch\n  (let [handle (mem/create-content-mem)\n        m (sample handle)\n        address (manifest/store! handle m)\n        fetched (manifest/fetch! handle address)]\n    (is (jing/segment-address? address))\n    (is (= m (:manifest fetched)))\n    (is (= #{:sources :binaries :runtime} (set (keys (:bundles fetched)))))\n    (is (= \"source\" (String. ^bytes (second (first (get-in fetched [:bundles :sources]))) \"UTF-8\")))\n    (is (thrown? Exception (manifest/fetch! (mem/create-content-mem) address)))\n    (let [missing (mem/create-content-mem)\n          dangling (jing/materialize! missing m)]\n      (is (thrown? Exception (manifest/fetch! missing dangling))))))\n\n(deftest malformed-manifests-refuse\n  (let [handle (mem/create-content-mem)\n        m (sample handle)]\n    (doseq [bad [(assoc m :schema 2)\n                 (assoc m :surprise true)\n                 (assoc-in m [:bundles :runtime] :missing)\n                 (assoc-in m [:classpath 0] [:sources \"../escape\"])\n                 (assoc-in m [:classpath 1] [:other \"lib/a.jar\"])\n                 (assoc-in m [:runtime-archive 1] \"missing.tar\")\n                 (assoc-in m [:launch :environment] {\"X\" nil})\n                 (assoc-in m [:pipeline :compiler-argument] false)]]\n      (is (thrown? Exception (manifest/store! handle bad))))))\n(ns yang.correspondence-dependency-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yang.correspondence-dependency :as dependency]\n            [yin.repl.store :as store]))\n\n(deftest dependency-bundle-roundtrip-and-refusal\n  (let [store (mem/create-content-mem)\n        inputs [[\"src/example.clj\" (byte-array [0 1 -1 10])]\n                [\"lib/runtime.jar\" (byte-array [42 0 13])]]\n        address (dependency/store-bundle! store inputs)\n        bundle (dependency/fetch-bundle! store address)]\n    (is (jing/segment-address? address))\n    (is (= (mapv first inputs) (mapv first bundle)))\n    (is (= (mapv (comp vec second) inputs) (mapv (comp vec second) bundle)))\n    (is (thrown? Exception (dependency/store-bundle! store [[\"x\" (byte-array 0)] [\"x\" (byte-array 0)]])))\n    (is (thrown? Exception (dependency/store-bundle! store [[\"../escape\" (byte-array 0)]])))\n    (let [missing (jing/materialize! store {:schema 1 :entries [[\"x\" address]]})]\n      (is (thrown? Exception (dependency/fetch-bundle! store missing))))))\n\n\n(deftest bundle-reopens-and-missing-dependencies-refuse\n  (let [dir (.toFile (java.nio.file.Files/createTempDirectory\n                       \"d1-dependencies-\" (make-array java.nio.file.attribute.FileAttribute 0)))\n        spec {:type :file :dir (.getPath dir)}\n        handle (store/open spec)\n        address (dependency/store-bundle! handle [[\"compiler.clj\" (.getBytes \"source\\n\" \"UTF-8\")]])]\n    (try\n      (jing/close! handle)\n      (let [reopened (store/open spec)]\n        (try\n          (is (= \"source\\n\" (String. ^bytes (second (first (dependency/fetch-bundle! reopened address))) \"UTF-8\")))\n          (finally (jing/close! reopened))))\n      (let [other (mem/create-content-mem)\n            index (let [h (store/open spec)]\n                    (try (jing/get h address nil) (finally (jing/close! h))))\n            dangling (jing/materialize! other index)]\n        (is (thrown? Exception (dependency/fetch-bundle! other dangling))))\n      (finally\n        (doseq [f (reverse (file-seq dir))] (.delete f))))))\n","exit_code":0,"status":"completed"}}
