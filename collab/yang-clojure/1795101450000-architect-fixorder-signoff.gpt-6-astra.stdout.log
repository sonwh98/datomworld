{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/zsh -lc \"sed -n '810,955p' test/yang/clojure_callsite_test.cljc; sed -n '980,1006p' test/yang/clojure_callsite_test.cljc; sed -n '1110,1144p' test/yang/clojure_callsite_test.cljc; sed -n '675,765p' test/yang/clojure_collection_order_test.cljc\"","aggregated_output":"        (is (= :yang/call-site-incomplete-coverage\n               (failure-rule\n                 #(encoder/program-batch\n                    [ast (update-in ast [:operands 0]\n                                    dissoc :yang/call-site)] 0)))))\n      (testing \"a defective first member is caught too\"\n        (is (= :yang/call-site-unsupported-version\n               (failure-rule\n                 #(encoder/program-batch\n                    [(assoc ast :yang/call-site 2) ast] 0)))))))\n  (testing \"the verdicts ride the batch per member\"\n    (let [ast (yang/compile '(+ (* 2 3) 4))]\n      (is (= [true false] (nth (encoder/program-batch\n                                 [ast (strip-call-sites ast)] 0) 5))\n          \"one verdict per member: the marked member claims, the\n           unmarked member does not\")\n      (is (= 5 (count (encoder/program-batch\n                        [(strip-call-sites ast) (strip-call-sites ast)] 0)))\n          \"no member claims: the batch keeps the five-element shape\"))))\n\n\n(deftest per-member-metadata-test\n  (testing \"a claimed sibling never manufactures a table for an\n            unmarked selected member — the selected member's own\n            verdict decides its metadata\"\n    (let [store (macro/seed-store\n                  (macro/make-ctx {:token :callsite-test/standard-forms\n                                   :source-medium :callsite-test/standard-forms})\n                  [macro/stdlib-forms])\n          ctx (macro/make-ctx {:token \"callsite-test\"\n                               :source-medium :program-in\n                               :store store})\n          marked (yang/compile '(+ (* 2 3) 4))\n          unmarked (strip-call-sites marked)\n          ;; tree 0 claims, tree 1 (the run tree) does not\n          batch (encoder/program-batch [marked unmarked] 1)]\n      (is (= [true false] (nth batch 5)))\n      (let [{:keys [status frontend-metadata]}\n            (macro/expand-batch batch ctx)]\n        (is (= :ok status))\n        (is (nil? frontend-metadata)\n            \"the unmarked run member's own verdict made no table\"))\n      (testing \"the same batch with the claimed member selected finalizes its table\"\n        (let [batch (encoder/program-batch [marked unmarked] 0)\n              {:keys [status frontend-metadata]}\n              (macro/expand-batch batch ctx)]\n          (is (= :ok status))\n          (is (seq frontend-metadata)))))))\n\n\n(deftest publish-version-reason-test\n  (testing \"a present-but-wrong marker version refuses with the\n            unsupported-version reason, never incomplete coverage\"\n    (doseq [bad-value [false nil 0 \"1\" true]]\n      (testing (pr-str bad-value)\n        (let [store (mem/create-content-mem)\n              ast (assoc (yang/compile-program '[(defn f\n                                                   [x]\n                                                   (inc x)) (f 2)])\n                         :yang/call-site bad-value)\n              res (publish/publish-module!\n                    store {:name 'bad-version-value\n                           :ast ast\n                           :exports #{'f}\n                           :requires {}\n                           :primitives {'inc {:yin.k/profile :yin.k/pure\n                                              :yin.k/effects #{}}}})]\n          (is (= :refused (:status res)))\n          (is (= :yin.link.publish/unsupported-call-site-version\n                 (:reason res)))\n          (is (= bad-value (:unsupported-version res)))\n          (is (nil? (:address res))))))))\n\n\n(def ^:private publish-registry\n  \"The host registry the published-module test publishes over: the\n   `cell` and `data` host modules the `clj` and `yang.call` module\n   trees read.\"\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})))\n\n\n(defn replay-artifacts\n  \"The cc4 portable replay corpus. All admission coordinates and naming inputs\n   are supplied data. Kept public so the separately declared budget runner can\n   retain exactly the artifacts whose digests the equality gate checks.\"\n  ([] (replay-artifacts true))\n  ([annotated?]\n   (let [prepare (if annotated? identity\n                     #(walk/postwalk (fn [n]\n                                       (if (map? n)\n                                         (dissoc n :yang/call-site) n)) %))\n         forms '[(defn replay\n                   [x]\n                   (let [[a b] [x 1.5]]\n                     (+ (identity ^:replay a) (identity ^:replay a) b)))\n                 (replay 2)]\n         projected (fn [id ast token]\n                     (let [ast (prepare ast)\n                           p (encoder/project\n                               (encoder/source-envelope :cc4/replay token [ast]))]\n                       {:id id :compiled ast :tree (first (:yin/batch p))\n                        :rows (:yin/frontend-metadata p)}))\n         ast (yang/compile-program forms)\n         macro-ast (yang/compile-program\n                     '[(defmacro twin\n                         [x]\n                         (yin/if (yin/literal true) x\n                                 (yin/application (yin/variable 'f) [(yin/literal 1)])))\n                       (defn f\n                         [x]\n                         x) (twin (f 1))])\n         expansion (:result (expand-like-the-repl (prepare macro-ast)))\n         store (mem/create-content-mem)\n         call-spec (update (call/module-spec publish-registry) :ast prepare)\n         call-result (publish/publish-module! store call-spec)\n         clj-spec (update (clj-prelude/module-spec publish-registry (:address call-result))\n                          :ast prepare)\n         clj-result (publish/publish-module! store clj-spec)\n         published (fn [id result spec]\n                     (let [table (publish/published-call-site-table store result)]\n                       {:id id :compiled (:ast spec)\n                        :tree (or (:tree table) (vm/ast->semantic-bytecode (:ast spec)))\n                        :rows (or (:rows table) [])\n                        :addresses (assoc (dissoc (:call-sites result) :origin)\n                                          :manifest (:address result))\n                        :published-payloads\n                        (when (:call-sites result)\n                          (mapv #(jing/get store % nil)\n                                (map (:call-sites result) [:table :provenance :record])))\n                        :provenance (publish/published-instruction-provenance store result)}))]\n     [(projected :native ast \"admission-a\")\n      (projected :argument-vector (yang/compile-program forms true yang/unit-opts)\n                 \"admission-a\")\n      (projected :lower-unit (yang/lower-unit forms) \"admission-a\")\n      (projected :prelude clj-prelude/module-uast \"admission-a\")\n      {:id :macro :compiled (prepare macro-ast) :status (:status expansion)\n       :tree (macro/packet->row-set (:tree expansion))\n       :rows (:frontend-metadata expansion) :expansion-log (:log expansion)}\n      (projected :negative ast \"admission-b\")\n      (published :yang.call call-result call-spec)\n      (published :clj clj-result clj-spec)])))\n\n\n(defn- collection-constructors\n  [{:keys [id tree rows addresses provenance expansion-log status]}]\n  (let [c1 (vec (sort jing/canonical-compare\n                      (filter #(= :yang/call-site (nth % 3)) rows)))\n        keys (vec (sort jing/canonical-compare (marked rows)))\n        sem (linearize/project-rows tree nil rows)\n        stack (derive/stack-image (:vector sem)\n                                  {:segment-address :cc4/stack\n                                   :call-provenance (:call-provenance sem)})\n        register (derive/register-image (:vector sem)\n                                        {:segment-address :cc4/register\n                                         :call-provenance (:call-provenance sem)})]\n    (cond-> {:id id :root (:root tree) :applications (count keys)\n             :keys-digest (jing/content-hash keys)\n             :c1-digest (jing/content-hash c1)\n             :instruction-provenance-digest\n             (jing/content-hash [(:call-provenance sem)\n                                 (:call-provenance stack)\n                                 (:call-provenance register)])}\n      addresses (assoc :addresses addresses)\n      provenance (assoc :provenance-digest (jing/content-hash provenance))\n      expansion-log (assoc :expansion-log-digest (jing/content-hash expansion-log)\n                           :expansion-status status))))\n\n\n(def replay-expectations\n  \"The cc4 cohort's fixed expectations, shared by all hosts. Originally\n   recorded on the JVM at dispatch revision 2687ab0c; re-pinned once under\n     :segment/blake3-20d2e0c43539dbf3cb66fe04e6cffea673772d06d32f753b131de6f17d3daf35,\n     :table\n     :segment/blake3-167c6aeaedace3afd945c6b7c0f1aa31f73df5d4577366fdd2431059633c1050,\n     :provenance\n     :segment/blake3-3a43087e7ea783baa6e2f6f4041dc60c6f83aee4bc49842c871d2d20c12056c6,\n     :root\n     :segment/blake3-2c3a3fa3ff94adf2e22582426e616ddbca5acb45eeff283e20bed6543f4b1a8c,\n     :manifest\n     :segment/blake3-72efd5cba6d2c36bacae7a114fca2db95b5ef5cfe966d004d16e9e39a7179ee0},\n    :provenance-digest\n    \"499f103a2af205e818483bb4ca301668bc8cf13d6e16f71e747ff0255b865287\"}])\n\n\n(deftest portable-replay-cohort-test\n  (let [artifacts (replay-artifacts)\n        snapshots (mapv replay-snapshot artifacts)]\n    (when (not= replay-expectations snapshots)\n      (doseq [[expected actual artifact] (map vector replay-expectations snapshots artifacts)\n              :when (not= expected actual)]\n        ;; Preserve the producer's actual rows and canonical tree. A failed\n        ;; equality gate is a defect report, never permission to re-pin a host.\n        (prn :cc4/replay-divergence\n             {:expected expected :actual actual\n              :artifact (select-keys artifact [:id :tree :rows :expansion-log])})))\n    (is (= replay-expectations snapshots))\n    (doseq [{:keys [id tree rows]} artifacts]\n      (testing (str id)\n        (is (= (occurrence-pairs tree) (marked-pairs rows)))))\n    (let [a (first artifacts) b (nth artifacts 5)]\n      (is (= (:root (:tree a)) (:root (:tree b))))\n      (is (not= (row-origins (:rows a)) (row-origins (:rows b)))))))\n\n\n(deftest constructed-collection-operand-order-test\n  \"constructed-collections-v1 (ruling 1795017757000): the reproduced\n      [x]\n      (let [[a b] [x 1.5]]\n        (+ (identity ^:replay a) (identity ^:replay a) b)))\n    (replay 2)])\n\n\n(def ^:private named-arity-operand-roots\n  \"The ruled operand vector of the named arity map, recorded on the JVM.\n   The children compile identically before and after the ordering fix\n   (each child row is unchanged content), so these addresses held under\n   c1-1 and hold under c1-2: only their order is the fix.\"\n  [;; {} seed\n   :segment/blake3-201f235cbac998f43954454e9df0eb633717e79de535776f3f51e198a3759b10\n   ;; :yin.k/fn  'replay\n   :segment/blake3-1e03667ec9fa05b20761de3b84f623962235ff218fce26401bbcdd9d3aabeca8\n   :segment/blake3-3156a0708410c1e18d4eb15f567790a8c1ac683f219e720a847b0e21e54ca778\n   ;; :yin.vm.data/reason  :arity\n   :segment/blake3-81b62c1e0dbf783ce555376690c9cffdee2eaca50ff9da4247397a785d9340cf\n   :segment/blake3-1db5dbd048522aa048759e5fb8ae47ccbf9e158906554b362080d77cf30a6178\n   ;; :yin.k/argc  (data/count dsg__av)\n   :segment/blake3-8930bf5e7b03638896bc3bef03d4f1ae648e7460ed4b488bef2b9d5f619cbd90\n   :segment/blake3-e60543d220d61497d02184c1f7a087c15c3a20d0f305cae88647987f5ec99e3b])\n\n\n(def ^:private named-arity-key-order\n  \"The ruled pair order of the named arity map (key roots 1e0366, 81b62c,\n   8930bf -- the ruling's pinned child rows).\"\n  [:yin.k/fn :yin.vm.data/reason :yin.k/argc])\n\n\n(defn- arity-map-constructors\n  \"The constructed maps naming an arity error: an operand literal key\n   :yin.k/fn (named) or :yin.k/kind (anonymous).\"\n  [ast]\n  (into []\n        (filter (fn [c]\n                  (some (fn [o]\n                          (and (= :literal (:type o))\n                               (contains? #{:yin.k/fn :yin.k/kind}\n                                          (:value o))))\n                        (:operands c))))\n        (map-constructors ast)))\n\n\n(deftest arity-map-canonical-order-test\n  (testing \"the reproduced named case: argument-vector and lower-unit members\"\n    (doseq [[label ast] [[:argument-vector\n                          (yang/compile-program cohort-forms true yang/unit-opts)]\n                         [:lower-unit\n                          (yang/lower-unit cohort-forms)]]\n            :let [ctors (arity-map-constructors ast)]]\n      (testing (str label)\n        (is (pos? (count ctors)))\n        (doseq [c ctors]\n          (is (= named-arity-key-order (key-literals c)))\n          ;; the recorded vector pins the replay member; other named arity\n          ;; maps (the library's identity) differ only in the fn value root\n          (is (= (assoc named-arity-operand-roots 2 (nth (child-roots c) 2))\n                 (child-roots c)))\n          (is (strictly-ascending? (pair-keys c)))\n          (is (= empty-map-seed-root (first (child-roots c))))\n          ;; the fn value is the named function's symbol, the argc value the\n          ;; count application, the reason value :arity\n          (is (contains? #{'replay 'identity}\n                         (:value (nth (:operands c) 2))))\n          (is (= :arity (:value (nth (:operands c) 4))))\n          (is (= 'data/count\n                 (get-in (nth (:operands c) 6) [:operator :name])))))))\n  (testing \"the anonymous arity error, without and with reader position\"\n    (doseq [[label forms] [[:anonymous (list (with-meta '(fn [x] x) nil))]\n                           [:anonymous-with-source\n                            (list (with-meta '(fn [x] x)\n                                    {:line 7 :column 2}))]]\n            :let [ast (yang/compile-program forms true yang/unit-opts)\n                  ctors (arity-map-constructors ast)]]\n      (testing (str label)\n        (is (= 1 (count ctors)))\n        (let [c (first ctors)]\n          (is (strictly-ascending? (pair-keys c)))\n          (if (= label :anonymous)\n            (do (is (= [:yin.k/kind :yin.vm.data/reason :yin.k/argc]\n                       (key-literals c)))\n                (is (= :anonymous (:value (nth (:operands c) 2)))))\n            (do (is (= [:yin.k/kind :yin.k/source :yin.vm.data/reason :yin.k/argc]\n                       (key-literals c)))\n                (is (= {:line 7 :column 2}\n                       (:value (nth (:operands c) 4))))))))))\n  (testing \"the payload values an arity error raises at runtime\"\n    (is (= [:yin.k/error {:yin.k/fn 'two\n                          :yin.vm.data/reason :arity\n                          :yin.k/argc 2}]\n","exit_code":0,"status":"completed"}}
