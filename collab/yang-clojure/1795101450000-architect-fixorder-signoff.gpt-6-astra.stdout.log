apshots.edn\\\")\\nshutil.copy(res, Path(\\\"test/resources/yang/clojure/cc4-replay-snapshots-prefix-c1-1.edn\\\"))\\n\\nfor f in [res, Path(\\\"test/yang/clojure_callsite_test.cljc\\\")]:\\n    t = f.read_text()\\n    for old, new in pairs.items():\\n        n = t.count(old)\\n        assert n >= 1, (f, old)\\n        t = t.replace(old, new)\\n    f.write_text(t)\\n    print(\\\"re-pinned\\\", f)\\n\\n# header comment on the re-pinned resource\\nt = res.read_text()\\nheader = (\\\";; The post-fix reference bundle (manifest c1-2, constructed-collections-v1\\\\n\\\"\\n          \\\";; re-pin per ruling 1795017757000): re-recorded on the JVM for all eight\\\\n\\\"\\n          \\\";; members after the constructed-collection operand-ordering fix; only the\\\\n\\\"\\n          \\\";; argument-vector and lower-unit members changed bytes. The pre-fix bundle\\\\n\\\"\\n          \\\";; is retained verbatim as cc4-replay-snapshots-prefix-c1-1.edn, and the r2\\\\n\\\"\\n          \\\";; defect evidence (cc4-replay-dart-divergences.edn, cc4-replay-jvm*.*) stays\\\\n\\\"\\n          \\\";; immutable.\\\\n\\\")\\nres.write_text(header + t)\\nprint(\\\"header added\\\")\\nPYEOF\",\"description\":\"Archive pre-fix bundle and re-pin digests\"}},{\"tool_name\":\"Bash\",\"tool_use_id\":\"call_9ed02a1a9f204497b010687f\",\"tool_input\":{\"command\":\"python3 - <<'PYEOF'\\nfrom pathlib import Path\\np = Path(\\\"test/yang/clojure_callsite_test.cljc\\\")\\nt = p.read_text()\\nold = \\\"\\\"\\\"(def replay-expectations\\n  \\\"Recorded once on the JVM at dispatch revision 2687ab0c; shared by all hosts.\\\")\\\"\\\"\\\"\\nnew = \\\"\\\"\\\"(def replay-expectations\\n  \\\"The cc4 cohort's fixed expectations, shared by all hosts. Originally\\n   recorded on the JVM at dispatch revision 2687ab0c; re-pinned once under\\n   manifest c1-2 (constructed-collections-v1, ruling 1795017757000) after\\n   the collection emitter began ordering constructor operands by compiled\\n   content -- the argument-vector and lower-unit members changed canonical\\n   bytes, the other six members are byte-identical. The pre-fix bundle is\\n   retained at test/resources/yang/clojure/cc4-replay-snapshots-prefix-c1-1.edn.\\\")\\\"\\\"\\\"\\nassert old in t; t = t.replace(old, new)\\n\\n# focused regression addition after the cohort test\\nanchor = \\\"\\\"\\\"(deftest portable-replay-cohort-test\\n  (let [artifacts (replay-artifacts)\\n        snapshots (mapv replay-snapshot artifacts)]\\n    (when (not= replay-expectations snapshots)\\n      (doseq [[expected actual artifact] (map vector replay-expectations snapshots artifacts)\\n              :when (not= expected actual)]\\n        ;; Preserve the producer's actual rows and canonical tree. A failed\\n        ;; equality gate is a defect report, never permission to re-pin a host.\\n        (prn :cc4/replay-divergence\\n             {:expected expected :actual actual\\n              :artifact (select-keys artifact [:id :tree :rows :expansion-log])})))\\n    (is (= replay-expectations snapshots))\\n    (doseq [{:keys [id tree rows]} artifacts]\\n      (testing (str id)\\n        (is (= (occurrence-pairs tree) (marked-pairs rows)))))\\n    (let [a (first artifacts) b (nth artifacts 5)]\\n      (is (= (:root (:tree a)) (:root (:tree b))))\\n      (is (not= (row-origins (:rows a)) (row-origins (:rows b)))))))\\\"\\\"\\\"\\naddition = anchor + \\\"\\\"\\\"\\n\\n\\n(deftest constructed-collection-operand-order-test\\n  \\\"constructed-collections-v1 (ruling 1795017757000): the reproduced\\n   arity-map constructor emits its pairs in compiled-content order --\\n   ascending jing/canonical-compare over the children's projected\\n   [key-root value-root] -- so both cohort members carrying it compile to\\n   one operand vector on every host. The full battery for the ordering\\n   lives in yang.clojure-collection-order-test.\\\"\\n  (letfn [(arity-ctors [ast]\\n            (->> (collection-constructors ast)\\n                 (filter (fn [c]\\n                           (some (fn [o] (and (= :literal (:type o))\\n                                              (contains? #{:yin.k/fn :yin.k/kind}\\n                                                         (:value o))))\\n                                 (:operands c))))))\\n          (pair-keys [c]\\n            (mapv vec (partition 2 (rest (mapv #(get (vm/ast->semantic-bytecode %)\\n                                                     :root)\\n                                               (:operands c))))))\\n          (sorted? [ks]\\n            (every? (fn [[a b]] (neg? (jing/canonical-compare a b)))\\n                    (partition 2 1 ks)))]\\n    (doseq [[label ast] [[:argument-vector\\n                          (yang/compile-program\\n                            '[(defn replay\\n                                [x]\\n                                (let [[a b] [x 1.5]]\\n                                  (+ (identity ^:replay a)\\n                                     (identity ^:replay a) b)))\\n                              (replay 2)]\\n                            true yang/unit-opts)]\\n                         [:lower-unit\\n                          (yang/lower-unit\\n                            '[(defn replay\\n                                [x]\\n                                (let [[a b] [x 1.5]]\\n                                  (+ (identity ^:replay a)\\n                                     (identity ^:replay a) b)))\\n                              (replay 2)])]]]\\n      (testing (str label)\\n        (let [ctors (arity-ctors ast)]\\n          (is (pos? (count ctors)))\\n          (doseq [c ctors]\\n            (is (sorted? (pair-keys c)))\\n            ;; the ruled named order: :yin.k/fn, :yin.vm.data/reason,\\n            ;; :yin.k/argc (key roots 1e0366, 81b62c, 8930bf)\\n            (is (= [:yin.k/fn :yin.vm.data/reason :yin.k/argc]\\n                   (mapv (fn [i] (:value (nth (:operands c) (* 2 i))))\\n                         (range 3))))))))))\\\"\\\"\\\"\\nassert anchor in t\\nt = t.replace(anchor, addition)\\n\\n# the constructor finder helper (private, near the cohort helpers)\\nhelper_anchor = \\\"\\\"\\\"(defn replay-snapshot\\\"\\\"\\\"\\nhelper = \\\"\\\"\\\"(defn- collection-constructors\\n  \\\"The constructed-collection applications of compiled `ast`: an assoc over\\n   the {} seed or a conj over the []/#{} seed (yang.clojure's collection\\n   emitter's output).\\\"\\n  [ast]\\n  (let [acc (atom [])]\\n    (walk/postwalk\\n      (fn [n]\\n        (when (and (map? n)\\n                   (= :application (:type n))\\n                   (= :variable (get-in n [:operator :type]))\\n                   (= :literal (get-in n [:operands 0 :type]))\\n                   (contains? #{['assoc {}] ['conj []] ['conj #{}]}\\n                              [(get-in n [:operator :name])\\n                               (get-in n [:operands 0 :value])]))\\n          (swap! acc conj n))\\n        n)\\n      ast)\\n    @acc))\\n\\n\\n(defn replay-snapshot\\\"\\\"\\\"\\nassert helper_anchor in t\\nt = t.replace(helper_anchor, helper, 1)\\np.write_text(t)\\nprint(\\\"focused addition + helper in place\\\")\\nPYEOF\",\"description\":\"Add focused ordering regression to callsite battery\"}},{\"tool_name\":\"Bash\",\"tool_use_id\":\"call_549bc9dbdba74e8585bcb60d\",\"tool_input\":{\"command\":\"python3 - <<'PYEOF'\\nfrom pathlib import Path\\np = Path(\\\"test/fixorder_tmp_gen_test.cljc\\\")\\nt = p.read_text()\\nold = \\\"\\\"\\\"(deftest gate-kondo-test\\\"\\\"\\\"\\nnew = \\\"\\\"\\\"(deftest gate-jvm-compiler-tests-test\\n  (run! \\\"jvm-compiler\\\" [\\\"clojure\\\" \\\"-M:test\\\"\\n                        \\\"-n\\\" \\\"yang.clojure-test\\\"\\n                        \\\"-n\\\" \\\"yang.frontend-test\\\"\\n                        \\\"-n\\\" \\\"yin.repl.frontend-catalog-test\\\"]))\\n\\n(deftest gate-npm-test\\n  (run! \\\"npm\\\" [\\\"/Users/sto/.local/share/mise/shims/bb\\\"\\n            