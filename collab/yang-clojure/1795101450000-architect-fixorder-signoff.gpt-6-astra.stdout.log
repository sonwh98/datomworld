            (filter (fn [c]\n+                           (some (fn [o]\n+                                   (and (= :literal (:type o))\n+                                        (contains? #{:yin.k/fn :yin.k/kind}\n+                                                   (:value o))))\n+                                 (:operands c))))))\n+          (pair-keys\n+            [c]\n+            (mapv vec\n+                  (partition 2\n+                             (rest (mapv (fn [o] (:root (vm/ast->semantic-bytecode o)))\n+                                         (:operands c))))))\n+          (sorted-ascending?\n+            [ks]\n+            (every? (fn [[a b]] (neg? (jing/canonical-compare a b)))\n+                    (partition 2 1 ks)))]\n+    (doseq [[label ast] [[:argument-vector\n+                          (yang/compile-program\n+                            (quote [(defn replay\n+                                      [x]\n+                                      (let [[a b] [x 1.5]]\n+                                        (+ (identity ^:replay a)\n+                                           (identity ^:replay a) b)))\n+                                    (replay 2)])\n+                            true yang/unit-opts)]\n+                         [:lower-unit\n+                          (yang/lower-unit\n+                            (quote [(defn replay\n+                                      [x]\n+                                      (let [[a b] [x 1.5]]\n+                                        (+ (identity ^:replay a)\n+                                           (identity ^:replay a) b)))\n+                                    (replay 2)]))]]]\n+      (testing (str label)\n+        (let [ctors (arity-ctors ast)]\n+          (is (pos? (count ctors)))\n+          (doseq [c ctors]\n+            (is (sorted-ascending? (pair-keys c)))\n+            ;; the ruled named order: :yin.k/fn, :yin.vm.data/reason,\n+            ;; :yin.k/argc (key roots 1e0366, 81b62c, 8930bf)\n+            (is (= [:yin.k/fn :yin.vm.data/reason :yin.k/argc]\n+                   (mapv (fn [i] (:value (nth (:operands c) (inc (* 2 i)))))\n+                         (range 3))))))))))\n+\n+\n (deftest published-module-test\n   (testing \"the markers are retrievable from the published module\"\n     (let [store (mem/create-content-mem)\n","exit_code":0,"status":"completed"}}
