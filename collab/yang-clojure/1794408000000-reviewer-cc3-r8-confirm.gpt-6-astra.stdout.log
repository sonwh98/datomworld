bs]\n  2216\t                           (let [v (try (cbor/decode bs)\n  2217\t                                        (catch #?(:cljd Object :clj Exception\n  2218\t                                                  :cljs :default) _ nil))]\n  2219\t                             (when (and @fail? (map? v)\n  2220\t                                        (contains? v fail-key))\n  2221\t                               (throw (ex-info \"store refused the provenance write\"\n  2222\t                                               {})))\n  2223\t                             ((:put-bytes-fn inner) address bs))))\n  2224\t            [s1 _] (repl/eval-input\n  2225\t                     (repl-frontends/create-state {:index-store store})\n  2226\t                     \"(def k (fn [] 1))\")\n  2227\t            [s2 _] (repl/eval-input s1 \"(def g (fn [] (+ (k) 41)))\")\n  2228\t            handles-before (repl/call-provenance-handles s2)]\n  2229\t        (is (seq handles-before) \"precondition: earlier retention completed\")\n  2230\t        (reset! fail? true)\n  2231\t        (let [[s3 text] (repl/eval-input s2 \"(g)\")\n  2232\t              failures (repl/call-provenance-failures s3)]\n  2233\t          (is (str/starts-with? text \"42\\nWarning: \")\n  2234\t              \"evaluation completes; the failure rides the round's Warning\")\n  2235\t          (is (str/includes? text \"call provenance was not retained\"))\n  2236\t          (is (str/includes? text (str label \" failed\")))\n  2237\t          (is (= 1 (count failures)))\n  2238\t          (is (= stage (:stage (first failures))))\n  2239\t          (is (some? (:admission (first failures)))\n  2240\t              \"the diagnostic is admission-scoped\")\n  2241\t          (is (= handles-before (repl/call-provenance-handles s3))\n  2242\t              \"no incomplete handle; earlier completed handles survive\")\n  2243\t          (let [[s4 text4] (repl/eval-input s3 \"42\")]\n  2244\t            (is (= \"42\" text4)