   (update :call-provenance-handles\n2070:                                          (::call-provenance-handles d)\n2071:                                          (:call-provenance-handles\n2076:                                  (or (::call-provenance-failures d)\n2077:                                      (seq (:call-provenance-failures\n2079:                                  (assoc :call-provenance-failures\n2082:                                         :call-provenance-round-failures\n2172:              (with-index-notice\n2496:(defn- recheck-pending*\n2548:                             (::call-provenance-handles d)\n2549:                             (update :call-provenance-handles\n2551:                                     (::call-provenance-handles d))\n2553:                             (::call-provenance-failures d)\n2554:                             (assoc :call-provenance-failures\n2555:                                    (::call-provenance-failures d)\n2556:                                    :call-provenance-round-failures\n2557:                                    (::call-provenance-round-failures d)))\n2576:    (recheck-pending* state nil false)\n2599:      (recheck-pending* state nil true)\n2619:  (recheck-pending* state {:trimmed trimmed, :parsed parsed} false))\n","exit_code":0,"status":"completed"}}
