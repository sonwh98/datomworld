he input is incomplete.\"\n  1248\t  [s]\n  1249\t  (loop [chars (seq s)\n  1250\t         depth 0\n  1251\t         in-str? false]\n  1252\t    (if (empty? chars)\n  1253\t      depth\n  1254\t      (let [ch (first chars)\n  1255\t            tail (rest chars)]\n  1256\t        (cond in-str? (cond (= ch \\\\) (recur (rest tail) depth true)\n  1257\t                            (= ch \\\") (recur tail depth false)\n  1258\t                            :else (recur tail depth true))\n  1259\t              (= ch \\\") (recur tail depth true)\n  1260\t              (= ch \\;) (recur (drop-while #(not= % \\newline) tail) depth false)\n  1261\t              (#{\\( \\[ \\{} ch) (recur tail (inc depth) false)\n  1262\t              (#{\\) \\] \\}} ch) (recur tail (dec depth) false)\n  1263\t              :else (recur tail depth false))))))\n  1264\t\n  1265\t\n  1266\t;; =============================================================================\n  1267\t;; Evaluation\n  1268\t;; =============================================================================\n  1269\t\n  1270\t(defn- inject-last-value\n  1271\t  [state]\n  1272\t  (update state :vm update :store assoc\n  1273\t          '*1 (:last-value state)\n  1274\t          '*2 (:last-value-2 state)\n  1275\t          '*3 (:last-value-3 state)))\n  1276\t\n  1277\t\n  1278\t(defn- record-last-value\n  1279\t  [state state-after value]\n  1280\t  (assoc state-after\n  1281\t         :last-value value\n  1282\t         :last-value-2 (:last-value state)\n  1283\t         :last-value-3 (:last-value-2 state)))\n  1284\t\n  1285\t\n  1286\t(defn- round-id\n  1287\t  \"The identity of the state's current round: the shell's token, minted\n  1288\t   once per shell value, with its round count.  A medium the caller\n  1289\t   supplies may already hold results from another shell or an earlier\n  1290\t   round; none of them carries this identity.\"\n  1880\t   (if-let [parked (:pending-run state)]\n  1881\t     (let [[state' text] (drain-output state)\n  1882\t           ;; installs first: their waiters leave the wait set with the\n  1883\t           ;; refusal queued, then every remaining link entry retires\n  1884\t           vm (engine/abandon-installs (:vm parked) reason)\n  1885\t           error (try\n  1886\t                   (vm/run (reduce (fn [vm e]\n  1887\t                                     (engine/abandon-link vm (:link-id e)\n  1888\t                                                          reason))\n  1889\t                                   vm\n  1890\t                                   (:wait-set vm)))\n  1891\t                   nil\n  1892\t                   (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n  1893\t                     e))\n  1894\t           retired (link/retire (:linker state')\n  1895\t                                (link/run-descriptor (:base parked) vm))]\n  1896\t       [(assoc state'\n  1897\t               :vm (query/discard-answers\n  1898\t                     (carry-link-identity (:base parked) vm)\n  1899\t                     (:query-pair state'))\n  1900\t               :linker (dissoc retired :retired)\n  1901\t               :pending-run nil)\n  1902\t        (str text\n  1903\t             ended-text\n  1904\t             (if error (format-error error) \"\")\n  1905\t             (dropped-lines-text (count (:pending-lines parked))))])\n  1906\t     [state \"Nothing is pending\"])))\n  1907\t\n  1908\t\n  1909\t(defn- consult-link-policy\n  1910\t  \"Consult the shell's `:link-policy` over a run that is still pending --\n  1911\t   when the require parks, and after each re-check that leaves it so;\n  1912\t   never on a re-check that completes it (yin.repl.link-policy.md\n  1913\t   section 3.2).  `text` is what the round printed so far and\n  1914\t   `kept-text` what a kept run reports.  `:manual` is never consulted\n  1915\t   and keeps the run; a function's `:keep` keeps it; `:abandon` or\n  1916\t   `{:abandon reason}` runs the same abandon path as `(abandon)`, the\n  1917\t   reason defaulting to `:yin.repl/link-policy`; a throw or a return\n  1918\t   outside the contract is a `:keep` for this consult plus one shell\n  1919\t   error line -- never a silent abandon, never session death (section\n  1920\t   3.4).  The view the function receives is plain data, no clock, no\n  1921\t   handle, no secret (section 3.1).  Returns `[state text]`.\"\n  1922\t  [state text kept-text]\n  1923\t  (if-not (fn? (:link-policy state))\n  1924\t    [state (str text kept-text)]\n  1925\t    (let [parked (:pending-run state)\n  1926\t          answer (try\n  1927\t                   {:answer ((:link-policy state)\n  1928\t                             {:links (mapv (fn [p]\n  1929\t                                             {:name (:name p)\n  1930\t                                              :link-id (:yin.link/id p)})\n  1931\t                                           (:links parked))\n  1932\t                              :checks (or (:checks parked) 0)\n  1933\t                              :lines-retained\n  1934\t                              (count (:pending-lines parked))})}\n  1935\t                   (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n  1936\t                     {:thrown e}))]\n  1937\t      (cond\n  1938\t        (:thrown answer)\n  1939\t        [state (str text kept-text (format-error (:thrown answer)) \"\\n\")]\n  1940\t\n  1941\t        (= :keep (:answer answer))\n  1942\t        [state (str text kept-text)]\n  1943\t\n  1944\t        (= :abandon (:answer answer))\n  1945\t        (let [[state' text'] (abandon-pending state :yin.repl/link-policy\n  1946\t                                              policy-abandon-text)]\n  1947\t          [state' (str text text')])\n  1948\t\n  1949\t        (and (map? (:answer answer))\n  1950\t             (= #{:abandon} (set (keys (:answer answer)))))\n  1951\t        (let [reason (or (:abandon (:answer answer)) :yin.repl/link-policy)\n  1952\t              [state' text'] (abandon-pending state reason\n  1953\t                                              policy-abandon-text)]\n  1954\t          [state' (str text text')])\n  1955\t\n  1956\t        :else\n  1957\t        [state\n  1958\t         (str text\n  1959\t              kept-text\n  1960\t              (format-error\n  1961\t                (ex-info\n  1962\t                  \"Link policy returned a value outside its contract\"\n  1963\t                  {:answer (:answer answer)\n  1964\t                   :contract [:keep :abandon {:abandon :reason}]}))\n  1965\t              \"\\n\")]))))\n  1966\t\n  1967\t\n  1968\t(defn- pending-eval\n  1969\t  \"Answer a round whose require did not complete: the parked VM, its\n  1970\t   round-start base, and the pending links are the shell's\n  1971\t   `:pending-run`, and the prompt returns.  Nothing is wedged: another\n  1972\t   line re-checks the link, the host may step one itself with\n  1973\t   `recheck-pending`, the link policy is consulted as the run parks, and\n  1974\t   `(reset)` or `(vm ...)` drops it with the session.  What a frontend\n  1975\t   staged for the round rides on the run, committed only if it completes.\"\n  1976\t  [state state' vm' pending]\n  1977\t  (let [[state'' text] (drain-output state')]\n  1978\t    (consult-link-policy\n  1979\t      (assoc state''\n  1980\t             :vm vm'\n  1981\t             :pending-run (cond-> {:vm vm'\n  1982\t                                   :base (:vm state)\n  1983\t                                   :links pending\n  1984\t                                   :checks 0}\n  1985\t                            (::frontend state')\n  1986\t                            (assoc :frontend (::frontend state'))))\n  1987\t      text\n  1988\t      (pending-text pending))))\n  1989\t\n  1990\t\n  1991\t(defn- wedged-program\n  1992\t  [state]\n  1993\t  (ex-info\n  1994\t    \"Program stream did not form a complete, runnable Yin VM program.\n  1995\tHint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n  1996\t    {:vm-type (:vm-type state)}))\n  1997\t\n  1998\t\n  1999\t(defn- run-evaluation\n  2000\t  \"The evaluator half of a round whose expander forwarded a program: run\n  2001\t   it, then either finalize the value, drive its require to a conclusion,\n  2002\t   or park it as `:pending-run`.  `state` is the round's starting state;\n  2003\t   `expanded` already carries the expander's progress, which a failing\n  2004\t   evaluation keeps.\"\n  2005\t  [state expanded]\n  2006\t  ;; r4 F4: the latest known state of this evaluation, so recovery\n  2007\t  ;; consults it — not only the pre-evaluator `expanded` — when a\n  2008\t  ;; resumed query/link (or any later step) throws after the\n  2009\t  ;; evaluator stage already completed retention.\n  2010\t  (let [latest (volatile! expanded)]\n  2011\t    (try\n  2012\t    (let [gaps-before (ingress-gaps expanded)\n  2013\t          evaluated (do (vreset! latest (run-evaluator-stage expanded))\n  2014\t                        @latest)\n  2015\t          vm (:vm evaluated)]\n  2025\t        (or (link-waiting? vm) (query/waiting? vm))\n  2026\t        (let [[state' vm' pending] (drive-links evaluated vm false)\n  2027\t              _ (vreset! latest state')]\n  2028\t          (cond\n  2029\t            (vm/halted? vm')\n  2030\t            (finalize-eval state\n  2031\t                           (assoc state' :vm vm')\n  2032\t                           (tokenize state'\n  2033\t                                     (engine/restore-initial-env\n  2034\t                                       (:env (:vm expanded)) vm')))\n  2035\t\n  2036\t            (link-waiting? vm')\n  2037\t            (pending-eval state state' vm' pending)\n  2038\t\n  2039\t            :else (throw (wedged-program state))))\n  2040\t\n  2041\t        :else (throw (wedged-program state))))\n  2042\t    (catch #?(:cljd Object :clj Exception