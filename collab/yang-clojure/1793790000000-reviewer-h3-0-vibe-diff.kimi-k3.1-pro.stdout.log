                            {:name name}))\n2076\t                       (cond-> {:type     :application\n2077\t                                :operator {:type :lambda, :params ['_]\n2078\t                                           :body (go rest-forms macro-env)}\n2079\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\n2080\t                         tail? (assoc :tail? true)))\n2081\t                     ;; single form\n2082\t                     (= 1 (count forms))\n2083\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n2084\t                     ;; sequence\n2085\t                     :else\n2086\t                     (cond-> {:type     :application\n2087\t                              :operator {:type :lambda, :params ['_]\n2088\t                                         :body (go rest-forms macro-env)}\n2089\t                              :operands [(discard-result\n2090\t                                           (compile-form head false\n2091\t                                                         (assoc env ::top-level true) macro-env))]}\n2092\t                       tail? (assoc :tail? true))))))]\n2093\t       (cond->> (go forms initial-macro-env)\n2094\t         (outcomes? env) (u/let1\n2095\t                           'dsg__admitted?\n2096\t                           (u/sexp->uast\n2097\t                             '(fn [dsg__candidate]\n2098\t                                (if (data/map? dsg__candidate)\n2099\t                                  (let [dsg__entry (dsg__get dsg__candidate :yang.call/entry)\n2100\t                                        dsg__witness (dsg__get dsg__candidate :clj/admission)]\n2101\t                                    (if (data/callable? dsg__entry)\n2102\t                                      (dsg__equal\n2103\t                                        dsg__witness\n2104\t                                        (dsg__make_admission\n2105\t                                          (dsg__assoc dsg__candidate :clj/admission nil)))\n2106\t                                      false))\n2107\t                                  false))))\n2108\t         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n2109\t         (outcomes? env) (u/let1\n2110\t                           'dsg__make_admission\n2111\t                           (u/sexp->uast\n2112\t                             '(fn [dsg__descriptor]\n2113\t                                (fn [dsg__candidate]\n2114\t                                  (if (data/callable? dsg__call_token)\n2115\t                                    (dsg__get dsg__descriptor :yang.call/entry)\n2116\t                                    nil)))))\n2117\t         (outcomes? env) (u/then\n2118\t                           (discard-result\n2119\t                             (u/app (u/lam '[get = assoc empty?] call/uast)\n2120\t                                    (u/v 'dsg__get) (u/v 'dsg__equal)\n2121\t                                    (u/v 'dsg__assoc) (u/v 'dsg__empty))))\n2122\t         (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\n2123\t         ;; Guest closures keep captured environments portable: binding host\n2124\t         ;; primitive values here would make UCF machine-data validation fail.\n2125\t         ;; These helpers cover generated map lookups/writes and comparisons;\n2126\t         ;; conj/vec are already protected by the convention's binder checks.\n2127\t         ;; Evaluate siblings outside each other's bindings to avoid retaining\n2128\t         ;; a chain of redundant helper environments.\n2129\t         (outcomes? env) (#(u/app\n2130\t                             (u/lam '[dsg__get dsg__equal dsg__assoc dsg__empty] %)\n2131\t                             (if (contains? (::defined env) 'get)\n2132\t                               (u/sexp->uast\n2133\t                                 '(fn [m k]\n2134\t                             