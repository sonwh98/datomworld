195\t\n2196\t\n2197\t(defn write-kernel-gate-evidence!\n2198\t  \"Explicit evidence/coverage refresh; normal tests never update these files.\"\n2199\t  []\n2200\t  (let [evidence (kernel-gate-evidence)]\n2201\t    (spit \"test/yang/latte_oracle/slice9_unexercised.edn\"\n2202\t          (str \";; GENERATED from exact execution evidence in both C lanes.\\n\"\n2203\t               (pr-str (into (sorted-map-by #(compare (pr-str %1) (pr-str %2)))\n2204\t                             (for [entry (get-in evidence [:coverage :entries])\n2205\t                                   :when (= :unexercised (:exercise entry))]\n2206\t                               [(:function-arity entry) (:missing-dependency entry)]))) \"\\n\"))\n2207\t    (with-open [w (io/writer \"test/yang/latte_oracle/slice9_evidence.edn\")]\n2208\t      ;; prn keeps (quote ...) in valid EDN rather than pprint's reader\n2209\t      ;; shorthand. One fixture per line keeps refreshes independently diffable.\n2210\t      (binding [*out* w *print-length* nil *print-level* nil]\n2211\t        (print \"{\")\n2212\t        (doseq [[k v] (dissoc evidence :fixtures)] (pr k) (print \" \") (prn v))\n2213\t        (println \":fixtures [\")\n2214\t        (doseq [row (:fixtures evidence)] (prn row))\n2215\t        (println \"]}\")))\n2216\t    (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage])))\n2217\t\n2218\t\n2219\t(deftest test-kernel-differential-gate\n2220\t  (let [evidence (kernel-gate-evidence)]\n2221\t    (is (= (count (:fixtures kernel-gate-corpus)) (count (set (map :id (:fixtures evidence)))))\n2222\t        \"Every named fixture runs exactly once, including negatives\")\n2223\t    (doseq [row (:fixtures evidence)\n2224\t            :when (and (:negative? row) (= :completed (get-in row [:a :status])))\n2225\t            :let [outcome (get-in row [:a :outcome]) value (:value outcome)\n2226\t                  fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n2227\t      (is (or (:thrown outcome) (false? value) (and (sequential? value) (= :ko (first value)))\n2228\t              (and (:refusal-path fixture) (false? (get-in outcome (:refusal-path fixture)))))\n2229\t          (str \"A must actually reject the named negative: \" (:id row))))\n2230\t    (is (= (:function-arity-candidates evidence)\n2231\t           (+ (:admitted-function-arity-count evidence) (:excluded-function-arity-count evidence)))\n2232\t        \"Admitted and excluded arities partition the candidate inventory\")\n2233\t    (is (every? #(every? true? (vals (:agreement %)))\n2234\t                (filter #(= :pass (:status %)) (:fixtures evidence)))\n2235\t        \"Every passing fixture records independent A/B/C agreement\")\n2236\t    (let [entries (get-in evidence [:coverage :entries])\n2237\t          unexercised (filter #(= :unexercised (:exercise %)) entries)\n2238\t          deviations (filter #(= :recorded-deviation (:status %)) (:fixtures evidence))]\n2239\t      (is (= (:admitted-function-arity-count evidence) (count entries)\n2240\t             (count (set (map :function-arity entries)))))\n2241\t      (is (= (set (get-in evidence [:coverage :unexercised]))\n2242\t             (set (map :function-arity unexercised))\n2243\t             (set (keys kernel-unexercised-reasons))))\n2244\t      (is (every? #(seq (:missing-dependency %)) unexercised))\n2245\t      (is (every? #(case (:exercise %)\n2246\t                     :direct (seq (:direct-fixture-ids %))\n2247\t                     :named-integration (seq (:integration-fixture-ids %))\n2248\t                     :unexercised (and (empty? (:direct-fixture-ids %))\n2249\t                                       (empty? (:integration-fixture-ids %)))) entries))\n2250\t      (doseq [{[symbol n] :function-arity :keys [direct-fixture-ids integration-fixture-ids]} entries\n2251\t              id (concat direct-fixture-ids integration-fixture-ids)\n2252\t              :let [row (first (filter #(= id (:id %)) (:fixtures evidence)))]]\n2253\t        (is (= :pass (:status row)))\n2254\t        (is (kernel-executed-arity? row symbol n)\n2255\t            (str \"Every credited path re-derives from both execution traces: \" [symbol n id])))\n2256\t      (is (= #{:elab-after-qed :check-after-qed} (set (map :id deviations))))\n2257\t      (is (every? #(and (:recorded-deviation %)\n2258\t                        (not (every? true? (vals (:agreement %))))) deviations)))\n2259\t    (testing \"Previously declared residual consumers must still prove their exact arities\"\n2260\t      (is (= 20 (count kernel-fixture-closure)))\n2261\t      (doseq [[arity {:keys [fixture expected] :as closure}] kernel-fixture-closure\n2262\t              :let [row (first (filter #(= fixture (:id %)) (:fixtures evidence)))\n2263\t                    entry (first (filter #(= arity (:function-arity %)) (get-in evidence [:coverage :entries])))]]\n2264\t        (is (= :pass (:status row)) (str arity \" via \" fixture))\n2265\t        (is (some #{fixture} (concat (:direct-fixture-ids entry) (:integration-fixture-ids entry)))\n2266\t            (str \"Primary consumer must contribute to arity evidence: \" arity))\n2267\t        (is (contains? closure :expected))\n2268\t        (is (= {:value expected} (get-in row [:a :outcome])) (str fixture \" has the intended result\"))))\n2269\t    (is (= #{:typing-ascription :compile-malformed}\n2270\t           (set (map :id (:recorded-upstream-failures evidence)))))\n2271\t    (doseq [row (:fixtures evidence)\n2272\t            :when (= :recorded-upstream-failure (:status row))\n2273\t            :let [fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n2274\t      (is (:recorded-upstream-failure row))\n2275\t      (is (not (every? true? (vals (:agreement row)))))\n2276\t      (is (nil? (kernel-upstream-failure (assoc fixture :id :unexpected)\n2277\t                                         (:a