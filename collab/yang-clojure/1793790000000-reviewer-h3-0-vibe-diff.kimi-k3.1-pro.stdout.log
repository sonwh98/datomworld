{"role":"tool","tool_call_id":"tool_QWQvtk66BAipGSibOuiJNKGz","content":"1\t(ns yang.core.call\n2\t  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n3\t   §8.10). This namespace emits the same pure definitions into bundled\n4\t   preludes and the linked `yang.call` module.\"\n5\t  (:require [yang.core.prelude :as core]\n6\t            [yang.core.uast :as u]))\n7\t\n8\t\n9\t(def module-name\n10\t  \"The linker module that publishes the shared calling runtime.\"\n11\t  'yang.call)\n12\t\n13\t\n14\t(def host-names\n15\t  \"Host module names read by the guest definitions.\"\n16\t  '#{cell/get data/callable? data/contains? data/count data/map? data/nth\n17\t     data/string? data/vector?})\n18\t\n19\t\n20\t(def definitions\n21\t  \"The one ordered definition list used by both emitters.\"\n22\t  '[;; Descriptor projection remains structural after callable admission.\n23\t    [yang.call/_descriptor\n24\t     (fn [callable]\n25\t       (if (data/map? callable)\n26\t         (if (= (get callable :type) :cell-ref)\n27\t           (cell/get callable)\n28\t           callable)\n29\t         nil))]\n30\t    [yang.call/entry\n31\t     (fn [callable]\n32\t       (get (yang.call/_descriptor callable) :yang.call/entry))]\n33\t    [yang.call/eligible?\n34\t     (fn [callable]\n35\t       (let [descriptor (yang.call/_descriptor callable)]\n36\t         (if (nil? (yang.call/entry callable))\n37\t           false\n38\t           (if (data/contains? descriptor :yang.call/eligible?)\n39\t             ((get descriptor :yang.call/eligible?) callable)\n40\t             true))))]\n41\t    [yang.call/invocation\n42\t     (fn [callee positional named raise]\n43\t       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n44\t                            :yang.call/positional positional)\n45\t                     :yang.call/named named)\n46\t              :yang.call/raise raise))]\n47\t    [yang.call/invocation-with\n48\t     (fn [callee positional named raise options]\n49\t       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n50\t                            :yang.call/positional positional)\n51\t                     :yang.call/named named)\n52\t              :yang.call/raise raise))]\n53\t    [yang.call/_pair?\n54\t     (fn [pair]\n55\t       (if (data/vector? pair)\n56\t         (= (data/count pair) 2)\n57\t         false))]\n58\t    [yang.call/_named-pairs?\n59\t     (fn [pairs index]\n60\t       (if (= index (data/count pairs))\n61\t         true\n62\t         (let [pair (data/nth pairs index)]\n63\t           (if (yang.call/_pair? pair)\n64\t             (if (data/string? (data/nth pair 0))\n65\t               (yang.call/_named-pairs? pairs (+ index 1))\n66\t               false)\n67\t             false))))]\n68\t    [yang.call/valid-invocation?\n69\t     (fn [invocation]\n70\t       (if (data/map? invocation)\n71\t         (if (data/contains? invocation :yang.call/callee)\n72\t           (if (data/contains? invocation :yang.call/positional)\n73\t             (if (data/contains? invocation :yang.call/named)\n74\t               (if (data/contains? invocation :yang.call/raise)\n75\t                 (if (data/vector? (get invocation :yang.call/positional))\n76\t                   (if (data/vector? (get invocation :yang.call/named))\n77\t                     (yang.call/_named-pairs?\n78\t                       (get invocation :yang.call/named) 0)\n79\t                     false)\n80\t                   false)\n81\t                 false)\n82\t               false)\n83\t             false)\n84\t           false)\n85\t         false))]\n86\t    [yang.call/condition\n87\t     (fn [reason evidence]\n88\t       (assoc (assoc {} :yang.call/reason reason)\n89\t              :yang.call/data evidence))]\n90\t    [yang.call/thrown\n91\t     (fn [value]\n92\t       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n93\t              :yang.call/value value))]\n94\t    [yang.call/transfer\n95\t     (fn [raise condition]\n96\t       (raise condition))]\n97\t    [yang.call/invoke\n98\t     (fn [callable positional named raise]\n99\t       (if (data/callable? raise)\n100\t         (if (yang.call/eligible? callable)\n101\t           (let [target (yang.call/entry callable)\n102\t                 record (yang.call/invocation callable positional named raise)]\n103\t             (if (not (nil? target))\n104\t               (if (yang.call/valid-invocation? record)\n105\t                 (target record)\n106\t                 (yang.call/transfer\n107\t                   raise\n108\t                   (yang.call/condition :yang.call/invalid-invocation\n109\t                                        {:yang.call/callee callable})))\n110\t               (yang.call/transfer\n111\t                 raise\n112\t                 (yang.call/condition :yang.call/invalid-invocation\n113\t                                      {:yang.call/callee callable}))))\n114\t           (yang.call/transfer\n115\t             raise\n116\t             (yang.call/condition :yang.call/not-callable\n117\t                                  {:yang.call/callee callable})))\n118\t         (raise (yang.call/condition :yang.call/invalid-invocation\n119\t                                     {:yang.call/reason :missing-raise-exit}))))]\n120\t    [yang.call/invoke-with\n121\t     (fn [callable positional named raise options]\n122\t       (if (data/callable? raise)\n123\t         (if (yang.call/eligible? callable)\n124\t           (let [target (yang.call/entry callable)\n125\t                 record (yang.call/invocation-with\n126\t                          callable positional named raise options)]\n127\t             (if (not (nil? target))\n128\t               (if (yang.call/valid-invocation? record)\n129\t                 (target record)\n130\t                 (yang.call/transfer\n131\t                   raise\n132\t                   (yang.call/condition :yang.call/invalid-invocation\n133\t                                        {:yang.call/callee callable})))\n134\t               (yang.call/transfer\n135\t                 raise\n136\t                 (yang.call/condition :yang.call/invalid-invocation\n137\t                                      {:yang.call/callee callable}))))\n138\t           (yang.call/transfer\n139\t             raise\n140\t             (yang.call/condition :yang.call/not-callable\n141\t                                  {:yang.call/callee callable})))\n142\t         (raise (yang.call/condition :yang.call/invalid-invocation\n143\t                                     {:yang.call/reason :missing-raise-exit}))))]])\n144\t\n145\t\n146\t(def ^:private public-exports\n147\t  '#{entry eligible? invocation invocation-with valid-invocation? condition\n148\t     thrown transfer invoke invoke-with})\n149\t\n150\t\n151\t(def uast\n152\t  \"The bundled definitions, in source order and tail marked.\"\n153\t  (u/mark-tails\n154\t    (reduce (fn [ast [key form]]\n155\t              (u/then ast (u/def! key (u/sexp->uast form))))\n156\t            (u/def! (ffirst definitions)\n157\t                    (u/sexp->uast (second (first definitions))))\n158\t            (rest definitions))))\n159\t\n160\t\n161\t(def module-uast\n162\t  \"The linked module tree built from the same `definitions`.\"\n163\t  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n164\t                                          [] definitions)]\n165\t    (core/module-tree stripped [])))\n166\t\n167\t\n168\t(def module-exports\n169\t  \"Public module exports (private helper definitions stay internal).\"\n170\t  public-exports)\n171\t\n172\t\n173\t(def ^:private module-free-names\n174\t  (core/free-name-vec module-uast))\n175\t\n176\t\n177\t(defn module-spec\n178\t  \"The linker module spec for `yang.call` over `registry`.\"\n179\t  [registry]\n180\t  (core/module-spec {:module-name module-name"}
