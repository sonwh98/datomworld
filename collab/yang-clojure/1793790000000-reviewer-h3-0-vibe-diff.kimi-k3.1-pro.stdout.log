n2120\t   require recorded body entry in both C lanes of a passing fixture.\"\n2121\t  []\n2122\t  (let [results (mapv (fn [fixture]\n2123\t                        (let [row (kernel-row fixture)]\n2124\t                          (println \"KERNEL-FIXTURE\" (:id row) (:status row))\n2125\t                          row)) (:fixtures kernel-gate-corpus))\n2126\t        inventory (mapv #(select-keys % [:symbol :kind :arities :disposition :admission-reason]) kernel-entries)\n2127\t        exercise-entries (kernel-exercise-entries inventory (:fixtures kernel-gate-corpus) results)\n2128\t        direct (set (map :function-arity (filter #(= :direct (:exercise %)) exercise-entries)))\n2129\t        exercised (set (map :function-arity (remove #(= :unexercised (:exercise %)) exercise-entries)))\n2130\t        all-arities (set (for [{:keys [symbol arities]} inventory n arities] [symbol n]))\n2131\t        admitted-arities (set (for [{:keys [symbol arities disposition]} inventory\n2132\t                                    :when (= :admitted disposition) n arities] [symbol n]))\n2133\t        unexercised (vec (sort-by pr-str (remove exercised admitted-arities)))]\n2134\t    {:slice 9 :gate-status (if (and (every? #(contains? #{:pass :recorded-deviation :recorded-upstream-failure} (:status %)) results)\n2135\t                                    (empty? unexercised)) :pass :blocked)\n2136\t     :baseline {:revision \"7dc18478\" :fixture-count 54 :counts {:pass 4 :mismatch 2 :blocked 48}}\n2137\t     :generated-at (str (java.time.Instant/now))\n2138\t     :adaptation-version {:context 2 :kernel-assembly 4}\n2139\t     :executions {:a :original-upstream-clojure :b :context-source-clojure\n2140\t                  :c [:walker :semantic]}\n2141\t     :upstream-revision \"86fca0d1d054af005cb37395eae04500d45e6279\"\n2142\t     :compiler-vm-revision {:base \"7dc18478\" :working-tree true}\n2143\t     :compiler-source-sha256\n2144\t     (apply str (map #(format \"%02x\" (bit-and 255 %))\n2145\t                     (.digest (java.security.MessageDigest/getInstance \"SHA-256\")\n2146\t                              (.getBytes (slurp \"src/cljc/yang/clojure.cljc\") \"UTF-8\"))))\n2147\t     :integration-context-identities kernel-context-integration-names\n2148\t     :portability-refusals\n2149\t     [{:source '(.getStackTrace exc) :disposition :excluded\n2150\t       :reason \"Host stack traces have no portable error-data representation; the compiler refuses the accessor.\"}]\n2151\t     :representation-seams\n2152\t     {'kind/var? \"JVM Clojure Var predicate; explicitly declared, with no namespace lookup.\"\n2153\t      'kind/with-meta \"Pure metadata attachment on the existing host value representation; the data ABI has no metadata-write export.\"}\n2154\t     :context-fields {'latte-kernel.proof/+opacity-fn+ :opacity-policy}\n2155\t     :fresh-supply-convention\n2156\t     {:input {:counter 0} :allocation '(gensym supply prefix)\n2157\t      :result '[symbol next-supply]\n2158\t      :rebuild-type-result '[original-result next-context]\n2159\t      :ambient-prefix-only :refused}\n2160\t     :runtime {:clojure (clojure-version) :java (System/getProperty \"java.version\")}\n2161\t     :instruction-budget-per-lane 2000000\n2162\t     :instruction-budget-note \"The original uninstrumented fixtures used 1,000,000 instructions. Body-entry stream writes add guest instructions; traced fixtures have a 2,000,000 instruction bound. The harness drains only after halt.\"\n2163\t     :manifest-bindings (count manifest) :function-arity-candidates (count all-arities)\n2164\t     :manifest-functions (count (filter :arities kernel-entries))\n2165\t     :admitted-function-arity-count (count admitted-arities)\n2166\t     :excluded-function-arity-count (- (count all-arities) (count admitted-arities))\n2167\t     :binding-dispositions (frequencies (map :disposition manifest))\n2168\t     :admission-note \"Manifest dispositions define the denominator independently of fixture