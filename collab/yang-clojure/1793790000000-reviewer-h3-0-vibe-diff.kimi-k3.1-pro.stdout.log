n (get kernel-context-extra-arguments fname 0)) n)]))]\n1791\t    (every? (fn [lane] (some paths (get-in row [lane :executed-calls])))\n1792\t            [:c-walker :c-semantic])))\n1793\t\n1794\t\n1795\t(defn- kernel-compile\n1796\t  [fixture]\n1797\t  (let [call (kernel-c-program fixture)\n1798\t        forms (kernel-closure call)\n1799\t        program (into ['(def gate-execution-trace (stream/make 1000000))]\n1800\t                      (concat (map kernel-trace-form forms) [call]))\n1801\t        program (into (yang/library-for program) program)\n1802\t        opts (update arg-vector-opts :native into\n1803\t                     (map (fn [[op profile]] [(clojure.core/symbol \"stream\" (name op)) profile])\n1804\t                          module/stream-profiles))\n1805\t        ast (yang/compile-program program true opts)\n1806\t        missing (unbound-ast-symbols ast program)]\n1807\t    (if (seq missing)\n1808\t      {:status :blocked :phase :admission :blocked-by (vec (sort missing))\n1809\t       :owners (into {} (for [s missing]\n1810\t                          [s (mapv second (filter #(some #{s} (tree-seq coll? seq %)) program))]))}\n1811\t      {:status :compiled :ast ast :forms forms})))\n1812\t\n1813\t\n1814\t(defn- kernel-c\n1815\t  [compiled lane]\n1816\t  (if (= :compiled (:status compiled))\n1817\t    (assoc (kernel-attempt\n1818\t             #(let [machine (compiler-test/run-guest-machine\n1819\t                              (:ast compiled) (oracle-registry yang/kind-module) lane 2000000)\n1820\t                    v (vm/value machine)\n1821\t                    ref (get-in machine [:store 'gate-execution-trace])\n1822\t                    handle (get-in machine [:resources (:id ref)])]\n1823\t                (when-not (and (vm/halted? machine) handle)\n1824\t                  (throw (ex-info \"Execution trace did not complete\" {:lane lane})))\n1825\t                {:status :completed :outcome (evidence-data v) :shape (result-shape (evidence-data v))\n1826\t                 :executed-calls (tu/drain handle)}))\n1827\t           :lane lane)\n1828\t    (assoc compiled :lane lane)))\n1829\t\n1830\t\n1831\t(deftest test-kernel-proof-fresh-supply\n1832\t  (testing \"explicit have types advance the supply; inferred types and prior contexts are preserved\"\n1833\t    (doseq [[name next-name] [['h 'h2] ['_ '_]]\n1834\t            [ty allocations] [['A 1] ['_ 0]]]\n1835\t      (let [fixture\n1836\t            {:call\n1837\t             (walk/postwalk-replace\n1838\t               {'H name 'H2 next-name 'TY ty}\n1839\t               '(let [k0 env\n1840\t                      [s1 [k1 ctx1 deps1 uses1]]\n1841\t                      (latte-kernel.proof/elab-have k0 '[[A ✳] [x A]] [] {} 'H 'TY 'x {})\n1842\t                      [s2 [k2 ctx2 deps2 uses2]]\n1843\t                      (latte-kernel.proof/elab-have k1 ctx1 deps1 uses1 'H2 'TY 'x {})\n1844\t                      [s3 [k3 ctx3 deps3 uses3]]\n1845\t                      (latte-kernel.proof/elab-declare k2 ctx2 deps2 uses2 'z 'A {})\n1846\t                      [s4 [k4 ctx4 deps4 uses4]]\n1847\t                      (latte-kernel.proof/elab-have k3 ctx3 deps3 uses3 '_ 'A 'z {})]\n1848\t                  [[s1 s2 s3 s4]\n1849\t                   [(:fresh k0) (:fresh k1) (:fresh k2) (:fresh k3) (:fresh k4)]\n1850\t                   (mapv (fn [k] (count (second (:definitions k)))) [k0 k1 k2 k3 k4])\n1851\t                   (= ctx1 '[[A ✳] [x A]]) (= ctx1 ctx2)]))}\n1852\t            expected [[:ok :ok :ok :ok] [0 allocations (* 2 allocations)\n1853\t                                         (inc (* 2 allocations)) (+ 2 (* 2 allocations))]\n1854\t                      (if (= name '_) [0 0 0 0 0] [0 1 2 2 2])\n1855\t                      true true]\n1856\t            compiled (kernel-compile fixture)]\n1857\t        (is (= {:value expected} (:outcome (kernel-b fixture))))\n1858\t        (doseq [lane [:walker :semantic]]\n1859\t          (let [c (kernel-c compiled lane)]\n1860\t            (is (= [:yin.k/ok expected] (:outcome c)) (str name \" \" lane \" \" c)))))))\n1861\t  (testing \"the proof loop carries the returned supply to the next step and qed\"\n1862\t    (doseq [[script fresh]\n1863\t            [['((:have h A x {}) (:have h2 A x {}) (:qed x {})) 2]\n1864\t             ['((:have _ A x {}) (:have _ A x {}) (:qed x {})) 2]\n1865\t             ['((:declare z A {}) (:have h A z {}) (:declare w A {}) (:have h2 A w {}) (:qed w {})) 4]]]\n1866\t      (let [fixture {:call (list 'let ['r (list 'latte-kernel.proof/elab-proof 'env ''[[A ✳] [x A]]\n1867\t                                                (list 'quote script))]\n1868\t                                 '[(first r) (:fresh (first (second r))) (:fresh env) (:definitions env)])}\n1869\t            expected [:ok fresh 0 [{} {}]]\n1870\t            compiled (kernel-compile fixture)]\n1871\t        (is (= {:value expected} (:outcome (kernel-b fixture))))\n1872\t        (doseq [lane [:walker :semantic]]\n1873\t          (is (= [:yin.k/ok expected] (:outcome (kernel-c compiled lane))) (str lane))))))\n1874\t  (testing \"check-proof keeps the rebuilt context under its own def-env' binding\"\n1875\t    ;; Observe the context passed to the final comparison: check-proof's public\n1876\t    ;; result contains only the proof term and type, so it cannot expose :fresh.\n1877\t    (with-redefs [kernel-sources\n1878\t                  (assoc kernel-sources 'gate-norm-beta-eq?\n1879\t                         '(defn gate-norm-beta-eq?\n1880\t                            [def-env ctx t1 t2]\n1881\t                            (= 1 (:fresh def-env))))]\n1882\t      (let [fixture {:call '(latte-kernel.proof/check-proof env '[[A ✳] [x A]] 't 'A '[[:qed x {}]])}\n1883\t            expected [:ok ['x 'A]]\n1884\t            compiled (kernel-compile fixture)]\n1885\t        (is (= {:value expected} (:outcome (kernel-b fixture))))\n1886\t        (doseq [lane [:walker :semantic]]\n1887\t          (is (= [:yin.k/ok expected] (:outcome (kernel-c compiled lane))) (str lane)))))))\n1888\t\n1889\t\n1890\t(def ^:private kernel-named-integrations\n1891\t  ;; Only these named integrations may contribute observed transitive calls.\n1892\t  ;; Static dependencies never establish execution of any arity.\n1893\t  #{:unparser-guest-closure :implicit-typed-closure :implicit-throwing-closure\n1894\t    :check-assume-have-discharge :parse-to-normalize-to-type\n1895\t    :fundamental-install-use :unfold-install-use :opacity-install-use})\n1896\t\n1897\t\n1898\t(def ^:private kernel-unexercised-reasons\n1899\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_unexercised.edn\"))))\n1900\t\n1901\t\n1902\t(defn- kernel-exercise-entries\n1903\t  [inventory fixtures results]\n1904\t  (vec\n1905\t    (for [{:keys [symbol arities disposition]} inventory\n1906\t          :when (= :admitted disposition)\n1907\t          n arities\n1908\t          :let [direct (vec (for [[fixture row] (map vector fixtures results)\n1909\t                                  :when (and (= :pass (:status row))\n1910\t                                             (kernel-executed-arity? row symbol n)\n1911\t                                             (= symbol (first (:call fixture)))\n1912\t                                             (= n (count (rest (:call fixture)))))]\n1913\t                              (:id fixture)))\n1914\t                integration (vec (for [row results\n1915\t                                       :when (and (= :pass (:status row))\n1916\t                                                  (contains? kernel-named-integrations (:id row))\n1917\t                                                  (kernel-executed-arity? row symbol n))]\n1918\t                                   (:id row)))]]\n1919\t      {:function-arity [symbol n]\n1920\t       :exercise (cond (seq direct) :direct\n1921\t                       (seq integration) :named-integration\n1922\t                       :else :unexercised)\n1923\t       :direct-fixture-ids direct\n1924\t       :integration-fixture-ids integration\n1925\t       :missing-dependency (when (and (empty? direct) (empty? integration))\n1926\t                             (get kernel-unexercised-reasons [symbol n]\n1927\t                                  \"No passing direct fixture or named integration records this exact arity in both C lanes.\"))})))\n1928\t\n1929\t\n1930\t(defn- kernel-host-value-deviation\n1931\t  [id a b walker semantic]\n1932\t  ;; Disposition only: keep every original comparison and all four outcomes.\n1933\t  ;; A new failure outside this exact host-value boundary remains a mismatch.\n1934\t  (when (and (contains? #{:elab-after-qed :check-after-qed} id)\n1935\t             (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n1936\t             (= (:outcome a) (:outcome b))\n1937\t             (= (get-in a [:outcome :thrown :data :meta])\n1938\t                {:nonportable-host-value (str (class clojure.core/meta))})\n1939\t             (= \"Wrong proof script: proof steps after qed.\"\n1940\t                (get-in a [:outcome :thrown :message]))\n1941\t             (every? (fn [c]\n1942\t                       (and (= :yin.k/error (first (:outcome c)))\n1943\t                            (= (get-in a [:outcome :thrown :message])\n1944\t                               (get-in c [:outcome 1 :yin.k/message]))\n1945\t                            (= (dissoc (get-in a [:outcome :thrown :data]) :meta)\n1946\t                               (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta))\n1947\t                            (= (result-shape (dissoc (get-in a [:outcome :thrown :data]) :meta))\n1948\t                               (result-shape (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta)))\n1949\t                            (values/closure? (get-in c [:outcome 1 :yin.k/data :meta]))))\n1950\t                     [walker semantic]))\n1951\t    {:boundary :nonportable-host-value\n1952\t     :upstream-value 'clojure.core/meta\n1953\t     :evidence {:file \"slice9_evidence.edn\" :fixture-id id\n1954\t                :path [:a :outcome :thrown :data :meta]}\n1955\t     :reason \"Upstream embeds a host function in error data; the guest carries its closure. No agreement is claimed.\"}))\n1956\t\n1957\t\n1958\t(defn- kernel-upstream-failure\n1959\t  \"Disposition for two pinned upstream failures, guarded by the original call\n1960\t   and every observed boundary. A new failure must still block the gate.\"\n1961\t  [fixture a b walker semantic]\n1962\t  (let [completed-c? (= :completed (:status walker) (:status semantic))\n1963\t        c (:outcome walker)\n1964\t        same-c? (= c (:outcome semantic))\n1965\t        unbound-message \"Pinned upstream declaration has no definition\"\n1966\t        unbound-data {:refusal :upstream-unbound :binding 'latte-kernel.typing/type-of-ascribe}\n1967\t        failure\n1968\t        (when (and completed-c? same-c?)\n1969\t          (case (:id fixture)\n1970\t            :typing-ascription\n1971\t            (when (and (= (:call fixture)\n1972\t                          '(latte-kernel.typing/type-of-term env '[[A ✳] [x A]]\n1973\t                                                             '(:latte-kernel.syntax/ascribe x A)))\n1974\t                       (= :blocked (:status a))\n1975\t                       (= \"class java.lang.IllegalStateException\" (:exception a))\n1976\t                       (= \"Attempting to call unbound fn: #'latte-kernel.typing/type-of-ascribe\" (:message a))\n1977\t                       (= :completed (:status b))\n1978\t                       (= {:thrown {:message unbound-message :data unbound-data}} (:outcome b))\n1979\t                       (= [:yin.k/error {:yin.k/message unbound-message :yin.k/data unbound-data}] c))\n1980\t              {:boundary :upstream-unbound-definition\n1981\t               :reason \"Pinned upstream declares type-of-ascribe without a definition; B/C explicitly refuse that branch.\"})\n1982\t            :compile-malformed\n1983\t            (when (and (= (:call fixture) '(latte-kernel.proof/compile-proof '[42]))\n1984\t                       (= :blocked (:status a) (:status b))\n1985\t                       (= \"class java.lang.IllegalArgumentException\" (:exception a) (:exception b))\n1986\t                       (= \"Don't know how to create ISeq from: java.lang.Long\" (:message a) (:message b))\n1987\t                       (nil? (:data a)) (nil? (:data b))\n1988\t                       (= [:yin.k/error {:yin.k/message \"seq of a non-collection is not supported\"\n1989\t                                         :yin.k/data {:value 42}}] c))\n1990\t              {:boundary :upstream-malformed-proof-sequence\n1991\t               :reason \"Scalar proof step raises a native sequence exception upstream and a portable sequence refusal in C; no agreement is claimed.\"})\n1992\t            nil))]\n1993\t    (when failure\n1994\t      (assoc failure :upstream-revision \"86fca0d1d054af005cb37395eae04500d45e6279\"\n1995\t             :evidence {:file \"slice9_evidence.edn\" :fixture-id (:id fixture)\n1996\t                        :paths [[:a] [:b] [:c-walker] [:c-semantic]]}))))\n1997\t\n1998\t\n1999\t(deftest test-kernel-acceptance-counting\n2000\t  (let [inventory [{:symbol 'latte-kernel.syntax/subst :arities [2 3] :disposition :admitted}\n2001\t                   {:symbol 'latte-kernel.syntax/term? :arities [1] :disposition :admitted}]\n2002\t        fixture {:id :direct-subst :call '(latte-kernel.syntax/subst x y)}\n2003\t        calls '[[gate-syntax-subst 2]]\n2004\t        rows [{:id :direct-subst :status :pass\n2005\t               :c-walker {:executed-calls calls} :c-semantic {:executed-calls calls}}\n2006\t              {:id :check-assume-have-discharge :status :pass\n2007\t               :included-functions ['gate-syntax-subst]\n2008\t               :c-walker {:executed-calls calls} :c-semantic {:executed-calls calls}}]\n2009\t        entries (kernel-exercise-entries inventory [fixture] rows)]\n2010\t    (is (= [:direct :unexercised :unexercised] (mapv :exercise entries))\n2011\t        \"An admitted but uncalled arity stays uncredited despite static membership\")\n2012\t    (is (empty? (:integration-fixture-ids (second entries))))\n2013\t    (is (= [:unexercised :unexercised :unexercised]\n2014\t           (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2015\t                                                    (mapv #(assoc % :status :mismatch) rows)))))\n2016\t    (let [observed (mapv #(-> %\n2017\t                              (assoc-in [:c-walker :executed-calls] '[[gate-syntax-subst 2] [gate-syntax-subst 3]])\n2018\t                              (assoc-in [:c-semantic :executed-calls] '[[gate-syntax-subst 2] [gate-syntax-subst 3]])) rows)]\n2019\t      (is (= [:direct :named-integration :unexercised]\n2020\t             (mapv :exercise (kernel-exercise-entries inventory [fixture] observed))))\n2021\t      (is (= [:direct :named-integration :unexercised]\n2022\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2023\t                                                      (mapv #(dissoc % :included-functions) observed)))))\n2024\t      (is (= [:direct :unexercised :unexercised]\n2025\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2026\t                                                      (assoc-in observed [1 :id] :unnamed-integration))))))\n2027\t    (doseq [lane [:c-walker :c-semantic]]\n2028\t      (is (= [:unexercised :unexercised :unexercised]\n2029\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2030\t                                                      (mapv #(dissoc % lane) rows))))\n2031\t          \"Both C lanes must demonstrate the exact arity\")))\n2032\t  (let [a {:status :completed\n2033\t           :outcome {:thrown {:message \"Wrong proof script: proof steps after qed.\"\n2034\t                              :data {:script [] :meta {:nonportable-host-value (str (class clojure.core/meta))}}}}}\n2035\t        c {:status :completed\n2036\t           :outcome [:yin.k/error {:yin.k/message \"Wrong proof script: proof steps after qed.\"\n2037\t                                   :yin.k/data {:script [] :meta (values/closure nil {})}}]}]\n2038\t    (is (some? (kernel-host-value-deviation :elab-after-qed a a c c)))\n2039\t    (is (nil? (kernel-host-value-deviation :other a a c c)))\n2040\t    (is (nil? (kernel-host-value-deviation :elab-after-qed a a (assoc c :status :blocked) c)))\n2041\t    (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2042\t                                           (assoc-in c [:outcome 1 :yin.k/data :script] [:new-mismatch]) c)))\n2043\t    (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2044\t                                           (assoc-in c [:outcome 1 :yin.k/data :script] '()) c)))\n2045\t    (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2046\t                                           (assoc-in c [:outcome 1 :yin.k/data :meta] {:type :closure}) c)))))\n2047\t\n2048\t\n2049\t(defn- kernel-row\n2050\t  [fixture]\n2051\t  (let [a (kernel-a fixture)\n2052\t        b (kernel-b fixture)\n2053\t        compiled (kernel-attempt #(kernel-compile fixture))\n2054\t        compiled (if (and (= :blocked (:status compiled)) (not (:blocked-by compiled)))\n2055\t                   (assoc compiled :phase :compile\n2056\t                          :blocked-by (if-let [n (get-in compiled [:data :name])] [n] [:compiler-exception])\n2057\t                          :minimal-source (get kernel-sources (get-in compiled [:data :name]))) compiled)\n2058\t        walker (kernel-c compiled :walker)\n2059\t        semantic (kernel-c compiled :semantic)\n2060\t        match? (and (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n2061\t                    (= (:outcome a) (:outcome b))\n2062\t                    (agrees? (get a :outcome) (get walker :outcome))\n2063\t                    (= (:outcome walker) (:outcome semantic))\n2064\t                    (= (result-shape (:outcome a)) (result-shape (:outcome b)))\n2065\t                    (if (contains? (:outcome a) :value)\n2066\t                      (= (result-shape (:value (:outcome a)))\n2067\t                         (result-shape (second (:outcome walker))))\n2068\t                      (= (result-shape (get-in a [:outcome :thrown :data]))\n2069\t                         (result-shape (get-in walker [:outcome 1 :yin.k/data])))))\n2070\t        deviation (kernel-host-value-deviation (:id fixture) a b walker semantic)\n2071\t        upstream-failure (kernel-upstream-failure fixture a b walker semantic)\n2072\t        status (cond match? :pass\n2073\t                     upstream-failure :recorded-upstream-failure\n2074\t                     (some #(= :blocked (:status %)) [a b walker semantic]) :blocked\n2075\t                     deviation :recorded-deviation\n2076\t                     :else :mismatch)]\n2077\t    {:id (:id fixture) :mode (:mode fixture) :negative? (boolean (:negative? fixture)) :status status\n2078\t     :recorded-deviation deviation\n2079\t     :recorded-upstream-failure upstream-failure\n2080\t     :dependency-of (:dependency-of fixture)\n2081\t     :call (or (:call fixture) (kernel-c-program fixture))\n2082\t     :adapted-call (:guest-call fixture)\n2083\t     :agreement {:a-b (and (= :completed (:status a) (:status b)) (= (:outcome a) (:outcome b)))\n2084\t                 :a-c-walker (and (= :completed (:status a) (:status walker))\n2085\t                                  (agrees? (:outcome a) (:outcome walker)))\n2086\t                 :a-c-semantic (and (= :completed (:status a) (:status semantic))\n2087\t                                    (agrees? (:outcome a) (:outcome semantic)))\n2088\t                 :c-lanes (and