tmpdir\") \"/slice9-roundtrip-\" (System/currentTimeMillis))\n337\t+        committed (edn/read-string (slurp \"test/yang/latte_oracle/slice9_evidence.edn\"))]\n338\t+    (try\n339\t+      (.mkdirs (java.io.File. dir))\n340\t+      (with-redefs [kernel-gate-evidence (constantly committed)]\n341\t+        (write-kernel-gate-evidence! dir))\n342\t+      (let [written (edn/read-string (slurp (str dir \"/slice9_evidence.edn\")))]\n343\t+        (is (= committed written) \"the writer's output re-reads as the same evidence\")\n344\t+        (is (= #{:elab-after-qed :check-after-qed}\n345\t+               (set (map :id (filter #(= :recorded-deviation (:status %)) (:fixtures written)))))\n346\t+            \"the declared departures survive as recorded deviations\")\n347\t+        (is (every? (fn [row]\n348\t+                      (and (contains? row :a) (contains? row :b)\n349\t+                           (contains? row :c-walker) (contains? row :c-semantic)))\n350\t+                    (:fixtures written))\n351\t+            \"every fixture row keeps its raw A/B/C comparisons\")\n352\t+        (let [unexercised (edn/read-string (slurp (str dir \"/slice9_unexercised.edn\")))]\n353\t+          (is (= (count (get-in written [:coverage :unexercised])) (count unexercised))\n354\t+              \"the companion file lists every unexercised arity with its dependency\")))\n355\t+      (finally\n356\t+        (run! #(let [f (java.io.File. (str dir \"/\" %))] (when (.exists f) (.delete f)))\n357\t+              [\"slice9_evidence.edn\" \"slice9_unexercised.edn\"])"}
