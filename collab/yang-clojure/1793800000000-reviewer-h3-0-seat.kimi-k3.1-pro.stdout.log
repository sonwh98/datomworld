\t      {:function-arity [symbol n]\n1920\t       :exercise (cond (seq direct) :direct\n1921\t                       (seq integration) :named-integration\n1922\t                       :else :unexercised)\n1923\t       :direct-fixture-ids direct\n1924\t       :integration-fixture-ids integration\n1925\t       :missing-dependency (when (and (empty? direct) (empty? integration))\n1926\t                             (get kernel-unexercised-reasons [symbol n]\n1927\t                                  \"No passing direct fixture or named integration records this exact arity in both C lanes.\"))})))\n1928\t\n1929\t\n1930\t(def ^:private kernel-declarations\n1931\t  \"The declared dispositions: explicit, versioned input to classification.\n1932\t   Generated evidence is never their source of truth; provenance is in-file.\n1933\t   A declaration whose revalidation guards fail leaves its row a blocker,\n1934\t   not a deviation.\"\n1935\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_declarations.edn\"))))\n1936\t\n1937\t(defn- kernel-callable-descriptor?\n1938\t  \"True when `value` is the admitted common-call descriptor the reconciled\n1939\t   compiler publishes for a guest closure: a function-type marker, an entry\n1940\t   that is itself a minted closure, and an admission witness. Forged shapes -\n1941\t   a bare `{:type :closure}` map, a scalar or missing entry, a missing\n1942\t   witness - fail.\"\n1943\t  [value]\n1944\t  (and (map? value)\n1945\t       (= :function (:clj/type value))\n1946\t       (values/closure? (get value :yang.call/entry))\n1947\t       (values/closure? (get value :clj/admission))))\n1948\t\n1949\t(defn- kernel-host-value-deviation\n1950\t  [id a b walker semantic]\n1951\t  ;; Disposition only: keep every original comparison and all four outcomes.\n1952\t  ;; A new failure outside this exact host-value boundary remains a mismatch.\n1953\t  ;; The declared boundary, upstream value and reason come from the versioned\n1954\t  ;; declarations file; the guards revalidate the live execution against it.\n1955\t  (let [declared (get-in kernel-declarations [:portability id])]\n1956\t    (when (and declared\n1957\t               (contains? #{:elab-after-qed :check-after-qed} id)\n1958\t               (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n1959\t               (= (:outcome a) (:outcome b))\n1960\t               (= (get-in a [:outcome :thrown :data :meta])\n1961\t                  {:nonportable-host-value (str (class clojure.core/meta))})\n1962\t               (= \"Wrong proof script: proof steps after qed.\"\n1963\t                  (get-in a [:outcome :thrown :message]))\n1964\t               ;; The declaration must describe THIS failure: same message and\n1965\t               ;; same script (top-level sequential shape normalized), or the\n1966\t               ;; guard fails and the row stays a blocker.\n1967\t               (= (:message declared) (get-in a [:outcome :thrown :message]))\n1968\t               (= (vec (:script declared))\n1969\t                  (vec (get-in a [:outcome :thrown :data :script])))\n1970\t               (every? (fn [c]\n1971\t                         (and (= :yin.k/error (first (:outcome c)))\n1972\t                              (= (get-in a [:outcome :thrown :message])\n1973\t                                 (get-in c [:outcome 1 :yin.k/message]))\n1974\t                              (= (dissoc (get-in a [:outcome :thrown :data]) :meta)\n1975\t                                 (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta))\n1976\t                              (= (result-shape (dissoc (get-in a [:outcome :thrown :data]) :meta))\n1977\t                                 (result-shape (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta)))\n1978\t                              (let [meta (get-in c [:outcome 1 :yin.k/data :meta])]\n1979\t                                ;; Both representations the pipeline actually\n1980\t                                ;; produces: a pre-adoption raw closure, or the\n1981\t                                ;; admitted §8.10 descriptor. Anything else -\n1982\t                                ;; including an invented `{:type :closure}` map -\n1983\t                                ;; fails.\n1984\t                                (or (values/closure? meta)\n1985\t                                    (kernel-callable-descriptor? meta)))))\n1986\t                       [walker semantic]))\n1987\t      {:boundary (:boundary declared)\n1988\t       :upstream-value (:upstream-value declared)\n1989\t       :evidence {:file \"slice9_evidence.edn\" :fixture-id id\n1990\t                  :path [:a :outcome :thrown :data :meta]}\n1991\t       :reason (:reason declared)})))\n1992\t\n1993\t\n1994\t(defn- kernel-upstream-failure\n1995\t  \"Disposition for two pinned upstream failures, guarded by the original call\n1996\t   and every observed boundary. A new failure must still block the gate.\"\n1997\t  [fixture a b walker semantic]\n1998\t  (let [completed-c? (= :completed (:status walker) (:status semantic))\n1999\t        c (:outcome walker)\n2000\t        same-c? (= c (:outcome semantic))\n2001\t        unbound-message \"Pinned upstream declaration has no definition\"\n2002\t        unbound-data {:refusal :upstream-unbound :binding 'latte-kernel.typing/type-of-ascribe}\n2003\t        failure\n2004\t        (when (and completed-c? same-c?)\n2005\t          (case (:id fixture)\n2006\t            :typing-ascription\n2007\t            (when (and (= (:call fixture)\n2008\t                          '(latte-kernel.typing/type-of-term env '[[A ✳] [x A]]\n2009\t                                                             '(:latte-kernel.syntax/ascribe x A)))\n2010\t                       (= :blocked (:status a))\n2011\t                       (= \"class java.lang.IllegalStateException\" (:exception a))\n2012\t                       (= \"Attempting to call unbound fn: #'latte-kernel.typing/type-of-ascribe\" (:message a))\n2013\t                       (= :completed (:status b))\n2014\t                       (= {:thrown {:message unbound-message :data unbound-data}} (:outcome b))\n2015\t                       (= [:yin.k/error {:yin.k/message unbound-message :yin.k/data unbound-data}] c))\n2016\t              {:boundary :upstream-unbound-definition\n2017\t               :reason \"Pinned upstream declares type-of-ascribe without a definition; B/C explicitly refuse that branch.\"})\n2018\t            :compile-malformed\n2019\t            (when (and (= (:call fixture) '(latte-kernel.proof/compile-proof '[42]))\n2020\t                       (= :blocked (:status a) (:status b))\n2021\t                       (= \"class java.lang.IllegalArgumentException\" (:exception a) (:exception b))\n2022\t                       (= \"Don't know how to create ISeq from: java.lang.Long\" (:message a) (:message b))\n2023\t                       (nil? (:data a)) (nil? (:data b))\n2024\t                       (= [:yin.k/error {:yin.k/message \"seq of a non-collection is not supported\"\n2025\t                                         :yin.k/data {:value 42}}] c))\n2026\t              {:boundary :upstream-malformed-proof-sequence\n2027\t               :reason \"Scalar proof step raises a native sequence exception upstream and a portable sequence refusal in C; no agreement is claimed.\"})\n2028\t            nil))]\n2029\t    (when failure\n2030\t      (assoc failure :upstream-revision \"86fca0d1d054af005cb37395eae04500d45e6279\"\n2031\t             :evidence {:file \"slice9_evidence.edn\" :fixture-id (:id fixture)\n2032\t                        :paths [[:a] [:b] [:c-walker] [:c-semantic]]}))))\n2033\t\n2034\t\n2035\t(deftest test-kernel-acceptance-counting\n2036\t  (let [inventory [{:symbol 'latte-kernel.syntax/subst :arities [2 3] :disposition :admitted}\n2037\t                   {:symbol 'latte-kernel.syntax/term? :arities [1] :disposition :admitted}]\n2038\t        fixture {:id :direct-subst :call '(latte-kernel.syntax/subst x y)}\n2039\t        calls '[[gate-syntax-subst 2]]\n2040\t        rows [{:id :direct-subst :status :pass\n2041\t               :c-walker {:executed-calls calls} :c-semantic {:executed-calls calls}}\n2042\t              {:id :check-assume-have-discharge :status :pass\n2043\t               :included-functions ['gate-syntax-subst]\n2044\t               :c-walker {:executed-calls calls} :c-semantic {:executed-calls calls}}]\n2045\t        entries (kernel-exercise-entries inventory [fixture] rows)]\n2046\t    (is (= [:direct :unexercised :unexercised] (mapv :exercise entries))\n2047\t        \"An admitted but uncalled arity stays uncredited despite static membership\")\n2048\t    (is (empty? (:integration-fixture-ids (second entries))))\n2049\t    (is (= [:unexercised :unexercised :unexercised]\n2050\t           (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2051\t                                                    (mapv #(assoc % :status :mismatch) rows)))))\n2052\t    (let [observed (mapv #(-> %\n2053\t                              (assoc-in [:c-walker :executed-calls] '[[gate-syntax-subst 2] [gate-syntax-subst 3]])\n2054\t                              (assoc-in [:c-semantic :executed-calls] '[[gate-syntax-subst 2] [gate-syntax-subst 3]])) rows)]\n2055\t      (is (= [:direct :named-integration :unexercised]\n2056\t             (mapv :exercise (kernel-exercise-entries inventory [fixture] observed))))\n2057\t      (is (= [:direct :named-integration :unexercised]\n2058\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2059\t                                                      (mapv #(dissoc % :included-functions) observed)))))\n2060\t      (is (= [:direct :unexercised :unexercised]\n2061\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2062\t                                                      (assoc-in observed [1 :id] :unnamed-integration))))))\n2063\t    (doseq [lane [:c-walker :c-semantic]]\n2064\t      (is (= [:unexercised :unexercised :unexercised]\n2065\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2066\t                                                      (mapv #(dissoc % lane) rows))))\n2067\t          \"Both C lanes must demonstrate the exact arity\")))\n2068\t  (let [script (vector [:qed '(lambda [A :type] (lambda [x A] x)) {}] [:qed 'missing {}])]\n2069\t    (is (= (vec (:script (get-in kernel-declarations [:portability :elab-after-qed]))) (vec script))\n2070\t        \"The controls model the declared script exactly\")\n2071\t    (let [a {:status :completed\n2072\t             :outcome {:thrown {:message \"Wrong proof script: proof steps after qed.\"\n2073\t                                :data {:script script\n2074\t                                       :meta {:nonportable-host-value (str (class clojure.core/meta))}}}}}\n2075\t          descriptor {:yang.call/entry (values/closure nil {})\n2076\t                      :clj/type :function\n2077\t                      :clj/outcomes? true\n2078\t                      :clj/admission (values/closure nil {})}\n2079\t          c-with (fn [meta]\n2080\t                   {:status :completed\n2081\t                    :outcome [:yin.k/error {:yin.k/message \"Wrong proof script: proof steps after qed.\"\n2082\t                                            :yin.k/data {:script script :meta meta}}]})]\n2083\t      ;; Both representations the reconciled pipeline actually produces.\n2084\t      (is (some? (kernel-host-value-deviation :elab-after-qed a a\n2085\t                                             (c-with (values/closure nil {})) (c-with (values/closure nil {})))))\n2086\t      (is (some? (kernel-host-value-deviation :elab-after-qed a a (c-with descriptor) (c-with descriptor)))\n2087\t          \"The admitted §8.10 descriptor classifies as the declared deviation\")\n2088\t      (is (nil? (kernel-host-value-deviation :other a a (c-with descriptor) (c-with descriptor))))\n2089\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a (assoc (c-with descriptor) :status :blocked) (c-with descriptor))))\n2090\t      ;; Payload and shape mutations refuse.\n2091\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2092\t                                             (assoc-in (c-with descriptor) [:outcome 1 :yin.k/data :script] [:new-mismatch])\n2093\t                                             (c-with descriptor))))\n2094\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2095\t                                             (assoc-in (c-with descriptor) [:outcome 1 :yin.k/data :script] '())\n2096\t                                             (c-with descriptor))))\n2097\t      ;; Descriptor forgeries refuse.\n2098\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2099\t                                             (c-with (dissoc descriptor :clj/admission))\n2100\t                                             (c-with (dissoc descriptor :clj/admission))))\n2101\t          \"a descriptor without its admission witness fails\")\n2102\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2103\t                                             (c-with (assoc descriptor :yang.call/entry :not-a-closure))\n2104\t                                             (c-with (assoc descriptor :yang.call/entry :not-a-closure))))\n2105\t          \"a descriptor whose entry is not a minted closure fails\")\n2106\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n2107\t                                             (c-with (assoc descriptor :clj/type :data))\n2108\t                                             (c-with (assoc descriptor :clj/type :data))))\n2109\t          \"a descriptor with a wrong type marker fails\")\n2110\t      (is (nil? (kernel-host-value-deviation :elab-after-qed a a (c-with {:type :closure}) (c-with {:type :closure}))))\n2111\t      ;; A mutated declaration (declared message != live failure) fails the guard.\n2112\t      (with-redefs [kernel-declarations (assoc-in kernel-declarations\n2113\t                                                  [:portability :elab-after-qed :message]\n2114\t                                                  \"A different declared failure\")]\n2115\t        (is (nil? (kernel-host-value-deviation :elab-after-qed a a (c-with descriptor) (c-with descriptor))))\n2116\t        \"carrying a declaration forward means revalidating it, not copying it\"))))\n2117\t\n2118\t\n2119\t(defn- kernel-row\n2120\t  [fixture]\n2121\t  (let [a (kernel-a fixture)\n2122\t        b (kernel-b fixture)\n2123\t        compiled (kernel-attempt #(kernel-compile fixture))\n2124\t        compiled (if (and (= :blocked (:status compiled)) (not (:blocked-by compiled)))\n2125\t                   (assoc compiled :phase :compile\n2126\t                          :blocked-by (if-let [n (get-in compiled [:data :name])] [n] [:compiler-exception])\n2127\t                          :minimal-source (get kernel-sources (get-in compiled [:data :name]))) compiled)\n2128\t        walker (kernel-c compiled :walker)\n2129\t        semantic (kernel-c compiled :semantic)\n2130\t        match? (and (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n2131\t                    (= (:outcome a) (:outcome b))\n2132\t                    (agrees? (get a :outcome) (get walker :outcome))\n2133\t                    (= (:outcome walker) (:outcome semantic))\n2134\t                    (= (result-shape (:outcome a)) (result-shape (:outcome b)))\n2135\t                    (if (contains? (:outcome a) :value)\n2136\t                      (= (result-shape (:value (:outcome a)))\n2137\t                         (result-shape (second (:outcome walker))))\n2138\t                      (= (result-shape (get-in a [:outcome :thrown :data]))\n2139\t                         (result-shape (get-in walker [:outcome 1 :yin.k/data])))))\n2140\t        deviation (kernel-host-value-deviation (:id fixture) a b walker semantic)\n2141\t        upstream-failure (kernel-upstream-failure fixture a b walker semantic)\n2142\t        status (cond match? :pass\n2143\t                     upstream-failure :recorded-upstream-failure\n2144\t                     (some #(= :blocked (:status %)) [a b walker semantic]) :blocked\n2145\t                     deviation :recorded-deviation\n2146\t                     :else :mismatch)]\n2147\t    {:id (:id fixture) :mode (:mode fixture) :negative? (boolean (:negative? fixture)) :status status\n2148\t     :recorded-deviation deviation\n2149\t     :recorded-upstream-failure upstream-failure\n2150\t     :dependency-of (:dependency-of fixture)\n2151\t     :call (or (:call fixture) (kernel-c-program fixture))\n2152\t     :adapted-call (:guest-call fixture)\n2153\t     :agreement {:a-b (and (= :completed (:status a) (:status b)) (= (:outcome a) (:outcome b)))\n2154\t                 :a-c-walker (and (= :completed (:status a) (:status walker))\n2155\t                                  (agrees? (:outcome a) (:outcome walker)))\n2156\t                 :a-c-semantic (and (= :completed (:status a) (:status semantic))\n2157\t                                    (agrees? (:outcome a) (:outcome semantic)))\n2158\t                 :c-lanes (and (= :completed (:status walker) (:status semantic))\n2159\t                               (= (:outcome walker) (:outcome semantic)))}\n2160\t     :a a :b b :c-walker walker :c-semantic semantic\n2161\t     :included-functions (mapv second (kernel-closure (kernel-c-program fixture)))}))\n2162\t\n2163\t\n2164\t(deftest test-kernel-unused-arity-execution\n2165\t  (let [fixture (first (filter #(= :parse-to-normalize-to-type (:id %)) (:fixtures kernel-gate-corpus)))\n2166\t        fname 'gate-presyntax-parse\n2167\t        source (get kernel-sources fname)\n2168\t        ;; Preserve parse/2; poison the uncalled parse/1 body in memory.\n2169\t        poisoned (list* 'defn fname\n2170\t                        (map (fn [arity]\n2171\t                               (if (= 1 (count (first arity)))\n2172\t                                 (list (first arity) '(throw (ex-info \"Uncalled parse/1 entered\" {})))\n2173\t                                 arity)) (drop 2 source)))\n2174\t        row (with-redefs [kernel-sources (assoc kernel-sources fname poisoned)]\n2175\t              (kernel-row fixture))\n2176\t        inventory [{:symbol 'latte-kernel.presyntax/parse :arities [1 2] :disposition :admitted}]\n2177\t        entries (kernel-exercise-entries inventory [fixture] [row])]\n2178\t    (is (= :pass (:status row)))\n2179\t    (is (some #{fname} (:included-functions row)) \"Both arities remain in the static closure\")\n2180\t    (doseq [lane [:c-walker :c-semantic]]\n2181\t      (is (some #{[fname 2]} (get-in row [lane :executed-calls])))\n2182\t      (is (not-any? #{[fname 1]} (get-in row [lane :executed-calls]))))\n2183\t    (is (= [:unexercised :named-integration] (mapv :exercise entries)))\n2184\t    (is (empty? (:integration-fixture-ids (first entries))))))\n2185\t\n2186\t\n2187\t(defn kernel-gate-evidence\n2188\t  \"Run every fixture in A and independently in both C lanes. Compilation or\n2189\t   VM errors are blockers, never successful LaTTe rejections. Exact arities\n2190\t   require recorded body entry in both C lanes of a passing fixture.\"\n2191\t  []\n2192\t  (let [results (mapv (fn [fixture]\n2193\t                        (let [row (kernel-row fixture)]\n2194\t                          (println \"KERNEL-FIXTURE\" (:id row) (:status row))\n2195\t                          row)) (:fixtures kernel-gate-corpus))\n2196\t        inventory (mapv #(select-keys % [:symbol :kind :arities :disposition :admission-reason]) kernel-entries)\n2197\t        exercise-entries (kernel-exercise-entries inventory (:fixtures kernel-gate-corpus) results)\n2198\t        direct (set (map :function-arity (filter #(= :direct (:exercise %)) exercise-entries)))\n2199\t        exercised (set (map :function-arity (remove #(= :unexercised (:exercise %)) exercise-entries)))\n2200\t        all-arities (set (for [{:keys [symbol arities]} inventory n arities] [symbol n]))\n2201\t        admitted-arities (set (for [{:keys [symbol arities disposition]} inventory\n2202\t                                    :when (= :admitted disposition) n arities] [symbol n]))\n2203\t        unexercised (vec (sort-by pr-str (remove exercised admitted-arities)))]\n2204\t    {:slice 9 :gate-status (if (and (every? #(contains? #{:pass :recorded-deviation :recorded-upstream-failure} (:status %)) results)\n2205\t                                    (empty? unexercised)) :pass :blocked)\n2206\t     :baseline {:revision \"7dc18478\" :fixture-count 54 :counts {:pass 4 :mismatch 2 :blocked 48}}\n2207\t     :generated-at (str (java.time.Instant/now))\n2208\t     :adaptation-version {:context 2 :kernel-assembly 4}\n2209\t     :executions {:a :original-upstream-clojure :b :context-source-clojure\n2210\t                  :c [:walker :semantic]}\n2211\t     :upstream-revision \"86fca0d1d054af005cb37395eae04500d45e6279\"\n2212\t     :compiler-vm-revision {:base \"7dc18478\" :working-tree true}\n2213\t     :compiler-source-sha256\n2214\t     (apply str (map #(format \"%02x\" (bit-and 255 %))\n2215\t                     (.digest (java.security.MessageDigest/getInstance \"SHA-256\")\n2216\t                              (.getBytes (slurp \"src/cljc/yang/clojure.cljc\") \"UTF-8\"))))\n2217\t     :integration-context-identities kernel-context-integration-names\n2218\t     :portability-refusals\n2219\t     [{:source '(.getStackTrace exc) :disposition :excluded\n2220\t       :reason \"Host stack traces have no portable error-data representation; the compiler refuses the accessor.\"}]\n2221\t     :representation-seams\n2222\t     {'kind/var? \"JVM Clojure Var predicate; explicitly declared, with no namespace lookup.\"\n2223\t      'kind/with-meta \"Pure metadata attachment on the existing host value representation; the data ABI has no metadata-write export.\"}\n2224\t     :context-fields {'latte-kernel.proof/+opacity-fn+ :opacity-policy}\n2225\t     :fresh-supply-convention\n2226\t     {:input {:counter 0} :allocation '(gensym supply prefix)\n2227\t      :result '[symbol next-supply]\n2228\t      :rebuild-type-result '[original-result next-context]\n2229\t      :ambient-prefix-only :refused}\n2230\t     :runtime {:clojure (clojure-version) :java (System/getProperty \"java.version\")}\n2231\t     :instruction-budget-per-lane 2000000\n2232\t     :instruction-budget-note \"The original uninstrumented fixtures used 1,000,000 instructions. Body-entry stream writes add guest instructions; traced fixtures have a 2,000,000 instruction bound. The harness drains only after halt.\"\n2233\t     :manifest-bindings (count manifest) :function-arity-candidates (count all-arities)\n2234\t     :manifest-functions (count (filter :arities kernel-entries))\n2235\t     :admitted-function-arity-count (count admitted-arities)\n2236\t     :excluded-function-arity-count (- (count all-arities) (count admitted-arities))\n2237\t     :binding-dispositions (frequencies (map :disposition manifest))\n2238\t     :admission-note \"Manifest dispositions define the denominator independently of fixture success; excluded bindings retain explicit portability reasons.\"\n2239\t     :program-status (if (empty? unexercised) :fixture-closure-complete :execution-evidence-incomplete)\n2240\t     :residual-closure kernel-fixture-closure\n2241\t     :coverage {:proven-direct-function-arities (vec (sort-by pr-str direct))\n2242\t                :exercised-count (count exercised) :unexercised unexercised\n2243\t                :entries exercise-entries\n2244\t                :named-integration-fixture-ids (vec (sort kernel-named-integrations))\n2245\t                :transitive-execution-coverage :recorded-function-arity-body-entry\n2246\t                :context-extra-arguments kernel-context-extra-arguments\n2247\t                :trace {:record-shape '[guest-function arity]\n2248\t                        :transport :explicit-guest-stream :lanes [:c-walker :c-semantic]\n2249\t                        :point :selected-arity-body-entry}\n2250\t                :basis \"Passing direct calls or named integrations must record the exact function/arity executing in both C lanes. Static closure membership never counts; full branch coverage is not required.\"\n2251\t                :inventory inventory}\n2252\t     :recorded-portability-boundaries\n2253\t     (mapv #(select-keys % [:id :status :recorded-deviation])\n2254\t           (filter #(= :recorded-deviation (:status %)) results))\n2255\t     :recorded-upstream-failures\n2256\t     (mapv #(select-keys % [:id :status :recorded-upstream-failure])\n2257\t           (filter #(= :recorded-upstream-failure (:status %)) results))\n2258\t     :counts (frequencies (map :status results)) :fixture-count (count results)\n2259\t     :negative-fixture-count (count (filter :negative? results))\n2260\t     :dependency-graph\n2261\t     (into (sorted-map)\n2262\t           (for [[fname source] kernel-sources]\n2263\t             [fname (vec (sort (filter (set (keys kernel-sources)) (walk-symbols source))))]))\n2264\t     :fixtures results}))\n2265\t\n2266\t\n2267\t(defn write-kernel-gate-evidence!\n2268\t  \"Explicit evidence/coverage refresh; normal tests never update these files.\n2269\t   With `dir`, writes into that directory (the round-trip test's temp dir);\n2270\t   without it, the checked-in locations.\"\n2271\t  ([] (write-kernel-gate-evidence! \"test/yang/latte_oracle\"))\n2272\t  ([dir]\n2273\t   (let [evidence (kernel-gate-evidence)]\n2274\t     (spit (str dir \"/slice9_unexercised.edn\")\n2275\t           (str \";; GENERATED from exact execution evidence in both C lanes.\\n\"\n2276\t                (pr-str (into (sorted-map-by #(compare (pr-str %1) (pr-str %2)))\n2277\t                              (for [entry (get-in evidence [:coverage :entries])\n2278\t                                    :when (= :unexercised (:exercise entry))]\n2279\t                                [(:function-arity entry) (:missing-dependency entry)]))) \"\\n\"))\n2280\t     (with-open [w (io/writer (str dir \"/slice9_evidence.edn\"))]\n2281\t       ;; prn keeps (quote ...) in valid EDN rather than pprint's reader\n2282\t       ;; shorthand. One fixture per line keeps refreshes independently diffable.\n2283\t       (binding [*out* w *print-length* nil *print-level* nil]\n2284\t         (print \"{\")\n2285\t         (doseq [[k v] (dissoc evidence :fixtures)] (pr k) (print \" \") (prn v))\n2286\t         (println \":fixtures [\")\n2287\t         (doseq [row (:fixtures evidence)] (prn row))\n2288\t         (println \"]}\")))\n2289\t     (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage]))))\n2290\t\n2291\t\n2292\t(deftest test-kernel-differential-gate\n2293\t  (let [evidence (kernel-gate-evidence)]\n2294\t    (is (= (count (:fixtures kernel-gate-corpus)) (count (set (map :id (:fixtures evidence)))))\n2295\t        \"Every named fixture runs exactly once, including negatives\")\n2296\t    (doseq [row (:fixtures evidence)\n2297\t            :when (and (:negative? row) (= :completed (get-in row [:a :status])))\n2298\t            :let [outcome (get-in row [:a :outcome]) value (:value outcome)\n2299\t                  fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n2300\t      (is (or (:thrown outcome) (false? value) (and (sequential? value) (= :ko (first value)))\n2301\t              (and (:refusal-path fixture) (false? (get-in outcome (:refusal-path fixture)))))\n2302\t          (str \"A must actually reject the named negative: \" (:id row))))\n2303\t    (is (= (:function-arity-candidates evidence)\n2304\t           (+ (:admitted-function-arity-count evidence) (:excluded-function-arity-count evidence)))\n2305\t        \"Admitted and excluded arities partition the candidate inventory\")\n2306\t    (is (every? #(every? true? (vals (:agreement %)))\n2307\t                (filter #(= :pass (:status %)) (:fixtures evidence)))\n2308\t        \"Every passing fixture records independent A/B/C agreement\")\n2309\t    (let [entries (get-in evidence [:coverage :entries])\n2310\t          unexercised (filter #(= :unexercised (:exercise %)) entries)\n2311\t          deviations (filter #(= :recorded-deviation (:status %)) (:fixtures evidence))]\n2312\t      (is (= (:admitted-function-arity-count evidence) (count entries)\n2313\t             (count (set (map :function-arity entries)))))\n2314\t      (is (= (set (get-in evidence [:coverage :unexercised]))\n2315\t             (set (map :function-arity unexercised))\n2316\t             (set (keys kernel-unexercised-reasons))))\n2317\t      (is (every? #(seq (:missing-dependency %)) unexercised))\n2318\t      (is (every? #(case (:exercise %)\n2319\t                     :direct (seq (:direct-fixture-ids %))\n2320\t                     :named-integration (seq (:integration-fixture-ids %))\n2321\t                     :unexercised (and (empty? (:direct-fixture-ids %))\n2322\t                                       (empty? (:integration-fixture-ids %)))) entries))\n2323\t      (doseq [{[symbol n] :function-arity :keys [direct-fixture-ids integration-fixture-ids]} entries\n2324\t              id (concat direct-fixture-ids integration-fixture-ids)\n2325\t              :let [row (first (filter #(= id (:id %)) (:fixtures evidence)))]]\n2326\t        (is (= :pass (:status row)))\n2327\t        (is (kernel-executed-arity? row symbol n)\n2328\t            (str \"Every credited path re-derives from both execution traces: \" [symbol n id])))\n2329\t      (is (= #{:elab-after-qed :check-after-qed} (set (map :id deviations))))\n2330\t      (is (every? #(and (:recorded-deviation %)\n2331\t                        (not (every? true? (vals (:agreement %))))) deviations)))\n2332\t    (testing \"Previously declared residual consumers must still prove their exact arities\"\n2333\t      (is (= 20 (count kernel-fixture-closure)))\n2334\t      (doseq [[arity {:keys [fixture expected] :as closure}] kernel-fixture-closure\n2335\t              :let [row (first (filter #(= fixture (:id %)) (:fixtures evidence)))\n2336\t                    entry (first (filter #(= arity (:function-arity %)) (get-in evidence [:coverage :entries])))]]\n2337\t        (is (= :pass (:status row)) (str arity \" via \" fixture))\n2338\t        (is (some #{fixture} (concat (:direct-fixture-ids entry) (:integration-fixture-ids entry)))\n2339\t            (str \"Primary consumer must contribute to arity evidence: \" arity))\n2340\t        (is (contains? closure :expected))\n2341\t        (is (= {:value expected} (get-in row [:a :outcome])) (str fixture \" has the intended result\"))))\n2342\t    (is (= #{:typing-ascription :compile-malformed}\n2343\t           (set (map :id (:recorded-upstream-failures evidence)))))\n2344\t    (doseq [row (:fixtures evidence)\n2345\t            :when (= :recorded-upstream-failure (:status row))\n2346\t            :let [fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n2347\t      (is (:recorded-upstream-failure row))\n2348\t      (is (not (every? true? (vals (:agreement row)))))\n2349\t      (is (nil? (kernel-upstream-failure (assoc fixture :id :unexpected)\n2350\t                                         (:a row) (:b row) (:c-walker row) (:c-semantic row))))\n2351\t      (is (nil? (kernel-upstream-failure (assoc fixture :call '(changed-input))\n2352\t                                         (:a row) (:b row) (:c-walker row) (:c-semantic row))))\n2353\t      (is (nil? (kernel-upstream-failure fixture (:a row) (:b row)\n2354\t                                         (assoc-in (:c-walker row) [:outcome 1 :yin.k/data] {:changed true})\n2355\t                                         (:c-semantic row)))))\n2356\t    (println \"KERNEL-GATE\" (pr-str (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates\n2357\t                                                          :recorded-portability-boundaries :recorded-upstream-failures])))\n2358\t    (doseq [row (:fixtures evidence) :when (not= :pass (:status row))]\n2359\t      (println (case (:status row)\n2360\t                 :recorded-deviation \"KERNEL-RECORDED-BOUNDARY\"\n2361\t                 :recorded-upstream-failure \"KERNEL-RECORDED-UPSTREAM-FAILURE\"\n2362\t                 \"KERNEL-BLOCKER\")\n2363\t               (pr-str {:id (:id row) :status (:status row)\n2364\t                        :blocked-by (get-in row [:c-walker :blocked-by])\n2365\t                        :a (get-in row [:a :status]) :b (get-in row [:b :status])\n2366\t                        :c-walker (get-in row [:c-walker :status])\n2367\t                        :c-semantic (get-in row [:c-semantic :status])})))\n2368\t    (is (= :pass (:gate-status evidence))\n2369\t        (str \"Kernel gate remains blocked: \" (:counts evidence)\n2370\t             \"; admitted/candidate but unexercised function/arities=\" (count (get-in evidence [:coverage :unexercised]))\n2371\t             \". See slice9_evidence.edn; blocked fixtures are not accepted negatives.\"))))\n2372\t\n2373\t\n2374\t(deftest test-kernel-gate-evidence-writer-round-trip\n2375\t  \"Rewriting the checked-in evidence through the writer into a temporary\n2376\t   directory reproduces it exactly: the statuses (including the declared\n2377\t   deviations), the raw comparisons and the coverage survive. No fixtures\n2378\t   re-run; the checked-in file is the fixture.\"\n2379\t  (let [dir (str (System/getProperty \"java.io.tmpdir\") \"/slice9-roundtrip-\" (System/currentTimeMillis))\n2380\t        committed (edn/read-string (slurp \"test/yang/latte_oracle/slice9_evidence.edn\"))]\n2381\t    (try\n2382\t      (.mkdirs (java.io.File. dir))\n2383\t      (with-redefs [kernel-gate-evidence (constantly committed)]\n2384\t        (write-kernel-gate-evidence! dir))\n2385\t      (let [written (edn/read-string (slurp (str dir \"/slice9_evidence.edn\")))]\n2386\t        (is (= committed written) \"the writer's output re-reads as the same evidence\")\n2387\t        (is (= #{:elab-after-qed :check-after-qed}\n2388\t               (set (map :id (filter #(= :recorded-deviation (:status %)) (:fixtures written)))))\n2389\t            \"the declared departures survive as recorded deviations\")\n2390\t        (is (every? (fn [row]\n2391\t                      (and (contains? row :a) (contains? row :b)\n2392\t                           (contains? row :c-walker) (contains? row :c-semantic)))\n2393\t                    (:fixtures written))\n2394\t            \"every fixture row keeps its raw A/B/C comparisons\")\n2395\t        (let [unexercised (edn/read-string (slurp (str dir \"/slice9_unexercised.edn\")))]\n2396\t          (is (= (count (get-in written [:coverage :unexercised])) (count unexercised))\n2397\t              \"the companion file lists every unexercised arity with its dependency\")))\n2398\t      (finally\n2399\t        (run! #(let [f (java.io.File. (str dir \"/\" %))] (when (.exists f) (.delete f)))\n2400\t              [\"slice9_evidence.edn\" \"slice9_unexercised.edn\"])\n2401\t        (let [d (java.io.File. dir)] (when (.exists d) (.delete d)))))))"}
{"role":"tool","tool_call_id":"tool_MyBEGQZeAsmOu6mILrpFhFZb","content":"1\t# Slice 9 kernel differential gate: execution evidence correction\n2\t\n3\tThe gate on the hardening line is **blocked**. The architect denied the prior\n4\t165/165 closure claim because membership in a static dependency closure did\n5\tnot prove execution of every arity. That claim is withdrawn. The gate retains\n6\tits final assertion `(= :pass (:gate-status evidence))`; missing execution\n7\tevidence must fail that assertion.\n8\t\n9\tThe 106-fixture corpus has **100 passing agreements, two recorded deviations\n10\t(`elab-after-qed`, `check-after-qed`), two blocked fixtures, and two recorded\n11\tupstream failures.** The four narrowly recorded exception dispositions remain\n12\tdeclared departures, not agreements. No upstream or `src/cljc/` source changes\n13\tare made by H3-0. Admission is unchanged: 155 bindings (146 admitted, 9\n14\texcluded) and 175 candidate function/arities (165 admitted, 10 excluded).\n15\t\n16\tRecorded executions establish **107/165** admitted arities: 39 directly\n17\tand 68 through named integrations. The other **58**, including `parse/1`,\n18\tremain uncredited. The declared departures are carried by the versioned\n19\t[`slice9_declarations.edn`](slice9_declarations.edn) (provenance `ea18c8e4^`),\n20\trevalidated on every refresh by the representation-aware classifier: the\n21\tguest `:meta` value may be a pre-adoption raw closure or the admitted §8.10\n22\tdescriptor; forged shapes refuse. The corrected counts and remaining arities\n23\tare recorded in [`slice9_evidence.edn`](slice9_evidence.edn) and\n24\t[`slice9_unexercised.edn`](slice9_unexercised.edn). The residual consumers in\n25\t[`fixture_closure.edn`](fixture_closure.edn) retain their concrete expected\n26\toutcomes; they do not establish closure of the full inventory, and their\n27\tcount (20) predates the re-derivation — the live unexercised set is the\n28\t58-name list.\n29\t\n30\t## Consumer evidence\n31\t\n32\t- `mkenv` preserves a nonempty global environment and creates empty locals.\n33\t- `beta-red`, `delta-normalize`, and `delta-normalize-local` have explicit\n34\t  entry fixtures and missing-reference rejections. The local wrapper also\n35\t  exercises explicit local definitions and their precedence over an ambient\n36\t  namespace definition.\n37\t- `install-unfold-implicit!` installs into both isolated upstream atoms on A.\n38\t  B/C return an updated immutable context, used by both the delta wrapper and\n39\t  NBE. Both normalizers read the same installed extension. An installed\n40\t  refusing extension propagates its original error data.\n41\t- `install-opacity-function` starts from a refusing policy, explicitly installs\n42\t  the working policy, then enters the original proof dispatcher through\n43\t  opaque/transparent steps and qed. A duplicate opaque step rejects. A uses\n44\t  an isolated namespace and host-local Var policy; B/C thread immutable\n45\t  definition updates through the explicit context.\n46\t- `install-fundamental-unparsers!` starts from an empty registry, installs the\n47\t  fundamental product unparser, then unparses nested implications. Dependent\n48\t  products and atoms remain unchanged. Direct `prod-impl-unparser` fixtures\n49\t  also verify its `[term false]` refusal result.\n50\t- `exists-kw?`, `term?`, `pair?`, and `vectorn?` include false results.\n51\t  `bound-vars` distinguishes a bound occurrence from entirely free variables.\n52\t  These fixtures preserve upstream behavior, including its shallow term\n53\t  validator and the use of `vector` rather than `vector?` in utility predicates.\n54\t- `proper-type?` enters each arity separately. Unknown variables throw;\n55\t  a well-typed term whose inferred type is not a sort returns false.\n56\t- `show-deftype` checks definition, axiom, theorem, implicit, and unknown\n57\t  labels. It depends only on portable record-kind predicates and returns a\n58\t  string. Host pprint and stdout functions remain excluded.\n59\t- `safe-get` covers successful lookup, missing keys, stored false, and stored\n60\t  nil. The latter three all reject upstream. `vremove` removes every match,\n61\t  preserves a no-match vector, and propagates a predicate's domain exception.\n62\t\n63\t`mkenv`, `appify`, and `bound-vars` have no domain rejection in the pinned\n64\tsource; the fixtures preserve their constructor, empty-input, and empty-set\n65\tresults instead of manufacturing refusals. A refused product rewrite is\n66\tidentified by its explicit modification flag, not mistaken for an exception.\n67\t\n68\tThe pinned local delta wrapper has a narrower portability scope than its\n69\tdocstring suggests: `delta-step` drops `local?` when calling `delta-reduction`\n70\ton a reference. Consequently upstream can resolve a global or host namespace\n71\tdefinition on that path. The global-result fixture preserves this behavior;\n72\tthe namespace fixture supplies a local definition that shadows the ambient\n73\tone. The guest boundary still requires explicit definitions and has no host\n74\tnamespace lookup capability. This round does not repair upstream or claim\n75\tagreement for ambient-only resolution.\n76\t\n77\t## Acceptance counting\n78\t\n79\tEvery selected guest function body appends `[guest-function arity]` to an\n80\texplicit diagnostic stream at entry. Instrumentation covers all arities of\n81\tthe functions supplied to each fixture, including higher-order calls through\n82\tregistries and extension closures. Each C lane creates its own stream.\n83\tAfter the VM halts, the harness reads that stream through its own\n84\tcursor, preserving the fixture's original outcome and exception payload.\n85\tA/B remain uninstrumented. Raw ordered call records are retained under\n86\t`:c-walker :executed-calls` and `:c-semantic :executed-calls` for every completed\n87\tfixture. The original uninstrumented fixtures used 1,000,000 instructions per\n88\tlane. The instrumented fixtures have a 2,000,000 instruction bound because\n89\tbody-entry stream writes add guest instructions. Reading the completed\n90\tdiagnostic stream is harness work after halt. This is an instrumentation\n91\tbudget change, not a new performance acceptance claim.\n92\t\n93\tPassing direct fixtures contribute only their original function/argument\n94\tcount, and only with matching body-entry records in both C lanes. Passing\n95\tnamed integrations contribute only exact arities recorded in both C lanes.\n96\tStatic dependency membership contributes no credit. Full branch coverage is\n97\tnot required. Context adapter identities and explicit extra context arguments\n98\tare recorded in the evidence; each observed guest arity is checked against\n99\tthat mapping individually, never against all arities of its function.\n100\t\n101\tOnly `:pass` fixture rows contribute exercise evidence. Recorded upstream\n102\tfailures and deviations do not contribute. Any admitted arity without a\n103\tpassing direct or named integration execution path blocks the gate.\n104\t\n105\tThe accounting regression first failed against the old implementation: it\n106\tcredited the deliberately uncalled arity and accepted missing C-lane traces.\n107\tIt now requires both traces and leaves unused arities uncredited. A second\n108\tregression replaces the adapted `parse/1` body in memory with an unconditional\n109\terror, then runs `:parse-to-normalize-to-type`. A/B and both C lanes still\n110\tpass; both C traces record `parse/2` and no `parse/1`, and the counter leaves\n111\t`parse/1` uncredited. Every credited path is also checked against the recorded\n112\texecutions of its named fixture. See\n113\t[`slice9_arity_accounting_test.txt`](slice9_arity_accounting_test.txt).\n114\t\n115\t## Recorded portability boundaries\n116\t\n117\tThe two `:recorded-deviation` rows remain `:elab-after-qed` and\n118\t`:check-after-qed`. Upstream embeds `clojure.core/meta`, a host function, in\n119\texception data; C carries a guest closure. The original outcomes, comparison\n120\tflags, exact payload guards, and evidence pointers remain intact. Both rows\n121\tare listed in `:recorded-portability-boundaries` in the summary. Neither is\n122\treported as agreement.\n123\t\n124\t## Recorded upstream failures\n125\t\n126\t`:typing-ascription` still reaches the upstream declaration\n127\t`type-of-ascribe`, which has no definition. A raises its original unbound-fn\n128\texception; B/C retain the explicit branch-local refusal.\n129\t\n130\t`:compile-malformed` still passes scalar proof input `[42]`. A/B raise the\n131\toriginal native sequence exception; C retains its portable sequence refusal.\n132\t\n133\tThese two rows have the distinct disposition `:recorded-upstream-failure` and\n134\tare listed in `:recorded-upstream-failures`. Their original A/B/C records and\n135\tfalse agreement flags remain available. The disposition checks the exact\n136\tfixture ID, input call, exception class/message, B outcome, and both completed\n137\tC outcomes. Changed calls, IDs, or C payloads are tested to refuse the\n138\tdisposition. Any other execution failure remains a blocker. No upstream fix,\n139\taccepted-negative claim, or equality projection is introduced for these rows.\n140\t\n141\t## Verification\n142\t\n143\tThe accounting tests pass 2 tests and 22 assertions. An independent audit\n144\tre-derives all 145 retained arities and all 360 credited fixture paths from\n145\tthe two raw C traces. The four regression suites pass 122 tests and 1,338\n146\tassertions. Kondo reports zero errors and warnings; cljstyle and\n147\t`git diff --check` pass. The full oracle runs 26 tests and 1,879 assertions\n148\twith exactly one failure and no errors: its retained\n149\t`(= :pass (:gate-status evidence))` closure assertion. The missing 20 arities\n150\ttherefore continue to block acceptance. Verification results are recorded in\n151\t[`slice9_verification.edn`](slice9_verification.edn), with command outputs\n152\tbeside it.\n153\t`yang.latte-oracle-test/write-kernel-gate-evidence!` explicitly regenerates\n154\tboth execution evidence and the remaining-arity inventory; normal tests do\n155\tnot write them. Evidence retains the pinned upstream revision, compiler\n156\tdigest, runtime, instruction budget, per-fixture outcomes, diagnostic traces,\n157\tdependency graph, admission inventory, credited paths, and all four recorded\n158\texception dispositions.\n159\t\n160\tThe append-only correction in [`known-gaps.md`](../../../docs/agents/known-gaps.md)\n161\trecords that host Clojure turns a thrown string into `ClassCastException`,\n162\tcaught by `catch Exception` but not `catch ExceptionInfo`. Portable `try` binds\n163\tthe error payload without equivalent runtime class handling; this guest/host\n164\tgap remains declared.\n165\t\n166\tExecution scope is both C evaluators on the JVM. This correction does not\n167\tclaim renewed architect sign-off or Node/Dart verification, and the blocked\n168\tgate does not authorize program closure or merge."}
