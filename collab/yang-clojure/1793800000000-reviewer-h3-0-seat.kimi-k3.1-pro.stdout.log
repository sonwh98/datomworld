{"role":"tool","tool_call_id":"tool_6g1cbDg3tizBtZ178SJ7qZpk","content":"110\t \n111\tdiff --git a/test/yang/latte_oracle_test.clj b/test/yang/latte_oracle_test.clj\n112\tindex bf4e3627..45367c76 100644\n113\t--- a/test/yang/latte_oracle_test.clj\n114\t+++ b/test/yang/latte_oracle_test.clj\n115\t@@ -1927,32 +1927,68 @@\n116\t                                   \"No passing direct fixture or named integration records this exact arity in both C lanes.\"))})))\n117\t \n118\t \n119\t+(def ^:private kernel-declarations\n120\t+  \"The declared dispositions: explicit, versioned input to classification.\n121\t+   Generated evidence is never their source of truth; provenance is in-file.\n122\t+   A declaration whose revalidation guards fail leaves its row a blocker,\n123\t+   not a deviation.\"\n124\t+  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_declarations.edn\"))))\n125\t+\n126\t+(defn- kernel-callable-descriptor?\n127\t+  \"True when `value` is the admitted common-call descriptor the reconciled\n128\t+   compiler publishes for a guest closure: a function-type marker, an entry\n129\t+   that is itself a minted closure, and an admission witness. Forged shapes -\n130\t+   a bare `{:type :closure}` map, a scalar or missing entry, a missing\n131\t+   witness - fail.\"\n132\t+  [value]\n133\t+  (and (map? value)\n134\t+       (= :function (:clj/type value))\n135\t+       (values/closure? (get value :yang.call/entry))\n136\t+       (values/closure? (get value :clj/admission))))\n137\t+\n138\t (defn- kernel-host-value-deviation\n139\t   [id a b walker semantic]\n140\t   ;; Disposition only: keep every original comparison and all four outcomes.\n141\t   ;; A new failure outside this exact host-value boundary remains a mismatch.\n142\t-  (when (and (contains? #{:elab-after-qed :check-after-qed} id)\n143\t-             (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n144\t-             (= (:outcome a) (:outcome b))\n145\t-             (= (get-in a [:outcome :thrown :data :meta])\n146\t-                {:nonportable-host-value (str (class clojure.core/meta))})\n147\t-             (= \"Wrong proof script: proof steps after qed.\"\n148\t-                (get-in a [:outcome :thrown :message]))\n149\t-             (every? (fn [c]\n150\t-                       (and (= :yin.k/error (first (:outcome c)))\n151\t-                            (= (get-in a [:outcome :thrown :message])\n152\t-                               (get-in c [:outcome 1 :yin.k/message]))\n153\t-                            (= (dissoc (get-in a [:outcome :thrown :data]) :meta)\n154\t-                               (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta))\n155\t-                            (= (result-shape (dissoc (get-in a [:outcome :thrown :data]) :meta))\n156\t-                               (result-shape (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta)))\n157\t-                            (values/closure? (get-in c [:outcome 1 :yin.k/data :meta]))))\n158\t-                     [walker semantic]))\n159\t-    {:boundary :nonportable-host-value\n160\t-     :upstream-value 'clojure.core/meta\n161\t-     :evidence {:file \"slice9_evidence.edn\" :fixture-id id\n162\t-                :path [:a :outcome :thrown :data :meta]}\n163\t-     :reason \"Upstream embeds a host function in error data; the guest carries its closure. No agreement is claimed.\"}))\n164\t+  ;; The declared boundary, upstream value and reason come from the versioned\n165\t+  ;; declarations file; the guards revalidate the live execution against it.\n166\t+  (let [declared (get-in kernel-declarations [:portability id])]\n167\t+    (when (and declared\n168\t+               (contains? #{:elab-after-qed :check-after-qed} id)\n169\t+               (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n170\t+               (= (:outcome a) (:outcome b))\n171\t+               (= (get-in a [:outcome :thrown :data :meta])\n172\t+                  {:nonportable-host-value (str (class clojure.core/meta))})\n173\t+               (= \"Wrong proof script: proof steps after qed.\"\n174\t+                  (get-in a [:outcome :thrown :message]))\n175\t+               ;; The declaration must describe THIS failure: same message and\n176\t+               ;; same script (top-level sequential shape normalized), or the\n177\t+               ;; guard fails and the row stays a blocker.\n178\t+               (= (:message declared) (get-in a [:outcome :thrown :message]))\n179\t+               (= (vec (:script declared))\n180\t+                  (vec (get-in a [:outcome :thrown :data :script])))\n181\t+               (every? (fn [c]\n182\t+                         (and (= :yin.k/error (first (:outcome c)))\n183\t+                              (= (get-in a [:outcome :thrown :message])\n184\t+                                 (get-in c [:outcome 1 :yin.k/message]))\n185\t+                              (= (dissoc (get-in a [:outcome :thrown :data]) :meta)\n186\t+                                 (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta))\n187\t+                              (= (result-shape (dissoc (get-in a [:outcome :thrown :data]) :meta))\n188\t+                                 (result-shape (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta)))\n189\t+                              (let [meta (get-in c [:outcome 1 :yin.k/data :meta])]\n190\t+                                ;; Both representations the pipeline actually\n191\t+                                ;; produces: a pre-adoption raw closure, or the\n192\t+                                ;; admitted §8.10 descriptor. Anything else -\n193\t+                                ;; including an invented `{:type :closure}` map -\n194\t+                                ;; fails.\n195\t+                                (or (values/closure? meta)\n196\t+                                    (kernel-callable-descriptor? meta)))))\n197\t+                       [walker semantic]))\n198\t