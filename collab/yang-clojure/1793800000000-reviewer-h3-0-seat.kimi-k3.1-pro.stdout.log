\t+    (is (= (vec (:script (get-in kernel-declarations [:portability :elab-after-qed]))) (vec script))\n227\t+        \"The controls model the declared script exactly\")\n228\t+    (let [a {:status :completed\n229\t+             :outcome {:thrown {:message \"Wrong proof script: proof steps after qed.\"\n230\t+                                :data {:script script\n231\t+                                       :meta {:nonportable-host-value (str (class clojure.core/meta))}}}}}\n232\t+          descriptor {:yang.call/entry (values/closure nil {})\n233\t+                      :clj/type :function\n234\t+                      :clj/outcomes? true\n235\t+                      :clj/admission (values/closure nil {})}\n236\t+          c-with (fn [meta]\n237\t+                   {:status :completed\n238\t+                    :outcome [:yin.k/error {:yin.k/message \"Wrong proof script: proof steps after qed.\"\n239\t+                                            :yin.k/data {:script script :meta meta}}]})]\n240\t+      ;; Both representations the reconciled pipeline actually produces.\n241\t+      (is (some? (kernel-host-value-deviation :elab-after-qed a a\n242\t+                                             (c-with (values/closure nil {})) (c-with (values/closure nil {})))))\n243\t+      (is (some? (kernel-host-value-deviation :elab-after-qed a a (c-with descriptor) (c-with descriptor)))\n244\t+          \"The admitted §8.10 descriptor classifies as the declared deviation\")\n245\t+      (is (nil? (kernel-host-value-deviation :other a a (c-with descriptor) (c-with descriptor))))\n246\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a (assoc (c-with descriptor) :status :blocked) (c-with descriptor))))\n247\t+      ;; Payload and shape mutations refuse.\n248\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n249\t+                                             (assoc-in (c-with descriptor) [:outcome 1 :yin.k/data :script] [:new-mismatch])\n250\t+                                             (c-with descriptor))))\n251\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n252\t+                                             (assoc-in (c-with descriptor) [:outcome 1 :yin.k/data :script] '())\n253\t+                                             (c-with descriptor))))\n254\t+      ;; Descriptor forgeries refuse.\n255\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n256\t+                                             (c-with (dissoc descriptor :clj/admission))\n257\t+                                             (c-with (dissoc descriptor :clj/admission))))\n258\t+          \"a descriptor without its admission witness fails\")\n259\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n260\t+                                             (c-with (assoc descriptor :yang.call/entry :not-a-closure))\n261\t+                                             (c-with (assoc descriptor :yang.call/entry :not-a-closure))))\n262\t+          \"a descriptor whose entry is not a minted closure fails\")\n263\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a\n264\t+                                             (c-with (assoc descriptor :clj/type :data))\n265\t+                                             (c-with (assoc descriptor :clj/type :data))))\n266\t+          \"a descriptor with a wrong type marker fails\")\n267\t+      (is (nil? (kernel-host-value-deviation :elab-after-qed a a (c-with {:type :closure}) (c-with {:type :closure}))))\n268\t+      ;; A mutated declaration (declared message != live failure) fails the guard.\n269\t+      (with-redefs [kernel-declarations (assoc-in kernel-declarations\n270\t+                                                  [:portability :elab-after-qed :message]\n271\t+                                                  \"A different declared failure\")]\n272\t+        (is (nil? (kernel-host-value-deviation :elab-after-qed a a (c-with descriptor) (c-wi