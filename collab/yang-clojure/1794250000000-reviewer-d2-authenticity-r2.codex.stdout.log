   (fn [node]\n                     (if (= node u/capture) (u/lit :invalid-continuation) node))\n                   (outcome-ast forms)))]\n    (doseq [run [walker-run semantic-run]]\n      (let [result (first (run (tamper '[(defn f\n                                           []\n","exit_code":0,"status":"completed"}}
