{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='src/cljc/yang/clojure.cljc';s=open(p).read();a=s.index('(defn- compile-call-descriptor');b=s.index('(defn- compile-av-fn',a);part=s[a:b].replace(':yang.call/eligible?', ':clj/admission');s=s[:a]+part+s[b:];s=s.replace('dsg__witness (dsg__get dsg__candidate :yang.call/eligible?)', 'dsg__witness (dsg__get dsg__candidate :clj/admission)');\n# Explicit source eligibility uses admission, never bare map structure.\npos=s.index('    ;; a statically native name: call it directly', s.index('(defn- compile-av-application'))\ns=s[:pos]+'''    (and (outcomes? env) (= operator 'yang.call/eligible?))\n    (cond-> (apply u/app (u/v 'dsg__admitted?)\n                   (map #(compile-form % false env macro-env) operands))\n      tail? (assoc :tail? true))\n\n'''+s[pos:]\nopen(p,'w').write(s)\nPY\npython3 - <<'PY'\np='test/yang/clojure_test.clj';s=open(p).read();s=s.replace('[yang.clojure :as yang]', '[yang.clojure :as yang]\\\\n            [yang.core.uast :as u]')\na=s.index('(deftest test-common-call-hand-constructed-descriptor');b=s.index('(deftest test-common-call-rejects-named-arguments',a)\ns=s[:a]+'''(deftest test-common-call-hand-constructed-descriptor\n  (testing \\\"explicit UAST/profile construction admits a foreign body\\\"\n    ;; The constructor runs inside the compiled profile's private bindings.\n    ;; No Clojure source map receives admission from its entry spelling.\n    (let [descriptor (#'yang/compile-call-descriptor\n                       (u/lam ['av]\n                              (u/app (u/v 'conj) (u/lit [:yin.k/ok]) (u/v 'av)))\n                       false)\n          ast (walk/postwalk\n                (fn [node]\n                  (if (= node (u/v 'profile-function)) descriptor node))\n                (outcome-ast '[(profile-function 40 2)]))]\n      (doseq [run [walker-run semantic-run]]\n        (is (= [:yin.k/ok [40 2]] (first (run ast))))))))\n\n\n(deftest test-common-call-shadowed-helpers\n  (doseq [binding '[get = assoc empty?]]\n    (testing (str \\\"construction and invocation with a local \\\" binding)\n      (is (= [:yin.k/ok 21]\n             (run-outcome [(list 'let [binding 5]\n                                '(let [f (fn [x] x)] (f 21)))]))))\n    (testing (str \\\"raise through a parameter named \\\" binding)\n      (is (= [:yin.k/error {:yin.k/message \\\"boom\\\", :yin.k/data {:x 21}}]\n             (run-outcome\n               ['(defn g [] (throw (ex-info \\\"boom\\\" {:x 21})))\n                (list 'defn 'f [binding] '(g))\n                '(+ 1 (f 5))])))))\n  (is (= [:yin.k/ok 1]\n         (run-outcome '[(def f (let [get 5] (fn [x] x))) (f 1)]))))\n\n\n(deftest test-common-call-source-admission\n  (doseq [form '[(let [x 5] (x 1))\n                (let [x {:ordinary :map}] (x 1))\n                (let [x {:yang.call/entry 5}] (x 1))\n                (let [x {:py/type :function :code :legacy}] (x 1))\n                (let [x {:yang.call/entry (yang.call/entry f)}] (x 1))\n                (let [x (assoc {} :yang.call/entry (get f :yang.call/entry))] (x 1))\n                (let [x (assoc f :extra :forged)] (x 1))\n                (let [x (assoc f :yang.call/entry (yang.call/entry g))] (x 1))\n                (let [x (assoc {} :yang.call/entry (yang.call/entry f)\n                                 :clj/admission (get f :clj/admission))] (x 1))\n                (let [x {:yang.call/entry (yang.call/entry f)\n                         :clj/admission (fn [x] true)}] (x 1))]]\n    (doseq [wrap [identity #(list '+ 1 %)]]\n      (let [result (run-outcome ['(defn f [x] x)\n                                '(defn g [x] (+ x 1)) (wrap form)])]\n        (is (= :yin.k/error (first result)) (pr-str form))\n        (is (= :yang.call/not-callable (:yang.call/reason (second result)))\n            (pr-str form)))))\n  (is (= [:yin.k/ok [false false true 21]]\n         (run-outcome '[(defn f [x] x)\n                        [(yang.call/eligible? {:yang.call/entry (yang.call/entry f)})\n                         (yang.call/eligible? (assoc f :extra :forged))\n                         (yang.call/eligible? f)\n                         (f 21)]]))))\n\n\n(deftest test-common-call-invalid-continuation-refuses\n  (let [ast (walk/postwalk\n              (fn [node]\n                (if (= node u/capture) (u/lit :invalid-continuation) node))\n              (outcome-ast '[(defn f [] 1) (+ 1 (f))]))]\n    (doseq [run [walker-run semantic-run]]\n      (let [result (first (run ast))]\n        (is (= :yin.k/error (first result)))\n        (is (= {:yang.call/reason :yang.call/invalid-invocation\n                :yang.call/data {:yang.call/reason :missing-raise-exit}}\n               (second result)))))))\n\n\n'''+s[b:]\ns=s.replace('''        (when (= lane :semantic)\n          (is (= (- d1000 d100) (* 9 (- d100 d0)))\n              (str tag \\\": one bounded outcome-conversion frame chain per source activation\\\")))''','''        (is (= d100 d1000)\n            (str tag \\\": depth is constant in the iteration count\\\"))\n        (is (<= d1000 (+ d0 2))\n            (str tag \\\": at most two frames above the initial call\\\"))''')\nopen(p,'w').write(s)\nPY\nclj -M:kondo --lint src/cljc/yang/clojure.cljc test/yang/clojure_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
