20\t(defn- quote-symbols\n   621\t  \"`quoted?` is true inside a `(quote ...)` form: its symbols print as they\n   622\t   are, but host functions at any depth still become the marker.\"\n   623\t  [namer quoted? x]\n   624\t  (cond (symbol? x) (if quoted? x (list 'quote x))\n   625\t        (fn? x) (host-fn-marker namer x)\n   626\t        ;; a closure or continuation is opaque: its kind, never its payload,\n   627\t        ;; a captured value or its owner tag\n   628\t        (values/host-typed? x)\n   629\t        (typed-map [[:type (if (values/closure? x) :closure :continuation)]])\n   630\t        (vector? x) (mapv #(quote-symbols namer quoted? %) x)\n   631\t        (map? x)\n   632\t        (render-map\n   633\t          ;; not `contains?`: on a sorted map with non-keyword keys it throws\n   634\t          (some #(= :type (key %)) x)\n   635\t          (map (fn [[k v]]\n   636\t                 [(quote-symbols namer quoted? k)\n   637\t                  (quote-symbols namer quoted? v)])\n   638\t               x))\n   639\t        (or (list? x) (seq? x))\n   640\t        (if (= 'quote (first x))\n   641\t          (apply list (map #(quote-symbols namer true %) x))\n   642\t          (map #(quote-symbols namer quoted? %) x))\n   643\t        :else x))\n   644\t\n   645\t\n   646\t(defn format-value\n   647\t  \"Render `value` for the REPL. `namer` (see `host-fn-namer`) names host\n   648\t   functions; without one they render nameless.\"\n   649\t  ([value] (format-value value nil))\n   650\t  ([value namer]\n   651\t   (rendered-text (quote-symbols namer false value))))\n   652\t\n   653\t\n   680\t\n   681\t(defn- emit-output!\n   682\t  [output-stream op text]\n   683\t  ;; A primitive holds no state, so it cannot record an append outcome.  The\n   684\t  ;; medium is an evict-oldest ring buffer, which never answers `full`; a closed\n   685\t  ;; medium drops the chunk and the drain reports the closure.\n   686\t  (when output-stream\n   687\t    (stream/append! output-stream {:type :repl/output :op op :text text}))\n   688\t  nil)\n   689\t\n   690\t\n   691\t(defn- emit-result!\n   692\t  \"Answer a halted evaluation's value on the output medium, after the\n   693\t   output it printed, so the shell reads results from the stream exactly as\n   694\t   it reads prints.  The token carries `round`, so the shell accepts only\n   695\t   this round's result.  Returns the append outcome, or `:untried` when\n   696\t   there is no medium.\"\n   697\t  [output-stream round value]\n   698\t  (if output-stream\n   699\t    (:dao.stream/outcome\n   700\t      (stream/append! output-stream\n   701\t                      {:type :repl/result :round round :value value}))\n   702\t    :untried))\n   703\t\n   704\t\n   705\t(defn- make-repl-primitives\n   706\t  [output-stream]\n   707\t  (merge vm/primitives\n   708\t         {'print (fn [& args]\n   709\t                   (emit-output! output-stream :print (print-text args)))\n   710\t          'println (fn [& args]\n   711\t                     (emit-output! output-stream :println\n   712\t                                   (str (print-text args) \"\\n\")))\n   713\t          'prn (fn [& args] (emit-output! output-stream :prn (prn-text args)))\n   714\t          'ast->datoms vm/ast->datoms\n   715\t          'datoms->ast vm/datoms->ast}))\n   716\t\n   717\t\n   718\t(defn- chunk-text\n   719\t  [value]\n   720\t  (if (map? value) (str (:text value)) (str value)))\n   721\t\n   722\t\n   723\t(defn- result-chunk?\n   724\t  [value]\n   725\t  (and (map? value) (= :repl/result (:type value))))\n   726\t\n   727\t\n   728\t(defn- ledger\n   729\t  [state medium outcome]\n   730\t  (assoc-in state [:ledger medium] outcome))\n   731\t\n   732\t\n   733\t(defn drain-output\n   734\t  \"Drain the output medium into `[state text results]`, total over every\n   735\t   `next` outcome.  `results` holds, in order, every `:repl/result` token\n   736\t   read, unchanged; every other element is printed text.\n   737\t\n   738\t   `ok` advances to the exact successor the handle returned and spends one\n   739\t   of `drain-budget` element reads.  `gap` prints a loss notice, resumes at\n   740\t   the recovery cursor, and spends one of `gap-budget` instead, so a gap\n   741\t   never starves the drain of an element it must still reach.  `end`,\n   742\t   `cursor-mismatch`, `invalid-cursor`, and `transport-error` print a\n   743\t   notice, leave the cursor unchanged, and end the drain.  Whatever ended the\n   744\t   drain is recorded in the ledger, so `repl-state` never has to ask a stream\n   745\t   how it is.\"\n   746\t  [state]\n   747\t  (let [output (:output-stream state)\n   748\t        cursor (:output-cursor state)]\n   749\t    (cond\n   750\t      (nil? output) [(ledger state :output :untried) \"\" []]\n   751\t      (nil? cursor) [(ledger state :output :dao.stream/invalid-cursor)\n   752\t                     \";; output unreadable: no cursor was minted\\n\"\n   753\t                     []]\n   754\t      :else\n   755\t      (loop [remaining drain-budget\n   756\t             gaps gap-budget\n   757\t             cursor cursor\n   758\t             chunks []\n   759\t             results []]\n   760\t        (if (or (zero? remaining) (zero? gaps))\n   761\t          [(-> state\n   762\t               (assoc :output-cursor cursor)\n   763\t               (ledger :output :dao.stream/blocked))\n   764\t           (apply str chunks)\n   765\t           results]\n   766\t          (let [result (stream/next output cursor)\n   767\t                outcome (:dao.stream/outcome result)\n   768\t                value (:dao.stream/value result)]\n   769\t            (case outcome\n   770\t              :dao.stream/ok\n   771\t              (if (result-chunk? value)\n   772\t                (recur (dec remaining)\n   773\t                       gaps\n   774\t                       (:dao.stream/cursor result)\n   775\t                       chunks\n  1055\t   interpreter (yin.vm.linker.dht.md 7.5,\n  1056\t   `yin.vm.linker.interpreter/composition`'s option): by default `{}`,\n  1057\t   which trusts the `:dht-key`'s own principal alone;\n  1058\t   `{:trusted #{principal}}`, each `ed25519:<hex>`, trusts more;\n  1059\t   `:verify`, `:decision` and `:decision-medium` replace the default\n  1060\t   rule.\n  1061\t   `:external` runs no interpreter in process: the questions a require\n  1062\t   asks wait for an answer appended to the session's answer medium.\n  1063\t\n  1064\t   `index-store` is the `dao.jing` byte store the code indexer publishes\n  1065\t   its covered indexes into (docs/design/yin.repl.dao.space-index.md); it\n  1066\t   outlives a session rebuild, and defaults to a fresh in-memory store.\n  1067\t\n  1068\t   `index-store-spec` is the startup selection of that store\n  1069\t   (yin.repl.store): `:mem` — the default, today's behaviour — or\n  1070\t   `{:type :file :dir dir}`, the durable content log at\n  1071\t   `<dir>/content.jing`, opened under an exclusive directory lock with\n  1072\t   its HEAD read and the snapshot it names validated — a corrupt HEAD\n  1073\t   or snapshot refuses construction, and a second owner of the directory\n  1074\t   is refused naming it.  The spec is resolved and the store opened once\n  1075\t   here, never switched at runtime, and supplying it together with\n  1076\t   `index-store` (a handle injected directly) is refused.\n  1077\t\n  1078\t   `:index-recovery` carries what the durable open recovered —\n  1079\t   `{:manifest <address or nil> :datoms <the validated snapshot or nil>}`\n  1080\t   — and the indexer is rehydrated from it here, before any evaluation\n  1081\t   is admitted (`yin.repl.index/rehydrate`): `q` answers the previous\n  1082\t   run's facts, which keep their own session tokens, while this process\n  1083\t   mints a new token for its own.  In durable mode `(reset)` and `(vm …)`\n  1084\t   carry the index across the rebuild; with the memory store they start\n  1085\t   an empty one, as they always have.\ndocs/design/yang.typescript.md:67:|    | :lower-session :render :probe      | binding map abbreviates            |\ndocs/design/yang.typescript.md:1118:`:render` (the loop prints the value of the submission's last top-level\ndocs/design/yang.antlr.md:2301:  `py/str-repr` escapes as `render/string-repr` does, which is only the\n    92\t   returns.\"\n    93\t  []\n    94\t  (cond-> frontend/empty-catalog\n    95\t    true (frontend/install (clojure-manifest)\n    96\t                           {:input :forms,\n    97\t                            :parse identity,\n    98\t                            :lower clojure-lower})\n    99\t    #?@(:cljd []\n   100\t        :jolt []\n   101\t        :default [true (frontend/install\n   102\t                         (php-manifest)\n   103\t                         {:parse php.antlr.cst/parse-source,\n   104\t                          :lower php.antlr.lower/lower-packet,\n   105\t                          :render :php/out})])\n   106\t    #?@(:cljd [true (frontend/install\n   107\t                      (antlr-manifest)\n   108\t                      {:parse (fn [source]\n   109\t                                (python.antlr.parser/parse-source (str source \"\\n\"))),\n","exit_code":0,"status":"completed"}}
