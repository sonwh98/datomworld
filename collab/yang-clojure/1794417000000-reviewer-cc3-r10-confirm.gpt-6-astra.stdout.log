         (reset! render-armed? false)\n  2616\t                 (let [[s5 after] (repl/eval-input s4 \"42\")]\n  2617\t                   (is (= \"42\" after)\n  2618\t                       \"the next round answers alone: no late fabricated Warning\")\n  2619\t                   (is (= (repl/call-provenance-failures s4)\n  2620\t                          (repl/call-provenance-failures s5)))\n  2621\t                   (is (= (repl/call-provenance-handles s4)\n  2622\t                          (repl/call-provenance-handles s5))))))))))))\n","exit_code":0,"status":"completed"}}
