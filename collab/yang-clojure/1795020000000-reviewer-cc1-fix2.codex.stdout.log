{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '230,295p' src/cljc/yin/vm/encoder.cljc; sed -n '990,1025p' src/cljc/yin/vm/macro.cljc; sed -n '1200,1265p' src/cljc/yin/vm/macro.cljc; sed -n '310,370p' test/yang/clojure_callsite_test.cljc; sed -n '950,980p' src/cljc/yin/vm.cljc; sed -n '125,165p' src/cljc/yin/vm/linker/publish.cljc; sed -n '760,800p' src/cljc/yin/vm/linker.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '230,295p' src/cljc/yin/vm/encoder.cljc; sed -n '990,1025p' src/cljc/yin/vm/macro.cljc; sed -n '1200,1265p' src/cljc/yin/vm/macro.cljc; sed -n '310,370p' test/yang/clojure_callsite_test.cljc; sed -n '950,980p' src/cljc/yin/vm.cljc; sed -n '125,165p' src/cljc/yin/vm/linker/publish.cljc; sed -n '760,800p' src/cljc/yin/vm/linker.cljc\"","aggregated_output":"(def ^:private call-site-key\n  \"The reserved frontend-metadata key of the call-site occurrence\n   contract C1 (`yang.clojure`), enforced at this boundary but not\n   owned by it.\"\n  :yang/call-site)\n\n\n(defn- marked-call-sites\n  \"The `[path value]` of every node of map AST `ast` carrying the C1\n   key, walked by the row grammar. Literal payloads are data, never\n   syntax, and are not walked. Member ASTs are already projected by the\n   time this runs, so every tag is a grammar tag.\"\n  [ast]\n  (letfn [(walk\n            [node path]\n            (into (if (contains? node call-site-key)\n                    [[path (get node call-site-key)]]\n                    [])\n                  (mapcat (fn [[j [field kind]]]\n                            (let [pos (+ j 2)\n                                  value (get node field)]\n                              (case kind\n                                :node (walk value (conj path pos))\n                                :nodes (mapcat (fn [[i child]]\n                                                 (walk child\n                                                       (conj path [pos i])))\n                                               (map-indexed vector value))\n                                nil)))\n                          (map-indexed vector\n                                       (get vm/semantic-bytecode-grammar\n                                            (:type node))))))]\n    (walk ast [])))\n\n\n(defn- check-call-site-claim!\n  \"Refuse a batch member whose C1 markers do not exactly cover its\n   projected tree, naming the failed `:rule`: canonical-row production\n   must not silently drop a frontend's coverage claim. The claim is\n   checked root-relatively — admission origins belong to the admitting\n   expander, not to this projection. A member carrying no markers\n   makes no claim and passes; the executed tree's table is finalized\n   after expansion, over the final rows. Answers true when the member\n   claimed coverage (it passed the check), false when it carried no\n   markers — the verdict the batch carries to the expander, which\n   finalizes a side table for a claimed batch only.\"\n  [ast tree]\n  (let [marked (marked-call-sites ast)]\n    (when (seq marked)\n      (doseq [[path value] marked]\n        (when (not= 1 value)\n          (throw (ex-info \"Unsupported call-site marker version\"\n                          {:rule :yang/call-site-unsupported-version,\n                           :path path, :value value}))))\n      (let [eligible (into #{} (map second) (vm/application-occurrences tree))\n            claimed (into #{} (map first) marked)]\n        (when (not= eligible claimed)\n          (throw (ex-info \"Call-site markers do not cover the projected tree\"\n                          {:rule :yang/call-site-incomplete-coverage,\n                           :missing (vec (sort-by pr-str\n                                                  (remove claimed eligible))),\n                           :extra (vec (sort-by pr-str\n                                                (remove eligible claimed)))})))\n        true))))\n\n\n(defn program-batch\n                          (if-let [{:keys [name]} (definition-at index a)]\n                            (dissoc store name)\n                            store))]\n              (reduce walk store (children row))))]\n    (walk store root)))\n\n\n;; =============================================================================\n;; Events (§8)\n;; =============================================================================\n\n(defn- event-row\n  [attempt source-batch origin parent input-root call-path macro-root output-root error]\n  (intern-row [:yin.macro/expand attempt source-batch origin parent input-root\n               call-path macro-root output-root error]))\n\n\n(defn- source-origin\n  [ctx source-batch tree-index]\n  [:source (:source-medium ctx) source-batch tree-index])\n\n\n;; =============================================================================\n;; Expansion (§4)\n;; =============================================================================\n\n(defn- fail\n  [st error]\n  (assoc st :error error))\n\n\n(defn- allocate-attempt\n  [st]\n  (let [counter (get-in st [:ctx :attempt])]\n    [(update-in st [:ctx :attempt] inc) counter]))\n\n(defn- batch-call-site-claim?\n  \"True when `batch`'s frontend claimed call-site (C1) coverage: the\n   claim is the encoder's own verdict over the batch's members — a batch\n   whose members carry no markers claims nothing, and a member whose\n   markers do not exactly cover its tree was refused at the boundary,\n   never delivered here. Only a claimed batch finalizes a side table.\"\n  [batch]\n  (true? (nth batch 5 nil)))\n\n\n(defn- final-call-site-metadata\n  \"The call-site occurrence contract's (C1) side table of an expanded\n   final tree, as frontend-metadata rows `[origin root path\n   :yang/call-site 1]` in printed-row order: one row per\n   `:application` occurrence of the stand-in-lowered, tail-marked tree\n   that actually executes. The frontend's own markers named the\n   pre-expansion tree; expansion, tail marking and stand-in lowering\n   recompute roots and paths, so no pre-expansion table can cover this\n   tree and the table is finalized here, over the finished rows. The\n   origin is the run member's admission origin — the same coordinate\n   the expander's event rows carry for a top-level frame. No\n   expansion-record address is fabricated for the batch as a whole:\n   the batch's attempts are individually recorded in the log, and the\n   final tree is their admitted input's finished form.\"\n  [row-set origin]\n  (vec (sort-by pr-str\n                (map (fn [[root path]] [origin root path :yang/call-site 1])\n                     (vm/application-occurrences row-set)))))\n\n\n(defn expand-batch\n  \"Expand one input batch against `ctx` (§3.2). Returns\n   `{:status :ok :tree packet :log log :ctx ctx'}` or\n   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n   consumed the batch (`:t` + 1) and every attempt it allocated; only\n   success changes the store, to the post-harvest store. A success also\n   carries `:frontend-metadata` — the C1 side table finalized over the\n   final tree (`final-call-site-metadata`), covering the tree that\n   actually executes — when, and only when, the batch's frontend claimed\n   C1 coverage (`batch-call-site-claim?`); an unclaimed batch carries\n   no table at all, never an empty one. A context store binding a\n   reserved name, or holding an entry without the current AST contract,\n   is refused (Rule R): it is a composition defect, so it throws rather\n   than returning an error.\"\n  [batch ctx]\n  (check-store! (:store ctx))\n  (let [ctx (with-default-guards ctx)\n        source-batch (:t ctx)\n        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n        finish (fn [st]\n                 (let [ctx' (update (:ctx st) :t inc)]\n                   (if-let [e (:error st)]\n                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n                     {:status :ok, :tree (:tree st), :log (log-packet st),\n                      :frontend-metadata (:frontend-metadata st),\n                      :ctx (assoc ctx' :store (:next-store st))})))\n        {:keys [admitted error]} (admit batch)]\n    (if error\n      (let [[st counter] (allocate-attempt base)]\n        (finish (-> st\n                    (record-event (event-row (attempt-id ctx counter) source-batch\n                                             (source-origin ctx source-batch nil)\n                                             nil nil nil nil nil error))\n                    (fail error))))\n      (let [{:keys [trees indexes index run-index definitions]} admitted\n            store0 (or (:store ctx) {})\n                                   :source-medium :callsite-test/standard-forms})\n                  [macro/stdlib-forms])\n          ctx (macro/make-ctx {:token \"callsite-test\"\n                               :source-medium :program-in\n                               :store store})\n          first-origin [:source :program-in (:t ctx) 0]\n          consumer (macro/make-expander ctx nil)\n          after-first (macro/load consumer\n                                  (encoder/program-batch\n                                    (yang/compile-program\n                                      '[(defn f [x] (+ x 1)) (f 2)])))\n          first-tree (:out-staged after-first)\n          second-origin [:source :program-in (:t (:ctx after-first)) 0]\n          consumer (macro/load after-first\n                               (encoder/program-batch\n                                 (yang/compile-program\n                                   '[(defmacro unless [c a b] (yin/if c b a))\n                                     (unless false (+ 1 2) 0)])))\n          second-tree (:out-staged consumer)]\n      (is (not= (first first-tree) (first second-tree))\n          \"the two expansions produced different final trees\")\n      (testing \"the first load's table resolves for its tree after the second load\"\n        (let [rows (macro/call-site-table consumer first-tree)]\n          (is (seq rows))\n          (is (= (eligible-under (macro/packet->row-set first-tree)\n                                 first-origin)\n                 (marked rows)))\n          (is (true? (yang/validate-call-site-coverage!\n                       (macro/packet->row-set first-tree) rows\n                       first-origin {:declared? true})))))\n      (testing \"the second load's table resolves for its tree\"\n        (let [rows (macro/call-site-table consumer second-tree)]\n          (is (seq rows))\n          (is (= (eligible-under (macro/packet->row-set second-tree)\n                                 second-origin)\n                 (marked rows)))\n          (is (true? (yang/validate-call-site-coverage!\n                       (macro/packet->row-set second-tree) rows\n                       second-origin {:declared? true}))))))))\n\n\n(deftest unclaimed-batch-test\n  (testing \"a batch whose frontend makes no C1 claim creates no metadata\"\n    (let [ctx (macro/make-ctx {:token :callsite-test/unclaimed\n                               :source-medium :program-in})\n          unmarked {:type :application\n                    :operator {:type :variable :name 'f}\n                    :operands [{:type :literal :value 1}\n                               {:type :literal :value 2}]}\n          {:keys [status frontend-metadata]}\n          (macro/expand-batch (encoder/program-batch unmarked) ctx)\n          consumer (macro/load (macro/make-expander ctx nil)\n                               (encoder/program-batch unmarked))]\n      (is (= :ok status))\n      (is (nil? frontend-metadata)\n          \"no table, never an empty one, for an unclaimed batch\")\n      (is (empty? (:call-site-tables consumer))\n          \"the consumer holds no tables\")\n      (is (nil? (macro/call-site-table consumer (:out-staged consumer)))))))\n\n\n                      (some? (nth origin 1))\n                      (plain-data? (nth origin 1))\n                      (some? (nth origin 2))\n                      (plain-data? (nth origin 2))\n                      (integer? (nth origin 3))\n                      (not (neg? (nth origin 3))))\n         :expansion (and (= 2 (count origin))\n                         (jing/segment-address? (nth origin 1)))\n         false)))\n\n\n(defn source-origin\n  \"Construct and validate the source occurrence coordinate owned by a batch\n   envelope. Throws with `:rule :origin` instead of allowing an incomplete\n   coordinate to enter a provenance or frontend side table.\"\n  [medium batch-token member-index]\n  (let [origin [:source medium batch-token member-index]]\n    (when-not (occurrence-origin? origin)\n      (throw (ex-info \"Malformed source occurrence origin\"\n                      {:rule :origin, :origin origin})))\n    origin))\n\n\n(defn loaded-code-floor\n  \"The lowest entity id claimed by the segments in a `{segment-id image}`\n   code map — each segment id minus its length — or 0 when none is loaded.\n   A loader minting a fresh local segment id allocates below this floor\n   (`semantic/load-ast` for projected AST batches, `semantic/load-vector`\n   for canonical instruction vectors), so successive loads never collide\n   with a live id.\"\n  [code]\n  \"True when map AST `ast` carries the C1 key anywhere. A hit inside a\n   literal payload is data, not a claim: extraction then finds no\n   markers and the module publishes unannotated, as it should.\"\n  [ast]\n  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n\n\n(defn- call-site-claim\n  \"The C1 claim `ast` makes over its canonical `tree`: nil when it\n   carries no markers; `{:origin o :rows [...]}` in printed-row order\n   when the extracted markers exactly cover the tree's eligible\n   application occurrences; `{:missing [...] :extra [...]}` when they\n   do not; `{:unsupported-version v :path p}` when a marker's value is\n   not version 1 — a claim rejection, never a silent acceptance of a\n   table a retriever would read as version 1.\"\n  [ast tree]\n  (when (claims-call-sites? ast)\n    (let [origin (publication-origin (:root tree))\n          extracted (filter #(= :yang/call-site (nth % 3))\n                            (:frontend-metadata\n                              (vm/