{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"which bb java clojure; ls /tmp/cc1-p1/.cpcache 2>/dev/null | head -15; sed -n '1,95p' /tmp/cc1-p1/test/yang/clojure_callsite_test.cljc; sed -n '1,90p' /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc; rg -n 'expand-like-the-repl|defn- output-correspondence|defn- final-call-site-metadata' /tmp/cc1-p1/test/yang/clojure_callsite_test.cljc /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc\"","aggregated_output":"/Users/sto/.local/share/mise/installs/babashka/1.13.225/bb\n/Users/sto/.local/share/mise/installs/java/21.0.2/bin/java\n/Users/sto/.local/share/mise/installs/clojure/1.12.4.1602/bin/clojure\n(ns yang.clojure-callsite-test\n  \"Contract C1 for production yang.clojure (Addendum A, design §2): the\n   `:yang/call-site 1` frontend-metadata annotation of every final\n   `:application` occurrence, and the complete-coverage validation a\n   consumer runs against canonical rows.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yang.clojure :as yang]\n            [yang.clojure.prelude :as clj-prelude]\n            [yang.core.call :as call]\n            [yang.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.linker.closure :as closure]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.macro :as macro]\n            [yin.vm.module :as module]))\n\n\n(def ^:private origin [:source :program \"batch-1\" 0])\n\n\n(defn- project\n  [ast]\n  (let [projected (encoder/project\n                    (encoder/source-envelope :program \"batch-1\" [ast]))]\n    {:tree (first (:yin/batch projected))\n     :metadata (:yin/frontend-metadata projected)}))\n\n\n(defn- eligible-under\n  \"The eligible set of canonical `tree` under `origin`, derived here\n   directly from canonical rows and the occurrence relation,\n   independently of the producer's own helpers.\"\n  [tree origin]\n  (into #{}\n        (comp (filter (fn [[_ _ id]]\n                        (= :application (nth (get (:rows tree) id) 1))))\n              (map (fn [[_ path _]] [origin (:root tree) path])))\n        (vm/occurrences tree)))\n\n\n(defn- eligible\n  [tree]\n  (eligible-under tree origin))\n\n\n(defn- occurrence-pairs\n  \"The `[root-address path]` of every `:application` occurrence of\n   canonical `tree` — the projection a consumer derives from canonical\n   rows alone, origin-free (design §2.2: the origin values of a\n   per-occurrence table are the producer's correspondence claim).\"\n  [tree]\n  (into #{}\n        (comp (filter (fn [[_ _ id]]\n                        (= :application (nth (get (:rows tree) id) 1))))\n              (map (fn [[_ path _]] [(:root tree) path])))\n        (vm/occurrences tree)))\n\n\n(defn- marked-pairs\n  \"The `[root-address path]` projection of a C1 marker relation.\"\n  [metadata]\n  (into #{}\n        (comp (filter #(= :yang/call-site (nth % 3)))\n              (map (fn [[_ r path _ _]] [r path])))\n        metadata))\n\n\n(defn- row-origins\n  \"The distinct occurrence origins a C1 marker relation carries.\"\n  [metadata]\n  (into #{} (map first) (filter #(= :yang/call-site (nth % 3)) metadata)))\n\n\n(defn- expansion-origin?\n  [o]\n  (and (vector? o) (= :expansion (first o))))\n\n\n(defn- marked\n  [metadata]\n  (into #{}\n        (comp (filter #(= :yang/call-site (nth % 3)))\n              (map (fn [[o r path _ _]] [o r path])))\n        metadata))\n\n\n(defn- failure-rule\n  [f]\n  (try (f) ::no-failure\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n(ns yin.vm.macro\n  \"The row-native macro expander (`docs/design/yin.vm.macro.md`, Phase 1).\n\n   A process between two media: it observes `program-in` batches\n   `[:yin.program/batch trees run-index declaration-rows harvest-rows\n   call-site-claims]` — the trailing element present only when some\n   member's frontend claimed call-site (C1) coverage, holding one\n   boolean verdict per member, so every older five-element batch is\n   still a valid unclaimed batch —\n   rewrites the selected tree to a fixpoint, and appends one canonical tree\n   packet `[root rows]` to `program-out`, with one event row per attempt on\n   an optional log medium. Evaluators know nothing of any of this (decision\n   1): a macro call is an ordinary `:application` row, macro-ness is an\n   occurrence declaration beside the tree, and definitions leave as ordinary\n   syntax or as a literal naming the lowered macro.\n\n   Everything here is a value threaded through the step: the macro store,\n   attempt counter, batch coordinate, and incarnation token live in `ctx`\n   (§3.1). Expansion failure is data (decision 12); a throw is a defect or a\n   terminal stream outcome.\"\n  (:refer-clojure :exclude [flush load])\n  (:require [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.observer :as observer]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as ast-walker]\n            [yin.vm.engine :as engine]))\n\n\n;; =============================================================================\n;; Grammar, rows, and packets (§1)\n;; =============================================================================\n\n(def ^:private standin-tag :yin.macro/defined)\n\n\n(def ^:private working-grammar\n  \"The canonical §2.3 table plus the one working row the expander interns\n   and lowers itself: `[S :yin.macro/defined name k]` (§3.2 step 3). It is\n   admitted only in operand and result packets, never in input or output.\"\n  (assoc vm/semantic-bytecode-grammar standin-tag [[:name :sym] [:k :int]]))\n\n\n(defn- grammar\n  [working?]\n  (if working? working-grammar vm/semantic-bytecode-grammar))\n\n\n(defn- row-tag\n  [row]\n  (nth row 1))\n\n\n(defn- intern-row\n  \"The full row for `body`: its content address prepended (§1.1).\"\n  [body]\n  (into [(jing/segment-key body)] body))\n\n\n(defn- slot-kinds\n  \"`[[position kind] ...]` for a tag's grammar slots, positions being full-row\n   positions (address 0, tag 1, first slot 2).\"\n  [tag]\n  (map-indexed (fn [i [_ kind]] [(+ i 2) kind]) (get working-grammar tag)))\n\n\n(defn- child-places\n  \"`[[coordinate child-address] ...]` of one row in grammar order: a `node`\n   slot's coordinate is its full-row position, a `nodes` child's is\n   `[position i]` (§2.1).\"\n  [row]\n  (mapcat (fn [[pos kind]]\n            (case kind\n              :node [[pos (nth row pos)]]\n              :nodes (map-indexed (fn [i c] [[pos i] c]) (nth row pos))\n              nil))\n          (slot-kinds (row-tag row))))\n\n\n(defn- with-child\n  \"`row`'s body with the child at coordinate `coord` replaced by `address`.\"\n  [row coord address]\n  (let [body (subvec row 1)]\n    (if (vector? coord)\n      (let [[pos i] coord]\n        (assoc body (dec pos) (assoc (nth row pos) i address)))\n      (assoc body (dec coord) address))))\n\n\n(defn- reachable\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:301:(defn- expand-like-the-repl\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:326:          {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:384:            {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:411:            {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:435:            {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:486:          {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:1053:          {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/clojure_callsite_test.cljc:1076:          {:keys [ctx result]} (expand-like-the-repl ast)\n/tmp/cc1-p1/test/yang/c