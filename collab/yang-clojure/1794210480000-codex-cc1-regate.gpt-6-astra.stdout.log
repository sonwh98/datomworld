ljc\n@@ -18,7 +18,8 @@\n      (f a ...)         -> :application\n      any other value   -> :literal\"\n   (:require\n-    [yang.tails :as tails]))\n+    [yang.tails :as tails]\n+    [yin.vm :as vm]))\n \n \n (defn lit\n@@ -105,3 +106,46 @@\n   \"`yang.tails/mark-tails`: the lowering marks its tree with the same\n    function a rewriting stage recomputes the marks with.\"\n   tails/mark-tails)\n+\n+\n+;; =============================================================================\n+;; Call-site occurrence contract C1 (Addendum A, design §2)\n+;; =============================================================================\n+;;\n+;; Every final `:application` occurrence of a produced tree carries the\n+;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n+;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n+;; from canonical rows and emits it into the frontend-metadata side table\n+;; as `[origin root-address path :yang/call-site 1]`, where the first\n+;; three coordinates are the site id. The key carries no callee identity,\n+;; source arity, or ambient classification. It is distinct from\n+;; `:yang/site`, the safepoint mark, which travels as node metadata.\n+;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n+;; continuation nodes) are not `:application` nodes and are never marked.\n+;; The walk lives here, beside the other shared tree transforms, so every\n+;; frontend's module trees finalize the same way; `yang.clojure` owns the\n+;; contract's validation over canonical rows.\n+\n+(defn annotate-call-sites\n+  \"The finished map AST `node` with `:yang/call-site 1` on every\n+   `:application` node, at every depth the row grammar knows. Literal\n+   payloads are data, never syntax, and are not walked. Marking is\n+   idempotent and preserves node metadata and every other key, so\n+   canonical rows, roots, and executable outcomes are unchanged.\"\n+  [node]\n+  (let [tag (:type node)\n+        slots (get vm/semantic-bytecode-grammar tag)]\n+    (when-not slots\n+      (throw (ex-info \"Unknown AST node type\" {:type tag, :node node})))\n+    (let [walked (reduce (fn [n [field kind]]\n+                           (case kind\n+                             :node (update n field annotate-call-sites)\n+                             :nodes (update n field\n+                                            (fn [children]\n+                                              (mapv annotate-call-sites\n+                                                    children)))\n+                             n))\n+                         node\n+                         slots)]\n+      (cond-> walked\n+        (= :application tag) (assoc :yang/call-site 1)))))\ndiff --git a/src/cljc/yin/repl/frontends.cljc b/src/cljc/yin/repl/frontends.cljc\nindex 35db43c1..2668cb67 100644\n--- a/src/cljc/yin/repl/frontends.cljc\n+++ b/src/cljc/yin/repl/frontends.cljc\n@@ -39,6 +39,20 @@\n    :yang.frontend/support-profile :segment/legacy})\n \n \n+(defn clojure-manifest\n+  \"The Clojure frontend's manifest. Its coverage promise changed under\n+   the call-site occurrence contract C1 — every final `:application`\n+   occurrence carries `:yang/call-site` in the frontend-metadata side\n+   table, finalized over the post-expansion tree that executes and\n+   retained beside a published module's manifest — and that promise is\n+   a support claim, so the revision and the support profile name it;\n+   the shared legacy profiles no longer describe this frontend.\"\n+  []\n+  (assoc (manifest :yang/clojure :clojure)\n+         :yang.frontend/revision \"c1-1\"\n+         :yang.frontend/support-profile :yang.clojure/c1))\n+\n+\n (defn- clojure-lower\n   [forms]\n   (if (= 1 (count forms))\n@@ -78,7 +92,7 @@\n    returns.\"\n   []\n   (cond-> frontend/empty-catalog\n-    true (frontend/install (manifest :yang/clojure :clojure)\n+    true (frontend/install (clojure-manifest)\n                            {:input :forms,\n                             :parse identity,\n                             :lower clojure-lower})\ndiff --git a/src/cljc/yin/vm.cljc b/src/cljc/yin/vm.cljc\nindex b0d222ca..1bb7ca84 100644\n--- a/src/cljc/yin/vm.cljc\n+++ b/src/cljc/yin/vm.cljc\n@@ -1609,6 +1609,20 @@\n                (into tuples (map (fn [[path id]] [root path id]) frontier)))))))\n \n \n+(defn application-occurrences\n+  \"The `[root path]` of every `:application` occurrence of the projected\n+   row set `tree`: the occurrence relation joined on the row tags, with\n+   no origin — a composition fixes the origin from its own side, as with\n+   `occurrences`. This is the eligible-site derivation of the call-site\n+   occurrence contract: one pair per place, so a shared application row\n+   at two places counts twice.\"\n+  [{:keys [rows] :as tree}]\n+  (into #{}\n+        (comp (filter (fn [[_ _ id]] (= :application (nth (get rows id) 1))))\n+              (map (fn [[root path _]] [root path])))\n+        (occurrences tree)))\n+\n+\n (def occurrence-rules\n   \"§4.5/§7.7: root-scoped occurrence rules, as portable data. A name is\n    bound at `[root path]` iff a `:lambda` occurrence of the same root sits\ndiff --git a/src/cljc/yin/vm/encoder.cljc b/src/cljc/yin/vm/encoder.cljc\nindex 1bda6def..acbbf2f7 100644\n--- a/src/cljc/yin/vm/encoder.cljc\n+++ b/src/cljc/yin/vm/encoder.cljc\n@@ -227,35 +227,122 @@\n                               {:rule :batch-member, :member member}))))\n \n \n+(def ^:private call-site-key\n+  \"The reserved frontend-metadata key of the call-site occurrence\n+   contract C1 (`yang.clojure`), enforced at this boundary but not\n+   owned by it.\"\n+  :yang/call-site)\n+\n+\n+(defn- marked-call-sites\n+  \"The `[path value]` of every node of map AST `ast` carrying the C1\n+   key, walked by the row grammar. Literal payloads are data, never\n+   syntax, and are not walked. Member ASTs are already projected by the\n+   time this runs, so every tag is a grammar tag.\"\n+  [ast]\n+  (letfn [(walk\n+            [node path]\n+            (into (if (contains? node call-site-key)\n+                    [[path (get node call-site-key)]]\n+                    [])\n+                  (mapcat (fn [[j [field kind]]]\n+                            (let [pos (+ j 2)\n+                                  value (get node field)]\n+                              (case kind\n+                                :node (walk value (conj path pos))\n+                                :nodes (mapcat (fn [[i child]]\n+                                                 (walk child\n+                                                       (conj path [pos i])))\n+                                               (map-indexed vector value))\n+                                nil)))\n+                          (map-indexed vector\n+                                       (get vm/semantic-bytecode-grammar\n+                                            (:type node))))))]\n+    (walk ast [])))\n+\n+\n+(defn- check-call-site-claim!\n+  \"Refuse a batch member whose C1 markers do not exactly cover its\n+   projected tree, naming the failed `:rule`: canonical-row production\n+   must not silently drop a frontend's coverage claim. The claim is\n+   checked root-relatively — admission origins belong to the admitting\n+   expander, not to this projection. A member carrying no markers\n+   makes no claim and passes; the executed tree's table is finalized\n+   after expansion, over the final rows. Answers true when the member\n+   claimed coverage (it passed the check), false when it carried no\n+   markers — one verdict per member, so the selected member's own\n+   verdict, never a sibling's, decides whether the expander finalizes\n+   its side table.\"\n+  [ast tree]\n+  (let [marked (marked-call-sites ast)]\n+    (if (seq marked)\n+      (do (doseq [[path value] marked]\n+            (when (not= 1 value)\n+              (throw (ex-info \"Unsupported call-site marker version\"\n+                              {:rule :yang/call-site-unsupported-version,\n+                               :path path, :value value}))))\n+          (let [eligible (into #{} (map second) (vm/application-occurrences tree))\n+                claimed (into #{} (map first) marked)]\n+            (when (not= eligible claimed)\n+              (throw (ex-info \"Call-site markers do not cover the projected tree\"\n+                              {:rule :yang/call-site-incomplete-coverage,\n+                               :missing (vec (sort-by pr-str\n+                                                      (remove claimed eligible))),\n+                               :extra (vec (sort-by pr-str\n+                                                    (remove eligible claimed)))}))))\n+          true)\n+      false)))\n+\n+\n (defn program-batch\n   \"Encode frontend output as the expander's input batch (§2.1):\n-   `[:yin.program/batch trees run-index declaration-rows harvest-rows]`.\n-   Each member — a map AST or a `:yin/*` datom batch — projects to one tree\n-   packet; `run-index` selects the one that becomes the program. Harvest\n-   rows name every `(yin/def <literal-symbol> value)` occurrence in source\n-   declaration order, member by member; declaration rows name those whose\n-   lambda the frontend flagged `:macro?`. No syntax object crosses: every\n-   code field is canonical rows.\"\n+   `[:yin.program/batch trees run-index declaration-rows harvest-rows\n+   call-site-claims]` — the trailing element present only when some\n+   member claimed call-site (C1) coverage, holding one boolean verdict\n+   per member, so every unclaimed batch keeps the five-element shape.\n+   Each member — a map AST or a `:yin/*` datom batch\n+   — projects to one tree packet; `run-index` selects the one that\n+   becomes the program. Harvest rows name every `(yin/def\n+   <literal-symbol> value)` occurrence in source declaration order,\n+   member by member; declaration rows name those whose lambda the\n+   frontend flagged `:macro?`. No syntax object crosses: every code\n+   field is canonical rows. A member whose frontend markers claim\n+   call-site (C1) coverage is checked against its projected tree before\n+   the batch is formed (`check-call-site-claim!`): the markers drop out\n+   of the rows, but never silently — a broken claim refuses the batch,\n+   and the per-member claim verdicts travel with the batch, so the\n+   expander finalizes a member's executed tree's table when, and only\n+   when, that member's own verdict is a claim.\"\n   ([member] (program-batch [member] 0))\n   ([members run-index]\n    (let [asts (mapv member-ast members)\n-         trees (mapv (fn [ast]\n-                       (let [{:keys [root rows]} (vm/ast->semantic-bytecode ast)]\n-                         [root (vec (vals rows))]))\n-                     asts)\n+         row-sets (mapv vm/ast->semantic-bytecode asts)\n+         trees (mapv (fn [{:keys [root rows]}] [root (vec (vals rows))])\n+                     row-sets)\n          occurrences (vec (mapcat (fn [j ast]\n                                     (map #(assoc % :tree j)\n                                          (definition-occurrences ast)))\n-                                  (range) asts))]\n-     [:yin.program/batch\n-      trees\n-      run-index\n-      (into [] (comp (filter :declared?)\n-                     (map (fn [{:keys [tree path]}] [:yin.macro/definition tree path])))\n-            occurrences)\n-      (into [] (map-indexed (fn [h {:keys [tree path]}]\n-                              [:yin.macro/harvest h tree path]))\n-            occurrences)])))\n+                                  (range) asts))\n+         ;; A frontend's C1 claim is enforced here, where its markers\n+         ;; would otherwise drop out of canonical-row production unread.\n+         ;; EVERY member is validated — `mapv` is eager, so a defect in\n+         ;; any member refuses the batch, however valid its siblings —\n+         ;; and the per-member verdicts ride with the batch: each\n+         ;; member's own verdict, never a sibling's, decides whether the\n+         ;; expander finalizes that member's side table.\n+         verdicts (mapv check-call-site-claim! asts row-sets)\n+         claims (when (some true? verdicts) verdicts)]\n+     (cond-> [:yin.program/batch\n+              trees\n+              run-index\n+              (into [] (comp (filter :declared?)\n+                             (map (fn [{:keys [tree path]}]\n+                                    [:yin.macro/definition tree path])))\n+                    occurrences)\n+              (into [] (map-indexed (fn [h {:keys [tree path]}]\n+                                      [:yin.macro/harvest h tree path]))\n+                    occurrences)]\n+       claims (conj claims)))))\n \n \n (defn ready?\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '390,500p' /tmp/cc1-p1/src/cljc/yin/vm/linker/publish.cljc; sed -n '1500,1700p' /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc; sed -n '1280,1352p' /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '390,500p' /tmp/cc1-p1/src/cljc/yin/vm/linker/publish.cljc; sed -n '1500,1700p' /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc; sed -n '1280,1352p' /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc\"","aggregated_output":"   (`:yin.link.publish/admission`) or scope it — a scope object from\n   `admission-scope` under `:yin.link.publish/scope`, whose counter the\n   caller owns; without either, the admission identity is derived from\n   the specification's own durable identity, so re-publishing the same\n   specification is the same recorded admission.\"\n  ([handle spec] (publish-module! handle spec nil))\n  ([handle spec opts] (publish-closure! handle spec opts)))\n\n\n(defn- stored-tree\n  \"The canonical row tree stored under `root` in `handle`, rebuilt\n   from its individually materialized rows (`vm/materialize-tree!`\n   stores each row body under its own address), or nil when a reached\n   row is absent.\"\n  [handle root]\n  (loop [queue [root]\n         rows {}]\n    (if (empty? queue)\n      {:root root, :rows rows}\n      (let [address (first queue)\n            body (jing/get handle address nil)]\n        (if-not (vector? body)\n          nil\n          (let [row (into [address] body)\n                kids (into []\n                           (mapcat (fn [[j [_ kind]]]\n                                     (let [pos (+ j 2)]\n                                       (case kind\n                                         :node [(nth row pos)]\n                                         :nodes (nth row pos)\n                                         nil))))\n                           (map-indexed vector\n                                        (get vm/semantic-bytecode-grammar\n                                             (nth row 1))))]\n            (recur (into (subvec queue 1)\n                         (remove #(contains? rows %) kids))\n                   (assoc rows address row))))))))\n\n\n(defn published-call-site-table\n  \"The C1 side table the module whose manifest is at `address` in\n   `handle` claims: `{:origin o :root r :rows [...] :tree tree}` with\n   the rows exactly as stored and the module's canonical tree, or nil\n   when the module made no C1 claim. The manifest references the table\n   and its reverse record (`:yin.module/call-sites`), so the reference —\n   not a recomputation — is what is resolved here: the rows are fetched\n   from the referenced table address and the ORIGIN is the one the\n   record RECORDED at publication (`:yang.call-site/origin`, held to be\n   a well-formed occurrence origin), beside the record's version, the\n   manifest's own tree, and the referenced table. Nothing reconstructs\n   an origin from content: a replay of this retrieval answers the\n   recorded admission identity, and no other module's admission can be\n   confused with it.\"\n  [handle address]\n  (let [manifest (jing/get handle address nil)\n        call-sites (:yin.module/call-sites manifest)]\n    (when (and (map? manifest) (:yin.module/tree manifest)\n               (map? call-sites) (jing/segment-address? (:table call-sites))\n               (jing/segment-address? (:record call-sites)))\n      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n        (let [stored-rows (jing/get handle (:table call-sites) nil)\n              stored-record (jing/get handle (:record call-sites) nil)\n              origin (:yang.call-site/origin stored-record)]\n          (when (and (vector? stored-rows)\n                     (= {:yang.call-site/version 1\n                         :yang.call-site/root (:yin.module/tree manifest)\n                         :yang.call-site/table (:table call-sites)}\n                        (select-keys stored-record\n                                     [:yang.call-site/version\n                                      :yang.call-site/root\n                                      :yang.call-site/table]))\n                     (vm/occurrence-origin? origin))\n            {:origin origin, :root (:root tree), :rows stored-rows,\n             :tree tree}))))))\n\n\n;; =============================================================================\n;; Deriving a module from indexed code (5.3)\n;; =============================================================================\n\n(defn- indexed-programs\n  \"Every program the index `db` holds -- a relation of `[e a v t m]` index\n   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\n   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\n   whose `m` is the program's metadata entity.\"\n  [db]\n  (let [by-m (group-by #(nth % 4)\n                       (query/collect\n                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\n                                  db)))]\n    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\n          (sort-by (juxt second first)\n                   (query/collect\n                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\n                              db))))))\n\n\n(defn requirements\n  \"The modules `ast` unconditionally requires at module level. Scan literal\n   `(require 'm)` applications outside lambda bodies, except immediately\n   applied lambdas. Conditional branches and try-require remain deferred.\"\n  [ast]\n  (requirements/eager ast))\n\n\n(defn- free-of\n  \"The free names of the map AST `ast` (`yin.vm/free-names`).\"\n  [ast]\n  (let [tree (vm/ast->semantic-bytecode ast)]\n    (vm/free-names (query/relation (vals (:rows tree)))\n                   (query/relation (vm/occurrences tree))\n    (if (:error st)\n      [st (first row)]\n      (let [[index a'] (rebuild-row (:index st) row places children')]\n        [(assoc st :index index) a']))))\n\n\n(defn- expand-node\n  \"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\n   `rel` path within the current `frame` (`{:root r :parent event|nil\n   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\n   and `:origin-of` — the occurrence-provenance function of §2.1, which\n   answers, for an ABSOLUTE occurrence path, the origin of the\n   admission or generation event that produced the syntax there.\n   Every application\n   occurrence is recorded under its absolute path as it is visited, so\n   the finalizer can name each occurrence's real origin; an occurrence\n   replaced by an expansion is re-recorded by the expansion's own walk,\n   and a stale entry for a path the finished tree no longer applies at\n   is simply never read. Returns `[st address']`; a failure sets\n   `(:error st)`.\"\n  [st address {:keys [shadow] :as loc}]\n  (if (:error st)\n    [st address]\n    (let [row (get (:index st) address)\n          tag (row-tag row)]\n      (cond\n        (and (= :application tag) (macro-of st (nth row 2) shadow))\n        (expand-call st address (macro-of st (nth row 2) shadow) loc)\n\n        (= :application tag)\n        (let [st (update-in st [:call-site-origins]\n                            assoc (:path loc) ((:origin-of loc) (:path loc)))\n              op (nth row 2)\n              [st op'] (expand-node st op (-> loc\n                                              (update :path conj 2)\n                                              (update :rel conj 2)))]\n          (if (:error st)\n            [st address]\n            (let [[index app'] (if (= op op')\n                                 [(:index st) address]\n                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\n                  st (assoc st :index index)\n                  row' (get index app')]\n              (if (macro-of st op' shadow)\n                ;; recognition is not expansion: depth is unchanged\n                (expand-node st app' loc)\n                (expand-children st row' (rest (child-places row'))\n                                 (constantly shadow) loc)))))\n\n        :else\n        (let [shadow' (if (= :lambda tag) (into shadow (nth row 2)) shadow)]\n          (expand-children st row (child-places row)\n                           (constantly shadow') loc))))))\n\n\n;; =============================================================================\n;; The batch (§3.1, §3.2)\n;; =============================================================================\n\n(defn- log-packet\n  [st]\n  [:yin.macro/log (:events st) (:produced st)])\n\n\n(defn- with-default-guards\n  [ctx]\n  (update ctx :guards #(merge default-guards %)))\n\n\n(defn- batch-call-site-claims\n  \"The per-member call-site (C1) claim verdicts the encoder recorded on\n   `batch`: nil when no member claimed coverage, otherwise one boolean\n   per member — the encoder validated every member's markers against\n   its own tree at the boundary, so a member whose markers do not\n   exactly cover it was refused there, never delivered here. Each\n   member's own verdict decides its metadata: only a member that\n   claimed coverage finalizes a side table, whatever its siblings\n   claimed.\"\n  [batch]\n  (nth batch 5 nil))\n\n\n(defn- final-call-site-metadata\n  \"The call-site occurrence contract's (C1) side table of an expanded\n   final tree, as frontend-metadata rows `[origin root path\n   :yang/call-site 1]` in printed-row order: one row per\n   `:application` occurrence of the stand-in-lowered, tail-marked tree\n   that actually executes. The frontend's own markers named the\n   pre-expansion tree; expansion, tail marking and stand-in lowering\n   recompute roots and paths, so no pre-expansion table can cover this\n   tree and the table is finalized here, over the finished rows.\n\n   Each row's origin is that occurrence's REAL origin (design §2.1,\n   §2.3): `occurrence-origins` maps the final occurrence path to the\n   origin of the admission or generation event that produced the\n   application syntax at that path — the admitted run member's source\n   origin for retained syntax (a no-op expansion keeps it valid), and\n   the `[:expansion record-address]` of the recorded expansion event\n   whose output introduced generated syntax. No expansion-record\n   address is fabricated: only event rows the expander actually\n   recorded appear. The table is therefore the explicit\n   final-root correspondence §2.3 requires — every generated occurrence\n   names its producing record, so an attribution consumer can reach the\n   event (its input root, call path, macro root, output root) from the\n   row alone.\"\n  [row-set occurrence-origins admission-origin]\n  (vec (sort-by pr-str\n                (map (fn [[root path]]\n                       [(get occurrence-origins path admission-origin)\n                        root path :yang/call-site 1])\n                     (vm/application-occurrences row-set)))))\n\n\n(defn expand-batch\n  \"Expand one input batch against `ctx` (§3.2). Returns\n   `{:status :ok :tree packet :log log :ctx ctx'}` or\n   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n   consumed the batch (`:t` + 1) and every attempt it allocated; only\n   success changes the store, to the post-harvest store. A success also\n   carries `:frontend-metadata` — the C1 side table finalized over the\n   final tree (`final-call-site-metadata`), covering the tree that\n   actually executes — when, and only when, the selected member itself\n   claimed C1 coverage (its own verdict in `batch-call-site-claims`); a\n   sibling's claim never manufactures a table for it, and an unclaimed\n   batch carries no table at all, never an empty one. The admission\n   this expansion produced the tree under rides beside it as\n   `:call-site-origin` — the source origin of the admitted run member,\n   the key the table is stored and resolved under beside the final\n   root address. It is the table's admission key, not a blanket\n   stamp: each row's origin is that occurrence's own (§2.1, §2.3) —\n   a retained occurrence keeps its own incoming provenance (its\n   source origin, or the generating expansion's, however deeply it\n   was passed through), and generated syntax carries the\n   `[:expansion record-address]` of the recorded expansion event\n   whose output introduced it. A context\n   store binding a\n   reserved name, or holding an entry without the current AST contract,\n   is refused (Rule R): it is a composition defect, so it throws rather\n   than returning an error.\"\n  [batch ctx]\n  (check-store! (:store ctx))\n  (let [ctx (with-default-guards ctx)\n        source-batch (:t ctx)\n        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n        finish (fn [st]\n                 (let [ctx' (update (:ctx st) :t inc)]\n                   (if-let [e (:error st)]\n                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n                     {:status :ok, :tree (:tree st), :log (log-packet st),\n                      :frontend-metadata (:frontend-metadata st),\n                      :call-site-origin (:call-site-origin st),\n                      :ctx (assoc ctx' :store (:next-store st))})))\n        {:keys [admitted error]} (admit batch)]\n    (if error\n      (let [[st counter] (allocate-attempt base)]\n        (finish (-> st\n                    (record-event (event-row (attempt-id ctx counter) source-batch\n                                             (source-origin ctx source-batch nil)\n                                             nil nil nil nil nil error nil))\n                    (fail error))))\n      (let [{:keys [trees indexes index run-index definitions]} admitted\n            store0 (or (:store ctx) {})\n            store (harvest store0 #(nth indexes %) definitions)\n            catalogue (into []\n                            (comp (filter :declared?)\n                                  (map (fn [{:keys [name tree path value]}]\n                                         {:name name,\n                                          :macro-tree (packet-of (nth indexes tree) value),\n                                          :source [tree path]})))\n                            definitions)\n            ;; only the run tree is expanded, so only its declarations are\n            ;; replaced; every catalogue entry still resolves by index\n            [index standins]\n            (reduce (fn [[index acc] [k {:keys [name source]}]]\n                      (if (= run-index (first source))\n                        (let [[index s] (intern-body index [standin-tag name k])]\n                          [index (assoc acc (second source) s)])\n                        [index acc]))\n                    [index {}]\n                    (map-indexed vector catalogue))\n            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n            st (assoc base :index index :store store)]\n        (if-let [e (guard-batch-rows st)]\n          (finish (fail st e))\n          (let [[st root'] (expand-node st root\n                                        {:path [], :rel [],\n                                         :frame {:parent nil, :root root,\n                                                 :tree-index run-index},\n                                         :shadow #{}, :depth 0,\n                                         ;; every syntax of the admitted\n                                         ;; run tree starts as source\n                                         ;; (§2.1); expansions override\n                                         ;; below their outputs. The\n                                         ;; function answers by absolute\n                                         ;; occurrence path and ignores it\n                                         ;; here: admitted syntax is all\n                                         ;; source\n                                         :origin-of\n                                         (fn [_]\n                                   