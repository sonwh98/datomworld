(clj/prim-get-default coll k nil))]\n    43\t    [clj/prim-assoc (fn [coll k v] (assoc coll k v))]\n    44\t    [clj/rt-ctx (fn [] clj.rt/ctx)]\n    45\t    [clj/raise\n    46\t     (fn [e] (yrt.effect/raise (clj/rt-ctx) e (fn [v] (:clj/no-handler v))))]\n    47\t    [clj/throw (fn [e] (clj/raise e))]\n    48\t    [clj/try\n    49\t     (fn [body handler] (yrt.effect/try-value (clj/rt-ctx) body handler))]\n    50\t    [clj/try-finally\n    51\t     (fn [body fin] (yrt.effect/try-finally (clj/rt-ctx) body fin nil))]\n    52\t\n    53\t    [clj/admitted-callable?\n    54\t     (fn [x]\n    55\t       (if (data/map? x)\n    56\t         (if (= (get x :type) :cell-ref)\n    57\t           (if (cell/authentic? x)\n    58\t             (if (data/callable? (yang.call/entry x))\n    59\t               (yang.call/eligible? x)\n    60\t               false)\n    61\t             false)\n    62\t           false)\n    63\t         false))]\n    64\t    [clj/dsg__invoke\n    65\t     (fn [callee positional named raise]\n    66\t       (if (clj/admitted-callable? callee)\n    67\t         (yang.call/invoke callee positional named raise)\n    68\t         (yang.call/transfer\n    69\t           raise\n    70\t           (yang.call/condition :yang.call/not-callable\n    71\t             (assoc {} :yang.call/callee callee)))))]\n    72\t    [clj/dsg__run-body\n    73\t     (fn [meta body invocation raise]\n    74\t       (let [ctx (clj/rt-ctx)\n    75\t             run (fn [tail-invoke]\n    76\t                   (let [named (get invocation :yang.call/named)]\n    77\t                     (if (= (data/count named) 0)\n    78\t                       (body (get invocation :yang.call/positional) tail-invoke)\n    79\t                       (clj/throw\n    80\t                         (assoc {} :yin.k/message\n    81\t                                   \"Clojure functions do not accept named arguments\"\n    82\t                                   :yin.k/data (assoc {} :yang.call/named