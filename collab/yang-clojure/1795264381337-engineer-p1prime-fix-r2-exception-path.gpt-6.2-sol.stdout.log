              (yang.call/condition :yang.call/unsupported-binding\n   118\t                             (assoc {} :yang.call/callee owner\n   119\t                                       :yang.call/binding-profile\n   120\t                                       (get invocation :yang.call/binding-profile))))\n   121\t                         (clj/dsg__run-body meta body invocation raise))\n   122\t                       (yang.call/transfer\n   123\t                         raise\n   124\t                         (yang.call/condition :yang.call/invalid-invocation\n   125\t                           (assoc {} :yang.call/callee (get invocation :yang.call/callee)\n   126\t                                     :yang.call/owner owner))))\n   127\t                     (:clj/missing-raise-exit invocation)))\n   128\t                 (:clj/invalid-invocation invocation)))]\n   129\t         (do (cell/set! owner (assoc meta :yang.call/entry entry))\n   130\t             owner)))]\n   131\t    [clj/invoke-callable\n   132\t     (fn [callee positional named]\n   133\t       (clj/dsg__invoke callee positional named\n   134\t         (fn [condition]\n   135\t           (clj/raise\n   136\t             (if (= (get condition :yang.call/reason) :yang.call/thrown)\n   137\t               (get condition :yang.call/value)\n   138\t               (cell/dsg__new-provenance condition condition))))))]\n   139\t    ;; A caught carrier stays intact for storing or rethrowing. Source\n   140\t    ;; readers observe its value, and the program boundary reports the\n   141\t    ;; retained condition even if the carrier's public value changed.\n   142\t    [clj/condition-view\n   143\t     (fn [x]\n   144\t       (if (= (cell/dsg__provenance x) nil)\n   145\t         (if (if (data/map? x) (= (get x :type) :cell-ref) false)\n   146\t           (if (cell/authentic? x)\n   147\t             (let [descriptor (cell/get x)]\n   148\t               (if (= (get descriptor :clj/type) :function) descriptor x))\n   149\t             x)\n   150\t           x)\n   151\t         (cell/get x)))]\n   152\t    [clj/run-unit\n   153\t     (fn [body]\n   154\t       (clj/try (fn [] (conj [] :yin.k/ok (body)))\n   155\t                (fn [e]\n   156\t                  (let [retained (cell/dsg__provenance e)]\n   157\t                    (conj [] :yin.k/error (if (= retained nil) e retained))))))]\n   158\t    [clj/unwrap-outcome\n   159\t     (fn [value]\n   160\t       (if (if (data/vector? value) (= (data/count value) 2) false)\n   161\t         (if (= (data/nth value 0) :yin.k/ok)\n   162\t           (data/nth value 1)\n   163\t           value)\n   164\t         value))]\n   165\t    [clj/run-main\n   166\t     (fn [body]\n   167\t       (do (clj/init!)\n   168\t           (clj/unwrap-outcome (body))))]])\n   169\t\n   170\t\n   171\t(def bundled-primitive-forms\n   172\t  \"Guest closures can capture each other without capturing a host function.\"\n   173\t  '[(fn [coll k default]\n   174\t      (if (data/vector? coll)\n   175\t        (if (data/contains? coll k) (data/nth coll k) default)\n   176\t        (dsg__primitive/get coll k default)))\n   177\t    (fn [a b] (data/content= a b))\n   178\t    (fn [coll k v k2 v2 k3 v3 k4 v4]\n   179\t      (if (data/content= k2 nil)\n   180\t        (dsg__primitive/assoc coll k v)\n   181\t        (if (data/content= k3 nil)\n   182\t          (dsg__primitive/assoc coll k v k2 v2)\n   183\t          (if (data/content= k4 nil)\n   184\t            (dsg__primitive/assoc coll k v k2 v2 k3 v3)\n   185\t            (dsg__primitive/assoc coll k v k2 v2 k3 v3 k4 v4)))))\n   186\t    (fn [a b] (dsg__primitive/+ a b))\n   187\t    (fn [a b] (dsg__primitive/<= a b))])\n   188\t\n   189\t\n   190\t(def module-exports\n   191\t  (disj (core/exports \"clj\" definitions) 'dsg__invoke 'dsg__run-body))\n   192\t\n   193\t\n   194\t(def uast\n   195\t  \"Install clj from a closed, content-addressed bundle.\"\n   196\t  (let [placeholders (mapv (fn [key] [key :clj/uninit]) runtime-keys)\n   197\t        install (apply u/app\n   198\t                       (u/lam '[get = assoc + <=]\n   199\t                              (core/definitions->uast (into placeholders definitions)))\n   200\t                       (map u/sexp->uast bundled-primitive-forms))]\n   201\t    (u/mark-tails\n   202\t      (u/app (u/lam [] (u/then (u/lit :clj/bundled-runtime) install))))))\n   203\t\n   204\t\n   205\t(def bundled-uast\n   206\t  \"Install the shared definitions before initializing bundled clj.\"\n   207\t  (let [shared (u/app (u/lam '[get = assoc + <=] (u/seq-nodes [call/uast effect/uast]))\n   208\t                      (u/v 'dsg__get) (u/v 'dsg__equal) (u/v 'dsg__assoc)\n   209\t                      (u/v 'dsg__add) (u/v 'dsg__lte))]\n   210\t    (apply u/app\n   211\t           (u/lam '[dsg__get dsg__equal dsg__assoc dsg__add dsg__lte]\n   212\t                  (u/seq-nodes [shared uast (u/app (u/v 'clj/init!))]))\n   213\t           (map u/sexp->uast bundled-primitive-forms))))\n   214\t\n   215\t\n   216\t(def bundled-names\n   217\t  \"Bundled runtime store definitions accepted by admission scans.\"\n   218\t  (into (set runtime-keys) (map first) (concat definitions effect/definitions)))\n   219\t\n   220\t\n   221\t(def module-definitions\n   222\t  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n   223\t\n   224\t\n   225\t(def module-uast\n   226\t  (u/annotate-call-sites\n   227\t    (core/module-tree module-definitions\n   228\t                      (mapv u/sexp->uast '[(require 'yang.call) (require 'yrt.effect)]))))\n   229\t\n   230\t\n   231\t(def ^:private module-free-names (core/free-name-vec module-uast))\n   232\t\n   233\t\n   234\t(defn module-spec\n   235\t  \"Emit the clj module pinned to the installed calling and effect runtimes.\"\n   236\t  [registry call-address effect-address]\n   237\t  (let [requires {call/module-name call-address, effect/module-name effect-address}]\n   238\t    (prelude-admission/module-spec\n   239\t      {:module-name module-name\n   240\t       :ast module-uast\n   241\t       :exports module-exports\n   242\t       :requires requires\n   243\t       :free-names module-free-names\n   244\t       :skip? #(contains? requires (some-> % namespace symbol))\n   245\t       :registry registry\n   246\t       :message \"the clj module reads an undeclared name\"\n   247\t       :refusal-ns \"yang.clojure\"})))\n   248\t\n   249\t\n   250\t(defn outcome-adapter\n   251\t  \"Wrap host function `f`, a primitive declaring domain failures, as an\n   252\t   outcome-returning one: success is [:yin.k/ok value], and the module's own\n   253\t   refusal (ex-info with message `refusal-message` and :yin.vm.data/op and\n   254\t   :yin.vm.data/reason in its data) is [:yin.k/error data] with those keys.\n   255\t   Any other host exception propagates: an unexpected VM or compiler failure\n   256\t   is never a successful rejection.\"\n   257\t  [refusal-message f]\n   258\t  (fn [& args]\n   259\t    (try\n   260\t      [:yin.k/ok (apply f args)]\n   261\t      (catch #?(:clj Throwable, :cljs :default, :cljd Object) e\n   262\t        (let [data (ex-data e)]\n   263\t          (if (and (= refusal-message (ex-message e))\n   264\t                   (contains? data :yin.vm.data/op)\n   265\t                   (contains? data :yin.vm.data/reason))\n   266\t            [:yin.k/error data]\n   267\t            (throw e)))))))\n   268\t\n   269\t\n   270\t(def library-adapters\n   271\t  \"The retired `:adapters` map a program using `library` once compiled with:\n   272\t   the data exports whose refusal the collection predicates read as data.\n   273\t   The continuation port rewrote those predicates onto the `data/*` and\n   274\t   `kind/*` host predicates, so no `portable/*` adapter is consulted; the\n   275\t   map stays for the `library-opts`/`unit-opts` fixtures and the prelude's\n   276\t   `admit` registration.\"\n   277\t  {'data/count 'portable/count\n   278\t   'data/peek 'portable/peek\n   279\t   'data/dissoc 'portable/dissoc\n   280\t   'data/disj 'portable/disj\n   281\t   'data/str-length 'portable/str-length})\n   282\t\n   283\t\n   284\t(def kind-module\n   285\t  \"The `kind` host module's exports, symbol to host function: the irreducible\n   286\t   kind and name primitives (see the library notes). Every export is pure.\"\n   287\t  (merge\n   288\t    {'symbol? symbol?\n   289\t     'keyword? keyword?\n   290\t     'name name\n   291\t     'namespace namespace\n   292\t     'symbol symbol\n   293\t     'keyword keyword\n   294\t     'str str\n   295\t     'int? int?\n   296\t     'with-meta with-meta\n   297\t     'meta meta\n   298\t     'coll? coll?\n   299\t     'set? set?}\n   300\t    #?(:clj {'var? var?} :default {})))\n   301\t\n   302\t\n   303\t(def kind-arities\n   304\t  \"The published arities of each `kind` export.\"\n   305\t  {'symbol? [1], 'keyword? [1], 'name [1], 'namespace [1], 'symbol [1 2], 'keyword [1 2]\n   306\t   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'var? [1], 'with-meta [2], 'meta [1]\n   307\t   'coll? [1], 'set? [1]})\n   308\t\n   309\t\n   310\t(defn register-library-module\n","exit_code":0,"status":"completed"}}
