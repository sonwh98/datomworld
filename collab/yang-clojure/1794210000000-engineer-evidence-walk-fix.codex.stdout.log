{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1970,2020p' test/yang/clojure_test.clj && sed -n '1,65p' test/yang/latte_oracle_test.clj\"","aggregated_output":"  [ast modules lane step-limit]\n  (vm/value (run-guest-machine ast modules lane step-limit)))\n\n\n(defn- run-library\n  \"The raw outcome of the last of `forms`, compiled with the library\n   definitions the program needs.\"\n  ([forms] (run-library forms library-opts))\n  ([forms opts]\n   (let [walker (run-library forms opts :walker 1000000)\n         semantic (run-library forms opts :semantic 1000000)]\n     (is (= walker semantic) (str \"library lanes agree: \" (pr-str forms)))\n     walker))\n  ([forms opts lane step-limit]\n   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\n                  library-modules lane step-limit)))\n\n\n(defn- lib\n  \"The value of the single expression `form`, or the raw error outcome.\"\n  [form]\n  (let [[tag payload] (run-library [form])]\n    (if (= :yin.k/ok tag) payload [tag payload])))\n\n\n(deftest test-library-closes-over-its-own-names\n  (testing \"library-for returns the definitions a program mentions, transitively\"\n    (let [names (set (map second (yang/library-for '[(seq? x)])))]\n      (is (every? names '[seq? sequential? vector? map? set? coll?])\n          \"seq? pulls sequential?, vector?, map?, set? and coll?\")\n      (is (not (contains? names 'map))))\n    (is (= [] (yang/library-for '[(+ 1 2)])))\n    (is (= [] (yang/library-for '[(quote (map f xs))])) \"quoted data mentions nothing\")\n    (is (= [] (yang/library-for '[(defn map\n                                    [f c]\n                                    c) (map 1 2)]))\n        \"a program definition shadows the library's\")))\n\n\n(deftest test-library-kind-predicates\n  (testing \"collection predicates are derived from the data module's refusals\"\n    (is (= [true false false false false false]\n           (lib '[(vector? [1]) (vector? '(1)) (vector? {}) (vector? #{}) (vector? 1) (vector? nil)])))\n    (is (= [true false false false false]\n           (lib '[(map? {}) (map? [1]) (map? #{}) (map? nil) (map? \"s\")])))\n    (is (= [true false false]\n           (lib '[(set? #{1}) (set? [1]) (set? nil)])))\n    (is (= [true true true true false false false]\n           (lib '[(coll? []) (coll? '()) (coll? {}) (coll? #{}) (coll? nil) (coll? 1) (coll? \"s\")])))\n    (is (= [true false false false false]\n           (lib '[(seq? '(1 2)) (seq? []) (seq? {}) (seq? nil) (seq? 1)])))\n(ns yang.latte-oracle-test\n  \"Pinned upstream LaTTe differential harness, slices 1-9 of the Yang gap\n   program. A executes the original library on Clojure. B executes explicit\n   portability source on Clojure; C compiles it through Yang for the walker\n   and semantic VMs. Slice 9 fails closed on the full kernel corpus. The\n   legacy classifier records historical blockers;\n   the context module additionally checks free-symbol admission before C.\n   Adaptations, operation sequences and scope departures live beside the\n   manifest in yang/latte_oracle/.\"\n  (:require [clojure.java.io :as io]\n            [clojure.edn :as edn]\n            [clojure.test :refer [deftest is testing]]\n            [clojure.string :as str]\n            [clojure.walk :as walk]\n            [dao.jing.cbor :as cbor]\n            [clojure.tools.reader :as r]\n            [clojure.tools.reader.reader-types :as rt]\n            [yang.clojure :as yang]\n            [yang.clojure-test :as compiler-test]\n            [yang.core.call :as call]\n            [yin.vm :as vm]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.data :as data]\n            [yin.vm.module :as module]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-support :as rows-support]\n            [yin.vm.values :as values]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.ucf :as ucf]))\n\n\n(def ^:private manifest\n  (edn/read-string (slurp (io/resource \"yang/latte_oracle/manifest.edn\"))))\n\n\n(defn- ns-declaration-aliases\n  \"Alias -> full ns symbol, taken from the file's own (ns ...) declaration —\n   never invented: ::alias/kw must read as :that.real.ns/kw.\"\n  [ns-form]\n  (let [alias-map (atom {})\n        consume-spec (fn [spec]\n                       (when (sequential? spec)\n                         (let [lib (first spec)]\n                           (loop [xs (rest spec)]\n                             (when (seq xs)\n                               (if (= :as (first xs))\n                                 (do (swap! alias-map assoc (second xs) lib)\n                                     (recur (drop 2 xs)))\n                                 (recur (next xs))))))))]\n    (loop [clauses (rest (rest ns-form))]\n      (when (seq clauses)\n        (let [clause (first clauses)]\n          (if (and (seq? clause) (= :require (first clause)))\n            (do (loop [reqs (next clause)]\n                  (let [spec (first reqs)]\n                    (when (and (not (nil? spec)) (not (keyword? spec)))\n                      (consume-spec spec)\n                      (recur (next reqs)))))\n                (recur (next clauses)))\n            (recur (next clauses))))))\n    @alias-map))\n\n\n","exit_code":0,"status":"completed"}}
