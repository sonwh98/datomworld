racesDepth = 0;\\n\"\n      \"    private int bracesDepth = 0;\\n\\n    /**\\n     * Brace depth of each enclosing interpolation, saved by\\n     * StartTemplateString and restored by EndTemplateString, so a template\\n     * nested inside an interpolated object literal does not lose the\\n     * enclosing object's open brace.\\n     */\\n    private final Deque<Integer> bracesDepthStack = new ArrayDeque<>();\\n\"]\n     [\"    public void StartTemplateString() {\\n        this.bracesDepth = 0;\\n    }\\n\"\n      \"    public void StartTemplateString() {\\n        this.bracesDepthStack.push(this.bracesDepth);\\n        this.bracesDepth = 0;\\n    }\\n\\n    public void EndTemplateString() {\\n        this.bracesDepth = this.bracesDepthStack.isEmpty() ? 0 : this.bracesDepthStack.pop();\\n    }\\n\"]],\n    \"TypeScriptParser.g4\"\n    [\n     [\"    | singleExpression ('<' | '>' | '<=' | '>=') singleExpression     # RelationalExpression\\n\"\n      \"    | singleExpression ({!this.genericCallAhead()}? '<' | '>' | '<=' | '>=') singleExpression # RelationalExpression\\n\"]\n     [\"    | objectType                                 # ObjectPrimType\\n\"\n      \"    | mappedType                                 # MappedPrimType\\n    | objectType                                 # ObjectPrimType\\n\"]\n     [\"statement\\n    : block\\n\"\n      \"statement\\n    : typeAliasDeclaration\\n    | block\\n\"]\n     [\"    | typeAliasDeclaration //ADDED\\n\"\n      \"\"]\n     [\"sourceElement\\n    : Export? statement\\n\"\n      \"sourceElement\\n    : statement\\n\"]\n     [\"    | accessibilityModifier? varModifier? ReadOnly? variableDeclarationList SemiColon?\\n\"\n      \"    | (accessibilityModifier varModifier? ReadOnly? | varModifier ReadOnly? | ReadOnly) variableDeclarationList SemiColon?\\n\"]\n     [\"    : Abstract (identifier callSignature | variableStatement) eos\\n\"\n      \"    : Abstract (identifier callSignature | variableStatement | variableDeclarationList