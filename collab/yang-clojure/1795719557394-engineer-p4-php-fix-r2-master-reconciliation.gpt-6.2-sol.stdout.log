    |     3 +-\n .../typescript/antlr/descriptor_profile_test.cljc  |   266 +\n test/yin/repl/main_test.cljc                       |     3 +-\n 142 files changed, 73527 insertions(+), 569 deletions(-)\n  (loop [state (repl/boot {})\n         lines lines\n         out []]\n    (if-let [line (first lines)]\n      (let [_ (driver/submit-line! (:input state) line)\n            [state' printed] (loop [state state\n                                    n 0]\n                               (let [[state' _ printed] (repl/step-all state\n                                                                       nil\n                                                                       n)]\n                                 (if (or (seq printed) (= n 50))\n                                   [state' printed]\n                                   (recur state' (inc n)))))]\n        (recur state' (rest lines) (conj out [line (vec printed)])))\n      out)))\n\n\n;; Dart gate (2026-11-08): :yang/php is not installed on Dart (the\n;; standard catalog there holds :clojure :python only), so the exact\n;; installed list and the php switch/eval assertions are host-variable.\n;; The refusal shape (it happens, names the installed set, session keeps\n;; its frontend) is asserted generically on every host; only the php\n;; catalog content is gated.\n(deftest the-interactive-composition-holds-every-standard-language\n  (let [t (transcript [\"(host)\"\n                       \"(lang :yang/python)\"\n                       \"1 + 2\"\n                       \"[x * x for x in [0, 1, 2, 3]]\"\n                       \"'a' + 'b'\"\n                       \"(lang :python)\"\n                       \"1 + 2\"\n                       \"(lang :yang/php)\"\n                       \"<?php echo 1 + 2;\"\n                       \"(lang :yang/clojure)\"\n                       \"1 + 2\"\n                       \"(+ 1 2)\"])]\n    (is (str/starts-with? (first (get-in t [0 1])) \"Host: \"))\n    (is (= \"Switched to :yang/python\" (first (get-in t [1 1]))))\n    (is (= [\"3\"] (get-in t [2 1])))\n    (is (= [\"[0 1 4 9]\"] (get-in t [3 1])))\n    (is (= [\"\\\"ab\\\"\"] (get-in t [4 1])))\n    (testing \"a language keyword is not a selector: the refusal names what\n              is installed, and the session keeps its frontend\"\n      (let [refusal (first (get-in t [5 1]))]\n        (is (str/starts-with? refusal\n                              (str \"Error: unavailable-parser: Yin REPL language :python\"\n                                   \" is not in the frontend catalog; installed:\"))\n            refusal)\n        (is (str/includes? refusal \":clojure\") refusal)\n        (is (str/includes? refusal \":python\") refusal)\n        (is (str/includes? refusal \":yang/clojure\") refusal)\n        (is (str/includes? refusal \":yang/python\") refusal))\n      #?(:cljd nil\n         :default\n         (is (= [(str \"Error: unavailable-parser: Yin REPL language :python\"\n                      \" is not in the frontend catalog; installed: :clojure :php\"\n                      \" :python :typescript (ids :yang/clojure :yang/php :yang/python\"\n                      \" :yang/typescript)\")]\n                (get-in t [5 1]))))\n      (is (= [\"3\"] (get-in t [6 1]))))\n    #?(:cljd\n       (testing \"php is not installed on Dart: selection refuses, keeps python\"\n         (let [refusal (first (get-in t [7 1]))]\n           (is (str/includes? refusal \"unavailable-parser\") refusal)\n           (is (str/includes? refusal \"installed:\") refusal))\n         (is (not= [\"3\"] (get-in t [8 1]))\n             \"the php source is not evaluated as php without the frontend\"))\n       :default\n       (do\n         (is (= \"Switched to :yang/php\" (first (get-in t [7 1]))))\n         (is (= [\"3\"] (get-in t [8 1])))))\n    (is (= \"Switched to :yang/clojure\" (first (get-in t [9 1]))))\n    (testing \"Clojure reads `1 + 2` as three forms; the last value prints\"\n      (is (= [\"2\"] (get-in t [10 1]))))\n    (is (= [\"3\"] (get-in t [11 1])))))\n\n\n;; =============================================================================\n;; L4: the publisher's key file (docs/design/yin.vm.linker.dht.md 6.5)\n;; =============================================================================\n\n(defn- write-text!\n  [path text]\n  #?(:cljd (let [f (dart-io/File. path)]\n             (when-not (.existsSync (.-parent f))\n               (.createSync (.-parent f) .recursive true))\n             (.writeAsStringSync f text))\n     :clj (do (.mkdirs (.getParentFile (java.io.File. path)))\n              (spit path text))\n     :cljs (let [fs (js/require \"fs\")\n                 path-module (js/require \"path\")]\n             (.mkdirSync fs (.dirname path-module path) #js {:recursive true})\n             (.writeFileSync fs path text))))\n\n\n(defn- read-text\n  [path]\n  #?(:cljd (.readAsStringSync (dart-io/File. path))\n     :clj (slurp path)\n     :cljs (.readFileSync (js/require \"fs\") path \"utf8\")))\n\n\n(defn- key-start\n(ns yin.repl.main-test\n  (:require [clojure.string :as str]\n            [clojure.test :refer [deftest is testing]]\n            [dao.test-slow :as slow]\n            #?@(:cljd [[\"dart:io\" :as dart-io]]\n                :clj [[clojure.java.io :as io]\n                      [yin.repl.host :as host]]\n                :cljs [[yin.repl.connect :as connect]])\n            [dao.stream :as stream]\n            [dao.stream.journal.file :as file-journal]\n            [dao.stream.rpc :as rpc]\n            #?@(:cljs [[dao.stream.waitset.driver :as waitset]]\n                :cljd [[dao.stream.waitset.driver :as waitset]])\n            #?@(:cljd [[dao.stream.transit :as transit]]\n                :jolt []\n                :default [[dao.stream.transit :as transit]])\n            [yin.repl.main :as repl]\n            [yin.shell.cli :as cli]\n            [yin.shell.dht :as repl.dht]\n            [yin.shell.main :as shell.main]\n            [yin.repl :as shell]\n            [yin.repl.frontends :as repl.frontends]\n            [yin.repl.driver :as driver]\n            [yin.repl.host.common :as host-common]\n            [yin.repl.net-fixture :as fixture]\n            [yin.repl.serve :as serve]\n            [yin.vm.linker.sign :as sign]\n            [yin.vm.ucf.compose :as compose]\n            [yin.vm.ucf.compose-test :as compose-test]))\n\n\n;; =============================================================================\n;; Host scratch paths for the startup-contract tests below.\n;; =============================================================================\n\n(defn- temp-dir\n  []\n  (str \"target/test-main-index-\" (random-uuid)))\n\n\n(defn- temp-file\n  []\n","exit_code":0,"status":"completed"}}
