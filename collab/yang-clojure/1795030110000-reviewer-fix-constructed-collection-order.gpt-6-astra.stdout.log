{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '900,945p' test/yang/clojure_collection_order_test.cljc && git diff -- test/resources/yang/clojure/cc4-replay-snapshots.edn && cat collab/yang-clojure/1795028800000-fixorder-evidence/fixorder-node-callsite.log && cat collab/yang-clojure/1795028800000-fixorder-evidence/fixorder-node-order.log && rg -n 'antlr|gen:antlr|java|test' deps.edn bb.edn docs/agents/build-n-test.md | head -65\"","aggregated_output":"              (quote [(defmacro twin\n                        [x]\n                        (yin/if (yin/literal true) x\n                                (yin/application (yin/variable (quote f))\n                                                 [(yin/literal 1)])))\n                      (defn holder\n                        [x]\n                        {:kept (first (list x))})\n                      (twin (holder 1))]))\n        {:keys [ctx result]} (expand-like-the-repl ast)\n        {:keys [status tree frontend-metadata log]} result\n        admission [:source :program-in (:t ctx) 0]\n        event-addrs (into #{} (map first) (nth log 1))\n        origins (into #{}\n                      (comp (filter (fn [row] (= :yang/call-site (nth row 3))))\n                            (map first))\n                      frontend-metadata)\n        input-tree (vm/ast->semantic-bytecode ast)\n        final (macro/packet->row-set tree)]\n    (is (= :ok status))\n    (is (not= (:root input-tree) (:root final))\n        \"the twin call really expanded\")\n    (is (seq frontend-metadata))\n    (is (every? (fn [o]\n                  (or (= o admission)\n                      (and (vector? o) (= :expansion (first o))\n                           (contains? event-addrs (second o)))))\n                origins)\n        \"every origin is the admission or names a recorded expansion event\")\n    (is (pos? (count (map-operand-roots ast)))\n        \"the program carries a constructed map through expansion\")))\n\n\n;; =============================================================================\n;; RULING 3 test 7: legacy loading and identity boundaries\n;; =============================================================================\n\n(def ^:private legacy-c1-1-payload-b64\n  \"The retained pre-fix (manifest c1-1) artifact, recorded on the JVM at\n   dispatch revision 2687ab0c before this round: the complete canonical row\n   set of the program ((fn [x] {(- x 1) :a (- 1 x) :b}) 1), its root, its\n   executed value, and its pre-fix operand vector. The binary original is\n   test/resources/yang/clojure/constructed-collections-legacy-c1-1.cbor;\n   the base64 form is the portable copy every host decodes.\"\n  (apply str\n   [\"ptgbgnBkYW8uamluZy9rZXl3b3JkgvZkcm9vdNgbgnBkYW8uamluZy9rZXl3b3JkgmdzZWdtZW50eEdibGFrZTMtNDlkOWVmMzE5\"\ndiff --git a/test/resources/yang/clojure/cc4-replay-snapshots.edn b/test/resources/yang/clojure/cc4-replay-snapshots.edn\nindex 1e4d1424..f2a5cf15 100644\n--- a/test/resources/yang/clojure/cc4-replay-snapshots.edn\n+++ b/test/resources/yang/clojure/cc4-replay-snapshots.edn\n@@ -1,3 +1,10 @@\n+;; The post-fix reference bundle (manifest c1-2, constructed-collections-v1\n+;; re-pin per ruling 1795017757000): re-recorded on the JVM for all eight\n+;; members after the constructed-collection operand-ordering fix; only the\n+;; argument-vector and lower-unit members changed bytes. The pre-fix bundle\n+;; is retained verbatim as cc4-replay-snapshots-prefix-c1-1.edn, and the r2\n+;; defect evidence (cc4-replay-dart-divergences.edn, cc4-replay-jvm*.*) stays\n+;; immutable.\n [{:id :native,\n   :root\n   :segment/blake3-0aac99defd315ce7623ecefc08106f31653bd138fb5ae3f1f1d466bd93893c70,\n@@ -10,24 +17,24 @@\n   \"1556afb1db35c20b88bbc254b112fcb09874e95b3c9bcd8d412fbd3e4d01f005\"}\n  {:id :argument-vector,\n   :root\n-  :segment/blake3-a0f9c217122ce675d1b3cd5f899740d604ec35f801eac9a4960153cbcd91d699,\n+  :segment/blake3-4a9a1b91e8a