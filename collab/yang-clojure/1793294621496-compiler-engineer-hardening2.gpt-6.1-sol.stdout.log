))\n    (defn with-meta [x m]\n      (kind/with-meta x m))''')\n# portable try : return raw outcome from body, catch receives its data payload\ns=s.replace(\\\"#{'if 'let 'do 'loop 'recur 'throw 'quote 'fn 'and 'or}\\\", \\\"#{'if 'let 'do 'loop 'recur 'throw 'try 'quote 'fn 'and 'or}\\\")\ns=s.replace(\\\"          (= 'throw head) true\\\", \\\"          (= 'throw head) true\\\\n          (= 'try head) true\\\")\ns=s.replace(\\\"          throw (lower-operand env (first ops) (fn [v] [error-tag v]))\\\", '''          throw (lower-operand env (first ops) (fn [v] [error-tag v]))\n          try (let [clauses (filter #(and (seq? %) (#{'catch 'finally} (first %))) ops)\n                    body (take-while #(not (and (seq? %) (#{'catch 'finally} (first %)))) ops)\n                    [clause] clauses\n                    [_ klass binding & handler] clause\n                    outcome (gen-sym env)]\n                (when-not (and (= 1 (count clauses)) (= 'catch (first clause))\n                               (#{'Exception 'java.lang.Exception\n                                  'clojure.lang.ExceptionInfo} klass)\n                               (symbol? binding))\n                  (reject\"'! \"Portable try requires one Exception/ExceptionInfo catch and no finally\"\n                           {:form form :clauses clauses}))\n                (list '\"'dsg__let [outcome (lower-tail env (body-expression body))]\n                      (list 'if (list 'data/content= (list 'data/nth outcome 0) error-tag)\n                            (list 'dsg__let [binding (list 'data/nth outcome 1)]\n                                  (lower-tail (with-locals env [binding]) (body-expression handler)))\n                            outcome)))''')\ns=s.replace(\\\"      (= 'ex-info (first form))\\\", \\\"\\\"\\\"      (#{'.getMessage 'ex-message 'ex-data} (first form))\n      (do (when-not (= 2 (count form))\n            (reject\"'! \"Error accessor requires one portable error value\" {:form form}))\n          (list (if (= '\"'ex-data (first form)) :yin.k/data :yin.k/message)\n                (rewrite-ex-info (second form))))\n      (and (symbol? (first form)) (str/starts-with? (name (first form)) \\\".\\\"))\n      (reject\"'! \"Host exception/interop accessor is not portable\" {:form form})\n      (= '\"'ex-info (first form))\\\"\\\"\\\")\n# namespace alias check\nopen(p,'w').write(s)\nPY\nhead -48 src/cljc/yang/clojure.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
