{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '640,940p' src/cljc/yang/clojure.cljc; cat test/yang/latte_oracle/context.edn; sed -n '900,937p' test/yang/latte_oracle_test.clj; sed -n '1680,1718p' test/yang/clojure_test.clj; rg -n 'meta|str\\\\?' src/cljc/yin/vm/data.cljc; rg -n 'free-vars|unfold-implicit|opacity-fn|nanoTime|pprint|getMessage' /tmp/latte-kernel/src/latte_kernel/*.cljc\"","aggregated_output":"  (some? (::outcomes env)))\n\n\n(defn- adapters\n  [env]\n  (:adapters (::outcomes env)))\n\n\n(defn- binder-symbols\n  [b]\n  (into #{} (comp (filter symbol?) (remove #{'&})) (tree-seq coll? seq b)))\n\n\n(defn- ok-form\n  [v]\n  [ok-tag v])\n\n\n(defn- rebuild\n  \"A list of `items` carrying the reader metadata of `form`.\"\n  [form items]\n  (let [out (apply list items)]\n    (if-let [m (meta form)]\n      (with-meta out m)\n      out)))\n\n\n(defn- gen-sym\n  [env]\n  (symbol (str reserved-prefix \"o\" (swap! (::gen env) inc))))\n\n\n(defn- rewrite-ex-info\n  \"(ex-info msg data cause?) as the portable map holding its parts.\"\n  [form]\n  (cond\n    (seq? form)\n    (cond\n      (empty? form) form\n      (= 'quote (first form)) form\n      (= 'ex-info (first form))\n      (let [[_ msg data cause] (map rewrite-ex-info form)]\n        (cond-> {:yin.k/message msg, :yin.k/data data}\n          (< 3 (count form)) (assoc :yin.k/cause cause)))\n      :else (rebuild form (map rewrite-ex-info form)))\n    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\n    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\n    (set? form) (into #{} (map rewrite-ex-info) form)\n    :else form))\n\n\n(defn- call-kind\n  [env head]\n  (cond\n    (keyword? head) :keyword\n    (not (symbol? head)) :guest\n    (macro-call? env (::macro-env env) head) :macro\n    (native-name? env head) (if (contains? (adapters env) head) :adapted :native)\n    :else :guest))\n\n\n(def ^:private lowered-specials\n  #{'if 'let 'do 'loop 'recur 'throw 'quote 'fn 'and 'or})\n\n\n(declare failing? expand-control)\n\n\n(def ^:private control-heads\n  \"case and the standard control forms: compiler forms that lower to\n   if/let/do, so the outcome pass sees through them like those.\"\n  #{'case 'cond 'when 'if-let 'if-some 'when-let 'when-some})\n\n\n(defn- any-failing?\n  [env forms]\n  (boolean (some #(failing? env %) forms)))\n\n\n(defn- check-macro-operands!\n  \"A macro call is opaque to the lowering pass, so an operand that may fail\n   would escape the early return: refuse it, naming the macro.\"\n  [env head ops]\n  (when (any-failing? env ops)\n    (reject! (str \"Macro call \" head \" has an operand that may fail; \"\n                  \"the outcome model cannot lower it\")\n             {:macro head})))\n\n\n(defn- scoped-failing?\n  \"Whether a sequence of [target init] pairs or the body after them can fail,\n   each init seeing the targets before it.\"\n  [env pairs body]\n  (loop [env env, ps pairs]\n    (if (empty? ps)\n      (any-failing? env body)\n      (let [[target init] (first ps)]\n        (or (failing? env init)\n            (recur (with-locals env (binder-symbols target)) (rest ps)))))))\n\n\n(defn- failing?\n  \"True when evaluating `form` can produce an error outcome: a throw, or a\n   call that returns an outcome (a guest call or an adapted primitive).\"\n  [env form]\n  (cond\n    (seq? form)\n    (if (empty? form)\n      false\n      (let [[head & ops] form]\n        (cond\n          (contains? #{'quote 'fn} head) false\n          (= 'throw head) true\n          (= 'let head) (let [[bindings & body] ops]\n                          (scoped-failing? env (partition 2 (expand-bindings bindings env)) body))\n          ;; the raw outcome of one guest call is a value, not a failure\n          (= 'yin.k/outcome-of head) (do (when-not (and (= 1 (count ops)) (seq? (first ops)))\n                                           (reject! \"yin.k/outcome-of takes one call\" {:form form}))\n                                         (when (any-failing? env (first ops))\n                                           (reject! \"yin.k/outcome-of operands cannot fail\"\n                                                    {:form form}))\n                                         false)\n          (= 'dsg__let head) (let [[bindings & body] ops]\n                               (scoped-failing? env (partition 2 bindings) body))\n          (= 'loop head) (let [[bindings & body] ops]\n                           (scoped-failing? env (partition 2 bindings) body))\n          (contains? control-heads head) (failing? env (expand-control env head ops))\n          (contains? lowered-specials head) (any-failing? env ops)\n          :else (case (call-kind env head)\n                  (:guest :adapted) true\n                  :macro (do (check-macro-operands! env head ops) false)\n                  (any-failing? env ops)))))\n    (or (vector? form) (set? form)) (any-failing? env form)\n    (map? form) (any-failing? env (concat (keys form) (vals form)))\n    :else false))\n\n\n(defn- atomic?\n  [form]\n  (or (symbol? form) (constant-form? form)))\n\n\n(declare lower-tail)\n\n\n(defn- bind-outcome\n  \"Bind `outcome`, return it as is when it is an error, else continue with\n   its payload.\"\n  [env outcome k]\n  (let [o (gen-sym env)]\n    (list 'dsg__let [o outcome]\n          (list 'if (list 'data/content= (list 'data/nth o 0) error-tag)\n                o\n                (k (list 'data/nth o 1))))))\n\n\n(defn- lower-operand\n  \"Continue with a simple form for `form`: the form itself when it cannot\n   fail, else the payload of its outcome.\"\n  [env form k]\n  (if (failing? env form)\n    (bind-outcome env (lower-tail env form) k)\n    (k form)))\n\n\n(defn- lower-operands\n  \"Continue with simple forms for `forms`, evaluated left to right: a form\n   before a may-fail one is bound first so the order of effects survives.\"\n  [env forms k]\n  (letfn [(go\n            [fs acc]\n            (if (empty? fs)\n              (k acc)\n              (let [f (first fs), more (rest fs)]\n                (cond\n                  (atomic? f) (go more (conj acc f))\n                  (failing? env f) (lower-operand env f (fn [v] (go more (conj acc v))))\n                  (any-failing? env more) (let [t (gen-sym env)]\n                                            (list 'dsg__let [t f] (go more (conj acc t))))\n                  :else (go more (conj acc f))))))]\n    (go (seq forms) [])))\n\n\n(defn- lower-let\n  \"`pairs` are plain [symbol init] pairs.\"\n  [env pairs body]\n  (letfn [(go\n            [env ps]\n            (if (empty? ps)\n              (lower-tail env (body-expression body))\n              (let [[x init] (first ps)]\n                (lower-operand env init\n                               (fn [v]\n                                 (list 'dsg__let [x v]\n                                       (go (with-locals env [x]) (rest ps))))))))]\n    (go env pairs)))\n\n\n(defn- lower-loop\n  [env bindings body]\n  (when-not (and (vector? bindings) (even? (count bindings)))\n    (reject! \"loop requires an even-sized binding vector\" {:bindings bindings}))\n  (let [pairs (partition 2 bindings)\n        targets (map first pairs)]\n    (if (scoped-failing? env pairs nil)\n      ;; a may-fail initializer: bind outside, loop over the plain names\n      (do (when-not (every? symbol? targets)\n            (reject! \"A pattern loop binder cannot have a may-fail initializer\"\n                     {:bindings bindings}))\n          (lower-tail env (list 'let bindings\n                                (list 'loop (vec (mapcat (fn [t] [t t]) targets))\n                                      (body-expression body)))))\n      (list 'loop bindings\n            (lower-tail (with-locals env (mapcat binder-symbols targets))\n                        (body-expression body))))))\n\n\n(defn- lower-tail\n  \"The form whose value is the outcome of evaluating `form` in tail position.\"\n  [env form]\n  (cond\n    (seq? form)\n    (if (empty? form)\n      (ok-form form)\n      (let [[head & ops] form]\n        (case (when (symbol? head) head)\n          if (let [[t c & more] ops]\n               (lower-operand env t\n                              (fn [tv]\n                                (list 'if tv (lower-tail env c)\n                                      (if (seq more)\n                                        (lower-tail env (first more))\n                                        (ok-form nil))))))\n          let (do (when-not (vector? (first ops))\n                    (reject! \"let requires a binding vector\" {:bindings (first ops)}))\n                  (lower-let env (partition 2 (expand-bindings (first ops) env)) (rest ops)))\n          dsg__let (lower-let env (partition 2 (first ops)) (rest ops))\n          do (case (count ops)\n               0 (ok-form nil)\n               1 (lower-tail env (first ops))\n               (lower-operand env (first ops)\n                              (fn [v] (list 'do v (lower-tail env (cons 'do (rest ops)))))))\n          loop (lower-loop env (first ops) (rest ops))\n          recur (lower-operands env (vec ops) (fn [vs] (rebuild form (cons 'recur vs))))\n          throw (lower-operand env (first ops) (fn [v] [error-tag v]))\n          (quote fn) (ok-form form)\n          (case cond when if-let if-some when-let when-some)\n          (lower-tail env (expand-control env head ops))\n          and (case (count ops)\n                0 (ok-form true)\n                1 (lower-tail env (first ops))\n                (let [g (gen-sym env)]\n                  (lower-tail env (list 'dsg__let [g (first ops)]\n                                        (list 'if g (cons 'and (rest ops)) g)))))\n          or (case (count ops)\n               0 (ok-form nil)\n               1 (lower-tail env (first ops))\n               (let [g (gen-sym env)]\n                 (lower-tail env (list 'dsg__let [g (first ops)]\n                                       (list 'if g g (cons 'or (rest ops)))))))\n          (case (call-kind env head)\n            :macro (do (check-macro-operands! env head ops) (ok-form form))\n            :keyword (lower-operands env (vec ops)\n                                     (fn [vs] (ok-form (rebuild form (cons head vs)))))\n            :native (lower-operands env (vec ops)\n                                    (fn [vs] (ok-form (rebuild form (cons head vs)))))\n            :adapted (lower-operands env (vec ops)\n                                     (fn [vs] (rebuild form (cons (get (adapters env) head) vs))))\n            :guest (lower-operands env (into [head] ops)\n                                   (fn [vs] (rebuild form vs)))))))\n    (or (vector? form) (set? form) (map? form))\n    (if (failing? env form)\n      (cond\n        (vector? form) (lower-operands env form (fn [vs] (ok-form (vec vs))))\n        (set? form) (lower-operands env (vec form) (fn [vs] (ok-form (set vs))))\n        :else (lower-operands env (vec (mapcat identity form))\n                              (fn [vs] (ok-form (into {} (map vec) (partition 2 vs))))))\n      (ok-form form))\n    :else (ok-form form)))\n\n\n(defn- lower-function-body\n  \"The outcome-returning body of one function over `params`.\"\n  [env macro-env params body-forms]\n  (lower-tail (-> env\n                  (assoc ::macro-env macro-env, ::gen (atom 0))\n                  (with-locals (mapcat binder-symbols params)))\n              (rewrite-ex-info (body-expression body-forms))))\n\n\n(def ^:private source-keys [:line :column :end-line :end-column])\n\n\n(defn- source-meta\n  \"The source position keys of `form`'s reader metadata, or nil.\"\n  [form]\n  (not-empty (select-keys (meta form) source-keys)))\n\n\n(defn- arity-error-form\n  \"The outcome of a call whose argument count no arity admits: it names the\n;; Slice 8 portability source, adaptation v1, pinned LaTTe 86fca0d1.\n;; A context occupies the def-env argument throughout the adapted kernel.\n;; Read operations retain it; writes return a new context. No ambient defaults:\n;; callers supply both extension bindings at initialization. A fresh allocation\n;; returns [name context]. Runtime closures are constructed by guest evaluation.\n[(defn context-not-empty [x] (if (seq x) x nil))\n (defn context-ffirst [x] (first (first x)))\n (defn context-list-star\n   ([a tail] (cons a tail))\n   ([a b tail] (cons a (cons b tail))))\n (defn lookup-in [coll path]\n   (reduce (fn [coll k] (get coll k)) coll path))\n (defn ->Definition [name params arity parsed-term term-free-vars type opts]\n   {:latte/kind :definition :name name :params params :arity arity\n    :parsed-term parsed-term :term-free-vars term-free-vars :type type :opts opts})\n (defn ->Theorem [name params arity type proof]\n   {:latte/kind :theorem :name name :params params :arity arity :type type :proof proof})\n (defn ->Axiom [name params arity type]\n   {:latte/kind :axiom :name name :params params :arity arity :type type})\n (defn ->Notation [name notation-fn]\n   {:latte/kind :notation :name name :notation-fn notation-fn})\n (defn ->Implicit [name implicit-fn]\n   {:latte/kind :implicit :name name :implicit-fn implicit-fn})\n (defn definition? [v] (= :definition (:latte/kind v)))\n (defn theorem? [v] (= :theorem (:latte/kind v)))\n (defn axiom? [v] (= :axiom (:latte/kind v)))\n (defn notation? [v] (= :notation (:latte/kind v)))\n (defn implicit? [v] (= :implicit (:latte/kind v)))\n (defn latte-definition? [v]\n   (or (definition? v) (theorem? v) (axiom? v) (notation? v) (implicit? v)))\n (defn kernel-context [definitions opacity-policy unfold-implicit]\n   {:definitions definitions\n    :unparser-registry {:fundamental [] :standard [] :user [] :unparsers {}}\n    :opacity-policy opacity-policy :unfold-implicit unfold-implicit :fresh 0})\n (defn local-definitions [kernel] (second (:definitions kernel)))\n (defn register-definition\n   ([kernel rdef] (register-definition kernel rdef false))\n   ([kernel rdef local?]\n    (let [[globals locals] (:definitions kernel)]\n      (assoc kernel :definitions\n             (if local? [globals (assoc locals (:name rdef) rdef)]\n                 [(assoc globals (:name rdef) rdef) locals])))))\n (defn fetch-definition\n   ([kernel dname] (fetch-definition kernel dname false))\n   ([kernel dname local-only?]\n    (let [[globals locals] (:definitions kernel)]\n      (if (symbol? dname)\n        (if-let [ldef (get locals dname)]\n          [:ok ldef]\n          (if local-only?\n            [:ko {:msg \"No such (local) definition\" :def dname}]\n            (if-let [gdef (get globals dname)]\n              [:ok gdef]\n              [:ko {:msg \"No such (global) definition\" :def dname}])))\n        (throw (ex-info \"Cannot fetch definition (please report)\" {:dname dname}))))))\n (defn registered-definition?\n   ([kernel dname] (registered-definition? kernel dname false))\n   ([kernel dname local?] (= :ok (first (fetch-definition kernel dname local?)))))\n (defn qualify-def [kernel dname]\n   (if (= :ok (first (fetch-definition kernel dname)))\n     dname\n     (throw (ex-info \"Cannot qualify symbol: not a known definition\" {:symbol dname}))))\n (defn fresh-name [kernel prefix]\n   [(gensym prefix (:fresh kernel)) (assoc kernel :fresh (+ (:fresh kernel) 1))])\n (defn install-unfold-implicit [kernel unfold-fn]\n   (assoc kernel :unfold-implicit unfold-fn))\n (defn install-opacity-function [kernel opacity-fn]\n   (assoc kernel :opacity-policy opacity-fn))\n (defn missing-opacity-policy [ddef opaque?]\n   (throw (ex-info \"Opacity management function not installed (please report)\" {:weird true})))\n (defn missing-unfold-implicit [kernel ctx implicit-def args]\n   (throw (ex-info \"Implicit unfolding function not installed\" {})))\n (defn definition-opacity [ddef opaque?]\n   (assoc ddef :opts (assoc (:opts ddef) :opaque opaque?)))\n (defn is-opaque? [ddef]\n   (if-let [opts (get ddef :opts)] (get opts :opaque)))\n (defn elab-opacity [kernel names opaque?]\n   (reduce\n     (fn [kernel dname]\n       (let [[status ddef] (fetch-definition kernel dname)]\n         (when (= status :ko)\n           (throw (ex-info \"Cannot qualify symbol: not a known definition\" {:symbol dname})))\n         (when (= (if (is-opaque? ddef) true false) opaque?)\n           (throw (ex-info (if opaque? \":opaque fails: definition is already opaque\"\n                              \":transparent fails: definition is not opaque\") {:name dname})))\n         (let [updated ((:opacity-policy kernel) ddef opaque?)]\n           (register-definition kernel updated (contains? (local-definitions kernel) dname)))))\n     kernel names))\n (defn elab-opaque [kernel names] (elab-opacity kernel names true))\n (defn elab-transparent [kernel names] (elab-opacity kernel names false))\n ;; Preserve the upstream unregister's :user-from-:standard behavior exactly.\n (defn unregister-unparser [kernel ident]\n   (let [registry (:unparser-registry kernel)]\n     (when (not (contains? (:unparsers registry) ident))\n       (throw (ex-info \"No such unparser.\" {:ident ident})))\n     (assoc kernel :unparser-registry\n            {:fundamental (into [] (remove (fn [x] (= x ident)) (:fundamental registry)))\n             :standard (into [] (remove (fn [x] (= x ident)) (:standard registry)))\n             :user (into [] (remove (fn [x] (= x ident)) (:standard registry)))\n             :unparsers (data/dissoc (:unparsers registry) ident)})))\n (defn register-unparser\n   ([kernel ident unparser] (register-unparser kernel :user ident unparser))\n   ([kernel category ident unparser]\n    (let [kernel (if (lookup-in kernel [:unparser-registry :unparsers ident])\n                   (unregister-unparser kernel ident) kernel)\n          registry (:unparser-registry kernel)]\n      (when (not (contains? #{:fundamental :standard :user} category))\n        (throw (ex-info \"Wrong unparser category.\" {:category category})))\n      (assoc kernel :unparser-registry\n             (assoc registry category (conj (get registry category) ident)\n                    :unparsers (assoc (:unparsers registry) ident unparser))))))\n (defn unparser-order [kernel]\n   (let [registry (:unparser-registry kernel)]\n     (concat (:fundamental registry) (:standard registry) (:user registry))))\n ;; Same typed-argument boundary as the slice-5 catch adaptation, now with\n ;; the real record field and calling convention (def-env ctx & typed-args).\n (defn unfold-typed-implicit [kernel ctx implicit-def targs args]\n   (let [outcome (yin.k/outcome-of (apply (:implicit-fn implicit-def) kernel ctx targs))]\n     (if (= :yin.k/error (first outcome))\n       [:ko (merge {:implicit (:name implicit-def) :msg (:yin.k/message (second outcome))}\n                   (:yin.k/data (second outcome))) nil]\n       [:ok (second outcome) args])))\n ;; These are the state/diagnostic arms of proof/elab-proof-step. The full\n ;; parsing/typing arms belong to slice 9; unsupported steps fail explicitly.\n ;; The updated context occupies the original def-env slot in :cont, so the\n ;; existing proof loop passes it to all subsequent steps.\n (defn elab-proof-step [kernel ctx var-deps def-uses step args]\n   (case step\n     :opaque [:cont [(elab-opaque kernel args) ctx var-deps def-uses]]\n     :transparent [:cont [(elab-transparent kernel args) ctx var-deps def-uses]]\n     (:print-term :print-type :print-def :print-defenv)\n     [:cont [kernel ctx var-deps def-uses]]\n     (throw (ex-info \"Unsupported context proof step\" {:step step :args args}))))]\n        needed (loop [todo (seq (mapcat mentions program)) seen #{}]\n                 (if-let [n (first todo)]\n                   (if (contains? seen n)\n                     (recur (next todo) seen)\n                     (recur (concat (next todo) (mentions (get by-name n))) (conj seen n)))\n                   seen))]\n    (filterv #(contains? needed (second %)) context-forms)))\n\n\n(defn- context-host-form\n  \"B is ordinary Clojure over the checked-in adaptation. The sole guest\n   outcome intrinsic becomes the equivalent host catch; data primitives and\n   deterministic gensym retain exactly their portable contracts.\"\n  [form]\n  (walk/postwalk\n    (fn [x]\n      (cond\n        (and (seq? x) (= 'yin.k/outcome-of (first x)))\n        `(try [:yin.k/ok ~(second x)]\n              (catch clojure.lang.ExceptionInfo e#\n                [:yin.k/error {:yin.k/message (ex-message e#) :yin.k/data (ex-data e#)}]))\n        (and (seq? x) (= 'gensym (first x)))\n        (list 'symbol (list 'str (second x) (nth x 2)))\n        (= x 'data/dissoc) 'clojure.core/dissoc\n        :else x))\n    form))\n\n\n(defn- context-b\n  [forms call]\n  (let [ns-sym (gensym \"latte-context-b-\")\n        sandbox (create-ns ns-sym)]\n    (try\n      (binding [*ns* sandbox]\n        (refer 'clojure.core)\n        (require '[clojure.set :refer [union difference]])\n        (eval '(declare subst- rebinder subst))\n        (doseq [form (concat (context-for (conj forms call)) forms)] (eval (context-host-form form)))\n;; =============================================================================\n;; Slice 7: the guest collection and higher-order library\n;; =============================================================================\n\n(def ^:private library-modules\n  \"The library's whole host surface: the `kind` module and the `portable`\n   adapters of the data exports the collection predicates read.\"\n  (let [host (fn [registry module-name fns arities]\n               (module/register-host-module\n                 registry module-name fns\n                 (into {} (map (fn [[op _]]\n                                 [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n                       fns)))\n        portable (into {}\n                       (map (fn [[source _]]\n              