(defn nano-time\n  \"Fetch the current time (with high precision).\n  Returns 0 in clojurescript.\"\n  []\n  #?(:clj (System/nanoTime)\n     :cljs 0))\n\n(defn zip\n  \"Zip a sequence of even-numbered elements to a sequence of pairs,\n  i.e. (zip '(x1 y2 x2 y2 ...)) = ([x1 y1] [x2 y2] ...)\"\n  [s]\n  (if (seq s)\n    (if (seq (rest s))\n      (lazy-seq (cons [(first s) (first (rest s))] (zip (rest (rest s)))))\n      (throw (ex-info \"Cannot zip sequence with odd number of elements.\" {:seq s})))\n    s))\n\n(defn vremove\n  \"Remove all elements recognizing `pred` in vector `v`.\"\n  [pred v]\n  (vec (remove pred v)))\n\n(defn map-with\n  \"Combine a mapv of `f` on `coll` with a reduce on `val`.\n  `f` should be a function of two arguments and return a couple.\n  It will be applied on `val` and the first element in `coll`, then on the first\n  part of the returning couple and the second element in `coll`, etc...\n  Return a couple with the resulting `val` and a vector containing all elements\n  in `coll` with `f` applied to them.\"\n  [f val coll]\n  (loop [s coll, val val, res []]\n    (if (seq s)\n      (let [[val' x] (f val (first s))]\n        (recur (rest s) val' (conj res x)))\n      [val, res])))\nsrc/cljc/yin/vm/data.cljc:16:     the hosts' UTF-16 code units: `(data/str-length \\\"a😀\\\")` is 2 on\nsrc/cljc/yin/vm/data.cljc:18:   - `str-compare` orders by code point, which UTF-16 unit order does not\nsrc/cljc/yin/vm/data.cljc:22:     `str->code-points` once and walks the vector with `nth`, never\nsrc/cljc/yin/vm/data.cljc:257:(defn- str-concat\nsrc/cljc/yin/vm/data.cljc:260:    (string! 'str-concat i s))\nsrc/cljc/yin/vm/data.cljc:264:(defn- str-length\nsrc/cljc/yin/vm/data.cljc:266:  (count (text/code-points (string! 'str-length 0 s))))\nsrc/cljc/yin/vm/data.cljc:271:   (substring s start (if (string? s) (str-length s) 0)))\nsrc/cljc/yin/vm/data.cljc:281:(defn- str-index-of\nsrc/cljc/yin/vm/data.cljc:282:  ([s needle] (str-index-of s needle 0))\nsrc/cljc/