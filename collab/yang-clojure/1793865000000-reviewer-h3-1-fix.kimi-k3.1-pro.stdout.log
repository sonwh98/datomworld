(f 21)]))))\n1307\t    (testing (str \"raise through a parameter named \" binding)\n1308\t      (is (= [:yin.k/error {:yin.k/message \"boom\", :yin.k/data {:x 21}}]\n1309\t             (run-outcome\n1310\t               ['(defn g\n1311\t                   []\n1312\t                   (throw (ex-info \"boom\" {:x 21})))\n1313\t                (list 'defn 'f [binding] '(g))\n1314\t                '(+ 1 (f 5))])))))\n1315\t  (is (= [:yin.k/ok 1]\n1316\t         (run-outcome '[(def f (let [get 5] (fn [x] x))) (f 1)]))))\n1317\t\n1318\t\n1319\t(deftest test-common-call-source-admission\n1320\t  (doseq [form '[(let [x 5] (x 1))\n1321\t                 (let [x {:ordinary :map}] (x 1))\n1322\t                 (let [x {:yang.call/entry 5}] (x 1))\n1323\t                 (let [x {:py/type :function :code :legacy}] (x 1))\n1324\t                 (let [x {:yang.call/entry 5}] ((if true x x) 1))\n1325\t                 (let [x {:yang.call/entry (yang.call/entry f)}] (x 1))\n1326\t                 (let [x (assoc {} :yang.call/entry (get f :yang.call/entry))] (x 1))\n1327\t                 (let [x (assoc f :extra :forged)] (x 1))\n1328\t                 (let [x (assoc f :yang.call/entry (yang.call/entry g))] (x 1))\n1329\t                 (let [x (assoc {} :yang.call/entry (yang.call/entry f)\n1330\t                                :clj/admission (get f :clj/admission))] (x 1))\n1331\t                 (let [x {:yang.call/entry (yang.call/entry f)\n1332\t                          :clj/admission (fn [x] true)}] (x 1))]]\n1333\t    (doseq [wrap [identity #(list '+ 1 %)]]\n1334\t      (let [result (run-outcome ['(defn f\n1335\t                                    [x]\n1336\t                                    x)\n1337\t                                 '(defn g\n1338\t                                    [x]\n1339\t                                    (+ x 1)) (wrap form)])]\n1340\t        (is (= :yin.k/error (first result)) (pr-str form))\n1341\t        (is (= :yang.call/not-callable (:yang.call/reason (second result)))\n1342\t            (pr-str form)))))\n1343\t  (is (= [:yin.k/ok [false false true 21]]\n1344\t         (run-outcome '[(defn f\n1345\t                          [x]\n1346\t                          x)\n1347\t                        [(yang.call/eligible? {:yang.call/entry (yang.call/entry f)})\n1348\t                         (yang.call/eligible? (assoc f :extra :forged))\n1349\t                         (yang.call/eligible? f)\n1350\t                         (f 21)]]))))\n1351\t\n1352\t\n1353\t(deftest test-common-call-invalid-continuation-refuses\n1354\t  (let [tamper (fn [forms]\n1355\t                 (walk/postwalk\n1356\t                   (fn [node]\n1357\t                     (if (= node u/capture) (u/lit :invalid-continuation) node))\n1358\t                   (outcome-ast forms)))]\n1359\t    (doseq [run [walker-run semantic-run]]\n1360\t      (let [result (first (run (tamper '[(defn f\n1361\t                                           []\n1362\t                                           1)\n1363\t                                         (let [g f] (+ 1 (g)))])))]\n1364\t        (is (= :yin.k/error (first result)))\n1365\t        (is (= {:yang.call/reason :yang.call/invalid-invocation\n1366\t                :yang.call/data {:yang.call/reason :missing-raise-exit}}\n1367\t               (second result))))\n1368\t      (is (= [:yin.k/ok 2]\n1369\t             (first (run (tamper '[(defn f\n1370\t                                     []\n1371\t                                     1)\n1372\t                                   (+ 1 (f))]))))\n1373\t          \"statically intra-unit calls do not capture a bridge continuation\"))))\n1374\t\n1375\t\n1376\t(deftest test-common-call-rejects-named-arguments\n1377\t  (let [forms '[(defn f\n1378\t                  [x]\n1379\t                  x)"}
