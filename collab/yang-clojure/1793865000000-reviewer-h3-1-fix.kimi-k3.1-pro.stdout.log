       library-opts lane 1000000)]\n2337\t        (is (= :yang.call/not-callable\n2338\t               (:yang.call/reason (second tail-run)))\n2339\t            \"the refusal survives a tail-position value call\"))\n2340\t      (doseq [[where form] [[1 '(five (boom) 2)] [2 '(five 1 (boom))]]]\n2341\t        (let [[tag payload] (run-library\n2342\t                              ['(defn boom\n2343\t                                  []\n2344\t                                  (throw (ex-info \"boom\" {})))\n2345\t                               (list 'let '[five 5 v [five]] form)]\n2346\t                              library-opts lane 1000000)]\n2347\t          (is (= :yin.k/error tag) (str \"operand \" where \" errors before the refusal\"))\n2348\t          (is (= \"boom\" (:yin.k/message payload))\n2349\t              (str \"operand \" where \" is evaluated before the callee check\")))))))\n2350\t\n2351\t\n2352\t(deftest test-run-guest-machine-budget-exhaustion-carries-advanced-consumer\n2353\t  (let [ast (yang/compile-program\n2354\t              '[(def progressed 42)\n2355\t                (loop [i 0]\n2356\t                  (if (< i 20)\n2357\t                    (recur (+ i 1))\n2358\t                    (+ progressed i)))])]\n2359\t    (doseq [lane [:walker :semantic]]\n2360\t      (let [full-steps (loop [m (if (= lane :semantic)\n2361\t                                  (let [vm0 (semantic/create-vm {:make-stream tu/make-stream\n2362\t                                                                 :capability-secret tu/secret\n2363\t                                                                 :modules library-modules})\n2364\t                                        sess (tu/queue-rows! (tu/make-observer-session vm0) ast)]\n2365\t                                    (:consumer\n2366\t                                      (observer/run-on-stream\n2367\t                                        sess engine/ready-for-ingress?\n2368\t                                