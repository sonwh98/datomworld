          :else node))\n1233\t                          (outcome-ast [form])))]\n1234\t      (is (= [:yin.k/ok eligible?]\n1235\t             (first (run (profile-ast '(yang.call/eligible? profile-function))))))\n1236\t      (doseq [form '[(profile-function)\n1237\t                     (yang.call/invoke profile-function [] [] profile-raise)\n1238\t                     (yang.call/invoke-with profile-function [] [] profile-raise {})]]\n1239\t        (let [result (first (run (profile-ast form)))]\n1240\t          (if eligible?\n1241\t            (is (= [:yin.k/ok :called] result))\n1242\t            (is (= :yang.call/not-callable (:yang.call/reason (second result))))))))))\n1243\t\n1244\t\n1245\t(deftest test-common-call-invocation-source-admission\n1246\t  (doseq [invoke-form '[(yang.call/invoke h [21] [] profile-raise)\n1247\t                        (yang.call/invoke-with h [21] [] profile-raise {})]\n1248\t          entry-form '[(get f :yang.call/entry) 5 (fn [invocation] :forged)]]\n1249\t    (let [forged (list 'assoc {} :yang.call/entry entry-form)\n1250\t          result (run-profile-outcome\n1251\t                   ['(defn f\n1252\t                       [x]\n1253\t                       (+ x 21))\n1254\t                    (list 'let ['h forged]\n1255\t                          (list 'get invoke-form :yang.call/reason))])]\n1256\t      (is (= [:yin.k/ok :yang.call/not-callable] result)\n1257\t          (pr-str invoke-form))))\n1258\t  (is (= [:yin.k/ok [42 42]]\n1259\t         (run-profile-outcome\n1260\t           '[(defn f\n1261\t               [x]\n1262\t               (+ x 21))\n1263\t             [(yang.call/invoke f [21] [] profile-raise)\n1264\t              (yang.call/invoke-with f [21] [] profile-raise {})]]))))\n1265\t\n1266\t\n1267\t(deftest test-common-call-invocation-operand-order\n1268\t  (with-redefs [av-modules outcome-modules]\n1269\t    (doseq [run [walker-run semantic-run]\n1270\t            [operator options expected] '[[yang.call/invoke ni