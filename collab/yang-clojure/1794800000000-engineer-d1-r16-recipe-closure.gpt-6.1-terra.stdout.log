{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/correspondence_text.clj src/cljc/yang/correspondence_batch.clj'","aggregated_output":"(ns yang.correspondence-text\n  \"JVM text capture pilot. Acceptance still requires a pinned dependency closure\n   and per-compilation replay of every claimed artifact.\"\n  (:require [clojure.edn :as edn]))\n\n\n(def profile\n  {:yang.correspondence.text/schema 1\n   :host :jvm\n   :clojure-version (clojure-version)\n   :java-version (System/getProperty \"java.version\")\n   :java-vendor (System/getProperty \"java.vendor\")\n   :encoding :utf-8\n   :normalization :none\n   :printer 'clojure.core/pr-str\n   :printer-options {:meta true :length nil :level nil :readably true\n                     :dup false :namespace-maps false}\n   :reader 'clojure.edn/read\n   :reader-options {:values 1 :eof-required true :ambient-readers false\n                    :tags :unsupported}\n   :domain :edn-with-readable-metadata\n   :fidelity-rule :fixed-jvm-integer-wrappers-v1})\n\n\n(defn- kind\n  [x]\n  (cond (map? x) :map (vector? x) :vector (set? x) :set\n        (seq? x) :list (sequential? x) :sequence :else :scalar))\n\n\n(def ^:private fixed-integer-classes #{Byte Short Integer Long})\n\n\n(def ^:private supported-numeric-classes\n  #{Byte Short Integer Long clojure.lang.BigInt java.math.BigInteger\n    java.math.BigDecimal clojure.lang.Ratio Double Float})\n\n\n(defn- numeric-faithful?\n  [a b]\n  (and (number? a) (number? b)\n       (let [ca (class a) cb (class b)]\n         (cond\n           (and (contains? fixed-integer-classes ca)\n                (contains? fixed-integer-classes cb)) (= (long a) (long b))\n           (and (= ca cb) (contains? supported-numeric-classes ca)) (.equals a b)\n           :else false))))\n\n\n(defn- mismatch\n  [a b path]\n  (cond\n    (not= (kind a) (kind b)) {:path path :reason :kind :actual (kind a) :read (kind b)}\n    (not= (some? (meta a)) (some? (meta b))) {:path path :reason :metadata-presence}\n    :else\n    (or (when (some? (meta a)) (mismatch (meta a) (meta b) (conj path :metadata)))\n        (case (kind a)\n          :map (if (not= (count a) (count b))\n                 {:path path :reason :count}\n                 (some identity\n                       (map-indexed (fn [i [[ak av] [bk bv]]]\n                                      (or (mismatch ak bk (conj path [:key i]))\n                                          (mismatch av bv (conj path [:value i ak]))))\n                                    (map vector a b))))\n          (:vector :list :sequence :set)\n          (if (not= (count a) (count b))\n            {:path path :reason :count}\n            (some identity (map-indexed (fn [i [x y]] (mismatch x y (conj path i)))\n                                        (map vector a b))))\n          :scalar (when-not (if (or (number? a) (number? b))\n                              (numeric-faithful? a b)\n                              (= a b))\n                    {:path path :reason :scalar :actual (str (class a)) :read (str (class b))})))))\n\n\n(defn faithful?\n  \"Compare syntax kind, collection iteration order, scalar numeric type and\n   metadata recursively. This is deliberately stricter than Clojure equality.\"\n  [a b]\n  (nil? (mismatch a b [])))\n\n\n(defn- refusal\n  [compilation stage cause]\n  (ex-info \"Text reconstruction refused\"\n           {:rule :correspondence/text :compilation compilation :stage stage} cause))\n\n\n(defn read-one!\n  \"Read one EDN value, refusing all tagged values and any trailing value.\"\n  [compilation source]\n  (try\n    (let [reader (java.io.PushbackReader. (java.io.StringReader. source))\n          eof (Object.)\n          reject-tag (fn [tag _] (throw (ex-info \"Unsupported tag\" {:tag tag})))\n          reject-builtin (fn [_] (throw (ex-info \"Unsupported tag\" {})))\n          options {:eof eof :readers {'inst reject-builtin 'uuid reject-builtin}\n                   :default reject-tag}\n          value (edn/read options reader)\n          trailing (edn/read options reader)]\n      (when (or (identical? eof value) (not (identical? eof trailing)))\n        (throw (ex-info \"Expected exactly one value\" {})))\n      value)\n    (catch Exception e (throw (refusal compilation :read e)))))\n\n\n(defn capture!\n  \"Print and immediately read back an actual input, refusing lossy captures.\"\n  [compilation value]\n  (let [source (try (binding [*print-meta* true *print-length* nil *print-level* nil\n                              *print-readably* true *print-dup* false\n                              *print-namespace-maps* false]\n                      (pr-str value))\n                    (catch Exception e (throw (refusal compilation :print e))))\n        restored (read-one! compilation source)]\n    (when-let [difference (mismatch value restored [])]\n      (throw (ex-info \"Text capture loses input fidelity\"\n                      {:rule :correspondence/text :compilation compilation\n                       :stage :fidelity :difference difference})))\n    source))\n(ns yang.correspondence-batch\n  \"Resumable per-fixture outcome records for one corpus static-gate run.\n   The outcomes file IS the progress record: every recorded outcome is\n   final (append-only), an interruption loses at most the in-flight\n   fixture, and `:not-run` is never a pass or a refusal. These records\n   are run bookkeeping, not a verification result.\"\n  (:require [clojure.edn :as edn]\n            [clojure.java.io :as io]\n            [dao.jing :as jing]\n            [yin.vm :as vm]))\n\n\n(def ^:private recordable-statuses #{:pass :refused})\n\n\n(defn- outcome-refusal\n  [reason detail]\n  (ex-info \"Outcome record refused\"\n           (assoc detail :rule :correspondence/outcome :reason reason)))\n\n\n(defn- checked-outcome\n  \"Validate one outcome entry per status: a pass carries its recorded\n   admission origin and the storage it measured; a refusal names its\n   stage. Anything else refuses rather than recording half a fact.\"\n  [fixture outcome]\n  (when-not (map? outcome) (throw (outcome-refusal :outcome-shape {:fixture fixture})))\n  (let [status (:status outcome)]\n    (when-not (contains? recordable-statuses status)\n      (throw (outcome-refusal :outcome-status {:fixture fixture :status status})))\n    (case status\n      :pass (when-not (and (vm/occurrence-origin? (:admission-origin outcome))\n                           (nat-int? (:storage-bytes outcome))\n                           (every? #(jing/segment-address? (get-in outcome [:addresses %]))\n                                   [:input :snapshot :evidence :profile :root :stamped-root]))\n              (throw (outcome-refusal :pass-evidence\n                                      {:fixture fixture\n                                       :requires [:admission-origin :storage-bytes :addresses]})))\n      :refused (when-not (keyword? (:stage outcome))\n                 (throw (outcome-refusal :refusal-stage {:fixture fixture}))))\n    outcome))\n\n\n(defn- sync-directory!\n  \"Flush the directory entry so a renamed-in progress record survives a\n   process crash. Best-effort on platforms without directory sync.\"\n  [dir-file]\n  (try\n    (let [channel (java.nio.channels.FileChannel/open\n                    (.toPath dir-file)\n                    (into-array java.nio.file.OpenOption\n                                [java.nio.file.StandardOpenOption/READ]))]\n      (try (.force channel true) (finally (.close channel))))\n    (catch Exception _ nil)))\n\n\n(defn- write-atomically!\n  \"Write `value` to `file` through a same-directory temporary file, so a\n   reader never observes a partial progress record.\"\n  [file value]\n  (let [target (io/file file)\n        parent (or (.getParentFile target) (io/file \".\"))\n        temporary (io/file parent (str (.getName target) \".partial-\" (random-uuid)))]\n    (try\n      (when-not (.exists parent) (.mkdirs parent))\n      (let [bytes (.getBytes (with-out-str (prn value)) \"UTF-8\")]\n        (with-open [out (java.io.FileOutputStream. temporary)]\n          (.write out bytes)\n          (.flush out)\n          (.sync (.getFD out))))\n      (java.nio.file.Files/move (.toPath temporary) (.toPath target)\n                                (into-array java.nio.file.CopyOption\n                                            [java.nio.file.StandardCopyOption/ATOMIC_MOVE\n                                             java.nio.file.StandardCopyOption/REPLACE_EXISTING]))\n      (sync-directory! parent)\n      nil\n      (finally\n        (when (.exists temporary) (.delete temporary))))))\n\n\n(defn initialize!\n  \"Create the progress record for one corpus run: every supplied fixture\n   id starts `:not-run`. An existing file refuses — a run's record is\n   never reset.\"\n  [file fixtures]\n  (let [ids (vec fixtures)]\n    (when-not (and (every? keyword? ids)\n                   (= (count ids) (count (distinct ids))))\n      (throw (outcome-refusal :fixture-ids {:fixtures ids})))\n    (when (.exists (io/file file))\n      (throw (outcome-refusal :progress-exists {:file (str file)})))\n    (write-atomically! file\n                       {:scope :d1-per-fixture-static-gates\n                        :not-a-verification-result true\n                        :fixture-count (count ids)\n                        :outcomes (into {} (map (fn [id] [id {:status :not-run}])) ids)})\n    nil))\n\n\n(defn read-progress\n  \"Read and shape-check the progress record at `file`.\"\n  [file]\n  (let [f (io/file file)]\n    (when-not (.exists f)\n      (throw (outcome-refusal :progress-absent {:file (str file)})))\n    (let [progress (edn/read-string (slurp f))]\n      (when-not (and (map? progress) (map? (:outcomes progress))\n                     (pos-int? (:fixture-count progress)))\n        (throw (outcome-refusal :progress-shape {:file (str file)})))\n      progress)))\n\n\n(defn record!\n  \"Record one fixture's FINAL outcome. The fixture must be one this run\n   initialized, the outcome must be complete for its status, and a\n   fixture whose outcome is already recorded never changes: re-running a\n   batch skips it instead of rewriting it.\"\n  [file fixture outcome]\n  (let [progress (read-progress file)\n        outcomes (:outcomes progress)]\n    (when-not (contains? outcomes fixture)\n      (throw (outcome-refusal :unknown-fixture {:fixture fixture})))\n    (let [checked (checked-outcome fixture outcome)]\n      (when-not (= :not-run (:status (get outcomes fixture)))\n        (throw (outcome-refusal :outcome-final\n                                {:fixture fixture\n                                 :recorded (get outcomes fixture)})))\n      (write-atomically! file (assoc progress :outcomes\n                                     (assoc outcomes fixture checked)))\n      nil)))\n\n\n(defn summary\n  \"Count outcomes by status; `:not-run` counts stay visible so an\n   incomplete run never reads as complete.\"\n  [progress]\n  (let [counts (frequencies (map (comp :status val) (:outcomes progress)))]\n    {:fixture-count (:fixture-count progress)\n     :pass (get counts :pass 0)\n     :refused (get counts :refused 0)\n     :not-run (get counts :not-run 0)}))\n\n(defn corpus-index!\n  \"Build an index of retained fixture addresses after checking their direct\n   content and admission coordinates. This is not a recipe or D1 record;\n   it does not verify transitive row closures or executable dependencies.\"\n  [handle progress]\n  (let [outcomes (:outcomes progress)\n        missing ::missing]\n    (when-not (and (map? outcomes) (pos-int? (:fixture-count progress))\n                   (= (:fixture-count progress) (count outcomes)))\n      (throw (outcome-refusal :corpus-shape {})))\n    {:scope :retained-static-corpus-index\n     :not-a-verification-result true\n     :fixtures\n     (into {}\n           (for [[fixture outcome] outcomes]\n             (do\n               (checked-outcome fixture outcome)\n               (when-not (= :pass (:status outcome))\n                 (throw (outcome-refusal :corpus-incomplete {:fixture fixture})))\n               (let [addresses (:addresses outcome)\n                     content (into {} (map (fn [[role address]]\n                                             [role (jing/get handle address missing)]))\n                                   (select-keys addresses [:input :snapshot :evidence :profile :root :stamped-root]))\n                     input (:input content)\n                     snapshot (:snapshot content)\n                     origin (:admission-origin outcome)]\n                 (when (or (some #{missing} (vals content))\n                           (not= fixture (get-in input [:fixture :id]) (:fixture snapshot))\n                           (not= origin (:admission-origin input) (:origin snapshot))\n                           (not= (:root addresses) (:root snapshot))\n                           (not= (:stamped-root addresses) (:stamped-root snapshot))\n                           (not (contains? (get-in content [:evidence :fixtures]) fixture)))\n                   (throw (outcome-refusal :corpus-content {:fixture fixture})))\n                 [fixture {:admission-origin origin :addresses addresses}]))))}))\n","exit_code":0,"status":"completed"}}
