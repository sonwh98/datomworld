{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/correspondence_dependency.clj test/yang/correspondence_dependency_test.clj'","aggregated_output":"(ns yang.correspondence-dependency\n  \"Byte-preserving dependency bundle storage. A bundle does not assert that\n   its contents are a complete or executable reconstruction closure.\"\n  (:require [clojure.string :as string]\n            [dao.jing :as jing])\n  (:import [java.util Base64]))\n\n(defn- path? [p]\n  (and (string? p) (not (string/blank? p))\n       (not (string/starts-with? p \"/\"))\n       (not (string/includes? p \"\\\\\"))\n       (every? #(and (not (string/blank? %)) (not (#{\".\" \"..\"} %)))\n               (string/split p #\"/\" -1))))\n\n(defn- fail! [reason]\n  (throw (ex-info \"Invalid correspondence dependency bundle\" {:reason reason})))\n\n(defn store-bundle!\n  \"Store explicit [relative-path byte-array] entries and an addressed index.\n   The caller is responsible for identifying the complete dependency set.\"\n  [handle entries]\n  (when-not (and (vector? entries) (seq entries)\n                 (every? #(and (vector? %) (= 2 (count %))\n                               (path? (first %)) (bytes? (second %))) entries)\n                 (= (count entries) (count (set (map first entries)))))\n    (fail! :entries))\n  (let [encoder (Base64/getEncoder)\n        index (mapv (fn [[path data]]\n                      [path (jing/materialize! handle\n                                              {:schema 1 :base64 (.encodeToString encoder data)})])\n                    entries)]\n    (jing/materialize! handle {:schema 1 :entries index})))\n\n(defn fetch-bundle!\n  \"Fetch and validate the index and every byte object, returning path/bytes.\n   dao.jing verifies each address. No files are written or executed.\"\n  [handle address]\n  (let [missing (Object.)\n        index (jing/get handle address missing)\n        entries (:entries index)]\n    (when-not (and (map? index) (= #{:schema :entries} (set (keys index)))\n                   (= 1 (:schema index)) (vector? entries) (seq entries)\n                   (every? #(and (vector? %) (= 2 (count %))\n                                 (path? (first %)) (jing/segment-address? (second %))) entries)\n                   (= (count entries) (count (set (map first entries)))))\n      (fail! :index))\n    (mapv (fn [[path ref]]\n            (let [blob (jing/get handle ref missing)]\n              (when-not (and (map? blob) (= #{:schema :base64} (set (keys blob)))\n                             (= 1 (:schema blob)) (string? (:base64 blob)))\n                (fail! :blob))\n              (let [data (try (.decode (Base64/getDecoder) ^String (:base64 blob))\n                              (catch IllegalArgumentException _ (fail! :base64)))]\n                (when-not (= (:base64 blob) (.encodeToString (Base64/getEncoder) data))\n                  (fail! :base64))\n                [path data])))\n          entries)))\n(ns yang.correspondence-dependency-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yang.correspondence-dependency :as dependency]\n            [yin.repl.store :as store]))\n\n(deftest dependency-bundle-roundtrip-and-refusal\n  (let [store (mem/create-content-mem)\n        inputs [[\"src/example.clj\" (byte-array [0 1 -1 10])]\n                [\"lib/runtime.jar\" (byte-array [42 0 13])]]\n        address (dependency/store-bundle! store inputs)\n        bundle (dependency/fetch-bundle! store address)]\n    (is (jing/segment-address? address))\n    (is (= (mapv first inputs) (mapv first bundle)))\n    (is (= (mapv (comp vec second) inputs) (mapv (comp vec second) bundle)))\n    (is (thrown? Exception (dependency/store-bundle! store [[\"x\" (byte-array 0)] [\"x\" (byte-array 0)]])))\n    (is (thrown? Exception (dependency/store-bundle! store [[\"../escape\" (byte-array 0)]])))\n    (let [missing (jing/materialize! store {:schema 1 :entries [[\"x\" address]]})]\n      (is (thrown? Exception (dependency/fetch-bundle! store missing))))))\n\n\n(deftest bundle-reopens-and-missing-dependencies-refuse\n  (let [dir (.toFile (java.nio.file.Files/createTempDirectory\n                       \"d1-dependencies-\" (make-array java.nio.file.attribute.FileAttribute 0)))\n        spec {:type :file :dir (.getPath dir)}\n        handle (store/open spec)\n        address (dependency/store-bundle! handle [[\"compiler.clj\" (.getBytes \"source\\n\" \"UTF-8\")]])]\n    (try\n      (jing/close! handle)\n      (let [reopened (store/open spec)]\n        (try\n          (is (= \"source\\n\" (String. ^bytes (second (first (dependency/fetch-bundle! reopened address))) \"UTF-8\")))\n          (finally (jing/close! reopened))))\n      (let [other (mem/create-content-mem)\n            index (let [h (store/open spec)]\n                    (try (jing/get h address nil) (finally (jing/close! h))))\n            dangling (jing/materialize! other index)]\n        (is (thrown? Exception (dependency/fetch-bundle! other dangling))))\n      (finally\n        (doseq [f (reverse (file-seq dir))] (.delete f))))))\n","exit_code":0,"status":"completed"}}
