===========================\\n+;; Call-site occurrence contract C1 (Addendum A, design §2)\\n+;; =============================================================================\\n+;;\\n+;; Every final `:application` occurrence of a produced tree carries the\\n+;; reserved frontend-metadata key `:yang/call-site` with version value `1`\\n+;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\\n+;; from canonical rows and emits it into the frontend-metadata side table\\n+;; as `[origin root-address path :yang/call-site 1]`, where the first\\n+;; three coordinates are the site id. The key carries no callee identity,\\n+;; source arity, or ambient classification. It is distinct from\\n+;; `:yang/site`, the safepoint mark, which travels as node metadata.\\n+;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\\n+;; continuation nodes) are not `:application` nodes and are never marked.\\n+;; The walk lives here, beside the other shared tree transforms, so every\\n+;; frontend's module trees finalize the same way; `yang.clojure` owns the\\n+;; contract's validation over canonical rows.\\n+\\n+(defn annotate-call-sites\\n+  \\\"The finished map AST `node` with `:yang/call-site 1` on every\\n+   `:application` node, at every depth the row grammar knows. Literal\\n+   payloads are data, never syntax, and are not walked. Marking is\\n+   idempotent and preserves node metadata and every other key, so\\n+   canonical rows, roots, and executable outcomes are unchanged.\\\"\\n+  [node]\\n+  (let [tag (:type node)\\n+        slots (get vm/semantic-bytecode-grammar tag)]\\n+    (when-not slots\\n+      (throw (ex-info \\\"Unknown AST node type\\\" {:type tag, :node node})))\\n+    (let [walked (reduce (fn [n [field kind]]\\n+                           (case kind\\n+                             :node (update n field annotate-call-sites)\\n+                             :nodes (update n field\\n+                                            (fn [children]\\n+                                              (mapv annotate-call-sites\\n+                                                    children)))\\n+                             n))\\n+                         node\\n+                         slots)]\\n+      (cond-> walked\\n+        (= :application tag) (assoc :yang/call-site 1)))))\\ndiff --git a/src/cljc/yin/repl/frontends.cljc b/src/cljc/yin/repl/frontends.cljc\\nindex 35db43c1..2668cb67 100644\\n--- a/src/cljc/yin/repl/frontends.cljc\\n+++ b/src/cljc/yin/repl/frontends.cljc\\n@@ -39,6 +39,20 @@\\n    :yang.frontend/support-profile :segment/legacy})\\n \\n \\n+(defn clojure-manifest\\n+  \\\"The Clojure frontend's manifest. Its coverage promise changed under\\n+   the call-site occurrence contract C1 — every final `:application`\\n+   occurrence carries `:yang/call-site` in the frontend-metadata side\\n+   table, finalized over the post-expansion tree that executes and\\n+   retained beside a published module's manifest — and that promise is\\n+   a support claim, so the revision and the support profile name it;\\n+   the shared legacy profiles no longer describe this frontend.\\\"\\n+  []\\n+  (assoc (manifest :yang/clojure :clojure)\\n+         :yang.frontend/revision \\\"c1-1\\\"\\n+         :yang.frontend/support-profile :yang.clojure/c1))\\n+\\n+\\n (defn- clojure-lower\\n   [forms]\\n   (if (= 1 (count forms))\\n@@ -78,7 +92,7 @@\\n    returns.\\\"\\n   []\\n   (cond-> frontend/empty-catalog\\n-    true (frontend/install (manifest :yang/clojure :clojure)\\n+    true (frontend/install (clojure-manifest)\\n                            {:input :forms,\\n                             :parse identity,\\n                             :lower clojure-lower})\\ndiff --git a/src/cljc/yin/vm.cljc b/src/cljc/yin/vm.cljc\\nindex b0d222ca..1bb7ca84 100644\\n--- a/src/cljc/yin/vm.cljc\\n+++ b/src/cljc/yin/vm.cljc\\n@@ -1609,6 +1609,20 @@\\n                (into tuples (map (fn [[path id]] [root path id]) frontier)))))))\\n \\n \\n+(defn application-occurrences\\n+  \\\"The `[root path]` of every `:application` occurrence of the projected\\n+   row set `tree`: the occurrence relation joined on the row tags, with\\n+   no origin — a composition fixes the origin from its own side, as with\\n+   `occurrences`. This is the eligible-site derivation of the call-site\\n+   occurrence contract: one pair per place, so a shared application row\\n+   at two places counts twice.\\\"\\n+  [{:keys [rows] :as tree}]\\n+  (into #{}\\n+        (comp (filter (fn [[_ _ id]] (= :application (nth (get rows id) 1))))\\n+              (map (fn [[root path _]] [root path])))\\n+        (occurrences tree)))\\n+\\n+\\n (def occurrence-rules\\n   \\\"§4.5/§7.7: root-scoped occurrence rules, as portable data. A name is\\n    bound at `[root path]` iff a `:lambda` occurrence of the same root sits\\ndiff --git a/src/cljc/yin/vm/encoder.cljc b/src/cljc/yin/vm/encoder.cljc\\nindex 1bda6def..acbbf2f7 100644\\n--- a/src/cljc/yin/vm/encoder.cljc\\n+++ b/src/cljc/yin/vm/encoder.cljc\\n@@ -227,35 +227,122 @@\\n                               {:rule :batch-member, :member member}))))\\n \\n \\n+(def ^:private call-site-key\\n+  \\\"The reserved frontend-metadata key of the call-site occurrence\\n+   contract C1 (`yang.clojure`), enforced at this boundary but not\\n+   owned by it.\\\"\\n+  :yang/call-site)\\n+\\n+\\n+(defn- marked-call-sites\\n+  \\\"The `[path value]` of every node of map AST `ast` carrying the C1\\n+   key, walked by the row grammar. Literal payloads are data, never\\n+   syntax, and are not walked. Member ASTs are already projected by the\\n+   time this runs, so every tag is a grammar tag.\\\"\\n+  [ast]\\n+  (letfn [(walk\\n+            [node path]\\n+            (into (if (contains? node call-site-key)\\n+                    [[path (get node call-site-key)]]\\n+                    [])\\n+                  (mapcat (fn [[j [field kind]]]\\n+                            (let [pos (+ j 2)\\n+                                  value (get node field)]\\n+                              (case kind\\n+                                :node (walk value (conj path pos))\\n+                                :nodes (mapcat (fn [[i child]]\\n+                                                 (walk child\\n+                                                       (conj path [pos i])))\\n+                                               (map-indexed vector value))\\n+                                nil)))\\n+                          (map-indexed vector\\n+                                       (get vm/semantic-bytecode-grammar\\n+                                            (:type node))))))]\\n+    (walk ast [])))\\n+\\n+\\n+(defn- check-call-site-claim!\\n+  \\\"Refuse a batch member whose C1 markers do not exactly cover its\\n+   projected tree, naming the failed `:rule`: canonical-row production\\n+   must not silently drop a frontend's coverage claim. The claim is\\n+   checked root-relatively — admission origins belong to the admitting\\n+   expander, not to this projection. A member carrying no markers\\n+   makes no claim and passes; the executed tree's table is finalized\\n+   after expansion, over the final rows. Answers true when the member\\n+   claimed coverage (it passed the check), false when it carried no\\n+   markers — one verdict per member, so the selected member's own\\n+   verdict, never a sibling's, decides whether the expander finalizes\\n+   its side table.\\\"\\n+  [ast tree]\\n+  (let [marked (marked-call-sites ast)]\\n+    (if (seq marked)\\n+      (do (doseq [[path value] marked]\\n+            (when (not= 1 value)\\n+              (throw (ex-info \\\"Unsupported call-site marker version\\\"\\n+                              {:rule :yang/call-site-unsupported-version,\\n+                               :path path, :value value}))))\\n+          (let [eligible (into #{} (map second) (vm/application-occurrences tree))\\n+                claimed (into #{} (map first) marked)]\\n+            (when (not= eligible claimed)\\n+              (throw (ex-info \\\"Call-site markers do not cover the projected tree\\\"\\n+                              {:rule :yang/call-site-incomplete-coverage,\\n+                               :missing (vec (sort-by pr-str\\n+                                                      (remove claimed eligible))),\\n+                               :extra (vec (sort-by pr-str\\n+                                                    (remove eligible claimed)))}))))\\n+          true)\\n+      false)))\\n+\\n+\\n (defn program-batch\\n   \\\"Encode frontend output as the expander's input batch (§2.1):\\n-   `[:yin.program/batch trees run-index declaration-rows harvest-rows]`.\\n-   Each member — a map AST or a `:yin/*` datom batch — projects to one tree\\n-   packet; `run-index` selects the one that becomes the program. Harvest\\n-   rows name every `(yin/def <literal-symbol> value)` occurrence in source\\n-   declaration order, member by member; declaration rows name those whose\\n-   lambda the frontend flagged `:macro?`. No syntax object crosses: every\\n-   code field is canonical rows.\\\"\\n+   `[:yin.program/batch trees run-index declaration-rows harvest-rows\\n+   call-site-claims]` — the trailing element present only when some\\n+   member claimed call-site (C1) coverage, holding one boolean verdict\\n+   per member, so every unclaimed batch keeps the five-element shape.\\n+   Each member — a map AST or a `:yin/*` datom batch\\n+   — projects to one tree packet; `run-index` selects the one that\\n+   becomes the program. Harvest rows name every `(yin/def\\n+   <literal-symbol> value)` occurrence in source declaration order,\\n+   member by member; declaration rows name those whose lambda the\\n+   frontend flagged `:macro?`. No syntax object crosses: every code\\n+   field is canonical rows. A member whose frontend markers claim\\n+   call-site (C1) coverage is checked against its projected tree before\\n+   the batch is formed (`check-call-site-claim!`): the markers drop out\\n+   of the rows, but never silently — a broken claim refuses the batch,\\n+   and the per-member claim verdicts travel with the batch, so the\\n+   expander finalizes a member's executed tree's table when, and only\\n+   when, that member's own verdict is a claim.\\\"\\n   ([member] (program-batch [member] 0))\\n   ([members run-index]\\n    (let [asts (mapv member-ast members)\\n-         trees (mapv (fn [ast]\\n-                       (let [{:keys [root rows]} (vm/ast->semantic-bytecode ast)]\\n-                         [root (vec (vals rows))]))\\n-                     asts)\\n+         row-sets (mapv vm/ast->semantic-bytecode asts)\\n+         trees (mapv (fn [{:keys [root rows]}] [root (vec (vals rows))])\\n+                     row-sets)\\n          occurrences (vec (mapcat (fn [j ast]\\n                                     (map #(assoc % :tree j)\\n                                          (definition-occurrences ast)))\\n-                                  (range) asts))]\\n-     [:yin.program/batch\\n-      trees\\n-      run-index\\n-      (into [] (comp (filter :declared?)\\n-                     (map (fn [{:keys [tree path]}] [:yin.macro/definition tree path])))\\n-            occurrences)\\n-      (into [] (map-indexed (fn [h {:keys [tree path]}]\\n-                              [:yin.macro/harvest h tree path]))\\n-            occurrences)])))\\n+                                  (range) asts))\\n+         ;; A frontend's C1 claim is enforced here, where its markers\\n+         ;; would otherwise drop out of canonical-row production unread.\\n+         ;; EVERY member is validated — `mapv` is eager, so a defect in\\n+         ;; any member refuses the batch, however valid its siblings —\\n+         ;; and the per-member verdicts ride with the batch: each\\n+         ;; member's own verdict, never a sibling's, decides whether the\\n+         ;; expander finalizes that member's side table.\\n+         verdicts (mapv check-call-site-claim! asts row-sets)\\n+         claims (when (some true? verdicts) verdicts)]\\n+     (cond-> [:yin.program/batch\\n+              trees\\n+              run-index\\n+              (into [] (comp (filter :declared?)\\n+                             (map (fn [{:keys [tree path]}]\\n+                                    [:yin.macro/definition tree path])))\\n+                    occurrences)\\n+              (into [] (map-indexed (fn [h {:keys [tree path]}]\\n+                                      [:yin.macro/harvest h tree path]))\\n+                    occurrences)]\\n+       claims (conj claims)))))\\n \\n \\n (defn ready?\\ndiff --git a/src/cljc/yin/vm/linker.cljc b/src/cljc/yin/vm/linker.cljc\\nindex 8900fd54..44aacf0e 100644\\n--- a/src/cljc/yin/vm/linker.cljc\\n+++ b/src/cljc/yin/vm/linker.cljc\\n@@ -738,11 +738,11 @@\\n \\n (def ^:private manifest-keys\\n   \\\"The closed key set of a schema-1 manifest: every key of section 8.1's\\n-   example, the index alone optional.\\\"\\n+   example, the index and the call-site reference alone optional.\\\"\\n   #{:yin.module/name :yin.module/schema :yin.module/contracts\\n     :yin.module/tree :yin.module/derivations :yin.module/index\\n     :yin.module/exports :yin.module/requires :yin.module/primitives\\n-    :yin.module/footprint})\\n+    :yin.module/footprint :yin.module/call-sites})\\n \\n \\n (def ^:private derivation-formats\\n@@ -785,7 +785,8 @@\\n                   (when (or (not (contains? manifest k))\\n                             (nil? (get manifest k)))\\n                     (assoc (shape k) :missing true)))\\n-                (disj manifest-keys :yin.module/index))\\n+                (disj manifest-keys :yin.module/index\\n+                      :yin.module/call-sites))\\n           (when-not (symbol? (:yin.module/name manifest))\\n             (shape :yin.module/name))\\n           (when (vm/reserved-name? (:yin.module/name manifest))\\n@@ -831,6 +832,16 @@\\