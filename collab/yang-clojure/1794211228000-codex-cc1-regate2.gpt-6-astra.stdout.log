{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '563,598p' src/cljc/yin/vm/macro.cljc; sed -n '1790,1870p' src/cljc/yin/vm/macro.cljc; nl -ba src/cljc/yin/vm/macro.cljc | sed -n '884,950p'; rg -n 'primitives|data/|default-env|module|resolve' src/cljc/yin/vm/ast_walker.cljc | head -n 45\"","aggregated_output":";; Bounded body runner and row-native prelude (§5)\n;; =============================================================================\n\n(defn- throw-prelude\n  [msg data]\n  (throw (ex-info msg (assoc data :yin.macro/prelude true))))\n\n\n(defn- packet?\n  [x]\n  (and (vector? x) (= 2 (count x)) (jing/segment-address? (first x))\n       (vector? (second x))))\n\n\n(defn- need-packet\n  [who x]\n  (when-not (packet? x)\n    (throw-prelude (str who \" expects a tree packet\") {:op who}))\n  x)\n\n\n(defn- merge-packets\n  \"Union the rows of `packets` into one index, verifying that one address\n   denotes one body (§5.3).\"\n  [packets]\n  (reduce (fn [index row]\n            (let [prior (get index (first row))]\n              (cond (nil? prior) (assoc index (first row) row)\n                    (same-value? prior row) index\n                    :else (throw-prelude \"Packet address conflict\"\n                                         {:address (first row)}))))\n          {}\n          (mapcat second packets)))\n\n\n(def ^:private pending-expansion-origin\n                             :params '[l],\n                             :body (app (v 'yin/make-def) (v 'fn-name) (v 'l))}\n                            (app (v 'yin/make-lambda) (v 'fn-params) (v 'b)))}\n                (app (v 'yin/sequence-body) (v 'body)))}))\n\n\n(def stdlib-forms\n  \"The standard forms as a row-native batch: one tree defining `defn`,\n   declared and harvested. Seed a store by expanding it (`seed-store`).\"\n  (let [def-ast {:type :application,\n                 :operator {:type :variable, :name 'yin/def},\n                 :operands [{:type :literal, :value 'defn} defn-lambda-ast]}]\n    [:yin.program/batch\n     [(ast->packet def-ast)]\n     0\n     [[:yin.macro/definition 0 []]]\n     [[:yin.macro/harvest 0 0 []]]]))\n\n\n(defn seed-store\n  \"Fold validated input batches in order through `expand-batch`, returning\n   the resulting store. Throws on a batch that fails.\"\n  [ctx batches]\n  (:store (reduce (fn [ctx batch]\n                    (let [{:keys [status error] :as r} (expand-batch batch ctx)]\n                      (when-not (= :ok status)\n                        (throw (ex-info \"Store seeding batch failed\" error)))\n                      (:ctx r)))\n                  ctx\n                  batches)))\n\n\n;; =============================================================================\n;; Expander observer (§9)\n;; =============================================================================\n\n(defn make-expander\n  \"The observer consumer: `ctx`, the `program-out` writer, and an optional\n   log writer, with nothing staged.\"\n  ([ctx out] (make-expander ctx out nil))\n  ([ctx out log]\n   {:ctx ctx, :out out, :out-staged nil, :log log, :log-staged nil,\n    :forwarded 0, :errors []}))\n\n\n(defn ready?\n  \"Ready only when both staged slots are empty.\"\n  [expander]\n  (and (nil? (:out-staged expander)) (nil? (:log-staged expander))))\n\n\n(defn call-site-table\n  \"The C1 side table the consumer `expander` holds for the occurrence\n   the executed tree packet `tree` names — `origin` being the admission\n   origin the table was stored under (§2.1: an application site is\n   K = [origin root-address path]; the table's key is the admission\n   origin beside the root address, while each row's own origin names\n   that occurrence's admission or generating expansion record) — or nil when\n   that occurrence made no C1 claim. Two expansions can produce the\n   SAME final root from different admissions; keying by the full\n   occurrence identity keeps their tables distinct, so resolving by the\n   origin+root pair at hand never answers another execution's table,\n   however many loads have run since, and an unclaimed load of a root\n   previously loaded under a claim retrieves no stale table.\"\n  [expander tree origin]\n  (get (:call-site-tables expander) [origin (first tree)]))\n\n\n(defn load\n  \"Expand one observed batch once: keep the returned context, stage the\n   tree only on success, stage the log when a log writer exists, and\n   accumulate the error of a failed expansion. Expansion failure is\n   data, so the cursor advances past it. A successful expansion's C1\n   side table (the batch result's `:frontend-metadata`, present only\n   when the selected member itself claimed coverage) is retained on the\n   consumer under the occurrence identity of the staged tree — its\n   admission origin beside its final root address (`call-site-tables`,\n   resolved by `call-site-table`) — so the composition that drives this\n   expander — the REPL's session — holds every executed occurrence's\n   coverage beside the expander that produced it, each load's table\n   surviving the next, even when two loads land on the same root.\"\n   884\t   Tracking metadata is valid only for the exact vector object it was\n   885\t   attached to (P1-4): host `assoc`/`conj` copy the input vector's\n   886\t   metadata onto a new vector whose contents may be unrelated, so\n   887\t   every content-changing primitive routes its result through the one\n   888\t   choke point `recover-rebuilt-packet`, which drops `::origin-of`\n   889\t   before lineage recovery. Extractive primitives (`first`/`get`)\n   890\t   return the very object that was tagged, so they alone may trust\n   891\t   the metadata they hand back. A rebuilt packet no lineage entry\n   892\t   accounts for carries no provenance and is refused downstream.\"\n   893\t  ([gensym] (prelude gensym (atom [])))\n   894\t  ([gensym lineage]\n   895\t   (let [recover-packet (fn [result]\n   896\t                          (cond (not (packet? result)) result\n   897\t                                (origin-of-fn result)\n   898\t                                (register-lineage! lineage result)\n   899\t                                :else (if-some [f (lineage-origin-for\n   900\t                                                    lineage result)]\n   901\t                                        (with-origin-of result f)\n   902\t                                        result)))\n   903\t         recover-rebuilt-packet\n   904\t         (fn [result]\n   905\t           (recover-packet (if (origin-of-fn result)\n   906\t                             (vary-meta result dissoc ::origin-of)\n   907\t                             result)))\n   908\t         wrap (fn [sym f]\n   909\t                (let [entry (get vm/primitives sym)]\n   910\t                  (if (and (map? entry)\n   911\t                           (contains? entry :yin.k/function))\n   912\t                    (assoc entry :yin.k/function f)\n   913\t                    f)))\n   914\t         p-first (fn [coll]\n   915\t                   (register-lineage! lineage coll)\n   916\t                   (recover-packet (first coll)))\n   917\t         p-rest (fn [coll]\n   918\t                  (register-lineage! lineage coll)\n   919\t                  (vec (rest coll)))\n   920\t         p-conj (fn [coll & xs]\n   921\t                  (register-lineage! lineage coll)\n   922\t                  (doseq [x xs] (register-lineage! lineage x))\n   923\t                  (recover-rebuilt-packet (apply conj coll xs)))\n   924\t         p-assoc (fn [m & kvs]\n   925\t                   (register-lineage! lineage m)\n   926\t                   (recover-rebuilt-packet (apply assoc m kvs)))\n   927\t         p-get (fn\n   928\t                 ([m k]\n   929\t                  (register-lineage! lineage m)\n   930\t                  (recover-packet (get m k)))\n   931\t                 ([m k not-found]\n   932\t                  (register-lineage! lineage m)\n   933\t                  (recover-packet (get m k not-found))))\n   934\t         p-vec (fn [coll]\n   935\t                 (register-lineage! lineage coll)\n   936\t                 (recover-rebuilt-packet (vec coll)))]\n   937\t     (merge\n   938\t       (dissoc vm/primitives 'require 'try-require 'bytes->str)\n   939\t       {'first (wrap 'first p-first),\n   940\t        'rest (wrap 'rest p-rest),\n   941\t        'conj (wrap 'conj p-conj),\n   942\t        'assoc (wrap 'assoc p-assoc),\n   943\t        'get (wrap 'get p-get),\n   944\t        'vec (wrap 'vec p-vec),\n   945\t        'yin/tag (fn [tree] (row-tag (root-row (need-packet 'yin/tag tree)))),\n   946\t        'yin/slot (fn [tree n] (slot-of tree n lineage)),\n   947\t        'yin/literal (fn [v] (literal-packet v lineage)),\n   948\t        'yin/variable (fn [sym]\n   949\t                        (when-not (symbol? sym)\n   950\t                          (throw-prelude \"yin/variable expects a symbol\" {:op 'yin/variable}))\n28:            [yin.vm.module :as module]\n50:   primitives     ; primitive operations map\n53:   modules        ; module registry value\n74:   ancestry       ; the modules installing on this task's install chain\n75:   installs       ; {module-name install}: the install children\n76:   module-stores  ; {manifest-address store}: linked modules' stores\n110:        ;; a halt leaves no module store context (yin.vm.linker.md 7.3)\n124:                     (:primitives vm)\n127:                     (:modules vm)\n150:                     (:module-stores vm)\n184:  (if (module/effect? result)\n202:                              :module/require (fn [_s _e _r]\n303:  (let [{:keys [control env k primitives modules]} state\n402:                effect (module/make-effect :stream/put {:stream stream-ref, :val val})\n423:                effect (module/make-effect :stream/close {:stream stream-ref})\n431:                effect (module/make-effect :stream/cursor {:stream stream-ref})\n439:                effect (module/make-effect :stream/next {:cursor cursor-ref})\n461:          ;; was never resolved (Rule R).\n481:        (let [value (engine/resolve-var env\n484:                                        primitives modules (:name node))]\n495:          ;; Rule R: a definition never resolves its operator. The key is\n531:        ;; A module closure's store nodes route to its module store, with\n578:                           effect (module/make-effect :stream/make {:capacity capacity})\n666:                    (if (module/effect? result)\n714:                      (if (module/effect? result)\n758:               :variable (let [v (engine/resolve-var env\n763:                                                     (:primitives vm)\n764:                                                     (:modules vm)\n1007:   the closure's node; a closure with none resolves through the\n1092:     :primitives    primitive operations map\n1095:     :modules       module registry value (see `yin.vm.module`)\n1120:                                    [:primitives :primitive-profiles\n1121:                                     :primitive-canonical-names :modules\n1150:;; module store context rides in the environment, as for the semantic VM.\n1206:  module/IModuleKernel\n1208:  (spawn-module\n1209:    [vm image {:keys [modules origin ancestry capability-secret]}]\n1211:                    {:primitives (:primitives vm),\n1215:                     :modules modules,\n1218:                                        module/link-request-resource),\n1220:                                         module/link-response-resource),\n1231:  (attach-module [vm image] (attach-image vm image vm/ast-contract))\n","exit_code":0,"status":"completed"}}
