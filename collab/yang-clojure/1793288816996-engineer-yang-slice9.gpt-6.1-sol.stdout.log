{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1712,1753p' test/yang/clojure_test.clj; cat /Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/src/latte_kernel/unparser.cljc | head -65\"","aggregated_output":"(defn run-guest-ast\n  \"Run an AST through either observer composition with a finite instruction\n   budget. Shared by the library and upstream LaTTe acceptance fixtures.\"\n  [ast modules lane step-limit]\n  (let [run-bounded (fn [machine]\n                      (loop [v machine, n 0]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) v\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n}))\n                          :else (recur (vm/step v) (inc n)))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer vm/value)))\n\n\n(defn- run-library\n  \"The raw outcome of the last of `forms`, compiled with the library\n   definitions the program needs.\"\n  ([forms] (run-library forms library-opts))\n  ([forms opts]\n   (let [walker (run-library forms opts :walker 1000000)\n         semantic (run-library forms opts :semantic 1000000)]\n     (is (= walker semantic) (str \"library lanes agree: \" (pr-str forms)))\n     walker))\n  ([forms opts lane step-limit]\n   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\n                  library-modules lane step-limit)))\n(ns latte-kernel.unparser\n  (:require [clojure.pprint :as pp]\n            [latte-kernel.utils :as u]\n            [latte-kernel.syntax :as stx]))\n\n(def +unparser-registry+ (atom {:fundamental []\n                                :standard []\n                                :user []\n                                :unparsers {}}))\n\n\n(declare unregister-unparser!)\n\n(defn register-unparser!\n  ([ident unparser] (register-unparser! :user ident unparser))\n  ([category ident unparser]\n   (when (get (:unparsers @+unparser-registry+) ident)\n     (unregister-unparser! ident))\n   (when (not (contains? #{:fundamental :standard :user} category))\n     (throw (ex-info \"Wrong unparser category.\" {:category category})))\n   (swap! +unparser-registry+ (fn [registry]\n                                (-> registry\n                                    (update category #(conj % ident))\n                                    (assoc-in [:unparsers ident] unparser))))))\n\n;; (register-unparser! :fundamental :impl (fn [term] [term false]))\n;; (register-unparser! :fundamental :impl2 (fn [term] [term false]))\n\n(defn unregister-unparser! [ident]\n  (when (not (contains? (:unparsers @+unparser-registry+) ident))\n    (throw (ex-info \"No such unparser.\" {:ident ident})))\n  (swap! +unparser-registry+ (fn [registry]\n                               {:fundamental (u/vremove #(= % ident) (:fundamental registry))\n                                :standard (u/vremove #(= % ident) (:standard registry))\n                                :user (u/vremove #(= % ident) (:standard registry))\n                                :unparsers (dissoc (:unparsers registry) ident)})))\n\n;; (unregister-unparser! :impl2)\n;; (unregister-unparser! :impl)\n\n(defn unparse-term-once [registry order term]\n  (if (seq order)\n    (let [unparser (get-in registry [:unparsers (first order)])\n          [term' modified?] (unparser term)]\n      (if modified?\n        [term' true]\n        (recur registry (rest order) term)))\n    ;; no more unparser to try\n    [term false]))\n\n(defn unparse-term-rec [registry order term]\n  (cond\n    (stx/binder? term)\n    (let [[binder [x ty] body] term\n          [ty' ty-modif?] (unparse-term-rec registry order ty)\n          [body' body-modif?] (unparse-term-rec registry order body)\n          [term' term-modif?] (unparse-term-once registry order (list binder [x ty'] body'))]\n      [term' (or ty-modif? body-modif? term-modif?)])\n    (stx/app? term)\n    (let [[term1 term2] term\n          [term1' term1-modif?] (unparse-term-rec registry order term1)\n          [term2' term2-modif?] (unparse-term-rec registry order term2)\n          [term' term-modif?] (unparse-term-once registry order [term1' term2'])]\n      [term' (or term1-modif? term2-modif? term-modif?)])\n    (stx/ascription? term)\n","exit_code":0,"status":"completed"}}
