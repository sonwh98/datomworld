{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,230p' /Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/src/latte_kernel/syntax.cljc; sed -n '1936,1957p' src/cljc/yang/clojure.cljc; sed -n '1,70p' test/yang/latte_oracle/slice7_anchors.edn; git rev-parse HEAD\"","aggregated_output":";; In `(lambda [x t] [x y])` there is one *bound occurrence* of\n;; variable `x` and one *free occurrence* of variable `y`.\n;;}\n\n(defn free-vars\n  \"Get the set of free variables of term `t`.\"\n  ([t] (free-vars {} t))\n  ([def-env t]\n   (cond\n     (variable? t) #{t}\n     (binder? t) (let [[_ [x ty] body] t]\n                   (set/union (free-vars def-env ty)\n                              (disj (free-vars def-env body) x)))\n     (app? t) (set/union (free-vars def-env (first t))\n                         (free-vars def-env (second t)))\n     (ascription? t) (let [[_ e u] t]\n                       (set/union (free-vars def-env e)\n                                  (free-vars def-env u)))\n    ;;; XXX : here the free vars should be computed inside\n    ;;; the definition if it is in a local-env (e.g. a \"pose\" proof step capturing some\n    ;;; context variable)...\n     (ref? t) (let [def-freevars (if-let [ddef (get (second def-env) (first t))]\n                                   (get ddef :term-free-vars #{})\n                                   #{})]\n                (set/union def-freevars\n                           (apply set/union (map (partial free-vars def-env) (rest t)))))\n     :else #{})))\n\n(defn vars\n  \"Get the set of free and bound variables of term `t`.\"\n  [t]\n      ([n] (kind/keyword n))\n      ([ns n] (kind/keyword ns n)))\n    (defn str\n      ([] \"\")\n      ([a] (kind/str a))\n      ([a b] (kind/str a b))\n      ([a b c] (kind/str a b c))\n      ([a b c d] (kind/str a b c d))\n      ([a b c d e] (kind/str a b c d e))\n      ([a b c d e f] (kind/str a b c d e f)))\n    (defn gensym\n      ([n] (kind/symbol (kind/str \"G__\" n)))\n      ([prefix n] (kind/symbol (kind/str prefix n))))\n    (defn coll?\n      [x]\n      (if (nil? x)\n        false\n        (= :yin.k/ok (first (yin.k/outcome-of (data/count x))))))\n    (defn vector?\n      [x]\n      (if (nil? x)\n        false\n;; Upstream A/C fixtures for slice 7. Callbacks are compiled guest source on\n;; C and evaluated as ordinary Clojure only on A. Dependency groups name the\n;; pinned upstream definitions; set/union, keys, vals and meta are library deps.\n{:dependency-groups\n {:syntax-predicates [kind? type? variable? binder? lambda? app? ascription? ref? host-constant?]\n  :variables [free-vars vars]\n  :fresh [mk-fresh]\n  :substitution [subst- rebinder subst]\n  :alpha [alpha-norm- alpha-norm]\n  :readable [readable-term- readable-term]}\n :anchors\n [{:ns latte_kernel.utils :fn map-with :deps [map-with]\n   :args [[(fn [acc x] [(+ acc x) (* acc x)]) 1 (quote [2 3 4])]\n          [(fn [acc x] [(conj acc x) (count acc)]) [] (quote (a b c))]\n          [(fn [acc x] [acc x]) :empty []]]}\n  {:ns latte_kernel.utils :fn vremove :deps [vremove]\n   :args [[(fn [x] (= x 2)) [1 2 3 2]]\n          [(fn [x] true) [1 2]]\n          [(fn [x] false) []]]}\n  {:ns latte_kernel.syntax :fn term-reduce :groups [:syntax-predicates] :deps [term-reduce]\n   :args [[{:var (fn [acc x] (conj acc x))\n            :lambda (fn [acc x] (conj acc [:lambda x]))\n            :prod (fn [acc x] (conj acc [:prod x]))\n            :app (fn [acc] (conj acc :app))\n            :ref (fn [acc x] (conj acc [:ref x]))\n            :kind (fn [acc] (conj acc :kind))\n            :type (fn [acc] (conj acc :type))}\n           [] (quote (λ [x A] (Π [y □] [x (f y ✳)])))]\n          [{} 9 (quote x)]\n          [{} 9 (quote [:latte-kernel.presyntax/host-constant 7])]\n          [{} 9 nil]]}\n  {:ns latte_kernel.syntax :fn free-vars :groups [:syntax-predicates :variables]\n   :args [[(quote x)]\n          [(quote (λ [x A] (Π [y x] [x y])))]\n          [(quote (f x (g y)))]\n          [(quote (f))]\n          [(quote [{} {f {:term-free-vars #{captured}}}]) (quote (f x))]\n          [(quote (:latte-kernel.syntax/ascribe x A))]]}\n  {:ns latte_kernel.syntax :fn vars :groups [:syntax-predicates :variables]\n   :args [[(quote (λ [x A] [x y]))]\n          [(quote (f (g x) y))]\n          [(quote (f))]\n          [(quote (:latte-kernel.syntax/ascribe x A))]\n          [(quote □)]]}\n  {:ns latte_kernel.syntax :fn subst :groups [:syntax-predicates :variables :fresh :substitution]\n   :args [[(quote x) (quote {x y})]\n          [(quote (λ [x A] [x y])) (quote {y x})]\n          [(quote (f x (g y))) (quote {x [a b], y z})]\n          [(quote (:latte-kernel.syntax/ascribe x A)) (quote {x y})]\n          [(quote (Π [x A] (λ [y A] [x z]))) (quote {z y}) (quote #{y y'})]]}\n  {:ns latte_kernel.syntax :fn alpha-norm :groups [:syntax-predicates :alpha]\n   :args [[(quote x)]\n          [(quote (λ [x A] (Π [y x] [x y])))]\n          [(quote (f (λ [x A] x) y))]\n          [(quote (:latte-kernel.syntax/ascribe [x y] A))]]}\n  {:ns latte_kernel.syntax :fn readable-term :groups [:syntax-predicates :variables :fresh :readable]\n   :args [[(quote (λ [^{:name x} _1 A] [_1 y]))]\n          [(quote (λ [^{:name x} _1 A] (λ [^{:name x} _2 A] [_1 _2])))]\n          [(quote (λ [^{:name x} _1 A] [_1 x]))]\n          [(quote (f (λ [^{:name x} _1 A] _1) y))]\n          [(quote (:latte-kernel.syntax/ascribe x A))]]}]}\nf74f2cecccfc54813671555b15e39d254debd2d9\n","exit_code":0,"status":"completed"}}
