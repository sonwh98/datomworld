l.norm/beta-eq? env [] '[(λ [x ✳] x) y] 'y)}\n  {:id :beta-eq-false :negative? true :call (latte-kernel.norm/beta-eq? 'x 'y)}\n  {:id :beta-eq-three-arity :call (latte-kernel.norm/beta-eq? env 'x 'x)}\n  {:id :typing-type :call (latte-kernel.typing/type-of-term env [] '✳)}\n  {:id :typing-lambda :call (latte-kernel.typing/type-of-term env '[[A ✳]] '(λ [x A] x))}\n  {:id :typing-unknown :negative? true :call (latte-kernel.typing/type-of-term env [] 'x)}\n  {:id :typing-kind :negative? true :call (latte-kernel.typing/type-of-term env [] '□)}\n  {:id :type-of-valid :call (latte-kernel.typing/type-of '✳)}\n  {:id :type-of-context :call (latte-kernel.typing/type-of '[[A ✳] [x A]] 'x)}\n  {:id :type-of-invalid :negative? true :call (latte-kernel.typing/type-of env [] 'x)}\n  {:id :type-check-valid :call (latte-kernel.typing/type-check? env '[[A ✳] [x A]] 'x 'A)}\n  {:id :type-check-wrong :negative? true :call (latte-kernel.typing/type-check? env '[[A ✳] [x A]] 'x '✳)}\n  {:id :type-check-unbound :negative? true :call (latte-kernel.typing/type-check? env [] 'x '✳)}\n  {:id :compile-proof :call (latte-kernel.proof/compile-proof '[[:qed (lambda [A :type] (lambda [x A] x)) {}]])}\n  {:id :compile-assume :call (latte-kernel.proof/compile-proof '[:type] '[[:assume {} [A _] [:have p _ (lambda [x A] x) {}]] [:qed p {}]])}\n  {:id :compile-malformed :negative? true :call (latte-kernel.proof/compile-proof '[42])}\n  {:id :compile-unknown :negative? true :call (latte-kernel.proof/compile-proof '[[:unknown {}]])}\n  {:id :elab-accepted :project-proof? true\n   :call (latte-kernel.proof/elab-proof env [] '[[:qed (lambda [A :type] (lambda [x A] x)) {}]])}\n  {:id :elab-rejected :negative? true :project-proof? true :call (latte-kernel.proof/elab-proof env [] '[[:qed missing {}]])}\n  {:id :elab-incomplete :negative? true :project-proof? true :call (latte-kernel.proof/elab-proof env [] '[])}\n  {:id :elab-after-qed :negative? true :project-proof? true\n   :call (latte-kernel.proof/elab-proof env [] '[[:qed (lambda [A :type] (lambda [x A] x)) {}] [:qed missing {}]])}\n  {:id :check-accepted :call (latte-kernel.proof/check-proof env [] 'identity '(Π [A ✳] (Π [x A] A)) '[[:qed (lambda [A :type] (lambda [x A] x)) {}]])}\n  {:id :check-rejected :negative? true :call (latte-kernel.proof/check-proof env [] 'wrong '(Π [A ✳] A) '[[:qed (lambda [A :type] (lambda [x A] x)) {}]])}\n  {:id :check-incomplete :negative? true :call (latte-kernel.proof/check-proof env [] 'unfinished '✳ '[])}\n  {:id :check-after-qed :negative? true :call (latte-kernel.proof/check-proof env [] 'late '✳ '[[:qed (lambda [A :type] (lambda [x A] x)) {}] [:qed missing {}]])}\n  {:id :implicit-typed-closure\n   :definitions [(latte-kernel.defenv/->Implicit 'i (fn [kernel ctx typed] (first typed)))]\n   :call (latte-kernel.typing/type-of-term env '[[A ✳] [x A]] '(i x))}\n  {:id :implicit-throwing-closure :negative? true\n   :definitions [(latte-kernel.defenv/->Implicit 'i (fn [kernel ctx typed] (throw (ex-info \\\"extension failed\\\" {:extra 7}))))]\n   :call (latte-kernel.typing/type-of-term env '[[A ✳] [x A]] '(i x))}\n  {:id :parse-to-normalize-to-type\n   :call (let [t (latte-kernel.presyntax/parse env '((lambda [x :type] x) :type))\n               n (latte-kernel.norm/normalize env [] t)]\n           [n (latte-kernel.typing/type-of-term env [] n)])}\n  {:id :unparser-guest-closure :mode :unparser\n   :extension (fn [t] (if (= t 'x) ['shown true] [t false]))\n   :term (λ [z ✳] [z x])}]}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
