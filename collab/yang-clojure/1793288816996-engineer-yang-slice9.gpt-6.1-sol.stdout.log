java \"OpenJDK 17.0.18\"}\n :executions {:a :original-upstream-clojure\n              :b :explicit-context-source-clojure\n              :c [:walker :semantic]}\n :source \"yang/latte_oracle/context.edn\"\n :sequences \"yang/latte_oracle/slice8_sequences.edn\"\n :fixtures [test-oracle-slice8-context-isolation\n            test-oracle-slice8-definition-kinds-and-delta\n            test-oracle-slice8-registry-sequences\n            test-oracle-slice8-opacity-propagation\n            test-oracle-slice8-shared-implicit-installation\n            test-oracle-slice8-context-reconstruction\n            test-oracle-slice8-admission\n            test-oracle-slice8-implicit-delta-errors\n            test-oracle-slice8-upstream-proof-loop]\n :new-anchors [latte-kernel.defenv/fetch-definition\n               latte-kernel.defenv/qualify-def\n               latte-kernel.nbe/delta-reduction\n               latte-kernel.norm/delta-reduction\n               latte-kernel.typing/unfold-implicit\n               latte-kernel.norm/install-unfold-implicit!\n               latte-kernel.unparser/register-unparser!\n               latte-kernel.unparser/unregister-unparser!\n               latte-kernel.unparser/install-fundamental-unparsers!\n               latte-kernel.unparser/unparse\n               latte-kernel.proof/elab-opaque\n               latte-kernel.proof/elab-transparent\n               latte-kernel.proof/elab-proof]\n :records [Definition Theorem Axiom Notation Implicit]\n :comparisons [:outcome-tags :values :record-kinds-and-fields\n               :collection-families :domain-metadata :registry-snapshots\n               :opacity-snapshots :implicit-error-data]\n :portability-gates [:no-host-namespace-or-var-exports :free-symbol-admission\n                     :plain-source-and-ast :host-callback-literal-refusal\n                     :code-row-reconstruction-both-lanes\n                     :live-closure-registry-jing-ucf-round-trip]\n :scope {:proof-steps [:opaque :transparent :