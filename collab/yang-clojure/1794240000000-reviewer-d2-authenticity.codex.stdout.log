0)\ntest/yang/clojure_test.clj:2025:         semantic (run-library forms opts :semantic 1000000)]\ntest/yang/clojure_test.clj:2283:                        library-opts lane 1000000))))\ntest/yang/clojure_test.clj:2297:               library-opts lane 1000000)))))\ntest/yang/clojure_test.clj:2312:    (is (= [:yin.k/ok expected] (run-library [form] library-opts lane 1000000))))\ntest/yang/clojure_test.clj:2328:             library-opts lane 1000000))))\ntest/yang/clojure_test.clj:2341:                          library-opts lane 1000000))\ntest/yang/clojure_test.clj:2348:                      library-opts lane 1000000)]\ntest/yang/clojure_test.clj:2356:                            library-opts lane 1000000)]\ntest/yang/clojure_test.clj:2364:                              library-opts lane 1000000)]\ntest/yang/clojure_test.clj:2373:                       library-opts lane 1000000)]\ntest/yang/clojure_test.clj:2383:                              library-opts lane 1000000)]\n","exit_code":0,"status":"completed"}}
