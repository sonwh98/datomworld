failure\n2170\t                     (some #(= :blocked (:status %)) [a b walker semantic]) :blocked\n2171\t                     deviation :recorded-deviation\n2172\t                     :else :mismatch)]\n2173\t    {:id (:id fixture) :mode (:mode fixture) :negative? (boolean (:negative? fixture)) :status status\n2174\t     :recorded-deviation deviation\n2175\t     :recorded-upstream-failure upstream-failure\n2176\t     :dependency-of (:dependency-of fixture)\n2177\t     :call (or (:call fixture) (kernel-c-program fixture))\n2178\t     :adapted-call (:guest-call fixture)\n2179\t     :agreement {:a-b (and (= :completed (:status a) (:status b)) (= (:outcome a) (:outcome b)))\n2180\t                 :a-c-walker (and (= :completed (:status a) (:status walker))\n2181\t                                  (agrees? (:outcome a) (:outcome walker)))\n2182\t                 :a-c-semantic (and (= :completed (:status a) (:status semantic))\n2183\t                                    (agrees? (:outcome a) (:outcome semantic)))\n2184\t                 :c-lanes (and (= :completed (:status walker) (:status semantic))\n2185\t                               (= (:outcome walker) (:outcome semantic)))}\n2186\t     :a a :b b :c-walker walker :c-semantic semantic\n2187\t     :included-functions (mapv second (kernel-closure (kernel-c-program fixture)))}))\n2188\t\n2189\t\n2190\t(deftest test-kernel-unused-arity-execution\n2191\t  (let [fixture (first (filter #(= :parse-to-normalize-to-type (:id %)) (:fixtures kernel-gate-corpus)))\n2192\t        fname 'gate-presyntax-parse\n2193\t        source (get kernel-sources fname)\n2194\t        ;; Preserve parse/2; poison the uncalled parse/1 body in memory.\n2195\t        poisoned (list* 'defn fname\n2196\t                        (map (fn [arity]\n2197\t                               (if (= 1 (count (first arity)))\n2198\t                                 (list (first arity) '(throw (ex-info \"Uncalled parse/1 entered\" {})))\n2199\t                    