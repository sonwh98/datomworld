                                  (assoc-in observed [1 :id] :unnamed-integration))))))\n2071\t    (doseq [lane [:c-walker :c-semantic]]\n2072\t      (is (= [:unexercised :unexercised :unexercised]\n2073\t             (mapv :exercise (kernel-exercise-entries inventory [fixture]\n2074\t                                                      (mapv #(dissoc % lane) rows))))\n2075\t          \"Both C lanes must demonstrate the exact arity\")))\n2076\t  (let [script (vector [:qed '(lambda [A :type] (lambda [x A] x)) {}] [:qed 'missing {}])\n2077\t        declared-call (get-in kernel-declarations [:portability :elab-after-qed :call])\n2078\t        fixture {:id :elab-after-qed :call declared-call}]\n2079\t    (is (= (vec (:script (get-in kernel-declarations [:portability :elab-after-qed]))) (vec script))\n2080\t        \"The controls model the declared script exactly\")\n2081\t    (let [a {:status :completed\n2082\t             :outcome {:thrown {:message \"Wrong proof script: proof steps after qed.\"\n2083\t                                :data {:script script\n2084\t                                       :meta {:nonportable-host-value (str (class clojure.core/meta))}}}}}\n2085\t          descriptor {:yang.call/entry (values/closure nil {})\n2086\t                      :clj/type :function\n2087\t                      :clj/outcomes? true\n2088\t                      :clj/admission (values/closure nil {})}\n2089\t          c-with (fn [meta]\n2090\t                   {:status :completed\n2091\t                    :outcome [:yin.k/error {:yin.k/message \"Wrong proof script: proof steps after qed.\"\n2092\t                                            :yin.k/data {:script script :meta meta}}]})]\n2093\t      ;; Both representations the reconciled pipeline actually produces.\n2094\t      (is (some? (kernel-host-value-deviation fixture a a\n2095\t                                             (c-with (values/closure nil {})) (c-with (values/closure nil {})))))\n2096\t      (is (some?