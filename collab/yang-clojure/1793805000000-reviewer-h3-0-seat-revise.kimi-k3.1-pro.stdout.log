{"role":"tool","tool_call_id":"tool_jpK7TmiaKdJpn2IqVEKZelZi","content":"1925\t       :missing-dependency (when (and (empty? direct) (empty? integration))\n1926\t                             (get kernel-unexercised-reasons [symbol n]\n1927\t                                  \"No passing direct fixture or named integration records this exact arity in both C lanes.\"))})))\n1928\t\n1929\t\n1930\t(def ^:private kernel-declarations\n1931\t  \"The declared dispositions: explicit, versioned input to classification.\n1932\t   Generated evidence is never their source of truth; provenance is in-file.\n1933\t   A declaration whose revalidation guards fail leaves its row a blocker,\n1934\t   not a deviation.\"\n1935\t  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_declarations.edn\"))))\n1936\t\n1937\t(defn- kernel-callable-descriptor?\n1938\t  \"True when `value` is the shape of the admitted common-call descriptor the\n1939\t   reconciled compiler publishes for a guest closure: a true function-type\n1940\t   marker, an entry that is a minted closure, and an admission witness.\n1941\t   Structurally invalid shapes - a bare `{:type :closure}` map, a scalar or\n1942\t   missing entry, a missing or non-closure witness, an outcomes marker that\n1943\t   is missing or false - fail. Descriptor AUTHENTICITY (that the witness is\n1944\t   this compiler's own mint, not a copy) is the compiler's admission check\n1945\t   upstream of the outcome; this predicate is the test-side structural\n1946\t   half, and the payload/message/call guards around it carry revalidation.\"\n1947\t  [value]\n1948\t  (and (map? value)\n1949\t       (= :function (:clj/type value))\n1950\t       (true? (:clj/outcomes? value))\n1951\t       (values/closure? (get value :yang.call/entry))\n1952\t       (values/closure? (get value :clj/admission))))\n1953\t\n1954\t(defn- kernel-host-value-deviation\n1955\t  [fixture a b walker semantic]\n1956\t  ;; Disposition only: keep every original comparison and all four outcomes.\n1957\t  ;; A new failure outside this exact host-value boundary remains a mismatch.\n1958\t  ;; The declared call, boundary, upstream value and reason come from the\n1959\t  ;; versioned declarations file; the guards revalidate the live execution\n1960\t  ;; against the declaration - the pinned call, the declared message and\n1961\t  ;; script - so a changed execution cannot ride a copied declaration.\n1962\t  (let [id (:id fixture)\n1963\t        declared (get-in kernel-declarations [:portability id])]\n1964\t    (when (and declared\n1965\t               (contains? #{:elab-after-qed :check-after-qed} id)\n1966\t               (= (:call fixture) (:call declared))\n1967\t               (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n1968\t               (= (:outcome a) (:outcome b))\n1969\t               (= (get-in a [:outcome :thrown :data :meta])\n1970\t                  {:nonportable-host-value (str (class clojure.core/meta))})\n1971\t               ;; The declaration must describe THIS failure: same message and\n1972\t               ;; same script (top-level sequential shape normalized), or the\n1973\t               ;; guard fails and the row stays a blocker.\n1974\t               (= (:message declared) (get-in a [:outcome :thrown :message]))\n1975\t               (= (vec (:script declared))\n1976\t                  (vec (get-in a [:outcome :thrown :data :script])))\n1977\t               (every? (fn [c]\n1978\t                         (and (= :yin.k/error (first (:outcome c)))\n1979\t                              (= (get-in a [:outcome :thrown :message])\n1980\t                                 (get-in c [:outcome 1 :yin.k/message]))\n1981\t                              (= (dissoc (get-in a [:outcome :thrown :data]) :meta)\n1982\t                                 (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta))\n1983\t                              (= (result-shape (dissoc (get-in a [:outcome :thrown :data]) :meta))\n1984\t                                 (result-shape (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta)))\n1985\t                              (let [meta (get-in c [:outcome 1 :yin.k/data :meta])]\n1986\t                                ;; Both representations the pipeline actually\n1987\t                                ;; produces: a pre-adoption raw closure, or the\n1988\t                                ;; admitted §8.10 descriptor. Anything else -\n1989\t                                ;; including an invented `{:type :closure}` map -\n1990\t                                ;; fails.\n1991\t                                (or (values/closure? meta)\n1992\t                                    (kernel-callable-descriptor? meta)))))\n1993\t                       [walker semantic]))\n1994\t      {:boundary (:boundary declared)\n1995\t       :upstream-value (:upstream-value declared)\n1996\t       :evidence {:file \"slice9_evidence.edn\" :fixture-id id\n1997\t                  :path [:a :outcome :thrown :data :meta]}\n1998\t       :reason (:reason declared)})))\n1999\t\n2000\t\n2001\t(defn- kernel-upstream-failure\n2002\t  \"Disposition for two pinned upstream failures. The declared boundary,\n2003\t   reason and upstream revision come from the versioned declarations file;\n2004\t   the guards pin the original call and every observed boundary. A new\n2005\t   failure must still block the gate.\"\n2006\t  [fixture a b walker semantic]\n2007\t  (let [declared (get-in kernel-declarations [:upstream-failures (:id fixture)])\n2008\t        completed-c? (= :completed (:status walker) (:status semantic))\n2009\t        c (:outcome walker)\n2010\t        same-c? (= c (:outcome semantic))\n2011\t        unbound-message \"Pinned upstream declaration has no definition\"\n2012\t        unbound-data {:refusal :upstream-unbound :binding 'latte-kernel.typing/type-of-ascribe}\n2013\t        failure\n2014\t        (when (and declared completed-c? same-c?)\n2015\t          (case (: