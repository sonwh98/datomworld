is the loader host composition\n   hands to `dao.stream.observer/run-on-stream` alongside\n   `engine/ready-for-ingress?` and the VM's runner.\n\n   `contract` is required: the batch's stamp, compared with\n   `vm/ast-contract` before anything else (`:contract-missing`,\n   `:contract-mismatch`). The reconstructed tree is then validated whole\n   against Rule R. A fresh-code producer supplies the current constant.\"\n  [^ASTWalkerVM vm datoms contract]\n  (vm/check-contract! vm/ast-contract contract)\n  (let [{:keys [ast bundled?]} (provenance/mark-bundled-calls (vm/datoms->ast datoms))]\n    (refuse-reserved-ast! ast)\n    (assoc vm\n           :bundled-provenance? (or bundled? (:bundled-provenance? vm))\n           :program ast\n           :control ast\n           :halted? false\n           :blocked? false\n           :value nil)))\n              (-> vm\n                  (vm-load-program (vm/ast->datoms ast) vm/ast-contract)\n                  (vm/run))\n              (vm/run vm))]\n    (engine/restore-initial-env initial-env res)))\n\n\n(extend-type ASTWalkerVM\n  vm/IVM\n  (step [vm]\n    (telemetry/emit-snapshot\n      (if (engine/ready-for-ingress? vm) vm (vm-step vm))\n      :step))\n  (run [vm] (ffi/maybe-run vm ast-walker-run-scheduler))\n  (eval [vm ast] (vm-eval vm ast))\n  (reset [vm] (vm-reset vm))\n  (halted? [vm] (vm-halted? vm))\n  (blocked? [vm] (vm-blocked? vm))\n  (value [vm] (vm-value vm))\n  vm/IVMState\n  (control [vm] (:control vm))\n  (environment [vm] (:env vm))\n  (store [vm] (:store vm))\n  (continuation [vm]\n    (when-let [k-head (:k vm)]\n      (loop [k k-head\n             acc []]\n        (if (nil? k) acc (recur (:next k) (conj acc k)))))))\n\n  \"Host module names read by the guest definitions.\"\n  '#{cell/get cell/authentic? data/callable? data/contains? data/count\n     data/map? data/nth data/string? data/vector?})\n\n\n(def definitions\n  \"The one ordered definition list used by both emitters.\"\n  '[;; Descriptor projection remains structural after callable admission,\n    ;; with one ruling-of-record refinement: a `:cell-ref`-shaped map is\n    ;; dereferenced only when the heap authenticates it (`cell/authentic?`,\n    ;; the issuer's own answer). A map that imitates the reference language\n    ;; is data, so it projects to itself and its fate follows the ordinary\n    ;; descriptor rules, exactly as any other map's would.\n    [yang.call/_descriptor\n     (fn [callable]\n       (if (data/map? callable)\n         (if (if (= (get callable :type) :cell-ref)\n               (cell/authentic? callable)\n               false)\n           (cell/get callable)\n           callable)\n         nil))]\n    [yang.call/entry\n     (fn [callable]\n       (get (yang.call/_descriptor callable) :yang.call/entry))]\n    [yang.call/eligible?\n     (fn [callable]\n       (let [descriptor (yang.call/_descriptor callable)]\n         (if (nil? (yang.call/entry callable))\n           false\n           (if (data/contains? descriptor :yang.call/eligible?)\n             ((get descriptor :yang.call/eligible?) callable)\n             true))))]\n    [yang.call/invocation\n     (fn [callee positional named raise]\n       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/invocation-with\n     (fn [callee positional named raise options]\n       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/_pair?\n     (fn [pair]\n       (if (data/vector? pair)\n         (= (data/count pair) 2)\n         false))]\n    [yang.call/_named-pairs?\n     (fn [pairs index]\n       (if (= index (data/count pairs))\n         true\n         (let [pair (data/nth pairs index)]\n           (if (yang.call/_pair? pair)\n             (if (data/string? (data/nth pair 0))\n               (yang.call/_named-pairs? pairs (+ index 1))\n               false)\n             false))))]\n    [yang.call/valid-invocation?\n     (fn [invocation]\n       (if (data/map? invocation)\n         (if (data/contains? invocation :yang.call/callee)\n           (if (data/contains? invocation :yang.call/positional)\n             (if (data/contains? invocation :yang.call/named)\n               (if (data/contains? invocation :yang.call/raise)\n                 (if (data/vector? (get invocation :yang.call/positional))\n                   (if (data/vector? (get invocation :yang.call/named))\n                     (yang.call/_named-pairs?\n                       (get invocation :yang.call/named) 0)\n                     false)\n                   false)\n                 false)\n               false)\n             false)\n           false)\n         false))]\n    [yang.call/condition\n     (fn [reason evidence]\n       (assoc (assoc {} :yang.call/reason reason)\n              :yang.call/data evidence))]\n    [yang.call/thrown\n     (fn [value]\n       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n              :yang.call/value value))]\n    [yang.call/transfer\n     (fn [raise condition]\n       (raise condition))]\n    [yang.call/invoke\n     (fn [callable positional named raise]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation callable positional named raise)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]\n    [yang.call/invoke-with\n     (fn [callable positional named raise options]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation-with\n                          callable positional named raise options)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]])\n\n\n(def ^:private public-exports\n  '#{entry eligible? invocation invocation-with valid-invocation? condition\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.lat