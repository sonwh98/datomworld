        'clj/invoke-callable))\n  1242\t          invoke (u/app dispatch callee arguments (u/lit []))\n  1243\t          ;; A descriptor-shaped map must pass callable admission. Ordinary\n  1244\t          ;; data invocation is the library invoker's responsibility.\n  1245\t          routed (if (::invoker env)\n  1246\t                   (u/if-node\n  1247\t                     (u/if-node (u/app (u/v 'data/map?) callee)\n  1248\t                                (u/if-node (u/app (u/v 'data/contains?) callee\n  1249\t                                                  (u/lit :yang.call/entry))\n  1250\t                                           (u/lit true)\n  1251\t                                           (u/if-node (cell-ref-shaped-node callee)\n  1252\t                                                      (u/app (u/v 'cell/authentic?) callee)\n  1253\t                                                      (u/lit false)))\n  1254\t                                (u/lit false))\n  1255\t                     invoke\n","exit_code":0,"status":"completed"}}
