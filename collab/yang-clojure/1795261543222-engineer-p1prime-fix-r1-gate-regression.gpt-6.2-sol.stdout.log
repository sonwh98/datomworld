)))\n    nil\n    (or (prelude-admission/host-declaration registry n)\n        (throw (ex-info \"the module reads an undeclared name\"\n                        {refusal-key refusal, :name n})))))\n\n\n(defn free-primitives\n  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n  [refusal-key refusal registry covered ast]\n  (into {}\n        (keep (partial declare-free-name refusal-key refusal registry covered))\n        (prelude/free-name-vec ast)))\n\n\n(defn module-spec\n  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n   ({module-symbol address}). A free name under a required module is covered\n   by it; any other is declared as `declare-free-name` does.\"\n  [refusal-key refusal registry\n   {:keys [name ast exports runtime-name runtime-address deps]}]\n  (let [requires (into {runtime-name runtime-address} deps)]\n    {:name name,\n     :ast ast,\n     :exports exports,\n     :requires requires,\n     :primitives (free-primitives refusal-key refusal registry\n                                  (set (keys requires)) ast)}))\n\n\n(defn alias-spec\n  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n   `body-key` exports.\"\n  [name exports require-profile bundle-name spec-key body-key]\n  {:name name,\n   :exports exports,\n   :primitives {'require require-profile},\n   :ast (module-tree\n          [(require-node bundle-name)\n           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n\n\n(defn scc-module-specs\n  \"The SCC publication shape: the `bundle` spec first, then the member alias\n   specs (each `alias-spec`'s output) in member order.\"\n  [bundle aliases]\n  (into [bundle] aliases))\nKERNEL-FIXTURE :check-accepted :pass\nKERNEL-FIXTURE :check-assume-have-discharge :pass\nKERNEL-FIXTURE :check-rejected :pass\nKERNEL-FIXTURE :check-incomplete :pass\nKERNEL-FIXTURE :check-after-qed :recorded-deviation\nKERNEL-FIXTURE :h3-2-elab-inferred-anonymous :pass\n02:43 +43: /Users/sto/workspace/dw-p1prime/build/cljd-agg/shard_0_test.dart: null yang.clojure-callsite-test/canonical-invariance-test\n02:43 +44: /Users/sto/workspace/dw-p1prime/build/cljd-agg/shard_0_test.dart: null yang.clojure-callsite-test/repl-call-site-surface-test\n02:43 +45: /Users/sto/workspace/dw-p1prime/build/cljd-agg/shard_0_test.dart: null yang.clojure-callsite-test/publisher-scope-admission-identity-test\n02:44 +46: /Users/sto/workspace/dw-p1prime/build/cljd-agg/shard_0_test.dart: null yang.clojure-callsite-test/safepoint-independence-test\n02:44 +47: /Users/sto/workspace/dw-p1prime/build/cljd-agg/shard_0_test.dart: null yang.clojure-callsite-test/unclaimed-after-claimed-test\n02:44 +48: /Users/sto/workspace/dw-p1prime/build/cljd-agg/shard_0_test.dart: null yang.clojure-callsite-test/published-instruction-provenance-test\n02:44 +49: All tests passed!\n    dao.stream.observer$run_on_stream.invoke (observer.cljc:217)\n    yang.clojure_test$run_guest_machine.invokeStatic (clojure_test.clj:2482)\n    yang.clojure_test$run_guest_machine.invoke (clojure_test.clj:2458)\n    yang.clojure_test$run_guest_ast.invokeStatic (clojure_test.clj:2525)\n    yang.clojure_test$run_guest_ast.invoke (clojure_test.clj:2522)\n    yang","exit_code":0,"status":"completed"}}
