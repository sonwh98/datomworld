                ops (rest (:operands ctor))\n                      labels (mapv (fn [op]\n                                     (cond\n                                       (walk/postwalk\n                                         (fn [x] (cond-> x)) op) nil))\n                                   ops)]\n                  labels))\n        ]\n    (println :probe-stub)))\n'''\n# This sketch is getting unwieldy — write a focused probe reusing the\n# namespace-internal helpers by duplicating the tiny runner, walker only.\nsrc2 = '''(ns fixorder-tmp-diag-test\n  (:require [clojure.test :refer [deftest is]]\n            [clojure.walk :as walk]\n            [yang.clojure :as yang]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]\n            [yin.vm.test-utils :as tu]))\n\n(defn- ctor-of\n  [ast]\n  (let [acc (atom [])]\n    (walk/postwalk\n      (fn [n]\n        (when (and (map? n)\n                   (= :application (:type n))\n                   (= (quote conj) (get-in n [:operator :name]))\n                   (= #{} (get-in n [:operands 0 :value])))\n          (swap! acc conj n))\n        n)\n      ast)\n    @acc))\n\n(defn- operand-for\n  [ctor needle-value]\n  (some (fn [op]\n          (when (some (fn [x] (and (map? x)\n                                   (= :literal (:type x))\n                                   (= needle-value (:value x))))\n                      (tree-seq coll? seq op))\n            op))\n        (rest (:operands ctor))))\n\n(defn- walker-log\n  [ast env]\n  (let [log (atom [])\n        env (assoc env Qtap (fn [x] (swap! log conj x) x))\n        vm (vm/eval (tu/create-vm {:primitives vm/primitives\n                                   :modules (module/default-registry)\n                                   :env env}) ast)]\n    [@log (try (vm/value vm) (catch Exception e ::raised))))\n\n(deftest discrimination-probe-test\n  (let [n 1\n        env {Qn n}\n        old-left (list Qtap (list Q- Qn 1))\n        old-right (list Qtap (list Q- 1 Qn))\n        new-left (list Qdo (list Qtap :left) (list Q- Qn 1))\n        new-right (list Qdo (list Qtap :right) (list Q- 1 Qn))\n        probe (fn [left right]\n                (let [ast (yang/compile (into #{} [(list Qtap :s1) left right 2]))\n                      ctor (first (ctor-of ast))\n                      needle (fn [node]\n                               (some (fn [x]\n                                       (when (and (map? x)\n                                                  (= :literal (:type x))\n                                                  (keyword? (:value x)))\n                                         (:value x)))\n                                     (tree-seq coll? seq node)))\n                      [a b] (rest (:operands ctor))\n                      ;; find the two colliding operands: those whose value\n                      ;; computation hits tap with a non-:s1 arg, i.e. the\n                      ;; ones that are not the :s1 tapper and not literal 2\n                      colliding (filterv (fn [op]\n                                           (let [lbl (needle op)]\n                                             (and lbl (not= :s1 lbl))))\n                                         (rest (:operands ctor)))\n                      l (first colliding)\n                      r (second colliding)\n                      swap-ast (walk/postwalk-replace {l r, r l} ast)\n                      dup-ast (walk/postwalk-replace {r l} ast)]\n                  {:original (walker-log ast env)\n                   :swap (walker-log swap-ast env)\n                   :dup (walker-log dup-ast env)}))]\n    (println :r3-labels (pr-str (probe old-left old-right)))\n    (println :r4-labels (pr-str (probe new-left new-right)))))\n'''\nsrc2 = src2.replace(\"Qtap\", Q + \"tap\").replace(\"Qdo\", Q + \"do\").replace(\"Q-\", Q + \"-\").replace(\"Qn\", Q + \"n\")\nPath(\"test/fixorder_tmp_diag_test.cljc\").write_text(src2)\nprint(\"probe written\")\nPYEOF\nclojure 