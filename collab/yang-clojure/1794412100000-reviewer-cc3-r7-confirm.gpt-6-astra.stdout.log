{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '240,330p' bb.edn; sed -n '402,430p' bb.edn; rg -n 'defn.*sub|test:sub:cljs|build:yin-repl-peer|ns-regexp' src/dev/tasks.clj src/dev/test_sub* 2>/dev/null\"","aggregated_output":"                         \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" \\\"$@\\\"\" \"jolt\"\n                         *command-line-args*)))}\n\n  build:yin-repl-node\n  {:doc \"Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js\"\n   ;; The Node lanes (test:cljs and its variants) depend on this task, so the\n   ;; generated JavaScript parser reaches them through it.\n   :depends [deps:npm gen:antlr]\n   ;; yin.repl.dht-process-test spawns it as the JVM-to-Node reader of\n   ;; DHT epic S5, a required leg: a missing build fails that test.\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl\")}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; The Dart lanes depend on this task, so the generated Dart parser\n   ;; reaches them through it.\n   :depends [gen:antlr]\n   ;; Process B of the R5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM\n   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n   ;; `bb test:cljs` without it skips those tests with a printed notice\n   ;; rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  build:demo\n  {:doc \"Release-compile the browser demo (shadow-cljs build :demo) to public/js/main.js\"\n   ;; The demo pulls in yang.python.antlr.parser, whose JavaScript\n   ;; recognizers live in build/antlr/python3/js (a :cljs classpath root),\n   ;; so a clean checkout generates them before compiling.\n   :depends [deps:npm gen:antlr]\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli release demo\")}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  check:node-discovery\n  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\n   :task (shell {:shutdown nil} \"bb src/dev/check_node_discovery.clj\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [check:node-discovery build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:antlr]\n                :task (shell \"clojure -M:test\")}\n\n  test:all:cljs {:doc 