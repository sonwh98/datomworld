t(def identity-name \"str-3\")\n    23\t\n    24\t\n    25\t(def jing-payload\n    26\t  \"The Jing payload whose canonical bytes cross the wire wrapped.\"\n    27\t  {:jing/probe [1 \"two\" :three]})\n    28\t\n    29\t\n    76\t(defn values\n    77\t  \"The corpus as the served stream carries it for `profile`: the shared\n    78\t   values, the profile's extras, then the wrapped Jing payload.\"\n    79\t  [profile]\n    80\t  (conj (into plain (if (= profile cbor/profile)\n    81\t                      (cbor-extra)\n    82\t                      transit-extra))\n    83\t        (jing-stream/wrap-payload profile jing-payload)))\n    84\t\n    85\t\n245:   ;; The Node lanes (test:cljs and its variants) depend on this task, so the\n264:   ;; `bb test:cljs` without it skips those tests with a printed notice\n284:  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\n287:  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n325:                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\n339:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n414:  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\nsrc/clj/dao/stream/ws/jvm.clj:316:                      {:code :yin.repl.endpoint/upgrade-threw\nsrc/clj/dao/stream/ws/jvm.clj:334:                    {:code :yin.repl.endpoint/socket-error\nsrc/clj/dao/stream/ws/jvm.clj:370:                                  {:code :yin.repl.endpoint/subprotocol-required\nsrc/clj/dao/stream/ws/jvm.clj:386:                                                     {:code :yin.repl.endpoint/listener-error\n","exit_code":0,"statu