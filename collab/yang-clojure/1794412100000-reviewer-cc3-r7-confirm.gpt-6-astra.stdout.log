1338\t  \"The C1 side tables the session's expander retains, keyed by\n  1339\t   `[admission-origin final-root]` (`yin.vm.macro/call-site-table`\n  1340\t   custody): the retained record a session publication recovers its\n  2000\t        [state (str \"Error: program batch not ingested: \"\n  2001\t                    (name (:dao.stream/outcome append)))]\n  2002\t        (let [expanded (try\n  2003\t                         (run-expander-stage state')\n  2004\t                         (catch #?(:cljd Object\n  2005\t                                   :clj Exception\n  2006\t                                   :cljs js/Error) error\n  2007\t                           {:failed (consume-failed-round state error)}))]\n  2008\t          (if-let [failed (:failed expanded)]\n  2009\t            failed\n  2010\t            (let [[expanded {:keys [errors forwarded]}] expanded\n  2011\t                  indexed (if (pos? forwarded)\n  2012\t                            ;; commit evidence is captured BEFORE the\n  2013\t                            ;; index stage runs: the published programs\n  2014\t                            ;; and indexer as they stood, so the recorder\n  2015\t                            ;; pairs only what this round commits\n  2016\t                            (let [evidence\n  2017\t                                  {:programs-before\n  2018\t                                   (indexed-program-roots (:indexer expanded))\n  2019\t                                   :indexer-before (:indexer expanded)}]\n  2020\t                              (-> expanded\n  2021\t                                  run-index-stage\n  2022\t                                  run-ast-index-stage\n  2023\t                                  (assoc :call-site-commit-evidence evidence)\n  2024\t                                  ;; cc3 r2 item 4: this round's\n  2025\t                                  ;; provenance claims — the roots the\n  2026\t                                  ;; expander newly retained under\n  2027\t                                  ;; exactly one admission — ride the\n  2028\t                                  ;; state into the evaluator stage,\n  2029\t                                  ;; whose loader wrapper retains each\n  2030\t                                  ;; claimed packet's provenance\n  2031\t                                  (assoc :call-site-round-claims\n  2032\t                                         (let [new-entries\n  2033\t                                               (into {}\n  2034\t                                                     (remove\n  2035\t                                                       (fn [[k _]]\n  2036\t                                                         (contains?\n  2037\t                                                           (or tables-before {})\n  2038\t                                                           k)))\n  2039\t                                                     (or (call-site-tables\n  2040\t                                                           expanded)\n  2041\t                                                         {}))\n  2042\t                                               by-root\n  2043\t                                               (group-by (fn [[k _]]\n  2044\t                                                           (second k))\n  2045\t                                                         new-entries)]\n  2046\t                                           (into {}\n  2047\t                                                 (keep (fn [[root entries]]\n  2048\t                                                         (when (= 1 (count entries))\n  2049\t                                                           [root (first (ffirst entries))])))\n  2050\t                                                 by-root)))\n  2051\t                                  ((fn [s]\n  2052\t                                     (record-call-site-admissions\n  2053\t                                       tables-before s)))))\n  2054\t                            expanded)]\n  2055\t              (with-index-notice\n  2056\t                (cond\n  2057\t                  (> (ingress-gaps indexed) (ingress-gaps state'))\n  2058\t                  [(assoc indexed :ingress-loss? true)\n  2059\t                   (str \"Error: \" ingress-loss-text)]\n  2060\t\n  2061\t                  (pos? forwarded) (run-evaluation state indexed)\n  2062\t\n  2063\t                  :else [(assoc indexed :vm (:vm state))\n  2064\t                         (format-expansion-errors errors)])\n  2065\t                (when (pos? forwarded)\n  2066\t                  [(index/notice (:indexer expanded) (:indexer indexed))\n  2067\t                   (ast-index/notice (:ast-indexer indexed))])))))))))\n  2068\t\n  2069\t\n  2070\t(defn- installed-text\n   274\t(defn- write-rows\n   275\t  \"Put the rows of every committed program not yet written into the index\n   276\t   store, oldest first (yin.vm.linker.dht.md 5.1, owner decision 1: rows\n   277\t   every round), so `:yin/address` facts name content the store holds.\n   278\t   `:unwritten` holds those programs' row sets.  A put that fails stops\n   279\t   the writing: it and every later row set stay `:unwritten`, and the\n   280\t   round's failure is stage `:materialize`.  Once nothing is unwritten, a\n   281\t   `:materialize` failure is recovered and cleared.  No publication is\n   282\t   made while anything is unwritten, so a HEAD never moves over a missing\n   283\t   row.\"\n   284\t  [ix round]\n   285\t  (loop [ix ix]\n   286\t    (if-let [row-set (first (:unwritten ix))]\n   287\t      (let [failed (try (vm/materialize-tree! (:content-store ix) row-set)\n   288\t                        nil\n   289\t                        (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   290\t                          {:round round\n   291\t                           :stage :materialize\n   292\t                           :root (:root row-set)\n   293\t                           :message (ex-message e)}))]\n   294\t        (if failed\n   295\t          (assoc ix :failure failed)\n   296\t          (recur (update ix :unwritten (comp vec rest)))))\n   297\t      (cond-> (dissoc ix :unwritten)\n   298\t        (= :materialize (:stage (:failure ix))) (dissoc :failure)))))\n   299\t\n   300\t\n   549\t(defn notice\n   550\t  \"What the round from `before` to `after` must tell the user, or nil: a\n   551\t   lost indexer (the round's code was not indexed), or a new failure (the\n   552\t   round's code was not committed or its publication is not readable).\n   553\t   A failure's `:stage` is `:project`, `:transact`, `:materialize` or\n   554\t   `:publish`.\"\n   555\t  [before after]\n   556\t  (let [{:keys [stage outcome message]} (:failure after)]\n   557\t    (cond\n   558\t      (:lost? after)\n   559\t      (str \"Warning: the code index lost a program batch; this round's code\"\n   560\t           \" was not indexed, and indexing is suspended until (reset)\")\n   561\t\n   562\t      (and (= :materialize (:stage (:failure before))) (nil? (:failure after)))\n   563\t      (str \"Note: the code index caught up: rows of earlier rounds are now\"\n   564\t           \" written, and this round is published\")\n   565\t\n   566\t      (not= (:failure before) (:failure after))\n   567\t      (str \"Warning: this round's code is not in the published code index (\"\n   568\t           (name stage) \" failed\"\n   569\t           (when-let [detail (or message (some-> outcome name))]\n   570\t             (str \": \" detail))\n   571\t           \")\"))))\n(ns dao.stream.ws-project-corpus\n  \"The live wire corpus of the dao.stream.codec §7.3 bidirectional proof:\n   the §4.4 envelope corpus, each profile's own extra values, and one\n   Jing-wrapped payload, served as the toy peers' \\\"str-3\\\".\n\n   The clean fixtures are all here: the shared values, collection and\n   symbol metadata (Transit drops it on the wire, CBOR carries it, and\n   `normalize` compares what each profile promises), CBOR lists and host\n   bytes, and Transit's integral double and slash-bearing keyword.\n\n   Two baseline exceptions of §7.3 are NOT in the live corpus, because their\n   frozen outcomes are not a universal round trip and the frozen fixtures\n   (`test/fixtures/codec/*/exceptions.edn`) pin them per host instead:\n   Transit lists (the JVM Transit decoder throws on list text) and the CBOR\n   integral double `1.0` (`f93c00`: Node's decoder rejects it).\"\n  (:require [clojure.string :as str]\n            [dao.jing.stream :as jing-stream]\n            [dao.stream.cbor :as cbor])\n  #?(:cljd (:import [\"dart:typed_data\" Uint8List])))\n\n\n(def identity-name \"str-3\")\n\n\n(def jing-payload\n  \"The Jing payload whose canonical bytes cross the wire wrapped.\"\n  {:jing/probe [1 \"two\" :three]})\n\n\n(defn- octets\n  \"Host bytes of `xs`.\"\n  [xs]\n  #?(:clj (byte-array (map unchecked-byte xs))\n     :cljs (js/Uint8Array.from (clj->js xs))\n     :cljd (Uint8List.fromList (vec xs))))\n\n\n(def plain\n  \"Values both profiles carry: compared with `=` after the wire (plus the\n   profile's metadata promise, see `normalize`).\"\n  [nil true false \"\" \"hello\" \"héllo 世界\" 0 1 -1 1000000\n   9007199254740991 -9007199254740991 1.5 0.001\n   :k :a/b 'k 'a/b\n   [] [1 2 3] #{1 2 3}\n   {} {:a 1 :b [2]} {1000 \"x\" \"a\" :y}\n   {:v [1 {:s #{:x :y}} [2 3]] :n nil}\n   (with-meta [1] {:line 1})\n   (with-meta 'x {:line 1})\n   [(with-meta 'x {:line 1})]\n   {:k (with-meta 'x {:line 1})}\n   (with-meta 'y {:m (with-meta 'x {:c 2})})\n   {(with-meta [1] {:k 1}) :v}])\n\n\n(def transit-extra\n  \"Values only Transit's clean fixtures cover: an integral double and the\n   keyword whose name carries a slash (`:user/foo/bar`).\"\n  [1.0 (keyword \"user\" \"foo/bar\")])\n\n\n(defn cbor-extra\n  \"Values only CBOR's clean fixtures cover: lists, nested lists, host\n   bytes, and a reader-metadata nest.\"\n  []\n  [(list 1 2)\n   [1 (list 2 #{3})]\n   [(list 1 2) [1 2]]\n   {:v [1 {:s #{:x :y}} (list 2 3)] :n nil}\n   (octets [0 1 2 3 255])\n   (octets [])\n   {:b [(octets [222 173 190 239])]}\n   (with-meta [1 :two (with-meta 'x {:line 7 :col 9})]\n     {:reader/pos [12 34]})])\n\n\n(defn values\n  \"The corpus as the served stream carries it for `profile`: the shared\n   values, the profile's extras, then the wrapped Jing payload.\"\n  [profile]\n  (conj (into plain (if (= profile cbor/profile)\n                      (cbor-extra)\n                      transit-extra))\n        (jing-stream/wrap-payload profile jing-payload)))\n\n\n(defn- integral-double?\n  [x]\n  #?(:clj (and (double? x) (== x (Math/rint x)))\n     :cljs false\n     :cljd (and (double? x) (== x (.floorToDouble x)))))\n\n\n(defn- norm\n  \"`x` in comparable form: host bytes as octet vectors, an integral double\n   as its equal integer (the §4.4 equality rule), lists marked, and under\n   CBOR the metadata it carries kept beside the value.\"\n  [keep-meta? x]\n  (let [n #(norm keep-meta? %)\n        v (cond\n            (cbor/byte-payload? x)\n            {:octets (mapv #(bit-and 0xff %) x)}\n\n            (integral-double? x)\n            #?(:clj (long x) :cljs x :cljd (.toInt x))\n\n            (map? x) (into {} (map (fn [[k v]] [(n k) (n v)])) x)\n            (set? x) (into #{} (map n) x)\n            (vector? x) (mapv n x)\n            (seq? x) {:list (mapv n x)}\n            :else x)\n        m (when keep-meta? (meta x))]\n    (if (seq m) {:meta (n m) :value v} v)))\n\n\n(defn normalize\n  \"What a received value is compared as: Jing wrapping unwrapped to\n   octets, everything else through `norm` (CBOR keeps metadata, Transit\n   drops it on the wire so it is not compared).\"\n  [profile value]\n  (if (and (map? value) (contains? value :dao.jing/canonical-bytes))\n    {:jing-octets (mapv #(bit-and 0xff %)\n                        (jing-stream/unwrap-bytes profile value))}\n    (norm (= profile cbor/profile) value)))\n\n\n(defn canon\n  \"A canonical text of a normalized value (maps and sets in sorted order),\n   so an out-of-process driver can compare values without decoding\n   Transit.\"\n  [x]\n  (cond\n    (map? x) (str \"{\" (str/join \" \" (sort (map (fn [[k v]] (str (canon k) \" \" (canon v))) x))) \"}\")\n    (set? x) (str \"#{\" (str/join \" \" (sort (map canon x))) \"}\")\n    (vector? x) (str \"[\" (str/join \" \" (map canon x)) \"]\")\n    :else (pr-str x)))\n(ns dao.stream.ws-project-peer\n  \"The cross-host peer program of the dao.stream.remote slice-3 socket\n   proofs.\n\n   The ws channel composition (dao.stream.ws-project) was proven on one\n   JVM over real loopback sockets; the same wire spoken by two hosts is\n   a different fact, and only two operating-system processes of two\n   different runtimes can falsify it.  This namespace is a whole peer\n   program, not a fixture, in two roles over one line-oriented Transit\n   command/reply protocol on stdin/stdout:\n\n   * **Dial role** (argv carries the ws descriptor as Transit JSON text)\n     -- the dialing end of the spec's section-5 toy.  It composes one\n     dial over this host's connect seam, serves \\\"str-2\\\" (the single\n     value \\\"backward\\\", a complete history) through its own mirror, so\n     the other direction of the same connection is served by this end,\n     and on command attaches a reflection of the served identity\n     \\\"str-1\\\".  The parent observes only what this program reports.\n\n   Either role takes `--codec cbor|transit` (default transit): the wire\n   profile the peer's attacher or endpoint is composed with.  The command\n   protocol on stdin/stdout stays Transit text in both.\n\n   * **Serve role** (`--serve`) -- the accepting end of the toy behind\n     this host's listener: one endpoint, one handoff slot, the acceptor\n     composition, and \\\"str-1\\\" (\\\"hello\\\", complete history) in the\n     mirror table.  It reports the bound port and its adopted sessions.\n\n   One ticker owns the composition's cadence in either role, exactly as\n   each host's own driver does; commands only read and report.  A step\n   that throws is recorded and reported on the next probe rather than\n   silently ending the cadence.\"\n  (:require [clojure.string :as str]\n            [dao.stream :as stream]\n            [dao.stream.cbor :as cbor]\n            [dao.stream.ws-project-corpus :as corpus]\n            [dao.stream.remote :as remote]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [dao.stream.transit :as transit]\n            [dao.stream.ws :as ws]\n            [dao.stream.ws-project :as project]\n            ;; `:cljd` first: the ClojureDart host-eval pass also matches\n            ;; `:clj`, so a `:clj` branch reached first would pull a JVM-only\n            ;; namespace into the Dart build.\n            #?@(:cljd [[\"dart:async\" :as async]\n                       [\"dart:convert\" :as convert]\n                       [\"dart:core\" :as dart-core]\n                       [\"dart:io\" :as io]\n                       [dao.stream.ws.dart :as host]]\n                :clj [[dao.stream.ws.jvm :as host]]\n                :cljs [[dao.stream.ws.node :as host]]\n                :default [])))\n\n\n(def ^:private tick-millis\n  \"Cadence of this peer's own single step owner, in either role.\"\n  5)\n\n\n(def ^:private path\n  \"The one served path of the toy's endpoint.\"\n  \"/streams/toy\")\n\n\n(def ^:private admission\n  {:retention :evict-oldest :capacity 64 :value-domain :portable-values})\n\n\n(def ^:private handoff-admission\n  {:retention :evict-oldest :capacity 1 :value-domain :host-values})\n\n\n(defn- buffer\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn- newest\n  [handle]\n  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))\n\n\n(defn- served-stream\n","exit_code":0,"status":"completed"}}
