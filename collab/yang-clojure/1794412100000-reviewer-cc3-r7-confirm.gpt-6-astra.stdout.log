ket provenance requires a retained admission origin\"\n   190\t                    {:rule :call-site-admission, :admission admission})))\n   191\t  (let [root (first packet)\n   192\t        tables (:call-site-tables (:expander state))\n   193\t        rows (get tables [admission root])]\n   194\t    (when (some? rows)\n   195\t      (let [rows (vec rows)\n   196\t            proj (linearize/project-rows (macro/packet->row-set packet)\n   197\t                                         nil rows)\n   198\t            v (:vector proj)\n   199\t            sem-address (ucf/code-address v)\n   200\t            ;; each image is derived ONCE, provenance attached: the\n   201\t            ;; segment coordinate is the image own content identity\n   202\t            ;; (unchanged by provenance), patched into the rows as the\n   203\t            ;; loaders compute it\n   204\t            stack (derive/stack-image\n   205\t                    v {:call-provenance (:call-provenance proj)})\n   206\t            stack-address (dcode/image-hash (:image stack))\n   207\t            register (derive/register-image\n   208\t                       v {:call-provenance (:call-provenance proj)})\n   209\t            register-address (rcode/register-hash register)]\n   210\t        {:semantic (mapv (fn [[pc o r p]] [sem-address pc o r p])\n   211\t                         (:call-provenance proj))\n   212\t         :stack (mapv (fn [row] (assoc row 0 stack-address))\n   213\t                      (:call-provenance stack))\n   214\t         :register (mapv (fn [row] (assoc row 0 register-address))\n   215\t                         (:call-provenance register))}))))\n   216\t\n   217\t\n   218\t(defn retain-packet-call-provenance!\n   219\t  \"Persist one packet's admission-scoped call provenance (cc3 r2\n   220\t   item 4) as a side artifact in the session's content store\n   221\t   (`:index-store`, the durable `dao.jing` handle a file/DHT session\n   222\t   reopens): the relation `{:yin.vm.provenance/schema 1 :admission …\n   223\t   :root … :semantic […] :stack […] :register […]}` and a record\n   224\t   naming it, both content-addressed OUTSIDE any manifest hash.\n   225\t   Answers `{:handle record-address :relation address :admission a\n   226\t   :root r :provenance relation}` — the handle is the retrievable\n   227\t   lookup key `call-provenance-handles` carries on the session state —\n   228\t   or nil when the admission claimed nothing for the packet or the\n   229\t   session has no content store (absence, never invention).\"\n   230\t  [state packet admission]\n   231\t  (when-let [store (:index-store state)]\n   232\t    (when-let [prov (packet-call-provenance state packet admission)]\n   233\t      (let [relation {:yin.vm.provenance/schema 1\n   234\t                      :yin.vm.provenance/admission admission\n   235\t                      :yin.vm.provenance/root (first packet)\n   236\t                      :yin.vm.provenance/semantic (:semantic prov)\n   237\t                      :yin.vm.provenance/stack (:stack prov)\n   238\t                      :yin.vm.provenance/register (:register prov)}\n   239\t            relation-address (jing/materialize! store relation)\n   240\t            record {:yin.repl.call-provenance/schema 1\n   241\t                    :yin.repl.call-provenance/admission admission\n   242\t                    :yin.repl.call-provenance/root (first packet)\n   243\t                    :yin.repl.call-provenance/relation relation-address}]\n   244\t        {:handle (jing/materialize! store record)\n   245\t         :relation relation-address\n   246\t         :admission admission\n   247\t         :root (first packet)\n   248\t         :provenance prov}))))\n   249\t\n   250\t\n   251\t(defn retained-packet-call-provenance\n   252\t  \"The durable packet provenance retained under `handle` (a\n   253\t   `retain-packet-call-provenance!` record address) in `store`,\n   254\t   verified through its record linkage: `{:admission a :root r\n   255\t   :semantic […] :stack […] :register […]}`, or nil when the handle\n   256\t   names no verifying retained relation (a legacy session persisted\n   257\t   none). Works against a freshly reopened durable store: the handle\n   258\t   alone is the lookup key.\"\n   259\t  [store handle]\n   260\t  (when (jing/segment-address? handle)\n   261\t    (let [record (jing/get store handle nil)]\n   262\t      (when (and (map? record)\n   263\t                 (= 1 (:yin.repl.call-provenance/schema record))\n   264\t                 (jing/segment-address?\n   265\t                   (:yin.repl.call-provenance/relation record)))\n   266\t        (let [relation (jing/get store\n   267\t                                 (:yin.repl.call-provenance/relation record)\n   268\t                                 nil)]\n   269\t          (when (and (map? relation)\n   270\t                     (= 1 (:yin.vm.provenance/schema relation))\n   271\t                     (= (:yin.repl.call-provenance/admission record)\n   272\t                        (:yin.vm.provenance/admission relation))\n   273\t                     (= (:yin.repl.call-provenance/root record)\n   274\t                        (:yin.vm.provenance/root relation)))\n   275\t            {:admission (:yin.vm.provenance/admission relation)\n   276\t             :root (:yin.vm.provenance/root relation)\n   277\t             :semantic (:yin.vm.provenance/semantic relation)\n   278\t             :stack (:yin.vm.provenance/stack relation)\n   279\t             :register (:yin.vm.provenance/register relation)}))))))\n   280\t\n   281\t\n   282\t(defn call-provenance-handles\n   283\t  \"The `{[admission root] record-address}` lookup handles of the\n   284\t   packet provenance this session's production loaders durably\n   285\t   retained (cc3 r2 item 4), for retrieval through\n   286\t   `retained-packet-call-provenance` — including after the session's\n   287\t   durable store is reopened. Empty before any claimed load.\"\n   288\t  [state]\n   289\t  (:call-provenance-handles state))\n   290\t\n  1460\t   decision 12).  Returns the state with the expander's progress and the\n  1461\t   drained `{:errors :forwarded}` summary.\"\n  1462\t  [state]\n  1463\t  (let [{:keys [observer consumer]}\n  1464\t        (macro/step {:observer (:observer state), :consumer (:expander state)})\n  1465\t        [expander summary] (macro/drain-errors consumer)]\n  1466\t    [(assoc state :observer observer :expander expander) summary]))\n  1467\t\n  1468\t\n  1469\t(defn- run-evaluator-stage\n  1470\t  \"Drive the evaluator's observer over `program-out`: it loads each\n  1471\t   expanded tree packet into the VM, runs it, and answers its value on the\n  1472\t   output medium.  The two stages meet only at `program-out`; neither calls\n  1473\t   the other.\"\n  1474\t  [{:keys [load-program output-stream] :as state}]\n  1475\t  (let [;; cc3 r2 item 4: every production loader passes through this\n  1476\t        ;; wrapper, so admission-scoped provenance production is\n  1477\t        ;; connected to durable retention on the ordinary REPL path —\n  1478\t        ;; a packet whose root this round's expansion claimed under\n  1479\t        ;; exactly one new admission is retained in the session's\n  1480\t        ;; content store, and its lookup handle rides the session state\n  1481\t        ;; out (`call-provenance-handles`). Unclaimed packets retain\n  1482\t        ;; nothing (absence, never invention).\n  1483\t        handles (volatile! {})\n  1484\t        retaining-load (fn [vm packet]\n  1485\t                         ;; r7: retention is a side artifact outside\n  1486\t                         ;; every manifest hash; its failure (a store\n  1487\t                         ;; refusing the write, a provenance refusal)\n  1488\t                         ;; must never change the round's observable\n  1489\t                         ;; behavior — the value, the indexer's own\n  1490\t                         ;; publication Warning, or the error text.\n  1491\t                         ;; At master (no retention on this path) a\n  1492\t                         ;; broken store still evaluated the program\n  1493\t                         ;; and reported the failure through the\n  1494\t                         ;; indexer; a throwing materialize here turned\n  1495\t                         ;; that round into `Error: …` and lost the\n  1496\t                         ;; value.  Failure-isolate retention: on any\n  1497\t                         ;; throw, retain nothing for this packet\n  1498\t                         ;; (absence, never invention) and load as\n  1499\t                         ;; before.\n  1500\t                         (try\n  1501\t                           (when-let [admission\n  1502\t                                      (get (:call-site-round-claims state)\n  1503\t                                           (first packet))]\n  1504\t                             (when-let [retained\n  1505\t                                        (retain-packet-call-provenance!\n  1506\t                                          state packet admission)]\n  1507\t                               (vswap! handles assoc\n  1508\t                                       [admission (first packet)]\n  1509\t                                       (:handle retained))))\n  1510\t                           (catch #?(:cljd Object\n  1511\t                                     :clj Exception\n  1512\t                                     :cljs :default) _\n  1513\t                             nil))\n  1514\t                         (load-program vm packet))\n  1515\t        {:keys [observer] vm :consumer}\n  1516\t        (try (observer/run-on-stream {:observer (:row-observer state),\n  1517\t                                      :consumer (:vm state)}\n  1518\t                                     engine/ready-for-ingress?\n  1519\t                                     retaining-load\n  1520\t                                     (make-runner output-stream (round-id state)))\n  1521\t             (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  1522\t               ;; r3 F4: retention already persisted its artifacts\n  1523\t               ;; before this throw; carry the completed handles on\n  1524\t               ;; the error so the recovery path merges them into the\n  1525\t               ;; recovered session instead of dropping them with\n  1526\t               ;; this local volatile\n  1527\t               (throw (if (seq @handles)\n  1528\t                        (ex-info (or (ex-message error) (str error))\n  1529\t                                 (assoc (ex-data error)\n  1530\t                                        ::call-provenance-handles @handles)\n  1531\t                                 error)\n  1532\t                        error))))]\n  1533\t    (cond-> (-> state\n  1534\t                (assoc :row-observer observer :vm vm)\n  1535\t                (dissoc :call-site-round-claims))\n  1536\t      (seq @handles) (update :call-provenance-handles merge @handles))))\n  1537\t\n  1538\t\n  1539\t(defn- format-expansion-errors\n  1540\t  [errors]\n  1541\t  (str/join \"\\n\" (map #(str \"Error: Macro expansion failed: \" (format-value %))\n  1542\t                      errors)))\n  1543\t\n  1544\t\n  1545\t(defn- link-waiting?\n  1546\t  \"True while `vm` parks on a link wait: the two link states `require`\n  1547\t   parks in, or the install it waits on (yin.vm.linker.md section 7.2).\n  1548\t   These are the reasons the shell's interpreter can move, so they are\n  1549\t   the ones a round drives before reporting the VM wedged.\"\n  1550\t  [vm]\n  1551\t  (boolean (some #(contains? #{:link-request :link-response :install}\n  1552\t                             (:reason %))\n  1553\t                 (:wait-set vm))))\n  1554\t\n  1555\t\n  1556\t(defn- carry-link-identity\n  1557\t  \"The round's base VM with the link identity `used` has already minted\n  1558\t   carried forward: link ids `[origin counter]` and install-child origin\n  1559\t   tags are minted once and never reused on a pair (yin.vm.linker.md\n  1560\t   section 7.2), and the shell's rollback to the round's base -- whose\n  1561\t   counters never advanced -- must not let a later require or install\n  1562\t   mint an identity the pair has already answered.\"\n  1563\t  [base used]\n  1564\t  (let [n (max (or (:id-counter base) 0) (or (:id-counter used) 0))\n  1565\t        o (max (or (:origins base) 0) (or (:origins used) 0))]\n  1566\t    (cond-> base\n  1567\t      (pos? n) (assoc :id-counter n)\n  1568\t      (pos? o) (assoc :origins o))))\n  1569\t\n  1570\t\n  1571\t(defn- link-raise\n  1572\t  \"The raise of a resumed link wait, carrying the identity the parked\n  1573\t   evaluation has minted so far -- the counters of the VM the raise\n  1574\t   interrupted, whose every earlier run is in them -- so a rollback\n  1575\t   cannot reuse it.  It carries the query interpreter's pair too: the\n  1576\t   requests it has answered stay answered when the shell rolls back.\n  1577\t   The linker successor carries every cursor and settled question.\n  1578\t   It also carries the call-provenance handles completed retention\n  1579\t   had already persisted before the resume (r4 F4): a program that\n  1580\t   returned from the evaluator stage waiting on a query/link has its\n  1581\t   handles on `state`, and a throw when `drive-links` resumes it\n  1582\t   must not drop them with the interrupted run.\"\n  1583\t  [error vm state]\n  1584\t  (ex-info (or (ex-message error) \"Link failed\")\n  1585\t           (cond-> (assoc (or (ex-data error) {})\n  1586\t                          ::link-counter (:id-counter vm)\n  1587\t                          ::link-origins (:origins vm)\n  1588\t                          ::query-pair (:query-pair state)\n  1589\t                          ::linker (:linker state)\n  1590\t                          ::dht (:dht state)\n  1591\t                          ::indexer (:indexer state))\n  1592\t             (seq (:call-provenance-handles state))\n  1593\t             (assoc ::call-provenance-handles\n  1594\t                    (merge (::call-provenance-handles\n  1595\t                             (ex-data error))\n  1596\t                           (:call-provenance-handles state))))))\n  1597\t\n  1598\t\n  1599\t(defn- carry-served\n  1600\t  \"`state` rolled back by a link raise, keeping what the interpreters\n  1601\t   already concluded: the query pair, the link pair past every request\n  1602\t   answered, the linker interpreter's past every\n  1603\t   question settled, the DHT node a load started or forgot on, and the\n  1604\t   indexer a `yin.link/publish` committed its name envelopes through.\"\n  1605\t  [state d]\n  1895\t  \"The evaluator half of a round whose expander forwarded a program: run\n  1896\t   it, then either finalize the value, drive its require to a conclusion,\n  1897\t   or park it as `:pending-run`.  `state` is the round's starting state;\n  1898\t   `expanded` already carries the expander's progress, which a failing\n  1899\t   evaluation keeps.\"\n  1900\t  [state expanded]\n  1901\t  ;; r4 F4: the latest known state of this evaluation, so recovery\n  1902\t  ;; consults it — not only the pre-evaluator `expanded` — when a\n  1903\t  ;; resumed query/link (or any later step) throws after the\n  1904\t  ;; evaluator stage already completed retention.\n  1905\t  (let [latest (volatile! expanded)]\n  1906\t    (try\n  1907\t    (let [gaps-before (ingress-gaps expanded)\n  1908\t          evaluated (do (vreset! latest (run-evaluator-stage expanded))\n  1909\t                        @latest)\n  1910\t          vm (:vm evaluated)]\n  1911\t      (cond\n  1912\t        (> (ingress-gaps evaluated) gaps-before)\n  1913\t        [(assoc evaluated :ingress-loss? true)\n  1914\t         (str \"Error: \" ingress-loss-text)]\n  1915\t\n  1916\t        (vm/halted? vm)\n  1917\t        (finalize-eval state evaluated\n  1918\t                       (engine/restore-initial-env (:env (:vm expanded)) vm))\n  1919\t\n  1920\t        (or (link-waiting? vm) (query/waiting? vm))\n  1921\t        (let [[state' vm' pending] (drive-links evaluated vm false)\n  1922\t              _ (vreset! latest state')]\n  1923\t          (cond\n  1924\t            (vm/halted? vm')\n  1925\t            (finalize-eval state\n  1926\t                           (assoc state' :vm vm')\n  1927\t                           (tokenize state'\n  1928\t                                     (engine/restore-initial-env\n  1929\t                                       (:env (:vm expanded)) vm')))\n  1930\t\n  1931\t            (link-waiting? vm')\n  1932\t            (pending-eval state state' vm' pending)\n  1933\t\n  1934\t            :else (throw (wedged-program state))))\n  1935\t\n  1936\t        :else (throw (wedged-program state))))\n  1937\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  1938\t      ;; a link raise rolls the shell back to the round's base; the\n  1939\t      ;; identity the interrupted VM had minted rides on it, so nothing\n  1940\t      ;; is minted twice on the surviving pair\n  1941\t      (let [d (ex-data error)\n  1942\t            base (query/discard-answers\n  1943\t                   (if (or (::link-counter d) (::link-origins d))\n  1944\t                     (carry-link-identity\n  1945\t                       (:vm state)\n  1946\t                       {:id-counter (::link-counter d)\n  1947\t                        :origins (::link-origins d)})\n  1948\t                     (:vm state))\n  1949\t                   (:query-pair expanded))]\n  1950\t        (consume-failed-round (carry-served\n  1951\t                                (cond-> (assoc expanded :vm base)\n  1952\t                                  ;; r3+r4 F4: provenance handles\n  1953\t                                  ;; completed before the throw ride\n  1954\t                                  ;; the recovered session — carried\n  1955\t                                  ;; on the error (evaluator-stage and\n  1956\t                                  ;; link raises) and, failing that,\n  1957\t                                  ;; read from the latest known state\n  1958\t                                  ;; of this evaluation, never only\n  1959\t                                  ;; from the pre-evaluator `expanded`\n  1960\t                                  (or (::call-provenance-handles d)\n  1961\t                                      (seq (:call-provenance-handles\n  1962\t                                             @latest)))\n  1963\t                                  (update :call-provenance-handles\n  1964\t                                          merge\n  1965\t                                          (::call-provenance-handles d)\n  1966\t                                          (:call-provenance-handles\n  1967\t                                            @latest)))\n  1968\t                                d)\n  1969\t                              error))))))\n  1970\t\n  1971\t\n  1972\t(defn- eval-program\n  1973\t  \"Evaluate one frontend program — the map AST the compilers emit or a\n  1974\t   datom-literal program — through the §10.1 composition.  The encoder\n  1975\t   projects it to an input batch of canonical rows with its harvest and\n  1976\t   declaration rows; the shell appends that batch to `program-in`, drives\n  1977\t   the expander, drains its summary, and drives the code and AST indexers and then\n  1978\t   the evaluator only when a program was forwarded.  An expansion failure is reported as data: its\n  1979\t   batch is consumed, the store keeps its previous macros, and the next\n  1980\t   input evaluates normally.  An encoding failure throws before anything\n  1981\t   is appended.\n  1982\t\n  1983\t   The observers recover across a gap on their own, but the shell reads the\n  1984\t   gap counts around the round: an increase on any medium means one or more\n  1985\t   batches were never run, so resuming as though execution were complete\n  2370\t      (:pending-run state) [(update-in state [:pending-run :pending-lines]\n  2371\t                                       (fnil into []) queued)\n  2372\t                            text]\n  2373\t      :else (let [[state' text'] (eval-parsed* state\n  2374\t                                               (:trimmed in)\n  2375\t                                               (:parsed in))]\n  2376\t              (recur state' (str text \"\\n\" text') more)))))\n  2377\t\n  2378\t\n  2379\t(defn- recheck-pending*\n  2380\t  \"One bounded re-check of the shell's `:pending-run`: serve the\n  2381\t   interpreter, run the parked VM, and either answer its value -- the\n  2382\t   round the require began in finally completes, and the lines retained\n  2383\t   while it was pending, then `input`, evaluate against it -- consult\n  2384\t   the link policy when the re-check leaves the run pending, `:checks`\n  2385\t   counting this pending run's re-checks that made no progress and\n  2386\t   resetting on one that did, or, when the re-check raised the link's\n  2387\t   refusal, return the shell to the round's base with the error as text\n  2388\t   and evaluate `input` there.  `input` is nil for the host's\n  2389\t   `recheck-pending`, which evaluates no line of its own.\"\n  2390\t  [state input initial-progress]\n  2391\t  (let [parked (:pending-run state)]\n  2392\t    (try\n  2393\t      (let [[state' vm' pending progress?] (drive-links state (:vm parked)\n  2394\t                                                        initial-progress)]\n  2395\t        (if (vm/halted? vm')\n  2396\t          (let [vm'' (engine/restore-initial-env (:env (:base parked)) vm')\n  2397\t                [st text] (finalize-eval state\n  2398\t                                         (cond-> (assoc state' :vm vm'')\n  2399\t                                           (:frontend parked)\n  2400\t                                           (assoc ::frontend\n  2401\t                                                  (:frontend parked)))\n  2402\t                                         (tokenize state' vm''))]\n  2403\t            (fold-queued [(assoc st :vm vm'' :pending-run nil) text]\n  2404\t                         (cond-> (vec (:pending-lines parked))\n  2405\t                           input (conj input))))\n  2406\t          (let [checks (if progress? 0 (inc (or (:checks parked) 0)))\n  2407\t                parked' (cond-> (assoc parked\n  2408\t                                       :vm vm'\n  2409\t                                       :links pending\n  2410\t                                       :checks checks)\n  2411\t                          input (update :pending-lines\n  2412\t                                        (fnil conj []) input))\n  2413\t                [st text] (drain-output (assoc state'\n  2414\t                                               :vm vm'\n  2415\t                                               :pending-run parked'))]\n  2416\t            (consult-link-policy st text (pending-text pending)))))\n  2417\t      (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  2418\t        (let [[st text] (drain-output state)\n  2419\t              d (ex-data error)]\n  2420\t          (fold-queued\n  2421\t            [(carry-served (cond-> (assoc st\n  2422\t                                          :vm (query/discard-answers\n  2423\t                                                (carry-link-identity\n  2424\t                                                  (:base parked)\n  2425\t                                                  {:id-counter (::link-counter d)\n  2426\t                                                   :origins (::link-origins d)})\n  2427\t                                                (:query-pair st))\n  2428\t                                          :pending-run nil)\n  2429\t                             ;; r4 F4: handles a link raise carried\n  2430\t                             ;; out of the resumed run ride recovery\n  2431\t                             (::call-provenance-handles d)\n  2432\t                             (update :call-provenance-handles\n  2433\t                                     merge\n  2434\t                                     (::call-provenance-handles d)))\n  2435\t                           d)\n  2436\t             (str text\n  2437\t                  (format-error error)\n  2438\t                  (dropped-lines-text (count (:pending-lines parked))))]\n  2439\t            (cond-> [] input (conj input))))))))\n  2440\t\n  2441\t\n  2442\t(defn recheck-pending\n  2443\t  \"One re-check of the shell's `:pending-run` without an input line --\n  2444\t   the step an unattended host drives at its own cadence\n  2445\t   (yin.repl.link-policy.md section 4): serve the interpreter, run the\n  2446\t   parked VM, and consult the link policy when the run is still\n  2447\t   pending.  A re-check that completes the run folds the retained lines\n  2448\t   exactly as a typed line's completion does.  Returns `[state text]`,\n  2449\t   `text` nil when nothing is pending.  It reads no clock and takes no\n  2450\t   callback; the host decides when to call it.\"\n  2451\t  [state]\n  2452\t  (if (:pending-run state)\n  2453\t    (recheck-pending* state nil false)\n  2454\t    [state nil]))\n  2455\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat test/dao/stream/ws_project_cross_node_test.cljs; sed -n '1,225p' test/dao/stream/ws_project_peer.clj; nl -ba test/yin/repl/index_test.cljc | sed -n '510,575p'; nl -ba test/yin/repl/query_test.cljc | sed -n '345,407p'; rg -n 'retai|failure|resume' test/yang/clojure_callsite_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat test/dao/stream/ws_project_cross_node_test.cljs; sed -n '1,225p' test/dao/stream/ws_project_peer.clj; nl -ba test/yin/repl/index_test.cljc | sed -n '510,575p'; nl -ba test/yin/repl/query_test.cljc | sed -n '345,407p'; rg -n 'retai|failure|resume' test/yang/clojure_callsite_test.cljc\"","aggregated_output":"(ns dao.stream.ws-project-cross-node-test\n  \"Slice 3's cross-host socket proofs, Node half.\n\n   The ws channel composition was proven twice already -- portably in\n   one process, and on one JVM across real loopback sockets.  A wire\n   spoken by two hosts is a further fact: only two operating-system\n   processes of two different runtimes can falsify it.  This namespace\n   is the Node parent of two such pairs, and process B is always\n   `dao.stream.ws-project-peer` spawned as a real JVM child:\n\n   * clj->Node: the JVM peer serves (its acceptor behind a real\n     http-kit listener) and this Node process dials through the real\n     `ws` client, attaches a reflection of \\\"str-1\\\", and reads the toy\n     end to end -- probe confirmation, \\\"hello\\\", and the source's own\n     end.\n\n   * Node->clj: this Node process serves (the acceptor composition\n     behind a real Node `ws` server) and the JVM peer dials, reads\n     \\\"hello\\\" through its own reflection, and -- because its dial\n     carries the \\\"str-2\\\" table and its dial-step answers the other\n     direction -- reflects back: this end attaches a reflection of\n     \\\"str-2\\\" over the same accepted session and reads \\\"backward\\\"\n     through it.\n\n   Each proof is one promise chain over small named steps: a step that\n   fails answers nil, which short-circuits the rest without throwing\n   through the chain, and the terminal step reports and cleans up.  The\n   child is spoken to only over pipes; its replies are all this parent\n   ever learns.  Without a Clojure CLI to spawn the JVM peer the pair\n   skips loudly rather than failing or passing silently.  The browser\n   dials-and-reads lane has no harness in any of the three lanes and is\n   not attempted here.\"\n  (:require [cljs.test :refer [async deftest is]]\n            [clojure.string :as str]\n            [dao.stream :as stream]\n            [dao.stream.remote :as remote]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [dao.stream.cbor :as cbor]\n            [dao.stream.transit :as transit]\n            [dao.stream.ws :as ws]\n            [dao.stream.ws.node :as node]\n            [dao.stream.ws-project-corpus :as corpus]\n            [dao.stream.ws-project :as project]))\n\n\n(def ^:private peer-main\n  \"Process B, a whole peer program on this tree's own JVM classpath.\"\n  \"dao.stream.ws-project-peer\")\n\n\n(def ^:private path \"/streams/toy\")\n\n\n(def ^:private admission\n  {:retention :evict-oldest :capacity 64 :value-domain :portable-values})\n\n\n(def ^:private handoff-admission\n  {:retention :evict-oldest :capacity 1 :value-domain :host-values})\n\n\n(def ^:private not-yet\n  \"The outcomes a reflection answers while its request is in flight.\"\n  #{:dao.stream/transport-error :dao.stream/blocked})\n\n\n(def ^:private boot-ms 60000)\n(def ^:private bind-ms 30000)\n(def ^:private reply-ms 20000)\n(def ^:private settle-ms 20000)\n\n\n(defn- buffer\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn- newest\n  [handle]\n  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))\n\n\n(defn- served-stream\n  [& values]\n  (let [s (buffer 64)]\n    (doseq [value values] (stream/append! s value))\n    (stream/close! s)\n    s))\n\n\n(defn- poll-until\n  \"Resolve with the first truthy value `pred` returns, or nil at the\n   deadline.  A pred may answer a promise; polling is the only honest\n   wait here, and nothing notifies.\"\n  [pred timeout-ms]\n  (js/Promise.\n    (fn [resolve _reject]\n      (let [deadline (+ (js/Date.now) timeout-ms)]\n        (letfn [(tick\n                  []\n                  (let [value (try (pred) (catch :default _ nil))]\n                    (.then (js/Promise.resolve value)\n                           (fn [v]\n                             (cond\n                               v (resolve v)\n                               (< deadline (js/Date.now)) (resolve nil)\n                               :else (js/setTimeout tick 20))))))]\n          (tick))))))\n\n\n(defn- settle\n  \"Poll `op` until its outcome leaves the not-yet set; the composition's\n   own ticker steps between attempts.  The final result, or nil.\"\n  [op timeout-ms]\n  (poll-until\n    (fn []\n      (let [r (op)]\n        (when-not (contains? not-yet (:dao.stream/outcome r)) r)))\n    timeout-ms))\n\n\n(defn- chain\n  \"Run each (step acc), in order, as a value or a promise; a nil acc\n   short-circuits the rest, so one failed step ends the proof without\n   throwing through the chain.\"\n  [acc steps]\n  (if (or (nil? acc) (empty? steps))\n    (js/Promise.resolve acc)\n    (-> (js/Promise.resolve ((first steps) acc))\n        (.then (fn [acc'] (chain acc' (rest steps)))))))\n\n\n(defn- line-reader\n  [readable on-line]\n  (let [pending (atom \"\")]\n    (.setEncoding ^js readable \"utf8\")\n    (.on ^js readable \"data\"\n         (fn [chunk]\n           (let [parts (str/split (str @pending chunk) #\"\\n\" -1)]\n             (reset! pending (last parts))\n             (doseq [line (butlast parts)\n                     :when (not (str/blank? line))]\n               (on-line line)))))))\n\n\n(def ^:private under-test\n  \"The wire profile the running proof is composed with, `{:profile p :flag f}`;\n   the proofs run one at a time, so an atom set at each proof's start is the\n   whole of its scope.  `:flag` is the `--codec` value the JVM peer takes.\"\n  (atom nil))\n\n\n(def ^:private profiles\n  {\"transit\" transit/profile \"cbor\" cbor/profile})\n\n\n(def ^:private peer-dir\n  \"The checkout the JVM peer runs from: `DAO_STREAM_PEER_DIR` when set (an\n   older build of the peer, for the old/new wire proof of\n   docs/design/dao.stream.codec.md 7.3), else this process's own.\"\n  (some-> js/process .-env (aget \"DAO_STREAM_PEER_DIR\") not-empty))\n\n\n(defn- jvm-classpath\n  \"The JVM test classpath, as a promise of a string.  Nil when the\n   Clojure CLI is absent: the parent then cannot spawn a JVM peer and\n   the pair skips loudly.\"\n  []\n  (js/Promise.\n    (fn [resolve _reject]\n      (let [child-process (js/require \"child_process\")]\n        (.exec child-process \"clojure -Spath -M:test\"\n               (if peer-dir #js {:cwd peer-dir} #js {})\n               (fn [error stdout _stderr]\n                 (if (or error (str/blank? (str stdout)))\n                   (resolve nil)\n                   ;; every clojure launch prints a banner line first;\n                   ;; the classpath is the last non-empty line.\n                   (resolve (->> (str/split (str stdout) #\"\\n\")\n                                 (map str/trim)\n                                 (remove str/blank?)\n                                 (last))))))))))\n\n\n(defn- start-jvm-peer!\n  \"Spawn process B as a JVM child on the given classpath with `args`.\"\n  [classpath args]\n  (let [child-process (js/require \"child_process\")\n        command (into [\"-cp\" classpath \"clojure.main\" \"-m\" peer-main]\n                      (concat args [\"--codec\" (:flag @under-test)]))\n        process (.spawn child-process \"java\" (to-array command)\n                        (clj->js (cond-> {:stdio [\"pipe\" \"pipe\" \"pipe\"]}\n                                   peer-dir (assoc :cwd peer-dir))))\n        replies (atom [])\n        errors (atom [])]\n    ;; Loading B's namespaces prints to B's stdout before the peer protocol\n    ;; starts, so a line that is not a Transit reply is noise rather than a\n    ;; protocol failure.\n    (line-reader (.-stdout process)\n                 (fn [line]\n                   (let [reply (try (transit/decode line)\n                                    (catch :default _ nil))]\n                     (if (:reply reply)\n                       (swap! replies conj reply)\n                       (swap! errors conj line)))))\n    (line-reader (.-stderr process) #(swap! errors conj %))\n    {:process process :replies replies :errors errors}))\n\n\n(defn- stop-peer!\n  [peer]\n  (try (.kill ^js (:process peer)) (catch :default _ nil)))\n\n\n(defn- take-reply!\n  \"Consume the first reply of `kind`, or nil at the deadline.\"\n  [peer kind timeout-ms]\n  (poll-until\n    (fn []\n      (when-some [index (first (keep-indexed (fn [i r]\n                                               (when (= kind (:reply r)) i))\n                                             @(:replies peer)))]\n        (let [reply (nth @(:replies peer) index)]\n          (swap! (:replies peer)\n                 (fn [rs] (into (subvec rs 0 index) (subvec rs (inc index)))))\n          reply)))\n    timeout-ms))\n\n\n(defn- ask!\n  [peer command kind]\n  (.write ^js (.-stdin ^js (:process peer))\n          (str (transit/encode command) \"\\n\"))\n  (take-reply! peer kind reply-ms))\n\n\n(defn- settled-read!\n  \"Ask one read op of the child until its outcome stops answering\n   not-yet: the child's own ticker drives its composition between the\n   parent's asks.  The final reply, or nil at the deadline.\"\n  [peer op timeout-ms]\n  (poll-until\n    (fn []\n      (-> (ask! peer {:cmd :read :op op} :read)\n          (.then (fn [reply]\n                   (when (and reply\n                              (not (contains? not-yet (:outcome reply))))\n                     reply)))))\n    timeout-ms))\n\n\n(defn- descriptor-at\n  [port]\n  {:dao.stream/type :dao.stream/ws\n   :dao.stream/identity \"str-1\"\n   :ws/host \"127.0.0.1\"\n   :ws/port port\n   :ws/path path})\n\n\n(defn- remote-descriptor\n  [channel identity]\n  {:dao.stream/type :dao.stream/remote\n   :dao.stream/identity identity\n   :dao.stream/channel channel})\n\n\n(defn- node-dialer\n  \"This process's own dialing composition: one dial over the real Node\n   client, serving the \\\"str-2\\\" table so this end answers the other\n   direction of the same connection.\"\n  []\n  (let [backward (served-stream \"backward\")\n        wire-corpus (apply served-stream (corpus/values (:profile @under-test)))\n        traffic (buffer 64)\n        events (buffer 64)\n        dial (project/dial\n               {:attach! (ws/make-attacher\n                           {:codec (:profile @under-test)\n                            :traffic {:dao.stream/handle traffic\n                                      :dao.stream/surface #{:writer}}\n                            :admission admission\n                            :connect! node/connect!})\n                :traffic {:dao.stream/handle traffic\n                          :dao.stream/surface #{:writer}}\n                :cursor (newest traffic)\n                :ring (buffer 64)\n                :table {\"str-2\" {:handle backward :surface #{:reader}}\n                        corpus/identity-name {:handle wire-corpus\n                                              :surface #{:reader}}}\n                :dao.stream.remote/events events})\n        timer (js/setInterval (fn [] (project/dial-step! dial)) 5)]\n    {:dial dial\n     :events events\n     :stop! (fn [] (js/clearInterval timer))}))\n\n\n(defn- node-acceptor\n  \"This process's own accepting composition: the ws endpoint with one\n   handoff slot, the acceptor, and a real Node listener whose bound port\n   is learned from the server's own report.\"\n  []\n  (let [hello (served-stream \"hello\")\n        wire-corpus (apply served-stream (corpus/values (:profile @under-test)))\n        descriptor (descriptor-at 1)\n        offers (buffer 1)\n        acks (buffer 1)\n        endpoint (ws/make-endpoint\n                   {:codecs [(:profile @under-test)]\n                    :descriptor descriptor\n                    :control {:dao.stream/handle (buffer 16)\n                              :dao.stream/surface #{:writer}}\n                    :control-admission admission\n                    :slots [{:offer {:dao.stream/handle offers\n                                     :dao.stream/surface #{:writer}}\n                             :offer-admission handoff-admission\n                             :ack {:dao.stream/handle acks\n                                   :dao.stream/surface #{:writer}}\n                             :ack-admission handoff-admission\n                             :ack-cursor (newest acks)}]\n                    :expiry-ms nil})\n        acceptor (project/make-acceptor\n                   {:endpoint endpoint\n                    :slots [{:offer-reader offers\n                             :offer-cursor (newest offers)\n                             :ack-writer {:dao.stream/handle acks\n                                          :dao.stream/surface #{:writer}}}]\n                    :table {\"str-1\" {:handle hello :surface #{:reader}}\n                            corpus/identity-name {:handle wire-corpus\n                                                  :surface #{:reader}}}\n                    :make-media (fn [_offer]\n                                  (let [traffic (buffer 64)\n                                        channel (buffer 64)]\n                                    {:traffic\n                                     {:dao.stream/handle traffic\n                                      :dao.stream/surface #{:writer}}\n                                     :admission admission\n                                     :reader traffic\n                                     :cursor (newest traffic)\n                                     :ring channel}))})\n        port (atom nil)\n        listener (node/listen! endpoint\n                               {:codecs [(:profile @under-test)]\n                                :host \"127.0.0.1\"\n                                :port 0\n                                :accept! (fn [target socket now]\n                                           (ws/accept-connection!\n                                             endpoint target socket now))\n                                :on-listening (fn [address]\n                                                (reset! port\n                                                        (.-port address)))})\n        timer (js/setInterval\n                (fn [] (project/accept-step! acceptor (js/Date.now))) 5)]\n    {:acceptor acceptor\n     :listener listener\n     :port port\n     :stop! (fn []\n              (js/clearInterval timer)\n              (node/stop-listening! listener))}))\n\n\n(defn- confirmation-surface\n  \"The surface of the attach probe's confirmation on the event writer.\"\n  [events]\n  (loop [c (:dao.stream/cursor (stream/cursor events stream/anchor-oldest))]\n    (let [r (stream/next events c)]\n      (if (= :dao.stream/ok (:dao.stream/outcome r))\n        (or (:dao.stream.remote/surface (:dao.stream/value r))\n            (recur (:dao.stream/cursor r)))\n        nil))))\n\n\n(defn- reflection-over-session\n  \"This end's own reflection of `identity` over the accepted session's\n   channel end: the attachment point for the reverse direction of the\n   one connection.\"\n  [acceptor descriptor identity]\n  (let [attachment (first (keys (project/sessions acceptor)))\n        end (project/session-end acceptor attachment)\n        reflect! (remote/attacher\n                   {:dao.stream.remote/channels {descriptor end}})]\n    (:dao.stream/handle\n      (reflect! (remote-descriptor descriptor identity)))))\n\n\n;; =============================================================================\n;; clj -> Node: the JVM peer serves, this Node process dials and reads\n;; =============================================================================\n\n\n;; =============================================================================\n;; The §7.3 live corpus: the envelope corpus and one Jing-wrapped payload,\n;; read through a reflection of the peer's \"str-3\", compared under the\n;; §4.4 law (`=` after Jing unwrapping to octets).\n;; =============================================================================\n\n\n(defn- read-reflection-corpus\n  \"Read `reflection` to its source end; resolves with the normalized\n   values received. A read that never settles, or that settles to an\n   outcome outside ok/end, reports that outcome and fails — it does NOT\n   collapse to a bare nil. The old collapse made three different causes\n   (settle timeout, :transport-error, an unexpected terminal) read as the\n   single message `the corpus read never completed`, which is what made\n   the parallel-run failure undiagnosable (2026-11-01).\"\n  [reflection]\n  (let [profile (:profile @under-test)]\n    (-> (settle #(stream/cursor reflection stream/anchor-oldest) settle-ms)\n        (.then\n          (fn [c0]\n            (cond\n              (nil? c0)\n              (do (is false (str \"the initial cursor read never settled within \"\n                                 settle-ms \"ms (outcome stayed \"\n                                 (pr-str not-yet) \")\"))\n                  nil)\n\n              (not= :dao.stream/ok (:dao.stream/outcome c0))\n              (do (is false (str \"the initial cursor read settled to \"\n                                 (pr-str (:dao.stream/outcome c0))))\n                  nil)\n\n              :else\n              (letfn [(step\n                        [cursor acc]\n                        (-> (settle #(stream/next reflection cursor) settle-ms)\n                            (.then\n                              (fn [n]\n                                (let [o (:dao.stream/outcome n)]\n                                  (cond\n                                    (nil? n)\n                                    (do (is false (str \"read #\" (count acc)\n                                                       \" never settled within \"\n                                                       settle-ms \"ms (outcome stayed \"\n                                                       (pr-str not-yet) \")\"))\n                                        nil)\n\n                                    (= :dao.stream/end o) acc\n\n                                    (= :dao.stream/ok o)\n                                    (step (:dao.stream/cursor n)\n                                          (conj acc (corpus/normalize\n                                                      profile\n                                                      (:dao.stream/value n))))\n\n                                    :else\n                                    (do (is false (str \"read #\" (count acc)\n                                                       \" settled to \" (pr-str o)))\n                                        nil)))))))]\n                (step (:dao.stream/cursor c0) []))))))))\n\n\n(defn- check-corpus!\n  [received what]\n  (let [expected (corpus/expected (:profile @under-test))]\n    (is (some? received) (str what \": the corpus read never completed\"))\n    (when received\n      (is (= (count expected) (count received))\n          (str what \": corpus count\"))\n      (doseq [[e v] (map vector expected received)]\n        (is (= e v) (str what \": \" (pr-str e) \" crossed as \" (pr-str v)))))))\n\n\n(defn- p1-corpus\n  \"Node dials, the JVM serves: the JVM's encoded corpus decodes here.\"\n  [{:keys [descriptor dialer] :as acc}]\n  (let [attached (project/dial-attach!\n                   (:dial dialer)\n                   (remote-descriptor descriptor corpus/identity-name))]\n    (when (is (= :dao.stream/ok (:dao.stream/outcome attached))\n              \"the corpus attach was refused\")\n      (-> (read-reflection-corpus (:dao.stream/handle attached))\n          (.then (fn [received]\n                   (check-corpus! received \"JVM serves, Node decodes\")\n                   acc))))))\n\n\n(defn- jvm-reads-corpus\n  \"The JVM peer reads its reflection of the corpus to the source's end: the\n   Node-encoded corpus decodes in the JVM.  `what` names the direction.\"\n  [{:keys [peer] :as acc} what]\n  (letfn [(step\n            [received]\n            (-> (settled-read! peer :next settle-ms)\n                (.then\n                  (fn [reply]\n                    (case (:outcome reply)\n                      :dao.stream/ok (step (conj received (:value reply)))\n                      :dao.stream/end received\n                      nil)))))]\n    (-> (settled-read! peer :begin settle-ms)\n        (.then (fn [_] (step [])))\n        (.then (fn [received]\n                 (check-corpus! received what)\n                 acc)))))\n\n\n(defn- p2-corpus-forward\n  \"The JVM dials, Node serves: the Node-encoded corpus decodes in the JVM.\"\n  [acc]\n  (jvm-reads-corpus acc \"Node serves, JVM decodes\"))\n\n\n(defn- p1-corpus-back\n  \"The JVM serves, Node dials: the JVM attaches its own reflection of the\n   corpus Node serves over the same accepted session, and decodes it.\"\n  [{:keys [peer] :as acc}]\n  (-> (ask! peer {:cmd :attach :identity corpus/identity-name} :attach)\n      (.then\n        (fn [attached]\n          (when (is (= :dao.stream/ok (:outcome attached))\n                    \"the JVM reverse attach was refused\")\n            (jvm-reads-corpus acc \"Node dials, JVM server decodes\"))))))\n\n\n(defn- p2-corpus-back\n  \"The JVM's dial-side mirror serves its encoded corpus to this end over\n   the same accepted session.\"\n  [{:keys [acceptor descriptor] :as acc}]\n  (-> (poll-until #(seq (project/sessions acceptor)) settle-ms)\n      (.then\n        (fn [_]\n          (-> (read-reflection-corpus\n                (reflection-over-session acceptor descriptor\n                                         corpus/identity-name))\n              (.then (fn [received]\n                       (check-corpus! received \"JVM mirror serves, Node decodes\")\n                       acc)))))))\n\n\n(defn- p1-descriptor\n  \"The serving reply becomes the reachable descriptor; nil when the JVM\n   listener never reported one.\"\n  [peer]\n  (-> (take-reply! peer :serving boot-ms)\n      (.then\n        (fn [serving]\n          (when (is (map? serving)\n                    (str \"the JVM listener never reported a bound port; \"\n                         \"its other output was \"\n                         (pr-str (take 5 @(:errors peer)))))\n            (is (int? (:port serving)))\n            {:peer peer\n             :descriptor (descriptor-at (:port serving))})))))\n\n\n(defn- p1-dialer\n  \"This end's dialing composition, joined into the chain's state.  The\n   stop function rides along for the terminal step's cleanup.\"\n  [acc]\n  (let [dialer (node-dialer)]\n    (.then (js/Promise.resolve acc)\n           (fn [acc'] (merge acc' {:dialer dialer})))))\n\n\n(defn- p1-attach\n  \"Attach the reflection of \\\"str-1\\\" over the dialed channel.\"\n  [{:keys [descriptor dialer] :as acc}]\n  (let [attached (project/dial-attach!\n                   (:dial dialer)\n                   (remote-descriptor descriptor \"str-1\"))]\n    (when (is (= :dao.stream/ok (:dao.stream/outcome attached))\n              \"the Node dial over a real JVM listener was refused\")\n      (is (string? (:dao.stream/attachment attached)))\n      (assoc acc :reflection (:dao.stream/handle attached)))))\n\n\n(defn- p1-cursor\n  \"Settle the cursor ask and prove the probe's confirmation crossed the\n   wire: the event writer recorded the served stream's declared\n   surface.\"\n  [{:keys [dialer reflection] :as acc}]\n  (-> (settle #(stream/cursor reflection stream/anchor-oldest) settle-ms)\n      (.then\n        (fn [c0]\n          (when (is (some? c0) \"the cursor ask never settled\")\n            (is (= :dao.stream/ok (:dao.stream/outcome c0)))\n            (is (= #{:reader} (confirmation-surface (:events dialer)))\n                \"the confirmation carries the served surface\")\n            (assoc acc :c0 (:dao.stream/cursor c0)))))))\n\n\n(defn- p1-value\n  \"The first next: \\\"hello\\\", and nothing knew it was a string.\"\n  [{:keys [reflection c0] :as acc}]\n  (-> (settle #(stream/next reflection c0) settle-ms)\n      (.then\n        (fn [n]\n          (when (is (some? n) \"the first next never settled\")\n            (is (= :dao.stream/ok (:dao.stream/outcome n)))\n            (is (= \"hello\" (:dao.stream/value n))\n                \"nothing knew it was a string\")\n            (assoc acc :c1 (:dao.stream/cursor n)))))))\n\n\n(defn- p1-end\n  \"The second next: the source's own end.\"\n  [{:keys [reflection c1] :as acc}]\n  (-> (settle #(stream/next reflection c1) settle-ms)\n      (.then\n        (fn [e]\n          (when (is (some? e) \"the second next never settled\")\n            (is (= :dao.stream/end (:dao.stream/outcome e))\n                \"the source's own end\")\n            acc)))))\n\n\n(defn- p1-sessions\n  \"The JVM acceptor adopted exactly one connection for the one dial.\"\n  [{:keys [peer] :as acc}]\n  (-> (ask! peer {:cmd :sessions} :sessions)\n      (.then\n        (fn [sessions]\n          (when (is (map? sessions) \"the sessions ask never answered\")\n            (is (= 1 (:count sessions))\n                \"the JVM acceptor adopted one connection for one dial\")\n            (is (nil? (:ticker-error sessions)))\n            acc)))))\n\n\n(defn- a-node-dialer-reads-a-jvm-server\n  [flag done & [steps]]\n  (reset! under-test {:profile (get profiles flag) :flag flag})\n  (.then (jvm-classpath)\n         (fn [classpath]\n           (if (nil? classpath)\n             (do (println \";; SKIPPED a-node-dialer-reads-a-jvm-server:\"\n                          \"no Clojure CLI, so no JVM peer can serve\")\n                 (done))\n             (let [peer (start-jvm-peer! classpath [\"--serve\"])\n                   finish! (fn []\n                             (stop-peer! peer)\n                             (done))]\n               (-> (chain peer (or steps\n                                   [p1-descriptor\n                                    p1-dialer\n                                    p1-attach\n                                    p1-cursor\n                                    p1-value\n                                    p1-end\n                                    p1-sessions]))\n                   (.then\n                     (fn [acc]\n                       (when (nil? acc)\n                         (is false \"the clj->Node proof stopped early\"))\n                       (when-some [dialer (:dialer acc)]\n                         ((:stop! dialer)))\n                       (finish!)))\n                   (.catch\n                     (fn [error]\n                       (is false (str \"clj->Node proof failure: \"\n                                      (pr-str error)))\n                       (finish!)))))))))\n\n\n;; =============================================================================\n;; Node -> clj: this Node process serves, the JVM peer dials and its\n;; dial reflects back over the same connection\n;; =============================================================================\n\n\n(defn- p2-bound\n  \"The Node listener's own bound-port report becomes the descriptor this\n   parent hands to the child as text.\"\n  [{:keys [server] :as acc}]\n  (-> (poll-until (fn [] @(:port server)) bind-ms)\n      (.then\n        (fn [port]\n          (when (is (int? port)\n                    \"the Node listener never reported a bound port\")\n            (assoc acc :descriptor (descriptor-at port)))))))\n\n\n(defn- p2-spawn\n  \"Spawn the JVM dialer with the descriptor as its sole argument, and\n   register it with the proof's kill list so no path leaks the child.\"\n  [{:keys [classpath descriptor peers] :as acc}]\n  (let [peer (start-jvm-peer! classpath\n                              [(transit/encode-descriptor descriptor)])]\n    (swap! peers conj peer)\n    (assoc acc :peer peer)))\n\n\n(defn- p2-ready\n  \"The child's bootstrap: the descriptor it decoded from text is the\n   one this parent encoded.\"\n  [{:keys [peer descriptor] :as acc}]\n  (-> (take-reply! peer :ready boot-ms)\n      (.then\n        (fn [ready]\n          (when (is (map? ready)\n                    (str \"the JVM dialer never bootstrapped; its other\"\n                         \" output was \"\n                         (pr-str (take 5 @(:errors peer)))))\n            (is (= descriptor (:descriptor ready))\n                \"the descriptor the JVM peer decoded from text differs\")\n            acc)))))\n\n\n(defn- p2-attach\n  \"The child dials: one attach over the descriptor, one attachment.\"\n  [{:keys [peer identity] :as acc}]\n  (-> (ask! peer {:cmd :attach :identity (or identity \"str-1\")} :attach)\n      (.then\n        (fn [attached]\n          (when (is (map? attached) \"the attach never answered\")\n            (is (= :dao.stream/ok (:outcome attached)))\n            (is (string? (:attachment attached)))\n            acc)))))\n\n\n(defn- p2-probe-confirmed\n  \"Poll the probe until the confirmation's surface is present.\"\n  [{:keys [peer] :as acc}]\n  (-> (poll-until\n        (fn []\n          (-> (ask! peer {:cmd :probe} :probe)\n              (.then #(when (:surface %) %))))\n        settle-ms)\n      (.then\n        (fn [confirmed]\n          (when (is (some? confirmed)\n                    \"the probe's confirmation never crossed the wire\")\n            acc)))))\n\n\n(defn- p2-probe\n  \"The confirmation's facts: the served surface, the served identity,\n   and a child ticker that never threw.\"\n  [{:keys [peer] :as acc}]\n  (-> (ask! peer {:cmd :probe} :probe)\n      (.then\n        (fn [probe]\n          (when (is (map? probe)\n                    \"the probe's confirmation never crossed the wire\")\n            (is (= #{:reader} (:surface probe))\n                \"the served surface was learned from the probe's answer\")\n            (is (= \"str-1\" (:identity probe)))\n            (is (nil? (:ticker-error probe)))\n            acc)))))\n\n\n(defn- p2-read-begun\n  \"The child's cursor ask settles ok.\"\n  [{:keys [peer] :as acc}]\n  (-> (settled-read! peer :begin settle-ms)\n      (.then\n        (fn [reply]\n          (when (is (map? reply) \"the JVM dialer's cursor ask never settled\")\n            (is (= :dao.stream/ok (:outcome reply)))\n            acc)))))\n\n\n(defn- p2-read-hello\n  \"The child reads \\\"hello\\\" through its reflection of this end's\n   served stream.\"\n  [{:keys [peer] :as acc}]\n  (-> (settled-read! peer :next settle-ms)\n      (.then\n        (fn [reply]\n          (when (is (map? reply) \"the child's first next never settled\")\n            (is (= :dao.stream/ok (:outcome reply)))\n            (is (= \"hello\" (:value reply))\n                \"the clj dial read the Node acceptor's value over the wire\")\n            acc)))))\n\n\n(defn- p2-read-end\n  \"The child's source end: \\\"hello\\\" was a complete history.\"\n  [{:keys [peer] :as acc}]\n  (-> (settled-read! peer :next settle-ms)\n      (.then\n        (fn [reply]\n          (when (is (map? reply) \"the child's second next never settled\")\n            (is (= :dao.stream/end (:outcome reply))\n                \"the source's own end crossed the wire too\")\n            acc)))))\n\n\n(defn- p2-b-reflect\n  \"The clj dial reflects back: this end attaches a reflection of the\n   dialer's own \\\"str-2\\\" table entry over the same accepted session,\n   to be read through the dial-side mirror the JVM peer runs on that\n   one connection.\"\n  [{:keys [acceptor descriptor] :as acc}]\n  (-> (poll-until #(seq (project/sessions acceptor)) settle-ms)\n      (.then\n        (fn [adopted]\n          (when (is (some? adopted) \"the JVM dial was never adopted\")\n            (assoc acc :b-reflection\n                   (reflection-over-session acceptor descriptor \"str-2\")))))))\n\n\n(defn- p2-b-cursor\n  \"The reverse reflection's cursor ask settles ok over the session.\"\n  [{:keys [b-reflection] :as acc}]\n  (-> (settle #(stream/cursor b-reflection stream/anchor-oldest) settle-ms)\n      (.then\n        (fn [c0]\n          (when (is (some? c0)\n                    (str \"the reflection over the accepted session\"\n                         \" never established\"))\n            (is (= :dao.stream/ok (:dao.stream/outcome c0)))\n            (assoc acc :b-c0 (:dao.stream/cursor c0)))))))\n\n\n(defn- p2-b-value\n  \"\\\"backward\\\": the value the child's dial-side mirror served back over\n   the same connection.\"\n  [{:keys [b-reflection b-c0] :as acc}]\n  (-> (settle #(stream/next b-reflection b-c0) settle-ms)\n      (.then\n        (fn [n]\n          (when (is (some? n) \"the reverse next never settled\")\n            (is (= :dao.stream/ok (:dao.stream/outcome n)))\n            (is (= \"backward\" (:dao.stream/value n))\n                \"the clj dial reflected back over the same connection\")\n            (assoc acc :b-c1 (:dao.stream/cursor n)))))))\n\n\n(defn- p2-b-end\n  \"The reverse direction's own source end.\"\n  [{:keys [b-reflection b-c1] :as acc}]\n  (-> (settle #(stream/next b-reflection b-c1) settle-ms)\n      (.then\n        (fn [e]\n          (is (= :dao.stream/end (:dao.stream/outcome e)))\n          acc))))\n\n\n(defn- p2-one-session\n  \"Both directions rode one adopted session.\"\n  [{:keys [acceptor] :as acc}]\n  (is (= 1 (count (project/sessions acceptor)))\n      \"both directions rode one adopted session\")\n  acc)\n\n\n(defn- p2-quit\n  \"Tell the child to leave; its exit closes its end of the socket.\"\n  [{:keys [peer] :as acc}]\n  (-> (ask! peer {:cmd :quit} :quit)\n      (.then (fn [_reply] acc))))\n\n\n(defn- a-jvm-dialer-serves-back-over-one-node-connection\n  [flag done & [steps]]\n  (reset! under-test {:profile (get profiles flag) :flag flag})\n  (.then (jvm-classpath)\n         (fn [classpath]\n           (if (nil? classpath)\n             (do (println \";; SKIPPED\"\n                          \"a-jvm-dialer-serves-back-over-one-connection:\"\n                          \"no Clojure CLI, so no JVM peer can dial\")\n                 (done))\n             (let [server (node-acceptor)\n                   peers (atom [])\n                   finish! (fn []\n                             ((:stop! server))\n                             (doseq [peer @peers] (stop-peer! peer))\n                             (done))]\n               (-> (chain {:classpath classpath\n                           :acceptor (:acceptor server)\n                           :server server\n                           :peers peers}\n                          (or steps\n                              [p2-bound\n                               p2-spawn\n                               p2-ready\n                               p2-attach\n                               p2-probe-confirmed\n                               p2-probe\n                               p2-read-begun\n                               p2-read-hello\n                               p2-read-end\n                               p2-b-reflect\n                               p2-b-cursor\n                               p2-b-value\n                               p2-b-end\n                               p2-one-session\n                               p2-quit]))\n                   (.then\n                     (fn [acc]\n                       (when (nil? acc)\n                         (is false \"the Node->clj proof stopped early\"))\n                       (finish!)))\n                   (.catch\n                     (fn [error]\n                       (is false (str \"Node->clj proof failure: \"\n                                      (pr-str error)))\n                       (finish!)))))))))\n\n\n(deftest a-node-dialer-reads-a-jvm-server-over-transit\n  (async done (a-node-dialer-reads-a-jvm-server \"transit\" done)))\n\n\n(deftest a-node-dialer-reads-a-jvm-server-over-cbor\n  (async done (a-node-dialer-reads-a-jvm-server \"cbor\" done)))\n\n\n(deftest a-jvm-dialer-serves-back-over-one-node-connection-over-transit\n  (async done (a-jvm-dialer-serves-back-over-one-node-connection \"transit\" done)))\n\n\n(deftest a-jvm-dialer-serves-back-over-one-node-connection-over-cbor\n  (async done (a-jvm-dialer-serves-back-over-one-node-connection \"cbor\" done)))\n\n\n(defn- p1-corpus-chain\n  []\n  [p1-descriptor p1-dialer p1-corpus p1-corpus-back p1-sessions])\n\n\n(defn- p2-corpus-chain\n  []\n  [p2-bound p2-spawn p2-ready\n   (fn [acc] (p2-attach (assoc acc :identity corpus/identity-name)))\n   p2-probe-confirmed p2-corpus-forward p2-corpus-back p2-one-session p2-quit])\n\n\n(deftest corpus-jvm-serves-node-decodes-over-transit\n  (async done (a-node-dialer-reads-a-jvm-server \"transit\" done (p1-corpus-chain))))\n\n\n(deftest corpus-jvm-serves-node-decodes-over-cbor\n  (async done (a-node-dialer-reads-a-jvm-server \"cbor\" done (p1-corpus-chain))))\n\n\n(deftest corpus-both-directions-jvm-dials-node-serves-over-transit\n  (async done (a-jvm-dialer-serves-back-over-one-node-connection\n                \"transit\" done (p2-corpus-chain))))\n\n\n(deftest corpus-both-directions-jvm-dials-node-serves-over-cbor\n  (async done (a-jvm-dialer-serves-back-over-one-node-connection\n                \"cbor\" done (p2-corpus-chain))))\nsed: test/dao/stream/ws_project_peer.clj: No such file or directory\n   510\t        published (full-publication initial)\n   511\t        recovered (repl.index/rehydrate initial {:manifest (:manifest-address published)\n   512\t                                                 :datoms datoms})\n   513\t        _ (stream/append! writer (literal-packet 99))\n   514\t        resumed (repl.index/step recovered 1)\n   515\t        txs (mapv :dao.space/transac