te rows, ruled origins, version 1,\n   574\t   unique ownership of each application, exact coverage.\"\n   575\t  [program tables]\n   576\t  (let [tree (vm/ast->semantic-bytecode (:ast program))\n   577\t        root (:root tree)\n   578\t        eligible (into #{}\n   579\t                       (map (fn [[r p]] [r p]))\n   580\t                       (vm/application-occurrences tree))\n   581\t        candidates (into []\n   582\t                         (filter (fn [[[origin r] _rows]]\n   583\t                                   (and (= r root)\n   584\t                                        (vector? origin)\n   585\t                                        (= :source (first origin))\n   586\t                                        (= (:t program) (nth origin 2 nil))\n   587\t                                        (vm/occurrence-origin? origin))))\n   588\t                         (or tables {}))]\n   589\t    (when (= 1 (count candidates))\n   590\t      (let [rows (filterv (fn [row]\n   591\t                            (and (sequential? row)\n   592\t                                 (<= 4 (count row))\n   593\t                                 (= call-site-key (nth row 3))))\n   594\t                          (second (first candidates)))\n   595\t            claimed (into #{}\n   596\t                          (map (fn [row] [(nth row 1) (nth row 2)]))\n   597\t                          rows)]\n   598\t        (when (and (every? (fn [row]\n   599\t                             (and (= 5 (count row))\n   600\t                                  (vm/occurrence-origin? (nth row 0))\n   601\t                                  (= root (nth row 1))\n   602\t                                  (= 1 (nth row 4))))\n   603\t                           rows)\n   604\t                   (= (count rows) (count claimed))\n   605\t                   (= eligible claimed))\n   606\t          rows)))))\n   607\t\n   608\t\n   609\t(defn- sequenced-prefixes\n   610\t  \"The path prefi