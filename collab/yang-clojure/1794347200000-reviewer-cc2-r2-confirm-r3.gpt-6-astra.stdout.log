t                          (< 1 (count origins))\n   332\t                          (update acc :unmapped into\n   333\t                                  (map (fn [o]\n   334\t                                         {:kind :unmapped\n   335\t                                          :input [o (:root tree) path]\n   336\t                                          :reason :ambiguous})\n   337\t                                       origins))\n   338\t\n   339\t                          (not (contains? eligible path))\n   340\t                          (update acc :unmapped conj\n   341\t                                  {:kind :unmapped\n   342\t                                   :input [(first (first rs)) (:root tree) path]\n   343\t                                   :reason :no-such-occurrence})\n   344\t\n   345\t                          :else\n   346\t                          (let [o (first (first rs))\n   347\t                                out (get surviving path)]\n   348\t                            (if (contains? derived-eligible out)\n   349\t                              (-> acc\n   350\t                                  (update :entries conj\n   351\t                                          {:kind :surviving\n   352\t                                           :input [o (:root tree) path]\n   353\t                                           :output [o (:root derived) out]})\n   354\t                                  (update :rows into\n   355\t                                          (map (fn [r]\n   356\t                                                 [o (:root derived) out\n   357\t                                                  call-site-key (nth r 4)])\n   358\t                                               rs)))\n   359\t                              (update acc :unmapped conj\n   360\t                                      {:kind :unmapped\n   361\t                                       :input [o (:root tree) path]\n   362\t                                       :reason :output-not-an-application}))))))\n   363\t                    {:entries [] :rows [] :unmapped []}\n   364\t                    (sort-by (comp pr-str key) by-path))\n   365\t            verified-injected (filterv derived-eligible (sorted injected))\n   366\t            refused-injected (map (fn [p]\n   367\t                                    {:kind :unmapped :path p\n   368\t                                     :reason :output-not-an-application})\n   369\t                                  (remove derived-eligible (sorted injected)))\n   370\t            injected-entries (map (fn [p]\n   371\t                                    (cond-> {:kind :safepoint/injected :path p}\n   372\t                                      injected-origin\n   373\t                                      (assoc :origin injected-origin)))\n   374\t                                  verified-injected)\n   375\t            injected-rows (when injected-origin\n   376\t                            (map (fn [p]\n   377\t                                   [injected-origin (:root derived) p\n   378\t                                    call-site-key 1])\n   379\t                                 verified-injected))]\n   380\t        {:metadata (vec (sort jing/canonical-compare\n   381\t                              (distinct (into (:rows parts) injected-rows))))\n   382\t         :correspondence {:input-root (:root tree)\n   383\t                          :output-root (:root derived)\n   384\t                          :entries (into (sorted (:entries parts))\n   385\t                                         (into injected-entries\n   386\t                                               (sorted (into (:unmapped parts)\n   387\t                                                             refused-injected))))}}))))\n   388\t\n   389\t\n   390\t(defn derive-record\n   391\t  \"The `:derive` record linking canonical root `input` to derived root\n   392\t   `output`: function `functi