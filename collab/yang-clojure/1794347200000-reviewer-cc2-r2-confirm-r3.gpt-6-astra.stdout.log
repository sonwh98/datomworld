srows))))\n   198\t        (throw (ex-info \"Conflicting call-site marker values\"\n   199\t                        {:rule :yang/call-site-conflict, :site site,\n   200\t                         :values (vec (distinct (map #(nth % 4) srows)))}))))\n   201\t    ;; one occurrence — one [root-address path] — has exactly one\n   202\t    ;; origin (design §2.1); a second marker with a DIFFERENT, equally\n   203\t    ;; well-formed origin for an already-covered occurrence is a\n   204\t    ;; second claim to one fact and is rejected, not folded into the\n   205\t    ;; [root path] coverage projection. The one-origin-per-occurrence\n   206\t    ;; rule holds in EVERY validator mode; the default mode rejects a\n   207\t    ;; second claim with the same diagnostic (not a downstream\n   208\t    ;; nonexistent-path error) so the failure names the occurrence and\n   209\t    ;; both claims.\n   210\t    (doseq [[site srows] (group-by (fn [[_ r path]] [r path]) rows)]\n   211\t      (let [origins (distinct (map #(nth % 0) srows))]\n   212\t        (when (< 1 (count origins))\n   213\t          (throw (ex-info\n   214\t                   \"Call-site occurrence claimed by multiple origins\"\n   215\t                   {:rule :yang/call-site-multi-claim, :site site,\n   216\t                    :origins (vec (sort-by pr-str origins))})))))\n   217\t    (doseq [[o r path _ value] rows]\n   218\t      (when (not= call-site-version value)\n   219\t        (throw (ex-info \"Unsupported call-site marker version\"\n   220\t                        {:rule :yang/call-site-unsupported-version,\n   221\t                         :site [o r path], :value value})))\n   222\t      (when (and per-occurrence-origins? (not (vm/occurrence-origin? o)))\n   223\t        (throw (ex-info \"Call-site marker carries a malformed occurrence origin\"\n   224\t                        {:rule :yang/call-site-invalid-origin,\n   225\t                         :site [o r path], :origin o})))\n   226\t      (let [