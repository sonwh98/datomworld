                   (mem/create-content-mem) spec)]\n  1689\t                        (and (empty? (filter #(= :yang/call-site (nth % 3))\n  1690\t                                             (:frontend-metadata side)))\n  1691\t                             (not (contains? spec :call-site-rows))\n  1692\t                             (jing/segment-address? (:address res))\n  1693\t                             (not (contains? res :call-sites)))))]\n  1694\t    (testing \"stale-admission tables (rekeyed under another admission)\n  1695\t              prove nothing for the indexed programs\"\n  1696\t      (let [stale (into {}\n  1697\t                        (map (fn [[[_o root] rs]]\n  1698\t                               [[[:source \"stale-admission\" 99 0] root] rs]))\n  1699\t                        tables)\n  1700\t            spec (publish/module-from-index\n  1701\t                   db {:name 'closed :exports '[g] :primitives vm/primitives\n  1702\t                       :call-site-tables stale})]\n  1703\t        (is (claim-free? spec)\n  1704\t            \"identical content under a different admission is not borrowed\")))\n  1705\t    (testing \"a wrong-version retained table proves nothing\"\n  1706\t      (let [bad (into {}\n  1707\t                      (map-indexed (fn [i [k rs]]\n  1708\t                                     [k (if (zero? i)\n  1709\t                                          (assoc-in rs [0 4] 2)\n  1710\t                                          rs)])\n  1711\t                      tables))\n  1712\t            spec (publish/module-from-index\n  1713\t                   db {:name 'closed :exports '[g] :primitives vm/primitives\n  1714\t                       :call-site-tables bad})]\n  1715\t        (is (claim-free? spec))))\n  1716\t    (testing \"an incomplete retained table proves nothing\"\n  1717\t      (let [bad (into {}\n  1718\t                      (map-indexed (fn [i [k rs]]\n  1719\t                                     [k (if (