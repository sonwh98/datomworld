47\t                            {:rule :yang/call-site-multi-claim, :site site,\n   348\t                             :origins (vec (sort-by pr-str origins))})))))\n   349\t      (let [eligible (into #{}\n   350\t                           (map (fn [[r p]] [r p]))\n   351\t                           (vm/application-occurrences tree))\n   352\t            claimed (into #{}\n   353\t                          (map (fn [row] [(nth row 1) (nth row 2)]))\n   354\t                          claimed-rows)]\n   355\t        (when (not= eligible claimed)\n   356\t          (throw (ex-info \"Call-site markers do not cover the projected tree\"\n   357\t                          {:rule :yang/call-site-incomplete-coverage,\n   358\t                           :missing (vec (sort-by pr-str\n   359\t                                                  (remove claimed eligible))),\n   360\t                           :extra (vec (sort-by pr-str\n   361\t                                                (remove eligible claimed)))})))))))\n   362\t\n   363\t\n   364\t(defn program-batch\n   365\t  \"Encode frontend output as the expander's input batch (§2.1):\n   366\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows\n   367\t   call-site-claims]` — the trailing element present only when some\n   368\t   member claimed call-site (C1) coverage, holding one boolean verdict\n   369\t   per member, so every unclaimed batch keeps the five-element shape.\n1301:  [attempt source-batch origin parent input-root call-path macro-root output-root\n1303:  (intern-row [:yin.macro/expand attempt source-batch origin parent input-root\n1308:  [ctx source-batch tree-index]\n1309:  [:source (:source-medium ctx) source-batch tree-index])\n1413:                           (:source-batch st)\n1415:                             (source-origin ctx (:source-batch st) (:tree-index frame)))\n1659:        source-batch (:t ctx)\n1660:        base {:ctx ctx, :source-batch source-batch, :events [], :prod