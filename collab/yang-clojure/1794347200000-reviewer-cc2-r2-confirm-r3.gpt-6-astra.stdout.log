n v, :path p})\n   646\t        (let [well-formed? (and (every? (fn [row]\n   647\t                                          (and (= 5 (count row))\n   648\t                                               (vm/occurrence-origin? (nth row 0))\n   649\t                                               (= (:root tree) (nth row 1))))\n   650\t                                        claimed-rows)\n   651\t                                (= (count claimed-rows)\n   652\t                                   (count (into #{}\n   653\t                                                (map (fn [row]\n   654\t                                                       [(nth row 1) (nth row 2)]))\n   655\t                                                claimed-rows))))\n   656\t              covered (into #{}\n   657\t                            (map (fn [row] [(nth row 1) (nth row 2)]))\n   658\t                            claimed-rows)]\n   659\t          (if (and well-formed? (empty? (remove eligible covered)))\n   660\t            {:origin origin,\n   661\t             :rows (vec (sort jing/canonical-compare\n   662\t                              (into claimed-rows\n   663\t                                    (map (fn [[r p]]\n   664\t                                           [origin r p call-site-key 1]))\n   665\t                                    (remove covered eligible))))}\n   666\t            {:missing (vec (sort-by pr-str (remove covered eligible))),\n   667\t             :extra (vec (sort-by pr-str (remove eligible covered)))})))))\n   668\t\n   669\t\n   670\t(defn- sequenced\n   671\t  \"One tree running `asts` in order: `((fn [_] second) first)`, nested.\n   672\t   A program root in operand position is not a tail call.  No programs\n   673\t   is `no-op-tree`.\"\n   674\t  [asts]\n   675\t  (if (empty? asts)\n   676\t    no-op-tree\n   677\t    (reduce (fn [body ast]\n   678\t              {:type :application\n   679\t               :tail? true\n   680\t               :operator {:type :lambda :params '[_] :body body}\n   681\t               :operands [(cond-> ast\n   682\t                            (= :application (:type ast)) (assoc :tail? false))]})\n   683\t            (peek asts)\n   684\t            (rseq (pop asts)))))\n   685\t\n   686\t\n   687\t(defn- free-declaration\n   688\t  \"How the module declares the free name `n`: `[:requires module\n   689\t   address]`, `[:primitives n profile]`, or a refusal.\"\n   690\t  [n {:keys [primitives modules host-modules]}]\n   691\t  (let [module (some-> (namespace n) symbol)]\n   692\t    (cond\n   693\t      (and module (contains? modules module))\n   694\t      [:requires module (get modules module)]\n   695\t\n   696\t      (and module (contains? (set host-modules) module))\n   697\t      (refusal :yin.link.publish/host-module {:name n :module module})\n   698\t\n   699\t      (and (nil? module) (contains? primitives n))\n   700\t      [:primitives n (vm/profile-of primitives n)]\n   701\t\n   702\t      :else (refusal :yin.link.publish/undeclared-free {:name n}))))\n   703\t\n   704\t\n   705\t(defn module-from-index\n   706\t  \"`publish-module!`'s spec for the module `name` exporting `exports`,\n   707\t   derived from the indexed code of `db` (section 5.3), or a refusal.\n   708\t   Persists nothing.\n   709\t\n   710\t   The defining program of a symbol is the indexed program of greatest\n   711\t   `t` defining it at module level.  The exports' defining programs are\n   712\t   collected, then the defining program of every free name they hold\n   713\t   that some indexed program defines, and, for each linked module a free\n   714\t   qualified name declares, the latest program requiring that module at\n   715\t   module level (refused `:yin.link.publish/missing-require-program`\n   716\t   naming the module when none does), to a fixed point; the tree is the\n   717\t   collected programs, each once, in ascending `t`.  Each remaining free name is a\n   718\t   primitive of `primitives` (declared with its profile), or qualified by\n   719\t   a module of `modules` -- `{name manifest-address}`, the modules the\n   720\t   session linked -- (declared under `:requires`).  A name qualified by\n   721\t   one of `host-modules` refuses `:yin.link.publish/host-module`, any\n   722\t   other `:yin.link.publish/undeclared-free`.\n   723\t\n   724\t   Indexed programs are reconstructed from datoms and carry no C1\n   725\t   markers. With `opts`' `:call-site-tables` — the expander's retained\n   726\t   tables (`yin.vm.macro/call-site-table` custody) — proof is resolved\n   727\t   per collected program by its actual admission identity\n   728\t   (`retained-call-site-rows`): a program proven C1-finalized has its\n   729\t   markers recovered and its retained rows shifted into the assembled\n   730\t   tree's coordinates on the spec's `:call-site-rows`, keeping each\n   731\t   occurrence's own origin through assembly; the `sequenced` wrappers\n   732\t   this derivation synthesizes are claimed separately at publication\n   733\t   under the publication admission origin (`publish-module!`'s\n   734\t   recovered claim). Without such proof for every collected program\n   735\t   the tree stays unmarked and publishes without a C1 claim; markers\n   736\t   are never minted for a recovered tree.\"\n   737\t  [db {:keys [name exports modules call-site-tables] :as opts}]\n   738\t  (let [programs (mapv (fn [p]\n   739\t                         (assoc p\n   740\t                                :defines (definitions (:ast p))\n   741\t                                :requires (requirements (:ast p))\n   742\t                                :free (free-of (:ast p))))\n   743\t                       (indexed-programs db))\n   744\t        defining (fn [sym]\n   745\t                   (last (filter #(contains? (:defines %) sym) programs)))\n   746\t        requiring (fn [module]\n   747\t                    (last (filter #(contains? (:requires %) module) programs)))\n   748\t        ;; the linked modules the collected programs' free qualified names\n   749\t        ;; declare as requirements (closure by linked requirements)\n   750\t        linked (fn [ps]\n   751\t                 (sort-by str\n   752\t                          (distinct\n   753\t                            (keep (fn [n]\n   754\t                                    (let [m (some-> (namespace n) symbol)]\n   755\t                                      (when (and m (not (defining n))\n   756\t                                                 (contains? modules m))\n   757\t                                        m)))\n   758\t                                  (mapcat :free ps)))))\n   759\t        undefined (first (remove defining exports))]\n   760\t    (if undefined\n   761\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   762\t      (let [collected (loop [ms (set (map (comp :m defining) exports))]\n   763\t                        (let [ps (filterv #(contains? ms (:m %)) programs)\n   764\t                              unrequired (first (remove requiring (linked ps)))\n   765\t                              more (-> ms\n   766\t                                       (into (keep (comp :m defining))\n   767\t                                             (mapcat :free ps))\n   768\t                                       (into (keep (comp :m requiring))\n   769\t                                             (linked ps)))]\n   770\t                          (cond\n   771\t                            unrequired\n   772\t                            (refusal :yin.link.publish/missing-require-program\n   773\t                                     {:module unrequired})\n   774\t\n   775\t                            (= more ms) ps\n   776\t                            :else (recur more))))\n   777\t            declared (when (vector? collected)\n   778\t                       (map #(free-declaration % opts)\n   779\t                            (sort-by str\n   780\t                                     (remove defining\n   781\t                                             (distinct (mapcat :free collected))))))]\n   782\t        (or (when (map? collected) collected)\n   783\t            (some #(when (map? %) %) declared)\n   784\t            (let [asts (mapv :ast collected)\n   785\t                  recovered (mapv #(retained-call-site-rows % call-site-tables)\n   786\t                                  collected)\n   787\t                  proven? (and (seq asts) (every? some? recovered))\n   788\t                  assembled (sequenced asts)\n   789\t                  final-root (when proven?\n   790\t                               (:root (vm/ast->semantic-bytecode assembled)))\n   791\t                  shifted (when proven?\n   792\t                            (vec (sort jing/canonical-compare\n   793\t                                       (into []\n   794\t                                             (mapcat (fn [[prefix rows]]\n   795\t                                                       (map (fn [[o _r p k v]]\n   796\t                                                              [o final-root\n   797\t                                                               (into prefix p)\n   798\t                                                               k v])\n   799\t                                                            rows)))\n   800\t                                             (map vector\n   801\t                                                  (sequenced-prefixes\n   802\t                                                    (count asts))\n   803\t                                                  recovered)))))]\n   804\t              (cond-> {:name name\n   805\t                       :ast (cond-> assembled proven? mark-call-sites)\n   806\t                       :exports (set exports)\n   807\t             :requires (into {}\n   808\t                             (keep (fn [[k n a]] (when (= :requires k) [n a])))\n   809\t                             declared)\n   810\t                       :primitives (into {}\n   811\t                                     (keep (fn [[k n p]]\n   812\t                                             (when (= :primitives k) [n p])))\n   813\t                                     declared)}\n   814\t                proven? (assoc :call-site-rows shifted))))))))\n   815\t\n   816\t\n   817\t;; =============================================================================\n   818\t;; Name envelopes (6.1, 6.5, 6.6)\n   819\t;; =============================================================================\n   820\t\n   821\t(defn- signed\n   822\t  [key env e]\n   823\t  (let [proof (sign/sign-envelope (:seed key) env)\n   824\t        e (if (some? e) e -1)]\n   825\t    {:envelope env\n   248\t        injected (atom #{})]\n   249\t    (letfn [(walk2\n   250\t                [node in-path out-path]\n   251\t                (let [site (get hooks in-path)]\n   252\t                  (cond\n   253\t                    (and site (or (:statement? site) (:sequence? site)))\n   254\t                    (do (swap! injected conj out-path (conj out-path [3 0]))\n   255\t                        (walk-self2 node in-path (conj out-path 2 3)))\n   256\t\n   257\t                    (and site (= :lambda (:type node)))\n   258\t                    (let [{:keys [enter exit]} site\n   259\t                          ;; hook construction prepends the mark's literal\n   260\t                          ;; operands, so the wrapped body is the exit\n   261\t                          ;; hook's operand at index (count operands)\n   262\t                          body-operand (count (:operands exit))\n   263\t                          body-out (into out-path\n   264\t                                         (cond\n   265\t                                           (and enter exit)\n   266\t                                           [3 2 3 [3 body-operand]]\n   267\t                                           enter [3 2 3]\n   268\t                                           exit [3 [3 body-operand]]\n   269\t                                           :else [3]))]\n   270\t                      (when enter\n   271\t                        (swap! injected conj (conj out-path 3)\n   272\t                               (into out-path [3 [3 0]])))\n   273\t                      (when exit\n   274\t                        (swap! injected conj\n   275\t                               (if enter (conj out-path 3 2 3) (conj out-path 3))))\n   276\t                      (walk2 (:body node) (conj in-path 3) body-out))\n   277\t\n   278\t                    :else (walk-self2 node in-path out-path))))\n   279\t              (walk-self2\n   280\t                [node in-path out-path]\n   281\t                (when (= :application (:type node))\n   282\t                  (swap! surviving assoc in-path out-path))\n   283\t                (doseq [[j [field kind]] (map-indexed vector\n   284\t                                                      (get vm/semantic-bytecode-grammar\n   285\t                                                           (:type node)))\n   286\t                        :let [pos (+ j 2)\n   287\t                              value (get node field)]]\n   288\t                  (case kind\n   289\t                    :node (walk2 value (conj in-path pos) (conj out-path pos))\n   290\t                    :nodes (doseq [[i child] (map-indexed vector (or value []))]\n   291\t                             (walk2 child (conj in-path [pos i])\n   292\t                                    (conj out-path [pos i])))\n   293\t                    nil)))]\n   294\t        (walk2 ast [] []))\n   295\t      {:surviving @surviving :injected @injected}))\n   296\t\n   297\t\n   298\t(defn- derive-call-sites\n   299\t  \"Recompute the C1 rows of the derived tree from the input tree's own\n   300\t   rows: `{:metadata rows :corre