\n405\t(defn- read-namespaced-map\n406\t  [s n i ctx]\n407\t  ;; s[i] is \":\" right after \"#\"\n408\t  (let [[tok next-i] (read-token s n (inc i))\n409\t        _ (when (or (empty? tok) (str/starts-with? tok \":\") (str/includes? tok \"/\"))\n410\t            (reader-error! (str \"Invalid namespaced map prefix: #:\" tok) {:index i}))\n411\t        open-i (skip-ws-and-comments s n next-i)]\n412\t    (when (or (>= open-i n) (not= 123 (char-code (char-at s open-i))))\n413\t      (reader-error! (str \"Namespaced map #:\" tok \" must specify a map\") {:index open-i}))\n414\t    (let [[items end-i] (read-delimited s n (inc open-i) 125 ctx)]\n415\t      (when (odd? (count items))\n416\t        (reader-error! \"Namespaced map literal must contain an even number of forms.\" {:index open-i}))\n417\t      (let [namespaced (mapcat (fn [[k v]] [(apply-map-namespace tok k) v])\n418\t                               (partition 2 items))]\n419\t        [(build-checked-map namespaced open-i) end-i]))))\n420\t\n421\t\n422\t(defn- read-next-required\n423\t  [s n i ctx what]\n424\t  (loop [j i]\n425\t    (let [j (skip-ws-and-comments s n j)]\n426\t      (when (>= j n)\n427\t        (reader-error! (str \"EOF while reading \" what) {:index i}))\n428\t      (let [[val next-j] (read-form* s n j ctx)]\n429\t        (if (= val ::discard)\n430\t          (recur next-j)\n431\t          [val next-j])))))\n432\t\n433\t\n434\t(defn- read-meta\n435\t  [s n i ctx]\n436\t  ;; s[i] is ^\n437\t  (let [[raw-meta next-i] (read-next-required s n (inc i) ctx \"metadata\")\n438\t        meta-map (cond\n439\t                   (map? raw-meta) raw-meta\n440\t                   (keyword? raw-meta) {raw-meta true}\n441\t                   (or (symbol? raw-meta) (string? raw-meta)) {:tag raw-meta}\n442\t                   :else (reader-error! \"Metadata must be Symbol, Keyword, String or Map\"\n443\t                                        {:meta raw-meta :index i}))\n444\t        [target end-i] (read-next-requi