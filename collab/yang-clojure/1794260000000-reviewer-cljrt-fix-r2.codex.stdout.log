                             :yang.call/entry)]\n  2152\t                                        (data/callable? dsg__entry))\n  2153\t                                      (let [dsg__entry\n  2154\t                                            (dsg__get dsg__candidate\n  2155\t                                                      :yang.call/entry)\n  2156\t                                            dsg__witness\n  2157\t                                            (dsg__get dsg__candidate\n  2158\t                                                      :clj/admission)]\n  2159\t                                        (if (data/callable? dsg__entry)\n  2160\t                                          (dsg__equal\n  2161\t                                            dsg__witness\n  2162\t                                            (dsg__make_admission\n  2163\t                                              (dsg__assoc dsg__candidate\n  2164\t                                                          :clj/admission\n  2165\t                                                          nil)))\n  2166\t                                          false))))\n  2167\t                                  false))))\n  2168\t         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n  2169\t         (outcomes? env) (u/let1\n  2170\t                           'dsg__make_admission\n  2171\t                           (u/sexp->uast\n  2172\t                             '(fn [dsg__descriptor]\n  2173\t                                (fn [dsg__candidate]\n  2174\t                                  (if (data/callable? dsg__call_token)\n  2175\t                                    (dsg__get dsg__descriptor :yang.call/entry)\n  2176\t                                    nil)))))\n  2177\t         (outcomes? env) (u/then\n  2178\t                           (discard-result\n  2179\t                             (u/app (u/lam '[get = assoc empty?] call/uast)\n  2180\t                                    (u/v 'dsg__get) (u/v 'dsg__equal)\n  2750\t\n  2751\t(defn- publish-to-globals\n  2752\t  \"Rewrite the compiled `node` for the linked unit: a top-level\n  2753\t   definition in `names` becomes a `clj/define-global!` write and a free\n  2754\t   read of one becomes a `clj/global-get`, both under the name's string.\n  2755\t   The `names` a unit is lowered with are its own top-level definitions,\n  2756\t   its guest library's and the projected names the composition bound in\n  2757\t   the runtime global namespace, so a projected export and a definition\n  2758\t   read through the one binding: a definition the unit itself runs\n  2759\t   publishes after the projection and shadows it. A store definition\n  2760\t   inside the unit thunk is conditional to the linker, so no body read\n  2761\t   of it discharges (the runtime preludes avoid this by keeping every\n  2762\t   definition at module level); the runtime global namespace is the\n  2763\t   linked unit's definition table instead, as a Python module body\n  2764\t   writes its dictionary. Lexically bound names, quoted literals and\n  2765\t   macro definitions keep their store shape: a macro is not a runtime\n  2766\t   value.\"\n  2767\t  [node names bound]\n  2768\t  (case (:type node)\n  2769\t    :literal node\n  2770\t    :vm/current-continuation node\n  2771\t    :variable (if (and (contains? names (:name node))\n  2772\t                       (not (contains? bound (:name node))))\n  2773\t                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\n  2774\t                node)\n  2775\t    :lambda (assoc node :body (publish-to-globals (:body node) names\n  2776\t                                                  (into bound (:params node))))\n  2777\t    :application\n  2778\t    (if (and (= 'yin/def (get-in node [:operator :name]))\n  2779\t             (= 2 (count (:operands node)))\n  2780\t             (= :literal (:type (first (:operands node))))\n  2781\t             (contains? names (:value (first (:operands node)))))\n  2782\t      (u/app (u/v 'clj/define-global!)\n  2783\t             (u/lit (str (:value (first (:operands node)))))\n  2784\t             (publish-to-globals (second (:operands node)) names bound))\n  2785\t      (assoc node\n  2786\t             :operator (publish-to-globals (:operator node) names bound)\n  2787\t             :operands (mapv #(publish-to-globals % names bound)\n  2788\t                             (:operands node))))\n  2789\t    :if (cond-> node\n  2790\t          (contains? node :test)\n  2791\t          (assoc :test (publish-to-globals (:test node) names bound))\n  2792\t          (contains? node :consequent)\n  2793\t          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n  2794\t          (contains? node :alternate)\n  2795\t          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n  2796\t    (reduce (fn [n k]\n  2797\t              (let [v (get n k)]\n  2798\t                (if (or (and (map? v) (contains? v :type)) (vector? v))\n  2799\t                  (assoc n k (globals-child v names bound))\n  2800\t                  n)))\n  2801\t            node (keys node))))\n  2802\t\n  2803\t\n  2804\t(defn lower-unit\n  2805\t  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n  2806\t   thunk whose call runs the program — `forms` plus the definitions of\n  2807\t   the guest library they need, compiled unmodified under `unit-opts`\n  2808\t   and published to the runtime global namespace by\n  2809\t   `publish-to-globals` — so the helper's export projection can read\n  2810\t   each top-level definition. The two-argument form also takes the\n  2811\t   projected `exports` (names the composition already bound in the\n  2812\t   runtime global namespace): their free reads publish the same way, so\n  2813\t   the projection is the caller's binding for them. The program's own\n  2814\t   `yang.call` call sites need no free-name declaration: the convention\n  2815\t   preamble `compile-program` emits defines those names locally, and\n  2816\t   the donor publication pins the `yang.call` module for the qualified\n  2817\t   reads that remain.\"\n  2818\t  ([forms] (lower-unit forms []))\n  2819\t  ([forms exports]\n  2820\t   (let [source (vec forms)\n  2821\t         library (library-for source)\n  2822\t         program (compile-program (concat source library) true unit-opts)\n  2823\t         macros (into #{}\n  2824\t                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n  2825\t                            (map (comp strip-symbol-meta second)))\n  2826\t                      (concat source library))\n  2827\t         names (reduce disj\n  2828\t                       (into (set (top-level-names source))\n  2829\t                             (concat (map (comp strip-symbol-meta second) library)\n  2830\t                                     (map symbol exports)))\n  2831\t                       macros)]\n  2832\t     (u/lam [] (publish-to-globals program names #{})))))\n  2833\t\n  2834\t\n  2835\t(defn output\n  2836\t  \"The `clj/run-main` value as test data.\"\n  2837\t  [value]\n  2838\t  (pr-str value))\n    35\t   convention's call-address, as the other runtimes do, and refuses before\n    36\t   anything is published when a free name nothing supplies is read.\"\n    37\t  (:require [yang.core.prelude :as core]\n    38\t            [yang.clojure :as yang]\n    39\t            [yin.vm :as vm]\n    40\t            [yin.vm.data :as data]\n    41\t            [yin.vm.module :as module]))\n    42\t\n    43\t\n    44\t(def module-name\n    45\t  \"The linker module name of the clojure runtime.\"\n    46\t  'clj)\n    47\t\n    48\t\n    49\t(def runtime-keys\n    50\t  \"Every runtime key, each with an `:clj/uninit` placeholder at module\n    51\t   level so every read is discharged before `clj/init!` allocates the\n    52\t   real cell. They stay qualified: internal store keys, never guest\n    53\t   names.\"\n    54\t  '[clj.rt/state clj.rt/globals])\n    55\t\n    56\t\n    57\t(def definitions\n    58\t  \"The module's definition list, in prelude notation (the module's own\n    59\t   `clj/` prefix is stripped on emit).\"\n    60\t  '[;; ------------------------------------------------- state and namespace\n    61\t    [clj/init!\n    62\t     (fn []\n    63\t       (if (= clj.rt/state :clj/uninit)\n    64\t         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n    65\t             (yin/def (quote clj.rt/state) :clj/ready))\n    66\t         :clj/ready))]\n    67\t    ;; the runtime global namespace: one task-local map in a cell, keyed by\n    68\t    ;; export name. `clj/define-global!` answers the value, so a publish\n    69\t    ;; sequence can chain through it.\n    70\t    [clj/define-global!\n    71\t     (fn [name value]\n    72\t       (do (cell/set! clj.rt/globals\n    73\t                      (assoc (cell/get clj.rt/globals) name value))\n    74\t           value))]\n    75\t    [clj/global-get\n    76\t     (fn [name]\n    77\t       (if (data/contains? (cell/get clj.rt/globals) name)\n    78\t         (get (cell/get clj.rt/globals) name)\n    79\t         :clj/unbound))]\n    80\t\n    81\t    ;; ------------------------------------------------------------- entry\n    82\t    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n    83\t    ;; internal, so the entry removes one wrapper level from the\n    84\t    ;; program's value (a program returning that vector as data was\n    85\t    ;; wrapped again, so one level is exact). An error outcome passes\n    86\t    ;; through as the failure value for the caller to render.\n    87\t    [clj/unwrap-outcome\n    88\t     (fn [value]\n    89\t       (if (if (data/vector? value) (= (data/count value) 2) false)\n    90\t         (if (= (data/nth value 0) :yin.k/ok)\n    91\t           (data/nth value 1)\n    92\t           value)\n    93\t         value))]\n    94\t    ;; The global namespace is the task's, not the entry's: no reset\n    95\t    ;; here, so projections and earlier units' definitions survive.\n    96\t    [clj/run-main\n    97\t     (fn [body]\n    98\t       (do (clj/init!)\n    99\t           (clj/unwrap-outcome (body))))]])\n   100\t\n   101\t\n   102\t(def module-definitions\n   103\t  \"The module's definition list: an `:clj/uninit` placeholder for every\n   104\t   runtime key, then every definition, stripped.\"\n   105\t  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n   105\t     (fn [x]\n   106\t       (if (js/cell? x) (= (get (cell/get x) :js/type) :symbol) false))]\n   107\t    [js/object? (fn [x] (if (js/cell? x) (not (js/symbol? x)) false))]\n   108\t    [js/make-symbol\n   109\t     (fn [description]\n   110\t       (cell/new (assoc (assoc {} :js/type :symbol) :description description)))]\n   111\t    [js/str?\n   112\t     (fn [x]\n   113\t       (if (nil? (get x :js/str)) (not (nil? (get x :js/units))) true))]\n   114\t    [js/pair (fn [a b] (conj (conj [] a) b))]\n   115\t    [js/vconj (fn [xs x] (conj xs x))]\n   116\t    [js/arg (fn [args i] (get args i :js/undefined))]\n   117\t    [js/kind-of\n   118\t     ;; undefined null boolean number bigint string function object. A\n   119\t     ;; number is float64 content, a bigint a bare exact integer: content\n   120\t     ;; equality with the same value as float64 tells them apart on every\n   121\t     ;; host (the JS carrier is not a host number at all)\n   122\t     (fn [x]\n   123\t       (if (= x :js/undefined)\n   124\t         :undefined\n   125\t         (if (= x :js/null)\n   126\t           :null\n   127\t           (if (= x true)\n   128\t             :boolean\n   129\t             (if (= x false)\n   130\t               :boolean\n   131\t               (if (data/number? x)\n   132\t                 (if (data/content= x (data/float64 x)) :number :bigint)\n   133\t                 (if (js/str? x)\n   134\t                   :string\n   135\t                   (if (js/cell? x)\n   136\t                     (if (= (get (cell/get x) :js/type) :function)\n   137\t                       :function\n   138\t                       (if (= (get (cell/get x) :js/type) :symbol)\n   139\t                         :symbol\n   140\t                         ;; A cell-backed foreign callable (a python\n   141\t                         ;; or PHP function: a cell whose contents\n   142\t                         ;; carry a call entry, no :js/type) is a\n   143\t                         ;; function too, not an object.\n   144\t                         (if (yang.call/eligible? x) :function :object)))\n   145\t                     ;; An admitted foreign callable that is not a JS\n   146\t                     ;; cell (a clojure descriptor, a bound method) is\n   147\t                     ;; still a function; only a value no profile admits\n   148\t                     ;; keeps the bare-number fallback.\n   149\t                     (if (yang.call/eligible? x) :function :number)))))))))]\n   150\t    [js/ty (fn [k] (if (= k :function) :object k))]\n   151\t    [js/prim-type?\n   152\t     (fn [t]\n   153\t       (if (= t :string)\n   154\t         true\n   155\t         (if (= t :number) true (if (= t :symbol) true (= t :bigint)))))]\n   156\t    [js/callable?\n   157\t     (fn [x]\n   158\t       (yang.call/eligible? x))]\n   159\t    [js/mknum (fn [x] (data/float64 x))]\n   160\t    [js/fval (fn [x] (data/float-value x))]\n   161\t    [js/nan-raw (fn [] (let [i (data/float-value ##Inf)] (- i i)))]\n   162\t    [js/nan (fn [] (data/float64 (js/nan-raw)))]\n   163\t    [js/habs (fn [x] (if (< x 0) (- 0 x) x))]\n   164\t    [js/finite? (fn [x] (< (js/habs x) (data/float-value ##Inf)))]\n   165\t    [js/zero-d? (fn [x] (= x (data/float-value 0)))]\n   120\t\n   121\t\n   122\t(deftest clojure-projection-through-runtime-globals-test\n   123\t  (testing \"the projected value is read via clj/global-get inside the caller's run\"\n   124\t    ;; `ts_apply` is no top-level definition of the caller, so its read\n   125\t    ;; inside `apply-it` reaches the runtime global namespace the helper\n   126\t    ;; projected into, not a task-store binding.\n   127\t    (is (= \"22\"\n   128\t           (xl/call [:typescript\n   129\t                     (str \"globalThis.ts_apply = f => { globalThis.stored = f; \"\n   130\t                          \"return stored === f ? f(20n) + 1n : -1n; };\")]\n   131\t                    [\"ts_apply\"]\n   132\t                    [:clojure\n   133\t                     \"(defn apply-it [] (ts_apply (fn [x] (+ x 1)))) (apply-it)\"]))))\n   134\t  (testing \"a second clj/run-main entry still sees the earlier unit's globals\"\n   135\t    (is (= \"42\"\n   136\t           (xl/call [:clojure \"(def answer 42)\"]\n   137\t                    [\"answer\"]\n   138\t                    [:clojure \"(defn get-answer [] answer) (get-answer)\"])))))\n   139\t\n   140\t\n   141\t(deftest clojure-caller-shadows-projected-global-test\n   142\t  (testing \"a caller-defined name shadows the projected one\"\n   143\t    ;; The caller's own `shared` runs: its definition publishes after the\n   144\t    ;; projection, so the runtime global holds the caller's function.\n   145\t    (is (= \"21\"\n   146\t           (xl/call [:clojure \"(defn shared [x] (+ x 100))\"]\n   147\t                    [\"shared\"]\n   148\t                    [:clojure \"(defn shared [x] (+ x 1)) (shared 20)\"])))))\n   149\t\n   150\t\n   151\t(deftest clojure-source-cell-ref-map-invocation-test\n   152\t  (testing \"a source map {:type :cell-ref} is ordinary invocable data\"\n   153\t    ;; The donor's exported function invokes its own source map literal:\n   154\t    ;; the map lookup answers 42, where the structural cell test used to\n   155\t    ;; dereference the map as a cell and fail the VM.\n   156\t    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n   157\t           (xl/call [:clojure\n   158\t                     \"(defn probe [] ({:type :cell-ref :marker 42} :marker))\"]\n   159\t                    [\"probe\"]\n   160\t                    [:typescript \"console.log(probe());\"])))))\n   161\t\n   162\t\n   163\t(deftest python-function-kind-of-in-typescript-test\n   164\t  (testing \"js/kind-of over a cell-backed foreign callable is :function\"\n   165\t    (is (= {:js/out [\"function\"], :js/uncaught nil}\n   166\t           (xl/call [:python \"def py_fn(x):\\n    return x + 1\\n\"]\n   167\t                    [\"py_fn\"]\n   168\t                    [:typescript \"console.log(typeof py_fn);\"])))))\n   169\t\n   170\t\n   171\t(deftest limits-test\n   172\t  (testing \"a PHP array returned to TS is an opaque handle, usable in PHP\"\n   173\t    (let [src \"<?php function phpfn($a = 7) { return $a === 7 ? [1, 2, 3] : count($a); }\"]\n   174\t      ;; the PHP int `count` returns reaches TS as an integer (`3n`), not a\n   175\t      ;; JS number: the two preludes keep their own number kinds\n","exit_code":0,"status":"completed"}}
