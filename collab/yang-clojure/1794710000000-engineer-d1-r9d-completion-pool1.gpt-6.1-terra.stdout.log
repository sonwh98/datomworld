stdout.log\ncollab/yin-ucf/1791262000000-architect-d10-kernel-scope-ruling.prompt.md\ncollab/yin-ucf/1791308000000-architect-d10b-grammar-ruling-astra-r2.gpt-6-astra.stdout.log\ncollab/yin-ucf/1791308000000-architect-d10b-grammar-ruling-astra.gpt-6-astra.stdout.log\ntest/yang/latte_oracle/slice9_oracle_test.txt\ntest/yang/latte_oracle/slice9_evidence.edn\ntest/yang/latte_oracle/slice9_unexercised.edn\ntest/yang/latte_oracle/slice9_kondo.txt\ntest/yang/latte_oracle/slice9_verification.edn\ntest/yang/latte_oracle/slice9_evidence_refresh.txt\ntest/yang/latte_oracle/slice9_declarations.edn\ntest/yang/latte_oracle/slice9_arity_accounting_test.txt\ntest/yang/latte_oracle/slice9_regression_test.txt\ntest/yang/latte_oracle/slice9_gate.md\ntest/yang/latte_oracle/slice9_site_tables.edn\ntest/yang/correspondence_test.cljc\ncollab/yin-ucf/1791374000000-architect-d15a-inbox-ruling-astra.gpt-6-astra.findings.md\ncollab/yin-ucf/1791380000000-architect-d16-exit-recovery-ruling-astra.gpt-6-astra.findings.md\ncollab/yin-ucf/1791320000000-architect-d14-seam-ruling-astra.gpt-6-astra.stdout.log\ncollab/yin-ucf/1791261000000-architect-d10-kernel-scope-ruling-astra.gpt-6-astra.stdout.log\ncollab/yin-ucf/1791262000000-architect-d10-kernel-scope-ruling-astra-r2.gpt-6-astra.stdout.log\ncollab/yin-ucf/1791380000000-architect-d16-exit-recovery-ruling-astra.gpt-6-astra.stdout.log\ncollab/yin-ucf/1791240000000-architect-d10-lower-inputs-ruling.gpt-6-astra.findings.md\ncollab/yin-ucf/1791379000000-architect-d15a-inbox-unavailable-ruling-astra.gpt-6-astra.stdout.log\ncollab/yin-ucf/1791308000000-architect-d10b-grammar-ruling-astra-r2.gpt-6-astra.findings.md\ncollab/yin-ucf/1791240000000-architect-d10-lower-inputs-ruling.prompt.md\ncollab/yin-ucf/1791240000000-architect-d10-lower-inputs-ruling.gpt-6-astra.stdout.log\ntest/yang/correspondence_text_test.clj\ntest/yang/correspondence_verifier_test.clj\ntest/yang/correspondence_batch_test.clj\nsrc/cljc/yang/correspondence.cljc\nsrc/cljc/yang/correspond