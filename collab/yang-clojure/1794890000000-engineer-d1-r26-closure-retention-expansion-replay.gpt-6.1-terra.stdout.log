{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/correspondence_probe_package_test.py <<'EOF'\n\\\"\\\"\\\"Tests for the scratch snapshot-probe package integrity boundary.\\\"\\\"\\\"\nimport hashlib\nimport importlib.util\nfrom pathlib import Path\nimport tempfile\nimport unittest\n\nspec = importlib.util.spec_from_file_location('probe_package', Path(__file__).with_name('correspondence_probe_package.py'))\npackage = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(package)\n\n\nclass PackageTest(unittest.TestCase):\n    def test_independent_verification_and_mutations(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root = Path(directory)\n            objects = root / 'source'\n            objects.mkdir()\n            data = b'captured bytes'\n            digest = hashlib.sha256(data).hexdigest()\n            (objects / digest).write_bytes(data)\n            script = root / 'script.py'\n            script.write_bytes(b'print(1)\\\\n')\n            output = root / 'package'\n            address = package.create(output, objects,\n                                     [{'role': 'runtime', 'sha256': digest, 'size': len(data)}],\n                                     {'script.py': script})\n            self.assertEqual(1, package.verify(output, address)['object_count'])\n            with self.assertRaises(ValueError):\n                package.verify(output, '0' * 64)\n            (output / 'objects' / digest).write_bytes(b'altered')\n            with self.assertRaises(ValueError):\n                package.verify(output, address)\n\n    def test_rejects_unsafe_names_and_existing_destination(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root = Path(directory)\n            source = root / 'source'\n            source.mkdir()\n            script = root / 'script'\n            script.write_bytes(b'x')\n            with self.assertRaises(ValueError):\n                package.create(root / 'bad', source, [], {'../script': script})\n            with self.assertRaises(ValueError):\n                package.create(source, source, [], {'script': script})\n\n\nif __name__ == '__main__':\n    unittest.main()\nEOF\nPYTHONPYCACHEPREFIX=target/d1-r26-pycache python3 test/yang/correspondence_probe_package_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
