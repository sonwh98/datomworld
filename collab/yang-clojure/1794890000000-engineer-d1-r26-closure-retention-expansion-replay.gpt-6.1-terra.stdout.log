{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/correspondence_probe_package.py <<'EOF'\n\\\"\\\"\\\"Addressed scratch package for observed probe inputs, not a D1 closure.\\\"\\\"\\\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport re\nimport shutil\nimport tempfile\n\n\ndef sha256(path):\n    h = hashlib.sha256()\n    with path.open('rb') as stream:\n        for block in iter(lambda: stream.read(1024 * 1024), b''):\n            h.update(block)\n    return h.hexdigest()\n\n\ndef valid_name(name):\n    return isinstance(name, str) and re.fullmatch(r'[A-Za-z0-9_.-]+', name) is not None and name not in ('.', '..')\n\n\ndef valid_digest(value):\n    return isinstance(value, str) and re.fullmatch(r'[0-9a-f]{64}', value) is not None\n\n\ndef create(destination, source, records, files):\n    destination, source = Path(destination), Path(source)\n    if destination.exists() or not all(valid_name(name) for name in files):\n        raise ValueError('invalid destination or file name')\n    if not isinstance(records, list) or not isinstance(files, dict):\n        raise ValueError('invalid package input')\n    for record in records:\n        if (set(record) \"'!= {'\"'role', 'sha256', 'size'} or not isinstance(record['role'], str)\n                or not valid_digest(record['sha256']) or type(record['size']) is not int or record['size'] < 0):\n            raise ValueError('invalid object record')\n    if len({record['role'] for record in records}) \"'!= len(records):\n        raise ValueError('\"'duplicate role')\n    destination.parent.mkdir(parents=True, exist_ok=True)\n    with tempfile.TemporaryDirectory(prefix='.probe-package-', dir=destination.parent) as temp:\n        staged = Path(temp) / 'package'\n        (staged / 'objects').mkdir(parents=True)\n        (staged / 'files').mkdir()\n        for record in records:\n            name = record['sha256']\n            obj = source / name\n            if obj.is_symlink() or not obj.is_file() or obj.stat().st_size \"'!= record['\"'size'] or sha256(obj) \"'!= name:\n                raise ValueError('\"'source object mismatch')\n            output = staged / 'objects' / name\n            if not output.exists():\n                shutil.copyfile(obj, output)\n                if output.stat().st_size \"'!= record['\"'size'] or sha256(output) \"'!= name:\n                    raise ValueError('\"'copied object mismatch')\n        file_records = {}\n        for name, source_file in sorted(files.items()):\n            source_file = Path(source_file)\n            if source_file.is_symlink() or not source_file.is_file():\n                raise ValueError('invalid source file')\n            output = staged / 'files' / name\n            shutil.copyfile(source_file, output)\n            file_records[name] = {'sha256': sha256(output), 'size': output.stat().st_size}\n        manifest = {'schema': 'd1-r26-scratch-probe-package-v1',\n                    'scope': 'observed-probe-inputs-not-reconstruction-closure',\n                    'objects': records, 'files': file_records}\n        content = (json.dumps(manifest, sort_keys=True, separators=(',', ':')) + '\\\\n').encode()\n        (staged / 'manifest.json').write_bytes(content)\n        identity = hashlib.sha256(content).hexdigest()\n        verify(staged, identity)\n        os.rename(staged, destination)\n    return identity\n\n\ndef verify(root, identity):\n    root = Path(root)\n    manifest_file = root / 'manifest.json'\n    if not valid_digest(identity) or manifest_file.is_symlink() or sha256(manifest_file) \"'!= identity:\n        raise ValueError('\"'manifest mismatch')\n    manifest = json.loads(manifest_file.read_text())\n    if (set(manifest) \"'!= {'\"'schema', 'scope', 'objects', 'files'}\n            or manifest['schema'] \"'!= '\"'d1-r26-scratch-probe-package-v1'\n            or manifest['scope'] \"'!= '\"'observed-probe-inputs-not-reconstruction-closure'):\n        raise ValueError('invalid manifest')\n    if not isinstance(manifest['objects'], list) or not isinstance(manifest['files'], dict):\n        raise ValueError('invalid manifest fields')\n    names = set()\n    roles = set()\n    for record in manifest['objects']:\n        if (set(record) \"'!= {'\"'role', 'sha256', 'size'} or not isinstance(record['role'], str)\n                or record['role'] in roles or not valid_digest(record['sha256'])\n                or type(record['size']) is not int or record['size'] < 0):\n            raise ValueError('invalid object record')\n        roles.add(record['role'])\n        names.add(record['sha256'])\n        obj = root / 'objects' / record['sha256']\n        if obj.is_symlink() or not obj.is_file() or obj.stat().st_size \"'!= record['\"'size'] or sha256(obj) \"'!= record['\"'sha256']:\n            raise ValueError('object mismatch')\n    if (root / 'objects').is_symlink() or (root / 'files').is_symlink():\n        raise ValueError('symlinked package directory')\n    if set(os.listdir(root / 'objects')) \"'!= names or set(os.listdir(root / '\"'files')) \"'!= set(manifest['\"'files']):\n        raise ValueError('unexpected or missing package file')\n    for name, info in manifest['files'].items():\n        if not valid_name(name) or set(info) \"'!= {'\"'sha256', 'size'} or not valid_digest(info['sha256']) or type(info['size']) is not int:\n            raise ValueError('invalid file record')\n        obj = root / 'files' / name\n        if obj.is_symlink() or not obj.is_file() or obj.stat().st_size \"'!= info['\"'size'] or sha256(obj) \"'!= info['\"'sha256']:\n            raise ValueError('file mismatch')\n    return {'object_count': len(names), 'role_count': len(roles), 'file_count': len(manifest['files'])}\nEOF\nPYTHONPYCACHEPREFIX=target/d1-r26-pycache python3 test/yang/correspondence_probe_package_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
