{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/correspondence_r26_package_entry.py <<'EOF'\n\\\"\\\"\\\"Package-local snapshot probe entrypoint; not isolated retained-input replay.\\\"\\\"\\\"\nimport json\nfrom pathlib import Path\nimport platform\nimport subprocess\nimport sys\nimport tempfile\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nimport correspondence_launch_plan as launch_plan\nimport correspondence_snapshot_probe as snapshot\n\n\ndef main():\n    if platform.system() \"'!= '\"'Darwin' or platform.machine() \"'!= '\"'arm64':\n        raise ValueError('unsupported host')\n    package = Path(__file__).resolve().parent.parent\n    config = json.loads((package / 'files/correspondence_r25_launch_plan.json').read_text())\n    receipt = package / 'files/inventory.json'\n    if snapshot.digest(receipt) \"'!= config.get('\"'inventory_sha256'):\n        raise ValueError('inventory mismatch')\n    inventory = json.loads(receipt.read_text())\n    with tempfile.TemporaryDirectory(prefix='d1-r26-inner-') as directory:\n        scratch = Path(directory)\n        command, env, cwd = launch_plan.launch(config, scratch, len(inventory['classpath']))\n        for i in config['classpath_indices']:\n            record = inventory['classpath'][i]\n            target = scratch / 'classpath' / str(i)\n            target.mkdir(parents=True)\n            snapshot.extract_checked(package / 'objects' / record['sha256'], record, target)\n        target = scratch / 'runtime'\n        target.mkdir()\n        record = inventory['runtime']\n        snapshot.extract_checked(package / 'objects' / record['sha256'], record, target)\n        for name in ('home', 'tmp', 'work'):\n            (scratch / name).mkdir()\n        print('Package-local probe; filesystem and network remain unrestricted', flush=True)\n        return subprocess.run(command, cwd=cwd, env=env, check=False).returncode\n\n\nif __name__ == '__main__':\n    raise SystemExit(main())\nEOF\ncat > test/yang/correspondence_r26_probe_package.py <<'EOF'\n\\\"\\\"\\\"Create or scratch-copy and execute the observed r25 snapshot package.\\\"\\\"\\\"\nimport json\nfrom pathlib import Path\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\n\nimport correspondence_probe_package as package\nimport correspondence_snapshot_probe as snapshot\n\nROOT = Path(__file__).resolve().parents[2]\n\n\ndef create(destination):\n    receipt = ROOT / 'target/d1-r19-inventory.json'\n    if package.sha256(receipt) \"'!= snapshot.INVENTORY_SHA256:\n        raise ValueError('\"'inventory mismatch')\n    data = json.loads(receipt.read_text())\n    if len(data['classpath']) \"'!= 154:\n        raise ValueError('\"'classpath count mismatch')\n    records = [{'role': 'classpath/' + str(i), 'sha256': item['sha256'], 'size': item['size']}\n               for i, item in enumerate(data['classpath']) if i not in (5, 6, 7)]\n    item = data['runtime']\n    records.append({'role': 'runtime', 'sha256': item['sha256'], 'size': item['size']})\n    paths = ['correspondence_launch_plan.py', 'correspondence_snapshot_probe.py',\n             'correspondence_r25_launch_plan.json', 'correspondence_r26_package_entry.py']\n    files = {name: ROOT / 'test/yang' / name for name in paths}\n    files['inventory.json'] = receipt\n    return package.create(destination, ROOT / 'target/d1-r18-inventory-store/objects', records, files)\n\n\ndef launch(source, identity):\n    with tempfile.TemporaryDirectory(prefix='d1-r26-copy-') as directory:\n        scratch = Path(directory)\n        copied = scratch / 'package'\n        shutil.copytree(source, copied, symlinks=True)\n        print('Scratch-copy verification:', package.verify(copied, identity), flush=True)\n        home = scratch / 'home'\n        home.mkdir()\n        env = {'PATH': '/usr/bin:/bin', 'LANG': 'C', 'LC_ALL': 'C', 'HOME': str(home),\n               'TMPDIR': str(scratch)}\n        entry = copied / 'files/correspondence_r26_package_entry.py'\n        return subprocess.run([sys.executable, '-I', '-B', str(entry)], cwd=scratch,\n                              env=env, check=False).returncode\n\n\nif __name__ == '__main__':\n    if len(sys.argv) == 3 and sys.argv[1] == 'create':\n        print('manifest-sha256', create(Path(sys.argv[2])))\n    elif len(sys.argv) == 4 and sys.argv[1] == 'launch':\n        raise SystemExit(launch(Path(sys.argv[2]), sys.argv[3]))\n    elif len(sys.argv) == 4 and sys.argv[1] == 'verify':\n        print(package.verify(Path(sys.argv[2]), sys.argv[3]))\n    else:\n        raise SystemExit('usage: create DEST | verify DIR SHA256 | launch DIR SHA256')\nEOF\nPYTHONPYCACHEPREFIX=target/d1-r26-pycache python3 test/yang/correspondence_r26_probe_package.py create target/d1-r26-probe-package\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
