{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/correspondence_launch_plan_test.py <<'EOF'\n\\\"\\\"\\\"Fail-closed checks for the experimental snapshot launch plan.\\\"\\\"\\\"\nimport copy\nimport importlib.util\nimport json\nfrom pathlib import Path\nimport unittest\n\nHERE = Path(__file__).parent\nspec = importlib.util.spec_from_file_location('launch_plan', HERE / 'correspondence_launch_plan.py')\nplan = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(plan)\n\n\nclass LaunchPlanTest(unittest.TestCase):\n    def setUp(self):\n        self.value = json.loads((HERE / 'correspondence_r25_launch_plan.json').read_text())\n\n    def test_plan_builds_only_declared_paths_and_environment(self):\n        command, env, cwd = plan.launch(self.value, Path('/package'), 154)\n        self.assertEqual('/package/runtime/content/Contents/Home/bin/java', command[0])\n        self.assertEqual('/package/work', str(cwd))\n        self.assertEqual({'PATH', 'HOME', 'TMPDIR', 'LANG', 'LC_ALL'}, set(env))\n        paths = command[command.index('-cp') + 1].split(':')\n        self.assertEqual(151, len(paths))\n        self.assertEqual('/package/classpath/0/content', paths[0])\n        self.assertNotIn('/package/classpath/5/content', paths)\n        self.assertEqual('/package/classpath/153/content', paths[-1])\n\n    def test_refuses_unexpected_or_changed_configuration(self):\n        for key, value in [('environment', {'JAVA_TOOL_OPTIONS': '-javaagent:bad'}),\n                           ('classpath_indices', [0]), ('working_directory', '../outside'),\n                           ('expression_sha256', '0' * 64), ('module_path', ['outside'])]:\n            altered = copy.deepcopy(self.value)\n            altered[key] = value\n            with self.subTest(key=key), self.assertRaises(ValueError):\n                plan.launch(altered, Path('/package'), 154)\n        with self.assertRaises(ValueError):\n            plan.launch(self.value, Path('/package'), 153)\n\n\nif __name__ == '__main__':\n    unittest.main()\nEOF\npython3 test/yang/correspondence_launch_plan_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
