{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/correspondence_launch_plan.py <<'EOF'\n\\\"\\\"\\\"Strict candidate configuration for the r25 snapshot experiment.\n\nThis describes a single probe, not a complete reconstruction manifest or an OS\nsandbox.  In particular, host resources and JVM defaults are not all controlled.\n\\\"\\\"\\\"\nimport hashlib\nfrom pathlib import Path\n\nimport correspondence_snapshot_probe as probe\n\n\ndef expected_plan():\n    return {\n        'schema': 'd1-r25-snapshot-probe-v1',\n        'scope': 'preflight-not-reconstruction',\n        'target': {'os': 'Darwin', 'arch': 'arm64'},\n        'inventory_sha256': probe.INVENTORY_SHA256,\n        'runtime_java': 'runtime/content/Contents/Home/bin/java',\n        'classpath_indices': [i for i in range(154) if i not in (5, 6, 7)],\n        'module_path': [],\n        'jvm_options': ['-Xss64m', '-Dfile.encoding=UTF-8', '-Duser.language=en',\n                        '-Duser.country=US', '-Duser.timezone=UTC'],\n        'working_directory': 'work',\n        'environment': {'PATH': '/usr/bin:/bin', 'LANG': 'C', 'LC_ALL': 'C'},\n        'environment_paths': {'HOME': 'home', 'TMPDIR': 'tmp'},\n        'properties_from_paths': {'user.home': 'home', 'java.io.tmpdir': 'tmp'},\n        'entrypoint': 'clojure.main',\n        'expression_sha256': hashlib.sha256(probe.EXPRESSION.encode('utf-8')).hexdigest(),\n        'initialization': ['require-clojure-test-and-macro', 'arm-expansion-guards',\n                           'require-oracle', 'run-single-test'],\n        'platform_boundary': 'host-files-network-clock-and-jvm-defaults-not-isolated',\n    }\n\n\ndef launch(configuration, root, classpath_count):\n    if configuration \"'!= expected_plan() or classpath_count != 154:\n        raise ValueError('\"'unrecognized or altered candidate launch plan')\n    root = Path(root)\n    if not root.is_absolute():\n        raise ValueError('scratch root must be absolute')\n    cp = [str(root / 'classpath' / str(i) / 'content')\n          for i in configuration['classpath_indices']]\n    env = dict(configuration['environment'])\n    env.update({k: str(root / v) for k, v in configuration['environment_paths'].items()})\n    properties = ['-D' + k + '=' + str(root / v)\n                  for k, v in sorted(configuration['properties_from_paths'].items())]\n    command = ([str(root / configuration['runtime_java'])] + configuration['jvm_options'] +\n               properties + ['-cp', ':'.join(cp), configuration['entrypoint'], '-e', probe.EXPRESSION])\n    return command, env, root / configuration['working_directory']\nEOF\nPYTHONPYCACHEPREFIX=target/d1-r25-pycache python3 -c 'import json,sys; sys.path.insert(0,\\\"test/yang\\\"); import correspondence_launch_plan as p; open(\\\"test/yang/correspondence_r25_launch_plan.json\\\",\\\"w\\\").write(json.dumps(p.expected_plan(),indent=2)+\\\"\\\\n\\\")'\nPYTHONPYCACHEPREFIX=target/d1-r25-pycache python3 test/yang/correspondence_launch_plan_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
