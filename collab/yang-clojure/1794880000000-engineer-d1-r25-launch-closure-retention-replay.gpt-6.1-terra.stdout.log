{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat 'src/cljc/yang/correspondence_manifest.clj'\"","aggregated_output":"(ns yang.correspondence-manifest\n  \"Draft reconstruction inventory and byte retrieval. This is not yet an\n   executable closure validator or a D1 reconstruction profile.\"\n  (:require [clojure.string :as string]\n            [dao.jing :as jing]\n            [yang.correspondence-dependency :as dependency]))\n\n(defn- fail! [reason]\n  (throw (ex-info \"Invalid reconstruction inventory\" {:reason reason})))\n\n(defn- keys-are? [m ks]\n  (and (map? m) (= ks (set (keys m)))))\n\n(defn- nonempty-string? [s]\n  (and (string? s) (not (string/blank? s))))\n\n(defn- relative-path? [p]\n  (and (nonempty-string? p)\n       (not (string/starts-with? p \"/\"))\n       (not (string/includes? p \"\\\\\"))\n       (every? #(and (nonempty-string? %) (not (#{\".\" \"..\"} %)))\n               (string/split p #\"/\" -1))))\n\n(defn- strings-map? [m]\n  (and (map? m) (every? (fn [[k v]] (and (nonempty-string? k) (string? v))) m)))\n\n(defn- reference? [bundles ref]\n  (and (vector? ref) (= 2 (count ref))\n       (contains? bundles (first ref)) (relative-path? (second ref))))\n\n(defn- validate! [m]\n  (let [{:keys [target bundles classpath runtime-archive launch pipeline retention]} m]\n    (when-not (and (keys-are? m #{:schema :target :bundles :classpath :runtime-archive\n                                 :launch :pipeline :retention})\n                   (= 1 (:schema m))\n                   (keys-are? target #{:os :arch})\n                   (every? nonempty-string? (vals target))\n                   (keys-are? bundles #{:sources :binaries :runtime})\n                   (every? jing/segment-address? (vals bundles))\n                   (vector? classpath) (seq classpath)\n                   (every? #(reference? bundles %) classpath)\n                   (= (count classpath) (count (set classpath)))\n                   (reference? bundles runtime-archive)\n                   (= :runtime (first runtime-archive))\n                   (keys-are? launch #{:entrypoint :jvm-options :working-directory\n                                       :properties :environment})\n                   (nonempty-string? (:entrypoint launch))\n                   (vector? (:jvm-options launch))\n                   (every? string? (:jvm-options launch))\n                   (= \".\" (:working-directory launch))\n                   (strings-map? (:properties launch))\n                   (strings-map? (:environment launch))\n                   (keys-are? pipeline #{:compiler-argument :expansion})\n                   (true? (:compiler-argument pipeline))\n                   (= :unresolved (:expansion pipeline))\n                   (keys-are? retention #{:owner :discovery})\n                   (every? nonempty-string? (vals retention)))\n      (fail! :schema))\n    m))\n\n(defn- fetch-contents! [handle m]\n  (let [contents (into {} (map (fn [[role address]]\n                                 [role (dependency/fetch-bundle! handle address)]))\n                       (:bundles m))\n        paths (into {} (map (fn [[role entries]] [role (set (map first entries))])) contents)\n        exists? (fn [[role path]]\n                  (some #(or (= path %) (string/starts-with? % (str path \"/\")))\n                        (get paths role)))\n        [runtime-role runtime-path] (:runtime-archive m)]\n    (when-not (and (every? exists? (:classpath m))\n                   (contains? (get paths runtime-role) runtime-path))\n      (fail! :missing-path))\n    contents))\n\n(defn store!\n  \"Validate and store an inventory after checking its referenced byte bundles.\"\n  [handle m]\n  (validate! m)\n  (fetch-contents! handle m)\n  (jing/materialize! handle m))\n\n(defn fetch!\n  \"Fetch an inventory and every referenced byte bundle. This does not launch\n   a process or establish that the inventoried bytes are sufficient.\"\n  [handle address]\n  (when-not (jing/segment-address? address) (fail! :address))\n  (let [m (validate! (jing/get handle address nil))]\n    {:manifest m :bundles (fetch-contents! handle m)}))\n","exit_code":0,"status":"completed"}}
