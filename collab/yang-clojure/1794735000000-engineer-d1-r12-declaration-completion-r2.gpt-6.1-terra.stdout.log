{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"cat > target/d1-r12-static-c1-pilot.clj <<'EOF'\n(require '[yang.correspondence-static :as static]\n         '[yang.correspondence-measure :as measure]\n         '[yang.correspondence-batch :as batch]\n         '[yang.latte-oracle-test :as oracle]\n         '[yin.repl.store :as store]\n         '[dao.jing :as jing]\n         '[dao.jing.mem :as mem])\n(let [source (batch/read-progress \\\"collab/yang-clojure/1794720000000-engineer-d1-r9e.outcomes.edn\\\")\n      out \\\"collab/yang-clojure/1794735000000-engineer-d1-r12-static-c1-pilot.edn\\\"\n      ids (mapv :id (:fixtures @(ns-resolve 'yang.latte-oracle-test 'kernel-gate-corpus)))\n      _ (when-not (.exists (java.io.File. out))\n          (measure/initialize\"'! out ids {:scope :r12-static-c1-predeclaration-pilot\n                                        :pre-declaration-tagged-execution false}))\n      pending (take (Long/parseLong (or (first *command-line-args*) \"1\"))\n                    (filter #(= :not-run (get-in (measure/read-progress out) [:outcomes % :status])) ids))\n      sampler ((ns-resolve '\"'yang.latte-oracle-test 'd1-heap-sampler\"'!) 5)\n      clock #(System/nanoTime)\n      t (clock) h (store/open {:type :file :dir \"target/d1-r9e-retained-store\"})\n      open-ms (quot (- (clock) t) 1000000)]\n  (try\n    (prn {:store-open-ms open-ms}) (flush)\n    (doseq [id pending]\n      (let [result (try\n                     (let [outcome (get-in source [:outcomes id])\n                           {:keys [before]} (measure/check-retained-trees! h id outcome)\n                           snapshot (jing/get h (get-in outcome [:addresses :snapshot]) ::missing)\n                           origin (:admission-origin outcome)\n                           b-store (mem/create-content-mem)\n                           s-store (mem/create-content-mem)\n                           first-run (static/compare-static! before origin (:metadata snapshot) b-store s-store clock)\n                           second-run (static/compare-static! before origin (:metadata snapshot) b-store s-store clock)]\n                       (when-not (and (= (:root first-run) (:root second-run) (:root before))\n                                      (= (:marker-address first-run) (:marker-address second-run)))\n                         (throw (ex-info \"Cold/warm static output differs\" {:stage :comparison})))\n                       {:status :pass :pre-declaration true :admission-origin origin\n                        :cold first-run :warm second-run\n                        :comparison-limits \"In-memory fresh stores, then repeated calls in the same JVM; marker relation reconstructed from application occurrences, not frontend/compiler reconstruction; no guest executes; query builds a relation and does not publish an index.\"})\n                     (catch Exception e {:status :refused :pre-declaration true\n                                         :stage (or (:stage (ex-data e)) :static-c1)\n                                         :rule (:rule (ex-data e)) :message (ex-message e)}))]\n        (measure/record! out id result)\n        (prn {:fixture id :status (:status result) :stage (:stage result) :message (:message result)\n              :cold-phases (get-in result [:cold :phases]) :marker-count (get-in result [:cold :marker-count])}) (flush)))\n    (finally (store/close! h)\n             (prn {:sampled-process-heap-bytes ((:stop! sampler))}) (flush))))\n(shutdown-agents)\nEOF\nset -o pipefail\njava -Xss64m -cp \"$(cat target/d1-r9e-classpath.txt)\" clojure.main target/d1-r12-static-c1-pilot.clj 1 2>&1 | tee target/d1-r12-static-c1-pilot-01.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
