efn- export! [modules target]\n  (let [entry (get modules (symbol (namespace target)))\n        exported (symbol (name target))]\n    (when-not (and (contains? (:exports entry) exported)\n                   (contains? (:definitions entry) exported))\n      (refuse! :export {:target target}))\n    [(:address entry) (get-in entry [:definitions exported])]))\n\n\n(defn- authorize! [roles address target role]\n  (when-not (contains? roles [address target role])\n    (refuse! :export-role {:address address :target target :role role})))\n\n\n(defn- callable! [modules store registry roles target role {:keys [arity params call-shapes]}]\n  (qualified-hook! target)\n  (when (reserved? target) (refuse! :reserved-door {:target target}))\n  (let [host-address (when-not (contains? modules (symbol (namespace target)))\n                       (module/host-export-profile registry target))\n        [address node] (if host-address [host-address nil] (export! modules target))\n        shapes (or call-shapes #{arity})]\n    (if host-address\n      (let [profile (get store host-address)]\n        (when-not (and (address-matches? host-address profile)\n                       (every? (set (:yin.k/arities profile)) shapes))\n          (refuse! :arity {:target target :call-shapes shapes})))\n      (let [actual (:params node)]\n        (when-not (= :lambda (:type node)) (refuse! :non-lambda {:target target}))\n        (when-not (and (= arity (count actual))\n                       (or (nil? params) (= params actual))\n                       ;; A contract can record optional trailing operands.\n                       (every? #(and (int? %) (<= 0 % arity)) shapes))\n          (refuse! :arity {:target target :params actual :call-shapes shapes}))))\n    (authorize! roles address target role)))\n\n\n(defn validate-descriptor\n  \"Validate portable data, closure pins and each executable field. The trusted\n   frontend contract supplies its hook ABI, the entry signature selected by\n   descriptor id, and the set of [address qualified-export exact-role] grants.\n   The artifact store is an immutable map of manifests, UAST trees or row\n   packets, and any declared host primitive profiles.\"\n  [descriptor {:keys [syntax hooks literals entry-lowering roles]} store registry]\n  (when-not (map? descriptor) (refuse! :schema {}))\n  (validate-schema! descriptor)\n  (when-not (= syntax (:yang.semantics/syntax descriptor))\n    (refuse! :syntax {}))\n  (let [active (:yang.semantics/hooks descriptor)\n        strategies (:yang.semantics/literals descriptor)\n        projections (:yang.semantics/ambient-projections descriptor)\n        entry (get entry-lowering (:yang.semantics/id descriptor))\n        modules (closure descriptor store)]\n    (doseq [[role target] (sort-by key active)\n            :when (some? target)]\n      (qualified-hook! target)\n      (when (reserved? target) (refuse! :reserved-door {:target target}))\n      (let [spec (if (= role (:hook entry)) entry (get hooks role))]\n        (when-not spec (refuse! :unknown-role {:role role}))\n        (callable! modules store registry roles target role spec)))\n    (doseq [[role spec] (sort-by key hooks)\n            :when (and (not (some? (get active role)))\n                       (or (= role (:hook entry))\n                           (some #(not= :refused (capability descriptor %))\n                                 (:required-by spec))))]\n      (refuse! :missing-hook {:role role}))\n    (doseq [[key {:keys [kind overflow-op]}] (sort-by key strategies)\n            :when (= kind :raw-or-call)]\n      (callable! modules store registry roles overflow-op [:literal key]\n                 (or (get literals key) (refuse! :unknown-role {:literal key}))))\n    (doseq [[alias {:keys [module export kind] :or {kind :cell-accessor}}]\n            (sort-by key projections)]\n      (let [target (symbol (str module) (name export))]\n        (when (reserved? target) (refuse! :reserved-door {:target target}))\n        (let [[address node] (export! modules target)]\n          (case kind\n            :cell-accessor\n            (doseq [[target node arity]\n                    (into [[target node 0]]\n                          (map (fn [[name arity]]\n                                 (let [sym (symbol (str module) name)]\n                                   [sym (second (export! modules sym)) arity])))\n                          [[\"init!\" 0] [\"export\" 1]])]\n              (when-not (and (= :lambda (:type node)) (= arity (count (:params node))))\n                (refuse! :projection-signature {:target target :alias alias})))\n            :value (when-not (= :literal (:type node))\n                     (refuse! :projection-value {:alias alias :target target})))\n          (authorize! roles address target [:projection alias kind]))))\n    descriptor))\nEOF\npython3 - <<'\"'PY'\np='src/cljc/yang/frontend.cljc'\ns=open(p).read().replace('(defn- non-portable-path','(defn non-portable-path')\nopen(p,'w').write(s)\nPY\nsed -n '241,269p' src/cljc/dao/jing.cljc; sed -n '1420,1453p' src/cljc/yin/vm.cljc; sed -n '457,485p' src/cljc/yin/vm/linker/publish.cljc\"","aggregated_output":"(defn parse-segment-address\n  \"The authoritative address parser: requires a `segment` namespace keyword,\n   splits the name on the first `-` into algorithm identifier and digest,\n   looks the identifier up by exact match (no prefix matching), validates\n   digest length from the registry entry and lowercase-hex text, and\n   reconstructs the canonical address to reject alternative spellings.\n   Returns {:algorithm :<algo>, :digest \\\"<hex>\\\", :canonical :segment/...}\n   or nil on any rejection (never throws).\"\n  [address]\n  (when (keyword? address)\n    (when (= \"segment\" (namespace address))\n      (let [n (name address)\n            i (str/index-of n \"-\")]\n        (when (and i (pos? i))\n          (let [algo-id (subs n 0 i)\n                digest (subs n (inc i))]\n            (when (re-matches algorithm-id-pattern algo-id)\n              (when-let [algo (clojure.core/get registry-by-address-id algo-id)]\n                (let [{:keys [digest-bytes]}\n                      (clojure.core/get registry algo)]\n                  (when (and (= (* 2 digest-bytes) (count digest))\n                             (re-matches hex-digit-pattern digest))\n                    (let [canonical (keyword \"segment\"\n                                             (str algo-id \"-\" digest))]\n                      (when (= canonical address)\n                        {:algorithm algo,\n                         :digest digest,\n                         :canonical canonical}))))))))))))\n\n                 {:role :variable, :name definition-operator})))))\n\n\n(defn validate-rows\n  \"§7.4: validate a projected row set before reconstruction. `rows` is\n   `{id [id tag & slots]}`; `root` is the root row's id.\n\n   Returns nil when every row is well-formed, else the first defect as\n   `{:rule r :path p}`, or `{:rule :root-reachable :id id}` for a row of the\n   loaded set nothing reaches. Rules run in §7.4's order -- `:tag`,\n   `:arity`, `:slot-kind`, `:saturation`, `:id-resolves`, `:acyclic`,\n   `:root-reachable`, then Rule R's `:reserved-name` -- discovered by\n   descending from the root row, so a path is always available except for\n   `:root-reachable`'s unreached rows. Each rule assumes the earlier ones\n   held.\"\n  [{:keys [root rows]}]\n  (let [safe-tag (fn [row] (when (and (vector? row) (<= 2 (count row))) (nth row 1)))\n        safe-slots (fn [tag] (get semantic-bytecode-grammar tag))\n        safe-children (fn [id]\n                        (let [row (get rows id)]\n                          (if row\n                            (let [tag (safe-tag row)\n                                  slots (safe-slots tag)]\n                              (if (and slots (= (count slots) (dec (count (subvec row 1)))))\n                                (mapcat (fn [i [_ kind] v]\n                                          (case kind\n                                            :node (if (semantic-bytecode-slot-kind-ok? kind v) [[[i] v]] [])\n                                            :nodes (if (semantic-bytecode-slot-kind-ok? kind v)\n                                                     (map-indexed (fn [j cid] [[i j] cid]) v)\n                                                     [])\n                                            nil))\n                                        (range 1 (inc (count slots))) slots (rest (subvec row 1)))\n                                []))\n                            [])))\n(defn- stored-tree\n  \"The canonical row tree stored under `root` in `handle`, rebuilt\n   from its individually materialized rows (`vm/materialize-tree!`\n   stores each row body under its own address), or nil when a reached\n   row is absent.\"\n  [handle root]\n  (loop [queue [root]\n         rows {}]\n    (if (empty? queue)\n      {:root root, :rows rows}\n      (let [address (first queue)\n            body (jing/get handle address nil)]\n        (if-not (vector? body)\n          nil\n          (let [row (into [address] body)\n                kids (into []\n                           (mapcat (fn [[j [_ kind]]]\n                                     (let [pos (+ j 2)]\n                                       (case kind\n                                         :node [(nth row pos)]\n                                         :nodes (nth row pos)\n                                         nil))))\n                           (map-indexed vector\n                                        (get vm/semantic-bytecode-grammar\n                                             (nth row 1))))]\n            (recur (into (subvec queue 1)\n                         (remove #(contains? rows %) kids))\n                   (assoc rows address row))))))))\n\n","exit_code":0,"status":"completed"}}
