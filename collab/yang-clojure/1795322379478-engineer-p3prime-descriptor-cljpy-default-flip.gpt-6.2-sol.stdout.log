jolt-test src/dev/jolt_test_runner.clj NS...\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj --self-test\n;;\n;; How it finds the tests: it does not scan. The namespaces are the explicit\n;; command-line list (bb test:jolt-host passes the four dao.host oracle\n;; namespaces), and each is loaded by `require` through jolt's own source-root\n;; search, which the aliases set: :jolt replaces the paths with src/jolt,\n;; src/cljc, src/clj (src/jolt first, so a host override there wins) and\n;; :jolt-test adds test (the oracle) and src/dev (this runner and its\n;; sentinel). jolt resolves :extra-paths roots BEFORE the :replace-paths\n;; ones (`jolt -Srepro -Spath -A:jolt:jolt-test`: test, src/dev, src/jolt,\n;; src/cljc, src/clj); neither test nor src/dev holds a dao/host source, so\n;; the override order is unaffected. Fixture files the tests read\n;; (test/resources/...) are relative to the working directory, the\n;; repository root.\n;;\n;; Per namespace: a load failure is counted and reported, and the run goes on.\n;; Per test var, in source order: each runs through clojure.test/test-var,\n;; which reports an escaping throw as an :error, inside a second guard of this\n;; runner's own, so a throwing test never aborts the batch. Totals are tests,\n;; assertions (pass + fail + error), failures, errors and load failures; the\n;; exit status is nonzero when any of the last three is.\n;;\n;; --self-test runs the sentinel namespace jolt-runner-sentinel (a passing\n;; test, a test that throws, then a passing test) and exits 0 only when the\n;; runner counted exactly that: 3 tests, 1 error, and the test after the\n;; throwing one ran.\n(ns jolt-test-runner\n  (:require\n    [clojure.test :as t]))\n\n\n;; Lane B: the child reports which host scheme launched it (silent when\n;; JOLT_TARGET is unset, so legacy invocations keep their output\n;; byte-identical).\n(when-let [t (System/getenv \"JOLT_TARGET\")] (println (str \"jolt-target: \" t)))\n\n\n(defn- tally\n  []\n  (select-keys @t/counters [:test :pass :fail :error]))\n\n\n(defn- delta\n  [before after]\n  (merge-with - after before))\n\n\n(defn- test-vars-of\n  \"The test vars of namespace `ns-sym` in source order.\"\n  [ns-sym]\n     (vec (map-indexed\n            (fn [i group]\n              (let [path (format \"%s/shard_%d_test.dart\" shard-dir i)]\n                (spit path (shard-source group shard-dir))\n                path))\n            (shard files n))))))\n\n\n(defn -main\n  [& args]\n  (when (some #{\"--slow-regex\"} args)\n    (when (empty? (slow-namespaces))\n      (println \"No namespace uses dao.test-slow/guard.\")\n      (System/exit 1))\n    (println (str \"^(\" (str/join \"|\" (map #(str/replace % \".\" \"\\\\\\\\.\")\n                                          (slow-namespaces)))\n                  \")$\"))\n    (System/exit 0))\n  (let [slow-only? (some #{\"--slow-only\"} args)\n        shard-dir  (or (when (some #{\"--shard-dir\"} args)\n                         (second (drop-while #(not= \"--shard-dir\" %) args)))\n                       shard-dir)\n        no-compile? (some #{\"--no-compile\"} args)\n        no-run?    (some #{\"--no-run\"} args)\n        ;; individual-test selection (owner ruling 2026-11-07: the focus rule\n        ;; runs the failing TEST, not the namespace): --only accepts NS or\n        ;; NS/test-name; entries with a test name become flutter --plain-name\n        ;; filters so only the named deftests execute.\n        {only :namespaces, test-names :tests}\n        (when (some #{\"--only\"} args)\n          (let [v (second (drop-while #(not= \"--only\" %) args))\n                entries (vec (remove str/blank? (str/split (str v) #\",\")))]\n            {:namespaces (vec (distinct (map #(first (str/split % #\"/\")) entries)))\n             :tests (vec (keep #(when (str/includes? % \"/\")\n                                  (last (str/split % #\"/\")))\n                               entries))}))\n        wanted     (cond only only\n                         slow-only? (slow-namespaces)\n                         :else (test-namespaces))]\n    (when (empty? wanted)\n      (println \"No test namespaces selected.\")\n      (System/exit 1))\n    (when-not no-compile?\n      (compile-tests (or only (test-namespaces))))\n    (let [files (filter fs/exists? (map dart-file wanted))\n          missing (remove (comp fs/exists? dart-file) wanted)]\n      (when (seq missing)\n        (let [jvm-only (if (and only (not slow-only?))\n                         (filter jvm-only? missing)\n                         [])\n              fatal (remove (set jvm-only) missing)]\n          (when (seq jvm-only)\n            (println \"JVM-only namespaces (compiled, no Dart tests; skipped):\"\n                     (str/join \", \" jvm-only)))\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.python.antlr.descriptor-profile-test\nLoading initial Timbre config from: :default\n[:test] Compiling ...\n========= Running Tests =======================\n\nTesting yang.python.antlr.descriptor-profile-test\n","exit_code":0,"status":"completed"}}
