tched to :yang/python\" (texts 0))\nsrc/dev/jolt_j5_calibrate.clj:279:          (when (some #{\"(lang :yang/python)\"} (:in entry))\nsrc/dev/jolt_j5_calibrate.clj:281:                 (drop-while #(not= \"(lang :yang/python)\" %))\nsrc/dev/jolt_j5_child.clj:68:             :texts (session [\"(lang :yang/python)\" \"(+ 1 2)\" \"(lang :yang/php)\" \"1 + 2;\"\nsrc/dev/jolt_j5_child.clj:83:          t1 (session [\"(lang :yang/python)\"])\nsrc/dev/jolt_j5_child.clj:90:               :then (session [\"(lang :yang/python)\" \"1 + 2\"])\nsrc/dev/yin_repl_launch.clj:20:  \"Local --index-store mem session; no :yang/python frontend or WebSocket serving.\")\nsrc/dev/jolt_j5_run.clj:270:  [\"Error: unavailable-parser: Yin REPL language :yang/python is not in the frontend catalog; installed: :clojure :php (ids :yang/clojure :yang/php)\"\nsrc/dev/jolt_j5_run.clj:302:                (true? (:after res)) (= [\"Switched to :yang/python\" \"3\"] (:then res)))\nsrc/cljc/yin/repl/frontends.cljc:72:  (assoc (manifest :yang/python :python)\nsrc/cljc/yin/repl/frontends.cljc:123:        ;; is available; otherwise left out, so (lang :yang/python) answers\nsrc/cljc/yin/repl/frontends.cljc:136:                                                    (assoc (ex-data e) :lang :yang/python)\nsrc/cljc/yin/vm/docs/yin.repl.md:74:capability degradation per the C4 ruling: no `:yang/python` frontend\nsrc/cljc/yin/vm/docs/yin.repl.md:144:The REPL ships with three frontends on every host: `:yang/clojure` (default), `:yang/php`, and `:yang/python` (ANTLR multi-target parser, revision f4). Switch languages using `(lang <id>)` with a qualified keyword:\nsrc/cljc/yin/vm/docs/yin.repl.md:147:yin> (lang :yang/python)\nsrc/cljc/yin/vm/docs/yin.repl.md:148:\"Switched to :yang/python\"\nsrc/cljc/yin/vm/docs/yin.repl.md:153:- Selection requires a qualified id (`(lang :yang/python)` or `[id revision]`). Unqualified keywords like `(lang :python)` return `Error: unavailable-parser: ...`.\nsrc/cljc/yin/repl.cljc:432:       \"  (lang :yang/clojure | :yang/python | :yang/php)\\n\"\nsrc/cljc/yin/repl.cljc:1140:   (`:yang/python`) or by `[id revision]`; a language keyword is not a\n   `<dir>/content.jing`, opened under an exclusive directory lock with\n   its HEAD read and the snapshot it names validated — a corrupt HEAD\n   or snapshot refuses construction, and a second owner of the directory\n   is refused naming it.  The spec is resolved and the store opened once\n   here, never switched at runtime, and supplying it together with\n   `index-store` (a handle injected directly) is refused.\n\n   `:index-recovery` carries what the durable open recovered —\n   `{:manifest <address or nil> :datoms <the validated snapshot or nil>}`\n   — and the indexer is rehydrated from it here, before any evaluation\n   is admitted (`yin.repl.index/rehydrate`): `q` answers the previous\n   run's facts, which keep their own session tokens, while this process\n   mints a new token for its own.  In durable mode `(reset)` and `(vm …)`\n   carry the index across the rebuild; with the memory store they start\n   an empty one, as they always have.\n\n   A storage implementation past `:mem` and `{:type :file :dir dir}` is\n   the composition's, never this namespace's\n   (docs/design/yin.repl.dht-composition.md sections 2 and 3): it opens\n   its own store and hands the engine the prepared `dao.jing` content\n   handle as `:index-store`, what its open recovered as `:recovery`, the\n   publication media it services as `:publication-media`, the immutable\n   generic publication policy its transport can carry as\n   `:publication-policy` — `{:branching-factor n :max-payload-bytes b}`,\n   a nil byte ceiling declaring none, and the engine's one policy for\n   every publication path it takes (docs/design/yin.repl.dht-composition.md\n   section 5) — and the link source it drives as\n   `:link-source`.  The engine steps no transport and holds no node: a\n   round publishes against the injected handle and never waits on a\n   network, and a link the engine cannot serve itself stays pending for\n   its composition to move (`yin.shell.linker/serve-links`).  Supplied\n   together, `:link-source` wins over the generic content options, and\n   `:index-store` wins over `:index-store-spec`.\n\n   `:principals` are the public keys whose signed name assertions the\n   reader honors, and `:follow` the principal ids whose published heads\n   the composition follows.  Both are plain data on the link source; a\n   `(require ...)` of a name that is absent while a followed principal\n   has no installed head stays pending until that head is installed.\n   `:publisher-key` is the session's own signing key `{:seed :public}`,\n   whose principal joins `:principals` and is the `:own` the trust\n   commands always honor.  It is signing material, not transport state:\n   the engine reads only the principal off it, and never signs, resolves\n   or announces.  A prepared `:link-source` already carries all three, so\n   it wins and these are not read.\n\n   `:custody` is an optional custody composition value\n   (yin.vm.ucf.compose): the shell only carries it, as data, so the\n   host's single step owner can advance it (yin.repl.main/step-all --\n   the custody control step runs during hydration and through the\n   bounded shutdown drain; the custody program step runs only while\n   the shell is admitted and running).  Nothing in the shell reads or\n   steps it; nil, the default, is today's behaviour.\n\n   `:frontends` is the frontend catalog (`yang.frontend`) the session\n   compiles through, composed by the host entry point (this namespace\n   requires no frontend; see `yin.repl.frontends`).  Without it the catalog\n   is empty and every compile answers `unavailable-parser`.  The session\n   pins this immutable snapshot: installing into another catalog value\n   never changes a live session.  `:lang` selects a frontend by id\n   (`:yang/python`) or by `[id revision]`; a language keyword is not a\n   selector. The default is the `:yang/clojure` frontend.\n   one the catalog cannot answer is an `unavailable-parser` diagnostic,\n   never a fallback to another frontend.\"\n  ([] (create-state {}))\n  ([{:keys [lang output-cursor output-stream vm-type primitives\n            content-store content-client name-env link-policy index-store\n            index-store-spec link-source recovery principals follow custody\n            frontends admission publication-policy publication-media\n            host-modules publisher-key]\n     :or {lang :yang/clojure vm-type :semantic admission {}}}]\n   (let [output-stream (or output-stream (make-output-medium!))\n         output-cursor (or output-cursor (mint-cursor output-stream))\n         shell-token (str (random-uuid))\n         index-store-spec (cond\n                            (and index-store index-store-spec)\n                            (throw (ex-info\n                                     (str \"yin.repl/create-state takes one \"\n                                          \"index store: :index-store-spec \"\n                                          \"(mem or a file directory) or \"\n                                          \":index-store (a dao.jing handle), \"\n                                          \"not both\")\n                                     {:index-store-spec index-store-spec}))\n\n                            index-store nil\n\n                            :else (store/checked-spec index-store-spec))\n         ;; A composition that owns a storage implementation prepares the\n         ;; link source beside the handle and injects both; the engine\n         ;; composes one only from the generic content inputs it was given\n         ;; (docs/design/yin.repl.dht-composition.md section 3).  Composed\n         ;; before the store opens: a refused composition never holds a\n         ;; directory lock.\n         link-source (or link-source\n                         (link/composition\n                           {:name-env name-env\n                            :content-store content-store\n                            :content-client content-client\n                            :principals principals\n                            :key publisher-key\n                            :follow follow\n                            :admission (when-not (= :external admission)\n                                         admission)}))\n         index-store (or index-store (store/open index-store-spec))\n         recovery (or recovery (:recovery index-store))\n         ;; the composition's durable-publication medium: the engine\n         ;; emits a correlated request and promotes only the matching\n         ;; result, and its indexer holds no writer to call\n         ;; (yin.repl.publication).  A store that declares no durable HEAD\n         ;; has no medium, and its round settles locally exactly as an\n         ;; ephemeral composition always has; a composition that wants to\n         ;; observe an ephemeral round injects the media itself.\n         media (or publication-media\n                   (when-let [head-fn (:head-fn index-store)]\n                     (publication/local-media\n                       {:head-fn head-fn\n                        :durability :persistent})))\n         ;; `:media` is the engine's view of the pair -- the request side\n         ;; it appends to, the result side it reads and its cursor -- with\n         ;; the composition's durable HEAD writer stripped off it, so no\n         ;; callback hook sits inside the indexer.  `:local-service` is\n         ;; that stripped half, the medium with its writer, which the\n         ;; round boundary services (`serve-publication`); a composition\n         ;; with transport of its own injects a medium with no `:local`,\n         ;; has no service here, and services the request side itself.\n         publication {:publication-policy publication-policy\n                      :media (some-> media publication/engine-media)\n                      :local-service (when (:local media) media)}]\n     (merge\n       (update (make-session vm-type output-stream\n                             (merge (selected-primitives frontends lang)\n                                    primitives)\n                             shell-token\n                             index-store link-source publication\n                             host-modules)\n               :indexer index/rehydrate recovery)\n       {:lang lang\n        :frontends (or frontends frontend/empty-catalog)\n        :vm-type vm-type\n        :extra-primitives primitives\n        :output-stream output-stream\n   (`:frontend-session`, cleared with the VM) and leaves the session it\n   answers, with the binding's `:render`, in the program's\n   `::frontend` metadata, for `eval-compiled` to stage.\"\n  [state binding parsed]\n  (let [staged (cond-> {}\n                 (:render binding) (assoc :render (:render binding)))]\n    (if-let [lower-session (:lower-session binding)]\n      (let [[ast session] (lower-session parsed (:frontend-session state))]\n        (vary-meta ast assoc ::frontend (assoc staged :session session)))\n      (cond-> ((:lower binding) parsed)\n        (seq staged) (vary-meta assoc ::frontend staged)))))\n\n\n(defn- compile-input\n  \"Lower `input` through the selected frontend; `forms` are the shell\n   reader's forms, used by a frontend that consumes them.\"\n  [state input forms]\n  (let [binding (frontend-binding state (:lang state))]\n    (lower-parsed state binding\n                  ((:parse binding)\n                   (if (= :forms (:input binding)) forms input)))))\n\n\n(defn- forms-input?\n  [state]\n  (= :forms (:input (frontend-binding state (:lang state)))))\n\n\n(defn- compile-source\n  [state input]\n  (let [binding (frontend-binding state (:lang state))]\n    (lower-parsed state binding\n                  ((:parse binding)\n                   (if (= :forms (:input binding)) (read-forms input) input)))))\n\n\n(defn- compile-command-ast\n  \"The AST `(compile ...)` previews.  It lowers against a primed frontend\n   session: a session-staged frontend carries its prelude only on the\n   session's first lowering, and the preview is of the submitted form, not\n   of the runtime it would run on.  The session itself is not touched.\"\n  [state arg]\n  (let [state (assoc state :frontend-session :primed)]\n    (cond\n      (string? arg) (compile-source state arg)\n      (forms-input? state) (compile-input state nil [arg])\n      :else (throw (ex-info \"This compile command expects a source string\"\n                            {:lang (:lang state) :arg arg})))))\n\n\n(defn- render-compile-output\n  \"Render the frontend syntax, the input row batch, and what the session's\n   expander would make of it against its current store: the expanded tree\n   packet (or the expansion error) and the event rows.  The expansion is a\n   preview; its context is discarded, so nothing is committed.\"\n  [state ast]\n  (let [batch (encoder/program-batch ast)\n        {:keys [tree error log frontend-metadata]}\n        (macro/expand-batch batch (get-in state [:expander :ctx]))]\n    (str \"AST:\\n\" (format-value ast)\n         \"\\n\\nInput rows:\\n\" (format-value batch)\n","exit_code":0,"status":"completed"}}
