stream.apply :as apply2]\n            [dao.stream.ringbuffer :as ring]\n            [yin.repl.ast-index :as ast-index]\n            [yin.repl.index :as repl.index]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]))\n\n\n(def module-name\n  \"The module `(require 'dao.space.query)` activates.\"\n  'dao.space.query)\n\n\n(def op\n  \"The `dao.stream.apply` operation a `q` call requests.  It is the only\n   operation this namespace answers: a request under any other operation\n   belongs to a host module its composition registered and serves\n   (`serve`).\"\n  ::q)\n\n\n(def views\n  \"The options map's `:view` values and the `dao.space.query` interpreter\n   each names.  `:current` is the default.\"\n  {:current query/current\n   :history query/history})\n\n\n;; =============================================================================\n;; The module and its call\n;; =============================================================================\n\n(def call-effect\n  \"The module effect key every export served over the session's query call\n   pair lowers to — this namespace's `q`, and a composition's own host\n   modules alike, so one `call-handler` parks them all on one pair\n   (`register`).\"\n  ::call)\n\n\n(defn- q\n  \"The export: a data constructor.  The effect it returns is answered by\n   `call-handler`, which parks the caller on the call pair.\"\n  [& args]\n  (module/make-effect call-effect {:args (vec args)}))\n\n         (if (= hs nil)\n           (on-unhandled tag payload)\n           (yrt.effect/_dispatch ctx-cell hs payload))))]])\n\n\n(def module-exports\n  '#{ctx handlers set-handlers! restore! frame-depth frame pop-frame raise\n     try-value try-orelse try-finally unwind-to call-ec abandon-to call-terminal\n     handle perform})\n\n\n(def uast\n  (u/mark-tails (core/definitions->uast definitions)))\n\n\n(def module-uast\n  (u/annotate-call-sites\n    (core/module-tree (core/module-definitions \"yrt.effect\" nil [] definitions) [])))\n\n\n(def ^:private module-free-names (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  [registry]\n  (prelude-admission/module-spec\n    {:module-name module-name\n     :ast module-uast\n     :exports module-exports\n     :requires {}\n     :free-names module-free-names\n     :registry registry\n     :message \"the yrt.effect module reads an undeclared name\"\n     :refusal-ns \"yrt.effect\"}))\nbuild/antlr/php/classes\nbuild/antlr/php/js\nbuild/antlr/python3/classes\nbuild/antlr/python3/js\nbuild/antlr/typescript/classes\nLoading initial Timbre config from: :default\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n","exit_code":0,"status":"completed"}}
