           (:address entry)))\n                             [module-name owner (get requires module-name)\n                              (:address entry)])))\n                       linked)\n        incoming (keep (fn [[name pinned]]\n                         (when-let [held (module-entry (:modules registry) name)]\n                           (when (not= pinned (:address held))\n                             [name module-name pinned (:address held)])))\n                       (:yin.module/requires (:manifest entry)))\n        conflict (first (sort-by (fn [[name owner pinned address]]\n                                   [(str name) (str owner) (str pinned) (str address)])\n                                 (concat existing incoming)))]\n    (when-let [[name _ pinned address] conflict]\n      {:status :refused,\n       :reason :dependency-pin-mismatch,\n       :module module-name,\n       :name name,\n       :pinned pinned,\n       :linked address})))\n\n177:;; under `:module-stores {m {sym value}}`, never into its own `:store`.\n214:    (get (:module-stores state) store-of {})\n224:    (update-in state [:module-stores store-of]\n225:               (fn [module-store] (store-put (or module-store {}) key val)))\n1062:   dependency store the encoding reaches as it stands in the child at\n1065:   `:yin.k/non-portable` of kind `:missing-module-store`; any refused leaf\n1080:                           (if-let [s (get-in child [:module-stores m])]\n1082:                             (non-portable! :missing-module-store\n1100:   into `:module-stores` unless the task already holds that module's\n1106:    (throw (ex-info \"Module dependency pin mismatch\" refusal)))\n1109:        held (or (:module-stores attached) {})\n1124:        (assoc :module-stores stores)\n1235:        receiver {:free-env (or (:free-env state) {}),\n1370:   registry is checked against every dependency pin before the slice is\n1374:   registry snapshot of a dependency, since the child's mutations are\n1391:  