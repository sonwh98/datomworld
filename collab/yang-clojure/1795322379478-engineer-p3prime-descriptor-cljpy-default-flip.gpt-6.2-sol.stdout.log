{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"sed -n '240,355p;744,803p;808,889p;1153,1232p;1865,1950p;1984,2012p;2260,2275p;2470,2523p' src/cljc/yang/python/antlr/lower.cljc; rg -n \\\"read-global|\\\\(defn.*read-symbol|defn- .*regist\\\" src/cljc/{yang/python/antlr/lower,yin/repl,yin/vm/module}.cljc; rg -n 'test:.*(python|gate)|\"'^  (test|gate)'\"' bb.edn | tail -50\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"sed -n '240,355p;744,803p;808,889p;1153,1232p;1865,1950p;1984,2012p;2260,2275p;2470,2523p' src/cljc/yang/python/antlr/lower.cljc; rg -n \\\"read-global|\\\\(defn.*read-symbol|defn- .*regist\\\" src/cljc/{yang/python/antlr/lower,yin/repl,yin/vm/module}.cljc; rg -n 'test:.*(python|gate)|\"'^  (test|gate)'\"' bb.edn | tail -50\"","aggregated_output":"  (or (get-in ctx [:descriptor :yang.semantics/hooks role])\n      (unsupported! (:node ctx) (str (name role) \" under \" (get-in ctx [:descriptor :yang.semantics/id])))))\n\n\n(defn- hook-app [ctx role & args]\n  (apply app* (hook ctx role) args))\n\n\n(defn- literal [ctx key value]\n  (semantics/literal (:descriptor ctx) key value))\n\n\n(defn- require-capability! [ctx cap node construct]\n  (when (= :refused (semantics/capability (:descriptor ctx) cap))\n    (throw (ex-info (str \"Unsupported Python capability: \" construct)\n                    {:status :refused :reason :yang.semantics/unsupported-capability\n                     :yang.python.antlr/diagnostic :yang.semantics/unsupported-capability\n                     :capability cap :semantics-id (get-in ctx [:descriptor :yang.semantics/id])\n                     :construct construct :node (:id node)}))))\n\n\n\n(defn- build-vector\n  [ctx elems]\n  (core/build-vector (hook ctx :coll/vconj) elems))\n\n\n(defn- truthy\n  [ctx x]\n  (hook-app ctx :op/truthy x))\n\n\n(defn- none [ctx] (literal ctx :nil nil))\n\n\n(def ^:private contains-rule? core/contains-rule?)\n\n\n(def ^:private scope-rules #{\"funcdef\" \"lambdef\" \"lambdef_nocond\" \"classdef\"})\n\n\n(def ^:private loop-and-scope-rules\n  (into scope-rules #{\"while_stmt\" \"for_stmt\"}))\n\n\n;; =============================================================================\n;; Literals\n;; =============================================================================\n\n(defn- int-digits\n  \"`[radix digits]` of integer token `t`, prefix and underscores removed,\n   after checking Python's integer grammar; a malformed token is a syntax\n   diagnostic with CPython 3.9.6's message.\"\n  [n t]\n  ;; flat character classes: a regex repeating a group recurses per digit\n  ;; on the JVM and overflows the stack on a token of thousands\n  (let [[radix kind digit-class body]\n        (case (str/lower-case (subs t 0 (min 2 (count t))))\n          \"0x\" [16 \"hexadecimal\" #\"[0-9a-fA-F_]+\" (subs t 2)]\n          \"0o\" [8 \"octal\" #\"[0-7_]+\" (subs t 2)]\n          \"0b\" [2 \"binary\" #\"[01_]+\" (subs t 2)]\n          [10 \"decimal\" #\"[0-9][0-9_]*\" t])]\n    ;; an underscore only between digits, or after a base prefix\n    (when-not (and (re-matches digit-class body)\n                   (not (str/includes? body \"__\"))\n                   (not (str/ends-with? body \"_\")))\n      (syntax! n (str \"invalid \" kind \" literal\")))\n    ;; Python 3 reads 0755 as an error, not as octal or decimal\n    (when (and (= 10 radix) (str/starts-with? t \"0\") (re-find #\"[1-9]\" t))\n      (syntax! n (str \"leading zeros in decimal integer literals are not \"\n                      \"permitted; use an 0o prefix for octal integers\")))\n    [radix (str/replace body \"_\" \"\")]))\n\n\n(defn- int-literal\n  \"The node of integer token `t`, converted exactly through the `integer`\n   module under limits fitted to this one token (no host double, no\n   native-width parser): a native literal up to 2^53 - 1, else\n   `(py/int-lit hex)` over canonical lowercase hex, which the AST can\n   carry on every host. A decimal token obeys the packet's digit budget,\n   the declared one or the 4300-digit default. Hex, octal and binary\n   tokens have no digit budget.\"\n  [ctx n t]\n  (let [[radix digits] (int-digits n t)\n        c (count digits)\n        budget (:max-digits ctx)\n        decimal? (= 10 radix)]\n    (when (and decimal? budget (> c budget))\n      (syntax! n (str \"Exceeds the limit (\" budget \" digits) for integer \"\n                      \"string conversion: value has \" c \" digits; consider \"\n                      \"hexadecimal for huge integer literals\")))\n    (let [m (integer/integer-module\n              ;; a digit of radix 16 or less is at most 4 bits\n              {::integer/max-bits (* 4 c),\n               ::integer/max-digits (if decimal? (or budget 16) c)})\n          ;; a decimal token's only leading zeros are those of zero\n          v ((get m 'parse) (if (and decimal? (str/starts-with? digits \"0\"))\n                              \"0\"\n                              digits)\n                            radix)]\n      (let [bits ((get m 'bit-length) v)\n            safe-bits (get-in (:descriptor ctx) [:yang.semantics/literals :int :safe-max-bits])]\n        (semantics/literal (:descriptor ctx) :int v bits\n                           (when (and safe-bits (< safe-bits bits))\n                             ((get m 'format) v 16))))))))\n\n\n(defn- parse-number\n  \"The node of one NUMBER token.\"\n  [ctx n text]\n  (let [lower (str/lower-case text)]\n    (cond\n      (str/ends-with? lower \"j\") (unsupported! n \"imaginary literal\")\n      ;; Box while the grammar still distinguishes floats from integers.\n      (and (not (re-find #\"^0[xob]\" lower)) (re-find #\"[.e]\" lower))\n      (let [t (str/replace text \"_\" \"\")]\n                    :global-names (into (:global-names (:analysis ctx))\n                                        (:global-names inner-analysis)),\n                    :module (:module (:analysis ctx))}\n          ctx' (assoc ctx\n                      :pk merged-pk,\n                      :analysis analysis,\n                      :lines (into (:lines ctx) (newline-lines pk)),\n                      :display-id nil)\n          value ((:lower ctx') ctx' (p/node merged-pk (+ offset (:id expr))))]\n      (case conv\n        nil value\n        \"s\" (hook-app ctx :legacy/str-conv value (u/lit false))\n        \"r\" (hook-app ctx :legacy/str-conv value (u/lit true))\n        \"a\" (hook-app ctx :legacy/ascii-conv value)))))\n\n\n(defn- lower-strings\n  \"The value of the atom's STRING tokens: one literal when every token is\n   a plain u/r string, else the f-string lowering with every token's\n   parts concatenated in source order.\"\n  [ctx n ks]\n  (if (every? #(not (str/includes? (str/lower-case\n                                     (re-find #\"^[A-Za-z]*\" (:text %)))\n                                   \"f\"))\n              ks)\n    (literal ctx :str (apply str (map #(parse-string n (:text %)) ks)))\n    (let [parts (mapcat (fn [t]\n                          (let [prefix (str/lower-case\n                                         (re-find #\"^[A-Za-z]*\" (:text t)))]\n                            (cond\n                              (str/includes? prefix \"b\")\n                              (unsupported! n \"bytes literal\")\n                              (str/includes? prefix \"f\")\n                              (fstring-parts n (:text t))\n                              :else [[:lit (parse-string n (:text t))]])))\n                        ks)\n          built (mapv (fn [p]\n                        (if (= :lit (first p))\n                          {:text (second p)}\n                          {:node (hook-app ctx :legacy/format\n                                       (fstring-expr ctx n (second p) (nth p 2))\n                                       (literal ctx :str (nth p 3)))}))\n                      parts)\n          built (remove (fn [b] (and (contains? b :text) (= \"\" (:text b)))) built)]\n      (case (count built)\n        0 (literal ctx :str \"\")\n        1 (or (:node (first built)) (literal ctx :str (:text (first built))))\n        (hook-app ctx :legacy/str\n              (apply app* 'data/str-concat\n                     (mapv #(if (contains? % :text)\n                              (u/lit (:text %))\n                              (app* 'get (:node %) (u/lit :py/str)))\n                           built)))))))\n\n\n;; =============================================================================\n;; Names\n;; =============================================================================\n\n(defn- resolve-name\n(def globals-sym\n  \"The module namespace dict: the module body's parameter, closed over by\n   every function in the module (Python's `__globals__`).\"\n  '%globals)\n\n\n(def globals-fn-sym\n  \"The module's `globals` builtin: a function object returning `%globals`,\n   the module body's second parameter.\"\n  '%globals-fn)\n\n\n(defn- global-key\n  [ctx name]\n  (literal ctx :str name))\n\n\n(defn- read-global\n  \"A module-level read at run time: the module dict, then the task's\n   builtins (`py/global-get`). A present module key always wins, so\n   `print(len([])); len = 1` reads the builtin first and the global after.\n   `globals` is the module's own function object, so it is the one name\n   read with a fallback the lowering supplies.\"\n  [ctx name]\n  (if (and (= \"globals\" name) (legacy? ctx))\n    (hook-app ctx :legacy/global-or (u/v globals-sym) (global-key ctx name) (u/v globals-fn-sym))\n    (hook-app ctx :env/global-get (u/v globals-sym) (global-key ctx name))))\n\n\n(defn- read-name\n  [ctx n name]\n  (let [r (resolve-name ctx name)]\n    (case (:kind r)\n      :cell (hook-app ctx :env/local-get (u/v (symbol name)) (literal ctx :str name))\n      ;; a name the class body assigns: the class namespace at run time,\n      ;; then globals and builtins, as Python's class-body lookup does\n      :class-attr (hook-app ctx :legacy/class-ns-get (u/v (:class ctx)) (u/lit name)\n                        (u/lam [] (read-global ctx name)))\n      :global (read-global ctx name))))\n\n\n(defn- assign-name\n  [ctx name value]\n  (let [r (resolve-name ctx name)]\n    (case (:kind r)\n      :cell (app* 'cell/set! (u/v (symbol name)) value)\n      :class-attr (hook-app ctx :legacy/setattr (u/v (:class ctx)) (u/lit name) value)\n      :global (hook-app ctx :env/global-set (u/v globals-sym) (global-key ctx name) value))))\n\n\n(defn- unbind-name\n  \"Make `name` unbound again: a cell back to unbound, a module or class\n   binding removed (quietly when already absent).\"\n  [ctx name]\n  (let [r (resolve-name ctx name)]\n    (case (:kind r)\n      :cell (app* 'cell/set! (u/v (symbol name)) (literal ctx :unbound nil))\n      :class-attr (hook-app ctx :legacy/delattr-quiet (u/v (:class ctx)) (u/lit name))\n      :global (hook-app ctx :legacy/global-del-quiet (u/v globals-sym) (global-key ctx name)))))\n\n\n(declare target-elements target-atom-expr apply-trailer)\n\n\n(defn- del-name\n  \"`del name`: strict where `unbind-name` is quiet -- CPython raises\n   NameError (a global) or UnboundLocalError (a local) deleting a name\n   with no binding, so the read runs first and the delete follows it.\"\n  [ctx name]\n  (let [r (resolve-name ctx name)]\n    (case (:kind r)\n      :cell (u/seq-nodes\n              [(hook-app ctx :env/local-get (u/v (symbol name)) (literal ctx :str name))\n               (app* 'cell/set! (u/v (symbol name)) (literal ctx :unbound nil))])\n      :class-attr (hook-app ctx :legacy/class-ns-del (u/v (:class ctx)) (u/lit name))\n      :global (hook-app ctx :legacy/global-del (u/v globals-sym) (global-key ctx name)))))\n\n\n;; -----------------------------------------------------------------------------\n;; Imports (C4 I1)\n;; -----------------------------------------------------------------------------\n\n              [i]\n              (if (= i (count chain))\n                (k tmps)\n                (let [full (nth chain i)\n                      delivery (delivered ctx full)\n                      call (if (zero? i)\n                             (hook-app ctx :legacy/import (literal ctx :str full) delivery)\n                             (hook-app ctx :legacy/import-sub (literal ctx :str full) delivery\n                                   (u/v (nth tmps (dec i)))\n                                   (literal ctx :str (last (str/split full #\"\\.\")))))]\n                  (u/let1 (nth tmps i) call (step (inc i))))))]\n      (step 0))))\n\n\n(defn- lower-import\n  \"import_name: each target lowers at its statement position to the\n   import of its chain (`import-chain`) plus one binding in the scope the\n   statement runs in -- `import a.b.c` binds the root `a`, `import a.b as\n   x` binds `x` to `b` read off `a` by `py/import-from`, as CPython (the\n   attribute, else the sys.modules entry). `sys.modules` answers first, a\n   body runs lazily in the importing task, once. `sys` and `builtins`\n   need no delivery:\n   delivery is None, and the pre-seeded sys.modules entry answers.\"\n  [ctx n]\n  (let [das (first (rules ctx n \"dotted_as_names\"))]\n    (u/seq-nodes\n      (mapv (fn [t]\n              (let [nm (dotted-text (:pk ctx) (first (rules ctx t \"dotted_name\")))\n                    as-node (first (rules ctx t \"name\"))]\n                (import-chain ctx t nm\n                              (fn [tmps]\n                                (if as-node\n                                  ;; CPython's IMPORT_FROM per component:\n                                  ;; a rebound a.b is what x binds\n                                  (assign-name\n                                    ctx (name-of ctx as-node)\n                                    (reduce #(hook-app ctx :legacy/import-from %1\n                                                   (literal ctx :str %2))\n                                            (u/v (first tmps))\n                                            (rest (str/split nm #\"\\.\"))))\n                                  (assign-name ctx (first (name-chain nm))\n                                               (u/v (first tmps))))))))\n            (rules ctx das \"dotted_as_name\")))))\n\n\n(defn- lower-import-from\n  \"import_from: the module's chain is imported as `import-chain` does,\n   then each name is read by `(py/import-from m name)` -- the attribute,\n   else the sys.modules entry of `m.name`, never a submodule auto-import\n   (ruling 13) -- and bound to its `as` name or itself. `from m import *`\n   is `(py/import-star m %globals)` at module level, CPython's syntax\n   error in a function, and unsupported in a class body. A relative\n   import resolves statically (`resolve-relative`); one that cannot\n   raises ImportError at the executed statement.\"\n  [ctx n]\n  (let [target (from-module (:pk ctx) (:unit ctx) n)\n        star? (some #(p/token? % \"*\") (kids ctx n))\n        module-level? (= (:scope ctx) (:module (:analysis ctx)))]\n    (when (and star? (not module-level?))\n      (if (:class ctx)\n        (unsupported! n \"import * in a class body\")\n        (syntax! n \"import * only allowed at module level\")))\n    (if (keyword? target)\n      (hook-app ctx :legacy/import-fail (literal ctx :str (relative-import-texts target)))\n      (import-chain\n        ctx n target\n        (fn [tmps]\n          (let [m (u/v (peek tmps))]\n            (if star?\n              (hook-app ctx :legacy/import-star m (u/v globals-sym))\n              (u/seq-nodes\n                (mapv (fn [ian]\n                        (let [[nm-node as-node] (rules ctx ian \"name\")\n                              nm (name-of ctx nm-node)]\n                          (assign-name ctx (name-of ctx (or as-node nm-node))\n                                       (hook-app ctx :legacy/import-from m\n                                             (literal ctx :str nm)))))\n                      (rules ctx (first (rules ctx n \"import_as_names\"))\n                             \"import_as_name\"))))))))))\n\n   with the function's context). Defaults are evaluated here, at\n   definition time, in the enclosing context. A body that yields makes a\n   generator function: the call binds the arguments and allocates the\n   cells, and returns a generator whose body, a lambda of its `:gen`\n   binder, runs at the first resume.\"\n  [ctx scope-node fname {:keys [params defaults star? kwonly kwdefaults kwstar?]}\n   body-fn]\n  (let [s (get-in (:analysis ctx) [:scopes (:id scope-node)])\n        all-params (:params s)\n        _ (when-not (= (count all-params) (count (distinct all-params)))\n            (syntax! scope-node \"duplicate argument in function definition\"))\n        args (gen \"args\" scope-node)\n        gen-sym (when (generator-body? ctx scope-node) (gen \"gen\" scope-node))\n        others (drop (count all-params) (:locals s))\n        body (cond->> (body-fn (assoc ctx\n                                      :scope (:id scope-node)\n                                      :loop nil\n                                      :exc nil\n                                      :class nil\n                                      :gen gen-sym\n                                      :comp nil))\n               gen-sym (u/lam [gen-sym])\n               gen-sym (hook-app ctx :legacy/make-generator (u/lit fname)))\n        cells (concat (map-indexed (fn [i _]\n                                     (app* 'cell/new\n                                           (hook-app ctx :fn/arg (u/v args) (u/lit i))))\n                                   all-params)\n                      (map (fn [_] (app* 'cell/new (literal ctx :unbound nil)))\n                           others))]\n    (hook-app ctx :fn/make\n          (u/lit fname)\n          (u/lit (cond-> {:params params}\n                   star? (assoc :star? true)\n                   (seq kwonly) (assoc :kwonly kwonly)\n                   kwstar? (assoc :kwstar? true)))\n          (build-vector ctx (map #((:lower ctx) ctx %) defaults))\n          (build-vector ctx (map (fn [[nm d]]\n                               (build-vector ctx [(u/lit nm) ((:lower ctx) ctx d)]))\n                             kwdefaults))\n          (site [:call fname (line-of ctx scope-node)]\n                (u/lam [args]\n                       (if (seq (:locals s))\n                         (apply u/app (u/lam (map symbol (:locals s)) body) cells)\n                         body))))))\n\n\n(defn- lower-funcdef\n  [ctx n]\n  (let [ks (kids ctx n)\n        nm (name-of ctx (first (rules ctx n \"name\")))\n        params (first (rules ctx n \"parameters\"))]\n    (when (some #(p/token? % \"->\") ks) (unsupported! n \"return annotation\"))\n    (assign-name\n      ctx nm\n      (function-value\n        ctx n nm\n        (param-spec ctx (first (rules ctx params \"typedargslist\")) \"tfpdef\")\n        (fn [fctx]\n          (let [block (first (rules ctx n \"block\"))]\n            (if (contains-rule? ctx block \"return_stmt\" scope-rules)\n              (let [ret (gen \"ret\" n)]\n                (hook-app ctx :ctrl/call-ec\n                      (u/lam [ret]\n                             (u/seq-nodes\n                               (conj (lower-block (assoc fctx :ret ret) block)\n                                     (none ctx))))))\n              (u/seq-nodes (conj (lower-block (assoc fctx :ret nil) block)\n                                 (none ctx))))))))))\n\n\n(defn- lower-lambdef\n  \"`lambdef` and `lambdef_nocond` (a lambda inside a comprehension's `if`).\"\n  [ctx n]\n  (function-value ctx n \"<lambda>\"\n                  (param-spec ctx (first (rules ctx n \"varargslist\")) \"vfpdef\")\n                  (fn [fctx]\n                    ((:lower ctx) (assoc fctx :ret nil) (peek (rule-kids ctx n))))))\n\n\n(defn- lower-classdef\n  [ctx n]\n  (let [nm (name-of ctx (first (rules ctx n \"name\")))\n        arglist (first (rules ctx n \"arglist\"))\n        bases (if arglist (rules ctx arglist \"argument\") [])\n        _ (when (> (count bases) 1) (unsupported! n \"multiple inheritance\"))\n        base (if (seq bases)\n            nil\n            (kids ctx n))))\n\n\n(defn- lower-decorator\n  \"One `@` line: the decorator expression, evaluated ONCE, at decoration\n   time (the def's scope) -- a dotted name, or a call of one, whose\n   argument list lowers like any call's. A bare `@d` is the name itself,\n   not a zero-argument call.\"\n  [ctx n]\n  (let [f (dotted-decorator-expr ctx (first (rules ctx n \"dotted_name\")))]\n    (if (some #(p/token? % \"(\") (kids ctx n))\n      (let [{:keys [args kwargs]} (call-parts ctx n)]\n        (if kwargs\n          (hook-app ctx :legacy/call-kw f args kwargs)\n          (hook-app ctx :fn/call f args)))\n      f)))\n\n\n(defn- lower-decorated\n  \"`@d1 ... @dn def f` (or `class`): the def's own lowering, then the\n   rebinding `f = dn(...(d1(f)))` -- CPython evaluates the decorator\n   expressions in order, top line first, at decoration time, and applies\n   them bottom-up. The rebinding lands where the def bound (`assign-name`:\n   the module dict at top level, the enclosing class scope for a method),\n   so it is an ordinary assignment after an ordinary def; `decorated`\n   over an `async_funcdef` still refuses.\"\n  [ctx n]\n  (let [decorators (mapcat #(rules ctx % \"decorator\")\n   comprehension's own scope, it is a syntax error, as in Python.\"\n  [ctx n]\n  (let [arg (first (rules ctx n \"yield_arg\"))]\n    (cond\n      (:comp ctx) (syntax! n (str \"'yield' inside \"\n                                  (get comprehension-names (:comp ctx))))\n      (nil? (:gen ctx)) (syntax! n \"'yield' outside function\")\n      :else (app* (if (and arg (p/has-token? (:pk ctx) arg \"from\"))\n                    :legacy/yield-from\n                    :legacy/yield)\n                  (u/v (:gen ctx))\n                  (if arg ((:lower ctx) ctx (first (rule-kids ctx arg))) (none ctx))))))\n\n\n;; -----------------------------------------------------------------------------\n;; Comprehensions\n;; A bare expression statement carries one child; an assignment, an augmented\n;; assignment and an annotation carry more.\n(defn- display-statement\n  \"The id of the last top-level bare expression statement of the module,\n   the one a REPL submission displays (Clojure'