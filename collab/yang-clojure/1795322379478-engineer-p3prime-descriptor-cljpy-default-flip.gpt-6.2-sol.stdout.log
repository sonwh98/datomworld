{"type":"item.completed","item":{"id":"item_119","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/dw-p3-link-probe.clj <<'EOF'\n(require '[dao.jing.mem :as mem]\n         '[yin.vm.linker.publish :as pub]\n         '[yang.python.antlr.profiles :as profiles]\n         '[yin.vm.linker.interpreter :as link]\n         '[yang.python.antlr.linked-harness :as h]\n         '[yang.core.uast :as u]\n         '[yin.vm.module :as module]\n         '[yin.vm :as vm])\n(let [store (mem/create-content-mem)\n      {:keys [registry pins]} (with-redefs [pub/link-local (constantly nil)]\n                                (profiles/prepare\"'! store))\n      src (link/composition {:content-store store :name-env pins :derivation :trusted})\n      run (fn [f] (h/run-linked :semantic (u/mark-tails (u/sexp->uast f))\n                                {:modules registry :link-source src}))\n      require-all '\"'(do (require 'yang.call) (require 'yrt.effect) (require 'yrt.int)\n                       (require 'clj) (require 'clojure.core.impl) (require 'clojure.core)\n                       (require 'clj.py))\n      task (run require-all)\n      modules (:modules task)]\n  (prn :modules (mapv (juxt first (comp :address second)) (module/module-entries (:modules modules))))\n  (prn :clojure-keys (keys (get-in modules [:modules 'clojure 'core])))\n  (prn :binding-keys (keys (get-in modules [:modules 'clojure 'core :bindings])))\n  (prn :init-present (some? (module/resolve-module modules 'clojure.core.init\"'!)))\n  (doseq [f ['\"'(clojure.core/init\"'!) '\"'(clj.py/run-main (fn [g f] 1) (fn [n] {}))]]\n    (try (prn (vm/value (run (concat require-all [f]))))\n         (catch Exception e (prn (ex-message e) (ex-data e))))))\nEOF\nexport MISE_TRUSTED_CONFIG_PATHS=\\\"\"'$PWD\"\neval \"$(mise env)\"\nclojure -Sdeps '\"'{:aliases {:t {:extra-paths [\\\"test\\\"]}}}' -M:t /tmp/dw-p3-link-probe.clj >/tmp/dw-p3-link-probe.log 2>&1\"","aggregated_output":"mise WARN  failed to write cache file