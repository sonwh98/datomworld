dentifier and digest,\n    (not (and (map? profile)\n              (every? #(contains? profile %) profile-keys)))\n    :malformed-profile\n\n    (not= :none (:yin.k/host-state profile))\n    :host-state\n\n    :else\n    (case (:yin.k/class profile)\n      :pure nil\n      :effectful (if (seq (:yin.k/effects profile))\n                   nil\n                   :undeclared-effects)\n      :host-class)))\n\n\n(defn- check-binding!\n  \"Refuse, as a host assembly defect detected before any operation runs,\n   a binding whose profile breaks a registration rule.\"\n  [module-name sym profile]\n  (when-let [rule (if (nil? profile)\n                    :missing-profile\n                    (profile-rule profile))]\n    (throw (ex-info \"Host module registration refused\"\n                    {:rule rule, :module module-name, :name sym}))))\n\n\n(defn register-host-module\n  \"Return registry with host module `module-name` installed from `fns`\n   under `profiles`.\n\n   module-name is a dotted symbol; fns maps each export symbol to the host\n   value it publishes; profiles maps each export symbol to its UCF 7.5.2\n   profile record in the shape of `yin.vm/primitive-profiles`. Every\n   binding must carry a profile, and the profile's class must be `:pure`,\n   or `:effectful` with a declared, non-empty `:yin.k/effects` set, with\n   `:yin.k/host-state` `:none`. An `:effectful` export returns an\n   effect minted by `make-effect` for the engine to interpret and\n   performs no IO itself; `stream/make` is exactly such a constructor.\n   Each export's declared effect set is also entered in the registry's\n   identity-keyed `:callable-effects`, which the engine checks an\n   effect's kind against (D4).\n\n   The module is entered as an already-linked manifest with\n   `:yin.module/tree` absent, `:yin.module/derivations {}`, and its\n   exports listed under `:yin.module/primitives` by profile address; the\n   exports themselves are its `:slice`, and its `:address` and\n   `:derivation` are nil because no content was fetched or derived: the\n   host is the boundary.\"\n  [registry module-name fns profiles]\n  (doseq [sym (sort-by str (keys fns))]\n    (check-binding! module-name sym (get profiles sym)))\n  (-> (or registry (empty-registry))\n      (update :callable-effects\n              (partial merge-with into)\n              (vm/callable-effects fns profiles))\n      (assoc-in (into [:modules] (symbol->path module-name))\n                {:manifest {:yin.module/name module-name,\n                            :yin.module/derivations {},\n                            :yin.module/primitives\n                            (into {} (map (fn [[sym _f]]\n                                            [sym (:yin.k/profile\n                                                   (get profiles sym))]))\n                                  fns)},\n                 :address nil,\n                 :derivation nil,\n                 :slice fns,\n                 :stores {}})))\n\n\n(defn host-export-profile\n  \"The profile address host module `ns` publishes for export `name`, when\n   `qualified-sym` is `ns/name` and `registry` holds `ns` as a\n   host-registered entry (`register-host-module`'s shape, `:address`\n   nil); else nil. A linked entry never answers: the\n   `:yin.module/primitives` of a fetched manifest are the primitives that\n   module assumes, not exports it provides.\"\n  [registry qualified-sym]\n  (when (and (symbol? qualified-sym) (some? (namespace qualified-sym)))\n    (let [entry (module-entry (:modules registry)\n                              (symbol (namespace qualified-sym)))]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"sed -n '45,175p' src/cljc/yin/vm/linker/closure.cljc; sed -n '345,415p;510,535p' src/cljc/yin/vm/linker/publish.cljc; sed -n '295,354p' src/cljc/yang/clojure/prelude.cljc; sed -n '404,432p' src/cljc/yang/clojure/core_impl.cljc; sed -n '2030,2101p;2275,2344p' src/cljc/yang/python/antlr/lower.cljc; ls antlr; ls -a /Users/sto/.m2/repository/org/clojure/clojure | tail\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"sed -n '45,175p' src/cljc/yin/vm/linker/closure.cljc; sed -n '345,415p;510,535p' src/cljc/yin/vm/linker/publish.cljc; sed -n '295,354p' src/cljc/yang/clojure/prelude.cljc; sed -n '404,432p' src/cljc/yang/clojure/core_impl.cljc; sed -n '2030,2101p;2275,2344p' src/cljc/yang/python/antlr/lower.cljc; ls antlr; ls -a /Users/sto/.m2/repository/org/clojure/clojure | tail\"","aggregated_output":"\n\n(defn- invalid\n  ([address role path code] (invalid address role path code nil))\n  ([address role path code detail]\n   {:yin.link.closure/outcome :invalid\n    :address address :role role :path path\n    :defect (cond-> {:code code} (some? detail) (assoc :detail detail))}))\n\n\n(defn- read-blob\n  \"Read `address` as the walk's next blob: `[st value]`, or `[st' nil]`\n   with `st'` stopped.  A blob read before is answered from the walk's\n   own memory and counted once.  Order: absent, address, then the parts\n   and bytes bounds, then decoding.\"\n  [st address role path]\n  (if (contains? (:seen st) address)\n    [st (get (:seen st) address)]\n    (let [{:keys [handle sentinel bounds parts bytes]} st\n          bs (if (jing/segment-address? address)\n               ((:get-bytes-fn handle) address sentinel)\n               sentinel)]\n      (cond\n        (not (jing/segment-address? address))\n        [(stop st (invalid address role path :address-mismatch)) nil]\n\n        (identical? sentinel bs)\n        [(stop st (missing address role path)) nil]\n\n        (not (jing/segment-bytes-match? address bs))\n        [(stop st (invalid address role path :address-mismatch)) nil]\n\n        (>= parts (:max-parts bounds))\n        [(stop st (invalid address role path :parts-limit {:bound :max-parts}))\n         nil]\n\n        (> (+ bytes (byte-count bs)) (:max-bytes bounds))\n        [(stop st (invalid address role path :parts-limit {:bound :max-bytes}))\n         nil]\n\n        :else\n        (let [value (try (jing/segment-value address bs)\n                         (catch #?(:cljd Object :clj Throwable :cljs :default) _\n                           sentinel))]\n          (if (identical? sentinel value)\n            [(stop st (invalid address role path :address-mismatch)) nil]\n            [(-> st\n                 (update :parts inc)\n                 (update :bytes + (byte-count bs))\n                 (assoc-in [:seen address] value))\n             value]))))))\n\n\n(defn- walk-rows\n  \"Step 2: a bounded worklist over the grammar's child slots from the\n   tree root, each row checked row-locally before its children are\n   followed.\"\n  [st tree path]\n  (loop [st st\n         queue [[tree 0]]\n         enqueued #{tree}]\n    (if (empty? queue)\n      st\n      (let [[address depth] (first queue)]\n        (if (> depth (get-in st [:bounds :max-depth]))\n          (stop st (invalid address :row path :parts-limit {:bound :max-depth}))\n          (let [[st body] (read-blob st address :row path)]\n            (cond\n              (:stop st) st\n\n              (linker/row-local-defect body)\n              (stop st (invalid address :row path :row-defect\n                                (linker/row-local-defect body)))\n\n              :else\n              (let [kids (remove enqueued\n                                 (distinct ((:parts-fn linker/ast-format) body)))]\n                (recur st\n                       (into (subvec queue 1)\n                             (map (fn [k] [k (inc depth)]))\n                             kids)\n                       (into enqueued kids))))))))))\n\n\n(defn- walk-records\n  \"Step 3: each derivation record the manifest names, checked as a\n   record leading from the manifest's tree.  Answers `st` with the\n   records under `:records`, keyed by format.\"\n  [st manifest path]\n  (reduce (fn [st [format-kw _]]\n            (if-some [address (get (:yin.module/derivations manifest) format-kw)]\n              (let [[st record] (read-blob st address :record path)]\n                (cond\n                  (:stop st) (reduced st)\n\n                  (linker/record-defect record)\n                  (reduced (stop st (invalid address :record path :record-defect\n                                             (linker/record-defect record))))\n\n                  (not= (if (= :yin.semantic/code format-kw)\n                          (:yin.module/tree manifest)\n                          (get-in st [:records :yin.semantic/code :yin.ledger/output]))\n                        (:yin.ledger/input record))\n                  (reduced (stop st (invalid address :record path\n                                             :derivation-mismatch\n                                             {:expected (:yin.module/tree manifest)\n                                              :actual (:yin.ledger/input record)})))\n\n                  :else (assoc-in st [:records format-kw] record)))\n              st))\n          (assoc st :records {})\n          lowered-formats))\n\n\n(defn- walk-images\n  \"Step 4: the image each record's output identifies, at the identity\n   itself for the semantic vector and at the manifest's index entry for H\n   and R, held to its format's identity check.\"\n  [st manifest path]\n  (reduce (fn [st [format-kw record-format]]\n            (if-some [record (get (:records st) format-kw)]\n              (let [identity (:yin.ledger/output record)\n                    address (if (= :yin.semantic/code format-kw)\n                              identity\n                              (get (:yin.module/index manifest) format-kw))]\n                (if (nil? address)\n                  (reduced (stop st (invalid nil :image path :index-entry-missing\n                                             {:format format-kw\n                                              :identity identity})))\n                  (let [[st image] (read-blob st address :image path)]\n                    (cond\n                      (derive/register-image sem-vector))\n            h (dcode/image-hash h-image)\n            r (rcode/register-hash r-image)\n            h-address (jing/materialize! handle h-image)\n            r-address (jing/materialize! handle r-image)\n            mint (fn [input output profile]\n                   (jing/materialize!\n                     handle\n                     (assoc (ledger/derive-record input output)\n                            :yin.ledger/profile profile)))\n            ;; the manifest is materialized FIRST, with the closed\n            ;; schema-1 key set only: the C1 side table never enters\n            ;; the hashed manifest, so identical specifications under\n            ;; distinct admissions share one manifest address\n            manifest {:yin.module/name name\n                      :yin.module/schema linker/manifest-schema\n                      :yin.module/contracts\n                      {:yin.ast/code vm/ast-contract\n                       :yin.semantic/code vm/semantic-contract\n                       :yin.debruijn.code vm/stack-contract\n                       :yin.debruijn.register vm/register-contract}\n                      :yin.module/tree tree-address\n                      :yin.module/derivations\n                      {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\n                       :yin.debruijn.code\n                       (mint sem h linker/stack-lowering-profile)\n                       :yin.debruijn.register\n                       (mint sem r linker/register-lowering-profile)}\n                      :yin.module/index {:yin.debruijn.code h-address\n                                         :yin.debruijn.register r-address}\n                      :yin.module/exports (set exports)\n                      :yin.module/requires (or requires {})\n                      :yin.module/primitives\n                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n                                    primitives))\n                      :yin.module/footprint fp}\n            address (jing/materialize! handle manifest)\n            ;; the C1 side table and its publication record, beside\n            ;; the manifest: the record names the manifest (a record\n            ;; names a manifest, never the reverse), so each admission\n            ;; of one specification keeps its own record and table\n            call-sites (when (:rows claim)\n                         (let [table (jing/materialize! handle (:rows claim))\n                               ;; cc3 item 3: the instruction-provenance\n                               ;; relation of all three images, persisted\n                               ;; as a side artifact OUTSIDE the schema-1\n                               ;; manifest hash (the record names it; the\n                               ;; manifest never names the record)\n                               provenance (jing/materialize!\n                                            handle\n                                            {:yin.vm.provenance/schema 1\n                                             :yin.vm.provenance/root (:root tree)\n                                             :yin.vm.provenance/semantic\n                                             (mapv (fn [[pc o r p]]\n                                                     [sem pc o r p])\n                                                   (:call-provenance sem-proj))\n                                             :yin.vm.provenance/stack\n                                             (mapv (fn [row]\n                                                     (assoc row 0 h-address))\n                                                   (:call-provenance stack-full))\n                                             :yin.vm.provenance/register\n                                             (mapv (fn [row]\n                                                     (assoc row 0 r-address))\n                                                   (:call-provenance register-full))})\n                               record {:yang.call-site/schema 1\n                                       :yang.call-site/manifest address\n                                       :yang.call-site/root (:root tree)\n                                       :yang.call-site/origin (:origin claim)\n                                       :yang.call-site/table table\n                                       :yang.call-site/provenance provenance}]\n                           {:record (jing/materialize! handle record)\n     (published-call-site-table handle nil record-or-result)))\n  ([handle manifest-address record-address]\n   (when (jing/segment-address? record-address)\n     (let [record (jing/get handle record-address nil)]\n       (when (and (map? record)\n                  (= 1 (:yang.call-site/schema record))\n                  (jing/segment-address? (:yang.call-site/manifest record))\n                  (or (nil? manifest-address)\n                      (= manifest-address (:yang.call-site/manifest record)))\n                  (jing/segment-address? (:yang.call-site/table record))\n                  (vm/occurrence-origin? (:yang.call-site/origin record)))\n         (let [manifest (jing/get handle\n                                  (:yang.call-site/manifest record) nil)]\n           (when (and (map? manifest)\n                      (= (:yang.call-site/root record)\n                         (:yin.module/tree manifest)))\n             (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n               (let [stored-rows (jing/get handle\n                                           (:yang.call-site/table record)\n                                           nil)]\n                 (when (vector? stored-rows)\n                   {:origin (:yang.call-site/origin record),\n                    :root (:root tree), :rows stored-rows,\n                    :tree tree}))))))))))\n\n\n(def bundled-primitive-forms\n  \"Guest closures can capture each other without capturing a host function.\"\n  '[(fn [coll k default]\n      (if (data/vector? coll)\n        (if (data/contains? coll k) (data/nth coll k) default)\n        (dsg__primitive/get coll k default)))\n    (fn [a b] (data/content= a b))\n    (fn [coll k v k2 v2 k3 v3 k4 v4]\n      (if (data/content= k2 nil)\n        (dsg__primitive/assoc coll k v)\n        (if (data/content= k3 nil)\n          (dsg__primitive/assoc coll k v k2 v2)\n          (if (data/content= k4 nil)\n            (dsg__primitive/assoc coll k v k2 v2 k3 v3)\n            (dsg__primitive/assoc coll k v k2 v2 k3 v3 k4 v4)))))\n    (fn [a b] (dsg__primitive/+ a b))\n    (fn [a b] (dsg__primitive/<= a b))])\n\n\n(def module-exports\n  (into #{}\n        (remove #(str/starts-with? (name %) \"dsg__\"))\n        (core/exports \"clj\" (into definitions source-definitions))))\n\n\n(def uast\n  \"Install clj from a closed, content-addressed bundle.\"\n  (let [placeholders (mapv (fn [key] [key :clj/uninit]) runtime-keys)\n        install (apply u/app\n                       (u/lam '[get = assoc + <=]\n                              (core/definitions->uast (into placeholders definitions)))\n                       (map u/sexp->uast bundled-primitive-forms))]\n    (u/mark-tails\n      (u/app (u/lam [] (u/then (u/lit :clj/bundled-runtime) install))))))\n\n\n(defn with-bundled-runtime\n  \"Install and initialize bundled clj before running body in the same\n   lexical scope. Bundled UAST callers can use the private lookup closure\n   to read an invocation record without capturing a host function.\"\n  [& body]\n  (let [source (core/protect-primitives (core/definitions->uast source-definitions))\n        shared (u/app (u/lam '[get = assoc + <=] (u/seq-nodes [call/uast effect/uast]))\n                      (u/v 'dsg__get) (u/v 'dsg__equal) (u/v 'dsg__assoc)\n                      (u/v 'dsg__add) (u/v 'dsg__lte))]\n    (apply u/app\n           (u/lam '[dsg__get dsg__equal dsg__assoc dsg__add dsg__lte]\n                  (u/seq-nodes (into [shared uast source (u/app (u/v 'clj/init!))] body)))\n           (map u/sexp->uast bundled-primitive-forms))))\n\n\n(def bundled-uast (with-bundled-runtime))\n\n\n(def bundled-names\n  \"Bundled runtime store definitions accepted by admission scans.\"\n  (into (set runtime-keys) (map first) (concat definitions source-definitions effect/definitions)))\n\n\n(def module-definitions\n\n\n(def module-exports\n  (set (map (comp #(symbol (name %)) callable-entry) public-names)))\n\n\n(defn bundled-uast\n  \"Emit only the implementation entries and their transitive helpers used by a unit.\"\n  [names]\n  (let [by-name (into {} definitions)\n        needed (loop [todo (map callable-entry names), seen #{}]\n                 (if-let [name (first todo)]\n                   (if (contains? seen name)\n                     (recur (rest todo) seen)\n                     (recur (concat (rest todo)\n                                    (filter by-name (core/free-names (u/sexp->uast (by-name name)))))\n                            (conj seen name)))\n                   seen))\n        impl (filterv #(contains? needed (first %)) definitions)\n        ;; Only this subset of yrt.int is called by the bundled library.\n        numeric (when (some #(contains? (core/free-names (u/sexp->uast (second %)))\n                                        'yrt.int/check-limit) impl)\n                  (filterv #(contains? '#{yrt.int/check-limit yrt.int/_perform} (first %))\n                           int-rt/definitions))]\n    (core/protect-primitives (core/balanced-definitions->uast (into (vec numeric) impl)))))\n\n\n(def module-uast\n  (u/annotate-call-sites\n  \"The loop body, run under a continue escape when it has a `continue`.\"\n  [ctx body-block brk cont]\n  (let [has-cont? (contains-rule? ctx body-block \"continue_stmt\"\n                                  loop-and-scope-rules)\n        body (u/seq-nodes (lower-block (assoc ctx