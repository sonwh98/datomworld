runner.clj), per-namespace counts to build/j2-logs/jvm-summary.edn for the jolt-vs-JVM diff\"\n176:           (:exit (apply shell {:continue true} \"bb\" \"src/dev/jolt_j2_lane.clj\" \"jvm\" *command-line-args*)))}\n178:  test:jolt-j2-manifest\n179:  {:doc \"J2: self-test the applicability manifest guard with a temporary test tree; no jolt or natives needed\"\n181:           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_j2_manifest_check.clj\")))}\n183:  report:jolt-j2\n184:  {:doc \"J2: the jolt-vs-JVM per-namespace count table from build/j2-logs/{core,jvm}-summary.edn; runs nothing\"\n186:           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_j2_lane.clj\" \"report\")))}\n188:  test:jolt-carrier\n189:  {:doc \"J2: the cross-host integer-carrier test (Q1: carriers named by value). `encode` runs the JVM side (java -cp over the test:dev classpath, writes build/j2-logs/carrier-fixtures.edn); `verify` runs the jolt side (decode both rows, assert equal bytes and equal results)\"\n194:                                      \"mkdir -p build/j2-logs && java -cp \\\"$(clojure -Spath -A:test -A:dev)\\\" clojure.main src/dev/jolt_carrier_test.clj --encode\"))\n196:                                      \". build/tools/jolt-env.sh && \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt:jolt-test src/dev/jolt_carrier_test.clj --verify\"))\n199:  test:jolt-cbor-override\n202:           (:exit (apply shell {:continue true :shutdown nil} \"bb\" \"src/dev/jolt_cbor_override_check.clj\" *command-line-args*)))}\n204:  test:jolt-cbor-override-self-test\n205:  {:doc \"Self-test the CBOR override review gate in temporary worktree copies; no jolt or natives needed\"\n207:           (:exit (shell {:continue true :shutdown nil} \"bb\" \"src/dev/jolt_cbor_override_self_test.clj\")))}\n209:  test:jolt-cbor-parity\n","exit_code":0,"status":"completed"}}
