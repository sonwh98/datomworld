thon/antlr/int_heap_test.cljc\ntest/yang/python/antlr/int_literal_test.cljc\ntest/yang/python/antlr/int_ops_fixtures.cljc\ntest/yang/python/antlr/int_ops_parser_test.clj\ntest/yang/python/antlr/int_ops_test.cljc\ntest/yang/python/antlr/linked_harness.cljc\ntest/yang/python/antlr/linked_prelude_test.cljc\ntest/yang/python/antlr/linked_safepoint_test.cljc\ntest/yang/python/antlr/lower_portable_test.cljc\ntest/yang/python/antlr/lower_test.clj\ntest/yang/python/antlr/oracle_parity_test.cljc\ntest/yang/python/antlr/prelude_parity_test.cljc\ntest/yang/python/antlr/publication_test.cljc\ntest/yang/python/antlr/safepoint_programs.cljc\ntest/yang/python/antlr/safepoint_test.cljc\ntest/yang/python/antlr/scope_test.clj\ntest/yang/python/antlr/siteset_test.cljc\ntest/yang/python/antlr/source_call_test.clj\ntest/yang/python/antlr/trace_programs.cljc\ntest/yang/rt/effect_test.cljc\n7:  autobahn:jolt\n8:  {:doc \"J6f Autobahn conformance: starts the testee and the Dockerized pinned suite, waits for the READY barrier, runs harness.py per role, collects results/, and shuts both sides down. Usage: bb autobahn:jolt <role> <agent>\"\n9:   :task (apply shell {:continue true} \"bash\" \"tools/jolt-autobahn/launch.sh\" *command-line-args*)}\n15:  ;; jolt host lane (experimental, docs/design/yin.repl-jolt-implementation.md)\n16:  bootstrap:jolt\n17:  {:doc \"Materialize the jolt-toolchain.edn pins into build/tools/jolt (mise Chez/CMake checked, jolt cloned at the full SHA, never pulled) and write build/tools/jolt-env.sh\"\n19:           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\")))}\n21:  test:jolt-bootstrap-neg\n22:  {:doc \"Copy/revert the jolt clone under gitignored build/bootstrap-neg (deleted on success, retained on failure) and declare a synthetic patch and prove bootstrap refuses it unapplied or corrupted, then accepts it applied (JOLT_BOOTSTRAP_TEST_DIR selects the source clone)\"\n24:           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstra