th-out-str (pp/pprint revisions))))\nEOF\nexport MISE_TRUSTED_CONFIG_PATHS=\\\"\"'$PWD\"\neval \"$(mise env)\"\nbb /tmp/dw-p3-lock.clj\nwc -l /tmp/dw-p3-locked-modules.edn\ngit diff --check'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
