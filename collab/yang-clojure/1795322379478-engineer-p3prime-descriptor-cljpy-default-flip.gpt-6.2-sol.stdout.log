    acyclic-defect (letfn [(check-cycle\n                                 [id on-path]\n                                 (cond\n                                   (contains? on-path id) (defect-res :acyclic id)\n                                   :else\n                                   (let [row (get rows id)]\n                                     (when row\n                                       (let [on-path' (conj on-path id)]\n                                         (some (fn [[_suffix cid]]\n                                                 (check-cycle cid on-path'))\n                                               (safe-children id)))))))]\n                         (check-cycle root #{}))\n        root-reachable-defect (some (fn [id]\n                                      (when-not (contains? paths id)\n                                        {:rule :root-reachable :id id}))\n                                    (keys rows))]\n    (or tag-defect arity-defect slot-kind-defect saturation-defect\n        id-resolves-defect acyclic-defect root-reachable-defect\n        (rows-reserved-defect root rows defect-res))))\n\n\n(defn materialize-tree!\n  \"Materialize every row of one projected tree `{:root id, :rows {id row}}`\n   individually under its own address (D3): each row's body\n   `(subvec row 1)` through `jing/materialize!`, which derives exactly the\n   row's id. The tree is validated (§7.4) first, so an invalid tree is\n   refused before the first write. Returns the root row id -- the tree's\n   address (§4.1).\"\n  [handle {:keys [root rows] :as tree}]\n  (when-let [{:keys [rule path id]} (validate-rows tree)]\n    (throw (ex-info \"Cannot materialize rows that fail validation\"\n                    (cond-> {:rule rule}\n                      path (assoc :path path)\n                      id (assoc :id id)))))\n  (doseq [row (vals rows)]\n    (jing/materialize! handle (subvec row 1)))\n5:     clj -M:antlr-gen [--grammar g] [--target java|javascript|dart|cpp]\n11:   2. For each manifest :targets entry (:java, :javascript, :dart), stage the\n                             (fn [] :py/None))]\n             (assoc (assoc {} :py/out (cell/get py.rt/out))\n                    :py/exception\n                    (if (= exc :py/None) nil (py/snapshot-exc exc))))))]\n    [py/run-main\n     ;; the entry wrapper's call (I1): the same body image py/import runs,\n     ;; as the module \"__main__\" -- a module object inserted into\n     ;; sys.modules with __name__ set before the body runs, its raising\n     ;; body's re-raise the program's snapshotted value. One code image\n     ;; therefore sees __main__ as main and its own name as an import\n     (fn [body]\n       (do (cell/set! py.rt/out [])\n           (cell/set! py.rt/ctx (py/ctx nil 0 0 nil))\n           (let [exc (py/try\n                       (fn []\n                         (do (py/module-run (py/str \"__main__\") :py/None body)\n                             :py/None))\n                       (fn [e] e)\n                       (fn [] :py/None))]\n             (assoc (assoc {} :py/out (cell/get py.rt/out))\n                    :py/exception\n                    (if (= exc :py/None) nil (py/snapshot-exc exc))))))]\n    [py/run-session\n     ;; one REPL submission (ruling 18): `body` runs against the\n     ;; persistent __main__ of sys.modules, made by the first submission,\n     ;; so a name one submission binds is read by the next; it answers\n     ;; the output, the exception and :py/value (the last bare expression\n     ;; statement's value). The bundled REPL runner calls it, so the\n     ;; runner names no runtime key\n     (fn [body]\n       (do (cell/set! py.rt/out [])\n           (cell/set! py.rt/value :py/None)\n           (cell/set! py.rt/ctx (py/ctx nil 0 0 nil))\n           (let [hit (py/modules-ref (py/str \"__main__\"))\n                 m (if (= hit :py/missing)\n                     (let [fresh (py/module-new (py/str \"__main__\") :py/None)]\n                       (do (py/modules-put! (py/str \"__main__\") fresh)\n                           fresh))\n                     hit)\n(ns yang.core.lower\n  \"Lowering helpers shared by every language's CST-to-Universal-AST lowering\n   (docs/design/yang.typescript.md §17, lift L2): the CST accessors over a\n   lowering context `{:pk packet ...}`, the generated-name supply, safepoint\n   site marks, and the diagnostic builders. A language supplies its\n   diagnostic namespace (a string such as \\\"yang.python.antlr\\\"), its name\n   for messages and its table of unsupported rules.\"\n  (:require\n    [yang.antlr.packet :as p]\n    [yang.core.uast :as u]))\n\n\n;; =============================================================================\n;; Diagnostics\n;; =============================================================================\n\n(defn unsupported!\n  \"Throw the `<diagnostic-ns>/unsupported` diagnostic for rule node `n`\n   naming `construct`; `language` is the name the message uses.\"\n  [diagnostic-ns language n construct]\n  (throw (ex-info (str \"Unsupported \" language \" construct: \" construct)\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"unsupported\"),\n                   :rule (:rule n),\n                   :construct construct,\n                   :span (:span n)})))\n\n\n(defn syntax!\n  \"Throw the `<diagnostic-ns>/syntax` diagnostic for rule node `n`.\"\n  [diagnostic-ns n message]\n  (throw (ex-info message\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"syntax\"),\n                   :rule (:rule n),\n                   :span (:span n)})))\n\n\n(defn default-arm\n  \"The arm of a rule with no lowering: `unsupported!` when `refusals` (rule\n   name to construct) names it, otherwise `<diagnostic-ns>/unhandled-rule`.\"\n  [diagnostic-ns language refusals n]\n  (if-let [construct (get refusals (:rule n))]\n    (unsupported! diagnostic-ns language n construct)\n    (throw (ex-info (str \"Unhandled grammar rule: \" (:rule n))\n                    {(keyword diagnostic-ns \"diagnostic\")\n                     (keyword diagnostic-ns \"unhandled-rule\"),\n                     :rule (:rule n),\n                     :span (:span n)}))))\n\n\n;; =============================================================================\n;; Small helpers\n;; =============================================================================\n\n(defn gen\n  [prefix n]\n  (symbol (str \"%\" prefix (:id n))))\n\n\n(defn kids\n  [ctx n]\n  (p/children (:pk ctx) n))\n\n\n(defn rules\n  [ctx n rule-name]\n  (p/child-rules (:pk ctx) n rule-name))\n\n\n(defn rule-kids\n  [ctx n]\n  (filterv p/rule? (kids ctx n)))\n\n\n(defn site\n  \"`node` marked as a safepoint site of `kind` (`:loop`, `:call`, `:line`),\n   a keyword or a vector `[kind datum ...]`. The mark is map metadata, so it never enters a canonical row: projection\n   puts it in the frontend-metadata side table, where `yang.safepoint`\n   finds it.\"\n  [kind node]\n  (vary-meta node assoc :yang/site kind))\n\n\n(defn app*\n  [op-sym & args]\n  (apply u/app (u/v op-sym) args))\n\n\n(defn contains-rule?\n  \"True when `rule-name` occurs below `n` without crossing any `stop` rule.\"\n  [ctx n rule-name stop]\n  (boolean\n    (some (fn [k]\n            (and (p/rule? k)\n                 (or (= rule-name (:rule k))\n                     (and (not (contains? stop (:rule k)))\n                          (contains-rule? ctx k rule-name stop)))))\n          (kids ctx n))))\n\n","exit_code":0,"status":"completed"}}
