 Object\n                                   :clj Exception\n                                   :cljs js/Error) error\n                           {:failed (consume-failed-round state error)}))]\n          (if-let [failed (:failed expanded)]\n            failed\n            (let [[expanded {:keys [errors forwarded]}] expanded\n                  indexed (if (pos? forwarded)\n                            ;; commit evidence is captured BEFORE the\n                            ;; index stage runs: the published programs\n                            ;; and indexer as they stood, so the recorder\n                            ;; pairs only what this round commits\n                            (let [evidence\n                                  {:programs-before\n                                   (indexed-program-roots (:indexer expanded))\n                                   :indexer-before (:indexer expanded)}]\n                              (-> expanded\n                                  run-index-stage\n                                  run-ast-index-stage\n                                  (assoc :call-site-commit-evidence evidence)\n                                  ;; cc3 r2 item 4: this round's\n                                  ;; provenance claims — the roots the\n                                  ;; expander newly retained under\n      [state (str \"Error: Unknown Yin REPL command \" (pr-str command))])))\n\n\n(defn- eval-compiled\n  \"Evaluate a program `compile-input` or `compile-source` lowered.  What\n   its lowering left (`::frontend`: the session and the `:render` hook) is\n   staged on the round and committed only where the round's VM state\n   survives: when the program halts, now or when its parked require\n   completes (`finalize-eval`).  A round that fails, rolls back, or is\n   abandoned keeps the shell's previous `:frontend-session`.\"\n  [state ast]\n  (let [staged (::frontend (meta ast))\n        [state' text] (eval-program (cond-> state\n                                      staged (assoc ::frontend staged))\n                                    ast)]\n    [(dissoc state' ::frontend) text]))\n\n\n(defn- eval-parsed*\n  \"The parse dispatch of one line, against a shell with no require to\n   re-check.\"\n  [state trimmed parsed]\n  (try\n    (let [forms (:forms parsed)\n          form (when (= 1 (count forms)) (first forms))]\n      (cond\n        (and form (command-form? form)) (handle-command state form)\n        (and form (datom-stream? form)) (eval-program state (vec form))\n        (and form (ast-map? form)) (eval-program state form)\n        forms (eval-compiled state (compile-input state trimmed forms))\n        (forms-input? state) [state (format-error (:error parsed))]\n        :else (eval-compiled state (compile-source state trimmed))))\n    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n      (let [[state' output-text] (drain-output state)]\n        [state' (str output-text (format-error error))]))))\n\n\n(defn- fold-queued\nsrc/cljc/yin/repl/ast_index.cljc:24:   one already held at its address, or a failed derivation is recorded\nsrc/cljc/yin/repl/ast_index.cljc:171:   failed derivation names its `:stage`).  The text never includes a host\nsrc/cljc/yin/vm/encoder.cljc:115:    (let [metadata (:frontend-metadata member)]\nsrc/cljc/yin/vm/encoder.cljc:117:        (throw (ex-info \"Supplied frontend-metadata is not a row sequence\"\nsrc/cljc/yin/vm/encoder.cljc:118:                        {:rule :frontend-metadata, :member-index member-index,\nsrc/cljc/yin/vm/encoder.cljc:123:       :frontend-metadata (vec (or metadata [])),\nsrc/cljc/yin/vm/encoder.cljc:158:           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\nsrc/cljc/yin/vm/encoder.cljc:242:  \"The reserved frontend-metadata key of the call-site occurrence\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder,