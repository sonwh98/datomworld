--- a/test/yang/latte_oracle_test.clj
+++ b/test/yang/latte_oracle_test.clj
@@ -12,7 +12,90 @@
             [clojure.test :refer [deftest is testing]]
             [clojure.string :as str]
             [clojure.walk :as walk]
+            [clojure.set :as set]
             [dao.jing.cbor :as cbor]
+            [yang.clojure :as yang]
+            [yang.runtime :as runtime]
+            [yang.values :as values]
+            [yang.sources :as sources]
+            [yang.kernel :as kernel]
+            [yang.latte-oracle :as oracle]))
+
+(def declarations (atom nil))
+
+(defn- load-declarations! []
+  (when (nil? @declarations)
+    (reset! declarations (clojure.edn/read-string (slurp "test/yang/latte_oracle/slice9_declarations.edn")))))
+
+(defn- declared-portability-boundary?
+  [id a b walker semantic fixture]
+  (load-declarations!)
+  (let [declaration (get-in @declarations [:portability id])]
+    (when (and declaration
+               (= (:call fixture) (:call declaration))
+               (= (get-in a [:outcome :thrown :message]) (:message declaration))
+               (= :completed (:status a) (:status b) (:status walker) (:status semantic))
+               (= (:outcome a) (:outcome b))
+               (every? (fn [c]
+                         (and (= :yin.k/error (first (:outcome c)))
+                              (= (get-in a [:outcome :thrown :message])
+                                 (get-in c [:outcome 1 :yin.k/message]))
+                              (= (dissoc (get-in a [:outcome :thrown :data]) :meta)
+                                 (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta))
+                              (= (result-shape (dissoc (get-in a [:outcome :thrown :data]) :meta))
+                                 (result-shape (dissoc (get-in c [:outcome 1 :yin.k/data]) :meta)))
+                              (let [meta-val (get-in c [:outcome 1 :yin.k/data :meta])]
+                                (or (values/closure? meta-val)
+                                    (and (map? meta-val)
+                                         (= :closure (:type meta-val))
+                                         (contains? meta-val :source)
+                                         (contains? meta-val :env))))))
+                       [walker semantic])))
+      {:boundary (:boundary declaration)
+       :upstream-value (:upstream-value declaration)
+       :evidence {:file "slice9_evidence.edn" :fixture-id id
+                  :path [:a :outcome :thrown :data :meta]}
+       :reason (:reason declaration)})))
+
+(defn- declared-upstream-failure?
+  [fixture a b walker semantic]
+  (load-declarations!)
+  (let [declaration (get-in @declarations [:upstream-failures (:id fixture)])]
+    (when (and declaration
+               (= (:call fixture) (:call declaration))
+               (= :completed (:status walker) (:status semantic))
+               (= (:outcome walker) (:outcome semantic)))
+      (case (:id fixture)
+        :typing-ascription
+        (when (and (= :blocked (:status a))
+                   (= "class java.lang.IllegalStateException" (:exception a))
+                   (= "Attempting to call unbound fn: #'latte-kernel.typing/type-of-ascribe" (:message a))
+                   (= :completed (:status b))
+                   (= {:thrown {:message "Pinned upstream declaration has no definition"
+                               :data {:refusal :upstream-unbound :binding 'latte-kernel.typing/type-of-ascribe}}}
+                      (:outcome b))
+                   (= [:yin.k/error {:yin.k/message "Pinned upstream declaration has no definition"
+                                    :yin.k/data {:refusal :upstream-unbound :binding 'latte-kernel.typing/type-of-ascribe}}]
+                      (:outcome walker)))
+          {:boundary (:boundary declaration)
+           :reason (:reason declaration)
+           :upstream-revision (:upstream-revision declaration)
+           :evidence {:file "slice9_evidence.edn" :fixture-id (:id fixture)
+                      :paths [[:a] [:b] [:c-walker] [:c-semantic]]}})
+        :compile-malformed
+        (when (and (= :blocked (:status a) (:status b))
+                   (= "class java.lang.IllegalArgumentException" (:exception a) (:exception b))
+                   (= "Don't know how to create ISeq from: java.lang.Long" (:message a) (:message b))
+                   (nil? (:data a)) (nil? (:data b))
+                   (= [:yin.k/error {:yin.k/message "seq of a non-collection is not supported"
+                                    :yin.k/data {:value 42}}]
+                      (:outcome walker)))
+          {:boundary (:boundary declaration)
+           :reason (:reason declaration)
+           :upstream-revision (:upstream-revision declaration)
+           :evidence {:file "slice9_evidence.edn" :fixture-id (:id fixture)
+                      :paths [[:a] [:b] [:c-walker] [:c-semantic]]}})
+        nil))))
             [clojure.tools.reader :as r]
             [clojure.tools.reader.reader-types :as rt]
             [yang.clojure :as yang]
