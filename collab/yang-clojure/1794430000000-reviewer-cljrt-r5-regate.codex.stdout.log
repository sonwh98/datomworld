eligible?)\n             ((get descriptor :yang.call/eligible?) callable)\n             true))))]\n    [yang.call/invocation\n     (fn [callee positional named raise]\n       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/invocation-with\n     (fn [callee positional named raise options]\n                                  (outcome-node\n                                    error-tag\n                                    (u/app (u/v 'yang.call/condition)\n                                           (u/lit :yang.call/invalid-invocation)\n                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n                       u/capture)\n          routed (if (::invoker env)\n                   (u/if-node\n                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n                                           (u/lit true)\n                                           ;; the shape is only WHEN to ask (ruling of\n                                           ;; record, rule 2): the heap answers\n                                           ;; `cell/authentic?`, and an unauthenticated\n                                           ;; shape takes ordinary map invocation\n                                           (u/if-node (cell-ref-shaped-node (u/v callee))\n                                                      (u/app (u/v 'cell/authentic?) (u/v callee))\n                                                      (u/lit false)))\n                                (u/lit false))\n                     admitted\n                     value-call)\n                   admitted)]\n      (cond-> (u/mark-tails (u/let1 callee callee-ast\n                                    (u/let1 arguments arguments-ast routed)))\n        tail? (assoc :tail? true)))))\n\n\n(defn- compile-apply\n  \"(apply f a b coll) as one application of f to the assembled argument\n   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n   serves a guest closure and an adapted native alike.\"\n                                                (if (dsg__equal\n                                                      (data/count dsg__candidate)\n                                                      3)\n                                                  (if (data/string?\n                                                        (dsg__get dsg__candidate\n                                                                  :seal))\n                                                    (if (dsg__equal\n                                                          (data/str-length\n                                                            (dsg__get dsg__candidate\n                                                                      :seal))\n                                                          64)\n                                                      true\n                                                      false)\n                                                    false)\n                                                  false)\n                                                false)\n                                              false)\n                                            false)]\n                                      (if dsg__cell-ref?\n                                        (if (cell/authentic? dsg__candidate)\n                                          (let [dsg__descriptor\n                                                (cell/get dsg__candidate)\n                                                dsg__entry\n                                                (dsg__get dsg__descriptor\n                                                          :yang.call/entry)]\n                                            (data/callable? dsg__entry))\n                                          false)\n                                        (let [dsg__entry\n                                              (dsg__get dsg__candidate\n                                                        :yang.call/entry)\n                                              dsg__witness\n                                              (dsg__get dsg__candidate\n                                                        :clj/admission)]\n                                          (if (data/callable? dsg__entry)\n                                            (if (data/callable? dsg__witness)\n                                              (dsg__equal\n","exit_code":0,"status":"completed"}}
