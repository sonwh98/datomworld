arg-vector-opts\\\\n  \\\\\\\"The argument-vector convention with the outcome model, the guest library's\\\\n   adapters and the VM primitives' published profiles as the native names.\\\\\\\"\\\\n  {:convention :arg-vector, :outcomes true\\\\n   :adapters yang/library-adapters\\\\n   :native vm/primitive-profiles})\\\\n\\\\n\\\\n(defn- result-shape\\\\n  \\\\\\\"Collection families and domain metadata, excluding reader provenance.\\\\\\\"\\\\n  [x]\\\\n  [(not-empty (apply dissoc (meta x) [:source :file :line :column :end-line :end-column]))\\\\n   (cond\\\\n   5. Digest every generated source file of the target and compare with the\\\\n      target's recorded :generated digests; a mismatch fails the build.\\\\n\\\\n   `clj -M:antlr-gen discover` prints the head commit of the grammar path, for\\\\n   deliberately moving the pin. Nothing here runs at admission time.\\\\\\\"\\\\n  (:require\\\\n    [clojure.edn :as edn]\\\\n    [clojure.java.io :as io]\\\\n    [clojure.pprint :as pprint]\\\\n    [clojure.string :as str])\\\\n  (:import\\\\n    (io.github.rctcwyvrn.blake3\\\\n      Blake3)\\\\n    (java.net\\\\n      URI)\\\\n    (java.net.http\\\\n      HttpClient\\\\n      HttpClient$Redirect\\\\n      HttpRequest\\\\n      HttpResponse$BodyHandlers)\\\\n    (javax.tools\\\\n      ToolProvider)))\\\\n\\\\n\\\\n(def ^:dynamic *grammar* \\\\\\\"python3\\\\\\\")\\\\n\\\\n\\\\n(defn- manifest-path\\\\n  []\\\\n  (str \\\\\\\"antlr/\\\\\\\" *grammar* \\\\\\\"/manifest.edn\\\\\\\"))\\\\n\\\\n\\\\n(defn- build-dir\\\\n  []\\\\n  (str \\\\\\\"build/antlr/\\\\\\\" *grammar*))\\\\n\\\\n\\\\n(defn- blake3\\\\n{:grammar {:repo \\\\\\\"antlr/grammars-v4\\\\\\\",\\\\n           :path \\\\\\\"python/python3\\\\\\\",\\\\n           :revision \\\\\\\"8af0d4c26c796ea27c15c3d85418f2d0f77c3adb\\\\\\\",\\\\n           ;; The two MIT grammars are vendored verbatim beside this manifest\\\\n           ;; (owner decision \\\\\\\"Vendor .g4 only\\\\\\\"); the Java, JavaScript and Dart\\\\n   