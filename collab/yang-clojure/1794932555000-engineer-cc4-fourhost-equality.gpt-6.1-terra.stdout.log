(publish/publish-module!\n1775:            spec (publish/module-from-index\n1788:            spec (publish/module-from-index\n1798:            spec (publish/module-from-index\n1806:  ;; :cljd first — the publish-name! spy needs with-redefs, which\n1812:             :call-site-tables to publish-name!\"\n1816:         (with-redefs [linker-dht/publish-name!\n1827:                  (apply2/request 1 (get shell-query/link-ops 'publish)\n1831:                 \"ordinary yin.link/publish now carries the retained tables\")))))))\n1839:  \"True when `spec` carries no C1 claim and publishes with no side table.\"\n1842:        side (vm/ast-side-tables (:ast spec) tree origin)\n1843:        res (publish/publish-module! (mem/create-content-mem) spec)]\n1865:                  (publish/module-from-index\n1872:                       (vm/occurrence-origin? o)))\n1874:        \"the mapping is keyed by indexed program, valued by full origin\")\n1884:    (testing \"(b) the drift collision publishes claim-free, not borrowed:\n1897:              the mapped origin's batch differs from the program's t\"\n1900:            b-origin [:source (nth o 1) (inc (nth o 2)) (nth o 3)]\n1901:            b-rows (assoc-in (vec rows) [0 0] b-origin)\n1902:            drifted (assoc tables [b-origin root] b-rows)\n1903:            spec (spec-of drifted (assoc admissions m b-origin))]\n1906:        (is (some #(= b-origin (first %)) (:call-site-rows spec))\n1907:            \"resolution followed the explicit [origin root] key, not t\")))\n1909:              reassigned to the publication origin\"\n1913:            res (publish/publish-module! (mem/create-content-mem) tampered)]\n1916:        (is (= :yin.link.publish/incomplete-call-site-coverage (:reason res)))\n1923:            res (publish/publish-module! (mem/create-content-mem) tampered)]\n1927:    (testing \"(d) []/nil supplied rows publish claim-free, not fully claimed\"\n1930:          (let [res (publish/publish-module!\n1936:    (testing \"(d2) []/n