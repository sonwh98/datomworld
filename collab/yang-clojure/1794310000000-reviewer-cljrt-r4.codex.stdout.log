{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '110,145p' src/cljc/yang/typescript/antlr/prelude.cljc && sed -n '60,110p' src/cljc/yang/clojure/prelude.cljc && sed -n '220,235p' src/cljc/yin/vm/engine.cljc && sed -n '2040,2086p' test/yang/clojure_test.clj\"","aggregated_output":"       (cell/new (assoc (assoc {} :js/type :symbol) :description description)))]\n    [js/str?\n     (fn [x]\n       (if (nil? (get x :js/str)) (not (nil? (get x :js/units))) true))]\n    [js/pair (fn [a b] (conj (conj [] a) b))]\n    [js/vconj (fn [xs x] (conj xs x))]\n    [js/arg (fn [args i] (get args i :js/undefined))]\n    [js/kind-of\n     ;; undefined null boolean number bigint string function object. A\n     ;; number is float64 content, a bigint a bare exact integer: content\n     ;; equality with the same value as float64 tells them apart on every\n     ;; host (the JS carrier is not a host number at all)\n     (fn [x]\n       (if (= x :js/undefined)\n         :undefined\n         (if (= x :js/null)\n           :null\n           (if (= x true)\n             :boolean\n             (if (= x false)\n               :boolean\n               (if (data/number? x)\n                 (if (data/content= x (data/float64 x)) :number :bigint)\n                 (if (js/str? x)\n                   :string\n                   (if (js/cell? x)\n                     (if (= (get (cell/get x) :js/type) :function)\n                       :function\n                       (if (= (get (cell/get x) :js/type) :symbol)\n                         :symbol\n                         ;; A cell-backed foreign callable (a python\n                         ;; or PHP function: a cell whose contents\n                         ;; carry a call entry, no :js/type) is a\n                         ;; function too, not an object.\n                         (if (yang.call/eligible? x) :function :object)))\n                     ;; An admitted foreign callable that is not a JS\n  '[;; ------------------------------------------------- state and namespace\n    [clj/init!\n     (fn []\n       (if (= clj.rt/state :clj/uninit)\n         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n             (yin/def (quote clj.rt/state) :clj/ready))\n         :clj/ready))]\n    ;; the runtime global namespace: one task-local map in a cell, keyed by\n    ;; export name. `clj/define-global!` answers the value, so a publish\n    ;; sequence can chain through it.\n    [clj/define-global!\n     (fn [name value]\n       (do (cell/set! clj.rt/globals\n                      (assoc (cell/get clj.rt/globals) name value))\n           value))]\n    [clj/global-get\n     (fn [name]\n       (if (data/contains? (cell/get clj.rt/globals) name)\n         (get (cell/get clj.rt/globals) name)\n         :clj/unbound))]\n\n    ;; ------------------------------------------------------------- entry\n    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n    ;; internal, so the entry removes one wrapper level from the\n    ;; program's value (a program returning that vector as data was\n    ;; wrapped again, so one level is exact). An error outcome passes\n    ;; through as the failure value for the caller to render.\n    [clj/unwrap-outcome\n     (fn [value]\n       (if (if (data/vector? value) (= (data/count value) 2) false)\n         (if (= (data/nth value 0) :yin.k/ok)\n           (data/nth value 1)\n           value)\n         value))]\n    ;; The global namespace is the task's, not the entry's: no reset\n    ;; here, so projections and earlier units' definitions survive.\n    [clj/run-main\n     (fn [body]\n       (do (clj/init!)\n           (clj/unwrap-outcome (body))))]])\n\n\n(def module-definitions\n  \"The module's definition list: an `:clj/uninit` placeholder for every\n   runtime key, then every definition, stripped.\"\n  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n\n\n(def module-uast\n  \"The module tree: one wide application over the definitions, so every\n   sibling and runtime key read is discharged at module level.\"\n  [state store-of key val]\n  (if (some? store-of)\n    (update-in state [:module-stores store-of]\n               (fn [module-store] (store-put (or module-store {}) key val)))\n    (assoc state :store (store-put (:store state) key val))))\n\n\n(defn- gen-id\n  \"Generate a unique keyword ID from a prefix and counter value.\"\n  [prefix id-counter]\n  (keyword (str prefix \"-\" id-counter)))\n\n\n(defn vm-blocked?\n  \"Returns true if the VM is blocked.\"\n  [vm]\n   (let [walker (run-library forms opts :walker 1000000)\n         semantic (run-library forms opts :semantic 1000000)]\n     (is (= walker semantic) (str \"library lanes agree: \" (pr-str forms)))\n     walker))\n  ([forms opts lane step-limit]\n   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\n                  library-modules lane step-limit)))\n\n\n(defn- lib\n  \"The value of the single expression `form`, or the raw error outcome.\"\n  [form]\n  (let [[tag payload] (run-library [form])]\n    (if (= :yin.k/ok tag) payload [tag payload])))\n\n\n(def ^:private cell-modules\n  \"The library lane's host surface with the `cell` module registered, so a\n   spliced `cell/new` can mint genuine references (the engine seals them\n   under the test composition's capability secret).\"\n  (module/register-cell-module library-modules))\n\n\n(defn- run-cell-probe\n  \"The value of running the compiled probe program with `node` spliced into\n   the marker operand — `(probe <node>)` keeps its call-site routing — on\n   one lane, or the thrown refusal's ex-data.\"\n  [node lane]\n  (let [ast (walk/postwalk\n              (fn [n] (if (= n (u/v 'marker-operand)) node n))\n              (yang/compile-program\n                (into (yang/library-for '[(defn probe\n                                            [m]\n                                            (m :type))])\n                      '[(defn probe\n                          [m]\n                          (m :type))\n                        (probe marker-operand)])\n                true\n                library-opts))]\n    (try\n      (run-guest-ast ast cell-modules lane 1000000)\n      (catch clojure.lang.ExceptionInfo e\n        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\n\n\n(deftest test-common-call-cell-ref-map-invocation\n","exit_code":0,"status":"completed"}}
