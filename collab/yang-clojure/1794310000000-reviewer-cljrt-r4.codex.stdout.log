__get) (u/v escape) (u/lit :clj/outcome))\n                         (outcome-node\n                           error-tag\n                           (u/app (u/v 'yang.call/condition)\n                                  (u/lit :yang.call/invalid-invocation)\n                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\n          public-bridge (u/app (u/lam [escape] activation) u/capture)\n          bridged (if tail?\n                    (u/if-node\n                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\n                      (u/app (u/v 'yang.call/invoke-with)\n                             (u/v callee) (u/v arguments) (u/lit [])\n                             (u/lam [condition] condition->outcome)\n                             (u/app (u/v 'dsg__assoc) (u/lit {})\n                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\n                      public-bridge)\n                    public-bridge)\n          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n                              bridged refused)\n          ;; A callee carrying a call entry is convention territory whether it\n          ;; admits or forges one, so admission rules it. Everything else is a\n          ;; data-side invocation - a collection lookup or a raw closure call -\n          ;; and the guest library's invoker owns those semantics. The invoker\n          ;; is itself a published descriptor, so it is reached the same way\n          ;; any guest callee is; its raise escapes to a capture of this site\n          ;; and the resumed pass materializes the error outcome here.\n          value-call (u/app\n                       (u/lam ['dsg__raise_escape]\n                              (u/if-node\n                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\n                                (u/let1\n                                  (symbol (str reserved-prefix \"invoker_result\"))\n                                  (u/app (u/v 'yang.call/invoke)\n                                         (u/v 'invoke-value)\n                                         (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\n                                         (u/lit [])\n                                         (u/lam [condition]\n                                                (assoc (u/app (u/v 'dsg__raise_escape)\n                                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n                                                                     (u/lit :clj/outcome) condition->outcome))\n                                                       :tail? true)))\n                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \"invoker_result\")))))\n                                (u/if-node\n                                  (u/app (u/v 'dsg__equal)\n                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n                                                (u/lit :clj/escape-token))\n                                         (u/v 'dsg__call_token))\n                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n                                  (outcome-node\n                                    error-tag\n                                    (u/app (u/v 'yang.call/condition)\n                                           (u/lit :yang.call/invalid-invocation)\n                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n                       u/capture)\n          routed (if (::invoker env)\n                   (u/if-node\n                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n                                           (u/lit true)\n                                           (cell-ref-shaped-node (u/v callee)))\n                                (u/lit false))\n                     admitted\n                     value-call)\n                   admitted)]\n      (cond-> (u/mark-tails (u/let1 callee callee-ast\n                                    (u/let1 arguments arguments-ast routed)))\n        tail? (assoc :tail? true)))))\n\n\n(defn- compile-apply\n  \"(apply f a b coll) as one application of f to the assembled argument\n   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n                                           :body (go rest-forms macro-env)}\n                                :operands [(discard-result (compile-def name value env false macro-env))]}\n                         tail? (assoc :tail? true)))\n                     ;; single form\n                     (= 1 (count forms))\n                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n                     ;; sequence\n                     :else\n                     (cond-> {:type     :application\n                              :operator {:type :lambda, :params ['_]\n                                         :body (go rest-forms macro-env)}\n                              :operands [(discard-result\n                                           (compile-form head false\n                                                         (assoc env ::top-level true) macro-env))]}\n                       tail? (assoc :tail? true))))))]\n       (cond->> (go forms initial-macro-env)\n         ;; The two sibling closures share one frame: separate bindings would\n         ;; retain one extra helper environment in every closure a guest\n         ;; captures (the machine-data validation bound notices).\n         (outcomes? env) (#(u/app\n                             (u/lam '[dsg__admitted? dsg__intra_call] %)\n                             (u/sexp->uast\n                               '(fn [dsg__candidate]\n                                  (if (data/map? dsg__candidate)\n                                    ;; A map is offered to the dereference\n                                    ;; only when it could be a reference\n                                    ;; the VM issued, as the descriptor\n                                    ;; projection treats a cell-backed\n                                    ;; callable (yang.antlr.md 8.10.2),\n                                    ;; whose entry lives in the cell\n                                    ;; contents: the issued format\n                                    ;; (`:type :cell-ref`, `:id`, `:seal`,\n                                    ;; no other entries, a 64-character\n                                    ;; string seal) AND an `:id` in the\n                                    ;; engine's heap id language — every\n                                    ;; cell id is a `:cell-N` keyword, so\n                                    ;; any other `:id` names no cell the\n                                    ;; task could have minted and the map\n                                    ;; is data. Data falls to the witness\n                                    ;; branch and, entryless, is no more\n                                    ;; admitted than any other source map,\n                                    ;; so its invocation stays ordinary\n                                    ;; map data. A candidate that passes\n                                    ;; with a wrong seal is a capability\n                                    ;; counterfeit: `cell/get` fails\n                                    ;; closed in the VM and grants\n                                    ;; nothing — authenticity is the VM's\n                                    ;; heap+seal check, never a shape.\n                                    (let [dsg__cell-ref?\n                                          (if (dsg__equal\n                                                (dsg__get dsg__candidate :type)\n                                                :cell-ref)\n                                            (if (data/contains? dsg__candidate\n                                                                :id)\n                                              (if (data/contains? dsg__candidate\n                                                                  :seal)\n                                                (if (dsg__equal\n                                                      (data/count dsg__candidate)\n                                                      3)\n                                                  (if (data/string?\n                                                        (dsg__get dsg__candidate\n                                                                  :seal))\n                                                    (if (dsg__equal\n                                                          (data/str-length\n                                                            (dsg__get dsg__candidate\n                                                                      :seal))\n                                                          64)\n                                                      (if (kind/keyword?\n                                                            (dsg__get dsg__candidate\n                                                                      :id))\n                                                        (dsg__equal\n                                                          (data/str-index-of\n                                                            (kind/name\n                                                              (dsg__get dsg__candidate\n                                                                        :id))\n                                                            \"cell-\")\n                                                          0)\n                                                        false)\n                                                      false)\n                                                    false)\n                                                  false)\n                                                false)\n                                              false)\n                                            false)]\n                                      (if dsg__cell-ref?\n                                        (let [dsg__descriptor\n                                              (cell/get dsg__candidate)\n                                              dsg__entry\n                                              (dsg__get dsg__descriptor\n                                                        :yang.call/entry)]\n                                          (data/callable? dsg__entry))\n                                        (let [dsg__entry\n                                              (dsg__get dsg__candidate\n                                                        :yang.call/entry)\n                                              dsg__witness\n                                              (dsg__get dsg__candidate\n                                                        :clj/admission)]\n                                          (if (data/callable? dsg__entry)\n                                            (if (data/callable? dsg__witness)\n                                              (dsg__equal\n                                                dsg__witness\n                                                (dsg__make_admission\n                                                  (dsg__assoc dsg__candidate\n                                                              :clj/admission\n                                                              nil)))\n                                              false)\n                                            false))))\n                                    false)))\n                             ;; The intra-unit dispatcher: resolve the unit's public entry,\n                             ;; apply it with the compiler's token packet [token args] - one\n                             ;; variadic conj and one application, no record construction.\n                             ;; Non-map callees refuse.\n                             (u/sexp->uast\n                               (list 'fn '[dsg__callee dsg__args]\n                                     (list 'if '(data/map? dsg__callee)\n                                           (list (list (if (contains? (::defined env) 'get)\n                                                         'dsg__get\n                                                         'get)\n                                                       'dsg__callee\n                                                       :yang.call/entry)\n                                                 (list 'conj '[]\n                                                       'dsg__call_token\n                                                       'dsg__args))\n                                           '(conj (conj [] :yin.k/error)\n                                                  (yang.call/condition\n                                                    :yang.call/not-callable\n                                                    (dsg__assoc {} :yang.call/callee dsg__callee))))))))\n         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n         (outcomes? env) (u/let1\n                           'dsg__make_admission\n                           (u/sexp->uast\n                             '(fn [dsg__descriptor]\n                                (fn [dsg__candidate]\n                                  (if (data/callable? dsg__call_token)\n                                    (dsg__get dsg__descriptor :yang.call/entry)\n                                    nil)))))\n         (outcomes? env) (u/then\n                           (discard-result\n                             (u/app (u/lam '[get = assoc empty?] call/uast)\n                                    (u/v 'dsg__get) (u/v 'dsg__equal)\n                                    (u/v 'dsg__assoc) (u/v 'dsg__empty))))\n         (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\n         ;; Guest closures keep captured environments portable: binding host\n         ;; primitive values here would make UCF machine-data validation fail.\n         ;; These helpers cover generated map lookups/writes and comparisons;\n         ;; conj/vec are already protected by the convention's binder checks.\n;; `read-forms` is the frontend's parser — the reader itself — and\n;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n;; whose call runs the program compiled under the argument-vector\n;; convention and the outcome model over the guest library, with every\n;; top-level definition published to the runtime global namespace\n;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n;; its module's globals. No call node is rewritten and no foreign\n;; `:code` is extracted: the unit is the program's own lowering,\n;; wrapped.\n\n(def unit-opts\n  \"The `compile-program` opts a linked unit compiles with: the\n   argument-vector convention with the outcome model over the guest\n   library's adapters, every VM primitive callable directly by bare name.\"\n  {:convention :arg-vector,\n   :outcomes true,\n   :adapters library-adapters,\n   :native vm/primitive-profiles})\n\n\n(def top-defining-operators\n  \"The operators whose second element names a top-level definition.\"\n  '#{def defn defn- defmacro})\n\n\n(defn read-forms\n  \"Every form `source` text reads. The reader is the parser: a malformed\n   source throws, as any frontend's refused parse does.\"\n  [source]\n  (let [rd (rt/string-push-back-reader source)]\n    (loop [forms []]\n      (let [form (treader/read rd false ::eof)]\n        (if (= form ::eof)\n          forms\n          (recur (conj forms form)))))))\n\n\n(defn top-level-names\n  \"The names `forms` define at the top level, in order: the second element\n   of each def/defn/defn-/defmacro head.\"\n  [forms]\n  (into []\n        (comp (filter #(and (seq? %) (contains? top-defining-operators (first %))))\n              (map (comp strip-symbol-meta second)))\n        forms))\n\n\n(declare publish-to-globals)\n\n\n(defn- globals-child\n  [x names bound]\n  (cond\n    (and (map? x) (contains? x :type)) (publish-to-globals x names bound)\n    (vector? x) (mapv #(globals-child % names bound) x)\n    :else x))\n\n\n(defn- publish-to-globals\n  \"Rewrite the compiled `node` for the linked unit: a top-level\n   definition in `names` becomes a `clj/define-global!` write and a free\n   read of one becomes a `clj/global-get`, both under the name's string.\n   The `names` a unit is lowered with are its own top-level definitions,\n   its guest library's and the projected names the composition bound in\n   the runtime global namespace, so a projected export and a definition\n   read through the one binding: a definition the unit itself runs\n   publishes after the projection and shadows it. A store definition\n   inside the unit thunk is conditional to the linker, so no body read\n   of it discharges (the runtime preludes avoid this by keeping every\n   definition at module level); the runtime global namespace is the\n   linked unit's definition table instead, as a Python module body\n   writes its dictionary. Lexically bound names, quoted literals and\n   macro definitions keep their store shape: a macro is not a runtime\n   value.\"\n  [node names bound]\n  (case (:type node)\n    :literal node\n    :vm/current-continuation node\n    :variable (if (and (contains? names (:name node))\n                       (not (contains? bound (:name node))))\n                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\n                node)\n    :lambda (assoc node :body (publish-to-globals (:body node) names\n                                                  (into bound (:params node))))\n    :application\n    (if (and (= 'yin/def (get-in node [:operator :name]))\n             (= 2 (count (:operands node)))\n             (= :literal (:type (first (:operands node))))\n             (contains? names (:value (first (:operands node)))))\n      (u/app (u/v 'clj/define-global!)\n             (u/lit (str (:value (first (:operands node)))))\n             (publish-to-globals (second (:operands node)) names bound))\n      (assoc node\n             :operator (publish-to-globals (:operator node) names bound)\n             :operands (mapv #(publish-to-globals % names bound)\n                             (:operands node))))\n    :if (cond-> node\n          (contains? node :test)\n          (assoc :test (publish-to-globals (:test node) names bound))\n          (contains? node :consequent)\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n          (contains? node :alternate)\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n    (reduce (fn [n k]\n              (let [v (get n k)]\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\n                  (assoc n k (globals-child v names bound))\n                  n)))\n            node (keys node))))\n\n\n(defn lower-unit\n  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n   thunk whose call runs the program — `forms` plus the definitions of\n   the guest library they need, compiled unmodified under `unit-opts`\n   and published to the runtime global namespace by\n   `publish-to-globals` — so the helper's export projection can read\n   each top-level definition. The two-argument form also takes the\n   projected `exports` (names the composition already bound in the\n   runtime global namespace): their free reads publish the same way, so\n   the projection is the caller's binding for them. The program's own\n   `yang.call` call sites need no free-name declaration: the convention\n   preamble `compile-program` emits defines those names locally, and\n   the donor publication pins the `yang.call` module for the qualified\n   reads that remain.\"\n  ([forms] (lower-unit forms []))\n  ([forms exports]\n   (let [source (vec forms)\n         library (library-for source)\n         program (compile-program (concat source library) true unit-opts)\n         macros (into #{}\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n                            (map (comp strip-symbol-meta second)))\n                      (concat source library))\n         names (reduce disj\n                       (into (set (top-level-names source))\n                             (concat (map (comp strip-symbol-meta second) library)\n                                     (map symbol exports)))\n                       macros)]\n     (u/lam [] (publish-to-globals program names #{})))))\n\n\n(defn output\n  \"The `clj/run-main` value as test data.\"\n  [value]\n  (pr-str value))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '150,205p' test/yang/cross_lang_test.clj && sed -n '2050,2150p' test/yang/clojure_test.clj && rg -n '8\\\\.10|conformance' docs/design\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '150,205p' test/yang/cross_lang_test.clj && sed -n '2050,2150p' test/yang/clojure_test.clj && rg -n '8\\\\.10|conformance' docs/design\"","aggregated_output":"\n(deftest clojure-source-cell-ref-map-invocation-test\n  (testing \"a source map {:type :cell-ref} is ordinary invocable data\"\n    ;; The donor's exported function invokes its own source map literal:\n    ;; the map lookup answers 42, where the structural cell test used to\n    ;; dereference the map as a cell and fail the VM.\n    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n           (xl/call [:clojure\n                     \"(defn probe [] ({:type :cell-ref :marker 42} :marker))\"]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"]))))\n  (testing \"a source map with the full forged cell-ref shape is ordinary invocable data\"\n    ;; The map spells every key of an issued reference among its own\n    ;; entries; it is still data, so the lookup answers 42 where key\n    ;; presence alone used to dereference it and fail the VM.\n    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n           (xl/call [:clojure\n                     \"(defn probe [] ({:type :cell-ref :id :customer :seal \\\"wax\\\" :marker 42} :marker))\"]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"]))))\n  (testing \"a full-shape three-entry map with a valid-format 64-char seal is ordinary invocable data\"\n    ;; The exact issued format — three entries, a seal string of the issued\n    ;; length — with an :id the engine's heap could never have minted (heap\n    ;; ids are :cell-N keywords): the map can never be a reference, so the\n    ;; invocation is the map lookup and answers the stored seal string,\n    ;; where the shape gates of the previous rounds routed it to admission\n    ;; and the dereference refused the VM.\n    (is (= {:js/out [(str \"\\\"\" (apply str (repeat 64 \"a\")) \"\\\"\")], :js/uncaught nil}\n           (xl/call [:clojure\n                     (str \"(defn probe [] ({:type :cell-ref :id :some-key \"\n                          \":seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\"} :seal))\")]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"]))))\n  (testing \"a runtime-built full-shape map (assoc-constructed, not a bound literal) invokes as data\"\n    ;; The map is assembled by assoc at runtime, so no literal ever holds\n    ;; it; the shape test runs on the constructed value and the lookup\n    ;; still answers the stored seal string.\n    (is (= {:js/out [(str \"\\\"\" (apply str (repeat 64 \"a\")) \"\\\"\")], :js/uncaught nil}\n           (xl/call [:clojure\n                     (str \"(defn probe [] (let [m (assoc (assoc (assoc {} :type :cell-ref) \"\n                          \":id :some-key) \"\n                          \":seal \\\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\\\")] \"\n                          \"(m :seal)))\")]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"]))))\n  (testing \"a runtime-built map with the forged cell-ref shape is ordinary invocable data\"\n    (is (= {:js/out [\"42n\"], :js/uncaught nil}\n           (xl/call [:clojure\n                     \"(defn probe [] (let [m {:type :cell-ref :id :customer :seal \\\"wax\\\" :marker 42}] (m :marker)))\"]\n                    [\"probe\"]\n                    [:typescript \"console.log(probe());\"])))))\n\n\n(deftest python-function-kind-of-in-typescript-test\n  (testing \"js/kind-of over a cell-backed foreign callable is :function\"\n    (is (= {:js/out [\"function\"], :js/uncaught nil}\n  \"The value of the single expression `form`, or the raw error outcome.\"\n  [form]\n  (let [[tag payload] (run-library [form])]\n    (if (= :yin.k/ok tag) payload [tag payload])))\n\n\n(def ^:private cell-modules\n  \"The library lane's host surface with the `cell` module registered, so a\n   spliced `cell/new` can mint genuine references (the engine seals them\n   under the test composition's capability secret).\"\n  (module/register-cell-module library-modules))\n\n\n(defn- run-cell-probe\n  \"The value of running the compiled probe program with `node` spliced into\n   the marker operand — `(probe <node>)` keeps its call-site routing — on\n   one lane, or the thrown refusal's ex-data.\"\n  [node lane]\n  (let [ast (walk/postwalk\n              (fn [n] (if (= n (u/v 'marker-operand)) node n))\n              (yang/compile-program\n                (into (yang/library-for '[(defn probe\n                                            [m]\n                                            (m :type))])\n                      '[(defn probe\n                          [m]\n                          (m :type))\n                        (probe marker-operand)])\n                true\n                library-opts))]\n    (try\n      (run-guest-ast ast cell-modules lane 1000000)\n      (catch clojure.lang.ExceptionInfo e\n        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\n\n\n(deftest test-common-call-cell-ref-map-invocation\n  (testing \"a full-shape data map with a 64-character seal is ordinary invocable data\"\n    ;; The map spells every key of an issued reference and the seal has the\n    ;; issued format; its :id names nothing in the engine's heap id language\n    ;; (:cell-N), so it can never be genuine and its invocation is the map\n    ;; lookup, on both evaluators, where the previous rounds' shape gates\n    ;; routed it to admission and the dereference refused it.\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :type))])))\n    (is (= [:yin.k/ok :some-key]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :id))]))))\n  (testing \"a runtime-built full-shape map (assoc, not a bound literal) invokes as data\"\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m (assoc (assoc (assoc {} :type :cell-ref)\n                                                :id :some-key)\n                                         :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")]\n                            (m :type))]))))\n  (testing \"a full-shape map that is data is not call-eligible\"\n    (is (= [:yin.k/ok false]\n           (run-library '[(yang.call/eligible? {:type :cell-ref :id :some-key\n                                                :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})]))))\n  (testing \"genuine references still dereference through admission\"\n    ;; A cell the engine minted (:cell-0), holding a descriptor with a\n    ;; callable entry: the call reaches the entry.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-probe (u/app (u/v 'cell/new)\n                                    (u/app (u/v 'assoc) (u/lit {})\n                                           (u/lit :yang.call/entry)\n                                           (u/lam ['invocation] (u/lit :called))))\n                             lane))\n          (str lane \" genuine live\"))))\n  (testing \"a genuine-but-dead reference keeps the standing refusal\"\n    ;; A genuine cell whose contents carry no call entry: admission answers\n    ;; false and the call refuses as not-callable — the behavior the D2 bar\n    ;; pins, unchanged by the data fallback.\n    (doseq [lane [:walker :semantic]]\n      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\n                                                     lane)]\n        (is (and (= :yin.k/error tag)\n                 (= :yang.call/not-callable (:yang.call/reason payload)))\n            (str lane \" genuine dead: \" (pr-str result))))))\n  (testing \"the residual, pinned: a forged id inside the heap language fails closed in the VM\"\n    ;; A map whose :id is a :cell-N keyword and whose seal has the issued\n    ;; format but not the issued content: it is a dereference candidate the\n    ;; VM's heap+seal check rejects — a host-level refusal, the same fate\n    ;; any forged reference meets anywhere in the system. No in-language\n    ;; authenticity probe exists (check-ref! throws past every guest catch),\n    ;; so this class stays fail-closed until yin.vm publishes one.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\n             (run-cell-probe (u/lit {:type :cell-ref :id :cell-7\n                                     :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n                             lane))\n          (str lane \" forged in-language id\")))))\n\n\n(deftest test-library-closes-over-its-own-names\n  (testing \"library-for returns the definitions a program mentions, transitively\"\n    (let [names (set (map second (yang/library-for '[(seq? x)])))]\n      (is (every? names '[seq? sequential? vector? map? set? coll?])\n          \"seq? pulls sequential?, vector?, map?, set? and coll?\")\n      (is (not (contains? names 'map))))\ndocs/design/dao.postgraphics.v3.md:23:conformance implies v2 and v1 conformance.\ndocs/design/dao.postgraphics.v3.md:38:consistent with v3's policy for that subset; v3 conformance requires applying\ndocs/design/dao.postgraphics.v3.md:300:V3 fixes the line cap to **butt** for v3 conformance. Butt caps end the stroke\ndocs/design/dao.postgraphics.v3.md:308:V3 fixes the line join to **bevel** for v3 conformance. Bevel joins connect\ndocs/design/dao.postgraphics.v4.md:14:V4 conformance implies v3 conformance, which impl