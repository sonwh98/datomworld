\n+                            (quote [(defn replay\n+                                      [x]\n+                                      (let [[a b] [x 1.5]]\n+                                        (+ (identity ^:replay a)\n+                                           (identity ^:replay a) b)))\n+                                      (replay 2)])\n+                            true yang/unit-opts)]\n+                         [:lower-unit\n+                          (yang/lower-unit\n+                            (quote [(defn replay\n+                                      [x]\n+                                      (let [[a b] [x 1.5]]\n+                                        (+ (identity ^:replay a)\n+                                           (identity ^:replay a) b)))\n+                                      (replay 2)]))]]]\n+      (testing (str label)\n+        (let [ctors (arity-ctors ast)]\n+          (is (pos? (count ctors)))\n+          (doseq [c ctors]\n+            (is (sorted-ascending? (pair-keys c)))\n+            ;; the ruled named order: :yin.k/fn, :yin.vm.data/reason,\n+            ;; :yin.k/argc (key roots 1e0366, 81b62c, 8930bf)\n+            (is (= [:yin.k/fn :yin.vm.data/reason :yin.k/argc]\n+                   (mapv (fn [i] (:value (nth (:operands c) (inc (* 2 i)))))\n+                         (range 3))))))))))\n+\n+\n (deftest published-module-test\n   (testing \"the markers are retrievable from the published module\"\n     (let [store (mem/create-content-mem)","is_error":false}]},"parent_tool_use_id":null,"session_id":"024a2da5-c785-45c9-991b-d9d054578146","uuid":"2ef09da6-7874-4600-b350-0632c3a7ae86","timestamp":"2026-11-18T19:36:41.534Z","tool_use_result":{"stdout":"diff --git a/test/resources/yang/clojure/cc4-replay-snapshots.edn b/test/resources/yang/clojure/cc4-replay-snapshots.edn\nindex 1e4d1424..f2a5cf15 100644\n--- a/test/resources/yang/clojure/cc4-replay-snapshots.edn\n+++ b/test/resources/yang/clojure/cc4-replay-snapshots.edn\n@@ -1