ode scope params depth]\\n  (cond\\n    (or (nil? node) (> depth 8)) :computed\\n    (= :literal (:type node)) :literal\\n    ;; constant-argument values (a fully constant argument vector's\\n    ;; elements arrive as data, not nodes)\\n    (not (coll? node)) :literal\\n    (= :variable (:type node))\\n    (if (contains? params (:name node))\\n      :variable\\n      (if-let [init (get scope (:name node))]\\n        (recur init scope params (inc depth))\\n        :variable))\\n    (and (= :application (:type node)) (kernel-intra-call? node)\\n         (contains? kernel-ambient-state-constructors\\n                    (get-in node [:operands 0 :name])))\\n    (let [args-node (second (:operands node))\\n          arg-nodes (kernel-site-arguments args-node)\\n          first-arg (if (sequential? arg-nodes) (first arg-nodes)\\n                        (when (= :literal (:type (or (kernel-stamped-args? args-node) args-node)))\\n                          (first (:value (or (kernel-stamped-args? args-node) args-node)))))]\\n      (if (and (= 'kernel-context (get-in node [:operands 0 :name]))\\n               (map? first-arg) (= :literal (:type first-arg))\\n               (= [{} {}] (:value first-arg)))\\n        :ambient-literal\\n        (if (and (sequential? arg-nodes) (= 1 (count arg-nodes))\\n                 (= :ambient-literal (kernel-resolve-site-arg (first arg-nodes)\\n                                                              scope params (inc depth))))\\n          :ambient-literal :computed)))\\n    ;; the compiler's outcome unwrap and let-hoist of one call: the\\n    ;; argument expression is (data/nth <hoisted-binding> 1), and the\\n    ;; binding's init is the call itself — resolve through it\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1794250000000-reviewer-d2-authenticity-r2.codex.stdout.log:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat test/d2_wedge_probe2.clj test/d2_wedge_min_repro.clj'\",\"aggregated_output\":\"(ns d2-wedge-probe2\\n  \\\"H3-1 wedge diagnostic, round 2: drive the REAL kernel-c semantic path.\\n\\n  Round 1's probe (test/d2_wedge_probe.clj) never queued the fixture onto\\n  the session medium — `tu/make-observer-session` mints an EMPTY medium and\\n  the probe called no queue variant — so its evaluator-session drive was\\n  vacuous: a fresh SemanticVM is `:halted? true` (yin.vm.semantic/create-vm)\\n  before any step, and run-on-stream over an empty medium loads nothing and\\n  runs nothing. Stage A below reproduces that drive and measures its step\\n  count to confirm the false negative.\\n\\n  Stage B re-measures the exact kernel-c semantic path —\\n  `yang.clojure-test/run-guest-machine`'s semantic branch\\n  (tu/make-observer-session + tu/queue-rows! + observer/run-on-stream +\\n  run-bounded over vm/step) — instrumented at vm/step (count, wall time,\\n  machine entering each step) and at the run-on-stream boundary (ready\\n  checks, batches loaded, run entries with per-run step deltas), with a\\n  watchdog that separates the three failure shapes:\\n\\n    - BUDGET-THROWN   run-bounded's 2M exhaustion throw reaches the caller\\n    - WEDGE-IN-STEP   step count frozen: one vm/step never returns; the\\n                      worker stack trace plus the entering machine are dumped\\n    - RATE-COLLAPSE   steps still advance but steps/sec decays toward zero;\\n                      the per-tick rate table plus a final snapshot are dumped\\\"\\n  (:require [clojure.test :refer [deftest is testing]]\\n            [dao.stream.observer :as observer]\\n            [yang.clojure :as yang]\\n            [yang.clojure-test :as compiler-test]\\n            [yang.latte-oracle-test :as latte]\\n            [yin.vm :as vm]\\n            [yin.vm.engine :as engine]\\n            [yin.vm.semantic :as semantic]\\n            [yin.vm.semantic.linearize :as linearize]\\n            [yin.vm.test-utils :as tu]))\\n\\n(def ^:private original-step vm/step)\\n(def ^:private original-run-on-stream observer/run-on-stream)\\n\\n;; ---------------------------------------------------------------- instrumentation\\n\\n(def steps (atom 0))\\n(def in-step-nanos (atom 0))\\n(def recent-durations (atom []))          ;; last 64 step durations, nanos\\n(def last-machine (volatile! nil))        ;; machine entering the latest step\\n(def load-count (atom 0))\\n(def ready-count (atom 0))\\n(def run-log (atom []))                   ;; one entry per run-on-stream `run`\\n(def start-ms (atom nil))\\n\\n(defn- reset-instrumentation!\\n  []\\n  (reset! steps 0)\\n  (reset! in-step-nanos 0)\\n  (reset! recent-durations [])\\n  (vreset! last-machine nil)\\n  (reset! load-count 0)\\n  (reset! ready-count 0)\\n  (reset! run-log [])\\n  (reset! start-ms (System/currentTimeMillis)))\\n\\n(defn- counted-step\\n  [machine]\\n  (let [n (swap! steps inc)]\\n    (when (= n 1) (println :STEP-STARTED) (flush))\\n    (vreset! last-machine machine)\\n    (let [t0 (System/nanoTime)\\n          v (original-step machine)\\n          t1 (System/nanoTime)\\n          d (- t1 t0)]\\n      (swap! in-step-nanos + d)\\n      (swap! recent-durations (fn [r] (vec (take-last 64 (conj r d)))))\\n      v)))\\n\\n(defn- instrumented-run-on-stream\\n  [session ready? load run]\\n  (let [ready?* (fn [c] (swap! ready-count inc) (ready? c))\\n        load* (fn [c batch] (swap! load-count inc) (load c batch))\\n        run* (fn [c]\\n               (let [before @steps]\\n                 (try\\n                   (let [v (run c)]\\n                     (swap! run-log conj {:entry-steps before\\n                                          :exit-steps @steps\\n                                          :threw false})\\n                     v)\\n                   (catch Throwable t\\n                     (swap! run-log conj {:entry-steps before\\n                                          :exit-steps @steps\\n                                          :threw (ex-message t)})\\n                     (throw t)))))]\\n    (original-run-on-stream session ready?* load* run*)))\\n\\n;; ---------------------------------------------------------------- state capture\\n\\n(defn- bounded-str\\n  [x]\\n  (let [s (pr-str x)]\\n    (if (> (count s) 240) (str (subs s 0 240) \\\"…\\\") s)))\\n\\n(defn- instruction-at\\n  \\\"The register instruction the machine's :control points at — op and\\n  operands, bounded. The instruction vector is static code, so its size is\\n  the compiler's, not the machine's.\\\"\\n  [machine]\\n  (try\\n    (let [{:keys [segment pc]} (:control machine)\\n          image (get (:code machine) segment)]\\n      (if (and image (number? pc) (vector? (:vector image)))\\n        (bounded-str (try (nth (:vector image) pc)\\n                          (catch Exception e\\n                            {:nth-failed (ex-message e)})))\\n        {:segment segment :pc pc :image (nil? image)}))\\n    (catch Exception e {:unreadable (ex-message e)})))\\n\\n(defn- machine-snapshot\\n  \\\"Bounded view of one machine: no closures, no environments, no stores.\\\"\\n  [m]\\n  (when m\\n    (let [k (:k m)\\n          top (when (vector? k) (peek k))]\\n      {:halted? (:halted? m)\\n       :blocked? (:blocked? m)\\n       :cont-depth (if (vector? k) (count k) (when k 1))\\n       :control (when-let [c (:control m)] (select-keys c [:segment :pc]))\\n       :control-inst (instruction-at m)\\n       :top-frame (when (map? top) (select-keys top [:type :segment :pc :rd]))\\n       :wait-set (count (or (:wait-set m) []))\\n       :ready-queue (count (or (:ready-queue m) []))\\n       :window-size (count (:window m))\\n       :value (bounded-str (:value m))})))\\n\\n(defn- duration-stats\\n  []\\n  (let [rs @recent-durations]\\n    (when (seq rs)\\n      (let [sorted (sort rs)]\\n        {:n (count sorted)\\n         :min-ns (first sorted)\\n         :p50-ns (nth sorted (quot (count sorted) 2))\\n         :max-ns (last sorted)}))))\\n\\n;; ---------------------------------------------------------------- stage A\\n\\n(defn- make-load-rows\\n  []\\n  (vm/fresh-code-loader\\n    (fn [m rows stamp]\\n      (vm/check-contract! vm/ast-contract stamp)\\n      (semantic/load-vector m\\n                            (:vector (linearize/project-rows rows))\\n                            vm/semantic-contract))\\n    vm/ast-contract))\\n\\n(defn- old-probe-bounded-run\\n  \\\"Round 1's runner, verbatim semantics.\\\"\\n  [machine]\\n  (loop [v machine n 0]\\n    (cond\\n      (or (vm/halted? v) (vm/blocked? v)) v\\n      (= n 2000000)\\n      (throw (ex-info \\\"Guest instruction budget exhausted\\\"\\n                      {:lane :semantic :steps n :consumer v}))\\n      :else (recur (vm/step v) (inc n)))))\\n\\n(defn- stage-a-vacuity\\n  \\\"Reproduce round 1's evaluator-session drive exactly — including its\\n  missing queue step — and measure how many steps it actually executed.\\\"\\n  []\\n  (println :STAGE-A :round-1-probe-reproduction\\n           {:medium :empty-at-start :queue :absent-as-in-round-1})\\n  (flush)\\n  (reset-instrumentation!)\\n  (let [fixture (first (filter #(= :check-assume-have-discharge (:id %))\\n                               (:fixtures (deref #'latte/kernel-gate-corpus))))\\n        ;; round 1 compiled the fixture and never used the result; the call\\n        ;; itself is kept so stage A matches that run's cost shape\\n        _ ((deref #'latte/kernel-compile) fixture)\\n        lm (deref #'compiler-test/library-modules)\\n        machine (semantic/create-vm {:make-stream tu/make-stream\\n                                     :capability-secret tu/secret\\n                                     :modules lm})\\n        session (tu/make-observer-session machine)]\\n    (with-redefs [vm/step counted-step\\n                  observer/run-on-stream instrumented-run-on-stream]\\n      (let [done (observer/run-on-stream session\\n                                         engine/ready-for-ingress?\\n                                         (make-load-rows)\\n                                         old-probe-bounded-run)]\\n        (println :STAGE-A-RESULT\\n                 {:steps @steps\\n                  :loads @load-count\\n                  :halted (vm/halted? (:consumer done))\\n                  :blocked (vm/blocked? (:consumer done))\\n                  :verdict (if (zero? @steps)\\n                             :VACUOUS-no-program-ever-loaded\\n                             :REAL-round1-was-valid)})\\n        (flush)))))\\n\\n;; ---------------------------------------------------------------- stage B\\n\\n(def ^:private tick-ms 10000)\\n(def ^:private wall-cap-ms 1800000)\\n(def ^:private frozen-ticks 3)\\n\\n(defn- print-tick\\n  [t steps-prev]\\n  (let [n @steps\\n        in-step-ms (quot @in-step-nanos 1000000)\\n        elapsed (quot (- (System/currentTimeMillis) @start-ms) 1000)\\n        m @last-machine\\n        k (:k m)\\n        stats (duration-stats)\\n        rate (if (>= steps-prev 0)\\n               (quot (* (- n steps-prev) 1000) t)\\n               :first-tick)]\\n    (println :TICK {:s elapsed :steps n :in-step-ms in-step-ms\\n                    :steps-per-s-last-tick rate\\n                    :step-ns stats\\n                    :cont-depth (when (vector? k) (count k))\\n                    :loads @load-count :runs (count @run-log)})\\n    (flush)\\n    n))\\n\\n(defn- dump-state\\n  [worker label]\\n  (println label {:steps @steps\\n                  :in-step-ms (quot @in-step-nanos 1000000)\\n                  :loads @load-count\\n                  :ready-checks @ready-count\\n                  :runs @run-log\\n                  :entering-machine (machine-snapshot @last-machine)})\\n  (when worker\\n    (println :WORKER-STACK)\\n    (doseq [frame (take 60 (.getStackTrace worker))]\\n      (println \\\"  \\\" (str frame)))\\n    (flush)))\\n\\n(defn- stage-b-real-path\\n  []\\n  (println :STAGE-B :real-kernel-c-semantic-path\\n           {:driver 'yang.clojure-test/run-guest-machine\\n            :fixture :check-assume-have-discharge\\n            :step-limit 2000000\\n            :wall-cap-ms wall-cap-ms})\\n  (flush)\\n  (reset-instrumentation!)\\n  (let [fixture (first (filter #(= :check-assume-have-discharge (:id %))\\n                               (:fixtures (deref #'latte/kernel-gate-corpus))))\\n        compiled ((deref #'latte/kernel-compile) fixture)\\n        _ (when-not (= :compiled (:status compiled))\\n            (println :STAGE-B-BLOCKED-AT-COMPILE\\n                     (select-keys compiled [:status :blocked-by]))\\n            (flush))\\n        ast (:ast compiled)\\n        modules ((deref #'latte/oracle-registry) yang/kind-module)\\n        result (atom {:kind :none})\\n        worker (Thread. (fn []\\n                          (try\\n                            (let [machine (compiler-test/run-guest-machine\\n                                            ast modules :semantic 2000000)]\\n                              (reset! result {:kind :returned\\n                                              :machine (machine-snapshot machine)\\n                                              :value (bounded-str (vm/value machine))}))\\n                            (catch Throwable t\\n                              (reset! result\\n                                      {:kind :threw\\n                                       :class (str (class t))\\n                                       :message (ex-message t)\\n                                       :data-keys (vec (keys (ex-data t)))\\n                                       :consumer (machine-snapshot\\n                                                   (:consumer (ex-data t)))\\n                                       :session-consumer (machine-snapshot\\n                                                           (:consumer\\n                                                             (:session (ex-data t))))})))))]\\n    (.setName worker \\\"wedge-worker\\\")\\n    (.setDaemon worker true)\\n    (with-redefs [vm/step counted-step\\n                  observer/run-on-stream instrumented-run-on-stream]\\n      (.start worker)\\n      (loop [prev -1 frozen 0]\\n        (Thread/sleep (long tick-ms))\\n        (let [alive (.isAlive worker)\\n              n (when alive (print-tick tick-ms prev))]\\n          (cond\\n            (not alive)\\n            (do (println :WORKER-DONE (assoc @result\\n                                             :steps @steps\\n                                             :in-step-ms (quot @in-step-nanos 1000000)\\n                                             :loads @load-count\\n                                             :ready-checks @ready-count\\n                                             :runs @run-log))\\n                (flush)\\n                (condp = (:kind @result)\\n                  :returned (System/exit 0)\\n                  :threw (System/exit 1)\\n                  (System/exit 4)))\\n\\n            (>= (- (System/currentTimeMillis) @start-ms) (long wall-cap-ms))\\n            (do (dump-state worker :RATE-COLLAPSE-WALL-CAP) (System/exit 2))\\n\\n            (and n (= n prev))\\n            (do (when (>= (inc frozen) frozen-ticks)\\n                  (dump-state worker :WEDGE-CONFIRMED-IN-STEP)\\n                  (System/exit 3))\\n                (recur (or n prev) (inc frozen)))\\n\\n            :else (recur (or n prev) 0)))))))\\n\\n(defn -main\\n  [& _args]\\n  (println :PIN {:commit \\\"8ea857c1+probe2\\\"\\n                 :fixture :check-assume-have-discharge\\n                 :lane :semantic\\n                 :budget \\\"2M instrumented steps\\\"\\n                 :jvm (str (System/getProperty \\\"java.version\\\"))})\\n  (flush)\\n  (stage-a-vacuity)\\n  (stage-b-real-path))\\n\\n(deftest test-h31-wedge-probe2\\n  (testing \\\"diagnostic probe only — contributes zero coverage\\\"\\n    (-main)\\n    (is true)))\\n\\n;; ---------------------------------------------------------------- stage C\\n\\n;; Stage B showed the fixture's own semantic cell completes (1.1M steps,\\n;; seconds of stepping) when driven alone. The reported stalls were observed\\n;; on the whole-corpus gate, so stage C drives the gate itself — every\\n;; fixture's A/B/compile/walker/semantic legs — under timing wrappers and\\n;; the vm/step counter, with freeze detection that dumps the worker stack\\n;; wherever the run stops advancing (C lane stepping, host A/B eval, or\\n;; anywhere else).\\n\\n(def ^:private gate-frozen-ticks 30)          ;; 5 min without a step\\n(def ^:private gate-wall-cap-ms 5400000)      ;; the longest observed trial\\n\\n(defn- wall-ms-since\\n  [t0]\\n  (- (System/currentTimeMillis) t0))\\n\\n(defn- stage-c-gate\\n  []\\n  (println :STAGE-C :full-differential-gate\\n           {:test 'yang.latte-oracle-test/test-kernel-differential-gate\\n            :freeze-ticks gate-frozen-ticks\\n            :wall-cap-ms gate-wall-cap-ms})\\n  (flush)\\n  (reset-instrumentation!)\\n  (let [gate-t0 (System/currentTimeMillis)\\n        leg (fn [label f]\\n              (fn [& args]\\n                (let [t0 (System/currentTimeMillis)\\n                      before @steps\\n                      r (apply f args)]\\n                  (println :LEG label\\n                           {:wall-ms (- (System/currentTimeMillis) t0)\\n                            :steps (- @steps before)\\n                            :arg0 (bounded-str (first args))})\\n                  (flush)\\n                  r)))\\n        orig-kernel-a (deref #'latte/kernel-a)\\n        orig-kernel-b (deref #'latte/kernel-b)\\n        orig-kernel-compile (deref #'latte/kernel-compile)\\n        orig-kernel-c (deref #'latte/kernel-c)\\n        orig-kernel-row (deref #'latte/kernel-row)\\n        kernel-c* (fn [compiled lane]\\n                    (let [before @steps]\\n                      (println :C-ENTER {:lane lane\\n                                         :at-steps before\\n                                         :total-s (quot (wall-ms-since gate-t0) 1000)})\\n                      (flush)\\n                      (let [t0 (System/currentTimeMillis)\\n                            r (orig-kernel-c compiled lane)]\\n                        (println :C-EXIT {:lane lane\\n                                          :wall-ms (- (System/currentTimeMillis) t0)\\n                                          :steps (- @steps before)\\n                                          :status (:status r)\\n                                          :outcome-tag (-> r :outcome first)})\\n                        (flush)\\n                        r)))\\n        result (atom {:kind :none})\\n        worker (Thread. (fn []\\n                          (try\\n                            ;; test-var output goes to this process's stdout\\n                            ;; on purpose: the gate's own KERNEL-FIXTURE lines\\n                            ;; are the live mid-fixture progress signal.\\n                            (clojure.test/test-var\\n                              #'yang.latte-oracle-test/test-kernel-differential-gate)\\n                            (reset! result {:kind :returned\\n                                            :wall-ms (wall-ms-since gate-t0)})\\n                            (catch Throwable t\\n                              (reset! result {:kind :threw\\n                                              :class (str (class t))\\n                                              :message (ex-message t)\\n                                              :wall-ms (wall-ms-since gate-t0)})))))]\\n    (.setName worker \\\"wedge-worker\\\")\\n    (.setDaemon worker true)\\n    (with-redefs-fn {#'vm/step counted-step\\n                     #'observer/run-on-stream instrumented-run-on-stream\\n                     #'latte/kernel-a (leg :a orig-kernel-a)\\n                     #'latte/kernel-b (leg :b orig-kernel-b)\\n                     #'latte/kernel-compile (leg :compile orig-kernel-compile)\\n                     #'latte/kernel-c kernel-c*\\n                     #'latte/kernel-row (leg :row orig-kernel-row)}\\n      (fn []\\n        (.start worker)\\n        (loop [prev -1 frozen 0]\\n          (Thread/sleep (long tick-ms))\\n          (let [alive (.isAlive worker)\\n                n (when alive (print-tick tick-ms prev))]\\n            (cond\\n              (not alive)\\n              (do (println :GATE-DONE (assoc @result\\n                                             :steps @steps\\n                                             :in-step-ms (quot @in-step-nanos 1000000)\\n                                             :wall-ms (wall-ms-since gate-t0)\\n                                             :runs @run-log))\\n                  (flush)\\n                  (condp = (:kind @result)\\n                    :returned (System/exit 0)\\n                    :threw (System/exit 1)\\n                    (System/exit 4)))\\n\\n              (>= (- (System/currentTimeMillis) gate-t0) (long gate-wall-cap-ms))\\n              (do (dump-state worker :GATE-WALL-CAP-REACHED) (System/exit 2))\\n\\n              (and n (= n prev))\\n              (do (when (>= (inc frozen) gate-frozen-ticks)\\n                    (dump-state worker :GATE-FROZEN-5MIN)\\n                    (System/exit 3))\\n                  (recur (or n prev) (inc frozen)))\\n\\n              :else (recur (or n prev) 0))))))))\\n\\n(deftest test-h31-wedge-probe2-gate\\n  (testing \\\"diagnostic probe only — contributes zero coverage\\\"\\n    (stage-c-gate)\\n    (is true)))\\n\\n;; ---------------------------------------------------------------- stage D\\n\\n;; The in-gate freeze sat in check-assume-have-discharge's WALKER cell: it\\n;; consumed exactly its whole 2,000,000-step budget and then the run never\\n;; returned while no step advanced. Stage D drives that one cell in\\n;; isolation — same driver, same instrumentation — to (a) confirm the\\n;; exhaustion reproduces without the corpus context and (b) capture the\\n;; bounded exhaustion state: the advanced :consumer's halted/blocked flags,\\n;; continuation depth, control, and the top frame.\\n\\n(defn- stage-d-walker\\n  []\\n  (println :STAGE-D :walker-cell-in-isolation\\n           {:driver 'yang.clojure-test/run-guest-machine\\n            :fixture :check-assume-have-discharge\\n            :step-limit 2000000})\\n  (flush)\\n  (reset-instrumentation!)\\n  (let [fixture (first (filter #(= :check-assume-have-discharge (:id %))\\n                               (:fixtures (deref #'latte/kernel-gate-corpus))))\\n        compiled ((deref #'latte/kernel-compile) fixture)\\n        ast (:ast compiled)\\n        modules ((deref #'latte/oracle-registry) yang/kind-module)\\n        result (atom {:kind :none})\\n        worker (Thread. (fn []\\n                          (try\\n                            (let [machine (compiler-test/run-guest-machine\\n                                            ast modules :walker 2000000)]\\n                              (reset! result {:kind :returned\\n                                              :machine (machine-snapshot machine)}))\\n                            (catch Throwable t\\n                              (reset! result\\n                                      {:kind :threw\\n                                       :class (str (class t))\\n                                       :message (ex-message t)\\n                                       :data-keys (vec (keys (ex-data t)))\\n                                       :consumer (machine-snapshot\\n                                                   (:consumer (ex-data t)))\\n                                       :session-consumer (machine-snapshot\\n                                                           (:consumer\\n                                                             (:session (ex-data t))))})))))]\\n    (.setName worker \\\"wedge-worker\\\")\\n    (.setDaemon worker true)\\n    (with-redefs [vm/step counted-step\\n                  observer/run-on-stream instrumented-run-on-stream]\\n      (.start worker)\\n      (loop [prev -1 frozen 0]\\n        (Thread/sleep (long tick-ms))\\n        (let [alive (.isAlive worker)\\n              n (when alive (print-tick tick-ms prev))]\\n          (cond\\n            (not alive)\\n            (do (println :WORKER-DONE (assoc @result\\n                                             :steps @steps\\n                                             :in-step-ms (quot @in-step-nanos 1000000)\\n                                             :loads @load-count\\n                                             :runs @run-log))\\n                (flush)\\n                (condp = (:kind @result)\\n                  :returned (System/exit 0)\\n                  :threw (System/exit 1)\\n                  (System/exit 4)))\\n\\n            (>= (- (System/currentTimeMillis) @start-ms) (long wall-cap-ms))\\n            (do (dump-state worker :RATE-COLLAPSE-WALL-CAP) (System/exit 2))\\n\\n            (and n (= n prev))\\n            (do (when (>= (inc frozen) frozen-ticks)\\n                  (dump-state worker :WEDGE-CONFIRMED-IN-STEP)\\n                  (System/exit 3))\\n                (recur (or n prev) (inc frozen)))\\n\\n            :else (recur (or n prev) 0)))))))\\n\\n(deftest test-h31-wedge-probe2-walker\\n  (testing \\\"diagnostic probe only — contributes zero coverage\\\"\\n    (stage-d-walker)\\n    (is true)))\\n\\n;; ---------------------------------------------------------------- stage F\\n\\n;; The walker cell now exhausts 2M (stage D) while the semantic cell\\n;; completes at 1.1M (stage B). How far over the budget is the walker?\\n;; One bounded diagnostic trial at 8M — the H3-1 round's authorized trial\\n;; ladder — reporting the walker's true completion count, or a second\\n;; exhaustion. Diagnostic configuration only: NOT an acceptance-budget\\n;; proposal.\\n\\n(defn- stage-f-walker-8m\\n  []\\n  (println :STAGE-F :walker-cell-8m-trial\\n           {:driver 'yang.clojure-test/run-guest-machine\\n            :fixture :check-assume-have-discharge\\n            :step-limit 8000000})\\n  (flush)\\n  (reset-instrumentation!)\\n  (let [fixture (first (filter #(= :check-assume-have-discharge (:id %))\\n                               (:fixtures (deref #'latte/kernel-gate-corpus))))\\n        compiled ((deref #'latte/kernel-compile) fixture)\\n        ast (:ast compiled)\\n        modules ((deref #'latte/oracle-registry) yang/kind-module)\\n        result (atom {:kind :none})\\n        worker (Thread. (fn []\\n                          (try\\n                            (let [machine (compiler-test/run-guest-machine\\n                                            ast modules :walker 8000000)]\\n                              (reset! result {:kind :returned\\n                                              :steps @steps\\n                                              :machine (machine-snapshot machine)\\n                                              :value (bounded-str (vm/value machine))}))\\n                            (catch Throwable t\\n                              (reset! result\\n                                      {:kind :threw\\n                                       :class (str (class t))\\n                                       :message (ex-message t)\\n                                       :steps @steps})))))]\\n    (.setName worker \\\"wedge-worker\\\")\\n    (.setDaemon worker true)\\n    (with-redefs [vm/step counted-step\\n                  observer/run-on-stream instrumented-run-on-stream]\\n      (.start worker)\\n      (loop [prev -1 frozen 0]\\n        (Thread/sleep (long tick-ms))\\n        (let [alive (.isAlive worker)\\n              n (when alive (print-tick tick-ms prev))]\\n          (cond\\n            (not alive)\\n            (do (println :WORKER-DONE (assoc @result\\n                                             :in-step-ms (quot @in-step-nanos 1000000)\\n                                             :loads @load-count\\n                                             :runs @run-log))\\n                (flush)\\n                (condp = (:kind @result)\\n                  :returned (System/exit 0)\\n                  :threw (System/exit 1)\\n                  (System/exit 4)))\\n\\n            (>= (- (System/currentTimeMillis) @start-ms) (long wall-cap-ms))\\n            (do (dump-state worker :RATE-COLLAPSE-WALL-CAP) (System/exit 2))\\n\\n            (and n (= n prev))\\n            (do (when (>= (inc frozen) frozen-ticks)\\n                  (dump-state worker :WEDGE-CONFIRMED-IN-STEP)\\n                  (System/exit 3))\\n                (recur (or n prev) (inc frozen)))\\n\\n            :else (recur (or n prev) 0)))))))\\n\\n(deftest test-h31-wedge-probe2-walker-8m\\n  (testing \\\"diagnostic probe only — contributes zero coverage\\\"\\n    (stage-f-walker-8m)\\n    (is true)))\\n(ns d2-wedge-min-repro\\n  \\\"The minimized reproduction of the H3-1 'wedge' — which is a false\\n  negative, not a cycle.\\n\\n  What round 1 measured as 'the evaluator session terminates': a probe that\\n  built `semantic/create-vm` + `tu/make-observer-session` and called\\n  `observer/run-on-stream` — but never appended the fixture to the session\\n  medium (no `tu/queue-rows!`). An observer session over an empty medium\\n  loads nothing and runs nothing, and a fresh SemanticVM is `:halted? true`\\n  before any program (yin.vm.semantic/create-vm mints `:halted? true`), so\\n  the probe read 'halted, zero budget spent' off a machine that never\\n  executed an instruction.\\n\\n  This file is the A/B/C pair that isolates it, each arm runnable alone:\\n\\n    arm A  reproduces round 1's drive exactly — 0 steps, halted=true,\\n           the false negative in three lines\\n    arm B  adds the ONE missing line (tu/queue-rows!) and drives the same\\n           D2-compiled fixture through the same evaluator session: it\\n           completes under the 2M budget with the correct outcome —\\n           there is no non-terminating cycle in the evaluator session,\\n           the observer coordination, or any encoder layer\\n    arm C  shrinks the budget to 10000 steps and shows run-bounded's\\n           exhaustion throw PROPAGATES out of observer/run-on-stream\\n           (carry-session rethrows; it never feeds the loop), carrying\\n           the advanced machine under :consumer and the partial session\\n           under :session — the opt-in recovery data, not a retry cycle.\\n\\n  The kernel-c semantic path (`run-guest-machine`) has no encoder session\\n  in it at any commit: it is tu/make-observer-session + tu/queue-rows! +\\n  observer/run-on-stream, single stage. The two C lanes differ only in\\n  machine construction and loader.\\\"\\n  (:require [clojure.test :refer [deftest is testing]]\\n            [dao.stream.observer :as observer]\\n            [yang.clojure :as yang]\\n            [yang.clojure-test :as compiler-test]\\n            [yang.latte-oracle-test :as latte]\\n            [yin.vm :as vm]\\n            [yin.vm.engine :as engine]\\n            [yin.vm.semantic :as semantic]\\n            [yin.vm.semantic.linearize :as linearize]\\n            [yin.vm.test-utils :as tu]))\\n\\n(def ^:private original-step vm/step)\\n(def steps (atom 0))\\n\\n(defn- counted-step\\n  [machine]\\n  (swap! steps inc)\\n  (original-step machine))\\n\\n(defn- fixture-ast\\n  \\\"The D2-compiled check-assume-have-discharge fixture, as kernel-c sees it.\\\"\\n  []\\n  (let [fixture (first (filter #(= :check-assume-have-discharge (:id %))\\n                               (:fixtures (deref #'latte/kernel-gate-corpus))))\\n        compiled ((deref #'latte/kernel-compile) fixture)]\\n    (when-not (= :compiled (:status compiled))\\n      (throw (ex-info \\\"fixture no longer compiles\\\" {:status (:status compiled)})))\\n    (:ast compiled)))\\n\\n(defn- load-rows\\n  []\\n  (vm/fresh-code-loader\\n    (fn [m rows stamp]\\n      (vm/check-contract! vm/ast-contract stamp)\\n      (semantic/load-vector m\\n                            (:vector (linearize/project-rows rows))\\n                            vm/semantic-contract))\\n    vm/ast-contract))\\n\\n(defn- bounded-run\\n  \\\"run-guest-machine's runner, verbatim.\\\"\\n  [step-limit]\\n  (fn [machine]\\n    (loop [v machine n 0]\\n      (cond\\n        (or (vm/halted? v) (vm/blocked? v)) v\\n        (= n step-limit) (throw (ex-info \\\"Guest instruction budget exhausted\\\"\\n                                         {:lane :semantic :steps n :consumer v}))\\n        :else (recur (vm/step v) (inc n))))))\\n\\n(defn- bounded [x]\\n  (let [s (pr-str x)]\\n    (if (> (count s) 200) (subs s 0 200) s)))\\n\\n(defn- arm-a-round-1-drive\\n  []\\n  (reset! steps 0)\\n  (let [machine (semantic/create-vm {:make-stream tu/make-stream\\n                                     :capability-secret tu/secret\\n                                     :modules (deref #'compiler-test/library-modules)})\\n        session (tu/make-observer-session machine)] ;; medium is EMPTY\\n    (with-redefs [vm/step counted-step]\\n      (let [done (observer/run-on-stream session\\n                                         engine/ready-for-ingress?\\n                                         (load-rows)\\n                                         (bounded-run 2000000))]\\n        {:steps @steps\\n         :halted (vm/halted? (:consumer done))\\n         :blocked (vm/blocked? (:consumer done))\\n         :queue-line :absent}))))\\n\\n(defn- arm-b-true-drive\\n  []\\n  (reset! steps 0)\\n  (let [ast (fixture-ast)\\n        machine (semantic/create-vm {:make-stream tu/make-stream\\n                                     :capability-secret tu/secret\\n                                     :modules ((deref #'latte/oracle-registry) yang/kind-module)})\\n        session (tu/make-observer-session machine)]\\n    (with-redefs [vm/step counted-step]\\n      (let [done (as-> session s\\n                  (tu/queue-rows! s ast) ;; <- the ONE line round 1 omitted\\n                  (observer/run-on-stream s engine/ready-for-ingress?\\n                                          (load-rows) (bounded-run 2000000)))\\n            m (:consumer done)]\\n        {:steps @steps\\n         :halted (vm/halted? m)\\n         :blocked (vm/blocked? m)\\n         :outcome (bounded (vm/value m))}))))\\n\\n(defn- arm-c-exhaustion-propagates\\n  []\\n  (reset! steps 0)\\n  (let [ast (fixture-ast)\\n        machine (semantic/create-vm {:make-stream tu/make-stream\\n                                     :capability-secret tu/secret\\n                                     :modules ((deref #'latte/oracle-registry) yang/kind-module)})\\n        session (tu/queue-rows! (tu/make-observer-session machine) ast)]\\n    (try\\n      (with-redefs [vm/step counted-step]\\n        (observer/run-on-stream session engine/ready-for-ingress?\\n                                (load-rows) (bounded-run 10000))\\n        {:propagated false})\\n      (catch clojure.lang.ExceptionInfo e\\n        (let [d (ex-data e)\\n              consumer (:consumer d)]\\n          {:propagated true\\n           :message (ex-message e)\\n           :data-has-consumer (contains? d :consumer)\\n           :data-has-session (contains? d :session)\\n           :consumer-advanced {:halted (:halted? consumer)\\n                               :blocked (:blocked? consumer)\\n                               :cont-depth (count (:k consumer))\\n                               :control (select-keys (:control consumer) [:segment :pc])}\\n           :cause-preserved (some? (ex-cause e))})))))\\n\\n(defn- arm-d-gate-freeze-mechanism\\n  \\\"What the gate does with the exhaustion throw: kernel-attempt's catch\\n  expands the exception data with `evidence-data` — dissoc'ing :session but\\n  NOT :consumer, which after a full 2M-step run is the entire advanced\\n  machine. This arm reproduces exactly that expansion in isolation, under a\\n  wall bound with a stack dump, so the gate's post-exhaustion freeze is\\n  attributable without running the corpus.\\\"\\n  []\\n  (let [ast (fixture-ast)\\n        modules ((deref #'latte/oracle-registry) yang/kind-module)]\\n    (try\\n      (compiler-test/run-guest-machine ast modules :walker 2000000)\\n      {:exhausted false}\\n      (catch clojure.lang.ExceptionInfo e\\n        (let [data (dissoc (ex-data e) :session)  ;; kernel-attempt's own dissoc\\n              evidence (deref #'latte/evidence-data)\\n              t0 (System/currentTimeMillis)\\n              result (atom {:finished false})\\n              worker (doto (Thread. (fn []\\n                                      (try\\n                                        (let [v (evidence data)]\\n                                          (reset! result\\n                                                  {:finished true\\n                                                   :wall-ms (- (System/currentTimeMillis) t0)\\n                                                   :walked-keys (count v)}))\\n                                        (catch Throwable t\\n                                          (reset! result\\n                                                  {:finished true\\n                                                   :wall-ms (- (System/currentTimeMillis) t0)\\n                                                   :threw (ex-message t)})))))\\n                          (.setName \\\"arm-d-evidence-walk\\\")\\n                          (.setDaemon true))]\\n          (.start worker)\\n          (loop [waited 0]\\n            (Thread/sleep 5000)\\n            (let [r @result]\\n              (cond\\n                (:finished r) r\\n\\n                (>= waited 120000)\\n                (do (println :ARM-D-UNFINISHED-AFTER-MS waited)\\n                    (doseq [frame (take 25 (.getStackTrace worker))]\\n                      (println \\\"  \\\" (str frame)))\\n                    (flush)\\n                    {:finished false :capped-at-ms waited})\\n\\n                :else (recur (+ waited 5000))))))))))\\n\\n(defn- cycle-scan\\n  \\\"Identity-based DFS over the same shapes evidence-data/postwalk traverse\\n  (maps, vectors, seqs, sets, records). Reports unique node count, the\\n  deepest sharing, and — decisively — whether any container re-enters a node\\n  already on the DFS path: that is a true cycle, on which clojure.walk's\\n  postwalk (no seen-set) never terminates. Sharing off the path is normal\\n  persistent-structure DAG sharing and terminates.\\\"\\n  [x]\\n  (let [seen (java.util.IdentityHashMap.)\\n        path (java.util.IdentityHashMap.)\\n        nodes (atom 0)\\n        shared (atom 0)\\n        cycle (atom nil)\\n        container? (fn [v] (or (map? v) (vector? v) (sequential? v) (set? v) (record? v)))\\n        children (fn [v]\\n                   (cond\\n                     (map? v) (concat (keys v) (vals v))\\n                     (record? v) (vals v)\\n                     :else (seq v)))]\\n    (letfn [(go [v depth]\\n              (when (> depth 200000) (throw (ex-info \\\"scan depth cap\\\" {:depth depth})))\\n              (when (container? v)\\n                (when (.containsKey path v)\\n                  (when-not @cycle (reset! cycle {:type (str (class v)) :at-depth depth}))\\n                  nil)\\n                (if (.containsKey seen v)\\n                  (do (swap! shared inc) nil)\\n                  (do (.put seen v true)\\n                      (.put path v true)\\n                      (swap! nodes inc)\\n                      (doseq [c (children v)] (go c (inc depth)))\\n                      (.remove path v)))))]\\n      (try\\n        (go x 0)\\n        (catch Throwable t {:scan-threw (ex-message t)}))\\n      {:unique-containers @nodes\\n       :shared-revisits @shared\\n       :cycle @cycle})))\\n\\n(defn- arm-e-cycle-scan\\n  \\\"Scan the exhausted machine itself (the :consumer from arm D's throw) for\\n  a cycle with the identity DFS above — the difference between an expensive\\n  finite expansion and a non-terminating one.\\\"\\n  []\\n  (let [ast (fixture-ast)\\n        modules ((deref #'latte/oracle-registry) yang/kind-module)]\\n    (try\\n      (compiler-test/run-guest-machine ast modules :walker 2000000)\\n      {:exhausted false}\\n      (catch clojure.lang.ExceptionInfo e\\n        (cycle-scan (:consumer (ex-data e)))))))\\n\\n(defn -main\\n  [& _args]\\n  (println :PIN {:commit \\\"8ea857c1+min-repro\\\" :fixture :check-assume-have-discharge})\\n  (println :ARM-A (arm-a-round-1-drive))\\n  (println :ARM-B (arm-b-true-drive))\\n  (println :ARM-C (arm-c-exhaustion-propagates))\\n  (println :ARM-D (arm-d-gate-freeze-mechanism))\\n  (println :ARM-E (arm-e-cycle-scan))\\n  (flush))\\n\\n(deftest test-h31-wedge-min-repro\\n  (testing \\\"diagnostic reproduction only — contributes zero coverage\\\"\\n    (let [a (arm-a-round-1-drive)\\n          _ (println :ARM-A a)\\n          b (arm-b-true-drive)\\n          _ (println :ARM-B b)\\n          c (arm-c-exhaustion-propagates)\\n          _ (println :ARM-C c)\\n          d (arm-d-gate-freeze-mechanism)\\n          _ (println :ARM-D d)\\n          e (arm-e-cycle-scan)\\n          _ (println :ARM-E e)]\\n      (is (zero? (:steps a)) \\\"arm A reproduces the round-1 false negative: no step ever ran\\\")\\n      (is (and (:halted a) (not (:blocked a)))\\n          \\\"arm A's machine reads halted only because create-vm mints :halted? true\\\")\\n      (is (and (:halted b) (pos? (:steps b)) (< (:steps b) 2000000))\\n          \\\"arm B: the same session with the fixture queued completes under the budget\\\")\\n      (is (and (:propagated c) (:data-has-consumer c) (:data-has-session c))\\n          \\\"arm C: the budget throw escapes run-on-stream carrying its recovery data\\\")\\n      (is (map? d) \\\"arm D reports the post-exhaustion evidence walk's cost shape\\\")\\n      (is (map? e) \\\"arm E reports the exhausted machine's cycle scan\\\")\\n      (flush))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1794250000000-reviewer-d2-authenticity-r2.codex.stdout.log:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'private-body-entered|call-token-packet-forgery|d2.wedge.probe|round.1|retract' test docs BRIEF-wedge.md REVIEW-d2-revise2.diff\\\"\",\"aggregated_output\":\"REVIEW-d2-revise2.diff:76:+(deftest test-common-call-token-packet-forgery-refuses\\nREVIEW-d2-revise2.diff:89:+                                     :private-body-entered)))\\nREVIEW-d2-revise2.diff:97:+                           :private-body-entered)\\nREVIEW-d2-revise2.diff:113:+          (is (not= :private-body-entered result)\\nBRIEF-wedge.md:13:1. `test/d2_wedge_probe.clj` — the diagnostic probe the previous round built (instrumented vm/step, watchdog, the evaluator-session driver that COMPLETES).\\nBRIEF-wedge.md:27:1. Instrument `encoder/forward-on-stream`'s run loop (a probe file, like the existing one — NOT a yin.vm edit) to count: batches observed, runs entered, steps per run, and whether the machine advances between runs. The existing probe pattern (`test/d2_wedge_probe.clj`, instrumented vm/step + watchdog) is your template.\\ndocs/dao.space.stigmergy.md:99:  assert/retract and authorship metadata live (`datom.md`).\\ndocs/dao.space.stigmergy.md:162:the greatest `t` wins, and `dao.datom/retracted?` removes a retracted winner.\\ndocs/dao.space.stigmergy.md:263:post, associative discovery, racing claims, leases, retraction, settle — over the wire,\\ndocs/agy-test.md:41:* **Current Status**: `src/cljc/dao/space/transact.cljc` implements 10 load-bearing functions (`tempid?`, `parse-op`, `map->datoms`, `parse-tx-data`, `lookup-ident-eid`, `effective-ref-attrs-for-tx`, `expand-m-map`, `collect-tempids`, `resolve-tempids`, `apply-tempid-map`, plus the public entry point `prepare-tx`). `test/dao/space/transact_test.cljc` has a **single** `deftest` (`transact-test`) containing 3 `testing` blocks (sequential tempid resolution, cardinality-one retraction, ident-ref resolution) — a weaker test surface than 3 independent `deftest`s, since a failure anywhere in the form only reports as one failing test rather than isolating which scenario broke.\\ndocs/design/dao.space.v0.md:700:;; Retraction is also just an append — a datom with retract metadata (m = :db/retract)\\ndocs/design/dao.space.v0.md:701:(ds/append! log [:db/retract work-id :work/status])\\ndocs/design/dao.space.v0.md:1336:- Retract/update semantics (currently append-only; retractions require new datoms)\\ndocs/ideas/mpi.md:26:- **Reduce / Allreduce = join agent + Datalog.** Distributed gradient aggregation (as in ML training) has gradient result datoms from different nodes written to `dao.space`; a join agent Datalog-queries all gradient results and folds them, and allreduce writes the folded result back as a type others match. This works today for commutative folds (gradient sums) on the joins-only Datalog that is implemented. It depends on two pieces of query machinery that are target surface: *current-state masking* (treating the accreted log, retractions and all, as a clean result) and, for the completeness check that bounds the fold, the membership logic discussed below. See `docs/design/dao.space.md`, \\\"The Query Library,\\\" for the joins-only status.\\ndocs/cesk-space-optimization.md:99:one `assoc-in` per appended datom: no retraction logic, no invalidation.\\ndocs/agents/advanced-concepts.md:35:  its retraction hash alike. (a v m) keeps them apart but needs m resolved to the\\ndocs/design/yang.php.md:2600:\\\"`__destruct` never called\\\" (round 1; now supported for acyclic garbage);\\ndocs/design/yang.php.md:2601:static initializers evaluated at definition (round 1); `PHP_INT_MIN % -1`\\ndocs/design/yang.php.md:2602:throwing (round 1); the `0 == \\\"\\\" == []` grouping (round 1); the `:refs` set on\\ndocs/datomic.md:765:- `:tx-data` — List of datoms asserted/retracted by transaction\\ndocs/datomic.md:788:| `isHistory()` | `boolean` | True if this is a history database (includes retractions) |\\ndocs/datomic.md:821:| `history()` | `Database` | View full history (includes retractions) |\\ndocs/datomic.md:876:| `added()` | `boolean` | True if assertion, false if retraction |\\ntest/d2_wedge_probe2.clj:1:(ns d2-wedge-probe2\\ntest/d2_wedge_probe2.clj:4:  Round 1's probe (test/d2_wedge_probe.clj) never queued the fixture onto\\ntest/d2_wedge_probe2.clj:166:  \\\"Reproduce round 1's evaluator-session drive exactly — including its\\ntest/d2_wedge_probe2.clj:169:  (println :STAGE-A :round-1-probe-reproduction\\ntest/d2_wedge_probe2.clj:170:           {:medium :empty-at-start :queue :absent-as-in-round-1})\\ntest/d2_wedge_probe2.clj:175:        ;; round 1 compiled the fixture and never used the result; the call\\ntest/d2_wedge_min_repro.clj:5:  What round 1 measured as 'the evaluator session terminates': a probe that\\ntest/d2_wedge_min_repro.clj:16:    arm A  reproduces round 1's drive exactly — 0 steps, halted=true,\\ntest/d2_wedge_min_repro.clj:87:(defn- arm-a-round-1-drive\\ntest/d2_wedge_min_repro.clj:114:                  (tu/queue-rows! s ast) ;; <- the ONE line round 1 omitted\\ntest/d2_wedge_min_repro.clj:252:  (println :ARM-A (arm-a-round-1-drive))\\ntest/d2_wedge_min_repro.clj:261:    (let [a (arm-a-round-1-drive)\\ntest/d2_wedge_min_repro.clj:271:      (is (zero? (:steps a)) \\\"arm A reproduces the round-1 false negative: no step ever ran\\\")\\ndocs/design/dao.agent.mcp.server.md:252:  `:db/id`, a `[:db/add e a v]`, or a `[:db/retract e a]` /\\ndocs/design/dao.agent.mcp.server.md:253:  `[:db/retract e a v]`. Raw five-slot datoms are refused: `t` is the\\ndocs/orchestrator-log.md:118:  the other's round 1 and both closing summaries assert disagreements their\\ndocs/orchestrator-l