\\n        \\\"a program definition shadows the library's\\\")))\\n\\n\\n(deftest test-library-kind-predicates\\n  (testing \\\"collection predicates are derived from the data module's refusals\\\"\\n    (is (= [true false false false false false]\\n           (lib '[(vector? [1]) (vector? '(1)) (vector? {}) (vector? #{}) (vector? 1) (vector? nil)])))\\n    (is (= [true false false false false]\\n           (lib '[(map? {}) (map? [1]) (map? #{}) (map? nil) (map? \\\"s\\\")])))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1793294621496-compiler-engineer-hardening2.gpt-6.1-sol.stdout.log:174:{\"type\":\"item.started\",\"item\":{\"id\":\"item_90\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\np='test/yang/latte_oracle_test.clj';s=open(p).read();s=s.replace('''    (println \\\\\\\"KERNEL-GATE\\\\\\\"''','''    (is (= (:function-arity-candidates evidence)\\n           (+ (:admitted-function-arity-count evidence) (:excluded-function-arity-count evidence)))\\n        \\\\\\\"Admitted and excluded arities partition the candidate inventory\\\\\\\")\\n    (is (every? #(every? true? (vals (:agreement %)))\\n                (filter #(= :pass (:status %)) (:fixtures evidence)))\\n        \\\\\\\"Every passing fixture records independent A/B/C agreement\\\\\\\")\\n    (println \\\\\\\"KERNEL-GATE\\\\\\\"''');s=s.replace('''  (is (= [:yin.k/ok false]\\n         (run-outcome [] '(var? 5) (oracle-registry yang/kind-module) true))))''','''  (is (= [:yin.k/ok false]\\n         (run-outcome [] '(var? 5) (oracle-registry yang/kind-module) true)))\\n  (is ((get yang/kind-module 'var?) #'clojure.core/map)))''');open(p,'w').write(s)\\nPY\\n/Users/sto/.local/share/mise/installs/cljstyle/0.17.642/cljstyle fix test/yang/latte_oracle_test.clj\\nJAVA_HOME=/Users/sto/.local/share/mise/installs/java/temurin-21.0.12+101.0.LTS PATH=/Users/sto/.local/share/mise/installs/java/temurin-21.0.12+101.0.LTS/bin:\\\"'$PATH clj -M:test -n yang.latte-