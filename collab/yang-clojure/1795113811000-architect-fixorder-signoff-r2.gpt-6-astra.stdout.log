\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-leaf-diff.edn\ncollab/yang-clojure/1794932555000-engineer-cc4-fourhost-equality.prompt.md\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-dart-focused.log\ncollab/yang-clojure/1795017757000-architect-cc4-dart-map-order-ruling.prompt.md\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-dart.log\ncollab/yang-clojure/1795017484194-engineer-cc4-r2-findings.md\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-kondo-final.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-pin-red.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-pin-red2.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-pin-red3.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-jvm-capture.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-pin-green2.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-jolt-baseline-manifest.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-jvm-final-focused.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/j2-baseline-check.clj\ncollab/yang-clojure/1795109958000-reviewer-fixorder-r3.prompt.md\ncollab/yang-clojure/1795113811000-architect-fixorder-signoff-r2.prompt.md\ncollab/yang-clojure/1795101450000-architect-fixorder-signoff.gpt-6-astra.stdout.log\ncollab/yang-clojure/1795017275897-cc4-r2-evidence/cc4-r2-common-operands.edn\n","exit_code":0,"status":"completed"}}
