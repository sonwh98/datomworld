rior (get (:index st) (first row))]\n  1060\t              (cond (nil? prior) (assoc-in st [:index (first row)] row)\n  1061\t                    (same-value? prior row) st\n  1062\t                    :else (reduced (assoc st ::conflict (first row))))))\n  1063\t          st\n  1064\t          rows))\n  1065\t\n  1066\t\n  1067\t(declare expand-node)\n  1068\t\n  1069\t\n  1070\t(defn- expand-call\n  1071\t  \"One recognized call: allocate an attempt, begin its event before any\n  1072\t   guard or invocation, run the transformer on the operand packets, validate\n  1073\t   and merge the result, finish the event, and reconsider the result at the\n  1074\t   same occurrence with depth + 1.\"\n  1075\t  [st address entry {:keys [path rel frame shadow depth origin-of]}]\n  1076\t  (let [[st counter] (allocate-attempt st)\n  1077\t        ctx (:ctx st)\n  1078\t        macro-root (first (:yin.macro/tree entry))\n  1079\t        ;; every output row whose content address is one of the input's\n  1080\t        ;; own rows is the admitted syntax retained — a no-op expansion\n  1081\t        ;; or an operand passed through — and keeps ITS OWN incoming\n  1082\t        ;; provenance (§2.1): the origin the enclosing walk's\n  1083\t        ;; `origin-of` already answers for that address, which need not\n  1084\t        ;; be the replaced application's origin (an operand packet may\n  1085\t        ;; carry syntax of mixed origin); rows the expansion itself\n  1086\t        ;; generated take the event's origin below\n  1087\t        input-addrs (into #{address}\n  1088\t                          (map first)\n  1089\t                          (second (packet-of (:index st) address)))\n  1090\t        begin (fn [output error]\n  1091\t                (event-row (attempt-id ctx counter)\n  1092\t                           (:source-batch st)\n  1093\t                           (when-not (:parent frame)\n  1094\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\n  1095\t                           (:parent frame)\n  1096\t                           (:root frame)\n  1097\t                           rel\n  1098\t                           macro-root\n  1099\t                           output\n  1100\t                           error))\n  1101\t        failed (fn [st error]\n  1102\t                 (-> st (record-event (begin nil error)) (fail error)))\n  1103\t        guards (:guards ctx)]\n  1104\t    (if (>= depth (:max-depth guards))\n  1105\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\n  1106\t      (let [row (get (:index st) address)\n  1107\t            operands (mapv #(packet-of (:index st) %) (nth row 3))\n  1108\t            {:keys [tree error]} (invoke* entry operands ctx counter)\n  1109\t            invalid (fn [reason]\n  1110\t                      {:kind :invalid-output, :macro macro-root, :path path,\n  1111\t                       :reason reason})]\n  1112\t        (if error\n  1113\t          [(failed st error) address]\n  1114\t          (if-let [e (valid-tree? tree {:working? true})]\n  1115\t            [(failed st (invalid (:reason e))) address]\n  1116\t            (let [n (count (set (map first (second tree))))]\n  1117\t              (if (> n (:max-rows-per-expansion guards))\n  1118\t                [(failed st {:kind :row-guard, :scope :expansion, :rows n}) address]\n  1119\t                (let [st' (merge-output st tree)]\n  1120\t                  (if (::conflict st')\n  1121\t                    [(failed st (invalid :address-conflict)) address]\n  1122\t                    (if-let [e (guard-batch-rows st')]\n  1123\t                      [(failed st' e) address]\n  1124\t                      (let [out (first tree)\n  1125\t                            ev (begin out nil)\n  1126\t                            st' (-> st'\n  1127\t                                    (record-event ev)\n  1128\t                                    (update :produced\n  1129\t                                            (fn [p]\n  1130\t                                              (if (some #(= out (first %)) p)\n  1131\t                                                p\n  1132\t                                                (conj p (packet-of (:index st') out))))))]\n  1133\t                        (expand-node st' out\n  1134\t                                     {:path path,\n  1135\t                                      :rel [],\n  1136\t                                      :frame {:parent (first ev), :root out},\n  1137\t                                      :shadow shadow,\n  1138\t                                      :depth (inc depth),\n  1139\t                                      :origin-of\n  1140\t                                      (fn [a]\n  1141\t                                        (if (contains? input-addrs a)\n  1142\t                                          ;; retained syntax keeps its\n  1143\t                                          ;; own incoming provenance\n  1144\t                                          ;; (§2.1), never the replaced\n  1145\t                                          ;; call's origin\n  1146\t                                          (origin-of a)\n  1147\t                                          ;; the recorded expansion event\n  1148\t                                          ;; row is the real expansion\n  1149\t                                          ;; record (§8); its content\n  1150\t                                          ;; address is the expansion\n  1151\t                                          ;; origin (§2.1)\n  1152\t                                          [:expansion (first ev)]))})))))))))))))\n  1153\t\n  1154\t\n  1155\t(defn- expand-children\n  1156\t  \"Expand `row`'s children in order `places` under per-child shadows;\n  1157\t   `[st address']`, rebuilding the row when any child changed.\"\n  1158\t  [st row places shadow-of {:keys [path rel] :as lo