et\n  1230\t  [st]\n  1231\t  [:yin.macro/log (:events st) (:produced st)])\n  1232\t\n  1233\t\n  1234\t(defn- with-default-guards\n  1235\t  [ctx]\n  1236\t  (update ctx :guards #(merge default-guards %)))\n  1237\t\n  1238\t\n  1239\t(defn- batch-call-site-claims\n  1240\t  \"The per-member call-site (C1) claim verdicts the encoder recorded on\n  1241\t   `batch`: nil when no member claimed coverage, otherwise one boolean\n  1242\t   per member — the encoder validated every member's markers against\n  1243\t   its own tree at the boundary, so a member whose markers do not\n  1244\t   exactly cover it was refused there, never delivered here. Each\n  1245\t   member's own verdict decides its metadata: only a member that\n  1246\t   claimed coverage finalizes a side table, whatever its siblings\n  1247\t   claimed.\"\n  1248\t  [batch]\n  1249\t  (nth batch 5 nil))\n  1250\t\n  1251\t\n  1252\t(defn- final-call-site-metadata\n  1253\t  \"The call-site occurrence contract's (C1) side table of an expanded\n  1254\t   final tree, as frontend-metadata rows `[origin root path\n  1255\t   :yang/call-site 1]` in printed-row order: one row per\n  1256\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\n  1257\t   that actually executes. The frontend's own markers named the\n  1258\t   pre-expansion tree; expansion, tail marking and stand-in lowering\n  1259\t   recompute roots and paths, so no pre-expansion table can cover this\n  1260\t   tree and the table is finalized here, over the finished rows.\n  1261\t\n  1262\t   Each row's origin is that occurrence's REAL origin (design §2.1,\n  1263\t   §2.3): `occurrence-origins` maps the final occurrence path to the\n  1264\t   origin of the admission or generation event that produced the\n  1265\t   application syntax at that path — the admitted run member's source\n  1266\t   origin for retained syntax (a no-op expansion keeps it valid), and\n  1267\t   the `[:expansion record-address]` of the recorded expansion event\n  1268\t   whose output introduced generated syntax. No expansion-record\n  1269\t   address is fabricated: only event rows the expander actually\n  1270\t   recorded appear. The table is therefore the explicit\n  1271\t   final-root correspondence §2.3 requires — every generated occurrence\n  1272\t   names its producing record, so an attribution consumer can reach the\n  1273\t   event (its input root, call path, macro root, output root) from the\n  1274\t   row alone.\"\n  1275\t  [row-set occurrence-origins admission-origin]\n  1340\t            ;; only the run tree is expanded, so only its declarations are\n  1341\t            ;; replaced; every catalogue entry still resolves by index\n  1342\t            [index standins]\n  1343\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1344\t                      (if (= run-index (first source))\n  1345\t                        (let [[index s] (intern-body index [standin-tag name k])]\n  1346\t                          [index (assoc acc (second source) s)])\n  1347\t                        [index acc]))\n  1348\t                    [index {}]\n  1349\t                    (map-indexed vector catalogue))\n  1350\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n  1351\t            st (assoc base :index index :store store)]\n  1352\t        (if-let [e (guard-batch-rows st)]\n  1353\t          (finish (fail st e))\n  1354\t          (let [[st root'] (expand-node st root\n  1355\t                                        {:path [], :rel [],\n  1356\t                                         :frame {:parent nil, :root root,\n  1357\t                                                 :tree-index run-index},\n  1358\t                                         :shadow #{}, :depth 0,\n  1359\t                                         ;; every syntax of the admitted\n  1360\t                                         ;; run tree starts as source\n  1361\t              