{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'file.*(store|reopen)|reopen|create.*file|store/open|open-store' test/yang/clojure_callsite_test.cljc src/cljc/yin/repl/store.cljc | tail -70\"","aggregated_output":"src/cljc/yin/repl/store.cljc:41:  \"The `--index-store` scheme prefix naming a durable file store.\"\nsrc/cljc/yin/repl/store.cljc:111:   nil means the `mem` default, `:mem` names it, and a file store is the\nsrc/cljc/yin/repl/store.cljc:143:   durable directory store at `dir` (dao.space.store/open): exclusive,\ntest/yang/clojure_callsite_test.cljc:2143:     ;; exception/recovery path and stay retrievable after reopening.\ntest/yang/clojure_callsite_test.cljc:2178:             (let [reopened (yin.repl.store/open {:type :file :dir dir})\ntest/yang/clojure_callsite_test.cljc:2180:                           reopened handle)]\ntest/yang/clojure_callsite_test.cljc:2182:                   \"the throwing round's handle retrieves after reopening\")\ntest/yang/clojure_callsite_test.cljc:2183:               (yin.repl.store/close! reopened))))\ntest/yang/clojure_callsite_test.cljc:2194:     ;; after reopening.\ntest/yang/clojure_callsite_test.cljc:2235:             (let [reopened (yin.repl.store/open {:type :file :dir dir})\ntest/yang/clojure_callsite_test.cljc:2237:                           reopened handle)]\ntest/yang/clojure_callsite_test.cljc:2239:                   \"the resume-failing round's handle retrieves after reopening\")\ntest/yang/clojure_callsite_test.cljc:2240:               (yin.repl.store/close! reopened))))\ntest/yang/clojure_callsite_test.cljc:2249:     ;; freshly reopened store by that handle alone.\ntest/yang/clojure_callsite_test.cljc:2276:             (let [reopened (yin.repl.store/open {:type :file :dir dir})\ntest/yang/clojure_callsite_test.cljc:2277:                   after (repl/retained-packet-call-provenance reopened handle)]\ntest/yang/clojure_callsite_test.cljc:2279:                   \"retrieval after reopening the store answers the same relation\")\ntest/yang/clojure_callsite_test.cljc:2280:               (yin.repl.store/close! reopened))))\n","exit_code":0,"status":"completed"}}
