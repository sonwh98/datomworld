        program (edn/read-string (:program-edn retained))\n+                    opts (:options retained)\n+                    replayed (yang/compile-program program true opts)\n+                    replay-tree (vm/ast->semantic-bytecode replayed)]\n+                (is (= input retained))\n+                (is (cbor/content= (:program input) program))\n+                (is (= (:root tree)\n+                       (:root (vm/ast->semantic-bytecode\n+                                (yang/compile-program (:program input) true (:options input)))))\n+                    \"original in-memory input replays to the same root\")\n+                (is (= origin (:admission-origin retained)))\n+                (is (= (:root tree) (:root replay-tree)))\n+                (is (= (subvec (get-in tree [:rows (:root tree)]) 1)\n+                       (jing/get reopened (:root addresses) ::missing)))\n+                (is (= rows (jing/get reopened (:metadata addresses) ::missing))))\n+              (finally (file-store/close! reopened))))\n+          (finally\n+            (let [f (io/file dir)]\n+              (when (.exists f)\n+                (run! #(.delete %) (reverse (file-seq f)))))))))))\ne435ac4072ba0a3c278fbe91918d22184b43f0a8d6c1e397c09f68dd629beb75  test/yang/latte_oracle/slice9_site_tables.edn\n","exit_code":0,"status":"completed"}}
