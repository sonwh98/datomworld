{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"sed -n '980,1070p' test/yang/clojure_callsite_test.cljc; head -150 src/cljc/yin/repl/store.cljc\"","aggregated_output":"                       {:yin.link.publish/admission \"pinned-admission\"})]\n          (is (some? (:address pinned)))\n          (is (= [:source :yin.vm.linker.publish/publish\n                  \"pinned-admission\" 0]\n                 (get-in pinned [:call-sites :origin]))\n              \"the pinned token is the admission identity, persisted in\n               the record and retrieved from it\")\n          (is (= [:source :yin.vm.linker.publish/publish\n                  \"pinned-admission\" 0]\n                 (:origin (publish/published-call-site-table\n                            store pinned))))))))\n  (testing \"an unannotated module publishes no table and claims none\"\n    (let [store (mem/create-content-mem)\n          plain (publish/publish-module!\n                  store {:name 'plain\n                         :ast {:type :application\n                               :operator {:type :variable :name 'yin/def}\n                               :operands [{:type :literal :value 'f}\n                                          {:type :literal :value 42}]}\n                         :exports #{'f} :requires {} :primitives {}})]\n      (is (some? (:address plain)))\n      (is (not (contains? plain :call-sites)))\n      (is (nil? (publish/published-call-site-table store plain)))))\n  (testing \"the manifest excludes the side table; the record names the manifest\"\n    (let [store (mem/create-content-mem)\n          result (publish/publish-module!\n                   store (clj-prelude/module-spec\n                           publish-registry\n                           (:address (publish/publish-module!\n                                       store\n                                       (call/module-spec publish-registry)))))\n          address (:address result)\n          manifest (jing/get store address nil)\n          record-address (get-in result [:call-sites :record])\n          record (jing/get store record-address nil)]\n      (is (not (contains? manifest :yin.module/call-sites))\n          \"the hashed manifest keeps the closed schema-1 key set\")\n      (is (every? jing/segment-address?\n                  ((juxt :table :record) (:call-sites result))))\n      (is (= address (:yang.call-site/manifest record))\n          \"the publication record names the manifest\")\n      (is (= address (get-in result [:call-sites :manifest])))\n      (is (= (:yin.module/tree manifest) (:yang.call-site/root record)))\n      (is (some? (jing/get store (get-in result [:call-sites :table]) nil)))\n      (is (some? record))\n      (is (some? (publish/published-call-site-table store record-address))\n          \"the record address alone retrieves the table\")\n      (is (nil? (publish/published-call-site-table\n                  store (:yin.module/tree manifest) record-address))\n          \"a record held to a manifest it does not name does not verify\")\n      ;; transfer: fetch exactly the closure the walk answers missing, as\n      ;; a dao.space.dht load does, into a fresh store; the side table\n      ;; travels only when its record and table are carried explicitly,\n      ;; since the closure no longer follows them\n      (let [fresh (mem/create-content-mem)]\n        (loop [n 0]\n          (let [w (closure/walk fresh address)]\n            (if (= :missing (:yin.link.closure/outcome w))\n              (do (jing/materialize!\n                    fresh (jing/get store (:address w) ::absent))\n                  (recur (inc n)))\n              (do (is (= :complete (:yin.link.closure/outcome w)))\n                  (is (pos? n) \"the walk fetched the module's blobs\")\n                  (is (nil? (publish/published-call-site-table\n                              fresh record-address))\n                      \"the closure alone does not carry the side table\")\n                  (jing/materialize!\n                    fresh (jing/get store (get-in result [:call-sites :table])\n                                    ::absent))\n                  (jing/materialize! fresh (jing/get store record-address\n                                                     ::absent))\n                  (let [{:keys [tree origin rows]}\n                        (publish/published-call-site-table fresh record-address)]\n                    (is (some? rows)\n                        \"the side table is retrievable once carried\")\n                    (is (= (:rows (publish/published-call-site-table\n                                    store result))\n                           rows))\n                    (is (= (eligible-under tree origin) (marked rows)))\n                    (is (true? (yang/validate-call-site-coverage!\n                                 tree rows origin {:declared? true})))))))))))\n  (testing \"a version-2 table is a claim rejection, not a silent nil\"\n    (let [store (mem/create-content-mem)\n          bump (fn bump\n                 [node]\n                 (if (and (map? node) (= 1 (:yang/call-site node)))\n                   (assoc node :yang/call-site 2)\n                   node))\n          ast (clojure.walk/postwalk bump\n                                     (yang/compile-program '[(defn f\n                                                               [x]\n(ns yin.repl.store\n  \"Startup selection of the code index's store\n   (docs/design/yin.repl.dao.space-index.md; the durable-store startup\n   contract, slices 1-3).\n\n   The store is chosen once, before the shell composes: `mem` — a fresh\n   in-memory `dao.jing` store, today's behaviour — or `file:<dir>`, the\n   durable directory store (dao.space.store).  This namespace parses the\n   `--index-store` value, validates the `:index-store-spec` an embedder\n   may hand `yin.repl/create-state`, and opens the store the resolved\n   spec names.  Every bad spec — a missing value, an unknown scheme, an\n   empty directory, a directory that cannot be opened, a host build\n   without file support — is refused with its reason; nothing falls back\n   to memory silently.\n\n   What it answers is a generic `dao.jing` content handle and nothing\n   more: no transport state, no node, no storage implementation the\n   engine could reach through it.  A storage implementation past `:mem`\n   and `{:type :file :dir dir}` is a composition's, never this\n   namespace's (docs/design/yin.repl.dht-composition.md sections 2, 3 and\n   6).  Such a composition opens its own store and hands the engine the\n   prepared handle as `:index-store`; it may also register its own\n   `--index-store` scheme here, as plain data (`parse-arg`'s second\n   argument), so the engine's parser knows a prefix and a label and never\n   a backend.\n\n   The durable directory itself — the exclusive lock, HEAD, the validated\n   snapshot, `:recovery` — is dao.space.store's; this namespace is one of\n   its consumers.  The shell installs the recovery before it admits any\n   evaluation (`yin.repl.index/rehydrate`), and a store whose index\n   outlives the process also carries it across `(reset)` and VM\n   selection; the memory store keeps today's empty rebuild.  That\n   retention is a declared policy, not something the engine derives from\n   a backend's own state (`retain-on-reset?`).\"\n  (:require [clojure.string :as str]\n            [dao.jing.mem :as jing.mem]\n            [dao.space.store :as durable]))\n\n\n(def file-scheme\n  \"The `--index-store` scheme prefix naming a durable file store.\"\n  \"file:\")\n\n\n(defn- supported-text\n  \"The supported `--index-store` forms as one comma-separated string:\n   this namespace's own, then every registered scheme's label in order.\"\n  [extra-schemes]\n  (str/join \", \"\n            (into [\"mem\" (str file-scheme \"<dir>\")]\n                  (map :label)\n                  extra-schemes)))\n\n\n(defn parse-arg\n  \"The `--index-store` value as a spec: `:mem`, or `{:type :file :dir dir}`\n   for `file:<dir>`.  A missing value, an unknown scheme, and an empty\n   directory are refused here — with the supported forms named — so the\n   arguments parser can refuse a bad flag before anything composes.\n\n   `extra-schemes` registers the schemes a storage composition adds, each\n   `{:prefix \\\"<scheme>:\\\" :label \\\"<as documented>\\\" :parse (fn [dir]\n   spec)}`.  They are plain data: this namespace matches a prefix and\n   calls `:parse` with the directory, and never learns what the answer\n   means.  A composition's own checked spec then validates it\n   (`checked-spec` refuses a type it does not know, so a registered\n   scheme whose spec reaches the engine unchecked is still refused).\"\n  ([value] (parse-arg value nil))\n  ([value extra-schemes]\n   (let [supported (supported-text extra-schemes)\n         extra (when (string? value)\n                 (some (fn [{:keys [prefix parse]}]\n                         (when (str/starts-with? value prefix)\n                           (let [dir (subs value (count prefix))]\n                             (if (str/blank? dir)\n                               (throw (ex-info (str \"--index-store \" prefix\n                                                    \"<dir> needs a directory\")\n                                               {:value value\n                                                :supported supported}))\n                               (parse dir)))))\n                       extra-schemes))]\n     (cond\n       (nil? value)\n       (throw (ex-info (str \"--index-store needs a value: \" supported)\n                       {:value value\n                        :supported supported}))\n\n       (some? extra)\n       extra\n\n       (= value \"mem\")\n       :mem\n\n       (str/starts-with? value file-scheme)\n       (let [dir (subs value (count file-scheme))]\n         (if (str/blank? dir)\n           (throw (ex-info \"--index-store file:<dir> needs a directory\"\n                           {:value value\n                            :supported supported}))\n           {:type :file :dir dir}))\n\n       :else\n       (throw (ex-info (str \"Unknown --index-store \" (pr-str value)\n                            \"; supported: \" supported)\n                       {:value value\n                        :supported supported}))))))\n\n\n(defn checked-spec\n  \"Validate an `:index-store-spec` as `yin.repl/create-state` receives it:\n   nil means the `mem` default, `:mem` names it, and a file store is the\n   map `{:type :file :dir dir}` with a non-empty directory string.\n   Anything else is refused with the supported forms named.\n\n   A spec of a type this namespace does not know is refused here rather\n   than opened: a storage composition checks its own spec, and reaches\n   the engine as a prepared `:index-store` handle, so `create-state`\n   never resolves a scheme past the two above\n   (docs/design/yin.repl.dht-composition.md sections 2 and 6).\"\n  [spec]\n  (cond\n    (nil? spec) :mem\n    (= :mem spec) :mem\n    (and (map? spec)\n         (= :file (:type spec))\n         (string? (:dir spec))\n         (not (str/blank? (:dir spec))))\n    spec\n\n    :else\n    (throw (ex-info (str \"Unknown :index-store-spec \" (pr-str spec)\n                         \"; supported: :mem, {:type :file :dir <dir>}. \"\n                         \"A store of any other type is opened by its own \"\n                         \"composition, which injects the prepared handle \"\n                         \"as :index-store\")\n                    {:spec spec\n                     :supported [:mem {:type :file :dir \"<dir>\"}]}))))\n\n\n(defn open\n  \"Open the store `spec` names and keep it plain: `:mem` (or nil) is a\n   fresh in-memory `dao.jing` store; `{:type :file :dir dir}` is the\n   durable directory store at `dir` (dao.space.store/open): exclusive,\n   validating, its HEAD writer, recovery and lock on the handle.  A spec\n   this build cannot open is refused with its reason.\n\n   The answer is a generic `dao.jing` content handle: whatever a\n   composition composes over a store of its own crosses to the engine as\n   a prepared `:index-store`, never through here.\"\n  [spec]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"cat collab/yang-clojure/1794422563000-engineer-d1-correspondence-r2.gpt-6.1-terra.findings.md | tail -28; sed -n '1420,1455p' test/yang/latte_oracle_test.clj\"","aggregated_output":"# D1 continuation r2: partial findings\n\nStatus: **incomplete, not verified, not accepted**. This continues `1794670000001-engineer-d1-correspondence-partial.findings.md`, which remains the round-1 record. No companion file, complete recipe/profile, published corpus record, verifier result, tagged run or commit was made. Nothing in this round authorizes reliance. Worktree mirror only; promotion to canonical collab was not performed.\n\n## Inventory refresh and decisions\n\n- At dispatch the worktree was `d1-correspondence` @ `56cc5ca36855c0d047c11b7658e79cfc27d238e6`, with the round-1 files untracked. Changed contracts are confined to the new experimental `yang.correspondence` API; no existing serialized contract was changed. The v1 site table remains byte-identical (SHA-256 `e435ac4072ba0a3c278fbe91918d22184b43f0a8d6c1e397c09f68dd629beb75`). Inspection found 155 fixtures and 20,805 total fixture-local declarations; all fixture maps have keys `:canonical-source-hash`, `:site-table`, and all site rows have keys `:site`, `:callee`, `:arg-shapes`, `:def`, `:delegation?`. These observations do not substitute for a normative oracle schema validator.\n- Row-lane-only restriction remains D1's decision; no datom bridge is claimed. `collab/exception-track/1794343000000-exception-track-surface-registry.md` has an active ledger, records cc3 landed, and gives the port the `clojure.cljc`/prelude seat; its last visible amendment is older than this base's port and shell merges. It names no active linearizer/derive claim except a conditional fallback, but status in that historical worktree cannot prove no newer external writer. No bridge or forbidden surface was edited.\n- Additional read-only image contracts: `yin.vm.linker/ast-format` (`v3`, rows), `semantic-format` (`v4`), `stack-format` (`b2`), `register-format` (`r2`), `record-format` (derive), and `manifest-format` (schema 1). `yin.vm.linker/verify` checks an individual image's identity and contract; its verifying derivation policy implements `yin.vm.ledger/lowering-profile`, `stack-lowering-profile`, and `register-lowering-profile`. Image storage identity and executable identity are distinct where their format says so. Published C1 and instruction-provenance side records remain outside the manifest. Actual retrieval/verification of each image, derivation and provenance has not been performed here.\n- `yin.vm/materialize-tree!` persists each validated canonical row body separately by its root/row address. `yin.vm.encoder/source-envelope` and `project` supply recorded source-origin coordinates and marker rows; cc3 test's `cc3-oracle-binding` supplies the post-stamp translation. `kernel-compile` records admission coordinates before compilation. Exact retained expansion environment/attempt records and all reconstruction inputs remain unestablished; the recipe must not invent them.\n- Post-port rebind note `1794519755000-engineer-post-port-oracle-reverification.glm-5.3.findings.md` §item 3 was read from canonical collab. It pins Phase 3r `8456c2e9`: two wrapper applications, site extraction `[:operands 1 :operands 1 :value]`, translated wrapped-argument path `[3 1] [3 2]`, and two inserted applications per site. This is not an independent D1 reconstruction.\n- Discovery, index projection/signature, durable retention owner, the complete reachable input closure and full artifact inventory are **not pinned**. The inventory refresh remains incomplete. The shell/refactor, port and frozen-evidence corrections in round 1 still apply.\n\n## Work and limits\n\n- `store-evidence!` materializes the entire version-1 evidence map, and the test fetches the unchanged complete value from Jing and pins the source bytes and `:version`. The test uses an in-memory store; it proves a codec/address round trip, not durable retention after process exit. The outer shape guard is not a complete row-level schema validator.\n- `store-recipe!` and `store-record!` materialize structurally valid values after checking direct address availability, input-role indexes, supported evidence contract, tree-only declaration for empty image/provenance vectors, and a declared root plus unique C1 marker for each claimed binding. They do **not** establish path existence, transitive closure, producer/reconstruction equivalence, derivations, or attribution; a stored value remains a claim. The provisional tree-only coverage map used by the tests is not a completed pinned corpus recipe.\n- `binding-coverage?` compares one compilation's marker set to row-derived application occurrences and checks exact fixture-local site IDs and unique targets. It checks supplied bindings, not how they were produced. A fresh static `:beta-eq-false` compilation reproduced its frozen source hash and table, retained the admission origin, and passed these checks; negative checks reject dropped site IDs, duplicated markers, and an ephemeral origin. This uses cc3's producer binding and cannot serve as independent verification.\n- New code and tests are uncommitted. The round-trip fixture for recipe/record storage is synthetic; there is **no** complete pinned-corpus D1 record or companion, and no claim of a persisted live corpus admission. The existing evidence table predates this run; the pilot does not manufacture an origin for its historical run.\n\n## Validation and unfinished acceptance\n\nRed-first tests: missing evidence-storage function, missing recipe-storage function, missing binding-coverage function, and rejection cases for unsupported evidence/missing tree-only coverage/marker or root were observed red before their fixes. Focused static oracle test passed 1 test / 12 assertions, without running tagged C lanes. Combined `clojure -M:test -n yang.correspondence-test -n yang.clojure-callsite-test` passed 46 tests / 608 assertions, with 0 failures and 0 errors. clj-kondo 2026.08.04 reported 0 errors and 0 warnings across the three code/test files. Full oracle suite was not run.\n\nRemaining: finish the inventory; pin and persist the complete compilation inputs, exact recipe/profile and real admission/expansion records; produce and retain the companion record for the corpus; independently rederive source hash, declarations and stamped-to-unstamped mappings; verify complete C1 and instruction multiplicities and each image under its own execution contract and verifying derivation chain; query both C traces; publish a separate verifier result with verifier revision; measure static pilots and declare all finite D1 ceilings before any tagged verification run. cc3 v2.1 measurements remain historical baselines, not D1 results. No D1 tagged preflight or tagged run has occurred.\n(deftest test-oracle-slice8-upstream-proof-loop\n  (testing \"the original proof loop threads updated contexts across state steps\"\n    (doseq [script ['((:opaque d) (:transparent d) (:opaque d) (:transparent d))\n                    '((:opaque d) (:opaque d))\n                    '((:opaque d) (:transparent d) (:transparent d))]]\n      (let [a (a-opacity-proof script)\n            c (context-bc []\n                          (list 'elab-proof\n                                (list 'register-definition initial-context '(->Definition 'd [] 0 'body #{} 'T {}))\n                                [] (list 'quote script)))]\n        (is (agrees? a c) \"A uses updated Vars; B/C use the returned definition environment\")))))\n\n\n;; =============================================================================\n;; Slice 9: a fail-closed kernel gate. Historical slice tests are not the gate.\n;; =============================================================================\n\n(def ^:private kernel-gate-corpus\n  (edn/read-string (slurp (io/resource \"yang/latte_oracle/kernel_gate.edn\"))))\n\n\n(def ^:private kernel-fixture-closure\n  (edn/read-string (slurp (io/resource \"yang/latte_oracle/fixture_closure.edn\"))))\n\n\n(defn- kernel-symbol\n  [{:keys [ns name]}]\n  (symbol (str/replace (str ns) \"_\" \"-\") (str name)))\n\n\n(defn- kernel-guest-name\n  [s]\n  (symbol (str \"gate-\" (last (str/split (namespace s) #\"\\.\")) \"-\" (name s))))\n\n\n(defn- kernel-arities\n","exit_code":0,"status":"completed"}}
