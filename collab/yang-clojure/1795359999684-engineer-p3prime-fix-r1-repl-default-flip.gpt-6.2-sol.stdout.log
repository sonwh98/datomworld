{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '354,420p' test/yang/python/antlr/descriptor_profile_test.cljc && sed -n '2570,2750p' src/cljc/yang/python/antlr/lower.cljc\"","aggregated_output":"          (str mode \" \" backend)))))\n\n\n(deftest default-selection-and-snapshot-test\n  (let [catalog (frontends/standard)\n        state (repl/create-state {:frontends catalog :lang :yang/python})\n        legacy-catalog (assoc catalog :yang.frontend/preferred [:yang/python \"py-v1\"])\n        legacy (repl/create-state {:frontends legacy-catalog :lang :yang/python})\n        explicit (repl/create-state {:frontends catalog :lang [:yang/python \"py-v1\"]})\n        [advanced result] (repl/eval-input state \"1 == 1.0\")\n        derivation (val (first (:frontend-derivations advanced)))]\n    (is (= [\"clojure-core-v1\" \"py-v1\"] (frontend/revisions catalog :yang/python)))\n    (is (= \"false\" result))\n    (is (= \"True\" (second (repl/eval-input legacy \"1 == 1.0\"))))\n    (is (= \"True\" (second (repl/eval-input explicit \"1 == 1.0\"))))\n    (is (= \"false\" (second (repl/eval-input advanced \"1 == 1.0\"))))\n    (is (= \"clojure-core-v1\" (:yang.frontend/revision derivation)))\n    (is (every? jing/segment-address?\n                (map derivation [:yang.frontend/lowering-profile :yang.frontend/runtime-profile\n                                 :yang.frontend/input :yang.frontend/output\n                                 :yang.frontend/ambient-resolver])))\n    (is (= (get-in @composition [:profiles contract/clojure-id :closure])\n           (:yang.frontend/runtime-closure derivation)))))\n\n(deftest profile-program-root-goldens-test\n  (doseq [[revision source roots]\n          [[contract/clojure-id numeric-source\n            [:segment/blake3-d6d83f256c058f53aaed1dae86f6e16a7d308554ff205331232bee829c7b9632\n             :segment/blake3-85504583b2faeabf1193097aa86d29ffa554c846ad4cf5fdf903c318bed29556]]\n           [contract/clojure-id collections-source\n            [:segment/blake3-23b3da145be32363cb53505e28e059dbd91e0c06a9e753bf025c6bd713c32b38\n             :segment/blake3-79c079fc94a05964de723967abd14ab8de45b0043fc207e3846095866ff88799]]\n           [contract/clojure-id unwind-source\n            [:segment/blake3-c993472e551d5da051ec6a2fccb373953906bf69b111bacca6ac7c9a9496ec40\n             :segment/blake3-51459075501c128d95feef0356e1c9fa6f7a037a629eb42d587a4f1a72bd12a7]]\n           [contract/legacy-id \"print(1 + 2, 1 == 1.0)\"\n            [:segment/blake3-e7c446de2caa4c73b2b7d7c82f1c025ac57885290c65585c13fd542e449a0517\n             :segment/blake3-40df036d1e1f6d2681d451d9c632fa73924c1ff20a0ed46abdaef4f26ded0d59]]]\n          :let [pk (packet source)\n                descriptor (:descriptor (profiles/verify-builtin! revision))]\n          [mode root] (map vector modes roots)]\n    (is (= root (:root (vm/ast->semantic-bytecode\n                         (lower/lower-packet pk {:descriptor descriptor :prelude mode}))))\n        (str revision \" \" mode))))\n\n;; =============================================================================\n;; Packets\n;; =============================================================================\n\n(def ^:private default-max-digits\n  \"The decimal digit budget of a packet that declares none: CPython's\n   `set_int_max_str_digits` default, so the lowering refusal matches the\n   runtime ValueError a guest conversion of the same literal would raise.\"\n  4300)\n\n\n(defn- digit-budget\n  \"The packet's decimal digit budget, `:yang.python.antlr/max-digits`, or\n   `default-max-digits` (4300, CPython's `set_int_max_str_digits`\n   default) when it declares none.\"\n  [packet]\n  (if (contains? packet :yang.python.antlr/max-digits)\n    (let [b (:yang.python.antlr/max-digits packet)]\n      (when-not (and (int? b) (pos? b))\n        (throw (ex-info \"the digit budget must be a positive integer\"\n                        {:yang.python.antlr/max-digits b})))\n      b)\n    default-max-digits))\n\n\n;; A bare expression statement carries one child; an assignment, an augmented\n;; assignment and an annotation carry more.\n(defn- display-statement\n  \"The id of the last top-level bare expression statement of the module,\n   the one a REPL submission displays (Clojure's last expression evaluated;\n   an assignment is a statement and displays nothing), or nil.\"\n  [pk]\n  (let [expr-stmts (for [stmt (p/child-rules pk (p/root pk) \"stmt\")\n                         simple (p/child-rules pk\n                                               (first (p/children pk stmt))\n                                               \"simple_stmt\")\n                         :let [e (first (p/children pk simple))]\n                         :when (and (p/rule? e \"expr_stmt\")\n                                    (= 1 (count (p/children pk e))))]\n                     (:id e))]\n    (last expr-stmts)))\n\n\n(defn- context\n  [packet unit display? descriptor]\n  (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n        analysis (scope/analyze pk)]\n    {:pk pk,\n     :descriptor descriptor,\n     :display-cell (when (and display? (not= contract/legacy-id (:yang.semantics/id descriptor)))\n                     '%display),\n     :display-id (when display? (display-statement pk)),\n     :unit unit,\n     :importlib-bindings (importlib-bindings pk),\n     :lines (newline-lines pk),\n     :max-digits (digit-budget packet),\n     :analysis analysis,\n     :scope (:module analysis),\n     :lower lower,\n     :loop nil,\n     :ret nil,\n     :exc nil,\n     :class nil,\n     :gen nil,\n     :comp nil}))\n\n\n(defn lower-module-body\n  \"The module's statements as one node, before the runtime wrapper: what\n   lowering goldens compare. `unit`, the unit's declared `{:name\n   :package?}`, resolves its relative imports; nil (the default, as for\n   `__main__`) is a packageless unit.\"\n  ([packet] (lower-module-body packet nil))\n  ([packet unit] (lower-module-body packet unit false))\n  ([packet unit display?]\n   (lower-module-body packet unit display? (contract/descriptor contract/legacy-id [])))\n  ([packet unit display? descriptor]\n   (let [ctx (context packet unit display? descriptor)]\n     (lower ctx (p/root (:pk ctx))))))\n\n\n(defn- ambient-resolver [descriptor]\n  (let [name (u/v '%ambient-name)]\n    (u/lam ['%ambient-name]\n           (reduce (fn [fallback [alias projection]]\n                     (u/if-node (app* '= name (u/lit alias))\n                                (app* 'assoc (u/lit {}) (u/lit :value) (projection-value projection))\n                                fallback))\n                   (u/lit {})\n                   (reverse (sort-by key jing/canonical-compare\n                                     (:yang.semantics/ambient-projections descriptor)))))))\n\n\n(defn- entry-program [descriptor body resolver entry-symbol]\n  (let [{:keys [operands call-shapes hook]} (get contract/entry-lowering (:yang.semantics/id descriptor))\n        argc (count operands)]\n    (when-not (contains? call-shapes argc)\n      (throw (ex-info \"Python entry shape refused\"\n                      {:status :refused :reason :yang.semantics/invalid-descriptor\n                       :call-shape argc})))\n    (apply app* (or entry-symbol (get-in descriptor [:yang.semantics/hooks hook]))\n           (map (fn [operand]\n                  (case operand\n                    :body-fn (u/lam [globals-sym globals-fn-sym] body)\n                    :ambient-resolver resolver))\n                operands))))\n\n\n(defn lower-packet\n  \"Lower one ok packet using the selected, admitted `:descriptor`. Bare\n   compiler callers keep the `py-v1` revision. The entry uses that revision's\n   recorded ABI and the packet may set `:yang.python.antlr/max-digits`.\n\n   `:prelude` selects `:bundled` (inline runtime definitions) or `:linked`\n   (dependency-first requires supplied by the composition). The persistent\n   profile returns the last display expression as a guest value.\n\n   Legacy imports deliver through try-require thunks at the executed\n   statement, after checking sys.modules. Only py is eagerly required;\n   an import-free unit's tree is unchanged. The program is __main__, a\n   packageless unit, so its relative imports raise. Imports need the linked\n   prelude -- a module closure's free reads never see the ambient store,\n   so a bundled importer's `py/*` definitions are invisible to an\n   imported body -- and a bundled unit holding any import statement but\n   a plain import of sys, builtins or importlib is refused. Literal\n   import_module calls that deliver guest modules need the linked profile.\"\n  ([packet] (lower-packet packet {}))\n  ([packet {:keys [prelude descriptor session? primed?]\n            :or {prelude :bundled descriptor (contract/descriptor contract/legacy-id [])}}]\n   (let [legacy? (= contract/legacy-id (:yang.semantics/id descriptor))\n         pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n         body (lower-module-body packet nil (not legacy?) descriptor)\n         resolver (when-not legacy? (u/mark-tails (ambient-resolver descriptor)))\n         main (entry-program descriptor body resolver\n                             (when (and session? (not legacy?)) 'clj.py/run-session))]\n     (if legacy?\n       (u/mark-tails\n         (case prelude\n           :bundled (if-not (preseeded-imports-only? pk)\n                      (throw (ex-info\n                               \"Imports need the linked prelude (docs/design/yang.antlr.md 8.5.6)\"\n                               {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n                                :construct \"import under the bundled prelude\"}))\n                      (u/then prelude/uast main))\n           :linked (u/seq-nodes\n                     [(app* 'require (u/lit 'yang.call))\n                      (app* 'require (u/lit (:yang.semantics/prelude-module descriptor)))\n                      (app* 'py/init!) main])))\n       (let [program\n             (case prelude\n               :bundled (if primed? (u/annotate-call-sites (u/mark-tails main))\n                            (clj-runtime/bundled main))\n               :linked (u/annotate-call-sites\n                         (u/mark-tails\n                           (u/seq-nodes\n                             (conj (mapv (fn [{:keys [module]}] (core-module/require-node module))\n                                         (:yang.semantics/ambient-modules descriptor))\n                                   main)))))]\n         (vary-meta program assoc :yang.frontend/ambient-resolver\n                    (:root (vm/ast->semantic-bytecode resolver))))))))\n\n\n;; =============================================================================\n;; The module emitter: one Python unit as the linker module pym.<name>\n;; =============================================================================\n\n(def ^:private require-node core-module/require-node)\n\n\n(def module-exports\n  \"The exports of a compiled Python unit: its spec and body, immutable\n   after install (docs/design/yang.antlr.md 8.5.6's module shape).\"\n  '#{spec body})\n\n\n(defn- validate-module-name!\n  [name]\n  (when (or (empty? name)\n            (str/starts-with? name \".\")\n            (str/ends-with? name \".\")\n","exit_code":0,"status":"completed"}}
