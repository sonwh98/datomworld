essage error) (str error))\n          :clj (or (ex-message error) (str error)))))\n\n\n(defn- print-arg\n  [value]\n  (if (string? value) value (format-value value)))\n\n\n(defn- print-text\n  [args]\n  (str/join \" \" (map print-arg args)))\n\n\n(defn- prn-text\n  [args]\n  (str (str/join \" \" (map format-value args)) \"\\n\"))\n\n\n;; =============================================================================\n;; The output medium\n  (try\n    (let [p (first args)]\n      (when-not (and (= 1 (count args)) (string? p)\n                     (str/starts-with? p \"ed25519:\"))\n        (throw (ex-info \"Expected one ed25519:<64 hex> principal id\" {})))\n      (let [p (config/parse-trust p)\n            admission (if (= :external (:admission state))\n                        {} (:admission state))]\n        (if (and (= command 'untrust)\n                 (contains? (:own (:link-source state)) p))\n          [state (str \"Own principal \" p \" is always trusted\")]\n          [(configure-admission\n             state (update admission :trusted\n                           (fn [trusted]\n                             ((if (= command 'trust) conj disj)\n                              (set trusted) p))))\n           (if (nil? (:admission (:link-source state)))\n             (str \"Recorded \" (if (= command 'trust) \"trust\" \"untrust\")\n                  \" for \" p \"; unused while admission is external\")\n             (str (if (= command 'trust) \"Trusted \" \"Untrusted \") p))])))\n    (catch #?(:cljd Object :clj Exception :cljs :default) e\n      [state (str \"Error: \" (ex-message e))])))\n\n\n(declare repl-state)\n\n\n(defn handle-command\n  \"Answer one shell command.  Unsupported arguments are answered as text, not\n   thrown, so a mistyped command cannot end a step.\"\n  [state form]\n  (let [[command & args] form]\n    (case command\n      vm (let [vm-type (first args)]\n           (if (contains? vm-constructors vm-type)\n             [(rebuild-session state vm-type)\n              (str \"Switched to \" (get vm-labels vm-type)\n                   (if (store/durable? (:index-store state))\n                     \" (VM store cleared; durable code index kept)\"\n                     \" (store cleared)\"))]\n             [state (str \"Error: Unknown Yin REPL VM type \" (pr-str vm-type)\n                         \"; supported: \"\n                         (pr-str (vec (keys vm-constructors))))]))\n      lang (let [lang (first args)]\n             (if (usable-binding (select-frontend (:frontends state) lang))\n               [(switch-lang state lang)\n                (str \"Switched to \" lang)]\n               [state (str \"Error: unavailable-parser: Yin REPL language \"\n                           (pr-str lang) \" is not in the frontend catalog; \"\n                           (installed-text (:frontends state)))]))\n      compile [state (render-compile-output\n","exit_code":0,"status":"completed"}}
