:2703:         resolver (when-not legacy? (u/mark-tails (ambient-resolver descriptor)))\nsrc/cljc/yang/python/antlr/lower.cljc:2729:         (vary-meta program assoc :yang.frontend/ambient-resolver\nsrc/cljc/yin/repl/frontends.cljc:112:        lower (if legacy? python.repl/lower-session python.repl/lower-clojure-session)\nsrc/cljc/yin/repl/frontends.cljc:113:        lower-session (fn [packet session]\nsrc/cljc/yin/repl/frontends.cljc:120:               :lower (fn [packet] (first (lower-session packet nil)))\nsrc/cljc/yin/repl/frontends.cljc:121:               :lower-session lower-session\nsrc/cljc/yin/repl/frontends.cljc:126:               :render (if legacy? python.repl/display-value python.repl/display-clojure-value)}\nsrc/cljc/yin/repl/frontends.cljc:143:                                        :render :php/out})]))]\nsrc/cljc/yin/repl/frontends.cljc:148:          (assoc :yang.frontend/preferred [:yang/python \"clojure-core-v1\"]))\nAGENTS.md\ncollab/yang-clojure/AGENTS.md\n","exit_code":0,"status":"completed"}}
