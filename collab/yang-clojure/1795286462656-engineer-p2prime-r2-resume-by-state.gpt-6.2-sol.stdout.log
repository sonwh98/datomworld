) c) d)))\n    (defn comp\n      ([] identity)\n      ([f] f)\n      ([f g]\n       (fn\n         ([x] (f (g x)))\n         ([x y] (f (g x y)))\n         ([x y z] (f (g x y z)))))\n      ([f g h] (comp f (comp g h))))\n    (defn partial\n      ([f a]\n       (fn\n         ([] (f a))\n         ([x] (f a x))\n         ([x y] (f a x y))\n         ([x y z] (f a x y z))))\n      ([f a b]\n       (fn\n         ([] (f a b))\n         ([x] (f a b x))\n         ([x y] (f a b x y))\n         ([x y z] (f a b x y z))))\n      ([f a b c]\n       (fn\n         ([] (f a b c))\n         ([x] (f a b c x))\n         ([x y] (f a b c x y))\n         ([x y z] (f a b c x y z)))))])\n\n\n(defn library-for\n  \"The definitions of `library` that `forms` need: those whose names `forms`\n/tmp/dw-p2prime-runtime.log:6:Testing yang.clojure-test\n/tmp/dw-p2prime-wedge.log:6:Testing d2-wedge-min-repro\n/tmp/dw-p2prime-wedge.log:9:ERROR in (test-h31-wedge-min-repro) (d2_wedge_min_repro.clj:72)\n/tmp/dw-p2prime-wedge.log:61:Ran 1 tests containing 1 assertions.\n/tmp/dw-p2prime-wedge.log:62:0 failures, 1 errors.\n/tmp/dw-p2prime-full.log:6:Testing yang.clojure-callsite-test\n/tmp/dw-p2prime-full.log:12:FAIL in (portable-replay-cohort-test) (clojure_callsite_test.cljc:1136)\n/tmp/dw-p2prime-full.log:16:Testing yang.clojure-test\nWARNING: Implicit use of clojure.main with options is deprecated, use -M ./bin/analyze-deps.clj\nLoading initial Timbre config from: :default\nGenerating dependency graph...\n\n=== DEPENDENCY COUPLING ANALYSIS ===\n\n✓ No circular dependencies detected\n\n⚠ HIGH-DEGREE NODES (137 namespaces with 6+ connections)\n  dao.await (in:1, out:6)\n  dao.data (in:5, out:2)\n  dao.datom (in:12, out:0)\n  dao.gui.event (in:3, out:6)\n  dao.gui.event.pointer (in:1, out:5)\n  dao.host.bytes (in:22, out:0)\n  dao.host.float (in:6, out:1)\n  dao.host.integer (in:15, out:0)\n  dao.host.text (in:15, out:0)\n  dao.jing (in:55, out:7)\n  dao.jing.cbor (in:37, out:5)\n  dao.jing.content.step (in: