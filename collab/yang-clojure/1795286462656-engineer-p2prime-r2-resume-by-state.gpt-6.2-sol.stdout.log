emantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-machine-depth\n  \"Like run-guest-machine, but records the maximum continuation depth\n   (the semantic lane's K-vector length, or the walker lane's :next chain\n   length) across the run, and returns the terminal machine with the max\n   depth attached under `:max-depth`.\"\n  [ast modules lane step-limit]\n  (when-not (vector? params)\n    (reject! \"fn parameters must be a vector\" {:params params}))\n  (reduce (fn [acc [i p]]\n            (when (= '& p)\n              (reject! \"Variadic fn parameters are not supported\" {:params params}))\n            (check-binder! p params)\n            (if (vector? p)\n              (let [fresh (temp-symbol (str \"p\" i) (meta p))]\n                (-> acc\n                    (update :params conj fresh)\n                    (update :bindings conj p fresh)))\n              (update acc :params conj p)))\n          {:params [], :bindings []}\n          (map-indexed vector params)))\n\n\n;; =============================================================================\n;; defn headers\n;; =============================================================================\n\n(defn- parse-head\n  \"Split (op name doc? attr-map? & more) into {:name :doc :attrs :more}. A\n   string or map only counts as header when a form follows it.\"\n  [operator operands]\n  (let [[fn-name & more] operands\n        _ (check-def-name! operator fn-name)\n        [doc more] (if (and (string? (first more)) (next more))\n                     [(first more) (rest more)]\n                     [nil more])\n        [attrs more] (if (and (map? (first more)) (next more))\n                       [(first more) (rest more)]\n                       [nil more])]\n    {:name fn-name, :doc doc, :attrs attrs, :more more}))\n\n","exit_code":0,"status":"completed"}}
