{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"sed -n '526,560p' src/cljc/yang/clojure.cljc\nsed -n '242,326p' test/yang/call/conformance.clj\nsed -n '1,104p' src/cljc/yang/core/module.cljc\nsed -n '245,322p' src/cljc/yin/vm/linker/publish.cljc\"","aggregated_output":"\n\n(defn- first-form\n  [cursor meta-map]\n  (cond-> (list 'first cursor)\n    meta-map (with-meta meta-map)))\n\n\n(defn- rest-form\n  [cursor meta-map env]\n  ;; Parameter and loop destructuring can be emitted after outcome lowering.\n  ;; Keep their cursors raw vectors even when the guest library defines rest\n  ;; with the argument-vector/outcome convention.\n  (cond-> (if (contains? (::defined env) 'rest)\n            (list 'data/subvec (list 'vec cursor) (list 'if (list 'empty? cursor) 0 1))\n            (list 'rest cursor))\n    meta-map (with-meta meta-map)))\n\n\n(defn- nthnext-form\n  \"Clojure's nthnext at a cursor: nil once exhausted, else the remainder.\"\n  [cursor meta-map]\n  (cond-> (list 'if (list 'empty? cursor) nil cursor)\n    meta-map (with-meta meta-map)))\n\n\n(defn- temp-symbol\n  [path meta-map]\n  (cond-> (symbol (str reserved-prefix path))\n    meta-map (with-meta meta-map)))\n\n\n(defn- destructure-sequential\n  \"Flat [sym form ...] bindings destructuring `pattern` against symbol `t`.\n   A chain of cursors walks the value with first/rest; `path` names the\n(defn- runtime-entry\n  \"Require and initialize each distinct runtime of `frontend-keys`, once.\"\n  [frontend-keys]\n  (into [(core-module/require-node 'yang.call)]\n        (mapcat (fn [runtime]\n                  [(core-module/require-node runtime)\n                   (u/sexp->uast (list (symbol (str runtime) \"init!\")))]))\n        (distinct (map (comp :runtime profile) frontend-keys))))\n\n\n(defn- donor-run\n  \"The donor module required and its body run under its runtime's entry.\"\n  [{:keys [frontend module]}]\n  [(core-module/require-node module)\n   (u/app (u/v (:run-main (profile frontend)))\n          (u/v (symbol (str module) \"body\")))])\n\n\n(defn export-program\n  \"The program whose value is the donor's `export`, read from its runtime's\n   global namespace after its body ran.\"\n  [donor export]\n  (let [{:keys [read-export]} (profile (:frontend donor))]\n    (u/mark-tails\n      (u/seq-nodes (concat (runtime-entry [(:frontend donor)])\n                           (donor-run donor)\n                           [(u/sexp->uast (read-export export))])))))\n\n\n(defn compose\n  \"The caller program: the donor's body run, each name of `exports` read\n   from the donor runtime and projected into `caller-frontend`'s namespace\n   under the same name, then `caller-source`, lowered unmodified, run under\n   its runtime's entry. Its value is the caller entry's value.\"\n  [donor exports caller-frontend caller-source]\n  (let [{:keys [read-export]} (profile (:frontend donor))\n        {:keys [project parse unit run-main]} (profile caller-frontend)]\n    (u/mark-tails\n      (u/seq-nodes\n        (concat (runtime-entry [(:frontend donor) caller-frontend])\n                (donor-run donor)\n                (map (fn [export]\n                       (let [value (symbol (str \"xlang.export.\" export))]\n                         (u/let1 value\n                                 (u/sexp->uast (read-export export))\n                                 (u/sexp->uast (project export value)))))\n                     exports)\n                [(u/app (u/v run-main) (unit (parse caller-source) exports))])))))\n\n\n(defn link-source\n  \"The serving composition naming the runtimes and the donor module.\"\n  [{:keys [module address]}]\n  (h/source {'yang.call (:call-address @h/published),\n             'js (:address @h/published),\n             'php (:address @published-php),\n             'py (:address @published-py),\n             'clj (:address @published-clj),\n             'yrt.effect (:address @published-effect),\n             module address}))\n\n\n(defn run-program\n  \"`{backend value}` of `ast`, linked against `donor`, on each vector VM.\"\n  [donor ast]\n  (let [src (link-source donor)]\n    (into (sorted-map)\n          (map (fn [backend]\n                 [backend\n                  (vm/value (h/run-linked backend ast {:modules (modules),\n                                                       :link-source src}))]))\n          (keys h/backends))))\n\n\n(defn agreed\n  \"The one value every backend of `results` answered, else\n   `{:disagreement results}`.\"\n  [results]\n  (let [vs (set (vals results))]\n    (if (= 1 (count vs)) (first vs) {:disagreement results})))\n\n\n(defn call\n  \"Publish the donor `[frontend source]`, compose its `exports` into the\n   caller `[frontend source]`, run it on each vector VM and answer the\n(ns yang.core.module\n  \"Module emitter machinery shared by every language frontend\n   (docs/design/yang.typescript.md §17, lift L3): the linker module naming\n   rule, the `require` and wide-application tree nodes, free-name\n   declaration over a host registry, and the `module-spec` and SCC bundle\n   shapes `yin.vm.linker.publish/publish-module!` takes. A language supplies\n   its prefix, its runtime module and its module AST; nothing here knows a\n   source language.\"\n  (:require\n    [clojure.string :as str]\n    [yang.core.prelude :as prelude]\n    [yang.core.prelude-admission :as prelude-admission]\n    [yang.core.uast :as u]))\n\n\n(defn module-symbol\n  \"The linker module name of source module `name` under language `prefix`\n   (\\\"py\\\", \\\"php\\\", \\\"js\\\"): `<prefix>m.` then the name with each dot a `$`,\n   so no linker module name is a dotted prefix of another.\"\n  [prefix name]\n  (symbol (str prefix \"m.\" (str/replace name \".\" \"$\"))))\n\n\n(defn require-node\n  \"(require 'm) as a tree node.\"\n  [m]\n  (u/sexp->uast (list 'require (list 'quote m))))\n\n\n(defn module-tree\n  \"A wide application: all definitions remain at module