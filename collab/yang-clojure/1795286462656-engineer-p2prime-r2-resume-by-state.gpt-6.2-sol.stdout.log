:refusal-ns \"yang.clojure\"})))\ndiff --git a/src/cljc/yang/clojure/core_module.cljc b/src/cljc/yang/clojure/core_module.cljc\nnew file mode 100644\nindex 00000000..004b61c4\n--- /dev/null\n+++ b/src/cljc/yang/clojure/core_module.cljc\n@@ -0,0 +1,64 @@\n+(ns yang.clojure.core-module\n+  \"Cell-free publication and task-local initialization of the Clojure library.\"\n+  (:require [yang.clojure.core-impl :as impl]\n+            [yang.clojure.prelude :as clj]\n+            [yang.core.prelude :as core]\n+            [yang.core.prelude-admission :as admission]\n+            [yang.core.uast :as u]))\n+\n+\n+(def module-name 'clojure.core)\n+\n+(def ^:private table-key 'clojure.core.rt/exports)\n+(def ^:private uninitialized :clojure.core/uninitialized)\n+\n+\n+(defn accessor-name [name]\n+  (symbol (str module-name) (str name)))\n+\n+\n+(def source-names (set impl/public-names))\n+\n+\n+(def ^:private definitions\n+  (let [populate\n+        (reduce (fn [table name]\n+                  (list 'clj/prim-assoc table (list 'quote name)\n+                        (list 'clj/make-callable {:clj/type :function}\n+                              (impl/callable-entry name))))\n+                {} impl/public-names)]\n+    (into [[table-key uninitialized]\n+           ['clojure.core/init!\n+            (list 'fn []\n+                  (list 'if (list 'data/content= table-key uninitialized)\n+                        (core/define table-key populate)\n+                        nil))]\n+           ['clojure.core/export '(fn [name] (clj/prim-get clojure.core.rt/exports name))]]\n+          (map (fn [name]\n+                 [(accessor-name name) (list 'fn [] (list 'clojure.core/export (list 'quote name)))]))\n+          impl/public-names)))\n+\n+\n+(def module-exports (core/exports (str module-name) definitions))\n+\n+\n+(def uast (u/mark-tails (core/balanced-definitions->uast definitions)))\n+\n+\n+(def module-uast\n+  (u/annotate-call-sites\n+    (core/module-tree (core/module-definitions (str module-name) uninitialized [] definitions)\n+                      (mapv u/sexp->uast '[(require 'clj) (require 'clojure.core.impl)]))))\n+\n+\n+(def ^:private free-names (core/free-name-vec module-uast))\n+\n+\n+(defn module-spec [registry clj-address impl-address]\n+  (let [requires {clj/module-name clj-address impl/module-name impl-address}]\n+    (admission/module-spec\n+      {:module-name module-name :ast module-uast :exports module-exports\n+       :requires requires :free-names free-names\n+       :skip? #(contains? requires (some-> % namespace symbol))\n+       :registry registry :message \"clojure.core reads an undeclared name\"\n+       :refusal-ns \"yang.clojure\"})))\ndiff --git a/src/cljc/yang/clojure/prelude.cljc b/src/cljc/yang/clojure/prelude.cljc\nindex 5bbbc9a5..cd3f9dd6 100644\n--- a/src/cljc/yang/clojure/prelude.cljc\n+++ b/src/cljc/yang/clojure/prelude.cljc\n@@ -7,6 +7,8 @@\n             [yang.rt.effect :as effect]\n             [yin.vm :as vm]\n             [yin.vm.data :as data]\n+            [yin.vm.float :as float]\n+            [yin.vm.integer :as integer]\n             [yin.vm.module :as module]))\n \n \n@@ -42,6 +44,12 @@\n     [clj/prim-get (fn [coll k] (clj/prim-get-default coll k nil))]\n     [clj/prim-assoc (fn [coll k v] (assoc coll k v))]\n     [clj/rt-ctx (fn [] clj.rt/ctx)]\n+    [clj/dsg__missing-policy\n+     (fn [tag payload] (:clj/unhandled-policy tag payload))]\n+    [clj/perform-policy\n+     (fn [tag payload]\n+       (let [result (yrt.effect/perform (clj/rt-ctx) tag payload clj/dsg__missing-policy)]\n+         (if (data/callable? result) (result) result)))]\n     [clj/raise\n      (fn [e] (yrt.effect/raise (clj/rt-ctx) e (fn [v] (:clj/no-handler v))))]\n     [clj/throw (fn [e] (clj/raise e))]\n@@ -188,7 +196,7 @@\n \n \n (def module-exports\n-  (disj (core/exports \"clj\" definitions) 'dsg__invoke 'dsg__run-body))\n+  (disj (core/exports \"clj\" definitions) 'dsg__invoke 'dsg__run-body 'dsg__missing-policy))\n \n \n (def uast\n@@ -332,7 +340,13 @@\n    registry surfaces; a composition without a clojure program reads none\n    of them.\"\n   [registry]\n-  (let [portable (into {}\n+  (let [registry (cond-> registry\n+                   (not (module/resolve-module registry 'integer.add))\n+                   (integer/register-integer-module {::integer/max-bits 100000\n+                                                     ::integer/max-digits 4300})\n+                   (not (module/resolve-module registry 'float.add))\n+                   (float/register-float-module))\n+        portable (into {}\n                        (map (fn [[source _]]\n                               (let [op (symbol (name source))]\n                                 [op (outcome-adapter data/refusal-message\ndiff --git a/src/cljc/yin/vm/engine.cljc b/src/cljc/yin/vm/engine.cljc\nindex 23776c8c..92712f61 100644\n--- a/src/cljc/yin/vm/engine.cljc\n+++ b/src/cljc/yin/vm/engine.cljc\n@@ -116,7 +116,10 @@\n \n (def ^:private compiler-primitives\n   '{dsg__primitive/get get, dsg__primitive/assoc assoc\n-    dsg__primitive/+ +, dsg__primitive/<= <=})\n+    dsg__primitive/+ +, dsg__primitive/- -, dsg__primitive/< <, dsg__primitive/<= <=\n+    dsg__primitive/= =, dsg__primitive/not not, dsg__primitive/nil? nil?\n+    dsg__primitive/empty? empty?, dsg__primitive/first first, dsg__primitive/rest rest\n+    dsg__primitive/conj conj, dsg__primitive/vec vec})\n \n \n (defn resolve-var\n A src/cljc/yang/clojure/core_impl.cljc\n A src/cljc/yang/clojure/core_module.cljc\n M src/cljc/yang/clojure/prelude.cljc\n M src/cljc/yin/vm/engine.cljc\n","exit_code":0,"status":"completed"}}
