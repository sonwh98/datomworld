\ntest/yang/typescript/antlr/prelude_module_test.cljc:23:      prelude/admit))\ntest/yang/typescript/antlr/prelude_module_test.cljc:52:    (let [spec (prelude/module-spec registry :test/call-address)]\ntest/yang/clojure/donor_link_test.clj:4:            [yang.clojure.prelude :as prelude]\ntest/yang/clojure/donor_link_test.clj:16:        registry (prelude/admit (h/registry))\ntest/yang/clojure/donor_link_test.clj:18:        runtime (h/publish-guest-module! (prelude/module-spec registry call-address effect-address))\ntest/yang/typescript/antlr/prelude_parity_test.cljc:43:                prelude/admit)})\ntest/yang/clojure_test.clj:2538:   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\ntest/yang/clojure_test.clj:2579:                (into (yang/library-for program) program)\ntest/yang/clojure_test.clj:2702:    (let [names (set (map second (yang/library-for '[(seq? x)])))]\ntest/yang/clojure_test.clj:2706:    (is (= [] (yang/library-for '[(+ 1 2)])))\ntest/yang/clojure_test.clj:2707:    (is (= [] (yang/library-for '[(quote (map f xs))])) \"quoted data mentions nothing\")\ntest/yang/clojure_test.clj:2708:    (is (= [] (yang/library-for '[(defn map\ntest/yang/python/antlr/safepoint_test.cljc:65:                prelude/admit)})\nsrc/cljc/yin/repl.cljc:863:                                  php-prelude/admit)\ntest/bench/python_register_bench.clj:77:  (prelude/admit\ntest/yang/python/antlr/linked_harness.cljc:61:                                          (prelude/module-spec (registry)\ntest/yang/python/antlr/int_contract_test.cljc:154:                prelude/admit)})\ntest/yang/python/antlr/int_contract_test.cljc:442:           (refusal-of #(prelude/admit\ntest/yang/python/antlr/int_contract_test.cljc:449:           (refusal-of #(prelude/admit\ntest/yang/python/antlr/int_contract_test.cljc:455:      (is (identical? r (prelude/admit r)))))\ntest/yang/python/antlr/int_contract_test.cljc:459:             (refusal-of #(prelude/admit\ntest/yang/python/antlr/int_contract_test.cljc:471:    (let [wide (prelude/admit (registry-under items\ntest/yang/python/antlr/int_contract_test.cljc:474:          small (prelude/admit (registry-under items\ntest/yang/python/antlr/float_address_test.cljc:304:                prelude/admit)})\ntest/yang/python/antlr/c3_gate_parser_test.clj:53:      prelude/admit))\ntest/yang/python/antlr/e2e_test.clj:86:  (prelude/admit (reduce (fn [reg sym] ((requiring-resolve sym) reg))\ntest/yang/python/antlr/e2e_test.clj:867:                       prelude/admit)\ntest/yang/python/antlr/int_heap_test.cljc:37:                prelude/admit)})\ntest/yang/python/antlr/int_ops_test.cljc:34:                prelude/admit)})\ntest/yang/python/antlr/prelude_parity_test.cljc:46:                prelude/admit)})\ntest/yang/python/antlr/e2e_c2_test.clj:1136:                prelude/admit)})\ntest/yang/python/antlr/int_literal_test.cljc:436:                prelude/admit)})\ntest/yang/python/antlr/linked_prelude_test.cljc:143:  (let [spec (prelude/module-spec registry :test/call-address)]\ntest/yang/python/antlr/linked_prelude_test.cljc:162:          refusal (refusal-of #(prelude/module-spec no-data :test/call-address))]\ntest/yang/python/antlr/linked_prelude_test.cljc:173:  (let [declared (keys (:primitives (prelude/module-spec registry :test/call-address)))]\ntest/yang/python/antlr/linked_prelude_test.cljc:287:                         store (prelude/module-spec registry\ntest/yang/python/antlr/linked_prelude_test.cljc:378:                    (prelude/module-spec registry (:call-address @h/published))))]\nsrc/cljc/yang/clojure.cljc:38:            [yang.clojure.prelude :as prelude]\nsrc/cljc/yang/clojure.cljc:2580:;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\nsrc/cljc/yang/core/prelude_recipes.cljc:28:     'clj (recipe :yang.clojure/clj-prelude 'clj :left-fold :clj/uninit #{\"clj.rt\"} false [] true \"yang.clojure\")\nsrc/cljc/yang/clojure/core_module.cljc:4:            [yang.clojure.prelude :as clj]\nsrc/cljc/yang/clojure/prelude.cljc:1:(ns yang.clojure.prelude\nsrc/cljc/yang/clojure/core_impl.cljc:4:            [yang.clojure.prelude :as clj]\n      (prelude/with-bundled-runtime helpers))))\n\n\n(defn compile-program\n  \"Compile a sequence of Clojure forms into a single Universal AST.\n   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n   with :macro? true on the lambda; the encoder turns that flag into a\n   declaration row and the expander, not this compiler, recognizes calls.\n   The three-argument form takes `opts` opting into the argument-vector\n   convention (see `program-env`); without it the output is the native one.\"\n  ([forms] (compile-program forms true))\n  ([forms tail?] (compile-program forms tail? nil))\n  ([forms tail? opts]\n   (run! check-program-symbols! forms)\n   (let [env (program-env forms opts)]\n     ;; A discarded definition must not become a lexical binding in the\n     ;; following definitions. Descriptor entry and body closures both capture\n     ;; their environment: retaining the previous descriptor here doubles its\n     ;; paths at each definition during machine-data validation and UCF lift.\n     (letfn [(discard-result\n               [ast]\n               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n             (go\n               [forms macro-env]\n               (if (empty? forms)\n                 (compile-literal nil tail?)\n                 (let [head       (cond->> (first forms)\n                                    (outcomes? env) (lower-top-form env macro-env))\n                       rest-forms (rest forms)]\n                   (cond\n                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n                     ;; lambda the encoder declares; later forms see the name\n                     ;; only so the native defn lowering can yield to it.\n                     (and (seq? head) (= 'defmacro (first head)))\n                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n                       (cond-> {:type     :application\n                                :operator {:type :lambda, :params ['_]\n                                           :body (go rest-forms\n                                                     (assoc macro-env\n                                                            (strip-symbol-meta (second head))\n                                                            {:type :user}))}\n                                :operands [(discard-result defined)]}\n                         tail? (assoc :tail? true)))\n                     ;; def: sequence with current macro-env\n                     (and (seq? head) (= 'def (first head)))\n                     (let [[_ name value] head\n                           value (if (outcomes? env)\n                                   (lower-function-body env macro-env [] [value])\n                                   value)]\n                       (cond-> {:type     :application\n                                :operator {:type :lambda, :params ['_]\n                                           :body (go rest-forms macro-env)}\n                                :operands [(discard-result (compile-def name value env false macro-env))]}\n                         tail? (assoc :tail? true)))\n                     ;; single form\n                     (= 1 (count forms))\n                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n                     ;; sequence\n                     :else\n                     (cond-> {:type     :application\n                              :operator {:type :lambda, :params ['_]\n                                         :body (go rest-forms macro-env)}\n                              :operands [(discard-result\n                                           (compile-form head false\n                                                         (assoc env ::top-level true) macro-env))]}\n                       tail? (assoc :tail? true))))))]\n       (annotate-call-sites\n         (cond->> (go forms initial-macro-env)\n           (outcomes? env) (#(with-runtime % (:linked-runtime opts) env))\n           (outcomes? env) tails/remark-tails))))))\n\n\n;; =============================================================================\n;; The guest collection and higher-order library (slice 7)\n;; =============================================================================\n;;\n;; Guest-side source, compiled through this compiler like any program: the\n;; functions that invoke guest closures (map, filter, reduce, comp, partial)\n;; must run on the VM, never on the host, because a closure is a VM value. It\n;; is written for the argument-vector convention with the outcome model, so a\n;; closure it calls is unwrapped by the compiler's own early-return pattern\n;; and a closure's failure ends the library function with the same outcome.\n;;\n;; What is derived, from the VM primitives and the `data` module only:\n;; identity, inc/dec, second, the collection predicates (coll?/vector?/map?/\n;; set?/seq?/list?/sequential?, from the `data/*` and `kind/*` host\n;; predicates), boolean?,\n;; fn? (data/callable?), seq, rem, reverse, list, cons, vector, count,\n;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\n;; keys/vals/disj and set union/difference,\n;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\n;; compiler intrinsic over the convention's argument vector.\n;;\n;; What stays a host primitive, named by the `kind` module: a symbol, a\n;; keyword and a host string are distinguished or built only by the host\n;; (symbol?, keyword?, name, symbol, keyword, str, int?), as is metadata access\n;; (meta and with-meta). The current data ABI has no metadata-write export,\n;; so with-meta is an explicit pure representation seam, not an ambient store.\n;; No VM primitive tells a symbol from a keyword. Clojure Var identity is an\n;; explicitly admitted kind/var? seam on the JVM; namespace lookup (resolve)\n;; still requires a separately installed host capability.\n;;\n;; Known compromises: `reduced` is an untyped tagged map, so reduced? matches\n;; any map holding :yin.k/reduced true; seq refuses a non-collection (a string\n;; is the data module's str-* ops, not a seq); eager sequences are lists;\n;; rem rejects non-integers and a zero divisor before arithmetic; the compiler\n;; emits bare conj and vec, so a program may not define or bind either.\n;; When collection calls are needed, invoke-value is a library helper whose\n;; local capture is refused explicitly.\n;;\n;; Variadic Clojure functions are fixed-arity here (the convention has no\n;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\n;; merge 0 to 4, union 0 to 6, difference 2, comp 0 to 3, partial binds 1 to 3.\n         ([x y z] (f a b c x y z)))))])\n\n\n(defn library-for\n  \"The definitions of `library` that `forms` need: those whose names `forms`\n   mention (outside quoted data), and the ones those mention in turn, in\n   library order. Compiling only these keeps a program small.\"\n  [forms]\n  (let [by-name (into {} (map (fn [f] [(second f) f])) library)\n        mentions (fn mentions\n                   [form]\n                   (cond\n                     (symbol? form) #{form}\n                     (seq? form) (if (= 'quote (first form))\n                                   #{}\n                                   (into #{} (mapcat mentions) form))\n                     (coll? form) (into #{} (mapcat mentions) form)\n                     :else #{}))\n        defined (into #{} (comp (filter seq?) (filter #(= 'defn (first %))) (map second)) forms)\n        needed (loop [todo (remove defined (mentions forms)), seen #{}]\n                 (if (empty? todo)\n                   seen\n                   (let [n (first todo)]\n                     (if (or (contains? seen n) (not (contains? by-name n)))\n                       (recur (rest todo) seen)\n                       (recur (into (rest todo)\n                                    (remove (conj defined n) (mentions (by-name n))))\n                              (conj seen n))))))]\n    (letfn [(nodes\n              [form]\n              (cons form (when (and (coll? form) (not (and (seq? form) (= 'quote (first form)))))\n                           (mapcat nodes form))))\n            (dynamic-call?\n              [source]\n              (let [tree (nodes source)\n                    possible-locals (into #{} (comp (filter vector?) (mapcat identity) (filter symbol?)) tree)]\n                (some (fn [x]\n                        (and (seq? x) (seq x) (not= 'quote (first x))\n                             (or (contains? possible-locals (first x))\n                                 (and (not (symbol? (first x))) (not (keyword? (first x))))))) tree)))\n            (close\n              [todo seen]\n              (if-let [n (first todo)]\n                (if (or (contains? seen n) (contains? defined n) (not (contains? by-name n)))\n                  (recur (rest todo) seen)\n                  (recur (concat (rest todo) (mentions (by-name n))) (conj seen n))) seen))]\n      (let [source (concat forms (map by-name needed))\n            needed (if (some dynamic-call? source) (close ['invoke-value] needed) needed)]\n        (filterv #(contains? needed (second %)) library)))))\n\n\n(defn compile\n  \"Main compiler entry point.\n\n  Compiles a Clojure form into Yin VM Universal AST.\n\n  Examples:\n    (compile 42)\n    => {:type :literal, :value 42}\n\n    (compile '(+ 1 2))\n;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\n;; `read-forms` is the frontend's parser — the reader itself — and\n;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n;; whose call runs the program compiled under the argument-vector\n;; convention and the outcome model over the guest library, with every\n;; top-level definition published to the runtime global namespace\n;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n;; its module's globals. No call node is rewritten and no foreign\n;; `:code` is extracted: the unit is the program's own lowering,\n;; wrapped.\n\n(def unit-opts\n  \"The `compile-program` opts a linked unit compiles with: the\n   argument-vector convention with the outcome model over the guest\n   library's adapters. The required clj module supplies the continuation\n   family; VM primitives are callable directly by bare name.\"\n  {:convention :arg-vector,\n   :outcomes true,\n   :linked-runtime true,\n   :adapters library-adapters,\n   :native vm/primitive-profiles})\n\n\n(def top-defining-operators\n  \"The operators whose second element names a top-level definition.\"\n  '#{def defn defn- defmacro})\n\n\n(defn read-forms\n  \"Every form `source` text reads. The reader is the parser: a malformed\n   source throws, as any frontend's refused parse does.\n\n   Source-string compilation is a JVM/Node capability (tools.reader is\n   an mvn dependency, absent from the jolt host's source-root classpath\n   — the jolt lane loads compiled output and ships source strings to\n   remote evaluators, so this is unreachable there; the honest error\n   says so if ever reached).\"\n  [source]\n  #?(:cljd (throw (ex-info \"Source-string compilation requires the JVM/Node reader; ClojureDart compiles from forms\"\n                           {:yang.clojure/reader :unavailable-on-cljd}))\n     :jolt (throw (ex-info \"Source-string compilation requires the JVM/Node reader; the jolt host compiles from forms or delegates source reading to its remote evaluators\"\n                           {:yang.clojure/reader :unavailable-on-jolt}))\n     :default\n     (let [rd (rt/string-push-back-reader source)]\n       (loop [forms []]\n         (let [form (treader/read rd false ::eof)]\n           (if (= form ::eof)\n             forms\n             (recur (conj forms form))))))))\n\n\n(defn top-level-names\n  \"The names `forms` define at the top level, in order: the second element\n   of each def/defn/defn-/defmacro head.\"\n  [forms]\n  (into []\n        (comp (filter #(and (seq? %) (contains? top-defining-operators (first %))))\n              (map (comp strip-symbol-meta second)))\n        forms))\n\n\n(declare publish-to-globals)\n\n\n(defn- globals-child\n  [x names bound]\n  (cond\n    (and (map? x) (contains? x :type)) (publish-to-globals x names bound)\n    (vector? x) (mapv #(globals-child % names bound) x)\n    :else x))\n\n\n(defn- publish-to-globals\n  \"Rewrite the compiled `node` for the linked unit: a top-level\n   definition in `names` becomes a `clj/define-global!` write and a free\n   read of one becomes a `clj/global-get`, both under the name's string.\n   The `names` a unit is lowered with are its own top-level definitions,\n   its guest library's and the projected names the composition bound in\n   the runtime global namespace, so a projected export and a definition\n   read through the one binding: a definition the unit itself runs\n   publishes after the projection and shadows it. A store definition\n   inside the unit thunk is conditional to the linker, so no body read\n   of it discharges (the runtime preludes avoid this by keeping every\n   definition at module level); the runtime global namespace is the\n   linked unit's definition table instead, as a Python module body\n   writes its dictionary. Lexically bound names, quoted literals and\n   macro definitions keep their store shape: a macro is not a runtime\n   value.\"\n  [node names bound]\n  (case (:type node)\n    :literal node\n    :vm/current-continuation node\n    :variable (if (and (contains? names (:name node))\n                       (not (contains? bound (:name node))))\n                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\n                node)\n    :lambda (assoc node :body (publish-to-globals (:body node) names\n                                                  (into bound (:params node))))\n    :application\n    (if (and (= 'yin/def (get-in node [:operator :name]))\n             (= 2 (count (:operands node)))\n             (= :literal (:type (first (:operands node))))\n             (contains? names (:value (first (:operands node)))))\n      (u/app (u/v 'clj/define-global!)\n             (u/lit (str (:value (first (:operands node)))))\n             (publish-to-globals (second (:operands node)) names bound))\n      (assoc node\n             :operator (publish-to-globals (:operator node) names bound)\n             :operands (mapv #(publish-to-globals % names bound)\n                             (:operands node))))\n    :if (cond-> node\n          (contains? node :test)\n          (assoc :test (publish-to-globals (:test node) names bound))\n          (contains? node :consequent)\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n          (contains? node :alternate)\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n    (reduce (fn [n k]\n              (let [v (get n k)]\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\n                  (assoc n k (globals-child v names bound))\n                  n)))\n            node (keys node))))\n\n\n(defn lower-unit\n  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n   thunk whose call runs the program — `forms` plus the definitions of\n   the guest library they need, compiled unmodified under `unit-opts`\n   and published to the runtime global namespace by\n   `publish-to-globals` — so the helper's export projection can read\n   each top-level definition. The two-argument form also takes the\n   projected `exports` (names the composition already bound in the\n   runtime global namespace): their free reads publish the same way, so\n   the projection is the caller's binding for them. The program's own\n   `yang.call` call sites need no free-name declaration: the convention\n   preamble `compile-program` emits defines those names locally, and\n   the donor publication pins the `yang.call` module for the qualified\n   reads that remain.\"\n  ([forms] (lower-unit forms []))\n  ([forms exports]\n   (let [source (vec forms)\n         library (library-for source)\n         program (compile-program (concat source library) true unit-opts)\n         macros (into #{}\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n                            (map (comp strip-symbol-meta second)))\n                      (concat source library))\n         names (reduce disj\n                       (into (set (top-level-names source))\n                             (concat (map (comp strip-symbol-meta second) library)\n                                     (map symbol exports)))\n                       macros)]\n     ;; `publish-to-globals` rewrites nodes after `compile-program`\n     ;; finalized them, so the unit is finalized again over its\n     ;; finished tree: the rewrite's own applications are occurrences.\n     (annotate-call-sites (u/lam [] (publish-to-globals program names #{}))))))\n\n\n(defn output\n  \"The `clj/run-main` value as test data.\"\n  [value]\n  (pr-str value))\n          (yang/compile-program [form] true library-opts))))\n  ;; `finally` is now expressible (the one-catch/no-finally restriction is\n  ;; lifted): a try with only a finally runs it on normal exit.\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok 1]\n           (run-library '[(try 1 (finally 2))] library-opts lane 1000000)))))\n\n\n(deftest test-guest-callable-collections-and-threading\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok ['b 2 :absent :k nil 3 {:n 3}]]\n           (run-library\n             '[(let [v '[a b] m {:k 2} s #{:k} k :n]\n                 [(v 1) (m :k) (m :missing :absent) (s :k) (s :missing)\n                  (k {:n 3}) (-> {:n 1} (update :n + 2))])]\n             library-opts lane 1000000))))\n  (is (= [:yin.k/ok :caught]\n         (run-library '[(try (let [v [1]] (v)) (catch Exception e :caught))]))))\n\n\n(deftest test-value-invocation-refusals-are-terminating\n  (testing \"entry-absent callees refuse through the library invoker instead of\n            re-entering the dispatcher; the vector binder only forces the\n            invoker into the library so the routing is actually exercised\"\n    (doseq [lane [:walker :semantic]]\n      ;; (A): the invoker's source-thrown refusal map is an ordinary\n      ;; payload at this harness boundary (a public entry rebuilds the\n      ;; `:yang.call/thrown` wire condition from it).\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(let [five 5 v [five]] (five 1))]\n                          library-opts lane 1000000))\n          \"a scalar callee terminates as not-callable\")\n      (let [[tag _] (run-library\n                      '[(defn f\n                          [x]\n                          x)\n                        (let [e yang.call/entry v [e]] (e f))]\n                      library-opts lane 1000000)]\n        (is (= :yin.k/ok tag)\n            \"a module fn is an admitted descriptor: the call goes through admission\"))\n      (let [[tag payload] (run-library\n                            '[(defn f\n                                [x]\n                                x)\n                              (let [raw (yang.call/entry f) v [raw]] (raw {}))]\n                            library-opts lane 1000000)]\n        (is (= :yin.k/error tag) \"a projected raw closure terminates\")\n        (is (= :yang.call/not-callable (:yang.call/reason payload))\n            \"the adoption's refusal is the escaped payload at this boundary\")\n        (is (some? (get-in payload [:yang.call/data :yang.call/callee]))\n            \"the refusal names the callee in its evidence\"))\n      (doseq [entry [nil false]]\n        (let [[tag payload] (run-library\n                              [(list 'let ['m {:yang.call/entry entry :x 42} 'v '[m]]\n                                     '(m :x))]\n                              library-opts lane 1000000)]\n          (is (= :yin.k/error tag) (str \"a \" (pr-str entry) \" entry is present, not absent\"))\n          (is (= :yang.call/not-callable (:yang.call/reason payload))\n              (str \"a \" (pr-str entry) \" entry reaches admission and refuses\"))))\n      (let [[tag payload] (run-library\n                            '[(defn tail-refusal\n                                []\n                                (let [five 5 v [five]] (five 1)))\n                              (tail-refusal)]\n                            library-opts lane 1000000)]\n        (is (= :yin.k/error tag))\n        (is (= {:yang.call/reason :yang.call/not-callable\n                :yang.call/data {:yang.call/callee 5}}\n               payload)\n            \"the refusal survives a tail-position value call as the payload\")\n        (is (= {:yang.call/callee 5}\n               (get-in payload [:yang.call/data]))\n            \"the callee evidence names the scalar callee\"))\n      (doseq [[where form] [[1 '(five (boom) 2)] [2 '(five 1 (boom))]]]\n        (let [[tag payload] (run-library\n                              ['(defn boom\n                                  []\n                                  (throw (ex-info \"boom\" {})))\n                               (list 'let '[five 5 v [five]] form)]\n                              library-opts lane 1000000)]\n          (is (= :yin.k/error tag) (str \"operand \" where \" errors before the refusal\"))\n          (is (= \"boom\" (:yin.k/message payload))\n              (str \"operand \" where \" is evaluated before the callee check\")))))))\n\n\n11:(defn define\n18:(defn strip\n27:(defn- strip-form\n35:(defn- placeholder\n42:(defn module-definitions\n51:(defn wide-app\n61:(defn module-tree\n69:(defn exports\n77:(defn free-names\n97:(defn defined-keys\n109:(defn free-name-vec\n116:(defn balanced-definitions->uast\n132:(defn definitions->uast\n","exit_code":0,"status":"completed"}}
