ody :inner :outer]}}\n   {:id :loop-recur-cleanup\n    :form '(fn [record!]\n             (loop [i 0 total 0]\n               (if (< i 3)\n                 ;; JVM Clojure forbids recur across try: finish cleanup\n                 ;; before recurring, and observe it on every iteration.\n136:    (when (and (= 'defn kind) (seq body-ops))\n143:    (when (and (= 'defn kind) (vector? (first body-ops)))\n","exit_code":0,"status":"completed"}}
