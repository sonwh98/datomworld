{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,48p;918,934p;1196,1214p;1326,1344p' test/yang/clojure_callsite_test.cljc\nsed -n '190,243p' test/yang/latte_oracle_test.clj\nsed -n '28,105p' test/yang/cc4_corpus.clj\nrg -n 'defn .*admission|projected-runtime|clj-prelude' test/yang/clojure_callsite_test.cljc\"","aggregated_output":"(ns yang.clojure-callsite-test\n  \"Contract C1 for production yang.clojure (Addendum A, design §2): the\n   `:yang/call-site 1` frontend-metadata annotation of every final\n   `:application` occurrence, and the complete-coverage validation a\n   consumer runs against canonical rows.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.string :as str]\n            [clojure.walk :as walk]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [dao.space.index :as space.index]\n            [dao.space.query :as query]\n            #?@(:clj [[dao.stream :as stream]\n                      [dao.stream.ringbuffer :as ring]])\n            [yang.clojure :as yang]\n            [yang.clojure.prelude :as clj-prelude]\n            [yang.core.call :as call]\n            [yang.rt.effect :as effect]\n            [yang.frontend :as frontend]\n            [yang.safepoint :as safepoint]\n            [yang.tails :as tails]\n            [yin.repl :as repl]\n            [yin.repl.frontends :as repl-frontends]\n            [yin.repl.store]\n            [yin.shell.query :as shell-query]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.linker.closure :as closure]\n            [dao.stream.apply :as apply2]\n            [yin.repl.query :as repl-query]\n            [yin.vm.linker.dht :as linker-dht]\n            #?(:clj [yin.vm.linker.interpreter :as link])\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.macro :as macro]\n            [yin.vm.module :as module]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.semantic.derive :as derive]))\n\n\n(def ^:private origin [:source :program \"batch-1\" 0])\n\n\n(defn- project\n  [ast]\n  (let [projected (encoder/project\n                    (encoder/source-envelope :program \"batch-1\" [ast]))]\n                         [x]\n                         (yin/if (yin/literal true) x\n                                 (yin/application (yin/variable 'f) [(yin/literal 1)])))\n                       (defn f\n                         [x]\n                         x) (twin (f 1))])\n         expansion (:result (expand-like-the-repl (prepare macro-ast)))\n         store (mem/create-content-mem)\n         call-spec (update (call/module-spec publish-registry) :ast prepare)\n         call-result (publish/publish-module! store call-spec)\n         effect-result (publish/publish-module! store (effect/module-spec publish-registry))\n         clj-spec (update (clj-prelude/module-spec publish-registry (:address call-result)\n                            (:address effect-result))\n                          :ast prepare)\n         clj-result (publish/publish-module! store clj-spec)\n         published (fn [id result spec]\n                     (let [table (publish/published-call-site-table store result)]\n                         (range 3))))))))))\n\n\n(deftest published-module-test\n  (testing \"the markers are retrievable from the published module\"\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module!\n                        store (call/module-spec publish-registry))\n          call-address (:address call-result)\n          effect-address (:address (publish/publish-module!\n                                     store (effect/module-spec publish-registry)))\n          clj-result (publish/publish-module!\n                       store (clj-prelude/module-spec publish-registry\n                                                      call-address effect-address))\n          clj-address (:address clj-result)]\n      (is (some? call-address))\n      (is (some? clj-address))\n      (doseq [[label result]\n              [[\"yang.call\" call-result]\n                               :operator {:type :variable :name 'yin/def}\n                               :operands [{:type :literal :value 'f}\n                                          {:type :literal :value 42}]}\n                         :exports #{'f} :requires {} :primitives {}})]\n      (is (some? (:address plain)))\n      (is (not (contains? plain :call-sites)))\n      (is (nil? (publish/published-call-site-table store plain)))))\n  (testing \"the manifest excludes the side table; the record names the manifest\"\n    (let [store (mem/create-content-mem)\n          effect-address (:address (publish/publish-module!\n                                     store (effect/module-spec publish-registry)))\n          result (publish/publish-module!\n                   store (clj-prelude/module-spec\n                           publish-registry\n                           (:address (publish/publish-module!\n                                       store\n                                       (call/module-spec publish-registry)))\n                           effect-address))\n          address (:address result)\n\n\n(defn- result-shape\n  \"Collection families and domain metadata, excluding reader provenance.\"\n  [x]\n  [(not-empty (apply dissoc (meta x) [:source :file :line :column :end-line :end-column]))\n   (cond\n     (map? x) (into {} (map (fn [[k v]] [k [(result-shape k) (result-shape v)]])) x)\n     (set? x) (into #{} (map (fn [v] [v (result-shape v)])) x)\n     (sequential? x) [(if (vector? x) :vector :sequence) (mapv result-shape x)]\n     :else :scalar)])\n\n\n(defn- unbound-ast-symbols\n  \"Admission for the portable context module: every variable is a lexical\n   binder, declared guest function, or explicitly supplied data primitive.\"\n  [ast program]\n  (let [globals (into '#{yin/def dsg__primitive/get dsg__primitive/assoc\n                              dsg__primitive/+ dsg__primitive/<=}\n                      (concat (keys vm/primitive-profiles)\n                              ;; the continuation lane's clj/ family, emitted\n                              ;; inline by compile-program under :outcomes true\n                              yang/continuation-family-names\n                              (map first call/definitions)\n                              (for [form program :when (#{'def 'defn 'defn-} (first form))]\n                                (second form))\n                              (for [[module exports] {'kind yang/kind-module\n                                                      'cell module/cell-module\n                                                      'data data/data-module\n                                                      'stream module/stream-module\n                                                      'portable (into {} (map (fn [[_ v]] [(symbol (name v)) nil]))\n                                                                      yang/library-adapters)}\n                                    export (keys exports)]\n                                (symbol (str module) (name export)))))]\n    (letfn [(scan\n              [node bound]\n              (case (:type node)\n                :variable (if (or (contains? globals (:name node))\n                                  (contains? bound (:name node))) #{} #{(:name node)})\n                :literal #{}\n                :vm/current-continuation #{}\n                :lambda (scan (:body node) (into bound (:params node)))\n                :application (into (scan (:operator node) bound)\n                                   (mapcat #(scan % bound)) (:operands node))\n                :if (into #{} (mapcat #(scan (get node %) bound))\n                          [:test :consequent :alternate])\n                ;; The rejection carries the node itself (print-bounded): a\n                ;; bare symbol or unknown shape names its emitter directly.\n                (throw (ex-info \"Unexpected AST in context admission\"\n                                {:type (:type node)\n                                 :node (binding [*print-length* 40 *print-level* 8]\n                                         (pr-str node))}))))]\n      (scan ast #{}))))\n\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})))\n\n\n(defn- expand-like-the-repl\n  [ast]\n  (let [store (macro/seed-store\n                (macro/make-ctx {:token :callsite-test/standard-forms\n                                 :source-medium :callsite-test/standard-forms})\n                [macro/stdlib-forms])\n        ctx (macro/make-ctx {:token \"callsite-test\"\n                             :source-medium :program-in\n                             :store store})]\n    {:ctx ctx\n     :result (macro/expand-batch (encoder/program-batch ast) ctx)}))\n\n\n(defn replay-corpus\n  \"The pinned eight-member corpus. `annotated?` selects the S shape\n   (annotations retained, prepare = identity) or the B shape (C1 markers\n   stripped before projection, exactly the cohort's knob); `excluded` is\n   a set of member ids to omit (recorded in the findings with the exact\n   reason).\"\n  ([] (replay-corpus true #{}))\n  ([annotated? excluded]\n   (let [prepare (if annotated? identity\n                     (fn [ast]\n                       (walk/postwalk (fn [n]\n                                        (if (map? n)\n                                          (dissoc n :yang/call-site) n))\n                                      ast)))\n         forms (quote [(defn replay\n                         [x]\n                         (let [[a b] [x 1.5]]\n                           (+ (identity ^:replay a)\n                              (identity ^:replay a) b)))\n                       (replay 2)])\n         projected (fn [id ast token]\n                     (let [ast (prepare ast)\n                           p (encoder/project\n                               (encoder/source-envelope :cc4/replay token [ast]))]\n                       {:id id :compiled ast\n                        :tree (first (:yin/batch p))\n                        :rows (:yin/frontend-metadata p)}))\n         ast (yang/compile-program forms)\n         macro-ast (yang/compile-program\n                     (quote [(defmacro twin\n                               [x]\n                               (yin/if (yin/literal true) x\n                                       (yin/application\n                                         (yin/variable (quote f))\n                                         [(yin/literal 1)])))\n                             (defn f\n                               [x]\n                               x)\n                             (twin (f 1))]))\n         expansion (:result (expand-like-the-repl (prepare macro-ast)))\n         store (mem/create-content-mem)\n         call-spec (update (call/module-spec publish-registry) :ast prepare)\n         call-result (publish/publish-module! store call-spec)\n         effect-result (publish/publish-module! store (effect/module-spec publish-registry))\n         clj-spec (update (clj-prelude/module-spec\n                            publish-registry (:address call-result)\n                            (:address effect-result))\n                          :ast prepare)\n         clj-result (publish/publish-module! store clj-spec)\n         published (fn [id result spec]\n                     (let [table (publish/published-call-site-table store result)]\n                       {:id id :compiled (:ast spec)\n                        :tree (or (:tree table)\n                                  (vm/ast->semantic-bytecode (:ast spec)))\n                        :rows (or (:rows table) [])\n                        :addresses (assoc (dissoc (:call-sites result) :origin)\n                                          :manifest (:address result))\n                        :published-payloads\n                        (when (:call-sites result)\n                          (mapv #(jing/get store % nil)\n17:            [yang.clojure.prelude :as clj-prelude]\n929:         clj-spec (update (clj-prelude/module-spec publish-registry (:address call-result)\n949:      (projected :prelude clj-prelude/module-uast \"admission-a\")\n1208:                       store (clj-prelude/module-spec publish-registry\n1338:                   store (clj-prelude/module-spec\n","exit_code":0,"status":"completed"}}
