{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"rg -n '(yang-clj|clj-prelude|clojure.prelude|module-spec|golden)' src/cljc/yang/frontend* src/cljc/yin/vm/linker* src/cljc/yang/core/publication* bin | head -160\nsed -n '2450,2550p;2601,2714p;2935,3018p' test/yang/clojure_test.clj\"","aggregated_output":"src/cljc/yang/core/publication.cljc:13:   `:module-spec`       `(fn [registry unit runtime-address deps])`\nsrc/cljc/yang/core/publication.cljc:14:   `:scc-module-specs`  `(fn [registry units runtime-address deps])`\nsrc/cljc/yang/core/publication.cljc:105:  (let [{:keys [imported-names module-spec scc-module-specs site-set alias-site-set\nsrc/cljc/yang/core/publication.cljc:120:                        (scc-module-specs registry (mapv by-name members)\nsrc/cljc/yang/core/publication.cljc:122:                        [(module-spec registry (get by-name step)\n\n\n(def ^:private library-opts\n  {:convention :arg-vector, :outcomes true\n   :adapters yang/library-adapters\n   :native vm/primitive-profiles})\n\n\n(defn run-guest-machine\n  \"Run an AST through either observer composition with a finite instruction\n   budget. Return the terminal machine so fixtures can observe its streams.\"\n  [ast modules lane step-limit]\n  (let [run-bounded (fn [machine]\n                      (loop [v machine, n 0]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) v\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n :consumer v}))\n                          :else (recur (vm/step v) (inc n)))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-machine-depth\n  \"Like run-guest-machine, but records the maximum continuation depth\n   (the semantic lane's K-vector length, or the walker lane's :next chain\n   length) across the run, and returns the terminal machine with the max\n   depth attached under `:max-depth`.\"\n  [ast modules lane step-limit]\n  (let [depth-of (if (= lane :semantic) semantic-depth walker-depth)\n        run-bounded (fn [machine]\n                      (loop [v machine, n 0, mx (depth-of machine)]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) (assoc v :max-depth mx)\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n :consumer v}))\n                          :else (let [v' (vm/step v)]\n                                  (recur v' (inc n) (max mx (depth-of v')))))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-ast\n  \"The value from run-guest-machine; shared by library and oracle fixtures.\"\n  [ast modules lane step-limit]\n  (vm/value (run-guest-machine ast modules lane step-limit)))\n\n\n(defn- run-library\n  \"The raw outcome of the last of `forms`, compiled with the library\n   definitions the program needs.\"\n  ([forms] (run-library forms library-opts))\n  ([forms opts]\n   (let [walker (run-library forms opts :walker 1000000)\n         semantic (run-library forms opts :semantic 1000000)]\n     (is (= walker semantic) (str \"library lanes agree: \" (pr-str forms)))\n     walker))\n  ([forms opts lane step-limit]\n   (run-guest-ast (yang/compile-program (into (yang/library-for forms) forms) true opts)\n                  library-modules lane step-limit)))\n\n\n(defn- lib\n  \"The value of the single expression `form`, or the raw error outcome.\"\n  [form]\n  (let [[tag payload] (run-library [form])]\n    (if (= :yin.k/ok tag) payload [tag payload])))\n\n\n(deftest finally-unwinds-and-orders-cleanup\n  (doseq [lane [:walker :semantic]]\n(deftest test-common-call-cell-ref-map-invocation\n  (testing \"a full-shape data map with a 64-character seal is ordinary invocable data\"\n    ;; The map spells every key of an issued reference and the seal has the\n    ;; issued format; the call site asks the heap (cell/authentic?), the\n    ;; heap does not authenticate it, and the invocation is the map lookup,\n    ;; on both evaluators — the ruling of record replaces the r4 id-language\n    ;; gate: no id spelling is consulted, the issuer answers.\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :type))])))\n    (is (= [:yin.k/ok :some-key]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :id))]))))\n  (testing \"a runtime-built full-shape map (assoc, not a bound literal) invokes as data\"\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m (assoc (assoc (assoc {} :type :cell-ref)\n                                                :id :some-key)\n                                         :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")]\n                            (m :type))]))))\n  (testing \"a full-shape map that is data is not call-eligible\"\n    (is (= [:yin.k/ok false]\n           (run-library '[(yang.call/eligible? {:type :cell-ref :id :some-key\n                                                :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})]))))\n  (testing \"genuine references still dereference through admission\"\n    ;; A cell the engine minted (:cell-0), holding a descriptor with a\n    ;; callable entry: the call reaches the entry.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-probe (u/app (u/v 'cell/new)\n                                    (u/app (u/v 'assoc) (u/lit {})\n                                           (u/lit :yang.call/entry)\n                                           (u/lam ['invocation] (u/lit :called))))\n                             lane))\n          (str lane \" genuine live\"))))\n  (testing \"a genuine-but-dead reference keeps the standing refusal\"\n    ;; A genuine cell whose contents carry no call entry: admission answers\n    ;; false and the call refuses as not-callable — the behavior the D2 bar\n    ;; pins, unchanged by the data fallback.\n    (doseq [lane [:walker :semantic]]\n      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\n                                                     lane)]\n        (is (and (= :yin.k/error tag)\n                 (= :yang.call/not-callable (:yang.call/reason payload)))\n            (str lane \" genuine dead: \" (pr-str result))))))\n  (testing \"the gate's collision literal: an id inside the heap language answers as data\"\n    ;; The r4 reviewer's literal — a map whose :id is a :cell-N keyword and\n    ;; whose seal has the issued format but not the issued content. Under\n    ;; the ruling of record the call site asks the heap and routes by the\n    ;; answer, so the invocation is the map lookup and answers :cell-7,\n    ;; where r4's id-language gate still sent it to the dereference and the\n    ;; VM aborted it as dead-or-forged.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :cell-7]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (m :id))\n                 (probe marker-operand)]\n               (u/lit {:type :cell-ref :id :cell-7\n                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n               lane))\n          (str lane \" collision literal answers as data\"))))\n  (testing \"an exact copy of a genuine reference still resolves as a reference\"\n    ;; Rule 4, the bearer policy: authentication is by value — seal and id\n    ;; against the heap — with no construction-history promises, so a copy\n    ;; reconstructed field-for-field authenticates and its call reaches the\n    ;; cell's entry. Reading the fields uses explicit lookup at data\n    ;; positions (get), never a call of the reference.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (let [copy {:type (get m :type), :id (get m :id), :seal (get m :seal)}]\n                     (copy nil)))\n                 (probe marker-operand)]\n               (u/app (u/v 'cell/new)\n                      (u/app (u/v 'assoc) (u/lit {})\n                             (u/lit :yang.call/entry)\n                             (u/lam ['invocation] (u/lit :called))))\n               lane))\n          (str lane \" bearer copy resolves\"))))\n  (testing \"explicit dereference of a forged reference stays strict\"\n    ;; Astra rule 1: cell/get at a reference position keeps the existing\n    ;; validation boundary — the data fallback lives in call routing, not in\n    ;; the dereference itself.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (cell/get m))\n                 (probe marker-operand)]\n               (u/lit {:type :cell-ref :id :cell-7\n                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n               lane))\n          (str lane \" explicit deref refuses\")))))\n\n\n(deftest test-library-closes-over-its-own-names\n  (testing \"library-for returns the definitions a program mentions, transitively\"\n    (let [names (set (map second (yang/library-for '[(seq? x)])))]\n      (is (every? names '[seq? sequential? vector? map? set? coll?])\n          \"seq? pulls sequential?, vector?, map?, set? and coll?\")\n      (is (not (contains? names 'map))))\n    (is (= [] (yang/library-for '[(+ 1 2)])))\n    (is (= [] (yang/library-for '[(quote (map f xs))])) \"quoted data mentions nothing\")\n    (is (= [] (yang/library-for '[(defn map\n                                    [f c]\n                                    c) (map 1 2)]))\n        \"a program definition shadows the library's\")))\n\n\n(deftest test-library-kind-predicates\n      (is (= :arity (:yin.vm.data/reason\n                      (second (run-library '[(let [g +] (g 1 2 3 4 5))] opts))))))))\n\n\n(deftest test-hardening-library-admissions\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok [nil 2 nil '(1 2) 'b :missing true false false {:name 'source}]]\n           (run-library '[[(last nil) (last [1 2]) (butlast [1]) (butlast [1 2 3])\n                           (nth '(a b) 1) (nth [1] 3 :missing)\n                           (string? \"\") (string? 'x) (var? 'x)\n                           (meta (with-meta 'x {:name 'source}))]]\n                        library-opts lane 1000000))))\n  (testing \"fresh supply crosses function calls and repeated loop iterations\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok [false 12]]\n             (run-library\n               '[(defn allocate\n                   [s]\n                   (fresh-symbol s \"fresh\"))\n                 (let [[a s] (allocate {:counter 0})\n                       [b s] (allocate s)\n                       s (loop [s s i 0]\n                           (if (= i 10) s\n                               (let [[n next-s] (allocate s)] (recur next-s (inc i)))))]\n                   [(= a b) (:counter s)])]\n               library-opts lane 1000000)))))\n  (is (= :yin.k/error (first (run-library '[(gensym \"fresh\")])))))\n\n\n(deftest test-portable-try-outcomes\n  (doseq [lane [:walker :semantic]\n          [form expected]\n          [['(try :ok (catch Exception e :bad)) :ok]\n           ['(try (throw (ex-info \"failure\" {:extra 7}))\n                  (catch Exception e [(.getMessage e) (ex-data e)])) [\"failure\" {:extra 7}]]\n           ['(try (try (throw (ex-info \"inner\" {}))\n                       (catch Exception e (throw (ex-info \"outer\" (ex-data e)))))\n                  (catch Exception e (.getMessage e))) \"outer\"]\n           ['(let [v (try (+ 1 (throw (ex-info \"early\" {})))\n                          (catch Exception e 8))] (inc v)) 9]]]\n    (is (= [:yin.k/ok expected] (run-library [form] library-opts lane 1000000))))\n  (doseq [form '[(try 1 (catch Exception e 2) :ignored)\n                 (try 1 (catch Throwable e 2))\n                 (try 1 (catch Exception e (.getStackTrace e)))]]\n    (is (thrown? clojure.lang.ExceptionInfo\n          (yang/compile-program [form] true library-opts))))\n  ;; `finally` is now expressible (the one-catch/no-finally restriction is\n  ;; lifted): a try with only a finally runs it on normal exit.\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok 1]\n           (run-library '[(try 1 (finally 2))] library-opts lane 1000000)))))\n\n\n(deftest test-guest-callable-collections-and-threading\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok ['b 2 :absent :k nil 3 {:n 3}]]\n           (run-library\n             '[(let [v '[a b] m {:k 2} s #{:k} k :n]\n                 [(v 1) (m :k) (m :missing :absent) (s :k) (s :missing)\n                  (k {:n 3}) (-> {:n 1} (update :n + 2))])]\n             library-opts lane 1000000))))\n  (is (= [:yin.k/ok :caught]\n         (run-library '[(try (let [v [1]] (v)) (catch Exception e :caught))]))))\n\n\n(deftest test-value-invocation-refusals-are-terminating\n  (testing \"entry-absent callees refuse through the library invoker instead of\n            re-entering the dispatcher; the vector binder only forces the\n            invoker into the library so the routing is actually exercised\"\n    (doseq [lane [:walker :semantic]]\n      ;; (A): the invoker's source-thrown refusal map is an ordinary\n      ;; payload at this harness boundary (a public entry rebuilds the\n      ;; `:yang.call/thrown` wire condition from it).\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(let [five 5 v [five]] (five 1))]\n                          library-opts lane 1000000))\n          \"a scalar callee terminates as not-callable\")\n      (let [[tag _] (run-library\n                      '[(defn f\n                          [x]\n                          x)\n                        (let [e yang.call/entry v [e]] (e f))]\n                      library-opts lane 1000000)]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/core/prelude_admission.cljc\ncat src/cljc/yang/rt/int.cljc\nsed -n '70,165p' src/cljc/yin/vm/engine.cljc\nrg -n 'resolve-module|register-integer-module' src/cljc/yin/vm/{module,integer}.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/core/prelude_admission.cljc\ncat src/cljc/yang/rt/int.cljc\nsed -n '70,165p' src/cljc/yin/vm/engine.cljc\nrg -n 'resolve-module|register-integer-module' src/cljc/yin/vm/{module,integer}.cljc\"","aggregated_output":"(ns yang.core.prelude-admission\n  \"Constructs declarations/specifications and checks registries; does not publish, link, or execute.\"\n  (:require [clojure.set :as set]\n            [clojure.string :as string]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n\n(defn- refusal\n  [refusal-ns kind data]\n  (merge {(keyword refusal-ns \"refusal\") (keyword refusal-ns kind)} data))\n\n\n(defn host-declaration\n  \"`[n declaration]` for free name `n`: a primitive by its `vm/primitives`\n   profile, a host export `ns/name` by the profile address the registry's\n   host module `ns` publishes and its `:callable-effects` effect set; nil\n   when neither supplies it.\"\n  [registry n]\n  (if-let [profile (vm/profile-of vm/primitives n)]\n    [n profile]\n    (when-let [address (module/host-export-profile registry n)]\n      (let [entry (module/module-entry (:modules registry) (symbol (namespace n)))\n            f (get-in entry [:slice (symbol (name n))])]\n        [n {:yin.k/profile address,\n            :yin.k/effects (get (:callable-effects registry) f #{})}]))))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for module `module-name`.\n   `skip?` (n -> bool) marks free names a requirement already declares;\n   `requires` is the requirement map. A free name nothing supplies is\n   refused with `message` under `refusal-ns` before anything is published.\n   This namespace emits; it never publishes.\"\n  [{:keys [module-name ast exports requires free-names skip? registry message\n           refusal-ns]}]\n  {:name module-name,\n   :ast ast,\n   :exports exports,\n   :requires requires,\n   :primitives\n   (into {}\n         (keep (fn [n]\n                 (when-not (and skip? (skip? n))\n                   (or (host-declaration registry n)\n                       (throw (ex-info message\n                                       (refusal refusal-ns \"undeclared-free\"\n                                                {:name n})))))))\n         free-names)})\n\n\n(defn admit\n  \"Return `registry` when it supplies every one of `host-names`, else refuse\n   it before any program runs, naming each missing export in\n   `:<refusal-ns>/missing`.\"\n  [registry host-names message refusal-ns]\n  (let [missing (vec (sort-by str\n                              (remove #(some? (module/resolve-module\n                                                registry\n                                                (symbol (str (namespace %)\n                                                             \".\"\n                                                             (name %)))))\n                                      host-names)))]\n    (when (seq missing)\n      (throw (ex-info message\n                      (refusal refusal-ns \"host-names\"\n                               {(keyword refusal-ns \"missing\") missing}))))\n    registry))\n\n\n\n\n(defn- reject-profile [kind data]\n  (throw (ex-info \"Prelude profile refused\" (assoc data :yang.prelude/refusal kind))))\n\n\n(defn- portable-data? [x]\n  (cond\n    (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n        (number? x) (char? x)) true\n    (record? x) false\n    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\n    (or (vector? x) (set? x)) (every? portable-data? x)\n    :else false))\n\n\n(defn- module-definitions\n  \"Collect definitions in evaluated expressions, including immediately invoked\n   lambda bodies, without descending into literals or function values.\"\n  [ast]\n  (loop [todo [ast] defs []]\n    (if-let [node (peek todo)]\n      (let [todo (pop todo)]\n        (case (:type node)\n          :application\n          (let [op (:operator node)\n                definition? (and (= :variable (:type op)) (= 'yin/def (:name op)))\n                todo (into todo (:operands node))\n                todo (conj todo (if (= :lambda (:type op)) (:body op) op))]\n            (recur todo (if definition? (conj defs (get-in node [:operands 0 :value])) defs)))\n          :if (recur (into todo [(:test node) (:consequent node) (:alternate node)]) defs)\n          (recur todo defs)))\n      defs)))\n\n\n(defn- profile-closure [profile store registry]\n  (let [required #{:yang.prelude/schema :yang.prelude/id :yang.prelude/revision\n                   :yang.prelude/module :yang.prelude/root-address\n                   :yang.prelude/components :yang.prelude/host-modules\n                   :yang.prelude/max-effects}\n        components (:yang.prelude/components profile)]\n    (when-not (and (map? profile) (portable-data? profile) (= required (set (keys profile)))\n                   (= 1 (:yang.prelude/schema profile))\n                   (keyword? (:yang.prelude/id profile))\n                   (string? (:yang.prelude/revision profile))\n                   (symbol? (:yang.prelude/module profile))\n                   (some? (:yang.prelude/root-address profile))\n                   (vector? components)\n                   (every? #(and (vector? %) (= 2 (count %))\n                                 (symbol? (first %)) (some? (second %))) components)\n                   (map? (:yang.prelude/host-modules profile))\n                   (every? (fn [[host spec]]\n                             (and (keyword? host) (map? spec)\n                                  (boolean? (:required spec))\n                                  (set/subset? (set (keys spec))\n                                               #{:required :min-bits :min-digits :min-max-items})\n                                  (every? (fn [[k v]]\n                                            (or (= k :required)\n                                                (and (integer? v) (not (neg? v))))) spec)))\n                           (:yang.prelude/host-modules profile))\n                   (or (nil? (:yang.prelude/max-effects profile))\n                       (set? (:yang.prelude/max-effects profile)))\n                   (map? store))\n      (reject-profile :schema {}))\n    (when-not (= (count components) (count (set (map first components))))\n      (reject-profile :duplicate-binding {}))\n    (loop [todo [[:enter (:yang.prelude/module profile) (:yang.prelude/root-address profile)]]\n           active #{} bindings {} manifests []]\n      (if-let [[op name addr] (peek todo)]\n        (let [todo (pop todo)]\n          (if (= op :leave)\n            (recur todo (disj active addr) bindings manifests)\n            (do\n              (when (contains? active addr)\n                (reject-profile :cycle {:address addr}))\n              (when (and (contains? bindings name) (not= (get bindings name) addr))\n                (reject-profile :duplicate-binding {:module name}))\n              (if (contains? bindings name)\n                (recur todo active bindings manifests)\n                (let [m (get store addr) tree (get store (:yin.module/tree m))]\n                  (when-not (map? m) (reject-profile :missing-manifest {:address addr}))\n                  (when-not (and (= name (:yin.module/name m))\n                                 (map? (:yin.module/requires m))\n                                 (set? (:yin.module/exports m))\n                                 (every? symbol? (:yin.module/exports m))\n                                 (every? symbol? (keys (:yin.module/requires m)))\n                                 (every? symbol? (keys (:yin.module/primitives m)))\n                                 (map? (:yin.module/primitives m))\n                                 (set? (get-in m [:yin.module/footprint :effects]))\n                                 (map? tree)\n                                 (or (not (contains? tree :root))\n                                     (= (:yin.module/tree m) (:root tree))))\n                    (reject-profile :artifact {:module name}))\n                  (when (and (= addr (:yang.prelude/root-address profile))\n                             (not= (into {} components) (:yin.module/requires m)))\n                    (reject-profile :root-pins {:module name}))\n                  ;; Ambient projection aliases require a descriptor, absent here;\n                  ;; validate-descriptor checks those collisions in P3-prime.\n                  (let [ast (if (and (:root tree) (:rows tree))\n                              (vm/semantic-bytecode->ast tree) tree)\n                        defs (module-definitions ast)]\n                    (when-not (and (= :application (:type ast))\n                                   (= (count defs) (count (set defs))))\n                      (reject-profile :export-collision {:module name})))\n                  (when (some #(string/starts-with? (clojure.core/name %) \"dsg__\")\n                              (:yin.module/exports m))\n                    (reject-profile :provenance-export {:module name}))\n                  (when (and (not= addr (get-in registry [:trusted-prelude-modules name]))\n                             (some #(contains? (:yin.module/primitives m) %)\n                                   ['cell/dsg__new-provenance 'cell/dsg__provenance]))\n                    (reject-profile :provenance-primitive {:module name}))\n                  (recur (into (conj todo [:leave name addr])\n                               (map (fn [[n a]] [:enter n a]) (:yin.module/requires m)))\n                         (conj active addr) (assoc bindings name addr) (conj manifests m)))))))\n        manifests))))\n\n\n(defn validate-profile\n  \"Validate a profile against an immutable map of verified manifests and trees.\n   Ambient projections belong to a semantics descriptor, which this API does\n   not receive; their aliases must also be checked at descriptor admission.\n   Trusted runtime identities are pinned by `:trusted-prelude-modules` in\n   the registry, as module symbol to manifest address. Returns the profile,\n   or throws a refusal before any linking or execution.\"\n  [profile artifact-store registry]\n  (let [manifests (profile-closure profile artifact-store registry)\n        effects (reduce set/union #{} (map #(get-in % [:yin.module/footprint :effects]) manifests))\n        ceiling (:yang.prelude/max-effects profile)]\n    (when (and ceiling (not (set/subset? effects ceiling)))\n      (reject-profile :effects {:effects effects :max-effects ceiling}))\n    profile))\n\n\n(defn admit-profile\n  \"Validate the closure, required host exports, and declared numeric floors.\"\n  [profile artifact-store registry host-limits]\n  (validate-profile profile artifact-store registry)\n  (let [manifests (profile-closure profile artifact-store registry)\n        hosts (:yang.prelude/host-modules profile)\n        names (into #{} (comp (mapcat #(keys (:yin.module/primitives %)))\n                              (filter #(and (namespace %) (not (vm/profile-of vm/primitives %)))))\n                    manifests)]\n    (doseq [n names]\n      (when-not (true? (get-in hosts [(keyword (namespace n)) :required]))\n        (reject-profile :host-module {:name n})))\n    (doseq [[host spec] hosts]\n      (when-not (and (map? spec) (boolean? (:required spec)))\n        (reject-profile :schema {:host host}))\n      (when (:required spec)\n        (when-not (module/module-entry (:modules registry) (symbol (name host)))\n          (reject-profile :host-module {:host host})))\n      (doseq [floor [:min-bits :min-digits :min-max-items]\n              :when (contains? spec floor)]\n        (let [minimum (get spec floor) actual (get-in host-limits [host (keyword (subs (name floor) 4))])]\n          (when-not (and (integer? minimum) (not (neg? minimum)) (number? actual) (<= minimum actual))\n            (reject-profile :host-limits {:host host :floor floor})))))\n    (admit registry names \"Prelude host export missing\" \"yang.prelude\")\n    registry))\n(ns yang.rt.int\n  \"Guest adapters for exact-integer policy, wrapping, and radix scanning.\"\n  (:require [yang.core.prelude :as core]\n            [yang.core.prelude-admission :as prelude-admission]\n            [yang.core.uast :as u]\n            [yang.rt.effect :as effect]))\n\n\n(def module-name 'yrt.int)\n\n\n(def definitions\n  \"The ordered source for bundled and linked emission.\"\n  '[[yrt.int/check-limit-with\n     (fn [res on-bit on-digit on-float]\n       (if (= res :yin.vm.integer/bit-limit)\n         (on-bit res)\n         (if (= res :yin.vm.integer/digit-limit)\n           (on-digit res)\n           (if (= res :yin.vm.integer/float-overflow)\n             (on-float res)\n             res))))]\n    [yrt.int/_unhandled\n     (fn [tag payload] (:yrt.int/unhandled-policy tag payload))]\n    [yrt.int/check-limit\n     (fn [ctx-cell res]\n       (if (= res :yin.vm.integer/bit-limit)\n         (yrt.effect/perform ctx-cell :int/bit-limit res yrt.int/_unhandled)\n         (if (= res :yin.vm.integer/digit-limit)\n           (yrt.effect/perform ctx-cell :int/digit-limit res yrt.int/_unhandled)\n           (if (= res :yin.vm.integer/float-overflow)\n             (yrt.effect/perform ctx-cell :math/overflow res yrt.int/_unhandled)\n             res))))]\n    [yrt.int/wrap-unsigned\n     (fn [x width-pow2 mask]\n       (if (= mask nil)\n         (let [qr (integer/floor-div-mod x width-pow2)]\n           (if (= qr :yin.vm.integer/bit-limit) qr (data/nth qr 1)))\n         (integer/bit-and x mask)))]\n    [yrt.int/wrap-signed\n     (fn [x half-range range]\n       (let [r (yrt.int/wrap-unsigned x range nil)]\n         (if (= r :yin.vm.integer/bit-limit)\n           r\n           (if (<= 0 (integer/compare r half-range)) (integer/sub r range) r))))]\n    [yrt.int/in-range?\n     (fn [x min-v max-v]\n       (if (<= 0 (integer/compare x min-v))\n         (<= (integer/compare x max-v) 0)\n         false))]\n    [yrt.int/digit-value\n     (fn [cp]\n       (if (if (<= 48 cp) (<= cp 57) false)\n         (- cp 48)\n         (if (if (<= 65 cp) (<= cp 90) false)\n           (- cp 55)\n           (if (if (<= 97 cp) (<= cp 122) false)\n             (- cp 87)\n             -1))))]\n    [yrt.int/_digit?\n     (fn [d radix] (if (<= 0 d) (< d radix) false))]\n    [yrt.int/all-digits?\n     (fn [cs i n radix]\n       (if (< i n)\n         (if (yrt.int/_digit? (yrt.int/digit-value (data/nth cs i)) radix)\n           (yrt.int/all-digits? cs (+ i 1) n radix)\n           false)\n         true))]\n    [yrt.int/scan-digits\n     ;; Accumulate the valid prefix and propagate a limit before using its\n     ;; keyword as an integer operand.\n     (fn [cs i n radix acc]\n       (if (= acc :yin.vm.integer/bit-limit)\n         acc\n         (if (< i n)\n           (let [d (yrt.int/digit-value (data/nth cs i))]\n             (if (yrt.int/_digit? d radix)\n               (let [scaled (integer/mul acc radix)]\n                 (if (= scaled :yin.vm.integer/bit-limit)\n                   scaled\n                   (yrt.int/scan-digits cs (+ i 1) n radix (integer/add scaled d))))\n               acc))\n           acc)))]\n    [yrt.int/skip-while\n     (fn [cs i n pred?]\n       (if (< i n)\n         (if (pred? (data/nth cs i))\n           (yrt.int/skip-while cs (+ i 1) n pred?)\n           i)\n         i))]\n    [yrt.int/skip-zeros\n     (fn [cs i n] (yrt.int/skip-while cs i n (fn [cp] (= cp 48))))]])\n\n\n(def module-exports\n  '#{check-limit check-limit-with wrap-unsigned wrap-signed in-range?\n     digit-value all-digits? scan-digits skip-while skip-zeros})\n\n\n(def uast\n  (u/mark-tails (core/definitions->uast definitions)))\n\n\n(def module-uast\n  (u/annotate-call-sites\n    (core/module-tree (core/module-definitions \"yrt.int\" nil [] definitions)\n                      (mapv u/sexp->uast '[(require 'yrt.effect)]))))\n\n\n(def ^:private module-free-names (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  [registry effect-address]\n  (prelude-admission/module-spec\n    {:module-name module-name\n     :ast module-uast\n     :exports module-exports\n     :requires {effect/module-name effect-address}\n     :skip? #(= \"yrt.effect\" (namespace %))\n     :free-names module-free-names\n     :registry registry\n     :message \"the yrt.int module reads an undeclared name\"\n     :refusal-ns \"yrt.int\"}))\n;;\n;;   :not-applicable      the operator is neither a host function, a\n;;                        closure nor a continuation; carries a coarse\n;;                        `:kind`, never the value\n;;   :foreign-value       a closure or continuation another task minted;\n;;                        carries `:kind :closure` or `:continuation`\n;;   :foreign-format      a continuation of another kernel format or image\n;;   :continuation-arity  a continuation applied to other than one argument\n\n(defn operator-kind\n  \"Classify the operator `f` a kernel of `state` is about to apply:\n   `:host-fn`, `:closure` or `:continuation`. A closure or continuation\n   must be owned by this task (`:owner`); anything else is refused. The\n   one classifier every kernel's application calls.\"\n  [state f]\n  (cond (fn? f) :host-fn\n        (values/host-typed? f)\n        (if (values/owned-by? f (:owner state))\n          (if (values/closure? f) :closure :continuation)\n          (fail \"Cannot apply a value of another task\"\n                {:reason :foreign-value, :kind (values/kind-of f)}))\n        :else (fail \"Cannot apply non-function\"\n                    {:reason :not-applicable, :kind (values/kind-of f)})))\n\n\n(defn marker-mismatch!\n  \"Refuse to lower closure `marker` whose binders (a named kernel's\n   `:yin.k/params`, a positional kernel's `:yin.k/arity`) are not those of\n   the attached lambda it names: a lower mints an applicable closure, so\n   the wire never chooses what a closure binds.\"\n  [marker]\n  (fail \"Closure marker disagrees with its attached lambda\"\n        {:reason :marker-mismatch, :segment (:yin.k/segment marker)}))\n\n\n(defn continuation-argument\n  \"The one value a captured continuation is applied to. Applying a\n   continuation is abortive: the current continuation is discarded and\n   the argument becomes the value of the capture point. Every VM refuses\n   any other arity with this same message.\"\n  [args]\n  (when-not (= 1 (count args))\n    (throw (ex-info \"Continuation expects exactly one argument\"\n                    {:reason :continuation-arity, :argc (count args)})))\n  (first args))\n\n\n(def ^:private compiler-primitives\n  '{dsg__primitive/get get, dsg__primitive/assoc assoc\n    dsg__primitive/+ +, dsg__primitive/- -, dsg__primitive/< <, dsg__primitive/<= <=\n    dsg__primitive/= =, dsg__primitive/not not, dsg__primitive/nil? nil?\n    dsg__primitive/empty? empty?, dsg__primitive/first first, dsg__primitive/rest rest\n    dsg__primitive/conj conj, dsg__primitive/vec vec})\n\n\n(defn resolve-var\n  \"Look up a variable name: env -> store -> primitives -> module registry.\n\n   A reserved name (Rule R: yin/def is syntax, never a name) is refused\n   before env or store is consulted. Compiler-private primitive aliases\n   resolve directly to their primitive entries so a portable guest closure\n   can call one after an ordinary guest definition shadows its bare name.\"\n  [env store primitives registry name]\n  (when (vm/reserved-name? name)\n    (vm/refuse-reserved! :variable name))\n  (if-let [primitive (get compiler-primitives name)]\n    (vm/primitive-function (get primitives primitive))\n    (if-let [pair (find env name)]\n      (val pair)\n      (if-let [pair (find store name)]\n        (val pair)\n        (if-let [pair (find primitives name)]\n          (vm/primitive-function (val pair))\n          (if-let [resolved (when (namespace name)\n                              (module/resolve-module\n                                registry\n                                (symbol (str (namespace name)\n                                             \".\"\n                                             (clojure.core/name name)))))]\n            resolved\n            (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n                  {:symbol name})))))))\n\n\n(defn check-store-key!\n  \"Refuse a program store access whose key is a reserved name (Rule R):\n   the definition operator is never a store key.\"\n  [key]\n  (when (vm/reserved-name? key)\n    (vm/refuse-reserved! :store-key key)))\n\n\n(defn store-put\n  \"The one program store write: every definition transition, the\n   `:vm/store-put` effect, and the four direct store instructions write\n   through here, and a reserved key is refused. Every other store write\nsrc/cljc/yin/vm/module.cljc:149:(defn resolve-module\nsrc/cljc/yin/vm/module.cljc:151:   (resolve-module r 'io)                    → the 'io registry entry\nsrc/cljc/yin/vm/module.cljc:152:   (resolve-module r 'io.file-output-stream) → the specific export\"\nsrc/cljc/yin/vm/module.cljc:637:      (some? (resolve-module (:modules state) module-name))\nsrc/cljc/yin/vm/integer.cljc:9:   `register-integer-module`, and Yin source reaches the exports as\nsrc/cljc/yin/vm/integer.cljc:112:  \"The module `register-integer-module` installs.\"\nsrc/cljc/yin/vm/integer.cljc:699:(defn register-integer-module\n","exit_code":0,"status":"completed"}}
