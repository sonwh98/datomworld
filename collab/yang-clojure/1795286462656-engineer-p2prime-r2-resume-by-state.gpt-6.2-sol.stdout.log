ms))\n   337\t                               (list 'let\n   338\t                                     (into [] (mapcat (fn [p i] [p (list 'data/nth 'args i)])\n   339\t                                                       params (range)))\n   340\t                                     body)\n   341\t                               otherwise))\n   342\t                       (arity-error name) (reverse arities))))])\n   343\t\n   344\t\n   345\t(defn- bounded-body [name max-arity form]\n   346\t  [name (list 'fn '[args] (list 'let '[n (data/count args)]\n   347\t                               (list 'if (list '<= 'n max-arity) form (arity-error name))))])\n   348\t\n   349\t\n   350\t(def ^:private entries\n   351\t  (into (mapv operation-body operations)\n   352\t        [(bounded-body 'str 6 '(impl-str-at args 0 n \"\"))\n   353\t         (bounded-body 'list 6 '(impl-list-from args))\n   354\t         (bounded-body 'vector 6 'args)\n   355\t         (bounded-body 'concat 4 '(impl-list-from (impl-fold-at impl-append args 0 n [])))\n   356\t         (bounded-body 'union 6 '(impl-fold-at impl-into args 0 n #{}))\n   357\t         (bounded-body 'merge 4 '(impl-fold-at impl-merge-two args 0 n nil))\n   358\t         (operation-body\n   359\t           '[comp ([] (clj/make-callable {:clj/type :function}\n   360\t                        (fn [args tail]\n   361\t                          (if (= 1 (data/count args)) (data/nth args 0)\n   362\t                            (clj/raise (assoc {:yin.vm.data/reason :arity :yin.k/fn identity}\n   363\t                                              :yin.k/argc (data/count args))))))))\n   364\t                  ([f] f)\n   365\t                  ([f g] (impl-comp-two f g))\n   366\t                  ([f g h] (impl-comp-two f (impl-comp-two g h)))])\n   367\t         ['assoc '(fn [args]\n   368\t                    (let [n (data/count args)]\n   369\t                      (if (if (<= 3 n) (= 1 (data/nth (integer/quot-rem n 2) 1)) false)\n   370\t                        (impl-assoc-more (data/nth args 0) args 1 n)\n   371\t                        (clj/raise (assoc {:yin.vm.data/reason :arity :yin.k/fn assoc} :yin.k/argc n)))))]\n   372\t         ['conj '(fn [args]\n   373\t                   (let [n (data/count args)]\n   374\t                     (if (< 0 n)\n   375\t                       (impl-conj-more (data/nth args 0) args 1 n)\n   376\t                       (clj/raise (assoc {:yin.vm.data/reason :arity :yin.k/fn conj} :yin.k/argc n)))))]]))\n   377\t\n   378\t\n   379\t(defn callable-entry [name]\n   380\t  (symbol (str module-name) (str \"impl-\" name)))\n   381\t\n   382\t\n   383\t(def public-names (mapv first entries))\n   384\t\n   385\t\n   386\t(def ^:private definitions\n   387\t  (let [qualify (into {} (map (fn [[name _]] [name (symbol (str module-name) (str \"impl-op-\" (subs (str name) 5)))])) helpers)]\n   388\t    (into (mapv (fn [[name form]] [(get qualify name) (walk/postwalk-replace qualify form)]) helpers)\n   389\t          (map (fn [[name form]] [(callable-entry name)\n   390\t                                 (walk/postwalk-replace qualify form)]))\n   391\t          entries)))\n   392\t\n   393\t\n   394\t\n   395\t(def module-exports\n   396\t  (into '#{impl-op-get-default impl-op-nth} (map (comp #(symbol (name %)) callable-entry)) public-names))\n   397\t\n   398\t\n   399\t(def uast\n   400\t  (let [primitives '#{get assoc + - < <= = not nil? empty? first rest conj vec}]\n   401\t    (u/mark-tails\n   402\t      (walk/postwalk\n   403\t        (fn [node]\n   404\t          (if (and (map? node) (= :variable (:type node)) (contains? primitives (:name node)))\n   405\t            (update node :name #(symbol \"dsg__primitive\" (str %)))\n   406\t            node))\n   407\t        (core/balanced-definitions->uast definitions)))))\n   408\t\n   409\t\n   410\t(def module-uast\n   411\t  (u/annotate-call-sites\n   412\t    (core/module-tree (core/module-definitions (str module-name) nil [] definitions)\n   413\t                      (mapv u/sexp->uast\n   414\t                            '[(require 'yang.call) (require 'clj) (require 'yrt.int)]))))\n   415\t\n   416\t\n   417\t(def ^:private free-names (core/free-name-vec module-uast))\n   418\t\n   419\t\n   420\t(defn module-spec [registry call-address clj-address int-address]\n   421\t  (let [requires {call/module-name call-address clj/module-name clj-address\n   422\t                  int-rt/module-name int-address}]\n   423\t    (admission/module-spec\n   424\t      {:module-name module-name :ast module-uast :exports module-exports\n   425\t       :requires requires :free-names free-names\n   426\t       :skip? #(contains? requires (some-> % namespace symbol))\n   427\t       :registry registry :message \"clojure.core.impl reads an undeclared name\"\n   428\t       :refusal-ns \"yang.clojure\"})))\n                       (do (yrt.effect/abandon-to ctx-cell\n                             (yrt.effect/frame-depth (get saved :handlers)))\n                           (yrt.effect/restore! ctx-cell saved)\n                           (r v)))))\n              r))\n          (%capture))))]\n\n    [yrt.effect/handle\n     (fn [ctx-cell tag handler-fn body]\n       (let [saved (cell/get ctx-cell)\n             first? (cell/new true)]\n         ((fn [outer-k]\n            (if (cell/get first?)\n              (do (cell/set! first? false)\n                  (yrt.effect/set-handlers!\n                    ctx-cell (yrt.effect/frame :effect (conj [] tag handler-fn outer-k)\n                                               (get saved :handlers) (get saved :depth)))\n                  (let [v (body)] (do (yrt.effect/restore! ctx-cell saved) v)))\n              ;; perform transfers a thunk here so the handler runs in the\n              ;; exact context outside the matched delimiter.\n              (do (yrt.effect/restore! ctx-cell saved) (outer-k))))\n          (%capture))))]\n    [yrt.effect/_find-effect\n     (fn [hs tag]\n       (if (= hs nil)\n         nil\n         (if (if (= (data/nth hs 0) :effect)\n               (= (data/nth (data/nth hs 1) 0) tag)\n               false)\n           hs\n           (yrt.effect/_find-effect (data/nth hs 2) tag))))]\n    [yrt.effect/_dispatch\n     (fn [ctx-cell hs payload]\n       (let [saved (cell/get ctx-cell)\n             h (data/nth hs 1)\n             handler (data/nth h 1)\n             outer-k (data/nth h 2)\n             pending? (cell/new true)]\n         ((fn [k]\n            (if (cell/get pending?)\n              (outer-k\n                (fn []\n                  ;; The guard also runs if the handler raises or escapes.\n                  ;; Resuming bypasses it and reinstates the suspended frames.\n                  (let [outside (cell/get ctx-cell)]\n                    (yrt.effect/try-finally\n                      ctx-cell\n                      (fn []\n                        (handler payload\n                          (fn [v]\n                            (if (cell/get pending?)\n                              (do (cell/set! pending? false)\n                                  (yrt.effect/restore! ctx-cell saved)\n                                  (k v))\n                              (:yrt.effect/used-resumption v)))))\n                      (fn [e]\n                        (do (cell/set! pending? false)\n                            (yrt.effect/restore! ctx-cell saved)\n                            (yrt.effect/unwind-to ctx-cell\n                              (yrt.effect/frame-depth (get outside :handlers)) e)\n                            (yrt.effect/restore! ctx-cell outside)))\n                      nil))))\n              k))\n          (%capture))))]\n    [yrt.effect/perform\n     (fn [ctx-cell tag payload on-unhandled]\n       (let [hs (yrt.effect/_find-effect (yrt.effect/handlers ctx-cell) tag)]\n         (if (= hs nil)\n           (on-unhandled tag payload)\n           (yrt.effect/_dispatch ctx-cell hs payload))))]])\n\n\n(def module-exports\n  '#{ctx handlers set-handlers! restore! frame-depth frame pop-frame raise\n     try-value try-orelse try-finally unwind-to call-ec abandon-to call-terminal\n     handle perform})\n\n\n(def uast\n  (u/mark-tails (core/definitions->uast definitions)))\n\n\n(def module-uast\n  [x]\n  (or (number? x) (integer-host/big-carrier? x)))\n\n\n;; =============================================================================\n;; Floats: the seam between addressed float content and host arithmetic\n;; =============================================================================\n\n(defn float-value\n  \"The host double of number or float64 content `x`, for host arithmetic:\n   what the literal `1.0` is on each host, a double on the JVM and Dart, a\n   Number on JS. A prelude unwraps a float with this, computes on bare\n   numbers, and wraps the result back with `float64`.\"\n  [x]\n  (when-not (or (data-number? x) (cbor/float64? x))\n    (wrong-type! 'float-value 0 :number))\n  #?(:cljd (if (dart/is? x BigInt) (.toDouble ^BigInt x) (.toDouble ^num x))\n     :clj (double x)\n     :cljs (cond (number? x) x\n                 (cbor/float64? x) (.-v ^not-native x)\n                 :else (js/Number x))))\n\n\n(defn float64\n  \"Float content with the value of number `x`: Jing's float64, the form a\n   float keeps in any value that can reach an addressed row or image (a\n   double on the JVM and Dart, the float64 carrier on JS, where a bare\n   integral Number is an integer; dao.jing.cbor.md, Numeric identity). The\n   producer carries float kind; the codec never infers it.\"\n  [x]\n  (cbor/float64 (float-value x)))\n\n\n(defn- callable?\n  \"True when `x` can be applied: a host function, a closure or a\n   continuation. A map is never callable, whatever keys it carries.\"\n  [x]\n  (or (fn? x) (values/closure? x) (values/continuation? x)))\n\n\n(defn- data-map?\n  [x]\n  (map? x))\n\n\n(defn- data-vector?\n  [x]\n  (vector? x))\n\n\n(defn- data-string?\n  [x]\n  (string? x))\n\n\n(defn- ref?\n  \"True when `x` is a stream, cursor or cell reference.\"\n  [x]\n  (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x))))\n\n\n(defn- data-content=\n  \"True when `a` and `b` have one identity under content addressing:\n   Jing's kind-strict content equality, so every NaN is one value, 0.0 is\n   not -0.0, 1 is not 1.0, and collections recurse. A callable or a\n   reference compares by host `=`, so content addressing never walks it.\"\n  [a b]\n  (or (identical? a b)\n      (if (or (callable? a) (callable? b) (ref? a) (ref? b))\n        (= a b)\n        (cbor/content= a b))))\n\n\n(defn- identifier-equal? [a b]\n  (and (= (namespace a) (namespace b)) (= (name a) (name b))))\n\n(declare data-equiv)\n\n(defn- matching? [xs ys match?]\n  (and (= (count xs) (count ys))\n       (loop [xs (seq xs), ys (vec ys)]\n         (if-not xs\n           true\n           (if-let [i (first (keep-indexed #(when (match? (first xs) %2) %1) ys))]\n             (recur (next xs) (into (subvec ys 0 i) (subvec ys (inc i))))\n             false)))))\n\n(defn- data-equiv [a b]\n  (cond\n    (or (ref? a) (ref? b) (callable? a) (callable? b)) (= a b)\n    (or (cbor/float64? a) (cbor/float64? b))\n    (and (cbor/float64? a) (cbor/float64? b)\n         (let [x (float-value a), y (float-value b)]\n           (and (not (integer-host/nan-float? x))\n                (not (integer-host/nan-float? y)) (== x y))))\n    (or (integer-host/exact-integer? a) (integer-host/exact-integer? b))\n    (and (integer-host/exact-integer? a) (integer-host/exact-integer? b)\n         (zero? (integer-host/compare-big (integer-host/promote a) (integer-host/promote b))))\n    (or (keyword? a) (keyword? b))\n    (and (keyword? a) (keyword? b) (identifier-equal? a b))\n    (or (symbol? a) (symbol? b))\n    (and (symbol? a) (symbol? b) (identifier-equal? a b))\n    (or (sequential? a) (sequential? b))\n    (and (sequential? a) (sequential? b) (= (count a) (count b))\n         (every? true? (map data-equiv a b)))\n    (or (map? a) (map? b))\n    (and (map? a) (map? b)\n         (matching? a b (fn [[ka va] [kb vb]]\n                          (and (data-equiv ka kb) (data-equiv va vb)))))\n    (or (set? a) (set? b))\n    (and (set? a) (set? b) (matching? a b data-equiv))\n\n(defn- normalize-key\n  \"Canonicalize integer carriers throughout an admitted key. Apply at both\n   insertion and lookup; other key equality remains host equality.\"\n  [x]\n  (when-not (admit-key? x)\n    (wrong-type! 'normalize-key 0 :admitted-key))\n  (key/normalize x))\n\n\n(defn- canonical-compare [a b]\n  (let [a (cbor/encode a), b (cbor/encode b), n (min (bytes/length a) (bytes/length b))]\n    (loop [i 0]\n      (if (= i n)\n        (compare (bytes/length a) (bytes/length b))\n        (let [c (compare (bytes/get a i) (bytes/get b i))]\n          (if (zero? c) (recur (inc i)) c))))))\n\n(defn- canonical-entries [coll]\n  (cond\n    (map? coll) (vec (sort (fn [[a _] [b _]] (canonical-compare a b)) coll))\n    (set? coll) (vec (sort canonical-compare coll))\n    :else (wrong-type! 'canonical-entries 0 :map-or-set)))\n\n\n;; =============================================================================\n;; The module\n;; =============================================================================\n\n(def ^:private exports\n  \"`[name arities f]` of every export. `:variadic` means the greatest\n   listed fixed arity extends to further arguments.\"\n  [['count [1] data-count]\n   ['nth [2] data-nth]\n   ['contains? [2] data-contains?]\n   ['dissoc [1 :variadic] data-dissoc]\n   ['disj [1 :variadic] data-disj]\n   ['peek [1] data-peek]\n   ['pop [1] data-pop]\n   ['subvec [2 3] data-subvec]\n   ['hash-set [0 :variadic] (fn [& xs] (into #{} (map key/normalize) xs))]\n   ['into [2] data-into]\n   ['str-concat [0 :variadic] str-concat]\n   ['str-length [1] str-length]\n   ['substring [2 3] substring]\n   ['str-index-of [2 3] str-index-of]\n   ['str-split [2] str-split]\n   ['str-join [2] str-join]\n   ['char-at [2] char-at]\n   ['str->code-points [1] str->code-points]\n   ['code-points->str [1] code-points->str]\n   ['str-compare [2] str-compare]\n   ['str-unit-length [1] str-unit-length]\n   ['str-unit-at [2] str-unit-at]\n   ['str-units [1] str-units]\n   ['units->str [1] units->str]\n   ['well-formed-utf16? [1] well-formed-utf16?]\n   ['number? [1] data-number?]\n   ['float64 [1] float64]\n   ['float-value [1] float-value]\n   ['content= [2] data-content=]\n   ['float64? [1] cbor/float64?]\n   ['equiv [2] data-equiv]\n   ['admit-key? [1] admit-key?]\n   ['normalize-key [1] normalize-key]\n   ['canonical-compare [2] canonical-compare]\n   ['canonical-entries [1] canonical-entries]\n   ['callable? [1] callable?]\n   ['map? [1] data-map?]\n   ['vector? [1] data-vector?]\n   ['string? [1] data-string?]])\n\n\n(defn- arity-checked\n  \"`f` refusing, as data, a call whose argument count `arities` does not\n   admit, so a wrong count never reaches a host arity exception.\"\n\n(def ^:private av-opts\n  {:convention :arg-vector, :native (set (keys vm/primitives))})\n\n\n(def ^:private av-modules\n  (data/register-data-module\n    (module/register-cell-module\n      (module/register-stream-module (module/default-registry)))))\n\n\n(defn- av-ast\n  ([forms] (av-ast forms av-opts))\n  ([forms opts] (yang/compile-program forms true opts)))\n\n\n(def ^:private outcome-modules\n  (let [host (fn [name entries]\n               (fn [registry]\n                 (module/register-host-module\n                   registry name\n                   (into {} (map (fn [[op f _]] [op f])) entries)\n                   (into {} (map (fn [[op _ p]] [op p])) entries))))]\n    (-> av-modules\n        ((host 'portable\n               [['nth\n                 (yang/outcome-adapter data/refusal-message (get data/data-module 'nth))\n                 (get data/data-profiles 'nth)]]))\n        ((host 'probe\n               [['note\n                 (fn [x] (swap! effect-log conj x) x)\n                 (vm/primitive-profile 'note :pure [1] #{} :none)]])))))\n\n\n(def ^:private outcome-opts\n  {:convention :arg-vector, :outcomes true\n   :native (set (keys vm/primitives))\n   :adapters {'data/nth 'portable/nth}})\n\n\n(defn- outcome-ast\n  [forms]\n(deftest test-common-call-cell-ref-map-invocation\n  (testing \"a full-shape data map with a 64-character seal is ordinary invocable data\"\n    ;; The map spells every key of an issued reference and the seal has the\n    ;; issued format; the call site asks the heap (cell/authentic?), the\n    ;; heap does not authenticate it, and the invocation is the map lookup,\n    ;; on both evaluators — the ruling of record replaces the r4 id-language\n    ;; gate: no id spelling is consulted, the issuer answers.\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :type))])))\n    (is (= [:yin.k/ok :some-key]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :id))]))))\n  (testing \"a runtime-built full-shape map (assoc, not a bound literal) invokes as data\"\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m (assoc (assoc (assoc {} :type :cell-ref)\n                                                :id :some-key)\n                                         :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")]\n                            (m :type))]))))\n  (testing \"a full-shape map that is data is not call-eligible\"\n    (is (= [:yin.k/ok false]\n           (run-library '[(yang.call/eligible? {:type :cell-ref :id :some-key\n                                                :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})]))))\n  (testing \"genuine references still dereference through admission\"\n    ;; A cell the engine minted (:cell-0), holding a descriptor with a\n    ;; callable entry: the call reaches the entry.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-probe (u/app (u/v 'cell/new)\n                                    (u/app (u/v 'assoc) (u/lit {})\n                                           (u/lit :yang.call/entry)\n                                           (u/lam ['invocation] (u/lit :called))))\n                             lane))\n          (str lane \" genuine live\"))))\n  (testing \"a genuine-but-dead reference keeps the standing refusal\"\n    ;; A genuine cell whose contents carry no call entry: admission answers\n    ;; false and the call refuses as not-callable — the behavior the D2 bar\n    ;; pins, unchanged by the data fallback.\n    (doseq [lane [:walker :semantic]]\n      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\n                                                     lane)]\n        (is (and (= :yin.k/error tag)\n                 (= :yang.call/not-callable (:yang.call/reason payload)))\n            (str lane \" genuine dead: \" (pr-str result))))))\n  (testing \"the gate's collision literal: an id inside the heap language answers as data\"\n    ;; The r4 reviewer's literal — a map whose :id is a :cell-N keyword and\n    ;; whose seal has the issued format but not the issued content. Under\n    ;; the ruling of record the call site asks the heap and routes by the\n    ;; answer, so the invocation is the map lookup and answers :cell-7,\n    ;; where r4's id-language gate still sent it to the dereference and the\n    ;; VM aborted it as dead-or-forged.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :cell-7]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (m :id))\n                 (probe marker-operand)]\n               (u/lit {:type :cell-ref :id :cell-7\n                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n               lane))\n          (str lane \" collision literal answers as data\"))))\n  (testing \"an exact copy of a genuine reference still resolves as a reference\"\n    ;; Rule 4, the bearer policy: authentication is by value — seal and id\n    ;; against the heap — with no construction-history promises, so a copy\n    ;; reconstructed field-for-field authenticates and its call reaches the\n    ;; cell's entry. Reading the fields uses explicit lookup at data\n    ;; positions (get), never a call of the reference.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (let [copy {:type (get m :type), :id (get m :id), :seal (get m :seal)}]\n                     (copy nil)))\n                 (probe marker-operand)]\n               (u/app (u/v 'cell/new)\n                      (u/app (u/v 'assoc) (u/lit {})\n                             (u/lit :yang.call/entry)\n                             (u/lam ['invocation] (u/lit :called))))\n               lane))\n          (str lane \" bearer copy resolves\"))))\n  (testing \"explicit dereference of a forged reference stays strict\"\n    ;; Astra rule 1: cell/get at a reference position keeps the existing\n    ;; validation boundary — the data fallback lives in call routing, not in\n    ;; the dereference itself.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (cell/get m))\n                 (probe marker-operand)]\n               (u/lit {:type :cell-ref :id :cell-7\n                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n               lane))\n          (str lane \" explicit deref refuses\")))))\n\n(deftest test-library-closes-over-its-own-names\n  (testing \"library-for returns the definitions a program mentions, transitively\"\n    (let [names (set (map second (yang/library-for '[(seq? x)])))]\n      (is (every? names '[seq? sequential? vector? map? set? coll?])\n          \"seq? pulls sequential?, vector?, map?, set? and coll?\")\n      (is (not (contains? names 'map))))\n    (is (= [] (yang/library-for '[(+ 1 2)])))\n    (is (= [] (yang/library-for '[(quote (map f xs))])) \"quoted data mentions nothing\")\n    (is (= [] (yang/library-for '[(defn map\n                                    [f c]\n                                    c) (map 1 2)]))\n        \"a program definition shadows the library's\")))\n\n\n(deftest test-library-kind-predicates\n  (testing \"collection predicates are derived from the data module's refusals\"\n    (is (= [true false false false false false]\n           (lib '[(vector? [1]) (vector? '(1)) (vector? {}) (vector? #{}) (vector? 1) (vector? nil)])))\n    (is (= [true false false false false]\n           (lib '[(map? {}) (map? [1]) (map? #{}) (map? nil) (map? \"s\")])))\n    (is (= [true false false]\n           (lib '[(set? #{1}) (set? [1]) (set? nil)])))\n    (is (= [true true true true false false false]\n           (lib '[(coll? []) (coll? '()) (coll? {}) (coll? #{}) (coll? nil) (coll? 1) (coll? \"s\")])))\n    (is (= [true false false false false]\n           (lib '[(seq? '(1 2)) (seq? []) (seq? {}) (seq? nil) (seq? 1)])))\n    (is (= [true true false false]\n           (lib '[(sequential? []) (sequential? '(1)) (sequential? {}) (sequential? 1)]))))\n  (testing \"boolean?, fn?, identity, not=, inc, dec\"\n    (is (= [true true false false] (lib '[(boolean? true) (boolean? false) (boolean? nil) (boolean? 0)])))\n    (is (= [true true false] (lib '[(fn? first) (fn? (fn [x] x)) (fn? 1)])))\n    (is (= [5 6 4 true false] (lib '[(identity 5) (inc 5) (dec 5) (not= 1 2) (not= 1 1)]))))\n  (testing \"symbol?, keyword?, name, symbol, keyword, str, int? are the kind module's\"\n    (is (= [true false true false] (lib '[(symbol? 'a) (symbol? :a) (keyword? :a) (keyword? 'a)])))\n    (is (= [\"a\" \"b\" 'a/b :k :a/b true false]\n           (lib '[(name 'a) (name :b) (symbol \"a\" \"b\") (keyword \"k\") (keyword \"a\" \"b\") (int? 1) (int? 1.5)])))\n    (is (= [\"\" \"a1:kx\" \"abcdef\"]\n           (lib '[(str) (str \"a\" 1 :k 'x) (str \"a\" \"b\" \"c\" \"d\" \"e\" \"f\")])))\n    (is (= ['G__5 'p7] (lib '[(gensym 5) (gensym \"p\" 7)]))\n        \"gensym takes its supply explicitly; there is no hidden counter\")))\n\ntest/yang/clojure_test.clj:478:  (testing \"initializers see earlier bindings; shadowing\"\ntest/yang/clojure_test.clj:736:  (testing \"a local shadows a native name\"\ntest/yang/clojure_test.clj:1298:(deftest test-common-call-shadowed-helpers\ntest/yang/clojure_test.clj:3150:  (testing \"local shadowing of a top-level defn preserves dynamic admission and routing\"\ntest/yang/clojure_test.clj:3169:                            (let [f {:k 9} v [f]] (f :k))]\n2:  \"Executable-address grants for the bundled Clojure provenance doors.\"\n7:(def ^:private marker :clj/bundled-runtime)\n9:(def ^:private trusted\n40:(defn mark-bundled-calls\n41:  \"Find bundled scopes in a loader-owned AST. Mark door application occurrences\n45:  (let [bundled? (volatile! false)]\n49:                    _ (when starts-scope? (vreset! bundled? true))\n52:                                      (= (:row trusted) (:root (vm/ast->semantic-bytecode node)))))\n68:          {:ast tree :bundled? @bundled?})\n146:    (let [{:keys [address calls]} (get trusted format)]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yin/vm/provenance_scope.cljc\nsed -n '3120,3195p;1895,1915p' test/yang/clojure_test.clj\nrg -n 'dsg__primitive|def primitives|def primitive-profiles|defn profile-of' src/cljc/yin/vm.cljc\nsed -n '1,145p' test/yang/typescript/antlr/linked_harness.cljc\nrg -n 'cc4-replay|rebake|regenerat|pinned-replay' test/yang/clojure_callsite_test.cljc test/yang/cc4_corpus.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yin/vm/provenance_scope.cljc\nsed -n '3120,3195p;1895,1915p' test/yang/clojure_test.clj\nrg -n 'dsg__primitive|def primitives|def primitive-profiles|defn profile-of' src/cljc/yin/vm.cljc\nsed -n '1,145p' test/yang/typescript/antlr/linked_harness.cljc\nrg -n 'cc4-replay|rebake|regenerat|pinned-replay' test/yang/clojure_callsite_test.cljc test/yang/cc4_corpus.clj\"","aggregated_output":"(ns yin.vm.provenance-scope\n  \"Executable-address grants for the bundled Clojure provenance doors.\"\n  (:require [dao.jing :as jing]\n            [yin.vm :as vm]))\n\n\n(def ^:private marker :clj/bundled-runtime)\n\n(def ^:private trusted\n  ;; The closed clj bundle's row address and its three executable projections.\n  ;; Each executable grant names an exact call in the normalized body graph.\n  {:row :segment/blake3-e03d4f18a55e2186cb59899e6c3c8f5512e2de02ee3565178ef81c9a70bbb3db\n   :semantic\n   {:address :segment/blake3-4133595e69de3dd4ff63c254699bfe56c3d7cb7fe3a38b9e8138b95b1566a31c\n    :calls [[256 :cell/provenance] [489 :cell/provenance]\n            [521 :cell/new-provenance] [692 :cell/provenance]]}\n   :stack\n   {:address :segment/blake3-7c04121ffc7828759de3e6e0f8948c962342e966aaab4b3b9b44b96aa534a50a\n    :calls [[391 :cell/provenance] [766 :cell/provenance]\n            [818 :cell/new-provenance] [1100 :cell/provenance]]}\n   :register\n   {:address :segment/blake3-08405b15735ef385073bdcd5cbb3fcef56f46f0b7100ec3db0c6045d277b3277\n    :calls [[256 :cell/provenance] [489 :cell/provenance]\n            [521 :cell/new-provenance] [692 :cell/provenance]]}})\n\n(def doors\n  {'cell/dsg__new-provenance :cell/new-provenance\n   'cell/dsg__provenance :cell/provenance})\n\n\n(defn- node-children [node]\n  (mapcat (fn [[key kind]]\n            (case kind\n              :node [(get node key)]\n              :nodes (get node key)\n              []))\n          (get vm/semantic-bytecode-grammar (:type node))))\n\n\n(defn mark-bundled-calls\n  \"Find bundled scopes in a loader-owned AST. Mark door application occurrences\n   only below the verified closed lambda. Metadata on incoming ASTs has no\n   authority: VM loaders reconstruct their nodes from datoms or rows.\"\n  [ast]\n  (let [bundled? (volatile! false)]\n    (letfn [(visit [node granted?]\n              (let [starts-scope? (and (= :lambda (:type node))\n                                       (= marker (get-in node [:body :operands 0 :value])))\n                    _ (when starts-scope? (vreset! bundled? true))\n                    granted? (or granted?\n                                 (and starts-scope?\n                                      (= (:row trusted) (:root (vm/ast->semantic-bytecode node)))))\n                    rebuilt (reduce (fn [n [key kind]]\n                                      (case kind\n                                        :node (update n key visit granted?)\n                                        :nodes (update n key #(mapv (fn [child]\n                                                                      (visit child granted?)) %))\n                                        n))\n                                    node\n                                    (get vm/semantic-bytecode-grammar (:type node)))]\n                (if-let [door (when (and granted? (= :application (:type node)))\n                                (get doors (get-in node [:operator :name])))]\n                  (vary-meta rebuilt assoc ::door door)\n                  rebuilt)))]\n      ;; Skip rebuilding legacy ASTs entirely.\n      (if (some #(= marker (:value %)) (tree-seq (comp seq node-children) node-children ast))\n        (let [tree (visit ast false)]\n          {:ast tree :bundled? @bundled?})\n        {:ast ast}))))\n\n\n(defn ast-door? [application door]\n  (= door (::door (meta application))))\n\n\n(def ^:private target-slots\n  ;; The three PC operands in the frozen executable formats.\n  {:semantic {:closure 3 :jump 1 :branch-false 2}\n   :stack {:closure 2 :jump 1 :branch-false 1}\n   :register {:closure 3 :jump 1 :branch-false 2}})\n\n\n(defn image-instructions\n  \"Project the selected positional image from the relocated instruction space.\"\n  [format instructions base size]\n  (let [slice (subvec instructions base (+ base size))\n        slots (get target-slots format)]\n    (if (zero? base)\n      slice\n      (mapv (fn [t]\n              (if-let [slot (get slots (first t))]\n                (update t slot - base)\n                t))\n            slice))))\n\n\n(defn bundle-graph\n  \"Derive a relocated bundle's stable code address and its instruction PCs.\n   The marker only identifies candidates. All bodies reachable by closure\n   creation participate in the address, with canonical relative targets.\"\n  [format instructions]\n  (let [slots (get target-slots format)\n        closure-target (:closure slots)\n        markers (keep-indexed (fn [pc t]\n                                (when (and (= :const (first t)) (= marker (peek t))) pc))\n                              instructions)]\n    (when (seq markers)\n      (let [starts (vec (sort (into #{0}\n                                   (keep #(when (= :closure (first %))\n                                            (nth % closure-target)))\n                                   instructions)))\n            ends (zipmap starts (concat (rest starts) [(count instructions)]))\n            graph (fn [entry]\n                    (loop [pending [entry], body-ids {entry 0}, i 0, pcs [], bodies []]\n                      (if-some [start (get pending i)]\n                        (let [end (get ends start)\n                              body-pcs (range start end)\n                              [pending body-ids body]\n                              (reduce\n                                (fn [[todo ids body] pc]\n                                  (let [t (nth instructions pc)\n                                        op (first t)]\n                                    (if (= op :closure)\n                                      (let [child (nth t closure-target)]\n                                        (if-some [id (get ids child)]\n                                          [todo ids (conj body (assoc t closure-target id))]\n                                          [(conj todo child) (assoc ids child (count todo))\n                                           (conj body (assoc t closure-target (count todo)))]))\n                                      [todo ids\n                                       (conj body\n                                             (if-let [slot (get slots op)]\n                                               (update t slot - start)\n                                               t))])))\n                                [pending body-ids []]\n                                body-pcs)]\n                          (recur pending body-ids (inc i) (into pcs body-pcs) (conj bodies body)))\n                        {:address (jing/segment-key bodies) :pcs pcs})))]\n        (mapv graph (distinct (map (fn [pc] (last (take-while #(<= % pc) starts)))\n                                   markers)))))))\n\n\n(defn code-grants\n  \"The private door granted at each executable call PC, if this is a clj bundle.\"\n  [format instructions]\n  (when-let [graphs (seq (bundle-graph format instructions))]\n    (let [{:keys [address calls]} (get trusted format)]\n      (into {}\n            (mapcat (fn [graph]\n                      (when (= address (:address graph))\n                        (map (fn [[i door]] [(nth (:pcs graph) i) door]) calls))))\n            graphs))))\n                 (defn invoke\n                   [f]\n                   (f))\n                 (try (invoke escape) (catch Exception e (cell/get ran)))]\n               (cell-entry-node {}) lane))))))\n\n\n(deftest test-outcome-safe-get\n  (let [forms '[(defn safe-get\n                  [coll key]\n                  (let [val (get coll key)]\n                    (if val val (throw (ex-info \"No such value in collection\" {:coll coll, :key key})))))]]\n    (is (= [:yin.k/ok 1] (run-outcome (conj forms '(safe-get {:a 1} :a)))))\n    (is (= [:yin.k/error {:yin.k/message \"No such value in collection\"\n                          :yin.k/data {:coll {:a 1}, :key :b}}]\n           (run-outcome (conj forms '(safe-get {:a 1} :b)))))))\n\n\n(deftest test-outcome-nested-call-operand\n  (let [defs '[(defn g\n                 [x]\n                                     (if (vm/halted? m)\n                                       [m k]\n                                       (recur (vm/step m) (inc k))))]\n          (is (= 62 (vm/value terminal)))\n          (is (= (- full-steps budget) rem-steps)\n              (str lane \": resuming carried consumer completes in exact remaining steps\")))))))\n\n\n(deftest test-intra-unit-call-lowering-guards-and-budget\n  (testing \"tight per-call step budget holds across non-tail and tail intra-unit calls\"\n    (let [forms '[(defn inc1\n                    [x]\n                    (+ x 1))\n                  (defn sum-calls\n                    [n acc]\n                    (if (= n 0)\n                      acc\n                      (sum-calls (- n 1) (inc1 acc))))\n                  (sum-calls 500 0)]\n          ast (yang/compile-program forms true outcome-opts)]\n      (doseq [lane [:walker :semantic]]\n        (is (= [:yin.k/ok 500]\n               (run-guest-ast ast outcome-modules lane 185000))\n            (str lane \": 1000 intra-unit calls fit comfortably inside 185k steps.\n                      The unary-entry token-packet lane (D2) with the final arity guard\n                      measures 160,046 walker steps (86,822 semantic) for these 1000\n                      calls - the guard's invocation-shape count check moved the walker\n                      cost from the pre-guard 140,142 (140/call) to ~160/call. The\n                      budget keeps ~15% headroom over the measured cost, recalibrated\n                      2026-11-04 by direct step-count measurement.\")))))\n  (testing \"local shadowing of a top-level defn preserves dynamic admission and routing\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(defn f\n                              [x]\n                              (+ x 100))\n                            (let [f 5 v [f]] (f 1))]\n                          library-opts lane 200000)))\n      (is (= [:yin.k/ok 42]\n             (run-library '[(defn f\n                              [x]\n                              (+ x 100))\n                            (let [f (fn [y] (* y 2))] (f 21))]\n                          library-opts lane 200000)))\n      (is (= [:yin.k/ok 9]\n             (run-library '[(defn f\n                              [x]\n                              (+ x 100))\n                            (let [f {:k 9} v [f]] (f :k))]\n                          library-opts lane 200000))\n          \"entry-absent local map routes to invoke-value\")\n      (let [[tag payload] (run-library\n                            '[(defn f\n                                [x]\n                                (+ x 100))\n                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]\n                                (f 1))]\n                            library-opts lane 200000)]\n        (is (= :yin.k/error tag))\n        (is (= :yang.call/not-callable (:yang.call/reason payload))\n            \"entry-present forged local map routes to admission and refuses\"))\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(defn f\n                              [[f]]\n                              (f 1))\n                            (f [5])]\n                          library-opts lane 200000))\n          \"destructured parameter shadows enclosing defn\")\n      (is (= [:yin.k/ok 7]\n             (run-library '[(defn f\n                              [x]\n                              99)\n                            (try\n                              (throw (ex-info \"boom\" {:k 7}))\n420:(def primitives\n473:(def primitive-profiles\n488:(defn profile-of\n(ns yang.typescript.antlr.linked-harness\n  \"The linked profile's composition for the JavaScript tests (T1 step S5,\n   docs/design/yang.typescript.md section 13): the namespace that requires\n   this is the publisher of `js` and `jssp`, so it publishes each module\n   once per process into one in-memory content store and serves them to\n   every linked run over a `yin.vm.linker.interpreter` composition under\n   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n   evidence is `publish-module!`'s own `link-local` links, which\n   `linked-prelude-test` asserts.\n\n   A linked run builds the program's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately\n   until the VM stops blocking, as the REPL's drive does. The AST walker\n   is not a backend here: its link of `js` is refused `:undeclared-free`\n   until L-b.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [dao.jing.mem :as mem]\n            [yang.core.call :as call]\n            [yang.typescript.antlr.prelude :as prelude]\n            [yang.typescript.antlr.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The ordinary JavaScript composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked JavaScript composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `jssp` polls a signal stream, so the\n   safepointed composition needs it even though `js` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`js` published once into its own content store:\n   `{:store s :result r :address a :call-address ca}`. `yang.call` is\n   published first so `js` pins its shared calling runtime.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store,\n       :result result,\n       :address (:address result),\n       :call-address (:address call-result)})))\n\n\n(def published-jssp\n  \"`jssp` published once into `js`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{js <address> yang.call <address>}`, derivation `:trusted`, the test\n   being the publisher. `jssp`-serving sources pass their own `name-env`.\"\n  ([] (source {'js (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition over the published modules: `jssp` requires\n   `js`, and `js` requires `yang.call`.\"\n  []\n  (source {'js (:address @published),\n           'jssp (:address @published-jssp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `js`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `js`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\ntest/yang/clojure_callsite_test.cljc:118:(deftest pinned-replay-test\ntest/yang/clojure_callsite_test.cljc:1010:   callable and effect runtimes. The intra-unit dispatch fix regenerates\ntest/yang/clojure_callsite_test.cljc:1012:   at test/resources/yang/clojure/cc4-replay-snapshots-prefix-c1-1.edn.\"\n","exit_code":0,"status":"completed"}}
