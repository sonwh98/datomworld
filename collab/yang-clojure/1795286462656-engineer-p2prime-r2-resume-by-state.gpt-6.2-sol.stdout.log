{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '417,512p' src/cljc/yin/vm.cljc\nrg -n 'defn.*(get|contains\\\\?|nth|str-concat|char-at)' src/cljc/yin/vm/data.cljc\nsed -n '120,222p' src/cljc/yin/vm/data.cljc\nsed -n '95,190p;995,1090p' test/yang/clojure_callsite_test.cljc\nsed -n '145,190p' test/yang/latte_oracle_test.clj\nrg -n '\"'^'\"\\\\(defn|:keys.*spec|trusted' src/cljc/yin/vm/linker/publish.cljc | tail -45\"","aggregated_output":"  ([coll k default] (get coll (if (or (map? coll) (set? coll)) (key/normalize k) k) default)))\n\n\n(def primitives\n  \"The standard executable primitive registry, published with UCF §7.5.2\n   profiles. `:yin.k/function` is host-local; the five profile keys are the\n   portable publication. `:variadic` means the greatest listed fixed arity\n   extends to further arguments.\"\n  (let [pure (fn [name function arities]\n               [name (primitive-entry name function :pure arities #{})])]\n    (into {}\n          [(pure '+ + [0 1 2 :variadic])\n           (pure '- - [1 2 :variadic])\n           (pure '* * [0 1 2 :variadic])\n           (pure '/ checked-divide [1 2 :variadic])\n           (pure '= = [0 1 2 :variadic])\n           (pure '== = [0 1 2 :variadic])\n           (pure '!= not= [1 2 :variadic])\n           (pure '< < [1 2 :variadic])\n           (pure '> > [1 2 :variadic])\n           (pure '<= <= [1 2 :variadic])\n           (pure '>= >= [1 2 :variadic])\n           (pure 'not not [1])\n           (pure 'nil? nil? [1])\n           (pure 'empty? empty? [1])\n           (pure 'first first [1])\n           (pure 'rest (fn [a] (vec (rest a))) [1])\n           (pure 'conj collection-conj [1 2 :variadic])\n           (pure 'assoc collection-assoc [3 :variadic])\n           (pure 'get collection-get [2 3])\n           (pure 'vec vec [1])\n           ;; one arity: strict UTF-8 on every host (dao.host.text, slice\n           ;; H2, ratified OQ11: encoding arity 2 removed from portable profile)\n           (pure 'bytes->str\n                 (fn [b] (text/utf8-decode b))\n                 [1])\n           ['require (primitive-entry\n                       'require\n                       (fn [spec]\n                         (let [ns-sym (if (vector? spec) (first spec) spec)]\n                           (effect/make :module/require {:module ns-sym})))\n                       :effectful [1] #{:module/require})]\n           ['try-require (primitive-entry\n                           'try-require\n                           (fn [spec]\n                             (let [ns-sym (if (vector? spec) (first spec) spec)]\n                               (effect/make :module/try-require\n                                            {:module ns-sym})))\n                           :effectful [1] #{:module/try-require})]])))\n\n\n(def ^:private primitive-profile-keys\n  [:yin.k/profile :yin.k/class :yin.k/arities :yin.k/effects\n   :yin.k/host-state])\n\n\n(def primitive-profiles\n  \"Portable projection of the standard registry, retained as a convenience.\"\n  (into {} (map (fn [[name entry]]\n                  [name (select-keys entry primitive-profile-keys)]))\n        primitives))\n\n\n(def primitive-canonical-names\n  \"Canonical-name declarations for intentional aliases in `primitives`.\n\n   The table is name -> canonical name, not function -> name, so it remains\n   plain portable data. `=` and `==` intentionally share one host function.\"\n  {'== '=})\n\n\n(defn profile-of\n  \"Return `name`'s published profile from a registry, or nil.\"\n  [registry name]\n  (when-let [entry (get registry name)]\n    (when (and (map? entry) (contains? entry :yin.k/profile))\n      (select-keys entry primitive-profile-keys))))\n\n\n(defn name-of\n  \"Reverse-look up `primitive` by host-object identity.\n\n   Returns nil when unnamed, `::ambiguous` when several names remain after\n   applying `canonical-names`, or the one resolved name. The two-argument\n   form declares no aliases.\"\n  ([primitive-map primitive]\n   (name-of primitive-map {} primitive))\n  ([primitive-map canonical-names primitive]\n   (let [names (->> primitive-map\n                    (keep (fn [[name entry]]\n                            (when (identical? (primitive-function entry)\n                                              primitive)\n                              name)))\n                    (sort-by str)\n                    vec)]\n     (case (count names)\n180:(defn- data-nth\n188:(defn- data-contains?\n259:(defn- str-concat\n321:(defn- char-at\n  [op i lo hi]\n  (when-not (<= lo i hi)\n    (refuse! op :out-of-range {::index i, ::lo lo, ::hi hi}))\n  i)\n\n\n;; =============================================================================\n;; Code points\n;; =============================================================================\n\n(defn- code-points->string\n  \"The string of code points `cps`, each already checked to lie in\n   0 to 0x10FFFF.\"\n  [cps]\n  (text/units->string\n    (mapcat (fn [cp]\n              (if (< cp 0x10000)\n                [cp]\n                (let [c (- cp 0x10000)]\n                  [(+ 0xD800 (quot c 0x400)) (+ 0xDC00 (rem c 0x400))])))\n            cps)))\n\n\n(defn- string!\n  [op arg x]\n  (when-not (string? x)\n    (wrong-type! op arg :string))\n  x)\n\n\n(defn- find-code-points\n  \"The first index at or after `from` where `needle` occurs in `hay`,\n   both code point vectors, or -1.\"\n  [hay needle from]\n  (let [m (count needle)\n        last-start (- (count hay) m)]\n    (loop [i from]\n      (cond (> i last-start) -1\n            (= needle (subvec hay i (+ i m))) i\n            :else (recur (inc i))))))\n\n\n;; =============================================================================\n;; Collection exports\n;; =============================================================================\n\n(defn- data-count\n  [coll]\n  (if (or (nil? coll) (coll? coll))\n    (count coll)\n    (wrong-type! 'count 0 :collection)))\n\n\n(defn- vector!\n  [op arg x]\n  (when-not (vector? x)\n    (wrong-type! op arg :vector))\n  x)\n\n\n(defn- data-nth\n  [v i]\n  (vector! 'nth 0 v)\n  (let [i (index! 'nth 1 i)]\n    (in-range! 'nth i 0 (dec (count v)))\n    (nth v i)))\n\n\n(defn- data-contains?\n  [coll k]\n  (cond\n    (or (nil? coll) (map? coll) (set? coll)) (contains? coll (key/normalize k))\n    (vector? coll) (let [i (integral k)]\n                     (boolean (and i (< -1 i (count coll)))))\n    :else (wrong-type! 'contains? 0 :map-set-or-vector)))\n\n\n(defn- data-dissoc\n  [m & ks]\n  (if (or (nil? m) (map? m))\n    (apply dissoc m (map key/normalize ks))\n    (wrong-type! 'dissoc 0 :map)))\n\n\n(defn- data-disj\n  [s & ks]\n  (if (or (nil? s) (set? s))\n    (apply disj s (map key/normalize ks))\n    (wrong-type! 'disj 0 :set)))\n\n\n(defn- data-peek\n  [v]\n  (if (or (nil? v) (vector? v))\n    (peek v)\n    (wrong-type! 'peek 0 :vector)))\n\n\n(defn- data-pop\n  [v]\n  (cond\n    (nil? v) nil\n    (not (vector? v)) (wrong-type! 'pop 0 :vector)\n  (into #{} (map first) (filter #(= :yang/call-site (nth % 3)) metadata)))\n\n\n(defn- expansion-origin?\n  [o]\n  (and (vector? o) (= :expansion (first o))))\n\n\n(defn- marked\n  [metadata]\n  (into #{}\n        (comp (filter #(= :yang/call-site (nth % 3)))\n              (map (fn [[o r path _ _]] [o r path])))\n        metadata))\n\n\n(defn- failure-rule\n  [f]\n  (try (f) ::no-failure\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         (:rule (ex-data e)))))\n\n\n(deftest pinned-replay-test\n  (let [ast (yang/compile-program\n              '[(defn replay\n                  [x]\n                  (let [y (+ x 1.5)]\n                    (+ (identity ^:replay y)\n                       (identity ^:replay y))))\n                (replay 2)])\n        {:keys [tree metadata]} (project ast)\n        keys (vec (sort-by pr-str (marked metadata)))\n        root :segment/blake3-ed66c4acafcaa0272ad446f46f10c90bccd2aadebb99de4b55d2f9024773d54f\n        paths [[2 3] [[3 0] [3 1] 3 2 3 [3 0]]\n               [[3 0] [3 1] 3 2 3 [3 1]] [[3 0] [3 1] 3 2 3]\n               [[3 0] [3 1] 3 [3 0]]\n               [[3 0] [3 1] 3] [[3 0]] []]]\n    (is (= root (:root tree)))\n    (is (= (mapv (fn [path] [origin root path]) paths) keys))\n    (is (= (eligible tree) (marked metadata)))))\n\n\n(deftest equality-gate-test\n  (testing \"native compile: eligible set equals marker set\"\n    (let [ast (yang/compile '(+ (* 2 3) 4))\n          {:keys [tree metadata]} (project ast)]\n      (is (= #{[origin (:root tree) []]\n               [origin (:root tree) [[3 0]]]}\n             (marked metadata)))\n      (is (= (eligible tree) (marked metadata)))\n      (is (true? (yang/validate-call-site-coverage! tree metadata origin)))\n      (is (true? (yang/validate-ast-call-sites! ast origin)))\n      (is (every? (fn [[o r _ k v]]\n                    (and (= origin o) (= (:root tree) r)\n                         (= :yang/call-site k) (= 1 v)))\n                  (filter #(= :yang/call-site (nth % 3)) metadata)))))\n  (testing \"compile-program, native and argument-vector/outcome paths\"\n    (doseq [ast [(yang/compile-program\n                   '[(defn f\n                       [x]\n                       (+ x 1)) (defn g\n                                  [x]\n                                  (f (* x 2))) (g 21)])\n                 (yang/compile-program\n                   '[(defn f\n                       [x]\n                       (+ x 1)) (f 2)] true yang/unit-opts)]]\n      (let [{:keys [tree metadata]} (project ast)]\n        (is (= (eligible tree) (marked metadata)))\n        (is (true? (yang/validate-call-site-coverage! tree metadata origin))))))\n  (testing \"lower-unit: the linked production path, library included\"\n    (let [ast (yang/lower-unit '[(defn f\n                                   [x]\n                                   (+ x 1)) (f 2)])\n          {:keys [tree metadata]} (project ast)]\n      (is (< 10 (count (marked metadata))))\n      (is (= (eligible tree) (marked metadata)))\n      (is (true? (yang/validate-call-site-coverage! tree metadata origin)))))\n  (testing \"the clj prelude module tree is finalized\"\n    (let [ast yang.clojure.prelude/module-uast\n          {:keys [tree metadata]} (project ast)]\n      (is (= (eligible tree) (marked metadata)))\n      (is (true? (yang/validate-call-site-coverage! tree metadata origin))))))\n\n\n(deftest boundary-test\n  (testing \"yin/def gets an occurrence annotation\"\n    (let [ast (yang/compile '(def x (fn [a] (+ a 1))))]\n      (is (= 1 (:yang/call-site ast)))\n      (is (= 1 (get-in ast [:operands 1 :body :yang/call-site])))\n      (is (true? (yang/validate-ast-call-sites! ast origin)))))\n  (testing \"a dedicated stream operation is not an application site\"\n    (let [ast (yang/compile '(dao.stream.apply/call :op/echo (+ 1 2)))\n          {:keys [tree metadata]} (project ast)]\n      (is (= :dao.stream.apply/call (:type ast)))\n             :keys-digest (jing/content-hash keys)\n             :c1-digest (jing/content-hash c1)\n             :instruction-provenance-digest\n             (jing/content-hash [(:call-provenance sem)\n                                 (:call-provenance stack)\n                                 (:call-provenance register)])}\n      addresses (assoc :addresses addresses)\n      provenance (assoc :provenance-digest (jing/content-hash provenance))\n      expansion-log (assoc :expansion-log-digest (jing/content-hash expansion-log)\n                           :expansion-status status))))\n\n\n(def replay-expectations\n  \"Canonical replay expectations shared by all hosts. P1′ refreshed the\n   argument-vector, lower-unit, prelude and clj members for the unified\n   callable and effect runtimes. The intra-unit dispatch fix regenerates\n   the argument-vector and lower-unit members. The c1-1 bundle is archived\n   at test/resources/yang/clojure/cc4-replay-snapshots-prefix-c1-1.edn.\"\n  [{:id :native,\n    :root\n    :segment/blake3-0aac99defd315ce7623ecefc08106f31653bd138fb5ae3f1f1d466bd93893c70,\n    :applications 14,\n    :keys-digest\n    \"fa8eac643ac38139bbfb9391e5e00725b24396a04067f812117dbf352a99dcee\",\n    :c1-digest\n    \"c906019273e6253441e61306faca99b4212f122a00b08fd8226be0e0e7742c26\",\n    :instruction-provenance-digest\n    \"1556afb1db35c20b88bbc254b112fcb09874e95b3c9bcd8d412fbd3e4d01f005\"}\n   {:id :argument-vector,\n    :root\n    :segment/blake3-444a37d3403e5e5e734b71957c2cb60ed22c7aa5afb2fe68d34ebfd7e46cb95d,\n    :applications 64,\n    :keys-digest\n    \"026a377fc739a1bc07bc599135bb45e48a55fad40d75bdc3bbb0822e2dc9c50d\",\n    :c1-digest\n    \"0be12a3d908c10cdc6466dfe72345c33d1eb8a955ebca0efa44378eeea1f2408\",\n    :instruction-provenance-digest\n    \"85073dfa2c0c227b34f349c2beea6a182da148cff624e89b3286f2045da19396\"}\n   {:id :lower-unit,\n    :root\n    :segment/blake3-3609a1311a3e43d1bab8e838c9d542cda369b280a35780f22de25d36e19b4bb0,\n    :applications 74,\n    :keys-digest\n    \"09a1cef0dfe5aa807c4bb0d353fb22e72297ebf1d41f3642ac5a448656f3eee9\",\n    :c1-digest\n    \"9f1167811cd3a748db797b65a391c13f9660cf20d6847a6bef083b38d4baf7ea\",\n    :instruction-provenance-digest\n    \"977f22f5849d25726d03a5f6cb3698476d18cbb957fe5dcc55c0960a19002c36\"}\n   {:id :prelude,\n    :root\n    :segment/blake3-bfce6e49877582af6abc2155cb15b55f485b5a9574bab2c0816ba2dd39fcdfd4,\n    :applications 156,\n    :keys-digest\n    \"bbd572db3ff3476261c815fc82463ec1d77fba9ce39a02f4ab60fc03f8b86225\",\n    :c1-digest\n    \"ed6ad13d4880c662c226601b9ef244bddeb94d27257d6e1ca96c1e534106564b\",\n    :instruction-provenance-digest\n    \"443251ec69f5bbc4702397b8e20ae9b15bee664734cd1b690aff457555556ba4\"}\n   {:id :macro,\n    :root\n    :segment/blake3-a15528bb9aef22fa7dc4beaa90a7e08f079b4dfb9b6da51f7b16bb079c54134a,\n    :applications 5,\n    :keys-digest\n    \"41d06797995ebdc416c2218d9bc6f359ee91f3374f2412cdeff3f5b03bc85d68\",\n    :c1-digest\n    \"08b6cca6ed5de79242687f08d6ef0a5206ab97a54c3f22e131d4bc4b7e9e5c17\",\n    :instruction-provenance-digest\n    \"0977d7b1ec1637016b58cf457783f59b66881dd092e2308f760e6329c7e61b45\",\n    :expansion-log-digest\n    \"73b67cf76e2ad7e5444fdcd9df1e26e538ac80bcab0e39c0243abc458230e605\",\n    :expansion-status :ok}\n   {:id :negative,\n    :root\n    :segment/blake3-0aac99defd315ce7623ecefc08106f31653bd138fb5ae3f1f1d466bd93893c70,\n    :applications 14,\n    :keys-digest\n    \"9af4019d1aac9117ea1c3c6722e51d1f485b5c12fb413696334ebf32bf8726dc\",\n    :c1-digest\n    \"0922dc899c755e6524b5a99dd89d231fb66e0442bf64b4f1f12cd83caff7fe1e\",\n    :instruction-provenance-digest\n    \"cf08d9827b5a9df3f78524904a5670f8e2e9c01962e9085c60553e2deae6b799\"}\n   {:id :yang.call,\n    :root\n    :segment/blake3-7e7616ca801a9accdf762409584fdd792e055dc5c55d4528a8eb3fdb5596e37c,\n    :applications 100,\n    :keys-digest\n    \"2039d1de6fef574d02f5f9afe4105ea682b03fe322871a7087cdd6d32e4e54a8\",\n    :c1-digest\n    \"3acde5f905ceea786f662156fbf6e90cd04dcbc40f3872ca9aaebbc26f39d519\",\n    :instruction-provenance-digest\n    \"980ec0e7f2bc5e3b4ff2da60a90dab318d594e6a5a53319214f7bdf9f39a87bf\",\n    :addresses\n    {:record\n     :segment/blake3-28e281229dc14d40416e033479004b021d89e599be66318a21102850b5c39cc3,\n     :table\n     :segment/blake3-3acde5f905ceea786f662156fbf6e90cd04dcbc40f3872ca9aaebbc26f39d519,\n\n\n(defn- host-module\n  \"Register `fns` as host module `module-name`, every export `:pure`.\"\n  [registry module-name fns arities]\n  (module/register-host-module\n    registry module-name fns\n    (into {} (map (fn [[op]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n          fns)))\n\n\n(def ^:private kind-fns\n  \"The irreducible kind and name primitives (yang.clojure/kind-module), plus\n   the two host Var primitives the throw-site fixtures reach.\"\n  (assoc yang/kind-module 'var? var? 'resolve resolve))\n\n\n(defn- oracle-registry\n  \"The stream/data modules, kind primitives, and portable outcome adapters.\n   Slices 1-7 retain their host Var probes; context modules supply only the\n   callback-free kind exports and cannot consult host namespaces.\"\n  ([] (oracle-registry kind-fns))\n  ([kinds]\n   (let [portable (into {}\n                        (map (fn [[source _]]\n                               (let [op (symbol (name source))]\n                                 [op (yang/outcome-adapter data/refusal-message\n                                                           (get data/data-module op))])))\n                        yang/library-adapters)]\n     (-> (module/default-registry)\n         module/register-stream-module\n         module/register-cell-module\n         data/register-data-module\n         (host-module 'kind kinds yang/kind-arities)\n         (host-module 'portable portable\n                      (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n                            (keys portable)))))))\n\n\n(def ^:private arg-vector-opts\n  \"The argument-vector convention with the outcome model, the guest library's\n   adapters and the VM primitives' published profiles as the native names.\"\n  {:convention :arg-vector, :outcomes true\n   :adapters yang/library-adapters\n   :native vm/primitive-profiles})\n\n20:(defn- refusal\n28:(defn- definitions\n50:(defn footprint\n126:(defn admission-scope\n141:(defn- scope-admission-token\n152:(defn- spec-admission-token\n167:(defn- publication-origin\n183:(defn- claims-call-sites?\n191:(defn- call-site-claim\n223:(defn link-local\n245:(defn- publish-closure!\n247:  [handle {:keys [name ast exports requires primitives] :as spec} opts]\n442:(defn publish-module!\n457:(defn- stored-tree\n487:(defn published-call-site-table\n536:(defn published-instruction-provenance\n587:(defn- indexed-programs\n604:(defn requirements\n612:(defn- free-of\n634:(defn- mark-call-sites\n653:(defn- retained-call-site-rows\n701:(defn- sequenced-prefixes\n713:(defn- sequenced-wrapper-paths\n723:(defn- recovered-call-site-claim\n815:(defn- sequenced\n832:(defn- free-declaration\n850:(defn module-from-index\n999:(defn- signed\n1008:(defn assertion\n1023:(defn retraction\n1035:(defn- own-envelopes\n1045:(defn next-seq\n1054:(defn name-envelopes\n","exit_code":0,"status":"completed"}}
