ent-site? (:site-table explicit-2) variable-site))\ntest/yang/latte_oracle_test.clj:3124:            table (:site-table indirect)\ntest/yang/latte_oracle_test.clj:3143:      (let [table (:site-table explicit-2)\ntest/yang/latte_oracle_test.clj:3157:      (let [table (:site-table f2)\ntest/yang/latte_oracle_test.clj:3224:     :coverage {:proven-direct-function-arities (vec (sort-by pr-str direct))\ntest/yang/latte_oracle_test.clj:3228:                :transitive-execution-coverage :recorded-function-arity-body-entry\ntest/yang/latte_oracle_test.clj:3235:                :basis \"Passing direct calls or named integrations must record the exact function/arity executing in both C lanes. Static closure membership never counts; full branch coverage is not required.\"\ntest/yang/latte_oracle_test.clj:3247:      :site-tables-file \"slice9_site_tables.edn\"\ntest/yang/latte_oracle_test.clj:3251:                  :let [stale (kernel-stale-sites (:site-table row)\ntest/yang/latte_oracle_test.clj:3269:  \"Explicit evidence/coverage refresh; normal tests never update these files.\ntest/yang/latte_oracle_test.clj:3278:                              (for [entry (get-in evidence [:coverage :entries])\ntest/yang/latte_oracle_test.clj:3292:                                   :site-table (:site-table row)}]))})\ntest/yang/latte_oracle_test.clj:3301:         (doseq [row (:fixtures evidence)] (prn (dissoc row :site-table)))\ntest/yang/latte_oracle_test.clj:3303:     (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage :attribution]))))\ntest/yang/latte_oracle_test.clj:3323:    (let [entries (get-in evidence [:coverage :entries])\ntest/yang/latte_oracle_test.clj:3328:      (is (= (set (get-in evidence [:coverage :unexercised]))\ntest/yang/latte_oracle_test.clj:3350:                    entry (first (filter #(= arity (:function-arity %)) (get-in evidence [:coverage :entries])))]]\ntest/yang/latte_oracle_test.clj:3384:             \"; admitted/candidate but unexercised function/arities=\" (count (get-in evidence [:coverage :unexercised]))\ntest/yang/latte_oracle_test.clj:3391:   deviations), the raw comparisons and the coverage survive. No fixtures\ntest/yang/latte_oracle_test.clj:3410:          (is (= (count (get-in written [:coverage :unexercised])) (count unexercised))\nsrc/cljc/yin/vm.cljc:938:(defn occurrence-origin?\nsrc/cljc/yin/vm.cljc:967:    (when-not (occurrence-origin? origin)\nsrc/cljc/yin/vm.cljc:1227:  (when-not (occurrence-origin? origin)\nsrc/cljc/yin/vm/macro.cljc:106:(defn- packet-of\nsrc/cljc/yin/vm/macro.cljc:683:     'yin/application (fn [operator operands]\nsrc/cljc/yin/vm/macro.cljc:684:                        (need-packet 'yin/application operator)\nsrc/cljc/yin/vm/macro.cljc:685:                        (doseq [o operands] (need-packet 'yin/application o))\nsrc/cljc/yin/vm/macro.cljc:687:     'yin/if (fn [t c a]\nsrc/cljc/yin/vm/macro.cljc:688:               (doseq [x [t c a]] (need-packet 'yin/if x))\nsrc/cljc/yin/vm/macro.cljc:877:(defn- retail\nsrc/cljc/yin/vm/macro.cljc:919:(defn- lower-standins\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '110,205p'; nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '225,300p'; nl -ba collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md | sed -n '30,80p'; rg -n 'site-table|call-site|coverage' BRIEF-cc1*.md\"","aggregated_output":"   110\t;; distinct origins — persisted in the record and retrieved from the\n   111\t;; record, never reconstructed from the tree's content. The publisher\n   112\t;; extracts the markers from the map AST, refuses the\n   113\t;; publication when they do not exactly cover the canonical tree's\n   114\t;; application occurrences — or when a marker's value is not version 1 —\n   115\t;; and otherwise materializes the table and its record into the same\n   116\t;; handle. A module with no markers makes no claim and publishes exactly\n   117\t;; as before.\n   118\t\n   119\t(def ^:private publication-sequence\n   120\t  \"The publisher's admission counter. Each publication is one admission\n   121\t   event (design §2.1): two separately admitted identical sources have\n   122\t   different origins, so the token drawn here never repeats.\"\n   123\t  (atom 0))\n   124\t\n   125\t(defn- next-admission-token\n   126\t  \"A fresh, never-repeated admission token for one publication.\"\n   127\t  []\n   128\t  (keyword \"yin.vm.linker.publish.publication\"\n   129\t           (str (swap! publication-sequence inc))))\n   130\t\n   131\t(defn- publication-origin\n   132\t  \"The occurrence origin of the publication admission `token` names:\n   133\t   the publisher's own medium, the explicit admission token, member 0.\n   134\t   `token` is the publication's admission identity — the\n   135\t   `:yin.link.publish/admission` option when the composition pins one,\n   136\t   otherwise a publisher-allocated token that never repeats — so two\n   137\t   publications of identical trees are two admissions with distinct\n   138\t   origins. The origin is an admission event's identity, not a\n   139\t   function of the tree's content: it is persisted in the side record\n   140\t   at publication time and retrieved from that record; nothing ever\n   141\t   reconstructs it from the root.\"\n   142\t  [token]\n   143\t  [:source :yin.vm.linker.publish/publish token 0])\n   144\t\n   145\t\n   146\t(defn- claims-call-sites?\n   147\t  \"True when map AST `ast` carries the C1 key anywhere. A hit inside a\n   148\t   literal payload is data, not a claim: extraction then finds no\n   149\t   markers and the module publishes unannotated, as it should.\"\n   150\t  [ast]\n   151\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n   152\t\n   153\t\n   154\t(defn- call-site-claim\n   155\t  \"The C1 claim `ast` makes over its canonical `tree`: nil when it\n   156\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\n   157\t   when the extracted markers exactly cover the tree's eligible\n   158\t   application occurrences; `{:missing [...] :extra [...]}` when they\n   159\t   do not; `{:unsupported-version v :path p}` when a marker's value is\n   160\t   not version 1 — a claim rejection, never a silent acceptance of a\n   161\t   table a retriever would read as version 1.\"\n   162\t  [ast tree admission]\n   163\t  (when (claims-call-sites? ast)\n   164\t    (let [origin (publication-origin admission)\n   165\t          extracted (filter #(= :yang/call-site (nth % 3))\n   166\t                            (:frontend-metadata\n   167\t                              (vm/ast-side-tables ast tree origin)))\n   168\t          eligible (into #{}\n   169\t                         (map (fn [[r p]] [origin r p]))\n   170\t                         (vm/application-occurrences tree))\n   171\t          marked (into #{}\n   172\t                       (map (fn [[o r p _ _]] [o r p]))\n   173\t                       extracted)]\n   174\t      (or (when-let [[v p] (some (fn [row]\n   175\t                                   (let [v (nth row 4)]\n   176\t                                     (when (not (and (integer? v) (= 1 v)))\n   177\t                                       [v (subvec row 0 3)])))\n   178\t                                 extracted)]\n   179\t            {:unsupported-version v, :path p})\n   180\t          (if (= eligible marked)\n   181\t            {:origin origin, :rows (vec (sort-by pr-str extracted))}\n   182\t            {:missing (vec (sort-by pr-str (remove marked eligible))),\n   183\t             :extra (vec (sort-by pr-str (remove eligible marked)))})))))\n   184\t\n   185\t\n   186\t(defn link-local\n   187\t  \"Link `format`'s image through the manifest `address` over `handle`'s\n   188\t   own content, `:verifying` with discharge deferred, as a serving\n   189\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\n   190\t   call, so no request reaches any peer.  `opts` overrides the link\n   191\t   options; its `:bounds` are the runtime's composition bounds (section\n   192\t   4.2 step 2), every one left out taking `linker/default-bounds`.\"\n   193\t  ([handle address format] (link-local handle address format nil))\n   194\t  ([handle address format opts]\n   195\t   (linker/link-manifest\n   196\t     (linker/local-runtime\n   197\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\n   198\t                              (conj code-formats linker/manifest-format\n   199\t                                    linker/record-format))\n   200\t               :bounds (:bounds opts)})\n   201\t     address (:format format) {:primitives vm/primitives}\n   202\t     (merge {:contract (:contract format)\n   203\t             :derivation :verifying\n   204\t             :defer-discharge true}\n   205\t            (dissoc opts :bounds)))))\n   225\t                      :complete nil\n   226\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n   227\t                                        {:name n})\n   228\t                      :missing (when (not= address (:address w))\n   229\t                                 (refusal :yin.link.publish/incomplete-requirement\n   230\t                                          {:name n :walk w})))))\n   231\t                (sort-by (fn [[n _]] (str n)) requires)))\n   232\t        fp (when (and tree (not defect) (not requirement)\n   233\t                      (not= :refused (:status tree)))\n   234\t             (footprint handle (assoc spec :tree tree)))\n   235\t        ;; a C1 claim is validated before anything is written: a module\n   236\t        ;; whose markers do not cover its tree is never published as\n   237\t        ;; though it did. One publication is one admission event\n   238\t        ;; (design §2.1): the admission identity is pinned explicitly by\n   239\t        ;; the composition when it supplies `:yin.link.publish/admission`,\n   240\t        ;; otherwise drawn fresh here — either way it is persisted in\n   241\t        ;; the side record and retrieved from there\n   242\t        admission (or (:yin.link.publish/admission opts)\n   243\t                      (next-admission-token))\n   244\t        claim (when (and tree (not defect) (not requirement)\n   245\t                         (not= :refused (:status tree))\n   246\t                         (not= :refused (:status fp)))\n   247\t                (call-site-claim ast tree admission))]\n   248\t    (cond\n   249\t      undefined\n   250\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   251\t\n   252\t      (= :refused (:status tree)) tree\n   253\t\n   254\t      defect\n   255\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\n   256\t\n   257\t      requirement requirement\n   258\t\n   259\t      (= :refused (:status fp)) fp\n   260\t\n   261\t      ;; dispatch on the key's PRESENCE, not its truthiness: a marker\n   262\t      ;; whose value is present but not the integer 1 — nil or false\n   263\t      ;; included — carries :unsupported-version nil/false, and its\n   264\t      ;; reason is the unsupported version, never incomplete coverage\n   265\t      (and claim (contains? claim :unsupported-version))\n   266\t      (refusal :yin.link.publish/unsupported-call-site-version claim)\n   267\t\n   268\t      (and claim (not (:rows claim)))\n   269\t      (refusal :yin.link.publish/incomplete-call-site-coverage claim)\n   270\t\n   271\t      :else\n   272\t      (let [tree-address (vm/materialize-tree! handle tree)\n   273\t            sem-vector (:vector (linearize/project-rows tree))\n   274\t            sem (code/materialize-vector! handle sem-vector)\n   275\t            h-image (:image (derive/stack-image sem-vector))\n   276\t            r-image (derive/register-image sem-vector)\n   277\t            h (dcode/image-hash h-image)\n   278\t            r (rcode/register-hash r-image)\n   279\t            h-address (jing/materialize! handle h-image)\n   280\t            r-address (jing/materialize! handle r-image)\n   281\t            mint (fn [input output profile]\n   282\t                   (jing/materialize!\n   283\t                     handle\n   284\t                     (assoc (ledger/derive-record input output)\n   285\t                            :yin.ledger/profile profile)))\n   286\t            ;; the C1 side table and its reverse record, materialized\n   287\t            ;; BEFORE the manifest so the manifest can reference them:\n   288\t            ;; the module closure follows manifest references, so only a\n   289\t            ;; referenced table travels with the module through transfer\n   290\t            call-sites (when (:rows claim)\n   291\t                         (let [table (jing/materialize! handle (:rows claim))\n   292\t                               record {:yang.call-site/version 1\n   293\t                                       :yang.call-site/root tree-address\n   294\t                                       :yang.call-site/origin (:origin claim)\n   295\t                                       :yang.call-site/table table}]\n   296\t                           {:record (jing/materialize! handle record)\n   297\t                            :table table\n   298\t                            :origin (:origin claim)\n   299\t                            :root (:root tree)}))\n   300\t            manifest (cond-> {:yin.module/name name\n    30\tThe following is the proposed normative contract, grounded in `docs/design/yin.vm.code-as-tuples.md:393-455,658-665,918-931`.\n    31\t\n    32\t### 2.1 Identity and scope\n    33\t\n    34\tAn application site is `K = [origin root-address path]`.\n    35\t\n    36\t- `root-address` is the canonical root of the particular final UAST tree being named, not the application's subtree address or an instrumented runtime-map hash.\n    37\t- `path` is the grammar's structural path: scalar child slot steps are row positions; a child in a `nodes` slot is `[slot-position member-index]`. The root is `[]`. Never substitute map keys, host iteration order, allocation ids, source line numbers, PCs, callee names, or arities.\n    38\t- `origin` identifies the actual admission or generation event. Admitted syntax uses `[:source medium batch-token j]`; generated syntax uses `[:expansion expansion-record-address]`. Generated post-expansion trees must not be mislabeled as original source or given a fabricated expansion address. If a no-op expansion retains an admitted tree, the original source origin remains valid; “post-expansion” names the pipeline boundary, not proof that a generating event occurred.\n    39\t- An origin is supplied by the admitting/generating composition. Two separately admitted identical sources have different origins; two identical applications in one tree have different paths; two expansion attempts with identical output have different producing records. Replaying a single recorded admission is different from admitting the same text again.\n    40\t\n    41\tThe implemented origin validator accepts exactly the source and expansion shapes (`src/cljc/yin/vm.cljc:938-958`). `vm/occurrences` returns `[root path node-id]`, one per place, with origin fixed by the composition; it does not return full keys or count only distinct row ids (`vm.cljc:1589-1609`).\n    42\t\n    43\tCoverage is **every final `:application` occurrence**, including generated wrappers, adapters, dispatcher/helper calls, bundled preludes, imported preludes, recursion, and statically indirect applications. “Source call” and “attributable upstream call” are projections over this coverage, not filters that delete other occurrences. Rule R's `yin/def` is structurally an application but lowers to `:define`; it gets an occurrence annotation and never a fictitious callee-entry event (`semantic/linearize.cljc:106-116`).\n    44\t\n    45\tDedicated operations such as `:dao.stream.apply/call`, stream nodes, and continuation nodes retain existing instruction provenance. They are not silently counted as `:application` sites. Their adapters' application occurrences are covered; an extension to count other node kinds must explicitly version the coverage policy (`vm.cljc:1015-1028`; `semantic/linearize.cljc:126-139`).\n    46\t\n    47\t### 2.2 Minimal persisted annotation\n    48\t\n    49\tReserve `:yang/call-site` in the existing frontend-metadata relation:\n    50\t\n    51\t```clojure\n    52\t[origin root-address path :yang/call-site 1]\n    53\t```\n    54\t\n    55\tThe integer `1` versions this key's coverage/interpretation contract. The first three coordinates ARE the site id; the value does not repeat it. This key is distinct from existing `:yang/site`, whose meaning is safepoint marks (`src/cljc/yang/safepoint.cljc:55-75`). It carries no language name, source arity, ambient-context classification, or callee identity. Those are consumer evidence derived by the oracle or another explicitly versioned consumer.\n    56\t\n    57\tThe marker certifies that a producer preserved this occurrence under C1; the application predicate itself remains derived from canonical rows. There is no new canonical fact asserting what the grammar already says. A consumer can derive the eligible application set and compare it with the complete marker set. Under a C1 publication claim the sets must be equal; mere absence of annotations in an older publication is not false evidence of zero applications.\n    58\t\n    59\tEmit precisely one logical marker per eligible occurrence. Duplicate identical transport deliveries may be deduplicated as the same immutable fact; duplicate entries in a declared canonical table, conflicting values, unsupported versions, nonexistent paths, non-application targets, and missing/extra rows under a complete-coverage claim are validation failures. Other frontend metadata is preserved independently.\n    60\t\n    61\tImplementation may add this marker to temporary frontend map nodes before side-table projection, since the current extractor recognizes namespace `yang` (`vm.cljc:1183-1214`). Prefer deriving the relation directly from validated rows where map attachment would be redundant. `ast->semantic-bytecode` hashes only grammar slots and drops other node keys (`vm.cljc:1113-1123`); no grammar slot, instruction operand, canonical datom slot, or AST contract revision is authorized by C1.\n    62\t\n    63\t### 2.3 Finalization and transformations\n    64\t\n    65\tFinalize paths only after macro expansion, generated-name canonicalization, wrappers, module/SCC assembly, and tail marking that determine the named tree. Source-level annotations alone cannot cover generated calls (base ruling R2 at line 17). Low-level functions returning fragments may defer finalization until an owning root and origin exist; each executable/publication ingress must invoke the common finalizer. A frontend cannot claim adoption by marking just its parser or user-call lowering arm.\n    66\t\n    67\tA subsequent tree-changing transform creates another root and another occurrence relation. It must preserve an explicit old/new occurrence correspondence where it makes an attribution claim, recompute C1 for new applications, and identify generated helper calls separately. It must not retain stale paths or equate every new helper with the nearest source call. If a transform deletes, duplicates, or merges occurrences, its correspondence must record the actual multiplicity; ambiguity refuses attribution.\n    68\t\n    69\tMacro expansion already records input root, call path, macro root, parent, output and attempt (`src/cljc/yin/vm/macro.cljc:997-1000,1062-1119`). However, final tail marking and stand-in lowering happen later (`:1255-1260`). The implementation inventory must resolve how final published roots are related to these expansion outputs. Whether the existing event/record adapters already provide the complete final-root correspondence is **unknown — the implementation round's inventory decides**. Do not assume an intermediate output record identifies every occurrence in the final assembled tree, and do not mint a fake `:expand` merely to satisfy the shape.\n    70\t\n    71\t### 2.4 Lowering, reconstruction, and runtime lookup\n    72\t\n    73\tPersist the existing instruction relation `[segment-address pc origin root-address path]`. The row linearizer already returns `{:address ... :provenance [[pc origin root path] ...]}`; its caller supplies the segment coordinate (`semantic/linearize.cljc:188-214`; code-as-tuples §5.3 at lines 918–931). A call dispatch looks up its **own call instruction's** emitting occurrence, not the preceding operand's instruction or the callee's body. Multiple instructions may belong to one occurrence.\n    74\t\n    75\tSegment+PC alone is insufficient when identical code is loaded under two origins. The runtime must retain its load/admission origin alongside its image reference when selecting provenance. This is an occurrence-scoped runtime context, not a new code hash. The native image derivations must supply or independently reconstruct a mapping from their call PCs back through semantic PCs to K; PC equality across formats must not be assumed. Current semantic `resolve` preserves PCs, register derivation preserves layout, and stack derivation emits a new sequence (`semantic/derive.cljc:21-42,60-93,154-172`).\n    76\t\n    77\tCanonical reconstruction deliberately shares nodes by content (`vm.cljc:1477-1486,1522-1525`). Never cache an occurrence annotation by node-id or mutate a shared canonical reconstruction and expect distinct sites to survive. Keep an occurrence cursor/side lookup, or expand occurrence-specific ephemeral images. The datom linearizer currently returns `[pc entity]`, not K (`semantic/linearize.cljc:283-302`); use an explicit entity-to-occurrence bridge with the owning batch, root and path, refusing ambiguity. `encoder/datom-entity-occurrences` and the envelope's `:yin/entity-occurrences` are the starting machinery (`encoder.cljc:67,115-148`).\n    78\t\n    79\t### 2.5 Ephemeral origin and trace field\n    80\t\nBRIEF-cc1-fix.md:8:2. **Linked publication drops prelude markers**: prelude.cljc ~:108 annotates module-uast, but publish.cljc ~:117 converts to canonical rows without extracting/retaining frontend metadata. Fix: the published module must carry (or reference) the side table — per the design, published `clj` and `yang.call` coverage is in scope.\nBRIEF-cc1-fix.md:10:4. **The frontend catalog**: revise `legacy-1` (yin/repl/frontends.cljc ~:26) — the coverage promise changed, so the catalog needs a revision + the relevant profile entry per the design.\nBRIEF-cc1.md:3:# Task: implement the call-site occurrence contract C1 for PRODUCTION yang.clojure (Addendum A, adoption round 1 of 4)\nBRIEF-cc1.md:5:Role: compiler engineer (glm). THE SPEC is the signed Addendum A (`collab/yang-clojure/1794630000000-architect-attribution-addendum-a-RECORD.md`) and the architect design doc (`collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md`) — read BOTH first, especially design §2 (the occurrence contract C1, the `:yang/call-site 1` reserved key, the coverage/validation rules) and §2.2 (the minimal persisted annotation). A fresh codex gate reviews against the design before landing.\nBRIEF-cc1.md:9:Per Addendum A3: adoption covers PRODUCTION compilation paths — oracle instrumentation is not coverage. This round implements, for the yang.clojure production compiler:\nBRIEF-cc1.md:11:1. The `:yang/call-site 1` reserved-key annotation emitted into the frontend-metadata side table for **every final `:application` occurrence** in the produced UAST — per design §2.1-2.2's identity rules (`[origin root-address path]`; the value is the version integer; the first three coordinates are the site id; NO callee identity, NO source arity, NO ambient classification in the key or value).\nBRIEF-cc1.md:12:2. The complete-coverage property: a consumer can derive the eligible application set from canonical rows and compare it with the marker set — under a C1 publication claim the sets must be equal (design §2.2's validation rules: duplicate transport deliveries dedupe; conflicting values, unsupported versions, nonexistent paths, non-application targets, missing/extra rows under a complete-coverage claim are validation failures).\nBRIEF-cc1.md:14:4. The coverage boundaries from design §2.1: `yin/def` lowering to `:define` gets an occurrence annotation and never a fictitious callee-entry event; dedicated operations (`:dao.stream.apply/call`, stream nodes, continuation nodes) keep their existing instruction provenance and are NOT counted as application sites; generated post-expansion trees carry their `[:expansion …]` origins honestly.\nBRIEF-cc1.md:18:The oracle's three-kind correspondence (ambient-literal / context-API carriers / delegation exclusion) is ORACLE-side attribution — out of scope here. This round emits the FACTS; the oracle and future consumers interpret them. The ts/php/py adoptions are separate rounds (rounds 2-4) — do not touch their preludes (track isolation; the relay thread collab/yang-call/1794800000001 records their inputs, including the centrally-fixed key name and the dynamic-call-site edge case which the DESIGN already covers via `[:expansion …]` origins — verify the design's answer covers their case and note any gap in your report rather than inventing semantics).\nBRIEF-cc1.md:30:- src/cljc/yang/clojure.cljc + its production publication path + test/yang/** for the new tests. NO yin.vm representation changes (provenance stays OUT of hashed code content — the occurrence/content boundary is A1's hard line). NO other frontends' files. The oracle's existing site-table format is untouched (it is the instantiation-#1 consumer).\n","exit_code":0,"status":"completed"}}
