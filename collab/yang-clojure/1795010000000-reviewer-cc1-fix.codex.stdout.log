   149\t\n   150\t\n   151\t(defn link-local\n   152\t  \"Link `format`'s image through the manifest `address` over `handle`'s\n   153\t   own content, `:verifying` with discharge deferred, as a serving\n   154\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\n   155\t   call, so no request reaches any peer.  `opts` overrides the link\n   250\t                       :yin.debruijn.register\n   251\t                       (mint sem r linker/register-lowering-profile)}\n   252\t                      :yin.module/index {:yin.debruijn.code h-address\n   253\t                                         :yin.debruijn.register r-address}\n   254\t                      :yin.module/exports (set exports)\n   255\t                      :yin.module/requires (or requires {})\n   256\t                      :yin.module/primitives\n   257\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   258\t                                    primitives))\n   259\t                      :yin.module/footprint fp}\n   260\t            address (jing/materialize! handle manifest)\n   261\t            ;; the C1 side table and its record, beside the manifest\n   262\t            call-sites (when (:rows claim)\n   263\t                         (let [table (jing/materialize! handle (:rows claim))\n   264\t                               record {:yang.call-site/manifest address\n   265\t                                       :yang.call-site/root (:root tree)\n   266\t                                       :yang.call-site/origin (:origin claim)\n   267\t                                       :yang.call-site/table table}]\n   268\t                           {:record (jing/materialize! handle record)\n   269\t                            :table table\n   270\t                            :origin (:origin claim)\n   271\t                            :root (:root tree)}))\n   272\t            walked (closure/walk handle address opts)]\n   273\t        (if (not= :complete (:yin.link.closure/outcome walked))\n   274\t          (refusal :yin.link.publish/incomplete-closure\n   275\t                   {:address address :walk walked})\n   276\t          (let [links (into {}\n   277\t                            (map (fn [f]\n   278\t                                   [(:format f)\n   326\t                                             (nth row 1))))]\n   327\t            (recur (into (subvec queue 1)\n   328\t                         (remove #(contains? rows %) kids))\n   329\t                   (assoc rows address row))))))))\n   330\t\n   331\t\n   332\t(defn published-call-site-table\n   333\t  \"The C1 side table published beside the module whose manifest is at\n   334\t   `address` in `handle`: `{:origin o :root r :rows [...] :tree tree}`\n   335\t   with the rows exactly as stored and the module's canonical tree, or\n   336\t   nil when the module made no C1 claim — nothing was published beside\n   337\t   it. The table and its record are content-addressed from the\n   338\t   manifest's tree, so their addresses are recomputed here and the\n   339\t   values then fetched: a module whose markers were never retained\n   340\t   answers nil, never a recomputation passed off as the published\n   341\t   table.\"\n   342\t  [handle address]\n   343\t  (let [manifest (jing/get handle address nil)]\n   344\t    (when (and (map? manifest) (:yin.module/tree manifest))\n   345\t      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n   346\t        (let [origin (publication-origin (:root tree))\n   347\t              rows (vec (sort-by pr-str\n   348\t                                 (map (fn [[r p]]\n   349\t                                        [origin r p :yang/call-site 1])\n   350\t                                      (vm/application-occurrences tree))))\n   351\t              table (jing/segment-key rows)\n   352\t              record {:yang.call-site/manifest address\n   353\t                      :yang.call-site/root (:root tree)\n   354\t                      :yang.call-site/origin origin\n   355\t                      :yang.call-site/table table}\n   356\t              stored-rows (jing/get handle table nil)\n   357\t              stored-record (jing/get handle (jing/segment-key record) nil)]\n   358\t          (when (and (some? stored-rows) (= record stored-record))\n   359\t            {:origin origin, :root (:root tree), :rows stored-rows,\n   360\t             :tree tree}))))))\n   361\t\n   362\t\n   363\t;; =============================================================================\n   364\t;; Deriving a module from indexed code (5.3)\n   365\t;; =============================================================================\n  1193\t  (update ctx :guards #(merge default-guards %)))\n  1194\t\n  1195\t\n  1196\t(defn- final-call-site-metadata\n  1197\t  \"The call-site occurrence contract's (C1) side table of an expanded\n  1198\t   final tree, as frontend-metadata rows `[origin root path\n  1199\t   :yang/call-site 1]` in printed-row order: one row per\n  1200\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\n  1201\t   that actually executes. The frontend's own markers named the\n  1202\t   pre-expansion tree; expansion, tail marking and stand-in lowering\n  1203\t   recompute roots and paths, so no pre-expansion table can cover this\n  1204\t   tree and the table is finalized here, over the finished rows. The\n  1205\t   origin is the run member's admission origin — the same coordinate\n  1206\t   the expander's event rows carry for a top-level frame. No\n  1207\t   expansion-record address is fabricated for the batch as a whole:\n  1208\t   the batch's attempts are individually recorded in the log, and the\n  1209\t   final tree is their admitted input's finished form.\"\n  1210\t  [row-set origin]\n  1211\t  (vec (sort-by pr-str\n  1212\t                (map (fn [[root path]] [origin root path :yang/call-site 1])\n  1213\t                     (vm/application-occurrences row-set)))))\n  1214\t\n  1215\t\n  1216\t(defn expand-batch\n  1217\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1218\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1219\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1220\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1270\t        (if-let [e (guard-batch-rows st)]\n  1271\t          (finish (fail st e))\n  1272\t          (let [[st root'] (expand-node st root\n  1273\t                                        {:path [], :rel [],\n  1274\t                                         :frame {:parent nil, :root root,\n  1275\t                                                 :tree-index run-index},\n  1276\t                                         :shadow #{}, :depth 0})]\n  1277\t            (if (:error st)\n  1278\t              (finish st)\n  1279\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1280\t                    [index root'] (retail (:index st) root')\n  1281\t                    [index root'] (lower-standins index root')\n  1282\t                    tree (packet-of index root')\n  1283\t                    metadata (final-call-site-metadata\n  1284\t                               (packet->row-set tree)\n  1285\t                               (source-origin ctx source-batch run-index))]\n  1286\t                (if-let [e (valid-tree? tree)]\n  1287\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1288\t                  (finish (assoc st :tree tree :next-store next-store\n  1289\t                                 :frontend-metadata metadata)))))))))))\n  1290\t\n  1291\t\n  1292\t(defn expand\n  1293\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1294\t   the error data.\"\n  1295\t  [batch ctx]\n  1380\t(defn ready?\n  1381\t  \"Ready only when both staged slots are empty.\"\n  1382\t  [expander]\n  1383\t  (and (nil? (:out-staged expander)) (nil? (:log-staged expander))))\n  1384\t\n  1385\t\n  1386\t(defn load\n  1387\t  \"Expand one observed batch once: keep the returned context, stage the tree\n  1388\t   only on success, stage the log when a log writer exists, and accumulate\n  1389\t   the error of a failed expansion. Expansion failure is data, so the\n  1390\t   cursor advances past it. A successful expansion's C1 side table (the\n  1391\t   batch result's `:frontend-metadata`) is retained on the consumer as\n  1392\t   `:frontend-metadata`, so the composition that drives this expander —\n  1393\t   the REPL's session — holds the executed tree's coverage beside the\n  1394\t   expander that produced it.\"\n  1395\t  [expander batch]\n  1396\t  (let [{:keys [status tree log error ctx frontend-metadata]}\n  1397\t        (expand-batch batch (:ctx expander))]\n  1398\t    (cond-> (assoc expander :ctx ctx)\n  1399\t      (= :ok status) (assoc :out-staged tree\n  1400\t                            :frontend-metadata frontend-metadata)\n  1401\t      (:log expander) (assoc :log-staged log)\n  1402\t      (= :error status) (update :errors conj error))))\n  1403\t\n  1404\t\n  1405\t(defn- flush-slot\n  1406\t  [expander writer-key slot-key on-ok]\n  1407\t  (if-let [payload (get expander slot-key)]\n  1408\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\n  1409\t      (case outcome\n  1410\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\n  1790\t                   (if (= :forms (:input binding)) (read-forms input) input)))))\n  1791\t\n  1792\t\n  1793\t(defn- compile-command-ast\n  1794\t  \"The AST `(compile ...)` previews.  It lowers against a primed frontend\n  1795\t   session: a session-staged frontend carries its prelude only on the\n  1796\t   session's first lowering, and the preview is of the submitted form, not\n  1797\t   of the runtime it would run on.  The session itself is not touched.\"\n  1798\t  [state arg]\n  1799\t  (let [state (assoc state :frontend-session :primed)]\n  1800\t    (cond\n  1801\t      (string? arg) (compile-source state arg)\n  1802\t      (forms-input? state) (compile-input state nil [arg])\n  1803\t      :else (throw (ex-info \"This compile command expects a source string\"\n  1804\t                            {:lang (:lang state) :arg arg})))))\n  1805\t\n  1806\t\n  1807\t(defn- render-compile-output\n  1808\t  \"Render the frontend syntax, the input row batch, and what the session's\n  1809\t   expander would make of it against its current store: the expanded tree\n  1810\t   packet (or the expansion error) and the event rows.  The expansion is a\n  1811\t   preview; its context is discarded, so nothing is committed.\"\n  1812\t  [state ast]\n  1813\t  (let [batch (encoder/program-batch ast)\n  1814\t        {:keys [tree error log]}\n  1815\t        (macro/expand-batch batch (get-in state [:expander :ctx]))]\n  1816\t    (str \"AST:\\n\" (format-value ast)\n  1817\t         \"\\n\\nInput rows:\\n\" (format-value batch)\n  1818\t         (if tree\n  1819\t           (str \"\\n\\nExpanded rows:\\n\" (format-value tree))\n  1820\t           (str \"\\n\\nExpansion error:\\n\" (format-value error)))\n  1821\t         \"\\n\\nEvents:\\n\" (format-value (second log)))))\n  1822\t\n  1823\t\n  1824\t(defn- rebuild-session\n  1825\t  \"Replace the VM, the expander, and their media, attachments, and\n  1826\t   observers.  The value history is cleared with them: a closure in `*1`\n  1827\t   names a code segment the old VM held, which the new one does not.  The\n  1828\t   new expander holds only the standard forms.  A require still pending\n  1829\t   on the old VM is dropped with it: its link pair is the session's, and\n  1830\t   the new session answers from its own.\n  1831\t\n  1832\t   Over a durable store the code index is not the session's to drop: the\n  1833\t   new indexer continues the old one's log, entity allocation, and\n  1834\t   published manifest (`yin.repl.index/carry-over`), so a rebuild never\n  1835\t   resets `t`.  Over the memory store it starts empty, as it always has.\"\n  1836\t  [state vm-type]\n  1837\t  (merge state\n  1838\t         (cond-> (make-session vm-type (:output-stream state)\n  1839\t                               (merge (selected-primitives (:frontends state)\n  1840\t                                                           (:lang state))\n","exit_code":0,"status":"completed"}}
