\n     (fn [t]\n       (if (= t :string)\n         true\n         (if (= t :number) true (if (= t :symbol) true (= t :bigint)))))]\n    [js/callable?\n     (fn [x]\n       (yang.call/eligible? x))]\n    [js/mknum (fn [x] (data/float64 x))]\n(ns yang.core.call\n  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n   §8.10). This namespace emits the same pure definitions into bundled\n   preludes and the linked `yang.call` module.\"\n  (:require [yang.core.prelude :as core]\n            [yang.core.uast :as u]))\n\n\n(def module-name\n  \"The linker module that publishes the shared calling runtime.\"\n  'yang.call)\n\n\n(def host-names\n  \"Host module names read by the guest definitions.\"\n  '#{cell/get data/callable? data/contains? data/count data/map? data/nth\n     data/string? data/vector?})\n\n\n(def definitions\n  \"The one ordered definition list used by both emitters.\"\n  '[;; Descriptor projection remains structural after callable admission.\n    [yang.call/_descriptor\n     (fn [callable]\n       (if (data/map? callable)\n         (if (= (get callable :type) :cell-ref)\n           (cell/get callable)\n           callable)\n         nil))]\n    [yang.call/entry\n     (fn [callable]\n       (get (yang.call/_descriptor callable) :yang.call/entry))]\n    [yang.call/eligible?\n     (fn [callable]\n       (let [descriptor (yang.call/_descriptor callable)]\n         (if (nil? (yang.call/entry callable))\n           false\n           (if (data/contains? descriptor :yang.call/eligible?)\n             ((get descriptor :yang.call/eligible?) callable)\n             true))))]\n    [yang.call/invocation\n     (fn [callee positional named raise]\n       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/invocation-with\n     (fn [callee positional named raise options]\n       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n                            :yang.call/positional positional)\n                     :yang.call/named named)\n              :yang.call/raise raise))]\n    [yang.call/_pair?\n     (fn [pair]\n       (if (data/vector? pair)\n         (= (data/count pair) 2)\n         false))]\n    [yang.call/_named-pairs?\n     (fn [pairs index]\n       (if (= index (data/count pairs))\n         true\n         (let [pair (data/nth pairs index)]\n           (if (yang.call/_pair? pair)\n             (if (data/string? (data/nth pair 0))\n               (yang.call/_named-pairs? pairs (+ index 1))\n               false)\n             false))))]\n    [yang.call/valid-invocation?\n     (fn [invocation]\n       (if (data/map? invocation)\n         (if (data/contains? invocation :yang.call/callee)\n           (if (data/contains? invocation :yang.call/positional)\n             (if (data/contains? invocation :yang.call/named)\n               (if (data/contains? invocation :yang.call/raise)\n                 (if (data/vector? (get invocation :yang.call/positional))\n                   (if (data/vector? (get invocation :yang.call/named))\n                     (yang.call/_named-pairs?\n                       (get invocation :yang.call/named) 0)\n                     false)\n                   false)\n                 false)\n               false)\n             false)\n           false)\n         false))]\n    [yang.call/condition\n     (fn [reason evidence]\n       (assoc (assoc {} :yang.call/reason reason)\n              :yang.call/data evidence))]\n    [yang.call/thrown\n     (fn [value]\n       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n              :yang.call/value value))]\n    [yang.call/transfer\n     (fn [raise condition]\n       (raise condition))]\n    [yang.call/invoke\n     (fn [callable positional named raise]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation callable positional named raise)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]\n    [yang.call/invoke-with\n     (fn [callable positional named raise options]\n       (if (data/callable? raise)\n         (if (yang.call/eligible? callable)\n           (let [target (yang.call/entry callable)\n                 record (yang.call/invocation-with\n                          callable positional named raise options)]\n             (if (not (nil? target))\n               (if (yang.call/valid-invocation? record)\n                 (target record)\n                 (yang.call/transfer\n                   raise\n                   (yang.call/condition :yang.call/invalid-invocation\n                                        {:yang.call/callee callable})))\n               (yang.call/transfer\n                 raise\n                 (yang.call/condition :yang.call/invalid-invocation\n                                      {:yang.call/callee callable}))))\n           (yang.call/transfer\n             raise\n             (yang.call/condition :yang.call/not-callable\n                                  {:yang.call/callee callable})))\n         (raise (yang.call/condition :yang.call/invalid-invocation\n                                     {:yang.call/reason :missing-raise-exit}))))]])\n\n\n  \"True when `operator` is the `apply` intrinsic: not bound locally and not\n   defined by the program.\"\n  [env operator]\n  (and (= 'apply operator)\n       (not (contains? (locals env) operator))\n       (not (contains? (::defined env) operator))))\n\n\n(defn- compile-guest-call\n  \"Admit a source operator before common invocation. Only generated UAST\n   implementation calls apply private closures directly.\"\n  [callee-ast arguments-ast env tail?]\n  (if-not (outcomes? env)\n    (cond-> (u/app callee-ast arguments-ast)\n      tail? (assoc :tail? true))\n    (let [callee (symbol (str reserved-prefix \"callee\"))\n          arguments (symbol (str reserved-prefix \"arguments\"))\n          escape (symbol (str reserved-prefix \"raise_escape\"))\n          condition (symbol (str reserved-prefix \"condition\"))\n          result (symbol (str reserved-prefix \"call_result\"))\n          condition->outcome (u/if-node\n                               (u/app (u/v 'dsg__equal)\n                                      (u/app (u/v 'dsg__get) (u/v condition)\n                                             (u/lit :yang.call/reason))\n                                      (u/lit :yang.call/thrown))\n                               (outcome-node\n                                 error-tag\n                                 (u/app (u/v 'dsg__get) (u/v condition)\n                                        (u/lit :yang.call/value)))\n                               (outcome-node error-tag (u/v condition)))\n          raise (u/lam [condition]\n                       (assoc (u/app (u/v escape)\n                                     (u/app (u/v 'dsg__assoc) (u/lit {})\n                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n                                            (u/lit :clj/outcome) condition->outcome))\n                              :tail? true))\n          common-call (u/let1\n                        result\n                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n                               (u/lit []) raise)\n                        (outcome-node ok-tag (u/v result)))\n          refused (outcome-node\n                    error-tag\n                    (u/app (u/v 'yang.call/condition)\n                           (u/lit :yang.call/not-callable)\n                           (u/app (u/v 'dsg__assoc) (u/lit {})\n                                  (u/lit :yang.call/callee) (u/v callee))))\n          activation (u/if-node\n                       (u/app (u/v 'data/callable?) (u/v escape))\n                       common-call\n                       ;; Applying the escape resumes the capture operand.\n                       ;; Only our authenticated transfer packet may resume\n                       ;; here; an invalid captured value explicitly refuses.\n                       (u/if-node\n                         (u/app (u/v 'dsg__equal)\n                                (u/app (u/v 'dsg__get) (u/v escape)\n                                       (u/lit :clj/escape-token))\n                                (u/v 'dsg__call_token))\n                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\n                         (outcome-node\n                           error-tag\n                           (u/app (u/v 'yang.call/condition)\n                                  (u/lit :yang.call/invalid-invocation)\n                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\n          public-bridge (u/app (u/lam [escape] activation) u/capture)\n          bridged (if tail?\n                    (u/if-node\n                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\n                      (u/app (u/v 'yang.call/invoke-with)\n                             (u/v callee) (u/v arguments) (u/lit [])\n                             (u/lam [condition] condition->outcome)\n                             (u/app (u/v 'dsg__assoc) (u/lit {})\n                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\n                      public-bridge)\n                    public-bridge)\n          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n                              bridged refused)\n          ;; A callee carrying a call entry is convention territory whether it\n          ;; admits or forges one, so admission rules it. Everything else is a\n          ;; data-side invocation - a collection lookup or a raw closure call -\n          ;; and the guest library's invoker owns those semantics. The invoker\n          ;; is itself a published descriptor, so it is reached the same way\n          ;; any guest callee is; its raise escapes to a capture of this site\n          ;; and the resumed pass materializes the error outcome here.\n          value-call (u/app\n                       (u/lam ['dsg__raise_escape]\n                              (u/if-node\n                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\n                                (u/let1\n                                  (symbol (str reserved-prefix \"invoker_result\"))\n                                  (u/app (u/v 'yang.call/invoke)\n                                         (u/v 'invoke-value)\n                                         (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\n                                         (u/lit [])\n                                         (u/lam [condition]\n                                                (assoc (u/app (u/v 'dsg__raise_escape)\n                                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n                                                                     (u/lit :clj/outcome) condition->outcome))\n                                                       :tail? true)))\n                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \"invoker_result\")))))\n                                (u/if-node\n                                  (u/app (u/v 'dsg__equal)\n                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n                                                (u/lit :clj/escape-token))\n                                         (u/v 'dsg__call_token))\n                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n                                  (outcome-node\n                                    error-tag\n                                    (u/app (u/v 'yang.call/condition)\n                                           (u/lit :yang.call/invalid-invocation)\n                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n                       u/capture)\n          routed (if (::invoker env)\n                   (u/if-node\n                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n                                           (u/lit true)\n                                           (u/app (u/v 'dsg__equal)\n                                                  (u/app (u/v 'dsg__get) (u/v callee) (u/lit :type))\n                                                  (u/lit :cell-ref)))\n                                (u/lit false))\n                     admitted\n                     value-call)\n                   admitted)]\n      (cond-> (u/mark-tails (u/let1 callee callee-ast\n                                    (u/let1 arguments arguments-ast routed)))\n        tail? (assoc :tail? true)))))\n\n\n(defn- compile-apply\