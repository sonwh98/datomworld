IR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-8p5v6iMX' (errno=Operation not permitted)\n2026-11-04 02:54:46.734 xcodebuild[36586:108190877]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-04 02:54:46.958 xcodebuild[36586:108190876] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\n src/cljc/yang/clojure.cljc                  | 188 ++++++++++++++++++++++++++--\n src/cljc/yang/clojure/prelude.cljc          | 165 ++++++++++++++++++++++++\n src/cljc/yang/typescript/antlr/prelude.cljc |   6 +-\n test/yang/call/conformance.clj              |  78 +++++++++---\n test/yang/cross_lang_test.clj               |  42 ++++---\n 5 files changed, 432 insertions(+), 47 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-OimK0Q1Y' (errno=Operation not permitted)\n2026-11-04 02:54:48.250 xcodebuild[36593:108190904]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-04 02:54:48.441 xcodebuild[36593:108190903] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-EAzHQfVm' (errno=Operation not permitted)\n2026-11-04 02:54:48.991 xcodebuild[36597:108190919]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-11-04 02:54:49.177 xcodebuild[36597:108190918] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ndiff --git a/src/cljc/yang/clojure.cljc b/src/cljc/yang/clojure.cljc\nindex 6259328b..4f0d9e74 100644\n--- a/src/cljc/yang/clojure.cljc\n+++ b/src/cljc/yang/clojure.cljc\n@@ -28,8 +28,11 @@\n \n   The compiler is written in .cljc format to run on both JVM and Node.js.\"\n   (:refer-clojure :exclude [compile])\n-  (:require [yang.core.call :as call]\n-            [yang.core.uast :as u]))\n+  (:require [clojure.tools.reader :as treader]\n+            [clojure.tools.reader.reader-types :as rt]\n+            [yang.core.call :as call]\n+            [yang.core.uast :as u]\n+            [yin.vm :as vm]))\n \n \n ;; Forward declaration for mutual recursion\n@@ -1305,7 +1308,11 @@\n           routed (if (::invoker env)\n                    (u/if-node\n                      (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n-                                (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n+                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n+                                           (u/lit true)\n+                                           (u/app (u/v 'dsg__equal)\n+                                                  (u/app (u/v 'dsg__get) (u/v callee) (u/lit :type))\n+                                                  (u/lit :cell-ref)))\n                                 (u/lit false))\n                      admitted\n                      value-call)\n@@ -2096,14 +2103,27 @@\n                            (u/sexp->uast\n                              '(fn [dsg__candidate]\n                                 (if (data/map? dsg__candidate)\n-                                  (let [dsg__entry (dsg__get dsg__candidate :yang.call/entry)\n-                                        dsg__witness (dsg__get dsg__candidate :clj/admission)]\n-                                    (if (data/callable? dsg__entry)\n-                                      (dsg__equal\n-                                        dsg__witness\n-                                        (dsg__make_admission\n-                                          (dsg__assoc dsg__candidate :clj/admission nil)))\n-                                      false))\n+                                  (if (dsg__equal (dsg__get dsg__candidate :type)\n+                                                  :cell-ref)\n+                                    ;; A cell-backed callable stores its entry\n+                                    ;; in the cell contents (yang.antlr.md\n+                                    ;; 8.10.2); projection is structural, as\n+                                    ;; `yang.call/_descriptor` projects it.\n+                                    ;; Only the cell case dereferences, so a\n+                                    ;; source map with an entry spelling\n+                                    ;; still needs the witness below.\n+                                    (let [dsg__descriptor (cell/get dsg__candidate)\n+                                          dsg__entry (dsg__get dsg__descriptor\n+                                                               :yang.call/entry)]\n+                                      (data/callable? dsg__entry))\n+                                    (let [dsg__entry (dsg__get dsg__candidate :yang.call/entry)\n+                                          dsg__witness (dsg__get dsg__candidate :clj/admission)]\n+                                      (if (data/callable? dsg__entry)\n+                                        (dsg__equal\n+                                          dsg__witness\n+                                          (dsg__make_admission\n+                                            (dsg__assoc dsg__candidate :clj/admission nil)))\n+                                        false)))\n                                   false))))\n          (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n          (outcomes? env) (u/let1\n@@ -2620,3 +2640,149 @@\n                           {:type :literal, :value 2}]}}\"\n   [form]\n   (compile-form form true {}))\n+\n+\n+;; =============================================================================\n+;; The linked runtime entry (the conformance matrix round, yang.antlr.md\n+;; section 8.10)\n+;; =============================================================================\n+;;\n+;; A linked clojure program is published as an ordinary linker module whose\n+;; one export, `body`, is its unmodified lowered unit, and run under its own\n+;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\n+;; `read-forms` is the frontend's parser — the reader itself — and\n+;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n+;; whose call runs the program compiled under the argument-vector\n+;; convention and the outcome model over the guest library, with every\n+;; top-level definition published to the runtime global namespace\n+;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n+;; its module's globals. No call node is rewritten and no foreign\n+;; `:code` is extracted: the unit is the program's own lowering,\n+;; wrapped.\n+\n+(def unit-opts\n+  \"The `compile-program` opts a linked unit compiles with: the\n+   argument-vector convention with the outcome model over the guest\n+   library's adapters, every VM primitive callable directly by bare name.\"\n+  {:convention :arg-vector,\n+   :outcomes true,\n+   :adapters library-adapters,\n+   :native vm/primitive-profiles})\n+\n+\n+(def top-defining-operators\n+  \"The operators whose second element names a top-level definition.\"\n+  '#{def defn defn- defmacro})\n+\n+\n+(defn read-forms\n+  \"Every form `source` text reads. The reader is the parser: a malformed\n+   source throws, as any frontend's refused parse does.\"\n+  [source]\n+  (let [rd (rt/string-push-back-reader source)]\n+    (loop [forms []]\n+      (let [form (treader/read rd false ::eof)]\n+        (if (= form ::eof)\n+          forms\n+          (recur (conj forms form)))))))\n+\n+\n+(defn top-level-names\n+  \"The names `forms` define at the top level, in order: the second element\n+   of each def/defn/defn-/defmacro head.\"\n+  [forms]\n+  (into []\n+        (comp (filter #(and (seq? %) (contains? top-defining-operators (first %))))\n+              (map (comp strip-symbol-meta second)))\n+        forms))\n+\n+\n+(declare publish-to-globals)\n+\n+\n+(defn- globals-child\n+  [x names bound]\n+  (cond\n+    (and (map? x) (contains? x :type)) (publish-to-globals x names bound)\n+    (vector? x) (mapv #(globals-child % names bound) x)\n+    :else x))\n+\n+\n+(defn- publish-to-globals\n+  \"Rewrite the compiled `node` for the linked unit: a top-level\n+   definition in `names` becomes a `clj/define-global!` write and a free\n+   read of one becomes a `clj/global-get`, both under the name's string.\n+   A store definition inside the unit thunk is conditional to the\n+   linker, so no body read of it discharges (the runtime preludes avoid\n+   this by keeping every definition at module level); the runtime\n+   global namespace is the linked unit's definition table instead, as\n+   a Python module body writes its dictionary. Lexically bound names,\n+   quoted literals and macro definitions keep their store shape: a\n+   macro is not a runtime value.\"\n+  [node names bound]\n+  (case (:type node)\n+    :literal node\n+    :vm/current-continuation node\n+    :variable (if (and (contains? names (:name node))\n+                       (not (contains? bound (:name node))))\n+                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\n+                node)\n+    :lambda (assoc node :body (publish-to-globals (:body node) names\n+                                                  (into bound (:params node))))\n+    :application\n+    (if (and (= 'yin/def (get-in node [:operator :name]))\n+             (= 2 (count (:operands node)))\n+             (= :literal (:type (first (:operands node))))\n+             (contains? names (:value (first (:operands node)))))\n+      (u/app (u/v 'clj/define-global!)\n+             (u/lit (str (:value (first (:operands node)))))\n+             (publish-to-globals (second (:operands node)) names bound))\n+      (assoc node\n+             :operator (publish-to-globals (:operator node) names bound)\n+             :operands (mapv #(publish-to-globals % names bound)\n+                             (:operands node))))\n+    :if (cond-> node\n+          (contains? node :test)\n+          (assoc :test (publish-to-globals (:test node) names bound))\n+          (contains? node :consequent)\n+          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n+          (contains? node :alternate)\n+          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n+    (reduce (fn [n k]\n+              (let [v (get n k)]\n+                (if (or (and (map? v) (contains? v :type)) (vector? v))\n+                  (assoc n k (globals-child v names bound))\n+                  n)))\n+            node (keys node))))\n+\n+\n+(defn lower-unit\n+  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n+   thunk whose call runs the program — `forms` plus the definitions of\n+   the guest library they need, compiled unmodified under `unit-opts`\n+   and published to the runtime global namespace by\n+   `publish-to-globals` — so the helper's export projection can read\n+   each top-level definition. The program's own `yang.call` call sites\n+   need no free-name declaration: the convention preamble\n+   `compile-program` emits defines those names locally, and the donor\n+   publication pins the `yang.call` module for the qualified reads\n+   that remain.\"\n+  [forms]\n+  (let [source (vec forms)\n+        library (library-for source)\n+        program (compile-program (concat source library) true unit-opts)\n+        macros (into #{}\n+                     (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n+                           (map (comp strip-symbol-meta second)))\n+                     (concat source library))\n+        names (reduce disj\n+                      (into (set (top-level-names source))\n+                            (map (comp strip-symbol-meta second) library))\n+                      macros)]\n+    (u/lam [] (publish-to-globals program names #{}))))\n+\n+\n+(defn output\n+  \"The `clj/run-main` value as test data.\"\n+  [value]\n+  (pr-str value))\ndiff --git a/src/cljc/yang/clojure/prelude.cljc b/src/cljc/yang/clojure/prelude.cljc\nnew file mode 100644\nindex 00000000..ca8556dd\n--- /dev/null\n+++ b/src/cljc/yang/clojure/prelude.cljc\n@@ -0,0 +1,165 @@\n+(ns yang.clojure.prelude\n+  \"The `clj` runtime module (docs/design/yang.antlr.md section 8.10):\n+   the published linker module every linked clojure program requires, as\n+   `js`, `php` and `py` are for their frontends. It is written in prelude\n+   notation and emitted with the same core machinery those preludes use;\n+   it never runs on the host.\n+\n+   Three surfaces, mirroring the other runtimes:\n+\n+   - the entry, `clj/run-main`: initialize the runtime state, reset the\n+     global namespace (it is task-local), run the unit — the thunk\n+     `yang.clojure/lower-unit` lowered — and answer the program's value\n+     with the outcome model's `[:yin.k/ok value]` wrapper removed, since\n+     that wrapper is frontend-internal;\n+   - the runtime global namespace, `clj/define-global!` and\n+     `clj/global-get`: a task-local map in a cell (`clj.rt/globals`,\n+     allocated once per task by `clj/init!`), keyed by export name. A\n+     program's top-level definitions land here through its unit's own\n+     publishing, and the conformance helper's export projection reads and\n+     writes it — the JS `globalThis` table, the PHP named-function table\n+     and the Python module dictionary are the same seam;\n+   - admission, `admit`: the registry surface a linked clojure composition\n+     needs beside the others — the `kind` module and the `portable`\n+     adapters of the data exports the guest library's collection\n+     predicates read.\n+\n+   The module pins the shared calling runtime (`yang.call`) at the\n+   convention's call-address, as the other runtimes do, and refuses before\n+   anything is published when a free name nothing supplies is read.\"\n+  (:require [yang.core.prelude :as core]\n+            [yang.clojure :as yang]\n+            [yin.vm :as vm]\n+            [yin.vm.data :as data]\n+            [yin.vm.module :as module]))\n+\n+\n+(def module-name\n+  \"The linker module name of the clojure runtime.\"\n+  'clj)\n+\n+\n+(def runtime-keys\n+  \"Every runtime key, each with an `:clj/uninit` placeholder at module\n+   level so every read is discharged before `clj/init!` allocates the\n+   real cell. They stay qualified: internal store keys, never guest\n+   names.\"\n+  '[clj.rt/state clj.rt/globals])\n+\n+\n+(def definitions\n+  \"The module's definition list, in prelude notation (the module's own\n+   `clj/` prefix is stripped on emit).\"\n+  '[;; ------------------------------------------------- state and namespace\n+    [clj/init!\n+     (fn []\n+       (if (= clj.rt/state :clj/uninit)\n+         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n+             (yin/def (quote clj.rt/state) :clj/ready))\n+         :clj/ready))]\n+    ;; the runtime global namespace: one task-local map in a cell, keyed by\n+    ;; export name. `clj/define-global!` answers the value, so a publish\n+    ;; sequence can chain through it.\n+    [clj/define-global!\n+     (fn [name value]\n+       (do (cell/set! clj.rt/globals\n+                      (assoc (cell/get clj.rt/globals) name value))\n+           value))]\n+    [clj/global-get\n+     (fn [name]\n+       (if (data/contains? (cell/get clj.rt/globals) name)\n+         (get (cell/get clj.rt/globals) name)\n+         :clj/unbound))]\n+\n+    ;; ------------------------------------------------------------- entry\n+    ;; The outcome model's `[:yin.k/ok value]` wrapper is frontend-\n+    ;; internal, so the entry removes one wrapper level from the\n+    ;; program's value (a program returning that vector as data was\n+    ;; wrapped again, so one level is exact). An error outcome passes\n+    ;; through as the failure value for the caller to render.\n+    [clj/unwrap-outcome\n+     (fn [value]\n+       (if (if (data/vector? value) (= (data/count value) 2) false)\n+         (if (= (data/nth value 0) :yin.k/ok)\n+           (data/nth value 1)\n+           value)\n+         value))]\n+    [clj/run-main\n+     (fn [body]\n+       (do (clj/init!)\n+           (cell/set! clj.rt/globals {})\n+           (clj/unwrap-outcome (body))))]])\n+\n+\n+(def module-definitions\n+  \"The module's definition list: an `:clj/uninit` placeholder for every\n+   runtime key, then every definition, stripped.\"\n+  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n+\n+\n+(def module-uast\n+  \"The module tree: one wide application over the definitions, so every\n+   sibling and runtime key read is discharged at module level.\"\n+  (core/module-tree module-definitions []))\n+\n+\n+(def module-exports\n+  \"The module's exports: every `clj/` key of the definition list, stripped.\"\n+  (core/exports \"clj\" definitions))\n+\n+\n+(def ^:private module-free-names\n+  \"The names the module tree reads and does not define, sorted: the host\n+   exports its manifest must declare.\"\n+  (core/free-name-vec module-uast))\n+\n+\n+(defn module-spec\n+  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `clj` over\n+   the host registry `registry`, pinned to the published `yang.call`\n+   module at `call-address` — the convention's call-address, as every\n+   runtime's publication carries. A free name nothing supplies is refused\n+   before anything is published. This namespace emits; it never publishes.\"\n+  [registry call-address]\n+  (core/module-spec {:module-name module-name,\n+                     :ast module-uast,\n+                     :exports module-exports,\n+                     :requires {'yang.call call-address},\n+                     :free-names module-free-names,\n+                     :skip? #(= \"yang.call\" (namespace %)),\n+                     :registry registry,\n+                     :message \"the clj module reads an undeclared name\",\n+                     :refusal-ns \"yang.clojure\"}))\n+\n+\n+(defn register-library-module\n+  \"Return `registry` with host module `name` installed over `entries`\n+   (`[export function]` pairs) at `arities`, each export pure.\"\n+  [registry name entries arities]\n+  (module/register-host-module\n+    registry name\n+    (into {} entries)\n+    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n+          entries)))\n+\n+\n+(defn admit\n+  \"Return `registry` with the guest library's host surface installed: the\n+   `kind` module and the `portable` adapters of the data exports the\n+   collection predicates read (yang.clojure's `library-adapters`). A\n+   linked clojure composition registers them beside the other runtimes'\n+   registry surfaces; a composition without a clojure program reads none\n+   of them.\"\n+  [registry]\n+  (let [portable (into {}\n+                       (map (fn [[source _]]\n+                              (let [op (symbol (name source))]\n+                                [op (yang/outcome-adapter data/refusal-message\n+                                                          (get data/data-module op))])))\n+                       yang/library-adapters)]\n+    (-> registry\n+        (register-library-module 'kind yang/kind-module yang/kind-arities)\n+        (register-library-module\n+          'portable portable\n+          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n+                (keys portable))))))\ndiff --git a/src/cljc/yang/typescript/antlr/p