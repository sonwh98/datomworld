{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat bb.edn | head -100 && rg -n 'cross.lang|test:sub:clj' bb.edn\"","aggregated_output":"{:tasks\n {gen:antlr\n  {:doc \"Generate the pinned grammars-v4 parsers for every target (antlr/*/manifest.edn): Java compiled into build/antlr/<g>/classes, JavaScript in build/antlr/<g>/js, Dart in lib/antlr/<g>; filters after --: --grammar g --target t\"\n   :task (apply shell \"bb\" \"src/dev/build_cache.clj\"\n                \"antlr\" *command-line-args*)}\n\n  autobahn:jolt\n  {:doc \"J6f Autobahn conformance: starts the testee and the Dockerized pinned suite, waits for the READY barrier, runs harness.py per role, collects results/, and shuts both sides down. Usage: bb autobahn:jolt <role> <agent>\"\n   :task (apply shell {:continue true} \"bash\" \"tools/jolt-autobahn/launch.sh\" *command-line-args*)}\n\n  deps:npm\n  {:doc \"Worktree-local npm ci, reused only while input and installed-file digests match\"\n   :task (shell \"bb\" \"src/dev/build_cache.clj\" \"npm\")}\n\n  ;; jolt host lane (experimental, docs/design/yin.repl-jolt-implementation.md)\n  bootstrap:jolt\n  {:doc \"Materialize the jolt-toolchain.edn pins into build/tools/jolt (mise Chez/CMake checked, jolt cloned at the full SHA, never pulled) and write build/tools/jolt-env.sh\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\")))}\n\n  test:jolt-bootstrap-neg\n  {:doc \"Copy/revert the jolt clone under gitignored build/bootstrap-neg (deleted on success, retained on failure) and declare a synthetic patch and prove bootstrap refuses it unapplied or corrupted, then accepts it applied (JOLT_BOOTSTRAP_TEST_DIR selects the source clone)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\" \"--test-negative\")))}\n\n  smoke:jolt\n  {:doc \"J0a baseline smoke under jolt -Srepro -M:jolt: tracked load of yang.antlr.export/packet and defcfn :blocking calls (needs bb bootstrap:jolt)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"sh\" \"-c\"\n                         \". build/tools/jolt-env.sh && \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt src/dev/jolt_smoke.clj\")))}\n\n  jolt\n  {:doc \"Run jolt -Srepro -M:jolt with the arguments given (a script path, -e ...), under build/tools/jolt-env.sh\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"sh\" \"-c\"\n                         \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt \\\"$@\\\"\"\n                         \"jolt\" *command-line-args*)))}\n\n  qualify:jolt-libcrypto\n  {:doc \"J1b requalification: print this platform's observed libcrypto identity {:canonical-path :version-num :version :sha256} for jolt-toolchain.edn :native :libcrypto :qualified (the digest from bb and from the library, required equal); changes nothing (needs a built wrapper: bb build:jolt-native, or --requalify after a library change)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"native/jolt-crypto/qualify.clj\")))}\n\n  probe:jolt-crypto\n  {:doc \"J1b: libcrypto provenance (qualified, missing, undeclared, version-floor, wrong-library-first, Linux LD_PRELOAD) and 256 MiB :blocking hash collect-safety, each in a child jolt process (needs bb build:jolt-native)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"native/jolt-crypto/probes/run.clj\")))}\n\n  test:jolt-j5\n  {:doc \"J5 acceptance: one Python session through the JVM and jolt REPL entry points with the standard catalog (output equal line for line), the multiline probe sequence, and the unavailable-library REPL legs (needs bb build:jolt-native)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_j5_acceptance.clj\")))}\n\n  probe:jolt-j5\n  {:doc \"J5b: the native Python parser's budget (input 4 MiB; in-parser guards: 8192 rule frames, 4096 SLL lookahead links, 256 full-LL links, on a 16 MiB parse thread): the review's repros, at/over per shape against the predicted table, 10x the old crash depths, the JVM's packets (incl. a 20,000-deep 1+ tree), the old crash depths in children on the jolt thread, injected C++ faults, the abort-is-a-failure property, lifecycle and unavailable-library legs. Args select legs: budget below crash inject abort unavailable (needs bb build:jolt-native)\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"bb\" \"src/dev/jolt_j5_run.clj\" *command-line-args*)))}\n\n  calibrate:jolt-j5\n  {:doc \"J5b C4 + J5c: build the guards-off calibration variant of native/jolt-parser and record each nesting shape's stack cost per rule frame and per lookahead link on the 16 MiB parse thread (asserting every bound fits a quarter of the stack; writes build/j5b/calibration.edn), or, with --work, the work metric's per-shape counts and the corpus sweep the work bound derives from (writes build/j5b/work.edn; needs bb build:jolt-native)\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"bb\" \"-cp\" \"src/dev\"\n                         \"src/dev/jolt_j5_calibrate.clj\" *command-line-args*)))}\n\n  probe:jolt-file\n  {:doc \"J4a: native/jolt-file gates, each in a child process: JVM-identical frame bytes (both hash algorithms), F2 s32BE prefixes, strict reads, injected short/EINTR/zero-progress/error transfers, corrupt-open byte identity, idempotent close, no fd or native-memory leak, a full collection during a 1 GiB :blocking pwrite, missing/wrong-layout wrapper refused before guest work, exported-symbol allowlist (needs bb build:jolt-native)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"native/jolt-file/probes/run.clj\")))}\n\n  probe:jolt-udp\n  {:doc \"J0b probe: raw nonblocking SOCK_DGRAM over jolt.ffi on macOS arm64 and Linux x86_64, printing the platform header first (needs bb bootstrap:jolt)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"sh\" \"src/dev/jolt_udp_probe.sh\")))}\n\n  probe:jolt-tcp\n  {:doc \"J6d: the jolt TCP substrate and owner-thread pump (dao.stream.ws.tcp, dao.stream.ws.pump, driver sleep-fds!), one child jolt process per section: closure (no jolt.socket), address (literals/localhost, resolver trap), substrate (port 0, nonblocking accept/connect, EOF vs reset, gone-peer write survives), ordered (A3 short write, drain order, failure), fairness (A1 ii/iv), stdin (A1 i, held partial line), deadline (A2 seam), control (A3 event orders, A4 pong budget, D1 close slot), close (A5, D2, D3), listener (64 cap, lower-deadlines!, drained?); native memory and registry empty after close. Arguments select sections (needs bb bootstrap:jolt)\"\n   :task (let [sections (or (seq *command-line-args*)\n                            [\"closure\" \"address\" \"substrate\" \"ordered\" \"fairness\" \"stdin\"\n                             \"deadline\" \"control\" \"close\" \"listener\"])\n               results (mapv (fn [s]\n                               (println \"== probe:jolt-tcp section\" s)\n                               [s (:exit (shell {:continue true} \"sh\" \"-c\"\n                                                \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt src/dev/jolt_tcp_probe.clj \\\"$1\\\"\"\n                                                \"jolt\" s))])\n                             sections)]\n           (println \"probe:jolt-tcp exits\" (pr-str results))\n           (System/exit (if (every? (comp zero? second) results) 0 1)))}\n\n  probe:jolt-ws\n  {:doc \"J6e: the jolt WebSocket host adapter (dao.stream.ws.jolt, the yin.repl.host shadow, the jolt -main wiring), one child jolt process per section: closure (C1), handshake (C2), bind (C3), address (C4), io (C5), close (C6), shutdown (C7, the real owner loop), isolation (C8), driver (C9, deadline folding, a --headless --port child), fairness (C10); native memory and registries empty after close. Arguments select sections (needs bb bootstrap:jolt and bb build:jolt-native)\"\n   :task (let [sections (or (seq *command-line-args*)\n                            [\"closure\" \"handshake\" \"bind\" \"address\" \"io\" \"close\" \"shutdown\"\n                             \"isolation\" \"driver\" \"fairness\"])\n               results (mapv (fn [s]\n                               (println \"== probe:jolt-ws section\" s)\n                               [s (:exit (shell {:continue true} \"sh\" \"-c\"\n                                                \". build/tools/jolt-env.sh && exec \\\"$JOLT_HOME/bin/jolt\\\" -Srepro -M:jolt src/dev/jolt_ws_probe.clj \\\"$1\\\"\"\n                                                \"jolt\" s))])\n                             sections)]\n           (println \"probe:jolt-ws exits\" (pr-str results))\n397:  test:sub:clj {:doc \"JVM lane of test:sub: bb test:sub:clj <subsystem>... [--slow]\"\n407:  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\n418:  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n","exit_code":0,"status":"completed"}}
