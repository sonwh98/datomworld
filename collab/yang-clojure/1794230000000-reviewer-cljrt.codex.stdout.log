{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/call/conformance.clj | sed -n '90,310p'\"","aggregated_output":"    90\t  [packet exports]\n    91\t  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\n    92\t         (u/seq-nodes\n    93\t           (concat (map (fn [export]\n    94\t                          (u/sexp->uast\n    95\t                            (list 'py/global-set py-lower/globals-sym\n    96\t                                  {:py/str export} (python-export-symbol export))))\n    97\t                        exports)\n    98\t                   [(py-lower/lower-module-body packet)]))))\n    99\t\n   100\t\n   101\t(def frontends\n   102\t  \"Each admitted frontend's profile, as data:\n   103\t\n   104\t   - `:runtime`, `:address`: the runtime module and its published address;\n   105\t   - `:refusal`: the publication refusal key and reason of its modules;\n   106\t   - `:deps` (optional): pinned requirements beyond the runtime its\n   107\t     lowered units read directly (the clojure unit's `yang.call` reads);\n   108\t   - `:parse`: source text to CST packet;\n   109\t   - `:unit`: packet and projected exports to the lowered unit its\n   110\t     `:run-main` entry takes;\n   111\t   - `:read-export`: export name to the form reading the runtime's global\n   112\t     namespace (JS `globalThis`, PHP's named-function table, Python's main\n   113\t     module dictionary, the clojure runtime's task-local namespace cell);\n   114\t   - `:project`: name and a value form to the form binding the value where\n   115\t     the runtime's source resolves a called name;\n   116\t   - `:render`: the `:run-main` value as test data.\"\n   117\t  {:typescript\n   118\t   {:runtime 'js,\n   119\t    :address #(:address @h/published),\n   120\t    :refusal [:yang.typescript.antlr/refusal :yang.typescript.antlr/undeclared-free],\n   121\t    :parse #(parse-ok ts-cst/parse-source %),\n   122\t    :unit (fn [packet _] (names/canonicalize (ts-lower/lower-unit packet))),\n   123\t    :run-main 'js/run-main,\n   124\t    :read-export (fn [export] (list 'js/global-get {:js/str export})),\n   125\t    :project (fn [name value] (list 'js/define-global! name value)),\n   126\t    :render render/output},\n   127\t   :php\n   128\t   {:runtime 'php,\n   129\t    :address #(:address @published-php),\n   130\t    :refusal [:yang.php/refusal :yang.php/undeclared-free],\n   131\t    :parse #(parse-ok php-cst/parse-source %),\n   132\t    :unit (fn [packet _] (u/lam [] (php-lower/lower-module-body packet))),\n   133\t    :run-main 'php/run-main,\n   134\t    :read-export (fn [export]\n   135\t                   (list 'php/resolve-fn (str/lower-case export) export)),\n   136\t    :project (fn [name value]\n   137\t               (list 'php/declare-function! (str/lower-case name) value)),\n   138\t    :render php-h/render},\n   139\t   :python\n   140\t   {:runtime 'py,\n   141\t    :address #(:address @published-py),\n   142\t    :refusal [:yang.python.antlr/refusal :yang.python.antlr/undeclared-free],\n   143\t    :parse #(parse-ok py-parser/parse-source %),\n   144\t    :unit python-unit,\n   145\t    :run-main 'py/run-main,\n   146\t    :read-export (fn [export]\n   147\t                   (list 'py/global-get\n   148\t                         (list 'py/module-dict\n   149\t                               (list 'py/modules-ref {:py/str \"__main__\"}))\n   150\t                         {:py/str export})),\n   151\t    :project (fn [name value]\n   152\t               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\n   153\t    :render py-render/output},\n   154\t   :clojure\n   155\t   {:runtime 'clj,\n   156\t    :address #(:address @published-clj),\n   157\t    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\n   158\t    :deps (fn [] {'yang.call (:call-address @h/published)}),\n   159\t    :parse clj-comp/read-forms,\n   160\t    :unit (fn [packet _] (clj-comp/lower-unit packet)),\n   161\t    :run-main 'clj/run-main,\n   162\t    :read-export (fn [export] (list 'clj/global-get export)),\n   163\t    :project (fn [name value]\n   164\t               ;; the runtime global namespace holds the projection (as\n   165\t               ;; `js/define-global!` does for a JS caller), and the\n   166\t               ;; `yin/def` under the same name is how clojure source\n   167\t               ;; resolves it: a free name resolves the task's store\n   168\t               (list 'do\n   169\t                     (list 'clj/define-global! name value)\n   170\t                     (list 'yin/def (list 'quote (symbol name)) value))),\n   171\t    :render clj-comp/output}})\n   172\t\n   173\t\n   174\t(defn- profile\n   175\t  [frontend]\n   176\t  (or (get frontends frontend)\n   177\t      (throw (ex-info \"frontend not admitted\" {:frontend frontend}))))\n   178\t\n   179\t\n   180\t(defn- modules\n   181\t  \"The host registry, admitted by every runtime profile that checks it,\n   182\t   with the clojure guest library's host surface installed beside them.\n   183\t   Donor publication declares free names over this same registry, so a\n   184\t   clojure donor using the guest library (its `kind` and `portable`\n   185\t   hosts) publishes like it runs.\"\n   186\t  []\n   187\t  (clj-prelude/admit (php-prelude/admit (h/registry))))\n   188\t\n   189\t\n   190\t(defn publish-donor!\n   191\t  \"Publish the donor `source` of `frontend` as the module `module` (default\n   192\t   `xlang.donor.<frontend>`), exporting `body`, its unmodified lowered unit.\n   193\t   Answers `{:frontend :module :address :links}`.\"\n   194\t  ([frontend source]\n   195\t   (publish-donor! frontend source (symbol (str \"xlang.donor.\" (name frontend)))))\n   196\t  ([frontend source module]\n   197\t   (let [{:keys [runtime address refusal parse unit deps]} (profile frontend)\n   198\t         [refusal-key reason] refusal\n   199\t         spec (core-module/module-spec\n   200\t                refusal-key reason (modules)\n   201\t                {:name module,\n   202\t                 :ast (core-module/module-tree\n   203\t                        [(core-module/require-node runtime)\n   204\t                         (u/def! 'body (unit (parse source) []))]),\n   205\t                 :exports '#{body},\n   206\t                 :runtime-name runtime,\n   207\t                 :runtime-address (address),\n   208\t                 :deps (if deps (deps) {})})\n   209\t         result (h/publish-guest-module! spec)]\n   210\t     {:frontend frontend,\n   211\t      :module module,\n   212\t      :address (:address result),\n   213\t      :links (:links result)})))\n   214\t\n   215\t\n   216\t(defn- runtime-entry\n   217\t  \"Require and initialize each distinct runtime of `frontend-keys`, once.\"\n   218\t  [frontend-keys]\n   219\t  (into [(core-module/require-node 'yang.call)]\n   220\t        (mapcat (fn [runtime]\n   221\t                  [(core-module/require-node runtime)\n   222\t                   (u/sexp->uast (list (symbol (str runtime) \"init!\")))]))\n   223\t        (distinct (map (comp :runtime profile) frontend-keys))))\n   224\t\n   225\t\n   226\t(defn- donor-run\n   227\t  \"The donor module required and its body run under its runtime's entry.\"\n   228\t  [{:keys [frontend module]}]\n   229\t  [(core-module/require-node module)\n   230\t   (u/app (u/v (:run-main (profile frontend)))\n   231\t          (u/v (symbol (str module) \"body\")))])\n   232\t\n   233\t\n   234\t(defn export-program\n   235\t  \"The program whose value is the donor's `export`, read from its runtime's\n   236\t   global namespace after its body ran.\"\n   237\t  [donor export]\n   238\t  (let [{:keys [read-export]} (profile (:frontend donor))]\n   239\t    (u/mark-tails\n   240\t      (u/seq-nodes (concat (runtime-entry [(:frontend donor)])\n   241\t                           (donor-run donor)\n   242\t                           [(u/sexp->uast (read-export export))])))))\n   243\t\n   244\t\n   245\t(defn compose\n   246\t  \"The caller program: the donor's body run, each name of `exports` read\n   247\t   from the donor runtime and projected into `caller-frontend`'s namespace\n   248\t   under the same name, then `caller-source`, lowered unmodified, run under\n   249\t   its runtime's entry. Its value is the caller entry's value.\"\n   250\t  [donor exports caller-frontend caller-source]\n   251\t  (let [{:keys [read-export]} (profile (:frontend donor))\n   252\t        {:keys [project parse unit run-main]} (profile caller-frontend)]\n   253\t    (u/mark-tails\n   254\t      (u/seq-nodes\n   255\t        (concat (runtime-entry [(:frontend donor) caller-frontend])\n   256\t                (donor-run donor)\n   257\t                (map (fn [export]\n   258\t                       (let [value (symbol (str \"xlang.export.\" export))]\n   259\t                         (u/let1 value\n   260\t                                 (u/sexp->uast (read-export export))\n   261\t                                 (u/sexp->uast (project export value)))))\n   262\t                     exports)\n   263\t                [(u/app (u/v run-main) (unit (parse caller-source) exports))])))))\n   264\t\n   265\t\n   266\t(defn link-source\n   267\t  \"The serving composition naming the runtimes and the donor module.\"\n   268\t  [{:keys [module address]}]\n   269\t  (h/source {'yang.call (:call-address @h/published),\n   270\t             'js (:address @h/published),\n   271\t             'php (:address @published-php),\n   272\t             'py (:address @published-py),\n   273\t             'clj (:address @published-clj),\n   274\t             module address}))\n   275\t\n   276\t\n   277\t(defn run-program\n   278\t  \"`{backend value}` of `ast`, linked against `donor`, on each vector VM.\"\n   279\t  [donor ast]\n   280\t  (let [src (link-source donor)]\n   281\t    (into (sorted-map)\n  