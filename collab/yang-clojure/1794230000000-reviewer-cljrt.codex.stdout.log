          :blocked? false})\n          :cell/set!\n          (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n            {:state (heap-write state id (get-in state [:heap id :seal])\n                                (:val effect)),\n             :value (:val effect),\n             :blocked? false})\n          (let [[id s'] (gensym state \"effect\")\n354:(defn check-ref!\n530:  (let [stream-id (check-ref! state :stream/put :stream-ref (:stream effect))\n546:  (let [stream-id (check-ref! state :stream/cursor :stream-ref (:stream effect))\n567:  (let [stream-id (check-ref! state :stream/cursor :stream-ref (:stream effect))\n614:  (let [cursor-id (check-ref! state :stream/next :cursor-ref cursor-ref)\n753:  (let [stream-id (check-ref! state :stream/close :stream-ref (:stream effect))]\n2726:          (let [id (check-ref! state :cell/get :cell-ref (:cell effect))]\n2732:          (let [id (check-ref! state :cell/set! :cell-ref (:cell effect))]\n","exit_code":0,"status":"completed"}}
