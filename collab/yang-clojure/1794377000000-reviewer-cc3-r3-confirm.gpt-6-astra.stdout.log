t                    [G__123 G__456]]]\n  2446\t      (is (= (kernel-canonical-source-hash [(list 'fn [a] a)] (list a))\n  2447\t             (kernel-canonical-source-hash [(list 'fn [b] b)] (list b)))))\n  2448\t    (is (not= (kernel-canonical-source-hash '[(fn [p1__123#] p1__123#)] '(p1__123#))\n  2449\t              (kernel-canonical-source-hash '[(fn [p1__123#] p1__456#)] '(p1__123#)))\n  2450\t        \"distinct generated symbols must remain distinct\")\n  2451\t    (is (not= (kernel-canonical-source-hash '[(def x 1)] 'x)\n  2452\t              (kernel-canonical-source-hash '[(def x 2)] 'x))\n  2453\t        \"ordinary source edits still invalidate the hash\")))\n  2454\t\n  2455\t\n  2456\t(defn- kernel-compile\n  2457\t  \"Compile one oracle fixture under an explicit admission coordinate.\n  2458\t\n  2459\t   The admitting composition supplies `admission-scope` (plain data,\n  2460\t   the batch-token coordinate of `[:source medium batch-token j]`)\n  2461\t   and the per-scope `admission-ordinal` `j`; both are recorded WHEN\n  2462\t   ADMITTING, before compilation, validated by the same origin-shape\n  2463\t   rules as every source origin (`vm/source-origin`), and retained\n  2464\t   with the compilation as `:admission-origin` plain data. There is\n  2465\t   no per-JVM global counter (r3 F2): two scopes whose ordinals both\n  2466\t   restarted at 0 admit identical content under distinct origins,\n  2467\t   and replay of one retained compilation reuses its recorded\n  2468\t   coordinate. The one-argument form admits under this harness's\n  2469\t   default run scope at ordinal 0.\"\n  2470\t  ([fixture]\n  2471\t   (kernel-compile fixture :oracle-run 0))\n  2472\t  ([fixture admission-scope admission-ordinal]\n  2473\t   (let [call (kernel-c-program fixture)\n  2474\t         forms (kernel-closure call)\n  2475\t         source-hash (kernel-canonical-source-hash forms call)\n  2476\t         admission-origin (vm/source-origin\n  2477\t                