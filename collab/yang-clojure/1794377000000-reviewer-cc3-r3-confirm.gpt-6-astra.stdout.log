1906\t                   (if (or (::link-counter d) (::link-origins d))\n  1907\t                     (carry-link-identity\n  1908\t                       (:vm state)\n  1909\t                       {:id-counter (::link-counter d)\n  1910\t                        :origins (::link-origins d)})\n  1911\t                     (:vm state))\n  1912\t                   (:query-pair expanded))]\n  1913\t        (consume-failed-round (carry-served\n  1914\t                                (cond-> (assoc expanded :vm base)\n  1915\t                                  ;; r3 F4: provenance handles the\n  1916\t                                  ;; evaluator stage completed before\n  1917\t                                  ;; throwing ride the recovered session\n  1918\t                                  (::call-provenance-handles d)\n  1919\t                                  (update :call-provenance-handles\n  1920\t                                          merge\n  1921\t                                          (::call-provenance-handles d)))\n  1922\t                                d)\n  1923\t                              error)))))\n  1924\t\n     1\t(require 'yang.latte-oracle-test 'dao.jing 'yin.vm.semantic.linearize 'yin.vm.semantic.derive)\n     2\t(def kc @#'yang.latte-oracle-test/kernel-compile)\n     3\t(def binding @#'yang.latte-oracle-test/cc3-oracle-binding)\n     4\t(def kernel-c @#'yang.latte-oracle-test/kernel-c)\n     5\t(import '(java.lang Runtime System))\n     6\t(def rt (Runtime/getRuntime))\n     7\t(defn used [] (- (.totalMemory rt) (.freeMemory rt)))\n     8\t(defn gc-used [] (System/gc) (Thread/sleep 50) (System/gc) (used))\n     9\t(def fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)})\n    10\t;; peak sampler across lowering -> persistence(projection/derives) -> tagged execution\n    11\t(def peak (atom 0))\n    12\t(def stop (atom false))\n    13\t(def sampler (Thread. (fn [] (while (not @stop) (swap! peak max (used)) (Thread/sleep 5)))))\n    14\t(def t0 (System/currentTimeMillis))\n    15\t(def base (gc-used))\n    16\t(.start sampler)\n    17\t(def stage-peaks (atom []))\n    18\t(defn mark [label] (swap! stage-peaks conj [label (used)]))\n    19\t(def compiled (kc fixture)) (mark :after-compile)\n    20\t(def b (binding compiled)) (mark :after-binding)\n    21\t(def sem (yin.vm.semantic.linearize/project-rows (:tree b) nil (:rows b))) (mark :after-project-rows)\n    22\t(def stack (yin.vm.semantic.derive/stack-image (:vector sem) {:segment-address :seg/stack :call-provenance (:call-provenance sem)})) (mark :after-stack)\n    23\t(def reg (yin.vm.semantic.derive/register-image (:vector sem) {:segment-address :seg/register :call-provenance (:call-provenance sem)})) (mark :after-register)\n    24\t(def relation {:semantic (:call-provenance sem) :stack (:call-provenance stack) :register (:call-provenance reg)})\n    25\t(def c-walker (kernel-c compiled :c-walker)) (mark :after-c-walker)\n    26\t(def c-sem (kernel-c compiled :c-semantic)) (mark :after-c-semantic)\n    27\t(reset! stop true) (.join sampler)\n    28\t(def elapsed (- (System/currentTimeMillis) t0))\n    29\t;; serialized storage (canonical bytes) vs retained JVM objects (used-heap delta, gc-pinned)\n    30\t(def rows-bytes (count (dao.jing/canonical-bytes (:rows b))))\n    31\t(def rel-bytes (count (dao.jing/canonical-bytes relation)))\n    32\t(def retained-box (atom nil))\n    33\t(def before-retain (gc-used))\n    34\t(reset! retained-box {:binding b :sem sem :stack stack :reg reg :relation relation})\n    35\t(def after-retain (gc-used))\n    36\t;; repeat delta measurement for stability\n    37\t(def deltas (mapv (fn [_] (let [x (atom nil) b0 (gc-used)] (reset! x {:b b :s sem :st stack :r reg}) (let [a (gc-used)] (reset! x nil) (- a b0)))) (range 3)))\n    38\t(println :compiled-status (:status compiled))\n    39\t(println :c-status (:status c-walker) (:status c-sem))\n    40\t(println :rows-canonical-bytes rows-bytes)\n    41\t(println :relation-canonical-bytes rel-bytes)\n    42\t(println :heap-baseline-gc-used base)\n    43\t(println :stage-used stage-peaks)\n    44\t(println :peak-used-during-pipeline @peak)\n    45\t(println :peak-over-baseline (- @peak base))\n    46\t(println :retained-delta-first (- after-retain before-retain))\n    47\t(println :retained-deltas-repeat deltas)\n    48\t(println :elapsed-ms elapsed)\n    49\t(println :ceiling-bytes 1073741824 :peak-under-ceiling (< @peak 1073741824))\n    50\t(System/exit 0)\n    25\t(defn source-envelope\n    26\t  \"Construct the provenance-bearing input value ruled by D4. The admitting\n    27\t   composition supplies its program medium's logical identity and mints a\n    28\t   fresh batch token before append. `members` is ordered and `root` selects\n    29\t   the member the evaluator runs. The constructor validates but never mints:\n    30\t   retries of an unaccepted staged append must retain the caller's token.\"\n    31\t  ([source-medium batch-token members]\n    32\t   (source-envelope source-medium batch-token members 0))\n    33\t  ([source-medium batch-token members root]\n    34\t   (let [envelope {:yin/source-medium source-medium\n    35\t                   :yin/batch-token batch-token\n    36\t                   :yin/batch (vec members)\n    37\t                   :yin/root root}]\n    38\t     ;; Validating the root origin validates the two opaque coordinates too.\n    39\t     (when-not (and (integer? root) (<= 0 root) (< root (count members)))\n    40\t       (throw (ex-info \"Malformed source batch envelope\"\n    41\t                       {:rule :batch-envelope, :envelope envelope})))\n    42\t     (vm/source-origin source-medium batch-token root)\n    43\t     envelope)))\n    44\t\n    45\t\n   140\t(defn- project-envelope\n   141\t  [{:yin/keys [source-medium batch-token batch root] :as envelope}]\n   142\t  (when-not (and (vector? batch)\n   143\t                 (seq batch)\n   144\t                 (integer? root)\n   145\t                 (<= 0 root)\n   146\t                 (< root (count batch)))\n   147\t    (throw (ex-info \"Malformed source batch envelope\"\n   148\t                    {:rule :batch-envelope, :envelope envelope})))\n   149\t  (let [projected (mapv (fn [j member]\n   150\t                          (project-member member\n   151\t                                          (vm/source-origin source-medium\n   152\t                                                            batch-token j)\n   153\t                                          j))\n   154\t                        (range) batch)]\n   155\t    (assoc envelope\n   156\t           :yin/batch (mapv :tree projected)\n   157\t           :yin/source-positions (into [] (mapcat :source-positions) projected)\n   158\t           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\n   159\t           :yin/entity-occurrences (into [] (mapcat :entity-occurrences) projected))))\n","exit_code":0,"status":"completed"}}
