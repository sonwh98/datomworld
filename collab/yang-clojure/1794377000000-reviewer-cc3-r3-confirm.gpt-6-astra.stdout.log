ntext\n  1584\t  \"What a `yin.link` call is answered under (yin.repl.query/serve): the\n  1585\t   reader's authority, the publisher's key, and the requesting VM's\n  1586\t   primitives and module registry -- the modules it linked are derived\n  1587\t   from it, never recorded -- and the round.\"\n  1588\t  [state vm]\n  1589\t  {:authority (link/authority (:link-source state))\n  1590\t   :key (:dht-key state)\n  1591\t   :primitives (:primitives vm)\n  1592\t   :modules (:modules vm)\n  1593\t   :call-site-tables (call-site-tables state)\n  1594\t   :call-site-admissions (call-site-admissions state)\n  1595\t   :round (:round state)})\n  1596\t\n  1597\t\n  1598\t(defn- drive-links\n  1599\t  \"Serve the linker interpreter and run the parked VM alternately, at most\n  1600\t   `link-round-budget` rounds, while `vm` waits on a link.  A round that\n  1601\t   moves nothing ends the drive: a link whose content source cannot\n  1602\t   answer will not answer by waiting longer.  Returns\n  1603\t   `[state vm pending progress?]`, `pending` the links the interpreter\n  1604\t   reported `:pending`, and `progress?` true when a round moved\n  1605\t   something -- advanced a serve cursor, delivered a response or\n  1606\t   completed an install -- the fact the pending run's `:checks` resets\n  1607\t   on (yin.repl.link-policy.md section 3.1).  A refused or lost link\n  1608\t   raises as the VM's own, carrying the interrupted VM's minted\n  1609\t   identity.\n  1610\t\n  1611\t   `initial-progress` records progress from the caller's round.  When\n  1612\t   true, the first iteration runs the VM once without a round of its own.\n  1613\t\n  1614\t   A VM waiting on a `dao.space.query/q` call is driven the same way: the\n  1615\t   query interpreter (`yin.repl.query/serve`) answers from the session's\n  1616\t   indexer and the VM runs on.  Only a round the VM spends waiting on a\n  1617\t   link counts against `link-round-budget`; a query is answered in the\n  1618\t   round it is asked, so its rounds are bounded by `query-drive-budget`\n  1619\t   calls instead: a VM still waiting on a call once the drive has\n  1620\t   answered that many raises `query-call-limit-text` as its own error,\n  1621\t   the unanswered request abandoned with it.\"\n  1622\t  [state vm initial-progress]\n  1623\t  (loop [i 0\n  1624\t         calls 0\n  1625\t         vm vm\n  1626\t         state state\n  1627\t         pending []\n  1628\t         progress? initial-progress\n  1629\t         initial? initial-progress]\n  1630\t    (let [link? (link-waiting? vm)\n  1631\t          query? (query/waiting? vm)]\n  1632\t      (cond\n  1633\t        (or (vm/halted? vm) (not (or link? query?)) (>= i link-round-budget))\n  1634\t        [state vm pending progress?]\n  1635\t\n  1636\t        (and query? (>= calls query-drive-budget))\n  1637\t        (throw (link-raise (ex-info query-call-limit-text\n  1638\t                                    {:reason :yin.repl.query/call-limit\n  1639\t                                     :limit query-drive-budget})\n  1640\t                           vm\n  1641\t                           (update state :query-pair query/abandon-requests)))\n  1642\t\n  1643\t        :else\n  1644\t        (let [served (when (and link? (not initial?))\n  1645\t                       (link/round (assoc (:linker state)\n  1646\t                                          :source (:link-source state))\n  1647\t                                   (:dht state)))\n  1648\t              state (cond-> state\n  1649\t                      served (assoc :linker (:linker served)\n  1650\t                                    :dht (:dht served)))\n  1651\t              answered (when query?\n  1652\t                         (query/serve {:pair (:query-pair state)\n  1653\t                                       :indexer (:indexer state)\n  1654\t                                       :ast-indexer (:ast-indexer state)\n  1655\t                                       :dht (:dht state)\n  1656\t                                       :link (link-context state vm)\n  1657\t                                       :limits {:row-limit query-row-limit\n  1658\t                                                :byte-limit query-byte-limit}\n  1659\t                                       :budget (min query-serve-budget\n  1660\t                                                    (- query-drive-budget\n  1661\t                                                       calls))}))\n  1662\t              state (cond-> state\n  1663\t                      answered (assoc :query-pair (:pair answered)\n  1664\t                                      :dht (:dht answered)\n  1665\t                                      :indexer (:indexer answered)))\n  1666\t              pending (if (seq (:pending served)) (:pending served) pending)]\n  1667\t          (if (or initial? (:progress? served)\n  1668\t                  (:progress? answered))\n  1669\t            (let [vm' (try (vm/run vm)\n  1670\t                           (catch #?(:cljd Object :clj Exception :cljs js/Error)\n  1671\t                                  error\n  1672\t                             (throw (link-raise error vm state))))]\n  1673\t              (recur (if link? (inc i) i)\n  1674\t                     (+ calls (:answered answered 0))\n  1675\t                     vm'\n  1676\t                     state\n  1677\t                     pending\n  1678\t                     true\n  1679\t                     false))\n  1680\t            [state vm pending progress?]))))))\n  1855\t\n  1856\t(defn- wedged-program\n  1857\t  [state]\n  1858\t  (ex-info\n  1859\t    \"Program stream did not form a complete, runnable Yin VM program.\n  1860\tHint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n  1861\t    {:vm-type (:vm-type state)}))\n  1862\t\n  1863\t\n  1864\t(defn- run-evaluation\n  1865\t  \"The evaluator half of a round whose expander forwarded a