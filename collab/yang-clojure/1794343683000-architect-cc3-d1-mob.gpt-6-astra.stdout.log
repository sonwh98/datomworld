 [index root]\\n   922\\t  (let [memo (volatile! {})]\\n   923\\t    (letfn [(go\\n   924\\t              [index a]\\n   925\\t              (if-let [hit (get @memo a)]\\n   926\\t                [index hit]\\n   927\\t                (let [row (get index a)\\n   928\\t                      [index a']\\n   929\\t                      (if (= standin-tag (row-tag row))\\n   930\\t                        (intern-body index [:literal (nth row 2)])\\n   931\\t                        (let [[index children']\\n   932\\t                              (reduce (fn [[index acc] [_ c]]\\n   933\\t                                        (let [[index c'] (go index c)]\\n   934\\t                                          [index (conj acc c')]))\\n   935\\t                                      [index []]\\n   936\\t                                      (child-places row))]\\n   937\\t                          (rebuild-row index row children')))]\\n   938\\t                  (vswap! memo assoc a a')\\n   939\\t                  [index a'])))]\\n   940\\t      (go index root))))\\n   941\\t\\n   942\\t\\n   943\\t;; =============================================================================\\n   944\\t;; Harvest and post-harvest (§3.2 steps 2, 3, 5; §3.5)\\n   945\\t;; =============================================================================\\n   946\\t\\n   930\\t                   true\\n   931\\t                   (map? x) (and (every? machine-data? (keys x))\\n   932\\t                                 (every? machine-data? (vals x)))\\n   933\\t                   (coll? x) (every? machine-data? x)\\n   934\\t                   :else false)\\n   935\\t             (machine-data? (meta x))))))\\n   936\\t\\n   937\\t\\n   938\\t(defn occurrence-origin?\\n   939\\t  \\\"True when `origin` has one of §2.5's portable ruled shapes. `nil` is not\\n   940\\t   an occurrence; it is accepted separately by the legacy bare-row lane.\\n   941\\t\\n   942\\t   A source origin is `[:source medium batch-token member-index]`. Medium and\\n   943\\t   token are opaque non-nil plain data supplied by the admitting composition,\\n   944\\t   and the member index is a non-negative integer. An expansion origin names\\n   945\\t   the portable content address of its expansion record.\\\"\\n   946\\t  [origin]\\n   947\\t  (and (vector? origin)\\n   948\\t       (case (first origin)\\n   949\\t         :source (and (= 4 (count origin))\\n   950\\t                      (some? (nth origin 1))\\n   951\\t                      (plain-data? (nth origin 1))\\n   952\\t                      (some? (nth origin 2))\\n   953\\t                      (plain-data? (nth origin 2))\\n   954\\t                      (integer? (nth origin 3))\\n   955\\t                      (not (neg? (nth origin 3))))\\n   956\\t         :expansion (and (= 2 (count origin))\\n   957\\t                         (jing/segment-address? (nth origin 1)))\\n   958\\t         false)))\\n   959\\t\\n   960\\t\\n   961\\t(defn source-origin\\n  1470\\t   log writer, with nothing staged.\\\"\\n  1471\\t  ([ctx out] (make-expander ctx out nil))\\n  1472\\t  ([ctx out log]\\n  1473\\t   {:ctx ctx, :out out, :out-staged nil, :log log, :log-staged nil,\\n  1474\\t    :forwarded 0, :errors []}))\\n  1475\\t\\n  1476\\t\\n  1477\\t(defn ready?\\n  1478\\t  \\\"Ready only when both staged slots are empty.\\\"\\n  1479\\t  [expander]\\n  1480\\t  (and (nil? (:out-staged expander)) (nil? (:log-staged expander))))\\n  1481\\t\\n  1482\\t\\n  1483\\t(defn call-site-table\\n  1484\\t  \\\"The C1 side table the consumer `expander` holds for the occurrence\\n  1485\\t   the executed tree packet `tree` names — `origin` being the admission\\n  1486\\t   origin the table was stored under (§2.1: an application site is\\n  1487\\t   K = [origin root-address path]; the table's key is the admission\\n  1488\\t   origin beside the root address, while each row's own origin names\\n  1489\\t   that occurrence's admission or generating expansion record) — or nil when\\n  1490\\t   that occurrence made no C1 claim. Two expansions can produce the\\n  1491\\t   SAME final root from different admissions; keying by the full\\n  1492\\t   occurrence identity keeps their tables distinct, so resolving by the\\n  1493\\t   origin+root pair at hand never answers another execution's table,\\n  1494\\t   however many loads have run since, and an unclaimed load of a root\\n  1495\\t   previously loaded under a claim retrieves no stale table.\\\"\\n  1496\\t  [expander tree origin]\\n  1497\\t  (get (:call-site-tables expander) [origin (first tree)]))\\n  1498\\t\\n  1499\\t\\n  1500\\t(defn load\\n  1501\\t  \\\"Expand one observed batch once: keep the returned context, stage the\\n  1502\\t   tree only on success, stage the log when a log writer exists, and\\n  1503\\t   accumulate the error of a failed expansion. Expansion failure is\\n  1504\\t   data, so the cursor advances past it. A successful expansion's C1\\n  1505\\t   side table (the batch result's `:frontend-metadata`, present only\\n  1506\\t   when the selected member itself claimed coverage) is retained on the\\n  1507\\t   consumer under the occurrence identity of the staged tree — its\\n  1508\\t   admission origin beside its final root address (`call-site-tables`,\\n  1509\\t   resolved by `call-site-table`) — so the composition that drives this\\n  1510\\t   expander — the REPL's session — holds every executed occurrence's\\n  1511\\t   coverage beside the expander that produced it, each load's table\\n  1512\\t   surviving the next, even when two loads land on the same root.\\\"\\n  1513\\t  [expander batch]\\n  1514\\t  (let [{:keys [status tree log error ctx frontend-metadata\\n  1515\\t                call-site-origin]}\\n  1516\\t        (expand-batch batch (:ctx expander))]\\n  1517\\t    (cond-> (assoc expander :ctx ctx)\\n  1518\\t      (= :ok status) (assoc :out-staged tree)\\n  1519\\t      (and (= :ok status) frontend-metadata)\\n  1520\\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\\n  1521\\t                frontend-metadata)\\n  1522\\t      (:log expander) (assoc :log-staged log)\\n  1523\\t      (= :error status) (update :errors conj error))))\\n  1524\\t\\n  1525\\t\\n  1526\\t(defn- flush-slot\\n  1527\\t  [expander writer-key slot-key on-ok]\\n  1528\\t  (if-let [payload (get expander slot-key)]\\n  1529\\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\\n  1530\\t      (case outcome\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ntest/yang/latte_oracle/attribution_inventory.md:202:(`slice9_site_tables.edn`, `:version 1`) with the per-fixture\ntest/yang/latte_oracle/slice9_evidence.edn:25::attribution {:version 1, :rule \"caller-side site ids at compiled-AST application expressions (post-macroexpansion); records [guest-function arity caller-site]; ambient arities credit only through adapter-declared ambient-literal sites; delegations and the :gate-site/none entry site never credit\", :ambient-correspondence {[latte-kernel.defenv/registered-definition? 2] #{[registered-definition? 2 :context-shift]}, [latte-kernel.defenv/local-definitions 1] #{[local-definitions 1 :context-shift]}, [latte-kernel.defenv/register-definition 2] #{[register-definition 2 :context-shift]}, [latte-kernel.unparser/unparse-term-once 3] #{[unparse-term-once 3 :context-copy]}, [latte-kernel.unparser/prod-impl-unparser 1] #{[prod-impl-unparser 1 :context-copy]}, [latte-kernel.unparser/register-unparser! 3] #{[register-unparser 4 :context-shift]}, [latte-kernel.proof/elab-transparent 2] #{[elab-transparent 2 :context-shift]}, [latte-kernel.proof/elab-opaque 2] #{[elab-opaque 2 :context-shift]}, [latte-kernel.norm/install-unfold-implicit! 1] #{[install-unfold-implicit 2 :context-shift]}, [latte-kernel.unparser/unparse 1] #{[unparse 2 :context-shift]}, [latte-kernel.unparser/register-unparser! 2] #{[register-unparser 3 :context-shift]}, [lat