02\t                                             (into params (:params node))))\n  2303\t\n  2304\t                     :else (into {} (map (fn [[k v]]\n  2305\t                                           (if (coll? v)\n  2306\t                                             [k (walk v def-name scope params)]\n  2307\t                                             [k v])))\n  2308\t                                 node)))\n  2309\t                 (vector? node) (mapv #(walk % def-name scope params) node)\n  2310\t                 (seq? node) (apply list (map #(walk % def-name scope params) node))\n  2311\t                 :else node))\n  2312\t        [wrappers dispatcher-app main-body] (kernel-under-dispatcher ast)\n  2313\t        stamped-body (walk main-body nil {} #{})\n  2314\t        stamped (if dispatcher-app\n  2315\t                  (reduce (fn [body wrapper]\n  2316\t                            (assoc-in wrapper [:operator :body] body))\n  2317\t                          (assoc-in dispatcher-app [:operator :body] stamped-body)\n  2318\t                          (rseq wrappers))\n  2319\t                  stamped-body)]\n  2320\t    {:ast stamped :sites (vec @sites)}))\n  2321\t\n  2322\t\n  2323\t(defn- kernel-record-credits?\n  2324\t  \"One caller-site-tagged trace record `[fname arity caller-site]` against\n  2325\t   the attribution contract for upstream `symbol` at arity `n` (R1-R4):\n  2326\t   the degenerate 1:1 path matches the arity-preserving guest definition\n  2327\t   at any real site; a derived correspondence path matches its carrier\n  2328\t   callable and arity only through a SITE-LINKED record — the site\n  2329\t   table's static callee at that site is the carrier itself (R2b case 6:\n  2330\t   indirect origins refuse unless site-linked) — that is not a\n  2331\t   self-delegation (R2's rule: the originating call is the credited\n  2332\t   event). An :ambient-delegation path — the R3 disjointness pair —\n  2333\t   additionally requires the site's compiled context argument (position\n  2334\t   0) to have resolved to the adapter-supplied ambient literal;\n  2335\t   :context-shift and :context-copy paths thread the adapted state\n  2336\t   explicitly (the retired offset table's scope, R6) and impose no\n  2337\t   ambient-literal shape: their witness is the site-linked body entry of\n  2338\t   the carrier, whatever context value the site threads. The\n  2339\t   :gate-site/none entry site never credits.\"\n  2340\t  [record table symbol n]\n  2341\t  (let [[fname arity site] record]\n  2342\t    (and (vector? record) (= 3 (count record))\n  2343\t         (not= :gate-site/none site)\n  2344\t         (or (and (= fname (kernel-guest-name symbol)) (= arity n))\n  2345\t             (boolean (some (fn [[g t kind]]\n  2346\t                              (let [site-row (get table site)]\n  2347\t                                (and (= fname g) (= arity t)\n  2348\t                                     site-row (= g (:callee site-row))\n  2349\t                                     (not (:delegation? site-row))\n  2350\t                                     (or (not= :ambient-delegation kind)\n  2351\t                                         (= :ambient-literal (first (:arg-shapes site-row)))))))\n  2352\t                            (get kernel-ambient-correspondence [symbol n])))))))\n  2353\t\n  2354\t\n  2355\t(defn- kernel-ambient-site?\n  2356\t  \"R2b case 5's compile-time verification, one site at a time: a site\n  2357\t   may claim the ambient correspondence only when the derived table says\n  2358\t   its compiled context argument (position 0) IS the adapter-supplied\n  2359\t   ambient literal and the site is not a self-delegation. A declaration\n  2360\t   naming any other site refuses.\"\n  2361\t  [table site-id]\n  2362\t  (let [site-row (get table site-id)]\n  2363\t    (and site-row\n  2364\t         (not (:delegation? site-row))\n  2365\t         (= :ambient-literal (first (:arg-shapes site-row))))))\n  2366\t\n  2367\t\n  2368\t(defn- kernel-stale-sites\n  2369\t  \"R2b case 8's diagnostic: site ids the declared table carries that no\n  2370\t   lane's trace ever records — a stale table after a fixture edit. The\n  2371\t   result is recorded data (never silent non-credit): only sites the\n  2372\t   attribution could have consulted (direct sites of instrumented\n  2373\t   callees) participate.\"\n  2374\t  [table lanes]\n  2375\t  (let [recorded (into #{}\n  2376\t                       (comp (mapcat #(get-in lanes [% :executed-calls]))\n  2377\t                             (filter vector?)\n  2378\t                             (map #(nth % 2 nil)))\n  2379\t                       [:c-walker :c-semantic])]\n  2380\t    (vec (sort (for [[k s] table\n  2381\t                     :when (and (symbol? (:callee s)) (not (contains? recorded k)))]\n  2382\t                 k)))))\n  2383\t\n  2384\t\n  2385\t(defn- kernel-executed-arity?\n  2386\t  \"The ruled attribution query over `row`'s two caller-site-tagged C-lane\n  2387\t   traces: upstream `symbol` at arity `n` is credited when BOTH lanes\n  2388\t   record a body entry the query admits (kernel-record-credits?), and\n  2389\t   the site table in the row is the one this program's canonical source\n  2390\t   hashed to (R2b case 3: a table from another fixture, or a stale table\n  2391\t   after an edit, refuses). The retired offset-table matching (any\n  2392\t   record at arity n+offset, from any call origin) is gone.\"\n  2393\t  [row symbol n]\n  2394\t  (let [table (:site-table row)\n  2395\t        hash-matches? (or (nil? (:site-table-hash row))\n  2396\t                          (= (:canonical-source-hash row) (:site-table-hash row)))]\n  2397\t    (and hash-matches?\n  2398\t         (every? (fn [lane]\n  2399\t                   (some #(kernel-record-credits? % table symbol n)\n  2400\t                         (get-in row [lane :executed-calls])))\n  2401\t                 [:c-walker :c-semantic]))))\n  2402\t\n  2403\t\n  2404\t(defn- kernel-canonical-source-hash\n  2405\t  \"The canonical-source-hash of one fixture's inlined adaptation (R2b\n  2406\t   case 3): the digest of the assembled context layer and guest sources —\n  2407\t   the adapter this fixture inlines. Reader-generated symbols are renamed\n  2408\t   by first occurrence across forms and call, preserving shared references\n  2409\t   without depending on the process's gensym counter. A trace evaluated\n  2410\t   against a table whose recorded hash differs refuses attribution.\"\n  2411\t  [forms call]\n  2412\t  (let [source [forms call]\n  2413\t        gensyms (distinct (filter #(and (symbol? %)\n  2414\t                                        (re-matches #\"^[a-zA-Z0-9_.-]+__\\d+(?:__auto__)?#?$\"\n  2415\t                                                    (name %)))\n  2416\t                                  (tree-seq coll? seq source)))\n  2417\t        renames (into {} (map-indexed (fn [i s] [s (symbol (str \"$gensym_\" (inc i)))])\n  2418\t                                      gensyms))\n  2419\t        payload (binding [*print-length* nil *print-level* nil]\n  2420\t                  (pr-str (walk/postwalk-replace renames source)))]\n  2421\t    (apply str (map #(format \"%02x\" (bit-and 255 %))\n  2422\t                    (.digest (java.security.MessageDigest/getInstance \"SHA-256\")\n  2423\t                             (.getBytes payload \"UTF-8\"))))))\n  2424\t\n  2425\t\n  2426\t(deftest test-kernel-canonical-source-hash\n  2427\t  (testing \"fresh reads of pinned NBE source ignore reader gensym counters\"\n  2428\t    (let [forms-a (read-forms 'latte_kernel.nbe)\n  2429\t          forms-b (read-forms 'latte_kernel.nbe)\n  2430\t          call '(latte-kernel.nbe/evaluation 'x)]\n  3260\t           (for [[fname source] kernel-sources]\n  3261\t             [fname (vec (sort (filter (set (keys kernel-sources)) (walk-symbols source))))]))\n  3262\t     ;; the derived site tables stay on the rows (the query re-derives\n  3263\t     ;; credit from them); the evidence writer omits them from the\n  3264\t     ;; inline rows and lands them in the versioned companion file\n  3265\t     :fixtures results}))\n  3266\t\n  3267\t\n  3268\t(defn write-kernel-gate-evidence!\n  3269\t  \"Explicit evidence/coverage refresh; normal tests never update these files.\n  3270\t   With `dir`, writes into that directory (the round-trip test's temp dir);\n  3271\t   without it, the checked-in locations.\"\n  3272\t  ([] (write-kernel-gate-evidence! \"test/yang/latte_oracle\"))\n  3273\t  ([dir]\n  3274\t   (let [evidence (kernel-gate-evidence)]\n  3275\t     (spit (str dir \"/slice9_unexercised.edn\")\n  3276\t           (str \";; GENERATED from exact execution evidence in both C lanes.\\n\"\n  3277\t                (pr-str (into (sorted-map-by #(compare (pr-str %1) (pr-str %2)))\n  3278\t                              (for [entry (get-in evidence [:coverage :entries])\n  3279\t                                    :when (= :unexercised (:exercise entry))]\n  3280\t                                [(:function-arity entry) (:missing-dependency entry)]))) \"\\n\"))\n  3281\t     ;; The versioned site tables (R1b/R7): one derived table and one\n  3282\t     ;; canonical-source-hash per fixture, stable across refreshes so the\n  3283\t     ;; later durable correspondence record lands additively.\n  3284\t     (spit (str dir \"/slice9_site_tables.edn\")\n  3285\t           (str \";; GENERATED from the compiled AST of each fixture's C program.\\n\"\n  3286\t                (pr-str {:version 1\n  3287\t                         :fixtures\n  3288\t                         (into (sorted-map)\n  3289\t                               (for [row (:fixtures evidence)]\n  3290\t                                 [(:id row)\n  3291\t                                  {:canonical-source-hash (:canonical-source-hash row)\n  3292\t                                   :site-table (:site-table row)}]))})\n  3293\t                \"\\n\"))\n  3294\t     (with-open [w (io/writer (str dir \"/slice9_evidence.edn\"))]\n  3295\t       ;; prn keeps (quote ...) in valid EDN rather than pprint's reader\n  3296\t       ;; shorthand. One fixture per line keeps refreshes independently diffable.\n  3297\t       (binding [*out* w *print-length* nil *print-level* nil]\n  3298\t         (print \"{\")\n  3299\t         (doseq [[k v] (dissoc evidence :fixtures)] (pr k) (print \" \") (prn v))\n  3300\t         (println \":fixtures [\")\n  3301\t         (doseq [row (:fixtures evidence)] (prn (dissoc row :site-table)))\n  3302\t         (println \"]}\")))\n  3303\t     (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage :attribution]))))\n  3304\t\n  3305\t\n  3306\t(deftest test-kernel-differential-gate\n  3307\t  (let [evidence (kernel-gate-evidence)]\n  3308\t    (is (= (count (:fixtures kernel-gate-corpus)) (count (set (map :id (:fixtures evidence)))))\n  3309\t        \"Every named fixture runs exactly once, including negatives\")\n  3310\t    (doseq [row (:fixtures evidence)\n  3311\t            :when (and (:negative? row) (= :completed (get-in row [:a :status])))\n  3312\t            :let [outcome (get-in row [:a :outcome]) value (:value outcome)\n  3313\t                  fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n  3314\t      (is (or (:thrown outcome) (false? value) (and (sequential? value) (= :ko (first value)))\n  3315\t              (and (:refusal-path fixture) (false? (get-in outcome (:refusal-path fixture)))))\n  3316\t          (str \"A must actually reject the named negative: \" (:id row))))\n  3317\t    (is (= (:function-arity-candidates evidence)\n  3318\t           (+ (:admitted-function-arity-count evidence) (:excluded-function-arity-count evidence)))\n  3319\t        \"Admitted and excluded arities partition the candidate inventory\")\n  3320\t    (is (every? #(every? true? (vals (:agreement %)))\n  3321\t                (filter #(= :pass (:status %)) (:fixtures evidence)))\n  3322\t        \"Every passing fixture records independent A/B/C agreement\")\n  3323\t    (let [entries (get-in evidence [:coverage :entries])\n  3324\t          unexercised (filter #(= :unexercised (:exercise %)) entries)\n  3325\t          deviations (filter #(= :recorded-deviation (:status %)) (:fixtures evidence))]\n  3326\t      (is (= (:admitted-function-arity-count evidence) (count entries)\n  3327\t             (count (set (map :function-arity entries)))))\n  3328\t      (is (= (set (get-in evidence [:coverage :unexercised]))\n  3329\t             (set (map :function-arity unexercised))\n  3330\t             (set (keys kernel-unexercised-reasons))))\n  3331\t      (is (every? #(seq (:missing-dependency %)) unexercised))\n  3332\t      (is (every? #(case (:exercise %)\n  3333\t                     :direct (seq (:direct-fixture-ids %))\n  3334\t                     :named-integration (seq (:integration-fixture-ids %))\n  3335\t                     :unexercised (and (empty? (:direct-fixture-ids %))\n  3336\t                                       (empty? (:integration-fixture-ids %)))) entries))\n  3337\t      (doseq [{[symbol n] :function-arity :keys [direct-fixture-ids integration-fixture-ids]} entries\n  3338\t              id (concat direct-fixture-ids integration-fixture-ids)\n  3339\t              :let [row (first (filter #(= id (:id %)) (:fixtures evidence)))]]\n  3340\t        (is (= :pass (:status row)))\n  3341\t        (is (kernel-executed-arity? row symbol n)\n  3342\t            (str \"Every credited path re-derives from both execution traces: \" [symbol n id])))\n  3343\t      (is (= #{:elab-after-qed :check-after-qed} (set (map :id deviations))))\n  3344\t      (is (every? #(and (:recorded-deviation %)\n  3345\t                        (not (every? true? (vals (:agreement %))))) deviations)))\n  3346\t    (testing \"Previously declared residual consumers must still prove their exact arities\"\n  3347\t      (is (= 20 (count kernel-fixture-closure)))\n  3348\t      (doseq [[arity {:keys [fixture expected] :as closure}] kernel-fixture-closure\n  3349\t              :let [row (first (filter #(= fixture (:id %)) (:fixtures evidence)))\n  3350\t                    entry (first (filter #(= arity (:function-arity %)) (get-in evidence [:coverage :entries])))]]\n  3351\t        (is (= :pass (:status row)) (str arity \" via \" fixture))\n  3352\t        (is (some #{fixture} (concat (:direct-fixture-ids entry) (:integration-fixture-ids entry)))\n  3353\t            (str \"Primary consumer must contribute to arity evidence: \" arity))\n  3354\t        (is (contains? closure :expected))\n  3355\t        (is (= {:value expected} (get-in row [:a :outcome])) (str fixture \" has the intended result\"))))\n  3356\t    (is (= #{:typing-ascription :compile-malformed}\n  3357\t           (set (map :id (:recorded-upstream-failures evidence)))))\n  3358\t    (doseq [row (:fixtures evidence)\n  3359\t            :when (= :recorded-upstream-failure (:status row))\n  3360\t            :let [fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n  3361\t      (is (:recorded-upstream-failure row))\n  3362\t      (is (not (every? true? (vals (:agreement row)))))\n  3363\t      (is (nil? (kernel-upstream-failure (assoc fixture :id :unexpected)\n  3364\t                                         (:a row) (:b row) (:c-walker row) (:c-semantic row))))\n  3365\t      (is (nil? (kernel-upstream-failure (assoc fixture :call '(changed-input))\n  3366\t                                         (:a row) (:b row) (:c-walker row) (:c-semantic row))))\n  3367\t      (is (nil? (kernel-upstream-failure fixture (:a row) (:b row)\n  3368\t                                         (assoc-in (:c-walker row) [:outcome 1 :yin.k/data] {:changed true})\n  3369\t                                         (:c-semantic row)))))\n  3370\t    (println \"KERNEL-GATE\" (pr-str (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates\n  3371\t                                                          :recorded-portability-boundaries :recorded-upstream-failures])))\n  3372\t    (doseq [row (:fixtures evidence) :when (not= :pass (:status row))]\n  3373\t      (println (case (:status row)\n  3374\t                 :recorded-deviation \"KERNEL-RECORDED-BOUNDARY\"\n  3375\t                 :recorded-upstream-failure \"KERNEL-RECORDED-UPSTREAM-FAILURE\"\n  3376\t                 \"KERNEL-BLOCKER\")\n  3377\t               (pr-str {:id (:id row) :status (:status row)\n  3378\t                        :blocked-by (get-in row [:c-walker :blocked-by])\n  3379\t                        :a (get-in row [:a :status]) :b (get-in row [:b :status])\n  3380\t                        :c-walker (get-in row [:c-walker :status])\n  3381\t                        :c-semantic (get-in row [:c-semantic :status])})))\n  3382\t    (is (= :pass (:gate-status evidence))\n  3383\t        (str \"Kernel gate remains blocked: \" (:counts evidence)\n  3384\t             \"; admitted/candidate but unexercised function/arities=\" (count (get-in evidence [:coverage :unexercised]))\n  3385\t             \". See slice9_evidence.edn; blocked fixtures are not accepted negatives.\"))))\n  3386\t\n  3387\t\n  3388\t(deftest test-kernel-gate-evidence-writer-round-trip\n  3389\t  \"Rewriting the checked-in evidence through the writer into a temporary\n  3390\t   directory reproduces it exactly: the statuses (including the declared\n  3391\t   deviations), the raw comparisons and the coverage survive. No fixtures\n  3392\t   re-run; the checked-in file is the fixture.\"\n  3393\t  (let [dir (str (System/getProperty \"java.io.tmpdir\") \"/slice9-roundtrip-\" (System/currentTimeMillis))\n  3394\t        committed (edn/read-string (slurp \"test/yang/latte_oracle/slice9_evidence.edn\"))]\n  3395\t    (try\n  3396\t      (.mkdirs (java.io.File. dir))\n  3397\t      (with-redefs [kernel-gate-evidence (constantly committed)]\n  3398\t        (write-kernel-gate-evidence! dir))\n  3399\t      (let [written (edn/read-string (slurp (str dir \"/slice9_evidence.edn\")))]\n  3400\t        (is (= committed written) \"the writer's output re-reads as the same evidence\")\n  3401\t        (is (= #{:elab-after-qed :check-after-qed}\n  3402\t               (set (map :id (filter #(= :recorded-deviation (:status %)) (:fixtures written)))))\n  3403\t            \"the declared departures survive as recorded deviations\")\n  3404\t        (is (every? (fn [row]\n  3405\t                      (and (contains? row :a) (contains? row :b)\n  3406\t                           (contains? row :c-walker) (contains? row :c-semantic)))\n  3407\t                    (:fixtures written))\n  3408\t            \"every fixture row keeps its raw A/B/C comparisons\")\n  3409\t        (let [unexercised (edn/read-string (slurp (str dir \"/slice9_unexercised.edn\")))]\n  3410\t          (is (= (count (get-in written [:coverage :unexercised])) (count unexercised))\n  3411\t              \"the companion file lists every unexercised arity with its dependency\"))\n  3412\t        (let [tables (edn/read-string (slurp (str dir \"/slice9_site_tables.edn\")))]\n  3413\t          (is (= 1 (:version tables)) \"the site tables land in the versioned format\")\n  3414\t          (is (= (count (:fixtures written)) (count (:fixtures tables)))\n  3415\t              \"every fixture row carries its derived site table and canonical-source-hash\")))\n  3416\t      (finally\n  3417\t        (run! #(let [f (java.io.File. (str dir \"/\" %))] (when (.exists f) (.delete f)))\n  3418\t              [\"slice9_evidence.edn\" \"slice9_unexercised.edn\" \"slice9_site_tables.edn\"])\n  3419\t        (let [d (java.io.File. dir)] (when (.exists d) (.delete d)))))))\n","exit_code":0,"status":"completed"}}
