te-slot k) args)])\n  1992\t\n  1993\t\n  1994\t(defn- kernel-trace-form\n  1995\t  \"Append the selected function/arity at body entry, including indirect\n  1996\t   calls, carrying the CALLER's site id read from the site slot (R2: the\n  1997\t   record is [fname arity caller-site-id]; caller-side tagging, never\n  1998\t   callee-side). Only C is instrumented; A/B run their original paths.\"\n  1999\t  [form]\n  2000\t  (if (#{'defn 'defn-} (first form))\n  2001\t    (let [[op fname & header] form\n  2002\t          header (drop-while #(not (or (vector? %) (seq? %))) header)\n  2003\t          trace-arity (fn [[params & body]]\n  2004\t                        (let [n (if (some #{'&} params)\n  2005\t                                  [:variadic (.indexOf params '&)] (count params))]\n  2006\t                          (list* params\n  2007\t                                 (list 'stream/put! 'gate-execution-trace\n  2008\t                                       (list 'vector (list 'quote fname) n\n  2009\t                                             '(cell/get gate-site-slot)))\n  2010\t                                 body)))]\n  2011\t      (list* op fname (if (vector? (first header))\n  2012\t                        (trace-arity header) (map trace-arity header))))\n  2013\t    form))\n  2014\t\n  2015\t\n  2016\t(def ^:private kernel-ambient-state-constructors\n  2017\t  \"Context-layer constructors that thread the ambient state: resolving an\n  2018\t   argument through one of these (at its context position) keeps the\n  2019\t   ambient claim alive, because upstream's ambient API reads exactly this\n  2020\t   state. Derived from the checked-in context layer's names.\"\n  2021\t  (into '#{kernel-context}\n  2022\t        (filter #(or (str/starts-with? (str %) \"install-\")\n  2023\t                     (str/starts-with? (str %) \"register-\")\n  2024\t                     (str/starts-with? (str %) \"unregister-\")))\n  2025\t        (map second context-forms)))\n  2026\t\n  2027\t\n  2028\t(defn- kernel-stamped-args?\n  2029\t  \"The stamping wrapper around one already-stamped argument vector:\n  2030\t   `(data/nth (dsg__intra_call gate-site! (conj [] k <args>)) 1)`. Returns\n  2031\t   the wrapped original arguments node.\"\n  2032\t  [node]\n  2033\t  (when (and (map? node) (= :application (:type node))\n  2034\t             (= :variable (:type (:operator node)))\n  2035\t             (= 'data/nth (:name (:operator node)))\n  2036\t             (= 2 (count (:operands node)))\n  2037\t             (let [one (second (:operands node))]\n  2038\t               (and (map? one) (= :literal (:type one)) (= 1 (:value one))))\n  2039\t             (let [call (first (:operands node))]\n  2040\t               (and (map? call) (= :application (:type call))\n  2041\t                    (= :variable (:type (:operator call)))\n  2042\t                    (= 'dsg__intra_call (:name (:operator call)))\n  2043\t                    (let [args (get-in call [:operands 1])]\n  2044\t                      (and (map? args) (= :application (:type args))\n  2045\t                           (= :variable (:type (:operator args)))\n  2046\t                           (= 'conj (:name (:operator args))))))))\n  2047\t    (get-in node [:operands 0 :operands 1 :operands 2])))\n  2048\t\n  2049\t\n  2050\t(defn- kernel-site-arguments\n  2051\t  \"The argument expression nodes of one compiled call site: the operand\n  2052\t   vector the argument-vector convention assembles. `node` is either the\n  2053\t   intra-unit fast path `(dsg__intra_call f <args>)` or the routed guest\n  2054\t   call's arguments binding; the arguments are the elements of the\n  2055\t   constructed vector (a constant :literal, or `(conj [] e1 e2 ...)`),\n  2056\t   with any stamping wrapper already applied to inner expressions\n  2057\t   stripped first.\"\n  2058\t  [args-node]\n  2059\t  (let [args-node (or (kernel-stamped-args? args-node) args-node)]\n  2060\t    (cond\n  2061\t      (= :literal (:type args-node)) (:value args-node)\n  2062\t      (and (= :application (:type args-node))\n  2063\t           (= :variable (:type (:operator args-node)))\n  2064\t           (= 'conj (:name (:operator args-node)))\n  2065\t           (= :literal (:type (first (:operands args-node)))))\n  2066\t      (rest (:operands args-node))\n  2067\t      :else nil)))\n  2068\t\n  2069\t\n  2070\t(defn- kernel-intra-call?\n  2071\t  \"The compiled shape of one intra-unit guest call under the\n  2072\t   argument-vector convention: an application of the unit's dispatcher\n  2073\t   whose first operand names the callee and whose second is the assembled\n  2074\t   argument vector.\"\n  2075\t  [node]\n  2076\t  (and (= :application (:type node))\n  2077\t       (= :variable (:type (:operator node)))\n  2078\t       (= 'dsg__intra_call (:name (:operator node)))\n  2079\t       (= 2 (count (:operands node)))))\n  2080\t\n  2081\t\n  2082\t(defn- kernel-routing?\n  2083\t  \"True when `node` mentions the admission routing's own vocabulary —\n  2084\t   the dispatcher predicate or the invocation transfer — distinguishing\n  2085\t   a compiled guest call's routing from an ordinary nested let (the two\n  2086\t   share the let-lowering shape).\"\n  2087\t  [node]\n  2088\t  (letfn [(any?\n  2089\t            [n]\n  2090\t            (or (and (map? n) (= :variable (:type n))\n  2091\t                     (contains? '#{dsg__admitted? yang.call/invoke\n  2092\t                                   yang.call/invoke-with}\n  2093\t                                (:name n)))\n  2094\t                (and (coll? n) (some any? n))))]\n  2095\t    (boolean (any? node))))\n  2096\t\n  2097\t\n  2098\t(defn- kernel-routed-call?\n  2099\t  \"The compiled shape of one non-intra guest call: the admission routing\n  2100\t   binds the evaluated callee, then the evaluated argument vector, then\n  2101\t   routes. Returns the routing's arguments binding node, or nil for any\n  2102\t   other let-shaped chain: the arguments binding must carry a real\n  2103\t   argument-vector construction (a constant or a conj application).\"\n  2104\t  [node]\n  2105\t  (when (and (= :application (:type node))\n  2106\t             (= :lambda (:type (:operator node)))\n  2107\t             (= 1 (count (:params (:operator node))))\n  2108\t             (= 1 (count (:operands node)))\n  2109\t             (map? (:body (:operator node))))\n  2110\t    (let [inner (:body (:operator node))]\n  2111\t      (when (and (= :application (:type inner))\n  2112\t                 (= :lambda (:type (:operator inner)))\n  2113\t                 (= 1 (count (:params (:operator inner))))\n  2114\t                 (= 1 (count (:operands inner)))\n  2115\t                 (kernel-routing? (:body (:operator inner)))\n  2116\t                 (or (= :literal (:type (first (:operands inner))))\n  2117\t                     (and (map? (first (:operands inner)))\n  2118\t                          (kernel-site-arguments (first (:operands inner))))))\n  2119\t        inner))))\n  2120\t\n  2121\t\n  2122\t(defn- kernel-resolve-site-arg\n  2123\t  \"Classify one call-site argument expression for the derived site table:\n  2124\t   :ambient-literal (the adapter-supplied empty-context initialization,\n  2125\t   possibly through let bindings and ambient-state constructors), :literal,\n  2126\t   :variable (a parameter or an unresolvable binding — R2b case 7), or\n  2127\t   :computed. `scope` maps bound names to their init nodes; `params` are\n  2128\t   the enclosing binders.\"\n  2129\t  [node scope params depth]\n  2130\t  (cond\n  2131\t    (or (nil? node) (> depth 8)) :computed\n  2132\t    (= :literal (:type node)) :literal\n  2133\t    ;; constant-argument values (a fully constant argument vector's\n  2134\t    ;; elements arrive as data, not nodes)\n  2135\t    (not (coll? node)) :literal\n  2136\t    (= :variable (:type node))\n  2137\t    (if (contains? params (:name node))\n  2138\t      :variable\n  2139\t      (if-let [init (get scope (:name node))]\n  2140\t        (recur init scope params (inc depth))\n  2141\t        :variable))\n  2142\t    (and (= :application (:type node)) (kernel-intra-call? node)\n  2143\t         (contains? kernel-ambient-state-constructors\n  2144\t                    (get-in node [:operands 0 :name])))\n  2145\t    (let [args-node (second (:operands node))\n  2146\t          arg-nodes (kernel-site-arguments args-node)\n  2147\t          first-arg (if (sequential? arg-nodes) (first arg-nodes)\n  2148\t                        (when (= :literal (:type (or (kernel-stamped-args? args-node) args-node)))\n  2149\t                          (first (:value (or (kernel-stamped-args? args-node) args-node)))))]\n  2150\t      (if (and (= 'kernel-context (get-in node [:operands 0 :name]))\n  2151\t               (map? first-arg) (= :literal (:type first-arg))\n  2152\t               (= [{} {}] (:value first-arg)))\n  2153\t        :ambient-literal\n  2154\t        (if (and (sequential? arg-nodes) (= 1 (count arg-nodes))\n  2155\t                 (= :ambient-literal (kernel-resolve-site-arg (first arg-nodes)\n  2156\t                                                              scope params (inc depth))))\n  2157\t          :ambient-literal :computed)))\n  2158\t    ;; the compiler's outcome unwrap and let-hoist of one call: the\n  2159\t    ;; argument expression is (data/nth <hoisted-binding> 1), and the\n  2160\t    ;; binding's init is the call itself — resolve through it\n  2161\t    (and (= :application (:type node))\n  2162\t         (= :variable (:type (:operator node)))\n  2163\t         (= 'data/nth (:name (:operator node)))\n  2164\t         (= 2 (count (:operands node)))\n  2165\t         (let [idx (second (:operands node))]\n  2166\t           (and (map? idx) (= :literal (:type idx)) (number? (:value idx)) (pos? (:value idx)))))\n  2167\t    (recur (first (:operands node)) scope params (inc depth))\n  2168\t\n  2169\t    :else :computed))\n  2170\t\n  2171\t\n  2172\t(defn- kernel-under-dispatcher\n  2173\t  \"Split the compiled program into [outer-wrappers dispatcher-application\n  2174\t   main-body]: everything before the unit dispatcher binding evaluates\n  2175\t   before `dsg__intra_call` is bound, so a stamp there would not resolve.\n  2176\t   Returns the applications above the dispatcher binding, the application\n  2177\t   whose operator IS the dispatcher lambda, and that lambda's body — or\n  2178\t   [nil nil ast] when no dispatcher wrapper exists (stamping then covers\n  2179\t   the whole tree and the admission check reports the stamp).\"\n  2180\t  [ast]\n  2181\t  (loop [wrappers [] node ast]\n  2182\t    (if (and (map? node) (= :application (:type node))\n  2183\t             (map? (:operator node)) (= :lambda (:type (:operator node)))\n  2184\t             (= '[dsg__admitted? dsg__intra_call] (vec (:params (:operator node)))))\n  2185\t      [wrappers node (:body (:operator node))]\n","exit_code":0,"status":"completed"}}
