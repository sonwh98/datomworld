n    13\\t            [yin.vm.semantic.linearize :as linearize]\\n    14\\t            [yin.vm.linker :as linker]\\n    15\\t            [yin.vm.linker.closure :as closure]\\n    16\\t            [yin.vm.linker.requirements :as requirements]\\n    17\\t            [yin.vm.linker.sign :as sign]))\\n    18\\t\\n    19\\t\\n    20\\t(defn- refusal\\n    21\\t  [reason data]\\n    22\\t  (merge {:status :refused :reason reason} data))\\n    23\\t\\n    24\\t\\n    25\\t(defn- definitions\\n    26\\t  [ast]\\n    27\\t  (letfn [(scan\\n    28\\t            [node]\\n    29\\t            (when (map? node)\\n    30\\t              (case (:type node)\\n    31\\t                :lambda #{}\\n    32\\t                :application\\n    33\\t                (let [xs (:operands node)\\n    34\\t                      own (when (and (vm/definition-operator? (:operator node))\\n    35\\t                                     (= 2 (count xs))\\n    36\\t                                     (= :literal (:type (first xs)))\\n    37\\t                                     (symbol? (:value (first xs))))\\n    38\\t                            #{(:value (first xs))})]\\n    39\\t                  (into (or own #{}) (mapcat scan)\\n    40\\t                        (concat (when (= :lambda (:type (:operator node)))\\n    41\\t                                  [(:body (:operator node))])\\n    42\\t                                xs)))\\n    43\\t                #{})))]\\n    44\\t    (scan ast)))\\n    45\\t\\n    46\\t\\n    47\\t(defn footprint\\n    48\\t  \\\"Derive the manifest footprint from tree rows, declared profiles and dependencies.\\\"\\n    49\\t  [handle {:keys [ast tree primitives requires]}]\\n    50\\t  (let [tree (or tree (vm/ast->semantic-bytecode ast))\\n    51\\t        own (vm/ast-requirements (query/relation (vals (:rows tree))))\\n    52\\t        bad-primitive (some (fn [[name profile]]\\n    53\\t                              (when-not (and (map? profile)\\n    54\\t                                             (keyword? (:yin.k/profile profile))\\n    55\\t                                             (set? (:yin.k/effects profile)))\\n    56\\t                                name))\\n    57\\t                            primitives)\\n    58\\t        missing (some (fn [[name address]]\\n    59\\t                        (let [manifest (jing/get handle address ::absent)]\\n    60\\t                          (when (= ::absent manifest) [name address])))\\n    61\\t                      requires)]\\n    62\\t    (cond\\n    63\\t      (seq (:ffi-ops own))\\n    64\\t      (refusal :yin.link.publish/ffi-op {:ffi-ops (:ffi-ops own)})\\n    65\\t\\n    66\\t      (seq (:parked-ids own))\\n    67\\t      (refusal :yin.link.publish/parked-id {:parked-ids (:parked-ids own)})\\n    68\\t\\n    69\\t      bad-primitive\\n    70\\t      (refusal :yin.link.publish/unprofiled-primitive\\n    71\\t               {:primitive bad-primitive})\\n    72\\t\\n    73\\t      missing\\n    74\\t      (refusal :yin.link.publish/missing-requirement\\n    75\\t               {:name (first missing) :manifest (second missing)})\\n    76\\t\\n    77\\t      :else\\n    78\\t      {:store-keys (:store-keys own)\\n    79\\t       :effects (into (or (:effects own) #{})\\n    80\\t                      (concat (mapcat :yin.k/effects (vals primitives))\\n    81\\t                              (mapcat (fn [address]\\n    82\\t                                        (get-in (jing/get handle address nil)\\n    83\\t                                                [:yin.module/footprint :effects]))\\n    84\\t                                      (vals requires))))})))\\n    85\\t\\n    86\\t\\n    87\\t(def code-formats\\n    88\\t  \\\"The four code format records a module manifest links through.\\\"\\n    89\\t  [linker/ast-format linker/semantic-format\\n    90\\t   linker/stack-format linker/register-format])\\n    91\\t\\n    92\\t\\n    93\\t;; =============================================================================\\n    94\\t;; Call-site occurrence contract C1 (Addendum A, design §2)\\n    95\\t;; =============================================================================\\n    96\\t;;\\n    97\\t;; A module whose frontend finalized its tree (`:yang/call-site 1` on\\n    98\\t;; every final `:application` occurrence) publishes its frontend-metadata\\n    99\\t;; side table with its manifest: the manifest keeps schema 1 (a manifest\\n   100\\t;; address names code) and gains the optional `:yin.module/call-sites`\\n   101\\t;; reference `{table record}` — the module closure follows manifest\\n   102\\t;; references, so only a referenced table travels with the module\\n   103\\t;; through transfer. The reverse record names the tree root, the\\n   104\\t;; publication's recorded admission origin, and the table's address; it\\n   105\\t;; cannot name the manifest (the manifest references it, so the two\\n   106\\t;; addresses would be circular), and custody runs one way, from the\\n   107\\t;; manifest forward. The publication's origin is an ADMISSION identity\\n   108\\t;; (design §2.1): an explicit token drawn per publication — so two\\n   109\\t;; separately published identical trees are two admissions with\\n   110\\t;; distinct origins — persisted in the record and retrieved from the\\n   111\\t;; record, never reconstructed from the tree's content. The publisher\\n   112\\t;; extracts the markers from the map AST, refuses the\\n   113\\t;; publication when they do not exactly cover the canonical tree's\\n   114\\t;; application occurrences — or when a marker's value is not version 1 —\\n   115\\t;; and otherwise materializes the table and its record into the same\\n   116\\t;; handle. A module with no markers makes no claim and publishes exactly\\n   117\\t;; as before.\\n   118\\t\\n   119\\t(def ^:private publication-sequence\\n   120\\t  \\\"The publisher's admission counter. Each publication is one admission\\n   121\\t   event (design §2.1): two separately admitted identical sources have\\n   122\\t   different origins, so the token drawn here never repeats.\\\"\\n   123\\t  (atom 0))\\n   124\\t\\n   125\\t(defn- next-admission-token\\n   126\\t  \\\"A fresh, never-repeated admission token for one publication.\\\"\\n   127\\t  []\\n   128\\t  (keyword \\\"yin.vm.linker.publish.publication\\\"\\n   129\\t           (str (swap! publication-sequence inc))))\\n   130\\t\\n   131\\t(defn- publication-origin\\n   132\\t  \\\"The occurrence origin of the publication admission `token` names:\\n   133\\t   the publisher's own medium, the explicit admission token, member 0.\\n   134\\t   `token` is the publication's admission identity — the\\n   135\\t   `:yin.link.publish/admission` option when the composition pins one,\\n   136\\t   otherwise a publisher-allocated token that never repeats — so two\\n   137\\t   publications of identical trees are two admissions with distinct\\n   138\\t   origins. The origin is an admission event's identity, not a\\n   139\\t   function of the tree's content: it is persisted in the side record\\n   140\\t   at publication time and retrieved from that record; nothing ever\\n   141\\t   reconstructs it from the root.\\\"\\n   142\\t  [token]\\n   143\\t  [:source :yin.vm.linker.publish/publish token 0])\\n   144\\t\\n   145\\t\\n   146\\t(defn- claims-call-sites?\\n   147\\t  \\\"True when map AST `ast` carries the C1 key anywhere. A hit inside a\\n   148\\t   literal payload is data, not a claim: extraction then finds no\\n   149\\t   markers and the module publishes unannotated, as it should.\\\"\\n   150\\t  [ast]\\n   151\\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\\n   152\\t\\n   153\\t\\n   154\\t(defn- call-site-claim\\n   155\\t  \\\"The C1 claim `ast` makes over its canonical `tree`: nil when it\\n   156\\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\\n   157\\t   when the extracted markers exactly cover the tree's eligible\\n   158\\t   application occurrences; `{:missing [...] :extra [...]}` when they\\n   159\\t   do not; `{:unsupported-version v :path p}` when a marker's value is\\n   160\\t   not version 1 — a claim rejection, never a silent acceptance of a\\n   161\\t   table a retriever would read as version 1.\\\"\\n   162\\t  [ast tree admission]\\n   163\\t  (when (claims-call-sites? ast)\\n   164\\t    (let [origin (publication-origin admission)\\n   165\\t          extracted (filter #(= :yang/call-site (nth % 3))\\n   166\\t                            (:frontend-metadata\\n   167\\t                              (vm/ast-side-tables ast tree origin)))\\n   168\\t          eligible (into #{}\\n   169\\t                         (map (fn [[r p]] [origin r p]))\\n   170\\t                         (vm/application-occurrences tree))\\n   171\\t          marked (into #{}\\n   172\\t                       (map (fn [[o r p _ _]] [o r p]))\\n   173\\t                       extracted)]\\n   174\\t      (or (when-let [[v p] (some (fn [row]\\n   175\\t                                   (let [v (nth row 4)]\\n   176\\t                                     (when (not (and (integer? v) (= 1 v)))\\n   177\\t                                       [v (subvec row 0 3)])))\\n   178\\t                                 extracted)]\\n   179\\t            {:unsupported-version v, :path p})\\n   180\\t          (if (= eligible marked)\\n   181\\t            {:origin origin, :rows (vec (sort-by pr-str extracted))}\\n   182\\t            {:missing (vec (sort-by pr-str (remove marked eligible))),\\n   183\\t             :extra (vec (sort-by pr-str (remove eligible marked)))})))))\\n   184\\t\\n   185\\t\\n   186\\t(defn link-local\\n   187\\t  \\\"Link `format`'s image through the manifest `address` over `handle`'s\\n   188\\t   own content, `:verifying` with discharge deferred, as a serving\\n   189\\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\\n   190\\t   call, so no request reaches any peer.  `opts` overrides the link\\n   191\\t   options; its `:bounds` are the runtime's composition bounds (section\\n   192\\t   4.2 step 2), every one left out taking `linker/default-bounds`.\\\"\\n   193\\t  ([handle address format] (link-local handle address format nil))\\n   194\\t  ([handle address format opts]\\n   195\\t   (linker/link-manifest\\n   196\\t     (linker/local-runtime\\n   197\\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\\n   198\\t                              (conj code-formats linker/manifest-format\\n   199\\t                                    linker/record-format))\\n   200\\t               :bounds (:bounds opts)})\\n   201\\t     address (:format format) {:primitives vm/primitives}\\n   202\\t     (merge {:contract (:contract format)\\n   203\\t             :derivation :verifying\\n   204\\t             :defer-discharge true}\\n   205\\t            (dissoc opts :bounds)))))\\n   206\\t\\n   207\\t\\n   208\\t(defn- publish-closure!\\n   209\\t  \\\"`publish-module!` under the composition bounds of `opts`.\\\"\\n   210\\t  [handle {:keys [name ast exports requires primitives] :as spec} opts]\\n   211\\t  (let [undefined (first (remove (definitions ast) exports))\\n   212\\t        tree (when-not undefined\\n   213\\t               (try (vm/ast->semantic-bytecode ast)\\n   214\\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\\n   215\\t                      (refusal :yin.link.publish/malformed-tree {}))))\\n   216\\t        defect (when (and tree (not= :refused (:status tree)))\\n   217\\t                 (vm/validate-rows tree))\\n   218\\t        ;; each pinned closure is walked before anything is written; an\\n   219\\t        ;; absent pinned manifest is the footprint's missing-requirement\\n   220\\t        requirement\\n   221\\t        (when (and tree (not defect) (not= :refused (:status tree)))\\n   222\\t          (some (fn [[n address]]\\n   223\\t                  (let [w (closure/walk handle address opts)]\\n   224\\t                    (case (:yin.link.closure/outcome w)\\n   225\\t                      :complete nil\\n   226\\t                      :invalid (refusal :yin.link.publish/invalid-requirement\\n   227\\t                                        {:name n})\\n   228\\t                      :missing (when (not= address (:address w))\\n   229\\t                                 (refusal :yin.link.publish/incomplete-requirement\\n   230\\t                                          {:name n :walk w})))))\\n   231\\t                (sort-by (fn [[n _]] (str n)) requires)))\\n   232\\t        fp (when (and tree (not defect) (not requirement)\\n   233\\t                      (not= :refused (:status tree)))\\n   234\\t             (footprint handle (assoc spec :tree tree)))\\n   235\\t        ;; a C1 claim is validated before anything is written: a module\\n   236\\t        ;; whose markers do not cover its tree is never published as\\n   237\\t        ;; though it did. One publication is one admission event\\n   238\\t        ;; (design §2.1): the admission identity is pinned explicitly by\\n   239\\t        ;; the composition when it supplies `:yin.link.publish/admission`,\\n   240\\t        ;; otherwise drawn fresh here — either way it is persisted in\\n   241\\t        ;; the side record and retrieved from there\\n   242\\t        admission (or (:yin.link.publish/admission opts)\\n   243\\t                      (next-admission-token))\\n   244\\t        claim (when (and tree (not defect) (not requirement)\\n   245\\t                         (not= :refused (:status tree))\\n   246\\t                         (not= :refused (:status fp)))\\n   247\\t                (call-site-claim ast tree admission))]\\n   248\\t    (cond\\n   249\\t      undefined\\n   250\\t      (refusal :yin.link.publish/undefined-export {:export undefined})\\n   251\\t\\n   252\\t      (= :refused (:status tree)) tree\\n   253\\t\\n   254\\t      defect\\n   255\\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\\n   256\\t\\n   257\\t      requirement requirement\\n   258\\t\\n   259\\t      (= :refused (:status fp)) fp\\n   260\\t\\n   261\\t      ;; dispatch on the key's PRESENCE, not its truthiness: a marker\\n   262\\t      ;; whose value is present but not the integer 1 — nil or false\\n   263\\t      ;; included — carries :unsupported-version nil/false, and its\\n   264\\t      ;; reason is the unsupported version, never incomplete coverage\\n   265\\t      (and claim (contains? claim :unsupported-version))\\n   266\\t      (refusal :yin.link.publish/unsupported-call-site-version claim)\\n   267\\t\\n   268\\t      (and claim (not (:rows claim)))\\n   269\\t      (refusal :yin.link.publish/incomplete-call-site-coverage claim)\\n   270\\t\\n   271\\t      :else\\n   272\\t      (let [tree-address (vm/materialize-tree! handle tree)\\n   273\\t            sem-vector (:vector (linearize/project-rows tree))\\n   274\\t            sem (code/materialize-vector! handle sem-vector)\\n   275\\t            h-image (:image (derive/stack-image sem-vector))\\n   276\\t            r-image (derive/register-image sem-vector)\\n   277\\t            h (dcode/image-hash h-image)\\n   278\\t            r (rcode/register-hash r-image)\\n   279\\t            h-address (jing/materialize! handle h-image)\\n   280\\t            r-address (jing/materialize! handle r-image)\\n   281\\t            mint (fn [input output profile]\\n   282\\t                   (jing/materialize!\\n   283\\t                     handle\\n   284\\t                     (assoc (ledger/derive-record input output)\\n   285\\t                            :yin.ledger/profile profile)))\\n   286\\t            ;; the C1 side table and its reverse record, materialized\\n   287\\t            ;; BEFORE the manifest so the manifest can reference them:\\n   288\\t            ;; the module closure follows manifest references, so only a\\n   289\\t            ;; referenced table travels with the module through transfer\\n   290\\t            call-sites (when (:rows claim)\\n   291\\t                         (let [table (jing/materialize! handle (:rows claim))\\n   292\\t                               record {:yang.call-site/version 1\\n   293\\t                                       :yang.call-site/root tree-address\\n   294\\t                                       :yang.call-site/origin (:origin claim)\\n   295\\t                                       :yang.call-site/table table}]\\n   296\\t                           {:record (jing/materialize! handle record)\\n   297\\t                            :table table\\n   298\\t                            :origin (:origin claim)\\n   299\\t                            :root (:root tree)}))\\n   300\\t            manifest (cond-> {:yin.module/name name\\n   301\\t                              :yin.module/schema linker/manifest-schema\\n   302\\t                              :yin.module/contracts\\n   303\\t                              {:yin.ast/code vm/ast-contract\\n   304\\t                               :yin.semantic/code vm/semantic-contract\\n   305\\t                               :yin.debruijn.code vm/stack-contract\\n   306\\t                               :yin.debruijn.register vm/register-contract}\\n   307\\t                              :yin.module/tree tree-address\\n   308\\t                              :yin.module/derivations\\n   309\\t                              {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\\n   310\\t                               :yin.debruijn.code\\n   311\\t                               (mint sem h linker/stack-lowering-profile)\\n   312\\t                               :yin.debruijn.register\\n   313\\t                               (mint sem r linker/register-lowering-profile)}\\n   314\\t                              :yin.module/index {:yin.debruijn.code h-address\\n   315\\t                                                 :yin.debruijn.register r-address}\\n   316\\t                              :yin.module/exports (set exports)\\n   317\\t                              :yin.module/requires (or requires {})\\n   318\\t                              :yin.module/primitives\\n   319\\t                              (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\\n   320\\t                                            primitives))\\n   321\\t                              :yin.module/footprint fp}\\n   322\\t                       call-sites (assoc :yin.module/call-sites\\n   323\\t                                         {:table (:table call-sites)\\n   324\\t                                          :record (:record call-sites)}))\\n   325\\t            address (jing/materialize! handle manifest)\\n   326\\t            walked (closure/walk handle address opts)]\\n   327\\t        (if (not= :complete (:yin.link.closure/outcome walked))\\n   328\\t          (refusal :yin.link.publish/incomplete-closure\\n   329\\t                   {:address address :walk walked})\\n   330\\t          (let [links (into {}\\n   331\\t                            (map (fn [f]\\n   332\\t                                   [(:format f)\\n   333\\t                                    (link-local handle address f\\n   334\\t                                                (select-keys opts\\n   335\\t                                                             [:bounds]))]))\\n   336\\t                            code-formats)]\\n   337\\t            (cond-> {:address address :manifest manifest\\n   338\\t                     :identities {:yin.semantic/code sem\\n   339\\t                                  :yin.debruijn.code sem\\n   340\\t                                  :yin.debruijn.register sem}\\n   341\\t                     :checksums {:yin.debruijn.code h\\n   342\\t                                 :yin.debruijn.register r}\\n   343\\t                     :links links}\\n   344\\t              call-sites (assoc :call-sites call-sites))))))))\\n   345\\t\\n   346\\t\\n   347\\t(defn publish-module!\\n   348\\t  \\\"Mint all four code formats, derivation records, and one schema-1 manifest.\\n   349\\t   `opts` `{:bounds {...}}` are the composition bounds (section 4.2 step\\n   350\\t   2) of every closure walk and local link the publication runs, every\\n   351\\t   bound left out taking `linker/default-bounds`.\\\"\\n   352\\t  ([handle spec] (publish-module! handle spec nil))\\n   353\\t  ([handle spec opts] (publish-closure! handle spec opts)))\\n   354\\t\\n   355\\t\\n   356\\t(defn- stored-tree\\n   357\\t  \\\"The canonical row tree stored under `root` in `handle`, rebuilt\\n   358\\t   from its individually materialized rows (`vm/materialize-tree!`\\n   359\\t   stores each row body under its own address), or nil when a reached\\n   360\\t   row is absent.\\\"\\n   361\\t  [handle root]\\n   362\\t  (loop [queue [root]\\n   363\\t         rows {}]\\n   364\\t    (if (empty? queue)\\n   365\\t      {:root root, :rows rows}\\n   366\\t      (let [address (first queue)\\n   367\\t            body (jing/get handle address nil)]\\n   368\\t        (if-not (vector? body)\\n   369\\t          nil\\n   370\\t          (let [row (into [address] body)\\n   371\\t                kids (into []\\n   372\\t                           (mapcat (fn [[j [_ kind]]]\\n   373\\t                                     (let [pos (+ j 2)]\\n   374\\t                                       (case kind\\n   375\\t                                         :node [(nth row pos)]\\n   376\\t                                         :nodes (nth row pos)\\n   377\\t                                         nil))))\\n   378\\t                           (map-indexed vector\\n   379\\t                                        (get vm/semantic-bytecode-grammar\\n   380\\t                                             (nth row 1))))]\\n   381\\t            (recur (into (subvec queue 1)\\n   382\\t                         (remove #(contains? rows %) kids))\\n   383\\t                   (assoc rows address row))))))))\\n   384\\t\\n   385\\t\\n   386\\t(defn published-call-site-table\\n   387\\t  \\\"The C1 side table the module whose manifest is at `address` in\\n   388\\t   `handle` claims: `{:origin o :root r :rows [...] :tree tree}` with\\n   389\\t   the rows exactly as stored and the module's canonical tree, or nil\\n   390\\t   when the module made no C1 claim. The manifest references the table\\n   391\\t   and its reverse record (`:yin.module/call-sites`), so the reference —\\n   392\\t   not a recomputation — is what is resolved here: the rows are fetched\\n   393\\t   from the referenced table address and the ORIGIN is the one the\\n   394\\t   record RECORDED at publication (`:yang.call-site/origin`, held to be\\n   395\\t   a well-formed occurrence origin), beside the record's version, the\\n   396\\t   manifest's own tree, and the referenced table. Nothing reconstructs\\n   397\\t   an origin from content: a replay of this retrieval answers the\\n   398\\t   recorded admission identity, and no other module's admission can be\\n   399\\t   confused with it.\\\"\\n   400\\t  [handle address]\\n   401\\t  (let [manifest (jing/get handle address nil)\\n   402\\t        call-sites (:yin.module/call-sites manifest)]\\n   403\\t    (when (and (map? manifest) (:yin.module/tree manifest)\\n   404\\t               (map? call-sites) (jing/segment-address? (:table call-sites))\\n   405\\t               (jing/segment-address? (:record call-sites)))\\n   406\\t      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\\n   407\\t        (let [stored-rows (jing/get handle (:table call-sites) nil)\\n   408\\t              stored-record (jing/get handle (:record call-sites) nil)\\n   409\\t              origin (:yang.call-site/origin stored-record)]\\n   410\\t          (when (and (vector? stored-rows)\\n   411\\t                     (= {:yang.call-site/version 1\\n   412\\t                         :yang.call-site/root (:yin.module/tree manifest)\\n   413\\t                         :yang.call-site/table (:table call-sites)}\\n   414\\t                        (select-keys stored-record\\n   415\\t                                     [:yang.call-site/version\\n   416\\t                                      :yang.call-site/root\\n   417\\t                                      :yang.call-site/table]))\\n   418\\t                     (vm/occurrence-origin? origin))\\n   419\\t            {:origin origin, :root (:root tree), :rows stored-rows,\\n   420\\t             :tree tree}))))))\\n   421\\t\\n   422\\t\\n   423\\t;; =============================================================================\\n   424\\t;; Deriving a module from indexed code (5.3)\\n   425\\t;; =============================================================================\\n   426\\t\\n   427\\t(defn- indexed-programs\\n   428\\t  \\\"Every program the index `db` holds -- a relation of `[e a v t m]` index\\n   429\\t   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\\n   430\\t   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\\n   431\\t   whose `m` is the program's metadata entity.\\\"\\n   432\\t  [db]\\n   433\\t  (let [by-m (group-by #(nth % 4)\\n   434\\t                       (query/collect\\n   435\\t                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\\n   436\\t                                  db)))]\\n   437\\t    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\\n   438\\t          (sort-by (juxt second first)\\n   439\\t                   (query/collect\\n   440\\t                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\\n   441\\t                              db))))))\\n   442\\t\\n   443\\t\\n   444\\t(defn requirements\\n   445\\t  \\\"The modules `ast` unconditionally requires at module level. Scan literal\\n   446\\t   `(require 'm)` applications outside lambda bodies, except immediately\\n   447\\t   applied lambdas. Conditional branches and try-require remain deferred.\\\"\\n   448\\t  [ast]\\n   449\\t  (requirements/eager ast))\\n   450\\t\\n    80\\t   on every `:application` node, at every depth the row grammar knows.\\n    81\\t   Literal payloads are data, never syntax, and are not walked. Marking\\n    82\\t   is idempotent and preserves node metadata and every other key, so\\n    83\\t   canonical rows, roots, and executable outcomes are unchanged.\\n    84\\t\\n    85\\t   The walk itself is `yang.core.uast/annotate-call-sites`, shared with\\n    86\\t   the other frontends' module trees; this frontend owns the contract's\\n    87\\t   constants and its validation over canonical rows.\\\"\\n    88\\t  [node]\\n    89\\t  (u/annotate-call-sites node))\\n    90\\t\\n    91\\t\\n    92\\t(defn eligible-application-sites\\n    93\\t  \\\"The eligible C1 site set of canonical `tree` (`{:root :rows}`) under\\n    94\\t   `origin`: one `[origin root-address path]` per `:application`\\n    95\\t   occurrence, derived from the occurrence relation and the row tags.\\\"\\n    96\\t  [tree origin]\\n    97\\t  (into #{}\\n    98\\t        (map (fn [[root path]] [origin root path]))\\n    99\\t        (vm/application-occurrences tree)))\\n   100\\t\\n   101\\t\\n   102\\t(defn call-site-metadata\\n   103\\t  \\\"The C1 frontend-metadata rows of canonical `tree` (`{:root :rows}`)\\n   104\\t   under `origin`: one `[origin root-address path :yang/call-site 1]`\\n   105\\t   per eligible application occurrence, in printed-row order. This is\\n   106\\t   the finalizer for trees that exist only as canonical rows — the\\n   107\\t   expander's final tree, a published module's tree — where no map AST\\n   108\\t   remains for `annotate-call-sites` to walk.\\\"\\n   109\\t  [tree origin]\\n   110\\t  (vec (sort-by pr-str\\n   111\\t                (map (fn [[root path]]\\n   112\\t                       [origin root path call-site-key call-site-version])\\n   113\\t                     (vm/application-occurrences tree)))))\\n   114\\t\\n   115\\t\\n   116\\t(defn marked-application-sites\\n   117\\t  \\\"The deduped C1 marker set of a frontend-metadata relation: one\\n   118\\t   `[origin root-address path]` per distinct `:yang/call-site` row.\\n   119\\t   Duplicate identical transport deliveries dedupe to the same fact.\\\"\\n   120\\t  [frontend-metadata]\\n   121\\t  (into #{}\\n   122\\t        (comp (filter (fn [row]\\n   123\\t                        (and (= 5 (count row)) (= call-site-key (nth row 3)))))\\n   124\\t              (map (fn [[origin root path _ _]] [origin root path])))\\n   125\\t        (distinct frontend-metadata)))\\n   126\\t\\n   127\\t\\n   128\\t(defn- marker-row?\\n   129\\t  \\\"True when frontend-metadata `row` claims the C1 key: a sequential row\\n   130\\t   whose fourth coordinate is `call-site-key`. A claiming row of any\\n   131\\t   other arity is malformed, never a row to filter away silently.\\\"\\n   132\\t  [row]\\n   133\\t  (and (sequential? row)\\n   134\\t       (<= 4 (count row))\\n   135\\t       (= call-site-key (nth row 3))))\\n   136\\t\\n   137\\t\\n   138\\t(defn validate-call-site-coverage!\\n   139\\t  \\\"Validate a complete-coverage C1 claim: the marker set of\\n   140\\t   `frontend-metadata` for canonical `tree` under `origin` must equal\\n   141\\t   the eligible application set. Returns true when the claim holds.\\n   142\\t\\n   143\\t   A row that claims the C1 key but is not a five-coordinate\\n   144\\t   `[origin root-address path key value]` row is malformed and is\\n   145\\t   rejected, never silently filtered. The delivery mode is `opts`:\\n   146\\t\\n   147\\t   - default (transport): the relation arrived over a medium, where an\\n   148\\t     at-least-once delivery may repeat a row; duplicate identical\\n   149\\t     deliveries dedupe to the same fact;\\n   150\\t   - `{:declared? true}`: the relation is a declared canonical table —\\n   151\\t     the side table a producer published as the tree's table — where a\\n   152\\t     duplicate entry is a second, conflicting claim to one fact and is\\n   153\\t     rejected;\\n   154\\t   - `{:per-occurrence-origins? true}`: the tree's occurrences do not\\n   155\\t     share one origin — the expander's final tree, whose rows carry\\n   156\\t     each occurrence's own admission or generating-expansion origin\\n   157\\t     (design §2.1, §2.3). Coverage is then compared on the\\n   158\\t     `[root-address path]` projection — the part a consumer derives\\n   159\\t     from canonical rows alone — and every marker's origin is held to\\n   160\\t     a well-formed occurrence origin; the origin VALUES are the\\n   161\\t     producer's correspondence claim, not something a consumer can\\n   162\\t     re-derive.\\n   163\\t\\n   164\\t   Conflicting values at one site, an unsupported marker version, a\\n   165\\t   malformed origin, a marker naming no occurrence, a marker on a\\n   166\\t   non-application occurrence, and missing or extra markers each\\n   167\\t   throw, naming the failed `:rule`.\\\"\\n   168\\t  ([tree frontend-metadata origin]\\n   169\\t   (validate-call-site-coverage! tree frontend-metadata origin {}))\\n   170\\t  ([tree frontend-metadata origin\\n   171\\t    {:keys [declared? per-occurrence-origins?] :as _opts}]\\n   172\\t   (doseq [row frontend-metadata]\\n   173\\t     (when (and (marker-row? row) (not= 5 (count row)))\\n   174\\t       (throw (ex-info \\\"Malformed call-site marker row\\\"\\n   175\\t                       {:rule :yang/call-site-malformed, :row row}))))\\n   176\\t   (when declared?\\n   177\\t     (doseq [[row n] (frequencies (filter marker-row? frontend-metadata))]\\n   178\\t       (when (< 1 n)\\n   179\\t         (throw (ex-info \\\"Duplicate call-site marker in a declared table\\\"\\n   180\\t                         {:rule :yang/call-site-duplicate-entry,\\n   181\\t                          :site (vec (take 3 row)), :row row})))))\\n   182\\t   (let [{:keys [root rows]} tree\\n   183\\t         tag-at (into {}\\n   184\\t                      (map (fn [[r path id]] [[r path] (nth (get rows id) 1)]))\\n   185\\t                      (vm/occurrences tree))\\n   186\\t         eligible ((if per-occurrence-origins?\\n   187\\t                     (fn [_] (vm/application-occurrences tree))\\n   188\\t                     #(eligible-application-sites tree %))\\n   189\\t                   origin)\\n   190\\t         rows (filter (fn [row]\\n   191\\t                        (and (= 5 (count row)) (= call-site-key (nth row 3))))\\n   192\\t                      (distinct frontend-metadata))\\n   193\\t         by-site (group-by (fn [[o r path _ _]] [o r path]) rows)]\\n   194\\t    (doseq [[site srows] by-site]\\n   195\\t      (when (< 1 (count (distinct (map #(nth % 4) srows))))\\n   196\\t        (throw (ex-info \\\"Conflicting call-site marker values\\\"\\n   197\\t                        {:rule :yang/call-site-conflict, :site site,\\n   198\\t                         :values (vec (distinct (map #(nth % 4) srows)))}))))\\n   199\\t    (doseq [[o r path _ value] rows]\\n   200\\t      (when (not= call-site-version value)\\n   201\\t        (throw (ex-info \\\"Unsupported call-site marker version\\\"\\n   202\\t                        {:rule :yang/call-site-unsupported-version,\\n   203\\t                         :site [o r path], :value value})))\\n   204\\t      (when (and per-occurrence-origins? (not (vm/occurrence-origin? o)))\\n   205\\t        (throw (ex-info \\\"Call-site marker carries a malformed occurrence origin\\\"\\n   206\\t                        {:rule :yang/call-site-invalid-origin,\\n   207\\t                         :site [o r path], :origin o})))\\n   208\\t      (let [tag (when (and (= r root)\\n   209\\t                           (or per-occurrence-origins? (= o origin)))\\n   210\\t                  (get tag-at [r path]))]\\n   211\\t        (cond\\n   212\\t          (nil? tag)\\n   213\\t          (throw (ex-info \\\"Call-site marker names no occurrence\\\"\\n   214\\t                          {:rule :yang/call-site-nonexistent-path,\\n   215\\t                           :site [o r path]}))\\n   216\\t          (not= :application tag)\\n   217\\t          (throw (ex-info \\\"Call-site marker on a non-application occurrence\\\"\\n   218\\t                          {:rule :yang/call-site-non-application,\\n   219\\t                           :site [o r path], :tag tag})))))\\n   220\\t    (let [marked (if per-occurrence-origins?\\n   221\\t                   (into #{}\\n   222\\t                         (map (fn [[_ r path]] [r path]))\\n   223\\t                         (marked-application-sites frontend-metadata))\\n   224\\t                   (marked-application-sites frontend-metadata))]\\n   225\\t      (when (not= eligible marked)\\n   226\\t        (throw (ex-info \\\"Call-site coverage is not complete\\\"\\n   227\\t                        {:rule :yang/call-site-incomplete-coverage,\\n   228\\t                         :missing (vec (sort-by pr-str\\n   229\\t                                                (remove marked eligible))),\\n   230\\t                         :extra (vec (sort-by pr-str\\n   231\\t                                              (remove eligible marked)))}))))\\n   232\\t    true)))\\n   233\\t\\n   234\\t\\n   235\\t(defn validate-ast-call-sites!\\n   236\\t  \\\"Validate the C1 claim of a produced map AST `ast` under `origin`:\\n   237\\t   project it and compare the eligible application set derived from its\\n   238\\t   canonical rows with the marker set of its frontend-metadata side\\n   239\\t   table. The projected table is a declared canonical table, so it is\\n   240\\t   validated strictly (`:declared? true`). Returns true when the sets\\n   241\\t   are equal.\\\"\\n   242\\t  [ast origin]\\n   243\\t  (let [tree (vm/ast->semantic-bytecode ast)\\n   244\\t        tables (vm/ast-side-tables ast tree origin)]\\n   245\\t    (validate-call-site-coverage! tree (:frontend-metadata tables) origin\\nsrc/cljc/yin/vm/linker/publish.cljc:386:(defn published-call-site-table\\nsrc/cljc/yin/vm/macro.cljc:1483:(defn call-site-table\\nsrc/cljc/yin/vm/macro.cljc:1497:  (get (:call-site-tables expander) [origin (first tree)]))\\nsrc/cljc/yin/vm/macro.cljc:1508:   admission origin beside its final root address (`call-site-tables`,\\nsrc/cljc/yin/vm/macro.cljc:1509:   resolved by `call-site-table`) — so the composition that drives this\\nsrc/cljc/yin/vm/macro.cljc:1520:      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\\nsrc/cljc/yang/clojure.cljc:138:(defn validate-call-site-coverage!\\nsrc/cljc/yang/clojure.cljc:154:   - `{:per-occurrence-origins? true}`: the tree's occurrences do not\\nsrc/cljc/yang/clojure.cljc:169:   (validate-call-site-coverage! tree frontend-metadata origin {}))\\nsrc/cljc/yang/clojure.cljc:171:    {:keys [declared? per-occurrence-origins?] :as _opts}]\\nsrc/cljc/yang/clojure.cljc:186:         eligible ((if per-occurrence-origins?\\nsrc/cljc/yang/clojure.cljc:204:      (when (and per-occurrence-origins? (not (vm/occurrence-origin? o)))\\nsrc/cljc/yang/clojure.cljc:209:                           (or per-occurrence-origins? (= o origin)))\\nsrc/cljc/yang/clojure.cljc:220:    (let [marked (if per-occurrence-origins?\\nsrc/cljc/yang/clojure.cljc:245:    (validate-call-site-coverage! tree (:frontend-metadata tables) origin\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-clojure/1795060000000-architect-p1-recheck.gpt-6-astra.stdout.log:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'no-op|correspondence|2.3|2.1' collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md; nl -ba collab/yang-clojure/1794670000000-architect-callsite-generalization-design.gpt-6-astra.findings.md | sed -n '1,160p'; nl -ba src/cljc/yin/vm/macro.cljc | sed -n '1120,1395p'\\\"\",\"aggregated_output\":\"1:# Call-site provenance: occurrence contract and durable correspondence\\n12:Adopt one language-neutral application-occurrence contract over the existing occurrence relation, one reserved frontend-metadata key, and the already-ruled third trace field. Keep code content, provenance, attribution evidence, and verification results separate. Publish the durable correspondence as an additional addressable record referring to the oracle's evidence **without changing that evidence's format**. Production adoption includes Clojure, TypeScript, PHP, Python, their preludes, and the additional ingress paths inventoried below.\\n32:### 2.1 Identity and scope\\n38:- `origin` identifies the actual admission or generation event. Admitted syntax uses `[:source medium batch-token j]`; generated syntax uses `[:expansion expansion-record-address]`. Generated post-expansion trees must not be mislabeled as original source or given a fabricated expansion address. If a no-op expansion retains an admitted tree, the original source origin remains valid; “post-expansion” names the pipeline boundary, not proof that a generating event occurred.\\n63:### 2.3 Finalization and transformations\\n67:A subsequent tree-changing transform creates another root and another occurrence relation. It must preserve an explicit old/new occurrence correspondence where it makes an attribution claim, recompute C1 for new applications, and identify generated helper calls separately. It must not retain stale paths or equate every new helper with the nearest source call. If a transform deletes, duplicates, or merges occurrences, its correspondence must record the actual multiplicity; ambiguity refuses attribution.\\n69:Macro expansion already records input root, call path, macro root, parent, output and attempt (`src/cljc/yin/vm/macro.cljc:997-1000,1062-1119`). However, final tail marking and stand-in lowering happen later (`:1255-1260`). The implementation inventory must resolve how final published roots are related to these expansion outputs. Whether the existing event/record adapters already provide the complete final-root correspondence is **unknown — the implementation round's inventory decides**. Do not assume an intermediate output record identifies every occurrence in the final assembled tree, and do not mint a fake `:expand` merely to satisfy the shape.\\n77:Canonical reconstruction deliberately shares nodes by content (`vm.cljc:1477-1486,1522-1525`). Never cache an occurrence annotation by node-id or mutate a shared canonical reconstruction and expect distinct sites to survive. Keep an occurrence cursor/side lookup, or expand occurrence-specific ephemeral images. The datom linearizer currently returns `[pc entity]`, not K (`semantic/linearize.cljc:283-302`); use an explicit entity-to-occurrence bridge with the owning batch, root and path, refusing ambiguity. `encoder/datom-entity-occurrences` and the envelope's `:yin/entity-occurrences` are the starting machinery (`encoder.cljc:67,115-148`).\\n113:| Durable correspondence | New separate schema 1 below. | Unknown schema, missing evidence, failed reconstruction or ambiguous linkage refuses reliance, independently of code loadability. |\\n117:| Linker manifest | Keep schema 1 by publishing correspondence beside it. | Adding a manifest field requires a separately versioned manifest contract and validator; current closed keys reject it. No automatic schema-2 just because R1 is now active. |\\n118:| Existing `:derive` record | Read/reference; do not add correspondence keys to it. | Current closed key set rejects extra fields and non-`:derive` ops. Reusing the record-format container for a richer correspondence would require a new/extended format, not an incidental extra field. |\\n126:Whether some existing higher-level ledger/publication mechanism can carry this new correspondence without **its own** schema change is **unknown — the implementation round's inventory decides**. The narrower question is answered: the inspected linker's `record-defect` cannot accept extra keys under today's `:yin.ledger/record`. This design avoids making that compatibility claim.\\n132:| Clojure `compile-form`, `compile`, `compile-program`, `lower-unit`: `src/cljc/yang/clojure.cljc:2021,2164,2839,2993` | Cover native and argument-vector/outcome compilation, library/adapters, linked unit wrapping and global publication. Finalize at executable roots, after expansion. Existing fragment APIs need not invent origins. |\\n136:| Python module/body/packet/SCC/stage: `yang/python/antlr/lower.cljc:2018,2030,2097,2139,2198,2298,2334-2373`; session `repl.cljc:86-108` | Cover stateless and already-primed sessions, imports, bundles/aliases and generated body wrappers; first-session prelude coverage cannot stand in for subsequent submissions. |\\n141:| Macro pipeline: `yin/vm/macro.cljc:997-1005,1062-1119,1196-1261` | Keep expansion attempt provenance, resolve final-root ownership, annotate generated occurrences and retain retrievable expansion records. Post-expansion is a required integration point. |\\n143:| Projection and row validation: `yin/vm.cljc:1113-1159,1217-1259,1262-1456,1589-1609` | Reuse grammar traversal, plain-data checks and occurrence enumeration. Add a side-table coverage validator, not C1 requirements to canonical row validation. Unannotated legacy rows remain valid. |\\n145:| Semantic row and datom lowering: `yin/vm/semantic/linearize.cljc:106-128,188-221,283-302` | Persist returned provenance, supply origins explicitly, bridge datom entities with occurrences; nil-origin legacy calls remain loadable but cannot satisfy C1 attribution. |\\n147:| Runtime dispatch and resume: `yin/vm/ast_walker.cljc:273-332,493,625-711,776`; `yin/vm/semantic.cljc:102,142,333-380` | Cold/hot application routes, operator/operand frames, linked image attachment and resumption all need occurrence context for traced execution. Native engines and UCF lifting must be audited too; no claim they already preserve caller K. |\\n148:| Existing derivation verification: `yin/vm/ledger.cljc:156-215`, `yin/vm/linker.cljc:2164-2255` | Existing verification re-lowers code and compares identities, not side metadata. Keep code verification and add independent provenance/correspondence verification. `:trusted` does not satisfy this new acceptance gate. |\\n150:| Unit publication: `yang/core/publication.cljc:92-170`, PHP `publication.cljc:27-70`, Python `publication.cljc:27-80` | Publish records for actual bundle roots; aliases cannot borrow unrelated paths. Coordinate side artifacts with index/discovery publication. PHP currently has nil site-set/binder hooks; Python's site-set hook is safepoint-specific. |\\n153:| Oracle instrumentation/accounting: `test/yang/latte_oracle_test.clj:1786-1855,2341-2405,2432-2468` | Oracle-owned trace migration, offset retirement across the full family, both lanes, refusal pins, gate accounting and evidence regeneration per R5/R6. Audit table derivation independently per R7. |\\n162:2. For each host publication: canonical row closure, semantic vector, stack/register stored images and checksums, derivation records, schema-1 manifest, pinned dependency addresses, new C1 side tables/provenance/correspondence, and discovery/index/name/signature records where used. The actual publication sequence is `yin/vm/linker/publish.cljc:156-209`. Side-only annotation should leave old code addresses unchanged; measure this rather than assume it. New side objects still need publication, retrieval and retention.\\n172:Preserve the existing failure categories: malformed canonical content fails structural validation; wrong bytes/address fails hash verification; unknown execution contract refuses load; differing lowering profile reports profile mismatch or `:unverified-derivation`; wrong recomputed output reports derivation mismatch (`vm.cljc:283-285`; `ledger.cljc:156-180`; `linker.cljc:2175-2215`). New evidence-specific failures must be distinguishable: unsupported C1/evidence version, missing provenance, bad occurrence, incomplete coverage, wrong source/adaptation hash, missing lane, ambiguous correspondence, stale declared site, or reconstruction mismatch.\\n174:A corrupted required provenance artifact refuses the provenance-dependent operation even if code itself verifies. An absent optional annotation does not make old code unloadable. A signature authenticates a publisher; it does not verify a correspondence. A trusted code link is not evidence of a recomputed correspondence.\\n176:## 4. R1 durable correspondence schema D1\\n183:{:yang.correspondence/schema 1\\n184: :yang.correspondence/evidence <Jing address of OracleEvidence>\\n185: :yang.correspondence/recipe <Jing address of reconstruction recipe>\\n186: :yang.correspondence/inputs [<Jing address> ...]\\n187: :yang.correspondence/roots [<canonical UAST root address> ...]\\n188: :yang.correspondence/origin-bindings\\n190: :yang.correspondence/artifacts\\n195: :yang.correspondence/metadata <Jing address of C1 frontend-metadata rows>\\n196: :yang.correspondence/instruction-provenance\\n209:{:yang.correspondence.recipe/schema 1\\n210: :yang.correspondence.recipe/function <qualified interpreter identifier>\\n211: :yang.correspondence.recipe/profile <address of exact reconstruction profile>\\n212: :yang.correspondence.recipe/input-roles [[<role keyword> <input index>] ...]\\n213: :yang.correspondence.recipe/evidence-contract <oracle's exact schema identity>\\n214: :yang.correspondence.recipe/coverage <address of declared coverage policy>}\\n219:`origin-bindings` is an added relation binding evidence-local sites to actual durable occurrences; **it is not a replacement attribution table**. It preserves the oracle's ephemeral ids literally. Validate every endpoint, reconstructed tree and path. A site's mapping must be unique within the claimed compilation. Multiple replay records can name the same durable occurrence only where they explicitly replay the same admission; distinct admissions must remain distinct. An oracle run without durable expansion/source records cannot be promoted merely by changing `:ephemeral` to `:expansion`. It may remain useful oracle evidence without a durable binding. To accept a relying consumer, reproduce the actual compilation under recorded durable admissions/expansions and verify its correspondence; do not retroactively assert an unrecorded event.\\n237:D1 does not revise old site tables, force old module manifests to schema 2, or automatically validate the oracle's historical evidence. If actual integration requires changing a closed publication record, that specific schema revision returns to the A2 inventory. Unknown recipes refuse verification; `:trusted` is never substituted for `:verifying` (linker design `:1902-1921`).\\n243:Each adoption brief must cite this findings file and C1/D1 by revision. The shared occurrence finalizer/validator and provenance publication work precede or accompany frontend implementation; D1 independent verification precedes acceptance of the first frontend consumer that relies on D1. A frontend may adopt static annotation without consuming oracle attribution, but cannot call that durable correspondence acceptance.\\n276:**Clojure.** Inventory native/argument-vector/outcome compile options, `compile` vs `compile-program`, `compile-form` callers, macro expansion, `lower-unit`, `library-for`, direct walker/datoms/rows lanes, REPL single/multi-form and linked runtime publication. Show a non-oracle production fixture traversing the full pipeline, including macro-generated and helper calls. Republish `clj` and `yang.call` on each host. Oracle-specific stamping is instantiation #1 only; it does not close this brief. Anchors: `yang/clojure.cljc:2021-2034,2164-2200,2791,2839-2862,2993-3021`.\\n278:**TypeScript.** Cover `lower-module-body`, `lower-unit`, `lower-units`, `lower-packet`, streaming stage, bundled and linked `js`, `yang.call`, and safepoint runtime. Track new publication/SCC/session paths from the seats when they land; do not infer their implementation from design prose. Generated member/constructor/runtime dispatch applications get their own K; source-call attribution is a separate query. Anchors: `lower.cljc:1167-1211,2262-2363`; `prelude.cljc:4168-4260`.\\n282:**Python.** Cover packet and module lowering, import units, SCC aliases, bundled/linked `py`, `yang.call`, `pysp`, hook staging/site-set discovery, and both fresh/primed REPL sessions. Do not conflate `:yang/site` hook sites with complete application occurrence coverage. Republish the DHT fixture and validate parserless imports on other hosts. Anchors: `lower.cljc:1111-1120,1775,2018-2373`; `repl.cljc:86-108`; `publication.cljc:51-80`; `siteset.cljc:5-31`.\\n284:Each brief's acceptance bundle contains: exact producer/artifact checklist; input/commit/profile pins; C1 coverage counts and root/hash invariance; four-host results and cross-host equality report; correctness battery results; before/after budgets and measurements; legacy-load/missing-provenance refusal; and D1 verification result if it relies on correspondence. No frontend can satisfy this bundle merely by running the oracle test.\\n357:| Transform/staging | Safepoint insertion, module/SCC wrapping, imported code, alias projection and name canonicalization cannot leave stale roots/paths. Prove correspondence or refuse; annotate new helpers independently. |\\n363:The relevant runtime paths are real, not hypothetical surface names: walker `apply-function` and operand frames (`ast_walker.cljc:273-332`), park/resume and ready queue (`:214-231,467-473,625-711`), semantic restoration (`semantic.cljc:102-130`), and native `:call/:ffi-call/:resume` lowering (`semantic/derive.cljc:92-102`). Frontend-specific suspension fixtures must use supported operations; unsupported language constructs remain explicit refusals. Continuation replay can produce repeated execution events, so the three-field trace is deliberately insufficient for invocation causality; D1 must not claim more than the oracle's existence-based attribution.\\n     1\\t# Call-site provenance: occurrence contract and durable correspondence\\n     2\\t\\n     3\\tStatus: architect design; no implementation or adoption acceptance claimed.\\n     4\\tAuthority: signed Addendum A v3 and signed attribution ruling v4.\\n     5\\tScope: read-only source investigation; this findings document is the sole output.\\n     6\\tDesign revision: 1 (2026-11-06).\\n     7\\t\\n     8\\tCitation convention: paths beginning `yang/` or `yin/` are under `src/cljc/`; a shortened filename inherits the nearest explicit namespace/path. `ruling-of-record.md` abbreviates the signed 1794600000000 ruling named in §1; `code-as-tuples.md` abbreviates `docs/design/yin.vm.code-as-tuples.md`. Line ranges identify inspected source, while normative decisions in C1/D1 and the acceptance gates are new design requirements.\\n     9\\t\\n    10\\t## 1. Decision and evidence limits\\n    11\\t\\n    12\\tAdopt one language-neutral application-occurrence contract over the existing occurrence relation, one reserved frontend-metadata key, and the already-ruled third trace field. Keep code content, provenance, attribution evidence, and verification results separate. Publish the durable correspondence as an additional addressable record referring to the oracle's evidence **without changing that evidence's format**. Production adoption includes Clojure, TypeScript, PHP, Python, their preludes, and the additional ingress paths inventoried below.\\n    13\\t\\n    14\\tThe authority is `collab/yang-clojure/1794630000000-architect-attribution-addendum-a-RECORD.md:13-29` (A1–A4 and measurements), and `collab/yang-clojure/1794600000000-architect-attribution-as-query-ruling-of-record.md:11-73` (R1–R7). In particular, signed A4 at line 25 explicitly strikes “or atomically with”: **implementation AND independent reconstruction must pass BEFORE acceptance of the first additional relying consumer**. Simultaneous code landing is possible; simultaneous acceptance before reconstruction is not. The oracle remains unblocked.\\n    15\\t\\n    16\\tRead order was addendum, architectural foundations, signed base ruling, then the recorded Astra addendum review. Astra's final review is the JSON agent-message at `1794630000000-architect-attribution-addendum-a.astra-review.stdout.log:48`; signed v3 supersedes its earlier “before, or atomically with” wording. No separate qwen addendum review was present in `collab/yang-clojure/` during this inspection. The available `1794610000000-architect-attribution-as-query-ruling.qwen-review.md` is a base-ruling review, not the missing addendum review. Signed v3 records incorporation of qwen's amendments at lines 3–4.\\n    17\\t\\n    18\\tSource inspection occurred in a live workspace: master initially reported `e158afca`, later `5854869c5117e3659d8ce3bc3f140d017d7b8687`. Citations below identify inspected file locations, not a claim that all work was read from an immutable commit. Rebase/inventory refresh after the cell-ref sweeps and J2 is an implementation prerequisite. No tests, compilers, generators, or publication commands were run for this design.\\n    19\\t\\n    20\\t### 1.1 The oracle format is not yet available to freeze\\n    21\\t\\n    22\\tThe inspected worktree `/Users/sto/workspace/datomworld-aaq`, branch `attribution-as-query`, reports HEAD `3eebe844e406ba56bc38a5f4b4a0098d811b5efd`. Its tracked `test/yang/latte_oracle_test.clj:1794-1839` still generates two-field body-entry traces and uses the offset accounting at lines 1786–1819. Its `BRIEF-aaq.md:15-21` requires the future inventory, three-field instrumentation, and versioned mechanically derived site tables; it does not define their schema. Untracked `probe/aaq_probe.clj:17-29` uses exploratory map-key paths, not the canonical row-position paths; it is not a published contract. The local dispatch log `collab/yang-clojure/1794630000000-engineer-attribution-as-query.glm-5.3.stdout.log:1` reports an unrecognized-model error. This does not establish the status of work elsewhere.\\n    23\\t\\n    24\\tConsequently **the oracle evidence schema's exact identifier, field names, and canonical-source-hash algorithm/profile are unknown — the implementation round's inventory decides from the oracle's accepted record**. This document specifies the envelope around that record and its verification obligations, not an independently invented replacement site-table schema. “OracleEvidence” below means the entire accepted versioned oracle value, verbatim, including its site ids, argument-shape declarations, fixture linkage, trace schema, and version. Before durable implementation is accepted, the inventory must pin its concrete file, commit, schema identifier/version, validator, and derivation entry point. Absence of that pin blocks durable acceptance; it does not block the oracle round.\\n    25\\t\\n    26\\tThis is the format-race control demanded by A4. An implementation must not adopt a hypothetical table in this document or mistake `throw_sites.edn` for the new caller-site table.\\n    27\\t\\n    28\\t## 2. Occurrence contract C1\\n    29\\t\\n    30\\tThe following is the proposed normative contract, grounded in `docs/design/yin.vm.code-as-tuples.md:393-455,658-665,918-931`.\\n    31\\t\\n    32\\t### 2.1 Identity and scope\\n    33\\t\\n    34\\tAn application site is `K = [origin root-address path]`.\\n    35\\t\\n    36\\t- `root-address` is the canonical root of the particular final UAST tree being named, not the application's subtree address or an instrumented runtime-map hash.\\n    37\\t- `path` is the grammar's structural path: scalar child slot steps are row positions; a child in a `nodes` slot is `[slot-position member-index]`. The root is `[]`. Never substitute map keys, host iteration order, allocation ids, source line numbers, PCs, callee names, or arities.\\n    38\\t- `origin` identifies the actual admission or generation event. Admitted syntax uses `[:source medium batch-token j]`; generated syntax uses `[:expansion expansion-record-address]`. Generated post-expansion trees must not be mislabeled as original source or given a fabricated expansion address. If a no-op expansion retains an admitted tree, the original source origin remains valid; “post-expansion” names the pipeline boundary, not proof that a generating event occurred.\\n    39\\t- An origin is supplied by the admitting/generating composition. Two separately admitted identical sources have different origins; two identical applications in one tree have different paths; two expansion attempts with identical output have different producing records. Replaying a single recorded admission is different from admitting the same text again.\\n    40\\t\\n    41\\tThe implemented origin validator accepts exactly the source and expansion shapes (`src/cljc/yin/vm.cljc:938-958`). `vm/occurrences` returns `[root path node-id]`, one per place, with origin fixed by the composition; it does not return full keys or count only distinct row ids (`vm.cljc:1589-1609`).\\n    42\\t\\n    43\\tCoverage is **every final `:application` occurrence**, including generated wrappers, adapters, dispatcher/helper calls, bundled preludes, imported preludes, recursion, and statically indirect applications. “Source call” and “attributable upstream call” are projections over this coverage, not filters that delete other occurrences. Rule R's `yin/def` is structurally an application but lowers to `:define`; it gets an occurrence annotation and never a fictitious callee-entry event (`semantic/linearize.cljc:106-116`).\\n    44\\t\\n    45\\tDedicated operations such as `:dao.stream.apply/call`, stream nodes, and continuation nodes retain existing instruction provenance. They are not silently counted as `:application` sites. Their adapters' application occurrences are covered; an extension to count other node kinds must explicitly version the coverage policy (`vm.cljc:1015-1028`; `semantic/linearize.cljc:126-139`).\\n    46\\t\\n    47\\t### 2.2 Minimal persisted annotation\\n    48\\t\\n    49\\tReserve `:yang/call-site` in the existing frontend-metadata relation:\\n    50\\t\\n    51\\t```clojure\\n    52\\t[origin root-address path :yang/call-site 1]\\n    53\\t```\\n    54\\t\\n    55\\tThe integer `1` versions this key's coverage/interpretation contract. The first three coordinates ARE the site id; the value does not repeat it. This key is distinct from existing `:yang/site`, whose meaning is safepoint marks (`src/cljc/yang/safepoint.cljc:55-75`). It carries no language name, source arity, ambient-context classification, or callee identity. Those are consumer evidence derived by the oracle or another explicitly versioned consumer.\\n    56\\t\\n    57\\tThe marker certifies that a producer preserved this occurrence under C1; the application predicate itself remains derived from canonical rows. There is no new canonical fact asserting what the grammar already says. A consumer can derive the eligible application set and compare it with the complete marker set. Under a C1 publication claim the sets must be equal; mere absence of annotations in an older publication is not false evidence of zero applications.\\n    58\\t\\n    59\\tEmit precisely one logical marker per eligible occurrence. Duplicate identical transport deliveries may be deduplicated as the same immutable fact; duplicate entries in a declared canonical table, conflicting values, unsupported versions, nonexistent paths, non-application targets, and missing/extra rows under a complete-coverage claim are validation failures. Other frontend metadata is preserved independently.\\n    60\\t\\n    61\\tImplementation may add this marker to temporary frontend map nodes before side-table projection, since the current extractor recognizes namespace `yang` (`vm.cljc:1183-1214`). Prefer deriving the relation directly from validated rows where map attachment would be redundant. `ast->semantic-bytecode` hashes only grammar slots and drops other node keys (`vm.cljc:1113-1123`); no grammar slot, instruction operand, canonical datom slot, or AST contract revision is authorized by C1.\\n    62\\t\\n    63\\t### 2.3 Finalization and transformations\\n    64\\t\\n    65\\tFinalize paths only after macro expansion, generated-name canonicalization, wrappers, module/SCC assembly, and tail marking that determine the named tree. Source-level annotations alone cannot cover generated calls (base ruling R2 at line 17). Low-level functions returning fragments may defer finalization until an owning root and origin exist; each executable/publication ingress must invoke the common finalizer. A frontend cannot claim adoption by marking just its parser or user-call lowering arm.\\n    66\\t\\n    67\\tA subsequent tree-changing transform creates another root and another occurrence relation. It must preserve an explicit old/new occurrence correspondence where it makes an attribution claim, recompute C1 for new applications, and identify generated helper calls separately. It must not retain stale paths or equate every new helper with the nearest source call. If a transform deletes, duplicates, or merges occurrences, its correspondence must record the actual multiplicity; ambiguity refuses attribution.\\n    68\\t\\n    69\\tMacro expansion already records input root, call path, macro root, parent, output and attempt (`src/cljc/yin/vm/macro.cljc:997-1000,1062-1119`). However, final tail marking and stand-in lowering happen later (`:1255-1260`). The implementation inventory must resolve how final published roots are related to these expansion outputs. Whether the existing event/record adapters already provide the complete final-root correspondence is **unknown — the implementation round's inventory decides**. Do not assume an intermediate output record identifies every occurrence in the final assembled tree, and do not mint a fake `:expand` merely to satisfy the shape.\\n    70\\t\\n    71\\t### 2.4 Lowering, reconstruction, and runtime lookup\\n    72\\t\\n    73\\tPersist the existing instruction relation `[segment-address pc origin root-address path]`. The row linearizer already returns `{:address ... :provenance [[pc origin root path] ...]}`; its caller supplies the segment coordinate (`semantic/linearize.cljc:188-214`; code-as-tuples §5.3 at lines 918–931). A call dispatch looks up its **own call instruction's** emitting occurrence, not the preceding operand's instruction or the callee's body. Multiple instructions may belong to one occurrence.\\n    74\\t\\n    75\\tSegment+PC alone is insufficient when identical code is loaded under two origins. The runtime must retain its load/admission origin alongside its image reference when selecting provenance. This is an occurrence-scoped runtime context, not a new code hash. The native image derivations must supply or independently reconstruct a mapping from their call PCs back through semantic PCs to K; PC equality across formats must not be assumed. Current semantic `resolve` preserves PCs, register derivation preserves layout, and stack derivation emits a new sequence (`semantic/derive.cljc:21-42,60-93,154-172`).\\n    76\\t\\n    77\\tCanonical reconstruction deliberately shares nodes by content (`vm.cljc:1477-1486,1522-1525`). Never cache an occurrence annotation by node-id or mutate a shared canonical reconstruction and expect distinct sites to survive. Keep an occurrence cursor/side lookup, or expand occurrence-specific ephemeral images. The datom linearizer currently returns `[pc entity]`, not K (`semantic/linearize.cljc:283-302`); use an explicit entity-to-occurrence bridge with the owning batch, root and path, refusing ambiguity. `encoder/datom-entity-occurrences` and the envelope's `:yin/entity-occurrences` are the starting machinery (`encoder.cljc:67,115-148`).\\n    78\\t\\n    79\\t### 2.5 Ephemeral origin and trace field\\n    80\\t\\n    81\\tName the nonpersistent domain **ephemeral instrumentation origin**. Its C1 spelling is:\\n    82\\t\\n    83\\t```clojure\\n    84\\t[:ephemeral evidence-scope-token compilation-token member-index]\\n    85\\t;; ephemeral site:\\n    86\\t[ephemeral-origin canonical-compiled-root structural-path]\\n    87\\t;; already signed trace shape:\\n    88\\t[fname arity caller-site-id]\\n    89\\t```\\n    90\\t\\n    91\\tThe composition supplies two non-nil plain-data tokens: `evidence-scope-token` names the recording/fixture scope; `compilation-token` names this particular instrumented compilation in that scope. `member-index` is a nonnegative integer. They are explicitly recorded inputs, not inferred from source hash, host object identity, time, lane name, or callee. Both oracle C lanes execute the SAME compiled artifact with the same tokens; a separate compilation gets another token. Replay uses the recorded tokens. A source hash alone would collapse distinct attempts.\\n    92\\t\\n    93\\tThis is a precise proposed spelling for the still-unfrozen oracle implementation. It is **not** a third legal persisted occurrence origin: `vm/occurrence-origin?` must continue rejecting it. An EDN evidence file may preserve an ephemeral id as evidence of that run; that does not convert it into a portable code occurrence. Persisted C1 side tables and expansion links require real ruled origins.\\n    94\\t\\n    95\\tThe canonical compiled root is computed after code-producing instrumentation that changes the AST, before occurrence stamps are associated into runtime maps. Runtime stamping must not introduce a root-hash self-reference. If instrumentation subsequently changes structure, it must carry an explicit transform mapping or recompute the frozen site table; no path can silently retain its old meaning.\\n    96\\t\\n    97\\tThe oracle must finalize the spelling in its own versioned evidence contract and use that format once. If its accepted schema differs by the time implementation starts, preserve its evidence verbatim and publish a reviewed binding of its origin fields to this semantic domain; do not rewrite its tables behind an unchanged version. A semantic conflict (no compilation scope, map-key paths, callee ids) requires correction on the oracle's record, not a silent normalization in durable verification.\\n    98\\t\\n    99\\tRuntime `assoc` stamping is explicitly licensed by §2.6, owner ruling 2026-09-15: the walker holds an ephemeral image and nothing runtime-associated is projected back to canonical rows; runtime keys must be stripped at serialization/projection of continuation frames (`docs/design/yin.vm.code-as-tuples.md:459-474`). Static frontend marker extraction is a separate, pre-execution side-table operation. This clause licenses oracle-specific walker instrumentation; it does not establish ordinary production coverage.\\n   100\\t\\n   101\\tCapture the caller K at actual application dispatch, after operator/operand evaluation, and preserve it until that callee's body-entry record. Nested argument calls must not overwrite it. Tail dispatch carries the new caller K even if it reuses a frame. A helper's call carries the helper's own K; no automatic inheritance of upstream credit. Unknown caller linkage yields no credit. Repeated recursion can record the same site many times; R3's consumer is existence-based, not a proof of invocation-by-invocation causality (`ruling-of-record.md:17-34`).\\n   102\\t\\n   103\\t## 3. A2 inventory: revisions, preservation, and refusal\\n   104\\t\\n   105\\tThis is a design inventory of the reachable surfaces found in the inspected sources. The implementation's first deliverable refreshes file/symbol locations after the prerequisite merges, expands each wildcard artifact family into an exact list, and assigns every item “changed”, “read/verified”, or “not reached with proof”. Newly discovered producers cannot be excluded merely because this table predates their merge.\\n   106\\t\\n   107\\t### 3.1 Contract revision decisions\\n   108\\t\\n   109\\t| Contract | Decision for this design | Revision trigger and mismatch behavior |\\n   110\\t|---|---|---|\\n   111\\t| C1 frontend metadata | New reserved key/value version 1 and coverage validator. Existing five-coordinate relation is unchanged. | Unknown marker version or malformed/incomplete claimed annotation refuses C1-dependent attribution. Ordinary legacy code loading remains available. |\\n   112\\t| Oracle evidence | The oracle owns the new versioned site-table and three-field trace contract. Durable work imports it verbatim. | Two-field evidence is not silently upgraded to three fields. Wrong schema/hash/fixture/lane/site-shape refuses attribution. Preserve old evidence as historical data. |\\n   113\\t| Durable correspondence | New separate schema 1 below. | Unknown schema, missing evidence, failed reconstruction or ambiguous linkage refuses reliance, independently of code loadability. |\\n   114\\t| UAST/row/datom grammar | Read and validate; no C1 change. Current AST stamp is `v3`. | Existing `check-contract!` and structural/hash checks remain. Do not add a canonical slot or broaden origins to accept ephemeral ids. |\\n   115\\t| Semantic/stack/register execution contracts | Read and validate; no instruction-grammar change specified. Current stamps are `v4`, `b2`, `r2`. | Revise only if implementation changes instruction grammar or execution semantics. A new trace field in a harness stream alone does not revise these. |\\n   116\\t| Code lowering profiles | Read, and verify unchanged code output. A separately versioned provenance recipe names any new side mapping. | Revise the relevant code profile if a pinned lowering rule or emitted code changes, even if execution grammar does not. A side-only addition must not masquerade as validation by the old derivation verifier. |\\n   117\\t| Linker manifest | Keep schema 1 by publishing correspondence beside it. | Adding a manifest field requires a separately versioned manifest contract and validator; current closed keys reject it. No automatic schema-2 just because R1 is now active. |\\n   118\\t| Existing `:derive` record | Read/reference; do not add correspondence keys to it. | Current closed key set rejects extra fields and non-`:derive` ops. Reusing the record-format container for a richer correspondence would require a new/extended format, not an incidental extra field. |\\n   119\\t| Frontend catalog revision/profile | Change the frontend revision and relevant annotation/support profile when its publication/coverage promise changes. | Existing revision pinning and conflict/incompatible refusal remain; keep SPI 1 unless its actual request/response protocol changes. |\\n   120\\t| Safepoint, site-set and binder contracts | Read; preserve distinct purpose and identities. | Revise only if their serialized content/selection/transform rules change. Do not alias `:yang/call-site` to `:yang/site`. |\\n   121\\t| Continuation/UCF/checkpoint contracts | Read/inventory initially. | If a provenance-dependent consumer requires new serialized runtime state, inventory and version that actual state contract before shipping. A transient field cannot be silently serialized or relied on after migration. |\\n   122\\t| Parser/CST and `yin.cic.spec` | Read only for C1. | No parser grammar/CST revision or CIC v1 change follows merely from side metadata; R4 explicitly leaves CIC v1 untouched. |\\n   123\\t\\n   124\\tCurrent constants: `src/cljc/yin/vm.cljc:262-285`. Some design prose still says semantic `v3` (`docs/design/yin.vm.linker.md:1879-1884`); implementation inventory must use the current source stamp, not copy stale prose. Revision principles: `code-as-tuples.md:859-913`, `yin.vm.linker.md:1871-1921`. Concrete closed validators: `linker.cljc:731-759,841-871`. Frontend revision semantics: `yang/frontend.cljc:15-16,87-98,166-200`.\\n   125\\t\\n   126\\tWhether some existing higher-level ledger/publication mechanism can carry this new correspondence without **its own** schema change is **unknown — the implementation round's inventory decides**. The narrower question is answered: the inspected linker's `record-defect` cannot accept extra keys under today's `:yin.ledger/record`. This design avoids making that compatibility claim.\\n   127\\t\\n   128\\t### 3.2 Producer-to-consumer preservation inventory\\n   129\\t\\n   130\\t| Surface and inspected locations | Required implementation work / read-only dependency |\\n   131\\t|---|---|\\n   132\\t| Clojure `compile-form`, `compile`, `compile-program`, `lower-unit`: `src/cljc/yang/clojure.cljc:2021,2164,2839,2993` | Cover native and argument-vector/outcome compilation, library/adapters, linked unit wrapping and global publication. Finalize at executable roots, after expansion. Existing fragment APIs need not invent origins. |\\n   133\\t| TypeScript packet/body/unit/multi-unit/stage: `yang/typescript/antlr/lower.cljc:2262-2363` | Cover bundled and linked runtime paths, canonical names and tail marks, all units and generated runtime calls. Preserve packet/source association separately. |\\n   134\\t| PHP ANTLR body/program/packet/module/SCC/stage: `yang/php/antlr/lower.cljc:3737,3759,3800,3840,3855,3929,3998-4041` | Cover includes, class-map units, strict-types variants, SCC bundles/aliases, helpers and linked/bundled paths. |\\n   135\\t| Legacy PHP `compile-program/compile`: `yang/php.cljc:640-685` | Additional live frontend, not retired by the presence of ANTLR. Annotate all generated combinator/wrapper applications too. |\\n   136\\t| Python module/body/packet/SCC/stage: `yang/python/antlr/lower.cljc:2018,2030,2097,2139,2198,2298,2334-2373`; session `repl.cljc:86-108` | Cover stateless and already-primed sessions, imports, bundles/aliases and generated body wrappers; first-session prelude coverage cannot stand in for subsequent submissions. |\\n   137\\t| REPL frontend catalog: `yin/repl/frontends.cljc:24-110` | Covers single-form vs multi-form Clojure, legacy PHP, Python session lowering and Jolt native parser selection. Standard catalog does not currently register TypeScript; direct TS paths still require adoption. |\\n   138\\t| Common UAST/prelude/call/module emitters: `yang/core/prelude.cljc:44-69,138-159`, `yang/core/call.cljc:184-191`, `yang/core/module.cljc:31-99` | These produce wrapper/helper/prelude code outside source-call arms. Apply common finalization at the owning publication, including direct hand-built UAST accepted as frontend output. |\\n   139\\t| Common streaming stage: `yang/core/stage.cljc:25-59` | It currently supplies medium plus packet unit as batch token. Audit distinct re-admissions of the same unit: C1 requires fresh admission identity while retry keeps the token; packet identity alone is insufficient if reused for distinct admissions. |\\n   140\\t| Encoder map/rows/datoms: `yin/vm/encoder.cljc:25-43,67-148,230-258` | Map projection emits side tables; already-projected rows currently return empty tables; envelope projection replaces table fields. Preserve/validate supplied metadata and finalize generated output instead of silently dropping it. Maintain batch member j. |\\n   141\\t| Macro pipeline: `yin/vm/macro.cljc:997-1005,1062-1119,1196-1261` | Keep expansion attempt provenance, resolve final-root ownership, annotate generated occurrences and retain retrievable expansion records. Post-expansion is a required integration point. |\\n   142\\t| Safepoint insertion: `yang/safepoint.cljc:234-256` | Current derived envelope explicitly clears frontend metadata, source positions and entity occurrences. New root needs fresh C1 plus verified input/output mapping; preserve the safepoint record's separate semantics. |\\n   143\\t| Projection and row validation: `yin/vm.cljc:1113-1159,1217-1259,1262-1456,1589-1609` | Reuse grammar traversal, plain-data checks and occurrence enumeration. Add a side-table coverage validator, not C1 requirements to canonical row validation. Unannotated legacy rows remain valid. |\\n   144\\t| Canonical and datom reconstruction: `yin/vm.cljc:705,818-851,1477-1555` | Side metadata does not reappear from content alone. Attach provenance context out of band; do not collapse occurrence ids via shared reconstruction/entity ids. Round-trip canonical hashes must remain equal. |\\n   145\\t| Semantic row and datom lowering: `yin/vm/semantic/linearize.cljc:106-128,188-221,283-302` | Persist returned provenance, supply origins explicitly, bridge datom entities with occurrences; nil-origin legacy calls remain loadable but cannot satisfy C1 attribution. |\\n   146\\t| Native lowering: `yin/vm/semantic/derive.cljc:21-42,60-120,154-184` | Produce/reconstruct complete native-call-PC provenance; compose with semantic mapping. Sparse variable/closure diagnostics do not establish call coverage. Inventory any legacy direct de Bruijn lowering still reached after merges. |\\n   147\\t| Runtime dispatch and resume: `yin/vm/ast_walker.cljc:273-332,493,625-711,776`; `yin/vm/semantic.cljc:102,142,333-380` | Cold/hot application routes, operator/operand frames, linked image attachment and resumption all need occurrence context for traced execution. Native engines and UCF lifting must be audited too; no claim they already preserve caller K. |\\n   148\\t| Existing derivation verification: `yin/vm/ledger.cljc:156-215`, `yin/vm/linker.cljc:2164-2255` | Existing verification re-lowers code and compares identities, not side metadata. Keep code verification and add independent provenance/correspondence verification. `:trusted` does not satisfy this new acceptance gate. |\\n   149\\t| Generic publication: `yin/vm/linker/publish.cljc:115-218` | Currently takes only `:vector` from `project-rows` at line 157. Publish complete side artifacts and origin/record closure beside code; do not discard provenance or change manifest keys casually. Validate before making a C1 availability claim. |\\n   150\\t| Unit publication: `yang/core/publication.cljc:92-170`, PHP `publication.cljc:27-70`, Python `publication.cljc:27-80` | Publish records for actual bundle roots; aliases cannot borrow unrelated paths. Coordinate side artifacts with index/discovery publication. PHP currently has nil site-set/binder hooks; Python's site-set hook is safepoint-specific. |\\n   151\\t| Site-set discovery/signing precedent: `yang/python/antlr/siteset.cljc:5-31,65-101` | Reuse the separate-record-by-manifest pattern and declared-principal verification where appropriate. Its exact key schema is not the caller-site or oracle schema. Inventory discovery/fetch/retention paths for the new record explicitly. |\\n   152\\t| Code index / republishing: `yin/repl/ast_index.cljc:3-24,108`; `yin/vm/linker/publish.cljc:225-300` | Query views can be rebuilt from rows but cannot recover omitted admission provenance. Session/index-to-module publication must preserve or explicitly remap occurrence roots, and retain original evidence sources. |\\n   153\\t| Oracle instrumentation/accounting: `test/yang/latte_oracle_test.clj:1786-1855,2341-2405,2432-2468` | Oracle-owned trace migration, offset retirement across the full family, both lanes, refusal pins, gate accounting and evidence regeneration per R5/R6. Audit table derivation independently per R7. |\\n   154\\t\\n   155\\t### 3.3 Persisted artifacts and publication blast radius\\n   156\\t\\n   157\\t“Side tables are additive” is the compatibility policy, not permission to skip republishing coverage evidence. **Unannotated persisted artifacts remain loadable under their supported existing code contracts.** A provenance-requiring query returns missing provenance/refuses credit; it never invents identity from names, hashes, arities, values or source lines. Old provenance may be reconstructed only when the actual admission/expansion inputs are retained, and the result is a newly verified artifact.\\n   158\\t\\n   159\\tThe implementation inventory must enumerate, regenerate where changed, and verify these families on **all four host lanes**:\\n   160\\t\\n  1120\\t                    (if-let [e (guard-batch-rows st')]\\n  1121\\t                      [(failed st' e) address]\\n  1122\\t                      (let [out (first tree)\\n  1123\\t                            ev (begin out nil)\\n  1124\\t                            st' (-> st'\\n  1125\\t                                    (record-event ev)\\n  1126\\t                                    (update :produced\\n  1127\\t                                            (fn [p]\\n  1128\\t                                              (if (some #(= out (first %)) p)\\n  1129\\t                                                p\\n  1130\\t                                                (conj p (packet-of (:index st') out))))))]\\n  1131\\t                        (expand-node st' out\\n  1132\\t                                     {:path path,\\n  1133\\t                                      :rel [],\\n  1134\\t                                      :frame {:parent (first ev), :root out},\\n  1135\\t                                      :shadow shadow,\\n  1136\\t                                      :depth (inc depth),\\n  1137\\t                                      :origin-of\\n  1138\\t                                      (fn [a]\\n  1139\\t                                        (if (contains? input-addrs a)\\n  1140\\t                                          admitted-origin\\n  1141\\t                                          ;; the recorded expansion event\\n  1142\\t                                          ;; row is the real expansion\\n  1143\\t                                          ;; record (§8); its content\\n  1144\\t                                          ;; address is the expansion\\n  1145\\t                                          ;; origin (§2.1)\\n  1146\\t                                          [:expansion (first ev)]))})))))))))))))\\n  1147\\t\\n  1148\\t\\n  1149\\t(defn- expand-children\\n  1150\\t  \\\"Expand `row`'s children in order `places` under per-child shadows;\\n  1151\\t   `[st address']`, rebuilding the row when any child changed.\\\"\\n  1152\\t  [st row places shadow-of {:keys [path rel] :as loc}]\\n  1153\\t  (let [[st children']\\n  1154\\t        (reduce (fn [[st acc] [coord c]]\\n  1155\\t                  (if (:error st)\\n  1156\\t                    (reduced [st acc])\\n  1157\\t                    (let [[st c'] (expand-node st c\\n  1158\\t                                               (assoc loc\\n  1159\\t                                                      :path (conj path coord)\\n  1160\\t                                                      :rel (conj rel coord)\\n  1161\\t                                                      :shadow (shadow-of coord)))]\\n  1162\\t                      [st (conj acc c')])))\\n  1163\\t                [st []]\\n  1164\\t                places)]\\n  1165\\t    (if (:error st)\\n  1166\\t      [st (first row)]\\n  1167\\t      (let [[index a'] (rebuild-row (:index st) row places children')]\\n  1168\\t        [(assoc st :index index) a']))))\\n  1169\\t\\n  1170\\t\\n  1171\\t(defn- expand-node\\n  1172\\t  \\\"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\\n  1173\\t   `rel` path within the current `frame` (`{:root r :parent event|nil\\n  1174\\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\\n  1175\\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\\n  1176\\t   answers the origin of the admission or generation event that\\n  1177\\t   produced the syntax of the row at `address`. Every application\\n  1178\\t   occurrence is recorded under its absolute path as it is visited, so\\n  1179\\t   the finalizer can name each occurrence's real origin; an occurrence\\n  1180\\t   replaced by an expansion is re-recorded by the expansion's own walk,\\n  1181\\t   and a stale entry for a path the finished tree no longer applies at\\n  1182\\t   is simply never read. Returns `[st address']`; a failure sets\\n  1183\\t   `(:error st)`.\\\"\\n  1184\\t  [st address {:keys [shadow] :as loc}]\\n  1185\\t  (if (:error st)\\n  1186\\t    [st address]\\n  1187\\t    (let [row (get (:index st) address)\\n  1188\\t          tag (row-tag row)]\\n  1189\\t      (cond\\n  1190\\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\\n  1191\\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\\n  1192\\t\\n  1193\\t        (= :application tag)\\n  1194\\t        (let [st (update-in st [:call-site-origins]\\n  1195\\t                            assoc (:path loc) ((:origin-of loc) address))\\n  1196\\t              op (nth row 2)\\n  1197\\t              [st op'] (expand-node st op (-> loc\\n  1198\\t                                              (update :path conj 2)\\n  1199\\t                                              (update :rel conj 2)))]\\n  1200\\t          (if (:error st)\\n  1201\\t            [st address]\\n  1202\\t            (let [[index app'] (if (= op op')\\n  1203\\t                                 [(:index st) address]\\n  1204\\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\\n  1205\\t                  st (assoc st :index index)\\n  1206\\t                  row' (get index app')]\\n  1207\\t              (if (macro-of st op' shadow)\\n  1208\\t                ;; recognition is not expansion: depth is unchanged\\n  1209\\t                (expand-node st app' loc)\\n  1210\\t                (expand-children st row' (rest (child-places row'))\\n  1211\\t                                 (constantly shadow) loc)))))\\n  1212\\t\\n  1213\\t        :else\\n  1214\\t        (let [shadow' (if (= :lambda tag) (into shadow (nth row 2)) shadow)]\\n  1215\\t          (expand-children st row (child-places row)\\n  1216\\t                           (constantly shadow') loc))))))\\n  1217\\t\\n  1218\\t\\n  1219\\t;; =============================================================================\\n  1220\\t;; The batch (§3.1, §3.2)\\n  1221\\t;; =============================================================================\\n  1222\\t\\n  1223\\t(defn- log-packet\\n  1224\\t  [st]\\n  1225\\t  [:yin.macro/log (:events st) (:produced st)])\\n  1226\\t\\n  1227\\t\\n  1228\\t(defn- with-default-guards\\n  1229\\t  [ctx]\\n  1230\\t  (update ctx :guards #(merge default-guards %)))\\n  1231\\t\\n  1232\\t\\n  1233\\t(defn- batch-call-site-claims\\n  1234\\t  \\\"The per-member call-site (C1) claim verdicts the encoder recorded on\\n  1235\\t   `batch`: nil when no member claimed coverage, otherwise one boolean\\n  1236\\t   per member — the encoder validated every member's markers against\\n  1237\\t   its own tree at the boundary, so a member whose markers do not\\n  1238\\t   exactly cover it was refused there, never delivered here. Each\\n  1239\\t   member's own verdict decides its metadata: only a member that\\n  1240\\t   claimed coverage finalizes a side table, whatever its siblings\\n  1241\\t   claimed.\\\"\\n  1242\\t  [batch]\\n  1243\\t  (nth batch 5 nil))\\n  1244\\t\\n  1245\\t\\n  1246\\t(defn- final-call-site-metadata\\n  1247\\t  \\\"The call-site occurrence contract's (C1) side table of an expanded\\n  1248\\t   final tree, as frontend-metadata rows `[origin root path\\n  1249\\t   :yang/call-site 1]` in printed-row order: one row per\\n  1250\\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\\n  1251\\t   that actually executes. The frontend's own markers named the\\n  1252\\t   pre-expansion tree; expansion, tail marking and stand-in lowering\\n  1253\\t   recompute roots and paths, so no pre-expansion table can cover this\\n  1254\\t   tree and the table is finalized here, over the finished rows.\\n  1255\\t\\n  1256\\t   Each row's origin is that occurrence's REAL origin (design §2.1,\\n  1257\\t   §2.3): `occurrence-origins` maps the final occurrence path to the\\n  1258\\t   origin of the admission or generation event that produced the\\n  1259\\t   application syntax at that path — the admitted run member's source\\n  1260\\t   origin for retained syntax (a no-op expansion keeps it valid), and\\n  1261\\t   the `[:expansion record-address]` of the recorded expansion event\\n  1262\\t   whose output introduced generated syntax. No expansion-record\\n  1263\\t   address is fabricated: only event rows the expander actually\\n  1264\\t   recorded appear. The table is therefore the explicit\\n  1265\\t   final-root correspondence §2.3 requires — every generated occurrence\\n  1266\\t   names its producing record, so an attribution consumer can reach the\\n  1267\\t   event (its input root, call path, macro root, output root) from the\\n  1268\\t   row alone.\\\"\\n  1269\\t  [row-set occurrence-origins admission-origin]\\n  1270\\t  (vec (sort-by pr-str\\n  1271\\t                (map (fn [[root path]]\\n  1272\\t                       [(get occurrence-origins path admission-origin)\\n  1273\\t                        root path :yang/call-site 1])\\n  1274\\t                     (vm/application-occurrences row-set)))))\\n  1275\\t\\n  1276\\t\\n  1277\\t(defn expand-batch\\n  1278\\t  \\\"Expand one input batch against `ctx` (§3.2). Returns\\n  1279\\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\\n  1280\\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\\n  1281\\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\\n  1282\\t   success changes the store, to the post-harvest store. A success also\\n  1283\\t   carries `:frontend-metadata` — the C1 side table finalized over the\\n  1284\\t   final tree (`final-call-site-metadata`), covering the tree that\\n  1285\\t   actually executes — when, and only when, the selected member itself\\n  1286\\t   claimed C1 coverage (its own verdict in `batch-call-site-claims`); a\\n  1287\\t   sibling's claim never manufactures a table for it, and an unclaimed\\n  1288\\t   batch carries no table at all, never an empty one. The admission\\n  1289\\t   this expansion produced the tree under rides beside it as\\n  1290\\t   `:call-site-origin` — the source origin of the admitted run member,\\n  1291\\t   the key the table is stored and resolved under beside the final\\n  1292\\t   root address. It is the table's admission key, not a blanket\\n  1293\\t   stamp: each row's origin is that occurrence's own (§2.1, §2.3) —\\n  1294\\t   the run member's source origin for admitted syntax a no-op\\n  1295\\t   expansion retained, the `[:expansion record-address]` of a recorded\\n  1296\\t   expansion event for syntax its output generated. A context\\n  1297\\t   store binding a\\n  1298\\t   reserved name, or holding an entry without the current AST contract,\\n  1299\\t   is refused (Rule R): it is a composition defect, so it throws rather\\n  1300\\t   than returning an error.\\\"\\n  1301\\t  [batch ctx]\\n  1302\\t  (check-store! (:store ctx))\\n  1303\\t  (let [ctx (with-default-guards ctx)\\n  1304\\t        source-batch (:t ctx)\\n  1305\\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\\n  1306\\t        finish (fn [st]\\n  1307\\t                 (let [ctx' (update (:ctx st) :t inc)]\\n  1308\\t                   (if-let [e (:error st)]\\n  1309\\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\\n  1310\\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\\n  1311\\t                      :frontend-metadata (:frontend-metadata st),\\n  1312\\t                      :call-site-origin (:call-site-origin st),\\n  1313\\t                      :ctx (assoc ctx' :store (:next-store st))})))\\n  1314\\t        {:keys [admitted error]} (admit batch)]\\n  1315\\t    (if error\\n  1316\\t      (let [[st counter] (allocate-attempt base)]\\n  1317\\t        (finish (-> st\\n  1318\\t                    (record-event (event-row (attempt-id ctx counter) source-batch\\n  1319\\t                                             (source-origin ctx source-batch nil)\\n  1320\\t                                             nil nil nil nil nil error))\\n  1321\\t                    (fail error))))\\n  1322\\t      (let [{:keys [trees indexes index run-index definitions]} admitted\\n  1323\\t            store0 (or (:store ctx) {})\\n  1324\\t            store (harvest store0 #(nth indexes %) definitions)\\n  1325\\t            catalogue (into []\\n  1326\\t                            (comp (filter :declared?)\\n  1327\\t                                  (map (fn [{:keys [name tree path value]}]\\n  1328\\t                                         {:name name,\\n  1329\\t                                          :macro-tree (packet-of (nth indexes tree) value),\\n  1330\\t                                          :source [tree path]})))\\n  1331\\t                            definitions)\\n  1332\\t            ;; only the run tree is expanded, so only its declarations are\\n  1333\\t            ;; replaced; every catalogue entry still resolves by index\\n  1334\\t            [index standins]\\n  1335\\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\\n  1336\\t                      (if (= run-index (first source))\\n  1337\\t                        (let [[index s] (intern-body index [standin-tag name k])]\\n  1338\\t                          [index (assoc acc (second source) s)])\\n  1339\\t                        [index acc]))\\n  1340\\t                    [index {}]\\n  1341\\t                    (map-indexed vector catalogue))\\n  1342\\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\\n  1343\\t            st (assoc base :index index :store store)]\\n  1344\\t        (if-let [e (guard-batch-rows st)]\\n  1345\\t          (finish (fail st e))\\n  1346\\t          (let [[st root'] (expand-node st root\\n  1347\\t                                        {:path [], :rel [],\\n  1348\\t                                         :frame {:parent nil, :root root,\\n  1349\\t                                                 :tree-index run-index},\\n  1350\\t                                         :shadow #{}, :depth 0,\\n  1351\\t                                         ;; every syntax of the admitted\\n  1352\\t                                         ;; run tree starts as source\\n  1353\\t                                         ;; (§2.1); expansions override\\n  1354\\t                                         ;; below their outputs\\n  1355\\t                                         :origin-of\\n  1356\\t                                         (fn [_]\\n  1357\\t                                           (source-origin\\n  1358\\t                                             ctx source-batch run-index))})]\\n  1359\\t            (if (:error st)\\n  1360\\t              (finish st)\\n  1361\\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\\n  1362\\t                    [index root'] (retail (:index st) root')\\n  1363\\t                    [index root'] (lower-standins index root')\\n  1364\\t                    tree (packet-of index root')\\n  1365\\t                    ;; the ADMISSION origin of this expansion (§2.1):\\n  1366\\t                    ;; the admitted run member's source origin — the key\\n  1367\\t                    ;; the side table is stored and resolved under beside\\n  1368\\t                    ;; the final root address. It is NOT blindly stamped\\n  1369\\t                    ;; on every row: each row's own origin is the one the\\n  1370\\t                    ;; occurrence walk recorded (source for retained\\n  1371\\t              