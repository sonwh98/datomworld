                                         (first (rest x)))]))\\\\n+                  (defn f [y] y)\\\\n+                  (repack-call (+ 1 2))])\\\\n+          {:keys [ctx result]} (expand-like-the-repl ast)\\\\n+          {:keys [status tree frontend-metadata log]} result\\\\n+          final (macro/packet->row-set tree)\\\\n+          admission [:source :program-in (:t ctx) 0]\\\\n+          event-addrs (into #{} (map first) (nth log 1))]\\\\n+      (is (= :ok status))\\\\n+      (is (contains? (set (correspondences log))\\\\n+                     {[] :constructed, [[3 0]] [:retained admission]})\\\\n+          \\\\\\\"the built call is constructed; the reassembled child keeps\\\\n+           its incoming origin\\\\\\\")\\\\n+      (is (contains? (row-origins frontend-metadata) admission))\\\\n+      (is (some (fn [o]\\\\n+                  (and (expansion-origin? o)\\\\n+                       (contains? event-addrs (second o))))\\\\n+                (row-origins frontend-metadata))\\\\n+          \\\\\\\"the built call names its recorded expansion event\\\\\\\")\\\\n+      (is (= (occurrence-pairs final) (marked-pairs frontend-metadata)))\\\\n+      (is (true? (yang/validate-call-site-coverage!\\\\n+                   final frontend-metadata admission\\\\n+                   {:declared? true :per-occurrence-origins? true})))))\\\\n+  (testing \\\\\\\"a packet entering a literal slot encodes cleanly (P1-2)\\\\\\\"\\\\n+    (let [ast (yang/compile-program\\\\n+                '[(defmacro packet-data [x] (yin/literal x))\\\\n+                  (packet-data (+ 1 2))])\\\\n+          {:keys [result]} (expand-like-the-repl ast)\\\\n+          {:keys [status tree]} result\\\\n+          payload (some (fn [row]\\\\n+                          (when (and (= :literal (nth row 1))\\\\n+                                     (vector? (nth row 2)))\\\\n+                            (nth row 2)))\\\\n+                        (second tree))]\\\\n+      (is (= :ok status)\\\\n+          \\\\\\\"private tracking metadata never reaches the encoder\\\\\\\")\\\\n+      (is (some? payload) \\\\\\\"the operand survives as literal data\\\\\\\")\\\\n+      (is (not (contains? (or (meta payload) {})\\\\n+                          :yin.vm.macro/origin-of))\\\\n+          \\\\\\\"only the private tracking entry is removed\\\\\\\")\\\\n+      (is (nil? (macro/valid-tree? tree))))))\\\\n+\\\\n+\\\\n (deftest publisher-scope-id-identity-test\\\\n   (testing \\\\\\\"scope ids keep their full identity: a keyword's namespace\\\\n             and a string's type are part of the id, so :a/publisher,\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/yang-clojure/1794209702000-architect-cc1-p1-confirm.gpt-6-astra.stdout.log:19:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_8\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba /tmp/cc1-p1/src/cljc/yin/vm/macro.cljc | sed -n '1,240p;570,970p;1040,1130p;1300,1475p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\t(ns yin.vm.macro\\\\n     2\\\\t  \\\\\\\"The row-native macro expander (`docs/design/yin.vm.macro.md`, Phase 1).\\\\n     3\\\\t\\\\n     4\\\\t   A process between two media: it observes `program-in` batches\\\\n     5\\\\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows\\\\n     6\\\\t   call-site-claims]` — the trailing element present only when some\\\\n     7\\\\t   member's frontend claimed call-site (C1) coverage, holding one\\\\n     8\\\\t   boolean verdict per member, so every older five-element batch is\\\\n     9\\\\t   still a valid unclaimed batch —\\\\n    10\\\\t   rewrites the selected tree to a fixpoint, and appends one canonical tree\\\\n    11\\\\t   packet `[root rows]` to `program-out`, with one event row per attempt on\\\\n    12\\\\t   an optional log medium. Evaluators know nothing of any of this (decision\\\\n    13\\\\t   1): a macro call is an ordinary `:application` row, macro-ness is an\\\\n    14\\\\t   occurrence declaration beside the tree, and definitions leave as ordinary\\\\n    15\\\\t   syntax or as a literal naming the lowered macro.\\\\n    16\\\\t\\\\n    17\\\\t   Everything here is a value threaded through the step: the macro store,\\\\n    18\\\\t   attempt counter, batch coordinate, and incarnation token live in `ctx`\\\\n    19\\\\t   (§3.1). Expansion failure is data (decision 12); a throw is a defect or a\\\\n    20\\\\t   terminal stream outcome.\\\\\\\"\\\\n    21\\\\t  (:refer-clojure :exclude [flush load])\\\\n    22\\\\t  (:require [dao.jing :as jing]\\\\n    23\\\\t            [dao.stream :as stream]\\\\n    24\\\\t            [dao.stream.observer :as observer]\\\\n    25\\\\t            [yin.vm :as vm]\\\\n    26\\\\t            [yin.vm.ast-walker :as ast-walker]\\\\n    27\\\\t            [yin.vm.engine :as engine]))\\\\n    28\\\\t\\\\n    29\\\\t\\\\n    30\\\\t;; =============================================================================\\\\n    31\\\\t;; Grammar, rows, and packets (§1)\\\\n    32\\\\t;; =============================================================================\\\\n    33\\\\t\\\\n    34\\\\t(def ^:private standin-tag :yin.macro/defined)\\\\n    35\\\\t\\\\n    36\\\\t\\\\n    37\\\\t(def ^:private working-grammar\\\\n    38\\\\t  \\\\\\\"The canonical §2.3 table plus the one working row the expander interns\\\\n    39\\\\t   and lowers itself: `[S :yin.macro/defined name k]` (§3.2 step 3). It is\\\\n    40\\\\t   admitted only in operand and result packets, never in input or output.\\\\\\\"\\\\n    41\\\\t  (assoc vm/semantic-bytecode-grammar standin-tag [[:name :sym] [:k :int]]))\\\\n    42\\\\t\\\\n    43\\\\t\\\\n    44\\\\t(defn- grammar\\\\n    45\\\\t  [working?]\\\\n    46\\\\t  (if working? working-grammar vm/semantic-bytecode-grammar))\\\\n    47\\\\t\\\\n    48\\\\t\\\\n    49\\\\t(defn- row-tag\\\\n    50\\\\t  [row]\\\\n    51\\\\t  (nth row 1))\\\\n    52\\\\t\\\\n    53\\\\t\\\\n    54\\\\t(defn- intern-row\\\\n    55\\\\t  \\\\\\\"The full row for `body`: its content address prepended (§1.1).\\\\\\\"\\\\n    56\\\\t  [body]\\\\n    57\\\\t  (into [(jing/segment-key body)] body))\\\\n    58\\\\t\\\\n    59\\\\t\\\\n    60\\\\t(defn- slot-kinds\\\\n    61\\\\t  \\\\\\\"`[[position kind] ...]` for a tag's grammar slots, positions being full-row\\\\n    62\\\\t   positions (address 0, tag 1, first slot 2).\\\\\\\"\\\\n    63\\\\t  [tag]\\\\n    64\\\\t  (map-indexed (fn [i [_ kind]] [(+ i 2) kind]) (get working-grammar tag)))\\\\n    65\\\\t\\\\n    66\\\\t\\\\n    67\\\\t(defn- child-places\\\\n    68\\\\t  \\\\\\\"`[[coordinate child-address] ...]` of one row in grammar order: a `node`\\\\n    69\\\\t   slot's coordinate is its full-row position, a `nodes` child's is\\\\n    70\\\\t   `[position i]` (§2.1).\\\\\\\"\\\\n    71\\\\t  [row]\\\\n    72\\\\t  (mapcat (fn [[pos kind]]\\\\n    73\\\\t            (case kind\\\\n    74\\\\t              :node [[pos (nth row pos)]]\\\\n    75\\\\t              :nodes (map-indexed (fn [i c] [[pos i] c]) (nth row pos))\\\\n    76\\\\t              nil))\\\\n    77\\\\t          (slot-kinds (row-tag row))))\\\\n    78\\\\t\\\\n    79\\\\t\\\\n    80\\\\t(defn- with-child\\\\n    81\\\\t  \\\\\\\"`row`'s body with the child at coordinate `coord` replaced by `address`.\\\\\\\"\\\\n    82\\\\t  [row coord address]\\\\n    83\\\\t  (let [body (subvec row 1)]\\\\n    84\\\\t    (if (vector? coord)\\\\n    85\\\\t      (let [[pos i] coord]\\\\n    86\\\\t        (assoc body (dec pos) (assoc (nth row pos) i address)))\\\\n    87\\\\t      (assoc body (dec coord) address))))\\\\n    88\\\\t\\\\n    89\\\\t\\\\n    90\\\\t(defn- reachable\\\\n    91\\\\t  \\\\\\\"Addresses reachable from `root` through `index`, first-encounter preorder\\\\n    92\\\\t   in grammar order. Assumes the index is closed and acyclic.\\\\\\\"\\\\n    93\\\\t  [index root]\\\\n    94\\\\t  (loop [stack (list root)\\\\n    95\\\\t         seen #{}\\\\n    96\\\\t         order []]\\\\n    97\\\\t    (if-let [a (first stack)]\\\\n    98\\\\t      (if (contains? seen a)\\\\n    99\\\\t        (recur (rest stack) seen order)\\\\n   100\\\\t        (recur (reduce conj (rest stack) (reverse (map second (child-places (get index a)))))\\\\n   101\\\\t               (conj seen a)\\\\n   102\\\\t               (conj order a)))\\\\n   103\\\\t      order)))\\\\n   104\\\\t\\\\n   105\\\\t\\\\n   106\\\\t(defn- packet-of\\\\n   107\\\\t  \\\\\\\"The self-contained tree packet `[root rows]` rooted at `root` (§1.2). Row\\\\n   108\\\\t   order is preorder, which is deterministic but carries no meaning.\\\\\\\"\\\\n   109\\\\t  [index root]\\\\n   110\\\\t  [root (mapv #(get index %) (reachable index root))])\\\\n   111\\\\t\\\\n   112\\\\t\\\\n   113\\\\t(defn tree-packet\\\\n   114\\\\t  \\\\\\\"Convert a projected row set `{:root id :rows {id row}}` (the shape\\\\n   115\\\\t   `yin.vm/ast->semantic-bytecode` returns) to a tree packet `[root rows]`.\\\\\\\"\\\\n   116\\\\t  [{:keys [root rows]}]\\\\n   117\\\\t  (packet-of rows root))\\\\n   118\\\\t\\\\n   119\\\\t\\\\n   120\\\\t(defn packet->row-set\\\\n   121\\\\t  \\\\\\\"Convert a canonical tree packet to `{:root id :rows {id row}}`, the shape\\\\n   122\\\\t   the evaluator loaders take.\\\\\\\"\\\\n   123\\\\t  [[root rows]]\\\\n   124\\\\t  {:root root, :rows (into {} (map (fn [r] [(first r) r])) rows)})\\\\n   125\\\\t\\\\n   126\\\\t\\\\n   127\\\\t(defn ast->packet\\\\n   128\\\\t  \\\\\\\"Project a map AST to its canonical tree packet.\\\\\\\"\\\\n   129\\\\t  [ast]\\\\n   130\\\\t  (tree-packet (vm/ast->semantic-bytecode ast)))\\\\n   131\\\\t\\\\n   132\\\\t\\\\n   133\\\\t(defn- same-value?\\\\n   134\\\\t  \\\\\\\"`=` that also compares metadata at every depth: the transitional address\\\\n   135\\\\t   encoder does not hash scalar metadata, so two bodies may share an address\\\\n   136\\\\t   while differing there, which is an address conflict (§5.3, §7.2).\\\\\\\"\\\\n   137\\\\t  [a b]\\\\n   138\\\\t  (and (= a b)\\\\n   139\\\\t       (= (meta a) (meta b))\\\\n   140\\\\t       (or (nil? (meta a)) (same-value? (meta a) (meta b)))\\\\n   141\\\\t       (cond (map? a) (every? (fn [[k v]]\\\\n   142\\\\t                                (let [[k' v'] (find b k)]\\\\n   143\\\\t                                  (and (same-value? k k') (same-value? v v'))))\\\\n   144\\\\t                              a)\\\\n   145\\\\t             (set? a) (every? (fn [e] (same-value? e (some #(when (= e %) %) b))) a)\\\\n   146\\\\t             (sequential? a) (every? true? (map same-value? a b))\\\\n   147\\\\t             :else true)))\\\\n   148\\\\t\\\\n   149\\\\t\\\\n   150\\\\t;; =============================================================================\\\\n   151\\\\t;; Packet validation (§7.1, §7.2)\\\\n   152\\\\t;; =============================================================================\\\\n   153\\\\t\\\\n   154\\\\t(defn- standin-shaped?\\\\n   155\\\\t  \\\\\\\"A vector that reads as a working stand-in row or body.\\\\\\\"\\\\n   156\\\\t  [x]\\\\n   157\\\\t  (and (vector? x)\\\\n   158\\\\t       (or (= standin-tag (first x))\\\\n   159\\\\t           (and (< 1 (count x)) (= standin-tag (nth x 1))))))\\\\n   160\\\\t\\\\n   161\\\\t\\\\n   162\\\\t(defn- marker-in?\\\\n   163\\\\t  \\\\\\\"True when a stand-in-shaped vector appears anywhere inside a value.\\\\\\\"\\\\n   164\\\\t  [x]\\\\n   165\\\\t  (or (standin-shaped? x)\\\\n   166\\\\t      (and (map? x) (some (fn [[k v]] (or (marker-in? k) (marker-in? v))) x))\\\\n   167\\\\t      (and (coll? x) (not (map? x)) (some marker-in? x))\\\\n   168\\\\t      (and (some? (meta x)) (marker-in? (meta x)))))\\\\n   169\\\\t\\\\n   170\\\\t\\\\n   171\\\\t(defn- slot-shape-ok?\\\\n   172\\\\t  \\\\\\\"Slot kind check. `data`/`key` admit any value here; plain-ness is the\\\\n   173\\\\t   separate `:host-value` rule.\\\\\\\"\\\\n   174\\\\t  [kind v]\\\\n   175\\\\t  (case kind\\\\n   176\\\\t    :node (jing/segment-address? v)\\\\n   177\\\\t    :nodes (and (vector? v) (every? jing/segment-address? v))\\\\n   178\\\\t    (:data :key) true\\\\n   179\\\\t    :sym (symbol? v)\\\\n   180\\\\t    :syms (and (vector? v) (every? symbol? v))\\\\n   181\\\\t    :kw (keyword? v)\\\\n   182\\\\t    :str (string? v)\\\\n   183\\\\t    :int (and (integer? v) (not (neg? v)))\\\\n   184\\\\t    :bool (or (true? v) (false? v))))\\\\n   185\\\\t\\\\n   186\\\\t\\\\n   187\\\\t(defn- value-slots\\\\n   188\\\\t  [row]\\\\n   189\\\\t  (keep (fn [[pos kind]] (when (contains? #{:data :key} kind) (nth row pos)))\\\\n   190\\\\t        (slot-kinds (row-tag row))))\\\\n   191\\\\t\\\\n   192\\\\t\\\\n   193\\\\t(defn- first-defect\\\\n   194\\\\t  \\\\\\\"Run `check` over `addresses` in order; the first non-nil result.\\\\\\\"\\\\n   195\\\\t  [check addresses]\\\\n   196\\\\t  (some check addresses))\\\\n   197\\\\t\\\\n   198\\\\t\\\\n   199\\\\t(defn- cycle-defect\\\\n   200\\\\t  [index addresses]\\\\n   201\\\\t  (letfn [(visit\\\\n   202\\\\t            [a on-path path done]\\\\n   203\\\\t            (cond (contains? on-path a) [{:reason :cyclic, :address a, :path path} done]\\\\n   204\\\\t                  (contains? done a) [nil done]\\\\n   205\\\\t                  :else (let [[err done']\\\\n   206\\\\t                              (reduce (fn [[_ d] [coord c]]\\\\n   207\\\\t                                        (let [[e d'] (visit c (conj on-path a)\\\\n   208\\\\t                                                            (conj path coord) d)]\\\\n   209\\\\t                                          (if e (reduced [e d']) [nil d'])))\\\\n   210\\\\t                                      [nil done]\\\\n   211\\\\t                                      (child-places (get index a)))]\\\\n   212\\\\t                          [err (conj done' a)])))]\\\\n   213\\\\t    (loop [as addresses\\\\n   214\\\\t           done #{}]\\\\n   215\\\\t      (when-let [a (first as)]\\\\n   216\\\\t        (let [[err done'] (visit a #{} [] done)]\\\\n   217\\\\t          (or err (recur (rest as) done')))))))\\\\n   218\\\\t\\\\n   219\\\\t\\\\n   220\\\\t(defn valid-tree?\\\\n   221\\\\t  \\\\\\\"Validate a tree packet `[root rows]` (§1.2, §7.1). Returns nil when the\\\\n   222\\\\t   packet is a closed, self-contained, acyclic tree of well-formed rows whose\\\\n   223\\\\t   addresses match their bodies, else the first error as\\\\n   224\\\\t   `{:kind :malformed-input :reason r :address a ...}`.\\\\n   225\\\\t\\\\n   226\\\\t   Rules run in this order, each over addresses in canonical byte order and\\\\n   227\\\\t   slots in grammar order: packet and row shape (`:packet-shape`,\\\\n   228\\\\t   `:row-shape`), `:unknown-tag`, `:row-shape` (arity and slot kinds),\\\\n   229\\\\t   `:host-value`, `:marker-in-payload`, `:address-mismatch` (after the plain\\\\n   230\\\\t   check, so no host value is ever hashed), `:address-conflict` (one address,\\\\n   231\\\\t   two metadata-distinct bodies), `:dangling-child`, `:cyclic`, and\\\\n   232\\\\t   `:unreachable-row`.\\\\n   233\\\\t\\\\n   234\\\\t   `opts`: `:working?` admits working stand-in rows (operand and result\\\\n   235\\\\t   packets); canonical input and output never do.\\\\\\\"\\\\n   236\\\\t  ([packet] (valid-tree? packet {}))\\\\n   237\\\\t  ([packet {:keys [working?]}]\\\\n   238\\\\t   (let [g (grammar working?)\\\\n   239\\\\t         err (fn [reason & kvs]\\\\n   240\\\\t               (merge {:kind :malformed-input, :reason reason}\\\\n   570\\\\t\\\\n   571\\\\t(defn- packet?\\\\n   572\\\\t  [x]\\\\n   573\\\\t  (and (vector? x) (= 2 (count x)) (jing/segment-address? (first x))\\\\n   574\\\\t       (vector? (second x))))\\\\n   575\\\\t\\\\n   576\\\\t\\\\n   577\\\\t(defn- need-packet\\\\n   578\\\\t  [who x]\\\\n   579\\\\t  (when-not (packet? x)\\\\n   580\\\\t    (throw-prelude (str who \\\\\\\" expects a tree packet\\\\\\\") {:op who}))\\\\n   581\\\\t  x)\\\\n   582\\\\t\\\\n   583\\\\t\\\\n   584\\\\t(defn- merge-packets\\\\n   585\\\\t  \\\\\\\"Union the rows of `packets` into one index, verifying that one address\\\\n   586\\\\t   denotes one body (§5.3).\\\\\\\"\\\\n   587\\\\t  [packets]\\\\n   588\\\\t  (reduce (fn [index row]\\\\n   589\\\\t            (let [prior (get index (first row))]\\\\n   590\\\\t              (cond (nil? prior) (assoc index (first row) row)\\\\n   591\\\\t                    (same-value? prior row) index\\\\n   592\\\\t                    :else (throw-prelude \\\\\\\"Packet address conflict\\\\\\\"\\\\n   593\\\\t                                         {:address (first row)}))))\\\\n   594\\\\t          {}\\\\n   595\\\\t          (mapcat second packets)))\\\\n   596\\\\t\\\\n   597\\\\t\\\\n   598\\\\t(def ^:private pending-expansion-origin\\\\n   599\\\\t  \\\\\\\"The construction origin the prelude attaches to every node the\\\\n   600\\\\t   macro's code builds during one invocation (ruling U1: identity comes\\\\n   601\\\\t   from the construction event, never from comparing content\\\\n   602\\\\t   addresses). `expand-call` substitutes the recorded expansion event's\\\\n   603\\\\t   `[:expansion record-address]` origin for it when the output's\\\\n   604\\\\t   occurrence correspondence is read — the placeholder never reaches a\\\\n   605\\\\t   table, a row, or an event it does not belong to.\\\\\\\"\\\\n   606\\\\t  [:expansion ::pending])\\\\n   607\\\\t\\\\n   608\\\\t\\\\n   609\\\\t(defn- with-origin-of\\\\n   610\\\\t  \\\\\\\"Tag packet `p` with `f`, its construction origin function: `(f rel)`\\\\n   611\\\\t   answers the origin of the occurrence at `rel`, a path relative to\\\\n   612\\\\t   `p`'s root — the pending expansion origin for a node the macro's\\\\n   613\\\\t   code constructed, or, below a child coordinate that retains a\\\\n   614\\\\t   passed-through packet, that packet's own origin function. The\\\\n   615\\\\t   function rides the packet's metadata, so it is content-addressing\\\\n   616\\\\t   invisible and never leaks into a final tree.\\\\\\\"\\\\n   617\\\\t  [p f]\\\\n   618\\\\t  (vary-meta p assoc ::origin-of f))\\\\n   619\\\\t\\\\n   620\\\\t\\\\n   621\\\\t(defn- origin-of-fn\\\\n   622\\\\t  \\\\\\\"The construction origin function packet `p` carries, or nil.\\\\\\\"\\\\n   623\\\\t  [p]\\\\n   624\\\\t  (::origin-of (meta p)))\\\\n   625\\\\t\\\\n   626\\\\t\\\\n   627\\\\t(def ^:private tracking-meta-keys\\\\n   628\\\\t  \\\\\\\"The private provenance entries the expander rides on packet values.\\\\n   629\\\\t   They are host functions, so they must never enter a hashed or\\\\n   630\\\\t   validated data slot (P1-2); every other metadata entry is the\\\\n   631\\\\t   caller's legitimate data and is preserved.\\\\\\\"\\\\n   632\\\\t  #{::origin-of})\\\\n   633\\\\t\\\\n   634\\\\t\\\\n   635\\\\t(defn- strip-tracking\\\\n   636\\\\t  \\\\\\\"Remove only the private tracking entries, recursively, from `x`:\\\\n   637\\\\t   every collection element, map key and value, and every metadata map\\\\n   638\\\\t   (including metadata on metadata) is visited, so a packet nested at\\\\n   639\\\\t   any depth inside a literal payload loses its host-function origin\\\\n   640\\\\t   while legitimate user metadata survives untouched.\\\\\\\"\\\\n   641\\\\t  [x]\\\\n   642\\\\t  (let [x' (cond (record? x) x\\\\n   643\\\\t                 (map? x) (into (empty x)\\\\n   644\\\\t                                (map (fn [[k v]]\\\\n   645\\\\t                                       [(strip-tracking k)\\\\n   646\\\\t                                        (strip-tracking v)]))\\\\n   647\\\\t                                x)\\\\n   648\\\\t                 (set? x) (into (empty x) (map strip-tracking) x)\\\\n   649\\\\t                 (vector? x) (mapv strip-tracking x)\\\\n   650\\\\t                 (sequential? x) (with-meta\\\\n   651\\\\t                                   (apply list (map strip-tracking x))\\\\n   652\\\\t                                   nil)\\\\n   653\\\\t                 :else x)\\\\n   654\\\\t        m (meta x)]\\\\n   655\\\\t    (if m\\\\n   656\\\\t      (let [m' (strip-tracking\\\\n   657\\\\t                 (apply dissoc m tracking-meta-keys))]\\\\n   658\\\\t        (with-meta x' (when-not (and (empty? m') (nil? (meta m'))) m')))\\\\n   659\\\\t      x')))\\\\n   660\\\\t\\\\n   661\\\\t\\\\n   662\\\\t(defn- packet-has-application?\\\\n   663\\\\t  \\\\\\\"True when packet `p` contains an `:application` occurrence, the only\\\\n   664\\\\t   occurrences whose provenance a correspondence ever reads.\\\\\\\"\\\\n   665\\\\t  [p]\\\\n   666\\\\t  (boolean (and (packet? p)\\\\n   667\\\\t                (some #(= :application (row-tag %)) (second p)))))\\\\n   668\\\\t\\\\n   669\\\\t\\\\n   670\\\\t(defn- register-lineage!\\\\n   671\\\\t  \\\\\\\"Record packet `p` in the invocation `lineage` (an atom of entries)\\\\n   672\\\\t   under the identity of its rows vector. Host decomposition\\\\n   673\\\\t   (`first`/`rest`/`get`) hands that very object to reassembly, so the\\\\n   674\\\\t   entry is how a rebuilt packet proves it is this packet retained,\\\\n   675\\\\t   never a content twin built anew. Returns `p`.\\\\\\\"\\\\n   676\\\\t  [lineage p]\\\\n   677\\\\t  (when (and lineage (packet? p) (origin-of-fn p))\\\\n   678\\\\t    (when-not (some #(identical? (second p) (:rows %)) @lineage)\\\\n   679\\\\t      (swap! lineage conj {:root (first p), :rows (second p),\\\\n   680\\\\t                           :fn (origin-of-fn p)})))\\\\n   681\\\\t  p)\\\\n   682\\\\t\\\\n   683\\\\t\\\\n   684\\\\t(defn- lineage-origin-for\\\\n   685\\\\t  \\\\\\\"The retained origin function for candidate packet `c` when its rows\\\\n   686\\\\t   are the very row objects a registered packet carried: the root must\\\\n   687\\\\t   match and every row must be `identical?` to the registered packet's\\\\n   688\\\\t   row in order. Content equality alone never suffices — a freshly\\\\n   689\\\\t   built twin holds equal but distinct row objects and recovers\\\\n   690\\\\t   nothing here (ruling U1).\\\\\\\"\\\\n   691\\\\t  [lineage c]\\\\n   692\\\\t  (when (and lineage (packet? c) (nil? (origin-of-fn c)))\\\\n   693\\\\t    (some (fn [{:keys [root rows fn]}]\\\\n   694\\\\t            (when (and (= root (first c))\\\\n   695\\\\t                       (or (identical? rows (second c))\\\\n   696\\\\t                           (and (= (count rows) (count (second c)))\\\\n   697\\\\t                                (every? true?\\\\n   698\\\\t                                        (map identical? rows\\\\n   699\\\\t                                             (second c))))))\\\\n   700\\\\t              fn))\\\\n   701\\\\t          @lineage)))\\\\n   702\\\\t\\\\n   703\\\\t\\\\n   704\\\\t(def ^:private missing-provenance-origin\\\\n   705\\\\t  \\\\\\\"The origin an unaccounted child answers below its coordinate: no\\\\n   706\\\\t   sanctioned operation threaded provenance to it, so nothing may\\\\n   707\\\\t   relabel its occurrences as this expansion's construction (P1-1).\\\\n   708\\\\t   `output-correspondence` carries the marker through and\\\\n   709\\\\t   `expand-call` refuses the output as `:missing-provenance`; the\\\\n   710\\\\t   marker never reaches a table, a row, or an event.\\\\\\\"\\\\n   711\\\\t  [:expansion ::missing])\\\\n   712\\\\t\\\\n   713\\\\t\\\\n   714\\\\t(defn- constructed-origin-fn\\\\n   715\\\\t  \\\\\\\"The origin function of a packet the prelude constructed: its root\\\\n   716\\\\t   occurrence carries the pending expansion origin; a relative path\\\\n   717\\\\t   below a child coordinate delegates to the packet passed for that\\\\n   718\\\\t   child — a spliced operand retains its own incoming origin, however\\\\n   719\\\\t   the macro's code embedded it. `recover` answers a child packet's\\\\n   720\\\\t   retained origin function when the packet itself carries none (it\\\\n   721\\\\t   was rebuilt by decomposition/reassembly); a child neither source\\\\n   722\\\\t   accounts for answers `missing-provenance-origin` below its\\\\n   723\\\\t   coordinate, which the expander refuses rather than reads as\\\\n   724\\\\t   construction.\\\\\\\"\\\\n   725\\\\t  ([coord-children] (constructed-origin-fn coord-children (fn [_] nil)))\\\\n   726\\\\t  ([coord-children recover]\\\\n   727\\\\t   (fn [rel]\\\\n   728\\\\t     (if (empty? rel)\\\\n   729\\\\t       pending-expansion-origin\\\\n   730\\\\t       (if-some [child (get coord-children (first rel))]\\\\n   731\\\\t         (if-some [f (or (origin-of-fn child) (recover child))]\\\\n   732\\\\t           (f (subvec rel 1))\\\\n   733\\\\t           missing-provenance-origin)\\\\n   734\\\\t         pending-expansion-origin)))))\\\\n   735\\\\t\\\\n   736\\\\t\\\\n   737\\\\t(defn- construct\\\\n   738\\\\t  \\\\\\\"Intern `body` over the rows of its child `packets`; a closed packet.\\\\n   739\\\\t   Every node interned here is CONSTRUCTED by the expansion's code\\\\n   740\\\\t   (ruling U1), so the result packet carries the construction origin\\\\n   741\\\\t   function and the output's per-occurrence origins are read from this\\\\n   742\\\\t   construction history — never inferred by comparing content\\\\n   743\\\\t   addresses: a constructed node whose content equals a retained\\\\n   744\\\\t   node's stays distinct, because its origin answers through this\\\\n   745\\\\t   function and not through its address.\\\\n   746\\\\t\\\\n   747\\\\t   Values entering `:data`/`:key` slots are stripped of private\\\\n   748\\\\t   tracking metadata first (P1-2), before hashing and validation.\\\\n   749\\\\t   Missing child provenance never proves construction (P1-1): the\\\\n   750\\\\t   result's origin function answers the missing marker below an\\\\n   751\\\\t   unaccounted child and the expander refuses such an output.\\\\\\\"\\\\n   752\\\\t  ([body packets] (construct body packets nil))\\\\n   753\\\\t  ([body packets lineage]\\\\n   754\\\\t   (let [recover (fn [child] (lineage-origin-for lineage child))]\\\\n   755\\\\t     (let [tag (first body)\\\\n   756\\\\t           slots (get working-grammar tag)\\\\n   757\\\\t           body (if (and slots (= (count slots) (count (rest body))))\\\\n   758\\\\t                  (into [tag]\\\\n   759\\\\t                        (map (fn [[_ kind] v]\\\\n   760\\\\t                               (if (contains? #{:data :key} kind)\\\\n   761\\\\t                                 (strip-tracking v)\\\\n   762\\\\t                                 v))\\\\n   763\\\\t                             slots\\\\n   764\\\\t                             (rest body)))\\\\n   765\\\\t                  body)\\\\n   766\\\\t           index (merge-packets packets)\\\\n   767\\\\t           [index a] (intern-body index body)\\\\n   768\\\\t           coord-children (into {}\\\\n   769\\\\t                                (map (fn [[place p]] [(first place) p]))\\\\n   770\\\\t                                (map vector (child-places (get index a)) packets))]\\\\n   771\\\\t       (with-origin-of (packet-of index a)\\\\n   772\\\\t         (constructed-origin-fn coord-children recover))))))\\\\n   773\\\\t\\\\n   774\\\\t\\\\n   775\\\\t(defn- root-row\\\\n   776\\\\t  [[root rows]]\\\\n   777\\\\t  (some #(when (= root (first %)) %) rows))\\\\n   778\\\\t\\\\n   779\\\\t\\\\n   780\\\\t(defn- literal-packet\\\\n   781\\\\t  ([v] (literal-packet v nil))\\\\n   782\\\\t  ([v lineage] (construct [:literal (strip-tracking v)] [] lineage)))\\\\n   783\\\\t\\\\n   784\\\\t\\\\n   785\\\\t(defn- application-packet\\\\n   786\\\\t  ([operator operands] (application-packet operator operands nil))\\\\n   787\\\\t  ([operator operands lineage]\\\\n   788\\\\t   (construct [:application (first operator) (mapv first operands) false]\\\\n   789\\\\t              (cons operator operands)\\\\n   790\\\\t              lineage)))\\\\n   791\\\\t\\\\n   792\\\\t\\\\n   793\\\\t(defn- lambda-packet\\\\n   794\\\\t  ([params body] (lambda-packet params body nil))\\\\n   795\\\\t  ([params body lineage]\\\\n   796\\\\t   (when-not (and (sequential? params) (every? symbol? params))\\\\n   797\\\\t     (throw-prelude \\\\\\\"yin/lambda params must be symbols\\\\\\\" {:op 'yin/lambda}))\\\\n   798\\\\t   (construct [:lambda (vec params) (first body)] [body] lineage)))\\\\n   799\\\\t\\\\n   800\\\\t\\\\n   801\\\\t(defn- name-of\\\\n   802\\\\t  [tree]\\\\n   803\\\\t  (let [row (root-row (need-packet 'yin/name-of tree))\\\\n   804\\\\t        v (nth row 2 nil)]\\\\n   805\\\\t    (cond (= :variable (row-tag row)) v\\\\n   806\\\\t          (and (= :literal (row-tag row)) (symbol? v)) v\\\\n   807\\\\t          (and (= :literal (row-tag row)) (string? v)) (symbol v)\\\\n   808\\\\t          :else (throw-prelude \\\\\\\"yin/name-of reads a variable, literal symbol, or literal string\\\\\\\"\\\\n   809\\\\t                               {:op 'yin/name-of}))))\\\\n   810\\\\t\\\\n   811\\\\t\\\\n   812\\\\t(defn- sequence-body\\\\n   813\\\\t  \\\\\\\"The reference `do` lowering: `(do a b c)` is `((fn [_] ((fn [_] c) b)) a)`;\\\\n   814\\\\t   one form is itself and none is the literal nil.\\\\\\\"\\\\n   815\\\\t  ([trees] (sequence-body trees nil))\\\\n   816\\\\t  ([trees lineage]\\\\n   817\\\\t   (let [trees (vec trees)]\\\\n   818\\\\t     (doseq [t trees] (need-packet 'yin/sequence-body t))\\\\n   819\\\\t     (case (count trees)\\\\n   820\\\\t       0 (literal-packet nil lineage)\\\\n   821\\\\t       1 (first trees)\\\\n   822\\\\t       (application-packet\\\\n   823\\\\t         (lambda-packet ['_]\\\\n   824\\\\t                        (sequence-body (subvec trees 1) lineage)\\\\n   825\\\\t                        lineage)\\\\n   826\\\\t         [(first trees)]\\\\n   827\\\\t         lineage)))))\\\\n   828\\\\t\\\\n   829\\\\t\\\\n   830\\\\t(defn- slot-of\\\\n   831\\\\t  ([tree n] (slot-of tree n nil))\\\\n   832\\\\t  ([tree n lineage]\\\\n   833\\\\t   (let [row (root-row (need-packet 'yin/slot tree))\\\\n   834\\\\t        kinds (into {} (slot-kinds (row-tag row)))\\\\n   835\\\\t        index (packet-index tree)\\\\n   836\\\\t        ;; an extracted slot is input syntax READ, not built: the\\\\n   837\\\\t        ;; extracted packet retains the source packet's construction\\\\n   838\\\\t        ;; origin function, descending through the slot's coordinate.\\\\n   839\\\\t        ;; A source no operation accounted for answers the missing\\\\n   840\\\\t        ;; marker, never fabricated construction (P1-1).\\\\n   841\\\\t        ofn (or (origin-of-fn tree)\\\\n   842\\\\t                (lineage-origin-for lineage tree)\\\\n   843\\\\t                (fn [_] missing-provenance-origin))]\\\\n   844\\\\t    (when-not (and (integer? n) (contains? kinds n))\\\\n   845\\\\t      (throw-prelude \\\\\\\"yin/slot position names no grammar slot\\\\\\\"\\\\n   846\\\\t                     {:op 'yin/slot, :position n}))\\\\n   847\\\\t    (case (get kinds n)\\\\n   848\\\\t      :node (with-origin-of (packet-of index (nth row n))\\\\n   849\\\\t              (fn [rel] (ofn (into [n] rel))))\\\\n   850\\\\t      :nodes (map-indexed (fn [i c]\\\\n   851\\\\t                            (with-origin-of (packet-of index c)\\\\n   852\\\\t                              (fn [rel] (ofn (into [[n i]] rel)))))\\\\n   853\\\\t                          (nth row n))\\\\n   854\\\\t      (nth row n)))))\\\\n   855\\\\t\\\\n   856\\\\t\\\\n   857\\\\t(defn prelude\\\\n   858\\\\t  \\\\\\\"The closed body environment (§5.3): the pure standard primitives (no\\\\n   859\\\\t   `require`, no stream or FFI constructor) and the row-native constructors,\\\\n   860\\\\t   each consuming and returning self-contained tree packets. `gensym` is the\\\\n   861\\\\t   invocation-local `yin/gensym-sym`.\\\\n   862\\\\t\\\\n   863\\\\t   The collection primitives are provenance-aware within one invocation\\\\n   864\\\\t   (P1-1): decomposing a packet (`first`/`rest`/`get`) registers its\\\\n   865\\\\t   lineage, and reassembling one (`conj`/`assoc`/`vec`) reattaches the\\\\n   866\\\\t   retained origin function when the rebuilt packet holds the very row\\\\n   867\\\\t   objects it was decomposed from. A packet rebuilt any other way\\\\n   868\\\\t   carries no provenance and is refused downstream rather than\\\\n   869\\\\t   relabelled as construction.\\\\\\\"\\\\n   870\\\\t  ([gensym] (prelude gensym (atom [])))\\\\n   871\\\\t  ([gensym lineage]\\\\n   872\\\\t   (let [recover-packet (fn [result]\\\\n   873\\\\t                          (cond (not (packet? result)) result\\\\n   874\\\\t                                (origin-of-fn result)\\\\n   875\\\\t                                (register-lineage! lineage result)\\\\n   876\\\\t                                :else (if-some [f (lineage-origin-for\\\\n   877\\\\t                                                    lineage result)]\\\\n   878\\\\t                                        (with-origin-of result f)\\\\n   879\\\\t                                        result)))\\\\n   880\\\\t         wrap (fn [sym f]\\\\n   881\\\\t                (let [entry (get vm/primitives sym)]\\\\n   882\\\\t                  (if (and (map? entry)\\\\n   883\\\\t                           (contains? entry :yin.k/function))\\\\n   884\\\\t                    (assoc entry :yin.k/function f)\\\\n   885\\\\t                    f)))\\\\n   886\\\\t         p-first (fn [coll]\\\\n   887\\\\t                   (register-lineage! lineage coll)\\\\n   888\\\\t                   (recover-packet (first coll)))\\\\n   889\\\\t         p-rest (fn [coll]\\\\n   890\\\\t                  (register-lineage! lineage coll)\\\\n   891\\\\t                  (vec (rest coll)))\\\\n   892\\\\t         p-conj (fn [coll & xs]\\\\n   893\\\\t                  (register-lineage! lineage coll)\\\\n   894\\\\t                  (doseq [x xs] (register-lineage! lineage x))\\\\n   895\\\\t                  (recover-packet (apply conj coll xs)))\\\\n   896\\\\t         p-assoc (fn [m & kvs]\\\\n   897\\\\t                   (register-lineage! lineage m)\\\\n   898\\\\t                   (recover-packet (apply assoc m kvs)))\\\\n   899\\\\t         p-get (fn\\\\n   900\\\\t                 ([m k]\\\\n   901\\\\t                  (register-lineage! lineage m)\\\\n   902\\\\t                  (recover-packet (get m k)))\\\\n   903\\\\t                 ([m k not-found]\\\\n   904\\\\t                  (register-lineage! lineage m)\\\\n   905\\\\t                  (recover-packet (get m k not-found))))\\\\n   906\\\\t         p-vec (fn [coll]\\\\n   907\\\\t                 (recover-packet (vec coll)))]\\\\n   908\\\\t     (merge\\\\n   909\\\\t       (dissoc vm/primitives 'require 'try-require 'bytes->str)\\\\n   910\\\\t       {'first (wrap 'first p-first),\\\\n   911\\\\t        'rest (wrap 'rest p-rest),\\\\n   912\\\\t        'conj (wrap 'conj p-conj),\\\\n   913\\\\t        'assoc (wrap 'assoc p-assoc),\\\\n   914\\\\t        'get (wrap 'get p-get),\\\\n   915\\\\t        'vec (wrap 'vec p-vec),\\\\n   916\\\\t        'yin/tag (fn [tree] (row-tag (root-row (need-packet 'yin/tag tree)))),\\\\n   917\\\\t        'yin/slot (fn [tree n] (slot-of tree n lineage)),\\\\n   918\\\\t        'yin/literal (fn [v] (literal-packet v lineage)),\\\\n   919\\\\t        'yin/variable (fn [sym]\\\\n   920\\\\t                        (when-not (symbol? sym)\\\\n   921\\\\t                          (throw-prelude \\\\\\\"yin/variable expects a symbol\\\\\\\" {:op 'yin/variable}))\\\\n   922\\\\t                        (construct [:variable sym] [] lineage)),\\\\n   923\\\\t        'yin/lambda (fn [params body]\\\\n   924\\\\t                      (lambda-packet params (need-packet 'yin/lambda body)\\\\n   925\\\\t                                     lineage)),\\\\n   926\\\\t        'yin/application (fn [operator operands]\\\\n   927\\\\t                           (need-packet 'yin/application operator)\\\\n   928\\\\t                           (doseq [o operands] (need-packet 'yin/application o))\\\\n   929\\\\t                           (application-packet operator (vec operands)\\\\n   930\\\\t                                               lineage)),\\\\n   931\\\\t        'yin/if (fn [t c a]\\\\n   932\\\\t                  (doseq [x [t c a]] (need-packet 'yin/if x))\\\\n   933\\\\t                  (construct [:if (first t) (first c) (first a)] [t c a]\\\\n   934\\\\t                             lineage)),\\\\n   935\\\\t        'yin/sequence-body (fn [trees] (sequence-body trees lineage)),\\\\n   936\\\\t        'yin/make-lambda (fn [params-tree body]\\\\n   937\\\\t                           (let [row (root-row (need-packet 'yin/make-lambda params-tree))]\\\\n   938\\\\t                             (when-not (and (= :literal (row-tag row))\\\\n   939\\\\t                                            (vector? (nth row 2))\\\\n   940\\\\t                                            (every? symbol? (nth row 2)))\\\\n   941\\\\t                               (throw-prelude \\\\\\\"yin/make-lambda reads a literal parameter vector\\\\\\\"\\\\n   942\\\\t                                              {:op 'yin/make-lambda}))\\\\n   943\\\\t                             (lambda-packet (nth row 2)\\\\n   944\\\\t                                            (need-packet 'yin/make-lambda body)\\\\n   945\\\\t                                            lineage))),\\\\n   946\\\\t        'yin/make-def (fn [name-tree value-tree]\\\\n   947\\\\t                        (application-packet\\\\n   948\\\\t                          (construct [:variable 'yin/def] [] lineage)\\\\n   949\\\\t                          [(literal-packet (name-of name-tree) lineage)\\\\n   950\\\\t                           (need-packet