fixture)]\n2730:                        :paths [[:a] [:b] [:c-walker] [:c-semantic]]}))))\n2739:               :c-walker {:executed-calls calls} :c-semantic {:executed-calls calls}}\n2742:               :c-walker {:executed-calls calls} :c-semantic {:executed-calls calls}}]\n2751:                              (assoc-in [:c-walker :executed-calls] '[[gate-syntax-subst 2 1] [gate-syntax-subst 3 2]])\n2752:                              (assoc-in [:c-semantic :executed-calls] '[[gate-syntax-subst 2 1] [gate-syntax-subst 3 2]])) rows)]\n2761:    (doseq [lane [:c-walker :c-semantic]]\n2862:        compiled (kernel-attempt #(kernel-compile fixture))\n2896:                 :a-c-walker (and (= :completed (:status a) (:status walker))\n2898:                 :a-c-semantic (and (= :completed (:status a) (:status semantic))\n2902:     :a a :b b :c-walker walker :c-semantic semantic\n2922:    (doseq [lane [:c-walker :c-semantic]]\n3047:      (doseq [lane [:c-walker :c-semantic]]\n3097:      (let [one-lane (assoc-in f2 [:c-semantic :executed-calls] [])]\n3130:                                               [:c-walker :c-semantic]))\n3163:            stale (kernel-stale-sites stale-table {:c-walker (:c-walker f2)\n3164:                                                   :c-semantic (:c-semantic f2)})]\n3231:                        :transport :explicit-guest-stream :lanes [:c-walker :c-semantic]\n3252:                                                  {:c-walker (:c-walker row)\n3253:                                                   :c-semantic (:c-semantic row)})]\n3364:                                         (:a row) (:b row) (:c-walker row) (:c-semantic row))))\n3366:                                         (:a row) (:b row) (:c-walker row) (:c-semantic row))))\n3368:                                         (assoc-in (:c-walker row) [:outcome 1 :yin.k/data] {:changed true})\n3369:                                         (:c-semantic row)))))\n3378:                        :blocked-by (get-in row [:c-walker :blocked-by])\n3380:                        :c-walker (get-in row [:c-walker :status])\n3381:                        :c-semantic (get-in row [:c-semantic :status])})))\n3406:                           (contains? row :c-walker) (contains? row :c-semantic)))\n   260\t### 5.2 Cross-host equality without collapsing admissions\n   261\t\n   262\tBuild a portable replay fixture containing the SAME source or source-derived CST, grammar/options, compiler/profile revision, canonical naming inputs, source-medium/batch/member coordinates, and expansion environment/attempt inputs. The source origin contract explicitly makes these coordinates supplied plain data (`code-as-tuples.md:405-437`; `vm.cljc:938-958`).\n   263\t\n   264\tRequire:\n   265\t\n   266\t- Identical final canonical roots and the full set of `[origin root path]` keys on JVM, Node and Dart; include Jolt in the same comparison for the mandatory portable paths.\n   267\t- Identical C1 rows, reconstructed site declarations, and per-format instruction provenance. Different formats have different PCs, but they must resolve to the same intended application K.\n   268\t- For expansion fixtures, identical expansion-record addresses under replayed identities and identical producing-record chains. Normalize neither origin nor generated names away after the fact.\n   269\t- For TS/PHP packet routes, compare compilation of the same source-derived validated CST; record the JVM parser artifact. This proves compilation equality, not nonexistent local-parser parity. Python additionally compares source parsing/export across its real local parsers, following the existing exporter conformance model (`test/yang/antlr/conformance.cljc:1-20`).\n   270\t- A separate negative fixture admits identical text twice with distinct supplied admission tokens and demands different origins. Cross-host equality is replay equality; it must not turn occurrences into content identities.\n   271\t\n   272\tHost-specific source/reader conditionals that intentionally yield different programs must have separately declared cohorts and expected refusals. They cannot explain divergence for the identical portable input cohort. Include floats, metadata, generated temporaries and duplicate trees in the portable cohort because root equality is part of the gate, not just path equality.\n   273\t\n   274\t### 5.3 Frontend-specific work packages\n   275\t\n   276\t**Clojure.** Inventory native/argument-vector/outcome compile options, `compile` vs `compile-program`, `compile-form` callers, macro expansion, `lower-unit`, `library-for`, direct walker/datoms/rows lanes, REPL single/multi-form and linked runtime publication. Show a non-oracle production fixture traversing the full pipeline, including macro-generated and helper calls. Republish `clj` and `yang.call` on each host. Oracle-specific stamping is instantiation #1 only; it does not close this brief. Anchors: `yang/clojure.cljc:2021-2034,2164-2200,2791,2839-2862,2993-3021`.\n   277\t\n   278\t**TypeScript.** Cover `lower-module-body`, `lower-unit`, `lower-units`, `lower-packet`, streaming stage, bundled and linked `js`, `yang.call`, and safepoint runtime. Track new publication/SCC/session paths from the seats when they land; do not infer their implementation from design prose. Generated member/constructor/runtime dispatch applications get their own K; source-call attribution is a separate query. Anchors: `lower.cljc:1167-1211,2262-2363`; `prelude.cljc:4168-4260`.\n   279\t\n   280\t**PHP.** Cover ANTLR and still-registered legacy compiler, include/classmap/import publication, SCC bundles/aliases, strict-types variants, prelude definition lists and P9 additions. Test by-reference/indirect calls, generators and exceptional helper paths without borrowing source-call credit. Republish `php`, dependencies and all include/import fixtures. Anchors: `php.cljc:640-685`; ANTLR `lower.cljc:1710,1812,2082,2207,3737-4041`; `publication.cljc:27-70`; `prelude_module.cljc:386`; `prelude_p9.cljc:558`.\n   281\t\n   282\t**Python.** Cover packet and module lowering, import units, SCC aliases, bundled/linked `py`, `yang.call`, `pysp`, hook staging/site-set discovery, and both fresh/primed REPL sessions. Do not conflate `:yang/site` hook sites with complete application occurrence coverage. Republish the DHT fixture and validate parserless imports on other hosts. Anchors: `lower.cljc:1111-1120,1775,2018-2373`; `repl.cljc:86-108`; `publication.cljc:51-80`; `siteset.cljc:5-31`.\n   283\t\n   284\tEach brief's acceptance bundle contains: exact producer/artifact checklist; input/commit/profile pins; C1 coverage counts and root/hash invariance; four-host results and cross-host equality report; correctness battery results; before/after budgets and measurements; legacy-load/missing-provenance refusal; and D1 verification result if it relies on correspondence. No frontend can satisfy this bundle merely by running the oracle test.\n   285\t\n   286\t## 6. Measurement and declared budgets\n   287\t\n   288\tThese are measurement requirements and design cost models, **not measured performance claims**. Signed A3 requires a budget impact per frontend, and line 29 requires static/runtime separation. This read-only design has no authority to invent benchmark results. Numeric per-corpus totals remain **unknown — the implementation round's inventory decides by measuring the pinned baseline before tagged runs**.\n   289\t\n   290\t### 6.1 Counts and cost model\n   291\t\n   292\tFor each fixture/prelude/module, host, and format record:\n   293\t\n   294\t- `U`: distinct canonical rows; `O`: all occurrence-tree positions; `A`: `:application` occurrences; `D`: maximum path depth; `L`: total encoded length of application paths; separate user, helper, wrapper, prelude, macro-generated and Rule-R counts as derived diagnostic groups.\n   295\t- `P_f`: instruction count/provenance-row count for format f; report shared semantic/native mapping structures separately if used.\n   296\t- `S_static`: exact encoded bytes of C1 rows, provenance tables, retained origin records, D1 and its reconstruction inputs; distinguish fresh bytes from already retained shared content, index memory and storage/dedup savings.\n   297\t- `E`: actual callee-entry records, per-lane total bytes and maximum record size; `Q_peak`: peak retained trace records and bytes, dropped/blocked writes and drain schedule.\n   298\t- Guest instruction counts and host-side work counters; wall compile/expand/project/publish/verify/load/query time; process/heap peak and retained memory, including trace buffers, indexes and pending continuations.\n   299\t\n   300\tOccurrence counts can greatly exceed unique row counts because identical subtrees are shared; an `O(U)` annotation-size promise would be false (code-as-tuples `:393-404,636-665,947-949`). A direct marker representation costs one row per A plus encoded paths/origins: storage proportional to `A + L + coordinate bytes`; traversal work proportional to visited occurrences, not unique content. Instruction mapping adds up to `P_f` rows per claimed format with path/coordinate payload. The exact peak depends on streaming vs retaining both trees/tables and must be measured.\n   301\t\n   302\t### 6.2 Experiment separation\n   303\t\n   304\tUse the same pinned code-producing inputs and three configurations:\n   305\t\n   306\t1. **B — baseline:** existing code, trace disabled.\n   307\t2. **S — static annotation:** C1/provenance production, persistence, loading and query enabled; runtime trace disabled.\n   308\t3. **T — tagged tracing:** same S outputs plus caller propagation and body-entry recording.\n   309\t\n   310\tAlso compare the oracle's existing two-field tracing with T to isolate the extra caller-site field from the original body-entry instrumentation. Report S−B and T−S separately, and the old-trace→tagged-trace delta. If instrumentation itself changes code, keep its canonical image and compile cost separate from side-only annotation. Static C1 must change **zero canonical code bytes/addresses and zero guest instructions** for otherwise identical input; runtime tracing has no such zero-cost claim.\n   311\t\n   312\tMeasure cold and warm compile/load/query separately; use fresh publication caches for cold tests, fixed workload/repetition count and host/version, and publish distribution plus raw samples rather than an unqualified single timing. Report query indexes/build time separately from query execution. Do not call a host trace hook “zero overhead” because guest instruction count did not increase.\n   313\t\n   352\t| Indirect application | Multiple runtime callees from one site and one callee from multiple sites. Static site exists independently of callee resolution. Unlinked indirect evidence refuses by default; resolve linkage without requiring a literal callee name. |\n   353\t| Tail calls and recursion | Direct/mutual tail calls, non-tail recursion, generated trampolines/adapters and hot/cold dispatch. Frame reuse must not retain the previous caller's K; repeated K is allowed, stack growth need not be introduced. |\n   354\t| Suspension/resumption | Park during operator evaluation, operand evaluation, before body entry, and inside the callee; ready-queue interleaving of two callers; resume/continuation re-entry. No global last-call variable; capture/restore caller context with the correct continuation. Resuming a body is not automatically a new body-entry event. |\n   355\t| Serialized continuation / migration | Strip ephemeral map-node stamps at canonical/continuation projection as §2.6 requires. If a consuming trace mode promises post-resume attribution, verify the separately carried durable context and its source artifact on restore. Missing context refuses attribution; do not claim migration support by retaining forbidden runtime keys. |\n   356\t| Reconstructed/shared/linked code | Load identical code under two origins; reconstruct shared row nodes; load from published preludes and another host's artifacts. Caller K is selected using the invocation's origin, never a node-id or bare segment/PC cache. |\n   357\t| Transform/staging | Safepoint insertion, module/SCC wrapping, imported code, alias projection and name canonicalization cannot leave stale roots/paths. Prove correspondence or refuse; annotate new helpers independently. |\n   358\t| Oracle disjointness | Explicit `/2` with empty value does not credit `/1`; unexecuted ambient beside executed explicit cannot borrow; wrong adapter canonical-source-hash and missing C lane refuse; declared ambient with non-ambient compiled argument fails; indirect unlinkage refuses; variable/derived context shape defaults to refusal or `/2` only. |\n   359\t| Stale table and schema | A declared id never observed in a trace produces the recorded diagnostic; unsupported versions, fabricated expansions, extra/conflicting/incomplete marker rows, missing retained inputs and wrong profiles produce distinct failures. Do not silently treat malformed evidence as an honest unexecuted site. |\n   360\t| Canonical invariance / old artifacts | Adding/removing static C1 metadata leaves canonical rows, roots, instruction vectors and executable outcomes unchanged. Supported unannotated artifacts still load; C1-dependent credit refuses as missing. |\n   361\t| Trace completeness | Buffer exhaustion, loss, interrupted run, missing trace lane or partial drains never become positive attribution. Trace-writing infrastructure must not recursively instrument its own bookkeeping into an unbounded trace. |\n   362\t\n   363\tThe relevant runtime paths are real, not hypothetical surface names: walker `apply-function` and operand frames (`ast_walker.cljc:273-332`), park/resume and ready queue (`:214-231,467-473,625-711`), semantic restoration (`semantic.cljc:102-130`), and native `:call/:ffi-call/:resume` lowering (`semantic/derive.cljc:92-102`). Frontend-specific suspension fixtures must use supported operations; unsupported language constructs remain explicit refusals. Continuation replay can produce repeated execution events, so the three-field trace is deliberately insufficient for invocation causality; D1 must not claim more than the oracle's existence-based attribution.\n   364\t\n   365\t## 8. Acceptance sequence and owner risks\n   366\t\n   367\tThe design deliverable selects C1 and D1, enumerates the known integration surfaces, and gives each frontend a bounded adoption brief. Implementation remains outside this round.\n   368\t\n   369\tAcceptance sequence:\n   370\t\n   371\t1. Oracle owns and records its versioned evidence format, origin spelling and exact source-hash/argument-shape derivation. Resolve §1.1's absent schema pin; import it verbatim into the D1 implementation.\n   372\t2. After the cell-ref sweeps/J2 land, refresh the exact producer, validator, artifact and host inventory; identify every changed contract, every read-only dependency, and any required format revision. Resolve final expansion-root ownership and native provenance completeness.\n   373\t3. Implement common occurrence/side-table production, preservation, verification and publication; retain old artifact loading. Declare numeric run bounds from the pinned baseline before tagged runs.\n   374\t4. Implement and independently reconstruct D1, including the oracle's actual tables and source/adaptation linkage. Publish verification evidence before accepting the first relying consumer.\n   375\t5. Accept each production frontend only after its complete four-host brief, cross-host equality, measurements and correctness/refusal battery pass. Preserve any unsupported lane or withdrawn witness as a failure/dependency, not an unreported skip.\n   376\t\n   377\tRisks requiring the owner's attention:\n   378\t\n   379\t- **One format, not two:** no stable caller-site evidence schema was found in the inspected oracle worktree. D1's payload contract is therefore deliberately bound by reference, with an explicit schema-freeze landing prerequisite. This design does not claim verbatim field-level integration has already been verified.\n   380\t- **Real origin ownership is unfinished:** final macro output, later safepoint transforms, SCC assembly and repeated unit admissions can change roots or reuse tokens. Portable identities need actual retained records; shape-valid fake origins would defeat the ruling.\n   381\t- **Preservation is not currently end-to-end:** encoder replacement/empty-table paths, safepoint clearing, publication's discarded provenance and content-shared reconstruction are concrete integration hazards. Native and continuation paths need their own reconstruction evidence.\n   382\t- **Prelude/host budget is unmeasured:** four-host republication is the broadest artifact obligation. No numeric annotation/trace overhead or passing lane is claimed by this design; preflight must record actual per-frontend bounds.\n   383\t- **Live-source drift:** the workspace advanced during inspection and the named TypeScript publication file is absent here. The post-sweep inventory must reconcile source, current contracts, new files and citations before implementation acceptance. The signed v3 “BEFORE acceptance” requirement governs throughout.\n   384\t\n   385\tArchitect verdict: **proceed with implementation/adoption briefs using this design, subject to the explicit inventory and evidence-schema landing prerequisites above; do not grant implementation or frontend acceptance from this document alone.** No canonical AST slot or blanket execution/module-schema bump is proposed.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"rg -n --glob '*.clj' --glob '*.cljc' --glob '*.cljs' --glob '*.cljd' --glob '*.py' --glob '*.sh' 'slice9_site_tables|site-tables-file|slice9_correspondence' .; nl -ba src/dev/latte_oracle_tables.clj | sed -n '1,100p'; nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '300,390p'\"","aggregated_output":"./test/yang/latte_oracle_test.clj:3247:      :site-tables-file \"slice9_site_tables.edn\"\n./test/yang/latte_oracle_test.clj:3284:     (spit (str dir \"/slice9_site_tables.edn\")\n./test/yang/latte_oracle_test.clj:3412:        (let [tables (edn/read-string (slurp (str dir \"/slice9_site_tables.edn\")))]\n./test/yang/latte_oracle_test.clj:3418:              [\"slice9_evidence.edn\" \"slice9_unexercised.edn\" \"slice9_site_tables.edn\"])\n     1\t;; Regenerate the LaTTe oracle's derived tables from the manifest forms:\n     2\t;;   test/yang/latte_oracle/throw_sites.edn  (the throw-site inventory)\n     3\t;;   test/yang/latte_oracle/case_arms.edn    (the per-arm case fixtures)\n     4\t;; Both are derived by yang.latte-oracle-test, so this script and the test\n     5\t;; cannot disagree about what a regenerated table holds.\n     6\t;; Run: clj -X:test:dev latte-oracle-tables/-main\n     7\t(ns latte-oracle-tables\n     8\t  (:require [clojure.java.io :as io]\n     9\t            [clojure.edn :as edn]\n    10\t            [clojure.string :as str]\n    11\t            [clojure.pprint :as pp]\n    12\t            [yang.latte-oracle-test]))\n    13\t\n    14\t\n    15\t(defn- derived\n    16\t  \"The result of calling the oracle test's private derivation `sym`.\"\n    17\t  [sym]\n    18\t  ((deref (ns-resolve 'yang.latte-oracle-test sym))))\n    19\t\n    20\t\n    21\t(defn- write-table!\n    22\t  [file header rows]\n    23\t  (io/make-parents file)\n    24\t  (spit file (str header (with-out-str (pp/pprint rows))))\n    25\t  (println \"wrote\" (count rows) \"rows to\" file))\n    26\t\n    27\t\n    28\t(def ^:private exclusions\n    29\t  {'latte_kernel.utils/nano-time \"Reads the host monotonic clock; no portable clock capability is installed.\"\n    30\t   'latte_kernel.unparser/show-term \"Captures host output and invokes clojure.pprint; formatting is host-local.\"\n    31\t   'latte_kernel.proof/show-term \"Invokes the excluded host pprint/output formatter.\"\n    32\t   'latte_kernel.proof/show-def \"Invokes the excluded host pprint/output formatter.\"\n    33\t   'latte_kernel.proof/elab-print-term \"Writes directly to host stdout; no portable output stream is supplied.\"\n    34\t   'latte_kernel.proof/elab-print-type \"Writes directly to host stdout; no portable output stream is supplied.\"\n    35\t   'latte_kernel.proof/elab-print-def \"Writes directly to host stdout; no portable output stream is supplied.\"\n    36\t   'latte_kernel.proof/elab-print-defenv \"Writes directly to host stdout; no portable output stream is supplied.\"\n    37\t   'latte_kernel.proof/print-state \"Writes directly to host stdout; no portable output stream is supplied.\"})\n    38\t\n    39\t\n    40\t(defn- admission-rows\n    41\t  []\n    42\t  (mapv (fn [{:keys [ns name] :as row}]\n    43\t          (let [excluded (get exclusions (symbol (str ns) (str name)))]\n    44\t            (assoc row :source (str (str/replace (str ns) \".\" \"/\") \".cljc\")\n    45\t                   :disposition (if excluded :excluded :admitted)\n    46\t                   :admission-reason\n    47\t                   (or excluded\n    48\t                       \"Guest source and explicit immutable context adapters over data/* and the declared kind/* host seams.\"))))\n    49\t        (edn/read-string (slurp \"test/yang/latte_oracle/manifest.edn\"))))\n    50\t\n    51\t\n    52\t(defn -main\n    53\t  [& _]\n    54\t  (write-table! \"test/yang/latte_oracle/manifest.edn\"\n    55\t                \";; GENERATED admission inventory; each binding is :admitted or :excluded with a reason.\\n\"\n    56\t                (admission-rows))\n    57\t  (write-table! \"test/yang/latte_oracle/throw_sites.edn\"\n    58\t                (str \";; GENERATED from the manifest forms by yang.latte-oracle-test/throw-site-rows.\\n\"\n    59\t                     \";; One row per throw symbol; disposition :fixture | :deferred | :excluded.\\n\")\n    60\t                (derived 'throw-site-rows))\n    61\t  (write-table! \"test/yang/latte_oracle/case_arms.edn\"\n    62\t                (str \";; GENERATED from the manifest forms by yang.latte-oracle-test/case-arm-rows.\\n\"\n    63\t                     \";; One row per case site: each arm's clause constants, and whether it has a default.\\n\")\n    64\t                (derived 'case-arm-rows))\n    65\t  (shutdown-agents))\n   300\t      ;; dispatch on the key's PRESENCE, not its truthiness: a marker\n   301\t      ;; whose value is present but not the integer 1 — nil or false\n   302\t      ;; included — carries :unsupported-version nil/false, and its\n   303\t      ;; reason is the unsupported version, never incomplete coverage\n   304\t      (and claim (contains? claim :unsupported-version))\n   305\t      (refusal :yin.link.publish/unsupported-call-site-version claim)\n   306\t\n   307\t      (and claim (not (:rows claim)))\n   308\t      (refusal :yin.link.publish/incomplete-call-site-coverage claim)\n   309\t\n   310\t      :else\n   311\t      (let [tree-address (vm/materialize-tree! handle tree)\n   312\t            sem-vector (:vector (linearize/project-rows tree))\n   313\t            sem (code/materialize-vector! handle sem-vector)\n   314\t            h-image (:image (derive/stack-image sem-vector))\n   315\t            r-image (derive/register-image sem-vector)\n   316\t            h (dcode/image-hash h-image)\n   317\t            r (rcode/register-hash r-image)\n   318\t            h-address (jing/materialize! handle h-image)\n   319\t            r-address (jing/materialize! handle r-image)\n   320\t            mint (fn [input output profile]\n   321\t                   (jing/materialize!\n   322\t                     handle\n   323\t                     (assoc (ledger/derive-record input output)\n   324\t                            :yin.ledger/profile profile)))\n   325\t            ;; the manifest is materialized FIRST, with the closed\n   326\t            ;; schema-1 key set only: the C1 side table never enters\n   327\t            ;; the hashed manifest, so identical specifications under\n   328\t            ;; distinct admissions share one manifest address\n   329\t            manifest {:yin.module/name name\n   330\t                      :yin.module/schema linker/manifest-schema\n   331\t                      :yin.module/contracts\n   332\t                      {:yin.ast/code vm/ast-contract\n   333\t                       :yin.semantic/code vm/semantic-contract\n   334\t                       :yin.debruijn.code vm/stack-contract\n   335\t                       :yin.debruijn.register vm/register-contract}\n   336\t                      :yin.module/tree tree-address\n   337\t                      :yin.module/derivations\n   338\t                      {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\n   339\t                       :yin.debruijn.code\n   340\t                       (mint sem h linker/stack-lowering-profile)\n   341\t                       :yin.debruijn.register\n   342\t                       (mint sem r linker/register-lowering-profile)}\n   343\t                      :yin.module/index {:yin.debruijn.code h-address\n   344\t                                         :yin.debruijn.register r-address}\n   345\t                      :yin.module/exports (set exports)\n   346\t                      :yin.module/requires (or requires {})\n   347\t                      :yin.module/primitives\n   348\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   349\t                                    primitives))\n   350\t                      :yin.module/footprint fp}\n   351\t            address (jing/materialize! handle manifest)\n   352\t            ;; the C1 side table and its publication record, beside\n   353\t            ;; the manifest: the record names the manifest (a record\n   354\t            ;; names a manifest, never the reverse), so each admission\n   355\t            ;; of one specification keeps its own record and table\n   356\t            call-sites (when (:rows claim)\n   357\t                         (let [table (jing/materialize! handle (:rows claim))\n   358\t                               record {:yang.call-site/schema 1\n   359\t                                       :yang.call-site/manifest address\n   360\t                                       :yang.call-site/root (:root tree)\n   361\t                                       :yang.call-site/origin (:origin claim)\n   362\t                                       :yang.call-site/table table}]\n   363\t                           {:record (jing/materialize! handle record)\n   364\t                            :table table\n   365\t                            :origin (:origin claim)\n   366\t                            :root (:root tree)\n   367\t                            :manifest address}))\n   368\t            walked (closure/walk handle address opts)]\n   369\t        (if (not= :complete (:yin.link.closure/outcome walked))\n   370\t          (refusal :yin.link.publish/incomplete-closure\n   371\t                   {:address address :walk walked})\n   372\t          (let [links (into {}\n   373\t                            (map (fn [f]\n   374\t                                   [(:format f)\n   375\t                                    (link-local handle address f\n   376\t                                                (select-keys opts\n   377\t                                                             [:bounds]))]))\n   378\t                            code-formats)]\n   379\t            (cond-> {:address address :manifest manifest\n   380\t                     :identities {:yin.semantic/code sem\n   381\t                                  :yin.debruijn.code sem\n   382\t                                  :yin.debruijn.register sem}\n   383\t                     :checksums {:yin.debruijn.code h\n   384\t                                 :yin.debruijn.register r}\n   385\t                     :links links}\n   386\t              call-sites (assoc :call-sites call-sites))))))))\n   387\t\n   388\t\n   389\t(defn publish-module!\n   390\t  \"Mint all four code formats, derivation records, and one schema-1 manifest.\n","exit_code":0,"status":"completed"}}
