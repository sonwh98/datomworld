    ;; the admission this batch produced the final tree\\n  1313\\t                    ;; under — the second coordinate of the side table's\\n  1314\\t                    ;; site identity, beside the final root address\\n  1315\\t                    origin (source-origin ctx source-batch run-index)\\n  1316\\t                    ;; the selected member's own verdict decides its\\n  1317\\t                    ;; metadata; a sibling's claim never manufactures a\\n  1318\\t                    ;; table for a member that made none\\n  1319\\t                    claims (batch-call-site-claims batch)\\n  1320\\t                     metadata (when (and claims (nth claims run-index))\\n  1321\\t                                (final-call-site-metadata\\n  1322\\t                                  (packet->row-set tree) origin))]\\n  1323\\t                (if-let [e (valid-tree? tree)]\\n  1324\\t                  (throw (ex-info \\\"Expander produced a non-canonical tree\\\" e))\\n  1325\\t                  (finish (assoc st :tree tree :next-store next-store\\n  1326\\t                                 :frontend-metadata metadata\\n  1327\\t                                  :call-site-origin (when metadata origin))))))))))))\\n  1328\\t\\n  1329\\t\\n  1330\\t(defn expand\\n  1331\\t  \\\"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\\n  1332\\t   the error data.\\\"\\n  1333\\t  [batch ctx]\\n  1334\\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\\n  1335\\t    (if (= :ok status)\\n  1336\\t      tree\\n  1337\\t      (throw (ex-info \\\"Macro expansion failed\\\" error)))))\\n  1338\\t\\n  1339\\t\\n  1340\\t(defn make-ctx\\n  1341\\t  \\\"An expander context. The composition supplies the incarnation `token`\\n  1342\\t   and the opaque `source-medium` identity (S3.1); the store may be\\n  1343\\t   seeded with `macro-entry` values. A seeded store binding a reserved\\n  1344\\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\\n  1345\\t   whose AST contract is absent (`:contract-missing`) or old\\n  1346\\t   (`:contract-mismatch`).\\\"\\n  1347\\t  [{:keys [token source-medium store guards], eval-fn :eval}]\\n  1348\\t  (cond-> {:store (check-store! (or store {})),\\n  1349\\t           :incarnation {:yin.expander/token token},\\n  1350\\t           :attempt 0,\\n  1351\\t           :source-medium source-medium,\\n  1352\\t           :t 0,\\n  1353\\t           :guards (merge default-guards guards)}\\n  1354\\t    eval-fn (assoc :eval eval-fn)))\\n  1355\\t\\n  1356\\t\\n  1357\\t;; =============================================================================\\n  1358\\t;; Standard forms (§5.4)\\n  1359\\t;; =============================================================================\\n  1360\\t\\n  1361\\t(def ^:private defn-lambda-ast\\n  1362\\t  \\\"`(fn [fn-name fn-params & body]\\n  1363\\t      (let [b (yin/sequence-body body)\\n  1364\\t            l (yin/make-lambda fn-params b)]\\n  1365\\t        (yin/make-def fn-name l)))`, lowered as `let` lowers.\\\"\\n  1366\\t  (let [v (fn [s] {:type :variable, :name s})\\n  1367\\t        app (fn [op & args] {:type :application, :operator op, :operands (vec args)})]\\n  1368\\t    {:type :lambda,\\n  1369\\t     :params '[fn-name fn-params & body],\\n  1370\\t     :body (app {:type :lambda,\\n  1371\\t                 :params '[b],\\n  1372\\t                 :body (app {:type :lambda,\\n  1373\\t                             :params '[l],\\n  1374\\t                             :body (app (v 'yin/make-def) (v 'fn-name) (v 'l))}\\n  1375\\t                            (app (v 'yin/make-lambda) (v 'fn-params) (v 'b)))}\\n  1376\\t                (app (v 'yin/sequence-body) (v 'body)))}))\\n  1377\\t\\n  1378\\t\\n  1379\\t(def stdlib-forms\\n  1380\\t  \\\"The standard forms as a row-native batch: one tree defining `defn`,\\n  1381\\t   declared and harvested. Seed a store by expanding it (`seed-store`).\\\"\\n  1382\\t  (let [def-ast {:type :application,\\n  1383\\t                 :operator {:type :variable, :name 'yin/def},\\n  1384\\t                 :operands [{:type :literal, :value 'defn} defn-lambda-ast]}]\\n  1385\\t    [:yin.program/batch\\n  1386\\t     [(ast->packet def-ast)]\\n  1387\\t     0\\n  1388\\t     [[:yin.macro/definition 0 []]]\\n  1389\\t     [[:yin.macro/harvest 0 0 []]]]))\\n  1390\\t\\n  1391\\t\\n  1392\\t(defn seed-store\\n  1393\\t  \\\"Fold validated input batches in order through `expand-batch`, returning\\n  1394\\t   the resulting store. Throws on a batch that fails.\\\"\\n  1395\\t  [ctx batches]\\n  1396\\t  (:store (reduce (fn [ctx batch]\\n  1397\\t                    (let [{:keys [status error] :as r} (expand-batch batch ctx)]\\n  1398\\t                      (when-not (= :ok status)\\n  1399\\t                        (throw (ex-info \\\"Store seeding batch failed\\\" error)))\\n  1400\\t                      (:ctx r)))\\n  1401\\t                  ctx\\n  1402\\t                  batches)))\\n  1403\\t\\n  1404\\t\\n  1405\\t;; =============================================================================\\n  1406\\t;; Expander observer (§9)\\n  1407\\t;; =============================================================================\\n  1408\\t\\n  1409\\t(defn make-expander\\n  1410\\t  \\\"The observer consumer: `ctx`, the `program-out` writer, and an optional\\n  1411\\t   log writer, with nothing staged.\\\"\\n  1412\\t  ([ctx out] (make-expander ctx out nil))\\n  1413\\t  ([ctx out log]\\n  1414\\t   {:ctx ctx, :out out, :out-staged nil, :log log, :log-staged nil,\\n  1415\\t    :forwarded 0, :errors []}))\\n  1416\\t\\n  1417\\t\\n  1418\\t(defn ready?\\n  1419\\t  \\\"Ready only when both staged slots are empty.\\\"\\n  1420\\t  [expander]\\n  1421\\t  (and (nil? (:out-staged expander)) (nil? (:log-staged expander))))\\n  1422\\t\\n  1423\\t\\n  1424\\t(defn call-site-table\\n  1425\\t  \\\"The C1 side table the consumer `expander` holds for the occurrence\\n  1426\\t   the executed tree packet `tree` names — `origin` being the\\n  1427\\t   admission/expansion origin that occurrence was produced under (§2.1:\\n  1428\\t   an application site is K = [origin root-address path], so the site\\n  1429\\t   table's key is the origin beside the root address) — or nil when\\n  1430\\t   that occurrence made no C1 claim. Two expansions can produce the\\n  1431\\t   SAME final root from different admissions; keying by the full\\n  1432\\t   occurrence identity keeps their tables distinct, so resolving by the\\n  1433\\t   origin+root pair at hand never answers another execution's table,\\n  1434\\t   however many loads have run since, and an unclaimed load of a root\\n  1435\\t   previously loaded under a claim retrieves no stale table.\\\"\\n  1436\\t  [expander tree origin]\\n  1437\\t  (get (:call-site-tables expander) [origin (first tree)]))\\n  1438\\t\\n  1439\\t\\n  1440\\t(defn load\\n  1441\\t  \\\"Expand one observed batch once: keep the returned context, stage the\\n  1442\\t   tree only on success, stage the log when a log writer exists, and\\n  1443\\t   accumulate the error of a failed expansion. Expansion failure is\\n  1444\\t   data, so the cursor advances past it. A successful expansion's C1\\n  1445\\t   side table (the batch result's `:frontend-metadata`, present only\\n  1446\\t   when the selected member itself claimed coverage) is retained on the\\n  1447\\t   consumer under the occurrence identity of the staged tree — its\\n  1448\\t   expansion origin beside its final root address (`call-site-tables`,\\n  1449\\t   resolved by `call-site-table`) — so the composition that drives this\\n  1450\\t   expander — the REPL's session — holds every executed occurrence's\\n  1451\\t   coverage beside the expander that produced it, each load's table\\n  1452\\t   surviving the next, even when two loads land on the same root.\\\"\\n  1453\\t  [expander batch]\\n  1454\\t  (let [{:keys [statu