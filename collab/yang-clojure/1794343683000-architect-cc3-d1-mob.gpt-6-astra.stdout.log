 125 126 127 128 129 130 131 132 133 134 135], :unparser-guest-closure [7 19 20 21 23 24 25]}}\ntest/yang/latte_oracle/slice9_gate.md:24:  recorded in the versioned [`slice9_site_tables.edn`](slice9_site_tables.edn)\ntest/yang/clojure_callsite_test.cljc:593:      (is (empty? (:call-site-tables consumer))\ntest/yang/clojure_callsite_test.cljc:645:        (is (= 2 (count (:call-site-tables consumer)))\ntest/yang/clojure_callsite_test.cljc:723:      (is (= 1 (count (:call-site-tables consumer)))))))\ntest/yang/latte_oracle_test.clj:3247:      :site-tables-file \"slice9_site_tables.edn\"\ntest/yang/latte_oracle_test.clj:3284:     (spit (str dir \"/slice9_site_tables.edn\")\ntest/yang/latte_oracle_test.clj:3412:        (let [tables (edn/read-string (slurp (str dir \"/slice9_site_tables.edn\")))]\ntest/yang/latte_oracle_test.clj:3418:              [\"slice9_evidence.edn\" \"slice9_unexercised.edn\" \"slice9_site_tables.edn\"])\nsrc/cljc/yin/vm/macro.cljc:1856:  (get (:call-site-tables expander) [origin (first tree)]))\nsrc/cljc/yin/vm/macro.cljc:1867:   admission origin beside its final root address (`call-site-tables`,\nsrc/cljc/yin/vm/macro.cljc:1879:      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"The design and later scoping differ on D1’s schema: the design requires a separate record that references unchanged oracle evidence, while the scoping sketches copied K-keyed tables. I’m checking the readers and trace instrumentation to resolve that conflict and define what cc3 can prove without evaluator changes.\n"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic/linearize.cljc | sed -n '1,225p'; nl -ba src/cljc/yin/vm/semantic/derive.cljc | sed -n '1,220p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic/linearize.cljc | sed -n '1,225p'; nl -ba src/cljc/yin/vm/semantic/derive.cljc | sed -n '1,220p'\"","aggregated_output":"     1\t(ns yin.vm.semantic.linearize\n     2\t  \"`project`: the Universal AST → the register-shaped canonical vector\n     3\t   (`docs/design/yin.vm.semantic.md` §3.3).\n     4\t\n     5\t   One flattening, two lanes: the datom\n     6\t   lane reads `:yin/*` datoms through an entity index, the row lane reads\n     7\t   code-as-tuples rows (§5.1) by the grammar table's positions. Both hand\n     8\t   the same walk a node reader, so the order is shared by construction:\n     9\t   operator, then operands left to right; a conditional's test,\n    10\t   consequent, alternate; occurrences expanded positionally; saturated\n    11\t   defaults; lambda bodies out of line after the main sequence, in one\n    12\t   FIFO queue that bodies discovered inside bodies join at the back.\n    13\t\n    14\t   Registers are body-local and minted pre-order: a destination is minted\n    15\t   when its expression is entered, before its children; a conditional's\n    16\t   arms are lowered into the conditional's destination and mint nothing\n    17\t   themselves; a `:resume` mints like every other expression though no\n    18\t   instruction names its id as a destination. No moves, folds or\n    19\t   rewrites.\n    20\t\n    21\t   Provenance is a side table beside the vector, never inside it; the\n    22\t   code address is `ucf/code-address` of the vector.\"\n    23\t  (:require [yin.vm :as vm]\n    24\t            [yin.vm.ucf :as ucf]))\n    25\t\n    26\t\n    27\t(def unsupported\n    28\t  \"Node types outside the shared supported AST vocabulary, rejected at\n    29\t   projection naming the node.\"\n    30\t  #{:yin/macro-expand :vm/store-update})\n    31\t\n    32\t\n    33\t(def ^:private slot-position\n    34\t  \"`[tag field]` → the field's row position (§2.5: id 0, tag 1, first\n    35\t   slot 2), from `vm/semantic-bytecode-grammar`. Provenance path steps\n    36\t   are these positions in both lanes.\"\n    37\t  (reduce-kv (fn [m tag slots]\n    38\t               (reduce (fn [m i]\n    39\t                         (assoc m [tag (first (nth slots i))] (+ 2 i)))\n    40\t                       m\n    41\t                       (range (count slots))))\n    42\t             {}\n    43\t             vm/semantic-bytecode-grammar))\n    44\t\n    45\t\n    46\t(def ^:private defaults\n    47\t  \"§2.4 / UCF §7.3.2 saturation, applied before lowering. The row lane's\n    48\t   rows are already saturated; the datom lane's facts may omit these.\"\n    49\t  {[:vm/gensym :prefix] \"id\",\n    50\t   [:stream/make :buffer] vm/default-stream-capacity,\n    51\t   [:application :operands] [],\n    52\t   [:dao.stream.apply/call :operands] []})\n    53\t\n    54\t\n    55\t(defn- flatten-tree\n    56\t  \"The §3.3 walk from `root` over `reader`, `{:tag (fn [id]) :slot (fn\n    57\t   [id field]) :check (fn [id])}`. `:check` runs on entering each lowered\n    58\t   node and throws to refuse it. Returns `{:code [tuple …] :sources [[id\n    59\t   path] …]}`, one source per pc, labels resolved to pcs.\"\n    60\t  [{:keys [tag slot check]} root]\n    61\t  (let [code (volatile! [])\n    62\t        sources (volatile! [])\n    63\t        labels (volatile! {})\n    64\t        bodies (volatile! [])\n    65\t        label-count (volatile! 0)\n    66\t        regs (volatile! 0)\n    67\t        fresh-label! (fn [] (vswap! label-count inc))\n    68\t        mark! (fn [l] (vswap! labels assoc l (count @code)))\n    69\t        emit! (fn [id path t]\n    70\t                (vswap! sources conj [id path])\n    71\t                (vswap! code conj t))\n    72\t        field (fn [id f]\n    73\t                (let [x (slot id f)]\n    74\t                  (if (nil? x) (get defaults [(tag id) f]) x)))\n    75\t        pos (fn [id f] (get slot-position [(tag id) f]))]\n    76\t    (letfn\n    77\t      [(definition?\n    78\t         [id]\n    79\t         (let [op (slot id :operator)]\n    80\t           (and (= :variable (tag op))\n    81\t                (= vm/definition-operator (slot op :name)))))\n    82\t       (expr\n    83\t         [id path]\n    84\t         (let [d @regs]\n    85\t           (vswap! regs inc)\n    86\t           (lower id path d)\n    87\t           d))\n    88\t       (exprs\n    89\t         [id f path]\n    90\t         (let [p (pos id f)\n    91\t               ids (field id f)]\n    92\t           (mapv (fn [j] (expr (nth ids j) (conj path [p j])))\n    93\t                 (range (count ids)))))\n    94\t       (child\n    95\t         [id f path]\n    96\t         (expr (slot id f) (conj path (pos id f))))\n    97\t       (lower\n    98\t         [id path d]\n    99\t         (check id)\n   100\t         (case (tag id)\n   101\t           :literal (emit! id path [:const d (slot id :value)])\n   102\t           :variable (emit! id path [:var d (slot id :name)])\n   103\t           :lambda (let [l (fresh-label!)]\n   104\t                     (vswap! bodies conj [l id path])\n   105\t                     (emit! id path [:closure d (vec (slot id :params)) l]))\n   106\t           :application\n   107\t           (if (definition? id)\n   108\t             ;; Rule R: the value operand, then `:define` with the literal\n   109\t             ;; key; neither the operator nor the key is an expression.\n   110\t             (let [[k-id v-id] (field id :operands)\n   111\t                   rs (expr v-id (conj path [(pos id :operands) 1]))]\n   112\t               (emit! id path [:define d (slot k-id :value) rs]))\n   113\t             (let [f (child id :operator path)\n   114\t                   args (exprs id :operands path)]\n   115\t               (emit! id path\n   116\t                      [:call d f args (boolean (slot id :tail?))])))\n   117\t           :if (let [else (fresh-label!)\n   118\t                     end (fresh-label!)\n   119\t                     c (child id :test path)]\n   120\t                 (emit! id path [:branch-false c else])\n   121\t                 (lower (slot id :consequent) (conj path (pos id :consequent)) d)\n   122\t                 (emit! id path [:jump end])\n   123\t                 (mark! else)\n   124\t                 (lower (slot id :alternate) (conj path (pos id :alternate)) d)\n   125\t                 (mark! end))\n   126\t           :dao.stream.apply/call (let [args (exprs id :operands path)]\n   127\t                                    (emit! id path\n   128\t                                           [:ffi-call d (slot id :op) args]))\n   129\t           :stream/make (emit! id path [:stream-make d (field id :buffer)])\n   130\t           :stream/put (let [s (child id :target path)\n   131\t                             x (child id :val path)]\n   132\t                         (emit! id path [:stream-put d s x]))\n   133\t           :stream/cursor (emit! id path\n   134\t                                 [:stream-cursor d (child id :source path)])\n   135\t           :stream/next (emit! id path\n   136\t                               [:stream-next d (child id :source path)])\n   137\t           :stream/close (emit! id path\n   138\t                                [:stream-close d (child id :source path)])\n   139\t           :vm/gensym (emit! id path [:gensym d (field id :prefix)])\n   140\t           :vm/store-get (emit! id path [:store-get d (slot id :key)])\n   141\t           :vm/store-put (emit! id path\n   142\t                                [:store-put d (slot id :key) (slot id :val)])\n   143\t           :vm/park (emit! id path [:park d])\n   144\t           :vm/current-continuation (emit! id path [:current-continuation d])\n   145\t           :vm/resume (let [x (child id :val path)]\n   146\t                        (emit! id path [:resume (slot id :parked-id) x]))\n   147\t           (throw (ex-info (str \"Cannot project node of type \" (tag id))\n   148\t                           {:type (tag id), :id id}))))]\n   149\t      (let [r (expr root [])]\n   150\t        (emit! root [] [:halt r]))\n   151\t      ;; A body may hold lambdas of its own, which join the back of\n   152\t      ;; `bodies` while this loop runs. Each body numbers its registers\n   153\t      ;; from 0, and its `:return` names the lambda, as the stack lane's\n   154\t      ;; does.\n   155\t      (loop [i 0]\n   156\t        (when-let [[l lambda path] (get @bodies i)]\n   157\t          (vreset! regs 0)\n   158\t          (mark! l)\n   159\t          (let [r (expr (slot lambda :body) (conj path (pos lambda :body)))]\n   160\t            (emit! lambda path [:return r]))\n   161\t          (recur (inc i))))\n   162\t      (let [labels @labels]\n   163\t        {:code (mapv (fn [t]\n   164\t                       (case (nth t 0)\n   165\t                         :jump (assoc t 1 (get labels (nth t 1)))\n   166\t                         :branch-false (assoc t 2 (get labels (nth t 2)))\n   167\t                         :closure (assoc t 3 (get labels (nth t 3)))\n   168\t                         t))\n   169\t                     @code),\n   170\t         :sources @sources}))))\n   171\t\n   172\t\n   173\t;; =============================================================================\n   174\t;; The row lane\n   175\t;; =============================================================================\n   176\t\n   177\t(defn- row-reader\n   178\t  \"Rows `{id [id tag & slots]}` already passed `vm/validate-rows`, so\n   179\t   nothing is re-checked.\"\n   180\t  [rows]\n   181\t  {:tag (fn [id] (nth (get rows id) 1)),\n   182\t   :slot (fn [id f]\n   183\t           (let [row (get rows id)]\n   184\t             (nth row (get slot-position [(nth row 1) f]))))\n   185\t   :check (fn [_id])})\n   186\t\n   187\t\n   188\t(defn project-rows\n   189\t  \"Project one canonical row set (`vm/ast->semantic-bytecode`'s `{:root\n   190\t   id, :rows {id row}}`) to the register-shaped vector. The rows are\n   191\t   validated (§7.4) first and a defect throws naming it. `origin` is nil\n   192\t   or one of §2.5's ruled occurrence origins.\n   193\t\n   194\t   Returns `{:vector v :address A :provenance [[pc origin root path] …]}`,\n   195\t   one provenance row per pc, `path` being the emitting node's §2.5\n   196\t   structural path from the root row (row-position steps; a `nodes` item\n   197\t   is a `[position i]` pair); a body's `:return` carries its lambda's\n   198\t   path.\"\n   199\t  ([bc] (project-rows bc nil))\n   200\t  ([{:keys [root rows], :as bc} origin]\n   201\t   (when-not (or (nil? origin) (vm/occurrence-origin? origin))\n   202\t     (throw (ex-info \"Cannot project rows with a malformed occurrence origin\"\n   203\t                     {:rule :origin, :origin origin})))\n   204\t   (when-let [{:keys [rule path id]} (vm/validate-rows bc)]\n   205\t     (throw (ex-info \"Cannot project rows that fail validation\"\n   206\t                     (cond-> {:rule rule}\n   207\t                       path (assoc :path path)\n   208\t                       id (assoc :id id)))))\n   209\t   (let [{:keys [code sources]} (flatten-tree (row-reader rows) root)]\n   210\t     {:vector code,\n   211\t      :address (ucf/code-address code),\n   212\t      :provenance (mapv (fn [pc [_ path]] [pc origin root path])\n   213\t                        (range)\n   214\t                        sources)})))\n   215\t\n   216\t\n   217\t(defn project\n   218\t  \"`project-rows` ∘ `vm/ast->semantic-bytecode`: a map AST to the\n   219\t   register-shaped vector by the row lane.\"\n   220\t  ([ast] (project ast nil))\n   221\t  ([ast origin] (project-rows (vm/ast->semantic-bytecode ast) origin)))\n   222\t\n   223\t\n   224\t;; =============================================================================\n   225\t;; The datom lane\n     1\t(ns yin.vm.semantic.derive\n     2\t  \"Pure native derivations from the admitted semantic register vector A.\"\n     3\t  (:refer-clojure :exclude [resolve])\n     4\t  (:require [yin.vm.semantic.code :as code]\n     5\t            [yin.vm.debruijn :as db]\n     6\t            [yin.vm.semantic.analysis :as analysis]\n     7\t            [yin.vm.debruijn-register-code :as rcode]))\n     8\t\n     9\t\n    10\t(defn- chains\n    11\t  [v bodies]\n    12\t  (letfn [(chain\n    13\t            [i]\n    14\t            (if-let [owner (:owner (nth bodies i))]\n    15\t              (into [(nth (nth v owner) 2)]\n    16\t                    (chain (code/body-index bodies owner)))\n    17\t              []))]\n    18\t    (mapv chain (range (count bodies)))))\n    19\t\n    20\t\n    21\t(defn resolve\n    22\t  \"Rewrite only variables and closure binders. The result is an unhashed\n    23\t   stage value; pcs and virtual registers are preserved.\"\n    24\t  [v]\n    25\t  (let [bodies (code/parse v)\n    26\t        frames (chains v bodies)\n    27\t        names (volatile! {})]\n    28\t    {:vector\n    29\t     (mapv (fn [pc]\n    30\t             (let [[op rd x y :as t] (nth v pc)]\n    31\t               (case op\n    32\t                 :var (let [{:keys [bound free]}\n    33\t                            (db/resolve-name (nth frames (code/body-index bodies pc)) x)]\n    34\t                        (if bound\n    35\t                          (do (vswap! names assoc pc x)\n    36\t                              (into [:load-bound rd] bound))\n    37\t                          [:load-free rd free]))\n    38\t                 :closure [:closure rd (count x) y]\n    39\t                 t)))\n    40\t           (range (count v)))\n    41\t     :bodies bodies\n    42\t     :names @names}))\n    43\t\n    44\t\n    45\t(defn addresses\n    46\t  \"Lexical references in pc order, from A, a resolved vector or a native\n    47\t   instruction vector (register or stack). Returns a vector, no identity.\"\n    48\t  [v]\n    49\t  (let [v (if (map? v) (or (:vector v) (:instructions v)) v)\n    50\t        v (if (some #(= :var (first %)) v) (:vector (resolve v)) v)]\n    51\t    (into []\n    52\t          (keep (fn [t]\n    53\t                  (case (first t)\n    54\t                    :load-bound (into [:bound] (subvec t (- (count t) 2)))\n    55\t                    :load-free [:free (peek t)]\n    56\t                    nil)))\n    57\t          v)))\n    58\t\n    59\t\n    60\t(defn stack-image\n    61\t  \"Stackify A's parsed expressions, placing closure bodies in FIFO order.\n    62\t   Labels and diagnostics are derived solely from A.\"\n    63\t  [v]\n    64\t  (let [{rv :vector bodies :bodies} (resolve v)\n    65\t        by-start (into {} (map (juxt :start identity)) bodies)\n    66\t        image (volatile! [])\n    67\t        side (volatile! {})\n    68\t        labels (volatile! {})\n    69\t        queue (volatile! [])\n    70\t        counter (volatile! 0)\n    71\t        label! (fn [] (vswap! counter inc))\n    72\t        mark! (fn [l] (vswap! labels assoc l (count @image)))\n    73\t        emit! (fn [t] (vswap! image conj t))]\n    74\t    (letfn [(walk\n    75\t              [node]\n    76\t              (let [pc (:pc node)\n    77\t                    [op _ x y z] (nth rv pc)\n    78\t                    children (:children node)\n    79\t                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n    80\t                (case (:op node)\n    81\t                  :if (let [[c th el] children\n    82\t                            else (label!) end (label!)]\n    83\t                        (walk c) (emit! [:branch-false else])\n    84\t                        (walk th) (emit! [:jump end])\n    85\t                        (mark! else) (walk el) (mark! end))\n    86\t                  :closure (let [l (label!)]\n    87\t                             (vswap! queue conj [l (get by-start y)])\n    88\t                             (diagnostic! {:kind :closure :params (nth (nth v pc) 2) :source pc})\n    89\t                             (emit! [:closure x l]))\n    90\t                  :var (do (diagnostic! {:kind :var :source pc})\n    91\t                           (emit! (if (= op :load-bound) [:load-bound x y] [:load-free x])))\n    92\t                  :call (do (doseq [child children] (walk child) (emit! [:push]))\n    93\t                            (emit! [:call (count y) z]))\n    94\t                  :ffi-call (do (doseq [child children] (walk child) (emit! [:push]))\n    95\t                                (emit! [:ffi-call x (count y)]))\n    96\t                  :stream-put (do (walk (nth children 0)) (emit! [:push])\n    97\t                                  (walk (nth children 1)) (emit! [:stream-put]))\n    98\t                  (:define :stream-cursor :stream-next :stream-close :resume)\n    99\t                  (do (walk (first children))\n   100\t                      (emit! (case op\n   101\t                               :define [:define x]\n   102\t                               :resume [:resume (nth (nth rv pc) 1)]\n   103\t                               [op])))\n   104\t                  (:const :gensym :store-get :stream-make) (emit! [op x])\n   105\t                  :store-put (emit! [op x y])\n   106\t                  (:current-continuation :park) (emit! [op]))))\n   107\t            (body!\n   108\t              [{:keys [expr owner]}]\n   109\t              (walk expr)\n   110\t              (emit! [(if (nil? owner) :halt :return)]))]\n   111\t      (body! (first bodies))\n   112\t      (loop [i 0]\n   113\t        (when-let [[l body] (get @queue i)]\n   114\t          (mark! l) (body! body) (recur (inc i))))\n   115\t      {:image (mapv (fn [t]\n   116\t                      (case (first t)\n   117\t                        (:jump :branch-false) (assoc t 1 (get @labels (nth t 1)))\n   118\t                        :closure (assoc t 2 (get @labels (nth t 2)))\n   119\t                        t)) @image)\n   120\t       :side-table @side})))\n   121\t\n   122\t\n   123\t(defn- allocation\n   124\t  [v a {:keys [start end owner]}]\n   125\t  (let [locals (if (nil? owner) 0 (count (nth (nth v owner) 2)))\n   126\t        defined (into #{} (keep #(code/rd (nth v %))) (range start end))\n   127\t        points (reduce (fn [m pc]\n   128\t                         (reduce (fn [m r] (update m r (fnil conj []) pc)) m\n   129\t                                 (into (analysis/live a pc) (analysis/defs v pc))))\n   130\t                       {} (range start end))\n   131\t        intervals (mapv (fn [r] [r (apply min (get points r)) (apply max (get points r))])\n   132\t                        (sort defined))\n   133\t        starts-by-pc (group-by second intervals)\n   134\t        missing (seq (remove defined (mapcat #(code/uses (nth v %)) (range start end))))]\n   135\t    (loop [pc start active [] free (sorted-set) next-slot 0 slots {}]\n   136\t      (if (= pc end)\n   137\t        {:locals locals :registers (+ locals next-slot (if missing 1 0))\n   138\t         :start start :end (dec end)\n   139\t         :slots slots :structural (+ locals next-slot)}\n   140\t        (let [expired (sort-by (juxt #(nth % 2) first)\n   141\t                               (filter #(< (nth % 2) pc) active))\n   142\t              free (into free (map #(get slots (first %))) expired)\n   143\t              active (filterv #(>= (nth % 2) pc) active)\n   144\t              starts (get starts-by-pc pc [])\n   145\t              [free next-slot slots]\n   146\t              (reduce (fn [[free next-slot slots] [r]]\n   147\t                        (let [i (if (seq free) (first free) next-slot)]\n   148\t                          [(disj free i) (if (seq free) next-slot (inc next-slot))\n   149\t                           (assoc slots r i)]))\n   150\t                      [free next-slot slots] starts)]\n   151\t          (recur (inc pc) (into active starts) free next-slot slots))))))\n   152\t\n   153\t\n   154\t(defn register-image\n   155\t  \"Allocate temporaries by linear scan over A's live points; preserve A's\n   156\t   layout and fill saved windows using the register format's liveness.\"\n   157\t  [v]\n   158\t  (let [{rv :vector bodies :bodies} (resolve v)\n   159\t        a (analysis/analyze v)\n   160\t        allocations (mapv #(allocation v a %) bodies)\n   161\t        instructions\n   162\t        (mapv (fn [pc t]\n   163\t                (let [{:keys [slots locals structural]}\n   164\t                      (nth allocations (code/body-index bodies pc))\n   165\t                      physical (fn [r] (if (contains? slots r) (+ locals (get slots r)) structural))\n   166\t                      op (first t)\n   167\t                      fields (get rcode/opcode-table op)]\n   168\t                  (into [op]\n   169\t                        (map-indexed (fn [i [k kind]]\n   170\t                                       (if (= k :yin.debruijn.register/live) []\n   171\t                                           (let [x (nth t (inc i))]\n   172\t                                             (case kind\n   173\t                                               :reg (physical x)\n   174\t                                               :regs (mapv physical x)\n   175\t                                               x)))) fields))))\n   176\t              (range (count rv)) rv)\n   177\t        image {:bodies (mapv #(select-keys % [:locals :registers :start :end]) allocations)\n   178\t               :instructions instructions}]\n   179\t    (reduce (fn [image bi]\n   180\t              (reduce (fn [image [pc live]]\n   181\t                        (assoc-in image [:instructions pc\n   182\t                                         (rcode/live-slot-index (first (nth instructions pc)))] live))\n   183\t                      image (rcode/body-liveness image bi)))\n   184\t            image (range (count bodies)))))\n","exit_code":0,"status":"completed"}}
