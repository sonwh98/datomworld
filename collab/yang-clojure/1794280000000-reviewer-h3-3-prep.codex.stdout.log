{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/src/latte_kernel/defenv.cljc | sed -n '30,115p'; nl -ba /Users/sto/.gitlibs/libs/latte-kernel/latte-kernel/86fca0d1d054af005cb37395eae04500d45e6279/src/latte_kernel/syntax.cljc | sed -n '260,285p;445,490p'\"","aggregated_output":"    30\t;;     one particularly useful option is `opaque` which, when true,\n    31\t;;     avoids any unfolding of the definition (this is useful for\n    32\t;;     e.g. equality).\n    33\t;;}\n    34\t\n    35\t(defn definition?\n    36\t  \"Is `v` a definition?\"\n    37\t  [v]\n    38\t  (instance? Definition v))\n    39\t\n    40\t(def empty-env [{} {}])\n    41\t\n    42\t(defn mkenv [env] [env {}])\n    43\t\n    44\t(defn local-definitions [env]\n    45\t  (second env))\n    46\t\n    47\t(defn register-definition\n    48\t  ([def-env rdef] (register-definition def-env rdef false))\n    49\t  ([def-env rdef local?]\n    50\t   (let [[global-defs local-defs] def-env]\n    51\t     (if local?\n    52\t       [global-defs (assoc local-defs (:name rdef) rdef)]\n    53\t       [(assoc global-defs (:name rdef) rdef) local-defs]))))\n    54\t\n    55\t;;{\n    56\t;; Definitions are searched by *name*, which can be:\n    57\t;;   - directly a Clojure or Clojurescript *var*\n    58\t;;   - indirectly a symbol\n    59\t;;\n    60\t;; In the case of Clojurescript, the symbol will be *resolved* to\n    61\t;; the corresponding var (if any). In Clojurescript, dynamic name\n    62\t;; resolution is not available.\n    63\t\n    64\t;; The definitions identified by symbols are searched in an explicit\n    65\t;; definitional environment. The *vars* are searched in the implicit\n    66\t;; environment provided by the current namespace.\n    67\t;;}\n    68\t\n    69\t(defn fetch-definition\n    70\t  \"Fetches definition named `dname` in priority in the supplied `def-env` map.\n    71\t  In the Clojure (not Clojurescript) version the definition is also sought in the current namespace.\n    72\t\n    73\t  If the optional argument `local-only?` is set to `true` then the definition is\n    74\t  looked for in `def-env` and only for definition tagged \\\"local\\\". In any case the current namespace\n    75\t  is not considered. In Clojurescript the namespace is not considered anyways. The flag is `false` by default.\"\n    76\t  ([def-env dname] (fetch-definition def-env dname false))\n    77\t  ([def-env dname local-only?]\n    78\t   (let [[global-defs local-defs] def-env]\n    79\t     ;; (println \"[fetch-definition] dname=\" dname)\n    80\t     (cond\n    81\t       (symbol? dname) (if-let [ldef (get local-defs dname)]\n    82\t                         [:ok ldef]\n    83\t                         #?(:clj (if local-only?\n    84\t                                   [:ko {:msg \"No such (local) definition\" :def dname}]\n    85\t                                   (if-let [gdef (get global-defs dname)]\n    86\t                                     [:ok gdef]\n    87\t                                     (if-let [dnamevar (resolve dname)]\n    88\t                                       (recur def-env dnamevar local-only?)\n    89\t                                       [:ko {:msg \"No such (global) definition\" :def dname}])))\n    90\t                            :cljs (if-let [gdef (get global-defs dname)]\n    91\t                                    [:ok gdef]\n    92\t                                    [:ko {:msg \"No such (global) definition\" :def dname}])))\n    93\t       (var? dname) (let [gdef @dname]\n    94\t                      ;;(println \"[fetch-definition] \" gdef)\n    95\t                      [:ok gdef])\n    96\t       :else (throw (ex-info \"Cannot fetch definition (please report)\"\n    97\t                             {:dname dname}))))))\n    98\t\n    99\t(defn registered-definition?\n   100\t  \"Does `dname` corresponds to the name of a registered definition\n   101\t  in `def-env` (or the current namespace)?\"\n   102\t  ([dname] (registered-definition? empty-env dname false))\n   103\t  ([def-env dname] (registered-definition? def-env dname false))\n   104\t  ([def-env dname local?]\n   105\t   (let [[status _] (fetch-definition def-env dname local?)]\n   106\t     (= status :ok))))\n   107\t\n   108\t;;{\n   109\t;; Definition name corresponding to namespace *vars* must be resolved\n   110\t;; to a fully qualified name.\n   111\t;; This does not apply to the Clojurescript case since symbol resolution\n   112\t;; is not available.\n   113\t;;}\n   114\t\n   115\t(defn qualify-def [def-env dname]\n   260\t;;}\n   261\t\n   262\t(defn mk-fresh\n   263\t  \"Generate a fresh variable name, with prefix `base`\n   264\t  and suffix chosen from ' (quote), '', ''' then -4, -5, etc.\n   265\t  The `forbid` argument says what names are forbidden.\"\n   266\t  ([base forbid] (mk-fresh base 0 forbid))\n   267\t  ([base ^long level forbid]\n   268\t   (let [suffix (case level\n   269\t                  0 \"\"\n   270\t                  1 \"'\"\n   271\t                  2 \"''\"\n   272\t                  3 \"'''\"\n   273\t                  (str \"-\" level))\n   274\t         candidate (symbol (str base suffix))]\n   275\t     (if (contains? forbid candidate)\n   276\t       (recur base (inc level) forbid)\n   277\t       candidate))))\n   278\t\n   279\t;;{\n   280\t;; The following is the core of the substitution algorithm.\n   281\t;;}\n   282\t\n   283\t(declare rebinder)\n   284\t\n   285\t(defn- subst-\n   445\t;; This is done through the use of of metadata.\n   446\t;;\n   447\t;;}\n   448\t\n   449\t(defn- readable-term-\n   450\t  \"Return a readable version of the same term `t`, without nameless variables.\n   451\t  `free` is to be provided by below function, and `bound` means all bound vars.\"\n   452\t  ([free t] (readable-term- free {} t))\n   453\t  ([free bound t]\n   454\t   (let [quot (partial readable-term- free bound)]\n   455\t     (cond\n   456\t       ;; a variable not in `bound` is guaranteed to be a free variable\n   457\t       (variable? t)\n   458\t       (get bound t t)\n   459\t\n   460\t       (binder? t)\n   461\t       (let [[binder [x tx] body] t\n   462\t             ;; fetch the original name of the var and make a fresh one with it.\n   463\t             ;; if there is no metadata we use the same base symbol.\n   464\t             x' (mk-fresh (:name (meta x) x) free)]\n   465\t         (list binder [x' (quot tx)]\n   466\t           ;; we add the new name to `free` so it is not shadowed by a deeper\n   467\t           ;; binder, and we associate the old name with the new in `bound`.\n   468\t           (readable-term- (conj free x') (assoc bound x x') body)))\n   469\t\n   470\t       (app? t)\n   471\t       (mapv quot t)\n   472\t\n   473\t       (or (ref? t) (ascription? t))\n   474\t       (cons (first t) (map quot (rest t)))\n   475\t\n   476\t       :else t))))\n   477\t\n   478\t(defn readable-term\n   479\t  \"Return a readable version of the same term `t`, without nameless variables.\"\n   480\t  [t]\n   481\t  (let [free (free-vars t)]\n   482\t    (readable-term- free t)))\n","exit_code":0,"status":"completed"}}
