orm))\n  1513\t                                                                    (= p '[status rec-ty]))\n  1514\t                                                    ;; Both type branches return their context to the\n  1515\t                                                    ;; enclosing have step, including anonymous have.\n  1620\t\n  1621\t\n  1622\t(defn- kernel-closure\n  1623\t  [call]\n  1624\t  (let [sources (merge (into {} (map (juxt second identity)) context-forms) kernel-sources)\n  1625\t        mentions #(filter (set (keys sources)) (walk-symbols %))\n  1626\t        needed (loop [todo (seq (mentions call)) seen #{}]\n  1627\t                 (if-let [n (first todo)]\n  1628\t                   (if (contains? seen n) (recur (next todo) seen)\n  1629\t                       (recur (concat (next todo) (mentions (get sources n))) (conj seen n))) seen))\n  1630\t        ordered (concat context-forms kernel-declaration-refusals (map #(get kernel-sources (kernel-guest-name (:symbol %))) kernel-entries))]\n  1631\t    (filterv #(contains? needed (second %)) ordered)))\n  1632\t\n  1633\t\n  1634\t(defn- kernel-fixture-call\n  1635\t  [{:keys [call guest-call definitions project-proof?]} guest?]\n  1636\t  (let [env (if guest? initial-context 'latte-kernel.defenv/empty-env)\n  1637\t        register (if guest? 'register-definition 'latte-kernel.defenv/register-definition)\n  1638\t        env (reduce (fn [env definition] (list register env (if guest? (kernel-call definition) definition))) env definitions)\n  1639\t        call (if guest? (kernel-call (or guest-call call)) call)\n  1640\t        call (if project-proof?\n  1641\t               (list 'let ['r call] '(if (= :ok (first r)) [:ok (rest (second r))] r)) call)]\n  1642\t    (list 'let ['env env] call)))\n  1643\t\n  1644\t\n  1645\t(defn- evidence-data\n  1646\t  \"EDN evidence retains all portable values and metadata. Nonportable host\n  1647\t   payloads are explicit evidence, not accepted representation differences.\"\n  1648\t  [x]\n  1649\t  (cond\n  1650\t    (fn? x) {:nonportable-host-value (str (class x))}\n  1651\t    (record? x) (evidence-data (upstream-record-data x))\n  1652\t    (map? x) (into {} (map (fn [[k v]] [(evidence-data k) (evidence-data v)])) x)\n  1653\t    (vector? x) (mapv evidence-data x)\n  1654\t    (set? x) (set (map evidence-data x))\n  1655\t    (seq? x) (apply list (map evidence-data x))\n  1656\t    :else x))\n  1657\t\n  1658\t\n  1659\t(defn- kernel-attempt\n  1660\t  [f]\n  1661\t  (try (f)\n  1662\t       (catch Exception e\n  1663\t         {:status :blocked :message (ex-message e)\n  1664\t          ;; The session and consumer are host VM recovery machinery, not\n  1665\t          ;; portable domain payloads. Walking their closure environments can\n  1780\t   'latte-kernel.unparser/unparse-term-rec 'unparse-term-rec\n  1781\t   'latte-kernel.norm/install-unfold-implicit! 'install-unfold-implicit\n  1782\t   'latte-kernel.unparser/install-fundamental-unparsers! 'install-fundamental-unparsers\n  1783\t   'latte-kernel.unparser/prod-impl-unparser 'prod-impl-unparser})\n  1784\t\n  1785\t\n  1786\t(def ^:private kernel-context-extra-arguments\n  1787\t  ;; Immutable-context APIs take one explicit context where upstream reads\n  1788\t  ;; or writes an ambient binding. Raw guest arities remain in the trace.\n  1789\t  {'unregister-unparser 1 'unparse 1 'register-unparser 1\n  1790\t   'install-unfold-implicit 1 'install-fundamental-unparsers 1\n  1791\t   'gate-proof-install-opacity-function 1})\n  1792\t\n  1793\t\n  1794\t(defn- kernel-trace-form\n  1795\t  \"Append the selected function/arity at body entry, including indirect calls.\n  1796\t   Only C is instrumented; A/B still run their original fixture paths.\"\n  1797\t  [form]\n  1798\t  (if (#{'defn 'defn-} (first form))\n  1799\t    (let [[op fname & header] form\n  1800\t          header (drop-while #(not (or (vector? %) (seq? %))) header)\n  1801\t          trace-arity (fn [[params & body]]\n  1802\t                        (let [n (if (some #{'&} params)\n  1803\t                                  [:variadic (.indexOf params '&)] (count params))]\n  1804\t                          (list* params\n  1805\t                                 (list 'stream/put! 'gate-execution-trace (list 'quote [fname n]))\n  1806\t                                 body)))]\n  1807\t      (list* op fname (if (vector? (first header))\n  1808\t                        (trace-arity header) (map trace-arity header))))\n  1809\t    form))\n  1810\t\n  1811\t\n  1812\t(defn- kernel-executed-arity?\n  1813\t  [row symbol n]\n  1814\t  (let [names (remove nil? [(kernel-guest-name symbol)\n  1815\t                            (get kernel-context-integration-names symbol)])\n  1816\t        paths (set (for [fname names]\n  1817\t                     [fname (if (number? n)\n  1818\t                              (+ n (get kernel-context-extra-arguments fname 0)) n)]))]\n  1819\t    (every? (fn [lane] (some paths (get-in row [lane :executed-calls])))\n  1820\t            [:c-walker :c-semantic])))\n  1821\t\n  1822\t\n  1823\t(defn- kernel-compile\n  1824\t  [fixture]\n  1825\t  (let [call (kernel-c-program fixture)\n  1826\t        forms (kernel-closure call)\n  1827\t        program (into ['(def gate-execution-trace (stream/make 1000000))]\n  1828\t                      (concat (map kernel-trace-form forms) [call]))\n  1829\t        program (into (yang/library-for program) program)\n  1830\t        opts (update arg-vector-opts :native into\n  1831\t                     (map (fn [[op profile]] [(clojure.core/symbol \"stream\" (name op)) profile])\n  1832\t                          module/stream-profiles))\n  1833\t        ast (yang/compile-program program true opts)\n  1834\t        missing (unbound-ast-symbols ast program)]\n  1835\t    (if (seq missing)\n  1836\t      {:status :blocked :phase :admission :blocked-by (vec (sort missing))\n  1837\t       :owners (in