{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/yang/latte_oracle/h3_3_a_verify.clj'","aggregated_output":"     1\t(ns yang.latte-oracle.h3-3-a-verify\n     2\t  \"H3-3 fixture-family A-verification (PREPARATION round; not part of the\n     3\t   oracle suite and not loaded by yang.latte-oracle-test).\n     4\t\n     5\t   Runs the proposed H3-3 fixtures for the 20 admitted-but-unexercised\n     6\t   kernel arities against the ORIGINAL pinned upstream latte-kernel\n     7\t   (git sha 86fca0d1, the deps.edn :test alias) on host Clojure -- the\n     8\t   harness's A leg (kernel-a equivalent) -- and checks the exact outcomes\n     9\t   predicted in h3_3_fixture_family.md. No B/C leg, no harness state, no\n    10\t   evidence files are touched. The unparser fixtures run against an\n    11\t   isolated registry atom, replicating the harness's :unparser-install\n    12\t   A-leg handling; the readable-term- fixtures call the private upstream\n    13\t   var through the (var ...) form the corpus :call will use, because a\n    14\t   direct qualified call does not compile outside its own namespace.\n    15\t\n    16\t   Seat run (from the repository root):\n    17\t\n    18\t     clj -M:test -e \\\"(do (load-file \\\\\\\"test/yang/latte_oracle/h3_3_a_verify.clj\\\\\\\") (yang.latte-oracle.h3-3-a-verify/-main))\\\"\n    19\t\n    20\t   Exit code 0 means every prediction in the design document holds on A;\n    21\t   each FAIL line names the fixture/case whose prediction must be revised\n    22\t   before harness integration. Expected values are taken from the pinned\n    23\t   upstream source and, where they exist, its own tests\n    24\t   (test/latte_kernel/*_test.cljc at the same sha); see the verification\n    25\t   ledger in h3_3_fixture_family.md.\"\n    26\t  (:require [latte-kernel.defenv :as defenv]\n    27\t            [latte-kernel.nbe :as nbe]\n    28\t            [latte-kernel.norm :as norm]\n    29\t            [latte-kernel.presyntax :as parse]\n    30\t            [latte-kernel.syntax :as stx]\n    31\t            [latte-kernel.unparser :as unp]))\n    32\t\n    33\t(def ^:private failures (atom []))\n    34\t(def ^:private total (atom 0))\n    35\t\n    36\t(defn- check\n    37\t  \"Record one exact-equality prediction. `actual` is the A outcome.\"\n    38\t  [label expected actual]\n    39\t  (swap! total inc)\n    40\t  (if (= expected actual)\n    41\t    (println \"PASS\" label)\n    42\t    (do (swap! failures conj label)\n    43\t        (println \"FAIL\" label)\n    44\t        (println \"  expected:\" (pr-str expected))\n    45\t        (println \"  actual:  \" (pr-str actual)))))\n    46\t\n    47\t(defn- check-thrown\n    48\t  \"Record one thrown-rejection prediction: ex-info message and data.\"\n    49\t  [label f expected-message expected-data]\n    50\t  (swap! total inc)\n    51\t  (try\n    52\t    (let [value (f)]\n    53\t      (swap! failures conj label)\n    54\t      (println \"FAIL\" label)\n    55\t      (println \"  expected: thrown\" (pr-str expected-message) (pr-str expected-data))\n    56\t      (println \"  actual:   returned\" (pr-str value)))\n    57\t    (catch clojure.lang.ExceptionInfo e\n    58\t      (if (= [expected-message expected-data] [(ex-message e) (ex-data e)])\n    59\t        (println \"PASS\" label)\n    60\t        (do (swap! failures conj label)\n    61\t            (println \"FAIL\" label)\n    62\t            (println \"  expected: thrown\" (pr-str expected-message) (pr-str expected-data))\n    63\t            (println \"  actual:   thrown\" (pr-str (ex-message e)) (pr-str (ex-data e))))))))\n    64\t\n    65\t(defn- a-run\n    66\t  \"The harness A leg for an ordinary fixture: evaluate the fixture :call\n    67\t   with `env` bound to upstream empty-env extended by `definitions`\n    68\t   (each a ->Definition form), exactly as kernel-fixture-call does.\n    69\t   The environment is built as a form, not embedded as a value, so\n    70\t   Definition records never appear as eval literals.\"\n    71\t  ([call] (a-run [] call))\n    72\t  ([definitions call]\n    73\t   (let [env-form (reduce (fn [e d] (list 'latte-kernel.defenv/register-definition e d))\n    74\t                          'latte-kernel.defenv/empty-env definitions)]\n    75\t     (eval (list 'let ['env env-form] call)))))\n    76\t\n    77\t;; ---------------------------------------------------------------------------\n    78\t;; defenv predicates\n    79\t;; ---------------------------------------------------------------------------\n    80\t\n    81\t(defn- run-defenv\n    82\t  []\n    83\t  (check \"axiom?/1 on an Axiom record\" true\n    84\t         (a-run '(latte-kernel.defenv/axiom? (latte-kernel.defenv/->Axiom (quote a) [] 0 (quote T)))))\n    85\t  (check \"axiom?/1 on a Definition record\" false\n    86\t         (a-run '(latte-kernel.defenv/axiom? (latte-kernel.defenv/->Definition (quote d) [] 0 (quote body) #{} (quote T) {}))))\n    87\t  (check \"axiom?/1 on a plain map\" false\n    88\t         (a-run '(latte-kernel.defenv/axiom? {})))\n    89\t  ;; The ambient (empty-env) 1-arity: the name is registered nowhere and\n    90\t  ;; resolves in no namespace visible to the A leg, so fetch falls through\n    91\t  ;; to its [:ko ...] result and the predicate is false.\n    92\t  (check \"registered-definition?/1 ambient, unregistered name\" false\n    93\t         (a-run '(latte-kernel.defenv/registered-definition? (quote gate-no-such-definition))))\n    94\t  (check-thrown \"registered-definition?/1 ambient, non-symbol name\"\n    95\t                #(a-run '(latte-kernel.defenv/registered-definition? 5))\n    96\t                \"Cannot fetch definition (please report)\" {:dname 5}))\n    97\t\n    98\t;; ---------------------------------------------------------------------------\n    99\t;; nbe\n   100\t;; ---------------------------------------------------------------------------\n   101\t\n   102\t(defn- run-nbe\n   103\t  []\n   104\t  (check \"evaluation/1 on a redex\" 'b\n   105\t         (a-run '(latte-kernel.nbe/evaluation (quote [(λ [a ✳] a) b]))))\n   106\t  (check \"evaluation/1 on a variable\" 'a\n   107\t         (a-run '(latte-kernel.nbe/evaluation (quote a))))\n   108\t  (check-thrown \"evaluation/1 on a missing reference\"\n   109\t                #(a-run '(latte-kernel.nbe/evaluation (quote (gate-missing))))\n   110\t                \"No such definition\" {:term '(gate-missing) :def-name 'gate-missing})\n   111\t  (check \"nbe/instantiate-def/3 full application\"\n   112\t         '[[(λ [x ✳] (λ [y ✳] [x y])) a] b]\n   113\t         (a-run '(latte-kernel.nbe/instantiate-def (quote [[x ✳] [y ✳]]) (quote [x y]) (quote [a b]))))\n   114\t  (check-thrown \"nbe/instantiate-def/3 with too many arguments\"\n   115\t                #(a-run '(latte-kernel.nbe/instantiate-def (quote [[x ✳]]) (quote x) (quote [a b])))\n   116\t                \"Not enough parameters (please report)\" {:args '[a b]}))\n   117\t\n   118\t;; ---------------------------------------------------------------------------\n   119\t;; norm: beta family\n   120\t;; ---------------------------------------------------------------------------\n   121\t\n   122\t(defn- run-beta\n   123\t  []\n   124\t  (check \"redex?/1 on a redex\" true\n   125\t         (a-run '(latte-kernel.norm/redex? (quote [(λ [x ✳] x) y]))))\n   126\t  (check \"redex?/1 on a non-lambda application\" false\n   127\t         (a-run '(latte-kernel.norm/redex? (quote [x y]))))\n   128\t  (check \"redex?/1 on a variable\" false\n   129\t         (a-run '(latte-kernel.norm/redex? (quote x))))\n   130\t  (check \"beta-reduction/1 (upstream test-beta-reduction case)\" '[y y]\n   131\t         (a-run '(latte-kernel.norm/beta-reduction (quote [(λ [x ✳] [x x]) y]))))\n   132\t  (check-thrown \"beta-reduction/1 on a non-redex\"\n   133\t                #(a-run '(latte-kernel.norm/beta-reduction (quote [x y])))\n   134\t                \"Cannot beta-reduce. Not a redex\" {:term '[x y]})\n   135\t  (check \"beta-step/1 on a redex\" '[y 1]\n   136\t         (a-run '(latte-kernel.norm/beta-step (quote [(λ [x ✳] x) y]))))\n   137\t  (check \"beta-step/2 with an initial count of 5\" '[y 6]\n   138\t         (a-run '(latte-kernel.norm/beta-step (quote [(λ [x ✳] x) y]) 5)))\n   139\t  (check \"beta-step/1 under a binder\" '[(λ [x ✳] x) 1]\n   140\t         (a-run '(latte-kernel.norm/beta-step (quote (λ [x ✳] [(λ [y ✳] y) x])))))\n   141\t  (check \"beta-step/1 on a variable (no redex)\" '[x 0]\n   142\t         (a-run '(latte-kernel.norm/beta-step (quote x))))\n   143\t  (check \"beta-step-args/2 in parallel\" '[[y z] 1]\n   144\t         (a-run '(latte-kernel.norm/beta-step-args (quote ([(λ [x ✳] x) y] z)) 0))))\n   145\t\n   146\t;; ---------------------------------------------------------------------------\n   147\t;; norm: instantiate-def\n   148\t;; ---------------------------------------------------------------------------\n   149\t\n   150\t(defn- run-norm-instantiate\n   151\t  []\n   152\t  (check \"norm/instantiate-def/3 full (upstream test-instantiate-def case)\"\n   153\t         '[[(λ [t ✳] t) t1] [[t2 t3] (λ [t ✳] t)]]\n   154\t         (a-run '(latte-kernel.norm/instantiate-def (quote [[x ✳] [y ✳] [z ✳]])\n   155\t                                                    (quote [[x y] [z x]])\n   156\t                                                    (quote ((λ [t ✳] t) t1 [t2 t3])))))\n   157\t  (check \"norm/instantiate-def/3 partial (remaining parameter re-abstracted)\"\n   158\t         '(λ [t' ✳] [[(λ [t ✳] t) t1] [[t2 t3] t']])\n   159\t         (a-run '(latte-kernel.norm/instantiate-def (quote [[x ✳] [y ✳] [z ✳] [t ✳]])\n   160\t                                                    (quote [[x y] [z t]])\n   161\t                                                    (quote ((λ [t ✳] t) t1 [t2 t3])))))\n   162\t  (check-thrown \"norm/instantiate-def/3 with too many arguments\"\n   163\t                #(a-run '(latte-kernel.norm/instantiate-def (quote [[x ✳]]) (quote x) (quote [a b])))\n   164\t                \"Not enough parameters (please report)\" {:args '(b)}))\n   165\t\n   166\t;; ---------------------------------------------------------------------------\n   167\t;; norm: delta family (environment threading)\n   168\t;; ---------------------------------------------------------------------------\n   169\t\n   170\t(def ^:private delta-def\n   171\t  '(latte-kernel.defenv/->Definition (quote d) [] 0 (quote ✳) #{} (quote □) {}))\n   172\t\n   173\t(defn- run-delta\n   174\t  []\n   175\t  ;; local? true with the definition registered locally (the composed\n   176\t  ;; register-definition call is the corpus's entry-delta-local shape).\n   177\t  (check \"delta-step/4 local-only, local definition\" '[✳ 1]\n   178\t         (a-run '(latte-kernel.norm/delta-step\n   179\t                   (latte-kernel.defenv/register-definition env (latte-kernel.defenv/->Definition (quote d) [] 0 (quote ✳) #{} (quote □) {}) true)\n   180\t                   [] (quote (d)) true)))\n   181\t  (check \"delta-step/4 global lookup, global definition\" '[✳ 1]\n   182\t         (a-run [delta-def] '(latte-kernel.norm/delta-step env [] (quote (d)) false)))\n   183\t  (check \"delta-step-args/5 over a reducible and an irreducible argument\"\n   184\t         '[[✳ [(λ [x ✳] x) y]] 1]\n   185\t         (a-run [delta-def] '(latte-kernel.norm/delta-step-args env [] (quote ((d) [(λ [x ✳] x) y])) false 0)))\n   186\t  (check-thrown \"delta-step/4 on a missing definition\"\n   187\t                #(a-run '(latte-kernel.norm/delta-step env [] (quote (gate-missing)) false))\n   188\t                \"No such definition\" {:term '(gate-missing) :def-name 'gate-missing}))\n   189\t\n   190\t;; ---------------------------------------------------------------------------\n   191\t;; presyntax\n   192\t;; ---------------------------------------------------------------------------\n   193\t\n   194\t(defn- run-parse\n   195\t  []\n   196\t  (check \"parse/1 (ambient empty environment)\" '(λ [x ✳] x)\n   197\t         (a-run '(latte-kernel.presyntax/parse (quote (lambda [x :type] x)))))\n   198\t  (check-thrown \"parse/1 on an empty compound term\"\n   199\t                #(a-run '(latte-kernel.presyntax/parse (quote ())))\n   200\t                \"Parse error\" {:msg \"Compound term is empty\" :term '()})\n   201\t  (check-thrown \"parse/1 on a reserved symbol\"\n   202\t                #(a-run '(latte-kernel.presyntax/parse (quote lambda)))\n   203\t                \"Parse error\" {:msg \"Symbol is reserved\" :term 'lambda}))\n   204\t\n   205\t;; ---------------------------------------------------------------------------\n   206\t;; syntax\n   207\t;; ---------------------------------------------------------------------------\n   208\t\n   209\t(defn- run-syntax\n   210\t  []\n   211\t  (check \"binderify/3 with two bindings\" '(λ [x ✳] (λ [y A] [x y]))\n   212\t         (a-run '(latte-kernel.syntax/binderify (quote λ) (quote [[x ✳] [y A]]) (quote [x y]))))\n   213\t  (check \"binderify/3 with no bindings\" 'B\n   214\t         (a-run '(latte-kernel.syntax/binderify (quote Π) (quote []) (quote B))))\n   215\t  ;; mk-fresh is a pure suffix search: no gensym, no supply, deterministic.\n   216\t  (check \"mk-fresh/2 skips forbidden suffixes\" 'x''\n   217\t         (a-run '(latte-kernel.syntax/mk-fresh (quote x) (quote #{x x'}))))\n   218\t  (check \"mk-fresh/2 with nothing forbidden\" 'x\n   219\t         (a-run '(latte-kernel.syntax/mk-fresh (quote x) (quote #{}))))\n   220\t  (check \"mk-fresh/3 from level 3 (upstream test-mk-fresh shape)\" 'x-4\n   221\t         (a-run '(latte-kernel.syntax/mk-fresh (quote x) 3 (quote #{x x' x'' x'''}))))\n   222\t  (check \"mk-fresh/3 from level 0 with the base forbidden\" 'x'\n   223\t         (a-run '(latte-kernel.syntax/mk-fresh (quote x) 0 (quote #{x}))))\n   224\t  (check \"readable-term/1 renames a binder colliding with a free variable\"\n   225\t         '[(λ [x' ✳] x') x]\n   226\t         (a-run '(latte-kernel.syntax/readable-term (quote [(λ [x ✳] x) x]))))\n   227\t  (check \"readable-term/1 on a variable\" 'x\n   228\t         (a-run '(latte-kernel.syntax/readable-term (quote x))))\n   229\t  ;; readable-term- is a private var: the corpus :call reaches it through\n   230\t  ;; (var ...), which is also how this script calls it.\n   231\t  (check \"readable-term-/2 with a colliding free set\" '(λ [x' ✳] x')\n   232\t         (a-run '((var latte-kernel.syntax/readable-term-) (quote #{x}) (quote (λ [x ✳] x)))))\n   233\t  (check \"readable-term-/3 with an explicit bound map\" '(λ [x' ✳] [x' y])\n   234\t         (a-run '((var latte-kernel.syntax/readable-term-) (quote #{x}) (quote {}) (quote (λ [x ✳] [x y]))))))\n   235\t\n   236\t;; ---------------------------------------------------------------------------\n   237\t;; unparser (side-effecting): isolated registry atom, as in kernel-a's\n   238\t;; :unparser-install mode. The outcome is observed through unparse, never\n   239\t;; through the registry value itself (it holds host functions).\n   240\t;; ---------------------------------------------------------------------------\n   241\t\n   242\t(defn- run-unparser\n   243\t  []\n   244\t  (let [registry-var (requiring-resolve 'latte-kernel.unparser/+unparser-registry+)\n   245\t        fresh-registry {:fundamental [] :standard [] :user [] :unparsers {}}]\n   246\t    (with-redefs-fn {registry-var (atom fresh-registry)}\n   247\t      (fn []\n   248\t        (check \"unregister-unparser!/1 removes the unparser (observed via unparse)\"\n   249\t               '[shown x]\n   250\t               (a-run '(let [_ (latte-kernel.unparser/register-unparser! :gate (fn [t] (if (= t (quote x)) [(quote shown) true] [t false])))]\n   251\t                         [(latte-kernel.unparser/unparse (quote x))\n   252\t                          (do (latte-kernel.unparser/unregister-unparser! :gate)\n   253\t                              (latte-kernel.unparser/unparse (quote x)))])))\n   254\t        (check-thrown \"unregister-unparser!/1 on an absent ident\"\n   255\t                      #(a-run '(latte-kernel.unparser/unregister-unparser! :absent))\n   256\t                      \"No such unparser.\" {:ident :absent})\n   257\t        ;; Conservative upstream behavior (unparser.cljc:35): unregister\n   258\t        ;; rebuilds :user from the :standard list. Pin the observable\n   259\t        ;; registry shape, not just the dissoc.\n   260\t        (unp/register-unparser! :standard :std (fn [t] [t false]))\n   261\t        (unp/register-unparser! :user :usr (fn [t] [t false]))\n   262\t        (unp/unregister-unparser! :usr)\n   263\t        (let [registry @@registry-var]\n   264\t          (check \"unregister rebuilds :user from :standard (conservative upstream)\"\n   265\t                 {:fundamental [] :standard '[:std] :user '[:std] :idents #{:std}}\n   266\t                 {:fundamental (:fundamental registry) :standard (:standard registry)\n   267\t                  :user (:user registry) :idents (set (keys (:unparsers registry)))}))))))\n   268\t\n   269\t(defn -main\n   270\t  [& _]\n   271\t  (run-defenv)\n   272\t  (run-nbe)\n   273\t  (run-beta)\n   274\t  (run-norm-instantiate)\n   275\t  (run-delta)\n   276\t  (run-parse)\n   277\t  (run-syntax)\n   278\t  (run-unparser)\n   279\t  (let [passed (- @total (count @failures))]\n   280\t    (if (empty? @failures)\n   281\t      (println (str \"H3-3-A-VERIFY: PASS (\" passed \"/\" @total \")\"))\n   282\t      (println (str \"H3-3-A-VERIFY: FAIL (\" passed \"/\" @total \") prediction(s): \" (pr-str @failures)))))\n   283\t  (flush)\n   284\t  (System/exit (if (empty? @failures) 0 1)))\n","exit_code":0,"status":"completed"}}
