(list 'data/into lead coll-form)\n1332\t                                        coll-form)\n1333\t                                      false env macro-env)\n1334\t                        env tail?)))\n1335\t\n1336\t\n1337\t(defn- compile-av-application\n1338\t  [operator operands env tail? macro-env]\n1339\t  (cond\n1340\t    (apply-call? env operator) (compile-apply operands env tail? macro-env)\n1341\t\n1342\t    ;; (:k m) / (:k m default): a static lookup\n1343\t    (keyword? operator)\n1344\t    (do (when-not (<= 1 (count operands) 2)\n1345\t          (reject! \"A keyword call takes a map and an optional default\"\n1346\t                   {:keyword operator, :operands (count operands)}))\n1347\t        (when (contains? (locals env) 'get)\n1348\t          (reject! \"A local binding of get would capture a keyword lookup\"\n1349\t                   {:keyword operator}))\n1350\t        (cond-> {:type :application\n1351\t                 :operator {:type :variable, :name 'get}\n1352\t                 :operands (into [(compile-form (first operands) false env macro-env)\n1353\t                                  (compile-literal operator false)]\n1354\t                                 (map #(compile-form % false env macro-env))\n1355\t                                 (rest operands))}\n1356\t          tail? (assoc :tail? true)))\n1357\t\n1358\t    (and (outcomes? env) (= operator 'yang.call/eligible?))\n1359\t    (let [candidate 'dsg__eligibility_candidate]\n1360\t      (cond-> (u/mark-tails\n1361\t                (apply u/app\n1362\t                       (u/lam [candidate]\n1363\t                              (u/if-node\n1364\t                                (u/app (u/v 'dsg__admitted?) (u/v candidate))\n1365\t                                (u/app (u/v 'yang.call/eligible?) (u/v candidate))\n1366\t                                (u/lit false)))\n1367\t                       (map #(compile-form % false env macro-env) operands)))\n1368\t        tail? (assoc :tail? true)))\n1369\t\n1370\t    (and (outcomes? env)\n1371\t         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n1372\t         (<= 4 (count operands)))\n1373\t    (let [bindings (into ['dsg__invocation_candidate]\n1374\t                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n1375\t                         (range (dec (count operands))))\n1376\t          compile-operand #(compile-form % false env macro-env)]\n1377\t      (cond-> (u/mark-tails\n1378\t                (apply u/app\n1379\t                       (u/lam bindings\n1380\t                              (u/if-node\n1381\t                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n1382\t                                (apply u/app (u/v operator) (map u/v bindings))\n1383\t                                (u/app (u/v 'yang.call/transfer)\n1384\t                                       (u/v (nth bindings 3))\n1385\t                                       (u/app (u/v 'yang.call/condition)\n1386\t                                              (u/lit :yang.call/not-callable)\n1387\t                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n1388\t                                                     (u/lit :yang.call/callee)\n1389\t                                                     (u/v (first bindings)))))))\n1390\t                       (map compile-operand operands)))\n1391\t        tail? (assoc :tail? true)))\n1392\t\n1393\t    ;; a statically native name: call it directly\n1394\t    (native-name? env operator)\n1395\t    (cond-> {:type :application\n1396\t             :operator (cond-> {:type :variable, :name operator}\n1397\t                         (seq (meta operator)) (with-meta (meta operator)))\n1398\t             :operands (mapv #(compile-form % false env macro-env) operands)}\n1399\t      tail? (assoc :tail? true))\n1400\t\n1401\t    ;; anything else: one guest invocation, in tail position when the call is\n1402\t    :else\n1403\t    (compile-guest-call (compile-form operator false env macro-env)\n1404\t                        (compile-form (vec operands) false env macro-env)\n1405\t                        env tail?)))\n1406\t\n1407\t\n1408\t(defn compile-application\n1409\t  \"Compile a function application to Universal AST.\n1410\t\n1411\t  Clojure: (+ 1 2)\n1412\t  AST: {:type :application\n1413\t        :operator <compiled-operator>\n1414\t        :operands [<compiled-operand1> <compiled-operand2>]}\n1415\t\n1416\t  Under the argument-vector convention a user-function call passes its\n1417\t  operands as one vector.\"\n1418\t  ([operator operands env tail?] (compile-application operator operands env tail? initial-macro-env))\n1419\t  ([operator operands env tail? macro-env]\n1420\t   (if (and (::convention env) (not (macro-call? env macro-env operator)))\n1421\t     (compile-av-application operator operands env tail? macro-env)\n1422\t     (let [compiled-operator (compile-form operator false env macro-env)"}
{"role":"tool","tool_call_id":"tool_L29ZvQqAZs40vH7kZSdEKTvr","content":"1\t# Slice 9 kernel differential gate: execution evidence correction\n2\t\n3\tThe gate on the hardening line is **blocked**. The architect denied the prior\n4\t165/165 closure claim because membership in a static dependency closure did\n5\tnot prove execution of every arity. That claim is withdrawn. The gate retains\n6\tits final assertion `(= :pass (:gate-status evidence))`; missing execution\n7\tevidence must fail that assertion.\n8\t\n9\tThe 106-fixture corpus has **100 passing agreements, two recorded deviations\n10\t(`elab-after-qed`, `check-after-qed`), two blocked fixtures, and two recorded\n11\tupstream failures.** The four narrowly recorded exception dispositions remain\n12\tdeclared departures, not agreements. No upstream or `src/cljc/` source changes\n13\tare made by H3-0. Admission is unchanged: 155 bindings (146 admitted, 9\n14\texcluded) and 175 candidate function/arities (165 admitted, 10 excluded).\n15\t\n16\tRecorded executions establish **107/165** admitted arities: 39 directly\n17\tand 68 through named integrations. The other **58**, including `parse/1`,\n18\tremain uncredited. The declared departures are carried by the versioned\n19\t[`slice9_declarations.edn`](slice9_declarations.edn) (provenance `ea18c8e4^`),\n20\trevalidated on every refresh by the representation-aware classifier: the\n21\tguest `:meta` value may be a pre-adoption raw closure or the admitted §8.10\n22\tdescriptor; structurally invalid descriptors and any payload, message, script\n23\tor call mismatch refuse (descriptor authenticity itself is the compiler's\n24\tadmission witness upstream of the outcome). The corrected counts and remaining arities\n25\tare recorded in [`slice9_evidence.edn`](slice9_evidence.edn) and\n26\t[`slice9_unexercised.edn`](slice9_unexercised.edn). The residual consumers in\n27\t[`fixture_closure.edn`](fixture_closure.edn) retain their concrete expected\n28\toutcomes; they do not establish closure of the full inventory, and their\n29\tcount (20) predates the re-derivation — the live unexercised set is the\n30\t58-name list.\n31\t\n32\t## Consumer evidence\n33\t\n34\t- `mkenv` preserves a nonempty global environment and creates empty locals.\n35\t- `beta-red`, `delta-normalize`, and `delta-normalize-local` have explicit\n36\t  entry fixtures and missing-reference rejections. The local wrapper also\n37\t  exercises explicit local definitions and their precedence over an ambient\n38\t  namespace definition.\n39\t- `install-unfold-implicit!` installs into both isolated upstream atoms on A.\n40\t  B/C return an updated immutable context, used by both the delta wrapper and\n41\t  NBE. Both normalizers read the same installed extension. An installed\n42\t  refusing extension propagates its original error data.\n43\t- `install-opacity-function` starts from a refusing policy, explicitly installs\n44\t  the working policy, then enters the original proof dispatcher through\n45\t  opaque/transparent steps and qed. A duplicate opaque step rejects. A uses\n46\t  an isolated namespace and host-local Var policy; B/C thread immutable\n47\t  definition updates through the explicit context.\n48\t- `install-fundamental-unparsers!` starts from an empty registry, installs the\n49\t  fundamental product unparser, then unparses nested implications. Dependent\n50\t  products and atoms remain unchanged. Direct `prod-impl-unparser` fixtures\n51\t  also verify its `[term false]` refusal result.\n52\t- `exists-kw?`, `term?`, `pair?`, and `vectorn?` include false results.\n53\t  `bound-vars` distinguishes a bound occurrence from entirely free variables.\n54\t  These fixtures preserve upstream behavior, including its shallow term\n55\t  validator and the use of `vector` rather than `vector?` in utility predicates.\n56\t- `proper-type?` enters each arity separately. Unknown variables throw;\n57\t  a well-typed term whose inferred type is not a sort returns false.\n58\t- `show-deftype` checks definition, axiom, theorem, implicit, and unknown\n59\t  labels. It depends only on portable record-kind predicates and returns a\n60\t  string. Host pprint and stdout functions remain excluded.\n61\t- `safe-get` covers successful lookup, missing keys, stored false, and stored\n62\t  nil. The latter three all reject upstream. `vremove` removes every match,\n63\t  preserves a no-match vector, and propagates a predicate's domain exception.\n64\t\n65\t`mkenv`, `appify`, and `bound-vars` have no domain rejection in the pinned\n66\tsource; the fixtures preserve their constructor, empty-input, and empty-set\n67\tresults instead of manufacturing refusals. A refused product rewrite is\n68\tidentified by its explicit modification flag, not mistaken for an exception.\n69\t\n70\tThe pinned local delta wrapper has a narrower portability scope than its\n71\tdocstring suggests: `delta-step` drops `local?` when calling `delta-reduction`\n72\ton a reference. Consequently upstream can resolve a global or host namespace\n73\tdefinition on that path. The global-result fixture preserves this behavior;\n74\tthe namespace fixture supplies a local definition that shadows the ambient\n75\tone. The guest boundary still requires explicit definitions and has no host\n76\tnamespace lookup capability. This round does not repair upstream or claim\n77\tagreement for ambient-only resolution.\n78\t\n79\t## Acceptance counting\n80\t\n81\tEvery selected guest function body appends `[guest-function arity]` to an\n82\texplicit diagnostic stream at entry. Instrumentation covers all arities of\n83\tthe functions supplied to each fixture, including higher-order calls through\n84\tregistries and extension closures. Each C lane creates its own stream.\n85\tAfter the VM halts, the harness reads that stream through its own\n86\tcursor, preserving the fixture's original outcome and exception payload.\n87\tA/B remain uninstrumented. Raw ordered call records are retained under\n88\t`:c-walker :executed-calls` and `:c-semantic :executed-calls` for every completed\n89\tfixture. The original uninstrumented fixtures used 1,000,000 instructions per\n90\tlane. The instrumented fixtures have a 2,000,000 instruction bound because\n91\tbody-entry stream writes add guest instructions. Reading the completed\n92\tdiagnostic stream is harness work after halt. This is an instrumentation\n93\tbudget change, not a new performance acceptance claim.\n94\t\n95\tPassing direct fixtures contribute only their original function/argument\n96\tcount, and only with matching body-entry records in both C lanes. Passing\n97\tnamed integrations contribute only exact arities recorded in both C lanes.\n98\tStatic dependency membership contributes no credit. Full branch coverage is\n99\tnot required. Context adapter identities and explicit extra context arguments\n100\tare recorded in the evidence; each observed guest arity is checked against"}
