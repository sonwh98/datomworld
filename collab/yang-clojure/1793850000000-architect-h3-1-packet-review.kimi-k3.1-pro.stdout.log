 like any program: the\n2164\t;; functions that invoke guest closures (map, filter, reduce, comp, partial)\n2165\t;; must run on the VM, never on the host, because a closure is a VM value. It\n2166\t;; is written for the argument-vector convention with the outcome model, so a\n2167\t;; closure it calls is unwrapped by the compiler's own early-return pattern\n2168\t;; and a closure's failure ends the library function with the same outcome.\n2169\t;;\n2170\t;; What is derived, from the VM primitives and the `data` module only:\n2171\t;; identity, inc/dec, second, the collection predicates (coll?/vector?/map?/\n2172\t;; set?/seq?/list?/sequential?, from the `portable/*` adapters of data/count,\n2173\t;; peek, dissoc and disj: a refusal as data says \"not that kind\"), boolean?,\n2174\t;; fn? (data/callable?), seq, rem, reverse, list, cons, vector, count,\n2175\t;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\n2176\t;; keys/vals/disj and set union/difference,\n2177\t;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\n2178\t;; compiler intrinsic over the convention's argument vector.\n2179\t;;"}
{"role":"tool","tool_call_id":"tool_xveI9cCksNCo0Jtb4vZZHfFp","content":"150\t      (update :ingress-gaps (fnil inc 0))))\n151\t\n152\t\n153\t(defn observe-next\n154\t  \"Observe one batch from the attached medium.\n155\t\n156\t   Returns `{:status :ok :batch batch :observer observer'}` on `ok`, where the\n157\t   successor state carries the exact returned cursor; `{:status :blocked\n158\t   :observer observer}` and `{:status :end :observer observer}`, which retain\n159\t   the cursor; or `{:status :gap :observer observer'}`, where the successor\n160\t   carries the recovery cursor and one more counted `:ingress-gaps`. Terminal\n161\t   outcomes (`cursor-mismatch`, `invalid-cursor`, `transport-error`) and\n162\t   unexpected ones throw with the original outcome preserved.\"\n163\t  [observer]\n164\t  (let [observed (observe/step (:stream observer)\n165\t                               (:cursor observer)\n166\t                               (fn [_value] {:dao.stream/outcome :dao.stream/ok}))]\n167\t    (case (:status observed)\n168\t      :advance {:status :ok,\n169\t                :batch (:dao.stream/value (:read observed)),\n170\t                :observer (assoc observer :cursor (:cursor observed))}\n171\t\n172\t      :retry {:status :blocked, :observer observer}\n173\t      :ended {:status :end, :observer observer}\n174\t      :gap {:status :gap, :observer (adopt-gap observer observed)}\n175\t\n176\t      (observation-terminal observed observer))))\n177\t\n178\t\n179\t;; =============================================================================\n180\t;; Coordination\n181\t;; =============================================================================\n182\t\n183\t(defn- consumer-left-by-run\n184\t  \"The consumer state a failing `run` left, for the carried session.\n185\t\n186\t   A `run` that made partial progress before throwing — a flush that\n187\t   delivered one medium and failed on another — reports the state it reached\n188\t   by carrying a `:consumer` in its exception's data, so a retry resumes\n189\t   from that progress rather than repeating delivered work. A `run` that\n190\t   reports nothing left the state it was handed, which is the furthest\n191\t   progress the coordination can name for it.\"\n192\t  [e handed]\n193\t  (let [data (ex-data e)]\n194\t    (if (contains? data :consumer)\n195\t      (:consumer data)\n196\t      handed)))\n197\t\n198\t\n199\t(defn- carry-session\n200\t  \"Rethrow `e`, keeping the throw and carrying the partial session in the\n201\t   exception's data.\n202\t\n203\t   The original message and data are preserved and `:session` is added. The\n204\t   rethrow is a new `ExceptionInfo` whose cause is the original, so a caller\n205\t   matching the original exception's concrete type no longer matches the\n206\t   wrapper — `(ex-cause caught)` names it. Recovery is opt-in: a caller that\n207\t   does not read `:session` keeps the old semantics — a throw means the\n208\t   round failed — and a caller that catches resumes from the carried\n209\t   session, which names the furthest progress the round had made where the\n210\t   failure happened.\"\n211\t  [session e]\n212\t  (throw (ex-info (or (ex-message e) (str e))\n213\t                  (assoc (ex-data e) :session session)\n214\t                  e)))\n215\t\n216\t\n217\t(defn run-on-stream\n218\t  \"Coordinate one `{:observer observer :consumer consumer}` session over the\n219\t   attached medium, returning the updated session.\n220\t\n221\t   The consumer is any value the three supplied functions agree on. `ready?`\n222\t   decides when it may accept another batch, `load` hands it one observed\n223\t   batch and returns the successor consumer, and `run` lets it do whatever\n224\t   work a loaded batch implies — evaluate, expand, index, forward — and\n225\t   returns the successor. This is coordination, not interpretation: no field\n226\t   of the consumer is inspected, so any consumer shape can be driven.\n227\t\n228\t   A consumer that is not ready runs first, and observation follows only if\n229\t   it becomes ready. A ready consumer observes one batch; `gap` commits the\n230\t   recovery cursor and continues; `blocked` and `end` return the session.\n231\t   After a batch loads and runs, a consumer that is ready again observes the\n232\t   next batch, and one that is not returns the session without another read.\n233\t\n234\t   A `load` or `run` that throws still propagates — the throw is kept — but\n235\t   carries the partial session in the exception's data under `:session`, so\n236\t   recovery is opt-in. Where the failure happened decides the carried\n237\t   session: a throwing `load` carries the cursor *before* the failing batch,\n238\t   so a retry re-reads it; a throwing `run` carries the cursor *after* the\n239\t   loaded batch and the consumer the failing `run` left — the partial state\n240\t   it reported under `:consumer` in its own exception's data when it made\n241\t   progress before throwing, else the state `load` returned — so a retry\n242\t   neither re-reads the batch nor repeats work already delivered; a\n243\t   terminal read after processed batches carries the session those batches\n244\t   produced. A consumer whose input can be bad should therefore return that\n245\t   as data from `load` rather than throw, and reserve the throw for its own\n246\t   defects.\"\n247\t  [session ready? load run]\n248\t  (loop [{:keys [observer consumer]} session]\n249\t    (if-not (ready? consumer)\n250\t      (let [consumer' (try (run consumer)\n251\t                           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n252\t                             (carry-session\n253\t                               {:observer observer,\n254\t                                :consumer (consumer-left-by-run e consumer)}\n255\t                               e)))]\n256\t        (if (ready? consumer')\n257\t          (recur {:observer observer, :consumer consumer'})\n258\t          {:observer observer, :consumer consumer'}))\n259\t      ;; The load is the step's effect, so the cursor advances only once it has\n260\t      ;; returned: a throwing load propagates before any successor exists, and\n261\t      ;; the session it carries names the cursor before the failing batch.\n262\t      (let [observed (try (observe/step (:stream observer)\n263\t                                        (:cursor observer)\n264\t                                        (fn [batch]\n265\t                                          {:dao.stream/outcome :dao.stream/ok,\n266\t                                           :dao.stream.observer/loaded\n267\t                                           (load consumer batch)}))\n268\t                          (catch #?(:cljd Object :clj Throwable :cljs :default) e\n269\t                            (carry-session {:observer observer, :consumer consumer} e)))]\n270\t        (case (:status observed)\n271\t          :advance (let [loaded (:dao.stream.observer/loaded (:effect observed))\n272\t                         ;; The batch was observed and loaded before the run, so\n273\t                         ;; a throwing run carries the post-batch cursor and the\n274\t                         ;; consumer it left: the partial state it reported in"}
{"role":"tool","tool_call_id":"tool_FwUWw5RqTRa2wgDG7NuS7K66","content":"1\t(ns yang.core.call\n2\t  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n3\t   §8.10). This namespace emits the same pure definitions into bundled\n4\t   preludes and the linked `yang.call` module.\"\n5\t  (:require [yang.core.prelude :as core]\n6\t            [yang.core.uast :as u]))\n7\t\n8\t\n9\t(def module-name\n10\t  \"The linker module that publishes the shared calling runtime.\"\n11\t  'yang.call)\n12\t\n13\t\n14\t(def host-names\n15\t  \"Host module names read by the guest definitions.\"\n16\t  '#{cell/get data/callable? data/contains? data/count data/map? data/nth\n17\t     data/string? data/vector?})\n18\t\n19\t\n20\t(def definitions\n21\t  \"The one ordered definition list used by both emitters.\"\n22\t  '[;; Descriptor projection remains structural after callable admission.\n23\t    [yang.call/_descriptor\n24\t     (fn [callable]\n25\t       (if (data/map? callable)\n26\t         (if (= (get callable :type) :cell-ref)\n27\t           (cell/get callable)\n28\t           callable)\n29\t         nil))]\n30\t    [yang.call/entry\n31\t     (fn [callable]\n32\t       (get (yang.call/_descriptor callable) :yang.call/entry))]\n33\t    [yang.call/eligible?\n34\t     (fn [callable]\n35\t       (let [descriptor (yang.call/_descriptor callable)]\n36\t         (if (nil? (yang.call/entry callable))\n37\t           false\n38\t           (if (data/contains? descriptor :yang.call/eligible?)\n39\t             ((get descriptor :yang.call/eligible?) callable)\n40\t             true))))]\n41\t    [yang.call/invocation\n42\t     (fn [callee positional named raise]\n43\t       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n44\t                            :yang.call/positional positional)\n45\t                     :yang.call/named named)\n46\t              :yang.call/raise raise))]\n47\t    [yang.call/invocation-with\n48\t     (fn [callee positional named raise options]\n49\t       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n50\t                            :yang.call/positional positional)\n51\t                     :yang.call/named named)\n52\t              :yang.call/raise raise))]\n53\t    [yang.call/_pair?\n54\t     (fn [pair]\n55\t       (if (data/vector? pair)\n56\t         (= (data/count pair) 2)\n57\t         false))]\n58\t    [yang.call/_named-pairs?\n59\t     (fn [pairs index]\n60\t       (if (= index (data/count pairs))\n61\t         true\n62\t         (let [pair (data/nth pairs index)]\n63\t           (if (yang.call/_pair? pair)\n64\t             (if (data/string? (data/nth pair 0))\n65\t               (yang.call/_named-pairs? pairs (+ index 1))\n66\t               false)\n67\t             false))))]\n68\t    [yang.call/valid-invocation?\n69\t     (fn [invocation]\n70\t       (if (data/map? invocation)\n71\t         (if (data/contains? invocation :yang.call/callee)\n72\t           (if (data/contains? invocation :yang.call/positional)\n73\t             (if (data/contains? invocation :yang.call/named)\n74\t               (if (data/contains? invocation :yang.call/raise)\n75\t                 (if (data/vector? (get invocation :yang.call/positional))\n76\t                   (if (data/vector? (get invocation :yang.call/named))\n77\t                     (yang.call/_named-pairs?\n78\t                       (get invocation :yang.call/named) 0)\n79\t                     false)\n80\t                   false)\n81\t                 false)\n82\t               false)\n83\t             false)\n84\t           false)\n85\t         false))]\n86\t    [yang.call/condition\n87\t     (fn [reason evidence]\n88\t       (assoc (assoc {} :yang.call/reason reason)\n89\t              :yang.call/data evidence))]\n90\t    [yang.call/thrown\n91\t     (fn [value]\n92\t       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n93\t              :yang.call/value value))]\n94\t    [yang.call/transfer\n95\t     (fn [raise condition]\n96\t       (raise condition))]\n97\t    [yang.call/invoke\n98\t     (fn [callable positional named raise]\n99\t       (if (data/callable? raise)\n100\t         (if (yang.call/eligible? callable)\n101\t           (let [target (yang.call/entry callable)\n102\t                 record (yang.call/invocation callable positional named raise)]\n103\t             (if (not (nil? target))\n104\t               (if (yang.call/valid-invocation? record)\n105\t                 (target record)\n106\t                 (yang.call/transfer\n107\t                   raise\n108\t                   (yang.call/condition :yang.call/invalid-invocation\n109\t                                        {:yang.call/callee callable})))\n110\t               (yang.call/transfer\n111\t                 raise\n112\t                 (yang.call/condition :yang.call/invalid-invocation\n113\t                                      {:yang.call/callee callable}))))\n114\t           (yang.call/transfer\n115\t             raise\n116\t             (yang.call/condition :yang.call/not-callable\n117\t                                  {:yang.call/callee callable})))\n118\t         (raise (yang.call/condition :yang.call/invalid-invocation\n119\t                                     {:yang.call/reason :missing-raise-exit}))))]\n120\t    [yang.call/invoke-with\n121\t     (fn [callable positional named raise options]\n122\t       (if (data/callable? raise)\n123\t         (if (yang.call/eligible? callable)\n124\t           (let [target (yang.call/entry callable)\n125\t                 record (yang.call/invocation-with\n126\t                          callable positional named raise options)]\n127\t             (if (not (nil? target))\n128\t               (if (yang.call/valid-invocation? record)\n129\t                 (target record)\n130\t                 (yang.call/transfer\n131\t                   raise\n132\t                   (yang.call/condition :yang.call/invalid-invocation\n133\t                                        {:yang.call/callee callable})))\n134\t               (yang.call/transfer\n135\t                 raise\n136\t                 (yang.call/condition :yang.call/invalid-invocation\n137\t                                      {:yang.call/callee callable}))))\n138\t           (yang.call/transfer\n139\t             raise\n140\t             (yang.call/condition :yang.call/not-callable\n141\t                                  {:yang.call/callee callable})))\n142\t         (raise (yang.call/condition :yang.call/invalid-invocation\n143\t                                     {:yang.call/reason :missing-raise-exit}))))]])\n144\t\n145\t\n146\t(def ^:private public-exports\n147\t  '#{entry eligible? invocation invocation-with valid-invocation? condition\n148\t     thrown transfer invoke invoke-with})\n149\t\n150\t\n151\t(def uast\n152\t  \"The bundled definitions, in source order and tail marked.\"\n153\t  (u/mark-tails\n154\t    (reduce (fn [ast [key form]]\n155\t              (u/then ast (u/def! key (u/sexp->uast form))))\n156\t            (u/def! (ffirst definitions)\n157\t                    (u/sexp->uast (second (first definitions))))\n158\t            (rest definitions))))\n159\t\n160\t\n161\t(def module-uast\n162\t  \"The linked module tree built from the same `definitions`.\"\n163\t  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n164\t                                          [] definitions)]\n165\t    (core/module-tree stripped [])))\n166\t\n167\t\n168\t(def module-exports\n169\t  \"Public module exports (private helper definitions stay internal).\"\n170\t  public-exports)\n171\t\n172\t\n173\t(def ^:private module-free-names\n174\t  (core/free-name-vec module-uast))\n175\t\n176\t\n177\t(defn module-spec\n178\t  \"The linker module spec for `yang.call` over `registry`.\"\n179\t  [registry]\n180\t  (core/module-spec {:module-name module-name\n181\t                     :ast module-uast\n182\t                     :exports module-exports\n183\t                     :requires {}\n184\t                     :free-names module-free-names\n185\t                     :registry registry\n186\t                     :message \"the yang.call module reads an undeclared name\"\n187\t                     :refusal-ns \"yang.call\"}))"}
