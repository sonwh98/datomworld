                              (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n1226\t                                            (u/lit :clj/outcome) condition->outcome))\n1227\t                              :tail? true))\n1228\t          common-call (u/let1\n1229\t                        result\n1230\t                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n1231\t                               (u/lit []) raise)\n1232\t                        (outcome-node ok-tag (u/v result)))\n1233\t          refused (outcome-node\n1234\t                    error-tag\n1235\t                    (u/app (u/v 'yang.call/condition)\n1236\t                           (u/lit :yang.call/not-callable)\n1237\t                           (u/app (u/v 'dsg__assoc) (u/lit {})\n1238\t                                  (u/lit :yang.call/callee) (u/v callee))))\n1239\t          activation (u/if-node\n1240\t                       (u/app (u/v 'data/callable?) (u/v escape))\n1241\t                       common-call\n1242\t                       ;; Applying the escape resumes the capture operand.\n1243\t                       ;; Only our authenticated transfer packet may resume\n1244\t                       ;; here; an invalid captured value explicitly refuses.\n1245\t                       (u/if-node\n1246\t                         (u/app (u/v 'dsg__equal)\n1247\t                                (u/app (u/v 'dsg__get) (u/v escape)\n1248\t                                       (u/lit :clj/escape-token))\n1249\t                                (u/v 'dsg__call_token))\n1250\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\n1251\t                         (outcome-node\n1252\t                           error-tag\n1253\t                           (u/app (u/v 'yang.call/condition)\n1254\t                                  (u/lit :yang.call/invalid-invocation)\n1255\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))