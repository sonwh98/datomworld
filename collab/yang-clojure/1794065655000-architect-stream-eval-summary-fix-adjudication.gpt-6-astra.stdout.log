:type :closure}\" \"55\"\n    12\t        \"before\\n42\" \"Switched to :yang/php\" \"3\" \"Switched to :yang/clojure\"\n    13\t        {:re \".* reset\"} \"5\"]\n    14\t  :exit 0 :quit :typed}\n    15\t {:id :index-publication\n    16\t  :in [\"(require (quote dao.space.query))\" \"(def j3alpha 1001)\"\n    17\t       \"(dao.space.query/q (quote [:find ?v . :where [?e :yin/value 1001] [?e :yin/value ?v]]))\"\n    18\t       \"(repl-state)\"]\n    19\t  :out [\"'dao.space.query\" \"1001\" \"1001\"\n    20\t        {:re \"(?s).*:index\\\\s+.*:published\\\\? true.*\"}]\n    21\t  :exit 0 :quit :eof}\n    22\t {:id :pending-abandon\n    23\t  :in [\"(require (quote j3nosuch))\" \"(abandon)\" \"(+ 1 2)\"]\n    24\t  :out [{:re \"(?s);; require pending: j3nosuch \\\\(link .*\\\\); lines typed meanwhile run when it completes, \\\\(abandon\\\\) gives up\"}\n    25\t        {:re \"(?s).*abandoned.*\"} \"3\"]\n    26\t  :idle-ms 450 :exit 0 :quit :typed}\n    27\t {:id :pending-eof :in [\"(require (quote j3nosuch))\"]\n    28\t  :out [{:re \"(?s);; require pending: j3nosuch \\\\(link .*\"}]\n    29\t  :idle-ms 450 :exit 0 :quit :eof}\n    30\t {:id :empty-eof :in [] :out [] :exit 0 :quit :eof}\n    31\t {:id :empty-eof-warm :in [] :out [] :exit 0 :quit :eof}\n    32\t {:id :open-stdin-quit :in [] :out [] :exit 0 :quit :typed}\n    33\t {:id :python\n    34\t  :in [\"(lang :yang/python)\"]\n    35\t  :out [\"Switched to :yang/python\"]\n    36\t  :exit 0 :quit :typed}\n    37\t {:id :python-eval\n    38\t  :in [\"(lang :yang/python)\" \"1 + 2\" \"x = 40\" \"x + 2\" \"print(\\\"h\\u00e9llo\\\")\"]\n    39\t  :out [\"Switched to :yang/python\" \"3\" \"\" \"42\" \"h\\u00e9llo\"]\n    40\t  :exit 0 :quit :typed}\n    41\t {:id :bigint-reader :in [\"(quote 5N)\"]\n    42\t  :out [{:jvm \"5N\" :jolt \"5\"}]\n    43\t  :jolt-divergence {:owner :jolt-lang :reason \"small bigint N carrier/printing\"}\n    44\t  :exit 0 :quit :typed}\n    45\t {:id :surrogate-reader :in [\"\\\"\\\\uD800\\\"\"]\n    46\t  :out [{:jvm \"Error: dao.jing.cbor refused: unpaired-surrogate (unpaired high surrogate at 0)\" :jolt \"Error: Invalid character constant: lone surrogate \\\\u escape\"}]\n    47\t  :jolt-divergence {:owner :jolt-lang :reason \"lone surrogate escape reader refusal\"}\n    48\t  :exit 0 :quit :typed}\n    49\t {:id :help :args [\"--help\"] :startup-only true\n    50\t  :out {:re \"(?s).*--codec.*--vm.*\"} :exit 0}\n   197\t`:index-recovery` on the shell state, and the shell installs it before\n   198\tit admits any evaluation (`yin.repl.index/rehydrate`). The indexer's\n   199\tlog becomes a fresh complete-retention memory log holding the recovered\n   200\tdatoms as transaction records, one per original `t` in ascending order,\n   201\teach datom and its `t` preserved, so the round's transactor keeps\n   202\tderiving the next `t` from it. Entity allocation resumes one past the\n   203\tgreatest restored entity or metadata id (never below\n   204\t`datom/first-user-id`), so restored and new ids never collide. The\n   205\trecovered manifest is the indexer's published one and its transaction\n   206\tcounts are the restored ones, so `q` answers the previous run's facts\n   207\tbefore any new evaluation, and the first publication after a restart\n   208\tcovers old and new facts — HEAD moves to a manifest holding both.\n   209\t\n   210\tEvery process start mints a new shell token. Restored facts keep their\n   211\toriginal session tokens and root and round metadata, since they are the\n   212\tdatoms as committed; new facts carry the new token, so `q` over the\n   213\thistory view tells the runs apart.\n   214\t\n   215\tWith a durable store, `(reset)` and VM selection rebuild the VM, the\n   216\texpander, and their observers, but the new indexer continues the old\n   217\tone's log, entity allocation, counts, and published manifest\n   218\t(`yin.repl.index/carry-over`): they never reset `t` or entity\n","exit_code":0,"status":"completed"}}
