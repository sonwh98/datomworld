ding [r/*alias-map* aliases\n              *ns* (the-ns (create-ns declared-name))]\n      (loop [acc []]\n        (let [form (r/read {:read-cond :allow :features #{:clj} :eof ::eof} pr)]\n          (if (= form ::eof) acc (recur (conj acc form))))))))\n\n\n(def ^:private all-forms\n  (into {} (map (fn [ns-sym] [ns-sym (read-forms ns-sym)])\n                (distinct (map :ns manifest)))))\n\n\n(def ^:private top-forms\n  (into {} (map (fn [{:keys [ns kind name]}]\n                  [[ns name] (first (filter #(and (seq? %)\n                                                  (= kind (first %))\n                                                  (= name (second %)))\n                                            (get all-forms ns)))]))\n        manifest))\n\n\n(def ^:private scanned-symbols\n  #{'loop 'recur 'case 'throw 'ex-info 'atom 'swap! 'reset! 'lazy-seq 'gensym\n    'apply 'comp 'partial 'reduced 'reduce 'map 'mapv 'filter 'remove 'into\n    'concat 'merge 'str 'symbol 'keyword 'vector 'seq 'nth 'nthnext 'assoc-in\n    'count 'name 'when-let 'if-let 'when-some 'if-some 'cond})\n\n\n(defn- walk-symbols\n  [form]\n  (cond\n    (seq? form) (if (and (= 'quote (first form)) (= 2 (count form)))\n                  #{}\n                  (mapcat walk-symbols form))\n    (vector? form) (mapcat walk-symbols form)\n    (map? form) (mapcat walk-symbols (concat (keys form) (vals form)))\n    (set? form) (mapcat walk-symbols form)\n    (symbol? form) (if (namespace form) #{} #{form})\n    :else #{}))\n\n\n(defn- destructuring?\n  [binding]\n  (not (symbol? binding)))\n\n\n(defn- classify-form\n  [form]\n  (let [[kind _name & body-ops] form\n        fs (atom (into #{} (walk-symbols form)))]\n    (when (and (= 'defn kind) (seq body-ops))\n      (let [second-op (first body-ops)]\n        (cond\n          (seq? second-op) (swap! fs conj :multi-arity)\n          (not (vector? second-op)) (swap! fs conj :docstring)\n          :else (when (some destructuring? second-op)\n                  (swap! fs conj :destructuring)))))\n    (when (and (= 'defn kind) (vector? (first body-ops)))\n      ;; loop/recur inside the params+body\n      (when (some #(contains? % 'recur) (map #(into #{} (walk-symbols %)) (clojure.core/rest body-ops)))\n        (swap! fs conj :recur)))\n    (when (contains? @fs 'loop) (swap! fs conj :loop))\n    (set (filter #(or (contains? scanned-symbols %) (keyword? %)) @fs))))\n\ntest/yang/clojure_test.clj:654:  \"The ex-data of the exception running `forms` raises, or nil.\"\ntest/yang/latte_oracle_test.clj:8:   Adaptations, operation sequences and scope departures live beside the\ntest/yang/latte_oracle_test.clj:531:   stack trace is never compared).\"\ntest/yang/latte_oracle_test.clj:539:  \"The outcome `c` is the A leg's value as a success or its exception as the\ntest/yang/latte_oracle_test.clj:1659:          ;; Observer exceptions attach the entire host VM as :session. It is\ntest/yang/latte_oracle_test.clj:1666:          :exception (str (class e))})))\ntest/yang/latte_oracle_test.clj:1975:                       (= \"class java.lang.IllegalStateException\" (:exception a))\ntest/yang/latte_oracle_test.clj:1985:                       (= \"class java.lang.IllegalArgumentException\" (:exception a) (:exception b))\ntest/yang/latte_oracle_test.clj:1991:               :reason \"Scalar proof step raises a native sequence exception upstream and a portable sequence refusal in C; no agreement is claimed.\"})\ntest/yang/latte_oracle_test.clj:2056:                          :blocked-by (if-let [n (get-in compiled [:data :name])] [n] [:compiler-exception])\ntest/yang/latte_oracle_test.clj:2150:       :reason \"Host stack traces have no portable error-data representation; the compiler refuses the accessor.\"}]\ndocs/design/yang.antlr.md:1221:collections, language exceptions, argument binding, and other\ndocs/design/yang.antlr.md:1286:- Language exceptions and cleanup behavior.\ndocs/design/yang.antlr.md:1333:  injected exceptions: the generator