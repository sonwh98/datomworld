eftest test-update-def-uses\n  (is (= (update-def-uses dfuses5 '<b> (:parsed-term (second (defenv/fetch-definition def-env6 '<b>))))\n         '{<a> #{<b>}})))\n\n(deftest test-elab-have\n  ;; Step 5 : [:have <a> (==> A B) f]\n  ;; local-defs={<a>:=f::(==> A B)}\n  ;; ctx=[[x A] [f (==> A B)] [B *] [A *]]\n  ;; var-deps=[[x #{}][f #{<a>}][B #{<a>}] [A #{<a>}]]  def-uses={<a> #{}}\n\n  (is (= ctx5 ctx4))\n\n  (is (defenv/registered-definition? def-env5 '<a>))\n\n  (is (= (second(defenv/fetch-definition def-env5 '<a> true))\n         '#latte_kernel.defenv.Definition{:name <a>, :params [], :arity 0, :parsed-term f, :term-free-vars #{f}, :type (Π [⇧ A] B), :opts {}}))\n\n  (is (= vdeps5\n         '[[x #{<a>}] [f #{<a>}] [B #{<a>}] [A #{<a>}]]))\n\n  (is (= dfuses5\n         '{<a> #{}}))\n\n  ;; Step 6 : [:have <b> B (<a> x)]\n  ;; local-defs={<a>:=f::(==> A B)\n  ;;             <b>:=(<a> x)::B}\n  ;; ctx=[[x A] [f (==> A B)] [B *] [A *]]\n  ;; var-deps=[[x #{<b>}][f #{<a>}][B #{<a>,<b>}] [A #{<a>}]]  def-uses={<a> #{<b>}, <b> #{}}\n  (is (= ctx6 ctx5))\n\n  (is (defenv/registered-definition? def-env6 '<a>))\n  (is (defenv/registered-definition? def-env6 '<b>))\n\n  (is (= (second(defenv/fetch-definition def-env6 '<b> true))\n         '#latte_kernel.defenv.Definition{:name <b>, :params [], :arity 0, :parsed-term [(<a>) x], :term-free-vars #{x f}, :type B, :opts {}}))\n\n  (is (= vdeps6\n         '[[x #{<a> <b>}] [f #{<a> <b>}] [B #{<a> <b>}] [A #{<a> <b>}]]))\n\n  (is (= dfuses6\n         '{<a> #{<b>}, <b> #{}})))\n\n\n\n(deftest test-abstract-local-defs\n  (is (= (:params (second (defenv/fetch-definition (abstract-local-def def-env6 '<b> 'x 'A) '<b>)))\n         '[[x A]])))\n\n(deftest test-gen-local-calls\n  (is (= (gen-local-calls (second (parse/parse-term def-env5 '[(<a>) x])) '#{<a>} 'f)\n         '[(<a> f) x])))\n\n\n(let [state7 (elab-discharge def-env6 ctx6 vdeps6 dfuses6 'x {})\n      [def-env7 ctx7 vdeps7 dfuses7] state7]\n  (def def-env7 def-env7)\n  (def ctx7 ctx7)\n  (def vdeps7 vdeps7)\n  (def dfuses7 dfuses7))\n\n(let [state8 (elab-discharge def-env7 ctx7 vdeps7 dfuses7 'f {})\n      [def-env8 ctx8 vdeps8 dfuses8] state8]\n  (def def-env8 def-env8)\n  (def ctx8 ctx8)\n  (def vdeps8 vdeps8)\n  (def dfuses8 dfuses8))\n\n(let [state9 (elab-discharge def-env8 ctx8 vdeps8 dfuses8 'B {})\n      [def-env9 ctx9 vdeps9 dfuses9] state9]\n  (def def-env9 def-env9)\n  (def ctx9 ctx9)\n  (def vdeps9 vdeps9)\n  (def dfuses9 dfuses9))\n\n(let [state10 (elab-discharge def-env9 ctx9 vdeps9 dfuses9 'A {})\n      [def-env10 ctx10 vdeps10 dfuses10] state10]\n  (def def-env10 def-env10)\n  (def ctx10 ctx10)\n  (def vdeps10 vdeps10)\n  (def dfuses10 dfuses10))\n\n1712:(deftest test-case-tail-position\n1721:(deftest test-control-forms\n1774:(deftest test-and-or-generated-names-are-reserved\n1794:(deftest test-case-quoted-constants\n1806:(deftest test-control-form-shape-rejections\n1815:      (is (thrown? clojure.lang.ExceptionInfo\n1823:     (if x x (throw (ex-info \"bad\" {})))))\n1836:(deftest test-outcome-control-forms\n1857:    (is (thrown? clojure.lang.ExceptionInfo\n1861:    (is (thrown? clojure.lang.ExceptionInfo (outcome-ast '[(defn f\n1946:                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n1995:(deftest test-library-closes-over-its-own-names\n2009:(deftest test-library-kind-predicates\n2037:(deftest test-library-sequences\n2062:      (is (thrown-with-msg? clojure.lang.ExceptionInfo #\"would capture\"\n2074:(deftest test-library-higher-order\n2101:(deftest test-library-sequence-shapes-and-downstream-operations\n2126:(deftest test-library-collections-carry-guest-closures-and-metadata\n2147:(deftest test-library-rest-does-not-capture-compiler-destructuring\n2164:(deftest test-library-failures-flow-through-closures\n2166:        g '(fn [x] (if (= x 2) (throw (ex-info \"bad two\" {:x x})) x))]\n2174:(deftest test-apply\n2192:    (is (thrown? clojure.lang.ExceptionInfo\n2196:(deftest test-