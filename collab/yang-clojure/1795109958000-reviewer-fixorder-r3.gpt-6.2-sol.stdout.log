rovenance-digest \"400fb0330d5f6cc2b8cd7d1130a59e39fcf7d523fab591a44febbc80a44d1322\"} {:root :segment/blake3-1b6d5066c9a1c5e775e8593dd5b9edc9ed7066f17b6b1b6eaca7a4b029d50257, :applications 2, :keys-digest \"12c663e7bc86f7575ca4fad9db5b293b264c385abbde056cda41e7746446f8b4\", :c1-digest \"1f8ec739aeaf406d49c0d967e2c51bea0a3716c4e7fff8b73986fd72a693ea5b\", :instruction-provenance-digest \"98af0791307867ad15cafa2d51cc2fdade133931f436dc41d067d37031bc6f6e\"} {:root :segment/blake3-f14aca0ed5dbfc059fe5c60511e45fb2cf4c1d389891a6787af39ee2d71532a0, :applications 2, :keys-digest \"f9a0772ba9d59b89a0c653e87a0d4ebde0e8939e1c5ac96318ad5a56961b3cdf\", :c1-digest \"782125b41bcdca21c6e39a882d1ac00b6d7fa0e98d745b980973e349e648f591\", :instruction-provenance-digest \"d9419508fb92d2a8bd2fc3e8c16aff88fdb4d63045ee2bbee5340e03c399c899\"} {:root :segment/blake3-1b6d5066c9a1c5e775e8593dd5b9edc9ed7066f17b6b1b6eaca7a4b029d50257, :applications 2, :keys-digest \"12c663e7bc86f7575ca4fad9db5b293b264c385abbde056cda41e7746446f8b4\", :c1-digest \"1f8ec739aeaf406d49c0d967e2c51bea0a3716c4e7fff8b73986fd72a693ea5b\", :instruction-provenance-digest \"98af0791307867ad15cafa2d51cc2fdade133931f436dc41d067d37031bc6f6e\"}]))\ncollab/yang-clojure/1795028800000-fixorder-evidence/fixorder-jvm-order-RED.log:396832:  actual: (not (every? #object[yang.clojure_collection_order_test$fn__18079$fn__18192$fn__18200$fn__18225$fn__18226 0x920822e \"yang.clojure_collection_order_test$fn__18079$fn__18192$fn__18200$fn__18225$fn__18226@920822e\"] [{:type :application, :operator {:type :variable, :name assoc}, :operands [{:type :literal, :value {}} {:type :literal, :value true} {:type :literal, :value 5} {:type :literal, :value [1 2]} {:type :literal, :value 3} {:type :literal, :value nil} {:type :literal, :value 6} {:type :variable, :name sym} {:type :literal, :value 2} {:type :literal, :value \"str\"} {:type :literal, :value 1} {:type :literal, :value 3} {:type :literal, :value 1.5} {:type :literal, :value :kw} {:type :app