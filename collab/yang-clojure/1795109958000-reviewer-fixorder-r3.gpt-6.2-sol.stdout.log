hich is integer content\n   whose value is already rounded (callers refuse it); never a JS -0.\"\n  [x]\n  (or (integer/exact-integer? x)\n      #?(:cljs (and (number? x) (js/Number.isInteger x)\n                    (not (js/Number.isSafeInteger x)))\n         :default false)))\n\n\n(defn float64?\n  \"True for floating-point content: Double or Float on the JVM, the\n   Float64 carrier or a non-integral, non-finite or negative-zero number\n   on JavaScript, a double on Dart.\"\n  [x]\n  #?(:cljd (dart/is? x double)\n     :clj (or (instance? Double x) (instance? Float x))\n     :cljs (or (instance? number/Float64 x)\n               (and (number? x) (not (host-integer? x))))))\n\n\n(defn decimal?\n  \"True for decimal content: BigDecimal on the JVM, the Decimal carrier on\n   JavaScript and Dart.\"\n  [x]\n  (number/decimal? x))\n\n\n(defn ratio?\n  \"True for rational content: clojure.lang.Ratio or the Rational carrier.\"\n  [x]\n  (number/ratio? x))\n\n\n(defn numeric?\n  \"True for every value the portable numeric operations accept.\"\n  [x]\n  (or (host-integer? x) (float64? x) (decimal? x) (ratio? x)))\n\n\n(defn float64\n  \"Floating-point content with the value of host number x: a Double on\n   the JVM, the Float64 carrier on JavaScript (so integral floats such as\n   1.0 keep their kind).\"\n  [x]\n  (number/float64-of x))\n\n\n  1520\t(deftest corpus-cross-host-reference-test\n  1521\t  \"B3: every host compiles the broader corpus's canonical constructions to\n  1522\t   the SAME recorded reference -- root, full C1/key vectors and per-format\n  1523\t   provenance -- so corpus equality is a cross-host replay gate, not a\n  1524\t   within-host property. The permutation/representation checks above stay\n  1525\t   as additional properties.\"\n  1526\t  (let [actual (into {}\n  1527\t                     (map (fn [[case snapshot]] [case (dissoc snapshot :case)]))\n  1528\t                     (concat\n  1529\t                       (map (fn [[label entries]]\n  1530\t                              [(keyword (name label))\n  1531\t                               (compile-snapshot (build-map :array-map entries))])\n  1532\t                            map-corpus)\n  1533\t                       (map (fn [[label elements]]\n  1534\t                              [(keyword (name label))\n  1535\t                               (compile-snapshot (build-set :vec-set elements))])\n  1536\t                            set-corpus)\n  1537\t                       (mapcat (fn [n]\n  1538\t                                 [[(keyword (str \"map-\" n))\n  1539\t                                   (compile-snapshot (build-map :array-map\n  1540\t                                                                (sized-map-entries n)))]\n  1541\t                                  [(keyword (str \"set-\" n))\n  1542\t                                   (compile-snapshot (build-set :vec-set\n  1543\t                                                                (sized-set-elements n)))]])\n  1544\t                               map-corpus-sizes)))]\n  1545\t    (is (= (count corpus-reference) (count actual) 18))\n  1546\t    (doseq [{:keys [case] :as expected} corpus-reference]\n  1547\t      (testing (str case)\n  1548\t        (is (= expected (assoc (get actual case) :case case))\n2026-11-19 17:42:50 GMT\n2026-11-20 00:42:50 Asia/Ho_Chi_Minh\n","exit_code":0,"status":"completed"}}
