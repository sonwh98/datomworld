'dsg__raise_escape)\n+                                                    (u/app (u/v 'dsg__assoc) (u/lit {})\n+                                                           (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n+                                                           (u/lit :clj/outcome) condition->outcome))\n+                                             :tail? true)))\n+                             (outcome-node ok-tag (u/v (symbol (str reserved-prefix \"invoker_result\")))))\n+                           (u/if-node\n+                             (u/app (u/v 'dsg__equal)\n+                                    (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n+                                           (u/lit :clj/escape-token))\n+                                    (u/v 'dsg__call_token))\n+                             (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n+                             (outcome-node\n+                               error-tag\n+                               (u/app (u/v 'yang.call/condition)\n+                                      (u/lit :yang.call/invalid-invocation)\n+                                      (u/lit {:yang.call/reason :missing-raise-exit}))))))\n+                       u/capture)\n+          routed (if (::invoker env)\n+                   (u/if-node\n+                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n+                                (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n+                                (u/lit false))\n+                     admitted\n+                     value-call)\n+                   admitted)]\n       (cond-> (u/mark-tails (u/let1 callee callee-ast\n-                                    (u/let1 arguments arguments-ast admitted)))\n+                                    (u/let1 arguments arguments-ast routed)))\n         tail? (assoc :tail? true)))))\n \n \n@@ -1354,12 +1398,6 @@\n              :operands (mapv #(compile-form % false env macro-env) operands)}\n       tail? (assoc :tail? true))\n \n-    ;; The guest library supplies collection invocation. The apply intrinsic\n-    ;; in invoke-value is the raw closure call, so this never wraps itself.\n-    (and (::invoker env)\n-         (or (contains? (locals env) operator) (not (symbol? operator))))\n-    (compile-av-application 'invoke-value [operator (vec operands)] env tail? macro-env)\n-\n     ;; anything else: one guest invocation, in tail position when the call is\n     :else\n     (compile-guest-call (compile-form operator false env macro-env)\n@@ -1931,6 +1969,7 @@\n                                  :macros (set (:macros opts))}\n                    ::defined defined\n                    ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n+                                                  (= 'invoke-value (second %))\n                                                   (:yin.k/invoker (meta (second %)))) forms))}\n             (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n \n@@ -2216,11 +2255,10 @@\n       (or (= x true) (= x false)))\n     (defn fn?\n       [x]\n-      (data/callable? x))\n+      (if (data/callable? x) true (yang.call/eligible? x)))\n     (defn ^:yin.k/invoker invoke-value\n       [f args]\n       (cond\n-        (data/callable? f) (apply f args)\n         (vector? f) (if (= 1 (count args)) (nth f (first args))\n                         (throw (ex-info \"Vector invocation requires one index\" {:argc (count args)})))\n         (or (map? f) (keyword? f))\n@@ -2231,7 +2269,11 @@\n         (set? f) (if (= 1 (count args))\n                    (if (contains? f (first args)) (first args) nil)\n                    (throw (ex-info \"Set invocation requires one key\" {:argc (count args)})))\n-        :else (apply f args)))\n+        ;; Everything unsupported - a scalar, a raw closure the convention\n+        ;; never published, a forged shape that slipped past the call-site\n+        ;; routing - refuses as the admission path would. No apply here: a\n+        ;; guest apply would re-enter the call-site dispatcher and recurse.\n+        :else (throw (yang.call/condition :yang.call/not-callable {:yang.call/callee f}))))\n     (defn update\n       ([m k f] (assoc m k (f (get m k))))\n       ([m k f a] (assoc m k (f (get m k) a)))\ndiff --git a/test/yang/clojure_test.clj b/test/yang/clojure_test.clj\nindex 8697c5dd..dde5bcbc 100644\n--- a/test/yang/clojure_test.clj\n+++ b/test/yang/clojure_test.clj\n@@ -2281,3 +2281,51 @@\n              library-opts lane 1000000))))\n   (is (= [:yin.k/ok :caught]\n          (run-library '[(try (let [v [1]] (v)) (catch Exception e :caught))]))))\n+\n+(deftest test-value-invocation-refusals-are-terminating\n+  (testing \"entry-absent callees refuse through the library invoker instead of\n+            re-entering the dispatcher; the vector binder only forces the\n+            invoker into the library so the routing is actually exercised\"\n+    (doseq [lane [:walker :semantic]]\n+      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n+                            :yang.call/data {:yang.call/callee 5}}]\n+             (run-library '[(let [five 5 v [five]] (five 1))]\n+                          library-opts lane 1000000))\n+          \"a scalar callee terminates as not-callable\")\n+      (let [[tag _] (run-library\n+                      '[(defn f [x] x)\n+                        (let [e yang.call/entry v [e]] (e f))]\n+                      library-opts lane 1000000)]\n+        (is (= :yin.k/ok tag)\n+            \"a module fn is an admitted descriptor: the call goes through admission\"))\n+      (let [[tag payload] (run-library\n+                            '[(defn f [x] x)\n+                              (let [raw (yang.call/entry f) v [raw]] (raw {}))]\n+                            library-opts lane 1000000)]\n+        (is (= :yin.k/error tag) \"a projected raw closure terminates\")\n+        (is (= :yang.call/not-callable (:yang.call/reason payload))\n+            \"a raw closure keeps the adoption's refusal\"))\n+      (doseq [entry [nil false]]\n+        (let [[tag payload] (run-library\n+                              [(list 'let ['m {:yang.call/entry entry :x 42} 'v '[m]]\n+                                     '(m :x))]\n+                              library-opts lane 1000000)]\n+          (is (= :yin.k/error tag) (str \"a \" (pr-str entry) \" entry is present, not absent\"))\n+          (is (= :yang.call/not-callable (:yang.call/reason payload))\n+              (str \"a \" (pr-str entry) \" entry reaches admission and refuses\"))))\n+      (let [tail-run (run-library\n+                       '[(defn tail-refusal []\n+                           (let [five 5 v [five]] (five 1)))\n+                         (tail-refusal)]\n+                       library-opts lane 1000000)]\n+        (is (= :yang.call/not-callable\n+               (:yang.call/reason (second tail-run)))\n+            \"the refusal survives a tail-position value call\"))\n+      (doseq [[where form] [[1 '(five (boom) 2)] [2 '(five 1 (boom))]]]\n+        (let [[tag payload] (run-library\n+                              ['(defn boom [] (throw (ex-info \"boom\" {})))\n+                               (list 'let '[five 5 v [five]] form)]\n+                              library-opts lane 1000000)]\n+          (is (= :yin.k/error tag) (str \"operand \" where \" errors before the refusal\"))\n+          (is (= \"boom\" (:yin.k/message payload))\n+              (str \"operand \" where \" is evaluated before the callee check\")))))))\n","exit_code":0,"status":"completed"}}
