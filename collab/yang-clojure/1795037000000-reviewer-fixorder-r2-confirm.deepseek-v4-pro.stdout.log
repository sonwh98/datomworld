{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01_ET_LIvTADCWS6rHvPEgDzHp5378","type":"tool_result","content":"533\t    (let [form (assoc {} ##NaN (list '+ 'n 0) ##NaN (list '+ 'n 0))\n534\t          ctor (last (map-constructors (yang/compile form)))\n535\t          pairs (pair-keys ctor)]\n536\t      (is (= 2 (count pairs)))\n537\t      (is (= (first pairs) (second pairs)))\n538\t      (is (= 5 (count (:operands ctor))) \"seed plus both pair occurrences\")))\n539\t  (testing \"identical compiled set elements tie without occurrence loss\"\n540\t    ;; two NaN elements are host-unequal (a NaN is never = to itself) and\n541\t    ;; compile to one quiet-NaN row, so they are the whole-element tie.\n542\t    ;; Retention is per constructor, not a map-vs-set difference: on the\n543\t    ;; JVM, into over exactly the NaN pair keeps both (a persistent conj\n544\t    ;; chain collapses them under Java equals, and one transient session\n545\t    ;; that also mixes in a seq element loses one -- the r2 findings\n546\t    ;; record the probe), so the pair is built and finalized before the\n547\t    ;; dynamic element joins. That element is what keeps the set off the\n548\t    ;; constant fast path so it reaches the emitter at all. On Node and\n549\t    ;; Dart no constructor collapses the pair (= is === / Dart ==, and\n550\t    ;; NaN never equals itself there).\n551\t    (let [nan-key [(root-of (yang/compile-form ##NaN false {}))]\n552\t          form (conj (into #{} [##NaN ##NaN]) (list '+ 'n 0))\n553\t          ctor (first (collection-applications (yang/compile form)))\n554\t          keys (element-keys ctor)]\n555\t      (is (= 3 (count keys)) (str \"both NaN occurrences survive: \" (count keys)))\n556\t      (is (= 2 (count (filter #(= nan-key %) keys)))\n557\t          \"the tied element root appears exactly twice, not deduplicated\")\n558\t      (is (= 1 (count (distinct (remove #(= nan-key %) keys))))\n559\t          \"the third, distinct occurrence is retained beside the tie\")\n560\t      (is (= (vec (sort jing/canonical-compare keys)) (vec keys))\n561\t          \"the element vector equals its own non-descending sort: the tied\n562\t           roots sit adjacent and nothing is reordered around them\")\n563\t      (is (= 4 (count (:operands ctor))) \"seed plus all three occurrences\")))\n564\t  (testing \"distinct dynamic set elements keep their compiled occurrences\"\n565\t    (let [inner (list '+ 'n 0)\n566\t          form #{inner (list '+ 'n 1)}\n567\t          ctor (first (collection-applications (yang/compile form)))\n568\t          keys (element-keys ctor)]\n569\t      (is (= 2 (count keys)))\n570\t      (is (strictly-ascending? keys))\n571\t      (is (= 3 (count (:operands ctor))))))\n572\t  (testing \"source-position and node metadata never choose the order\"\n573\t    (let [plain {:a (list '+ 'n 1), :b (list '+ 'n 2)}\n574\t          positioned (with-meta plain {:line 3 :column 4 :end-line 3 :end-column 9})\n575\t          noted (with-meta plain {:note :source-form})\n576\t          value-meta {(with-meta (list '+ 'n 1) {:line 8}) :a\n577\t                      (list '+ 'n 2) :b}\n578\t          snap (fn [f] (compile-snapshot f))\n579\t          ctor-roots (fn [f] (child-roots (first (map-constructors (yang/compile f)))))]\n580\t      (is (= (snap plain) (snap positioned)))\n581\t      (is (= (snap plain) (snap noted)))\n582\t      (is (= (ctor-roots plain) (ctor-roots positioned)))"}]},"parent_tool_use_id":null,"session_id":"024a2da5-c785-45c9-991b-d9d054578146","uuid":"d39af588-05e5-40ac-a399-1088c33d8633","timestamp":"2026-11-18T20:42:56.615Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_collection_order_test.cljc","content":"    (let [form (assoc {} ##NaN (list '+ 'n 0) ##NaN (list '+ 'n 0))\n          ctor (last (map-constructors (yang/compile form)))\n          pairs (pair-keys ctor)]\n      (is (= 2 (count pairs)))\n      (is (= (first pairs) (second pairs)))\n      (is (= 5 (count (:operands ctor))) \"seed plus both pair occurrences\")))\n  (testing \"identical compiled set elements tie without occurrence loss\"\n    ;; two NaN elements are host-unequal (a NaN is never = to itself) and\n    ;; compile to one quiet-NaN row, so they are the whole-element tie.\n    ;; Retention is per constructor, not a map-vs-set difference: on the\n    ;; JVM, into over exactly the NaN pair keeps both (a persistent conj\n    ;; chain collapses them under Java equals, and one transient session\n    ;; that also mixes in a seq element loses one -- the r2 findings\n    ;; record the probe), so the pair is built and finalized before the\n    ;; dynamic element joins. That element is what keeps the set off the\n    ;; constant fast path so it reaches the emitter at all. On Node and\n    ;; Dart no constructor collapses the pair (= is === / Dart ==, and\n    ;; NaN never equals itself there).\n    (let [nan-key [(root-of (yang/compile-form ##NaN false {}))]\n          form (conj (into #{} [##NaN ##NaN]) (list '+ 'n 0))\n          ctor (first (collection-applications (yang/compile form)))\n          keys (element-keys ctor)]\n      (is (= 3 (count keys)) (str \"both NaN occurrences survive: \" (count keys)))\n      (is (= 2 (count (filter #(= nan-key %) keys)))\n          \"the tied element root appears exactly twice, not deduplicated\")\n      (is (= 1 (count (distinct (remove #(= nan-key %) keys))))\n          \"the third, distinct occurrence is retained beside the tie\")\n      (is (= (vec (sort jing/canonical-compare keys)) (vec keys))\n          \"the element vector equals its own non-descending sort: the tied\n           roots sit adjacent and nothing is reordered around them\")\n      (is (= 4 (count (:operands ctor))) \"seed plus all three occurrences\")))\n  (testing \"distinct dynamic set elements keep their compiled occurrences\"\n    (let [inner (list '+ 'n 0)\n          form #{inner (list '+ 'n 1)}\n          ctor (first (collection-applications (yang/compile form)))\n          keys (element-keys ctor)]\n      (is (= 2 (count keys)))\n      (is (strictly-ascending? keys))\n      (is (= 3 (count (:operands ctor))))))\n  (testing \"source-position and node metadata never choose the order\"\n    (let [plain {:a (list '+ 'n 1), :b (list '+ 'n 2)}\n          positioned (with-meta plain {:line 3 :column 4 :end-line 3 :end-column 9})\n          noted (with-meta plain {:note :source-form})\n          value-meta {(with-meta (list '+ 'n 1) {:line 8}) :a\n                      (list '+ 'n 2) :b}\n          snap (fn [f] (compile-snapshot f))\n          ctor-roots (fn [f] (child-roots (first (map-constructors (yang/compile f)))))]\n      (is (= (snap plain) (snap positioned)))\n      (is (= (snap plain) (snap noted)))\n      (is (= (ctor-roots plain) (ctor-roots positioned)))","numLines":50,"startLine":533,"totalLines":1095}},"tool_result_meta":[{"id":"call_01_ET_LIvTADCWS6rHvPEgDzHp5378","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
