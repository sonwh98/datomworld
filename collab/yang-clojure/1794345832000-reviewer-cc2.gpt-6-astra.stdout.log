{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '1,260p'\"","aggregated_output":"     1\t(ns yin.vm.linker.publish\n     2\t  \"Publish a complete four-format module closure into a DaoJing handle,\n     3\t   derive a module from indexed code (docs/design/yin.vm.linker.dht.md\n     4\t   5.3), and sign the name envelopes that bind it (6.1, 6.5, 6.6).\"\n     5\t  (:require [dao.jing :as jing]\n     6\t            [dao.space.query :as query]\n     7\t            [yin.vm :as vm]\n     8\t            [yin.vm.semantic.code :as code]\n     9\t            [yin.vm.debruijn-code :as dcode]\n    10\t            [yin.vm.debruijn-register-code :as rcode]\n    11\t            [yin.vm.semantic.derive :as derive]\n    12\t            [yin.vm.ledger :as ledger]\n    13\t            [yin.vm.semantic.linearize :as linearize]\n    14\t            [yin.vm.linker :as linker]\n    15\t            [yin.vm.linker.closure :as closure]\n    16\t            [yin.vm.linker.requirements :as requirements]\n    17\t            [yin.vm.linker.sign :as sign]))\n    18\t\n    19\t\n    20\t(defn- refusal\n    21\t  [reason data]\n    22\t  (merge {:status :refused :reason reason} data))\n    23\t\n    24\t\n    25\t(defn- definitions\n    26\t  [ast]\n    27\t  (letfn [(scan\n    28\t            [node]\n    29\t            (when (map? node)\n    30\t              (case (:type node)\n    31\t                :lambda #{}\n    32\t                :application\n    33\t                (let [xs (:operands node)\n    34\t                      own (when (and (vm/definition-operator? (:operator node))\n    35\t                                     (= 2 (count xs))\n    36\t                                     (= :literal (:type (first xs)))\n    37\t                                     (symbol? (:value (first xs))))\n    38\t                            #{(:value (first xs))})]\n    39\t                  (into (or own #{}) (mapcat scan)\n    40\t                        (concat (when (= :lambda (:type (:operator node)))\n    41\t                                  [(:body (:operator node))])\n    42\t                                xs)))\n    43\t                #{})))]\n    44\t    (scan ast)))\n    45\t\n    46\t\n    47\t(defn footprint\n    48\t  \"Derive the manifest footprint from tree rows, declared profiles and dependencies.\"\n    49\t  [handle {:keys [ast tree primitives requires]}]\n    50\t  (let [tree (or tree (vm/ast->semantic-bytecode ast))\n    51\t        own (vm/ast-requirements (query/relation (vals (:rows tree))))\n    52\t        bad-primitive (some (fn [[name profile]]\n    53\t                              (when-not (and (map? profile)\n    54\t                                             (keyword? (:yin.k/profile profile))\n    55\t                                             (set? (:yin.k/effects profile)))\n    56\t                                name))\n    57\t                            primitives)\n    58\t        missing (some (fn [[name address]]\n    59\t                        (let [manifest (jing/get handle address ::absent)]\n    60\t                          (when (= ::absent manifest) [name address])))\n    61\t                      requires)]\n    62\t    (cond\n    63\t      (seq (:ffi-ops own))\n    64\t      (refusal :yin.link.publish/ffi-op {:ffi-ops (:ffi-ops own)})\n    65\t\n    66\t      (seq (:parked-ids own))\n    67\t      (refusal :yin.link.publish/parked-id {:parked-ids (:parked-ids own)})\n    68\t\n    69\t      bad-primitive\n    70\t      (refusal :yin.link.publish/unprofiled-primitive\n    71\t               {:primitive bad-primitive})\n    72\t\n    73\t      missing\n    74\t      (refusal :yin.link.publish/missing-requirement\n    75\t               {:name (first missing) :manifest (second missing)})\n    76\t\n    77\t      :else\n    78\t      {:store-keys (:store-keys own)\n    79\t       :effects (into (or (:effects own) #{})\n    80\t                      (concat (mapcat :yin.k/effects (vals primitives))\n    81\t                              (mapcat (fn [address]\n    82\t                                        (get-in (jing/get handle address nil)\n    83\t                                                [:yin.module/footprint :effects]))\n    84\t                                      (vals requires))))})))\n    85\t\n    86\t\n    87\t(def code-formats\n    88\t  \"The four code format records a module manifest links through.\"\n    89\t  [linker/ast-format linker/semantic-format\n    90\t   linker/stack-format linker/register-format])\n    91\t\n    92\t\n    93\t;; =============================================================================\n    94\t;; Call-site occurrence contract C1 (Addendum A, design §2)\n    95\t;; =============================================================================\n    96\t;;\n    97\t;; A module whose frontend finalized its tree (`:yang/call-site 1` on\n    98\t;; every final `:application` occurrence) publishes its frontend-metadata\n    99\t;; side table beside its manifest: the manifest keeps the closed\n   100\t;; schema-1 key set (a manifest address names code, and nothing else),\n   101\t;; so the side table never enters the hashed manifest. The manifest is\n   102\t;; materialized first, and the publication record then names it\n   103\t;; (`:yang.call-site/manifest`), beside the tree root, the publication's\n   104\t;; recorded admission origin, and the table's address — a record names\n   105\t;; a manifest, never the reverse (the site-set precedent,\n   106\t;; `yang.python.antlr.siteset`). Custody of the record and table runs\n   107\t;; through the `publish-module!` result's `:call-sites`, not through\n   108\t;; the module closure: execution never consults C1 tables, so the\n   109\t;; closure walker does not follow them. The publication's origin is an ADMISSION identity\n   110\t;; (design §2.1): a token the composition pins explicitly, draws from\n   111\t;; a composition-owned scope object, or — by default — has derived\n   112\t;; from the publication specification's own durable identity; no\n   113\t;; counter or other mutable state lives in this namespace. The token\n   114\t;; is persisted in the record and retrieved from the record, never\n   115\t;; reconstructed from the tree's content. The publisher\n   116\t;; extracts the markers from the map AST, refuses the\n   117\t;; publication when they do not exactly cover the canonical tree's\n   118\t;; application occurrences — or when a marker's value is not version 1 —\n   119\t;; and otherwise materializes the table and its record into the same\n   120\t;; handle. A module with no markers makes no claim and publishes exactly\n   121\t;; as before.\n   122\t\n   123\t(defn admission-scope\n   124\t  \"An admission scope for `publish-module!`'s `:yin.link.publish/scope`\n   125\t   option. `id` names this publisher — a durable, caller-chosen\n   126\t   identity (a string or keyword) that distinguishes this publisher's\n   127\t   admissions from every other publisher's; a publisher that must not\n   128\t   collide with its own past runs takes a fresh `id` per run. The\n   129\t   returned scope object OWNS the publication ordinal counter, so no\n   130\t   counter lives in this namespace (no hidden global state): two\n   131\t   publications through one scope draw consecutive ordinals, and two\n   132\t   independent scopes publishing identical specifications still yield\n   133\t   distinct admission identities, because their `id`s differ.\"\n   134\t  [id]\n   135\t  {:yin.link.publish/scope-id id\n   136\t   :yin.link.publish/ordinal (atom 0)})\n   137\t\n   138\t(defn- scope-admission-token\n   139\t  \"The admission token a scope object draws for one publication: the\n   140\t   scope's own `id` plus the ordinal the scope's counter assigns. The\n   141\t   counter lives in the caller-owned scope object, never here.\"\n   142\t  [{:yin.link.publish/keys [scope-id ordinal]}]\n   143\t  ;; pr-str keeps the value's full identity — a keyword's namespace, a\n   144\t  ;; string's quoting, a symbol's name — so distinct caller-chosen ids\n   145\t  ;; (:a/publisher, :b/publisher, \"publisher\") never mint the same token\n   146\t  (keyword \"yin.vm.linker.publish.scope\"\n   147\t           (str (pr-str scope-id) \"#\" (swap! ordinal inc))))\n   148\t\n   149\t(defn- spec-admission-token\n   150\t  \"The default admission token: derived deterministically from the\n   151\t   publication specification's own durable identity — the module name\n   152\t   and the content address of its compiled tree — never from hidden\n   153\t   mutable state. Two publications of the same specification therefore\n   154\t   answer the same admission identity (an idempotent re-publication is\n   155\t   the same recorded admission), and distinct specifications never\n   156\t   share one, in this or any other publisher process. A composition\n   157\t   that admits the same specification more than once as separate\n   158\t   admissions passes an `:yin.link.publish/scope` (or an explicit\n   159\t   `:yin.link.publish/admission`) so the admissions stay distinct.\"\n   160\t  [{:keys [name]} tree]\n   161\t  (keyword \"yin.vm.linker.publish.publication\"\n   162\t           (str name \"::\" (:root tree))))\n   163\t\n   164\t(defn- publication-origin\n   165\t  \"The occurrence origin of the publication admission `token` names:\n   166\t   the publisher's own medium, the explicit admission token, member 0.\n   167\t   `token` is the publication's admission identity — the\n   168\t   `:yin.link.publish/admission` option when the composition pins one,\n   169\t   the `:yin.link.publish/scope` option's next drawn token when the\n   170\t   composition scopes the publisher, otherwise the token derived from\n   171\t   the publication specification's own durable identity. The origin is\n   172\t   an admission event's identity, not a function of the tree's content\n   173\t   alone: it is persisted in the side record at publication time and\n   174\t   retrieved from that record; nothing ever reconstructs it from the\n   175\t   root.\"\n   176\t  [token]\n   177\t  [:source :yin.vm.linker.publish/publish token 0])\n   178\t\n   179\t\n   180\t(defn- claims-call-sites?\n   181\t  \"True when map AST `ast` carries the C1 key anywhere. A hit inside a\n   182\t   literal payload is data, not a claim: extraction then finds no\n   183\t   markers and the module publishes unannotated, as it should.\"\n   184\t  [ast]\n   185\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n   186\t\n   187\t\n   188\t(defn- call-site-claim\n   189\t  \"The C1 claim `ast` makes over its canonical `tree`: nil when it\n   190\t   carries no markers; `{:origin o :rows [...]}` in canonical-byte\n   191\t   order (`jing/canonical-compare`) when the extracted markers exactly cover the tree's eligible\n   192\t   application occurrences; `{:missing [...] :extra [...]}` when they\n   193\t   do not; `{:unsupported-version v :path p}` when a marker's value is\n   194\t   not version 1 — a claim rejection, never a silent acceptance of a\n   195\t   table a retriever would read as version 1.\"\n   196\t  [ast tree admission]\n   197\t  (when (claims-call-sites? ast)\n   198\t    (let [origin (publication-origin admission)\n   199\t          extracted (filter #(= :yang/call-site (nth % 3))\n   200\t                            (:frontend-metadata\n   201\t                              (vm/ast-side-tables ast tree origin)))\n   202\t          eligible (into #{}\n   203\t                         (map (fn [[r p]] [origin r p]))\n   204\t                         (vm/application-occurrences tree))\n   205\t          marked (into #{}\n   206\t                       (map (fn [[o r p _ _]] [o r p]))\n   207\t                       extracted)]\n   208\t      (or (when-let [[v p] (some (fn [row]\n   209\t                                   (let [v (nth row 4)]\n   210\t                                     (when (not (and (integer? v) (= 1 v)))\n   211\t                                       [v (subvec row 0 3)])))\n   212\t                                 extracted)]\n   213\t            {:unsupported-version v, :path p})\n   214\t          (if (= eligible marked)\n   215\t            {:origin origin, :rows (vec (sort jing/canonical-compare extracted))}\n   216\t            {:missing (vec (sort jing/canonical-compare (remove marked eligible))),\n   217\t             :extra (vec (sort jing/canonical-compare (remove eligible marked)))})))))\n   218\t\n   219\t\n   220\t(defn link-local\n   221\t  \"Link `format`'s image through the manifest `address` over `handle`'s\n   222\t   own content, `:verifying` with discharge deferred, as a serving\n   223\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\n   224\t   call, so no request reaches any peer.  `opts` overrides the link\n   225\t   options; its `:bounds` are the runtime's composition bounds (section\n   226\t   4.2 step 2), every one left out taking `linker/default-bounds`.\"\n   227\t  ([handle address format] (link-local handle address format nil))\n   228\t  ([handle address format opts]\n   229\t   (linker/link-manifest\n   230\t     (linker/local-runtime\n   231\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\n   232\t                              (conj code-formats linker/manifest-format\n   233\t                                    linker/record-format))\n   234\t               :bounds (:bounds opts)})\n   235\t     address (:format format) {:primitives vm/primitives}\n   236\t     (merge {:contract (:contract format)\n   237\t             :derivation :verifying\n   238\t             :defer-discharge true}\n   239\t            (dissoc opts :bounds)))))\n   240\t\n   241\t\n   242\t(defn- publish-closure!\n   243\t  \"`publish-module!` under the composition bounds of `opts`.\"\n   244\t  [handle {:keys [name ast exports requires primitives] :as spec} opts]\n   245\t  (let [undefined (first (remove (definitions ast) exports))\n   246\t        tree (when-not undefined\n   247\t               (try (vm/ast->semantic-bytecode ast)\n   248\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\n   249\t                      (refusal :yin.link.publish/malformed-tree {}))))\n   250\t        defect (when (and tree (not= :refused (:status tree)))\n   251\t                 (vm/validate-rows tree))\n   252\t        ;; each pinned closure is walked before anything is written; an\n   253\t        ;; absent pinned manifest is the footprint's missing-requirement\n   254\t        requirement\n   255\t        (when (and tree (not defect) (not= :refused (:status tree)))\n   256\t          (some (fn [[n address]]\n   257\t                  (let [w (closure/walk handle address opts)]\n   258\t                    (case (:yin.link.closure/outcome w)\n   259\t                      :complete nil\n   260\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '260,710p'\"","aggregated_output":"   260\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n   261\t                                        {:name n})\n   262\t                      :missing (when (not= address (:address w))\n   263\t                                 (refusal :yin.link.publish/incomplete-requirement\n   264\t                                          {:name n :walk w})))))\n   265\t                (sort-by (fn [[n _]] (str n)) requires)))\n   266\t        fp (when (and tree (not defect) (not requirement)\n   267\t                      (not= :refused (:status tree)))\n   268\t             (footprint handle (assoc spec :tree tree)))\n   269\t        ;; a C1 claim is validated before anything is written: a module\n   270\t        ;; whose markers do not cover its tree is never published as\n   271\t        ;; though it did. One publication is one admission event\n   272\t        ;; (design §2.1): the admission identity is pinned explicitly by\n   273\t        ;; the composition when it supplies `:yin.link.publish/admission`,\n   274\t        ;; drawn from the composition's own scope object when it supplies\n   275\t        ;; `:yin.link.publish/scope`, and otherwise derived from the\n   276\t        ;; specification's own durable identity — no counter lives in\n   277\t        ;; this namespace. Either way it is persisted in the side record\n   278\t        ;; and retrieved from there\n   279\t        admission (or (:yin.link.publish/admission opts)\n   280\t                      (when-let [scope (:yin.link.publish/scope opts)]\n   281\t                        (scope-admission-token scope))\n   282\t                      (when tree (spec-admission-token spec tree)))\n   283\t        claim (when (and tree (not defect) (not requirement)\n   284\t                         (not= :refused (:status tree))\n   285\t                         (not= :refused (:status fp)))\n   286\t                (call-site-claim ast tree admission))]\n   287\t    (cond\n   288\t      undefined\n   289\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   290\t\n   291\t      (= :refused (:status tree)) tree\n   292\t\n   293\t      defect\n   294\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\n   295\t\n   296\t      requirement requirement\n   297\t\n   298\t      (= :refused (:status fp)) fp\n   299\t\n   300\t      ;; dispatch on the key's PRESENCE, not its truthiness: a marker\n   301\t      ;; whose value is present but not the integer 1 — nil or false\n   302\t      ;; included — carries :unsupported-version nil/false, and its\n   303\t      ;; reason is the unsupported version, never incomplete coverage\n   304\t      (and claim (contains? claim :unsupported-version))\n   305\t      (refusal :yin.link.publish/unsupported-call-site-version claim)\n   306\t\n   307\t      (and claim (not (:rows claim)))\n   308\t      (refusal :yin.link.publish/incomplete-call-site-coverage claim)\n   309\t\n   310\t      :else\n   311\t      (let [tree-address (vm/materialize-tree! handle tree)\n   312\t            sem-vector (:vector (linearize/project-rows tree))\n   313\t            sem (code/materialize-vector! handle sem-vector)\n   314\t            h-image (:image (derive/stack-image sem-vector))\n   315\t            r-image (derive/register-image sem-vector)\n   316\t            h (dcode/image-hash h-image)\n   317\t            r (rcode/register-hash r-image)\n   318\t            h-address (jing/materialize! handle h-image)\n   319\t            r-address (jing/materialize! handle r-image)\n   320\t            mint (fn [input output profile]\n   321\t                   (jing/materialize!\n   322\t                     handle\n   323\t                     (assoc (ledger/derive-record input output)\n   324\t                            :yin.ledger/profile profile)))\n   325\t            ;; the manifest is materialized FIRST, with the closed\n   326\t            ;; schema-1 key set only: the C1 side table never enters\n   327\t            ;; the hashed manifest, so identical specifications under\n   328\t            ;; distinct admissions share one manifest address\n   329\t            manifest {:yin.module/name name\n   330\t                      :yin.module/schema linker/manifest-schema\n   331\t                      :yin.module/contracts\n   332\t                      {:yin.ast/code vm/ast-contract\n   333\t                       :yin.semantic/code vm/semantic-contract\n   334\t                       :yin.debruijn.code vm/stack-contract\n   335\t                       :yin.debruijn.register vm/register-contract}\n   336\t                      :yin.module/tree tree-address\n   337\t                      :yin.module/derivations\n   338\t                      {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\n   339\t                       :yin.debruijn.code\n   340\t                       (mint sem h linker/stack-lowering-profile)\n   341\t                       :yin.debruijn.register\n   342\t                       (mint sem r linker/register-lowering-profile)}\n   343\t                      :yin.module/index {:yin.debruijn.code h-address\n   344\t                                         :yin.debruijn.register r-address}\n   345\t                      :yin.module/exports (set exports)\n   346\t                      :yin.module/requires (or requires {})\n   347\t                      :yin.module/primitives\n   348\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   349\t                                    primitives))\n   350\t                      :yin.module/footprint fp}\n   351\t            address (jing/materialize! handle manifest)\n   352\t            ;; the C1 side table and its publication record, beside\n   353\t            ;; the manifest: the record names the manifest (a record\n   354\t            ;; names a manifest, never the reverse), so each admission\n   355\t            ;; of one specification keeps its own record and table\n   356\t            call-sites (when (:rows claim)\n   357\t                         (let [table (jing/materialize! handle (:rows claim))\n   358\t                               record {:yang.call-site/schema 1\n   359\t                                       :yang.call-site/manifest address\n   360\t                                       :yang.call-site/root (:root tree)\n   361\t                                       :yang.call-site/origin (:origin claim)\n   362\t                                       :yang.call-site/table table}]\n   363\t                           {:record (jing/materialize! handle record)\n   364\t                            :table table\n   365\t                            :origin (:origin claim)\n   366\t                            :root (:root tree)\n   367\t                            :manifest address}))\n   368\t            walked (closure/walk handle address opts)]\n   369\t        (if (not= :complete (:yin.link.closure/outcome walked))\n   370\t          (refusal :yin.link.publish/incomplete-closure\n   371\t                   {:address address :walk walked})\n   372\t          (let [links (into {}\n   373\t                            (map (fn [f]\n   374\t                                   [(:format f)\n   375\t                                    (link-local handle address f\n   376\t                                                (select-keys opts\n   377\t                                                             [:bounds]))]))\n   378\t                            code-formats)]\n   379\t            (cond-> {:address address :manifest manifest\n   380\t                     :identities {:yin.semantic/code sem\n   381\t                                  :yin.debruijn.code sem\n   382\t                                  :yin.debruijn.register sem}\n   383\t                     :checksums {:yin.debruijn.code h\n   384\t                                 :yin.debruijn.register r}\n   385\t                     :links links}\n   386\t              call-sites (assoc :call-sites call-sites))))))))\n   387\t\n   388\t\n   389\t(defn publish-module!\n   390\t  \"Mint all four code formats, derivation records, and one schema-1 manifest.\n   391\t   `opts` `{:bounds {...}}` are the composition bounds (section 4.2 step\n   392\t   2) of every closure walk and local link the publication runs, every\n   393\t   bound left out taking `linker/default-bounds`. `opts` may also pin\n   394\t   the publication's admission identity explicitly\n   395\t   (`:yin.link.publish/admission`) or scope it — a scope object from\n   396\t   `admission-scope` under `:yin.link.publish/scope`, whose counter the\n   397\t   caller owns; without either, the admission identity is derived from\n   398\t   the specification's own durable identity, so re-publishing the same\n   399\t   specification is the same recorded admission.\"\n   400\t  ([handle spec] (publish-module! handle spec nil))\n   401\t  ([handle spec opts] (publish-closure! handle spec opts)))\n   402\t\n   403\t\n   404\t(defn- stored-tree\n   405\t  \"The canonical row tree stored under `root` in `handle`, rebuilt\n   406\t   from its individually materialized rows (`vm/materialize-tree!`\n   407\t   stores each row body under its own address), or nil when a reached\n   408\t   row is absent.\"\n   409\t  [handle root]\n   410\t  (loop [queue [root]\n   411\t         rows {}]\n   412\t    (if (empty? queue)\n   413\t      {:root root, :rows rows}\n   414\t      (let [address (first queue)\n   415\t            body (jing/get handle address nil)]\n   416\t        (if-not (vector? body)\n   417\t          nil\n   418\t          (let [row (into [address] body)\n   419\t                kids (into []\n   420\t                           (mapcat (fn [[j [_ kind]]]\n   421\t                                     (let [pos (+ j 2)]\n   422\t                                       (case kind\n   423\t                                         :node [(nth row pos)]\n   424\t                                         :nodes (nth row pos)\n   425\t                                         nil))))\n   426\t                           (map-indexed vector\n   427\t                                        (get vm/semantic-bytecode-grammar\n   428\t                                             (nth row 1))))]\n   429\t            (recur (into (subvec queue 1)\n   430\t                         (remove #(contains? rows %) kids))\n   431\t                   (assoc rows address row))))))))\n   432\t\n   433\t\n   434\t(defn published-call-site-table\n   435\t  \"The C1 side table a publication record claims: `{:origin o :root r\n   436\t   :rows [...] :tree tree}` with the rows exactly as stored and the\n   437\t   module's canonical tree, or nil when no record verifies. The record\n   438\t   names the manifest (`:yang.call-site/manifest`); the manifest never\n   439\t   names the record, so a bare manifest address alone cannot discover\n   440\t   a side table. Accepts the publication record's address, or the\n   441\t   `publish-module!` result map (whose `:call-sites :record` and\n   442\t   `:address` it reads); the three-argument form additionally holds\n   443\t   the record to the manifest it is asked about. A record verifies\n   444\t   only when its schema is 1, its `:yang.call-site/manifest` is the\n   445\t   manifest in question, its `:yang.call-site/root` is that manifest's\n   446\t   own tree, and its ORIGIN is the one RECORDED at publication\n   447\t   (`:yang.call-site/origin`, held to be a well-formed occurrence\n   448\t   origin). Nothing reconstructs an origin from content: a replay of\n   449\t   this retrieval answers the recorded admission identity, and no\n   450\t   other module's admission can be confused with it.\"\n   451\t  ([handle record-or-result]\n   452\t   (if (map? record-or-result)\n   453\t     (published-call-site-table handle\n   454\t                                (:address record-or-result)\n   455\t                                (get-in record-or-result\n   456\t                                        [:call-sites :record]))\n   457\t     (published-call-site-table handle nil record-or-result)))\n   458\t  ([handle manifest-address record-address]\n   459\t   (when (jing/segment-address? record-address)\n   460\t     (let [record (jing/get handle record-address nil)]\n   461\t       (when (and (map? record)\n   462\t                  (= 1 (:yang.call-site/schema record))\n   463\t                  (jing/segment-address? (:yang.call-site/manifest record))\n   464\t                  (or (nil? manifest-address)\n   465\t                      (= manifest-address (:yang.call-site/manifest record)))\n   466\t                  (jing/segment-address? (:yang.call-site/table record))\n   467\t                  (vm/occurrence-origin? (:yang.call-site/origin record)))\n   468\t         (let [manifest (jing/get handle\n   469\t                                  (:yang.call-site/manifest record) nil)]\n   470\t           (when (and (map? manifest)\n   471\t                      (= (:yang.call-site/root record)\n   472\t                         (:yin.module/tree manifest)))\n   473\t             (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n   474\t               (let [stored-rows (jing/get handle\n   475\t                                           (:yang.call-site/table record)\n   476\t                                           nil)]\n   477\t                 (when (vector? stored-rows)\n   478\t                   {:origin (:yang.call-site/origin record),\n   479\t                    :root (:root tree), :rows stored-rows,\n   480\t                    :tree tree}))))))))))\n   481\t\n   482\t\n   483\t;; =============================================================================\n   484\t;; Deriving a module from indexed code (5.3)\n   485\t;; =============================================================================\n   486\t\n   487\t(defn- indexed-programs\n   488\t  \"Every program the index `db` holds -- a relation of `[e a v t m]` index\n   489\t   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\n   490\t   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\n   491\t   whose `m` is the program's metadata entity.\"\n   492\t  [db]\n   493\t  (let [by-m (group-by #(nth % 4)\n   494\t                       (query/collect\n   495\t                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\n   496\t                                  db)))]\n   497\t    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\n   498\t          (sort-by (juxt second first)\n   499\t                   (query/collect\n   500\t                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\n   501\t                              db))))))\n   502\t\n   503\t\n   504\t(defn requirements\n   505\t  \"The modules `ast` unconditionally requires at module level. Scan literal\n   506\t   `(require 'm)` applications outside lambda bodies, except immediately\n   507\t   applied lambdas. Conditional branches and try-require remain deferred.\"\n   508\t  [ast]\n   509\t  (requirements/eager ast))\n   510\t\n   511\t\n   512\t(defn- free-of\n   513\t  \"The free names of the map AST `ast` (`yin.vm/free-names`).\"\n   514\t  [ast]\n   515\t  (let [tree (vm/ast->semantic-bytecode ast)]\n   516\t    (vm/free-names (query/relation (vals (:rows tree)))\n   517\t                   (query/relation (vm/occurrences tree))\n   518\t                   (:root tree))))\n   519\t\n   520\t\n   521\t(def no-op-tree\n   522\t  \"The tree of a module that collects no program, which is the module of\n   523\t   an empty export list: one `nil` literal, defining nothing.\"\n   524\t  {:type :literal :value nil})\n   525\t\n   526\t\n   527\t(def ^:private call-site-key\n   528\t  \"The reserved frontend-metadata key of the call-site occurrence\n   529\t   contract C1, enforced at the publication boundary but not owned\n   530\t   by it.\"\n   531\t  :yang/call-site)\n   532\t\n   533\t\n   534\t(defn- mark-call-sites\n   535\t  \"The map AST `node` with `:yang/call-site 1` on every `:application`\n   536\t   node, at every depth the row grammar knows. This mirrors the\n   537\t   frontends' shared finalization walk locally: this namespace sits\n   538\t   below every frontend and must not import one.\"\n   539\t  [node]\n   540\t  (let [walked (reduce (fn [n [field kind]]\n   541\t                         (case kind\n   542\t                           :node (update n field mark-call-sites)\n   543\t                           :nodes (update n field\n   544\t                                          (fn [children]\n   545\t                                            (mapv mark-call-sites children)))\n   546\t                           n))\n   547\t                       node\n   548\t                       (get vm/semantic-bytecode-grammar (:type node)))]\n   549\t    (cond-> walked\n   550\t      (= :application (:type node)) (assoc :yang/call-site 1))))\n   551\t\n   552\t\n   553\t(defn- proven-call-sites?\n   554\t  \"True when the retained expander `tables` (`{[origin root] rows}`, as\n   555\t   `yin.vm.macro/load` retains them) prove every one of `asts` was\n   556\t   C1-finalized: each program's canonical root has a retained table\n   557\t   whose version-1 C1 rows cover exactly its application occurrences.\n   558\t   Recovery reads that record; it never infers coverage from content.\"\n   559\t  [asts tables]\n   560\t  (boolean\n   561\t    (and (seq tables)\n   562\t         (every? (fn [ast]\n   563\t                   (let [tree (vm/ast->semantic-bytecode ast)\n   564\t                         eligible (into #{}\n   565\t                                        (map (fn [[r p]] [r p]))\n   566\t                                        (vm/application-occurrences tree))]\n   567\t                     (boolean\n   568\t                       (some (fn [[[_origin root] rows]]\n   569\t                               (let [claimed (filter #(= call-site-key\n   570\t                                                         (nth % 3))\n   571\t                                                     rows)]\n   572\t                                 (and (= root (:root tree))\n   573\t                                      (every? #(= 1 (nth % 4)) claimed)\n   574\t                                      (= eligible\n   575\t                                         (into #{}\n   576\t                                               (map (fn [[_ r p _ _]]\n   577\t                                                      [r p]))\n   578\t                                               claimed)))))\n   579\t                             tables))))\n   580\t                 asts))))\n   581\t\n   582\t\n   583\t(defn- sequenced\n   584\t  \"One tree running `asts` in order: `((fn [_] second) first)`, nested.\n   585\t   A program root in operand position is not a tail call.  No programs\n   586\t   is `no-op-tree`.\"\n   587\t  [asts]\n   588\t  (if (empty? asts)\n   589\t    no-op-tree\n   590\t    (reduce (fn [body ast]\n   591\t              {:type :application\n   592\t               :tail? true\n   593\t               :operator {:type :lambda :params '[_] :body body}\n   594\t               :operands [(cond-> ast\n   595\t                            (= :application (:type ast)) (assoc :tail? false))]})\n   596\t            (peek asts)\n   597\t            (rseq (pop asts)))))\n   598\t\n   599\t\n   600\t(defn- free-declaration\n   601\t  \"How the module declares the free name `n`: `[:requires module\n   602\t   address]`, `[:primitives n profile]`, or a refusal.\"\n   603\t  [n {:keys [primitives modules host-modules]}]\n   604\t  (let [module (some-> (namespace n) symbol)]\n   605\t    (cond\n   606\t      (and module (contains? modules module))\n   607\t      [:requires module (get modules module)]\n   608\t\n   609\t      (and module (contains? (set host-modules) module))\n   610\t      (refusal :yin.link.publish/host-module {:name n :module module})\n   611\t\n   612\t      (and (nil? module) (contains? primitives n))\n   613\t      [:primitives n (vm/profile-of primitives n)]\n   614\t\n   615\t      :else (refusal :yin.link.publish/undeclared-free {:name n}))))\n   616\t\n   617\t\n   618\t(defn module-from-index\n   619\t  \"`publish-module!`'s spec for the module `name` exporting `exports`,\n   620\t   derived from the indexed code of `db` (section 5.3), or a refusal.\n   621\t   Persists nothing.\n   622\t\n   623\t   The defining program of a symbol is the indexed program of greatest\n   624\t   `t` defining it at module level.  The exports' defining programs are\n   625\t   collected, then the defining program of every free name they hold\n   626\t   that some indexed program defines, and, for each linked module a free\n   627\t   qualified name declares, the latest program requiring that module at\n   628\t   module level (refused `:yin.link.publish/missing-require-program`\n   629\t   naming the module when none does), to a fixed point; the tree is the\n   630\t   collected programs, each once, in ascending `t`.  Each remaining free name is a\n   631\t   primitive of `primitives` (declared with its profile), or qualified by\n   632\t   a module of `modules` -- `{name manifest-address}`, the modules the\n   633\t   session linked -- (declared under `:requires`).  A name qualified by\n   634\t   one of `host-modules` refuses `:yin.link.publish/host-module`, any\n   635\t   other `:yin.link.publish/undeclared-free`.\n   636\t\n   637\t   Indexed programs are reconstructed from datoms and carry no C1\n   638\t   markers. With `opts`' `:call-site-tables` — the expander's retained\n   639\t   tables (`yin.vm.macro/call-site-table` custody) — a collected\n   640\t   program proven C1-finalized by its retained table has its markers\n   641\t   recovered, and the `sequenced` wrappers this derivation synthesizes\n   642\t   are marked with them: their origin is the publication admission\n   643\t   `publish-module!` records. Without such proof for every collected\n   644\t   program the tree stays unmarked and publishes without a C1 claim;\n   645\t   markers are never minted for a recovered tree.\"\n   646\t  [db {:keys [name exports modules call-site-tables] :as opts}]\n   647\t  (let [programs (mapv (fn [p]\n   648\t                         (assoc p\n   649\t                                :defines (definitions (:ast p))\n   650\t                                :requires (requirements (:ast p))\n   651\t                                :free (free-of (:ast p))))\n   652\t                       (indexed-programs db))\n   653\t        defining (fn [sym]\n   654\t                   (last (filter #(contains? (:defines %) sym) programs)))\n   655\t        requiring (fn [module]\n   656\t                    (last (filter #(contains? (:requires %) module) programs)))\n   657\t        ;; the linked modules the collected programs' free qualified names\n   658\t        ;; declare as requirements (closure by linked requirements)\n   659\t        linked (fn [ps]\n   660\t                 (sort-by str\n   661\t                          (distinct\n   662\t                            (keep (fn [n]\n   663\t                                    (let [m (some-> (namespace n) symbol)]\n   664\t                                      (when (and m (not (defining n))\n   665\t                                                 (contains? modules m))\n   666\t                                        m)))\n   667\t                                  (mapcat :free ps)))))\n   668\t        undefined (first (remove defining exports))]\n   669\t    (if undefined\n   670\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   671\t      (let [collected (loop [ms (set (map (comp :m defining) exports))]\n   672\t                        (let [ps (filterv #(contains? ms (:m %)) programs)\n   673\t                              unrequired (first (remove requiring (linked ps)))\n   674\t                              more (-> ms\n   675\t                                       (into (keep (comp :m defining))\n   676\t                                             (mapcat :free ps))\n   677\t                                       (into (keep (comp :m requiring))\n   678\t                                             (linked ps)))]\n   679\t                          (cond\n   680\t                            unrequired\n   681\t                            (refusal :yin.link.publish/missing-require-program\n   682\t                                     {:module unrequired})\n   683\t\n   684\t                            (= more ms) ps\n   685\t                            :else (recur more))))\n   686\t            declared (when (vector? collected)\n   687\t                       (map #(free-declaration % opts)\n   688\t                            (sort-by str\n   689\t                                     (remove defining\n   690\t                                             (distinct (mapcat :free collected))))))]\n   691\t        (or (when (map? collected) collected)\n   692\t            (some #(when (map? %) %) declared)\n   693\t            {:name name\n   694\t             :ast (let [asts (mapv :ast collected)]\n   695\t                    (cond-> (sequenced asts)\n   696\t                      (proven-call-sites? asts call-site-tables)\n   697\t                      mark-call-sites))\n   698\t             :exports (set exports)\n   699\t             :requires (into {}\n   700\t                             (keep (fn [[k n a]] (when (= :requires k) [n a])))\n   701\t                             declared)\n   702\t             :primitives (into {}\n   703\t                               (keep (fn [[k n p]] (when (= :primitives k) [n p])))\n   704\t                               declared)})))))\n   705\t\n   706\t\n   707\t;; =============================================================================\n   708\t;; Name envelopes (6.1, 6.5, 6.6)\n   709\t;; =============================================================================\n   710\t\n","exit_code":0,"status":"completed"}}
