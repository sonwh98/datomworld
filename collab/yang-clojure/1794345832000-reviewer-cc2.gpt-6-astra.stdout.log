{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"wc -l src/cljc/yang/safepoint.cljc src/cljc/yin/vm/linker/publish.cljc test/yang/clojure_callsite_test.cljc /tmp/cc2-review-diff.txt; nl -ba src/cljc/yang/safepoint.cljc | sed -n '235,370p'; nl -ba test/yang/clojure_callsite_test.cljc | sed -n '1265,1515p'\"","aggregated_output":"     448 src/cljc/yang/safepoint.cljc\n     791 src/cljc/yin/vm/linker/publish.cljc\n    1505 test/yang/clojure_callsite_test.cljc\n     786 /tmp/cc2-review-diff.txt\n    3530 total\n   235\t\n   236\t(defn- track-occurrences\n   237\t  \"Path arithmetic over the input map AST `ast` under the selected\n   238\t   `hooks`: `{:surviving {in-path out-path} :injected #{out-path}}` for\n   239\t   every `:application` occurrence. Wrapping never drops, duplicates, or\n   240\t   reorders a subtree — it only prefixes hook applications — so each\n   241\t   input application has exactly one output place, derived here from\n   242\t   the rewrite's own insertions, never matched by content. A sequencing\n   243\t   insertion (`sequence-hook`) puts its node under `[2 3]` beneath the\n   244\t   injected sequencing application; a lambda site's body shifts under\n   245\t   the entry sequencing application and the exit hook application.\"\n   246\t  [ast hooks]\n   247\t  (let [surviving (atom {})\n   248\t        injected (atom #{})]\n   249\t    (letfn [(walk2\n   250\t                [node in-path out-path]\n   251\t                (let [site (get hooks in-path)]\n   252\t                  (cond\n   253\t                    (and site (or (:statement? site) (:sequence? site)))\n   254\t                    (do (swap! injected conj out-path (conj out-path [3 0]))\n   255\t                        (walk-self2 node in-path (conj out-path 2 3)))\n   256\t\n   257\t                    (and site (= :lambda (:type node)))\n   258\t                    (let [{:keys [enter exit]} site\n   259\t                          body-out (into out-path\n   260\t                                         (cond\n   261\t                                           (and enter exit) [3 2 3 [3 0]]\n   262\t                                           enter [3 2 3]\n   263\t                                           exit [3 [3 0]]\n   264\t                                           :else [3]))]\n   265\t                      (when enter\n   266\t                        (swap! injected conj (conj out-path 3)\n   267\t                               (into out-path [3 [3 0]])))\n   268\t                      (when exit\n   269\t                        (swap! injected conj\n   270\t                               (if enter (conj out-path 3 2 3) (conj out-path 3))))\n   271\t                      (walk2 (:body node) (conj in-path 3) body-out))\n   272\t\n   273\t                    :else (walk-self2 node in-path out-path))))\n   274\t              (walk-self2\n   275\t                [node in-path out-path]\n   276\t                (when (= :application (:type node))\n   277\t                  (swap! surviving assoc in-path out-path))\n   278\t                (doseq [[j [field kind]] (map-indexed vector\n   279\t                                                      (get vm/semantic-bytecode-grammar\n   280\t                                                           (:type node)))\n   281\t                        :let [pos (+ j 2)\n   282\t                              value (get node field)]]\n   283\t                  (case kind\n   284\t                    :node (walk2 value (conj in-path pos) (conj out-path pos))\n   285\t                    :nodes (doseq [[i child] (map-indexed vector (or value []))]\n   286\t                             (walk2 child (conj in-path [pos i])\n   287\t                                    (conj out-path [pos i])))\n   288\t                    nil)))]\n   289\t        (walk2 ast [] []))\n   290\t      {:surviving @surviving :injected @injected}))\n   291\t\n   292\t\n   293\t(defn- derive-call-sites\n   294\t  \"Recompute the C1 rows of the derived tree from the input tree's own\n   295\t   rows: `{:metadata rows :correspondence c}`, or nil when the input\n   296\t   carries no C1 claim for `tree`. A surviving occurrence keeps its\n   297\t   input row's origin at its tracked output path. An injected\n   298\t   occurrence is claimed only under `injected-origin`, the admission\n   299\t   origin the caller supplies; without one it is recorded as injected\n   300\t   and left unclaimed. An input row whose occurrence is claimed by two\n   301\t   origins, or that names no application occurrence of the input tree,\n   302\t   is refused attribution (`:unmapped`) — never guessed.\"\n   303\t  [frontend-metadata tree derived hooks injected-origin]\n   304\t  (let [rows (filterv (fn [row]\n   305\t                        (and (sequential? row) (= 5 (count row))\n   306\t                             (= (:root tree) (nth row 1))\n   307\t                             (= call-site-key (nth row 3))))\n   308\t                      frontend-metadata)]\n   309\t    (when (seq rows)\n   310\t      (let [{:keys [surviving injected]}\n   311\t            (track-occurrences (vm/semantic-bytecode->ast tree) hooks)\n   312\t            eligible (into #{} (map second) (vm/application-occurrences tree))\n   313\t            by-path (group-by #(nth % 2) rows)\n   314\t            sorted (fn [xs] (vec (sort-by pr-str xs)))\n   315\t            parts (reduce\n   316\t                    (fn [acc [path rs]]\n   317\t                      (let [origins (distinct (map first rs))]\n   318\t                        (cond\n   319\t                          (< 1 (count origins))\n   320\t                          (update acc :unmapped into\n   321\t                                  (map (fn [o]\n   322\t                                         {:kind :unmapped\n   323\t                                          :input [o (:root tree) path]\n   324\t                                          :reason :ambiguous})\n   325\t                                       origins))\n   326\t\n   327\t                          (not (contains? eligible path))\n   328\t                          (update acc :unmapped conj\n   329\t                                  {:kind :unmapped\n   330\t                                   :input [(first (first rs)) (:root tree) path]\n   331\t                                   :reason :no-such-occurrence})\n   332\t\n   333\t                          :else\n   334\t                          (let [o (first (first rs))\n   335\t                                out (get surviving path)]\n   336\t                            (-> acc\n   337\t                                (update :entries conj\n   338\t                                        {:kind :surviving\n   339\t                                         :input [o (:root tree) path]\n   340\t                                         :output [o (:root derived) out]})\n   341\t                                (update :rows into\n   342\t                                        (map (fn [r]\n   343\t                                               [o (:root derived) out\n   344\t                                                call-site-key (nth r 4)])\n   345\t                                             rs)))))))\n   346\t                    {:entries [] :rows [] :unmapped []}\n   347\t                    (sort-by (comp pr-str key) by-path))\n   348\t            injected-entries (map (fn [p]\n   349\t                                    (cond-> {:kind :safepoint/injected :path p}\n   350\t                                      injected-origin\n   351\t                                      (assoc :origin injected-origin)))\n   352\t                                  (sorted injected))\n   353\t            injected-rows (when injected-origin\n   354\t                            (map (fn [p]\n   355\t                                   [injected-origin (:root derived) p\n   356\t                                    call-site-key 1])\n   357\t                                 injected))]\n   358\t        {:metadata (vec (sort jing/canonical-compare\n   359\t                              (distinct (into (:rows parts) injected-rows))))\n   360\t         :correspondence {:input-root (:root tree)\n   361\t                          :output-root (:root derived)\n   362\t                          :entries (into (sorted (:entries parts))\n   363\t                                         (into injected-entries\n   364\t                                               (sorted (:unmapped parts))))}}))))\n   365\t\n   366\t\n   367\t(defn derive-record\n   368\t  \"The `:derive` record linking canonical root `input` to derived root\n   369\t   `output`: function `function`, profile pinning the hook map and the\n   370\t   address of the sorted site set.\"\n  1265\t\n  1266\t(def ^:private sp-ast\n  1267\t  \"`((fn [w] (w w)) (fn [w] (f w)))`, both lambdas site-marked (`:call`,\n  1268\t   `:loop`) and every application C1-marked, tails marked as a frontend\n  1269\t   would.\"\n  1270\t  (yang/annotate-call-sites\n  1271\t    (tails/mark-tails\n  1272\t      (sp-app (vary-meta (sp-lam '[w] (sp-app (sp-var 'w) (sp-var 'w)))\n  1273\t                         assoc :yang/site :call)\n  1274\t              (vary-meta (sp-lam '[w] (sp-app (sp-var 'f) (sp-var 'w)))\n  1275\t                         assoc :yang/site :loop)))))\n  1276\t\n  1277\t\n  1278\t(def ^:private sp-profile {:loop 'h/loop :call 'h/call})\n  1279\t(def ^:private sp-origin (vm/source-origin :m [:t 0] 0))\n  1280\t(def ^:private sp-injected-origin [:source :test/publication \"safepoint-c1\" 0])\n  1281\t\n  1282\t\n  1283\t(defn- sp-projected\n  1284\t  [ast]\n  1285\t  (encoder/project (encoder/source-envelope :m [:t 0] [ast])))\n  1286\t\n  1287\t\n  1288\t(defn- entry-set\n  1289\t  [correspondence kind]\n  1290\t  (into #{} (filter #(= kind (:kind %))) (:entries correspondence)))\n  1291\t\n  1292\t\n  1293\t(deftest safepoint-c1-preservation-test\n  1294\t  (let [input (sp-projected sp-ast)\n  1295\t        input-tree (first (:yin/batch input))\n  1296\t        input-rows (filterv #(= :yang/call-site (nth % 3))\n  1297\t                            (:yin/frontend-metadata input))]\n  1298\t    (is (seq input-rows) \"the input envelope carries a C1 claim\")\n  1299\t    (testing \"without a supplied injected origin, surviving occurrences\n  1300\t              keep their own origin at their shifted paths and injected\n  1301\t              occurrences are identified but unclaimed\"\n  1302\t      (let [{:keys [envelope correspondence]}\n  1303\t            (safepoint/derive-envelope input sp-profile :m')\n  1304\t            derived-tree (first (:yin/batch envelope))\n  1305\t            md (:yin/frontend-metadata envelope)\n  1306\t            surviving (entry-set correspondence :surviving)\n  1307\t            injected (entry-set correspondence :safepoint/injected)]\n  1308\t        (is (some? correspondence))\n  1309\t        (is (= (count input-rows) (count surviving))\n  1310\t            \"every claimed input occurrence survives (wrapping never drops one)\")\n  1311\t        (is (= (into #{} (map :input) surviving)\n  1312\t               (into #{} (map #(vec (take 3 %))) input-rows))\n  1313\t            \"the correspondence names every claimed input occurrence\")\n  1314\t        (is (= (into #{} (map :output) surviving) (marked md))\n  1315\t            \"the derived rows are exactly the surviving occurrences\")\n  1316\t        (is (= #{sp-origin} (row-origins md))\n  1317\t            \"surviving rows keep the input rows' own origin, none fabricated\")\n  1318\t        (is (seq injected) \"the hook insertions are recorded as injected\")\n  1319\t        (is (every? #(not (contains? % :origin)) injected)\n  1320\t            \"with no origin supplied by the caller, none is invented\")\n  1321\t        (is (= (into #{} (map (fn [e] [(:root derived-tree) (:path e)])) injected)\n  1322\t               (into #{} (remove (into #{}\n  1323\t                                       (map (fn [[_ r p]] [r p])\n  1324\t                                            (map :output surviving)))\n  1325\t                                 (occurrence-pairs derived-tree))))\n  1326\t            \"the unclaimed derived occurrences are exactly the injected ones\")\n  1327\t        (testing \"canonical invariance: C1 carriage changes no row or root\"\n  1328\t          (let [plain (safepoint/derive-envelope\n  1329\t                        (sp-projected (strip-call-sites sp-ast))\n  1330\t                        sp-profile :m')]\n  1331\t            (is (= (:root derived-tree)\n  1332\t                   (:root (first (:yin/batch (:envelope plain))))))\n  1333\t            (is (= derived-tree (first (:yin/batch (:envelope plain)))))))))\n  1334\t    (testing \"with a caller-supplied admission origin, the derived table\n  1335\t              covers the derived tree completely and the injected rows\n  1336\t              carry that origin alone\"\n  1337\t      (let [{:keys [envelope correspondence]}\n  1338\t            (safepoint/derive-envelope input sp-profile :m'\n  1339\t                                       {:injected-origin sp-injected-origin})\n  1340\t            derived-tree (first (:yin/batch envelope))\n  1341\t            md (:yin/frontend-metadata envelope)\n  1342\t            surviving (entry-set correspondence :surviving)\n  1343\t            injected (entry-set correspondence :safepoint/injected)]\n  1344\t        (is (= (occurrence-pairs derived-tree) (marked-pairs md))\n  1345\t            \"the recomputed table covers every derived application\")\n  1346\t        (is (true? (yang/validate-call-site-coverage!\n  1347\t                     derived-tree md sp-injected-origin\n  1348\t                     {:declared? true :per-occurrence-origins? true})))\n  1349\t        (is (every? #(= sp-injected-origin (:origin %)) injected))\n  1350\t        (is (= (into #{} (map (fn [e] [(:origin e) (:root derived-tree) (:path e)]))\n  1351\t                     injected)\n  1352\t               (into #{} (filter #(= sp-injected-origin (first %))) (marked md)))\n  1353\t            \"the injected rows are exactly the injected correspondence entries\")\n  1354\t        (is (= (into #{} (map :output) surviving)\n  1355\t               (into #{} (filter #(= sp-origin (first %))) (marked md)))\n  1356\t            \"the surviving rows keep the input origin\")))\n  1357\t    (testing \"an ambiguous or stale input row is refused attribution,\n  1358\t              never guessed\"\n  1359\t      (let [victim (first input-rows)\n  1360\t            other-origin [:source :other-publisher \"batch-9\" 0]\n  1361\t            bad (assoc input :yin/frontend-metadata\n  1362\t                       (into (:yin/frontend-metadata input)\n  1363\t                             [[other-origin (nth victim 1) (nth victim 2)\n  1364\t                               :yang/call-site 1]\n  1365\t                              [sp-origin (:root input-tree) [99]\n  1366\t                               :yang/call-site 1]]))\n  1367\t            {:keys [envelope correspondence]}\n  1368\t            (safepoint/derive-envelope bad sp-profile :m'\n  1369\t                                       {:injected-origin sp-injected-origin})\n  1370\t            unmapped (entry-set correspondence :unmapped)]\n  1371\t        (is (= #{(vec (take 3 victim))\n  1372\t                 [other-origin (nth victim 1) (nth victim 2)]\n  1373\t                 [sp-origin (:root input-tree) [99]]}\n  1374\t               (into #{} (map :input) unmapped))\n  1375\t            \"both claims on the double-claimed occurrence and the stale\n  1376\t             occurrence are unmapped\")\n  1377\t        (is (not (contains? (marked (:yin/frontend-metadata envelope))\n  1378\t                            (some #(when (= (vec (take 3 vict