metadata (vec (or metadata [])),\n+       :entity-occurrences []})\n \n     (sequential? member)\n     (let [datoms (vec member)\n@@ -294,6 +305,40 @@\n       false)))\n \n \n+(defn- check-projected-claim!\n+  \"Refuse an already-projected member whose caller-supplied C1 rows do\n+   not exactly cover its tree, as `check-call-site-claim!` refuses a\n+   map-AST member's markers: a member carrying no C1 rows makes no\n+   claim and passes; a claimed row of any other version, or a claimed\n+   `[root path]` set short of — or beyond — the tree's application\n+   occurrences, refuses the projection instead of dropping the claim.\"\n+  [metadata tree]\n+  (let [claimed-rows (filter (fn [row]\n+                               (and (sequential? row)\n+                                    (<= 4 (count row))\n+                                    (= call-site-key (nth row 3))))\n+                             (or metadata []))]\n+    (when (seq claimed-rows)\n+      (doseq [row claimed-rows]\n+        (when (not= 1 (nth row 4 nil))\n+          (throw (ex-info \"Unsupported call-site marker version\"\n+                          {:rule :yang/call-site-unsupported-version,\n+                           :path (nth row 2), :value (nth row 4 nil)}))))\n+      (let [eligible (into #{}\n+                           (map (fn [[r p]] [r p]))\n+                           (vm/application-occurrences tree))\n+            claimed (into #{}\n+                          (map (fn [row] [(nth row 1) (nth row 2)]))\n+                          claimed-rows)]\n+        (when (not= eligible claimed)\n+          (throw (ex-info \"Call-site markers do not cover the projected tree\"\n+                          {:rule :yang/call-site-incomplete-coverage,\n+                           :missing (vec (sort-by pr-str\n+                                                  (remove claimed eligible))),\n+                           :extra (vec (sort-by pr-str\n+                                                (remove eligible claimed)))})))))))\n+\n+\n (defn program-batch\n   \"Encode frontend output as the expander's input batch (§2.1):\n    `[:yin.program/batch trees run-index declaration-rows harvest-rows\ndiff --git a/src/cljc/yin/vm/linker/publish.cljc b/src/cljc/yin/vm/linker/publish.cljc\nindex 7be0ee97..ff146c30 100644\n--- a/src/cljc/yin/vm/linker/publish.cljc\n+++ b/src/cljc/yin/vm/linker/publish.cljc\n@@ -524,6 +524,62 @@\n   {:type :literal :value nil})\n \n \n+(def ^:private call-site-key\n+  \"The reserved frontend-metadata key of the call-site occurrence\n+   contract C1, enforced at the publication boundary but not owned\n+   by it.\"\n+  :yang/call-site)\n+\n+\n+(defn- mark-call-sites\n+  \"The map AST `node` with `:yang/call-site 1` on every `:application`\n+   node, at every depth the row grammar knows. This mirrors the\n+   frontends' shared finalization walk locally: this namespace sits\n+   below every frontend and must not import one.\"\n+  [node]\n+  (let [walked (reduce (fn [n [field kind]]\n+                         (case kind\n+                           :node (update n field mark-call-sites)\n+                           :nodes (update n field\n+                                          (fn [children]\n+                                            (mapv mark-call-sites children)))\n+                           n))\n+                       node\n+                       (get vm/semantic-bytecode-grammar (:type node)))]\n+    (cond-> walked\n+      (= :application (:type node)) (assoc :yang/call-site 1))))\n+\n+\n+(defn- proven-call-sites?\n+  \"True when the retained expander `tables` (`{[origin root] rows}`, as\n+   `yin.vm.macro/load` retains them) prove every one of `asts` was\n+   C1-finalized: each program's canonical root has a retained table\n+   whose version-1 C1 rows cover exactly its application occurrences.\n+   Recovery reads that record; it never infers coverage from content.\"\n+  [asts tables]\n+  (boolean\n+    (and (seq tables)\n+         (every? (fn [ast]\n+                   (let [tree (vm/ast->semantic-bytecode ast)\n+                         eligible (into #{}\n+                                        (map (fn [[r p]] [r p]))\n+                                        (vm/application-occurrences tree))]\n+                     (boolean\n+                       (some (fn [[[_origin root] rows]]\n+                               (let [claimed (filter #(= call-site-key\n+                                                         (nth % 3))\n+                                                     rows)]\n+                                 (and (= root (:root tree))\n+                                      (every? #(= 1 (nth % 4)) claimed)\n+                                      (= eligible\n+                                         (into #{}\n+                                               (map (fn [[_ r p _ _]]\n+                                                      [r p]))\n+                                               claimed)))))\n+                             tables))))\n+                 asts))))\n+\n+\n (defn- sequenced\n   \"One tree running `asts` in order: `((fn [_] second) first)`, nested.\n    A program root in operand position is not a tail call.  No programs\n@@ -576,8 +632,18 @@\n    a module of `modules` -- `{name manifest-address}`, the modules the\n    session linked -- (declared under `:requires`).  A name qualified by\n    one of `host-modules` refuses `:yin.link.publish/host-module`, any\n-   other `:yin.link.publish/undeclared-free`.\"\n-  [db {:keys [name exports modules] :as opts}]\n+   other `:yin.link.publish/undeclared-free`.\n+\n+   Indexed programs are reconstructed from datoms and carry no C1\n+   markers. With `opts`' `:call-site-tables` — the expander's retained\n+   tables (`yin.vm.macro/call-site-table` custody) — a collected\n+   program proven C1-finalized by its retained table has its markers\n+   recovered, and the `sequenced` wrappers this derivation synthesizes\n+   ar