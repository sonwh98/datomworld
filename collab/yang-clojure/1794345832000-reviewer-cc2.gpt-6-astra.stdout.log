  (vary-meta node assoc :yang/site kind))\n    33\t\n    34\t\n    35\t(def ^:private ast\n    36\t  \"`((fn [w] (w w)) (fn [w] (f w)))`, both lambdas marked: the first a\n    37\t   `:call` site, the second a `:loop` site; tails marked as a frontend\n    38\t   would.\"\n    39\t  (tails/mark-tails\n    40\t    (app (site :call (lam '[w] (app (v 'w) (v 'w))))\n    41\t         (site :loop (lam '[w] (app (v 'f) (v 'w)))))))\n    42\t\n    43\t\n    44\t(def ^:private profile {:loop 'h/loop, :call 'h/call})\n    45\t\n    46\t\n    47\t(defn- projected\n    48\t  []\n    49\t  (encoder/project (encoder/source-envelope :m [:t 0] [ast])))\n    50\t\n    51\t\n    52\t(defn- derived\n    53\t  [p]\n    54\t  (safepoint/derive-envelope (projected) p :m'))\n    55\t\n    56\t\n    57\t(defn- tree\n    58\t  [e]\n    59\t  (nth (:yin/batch e) (:yin/root e)))\n    60\t\n    61\t\n    62\t(deftest sites-from-the-side-table-test\n    63\t  (let [e (projected)]\n    64\t    (is (= {[2] :call, [[3 0]] :loop}\n    65\t           (safepoint/sites (:yin/frontend-metadata e)\n    66\t                            (vm/source-origin :m [:t 0] 0)\n    67\t                            (:root (tree e)))))))\n    68\t\n    69\t\n    70\t(deftest insertion-test\n    71\t  (let [out (vm/semantic-bytecode->ast (tree (:envelope (derived profile))))\n    72\t        hooked (fn [hook body]\n    73\t                 {:type :application,\n    74\t                  :operator {:type :lambda, :params ['yang.safepoint/_], :body body},\n    75\t                  :operands [{:type :application,\n    76\t                              :operator {:type :variable, :name hook},\n    77\t                              :operands [],\n    78\t                              :tail? false}],\n    79\t                  :tail? true})]\n    80\t    (testing \"each marked lambda's body runs after its hook; the hook\n    81\t              application is an operand, never a tail call, and the old body\n    82\t              is a tail call of the sequencing lambda\"\n    83\t      (is (= {:type :application,\n    84\t              :operator {:type :lambda, :params '[w],\n    85\t                         :body (hooked 'h/call\n    86\t                                       {:type :application, :operator {:type :variable, :name 'w},\n    87\t                                        :operands [{:type :variable, :name 'w}], :tail? true})},\n    88\t              :operands [{:type :lambda, :params '[w],\n    89\t                          :body (hooked 'h/loop\n    90\t                                        {:type :application,\n    91\t                                         :operator {:type :variable, :name 'f},\n    92\t                                         :operands [{:type :variable, :name 'w}],\n    93\t                                         :tail? true})}],\n    94\t              :tail? false}\n    95\t             out)))))\n    96\t\n    97\t\n    98\t(deftest exit-hook-wraps-the-body-test\n    99\t  (let [{:keys [envelope record]} (derived {:call 'h/call, :return 'h/return})\n   100\t        out (vm/semantic-bytecode->ast (tree envelope))]\n   101\t    (testing \"at a :call site the :return hook takes the body's value, after\n   102\t              the entry hook; the old body is no longer a tail call, the\n   103\t              exit hook is\"\n   104\t      (is (= {:type :lambda, :params '[w],\n   105\t              :body {:type :application,\n   106\t                     :operator {:type :lambda, :params ['yang.safepoint/_],\n   107\t                                :body {:type :application,\n   108\t                                       :operator {:type :variable,\n   109\t                                                  :name 'h/return},\n   110\t                                       :operands [{:type :application,\n   111\t                                                   :operator {:type :variable,\n   112\t                                                              :name 'w},\n   113\t                                                   :operands [{:type :variable,\n   114\t                                                               :name 'w}],\n   115\t                                                   :tail? false}],\n   116\t                                       :tail? true}},\n   117\t                     :operands [{:type :application,\n   118\t                                 :operator {:type :variable, :name 'h/call},\n   119\t                                 :operands [],\n   120\t                                 :tail? false}],\n   121\t                     :tail? true}}\n   122\t             (:operator out))))\n   123\t    (testing \"the :loop site, whose kind the profile omits, is untouched\"\n   124\t      (is (= (tails/strip-tails (first (:operands ast)))\n   125\t             (tails/strip-tails (first (:operands out))))))\n   126\t    (is (= (jing/segment-key [[[2] :call]])\n   127\t           (get-in record [:yin.ledger/profile :yang.safepoint/sites]))))\n   128\t  (testing \"an exit kind alone selects its entry kind's sites\"\n   129\t    (let [out (vm/semantic-bytecode->ast\n   130\t                (tree (:envelope (derived {:return 'h/return}))))]\n   131\t      (is (= {:type :application,\n   132\t              :operator {:type :variable, :name 'h/return},\n   133\t              :operands [{:type :application,\n   134\t                          :operator {:type :variable, :name 'w},\n   135\t                          :operands [{:type :variable, :name 'w}],\n   136\t                          :tail? false}],\n   137\t              :tail? true}\n   138\t             (:body (:operator out)))))))\n   139\t\n   140\t\n   141\t(deftest profile-selects-kinds-test\n   142\t  (let [{:keys [envelope record]} (derived {:loop 'h/loop})\n   143\t        out (vm/semantic-bytecode->ast (tree envelope))]\n   144\t    (testing \"a kind the profile omits is not inserted\"\n   145\t      (is (= (tails/strip-tails (:operator ast))\n   146\t             (tails/strip-tails (:operator out)))))\n   147\t    (is (= {:yang.safepoint/hooks {:loop 'h/loop},\n   148\t            :yang.safepoint/sites (jing/segment-key [[[[3 0]] :loop]])}\n   149\t           (:yin.ledger/profile record)))))\n   150\t\n   151\t\n   152\t(deftest empty-profile-is-the-identity-test\n   153\t  (let [{:keys [envelope record]} (derived {})]\n   154\t    (is (= (tree (projected)) (tree envelope)))\n   155\t    (is (= (:yin.ledger/input record) (:yin.ledger/output record)))))\n   156\t\n   157\t\n   158\t(deftest remark-reproduces-a-frontends-marks-test\n   159\t  (is (= ast (tails/remark-tails ast))))\n   160\t\n   161\t\n   162\t(deftest refusals-test\n   163\t  (let [t (tree (projected))]\n   164\t    (testing \"a site that names a node that is not a lambda\"\n   165\t      (is (= :site-not-lambda\n   166\t             (try (safepoint/insert t {[] :loop} profile) nil\n   167\t                  (catch #?(:cljd Object :clj Exception :cljs :default) e\n   168\t                    (:rule (ex-data e)))))))\n   169\t    (testing \"a site that names no node\"\n   170\t      (is (= :site-missing\n   171\t             (try (safepoint/insert t {[9] :loop} profile) nil\n   172\t                  (catch #?(:cljd Object :clj Exception :cljs :default) e\n   173\t                    (:rule (ex-data e)))))))))\n   174\t\n   175\t\n   176\t(deftest every-host-derives-the-same-addresses-test\n   177\t  (let [{:keys [envelope record-address]} (derived profile)]\n   178\t    (is (nil? (vm/validate-rows (tree envelope))))\n   179\t    ;; computed on the JVM; Node and Dart must agree\n   180\t    (is (= :segment/blake3-c749fd829c4e3cd6c300ca4cf4b3735c32c87f9c968327bd195f2a3568e01959\n   181\t           (:root (tree envelope))))\n   182\t    (is (= :segment/blake3-dc131db3cac4bbcf77eb4ddb74036cd7611df5336af4ee0d1db952fe91c436c9\n   183\t           record-address))\n   184\t    (is (= record-address (:yin/batch-token envelope)))))\n","exit