ity is derived from\n   398\t   the specification's own durable identity, so re-publishing the same\n   399\t   specification is the same recorded admission.\"\n   400\t  ([handle spec] (publish-module! handle spec nil))\n   401\t  ([handle spec opts] (publish-closure! handle spec opts)))\n   402\t\n   403\t\n   404\t(defn- stored-tree\n   405\t  \"The canonical row tree stored under `root` in `handle`, rebuilt\n   406\t   from its individually materialized rows (`vm/materialize-tree!`\n   407\t   stores each row body under its own address), or nil when a reached\n   408\t   row is absent.\"\n   409\t  [handle root]\n   410\t  (loop [queue [root]\n   411\t         rows {}]\n   412\t    (if (empty? queue)\n   413\t      {:root root, :rows rows}\n   414\t      (let [address (first queue)\n   415\t            body (jing/get handle address nil)]\n   416\t        (if-not (vector? body)\n   417\t          nil\n   418\t          (let [row (into [address] body)\n   419\t                kids (into []\n   420\t                           (mapcat (fn [[j [_ kind]]]\n   421\t                                     (let [pos (+ j 2)]\n   422\t                                       (case kind\n   423\t                                         :node [(nth row pos)]\n   424\t                                         :nodes (nth row pos)\n   425\t                                         nil))))\n   426\t                           (map-indexed vector\n   427\t                                        (get vm/semantic-bytecode-grammar\n   428\t                                             (nth row 1))))]\n   429\t            (recur (into (subvec queue 1)\n   430\t                         (remove #(contains? rows %) kids))\n   431\t                   (assoc rows address row))))))))\n   432\t\n   433\t\n   434\t(defn published-call-site-table\n   435\t  \"The C1 side table a publication record claims: `{:origin o :root r\n   436\t   :rows [...] :tree tree}` with the rows exactly as stored and the\n   437\t   module's canonical tree, or nil when no record verifies. The record\n   438\t   names the manifest (`:yang.call-site/manifest`); the manifest never\n   439\t   names the record, so a bare manifest address alone cannot discover\n   440\t   a side table. Accepts the publication record's address, or the\n   441\t   `publish-module!` result map (whose `:call-sites :record` and\n   442\t   `:address` it reads); the three-argument form additionally holds\n   443\t   the record to the manifest it is asked about. A record verifies\n   444\t   only when its schema is 1, its `:yang.call-site/manifest` is the\n   445\t   manifest in question, its `:yang.call-site/root` is that manifest's\n   446\t   own tree, and its ORIGIN is the one RECORDED at publication\n   447\t   (`:yang.call-site/origin`, held to be a well-formed occurrence\n   448\t   origin). Nothing reconstructs an origin from content: a replay of\n   449\t   this retrieval answers the recorded admission identity, and no\n   450\t   other module's admission can be confused with it.\"\n   451\t  ([handle record-or-result]\n   452\t   (if (map? record-or-result)\n   453\t     (published-call-site-table handle\n   454\t                                (:address record-or-result)\n   455\t                                (get-in record-or-result\n   456\t                                        [:call-sites :record]))\n   457\t     (published-call-site-table handle nil record-or-result)))\n   458\t  ([handle manifest-address record-address]\n   459\t   (when (jing/segment-address? record-address)\n   460\t     (let [record (jing/get handle record-address nil)]\n   461\t       (when (and (map? record)\n   462\t                  (= 1 (:yang.call-site/schema record))\n   463\t                  (jing/segment-address? (:yang.call-site/manifest record))\n   464\t                  (or (nil? manifest-address)\n   465\t                      (= manifest-address (:yang.call-site/manifest record)))\n   466\t                  (jing/segment-address? (:yang.call-site/table record))\n   467\t                  (vm/occurrence-origin? (:yang.call-site/origin record)))\n   468\t         (let [manifest (jing/get handle\n   469\t                                  (:yang.call-site/manifest record) nil)]\n   470\t           (when (and (map? manifest)\n   471\t                      (= (:yang.call-site/root record)\n   472\t                         (:yin.module/tree manifest)))\n   473\t             (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n   474\t               (let [stored-rows (jing/get handle\n   475\t                                           (:yang.call-site/table record)\n   476\t                                           nil)]\n   477\t                 (when (vector? stored-rows)\n   478\t                   {:origin (:yang.call-site/origin record),\n   479\t                    :root (:root tree), :rows stored-rows,\n   480\t                    :tree tree}))))))))))\n   481\t\n   482\t\n   483\t;; =============================================================================\n   484\t;; Deriving a module from indexed code (5.3)\n   485\t;; =============================================================================\n   486\t\n   487\t(defn- indexed-programs\n   488\t  \"Every program the index `db` holds -- a relation of `[e a v t m]` index\n   489\t   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\n   490\t   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\n   491\t   whose `m` is the program's metadata entity.\"\n   492\t  [db]\n   493\t  (let [by-m (group-by #(nth % 4)\n   494\t                       (query/collect\n   495\t                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\n   496\t                                  db)))]\n   497\t    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\n   498\t          (sort-by (juxt second first)\n   499\t                   (query/collect\n   500\t                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\nsrc/cljc/yin/vm/linker/dht.cljc:53:(defn publish-name!\nsrc/cljc/yin/repl.cljc:7:   expander observes, and `program-out`, which the evaluator's own observer\nsrc/cljc/yin/repl.cljc:207:  \"The loader the evaluator observer hands each `program-out` value, per\nsrc/cljc/yin/repl.cljc:219:   ;; producer of `program-out` is the expander, so each supplies the\nsrc/cljc/yin/repl.cljc:728:                                     :source-medium :yin.repl/standard-forms})\nsrc/cljc/yin/repl.cljc:735:   `program-out` writer.  No log writer: `(compile ...)` renders events.\"\nsrc/cljc/yin/repl.cljc:736:  [program-identity program-out]\nsrc/cljc/yin/repl.cljc:739:                     :source-medium program-identity\nsrc/cljc/yin/repl.cljc:741:    program-out))\nsrc/cljc/yin/repl.cljc:753:   `:observer` — and appends each expanded tree packet to `program-out` —\nsrc/cljc/yin/repl.cljc:756:   (`yin.repl.index`) is a peer attached to `program-out` beside it; the\nsrc/cljc/yin/repl.cljc:780:        program-out (make-attachment ingress-capacity)]\nsrc/cljc/yin/repl.cljc:786:     :expander (make-expander (:identity program-in) (:stream program-out))\nsrc/cljc/yin/repl.cljc:787:     :row-stream (:stream program-out)\nsrc/cljc/yin/repl.cljc:788:     :row-observer (:observer program-out)\nsrc/cljc/yin/repl.cljc:789:     :indexer (index/make-indexer {:observer ((:attach program-out))\nsrc/cljc/yin/repl.cljc:794:     :ast-indexer (ast-index/make-indexer {:observer ((:attach program-out))})\nsrc/cljc/yin/repl.cljc:1178:  \"Drive the code indexer's observer over `program-out`: it commits each\nsrc/cljc/yin/repl.cljc:1187:  \"Drive the AST indexer's observer over `program-out`: it adds each\nsrc/cljc/yin/repl.cljc:1205:(defn call-site-tables\nsrc/cljc/yin/repl.cljc:1207:   `[admission-origin final-root]` (`yin.vm.macro/call-site-table`\nsrc/cljc/yin/repl.cljc:1210:   `:call-site-tables` option). Nil before any claimed expansion.\"\nsrc/cljc/yin/repl.cljc:1212:  (:call-site-tables (:expander state)))\nsrc/cljc/yin/repl.cljc:1217:   each observed batch and appends the tree packet to `program-out`; a\nsrc/cljc/yin/repl.cljc:1229:  \"Drive the evaluator's observer over `program-out`: it loads each\nsrc/cljc/yin/repl.cljc:1231:   output medium.  The two stages meet only at `program-out`; neither calls\nsrc/cljc/yin/repl.cljc:1317:   :call-site-tables (call-site-tables state)\nsrc/cljc/yin/repl/query.cljc:124:   `publish`, answered by `yin.vm.linker.dht/publish-name!`, and `names`,\nsrc/cljc/yin/repl/query.cljc:769:(defn- link-answer\nsrc/cljc/yin/repl/query.cljc:774:   `yin.vm.linker.dht/publish-name!` over the published index, whose\nsrc/cljc/yin/repl/query.cljc:809:                    res (linker.dht/publish-name!\nsrc/cljc/yin/repl/query.cljc:883:   session composition `link-answer` reads; a publish advances both.  A\nsrc/cljc/yin/repl/query.cljc:906:                (link-op? request) (link-answer node indexer link request)\nsrc/cljc/yin/vm/macro.cljc:11:   packet `[root rows]` to `program-out`, with one event row per attempt on\nsrc/cljc/yin/vm/macro.cljc:1309:  [:source (:source-medium ctx) source-batch tree-index])\nsrc/cljc/yin/vm/macro.cljc:1760:   and the opaque `source-medium` identity (S3.1); the store may be\nsrc/cljc/yin/vm/macro.cljc:1765:  [{:keys [token source-medium store guards], eval-fn :eval}]\nsrc/cljc/yin/vm/macro.cljc:1769:           :source-medium source-medium,\nsrc/cljc/yin/vm/macro.cljc:1828:  \"The observer consumer: `ctx`, the `program-out` writer, and an optional\nsrc/cljc/yin/vm/macro.cljc:1842:(defn call-site-table\nsrc/cljc/yin/vm/macro.cljc:1856:  (get (:call-site-tables expander) [origin (first tree)]))\nsrc/cljc/yin/vm/macro.cljc:1867:   admission origin beside its final root address (`call-site-tables`,\nsrc/cljc/yin/vm/macro.cljc:1868:   resolved by `call-site-table`) — so the composition that drives this\nsrc/cljc/yin/vm/macro.cljc:1879:      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n   630\t   validated data slot (P1-2); every other metadata entry is the\n   631\t   caller's legitimate data and is preserved.\"\n   632\t  #{::origin-of})\n   633\t\n   634\t\n   635\t(defn- strip-tracking\n   636\t  \"Remove only the private tracking entries, recursively, from `x`:\n   637\t   every collection element, map key and value, and every metadata map\n   638\t   (including metadata on metadata) is visited, so a packet nested at\n   639\t   any depth inside a literal payload loses its host-function origin\n   640\t   while legitimate user metadata survives untouched.\"\n   641\t  [x]\n   642\t  (let [x' (cond (record? x) x\n   643\t                 (map? x) (into (empty x)\n   644\t                                (map (fn [[k v]]\n   645\t                                       [(strip-tracking k)\n   646\t                                        (strip-tracking v)]))\n   647\t                                x)\n   648\t                 (set? x) (into (empty x) (map strip-tracking) x)\n   649\t                 (vector? x) (mapv strip-tracking x)\n   650\t                 (sequential? x) (with-meta\n   651\t                                   (apply list (map strip-tracking x))\n   652\t                                   nil)\n   653\t                 :else x)\n   654\t        m (meta x)]\n   655\t    (if m\n   656\t      (let [m' (strip-tracking\n   657\t                 (apply dissoc m tracking-meta-keys))]\n   658\t        (with-meta x' (when-not (and (empty? m') (nil? (meta m'))) m')))\n   659\t      x')))\n   660\t\n   661\t\n   662\t(defn- packet-has-application?\n   663\t  \"True when packet `p` contains an `:application` occurrence, the only\n   664\t   occurrences whose provenance a correspondence ever reads.\"\n   665\t  [p]\n     1\t(ns yang.tails\n     2\t  \"Tail marks over the Universal AST, shared by every stage that builds or\n     3\t   rewrites a tree. A tail call pushes no frame on the VMs that honour the\n     4\t   mark, so a mark is only sound for the tree it was computed over: a stage\n     5\t   that wraps a body must strip every mark and recompute them over the whole\n     6\t   derived tree, or a wrapped body's old tail calls would skip the wrapper.\"\n     7\t  (:require\n     8\t    [yin.vm :as vm]))\n     9\t\n    10\t\n    11\t(defn mark-tails\n    12\t  \"Set `:tail? true` on every application in tail position of a lambda body,\n    13\t   through `if` branches. Definitions are never marked. Lowering relies on\n    14\t   this for loops, which are self-applied lambdas: the recursive call and the\n    15\t   sequencing lambda around it are both tail calls, so an iteration grows no\n    16\t   continuation on the VMs that honour the mark.\"\n    17\t  [node]\n    18\t  (letfn [(walk\n    19\t            [node tail?]\n    20\t            (case (:type node)\n    21\t              :lambda (assoc node :body (walk (:body node) true))\n    22\t              :if (assoc node\n    23\t                         :test (walk (:test node) false)\n    24\t                         :consequent (walk (:consequent node) tail?)\n    25\t                         :alternate (walk (:alternate node) tail?))\n    26\t              :application\n    27\t              (let [definition? (= 'yin/def (:name (:operator node)))\n    28\t                    node (assoc node\n    29\t                                :operator (walk (:operator node) false)\n    30\t                                :operands (mapv #(walk % false)\n    31\t                                                (:operands node)))]\n    32\t                (if (and tail? (not definition?))\n    33\t                  (assoc node :tail? true)\n    34\t                  node))\n    35\t              node))]\n    36\t    (walk node false)))\n    37\t\n    38\t\n    39\t(defn strip-tails\n    40\t  \"`node` with every `:tail?` mark removed, at every depth and under every\n    41\t   node type the row grammar knows, so `mark-tails` starts from nothing.\"\n    42\t  [node]\n    43\t  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\n    44\t    (reduce (fn [n [field kind]]\n    45\t              (case kind\n    46\t                :node (update n field strip-tails)\n    47\t                :nodes (update n field #(mapv strip-tails %))\n    48\t                n))\n    49\t            (dissoc node :tail?)\n    50\t            slots)))\n    51\t\n    52\t\n    53\t(defn remark-tails\n    54\t  \"Strip every tail mark and recompute them over the whole of `node`.\"\n    55\t  [node]\n    56\t  (mark-tails (strip-tails node)))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"The exit-hook error is confirmed by the code: with `:operands true`, the body moves past the hook’s literal arguments, while the tracker still emits a surviving row at operand 0.\n\nThe publication path does record a real admission origin for its wrappers. However, its recovery check ignores the retained table’s admission origin, so I’m examining whether identical trees from different admissions can borrow each other’s proof."}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/query.cljc | sed -n '769,835p'; nl -ba src/cljc/yin/vm/linker/dht.cljc | sed -n '48,100p'; nl -ba src/cljc/yin/repl/index.cljc | sed -n '1,225p'; nl -ba src/cljc/yin/vm/macro.cljc | sed -n '1840,1887p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/query.cljc | sed -n '769,835p'; nl -ba src/cljc/yin/vm/linker/dht.cljc | sed -n '48,100p'; nl -ba src/cljc/yin/repl/index.cljc | sed -n '1,225p'; nl -ba src/cljc/yin/vm/macro.cljc | sed -n '1840,1887p'\"","aggregated_output":"   769\t(defn- link-answer\n   770\t  \"The response to one `yin.link` call, from `node` -- the shell's DHT\n   771\t   node -- and `indexer`, the session's code indexer, under the session\n   772\t   composition `ctx` (`:authority`, `:key`, `:primitives`, `:modules`,\n   773\t   `:round`): `names` answers `yin.vm.linker.dht/names`; `publish` answers\n   774\t   `yin.vm.linker.dht/publish-name!` over the published index, whose\n   775\t   name envelopes the indexer then commits and publishes as one\n   776\t   transaction, the HEAD write announcing the round's publication.  A\n   777\t   refusal is answered under its own reason.  Answers `[node indexer\n   778\t   response]`.\"\n   779\t  [node indexer ctx request]\n   780\t  (let [id (apply2/request-id request)\n   781\t        args (apply2/request-args request)\n   782\t        [indexer answer]\n   783\t        (cond\n   784\t          (nil? node)\n   785\t          [indexer (unavailable (str \"the shell has no DHT node; start it with \"\n   786\t                                     \"--index-store dht:<dir>\"))]\n   787\t\n   788\t          (nil? (encoded-size args))\n   789\t          [indexer (invalid \"yin.link takes portable Yin data only\")]\n   790\t\n   791\t          (= ::link-names (apply2/request-op request))\n   792\t          [indexer {:ok (linker.dht/names node (:authority ctx))}]\n   793\t\n   794\t          :else\n   795\t          (let [[name exports] args\n   796\t                db (when (and (symbol? name) (sequential? exports)\n   797\t                              (every? symbol? exports))\n   798\t                     (snapshot indexer))]\n   799\t            (cond\n   800\t              (nil? db)\n   801\t              [indexer (invalid (str \"yin.link/publish expects a module name \"\n   802\t                                     \"and a vector of export names, got \"\n   803\t                                     (pr-str args)))]\n   804\t\n   805\t              (refused? db) [indexer db]\n   806\t\n   807\t              :else\n   808\t              (let [[linked hosts] (session-modules (:modules ctx))\n   809\t                    res (linker.dht/publish-name!\n   810\t                          node db {:name name\n   811\t                                   :exports (vec exports)\n   812\t                                   :key (:key ctx)\n   813\t                                   :primitives (:primitives ctx)\n   814\t                                   :modules linked\n   815\t                                   :host-modules hosts})\n   816\t                    indexer' (if (seq (:envelopes res))\n   817\t                               (repl.index/commit-names indexer (:envelopes res)\n   818\t                                                        (:round ctx))\n   819\t                               indexer)]\n   820\t                (cond\n   821\t                  (= :refused (:status res))\n   822\t                  [indexer (refusal (:reason res)\n   823\t                                    (str \"yin.link/publish refused: \"\n   824\t                                         (pr-str (dissoc res :status :reason)))\n   825\t                                    nil)]\n   826\t\n   827\t                  (not= (:failure indexer) (:failure indexer'))\n   828\t                  [indexer' (unavailable \"the name assertion was not indexed\")]\n   829\t\n   830\t                  :else\n   831\t                  [indexer'\n   832\t                   {:ok {:module name\n   833\t                         :address (:address res)\n   834\t                         :links (into {}\n   835\t                                      (map (fn [[f o]]\n    48\t   it.\"\n    49\t  [node spec]\n    50\t  (publish/publish-module! (dht/store node) spec))\n    51\t\n    52\t\n    53\t(defn publish-name!\n    54\t  \"Publish the module `name` exporting `exports`, derived from the\n    55\t   publisher's own index `db` (`module-from-index`, section 5.3), through\n    56\t   the node's store, and sign what binds the name to it (6.6): answers\n    57\t   `{:status :ok :address a :links {...} :envelopes [...]}`, each envelope\n    58\t   `publish/assertion`'s answer, for the caller to enter into its index\n    59\t   as one transaction (6.1) before it announces.  Without `key` it is\n    60\t   refused `:yin.link.publish/no-key`; any refusal writes nothing.\n    61\t   `opts` also carries `module-from-index`'s `:primitives`, `:modules`\n    62\t   and `:host-modules`.\"\n    63\t  [node db {:keys [key name] :as opts}]\n    64\t  (if-not key\n    65\t    (refused :yin.link.publish/no-key {:name name})\n    66\t    (let [spec (publish/module-from-index db opts)\n    67\t          res (if (= :refused (:status spec)) spec (publish! node spec))]\n    68\t      (if (= :refused (:status res))\n    69\t        res\n    70\t        (assoc (select-keys res [:address :links])\n    71\t               :status :ok\n    72\t               :envelopes (publish/name-envelopes db key name (:address res)))))))\n    73\t\n    74\t\n    75\t;; =============================================================================\n    76\t;; The module load (4.3)\n    77\t;; =============================================================================\n    78\t\n    79\t(defn closure-walk\n    80\t  \"The closure walk of `manifest-address` as a `dao.space.dht` load walk:\n    81\t   the walker's three outcomes in the load's three shapes.\"\n    82\t  [manifest-address]\n    83\t  (fn [handle]\n    84\t    (let [w (closure/walk handle manifest-address)]\n    85\t      (case (:yin.link.closure/outcome w)\n    86\t        :missing {::dht/walk :missing :address (:address w)}\n    87\t        :complete {::dht/walk :complete :value w}\n    88\t        :invalid {::dht/walk :invalid :address (:address w) :defect (:defect w)}))))\n    89\t\n    90\t\n    91\t(defn load-module\n    92\t  \"Start loading the closure of `manifest-address` onto `node`; answers\n    93\t   the node.  `dao.space.dht/step` fetches what is missing.\"\n    94\t  [node manifest-address]\n    95\t  (dht/load node manifest-address {:kind module-kind\n    96\t                                   :walk (closure-walk manifest-address)}))\n    97\t\n    98\t\n    99\t(defn module-status\n   100\t  \"The load status of `manifest-address` (4.3), or nil.\"\n     1\t(ns yin.repl.index\n     2\t  \"The shell's code indexer: a `dao.space.index` observer on `program-out`\n     3\t   (docs/design/yin.repl.dao.space-index.md).\n     4\t\n     5\t   It is a peer of the evaluator's observer on the same medium, attached\n     6\t   independently and advanced by the evaluation round, never by the\n     7\t   evaluator: neither knows the other.  Each expanded tree packet `[root\n     8\t   rows]` it observes is projected to local `[e a v t m]` AST facts\n     9\t   (yin.vm.code-as-tuples.md §6.5) and committed as ONE atomic transaction\n    10\t   record through a `dao.space.transactor`, which allocates `t`; this\n    11\t   namespace supplies no clock.  Every row of a committed packet is\n    12\t   materialized into the `dao.jing` store in the same round, so its\n    13\t   `:yin/address` facts name content the store holds (yin.vm.linker.dht.md\n    14\t   5.1, rows every round).  After a round that committed, the covered\n    15\t   indexes are published through `dao.space.index` into that round's\n    16\t   own fresh intake, the intake is drained into the `dao.jing` store, the\n    17\t   manifest is read back, and the intake is dropped. Between rounds the\n    18\t   composition retains the transactor's allocator and a verified covered\n    19\t   frontier: its log cursor, manifest and transaction count. Each fresh\n    20\t   publication folds only the committed suffix into the previous covered\n    21\t   roots and emits their dirty subgraph through `dao.space.index`.\n    22\t\n    23\t   Publication still completes synchronously every evaluation. Initial\n    24\t   publication and recovery reconstruct the full authoritative history;\n    25\t   no saved process cursor or allocator is trusted on restart. Incremental\n    26\t   tree mutation removes repeated prefix construction, but does not promise\n    27\t   a fixed wall-time bound on hashing, storage or other round work.\n    28\t\n    29\t   Every `e` is a transactor-local entity id; the only durable name in the\n    30\t   projection is the `:yin/address` fact each node occurrence carries back\n    31\t   to its row address.  `m` is a local metadata entity, one per program,\n    32\t   carrying `:db/op`, the shell's stable session token, the program's root\n    33\t   address, and the round.  Only code is indexed: no printed output, last\n    34\t   value, or evaluation result enters.\n    35\t\n    36\t   Loss is reported, never hidden, and never stops the evaluator (owner\n    37\t   ruling, 2026-09-28): a gap is counted on the observer (`:ingress-gaps`)\n    38\t   and marks the indexer `:lost?`, after which it consumes packets without\n    39\t   indexing any until reset rebuilds it; a packet that could not be\n    40\t   committed, or a publication that did not become readable, is recorded\n    41\t   under `:failure`, never counted as indexed.  `notice` renders what a\n    42\t   round lost for the shell's round result, and `status` is the\n    43\t   evaluator-independent view `repl-state` reports.  Everything here is a\n    44\t   session-composition value; reset and VM selection rebuild it with the\n    45\t   session.  Over a durable store a new process's indexer is seeded from\n    46\t   the recovered snapshot (`rehydrate`), and a rebuilt session's continues\n    47\t   the old one's index (`carry-over`), so `t` and entity allocation never\n    48\t   restart there.\"\n    49\t  (:require [dao.datom :as datom]\n    50\t            [dao.jing :as jing]\n    51\t            [dao.space.index :as index]\n    52\t            [dao.space.transactor :as transactor]\n    53\t            [dao.stream :as stream]\n    54\t            [dao.stream.memory-log :as memory-log]\n    55\t            [dao.stream.observer :as observer]\n    56\t            [yin.vm :as vm]\n    57\t            [yin.vm.macro :as macro]))\n    58\t\n    59\t\n    60\t;; =============================================================================\n    61\t;; The §6.5 projection\n    62\t;; =============================================================================\n    63\t\n    64\t(defn- assign-local-ids\n    65\t  \"Give every node occurrence of `node`, the map AST rebuilt from row `id`,\n    66\t   a fresh local entity id as its `:eid`, pairing it with its row through\n    67\t   the §2.3 slot table.  Distinct occurrences of one shared row get distinct\n    68\t   ids, so `vm/ast->datoms` emits every occurrence exactly as it does for a\n    69\t   tree without `:eid`s.  `acc` is `[next-e addresses]`; answers\n    70\t   `[node' acc']`, `addresses` mapping each id to its row address.\"\n    71\t  [rows node id [next-e addresses]]\n    72\t  (let [row (get rows id)\n    73\t        slots (get vm/semantic-bytecode-grammar (:type node))\n    74\t        child (fn [acc child-node child-id]\n    75\t                (assign-local-ids rows child-node child-id acc))]\n    76\t    (reduce\n    77\t      (fn [[node acc] [i [field kind]]]\n    78\t        (let [slot (nth row (+ 2 i))]\n    79\t          (case kind\n    80\t            :node (let [[c acc'] (child acc (get node field) slot)]\n    81\t                    [(assoc node field c) acc'])\n    82\t            :nodes (let [[cs acc']\n    83\t                         (reduce (fn [[cs acc] [c cid]]\n    84\t                                   (let [[c' acc'] (child acc c cid)]\n    85\t                                     [(conj cs c') acc']))\n    86\t                                 [[] acc]\n    87\t                                 (map vector (get node field) slot))]\n    88\t                     [(assoc node field cs) acc'])\n    89\t            [node acc])))\n    90\t      [(assoc node :eid next-e) [(inc next-e) (assoc addresses next-e id)]]\n    91\t      (map-indexed vector slots))))\n    92\t\n    93\t\n    94\t(defn packet->tx-data\n    95\t  \"Project one expanded tree packet to transactor tx-data, allocating local\n    96\t   entity ids from `next-e`.  `provenance` is `{:session-token s :round r}`.\n    97\t\n    98\t   Answers `{:tx-data [...] :next-e n :meta-e m :root root}`: the metadata\n    99\t   entity's facts, then `vm/ast->datoms` of the expanded tree under `m`,\n   100\t   then one `[e :yin/address addr]` per node occurrence.  Every datom leaves\n   101\t   `t` nil, which the transactor stamps.\"\n   102\t  [packet next-e {:keys [session-token round]}]\n   103\t  (let [{:keys [root rows], :as row-set} (macro/packet->row-set packet)\n   104\t        meta-e next-e\n   105\t        [ast [next-e' addresses]] (assign-local-ids\n   106\t                                    rows\n   107\t                                    (vm/semantic-bytecode->ast row-set)\n   108\t                                    root\n   109\t                                    [(inc meta-e) {}])\n   110\t        facts (vm/ast->datoms ast {:m meta-e})\n   111\t        untimed (fn [e a v m] [e a v nil m])]\n   112\t    (when-let [stray (some (fn [[e]] (when (neg? e) e)) facts)]\n   113\t      (throw (ex-info \"projected node escaped local id assignment\"\n   114\t                      {:e stray, :root root})))\n   115\t    {:tx-data (-> [(untimed meta-e :db/op :db/assert datom/default-op)\n   116\t                   (untimed meta-e :yin.repl/session session-token\n   117\t                            datom/default-op)\n   118\t                   (untimed meta-e :yin.repl/root root datom/default-op)\n   119\t                   (untimed meta-e :yin.repl/round round datom/default-op)]\n   120\t                  (into (map (fn [[e a v _t m]] (untimed e a v m))) facts)\n   121\t                  (into (map (fn [[e addr]]\n   122\t                               (untimed e :yin/address addr meta-e)))\n   123\t                        (sort-by key addresses))),\n   124\t     :next-e next-e',\n   125\t     :meta-e meta-e,\n   126\t     :root root\n   127\t     :row-set row-set}))\n   128\t\n   129\t\n   130\t;; =============================================================================\n   131\t;; The indexer value\n   132\t;; =============================================================================\n   133\t\n   134\t(defn- memory-log\n   135\t  []\n   136\t  (:dao.stream/handle\n   137\t    (memory-log/create! {:dao.stream/type memory-log/transport-type})))\n   138\t\n   139\t\n   140\t(defn make-indexer\n   141\t  \"The indexer for one session: `observer`, attached to `program-out`\n   142\t   beside the evaluator's; `:local`, the complete-retention log its\n   143\t   transactions are committed to (dao.space.transactor requires memory-log\n   144\t   retention); and `content-store`, the `dao.jing` byte store publications\n   145\t   materialize into.  `session-token` is the shell's stable token, recorded\n   146\t   as provenance; `publish-opts` reach `transactor/publish!` as-is.\n   147\t\n   148\t   `after-publish` is `(fn [manifest-address])`, called after a round's\n   149\t   manifest is read back from the store and before the round is reported\n   150\t   published: the durable store's HEAD write, which is what makes the\n   151\t   round durably published (docs/design/yin.repl.dao.space-index.md).\n   152\t   Nil — the memory store — publishes exactly as before.\n   153\t\n   154\t   `:allocator` retains only the transactor authority, with its intake\n   155\t   detached. `:materialization` retains verified coverage as plain data:\n   156\t   `{:cursor c :transactions n :manifest-address a :manifest m :max-t t}`.\n   157\t   A round's fresh `:publication` intake, pool and tree builder are dropped\n   158\t   at its end; no earlier publication payload is retained.\"\n   159\t  [{:keys [observer session-token content-store publish-opts after-publish]}]\n   160\t  {:observer observer\n   161\t   :local (memory-log)\n   162\t   :content-store content-store\n   163\t   :session-token session-token\n   164\t   :publish-opts publish-opts\n   165\t   :after-publish after-publish\n   166\t   :next-e datom/first-user-id\n   167\t   :transactions 0\n   168\t   :published 0\n   169\t   :published-payloads 0\n   170\t   :manifest-address nil\n   171\t   :allocator nil\n   172\t   :materialization nil\n   173\t   :lost? false\n   174\t   :failure nil})\n   175\t\n   176\t\n   177\t(defn- next-entity-id\n   178\t  \"One greater than the greatest entity or metadata-entity id `datoms`\n   179\t   use, never below `datom/first-user-id`.\"\n   180\t  [datoms]\n   181\t  (reduce (fn [next-e [e _a _v _t m]]\n   182\t            (cond-> next-e\n   183\t              (integer? e) (max (inc e))\n   184\t              (integer? m) (max (inc m))))\n   185\t          datom/first-user-id\n   186\t          datoms))\n   187\t\n   188\t\n   189\t(defn rehydrate\n   190\t  \"Seed a fresh indexer from a recovered durable snapshot, `{:manifest\n   191\t   address :datoms [...]}` (yin.repl.store's `:recovery`), before any\n   192\t   evaluation is admitted.  Its log becomes a fresh complete-retention\n   193\t   memory log holding the recovered datoms as transaction records, one\n   194\t   per original `t` in ascending order, each datom and its `t` preserved,\n   195\t   so a new transactor derives the next `t` from it. Entity\n   196\t   allocation resumes one past the greatest restored entity or metadata\n   197\t   id.  The manifest is the published one, covering every restored\n   198\t   transaction, so `q` answers from it before anything new is evaluated.\n   199\t   Restored facts keep their original session tokens and round metadata:\n   200\t   they are the datoms as committed.  A recovery without a manifest is an\n   201\t   empty index. Live allocation and publication successors are always\n   202\t   discarded, including any stale or foreign cursor: the first subsequent\n   203\t   publication takes the full reconstruction path and derives a new cursor\n   204\t   from this log, never from a saved process checkpoint.\"\n   205\t  [indexer {:keys [manifest datoms]}]\n   206\t  (if (nil? manifest)\n   207\t    (assoc indexer :allocator nil :materialization nil)\n   208\t    (let [log (memory-log)\n   209\t          by-t (group-by index/datom-t datoms)\n   210\t          ts (sort (keys by-t))]\n   211\t      (doseq [t ts]\n   212\t        (let [answer (stream/append! log {:dao.space/transaction\n   213\t                                          {:t t, :datoms (vec (get by-t t))}})]\n   214\t          (when-not (= :dao.stream/ok (:dao.stream/outcome answer))\n   215\t            (throw (ex-info \"the recovered snapshot could not be rehydrated\"\n   216\t                            {:t t, :outcome answer})))))\n   217\t      (assoc indexer\n   218\t             :local log\n   219\t             :next-e (next-entity-id datoms)\n   220\t             :transactions (count ts)\n   221\t             :published (count ts)\n   222\t             :allocator nil\n   223\t             :materialization nil\n   224\t             :manifest-address manifest))))\n   225\t\n  1840\t\n  1841\t\n  1842\t(defn call-site-table\n  1843\t  \"The C1 side table the consumer `expander` holds for the occurrence\n  1844\t   the executed tree packet `tree` names — `origin` being the admission\n  1845\t   origin the table was stored under (§2.1: an application site is\n  1846\t   K = [origin root-address path]; the table's key is the admission\n  1847\t   origin beside the root address, while each row's own origin names\n  1848\t   that occurrence's admission or generating expansion record) — or nil when\n  1849\t   that occurrence made no C1 claim. Two expansions can produce the\n  1850\t   SAME final root from different admissions; keying by the full\n  1851\t   occurrence identity keeps their tables distinct, so resolving by the\n  1852\t   origin+root pair at hand never answers another execution's table,\n  1853\t   however many loads have run since, and an unclaimed load of a root\n  1854\t   previously loaded under a claim retrieves no stale table.\"\n  1855\t  [expander tree origin]\n  1856\t  (get (:call-site-tables expander) [origin (first tree)]))\n  1857\t\n  1858\t\n  1859\t(defn load\n  1860\t  \"Expand one observed batch once: keep the returned context, stage the\n  1861\t   tree only on success, stage the log when a log writer exists, and\n  1862\t   accumulate the error of a failed expansion. Expansion failure is\n  1863\t   data, so the cursor advances past it. A successful expansion's C1\n  1864\t   side table (the batch result's `:frontend-metadata`, present only\n  1865\t   when the selected member itself claimed coverage) is retained on the\n  1866\t   consumer under the occurrence identity of the staged tree — its\n  1867\t   admission origin beside its final root address (`call-site-tables`,\n  1868\t   resolved by `call-site-table`) — so the composition that drives this\n  1869\t   expander — the REPL's session — holds every executed occurrence's\n  1870\t   coverage beside the expander that produced it, each load's table\n  1871\t   surviving the next, even when two loads land on the same root.\"\n  1872\t  [expander batch]\n  1873\t  (let [{:keys [status tree log error ctx frontend-metadata\n  1874\t                call-site-origin]}\n  1875\t        (expand-batch batch (:ctx expander))]\n  1876\t    (cond-> (assoc expander :ctx ctx)\n  1877\t      (= :ok status) (assoc :out-staged tree)\n  1878\t      (and (= :ok status) frontend-metadata)\n  1879\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n  1880\t                frontend-metadata)\n  1881\t      (:log expander) (assoc :log-staged log)\n  1882\t      (= :error status) (update :errors conj error))))\n  1883\t\n  1884\t\n  1885\t(defn- flush-slot\n  1886\t  [expander writer-key slot-key on-ok]\n  1887\t  (if-let [payload (get expander slot-key)]\n","exit_code":0,"status":"completed"}}
