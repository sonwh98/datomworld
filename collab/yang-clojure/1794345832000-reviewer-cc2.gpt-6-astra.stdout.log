acket\n   794\t  ([v] (literal-packet v nil))\n   795\t  ([v lineage] (construct [:literal (strip-tracking v)] [] lineage)))\n   796\t\n   797\t\n   798\t(defn- application-packet\n   799\t  ([operator operands] (application-packet operator operands nil))\n   800\t  ([operator operands lineage]\n   275\t(defn- check-call-site-claim!\n   276\t  \"Refuse a batch member whose C1 markers do not exactly cover its\n   277\t   projected tree, naming the failed `:rule`: canonical-row production\n   278\t   must not silently drop a frontend's coverage claim. The claim is\n   279\t   checked root-relatively — admission origins belong to the admitting\n   280\t   expander, not to this projection. A member carrying no markers\n   281\t   makes no claim and passes; the executed tree's table is finalized\n   282\t   after expansion, over the final rows. Answers true when the member\n   283\t   claimed coverage (it passed the check), false when it carried no\n   284\t   markers — one verdict per member, so the selected member's own\n   285\t   verdict, never a sibling's, decides whether the expander finalizes\n   286\t   its side table.\"\n   287\t  [ast tree]\n   288\t  (let [marked (marked-call-sites ast)]\n   289\t    (if (seq marked)\n   290\t      (do (doseq [[path value] marked]\n   291\t            (when (not= 1 value)\n   292\t              (throw (ex-info \"Unsupported call-site marker version\"\n   293\t                              {:rule :yang/call-site-unsupported-version,\n   294\t                               :path path, :value value}))))\n   295\t          (let [eligible (into #{} (map second) (vm/application-occurrences tree))\n   296\t                claimed (into #{} (map first) marked)]\n   297\t            (when (not= eligible claimed)\n   298\t              (throw (ex-info \"Call-site markers do not cover the projected tree\"\n   299\t                              {:rule :yang/call-site-incomplete-coverage,\n   300\t                               :missing (v