sym) {})\n  1209\t                                                            source-position-keys))]\n  1210\t                                  [[field i k] v]))\n  1211\t                              (range) value)\n  1212\t                      nil)))\n  1213\t                slots)]\n  1214\t    (concat own names)))\n  1215\t\n  1216\t\n  1217\t(defn ast-side-tables\n  1218\t  \"Project occurrence-owned frontend facts from a map AST without putting\n  1219\t   them in canonical rows. Returns the §2.5 relations\n  1220\t   `{:source-positions [[origin root path file line col] ...]\n  1221\t     :frontend-metadata [[origin root path key value] ...]}`.\n  1222\t\n  1223\t   `bc` must be the projection of `ast`; its root makes both relations join\n  1224\t   the canonical row and occurrence relations. Structural paths use the same\n  1225\t   row positions as `occurrences` and lowering.\"\n  1226\t  [ast bc origin]\n  1227\t  (when-not (occurrence-origin? origin)\n  1228\t    (throw (ex-info \"Side tables require a ruled occurrence origin\"\n  1229\t                    {:rule :origin, :origin origin})))\n  1230\t  (let [root (:root bc)\n  1231\t        positions (atom [])\n  1232\t        metadata (atom [])]\n  1233\t    (letfn [(visit\n  1234\t              [node path]\n  1235\t              (let [tag (:type node)\n  1236\t                    slots (or (get semantic-bytecode-grammar tag)\n  1237\t                              (throw (ex-info \"Unknown AST node type\"\n  1238\t                                              {:type tag, :node node})))\n  1239\t                    position (reader-position node)]\n  1240\t                (when position\n  1241\t                  (swap! positions conj\n  1242\t                         [origin root path (:file position) (:line position)\n  1243\t                          (:column position)]))\n  1244\t                (doseq [[k v] (frontend-meta-entries tag node)]\n  1245\t                  (when-not (and (plain-data? k) (plain-data? v))\n  1246\t                    (throw (ex-info \"Frontend metadata is not plain data\"\n  1247\t                                    {:rule :frontend-metadata, :path path,\n  1248\t                                     :key k, :value v})))\n  1249\t                  (swap! metadata conj [origin root path k v]))\n  1250\t                (doseq [[j [field kind]] (map-indexed vector slots)\n  1251\t                        :let [pos (+ j 2)\n  1252\t                              value (get node field)]]\n  1253\t                  (case kind\n  1254\t                    :node (visit value (conj path pos))\n  1255\t                    :nodes (doseq [[i child] (map-indexed vector value)]\n  1256\t                             (visit child (conj path [pos i])))\n  1257\t                    nil))))]\n  1258\t      (visit ast [])\n  1259\t      {:source-positions @positions, :frontend-metadata @metadata})))\n  1260\t\n  1261\t\n  1262\t(defn- semantic-bytecode-slot-kind-ok?\n  1263\t  \"§2.2/§7.4 `:slot-kind`: whether `v` conforms to slot `kind`.\"\n  1264\t  [kind v]\n     1\t(ns yin.vm.encoder\n     2\t  \"The encoder observer: the `run-on-stream` consumer the composition\n     3\t   attaches over the program medium so the semantic VM never sees a map AST\n     4\t   or a datom batch (§9.1, `docs/design/yin.vm.code-as-tuples.md`).\n     5\t\n     6\t   It is a stage in its own right, not a loader arm. The composition hands\n     7\t   its session the row medium's writer as the consumer; `run-on-stream`\n     8\t   hands it each observed program batch; it projects the batch to the\n     9\t   canonical row set and forwards it — appends it to the row medium. The\n    10\t   evaluator observer the composition attaches to that row medium\n    11\t   independently is the next stage: the two never call each other, they\n    12\t   communicate through the row medium alone, so compiler and evaluator stay\n    13\t   independently attachable (no direct function-to-function coupling\n    14\t   without a stream boundary).\n    15\t\n    16\t   Projection is this boundary's one job (§9.1): the map AST the frontends\n    17\t   emit projects directly through `yin.vm/ast->semantic-bytecode`; a\n    18\t   `:yin/*` datom batch projects through the explicit datom→row adapter\n    19\t   below — §7.1's projection path, for media that carry datoms.\"\n    20\t  (:require [dao.stream :as stream]\n    21\t            [dao.stream.observer :as observer]\n    22\t            [yin.vm :as vm]))\n    23\t\n    24\t\n    25\t(defn source-envelope\n    26\t  \"Construct the provenance-bearing input value ruled by D4. The admitting\n    27\t   composition supplies its program medium's logical identity and mints a\n    28\t   fresh batch token before append. `members` is ordered and `root` selects\n    29\t   the member the evaluator runs. The constructor validates but never mints:\n    30\t   retries of an unaccepted staged append must retain the caller's token.\"\n    31\t  ([source-medium batch-token members]\n    32\t   (source-envelope source-medium batch-token members 0))\n    33\t  ([source-medium batch-token members root]\n    34\t   (let [envelope {:yin/source-medium source-medium\n    35\t                   :yin/batch-token batch-token\n    36\t                   :yin/batch (vec members)\n    37\t                   :yin/root root}]\n    38\t     ;; Validating the root origin validates the two opaque coordinates too.\n    39\t     (when-not (and (integer? root) (<= 0 root) (< root (count members)))\n    40\t       (throw (ex-info \"Malformed source batch envelope\"\n    41\t                       {:rule :batch-envelope, :envelope envelope})))\n    42\t     (vm/source-origin source-medium batch-token root)\n    43\t     envelope)))\n    44\t\n    45\t\n    46\t(defn- datom-child-places\n    47\t  [get-attr eid]\n    48\t  (case (get-attr eid :yin/type)\n    49\t    :lambda [[3 (get-attr eid :yin/body)]]\n    50\t    :application (concat [[2 (get-attr eid :yin/operator)]]\n    51\t                         (map-indexed (fn [i child] [[3 i] child])\n    52\t                                      (get-attr eid :yin/operands)))\n    53\t    :if [[2 (get-attr eid :yin/test)]\n    54\t         [3 (get-attr eid :yin/consequent)]\n    55\t         [4 (get-attr eid :yin/alternate)]]\n    56\t    :dao.stream.apply/call\n    57\t    (map-indexed (fn [i child] [[3 i] child])\n    58\t                 (get-attr eid :yin/operands))\n    59\t    :stream/put [[2 (get-attr eid :yin/target)]\n    60\t                 [3 (get-attr eid :yin/val-node)]]\n    61\t    (:stream/cursor :stream/next :stream/close)\n    62\t    [[2 (get-attr eid :yin/source)]]\n    63\t    :vm/resume [[3 (get-attr eid :yin/val-node)]]\n    64\t    []))\n    65\t\n    66\t\n    67\t(defn datom-entity-occurrences\n    68\t  \"The §9.1 datom adapter's path/entity relation for one admitted member:\n    69\t   `[member-index path entity-id]` once per structural occurrence. Shared\n    70\t   entities therefore appear at every path while retaining one entity\n    71\t   identity, which is the information U16's harvest catalogue derives from.\n    72\t   Cyclic or dangling legacy graphs fail at this boundary.\"\n    73\t  [datoms member-index]\n    74\t  (let [{:keys [root-id get-attr error]} (vm/index-datoms datoms)]\n    75\t    (when error\n    76\t      (throw (ex-info \"Cannot adapt a datom batch with a dangling root\" error)))\n    77\t    (when (nil? root-id)\n    78\t      (throw (ex-info \"Cannot adapt a datom batch with no root\"\n    79\t                      {:rule :root})))\n    80\t    (letfn [(walk\n    81\t              [eid path active]\n    82\t              (when (contains? active eid)\n    83\t                (throw (ex-info \"Cannot adapt a cyclic datom AST\"\n    84\t                                {:rule :cycle, :entity eid, :path path})))\n    85\t              (when (nil? (get-attr eid :yin/type))\n    86\t                (throw (ex-info \"Cannot adapt a dangling datom AST reference\"\n    87\t                                {:rule :dangling-ref, :entity eid, :path path})))\n    88\t              (into [[member-index path eid]]\n    89\t                    (mapcat (fn [[step child]]\n    90\t                              (walk child (conj path step) (conj active eid))))\n    91\t                    (datom-child-places get-attr eid)))]\n    92\t      (vec (walk root-id [] #{})))))\n    93\t\n    94\t\n    95\t(defn datoms->rows\n    96\t  \"§7.1's projection path as an explicit adapter: a `:yin/*` datom batch\n    97\t   reconstructs its map AST (`vm/datoms->ast`), then projects like every\n    98\t   other batch — the datom→row half of the §9.1 codec pair.\"\n    99\t  [datoms]\n   100\t  (vm/ast->semantic-bytecode (vm/datoms->ast datoms)))\n   101\t\n   102\t\n   103\t(declare check-projected-claim!)\n   104\t\n   105\t\n   106\t(defn- project-member\n   107\t  [member origin member-index]\n   108\t  (cond\n   109\t    (and (map? member) (contains? member :type))\n   110\t    (let [tree (vm/ast->semantic-bytecode member)]\n   111\t      (merge {:tree tree, :entity-occurrences []}\n   112\t             (vm/ast-side-tables member tree origin)))\n   113\t\n   114\t    (and (map? member) (contains? member :root) (contains? member :rows))\n   115\t    (let [metadata (:frontend-metadata member)]\n   116\t      (when (and (some? metadata) (not (sequential? metadata)))\n   117\t        (throw (ex-info \"Supplied frontend-metadata is not a row sequence\"\n   118\t                        {:rule :frontend-metadata, :member-index member-index,\n   119\t                         :metadata metadata})))\n   120\t      (check-projected-claim! metadata member)\n   121\t      {:tree member,\n   122\t       :source-positions (vec (or (:source-positions member) [])),\n   123\t       :frontend-metadata (vec (or metadata [])),\n   124\t       :entity-occurrences []})\n   125\t\n   126\t    (sequential? member)\n   127\t    (let [datoms (vec member)\n   128\t          ast (vm/datoms->ast datoms)\n   129\t          tree (vm/ast->semantic-bytecode ast)]\n   130\t      (merge {:tree tree\n   131\t              :entity-occurrences (datom-entity-occurrences datoms member-index)}\n   132\t             (vm/ast-side-tables ast tree origin)))\n   133\t\n   134\t    :else\n   135\t    (throw (ex-info \"Unsupported source batch member\"\n   136\t                    {:rule :batch-member, :member member,\n   137\t                     :member-index member-index}))))\n   138\t\n   139\t\n   140\t(defn- project-envelope\n   141\t  [{:yin/keys [source-medium batch-token batch root] :as envelope}]\n   142\t  (when-not (and (vector? batch)\n   143\t                 (seq batch)\n   144\t                 (integer? root)\n   145\t                 (<= 0 root)\n   146\t                 (< root (count batch)))\n   147\t    (throw (ex-info \"Malformed source batch envelope\"\n   148\t                    {:rule :batch-envelope, :envelope envelope})))\n   149\t  (let [projected (mapv (fn [j member]\n   150\t                          (project-member member\n   151\t                                          (vm/source-origin source-medium\n   152\t                                                            batch-token j)\n   153\t                                          j))\n   154\t                        (range) batch)]\n   155\t    (assoc envelope\n   156\t           :yin/batch (mapv :tree projected)\n   157\t           :yin/source-positions (into [] (mapcat :source-positions) projected)\n   158\t           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\n   159\t           :yin/entity-occurrences (into [] (mapcat :entity-occurrences) projected))))\n   160\t\n   161\t\n   162\t(defn project\n   163\t  \"One program-medium batch to its canonical row set `{:root id, :rows …}`\n   164\t   (§6.1). A batch that is neither a map AST nor a datom batch is a defect\n   165\t   of the medium and throws here, at the boundary, naming where it failed.\"\n   166\t  [batch]\n   167\t  (cond\n   168\t    (and (map? batch) (contains? batch :yin/batch))\n   169\t    (project-envelope batch)\n   170\t\n   171\t    (map? batch) (vm/ast->semantic-bytecode batch)\n   172\t    :else (datoms->rows batch)))\n   173\t\n   174\t\n   175\t;; =============================================================================\n   176\t;; The macro expander's input batch (yin.vm.macro.md §2.1, §10.2)\n   177\t;; =============================================================================\n   178\t\n   179\t(defn- definition-name\n   180\t  \"The name of a `(yin/def <literal-symbol> value)` AST node (§2.2), else nil.\"\n   181\t  [{:keys [type operator operands]}]\n   182\t  (when (and (= :application type)\n   183\t             (= :variable (:type operator))\n   184\t             (= 'yin/def (:name operator))\n   185\t             (= 2 (count operands))\n","exit_code":0,"status":"completed"}}
