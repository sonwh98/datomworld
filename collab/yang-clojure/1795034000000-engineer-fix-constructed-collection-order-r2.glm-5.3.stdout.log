{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_bf955eb0a0b2418c9b3a3675","type":"tool_result","content":"495\t            (keys form) (vals form))\n496\t       (sort jing/canonical-compare)\n497\t       vec))\n498\t\n499\t(deftest order-pairing-multiplicity-oracle-test\n500\t  (testing \"pairs stay intact, the seed stays first, the pair vector sorts\"\n501\t    (doseq [form [{:a (list '+ 'n 1), :b (list '+ 'n 2)}\n502\t                  {(list 'first 'xs) :v, :k [1 (list '+ 'n 3)]}\n503\t                  {:x #{(list '+ 'n 4)}, :y {:in (list '+ 'n 5)}}]\n504\t            ;; the outermost constructor: the walk collects innermost first\n505\t            :let [ctor (last (map-constructors (yang/compile form)))\n506\t                  roots (child-roots ctor)\n507\t                  pairs (pair-keys ctor)]]\n508\t      (is (= empty-map-seed-root (first roots)))\n509\t      (is (odd? (count roots)))\n510\t      (is (= (+ 1 (* 2 (count form))) (count roots)))\n511\t      (is (ascending? pairs))\n512\t      (is (= (independent-pair-keys form)\n513\t             (vec (sort jing/canonical-compare pairs)))\n514\t          \"the emitted pairs are exactly the independently compiled source\n515\t           pairs, none lost or mixed\")))\n516\t  (testing \"the value root breaks equal key roots\"\n517\t    ;; two NaN keys are never = to each other (both survive the host map)\n518\t    ;; and the codec makes every NaN one quiet NaN, so both compile to one\n519\t    ;; key code: only the value root can order these pairs\n520\t    (let [form (assoc {} ##NaN :left ##NaN (list '+ 'n 1))\n521\t          ctor (last (map-constructors (yang/compile form)))\n522\t          pairs (pair-keys ctor)]\n523\t      (is (= 2 (count pairs)) (str \"both NaN entries survive: \" (count pairs)))\n524\t      (is (ascending? pairs))\n525\t      (is (= (first (first pairs)) (first (second pairs))))\n526\t      (is (= (mapv second pairs)\n527\t             (vec (sort jing/canonical-compare (mapv second pairs)))))))\n528\t  (testing \"identical compiled pairs tie without occurrence loss\"\n529\t    (let [form (assoc {} ##NaN (list '+ 'n 0) ##NaN (list '+ 'n 0))\n530\t          ctor (last (map-constructors (yang/compile form)))\n531\t          pairs (pair-keys ctor)]\n532\t      (is (= 2 (count pairs)))\n533\t      (is (= (first pairs) (second pairs)))\n534\t      (is (= 5 (count (:operands ctor))) \"seed plus both pair occurrences\")))\n535\t  (testing \"identical compiled set elements tie without occurrence loss\"\n536\t    ;; A whole-element tie needs two host-unequal elements with one\n537\t    ;; compiled content: two NaNs are the only such pair, and every host\n538\t    ;; set constructor available to the form API (reader, conj, into,\n539\t    ;; hash-set) collapses them, so the tie is unconstructable at the\n540\t    ;; emitter's input boundary -- recorded as the boundary, never\n541\t    ;; silently skipped. What IS reachable is occurrence preservation of\n542\t    ;; equal compiled subtrees inside one set:\n543\t    (let [inner (list '+ 'n 0)\n544\t          form #{inner (list '+ 'n 1)}\n545\t          ctor (first (collection-applications (yang/compile form)))\n546\t          keys (element-keys ctor)]\n547\t      (is (= 2 (count keys)))\n548\t      (is (ascending? keys))\n549\t      (is (= 3 (count (:operands ctor))))))\n550\t  (testing \"source-position and node metadata never choose the order\"\n551\t    (let [plain {:a (list '+ 'n 1), :b (list '+ 'n 2)}\n552\t          positioned (with-meta plain {:line 3 :column 4 :end-line 3 :end-column 9})\n553\t          noted (with-meta plain {:note :source-form})\n554\t          value-meta {(with-meta (list '+ 'n 1) {:line 8}) :a\n555\t                      (list '+ 'n 2) :b}\n556\t          snap (fn [f] (compile-snapshot f))\n557\t          ctor-roots (fn [f] (child-roots (first (map-constructors (yang/compile f)))))]\n558\t      (is (= (snap plain) (snap positioned)))\n559\t      (is (= (snap plain) (snap noted)))\n560\t      (is (= (ctor-roots plain) (ctor-roots positioned)))\n561\t      (is (= (ctor-roots plain) (ctor-roots noted)))\n562\t      (is (ascending? (pair-keys (first (map-constructors (yang/compile value-meta))))))))\n563\t  (testing \"semantic metadata in literal payloads stays content\"\n564\t    (let [with-sem {(list 'quote (with-meta [1 2] {:sem true})) (list '+ 'n 1)\n565\t                    :plain 2}\n566\t          without {:plain 2}]\n567\t      (is (not= (root-of (yang/compile with-sem))\n568\t                (root-of (yang/compile without))))\n569\t      (is (ascending? (pair-keys (first (map-constructors (yang/compile with-sem)))))))))"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"6340b5ab-8a39-4c5a-9bf2-d96b25b7b16f","timestamp":"2026-11-18T19:50:38.821Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_collection_order_test.cljc","content":"            (keys form) (vals form))\n       (sort jing/canonical-compare)\n       vec))\n\n(deftest order-pairing-multiplicity-oracle-test\n  (testing \"pairs stay intact, the seed stays first, the pair vector sorts\"\n    (doseq [form [{:a (list '+ 'n 1), :b (list '+ 'n 2)}\n                  {(list 'first 'xs) :v, :k [1 (list '+ 'n 3)]}\n                  {:x #{(list '+ 'n 4)}, :y {:in (list '+ 'n 5)}}]\n            ;; the outermost constructor: the walk collects innermost first\n            :let [ctor (last (map-constructors (yang/compile form)))\n                  roots (child-roots ctor)\n                  pairs (pair-keys ctor)]]\n      (is (= empty-map-seed-root (first roots)))\n      (is (odd? (count roots)))\n      (is (= (+ 1 (* 2 (count form))) (count roots)))\n      (is (ascending? pairs))\n      (is (= (independent-pair-keys form)\n             (vec (sort jing/canonical-compare pairs)))\n          \"the emitted pairs are exactly the independently compiled source\n           pairs, none lost or mixed\")))\n  (testing \"the value root breaks equal key roots\"\n    ;; two NaN keys are never = to each other (both survive the host map)\n    ;; and the codec makes every NaN one quiet NaN, so both compile to one\n    ;; key code: only the value root can order these pairs\n    (let [form (assoc {} ##NaN :left ##NaN (list '+ 'n 1))\n          ctor (last (map-constructors (yang/compile form)))\n          pairs (pair-keys ctor)]\n      (is (= 2 (count pairs)) (str \"both NaN entries survive: \" (count pairs)))\n      (is (ascending? pairs))\n      (is (= (first (first pairs)) (first (second pairs))))\n      (is (= (mapv second pairs)\n             (vec (sort jing/canonical-compare (mapv second pairs)))))))\n  (testing \"identical compiled pairs tie without occurrence loss\"\n    (let [form (assoc {} ##NaN (list '+ 'n 0) ##NaN (list '+ 'n 0))\n          ctor (last (map-constructors (yang/compile form)))\n          pairs (pair-keys ctor)]\n      (is (= 2 (count pairs)))\n      (is (= (first pairs) (second pairs)))\n      (is (= 5 (count (:operands ctor))) \"seed plus both pair occurrences\")))\n  (testing \"identical compiled set elements tie without occurrence loss\"\n    ;; A whole-element tie needs two host-unequal elements with one\n    ;; compiled content: two NaNs are the only such pair, and every host\n    ;; set constructor available to the form API (reader, conj, into,\n    ;; hash-set) collapses them, so the tie is unconstructable at the\n    ;; emitter's input boundary -- recorded as the boundary, never\n    ;; silently skipped. What IS reachable is occurrence preservation of\n    ;; equal compiled subtrees inside one set:\n    (let [inner (list '+ 'n 0)\n          form #{inner (list '+ 'n 1)}\n          ctor (first (collection-applications (yang/compile form)))\n          keys (element-keys ctor)]\n      (is (= 2 (count keys)))\n      (is (ascending? keys))\n      (is (= 3 (count (:operands ctor))))))\n  (testing \"source-position and node metadata never choose the order\"\n    (let [plain {:a (list '+ 'n 1), :b (list '+ 'n 2)}\n          positioned (with-meta plain {:line 3 :column 4 :end-line 3 :end-column 9})\n          noted (with-meta plain {:note :source-form})\n          value-meta {(with-meta (list '+ 'n 1) {:line 8}) :a\n                      (list '+ 'n 2) :b}\n          snap (fn [f] (compile-snapshot f))\n          ctor-roots (fn [f] (child-roots (first (map-constructors (yang/compile f)))))]\n      (is (= (snap plain) (snap positioned)))\n      (is (= (snap plain) (snap noted)))\n      (is (= (ctor-roots plain) (ctor-roots positioned)))\n      (is (= (ctor-roots plain) (ctor-roots noted)))\n      (is (ascending? (pair-keys (first (map-constructors (yang/compile value-meta))))))))\n  (testing \"semantic metadata in literal payloads stays content\"\n    (let [with-sem {(list 'quote (with-meta [1 2] {:sem true})) (list '+ 'n 1)\n                    :plain 2}\n          without {:plain 2}]\n      (is (not= (root-of (yang/compile with-sem))\n                (root-of (yang/compile without))))\n      (is (ascending? (pair-keys (first (map-constructors (yang/compile with-sem)))))))))","numLines":75,"startLine":495,"totalLines":1073}},"tool_result_meta":[{"id":"call_bf955eb0a0b2418c9b3a3675","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
