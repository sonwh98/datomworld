{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/latte_oracle/cc4_budget.cljc <<'EOF'\n(ns yang.latte-oracle.cc4-budget\n  \\\"cc4 declaration v1: trace-free B/S pipeline. Raw samples, maximum verdicts.\n   B shares compiler annotation work but strips C1 before downstream stages.\\\"\n  (:require [yang.clojure-callsite-test :as cohort]\n            [dao.host.bytes :as bytes]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yin.vm :as vm]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.semantic.derive :as derive]))\n\n(def ceilings\n  {:per-artifact 2000000 :storage 32000000 :retained 96000000\n   :heap 2147483648 :pipeline 80000 :cold 160000\n   :rows 50000 :occurrences 100000 :applications 10000\n   :depth 256 :path-bytes 8000000})\n\n(defn now [] #?(:cljs (.now js/Date) :default (System/currentTimeMillis)))\n(defn heap [] #?(:jolt nil :cljd nil\n                 :clj (let [r (Runtime/getRuntime)] (- (.totalMemory r) (.freeMemory r)))\n                 :cljs (.-heapUsed (.memoryUsage js/process))))\n(defn gc-heap []\n  #?(:jolt nil :cljd nil\n     :clj (do (System/gc) (Thread/sleep 50) (System/gc) (heap))\n     :cljs (when (fn? (.-gc js/global)) ((.-gc js/global)) (heap))))\n\n(defn pipeline [annotated?]\n  (let [start (now)\n        artifacts (cohort/replay-artifacts annotated?)\n        built (now)\n        store (mem/create-content-mem)\n        entries\n        (mapv\n          (fn [{:keys [tree rows] :as artifact}]\n            (let [occ (vec (vm/occurrences tree))\n                  apps (filterv (fn [[_ _ id]] (= :application (nth (get (:rows tree) id) 1))) occ)\n                  paths (mapv second apps)\n                  counts {:rows (count (:rows tree)) :occurrences (count occ)\n                          :applications (count apps) :depth (apply max 0 (map count paths))\n                          :path-bytes (bytes/length (jing/canonical-bytes paths))}\n                  _ (doseq [k (keys counts)]\n                      (when (> (get counts k) (get ceilings k))\n                        (throw (ex-info \\\"cc4 input bound exceeded before lowering\\\" counts))))\n                  sem (linearize/project-rows tree nil (if annotated? rows []))\n                  stack (derive/stack-image (:vector sem)\n                                            {:segment-address :cc4/stack\n                                             :call-provenance (:call-provenance sem)})\n                  reg (derive/register-image (:vector sem)\n                                             {:segment-address :cc4/register\n                                              :call-provenance (:call-provenance sem)})\n                  relation [(:call-provenance sem) (:call-provenance stack) (:call-provenance reg)]\n                  record (when annotated?\n                           {:cc4/schema 1 :root (:root tree)\n                            :rows (jing/materialize\"'! store rows)\n                            :relation (jing/materialize! store relation)})\n                  address (when record (jing/materialize! store record))\n                  sizes (if annotated?\n                          (mapv #(bytes/length (jing/canonical-bytes %)) [rows relation record])\n                          [0 0 0])\n                  loaded (when address (jing/get store address nil))\n                  loaded-rows (if loaded (jing/get store (:rows loaded) nil) [])\n                  query (into #{} (map #(vec (take 3 %))) loaded-rows)]\n              (when (and annotated? (not= (set (map #(vec (take 3 %)) rows)) query))\n                (throw (ex-info \"cc4 persisted query mismatch\" {:id (:id artifact)})))\n              {:input artifact :images [(:vector sem) (:image stack) (:image reg)]\n               :relation (when annotated? relation) :record loaded :query query\n               :counts counts :sizes sizes :stage-heap (heap)}))\n          artifacts)\n        done (now)\n        counts (reduce (fn [a e] (merge-with + a (dissoc (:counts e) :depth))) {} entries)\n        counts (assoc counts :depth (apply max (map #(get-in % [:counts :depth]) entries)))\n        _ (doseq [k (keys counts)]\n            (when (> (get counts k) (get ceilings k))\n              (throw (ex-info \"cc4 aggregate input bound exceeded\" counts))))]\n    {:holder [artifacts entries store]\n     :roots (mapv #(get-in % [:input :tree :root]) entries)\n     :image-digest (jing/content-hash (mapv :images entries))\n     :counts counts :per-member (mapv #(select-keys % [:counts :sizes]) entries)\n     :storage (reduce + (mapcat :sizes entries))\n     :largest-artifact (apply max (mapcat :sizes entries))\n     :stage-heap-max (when (heap) (apply max (heap) (keep :stage-heap entries)))\n     :stages-ms {:compile-expand-publish (- built start)\n                 :lower-persist-load-query (- done built)}\n     :elapsed-ms (- done start)}))\n\n(defn sample [annotated?]\n  #?(:clj\n     (let [stop (atom false) peak (atom (heap))\n           sampler (Thread. (fn [] (while (not @stop)\n                                    (swap! peak max (heap)) (Thread/sleep 2))))]\n       (.start sampler)\n       (try\n         (let [result (pipeline annotated?)]\n           (assoc (dissoc result :holder) :peak-used-heap @peak))\n         (finally (reset! stop true) (.join sampler))))\n     :default (dissoc (pipeline annotated?) :holder)))\n\n(defn retained [annotated?]\n  (when-let [before (gc-heap)]\n    (let [result (pipeline annotated?)\n          after (gc-heap)\n          ;; Refer to the holder after GC sampling so it remains live.\n          alive (count (first (:holder result)))]\n      {:before before :after after :delta (- after before) :retained-members alive})))\n\n(defn measure [annotated?]\n  (let [cold (sample annotated?)\n        _ (sample annotated?)\n        pipes (mapv (fn [_] (sample annotated?)) (range 3))\n        holds (vec (keep identity (map (fn [_] (retained annotated?)) (range 5))))\n        max-of (fn [k] (apply max (map k pipes)))\n        peak (if (:peak-used-heap (first pipes))\n               (max-of :peak-used-heap) (max-of :stage-heap-max))]\n    {:configuration (if annotated? :S :B) :cold cold :pipeline-samples pipes\n     :retained-samples holds\n     :memory-method #?(:clj :jvm-gc-used-heap-2ms-peak\n                        :cljs :node-exposed-gc-stage-peak-lower-bound\n                        :default :heap-unavailable)\n     :maxima {:time (max-of :elapsed-ms) :storage (max-of :storage)\n              :per-artifact (max-of :largest-artifact) :heap peak\n              :retained (when (seq holds) (apply max (map :delta holds)))}\n     :verdicts {:cold (<= (:elapsed-ms cold) (:cold ceilings))\n                :pipeline (<= (max-of :elapsed-ms) (:pipeline ceilings))\n                :storage (<= (max-of :storage) (:storage ceilings))\n                :per-artifact (<= (max-of :largest-artifact) (:per-artifact ceilings))\n                :heap (when peak (<= peak (:heap ceilings)))\n                :retained (when (seq holds)\n                            (<= (apply max (map :delta holds)) (:retained ceilings)))}}))\n\n(defn -main [& _]\n  (let [b (measure false) s (measure true)\n        delta (into {} (for [k [:time :storage :retained]\n                             :let [bv (get-in b [:maxima k]) sv (get-in s [:maxima k])]\n                             :when (and bv sv)] [k (- sv bv)]))]\n    (prn {:cc4/budget 1 :ceilings ceilings :baseline b :static s :S-minus-B delta\n          :canonical-code-equal (= (get-in b [:cold :image-digest])\n                                   (get-in s [:cold :image-digest]))})))\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
