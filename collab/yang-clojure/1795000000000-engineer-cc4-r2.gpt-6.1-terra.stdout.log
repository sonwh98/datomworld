capture\n2234-     ;; their environment: retaining the previous descriptor here doubles its\n2235-     ;; paths at each definition during machine-data validation and UCF lift.\n2236-     (letfn [(discard-result\n2237-               [ast]\n2238-               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n2239-             (go\n--\n3084:(defn lower-unit\n3085-  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n3086-   thunk whose call runs the program — `forms` plus the definitions of\n3087-   the guest library they need, compiled unmodified under `unit-opts`\n3088-   and published to the runtime global namespace by\n3089-   `publish-to-globals` — so the helper's export projection can read\n3090-   each top-level definition. The two-argument form also takes the\n3091-   projected `exports` (names the composition already bound in the\n3092-   runtime global namespace): their free reads publish the same way, so\n3093-   the projection is the caller's binding for them. The program's own\n3094-   `yang.call` call sites need no free-name declaration: the convention\n3095-   preamble `compile-program` emits defines those names locally, and\n3096-   the donor publication pins the `yang.call` module for the qualified\n3097-   reads that remain.\"\n3098-  ([forms] (lower-unit forms []))\n3099-  ([forms exports]\n3100-   (let [source (vec forms)\n3101-         library (library-for source)\n3102-         program (compile-program (concat source library) true unit-opts)\n3103-         macros (into #{}\n3104-                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n16:Message:  J2 manifest FAILED:\n17:UNLISTED yin.repl.php-parser-test -- test/yin/repl/php_parser_test.cljc\n18:UNLISTED yin.vm.code-entry-test -- test/yin/vm/code_entry_test.cljc\n19:UNLISTED yin.vm.machine-data-test -- test/yin/vm/machine_data_test.clj\n20:UNLISTED yin.vm.provenance-test -- test/yin/vm/provenance_test.cljc\n30:      ^--- J2 manifest FAILED:\n","exit_cod