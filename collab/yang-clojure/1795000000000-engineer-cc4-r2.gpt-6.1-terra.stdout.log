{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"head -65 test/yin/repl/php_parser_test.cljc\nhead -45 test/yin/vm/{code_entry_test.cljc,machine_data_test.clj,provenance_test.cljc}\nsed -n '1,80p' src/dev/jolt_test_runner.clj\nrg -n 'cljd.*test|--only|plain-name' src/dev/cljd_agg.clj | head -35\"","aggregated_output":"(ns yin.repl.php-parser-test\n  \"The standard Node/JVM PHP parser profile: source is parsed locally,\n   with the same positioned terminator and UTF-8 line table.\"\n  (:require [clojure.test :refer [deftest is]]\n            #?@(:cljd []\n                :jolt []\n                :default [[yang.antlr.packet :as packet]\n                          [yang.php.antlr.cst :as php]])))\n\n\n#?(:cljd nil\n   :jolt nil\n   :default\n   (do\n     (deftest php-source-produces-valid-packets\n       (doseq [source [\"<?php echo 1 + 2;\"\n                       \"<?php $x = \\\"a{$n}b\\\"; ?>\\nhtml\"\n                       \"<?php f(<<<\\\"END\\\"\\nhi\\nEND);\"\n                       \"<?php $x = <<<'END'\\nhi\\nEND;\"]]\n         (let [pk (php/parse-source source)]\n           (is (= :yang.cst/ok (:yang.cst/outcome pk)) source)\n           (is (some? (packet/validate! pk))))))\n\n     (deftest php-heredoc-terminator-retains-its-source-span\n       (let [pk (php/parse-source \"<?php f(<<<END\\nhi\\nEND);\")\n             end (first (filter #(= \"HereDocEnd\" (:type %)) (:yang.cst/nodes pk)))]\n         (is (= [\"END\" [18 21]] ((juxt :text :span) end)))\n         (is (not (:synthetic end)))))\n\n     (deftest php-line-starts-count-utf8-bytes\n       (let [pk (php/parse-source \"é\\n<?php echo 1;\\n\")]\n         (is (= :yang.cst/ok (:yang.cst/outcome pk)))\n         (is (= [0 3 17] (:yang.php/line-starts pk)))))))\n==> test/yin/vm/code_entry_test.cljc <==\n(ns yin.vm.code-entry-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing :as jing]\n            [yin.vm.effect :as effect]\n            [yin.vm.module :as module]))\n\n\n(deftest installed-export-is-address-pinned\n  (let [manifest {:yin.module/name 'eval.unit :yin.module/exports #{'entry}}\n        address (jing/segment-key manifest)\n        registry (module/assoc-module (module/default-registry) 'eval.unit\n                                      {:manifest manifest :address address\n                                       :bindings {'entry :callable}})\n        state {:modules registry}\n        effect {:module 'eval.unit :address address :export 'entry}\n        run #(module/code-entry-handler state % {})]\n    (is (= :callable (:value (run effect))))\n    (doseq [bad [(assoc effect :address :wrong)\n                 (assoc effect :export 'missing)\n                 (assoc effect :module 'absent)]]\n      (is (= :refused (get-in (run bad) [:value :status]))))\n    (is (= module/code-entry-handler\n           (module/get-effect-handler registry :code/entry)))\n    (is (= {:effect :code/entry :module 'eval.unit :address address :export 'entry}\n           (effect/descriptor (module/code-entry 'eval.unit address 'entry))))\n    (is (fn? (module/resolve-module (module/register-code-module registry) 'code.entry)))\n    (doseq [modified [(assoc-in registry [:modules 'eval 'unit :manifest :extra] true)\n                      (update-in registry [:modules 'eval 'unit] dissoc :bindings)]]\n      (is (= :refused (get-in (module/code-entry-handler (assoc state :modules modified) effect {})\n                              [:value :status]))))))\n\n==> test/yin/vm/machine_data_test.clj <==\n(ns yin.vm.machine-data-test\n  (:require [clojure.test :refer [deftest is]]\n            [yin.vm :as vm]))\n\n\n(deftest shared-machine-data-is-validated-once\n  (let [shared (nth (iterate (fn [x] [x x]) {:value 1}) 35)]\n    (is (vm/machine-data? shared))\n    (is (not (vm/machine-data? [shared {:bad (Object.)}])))))\n\n==> test/yin/vm/provenance_test.cljc <==\n(ns yin.vm.provenance-test\n  \"The VM provenance primitive (sol-approved, amended): a private\n   :provenance sibling on heap entries, written once by the privileged mint\n   (cell/dsg__new-provenance, effect :cell/new-provenance) and read only\n   by the authenticated private reader (cell/dsg__provenance, effect\n   :cell/provenance). The VM treats the slot as opaque data and answers it\n   for nothing but a live, authenticated, marked cell. Unit tests run on all\n   four VMs; the macro tests exercise the expander prelude.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [clojure.test :refer [deftest is testing]]\n            [yang.clojure :as yang]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as walker]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.engine :as engine]\n            [yin.vm.macro :as m]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def ^:private opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives,\n   :modules (module/register-cell-module (module/default-registry))})\n\n\n(def ^:private images\n  {:ast-walker vm/ast->semantic-bytecode,\n   :semantic (fn [ast]\n               (:vector (sr-linearize/project-rows (vm/ast->semantic-bytecode ast)))),\n   :stack (fn [ast] (:image (derive/stack-image (:vector (sr-linearize/project ast))))),\n   :register (fn [ast] (derive/register-image (:vector (sr-linearize/project ast))))})\n\n\n(def ^:private builders\n  {:ast-walker (fn [ast o]\n                 (walker/vm-load-rows (walker/create-vm o)\n                                      (vm/ast->semantic-bytecode ast)\n                                      vm/ast-contract)),\n   :semantic (fn [ast o]\n               (semantic/load-vector (semantic/create-vm o)\n;; The jolt test runner (yin.repl-jolt-implementation.md §11; J1), run UNDER\n;; jolt:\n;;\n;;   . build/tools/jolt-env.sh\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj NS...\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj --self-test\n;;\n;; How it finds the tests: it does not scan. The namespaces are the explicit\n;; command-line list (bb test:jolt-host passes the four dao.host oracle\n;; namespaces), and each is loaded by `require` through jolt's own source-root\n;; search, which the aliases set: :jolt replaces the paths with src/jolt,\n;; src/cljc, src/clj (src/jolt first, so a host override there wins) and\n;; :jolt-test adds test (the oracle) and src/dev (this runner and its\n;; sentinel). jolt resolves :extra-paths roots BEFORE the :replace-paths\n;; ones (`jolt -Srepro -Spath -A:jolt:jolt-test`: test, src/dev, src/jolt,\n;; src/cljc, src/clj); neither test nor src/dev holds a dao/host source, so\n;; the override order is unaffected. Fixture files the tests read\n;; (test/resources/...) are relative to the working directory, the\n;; repository root.\n;;\n;; Per namespace: a load failure is counted and reported, and the run goes on.\n;; Per test var, in source order: each runs through clojure.test/test-var,\n;; which reports an escaping throw as an :error, inside a second guard of this\n;; runner's own, so a throwing test never aborts the batch. Totals are tests,\n;; assertions (pass + fail + error), failures, errors and load failures; the\n;; exit status is nonzero when any of the last three is.\n;;\n;; --self-test runs the sentinel namespace jolt-runner-sentinel (a passing\n;; test, a test that throws, then a passing test) and exits 0 only when the\n;; runner counted exactly that: 3 tests, 1 error, and the test after the\n;; throwing one ran.\n(ns jolt-test-runner\n  (:require\n    [clojure.test :as t]))\n\n\n(defn- tally\n  []\n  (select-keys @t/counters [:test :pass :fail :error]))\n\n\n(defn- delta\n  [before after]\n  (merge-with - after before))\n\n\n(defn- test-vars-of\n  \"The test vars of namespace `ns-sym` in source order.\"\n  [ns-sym]\n  (->> (vals (ns-interns ns-sym))\n       (filter #(:test (meta %)))\n       (sort-by #(or (:line (meta %)) 0))))\n\n\n(defn- run-ns\n  \"Run namespace `ns-sym`; answers {:ns :load-error :counts :tests}.\"\n  [ns-sym]\n  (let [loaded (try\n                 (require ns-sym)\n                 nil\n                 (catch Throwable e e))]\n    (if loaded\n      {:ns ns-sym :load-error (str (ex-message loaded)) :counts {} :tests []}\n      (let [before (tally)\n            per-test (mapv (fn [v]\n                             (let [b (tally)]\n                               (try\n                                 (t/test-vars [v])\n                                 (catch Throwable e\n                                   ;; test-var already guards; this is the\n                                   ;; runner's own floor\n                                   (t/do-report {:type :error\n                                                 :message \"escaped test-vars\"\n                                                 :expected nil :actual e})))\n                               [(:name (meta v)) (delta b (tally))]))\n                           (test-vars-of ns-sym))]\n        {:ns ns-sym\n         :load-error nil\n         :counts (delta before (tally))\n         :tests per-test}))))\n8:   build/, never under test/, so a plain `cljd test` never runs them twice.\n11:     bb src/dev/cljd_agg.clj [--slow-only | --slow-regex | --only NS,NS...]\n14:   --only compiles and runs only the given test namespaces (bb test:changed,\n19:   a plain library (lib/cljd-out/<ns>.dart exists) and emits no test file;\n78:  \"Library file the cljd tool writes for a namespace with no Dart tests.\"\n181:        ;; runs the failing TEST, not the namespace): --only accepts NS or\n182:        ;; NS/test-name; entries with a test name become flutter --plain-name\n185:        (when (some #{\"--only\"} args)\n186:      