urns `{:vector v :address A :provenance [[pc origin root path] …]}`,\n   one provenance row per pc, `path` being the emitting node's §2.5\n   structural path from the root row (row-position steps; a `nodes` item\n   is a `[position i]` pair); a body's `:return` carries its lambda's\n   path.\n\n   The three-argument form additionally resolves `:call-provenance` —\n   `[[pc origin root path] …]`, one row per `:call` instruction — from\n   the validated C1 side table `call-site-rows`: each call occurrence\n   resolves to ITS OWN origin (a tree mixing `[:source …]` and\n   `[:expansion …]` applications is never stamped with one blanket\n   origin), and a call occurrence with no validated row yields NO\n   entry (absence, never invention). Without a side table the relation\n   is empty: a caller-supplied single `origin` never stamps it — that\n   origin belongs to the full `:provenance` table alone. Rule R\n        side (volatile! {})\n        labels (volatile! {})\n        queue (volatile! [])\n        counter (volatile! 0)\n        label! (fn [] (vswap! counter inc))\n        mark! (fn [l] (vswap! labels assoc l (count @image)))\n        emit! (fn [t] (vswap! image conj t))]\n    (letfn [(walk\n              [node]\n              (let [pc (:pc node)\n                    [op _ x y z] (nth rv pc)\n                    children (:children node)\n                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n                (case (:op node)\n                  :if (let [[c th el] children\n                            else (label!) end (label!)]\n                        (walk c) (emit! [:branch-false else])\n                        (walk th) (emit! [:jump end])\n                        (mark! else) (walk el) (mark! end))\n                  :closure (let [l (label!)]\n                             (vswap! queue conj [l (get by-start y)])\n                             (diagnostic! {:kind :closure :params (nth (nth v pc) 2) :source pc})\n                             (emit! [:closure x l]))\n                  :var (do (diagnostic! {:kind :var :source pc})\n                           (emit! (if (= op :load-bound) [:load-bound x y] [:load-free x])))\n                  :call (do (doseq [child children] (walk child) (emit! [:push]))\n                            (when-let [[o r p] (get keys-by-pc pc)]\n                              (diagnostic! {:kind :call :source pc\n                                            :origin o :root r :path p})\n                              (vswap! call-rows conj\n                                      [segment-address (count @image) o r p]))\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.clojure-callsite-test\n\nRan 1 tests containing 11 assertions.\n0 failures, 0 errors.\n6:;; peak sampler spans lowering -> binding/projection/derives -> actual\n27:(defn- admit-ordinal\n32:(defn- used\n37:(defn- gc-used\n49:(defn- build-retained\n77:(defn- measure-retained\n82:  (let [b0 (gc-used)\n84:        a (gc-used)\n89:(defn- measure-pipeline\n96:        peak (atom 0)\n100:                             (swap! peak max (used))\n105:        base (gc-used)]\n160:       :heap-baseline-gc-used base\n162:       :peak-used-during-pipeline @peak\n163:       :peak-over-baseline (- @peak base)\n171:(gc-used)\n176:      after-release (gc-used)\n181:      peak-max (apply max (map :peak-used-during-pipeline pipes))\n194:  (println :after-release-gc-used after-release)\n208:            :peak-heap-max (<= peak-max (:heap ceilings-v2))\n","exit_code":0,"status":"completed"}}
