{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2310,2360p;4320,4418p' src/cljc/yang/php/antlr/lower.cljc\nsed -n '221,247p;632,675p' test/yang/php/antlr/e2e_test.clj\nrg -n -i 'isset|closure' test/yang/php/antlr/programs.cljc | head -28\nrg -n '\"'^Ran|''^ERROR|:capability :runtime/native'\"' /tmp/dw-p4php-r1-regressions-before.log | cut -c1-450\"","aggregated_output":"      (p/rule? k \"magicConstant\") (lower-magic ctx n k)\n      (p/rule? k \"classConstant\") (lower-class-constant ctx n k)\n      :else (core/default-arm diagnostic-ns \"PHP\" unsupported-rules k))))\n\n\n(defn- lower-array\n  \"`[...]` / `array(...)`: items fold over the empty array left to right, key\n   before value, so a duplicate key keeps its first position and the last\n   value. A trailing `[e]` reads the literal.\"\n  [ctx n]\n  (require-capability! ctx n :collections/arrays :array)\n  (let [items (mapcat #(core/rules ctx % \"arrayItem\") (core/rules ctx n \"arrayItemList\"))\n        arr (reduce (fn [acc item]\n                      (let [kids (core/kids ctx item)\n                            [k v] (core/rules ctx item \"expression\")]\n                        (cond\n                          (some #(p/token? % \"&\") kids)\n                          (let [_ (require-capability! ctx item :calls/references :array-reference)\n                                src (first (core/rules ctx item \"chain\"))\n                                m (ref-source ctx item src)]\n                            (if k\n                              (hook ctx :php/array-put-ref acc (lower ctx k) m)\n                              (hook ctx :php/array-append-ref acc m)))\n                          (p/token? (first kids) \"...\")\n                          (do (require-capability! ctx item :collections/spread :array-spread)\n                              (hook ctx :php/array-spread acc (lower ctx k)))\n                          v (app* (hook-name ctx (if (legacy? ctx) :php/array-put :coll/put))\n                                  acc (lower ctx k) (lower ctx v))\n                          :else (app* (hook-name ctx (if (legacy? ctx) :php/array-append :coll/append))\n                                      acc (lower ctx k)))))\n                    (app* (hook-name ctx (if (legacy? ctx) :php/empty-array :coll/empty)))\n                    items)\n        deref (first (core/rules ctx n \"expression\"))\n        arr (if (legacy? ctx) (hook ctx :php/tmp! arr) arr)]\n    (if deref (hook ctx :coll/get arr (lower ctx deref)) arr)))\n\n\n(defn- lower-yield\n  [ctx n]\n  (when-not (:gen ctx) (unsupported! n :yield))\n  (let [from? (boolean (some #(p/token? % \"from\") (core/kids ctx n)))\n        es (core/rules ctx n \"expression\")]\n    (if from?\n      (hook ctx :php/yield-from (u/v (:gen ctx)) (lower ctx (first es)))\n      (hook ctx :php/yield\n            (u/v (:gen ctx))\n            (if (= 2 (count es)) (lower ctx (first es)) (literal ctx :unbound nil))\n            (lower ctx (last es))))))\n\n\n(defn- lower-expression\n     :runtime-address php-address,\n     :deps (into {} (map (fn [[p a]] [(path-module-symbol p) a])) deps)}))\n\n\n;; =============================================================================\n;; The autoload class map (plan P6 R9)\n;; =============================================================================\n\n(def classmap-exports\n  \"The exports of the class map module: the lower-cased class name to path\n   map, and the path to delivery-thunk map the computed include resolves\n   through.\"\n  '#{classes paths})\n\n\n(defn classmap-paths\n  \"The literal paths a class map `{:classes {class path} :paths [path ...]}`\n   publishes thunks for: `:paths`, else the class map's values, and always the\n   class map's values. Normalized, sorted, distinct.\"\n  [{:keys [classes paths]}]\n  (vec (sort (distinct (map #(let [r (normalize-unit-path %)]\n                               (when (:error r) (throw (ex-info \"unmappable class map path\"\n                                                                {:yang.php/diagnostic :yang.php/unsupported,\n                                                                 :construct (:error r), :path %})))\n                               (:path r))\n                            (concat (vals classes) paths))))))\n\n\n(defn classmap-packet\n  \"The class map as one linker module (the unit module shape): `classes`\n   maps each lower-cased class name to its normalized path, `paths` each\n   listed path to its delivery thunk.\"\n  [{:keys [classes] :as cm}]\n  (let [paths (classmap-paths cm)\n        norm (fn [p] (:path (normalize-unit-path p)))\n        defs [(u/def! 'classes\n                      (u/lit (into {} (map (fn [[c p]] [(str/lower-case c) (norm p)])) classes)))\n              (u/def! 'paths\n                      (reduce (fn [m p] (app* 'assoc m (u/lit p) (delivery-thunk p)))\n                              (u/lit {})\n                              paths))]\n        operands (into [(core-module/require-node prelude/module-name)] defs)]\n    (core-module/module-tree operands)))\n\n\n(defn classmap-spec\n  \"`publish-module!`'s spec for the class map `cm` over the host registry\n   `registry`, `php` at `php-address` and each listed path's module at its\n   address in `deps` ({path address}).\"\n  [registry cm php-address deps]\n  (core-module/module-spec\n    :yang.php/refusal :yang.php/undeclared-free registry\n    {:name classmap-module,\n     :ast (classmap-packet cm),\n     :exports classmap-exports,\n     :runtime-name prelude/module-name,\n     :runtime-address php-address,\n     :deps (into {} (map (fn [[p a]] [(path-module-symbol p) a])) deps)}))\n\n\n(defn scc-module-specs\n  \"The SCC publication shape for a mutual include group: sorted members,\n   indexed exports m0-spec/m0-body, one `phpscc.<members>` bundle followed\n   by the thin member aliases. Internal deliveries answer `{:status :ok}`\n   and read the bundle's own bodies; only `php` and outgoing includes are\n   pinned. `units` are `[{:name path :packet p :strict-types b}]`.\"\n  [registry units php-address deps]\n  (let [units (vec (sort-by :name units))\n        deps (apply dissoc deps (map :name units))\n        bundle-name (symbol (str \"phpscc.\"\n                                 (str/join \"+\" (map #(str/replace (str (path-module-symbol (:name %))) #\"^phpm\\.\" \"\")\n                                                    units))))\n        keys-for (into {} (map-indexed (fn [i unit]\n                                         [(:name unit) [(symbol (str \"m\" i \"-spec\"))\n                                                        (symbol (str \"m\" i \"-body\"))]])\n                                       units))\n        internal-names (into {} (map (fn [nm] [(path-module-symbol nm) nm])) (keys keys-for))\n        internal (set (keys internal-names))\n        rewrite (fn [node]\n                  (cond\n                    (and (= :variable (:type node))\n                         (symbol? (:name node))\n                         (some? (namespace (:name node)))\n                         (contains? internal (symbol (namespace (:name node))))\n                         (= \"body\" (name (:name node))))\n                    (u/v (second (get keys-for (get internal-names (symbol (namespace (:name node)))))))\n                    (and (= :application (:type node))\n                         (= 'try-require (get-in node [:operator :name]))\n                         (contains? internal (get-in node [:operands 0 :value])))\n                    (u/lit {:status :ok})\n                    :else node))\n        spec-defs (mapv (fn [{:keys [name strict-types]}]\n                          (u/def! (first (get keys-for name))\n                                  (u/lit {:path name, :strict-types (if strict-types 1 0)})))\n                        units)\n        body-defs (mapv (fn [{:keys [name packet]}]\n                          (let [ctx (context packet {:path name, :linked? true})]\n                            (u/def! (second (get keys-for name))\n                                    (u/lam ['%scope '%ctx]\n                 (apply str (for [[lit] programs/float-cases]\n                              (str \"echo \" lit \", \\\"|\\\"; var_dump(\" lit \");\\n\"))))\n        expected (str (apply str (for [[_ echo dump] programs/float-cases]\n                                   (str echo \"|float(\" dump \")\\n\"))))]\n    (is (= expected (h/run-walker src)))))\n\n\n(deftest refusals-are-named-test\n  (doseq [[source construct]\n          [[\"<?php $a = &f();\" :reference-source]\n           [\"<?php function f(int ...$a) {}\" :typed-variadic]\n           [\"<?php function f(&...$a) {}\" :variadic-reference]\n           [\"<?php $a = &new B;\" :reference]\n           [\"<?php static $a = 1;\" :static]\n           [\"<?php echo \\\"a$b[0]\\\";\" :interpolation]\n           [\"<?php echo \\\"a$b->c\\\";\" :interpolation]\n           [\"<?php echo (array)1;\" :cast/array]\n           [\"<?php $o = new class { public $x = 1; };\" :anonymous-class]]\n          :when construct]\n    (let [{:keys [diagnostics]} (h/run-php source)\n          d (first diagnostics)]\n      (is (= :yang.php/unsupported (:yang.php/diagnostic d)) source)\n      (is (= construct (:construct d)) source))))\n\n\n(deftest undefined-bare-constant-is-a-runtime-error-test\n  (let [r (h/run-raw \"<?php echo FOO; echo 'after';\")]\n\n\n(deftest gate-fix-programs-test\n  (testing \"var_dump of a self-referencing array terminates with *RECURSION*\"\n    (let [r (engine-result \"<?php $a = [1]; $a[0] = &$a; var_dump($a);\")]\n      (is (str/includes? (:out r) \"*RECURSION*\") (pr-str r))\n      (is (nil? (:uncaught r)))))\n  (testing \"comparing two cyclic arrays is a nesting Error\"\n    (is (= \"Nesting level too deep - recursive dependency?\"\n           (:out (engine-result\n                   (str \"<?php $a = [1]; $a[0] = &$a; $b = [1]; $b[0] = &$b;\"\n                        \" try { var_dump($a == $b); } catch (Error $e) { echo $e->getMessage(); }\"))))))\n  (testing \"C25: a string-key spread is refused with the named gap\"\n    (let [r (engine-result (:source (first (filter #(= :call-spread-string-key-gap (:id %))\n                                                   p3b/all-fixtures))))]\n      (is (= {:class \"Error\",\n              :message \"spread with string keys is not supported yet (yang.php known gap G-spread-string-keys)\"}\n             (:uncaught r)))))\n  (testing \"C28: a later named argument is evaluated before the unknown name is rejected\"\n    (is (= \"SUnknown named parameter $z\"\n           (:out (engine-result\n                   (:source (first (filter #(= :call-unknown-named-later-arg-runs (:id %))\n                                           p3b/all-fixtures)))))))))\n8:   `isset`/`empty`/`unset`, literals, compound assignment, null coalescing,\n212:    :criterion \"top-level variables, compound assignment, isset, empty, unset\",\n215:                 \" $c /= 4; $c %= 7; $c <<= 1; echo $c; echo isset($c) ? 1 : 0,\"\n216:                 \" empty($c) ? 1 : 0; unset($c); echo isset($c) ? 1 : 0;\"),\n567:    :criterion \"string offset reads, negative offsets, isset\",\n568:    :source \"<?php $s = 'abc'; var_dump($s[0], $s[-1], $s['1']); echo $s[5]; var_dump(isset($s[1]), isset($s[5]), isset($s['x']), isset($s['1']), empty($s[0]));\",\n579:    :criterion \"isset/empty on a string coerce bool and null silently and deprecate fractional floats\",\n580:    :source \"<?php $s = 'abc'; var_dump(isset($s[true]), isset($s[false]), isset($s[null]), isset($s[1.0]), isset($s[1.5]), isset($s[-1]), isset($s[-4]), isset($s[3]), isset($s['1.5']), isset($s[' 1'])); $z = '0b'; var_dump(empty($z[true]), empty($z[0]), empty($s[true]));\",\n617:   {:id :array-isset-empty-unset,\n618:    :criterion \"isset, empty and unset over nested keys, never vivifying\",\n619:    :source \"<