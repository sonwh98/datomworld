{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"stat -f '%Sm %N' /tmp/dw-p4php-r1-regressions-before.log /tmp/dw-p4php-jvm-gate.log\nrg -n 'FAIL|ERROR|\"'^Ran|''^expected:|''^  actual:'\"' /tmp/dw-p4php-r1-regressions-before.log | cut -c1-380\nsed -n '963,1020p;1740,1778p' src/cljc/yang/php/antlr/lower.cljc\nsed -n '1,140p' test/yang/php/antlr/linked_harness.cljc\nsed -n '116,164p' /tmp/dw-p4php-deps.log\"","aggregated_output":"Nov 24 00:58:45 2026 /tmp/dw-p4php-r1-regressions-before.log\nNov 23 23:42:20 2026 /tmp/dw-p4php-jvm-gate.log\n\n\n(defn- property-steps\n  \"The path steps of a property `memberAccess` (no call): the property, then\n   its own `[k]` offsets; nil when the access is a call or dynamic.\"\n  [ctx ma]\n  (when-not (seq (core/rules ctx ma \"actualArguments\"))\n    (let [fname (first (core/rules ctx ma \"keyedFieldName\"))\n          simple (when fname (first (core/kids ctx fname)))\n          [ident & offsets] (when (and simple (p/rule? simple \"keyedSimpleFieldName\"))\n                              (core/kids ctx simple))]\n      (when (and ident (p/rule? ident \"identifier\"))\n        (into [{:prop-step (leftmost-token-text ctx ident), :id (:id ma)}]\n              (offset-keys ctx offsets))))))\n\n\n(defn- chain-location\n  \"The location of `chain`, when it is one variable (or static property), its\n   `->prop` steps and `[k]`, `[]` and `{k}` offsets, else nil.\"\n  [ctx chain]\n  (let [[origin & mas] (core/kids ctx chain)\n        o (first (core/kids ctx origin))]\n    (when (p/rule? o \"chainBase\")\n      (let [steps (mapv #(property-steps ctx %) mas)]\n        (when (every? some? steps)\n          (when-let [base (base-location ctx o)]\n            (update base :path into (mapcat identity steps))))))))\n\n\n(defn- expression-location\n  \"The location of an `expression` that is exactly one chain.\"\n  [ctx e]\n  (let [ks (core/kids ctx e)]\n    (when (and (= 1 (count ks)) (p/rule? (first ks) \"chain\"))\n      (chain-location ctx (first ks)))))\n\n\n(defn- chain-loc\n  \"The location of the `chain` `c`, or a refusal naming `construct`.\"\n  [ctx n c construct]\n  (let [loc (or (chain-location ctx c) (unsupported! n construct))]\n    (checked-var n (:var loc))\n    loc))\n\n\n(defn- forbid-append!\n  [n loc message]\n  (when (some #{:php/append} (:path loc))\n    (compile-error! n message)))\n\n\n(defn- prop-step-node\n  [ctx step]\n  (hook ctx :php/prop-key (u/lit (:prop-step step)) (cc-node ctx)))\n\n\n(defn- lower-key\n  [ctx k]\n               (if (seq refs)\n                 (hook ctx :php/call-with-binding-profile\n                       f pos (or named (u/lit []))\n                       (u/lit \"sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb\"))\n                 (if named\n                   (hook ctx :php/call-named f pos named)\n                   (hook ctx :fn/call f pos))))))\n\n\n(defn- argument-chains\n  \"The `chain` of each argument of `arguments`, for the language constructs\n   that take variables (`isset`, `empty`, `unset`).\"\n  [ctx n args]\n  (mapv (fn [a]\n          (let [ks (core/kids ctx a)\n                e (first ks)\n                c (when (and (= 1 (count ks)) (p/rule? e \"expression\"))\n                    (first (core/rules ctx e \"chain\")))]\n            (or c (unsupported! n :argument-form))))\n        (core/rules ctx args \"actualArgument\")))\n\n\n(defn- function-name\n  \"`{:lc :written :fallback-lc :fallback}` for a call's `functionCallName`:\n   the lower-cased fully qualified name and the name as written, plus the\n   global name an unqualified call inside a namespace falls back to.\"\n  [ctx n]\n  (let [ks (core/kids ctx n)\n        q (first ks)]\n    (when-not (and (= 1 (count ks)) (p/rule? q \"qualifiedNamespaceName\"))\n      (unsupported! n :dynamic-call))\n    (let [{:keys [primary fallback]} (resolve-global-name ctx :function (qname-parts ctx q))]\n      {:lc (str/lower-case primary),\n       :written primary,\n       :fallback-lc (some-> fallback str/lower-case),\n       :fallback fallback})))\n\n\n(defn- note-unknown-builtin!\n(ns yang.php.antlr.linked-harness\n  \"The linked profile's composition for the PHP tests (P6, docs/design/\n   yang.php.md section 11): the namespace that requires this is the\n   publisher of `php`, so it publishes the module once per process into one\n   in-memory content store, publishes a fixture's non-entry units beside it\n   bottom-up, and serves them to the entry unit's run over a\n   `yin.vm.linker.interpreter` composition under `:trusted` derivation.\n\n   A linked run builds the entry unit's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately until\n   the VM stops blocking, as the REPL's drive does. The AST walker is not a\n   backend here: its link of `php` is refused until L-b.\"\n  (:require\n    [dao.jing.mem :as mem]\n    [yang.core.call :as call]\n    [yang.core.module :as core-module]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yang.php.antlr.prelude :as prelude]\n    [yang.php.antlr.publication :as publication]\n    [yang.php.antlr.safepoint :as safepoint]\n    [yang.php.antlr.siteset :as siteset]\n    [yang.safepoint :as sp]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.linker.interpreter :as link]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.linker.sign :as sign]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn registry\n  \"The host registry a linked PHP composition registers: the `require`\n   handlers, then `cell`, `data` and `integer` under the portable limits.\"\n  []\n  (portable/linked-registry))\n\n\n(defn make-published\n  \"Create a store with the linked runtime and its hook module.\"\n  []\n  (let [store (mem/create-content-mem)\n        call-result (publish/publish-module! store (call/module-spec (registry)))\n        result (publish/publish-module! store (prelude/module-spec (registry)\n                                                                   (:address call-result)))\n        hook (publish/publish-module! store (safepoint/module-spec (registry) (:address result)))]\n    {:store store,\n     :hook-address (:address hook),\n     :result result,\n     :address (:address result),\n     :call-address (:address call-result)}))\n\n\n(def published\n  \"`yang.call` and `php` published once into their own content store.\"\n  (delay (make-published)))\n\n\n(defn publish-units!\n  \"`units` (`[{:name path :packet p :strict-types b}]`) published into\n   `php`'s own content store, where its pinned requirement already lives:\n   `publication/publish-units!`'s answer.\"\n  [units]\n  (publication/publish-units! (:store @published) (registry) (:address @published) units))\n\n\n(defn source\n  \"The linked store and signed site publications for this fixture.\"\n  ([name-env] (source name-env nil))\n  ([name-env result]\n   (let [publisher (sign/generate)\n         entries (siteset/signed-entries publisher (:sites result)\n                                         (:addresses result) (:bundles result))\n         datoms (siteset/entry-datoms entries)\n         stage (siteset/stage (registry)\n                              {:hooks true, :hooks-profile safepoint/ticks-profile,\n                               :php-sp (:hook-address @published)} {})]\n     (link/composition\n       {:content-store (:store @published),\n        :name-env (merge {'php (:address @published),\n                          'php.sp (:hook-address @published),\n                          'yang.call (:call-address @published)} name-env),\n        :derivation :trusted,\n        :stage (fn [ctx name address]\n                 (stage (assoc ctx :datoms datoms :principals [(:public publisher)])\n                        name address))}))))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task stops\n   blocking, at most 80 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 80))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`, served from\n   `src`. A refused link surfaces as the program's own diagnostics.\"\n  [backend ast src]\n  (let [pair (link/make-pair)\n        task ((get backends backend) ast (composition (registry) pair))]\n    (first (drive task pair src))))\n\n  yin.vm.integer (in:11, out:6)\n  yin.vm.ledger (in:2, out:9)\n  yin.vm.linker (in:6, out:15)\n  yin.vm.linker.closure (in:2, out:5)\n  yin.vm.linker.dht (in:4, out:10)\n  yin.vm.linker.head (in:2, out:8)\n  yin.vm.linker.interpreter (in:3, out:5)\n  yin.vm.linker.pair (in:3, out:6)\n  yin.vm.linker.publish (in:9, out:13)\n  yin.vm.linker.sign (in:11, out:5)\n  yin.vm.macro (in:2, out:6)\n  yin.vm.module (in:27, out:4)\n  yin.vm.semantic (in:4, out:11)\n  yin.vm.semantic.analysis (in:5, out:1)\n  yin.vm.semantic.code (in:10, out:3)\n  yin.vm.semantic.derive (in:4, out:4)\n  yin.vm.semantic.frame (in:1, out:5)\n  yin.vm.semantic.layout (in:0, out:13)\n  yin.vm.semantic.linearize (in:5, out:2)\n  yin.vm.semantic.scan (in:2, out:5)\n  yin.vm.telemetry (in:4, out:3)\n  yin.vm.ucf.authority (in:7, out:5)\n  yin.vm.ucf.authority.admission (in:2, out:6)\n  yin.vm.ucf.authority.completion (in:3, out:5)\n  yin.vm.ucf.authority.front (in:4, out:8)\n  yin.vm.ucf.authority.grant (in:2, out:7)\n  yin.vm.ucf.authority.input (in:3, out:4)\n  yin.vm.ucf.compose (in:1, out:11)\n  yin.vm.ucf.custody (in:12, out:1)\n  yin.vm.ucf.holder.driver (in:1, out:17)\n  yin.vm.ucf.holder.export (in:1, out:5)\n  yin.vm.ucf.holder.reader (in:1, out:9)\n  yin.vm.ucf.holder.writer (in:1, out:7)\n  yin.vm.ucf.ledger (in:8, out:5)\n  yin.vm.ucf.remote (in:2, out:5)\n  yin.vm.ucf.rows (in:4, out:14)\n  yin.vm.ucf.rows.checkpoint (in:5, out:3)\n  yin.vm.values (in:12, out:3)\n\n✓ No tightly coupled clusters (SCCs size > 1)\n\n=== RECOMMENDATIONS ===\n\n2. Reduce high-degree nodes:\n   - These namespaces have too many responsibilities\n   - Analyze internal clusters and extract into separate namespaces\n   - Minimize public API to essential entry points\n\n\n","exit_code":0,"status":"completed"}}
