{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,115p' test/yang/php/antlr/permutations.cljc\nsed -n '738,752p;944,969p' antlr/php/PhpParser.g4\nsed -n '1,37p' src/cljc/yang/core/lower.cljc\"","aggregated_output":"(ns yang.php.antlr.permutations\n  \"The permutation corpus of docs/design/yang.php.md section 4.6 source 3:\n   from `$a = [1, 2]; $r = &$a[0];` every sequence of the alphabet below,\n   printing `var_dump($a, $b, $c, $q, $r, $s)`; once over a flat array and once\n   over the nested path `$a['x'][0]`. Data and generator only: the quick tier\n   runs `quick-sample`, the slow tier `full`, and `src/dev/yang/php/corpus.clj`\n   records the oracle's output for every program on shiva.\")\n\n\n(def alphabet\n  \"Letter to the statement it stands for, flat and nested.\"\n  [[\\C \"$b = $a;\" \"$b = $a;\"]\n   [\\U \"unset($r);\" \"unset($r);\"]\n   [\\W \"$b[0] = 2;\" \"$b['x'][0] = 2;\"]\n   [\\X \"unset($b[0]);\" \"unset($b['x'][0]);\"]\n   [\\A \"$a[0] = 3;\" \"$a['x'][0] = 3;\"]\n   [\\D \"unset($b);\" \"unset($b);\"]\n   [\\N \"$c = $b; $c[1] = 9;\" \"$c = $b; $c['x'][1] = 9;\"]\n   [\\B \"$s = &$b[1]; $s = 9;\" \"$s = &$b['x'][1]; $s = 9;\"]\n   [\\Z \"$z = &$a; unset($z);\" \"$z = &$a; unset($z);\"]\n   [\\T \"$a = 0;\" \"$a = 0;\"]\n   [\\L \"$q = [&$r]; unset($r);\" \"$q = [&$r]; unset($r);\"]\n   [\\G \"f($a);\" \"f($a);\"]\n   [\\E \"$a = &$a;\" \"$a = &$a;\"]])\n\n\n(def letters (mapv first alphabet))\n\n\n(def ^:private preamble\n  {:flat \"<?php function f($p) { $p[0] = 7; } $a = [1, 2]; $r = &$a[0];\",\n   :nested \"<?php function f($p) { $p['x'][0] = 7; } $a = ['x' => [1, 2]]; $r = &$a['x'][0];\"})\n\n\n(defn program\n  \"The PHP source of sequence `letters-str` (a string over `letters`) in\n   `variant` (`:flat` or `:nested`).\"\n  [variant letters-str]\n  (let [idx (if (= variant :flat) 1 2)\n        stmts (into {} (map (fn [row] [(first row) (nth row idx)])) alphabet)]\n    (str (get preamble variant)\n         \" \"\n         (apply str (interpose \" \" (map stmts letters-str)))\n         \" var_dump($a, $b, $c, $q, $r, $s);\")))\n\n\n(defn sequences\n  \"Every string of length `n` over the alphabet, in lexicographic letter order.\"\n  [n]\n  (if (zero? n)\n    [\"\"]\n    (for [prefix (sequences (dec n))\n          l letters]\n      (str prefix l))))\n\n\n(defn- lcg\n  \"A deterministic stream of non-negative ints below `bound` from `seed`.\"\n  [seed bound]\n  (rest (map #(mod (quot % 65536) bound)\n             (iterate #(mod (+ (* % 1103515245) 12345) 2147483648) seed))))\n\n\n(defn sampled-sequences\n  \"`k` sequences of length `n` drawn with a fixed seed (the same list on every run).\"\n  [n k seed]\n  (->> (lcg seed (count letters))\n       (partition n)\n       (map #(apply str (map letters %)))\n       distinct\n       (take k)\n       vec))\n\n\n(def full-ids\n  \"Every sequence of length 2 and 3, plus 300 of length 4 and 300 of length 5.\"\n  (vec (concat (sequences 2) (sequences 3) (sampled-sequences 4 300 4) (sampled-sequences 5 300 5))))\n\n\n(def quick-ids\n  \"A fixed sample for the quick tier: all of length 2 (169), 40 of length 3\n   and 25 of lengths 4 and 5 each.\"\n  (vec (concat (sequences 2) (sampled-sequences 3 40 3) (sampled-sequences 4 25 14)\n               (sampled-sequences 5 25 15))))\n\n\n(defn full\n  \"`[{:id [variant letters] :source s}]` for the full corpus, both variants.\"\n  []\n  (vec (for [v [:flat :nested]\n             ids full-ids]\n         {:id [v ids], :source (program v ids)})))\n\n\n(defn quick\n  []\n  (vec (for [v [:flat :nested]\n             ids quick-ids]\n         {:id [v ids], :source (program v ids)})))\nfunctionCall\n    : functionCallName actualArguments\n    ;\n\nfunctionCallName\n    : qualifiedNamespaceName\n    | classConstant\n    | chainBase\n    | parentheses\n    ;\n\nactualArguments\n    : genericDynamicArgs? arguments+ squareCurlyExpression*\n    ;\n\ncastOperation\n    : BoolType\n    | Int8Cast\n    | Int16Cast\n    | IntType\n    | Int64Type\n    | UintCast\n    | DoubleCast\n    | DoubleType\n    | FloatCast\n    | StringType\n    | BinaryCast\n    | UnicodeCast\n    | Array\n    | ObjectType\n    | Resource\n    | Unset\n    ;(ns yang.core.lower\n  \"Lowering helpers shared by every language's CST-to-Universal-AST lowering\n   (docs/design/yang.typescript.md §17, lift L2): the CST accessors over a\n   lowering context `{:pk packet ...}`, the generated-name supply, safepoint\n   site marks, and the diagnostic builders. A language supplies its\n   diagnostic namespace (a string such as \\\"yang.python.antlr\\\"), its name\n   for messages and its table of unsupported rules.\"\n  (:require\n    [yang.antlr.packet :as p]\n    [yang.core.uast :as u]))\n\n\n;; =============================================================================\n;; Diagnostics\n;; =============================================================================\n\n(defn unsupported!\n  \"Throw the `<diagnostic-ns>/unsupported` diagnostic for rule node `n`\n   naming `construct`; `language` is the name the message uses.\"\n  [diagnostic-ns language n construct]\n  (throw (ex-info (str \"Unsupported \" language \" construct: \" construct)\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"unsupported\"),\n                   :rule (:rule n),\n                   :construct construct,\n                   :span (:span n)})))\n\n\n(defn syntax!\n  \"Throw the `<diagnostic-ns>/syntax` diagnostic for rule node `n`.\"\n  [diagnostic-ns n message]\n  (throw (ex-info message\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"syntax\"),\n                   :rule (:rule n),\n                   :span (:span n)})))\n\n","exit_code":0,"status":"completed"}}
