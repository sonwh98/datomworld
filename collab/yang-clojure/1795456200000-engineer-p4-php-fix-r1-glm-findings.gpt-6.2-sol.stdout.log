{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn- (isset-var|.*peek.*|persistent-function|lower-function|lower-call-plain|unsupported\"'!|require-capability!)|\"unset\"|isset-var'\"' src/cljc/yang/php/antlr/lower.cljc\nsed -n '750,855p;1060,1105p;1160,1210p;1940,2010p;3330,3465p' src/cljc/yang/php/antlr/lower.cljc\"","aggregated_output":"68:(defn- unsupported!\n286:(defn- require-capability! [ctx n cap construct]\n742:(defn- peek-var\n813:(defn- isset-var\n1065:(defn- peek-loc\n1092:    (isset-var ctx (:var loc))\n1943:          \"unset\" (lower-unset ctx n (argument-chains ctx n arguments))\n1979:(defn- lower-call-plain [ctx n call]\n1993:        \"unset\" (require-capability! ctx n :mutation/delete :unset)\n3378:(defn- persistent-function [ctx n written params body arrow?]\n3413:(defn- lower-function\n      (this-var? name) (cond\n                         (:fn ctx) (hook ctx :php/this-or-null (u/v '%fn))\n                         (:module? ctx) (hook ctx :php/ctx-this-or-null (u/v '%ctx))\n                         :else (literal ctx :nil nil))\n      :else (if-let [cv (cv-node ctx name)]\n              (hook ctx :php/local-peek cv)\n              (scope-op ctx \"peek\" name)))))\n\n\n(defn- write-var\n  \"Assign `node` to the variable; the expression's value is the value.\"\n  [ctx name node]\n  (when (this-var? name) (compile-error! {} \"Cannot re-assign $this\"))\n  (when (= \"$GLOBALS\" name) (compile-error! {} \"Cannot assign to $GLOBALS\"))\n  (cond\n    (not (legacy? ctx))\n    (if-let [local (persistent-var ctx name)]\n      (u/let1 '%assigned node (u/then (app* 'cell/set! local (u/v '%assigned)) (u/v '%assigned)))\n      (hook ctx :env/set (u/v state-sym) (u/lit (bare name)) node))\n\n    (dynamic-var? name) (dynamic-op ctx \"set!\" name node)\n    :else\n    (if-let [cv (cv-node ctx name)]\n      (hook ctx :php/local-set! cv node)\n      (scope-op ctx \"set!\" name node))))\n\n\n(defn- put-var\n  \"Write back a container the variable already owns: through a marker, with\n   no counting.\"\n  [ctx name node]\n  (cond\n    (this-var? name) node\n    (dynamic-var? name) (dynamic-op ctx \"put!\" name node)\n    (= \"$GLOBALS\" name) (hook ctx :php/globals-put! node)\n    :else (if-let [cv (cv-node ctx name)]\n            (hook ctx :php/local-put! cv node)\n            (scope-op ctx \"put!\" name node))))\n\n\n(defn- make-ref-var\n  \"The reference marker of the variable, made on first use.\"\n  [ctx name]\n  (when (dynamic-var? name) (unsupported! {} :dynamic-reference))\n  (when (= \"$GLOBALS\" name) (compile-error! {} \"Cannot acquire a reference to $GLOBALS\"))\n  (if-let [cv (cv-node ctx name)]\n    (if (static-var? name)\n      (let [[cls prop] (static-parts name)]\n        (hook ctx :php/sprop-ref (class-ref-node ctx nil cls) (u/lit prop) (cc-node ctx)))\n      (hook ctx :php/make-ref-cv cv))\n    (scope-op ctx \"make-ref!\" name)))\n\n\n(defn- bind-var\n  \"Bind the variable to the marker `m` (`$x =& ...`).\"\n  [ctx name m]\n  (when (dynamic-var? name) (unsupported! {} :dynamic-reference))\n  (when (= \"$GLOBALS\" name) (compile-error! {} \"Cannot assign to $GLOBALS\"))\n  (if-let [cv (cv-node ctx name)]\n    (hook ctx :php/bind-marker cv m)\n    (scope-op ctx \"bind!\" name m)))\n\n\n(defn- isset-var\n  [ctx name]\n  (cond\n    (dynamic-var? name) (dynamic-op ctx \"isset?\" name)\n    (= \"$GLOBALS\" name) (literal ctx :bool true)\n    (this-var? name) (cond\n                       (:fn ctx) (hook ctx :php/has-this? (u/v '%fn))\n                       (:module? ctx) (hook ctx :php/ctx-has-this? (u/v '%ctx))\n                       :else (literal ctx :bool false))\n    :else (if-let [cv (cv-node ctx name)]\n            (hook ctx :php/local-isset? cv)\n            (scope-op ctx \"isset?\" name))))\n\n\n(defn- unset-var\n  [ctx name]\n  (when (this-var? name) (compile-error! {} \"Cannot unset $this\"))\n  (when (= \"$GLOBALS\" name) (compile-error! {} \"Cannot unset $GLOBALS\"))\n  (if (dynamic-var? name)\n    (dynamic-op ctx \"unset!\" name)\n    (if-let [cv (cv-node ctx name)]\n      (hook ctx :php/local-unset! cv)\n      (scope-op ctx \"unset!\" name))))\n\n\n;; =============================================================================\n;; Strings\n;; =============================================================================\n\n(defn- interpolation-follows?\n  \"True when the text part `part` would continue a simple-syntax variable\n   into an index or a property: `$a[0]`, `$a->b`.\"\n  [part]\n  (let [t (:text part)]\n    (boolean (or (str/starts-with? t \"[\")\n                 (re-find #\"^->[A-Za-z_\\x7f-\\xff]\" t)))))\n\n\n(defn- interpolated-node\n  \"The concatenation of a double-quoted string's parts: text runs resolved\n   to bytes, plain variables read in order. `end` is where the opening quote\n   ends, to tell `{$x}` from `$x` by the gap the braces leave.\"\n  [ctx n end parts]\n(defn- read-loc\n  [ctx loc]\n  (reduce (fn [acc k] (hook ctx :coll/get acc k)) (read-var ctx (:var loc)) (:path loc)))\n\n\n(defn- peek-loc\n  \"The value at `loc`, null when anything on the way is missing; no diagnostic.\"\n  [ctx loc]\n  (reduce (fn [acc k] (app* (hook-name ctx (if (legacy? ctx) :php/dim-peek :coll/get)) acc k)) (peek-var ctx (:var loc)) (:path loc)))\n\n\n(defn- write-loc\n  \"Store `node` at `loc`: read the holder, update it purely, store it back.\n   The expression's value is the stored value.\"\n  [ctx n loc node]\n  (if (empty? (:path loc))\n    (write-var ctx (:var loc) node)\n    (let [w (core/gen \"w\" n)]\n      (u/let1 w\n              node\n              (u/then (put-var ctx\n                               (:var loc)\n                               (hook ctx :php/path-assign\n                                     (peek-var ctx (:var loc))\n                                     (path-node ctx (:path loc))\n                                     (u/v w)))\n                      (u/v w))))))\n\n\n(defn- isset-loc\n  [ctx loc]\n  (if (empty? (:path loc))\n    (isset-var ctx (:var loc))\n    (app* 'not (app* '= (peek-loc ctx loc) (literal ctx :nil nil)))))\n\n\n(defn- unset-loc\n  \"Remove the offset: never vivifies; a holder that is not an array is not\n   written back.\"\n  [ctx n loc]\n  (if (empty? (:path loc))\n    (unset-var ctx (:var loc))\n    (let [o (core/gen \"o\" n)\n          pruned (hook ctx :php/path-unset (u/v o) (path-node ctx (:path loc)))]\n      (u/let1 o\n              (read-var ctx (:var loc))\n(defn- lower-cast\n  [ctx n [_ op _ operand]]\n  (let [t (first (core/kids ctx op))\n        e (lower ctx operand)]\n    (case (:type t)\n      \"IntType\" (hook ctx :php/to-int e)\n      (\"FloatCast\" \"DoubleType\") (hook ctx :php/to-float e)\n      \"StringType\" (hook ctx :op/str e)\n      \"BoolType\" (hook ctx :op/truthy e)\n      (unsupported! n (keyword \"cast\" (str/lower-case (:type t)))))))\n\n\n(defn- lower-isset\n  [ctx n chains]\n  (let [one (fn [c]\n              (let [loc (chain-loc ctx n c :isset-target)]\n                (forbid-append! n loc \"Cannot use [] for reading\")\n                (isset-loc ctx (lower-path ctx loc))))]\n    (reduce (fn [acc c] (u/if-node acc (one c) (literal ctx :bool false)))\n            (one (first chains))\n            (rest chains))))\n\n\n(defn- lower-empty\n  [ctx n c]\n  (let [loc (chain-loc ctx n c :empty-target)]\n    (forbid-append! n loc \"Cannot use [] for reading\")\n    (app* 'not (truthy ctx (peek-loc ctx (lower-path ctx loc))))))\n\n\n(defn- lower-unset\n  [ctx n chains]\n  (u/then (u/seq-nodes (mapv (fn [c]\n                               (let [loc (chain-loc ctx n c :unset-target)]\n                                 (forbid-append! n loc \"Cannot use [] for unsetting\")\n                                 (with-keys ctx loc #(unset-loc ctx n %))))\n                             chains))\n          (literal ctx :nil nil)))\n\n\n(defn- check-write-location! [ctx n loc]\n  (require-capab