gram batch, then one record on port `:diagnostics`\n   per warning (`:severity :warning`); a refusal is a diagnostic and no\n   program. Stateless.\"\n  [state packet]\n  (let [warned (atom [])\n        [state' outputs] (core-stage/lower-transform (stage-config warned) state packet)]\n    [state'\n     (into outputs\n           (map (fn [w] [:diagnostics (assoc w :yang.cst/unit (:yang.cst/unit packet))]))\n           @warned)]))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. The fourth argument may instead be\n   an options map `{:medium :prelude}`.\"\n  ([cst-stream program-stream diagnostics-stream]\n   (core-stage/open-stage (stage-config (atom [])) cst-stream program-stream diagnostics-stream))\n  ([cst-stream program-stream diagnostics-stream medium-or-opts]\n   (core-stage/open-stage (stage-config (atom []))\n                          cst-stream\n                          program-stream\n                          diagnostics-stream\n                          medium-or-opts)))\n\n\n(defn step-stage\n  [s]\n  (stage/step s lower-transform))\ntest/yang/php/antlr/programs.cljc:308:    :diag [[2 \"Undefined variable $g\"]],\ntest/yang/php/antlr/programs.cljc:564:    :diag [[2 \"Undefined array key \\\"y\\\"\"] [2 \"Undefined array key 3\"] [2 \"Trying to access array offset on null\"] [2 \"Trying to access array offset on int\"] [2 \"Trying to access array offset on true\"] [2 \"Trying to access array offset on float\"] [2 \"Undefined variable $u\"] [2 \"Trying to access array offset on null\"]],\ntest/yang/php/antlr/programs_p9.cljc:128:       :diag [[2 \"Undefined variable $p_z\"]])\ntest/yang/php/antlr/programs_p9.cljc:132:       :diag [[2 \"compact(): Undefined variable $missing\"]])\ntest/yang/php/antlr/programs_p6.cljc:107:       :diag [[2 \"Undefined variable $undef\"]])\n-rw-r--r--@ 1 sto  whee