ambient-correspondence\n3436:      :ambient-correspondence kernel-ambient-correspondence\n3503:    (is (= (count (:fixtures kernel-gate-corpus)) (count (set (map :id (:fixtures evidence)))))\n3508:                  fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n3555:            :let [fixture (first (filter #(= (:id row) (:id %)) (:fixtures kernel-gate-corpus)))]]\n4245:  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n4269:  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n4336:  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n4348:  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n4391:  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n4549:  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n4564:  (let [fixture (first (filter #(= :minimal-last (:id %)) (:fixtures kernel-gate-corpus)))\n4588:   (let [corpus (:fixtures kernel-gate-corpus)\n4669:  (let [corpus (:fixtures kernel-gate-corpus)\n","exit_code":0,"status":"completed"}}
