:lost first-pos})))\n          delta (- (clock) started)\n          _ (when (neg? delta) (throw (ex-info \\\"Clock moved backwards\\\" {:stage :bound-measurement})))\n          observed {:steps steps :elapsed-ms (quot (+ delta 999999) 1000000)\n                    :heap-bytes (heap) :trace-records (or tail 0)}]\n      (check-bounds\"'! limits observed)\n      nil)))\n'\"'''\nopen(p,'w').write(s)\nPY\nclojure -M:test -n yang.correspondence-measure-test -n yang.correspondence-lane-test -n yang.correspondence-baseline-test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
