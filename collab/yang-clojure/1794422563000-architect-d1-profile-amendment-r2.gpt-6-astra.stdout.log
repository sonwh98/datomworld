{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/correspondence_text.clj; rg -n 'correspondence-text|reconstruction-input|capture|fidelity|Integer|metadata' test/yang/correspondence_text_test.clj test/yang/latte_oracle_test.clj | tail -90\"","aggregated_output":"     1\t(ns yang.correspondence-text\n     2\t  \"JVM text capture pilot. Acceptance still requires a pinned dependency closure\n     3\t   and per-compilation replay of every claimed artifact.\"\n     4\t  (:require [clojure.edn :as edn]))\n     5\t\n     6\t(def profile\n     7\t  {:yang.correspondence.text/schema 1\n     8\t   :host :jvm\n     9\t   :clojure-version (clojure-version)\n    10\t   :java-version (System/getProperty \"java.version\")\n    11\t   :java-vendor (System/getProperty \"java.vendor\")\n    12\t   :encoding :utf-8\n    13\t   :normalization :none\n    14\t   :printer 'clojure.core/pr-str\n    15\t   :printer-options {:meta true :length nil :level nil :readably true\n    16\t                     :dup false :namespace-maps false}\n    17\t   :reader 'clojure.edn/read\n    18\t   :reader-options {:values 1 :eof-required true :ambient-readers false\n    19\t                    :tags :unsupported}\n    20\t   :domain :edn-with-readable-metadata})\n    21\t\n    22\t(defn- kind\n    23\t  [x]\n    24\t  (cond (map? x) :map (vector? x) :vector (set? x) :set\n    25\t        (seq? x) :list (sequential? x) :sequence :else :scalar))\n    26\t\n    27\t(defn- mismatch\n    28\t  [a b path]\n    29\t  (cond\n    30\t    (not= (kind a) (kind b)) {:path path :reason :kind :actual (kind a) :read (kind b)}\n    31\t    (not= (some? (meta a)) (some? (meta b))) {:path path :reason :metadata-presence}\n    32\t    :else\n    33\t    (or (when (some? (meta a)) (mismatch (meta a) (meta b) (conj path :metadata)))\n    34\t        (case (kind a)\n    35\t          :map (if (not= (count a) (count b))\n    36\t                 {:path path :reason :count}\n    37\t                 (some identity\n    38\t                       (map-indexed (fn [i [[ak av] [bk bv]]]\n    39\t                                      (or (mismatch ak bk (conj path [:key i]))\n    40\t                                          (mismatch av bv (conj path [:value i]))))\n    41\t                                    (map vector a b))))\n    42\t          (:vector :list :sequence :set)\n    43\t          (if (not= (count a) (count b))\n    44\t            {:path path :reason :count}\n    45\t            (some identity (map-indexed (fn [i [x y]] (mismatch x y (conj path i)))\n    46\t                                        (map vector a b))))\n    47\t          :scalar (when-not (and (= a b) (or (not (number? a))\n    48\t                                         (and (= (class a) (class b)) (.equals a b))))\n    49\t                    {:path path :reason :scalar :actual (str (class a)) :read (str (class b))})))))\n    50\t\n    51\t(defn faithful?\n    52\t  \"Compare syntax kind, collection iteration order, scalar numeric type and\n    53\t   metadata recursively. This is deliberately stricter than Clojure equality.\"\n    54\t  [a b]\n    55\t  (nil? (mismatch a b [])))\n    56\t\n    57\t(defn- refusal\n    58\t  [compilation stage cause]\n    59\t  (ex-info \"Text reconstruction refused\"\n    60\t           {:rule :correspondence/text :compilation compilation :stage stage} cause))\n    61\t\n    62\t(defn read-one!\n    63\t  \"Read one EDN value, refusing all tagged values and any trailing value.\"\n    64\t  [compilation source]\n    65\t  (try\n    66\t    (let [reader (java.io.PushbackReader. (java.io.StringReader. source))\n    67\t          eof (Object.)\n    68\t          reject-tag (fn [tag _] (throw (ex-info \"Unsupported tag\" {:tag tag})))\n    69\t          reject-builtin (fn [_] (throw (ex-info \"Unsupported tag\" {})))\n    70\t          options {:eof eof :readers {'inst reject-builtin 'uuid reject-builtin}\n    71\t                   :default reject-tag}\n    72\t          value (edn/read options reader)\n    73\t          trailing (edn/read options reader)]\n    74\t      (when (or (identical? eof value) (not (identical? eof trailing)))\n    75\t        (throw (ex-info \"Expected exactly one value\" {})))\n    76\t      value)\n    77\t    (catch Exception e (throw (refusal compilation :read e)))))\n    78\t\n    79\t(defn capture!\n    80\t  \"Print and immediately read back an actual input, refusing lossy captures.\"\n    81\t  [compilation value]\n    82\t  (let [source (try (binding [*print-meta* true *print-length* nil *print-level* nil\n    83\t                              *print-readably* true *print-dup* false\n    84\t                              *print-namespace-maps* false]\n    85\t                      (pr-str value))\n    86\t                    (catch Exception e (throw (refusal compilation :print e))))\n    87\t        restored (read-one! compilation source)]\n    88\t    (when-let [difference (mismatch value restored [])]\n    89\t      (throw (ex-info \"Text capture loses input fidelity\"\n    90\t                      {:rule :correspondence/text :compilation compilation\n    91\t                       :stage :fidelity :difference difference})))\n    92\t    source))\ntest/yang/correspondence_text_test.clj:1:(ns yang.correspondence-text-test\ntest/yang/correspondence_text_test.clj:5:            [yang.correspondence-text :as text]\ntest/yang/correspondence_text_test.clj:9:(deftest profile-fidelity-and-reader-refusals\ntest/yang/correspondence_text_test.clj:10:  (testing \"fidelity preserves syntax kinds, numeric types, metadata, and iteration order\"\ntest/yang/correspondence_text_test.clj:27:          source (text/capture! :fixture original)]\ntest/yang/correspondence_text_test.clj:29:  (testing \"unsupported objects and metadata loss refuse with stage and compilation\"\ntest/yang/correspondence_text_test.clj:30:    (let [failure (try (text/capture! :fixture (Object.)) nil\ntest/yang/correspondence_text_test.clj:33:      (is (contains? #{:print :read :fidelity} (:stage failure))))\ntest/yang/correspondence_text_test.clj:34:    (let [failure (try (text/capture! :fixture (with-meta '[a] {:line (int 3)})) nil\ntest/yang/correspondence_text_test.clj:36:      (is (= :fidelity (:stage failure)))\ntest/yang/latte_oracle_test.clj:22:            [yang.correspondence-text :as correspondence-text]\ntest/yang/latte_oracle_test.clj:194:  \"Collection families and domain metadata, excluding reader provenance.\"\ntest/yang/latte_oracle_test.clj:268:         (str \"oracle lane shapes and metadata agree: \" (pr-str call-form)))\ntest/yang/latte_oracle_test.clj:850:                \"value equality also preserves nested metadata and collection shape\")))))))\ntest/yang/latte_oracle_test.clj:984:          \"B/C preserve collection families and domain metadata\"))\ntest/yang/latte_oracle_test.clj:1293:                    '(register-unparser base :captured (fn [term] [(+ offset term) true])))\ntest/yang/latte_oracle_test.clj:1328:    (testing \"a live registry with a captured guest closure survives UCF reconstruction\"\ntest/yang/latte_oracle_test.clj:1341:            _ (is (values/closure? (get-in k [:unparser-registry :unparsers :captured\ntest/yang/latte_oracle_test.clj:1351:        (is (values/closure? (get-in k' [:unparser-registry :unparsers :captured\ntest/yang/latte_oracle_test.clj:1699:  \"EDN evidence retains all portable values and metadata. Nonportable host\ntest/yang/latte_oracle_test.clj:2513:                     (correspondence-text/capture! {:fixture (:id fixture) :input :forms} forms))\ntest/yang/latte_oracle_test.clj:2515:                    (correspondence-text/capture! {:fixture (:id fixture) :input :call} call))\ntest/yang/latte_oracle_test.clj:2527:                       (correspondence-text/capture! {:fixture (:id fixture) :input :program} program))\ntest/yang/latte_oracle_test.clj:2529:                       (correspondence-text/capture! {:fixture (:id fixture) :input :options} opts))\ntest/yang/latte_oracle_test.clj:2550:         (assoc :reconstruction-input\ntest/yang/latte_oracle_test.clj:2773:   and a complete record - the file is authoritative for this metadata, and\ntest/yang/latte_oracle_test.clj:3391:      'kind/with-meta \"Pure metadata attachment on the existing host value representation; the data ABI has no metadata-write export.\"}\ntest/yang/latte_oracle_test.clj:3796:                r (:yin/frontend-metadata p)]\ntest/yang/latte_oracle_test.clj:3809:                r (:yin/frontend-metadata p)]\ntest/yang/latte_oracle_test.clj:4260:(deftest test-d1-admission-refuses-metadata-number-drift\ntest/yang/latte_oracle_test.clj:4261:  ;; The real corpus exposes reader metadata whose Integer is printed as an\ntest/yang/latte_oracle_test.clj:4262:  ;; untyped EDN integer and read as Long. It must not pass the fidelity gate.\ntest/yang/latte_oracle_test.clj:4268:    (is (= :fidelity (:stage failure)))\ntest/yang/latte_oracle_test.clj:4270:    (is (= \"class java.lang.Integer\" (get-in failure [:difference :actual])))\n","exit_code":0,"status":"completed"}}
