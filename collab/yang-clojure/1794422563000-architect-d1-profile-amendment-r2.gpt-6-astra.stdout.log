r metadata.\"\n   340\t  [sym]\n   341\t  (if (namespace sym)\n   342\t    (symbol (namespace sym) (name sym))\n   343\t    (symbol (name sym))))\n   344\t\n   345\t\n   346\t(defn- body-expression\n   347\t  [body-forms]\n   348\t  (cond\n   610\t(defn- parse-defn\n   611\t  \"Parse (defn name doc? attr-map? [params] body*) or\n   612\t   (defn name doc? attr-map? ([params] body*)+ attr-map?). Returns\n   613\t   {:name :meta :arities [{:params :body}]}. Metadata accumulates as\n   614\t   Clojure's defn does: name meta (with defn-'s :private), then the\n   615\t   docstring, the attr-map and the trailing attr-map, later ones winning.\"\n   616\t  [operator operands]\n   617\t  (let [{fn-name :name, :keys [doc attrs more]} (parse-head operator operands)\n   618\t        header (merge (cond-> (meta fn-name)\n   619\t                        (= 'defn- operator) (assoc :private true))\n   620\t                      (when doc {:doc doc})\n   621\t                      attrs)]\n   622\t    (cond\n   623\t      (vector? (first more))\n   624\t      {:name fn-name, :meta header\n   625\t       :arities [{:params (first more), :body (rest more)}]}\n   626\t\n   627\t      (and (seq? (first more)) (vector? (ffirst more)))\n   628\t      (let [arities (take-while seq? more)\n   629\t            trailing (drop (count arities) more)]\n   630\t        (when (and (seq trailing)\n   631\t                   (not (and (map? (first trailing)) (nil? (next trailing)))))\n   632\t          (reject! \"Unexpected forms after fn arities\" {:name fn-name}))\n   633\t        {:name fn-name, :meta (merge header (first trailing))\n   634\t         :arities (mapv (fn [a]\n   635\t                          (when-not (vector? (first a))\n   636\t                            (reject! \"Malformed fn arity\" {:name fn-name}))\n   637\t                          {:params (first a), :body (rest a)})\n   638\t                        arities)})\n   639\t\n   640\t      :else\n   641\t      (reject! (str \"Malformed \" operator \" form\") {:name fn-name}))))\n   642\t\n   643\t\n   644\t(declare compile-fn compile-av-fn)\n   645\t\n   646\t\n   647\t(defn- compile-defn\n   648\t  \"Compile a defn form natively to a yin/def application: the tree the\n   649\t   expander's standard `defn` also produces. This path is used only when no\n   650\t   defmacro named defn is in scope. Several arities need the argument-vector\n   651\t   convention: a plain Yin closure nil-fills missing arguments and drops\n   652\t   extras, so it cannot observe the call's argument count.\"\n   653\t  [operator operands env tail? macro-env]\n   654\t  (let [{fn-name :name, header :meta, :keys [arities]} (parse-defn operator operands)\n   655\t        fn-ast (if (::convention env)\n   656\t                 (compile-av-fn arities env false macro-env fn-name)\n   657\t                 (do (when (< 1 (count arities))\n   658\t                       (reject! \"Multi-arity fn is not supported: closures cannot observe argument count\"\n   659\t                                {:name fn-name, :arities (count arities)}))\n   660\t                     (let [{:keys [params body]} (first arities)]\n   661\t                       (compile-fn params body env false macro-env))))\n   662\t        ast (cond-> {:type :application\n   663\t                     :operator {:type :variable, :name 'yin/def}\n   664\t                     :operands [{:type :literal, :value (strip-symbol-meta fn-name)}\n   665\t                                fn-ast]}\n   666\t              tail? (assoc :tail? true))]\n   667\t    (if (seq header)\n   668\t      (vary-meta ast merge header)\n   669\t      ast)))\n   670\t\n   671\t\n   672\t(defn- check-macro-params!\n   673\t  \"Every macro parameter is a plain symbol outside the reserved prefix; an\n   674\t   & must be followed by exactly one binder.\"\n   675\t  [params]\n  1075\t  (rewrite-ex-info (rewrite-throw-try (body-expression body-forms))))\n  1076\t\n  1077\t\n  1078\t(def ^:private source-keys [:line :column :end-line :end-column])\n  1079\t\n  1080\t\n  1081\t(defn- source-meta\n  1082\t  \"The source position keys of `form`'s reader metadata, or nil.\"\n  1083\t  [form]\n  1084\t  (not-empty (select-keys (meta form) source-keys)))\n  1085\t\n  1086\t\n  1087\t(defn- arity-error-form\n  1088\t  \"The raise of a call whose argument count no arity admits: it names the\n  1089\t   function, never a zero-argument data/count refusal naming count. An\n  1090\t   anonymous fn has no name: it is `:yin.k/kind :anonymous` and carries the\n  1091\t   fn form's source position, when the reader gave one.\"\n  1092\t  [fn-name source]\n  1093\t  (list 'clj/throw\n  1094\t        (cond-> {:yin.vm.data/reason :arity\n  1095\t                 :yin.k/argc (list 'data/count av-sym)}\n  1940\t\n  1941\t  Quoted forms become literals.\"\n  1942\t  [form tail?]\n  1943\t  (compile-literal form tail?))\n  1944\t\n  1945\t\n  1946\t(defn resolve-primitive\n  1947\t  \"Resolve primitive operations in the environment.\n  1948\t\n  1949\t  Primitives like +, -, *, /, =, <, > are built into the Yin VM\n  1950\t  and are accessed as variables.\"\n  1951\t  [sym]\n  1952\t  (when (contains? #{'+ '- '* '/ '= '< '>} sym) sym))\n  1953\t\n  1954\t\n  1955\t(defn- compile-form*\n  1956\t  \"Compile a Clojure form to Universal AST.\n  1957\t\n  1958\t  This is the main entry point that dispatches to specific compilers\n  1959\t  based on the form type.\n  1960\t\n  1961\t  macro-env: compile-time map of defmacro names in scope. A macro call is an\n  1962\t  ordinary application; macro-env only stops the native defn lowering.\"\n  1963\t  [form tail? env macro-env top?]\n  1964\t  (cond\n  1965\t    ;; Literals: constants self-evaluate; collections with dynamic elements\n  1966\t    ;; lower to constructor calls so their elements evaluate like Clojure\n  1967\t    (literal? form)\n  1968\t    (if (constant-form? form)\n  1969\t      (compile-literal form tail?)\n  1970\t      (compile-constructed-collection form tail? env macro-env))\n  1971\t    ;; The empty list is self-evaluating data, not an application\n  1972\t    (and (seq? form) (empty? form)) (compile-literal form tail?)\n  1973\t    ;; Variables (symbols)\n  1974\t    (symbol? form) (if (native-name? env form)\n  1975\t                     (if (outcomes? env)\n  1976\t                       (compile-call-descriptor (compile-adapter form env false macro-env) tail?)\n  1977\t                       (compile-adapter form env tail? macro-env))\n  1978\t                     (compile-variable form tail?))\n  1979\t    ;; Special forms and function application\n  1980\t    (seq? form)\n  2050\t                (compile-def sym value env tail? macro-env))\n  2051\t          ;; Macro definition: (defmacro name params & body)\n  2052\t          defmacro (do (check-top-level! env top? operator)\n  2053\t                       (compile-defmacro operands env tail? macro-env))\n  2054\t          ;; Function application: (f arg1 arg2 ...)\n  2055\t          (compile-application operator operands env tail? macro-env))))\n  2056\t    ;; Unknown form type\n  2057\t    :else (throw (ex-info \"Cannot compile unknown form type\"\n  2058\t                          {:form form,\n  2059\t                           :type #?(:cljd (clojure.core/str (.-runtimeType form))\n  2060\t                                    :default (clojure.core/type form))}))))\n  2061\t\n  2062\t\n  2063\t(defn- compile-form-1\n  2064\t  [form tail? env macro-env]\n  2065\t  (let [ast (compile-form* form tail? (dissoc env ::top-level) macro-env\n  2066\t                           (::top-level env))\n  2067\t        m (meta form)]\n  2068\t    (if (seq (dissoc m ::fn-loop))\n  2069\t      (vary-meta ast merge (dissoc m ::fn-loop))\n  2070\t      ast)))\n  2071\t\n  2072\t\n  2073\t(defn compile-form\n  2074\t  \"Compile one Clojure form and retain the reader's plain metadata on the\n  2075\t   emitted Universal AST node. The tuple boundary removes it from content\n  2076\t   and writes positions and other frontend facts to occurrence side tables.\n  2077\t   The returned tree is C1-finalized (`annotate-call-sites`); recursive\n  2078\t   calls inside one compilation defer to the owning call's walk.\"\n  2079\t  ([form] (compile-form form false {} initial-macro-env))\n  2080\t  ([form env] (compile-form form false env initial-macro-env))\n  2081\t  ([form tail? env] (compile-form form tail? env initial-macro-env))\n  2082\t  ([form tail? env macro-env]\n  2083\t   (if *call-site-finalizing*\n  2084\t     (compile-form-1 form tail? env macro-env)\n  2085\t     (binding [*call-site-finalizing* true]\n  2086\t       (annotate-call-sites (compile-form-1 form tail? env macro-env))))))\n  2490\t;; fn? (data/callable?), seq, rem, reverse, list, cons, vector, count,\n  2491\t;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\n  2492\t;; keys/vals/disj and set union/difference,\n  2493\t;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\n  2494\t;; compiler intrinsic over the convention's argument vector.\n  2495\t;;\n  2496\t;; What stays a host primitive, named by the `kind` module: a symbol, a\n  2497\t;; keyword and a host string are distinguished or built only by the host\n  2498\t;; (symbol?, keyword?, name, symbol, keyword, str, int?), as is metadata access\n  2499\t;; (meta and with-meta). The current data ABI has no metadata-write export,\n  2500\t;; so with-meta is an explicit pure representation seam, not an ambient store.\n  2501\t;; No VM primitive tells a symbol from a keyword. Clojure Var identity is an\n  2502\t;; explicitly admitted kind/var? seam on the JVM; namespace lookup (resolve)\n  2503\t;; still requires a separately installed host capability.\n  2504\t;;\n  2505\t;; Known compromises: `reduced` is an untyped tagged map, so reduced? matches\n  2506\t;; any map holding :yin.k/reduced true; seq refuses a non-collection (a string\n  2507\t;; is the data module's str-* ops, not a seq); eager sequences are lists;\n  2508\t;; rem rejects non-integers and a zero divisor before arithmetic; the compiler\n  2509\t;; emits bare conj and vec, so a program may not define or bind either.\n  2510\t;; When collection calls are needed, invoke-value is a library helper whose\n  2511\t;; local capture is refused explicitly.\n  2512\t;;\n  2513\t;; Variadic Clojure functions are fixed-arity here (the convention has no\n  2514\t;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\n  2515\t;; merge 0 to 4, union 0 to 6, difference 2, comp 0 to 3, partial binds 1 to 3.\n  2516\t;; A larger count is the\n  2517\t;; function's own arity error.\n  2518\t\n  2519\t(def library-adapters\n  2520\t  \"The retired `:adapters` map a program using `library` once compiled with:\n  2521\t   the data exports whose refusal the collection predicates read as data.\n  2522\t   The continuation port rewrote those predicates onto the `data/*` and\n  2523\t   `kind/*` host predicates, so no `portable/*` adapter is consulted; the\n  2524\t   map stays for the `library-opts`/`unit-opts` fixtures and the prelude's\n  2525\t   `admit` registration.\"\n  2526\t  {'data/count 'portable/count\n  2527\t   'data/peek 'portable/peek\n  2528\t   'data/dissoc 'portable/dissoc\n  2529\t   'data/disj 'portable/disj\n  2530\t   'data/str-length 'portable/str-length})\n  2531\t\n  2532\t\n  2533\t(def kind-module\n  2534\t  \"The `kind` host module's exports, symbol to host function: the irreducible\n  2535\t   kind and name primitives (see the library notes). Every export is pure.\"\n  2536\t  (merge\n  2537\t    {'symbol? symbol?\n  2538\t     'keyword? keyword?\n  2539\t     'name name\n  2540\t     'symbol symbol\n  2541\t     'keyword keyword\n  2542\t     'str str\n  2543\t     'int? int?\n  2544\t     'with-meta with-meta\n  2545\t     'meta meta\n  2546\t     'coll? coll?\n  2547\t     'set? set?}\n  2548\t    #?(:clj {'var? var?} :default {})))\n  2549\t\n  2550\t\n  2551\t(def kind-arities\n  2552\t  \"The published arities of each `kind` export.\"\n  2553\t  {'symbol? [1], 'keyword? [1], 'name [1], 'symbol [1 2], 'keyword [1 2]\n  2554\t   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'var? [1], 'with-meta [2], 'meta [1]\n  2555\t   'coll? [1], 'set? [1]})\n  2556\t\n  2557\t\n  2558\t(def library\n   499\t;; ==========================================================================\n   500\t\n   501\t(defn numeric-kind\n   502\t  \"The content kind of numeric x: :integer, :float64, :decimal or :rational.\n   503\t   Host integer width is not a kind: a long and a big integer of one value\n   504\t   are both :integer.\"\n   505\t  [x]\n   506\t  (cond\n   507\t    (host-integer? x) :integer\n   508\t    (float64? x) :float64\n   509\t    (decimal? x) :decimal\n   510\t    (ratio? x) :rational\n   511\t    :else (refuse :unsupported-value\n   512\t                  (str \"not a portable number: \" (type-name x)))))\n   513\t\n   514\t\n   515\t(defn- numeric-content-key\n   516\t  \"The kind-strict identity of numeric x, the same distinctions content\n   517\t   addressing makes: kind, then within float64 the exact bits (so the zero\n   518\t   sign counts, and every NaN is the one canonical NaN), within decimal the\n   519\t   exponent (scale) and mantissa, within rational the reduced numerator and\n   520\t   denominator. Integer width is not identity. Built from strings and\n   521\t   keywords, so equal content gives equal keys on every host.\"\n   522\t  [x]\n   523\t  (case (numeric-kind x)\n   524\t    :integer (do (when-not (integer/exact-integer? x)\n   525\t                   (refuse :unsupported-value\n   526\t                           (str \"unsafe integral JavaScript number: \"\n   527\t                                \"its value is already rounded\")))\n   528\t                 [::integer (str (big x))])\n   529\t    :float64 (let [[neg e f] (float/fields (number/float-value x))]\n   530\t               (if (and (= e 0x7ff) (pos? (bsign f)))\n   531\t                 [::float64 :nan]\n   532\t                 [::float64 neg e (str f)]))\n   533\t    :decimal [::decimal\n   534\t              (str (decimal-exponent x))\n   535\t              (str (big (decimal-mantissa x)))]\n   536\t    :rational (let [[_ n d] (exact x)]\n   537\t                [::rational (str n) (str d)])))\n   538\t\ncat: src/clj/dao/host/integer.clj: No such file or directory\n","exit_code":1,"status":"failed"}}
