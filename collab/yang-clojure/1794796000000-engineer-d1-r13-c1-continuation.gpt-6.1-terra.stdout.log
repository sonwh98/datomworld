    [clojure.tools.reader :as r]\\n            [clojure.tools.reader.reader-types :as rt]\\n            [yang.clojure :as yang]\\n            [yang.clojure-test :as compiler-test]\\n            [yang.core.call :as call]\\n            [yin.vm :as vm]\\n            [yin.vm.test-utils :as tu]\\n            [yin.vm.data :as data]\\n            [yin.vm.module :as module]\\n            [yin.vm.encoder :as encoder]\\n            [yin.vm.ucf.rows :as rows]\\n            [yin.vm.ucf.rows-support :as rows-support]\\n            [yin.vm.values :as values]\\n            [yin.vm.semantic :as semantic]\\n            [yin.vm.semantic.linearize :as linearize]\\n            [yin.vm.ucf :as ucf]))\\n\\n\\n(def ^:private manifest\\n  (edn/read-string (slurp (io/resource \\\"yang/latte_oracle/manifest.edn\\\"))))\\n\\n\\n(defn- ns-declaration-aliases\\n  \\\"Alias -> full ns symbol, taken from the file's own (ns ...) declaration —\\n   never invented: ::alias/kw must read as :that.real.ns/kw.\\\"\\n  [ns-form]\\n  (let [alias-map (atom {})\\n        consume-spec (fn [spec]\\n                       (when (sequential? spec)\\n                         (let [lib (first spec)]\\n                           (loop [xs (rest spec)]\\n                             (when (seq xs)\\n                               (if (= :as (first xs))\\n                                 (do (swap! alias-map assoc (second xs) lib)\\n                                     (recur (drop 2 xs)))\\n                                 (recur (next xs))))))))]\\n    (loop [clauses (rest (rest ns-form))]\\n      (when (seq clauses)\\n        (let [clause (first clauses)]\\n          (if (and (seq? clause) (= :require (first clause)))\\n            (do (loop [reqs (next clause)]\\n                  (let [spec (first reqs)]\\n                    (when (and (not (nil? spec)) (not (keyword? spec)))\\n                      (consume-spec spec)\\n                      (recur (next reqs)))))\\n                (recur (next clauses)))\\n            (recur (next clauses))))))\\n    @alias-map))\\n\\n\\n(defn- read-forms\\n  \\\"Read one latte-kernel source file with reader conditionals resolved for\\n   :clj, ::alias/kw keywords resolved against the file's own ns declaration,\\n   and ::kw resolved against the file's own namespace — so the C leg compiles\\n   the same keyword identities the upstream A leg runs.\\\"\\n  [ns-sym]\\n  (let [f (io/resource (str (str/replace (name ns-sym) \\\".\\\" \\\"/\\\") \\\".cljc\\\"))\\n        pr (rt/source-logging-push-back-reader (java.io.PushbackReader. (io/reader f)) 1 (str f))\\n        ns-form (r/read {:read-cond :allow :features #{:clj} :eof ::eof} pr)\\n        declared-name (second ns-form)\\n        aliases (ns-declaration-aliases ns-form)]\\n    (binding [r/*alias-map* aliases\\n              *ns* (the-ns (create-ns declared-name))]\\n      (loop [acc []]\\n        (let [form (r/read {:read-cond :allow :features #{:clj} :eof ::eof} pr)]\\n          (if (= form ::eof) acc (recur (conj acc form))))))))\\n\\n\\n(def ^:private all-forms\\n  (into {} (map (fn [ns-sym] [ns-sym (read-forms ns-sym)])\\n                (distinct (map :ns manifest)))))\\n\\n\\n(def ^:private top-forms\\n  (into {} (map (fn [{:keys [ns kind name]}]\\n                  [[ns name] (first (filter #(and (seq? %)\\n                                                  (= kind (first %))\\n                                                  (= name (second %)))\\n                                            (get all-forms ns)))]))\\n        manifest))\\n\\n\\n(def ^:private scanned-symbols\\n  #{'loop 'recur 'case 'throw 'ex-info 'atom 'swap! 'reset! 'lazy-seq 'gensym\\n    'apply 'comp 'partial 'reduced 'reduce 'map 'mapv 'filter 'remove 'into\\n    'concat 'merge 'str 'symbol 'keyword 'vector 'seq 'nth 'nthnext 'assoc-in\\n    'count 'name 'when-let 'if-let 'when-some 'if-some 'cond})\\n\\n\\n(defn- walk-symbols\\n  [form]\\n  (cond\\n    (seq? form) (if (and (= 'quote (first form)) (= 2 (count form)))\\n                  #{}\\n                  (mapcat walk-symbols form))\\nFixed both findings in [latte_oracle_test.clj](/Users/sto/workspace/datomworld/test/yang/latte_oracle_test.clj:2404). [Applied diff](/private/tmp/yang-oracle-audit-fix/fix.patch).\\n\\n- Hashing now renames generated symbols by first occurrence across `[forms call]`, preserving shared references. Regression tests cover repeated NBE reads, symbol identity, and ordinary source changes.\\n- Case 6 uses `:nbe-beta`, requires a dynamic site executed in both lanes, and runs the refusal assertion unconditionally.\\n\\nVerification passed:\\n\\n- **5 tests, 1,393 assertions; zero failures/errors.**\\n- Fresh JVM with advanced reader counter: **155/155 hashes identical**, **165/165 arities credited**.\\n- All **20,805 site rows unchanged**; 60 hashes normalized.\\n- Lint: zero errors, two existing warnings. Whitespace check passed.\\n\\nOnly the requested source file changed. Artifacts were regenerated in a temporary directory. To refresh the committed EDN files:\\n\\n```sh\\nclojure -Sdeps \\\\\\n  '{:aliases {:refresh {:main-opts [\\\"-e\\\" \\\"(require (quote yang.latte-oracle-test)) (yang.latte-oracle-test/write-kernel-gate-evidence!)\\\"]}}}' \\\\\\n  -M:test:refresh\\n```\",\"exit_code\":0,\"status\":\"completed\"}}\ndocs/agents/team.md:55:|                 | Model Studio, ap-southeast-1)          | v26.1.0), not a Claude Code wrapper. Headless dispatch and session mechanics measured (2026-11-04): caller  |\ndocs/agents/team.md:156:| `gpt-6.1-sol`               | Intelligent everyday workhorse with near-Astra intelligence, 1M+   | More expensive than Luna. Use Astra when the task is the hardest    |\ndocs/agents/team.md:162:| `gpt-6.1-terra`             | Balanced intelligence and cost. **Best for:** Default production   | Use Sol or Astra for the hardest reasoning, high-risk security, or  |\ncollab/yang-clojure/1794210254000-architect-cc1-p1-1-confirm.gpt-6-astra.stdout.log:5:{\"typ