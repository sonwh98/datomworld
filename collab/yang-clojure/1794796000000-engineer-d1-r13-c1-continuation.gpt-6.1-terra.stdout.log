{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'cat target/d1-r12-claim-phase-pilot.clj'","aggregated_output":"(require '[clojure.edn :as edn]\n         '[yang.correspondence-verification :as verification]\n         '[yang.correspondence-measure :as measure]\n         '[yang.correspondence-batch :as batch]\n         '[yang.latte-oracle-test :as oracle]\n         '[yang.clojure :as yang]\n         '[yin.repl.store :as store])\n(let [source (batch/read-progress \"collab/yang-clojure/1794720000000-engineer-d1-r9e.outcomes.edn\")\n      plan (edn/read-string (slurp \"collab/yang-clojure/1794735000000-engineer-d1-r12-claim-plan.edn\"))\n      out \"collab/yang-clojure/1794735000000-engineer-d1-r12-claim-phase-pilot.edn\"\n      ids (mapv :id (:fixtures @(ns-resolve 'yang.latte-oracle-test 'kernel-gate-corpus)))\n      _ (when-not (and (= (set ids) (set (keys (:outcomes source))))\n                       (= :producer-derived-claim-plan (:scope plan))\n                       (seq (:claims plan)))\n          (throw (ex-info \"Corpus or claim plan mismatch\" {:stage :inputs})))\n      _ (when-not (.exists (java.io.File. out))\n          (measure/initialize! out ids {:scope :r12-full-claim-predeclaration-pilot\n                                        :pre-declaration-tagged-execution true}))\n      rt (Runtime/getRuntime) clock #(System/nanoTime) heap #(- (.totalMemory rt) (.freeMemory rt))\n      sampler ((ns-resolve 'yang.latte-oracle-test 'd1-heap-sampler!) 5)\n      opening (clock)\n      h (store/open {:type :file :dir \"target/d1-r9e-retained-store\"})\n      open-ms (quot (- (clock) opening) 1000000)\n      registry ((ns-resolve 'yang.latte-oracle-test 'oracle-registry) yang/kind-module)\n      limits {:walker {:steps 4000000 :elapsed-ms 60000 :heap-bytes 6000000000\n                       :trace-records 5000 :trace-record-bytes 100 :trace-bytes 150000 :trace-heap-bytes 650000}\n              :semantic {:steps 2200000 :elapsed-ms 60000 :heap-bytes 6000000000\n                         :trace-records 5000 :trace-record-bytes 100 :trace-bytes 150000 :trace-heap-bytes 650000}}\n      opts {:trace-size-fn #(CorrespondenceSizeAgent/deepBytes %)\n            :fixture-limit-ms 180000\n            :tree-limits {:rows 20000 :occurrences 75000 :applications 20000\n                          :depth 750 :application-path-bytes 6000000}}]\n  (try\n    (prn {:store-open-ms open-ms :claim-count (count (:claims plan))\n          :carrier-relation-independently-verified false}) (flush)\n    (doseq [id ids :when (= :not-run (get-in (measure/read-progress out) [:outcomes id :status]))]\n      (let [result (try (assoc (verification/verify-retained-fixture!\n                                h id (get-in source [:outcomes id]) (:claims plan)\n                                limits registry clock heap opts)\n                               :pilot-limits-not-declared true\n                               :carrier-relation-independently-verified false)\n                        (catch Exception e {:status :refused :stage (or (:stage (ex-data e)) :harness)\n                                            :rule (:rule (ex-data e)) :message (ex-message e)\n                                            :pilot-limits-not-declared true}))]\n        (measure/record! out id result)\n        (prn {:fixture id :status (:status result) :stage (:stage result)\n              :lane (:lane result) :quantity (:quantity result)\n              :observed (:observed result) :ceiling (:ceiling result)\n              :fixture-ms (:fixture-elapsed-ms result) :phases (:phases result)\n              :gate-phases (:gate-phases result)\n              :credited (count (filter true? (:attributed result)))}) (flush)))\n    (finally (store/close! h)\n             (prn {:sampled-process-heap-bytes ((:stop! sampler))}) (flush))))\n(shutdown-agents)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/correspondence_baseline.clj'","aggregated_output":"(ns yang.correspondence-baseline\n  \"Prepare a trace-free comparison program from retained oracle inputs.\"\n  (:require [yang.correspondence-text :as text]))\n\n\n(defn untraced-program!\n  \"Remove the verified oracle trace prelude and replace verified traced forms\n   with captured original forms. Preserve the already-assembled library prefix.\n   Refuse any unexpected assembly, rather than guessing which forms to strip.\"\n  [program forms prelude traced call]\n  (let [suffix (vec (concat prelude traced [call]))\n        n (- (count program) (count suffix))]\n    (when-not (and (vector? program) (sequential? forms) (sequential? traced)\n                   (= (count forms) (count traced)) (<= 0 n)\n                   (let [actual (subvec program n)\n                         bootstrap (quote (def gate-execution-trace (stream/make 1000000)))\n                         strip? (and (= bootstrap (first suffix)) (= bootstrap (first actual)))]\n                     (if strip?\n                       (text/faithful? (subvec suffix 1) (subvec actual 1))\n                       (text/faithful? suffix actual))))\n      (throw (ex-info \"Unexpected retained program assembly\" {:stage :baseline-assembly})))\n    (into (subvec program 0 n) (concat forms [call]))))\n\n\n(defn two-field-trace-form\n  \"The body-entry instrumentation from oracle revision f2d7df87, applied to\n   the current captured forms for a measured historical-tracer comparison.\"\n  [form]\n  (if (#{'defn 'defn-} (first form))\n    (let [[op fname & header] form\n          header (drop-while #(not (or (vector? %) (seq? %))) header)\n          trace-arity (fn [[params & body]]\n                        (let [n (if (some #{'&} params)\n                                  [:variadic (.indexOf params '&)] (count params))]\n                          (list* params\n                                 (list 'stream/put! 'gate-execution-trace (list 'quote [fname n]))\n                                 body)))]\n      (list* op fname (if (vector? (first header))\n                        (trace-arity header) (map trace-arity header))))\n    form))\n","exit_code":0,"status":"completed"}}
