{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"/bin/cat <<'CLJ' | bb -e '(load-string (slurp *in*))'\n\n(require '[clojure.edn :as edn] '[clojure.string :as str] '[clojure.java.shell :refer [sh]])\n(defn committed [path]\n  (let [{:keys [exit out]} (sh \\\"git\\\" \\\"show\\\" (str \\\"c43d1000:\\\" path))]\n    (assert (zero? exit) path)\n    out))\n(def evidence-dir \\\"collab/yang-clojure/1795127457000-cc4-budget-evidence/\\\")\n(def hosts [\\\"darkstar\\\" \\\"jupiter\\\"])\n(def cohorts [\\\"pre7\\\" \\\"post7\\\" \\\"post8\\\"])\n(def configs [\\\"B\\\" \\\"S\\\"])\n(defn read-run [host cohort config]\n  (let [stem (if (and (= host \\\"darkstar\\\") (= cohort \\\"post8\\\")) \\\"post\\\" cohort)\n        lines (str/split-lines (committed (str evidence-dir host \\\"-cc4-\\\" stem \\\"-\\\" config \\\".log\\\")))\n        records (filter #(str/starts-with? % \\\"{\\\") lines)]\n    (assert (= 1 (count records)) [host cohort config (count records)])\n    (edn/read-string (first records))))\n(def limits {:per-artifact 2000000 :storage 32000000 :retained 96000000\n             :heap 2147483648 :pipeline 80000 :cold 160000\n             :rows 50000 :occurrences 100000 :applications 10000\n             :depth 256 :path-bytes 8000000})\n(defn input-ok [m]\n  (and (= (set (keys m)) #{:rows :occurrences :applications :depth :path-bytes})\n       (every? (fn [[k v]] (<= 0 v (limits k))) m)))\n(defn mx [xs k] (apply max (map k xs)))\n(def runs (into {} (for [h hosts c cohorts b configs] [[h c b] (read-run h c b)])))\n(def findings (committed \\\"collab/yang-clojure/1795130900000-engineer-cc4-budget-closure.glm-5.3.findings.md\\\"))\n(def table-rows (re-seq #\\\"(?m)\"'^'\"\\\\| (pre7|post7|post8) (B|S)(?: \\\\(suppl\\\\.\\\\))? \\\\| (\\\\d+) \\\\| (\\\\d+) \\\\| (\\\\d+) \\\\| (\\\\d+) \\\\| (\\\\d+) \\\\| ([\"'^|]+) '\"\\\\|\"'$\" findings))\n(assert (= 12 (count table-rows)) table-rows)\n(def metrics [:time :storage :per-artifact :heap :retained])\n(doseq [[[h c b] [_ tc tb & cells]] (map vector (for [h hosts c cohorts b configs] [h c b]) table-rows)]\n  (let [{:keys [cold pipeline-samples retained-samples maxima verdicts ceilings configuration memory-method]} (runs [h c b])\n        ps pipeline-samples\n        rs retained-samples\n        ps+cold (cons cold ps)\n        n (if (= c \"post8\") 8 7)\n        stage (apply max (mapcat (comp vals :stages-ms) ps+cold))\n        computed {:time (mx ps :elapsed-ms)\n                  :storage (mx ps :storage)\n                  :per-artifact (mx ps :largest-artifact)\n                  :heap (mx ps :peak-used-heap)\n                  :retained (mx rs :delta)}\n        computed-verdicts {:cold (<= (:elapsed-ms cold) (limits :cold))\n                           :pipeline (<= (:time computed) (limits :pipeline))\n                           :storage (<= (:storage computed) (limits :storage))\n                           :per-artifact (<= (:per-artifact computed) (limits :per-artifact))\n                           :heap (<= (:heap computed) (limits :heap))\n                           :retained (<= (:retained computed) (limits :retained))\n                           :stage-buckets (<= stage (limits :pipeline))}\n        ctx [h c b]\n        digest (-> ps first :image-digest)\n        appendix (last cells)]\n    (assert (= c tc) ctx)\n    (assert (= b tb (name configuration)) ctx)\n    (when-not (= (map computed metrics) (map parse-long (take 5 cells))) (println :table-mismatch ctx (mapv computed metrics) (vec (take 5 cells))))\n    (when-not (if (= h \"darkstar\") (str/starts-with? digest appendix) (= \"all pass\" appendix)) (println :appendix-mismatch ctx appendix digest))\n    (assert (= :jvm-gc-used-heap-2ms-sampled-peak memory-method) ctx)\n    (assert (= [3 5] [(count ps) (count rs)]) ctx)\n    (assert (= computed maxima) ctx)\n    (assert (= ceilings limits) ctx)\n    (assert (= computed-verdicts verdicts) ctx)\n    (assert (every? true? (vals verdicts)) ctx)\n    (assert (<= (mx ps+cold :peak-used-heap) (limits :heap)) ctx)\n    (assert (<= (mx ps+cold :stage-heap-max) (limits :heap)) ctx)\n    (assert (<= (mx ps+cold :storage) (limits :storage)) ctx)\n    (assert (<= (mx ps+cold :largest-artifact) (limits :per-artifact)) ctx)\n    (doseq [r rs] (assert (= n (:retained-members r)) ctx)\n                  (assert (= (:delta r) (- (:after r) (:before r))) ctx))\n    (doseq [p ps+cold]\n      (let [{:keys [counts per-member roots elapsed-ms stages-ms largest-artifact storage]} p\n            cnts (map :counts per-member)\n            m-depth (mx cnts :depth)\n            sums (apply merge-with + cnts)\n            sizes (mapcat :sizes per-member)]\n        (assert (= n (count per-member) (count roots)) ctx)\n        (assert (= (assoc sums :depth m-depth) counts) ctx)\n        (assert (every? input-ok (cons counts cnts)) ctx)\n        (assert (= elapsed-ms (reduce + (vals stages-ms))) ctx)\n        (assert (= digest (:image-digest p)) ctx)\n        (assert (= largest-artifact (apply max sizes)) ctx)\n        (assert (<= largest-artifact storage (apply + sizes)) ctx)))\n    (println (str/join \" | \" [ctx (mapv computed metrics)\n      {:warm (mapv :elapsed-ms ps) :cold (:elapsed-ms cold)\n       :cold-buckets (:stages-ms cold) :warm-stage-max (apply max (mapcat (comp vals :stages-ms) ps))\n       :heap-cold (:peak-used-heap cold) :heap-all (mx ps+cold :peak-used-heap)\n       :heap-stage (mx ps+cold :stage-heap-max)\n       :counts (apply merge-with max (map :counts ps+cold))\n       :sizes (mapv :sizes (:per-member (first ps)))}]))))\n(doseq [c cohorts b configs]\n  (let [ds (map #(runs [% c b]) hosts)]\n    (assert (apply = (map #(select-keys (:maxima %) [:storage :per-artifact]) ds)) [c b])\n    (assert (apply = (map #(map (fn [p] (select-keys p [:storage :largest-artifact :per-member :image-digest :roots])) (cons (:cold %) (:pipeline-samples %))) ds)) [c b])))\n(def deltas (vec (for [h hosts c cohorts]\n              (let [[b s] (map #(runs [h c %]) configs)\n                    keys [:time :retained :storage]\n                    delta (mapv #(- (get-in s [:maxima %]) (get-in b [:maxima %])) keys)]\n                (assert (every? true? (map <= delta [40000 96000000 32000000])) [h c])\n                (assert (apply = (for [r [b s]] (map #(select-keys % [:image-digest :roots]) (cons (:cold r) (:pipeline-samples r))))) [h c])\n                (println [h c] :delta delta :digest (-> b :cold :image-digest))\n                delta))))\n(def delta-table (re-seq #\"(?m)''^'\"\\\\| (pipeline time ms|retained B|aggregate static bytes) \\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([0-9]+) \\\\|\"'$\" findings))\n(assert (= 3 (count delta-table)))\n\n(def expected-deltas (mapv #(conj (vec %1) %2) (apply mapv vector (mapv deltas [0 1 3 4])) [40000 96000000 32000000]))\n(doseq [[[_ qty & values] expected] (map vector delta-table expected-deltas)]\n  (let [actual (mapv parse-long values)]\n    (when-not (= actual expected)\n      (println :delta-table-mismatch qty actual expected))))\n(doseq [c cohorts]\n  (let [p (-> (runs [\"darkstar\" c \"S\"]) :cold)]\n    (println :cohort c (mapv #(vector (subs (str %1) 16 32) (get-in %2 [:counts :applications]) (:sizes %2)) (:roots p) (:per-member p)))))\n(println :verified)\n\nCLJ'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"git show 2175252d:test/yang/clojure_callsite_test.cljc | sed -n '880,1035p;1110,1155p'; git show 8456c2e9 --stat; git show 8456c2e9 | rg -n -C 2 'two.application|three.application|data/nth' | head -70; git diff --name-status c43d1000 -- test/yang/cc4_budget_runner.clj test/yang/cc4_corpus.clj collab/yang-clojure/1795017203479-cc4-r2-budget-runner.cljc.draft collab/yang-clojure/1795016601236-cc4-r2-budget-declaration-v1.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"git show 2175252d:test/yang/clojure_callsite_test.cljc | sed -n '880,1035p;1110,1155p'; git show 8456c2e9 --stat; git show 8456c2e9 | rg -n -C 2 'two.application|three.application|data/nth' | head -70; git diff --name-status c43d1000 -- test/yang/cc4_budget_runner.clj test/yang/cc4_corpus.clj collab/yang-clojure/1795017203479-cc4-r2-budget-runner.cljc.draft collab/yang-clojure/1795016601236-cc4-r2-budget-declaration-v1.md\"","aggregated_output":"          (is (= bad-value (:unsupported-version res)))\n          (is (nil? (:address res))))))))\n\n\n(def ^:private publish-registry\n  \"The host registry the published-module test publishes over: the\n   `cell` and `data` host modules the `clj` and `yang.call` module\n   trees read.\"\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})))\n\n\n(defn replay-artifacts\n  \"The cc4 portable replay corpus. All admission coordinates and naming inputs\n   are supplied data. Kept public so the separately declared budget runner can\n   retain exactly the artifacts whose digests the equality gate checks.\"\n  ([] (replay-artifacts true))\n  ([annotated?]\n   (let [prepare (if annotated? identity\n                     #(walk/postwalk (fn [n]\n                                       (if (map? n)\n                                         (dissoc n :yang/call-site) n)) %))\n         forms '[(defn replay\n                   [x]\n                   (let [[a b] [x 1.5]]\n                     (+ (identity ^:replay a) (identity ^:replay a) b)))\n                 (replay 2)]\n         projected (fn [id ast token]\n                     (let [ast (prepare ast)\n                           p (encoder/project\n                               (encoder/source-envelope :cc4/replay token [ast]))]\n                       {:id id :compiled ast :tree (first (:yin/batch p))\n                        :rows (:yin/frontend-metadata p)}))\n         ast (yang/compile-program forms)\n         macro-ast (yang/compile-program\n                     '[(defmacro twin\n                         [x]\n                         (yin/if (yin/literal true) x\n                                 (yin/application (yin/variable 'f) [(yin/literal 1)])))\n                       (defn f\n                         [x]\n                         x) (twin (f 1))])\n         expansion (:result (expand-like-the-repl (prepare macro-ast)))\n         store (mem/create-content-mem)\n         call-spec (update (call/module-spec publish-registry) :ast prepare)\n         call-result (publish/publish-module! store call-spec)\n         clj-spec (update (clj-prelude/module-spec publish-registry (:address call-result))\n                          :ast prepare)\n         clj-result (publish/publish-module! store clj-spec)\n         published (fn [id result spec]\n                     (let [table (publish/published-call-site-table store result)]\n                       {:id id :compiled (:ast spec)\n                        :tree (or (:tree table) (vm/ast->semantic-bytecode (:ast spec)))\n                        :rows (or (:rows table) [])\n                        :addresses (assoc (dissoc (:call-sites result) :origin)\n                                          :manifest (:address result))\n                        :published-payloads\n                        (when (:call-sites result)\n                          (mapv #(jing/get store % nil)\n                                (map (:call-sites result) [:table :provenance :record])))\n                        :provenance (publish/published-instruction-provenance store result)}))]\n     [(projected :native ast \"admission-a\")\n      (projected :argument-vector (yang/compile-program forms true yang/unit-opts)\n                 \"admission-a\")\n      (projected :lower-unit (yang/lower-unit forms) \"admission-a\")\n      (projected :prelude clj-prelude/module-uast \"admission-a\")\n      {:id :macro :compiled (prepare macro-ast) :status (:status expansion)\n       :tree (macro/packet->row-set (:tree expansion))\n       :rows (:frontend-metadata expansion) :expansion-log (:log expansion)}\n      (projected :negative ast \"admission-b\")\n      (published :yang.call call-result call-spec)\n      (published :clj clj-result clj-spec)])))\n\n\n(defn- collection-constructors\n  \"The constructed-collection applications of compiled `ast`: an assoc over\n   the {} seed or a conj over the []/#{} seed -- the yang.clojure\n   collection emitter's output.\"\n  [ast]\n  (let [acc (atom [])]\n    (walk/postwalk\n      (fn [n]\n        (when (and (map? n)\n                   (= :application (:type n))\n                   (= :variable (get-in n [:operator :type]))\n                   (= :literal (get-in n [:operands 0 :type])))\n          (let [op (get-in n [:operator :name])\n                seed (get-in n [:operands 0 :value])]\n            (when (or (and (= op (quote assoc)) (= seed {}))\n                      (and (= op (quote conj)) (contains? #{[] #{}} seed)))\n              (swap! acc conj n))))\n        n)\n      ast)\n    @acc))\n\n\n(defn replay-snapshot\n  \"Digest the FULL canonical-sorted C1 relation and occurrence-key vector;\n   no origin, generated name, path or expansion record is normalized away.\"\n  [{:keys [id tree rows addresses provenance expansion-log status]}]\n  (let [c1 (vec (sort jing/canonical-compare\n                      (filter #(= :yang/call-site (nth % 3)) rows)))\n        keys (vec (sort jing/canonical-compare (marked rows)))\n        sem (linearize/project-rows tree nil rows)\n        stack (derive/stack-image (:vector sem)\n                                  {:segment-address :cc4/stack\n                                   :call-provenance (:call-provenance sem)})\n        register (derive/register-image (:vector sem)\n                                        {:segment-address :cc4/register\n                                         :call-provenance (:call-provenance sem)})]\n    (cond-> {:id id :root (:root tree) :applications (count keys)\n             :keys-digest (jing/content-hash keys)\n             :c1-digest (jing/content-hash c1)\n             :instruction-provenance-digest\n             (jing/content-hash [(:call-provenance sem)\n                                 (:call-provenance stack)\n                                 (:call-provenance register)])}\n      addresses (assoc :addresses addresses)\n      provenance (assoc :provenance-digest (jing/content-hash provenance))\n      expansion-log (assoc :expansion-log-digest (jing/content-hash expansion-log)\n                           :expansion-status status))))\n\n\n(def replay-expectations\n  \"The cc4 cohort's fixed expectations, shared by all hosts. Originally\n   recorded on the JVM at dispatch revision 2687ab0c; re-pinned once under\n   manifest c1-2 (constructed-collections-v1, ruling 1795017757000) after\n   the collection emitter began ordering constructor operands by compiled\n   content -- the argument-vector and lower-unit members changed canonical\n   bytes, the other six members are byte-identical. The pre-fix bundle is\n   retained at test/resources/yang/clojure/cc4-replay-snapshots-prefix-c1-1.edn.\"\n  [{:id :native,\n    :root\n    :segment/blake3-0aac99defd315ce7623ecefc08106f31653bd138fb5ae3f1f1d466bd93893c70,\n    :applications 14,\n    :keys-digest\n    \"fa8eac643ac38139bbfb9391e5e00725b24396a04067f812117dbf352a99dcee\",\n    :c1-digest\n    \"c906019273e6253441e61306faca99b4212f122a00b08fd8226be0e0e7742c26\",\n    :instruction-provenance-digest\n    \"1556afb1db35c20b88bbc254b112fcb09874e95b3c9bcd8d412fbd3e4d01f005\"}\n   {:id :argument-vector,\n    :root\n    :segment/blake3-4a9a1b91e8a113009af0dc68f8e5a5afbe1910a61e07741894f5922c20499b26,\n    :applications 263,\n    :keys-digest\n    \"aeb62bc089bd7b30f200d9b0645e7933e54286af39b9675c73823c4be8d0175d\",\n    :c1-digest\n    \"41b8f25ba2592d4f5d77364f97e7c8d058cbe4e2a428587cc2b43a5e4193387d\",\n    :instruction-provenance-digest\n    \"d0f4d14d0cef560ad313574f206a391b1eed7938b38b81f614549bc26cb8b3cb\"}\n   {:id :lower-unit,\n    :root\n    :segment/blake3-f4603726a6b554bf102dd63f752851e735c068d3804158b2435004161c6655b4,\n    :applications 256,\n     :segment/blake3-20d2e0c43539dbf3cb66fe04e6cffea673772d06d32f753b131de6f17d3daf35,\n     :table\n     :segment/blake3-167c6aeaedace3afd945c6b7c0f1aa31f73df5d4577366fdd2431059633c1050,\n     :provenance\n     :segment/blake3-3a43087e7ea783baa6e2f6f4041dc60c6f83aee4bc49842c871d2d20c12056c6,\n     :root\n     :segment/blake3-2c3a3fa3ff94adf2e22582426e616ddbca5acb45eeff283e20bed6543f4b1a8c,\n     :manifest\n     :segment/blake3-72efd5cba6d2c36bacae7a114fca2db95b5ef5cfe966d004d16e9e39a7179ee0},\n    :provenance-digest\n    \"499f103a2af205e818483bb4ca301668bc8cf13d6e16f71e747ff0255b865287\"}])\n\n\n(deftest portable-replay-cohort-test\n  (let [artifacts (replay-artifacts)\n        snapshots (mapv replay-snapshot artifacts)]\n    (when (not= replay-expectations snapshots)\n      (doseq [[expected actual artifact] (map vector replay-expectations snapshots artifacts)\n              :when (not= expected actual)]\n        ;; Preserve the producer's actual rows and canonical tree. A failed\n        ;; equality gate is a defect report, never permission to re-pin a host.\n        (prn :cc4/replay-divergence\n             {:expected expected :actual actual\n              :artifact (select-keys artifact [:id :tree :rows :expansion-log])})))\n    (is (= replay-expectations snapshots))\n    (doseq [{:keys [id tree rows]} artifacts]\n      (testing (str id)\n        (is (= (occurrence-pairs tree) (marked-pairs rows)))))\n    (let [a (first artifacts) b (nth artifacts 5)]\n      (is (= (:root (:tree a)) (:root (:tree b))))\n      (is (not= (row-origins (:rows a)) (row-origins (:rows b)))))))\n\n\n(deftest constructed-collection-operand-order-test\n  \"constructed-collections-v1 (ruling 1795017757000): the reproduced\n   arity-map constructor emits its pairs in compiled-content order --\n   ascending jing/canonical-compare over the children's projected\n   [key-root value-root] vectors -- so every host compiles the two members\n   carrying it to one operand vector. The full ordering battery lives in\n   yang.clojure-collection-order-test.\"\n  (letfn [(arity-ctors\n            [ast]\n            (->> (collection-constructors ast)\n                 (filter (fn [c]\n                           (some (fn [o]\n                                   (and (= :literal (:type o))\ncommit 8456c2e9e0e99127d5b71650fc3bb69d4349c4e7\nAuthor: Sonny To <son.c.to@gmail.com>\nDate:   Fri Nov 13 04:19:00 2026 +0700\n\n    feat(yang.clojure): port Phase 3r — kernel-gate corpus off the outcome model + depth harness\n    \n    Admit the clj/ continuation family (continuation-family-names) so the\n    kernel-gate corpus compiles under the continuation lane. Port the site\n    stamping off the outcome model: gate-site! returns the argument vector as a\n    plain value (no data/nth outcome unwrap), and the cc3 attribution machinery\n    recognizes the two-application shape. Drop the retired :clj/outcomes?\n    descriptor marker. Add the max live-K depth harness (run-guest-machine-depth)\n    with per-workload measurement (kernel-gate-depths) and the post-port baselines\n    EDN (155 workloads).\n    \n    Co-Authored-By: Claude Code <noreply@anthropic.com>\n\n src/cljc/yang/clojure.cljc                 |   8 +\n test/yang/clojure_test.clj                 |  34 ++++\n test/yang/latte_oracle/depth_post_port.edn |   4 +\n test/yang/latte_oracle_test.clj            | 314 ++++++++++++++++-------------\n 4 files changed, 216 insertions(+), 144 deletions(-)\n8-    kernel-gate corpus compiles under the continuation lane. Port the site\n9-    stamping off the outcome model: gate-site! returns the argument vector as a\n10:    plain value (no data/nth outcome unwrap), and the cc3 attribution machinery\n11:    recognizes the two-application shape. Drop the retired :clj/outcomes?\n12-    descriptor marker. Add the max live-K depth harness (run-guest-machine-depth)\n13-    with per-workload measurement (kernel-gate-depths) and the post-port baselines\n--\n108- (defn- kernel-stamped-args?\n109-   \"The stamping wrapper around one already-stamped argument vector:\n110:-   `(data/nth (dsg__intra_call gate-site! (conj [] k <args>)) 1)`. Returns\n111--   the wrapped original arguments node.\"\n112-+   `(dsg__intra_call gate-site! (conj [] k <args>))`. Returns the wrapped\n113-+   original arguments node. Under the continuation lane the helper returns\n114:+   the argument vector as a plain value, so there is no `data/nth` outcome\n115-+   unwrap to strip.\"\n116-   [node]\n117-   (when (and (map? node) (= :application (:type node))\n118-              (= :variable (:type (:operator node)))\n119:-             (= 'data/nth (:name (:operator node)))\n120-+             (= 'dsg__intra_call (:name (:operator node)))\n121-              (= 2 (count (:operands node)))\n--\n152-                   ;; any intra-unit definition — through the unit's\n153--                  ;; dispatcher with [k args] — and unwraps the call's\n154:-                  ;; outcome with the data/nth primitive, so the stamped\n155--                  ;; expression's value IS the argument vector\n156-+                  ;; dispatcher with [k args]. Under the continuation lane the\n--\n159-+                  ;; value IS the argument vector.\n160-                   {:type :application\n161:-                   :operator {:type :variable :name 'data/nth}\n162--                   :operands [{:type :application\n163--                               :operator {:type :variable :name 'dsg__intra_call}\n--\n477-         ;; independently derived inserted helpers: each stamped site\n478--        ;; wraps its argument node in three new applications\n479:-        ;; (data/nth, dsg__intra_call, conj) — applications of the\n480-+        ;; wraps its argument node in two new applications\n481-+        ;; (dsg__intra_call, conj) — applications of the\n--\n507-+          (is (= (+ (count marked) (* 2 (count sites)))\n508-                  (count stamped-eligible))\n509:-              \"stamping inserted three applications per site and nothing else\")))\n510:+              \"stamping inserted two applications per site and nothing else\")))\n511-       (testing \"stamped paths are translated, never reused as pre-stamp paths (item 1)\"\n512-         (is (every? (fn [[k [_ _ pre-path]]]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"git status --short --branch; nl -ba collab/yang-clojure/1795130900000-engineer-cc4-budget-closure.glm-5.3.findings.md | sed -n '48,162p'; nl -ba test/yang/cc4_budget_runner.clj | sed -n '165,205p'\"","aggregated_output":"## fix/constructed-collection-order\n?? collab/yang-clojure/1795028800000-fixorder-evidence/fixorder-jvm-order-RED.log\n    48\t\n    49\t## Pins\n    50\t\n    51\t- pre-port: 8afd82f5e99d0f2b2d38a5f53b292105fdead688 (port merge\n    52\t  309fe842's first parent), git-archive source-only tree under\n    53\t  ignored target/cc4-preport (darkstar) and ~/ci/cc4-budget/pre (jupiter).\n    54\t- post-port: origin/master 2175252d (the merged fix + cc4 ancestor).\n    55\t- Ordering-fix confounder: the fix (c1-2 constructed-collections ordering)\n    56\t  is INSIDE the post pin. Its isolation record: the corpus's compiled\n    57\t  images CHANGED across the pins for port reasons (see attribution), and\n    58\t  the ordering fix's own compile-time cost (per-child content projection\n    59\t  + sort at the emitter) is measured as part of post; the fix changes no\n    60\t  side-artifact KINDS, only operand order, and the r1-r4 rounds already\n    61\t  recorded which cohort members changed bytes under it (argument-vector,\n    62\t  lower-unit) -- both carry into the post numbers and are named here.\n    63\t\n    64\t## darkstar results (Darwin 25.6.0 arm64, OpenJDK 21.0.2+13-58 mise,\n    65\t## Clojure CLI 1.12.4.1602)\n    66\t\n    67\tAll verdicts PASS (max-based, against declaration v1's ceilings; every\n    68\tinput preflight bound also passed: rows/occurrences/applications/depth/\n    69\tpath-bytes per member and aggregate).\n    70\t\n    71\t| Config | time-max ms (ceiling 80k/160k cold) | storage B (32M) | per-artifact B (2M) | heap peak B (2GiB) | retained B (96M) | image digest (B=S check) |\n    72\t|---|---:|---:|---:|---:|---:|---|\n    73\t| pre7 B | 1149 | 0 | 0 | 468581168 | 1138072 | a8f247fb4c26ead4 |\n    74\t| pre7 S | 1090 | 648359 | 200858 | 502695504 | 3162104 | a8f247fb4c26ead4 |\n    75\t| post7 B | 1238 | 0 | 0 | 486428872 | 1439488 | 3ef61619af947f7a |\n    76\t| post7 S | 1691 | 880907 | 178036 | 573427192 | 4408712 | 3ef61619af947f7a |\n    77\t| post8 B (suppl.) | 16022 | 0 | 0 | 663306424 | 2044672 | f129cdc573742a87 |\n    78\t| post8 S (suppl.) | 19324 | 1118350 | 178036 | 767829728 | 5442488 | f129cdc573742a87 |\n    79\t\n    80\t## jupiter results (48-core Linux, system OpenJDK 21.0.13.1, Clojure CLI\n    81\t## 1.12.0.1495)\n    82\t\n    83\t| Config | time-max ms | storage B | per-artifact B | heap peak B | retained B | verdicts |\n    84\t|---|---:|---:|---:|---:|---:|---|\n    85\t| pre7 B | 1263 | 0 | 0 | 855059280 | 1176168 | all pass |\n    86\t| pre7 S | 1392 | 648359 | 200858 | 774420392 | 3179320 | all pass |\n    87\t| post7 B | 1724 | 0 | 0 | 856924792 | 1439784 | all pass |\n    88\t| post7 S | 1970 | 880907 | 178036 | 901329432 | 4361048 | all pass |\n    89\t| post8 B (suppl.) | 1791 | 0 | 0 | 864689096 | 2221232 | all pass |\n    90\t| post8 S (suppl.) | 2080 | 1118350 | 178036 | 860342952 | 5346728 | all pass |\n    91\t\n    92\tStorage and per-artifact maxima are byte-identical to darkstar's per\n    93\tconfiguration (content-addressed artifacts measured from identical\n    94\tcanonical bytes); heap/time differ by host as expected.\n    95\t\n    96\tCross-host: every configuration's image digest is IDENTICAL across\n    97\tdarkstar and jupiter (canonical agreement of the measured images on both\n    98\tpins); every verdict PASS on both hosts.\n    99\t\n   100\t## S minus B (the declaration's overhead record, with the B limitation)\n   101\t\n   102\tThe B limitation, stated per the declaration: annotations are COMMON\n   103\tcompile work (the production compiler always annotates), and B strips C1\n   104\tmarkers only before projection/lowering/publication/persistence/load/\n   105\tquery. S-B therefore measures DOWNSTREAM static-artifact overhead and\n   106\tcannot establish the annotation producer's incremental compile cost; no\n   107\tzero-overhead claim is made.\n   108\t\n   109\t| Quantity (7-member comparable set) | darkstar pre | darkstar post | jupiter pre | jupiter post | S-B ceiling |\n   110\t|---|---:|---:|---:|---:|---:|\n   111\t| pipeline time ms | -59 (noise) | +453 | +129 (noise) | +246 | 40000 |\n   112\t| retained B | +2024056 | +2969224 | +2003152 | +2921264 | 96000000 |\n   113\t| aggregate static bytes | +648359 | +880907 | +648359 | +880907 | 32000000 |\n   114\t\n   115\tAt this corpus scale the pipeline-time S-B delta is below run-to-run\n   116\tnoise (pre7 darkstar measured S FASTER than B); the memory and storage\n   117\tdeltas are the meaningful signal, and both are two-plus orders under\n   118\ttheir ceilings.\n   119\t\n   120\t## Attribution (port Phase 2 d60038ef vs the ordering fix)\n   121\t\n   122\t- The compiled images CHANGED across the pins (digests a8f247fb pre vs\n   123\t  3ef61619 post on the identical 7-member corpus): the port's Phase 2\n   124\t  wrapper reduction (3 to 2 applications per wrapper, Phase 3r 8456c2e9\n   125\t  lineage) changed the corpus's canonical code. Pre/post byte sizes are\n   126\t  therefore measurements of DIFFERENT (both valid) compiled content.\n   127\t- The heavyweight side artifact SHRANK across the port: pre7-S\n   128\t  per-artifact max 200858 B (the argument-vector member's provenance\n   129\t  relation) vs post7-S 178036 B -- consistent with fewer wrapper\n   130\t  applications at post. Aggregate 7-member storage moved 648359 to\n   131\t  880907 B (post larger in aggregate on darkstar; per-member tables in\n   132\t  the logs) -- both far under the 32 MB ceiling.\n   133\t- The ordering fix's own contribution to post: it is INSIDE the post pin\n   134\t  and inseparable from it at the whole-pipeline level by design; what the\n   135\t  fix round already pinned exactly is WHICH members changed bytes under\n   136\t  it (argument-vector, lower-unit) and that its per-child cost is\n   137\t  content projection + sort at the emitter. No artifact KINDS were added;\n   138\t  no trace; the declaration's S-B row bounds its downstream effect\n   139\t  together with the port's.\n   140\t- Cold/warm and stage buckets: every stage-bucket maximum on both hosts\n   141\t  is under the 80000 ms per-stage ceiling by two-plus orders (largest\n   142\t  observed bucket ~16 s cold compile-expand-publish on the darkstar\n   143\t  8-member supplementary run).\n   144\t\n   145\t## Honesty section\n   146\t\n   147\t- CORPUS-FIDELITY BUG (found by this round's own cross-check, fixed,\n   148\t  re-measured): the corpus copy's first version applied the C1-stripping\n   149\t  prepare unconditionally, so early \"S\" runs measured a B-shaped corpus\n   150\t  (empty provenance relation, 4-byte payloads). Detected when jupiter's\n   151\t  post8-S storage (7277 B) contradicted darkstar's cohort-based post8-S\n   152\t  (1118350 B) with identical image digests. Fixed (annotated? gate +\n   153\t  the cohort's exact admission tokens), fidelity re-verified member-by-\n   154\t  member (rows byte-equal), and EVERY S configuration re-executed with\n   155\t  the fixed corpus on both hosts. The B runs are unaffected (the B path\n   156\t  strips identically in both versions); darkstar's post8 pair (cohort-\n   157\t  based) was never affected.\n   158\t- The lower-unit member is EXCLUDED from the comparable set by a genuine\n   159\t  pre-port refusal (recorded above with the probe output); the\n   160\t  declaration's 8-member ceilings are evaluated against BOTH the\n   161\t  7-member comparable set and the 8-member supplementary runs -- both\n   162\t  pass everywhere.\n   165\t        pin (volatile! (:holder result))\n   166\t        after (gc-heap)\n   167\t        alive (count (first @pin))]\n   168\t    {:before before :after after :delta (- after before)\n   169\t     :retained-members alive}))\n   170\t\n   171\t\n   172\t(defn measure\n   173\t  [annotated?]\n   174\t  (let [cold (sample annotated?)\n   175\t        _ (sample annotated?)\n   176\t        pipes (mapv (fn [_] (sample annotated?)) (range 3))\n   177\t        holds (vec (map (fn [_] (retained annotated?)) (range 5)))\n   178\t        max-of (fn [k] (apply max (map k pipes)))\n   179\t        peak (max-of :peak-used-heap)\n   180\t        retained-max (apply max (map :delta holds))]\n   181\t    {:configuration (if annotated? :S :B)\n   182\t     :memory-method :jvm-gc-used-heap-2ms-sampled-peak\n   183\t     :cold cold :pipeline-samples pipes :retained-samples holds\n   184\t     :maxima {:time (max-of :elapsed-ms)\n   185\t              :storage (max-of :storage)\n   186\t              :per-artifact (max-of :largest-artifact)\n   187\t              :heap peak\n   188\t              :retained retained-max}\n   189\t     :verdicts {:cold (<= (:elapsed-ms cold) (:cold ceilings))\n   190\t                :pipeline (<= (max-of :elapsed-ms) (:pipeline ceilings))\n   191\t                :storage (<= (max-of :storage) (:storage ceilings))\n   192\t                :per-artifact (<= (max-of :largest-artifact)\n   193\t                                  (:per-artifact ceilings))\n   194\t                :heap (<= peak (:heap ceilings))\n   195\t                :retained (<= retained-max (:retained ceilings))\n   196\t                :stage-buckets (<= (apply max\n   197\t                                          (mapcat #(vals (:stages-ms %))\n   198\t                                                  (cons cold pipes)))\n   199\t                                   (:pipeline ceilings))}}))\n   200\t\n   201\t\n   202\t(defn -main\n   203\t  [& args]\n   204\t  (let [cfg (case (first args)\n   205\t              \"B\" :B \"S\" :S\n","exit_code":0,"status":"completed"}}
