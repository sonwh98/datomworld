ohorts]\n              (let [[b s] (map #(runs [h c %]) configs)\n                    keys [:time :retained :storage]\n                    delta (mapv #(- (get-in s [:maxima %]) (get-in b [:maxima %])) keys)]\n                (assert (every? true? (map <= delta [40000 96000000 32000000])) [h c])\n                (assert (apply = (for [r [b s]] (map #(select-keys % [:image-digest :roots]) (cons (:cold r) (:pipeline-samples r))))) [h c])\n                (println [h c] :delta delta :digest (-> b :cold :image-digest))\n                delta))))\n(def delta-table (re-seq #\"(?m)''^'\"\\\\| (pipeline time ms|retained B|aggregate static bytes) \\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([+-]?[0-9]+)[\"'^|]* '\"\\\\| ([0-9]+) \\\\|\"'$\" findings))\n(assert (= 3 (count delta-table)))\n(assert (= (mapv #(mapv parse-long (drop 2 %)) delta-table)\n           (mapv #(conj (vec %1) %2) (apply mapv vector (mapv deltas [0 1 3 4])) [40000 96000000 32000000])))\n(println :verified)\n\nCLJ'","aggregated_output":":table-mismatch [darkstar pre7 B] [1106 0 0 464122968 1139560] [1149 0 0 468581168 1138072]\n[\"darkstar\" \"pre7\" \"B\"] | [1106 0 0 464122968 1139560] | {:sizes [[0] [0] [0] [0] [0] [0] [0]], :heap-cold 284204664, :counts {:rows 939, :occurrences 1784, :applications 489, :path-bytes 12766, :depth 50}, :warm-stage-max 1015, :cold-buckets {:compile-expand-publish 2362, :lower-persist-load-query 188}, :warm [1106 1085 1023], :cold 2550, :heap-all 464122968, :heap-stage 429568440}\n[\"darkstar\" \"pre7\" \"S\"] | [1090 648359 200858 502695504 3162104] | {:sizes [[4149 8328 425] [75037 200858 425] [6952 14011 425] [1118 2551 425] [4149 8328 425] [38242 96751 425 38242 118052 902] [11602 23911 425 11602 29547 896]], :heap-cold 360530344, :counts {:rows 939, :occurrences 1784, :applications 489, :path-bytes 12766, :depth 50}, :warm-stage-max 875, :cold-buckets {:compile-expand-publish 2228, :lower-persist-load-query 303}, :