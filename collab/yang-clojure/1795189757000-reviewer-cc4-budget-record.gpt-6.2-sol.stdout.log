{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/cc4_budget_runner.clj test/yang/cc4_corpus.clj'","aggregated_output":"(ns yang.cc4-budget-runner\n  \"cc4 budget closure runner (declaration v1: 1795016601236). Validated\n   descendant of the unexecuted r2 draft 1795017203479; that draft stays\n   untouched. Differences from the draft, each required for a valid run:\n   - ONE configuration per process (CLI arg B or S): the draft ran both\n     in one process, contaminating the second config cold sample;\n   - the retained holder is pinned in a volatile read AFTER the\n     after-GC sample, making reachability independent of locals\n     clearing;\n   - per-sample records and max-based verdicts print as one EDN map;\n   - stage timing stays in two buckets (compile-expand-publish,\n     lower-persist-load-query); a bucket bound bounds every stage\n     inside it, so bucket verdicts are conservative per-stage verdicts.\n   Trace stays disabled throughout; no runtime tracing is constructed.\"\n  (:require [clojure.string :as str]\n            [yang.cc4-corpus :as corpus]\n            [dao.host.bytes :as bytes]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yin.vm :as vm]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.semantic.derive :as derive]))\n\n\n(def ceilings\n  {:per-artifact 2000000 :storage 32000000 :retained 96000000\n   :heap 2147483648 :pipeline 80000 :cold 160000\n   :rows 50000 :occurrences 100000 :applications 10000\n   :depth 256 :path-bytes 8000000})\n\n\n(defn now\n  []\n  (System/currentTimeMillis))\n\n\n(defn heap\n  []\n  (let [r (Runtime/getRuntime)] (- (.totalMemory r) (.freeMemory r))))\n\n\n(defn gc-heap\n  []\n  (System/gc) (Thread/sleep 50) (System/gc) (heap))\n\n\n(defn- check-input-bounds!\n  [counts scope]\n  (doseq [k (keys counts)]\n    (when (> (get counts k) (get ceilings k))\n      (throw (ex-info \"cc4 input bound exceeded\"\n                      (assoc counts :scope scope))))))\n\n\n(def ^:private excluded\n  (atom #{}))\n\n\n(defn pipeline\n  [annotated?]\n  (let [start (now)\n        artifacts (corpus/replay-corpus annotated? @excluded)\n        built (now)\n        store (mem/create-content-mem)\n        entries\n        (mapv\n          (fn [{:keys [tree rows] :as artifact}]\n            (let [occ (vec (vm/occurrences tree))\n                  apps (filterv (fn [[_ _ id]]\n                                  (= :application (nth (get (:rows tree) id) 1)))\n                                occ)\n                  paths (mapv second apps)\n                  counts {:rows (count (:rows tree))\n                          :occurrences (count occ)\n                          :applications (count apps)\n                          :depth (apply max 0 (map count paths))\n                          :path-bytes (bytes/length\n                                        (jing/canonical-bytes paths))}\n                  _ (check-input-bounds! counts (:id artifact))\n                  sem (linearize/project-rows tree nil (if annotated? rows []))\n                  stack (derive/stack-image\n                          (:vector sem)\n                          {:segment-address :cc4/stack\n                           :call-provenance (:call-provenance sem)})\n                  reg (derive/register-image\n                        (:vector sem)\n                        {:segment-address :cc4/register\n                         :call-provenance (:call-provenance sem)})\n                  relation [(:call-provenance sem)\n                            (:call-provenance stack)\n                            (:call-provenance reg)]\n                  record (when annotated?\n                           {:cc4/schema 1\n                            :root (:root tree)\n                            :rows (jing/materialize! store rows)\n                            :relation (jing/materialize! store relation)})\n                  address (when record (jing/materialize! store record))\n                  payloads (if annotated?\n                             (into [rows relation record]\n                                   (:published-payloads artifact))\n                             [])\n                  sizes (if annotated?\n                          (mapv #(bytes/length (jing/canonical-bytes %))\n                                payloads)\n                          [0])\n                  loaded (when address (jing/get store address nil))\n                  loaded-rows (if loaded (jing/get store (:rows loaded) nil) [])\n                  query (into #{} (map #(vec (take 3 %))) loaded-rows)]\n              (when (and annotated?\n                         (not= (set (map #(vec (take 3 %)) rows)) query))\n                (throw (ex-info \"cc4 persisted query mismatch\"\n                                {:id (:id artifact)})))\n              {:input artifact\n               :images [(:vector sem) (:image stack) (:image reg)]\n               :relation (when annotated? relation)\n               :record loaded\n               :counts counts :sizes sizes :side-payloads payloads\n               :stage-heap (heap)}))\n          artifacts)\n        done (now)\n        totals (reduce (fn [a e] (merge-with + a (dissoc (:counts e) :depth)))\n                       {} entries)\n        totals (assoc totals\n                      :depth (apply max (map #(get-in % [:counts :depth])\n                                             entries)))\n        _ (check-input-bounds! totals :aggregate)]\n    {:holder [artifacts entries store]\n     :roots (mapv #(get-in % [:input :tree :root]) entries)\n     :image-digest (jing/content-hash (mapv :images entries))\n     :counts totals\n     :per-member (mapv #(select-keys % [:counts :sizes]) entries)\n     :storage (reduce +\n                      (map #(bytes/length (jing/canonical-bytes %))\n                           (vals (into {}\n                                       (map (juxt jing/segment-key identity))\n                                       (mapcat :side-payloads entries)))))\n     :largest-artifact (apply max (mapcat :sizes entries))\n     :stage-heap-max (apply max (heap) (keep :stage-heap entries))\n     :stages-ms {:compile-expand-publish (- built start)\n                 :lower-persist-load-query (- done built)}\n     :elapsed-ms (- done start)}))\n\n\n(defn sample\n  [annotated?]\n  (let [stop (atom false)\n        peak (atom (heap))\n        sampler (Thread. (fn []\n                           (while (not @stop)\n                             (swap! peak max (heap))\n                             (Thread/sleep 2))))]\n    (.start sampler)\n    (try\n      (let [result (pipeline annotated?)]\n        (assoc (dissoc result :holder) :peak-used-heap @peak))\n      (finally\n        (reset! stop true)\n        (.join sampler)))))\n\n\n(defn retained\n  [annotated?]\n  (let [before (gc-heap)\n        result (pipeline annotated?)\n        pin (volatile! (:holder result))\n        after (gc-heap)\n        alive (count (first @pin))]\n    {:before before :after after :delta (- after before)\n     :retained-members alive}))\n\n\n(defn measure\n  [annotated?]\n  (let [cold (sample annotated?)\n        _ (sample annotated?)\n        pipes (mapv (fn [_] (sample annotated?)) (range 3))\n        holds (vec (map (fn [_] (retained annotated?)) (range 5)))\n        max-of (fn [k] (apply max (map k pipes)))\n        peak (max-of :peak-used-heap)\n        retained-max (apply max (map :delta holds))]\n    {:configuration (if annotated? :S :B)\n     :memory-method :jvm-gc-used-heap-2ms-sampled-peak\n     :cold cold :pipeline-samples pipes :retained-samples holds\n     :maxima {:time (max-of :elapsed-ms)\n              :storage (max-of :storage)\n              :per-artifact (max-of :largest-artifact)\n              :heap peak\n              :retained retained-max}\n     :verdicts {:cold (<= (:elapsed-ms cold) (:cold ceilings))\n                :pipeline (<= (max-of :elapsed-ms) (:pipeline ceilings))\n                :storage (<= (max-of :storage) (:storage ceilings))\n                :per-artifact (<= (max-of :largest-artifact)\n                                  (:per-artifact ceilings))\n                :heap (<= peak (:heap ceilings))\n                :retained (<= retained-max (:retained ceilings))\n                :stage-buckets (<= (apply max\n                                          (mapcat #(vals (:stages-ms %))\n                                                  (cons cold pipes)))\n                                   (:pipeline ceilings))}}))\n\n\n(defn -main\n  [& args]\n  (let [cfg (case (first args)\n              \"B\" :B \"S\" :S\n              (throw (ex-info \"usage: -m yang.cc4-budget-runner <B|S> [EX=ids]\"\n                              {:got args})))\n        _ (when-let [ex (second args)]\n            (when-not (re-find #\"^EX=\" ex)\n              (throw (ex-info \"second arg must be EX=<comma ids>\" {:got ex})))\n            (reset! excluded\n                    (into #{} (map keyword)\n                          (str/split (subs ex 3) #\",\"))))\n        result (measure (= cfg :S))]\n    (prn (assoc result :cc4/budget 2 :ceilings ceilings))\n    (flush)))\n(ns yang.cc4-corpus\n  \"The cc4 budget common corpus: a faithful copy of the pinned cohort\n   builder test/yang/clojure_callsite_test.cljc/replay-artifacts at\n   origin/master 2175252d (sha256 of that file at that pin is recorded in\n   the budget findings), factored with one knob: an EXCLUDED id set, so\n   members the PRE-port pin refuses (the lower-unit member: pre-port\n   check-top-level-discard! rejects a may-fail non-final form, which the\n   port-era corpus relies on) can be omitted from BOTH revisions of the\n   measurement, keeping the pre/post corpus identical. Nothing else\n   differs from the cohort definition; the equality gate itself continues\n   to use the cohort in the test namespace.\"\n  (:require [clojure.walk :as walk]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yang.clojure :as yang]\n            [yang.clojure.prelude :as clj-prelude]\n            [yang.core.call :as call]\n            [yin.vm :as vm]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.macro :as macro]\n            [yin.vm.module :as module]\n            [yin.vm.data :as data]\n            [yin.vm.linker.publish :as publish]))\n\n\n(def ^:private publish-registry\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module {::data/max-items 1048576})))\n\n\n(defn- expand-like-the-repl\n  [ast]\n  (let [store (macro/seed-store\n                (macro/make-ctx {:token :callsite-test/standard-forms\n                                 :source-medium :callsite-test/standard-forms})\n                [macro/stdlib-forms])\n        ctx (macro/make-ctx {:token \"callsite-test\"\n                             :source-medium :program-in\n                             :store store})]\n    {:ctx ctx\n     :result (macro/expand-batch (encoder/program-batch ast) ctx)}))\n\n\n(defn replay-corpus\n  \"The pinned eight-member corpus. `annotated?` selects the S shape\n   (annotations retained, prepare = identity) or the B shape (C1 markers\n   stripped before projection, exactly the cohort's knob); `excluded` is\n   a set of member ids to omit (recorded in the findings with the exact\n   reason).\"\n  ([] (replay-corpus true #{}))\n  ([annotated? excluded]\n   (let [prepare (if annotated? identity\n                     (fn [ast]\n                       (walk/postwalk (fn [n]\n                                        (if (map? n)\n                                          (dissoc n :yang/call-site) n))\n                                      ast)))\n         forms (quote [(defn replay\n                         [x]\n                         (let [[a b] [x 1.5]]\n                           (+ (identity ^:replay a)\n                              (identity ^:replay a) b)))\n                       (replay 2)])\n         projected (fn [id ast token]\n                     (let [ast (prepare ast)\n                           p (encoder/project\n                               (encoder/source-envelope :cc4/replay token [ast]))]\n                       {:id id :compiled ast\n                        :tree (first (:yin/batch p))\n                        :rows (:yin/frontend-metadata p)}))\n         ast (yang/compile-program forms)\n         macro-ast (yang/compile-program\n                     (quote [(defmacro twin\n                               [x]\n                               (yin/if (yin/literal true) x\n                                       (yin/application\n                                         (yin/variable (quote f))\n                                         [(yin/literal 1)])))\n                             (defn f\n                               [x]\n                               x)\n                             (twin (f 1))]))\n         expansion (:result (expand-like-the-repl (prepare macro-ast)))\n         store (mem/create-content-mem)\n         call-spec (update (call/module-spec publish-registry) :ast prepare)\n         call-result (publish/publish-module! store call-spec)\n         clj-spec (update (clj-prelude/module-spec\n                            publish-registry (:address call-result))\n                          :ast prepare)\n         clj-result (publish/publish-module! store clj-spec)\n         published (fn [id result spec]\n                     (let [table (publish/published-call-site-table store result)]\n                       {:id id :compiled (:ast spec)\n                        :tree (or (:tree table)\n                                  (vm/ast->semantic-bytecode (:ast spec)))\n                        :rows (or (:rows table) [])\n                        :addresses (assoc (dissoc (:call-sites result) :origin)\n                                          :manifest (:address result))\n                        :published-payloads\n                        (when (:call-sites result)\n                          (mapv #(jing/get store % nil)\n                                (map (:call-sites result)\n                                     [:table :provenance :record])))\n                        :provenance (publish/published-instruction-provenance\n                                      store result)}))\n         members (cond-> []\n                   (not (contains? excluded :native))\n                   (conj (projected :native ast \"admission-a\"))\n                   (not (contains? excluded :argument-vector))\n                   (conj (projected :argument-vector\n                                    (yang/compile-program forms true yang/unit-opts)\n                                    \"admission-a\"))\n                   (not (contains? excluded :lower-unit))\n                   (conj (projected :lower-unit (yang/lower-unit forms)\n                                    \"admission-a\"))\n                   (not (contains? excluded :prelude))\n                   (conj (projected :prelude clj-prelude/module-uast\n                                    \"admission-a\"))\n                   (not (contains? excluded :macro))\n                   (conj {:id :macro :compiled (prepare macro-ast)\n                          :status (:status expansion)\n                          :tree (macro/packet->row-set (:tree expansion))\n                          :rows (:frontend-metadata expansion)\n                          :expansion-log (:log expansion)})\n                   (not (contains? excluded :negative))\n                   (conj (projected :negative ast \"admission-b\"))\n                   (not (contains? excluded :yang.call))\n                   (conj (published :yang.call call-result call-spec))\n                   (not (contains? excluded :clj))\n                   (conj (published :clj clj-result clj-spec)))]\n     members)))\n","exit_code":0,"status":"completed"}}
