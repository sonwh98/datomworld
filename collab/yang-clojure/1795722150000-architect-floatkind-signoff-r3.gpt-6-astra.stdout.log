\\t      ;; Quote '\\n866\\t      (= c 39)\\n867\\t      (let [[form end-i] (read-next-required s n (inc i) ctx \\\"quote\\\")]\\n868\\t        [:value (list 'quote form) end-i])\\n869\\t\\n870\\t      ;; Deref @\\n871\\t      (= c 64)\\n872\\t      (let [[form end-i] (read-next-required s n (inc i) ctx \\\"deref\\\")]\\n873\\t        [:value (list 'clojure.core/deref form) end-i])\\n874\\t\\n875\\t      ;; Metadata ^\\n876\\t      (= c 94)\\n877\\t      (let [[val end-i] (read-meta s n i ctx)]\\n878\\t        [:value val end-i])\\n879\\t\\n880\\t      ;; Unquote ~ / unquote-splicing ~@\\n881\\t      (= c 126)\\n882\\t      (if (and (< (inc i) n) (= 64 (char-code (char-at s (inc i)))))\\n883\\t        (let [[form end-i] (read-next-required s n (+ i 2) ctx \\\"unquote-splicing\\\")]\\n884\\t          [:value (list 'clojure.core/unquote-splicing form) end-i])\\n885\\t        (let [[form end-i] (read-next-required s n (inc i) ctx \\\"unquote\\\")]\\n886\\t          [:value (list 'clojure.core/unquote form) end-i]))\\n887\\t\\n888\\t      ;; Syntax-quote `\\n889\\t      (= c 96)\\n890\\t      (let [[val end-i] (read-syntax-quote s n i ctx)]\\n891\\t        [:value val end-i])\\n892\\t\\n893\\t      ;; Dispatch #...\\n894\\t      (= c 35)\\n895\\t      (read-dispatch s n i ctx)\\n896\\t\\n897\\t      ;; Number: digit, or +/- followed immediately by digit\\n898\\t      (or (digit? ch)\\n899\\t          (and (or (= c 43) (= c 45))\\n900\\t               (< (inc i) n)\\n901\\t               (digit? (char-at s (inc i)))))\\n902\\t      (let [[tok end-i] (read-token s n i)]\\n903\\t        [:value (numeric-token/materialize :clojure tok) end-i])\\n904\\t\\n905\\t      ;; Keyword :...\\n906\\t      (= c 58)\\n907\\t      (let [[tok end-i] (read-token s n i)]\\n908\\t        [:value (parse-keyword-token tok i) end-i])\\n909\\t\\n910\\t      ;; Symbol / boolean / nil\\n911\\t      :else\\n912\\t      (let [[tok end-i] (read-token s n i)]\\n913\\t        (if-let [fn-arg (when (:i