ad [:root :rows]))\\\\n          node-val (run-rows (select-keys node-payload [:root :rows]))]\\\\n      (is (= \\\\\\\"c1-2\\\\\\\" (:manifest-revision jvm-payload)))\\\\n      (is (= \\\\\\\"c1-2\\\\\\\" (:manifest-revision node-payload)))\\\\n      (is (= :segment/blake3-7cdae9dfee7f1980ccdd9543f279d0d7d20e4a4a4a44dda14f88f54ba9002049\\\\n             (:root jvm-payload)))\\\\n      (is (= :segment/blake3-541ba2ffc6b74327f70008d2069a35279612c2e96c82cc198d7b0b6782501e4c\\\\n             (:root node-payload)))\\\\n      (is (cbor/float64? jvm-val) \\\\\\\"pre-fix JVM artifact keeps float64 meaning\\\\\\\")\\\\n      (is (= 1.0 (data/float-value jvm-val)))\\\\n      (is (integer-host/exact-integer? node-val) \\\\\\\"pre-fix Node artifact keeps integer meaning\\\\\\\")\\\\n      (is (not (cbor/float64? node-val)))\\\\n      (is (data-equiv 1 node-val))\\\\n      (is (not (data-equiv jvm-val node-val)))\\\\n      (testing \\\\\\\"decode and re-encode preserve canonical identity on every host\\\\\\\"\\\\n        (is (cbor/bytes= (jing/canonical-bytes (select-keys jvm-payload [:root :rows]))\\\\n                         (jing/canonical-bytes (cbor/decode (jing/canonical-bytes (select-keys jvm-payload [:root :rows]))))))\\\\n        (is (cbor/bytes= (jing/canonical-bytes (select-keys node-payload [:root :rows]))\\\\n                         (jing/canonical-bytes (cbor/decode (jing/canonical-bytes (select-keys node-payload [:root :rows])))))))\\\\n      (when repl-route?\\\\n        (testing \\\\\\\"recompiling from authoritative source under the repaired frontend yields the float64 root on both JVM and Node\\\\\\\"\\\\n          (let [recompiled (vm/ast->semantic-bytecode\\\\n                             (yang/compile-program (yang/read-forms \\\\\\\"((fn [] 1.0))\\\\\\\")))]\\\\n            (is (= (:root jvm-payload) (:root recompiled))\\\\n                \\\\\\\"repaired compilation matches the float64 root\\\\\\\")\\\\n            (is (not= (:root node-payload) (:root recompiled))\\\\n                \\\\\\\"repaired compilation is distinct from the pre-fix Node integer artifact\\\\\\\")\\\\n            (let [v (run-rows recompiled)]\\\\n              (is (cbor/float64? v))\\\\n              (is (= 1.0 (data/float-value v))))))))))\\\\n\\\\n\\\\n;; =============================================================================\\\\n;; GATE 7 - profiles, revisions, capabilities, and unchanged contracts\\\\n;; =============================================================================\\\\n\\\\n(deftest gate7-repaired-manifest-revisions-and-capabilities\\\\n  (testing \\\\\\\"repaired Clojure manifest declares the new revision, profiles, and accurate host capability\\\\\\\"\\\\n    (let [m (frontends/clojure-manifest)]\\\\n      (is (= :yang/clojure (:yang.frontend/id m)))\\\\n      (is (= \\\\\\\"c1-3\\\\\\\" (:yang.frontend/revision m)))\\\\n      (is (= :yang.clojure/constructed-collections-float-kind-v1\\\\n             (:yang.frontend/lowering-profile m)))\\\\n      (is (= :yang.clojure/c1-float-kind (:yang.frontend/support-profile m)))\\\\n      (is (= #?(:jolt :forms-only\\\\n                :cljd :forms-only\\\\n                :clj :source-text\\\\n                :cljs :source-text\\\\n                :default :forms-only)\\\\n             (get-in m [:yang.frontend/grammar :yang.grammar/capability]))))\\\\n    (when-not repl-route?\\\\n      (testing \\\\\\\"forms-only hosts refuse direct source-string reading honestly\\\\\\\"\\\\n        (is (= #?(:jolt :unavailable-on-jolt :cljd :unavailable-on-cljd :default nil)\\\\n               (try\\\\n                 (yang/read-forms \\\\\\\"1.0\\\\\\\")\\\\n                 nil\\\\n                 (catch #?(:cljd Object :cljs :default :default Exception) e\\\\n                   (:yang.clojure/reader (ex-data e)))))))))\\\\n  (testing \\\\\\\"C1 marker version and Jing/UAST contracts are unchanged\\\\\\\"\\\\n    (is (= 1 yang/call-site-version))\\\\n    (is (= :yang/call-site yang/call-site-key))\\\\n    (is (= 1 (:yang.frontend/spi (frontends/clojure-manifest)))))\\\\n  (testing \\\\\\\"other frontends' revisions in the standard catalog are untouched\\\\\\\"\\\\n    (let [catalog (frontends/standard)]\\\\n      (is (frontend/ok? (frontend/select catalog {:yang.frontend/id :yang/clojure\\\\n                                                  :yang.frontend/revision \\\\\\\"c1-3\\\\\\\"})))\\\\n      (when (seq (frontend/revisions catalog :yang/python))\\\\n        (is (= [\\\\\\\"clojure-core-v1\\\\\\\" \\\\\\\"py-v1\\\\\\\"] (frontend/revisions catalog :yang/python))))\\\\n      (when (seq (frontend/revisions catalog :yang/php))\\\\n        (is (= [\\\\\\\"antlr-p8\\\\\\\"] (frontend/revisions catalog :yang/php)))))))\\\\ndiff --git a/docs/design/dao.jing.cbor.md b/docs/design/dao.jing.cbor.md\\\\nindex d9575be7..5a14c291 100644\\\\n--- a/docs/design/dao.jing.cbor.md\\\\n+++ b/docs/design/dao.jing.cbor.md\\\\n@@ -391,7 +391,9 @@ three cases are independent of argument order and of which host runs them:\\\\n   JavaScript returns the carrier so re-encoding cannot lose its kind.\\\\n   Carrying float kind is the producer's obligation; the codec never infers\\\\n   it. The Python frontend's ruling on meeting it is `yang.antlr.md`\\\\n-  section 8.5.5.\\\\n+  section 8.5.5, and the Clojure source/forms producer contract and\\\\n+  shared numeric-token factory (`yang.core.numeric-token`) are specified\\\\n+  in `yang.antlr.md` section 8.8.\\\\n - The JavaScript float64 carrier refuses numeric and default coercion: its\\\\n   `valueOf` throws the refusal `:carrier-coercion` (raised through the\\\\n   codec's refusal helper, so `refusal` reads it; it is not a corpus\\\\ndiff --git a/docs/design/yang.antlr.md b/docs/design/yang.antlr.md\\\\nindex 324bc909..898b9eb9 100644\\\\n--- a/docs/design/yang.antlr.md\\\\n+++ b/docs/design/yang.antlr.md\\\\n@@ -3481,10 +3481,87 @@ Node APIs are effect packages, not properties of the JavaScript grammar.\\\\n The Clojure frontend already exists (`yang.clojure`) and lowers directly:\\\\n forms become `:lambda`, `:application`, `:if`, `:literal`, and\\\\n `:variable` nodes, and definitions become explicit `yin/def`\\\\n-applications. It implements the section 3 contract through its existing\\\\n-reader rather than through ANTLR. ClojureScript and ClojureDart are\\\\n-dialects of the same frontend distinguished by dialect options and\\\\n-runtime profile, not by separate core branches.\\\\n+applications. It implements the section 3 contract through its own\\\\n+frontend-owned source reader rather than through ANTLR. ClojureScript\\\\n+and ClojureDart are dialects of the same frontend distinguished by\\\\n+dialect options and runtime profile, not by separate core branches.\\\\n+\\\\n+#### 8.8.1 Numeric-kind preservation, revision `c1-3`, and capability matrix\\\\n+\\\\n+Per the integral-float portability ruling (2026-11-26, architect ruling\\\\n+`1795693415000`), loss of intended numeric kind between supported compiling\\\\n+hosts is a runtime correctness defect, not merely a digest or traceability\\\\n+difference: `data/equiv`, `content=`, `admit-key?`, and `clojure.core`\\\\n+dispatch (`inc`/`dec`) all observe the distinction between binary64 float\\\\n+content and exact-integer content.\\\\n+\\\\n+**Producer boundary and shared factory.** All four frontends (Clojure,\\\\n+Python, PHP, TypeScript) materialize numeric tokens through one shared\\\\n+factory (`yang.core.numeric-token`) parameterized by per-language lexeme\\\\n+dialect tables while preserving each language's numeric syntax and semantic\\\\n+profile. The Jing codec (`dao.jing.cbor.md`) and `Float64`'s\\\\n+`:carrier-coercion` refusal remain unchanged: carrying float kind is always\\\\n+the producer's obligation.\\\\n+\\\\n+**Frontend-owned token-aware reading (`yang.clojure.reader`).**\\\\n+`yang.clojure/read-forms` consumes original Clojure source text directly on\\\\n+JVM and Node and materializes numeric tokens through\\\\n+`yang.core.numeric-token/materialize :clojure` at token time, before any\\\\n+host map/set construction or downstream lowering can discard occurrences or\\\\n+coalesce distinct kinds (such as `1` vs `1.0`). Binary floating literals\\\\n+(`0.0`, `1.0`, `-1.0`, `1e0`, `1.5`, `-0.0`, `2.`, `+1.5`, `1E5`,\\\\n+integral floats at/beyond `2^53`, subnormals, and underflowing tokens) emit\\\\n+Jing `cbor/float64` content on every host (`Double` on JVM, `Float64`\\\\n+carrier on JS). Exact integers (decimal, hex, octal, `Nr...`, `N`-suffixed\\\\n+bigints), `M` decimals (`cbor/decimal`), and ratios (`cbor/ratio`, reduced\\\\n+to exact integer when denominator divides numerator) retain their categories\\\\n+without relabeling; reader conditionals (`#?`, `#?@`), eval (`#=`), unknown\\\\n+tags, and malformed tokens receive explicit refusals with no ambient\\\\n+mutable reader state.\\\\n+\\\\n+**Forms API and carrier admission.** `yang.clojure/literal?` and\\\\n+`constant-form?` admit Jing/host numeric carriers (`cbor/float64`,\\\\n+`cbor/decimal`, `cbor/ratio`, and exact big-integer carriers) directly, in\\\\n+nested collections, and in quoted positions. Through the forms API on\\\\n+JavaScript, a bare integral JS `Number` still denotes exact integer content;\\\\n+callers intending float64 content without source text must supply\\\\n+`dao.jing.cbor/float64` / `yin.vm.data/float64`. Host-quoted `.cljc`\\\\n+prelude tables must contain no bare integral `Double` constants (verified by\\\\n+the JVM-side producer audit).\\\\n+\\\\n+**Scoped carrier-aware execution (`yang.clojure.numeric`).** The repaired\\\\n+Clojure frontend profile binds scoped carrier-aware numeric primitives\\\\n+(`yang.clojure/primitives`, covering `+`, `-`, `*`, `/`, `<`, `<=`, `>`,\\\\n+`>=`, kind-strict `=`, cross-kind `==`, and `!=`) over the existing\\\\n+`yin.vm.float`, `yin.vm.integer`, and `yin.vm.data` kernels, reboxing every\\\\n+floating-point result (including non-integral-to-integral results such as\\\\n+`1.5 + 1.5 => 3.0`) before it becomes guest Data. Global `yin.vm/primitives`\\\\n+and `Float64`'s `:carrier-coercion` policy are left unchanged.\\\\n+\\\\n+**Revision, profiles, and migration.** The repaired `:yang/clojure`\\\\n+manifest publishes under:\\\\n+\\\\n+- `:yang.frontend/revision` `\\\\\\\"c1-3\\\\\\\"` (superseding `\\\\\\\"c1-2\\\\\\\"`)\\\\n+- `:yang.frontend/lowering-profile` `:yang.clojure/constructed-collections-float-kind-v1` (retaining the `constructed-collections-v1` canonical operand ordering contract alongside float-kind preservation)\\\\n+- `:yang.frontend/support-profile` `:yang.clojure/c1-float-kind`\\\\n+- Unchanged Jing encoding profile, UAST grammar, bytecode format, and C1 marker version (`:yang/call-site 1`).\\\\n+\\\\n+Pre-fix `c1-2` (and `c1-1`) artifacts retain their recorded bytes,\\\\n+addresses, and historical meanings when loaded and executed without\\\\n+recompilation. Recompilation from authoritative source under `c1-3`\\\\n+produces a corrected float64 artifact whose root differs from a pre-fix\\\\n+JS integer-collapsed artifact. Shared runtime modules (`clj`,\\\\n+`clojure.core.impl`, `clojure.core`) and Python's `py-v1` /\\\\n+`clojure-core-v1` pins are unchanged.\\\\n+\\\\n+**Four-host capability matrix:**\\\\n+\\\\n+| Host | `:yang.grammar/capability` | Source reading (`read-forms`) | Forms compilation (incl. carriers) | Artifact load & execute |\\\\n+| --- | --- | --- | --- | --- |\\\\n+| JVM | `:source-text` | Native (`yang.clojure.reader`) | Yes | Yes |\\\\n+| Node (JS) | `:source-text` | Native (`yang.clojure.reader`) | Yes | Yes |\\\\n+| Dart (CLJD) | `:forms-only` | Refused (`:unavailable-on-cljd`) | Yes (explicit carriers) | Yes |\\\\n+| Jolt | `:forms-only` | Refused (`:unavailable-on-jolt`) | Yes (explicit carriers) | Yes |\\\\n \\\\n ### 8.9 Systems: Go, Rust, C, and further extensions\\\\n \\\\ndiff --git a/docs/design/yang.preludes.md b/docs/design/yang.preludes.md\\\\nindex 268614ae..8fd346df 100644\\\\n--- a/docs/design/yang.preludes.md\\\\n+++ b/docs/design/yang.preludes.md\\\\n@@ -609,7 +609,7 @@ def sum_even_squares(xs):\\\\n ### 8.1 Multi-host portability (JVM, CLJS/Node, CLJD/Dart, Jolt/Scheme)\\\\n \\\\n - **ClojureDart AOT literal limits:** Consolidate `defquoted` into **`yang.core.defquoted`** (r8 M9 — the dedicated host macro namespace; NOT `yang.core.prelude`, keeping the emission namespace free of macro definitions).\\\\n-- **Zero bare integral float literals & zero raw host doubles in guest UAST:** All float operations pass boxed `data/float64` through `yin.vm.float`, avoiding raw host doubles across JVM, Node, Dart, and Jolt.\\\\n+- **Zero bare integral float literals & zero raw host doubles in guest UAST:** All float operations pass boxed `data/float64` through `yin.vm.float`, avoiding raw host doubles across JVM, Node, Dart, and Jolt. Shared prelude and runtime emitters (`yang.clojure.prelude`, `yang.clojure.core-impl`, `yang.python.antlr.clj-runtime`, and Track B language preludes) must never embed bare integral `Double` constants in host-quoted tables (audited on the JVM); every float literal is constructed explicitly as `dao.jing.cbor/float64` (via `yang.core.numeric-token` at frontend token time per [`docs/design/yang.antlr.md` §8.8](./yang.antlr.md#88-the-producer-owns-float-kind)) and float-returning primitives rebox their results via `yin.vm.float` before returning to VM execution or collection key positions.\\\\n - **Canonical ordering (`b86bc0e8` invariant):** Recipes, profiles, descriptor maps, and emitted UAST operand sequences sort keys deterministically, guaranteeing byte-identical `dao.jing.cbor` hashes across all 4 hosts.\\\\n - **No JVM-only reflection:** `yang.core.semantics` and `yang.core.prelude` use pure portable Clojure data transforms.\\\\n \\\\ndiff --git a/src/cljc/yang/docs/yang_implementation.md b/src/cljc/yang/docs/yang_implementation.md\\\\nindex d04f17e1..04c1f582 100644\\\\n--- a/src/cljc/yang/docs/yang_implementation.md\\\\n+++ b/src/cljc/yang/docs/yang_implementation.md\\\\n@@ -228,9 +228,16 @@ The Yang compiler is **fully functional** and **production-ready** for compiling\\\\n \\\\n The compiler demonstrates the power of the Yin/Yang dual system: **Yang generates continuations, Yin executes them**. Together they enable code to become data, data to become computation, and computation to migrate freely across platforms.\\\\n \\\\n+## Portability and Numeric-Kind Contract\\\\n+\\\\n+`yin.vm` on JVM, Node (JS), Dart, and Jolt preserves the numeric kind carried by portable Data and canonically encoded Jing artifacts (`dao.jing.cbor.md`), subject to the selected runtime/profile's supported operations:\\\\n+\\\\n+- **Source-text compilation (`:yang/clojure` revision `c1-3`, `:source-text` capability on JVM and Node):** `yang.clojure/read-forms` (via `yang.clojure.reader` and the shared `yang.core.numeric-token` factory) preserves binary64 floating-point kind (including integral-valued floats such as `0.0`, `1.0`, `1e0`, `-0.0`, and floats at/beyond `2^53`), exact integers/bigints, decimals (`M`), and ratios before collection construction or lowering. The standard REPL/catalog route (`yin.repl.frontends/standard`) routes source text directly through `yang.clojure/read-forms` and installs scoped carrier-aware numeric primitives (`yang.clojure/primitives`) that rebox floating results.\\\\n+- **Forms-only boundary (all hosts, and `:forms-only` capability on Dart and Jolt):** `yang.clojure/compile` and `compile-program` admit Jing numeric carriers (`dao.jing.cbor/float64`, `decimal`, `ratio`, and exact big-integer carriers) directly, nested, and quoted. On JavaScript, a bare integral JS `Number` denotes exact integer content; callers intending floating Data through the forms API must supply `dao.jing.cbor/float64` / `yin.vm.data/float64`. See `docs/design/yang.antlr.md` §8.8 for the full contract, revision `c1-3` profiles, legacy custody rules, and four-host capability matrix.\\\\n+\\\\n ---\\\\n \\\\n-**Implementation Date**: 2025-11-13\\\\n+**Implementation Date**: 2025-11-13 (numeric-kind portability revision `c1-3` documented 2026-11-26)\\\\n **Total Lines of Code**: ~600 (compiler + tests + docs)\\\\n **Test Coverage**: 100% of implemented features\\\\n **Platforms**: JVM, Node.js (browser-ready)\\\\ndiff --git a/test/yang/clojure_collection_order_test.cljc b/test/yang/clojure_collection_order_test.cljc\\\\nindex 673d7be1..748f1da6 100644\\\\n--- a/test/yang/clojure_collection_order_test.cljc\\\\n+++ b/test/yang/clojure_collection_order_test.cljc\\\\n@@ -426,17 +426,22 @@\\\\n      [:inner-set #{(list '+ 'n 2) 3}]\\\\n      [:inner-vec [(list '+ 'n 3)]]\\\\n      [:deep {:a #{[(list '+ 'n 4)]}}]]]\\\\n-   ;; non-integral floats only: a bare INTEGRAL-valued double (0.0) is a\\\\n-   ;; documented host numeric-identity boundary -- the JVM's codec wraps\\\\n-   ;; every double in the float64 carrier while the JS host encodes a bare\\\\n-   ;; integral Number as an integer, so such a literal mints different\\\\n-   ;; content per host (first caught by the cross-host reference on its\\\\n-   ;; first Node run; divergent digests recorded in the r3 findings). That\\\\n-   ;; boundary is encoder/float-carrier territory and stays outside this\\\\n-   ;; round's bounds; float coverage here uses non-integral doubles, which\\\\n-   ;; travel as float64 on every host.\\\\n+   ;; Non-integral floats control (retained from c1-2; historical r3 failed\\\\n+   ;; comparison for bare integral floats is archived at\\\\n+   ;; collab/yang-clojure/1795104744000-fixorder-r3-evidence/\\\\n+   ;; fixorder-r3-node-order-floats-divergence.log; architectural ruling:\\\\n+   ;; collab/yang-clojure/1795693415000-architect-float-kind-portability-ruling.gpt-6-astra.findings.md).\\\\n    [:floats\\\\n     [[1.5 (list '+ 'n 1.5)] [2.25 -0.5] [3.75 2.5]]]\\\\n+   ;; Restored integral-float coverage (ruling 1795693415000, RULING 5 Gate 3):\\\\n+   ;; explicit float64 carriers for programmatic Data fixtures across all four\\\\n+   ;; hosts, paired with `unmodified-source-integral-floats-test` below which\\\\n+   ;; compiles the identical unmodified source string through the repaired\\\\n+   ;; frontend and asserts equality against this same recorded reference.\\\\n+   [:integral-floats\\\\n+    [[(data/float64 0.0) (list '+ 'n (data/float64 1.0))]\\\\n+     [(data/float64 2.0) (data/float64 (* -1.0 0.0))]\\\\n+     [1 (data/float64 1.5)]]]\\\\n    [:duplicate-subtrees\\\\n     [[:a (list 'first 'xs)] [:b (list 'first 'xs)] [:c (list 'first 'xs)]]]])\\\\n \\\\n@@ -1479,6 +1484,12 @@\\\\n     :keys-digest \\\\\\\"9da765476fa04769e575b16bb500be27065e05e0f62ee9d072c80f92e5210123\\\\\\\",\\\\n     :c1-digest \\\\\\\"49d4bc2b9f421a1a5193c34448e693a13dc48de7bbcc5e35296083cb70959f79\\\\\\\",\\\\n     :instruction-provenance-digest \\\\\\\"ae37530caa047b3d3baa8f6d3cda9331b050cfac9271895de0712aa1313980ab\\\\\\\"}\\\\n+   {:case :integral-floats,\\\\n+    :root :segment/blake3-77ac71cec90eaba7887fabb9f28dabe94b52e80227709de3e83dc6f2309e0bd4,\\\\n+    :applications 2,\\\\n+    :keys-digest \\\\\\\"2622d67b40b9c98529b2f245a1f1c9650d896843833a594dd01f889456a0fda3\\\\\\\",\\\\n+    :c1-digest \\\\\\\"cd58c99c96985edcbafda1a12fb684970a4e69ad3d7d3e3b81182eba9f1d928a\\\\\\\",\\\\n+    :instruction-provenance-digest \\\\\\\"78a888061880da6171d94e347aa1868a0dcccb1f81f8fa31625432851d0a42c4\\\\\\\"}\\\\n    {:case :duplicate-subtrees,\\\\n     :root :segment/blake3-fcecdb781319f60805c548d7bac0c2932df58a73e914c4daae04e2c8d0e376c0,\\\\n     :applications 4,\\\\n@@ -1584,8 +1595,23 @@\\\\n                                    (compile-snapshot (build-set :vec-set\\\\n                                                                 (sized-set-elements n)))]])\\\\n                                map-corpus-sizes)))]\\\\n-    (is (= (count corpus-reference) (count actual) 18))\\\\n+    (is (= (count corpus-reference) (count actual) 19))\\\\n     (doseq [{:keys [case] :as expected} corpus-reference]\\\\n       (testing (str case)\\\\n         (is (= expected (assoc (get actual case) :case case))\\\\n             (str \\\\\\\"cross-host corpus divergence at \\\\\\\" case))))))\\\\n+\\\\n+\\\\n+(deftest unmodified-source-integral-floats-test\\\\n+  #?(:jolt nil\\\\n+     :cljd nil\\\\n+     :default\\\\n+     (let [expected (some #(when (= :integral-floats (:case %)) (dissoc % :case))\\\\n+                          corpus-reference)\\\\n+           form (first (yang/read-forms \\\\\\\"{0.0 (+ n 1.0) 2e0 -0.0 1 1.5}\\\\\\\"))\\\\n+           snap (compile-snapshot form)\\\\n+           int-control (compile-snapshot (first (yang/read-forms \\\\\\\"{0 (+ n 1) 2 0 1 1.5}\\\\\\\")))]\\\\n+       (is (= expected snap)\\\\n+           \\\\\\\"unmodified source string with integral floats matches the recorded common reference\\\\\\\")\\\\n+       (is (not= snap int-control)\\\\n+           \\\\\\\"integer control produces distinct root, keys, C1 and provenance\\\\\\\"))))\\\\n7f4898f474d02dc127e5e484254bc44ae7ff88f6\\\\nbab7640f docs(ledger): GREEN DECLARATION — master green at 9bd665fe; tri-leg confirmation matrix all rc=0 (jupiter JVM 7.9h, shiva node 12.1h, shiva dart 10.1h); every 20261123 red family closed with landed countersigned fixes\\\\nd49ff4b7 docs(agents): correct the dispatch recipe — zsh -ic (interactive subshell loads .zshrc: mise activate + nvm), replacing the hand-built PATH line (owner correction 2026-11-26: codex is already on the user's PATH)\\\\nbce01bad docs(agents): record the orchestrator dispatch PATH recipe — mise shims + nvm node + local bin, with the codex-shim version-fragility note (2026-11-26 floatkind-round provenance)\\\\ndocs/design/dao.jing.cbor.md\\\\ndocs/design/yang.antlr.md\\\\ndocs/design/yang.preludes.md\\\\nsrc/cljc/yang/clojure.cljc\\\\nsrc/cljc/yang/clojure/numeric.cljc\\\\nsrc/cljc/yang/clojure/reader.cljc\\\\nsrc/cljc/yang/core/numeric_token.cljc\\\\nsrc/cljc/yang/docs/yang_im