fn- semantic-root\\\\n  \\\\\\\"The canonical semantic-bytecode root of the compiled form of `source`.\\\\\\\"\\\\n  [source]\\\\n  (:root (vm/ast->semantic-bytecode (yang/compile (read-one source)))))\\\\n\\\\n\\\\n(defn- host-read-file\\\\n  [path]\\\\n  #?(:clj (java.nio.file.Files/readAllBytes (.toPath (io/file path)))\\\\n     :cljs (.readFileSync (js/require \\\\\\\"fs\\\\\\\") path)\\\\n     :default nil))\\\\n\\\\n\\\\n(def ^:private repl-route?\\\\n  \\\\\\\"The REPL/catalog route runs where the shell runs; the Dart and Jolt legs\\\\n  of this namespace exercise artifacts and capability claims only.\\\\\\\"\\\\n  #?(:clj true :cljs true :default false))\\\\n\\\\n\\\\n(defn- drain-result\\\\n  \\\\\\\"The :repl/result value of a shell's output medium, oldest first.\\\\\\\"\\\\n  [state]\\\\n  (let [output (:output-stream state)\\\\n        cursor (:dao.stream/cursor (stream/cursor output :dao.stream/oldest))]\\\\n    (loop [cursor cursor, value ::none]\\\\n      (let [step (stream/next output cursor)]\\\\n        (if (= :dao.stream/ok (:dao.stream/outcome step))\\\\n          (let [v (:dao.stream/value step)]\\\\n            (if (= :repl/result (:type v))\\\\n              (recur (:dao.stream/cursor step) (:value v))\\\\n              (recur (:dao.stream/cursor step) value)))\\\\n          value)))))\\\\n\\\\n\\\\n(defn- repl-session-result\\\\n  \\\\\\\"The result value of evaluating `line` through the standard REPL/catalog\\\\n  route (the frontends the shell installs), semantic VM.\\\\\\\"\\\\n  [line]\\\\n  #?(:clj (drain-result (first (repl/eval-input (frontends/create-state {:vm-type :semantic}) line)))\\\\n     :cljs (drain-result (first (repl/eval-input (frontends/create-state {:vm-type :semantic}) line)))\\\\n     :default nil))\\\\n\\\\n\\\\n(defn- repl-text\\\\n  \\\\\\\"The shell text of evaluating `line` through the standard route.\\\\\\\"\\\\n  [line]\\\\n  #?(:clj (second (repl/eval-input (frontends/create-state {:vm-type :semantic}) line))\\\\n     :cljs (second (repl/eval-input (frontends/create-state {:vm-type :semantic}) line))\\\\n     :default nil))\\\\n\\\\n\\\\n(defn- repl-error?\\\\n  [line]\\\\n  (str/starts-with? (str (repl-text line)) \\\\\\\"Error:\\\\\\\"))\\\\n\\\\n\\\\n;; =============================================================================\\\\n;; GATE 1 - real source strings, every supported numeric category\\\\n;; =============================================================================\\\\n\\\\n\\\\n(def ^:private float-tokens\\\\n  \\\\\\\"Every binary-floating token class the ruling names: integral floats at\\\\n   0, 1, -1, at and beyond 2^53, exponent spellings, negative zero, a\\\\n   small positive token that rounds to zero (underflow), and a value at\\\\n   the top of the range. [token expected-double-bits-hex].\\\\\\\"\\\\n  [[\\\\\\\"0.0\\\\\\\" \\\\\\\"0000000000000000\\\\\\\"]\\\\n   [\\\\\\\"1.0\\\\\\\" \\\\\\\"3ff0000000000000\\\\\\\"]\\\\n   [\\\\\\\"-1.0\\\\\\\" \\\\\\\"bff0000000000000\\\\\\\"]\\\\n   [\\\\\\\"1e0\\\\\\\" \\\\\\\"3ff0000000000000\\\\\\\"]\\\\n   [\\\\\\\"1.5\\\\\\\" \\\\\\\"3ff8000000000000\\\\\\\"]\\\\n   [\\\\\\\"-0.0\\\\\\\" \\\\\\\"8000000000000000\\\\\\\"]\\\\n   [\\\\\\\"9007199254740992.0\\\\\\\" \\\\\\\"4340000000000000\\\\\\\"]\\\\n   [\\\\\\\"9007199254740993.0\\\\\\\" \\\\\\\"4340000000000200\\\\\\\"]\\\\n   [\\\\\\\"1e19\\\\\\\" \\\\\\\"43e158e460913d000\\\\\\\"]\\\\n   [\\\\\\\"1.5e-5\\\\\\\" \\\\\\\"3eeb48116539a35a\\\\\\\"]\\\\n   [\\\\\\\"5e-324\\\\\\\" \\\\\\\"0000000000000001\\\\\\\"]\\\\n   [\\\\\\\"1e-400\\\\\\\" \\\\\\\"0000000000000000\\\\\\\"]\\\\n   [\\\\\\\"2.\\\\\\\" \\\\\\\"4000000000000000\\\\\\\"]\\\\n   [\\\\\\\"+1.5\\\\\\\" \\\\\\\"3ff8000000000000\\\\\\\"]\\\\n   [\\\\\\\"1E5\\\\\\\" \\\\\\\"412e848000000000\\\\\\\"]])\\\\n\\\\n\\\\n(def ^:private integer-tokens\\\\n  \\\\\\\"Integer controls: plain, signed, radix, octal, and the N-suffixed big\\\\n   integer (the exact carrier). [token expected-value].\\\\\\\"\\\\n  [[\\\\\\\"0\\\\\\\" 0] [\\\\\\\"1\\\\\\\" 1] [\\\\\\\"-1\\\\\\\" -1] [\\\\\\\"+7\\\\\\\" 7] [\\\\\\\"42\\\\\\\" 42]\\\\n   [\\\\\\\"0x10\\\\\\\" 16] [\\\\\\\"017\\\\\\\" 15] [\\\\\\\"2r101\\\\\\\" 5] [\\\\\\\"36rZZ\\\\\\\" 1295]\\\\n   [\\\\\\\"9007199254740991\\\\\\\" 9007199254740991]])\\\\n\\\\n\\\\n(defn- host-bits-of\\\\n  \\\\\\\"The IEEE-754 bits of float64 content `x`, 16 lowercase hex digits.\\\\\\\"\\\\n  [x]\\\\n  #?(:clj (String/format \\\\\\\"%016x\\\\\\\" (into-array Object [(Double/doubleToLongBits (double (data/float-value x)))]))\\\\n     :cljs (let [v (data/float-value x)\\\\n                 buf (js/ArrayBuffer. 8)\\\\n                 view (js/DataView. buf)]\\\\n             (.setFloat64 view 0 v false)\\\\n             (let [out (atom \\\\\\\"\\\\\\\")]\\\\n               (dotimes [i 8]\\\\n                 (let [b (.getUint8 view i)]\\\\n                   (reset! out (str @out (when (< b 16) \\\\\\\"0\\\\\\\") (.toString b 16)))))\\\\n               @out))\\\\n     :default nil))\\\\n\\\\n\\\\n(deftest gate1-float-tokens-are-float64-content\\\\n  (testing \\\\\\\"every binary-floating token reads and compiles as float64 content\\\\\\\"\\\\n    (doseq [[token bits] float-tokens]\\\\n      (testing token\\\\n        (let [value (compiled-value token)]\\\\n          (is (cbor/float64? value)\\\\n              (str token \\\\\\\" must be float64 content, read \\\\\\\" (pr-str value)))\\\\n          (is (= bits (host-bits-of value))\\\\n              (str token \\\\\\\" must carry exactly these IEEE bits\\\\\\\")))))))\\\\n\\\\n\\\\n(deftest gate1-integer-tokens-stay-exact-integers\\\\n  (testing \\\\\\\"integer controls keep integer kind and value\\\\\\\"\\\\n    (doseq [[token expected] integer-tokens]\\\\n      (testing token\\\\n        (let [value (compiled-value token)]\\\\n          (is (integer-host/exact-integer? value)\\\\n              (str token \\\\\\\" must be exact-integer content, read \\\\\\\" (pr-str value)))\\\\n          (is (data/equiv expected value)\\\\n              (str token \\\\\\\" must read as \\\\\\\" expected))))))\\\\n  (testing \\\\\\\"big integers keep the exact big carrier\\\\\\\"\\\\n    (let [value (compiled-value \\\\\\\"9223372036854775808000N\\\\\\\")]\\\\n      (is (integer-host/big-carrier? value)\\\\n          \\\\\\\"an N-suffixed token is exact big-integer content, never a rounded number\\\\\\\")\\\\n      (is (data/equiv 9223372036854775808000 value))\\\\n      (is (not (cbor/float64? value))))))\\\\n\\\\n\\\\n(deftest gate1-unsupported-categories-not-relabeled\\\\n  (testing \\\\\\\"ratio tokens stay ratio content\\\\\\\"\\\\n    (let [value (compiled-value \\\\\\\"1/2\\\\\\\")]\\\\n      (is (cbor/ratio? value)\\\\n          (str \\\\\\\"1/2 must stay ratio content, read \\\\\\\" (pr-str value)))\\\\n      (is (not (cbor/float64? value)))))\\\\n  (testing \\\\\\\"decimal M tokens stay decimal content\\\\\\\"\\\\n    (doseq [token [\\\\\\\"1M\\\\\\\" \\\\\\\"10.03M\\\\\\\" \\\\\\\"-2.5M\\\\\\\"]]\\\\n      (let [value (compiled-value token)]\\\\n        (is (cbor/decimal? value)\\\\n            (str token \\\\\\\" must stay decimal content, read \\\\\\\" (pr-str value)))\\\\n        (is (not (cbor/float64? value))))))\\\\n  (testing \\\\\\\"invalid numeric tokens are refused, not guessed\\\\\\\"\\\\n    (doseq [token [\\\\\\\"1.2.3\\\\\\\" \\\\\\\"08\\\\\\\" \\\\\\\"0x\\\\\\\" \\\\\\\"1e\\\\\\\" \\\\\\\"2r\\\\\\\"]]\\\\n      (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\\\n                   (yang/read-forms token))\\\\n          (str token \\\\\\\" must be a reader refusal\\\\\\\")))))\\\\n\\\\n\\\\n(def ^:private token-digest-reference\\\\n  \\\\\\\"The recorded cross-host reference: the content hash of the canonical\\\\n   bytes of each token's read form, JVM-recorded under the repaired reader\\\\n   during the green round; every host must reproduce it exactly.\\\\\\\"\\\\n  {\\\\\\\"0.0\\\\\\\" \\\\\\\"unrecorded\\\\\\\"\\\\n   \\\\\\\"1.0\\\\\\\" \\\\\\\"unrecorded\\\\\\\"\\\\n   \\\\\\\"1\\\\\\\" \\\\\\\"unrecorded\\\\\\\"\\\\n   \\\\\\\"1/2\\\\\\\" \\\\\\\"unrecorded\\\\\\\"\\\\n   \\\\\\\"1M\\\\\\\" \\\\\\\"unrecorded\\\\\\\"})\\\\n\\\\n\\\\n(deftest gate1-cross-host-canonical-identity\\\\n  (testing \\\\\\\"identical source mints identical canonical bytes on every host\\\\\\\"\\\\n    (doseq [[token expected] token-digest-reference]\\\\n      (testing token\\\\n        (is (not= \\\\\\\"unrecorded\\\\\\\" expected) \\\\\\\"reference recorded during the green round\\\\\\\")\\\\n        (is (= expected (jing/content-hash (read-one token)))))))\\\\n  (testing \\\\\\\"the float64 and integer tokens of one value mint distinct bytes\\\\\\\"\\\\n    (is (not= (semantic-root \\\\\\\"1\\\\\\\") (semantic-root \\\\\\\"1.0\\\\\\\")))\\\\n    (is (not= (semantic-root \\\\\\\"0\\\\\\\") (semantic-root \\\\\\\"-0.0\\\\\\\")))))\\\\n''')\\\\nprint(\\\\\\\"file rewritten: ns+helpers+gate1\\\\\\\")\\\\nPYEOF\\\",\\\"description\\\":\\\"Rewrite test file cleanly with gate 1\\\"}}}\\ncollab/yang-clojure/1795695531000-engineer-float-kind-portability-r1.glm-5.3.stdout.log:61134:{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"id\\\":\\\"msg_20261126205431425918d632ae49f9\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"model\\\":\\\"glm-5.3\\\",\\\"content\\\":[{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"Now gates 5, 6, 7. Note: `(nth (vals (read-one \\\\\\\"{:a 1.0}\\\\\\\")) 0)` — nth on a LazySeq vals — works in Clojure (sequential). On cljs too. OK.\\\\n\\\\nGate 5:\\\\n- explicit Float64 forms compiled directly, nested + quoted, executed, serialized; integer controls.\\\\n- prelude emission pinned across hosts — assert python profile pins verify (that's more gate 7; here \\\\\\\"Exercise actual prelude emission and pin its contents across hosts\\\\\\\" — assert the clj module spec's pinned address still matches? That's the python profiles lock — reuse yang.python.antlr.profiles/verify-builtin! clojure-id → validates the whole closure incl. clojure.core.impl. On JVM that's a heavy delay (validates, builds in mem). It's the gate-7 check as well — put in gate 7.\\\\n- JVM-side audit for integral Double constants in host-quoted prelude producers: walk yang.clojure.core-impl/operations + yang.clojure.prelude/definitions-ish + yang.python.antlr.clj-runtime/numeric — collect Double leaves that are integral → assert none (control). JVM-only (Doubles exist only there meaningfully — on JS there are no Doubles).\\\\n- float-producing op result crossing snapshot/continuation: pick the lightest continuation crossing: eval two lines in one REPL session where the second uses *1? — \\\\\\\"a float-producing operation whose result is integral crossing a snapshot/continuation boundary\\\\\\\". The REPL session itself keeps state between lines (the VM/round boundary IS a continuation-ish boundary?) — hmm, real continuation: yin.vm continuation capture. Look at stream_eval_test for a compact continuation pattern... Actually a simpler true crossing: `dao.stream` continuation in the REPL \\\\\\\"pending-run\\\\\\\"? Heavy. Alternative: use the vm/continuation API directly: run a program that captures a continuation computing (+ 1.5 1.5) then resumes. Is there an easy API? yin.vm has %capture in uast notation: '(f (%capture))... Let me check how tests use %capture — grep.\\\\n\\\\nGate 6:\\\\n- repaired-artifact fixture: I'll produce post-fix on JVM and embed base64 — during green. For RED, placeholder \\\\\\\"unrecorded\\\\\\\" → failing.\\\\n- legacy custody fixtures (EXISTS): load both, decode, assert old meaning (JVM float / Node integer), execute without recompilation (vm-load-rows run → value 1.0 float on JVM decode; on any host decoding node fixture → integer 1), assert new JS compile differs from old JS artifact.\\\\n- carrier-form compilation on forms-capable hosts: compile (data/float64 1) directly on every host incl. cljd? yang.clojure compiles on cljd? The cljd lane compiles yang.clojure (it's cljc with :cljd branches — compile-form works). So this deftest runs everywhere: (yang/compile (data/float64 1)) → :literal carrier → root matches across hosts (recorded digest).\\\\n- capability claim: read-forms refusal on cljd/jolt — testable only on those hosts: on :cljd assert (thrown? ... (yang/read-forms \\\\\\\"1.0\\\\\\\")). On jolt lane too. On clj/cljs read-forms works — so the deftest is reader-conditional per host.\\\\n\\\\nGate 7:\\\\n- clojure-manifest revision \\\\\\\"c1-3\\\\\\\" (decide name!), lowering profile :yang.clojure/float-kinds... I need to FIX the names now: revision \\\\\\\"c1-3\\\\\\\", lowering profile :yang.clojure/constructed-collections-float-kinds-v1? Let me think about what reads best in manifests: existing: \\\\\\\"c1-2\\\\\\\" + :yang.clojure/constructed-collections-v1 + :yang.clojure/c1. New: \\\\\\\"c1-3\\\\\\\" + :yang.clojure/constructed-collections-float-kinds-v1 — long but descriptive; or :yang.clojure/numeric-kinds-v1. The ruling: \\\\\\\"The replacement profile must retain the constructed-collection ordering contract as well as add numeric-kind preservation\\\\\\\" — the NAME should carry both contracts. I'll use :yang.clojure/constructed-collections-float-kinds-v1.\\\\n- unchanged: yang.clojure/call-site-version 1, jing profile versions (where? dao.jing has a version?), C1 marker. Assert call-site-version = 1 and validate-ast-call-sites still passes on a compiled tree.\\\\n- immutable old pins: python profiles locks still verify — call (python.profiles/verify-builtin! :yang.python/clojure-core-v1)? That requires the ANTLR python parsers built (gen:antlr done) — it's used by tests already (descriptor_profile_test). It's expensive-ish but JVM cached via delay. Include on :clj only.\\\\n- unselected native profiles retain artifacts: php/ts — heavy; use numerics unit checks + rely on existing suites (float_address_test) as regression oracles (run them).\\\\n- source/forms capability claims: assert the manifest exposes... currently the binding carries {:input :forms} vs source — after fix, clojure binding has :parse read-forms and no :input. Capability claim test: select-frontend → binding has :parse fn; (contains? binding :input) false. Hmm — I'll add a :source-capability marker? Keep it simple: assert the installed binding's parse consumes a string: ((:parse binding) \\\\\\\"1.0\\\\\\\") returns carrier. That IS the capability claim test through the real catalog.\\\\n\\\\nNow the corpus (gate 3) into collection_order_test — I'll do that as a separate edit after implementing.\\\\n\\\\nAlso gate 5 prelude emission \\\\\\\"pin its contents across hosts\\\\\\\": assert the clj module root matches the pinned address on JVM AND Node — the profiles verify does exactly that (verify-address! on module-locks) — via verify-builtin!. Put in gate 7 on both clj+cljs? python.profiles loads on cljs? profiles.cljc — cljs-compatible? descriptor_profile_test.cljc is in test/yang/python/antlr/ — .cljc! So it runs on node. verify-builtin! on node — validates addresses — good, include for :clj and :cljs.\\\\n\\\\nWait — but if my prelude.cljc host-fn additions don't change the module bytes, verify passes unchanged. If they DO change bytes (they shouldn't — host fns aren't in quoted module forms), verify fails → I must re-pin. The test itself will tell me.\\\\n\\\\nLet me check %capture usage for the continuation test.\\\",\\\"signature\\\":\\\"28fe1bfbe2ef4ff2b2d97fea\\\"}],\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":0,\\\"output_tokens\\\":0},\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"519cc353-4ebf-4ee9-a727-f6a51287dd1a\\\",\\\"uuid\\\":\\\"7e81d0dc-a258-4e83-93e1-9e70586d9e6d\\\",\\\"timestamp\\\":\\\"2026-11-26T12:55:01.773Z\\\",\\\"thinking_duration_ms\\\":27540,\\\"thinking_display\\\":\\\"updates\\\"}\\ncollab/yang-clojure/1795695531000-engineer-float-kind-portability-r1.glm-5.3.stdout.log:61287:{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"id\\\":\\\"msg_20261126205522846938080c634f48\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"model\\\":\\\"glm-5.3\\\",\\\"content\\\":[{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"The %capture pattern: a program `((fn [] (let [x (%capture)] ...)))` — when run, capture yields the continuation; delivering a value to it resumes. How do tests deliver? That's the continuation machinery (yin.vm.values/continuation?). For gate 5's snapshot crossing, a lighter honest option: the REPL **round boundary** IS a state crossing (each eval round snapshots VM state through the ledger...). Hmm, not really a continuation.\\\\n\\\\nLet me look at stream_eval_test — it's in the RULING 5 test-extension list, suggesting it's the natural home for \\\\\\\"a float result crossing a snapshot/continuation boundary\\\\\\\". Let me read its shape.\\\",\\\"signature\\\":\\\"c9b14029912d45bca2cdf839\\\"}],\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":0,\\\"output_tokens\\\":0},\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"519cc353-4ebf-4ee9-a727-f6a51287dd1a\\\",\\\"uuid\\\":\\\"7c5d9656-0ff6-4830-b148-e1cb67f5ad2a\\\",\\\"timestamp\\\":\\\"2026-11-26T12:55:27.248Z\\\",\\\"thinking_duration_ms\\\":3092,\\\"thinking_display\\\":\\\"updates\\\"}\\ncollab/yang-clojure/1795695531000-engineer-float-kind-portability-r1.glm-5.3.stdout.log:61938:{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"id\\\":\\\"msg_20261126205545d8827d834bc44f3a\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"model\\\":\\\"glm-5.3\\\",\\\"content\\\":[{\\\"type\\\":\\\"thinking\\\",\\\"thinking\\\":\\\"I have the exact pattern for the parked-round continuation crossing: a program that blocks on its own stream, with a float computation pending in the parked frame, resumed by a later put!. The parked program: \\\\\\\"(def e (stream/make 2))\\\\\\\" then \\\\\\\"(+ (stream/next! (stream/cursor e)) 0.5)\\\\\\\" — parks on next!; later \\\\\\\"(stream/put! e 1.5)\\\\\\\" → resumes → (+ 1.5 0.5) → 2.0 float! An integral float result crossing the park/resume (continuation snapshot) boundary. Assert result value float64? and text \\\\\\\"2.0\\\\\\\".\\\\n\\\\nWait — does the resumed read return the put element? Yes (\\\\\\\"5\\\\\\\" \\\\\\\"5\\\\\\\" pattern). And (+ element 0.5): element = 1.5 (put as float) → 1.5+0.5 = 2.0. Under the repaired REPL primitives, + with carrier → reboxed 2.0 float.\\\\n\\\\nFor gate 5, this test in MY namespace (as appropriate; stream_eval_test extension \\\\\\\"as appropriate\\\\\\\" — I'll put it in my namespace as a REPL-route test to keep changes to that file zero... Actually RULING 5 says extend stream_eval_test \\\\\\\"as appropriate\\\\\\\" — I can add rows to its pure-corpus instead! pure-corpus [[\\\\\\\"1.0\\\\\\\" \\\\\\\"1.0\\\\\\\"] [\\\\\\\"(+ 1.5 1.5)\\\\\\\" \\\\\\\"3.0\\\\\\\"]] — those run on every VM (slow-guarded). That's the cleanest \\\\\\\"extend as appropriate\\\\\\\". And the parked-float test also there? Its harness is private to that ns. Hmm — I'll add the corpus rows to stream_eval_test (2 lines) AND put the parked-float-continuation test in my namespace (self-contained harness). Actually my namespace lacks the evaluate helper — simple reduce, add it.\\\\n\\\\nNow writing gates 5-7 into my namespace. Also the legacy custody + artifact fixtures + capability claims.\\\",\\\"signature\\\":\\\"d508e716dfb94160ba5e0e2a\\\"}],\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":0,\\\"output_tokens\\\":0},\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"519cc353-4ebf-4ee9-a727-f6a51287dd1a\\\",\\\"uuid\\\":\\\"aa401938-a2b7-4e38-812b-9ac2009bdff6\\\",\\\"timestamp\\\":\\\"2026-11-26T12:55:56.715Z\\\",\\\"thinking_duration_ms\\\":8986,\\\"thinking_display\\\":\\\"updates\\\"}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n12:{\"type\":\"item.started\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/yang-clojure/1795709372000-architect-floatkind-signoff.gpt-6-astra.findings.md; cat collab/yang-clojure/1795693415000-architect-float-kind-portability-ruling.gpt-6-astra.findings.md'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/yang-clojure/1795709372000-architect-floatkind-signoff.gpt-6-astra.findings.md; cat collab/yang-clojure/1795693415000-architect-float-kind-portability-ruling.gpt-6-astra.findings.md'\",\"aggregated_output\":\"Role: Architect (numeric semantics)\\nCoding-Agent: codex\\nDate: 2026-11-26\\nTarget: `fix/float-kind-portability` at `6a7fb586ac1f1b35487c88b0fc6108a6aa440664`\\nGoverning ruling: `1795693415000-architect-float-kind-portability-ruling.gpt-6-astra.findings.md`\\n\\n**Verdict: REMAINING-BLOCKERS. Do not merge `6a7fb586` to master.** The selected token-time architecture is implemented, and substantial historical evidence supports the intended float repair. However, the landed D-2 edit breaks the acceptance-test namespace, and bounded execution probes expose reader data loss and incorrect guest equality. The independent APPROVE at `42b8cfc6` does not establish correctness of the final tip or cover these cases.\\n\\n**Inspection identity and custody**\\n\\nThe requested darkstar mirror is NOT the landed tip: `/Users/sto/workspace/datomworld-floatkind` has HEAD and its locally cached origin branch at `8214a3ed8d1e6627cf9a4eb6fdb896076ba22316`, plus an uncommitted change to `test/yang/clojure_float_kind_test.cljc`. It lacks the engineer/reviewer findings and cited evidence directory. The named engineer findings also do not exist in the main darkstar checkout. `git cat-file -t 6a7fb586` there fails.\\n\\nRead-only `git ls-remote origin` verified the requested branch at `6a7fb586ac1f1b35487c88b0fc6108a6aa440664` and master at `bab7640f0b162444285ab622469de1abbefbb668`. I therefore inspected the clean `/home/sto/ci/datomworld-floatkind` clone on `jupiter.stigmergy.systems`, whose HEAD matches the origin tip exactly. All landed-source line references below refer to that commit, not the stale darkstar worktree. No checkout, fetch, reset, commit, push, or implementation edit was performed.\\n\\n**Required dispositions**\\n\\n1. **B-1 / P1 — D-2 makes the seven-gate namespace unloadable.** `test/yang/clojure_float_kind_test.cljc:16` starts with `[clojure.test ...]` directly inside `ns`. The diff of `6a7fb586` deletes the entire line `(:require [clojure.string :as str]`, including the `:require` opener, while retaining its closing delimiter. Requiring the actual landed namespace fails with `Syntax error macroexpanding clojure.core/ns ... Call to clojure.core/ns did not conform to spec.` This is a new defect introduced after the independent review. Restore the require clause while removing only the unused dependency; run lint and freshly load/build/run the affected acceptance namespace on the applicable hosts at the corrected commit. Cached pre-D-2 binaries and logs cannot certify this source.\\n\\n2. **B-2 / P1 — The source set reader silently drops false/nil and every later occurrence.** `src/cljc/yang/clojure/reader.cljc:374–384`, specifically `(if-let [x (first xs)] ...)`, treats a false/nil element as exhaustion. Live results: `#{false 1.0 2}` reads as `[#{}]`; `#{nil 1.0}` also reads as `[#{}]`; `#{1 false 2}` reads as `[#{1}]`. The standard catalog evaluates `#{false 1.0 2}` to `#{}`. This directly violates RULING 2 and Gate 2 occurrence preservation, including loss of the floating occurrence. Test sequence presence, not element truthiness; cover false/nil at all positions and duplicate checking after them on JVM and Node.\\n\\n3. **B-3 / P1 — Scoped variadic equality returns true without comparing false/nil operands.** `src/cljc/yang/clojure/numeric.cljc:177–190`, specifically line 185, repeats the same truthiness/exhaustion error. Direct probes return true for `(clj-= 1 1 false)`, `(clj-= 1 1 nil 2)`, and `(clj-= 1.0 1.0 false)`. Actual standard-catalog source `(= 1 1 false)` and `(= 1.0 1.0 nil)` both return `true`. They must be false under the declared `data/equiv` contract. `clj-!=` inherits the wrong negation. Traverse the remaining sequence independently of its values and add variadic source-path tests for both predicates, including operands after false/nil.\\n\\n4. **B-4 / P1 — A valid keyword collides with the reader's discard sentinel.** `reader.cljc:350–353`, `422–431`, `499–502`, and `697–700` identify discard by equality with ordinary keyword `::discard`. Therefore source `:yang.clojure.reader/discard` reads as `[]`, and `[1 :yang.clojure.reader/discard 2]` reads as `[[1 2]]`. The keyword is valid guest Data, not a reader directive. Represent discard as separate parser control state or another unforgeable parse-local mechanism, and test that all valid literal values remain representable in top-level, collection, and required-form positions.\\n\\n5. **B-5 / P1 — Anonymous-function expansion captures user variables.** `reader.cljc:451–483` chooses fixed symbols `p__1`, `p__2`, and `p__rest` for `%` parameters. The standard catalog returns `4` for `(let [p__1 10] (#(+ p__1 %) 2))`; the equivalent explicit function `(let [p__1 10] ((fn [x] (+ p__1 x)) 2))` returns `12`. Upstream reading keeps the original `p__1` distinct from its generated parameter; the new reader rewrites both references to the same binding. Use capture-avoiding, parse-scoped names while preserving deterministic canonical output. Test positional and rest parameters against colliding user bindings. This finding concerns the newly advertised anonymous-function support; it does not assert that the old compiler accepted upstream `fn*` lowering.\\n\\n6. **B-6 / P1 — The replacement reader rejects previously working, unaffected source.** `reader.cljc:107–125` incorrectly treats apostrophe inside a token as terminating; `reader.cljc:640–642` unconditionally refuses syntax quote. With the old `clojure.tools.reader` source stage and the same current compiler/VM, `(let [x' 10] x')` executes to `10`, and source backtick followed by `1` executes to `1`. The new reader respectively throws `Unmatched delimiter: )` and `Syntax-quote (\\\\`) is not supported in portable source reading`. These are integer-only compatibility regressions, not consequences required by preserving floats. Restore the previously supported grammar, with differential lexical tests. Any intentional narrowing requires a separately explicit architectural disposition and public capability contract; the float ruling did not authorize it. In particular, merely documenting a refusal in the engineer's findings is insufficient.\\n\\n7. **B-7 / required Gate 5 evidence — The claimed continuation test does not carry an already-produced integral float across the pause.** `gate5-parked-float-result-crosses-the-round` parks while `(+ <hole> 0.5)` is pending, appends serialized `1.5`, computes `2.0` after resume, and serializes that final result. It tests resumed arithmetic and value encoding, but no integral-valued floating result exists before the continuation boundary. Add a case that computes an integral float first, retains it in guest continuation/state across a pause/resume (and snapshot serialization if claiming snapshot coverage), then verifies its float kind, exact value/bits and canonical identity. Keep the existing test as useful complementary coverage.\\n\\n**Ruling-by-ruling verification**\\n\\n| Obligation | Observed landed implementation/evidence | Disposition |\\n| --- | --- | --- |\\n| RULING 1: semantic oracle | `gate4-data-oracle` calls exported Data operations and checks scalar/nested integer-vs-float inequivalence, float equivalence, admission, signed zero and NaN. `gate4-unboxed-control-distinguishes` executes boxed/unboxed forms and compares both semantic equivalence and roots. | Substantive oracle exists; B-1 prevents loading it as landed, and B-3 shows missing variadic source-equality coverage. |\\n| RULING 2: option b | `reader.cljc:648–654` materializes the original token through `numeric-token/materialize :clojure` before collection construction. No Number-value reconstruction, source-wide regex substitution, print round-trip, global reader replacement, or postwalk of lost numeric values is used. Lexical coverage is described in reader source and engineer findings; Gate 2 supplies actual tests. | Correct architectural layer; coverage is insufficient to certify the replacement grammar and occurrence preservation (B-2, B-4, B-5, B-6). |\\n| Source routing and execution | `yang.clojure/read-forms`, `yang.io`, catalog bindings and two demos use the new reader; the equation plotter is explicitly delimited as legacy raw-forms host interop. Forms compiler admits existing numeric carriers. Catalog installs scoped primitives; global VM primitives remain unchanged. | Float production/routing is real. Scoped equality needs B-3. The plain forms API still requires explicit intended-kind Data and suitable runtime bindings. |\\n| RULING 3: identity | `frontends.clojure-manifest` declares `c1-3`, `:yang.clojure/constructed-collections-float-kind-v1`, and `:yang.clojure/c1-float-kind`. Grammar identifies `yang.clojure.reader`, with `:source-text` on JVM/Node and `:forms-only` on Dart/Jolt. | Names and capability distinction match the landed contract; no c1-2 relabeling. |\\n| RULING 3: custody/history | Both archived c1-2 payloads match the recorded SHA-256 values; independent loading, execution and whole-payload decode/re-encode succeeded. Historical c1-1 and cc4 paths are absent from the change set. | Verified, with details below. |\\n| RULING 4: documentation | Codec cross-reference, `yang.antlr.md` §8.8.1, implementation documentation, prelude producer obligations, API/REPL docstrings, and collection-corpus commentary are present. They distinguish portable Data from source/forms and state the JS bare integral Number contract honestly. | Required locations substantially covered. Claims of completed source preservation cannot override the confirmed counterexamples; reconcile after fixes. |\\n| RULING 5: boundaries | No production codec, VM equality, base VM primitive table, C1, UAST or bytecode format change. Shared factory and narrow PHP/Python/TS adapters follow the owner's round-brief addition. `yang.io` is an additional actual source-ingestion route. Shared prelude/module publication sources remain unchanged. | No forbidden codec/global-reader shortcut. The 700-line replacement reader has demonstrated compatibility defects; its scope cannot be accepted merely because the path is authorized. |\\n| RULING 5: pins | Existing corpus reference rows remain; the integral-float row adds one common root/key/C1/instruction-provenance reference and an unmodified-source comparison. Shared runtime closure pins and other frontend revisions are not reminted. | Bounded pin changes are explained; preserve history and rerun relevant gates after fixes. Do not repin away these failures. |\\n| Independent review / D-1 / D-2 | Persisted deepseek findings say APPROVE at `42b8cfc6` over fix `3b850212`. D-1 adds a clean 157/1264 recapture; the original failing regression log remains. D-2 removes the unused require but also its clause opener. | D-1 supplies the stated rerun, not a new full regression run. D-2 is incorrectly applied and blocks merge. |\\n\\n**Raw evidence accounting**\\n\\nI read the logs under `collab/yang-clojure/1795702210000-floatkind-evidence/`, not just the engineer summary:\\n\\n- `red-jvm-all7gates.log`: 21 tests / 228 assertions, 19 failures / 1 error; separate corpus run 2 tests / 22 assertions, 2 failures / 0 errors. `red-node-all7gates.log`: 22 tests / 214 assertions, 75 failures / 5 errors. Failure entries exercise the expected lost-kind, carrier-admission, semantic and identity surfaces.\\n- `green-jvm-all7gates.log`: 22/290 and 2/22, both clean (combined 24/312). `green-node-all7gates.log`: 24/310, clean.\\n- `green-jvm-regressions.log`: 311/3659 with **7 failures**, not globally green. `green-jvm-repl-clojure.log` and D-1's `green-jvm-regressions-recaptured.log`: 157/1264, clean. The claimed other 154/2395 is the residual of the earlier mixed run, not an independently captured clean full run.\\n- `green-node-regressions.log`: 178/2137, clean, with explicit slow-test/host-applicability skips. `green-demo-build.log`: 324 files, 323 compiled, 0 warnings. A build is not an interactive demo smoke test.\\n- `green-dart-gates.log`: all 63 tests pass. The forms-only capability and carrier/custody tests are the relevant claim; this is not native Dart source parsing.\\n- `green-jolt-gates.log`: float-kind 21 tests / 55 assertions, PHP float 45 assertions, vm.float 108 assertions, all with zero failures/errors. Its source-only test vars explicitly perform zero assertions. The combined run is **not wholly green**: vm.data has 527 passes and 3 unpaired-surrogate errors. Those are outside the changed numeric sources and are disclosed by the author/reviewer. The corpus tail is `JOLT-CORPUS-REF: nil`, not a separately counted corpus summary.\\n- `kondo.log`: 0 errors / 6 warnings, including the now-removed `clojure.string` require. This is visibly pre-D-2 evidence and cannot certify `6a7fb586`.\\n\\nThus the historical greens are meaningful evidence of the earlier float implementation, but the statement “seven gates present and green AS LANDED” is false because the final namespace cannot load. The new counterexamples also show why successful existing assertions are not sufficient for acceptance.\\n\\n**Independent bounded execution evidence**\\n\\nProbes ran on jupiter from its existing cached classpath, without dependency resolution or rebuilding:\\n\\n```sh\\ncd ~/ci/datomworld-floatkind\\njava -XX:-UsePerfData -cp \\\"$(cat .cpcache/1935970182.cp):test\\\" clojure.main -\\n```\\n\\nThe source/semantic probes required the actual production namespaces and called `yang.clojure.reader/read-forms`, `yang.clojure.numeric/clj-=`, and `yin.repl/eval-input` over `yin.repl.frontends/create-state {:vm-type :semantic}`. The test-load probe required `yang.clojure-float-kind-test` and reported its namespace-spec failure. No in-memory repair of that namespace was used to manufacture a green result.\\n\\nFor each legacy binary I decoded the disk bytes, passed `[:root :rows]` into `ast-walker/vm-load-rows`, executed with `vm/run`, and compared the original whole payload bytes with `cbor/encode` of the decoded payload:\\n\\n| File | SHA-256 | Loaded revision / execution / re-encoding |\\n| --- | --- | --- |\\n| `float-kind-legacy-jvm-float.cbor` | `71dc93298c26773dc8383f5d12e03d732840052692a272c16c4aaf4ec90783ec` | c1-2; float64 true, exact integer false, value 1.0; original bytes identical |\\n| `float-kind-legacy-node-integer.cbor` | `ffb9db68eb953ccadd681b916a8df6d262206baa055d6f91eda461d179174ef2` | c1-2; float64 false, exact integer true, value 1; original bytes identical |\\n\\nFresh source `((fn [] 1.0))` compiled to `:segment/blake3-7cdae9dfee7f1980ccdd9543f279d0d7d20e4a4a4a44dda14f88f54ba9002049`, matching the historical JVM float root and differing from historical Node integer root `:segment/blake3-541ba2ffc6b74327f70008d2069a35279612c2e96c82cc198d7b0b6782501e4c`. The two selected corpus tests independently returned `{:test 2, :pass 22, :fail 0, :error 0}`.\\n\\nOne subsequent baseline experiment in that same process encountered unsupported upstream `fn*` lowering and exited nonzero after those custody/corpus results. I do not describe that process as an all-green suite. A separate completed probe verified the apostrophe and scalar syntax-quote baseline, plus the explicit-function versus anonymous-function 12/4 counterexample. No Node/Dart/Jolt suite was freshly run in this sign-off; their recorded logs were inspected.\\n\\nThe review skill's generic analyzer could not decode the complete remote diff as UTF-8 (the Node custody fixture is presented as a text diff containing binary bytes). Direct source diffs, protected-path checks and executable probes supplied the review evidence instead. `git diff --check origin/master...HEAD -- src test docs` passed; this does not check Clojure namespace syntax.\\n\\n**Landing and re-review instruction**\\n\\nKeep fixes on `fix/float-kind-portability`; preserve the independent review and original evidence as history. Resolve B-1 through B-6 and add B-7's actual boundary case, then obtain review and fresh affected-host gate evidence for the corrected commit. Record the tested SHA, commands, host capabilities, counters and exit codes; compile from the corrected source rather than reusing pre-D-2 test artifacts. Re-pin only when a semantic/provenance change explains a necessary new value; preserve c1-1, c1-2 custody and historical cc4/r3 records.\\n\\nAt the observed master `bab7640f`, merge-base is `7f4898f474d02dc127e5e484254bc44ae7ff88f6`. Master's three later commits (`bce01bad`, `d49ff4b7`, `bab7640f`) do not change the production numeric/frontend files under review. No numeric-runtime prerequisite or competing pin migration from that master was identified. Preserve those master-side additions during integration. Master's earlier green declaration cannot certify this branch.\\n\\nAfter the blockers are closed and a new architect sign-off is issued, the corrected branch should fold to master as **one merge**, retaining its implementation, custody and review chain together. Do not merge the current tip or cherry-pick only the nominal implementation while dropping evidence/dispositions. Recheck master and any overlapping frontend/runtime or pin changes at landing time; this report does not approve a future changed target automatically.\\n\\nOnly this findings file was written in the repository. Both existing worktrees and their unrelated changes were left intact.\\nRole: Architect (compiler provenance / numeric semantics)\\nCoding-Agent: codex\\nDate: 2026-11-26\\nInspected HEAD: `7f4898f474d02dc127e5e484254bc44ae7ff88f6`\\nAuthority: architectural ruling only; no implementation, dispatch, re-pin, or publication authorized.\\n\\n# Integral-float kind preservation on JavaScript\\n\\n**Decision: this is a runtime correctness defect in the source-to-VM portability claim. Fix it in the source frontend, before numeric token kind is lost. Select option (b): frontend-owned, token-aware source ingestion and lowering. Preserve Jing's existing numeric contract and representation. Old artifacts retain their recorded meaning; repairing their compilation requires new artifacts.**\\n\\nThe r2 acceptance of a narrowed collection-order corpus was a scope boundary, not acceptance of the numeric defect. This ruling supersedes any reading of “encoder/float-carrier territory” as a diagnosis that the encoder should infer the lost kind. It does not retroactively reopen that bounded collection-order decision or authorize work now.\\n\\n## Evidence re-derived\\n\\n1. `src/cljc/dao/host/integer.cljc:66` classifies safe integral JS Numbers, except negative zero, as exact integers. `src/cljc/dao/jing/cbor.cljc:201–220` also recognizes unsafe integral Numbers for refusal and distinguishes floating content. `number-bytes` at line 748 emits integer content or refuses an unsafe integral Number before its float branch. JVM `Double` is float content, even at `1.0`. `cbor/float64` at line 242 delegates to `dao.host.number/float64-of`, whose JS carrier preserves the distinction. This matches `docs/design/dao.jing.cbor.md:387–425`; the codec is conforming.\\n2. `src/cljc/yin/vm/data.cljc:513–536` makes float and exact-integer `data/equiv` mutually exclusive, recursively. Its `admit-key?` at line 538 refuses float content and admits exact integers. `data/content=` and Jing `content=` are kind-strict. `src/cljc/yang/clojure/core_impl.cljc:256–261` dispatches `inc`/`dec` to `float/add`/`float/sub` or integer operations according to `data/float64?`. `clj/collection-key` in `src/cljc/yang/clojure/prelude.cljc:225` applies the key admission policy. These are observable semantics, independently of hashing.\\n3. `yang.clojure/compile-literal` at line 766 merely puts its argument in `{:type :literal :value ...}`. `compile-quote` does the same for quoted Data. There is no lexical provenance from which either can distinguish two bare JS Numbers with value 1.\\n4. The explicit source entry `yang.clojure/read-forms`, at line 2135, uses **`cljs.tools.reader`**, not an in-repository Clojure lexer. JVM uses `clojure.tools.reader`. These are upstream `org.clojure/tools.reader` code; `deps.edn` declares 1.5.0. I inspected the locally available 1.5.0 and 1.5.2 jars: `cljs/tools/reader.cljs` reads a token and calls `match-number`; `cljs/tools/reader/impl/commons.cljs:79–95` selects float syntax and returns `js/parseFloat`. It knows the distinction temporarily and discards it in its result. A general tagged-literal hook does not automatically intercept ordinary numeric literals.\\n5. **There is another source entry.** `yin.repl/read-forms`, `src/cljc/yin/repl.cljc:1333`, uses `cljs.reader` on JS and `clojure.core/read-string` on JVM. The standard Clojure binding in `src/cljc/yin/repl/frontends.cljc:135` is `:input :forms`, with `:parse identity`. `compile-input`/`compile-source` therefore pass already-read forms. Fixing only `yang.clojure/read-forms` misses the normal REPL. `yin.repl.adapter` also reads for command detection, but forwards ordinary remote input as its original string; its command sniffing must not be confused with compilation.\\n6. **There is a carrier-admission gap.** `yang.clojure/literal?` and `constant-form?`, lines 270–301, recognize numeric scalars through host `number?`. Jing's JS Float64 is a `deftype` carrier, not a JS Number. Directly supplying that carrier to the normal forms compiler can reach “Cannot compile unknown form type” at line 1840. Carrier insertion therefore requires bounded compiler admission work as well. The VM Data API, raw UAST literal constructors, and the forms compiler are distinct APIs; a working carrier in the first two does not prove acceptance by the third.\\n7. Python already boxes float tokens in `src/cljc/yang/python/antlr/lower.cljc:350–363`; PHP does so in `src/cljc/yang/php/antlr/lower.cljc:310–315`; TypeScript boxes Number tokens in `src/cljc/yang/typescript/antlr/lower.cljc:428–440`. TypeScript BigInt is a separate case: “every numeric literal” here means Number literals, not BigInt literals. Python/PHP distinguish integer syntax from float syntax; TypeScript Number `1` is intentionally float64 content. Uniform representation does not mean uniform language rules for spelling `1`.\\n8. Host-compiled quoted `.cljc` prelude data can lose kind independently of the runtime reader. The JVM build reader can retain Double initially, but the emitted JS literal is still a bare Number. `yang.core.defquoted` is not a general numeric-preservation pass. TypeScript's explicit `(data/float64 1)` convention and Python's existing float-address discipline address that producer boundary; changing a runtime source reader cannot retroactively repair already-compiled quoted constants.\\n9. **Carrier-aware arithmetic is profile-specific.** `src/cljc/yin/vm.cljc:420–440` still binds the base `+`, `-`, `*`, comparison and equality primitives to host functions. The `inc`/`dec` evidence above is the Clojure library path, not a claim that every base primitive dispatches by Jing kind. `core-source-name` in `yang.clojure.cljc:868` is conditional on the outcome/library convention. Boxing a literal does not by itself make bare host arithmetic portable; on JS the carrier deliberately refuses numeric coercion. This is a necessary integration gate, not a reason to erase kind again.\\n\\nThe archived r3 failed comparison confirms different roots **and** occurrence/provenance digests for the former float row:\\n\\n| Field | JVM reference | Node actual |\\n| --- | --- | --- |\\n| Root suffix | `149c168e3b766d703fc230365be4ad940bbcf487e0bff36efff9cf6e3bf08958` | `d4ee0ca368a18d7cf8010e211e50ed96df6f4ecc39befad11dd9aad01c57d5b1` |\\n| Keys digest | `cb7365d53d55ad30e90e700206caff405d3fe1d5faf62566df91f4f1dcd4afb7` | `f6e32612f78e3299c469e14c953e8ee53cf3226ed825f3c12b69b5080d1f42da` |\\n| C1 digest | `f181b911a60e6e66217fecbf93bd6623d83354c41aa0afdb9e49f10f45f69fdd` | `d8058ae46577532bdbc709df329d5c324b731abb7962ad29cf326a084ef99906` |\\n| Instruction provenance | `e25482dac0a59eaa0801c1faea000ad518a5ab1d7e53b704d883ff6ecf495735` | `4aaeac91b2a2a1af5e3b980c325ac60b0534913df06ee069af2f03c89224456e` |\\n\\nSource: `1795104744000-fixorder-r3-evidence/fixorder-r3-node-order-floats-divergence.log`, line 11. The boundary note has the already-reported transcription error in the JVM provenance digest; the raw log above is authoritative. The r2 findings are `1795119753581-architect-fixorder-signoff-r2.gpt-6-astra.findings.md`.\\n\\n## RULING 1 — Impact and responsibility\\n\\n**Normative:** yin.vm's source portability claim MUST treat loss of intended numeric kind as a correctness defect, not merely an address or traceability defect. Identical source text MUST NOT silently acquire integer semantics on one supported compiling host and floating semantics on another. A portable VM interpreting correctly encoded Data does not absolve a frontend that supplies the wrong Data.\\n\\n| Surface | Concrete impact and boundary |\\n| --- | --- |\\n| Source text and source forms | Bare `0.0`, `1.0`, `1e0`, negative integral floats, and floats rounded/underflowed to integral values can become integers on JS. Unsafe integral results can be refused instead of compiled. This affects top-level literals, arguments, definitions, quoted data, and nested collection contents. Once an external reader has supplied only Number 1, the forms API cannot know whether it originally read `1` or `1.0`. |\\n| Public host-Data APIs | An unboxed JS Number 1 already denotes integer content under the contract. A caller intending float content must supply `cbor/float64`/`data/float64` before crossing the boundary. Correctly boxed VM inputs are representable today. The forms compiler's additional carrier-admission gap must be fixed; do not advertise direct carrier forms as working everywhere today. |\\n| Runtime equality and dispatch | For intended float `f = 1.0`, `data/equiv(f, 1)` is false; after collapse it is true. The same distinction recurses through vectors and maps. `inc(f)` takes the float branch and returns float content; collapsed 1 takes the integer branch. A matching printed result, such as 2, is not a sufficient oracle. |\\n| Collections | Key admission can change from float refusal to integer acceptance. Lookup, membership, collision behavior, and constructor operand ordering can consequently differ. A host reader may already coalesce integer/float keys or set members before compilation. This ruling does not grant float-key support to Clojure-family collections: existing refusal policy remains. Do not assert that all maps universally support both keys merely because Jing distinguishes the scalar contents. |\\n| Prelude/library code | Host-quoted numeric constants, macro-generated forms, and library constructors are producers too. A runtime reader fix does not reach them automatically. Explicit float constructors remain necessary where those producers otherwise lose information. Float-producing arithmetic must rebox before a value is exposed, stored, captured, or resumed. |\\n| Stored artifacts and cross-host reload | A JS-produced artifact containing integer 1 reloads as integer 1 on JVM. It is not healed by the destination reader. A JVM-produced float artifact decodes to a Float64 carrier on JS and retains float kind. The defect is usually different artifacts produced from the same source, not the decoder randomly changing a fixed artifact. Existing profile/ABI compatibility requirements still apply. |\\n| Canonical addresses and provenance | Integer and float literal bytes differ; ancestor UAST roots, compiled-content ordering, call-site keys/C1 relations, format projections, modules, and addressed state can differ. Source-text identity can remain identical while derived forms differ. Sorting cannot repair wrong child content. |\\n| `content=` | `content=(float64(1), 1)` is false by contract. A collapsed source `1.0` produces true against integer 1 on JS. Canonical equality must remain kind-strict; weakening it would hide the defect and alter valid programs. |\\n\\nThe distinction between `data/equiv` and `content=` also remains: floating positive and negative zero are `data/equiv`, but not `content=`; NaN is not `data/equiv` to itself, while canonical NaN content has one identity. The repair MUST NOT conflate these relations.\\n\\n## RULING 2 — One fix layer: frontend-owned lexical preservation (option b)\\n\\n**Normative:** the Clojure source frontend MUST preserve the original numeric token's kind while source text is available and produce Jing float64 Data for every supported binary floating literal, including integral-valued ones. On JS, all such float literals MUST use the existing carrier, including non-integral values. Integer literals MUST remain exact integers under their existing supported range/carrier rules. No test of a bare Number's value can reconstruct the missing distinction.\\n\\nChoose **(b), frontend-owned token-aware source ingestion**, generalized from the ANTLR frontends' producer rule. “Reconstruction” means interpreting the retained original token, not guessing from the output of an ordinary reader. It MUST occur before host maps/sets or downstream lowering can destroy occurrences. A value-keyed table, postwalk of already-read Numbers, numeric printing round-trip, or textual regex substitution over arbitrary source is insufficient.\\n\\nThe frontend may retain token spans/kinds in a transient parse structure and materialize carrier Data from them. It need not adopt ANTLR or replace the whole Clojure grammar. A scoped source-reading adapter can be the implementation of this frontend-owned stage, but it MUST consume the original lexical information; changing the meaning of the process-wide host reader is not the selected architecture. The engineer must demonstrate lexical coverage and occurrence preservation before selecting a minimal mechanism. The ruling does not pre-authorize a full parser rewrite.\\n\\nAll source compilation routes, including REPL compilation, MUST reach this stage or supply equivalent already-kind-preserving forms. Retain the original source text and source locations for provenance. Reader support and refusal behavior must be explicit for comments, strings, character literals, quote, metadata, dispatch forms, discarded forms, and any currently supported conditional syntax. No evaluation during reading and no ambient mutable reader registration. Token kind is derivable from source and need not become a new persisted UAST field or Jing tag.\\n\\nAlternatives:\\n\\n| Option | Ruling and reasons |\\n| --- | --- |\\n| (a) Change the upstream cljs reader/toolchain to return Float64 | Rejected as the primary repair. The readers are not ours; changing ordinary numeric results across upstream `cljs.tools.reader`, `cljs.reader`, and host compilation affects unrelated application code, host arithmetic, and macros. A change to one reader misses the others and precompiled quotes. A future upstream token-preservation API could help implement (b), but is not a dependency or authorization for global reader semantics changes. |\\n| (b) Frontend owns lexical preservation and emits the carrier | Selected. It acts where syntax still identifies the kind, is independently versionable, follows the existing Python/PHP/TS pattern, and leaves the codec and consumers' Data interpretation intact. It includes the source-ingestion boundary, not just `compile-literal`. |\\n| (c) Change canonical CBOR for integral JS Numbers | Rejected for this defect. A bare Number supplies no fact distinguishing intended integer from float. Encoding all such Numbers as float breaks legitimate integers; encoding all integral floats as integers breaks the established four-kind model and JVM/Dart meaning. A new explicit marker would merely duplicate the existing Float64 carrier. A deliberate future codec round is possible, but cannot recover absent source information and has an unnecessary consumer-wide migration radius here. |\\n| (d) Source discipline only | Rejected as closure of source portability. Requiring every user to rewrite `1.0` is an honest temporary restriction, not a working frontend for supported float syntax. Explicit constructors remain the permanent, correct contract for already-materialized host Data and generated/precompiled code whose original syntax is unavailable. |\\n\\n**Cross-frontend uniformity:** all four frontends MUST meet the same producer invariant, while retaining their language's numeric syntax and selected semantic profile. Python's tagged native float payload must still be float64 internally; its Clojure profile can emit bare float64 content. PHP float tokens remain float64; TS Number tokens remain float64 and BigInt tokens remain integers. The new Clojure path brings its float tokens into the same representation. It does not promise that `1` means float in all languages or that unlike language profiles have identical program roots.\\n\\n**Forms and prelude obligation:** the forms compiler MUST admit existing numeric carriers as literal constants, including nested/quoted positions, and preserve them. It MUST NOT reinterpret an unboxed Number 1 as a float. Library/generated forms without token provenance must use explicit constructors or a kind-preserving source/build path. Audit host-quoted prelude constants on a host that still distinguishes Double from integer; a JS-only scan after loss cannot establish absence. Fixing only the source reader is not sufficient acceptance.\\n\\n**Execution obligation:** the repaired portable frontend/profile MUST route its supported floating operations through carrier-aware numeric operations/adapters, with results reboxed before becoming guest Data. The authorized round must inspect the default REPL and plain-compile bindings as well as linked/library paths. Do not feed newly boxed floats to raw host `+` and call a coercion exception a completed portability repair. Prefer the existing explicit float/integer modules and scoped frontend/runtime bindings; do not change the global legacy primitive table or Float64 coercion policy incidentally. Any raw-host profile retained unchanged must retain its explicit limitation and immutable identity. Supporting the affected floating operations under the new portable profile is part of acceptance; a broad legacy arithmetic overhaul is not implied.\\n\\n## RULING 3 — Migration, legacy loading, and revisions\\n\\n**Normative:** newly compiled affected JS artifacts MUST be re-minted under a new Clojure frontend revision and a revised lowering/support profile. The current `:yang/clojure` manifest is revision `\\\"c1-2\\\"`, lowering profile `:yang.clojure/constructed-collections-v1`, in `src/cljc/yin/repl/frontends.cljc:44–61`. Do not publish repaired semantics under those unchanged identities. The replacement profile must retain the constructed-collection ordering contract as well as add numeric-kind preservation; exact new names are for the authorized implementation round.\\n\\nThe revision is a portable frontend identity, not a Node-only variant. Publish the same revised frontend contract on supported hosts. Source-reader/tokenizer implementation identity belongs in the existing compilation derivation; expose accurate source-text versus forms-only capabilities. JVM/Node source reading and Dart/Jolt forms execution must not be mislabeled as four identical parser capabilities.\\n\\n- **Expected one-time bytes shift:** JS compilation of affected floating source changes literal content from INTEGER to FLOAT64 and changes its dependent address closure. Unsafe-integral-number failures can become valid float compilations. Correct JVM float literal bytes and already-correct Python/PHP/TS float bytes should remain unchanged. Unaffected integer-only and already-correct scalar artifacts must stay byte-stable unless a separately explained dependency or provenance record changes.\\n- **JVM changes are not categorically zero:** frontend manifests/derivations change with revision. Corrected source collection preservation, or a repaired shared prelude/library, may also change JVM artifacts. Inventory these explicitly; do not justify arbitrary churn by calling it a JS fix. Original source text is unchanged; a canonical read-form input address may change when its previous kind was wrong.\\n- **Legacy loading:** preserve old bytes and addresses. Continue loading/executing old integer-bearing and float-bearing artifacts with their recorded meaning and compatible pinned runtimes. Do not rewrite integer rows on load, alias old addresses to corrected bytes, or claim an old JS integer artifact was always a float. Recompilation from authoritative source under the new frontend yields a new artifact and a derivation relating input, interpreter revision, and output. If source is absent, recovery of intended kind is not generally possible.\\n- **Other frontends/profiles:** no blanket Python/PHP/TS revision bump. Their token float constructors already meet this obligation. Their native profiles and Clojure-family profiles need new immutable revisions only if this round actually changes their emitted content, descriptor/support promise, or pinned runtime closure. In particular, a change to shared `clojure.core.impl`/`clojure.core`/`clj` artifacts requires new pins for every consuming profile whose closure changes; never mutate an existing `clojure-core-v1` publication in place. Python's `py-v1` and already-correct native JS/PHP publications are not automatically re-minted merely because the Clojure source reader changes.\\n- **Version boundaries:** no Jing encoding-profile, CBOR tag, universal AST grammar, VM numeric-kind/equality, C1 marker, or bytecode-format version bump is warranted by this repair. Prelude/runtime revisions change only when their artifacts/contracts change. Keeping an old frontend revision selectable requires its actual old implementation/closure; retaining a label over new behavior is not legacy support.\\n\\nThis migration preserves artifact portability while correcting source portability. The new compiler cannot make past wrong and new correct artifacts have the same content address.\\n\\n## RULING 4 — Honest portability statement pending the fix\\n\\n**Normative text for the public claim:**\\n\\n> yin.vm on JS preserves the numeric kind carried by portable Data and canonically encoded artifacts, subject to the selected runtime/profile's supported operations. Its Clojure source-to-Data path does not currently preserve every floating literal: ordinary JS readers and host-compiled forms can collapse an integral-valued binary float such as `0.0`, `1.0`, or `1e0` into integer content before compilation. Therefore equal Clojure source containing those unmarked values is not currently guaranteed equal runtime behavior or canonical output across hosts. A bare integral JS Number denotes integer content; intended floating Data must use Jing's float64 carrier. The Clojure forms compiler also needs carrier-literal admission repaired before direct carrier forms are supported uniformly.\\n\\nSafe **with respect to this defect**, not a blanket certification of every language feature:\\n\\n- Supported exact integer forms whose values are representable exactly on the producing host; use supported exact carriers for large integers, never a rounded JS Number.\\n- Supported float source values that remain non-integral after reading retain initial kind today. Native negative zero and non-finite Numbers have float classification in Jing. This does not guarantee every reader/build route preserves their original spelling/sign, and does not certify subsequent bare host arithmetic: `1.5 + 0.5` can become an unboxed integral Number unless the operation reboxes it.\\n- Explicit executable guest construction, e.g. `(data/float64 1)` where the `data` module/profile is available, supplies float kind at runtime. It is an expression, not a substitute for a float literal inside quoted Data; changing quoted `1.0` into quoted `(data/float64 1)` changes the value into a list.\\n- Canonical float64 Data decoded from existing Jing artifacts, or explicitly boxed host values passed to VM/UAST interfaces that accept them, retain kind. They must continue through carrier-aware operations. Do not generalize this to `yang.clojure/compile`'s currently incomplete carrier recognition.\\n- Python/PHP/TS token-based float lowering already performs boxing. Its existing profile-specific tests and explicit prelude/runtime producer obligations continue to govern those paths; this Clojure defect is not evidence of a new defect in each of them.\\n\\n**Placement required in the future round:**\\n\\n1. Keep the authoritative numeric/producer contract in `docs/design/dao.jing.cbor.md` and add a cross-reference to the Clojure source boundary; do not redefine codec meaning to accommodate the frontend.\\n2. Put the Clojure source/forms limitation, selected repair, revision, migration, and capability matrix in `docs/design/yang.antlr.md` §8.8, alongside §8.5.5's existing float-producer precedent. There is no current `docs/design/yang.clojure.md`; do not cite a nonexistent document as the authority.\\n3. Reconcile portability assertions in `src/cljc/yang/docs/yang_implementation.md`, relevant VM/REPL public documentation, and the `read-forms`/compile API docstrings, including the forms-only boundary. `docs/design/yang.preludes.md` must retain the producer and profile obligations for shared preludes.\\n4. Correct `test/yang/clojure_collection_order_test.cljc`'s corpus comment/docstring: green non-integral replacement rows establish only that narrowed coverage. Identify this as a source-producer correctness dependency, link the archived failed row and this ruling, and remove the pending limitation only after the restored source and semantics gates pass. A corpus comment alone is not adequate public disclosure.\\n\\n## RULING 5 — Future fix-round contract; not dispatched\\n\\n**Scope:** preserve Clojure floating literal kind from source to Data/UAST, admit the existing carrier in the forms compiler, integrate actual source entry paths, close the affected producer gaps, version the frontend, and establish both semantic and content portability. No unrelated arithmetic redesign, float-key policy expansion, new persistent numeric annotation, global reader monkeypatch, codec change, silent legacy repair, or broad frontend/prelude refactor.\\n\\n**File boundaries for the future dispatch:**\\n\\n- `src/cljc/yang/clojure.cljc`: token-aware reading integration, carrier-aware `literal?`/`constant-form?` and preservation through quoting/lowering; a focused source/token module under `src/cljc/yang/clojure/` may be added. Do not bury lexical reconstruction in `compile-literal` after loss.\\n- `src/cljc/yin/repl.cljc` and `src/cljc/yin/repl/frontends.cljc`: original-source routing, matching manifest revision/profiles, shell/source separation, and equivalent REPL/preview paths. Audit `src/cljc/yin/repl/adapter.cljc` and the three demo readers (`src/cljs/datomworld/demo/{compilation_pipeline,continuation_stream,equation_plotter}.cljs`); migrate actual compilation callers or explicitly delimit their legacy raw-forms behavior. Do not gratuitously change an adapter that already forwards source intact.\\n- Audit `src/cljc/yang/core/{uast,defquoted}.cljc`, `src/cljc/yang/clojure/{prelude,core_impl,core_module}.cljc`, and Python/PHP/TS prelude/lowerer producers for retained kind. Changes there require a demonstrated producer gap. Their existing correct boxing is a control, not a reason to rewrite them.\\n- Tests: add a focused portable Clojure float/source test namespace; extend `test/yang/clojure_collection_order_test.cljc`, `test/yang/clojure_callsite_test.cljc`, relevant `test/yin/repl` reader/catalog/source tests, and `test/yang/clojure/stream_eval_test.cljc` as appropriate. Use `test/yin/vm/data_test.cljc`, `test/yin/vm/float_test.cljc`, Jing numeric tests, and Python/TS `float_address_test.cljc` as regression oracles; add the equivalent PHP producer check if missing.\\n- Documentation changes are the locations in RULING 4. Production codec/VM equality changes and upstream toolchain patches are outside this contract; a newly discovered need for them requires a separate architectural decision.\\n\\n**Required acceptance gates:**\\n\\n1. **Real source, not only hand-boxed fixtures.** Compile identical original strings on JVM and Node through both the frontend source entry and the standard REPL/catalog route. Cover `0.0`, `1.0`, `-1.0`, `1e0`, `1.5`, `-0.0`, integral floats at/beyond `2^53`, and a small positive floating token that rounds to zero. Integer `0`/`1`, exact-carrier large integers, and integer-shaped tokens are controls. Preserve source numeric categories; decimal `M`, ratio, or other unsupported categories must not be silently relabeled as binary floats to make this gate pass. Retain the existing supported grammar/refusal policy for those categories.\\n2. **Structural preservation.** Exercise top-level, binding/argument, vector, quoted/nested data, dynamic collection, and metadata paths. Test repeated equal-valued tokens at distinct positions; comments, strings, characters and discarded forms containing numeric-looking text must not be rewritten. Exercise macro-generated numeric Data. Prove that host map/set construction cannot silently discard a source occurrence because kind was erased. Where float keys/elements are prohibited by a profile, require the same explicit refusal on both hosts; this gate must not expand key support accidentally.\\n3. **Restore the corpus honestly.** Restore integral floats to the common cross-host collection corpus using explicit carriers for intentionally programmatic Data fixtures, and add an equivalent unmodified-source-string case through the fixed frontend. Merely wrapping the fixture while leaving source reading broken is not closure. Include integer/float distinctions in root, complete occurrence-key vector, complete C1 relation, and semantic/stack/register instruction-provenance comparisons. Keep permutation, metadata, duplicate-occurrence, effect-order and collision controls. Compare against one recorded common reference, not independently regenerated expectations on each host.\\n4. **Runtime semantics oracle, independently of digests.** Through exported VM Data operations and actual compiled execution, require `data/equiv(float64(1), 1) = false`, nested `[float64(1)]` versus `[1] = false`, and float/float equality = true. In the selected Clojure library profile, `inc`/`dec` of floating input must take floating behavior and return float kind even when the value is integral; integer input must retain integer behavior. Check `float64?`/integer predicates and result bits, not printed numbers alone. Verify integer key admission versus floating refusal, including nested key Data and guest collection-policy behavior. Preserve signed-zero and NaN distinctions for both `data/equiv` and `content=`. Add a test mutation/control that dropping boxing fails the semantic oracle as well as the digest gate.\\n   Also execute supported floating `+`/`-`/`*` and comparisons through the actual repaired default/catalog path and linked path, including a non-integral-to-integral result. Record the primitive/profile bindings used. Direct `float/add` tests alone cannot certify a source path still calling raw host `+`; source `=` must be tested against its selected language/profile contract rather than assumed synonymous with `data/equiv`.\\n5. **API/build boundary.** Compile explicit Float64 forms directly on Node, nested and quoted, and execute/serialize them; integer Number controls must remain integers. Exercise actual prelude emission and pin its contents across hosts. A JVM-side audit must detect forbidden integral Double constants in host-quoted prelude producers before JS can erase them. Test a float-producing operation whose result is integral crossing a snapshot/continuation boundary to ensure the producer obligation is not restricted to source literals.\\n6. **Cross-host artifacts and legacy custody.** Produce representative repaired float artifacts on JVM and Node; decode, re-encode and execute them across supported VM hosts (JVM, Node, Dart, Jolt), comparing kind, value, refusal behavior and canonical identity. Test compilation from explicit carrier forms on forms-capable hosts; do not label Dart/Jolt execution of relayed source as native source parsing. Archive genuine pre-fix JS integer-bearing bytes and pre-fix JVM float-bearing bytes, then load/execute those bytes under the new system without recompilation. Verify both keep their historical meanings and new compilation produces a distinct corrected JS artifact. An old artifact synthesized by the new compiler is not legacy evidence.\\n7. **Profiles and revisions.** Assert the repaired Clojure manifest revision/profile, unchanged Jing/UAST/bytecode/C1 versions, correct source/forms capability claims, and immutable old pins. Check that already-correct Python/PHP/TS numeric producers and unselected native profiles retain expected artifacts. If a shared runtime closure changes, require the impacted profile's descriptor/runtime/derivation pins to reconcile and cold linked execution to pass. Selected profiles must not silently receive a new runtime under an old pin.\\n\\n**Re-pin only after these gates explain the change:** new Clojure frontend/lowering/support identities and parser implementation provenance; changed parsed-input/UAST/bytecode roots; complete corpus key/C1/provenance references; affected module/prelude manifests and transitive dependency/profile pins; changed program/snapshot fixtures and any active cc4 measurement snapshot actually containing changed artifacts. Preserve old references and the r3 failed evidence as historical records. Do not overwrite the `c1-1` legacy fixture or relabel historical cc4 measurements. A new compiler's measurements need their own source/profile pins; unchanged budgets are not automatically re-certified by a new address.\\n\\nRun focused failing gates first, then affected compiler/REPL/VM and producer regressions according to the repository's test ladder. The four-host evidence must state which work was source reading, forms compilation, artifact loading, and execution. A skipped or unavailable host is an open acceptance item, not a pass. No full suite or remote job is launched by this ruling.\\n\\n## Verification performed and limits\\n\\nThis is a read-only architectural investigation plus this findings file. I inspected current source, locally installed upstream reader source, the r3 raw failure log, and the r2 ruling. I ran bounded JVM expressions using the existing cached classpath, without rebuilding: `yang.clojure/read-forms` returns Long for `1`, Double for `1.0`, `0.0`, `1e0`, `-0.0`, `1.5`, and `9007199254740992.0`. For `1.0`, exported `data/equiv` against integer 1 is false, `admit-key?` is false, and `content=` against integer 1 is false; integer 1 yields true for those three checks. These establish the live JVM side of the defect.\\n\\nA second bounded JVM probe returned `{:integer-equiv-float false, :nested-equiv false, :integer-key true, :float-key false, :signed-zero-equiv true, :signed-zero-content false}` through the exported Data module. Both JVM probes exited successfully; no suite was run.\\n\\nI also loaded only the existing cached Node bootstrap dependencies in memory, stopping before the REPL main entry. Both `cljs.tools.reader` and `cljs.reader` return the same bare Number for `1`, `1.0`, and `1e0`; cached Jing classifies them as integer and gives them equal content. Negative zero remains floating; `1.5` remains floating. The unsafe integral float probe reaches the expected unsupported-value refusal. These cached JS artifacts are older than current source: an attempted exported `data/equiv` probe found that export absent in the cache. Consequently I do **not** claim a freshly built Node VM-semantic suite or current four-host execution result. The current JS semantic consequence is derived from the checked-in portable Data/dispatch code, not represented as a green Node test. The earlier probe's refusal terminated its final row; it was not a complete test run.\\n\\nNo production code, tests, dependency configuration, published pins, Git index/refs, or historical evidence were changed. Existing unrelated working-tree files were left alone. The owner/orchestrator must authorize a future fix round before implementation begins.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n19:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"ssh jupiter.stigmergy.systems 'cd ~/ci/datomworld-floatkind && git rev-parse HEAD && git status --porcelain -uno && git ls-remote origin refs/heads/fix/float-kind-portability refs/heads/master && git log -5 --oneline && git show --stat f091597e'\\\"\",\"aggregated_output\":\"f091597e1404c3cb8a1e88e780812ef1167572c4\\nf091597e1404c3cb8a1e88e780812ef1167572c4\\trefs/heads/fix/float-kind-portability\\n685d47bd36e20eb00458e11bf0e8f01f78c7917e\\trefs/heads/master\\nf091597e fix(floatkind): r2 — sign-off blockers B-2..B-7 resolved (RED->GREEN, four hosts)\\n93f95f1c fix(floatkind): B-1 — restore the ns :require opener deleted by the D-2 sed (sign-off 1795709372000)\\n6a7fb586 docs(collab): float-kind r1 review chain — deepseek APPROVE + D-1/D-2 dispositions applied\\n42b8cfc6 Merge remote-tracking branch 'origin/fix/float-kind-portability' into HEAD\\n3b850212 fix(yang): preserve Clojure float-literal kind across hosts — ruling 1795693415000 (r1)\\ncommit f091597e1404c3cb8a1e88e780812ef1167572c4\\nAuthor: Sonny To <son.c.to@gmail.com>\\nDate:   Thu Nov 26 12:17:43 2026 -0500\\n\\n    fix(floatkind): r2 — sign-off blockers B-2..B-7 resolved (RED->GREEN, four hosts)\\n    \\n    B-2 reader sequence presence (not truthiness): false/nil elements and keys\\n    survive at every position. B-3 variadic clj-= via (seq more): (= 1 1 false)\\n    is false; clj-!= correct negation. B-4 discard moved to parse control state\\n    [:discard nil end-i] vs [:value ...] — :yang.clojure.reader/discard and all\\n    guest literals representable. B-5 capture-avoiding FnArgRef placeholders +\\n    fresh-param-sym substitution (4-vs-12 counterexample fixed, deterministic\\n    canonical output). B-6 grammar regressions restored: apostrophe-in-symbol,\\n    portable syntax-quote (scalar/collection, ~ ~@ foo# auto-gensym, metadata),\\n    #^ #< @x — verified on a 33-case differential corpus vs tools.reader.\\n    B-7 gate-5 pre-pause integral float across continuation + snapshot.\\n    \\n    Gates: JVM 28/587 + 2/22 + regressions 306/3500 all green; Node 30/605 +\\n    178/2137; Dart 69/69; Jolt float-kind 27t 75/75 + php 45/45 + vm.float\\n    108/108 + corpus RC=0; kondo 0 errors 0 warnings r1/r2 files. B-1 stayed\\n    fixed (93f95f1c). RED evidence per blocker in floatkind-evidence.\\n\\n ...at-kind-corrections-r2.gemini-4-neon.stdout.log |    2 +\\n ...08000-engineer-float-kind-corrections.prompt.md |   27 +\\n collab/yang-clojure/1795710308000-r2.rc            |    1 +\\n .../green-dart-gates.log                           |  167 +++\\n .../green-demo-build.log                           |    3 +\\n .../green-jolt-corpus.log                          |    2 +\\n .../green-jolt-gates.log                           |   85 ++\\n .../green-jvm-all7gates.log                        |   20 +\\n .../green-jvm-regressions.log                      |   37 +\\n .../green-node-all7gates.log                       |    9 +\\n .../green-node-compile.log                         |   35 +\\n .../green-node-regressions.log                     |   30 +\\n .../green-node-repl-post-hint.log                  |    9 +\\n .../1795710808000-floatkind-evidence/kondo.log     |    8 +\\n .../red-jvm-b2-b7.log                              | 1381 ++++++++++++++++++++\\n .../red-node-b2-b7.log                             |  545 ++++++++\\n .../red-node-compile.log                           |   35 +\\n ...t-kind-corrections-r2.gemini-4-neon.findings.md |   82 ++\\n src/cljc/yang/clojure/numeric.cljc                 |   11 +-\\n src/cljc/yang/clojure/reader.cljc                  |  415 ++++--\\n test/yang/clojure_float_kind_test.cljc             |  442 ++++++-\\n 21 files changed, 3258 insertions(+), 88 deletions(-)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n27:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"ssh jupiter.stigmergy.systems 'cd ~/ci/datomworld-floatkind && cat test/yang/clojure_float_kind_test.cljc && cat collab/yang-clojure/1795710808000-floatkind-evidence/green-jvm-regressions.log'\\\"\",\"aggregated_output\":\"(ns yang.clojure-float-kind-test\\n  \\\"Float-kind portability r1 (architect ruling 1795693415000, RULING 5):\\n   the seven acceptance gates of Clojure floating-literal kind preservation\\n   from source to Data/UAST - real-source kind through the frontend source\\n   entry and the standard REPL/catalog route, structural and lexical\\n   preservation, the runtime semantics oracle independent of digests, the\\n   API/build carrier boundary, cross-host artifact and legacy custody, and\\n   the profile/revision claims.\\n\\n   The reader under test is the frontend's own source entry\\n   (yang.clojure/read-forms), the same one the standard catalog installs,\\n   so a green gate here is a claim about the shipped frontend, not about a\\n   test-private reader. The REPL-route gates run where the shell runs\\n   (JVM and Node); the artifact gates run on every host that can load this\\n   namespace.\\\"\\n            (:require [clojure.test :refer [deftest is testing]]\\n            [dao.host.bytes :as bytes]\\n            [dao.host.integer :as integer-host]\\n            [dao.jing :as jing]\\n            [dao.jing.cbor :as cbor]\\n            [dao.stream :as stream]\\n            [dao.stream.base64 :as base64]\\n            [yang.clojure :as yang]\\n            [yang.clojure.numeric :as clj-numeric]\\n            [yang.clojure.prelude]\\n            [yang.frontend :as frontend]\\n            [yin.repl :as repl]\\n            [yin.repl.frontends :as frontends]\\n            [yin.vm :as vm]\\n            [yin.vm.ast-walker :as ast-walker]\\n            [yin.vm.data :as data]\\n            [yin.vm.module :as module]\\n            [yin.vm.test-utils :as tu]\\n            #?@(:jolt []\\n                :cljd [[\\\"dart:io\\\" :as dart-io]]\\n                :clj [[clojure.java.io :as io]\\n                      [clojure.tools.reader :as tools-reader]\\n                      [clojure.tools.reader.reader-types :as tools-rt]\\n                      [clojure.walk :as walk]\\n                      [dao.stream.ringbuffer :as ringbuffer]\\n                      [yang.clojure.core-impl]\\n                      [yang.python.antlr.clj-runtime]\\n                      [yin.vm.semantic :as sr]\\n                      [yin.vm.semantic.code :as semantic-code]\\n                      [yin.vm.semantic.linearize :as semantic-linearize]\\n                      [yin.vm.ucf.rows :as ucf-rows]]\\n                :cljs [[cljs.tools.reader :as tools-reader]\\n                       [cljs.tools.reader.reader-types :as tools-rt]\\n                       [dao.stream.ringbuffer :as ringbuffer]\\n                       [yin.vm.semantic :as sr]\\n                       [yin.vm.semantic.code :as semantic-code]\\n                       [yin.vm.semantic.linearize :as semantic-linearize]\\n                       [yin.vm.ucf.rows :as ucf-rows]])))\\n\\n\\n;; =============================================================================\\n;; Shared helpers\\n;; =============================================================================\\n\\n(def ^:private data-equiv\\n  \\\"The exported kind-strict Data equivalence predicate.\\\"\\n  (get data/data-module 'equiv))\\n\\n(declare run-library)\\n\\n\\n(defn- read-one\\n  \\\"The single form of `source` through the frontend source entry.\\\"\\n  [source]\\n  (first (yang/read-forms source)))\\n\\n\\n(defn- compiled-value\\n  \\\"The literal :value of the compiled single form of `source`.\\\"\\n  [source]\\n  (:value (yang/compile (read-one source))))\\n\\n\\n(defn- run-ast\\n  \\\"Run compiled `ast` on the ast-walker with the plain registry.\\\"\\n  [ast]\\n  (-> (tu/create-vm {:primitives vm/primitives\\n                     :make-stream tu/make-stream\\n                     :capability-secret tu/secret})\\n      (vm/eval ast)\\n      vm/value))\\n\\n\\n(defn- semantic-root\\n  \\\"The canonical semantic-bytecode root of the compiled form of `source`.\\\"\\n  [source]\\n  (:root (vm/ast->semantic-bytecode (yang/compile (read-one source)))))\\n\\n\\n(defn- host-read-file\\n  [path]\\n  #?(:jolt nil\\n     :cljd (.readAsBytesSync (dart-io/File. path))\\n     :clj (java.nio.file.Files/readAllBytes (.toPath (io/file path)))\\n     :cljs (.readFileSync (js/require \\\"fs\\\") path)\\n     :default nil))\\n\\n\\n(def ^:private repl-route?\\n  \\\"The REPL/catalog source-reading route runs where the source reader ships\\n   (JVM and Node); the Dart and Jolt legs exercise carrier compilation,\\n   cross-host artifact loading/execution, legacy custody, and capability claims.\\\"\\n  #?(:jolt false :cljd false :clj true :cljs true :default false))\\n\\n\\n(defn- drain-result\\n  \\\"The :repl/result value of a shell's output medium, oldest first.\\\"\\n  [state]\\n  (let [output (:output-stream state)\\n        cursor (:dao.stream/cursor (stream/cursor output :dao.stream/oldest))]\\n    (loop [cursor cursor, value ::none]\\n      (let [step (stream/next output cursor)]\\n        (if (= :dao.stream/ok (:dao.stream/outcome step))\\n          (let [v (:dao.stream/value step)]\\n            (if (= :repl/result (:type v))\\n              (recur (:dao.stream/cursor step) (:value v))\\n              (recur (:dao.stream/cursor step) value)))\\n          value)))))\\n\\n\\n(defn- repl-session-result\\n  \\\"The result value of evaluating `line` through the standard REPL/catalog\\n  route (the frontends the shell installs), semantic VM.\\\"\\n  [line]\\n  #?(:jolt nil\\n     :cljd nil\\n     :clj (drain-result (first (repl/eval-input (frontends/create-state {:vm-type :semantic}) line)))\\n     :cljs (drain-result (first (repl/eval-input (frontends/create-state {:vm-type :semantic}) line)))\\n     :default nil))\\n\\n\\n(defn- repl-text\\n  \\\"The shell text of evaluating `line` through the standard route.\\\"\\n  [line]\\n  #?(:jolt nil\\n     :cljd nil\\n     :clj (second (repl/eval-input (frontends/create-state {:vm-type :semantic}) line))\\n     :cljs (second (repl/eval-input (frontends/create-state {:vm-type :semantic}) line))\\n     :default nil))\\n\\n\\n;; =============================================================================\\n;; GATE 1 - real source strings, every supported numeric category\\n;; =============================================================================\\n\\n\\n(def ^:private float-tokens\\n  \\\"Every binary-floating token class the ruling names: integral floats at\\n   0, 1, -1, at and beyond 2^53, exponent spellings, negative zero, a\\n   small positive token that rounds to zero (underflow), and a value at\\n   the top of the range. [token expected-double-bits-hex].\\\"\\n  [[\\\"0.0\\\" \\\"0000000000000000\\\"]\\n   [\\\"1.0\\\" \\\"3ff0000000000000\\\"]\\n   [\\\"-1.0\\\" \\\"bff0000000000000\\\"]\\n   [\\\"1e0\\\" \\\"3ff0000000000000\\\"]\\n   [\\\"1.5\\\" \\\"3ff8000000000000\\\"]\\n   [\\\"-0.0\\\" \\\"8000000000000000\\\"]\\n   [\\\"9007199254740992.0\\\" \\\"4340000000000000\\\"]\\n   [\\\"9007199254740994.0\\\" \\\"4340000000000001\\\"]\\n   [\\\"1e19\\\" \\\"43e158e460913d00\\\"]\\n   [\\\"1.5e-5\\\" \\\"3eef75104d551d69\\\"]\\n   [\\\"5e-324\\\" \\\"0000000000000001\\\"]\\n   [\\\"1e-400\\\" \\\"0000000000000000\\\"]\\n   [\\\"2.\\\" \\\"4000000000000000\\\"]\\n   [\\\"+1.5\\\" \\\"3ff8000000000000\\\"]\\n   [\\\"1E5\\\" \\\"40f86a0000000000\\\"]])\\n\\n\\n(def ^:private integer-tokens\\n  \\\"Integer controls: plain, signed, radix, octal, and the N-suffixed big\\n   integer (the exact carrier). [token expected-value].\\\"\\n  [[\\\"0\\\" 0] [\\\"1\\\" 1] [\\\"-1\\\" -1] [\\\"+7\\\" 7] [\\\"42\\\" 42]\\n   [\\\"0x10\\\" 16] [\\\"017\\\" 15] [\\\"2r101\\\" 5] [\\\"36rZZ\\\" 1295]\\n   [\\\"9007199254740991\\\" 9007199254740991]])\\n\\n\\n(defn- host-bits-of\\n  \\\"The IEEE-754 bits of float64 content `x`, 16 lowercase hex digits.\\\"\\n  [x]\\n  #?(:jolt nil\\n     :cljd nil\\n     :clj (String/format \\\"%016x\\\" (into-array Object [(Double/doubleToLongBits (double (data/float-value x)))]))\\n     :cljs (let [v (data/float-value x)\\n                 buf (js/ArrayBuffer. 8)\\n                 view (js/DataView. buf)]\\n             (.setFloat64 view 0 v false)\\n             (let [out (atom \\\"\\\")]\\n               (dotimes [i 8]\\n                 (let [b (.getUint8 view i)]\\n                   (reset! out (str @out (when (< b 16) \\\"0\\\") (.toString b 16)))))\\n               @out))\\n     :default nil))\\n\\n\\n(deftest gate1-float-tokens-are-float64-content\\n  (when repl-route?\\n    (testing \\\"every binary-floating token reads and compiles as float64 content\\\"\\n      (doseq [[token bits] float-tokens]\\n        (testing token\\n          (let [value (compiled-value token)]\\n            (is (cbor/float64? value)\\n                (str token \\\" must be float64 content, read \\\" (pr-str value)))\\n            (is (= bits (host-bits-of value))\\n                (str token \\\" must carry exactly these IEEE bits\\\"))))))))\\n\\n\\n(deftest gate1-integer-tokens-stay-exact-integers\\n  (when repl-route?\\n    (testing \\\"integer controls keep integer kind and value\\\"\\n      (doseq [[token expected] integer-tokens]\\n        (testing token\\n          (let [value (compiled-value token)]\\n            (is (integer-host/exact-integer? value)\\n                (str token \\\" must be exact-integer content, read \\\" (pr-str value)))\\n            (is (data-equiv expected value)\\n                (str token \\\" must read as \\\" expected))))))\\n    (testing \\\"big integers keep the exact big carrier\\\"\\n      (let [value (compiled-value \\\"9223372036854775808000N\\\")\\n            expected (integer-host/demote (integer-host/parse-decimal \\\"9223372036854775808000\\\"))]\\n        (is (integer-host/big-carrier? value)\\n            \\\"an N-suffixed token is exact big-integer content, never a rounded number\\\")\\n        (is (data-equiv expected value))\\n        (is (not (cbor/float64? value)))))))\\n\\n\\n(deftest gate1-unsupported-categories-not-relabeled\\n  (when repl-route?\\n    (testing \\\"ratio tokens stay ratio content\\\"\\n      (let [value (compiled-value \\\"1/2\\\")]\\n        (is (cbor/ratio? value)\\n            (str \\\"1/2 must stay ratio content, read \\\" (pr-str value)))\\n        (is (not (cbor/float64? value)))))\\n    (testing \\\"decimal M tokens stay decimal content\\\"\\n      (doseq [token [\\\"1M\\\" \\\"10.03M\\\" \\\"-2.5M\\\"]]\\n        (let [value (compiled-value token)]\\n          (is (cbor/decimal? value)\\n              (str token \\\" must stay decimal content, read \\\" (pr-str value)))\\n          (is (not (cbor/float64? value))))))\\n    (testing \\\"invalid numeric tokens are refused, not guessed\\\"\\n      (doseq [token [\\\"1.2.3\\\" \\\"08\\\" \\\"0x\\\" \\\"1e\\\" \\\"2r\\\"]]\\n        (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                     (yang/read-forms token))\\n            (str token \\\" must be a reader refusal\\\"))))))\\n\\n\\n(def ^:private token-digest-reference\\n  \\\"The recorded cross-host reference: the content hash of the canonical\\n   bytes of each token's read form, verified bit-identical on JVM and Node\\n   under the repaired frontend-owned reader (c1-3).\\\"\\n  {\\\"0.0\\\" \\\"4f3fd1e3c562a4c8690929fb1fd3b8e607d7d604bffdd4d5a406c737b735e578\\\"\\n   \\\"1.0\\\" \\\"1962a94c09507f12a3de739a3f584ce18ffbca152f16ebfb82ea15f3a650e90b\\\"\\n   \\\"1\\\" \\\"48fc721fbbc172e0925fa27af1671de225ba927134802998b10a1568a188652b\\\"\\n   \\\"1/2\\\" \\\"598aa35607a7350acc43a2ea659e1c94e8a8738705131d7670170d9a6a8b0b83\\\"\\n   \\\"1M\\\" \\\"28d6a5ec777e7e798d4be8e68242b049bc8794be9c3f6577f0af4451b0e0d05f\\\"})\\n\\n\\n(deftest gate1-cross-host-canonical-identity\\n  (when repl-route?\\n    (testing \\\"identical source mints identical canonical bytes on every host\\\"\\n      (doseq [[token expected] token-digest-reference]\\n        (testing token\\n          (is (not= \\\"unrecorded\\\" expected) \\\"reference recorded during the green round\\\")\\n          (is (= expected (jing/content-hash (read-one token)))))))\\n    (testing \\\"the float64 and integer tokens of one value mint distinct bytes\\\"\\n      (is (not= (semantic-root \\\"1\\\") (semantic-root \\\"1.0\\\")))\\n      (is (not= (semantic-root \\\"0\\\") (semantic-root \\\"-0.0\\\"))))))\\n\\n\\n;; =============================================================================\\n;; GATE 2 - structural and lexical preservation\\n;; =============================================================================\\n\\n\\n(deftest gate2-floats-preserve-through-structure\\n  (when repl-route?\\n    (testing \\\"every structural position keeps the token's kind\\\"\\n      (let [let-form (read-one \\\"(let [x 1.0] x)\\\")\\n            positions {\\\"top level\\\" (read-one \\\"1.0\\\")\\n                       \\\"let binding\\\" (nth (nth let-form 1) 1)\\n                       \\\"vector element\\\" (nth (read-one \\\"[1.0 2]\\\") 0)\\n                       \\\"quoted data\\\" (nth (nth (read-one \\\"(quote [1.0 1])\\\") 1) 0)\\n                       \\\"nested quoted\\\" (nth (get (nth (read-one \\\"'{:a [1.0]}\\\") 1) :a) 0)\\n                       \\\"map value\\\" (nth (vals (read-one \\\"{:a 1.0}\\\")) 0)\\n                       \\\"set element\\\" (first (read-one \\\"#{1.0}\\\"))\\n                       \\\"call argument\\\" (nth (read-one \\\"(f 1.0)\\\") 1)}]\\n        (doseq [[label form] positions]\\n          (testing label\\n            (is (cbor/float64? form) (str label \\\" keeps float64 kind\\\"))))))\\n    (testing \\\"compiled literal payloads keep the carrier\\\"\\n      (is (cbor/float64? (first (compiled-value \\\"(quote [1.0 1])\\\"))))\\n      (is (cbor/float64? (first (compiled-value \\\"[1.0]\\\"))))\\n      (is (integer-host/exact-integer?\\n            (second (:value (yang/compile (read-one \\\"[1.0 2]\\\")))))))\\n    (testing \\\"repeated equal-valued tokens keep one occurrence each\\\"\\n      (let [ast (yang/compile (read-one \\\"(quote [0.0 0.0 0.0])\\\"))]\\n        (is (= 3 (count (:value ast)))))\\n      (let [ast (yang/compile (read-one \\\"(f 1.0 1.0 1.0)\\\"))]\\n        (is (= 3 (count (:operands ast))))\\n        (is (every? cbor/float64? (map :value (:operands ast))))))))\\n\\n\\n(deftest gate2-lexical-contexts-are-not-floats\\n  (when repl-route?\\n    (testing \\\"numeric-looking text in non-numeric lexical contexts stays itself\\\"\\n      (is (= \\\"1.0\\\" (read-one (str (char 34) \\\"1.0\\\" (char 34)))) \\\"string content\\\")\\n      (is (= 42 (read-one \\\";; 1.0 is a float in a comment\\\\n42\\\")) \\\"comment skipped\\\")\\n      (is (= 7 (read-one \\\"#_1.0 7\\\")) \\\"discarded form skipped\\\")\\n      (is (= 8 (read-one \\\"#_[1.0 #_{2.0 3.0} 4.0] 8\\\")) \\\"nested discard skipped\\\")\\n      (let [forms (yang/read-forms \\\"1.0 #_ (+ 1.0 2.0) 42\\\")]\\n        (is (= 2 (count forms)) \\\"discard of a whole expression\\\")\\n        (is (cbor/float64? (first forms)))\\n        (is (= 42 (second forms)))))\\n    (testing \\\"metadata reads and attaches\\\"\\n      (is (= {:m true} (meta (read-one \\\"^:m [1.0]\\\"))))\\n      (is (= {:a 1} (meta (read-one \\\"^{:a 1} x\\\")))))\\n    (testing \\\"reader conditionals keep the explicit refusal\\\"\\n      (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                   (yang/read-forms \\\"#?(:clj 1 :cljs 2)\\\")))\\n      (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                   (yang/read-forms \\\"#?@(:clj [1])\\\"))))))\\n\\n\\n(deftest gate2-equal-valued-occurrences-not-coalesced\\n  (when repl-route?\\n    (testing \\\"a host map cannot discard the 1.0 occurrence of a 1 key\\\"\\n      (let [m (read-one \\\"{1 :a 1.0 :b}\\\")]\\n        (is (= 2 (count m)) \\\"both the integer and float key survive reading\\\")\\n        (is (= :a (get m 1)))\\n        (is (= :b (get m (compiled-value \\\"1.0\\\"))))))\\n    (testing \\\"a host set keeps both members\\\"\\n      (let [s (read-one \\\"#{1 1.0}\\\")]\\n        (is (= 2 (count s)))))\\n    (testing \\\"compiled constants keep both occurrences\\\"\\n      (let [ast (yang/compile (read-one \\\"{1 :a 1.0 :b}\\\"))]\\n        (is (= 2 (count (:value ast))))\\n        (is (= 1 (count (filter cbor/float64? (keys (:value ast))))))))))\\n\\n\\n(deftest gate2-float-key-policy-parity\\n  (when repl-route?\\n    (testing \\\"constant float data is quoted data; library float keys refuse alike\\\"\\n      (is (cbor/float64? (first (keys (compiled-value \\\"{1.0 :a}\\\"))))\\n          \\\"a constant map literal with a float key is quoted data\\\")\\n      (let [[status err] (run-library (yang/read-forms \\\"(assoc {} 1.0 :a)\\\"))\\n            [nstatus nerr] (run-library (yang/read-forms \\\"(assoc {} [1.0] :a)\\\"))\\n            [ok-status ok-val] (run-library (yang/read-forms \\\"(assoc {} 1 :a)\\\"))]\\n        (is (= :yin.k/error status)\\n            \\\"a dynamic float key hits the collection-key refusal on this host\\\")\\n        (is (= :coll/unsupported-key (:clj/policy err)))\\n        (is (= :yin.k/error nstatus)\\n            \\\"a nested float key hits the collection-key refusal on this host\\\")\\n        (is (= :coll/unsupported-key (:clj/policy nerr)))\\n        (is (= :yin.k/ok ok-status)\\n            \\\"an integer key is admitted\\\")\\n        (is (= {1 :a} ok-val))))))\\n\\n\\n(deftest gate2-macro-generated-numeric-data\\n  (when repl-route?\\n    (testing \\\"a macro returning a source float keeps its kind through expansion\\\"\\n      (let [s0 (frontends/create-state {:vm-type :semantic})\\n            [s1 _] (repl/eval-input s0 \\\"(defmacro fm [] (yin/literal 1.0))\\\")\\n            [s2 _] (repl/eval-input s1 \\\"(fm)\\\")\\n            res (drain-result s2)]\\n        (is (cbor/float64? res) (str \\\"macro result must be float64, got \\\" (pr-str res)))\\n        (is (= 1.0 (data/float-value res)))))))\\n\\n\\n;; =============================================================================\\n;; GATE 4 - the runtime semantics oracle, independent of digests\\n;; =============================================================================\\n\\n\\n(def library-registry\\n  \\\"The guest-library registry: the data/float/integer host modules and the\\n   kind surface - the profile the clojure library runs on.\\\"\\n  (-> (module/default-registry)\\n      module/register-cell-module\\n      (data/register-data-module {::data/max-items 1048576})\\n      (yang.clojure.prelude/admit)))\\n\\n\\n(defn- run-library\\n  \\\"Run `forms` under the bundled library profile (the outcome lane over the\\n   full profile registry), answering the outcome's value.\\\"\\n  [forms]\\n  (let [ast (yang/compile-program\\n              forms true\\n              {:convention :arg-vector\\n               :outcomes true\\n               :native (set (keys vm/primitives))})]\\n    (-> (tu/make-observer-session\\n          (tu/create-vm {:modules library-registry\\n                         :make-stream tu/make-stream\\n                         :capability-secret tu/secret}))\\n        (tu/queue-ast! ast)\\n        tu/run-session\\n        :consumer\\n        vm/value)))\\n\\n\\n(deftest gate4-data-oracle\\n  (testing \\\"exported Data operations are kind-strict\\\"\\n    (let [dataf (fn [op & args] (apply (get data/data-module op) args))]\\n      (is (false? (dataf 'equiv (data/float64 1) 1)))\\n      (is (false? (dataf 'equiv [(data/float64 1)] [1])))\\n      (is (true? (dataf 'equiv (data/float64 1) (data/float64 1))))\\n      (is (true? (dataf 'equiv 1 1)))\\n      (is (false? (dataf 'admit-key? (data/float64 1))))\\n      (is (true? (dataf 'admit-key? 1)))\\n      (is (false? (dataf 'content= (data/float64 0.0) (data/float64 -0.0))))\\n      (is (true? (dataf 'equiv (data/float64 0.0) (data/float64 -0.0))))\\n      (is (false? (dataf 'equiv (data/float64 ##NaN) (data/float64 ##NaN))))\\n      (is (true? (dataf 'content= (data/float64 ##NaN) (data/float64 ##NaN)))))))\\n\\n\\n(deftest gate4-library-inc-dec-float-behavior\\n  (testing \\\"inc/dec of floating carrier input take the floating branch on every host\\\"\\n    (let [[ok-up one-up] (run-library [(list 'inc (data/float64 1.0))])\\n          [ok-down one-down] (run-library [(list 'dec (data/float64 2.0))])\\n          [ok-int iv] (run-library [(list 'inc 1)])]\\n      (is (= :yin.k/ok ok-up))\\n      (is (cbor/float64? one-up) \\\"inc of float64 1.0 returns float kind\\\")\\n      (is (= 2.0 (data/float-value one-up)))\\n      (is (= :yin.k/ok ok-down))\\n      (is (cbor/float64? one-down))\\n      (is (= 1.0 (data/float-value one-down)))\\n      (is (= :yin.k/ok ok-int))\\n      (is (integer-host/exact-integer? iv))\\n      (is (data-equiv 2 iv))\\n      (is (not (cbor/float64? iv)))))\\n  (when repl-route?\\n    (testing \\\"inc/dec of source floating input take the floating branch\\\"\\n      (let [[ok-up one-up] (run-library (yang/read-forms \\\"(inc 1.0)\\\"))\\n            [ok-down one-down] (run-library (yang/read-forms \\\"(dec 2.0)\\\"))]\\n        (is (= :yin.k/ok ok-up))\\n        (is (cbor/float64? one-up) \\\"inc of 1.0 returns float kind\\\")\\n        (is (= 2.0 (data/float-value one-up)))\\n        (is (= :yin.k/ok ok-down))\\n        (is (cbor/float64? one-down))\\n        (is (= 1.0 (data/float-value one-down)))))\\n    (testing \\\"source integer input keeps integer behavior\\\"\\n      (let [[ok v] (run-library (yang/read-forms \\\"(inc 1)\\\"))]\\n        (is (= :yin.k/ok ok))\\n        (is (integer-host/exact-integer? v))\\n        (is (data-equiv 2 v))\\n        (is (not (cbor/float64? v)))))))\\n\\n\\n(deftest gate4-repl-arithmetic-reboxed\\n  (when repl-route?\\n    (testing \\\"the repaired default/catalog route computes in float kind\\\"\\n      (let [cases {\\\"(+ 1.5 1.5)\\\" 3.0\\n                   \\\"(+ 1.0 2.0)\\\" 3.0\\n                   \\\"(* 2.5 2.0)\\\" 5.0\\n                   \\\"(- 1.0 4.0)\\\" -3.0\\n                   \\\"(+ 1 0.5)\\\" 1.5}]\\n        (doseq [[line expected] cases]\\n          (testing line\\n            (let [value (repl-session-result line)]\\n              (is (cbor/float64? value)\\n                  (str line \\\" must answer float kind, got \\\" (pr-str value)))\\n              (is (= expected (data/float-value value)))))))\\n      (is (true? (repl-session-result \\\"(< 1.0 2)\\\")))\\n      (is (false? (repl-session-result \\\"(< 2.5 2.5)\\\")))\\n      (is (true? (repl-session-result \\\"(<= 2.5 2.5)\\\")))\\n      (is (true? (repl-session-result \\\"(> 0.5 0.25)\\\")))\\n      (is (false? (repl-session-result \\\"(= 1.0 1)\\\"))\\n          \\\"source = stays kind-strict numeric equality\\\")\\n      (is (true? (repl-session-result \\\"(= 1.5 1.5)\\\")))\\n      (is (true? (repl-session-result \\\"(== 1.0 1)\\\"))\\n          \\\"source == is Clojure's cross-kind numeric equality\\\")\\n      (is (false? (repl-session-result \\\"(= [1.0] [1])\\\")))\\n      (is (true? (repl-session-result \\\"(= [1.0 2.0] [1.0 2.0])\\\"))))))\\n\\n\\n(deftest gate4-repl-literal-kind-through-the-catalog\\n  (when repl-route?\\n    (is (cbor/float64? (repl-session-result \\\"1.0\\\")))\\n    (is (integer-host/exact-integer? (repl-session-result \\\"1\\\")))\\n    (is (cbor/float64? (repl-session-result \\\"-0.0\\\")))\\n    (is (= 1.0 (data/float-value (repl-session-result \\\"1.0\\\"))))\\n    (is (= \\\"1.0\\\" (repl-text \\\"1.0\\\")) \\\"the shell renders the float as a float\\\")\\n    (is (= \\\"-0.0\\\" (repl-text \\\"-0.0\\\")) \\\"signed zero renders signed\\\")))\\n\\n\\n(deftest gate4-unboxed-control-distinguishes\\n  \\\"The control proving the oracle catches dropped boxing: the same value\\n   compiled from an unboxed host literal instead of the token-preserving\\n   reader must answer the INTEGER behavior on the host where a bare\\n   integral Number is an integer (JS), while the repaired source path\\n   answers float. The collapsed path cannot pass this oracle.\\\"\\n  (testing \\\"the unboxed control\\\"\\n    #?(:jolt nil\\n       :cljd nil\\n       :cljs\\n       (let [unboxed (run-ast (yang/compile 1.0))\\n             boxed (run-ast (yang/compile (read-one \\\"1.0\\\")))]\\n         (is (integer-host/exact-integer? unboxed)\\n             \\\"an unboxed integral literal on JS IS integer content - the defect\\\")\\n         (is (cbor/float64? boxed) \\\"the source path answers float kind\\\")\\n         (is (not (data-equiv unboxed boxed)))\\n         (is (not= (:root (vm/ast->semantic-bytecode (yang/compile 1.0)))\\n                   (semantic-root \\\"1.0\\\"))\\n             \\\"the digest gate distinguishes them too\\\"))\\n       :clj\\n       (let [direct (run-ast (yang/compile 1.0))\\n             sourced (run-ast (yang/compile (read-one \\\"1.0\\\")))]\\n         (is (cbor/float64? direct) \\\"a JVM Double is float content either way\\\")\\n         (is (data-equiv direct sourced))\\n         (is (= (:root (vm/ast->semantic-bytecode (yang/compile 1.0)))\\n                (semantic-root \\\"1.0\\\"))\\n             \\\"on the JVM both spellings mint the same float bytes\\\")))))\\n\\n\\n;; =============================================================================\\n;; GATE 5 - the API/build boundary\\n;; =============================================================================\\n\\n\\n(deftest gate5-explicit-carrier-forms-compile-and-run\\n  (testing \\\"explicit Float64 forms compile directly, nested and quoted\\\"\\n    (let [direct (yang/compile (data/float64 1))\\n          nested (yang/compile [(data/float64 1) 2])\\n          quoted (yang/compile (list 'quote {:f (data/float64 1)}))]\\n      (is (= :literal (:type direct)))\\n      (is (cbor/float64? (:value direct)))\\n      (is (cbor/float64? (first (:value nested))))\\n      (is (integer-host/exact-integer? (second (:value nested)))\\n          \\\"integer Number controls remain integers\\\")\\n      (is (cbor/float64? (get-in quoted [:value :f])))))\\n  (testing \\\"they execute and serialize as float64 content\\\"\\n    (let [value (run-ast (yang/compile [(data/float64 1) 2]))]\\n      (is (cbor/float64? (first value)))\\n      (is (= 1.0 (data/float-value (first value))))\\n      (is (integer-host/exact-integer? (second value))))\\n    (is (cbor/bytes= (jing/canonical-bytes (data/float64 1))\\n                     (jing/canonical-bytes (:value (yang/compile (data/float64 1)))))\\n        \\\"the compiled literal serializes to the carrier's canonical bytes\\\")))\\n\\n\\n(def carrier-root-reference\\n  \\\"The recorded cross-host root of the compiled explicit-carrier form\\n  ((data/float64 1) as the whole program): every forms-capable host - JVM,\\n  Node, Dart, Jolt - compiles the SAME carrier form to the SAME root.\\\"\\n  \\\":segment/blake3-3eaa6d2a6a66538adbe59324cbe5b9e9b5f05da946f7793187a559e7b4971bca\\\")\\n\\n\\n(deftest gate5-carrier-forms-one-root-everywhere\\n  (let [root (:root (vm/ast->semantic-bytecode (yang/compile (data/float64 1))))]\\n    (is (not= \\\"unrecorded\\\" carrier-root-reference))\\n    (is (= carrier-root-reference (str root)))\\n    (is (not= root (:root (vm/ast->semantic-bytecode (yang/compile 1))))\\n        \\\"the carrier root differs from the integer control's root\\\")))\\n\\n\\n(deftest gate5-parked-float-result-crosses-the-round\\n  \\\"A float-producing operation whose result is integral must keep float\\n   kind across a continuation/snapshot boundary: a VM blocks on its own\\n   stream read with `(+ <hole> 0.5)` pending on its continuation, a later\\n   append of a CBOR-round-tripped `1.5` resumes it, and the answer `2.0` is\\n   float64 content both immediately and after canonical serialization.\\\"\\n  (when repl-route?\\n    (let [catalog (frontends/standard)\\n          selected (frontend/select catalog {:yang.frontend/id :yang/clojure})\\n          prims (merge vm/primitives (or (:primitives (:binding selected)) {}))\\n          created (atom nil)\\n          make-stream (fn [cap]\\n                        (let [res (tu/make-stream cap)]\\n                          (reset! created (:dao.stream/handle res))\\n                          res))\\n          ast (yang/compile-program\\n                (yang/read-forms \\\"(def s (stream/make 4)) (+ (stream/next! (stream/cursor s)) 0.5)\\\"))\\n          vm0 (tu/create-vm {:primitives prims\\n                             :modules (-> (module/default-registry)\\n                                          module/register-stream-module)\\n                             :make-stream make-stream\\n                             :capability-secret tu/secret})\\n          parked (vm/eval vm0 ast)]\\n      (is (vm/blocked? parked) \\\"VM parks on empty stream with (+ <hole> 0.5) on continuation\\\")\\n      (is (some? @created) \\\"VM created its stream handle via composition :make-stream\\\")\\n      (stream/append! @created (cbor/decode (jing/canonical-bytes (read-one \\\"1.5\\\"))))\\n      (let [resumed-vm (vm/run parked)\\n            resumed (vm/value resumed-vm)\\n            decoded (cbor/decode (jing/canonical-bytes resumed))]\\n        (is (vm/halted? resumed-vm))\\n        (is (cbor/float64? resumed)\\n            (str \\\"the integral float result survives continuation resume as float kind, got \\\" (pr-str resumed)))\\n        (is (not (integer-host/exact-integer? resumed)))\\n        (is (= 2.0 (data/float-value resumed)))\\n        (is (cbor/float64? decoded))\\n        (is (= 2.0 (data/float-value decoded)))))))\\n\\n\\n(deftest gate5-pre-pause-integral-float-across-continuation-and-snapshot\\n  \\\"B-7 (Gate 5): integral floats computed BEFORE the continuation pause\\n   (in both the VM store and the lexical continuation environment) retain\\n   float64 kind, value, IEEE-754 bits, and canonical identity across both\\n   direct pause/resume and full UCF row-snapshot CBOR serialization/deserialization.\\\"\\n  #?(:jolt nil\\n     :cljd nil\\n     :default\\n     (let [catalog (frontends/standard)\\n           selected (frontend/select catalog {:yang.frontend/id :yang/clojure})\\n           prims (merge vm/primitives (or (:primitives (:binding selected)) {}))\\n           src \\\"(def s (stream/make 4))\\n                (def stored-f (+ 1.5 0.5))\\n                (let [local-f (* 2.5 2.0)\\n                      neg-zero (* -1.0 0.0)]\\n                  (let [sig (stream/next! (stream/cursor s))]\\n                    [stored-f local-f neg-zero sig]))\\\"\\n           ast (yang/compile-program (yang/read-forms src))\\n           proj (:vector (semantic-linearize/project ast))\\n           src-idx {(jing/segment-key proj) #{(jing/segment-key [:yin/tree ast])}}\\n           make-ring (fn [cap]\\n                       (:dao.stream/handle\\n                         (ringbuffer/create!\\n                           {:dao.stream/type ringbuffer/transport-type\\n                            ringbuffer/capacity-key cap})))\\n           verify-result\\n           (fn [label v]\\n             (testing label\\n               (is (= 4 (count v)))\\n               (let [[sf lf nz sig] v]\\n                 (is (= :go sig))\\n                 (doseq [[tag fv expected-val expected-bits]\\n                         [[\\\"stored 2.0\\\" sf 2.0 \\\"4000000000000000\\\"]\\n                          [\\\"local 5.0\\\" lf 5.0 \\\"4014000000000000\\\"]\\n                          [\\\"local -0.0\\\" nz -0.0 \\\"8000000000000000\\\"]]]\\n                   (testing tag\\n                     (is (cbor/float64? fv) (str tag \\\" must keep float64 kind, got \\\" (pr-str fv)))\\n                     (is (not (integer-host/exact-integer? fv)) (str tag \\\" must not collapse to integer\\\"))\\n                     (is (= expected-val (data/float-value fv)))\\n                     (is (= expected-bits (host-bits-of fv)))\\n                     (is (cbor/bytes= (jing/canonical-bytes (data/float64 expected-val))\\n                                      (jing/canonical-bytes fv))))))))\\n           ;; (a) Direct pause / resume\\n           direct-stream (atom nil)\\n           m-direct (-> (sr/create-vm {:primitives prims\\n                                       :modules (-> (module/default-registry)\\n                                                    module/register-stream-module)\\n                                       :make-stream (fn [cap]\\n                                                      (let [h (make-ring cap)]\\n                                                        (reset! direct-stream h)\\n                                                        {:dao.stream/outcome :dao.stream/ok\\n                                                         :dao.stream/handle h}))\\n                                       :capability-secret tu/secret\\n                                       :secret-source (fn [o] (str tu/secret \\\"/\\\" (name o)))})\\n                        (sr/load-vector proj semantic-code/contract))\\n           parked-direct (vm/run m-direct)\\n           _ (is (vm/blocked? parked-direct) \\\"VM pauses after computing stored-f, local-f, neg-zero\\\")\\n           _ (stream/append! @direct-stream :go)\\n           resumed-direct (vm/run parked-direct)\\n           _ (is (vm/halted? resumed-direct))\\n           _ (verify-result \\\"direct pause/resume\\\" (vm/value resumed-direct))\\n           ;; (b) UCF snapshot CBOR serialization -> deserialization -> receiver resume\\n           m-snap (-> (sr/create-vm {:primitives prims\\n                                     :modules (-> (module/default-registry)\\n                                                  module/register-stream-module)\\n                                     :make-stream (fn [cap]\\n                                                    {:dao.stream/outcome :dao.stream/ok\\n                                                     :dao.stream/handle (make-ring cap)})\\n                                     :capability-secret tu/secret\\n                                     :secret-source (fn [o] (str tu/secret \\\"/\\\" (name o)))})\\n                      (sr/load-vector proj semantic-code/contract))\\n           parked-snap (vm/run m-snap)\\n           _ (is (vm/blocked? parked-snap) \\\"snapshot VM pauses with pre-computed integral floats live\\\")\\n           served-streams (atom {})\\n           serve! (let [table (atom {})]\\n                    (fn [h]\\n                      (or (get @table h)\\n                          (let [id (str \\\"s\\\" (count @table))\\n                                desc {:dao.stream/identity id\\n                                      :dao.stream/channel {:dao.stream/type :test/channel}}]\\n                            (swap! table assoc h desc)\\n                            (swap! served-streams assoc id h)\\n                            desc))))\\n           pack (ucf-rows/lift-task parked-snap serve! {:source-index src-idx})\\n           pack-bytes (cbor/encode pack)\\n           pack-decoded (cbor/decode pack-bytes)\\n           attach! (fn [d]\\n                     {:dao.stream/outcome :dao.stream/ok\\n                      :dao.stream/handle (get @served-streams (:dao.stream/identity d))})\\n           receiver (sr/create-vm {:primitives prims\\n                                   :modules (-> (module/default-registry)\\n                                                module/register-stream-module)\\n                                   :make-stream (fn [cap]\\n                                                  {:dao.stream/outcome :dao.stream/ok\\n                                                   :dao.stream/handle (make-ring cap)})\\n                                   :capability-secret tu/secret\\n                                   :secret-source (fn [o] (str tu/secret \\\"/\\\" (name o)))})\\n           restored (ucf-rows/lower-task receiver pack-decoded attach! {})]\\n       (is (vm/blocked? restored) \\\"deserialized snapshot restores in blocked state\\\")\\n       (stream/append! (get @served-streams \\\"s0\\\") :go)\\n       (let [resumed-snap (vm/run restored)]\\n         (is (vm/halted? resumed-snap))\\n         (verify-result \\\"UCF CBOR snapshot round-trip\\\" (vm/value resumed-snap))))))\\n\\n\\n;; =============================================================================\\n;; R2 SIGN-OFF REGRESSIONS (B-2 .. B-6)\\n;; =============================================================================\\n\\n\\n(deftest b2-set-and-map-false-nil-elements-and-duplicates\\n  \\\"B-2: false/nil elements in sets (at any position) and maps must never\\n   truncate reading or bypass duplicate checks after them.\\\"\\n  (when repl-route?\\n    (testing \\\"sets retain false and nil at first, middle, and last positions\\\"\\n      (doseq [[src expected-false? expected-nil?]\\n              [[\\\"#{false 1.0 2}\\\" true false]\\n               [\\\"#{1.0 false 2}\\\" true false]\\n               [\\\"#{1.0 2 false}\\\" true false]\\n               [\\\"#{nil 1.0 2}\\\" false true]\\n               [\\\"#{1.0 nil 2}\\\" false true]\\n               [\\\"#{1.0 2 nil}\\\" false true]]]\\n        (testing src\\n          (let [s (read-one src)\\n                floats (filter cbor/float64? s)]\\n            (is (set? s))\\n            (is (= 3 (count s)) (str src \\\" read as \\\" (pr-str s)))\\n            (is (= expected-false? (contains? s false)))\\n            (is (= expected-nil? (contains? s nil)))\\n            (is (contains? s 2))\\n            (is (= 1 (count floats)))\\n            (is (= 1.0 (data/float-value (first floats)))))))\\n      (let [s (read-one \\\"#{false nil 1.0 2}\\\")]\\n        (is (= 4 (count s)))\\n        (is (contains? s false))\\n        (is (contains? s nil))\\n        (is (contains? s 2))\\n        (is (= 1 (count (filter cbor/float64? s))))))\\n    (testing \\\"duplicate set elements after false/nil are still refused\\\"\\n      (doseq [src [\\\"#{false 1 1}\\\"\\n                   \\\"#{nil 1 1}\\\"\\n                   \\\"#{false 1.0 1.0}\\\"\\n                   \\\"#{nil 1.0 1.0}\\\"\\n                   \\\"#{false false}\\\"\\n                   \\\"#{nil nil}\\\"\\n                   \\\"#{false nil false}\\\"\\n                   \\\"#{nil false nil}\\\"]]\\n        (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                     (yang/read-forms src))\\n            (str src \\\" must refuse duplicate element\\\"))))\\n    (testing \\\"maps retain false/nil keys and refuse duplicates after them\\\"\\n      (let [m (read-one \\\"{false 1.0 nil 2 1 :a}\\\")]\\n        (is (= 3 (count m)))\\n        (is (cbor/float64? (get m false)))\\n        (is (= 1.0 (data/float-value (get m false))))\\n        (is (= 2 (get m nil)))\\n        (is (= :a (get m 1))))\\n      (doseq [src [\\\"{false 1 false 2}\\\"\\n                   \\\"{nil 1 nil 2}\\\"\\n                   \\\"{false 1 2 :a 2 :b}\\\"\\n                   \\\"{nil 1 1.0 :a 1.0 :b}\\\"]]\\n        (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                     (yang/read-forms src))\\n            (str src \\\" must refuse duplicate key\\\"))))))\\n\\n\\n(deftest b3-variadic-equality-and-inequality-truthiness\\n  \\\"B-3: variadic clj-= and clj-!= must test sequence presence, never\\n   operand truthiness, including operands after false/nil.\\\"\\n  (testing \\\"direct variadic clj-= and clj-!= calls\\\"\\n    (is (false? (clj-numeric/clj-= 1 1 false)))\\n    (is (false? (clj-numeric/clj-= 1 1 nil)))\\n    (is (false? (clj-numeric/clj-= 1 1 false 1)))\\n    (is (false? (clj-numeric/clj-= 1 1 nil 1)))\\n    (is (false? (clj-numeric/clj-= (data/float64 1.0) (data/float64 1.0) false)))\\n    (is (false? (clj-numeric/clj-= (data/float64 1.0) (data/float64 1.0) nil)))\\n    (is (true? (clj-numeric/clj-= false false false)))\\n    (is (false? (clj-numeric/clj-= false false true)))\\n    (is (false? (clj-numeric/clj-= false false nil)))\\n    (is (false? (clj-numeric/clj-= false false false 1)))\\n    (is (true? (clj-numeric/clj-= nil nil nil)))\\n    (is (false? (clj-numeric/clj-= nil nil false)))\\n    (is (false? (clj-numeric/clj-= nil nil 1)))\\n    (is (true? (clj-numeric/clj-!= 1 1 false)))\\n    (is (true? (clj-numeric/clj-!= 1 1 nil)))\\n    (is (true? (clj-numeric/clj-!= 1 1 false 1)))\\n    (is (false? (clj-numeric/clj-!= false false false)))\\n    (is (true? (clj-numeric/clj-!= false false nil)))\\n    (is (false? (clj-numeric/clj-!= nil nil nil)))\\n    (is (true? (clj-numeric/clj-!= nil nil false))))\\n  (when repl-route?\\n    (testing \\\"variadic = and != through the REPL/catalog source path\\\"\\n      (doseq [[line expected]\\n              [[\\\"(= 1 1 false)\\\" false]\\n               [\\\"(= 1 1 nil)\\\" false]\\n               [\\\"(= 1 1 false 1)\\\" false]\\n               [\\\"(= 1 1 nil 1)\\\" false]\\n               [\\\"(= 1.0 1.0 false)\\\" false]\\n               [\\\"(= 1.0 1.0 nil)\\\" false]\\n               [\\\"(= 1.0 1.0 false 1.0)\\\" false]\\n               [\\\"(= false false false)\\\" true]\\n               [\\\"(= false false true)\\\" false]\\n               [\\\"(= false false nil)\\\" false]\\n               [\\\"(= false false false 1)\\\" false]\\n               [\\\"(= nil nil nil)\\\" true]\\n               [\\\"(= nil nil false)\\\" false]\\n               [\\\"(= nil nil 1.0)\\\" false]\\n               [\\\"(= 1.0 1.0 1.0)\\\" true]\\n               [\\\"(= 1.0 1.0 1)\\\" false]\\n               [\\\"(!= 1 1 false)\\\" true]\\n               [\\\"(!= 1 1 nil)\\\" true]\\n               [\\\"(!= 1 1 false 1)\\\" true]\\n               [\\\"(!= 1.0 1.0 false)\\\" true]\\n               [\\\"(!= false false false)\\\" false]\\n               [\\\"(!= false false nil)\\\" true]\\n               [\\\"(!= nil nil nil)\\\" false]\\n               [\\\"(!= nil nil false)\\\" true]\\n               [\\\"(!= 1.0 1.0 1.0)\\\" false]]]\\n        (is (= expected (repl-session-result line)) line)))))\\n\\n\\n(deftest b4-discard-sentinel-cannot-collide-with-guest-values\\n  \\\"B-4: valid guest literals (especially :yang.clojure.reader/discard,\\n   false, nil, :discard, and vector shapes) must remain representable in\\n   top-level, collection, and required-form positions.\\\"\\n  (when repl-route?\\n    (testing \\\"top-level positions\\\"\\n      (is (= [:yang.clojure.reader/discard]\\n             (yang/read-forms \\\":yang.clojure.reader/discard\\\")))\\n      (is (= [:yang.clojure.reader/discard 1]\\n             (yang/read-forms \\\":yang.clojure.reader/discard 1\\\")))\\n      (is (= [false nil :discard [:discard nil 0]]\\n             (yang/read-forms \\\"false nil :discard [:discard nil 0]\\\")))\\n      (is (= :yang.clojure.reader/discard\\n             (repl-session-result \\\":yang.clojure.reader/discard\\\"))))\\n    (testing \\\"collection positions\\\"\\n      (let [v (read-one \\\"[:yang.clojure.reader/discard 1.0]\\\")\\n            l (read-one \\\"(:yang.clojure.reader/discard 1.0)\\\")\\n            m (read-one \\\"{:yang.clojure.reader/discard 1.0 :k :yang.clojure.reader/discard}\\\")\\n            s (read-one \\\"#{:yang.clojure.reader/discard false nil 1.0}\\\")]\\n        (is (= 2 (count v)))\\n        (is (= :yang.clojure.reader/discard (first v)))\\n        (is (cbor/float64? (second v)))\\n        (is (= 2 (count l)))\\n        (is (= :yang.clojure.reader/discard (first l)))\\n        (is (cbor/float64? (second l)))\\n        (is (= 2 (count m)))\\n        (is (cbor/float64? (get m :yang.clojure.reader/discard)))\\n        (is (= :yang.clojure.reader/discard (get m :k)))\\n        (is (= 4 (count s)))\\n        (is (contains? s :yang.clojure.reader/discard))\\n        (is (contains? s false))\\n        (is (contains? s nil))\\n        (is (= 1 (count (filter cbor/float64? s))))))\\n    (testing \\\"required-form positions\\\"\\n      (is (= '(quote :yang.clojure.reader/discard)\\n             (read-one \\\"':yang.clojure.reader/discard\\\")))\\n      (is (= {:yang.clojure.reader/discard true}\\n             (meta (read-one \\\"^:yang.clojure.reader/discard [1.0]\\\"))))\\n      (let [after-discard (yang/read-forms \\\"#_:yang.clojure.reader/discard 1.0\\\")]\\n        (is (= 1 (count after-discard)))\\n        (is (cbor/float64? (first after-discard))))\\n      (is (= '(clojure.core/unquote :yang.clojure.reader/discard)\\n             (read-one \\\"~:yang.clojure.reader/discard\\\")))\\n      (is (= '(clojure.core/deref :yang.clojure.reader/discard)\\n             (read-one \\\"@:yang.clojure.reader/discard\\\")))\\n      (is (= '(var :yang.clojure.reader/discard)\\n             (read-one \\\"#':yang.clojure.reader/discard\\\")))\\n      (let [fn-form (read-one \\\"#(:yang.clojure.reader/discard %)\\\")]\\n        (is (= 'fn (first fn-form)))\\n        (is (= :yang.clojure.reader/discard (first (nth fn-form 2))))))))\\n\\n\\n(deftest b5-anon-fn-capture-avoiding-and-deterministic\\n  \\\"B-5: #(...) expansion must be capture-avoiding (never capturing user\\n   bindings like p__1/p__2/p__rest or generated-pattern names), parse-scoped,\\n   and deterministic in canonical output.\\\"\\n  (when repl-route?\\n    (testing \\\"the 4-vs-12 counterexample and float variant\\\"\\n      (is (= 12 (repl-session-result \\\"(let [p__1 10] (#(+ p__1 %) 2))\\\")))\\n      (let [fv (repl-session-result \\\"(let [p__1 10.0] (#(+ p__1 %) 2.0))\\\")]\\n        (is (cbor/float64? fv))\\n        (is (= 12.0 (data/float-value fv)))))\\n    (testing \\\"positional and rest bindings against colliding user names\\\"\\n      (let [form (read-one \\\"#(+ p__1 p__2 p__rest %1 %2 (first %&))\\\")\\n            params (second form)\\n            body (nth form 2)\\n            [p1 p2 amp r] params]\\n        (is (= 'fn (first form)))\\n        (is (= 4 (count params)))\\n        (is (= '& amp))\\n        (is (not-any? #{'p__1 'p__2 'p__rest} [p1 p2 r]))\\n        (is (= (list '+ 'p__1 'p__2 'p__rest p1 p2 (list 'first r)) body)))\\n      (let [form (read-one \\\"#(+ p1__1# p2__1# rest__1# %1 %2 (first %&))\\\")\\n            params (second form)\\n            body (nth form 2)\\n            [p1 p2 amp r] params]\\n        (is (= 4 (count params)))\\n        (is (= '& amp))\\n        (is (not-any? #{'p1__1# 'p2__1# 'rest__1#} [p1 p2 r]))\\n        (is (= (list '+ 'p1__1# 'p2__1# 'rest__1# p1 p2 (list 'first r)) body)))\\n      (let [form (read-one \\\"#(+ rest__1# p__rest (first %&))\\\")\\n            params (second form)\\n            body (nth form 2)\\n            [amp r] params]\\n        (is (= 2 (count params)))\\n        (is (= '& amp))\\n        (is (not (contains? #{'rest__1# 'p__rest} r)))\\n        (is (= (list '+ 'rest__1# 'p__rest (list 'first r)) body)))\\n      #?(:clj\\n         (do\\n           (is (= 66 (eval (read-one \\\"(let [p__1 10 p__2 20 p__rest 30] (#(+ p__1 p__2 p__rest %1 %2 (first %&)) 1 2 3))\\\"))))\\n           (is (= 305 (eval (read-one \\\"(let [rest__1# 100 p__rest 200] (#(+ rest__1# p__rest (first %&)) 5 6))\\\"))))))\\n      (is (= 33 (repl-session-result \\\"(let [p__1 10 p__2 20] (#(+ p__1 p__2 %1 %2) 1 2))\\\")))\\n      (is (= 12 (repl-session-result \\\"(let [p1__1# 10] (#(+ p1__1# %) 2))\\\")))\\n      (is (= 33 (repl-session-result \\\"(let [p1__1# 10 p1__2# 20] (#(+ p1__1# p1__2# %) 3))\\\")))\\n      (is (= 22 (repl-session-result \\\"(let [p__1 10] (#(let [p__1 20] (+ p__1 %)) 2))\\\")))\\n      (is (= 12 (repl-session-result \\\"(let [p1__1# 10] (#(+ p1__1# %2) 99 2))\\\"))))\\n    (testing \\\"deterministic canonical output across reads and sibling forms\\\"\\n      (is (= (read-one \\\"#(+ % 1.0)\\\") (read-one \\\"#(+ % 1.0)\\\")))\\n      (is (= (semantic-root \\\"#(+ % 1.0)\\\") (semantic-root \\\"#(+ % 1.0)\\\")))\\n      (is (= (semantic-root \\\"#(+ p__1 % 1.0)\\\") (semantic-root \\\"#(+ p__1 % 1.0)\\\")))\\n      (let [[f1 f2] (read-one \\\"[#(+ % 1.0) #(+ % 1.0)]\\\")]\\n        (is (= f1 f2))))\\n    (testing \\\"duplicate argument in set inside #() is still caught\\\"\\n      (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                   (yang/read-forms \\\"#(#{% %1})\\\"))))))\\n\\n\\n(deftest b6-lexical-compatibility-and-syntax-quote\\n  \\\"B-6: restore previously supported grammar (apostrophe-in-symbol, scalar\\n   syntax-quote, deprecated #^ meta, @x -> clojure.core/deref) and check\\n   differential lexical parity against tools.reader.\\\"\\n  #?(:jolt nil\\n     :cljd nil\\n     :default\\n     (do\\n       (testing \\\"apostrophe-in-symbol reads and executes\\\"\\n         (is (= 'x' (read-one \\\"x'\\\")))\\n         (is (= 'foo'bar (read-one \\\"foo'bar\\\")))\\n         (is (= 'a'' (read-one \\\"a''\\\")))\\n         (is (= 'ns/x' (read-one \\\"ns/x'\\\")))\\n         (is (= '(quote x') (read-one \\\"'x'\\\")))\\n         (is (= :k' (read-one \\\":k'\\\")))\\n         (let [fv (repl-session-result \\\"(let [x' 1.0] (+ x' 2.0))\\\")]\\n           (is (cbor/float64? fv))\\n           (is (= 3.0 (data/float-value fv)))))\\n       (testing \\\"scalar syntax-quote reads and executes as before, preserving float kind\\\"\\n         (is (= 1 (read-one \\\"`1\\\")))\\n         (is (= 1 (repl-session-result \\\"`1\\\")))\\n         (let [f-read (read-one \\\"`1.0\\\")\\n               f-eval (repl-session-result \\\"`1.0\\\")\\n               nz-eval (repl-session-result \\\"`-0.0\\\")]\\n           (is (cbor/float64? f-read))\\n           (is (= 1.0 (data/float-value f-read)))\\n           (is (cbor/float64? f-eval))\\n           (is (= 1.0 (data/float-value f-eval)))\\n           (is (cbor/float64? nz-eval))\\n           (is (= \\\"8000000000000000\\\" (host-bits-of nz-eval))))\\n         (is (= true (repl-session-result \\\"`true\\\")))\\n         (is (= false (repl-session-result \\\"`false\\\")))\\n         (is (= nil (repl-session-result \\\"`nil\\\")))\\n         (is (= \\\"hi\\\" (repl-session-result \\\"`\\\\\\\"hi\\\\\\\"\\\")))\\n         (is (= :k (repl-session-result \\\"`:k\\\")))\\n         (is (cbor/ratio? (read-one \\\"`1/2\\\")))\\n         (is (cbor/decimal? (read-one \\\"`1M\\\")))\\n         (let [unquoted (repl-session-result \\\"(let [x 1.0] `~x)\\\")]\\n           (is (cbor/float64? unquoted))\\n           (is (= 1.0 (data/float-value unquoted))))\\n         (is (thrown? #?(:clj Exception :cljs js/Error :default Exception)\\n                      (yang/read-forms \\\"`~@x\\\")))\\n         (let [sq-vec (read-one \\\"`[1.0 ~x]\\\")]\\n           (is (seq? sq-vec)))\\n         (let [sq-gs (read-one \\\"`[x# x# y#]\\\")]\\n           (is (= sq-gs (read-one \\\"`[x# x# y#]\\\")) \\\"auto-gensym in syntax-quote is deterministic\\\")))\\n       (testing \\\"differential lexical parity against tools.reader on non-float grammar\\\"\\n         (let [old-read-all (fn [src]\\n                              (let [rd (tools-rt/string-push-back-reader src)]\\n                                (loop [acc []]\\n                                  (let [f (tools-reader/read rd false ::eof)]\\n                                    (if (= f ::eof)\\n                                      acc\\n                                      (recur (conj acc f)))))))\\n               corpus [\\\"x'\\\"\\n                       \\\"foo'bar\\\"\\n                       \\\"a''\\\"\\n                       \\\"ns/x'\\\"\\n                       \\\"'x'\\\"\\n                       \\\":k'\\\"\\n                       \\\"x#\\\"\\n                       \\\"foo:bar\\\"\\n                       \\\"foo%bar\\\"\\n                       \\\"\\\\\\\\'\\\"\\n                       \\\"\\\\\\\\newline\\\"\\n                       \\\"\\\\\\\\u0041\\\"\\n                       \\\"\\\\\\\\o101\\\"\\n                       \\\"\\\\\\\"a\\\\\\\\nb\\\\\\\\t\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\u0041\\\\\\\\101\\\\\\\"\\\"\\n                       \\\"; comment\\\\n42\\\"\\n                       \\\"#! shebang\\\\n42\\\"\\n                       \\\"#_#_1 2 3\\\"\\n                       \\\"#^:m [1]\\\"\\n                       \\\"^:a ^{:b 2} [1]\\\"\\n                       \\\"@x\\\"\\n                       \\\"#'x\\\"\\n                       \\\"~x\\\"\\n                       \\\"~@x\\\"\\n                       \\\"#{false nil 1 2}\\\"\\n                       \\\"{false 1 nil 2}\\\"\\n                       \\\"#:a{:b 1 _/c 2}\\\"\\n                       \\\"`1\\\"\\n                       \\\"`true\\\"\\n                       \\\"`false\\\"\\n                       \\\"`nil\\\"\\n                       \\\"`\\\\\\\"hi\\\\\\\"\\\"\\n                       \\\"`:k\\\"\\n                       \\\"`~x\\\"]]\\n           (doseq [src corpus]\\n             (testing src\\n               (let [expected (old-read-all src)\\n                     actual (yang/read-forms src)]\\n                 (is (= expected actual) (str \\\"differential mismatch for \\\" (pr-str src)))\\n                 (is (= (mapv meta expected) (mapv meta actual))\\n                     (str \\\"metadata mismatch for \\\" (pr-str src)))))))))))\\n\\n\\n#?(:jolt nil\\n   :cljd nil\\n   :clj\\n   (defn- integral-double-leaves\\n     \\\"Every integral Double constant in host-quoted `form` data (the JVM is\\n     the host that can still see the Double/integer distinction).\\\"\\n     [form]\\n     (let [acc (atom [])]\\n       (walk/postwalk\\n         (fn [x]\\n           (when (and (instance? Double x)\\n                      (Double/isFinite (double x))\\n                      (== (double x) (Math/rint (double x))))\\n             (swap! acc conj x))\\n           x)\\n         form)\\n       @acc)))\\n\\n\\n(deftest gate5-quoted-prelude-audit-no-integral-doubles\\n  \\\"The JVM-side producer audit: the quoted prelude tables that build the\\n   clj/clojure.core.impl/clj.py runtime modules carry no bare integral\\n   Double constant a JS host would silently encode as an integer. Floats\\n   in prose are non-integral or explicitly constructed.\\\"\\n  #?(:jolt nil\\n     :cljd nil\\n     :clj\\n     (let [producers [\\\"clj runtime definitions\\\"\\n                      (concat @(resolve 'yang.clojure.prelude/definitions)\\n                              @(resolve 'yang.clojure.prelude/source-definitions))\\n                      \\\"clojure.core.impl operations\\\"\\n                      @(resolve 'yang.clojure.core-impl/operations)\\n                      \\\"clj.py numeric table\\\"\\n                      @(resolve 'yang.python.antlr.clj-runtime/numeric)]]\\n       (doseq [[label forms] (partition 2 producers)]\\n         (testing label\\n           (is (= [] (integral-double-leaves forms))\\n               (str label \\\" quotes no integral Double constant\\\")))))))\\n\\n\\n;; =============================================================================\\n;; GATE 4 (linked/library path arithmetic with scoped Clojure primitives)\\n;; =============================================================================\\n\\n(deftest gate4-linked-library-arithmetic-reboxed\\n  (when repl-route?\\n    (testing \\\"linked/library execution with the repaired Clojure profile primitives computes and reboxes floats\\\"\\n      (let [catalog (frontends/standard)\\n            selected (frontend/select catalog {:yang.frontend/id :yang/clojure})\\n            prims (merge vm/primitives (or (:primitives (:binding selected)) {}))\\n            run-lib (fn [source]\\n                      (let [ast (yang/compile-program\\n                                  (yang/read-forms source) true\\n                                  {:convention :arg-vector\\n                                   :outcomes true\\n                                   :native (set (keys vm/primitives))})]\\n                        (-> (tu/make-observer-session\\n                              (tu/create-vm {:primitives prims\\n                                             :modules library-registry\\n                                             :make-stream tu/make-stream\\n                                             :capability-secret tu/secret}))\\n                            (tu/queue-ast! ast)\\n                            tu/run-session\\n                            :consumer\\n                            vm/value)))]\\n        (doseq [[source expected] [[\\\"(+ 1.5 1.5)\\\" 3.0]\\n                                   [\\\"(* 2.5 2.0)\\\" 5.0]\\n                                   [\\\"(- 1.0 4.0)\\\" -3.0]\\n                                   [\\\"(+ 1 0.5)\\\" 1.5]]]\\n          (testing source\\n            (let [[status v] (run-lib source)]\\n              (is (= :yin.k/ok status))\\n              (is (cbor/float64? v) (str source \\\" must return float64, got \\\" (pr-str v)))\\n              (is (= expected (data/float-value v))))))\\n        (is (= [:yin.k/ok true] (run-lib \\\"(< 1.0 2)\\\")))\\n        (is (= [:yin.k/ok false] (run-lib \\\"(= 1.0 1)\\\")))\\n        (is (= [:yin.k/ok true] (run-lib \\\"(== 1.0 1)\\\")))))))\\n\\n\\n;; =============================================================================\\n;; GATE 6 - cross-host artifacts and genuine pre-fix legacy custody\\n;; =============================================================================\\n\\n(def ^:private legacy-jvm-float-b64\\n  \\\"Genuine pre-fix c1-2 JVM float-bearing artifact of `((fn [] 1.0))`\\n   (1,415 bytes, sha256 71dc93298c26773dc8383f5d12e03d732840052692a272c16c4aaf4ec90783ec),\\n   captured at 7f4898f4 before the repair.\\\"\\n  (str \\\"p9gbgnBkYW8uamluZy9rZXl3b3JkgnZ5YW5nLmNsb2p1cmUuZmxvYXRraW5kZGhvc3TYG4JwZGFvLmppbmcva2V5d29yZIL2aWp2\\\"\\n       \\\"bS1mbG9hdNgbgnBkYW8uamluZy9rZXl3b3JkgnZ5YW5nLmNsb2p1cmUuZmxvYXRraW5kZmxlZ2FjefXYG4JwZGFvLmppbmcva2V5\\\"\\n       \\\"d29yZIJ2eWFuZy5jbG9qdXJlLmZsb2F0a2luZGZzb3VyY2VtKChmbiBbXSAxLjApKdgbgnBkYW8uamluZy9rZXl3b3JkgnZ5YW5n\\\"\\n       \\\"LmNsb2p1cmUuZmxvYXRraW5ka3ByZS1maXgtcmVmbTdmNDg5OGY0IGMxLTLYG4JwZGFvLmppbmcva2V5d29yZIL2ZHJvb3TYG4Jw\\\"\\n       \\\"ZGFvLmppbmcva2V5d29yZIJnc2VnbWVudHhHYmxha2UzLTdjZGFlOWRmZWU3ZjE5ODBjY2RkOTU0M2YyNzlkMGQ3ZDIwZTRhNGE0\\\"\\n       \\\"YTQ0ZGRhMTRmODhmNTRiYTkwMDIwNDnYG4JwZGFvLmppbmcva2V5d29yZIL2ZHJvd3Oj2BuCcGRhby5qaW5nL2tleXdvcmSCZ3Nl\\\"\\n       \\\"Z21lbnR4R2JsYWtlMy0xZWM4Y2ExYzNkYzJmZjQxZjI4Mzk5MDY0NmJmZTcxMDBjNTk1ZDNjYmY1YmEzN2NhZWU0MzVlMTA0ZGVh\\\"\\n     