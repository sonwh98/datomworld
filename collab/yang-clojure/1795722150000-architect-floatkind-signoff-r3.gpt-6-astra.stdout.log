; @\\n129\\t            (= c 94)   ;; ^\\n130\\t            (= c 92))))) ;; \\\\\\n131\\t\\n132\\t\\n133\\t(defn- skip-line-comment\\n134\\t  [s n i]\\n135\\t  (loop [j i]\\n136\\t    (if (>= j n)\\n137\\t      j\\n138\\t      (let [c (char-code (char-at s j))]\\n139\\t        (if (or (= c 10) (= c 13))\\n140\\t          (inc j)\\n141\\t          (recur (inc j)))))))\\n142\\t\\n143\\t\\n144\\t(defn- skip-ws-and-comments\\n145\\t  [s n i]\\n146\\t  (loop [j i]\\n147\\t    (if (>= j n)\\n148\\t      j\\n149\\t      (let [ch (char-at s j)\\n150\\t            c (char-code ch)]\\n151\\t        (cond\\n152\\t          (whitespace? ch) (recur (inc j))\\n153\\t          (= c 59) (recur (skip-line-comment s n (inc j))) ;; ;\\n154\\t          (and (= c 35) (< (inc j) n) (= 33 (char-code (char-at s (inc j))))) ;; #!\\n155\\t          (recur (skip-line-comment s n (+ j 2)))\\n156\\t          :else j)))))\\n157\\t\\n158\\t\\n159\\t(defn- read-token\\n160\\t  \\\"Read a non-empty token starting at `i` up to the next terminating char.\\n161\\t   Returns `[token next-i]`.\\\"\\n162\\t  [s n i]\\n163\\t  (loop [j i]\\n164\\t    (if (or (>= j n) (macro-terminating? (char-at s j)))\\n165\\t      [(subs s i j) j]\\n166\\t      (recur (inc j)))))\\n167\\t\\n168\\t\\n169\\t(defn- read-string-lit\\n170\\t  [s n i]\\n171\\t  ;; s[i] is \\\\\\\"\\n172\\t  (let [sb #?(:cljs (js/Array.) :default (StringBuilder.))]\\n173\\t    (loop [j (inc i)]\\n174\\t      (when (>= j n)\\n175\\t        (reader-error! \\\"EOF while reading string\\\" {:index i}))\\n176\\t      (let [ch (char-at s j)\\n177\\t            c (char-code ch)]\\n178\\t        (cond\\n179\\t          (= c 34) ;; closing \\\\\\\"\\n180\\t          [#?(:cljs (.join sb \\\"\\\") :default (.toString sb)) (inc j)]\\n181\\t\\n182\\t          (= c 92) ;; backslash escape\\n183\\t          (do\\n184\\t            (when (>= (inc j) n)\\n185\\t              (reader-error! \\\"EOF while reading string escape\\\" {:index j}))\\n186\\t            (let [esc (char-at s (inc j))\\n187\\t                  ec (char-code esc)]\\n188\\t              (cond\\n189\\t                (= ec 116) (do #?(:cljs (.push sb \\\"\\\\t\\\") :default (.append sb \\\\tab)) (recur (+ j 2)))\\n190\\t                (= ec 114) (do #?(:cljs (.push sb \\\"\\\\r\\\") :default (.append sb \\\\return)) (recur (+ j 2)))\\n191\\t                (= ec 110) (do #?(:cljs (.push sb \\\"\\\\n\\\") :default (.append sb \\\\newline)) (recur (+ j 2)))\\n192\\t                (= ec 92)  (do #?(:cljs (.push sb \\\"\\\\\\\\\\\") :default (.append sb \\\\\\\\)) (recur (+ j 2)))\\n193\\t                (= ec 34)  (do #?(:cljs (.push sb \\\"\\\\\\\"\\\") :default (.append sb \\\\\\\")) (recur (+ j 2)))\\n194\\t                (= ec 98)  (do #?(:cljs (.push sb \\\"\\\\b\\\") :default (.append sb \\\\backspace)) (recur (+ j 2)))\\n195\\t                (= ec 102) (do #?(:cljs (.push sb \\\"\\\\f\\\") :default (.append sb \\\\formfeed)) (recur (+ j 2)))\\n196\\t                (= ec 117) ;; \\\\uXXXX\\n197\\t                (do\\n198\\t                  (when (> (+ j 6) n)\\n199\\t                    (reader-error! \\\"Invalid unicode escape in string\\\" {:index j}))\\n200\\t                  (let [hex (subs s (+ j 2) (+ j 6))]\\n201\\t                    (when-not (every? hex-digit? hex)\\n202\\t                      (reader-error! (str \\\"Invalid unicode escape: \\\\\\\\u\\\" hex) {:index j}))\\n203\\t                    (let [ch-out (code->char (hex-value hex))]\\n204\\t                      #?(:cljs (.push sb ch-out) :default (.append sb ch-out))\\n205\\t                      (recur (+ j 6)))))\\n206\\t                (octal-digit? esc)\\n207\\t                (let [end (loop [k (+ j 2) cnt 1]\\n208\\t                            (if (and (< k n) (< cnt 3) (octal-digit? (char-at s k)))\\n209\\t                              (recur (inc k) (inc cnt))\\n210\\t                              k))\\n211\\t                      oct (subs s (inc j) end)\\n212\\t                      val (octal-value oct)]\\n213\\t                  (when (> val 255)\\n214\\t                    (reader-error! (str \\\"Octal escape out of range: \\\\\\\\\\\" oct) {:index j}))\\n215\\t                  (let [ch-out (code->char val)]\\n216\\t                    #?(:cljs (.push sb ch-out) :default (.append sb ch-out))\\n217\\t                    (recur end)))\\n218\\t                :else\\n219\\t                (reader-error! (str \\\"Unsupported escape character: \\\\\\\\\\\" esc) {:index j}))))\\n220\\t\\n221\\t          :else\\n222\\t          (do #?(:cljs (.push sb ch) :default (.append sb ch))\\n223\\t              (recur (inc j))))))))\\n224\\t\\n225\\t\\n226\\t(defn- read-regex-lit\\n227\\t  [s n i]\\n228\\t  ;; s[i] is \\\\\\\" (immediately after #)\\n229\\t  (let [sb #?(:cljs (js/Array.) :default (StringBuilder.))]\\n230\\t    (loop [j (inc i)]\\n231\\t      (when (>= j n)\\n232\\t        (reader-error! \\\"EOF while reading regex\\\" {:index i}))\\n233\\t      (let [ch (char-at s j)\\n234\\t            c (char-code ch)]\\n235\\t        (cond\\n236\\t          (= c 34)\\n237\\t          (let [pat #?(:cljs (.join sb \\\"\\\") :default (.toString sb))]\\n238\\t            [(re-pattern pat) (inc j)])\\n239\\t\\n240\\t          (= c 92)\\n241\\t          (do\\n242\\t            (when (>= (inc j) n)\\n243\\t              (reader-error! \\\"EOF while reading regex escape\\\" {:index j}))\\n244\\t            (let [nxt (char-at s (inc j))]\\n245\\t              #?(:cljs (do (.push sb \\\"\\\\\\\\\\\") (.push sb nxt))\\n246\\t                 :default (do (.append sb \\\\\\\\) (.append sb nxt)))\\n247\\t              (recur (+ j 2))))\\n248\\t\\n249\\t          :else\\n250\\t          (do #?(:cljs (.push sb ch) :default (.append sb ch))\\n251\\t              (recur (inc j))))))))\\n252\\t\\n253\\t\\n254\\t(def ^:private named-chars\\n255\\t  {\\\"newline\\\" \\\\newline\\n256\\t   \\\"space\\\" \\\\space\\n257\\t   \\\"tab\\\" \\\\tab\\n258\\t   \\\"backspace\\\" \\\\backspace\\n259\\t   \\\"formfeed\\\" \\\\formfeed\\n260\\t   \\\"return\\\" \\\\return})\\n261\\t\\n262\\t\\n263\\t(defn- read-char-lit\\n264\\t  [s n i]\\n265\\t  ;; s[i] is \\\\\\\\\\n266\\t  (when (>= (inc i) n)\\n267\\t    (reader-error! \\\"EOF while reading character\\\" {:index i}))\\n268\\t  (let [first-ch (char-at s (inc i))]\\n269\\t    (if (macro-terminating? first-ch)\\n270\\t      [first-ch (+ i 2)]\\n271\\t      (let [[tok next-i] (read-token s n (inc i))]\\n272\\t        [(cond\\n273\\t           (= 1 (count tok)) (char-at tok 0)\\n274\\t           (contains? named-chars tok) (get named-chars tok)\\n275\\t           (str/starts-with? tok \\\"u\\\")\\n276\\t           (let [hex (subs tok 1)]\\n277\\t             (when-not (and (= 4 (count hex)) (every? hex-digit? hex))\\n278\\t               (reader-error! (str \\\"Invalid unicode character literal: \\\\\\\\\\\" tok) {:index i}))\\n279\\t             (let [v (hex-value hex)]\\n280\\t               (when (and (<= 0xD800 v) (<= v 0xDFFF))\\n281\\t                 (reader-error! (str \\\"Invalid character constant: \\\\\\\\\\\" tok) {:index i}))\\n282\\t               (code->char v)))\\n283\\t           (str/starts-with? tok \\\"o\\\")\\n284\\t           (let [oct (subs tok 1)]\\n285\\t             (when-not (and (<= 1 (count oct) 3) (every? octal-digit? oct))\\n286\\t               (reader-error! (str \\\"Invalid octal character literal: \\\\\\\\\\\" tok) {:index i}))\\n287\\t             (let [v (octal-value oct)]\\n288\\t               (when (> v 255)\\n289\\t                 (reader-error! (str \\\"Octal escape sequence must be in range [0, 377]: \\\\\\\\\\\" tok)\\n290\\t                                {:index i}))\\n291\\t               (code->char v)))\\n292\\t           :else\\n293\\t           (reader-error! (str \\\"Unsupported character: \\\\\\\\\\\" tok) {:index i}))\\n294\\t         next-i]))))\\n295\\t\\n296\\t\\n297\\t(defn- parse-symbol-token\\n298\\t  [tok i]\\n299\\t  (cond\\n300\\t    (= tok \\\"nil\\\") nil\\n301\\t    (= tok \\\"true\\\") true\\n302\\t    (= tok \\\"false\\\") false\\n303\\t    (= tok \\\"/\\\") '/\\n304\\t    :else\\n305\\t    (let [slash (str/index-of tok \\\"/\\\")]\\n306\\t      (if (nil? slash)\\n307\\t        (symbol tok)\\n308\\t        (let [ns-part (subs tok 0 slash)\\n309\\t              name-part (subs tok (inc slash))]\\n310\\t          (when (or (empty? ns-part)\\n311\\t                    (empty? name-part)\\n312\\t                    (and (not= name-part \\\"/\\\")\\n313\\t                         (str/includes? name-part \\\"/\\\")))\\n314\\t            (reader-error! (str \\\"Invalid token: \\\" tok) {:token tok :index i}))\\n315\\t          (symbol ns-part name-part))))))\\n316\\t\\n317\\t\\n318\\t(defn- parse-keyword-token\\n319\\t  [tok i]\\n320\\t  ;; tok starts with \\\":\\\"\\n321\\t  (when (or (= tok \\\":\\\") (str/starts-with? tok \\\"::\\\"))\\n322\\t    (reader-error! (str \\\"Invalid keyword token: \\\" tok) {:token tok :index i}))\\n323\\t  (let [body (subs tok 1)\\n324\\t        slash (str/index-of body \\\"/\\\")]\\n325\\t    (if (nil? slash)\\n326\\t      (do\\n327\\t        (when (str/starts-with? body \\\":\\\")\\n328\\t          (reader-error! (str \\\"Invalid keyword token: \\\" tok) {:token tok :index i}))\\n329\\t        (keyword body))\\n330\\t      (let [ns-part (subs body 0 slash)\\n331\\t            name-part (subs body (inc slash))]\\n332\\t        (when (or (empty? ns-part)\\n333\\t                  (empty? name-part)\\n334\\t                  (str/starts-with? name-part \\\":\\\")\\n335\\t                  (and (not= name-part \\\"/\\\")\\n336\\t                       (str/includes? name-part \\\"/\\\")))\\n337\\t          (reader-error! (str \\\"Invalid keyword token: \\\" tok) {:token tok :index i}))\\n338\\t        (keyword ns-part name-part)))))\\n339\\t\\n340\\t\\n341\\t(declare read-form*)\\n342\\t\\n343\\t\\n344\\t(defn- read-delimited\\n345\\t  \\\"Read zero or more forms until `close-code`, returning `[items next-i]`.\\\"\\n346\\t  [s n i close-code ctx]\\n347\\t  (loop [j i\\n348\\t         items []]\\n349\\t    (let [j (skip-ws-and-comments s n j)]\\n350\\t      (when (>= j n)\\n351\\t        (reader-error! \\\"EOF while reading collection\\\" {:index i}))\\n352\\t      (let [c (char-code (char-at s j))]\\n353\\t        (if (= c close-code)\\n354\\t          [items (inc j)]\\n355\\t          (let [[status val next-j] (read-form* s n j ctx)]\\n356\\t            (if (= :discard status)\\n357\\t              (recur next-j items)\\n358\\t              (recur next-j (conj items val)))))))))\\n359\\t\\n360\\t\\n361\\t(defn- build-checked-map\\n362\\t  [items i]\\n363\\t  (when (odd? (count items))\\n364\\t    (reader-error!\\n365\\t      (str \\\"The map literal starting with \\\" (pr-str (first items))\\n366\\t           \\\" contains \\\" (count items) \\\" form(s). Map literals must contain an even number of forms.\\\")\\n367\\t      {:index i}))\\n368\\t  (reduce (fn [m [k v]]\\n369\\t            (when (contains? m k)\\n370\\t              (reader-error! (str \\\"Map literal contains duplicate key: \\\" (pr-str k))\\n371\\t                             {:key k :index i}))\\n372\\t            (assoc m k v))\\n373\\t          {}\\n374\\t          (partition 2 items)))\\n375\\t\\n376\\t\\n377\\t(defn- build-checked-set\\n378\\t  [items i]\\n379\\t  (reduce (fn [acc x]\\n380\\t            (when (contains? acc x)\\n381\\t              (reader-error! (str \\\"Set literal contains duplicate key: \\\" (pr-str x))\\n382\\t                             {:key x :index i}))\\n383\\t            (conj acc x))\\n384\\t          #{}\\n385\\t          items))\\n386\\t\\n387\\t\\n388\\t(defn- apply-map-namespace\\n389\\t  [ns-str k]\\n390\\t  (cond\\n391\\t    (keyword? k)\\n392\\t    (let [kns (namespace k)]\\n393\\t      (cond\\n394\\t        (nil? kns) (keyword ns-str (name k))\\n395\\t        (= \\\"_\\\" kns) (keyword (name