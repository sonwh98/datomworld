{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' src/cljc/yang/core/lower.cljc; sed -n '388,433p;486,504p;733,781p' antlr/typescript/TypeScriptParser.g4; sed -n '1728,1760p;1078,1116p;1152,1225p;1989,2063p' src/cljc/yang/typescript/antlr/lower.cljc; sed -n '1796,1826p;1938,1965p' src/cljc/yang/typescript/antlr/prelude.cljc; sed -n '1,130p' src/cljc/yang/core/prelude_admission.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,130p' src/cljc/yang/core/lower.cljc; sed -n '388,433p;486,504p;733,781p' antlr/typescript/TypeScriptParser.g4; sed -n '1728,1760p;1078,1116p;1152,1225p;1989,2063p' src/cljc/yang/typescript/antlr/lower.cljc; sed -n '1796,1826p;1938,1965p' src/cljc/yang/typescript/antlr/prelude.cljc; sed -n '1,130p' src/cljc/yang/core/prelude_admission.cljc\"","aggregated_output":"(ns yang.core.lower\n  \"Lowering helpers shared by every language's CST-to-Universal-AST lowering\n   (docs/design/yang.typescript.md §17, lift L2): the CST accessors over a\n   lowering context `{:pk packet ...}`, the generated-name supply, safepoint\n   site marks, and the diagnostic builders. A language supplies its\n   diagnostic namespace (a string such as \\\"yang.python.antlr\\\"), its name\n   for messages and its table of unsupported rules.\"\n  (:require\n    [yang.antlr.packet :as p]\n    [yang.core.uast :as u]))\n\n\n;; =============================================================================\n;; Diagnostics\n;; =============================================================================\n\n(defn unsupported!\n  \"Throw the `<diagnostic-ns>/unsupported` diagnostic for rule node `n`\n   naming `construct`; `language` is the name the message uses.\"\n  [diagnostic-ns language n construct]\n  (throw (ex-info (str \"Unsupported \" language \" construct: \" construct)\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"unsupported\"),\n                   :rule (:rule n),\n                   :construct construct,\n                   :span (:span n)})))\n\n\n(defn syntax!\n  \"Throw the `<diagnostic-ns>/syntax` diagnostic for rule node `n`.\"\n  [diagnostic-ns n message]\n  (throw (ex-info message\n                  {(keyword diagnostic-ns \"diagnostic\")\n                   (keyword diagnostic-ns \"syntax\"),\n                   :rule (:rule n),\n                   :span (:span n)})))\n\n\n(defn default-arm\n  \"The arm of a rule with no lowering: `unsupported!` when `refusals` (rule\n   name to construct) names it, otherwise `<diagnostic-ns>/unhandled-rule`.\"\n  [diagnostic-ns language refusals n]\n  (if-let [construct (get refusals (:rule n))]\n    (unsupported! diagnostic-ns language n construct)\n    (throw (ex-info (str \"Unhandled grammar rule: \" (:rule n))\n                    {(keyword diagnostic-ns \"diagnostic\")\n                     (keyword diagnostic-ns \"unhandled-rule\"),\n                     :rule (:rule n),\n                     :span (:span n)}))))\n\n\n;; =============================================================================\n;; Small helpers\n;; =============================================================================\n\n(defn gen\n  [prefix n]\n  (symbol (str \"%\" prefix (:id n))))\n\n\n(defn kids\n  [ctx n]\n  (p/children (:pk ctx) n))\n\n\n(defn rules\n  [ctx n rule-name]\n  (p/child-rules (:pk ctx) n rule-name))\n\n\n(defn rule-kids\n  [ctx n]\n  (filterv p/rule? (kids ctx n)))\n\n\n(defn site\n  \"`node` marked as a safepoint site of `kind` (`:loop`, `:call`, `:line`),\n   a keyword or a vector `[kind datum ...]`. The mark is map metadata, so it never enters a canonical row: projection\n   puts it in the frontend-metadata side table, where `yang.safepoint`\n   finds it.\"\n  [kind node]\n  (vary-meta node assoc :yang/site kind))\n\n\n(defn app*\n  [op-sym & args]\n  (apply u/app (u/v op-sym) args))\n\n\n(defn contains-rule?\n  \"True when `rule-name` occurs below `n` without crossing any `stop` rule.\"\n  [ctx n rule-name stop]\n  (boolean\n    (some (fn [k]\n            (and (p/rule? k)\n                 (or (= rule-name (:rule k))\n                     (and (not (contains? stop (:rule k)))\n                          (contains-rule? ctx k rule-name stop)))))\n          (kids ctx n))))\n\n\n(defn code-point->str\n  [cp]\n  #?(:cljd (let [sb (StringBuffer)] (.writeCharCode sb cp) (.toString sb))\n     :clj (String. (Character/toChars (int cp)))\n     :cljs (.fromCodePoint js/String cp)))\n\n\n(defn build-vector\n  [vconj elems]\n  (reduce (fn [acc e] (app* vconj acc e)) (u/lit []) elems))\n\nimportStatement\n    : Import importFromBlock\n    ;\n\nimportFromBlock\n    : importDefault? (importNamespace | importModuleItems) importFrom eos\n    | StringLiteral eos\n    ;\n\nimportModuleItems\n    : '{' (importAliasName ',')* (importAliasName ','?)? '}'\n    ;\n\nimportAliasName\n    : moduleExportName (As importedBinding)?\n    ;\n\nmoduleExportName\n    : identifierName\n    | StringLiteral\n    ;\n\n// yield and await are permitted as BindingIdentifier in the grammar\nimportedBinding\n    : Identifier\n    | Yield\n    | Await\n    ;\n\nimportDefault\n    : aliasName ','\n    ;\n\nimportNamespace\n    : ('*' | identifierName) (As identifierName)?\n    ;\n\nimportFrom\n    : From StringLiteral\n    ;\n\naliasName\n    : identifierName (As identifierName)?\n    ;\n\niterationStatement\n    : Do statement While '(' expressionSequence ')' eos                                                                     # DoStatement\n    | While '(' expressionSequence ')' statement                                                                            # WhileStatement\n    | For '(' expressionSequence? SemiColon expressionSequence? SemiColon expressionSequence? ')' statement                 # ForStatement\n    | For '(' varModifier variableDeclarationList SemiColon expressionSequence? SemiColon expressionSequence? ')' statement # ForVarStatement\n    | For '(' singleExpression In expressionSequence ')' statement                                                          # ForInStatement\n    | For '(' varModifier variableDeclaration In expressionSequence ')' statement                                           # ForVarInStatement\n    | For Await? '(' singleExpression identifier {this.p(\"of\")}? expressionSequence (As type_)? ')' statement                            # ForOfStatement\n    | For Await? '(' varModifier variableDeclaration identifier {this.p(\"of\")}? expressionSequence (As type_)? ')' statement             # ForVarOfStatement\n    ;\n\nvarModifier\n    : Var\n    | Let\n    | Const\n    ;\n\ncontinueStatement\n    : Continue ({this.notLineTerminator()}? identifier)? eos\nsingleExpression\n    : anonymousFunction                                           # FunctionExpression\n    | Class identifier? typeParameters? classHeritage classTail   # ClassExpression\n    | singleExpression '?.'? '[' expressionSequence ']'           # MemberIndexExpression\n    | singleExpression '?.' singleExpression                      # OptionalChainExpression\n    | singleExpression '!'? '.' '#'? identifierName typeGeneric?  # MemberDotExpression\n    | singleExpression '?'? '.' '#'? identifierName typeGeneric?  # MemberDotExpression\n    // Split to try `new Date()` first, then `new Date`.\n    | New singleExpression typeArguments? arguments                   # NewExpression\n    | New singleExpression typeArguments?                             # NewExpression\n    | singleExpression arguments                                      # ArgumentsExpression\n    | singleExpression {this.notLineTerminator()}? '++'               # PostIncrementExpression\n    | singleExpression {this.notLineTerminator()}? '--'               # PostDecreaseExpression\n    | Delete singleExpression                                         # DeleteExpression\n    | Void singleExpression                                           # VoidExpression\n    | Typeof singleExpression                                         # TypeofExpression\n    | '++' singleExpression                                           # PreIncrementExpression\n    | '--' singleExpression                                           # PreDecreaseExpression\n    | '+' singleExpression                                            # UnaryPlusExpression\n    | '-' singleExpression                                            # UnaryMinusExpression\n    | '~' singleExpression                                            # BitNotExpression\n    | '!' singleExpression                                            # NotExpression\n    | Await singleExpression                                          # AwaitExpression\n    | <assoc = right> singleExpression '**' singleExpression          # PowerExpression\n    | singleExpression ('*' | '/' | '%') singleExpression             # MultiplicativeExpression\n    | singleExpression ('+' | '-') singleExpression                   # AdditiveExpression\n    | singleExpression '??' singleExpression                          # CoalesceExpression\n    | singleExpression ('<<' | '>' '>' | '>' '>' '>') singleExpression # BitShiftExpression\n    | singleExpression ('<' | '>' | '<=' | '>=') singleExpression     # RelationalExpression\n    | singleExpression Instanceof singleExpression                    # InstanceofExpression\n    | singleExpression In singleExpression                            # InExpression\n    | singleExpression ('==' | '!=' | '===' | '!==') singleExpression # EqualityExpression\n    | singleExpression '&' singleExpression                           # BitAndExpression\n    | singleExpression '^' singleExpression                           # BitXOrExpression\n    | singleExpression '|' singleExpression                           # BitOrExpression\n    | singleExpression '&&' singleExpression                          # LogicalAndExpression\n    | singleExpression '||' singleExpression                          # LogicalOrExpression\n    | singleExpression '?' singleExpression ':' singleExpression      # TernaryExpression\n    | singleExpression '=' singleExpression                           # AssignmentExpression\n    | singleExpression assignmentOperator singleExpression            # AssignmentOperatorExpression\n    | singleExpression templateStringLiteral                          # TemplateStringExpression     // ECMAScript 6\n    | iteratorBlock                                                   # IteratorsExpression          // ECMAScript 6\n    | generatorBlock                                                  # GeneratorsExpression         // ECMAScript 6\n    | generatorFunctionDeclaration                                    # GeneratorsFunctionExpression // ECMAScript 6\n    | yieldStatement                                                  # YieldExpression              // ECMAScript 6\n    | This                                                            # ThisExpression\n    | identifierName singleExpression?                                # IdentifierExpression\n    | Super                                                           # SuperExpression\n    | literal                                                         # LiteralExpression\n\n(defn- lower-assign\n  [ctx n lhs op rhs]\n  (if (member-expression? ctx lhs)\n    (lower-member-assign ctx n lhs op rhs)\n    (lower-name-assign ctx n lhs op rhs)))\n\n\n(defn- lower-name-assign\n  [ctx n lhs op rhs]\n  (let [nm (target-name! ctx lhs)\n        v (gen \"v\" n)]\n    (case op\n      \"=\" (u/let1 v (if (p/rule? rhs \"singleExpression\")\n                      (lower-named ctx rhs nm)\n                      (lower-expr ctx rhs))\n                  (assign-name ctx nm v))\n      (let [bin (get compound-ops op)]\n        (when-not bin\n          (refuse! n (str \"assignment operator \" op) :T4))\n        (u/let1 v\n                (app* (get binary-ops bin) (read-name ctx nm) (lower-expr ctx rhs))\n                (assign-name ctx nm v))))))\n\n\n(defn- lower-args\n  [ctx args-node]\n  (let [al (when args-node (first (rules ctx args-node \"argumentList\")))\n        args (when al (rules ctx al \"argument\"))]\n    (reduce (fn [out a]\n              (let [e (first (rules ctx a \"singleExpression\"))]\n                (if (p/has-token? (:pk ctx) a \"...\")\n                  (app* 'js/args-spread out (lower-expr ctx e))\n                  (app* 'js/vconj out (if e (lower-expr ctx e)\n                                          (read-name ctx (text-of ctx a)))))))\n            (u/lit []) args)))\n\n\n(defn- member-parts\n(defn- refuse-global!\n  \"Permanently refuse (design section 8) the bare identifier `nm` at\n   `callee` when it resolves to the global, not to a declared binding.\"\n  [ctx callee nm]\n  (when (and (= nm (simple-name ctx callee))\n             (= :global (:kind (resolve-name ctx nm))))\n    (refuse! callee nm :never)))\n\n\n(defn- lower-super-call\n  \"`super(args)` in a derived constructor, or an arrow inside it.\"\n  [ctx args]\n  (app* 'js/super-call\n        (app* 'cell/get (u/v (:class-cell ctx)))\n        (nt-node ctx)\n        (u/v (:this-cell ctx))\n        args))\n\n\n(defn- lower-call\n  [ctx n]\n  (let [ks (kids ctx n)\n        callee (first ks)\n        args (lower-args ctx (second ks))]\n    (if (super-expr? ctx callee)\n      (lower-super-call ctx args)\n      (do\n        (refuse-global! ctx callee \"eval\")\n        (if (member-expression? ctx callee)\n          (let [o (gen \"o\" n)\n                ref (member-ref ctx callee false)]\n            (case (:kind ref)\n              :value (u/let1 o\n                             (lower-expr ctx (:obj ref))\n                             (app* 'js/call\n                                   (app* 'js/get-value (u/v o) (:key ref))\n                                   (u/v o)\n                                   args))\n              :private (u/let1 o\n                               (lower-expr ctx (:obj ref))\n                               (app* 'js/call\n                                     (app* 'js/priv-get (u/v o) (:pn ref))\n                                     (u/v o)\n                                     args))\n              :super (u/let1 o\n                             (lower-this-expr ctx)\n                             (app* 'js/call\n                                   (app* 'js/super-get (home-node ctx)\n                                         (:key ref) (u/v o))\n                                   (u/v o)\n                                   args))))\n          (app* 'js/call (lower-expr ctx callee) undefined args))))))\n\n\n(defn- lower-new\n  [ctx n]\n  (let [ks (kids ctx n)\n        callee (second ks)\n        args (first (rules ctx n \"arguments\"))]\n    (when (first (rules ctx n \"typeArguments\")) (refuse! n \"type syntax\" :T8))\n    (refuse-global! ctx callee \"Function\")\n    (app* 'js/construct (lower-expr ctx callee) (lower-args ctx args))))\n\n\n(defn- lower-typeof\n  [ctx operand]\n  (if-let [nm (simple-name ctx operand)]\n    (let [r (resolve-name ctx nm)]\n      (if (= :cell (:kind r))\n        (app* 'js/typeof (read-name ctx nm))\n        (app* 'js/global-typeof (u/lit (jstr nm)))))\n    (app* 'js/typeof (lower-expr ctx operand))))\n\n\n(defn- lower-seq\n  \"The node of an `expressionSequence`: comma sequencing.\"\n  [ctx n]\n  (u/seq-nodes (mapv #(lower-expr ctx %) (rules ctx n \"singleExpression\"))))\n\n\n;; =============================================================================\n;; Statements\n;; =============================================================================\n\n(declare lower-stmt lower-block)\n\n\n(defn statements-of\n  \"The `statement` nodes below a program, function body, block or case\n   clause.\"\n  [ctx n]\n  (let [holder (or (first (rules ctx n \"sourceElements\"))\n                   (first (rules ctx n \"statementList\")))]\n    (if holder\n      (mapv (fn [el]\n              (if (p/rule? el \"sourceElement\")\n                (do (when (token-kid ctx el \"export\")\n                      (refuse! el \"module syntax\" :T7))\n                    (first (rules ctx el \"statement\")))\n                el))\n            (rule-kids ctx holder))\n      [])))\n\n\n(defn- function-statement?\n  [ctx st]\n  (p/rule? (first (rule-kids ctx st)) \"functionDeclaration\"))\n\n\n(defn- lower-for-in\n  \"`for (head in subject) body`: each turn pulls the next key from the\n   `js/for-in-*` walk; `let`/`const` heads get fresh cells per turn.\"\n  [ctx n labels]\n  (let [pk (:pk ctx)\n        body (last (rules ctx n \"statement\"))\n        subject (first (rules ctx n \"expressionSequence\"))\n        vd (first (rules ctx n \"variableDeclaration\"))\n        kind (scope/declaration-kind pk (first (rules ctx n \"varModifier\")))\n        lexical? (contains? #{:let :const} kind)\n        sctx (if lexical? (assoc ctx :scope (:id n)) ctx)\n        it (gen \"it\" n)\n        k (gen \"k\" n)\n        w (gen \"w\" n)\n        {:keys [brk? brk] b :body} (loop-parts ctx n labels sctx body)\n        head (if vd\n               (let [nm (scope/declaration-name pk vd)]\n                 (when-not nm (refuse! vd \"destructuring\" :T4))\n                 (if lexical?\n                   (init-name nm (u/v k))\n                   (assign-name ctx nm k)))\n               (let [target (first (rules ctx n \"singleExpression\"))]\n                 (if (member-expression? ctx target)\n                   (let [ref (member-ref ctx target false)]\n                     (case (:kind ref)\n                       :value (app* 'js/put-value\n                                    (lower-expr ctx (:obj ref))\n                                    (:key ref)\n                                    (u/v k))\n                       :private (app* 'js/priv-set\n                                      (lower-expr ctx (:obj ref))\n                                      (:pn ref)\n                                      (u/v k))\n                       :super (app* 'js/super-set\n                                    (home-node ctx)\n                                    (:key ref)\n                                    (u/v k)\n                                    (lower-this-expr ctx))))\n                   (assign-name ctx (target-name! ctx target) k))))\n        turn (u/then head b)\n        turn (if lexical?\n               (bind-cells (block-pairs (scope-of ctx n)) turn)\n               turn)]\n    (wrap-escape\n      brk?\n      brk\n      (u/let1 it\n              (app* 'js/for-in-start (lower-seq ctx subject))\n              (spin w\n                    []\n                    (u/let1 k\n                            (app* 'js/for-in-next (u/v it))\n                            (u/if-node (app* '= (u/v k) (u/lit :js/done))\n                                       undefined\n                                       (u/then turn (u/app (u/v w) (u/v w)))))\n                    [])))))\n\n\n(defn- lower-iteration\n  [ctx n labels]\n  (let [ks (kids ctx n)\n        k0 (first ks)]\n    (cond\n      (p/token? k0 \"do\") (lower-do ctx n labels)\n      (p/token? k0 \"while\") (lower-while ctx n labels)\n      (token-kid ctx n \"in\") (lower-for-in ctx n labels)\n      (= 2 (count (filter #(p/token? % \";\") ks))) (lower-for ctx n labels)\n      :else (refuse! n \"for-of\" :T5))))\n\n\n(defn- lower-jump\n  [ctx n]\n  (let [label (label-of ctx n)\n                 (if (= (get hs 0) :finally)\n                   ((get hs 1) :js/undefined)\n                   :js/undefined)\n                 (js/unwind-to n))))))]\n    [js/try\n     (fn [body handler]\n       (let [saved (cell/get js.rt/ctx)\n             flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (js/set-handlers! (js/frame :handler r (get saved :handlers)))\n                  (let [v (body)] (do (js/restore! saved) v)))\n              (do (js/restore! saved) (handler r))))\n          (%capture))))]\n    [js/try-finally\n     ;; normal exit runs `fin` here; throw and escapes run it as they\n     ;; unwind through the :finally frame\n     (fn [body fin]\n       (let [saved (cell/get js.rt/ctx)]\n         (do (js/set-handlers! (js/frame :finally fin (get saved :handlers)))\n             (let [v (body)]\n               (do (js/restore! saved) (fin :js/undefined) v)))))]\n    [js/call-ec\n     (fn [f]\n       (let [saved (cell/get js.rt/ctx)\n             flag (cell/new :first)]\n         ((fn [r]\n            (if (= (cell/get flag) :first)\n              (do (cell/set! flag :re-entered)\n                  (f (fn [x]\n                  (js/to-string (js/get-prop e {:js/str \"message\"})))\n           (assoc {} :value (js/snapshot e)))\n         (assoc {} :value e)))]\n    [js/run-main\n     ;; resets the out cell and the context, runs `body` (a function of the\n     ;; module `this`) under the outermost try, and answers\n     ;; {:js/out [[snapshot ...] ...] :js/uncaught snapshot-or-nil}\n     (fn [body]\n       (do (cell/set! js.rt/out [])\n           (cell/set! js.rt/ctx (js/ctx nil))\n           (let [u (js/try (fn [] (do (body :js/undefined) nil))\n                           (fn [e] (js/uncaught e)))]\n             (assoc (assoc {} :js/out (cell/get js.rt/out)) :js/uncaught u))))]\n\n    ;; ------------------------------------------------------------ intrinsics\n    ;; Function code of the intrinsic methods: (fn [this args] ..). `init!`\n    ;; wraps each in a function cell on its prototype.\n    [js/this-string\n     (fn [this]\n       (if (= this :js/undefined)\n         (js/throw-type-error\n           {:js/str \"String.prototype method called on null or undefined\"})\n         (if (= this :js/null)\n           (js/throw-type-error\n             {:js/str \"String.prototype method called on null or undefined\"})\n           (js/to-string this))))]\n    [js/imin (fn [a b] (if (< a b) a b))]\n    [js/imax (fn [a b] (if (< a b) b a))]\n(ns yang.core.prelude-admission\n  \"Constructs declarations/specifications and checks registries; does not publish, link, or execute.\"\n  (:require [clojure.set :as set]\n            [clojure.string :as string]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n\n(defn- refusal\n  [refusal-ns kind data]\n  (merge {(keyword refusal-ns \"refusal\") (keyword refusal-ns kind)} data))\n\n\n(defn host-declaration\n  \"`[n declaration]` for free name `n`: a primitive by its `vm/primitives`\n   profile, a host export `ns/name` by the profile address the registry's\n   host module `ns` publishes and its `:callable-effects` effect set; nil\n   when neither supplies it.\"\n  [registry n]\n  (if-let [profile (vm/profile-of vm/primitives n)]\n    [n profile]\n    (when-let [address (module/host-export-profile registry n)]\n      (let [entry (module/module-entry (:modules registry) (symbol (namespace n)))\n            f (get-in entry [:slice (symbol (name n))])]\n        [n {:yin.k/profile address,\n            :yin.k/effects (get (:callable-effects registry) f #{})}]))))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for module `module-name`.\n   `skip?` (n -> bool) marks free names a requirement already declares;\n   `requires` is the requirement map. A free name nothing supplies is\n   refused with `message` under `refusal-ns` before anything is published.\n   This namespace emits; it never publishes.\"\n  [{:keys [module-name ast exports requires free-names skip? registry message\n           refusal-ns]}]\n  {:name module-name,\n   :ast ast,\n   :exports exports,\n   :requires requires,\n   :primitives\n   (into {}\n         (keep (fn [n]\n                 (when-not (and skip? (skip? n))\n                   (or (host-declaration registry n)\n                       (throw (ex-info message\n                                       (refusal refusal-ns \"undeclared-free\"\n                                                {:name n})))))))\n         free-names)})\n\n\n(defn admit\n  \"Return `registry` when it supplies every one of `host-names`, else refuse\n   it before any program runs, naming each missing export in\n   `:<refusal-ns>/missing`.\"\n  [registry host-names message refusal-ns]\n  (let [missing (vec (sort-by str\n                              (remove #(some? (module/resolve-module\n                                                registry\n                                                (symbol (str (namespace %)\n                                                             \".\"\n                                                             (name %)))))\n                                      host-names)))]\n    (when (seq missing)\n      (throw (ex-info message\n                      (refusal refusal-ns \"host-names\"\n                               {(keyword refusal-ns \"missing\") missing}))))\n    registry))\n\n\n\n\n(defn- reject-profile [kind data]\n  (throw (ex-info \"Prelude profile refused\" (assoc data :yang.prelude/refusal kind))))\n\n\n(defn- portable-data? [x]\n  (cond\n    (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n        (number? x) (char? x)) true\n    (record? x) false\n    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\n    (or (vector? x) (set? x)) (every? portable-data? x)\n    :else false))\n\n\n(defn- module-definitions\n  \"Collect definitions in evaluated expressions, including immediately invoked\n   lambda bodies, without descending into literals or function values.\"\n  [ast]\n  (loop [todo [ast] defs []]\n    (if-let [node (peek todo)]\n      (let [todo (pop todo)]\n        (case (:type node)\n          :application\n          (let [op (:operator node)\n                definition? (and (= :variable (:type op)) (= 'yin/def (:name op)))\n                todo (into todo (:operands node))\n                todo (conj todo (if (= :lambda (:type op)) (:body op) op))]\n            (recur todo (if definition? (conj defs (get-in node [:operands 0 :value])) defs)))\n          :if (recur (into todo [(:test node) (:consequent node) (:alternate node)]) defs)\n          (recur todo defs)))\n      defs)))\n\n\n(defn- profile-closure [profile store registry]\n  (let [required #{:yang.prelude/schema :yang.prelude/id :yang.prelude/revision\n                   :yang.prelude/module :yang.prelude/root-address\n                   :yang.prelude/components :yang.prelude/host-modules\n                   :yang.prelude/max-effects}\n        components (:yang.prelude/components profile)]\n    (when-not (and (map? profile) (portable-data? profile) (= required (set (keys profile)))\n                   (= 1 (:yang.prelude/schema profile))\n                   (keyword? (:yang.prelude/id profile))\n                   (string? (:yang.prelude/revision profile))\n                   (symbol? (:yang.prelude/module profile))\n                   (some? (:yang.prelude/root-address profile))\n                   (vector? components)\n                   (every? #(and (vector? %) (= 2 (count %))\n                                 (symbol? (first %)) (some? (second %))) components)\n                   (map? (:yang.prelude/host-modules profile))\n                   (every? (fn [[host spec]]\n                             (and (keyword? host) (map? spec)\n                                  (boolean? (:required spec))\n                                  (set/subset? (set (keys spec))\n                                               #{:required :min-bits :min-digits :min-max-items})\n                                  (every? (fn [[k v]]\n                                            (or (= k :required)\n                                                (and (integer? v) (not (neg? v))))) spec)))\n                           (:yang.prelude/host-modules profile))\n","exit_code":0,"status":"completed"}}
