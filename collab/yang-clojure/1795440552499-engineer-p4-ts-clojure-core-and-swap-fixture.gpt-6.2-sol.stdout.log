{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\\\\[(clj|impl)/|\\\\[clojure.core' src/cljc/yang/clojure/{prelude,core_impl,core_module}.cljc | rg 'add|sub|mul|div|rem|inc|str|keys|range|pow|less' ; rg -n 'try-orelse|try-finally' src/cljc/yang/rt/effect.cljc; rg -n 'defn .*register|register-.*module' src/cljc/yin/repl.cljc | head -40; rg -n 'defn .*keys|canonical-entries' src/cljc/yin/vm/data.cljc; sed -n '95,135p' deps.edn; sed -n '1,55p' bb.edn; git status --short\"","aggregated_output":"src/cljc/yang/clojure/prelude.cljc:212:    [clj/construct-map (fn [args] (clj/dsg__assoc-pairs {} args 0 (data/count args)))]\n50:    [yrt.effect/try-orelse\n67:       (yrt.effect/try-orelse ctx-cell body handler nil))]\n68:    [yrt.effect/try-finally\n158:                    (yrt.effect/try-finally\n187:     try-value try-orelse try-finally unwind-to call-ec abandon-to call-terminal\n858:                                  module/register-stream-module\n859:                                  module/register-cell-module\n860:                                  (data/register-data-module\n862:                                  (integer/register-integer-module\n568:(defn- canonical-entries [coll]\n572:    :else (wrong-type! 'canonical-entries 0 :map-or-set)))\n616:   ['canonical-entries [1] canonical-entries]\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.shell.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n                                 ;; oracle backend: Datomic Local, in-process,\n                                 ;; run in docker/oracle (dev-scope only)\n                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n{:tasks\n {gen:antlr\n  {:doc \"Generate the pinned grammars-v4 parsers for every target (antlr/*/manifest.edn): Java compiled into build/antlr/<g>/classes, JavaScript in build/antlr/<g>/js, Dart in lib/antlr/<g>; filters after --: --grammar g --target t\"\n   :task (apply shell \"bb\" \"src/dev/build_cache.clj\"\n                \"antlr\" *command-line-args*)}\n\n  autobahn:jolt\n  {:doc \"J6f Autobahn conformance: starts the testee and the Dockerized pinned suite, waits for the READY barrier, runs harness.py per role, collects results/, and shuts both sides down. Usage: bb autobahn:jolt <role> <agent>\"\n   :task (apply shell {:continue true} \"bash\" \"tools/jolt-autobahn/launch.sh\" *command-line-args*)}\n\n  deps:npm\n  {:doc \"Worktree-local npm ci, reused only while input and installed-file digests match\"\n   :task (shell \"bb\" \"src/dev/build_cache.clj\" \"npm\")}\n\n  ;; jolt host lane (experimental, docs/design/yin.repl-jolt-implementation.md)\n  bootstrap:jolt\n  {:doc \"Materialize the jolt-toolchain.edn pins into build/tools/jolt (mise Chez/CMake checked, jolt cloned at the full SHA, never pulled) and write build/tools/jolt-env.sh\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\")))}\n\n  test:jolt-bootstrap-neg\n  {:doc \"Copy/revert the jolt clone under gitignored build/bootstrap-neg (deleted on success, retained on failure) and declare a synthetic patch and prove bootstrap refuses it unapplied or corrupted, then accepts it applied (JOLT_BOOTSTRAP_TEST_DIR selects the source clone)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"src/dev/jolt_bootstrap.clj\" \"--test-negative\")))}\n\n  smoke:jolt\n  {:doc \"J0a baseline smoke under jolt -Srepro -M:jolt: tracked load of yang.antlr.export/packet and defcfn :blocking calls (needs bb bootstrap:jolt; Lane B: --target chez|gambit, the child reports jolt-target and the driver asserts it fail-closed — the gambit child runs the same smoke form under $JOLT_GAMBIT)\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"bb\" \"-cp\" \"src/dev\"\n                         \"src/dev/jolt_target_run.clj\" \"--script\" \"src/dev/jolt_smoke.clj\" \"--\"\n                         *command-line-args*)))}\n\n  jolt\n  {:doc \"Run jolt -Srepro -M:jolt with the arguments given (a script path, -e ...), under build/tools/jolt-env.sh (Lane B: --target chez|gambit; a fail-closed identity preflight child runs first, then the arguments pass through unchanged)\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"bb\" \"-cp\" \"src/dev\"\n                         \"src/dev/jolt_target_run.clj\" \"--\"\n                         *command-line-args*)))}\n\n  smoke:jolt-target\n  {:doc \"Lane B target-aware launcher smoke: run a trivial child under the requested host scheme through the jolt-launch seam (--target chez, the default, or --target gambit via JOLT_GAMBIT) and fail closed unless the child itself reports jolt-target: <target> (needs bb bootstrap:jolt; the gambit leg needs the mise-pinned gsi)\"\n   :task (System/exit\n           (:exit (apply shell {:continue true} \"bb\" \"-cp\" \"src/dev\"\n                         \"src/dev/jolt_target_smoke.clj\"\n                         *command-line-args*)))}\n\n  qualify:jolt-libcrypto\n  {:doc \"J1b requalification: print this platform's observed libcrypto identity {:canonical-path :version-num :version :sha256} for jolt-toolchain.edn :native :libcrypto :qualified (the digest from bb and from the library, required equal); changes nothing (needs a built wrapper: bb build:jolt-native, or --requalify after a library change)\"\n   :task (System/exit\n           (:exit (shell {:continue true} \"bb\" \"-cp\" \"src/dev\" \"native/jolt-crypto/qualify.clj\")))}\n\n  probe:jolt-crypto\n  {:doc \"J1b: libcrypto provenance (qualified, missing, undeclared, version-floor, wrong-library-first, Linux 