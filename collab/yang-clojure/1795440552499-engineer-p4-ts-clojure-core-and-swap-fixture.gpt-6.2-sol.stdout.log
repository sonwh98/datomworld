er/compare b 0))\n         (clj.py/_math-error :math/div-zero a b)\n         (clj.py/_int-result (operation a b))))]\n    [clj.py/_float-result\n     (fn [x a b]\n       (if (= x :yin.vm.float/div-zero) (clj.py/_math-error :math/div-zero a b)\n         (if (= x :yin.vm.float/underflow) (clj.py/_math-error :math/underflow a b)\n           x)))]\n    [clj.py/_arithmetic\n     (fn [iop fop a b]\n       (let [ak (clj.py/_num-kind a) bk (clj.py/_num-kind b)]\n         (if (if (= ak :other) true (= bk :other))\n           (clj.py/_error :type-error (assoc {} :a a :b b))\n           (if (if (= ak :int) (= bk :int) false)\n             (clj.py/_int-result (iop a b))\n             (clj.py/_float-result (fop (clj.py/_float a) (clj.py/_float b)) a b)))))]\n    [clj.py/add\n     (fn [a b]\n       (if (if (data/string? a) (data/string? b) false)\n         (data/str-concat a b)\n         (clj.py/_arithmetic integer/add float/add a b)))]\n    [clj.py/sub (fn [a b] (clj.py/_arithmetic integer/sub float/sub a b))]\n    [clj.py/mul (fn [a b] (clj.py/_arithmetic integer/mul float/mul a b))]\n    [clj.py/truediv\n     (fn [a b]\n       (clj.py/_arithmetic\n         (fn [a b] (clj.py/_div-nonzero integer/true-div-boxed a b))\n         float/div-checked a b))]\n    [clj.py/_divmod\n     (fn [a b i]\n       (data/nth (clj.py/_arithmetic\n                   (fn [a b] (clj.py/_div-nonzero integer/floor-div-mod a b))\n                   float/floordiv-mod a b)\n                 i))]\n    [clj.py/floordiv (fn [a b] (clj.py/_divmod a b 0))]\n    [clj.py/mod (fn [a b] (clj.py/_divmod a b 1))]\n    [clj.py/_float-pow\n     (fn [a b]\n       (if (< (integer/compare b 0) 0)\n         (if (float/zero? a)\n           (clj.py/_math-error :math/div-zero a b)\n           (clj.py/_float-result\n             (float/neg-pow a (clj.py/_int-result (integer/neg b)) :half) a b))\n         (float/fpow-half a b)))]\n    [clj.py/pow\n     (fn [a b]\n       (let [ak (clj.py/_num-kind a) bk (clj.py/_num-kind b)]\n         (if (if (= ak :other) true (= bk :other))\n           (clj.py/_error :type-error (assoc {} :a a :b b))\n           (if (= bk :float)\n             (if (float/finite? b)\n               (let [n (float/floor-int b)]\n                 (if (= n :yin.vm.float/out-of-range)\n                   (clj.py/_math-error :math/overflow a b)\n                   (if (= 0 (integer/compare-float-boxed n b))\n                     (clj.py/_float-pow (clj.py/_float a) n)\n                     (clj.py/_math-error :math/pow-fractional a b))))\n               (clj.py/_math-error :math/pow-infinite a b))\n             (if (if (= ak :int) (<= 0 (integer/compare b 0)) false)\n               (clj.py/_int-result (integer/pow a b))\n               (clj.py/_float-pow (clj.py/_float a) b))))))]\n    [clj.py/neg\n     (fn [x]\n       (if (integer/integer? x) (clj.py/_int-result (integer/neg x))\n         (if (data/float64? x) (float/neg x)\n           (clj.py/_error :type-error (assoc {} :value x)))))]\n    [clj.py/pos\n     (fn [x] (if (= :other (clj.py/_num-kind x))\n               (clj.py/_error :type-error (assoc {} :value x))\n               x))]\n    [clj.py/eq (fn [a b] (data/equiv a b))]\n    [clj.py/ne (fn [a b] (not (data/equiv a b)))]\n    [clj.py/_compare\n     (fn [a b]\n       (let [ak (clj.py/_num-kind a) bk (clj.py/_num-kind b)]\n         (if (= ak :int)\n           (if (= bk :int) (integer/compare a b)\n             (if (= bk :float) (integer/compare-float-boxed a b)\n               (clj.py/_error :type-error (assoc {} :a a :b b))))\n           (if (= ak :float)\n             (if (= bk :float) (float/compare a b)\n               (if (= bk :int)\n                 (let [order (integer/compare-float-boxed b a)]\n                   (if (integer/integer? order) (- 0 order) order))\n                 (clj.py/_error :type-error (assoc {} :a a :b b))))\n             (if (if (data/string? a) (data/string? b) false)\n               (data/str-compare a b)\n               (clj.py/_error :type-error (assoc {} :a a :b b)))))))]\n    [clj.py/lt (fn [a b] (= -1 (clj.py/_compare a b)))]\n    [clj.py/le (fn [a b] (let [c (clj.py/_compare a b)] (if (= c -1) true (= c 0))))]\n    [clj.py/gt (fn [a b] (= 1 (clj.py/_compare a b)))]\n    [clj.py/ge (fn [a b] (let [c (clj.py/_compare a b)] (if (= c 1) true (= c 0))))]\n    [clj.py/lnot (fn [x] (not x))]\n    [clj.py/truthy (fn [x] (if x true false))]\n    [clj.py/int-lit (fn [hex] (clj.py/_int-result (integer/parse hex 16)))]])\n\n\n(def ^:private collections\n  '[[clj.py/vconj (fn [xs x] (conj xs x))]\n    [clj.py/list (fn [xs] xs)]\n    [clj.py/tuple (fn [xs] xs)]\n    [clj.py/_build\n     (fn [acc xs i n step]\n       (if (< i n)\n         (clj.py/_build (step acc (data/nth xs i)) xs (+ i 1) n step)\n         acc))]\n    [clj.py/set-from\n     (fn [xs] (clj.py/_build #{} xs 0 (data/count xs)\n                             (fn [acc x] (conj acc (clj/collection-key x)))))]\n    [clj.py/map-from\n     (fn [xs] (clj.py/_build {} xs 0 (data/count xs)\n                             (fn [acc pair]\n                               (assoc acc (clj/collection-key (data/nth pair 0))\n                                      (data/nth pair 1)))))]\n    [clj.py/get-item\n     (fn [xs k]\n       (if (data/vector? xs)\n         (if (integer/integer? k)\n           (let [i (if (< (integer/compare k 0) 0) (integer/add (data/count xs) k) k)]\n             (if (data/contains? xs i) (data/nth xs i)\n               (clj.py/_error :index-error (assoc {} :index k))))\n           (clj.py/_error :type-error (assoc {} :index k)))\n         (if (data/map? xs)\n           (if (cell/authentic? xs)\n             (clj.py/_error :type-error (assoc {} :value xs))\n             (let [key (clj/collection-key k)]\n               (if (data/contains? xs key) (clj/prim-get xs key)\n                 (clj.py/_error :key-error (assoc {} :key k)))))\n           (clj.py/_error :type-error (assoc {} :value xs)))))]\n193:(defn select\n203:   :yang.frontend/preferred [id revision] when it matches.\"\n216:        [preferred-id preferred-revision] (:yang.frontend/preferred catalog)\n217:        preferred (when (and (nil? revision) (empty? pins) (= id preferred-id)\n218:                             (some #{preferred-revision} matching))\n219:                    preferred-revision)]\n225:          (and (nil? preferred) (next matching))\n227:          :else (let [k [id (or preferred (first matching))]]\n(ns yang.typescript.antlr.cst\n  \"The TypeScript parser worker (docs/design/yang.typescript.md section 5): the\n   grammars-v4 typescript grammar, patched by `ts-g4-1`, as a profile over the\n   generic `yang.antlr.cst` worker. The generated recognizers come from\n   `bb gen:antlr` (antlr/typescript/manifest.edn); the JVM is the only local\n   target. The entry rule is `program`.\n\n   The dialect is worker configuration read by a semantic predicate in the\n   parser base class: in `:ts` a `<...>` followed by `(` is type arguments, in\n   `:js` it is relational. Template-literal depth and regex-versus-division\n   context are tracked by the lexer base class.\"\n  (:require\n    [yang.antlr.cst :as cst]\n    [yang.stage :as stage])\n  (:import\n    (yang.typescript.antlr.gen\n      TypeScriptLexer\n      TypeScriptParser)))\n\n\n(def grammar-id\n  \"grammars-v4 typescript at its pinned revision, patched by ts-g4-2\n   (ts-g4-1 plus the T3 class patches), generated by ANTLR 4.13.2.\"\n  \"grammars-v4/typescript@85e2dd1779ce556111ef98ead5d62a9858e95599+ts-g4-2 antlr-4.13.2\")\n\n\n(defn profile\n  \"The grammar profile for `dialect`, `:ts` or `:js`.\"\n  [dialect]\n  (assert (#{:ts :js} dialect) \"dialect is :ts or :js\")\n  {:grammar-id grammar-id,\n   :make-lexer (fn [cs] (TypeScriptLexer. cs)),\n   :make-parser (fn [ts]\n                  (doto (TypeScriptParser. ts)\n                    (.setTsDialect (= :ts dialect)))),\n   :start (fn [^TypeScriptParser p] (.program p))})\n\n\n(defn make-worker\n  \"A worker for `dialect` (default `:ts`); a worker serves one dialect.\"\n  ([] (make-worker :ts))\n  ([dialect] (cst/make-worker (profile dialect))))\n\n\n(defn parse-source\n  \"Parse one complete source string as unit `unit`: the CST packet.\"\n  ([source] (parse-source (make-worker) [:unit 0] source))\n  ([worker unit source] (cst/parse-unit worker unit source)))\n\n\n(defn- with-options\n  \"`transform` with every packet it writes carrying `:yang.cst/options`,\n   `{:dialect dialect}`, so the lowering reads the dialect from the packet.\"\n  [transform dialect]\n  (fn [state event]\n    (let [[state' outputs] (transform state event)]\n      [state'\n       (mapv (fn [[port value]]\n               [port\n                (if (map? value)\n                  (assoc value :yang.cst/options {:dialect dialect})\n                  value)])\n             outputs)])))\n\n\n(defn open-stage\n  \"A parser stage reading source events from `source-stream` and writing\n   CST packets to `cst-stream`, with its own worker for `dialect` (default\n   `:ts`). Every packet carries `:yang.cst/options {:dialect dialect}`.\"\n  ([source-stream cst-stream] (open-stage source-stream cst-stream :ts))\n  ([source-stream cst-stream dialect]\n   (assoc (stage/open source-stream {:cst cst-stream} {})\n          ::transform (with-options (cst/parse-transform (make-worker dialect))\n                        dialect))))\n\n\n(defn step-stage\n  [s]\n  (stage/step s (::transform s)))\n","exit_code":0,"status":"completed"}}
