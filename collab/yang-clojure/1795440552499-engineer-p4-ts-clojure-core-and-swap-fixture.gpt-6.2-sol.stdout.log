{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'derivation|provenance' src/cljc/yang/frontend.cljc src/cljc/yang/python/antlr/{publication,repl}.cljc test/yang/python/antlr/descriptor_profile_test.cljc | head -110; sed -n '2675,2740p' src/cljc/yin/repl.cljc; sed -n '152,165p' src/cljc/yang/frontend.cljc; git status --short\n\"","aggregated_output":"test/yang/python/antlr/descriptor_profile_test.cljc:32:                                     :derivation :trusted})))))\ntest/yang/python/antlr/descriptor_profile_test.cljc:91:             ['cell/dsg__provenance :reserved-door]\ntest/yang/python/antlr/descriptor_profile_test.cljc:365:        derivation (val (first (:frontend-derivations advanced)))]\ntest/yang/python/antlr/descriptor_profile_test.cljc:371:    (is (= \"clojure-core-v1\" (:yang.frontend/revision derivation)))\ntest/yang/python/antlr/descriptor_profile_test.cljc:373:                (map derivation [:yang.frontend/lowering-profile :yang.frontend/runtime-profile\ntest/yang/python/antlr/descriptor_profile_test.cljc:377:           (:yang.frontend/runtime-closure derivation)))))\n  \"Answer one shell command.  Unsupported arguments are answered as text, not\n   thrown, so a mistyped command cannot end a step.\"\n  [state form]\n  (let [[command & args] form]\n    (case command\n      vm (let [vm-type (first args)]\n           (if (contains? vm-constructors vm-type)\n             [(rebuild-session state vm-type)\n              (str \"Switched to \" (get vm-labels vm-type)\n                   (if (store/retain-on-reset? (:index-store state))\n                     \" (VM store cleared; durable code index kept)\"\n                     \" (store cleared)\"))]\n             [state (str \"Error: Unknown Yin REPL VM type \" (pr-str vm-type)\n                         \"; supported: \"\n                         (pr-str (vec (keys vm-constructors))))]))\n      lang (let [lang (first args)]\n             (if (usable-binding (select-frontend (:frontends state) lang))\n               [(switch-lang state lang)\n                (str \"Switched to \" lang)]\n               [state (str \"Error: unavailable-parser: Yin REPL language \"\n                           (pr-str lang) \" is not in the frontend catalog; \"\n                           (installed-text (:frontends state)))]))\n      compile [state (render-compile-output\n                       state\n                       (compile-command-ast state (first args)))]\n      trust (trust-command state command args)\n      untrust (trust-command state command args)\n      trusted [state (str \"Own: \" (pr-str (first (:own (:link-source state))))\n                          \"\\nTrusted: \"\n                          (pr-str (vec (sort (:trusted (:admission state))))))]\n      reset [(rebuild-session\n               (configure-admission state (:initial-admission state))\n               (:vm-type state))\n             (str (get vm-labels (:vm-type state)) \" reset\")]\n      use-store (swap-store state args)\n      abandon (abandon-pending state)\n      help [state help-text]\n      repl-state [state (format-value (repl-state state))]\n      quit [(assoc state :running? false) \"Bye\"]\n      telemetry [state telemetry-text]\n      host [state host-text]\n      [state (str \"Error: Unknown Yin REPL command \" (pr-str command))])))\n\n\n(defn- eval-compiled\n  \"Evaluate a program `compile-input` or `compile-source` lowered.  What\n   its lowering left (`::frontend`: the session and the `:render` hook) is\n   staged on the round and committed only where the round's VM state\n   survives: when the program halts, now or when its parked require\n   completes (`finalize-eval`).  A round that fails, rolls back, or is\n   abandoned keeps the shell's previous `:frontend-session`.\"\n  [state ast]\n  (let [staged (::frontend (meta ast))\n        [state' text] (eval-program (cond-> state\n                                      staged (assoc ::frontend staged))\n                                    ast)\n        admitted? (and (:derivation staged) (not= (:round state) (:round state')))]\n    [(cond-> (dissoc state' ::frontend)\n       admitted? (assoc-in [:frontend-derivations (round-id state')] (:derivation staged)))\n     text]))\n\n\n(defn- eval-parsed*\n  \"The parse dispatch of one line, against a shell with no require to\n   re-check.\"\n  [state trimmed parsed]\n;; =============================================================================\n;; Catalog (section 3.3)\n;; =============================================================================\n\n(def empty-catalog\n  \"The catalog with no frontend installed.\"\n  {:yang.frontend/entries {}})\n\n\n(defn- entry-key\n  [m]\n  [(:yang.frontend/id m) (:yang.frontend/revision m)])\n\n\n M src/cljc/yang/typescript/antlr/lower.cljc\n?? src/cljc/yang/typescript/antlr/clj_runtime.cljc\n?? src/cljc/yang/typescript/antlr/contract.cljc\n?? src/cljc/yang/typescript/antlr/profiles.cljc\n","exit_code":0,"status":"completed"}}
