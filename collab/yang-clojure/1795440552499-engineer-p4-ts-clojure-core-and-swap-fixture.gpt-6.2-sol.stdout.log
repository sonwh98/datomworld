")\nbb.edn:289:             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\nbb.edn:292:  {:doc \"Release-compile the browser demo (shadow-cljs build :demo) to public/js/main.js\"\nbb.edn:305:  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\nbb.edn:312:  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\nbb.edn:314:             :task (shell \"bb src/dev/cljd_agg.clj\")}\nbb.edn:326:  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\nbb.edn:329:                              \"bb src/dev/cljd_agg.clj\")}\nbb.edn:340:                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\nbb.edn:348:  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\nbb.edn:351:                               \"bb src/dev/cljd_agg.clj --slow-only\")}\nbb.edn:354:             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\nbb.edn:357:            :depends [test:all:clj test:all:cljs test:all:cljd]}\nbb.edn:360:        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\nbb.edn:399:  test:changed:cljd {:doc \"Dart lane of test:changed\"\nbb.edn:403:                                           \"--lane\" \"cljd\"\nbb.edn:446:  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\nbb.edn:453:                                         \"--lane\" \"cljd\"\nsrc/dev/yang_ts_oracle.clj:6:;; Reads test/resources/yang/typescript/t1_corpus.edn. For each entry the\nsrc/dev/yang_ts_oracle.clj:22:(def dir \"test/resources/yang/typescript/\")\nsrc/dev/quick_sharded_test.clj:214:                           [[\"src/cljc/yang/typescript.cljc\"] :foundation]\ntest/yang/typescript/antlr/global_write_test.cljc:27:    [yang.typescript.antlr.lower :as lower]\ntest/yang/typescript/antlr/global_write_test.cljc:28:    [yang.typescript.antlr.lower-portable-test :as portable]\ntest/yang/typescript/antlr/source_call_test.cljc:16:    [yang.typescript.antlr.lower :as lower]\ntest/yang/call/EXCEPTION_R0.md:95:JS R1: `src/cljc/yang/typescript/antlr/prelude.cljc:1581` applies source code\ntest/yang/typescript/antlr/string_forms_test.cljc:15:            [yang.typescript.antlr.lower :as lower]\ntest/yang/typescript/antlr/string_forms_test.cljc:16:            [yang.typescript.antlr.lower-portable-test :as portable]\ntest/yang/typescript/antlr/safepoint_test.clj:15:    [yang.typescript.antlr.lower :as lower]\ntest/yang/typescript/antlr/corpus_test.cljc:22:    [yang.typescript.antlr.lower :as lower]\ntest/yang/typescript/antlr/corpus_test.cljc:45:  (edn/read-string (read-text (str \"test/resources/yang/typescript/\" nm))))\ntest/yang/typescript/antlr/lower_portable_test.cljc:1:(ns yang.typescript.antlr.lower-portable-test\ntest/yang/typescript/antlr/lower_portable_test.cljc:12:    [yang.typescript.antlr.lower :as lower]))\ntest/yang/call/depth_probe_test.clj:39:            [yang.typescript.antlr.lower :as ts-lower]\ntest/yang/typescript_callsite_test.cljc:33:   `yang.typescript.antlr.lower-portable-test`, so no local parser is\ntest/yang/typescript_callsite_test.cljc:48:            [yang.typescript.antlr.lower :as lower]\ntest/yang/typescript_callsite_test.cljc:49:            [yang.typescript.antlr.lower-portable-test :as portable]\ntest/yang/typescript/antlr/linked_prelude_test.cljc:17:    [yang.typescript.antlr.lower :as lower]\ntest/yang/typescript/antlr/linked_prelude_test.cljc:18:    [yang.typescript.antlr.lower-portable-test :as portable]\ntest/yang/typescript/antlr/lower_test.clj:1:(ns yang.typ