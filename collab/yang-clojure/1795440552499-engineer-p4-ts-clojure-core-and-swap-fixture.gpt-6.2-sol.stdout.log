            (u/if-node (app* 'js/strict-eq (u/v t) (u/lit :js/null))\n1292:                                           (app* 'js/get-value (u/v t) key)))))\n1293:      \"instanceof\" (app* 'js/instanceof (lower-expr ctx a) (lower-expr ctx b))\n1294:      \"in\" (app* 'js/in-op (lower-expr ctx a) (lower-expr ctx b))\n1300:(defn- lower-array\n1318:    (app* 'js/new-array\n1321:                      :hole (app* 'js/vconj out (u/lit :js/hole))\n1322:                      :spread (app* 'js/args-spread out value)\n1323:                      (app* 'js/vconj out value)))\n1327:(defn- property-key\n1333:      {:key (app* 'js/to-property-key\n1341:         :hint (:js/str lit),\n1342:         :proto? (= (:js/str lit) \"__proto__\")})\n1343:      :else {:key (app* 'js/to-property-key\n1347:(defn- lower-object-member\n1357:          (app* 'js/literal-proto! (u/v o) (lower-expr ctx v))\n1358:          (app* 'js/create-data-prop!\n1363:      (app* 'js/create-data-prop!\n1365:            (app* 'js/to-property-key\n1370:        (app* 'js/create-data-prop! (u/v o) (u/lit (jstr t)) (read-name ctx t)))\n1374:        (app* 'js/create-data-prop!\n1385:          (app* 'js/define-accessor-half!\n1396:(defn- lower-object\n1400:            (app* 'js/new-object)\n1411:(defn- class-key\n1424:(defn- element-ctx\n1442:(defn- lower-class-field\n1461:                            (app* 'js/define-field!\n1465:      {:steps [[:do (app* 'js/add-field!\n1472:(defn- lower-class-member\n1494:            (app* 'js/def-static-private! F (:key kinfo) (u/lit kind) fnode)\n1496:            (app* 'js/add-priv-method! F (:key kinfo) (u/lit kind) fnode)\n1498:            (app* 'js/def-class-method! target (:key kinfo) fnode)\n1500:            (app* 'js/def-class-accessor! target (:key kinfo) (u/lit kind) fnode)))]\n1518:(defn- lower-static-block\n1531:(defn- lower-class-element\n1546:(defn- default-constructor-code\n1557:                           (u/then (app* 'js/super-call\n1562:                                   (app* 'js/this-after-super (u/v thisc))))\n1566:(defn- lower-class\n1616:                           [[:do (app* 'js/static-init! (u/v F) (build-vector statics))]]))\n1625:                               [sym (app* 'js/private-name (u/lit (jstr nm)))])\n1628:                         [h (app* 'js/class-heritage\n1631:                                    (u/lit :js/none)))]\n1632:                         [proto (app* 'js/make-object\n1634:                         [F (app* 'js/make-class\n1649:(defn- lower-primary\n1659:        \"null\" (u/lit :js/null)\n1667:(defn- lower-expr\n1682:      (app* 'js/priv-has\n1712:(defn- lower-named\n1728:(defn- lower-seq\n1741:(defn statements-of\n1758:(defn- function-statement?\n1763:(defn- hoisted-init\n1770:(defn lower-stmts\n1777:(defn- lower-block\n1786:(defn- lower-var\n1806:(defn- lower-enum\n1816:        init (init-name nm (app* 'js/make-object))]\n1830:                                     (app* 'js/add (u/v previous)\n1833:                      forward (app* 'js/create-data-prop!\n1835:                      reverse (app* 'js/create-data-prop!\n1837:                                    (app* 'js/to-string (u/v value))\n1838:                                    (app* 'js/to-string key))]\n1843:                                      (app* '= (app* 'js/typeof (u/v value))\n1851:(defn- lower-if\n1860:(defn- loop-parts\n1880:(defn- spin\n1890:(defn- lower-while\n1905:(defn- lower-do\n1921:(defn- for-sections\n1944:(defn- lower-for\n1991:(defn- lower-for-in\n1993:   `js/for-in-*` walk; `let`/`const` heads get fresh cells per turn.\"\n2016:                       :value (app* 'js/put-value\n2020:                       :private (app* 'js/priv-set\n2024:                       :super (app* 'js/super-set\n2038:              (app* 'js/for-in-start (lower-seq ctx subject))\n2042:                            (app* 'js/for-in-next (u/v it))\n2043:                            (u/if-node (app* '= (u/v k) (u/lit :js/done))\n2049:(defn- lower-iteratio