{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/core/semantics.cljc && cat test/yang/python/antlr/descriptor_profile_test.cljc'","aggregated_output":"(ns yang.core.semantics\n  \"Portable descriptor data and admission against content-addressed runtime exports.\"\n  (:require [clojure.string :as str]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yang.core.uast :as u]\n            [yang.frontend :as frontend]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n\n(defn- refuse! [defect evidence]\n  (throw (ex-info \"Semantics descriptor refused\"\n                  (frontend/refused :yang.semantics/invalid-descriptor\n                                    (assoc evidence :defect defect)))))\n\n\n(defn- address-matches? [address value]\n  (and (jing/segment-address? address)\n       (jing/segment-bytes-match? address (jing/canonical-bytes value))))\n\n\n(defn capability [descriptor key]\n  (get-in descriptor [:yang.semantics/capabilities key] :refused))\n\n\n(defn literal\n  \"Emit a literal for an already decoded value. For raw-or-call, supply\n   the magnitude bit count and the portable operand for the overflow hook.\"\n  ([descriptor key value]\n   (literal descriptor key value nil nil))\n  ([descriptor key value bits overflow-operand]\n   (let [strategy (get-in descriptor [:yang.semantics/literals key])]\n     (case (:kind strategy)\n       :raw (u/lit (get strategy :value value))\n       :float64-raw (u/lit (cbor/float64 value))\n       :tagged-map (u/lit {(:tag strategy) value})\n       :raw-or-call (if (<= bits (:safe-max-bits strategy))\n                      (u/lit value)\n                      (u/app (u/v (:overflow-op strategy)) (u/lit overflow-operand)))))))\n\n\n(defn- literal-strategy? [[_ strategy]]\n  (and (map? strategy)\n       (case (:kind strategy)\n         :raw (every? #{:kind :value} (keys strategy))\n         :float64-raw (= #{:kind} (set (keys strategy)))\n         :tagged-map (and (= #{:kind :tag} (set (keys strategy))) (keyword? (:tag strategy)))\n         :raw-or-call (and (= #{:kind :safe-max-bits :overflow-op} (set (keys strategy)))\n                           (int? (:safe-max-bits strategy))\n                           (<= 0 (:safe-max-bits strategy) 53)\n                           (some? (:overflow-op strategy)))\n         false)))\n\n\n(defn- module-symbol? [x] (and (symbol? x) (nil? (namespace x))))\n\n\n(defn- validate-schema! [descriptor]\n  (let [{:yang.semantics/keys [schema id syntax prelude-module ambient-modules capabilities\n                              literals hooks ambient-projections]} descriptor]\n    (when-not (and (= #{:yang.semantics/schema :yang.semantics/id :yang.semantics/syntax\n                        :yang.semantics/prelude-module :yang.semantics/ambient-modules\n                        :yang.semantics/capabilities :yang.semantics/literals\n                        :yang.semantics/hooks :yang.semantics/ambient-projections}\n                      (set (keys descriptor)))\n                   (nil? (frontend/non-portable-path descriptor []))\n                   (= 1 schema) (qualified-keyword? id) (keyword? syntax)\n                   (module-symbol? prelude-module) (vector? ambient-modules)\n                   (every? (fn [{:keys [module address] :as pin}]\n                             (and (map? pin) (= #{:module :address} (set (keys pin)))\n                                  (module-symbol? module) (jing/segment-address? address)))\n                           ambient-modules)\n                   (map? capabilities)\n                   (every? qualified-keyword? (keys capabilities))\n                   (every? #{:cell :single-assignment :supported :refused :ambient-only}\n                           (vals capabilities))\n                   (map? literals) (every? keyword? (keys literals))\n                   (every? literal-strategy? literals)\n                   (map? hooks) (every? qualified-keyword? (keys hooks))\n                   (map? ambient-projections)\n                   (every? (fn [[alias {:keys [module export kind] :as projection}]]\n                             (and (map? projection) (string? alias) (seq alias)\n                                  (module-symbol? module) (module-symbol? export)\n                                  (every? #{:module :export :kind} (keys projection))\n                                  (or (not (contains? projection :kind))\n                                      (#{:cell-accessor :value} kind))))\n                           ambient-projections))\n      (refuse! :schema {}))))\n\n\n(defn- qualified-hook! [target]\n  (when-not (qualified-symbol? target)\n    (throw (ex-info \"Semantics hooks must be namespace-qualified\"\n                    (frontend/refused :yang.semantics/unqualified-hook {:target target})))))\n\n\n(defn- reserved? [target]\n  (let [ns-name (namespace target)]\n    (or (= target 'yin/def)\n        (str/starts-with? (name target) \"dsg__\")\n        (= ns-name \"yang.safepoint\")\n        (some #(str/ends-with? ns-name %) [\".rt\" \".b\" \".impl\"]))))\n\n\n(defn- definitions [tree]\n  (when-not (and (= :application (:type tree))\n                 (= :lambda (get-in tree [:operator :type])))\n    (refuse! :module-shape {}))\n  (reduce (fn [defs {:keys [type operator operands]}]\n            (if (and (= type :application) (= (:name operator) 'yin/def))\n              (let [[binding expr] operands sym (:value binding)]\n                (when-not (and (= 2 (count operands)) (= :literal (:type binding))\n                               (symbol? sym) (not (contains? defs sym)))\n                  (refuse! :module-definition {:symbol sym}))\n                (assoc defs sym expr))\n              defs))\n          {} (:operands tree)))\n\n\n(defn- verified-definitions [store address manifest]\n  (let [root (:yin.module/tree manifest)\n        tree (get store root)\n        rows (try\n               (if (:rows tree) tree (when (map? tree) (vm/ast->semantic-bytecode tree)))\n               (catch #?(:cljd Object :clj Exception :cljs :default) _ nil))]\n    (when-not (and rows (= (:root rows) root) (nil? (vm/validate-rows rows))\n                   (every? (fn [[id row]]\n                             (and (= id (first row)) (address-matches? id (subvec row 1))))\n                           (:rows rows)))\n      (refuse! :tree-address {:address address :tree root}))\n    (definitions (vm/semantic-bytecode->ast rows))))\n\n\n(defn- closure [descriptor store]\n  (let [pins (:yang.semantics/ambient-modules descriptor)\n        addresses (into {} (map (juxt :module :address)) pins)\n        root (:yang.semantics/prelude-module descriptor)]\n    (when (or (not= (count pins) (count addresses)) (not (contains? addresses root)))\n      (refuse! :module-pins {}))\n    (letfn [(visit [modules active sym address]\n              (when (or (not= address (get addresses sym)) (contains? active sym))\n                (refuse! :module-pins {:module sym :address address}))\n              (if (contains? modules sym)\n                modules\n                (let [manifest (get store address)]\n                  (when-not (and (map? manifest) (address-matches? address manifest)\n                                 (= sym (:yin.module/name manifest))\n                                 (set? (:yin.module/exports manifest))\n                                 (map? (:yin.module/requires manifest)))\n                    (refuse! :manifest-address {:module sym :address address}))\n                  (let [deps (reduce (fn [seen [dep pin]]\n                                       (visit seen (conj active sym) dep pin))\n                                     modules\n                                     (sort-by (comp str first) (:yin.module/requires manifest)))]\n                    (assoc deps sym {:address address\n                                     :exports (:yin.module/exports manifest)\n                                     :definitions (verified-definitions store address manifest)})))))]\n      (let [modules (visit {} #{} root (get addresses root))]\n        (when-not (= (set (keys addresses)) (set (keys modules)))\n          (refuse! :module-pins {}))\n        modules))))\n\n\n(defn- export! [modules target]\n  (let [entry (get modules (symbol (namespace target)))\n        exported (symbol (name target))]\n    (when-not (and (contains? (:exports entry) exported)\n                   (contains? (:definitions entry) exported))\n      (refuse! :export {:target target}))\n    [(:address entry) (get-in entry [:definitions exported])]))\n\n\n(defn- authorize! [roles address target role]\n  (when-not (contains? roles [address target role])\n    (refuse! :export-role {:address address :target target :role role})))\n\n\n(defn- host-arity? [arities n]\n  (let [fixed (filter int? arities)]\n    (or (some #{n} fixed)\n        (and (some #{:variadic} arities)\n             (seq fixed)\n             (<= (apply max fixed) n)))))\n\n\n(defn- callable! [modules store registry roles target role {:keys [arity params call-shapes operands]}]\n  (qualified-hook! target)\n  (when (reserved? target) (refuse! :reserved-door {:target target}))\n  (let [host-address (when-not (contains? modules (symbol (namespace target)))\n                       (module/host-export-profile registry target))\n        [address node] (if host-address [host-address nil] (export! modules target))\n        shapes (or call-shapes #{arity})]\n    (when (and operands (not (contains? shapes (count operands))))\n      (refuse! :arity {:target target :call-shape (count operands)}))\n    (if host-address\n      (let [profile (get store host-address)]\n        (when-not (and (address-matches? host-address profile)\n                       (every? #(host-arity? (:yin.k/arities profile) %) shapes))\n          (refuse! :arity {:target target :call-shapes shapes})))\n      (let [actual (:params node)]\n        (when-not (= :lambda (:type node)) (refuse! :non-lambda {:target target}))\n        (when-not (and (= arity (count actual))\n                       (or (nil? params) (= params actual))\n                       ;; A contract can record optional trailing operands.\n                       (every? #(and (int? %) (<= 0 % arity)) shapes))\n          (refuse! :arity {:target target :params actual :call-shapes shapes}))))\n    (authorize! roles address target role)))\n\n\n(defn validate-descriptor\n  \"Validate portable data, closure pins and each executable field. The trusted\n   frontend contract supplies its hook ABI, the entry signature selected by\n   descriptor id, and the set of [address qualified-export exact-role] grants.\n   The artifact store is an immutable map of manifests, UAST trees or row\n   packets, and any declared host primitive profiles.\"\n  [descriptor {:keys [syntax hooks required-hooks literals required-literals entry-lowering roles]}\n   store registry]\n  (when-not (map? descriptor) (refuse! :schema {}))\n  (validate-schema! descriptor)\n  (when-not (= syntax (:yang.semantics/syntax descriptor))\n    (refuse! :syntax {}))\n  (let [active (:yang.semantics/hooks descriptor)\n        strategies (:yang.semantics/literals descriptor)\n        projections (:yang.semantics/ambient-projections descriptor)\n        entry (get entry-lowering (:yang.semantics/id descriptor))\n        modules (closure descriptor store)]\n    (when-not entry (refuse! :entry-contract {}))\n    (doseq [[role target] (sort-by key active)\n            :when (some? target)]\n      (qualified-hook! target)\n      (when (reserved? target) (refuse! :reserved-door {:target target}))\n      (let [spec (if (= role (:hook entry)) entry (get hooks role))]\n        (when-not spec (refuse! :unknown-role {:role role}))\n        (callable! modules store registry roles target role spec)))\n    (doseq [[role spec] (sort-by key hooks)\n            :when (and (not (some? (get active role)))\n                       (or (= role (:hook entry))\n                           (contains? required-hooks role)\n                           (some #(#{:supported :cell :single-assignment} (capability descriptor %))\n                                 (:required-by spec))))]\n      (refuse! :missing-hook {:role role}))\n    (doseq [key (sort required-literals) :when (not (contains? strategies key))]\n      (refuse! :missing-literal {:literal key}))\n    (doseq [[key {:keys [kind overflow-op]}] (sort-by key strategies)\n            :when (= kind :raw-or-call)]\n      (callable! modules store registry roles overflow-op [:literal key]\n                 (or (get literals key) (refuse! :unknown-role {:literal key}))))\n    (doseq [[alias {:keys [module export kind] :or {kind :cell-accessor}}]\n            (sort-by key projections)]\n      (let [target (symbol (str module) (name export))]\n        (when (reserved? target) (refuse! :reserved-door {:target target}))\n        (let [[address node] (export! modules target)]\n          (case kind\n            :cell-accessor\n            (doseq [[target node arity]\n                    (into [[target node 0]]\n                          (map (fn [[name arity]]\n                                 (let [sym (symbol (str module) name)]\n                                   [sym (second (export! modules sym)) arity])))\n                          [[\"init!\" 0] [\"export\" 1]])]\n              (when-not (and (= :lambda (:type node)) (= arity (count (:params node))))\n                (refuse! :projection-signature {:target target :alias alias})))\n            :value (when-not (= :literal (:type node))\n                     (refuse! :projection-value {:alias alias :target target})))\n          (authorize! roles address target [:projection alias kind]))))\n    descriptor))\n(ns yang.python.antlr.descriptor-profile-test\n  (:require [clojure.string :as str]\n            [clojure.test :refer [deftest is testing]]\n            [dao.host.integer :as host-int]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.mem :as mem]\n            [yang.clojure :as clojure]\n            [yang.core.semantics :as semantics]\n            [yang.core.uast :as u]\n            [yang.frontend :as frontend]\n            [yang.python.antlr.clj-runtime :as runtime]\n            [yang.python.antlr.contract :as contract]\n            [yang.python.antlr.linked-harness :as harness]\n            [yang.python.antlr.lower :as lower]\n            [yang.python.antlr.parser :as parser]\n            [yang.python.antlr.profiles :as profiles]\n            [yin.repl :as repl]\n            [yin.repl.frontends :as frontends]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.module :as module]))\n\n\n(def ^:private composition\n  (delay (let [store (mem/create-content-mem)\n               prepared (profiles/prepare! store [contract/clojure-id])]\n           (assoc prepared :link-source\n                  (link/composition {:content-store store :name-env (:pins prepared)\n                                     :derivation :trusted})))))\n\n\n(defn- descriptor []\n  (get-in @composition [:profiles contract/clojure-id :descriptor]))\n\n\n(defn- packet [source] (parser/parse-source (str source \"\\n\")))\n\n\n(defn- refusal [f]\n  (try (f) nil\n       (catch #?(:cljd Object :clj clojure.lang.ExceptionInfo :cljs ExceptionInfo) e\n         (ex-data e))))\n\n\n(defn- run-program [backend ast registry extra-primitives]\n  (let [pair (link/make-pair)\n        task ((get harness/backends backend)\n              ast\n              (update (harness/composition registry pair) :primitives merge extra-primitives))]\n    (vm/value (first (harness/drive task pair (:link-source @composition))))))\n\n\n(def ^:private engines [:semantic :stack :register])\n(def ^:private modes [:bundled :linked])\n\n\n(defn- lower-test [mode pk]\n  (lower/lower-packet pk {:descriptor (descriptor) :prelude mode}))\n\n\n(defn- entry [mode body resolver]\n  (let [main (u/app (u/v 'clj.py/run-main) body resolver)]\n    (if (= :bundled mode)\n      (runtime/bundled main)\n      (u/annotate-call-sites\n        (u/mark-tails\n          (u/seq-nodes\n            (conj (mapv (fn [{:keys [module]}] (u/app (u/v 'require) (u/lit module)))\n                        (:yang.semantics/ambient-modules (descriptor)))\n                  main)))))))\n\n\n(defn- module-body [pk]\n  (u/lam [lower/globals-sym lower/globals-fn-sym]\n         (lower/lower-module-body pk nil true (descriptor))))\n\n\n(deftest descriptor-validation-test\n  (let [{:keys [artifacts registry contract]} @composition\n        d (descriptor)\n        validate #(semantics/validate-descriptor % contract artifacts registry)\n        replace-add #(assoc-in d [:yang.semantics/hooks :op/add] %)]\n    (is (= d (validate d)))\n    (doseq [[target defect]\n            [['clj.py/neg :arity]\n             ['clj.py/sub :export-role]\n             ['py/add :export]\n             ['cell/dsg__provenance :reserved-door]\n             ['clj/dsg__invoke :reserved-door]\n             ['yin/def :reserved-door]\n             ['clj.py.rt/session :reserved-door]\n             ['py.b/builtins :reserved-door]\n             ['yang.safepoint/poll :reserved-door]\n             ['clojure.core.impl/impl-seq :reserved-door]]]\n      (is (= defect (:defect (refusal #(validate (replace-add target))))) (str target)))\n    (is (= :yang.semantics/unqualified-hook\n           (:reason (refusal #(validate (replace-add 'add))))))\n    (is (= :export-role\n           (:defect (refusal #(validate (assoc-in d [:yang.semantics/literals :int :overflow-op]\n                                                  'clj.py/neg))))))\n    (is (= :export-role\n           (:defect (refusal #(validate (assoc-in d [:yang.semantics/ambient-projections \"inc\" :export]\n                                                  'dec))))))\n    (is (= :projection-signature\n           (:defect (refusal #(validate (assoc-in d [:yang.semantics/ambient-projections \"inc\"]\n                                                  {:module 'clj.py :export 'neg}))))))\n    (is (= :arity\n           (:defect (refusal #(semantics/validate-descriptor\n                               d (assoc-in contract [:entry-lowering contract/clojure-id :call-shapes] #{3})\n                               artifacts registry)))))\n    (let [root (get-in @composition [:pins 'clj.py])\n          manifest (artifacts root)\n          tree (update runtime/module-uast :operands\n                       (fn [operands]\n                         (mapv (fn [node]\n                                 (if (= 'add (get-in node [:operands 0 :value]))\n                                   (assoc-in node [:operands 1] (u/lit 42))\n                                   node))\n                               operands)))\n          tree-address (:root (vm/ast->semantic-bytecode tree))\n          manifest (assoc manifest :yin.module/tree tree-address)\n          address (jing/segment-key manifest)\n          pinned (update d :yang.semantics/ambient-modules\n                         #(mapv (fn [pin] (if (= 'clj.py (:module pin))\n                                            (assoc pin :address address) pin)) %))]\n      (is (= :tree-address\n             (:defect (refusal #(semantics/validate-descriptor\n                                 d contract (assoc artifacts (:yin.module/tree (artifacts root)) tree)\n                                 registry)))))\n      (is (= :non-lambda\n             (:defect (refusal #(semantics/validate-descriptor\n                                 pinned (update contract :roles\n                                                (fn [roles] (into roles (map (fn [[a target role]]\n                                                                              [(if (= a root) address a)\n                                                                               target role])) roles)))\n                                 (assoc artifacts address manifest tree-address tree) registry)))))\n      (is (= :manifest-address\n             (:defect (refusal #(semantics/validate-descriptor\n                                 pinned contract (assoc artifacts address (artifacts root)) registry)))))\n      (is (= :runtime-profile-pins\n             (:defect (refusal #(profiles/admit\n                                 pinned (get-in @composition [:profiles contract/clojure-id :runtime])\n                                 contract artifacts registry {}))))))))\n\n\n(deftest immutable-projection-export-presence-test\n  (let [registry (module/assoc-module nil 'test.values\n                                     {:manifest {:yin.module/name 'test.values}\n                                      :bindings {'empty nil 'off false 'sentinel :clj/unbound}})]\n    (is (nil? (engine/resolve-var {} {} {} registry 'test.values/empty)))\n    (is (false? (engine/resolve-var {} {} {} registry 'test.values/off)))\n    (is (= :clj/unbound (engine/resolve-var {} {} {} registry 'test.values/sentinel)))\n    (is (= 'test.values/missing\n           (:symbol (refusal #(engine/resolve-var {} {} {} registry 'test.values/missing)))))))\n\n\n(deftest capabilities-refuse-before-emission-test\n  (doseq [[source capacity construct]\n          [[\"try:\\n    pass\\nexcept E:\\n    pass\" :control/except-typed \"typed except\"]\n           [\"(x for x in [1, 2])\" :control/generators \"genexpr\"]\n           [\"f(x for x in [1, 2])\" :control/generators \"genexpr\"]\n           [\"def f():\\n    yield 1\" :control/generators \"yield_expr\"]\n           [\"class A:\\n    pass\" :oo/classes \"classdef\"]\n           [\"with a:\\n    pass\" :control/with \"with_stmt\"]\n           [\"del x\" :mutation/delete \"del_stmt\"]\n           [\"x[0] = 1\" :mutation/subscript \"subscript mutation\"]\n           [\"x[0] += 1\" :mutation/subscript \"subscript mutation\"]\n           [\"f(x=1)\" :calls/kwargs \"kwargs\"]\n           [\"def f(x=1):\\n    pass\" :calls/defaults \"defaults\"]]]\n    (let [result (refusal #(lower-test :bundled (packet source)))]\n      (is (= {:status :refused :reason :yang.semantics/unsupported-capability\n              :capability capacity :construct construct :semantics-id contract/clojure-id}\n             (select-keys result [:status :reason :capability :construct :semantics-id]))\n          source)\n      (is (int? (:node result)) source))))\n\n\n(def ^:private numeric-source\n  (str \"[1 + 2, 4 - 1, -2 * +3, 7 / 2, -7 // 2, -7 % 2, 2 ** 4, 2 ** -3, \"\n       \"1 + 2.5, 2.1 // 0.7, -0.0, 1 < 1.5, 1.5 >= 1, \"\n       \"1 == 1.0, 1 == True, 0.0 == -0.0, (1e999 - 1e999) == (1e999 - 1e999), \"\n       \"[None, 1] == [None, 1], {'a': 1} != {'a': 1.0}, \"\n       \"not 0, not None, [] or 99, 'a' + 'b']\"))\n\n(def ^:private numeric-result\n  [3 3 -6 (cbor/float64 3.5) -4 1 16 (cbor/float64 0.125)\n   (cbor/float64 3.5) (cbor/float64 3.0) (cbor/float64 -0.0) true true\n   false false true false true true false true [] \"ab\"])\n\n\n(def ^:private collections-source\n  (str \"from clojure.core import str as render\\n\"\n       \"import clojure.core as core\\n\"\n       \"def sum_even_squares(xs):\\n\"\n       \"    evens = filter(lambda n: n % 2 == 0, xs)\\n\"\n       \"    squares = map(lambda n: n * n, evens)\\n\"\n       \"    return reduce(lambda a, b: a + b, 0, squares)\\n\"\n       \"def varargs(x, *xs):\\n\"\n       \"    return (x, xs)\\n\"\n       \"m = {None: 'nil', 0: 'zero'}\\n\"\n       \"deep = assoc_in({}, ['x', 'y'], 8)\\n\"\n       \"[sum_even_squares([1,2,3,4]), [p for p in m], render(m), {x for x in [2,1,2]}, \"\n       \"{x: x*2 for x in [1,2]}, varargs(*[7,8,9]), core.inc(4), \"\n       \"get_in(update_in(deep, ['x', 'y'], inc), ['x', 'y']), is_empty([]), is_nil(None)]\"))\n\n(def ^:private collections-result\n  [20 [[0 \"zero\"] [nil \"nil\"]] \"{0 \\\"zero\\\", nil \\\"nil\\\"}\" #{1 2}\n   {1 2 2 4} [7 [8 9]] 5 9 true true])\n\n\n(deftest persistent-profile-e2e-test\n  (let [registry (:registry @composition)]\n    (doseq [[source expected] [[numeric-source numeric-result] [collections-source collections-result]]\n            :let [pk (packet source)]\n            mode modes\n            :let [ast (lower-test mode pk)]\n            backend engines]\n      (is (cbor/equiv expected (run-program backend ast registry {}))\n          (str mode \" \" backend)))))\n\n\n(deftest policy-traps-and-guest-cleanup-test\n  (let [source (str \"seen = []\\n\"\n                    \"try:\\n    bad = 9007199254740991 + 1\\n\"\n                    \"except:\\n    seen = conj(seen, 'bits')\\n\"\n                    \"finally:\\n    seen = conj(seen, 'finally')\\n\"\n                    \"try:\\n    bad = 9007199254740992\\n\"\n                    \"except:\\n    seen = conj(seen, 'literal')\\n\"\n                    \"try:\\n    bad = 3.0 / 0.0\\n\"\n                    \"except:\\n    seen = conj(seen, 'zero')\\n\"\n                    \"try:\\n    bad = {[1, 2.0]: 5}\\n\"\n                    \"except:\\n    seen = conj(seen, 'key')\\n\"\n                    \"try:\\n    bad = {2.0 for k in [1]}\\n\"\n                    \"except:\\n    seen = conj(seen, 'set')\\n\"\n                    \"try:\\n    bad = 1 + True\\n\"\n                    \"except:\\n    seen = conj(seen, 'type')\\n\"\n                    \"seen\")\n        registry (profiles/registry {::integer/max-bits 53 ::integer/max-digits 4300})\n        pk (packet source)]\n    (doseq [mode modes :let [ast (lower-test mode pk)] backend engines]\n      (is (= [\"bits\" \"finally\" \"literal\" \"zero\" \"key\" \"set\" \"type\"]\n             (run-program backend ast registry {}))\n          (str mode \" \" backend)))))\n\n\n(def ^:private regression-source\n  (str \"def use_local(x):\\n\"\n       \"    val = x\\n\"\n       \"    return val\\n\"\n       \"def missing_local():\\n\"\n       \"    if False:\\n        val = 5\\n\"\n       \"    return val\\n\"\n       \"try:\\n    missing_local()\\n    local_missing = False\\n\"\n       \"except:\\n    local_missing = True\\n\"\n       \"try:\\n    missing_global\\n    global_missing = False\\n\"\n       \"except:\\n    global_missing = True\\n\"\n       \"m = {key: 9, 0: 'native first', boxed(): 'boxed second'}\\n\"\n       \"[m[key], m[boxed()], m[0], m == {key: 9, 0: 'boxed second'}, \"\n       \"sentinel, use_local(sentinel), local_missing, global_missing]\"))\n\n\n(deftest cross-carrier-keys-and-binding-presence-test\n  (let [body (module-body (packet regression-source))\n        resolver (u/sexp->uast\n                   '(fn [name]\n                      (if (= name \"sentinel\") {:value :clj/unbound}\n                        (if (= name \"key\") {:value :k}\n                          (if (= name \"boxed\")\n                            (assoc {} :value (clj/make-callable {} (fn [args] (boxed-key))))\n                            {})))))\n        expected [9 \"boxed second\" \"boxed second\" true :clj/unbound :clj/unbound true true]\n        registry (:registry @composition)]\n    (doseq [mode modes :let [ast (entry mode body resolver)] backend engines]\n      (is (= expected (run-program backend ast registry {'boxed-key #(host-int/promote 0)}))\n          (str mode \" \" backend)))))\n\n\n(def ^:private unwind-source\n  (str \"def bridge(boom, record):\\n\"\n       \"    try:\\n\"\n       \"        return boom()\\n\"\n       \"    finally:\\n\"\n       \"        record('python')\\n\"\n       \"bridge\"))\n\n\n(deftest clojure-python-clojure-unwind-test\n  (let [python (module-body (packet unwind-source))\n        clj (clojure/lower-unit\n              '[(defn boom []\n                  (try (throw \"escape\")\n                       (finally (record \"clojure-inner\"))))\n                (defn outer []\n                  (try (bridge boom record)\n                       (finally (record \"clojure-outer\"))))\n                outer]\n              '[record bridge])\n        driver (fn [make-python]\n                 (u/let1 '%make-python make-python\n                   (u/let1 '%make-clojure clj\n                     (u/sexp->uast\n                       '(let [trace (cell/new [])\n                              record (clj/make-callable\n                                       {} (fn [args] (cell/set! trace (conj (cell/get trace) (data/nth args 0)))))\n                              bridge (%make-python)\n                              ctx (clj/rt-ctx)]\n                          (do (clj/define-global! \"record\" record)\n                              (clj/define-global! \"bridge\" bridge)\n                              (cell/set! ctx (yrt.effect/ctx nil 4 9 nil))\n                              (let [outer (clj/run-main %make-clojure)\n                                    before (cell/get ctx)\n                                    call (fn []\n                                           (clj/try\n                                             (fn []\n                                               (yrt.effect/handle ctx :unrelated\n                                                 (fn [payload k] (record \"unexpected\"))\n                                                 (fn [] (clj/invoke-callable outer [] []))))\n                                             (fn [e] e)))\n                                    a (call)\n                                    first-restored (data/content= before (cell/get ctx))\n                                    b (call)]\n                                (conj [] a b first-restored\n                                      (data/content= before (cell/get ctx)) (cell/get trace)))))))))]\n    (doseq [mode modes\n            :let [program (driver (u/lam [] (u/app (u/v 'clj.py/run-main) python\n                                                   (u/lam ['name] (u/lit {})))))\n                 