{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,105p' test/yang/typescript/antlr/corpus_test.cljc; sed -n '1,75p' test/yang/typescript/antlr/lower_portable_test.cljc; sed -n '70,82p' src/cljc/yang/core/uast.cljc; cat shadow-cljs.edn | sed -n '1,100p'; sed -n '18,45p;151,179p' deps.edn; rg -n 'publish-module\"'!'\"' src/cljc/yin/vm/linker/publish.cljc | tail -12\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,105p' test/yang/typescript/antlr/corpus_test.cljc; sed -n '1,75p' test/yang/typescript/antlr/lower_portable_test.cljc; sed -n '70,82p' src/cljc/yang/core/uast.cljc; cat shadow-cljs.edn | sed -n '1,100p'; sed -n '18,45p;151,179p' deps.edn; rg -n 'publish-module\"'!'\"' src/cljc/yin/vm/linker/publish.cljc | tail -12\n\"","aggregated_output":"(ns yang.typescript.antlr.corpus-test\n  \"T1 step S7: the committed corpus against the Node oracle, on every host.\n   `t1_packets.edn` holds the JVM parser's CST packet for each corpus entry\n   (there is no TypeScript parser off the JVM), `t1_oracle.edn` what Node\n   prints for the source (an uncaught throw as one `Uncaught <name>:\n   <message>` line, in order). Each host lowers the pinned packet itself,\n   runs it bundled on the four VMs and linked on the three vector VMs, and\n   compares the rendered output line for line with Node's. A disagreement is\n   a frontend defect, not a fixture to edit.\n\n   On the JVM the same test also parses every corpus source and asserts the\n   packet equals the pinned one, so the pins cannot rot. Both fixtures are\n   written by `clojure -M:dev -m yang-ts-oracle` on the JVM with the mise\n   Node recorded in their header, and never regenerated on another host or\n   another Node.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [dao.test-slow :as slow]\n    [yang.typescript.antlr.linked-harness :as linked]\n    [yang.typescript.antlr.lower :as lower]\n    [yang.typescript.antlr.prelude-parity-test :as parity]\n    [yang.typescript.antlr.render :as render]\n    [yin.vm :as vm]\n    #?@(:cljd [[\"dart:io\" :as dart-io]]\n        :clj [[yang.typescript.antlr.cst :as cst]])))\n\n\n(def ^:private pinned-node\n  \"The Node the oracle was generated under (owner decision A12.2 open: the\n   mise Node, not an LTS). Moving it is a regeneration plus a diff review.\"\n  \"v25.6.1\")\n\n\n(defn- read-text\n  [path]\n  #?(:cljd (.readAsStringSync (dart-io/File. path))\n     :clj (slurp path)\n     :cljs (.readFileSync (js/require \"fs\") path \"utf8\")))\n\n\n(defn- read-fixture\n  [nm]\n  (edn/read-string (read-text (str \"test/resources/yang/typescript/\" nm))))\n\n\n(def ^:private corpus-names\n  \"The committed corpora, each `<name>_corpus.edn`, `<name>_oracle.edn` and\n   `<name>_packets.edn`.\"\n  [\"t1\" \"t2\" \"t3\"])\n\n\n(def ^:private enabled-steps\n  \"The steps whose corpus entries run (R14): an entry with a `:step` outside\n   this set is pending its step; an entry without one always runs.\"\n  #{:S6 :S5b :S6b :S8 :G-new :G-is :t3/lower})\n\n\n(def ^:private fixtures*\n  (delay (into {}\n               (map (fn [nm]\n                      [nm {:corpus (read-fixture (str nm \"_corpus.edn\")),\n                           :oracle (read-fixture (str nm \"_oracle.edn\")),\n                           :packets (read-fixture (str nm \"_packets.edn\"))}]))\n               corpus-names)))\n\n\n(defn- enabled?\n  [{:keys [step]}]\n  (or (nil? step) (contains? enabled-steps step)))\n\n\n(defn- by-id\n  [fixture]\n  (into {} (map (juxt :id identity)) (:entries fixture)))\n\n\n(defn- actual-lines\n  \"Node's view of a rendered run: the logged lines, then the uncaught line.\"\n  [{:js/keys [out uncaught]}]\n  (cond-> (vec (mapcat #(str/split % #\"\\n\" -1) out))\n    uncaught (conj (str \"Uncaught \" uncaught))))\n\n\n(defn- attempt\n  [f]\n  (try (actual-lines (render/output (f)))\n       (catch #?(:cljd Object :clj Exception :cljs :default) e\n         [:thrown (ex-message e)])))\n\n\n(deftest fixtures-agree-test\n  (doseq [nm corpus-names\n          :let [{:keys [corpus oracle packets]} (get @fixtures* nm)]]\n    (testing nm\n      (testing \"the corpus is 80 to 130 entries with unique ids\"\n        (is (<= 80 (count corpus) 130))\n        (is (= (count corpus) (count (set (map :id corpus))))))\n      (testing \"the oracle and the packets cover exactly the corpus\"\n        (is (= (map :id corpus) (map :id (:entries oracle))))\n        (is (= (map :id corpus) (map :id (:entries packets)))))\n      (testing \"the oracle header names the pinned Node, and every run exited 0\"\n        (is (= pinned-node (get-in oracle [:header :node])))\n        (is (= pinned-node (get-in packets [:header :node])))\n(ns yang.typescript.antlr.lower-portable-test\n  \"The TypeScript lowering on every host from hand-built CST packets: no\n   parser needed, so this runs on the JVM, Node and Dart. Covers the\n   unknown-rule and typed refusals, tree validation, goldens, the\n   canonical-renaming law, site-mark survival through the projection and\n   the stage transform's routing.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.jing.cbor :as cbor]\n    [yang.core.names :as names]\n    [yang.core.uast :as u]\n    [yang.typescript.antlr.lower :as lower]))\n\n\n(defn packet\n  \"A CST packet from a nested form: `[rule child ...]` for a rule and\n   `[type text]` (type a string) for a token. Spans are zero-width: the\n   lowering reads them only for diagnostics. Ids are preorder, as the\n   parser numbers them, so generated names match a parsed packet's.\"\n  [form]\n  (let [out (volatile! [])]\n    (letfn [(walk\n              [f]\n              (let [id (count @out)]\n                (if (string? (first f))\n                  (vswap! out conj {:id id, :kind :token, :type (first f),\n                                    :text (second f), :span [0 0]})\n                  (do (vswap! out conj nil)\n                      (let [kids (mapv walk (rest f))]\n                        (vswap! out assoc id {:id id, :kind :rule,\n                                              :rule (name (first f)),\n                                              :children kids, :span [0 0]}))))\n                id))]\n      (walk form))\n    {:yang.cst/version 1,\n     :yang.cst/unit [:hand 0],\n     :yang.cst/grammar \"hand\",\n     :yang.cst/outcome :yang.cst/ok,\n     :yang.cst/root 0,\n     :yang.cst/nodes @out,\n     :yang.cst/complete true}))\n\n\n(defn program\n  \"A program packet over the statement forms `stmts`.\"\n  [& stmts]\n  (packet (into [:program\n                 (into [:sourceElements]\n                       (map (fn [s] [:sourceElement [:statement s]]) stmts))]\n                [[\"EOF\" \"<EOF>\"]])))\n\n\n(defn num-expr\n  [text]\n  [:singleExpression [:literal [:numericLiteral [\"DecimalLiteral\" text]]]])\n\n\n(defn name-expr\n  [text]\n  [:singleExpression [:identifierName [:identifier [\"Identifier\" text]]]])\n\n\n(defn var-stmt\n  [modifier id init]\n  [:variableStatement\n   [:varModifier [(str modifier) modifier]]\n   [:variableDeclarationList\n    [:variableDeclaration\n     [:identifierOrKeyWord [:identifier [\"Identifier\" id]]]\n     [\"Assign\" \"=\"]\n     init]]\n   [\"SemiColon\" \";\"]])\n\n\n(defn log-stmt\n\n(defn seq-nodes\n  \"Evaluate every node in order; the value is the last one's.\"\n  [nodes]\n  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n\n\n(defn let1\n  [sym value body]\n  (app (lam [sym] body) value))\n\n\n(defn sexp->uast\n;; shadow-cljs configuration\n;; Source paths come from deps.edn (:paths plus the :cljs alias's\n;; :extra-paths); shadow ignores any :source-paths set here when :deps\n;; is used.\n{:deps {:aliases [:cljs]}\n\n :dev-http {9000 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 ;; V8 defaults to ~984 KiB: recursive guest frames and the\n                 ;; serializers of captured continuations can exhaust it before\n                 ;; Python's 1000-frame guard. 6 MiB fits Linux's 8 MiB native\n                 ;; stack. Re-exec before loading CLJS, covering shadow autorun\n                 ;; AND direct `node ... --test=...` shard invocations.\n                 :prepend \"if (!process.execArgv.includes('--stack-size=6144')) { const child = require('child_process').spawnSync(process.execPath, [...process.execArgv, '--stack-size=6144', ...process.argv.slice(1)], {stdio: 'inherit'}); if (child.error) throw child.error; if (child.signal) process.kill(process.pid, child.signal); else process.exit(child.status); }\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.shell.main/-main\n                        :output-to \"target/yin-repl.js\"}}}\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\" \"build/antlr/php/classes\"\n         \"build/antlr/typescript/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yin.repl.python-antlr-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:clojuredart:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine\n129:;; through the `publish-module!` result's `:call-sites`, not through\n146:  \"An admission scope for `publish-module!`'s `:yin.link.publish/scope`\n265:  \"`publish-module!` under the composition bounds of `opts`.\"\n446:(defn publish-module!\n457:  ([handle spec] (publish-module! handle spec nil))\n498:   `publish-module!` result map (whose `:call-sites :record` and\n548:   `publish-module!` result map or the publication record's address,\n855:  \"`publish-module!`'s spec for the module `name` exporting `exports`,\n888:   (`publish-module!`'s recovered claim, which validates the spec's\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/core/names.cljc | head -95; sed -n '2405,2454p' src/cljc/yin/repl.cljc; rg -n '\"'^  '\"\\\\[ctx|refuse\"'!.*async|refuse!.*generator|:env/global-get'\"' src/cljc/yang/typescript/antlr/lower.cljc | rg 'async|generator|global-get'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/core/names.cljc | head -95; sed -n '2405,2454p' src/cljc/yin/repl.cljc; rg -n '\"'^  '\"\\\\[ctx|refuse\"'!.*async|refuse!.*generator|:env/global-get'\"' src/cljc/yang/typescript/antlr/lower.cljc | rg 'async|generator|global-get'\"","aggregated_output":"(ns yang.core.names\n  \"Canonical renaming of generated names (docs/design/yang.typescript.md\n   §6.3, lift L2). A lowering names its temporaries `%<prefix><cst-id>`; those\n   names are canonical row slots, so the CST ids behind them would leak into\n   content addresses. `canonicalize` renames every generated name to `%<n>`\n   by first occurrence, a pure, idempotent and host-independent function of\n   the finished tree.\"\n  (:require\n    [yin.vm :as vm]))\n\n\n(def ^:private reserved\n  \"Generated-looking names that are not renamed: the sequencing discard and\n   the safepoint stage's reserved binder.\"\n  #{'%_ 'yang.safepoint/_ 'yang.safepoint/value})\n\n\n(defn- generated?\n  [sym]\n  (and (symbol? sym)\n       (nil? (namespace sym))\n       (= \\% (first (name sym)))\n       (not (contains? reserved sym))))\n\n\n(defn- rename\n  \"`[sym' table]`: `sym`'s canonical name, allocated on its first occurrence.\"\n  [table sym]\n  (if (generated? sym)\n    (let [table (if (contains? table sym)\n                  table\n                  (assoc table sym (symbol (str \"%\" (count table)))))]\n      [(with-meta (get table sym) (meta sym)) table])\n    [sym table]))\n\n\n(defn- walk\n  \"`[node' table]`: `node` renamed in preorder over the row grammar's slots.\"\n  [table node]\n  (reduce (fn [[n table] [field kind]]\n            (case kind\n              :sym (let [[s table] (rename table (get n field))]\n                     [(assoc n field s) table])\n              :syms (let [[ss table] (reduce (fn [[out table] s]\n                                               (let [[s table] (rename table s)]\n                                                 [(conj out s) table]))\n                                             [[] table]\n                                             (get n field))]\n                      [(assoc n field ss) table])\n              :node (let [[c table] (walk table (get n field))]\n                      [(assoc n field c) table])\n              :nodes (let [[cs table] (reduce (fn [[out table] c]\n                                                (let [[c table] (walk table c)]\n                                                  [(conj out c) table]))\n                                              [[] table]\n                                              (get n field))]\n                       [(assoc n field cs) table])\n              [n table]))\n          [node table]\n          (get vm/semantic-bytecode-grammar (:type node))))\n\n\n(defn canonicalize\n  \"`node` with every generated name (a symbol beginning with `%`, except\n   `%_` and `yang.safepoint/_`) renamed to `%<n>`, `n` counting from 0 in\n   the order of first occurrence in a preorder walk over the row grammar's\n   slots. Metadata, including safepoint site marks, survives.\"\n  [node]\n  (first (walk {} node)))\n(defn- frontend-binding\n  \"The installed binding for `lang` in the session's pinned catalog.  With\n   no parse and lower stage installed it throws an `unavailable-parser`\n   diagnostic: there is no fallback to another frontend.\"\n  [state lang]\n  (let [selected (select-frontend (:frontends state) lang)]\n    (or (usable-binding selected)\n        (throw (ex-info (str \"unavailable-parser: no parser for \" (pr-str lang))\n                        {:diagnostic :unavailable-parser\n                         :lang lang\n                         :selection selected})))))\n\n\n(defn- lower-parsed\n  \"Lower `parsed` through `binding`.  A binding with a `:lower-session`\n   stage lowers against the frontend session the shell keeps\n   (`:frontend-session`, cleared with the