{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '385,435p' src/cljc/yang/clojure.cljc; sed -n '1,32p' src/cljc/dao/jing/cbor.cljc; sed -n '818,844p' src/cljc/dao/jing/cbor.cljc; rg -n 'collection|literal|map|set|order' test/yang/clojure_test.clj | head -55; sed -n '770,818p' src/cljc/dao/jing/cbor.cljc; sed -n '1558,1589p' src/cljc/yang/clojure.cljc; sed -n '1,80p' /Users/sto/workspace/datomworld-cc4/test/resources/yang/clojure/cc4-replay-dart-divergences.edn\"","aggregated_output":";; Those primitives are bare names a local binding could shadow, so a\n;; destructuring form is rejected wherever first, rest or empty? is bound\n;; locally. Under the convention, a guest rest definition uses raw data\n;; cursors instead; previously stored definitions are not detectable here.\n;; Generated names carry the reserved `dsg__` prefix and derive from the\n;; binding's position, so lowering is deterministic.\n\n(def ^:private helper-names\n  (set (map symbol [\"first\" \"rest\" \"empty?\"])))\n\n\n(defn- locals\n  [env]\n  (::locals env #{}))\n\n\n(defn- with-locals\n  [env names]\n  (when-let [hit (and (::convention env) (some #{'conj 'vec} names))]\n    (throw (ex-info (str \"Binding \" hit \" would capture the argument-vector constructor\")\n                    {:names names})))\n  (when (and (::invoker env) (some #{'invoke-value} names))\n    (throw (ex-info \"Binding invoke-value would capture the guest collection invoker\" {:names names})))\n  (assoc env ::locals (into (locals env) (remove #(= '& %)) names)))\n\n\n(def ^:private reserved-prefix \"dsg__\")\n\n\n(defn- reject!\n  [message data]\n  (throw (ex-info message data)))\n\n\n(defn- reserved-name?\n  [sym]\n  (= reserved-prefix (subs (name sym) 0 (min (count (name sym))\n                                             (count reserved-prefix)))))\n\n\n(defn- check-def-name!\n  \"A definition name is a plain symbol outside the reserved prefix.\"\n  [operator sym]\n  (when-not (and (symbol? sym) (nil? (namespace sym)))\n    (reject! (str operator \" needs a plain symbol name\") {:name sym}))\n  (when (reserved-name? sym)\n    (reject! \"Definition name uses the reserved destructuring prefix\"\n             {:name sym, :prefix reserved-prefix})))\n\n\n(defn- check-binder!\n(ns dao.jing.cbor\n  \"DaoJing's canonical CBOR value codec and portable numeric operations\n   (docs/design/dao.jing.cbor.md, phases J1 and J2; portable writer in slice H4).\n\n   `encode` turns one supported value into its canonical payload bytes;\n   `decode` accepts exactly one canonical payload and returns its value.\n   The byte contract is the frozen corpus test/resources/dao/jing/cbor-v1.json\n   and the rulings in its README; this namespace implements it, it does not\n   define it.\n\n   Encoding normalizes a value and directly emits canonical CBOR bytes over\n   `dao.host.*`:\n\n   * keywords and symbols: tag 27 `dao.jing/keyword` / `dao.jing/symbol`\n     over `[namespace name]`, read from the identifier's fields;\n   * lists and finite seqs: tag 27 `dao.jing/list` over the item array;\n     vectors are plain arrays;\n   * floating point: tag 27 `dao.jing/float64` over eight big-endian bytes,\n     float32 widened exactly, every NaN made 7ff8000000000000;\n   * integers: CBOR integers, tags 2/3 beyond 64 bits;\n   * decimals: tag 4 `[exponent mantissa]`; ratios: tag 30, reduced;\n   * sets: tag 258 over elements sorted by their canonical bytes;\n   * metadata on collections and symbols: tag 27 `clojure/with-meta` over\n     `[meta value]`, outermost, after stripping unqualified :line :column\n     :end-line :end-column (validated before stripping) and omitting empty\n     metadata.\n\n   Decoding reads the bytes with Jing's own structural reader, which checks\n   every tag, frame name and payload shape before any host conversion (the\n   plan's \\\"validate before any lossy host conversion\\\"), then requires the\n   decoded value to re-encode to the identical bytes.\n\n(defn- meta-bytes\n  \"The bytes of x at depth d, where (build depth) encodes x's own\n   content starting at that depth. If x carries metadata that survives\n   stripping, a with-meta frame sits at d and x's content moves two\n   levels deeper (tag, [meta value]). Stripped values are validated\n   first (ruling A9); a metadata map carrying its own metadata is\n   refused (ruling A3).\"\n  [x d build]\n  (let [m (meta x)]\n    (if (nil? m)\n      (build d)\n      (do (when (some? (meta m))\n            (refuse :malformed-frame \"metadata map carries metadata\"))\n          (doseq [k reader-position-keys\n                  :when (contains? m k)]\n            (value-bytes (get m k) (+ d 3)))\n          (let [kept (apply dissoc m reader-position-keys)]\n            (if (empty? kept)\n              (build d)\n              (let [name-bytes (host text/utf8-encode \"clojure/with-meta\")\n                    mb (map-bytes kept (+ d 2))\n                    vb (build (+ d 2))\n                    frame-arr (concat-buffers [(write-head 4 2)\n                                               (write-head 3 (bytes/length name-bytes))\n                                               name-bytes\n                                               (concat-buffers [(write-head 4 2) mb vb])])]\n                (concat-buffers [(write-head 6 27) frame-arr]))))))))\n83:(deftest test-compile-literals\n84:  (testing \"Compiling literal values\"\n86:      (is (= {:type :literal, :value 42} (yang/compile 42)))\n87:      (is (= {:type :literal, :value 3.14} (yang/compile 3.14)))\n88:      (is (= {:type :literal, :value -10} (yang/compile -10))))\n90:      (is (= {:type :literal, :value \"hello\"} (yang/compile \"hello\"))))\n92:      (is (= {:type :literal, :value true} (yang/compile true)))\n93:      (is (= {:type :literal, :value false} (yang/compile false))))\n94:    (testing \"Nil\" (is (= {:type :literal, :value nil} (yang/compile nil))))\n96:      (is (= {:type :literal, :value :foo} (yang/compile :foo))))\n98:      (is (= {:type :literal, :value [1 2 3]} (yang/compile [1 2 3]))))\n100:      (is (= {:type :literal, :value {:a 1, :b 2}}\n103:      (is (= {:type :literal, :value #{1 2 3}}\n107:(deftest test-set-literal-round-trips\n108:  ;; the semantic lane carries a set literal as plain data (vm/plain-data?\n109:  ;; accepts collections of scalars) and the ast-walker returns it unchanged\n114:(deftest test-set-literal-row-lane\n115:  ;; the row lane: equal sets under different orders mint one address (the\n116:  ;; code-as-tuples rule that literal maps and sets hash order-insensitively)\n123:  ;; a set carrying a host function is not plain data and must be refused at\n124:  ;; the row boundary, exactly as for vectors/maps\n129:            [{:type :literal, :value #{clojure.core/+}}])))))\n132:(deftest test-set-in-application-position\n133:  ;; a set literal in operator position compiles (like the keyword/vector\n165:        (is (= [{:type :literal, :value 1} {:type :literal, :value 2}]\n178:      (is (= [{:type :literal, :value 1} {:type :literal, :value 2}]\n187:        (is (= {:type :literal, :value true} (:test ast)))\n188:        (is (= {:type :literal, :value 1} (:consequent ast)))\n189:        (is (= {:type :literal, :value 2} (:alternate ast)))))\n193:        (is (= {:type :literal, :value nil} (:alternate ast)))))\n196:        (is (= {:type :literal, :value false} (:alternate ast))))\n200:(deftest test-dynamic-collection-literals\n201:  ;; unquoted collections evaluate their elements like Clojure; constant\n202:  ;; collections stay literal nodes; quoted collections stay data\n203:  (testing \"Constant collections stay literals\"\n204:    (is (= {:type :literal, :value [1 2]} (yang/compile '[1 2])))\n205:    (is (= {:type :literal, :value '(1 x 2)} (yang/compile '(quote (1 x 2))))))\n210:      (is (= {:type :literal, :value []} (first (get-in ast [:operator :body :operands])))))\n212:  (testing \"Dynamic sets lower to conj over #{}\"\n214:  (testing \"Dynamic maps evaluate keys and values\"\n216:        \"map keys are evaluated, not taken as data\"))\n217:  (testing \"Nested collections evaluate recursively\"\n220:  (testing \"Quoted dynamic collections remain data\"\n227:    ;; collection it must reach compile-form so the quote is stripped\n238:        (is (= [{:type :literal, :value 1}] (:operands ast)))))\n255:        (is (= {:type :literal, :value nil} ast))))\n258:        (is (= {:type :literal, :value 42} ast))))\n268:    (is (= {:type :literal, :value 'x} (yang/compile '(quote x))))\n269:    (is (= {:type :literal, :value '(+ 1 2)} (yang/compile '(quote (+ 1 2)))))))\n274:    (testing \"Simple literal\" (is (= 42 (compile-and-run 42))))\n289:    (testing \"Higher-order functions\"\n326:        (is (= [{:type :literal, :value 10}] (:operands ast)))))\n339:      (is (= [{:type :variable, :name 's} {:type :literal, :value 42}]\n345:      (is (= [{:type :variable, :name 's} {:type :literal, :value 42}]\n381:    (testing \"Multiple values, cursor reads in order\"\n        (concat-buffers [(write-head 6 30) arr])))))\n\n\n(declare value-bytes)\n\n\n(defn- members-bytes\n  \"Encodes [key value] pairs (value nil for set elements), members at depth d,\n   refusing duplicate canonical encodings (dup-class) and portable-equality\n   collapses before the collection is built.\n   Returns [[key-bytes key-bytes-hex value-bytes-or-nil] ...].\"\n  [pairs set? dup-class d]\n  (let [wired (mapv (fn [[k v]]\n                      (let [kb (value-bytes k d)\n                            vb (when-not set? (value-bytes v d))]\n                        [kb (bytes-hex kb) vb]))\n                    pairs)]\n    (when (< (count (set (map second wired))) (count wired))\n      (refuse dup-class))\n    (when (collapse? (map first pairs))\n      (refuse :equality-collapse))\n    wired))\n\n\n(defn- map-bytes\n  \"A map at depth d; keys and values one level deeper.\"\n  [m d]\n  (deep! d :unsupported-value)\n  (let [wired (members-bytes (seq m) false :duplicate-key (inc d))\n        sorted (sort #(compare-canonical-bytes (first %1) (first %2)) wired)\n        pair-buffers (mapcat (fn [[kb _ vb]] [kb vb]) sorted)]\n    (concat-buffers (cons (write-head 5 (count wired)) pair-buffers))))\n\n\n(defn- set-bytes\n  \"Tag 258 at depth d over an array at d+1; elements at d+2.\"\n  [s d]\n  (deep! (inc d) :unsupported-value)\n  (let [wired (members-bytes (map (fn [x] [x nil]) s)\n                             true\n                             :duplicate-element\n                             (+ d 2))\n        sorted (sort #(compare-canonical-bytes (first %1) (first %2)) wired)\n        item-buffers (map first sorted)\n        arr (concat-buffers (cons (write-head 4 (count wired)) item-buffers))]\n    (concat-buffers [(write-head 6 258) arr])))\n\n\n(defn- meta-bytes\n      tail? (assoc :tail? true))\n\n    ;; anything else: one guest invocation, in tail position when the call is\n    :else\n    (compile-guest-call (compile-form operator false env macro-env)\n                        (compile-form (vec operands) false env macro-env)\n                        env tail?)))\n\n\n(defn compile-application\n  \"Compile a function application to Universal AST.\n\n  Clojure: (+ 1 2)\n  AST: {:type :application\n        :operator <compiled-operator>\n        :operands [<compiled-operand1> <compiled-operand2>]}\n\n  Under the argument-vector convention a user-function call passes its\n  operands as one vector.\"\n  ([operator operands env tail?] (compile-application operator operands env tail? initial-macro-env))\n  ([operator operands env tail? macro-env]\n   (if (and (::convention env) (not (macro-call? env macro-env operator)))\n     (compile-av-application operator operands env tail? macro-env)\n     (let [compiled-operator (compile-form operator false env macro-env)\n           compiled-operands (mapv #(compile-form % false env macro-env) operands)]\n       (cond-> {:type :application,\n                :operator compiled-operator,\n                :operands compiled-operands}\n         tail? (assoc :tail? true))))))\n\n\n(defn compile-dao-stream-apply-call\n[\n{:artifact {:id :argument-vector, :tree {:root :segment/blake3-02eac587af541bc180db4109b3accd5e3981a92eb5d1d00e63d6f12d74b484b0, :rows {:segment/blake3-f3f3245cc96805674e46f83074e7ff7092aefdf6200d8b1cb1888771e524b7bd [:segment/blake3-f3f3245cc96805674e46f83074e7ff7092aefdf6200d8b1cb1888771e524b7bd :application :segment/blake3-451370117f18086634dd585901081e77cdba8735a6e96605f29acf36b2846257 [:segment/blake3-8fa4d6388ea7a9f58d40d732aa468edb6cf62f14aa9b543c5edb06acc53edea8] false], :segment/blake3-d883deb7445f86d99a42589c21933a6d5d821a3f7ba1169994c6a2956b7bdd9d [:segment/blake3-d883deb7445f86d99a42589c21933a6d5d821a3f7ba1169994c6a2956b7bdd9d :lambda [dsg__arguments] :segment/blake3-af7444cf101812547aefec346ad213be331845f1ac623e26bac01afc4999ca46], :segment/blake3-c814dd9efa1709d5602e4b6a997382707c5e258d8ac0c5e77fb802c11c5a6ac3 [:segment/blake3-c814dd9efa1709d5602e4b6a997382707c5e258d8ac0c5e77fb802c11c5a6ac3 :lambda [descriptor] :segment/blake3-a8df15554952257d2e16baf62d45708928f9f45fd8a9afe7448ee1f05e698d8f], :segment/blake3-a4419a610365357d486cef706f760bc517c790ae2667d38fe0fdda1df988f20c [:segment/blake3-a4419a610365357d486cef706f760bc517c790ae2667d38fe0fdda1df988f20c :application :segment/blake3-339d070ef739b0067484f7ff46930ab9e992cb3e4abadc27d403f294b8dea997 [:segment/blake3-1c65ca51764da270659d7f6788ce46f1ec0ab3962c9942312cb5d6c379c471ed :segment/blake3-92058f0e00acfb6e44be40711e4f7b0fac422356a5aaa7c1a0b9e366df68bf75 :segment/blake3-89d1ca91c9a8f285018cc35fef263f71c9fb8820c0d2187d42d2d785cb4ec2fa] false], :segment/blake3-5195e566c7e4f94301b277611fd5e0eb60ce51977ceced77203b334b44bbf5e4 [:segment/blake3-5195e566c7e4f94301b277611fd5e0eb60ce51977ceced77203b334b44bbf5e4 :application :segment/blake3-339d070ef739b0067484f7ff46930ab9e992cb3e4abadc27d403f294b8dea997 [:segment/blake3-201f235cbac99