v_test.cljc\ntest/yang/python/antlr/trace_programs.cljc\ntest/yang/python/antlr/float_text_test.cljc\ntest/yang/python/antlr/c3_gate_test.cljc\ntest/yang/python/antlr/dht_import_fixture.cljc\ntest/yang/python/antlr/cst_export_test.cljc\ntest/yang/python/antlr/int_heap_test.cljc\ntest/yang/python/antlr/prelude_parity_test.cljc\ntest/yang/python/antlr/int_literal_test.cljc\ntest/yang/python/antlr/e2e_c2_test.clj\ntest/yang/python/antlr/c3_programs.cljc\ntest/yang/python/antlr/int_ops_test.cljc\ntest/yang/python/antlr/source_call_test.clj\ntest/yang/python/antlr/lower_portable_test.cljc\ntest/yang/python/antlr/e2e_c1_test.clj\ntest/yang/python/antlr/import_test.cljc\ntest/yang/python/antlr/linked_prelude_test.cljc\ntest/yang/python/antlr/dht_import_test.cljc\ntest/yang/python/antlr/lower_test.clj\ntest/yang/python/antlr/siteset_test.cljc\ntest/yang/python/antlr/linked_safepoint_test.cljc\ntest/yang/python/antlr/int_contract_test.cljc\ntest/yang/python/antlr/import_programs.cljc\ntest/yang/python/antlr/int_contract_fixtures.cljc\ntest/yang/python/antlr/c3_gate_parser_test.clj\ntest/yang/python/antlr/e2e_test.clj\ntest/yang/python/antlr/publication_test.cljc\n(ns yang.core.uast\n  \"Universal AST constructors shared by every language lowering and prelude. Every\n   function returns a canonical map node (`:literal`, `:variable`, `:lambda`,\n   `:application`, `:if`, `:vm/current-continuation`); nothing here adds a\n   node type.\n\n   `sexp->uast` reads a small s-expression notation into those same nodes so\n   the prelude can be written legibly:\n\n     symbol            -> :variable\n     (fn [params] b)   -> :lambda\n     (if t c a)        -> :if\n     (do a b ... z)    -> sequencing through one-parameter lambdas\n     (let [x v ...] b) -> nested immediately applied lambdas\n     (quote x)         -> :literal x\n     (%capture)        -> :vm/current-continuation\n     (yin/def k v)     -> the definition application\n     (f a ...)         -> :application\n     any other value   -> :literal\"\n  (:require\n    [yang.tails :as tails]\n    [yin.vm :as vm]))\n\n\n(defn lit\n  [x]\n  {:type :literal, :value x})\n\n\n(defn v\n  [sym]\n  {:type :variable, :name sym})\n\n\n(defn lam\n  [params body]\n  {:type :lambda, :params (vec params), :body body})\n\n\n(defn app\n  [op & args]\n  {:type :application, :operator op, :operands (vec args)})\n\n\n(defn if-node\n  [t c a]\n  {:type :if, :test t, :consequent c, :alternate a})\n\n\n(def capture {:type :vm/current-continuation})\n\n\n(defn def!\n  \"`(yin/def key value)`: key is a literal symbol.\"\n  [key value]\n  (app (v 'yin/def) (lit key) value))\n\n\n(def discard\n  \"The parameter a sequencing lambda binds and ignores. `%` cannot begin a\n   Python identifier, so it never shadows a guest name.\"\n  '%_)\n\n\n(defn then\n  \"Evaluate `a` for effect, then `b`.\"\n  [a b]\n  (app (lam [discard] b) a))\n\n\n(defn seq-nodes\n  \"Evaluate every node in order; the value is the last one's.\"\n  [nodes]\n  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n\n\n(defn let1\n  [sym value body]\n  (app (lam [sym] body) value))\n\n\n(defn sexp->uast\n  [form]\n  (cond\n    (symbol? form) (v form)\n    (seq? form)\n    (let [[head & args] form]\n      (case head\n        fn (lam (first args) (sexp->uast (second args)))\n        if (if-node (sexp->uast (first args))\n                    (sexp->uast (second args))\n                    (sexp->uast (nth args 2)))\n        do (seq-nodes (map sexp->uast args))\n        let (let [[bindings body] args]\n              (reduce (fn [inner [sym value]]\n                        (let1 sym (sexp->uast value) inner))\n                      (sexp->uast body)\n                      (reverse (partition 2 bindings))))\n        quote (lit (first args))\n        %capture capture\n        (apply app (sexp->uast head) (map sexp->uast args))))\n    :else (lit form)))\n\n\n(def mark-tails\n  \"`yang.tails/mark-tails`: the lowering marks its tree with the same\n   function a rewriting stage recomputes the marks with.\"\n  tails/mark-tails)\n\n\n;; =============================================================================\n;; Call-site occurrence contract C1 (Addendum A, design §2)\n;; =============================================================================\n;;\n;; Every final `:application` occurrence of a produced tree carries the\n;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n;; from canonical rows and emits it into the frontend-metadata side table\n;; as `[origin root-address path :yang/call-site 1]`, where the first\n;; three coordinates are the site id. The key carries no callee identity,\n;; source arity, or ambient classification. It is distinct from\n;; `:yang/site`, the safepoint mark, which travels as node metadata.\n;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n;; continuation nodes) are not `:application` nodes and are never marked.\n;; The walk lives here, beside the other shared tree transforms, so every\n;; frontend's module trees finalize the same way; `yang.clojure` owns the\n;; contract's validation over canonical rows.\n\n(defn annotate-call-sites\n  \"The finished map AST `node` with `:yang/call-site 1` on every\n   `:application` node, at every depth the row grammar knows. Literal\n   payloads are data, never syntax, and are not walked. Marking is\n   idempotent and preserves node metadata and every other key, so\n   canonical rows, roots, and executable outcomes are unchanged.\"\n  [node]\n                                   (apply list (map strip-reader-positions x))\n                                   nil)\n                 :else x)\n        m (meta x)]\n    (if m\n      ;; metadata is itself a value: its entries and its own metadata may\n      ;; carry reader positions too\n      (let [m' (strip-reader-positions\n                 (dissoc m :line :column :end-line :end-column))]\n        ;; not (not-empty m'): an entry-less map may still carry metadata\n        (with-meta x' (when-not (and (empty? m') (nil? (meta m'))) m')))\n      x')))\n\n\n(defn- same-content?\n  \"True when `a` and `b` have equal content, comparing leaves by\n   `dao.jing.cbor/content=`, the encoder's own kind-strict equality, so canonical\n   NaNs are equal and `0.0`/`-0.0` are not,\n   and carry `=` metadata at every depth, including inside metadata itself (a metadata value, or a metadata\n   map's own metadata, compares through `same-content?` too). `=` alone ignores\n   metadata.\n\n   NaN map keys and set elements inside data payloads are out of scope\n   and fail closed when lookup misses.\n\n   Scope boundary: the set branch assumes ordinary set semantics, at most one\n   element per `=`-equivalence class; a set built with a comparator that\n   admits several `=`-equal, metadata-distinct elements is out of scope, the\n   same class of pathological-input residual `dao.jing.md` documents for its\n   own encoder (pathological symbols, scalar metadata). That deferred case is\n   silent and order-dependent, not reliably fail-closed: which `=`-equal\n   element the lookup picks depends on traversal order, so a metadata\n   mismatch may throw or may be silently accepted.\"\n  [a b]\n  (and (= (meta a) (meta b))\n       (or (nil? (meta a)) (same-content? (meta a) (meta b)))\n       (cond (map? a) (and (map? b)\n                           (= (count a) (count b))\n                           (every? (fn [[k v]]\n                                     (and (contains? b k)\n                                          (let [[k' v'] (find b k)]\n                                            (and (same-content? k k')\n                                                 (same-content? v v')))))\n                                   a))\n             (set? a) (and (set? b)\n                           (= (count a) (count b))\n                           (every? (fn [e]\n                                     (same-content? e (some #(when (= e %) %) b)))\n                                   a))\n             (sequential? a) (and (sequential? b)\n                                  (= (count a) (count b))\n                                  (every? true? (map same-content? a b)))\n             :else (cbor/content= a b))))\n\n\n(defn ast->semantic-bytecode\n  \"Project a map AST to flat content-addressed rows (§6.1 codec boundary\n   projection). Returns `{:root row-id, :rows {row-id [row-id tag & slots]}}`.\n\n   Only the §2.3 slots of each node enter its row: `:eid`, `:macro?`,\n   `:yang/*` keys, non-`:application` `:tail?` marks, and any other key are\n389:;; Generated names carry the reserved `dsg__` prefix and derive from the\n411:(def ^:private reserved-prefix \"dsg__\")\n572:  \"Split fn params into fresh simple binders plus the let bindings that\n582:              (let [fresh (temp-symbol (str \"p\" i) (meta p))]\n584:                    (update :params conj fresh)\n585:                    (update :bindings conj p fresh)))\n762:   each pattern parameter becomes a fresh simple binder, and the body is\n789:;;   =>  (fn [dsg__av]\n790:;;         (if (data/content= (data/count dsg__av) 1)\n791:;;           (let [a (data/nth dsg__av 0)] e1)\n792:;;           (if (data/content= (data/count dsg__av) 2)\n793:;;             (let [a (data/nth dsg__av 0) b (data/nth dsg__av 1)] e2)\n800:;; position becomes a fresh adapter closure over the same convention. The\n851:;; carry the reserved `dsg__` prefix; the program pre-pass keeps user code out\n887:;; routes the capture-sensitive primitives through the `dsg__*` helpers so a\n898:  '[[clj/ctx (fn [hs] (dsg__assoc {} :handlers hs))]\n899:    [clj/handlers (fn [] (dsg__get (cell/get clj.rt/ctx) :handlers))]\n902:       (cell/set! clj.rt/ctx (dsg__assoc (cell/get clj.rt/ctx) :handlers hs)))]\n904:    [clj/frame-depth (fn [hs] (if (dsg__equal hs nil) 0 (dsg__get hs 3)))]\n912:                  (dsg__assoc (cell/get clj.rt/ctx) :handlers (dsg__get hs 2))))]\n916:         (if (dsg__equal hs nil)\n917:           (dsg__get e :clj/no-handler)\n918:           (if (dsg__equal (dsg__get hs 0) :finally)\n919:             (do (clj/pop-frame hs) ((dsg__get hs 1) e) (clj/raise e))\n920:             ((dsg__get hs 1) e)))))]\n927:            (if (dsg__equal (cell/get flag) :first)\n929:                  (clj/set-handlers! (clj/frame :handler r (dsg__get saved :handlers)))\n936:         (do (clj/set-handlers! (clj/frame :finally fin (dsg__get saved :handlers)))\n942:  '(fn [dsg__value] (dsg__get dsg__value :yin.k/message)))\n946:  '(fn [dsg__value] (dsg__get dsg__value :yin.k/data)))\n952:   family's capture-sensitive primitives are the `dsg__*` names, bound at\n966:   must accept, like the preamble's `dsg__*` helpers. Exposed so a harness\n986:          (list (if (= 'ex-data (first form)) 'dsg__ex_data 'dsg__ex_message)\n1058:                    (list 'dsg__raw-fn [] body-form)\n1059:                    (list 'dsg__raw-fn [binding]\nsrc/cljc/yin/vm/ast_walker.cljc:52:   primitive-canonical-names ; declared aliases for identity reverse lookup\nsrc/cljc/yin/vm/ast_walker.cljc:126:                     (:primitive-canonical-names vm)\nsrc/cljc/yin/vm/ast_walker.cljc:1094:     :primitive-canonical-names name -> canonical name for intentional aliases\nsrc/cljc/yin/vm/ast_walker.cljc:1121:                                     :primitive-canonical-names :modules\nsrc/cljc/yin/vm/ast_walker.cljc:1213:                     :primitive-canonical-names\nsrc/cljc/yin/vm/ast_walker.cljc:1214:                     (:primitive-canonical-names vm),\ntest/yang/clojure_callsite_test.cljc:361:          ;; generated post-expansion syntax must not be mislabeled as\ntest/yang/clojure_callsite_test.cljc:384:        ;; the `(unless …)` output's generated node is an `:if`, not an\ntest/yang/clojure_callsite_test.cljc:405:    (testing \"a generating expansion marks its generated applications\ntest/yang/clojure_callsite_test.cljc:422:            generated (into #{}\ntest/yang/clojure_callsite_test.cljc:428:        (is (seq generated)\ntest/yang/clojure_callsite_test.cljc:429:            \"the macro generated an application, and it is marked\")\ntest/yang/clojure_callsite_test.cljc:432:        (is (every? (fn [[o _ _]] (contains? event-addrs (second o))) generated)\ntest/yang/clojure_callsite_test.cljc:433:            \"each generated occurrence names a recorded expansion event\")\ntest/yang/clojure_callsite_test.cljc:728:            \"the generated `(f …)` application carries an expansion origin\")\ntest/yang/clojure_callsite_test.cljc:2421:            \"the false Warning is not generated\")\n","exit_code":0,"status":"completed"}}
