{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc 'java -Xss64m -Xmx3g -cp \"$(cat .cpcache/1318952242.cp)\" clojure.main -e '\"'(require '\\\\''yang.latte-oracle-test '\\\\''[clojure.edn :as edn] '\\\\''[clojure.string :as str] '\\\\''[clojure.java.shell :as sh])\n(let [v #(var-get (ns-resolve '\\\\''yang.latte-oracle-test %))\n      evidence-path \\\"test/yang/latte_oracle/slice9_evidence.edn\\\"\n      table-path \\\"test/yang/latte_oracle/slice9_site_tables.edn\\\"\n      e (edn/read-string (slurp evidence-path))\n      ts (edn/read-string (slurp table-path))\n      fixtures (:fixtures (v '\\\\''kernel-gate-corpus))\n      rules (v '\\\\''kernel-ambient-correspondence)\n      guest (fn [s] (symbol (str \\\"gate-\\\" (last (str/split (namespace s) #\\\"\\\\\\\\.\\\")) \\\"-\\\" (name s))))\n      admits? (fn [[f a site :as rec] table [s n]]\n                (and (vector? rec) (= 3 (count rec)) (not= :gate-site/none site)\n                     (or (and (= f (guest s)) (= a n))\n                         (some (fn [[carrier arity kind]]\n                                 (let [sr (get table site)]\n                                   (and (= f carrier) (= a arity) (= carrier (:callee sr))\n                                        (not (:delegation? sr))\n                                        (or (not= :ambient-delegation kind)\n                                            (= :ambient-literal (first (:arg-shapes sr)))))))\n                               (get rules [s n])))))\n      compiled (mapv (fn [i f] (let [c ((v '\\\\''kernel-compile) f)]\n                                (when (zero? (mod i 25)) (prn :recompile-progress i (:id f)) (flush))\n                                [(:id f) c]))\n                      (range) fixtures)\n      cs (into {} compiled)\n      rows (mapv (fn [r] (assoc r :site-table (get-in ts [:fixtures (:id r) :site-table])\n                                :canonical-source-hash (get-in cs [(:id r) :canonical-source-hash]))) (:fixtures e))\n      by-id (into {} (map (juxt :id identity)) rows)\n      observed? (fn [r pair]\n                  (and (= :pass (:status r))\n                       (= (:canonical-source-hash r) (:site-table-hash r) (get-in ts [:fixtures (:id r) :canonical-source-hash]))\n                       (every? (fn [lane] (some #(admits? % (:site-table r) pair) (get-in r [lane :executed-calls])))\n                               [:c-walker :c-semantic])))\n      pairs (vec (for [{:keys [symbol arities disposition]} (v '\\\\''kernel-entries)\n                       :when (= :admitted disposition) n arities] [symbol n]))\n      named (v '\\\\''kernel-named-integrations)\n      derived (mapv (fn [[s n :as pair]]\n                      (let [direct (vec (for [f fixtures :let [r (by-id (:id f))]\n                                             :when (and (= s (first (:call f))) (= n (count (rest (:call f)))) (observed? r pair))] (:id f)))\n                            integration (vec (for [r rows :when (and (contains? named (:id r)) (observed? r pair))] (:id r)))]\n                        {:function-arity pair :exercise (cond (seq direct) :direct (seq integration) :named-integration :else :unexercised)\n                         :direct-fixture-ids direct :integration-fixture-ids integration}))\n                    pairs)\n      entry-keys [:function-arity :exercise :direct-fixture-ids :integration-fixture-ids]\n      entry-mismatches (count (filter false? (map = derived (map #(select-keys % entry-keys) (get-in e [:coverage :entries])))))\n      site-mismatches (vec (for [[id c] compiled :when (not= (:site-table c) (get-in ts [:fixtures id :site-table]))] id))\n      hash-mismatches (vec (for [r rows :when (not= (:canonical-source-hash r) (:site-table-hash r) (get-in ts [:fixtures (:id r) :canonical-source-hash]))] (:id r)))\n      bad-trace-sites (vec (for [r rows lane [:c-walker :c-semantic] rec (get-in r [lane :executed-calls])\n                                :let [site (nth rec 2 nil)]\n                                :when (and (not= site :gate-site/none) (not (contains? (:site-table r) site)))] [(:id r) lane site]))\n      probes (vec (for [r rows [site sr] (:site-table r) :when (= :dynamic (:callee sr))\n                        [pair paths] rules [carrier arity _] paths\n                        :when (not= [carrier arity] [(guest (first pair)) (second pair)])]\n                    [pair [carrier arity site] (:site-table r)]))\n      borrowed (count (filter (fn [[pair rec table]] ((v '\\\\''kernel-record-credits?) rec table (first pair) (second pair))) probes))\n      stale (into (sorted-map)\n                  (for [r rows :when (= :pass (:status r))\n                        :let [recorded (set (for [lane [:c-walker :c-semantic] rec (get-in r [lane :executed-calls])] (nth rec 2 nil)))\n                              missing (vec (sort (for [[site sr] (:site-table r) :when (and (symbol? (:callee sr)) (not (contains? recorded site)))] site)))]\n                        :when (seq missing)] [(:id r) missing]))\n      old-e (edn/read-string (:out (sh/sh \\\"git\\\" \\\"show\\\" (str \\\"HEAD:\\\" evidence-path))))\n      old-ts (edn/read-string (:out (sh/sh \\\"git\\\" \\\"show\\\" (str \\\"HEAD:\\\" table-path))))\n      strip-e (fn [x] (-> x (dissoc :generated-at)\n                           (update :fixtures #(mapv (fn [r] (dissoc r :site-table-hash :canonical-source-hash)) %))))\n      strip-ts (fn [x] (update x :fixtures #(into {} (map (fn [[id r]] [id (dissoc r :canonical-source-hash)])) %)))\n      result {:fixtures (count rows) :admitted-arities (count pairs)\n              :credited-arities (count (remove #(= :unexercised (:exercise %)) derived))\n              :witness-paths (reduce + (map #(+ (count (:direct-fixture-ids %)) (count (:integration-fixture-ids %))) derived))\n              :entry-mismatches entry-mismatches :site-rows (reduce + (map #(count (:site-table %)) rows))\n              :site-ta