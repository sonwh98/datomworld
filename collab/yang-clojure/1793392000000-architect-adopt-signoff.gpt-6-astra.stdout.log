{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,85p' test/yang/clojure_test.clj && sed -n '1090,1150p' test/yang/clojure_test.clj && sed -n '860,940p' src/cljc/yang/clojure.cljc && head -65 deps.edn\"","aggregated_output":"(ns yang.clojure-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.stream :as stream]\n            [dao.stream.observer :as observer]\n            [yang.clojure :as yang]\n            [yang.core.uast :as u]\n            [yang.io :as yang-io]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as ast-walker]\n            [yin.vm.data :as data]\n            [yin.vm.encoder :as encoder]\n            [yin.vm.engine :as engine]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.values :as values]))\n\n\n;; v1 registered the stream module globally at load time; the v2 composition\n;; registers it in the registry it hands the VM.\n(def ^:private base-vm-opts\n  {:modules (module/register-stream-module (module/default-registry))})\n\n\n(defn compile-and-run\n  ([form] (compile-and-run form {} {}))\n  ([form env] (compile-and-run form env {}))\n  ([form env vm-opts]\n   (-> (tu/make-observer-session\n         (tu/create-vm (merge base-vm-opts {:env env} vm-opts)))\n       (tu/queue-ast! (yang/compile form))\n       tu/run-session\n       :consumer\n       vm/value)))\n\n\n(deftest reader-metadata-becomes-occurrence-side-tables\n  (let [form (with-meta '(+ 1 2)\n               {:file \"sample.clj\" :line 9 :column 3 :note :source-form})\n        ast (yang/compile form)\n        projected (encoder/project\n                    (encoder/source-envelope :program \"batch-1\" [ast]))\n        tree (first (:yin/batch projected))\n        origin [:source :program \"batch-1\" 0]]\n    (is (= {:file \"sample.clj\" :line 9 :column 3 :note :source-form}\n           (meta ast)))\n    (is (some #{[origin (:root tree) [] \"sample.clj\" 9 3]}\n              (:yin/source-positions projected)))\n    (is (some #{[origin (:root tree) [] :note :source-form]}\n              (:yin/frontend-metadata projected)))))\n\n\n(deftest indexing-reader-injects-nested-source-positions\n  (let [ast (first (yang-io/compile-string \"(+ x\\n   (* x 2))\"))]\n    (is (= {:file \"<string>\" :line 1 :column 1\n            :end-line 2 :end-column 12}\n           (select-keys (meta ast)\n                        [:file :line :column :end-line :end-column])))\n    (is (= {:file \"<string>\" :line 2 :column 4\n            :end-line 2 :end-column 11}\n           (select-keys (meta (second (:operands ast)))\n                        [:file :line :column :end-line :end-column])))\n    (is (= {:file \"<string>\" :line 2 :column 5\n            :end-line 2 :end-column 6}\n           (select-keys (meta (:operator (second (:operands ast))))\n                        [:file :line :column :end-line :end-column])))))\n\n\n(defn compile-program-and-run\n  ([forms] (compile-program-and-run forms {} {}))\n  ([forms env] (compile-program-and-run forms env {}))\n  ([forms env vm-opts]\n   (-> (tu/make-observer-session\n         (tu/create-vm (merge base-vm-opts {:env env} vm-opts)))\n       (tu/queue-ast! (yang/compile-program forms))\n       tu/run-session\n       :consumer\n       vm/value)))\n\n\n(deftest test-compile-literals\n  (testing \"Compiling literal values\"\n    (testing \"Numbers\"\n      (when (= lane :semantic)\n        (is (<= d1000 (+ d0 2)) (str label \": at most 2 above the pre-loop depth\")))))\n  ;; The walker lane masks a missing flag (its depth stays flat either way),\n  ;; so only the semantic lane can serve as the flag-sensitive control.\n  (testing \"negative control: without :tail? on the self-application depth grows\"\n    (let [run (fn [n] (semantic-run (strip-self-tail (countdown-ast :loop n :tail))))\n          [_ d0] (run 0)\n          [_ d100] (run 100)]\n      (is (> d100 (+ d0 50)) \"the semantic gate detects the missing flag\"))))\n\n\n;; =============================================================================\n;; Slice 5: the outcome model\n;; =============================================================================\n\n(def ^:private effect-log (atom []))\n\n\n(def ^:private outcome-modules\n  (let [host (fn [name entries]\n               (fn [registry]\n                 (module/register-host-module\n                   registry name\n                   (into {} (map (fn [[op f _]] [op f])) entries)\n                   (into {} (map (fn [[op _ p]] [op p])) entries))))]\n    (-> av-modules\n        ((host 'portable\n               [['nth\n                 (yang/outcome-adapter data/refusal-message (get data/data-module 'nth))\n                 (get data/data-profiles 'nth)]]))\n        ((host 'probe\n               [['note\n                 (fn [x] (swap! effect-log conj x) x)\n                 (vm/primitive-profile 'note :pure [1] #{} :none)]])))))\n\n\n(def ^:private outcome-opts\n  {:convention :arg-vector, :outcomes true\n   :native (set (keys vm/primitives))\n   :adapters {'data/nth 'portable/nth}})\n\n\n(defn- outcome-ast\n  [forms]\n  (yang/compile-program forms true outcome-opts))\n\n\n(defn- run-outcome\n  \"The raw outcome the last form of `forms` returns.\"\n  [forms]\n  (reset! effect-log [])\n  (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n      (tu/queue-ast! (outcome-ast forms))\n      tu/run-session\n      :consumer\n      vm/value))\n\n\n(defn- run-profile-outcome\n  [forms]\n  (reset! effect-log [])\n(defn- lower-tail\n  \"The form whose value is the outcome of evaluating `form` in tail position.\"\n  [env form]\n  (cond\n    (seq? form)\n    (if (empty? form)\n      (ok-form form)\n      (let [[head & ops] form]\n        (case (when (symbol? head) head)\n          if (let [[t c & more] ops]\n               (lower-operand env t\n                              (fn [tv]\n                                (list 'if tv (lower-tail env c)\n                                      (if (seq more)\n                                        (lower-tail env (first more))\n                                        (ok-form nil))))))\n          let (do (when-not (vector? (first ops))\n                    (reject! \"let requires a binding vector\" {:bindings (first ops)}))\n                  (lower-let env (partition 2 (expand-bindings (first ops) env)) (rest ops)))\n          dsg__let (lower-let env (partition 2 (first ops)) (rest ops))\n          do (case (count ops)\n               0 (ok-form nil)\n               1 (lower-tail env (first ops))\n               (lower-operand env (first ops)\n                              (fn [v] (list 'do v (lower-tail env (cons 'do (rest ops)))))))\n          loop (lower-loop env (first ops) (rest ops))\n          recur (lower-operands env (vec ops) (fn [vs] (rebuild form (cons 'recur vs))))\n          throw (lower-operand env (first ops) (fn [v] [error-tag v]))\n          (quote fn) (ok-form form)\n          (case cond when if-let if-some when-let when-some)\n          (lower-tail env (expand-control env head ops))\n          and (case (count ops)\n                0 (ok-form true)\n                1 (lower-tail env (first ops))\n                (let [g (gen-sym env)]\n                  (lower-tail env (list 'dsg__let [g (first ops)]\n                                        (list 'if g (cons 'and (rest ops)) g)))))\n          or (case (count ops)\n               0 (ok-form nil)\n               1 (lower-tail env (first ops))\n               (let [g (gen-sym env)]\n                 (lower-tail env (list 'dsg__let [g (first ops)]\n                                       (list 'if g g (cons 'or (rest ops)))))))\n          (case (call-kind env head)\n            :macro (do (check-macro-operands! env head ops) (ok-form form))\n            :keyword (lower-operands env (vec ops)\n                                     (fn [vs] (ok-form (rebuild form (cons head vs)))))\n            :native (lower-operands env (vec ops)\n                                    (fn [vs] (ok-form (rebuild form (cons head vs)))))\n            :adapted (lower-operands env (vec ops)\n                                     (fn [vs] (rebuild form (cons (get (adapters env) head) vs))))\n            :guest (lower-operands env (into [head] ops)\n                                   (fn [vs] (rebuild form vs)))))))\n    (or (vector? form) (set? form) (map? form))\n    (if (failing? env form)\n      (cond\n        (vector? form) (lower-operands env form (fn [vs] (ok-form (vec vs))))\n        (set? form) (lower-operands env (vec form) (fn [vs] (ok-form (set vs))))\n        :else (lower-operands env (vec (mapcat identity form))\n                              (fn [vs] (ok-form (into {} (map vec) (partition 2 vs))))))\n      (ok-form form))\n    :else (ok-form form)))\n\n\n(defn- lower-function-body\n  \"The outcome-returning body of one function over `params`.\"\n  [env macro-env params body-forms]\n  (lower-tail (-> env\n                  (assoc ::macro-env macro-env, ::gen (atom 0))\n                  (with-locals (mapcat binder-symbols params)))\n              (rewrite-ex-info (body-expression body-forms))))\n\n\n(def ^:private source-keys [:line :column :end-line :end-column])\n\n\n(defn- source-meta\n  \"The source position keys of `form`'s reader metadata, or nil.\"\n  [form]\n  (not-empty (select-keys (meta form) source-keys)))\n\n{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n  