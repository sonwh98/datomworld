wer-adopt-n1n2.prompt.md\n?? collab/1793392000000-architect-adopt-signoff.gpt-6-astra.stdout.log\n docs/agents/known-gaps.md                  |  36 ++++\n docs/design/host-boundary/closure-clj.edn  |   8 +-\n docs/design/host-boundary/closure-cljd.edn |   8 +-\n docs/design/host-boundary/closure-cljs.edn |   8 +-\n src/cljc/yang/clojure.cljc                 | 320 ++++++++++++++++++++++++++---\n test/dao/host/gate_test.clj                |  14 +-\n test/yang/clojure_test.clj                 | 207 ++++++++++++++++++-\n test/yang/latte_oracle_test.clj            | 192 ++++++++++-------\n 8 files changed, 672 insertions(+), 121 deletions(-)\n","exit_code":0,"status":"completed"}}
