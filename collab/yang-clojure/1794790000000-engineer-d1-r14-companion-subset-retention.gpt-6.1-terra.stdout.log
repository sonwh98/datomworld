{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '4470,4550p' test/yang/latte_oracle_test.clj; cat target/d1-r9b-check.clj; cat src/cljc/yang/correspondence_batch.clj; rg -n 'defn (open|put|fetch|close)|defprotocol|content.jing' src/cljc/dao/jing* src -g '*store*' | head -100; git log -1 --oneline; ls target/d1-r9d*\"","aggregated_output":"              @peak)}))\n\n\n(defn- d1-persist-and-check-fixture!\n  \"Exercise one live admission through a temporary file store and the\n   independent static gate; with opts, also run one mutated-input check\n   per distinct gate refusal class. Does not produce a D1 record or a\n   verifier result.\"\n  [dir run fixture & [{:keys [spot-check? handle]}]]\n  (let [compiled (kernel-compile-in-run run fixture true)\n        _ (when-not (= :compiled (:status compiled))\n            (throw (ex-info \"Fixture did not compile\" {:fixture (:id fixture) :stage :compile})))\n        origin (:admission-origin compiled)\n        evidence (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_site_tables.edn\")))\n        expected (get-in evidence [:fixtures (:id fixture)])\n        _ (when-not (and (= 1 (:version evidence)) (map? expected))\n            (throw (ex-info \"Fixture evidence missing\" {:fixture (:id fixture) :stage :evidence})))\n        producer (cc3-oracle-binding compiled)\n        independent (correspondence-verifier/reconstruct-bindings\n                      (:compiled-ast compiled) (:ast compiled) origin)\n        _ (when-not (= independent (:binding producer))\n            (throw (ex-info \"Independent binding disagreement\" {:fixture (:id fixture) :stage :bindings})))\n        snapshot {:fixture (:id fixture) :origin origin\n                  :bindings independent :metadata (:rows producer)\n                  :constructors (correspondence-verifier/context-constructors context-forms)}\n        own-store? (nil? handle)\n        handle (or handle (file-store/open {:type :file :dir dir}))\n        addresses (try (let [root (vm/materialize-tree! handle (:tree producer))\n                             stamped-root (vm/materialize-tree! handle (:stamped-tree producer))]\n                         {:evidence (correspondence/store-evidence! handle evidence)\n                          :input (jing/materialize! handle (:reconstruction-input compiled))\n                          :profile (jing/materialize! handle correspondence-text/profile)\n                          :snapshot (jing/materialize! handle (assoc snapshot :root root :stamped-root stamped-root))\n                          :root root :stamped-root stamped-root})\n                       (finally (when own-store? (file-store/close! handle))))\n        reopened (if own-store? (file-store/open {:type :file :dir dir}) handle)]\n    (try\n      (let [stored-evidence (jing/get reopened (:evidence addresses) ::missing)\n            stored-input (jing/get reopened (:input addresses) ::missing)\n            stored-snapshot (jing/get reopened (:snapshot addresses) ::missing)\n            stored-profile (jing/get reopened (:profile addresses) ::missing)\n            row (get-in stored-evidence [:fixtures (:id fixture)])\n            before-tree (correspondence-verifier/fetch-tree! reopened (:root stored-snapshot) 100000)\n            stamped-tree (correspondence-verifier/fetch-tree! reopened (:stamped-root stored-snapshot) 100000)\n            input (assoc stored-snapshot\n                         :before (vm/semantic-bytecode->ast before-tree)\n                         :stamped (vm/semantic-bytecode->ast stamped-tree)\n                         :forms (correspondence-text/read-one! (:id fixture) (:forms-edn stored-input))\n                         :call (correspondence-text/read-one! (:id fixture) (:call-edn stored-input))\n                         :source-hash (:canonical-source-hash row)\n                         :site-table (:site-table row))\n            _ (when-not (= correspondence-text/profile stored-profile)\n                (throw (ex-info \"Profile missing or changed\" {:fixture (:id fixture) :stage :profile})))\n            _ (when-not (= (:admission-origin stored-input) (:origin stored-snapshot))\n                (throw (ex-info \"Retained admission differs\" {:fixture (:id fixture) :stage :admission})))\n            replay-program (correspondence-text/read-one! (:id fixture) (:program-edn stored-input))\n            replay-options (correspondence-text/read-one! (:id fixture) (:options-edn stored-input))\n            _ (correspondence-verifier/check-replay-root!\n                (:id fixture) (yang/compile-program replay-program true replay-options) (:root stored-snapshot))\n            gate (correspondence-verifier/check-fixture! input)\n            site-id (first (keys (:site-table row)))\n            _ (when-not site-id\n                (throw (ex-info \"No declaration to mutate\" {:fixture (:id fixture) :stage :mutation})))\n            mutated (assoc-in input [:site-table site-id :arg-shapes] [:forged])\n            mutation (try (correspondence-verifier/check-fixture! mutated) nil\n                          (catch Exception e (ex-data e)))]\n        (when-not (= :site-declarations (:stage mutation))\n          (throw (ex-info \"Mutated declaration was not refused\" {:fixture (:id fixture) :stage :mutation})))\n        {:gate gate :mutation-stage (:stage mutation) :addresses addresses\n         :admission-origin (:origin stored-snapshot) :evidence-address (:evidence addresses)\n         :rows {:pre-stamp (count (:rows before-tree))\n                :stamped (count (:rows stamped-tree))}\n         :sites (count (:site-table row))\n         :spot-checks (when spot-check? (d1-spot-check-refusals! input))})\n      (finally (when own-store? (file-store/close! reopened))))))\n\n\n(deftest test-d1-persisted-per-fixture-static-gate\n  ;; A single fixture and temporary store; this is not a published D1 record.\n  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n        run (fresh-admission-run :d1-r7-static)\n(require '[clojure.edn :as edn] '[dao.jing :as jing] '[yin.repl.store :as file] '[yang.correspondence-batch :as batch])\n(let [p (batch/read-progress \"target/d1-r9b-outcomes.edn\")\n      entries (filter #(= :pass (:status (val %))) (:outcomes p))\n      h (file/open {:type :file :dir \"target/d1-r9b-store\"})]\n  (try\n    (doseq [[id {:keys [addresses admission-origin]}] entries]\n      (doseq [[k a] addresses]\n        (when (= ::missing (jing/get h a ::missing))\n          (throw (ex-info \"Missing retained address\" {:fixture id :key k :address a}))))\n      (let [input (jing/get h (:input addresses) ::missing)\n            snapshot (jing/get h (:snapshot addresses) ::missing)]\n        (when-not (= admission-origin (:admission-origin input) (:origin snapshot))\n          (throw (ex-info \"Origin mismatch\" {:fixture id})))))\n    (prn {:summary (batch/summary p) :reopened-addresses-checked (* 6 (count entries))})\n    (finally (file/close! h))))\n(ns yang.correspondence-batch\n  \"Resumable per-fixture outcome records for one corpus static-gate run.\n   The outcomes file IS the progress record: every recorded outcome is\n   final (append-only), an interruption loses at most the in-flight\n   fixture, and `:not-run` is never a pass or a refusal. These records\n   are run bookkeeping, not a verification result.\"\n  (:require [clojure.edn :as edn]\n            [clojure.java.io :as io]\n            [dao.jing :as jing]\n            [yin.vm :as vm]))\n\n\n(def ^:private recordable-statuses #{:pass :refused})\n\n\n(defn- outcome-refusal\n  [reason detail]\n  (ex-info \"Outcome record refused\"\n           (assoc detail :rule :correspondence/outcome :reason reason)))\n\n\n(defn- checked-outcome\n  \"Validate one outcome entry per status: a pass carries its recorded\n   admission origin and the storage it measured; a refusal names its\n   stage. Anything else refuses rather than recording half a fact.\"\n  [fixture outcome]\n  (when-not (map? outcome) (throw (outcome-refusal :outcome-shape {:fixture fixture})))\n  (let [status (:status outcome)]\n    (when-not (contains? recordable-statuses status)\n      (throw (outcome-refusal :outcome-status {:fixture fixture :status status})))\n    (case status\n      :pass (when-not (and (vm/occurrence-origin? (:admission-origin outcome))\n                           (nat-int? (:storage-bytes outcome))\n                           (every? #(jing/segment-address? (get-in outcome [:addresses %]))\n                                   [:input :snapshot :evidence :profile :root :stamped-root]))\n              (throw (outcome-refusal :pass-evidence\n                                      {:fixture fixture\n                                       :requires [:admission-origin :storage-bytes :addresses]})))\n      :refused (when-not (keyword? (:stage outcome))\n                 (throw (outcome-refusal :refusal-stage {:fixture fixture}))))\n    outcome))\n\n\n(defn- sync-directory!\n  \"Flush the directory entry so a renamed-in progress record survives a\n   process crash. Best-effort on platforms without directory sync.\"\n  [dir-file]\n  (try\n    (let [channel (java.nio.channels.FileChannel/open\n                    (.toPath dir-file)\n                    (into-array java.nio.file.OpenOption\n                                [java.nio.file.StandardOpenOption/READ]))]\n      (try (.force channel true) (finally (.close channel))))\n    (catch Exception _ nil)))\n\n\n(defn- write-atomically!\n  \"Write `value` to `file` through a same-directory temporary file, so a\n   reader never observes a partial progress record.\"\n  [file value]\n  (let [target (io/file file)\n        parent (or (.getParentFile target) (io/file \".\"))\n        temporary (io/file parent (str (.getName target) \".partial-\" (random-uuid)))]\n    (try\n      (when-not (.exists parent) (.mkdirs parent))\n      (let [bytes (.getBytes (with-out-str (prn value)) \"UTF-8\")]\n        (with-open [out (java.io.FileOutputStream. temporary)]\n          (.write out bytes)\n          (.flush out)\n          (.sync (.getFD out))))\n      (java.nio.file.Files/move (.toPath temporary) (.toPath target)\n                                (into-array java.nio.file.CopyOption\n                                            [java.nio.file.StandardCopyOption/ATOMIC_MOVE\n                                             java.nio.file.StandardCopyOption/REPLACE_EXISTING]))\n      (sync-directory! parent)\n      nil\n      (finally\n        (when (.exists temporary) (.delete temporary))))))\n\n\n(defn initialize!\n  \"Create the progress record for one corpus run: every supplied fixture\n   id starts `:not-run`. An existing file refuses — a run's record is\n   never reset.\"\n  [file fixtures]\n  (let [ids (vec fixtures)]\n    (when-not (and (every? keyword? ids)\n                   (= (count ids) (count (distinct ids))))\n      (throw (outcome-refusal :fixture-ids {:fixtures ids})))\n    (when (.exists (io/file file))\n      (throw (outcome-refusal :progress-exists {:file (str file)})))\n    (write-atomically! file\n                       {:scope :d1-per-fixture-static-gates\n                        :not-a-verification-result true\n                        :fixture-count (count ids)\n                        :outcomes (into {} (map (fn [id] [id {:status :not-run}])) ids)})\n    nil))\n\n\n(defn read-progress\n  \"Read and shape-check the progress record at `file`.\"\n  [file]\n  (let [f (io/file file)]\n    (when-not (.exists f)\n      (throw (outcome-refusal :progress-absent {:file (str file)})))\n    (let [progress (edn/read-string (slurp f))]\n      (when-not (and (map? progress) (map? (:outcomes progress))\n                     (pos-int? (:fixture-count progress)))\n        (throw (outcome-refusal :progress-shape {:file (str file)})))\n      progress)))\n\n\n(defn record!\n  \"Record one fixture's FINAL outcome. The fixture must be one this run\n   initialized, the outcome must be complete for its status, and a\n   fixture whose outcome is already recorded never changes: re-running a\n   batch skips it instead of rewriting it.\"\n  [file fixture outcome]\n  (let [progress (read-progress file)\n        outcomes (:outcomes progress)]\n    (when-not (contains? outcomes fixture)\n      (throw (outcome-refusal :unknown-fixture {:fixture fixture})))\n    (let [checked (checked-outcome fixture outcome)]\n      (when-not (= :not-run (:status (get outcomes fixture)))\n        (throw (outcome-refusal :outcome-final\n                                {:fixture fixture\n                                 :recorded (get outcomes fixture)})))\n      (write-atomically! file (assoc progress :outcomes\n                                     (assoc outcomes fixture checked)))\n      nil)))\n\n\n(defn summary\n  \"Count outcomes by status; `:not-run` counts stay visible so an\n   incomplete run never reads as complete.\"\n  [progress]\n  (let [counts (frequencies (map (comp :status val) (:outcomes progress)))]\n    {:fixture-count (:fixture-count progress)\n     :pass (get counts :pass 0)\n     :refused (get counts :refused 0)\n     :not-run (get counts :not-run 0)}))\n\n(defn corpus-index!\n  \"Build an index of retained fixture addresses after checking their direct\n   content and admission coordinates. This is not a recipe or D1 record;\n   it does not verify transitive row closures or executable dependencies.\"\n  [handle progress]\n  (let [outcomes (:outcomes progress)\n        missing ::missing]\n    (when-not (and (map? outcomes) (pos-int? (:fixture-count progress))\n                   (= (:fixture-count progress) (count outcomes)))\n      (throw (outcome-refusal :corpus-shape {})))\n    {:scope :retained-static-corpus-index\n     :not-a-verification-result true\n     :fixtures\n     (into {}\n           (for [[fixture outcome] outcomes]\n             (do\n               (checked-outcome fixture outcome)\n               (when-not (= :pass (:status outcome))\n                 (throw (outcome-refusal :corpus-incomplete {:fixture fixture})))\n               (let [addresses (:addresses outcome)\n                     content (into {} (map (fn [[role address]]\n                                             [role (jing/get handle address missing)]))\n                                   (select-keys addresses [:input :snapshot :evidence :profile :root :stamped-root]))\n                     input (:input content)\n                     snapshot (:snapshot content)\n                     origin (:admission-origin outcome)]\n                 (when (or (some #{missing} (vals content))\n                           (not= fixture (get-in input [:fixture :id]) (:fixture snapshot))\n                           (not= origin (:admission-origin input) (:origin snapshot))\n                           (not= (:root addresses) (:root snapshot))\n                           (not= (:stamped-root addresses) (:stamped-root snapshot))\n                           (not (contains? (get-in content [:evidence :fixtures]) fixture)))\n                   (throw (outcome-refusal :corpus-content {:fixture fixture})))\n                 [fixture {:admission-origin origin :addresses addresses}]))))}))\nsrc/cljc/dao/jing.cljc:505:(defn close!\nsrc/cljc/dao/space/store.cljc:4:   directory holding `content.jing` — the `dao.jing.file` content log a\nsrc/cljc/dao/space/store.cljc:35:  \"content.jing\")\nsrc/cljc/dao/space/store.cljc:82:   `<dir>/content.jing`.\"\nsrc/cljc/dao/space/store.cljc:281:(defn open\nsrc/cljc/dao/space/store.cljc:320:(defn close!\nsrc/cljc/yin/shell/store.cljc:69:(defn open\nsrc/cljc/yin/shell/store.cljc:146:(defn close!\nsrc/cljc/yin/repl/store.cljc:140:(defn open\nsrc/cljc/yin/repl/store.cljc:182:(defn close!\nccd3648d wip(d1): r9b/r9c corpus-rebuild machinery + the 155-fixture outcomes (state preservation)\ntarget/d1-r9d-batch.log\ntarget/d1-r9d-index-copy.clj\ntarget/d1-r9d-index.clj\ntarget/d1-r9d-index.log\ntarget/d1-r9d-kondo.log\ntarget/d1-r9d-red.log\ntarget/d1-r9d-standing.log\ntarget/d1-r9d-static-measure.log\n\ntarget/d1-r9d-index-store:\ncontent.jing\nlock\n","exit_code":0,"status":"completed"}}
