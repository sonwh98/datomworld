  (cons [path node]\n          (mapcat (fn [[j [field kind]]]\n                    (let [pos (+ j 2) value (get node field)]\n                      (case kind\n                        :node (syntax-places value (conj path pos))\n                        :nodes (mapcat (fn [[i child]] (syntax-places child (conj path [pos i])))\n                                       (map-indexed vector value))\n                        [])))\n                  (map-indexed vector (get vm/semantic-bytecode-grammar (:type node)))))))\n\n\n(defn reconstruct-bindings\n  \"Independently translate stamped call sites to the source row occurrence.\"\n  [before stamped origin]\n  (when-not (vm/occurrence-origin? origin)\n    (throw (ex-info \"Missing retained admission\" {:rule :verifier/origin})))\n  (let [tree (vm/ast->semantic-bytecode before)\n        root (:root tree)\n        eligible (set (vm/application-occurrences tree))\n        paths (structural-correspondence before stamped)\n        sites (keep (fn [[path node]]\n                      (when (= :application (:type node))\n                        (let [direct (stamp (second (:operands node)))\n                              routed (routed-inner node)\n                              indirect (when routed (stamp (first (:operands routed))))]\n                          (when-let [[id _] (or direct indirect)]\n                            (let [target (get paths path ::missing)]\n                              (when-not (contains? eligible [root target])\n                                (throw (ex-info \"Stamp has no source application\" {:rule :verifier/binding :site id})))\n                              [id [origin root target]])))))\n                    (syntax-places stamped []))\n        ids (map first sites)\n        targets (map second sites)]\n    (when (or (not= (count ids) (count (set ids)))\n              (not= (count targets) (count (set targets))))\n      (throw (ex-info \"Ambiguous stamp binding\" {:rule :verifier/binding})))\n    (into {} sites)))\n\n\n(defn attributed?\n  \"Query one already-scoped fixture's table, bindings and complete lane traces.\n   This query does not validate those inputs or authorize reliance on them.\"\n413:(defn materialize!\n483:(defn get\n{:scope :d1-per-fixture-static-gates, :not-a-verification-result true, :fixture-count 155, :outcomes {:minimal-last {:status :pass, :admission-origin [:source :program [\"d1-r8-corpus-4f981379-e832-4cbf-a393-e95071fe772e\" 0] 0], :addresses {:evidence :segment/blake3-e4094211c705022e962908b6176cb26b1dca6112af4345addc7acf56b21baee1, :input :segment/blake3-96565e2f01a96af55e063cc31dbc43c3a9cac7aeaf4a90888799037514286574, :profile :segment/blake3-ab1263e1c5b304bda2d1875f4fa78a7a91ca82d4c9435dffa262288e7a9863b0, :snapshot :segment/blake3-b05c02cc4651c7a9258ba510faa575c0392b393f87f496c571703b33de389b26, :root :segment/blake3-e92719a0c071f85033ea946b40cce7a8eff643b8c96116f26f75c6e96dc59b2d, :stamped-root :segment/blake3-f3bc79f03c0e152525e4f87c0666a892c579ae2b6817c48043cb92c0ee26e074}, :storage-bytes 6965459, :elapsed-ms 13815, :rows {:pre-stamp 1165, :stamped 1168}, :sites 1, :mutation-refusal :site-declarations}, :parse-bad-binding {:status :pass, :admission-origin [:source :program [\"d1-r8-corpus-c6cdb330-def0-4703-8974-cc5cac704c0a\" 1] 0], :addresses {:evidence :segment/blake3-e4094211c705022e962908b6176cb26b1dca6112af4345addc7acf56b21baee1, :input :segment/blake3-9b5fa664b5ecfd10cb63605ec25026c52e39e6b014a0ebf9e2eb03150acbdd3a, :profile :segment/blake3-8e9393e98d6e1d2b6c64db770236ecd85eaaef1fda9e1caf14c60daf22ef51d5, :snapshot :segment/blake3-c84c5e9bead2b47c02372afda86229fb0ea254fd22f5ac3e2f4a224018a42c1c, :root :segment/blake3-6e9039216fddc0e1a6fbc2e52502714f8f3866168ba5f2948f1afe9e02984607, :stamped-root :segment/blake3-fe9a413e0367b78e52fad728d6f33b8f9a2ca71805ba157384a5bd76bb51aba8}, :storage-bytes 2793417, :elapsed-ms 19683, :rows {:pre-stamp 3617, :stamped 3842}, :sites 76, :mutation-refusal :site-declarations}, :bet