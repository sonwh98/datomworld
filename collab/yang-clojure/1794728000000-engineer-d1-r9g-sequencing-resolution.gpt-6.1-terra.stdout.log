{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='test/yang/correspondence_measure.clj'\ns=open(p).read().replace('[dao.jing :as jing]', '[dao.jing :as jing]\\\\n            [dao.jing.cbor :as cbor]')\nneedle='(defn measure-fixture\"'!'\"\\\\n'\ninsert='''(defn tree-statistics\n  \\\"Occurrence and path sizes for one validated row tree; path bytes are the\n   sum of canonical Jing CBOR encodings of each application path.\\\"\n  [tree]\n  (let [occurrences (vm/occurrences tree)\n        applications (vm/application-occurrences tree)]\n    {:rows (count (:rows tree))\n     :occurrences (count occurrences)\n     :applications (count applications)\n     :depth (reduce max 0 (map (comp count second) occurrences))\n     :application-path-bytes (reduce + 0 (map (fn [[_ path]] (alength (cbor/encode path)))\n                                              applications))}))\n\n'''\ns=s.replace(needle,insert+needle)\nopen(p,'w').write(s)\nPY\nclojure -M:test -n yang.correspondence-measure-test -n yang.correspondence-lane-test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
