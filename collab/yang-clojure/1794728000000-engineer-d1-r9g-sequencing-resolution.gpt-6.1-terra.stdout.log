{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"cat > target/d1-r9g-static-profile.clj <<'EOF'\n(require '[yang.correspondence-measure :as measure]\n         '[yang.correspondence-batch :as batch]\n         '[yang.latte-oracle-test :as oracle]\n         '[yin.repl.store :as store]\n         '[dao.jing :as jing]\n         '[dao.jing.cbor :as cbor])\n(let [source \\\"collab/yang-clojure/1794720000000-engineer-d1-r9e.outcomes.edn\\\"\n      out \\\"collab/yang-clojure/1794728000000-engineer-d1-r9g-static-profile.edn\\\"\n      old (batch/read-progress source)\n      ids (vec (sort (keys (:outcomes old))))\n      _ (when-not (.exists (java.io.File. out))\n          (measure/initialize\"'! out ids {:scope :d1-static-profile\n                                        :pre-declaration-tagged-execution false}))\n      pending (filter #(= :not-run (get-in (measure/read-progress out) [:outcomes % :status])) ids)\n      sampler ((ns-resolve '\"'yang.latte-oracle-test 'd1-heap-sampler\"'!) 5)\n      h (store/open {:type :file :dir \"target/d1-r9e-retained-store\"})]\n  (try\n    (doseq [id pending]\n      (let [t (System/nanoTime)\n            outcome (get-in old [:outcomes id])\n            result (try (let [{:keys [before stamped]} (measure/check-retained-trees! h id outcome)\n                              sizes (into {} (for [role [:input :snapshot :profile :evidence]]\n                                               [role (alength (cbor/encode (jing/get h (get-in outcome [:addresses role]) ::missing)))]))]\n                          {:status :pass :before (measure/tree-statistics before)\n                           :stamped (measure/tree-statistics stamped) :serialized-bytes sizes\n                           :elapsed-ms (quot (- (System/nanoTime) t) 1000000)})\n                        (catch Exception e {:status :refused :stage (or (:stage (ex-data e)) :static-profile)\n                                            :message (ex-message e)}))]\n        (measure/record! out id result)\n        (prn {:fixture id :status (:status result) :elapsed-ms (:elapsed-ms result)}) (flush)))\n    (finally (store/close! h)\n             (prn {:sampled-process-heap-bytes ((:stop! sampler))}) (flush))))\n(shutdown-agents)\nEOF\nset -o pipefail\njava -Xss64m -cp \"$(cat target/d1-r9e-classpath.txt)\" clojure.main target/d1-r9g-static-profile.clj 2>&1 | tee target/d1-r9g-static-profile.log'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
