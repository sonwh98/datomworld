{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2000,2040p' test/yang/latte_oracle_test.clj; sed -n '163,185p' test/yang/latte_oracle_test.clj; sed -n '1,160p' test/yang/correspondence_lane.clj; git status --short\"","aggregated_output":"                   (group-by first (into (into from-delegations from-shift) from-copies))))))\n        (filter #(and (contains? #{'defn 'defn-} (:kind %))\n                      (= :admitted (:disposition %)))\n                kernel-entries)))\n\n\n(def ^:private kernel-site-prelude\n  \"The caller-side site channel (attribution ruling R2): one heap cell\n   holding the site id of the most recent stamped application, and the\n   stamping helper. A body entered without a stamped caller records the\n   :gate-site/none refusal site (R2b case 6).\"\n  '[(def gate-site-slot (cell/new :gate-site/none))\n    (defn gate-site!\n      [k args]\n      (cell/set! gate-site-slot k) args)])\n\n\n(defn- kernel-trace-form\n  \"Append the selected function/arity at body entry, including indirect\n   calls, carrying the CALLER's site id read from the site slot (R2: the\n   record is [fname arity caller-site-id]; caller-side tagging, never\n   callee-side). Only C is instrumented; A/B run their original paths.\"\n  [form]\n  (if (#{'defn 'defn-} (first form))\n    (let [[op fname & header] form\n          header (drop-while #(not (or (vector? %) (seq? %))) header)\n          trace-arity (fn [[params & body]]\n                        (let [n (if (some #{'&} params)\n                                  [:variadic (.indexOf params '&)] (count params))]\n                          (list* params\n                                 (list 'stream/put! 'gate-execution-trace\n                                       (list 'vector (list 'quote fname) n\n                                             '(cell/get gate-site-slot)))\n                                 body)))]\n      (list* op fname (if (vector? (first header))\n                        (trace-arity header) (map trace-arity header))))\n    form))\n\n\n(def ^:private kernel-ambient-state-constructors\n  \"Context-layer constructors that thread the ambient state: resolving an\n   the two host Var primitives the throw-site fixtures reach.\"\n  (assoc yang/kind-module 'var? var? 'resolve resolve))\n\n\n(defn- oracle-registry\n  \"The stream/data modules, kind primitives, and portable outcome adapters.\n   Slices 1-7 retain their host Var probes; context modules supply only the\n   callback-free kind exports and cannot consult host namespaces.\"\n  ([] (oracle-registry kind-fns))\n  ([kinds]\n   (let [portable (into {}\n                        (map (fn [[source _]]\n                               (let [op (symbol (name source))]\n                                 [op (yang/outcome-adapter data/refusal-message\n                                                           (get data/data-module op))])))\n                        yang/library-adapters)]\n     (-> (module/default-registry)\n         module/register-stream-module\n         module/register-cell-module\n         data/register-data-module\n         (host-module 'kind kinds yang/kind-arities)\n         (host-module 'portable portable\n                      (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n(ns yang.correspondence-lane\n  \"Measurement-only JVM composition for the D1 C lanes. Not a verifier.\"\n  (:require [dao.stream :as stream]\n            [dao.stream.observer :as observer]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as walker]\n            [yin.vm.engine :as engine]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.test-utils :as tu]))\n\n(defn run-measured!\n  \"Run the observer composition with one aggregate step budget. Answers the\n   terminal machine and exact number of vm/step calls, including across\n   multiple observer run callbacks. A blocked machine is not a completed lane.\"\n  [ast modules lane step-limit]\n  (when-not (and (contains? #{:walker :semantic} lane) (nat-int? step-limit))\n    (throw (ex-info \"Invalid lane or budget\" {:stage :configuration})))\n  (let [steps (atom 0)\n        run (fn [machine]\n              (loop [v machine]\n                (cond\n                  (or (vm/halted? v) (vm/blocked? v)) v\n                  (= @steps step-limit)\n                  (throw (ex-info \"Guest instruction budget exhausted\"\n                                  {:stage :instruction-limit :lane lane\n                                   :steps @steps :consumer v}))\n                  :else (let [v' (vm/step v)]\n                          (swap! steps inc)\n                          (recur v')))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       walker/vm-load-program)\n        session ((if semantic? tu/queue-rows! tu/queue-ast!)\n                 (tu/make-observer-session machine) ast)\n        answer (observer/run-on-stream session engine/ready-for-ingress?\n                                       (vm/fresh-code-loader load-program vm/ast-contract)\n                                       run)]\n    (when-not (zero? (get-in answer [:observer :ingress-gaps]))\n      (throw (ex-info \"Program stream gap\" {:stage :ingress-gap})))\n    {:machine (:consumer answer) :steps @steps}))\n\n(defn read-trace!\n  \"Read a halted lane's ring trace, refusing any evicted prefix or incomplete\n   drain. Byte size is UTF-8 pr-str of the vector, not in-memory occupancy.\"\n  [handle]\n  (let [old (stream/cursor handle stream/anchor-oldest)\n        new (stream/cursor handle stream/anchor-newest)\n        start (:dao.stream/cursor old)\n        end (:dao.stream/cursor new)\n        first-position (:dao.stream.ringbuffer/position start)\n        tail (:dao.stream.ringbuffer/position end)]\n    (when-not (and (= :dao.stream/ok (:dao.stream/outcome old))\n                   (= :dao.stream/ok (:dao.stream/outcome new))\n                   (integer? first-position) (integer? tail)\n                   (= (:dao.stream.ringbuffer/identity start)\n                      (:dao.stream.ringbuffer/identity end)))\n      (throw (ex-info \"Unrecognized trace cursor\" {:stage :trace-cursor})))\n    (when-not (zero? first-position)\n      (throw (ex-info \"Trace prefix evicted\" {:stage :trace-loss :lost first-position})))\n    (loop [cursor start, records []]\n      (let [result (stream/next handle cursor)]\n        (case (:dao.stream/outcome result)\n          :dao.stream/ok (recur (:dao.stream/cursor result)\n                                (conj records (:dao.stream/value result)))\n          (:dao.stream/blocked :dao.stream/end)\n          (if (and (= cursor end) (= tail (count records)))\n            {:records records :record-count (count records)\n             :serialized-bytes (alength (.getBytes (pr-str records) \"UTF-8\"))\n             :lost 0 :drain-outcome (:dao.stream/outcome result)}\n            (throw (ex-info \"Incomplete trace drain\" {:stage :trace-drain})))\n          (throw (ex-info \"Trace read refused\" {:stage :trace-drain\n                                                :outcome (:dao.stream/outcome result)})))))))\n M collab/yang-clojure/1794671000001-d1-bounds-declaration-draft.md\n?? collab/yang-clojure/1794422563000-engineer-d1-r9f-measurements.edn\n?? collab/yang-clojure/1794422563000-engineer-d