{"role":"tool","tool_call_id":"tool_cRgbhlkKL1P2dOdCqPrUVbgO","content":"1000\t            (throw e)))))))\n1001\t\n1002\t\n1003\t(defn- av-let\n1004\t  \"(let [p0 (data/nth av 0) ...] body): positional parameters of one arity.\n1005\t   A body that recurs is a loop over the same bindings: one recur target per\n1006\t   arity. Under the outcome model the body is lowered first.\"\n1007\t  [env macro-env params body-forms]\n1008\t  (let [bindings (into [] (mapcat (fn [i p] [p (list 'data/nth av-sym i)]) (range) params))\n1009\t        lowered? (outcomes? env)\n1010\t        body (if lowered?\n1011\t               (lower-function-body env macro-env params body-forms)\n1012\t               (body-expression body-forms))]\n1013\t    (if (some mentions-recur? body-forms)\n1014\t      (with-meta (if lowered?\n1015\t                   (list 'loop bindings body)\n1016\t                   (list* 'loop bindings body-forms))\n1017\t        {::fn-loop true})\n1018\t      (list 'let bindings body))))\n1019\t\n1020\t\n1021\t(defn- av-dispatch\n1022\t  \"Nested ifs over the argument vector's count, one branch per arity\n1023\t   {:n count :form branch}. An unmatched count falls through to a\n1024\t   zero-argument data/count, which the data module refuses with :reason\n1025\t   :arity; under the outcome model it is an arity error outcome naming\n1026\t   `fn-name` (or the anonymous fn's `source`) instead.\"\n1027\t  [env fn-name source arities]\n1028\t  (let [counts (map :n arities)]\n1029\t    (when (not= (count counts) (count (set counts)))\n1030\t      (reject! \"Two arities with the same parameter count\" {:counts (vec counts)}))\n1031\t    (reduce (fn [else {:keys [n form]}]\n1032\t              (list 'if\n1033\t                    (list 'data/content= (list 'data/count av-sym) n)\n1034\t                    form\n1035\t                    else))\n1036\t            (if (outcomes? env) (arity-error-form fn-name source) (list 'data/count))\n1037\t            (reverse arities))))\n1038\t\n1039\t\n1040\t(defn- check-av-params!\n1041\t  [params]\n1042\t  (when-not (vector? params)\n1043\t    (reject! \"fn parameters must be a vector\" {:params params}))\n1044\t  (doseq [p params]\n1045\t    (when (= '& p)\n1046\t      (reject! \"Variadic fn parameters are not supported\" {:params params}))\n1047\t    (check-binder! p params)))\n1048\t\n1049\t\n1050\t(defn- outcome-node\n1051\t  [tag value]\n1052\t  (u/app (u/v 'conj) (u/app (u/v 'conj) (u/lit []) (u/lit tag)) value))\n1053\t\n1054\t\n1055\t(defn- call-entry\n1056\t  \"The unary public entry, closed over a private argument-vector body.\n1057\t   A truthy second argument selects the unit's private intra-unit lane,\n1058\t   where `invocation` is already the positional argument vector.\"\n1059\t  []\n1060\t  (let [body (symbol (str reserved-prefix \"body\"))\n1061\t        invocation (symbol (str reserved-prefix \"invocation\"))\n1062\t        direct? (symbol (str reserved-prefix \"direct\"))\n1063\t        outcome (symbol (str reserved-prefix \"entry_outcome\"))\n1064\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n1065\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n1066\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n1067\t        binding-error (outcome-node\n1068\t                        error-tag\n1069\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n1070\t                               (u/lit :yin.k/message)\n1071\t                               (u/lit \"Clojure functions do not accept named arguments\")\n1072\t                               (u/lit :yin.k/data)\n1073\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n1074\t                                      (u/lit :yang.call/named) named)))\n1075\t        entry-body (u/let1\n1076\t                     outcome\n1077\t                     (u/if-node (u/app (u/v 'dsg__empty) named)\n1078\t                                (u/app (u/v body) positional)\n1079\t                                binding-error)\n1080\t                     (u/if-node (u/app (u/v 'dsg__equal)\n1081\t                                       (u/app (u/v 'data/nth) (u/v outcome) (u/lit 0))\n1082\t                                       (u/lit ok-tag))\n1083\t                                (u/app (u/v 'data/nth) (u/v outcome) (u/lit 1))\n1084\t                                (u/app raise\n1085\t                                       (u/app (u/v 'yang.call/thrown)\n1086\t                                              (u/app (u/v 'data/nth)\n1087\t                                                     (u/v outcome) (u/lit 1))))))\n1088\t        ;; The private lanes forward the body's outcome in tail position.\n1089\t        ;; The public 1-arg entry nil-fills `direct?` and converts outcomes\n1090\t        ;; to value/raise normally unless authenticated by `:clj/outcome-token`.\n1091\t        entry (u/lam [invocation direct?]\n1092\t                     (u/if-node\n1093\t                       (u/v direct?)\n1094\t                       (u/app (u/v body) (u/v invocation))\n1095\t                       (u/if-node\n1096\t                         (u/app (u/v 'dsg__equal)\n1097\t                                (u/app (u/v 'dsg__get) (u/v invocation)\n1098\t                                       (u/lit :clj/outcome-token))\n1099\t                                (u/v 'dsg__call_token))\n1100\t                         (u/if-node (u/app (u/v 'dsg__empty) named)\n1101\t                                    (u/app (u/v body) positional)\n1102\t                                    binding-error)\n1103\t                         entry-body)))]\n1104\t    (u/lam [body] entry)))\n1105\t\n1106\t\n1107\t(defn- admit-call-descriptor\n1108\t  \"Admit a descriptor constructed by trusted UAST/profile code. This is not\n1109\t   a source form: entry-spelled source maps never pass through this constructor.\"\n1110\t  [descriptor-ast tail?]\n1111\t  (let [descriptor-name 'dsg__descriptor\n1112\t        canonical (u/app (u/v 'dsg__assoc) descriptor-ast\n1113\t                         (u/lit :clj/admission) (u/lit nil))\n1114\t        ;; The factory closure captures the canonical descriptor and private\n1115\t        ;; token. Projection reconstructs and compares that opaque closure;\n1116\t        ;; it never applies a source-supplied predicate. An equal immutable\n1117\t        ;; reconstruction is the same value, not admission of different data.\n1118\t        witness (u/app (u/v 'dsg__make_admission) (u/v descriptor-name))\n1119\t        published (u/let1 descriptor-name canonical\n1120\t                          (u/app (u/v 'dsg__assoc) (u/v descriptor-name)\n1121\t                                 (u/lit :clj/admission) witness))]\n1122\t    (cond-> (u/mark-tails published)\n1123\t      tail? (assoc :tail? true))))\n1124\t\n1125\t\n1126\t(defn- compile-call-descriptor\n1127\t  \"Publish a private body through a canonical constructor-created entry.\"\n1128\t  [body-ast tail?]\n1129\t  (admit-call-descriptor\n1130\t    (u/app (u/v 'dsg__assoc) (u/lit {})\n1131\t           (u/lit :yang.call/entry) (u/app (u/v 'dsg__make_entry) body-ast)\n1132\t           (u/lit :clj/type) (u/lit :function)\n1133\t           (u/lit :clj/outcomes?) (u/lit true))\n1134\t    tail?))\n1135\t\n1136\t\n1137\t(defn- compile-av-fn\n1138\t  \"Compile arities [{:params :body}] to one closure over an argument vector.\n1139\t   `fn-name` names the function in an arity error outcome. Under the outcome\n1140\t   model the published value is an immutable common-call descriptor.\"\n1141\t  ([arities env tail? macro-env] (compile-av-fn arities env tail? macro-env nil nil))\n1142\t  ([arities env tail? macro-env fn-name] (compile-av-fn arities env tail? macro-env fn-name nil))\n1143\t  ([arities env tail? macro-env fn-name source]\n1144\t   (let [arities (mapv (fn [{:keys [params body]}]\n1145\t                         (check-av-params! params)\n1146\t                         {:n (count params)\n1147\t                          :form (av-let env macro-env params body)})\n1148\t                       arities)\n1149\t         body (compile-lambda [av-sym] (av-dispatch env fn-name source arities)\n1150\t                              env false macro-env)]\n1151\t     (if (outcomes? env)\n1152\t       (compile-call-descriptor body tail?)\n1153\t       (cond-> body tail? (assoc :tail? true))))))\n1154\t\n1155\t\n1156\t(defn- fn-arities\n1157\t  \"Arities of (fn [params] body*) or (fn ([params] body*)+) operands.\"\n1158\t  [operands]\n1159\t  (cond\n1160\t    (vector? (first operands))\n1161\t    [{:params (first operands), :body (rest operands)}]\n1162\t\n1163\t    (and (seq operands) (every? #(and (seq? %) (vector? (first %))) operands))\n1164\t    (mapv (fn [a] {:params (first a), :body (rest a)}) operands)\n1165\t\n1166\t    :else (reject! \"fn parameters must be a vector\" {:params (first operands)})))\n1167\t\n1168\t\n1169\t(defn- adapter-counts\n1170\t  \"The argument counts an adapter for native `sym` admits: the fixed arities\n1171\t   of its `:yin.k/arities` profile, extended to `adapter-variadic-cap` when\n1172\t   the profile is `:variadic`. A name with no declared profile admits\n1173\t   0 to `default-adapter-arity`.\"\n1174\t  [env sym]\n1175\t  (if-let [declared (get-in env [::convention :arities sym])]\n1176\t    (let [fixed (filter number? declared)\n1177\t          from (if (seq fixed) (apply max fixed) 0)]\n1178\t      (vec (sort (distinct (concat fixed\n1179\t                                   (when (some #{:variadic} declared)\n1180\t                                     (range from (inc (max from adapter-variadic-cap)))))))))\n1181\t    (vec (range (inc default-adapter-arity)))))\n1182\t\n1183\t\n1184\t(defn- compile-adapter\n1185\t  \"A fresh closure over the convention that calls native `sym` with the\n1186\t   unpacked arguments, for each admitted count.\"\n1187\t  [sym env tail? macro-env]\n1188\t  (let [arities (mapv (fn [n]\n1189\t                        (let [call (cons sym (map #(list 'data/nth av-sym %) (range n)))]\n1190\t                          {:n n\n1191\t                           :form (if (outcomes? env)\n1192\t                                   (lower-function-body env macro-env [] [call])\n1193\t                                   call)}))\n1194\t                      (adapter-counts env sym))]\n1195\t    (compile-lambda [av-sym] (av-dispatch env sym nil arities) env tail? macro-env)))\n1196\t\n1197\t\n1198\t(defn- apply-call?\n1199\t  \"True when `operator` is the `apply` intrinsic: not bound locally and not\n1200\t   defined by the program.\"\n1201\t  [env operator]\n1202\t  (and (= 'apply operator)\n1203\t       (not (contains? (locals env) operator))\n1204\t       (not (contains? (::defined env) operator))))\n1205\t\n1206\t\n1207\t(defn- intra-unit-fn?\n1208\t  \"True when `operator` statically names a top-level `defn`/`defn-` of this\n1209\t   unit under the outcome model: unshadowed by locals and never defined by\n1210\t   `def` or `defmacro`.\"\n1211\t  [env operator]\n1212\t  (and (outcomes? env)\n1213\t       (symbol? operator)\n1214\t       (not (contains? (locals env) operator))\n1215\t       (contains? (::defined-fns env) operator)))\n1216\t\n1217\t\n1218\t(defn- compile-guest-call\n1219\t  \"Admit a source operator before common invocation. Only generated UAST\n1220\t   implementation calls apply private closures directly.\"\n1221\t  [callee-ast arguments-ast env tail?]\n1222\t  (if-not (outcomes? env)\n1223\t    (cond-> (u/app callee-ast arguments-ast)\n1224\t      tail? (assoc :tail? true))\n1225\t    (let [callee (symbol (str reserved-prefix \"callee\"))\n1226\t          arguments (symbol (str reserved-prefix \"arguments\"))\n1227\t          escape (symbol (str reserved-prefix \"raise_escape\"))\n1228\t          condition (symbol (str reserved-prefix \"condition\"))\n1229\t          result (symbol (str reserved-prefix \"call_result\"))\n1230\t          condition->outcome (u/if-node\n1231\t                               (u/app (u/v 'dsg__equal)\n1232\t                                      (u/app (u/v 'dsg__get) (u/v condition)\n1233\t                                             (u/lit :yang.call/reason))\n1234\t                                      (u/lit :yang.call/thrown))\n1235\t                               (outcome-node\n1236\t                                 error-tag\n1237\t                                 (u/app (u/v 'dsg__get) (u/v condition)\n1238\t                                        (u/lit :yang.call/value)))\n1239\t                               (outcome-node error-tag (u/v condition)))\n1240\t          raise (u/lam [condition]\n1241\t                       (assoc (u/app (u/v escape)\n1242\t                                     (u/app (u/v 'dsg__assoc) (u/lit {})\n1243\t                                            (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n1244\t                                            (u/lit :clj/outcome) condition->outcome))\n1245\t                              :tail? true))\n1246\t          common-call (u/let1\n1247\t                        result\n1248\t                        (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n1249\t                               (u/lit []) raise)\n1250\t                        (outcome-node ok-tag (u/v result)))\n1251\t          refused (outcome-node\n1252\t                    error-tag\n1253\t                    (u/app (u/v 'yang.call/condition)\n1254\t                           (u/lit :yang.call/not-callable)\n1255\t                           (u/app (u/v 'dsg__assoc) (u/lit {})\n1256\t                                  (u/lit :yang.call/callee) (u/v callee))))\n1257\t          activation (u/if-node\n1258\t                       (u/app (u/v 'data/callable?) (u/v escape))\n1259\t                       common-call\n1260\t                       ;; Applying the escape resumes the capture operand.\n1261\t                       ;; Only our authenticated transfer packet may resume\n1262\t                       ;; here; an invalid captured value explicitly refuses.\n1263\t                       (u/if-node\n1264\t                         (u/app (u/v 'dsg__equal)\n1265\t                                (u/app (u/v 'dsg__get) (u/v escape)\n1266\t                                       (u/lit :clj/escape-token))\n1267\t                                (u/v 'dsg__call_token))\n1268\t                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\n1269\t                         (outcome-node\n1270\t                           error-tag\n1271\t                           (u/app (u/v 'yang.call/condition)\n1272\t                                  (u/lit :yang.call/invalid-invocation)\n1273\t                                  (u/lit {:yang.call/reason :missing-raise-exit})))))\n1274\t          public-bridge (u/app (u/lam [escape] activation) u/capture)\n1275\t          bridged (if tail?\n1276\t                    (u/if-node\n1277\t                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\n1278\t                      (u/app (u/v 'yang.call/invoke-with)\n1279\t                             (u/v callee) (u/v arguments) (u/lit [])\n1280\t                             (u/lam [condition] condition->outcome)\n1281\t                             (u/app (u/v 'dsg__assoc) (u/lit {})\n1282\t                                    (u/lit :clj/outcome-token) (u/v 'dsg__call_token)))\n1283\t                      public-bridge)\n1284\t                    public-bridge)\n1285\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n1286\t                              bridged refused)\n1287\t          ;; A callee carrying a call entry is convention territory whether it\n1288\t          ;; admits or forges one, so admission rules it. Everything else is a\n1289\t          ;; data-side invocation - a collection lookup or a raw closure call -\n1290\t          ;; and the guest library's invoker owns those semantics. The invoker\n1291\t          ;; is itself a published descriptor, so it is reached the same way\n1292\t          ;; any guest callee is; its raise escapes to a capture of this site\n1293\t          ;; and the resumed pass materializes the error outcome here.\n1294\t          value-call (u/app\n1295\t                       (u/lam ['dsg__raise_escape]\n1296\t                              (u/if-node\n1297\t                                (u/app (u/v 'data/callable?) (u/v 'dsg__raise_escape))\n1298\t                                (u/let1\n1299\t                                  (symbol (str reserved-prefix \"invoker_result\"))\n1300\t                                  (u/app (u/v 'yang.call/invoke)\n1301\t                                         (u/v 'invoke-value)\n1302\t                                         (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\n1303\t                                         (u/lit [])\n1304\t                                         (u/lam [condition]\n1305\t                                                (assoc (u/app (u/v 'dsg__raise_escape)\n1306\t                                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n1307\t                                                                     (u/lit :clj/escape-token) (u/v 'dsg__call_token)\n1308\t                                                                     (u/lit :clj/outcome) condition->outcome))\n1309\t                                                       :tail? true)))\n1310\t                                  (outcome-node ok-tag (u/v (symbol (str reserved-prefix \"invoker_result\")))))\n1311\t                                (u/if-node\n1312\t                                  (u/app (u/v 'dsg__equal)\n1313\t                                         (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n1314\t                                                (u/lit :clj/escape-token))\n1315\t                                         (u/v 'dsg__call_token))\n1316\t                                  (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n1317\t                                  (outcome-node\n1318\t                                    error-tag\n1319\t                                    (u/app (u/v 'yang.call/condition)\n1320\t                                           (u/lit :yang.call/invalid-invocation)\n1321\t                                           (u/lit {:yang.call/reason :missing-raise-exit}))))))\n1322\t                       u/capture)\n1323\t          routed (if (::invoker env)\n1324\t                   (u/if-node\n1325\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n1326\t                                (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n1327\t                                (u/lit false))\n1328\t                     admitted\n1329\t                     value-call)\n1330\t                   admitted)]\n1331\t      (cond-> (u/mark-tails (u/let1 callee callee-ast\n1332\t                                    (u/let1 arguments arguments-ast routed)))\n1333\t        tail? (assoc :tail? true)))))\n1334\t\n1335\t\n1336\t(defn- compile-apply\n1337\t  \"(apply f a b coll) as one application of f to the assembled argument\n1338\t   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n1339\t   serves a guest closure and an adapted native alike.\"\n1340\t  [operands env tail? macro-env]\n1341\t  (when (< (count operands) 2)\n1342\t    (reject! \"apply takes a function and an argument collection\"\n1343\t             {:operands (count operands)}))\n1344\t  (let [[f & more] operands\n1345\t        lead (vec (butlast more))\n1346\t        coll-form (list 'vec (last more))]\n1347\t    (compile-guest-call (compile-form f false env macro-env)\n1348\t                        (compile-form (if (seq lead)\n1349\t                                        (list 'data/into lead coll-form)\n1350\t                                        coll-form)\n1351\t                                      false env macro-env)\n1352\t                        env tail?)))\n1353\t\n1354\t\n1355\t(defn- compile-av-application\n1356\t  [operator operands env tail? macro-env]\n1357\t  (cond\n1358\t    (apply-call? env operator) (compile-apply operands env tail? macro-env)\n1359\t\n1360\t    ;; (:k m) / (:k m default): a static lookup\n1361\t    (keyword? operator)\n1362\t    (do (when-not (<= 1 (count operands) 2)\n1363\t          (reject! \"A keyword call takes a map and an optional default\"\n1364\t                   {:keyword operator, :operands (count operands)}))\n1365\t        (when (contains? (locals env) 'get)\n1366\t          (reject! \"A local binding of get would capture a keyword lookup\"\n1367\t                   {:keyword operator}))\n1368\t        (cond-> {:type :application\n1369\t                 :operator {:type :variable, :name 'get}\n1370\t                 :operands (into [(compile-form (first operands) false env macro-env)\n1371\t                                  (compile-literal operator false)]\n1372\t                                 (map #(compile-form % false env macro-env))\n1373\t                                 (rest operands))}\n1374\t          tail? (assoc :tail? true)))\n1375\t\n1376\t    (and (outcomes? env) (= operator 'yang.call/eligible?))\n1377\t    (let [candidate 'dsg__eligibility_candidate]\n1378\t      (cond-> (u/mark-tails\n1379\t                (apply u/app\n1380\t                       (u/lam [candidate]\n1381\t                              (u/if-node\n1382\t                                (u/app (u/v 'dsg__admitted?) (u/v candidate))\n1383\t                                (u/app (u/v 'yang.call/eligible?) (u/v candidate))\n1384\t                                (u/lit false)))\n1385\t                       (map #(compile-form % false env macro-env) operands)))\n1386\t        tail? (assoc :tail? true)))\n1387\t\n1388\t    (and (outcomes? env)\n1389\t         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n1390\t         (<= 4 (count operands)))\n1391\t    (let [bindings (into ['dsg__invocation_candidate]\n1392\t                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n1393\t                         (range (dec (count operands))))\n1394\t          compile-operand #(compile-form % false env macro-env)]\n1395\t      (cond-> (u/mark-tails\n1396\t                (apply u/app\n1397\t                       (u/lam bindings\n1398\t                              (u/if-node\n1399\t                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n1400\t                                (apply u/app (u/v operator) (map u/v bindings))\n1401\t                                (u/app (u/v 'yang.call/transfer)\n1402\t                                       (u/v (nth bindings 3))\n1403\t                                       (u/app (u/v 'yang.call/condition)\n1404\t                                              (u/lit :yang.call/not-callable)\n1405\t                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n1406\t                                                     (u/lit :yang.call/callee)\n1407\t                                                     (u/v (first bindings)))))))\n1408\t                       (map compile-operand operands)))\n1409\t        tail? (assoc :tail? true)))\n1410\t\n1411\t    ;; a statically intra-unit defn/defn- under the outcome model:\n1412\t    ;; dispatch through the unit's private entry lane without bridge capture\n1413\t    (intra-unit-fn? env operator)\n1414\t    (cond-> {:type :application\n1415\t             :operator {:type :variable, :name 'dsg__intra_call}\n1416\t             :operands [(cond-> {:type :variable, :name operator}\n1417\t                          (seq (meta operator)) (with-meta (meta operator)))\n1418\t                        (compile-form (vec operands) false env macro-env)]}\n1419\t      tail? (assoc :tail? true))\n1420\t\n1421\t    ;; a statically native name: call it directly\n1422\t    (native-name? env operator)\n1423\t    (cond-> {:type :application\n1424\t             :operator (cond-> {:type :variable, :name operator}\n1425\t                         (seq (meta operator)) (with-meta (meta operator)))\n1426\t             :operands (mapv #(compile-form % false env macro-env) operands)}\n1427\t      tail? (assoc :tail? true))\n1428\t\n1429\t    ;; anything else: one guest invocation, in tail position when the call is\n1430\t    :else\n1431\t    (compile-guest-call (compile-form operator false env macro-env)\n1432\t                        (compile-form (vec operands) false env macro-env)\n1433\t                        env tail?)))\n1434\t\n1435\t\n1436\t(defn compile-application\n1437\t  \"Compile a function application to Universal AST.\n1438\t\n1439\t  Clojure: (+ 1 2)\n1440\t  AST: {:type :application\n1441\t        :operator <compiled-operator>\n1442\t        :operands [<compiled-operand1> <compiled-operand2>]}\n1443\t\n1444\t  Under the argument-vector convention a user-function call passes its\n1445\t  operands as one vector.\"\n1446\t  ([operator operands env tail?] (compile-application operator operands env tail? initial-macro-env))\n1447\t  ([operator operands env tail? macro-env]\n1448\t   (if (and (::convention env) (not (macro-call? env macro-env operator)))\n1449\t     (compile-av-application operator operands env tail? macro-env)\n1450\t     (let [compiled-operator (compile-form operator false env macro-env)\n1451\t           compiled-operands (mapv #(compile-form % false env macro-env) operands)]\n1452\t       (cond-> {:type :application,\n1453\t                :operator compiled-operator,\n1454\t                :operands compiled-operands}\n1455\t         tail? (assoc :tail? true))))))\n1456\t\n1457\t\n1458\t(defn compile-dao-stream-apply-call\n1459\t  \"Compile a dao