dy env tail? macro-env)))\n1884\t          ;; Conditional: (if test consequent alternate?)\n1885\t          if (let [[test consequent alternate] operands]\n1886\t               (compile-if test consequent alternate (> (count operands) 2) env tail? macro-env))\n1887\t          ;; Let binding: (let [bindings] body)\n1888\t          let (let [[bindings & body] operands\n1889\t                    body-expr (if (= 1 (count body)) (first body) (cons 'do body))]\n1890\t                (compile-let bindings body-expr env tail? macro-env))\n1891\t          ;; Do block: (do expr1 expr2 ...)\n1892\t          do (compile-do operands env tail? macro-env)\n1893\t          loop (compile-loop operands env tail? macro-env (::fn-loop (meta form)))\n1894\t          ;; (yin.k/outcome-of (f x)): the call's outcome as a value, not unwrapped\n1895\t          ;; internal, from the outcome lowering: its bindings are already plain\n1896\t          dsg__let (compile-let-simple (first operands) (body-expression (rest operands))\n1897\t                                       env tail? macro-env)\n1898\t          recur (compile-recur operands env tail? macro-env)\n1899\t          (case cond when if-let if-some when-let when-some ->)\n1900\t          (compile-lowered (expand-control env operator operands)\n1901\t                           tail? env macro-env)\n1902\t          ;; Short-circuit logical: expand to if chains so unevaluated operands are never touched\n1903\t          ;; (and)       → true\n1904\t          ;; (and x)     → x\n1905\t          ;; (and x y z) → (dsg__let [g x] (if g (and y z) g))\n1906\t          and (cond\n1907\t                (empty? operands) {:type :literal :value true}\n1908\t                (= 1 (count operands)) (compile-form (first operands) tail? env macro-env)\n1909\t                :else (let [g (gen-name env \"and\")]\n1910\t                        (compile-lowered (list 'dsg__let [g (first operands)]\n1911\t                                               (list 'if g (cons 'and (rest operands)) g))\n1912\t                                         tail? env macro-env)))\n1913\t          ;; (or)        → nil\n1914\t          ;; (or x)      → x\n1915\t          ;; (or x y z)  → (dsg__let [g x] (if g g (or y z)))\n1916\t          or  (cond\n1917\t                (empty? operands) {:type :literal :value nil}\n1918\t                (= 1 (count operands)) (compile-form (first operands) tail? env macro-env)\n1919\t                :else (let [g (gen-name env \"or\")]\n1920\t                        (compile-lowered (list 'dsg__let [g (first operands)]\n1921\t                                               (list 'if g g (cons 'or (rest operands))))\n1922\t                                         tail? env macro-env)))\n1923\t          ;; Quote: (quote form)\n1924\t          quote (compile-quote (first operands) tail?)\n1925\t          ;; Def: (def sym value)\n1926\t          def (let [[sym value] operands]\n1927\t                (check-top-level! env top? operator)\n1928\t                (compile-def sym value env tail? macro-env))\n1929\t          ;; Macro definition: (defmacro name params & body)\n1930\t          defmacro (do (check-top-level! env top? operator)\n1931\t                       (compile-defmacro operands env tail? macro-env))\n1932\t          ;; Function application: (f arg1 arg2 ...)\n1933\t          (compile-application operator operands env tail? macro-env))))\n1934\t    ;; Unknown form type\n1935\t    :else (throw (ex-info \"Cannot compile unknown form type\"\n1936\t                          {:form form,\n1937\t                           :type #?(:cljd (clojure.core/str (.-runtimeType form))\n1938\t                                    :default (clojure.core/type form))}))))\n1939\t\n1940\t\n1941\t(defn compile-form\n1942\t  \"Compile one Clojure form and retain the reader's plain metadata on the\n1943\t   emitted Universal AST node. The tuple boundary removes it from content\n1944\t   and writes positions and other frontend facts to occurrence side tables.\"\n1945\t  ([form] (compile-form form false {} initial-macro-env))\n1946\t  ([form env] (compile-form form false env initial-macro-env))\n1947\t  ([form tail? env] (compile-form form tail? env initial-macro-env))\n1948\t  ([form tail? env macro-env]\n1949\t   (let [ast (compile-form* form tail? (dissoc env ::top-level) macro-env\n1950\t                            (::top-level env))\n1951\t         m (meta form)]\n1952\t     (if (seq (dissoc m ::fn-loop))\n1953\t       (vary-meta ast merge (dissoc m ::fn-loop))\n1954\t       ast))))\n1955\t\n1956\t\n1957\t(defn- top-level-defined-fns\n1958\t  \"Plain symbols in `forms` whose top-level definitions are exclusively native\n1959\t   `defn` or `defn-` descriptors. Any `def`, `defmacro`, or external macro\n1960\t   excludes the symbol (or the unit, when macros are active) from static\n1961\t   intra-unit dispatch so dynamic admission still governs.\"\n1962\t  [forms external-macros]\n1963\t  (if (or (seq external-macros)\n1964\t          (some #(and (seq? %) (= 'defmacro (first %))) forms))\n1965\t    #{}\n1966\t    (:fns\n1967\t      (reduce (fn [{:keys [fns non-fns] :as acc} f]\n1968\t                (if-not (and (seq? f) (symbol? (second f)))\n1969\t                  acc\n1970\t                  (let [head (first f)\n1971\t                        sym  (strip-symbol-meta (second f))]\n1972\t                    (cond\n1973\t                      (= 'def head)\n1974\t                      {:fns (disj fns sym), :non-fns (conj non-fns sym)}\n1975\t\n1976\t                      (contains? #{'defn 'defn-} head)\n1977\t                      {:fns     (if (contains? non-fns sym) fns (conj fns sym))\n1978\t                       :non-fns non-fns}\n1979\t\n1980\t                      :else acc))))\n1981\t              {:fns #{}, :non-fns #{}}\n1982\t              forms))))\n1983\t\n1984\t\n1985\t(defn- program-env\n1986\t  \"The compile-time env of one program. Without `opts` it is empty: the\n1987\t   native path. `{:convention :arg-vector, :native #{symbol}, :macros\n1988\t   #{symbol}}` opts into the argument-vector convention: `:native` names the\n1989\t   primitives a bare symbol may call directly (a set, or a map from name to\n1990\t   its published profile, whose `:yin.k/arities` give an adapter its admitted\n1991\t   counts), `:macros` the expander-side\n1992\t   macro names whose calls must stay ordinary applications. The program's\n1993\t   own top-level definitions are never native. `:outcomes true` adds the\n1994\t   outcome model (see its section); `:adapters` maps a primitive that\n1995\t   declares domain failures to the host adapter returning its outcome.\"\n1996\t  [forms opts]\n1997\t  (if-not opts\n1998\t    {}\n1999\t    (do (when-not (= :arg-vector (:convention opts))\n2000\t          (reject! \"Unknown compile-program convention\" {:opts opts}))\n2001\t        (when-let [hit (seq (filter control-heads (:macros opts)))]\n2002\t          (reject! \"A :macros entry names a compiler form\" {:macros (vec hit)}))\n2003\t        (let [defined (into #{}\n2004\t                            (keep (fn [f]\n2005\t                                    (when (and (seq? f)\n2006\t                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\n2007\t                                               (symbol? (second f)))\n2008\t                                      (strip-symbol-meta (second f)))))\n2009\t                            forms)\n2010\t              defined-fns (top-level-defined-fns forms (:macros opts))]\n2011\t          ;; the compiler emits bare conj and vec (collection literals, apply),\n2012\t          ;; so a program definition of either would capture them\n2013\t          (when-let [hit (first (filter #{'conj 'vec} defined))]\n2014\t            (reject! (str \"Defining \" hit \" would capture the argument-vector constructor\")\n2015\t                     {:name hit}))\n2016\t          (cond-> {::convention {:native (set (if (map? (:native opts))\n2017\t                                                (keys (:native opts))\n2018\t                                                (:native opts)))\n2019\t                                 :arities (into {}\n2020\t                                                (keep (fn [[sym profile]]\n2021\t                                                        (when-let [a (if (map? profile)\n2022\t                                                                       (:yin.k/arities profile)\n2023\t                                                                       profile)]\n2024\t                                                          [sym a])))\n2025\t                                                (when (map? (:native opts)) (:native opts)))\n2026\t                                 :macros (set (:macros opts))}\n2027\t                   ::defined defined\n2028\t                   ::defined-fns defined-fns\n2029\t                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n2030\t                                                  (= 'invoke-value (second %))\n2031\t                                                  (:yin.k/invoker (meta (second %)))) forms))}\n2032\t            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n2033\t\n2034\t\n2035\t(defn- check-program-symbols!\n2036\t  \"The program pre-pass. Quoted data is exempt. The reserved prefix names\n2037\t   compiler temporaries, so no user symbol may carry it in ANY position\n2038\t   (binder, reference, definition name); `loop` and `recur` are special forms,\n2039\t   so they may only head a list, never stand as a value or a binder.\"\n2040\t  [form]\n2041\t  (cond\n2042\t    (symbol? form)\n2043\t    (do (when (reserved-name? form)\n2044\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n2045\t                   {:symbol form, :prefix reserved-prefix}))\n2046\t        (when (and (nil? (namespace form)) (contains? #{'loop 'recur} form))\n2047\t          (reject! (str form \" is only legal in operator position\") {:symbol form})))\n2048\t    (seq? form)\n2049\t    (when-not (= 'quote (first form))\n2050\t      (let [head (first form)]\n2051\t        (when (and (symbol? head) (reserved-name? head))\n2052\t          (reject! \"Symbol uses the reserved destructuring prefix\"\n2053\t                   {:symbol head, :prefix reserved-prefix}))\n2054\t        (when-not (symbol? head)\n2055\t          (check-program-symbols! head))\n2056\t        (run! check-program-symbols! (rest form))))\n2057\t    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n2058\t    (coll? form) (run! check-program-symbols! form)))\n2059\t\n2060\t\n2061\t(defn- check-top-level-discard!\n2062\t  \"Only the last top-level form's outcome reaches the harness, so a non-final,\n2063\t   non-definition form that may fail would have its error silently discarded:\n2064\t   refuse it, as a def value that calls guest functions is refused. Returns\n2065\t   `form`.\"\n2066\t  [env macro-env forms form]\n2067\t  (when (and (next forms)\n2068\t             (not (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form))))\n2069\t             (failing? (assoc env ::macro-env macro-env) (rewrite-ex-info form)))\n2070\t    (reject! \"A non-final top-level form that may fail would discard its error outcome\"\n2071\t             {:form form}))\n2072\t  form)\n2073\t\n2074\t\n2075\t(defn- lower-top-form\n2076\t  \"Under the outcome model a top-level expression returns an outcome like a\n2077\t   function body; definitions keep their own lowering.\"\n2078\t  [env macro-env form]\n2079\t  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\n2080\t    form\n2081\t    (lower-function-body env macro-env [] [form])))\n2082\t\n2083\t\n2084\t(defn compile-program\n2085\t  \"Compile a sequence of Clojure forms into a single Universal AST.\n2086\t   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n2087\t   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n2088\t   with :macro? true on the lambda; the encoder turns that flag into a\n2089\t   declaration row and the expander, not this compiler, recognizes calls.\n2090\t   The three-argument form takes `opts` opting into the argument-vector\n2091\t   convention (see `program-env`); without it the output is the native one.\"\n2092\t  ([forms] (compile-program forms true))\n2093\t  ([forms tail?] (compile-program forms tail? nil))\n2094\t  ([forms tail? opts]\n2095\t   (run! check-program-symbols! forms)\n2096\t   (let [env (program-env forms opts)]\n2097\t     ;; A discarded definition must not become a lexical binding in the\n2098\t     ;; following definitions. Descriptor entry and body closures both capture\n2099\t     ;; their environment: retaining the previous descriptor here doubles its\n2100\t     ;; paths at each definition during machine-data validation and UCF lift.\n2101\t     (letfn [(discard-result\n2102\t               [ast]\n2103\t               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n2104\t             (go\n2105\t               [forms macro-env]\n2106\t               (if (empty? forms)\n2107\t                 (compile-literal nil tail?)\n2108\t                 (let [head       (cond->> (first forms)\n2109\t                                    (outcomes? env) (check-top-level-discard! env macro-env forms)\n2110\t                                    (outcomes? env) (lower-top-form env macro-env))\n2111\t                       rest-forms (rest forms)]\n2112\t                   (cond\n2113\t                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n2114\t                     ;; lambda the encoder declares; later forms see the name\n2115\t                     ;; only so the native defn lowering can yield to it.\n2116\t                     (and (seq? head) (= 'defmacro (first head)))\n2117\t                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n2118\t                       (cond-> {:type     :application\n2119\t                                :operator {:type :lambda, :params ['_]\n2120\t                                           :body (go rest-forms\n2121\t                                                     (assoc macro-env\n2122\t                                                            (strip-symbol-meta (second head))\n2123\t                                                            {:type :user}))}\n2124\t                                :operands [(discard-result defined)]}\n2125\t                         tail? (assoc :tail? true)))\n2126\t                     ;; def: sequence with current macro-env\n2127\t                     (and (seq? head) (= 'def (first head)))\n2128\t                     (let [[_ name value] head\n2129\t                           value (cond-> value (outcomes? env) rewrite-ex-info)]\n2130\t                       (when (and (outcomes? env)\n2131\t                                  (failing? (assoc env ::macro-env macro-env) value))\n2132\t                         (reject! \"A def value cannot call guest functions under the outcome model\"\n2133\t                                  {:name name}))\n2134\t                       (cond-> {:type     :application\n2135\t                                :operator {:type :lambda, :params ['_]\n2136\t                                           :body (go rest-forms macro-env)}\n2137\t                                :operands [(discard-result (compile-def name value env false macro-env))]}\n2138\t                         tail? (assoc :tail? true)))\n2139\t                     ;; single form\n2140\t                     (= 1 (count forms))\n2141\t                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n2142\t                     ;; sequence\n2143\t                     :else\n2144\t                     (cond-> {:type     :application\n2145\t                              :operator {:type :lambda, :params ['_]\n2146\t                                         :body (go rest-forms macro-env)}\n2147\t                              :operands [(discard-result\n2148\t                                           (compile-form head false\n2149\t                                                         (assoc env ::top-level true) macro-env))]}\n2150\t                       tail? (assoc :tail? true))))))]\n2151\t       (cond->> (go forms initial-macro-env)\n2152\t         (outcomes? env) (#(u/app\n2153\t                             (u/lam '[dsg__admitted? dsg__intra_call] %)\n2154\t                             (u/sexp->uast\n2155\t                               '(fn [dsg__candidate]\n2156\t                                  (if (data/map? dsg__candidate)\n2157\t                                    (let [dsg__entry (dsg__get dsg__candidate :yang.call/entry)\n2158\t                                          dsg__witness (dsg__get dsg__candidate :clj/admission)]\n2159\t                                      (if (data/callable? dsg__entry)\n2160\t                                        (if (data/callable? dsg__witness)\n2161\t                                          (dsg__equal\n2162\t                                            dsg__witness\n2163\t                                            (dsg__make_admission\n2164\t                                              (dsg__assoc dsg__candidate :clj/admission nil)))\n2165\t                                          false)\n2166\t                                        false))\n2167\t                                    false)))\n2168\t                             (u/sexp->uast\n2169\t                               (list 'fn '[dsg__callee dsg__args]\n2170\t                                     (list 'if '(data/map? dsg__callee)\n2171\t                                           (list (list (if (contains? (::defined env) 'get)\n2172\t                                                         'dsg__get\n2173\t                                                         'get)\n2174\t                                                       'dsg__callee\n2175\t                                                       :yang.call/entry)\n2176\t                                                 'dsg__args\n2177\t                                                 true)\n2178\t                                           '(conj (conj [] :yin.k/error)\n2179\t                                                  (yang.call/condition\n2180\t                                                    :yang.call/not-callable\n2181\t                                                    (dsg__assoc {} :yang.call/callee dsg__callee))))))))\n2182\t         (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n2183\t         (outcomes? env) (u/let1\n2184\t                           'dsg__make_admission\n2185\t                           (u/sexp->uast\n2186\t                             '(fn [dsg__descriptor]\n2187\t                                (fn [dsg__candidate]\n2188\t                                  (if (data/callable? dsg__call_token)\n2189\t                                    (dsg__get dsg__descriptor :yang.call/entry)\n2190\t                                    nil)))))\n2191\t         (outcomes? env) (u/then\n2192\t                           (discard-result\n2193\t                             (u/app (u/lam '[get = assoc empty?] call/uast)\n2194\t                                    (u/v 'dsg__get) (u/v 'dsg__equal)\n2195\t                                    (u/v 'dsg__assoc) (u/v 'dsg__empty))))\n2196\t         (outcomes? env) (u/let1 'dsg__call_token (u/lam [] (u/lit nil)))\n2197\t         ;; Guest closures keep captured environments portable: binding host\n2198\t         ;; primitive values here would make UCF machine-data validation fail.\n2199\t         ;; These helpers cover generated map lookups/writes and comparisons;\n2200\t         ;; conj/vec are already protected by the convention's binder checks.\n2201\t         ;; Evaluate siblings outside each other's bindings to avoid retaining\n2202\t         ;; a chain of redundant helper environments.\n2203\t         (outcomes? env) (#(u/app\n2204\t                             (u/lam '[dsg__get dsg__equal dsg__assoc dsg__empty] %)\n2205\t                             (if (contains? (::defined env) 'get)\n2206\t                               (u/sexp->uast\n2207\t                                 '(fn [m k]\n2208\t                                    (if (data/map? m)\n2209\t                                      (let [find (fn [self entries]\n2210\t                                                   (if (data/content= 0 (data/count entries))\n2211\t                                                     nil\n2212\t                                                     (let [pair (data/nth entries 0)]\n2213\t                                                       (if (data/content= k (data/nth pair 0))\n2214\t                                                         (data/nth pair 1)\n2215\t                                                         (self self (data/subvec entries 1))))))]\n2216\t                                        (find find (vec m)))\n2217\t                                      nil)))\n2218\t                               (u/sexp->uast '(fn [m k] (get m k))))\n2219\t                             (u/sexp->uast '(fn [a b] (data/content= a b)))\n2220\t                             (if (contains? (::defined env) 'assoc)\n2221\t                               (u/sexp->uast\n2222\t                                 '(fn [m k v k2 v2 k3 v3]\n2223\t                                    (let [one (conj m (conj [] k v))]\n2224\t                                      (if (data/content= k2 nil)\n2225\t                                        one\n2226\t                                        (let [two (conj one (conj [] k2 v2))]\n2227\t                                          (if (data/content= k3 nil)\n2228\t                                            two\n2229\t                                            (conj two (conj [] k3 v3))))))))\n2230\t                               (u/sexp->uast\n2231\t                                 '(fn [m k v k2 v2 k3 v3]\n2232\t                                    (if (data/content= k2 nil)\n2233\t                                      (assoc m k v)\n2234\t                                      (if (data/content= k3 nil)\n2235\t                                        (assoc m k v k2 v2)\n2236\t                                        (assoc m k v k2 v2 k3 v3))))))\n2237\t                             (u/sexp->uast '(fn [xs] (data/content= 0 (data/count xs))))))\n2238\t         (outcomes? env) u/mark-tails)))))\n2239\t"}
{"role":"tool","tool_call_id":"tool_WSy9cnNiG0NzjVCir5EB0uNm","content":"1\t(ns yang.core.call\n2\t  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n3\t   §8.10). This namespace emits the same pure definitions into bundled\n4\t   preludes and the linked `yang.call` module.\"\n5\t  (:require [yang.core.prelude :as core]\n6\t            [yang.core.uast :as u]))\n7\t\n8\t\n9\t(def module-name\n10\t  \"The linker module that publishes the shared calling runtime.\"\n11\t  'yang.call)\n12\t\n13\t\n14\t(def host-names\n15\t  \"Host module names read by the guest definitions.\"\n16\t  '#{cell/get data/callable? data/contains? data/count data/map? data/nth\n17\t     data/string? data/vector?})\n18\t\n19\t\n20\t(def definitions\n21\t  \"The one ordered definition list used by both emitters.\"\n22\t  '[;; Descriptor projection remains structural after callable admission.\n23\t    [yang.call/_descriptor\n24\t     (fn [callable]\n25\t       (if (data/map? callable)\n26\t         (if (= (get callable :type) :cell-ref)\n27\t           (cell/get callable)\n28\t           callable)\n29\t         nil))]\n30\t    [yang.call/entry\n31\t     (fn [callable]\n32\t       (get (yang.call/_descriptor callable) :yang.call/entry))]\n33\t    [yang.call/eligible?\n34\t     (fn [callable]\n35\t       (let [descriptor (yang.call/_descriptor callable)]\n36\t         (if (nil? (yang.call/entry callable))\n37\t           false\n38\t           (if (data/contains? descriptor :yang.call/eligible?)\n39\t             ((get descriptor :yang.call/eligible?) callable)\n40\t             true))))]\n41\t    [yang.call/invocation\n42\t     (fn [callee positional named raise]\n43\t       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n44\t                            :yang.call/positional positional)\n45\t                     :yang.call/named named)\n46\t              :yang.call/raise raise))]\n47\t    [yang.call/invocation-with\n48\t     (fn [callee positional named raise options]\n49\t       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n50\t                            :yang.call/positional positional)\n51\t                     :yang.call/named named)\n52\t              :yang.call/raise raise))]\n53\t    [yang.call/_pair?\n54\t     (fn [pair]\n55\t       (if (data/vector? pair)\n56\t         (= (data/count pair) 2)\n57\t         false))]\n58\t    [yang.call/_named-pairs?\n59\t     (fn [pairs index]\n60\t       (if (= index (data/count pairs))\n61\t         true\n62\t         (let [pair (data/nth pairs index)]\n63\t           (if (yang.call/_pair? pair)\n64\t             (if (data/string? (data/nth pair 0))\n65\t               (yang.call/_named-pairs? pairs (+ index 1))\n66\t               false)\n67\t             false))))]\n68\t    [yang.call/valid-invocation?\n69\t     (fn [invocation]\n70\t       (if (data/map? invocation)\n71\t         (if (data/contains? invocation :yang.call/callee)\n72\t           (if (data/contains? invocation :yang.call/positional)\n73\t             (if (data/contains? invocation :yang.call/named)\n74\t               (if (data/contains? invocation :yang.call/raise)\n75\t                 (if (data/vector? (get invocation :yang.call/positional))\n76\t                   (if (data/vector? (get invocation :yang.call/named))\n77\t                     (yang.call/_named-pairs?\n78\t                       (get invocation :yang.call/named) 0)\n79\t                     false)\n80\t                   false)\n81\t                 false)\n82\t               false)\n83\t             false)\n84\t           false)\n85\t         false))]\n86\t    [yang.call/condition\n87\t     (fn [reason evidence]\n88\t       (assoc (assoc {} :yang.call/reason reason)\n89\t              :yang.call/data evidence))]\n90\t    [yang.call/thrown\n91\t     (fn [value]\n92\t       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n93\t              :yang.call/value value))]\n94\t    [yang.call/transfer\n95\t     (fn [raise condition]\n96\t       (raise condition))]\n97\t    [yang.call/invoke\n98\t     (fn [callable positional named raise]\n99\t       (if (data/callable? raise)\n100\t         (if (yang.call/eligible? callable)\n101\t           (let [target (yang.call/entry callable)\n102\t                 record (yang.call/invocation callable positional named raise)]\n103\t             (if (not (nil? target))\n104\t               (if (yang.call/valid-invocation? record)\n105\t                 (target record)\n106\t                 (yang.call/transfer\n107\t                   raise\n108\t                   (yang.call/condition :yang.call/invalid-invocation\n109\t                                        {:yang.call/callee callable})))\n110\t               (yang.call/transfer\n111\t                 raise\n112\t                 (yang.call/condition :yang.call/invalid-invocation\n113\t                                      {:yang.call/callee callable}))))\n114\t           (yang.call/transfer\n115\t             raise\n116\t             (yang.call/condition :yang.call/not-callable\n117\t                                  {:yang.call/callee callable})))\n118\t         (raise (yang.call/condition :yang.call/invalid-invocation\n119\t                                     {:yang.call/reason :missing-raise-exit}))))]\n120\t    [yang.call/invoke-with\n121\t     (fn [callable positional named raise options]\n122\t       (if (data/callable? raise)\n123\t         (if (yang.call/eligible? callable)\n124\t           (let [target (yang.call/entry callable)\n125\t                 record (yang.call/invocation-with\n126\t                          callable positional named raise options)]\n127\t             (if (not (nil? target))\n128\t               (if (yang.call/valid-invocation? record)\n129\t                 (target record)\n130\t                 (yang.call/transfer\n131\t                   raise\n132\t                   (yang.call/condition :yang.call/invalid-invocation\n133\t                                        {:yang.call/callee callable})))\n134\t               (yang.call/transfer\n135\t                 raise\n136\t                 (yang.call/condition :yang.call/invalid-invocation\n137\t                                      {:yang.call/callee callable}))))\n138\t           (yang.call/transfer\n139\t             raise\n140\t             (yang.call/condition :yang.call/not-callable\n141\t                                  {:yang.call/callee callable})))\n142\t         (raise (yang.call/condition :yang.call/invalid-invocation\n143\t                                     {:yang.call/reason :missing-raise-exit}))))]])\n144\t\n145\t\n146\t(def ^:private public-exports\n147\t  '#{entry eligible? invocation invocation-with valid-invocation? condition\n148\t     thrown transfer invoke invoke-with})\n149\t\n150\t\n151\t(def uast\n152\t  \"The bundled definitions, in source order and tail marked.\"\n153\t  (u/mark-tails\n154\t    (reduce (fn [ast [key form]]\n155\t              (u/then ast (u/def! key (u/sexp->uast form))))\n156\t            (u/def! (ffirst definitions)\n157\t                    (u/sexp->uast (second (first definitions))))\n158\t            (rest definitions))))\n159\t\n160\t\n161\t(def module-uast\n162\t  \"The linked module tree built from the same `definitions`.\"\n163\t  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n164\t                                          [] definitions)]\n165\t    (core/module-tree stripped [])))\n166\t\n167\t\n168\t(def module-exports\n169\t  \"Public module exports (private helper definitions stay internal).\"\n170\t  public-exports)\n171\t\n172\t\n173\t(def ^:private module-free-names\n174\t  (core/free-name-vec module-uast))\n175\t\n176\t\n177\t(defn module-spec\n178\t  \"The linker module spec for `yang.call` over `registry`.\"\n179\t  [registry]\n180\t  (core/module-spec {:module-name module-name\n181\t                     :ast module-uast\n182\t                     :exports module-exports\n183\t                     :requires {}\n184\t                     :free-names module-free-names\n185\t                     :registry registry\n186\t                     :message \"the yang.call module reads an undeclared name\"\n187\t                     :refusal-ns \"yang.call\"}))"}
