n/vm/semantic.cljc-284-\nsrc/cljc/yin/vm/semantic.cljc-285-\nsrc/cljc/yin/vm/semantic.cljc-286-(defn run-fuel\nsrc/cljc/yin/vm/semantic.cljc-287-  \"One budgeted action, followed by at most one bridge step. Fuel counts\nsrc/cljc/yin/vm/semantic.cljc:288:   completed guest instructions per visited task, without a wall-clock bound.\"\nsrc/cljc/yin/vm/semantic.cljc-289-  [machine n]\nsrc/cljc/yin/vm/semantic.cljc-290-  (when-not (and (code/reg? n) (pos? n))\nsrc/cljc/yin/vm/semantic.cljc-291-    (throw (ex-info \"Fuel must be a positive exact integer\" {:rule :fuel :fuel n})))\nsrc/cljc/yin/vm/semantic.cljc-292-  (check-gate! machine)\nsrc/cljc/yin/vm/semantic.cljc-293-  (let [v (if (some? (:control machine))\nsrc/cljc/yin/vm/semantic.cljc-294-            (vm-hot* machine n)\n--\nsrc/cljc/yin/vm/linker/closure.cljc-209-                    st (update st :requires conj\nsrc/cljc/yin/vm/linker/closure.cljc-210-                               {:module manifest-address :name n :manifest pinned\nsrc/cljc/yin/vm/linker/closure.cljc-211-                                :eager? eager?})]\nsrc/cljc/yin/vm/linker/closure.cljc-212-                (cond\nsrc/cljc/yin/vm/linker/closure.cljc-213-                  (not eager?) st\nsrc/cljc/yin/vm/linker/closure.cljc-214-\nsrc/cljc/yin/vm/linker/closure.cljc:215:                  (contains? (:visited st) pinned) st\nsrc/cljc/yin/vm/linker/closure.cljc-216-\nsrc/cljc/yin/vm/linker/closure.cljc-217-                  (> (inc depth) (get-in st [:bounds :max-depth]))\nsrc/cljc/yin/vm/linker/closure.cljc-218-                  (reduced (stop st (invalid pinned :require (conj path pinned)\nsrc/cljc/yin/vm/linker/closure.cljc-219-                                             :parts-limit {:bound :max-depth})))\nsrc/cljc/yin/vm/linker/closure.cljc-220-\nsrc/cljc/yin/vm/linker/closure.cljc-221-                  :else\n--\nsrc/cljc/yin/vm/linker/closure.cljc-235-      (linker/manifest-defect manifest)\nsrc/cljc/yin/vm/linker/closure.cljc-236-      (s