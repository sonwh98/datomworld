\n306:(defn call-provenance-handles\n310:   `retained-packet-call-provenance` — including after the session's\n313:  (:call-provenance-handles state))\n316:(defn call-provenance-failures\n322:   `call-provenance-handles`; an unclaimed admission appears in\n325:  (:call-provenance-failures state))\n1391:   recorded for this round (`:call-provenance-round-failures`, r8 F1)\n1396:  (let [retention (retention-notice (:call-provenance-round-failures state))\n1397:        state (dissoc state :call-provenance-round-failures)\n1541:   the other.  `latest` is the round's shell-owned accumulator (r11):\n1547:  [{:keys [load-program output-stream] :as state} latest]\n1554:        ;; out (`call-provenance-handles`). Unclaimed packets retain\n1576:                                          (retain-packet-call-provenance!\n1602:               ;; (`latest`), the record recovery reads; the program\n1605:               ;; ::call-provenance-* keys cannot fabricate handles,\n1607:               (vswap! latest\n1611:                           (update :call-provenance-handles merge @handles)\n1613:                           (-> (update :call-provenance-failures\n1615:                               (assoc :call-provenance-round-failures\n1621:      (seq @handles) (update :call-provenance-handles merge @handles)\n1622:      (seq @failures) (-> (update :call-provenance-failures\n1624:                          (assoc :call-provenance-round-failures\n1986:  ;; r4 F4: the latest known state of this evaluation, so recovery\n1990:  (let [latest (volatile! expanded)]\n1993:          evaluated (do (vreset! latest (run-evaluator-stage expanded latest))\n1994:                        @latest)\n2007:              _ (vreset! latest state')]\n2026:      ;; is read EXCLUSIVELY from @latest (r11) -- the shell-owned\n2045:                                  ;; session: @latest is the latest known\n2048:                                  (seq (:call-provenance-handles @latest))\n2049:                                  (update :call-provenance-handles\n2051:                                          (:call-provenance-handles @latest))\n2057:                                  (seq (:call-provenance-failures @latest))\n2058:                                  (assoc :call-provenance-failures\n2059:                                         (:call-provenance-failures @latest))\n2060:                                  (seq (:call-provenance-round-failures\n2061:                                        @latest))\n2062:                                  (assoc :call-provenance-round-failures\n2063:                                         (:call-provenance-round-failures\n2064:                                           @latest)))\nrg: src/cljc/yin/vm/register/code.cljc: IO error for operation on src/cljc/yin/vm/register/code.cljc: No such file or directory (os error 2)\n  \"The evaluator half of a round whose expander forwarded a program: run\n   it, then either finalize the value, drive its require to a conclusion,\n   or park it as `:pending-run`.  `state` is the round's starting state;\n   `expanded` already carries the expander's progress, which a failing\n   evaluation keeps.\"\n  [state expanded]\n  ;; r4 F4: the latest known state of this evaluation, so recovery\n  ;; consults it — not only the pre-evaluator `expanded` — when a\n  ;; resumed query/link (or any later step) throws after the\n  ;; evaluator stage already completed retention.\n  (let [latest (volatile! expanded)]\n    (try\n    (let [gaps-before (ingress-gaps expanded)\n          evaluated (do (vreset! latest (run-evaluator-stage expanded latest))\n                        @latest)\n          vm (:vm evaluated)]\n      (cond\n        (> (ingress-gaps evaluated) gaps-before)\n        [(assoc evaluated :ingress-loss? true)\n         (str \"Error: \" ingress-loss-text)]\n\n        (vm/halted? vm)\n        (finalize-eval state evaluated\n                       (engine/restore-initial-env (:env (:vm expanded)) vm))\n\n        (or (link-waiting? vm) (query/waiting? vm))\n        (let [[state' vm' pending] (drive-links evaluated vm false)\n              _ (vreset! latest state')]\n          (cond\n            (vm/halted? vm')\n            (finalize-eval state\n                           (assoc state' :vm vm')\n                           (tokenize state'\n                                     (engine/restore-initial-env\n                                       (:env (:vm expanded)) vm')))\n\n            (link-waiting? vm')\n            (pending-eval state state' vm' pending)\n\n            :else (throw (wedged-program state))))\n\n        :else (throw (wedged-program state))))\n    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n      ;; a link raise rolls the shell back to the round's base; the\n      ;; identity the interrupted VM had minted rides on it, so nothing\n      ;; is minted twice on the surviving pair.  Retention evidence\n      ;; is read EXCLUSIVELY from @latest (r11) -- the shell-owned\n      ;; accumulator this evaluation's stages merged, the evaluator\n      ;; stage recording what its loaders completed before rethrowing\n      ;; -- and never from the exception payload: no throw a program,\n      ;; its renderer or its result formatting produces can fabricate\n      ;; handles, diagnostics or a Warning\n      (let [d (ex-data error)\n            base (query/discard-answers\n                   (if (or (::link-counter d) (::link-origins d))\n                     (carry-link-identity\n                       (:vm state)\n                       {:id-counter (::link-counter d)\n                        :origins (::link-origins d)})\n                     (:vm state))\n                   (:query-pair expanded))]\n        (consume-failed-round (carry-served\n                                (cond-> (assoc expanded :vm base)\n                                  ;; r3+r4 F4: handles completed\n                                  ;; before the throw ride the recovered\n                                  ;; session: @latest is the latest known\n                                  ;; state of this evaluation, never only\n                                  ;; the pre-evaluator `expanded`\n                                  (seq (:call-provenance-handles @latest))\n                                  (update :call-provenance-handles\n                                          merge\n                                          (:call-provenance-handles @latest))\n                                  ;; r8 F1: failures the stages recorded\n                                  ;; before the throw ride recovery the\n                                  ;; same way, so the diagnostic -- and\n                                  ;; its round Warning -- survives exactly\n                                  ;; once\n                                  (seq (:call-provenance-failures @latest))\n                                  (assoc :call-provenance-failures\n                                         (:call-provenance-failures @latest))\n                                  (seq (:call-provenance-round-failures\n                                        @latest))\n                                  (assoc :call-provenance-round-failures\n                                         (:call-provenance-round-failures\n                                           @latest)))\n                                d)\n                              error))))))\n\n\n(defn- eval-program\n  \"Evaluate one frontend program — the map AST the compilers emit or a\n   datom-literal program — through the §10.1 composition.  The encoder\n   projects it to an input batch of canonical rows with its harvest and\n   declaration rows; the shell appends that batch to `program-in`, drives\n   the expander, drains its summary, and drives the code and AST indexers and then\n   the evaluator only when a program was forwarded.  An expansion failure is reported as data: its\n   batch is consumed, the store keeps its previous macros, and the next\n   input evaluates normally.  An encoding failure throws before anything\n   is appended.\n\n   The observers recover across a gap on their own, but the shell reads the\n   gap counts around the round: an increase on any medium means one or more\n   batches were never run, so resuming as though execution were complete\n   would report a result built on programs the VM never saw.  The loss is\n   reported and the shell refuses further evaluation until `(reset)`.\n\n   A completed program's lexical environment does not outlive it: the VM's\n   environment is restored to the one the round began with, as `vm/eval`\n   does.  A round that throws is consumed by `consume-failed-round`.\"\n  [state program]\n  (if (:ingress-loss? state)\n    [state (str \"Error: \" ingress-loss-text)]\n    (let [state' (update (inject-last-value state) :round inc)\n          tables-before (call-site-tables state')\n          batch (encoder/program-batch program)\n          append (stream/append! (:program-stream state') batch)]\n      (if-not (= :dao.stream/ok (:dao.stream/outcome append))\n        [state (str \"Error: program batch not ingested: \"\n                    (name (:dao.stream/outcome append)))]\n        (let [expanded (try\n                         (run-expander-stage state')\n                         (catch #?(:cljd Object\n                                   :clj Exception\n                                   :cljs js/Error) error\n                           {:failed (consume-failed-round state error)}))]\n          (if-let [failed (:failed expanded)]\n            failed\n            (let [[expanded {:keys [errors forwarded]}] expanded\n                  indexed (if (pos? forwarded)\n                            ;; commit evidence is captured BEFORE the\n                            ;; index stage runs: the published programs\n                            ;; and indexer as they stood, so the recorder\n                            ;; pairs only what this round commits\n                            (let [evidence\n                                  {:programs-before\n                                   (indexed-program-roots (:indexer expanded))\n                                   :indexer-before (:indexer expanded)}]\n                              (-> expanded\n                                  run-index-stage\n                                  run-ast-index-stage\n                                  (assoc :call-site-commit-evidence evidence)\n                                  ;; cc3 r2 item 4: this round's\n                                  ;; provenance claims — the roots the\n                                  ;; expander newly retained under\n                                  ;; exactly one admission — ride the\n                                  ;; state into the evaluator stage,\n                                  ;; whose loader wrapper retains each\n                                  ;; claimed packet's provenance\n                                  (assoc :call-site-round-claims\n                                         (let [new-entries\n                                               (into {}\n                                                     (remove\n                                                       (fn [[k _]]\n                                                         (contains?\n                                                           (or tables-before {})\n                                                           k)))\n                                                     (or (call-site-tables\n                                                           expanded)\n                                                         {}))\n                                               by-root\n                                               (group-by (fn [[k _]]\n                                                           (second k))\n                                                         new-entries)]\n                                           (into {}\n                                                 (keep (fn [[root entries]]\n                                                         (when (= 1 (count entries))\n                                                           [root (first (ffirst entries))])))\n                                                 by-root)))\n                                  ((fn [s]\n                                     (record-call-site-admissions\n                                       tables-before s)))))\n                            expanded)]\n              (with-index-notice\n                (cond\n                  (> (ingress-gaps indexed) (ingress-gaps state'))\n                  [(assoc indexed :ingress-loss? true)\n                   (str \"Error: \" ingress-loss-text)]\n\n                  (pos? forwarded) (run-evaluation state indexed)\n\n                  :else [(assoc indexed :vm (:vm state))\n                         (format-expansion-errors errors)])\n                (when (pos? forwarded)\n                  [(index/notice (:indexer expanded) (:indexer indexed))\n                   (ast-index/notice (:ast-indexer indexed))])))))))))\n\n\n(defn- installed-text\n  \"The languages and ids `catalog` holds, for a refused selection to name:\n   a name that is neither is a typo, not a missing frontend.\"\n  [catalog]\n  (let [entries (:yang.frontend/entries catalog)\n        listed (fn [xs] (str/join \" \" (map pr-str (sort (distinct xs)))))]\n    (str \"installed: \"\n         (listed (map (comp :yang.frontend/language :manifest) (vals entries)))\n         \" (ids \" (listed (map first (keys entries))) \")\")))\n\n\n(defn- select-frontend\n  \"Select the frontend `lang` names in `catalog`: a qualified id selects\n   by id (ambiguous when several revisions are installed), `[id revision]`\n   pins one revision; anything else is refused — the selector is the\n   frontend id, never a language keyword.\"\n  [catalog lang]\n  (cond\n    (vector? lang) (frontend/select catalog\n                                    {:yang.frontend/id (first lang),\n                                     :yang.frontend/revision (second lang)})\n    (qualified-keyword? lang) (frontend/select catalog\n                                               {:yang.frontend/id lang})\n    :else (frontend/refused :yang.frontend/unknown {:id lang})))\n\n\n(defn- selected-primitives\n  \"The `:primitives` the binding selected by `lang` registers, else {}.\n   A language's primitives belong to its binding; the primitives of\n","exit_code":1,"status":"failed"}}
