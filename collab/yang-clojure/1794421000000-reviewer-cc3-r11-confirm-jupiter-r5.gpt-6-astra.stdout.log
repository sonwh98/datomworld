g \"stack side-table gains :call diagnostics, old shapes intact\"\n+      (is (some (fn [[_ info]] (= :call (:kind info))) (:side-table stack)))\n+      (is (every? (fn [[_ info]] (contains? #{:closure :var :call} (:kind info)))\n+                  (:side-table stack))))\n+    (testing \"a provenance row naming a non-call pc refuses\"\n+      (let [non-call (first (keep-indexed (fn [pc t] (when (not= :call (first t)) pc)) v))]\n+        (is (= :call-provenance\n+               (try (derive/register-image\n+                      v {:segment-address :seg/register\n+                         :call-provenance [[non-call src root []]]})\n+                    nil\n+                    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n+                      (:rule (ex-data e))))))))))\ndiff --git a/test/yin/vm/semantic/linearize_test.cljc b/test/yin/vm/semantic/linearize_test.cljc\nindex 858bb380..96fbd29e 100644\n--- a/test/yin/vm/semantic/linearize_test.cljc\n+++ b/test/yin/vm/semantic/linearize_test.cljc\n@@ -1,4 +1,5 @@\n (ns yin.vm.semantic.linearize-test\n   (:require [clojure.test :refer [deftest is testing]]\n+            [dao.jing :as jing]\n             [yin.vm :as vm]\n             [yin.vm.parity-test :as parity]\n@@ -393,2 +394,77 @@\n                             [[-20 :yin/root true 0 :db/add]\n                              [-20 :yin/type :no/such 0 :db/add]])))))\n+\n+\n+(deftest call-provenance-resolves-per-occurrence-origins\n+  ;; cc3 item 1: a tree whose applications carry DIFFERENT validated\n+  ;; origins (one admitted, one expansion-generated) resolves each call\n+  ;; instruction to its own [origin root path]; an occurrence with no\n+  ;; validated row yields no entry; Rule R lowers to :define and yields\n+  ;; no fictitious call event; the vector/address never move.\n+  (let [src [:source :medium :batch 0]\n+        exp [:expansion (jing/segment-key [:cc3-test-record 1])]\n+        ast (app (v 'f) (app (v 'g) (v 'x)) (def! 'k (lit 1)))\n+      