eplay-artifacts annotated?)\n        built (now)\n        store (mem/create-content-mem)\n        entries\n        (mapv\n          (fn [{:keys [tree rows] :as artifact}]\n            (let [occ (vec (vm/occurrences tree))\n                  apps (filterv (fn [[_ _ id]]\n                                  (= :application (nth (get (:rows tree) id) 1)))\n                                occ)\n                  paths (mapv second apps)\n                  counts (Qcounts {:rows (count (Qrows (:rows tree)))\n                                   :occurrences (count occ)\n                                   :applications (count apps)\n                                   :depth (apply max 0 (map count paths))\n                                   :path-bytes (bytes/length\n                                                 (jing/canonical-bytes paths))})\n                  _ (doseq [k (keys counts)]\n                      (when (> (get counts k) (get ceilings k))\n                        (throw (ex-info \"cc4 input bound exceeded before lowering\"\n                                        counts))))\n                  sem (linearize/project-rows tree nil (if annotated? rows []))\n                  stack (derive/stack-image (:vector sem)\n                                            (Qsegment-address :cc4/stack\n                                                             :call-provenance (:call-provenance sem)))\n                  reg (derive/register-image (:vector sem)\n                                             (Qsegment-address :cc4/register\n                                                              :call-provenance (:call-provenance sem)))\n                  relation [(:call-provenance sem) (:call-provenance stack)\n                            (:call-provenance reg)]\n                  record (when annotated?\n                           (Qcc4/schema 1 :root (:root tree)\n                                        :rows (jing/materialize! store rows)\n                                        :relation (jing/materialize! store relation)))\n                  address (when record (jing/materialize! store record))\n                  payloads (if annotated?\n                             (into [rows relation record] (:published-payloads artifact))\n                             [])\n                  sizes (if annotated?\n                          (mapv #(bytes/length (jing/canonical-bytes %)) payloads)\n                          [0])\n                  loaded (when address (jing/get store address nil))\n                  loaded-rows (if loaded (jing/get store (:rows loaded) nil) [])\n                  query (into #{} (map #(vec (take 3 %))) loaded-rows)]\n              (when (and annotated?\n                         (not= (set (map #(vec (take 3 %)) rows)) query))\n                (throw (ex-info \"cc4 persisted query mismatch\"\n                                (Qid (:id artifact)))))\n              (Qinput artifact :images [(:vector sem) (:image stack) (:image reg)]\n                      :relation (when annotated? relation) :record loaded\n                      :counts counts :sizes sizes :side-payloads payloads\n                      :stage-heap (heap))))\n          artifacts)\n        done (now)\n        totals (reduce (fn [a e] (merge-with + a (dissoc (Qcounts e) :depth)))\n                       {} entries)\n        totals (assoc totals :depth (apply max (map #(get-in % [Qcounts :depth])\n                                                    entries)))\n        _ (doseq [k (keys totals)]\n            (when (> (get totals k) (get ceilings k))\n              (throw (ex-info \"cc4 aggregate input bound exceeded\" totals))))]\n    (Qholder [artifacts entries store]\n             :roots (mapv #(get-in % [Qinput :tree :root]) entries)\n             :image-digest (jing/content-hash (mapv :images entries))\n             :counts totals\n             :per-member (mapv #(select-keys % [Qcounts :sizes]) entries)\n             :storage (reduce +\n                             (map #(bytes/length (jing/canonical-bytes %))\n                                  (vals (into {}\n                                              (map (juxt jing/segment-key identity))\n                                              (mapcat :side-payloads entries)))))\n             :largest-artifact (apply max (mapcat :sizes entries))\n             :stage-heap-max (apply max (heap) (keep :stage-heap entries))\n             :stages-ms (Qcompile-expand-publish (- built start)\n                         :lower-persist-load-query (- done built))\n             :elapsed-ms (- done start))))\n\n(defn sample\n  [annotated?]\n  (let [stop (atom false)\n        peak (atom (heap))\n        sampler (Thread. (fn []\n                           (while (not @stop)\n                             (swap! peak max (heap))\n                             (Thread/sleep 2))))]\n    (.start sampler)\n    (try\n      (let [result (pipeline annotated?)]\n        (assoc (dissoc result :holder) :peak-used-heap @peak))\n      (finally\n        (reset! stop true)\n        (.join sampler)))))\n\n(defn retained\n  [annotated?]\n  (let [before (gc-heap)\n        result (pipeline annotated?)\n        ;; pin the holder in a volatile and read it AFTER the after-sample\n        ;; so it is provably reachable while the after-GC heap is measured\n        pin (volatile! (:holder result))\n        after (gc-heap)\n        alive (count (first @pin))]\n    {:before before :after after :delta (- after before)\n     :retained-members alive}))\n\n(defn measure\n  [annotated?]\n  (let [cold (sample annotated?)\n        _ (sample annotated?)\n        pipes (mapv (fn [_] (sample annotated?)) (range 3))\n        holds (vec (map (fn [_] (retained annotated?)) (range 5)))\n        max-of (fn [k] (apply max (map k pipes)))\n        peak (max-of :peak-used-heap)\n        retained-max (apply max (map :delta holds))]\n    {:configuration (if annotated? :S :B)\n     :memory-method :jvm-gc-used-heap-2ms-sampled-peak\n     :cold cold :pipeline-samples pipes :retained-samples holds\n     :maxima (Qtime (max-of :elapsed-ms)\n              :storage (max-of :storage)\n              :per-artifact (max-of :largest-artifact)\n              :heap peak :retained retained-max)\n     :verdicts (Qcold (<= (:elapsed-ms cold) (:cold ceilings))\n                :pipeline (<= (max-of :elapsed-ms) (:pipeline ceilings))\n                :storage (<= (max-of :storage) (:storage ceilings))\n                :per-artifact (<= (max-of :largest-artifact)\n                                  (:per-artifact ceilings))\n                :heap (<= peak (:heap ceilings))\n                :retained (<= retained-max (:retained ceilings))\n                :stage-buckets (<= (apply max (mapcat (vals (:stages-ms cold))))\n                                   (:pipeline ceilings)))}))\n\n(defn -main\n  [& args]\n  (let [cfg (case (first args)\n              \"B\" :B \"S\" :S\n              (throw (ex-info \"usage: -m yang.cc4-budget-runner <B|S>\"\n                              (Qgot args))))\n        result (measure (= cfg :S))]\n    (prn (assoc result :cc4/budget 2 :ceilings ceilings))\n    (flush)))\n'''\nsrc = src.replace(\"Qcounts\", Q + \"counts\").replace(\"Qrows\", Q + \"rows\")\nsrc = src.replace(\"Qsegment-address\", Q + \"segment-address\").replace(\"Qcc4/schema\", Q + \"cc4/schema\")\nsrc = src.replace(\"Qid\", Q + \"id\").replace(\"Qinput\", Q + \"input\")\nsrc = src.replace(\"Qholder\", Q + \"holder\").replace(\"Qcompile-expand-publish\", Q + \"compile-expand-publish\")\nsrc = src.replace(\"Qtime\", Q + \"time\").replace(\"Qcold\", Q + \"cold\")\nsrc = src.replace(\"Qgot\", Q + \"got\")\nPath(\"test/yang/cc4_budget_runner.clj\").write_text(src)\nprint(\"runner written\")\nPYEOF\nclojure -M:test -m yang.cc4-budget-runner B 2>&1 | tail -3","description":"Write validated runner, smoke-run B config","timeout":900000}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0