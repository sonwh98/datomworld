{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9a2834a71e71473395bb4aa4","type":"tool_result","content":"1\t;; UNEXECUTED DRAFT: acceptance stopped on reproduced Dart divergence.\n2\t;; Not a measured or validated budget implementation.\n3\t(ns yang.latte-oracle.cc4-budget\n4\t  \"cc4 declaration v1: trace-free B/S pipeline. Raw samples, maximum verdicts.\n5\t   B shares compiler annotation work but strips C1 before downstream stages.\"\n6\t  (:require [yang.clojure-callsite-test :as cohort]\n7\t            [dao.host.bytes :as bytes]\n8\t            [dao.jing :as jing]\n9\t            [dao.jing.mem :as mem]\n10\t            [yin.vm :as vm]\n11\t            [yin.vm.semantic.linearize :as linearize]\n12\t            [yin.vm.semantic.derive :as derive]))\n13\t\n14\t(def ceilings\n15\t  {:per-artifact 2000000 :storage 32000000 :retained 96000000\n16\t   :heap 2147483648 :pipeline 80000 :cold 160000\n17\t   :rows 50000 :occurrences 100000 :applications 10000\n18\t   :depth 256 :path-bytes 8000000})\n19\t\n20\t(defn now [] #?(:cljs (.now js/Date) :default (System/currentTimeMillis)))\n21\t(defn heap [] #?(:jolt nil :cljd nil\n22\t                 :clj (let [r (Runtime/getRuntime)] (- (.totalMemory r) (.freeMemory r)))\n23\t                 :cljs (.-heapUsed (.memoryUsage js/process))))\n24\t(defn gc-heap []\n25\t  #?(:jolt nil :cljd nil\n26\t     :clj (do (System/gc) (Thread/sleep 50) (System/gc) (heap))\n27\t     :cljs (when (fn? (.-gc js/global)) ((.-gc js/global)) (heap))))\n28\t\n29\t(defn pipeline [annotated?]\n30\t  (let [start (now)\n31\t        artifacts (cohort/replay-artifacts annotated?)\n32\t        built (now)\n33\t        store (mem/create-content-mem)\n34\t        entries\n35\t        (mapv\n36\t          (fn [{:keys [tree rows] :as artifact}]\n37\t            (let [occ (vec (vm/occurrences tree))\n38\t                  apps (filterv (fn [[_ _ id]] (= :application (nth (get (:rows tree) id) 1))) occ)\n39\t                  paths (mapv second apps)\n40\t                  counts {:rows (count (:rows tree)) :occurrences (count occ)\n41\t                          :applications (count apps) :depth (apply max 0 (map count paths))\n42\t                          :path-bytes (bytes/length (jing/canonical-bytes paths))}\n43\t                  _ (doseq [k (keys counts)]\n44\t                      (when (> (get counts k) (get ceilings k))\n45\t                        (throw (ex-info \"cc4 input bound exceeded before lowering\" counts))))\n46\t                  sem (linearize/project-rows tree nil (if annotated? rows []))\n47\t                  stack (derive/stack-image (:vector sem)\n48\t                                            {:segment-address :cc4/stack\n49\t                                             :call-provenance (:call-provenance sem)})\n50\t                  reg (derive/register-image (:vector sem)\n51\t                                             {:segment-address :cc4/register\n52\t                                              :call-provenance (:call-provenance sem)})\n53\t                  relation [(:call-provenance sem) (:call-provenance stack) (:call-provenance reg)]\n54\t                  record (when annotated?\n55\t                           {:cc4/schema 1 :root (:root tree)\n56\t                            :rows (jing/materialize! store rows)\n57\t                            :relation (jing/materialize! store relation)})\n58\t                  address (when record (jing/materialize! store record))\n59\t                  payloads (if annotated?\n60\t                             (into [rows relation record] (:published-payloads artifact)) [])\n61\t                  sizes (if annotated?\n62\t                          (mapv #(bytes/length (jing/canonical-bytes %)) payloads) [0])\n63\t                  loaded (when address (jing/get store address nil))\n64\t                  loaded-rows (if loaded (jing/get store (:rows loaded) nil) [])\n65\t                  query (into #{} (map #(vec (take 3 %))) loaded-rows)]\n66\t              (when (and annotated? (not= (set (map #(vec (take 3 %)) rows)) query))\n67\t                (throw (ex-info \"cc4 persisted query mismatch\" {:id (:id artifact)})))\n68\t              {:input artifact :images [(:vector sem) (:image stack) (:image reg)]\n69\t               :relation (when annotated? relation) :record loaded :query query\n70\t               :counts counts :sizes sizes :side-payloads payloads :stage-heap (heap)}))\n71\t          artifacts)\n72\t        done (now)\n73\t        counts (reduce (fn [a e] (merge-with + a (dissoc (:counts e) :depth))) {} entries)\n74\t        counts (assoc counts :depth (apply max (map #(get-in % [:counts :depth]) entries)))\n75\t        _ (doseq [k (keys counts)]\n76\t            (when (> (get counts k) (get ceilings k))\n77\t              (throw (ex-info \"cc4 aggregate input bound exceeded\" counts))))]\n78\t    {:holder [artifacts entries store]\n79\t     :roots (mapv #(get-in % [:input :tree :root]) entries)\n80\t     :image-digest (jing/content-hash (mapv :images entries))\n81\t     :counts counts :per-member (mapv #(select-keys % [:counts :sizes]) entries)\n82\t     :storage (reduce + (map #(bytes/length (jing/canonical-bytes %))\n83\t                            (vals (into {} (map (juxt jing/segment-key identity))\n84\t                                        (mapcat :side-payloads entries)))))\n85\t     :largest-artifact (apply max (mapcat :sizes entries))\n86\t     :stage-heap-max (when (heap) (apply max (heap) (keep :stage-heap entries)))\n87\t     :stages-ms {:compile-expand-publish (- built start)\n88\t                 :lower-persist-load-query (- done built)}\n89\t     :elapsed-ms (- done start)}))\n90\t\n91\t(defn sample [annotated?]\n92\t  #?(:clj\n93\t     (let [stop (atom false) peak (atom (heap))\n94\t           sampler (Thread. (fn [] (while (not @stop)\n95\t                                    (swap! peak max (heap)) (Thread/sleep 2))))]\n96\t       (.start sampler)\n97\t       (try\n98\t         (let [result (pipeline annotated?)]\n99\t           (assoc (dissoc result :holder) :peak-used-heap @peak))\n100\t         (finally (reset! stop true) (.join sampler))))\n101\t     :default (dissoc (pipeline annotated?) :holder)))\n102\t\n103\t(defn retained [annotated?]\n104\t  (when-let [before (gc-heap)]\n105\t    (let [result (pipeline annotated?)\n106\t          after (gc-heap)\n107\t          ;; Refer to the holder after GC sampling so it remains live.\n108\t          alive (count (first (:holder result)))]\n109\t      {:before before :after after :delta (- after before) :retained-members alive})))\n110\t\n111\t(defn measure [annotated?]\n112\t  (let [cold (sample annotated?)\n113\t        _ (sample annotated?)\n114\t        pipes (mapv (fn [_] (sample annotated?)) (range 3))\n115\t        holds (vec (keep identity (map (fn [_] (retained annotated?)) (range 5))))\n116\t        max-of (fn [k] (apply max (map k pipes)))\n117\t        peak (cond (:peak-used-heap (first pipes)) (max-of :peak-used-heap)\n118\t                   (:stage-heap-max (first pipes)) (max-of :stage-heap-max))]\n119\t    {:configuration (if annotated? :S :B) :cold cold :pipeline-samples pipes\n120\t     :retained-samples holds\n121\t     :memory-method #?(:clj :jvm-gc-used-heap-2ms-peak\n122\t                        :cljs :node-exposed-gc-stage-peak-lower-bound\n123\t                        :default :heap-unavailable)\n124\t     :maxima {:time (max-of :elapsed-ms) :storage (max-of :storage)\n125\t              :per-artifact (max-of :largest-artifact) :heap peak\n126\t              :retained (when (seq holds) (apply max (map :delta holds)))}\n127\t     :verdicts {:cold (<= (:elapsed-ms cold) (:cold ceilings))\n128\t                :pipeline (<= (max-of :elapsed-ms) (:pipeline ceilings))\n129\t                :storage (<= (max-of :storage) (:storage ceilings))\n130\t                :per-artifact (<= (max-of :largest-artifact) (:per-artifact ceilings))\n131\