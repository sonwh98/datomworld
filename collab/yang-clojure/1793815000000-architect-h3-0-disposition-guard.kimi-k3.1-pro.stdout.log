the admitted §8.10\n34\t-descriptor; forged shapes refuse. The corrected counts and remaining arities\n35\t+descriptor; structurally invalid descriptors and any payload, message, script\n36\t+or call mismatch refuse (descriptor authenticity itself is the compiler's\n37\t+admission witness upstream of the outcome). The corrected counts and remaining arities\n38\t are recorded in [`slice9_evidence.edn`](slice9_evidence.edn) and\n39\t [`slice9_unexercised.edn`](slice9_unexercised.edn). The residual consumers in\n40\t [`fixture_closure.edn`](fixture_closure.edn) retain their concrete expected\n41\t@@ -140,16 +142,14 @@ accepted-negative claim, or equality projection is introduced for these rows.\n42\t \n43\t ## Verification\n44\t \n45\t-The accounting tests pass 2 tests and 22 assertions. An independent audit\n46\t-re-derives all 145 retained arities and all 360 credited fixture paths from\n47\t-the two raw C traces. The four regression suites pass 122 tests and 1,338\n48\t-assertions. Kondo reports zero errors and warnings; cljstyle and\n49\t-`git diff --check` pass. The full oracle runs 26 tests and 1,879 assertions\n50\t-with exactly one failure and no errors: its retained\n51\t-`(= :pass (:gate-status evidence))` closure assertion. The missing 20 arities\n52\t-therefore continue to block acceptance. Verification results are recorded in\n53\t-[`slice9_verification.edn`](slice9_verification.edn), with command outputs\n54\t-beside it.\n55\t+An independent audit re-derives the credited arities and fixture paths from\n56\t+the two raw C traces. Kondo reports zero errors and warnings. The full oracle\n57\t+runs 26 tests and 1,697 assertions with exactly one failure and no errors:\n58\t+its retained `(= :pass (:gate-status evidence))` closure assertion. The\n59\t+unexercised arities — **58** under the current accounting, including\n60\t+`parse/1` — therefore continue to block acceptance. Verification results are\n61\t+recorded in [`slice9_verification.edn`](slice9_verification.edn), with command\n62\t+outputs beside it.\n63\t `yang.latte-oracle-test/write-kernel-gate-evidence!` explicitly regenerates\n64\t both execution evidence and the remaining-arity inventory; normal tests do\n65\t not write them. Evidence retains the pinned upstream revision, compiler\n66\tdiff --git a/test/yang/latte_oracle_test.clj b/test/yang/latte_oracle_test.clj\n67\tindex 45367c76..80d2c382 100644\n68\t--- a/test/yang/latte_oracle_test.clj\n69\t+++ b/test/yang/latte_oracle_test.clj\n70\t@@ -1930,37 +1930,65 @@\n71\t (def ^:private kernel-declarations\n72\t   \"The declared dispositions: explicit, versioned input to classification.\n73\t    Generated evidence is never their source of truth; provenance is in-file.\n74\t-   A declaration whose revalidation guards fail leaves its row a blocker,\n75\t+   The file's contract is validated at load: version and provenance are\n76\t+   fixed, and every historical disposition must retain its exact boundary\n77\t+   and a complete record - the file is authoritative for this metadata, and\n78\t+   a load-time failure means the file was edited beyond its contract. A\n79\t+   declaration whose revalidation guards fail leaves its row a blocker,\n80\t    not a deviation.\"\n81\t-  (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_declarations.edn\"))))\n82\t+  (let [parsed (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_declarations.edn\")))\n83\t+        complete? (fn [d required] (every? d required))\n84\t+        portability-required [:call :script :message :boundary :upstream-value :reason]\n85\t+        upstream-required [:call :boundary :reason :upstream-revision]]\n86\t+    (assert (and (= 1 (:version parsed)) (= \"ea18c8e4^\" (:provenance parsed)))\n87\t+            \"the declarations file's version/provenance are part of its contract\")\n88\t+    (doseq [[id d] (:portability parsed)]\n89\t+      (assert (and (complete? d portability-required)\n90\t+                   (= :nonportable-host-value (:boundary d))\n91\t+                   (= 'clojure.core/meta (:upstream-value d)))\n92\t+              (str \"incomplete or out-of-scope portability declaration: \" id)))\n93\t+    (doseq [[id d] (:upstream-failures parsed)]\n94\t+      (assert (and (complete? d upstream-required)\n95\t+                   (= (:boundary d) ({:typing-ascription :upstream-unbound-definition\n96\t+                                      :compile-malformed :upstream-malformed-proof-sequence} id))\n97\t+                   (= \"86fca0d1d054af005cb37395eae04500d45e6279\" (:upstream-revision d)))\n98\t+              (str \"incomplete or out-of-scope upstream-failure declaration: \" id)))\n99\t+    parsed))\n100\t \n101\t (defn- kernel-callable-descriptor?\n102\t-  \"True when `value` is the admitted common-call descriptor the reconciled\n103\t-   compiler publishes for a guest closure: a function-type marker, an entry\n104\t-   that is itself a minted closure, and an admission witness. Forged shapes -\n105\t-   a bare `{:type :closure}` map, a scalar or missing entry, a missing\n106\t-   witness - fail.\"\n107\t+  \"True when `value` is the shape of the admitted common-call descriptor the\n108\t+   reconciled compiler publishes for a guest closure: a true function-type\n109\t+   marker, an entry that is a minted closure, and an admission witness.\n110\t+   Structurally invalid shapes - a bare `{:type :closure}` map, a scalar or\n111\t+   missing entry, a missing or non-closure witness, an outcomes marker that\n112\t+   is missing or false - fail. Descriptor AUTHENTICITY (that the witness is\n113\t+   this compiler's own mint, not a copy) is the compiler's admission check\n114\t+   upstream of the outcome; this predicate is the test-side structural\n115\t+   half, and the payload/message/call guards around it carry revalidation.\"\n116\t   [value]\n117\t   (and (map? value)\n118\t        (= :function (:clj/type value))\n119\t+       (true? (:clj/outcomes? value))\n120\t        (values/closure? (get value :yang.call/entry))\n121\t        (values/closure? (get value :clj/admission))))\n122\t \n123\t (defn- kernel-host-value-deviation\n124\t-  [id a b walker semantic]\n125\t+  [fixture a b walker semantic]\n126\t   ;; Disposition only: keep every original comparison and all four outcomes.\n127\t   ;; A new failure outside this exact host-value boundary remains a mismatch.\n128\t-  ;; The declared boundary, upstream value and reason come from the versioned\n129\t-  ;; declarations file; the guards revalidate the live execution against it.\n130\t-  (let [declared (get-in kernel-declarations [:portability id])]\n131\t+  ;; The declared call, boundary, upstream value and reason come from the\n132\t+  ;; versioned declarations file; the guards revalidate the live execution\n133\t+  ;; against the declaration - the pinned call, the declared message and\n134\t+  ;; script - so a changed execution cannot ride a copied declaration.\n135\t+  (let [id (:id fixture)\n136\t+        declared (get-in kernel-declarations [:portability id])]\n137\t     (when (and declared\n138\t                (contains? #{:elab-after-qed :check-after-qed} id)\n139\t+               (= (:call fixture) (:call declared))\n140\t                (= :completed (:status a) (:status b) (:status walker) (:status semantic))"}
{"role":"tool","tool_call_id":"tool_xWJITnFZRTAZnnW4tgPbKq1y","content":"1928\t\n1929\t\n1930\t(def ^:private kernel-declarations\n1931\t  \"The declared dispositions: explicit, versioned input to classification.\n1932\t   Generated evidence is never their source of truth; provenance is in-file.\n1933\t   The file's contract is validated at load: version and provenance are\n1934\t   fixed, and every historical disposition must retain its exact boundary\n1935\t   and a complete record - the file is authoritative for this metadata, and\n1936\t   a load-time failure means the file was edited beyond its contract. A\n1937\t   declaration whose revalidation guards fail leaves its row a blocker,\n1938\t   not a deviation.\"\n1939\t  (let [parsed (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_declarations.edn\")))\n1940\t        complete? (fn [d required] (every? d required))\n1941\t        portability-required [:call :script :message :boundary :upstream-value :reason]\n1942\t        upstream-required [:call :boundary :reason :upstream-revision]]\n1943\t    (assert (and (= 1 (:version parsed)) (= \"ea18c8e4^\" (:provenance parsed)))\n1944\t            \"the declarations file's version/provenance are part of its contract\")\n1945\t    (doseq [[id d] (:portability parsed)]\n1946\t      (assert (and (complete? d portability-required)\n1947\t                   (= :nonportable-host-value (:boundary d))\n1948\t                   (= 'clojure.core/meta (:upstream-value d)))\n1949\t              (str \"incomplete or out-of-scope portability declaration: \" id)))\n1950\t    (doseq [[id d] (:upstream-failures parsed)]\n1951\t      (assert (and (complete? d upstream-required)\n1952\t                   (= (:boundary d) ({:typing-ascription :upstream-unbound-definition\n1953\t                                      :compile-malformed :upstream-malformed-proof-sequence} id))\n1954\t                   (= \"86fca0d1d054af005cb37395eae04500d45e6279\" (:upstream-revision d)))\n1955\t              (str \"incomplete or out-of-scope upstream-failure declaration: \" id)))\n1956\t    parsed))\n1957\t\n1958\t(defn- kernel-callable-descriptor?\n1959\t  \"True when `value` is the shape of the admitted common-call descriptor the\n1960\t   reconciled compiler publishes for a guest closure: a true function-type\n1961\t   marker, an entry that is a minted closure, and an admission witness.\n1962\t   Structurally invalid shapes - a bare `{:type :closure}` map, a scalar or\n1963\t   missing entry, a missing or non-closure witness, an outcomes marker that\n1964\t   is missing or false - fail. Descriptor AUTHENTICITY (that the witness is\n1965\t   this compiler's own mint, not a copy) is the compiler's admission check\n1966\t   upstream of the outcome; this predicate is the test-side structural\n1967\t   half, and the payload/message/call guards around it carry revalidation.\"\n1968\t  [value]\n1969\t  (and (map? value)\n1970\t       (= :function (:clj/type value))\n1971\t       (true? (:clj/outcomes? value))\n1972\t       (values/closure? (get value :yang.call/entry))\n1973\t       (values/closure? (get value :clj/admission))))\n1974\t\n1975\t(defn- kernel-host-value-deviation\n1976\t  [fixture a b walker semantic]\n1977\t  ;; Disposition only: keep every original comparison and all four outcomes.\n1978\t  ;; A new failure outside this exact host-value boundary remains a mismatch.\n1979\t  ;; The declared call, boundary, upstream value and reason come from the\n1980\t  ;; versioned declarations file; the guards revalidate the live execution\n1981\t  ;; against the declaration - the pinned call, the declared message and\n1982\t  ;; script - so a changed execution cannot ride a copied declaration.\n1983\t  (let [id (:id fixture)\n1984\t        declared (get-in kernel-declarations [:portability id])]\n1985\t    (when (and declared\n1986\t               (contains? #{:elab-after-qed :check-after-qed} id)\n1987\t               (= (:call fixture) (:call declared))\n1988\t               (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n1989\t               (= (:outcome a) (:outcome b))\n1990\t               (= (get-in a [:outcome :thrown :data :meta])\n1991\t                  {:nonportable-host-value (str (class clojure.core/meta))})\n1992\t               ;; The declaration must describe THIS failure: same message and\n1993\t               ;; same script (top-level sequential shape normalized), or the\n1994\t               ;; guard fails and the row stays a blocker.\n1995\t               (= (:message declared) (get-in a [:outcome :thrown :message]))\n1996\t               (= (vec (:script declared))\n1997\t                  (vec (get-in a [:outcome :thrown :data :script])))\n1998\t               (every? (fn [c]\n1999\t                         (and (= :yin.k/error (first (:outcome c)))\n2000\t                              (= (get-in a [:outcome :thrown :message])\n2001\t                                 (get-in c [:outcome 1 :yin.k/message]))\n2002\t                              (= (dissoc (get-in a [:outcome :thrown :data]) :meta)"}
{"role":"tool","tool_call_id":"tool_5GPQao5SSaYEgxVfBRwMmFjN","content":"1210\t              run [walker-run semantic-run]]\n1211\t        (let [ast (walk/postwalk\n1212\t                    (fn [node]\n1213\t                      (if (= node (u/v 'profile-function)) descriptor node))\n1214\t                    (outcome-ast [form]))]\n1215\t          (is (= expected (first (run ast)))))))))\n1216\t\n1217\t\n1218\t(deftest test-common-call-profile-eligibility\n1219\t  (doseq [eligible? [true false]\n1220\t          run [walker-run semantic-run]]\n1221\t    (let [descriptor (#'yang/admit-call-descriptor\n1222\t                      (u/app (u/v 'assoc) (u/lit {})\n1223\t                             (u/lit :yang.call/entry) (u/lam ['record] (u/lit :called))\n1224\t                             (u/lit :yang.call/eligible?) (u/lam ['callee] (u/lit eligible?)))\n1225\t                      false)\n1226\t          profile-ast (fn [form]\n1227\t                        (walk/postwalk\n1228\t                          (fn [node]\n1229\t                            (cond (= node (u/v 'profile-function)) descriptor\n1230\t                                  (= node (u/v 'profile-raise)) (u/lam ['condition]\n1231\t                                                                       (u/v 'condition))\n1232\t                                  :else node))\n1233\t                          (outcome-ast [form])))]\n1234\t      (is (= [:yin.k/ok eligible?]\n1235\t             (first (run (profile-ast '(yang.call/eligible? profile-function))))))\n1236\t      (doseq [form '[(profile-function)\n1237\t                     (yang.call/invoke profile-function [] [] profile-raise)\n1238\t                     (yang.call/invoke-with profile-function [] [] profile-raise {})]]\n1239\t        (let [result (first (run (profile-ast form)))]\n1240\t          (if eligible?\n1241\t            (is (= [:yin.k/ok :called] result))\n1242\t            (is (= :yang.call/not-callable (:yang.call/reason (second res