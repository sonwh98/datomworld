{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat > src/cljc/yang/correspondence_dependency.clj <<'EOF'\n(ns yang.correspondence-dependency\n  \\\"Byte-preserving dependency bundle storage. A bundle does not assert that\n   its contents are a complete or executable reconstruction closure.\\\"\n  (:require [clojure.string :as string]\n            [dao.jing :as jing])\n  (:import [java.util Base64]))\n\n(defn- path? [p]\n  (and (string? p) (not (string/blank? p))\n       (not (string/starts-with? p \\\"/\\\"))\n       (not (string/includes? p \\\"\\\\\\\\\\\"))\n       (every? #(and (not (string/blank? %)) (not (#{\\\".\\\" \\\"..\\\"} %)))\n               (string/split p #\\\"/\\\" -1))))\n\n(defn- fail\"'! [reason]\n  (throw (ex-info \"Invalid correspondence dependency bundle\" {:reason reason})))\n\n(defn store-bundle!\n  \"Store explicit [relative-path byte-array] entries and an addressed index.\n   The caller is responsible for identifying the complete dependency set.\"\n  [handle entries]\n  (when-not (and (vector? entries) (seq entries)\n                 (every? #(and (vector? %) (= 2 (count %))\n                               (path? (first %)) (bytes? (second %))) entries)\n                 (= (count entries) (count (set (map first entries)))))\n    (fail! :entries))\n  (let [encoder (Base64/getEncoder)\n        index (mapv (fn [[path data]]\n                      [path (jing/materialize! handle\n                                              {:schema 1 :base64 (.encodeToString encoder data)})])\n                    entries)]\n    (jing/materialize! handle {:schema 1 :entries index})))\n\n(defn fetch-bundle!\n  \"Fetch and validate the index and every byte object, returning path/bytes.\n   dao.jing verifies each address. No files are written or executed.\"\n  [handle address]\n  (let [missing (Object.)\n        index (jing/get handle address missing)\n        entries (:entries index)]\n    (when-not (and (map? index) (= #{:schema :entries} (set (keys index)))\n                   (= 1 (:schema index)) (vector? entries) (seq entries)\n                   (every? #(and (vector? %) (= 2 (count %))\n                                 (path? (first %)) (jing/segment-address? (second %))) entries)\n                   (= (count entries) (count (set (map first entries)))))\n      (fail! :index))\n    (mapv (fn [[path ref]]\n            (let [blob (jing/get handle ref missing)]\n              (when-not (and (map? blob) (= #{:schema :base64} (set (keys blob)))\n                             (= 1 (:schema blob)) (string? (:base64 blob)))\n                (fail! :blob))\n              (let [data (try (.decode (Base64/getDecoder) ''^String (:base64 blob))\n                              (catch IllegalArgumentException _ (fail! :base64)))]\n                (when-not (= (:base64 blob) (.encodeToString (Base64/getEncoder) data))\n                  (fail! :base64))\n                [path data])))\n          entries)))\nEOF\nclojure -M:test -n yang.correspondence-dependency-test'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
