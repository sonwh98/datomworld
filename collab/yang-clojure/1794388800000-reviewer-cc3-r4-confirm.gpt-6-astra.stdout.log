900\t        semantic (kernel-c compiled :semantic)\n  2901\t        match? (and (= :completed (:status a) (:status b) (:status walker) (:status semantic))\n  2902\t                    (= (:outcome a) (:outcome b))\n  2903\t                    (agrees? (get a :outcome) (get walker :outcome))\n  2904\t                    (= (:outcome walker) (:outcome semantic))\n  2905\t                    (= (result-shape (:outcome a)) (result-shape (:outcome b)))\n2949:              (kernel-row fixture))\n3004:          f3 (kernel-row (by-id :h3-2-elab-discharge-states))\n3005:          f2 (kernel-row (by-id :h3-2-elab-inferred-anonymous))]\n3059:              :let [row (kernel-row (by-id id))]]\n3064:          f2 (kernel-row (by-id :h3-3-registered-definition-ambient))\n3065:          r2 (kernel-row (by-id :h3-3-registered-definition-nonsymbol))\n3066:          r10 (kernel-row (by-id :h3-3-unregister-unparser-absent))\n3099:        f2 (kernel-row (by-id :h3-3-registered-definition-ambient))\n3100:        explicit-2 (kernel-row {:id :battery-explicit-2\n3103:        unexecuted-1 (kernel-row {:id :battery-unexecuted-ambient\n3124:      (let [r2 (kernel-row (by-id :h3-3-registered-definition-nonsymbol))\n3155:      (let [indirect (kernel-row (by-id :nbe-beta))\n3202:(defn kernel-gate-evidence\n3208:                        (let [row (kernel-row fixture)]\n3211:        inventory (mapv #(select-keys % [:symbol :kind :arities :disposition :admission-reason]) kernel-entries)\n3300:(defn write-kernel-gate-evidence!\n3304:  ([] (write-kernel-gate-evidence! \"test/yang/latte_oracle\"))\n3306:   (let [evidence (kernel-gate-evidence)]\n3339:  (let [evidence (kernel-gate-evidence)]\n3420:(deftest test-kernel-gate-evidence-writer-round-trip\n3429:      (with-redefs [kernel-gate-evidence (constantly committed)]\n3430:        (write-kernel-gate-evidence! dir))\n  2359\t(defn- recheck-pending*\n  2360\t  \"One bounded re-check of the shell's `:pending-run`: serve the\n  2361\t   interpreter, run the parked VM, and either answer its value -- the\n  2362\t   round the require began in finally completes, and the lines retained\n  2363\t   while it was pending, then `input`, evaluate against it -- consult\n  2364\t   the link policy when the re-check leaves the run pending, `:checks`\n  2365\t   counting this pending run's re-checks that made no progress and\n  2366\t   resetting on one that did, or, when the re-check raised the link's\n  2367\t   refusal, return the shell to the round's base with the error as text\n  2368\t   and evaluate `input` there.  `input` is nil for the host's\n  2369\t   `recheck-pending`, which evaluates no line of its own.\"\n  2370\t  [state input initial-progress]\n  2371\t  (let [parked (:pending-run state)]\n  2372\t    (try\n  2373\t      (let [[state' vm' pending progress?] (drive-links state (:vm parked)\n  2374\t                                                        initial-progress)]\n  2375\t        (if (vm/halted? vm')\n  2376\t          (let [vm'' (engine/restore-initial-env (:env (:base parked)) vm')\n  2377\t                [st text] (finalize-eval state\n  2378\t                                         (cond-> (assoc state' :vm vm'')\n  2379\t                                           (:frontend parked)\n  2380\t                                           (assoc ::frontend\n  2381\t                                                  (:frontend parked)))\n  2382\t                                         (tokenize state' vm''))]\n  2383\t            (fold-queued [(assoc st :vm vm'' :pending-run nil) text]\n  2384\t                         (cond-> (vec (:pending-lines parked))\n  2385\t                           input (conj input))))\n  2386\t          (let [checks (if progress? 0 (inc (or (:checks parked) 0)))\n  2387\t                parked' (cond-> (assoc parked\n  2388\t                                       :vm vm'\n  2389\t                                       :links pending\n  2390\t                                       :checks checks)\n  2391\t                          input (update :pending-lines\n  2392\t                                        (fnil conj []) input))\n  2393\t                [st text] (drain-output (assoc state'\n  2394\t                                               :vm vm'\n  2395\t                                               :pending-run parked'))]\n  2396\t            (consult-link-policy st text (pending-text pending)))))\n  2397\t      (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  2398\t        (let [[st text] (drain-output state)\n  2399\t              d (ex-data error)]\n  2400\t          (fold-queued\n  2401\t            [(carry-served (cond-> (assoc st\n  2402\t                                          :vm (query/discard-answers\n  2403\t                                                (carry-link-identity\n  2404\t                                                  (:base parked)\n  2405\t                                                  {:id-counter (::link-counter d)\n  2406\t                                                   :origins (::link-origins d)})\n  2407\t                                                (:query-pair st))\n  2408\t                                          :pending-run nil)\n  2409\t                             ;; r4 F4: handles a link raise carried\n  2410\t                             ;; out of the resumed run ride recovery\n  2411\t                             (::call-provenance-handles d)\n  2412\t                             (update :call-provenance-handles\n  2413\t                                     merge\n  2414\t                                     (::call-provenance-handles d)))\n  2415\t                           d)\n  2416\t             (str text\n  2417\t                  (format-error error)\n  2418\t                  (dropped-lines-text (count (:pending-lines parked))))]\n  2419\t            (cond-> [] input (conj input))))))))\n  2420\t\n  2421\t\n  2422\t(defn recheck-pending\n  2423\t  \"One re-check of the shell's `:pending-run` without an input line --\n   115\ttext to substitute is exactly the numbers paragraph in this\n   116\tsection. The earlier runs' incomplete-preflight status is preserved\n   117\t(r3 PREFLIGHT BOUNDS text untouched; an r4 correction note was\n   118\tappended to the worktree r3 copy's PREFLIGHT BOUNDS recording these\n   119\tnumbers and noting that a separate 2026-11-11 15:54 edit of that\n   120\tcopy recorded a whole-pipeline holder of ~9.18M B, consistent with\n   121\tthe compiled-inclusive figure below).\n   122\t\n   123\t| Quantity | Measured (r4, 2026-11-11, warm JVM) | Declared ceiling (r2, kept) | Verdict |\n   124\t|---|---|---|---|\n   125\t| Serialized storage: C1 rows (canonical bytes) | 293,924 B | 2,000,000 B per artifact | under |\n   126\t| Serialized storage: provenance relation, 3 lanes (canonical bytes) | 802,260 B | 2,000,000 B per artifact | under |\n   127\t| Retained JVM memory: `{binding, semantic/stack/register images, relation}`, median of 3 deltas (7,960,192 / 7,921,728 / 8,044,024 B) | 7,960,192 B | 8,000,000 B aggregate session closure | under (99.5%) |\n   128\t| Retained JVM memory: same holder plus `compiled`, median of 3 (9,008,912 / 8,939,024 / 8,826,416 B) | 8,939,024 B | 8,000,000 B aggregate session closure | EXCEEDED — measured exceedance recorded, ceiling NOT raised (failure rule) |\n   129\t| Peak used heap, 2 ms sampling, lowering → serialization → durable persistence → tagged execution | 292,720,240 B (gc-pinned baseline 38,967,336 B; over-baseline 253,752,904 B) | 1,073,741,824 B (1 GiB) | under |\n   130\t| Pipeline elapsed (compile → persistence → both tagged lanes) | 1,727 ms | 10,000 ms | under |\n   131\t| Guest instructions / trace records per C lane | restated, NOT raised | 4,000,000 / 1,000,000 (r1) | — |\n   132\t\n   133\tStage-boundary used-heap samples (same peak run, informational;\n   134\tthey fluctuate with GC and are not the ceiling-checked figure):\n   135\tafter-compile 64,133,160 B; after-binding 105,278,120 B;\n   136\tafter-project-rows 57,582,568 B; after-derives 172,925,928 B;\n   137\tafter-serialization 250,007,584 B; after-persistence 89,370,632 B;\n   138\tafter-tagged-execution 217,789,448 B. Heap after releasing the\n   139\tretained holder returned to 38,966,560 B (baseline 38,967,336 B),\n   140\tconfirming the delta tracks the holder's lifetime. Persisted\n   141\taddresses (this run): relation\n   142\t`:segment/blake3-28ea44a8bcf40bd005ba70e1888cf2ed08063cae62ecf27197707b5cf1994930`,\n   143\trecord\n   144\t`:segment/blake3-6a39d41fa2ef2bd252cc1f1055e3223abca4e0c25327439196880ec9c2911840`\n   145\t(store since removed with /tmp).\n   146\t\n   147\tMethod and comparability limits: retained memory and peak are\n   148\tprocess-wide JVM used-heap figures (`Runtime.totalMemory −\n   149\tfreeMemory`) with `System/gc()` pins, warm JVM after a discarded\n   150\twarmup build. `System/gc()` is a hint the JVM honored observably\n   151\there, not a guarantee. The retained delta is an\n   152\torder-of-magnitude retained-size claim comparable only on this\n   153\thost/JVM and only for the named holder scope — never an exact\n   154\tobject-graph census; the two holder scopes above differ by the\n   155\tcompiled program and answer differently against the aggregate\n   156\tceiling, and a re-scoped ceiling for compiled-inclusive holders is\n   157\ta landing decision, not this round's (bounds are never silently\n   158\traised). 2 ms peak sampling can miss sub-2 ms transients.\n   159\t\n   160\t## Red-first evidence\n   161\t\n   162\tTests were written before the fix for each item; observed red in\n   163\tthis session (probe `/tmp/cc3-f4-probe.clj` showed the candidate\n   164\tquery-then-divide line returns `Error: Divide by zero` only after\n   165\tthe query is served and resumed — the divide is on the resume):\n   166\t\n   167\t| Item | Red | Green |\n   168\t|---|---|---|\n   169\t| F2 (oracle) | updated `test-cc3-distinct-admissions-distinct-origins` (token shape + nonzero ordinal through binding) against the old slot-3 origin: 4 failures, 1 error (ordinal-1 binding refused: projected markers end in `0`, searched keys in `1`) | 0 (4 cc3 oracle tests, 69 assertions) |\n   170\t| F4 (durable) | new `repl-packet-provenance-survives-link-resume-failure-test` with both r4 mechanisms disabled (r3 behaviour restored in a scratch toggle): 2 failures (handles 3 before and 3 after the resume-failing round; no retrievable relation) | 0 (7 assertions; fix restored from a byte copy and re-verified in the full battery) |\n   171\t| F6 | n/a — measurement/record fix, no code | measured record above; script in-repo |\n   172\t\n   314\t### 6.3 Bounds published before any tagged run\n   315\t\n   316\tThe implementation preflight record must contain actual finite numbers (no “TBD”, unlimited trace, or post-run adjustment) for:\n   317\t\n   318\t| Bound | Required derivation / failure |\n   319\t|---|---|\n   320\t| Maximum input rows, occurrences, A, D and total path bytes | Derive from the pinned static corpus; reject over-bound traversal before instrumentation. Include generated/bundled prelude expansion, not only source calls. |\n   321\t| Static side bytes and retained memory | Measure S without tracing; declare maximum per artifact/module and aggregate closure. Serialization size may be computed exactly before execution. Stop/revise on exceeding the declared storage/memory bound. |\n   322\t| Maximum records E and trace capacity C | Bound accepted trace writes for the fixture, declare C in records AND bytes including worst allowed site-id/path length, and declare drain behavior. No credit from a truncated/overflowed trace. |\n   323\t| Guest instruction ceiling and added work | Bound trace instructions per event/dispatch under each executed format, plus fixed setup/drain costs. Declare a ceiling for each host/format run before T; report baseline, absolute delta and ratio. |\n   324\t| Compile/expand/publish/verify/load/query time | Declare finite absolute time limits and allowed deltas against B/S in the preflight record. Pilot B/S measurements may set these; a tagged timeout is a failed bounded run. |\n   325\t| Peak process/heap/trace/index/continuation memory | Declare finite ceilings and measurement method; if a host lacks a heap counter, use a named process-memory measure and mark comparability limits. Missing measurement is not zero usage. |\n   326\t\n   327\tFor the oracle specifically, current code uses trace capacity **1,000,000 records**, drains after halt, and allows **4,000,000 guest instructions per C lane** (`latte_oracle_test.clj:1827,1847-1854,2453-2454`). These are the inspected baseline settings, not evidence the tagged run fits. Its own note records 2,024,912 walker and 1,105,792 semantic steps for the older binding fixture at line 2454. Restate both ceilings, the new record byte bound and the occupancy argument before T. If the implementation cannot establish enough capacity under those ceilings, publish revised bounds and their justification before running tagged evidence. Never silently raise fuel to get credit, or let a full trace stream park the fixture and misclassify it as semantic failure.\n   328\t\n   329\tFor other frontends, no oracle 4M/1M setting is inherited by default. Their adoption preflight must give numeric ceilings for each required fixture/prelude/host and format. Exceeding a declared bound blocks that acceptance run; changing bounds creates a new versioned run declaration and preserves the failed run.\n   330\t\n M src/cljc/yin/repl.cljc\n M src/cljc/yin/vm/linker/publish.cljc\n M src/cljc/yin/vm/semantic/derive.cljc\n M src/cljc/yin/vm/semantic/linearize.cljc\n M test/yang/clojure_callsite_test.cljc\n M test/yang/latte_oracle_test.clj\n M test/yin/vm/semantic/derive_test.cljc\n M test/yin/vm/semantic/linearize_test.cljc\n?? CC3-REVIEW-R2.md\n?? CC3-REVIEW-R3.md\n?? CC3-REVIEW-R4.md\n?? CC3-REVIEW.md\n?? collab/yang-clojure/1794357169000-engineer-cc3-lowering-provenance.muse-wonder-1.0.findings.md\n?? collab/yang-clojure/1794374077000-engineer-cc3-fix-r2.muse-wonder-1.0.findings.md\n?? collab/yang-clojure/1794376197000-engineer-cc3-fix-r3.muse-wonder-1.0.findings.md\n?? collab/yang-clojure/1794386683000-cc3-f6-measure.clj\n?? collab/yang-clojure/1794386683000-engineer-cc3-fix-r4.muse-wonder-1.0.findings.md\n","exit_code":0,"status":"completed"}}
