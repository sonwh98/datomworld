s (:binding ba))) (set (keys (:binding bb)))\n  4035\t             (set (keys (:binding ba1)))))\n  4036\t      (is (not= (set (vals (:binding ba))) (set (vals (:binding bb))))\n  4037\t          \"the same sites bind under each admission's own origin\")\n  4038\t      (is (not= (set (vals (:binding ba))) (set (vals (:binding ba1))))\n  4039\t          \"the same sites bind under each ordinal's own origin\"))))\n","exit_code":0,"status":"completed"}}
