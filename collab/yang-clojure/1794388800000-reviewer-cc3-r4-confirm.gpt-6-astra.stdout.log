   The admitting composition supplies `admission-scope` and the\n  2460\t   per-scope `admission-ordinal` (both plain data); the batch token\n  2461\t   of the admission origin `[:source :program batch-token j]` is the\n  2462\t   pair `[admission-scope admission-ordinal]` and the member index\n  2463\t   `j` is zero, because each admission here is a separately admitted\n  2464\t   single-member batch — the ordinal therefore distinguishes\n  2465\t   admissions through the token, and projected keys (reconstructed\n  2466\t   from a single-member envelope, member index always zero) agree\n  2467\t   with the recorded origin for every ordinal. Both coordinates are\n  2468\t   recorded WHEN ADMITTING, before compilation, validated by the\n  2469\t   same origin-shape rules as every source origin\n  2470\t   (`vm/source-origin`), and retained with the compilation as\n  2471\t   `:admission-origin` plain data. There is no per-JVM global\n  2472\t   counter (r3 F2) and no default admission stamping every admission\n  2473\t   alike (r4 F2): every caller supplies its coordinates explicitly,\n  2474\t   and replay of one retained compilation reuses its recorded\n  2475\t   coordinate.\"\n  2476\t  ([fixture admission-scope admission-ordinal]\n  2477\t   (let [call (kernel-c-program fixture)\n  2478\t         forms (kernel-closure call)\n  2479\t         source-hash (kernel-canonical-source-hash forms call)\n  2480\t         admission-origin (vm/source-origin\n  2481\t                            :program [admission-scope admission-ordinal] 0)\n  2482\t        program (into (into ['(def gate-execution-trace (stream/make 1000000))]\n  2483\t                            kernel-site-prelude)\n  2484\t                      (concat (map kernel-trace-form forms) [call]))\n  2485\t        program (into (yang/library-for program) program)\n  2486\t        opts (update arg-vector-opts :native into\n  2487\t                     (map (fn [[op profile]] [(clojure.core/symbol \"stream\" (name op)) profile])\n  2488\t                          module/stream-profiles))\n  2489\t        compiled (yang/compile-program program true opts)\n  2490\t        ;; caller-side site ids at the compiled application expressions,\n  2491\t        ;; post-macroexpansion (R2), with the mechanically derived site\n  2492\t        ;; table (R7); every assembled definition is instrumented\n  2493\t        {stamped :ast sites :sites} (kernel-stamp-sites\n  2494\t                                      compiled (into #{} (map second) forms))\n  2495\t        missing (unbound-ast-symbols stamped program)]\n  2496\t    (if (seq missing)\n  2497\t      {:status :blocked :phase :admission :blocked-by (vec (sort missing))\n  2498\t       :owners (into {} (for [s missing]\n  2499\t                          [s (mapv second (filter #(some #{s} (tree-seq coll? seq %)) program))]))}\n  2500\t      {:status :compiled :ast stamped :forms forms :compiled-ast compiled\n  2501\t       :admission-origin admission-origin\n  2502\t       :admission-scope admission-scope\n  2503\t       :admission-ordinal admission-ordinal\n  2504\t       :site-table (into {} (map (juxt :site identity)) sites)\n  2505\t       :site-table-hash source-hash\n  2506\t       :sites sites\n  2507\t       :canonical-source-hash source-hash}))))\n  2508\t\n  2509\t\n  2510\t(defn- kernel-c\n  2511\t  [compiled lane]\n  2512\t  (if (= :compiled (:status compiled))\n  2513\t    (assoc (kernel-attempt\n  2514\t             #(let [machine (compiler-test/run-guest-machine\n  2515\t                              (:ast compiled) (oracle-registry yang/kind-module) lane 4000000)\n  2516\t                    v (vm/value machine)\n  2517\t                    ref (get-in machine [:store 'gate-execution-trace])\n  2518\t                    handle (get-in machine [:resources (:id ref)])]\n  2519\t                (when-not (and (vm/halted? machine) handle)\n  2520\t                  (throw (ex-info \"Execution trace did not complete\" {:lane lane})))\n  2521\t                {:status :completed :outcome (evidence-data v) :shape (result-shape (evidence-data v))\n  2522\t                 :executed-calls (tu/drain handle)}))\n  2523\t           :lane lane)\n  2524\t    (assoc compiled :lane lane)))\n  2525\t\n  2526\t\n  2527\t(deftest test-kernel-proof-fresh-supply\n  2528\t  (testing \"explicit have types advance the supply; inferred types and prior contexts are preserved\"\n  2529\t    (doseq [[name next-name] [['h 'h2] ['_ '_]]\n  2530\t            [ty allocations] [['A 1] ['_ 0]]]\n  2531\t      (let [fixture\n  2532\t            {:call\n  2533\t             (walk/postwalk-replace\n  2534\t               {'H name 'H2 next-name 'TY ty}\n  2535\t               '(let [k0 env\n  3620\t   with the compilation (`:admission-origin`, cc3 r2 item 2) — never\n  3621\t   synthesized from content after compilation; a compilation without\n  3622\t   a retained record refuses with `:rule :cc3-admission-record`, and\n  3623\t   [:oracle/fixture <id>] is never minted.\"\n  3624\t  [compiled]\n  3625\t  (let [admission (:admission-origin compiled)]\n  3626\t    (when-not (vm/occurrence-origin? admission)\n  3627\t      (throw (ex-info \"Oracle binding requires the compilation's retained admission record\"\n  3628\t                      {:rule :cc3-admission-record\n  3629\t                       :admission admission})))\n  3630\t    (let [ast (:compiled-ast compiled)\n  3631\t          token (nth admission 2)\n  3632\t          origin admission\n  3633\t          projected (fn [tree-ast]\n  3634\t                      (encoder/project\n  3635\t                        (encoder/source-envelope :program token [tree-ast])))\n  3636\t          {:keys [tree rows marked eligible]}\n  3637\t          (let [p (projected ast)\n  3638\t                t (first (:yin/batch p))\n  3639\t                r (:yin/frontend-metadata p)]\n  3640\t            {:tree t :rows r\n  3641\t             :marked (into #{}\n  3642\t       