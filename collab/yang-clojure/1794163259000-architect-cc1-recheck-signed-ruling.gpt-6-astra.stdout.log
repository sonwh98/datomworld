d generated syntax. No expansion-record\n  1381\t   address is fabricated: only event rows the expander actually\n  1382\t   recorded appear. The table is therefore the explicit\n  1383\t   final-root correspondence §2.3 requires — every generated occurrence\n  1384\t   names its producing record, so an attribution consumer can reach the\n  1385\t   event (its input root, call path, macro root, output root) from the\n  1386\t   row alone.\"\n  1387\t  [row-set occurrence-origins admission-origin]\n  1388\t  (vec (sort-by pr-str\n  1389\t                (map (fn [[root path]]\n  1390\t                       [(get occurrence-origins path admission-origin)\n  1391\t                        root path :yang/call-site 1])\n  1392\t                     (vm/application-occurrences row-set)))))\n  1393\t\n  1394\t\n  1395\t(defn expand-batch\n  1396\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1397\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1398\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1399\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1400\t   success changes the store, to the post-harvest store. A success also\n  1401\t   carries `:frontend-metadata` — the C1 side table finalized over the\n  1402\t   final tree (`final-call-site-metadata`), covering the tree that\n  1403\t   actually executes — when, and only when, the selected member itself\n  1404\t   claimed C1 coverage (its own verdict in `batch-call-site-claims`); a\n  1405\t   sibling's claim never manufactures a table for it, and an unclaimed\n  1406\t   batch carries no table at all, never an empty one. The admission\n  1407\t   this expansion produced the tree under rides beside it as\n  1408\t   `:call-site-origin` — the source origin of the admitted run member,\n  1409\t   the key the table is stored and resolved under beside the final\n  1410\t   root address. It is the table's admission key, not a blanket\n  1411\t   stamp: each row's origin is that occurrence's own (§2.1, §2.3) —\n  1412\t   a retained occurrence keeps its own incoming provenance (its\n  1413\t   source origin, or the generating expansion's, however deeply it\n  1414\t   was passed through), and generated syntax carries the\n  1415\t   `[:expansion record-address]` of the recorded expansion event\n  1416\t   whose output introduced it. A context\n  1417\t   store binding a\n  1418\t   reserved name, or holding an entry without the current AST contract,\n  1419\t   is refused (Rule R): it is a composition defect, so it throws rather\n  1420\t   than returning an error.\"\n  1421\t  [batch ctx]\n  1422\t  (check-store! (:store ctx))\n  1423\t  (let [ctx (with-default-guards ctx)\n  1424\t        source-batch (:t ctx)\n  1425\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1426\t        finish (fn [st]\n  1427\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1428\t                   (if-let [e (:error st)]\n  1429\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1430\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1431\t                      :frontend-metadata (:frontend-metadata st),\n  1432\t                      :call-site-origin (:call-site-origin st),\n  1433\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1434\t        {:keys [admitted error]} (admit batch)]\n  1435\t    (if error\n  1436\t      (let [[st counter] (allocate-attempt base)]\n  1437\t        (finish (-> st\n  1438\t                    (record-event (event-row (attempt-id ctx counter) source-batch\n  1439\t                                             (source-origin ctx source-batch nil)\n  1440\t                                             nil nil nil nil nil error nil))\n  1441\t                    (fail error))))\n  1442\t      (let [{:keys [trees indexes index run-index definitions]} admitted\n  1443\t            store0 (or (:store ctx) {})\n  1444\t            store (harvest store0 #(nth indexes %) definitions)\n  1445\t            catalogue (into []\n  1446\t                            (comp (filter :declared?)\n  1447\t                                  (map (fn [{:keys [name tree path value]}]\n  1448\t                                         {:name name,\n  1449\t                                          :macro-tree (packet-of (nth indexes tree) value),\n  1450\t                                          :source [tree path]})))\n  1451\t                            definitions)\n  1452\t            ;; only the run tree is expanded, so only its declarations are\n  1453\t            ;; replaced; every catalogue entry still resolves by index\n  1454\t            [index standins]\n  1455\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1456\t                      (if (= run-index (first source))\n  1457\t                        (let [[index s] (intern-body index [standin-tag name k])]\n  1458\t                          [index (assoc acc (second source) s)])\n  1459\t                        [index acc]))\n  1460\t                    [index {}]\n  1461\t                    (map-indexed vector catalogue))\n  1462\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n  1463\t            st (assoc base :index index :store store)]\n  1464\t        (if-let [e (guard-batch-rows st)]\n  1465\t          (finish (fail st e))\n  1466\t          (let [[st root'] (expand-node st root\n  1467\t                                        {:path [], :rel [],\n  1468\t                                         :frame {:parent nil, :root root,\n  1469\t                                                 :tree-index run-index},\n  1470\t                                         :shadow #{}, :depth 0,\n  1471\t                                         ;; every syntax of the admitted\n  1472\t                                         ;; run tree starts as source\n  1473\t                                         ;; (§2.1); expansions override\n  1474\t                                         ;; below their outputs. The\n  1475\t                                         ;; function answers by absolute\n  1476\t                                         ;; occurrence path and ignores it\n  1477\t                                         ;; here: admitted syntax is all\n  1478\t                                         ;; source\n  1479\t                                         :origin-of\n  1480\t                                         (fn [_]\n  1481\t                                           (source-origin\n  1482\t                                             ctx source-batch run-index))})]\n  1483\t            (if (:error st)\n  1484\t              (finish st)\n  1485\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1486\t                    [index root'] (retail (:index st) root')\n  1487\t                    [index root'] (lower-standins index root')\n  1488\t                    tree (packet-of index root')\n  1489\t                    ;; the ADMISSION origin of this expansion (§2.1):\n  1490\t                    ;; the admitted run member's source origin — the key\n  1491\t                    ;; the side table is stored and resolved under beside\n  1492\t                    ;; the final root address. It is NOT blindly stamped\n  1493\t                    ;; on every row: each row's own origin is the one the\n  1494\t                    ;; occurrence walk recorded (source for retained\n  1495\t                    ;; syntax, the generating event's `[:expansion …]`\n  1496\t                    ;; for generated syntax)\n  1497\t                    origin (source-origin ctx source-batch run-index)\n  1498\t                    ;; the selected member's own verdict decides its\n  1499\t                    ;; metadata; a sibling's claim never manufactures a\n  1500\t                    ;; table for a member that made none\n  1501\t                    claims (batch-call-site-claims batch)\n  1502\t                     metadata (when (and claims (nth claims run-index))\n  1503\t                                (final-call-site-metadata\n  1504\t                                  (packet->row-set tree)\n  1505\t                                  (:call-site-origins st) origin))]\n  1506\t                (if-let [e (valid-tree? tree)]\n  1507\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1508\t                  (finish (assoc st :tree tree :next-store next-store\n  1509\t                                 :frontend-metadata metadata\n  1510\t                                  :call-site-origin (when metadata origin))))))))))))\n  1511\t\n  1512\t\n  1513\t(defn expand\n  1514\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1515\t   the error data.\"\n  1516\t  [batch ctx]\n  1517\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1518\t    (if (= :ok status)\n  1519\t      tree\n  1520\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1521\t\n  1522\t\n  1523\t(defn make-ctx\n  1524\t  \"An expander context. The composition supplies the incarnation `token`\n  1525\t   and the opaque `source-medium` identity (S3.1); the store may be\n  1526\t   seeded with `macro-entry` values. A seeded store binding a reserved\n  1527\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\n  1528\t   whose AST contract is absent (`:contract-missing`) or old\n  1529\t   (`:contract-mismatch`).\"\n  1530\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n  1531\t  (cond-> {:store (check-store! (or store {})),\n  1532\t           :incarnation {:yin.expander/token token},\n  1533\t           :attempt 0,\n  1534\t           :source-medium source-medium,\n  1535\t           :t 0,\n  1536\t           :guards (merge default-guards guards)}\n  1537\t    eval-fn (assoc :eval eval-fn)))\n  1538\t\n  1539\t\n  1540\t;; =============================================================================\n  1541\t;; Standard forms (§5.4)\n  1542\t;; =============================================================================\n  1543\t\n  1544\t(def ^:private defn-lambda-ast\n  1545\t  \"`(fn [fn-name fn-params & body]\n  1546\t      (let [b (yin/sequence-body body)\n  1547\t            l (yin/make-lambda fn-params b)]\n  1548\t        (yin/make-def fn-name l)))`, lowered as `let` lowers.\"\n  1549\t  (let [v (fn [s] {:type :variable, :name s})\n  1550\t        app (fn [op & args] {:type :application, :operator op, :operands (vec args)})]\n  1551\t    {:type :lambda,\n  1552\t     :params '[fn-name fn-params & body],\n  1553\t     :body (app {:type :lambda,\n  1554\t                 :params '[b],\n  1555\t                 :body (app {:type :lambda,\n  1556\t                             :params '[l],\n  1557\t                             :body (app (v 'yin/make-def) (v 'fn-name) (v 'l))}\n  1558\t                            (app (v 'yin/make-lambda) (v 'fn-params) (v 'b)))}\n  1559\t                (app (v 'yin/sequence-body) (v 'body)))}))\n  1560\t\n  1561\t\n  1562\t(def stdlib-forms\n  1563\t  \"The standard forms as a row-native batch: one tree defining `defn`,\n  1564\t   declared and harvested. Seed a store by expanding it (`seed-store`).\"\n  1565\t  (let [def-ast {:type :application,\n  1566\t                 :operator {:type :variable, :name 'yin/def},\n  1567\t                 :operands [{:type :literal, :value 'defn} defn-lambda-ast]}]\n  1568\t    [:yin.program/batch\n  1569\t     [(ast->packet def-ast)]\n  1570\t     0\n  1571\t     [[:yin.macro/definition 0 []]]\n  1572\t     [[:yin.macro/harvest 0 0 []]]]))\n  1573\t\n  1574\t\n  1575\t(defn seed-store\n  1576\t  \"Fold validated input batches in order through `expand-batch`, returning\n  1577\t   the resulting store. Throws on a batch that fails.\"\n  1578\t  [ctx batches]\n  1579\t  (:store (reduce (fn [ctx batch]\n  1580\t                    (let [{:keys [status error] :as r} (expand-batch batch ctx)]\n  1581\t                      (when-not (= :ok status)\n  1582\t                        (throw (ex-info \"Store seeding batch failed\" error)))\n  1583\t                      (:ctx r)))\n  1584\t                  ctx\n  1585\t                  batches)))\n  1586\t\n  1587\t\n  1588\t;; =============================================================================\n  1589\t;; Expander observer (§9)\n  1590\t;; =============================================================================\n  1591\t\n  1592\t(defn make-expander\n  1593\t  \"The observer consumer: `ctx`, the `program-out` writer, and an optional\n  1594\t   log writer, with nothing staged.\"\n  1595\t  ([ctx out] (make-expander ctx out nil))\n  1596\t  ([ctx out log]\n  1597\t   {:ctx ctx, :out out, :out-staged nil, :log log, :log-staged nil,\n  1598\t    :forwarded 0, :errors []}))\n  1599\t\n  1600\t\n  1601\t(defn ready?\n  1602\t  \"Ready only when both staged slots are empty.\"\n  1603\t  [expander]\n  1604\t  (and (nil? (:out-staged expander)) (nil? (:log-staged expander))))\n  1605\t\n  1606\t\n  1607\t(defn call-site-table\n  1608\t  \"The C1 side table the consumer `expander` holds for the occurrence\n  1609\t   the executed tree packet `tree` names — `origin` being the admission\n  1610\t   origin the table was stored under (§2.1: an application site is\n  1611\t   K = [origin root-address path]; the table's key is the admission\n  1612\t   origin beside the root address, while each row's own origin names\n  1613\t   that occurrence's admission or generating expansion record) — or nil when\n  1614\t   that occurrence made no C1 claim. Two expansions can produce the\n  1615\t   SAME final root from different admissions; keying by the full\n  1616\t   occurrence identity keeps their tables distinct, so resolving by the\n  1617\t   origin+root pair at hand never answers another execution's table,\n  1618\t   however many loads have run since, and an unclaimed load of a root\n  1619\t   previously loaded under a claim retrieves no stale table.\"\n  1620\t  [expander tree origin]\n  1621\t  (get (:call-site-tables expander) [origin (first tree)]))\n  1622\t\n  1623\t\n  1624\t(defn load\n  1625\t  \"Expand one observed batch once: keep the returned context, stage the\n  1626\t   tree only on success, stage the log when a log writer exists, and\n  1627\t   accumulate the error of a failed expansion. Expansion failure is\n  1628\t   data, so the cursor advances past it. A successful expansion's C1\n  1629\t   side table (the batch result's `:frontend-metadata`, present only\n  1630\t   when the selected member itself claimed coverage) is retained on the\n  1631\t   consumer under the occurrence identity of the staged tree — its\n  1632\t   admission origin beside its final root address (`call-site-tables`,\n  1633\t   resolved by `call-site-table`) — so the composition that drives this\n  1634\t   expander — the REPL's session — holds every executed occurrence's\n  1635\t   coverage beside the expander that produced it, each load's table\n  1636\t   surviving the next, even when two loads land on the same root.\"\n  1637\t  [expander batch]\n  1638\t  (let [{:keys [status tree log error ctx frontend-metadata\n  1639\t                call-site-origin]}\n  1640\t        (expand-batch batch (:ctx expander))]\n  1641\t    (cond-> (assoc expander :ctx ctx)\n  1642\t      (= :ok status) (assoc :out-staged tree)\n  1643\t      (and (= :ok status) frontend-metadata)\n  1644\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n  1645\t                frontend-metadata)\n  1646\t      (:log expander) (assoc :log-staged log)\n  1647\t      (= :error status) (update :errors conj error))))\n  1648\t\n  1649\t\n  1650\t(defn- flush-slot\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc '/Library/Developer/CommandLineTools/usr/bin/git diff 368297c3...fa70516f -- src/cljc/yang/clojure.cljc src/cljc/yang/core/uast.cljc src/cljc/yin/vm/encoder.cljc'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc '/Library/Developer/CommandLineTools/usr/bin/git diff 368297c3...fa70516f -- src/cljc/yang/clojure.cljc src/cljc/yang/core/uast.cljc src/cljc/yin/vm/encoder.cljc'","aggregated_output":"diff --git a/src/cljc/yang/clojure.cljc b/src/cljc/yang/clojure.cljc\nindex a59c1122..01c881fc 100644\n--- a/src/cljc/yang/clojure.cljc\n+++ b/src/cljc/yang/clojure.cljc\n@@ -43,6 +43,225 @@\n (declare compile-form compile-lambda)\n \n \n+;; =============================================================================\n+;; Call-site occurrence contract C1 (Addendum A, design §2)\n+;; =============================================================================\n+;;\n+;; Every final `:application` occurrence of a produced tree carries the\n+;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n+;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n+;; from canonical rows and emits it into the frontend-metadata side table\n+;; as `[origin root-address path :yang/call-site 1]`, where the first\n+;; three coordinates are the site id. The key carries no callee identity,\n+;; source arity, or ambient classification. It is distinct from\n+;; `:yang/site`, the safepoint mark, which travels as node metadata.\n+;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n+;; continuation nodes) are not `:application` nodes and are never marked.\n+\n+(def call-site-key\n+  \"The reserved frontend-metadata key of contract C1.\"\n+  :yang/call-site)\n+\n+\n+(def call-site-version\n+  \"The version value a C1 marker carries.\"\n+  1)\n+\n+\n+(def ^:private ^:dynamic *call-site-finalizing*\n+  \"True while an owning production entry point compiles a tree, so the\n+   recursive `compile-form` calls inside it defer marking to that entry\n+   point's single finalization walk over the finished tree.\"\n+  false)\n+\n+\n+(defn annotate-call-sites\n+  \"The finished map AST `node` with `call-site-key`/`call-site-version`\n+   on every `:application` node, at every depth the row grammar knows.\n+   Literal payloads are data, never syntax, and are not walked. Marking\n+   is idempotent and preserves node metadata and every other key, so\n+   canonical rows, roots, and executable outcomes are unchanged.\n+\n+   The walk itself is `yang.core.uast/annotate-call-sites`, shared with\n+   the other frontends' module trees; this frontend owns the contract's\n+   constants and its validation over canonical rows.\"\n+  [node]\n+  (u/annotate-call-sites node))\n+\n+\n+(defn eligible-application-sites\n+  \"The eligible C1 site set of canonical `tree` (`{:root :rows}`) under\n+   `origin`: one `[origin root-address path]` per `:application`\n+   occurrence, derived from the occurrence relation and the row tags.\"\n+  [tree origin]\n+  (into #{}\n+        (map (fn [[root path]] [origin root path]))\n+        (vm/application-occurrences tree)))\n+\n+\n+(defn call-site-metadata\n+  \"The C1 frontend-metadata rows of canonical `tree` (`{:root :rows}`)\n+   under `origin`: one `[origin root-address path :yang/call-site 1]`\n+   per eligible application occurrence, in printed-row order. This is\n+   the finalizer for trees that exist only as canonical rows — the\n+   expander's final tree, a published module's tree — where no map AST\n+   remains for `annotate-call-sites` to walk.\"\n+  [tree origin]\n+  (vec (sort-by pr-str\n+                (map (fn [[root path]]\n+                       [origin root path call-site-key call-site-version])\n+                     (vm/application-occurrences tree)))))\n+\n+\n+(defn marked-application-sites\n+  \"The deduped C1 marker set of a frontend-metadata relation: one\n+   `[origin root-address path]` per distinct `:yang/call-site` row.\n+   Duplicate identical transport deliveries dedupe to the same fact.\"\n+  [frontend-metadata]\n+  (into #{}\n+        (comp (filter (fn [row]\n+                        (and (= 5 (count row)) (= call-site-key (nth row 3)))))\n+              (map (fn [[origin root path _ _]] [origin root path])))\n+        (distinct frontend-metadata)))\n+\n+\n+(defn- marker-row?\n+  \"True when frontend-metadata `row` claims the C1 key: a sequential row\n+   whose fourth coordinate is `call-site-key`. A claiming row of any\n+   other arity is malformed, never a row to filter away silently.\"\n+  [row]\n+  (and (sequential? row)\n+       (<= 4 (count row))\n+       (= call-site-key (nth row 3))))\n+\n+\n+(defn validate-call-site-coverage!\n+  \"Validate a complete-coverage C1 claim: the marker set of\n+   `frontend-metadata` for canonical `tree` under `origin` must equal\n+   the eligible application set. Returns true when the claim holds.\n+\n+   A row that claims the C1 key but is not a five-coordinate\n+   `[origin root-address path key value]` row is malformed and is\n+   rejected, never silently filtered. The delivery mode is `opts`:\n+\n+   - default (transport): the relation arrived over a medium, where an\n+     at-least-once delivery may repeat a row; duplicate identical\n+     deliveries dedupe to the same fact;\n+   - `{:declared? true}`: the relation is a declared canonical table —\n+     the side table a producer published as the tree's table — where a\n+     duplicate entry is a second, conflicting claim to one fact and is\n+     rejected;\n+   - `{:per-occurrence-origins? true}`: the tree's occurrences do not\n+     share one origin — the expander's final tree, whose rows carry\n+     each occurrence's own admission or generating-expansion origin\n+     (design §2.1, §2.3). Coverage is then compared on the\n+     `[root-address path]` projection — the part a consumer derives\n+     from canonical rows alone — and every marker's origin is held to\n+     a well-formed occurrence origin; the origin VALUES are the\n+     producer's correspondence claim, not something a consumer can\n+     re-derive.\n+\n+   Conflicting values at one site, an unsupported marker version, a\n+   malformed origin, a marker naming no occurrence, a marker on a\n+   non-application occurrence, and missing or extra markers each\n+   throw, naming the failed `:rule`.\"\n+  ([tree frontend-metadata origin]\n+   (validate-call-site-coverage! tree frontend-metadata origin {}))\n+  ([tree frontend-metadata origin\n+    {:keys [declared? per-occurrence-origins?] :as _opts}]\n+   (doseq [row frontend-metadata]\n+     (when (and (marker-row? row) (not= 5 (count row)))\n+       (throw (ex-info \"Malformed call-site marker row\"\n+                       {:rule :yang/call-site-malformed, :row row}))))\n+   (when declared?\n+     (doseq [[row n] (frequencies (filter marker-row? frontend-metadata))]\n+       (when (< 1 n)\n+         (throw (ex-info \"Duplicate call-site marker in a declared table\"\n+                         {:rule :yang/call-site-duplicate-entry,\n+                          :site (vec (take 3 row)), :row row})))))\n+   (let [{:keys [root rows]} tree\n+         tag-at (into {}\n+                      (map (fn [[r path id]] [[r path] (nth (get rows id) 1)]))\n+                      (vm/occurrences tree))\n+         eligible ((if per-occurrence-origins?\n+                     (fn [_] (vm/application-occurrences tree))\n+                     #(eligible-application-sites tree %))\n+                   origin)\n+         rows (filter (fn [row]\n+                        (and (= 5 (count row)) (= call-site-key (nth row 3))))\n+                      (distinct frontend-metadata))\n+         by-site (group-by (fn [[o r path _ _]] [o r path]) rows)]\n+    (doseq [[site srows] by-site]\n+      (when (< 1 (count (distinct (map #(nth % 4) srows))))\n+        (throw (ex-info \"Conflicting call-site marker values\"\n+                        {:rule :yang/call-site-conflict, :site site,\n+                         :values (vec (distinct (map #(nth % 4) srows)))}))))\n+    ;; one occurrence — one [root-address path] — has exactly one\n+    ;; origin (design §2.1); a second marker with a DIFFERENT, equally\n+    ;; well-formed origin for an already-covered occurrence is a\n+    ;; second claim to one fact and is rejected, not folded into the\n+    ;; [root path] coverage projection. The one-origin-per-occurrence\n+    ;; rule holds in EVERY validator mode; the default mode rejects a\n+    ;; second claim with the same diagnostic (not a downstream\n+    ;; nonexistent-path error) so the failure names the occurrence and\n+    ;; both claims.\n+    (doseq [[site srows] (group-by (fn [[_ r path]] [r path]) rows)]\n+      (let [origins (distinct (map #(nth % 0) srows))]\n+        (when (< 1 (count origins))\n+          (throw (ex-info\n+                   \"Call-site occurrence claimed by multiple origins\"\n+                   {:rule :yang/call-site-multi-claim, :site site,\n+                    :origins (vec (sort-by pr-str origins))})))))\n+    (doseq [[o r path _ value] rows]\n+      (when (not= call-site-version value)\n+        (throw (ex-info \"Unsupported call-site marker version\"\n+                        {:rule :yang/call-site-unsupported-version,\n+                         :site [o r path], :value value})))\n+      (when (and per-occurrence-origins? (not (vm/occurrence-origin? o)))\n+        (throw (ex-info \"Call-site marker carries a malformed occurrence origin\"\n+                        {:rule :yang/call-site-invalid-origin,\n+                         :site [o r path], :origin o})))\n+      (let [tag (when (and (= r root)\n+                           (or per-occurrence-origins? (= o origin)))\n+                  (get tag-at [r path]))]\n+        (cond\n+          (nil? tag)\n+          (throw (ex-info \"Call-site marker names no occurrence\"\n+                          {:rule :yang/call-site-nonexistent-path,\n+                           :site [o r path]}))\n+          (not= :application tag)\n+          (throw (ex-info \"Call-site marker on a non-application occurrence\"\n+                          {:rule :yang/call-site-non-application,\n+                           :site [o r path], :tag tag})))))\n+    (let [marked (if per-occurrence-origins?\n+                   (into #{}\n+                         (map (fn [[_ r path]] [r path]))\n+                         (marked-application-sites frontend-metadata))\n+                   (marked-application-sites frontend-metadata))]\n+      (when (not= eligible marked)\n+        (throw (ex-info \"Call-site coverage is not complete\"\n+                        {:rule :yang/call-site-incomplete-coverage,\n+                         :missing (vec (sort-by pr-str\n+                                                (remove marked eligible))),\n+                         :extra (vec (sort-by pr-str\n+                                              (remove eligible marked)))}))))\n+    true)))\n+\n+\n+(defn validate-ast-call-sites!\n+  \"Validate the C1 claim of a produced map AST `ast` under `origin`:\n+   project it and compare the eligible application set derived from its\n+   canonical rows with the marker set of its frontend-metadata side\n+   table. The projected table is a declared canonical table, so it is\n+   validated strictly (`:declared? true`). Returns true when the sets\n+   are equal.\"\n+  [ast origin]\n+  (let [tree (vm/ast->semantic-bytecode ast)\n+        tables (vm/ast-side-tables ast tree origin)]\n+    (validate-call-site-coverage! tree (:frontend-metadata tables) origin\n+                                  {:declared? true})))\n+\n+\n (defn literal?\n   \"Check if a value is a literal (self-evaluating).\"\n   [form]\n@@ -2015,20 +2234,30 @@\n                                     :default (clojure.core/type form))}))))\n \n \n+(defn- compile-form-1\n+  [form tail? env macro-env]\n+  (let [ast (compile-form* form tail? (dissoc env ::top-level) macro-env\n+                           (::top-level env))\n+        m (meta form)]\n+    (if (seq (dissoc m ::fn-loop))\n+      (vary-meta ast merge (dissoc m ::fn