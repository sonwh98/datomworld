\n--- a/src/cljc/yin/repl/frontends.cljc\n+++ b/src/cljc/yin/repl/frontends.cljc\n@@ -39,6 +39,20 @@\n    :yang.frontend/support-profile :segment/legacy})\n \n \n+(defn clojure-manifest\n+  \"The Clojure frontend's manifest. Its coverage promise changed under\n+   the call-site occurrence contract C1 — every final `:application`\n+   occurrence carries `:yang/call-site` in the frontend-metadata side\n+   table, finalized over the post-expansion tree that executes and\n+   retained beside a published module's manifest — and that promise is\n+   a support claim, so the revision and the support profile name it;\n+   the shared legacy profiles no longer describe this frontend.\"\n+  []\n+  (assoc (manifest :yang/clojure :clojure)\n+         :yang.frontend/revision \"c1-1\"\n+         :yang.frontend/support-profile :yang.clojure/c1))\n+\n+\n (defn- clojure-lower\n   [forms]\n   (if (= 1 (count forms))\n@@ -78,7 +92,7 @@\n    returns.\"\n   []\n   (cond-> frontend/empty-catalog\n-    true (frontend/install (manifest :yang/clojure :clojure)\n+    true (frontend/install (clojure-manifest)\n                            {:input :forms,\n                             :parse identity,\n                             :lower clojure-lower})\ndiff --git a/src/cljc/yin/vm.cljc b/src/cljc/yin/vm.cljc\nindex b0d222ca..1bb7ca84 100644\n--- a/src/cljc/yin/vm.cljc\n+++ b/src/cljc/yin/vm.cljc\n@@ -1609,6 +1609,20 @@\n                (into tuples (map (fn [[path id]] [root path id]) frontier)))))))\n \n \n+(defn application-occurrences\n+  \"The `[root path]` of every `:application` occurrence of the projected\n+   row set `tree`: the occurrence relation joined on the row tags, with\n+   no origin — a composition fixes the origin from its own side, as with\n+   `occurrences`. This is the eligible-site derivation of the call-site\n+   occurrence contract: one pair per place, so a shared application row\n+   at two places counts twice.\"\n+  [{:keys [rows] :as tree}]\n+  (into #{}\n+        (comp (filter (fn [[_ _ id]] (= :application (nth (get rows id) 1))))\n+              (map (fn [[root path _]] [root path])))\n+        (occurrences tree)))\n+\n+\n (def occurrence-rules\n   \"§4.5/§7.7: root-scoped occurrence rules, as portable data. A name is\n    bound at `[root path]` iff a `:lambda` occurrence of the same root sits\ndiff --git a/src/cljc/yin/vm/linker.cljc b/src/cljc/yin/vm/linker.cljc\nindex 8900fd54..44aacf0e 100644\n--- a/src/cljc/yin/vm/linker.cljc\n+++ b/src/cljc/yin/vm/linker.cljc\n@@ -738,11 +738,11 @@\n \n (def ^:private manifest-keys\n   \"The closed key set of a schema-1 manifest: every key of section 8.1's\n-   example, the index alone optional.\"\n+   example, the index and the call-site reference alone optional.\"\n   #{:yin.module/name :yin.module/schema :yin.module/contracts\n     :yin.module/tree :yin.module/derivations :yin.module/index\n     :yin.module/exports :yin.module/requires :yin.module/primitives\n-    :yin.module/footprint})\n+    :yin.module/footprint :yin.module/call-sites})\n \n \n (def ^:private derivation-formats\n@@ -785,7 +785,8 @@\n                   (when (or (not (contains? manifest k))\n                             (nil? (get manifest k)))\n                     (assoc (shape k) :missing true)))\n-                (disj manifest-keys :yin.module/index))\n+                (disj manifest-keys :yin.module/index\n+                      :yin.module/call-sites))\n           (when-not (symbol? (:yin.module/name manifest))\n             (shape :yin.module/name))\n           (when (vm/reserved-name? (:yin.module/name manifest))\n@@ -831,6 +832,16 @@\n                          (set? (get-in manifest\n                                        [:yin.module/footprint :effects])))\n             (shape :yin.module/footprint))\n+          ;; optional, and only when present checked: the C1 side-table\n+          ;; reference is exactly the table's and the reverse record's\n+          ;; Jing addresses (`yin.vm.linker.publish`)\n+          (let [call-sites (:yin.module/call-sites manifest)]\n+            (when (and (some? call-sites)\n+                       (not (and (map? call-sites)\n+                                 (= #{:table :record} (set (keys call-sites)))\n+                                 (address? (:table call-sites))\n+                                 (address? (:record call-sites)))))\n+              (shape :yin.module/call-sites)))\n           (some (fn [n]\n                   (when (vm/reserved-name? n)\n                     {:rule :reserved-name, :name n,\ndiff --git a/src/cljc/yin/vm/linker/closure.cljc b/src/cljc/yin/vm/linker/closure.cljc\nindex 3b99b7ea..bfb8168e 100644\n--- a/src/cljc/yin/vm/linker/closure.cljc\n+++ b/src/cljc/yin/vm/linker/closure.cljc\n@@ -192,6 +192,43 @@\n (declare walk-module)\n \n \n+(defn- walk-call-sites\n+  \"Step 4b: the C1 side table and its reverse record the manifest\n+   references (`:yin.module/call-sites`, `yin.vm.linker.publish`), read\n+   and held to their own shape — the table is a vector of frontend-\n+   metadata rows, the record is version 1, names the manifest's own\n+   tree, and points at the referenced table. The origin is not\n+   recomputed or reconstructed here: each marker row carries its own\n+   occurrence origin (design §2.1), and the record persists the\n+   publication's admission identity, which the retriever reads from\n+   the record, never from the tree.\"\n+  [st manifest path]\n+  (if-some [call-sites (:yin.module/call-sites manifest)]\n+    (let [[st table] (read-blob st (:table call-sites) :call-site path)]\n+      (if (:stop st)\n+        st\n+        (let [[st record] (read-blob st (:record call-sites) :call-site path)]\n+          (cond\n+            (:stop st) st\n+\n+            (not (vector? table))\n+            (stop st (invalid (:table call-sites) :call-site path\n+                              :call-site-defect {:code :table-shape}))\n+\n+            (not= {:yang.call-site/version 1\n+                   :yang.call-site/root (:yin.module/tree manifest)\n+                   :yang.call-site/table (:table call-sites)}\n+                  (select-keys record\n+                               [:yang.call-site/version\n+                                :yang.call-site/root\n+                                :yang.call-site/table]))\n+            (stop st (invalid (:record call-sites) :call-site path\n+                              :call-site-defect {:code :record-shape}))\n+\n+            :else st))))\n+    st))\n+\n+\n (defn- walk-requires\n   \"Step 5: list every pin with derived eagerness, then descend only into\n    eager manifests not walked before. Deferred pins load at statement time.\"\n@@ -242,7 +279,8 @@\n                    (update :modules conj manifest-address)\n                    (walk-rows (:yin.module/tree manifest) path))\n             st (if (:stop st) st (walk-records st manifest path))\n-            st (if (:stop st) st (walk-images st manifest path))]\n+            st (if (:stop st) st (walk-images st manifest path))\n+            st (if (:stop st) st (walk-call-sites st manifest path))]\n         (if (:stop st)\n           st\n           (walk-requires st manifest-address manifest path depth))))))\n@@ -262,11 +300,13 @@\n      {:yin.link.closure/outcome :invalid\n       :address a :role role :path [...] :defect {:code c :detail d}}\n \n-   `role` is `:manifest`, `:row`, `:record`, `:image` or `:require`;\n+   `role` is `:manifest`, `:row`, `:record`, `:image`, `:call-site` or\n+   `:require`;\n    `path` the manifest addresses from the root to the module the blob\n    belongs to.  `:code` is one of `:address-mismatch`, `:manifest-defect`,\n    `:row-defect`, `:record-defect`, `:derivation-mismatch`,\n-   `:index-entry-missing`, `:identity-mismatch`, `:parts-limit`.\"\n+   `:index-entry-missing`, `:identity-mismatch`, `:call-site-defect`,\n+   `:parts-limit`.\"\n   ([handle manifest-address] (walk handle manifest-address nil))\n   ([handle manifest-address opts]\n    (let [bounds (into linker/default-bounds\ndiff --git a/test/yang/core/call_test.cljc b/test/yang/core/call_test.cljc\nindex af7e8e8b..ea68c140 100644\n--- a/test/yang/core/call_test.cljc\n+++ b/test/yang/core/call_test.cljc\n@@ -180,10 +180,11 @@\n                                                 {:callee :value})))))))\n   (testing \"bundled and linked emitters use the same definition source\"\n     (is (= call/module-uast\n-           (core/module-tree\n-             (core/module-definitions \"yang.call\" :yang.call/uninit\n-                                      [] call/definitions)\n-             [])))\n+           (u/annotate-call-sites\n+             (core/module-tree\n+               (core/module-definitions \"yang.call\" :yang.call/uninit\n+                                        [] call/definitions)\n+               []))))\n     (is (= call/module-exports\n            (:exports (call/module-spec registry))))\n     (is (= call/host-names\ndiff --git a/test/yin/vm/encoder_test.cljc b/test/yin/vm/encoder_test.cljc\nindex 6c313f32..34925315 100644\n--- a/test/yin/vm/encoder_test.cljc\n+++ b/test/yin/vm/encoder_test.cljc\n@@ -51,8 +51,11 @@\n \n (deftest a-datom-member-declares-what-its-map-ast-declares\n   (let [ast (program '((defmacro m [x] x) (m 1)))]\n-    (is (= (encoder/program-batch ast)\n-           (encoder/program-batch (vec (vm/ast->datoms ast))))\n+    ;; the C1 claim element, when the map path claims coverage, is the\n+    ;; one difference: `:yang/call-site` markers are occurrence\n+    ;; metadata, not datoms, so a datom member makes no C1 claim\n+    (is (= (subvec (encoder/program-batch ast) 0 5)\n+           (subvec (encoder/program-batch (vec (vm/ast->datoms ast))) 0 5))\n         \"the :yin/macro? datom carries the frontend's declaration fact\")))\n \n \n","exit_code":0,"status":"completed"}}
