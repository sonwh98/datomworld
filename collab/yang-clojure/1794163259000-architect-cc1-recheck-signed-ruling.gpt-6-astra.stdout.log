\t  \\\"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\\n  1179\\t   `rel` path within the current `frame` (`{:root r :parent event|nil\\n  1180\\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\\n  1181\\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\\n  1182\\t   answers the origin of the admission or generation event that\\n  1183\\t   produced the syntax of the row at `address`. Every application\\n  1184\\t   occurrence is recorded under its absolute path as it is visited, so\\n  1185\\t   the finalizer can name each occurrence's real origin; an occurrence\\n  1186\\t   replaced by an expansion is re-recorded by the expansion's own walk,\\n  1187\\t   and a stale entry for a path the finished tree no longer applies at\\n  1188\\t   is simply never read. Returns `[st address']`; a failure sets\\n  1189\\t   `(:error st)`.\\\"\\n  1190\\t  [st address {:keys [shadow] :as loc}]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yang/clojure.cljc | sed -n '140,255p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yang/clojure.cljc | sed -n '140,255p'\\\"\",\"aggregated_output\":\"   140\\t   `frontend-metadata` for canonical `tree` under `origin` must equal\\n   141\\t   the eligible application set. Returns true when the claim holds.\\n   142\\t\\n   143\\t   A row that claims the C1 key but is not a five-coordinate\\n   144\\t   `[origin root-address path key value]` row is malformed and is\\n   145\\t   rejected, never silently filtered. The delivery mode is `opts`:\\n   146\\t\\n   147\\t   - default (transport): the relation arrived over a medium, where an\\n   148\\t     at-least-once delivery may repeat a row; duplicate identical\\n   149\\t     deliveries dedupe to the same fact;\\n   150\\t   - `{:declared? true}`: the relation is a declared canonical table —\\n   151\\t     the side table a producer published as the tree's table — where a\\n   152\\t     duplicate entry is a second, conflicting claim to one fact and is\\n   153\\t     rejected;\\n   154\\t   - `{:per-occurrence-origins? true}`: the tree's occurrences do not\\n   155\\t     share one origin — the expander's final tree, whose rows carry\\n   156\\t     each occurrence's own admission or generating-expansion origin\\n   157\\t     (design §2.1, §2.3). Coverage is then compared on the\\n   158\\t     `[root-address path]` projection — the part a consumer derives\\n   159\\t     from canonical rows alone — and every marker's origin is held to\\n   160\\t     a well-formed occurrence origin; the origin VALUES are the\\n   161\\t     producer's correspondence claim, not something a consumer can\\n   162\\t     re-derive.\\n   163\\t\\n   164\\t   Conflicting values at one site, an unsupported marker version, a\\n   165\\t   malformed origin, a marker naming no occurrence, a marker on a\\n   166\\t   non-application occurrence, and missing or extra markers each\\n   167\\t   throw, naming the failed `:rule`.\\\"\\n   168\\t  ([tree frontend-metadata origin]\\n   169\\t   (validate-call-site-coverage! tree frontend-metadata origin {}))\\n   170\\t  ([tree frontend-metadata origin\\n   171\\t    {:keys [declared? per-occurrence-origins?] :as _opts}]\\n   172\\t   (doseq [row frontend-metadata]\\n   173\\t     (when (and (marker-row? row) (not= 5 (count row)))\\n   174\\t       (throw (ex-info \\\"Malformed call-site marker row\\\"\\n   175\\t                       {:rule :yang/call-site-malformed, :row row}))))\\n   176\\t   (when declared?\\n   177\\t     (doseq [[row n] (frequencies (filter marker-row? frontend-metadata))]\\n   178\\t       (when (< 1 n)\\n   179\\t         (throw (ex-info \\\"Duplicate call-site marker in a declared table\\\"\\n   180\\t                         {:rule :yang/call-site-duplicate-entry,\\n   181\\t                          :site (vec (take 3 row)), :row row})))))\\n   182\\t   (let [{:keys [root rows]} tree\\n   183\\t         tag-at (into {}\\n   184\\t                      (map (fn [[r path id]] [[r path] (nth (get rows id) 1)]))\\n   185\\t                      (vm/occurrences tree))\\n   186\\t         eligible ((if per-occurrence-origins?\\n   187\\t                     (fn [_] (vm/application-occurrences tree))\\n   188\\t                     #(eligible-application-sites tree %))\\n   189\\t                   origin)\\n   190\\t         rows (filter (fn [row]\\n   191\\t                        (and (= 5 (count row)) (= call-site-key (nth row 3))))\\n   192\\t                      (distinct frontend-metadata))\\n   193\\t         by-site (group-by (fn [[o r path _ _]] [o r path]) rows)]\\n   194\\t    (doseq [[site srows] by-site]\\n   195\\t      (when (< 1 (count (distinct (map #(nth % 4) srows))))\\n   196\\t        (throw (ex-info \\\"Conflicting call-site marker values\\\"\\n   197\\t                        {:rule :yang/call-site-conflict, :site site,\\n   198\\t                         :values (vec (distinct (map #(nth % 4) srows)))}))))\\n   199\\t    ;; one occurrence — one [root-address path] — has exactly one\\n   200\\t    ;; origin (design §2.1); a second marker with a DIFFERENT, equally\\n   201\\t    ;; well-formed origin for an already-covered occurrence is a\\n   202\\t    ;; second claim to one fact and is rejected, not folded into the\\n   203\\t    ;; [root path] coverage projection\\n   204\\t    (when (or declared? per-occurrence-origins?)\\n   205\\t      (doseq [[site srows] (group-by (fn [[_ r path]] [r path]) rows)]\\n   206\\t        (let [origins (distinct (map #(nth % 0) srows))]\\n   207\\t          (when (< 1 (count origins))\\n   208\\t            (throw (ex-info\\n   209\\t                     \\\"Call-site occurrence claimed by multiple origins\\\"\\n   210\\t                     {:rule :yang/call-site-multi-claim, :site site,\\n   211\\t                      :origins (vec (sort-by pr-str origins))}))))))\\n   212\\t    (doseq [[o r path _ value] rows]\\n   213\\t      (when (not= call-site-version value)\\n   214\\t        (throw (ex-info \\\"Unsupported call-site marker version\\\"\\n   215\\t                        {:rule :yang/call-site-unsupported-version,\\n   216\\t                         :site [o r path], :value value})))\\n   217\\t      (when (and per-occurrence-origins? (not (vm/occurrence-origin? o)))\\n   218\\t        (throw (ex-info \\\"Call-site marker carries a malformed occurrence origin\\\"\\n   219\\t                        {:rule :yang/call-site-invalid-origin,\\n   220\\t                         :site [o r path], :origin o})))\\n   221\\t      (let [tag (when (and (= r root)\\n   222\\t                           (or per-occurrence-origins? (= o origin)))\\n   223\\t                  (get tag-at [r path]))]\\n   224\\t        (cond\\n   225\\t          (nil? tag)\\n   226\\t          (throw (ex-info \\\"Call-site marker names no occurrence\\\"\\n   227\\t                          {:rule :yang/call-site-nonexistent-path,\\n   228\\t                           :site [o r path]}))\\n   229\\t          (not= :application tag)\\n   230\\t          (throw (ex-info \\\"Call-site marker on a non-application occurrence\\\"\\n   231\\t                          {:rule :yang/call-site-non-application,\\n   232\\t                           :site [o r path], :tag tag})))))\\n   233\\t    (let [marked (if per-occurrence-origins?\\n   234\\t                   (into #{}\\n   235\\t                         (map (fn [[_ r path]] [r path]))\\n   236\\t                         (marked-application-sites frontend-metadata))\\n   237\\t                   (marked-application-sites frontend-metadata))]\\n   238\\t      (when (not= eligible marked)\\n