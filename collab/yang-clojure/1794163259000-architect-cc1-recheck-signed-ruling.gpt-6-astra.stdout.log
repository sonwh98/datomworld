— and keeps ITS OWN incoming\\n  1082\\t        ;; provenance (§2.1): the origin the enclosing walk's\\n  1083\\t        ;; `origin-of` already answers for that address, which need not\\n  1084\\t        ;; be the replaced application's origin (an operand packet may\\n  1085\\t        ;; carry syntax of mixed origin); rows the expansion itself\\n  1086\\t        ;; generated take the event's origin below\\n  1087\\t        input-addrs (into #{address}\\n  1088\\t                          (map first)\\n  1089\\t                          (second (packet-of (:index st) address)))\\n  1090\\t        begin (fn [output error]\\n  1091\\t                (event-row (attempt-id ctx counter)\\n  1092\\t                           (:source-batch st)\\n  1093\\t                           (when-not (:parent frame)\\n  1094\\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\\n  1095\\t                           (:parent frame)\\n  1096\\t                           (:root frame)\\n  1097\\t                           rel\\n  1098\\t                           macro-root\\n  1099\\t                           output\\n  1100\\t                           error))\\n  1101\\t        failed (fn [st error]\\n  1102\\t                 (-> st (record-event (begin nil error)) (fail error)))\\n  1103\\t        guards (:guards ctx)]\\n  1104\\t    (if (>= depth (:max-depth guards))\\n  1105\\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\\n  1106\\t      (let [row (get (:index st) address)\\n  1107\\t            operands (mapv #(packet-of (:index st) %) (nth row 3))\\n  1108\\t            {:keys [tree error]} (invoke* entry operands ctx counter)\\n  1109\\t            invalid (fn [reason]\\n  1110\\t                      {:kind :invalid-output, :macro macro-root, :path path,\\n  1111\\t                       :reason reason})]\\n  1112\\t        (if error\\n  1113\\t          [(failed st error) address]\\n  1114\\t          (if-let [e (valid-tree? tree {:working? true})]\\n  1115\\t            [(failed st (invalid (:reason e))) address]\\n  1116\\t            (let [n (count (set (map first (second tree))))]\\n  1117\\t              (if (> n (:max-rows-per-expansion guards))\\n  1118\\t                [(failed st {:kind :row-guard, :scope :expansion, :rows n}) address]\\n  1119\\t                (let [st' (merge-output st tree)]\\n  1120\\t                  (if (::conflict st')\\n  1121\\t                    [(failed st (invalid :address-conflict)) address]\\n  1122\\t                    (if-let [e (guard-batch-rows st')]\\n  1123\\t                      [(failed st' e) address]\\n  1124\\t                      (let [out (first tree)\\n  1125\\t                            ev (begin out nil)\\n  1126\\t                            st' (-> st'\\n  1127\\t                                    (record-event ev)\\n  1128\\t                                    (update :produced\\n  1129\\t                                            (fn [p]\\n  1130\\t                                              (if (some #(= out (first %)) p)\\n  1131\\t                                                p\\n  1132\\t                                                (conj p (packet-of (:index st') out))))))]\\n  1133\\t                        (expand-node st' out\\n  1134\\t                                     {:path path,\\n  1135\\t                                      :rel [],\\n  1136\\t                                      :frame {:parent (first ev), :root out},\\n  1137\\t                                      :shadow shadow,\\n  1138\\t                                      :depth (inc depth),\\n  1139\\t                                      :origin-of\\n  1140\\t                                      (fn [a]\\n  1141\\t                                        (if (contains? input-addrs a)\\n  1142\\t                                          ;; retained syntax keeps its\\n  1143\\t                                      