ed here. Each\\n  1357\\t   member's own verdict decides its metadata: only a member that\\n  1358\\t   claimed coverage finalizes a side table, whatever its siblings\\n  1359\\t   claimed.\\\"\\n  1360\\t  [batch]\\n  1361\\t  (nth batch 5 nil))\\n  1362\\t\\n  1363\\t\\n  1364\\t(defn- final-call-site-metadata\\n  1365\\t  \\\"The call-site occurrence contract's (C1) side table of an expanded\\n  1366\\t   final tree, as frontend-metadata rows `[origin root path\\n  1367\\t   :yang/call-site 1]` in printed-row order: one row per\\n  1368\\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\\n  1369\\t   that actually executes. The frontend's own markers named the\\n  1370\\t   pre-expansion tree; expansion, tail marking and stand-in lowering\\n  1371\\t   recompute roots and paths, so no pre-expansion table can cover this\\n  1372\\t   tree and the table is finalized here, over the finished rows.\\n  1373\\t\\n  1374\\t   Each row's origin is that occurrence's REAL origin (design §2.1,\\n  1375\\t   §2.3): `occurrence-origins` maps the final occurrence path to the\\n  1376\\t   origin of the admission or generation event that produced the\\n  1377\\t   application syntax at that path — the admitted run member's source\\n  1378\\t   origin for retained syntax (a no-op expansion keeps it valid), and\\n  1379\\t   the `[:expansion record-address]` of the recorded expansion event\\n  1380\\t   whose output introduced generated syntax. No expansion-record\\n  1381\\t   address is fabricated: only event rows the expander actually\\n  1382\\t   recorded appear. The table is therefore the explicit\\n  1383\\t   final-root correspondence §2.3 requires — every generated occurrence\\n  1384\\t   names its producing record, so an attribution consumer can reach the\\n  1385\\t   event (its input root, call path, macro root, output root) from the\\n  1386\\t   row alone.\\\"\\n  1387\\t  [row-set occurrence-origins admission-origin]\\n  1388\\t  (vec (sort-by pr-str\\n  1620\\t  [expander tree origin]\\n  1621\\t  (get (:call-site-tables expander) [origin (first tree)]))\\n  1622\\t\\n  1623\\t\\n  1624\\t(defn load\\n  1625\\t  \\\"Expand one observed batch once: keep the returned context, stage the\\n  1626\\t   tree only on success, stage the log when a log writer exists, and\\n  1627\\t   accumulate the error of a failed expansion. Expansion failure is\\n  1628\\t   data, so the cursor advances past it. A successful expansion's C1\\n  1629\\t   side table (the batch result's `:frontend-metadata`, present only\\n  1630\\t   when the selected member itself claimed coverage) is retained on the\\n  1631\\t   consumer under the occurrence identity of the staged tree — its\\n  1632\\t   admission origin beside its final root address (`call-site-tables`,\\n  1633\\t   resolved by `call-site-table`) — so the composition that drives this\\n  1634\\t   expander — the REPL's session — holds every executed occurrence's\\n  1635\\t   coverage beside the expander that produced it, each load's table\\n  1636\\t   surviving the next, even when two loads land on the same root.\\\"\\n  1637\\t  [expander batch]\\n  1638\\t  (let [{:keys [status tree log error ctx frontend-metadata\\n  1639\\t                call-site-origin]}\\n  1640\\t        (expand-batch batch (:ctx expander))]\\n  1641\\t    (cond-> (assoc expander :ctx ctx)\\n  1642\\t      (= :ok status) (assoc :out-staged tree)\\n  1643\\t      (and (= :ok status) frontend-metadata)\\n  1644\\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\\n  1645\\t                frontend-metadata)\\n  1646\\t      (:log expander) (assoc :log-staged log)\\n  1647\\t      (= :error status) (update :errors conj error))))\\n  1648\\t\\n  1649\\t\\n  1650\\t(defn- flush-slot\\n  1651\\t  [expander writer-key slot-key on-ok]\\n  1652\\t  (if-let [payload (get expander slot-key)]\\n  1653\\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\\n  1654\\t      (case outcome\\n  1655\\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\\n  1656\\t        :dao.stream/full expander\\n  1657\\t        (throw (ex-info \\\"Expander could not publish a staged value\\\"\\n  1658\\t                        {:dao.stream/outcome outcome,\\n  1659\\t                         :destination slot-key,\\n  1660\\t                         :consumer expander}))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '90,250p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '90,250p'\\\"\",\"aggregated_output\":\"    90\\t   linker/stack-format linker/register-format])\\n    91\\t\\n    92\\t\\n    93\\t;; =============================================================================\\n    94\\t;; Call-site occurrence contract C1 (Addendum A, design §2)\\n    95\\t;; =============================================================================\\n    96\\t;;\\n    97\\t;; A module whose frontend finalized its tree (`:yang/call-site 1` on\\n    98\\t;; every final `:application` occurrence) publishes its frontend-metadata\\n    99\\t;; side table with its manifest: the manifest keeps schema 1 (a manifest\\n   100\\t;; address names code) and gains the optional `:yin.module/call-sites`\\n   101\\t;; reference `{table record}` — the module closure follows manifest\\n   102\\t;; references, so only a referenced table travels with the module\\n   103\\t;; through transfer. The reverse record names the tree root, the\\n   104\\t;; publication's recorded admission origin, and the table's address; it\\n   105\\t;; cannot name the manifest (the manifest references it, so the two\\n   106\\t;; addresses would be circular), and custody runs one way, from the\\n   107\\t;; manifest forward. The publication's origin is an ADMISSION identity\\n   108\\t;; (design §2.1): a token the composition pins explicitly, draws from\\n   109\\t;; a composition-owned scope object, or — by default — has derived\\n   110\\t;; from the publication specification's own durable identity; no\\n   111\\t;; counter or other mutable state lives in this namespace. The token\\n   112\\t;; is persisted in the record and retrieved from the record, never\\n   113\\t;; reconstructed from the tree's content. The publisher\\n   114\\t;; extracts the markers from the map AST, refuses the\\n   115\\t;; publication when they do not exactly cover the canonical tree's\\n   116\\t;; application occurrences — or when a marker's value is not version 1 —\\n   117\\t;; and otherwise materializes the table and its record into the same\\n   118\\t;; handle. A module with no markers makes no claim and publishes exactly\\n   119\\t;; as before.\\n   120\\t\\n   121\\t(defn admission-scope\\n   122\\t  \\\"An admission scope for `publish-module!`'s `:yin.link.publish/scope`\\n   123\\t   option. `id` names this publisher — a durable, caller-chosen\\n   124\\t   identity (a string or keyword) that distinguishes this publisher's\\n   125\\t   admissions from every other publisher's; a publisher that must not\\n   126\\t   collide with its own past runs takes a fresh `id` per run. The\\n   127\\t   returned scope object OWNS the publication ordinal counter, so no\\n   128\\t   counter lives in this namespace (no hidden global state): two\\n   129\\t   publications through one scope draw consecutive ordinals, and two\\n   130\\t   independent scopes publishing identical specifications still yield\\n   131\\t   distinct admission identities, because their `id`s differ.\\\"\\n   132\\t  [id]\\n   133\\t  {:yin.link.publish/scope-id id\\n   134\\t   :yin.link.publish/ordinal (atom 0)})\\n   135\\t\\n   136\\t(defn- scope-admission-token\\n   137\\t  \\\"The admission token a scope object draws for one publication: the\\n   138\\t   scope's own `id` plus the ordinal the scope's counter assigns. The\\n   139\\t   counter lives in the caller-owned scope object, never here.\\\"\\n   140\\t  [{:yin.link.publish/keys [scope-id ordinal]}]\\n   141\\t  ;; pr-str keeps the value's full identity — a keyword's namespace, a\\n   142\\t  ;; string's quoting, a symbol's name — so distinct caller-chosen ids\\n   143\\t  ;; (:a/publisher, :b/publisher, \\\"publisher\\\") never mint the same token\\n   144\\t  (keyword \\\"yin.vm.linker.publish.scope\\\"\\n   145\\t           (str (pr-str scope-id) \\\"#\\\" (swap! ordinal inc))))\\n   146\\t\\n   147\\t(defn- spec-admission-token\\n   148\\t  \\\"The default admission token: derived deterministically from the\\n   149\\t   publication specification's own durable identity — the module name\\n   150\\t   and the content address of its compiled tree — never from hidden\\n   151\\t   mutable state. Two publications of the same specification therefore\\n   152\\t   answer the same admission identity (an idempotent re-publication is\\n   153\\t   the same recorded admission), and distinct specifications never\\n   154\\t   share one, in this or any other publisher process. A composition\\n   155\\t   that admits the same specification more than once as separate\\n   156\\t   admissions passes an `:yin.link.publish/scope` (or an explicit\\n   157\\t   `:yin.link.publish/admission`) so the admissions stay distinct.\\\"\\n   158\\t  [{:keys [name]} tree]\\n   159\\t  (keyword \\\"yin.vm.linker.publish.publication\\\"\\n   160\\t           (str name \\\"::\\\" (:root tree))))\\n   161\\t\\n   162\\t(defn- publication-origin\\n   163\\t  \\\"The occurrence origin of the publication admission `token` names:\\n   164\\t   the publisher's own medium, the explicit admission token, member 0.\\n   165\\t   `token` is the publication's admission identity — the\\n   166\\t   `:yin.link.publish/admission` option when the composition pins one,\\n   167\\t   the `:yin.link.publish/scope` option's next drawn token when the\\n   168\\t   composition scopes the publisher, otherwise the token derived from\\n   169\\t   the publication specification's own durable identity. The origin is\\n   170\\t   an admission event's identity, not a function of the tree's content\\n   171\\t   alone: it is persisted in the side record at publication time and\\n   172\\t   retrieved from that record; nothing ever reconstructs it from the\\n   173\\t   root.\\\"\\n   174\\t  [token]\\n   175\\t  [:source :yin.vm.linker.publish/publish token 0])\\n   176\\t\\n   177\\t\\n   178\\t(defn- claims-call-sites?\\n   179\\t  \\\"True when map AST `ast` carries the C1 key anywhere. A hit inside a\\n   180\\t   literal payload is data, not a claim: extraction then finds no\\n   181\\t   markers and the module publishes unannotated, as it should.\\\"\\n   182\\t  [ast]\\n   183\\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\\n   184\\t\\n   185\\t\\n   186\\t(defn- call-site-claim\\n   187\\t  \\\"The C1 claim `ast` makes over its canonical `tree`: nil when it\\n   188\\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\\n   189\\t   when the extracted markers exactly cover the tree's eligible\\n   190\\t   application occurrences; `{:missing [...] :extra [...]}` when they\\n   191\\t   do not; `{:unsupported-version v :path p}` when a marker's value is\\n   192\\t   not version 1 — a claim rejection, never a silent acceptance of a\\n   193\\t   table a retriever would read as version 1.\\\"\\n   194\\t  [ast tree admission]\\n   195\\t  (when (claims-call-sites? ast)\\n   196\\t    (let [origin (publication-origin admission)\\n   197\\t          extracted (filter #(= :yang/call-site (nth % 3))\\n   198\\t                            (:frontend-metadata\\n   199\\t                              (vm/ast-side-tables ast tree origin)))\\n   200\\t          eligible (into #{}\\n   201\\t                         (map (fn [[r p]] [origin r p]))\\n   202\\t                         (vm/application-occurrences tree))\\n   203\\t          marked (into #{}\\n   204\\t                       (map (fn [[o r p _ _]] [o r p]))\\n   205\\t                       extracted)]\\n   206\\t      (or (when-let [[v p] (some (fn [row]\\n   207\\t                                   (let [v (nth row 4)]\\n   208\\t                                     (when (not (and (integer? v) (= 1 v)))\\n   209\\t                                       [v (subvec row 0 3)])))\\n   210\\t                                 extracted)]\\n   211\\t            {:unsupported-version v, :path p})\\n   212\\t          (if (= eligible marked)\\n   213\\t            {:origin origin, :rows (vec (sort-by pr-str extracted))}\\n   214\\t            {:missing (vec (sort-by pr-str (remove marked eligible))),\\n   215\\t             :extra (vec (sort-by pr-str (remove eligible marked)))})))))\\n   216\\t\\n   217\\t\\n   218\\t(defn link-local\\n   219\\t  \\\"Link `format`'s image through the manifest `address` over `handle`'s\\n   220\\t   own content, `:verifying` with discharge deferred, as a serving\\n   221\\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\\n   222\\t   call, so no request reaches any peer.  `opts` overrides the link\\n   223\\t   options; its `:bounds` are the runtime's composition bounds (section\\n   224\\t   4.2 step 2), every one left out taking `linker/default-bounds`.\\\"\\n   225\\t  ([handle address format] (link-local handle address format nil))\\n   226\\t  ([handle address format opts]\\n   227\\t   (linker/link-manifest\\n   228\\t     (linker/local-runtime\\n   229\\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\\n   230\\t                              (conj code-formats linker/manifest-format\\n   231\\t                                    linker/record-format))\\n   232\\t               :bounds (:bounds opts)})\\n   233\\t     address (:format format) {:primitives vm/primitives}\\n   234\\t     (merge {:contract (:contract format)\\n   235\\t             :derivation :verifying\\n   236\\t             :defer-discharge true}\\n   237\\t            (dissoc opts :bounds)))))\\n   238\\t\\n   239\\t\\n   240\\t(defn- publish-closure!\\n   241\\t  \\\"`publish-module!` under the composition bounds of `opts`.\\\"\\n   242\\t  [handle {:keys [name ast exports requires primitives] :as spec} opts]\\n   243\\t  (let [undefined (first (remove (definitions ast) exports))\\n   244\\t        tree (when-not undefined\\n   245\\t               (try (vm/ast->semantic-bytecode ast)\\n   246\\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\\n   247\\t                      (refusal :yin.link.publish/malformed-tree {}))))\\n   248\\t        defect (when (and tree (not= :refused (:status tree)))\\n   249\\t                 (vm/validate-rows tree))\\n   250\\t        ;; each pinned closure is walked before anything is written; an\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'plain|host-value|segment-key|defn encode' src/cljc/yin/vm/macro.cljc src/cljc/dao/jing* src/cljc/yin/vm/linker/publish.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'plain|host-value|segment-key|defn encode' src/cljc/yin/vm/macro.cljc src/cljc/dao/jing* src/cljc/yin/vm/linker/publish.cljc\\\"\",\"aggregated_output\":\"src/cljc/dao/jing.cljc:4:   A content-store handle is a plain-data byte store, not a protocol:\\nsrc/cljc/dao/jing.cljc:92:  \\\"The default algorithm used for implicit minting (content-hash, segm