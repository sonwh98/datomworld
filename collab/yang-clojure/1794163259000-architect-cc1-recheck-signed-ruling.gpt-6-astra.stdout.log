s spec} opts]\\n   243\\t  (let [undefined (first (remove (definitions ast) exports))\\n   244\\t        tree (when-not undefined\\n   245\\t               (try (vm/ast->semantic-bytecode ast)\\n   246\\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\\n   247\\t                      (refusal :yin.link.publish/malformed-tree {}))))\\n   248\\t        defect (when (and tree (not= :refused (:status tree)))\\n   249\\t                 (vm/validate-rows tree))\\n   250\\t        ;; each pinned closure is walked before anything is written; an\\n   251\\t        ;; absent pinned manifest is the footprint's missing-requirement\\n   252\\t        requirement\\n   253\\t        (when (and tree (not defect) (not= :refused (:status tree)))\\n   254\\t          (some (fn [[n address]]\\n   255\\t                  (let [w (closure/walk handle address opts)]\\n   256\\t                    (case (:yin.link.closure/outcome w)\\n   257\\t                      :complete nil\\n   258\\t                      :invalid (refusal :yin.link.publish/invalid-requirement\\n   259\\t                                        {:name n})\\n   260\\t                      :missing (when (not= address (:address w))\\n   261\\t                                 (refusal :yin.link.publish/incomplete-requirement\\n   262\\t                                          {:name n :walk w})))))\\n   263\\t                (sort-by (fn [[n _]] (str n)) requires)))\\n   264\\t        fp (when (and tree (not defect) (not requirement)\\n   265\\t                      (not= :refused (:status tree)))\\n   266\\t             (footprint handle (assoc spec :tree tree)))\\n   267\\t        ;; a C1 claim is validated before anything is written: a module\\n   268\\t        ;; whose markers do not cover its tree is never published as\\n   269\\t        ;; though it did. One publication is one admission event\\n   270\\t        ;; (design §2.1): the admission identity is pinned explicitly by\\n   271\\t        ;; the composition when it supplies `:yin.link.publish/admission`,\\n   272\\t        ;; drawn from the composition's own scope object when it supplies\\n   273\\t        ;; `:yin.link.publish/scope`, and otherwise derived from the\\n   274\\t        ;; specification's own durable identity — no counter lives in\\n   275\\t        ;; this namespace. Either way it is persisted in the side record\\n   276\\t        ;; and retrieved from there\\n   277\\t        admission (or (:yin.link.publish/admission opts)\\n   278\\t                      (when-let [scope (:yin.link.publish/scope opts)]\\n   279\\t                        (scope-admission-token scope))\\n   280\\t                      (when tree (spec-admission-token spec tree)))\\n   281\\t        claim (when (and tree (not defect) (not requirement)\\n   282\\t                         (not= :refused (:status tree))\\n   283\\t                         (not= :refused (:status fp)))\\n   284\\t                (call-site-claim ast tree admission))]\\n   285\\t    (cond\\n   286\\t      undefined\\n   287\\t      (refusal :yin.link.publish/undefined-export {:export undefined})\\n   288\\t\\n   289\\t      (= :refused (:status tree)) tree\\n   290\\t\\n   291\\t      defect\\n   292\\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\\n   293\\t\\n   294\\t      requirement requirement\\n   295\\t\\n   296\\t      (= :refused (:status fp)) fp\\n   297\\t\\n   298\\t      ;; dispatch on the key's PRESENCE, not its truthiness: a marker\\n   299\\t      ;; whose value is present but not the integer 1 — nil or false\\n   300\\t      ;; included — carries :unsupported-version nil/false, and its\\n   301\\t      ;; reason is the unsupported version, never incomplete coverage\\n   302\\t      (and claim (contains? claim :unsupported-version))\\n   303\\t      (refusal :yin.link.publish/unsupported-call-site-version claim)\\n   304\\t\\n   305\\t      (and claim (not (:rows claim)))\\n   306\\t      (refusal :yin.link.publish/incomplete-call-site-coverage claim)\\n   307\\t\\n   308\\t      :else\\n   309\\t      (let [tree-address (vm/materialize-tree! handle tree)\\n   310\\t            sem-vector (:vector (linearize/project-rows tree))\\n   311\\t            sem (code/materialize-vector! handle sem-vector)\\n   312\\t            h-image (:image (derive/stack-image sem-vector))\\n   313\\t            r-image (derive/register-image sem-vector)\\n   314\\t            h (dcode/image-hash h-image)\\n   315\\t            r (rcode/register-hash r-image)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba src/cljc/yin/vm/macro.cljc | sed -n '970,1190p'\\\"\",\"aggregated_output\":\"   970\\t   installs that entry; later occurrences win.\\\"\\n   971\\t  [store index root catalogue]\\n   972\\t  (letfn [(children\\n   973\\t            [row]\\n   974\\t            (let [places (child-places row)]\\n   975\\t              (if (and (= :application (row-tag row))\\n   976\\t                       (= :lambda (row-tag (get index (nth row 2)))))\\n   977\\t                (concat (map second (rest places))\\n   978\\t                        [(nth (get index (nth row 2)) 3)])\\n   979\\t                (map second places))))\\n   980\\t          (walk\\n   981\\t            [store a]\\n   982\\t            (let [row (get index a)\\n   983\\t                  store (cond\\n   984\\t                          (= standin-tag (row-tag row))\\n   985\\t                          (let [[_ _ nm k] row\\n   986\\t                                entry (get catalogue k)]\\n   987\\t                            (if (and entry (= nm (:name entry)))\\n   988\\t                              (assoc store nm\\n   989\\t                                     (macro-entry (:macro-tree entry)\\n   990\\t                                                  vm/ast-contract))\\n   991\\