-                                          (dsg__assoc dsg__candidate :clj/admission nil)))
-                                      false))
-                                  false))))
+         (outcomes? env) (#(u/app
+                             (u/lam '[dsg__admitted? dsg__intra_call] %)
+                             (u/sexp->uast
+                               '(fn [dsg__candidate]
+                                  (if (data/map? dsg__candidate)
