re + fabricated (conflicting)\n  (let [inner (mem/create-content-mem)\n        store (assoc inner :put-bytes-fn\n                     (fn [address bs]\n                       (let [v (try (cbor/decode bs)\n                                    (catch Exception _ nil))]\n                         (when (and (map? v)\n                                    (contains? v :yin.vm.provenance/schema))\n                           (throw (ex-info \"store refused the provenance write\" {})))\n                         ((:put-bytes-fn inner) address bs))))\n        s0 (frontends/create-state {:index-store store\n                                    :primitives {(quote boom) boom-fn}})\n        s1 (first (repl/eval-input s0 \"(def k (fn [] 1))\"))\n        s2 (first (repl/eval-input s1 \"(def g (fn [] (+ (k) 41)))\"))]\n    (report \"P2 immediate conflicting\" (repl/eval-input s2 \"(+ (g) (boom))\")))\n  ;; P3 link-resume, healthy + fabricated\n  (let [s0 (frontends/create-state {:primitives {(quote boom) boom-fn}})\n        s1 (reduce (fn [s line] (first (repl/eval-input s line)))\n                   s0\n                   [\"(def k (fn [] 1))\"\n                    \"(def g (fn [] (+ (k) 41)))\"\n                    \"(require (quote dao.space.query))\"])]\n    (report \"P3 link-resume healthy\"\n            (repl/eval-input\n              s1\n              (str \"(let [r (dao.space.query/q \"\n                   \"(quote [:find (count ?e) . :where [?e :yin/name ?n]]))] (boom))\"))))\n  (is true \"probe only\"))\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794407164000-engineer-cc3-fix-r9.muse-wonder-1.0.429-outage.log\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794407164000-engineer-cc3-fix-r9.glm-5.3.stdout.log\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794416000000-reviewer-cc3-r9-confirm.gpt-6-astra.stdout.log\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794407164000-engineer-cc3-fix-r9.muse-wonder-1.0.findings.md\n/Users/sto/workspace/datomworld/collab/yang-clojure/1794407164000-engineer-cc3-fix-r9.prompt.md\n  1682\t   It also carries the call-provenance handles completed retention\n  1683\t   had already persisted before the resume (r4 F4): a program that\n  1684\t   returned from the evaluator stage waiting on a query/link has its\n  1685\t   handles on `state`, and a throw when `drive-links` resumes it\n  1686\t   must not drop them with the interrupted run.  The carried\n  1687\t   snapshot is shell-owned and authoritative, the empty snapshot\n  1688\t   included (r9 F1): the wrapped error payload is never merged as\n  1689\t   retention evidence, so a guest or host throw with forged\n  1690\t   `::call-provenance-*` keys cannot fabricate handles, diagnostics\n  1691\t   or a Warning through this raise.\"\n  1692\t  [error vm state]\n  1693\t  (ex-info (or (ex-message error) \"Link failed\")\n  1694\t           (assoc (or (ex-data error) {})\n  1695\t                  ::link-counter (:id-counter vm)\n  1696\t                  ::link-origins (:origins vm)\n  1697\t                  ::query-pair (:query-pair state)\n  1698\t                  ::linker (:linker state)\n  1699\t                  ::dht (:dht state)\n  1700\t                  ::indexer (:indexer state)\n  1701\t                  ;; r9 F1: the shell snapshot of retention rides\n  1702\t                  ;; unconditionally — empty (nil) included — over\n  1703\t                  ;; whatever the wrapped error carried, and the\n  1704\t                  ;; wrapped payload is never merged: recovery reads\n  1705\t                  ;; retention evidence only from this shell-owned\n  1706\t                  ;; record, never from the program exception. The\n  1707\t                  ;; state is the record of what retention did\n  1708\t                  ;; (r4 F4); the inner payload is not retention\n  1709\t                  ;; evidence at all.\n  1710\t                  ::call-provenance-handles (:call-provenance-handles state)\n  1711\t                  ::call-provenance-failures (:call-provenance-failures state)\n  1712\t                  ::call-provenance-round-failures\n  1713\t                  (:call-provenance-round-failures state))))\n  1714\t\n  1715\t\n","exit_code":0,"status":"completed"}}
