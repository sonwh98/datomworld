   [s1 _] (repl/eval-input\n  2339\t                     (repl-frontends/create-state\n  2340\t                       {:index-store (r9-refusing-store fail?)\n  2341\t                        :primitives {(quote boom) r9-forged-boom}})\n  2342\t                     \"(def k (fn [] 1))\")\n  2343\t            [s2 _] (repl/eval-input s1 \"(def g (fn [] (+ (k) 41)))\")\n  2344\t            handles-before (repl/call-provenance-handles s2)]\n  2345\t        (is (seq handles-before) \"precondition: earlier retention completed\")\n  2346\t        (is (empty? (repl/call-provenance-failures s2))\n  2347\t            \"precondition: retention was healthy so far\")\n  2348\t        (reset! fail? genuine-failure?)\n  2349\t        (let [[s3 text] (repl/eval-input s2 \"(+ (g) (boom))\")]\n  2350\t          (r9-assert-no-fabricated-evidence\n  2351\t            genuine-failure? text (repl/call-provenance-failures s3)\n  2352\t            (repl/call-provenance-handles s3) handles-before))))))\n  2353\t\n  2354\t\n  2355\t(deftest repl-fabricated-retention-evidence-is-ignored-on-link-resume-test\n  2356\t  ;; cc3 r9 F1: the same forgery in a throw the shell raises while\n  2357\t  ;; resuming a query wait (the link-raise path through drive-links)\n  2358\t  ;; is not retention evidence either: the raise carries the shell\n  2359\t  ;; snapshot unconditionally over the wrapped payload, so no\n  2360\t  ;; fabricated diagnostic, handle or Warning appears, while genuine\n  2361\t  ;; retention survives exactly once.\n  2362\t  (doseq [[label genuine-failure?] [[\"healthy retention\" false]\n  2363\t                                    [\"genuine retention failure\" true]]]\n  2364\t    (testing label\n  2365\t      (let [fail? (atom false)\n  2366\t            s1 (reduce (fn [s line] (first (repl/eval-input s line)))\n  2367\t                       (repl-frontends/create-state\n  2368\t                         {:index-store (r9-refusing-store fail?)\n  2369\t                          :primitives {(quote boom) r9-forged-boom}})\n  2370\t                       [\"(def k (fn [] 1))\"\n  2371\t                        \"(def g (fn [] (+ (k) 41)))\"\n  2372\t                        \"(require (quote dao.space.query))\"])\n  2373\t            handles-before (repl/call-provenance-handles s1)]\n  2374\t        (is (seq handles-before) \"precondition: earlier retention completed\")\n  2375\t        (is (empty? (repl/call-provenance-failures s1))\n  2376\t            \"precondition: retention was healthy so far\")\n  2377\t        (reset! fail? genuine-failure?)\n  2378\t        (let [[s2 text] (repl/eval-input\n  2379\t                          s1\n  2380\t                          (str \"(let [r (dao.space.query/q \"\n  2381\t                               \"(quote [:find (count ?e) . \"\n  2382\t                               \":where [?e :yin/name ?n]]))] (boom))\"))]\n  2383\t          (r9-assert-no-fabricated-evidence\n  2384\t            genuine-failure? text (repl/call-provenance-failures s2)\n  2385\t            (repl/call-provenance-handles s2) handles-before))))))\n","exit_code":0,"status":"completed"}}
