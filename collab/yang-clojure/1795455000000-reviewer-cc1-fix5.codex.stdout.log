 index; an address whose\n  1132\t   working body differs is an `:address-conflict`.\"\n  1133\t  [st [_ rows]]\n  1134\t  (reduce (fn [st row]\n  1135\t            (let [prior (get (:index st) (first row))]\n  1136\t              (cond (nil? prior) (assoc-in st [:index (first row)] row)\n  1137\t                    (same-value? prior row) st\n  1138\t                    :else (reduced (assoc st ::conflict (first row))))))\n  1139\t          st\n  1140\t          rows))\n  1141\t\n  1142\t\n  1143\t(declare expand-node)\n  1144\t\n  1145\t\n  1180\t   origin. The output's per-occurrence correspondence is read from that\n  1181\t   construction history, retained in the event record, and the\n  1182\t   recursive walk answers origins from the record — never from\n  1183\t   comparing content addresses.\"\n  1184\t  [st address entry {:keys [path rel frame shadow depth origin-of]}]\n  1185\t  (let [[st counter] (allocate-attempt st)\n  1186\t        ctx (:ctx st)\n  1187\t        macro-root (first (:yin.macro/tree entry))\n  1188\t        begin (fn [output error correspondence]\n  1189\t                (event-row (attempt-id ctx counter)\n  1190\t                           (:source-batch st)\n  1191\t                           (when-not (:parent frame)\n  1192\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\n  1193\t                           (:parent frame)\n  1194\t                           (:root frame)\n  1195\t                           rel\n  1196\t                           macro-root\n  1197\t                           output\n  1198\t                           error\n  1199\t                           correspondence))\n  1200\t        failed (fn [st error]\n  1201\t                 (-> st (record-event (begin nil error nil)) (fail error)))\n  1202\t        guards (:guards ctx)]\n  1203\t    (if (>= depth (:max-depth guards))\n  1204\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\n  1205\t      (let [row (get (:index st) address)\n  1206\t            operands (map-indexed\n  1207\t                      (fn [i a]\n  1208\t                        (with-origin-of (packet-of (:index st) a)\n  1209\t                          (fn [rel]\n  1210\t                            (origin-of (into (conj path [3 i]) rel)))))\n  1211\t                      (nth row 3))\n  1212\t            {:keys [tree error]} (invoke* entry operands ctx counter)\n  1213\t            invalid (fn [reason]\n  1214\t                      {:kind :invalid-output, :macro macro-root, :path path,\n  1215\t                       :reason reason})]\n  1216\t        (if error\n  1217\t          [(failed st error) address]\n  1218\t          (if-let [e (valid-tree? tree {:working? true})]\n  1219\t            [(failed st (invalid (:reason e))) address]\n  1220\t            (let [n (count (set (map first (second tree))))]\n  1221\t              (if (> n (:max-rows-per-expansion guards))\n  1222\t                [(failed st {:kind :row-guard, :scope :expansion, :rows n}) address]\n  1223\t                (let [st' (merge-output st tree)]\n  1224\t                  (if (::conflict st')\n  1225\t                    [(failed st (invalid :address-conflict)) address]\n  1226\t                    (if-let [e (guard-batch-rows st')]\n  1227\t                      [(failed st' e) address]\n  1228\t                      (let [;; the output's construction origin function\n  1229\t                            ;; (ruling U1); an output the prelude did not\n  1230\t                            ;; thread — unreachable through the sanctioned\n  1231\t                            ;; constructors — classifies as constructed\n  1232\t                            ofn (or (origin-of-fn tree)\n  1233\t                                    (fn [_] pending-expansion-origin))\n  1234\t                            corr (output-correspondence tree ofn)\n  1235\t                            out (first tree)\n  1236\t                            ev (begin out nil corr)\n  1237\t                            st' (-> st'\n  1238\t                                    (record-event ev)\n  1239\t                                    (update :produced\n  1240\t                                            (fn [p]\n  1241\t                                              (if (some #(= out (first %)) p)\n  1242\t                                                p\n  1243\t                                                (conj p (packet-of (:index st') out))))))]\n  1244\t                        (expand-node st' out\n  1245\t                                     {:path path,\n  1246\t                                      :rel [],\n  1247\t                                      :frame {:parent (first ev), :root out},\n  1248\t                                      :shadow shadow,\n  1249\t                                      :depth (inc depth),\n  1250\t                                      ;; per-occurrence origins read from\n  1251\t                                      ;; the RETAINED correspondence (§2.1,\n  1252\t                                      ;; §8): a `[:retained origin]` names\n  1253\t                                      ;; the incoming origin the syntax\n  1254\t                                      ;; already carried, a `:constructed`\n  1255\t                                      ;; occurrence names the recorded\n  1256\t                                      ;; expansion event — the record the\n  1257\t                                      ;; correspondence is retained in\n  1258\t                                      :origin-of\n  1259\t                                      (fn [abs-path]\n  1260\t                                        (let [o (get corr (subvec abs-path (count path)))]\n  1261\t                                          (if (and (vector? o) (= :retained (first o)))\n  1262\t                                            (second o)\n  1263\t                                            [:expansion (first ev)])))})))))))))))))\n  1264\t\n  1265\t\n  1266\t(defn- expand-children\n  1267\t  \"Expand `row`'s children in order `places` under per-child shadows;\n  1268\t   `[st address']`, rebuilding the row when any child changed.\"\n  1269\t  [st row places shadow-of {:keys [path rel] :as loc}]\n  1270\t  (let [[st children']\n  1271\t        (reduce (fn [[st acc] [coord c]]\n  1272\t                  (if (:error st)\n  1273\t                    (reduced [st acc])\n  1274\t                    (let [[st c'] (expand-node st c\n  1275\t                                               (assoc loc\n  1276\t                                                      :path (conj path coord)\n  1277\t                                                      :rel (conj rel coord)\n  1278\t                                                      :shadow (shadow-of coord)))]\n  1279\t                      [st (conj acc c')])))\n  1280\t                [st []]\n  1281\t                places)]\n  1282\t    (if (:error st)\n  1283\t      [st (first row)]\n  1284\t      (let [[index a'] (rebuild-row (:index st) row places children')]\n  1285\t        [(assoc st :index index) a']))))\n  1286\t\n  1287\t\n  1288\t(defn- expand-node\n  1289\t  \"§4.2. `loc` carries the absolute `path` in the batch's run tree, the\n  1290\t   `rel` path within the current `frame` (`{:root r :parent event|nil\n  1291\t   :tree-index j}`), the lexical `shadow` set, the expansion `depth`,\n  1292\t   and `:origin-of` — the occurrence-provenance function of §2.1, which\n  1293\t   answers, for an ABSOLUTE occurrence path, the origin of the\n  1294\t   admission or generation event that produced the syntax there.\n  1295\t   Every application\n  1296\t   occurrence is recorded under its absolute path as it is visited, so\n  1297\t   the finalizer can name each occurrence's real origin; an occurrence\n  1298\t   replaced by an expansion is re-recorded by the expansion's own walk,\n  1299\t   and a stale entry for a path the finished tree no longer applies at\n  1300\t   is simply never read. Returns `[st address']`; a failure sets\n  1301\t   `(:error st)`.\"\n  1302\t  [st address {:keys [shadow] :as loc}]\n  1303\t  (if (:error st)\n  1304\t    [st address]\n  1305\t    (let [row (get (:index st) address)\n  1306\t          tag (row-tag row)]\n  1307\t      (cond\n  1308\t        (and (= :application tag) (macro-of st (nth row 2) shadow))\n  1309\t        (expand-call st address (macro-of st (nth row 2) shadow) loc)\n  1310\t\n  1311\t        (= :application tag)\n  1312\t        (let [st (update-in st [:call-site-origins]\n  1313\t                            assoc (:path loc) ((:origin-of loc) (:path loc)))\n  1314\t              op (nth row 2)\n  1315\t              [st op'] (expand-node st op (-> loc\n  1316\t                                              (update :path conj 2)\n  1317\t                                              (update :rel conj 2)))]\n  1318\t          (if (:error st)\n  1319\t            [st address]\n  1320\t            (let [[index app'] (if (= op op')\n  1321\t                                 [(:index st) address]\n  1322\t                                 (intern-body (:index st) (assoc (subvec row 1) 1 op')))\n  1323\t                  st (assoc st :index index)\n  1324\t                  row' (get index app')]\n  1325\t              (if (macro-of st op' shadow)\n  1326\t                ;; recognition is not expansion: depth is unchanged\n  1327\t                (expand-node st app' loc)\n  1328\t                (expand-children st row' (rest (child-places row'))\n  1329\t                                 (constantly shadow) loc)))))\n  1330\t\n  1331\t        :else\n  1332\t        (let [shadow' (if (= :lambda tag) (into shadow (nth row 2)) shadow)]\n  1333\t          (expand-children st row (child-places row)\n  1334\t                           (constantly shadow') loc))))))\n  1335\t\n  1336\t\n  1337\t;; =============================================================================\n  1338\t;; The batch (§3.1, §3.2)\n  1339\t;; =============================================================================\n  1340\t\n  1341\t(defn- log-packet\n  1342\t  [st]\n  1343\t  [:yin.macro/log (:events st) (:produced st)])\n  1344\t\n  1345\t\n  1346\t(defn- with-default-guards\n  1347\t  [ctx]\n  1348\t  (update ctx :guards #(merge default-guards %)))\n  1349\t\n  1350\t\n  1351\t(defn- batch-call-site-claims\n  1352\t  \"The per-member call-site (C1) claim verdicts the encoder recorded on\n  1353\t   `batch`: nil when no member claimed coverage, otherwise one boolean\n  1354\t   per member — the encoder validated every member's markers against\n  1355\t   its own tree at the boundary, so a member whose markers do not\n  1356\t   exactly cover it was refused there, never delivered here. Each\n  1357\t   member's own verdict decides its metadata: only a member that\n  1358\t   claimed coverage finalizes a side table, whatever its siblings\n  1359\t   claimed.\"\n  1360\t  [batch]\n  1361\t  (nth batch 5 nil))\n  1362\t\n  1363\t\n  1364\t(defn- final-call-site-metadata\n  1365\t  \"The call-site occurrence contract's (C1) side table of an expanded\n  1366\t   final tree, as frontend-metadata rows `[origin root path\n  1367\t   :yang/call-site 1]` in printed-row order: one row per\n  1368\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\n  1369\t   that actually executes. The frontend's own markers named the\n  1370\t   pre-expansion tree; expansion, tail marking and stand-in lowering\n  1371\t   recompute roots and paths, so no pre-expansion table can cover this\n  1372\t   tree and the table is finalized here, over the finished rows.\n  1373\t\n  1374\t   Each row's origin is that occurrence's REAL origin (design §2.1,\n  1375\t   §2.3): `occurrence-origins` maps the final occurrence path to the\n  1376\t   origin of the admission or generation event that produced the\n  1377\t   application syntax at that path — the admitted run member's source\n  1378\t   origin for retained syntax (a no-op expansion keeps it valid), and\n  1379\t   the `[:expansion record-address]` of the recorded expansion event\n  1380\t   whose output introduced generated syntax. No expansion-record\n  1381\t   address is fabricated: only event rows the expander actually\n  1382\t   recorded appear. The table is therefore the explicit\n  1383\t   final-root correspondence §2.3 requires — every generated occurrence\n  1384\t   names its producing record, so an attribution consumer can reach the\n  1385\t   event (its input root, call path, macro root, output root) from the\n  1386\t   row alone.\"\n  1387\t  [row-set occurrence-origins admission-origin]\n  1388\t  (vec (sort-by pr-str\n  1620\t  [expander tree origin]\n  1621\t  (get (:call-site-tables expander) [origin (first tree)]))\n  1622\t\n  1623\t\n  1624\t(defn load\n  1625\t  \"Expand one observed batch once: keep the returned context, stage the\n  1626\t   tree only on success, stage the log when a log writer exists, and\n  1627\t   accumulate the error of a failed expansion. Expansion failure is\n  1628\t   data, so the cursor advances past it. A successful expansion's C1\n  1629\t   side table (the batch result's `:frontend-metadata`, present only\n  1630\t   when the selected member itself claimed coverage) is retained on the\n  1631\t   consumer under the occurrence identity of the staged tree — its\n  1632\t   admission origin beside its final root address (`call-site-tables`,\n  1633\t   resolved by `call-site-table`) — so the composition that drives this\n  1634\t   expander — the REPL's session — holds every executed occurrence's\n  1635\t   coverage beside the expander that produced it, each load's table\n  1636\t   surviving the next, even when two loads land on the same root.\"\n  1637\t  [expander batch]\n  1638\t  (let [{:keys [status tree log error ctx frontend-metadata\n  1639\t                call-site-origin]}\n  1640\t        (expand-batch batch (:ctx expander))]\n  1641\t    (cond-> (assoc expander :ctx ctx)\n  1642\t      (= :ok status) (assoc :out-staged tree)\n  1643\t      (and (= :ok status) frontend-metadata)\n  1644\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n  1645\t                frontend-metadata)\n  1646\t      (:log expander) (assoc :log-staged log)\n  1647\t      (= :error status) (update :errors conj error))))\n  1648\t\n  1649\t\n  1650\t(defn- flush-slot\n  1651\t  [expander writer-key slot-key on-ok]\n  1652\t  (if-let [payload (get expander slot-key)]\n  1653\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\n  1654\t      (case outcome\n  1655\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\n  1656\t        :dao.stream/full expander\n  1657\t        (throw (ex-info \"Expander could not publish a staged value\"\n  1658\t                        {:dao.stream/outcome outcome,\n  1659\t                         :destination slot-key,\n  1660\t                         :consumer expander}))))\n","exit_code":0,"status":"completed"}}
