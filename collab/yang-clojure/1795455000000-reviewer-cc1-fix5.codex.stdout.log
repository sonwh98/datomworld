{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/macro.cljc | sed -n '400,800p'\"","aggregated_output":"   400\t                       (every? boolean? claim)))))))\n   401\t\n   402\t\n   403\t(defn- merge-indexes\n   404\t  \"Union the trees' indexes into one working index, verifying that one\n   405\t   address denotes one body across trees (each tree is already internally\n   406\t   consistent). `{:index m}`, or `{:error e}` naming the first later tree, in\n   407\t   tree order and then canonical address order, whose row is\n   408\t   metadata-distinct from an earlier tree's row at the same address.\"\n   409\t  [indexes]\n   410\t  (reduce (fn [{:keys [index]} [j tree-index]]\n   411\t            (or (some (fn [a]\n   412\t                        (let [prior (get index a)]\n   413\t                          (when (and prior (not (same-value? prior (get tree-index a))))\n   414\t                            (reduced {:error (malformed :address-conflict\n   415\t                                                        :tree j :address a)}))))\n   416\t                      (sort-by name (keys tree-index)))\n   417\t                {:index (merge index tree-index)}))\n   418\t          {:index {}}\n   419\t          (map-indexed vector indexes)))\n   420\t\n   421\t\n   422\t(defn- admit\n   423\t  \"Admit one batch: `{:admitted {...}}` or `{:error error-data}`. The first\n   424\t   error is deterministic: batch shape, then trees by index, then\n   425\t   cross-tree address conflicts, then catalogue problems by ordinal, then\n   426\t   declarations in batch order.\"\n   427\t  [batch]\n   428\t  (if-not (batch-shape-ok? batch)\n   429\t    {:error (malformed :batch-shape)}\n   430\t    (let [[_ trees run-index decls harvest] batch]\n   431\t      (or\n   432\t        (some (fn [[j tree]]\n   433\t                (when-let [e (valid-tree? tree)]\n   434\t                  {:error (assoc e :tree j)}))\n   435\t              (map-indexed vector trees))\n   436\t        (let [indexes (mapv packet-index trees)\n   437\t              merged (merge-indexes indexes)\n   438\t              roots (mapv first trees)\n   439\t              catalogue-error (fn [h & kvs] {:error (apply malformed :harvest-catalogue :ordinal h kvs)})\n   440\t              entries\n   441\t              (reduce\n   442\t                (fn [acc [i [_ h j path]]]\n   443\t                  (let [a (when (and (integer? j) (< -1 j (count trees)))\n   444\t                            (resolve-path (nth indexes j) (nth roots j) path))\n   445\t                        d (when a (definition-at (nth indexes j) a))]\n   446\t                    (cond (not= i h) (reduced (catalogue-error h))\n   447\t                          (nil? d) (reduced (catalogue-error h :tree j :path path))\n   448\t                          (contains? (:seen acc) [j path])\n   449\t                          (reduced (catalogue-error h :tree j :path path))\n   450\t                          :else (-> acc\n   451\t                                    (update :seen conj [j path])\n   452\t                                    (update :entries conj\n   453\t                                            (assoc d :ordinal h, :tree j, :path path\n   454\t                                                   :address a))))))\n   455\t                {:seen #{}, :entries []}\n   456\t                (map-indexed vector harvest))]\n   457\t          (cond\n   458\t            (:error merged) merged\n   459\t\n   460\t            (:error entries) entries\n   461\t\n   462\t            :else\n   463\t            (let [{:keys [seen entries]} entries]\n   464\t              (or\n   465\t                (some (fn [j]\n   466\t                        (some (fn [p]\n   467\t                                (when-not (contains? seen [j p])\n   468\t                                  (catalogue-error nil :tree j :path p)))\n   469\t                              (definition-paths (nth indexes j) (nth roots j))))\n   470\t                      (range (count trees)))\n   471\t                (let [by-occurrence (into {} (map (fn [e] [[(:tree e) (:path e)] e])) entries)]\n   472\t                  (or\n   473\t                    (some (fn [[_ j path]]\n   474\t                            (let [e (get by-occurrence [j path])]\n   475\t                              (when-not (and e (= :lambda (row-tag (get (nth indexes j)\n   476\t                                                                        (:value e)))))\n   477\t                                {:error (malformed :stray-macro-declaration :tree j :path path)})))\n   478\t                          decls)\n   479\t                    (let [declared (set (map (fn [[_ j path]] [j path]) decls))]\n   480\t                      {:admitted\n   481\t                       {:trees trees,\n   482\t                        :indexes indexes,\n   483\t                        :index (:index merged),\n   484\t                        :run-index run-index,\n   485\t                        :definitions (mapv #(assoc % :declared?\n   486\t                                                   (contains? declared [(:tree %) (:path %)]))\n   487\t                                           entries)}})))))))))))\n   488\t\n   489\t\n   490\t(defn definitions\n   491\t  \"The ordered definition records of a batch, in harvest order:\n   492\t   `{:ordinal h :tree j :path p :address a :name sym :value v :declared? b}`.\n   493\t   Throws `ex-info` carrying the admission error when the batch is invalid.\"\n   494\t  [batch]\n   495\t  (let [{:keys [admitted error]} (admit batch)]\n   496\t    (when error\n   497\t      (throw (ex-info \"Invalid macro input batch\" error)))\n   498\t    (:definitions admitted)))\n   499\t\n   500\t\n   501\t;; =============================================================================\n   502\t;; Workspace: interning and immutable path rebuilding (§3.3)\n   503\t;; =============================================================================\n   504\t\n   505\t(defn- intern-body\n   506\t  \"Intern `body` into the working index: `[index' address]`. An address\n   507\t   already holding a different body is a defect of the encoder, not input.\"\n   508\t  [index body]\n   509\t  (let [row (intern-row body)\n   510\t        a (first row)\n   511\t        prior (get index a)]\n   512\t    (when (and prior (not (same-value? prior row)))\n   513\t      (throw (ex-info \"Working index address conflict\" {:address a})))\n   514\t    [(if prior index (assoc index a row)) a]))\n   515\t\n   516\t\n   517\t(defn- rebuild-paths\n   518\t  \"Replace the occurrences at every path in `replacements` (`{path address}`)\n   519\t   below `root`, interning each changed ancestor once: replacements below one\n   520\t   parent are combined before the parent is interned. Shallower replacements\n   521\t   subsume deeper ones, which is the result of applying them deepest path\n   522\t   first. Content sharing never merges occurrences: only the named paths'\n   523\t   ancestor chains change. Returns `[index' root']`.\"\n   524\t  [index root replacements]\n   525\t  (letfn [(go\n   526\t            [index a reps]\n   527\t            (if-let [[_ r] (find reps [])]\n   528\t              [index r]\n   529\t              (let [by-coord (group-by (comp first key) reps)\n   530\t                    row (get index a)\n   531\t                    [index row']\n   532\t                    (reduce (fn [[index row'] coord]\n   533\t                              (let [child (step-path row coord)\n   534\t                                    sub (into {} (map (fn [[p r]] [(subvec p 1) r]))\n   535\t                                              (get by-coord coord))\n   536\t                                    [index c'] (go index child sub)]\n   537\t                                [index (into [a] (with-child row' coord c'))]))\n   538\t                            [index row]\n   539\t                            ;; deterministic order; the result is order-free\n   540\t                            (sort-by pr-str (keys by-coord)))]\n   541\t                (if (= row' row)\n   542\t                  [index a]\n   543\t                  (intern-body index (subvec row' 1))))))]\n   544\t    (go index root replacements)))\n   545\t\n   546\t\n   547\t(defn- rebuild-row\n   548\t  \"Intern `row` with the children at `places` (a subsequence of its\n   549\t   `child-places`, all of them by default) replaced by `children'`, in\n   550\t   order; `[index address]`, unchanged when no child changed.\"\n   551\t  ([index row children'] (rebuild-row index row (child-places row) children'))\n   552\t  ([index row places children']\n   553\t   (if (= (map second places) children')\n   554\t     [index (first row)]\n   555\t     (intern-body index (subvec (reduce (fn [r [[coord _] c]]\n   556\t                                          (into [(first r)] (with-child r coord c)))\n   557\t                                        row\n   558\t                                        (map vector places children'))\n   559\t                                1)))))\n   560\t\n   561\t\n   562\t;; =============================================================================\n   563\t;; Bounded body runner and row-native prelude (§5)\n   564\t;; =============================================================================\n   565\t\n   566\t(defn- throw-prelude\n   567\t  [msg data]\n   568\t  (throw (ex-info msg (assoc data :yin.macro/prelude true))))\n   569\t\n   570\t\n   571\t(defn- packet?\n   572\t  [x]\n   573\t  (and (vector? x) (= 2 (count x)) (jing/segment-address? (first x))\n   574\t       (vector? (second x))))\n   575\t\n   576\t\n   577\t(defn- need-packet\n   578\t  [who x]\n   579\t  (when-not (packet? x)\n   580\t    (throw-prelude (str who \" expects a tree packet\") {:op who}))\n   581\t  x)\n   582\t\n   583\t\n   584\t(defn- merge-packets\n   585\t  \"Union the rows of `packets` into one index, verifying that one address\n   586\t   denotes one body (§5.3).\"\n   587\t  [packets]\n   588\t  (reduce (fn [index row]\n   589\t            (let [prior (get index (first row))]\n   590\t              (cond (nil? prior) (assoc index (first row) row)\n   591\t                    (same-value? prior row) index\n   592\t                    :else (throw-prelude \"Packet address conflict\"\n   593\t                                         {:address (first row)}))))\n   594\t          {}\n   595\t          (mapcat second packets)))\n   596\t\n   597\t\n   598\t(def ^:private pending-expansion-origin\n   599\t  \"The construction origin the prelude attaches to every node the\n   600\t   macro's code builds during one invocation (ruling U1: identity comes\n   601\t   from the construction event, never from comparing content\n   602\t   addresses). `expand-call` substitutes the recorded expansion event's\n   603\t   `[:expansion record-address]` origin for it when the output's\n   604\t   occurrence correspondence is read — the placeholder never reaches a\n   605\t   table, a row, or an event it does not belong to.\"\n   606\t  [:expansion ::pending])\n   607\t\n   608\t\n   609\t(defn- with-origin-of\n   610\t  \"Tag packet `p` with `f`, its construction origin function: `(f rel)`\n   611\t   answers the origin of the occurrence at `rel`, a path relative to\n   612\t   `p`'s root — the pending expansion origin for a node the macro's\n   613\t   code constructed, or, below a child coordinate that retains a\n   614\t   passed-through packet, that packet's own origin function. The\n   615\t   function rides the packet's metadata, so it is content-addressing\n   616\t   invisible and never leaks into a final tree.\"\n   617\t  [p f]\n   618\t  (vary-meta p assoc ::origin-of f))\n   619\t\n   620\t\n   621\t(defn- origin-of-fn\n   622\t  \"The construction origin function packet `p` carries, or nil.\"\n   623\t  [p]\n   624\t  (::origin-of (meta p)))\n   625\t\n   626\t\n   627\t(defn- constructed-origin-fn\n   628\t  \"The origin function of a packet the prelude constructed: its root\n   629\t   occurrence carries the pending expansion origin; a relative path\n   630\t   below a child coordinate delegates to the packet passed for that\n   631\t   child — a spliced operand retains its own incoming origin, however\n   632\t   the macro's code embedded it.\"\n   633\t  [coord-children]\n   634\t  (fn [rel]\n   635\t    (if (empty? rel)\n   636\t      pending-expansion-origin\n   637\t      (if-some [child (get coord-children (first rel))]\n   638\t        (if-some [f (origin-of-fn child)]\n   639\t          (f (subvec rel 1))\n   640\t          pending-expansion-origin)\n   641\t        pending-expansion-origin))))\n   642\t\n   643\t\n   644\t(defn- construct\n   645\t  \"Intern `body` over the rows of its child `packets`; a closed packet.\n   646\t   Every node interned here is CONSTRUCTED by the expansion's code\n   647\t   (ruling U1), so the result packet carries the construction origin\n   648\t   function and the output's per-occurrence origins are read from this\n   649\t   construction history — never inferred by comparing content\n   650\t   addresses: a constructed node whose content equals a retained\n   651\t   node's stays distinct, because its origin answers through this\n   652\t   function and not through its address.\"\n   653\t  [body packets]\n   654\t  (let [index (merge-packets packets)\n   655\t        [index a] (intern-body index body)\n   656\t        coord-children (into {}\n   657\t                             (map (fn [[place p]] [(first place) p]))\n   658\t                             (map vector (child-places (get index a)) packets))]\n   659\t    (with-origin-of (packet-of index a) (constructed-origin-fn coord-children))))\n   660\t\n   661\t\n   662\t(defn- root-row\n   663\t  [[root rows]]\n   664\t  (some #(when (= root (first %)) %) rows))\n   665\t\n   666\t\n   667\t(defn- literal-packet\n   668\t  [v]\n   669\t  (construct [:literal v] []))\n   670\t\n   671\t\n   672\t(defn- application-packet\n   673\t  [operator operands]\n   674\t  (construct [:application (first operator) (mapv first operands) false]\n   675\t             (cons operator operands)))\n   676\t\n   677\t\n   678\t(defn- lambda-packet\n   679\t  [params body]\n   680\t  (when-not (and (sequential? params) (every? symbol? params))\n   681\t    (throw-prelude \"yin/lambda params must be symbols\" {:op 'yin/lambda}))\n   682\t  (construct [:lambda (vec params) (first body)] [body]))\n   683\t\n   684\t\n   685\t(defn- name-of\n   686\t  [tree]\n   687\t  (let [row (root-row (need-packet 'yin/name-of tree))\n   688\t        v (nth row 2 nil)]\n   689\t    (cond (= :variable (row-tag row)) v\n   690\t          (and (= :literal (row-tag row)) (symbol? v)) v\n   691\t          (and (= :literal (row-tag row)) (string? v)) (symbol v)\n   692\t          :else (throw-prelude \"yin/name-of reads a variable, literal symbol, or literal string\"\n   693\t                               {:op 'yin/name-of}))))\n   694\t\n   695\t\n   696\t(defn- sequence-body\n   697\t  \"The reference `do` lowering: `(do a b c)` is `((fn [_] ((fn [_] c) b)) a)`;\n   698\t   one form is itself and none is the literal nil.\"\n   699\t  [trees]\n   700\t  (let [trees (vec trees)]\n   701\t    (doseq [t trees] (need-packet 'yin/sequence-body t))\n   702\t    (case (count trees)\n   703\t      0 (literal-packet nil)\n   704\t      1 (first trees)\n   705\t      (application-packet (lambda-packet ['_] (sequence-body (subvec trees 1)))\n   706\t                          [(first trees)]))))\n   707\t\n   708\t\n   709\t(defn- slot-of\n   710\t  [tree n]\n   711\t  (let [row (root-row (need-packet 'yin/slot tree))\n   712\t        kinds (into {} (slot-kinds (row-tag row)))\n   713\t        index (packet-index tree)\n   714\t        ;; an extracted slot is input syntax READ, not built: the\n   715\t        ;; extracted packet retains the source packet's construction\n   716\t        ;; origin function, descending through the slot's coordinate\n   717\t        ofn (or (origin-of-fn tree)\n   718\t                (fn [_] pending-expansion-origin))]\n   719\t    (when-not (and (integer? n) (contains? kinds n))\n   720\t      (throw-prelude \"yin/slot position names no grammar slot\"\n   721\t                     {:op 'yin/slot, :position n}))\n   722\t    (case (get kinds n)\n   723\t      :node (with-origin-of (packet-of index (nth row n))\n   724\t              (fn [rel] (ofn (into [n] rel))))\n   725\t      :nodes (map-indexed (fn [i c]\n   726\t                            (with-origin-of (packet-of index c)\n   727\t                              (fn [rel] (ofn (into [[n i]] rel)))))\n   728\t                          (nth row n))\n   729\t      (nth row n))))\n   730\t\n   731\t\n   732\t(defn prelude\n   733\t  \"The closed body environment (§5.3): the pure standard primitives (no\n   734\t   `require`, no stream or FFI constructor) and the row-native constructors,\n   735\t   each consuming and returning self-contained tree packets. `gensym` is the\n   736\t   invocation-local `yin/gensym-sym`.\"\n   737\t  [gensym]\n   738\t  (merge\n   739\t    (dissoc vm/primitives 'require 'try-require 'bytes->str)\n   740\t    {'yin/tag (fn [tree] (row-tag (root-row (need-packet 'yin/tag tree)))),\n   741\t     'yin/slot slot-of,\n   742\t     'yin/literal literal-packet,\n   743\t     'yin/variable (fn [sym]\n   744\t                     (when-not (symbol? sym)\n   745\t                       (throw-prelude \"yin/variable expects a symbol\" {:op 'yin/variable}))\n   746\t                     (construct [:variable sym] [])),\n   747\t     'yin/lambda (fn [params body] (lambda-packet params (need-packet 'yin/lambda body))),\n   748\t     'yin/application (fn [operator operands]\n   749\t                        (need-packet 'yin/application operator)\n   750\t                        (doseq [o operands] (need-packet 'yin/application o))\n   751\t                        (application-packet operator (vec operands))),\n   752\t     'yin/if (fn [t c a]\n   753\t               (doseq [x [t c a]] (need-packet 'yin/if x))\n   754\t               (construct [:if (first t) (first c) (first a)] [t c a])),\n   755\t     'yin/sequence-body sequence-body,\n   756\t     'yin/make-lambda (fn [params-tree body]\n   757\t                        (let [row (root-row (need-packet 'yin/make-lambda params-tree))]\n   758\t                          (when-not (and (= :literal (row-tag row))\n   759\t                                         (vector? (nth row 2))\n   760\t                                         (every? symbol? (nth row 2)))\n   761\t                            (throw-prelude \"yin/make-lambda reads a literal parameter vector\"\n   762\t                                           {:op 'yin/make-lambda}))\n   763\t                          (lambda-packet (nth row 2) (need-packet 'yin/make-lambda body)))),\n   764\t     'yin/make-def (fn [name-tree value-tree]\n   765\t                     (application-packet (construct [:variable 'yin/def] [])\n   766\t                                         [(literal-packet (name-of name-tree))\n   767\t                                          (need-packet 'yin/make-def value-tree)])),\n   768\t     'yin/name-of name-of,\n   769\t     'yin/gensym-sym gensym}))\n   770\t\n   771\t\n   772\t(def ^:private suspending-tags\n   773\t  #{:vm/park :vm/resume :dao.stream.apply/call})\n   774\t\n   775\t\n   776\t(def ^:private effect-tags\n   777\t  #{:stream/make :stream/put :stream/cursor :stream/next :stream/close})\n   778\t\n   779\t\n   780\t(defn- catch-message\n   781\t  [e]\n   782\t  (or (ex-message e) (str e)))\n   783\t\n   784\t\n   785\t(defn bounded-row-evaluator\n   786\t  \"The default body runner (§5.2): a fresh throwaway ast-walker loaded from\n   787\t   the lambda body's rows, its parameters bound in `env`, the closed\n   788\t   `prelude` as its only primitives, no store, no module resolver, no stream\n   789\t   constructor, and no FFI bridge. It counts VM transitions.\n   790\t\n   791\t   Returns `{:value v}`, or `{:error e}` with `e` one of\n   792\t   `{:kind :fuel-guard :steps n}`, `{:kind :suspended}` (a park, resume,\n   793\t   bridge call, blocked read, or work scheduled outside the body\n   794\t   continuation), `{:kind :effect-guard :tag t}` (a stream constructor), or\n   795\t   `{:kind :body-error :message s}` (the body threw).\n   796\t\n   797\t   `contract` is the packet's own AST stamp, carried from its store entry\n   798\t   by `invoke`, which has verified it; the body rows load under that stamp,\n   799\t   never one this runner supplies, and a missing or old stamp is refused\n   800\t   (thrown) before anything runs.\"\n","exit_code":0,"status":"completed"}}
