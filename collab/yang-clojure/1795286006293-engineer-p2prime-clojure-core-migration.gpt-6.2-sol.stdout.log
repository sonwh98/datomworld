mitive/+ +, dsg__primitive/<= <=})\nsrc/cljc/yin/repl.cljc:860:                                  (integer/register-integer-module\nsrc/cljc/yin/vm/integer.cljc:9:   `register-integer-module`, and Yin source reaches the exports as\nsrc/cljc/yin/vm/integer.cljc:112:  \"The module `register-integer-module` installs.\"\nsrc/cljc/yin/vm/integer.cljc:699:(defn register-integer-module\n                  (f (fn [v]\n                       (do (yrt.effect/abandon-to ctx-cell\n                             (yrt.effect/frame-depth (get saved :handlers)))\n                           (yrt.effect/restore! ctx-cell saved)\n                           (r v)))))\n              r))\n          (%capture))))]\n\n    [yrt.effect/handle\n     (fn [ctx-cell tag handler-fn body]\n       (let [saved (cell/get ctx-cell)\n             first? (cell/new true)]\n         ((fn [outer-k]\n            (if (cell/get first?)\n              (do (cell/set! first? false)\n                  (yrt.effect/set-handlers!\n                    ctx-cell (yrt.effect/frame :effect (conj [] tag handler-fn outer-k)\n                                               (get saved :handlers) (get saved :depth)))\n                  (let [v (body)] (do (yrt.effect/restore! ctx-cell saved) v)))\n              ;; perform transfers a thunk here so the handler runs in the\n              ;; exact context outside the matched delimiter.\n              (do (yrt.effect/restore! ctx-cell saved) (outer-k))))\n          (%capture))))]\n    [yrt.effect/_find-effect\n     (fn [hs tag]\n       (if (= hs nil)\n         nil\n         (if (if (= (data/nth hs 0) :effect)\n               (= (data/nth (data/nth hs 1) 0) tag)\n               false)\n           hs\n           (yrt.effect/_find-effect (data/nth hs 2) tag))))]\n    [yrt.effect/_dispatch\n     (fn [ctx-cell hs payload]\n       (let [saved (cell/get ctx-cell)\n             h (data/nth hs 1)\n             handler (data/nth h 1)\n             outer-k (data/nth h 2)\n             pending? (cell/new true)]\n         ((fn [k]\n            (if (cell/get pending?)\n              (outer-k\n                (fn []\n                  ;; The guard also runs if the handler raises or escapes.\n                  ;; Resuming bypasses it and reinstates the suspended frames.\n                  (let [outside (cell/get ctx-cell)]\n                    (yrt.effect/try-finally\n                      ctx-cell\n                      (fn []\n                        (handler payload\n                          (fn [v]\n                            (if (cell/get pending?)\n                              (do (cell/set! pending? false)\n                                  (yrt.effect/restore! ctx-cell saved)\n                                  (k v))\n                              (:yrt.effect/used-resumption v)))))\n                      (fn [e]\n                        (do (cell/set! pending? false)\n                            (yrt.effect/restore! ctx-cell saved)\n                            (yrt.effect/unwind-to ctx-cell\n                              (yrt.effect/frame-depth (get outside :handlers)) e)\n                            (yrt.effect/restore! ctx-cell outside)))\n                      nil))))\n              k))\n          (%capture))))]\n    [yrt.effect/perform\n     (fn [ctx-cell tag payload on-unhandled]\n       (let [hs (yrt.effect/_find-effect (yrt.effect/handlers ctx-cell) tag)]\n         (if (= hs nil)\n           (on-unhandled tag payload)\n           (yrt.effect/_dispatch ctx-cell hs payload))))]])\n\n\n(def module-exports\n  '#{ctx handlers set-handlers! restore! frame-depth frame pop-frame raise\n     try-value try-orelse try-finally unwind-to call-ec abandon-to call-terminal\n     handle perform})\n\n\n(def uast\n  (u/mark-tails (core/definitions->uast definitions)))\n\n\n(def module-uast\n(ns yang.rt.int\n  \"Guest adapters for exact-integer policy, wrapping, and radix scanning.\"\n  (:require [yang.core.prelude :as core]\n            [yang.core.prelude-admission :as prelude-admission]\n            [yang.core.uast :as u]\n            [yang.rt.effect :as effect]))\n\n\n(def module-name 'yrt.int)\n\n\n(def definitions\n  \"The ordered source for bundled and linked emission.\"\n  '[[yrt.int/check-limit-with\n     (fn [res on-bit on-digit on-float]\n       (if (= res :yin.vm.integer/bit-limit)\n         (on-bit res)\n         (if (= res :yin.vm.integer/digit-limit)\n           (on-digit res)\n           (if (= res :yin.vm.integer/float-overflow)\n             (on-float res)\n             res))))]\n    [yrt.int/_unhandled\n     (fn [tag payload] (:yrt.int/unhandled-policy tag payload))]\n    [yrt.int/check-limit\n     (fn [ctx-cell res]\n       (if (= res :yin.vm.integer/bit-limit)\n         (yrt.effect/perform ctx-cell :int/bit-limit res yrt.int/_unhandled)\n         (if (= res :yin.vm.integer/digit-limit)\n           (yrt.effect/perform ctx-cell :int/digit-limit res yrt.int/_unhandled)\n           (if (= res :yin.vm.integer/float-overflow)\n             (yrt.effect/perform ctx-cell :math/overflow res yrt.int/_unhandled)\n             res))))]\n    [yrt.int/wrap-unsigned\n     (fn [x width-pow2 mask]\n       (if (= mask nil)\n         (let [qr (integer/floor-div-mod x width-pow2)]\n           (if (= qr :yin.vm.integer/bit-limit) qr (data/nth qr 1)))\n         (integer/bit-and x mask)))]\n    [yrt.int/wrap-signed\n     (fn [x half-range range]\n       (let [r (yrt.int/wrap-unsigned x range nil)]\n         (if (= r :yin.vm.integer/bit-limit)\n           r\n           (if (<= 0 (integer/compare r half-range)) (integer/sub r range) r))))]\n    [yrt.int/in-range?\n     (fn [x min-v max-v]\n       (if (<= 0 (integer/compare x min-v))\n         (<= (integer/compare x max-v) 0)\n         false))]\n    [yrt.int/digit-value\n     (fn [cp]\n       (if (if (<= 48 cp) (<= cp 57) false)\n         (- cp 48)\n         (if (if (<= 65 cp) (<= cp 90) false)\n           (- cp 55)\n           (if (if (<= 97 cp) (<= cp 122) false)\n             (- cp 87)\n             -1))))]\n    [yrt.int/_digit?\n     (fn [d radix] (if (<= 0 d) (< d radix) false))]\n    [yrt.int/all-digits?\n     (fn [cs i n radix]\n       (if (< i n)\n         (if (yrt.int/_digit? (yrt.int/digit-value (data/nth cs i)) radix)\n           (yrt.int/all-digits? cs (+ i 1) n radix)\n           false)\n         true))]\n    [yrt.int/scan-digits\n     ;; Accumulate the valid prefix and propagate a limit before using its\n     ;; keyword as an integer operand.\n     (fn [cs i n radix acc]\n       (if (= acc :yin.vm.integer/bit-limit)\n         acc\n         (if (< i n)\n           (let [d (yrt.int/digit-value (data/nth cs i))]\n             (if (yrt.int/_digit? d radix)\n               (let [scaled (integer/mul acc radix)]\n                 (if (= scaled :yin.vm.integer/bit-limit)\n                   scaled\n                   (yrt.int/scan-digits cs (+ i 1) n radix (integer/add scaled d))))\n               acc))\n           acc)))]\n    [yrt.int/skip-while\n     (fn [cs i n pred?]\n(def ^:private exports\n  \"`[name arities kernel]` of every export. Each kernel takes the\n   composition's limits first.\"\n  [['integer? [1] int-integer?]\n   ['normalize [1] int-normalize]\n   ['add [2] int-add]\n   ['sub [2] int-sub]\n   ['neg [1] int-neg]\n   ['mul [2] int-mul]\n   ['compare [2] int-compare]\n   ['quot-rem [2] int-quot-rem]\n   ['floor-div-mod [2] int-floor-div-mod]\n   ['pow [2] int-pow]\n   ['bit-and [2] int-bit-and]\n   ['bit-or [2] int-bit-or]\n   ['bit-xor [2] int-bit-xor]\n   ['bit-not [1] int-bit-not]\n   ['shift-left [2] int-shift-left]\n   ['shift-right [2] int-shift-right]\n   ['bit-length [1] int-bit-length]\n   ['parse [1 2] int-parse]\n   ['format [1 2] int-format]\n   ['to-float [1] int-to-float]\n   ['to-float-boxed [1] int-to-float-boxed]\n   ['true-div-boxed [2] int-true-div-boxed]\n   ['from-float-boxed [1] int-from-float-boxed]\n   ['compare-float [2] int-compare-float]\n   ['compare-float-boxed [2] int-compare-float-boxed]\n   ['true-div [2] int-true-div]\n   ['from-float [1] int-from-float]\n   ['float-digits [1] int-float-digits]\n   ['decimal->float [2] int-decimal->float]\n   ['max-digits [0] int-max-digits]])\n\n\n(defn- arity-checked\n","exit_code":0,"status":"completed"}}
