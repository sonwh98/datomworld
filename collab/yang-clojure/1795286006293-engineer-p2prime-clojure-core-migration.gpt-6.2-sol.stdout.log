  (run-outcome '[(defn f\n                            [x]\n                            (+ x 1))\n                          (let [get 5 assoc 6 = 7 empty? 8]\n                            (f 41))])))\n    (reset! effect-log [])\n    (is (= [[:yin.k/error {:yin.k/message \"boom\", :yin.k/data {}}] [:a]]\n           [(run-outcome '[(defn boom\n                             []\n                             (throw (ex-info \"boom\" {})))\n                           (defn f\n                             [x y z]\n                             (+ x z))\n                           (f (probe/note :a) (boom) (probe/note :b))])\n            @effect-log]))))\n\n(defn- host-integer?\n  \"True for an exact integer in any host carrier, and on JavaScript also\n   for an integral Number beyond +/-(2^53 - 1), which is integer content\n   whose value is already rounded (callers refuse it); never a JS -0.\"\n  [x]\n  (or (integer/exact-integer? x)\n      #?(:cljs (and (number? x) (js/Number.isInteger x)\n                    (not (js/Number.isSafeInteger x)))\n         :default false)))\n\n\n(defn float64?\n  \"True for floating-point content: Double or Float on the JVM, the\n   Float64 carrier or a non-integral, non-finite or negative-zero number\n   on JavaScript, a double on Dart.\"\n  [x]\n  #?(:cljd (dart/is? x double)\n     :clj (or (instance? Double x) (instance? Float x))\n     :cljs (or (instance? number/Float64 x)\n               (and (number? x) (not (host-integer? x))))))\n(def uast\n  (u/mark-tails (core/definitions->uast definitions)))\n\n\n(def module-uast\n  (u/annotate-call-sites\n    (core/module-tree (core/module-definitions \"yrt.int\" nil [] definitions)\n                      (mapv u/sexp->uast '[(require 'yrt.effect)]))))\n\n\n(def ^:private module-free-names (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  [registry effect-address]\n  (prelude-admission/module-spec\n    {:module-name module-name\n     :ast module-uast\n     :exports module-exports\n     :r