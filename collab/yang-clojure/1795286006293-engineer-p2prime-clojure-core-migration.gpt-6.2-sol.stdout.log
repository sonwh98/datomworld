{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"sed -n '70,110p;164,207p' test/yang/call/conformance.clj; cat test/yang/clojure/donor_link_test.clj; sed -n '170,245p' test/yang/rt/effect_test.cljc; rg -n -i 'golden.*clojure|clojure.*golden' bin test/yang test/resources .gitignore bb.edn | head -90\"","aggregated_output":"(def ^:private published-py\n  \"`py` published beside `js` and `php`, over the same host registry and\n   `yang.call` revision.\"\n  (delay (publish-guest!\n           (py-prelude/module-spec (h/registry)\n                                   (:call-address @h/published)))))\n\n\n(def ^:private published-effect\n  (delay (publish-guest! (effect/module-spec (h/registry)))))\n\n\n(def ^:private published-clj\n  \"`clj` published beside `js`, `php` and `py`, over the same host registry\n   and `yang.call` revision.\"\n  (delay (publish-guest!\n           (clj-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)\n                                    (:address @published-effect)))))\n\n\n(defn- parse-ok\n  \"The CST packet of `source` under `parse`, refused unless the parse is ok.\"\n  [parse source]\n  (let [pk (parse source)]\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\n      (throw (ex-info \"donor or caller source does not parse\"\n                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\n    pk))\n\n\n(defn- python-export-symbol\n  [export]\n  (symbol (str \"xlang.python.export.\" export)))\n\n\n(defn- python-unit\n  [packet exports]\n  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\n         (u/seq-nodes\n           (concat (map (fn [export]\n                   (list 'py/global-get\n                         (list 'py/module-dict\n                               (list 'py/modules-ref {:py/str \"__main__\"}))\n                         {:py/str export})),\n    :project (fn [name value]\n               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\n    :render py-render/output},\n   :clojure\n   {:runtime 'clj,\n    :address #(:address @published-clj),\n    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\n    :deps (fn [] {'yang.call (:call-address @h/published)}),\n    :parse clj-comp/read-forms,\n    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\n    :run-main 'clj/run-main,\n    :read-export (fn [export] (list 'clj/global-get export)),\n    :project (fn [name value]\n               ;; The runtime global namespace is the one binding (as\n               ;; `js/define-global!` is for a JS caller): `lower-unit`\n               ;; reads each projected name through `clj/global-get`, so\n               ;; no task-store binding duplicates it. A caller top-level\n               ;; definition of the same name publishes after the\n               ;; projection and shadows it.\n               (list 'clj/define-global! name value)),\n    :render clj-comp/output}})\n\n\n(defn- profile\n  [frontend]\n  (or (get frontends frontend)\n      (throw (ex-info \"frontend not admitted\" {:frontend frontend}))))\n\n\n(defn- modules\n  \"The host registry, admitted by every runtime profile that checks it,\n   with the clojure guest library's host surface installed beside them.\n   Donor publication declares free names over this same registry, so a\n   clojure donor using the guest library (its `kind` and `portable`\n   hosts) publishes like it runs.\"\n  []\n  (clj-prelude/admit (php-prelude/admit (h/registry))))\n\n\n(defn- claims-call-sites?\n(ns yang.clojure.donor-link-test\n  (:require [clojure.test :refer [deftest is]]\n            [yang.clojure :as clj]\n            [yang.clojure.prelude :as prelude]\n            [yang.core.module :as module]\n            [yang.core.prelude :as core]\n            [yang.core.uast :as u]\n            [yang.rt.effect :as effect]\n            [yang.typescript.antlr.linked-harness :as h]\n            [yin.vm :as vm]\n            [yin.vm.linker.interpreter :as link]))\n\n\n(deftest linked-donor-uses-runtime-context\n  (let [{:keys [store call-address]} @h/published\n        registry (prelude/admit (h/registry))\n        effect-address (:address (h/publish-guest-module! (effect/module-spec registry)))\n        runtime (h/publish-guest-module! (prelude/module-spec registry call-address effect-address))\n        unit (clj/lower-unit '[(defn f [x] (try (throw x) (catch Exception e e)))\n                               (f 42)])\n        ast (u/annotate-call-sites\n              (module/module-tree [(module/require-node 'clj) (u/def! 'body unit)]))\n        spec (module/module-spec :test/refusal :test/undeclared registry\n                                 {:name 'test.clj-donor :ast ast :exports '#{body}\n                                  :runtime-name 'clj :runtime-address (:address runtime)\n                                  :deps {'yang.call call-address}})\n        donor (h/publish-guest-module! spec)\n        caller-ast (u/annotate-call-sites\n                     (module/module-tree\n                       [(module/require-node 'clj)\n                        (module/require-node 'test.clj-donor)\n                        (u/def! 'run (u/sexp->uast\n                                       '(fn [] (clj/run-main test.clj-donor/body))))]))\n        caller (h/publish-guest-module!\n                 (module/module-spec :test/refusal :test/undeclared registry\n                                     {:name 'test.caller :ast caller-ast :exports '#{run}\n                                      :runtime-name 'clj :runtime-address (:address runtime)\n                                      :deps {'test.clj-donor (:address donor)}}))\n        source (link/composition\n                 {:content-store store :derivation :trusted\n                  :name-env {'clj (:address runtime) 'yang.call call-address\n                             'yrt.effect effect-address\n                             'test.clj-donor (:address donor) 'test.caller (:address caller)}})\n        program (u/sexp->uast '(do (require 'test.caller) (test.caller/run)))]\n    (is (contains? prelude/module-exports 'rt-ctx))\n    (is (some? (:address donor)) (pr-str donor))\n    (is (some? (:address caller)) (pr-str caller))\n    (is (not (contains? (core/free-names unit) 'clj.rt/ctx)))\n    (is (contains? (core/free-names unit) 'clj/run-unit))\n    (doseq [backend [:semantic :stack :register]]\n      (is (= 42 (vm/value (h/run-linked backend program {:modules registry :link-source source})))\n          (str backend)))))\n                [:digit :yin.vm.integer/digit-limit]\n                [:float :yin.vm.integer/float-overflow]\n                :digit 255 255 -1 true true false 255 2]\n               (run-runtime backend bundled? form)))\n        (is (= :zero-division\n               (try\n                 (run-runtime backend bundled?\n                   '(let [ctx (cell/new (yrt.effect/ctx nil 0 0 nil))]\n                      (yrt.effect/try-value ctx\n                        (fn [] (yrt.int/check-limit ctx (integer/floor-div-mod 1 0)))\n                        (fn [error] :caught))))\n                 (catch #?(:cljd Object :clj Exception :cljs :default) e\n                   (::integer/reason (ex-data e))))))))))\n\n\n(deftest clojure-runtime-parity\n  (let [forms '[(defn get [m k] :shadowed)\n                (defn + [a b] :shadowed-add)\n                (defn <= [a b] :shadowed-lte)\n                (defn assoc [m k v] :shadowed-assoc)\n                (defn f [x]\n                  (try (throw x)\n                       (finally (cell/set! log (conj (cell/get log) :cleanup)))))\n                (def log (cell/new []))\n                [(get nil :missing) (+ 1 2) (<= 1 2) (assoc {} :k 1)\n                 (try (f 42) (catch Exception e e)) (cell/get log)\n                 (do (cell/set! f {})\n                     (try (f 43) (catch Exception e :refused)))]]\n        opts (dissoc clj/unit-opts :linked-runtime)\n        expected [:shadowed :shadowed-add :shadowed-lte :shadowed-assoc 42 [:cleanup] :refused]\n        bundled (clj/compile-program forms true opts)\n        linked (u/then (u/sexp->uast '(require 'clj))\n                       (u/app (u/v 'clj/run-main) (clj/lower-unit forms)))]\n    (doseq [backend (keys h/backends)]\n      (let [run #(vm/value (h/run-linked backend % {:modules registry :link-source @published}))]\n        (is (= [:yin.k/ok expected] (run bundled)) (str backend))\n        (is (= expected (run linked)) (str backend))))))\n\n\n(def ^:private depth-fixture\n  '(do (require 'clj)\n       (let [ctx (do (clj/init!) (clj/rt-ctx))\n             base-frame (yrt.effect/frame :boundary nil nil 9)\n             top (yrt.effect/frame :effect nil base-frame 17)]\n         (do (cell/set! ctx (yrt.effect/ctx top 99 31 :activation))\n             (yrt.effect/pop-frame ctx top)\n             (let [depth (get (cell/get ctx) :depth)]\n               (do (yrt.effect/restore! ctx (yrt.effect/ctx base-frame 9 1 :restored))\n                   (conj [] (data/nth top 4) (yrt.effect/frame-depth top) depth\n                         (get (cell/get ctx) :depth) (get (cell/get ctx) :base)\n                         (get (cell/get ctx) :frame))))))))\n\n\n(deftest clojure-depth-and-live-base\n  (doseq [backend (keys h/backends)]\n    (is (= [17 2 17 9 31 :restored]\n           (vm/value (h/run-linked backend (u/sexp->uast depth-fixture)\n                                   {:modules registry :link-source @published})))\n        (str backend))))\n\n\n(deftest concurrent-clojure-contexts\n  (doseq [backend (keys h/backends)]\n    (let [task (fn [value]\n                 (let [pair (link/make-pair)\n                       ast (u/sexp->uast\n                             (list 'do (list 'require (list 'quote 'clj))\n                                   (list 'clj/run-main\n                                         (list 'fn []\n                                               (list 'clj/try\n                                                     (list 'fn [] (list 'clj/throw value))\n                                                     (list 'fn ['e] 'e))))))]\n                   [((get h/backends backend) ast (h/composition registry pair)) pair]))\n          tick (fn [[machine pair]]\n                 (let [machine (if (vm/halted? machine) machine (vm/step machine))\n                       pair (if (vm/blocked? machine)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '82,159p' src/cljc/yang/core/uast.cljc; sed -n '105,149p' src/cljc/yin/vm/engine.cljc; sed -n '1,115p' src/cljc/yin/repl/frontends.cljc; sed -n '185,238p' src/cljc/yin/vm/data.cljc; sed -n '1,125p' test/yang/rt/effect_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '82,159p' src/cljc/yang/core/uast.cljc; sed -n '105,149p' src/cljc/yin/vm/engine.cljc; sed -n '1,115p' src/cljc/yin/repl/frontends.cljc; sed -n '185,238p' src/cljc/yin/vm/data.cljc; sed -n '1,125p' test/yang/rt/effect_test.cljc\"","aggregated_output":"(defn sexp->uast\n  [form]\n  (cond\n    (symbol? form) (v form)\n    (seq? form)\n    (let [[head & args] form]\n      (case head\n        fn (lam (first args) (sexp->uast (second args)))\n        if (if-node (sexp->uast (first args))\n                    (sexp->uast (second args))\n                    (sexp->uast (nth args 2)))\n        do (seq-nodes (map sexp->uast args))\n        let (let [[bindings body] args]\n              (reduce (fn [inner [sym value]]\n                        (let1 sym (sexp->uast value) inner))\n                      (sexp->uast body)\n                      (reverse (partition 2 bindings))))\n        quote (lit (first args))\n        %capture capture\n        (apply app (sexp->uast head) (map sexp->uast args))))\n    :else (lit form)))\n\n\n(def mark-tails\n  \"`yang.tails/mark-tails`: the lowering marks its tree with the same\n   function a rewriting stage recomputes the marks with.\"\n  tails/mark-tails)\n\n\n;; =============================================================================\n;; Call-site occurrence contract C1 (Addendum A, design §2)\n;; =============================================================================\n;;\n;; Every final `:application` occurrence of a produced tree carries the\n;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n;; from canonical rows and emits it into the frontend-metadata side table\n;; as `[origin root-address path :yang/call-site 1]`, where the first\n;; three coordinates are the site id. The key carries no callee identity,\n;; source arity, or ambient classification. It is distinct from\n;; `:yang/site`, the safepoint mark, which travels as node metadata.\n;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n;; continuation nodes) are not `:application` nodes and are never marked.\n;; The walk lives here, beside the other shared tree transforms, so every\n;; frontend's module trees finalize the same way; `yang.clojure` owns the\n;; contract's validation over canonical rows.\n\n(defn annotate-call-sites\n  \"The finished map AST `node` with `:yang/call-site 1` on every\n   `:application` node, at every depth the row grammar knows. Literal\n   payloads are data, never syntax, and are not walked. Marking is\n   idempotent and preserves node metadata and every other key, so\n   canonical rows, roots, and executable outcomes are unchanged.\"\n  [node]\n  (let [tag (:type node)\n        slots (get vm/semantic-bytecode-grammar tag)]\n    (when-not slots\n      (throw (ex-info \"Unknown AST node type\" {:type tag, :node node})))\n    (let [walked (reduce (fn [n [field kind]]\n                           (case kind\n                             :node (update n field annotate-call-sites)\n                             :nodes (update n field\n                                            (fn [children]\n                                              (mapv annotate-call-sites\n                                                    children)))\n                             n))\n                         node\n                         slots)]\n      (cond-> walked\n        (= :application tag) (assoc :yang/call-site 1)))))\n(defn continuation-argument\n  \"The one value a captured continuation is applied to. Applying a\n   continuation is abortive: the current continuation is discarded and\n   the argument becomes the value of the capture point. Every VM refuses\n   any other arity with this same message.\"\n  [args]\n  (when-not (= 1 (count args))\n    (throw (ex-info \"Continuation expects exactly one argument\"\n                    {:reason :continuation-arity, :argc (count args)})))\n  (first args))\n\n\n(def ^:private compiler-primitives\n  '{dsg__primitive/get get, dsg__primitive/assoc assoc\n    dsg__primitive/+ +, dsg__primitive/<= <=})\n\n\n(defn resolve-var\n  \"Look up a variable name: env -> store -> primitives -> module registry.\n\n   A reserved name (Rule R: yin/def is syntax, never a name) is refused\n   before env or store is consulted. Compiler-private primitive aliases\n   resolve directly to their primitive entries so a portable guest closure\n   can call one after an ordinary guest definition shadows its bare name.\"\n  [env store primitives registry name]\n  (when (vm/reserved-name? name)\n    (vm/refuse-reserved! :variable name))\n  (if-let [primitive (get compiler-primitives name)]\n    (vm/primitive-function (get primitives primitive))\n    (if-let [pair (find env name)]\n      (val pair)\n      (if-let [pair (find store name)]\n        (val pair)\n        (if-let [pair (find primitives name)]\n          (vm/primitive-function (val pair))\n          (if-let [resolved (when (namespace name)\n                              (module/resolve-module\n                                registry\n                                (symbol (str (namespace name)\n                                             \".\"\n                                             (clojure.core/name name)))))]\n            resolved\n            (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n                  {:symbol name})))))))\n\n(ns yin.repl.frontends\n  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n   8.5.6, slice F2): the hand-written Clojure frontend and the ANTLR PHP and\n   Python frontends installed into a `yang.frontend` catalog. This is\n   the only place the REPL composition names a language's namespace;\n   `yin.repl` core steps whatever binding the catalog selects.\n\n   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n   `:input :forms` when the frontend consumes the forms the shell reader\n   already read, else the source text.\"\n  (:require\n    [yang.clojure :as yang.clojure]\n    [yang.frontend :as frontend]\n    #?@(:cljd []\n        :jolt []\n        :default [[yang.php.antlr.cst :as php.antlr.cst]\n                  [yang.php.antlr.lower :as php.antlr.lower]])\n    #?@(:cljd [[yang.python.antlr.repl :as python.antlr.repl]\n               [yang.python.antlr.parser :as python.antlr.parser]\n               [yang.python.antlr.repl-probe :as python.antlr.probe]]\n        :default [[yang.python.antlr.repl :as python.antlr.repl]\n                  [yang.python.antlr.parser :as python.antlr.parser]\n                  [yang.python.antlr.repl-probe :as python.antlr.probe]])\n    [yin.repl :as repl]))\n\n\n(defn- manifest\n  [id language]\n  {:yang.frontend/id id,\n   :yang.frontend/spi 1,\n   :yang.frontend/revision \"legacy-1\",\n   :yang.frontend/language language,\n   :yang.frontend/grammar {:yang.grammar/package \"none\",\n                           :yang.grammar/entries {:module \"program\"},\n                           :yang.grammar/export-profile :yang.cst/v1},\n   :yang.frontend/options-schema :segment/none,\n   :yang.frontend/lowering-profile :segment/legacy,\n   :yang.frontend/runtime-profile :segment/legacy,\n   :yang.frontend/support-profile :segment/legacy})\n\n\n(defn clojure-manifest\n  \"The Clojure frontend's manifest. Its coverage promise changed under\n   the call-site occurrence contract C1 — every final `:application`\n   occurrence carries `:yang/call-site` in the frontend-metadata side\n   table, finalized over the post-expansion tree that executes and\n   retained beside a published module's manifest — and that promise is\n   a support claim, so the revision and the support profile name it.\n   Revision c1-2 additionally declares the constructed-collections\n   lowering profile: a dynamically constructed map or set literal now\n   orders its constructor operands by compiled content\n   (:yang.clojure/constructed-collections-v1), a one-time canonical\n   shift for affected newly compiled artifacts; the C1 support claim,\n   the C1 marker value and the execution grammar versions are\n   unchanged.\"\n  []\n  (assoc (manifest :yang/clojure :clojure)\n         :yang.frontend/revision \"c1-2\"\n         :yang.frontend/lowering-profile :yang.clojure/constructed-collections-v1\n         :yang.frontend/support-profile :yang.clojure/c1))\n\n\n(defn- clojure-lower\n  [forms]\n  (if (= 1 (count forms))\n    (yang.clojure/compile (first forms))\n    (yang.clojure/compile-program forms)))\n\n\n(defn- antlr-manifest\n  []\n  (assoc (manifest :yang/python :python)\n         :yang.frontend/revision \"f4\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"python3\",\n          :yang.grammar/entries {:module \"file_input\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript :dart}}))\n\n\n(defn php-manifest\n  []\n  (assoc (manifest :yang/php :php)\n         :yang.frontend/revision \"antlr-p8\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"php\",\n          :yang.grammar/entries {:module \"htmlDocument\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript}}\n         :yang.frontend/lowering-profile :yang.php/antlr\n         :yang.frontend/runtime-profile :yang.php/antlr\n         :yang.frontend/support-profile :yang.php/antlr))\n\n\n(defn standard\n  \"The standard catalog. The Clojure frontend consumes the forms the\n   shell's own reader read, so its parse stage is the identity. The ANTLR\n   frontends show what a submission printed and the value their `:render`\n   returns.\"\n  []\n  (cond-> frontend/empty-catalog\n    true (frontend/install (clojure-manifest)\n                           {:input :forms,\n                            :parse identity,\n                            :lower clojure-lower})\n    #?@(:cljd []\n        :jolt []\n        :default [true (frontend/install\n                         (php-manifest)\n                         {:parse php.antlr.cst/parse-source,\n                          :lower php.antlr.lower/lower-packet,\n                          :render :php/out})])\n    #?@(:cljd [true (frontend/install\n                      (antlr-manifest)\n                      {:parse (fn [source]\n    (nth v i)))\n\n\n(defn- data-contains?\n  [coll k]\n  (cond\n    (or (nil? coll) (map? coll) (set? coll)) (contains? coll (key/normalize k))\n    (vector? coll) (let [i (integral k)]\n                     (boolean (and i (< -1 i (count coll)))))\n    :else (wrong-type! 'contains? 0 :map-set-or-vector)))\n\n\n(defn- data-dissoc\n  [m & ks]\n  (if (or (nil? m) (map? m))\n    (apply dissoc m (map key/normalize ks))\n    (wrong-type! 'dissoc 0 :map)))\n\n\n(defn- data-disj\n  [s & ks]\n  (if (or (nil? s) (set? s))\n    (apply disj s (map key/normalize ks))\n    (wrong-type! 'disj 0 :set)))\n\n\n(defn- data-peek\n  [v]\n  (if (or (nil? v) (vector? v))\n    (peek v)\n    (wrong-type! 'peek 0 :vector)))\n\n\n(defn- data-pop\n  [v]\n  (cond\n    (nil? v) nil\n    (not (vector? v)) (wrong-type! 'pop 0 :vector)\n    :else (let [last-index (dec (count v))]\n            (in-range! 'pop last-index 0 last-index)\n            (pop v))))\n\n\n(defn- data-subvec\n  ([v start] (data-subvec v start (if (vector? v) (count v) 0)))\n  ([v start end]\n   (vector! 'subvec 0 v)\n   (let [start (index! 'subvec 1 start)\n         end (index! 'subvec 2 end)]\n     (in-range! 'subvec end 0 (count v))\n     (in-range! 'subvec start 0 end)\n     (into [] (subvec v start end)))))\n\n\n(ns yang.rt.effect-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing.mem :as mem]\n            [yang.clojure :as clj]\n            [yang.clojure.prelude :as prelude]\n            [yang.core.call :as call]\n            [yang.core.uast :as u]\n            [yang.rt.effect :as effect]\n            [yang.rt.int :as int-rt]\n            [yang.typescript.antlr.linked-harness :as h]\n            [yin.vm :as vm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]))\n\n\n(def ^:private registry (prelude/admit (h/registry)))\n\n(def ^:private published\n  (delay\n    (let [store (mem/create-content-mem)\n          install (fn [spec]\n                    (let [result (publish/publish-module! store spec)]\n                      (or (:address result)\n                          (throw (ex-info \"Publication refused\" result)))))\n          call-address (install (call/module-spec registry))\n          effect-address (install (effect/module-spec registry))\n          int-address (install (int-rt/module-spec registry effect-address))\n          clj-address (install (prelude/module-spec registry call-address effect-address))]\n      (link/composition\n        {:content-store store\n         :derivation :trusted\n         :name-env {'yang.call call-address 'yrt.effect effect-address\n                    'yrt.int int-address 'clj clj-address}}))))\n\n\n(defn- run-runtime [backend bundled? form]\n  (let [body (u/sexp->uast form)]\n    (vm/value\n      (h/run-linked backend\n        (if bundled?\n          (u/mark-tails (u/seq-nodes [effect/uast int-rt/uast body]))\n          (u/then (u/sexp->uast '(require 'yrt.int)) body))\n        {:modules registry :link-source @published}))))\n\n\n(deftest abortive-control\n  (let [form\n        '(let [ctx (cell/new (yrt.effect/ctx nil 0 0 nil))\n               log (cell/new [])\n               note (fn [v] (cell/set! log (conj (cell/get log) v)))\n               on-empty (fn [e] (conj [] :empty e))\n               normal (yrt.effect/try-value ctx (fn [] :normal) note)\n               orelse (yrt.effect/try-orelse ctx (fn [] :ignored)\n                        note (fn [] :orelse))\n               raised (yrt.effect/try-value ctx\n                        (fn []\n                          (yrt.effect/try-finally ctx\n                            (fn []\n                              (yrt.effect/handle ctx :unrelated\n                                (fn [payload k] (note :unexpected-handler))\n                                (fn []\n                                  (yrt.effect/try-finally ctx\n                                    (fn [] (yrt.effect/raise ctx :boom on-empty))\n                                    (fn [e] (note (conj [] :inner e)))\n                                    :inner-normal))))\n                            (fn [e] (note (conj [] :outer e)))\n                            :outer-normal))\n                        (fn [e] (conj [] :caught e)))\n               normal-finally (yrt.effect/try-finally ctx\n                                (fn [] 3) note :finally-normal)\n               ec (yrt.effect/call-ec ctx\n                    (fn [exit]\n                      (yrt.effect/try-finally ctx (fn [] (exit 4)) note :unused))\n                    :escape)\n               terminal (yrt.effect/call-terminal ctx\n                          (fn [exit]\n                            (yrt.effect/try-finally ctx (fn [] (exit 5)) note :unused)))]\n           (conj [] normal orelse raised normal-finally ec terminal\n                 (cell/get log) (yrt.effect/handlers ctx)\n                 (yrt.effect/raise ctx :root on-empty)))]\n    (doseq [backend (keys h/backends), bundled? [true false]]\n      (testing (str backend \" bundled=\" bundled?)\n        (is (= [:normal :orelse [:caught :boom] 3 4 5\n                [[:inner :boom] [:outer :boom] :finally-normal :escape]\n                nil [:empty :root]]\n               (run-runtime backend bundled? form)))))))\n\n\n(deftest resumable-control\n  (let [form\n        '(let [ctx (cell/new (yrt.effect/ctx nil 0 0 nil))\n               log (cell/new [])\n               note (fn [v] (cell/set! log (conj (cell/get log) v)))\n               unhandled (fn [tag payload] (conj [] tag payload))\n               resumed (yrt.effect/handle ctx :test\n                         (fn [payload k] (do (note :resume-handler) (k (+ 2 payload))))\n                         (fn []\n                           (yrt.effect/try-finally ctx\n                             (fn []\n                               (let [v (yrt.effect/perform ctx :test 10 unhandled)]\n                                 (do (note :resumed) (+ 1 v))))\n                             note :resume-cleanup)))\n               aborted (yrt.effect/handle ctx :test\n                         (fn [payload k] (do (note :abort-handler) payload))\n                         (fn []\n                           (yrt.effect/try-finally ctx\n                             (fn []\n                               (yrt.effect/handle ctx :unrelated\n                                 (fn [payload k] (note :unexpected-handler))\n                                 (fn []\n                                   (do (yrt.effect/perform ctx :test :aborted unhandled)\n                                       (note :unreachable)))))\n                             (fn [e] (note :abort-cleanup))\n                             :unused)))\n               thrown (yrt.effect/try-value ctx\n                        (fn []\n                          (yrt.effect/handle ctx :test\n                            (fn [payload k] (yrt.effect/raise ctx payload (fn [e] :unexpected)))\n                            (fn []\n                              (yrt.effect/try-finally ctx\n                                (fn [] (yrt.effect/perform ctx :test :handler-error unhandled))\n                                note :unused))))\n                        (fn [e] e))]\n           (conj [] resumed aborted thrown (cell/get log) (yrt.effect/handlers ctx)\n","exit_code":0,"status":"completed"}}
