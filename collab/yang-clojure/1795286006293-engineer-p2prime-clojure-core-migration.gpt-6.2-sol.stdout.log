{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/core/prelude.cljc; sed -n '538,623p' src/cljc/yin/vm/data.cljc; rg -n 'effect/handle|defn.*admit|register.*integer|register.*float' src/cljc/yang/{rt,core} src/cljc/yin/vm* | head -70\"","aggregated_output":"(ns yang.core.prelude\n  \"Emitter machinery shared by every language's runtime-profile prelude\n   (docs/design/yang.typescript.md §17, lift L1). A language supplies its\n   module's own namespace string, its uninit sentinel, its definition list\n   and its refusal namespace; everything here is a pure function of those.\"\n  (:require\n    [clojure.walk :as walk]\n    [yang.core.uast :as u]))\n\n\n(defn define\n  \"`(yin/def (quote key) form)` in prelude notation: the key quoted, so\n   `sexp->uast` reads it as the literal symbol Rule R requires.\"\n  [key form]\n  (list 'yin/def (list 'quote key) form))\n\n\n(defn strip\n  \"`sym` without the module's own namespace `ns-str`; any other value as it\n   is. Qualified internal store keys stay qualified.\"\n  [ns-str sym]\n  (if (and (symbol? sym) (= ns-str (namespace sym)))\n    (symbol (name sym))\n    sym))\n\n\n(defn- strip-form\n  \"A prelude-notation form with every symbol `strip`ped: references,\n   definition keys and quoted keys alike. Keywords, strings and the\n   keys of literal maps are untouched.\"\n  [ns-str form]\n  (walk/postwalk (partial strip ns-str) form))\n\n\n(defn- placeholder\n  \"The `[k uninit]` definition for runtime key `k`, so each read of it is\n   discharged by an unconditional module-level definition.\"\n  [k uninit]\n  [k uninit])\n\n\n(defn module-definitions\n  \"The module's definition list: a `uninit` placeholder for every runtime\n   key (stripped of `ns-str`), then every definition, stripped.\"\n  [ns-str uninit runtime-keys definitions]\n  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n        definitions))\n\n\n(defn wide-app\n  \"One application whose operands are `nodes` (in order), applied to a lambda\n   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n   linker's scanners discharge every body read of a sibling or runtime key;\n   a `then` chain would nest definitions in closure bodies.\"\n  [nodes]\n  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n\n\n(defn module-tree\n  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n   the `trailing` UAST nodes.\"\n  [defs trailing]\n  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n                  trailing)))\n\n\n(defn exports\n  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n   stripped.\"\n  [ns-str definitions]\n  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n             definitions)))\n\n\n(defn free-names\n  \"Every variable name some occurrence of the map AST `ast` reads\n   unbound by an enclosing lambda.\"\n  [ast]\n  (letfn [(walk-node\n            [acc node bound]\n            (cond\n              (vector? node) (reduce (fn [a n] (walk-node a n bound)) acc node)\n              (not (map? node)) acc\n              :else\n              (case (:type node)\n                :variable (if (contains? bound (:name node))\n                            acc\n                            (conj acc (:name node)))\n                :literal acc\n                :lambda (walk-node acc (:body node) (into bound (:params node)))\n                (reduce (fn [a v] (walk-node a v bound)) acc (vals node)))))]\n    (walk-node #{} ast #{})))\n\n\n(defn defined-keys\n  \"Every literal key the map AST `ast` defines with `yin/def`, at any\n   depth.\"\n  [ast]\n  (set (keep (fn [node]\n               (when (and (map? node)\n                          (= :application (:type node))\n                          (= 'yin/def (get-in node [:operator :name])))\n                 (get-in node [:operands 0 :value])))\n             (tree-seq coll? seq ast))))\n\n\n(defn free-name-vec\n  \"The names `ast` reads and does not define, sorted.\"\n  [ast]\n  (vec (sort-by str\n                (remove (conj (defined-keys ast) 'yin/def) (free-names ast)))))\n\n\n(defn balanced-definitions->uast\n  \"Balanced definition-to-UAST emission: each [key form] pair maps to\n   u/def! and the vector splits at its midpoint, halving sequential depth\n   versus the linear u/seq-nodes chain. The tree shape is content-addressed:\n   empty input answers nil, and callers choose balanced versus linear\n   deliberately - never migrate between the two for style.\"\n  [defs]\n  (letfn [(sequence-tree [nodes]\n            (if (<= (count nodes) 1)\n              (first nodes)\n              (let [middle (quot (count nodes) 2)]\n                (u/then (sequence-tree (subvec nodes 0 middle))\n                        (sequence-tree (subvec nodes middle))))))]\n    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n\n\n(defn definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n(defn- admit-key? [x]\n  (cond\n    (or (ref? x) (callable? x) (cbor/float64? x)) false\n    (or (nil? x) (boolean? x) (string? x) (integer-host/exact-integer? x)) true\n    (or (keyword? x) (symbol? x))\n    (let [n (name x), ns (namespace x)]\n      (and (not (str/includes? n \"/\")) (not (str/starts-with? n \":\"))\n           (or (nil? ns) (and (not (empty? ns)) (not (str/includes? ns \"/\"))))))\n    (vector? x) (every? admit-key? x)\n    (map? x) (every? (fn [[k v]] (and (admit-key? k) (admit-key? v))) x)\n    (set? x) (every? admit-key? x)\n    :else false))\n\n(defn- normalize-key\n  \"Canonicalize integer carriers throughout an admitted key. Apply at both\n   insertion and lookup; other key equality remains host equality.\"\n  [x]\n  (when-not (admit-key? x)\n    (wrong-type! 'normalize-key 0 :admitted-key))\n  (key/normalize x))\n\n\n(defn- canonical-compare [a b]\n  (let [a (cbor/encode a), b (cbor/encode b), n (min (bytes/length a) (bytes/length b))]\n    (loop [i 0]\n      (if (= i n)\n        (compare (bytes/length a) (bytes/length b))\n        (let [c (compare (bytes/get a i) (bytes/get b i))]\n          (if (zero? c) (recur (inc i)) c))))))\n\n(defn- canonical-entries [coll]\n  (cond\n    (map? coll) (vec (sort (fn [[a _] [b _]] (canonical-compare a b)) coll))\n    (set? coll) (vec (sort canonical-compare coll))\n    :else (wrong-type! 'canonical-entries 0 :map-or-set)))\n\n\n;; =============================================================================\n;; The module\n;; =============================================================================\n\n(def ^:private exports\n  \"`[name arities f]` of every export. `:variadic` means the greatest\n   listed fixed arity extends to further arguments.\"\n  [['count [1] data-count]\n   ['nth [2] data-nth]\n   ['contains? [2] data-contains?]\n   ['dissoc [1 :variadic] data-dissoc]\n   ['disj [1 :variadic] data-disj]\n   ['peek [1] data-peek]\n   ['pop [1] data-pop]\n   ['subvec [2 3] data-subvec]\n   ['hash-set [0 :variadic] (fn [& xs] (into #{} (map key/normalize) xs))]\n   ['into [2] data-into]\n   ['str-concat [0 :variadic] str-concat]\n   ['str-length [1] str-length]\n   ['substring [2 3] substring]\n   ['str-index-of [2 3] str-index-of]\n   ['str-split [2] str-split]\n   ['str-join [2] str-join]\n   ['char-at [2] char-at]\n   ['str->code-points [1] str->code-points]\n   ['code-points->str [1] code-points->str]\n   ['str-compare [2] str-compare]\n   ['str-unit-length [1] str-unit-length]\n   ['str-unit-at [2] str-unit-at]\n   ['str-units [1] str-units]\n   ['units->str [1] units->str]\n   ['well-formed-utf16? [1] well-formed-utf16?]\n   ['number? [1] data-number?]\n   ['float64 [1] float64]\n   ['float-value [1] float-value]\n   ['content= [2] data-content=]\n   ['float64? [1] cbor/float64?]\n   ['equiv [2] data-equiv]\n   ['admit-key? [1] admit-key?]\n   ['normalize-key [1] normalize-key]\n   ['canonical-compare [2] canonical-compare]\n   ['canonical-entries [1] canonical-entries]\n   ['callable? [1] callable?]\n   ['map? [1] data-map?]\n   ['vector? [1] data-vector?]\n   ['string? [1] data-string?]])\n\n\n(defn- arity-checked\nsrc/cljc/yang/rt/effect.cljc:18:    [yrt.effect/handlers\nsrc/cljc/yang/rt/effect.cljc:38:       (let [hs (yrt.effect/handlers ctx-cell)]\nsrc/cljc/yang/rt/effect.cljc:78:       (let [hs (yrt.effect/handlers ctx-cell)]\nsrc/cljc/yang/rt/effect.cljc:100:       (let [hs (yrt.effect/handlers ctx-cell)]\nsrc/cljc/yang/rt/effect.cljc:120:    [yrt.effect/handle\nsrc/cljc/yang/rt/effect.cljc:179:       (let [hs (yrt.effect/_find-effect (yrt.effect/handlers ctx-cell) tag)]\nsrc/cljc/yin/vm/data.cljc:538:(defn- admit-key? [x]\nsrc/cljc/yin/vm/debruijn/stack.cljc:127:(defn- admit!\nsrc/cljc/yin/vm/float.cljc:157:(defn register-float-module [registry]\nsrc/cljc/yin/vm/float.cljc:158:  (module/register-host-module registry module-name float-module float-profiles))\nsrc/cljc/yang/core/prelude_admission.cljc:52:(defn admit\nsrc/cljc/yang/core/prelude_admission.cljc:204:(defn admit-profile\nsrc/cljc/yin/vm/ucf/authority/admission.cljc:298:(defn admit!\nsrc/cljc/yin/vm/ucf/holder/driver.cljc:948:(defn- admitted?\nsrc/cljc/yin/vm/ucf/holder/writer.cljc:163:(defn admit-request\nsrc/cljc/yin/vm/integer.cljc:9:   `register-integer-module`, and Yin source reaches the exports as\nsrc/cljc/yin/vm/integer.cljc:112:  \"The module `register-integer-module` installs.\"\nsrc/cljc/yin/vm/integer.cljc:699:(defn register-integer-module\nsrc/cljc/yin/vm/integer.cljc:703:  (module/register-host-module registry module-name (integer-module limits)\nsrc/cljc/yin/vm/semantic/code.cljc:67:  \"A register id: a non-negative integer.\"\nsrc/cljc/yin/vm/linker/interpreter.cljc:219:(defn- admitted\nsrc/cljc/yin/vm/docs/jfr_benchmark_analysis.md:22:iteration in one `loop` with five registers in locals, integer `case` dispatch,\nsrc/cljc/yin/vm/semantic.cljc:325:(defn- admit-image\nsrc/cljc/yin/vm/macro.cljc:422:(defn- admit\n","exit_code":0,"status":"completed"}}
