{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2418,2458p;2570,2700p;2714,2743p;2937,3065p;3128,3220p' test/yang/clojure_test.clj; rg -n '(helper-names|::local-fns|dsg__invoke_local|dsg__make_local|float64)' src/cljc/yang/clojure.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2418,2458p;2570,2700p;2714,2743p;2937,3065p;3128,3220p' test/yang/clojure_test.clj; rg -n '(helper-names|::local-fns|dsg__invoke_local|dsg__make_local|float64)' src/cljc/yang/clojure.cljc\"","aggregated_output":"\n\n;; =============================================================================\n;; Slice 7: the guest collection and higher-order library\n;; =============================================================================\n\n(def ^:private library-modules\n  \"The library's whole host surface: the `kind` module, the `portable`\n   adapters of the data exports the collection predicates read, and the\n   `cell` module. Every outcome-model program's emitted call routing reads\n   `cell/authentic?` once a callee passes the cell-ref shape pre-filter,\n   and a spliced `cell/new` mints genuine references (the engine seals\n   them under the test composition's capability secret), so the lane's\n   registry supplies the cell host as the linked compositions' do.\"\n  (let [host (fn [registry module-name fns arities]\n               (module/register-host-module\n                 registry module-name fns\n                 (into {} (map (fn [[op _]]\n                                 [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n                       fns)))\n        portable (into {}\n                       (map (fn [[source _]]\n                              (let [op (symbol (name source))]\n                                [op (yang/outcome-adapter data/refusal-message\n                                                          (get data/data-module op))])))\n                       yang/library-adapters)]\n    (-> av-modules\n        (module/register-cell-module)\n        (host 'kind yang/kind-module yang/kind-arities)\n        (host 'portable portable\n              (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n                    (keys portable))))))\n\n\n(def ^:private library-opts\n  {:convention :arg-vector, :outcomes true\n   :adapters yang/library-adapters\n   :native vm/primitive-profiles})\n\n\n(defn run-guest-machine\n\n(defn- run-cell-program\n  \"The value of running the compiled `program` (quoted forms) with `node`\n   spliced into the marker operand, on one lane — every call keeps its\n   call-site routing — or the thrown refusal's ex-data.\"\n  [program node lane]\n  (let [ast (walk/postwalk\n              (fn [n] (if (= n (u/v 'marker-operand)) node n))\n              (yang/compile-program\n                (into (yang/library-for program) program)\n                true\n                library-opts))]\n    (try\n      (run-guest-ast ast library-modules lane 1000000)\n      (catch clojure.lang.ExceptionInfo e\n        [:thrown (select-keys (ex-data e) [:reason :effect])]))))\n\n\n(defn- run-cell-probe\n  \"The value of running the compiled probe program — `(probe <node>)`, so\n   the spliced `node` sits at a call's callee position — on one lane, or\n   the thrown refusal's ex-data.\"\n  [node lane]\n  (run-cell-program\n    '[(defn probe\n        [m]\n        (m :type))\n      (probe marker-operand)]\n    node lane))\n\n\n(deftest test-common-call-cell-ref-map-invocation\n  (testing \"a full-shape data map with a 64-character seal is ordinary invocable data\"\n    ;; The map spells every key of an issued reference and the seal has the\n    ;; issued format; the call site asks the heap (cell/authentic?), the\n    ;; heap does not authenticate it, and the invocation is the map lookup,\n    ;; on both evaluators — the ruling of record replaces the r4 id-language\n    ;; gate: no id spelling is consulted, the issuer answers.\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :type))])))\n    (is (= [:yin.k/ok :some-key]\n           (run-library '[(let [m {:type :cell-ref :id :some-key :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]\n                            (m :id))]))))\n  (testing \"a runtime-built full-shape map (assoc, not a bound literal) invokes as data\"\n    (is (= [:yin.k/ok :cell-ref]\n           (run-library '[(let [m (assoc (assoc (assoc {} :type :cell-ref)\n                                                :id :some-key)\n                                         :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")]\n                            (m :type))]))))\n  (testing \"a full-shape map that is data is not call-eligible\"\n    (is (= [:yin.k/ok false]\n           (run-library '[(yang.call/eligible? {:type :cell-ref :id :some-key\n                                                :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})]))))\n  (testing \"genuine references still dereference through admission\"\n    ;; A cell the engine minted (:cell-0), holding a descriptor with a\n    ;; callable entry: the call reaches the entry.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-probe (u/app (u/v 'cell/new)\n                                    (u/app (u/v 'assoc) (u/lit {})\n                                           (u/lit :yang.call/entry)\n                                           (u/lam ['invocation] (u/lit :called))))\n                             lane))\n          (str lane \" genuine live\"))))\n  (testing \"a genuine-but-dead reference keeps the standing refusal\"\n    ;; A genuine cell whose contents carry no call entry: admission answers\n    ;; false and the call refuses as not-callable — the behavior the D2 bar\n    ;; pins, unchanged by the data fallback.\n    (doseq [lane [:walker :semantic]]\n      (let [[tag payload :as result] (run-cell-probe (u/app (u/v 'cell/new) (u/lit 42))\n                                                     lane)]\n        (is (and (= :yin.k/error tag)\n                 (= :yang.call/not-callable (:yang.call/reason payload)))\n            (str lane \" genuine dead: \" (pr-str result))))))\n  (testing \"the gate's collision literal: an id inside the heap language answers as data\"\n    ;; The r4 reviewer's literal — a map whose :id is a :cell-N keyword and\n    ;; whose seal has the issued format but not the issued content. Under\n    ;; the ruling of record the call site asks the heap and routes by the\n    ;; answer, so the invocation is the map lookup and answers :cell-7,\n    ;; where r4's id-language gate still sent it to the dereference and the\n    ;; VM aborted it as dead-or-forged.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :cell-7]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (m :id))\n                 (probe marker-operand)]\n               (u/lit {:type :cell-ref :id :cell-7\n                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n               lane))\n          (str lane \" collision literal answers as data\"))))\n  (testing \"an exact copy of a genuine reference still resolves as a reference\"\n    ;; Rule 4, the bearer policy: authentication is by value — seal and id\n    ;; against the heap — with no construction-history promises, so a copy\n    ;; reconstructed field-for-field authenticates and its call reaches the\n    ;; cell's entry. Reading the fields uses explicit lookup at data\n    ;; positions (get), never a call of the reference.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok :called]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (let [copy {:type (get m :type), :id (get m :id), :seal (get m :seal)}]\n                     (copy nil)))\n                 (probe marker-operand)]\n               (u/app (u/v 'cell/new)\n                      (u/app (u/v 'assoc) (u/lit {})\n                             (u/lit :yang.call/entry)\n                             (u/lam ['invocation] (u/lit :called))))\n               lane))\n          (str lane \" bearer copy resolves\"))))\n  (testing \"explicit dereference of a forged reference stays strict\"\n    ;; Astra rule 1: cell/get at a reference position keeps the existing\n    ;; validation boundary — the data fallback lives in call routing, not in\n    ;; the dereference itself.\n    (doseq [lane [:walker :semantic]]\n      (is (= [:thrown {:reason :dead-or-forged-reference, :effect :cell/get}]\n             (run-cell-program\n               '[(defn probe\n                   [m]\n                   (cell/get m))\n                 (probe marker-operand)]\n               (u/lit {:type :cell-ref :id :cell-7\n                       :seal \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"})\n               lane))\n          (str lane \" explicit deref refuses\")))))\n\n\n(deftest test-library-closes-over-its-own-names\n(deftest test-library-kind-predicates\n  (testing \"collection predicates are derived from the data module's refusals\"\n    (is (= [true false false false false false]\n           (lib '[(vector? [1]) (vector? '(1)) (vector? {}) (vector? #{}) (vector? 1) (vector? nil)])))\n    (is (= [true false false false false]\n           (lib '[(map? {}) (map? [1]) (map? #{}) (map? nil) (map? \"s\")])))\n    (is (= [true false false]\n           (lib '[(set? #{1}) (set? [1]) (set? nil)])))\n    (is (= [true true true true false false false]\n           (lib '[(coll? []) (coll? '()) (coll? {}) (coll? #{}) (coll? nil) (coll? 1) (coll? \"s\")])))\n    (is (= [true false false false false]\n           (lib '[(seq? '(1 2)) (seq? []) (seq? {}) (seq? nil) (seq? 1)])))\n    (is (= [true true false false]\n           (lib '[(sequential? []) (sequential? '(1)) (sequential? {}) (sequential? 1)]))))\n  (testing \"boolean?, fn?, identity, not=, inc, dec\"\n    (is (= [true true false false] (lib '[(boolean? true) (boolean? false) (boolean? nil) (boolean? 0)])))\n    (is (= [true true false] (lib '[(fn? first) (fn? (fn [x] x)) (fn? 1)])))\n    (is (= [5 6 4 true false] (lib '[(identity 5) (inc 5) (dec 5) (not= 1 2) (not= 1 1)]))))\n  (testing \"symbol?, keyword?, name, symbol, keyword, str, int? are the kind module's\"\n    (is (= [true false true false] (lib '[(symbol? 'a) (symbol? :a) (keyword? :a) (keyword? 'a)])))\n    (is (= [\"a\" \"b\" 'a/b :k :a/b true false]\n           (lib '[(name 'a) (name :b) (symbol \"a\" \"b\") (keyword \"k\") (keyword \"a\" \"b\") (int? 1) (int? 1.5)])))\n    (is (= [\"\" \"a1:kx\" \"abcdef\"]\n           (lib '[(str) (str \"a\" 1 :k 'x) (str \"a\" \"b\" \"c\" \"d\" \"e\" \"f\")])))\n    (is (= ['G__5 'p7] (lib '[(gensym 5) (gensym \"p\" 7)]))\n        \"gensym takes its supply explicitly; there is no hidden counter\")))\n\n\n(deftest test-library-sequences\n  (is (= [nil nil [1 2] [1 2] [[:a 1]] nil]\n\n\n(deftest test-hardening-library-admissions\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok [nil 2 nil '(1 2) 'b :missing true false false {:name 'source}]]\n           (run-library '[[(last nil) (last [1 2]) (butlast [1]) (butlast [1 2 3])\n                           (nth '(a b) 1) (nth [1] 3 :missing)\n                           (string? \"\") (string? 'x) (var? 'x)\n                           (meta (with-meta 'x {:name 'source}))]]\n                        library-opts lane 1000000))))\n  (testing \"fresh supply crosses function calls and repeated loop iterations\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok [false 12]]\n             (run-library\n               '[(defn allocate\n                   [s]\n                   (fresh-symbol s \"fresh\"))\n                 (let [[a s] (allocate {:counter 0})\n                       [b s] (allocate s)\n                       s (loop [s s i 0]\n                           (if (= i 10) s\n                               (let [[n next-s] (allocate s)] (recur next-s (inc i)))))]\n                   [(= a b) (:counter s)])]\n               library-opts lane 1000000)))))\n  (is (= :yin.k/error (first (run-library '[(gensym \"fresh\")])))))\n\n\n(deftest test-portable-try-outcomes\n  (doseq [lane [:walker :semantic]\n          [form expected]\n          [['(try :ok (catch Exception e :bad)) :ok]\n           ['(try (throw (ex-info \"failure\" {:extra 7}))\n                  (catch Exception e [(.getMessage e) (ex-data e)])) [\"failure\" {:extra 7}]]\n           ['(try (try (throw (ex-info \"inner\" {}))\n                       (catch Exception e (throw (ex-info \"outer\" (ex-data e)))))\n                  (catch Exception e (.getMessage e))) \"outer\"]\n           ['(let [v (try (+ 1 (throw (ex-info \"early\" {})))\n                          (catch Exception e 8))] (inc v)) 9]]]\n    (is (= [:yin.k/ok expected] (run-library [form] library-opts lane 1000000))))\n  (doseq [form '[(try 1 (catch Exception e 2) :ignored)\n                 (try 1 (catch Throwable e 2))\n                 (try 1 (catch Exception e (.getStackTrace e)))]]\n    (is (thrown? clojure.lang.ExceptionInfo\n          (yang/compile-program [form] true library-opts))))\n  ;; `finally` is now expressible (the one-catch/no-finally restriction is\n  ;; lifted): a try with only a finally runs it on normal exit.\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok 1]\n           (run-library '[(try 1 (finally 2))] library-opts lane 1000000)))))\n\n\n(deftest test-guest-callable-collections-and-threading\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok ['b 2 :absent :k nil 3 {:n 3}]]\n           (run-library\n             '[(let [v '[a b] m {:k 2} s #{:k} k :n]\n                 [(v 1) (m :k) (m :missing :absent) (s :k) (s :missing)\n                  (k {:n 3}) (-> {:n 1} (update :n + 2))])]\n             library-opts lane 1000000))))\n  (is (= [:yin.k/ok :caught]\n         (run-library '[(try (let [v [1]] (v)) (catch Exception e :caught))]))))\n\n\n(deftest test-value-invocation-refusals-are-terminating\n  (testing \"entry-absent callees refuse through the library invoker instead of\n            re-entering the dispatcher; the vector binder only forces the\n            invoker into the library so the routing is actually exercised\"\n    (doseq [lane [:walker :semantic]]\n      ;; (A): the invoker's source-thrown refusal map is an ordinary\n      ;; payload at this harness boundary (a public entry rebuilds the\n      ;; `:yang.call/thrown` wire condition from it).\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(let [five 5 v [five]] (five 1))]\n                          library-opts lane 1000000))\n          \"a scalar callee terminates as not-callable\")\n      (let [[tag _] (run-library\n                      '[(defn f\n                          [x]\n                          x)\n                        (let [e yang.call/entry v [e]] (e f))]\n                      library-opts lane 1000000)]\n        (is (= :yin.k/ok tag)\n            \"a module fn is an admitted descriptor: the call goes through admission\"))\n      (let [[tag payload] (run-library\n                            '[(defn f\n                                [x]\n                                x)\n                              (let [raw (yang.call/entry f) v [raw]] (raw {}))]\n                            library-opts lane 1000000)]\n        (is (= :yin.k/error tag) \"a projected raw closure terminates\")\n        (is (= :yang.call/not-callable (:yang.call/reason payload))\n            \"the adoption's refusal is the escaped payload at this boundary\")\n        (is (some? (get-in payload [:yang.call/data :yang.call/callee]))\n            \"the refusal names the callee in its evidence\"))\n      (doseq [entry [nil false]]\n        (let [[tag payload] (run-library\n                              [(list 'let ['m {:yang.call/entry entry :x 42} 'v '[m]]\n                                     '(m :x))]\n                              library-opts lane 1000000)]\n          (is (= :yin.k/error tag) (str \"a \" (pr-str entry) \" entry is present, not absent\"))\n          (is (= :yang.call/not-callable (:yang.call/reason payload))\n              (str \"a \" (pr-str entry) \" entry reaches admission and refuses\"))))\n      (let [[tag payload] (run-library\n                            '[(defn tail-refusal\n                                []\n                                (let [five 5 v [five]] (five 1)))\n                              (tail-refusal)]\n                            library-opts lane 1000000)]\n        (is (= :yin.k/error tag))\n        (is (= {:yang.call/reason :yang.call/not-callable\n                :yang.call/data {:yang.call/callee 5}}\n               payload)\n            \"the refusal survives a tail-position value call as the payload\")\n        (is (= {:yang.call/callee 5}\n               (get-in payload [:yang.call/data]))\n            \"the callee evidence names the scalar callee\"))\n      (doseq [[where form] [[1 '(five (boom) 2)] [2 '(five 1 (boom))]]]\n        (let [[tag payload] (run-library\n                              ['(defn boom\n                                  []\n                                  (throw (ex-info \"boom\" {})))\n                               (list 'let '[five 5 v [five]] form)]\n                              library-opts lane 1000000)]\n          (is (= :yin.k/error tag) (str \"operand \" where \" errors before the refusal\"))\n          (is (= \"boom\" (:yin.k/message payload))\n              (str \"operand \" where \" is evaluated before the callee check\")))))))\n\n\n(deftest test-intra-unit-call-lowering-guards-and-budget\n  (testing \"tight per-call step budget holds across non-tail and tail intra-unit calls\"\n    (let [forms '[(defn inc1\n                    [x]\n                    (+ x 1))\n                  (defn sum-calls\n                    [n acc]\n                    (if (= n 0)\n                      acc\n                      (sum-calls (- n 1) (inc1 acc))))\n                  (sum-calls 500 0)]\n          ast (yang/compile-program forms true outcome-opts)]\n      (doseq [lane [:walker :semantic]]\n        (is (= [:yin.k/ok 500]\n               (run-guest-ast ast outcome-modules lane 185000))\n            (str lane \": 1000 intra-unit calls fit comfortably inside 185k steps.\n                      The unary-entry token-packet lane (D2) with the final arity guard\n                      measures 160,046 walker steps (86,822 semantic) for these 1000\n                      calls - the guard's invocation-shape count check moved the walker\n                      cost from the pre-guard 140,142 (140/call) to ~160/call. The\n                      budget keeps ~15% headroom over the measured cost, recalibrated\n                      2026-11-04 by direct step-count measurement.\")))))\n  (testing \"local shadowing of a top-level defn preserves dynamic admission and routing\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(defn f\n                              [x]\n                              (+ x 100))\n                            (let [f 5 v [f]] (f 1))]\n                          library-opts lane 200000)))\n      (is (= [:yin.k/ok 42]\n             (run-library '[(defn f\n                              [x]\n                              (+ x 100))\n                            (let [f (fn [y] (* y 2))] (f 21))]\n                          library-opts lane 200000)))\n      (is (= [:yin.k/ok 9]\n             (run-library '[(defn f\n                              [x]\n                              (+ x 100))\n                            (let [f {:k 9} v [f]] (f :k))]\n                          library-opts lane 200000))\n          \"entry-absent local map routes to invoke-value\")\n      (let [[tag payload] (run-library\n                            '[(defn f\n                                [x]\n                                (+ x 100))\n                              (let [f {:yang.call/entry (yang.call/entry f)} v [f]]\n                                (f 1))]\n                            library-opts lane 200000)]\n        (is (= :yin.k/error tag))\n        (is (= :yang.call/not-callable (:yang.call/reason payload))\n            \"entry-present forged local map routes to admission and refuses\"))\n      (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                            :yang.call/data {:yang.call/callee 5}}]\n             (run-library '[(defn f\n                              [[f]]\n                              (f 1))\n                            (f [5])]\n                          library-opts lane 200000))\n          \"destructured parameter shadows enclosing defn\")\n      (is (= [:yin.k/ok 7]\n             (run-library '[(defn f\n                              [x]\n                              99)\n                            (try\n                              (throw (ex-info \"boom\" {:k 7}))\n                              (catch Exception f\n                                (let [d (get f :yin.k/data) v [d]]\n                                  (d :k))))]\n                          library-opts lane 200000))\n          \"catch binder shadows top-level defn\")))\n  (testing \"top-level def/defn interactions, error outcomes, and operand order\"\n    (is (= [:yin.k/error {:yang.call/reason :yang.call/not-callable\n                          :yang.call/data {:yang.call/callee 5}}]\n           (run-outcome '[(defn f\n                            [x]\n                            1) (def f 5) (f 1)])))\n    (is (= [:yin.k/ok 42]\n           (run-outcome '[(def f 5) (defn f\n                                      [x]\n                                      (+ x 1)) (f 41)])))\n    (is (= [:yin.k/ok 42]\n           (run-outcome '[(defn f\n                            [x]\n                            1) (defn f\n                                 [x]\n                                 (+ x 41)) (f 1)])))\n    ;; `yin.k/outcome-of` is retired: failure in an early def transfers out\n    ;; instead of becoming a nested outcome value. The later defn cannot\n    ;; retroactively supply that call; successful def values remain plain.\n    (let [[tag condition] (run-outcome '[(def early (first [10 20]))\n437:(def ^:private helper-names\n607:            (when-let [hit (first (filter helper-names bound'))]\n1119:                       (u/app (u/v 'dsg__make_local) (u/lit local-name) (u/lit meta) body-ast)\n1146:                                (when (contains? (::local-fns env) fn-name)\n1355:         (contains? (::local-fns env) operator)\n1357:    (cond-> (u/app (u/v 'dsg__invoke_local)\n1975:                                    ::local-fns (local-fn-names forms (:macros opts))))))))\n2042:  (let [ast (if (seq (::local-fns env))\n2047:                  (apply u/app (u/lam '[dsg__make_local dsg__invoke_local] ast)\n","exit_code":0,"status":"completed"}}
