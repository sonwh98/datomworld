{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/clojure/prelude.cljc'","aggregated_output":"(ns yang.clojure.prelude\n  \"The trusted Clojure runtime, emitted inline or as the linked clj module.\"\n  (:require [yang.core.call :as call]\n            [yang.core.prelude :as core]\n            [yang.core.prelude-admission :as prelude-admission]\n            [yang.core.uast :as u]\n            [yang.rt.effect :as effect]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.module :as module]))\n\n\n(def module-name 'clj)\n\n(def runtime-keys '[clj.rt/state clj.rt/globals clj.rt/ctx])\n\n\n(def definitions\n  \"The ordered guest definitions shared by bundled and linked clj.\"\n  '[[clj/init!\n     (fn []\n       (if (= clj.rt/state :clj/uninit)\n         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n             (yin/def (quote clj.rt/ctx) (cell/new (yrt.effect/ctx nil 0 0 nil)))\n             (yin/def (quote clj.rt/state) :clj/ready))\n         :clj/ready))]\n    [clj/define-global!\n     (fn [name value]\n       (do (cell/set! clj.rt/globals\n                      (assoc (cell/get clj.rt/globals) name value))\n           value))]\n    [clj/global-get\n     (fn [name]\n       (if (data/contains? (cell/get clj.rt/globals) name)\n         (get (cell/get clj.rt/globals) name)\n         :clj/unbound))]\n    [clj/prim-get-default\n     (fn [coll k default]\n       (if (data/vector? coll)\n         (if (data/contains? coll k) (data/nth coll k) default)\n         (get coll k default)))]\n    [clj/prim-get (fn [coll k] (clj/prim-get-default coll k nil))]\n    [clj/prim-assoc (fn [coll k v] (assoc coll k v))]\n    [clj/rt-ctx (fn [] clj.rt/ctx)]\n    [clj/raise\n     (fn [e] (yrt.effect/raise (clj/rt-ctx) e (fn [v] (:clj/no-handler v))))]\n    [clj/throw (fn [e] (clj/raise e))]\n    [clj/try\n     (fn [body handler] (yrt.effect/try-value (clj/rt-ctx) body handler))]\n    [clj/try-finally\n     (fn [body fin] (yrt.effect/try-finally (clj/rt-ctx) body fin nil))]\n\n    [clj/admitted-callable?\n     (fn [x]\n       (if (data/map? x)\n         (if (= (get x :type) :cell-ref)\n           (if (cell/authentic? x)\n             (if (data/callable? (yang.call/entry x))\n               (yang.call/eligible? x)\n               false)\n             false)\n           false)\n         false))]\n    [clj/dsg__invoke\n     (fn [callee positional named raise]\n       (if (clj/admitted-callable? callee)\n         (yang.call/invoke callee positional named raise)\n         (yang.call/transfer\n           raise\n           (yang.call/condition :yang.call/not-callable\n             (assoc {} :yang.call/callee callee)))))]\n    [clj/dsg__run-body\n     (fn [meta body invocation raise]\n       (let [ctx (clj/rt-ctx)\n             run (fn [tail-invoke]\n                   (let [named (get invocation :yang.call/named)]\n                     (if (= (data/count named) 0)\n                       (body (get invocation :yang.call/positional) tail-invoke)\n                       (clj/throw\n                         (assoc {} :yin.k/message\n                                   \"Clojure functions do not accept named arguments\"\n                                   :yin.k/data (assoc {} :yang.call/named named))))))\n             escape (fn [e]\n                      (let [retained (cell/dsg__provenance e)]\n                        (yang.call/transfer\n                          raise\n                          (if (= retained nil) (yang.call/thrown e) retained))))]\n         (if (get meta :clj/tail-call?)\n           ;; A source tail call escapes the current entry before entering\n           ;; the next one. The thunk carries the caller's actual raise\n           ;; exit, and the value path wraps and removes exactly one thunk.\n           ((yrt.effect/call-ec ctx\n              (fn [exit]\n                (let [value (yrt.effect/try-value ctx\n                              (fn []\n                                (run (fn [callee positional named]\n                                       (exit (fn []\n                                               (clj/dsg__invoke callee positional named raise))))))\n                              escape)]\n                  (fn [] value)))\n              nil))\n           (yrt.effect/try-value ctx (fn [] (run nil)) escape))))]\n    [clj/make-callable\n     (fn [meta body]\n       (let [owner (cell/new meta)\n             entry\n             (fn [invocation]\n               (if (data/map? invocation)\n                 (let [raise (get invocation :yang.call/raise)]\n                   (if (data/callable? raise)\n                     (if (if (yang.call/valid-invocation? invocation)\n                           (= (get invocation :yang.call/callee) owner)\n                           false)\n                       (if (data/contains? invocation :yang.call/binding-profile)\n                         (yang.call/transfer\n                           raise\n                           (yang.call/condition :yang.call/unsupported-binding\n                             (assoc {} :yang.call/callee owner\n                                       :yang.call/binding-profile\n                                       (get invocation :yang.call/binding-profile))))\n                         (clj/dsg__run-body meta body invocation raise))\n                       (yang.call/transfer\n                         raise\n                         (yang.call/condition :yang.call/invalid-invocation\n                           (assoc {} :yang.call/callee (get invocation :yang.call/callee)\n                                     :yang.call/owner owner))))\n                     (:clj/missing-raise-exit invocation)))\n                 (:clj/invalid-invocation invocation)))]\n         (do (cell/set! owner (assoc meta :yang.call/entry entry))\n             owner)))]\n    [clj/invoke-callable\n     (fn [callee positional named]\n       (clj/dsg__invoke callee positional named\n         (fn [condition]\n           (clj/raise\n             (if (= (get condition :yang.call/reason) :yang.call/thrown)\n               (get condition :yang.call/value)\n               (cell/dsg__new-provenance condition condition))))))]\n    ;; A caught carrier stays intact for storing or rethrowing. Source\n    ;; readers observe its value, and the program boundary reports the\n    ;; retained condition even if the carrier's public value changed.\n    [clj/condition-view\n     (fn [x]\n       (if (= (cell/dsg__provenance x) nil)\n         (if (if (data/map? x) (= (get x :type) :cell-ref) false)\n           (if (cell/authentic? x)\n             (let [descriptor (cell/get x)]\n               (if (= (get descriptor :clj/type) :function) descriptor x))\n             x)\n           x)\n         (cell/get x)))]\n    [clj/run-unit\n     (fn [body]\n       (clj/try (fn [] (conj [] :yin.k/ok (body)))\n                (fn [e]\n                  (let [retained (cell/dsg__provenance e)]\n                    (conj [] :yin.k/error (if (= retained nil) e retained))))))]\n    [clj/unwrap-outcome\n     (fn [value]\n       (if (if (data/vector? value) (= (data/count value) 2) false)\n         (if (= (data/nth value 0) :yin.k/ok)\n           (data/nth value 1)\n           value)\n         value))]\n    [clj/run-main\n     (fn [body]\n       (do (clj/init!)\n           (clj/unwrap-outcome (body))))]])\n\n\n(def bundled-primitive-forms\n  \"Guest closures can capture each other without capturing a host function.\"\n  '[(fn [coll k default]\n      (if (data/vector? coll)\n        (if (data/contains? coll k) (data/nth coll k) default)\n        (dsg__primitive/get coll k default)))\n    (fn [a b] (data/content= a b))\n    (fn [coll k v k2 v2 k3 v3 k4 v4]\n      (if (data/content= k2 nil)\n        (dsg__primitive/assoc coll k v)\n        (if (data/content= k3 nil)\n          (dsg__primitive/assoc coll k v k2 v2)\n          (if (data/content= k4 nil)\n            (dsg__primitive/assoc coll k v k2 v2 k3 v3)\n            (dsg__primitive/assoc coll k v k2 v2 k3 v3 k4 v4)))))\n    (fn [a b] (dsg__primitive/+ a b))\n    (fn [a b] (dsg__primitive/<= a b))])\n\n\n(def module-exports\n  (disj (core/exports \"clj\" definitions) 'dsg__invoke 'dsg__run-body))\n\n\n(def uast\n  \"Install clj from a closed, content-addressed bundle.\"\n  (let [placeholders (mapv (fn [key] [key :clj/uninit]) runtime-keys)\n        install (apply u/app\n                       (u/lam '[get = assoc + <=]\n                              (core/definitions->uast (into placeholders definitions)))\n                       (map u/sexp->uast bundled-primitive-forms))]\n    (u/mark-tails\n      (u/app (u/lam [] (u/then (u/lit :clj/bundled-runtime) install))))))\n\n\n(defn with-bundled-runtime\n  \"Install and initialize bundled clj before running body in the same\n   lexical scope. Bundled UAST callers can use the private lookup closure\n   to read an invocation record without capturing a host function.\"\n  [& body]\n  (let [shared (u/app (u/lam '[get = assoc + <=] (u/seq-nodes [call/uast effect/uast]))\n                      (u/v 'dsg__get) (u/v 'dsg__equal) (u/v 'dsg__assoc)\n                      (u/v 'dsg__add) (u/v 'dsg__lte))]\n    (apply u/app\n           (u/lam '[dsg__get dsg__equal dsg__assoc dsg__add dsg__lte]\n                  (u/seq-nodes (into [shared uast (u/app (u/v 'clj/init!))] body)))\n           (map u/sexp->uast bundled-primitive-forms))))\n\n\n(def bundled-uast (with-bundled-runtime))\n\n\n(def bundled-names\n  \"Bundled runtime store definitions accepted by admission scans.\"\n  (into (set runtime-keys) (map first) (concat definitions effect/definitions)))\n\n\n(def module-definitions\n  (core/module-definitions \"clj\" :clj/uninit runtime-keys definitions))\n\n\n(def module-uast\n  (u/annotate-call-sites\n    (core/module-tree module-definitions\n                      (mapv u/sexp->uast '[(require 'yang.call) (require 'yrt.effect)]))))\n\n\n(def ^:private module-free-names (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"Emit the clj module pinned to the installed calling and effect runtimes.\"\n  [registry call-address effect-address]\n  (let [requires {call/module-name call-address, effect/module-name effect-address}]\n    (prelude-admission/module-spec\n      {:module-name module-name\n       :ast module-uast\n       :exports module-exports\n       :requires requires\n       :free-names module-free-names\n       :skip? #(contains? requires (some-> % namespace symbol))\n       :registry registry\n       :message \"the clj module reads an undeclared name\"\n       :refusal-ns \"yang.clojure\"})))\n\n\n(defn outcome-adapter\n  \"Wrap host function `f`, a primitive declaring domain failures, as an\n   outcome-returning one: success is [:yin.k/ok value], and the module's own\n   refusal (ex-info with message `refusal-message` and :yin.vm.data/op and\n   :yin.vm.data/reason in its data) is [:yin.k/error data] with those keys.\n   Any other host exception propagates: an unexpected VM or compiler failure\n   is never a successful rejection.\"\n  [refusal-message f]\n  (fn [& args]\n    (try\n      [:yin.k/ok (apply f args)]\n      (catch #?(:clj Throwable, :cljs :default, :cljd Object) e\n        (let [data (ex-data e)]\n          (if (and (= refusal-message (ex-message e))\n                   (contains? data :yin.vm.data/op)\n                   (contains? data :yin.vm.data/reason))\n            [:yin.k/error data]\n            (throw e)))))))\n\n\n(def library-adapters\n  \"The retired `:adapters` map a program using `library` once compiled with:\n   the data exports whose refusal the collection predicates read as data.\n   The continuation port rewrote those predicates onto the `data/*` and\n   `kind/*` host predicates, so no `portable/*` adapter is consulted; the\n   map stays for the `library-opts`/`unit-opts` fixtures and the prelude's\n   `admit` registration.\"\n  {'data/count 'portable/count\n   'data/peek 'portable/peek\n   'data/dissoc 'portable/dissoc\n   'data/disj 'portable/disj\n   'data/str-length 'portable/str-length})\n\n\n(def kind-module\n  \"The `kind` host module's exports, symbol to host function: the irreducible\n   kind and name primitives (see the library notes). Every export is pure.\"\n  (merge\n    {'symbol? symbol?\n     'keyword? keyword?\n     'name name\n     'namespace namespace\n     'symbol symbol\n     'keyword keyword\n     'str str\n     'int? int?\n     'with-meta with-meta\n     'meta meta\n     'coll? coll?\n     'set? set?}\n    #?(:clj {'var? var?} :default {})))\n\n\n(def kind-arities\n  \"The published arities of each `kind` export.\"\n  {'symbol? [1], 'keyword? [1], 'name [1], 'namespace [1], 'symbol [1 2], 'keyword [1 2]\n   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'var? [1], 'with-meta [2], 'meta [1]\n   'coll? [1], 'set? [1]})\n\n\n(defn register-library-module\n  \"Return `registry` with host module `name` installed over `entries`\n   (`[export function]` pairs) at `arities`, each export pure.\"\n  [registry name entries arities]\n  (module/register-host-module\n    registry name\n    (into {} entries)\n    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n          entries)))\n\n\n(defn admit\n  \"Return `registry` with the guest library's host surface installed: the\n   `kind` module and the `portable` adapters of the data exports the\n   collection predicates read (yang.clojure's `library-adapters`). A\n   linked clojure composition registers them beside the other runtimes'\n   registry surfaces; a composition without a clojure program reads none\n   of them.\"\n  [registry]\n  (let [portable (into {}\n                       (map (fn [[source _]]\n                              (let [op (symbol (name source))]\n                                [op (outcome-adapter data/refusal-message\n                                                          (get data/data-module op))])))\n                       library-adapters)]\n    (-> registry\n        (register-library-module 'kind kind-module kind-arities)\n        (register-library-module\n          'portable portable\n          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n                (keys portable))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,62p;850,875p;1190,1414p;1916,1978p;2000,2190p;2493,2750p' src/cljc/yang/clojure.cljc\"","aggregated_output":"(ns yang.clojure\n  \"Yang Clojure compiler - Compiles Clojure code into Yin VM Universal AST.\n\n  This is the Clojure-specific compiler in the Yang compiler collection.\n  It transforms Clojure s-expressions into the Universal AST format that\n  the Yin VM can execute. It handles:\n  - Literals (numbers, strings, booleans, nil, collections)\n  - Variables (symbols)\n  - Lambda expressions (fn)\n  - Function application (including stream operations via module system)\n  - Conditionals (if)\n  - Let bindings (let)\n  - Top-level definitions via explicit yin/def store effects\n  - Macro definitions (defmacro)\n\n  Macro support (docs/design/yin.vm.macro.md §10.2):\n  - defmacro is a special form that lowers to ordinary (yin/def name (fn ...))\n    syntax. The lambda node carries `:macro? true`, a frontend-internal fact\n    the encoder (`yin.vm.encoder/program-batch`) turns into a declaration row;\n    the canonical lambda row has no macro slot.\n  - A macro call is an ordinary application. The frontend does no macro\n    lookup: the row-native expander recognizes the call.\n  - compile-program threads a compile-time macro-env naming the defmacros\n    seen so far, only so the native defn lowering yields to a user defn macro.\n\n  Stream operations (stream/make, stream/put, stream/take, >!, <!) are compiled\n  as regular function applications and resolved through the module system at runtime.\n\n  The compiler is written in .cljc format to run on both JVM and Node.js.\"\n  (:refer-clojure :exclude [compile])\n  (:require #?@(:jolt []\n                :cljd []\n                :clj [[clojure.tools.reader :as treader]\n                      [clojure.tools.reader.reader-types :as rt]]\n                :cljs [[cljs.tools.reader :as treader]\n                       [cljs.tools.reader.reader-types :as rt]])\n            [dao.jing :as jing]\n            [yang.clojure.prelude :as prelude]\n            [yang.core.uast :as u]\n            [yang.tails :as tails]\n            [yin.vm :as vm]))\n\n\n;; Forward declaration for mutual recursion\n(declare compile-form compile-lambda)\n\n\n;; =============================================================================\n;; Call-site occurrence contract C1 (Addendum A, design §2)\n;; =============================================================================\n;;\n;; Every final `:application` occurrence of a produced tree carries the\n;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n;; from canonical rows and emits it into the frontend-metadata side table\n;; as `[origin root-address path :yang/call-site 1]`, where the first\n;; three coordinates are the site id. The key carries no callee identity,\n;; source arity, or ambient classification. It is distinct from\n;; `:yang/site`, the safepoint mark, which travels as node metadata.\n;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n;; continuation nodes) are not `:application` nodes and are never marked.\n\n\n\n(def ^:private default-adapter-arity\n  \"The largest count an adapter admits for a native name with no declared\n   profile (`:native` given as a plain set).\"\n  4)\n\n\n(def ^:private adapter-variadic-cap\n  \"How far an adapter extends a `:variadic` profile arity: an adapter is a\n   finite dispatch, so an open-ended arity needs a stated bound.\"\n  8)\n\n\n(defn- native-name?\n  \"True when `sym` statically names a primitive or host-module export.\"\n  [env sym]\n  (when-let [conv (::convention env)]\n    (and (symbol? sym)\n         (not (contains? (locals env) sym))\n         (not (contains? (::defined env) sym))\n         (or (some? (namespace sym))\n             (contains? (:native conv) sym)))))\n\n\n(defn- macro-call?\n    (compile-lambda [av-sym] (av-dispatch env sym nil arities) env tail? macro-env)))\n\n\n(defn- apply-call?\n  \"True when `operator` is the `apply` intrinsic: not bound locally and not\n   defined by the program.\"\n  [env operator]\n  (and (= 'apply operator)\n       (not (contains? (locals env) operator))\n       (not (contains? (::defined env) operator))))\n\n\n(defn- cell-ref-shaped-node\n  \"The UAST pre-filter for WHEN to ask the heap about a callee: the\n   callee could be a cell reference the VM issued — `:type :cell-ref`\n   with the `:id` and `:seal` every issued reference carries, no other\n   entries, a seal of the issued form (a 64-character string). The\n   shape never decides meaning (ruling of record, rule 2): a map\n   passing it is only worth asking about, and the `cell/authentic?`\n   query emitted beside it answers. Any `:id` spelling may name a\n   cell, so the r4 heap-id-language discriminator is retired — the\n   minted `:cell-N` restriction was itself a value-shape guess the\n   issuer never certified. A map that fails this pre-filter is never\n   asked and never dereferenced: it routes to ordinary map\n   invocation, which grants no cell capability.\"\n  [callee]\n  (let [seal (u/app (u/v 'clj/prim-get) callee (u/lit :seal))]\n    (u/if-node (u/app (u/v 'data/content=)\n                      (u/app (u/v 'clj/prim-get) callee (u/lit :type))\n                      (u/lit :cell-ref))\n               (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :id))\n                          (u/if-node (u/app (u/v 'data/contains?) callee (u/lit :seal))\n                                     (u/if-node (u/app (u/v 'data/content=)\n                                                       (u/app (u/v 'data/count) callee)\n                                                       (u/lit 3))\n                                                (u/if-node (u/app (u/v 'data/string?) seal)\n                                                           (u/if-node (u/app (u/v 'data/content=)\n                                                                             (u/app (u/v 'data/str-length) seal)\n                                                                             (u/lit 64))\n                                                                      (u/lit true)\n                                                                      (u/lit false))\n                                                           (u/lit false))\n                                                (u/lit false))\n                                     (u/lit false))\n                          (u/lit false))\n               (u/lit false))))\n\n\n(defn- guest-call-dispatch\n  [env tail?]\n  (u/v (if-let [used? (when tail? (::tail-call? env))]\n         (do (vreset! used? true) 'dsg__tail_invoke)\n         'clj/invoke-callable)))\n\n\n(defn- guest-call-routing\n  [callee arguments dispatch env]\n  (let [invoke (u/app dispatch callee arguments (u/lit []))]\n    ;; A descriptor-shaped map must pass callable admission. Ordinary\n    ;; data invocation is the library invoker's responsibility.\n    (if (::invoker env)\n      (u/if-node\n        (u/if-node (u/app (u/v 'data/map?) callee)\n                   (u/if-node (u/app (u/v 'data/contains?) callee\n                                    (u/lit :yang.call/entry))\n                              (u/lit true)\n                              (u/if-node (cell-ref-shaped-node callee)\n                                         (u/app (u/v 'cell/authentic?) callee)\n                                         (u/lit false)))\n                   (u/lit false))\n        invoke\n        (u/app dispatch (u/v 'invoke-value)\n               (u/app (u/v 'conj) (u/lit []) callee arguments)\n               (u/lit [])))\n      invoke)))\n\n\n(defn- compile-guest-call\n  \"Route source calls through clj's invoking boundary.\"\n  [callee-ast arguments-ast env tail?]\n  (if-not (outcomes? env)\n    (cond-> (u/app callee-ast arguments-ast)\n      tail? (assoc :tail? true))\n    (let [callee (u/v 'dsg__callee)\n          arguments (u/v 'dsg__arguments)\n          routed (guest-call-routing callee arguments (guest-call-dispatch env tail?) env)]\n      (cond-> (u/mark-tails (u/let1 (:name callee) callee-ast\n                                    (u/let1 (:name arguments) arguments-ast routed)))\n        tail? (assoc :tail? true)))))\n\n\n(defn- compile-apply\n  \"(apply f a b coll) as one application of f to the assembled argument\n   vector (into [a b] (vec coll)): the convention's own calling shape, so it\n   serves a guest closure and an adapted native alike.\"\n  [operands env tail? macro-env]\n  (when (< (count operands) 2)\n    (reject! \"apply takes a function and an argument collection\"\n             {:operands (count operands)}))\n  (let [[f & more] operands\n        lead (vec (butlast more))\n        coll-form (list 'vec (last more))]\n    (compile-guest-call (compile-form f false env macro-env)\n                        (compile-form (if (seq lead)\n                                        (list 'data/into lead coll-form)\n                                        coll-form)\n                                      false env macro-env)\n                        env tail?)))\n\n\n(defn- compile-av-application\n  [operator operands env tail? macro-env]\n  (cond\n    (apply-call? env operator) (compile-apply operands env tail? macro-env)\n\n    ;; (:k m) / (:k m default): a static lookup.\n    (keyword? operator)\n    (do (when-not (<= 1 (count operands) 2)\n          (reject! \"A keyword call takes a map and an optional default\"\n                   {:keyword operator}))\n        (when (and (not (outcomes? env)) (contains? (locals env) 'get))\n          (reject! \"A local binding of get would capture a keyword lookup\"\n                   {:keyword operator}))\n        (let [coll (compile-form (first operands) false env macro-env)\n              args (into [(if (outcomes? env)\n                            (u/app (u/v 'clj/condition-view) coll)\n                            coll)\n                          (compile-literal operator false)]\n                         (map #(compile-form % false env macro-env))\n                         (rest operands))]\n          (cond-> (apply u/app (u/v (if (outcomes? env)\n                                      (if (= 2 (count args)) 'clj/prim-get 'clj/prim-get-default)\n                                      'get))\n                         args)\n            tail? (assoc :tail? true))))\n\n    (and (outcomes? env) (= operator 'yang.call/eligible?))\n    (cond-> (apply u/app (u/v 'clj/admitted-callable?)\n                   (map #(compile-form % false env macro-env) operands))\n      tail? (assoc :tail? true))\n\n    (and (outcomes? env)\n         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n         (<= 4 (count operands)))\n    (let [bindings (into ['dsg__invocation_candidate]\n                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n                         (range (dec (count operands))))\n          compile-operand #(compile-form % false env macro-env)]\n      (cond-> (u/mark-tails\n                (apply u/app\n                       (u/lam bindings\n                              (u/if-node\n                                (u/app (u/v 'clj/admitted-callable?) (u/v (first bindings)))\n                                (apply u/app (u/v operator) (map u/v bindings))\n                                (u/app (u/v 'yang.call/transfer)\n                                       (u/v (nth bindings 3))\n                                       (u/app (u/v 'yang.call/condition)\n                                              (u/lit :yang.call/not-callable)\n                                              (u/app (u/v 'clj/prim-assoc) (u/lit {})\n                                                     (u/lit :yang.call/callee)\n                                                     (u/v (first bindings)))))))\n                       (map compile-operand operands)))\n        tail? (assoc :tail? true)))\n\n    (and (symbol? operator)\n         (contains? (::local-fns env) operator)\n         (not (contains? (locals env) operator)))\n    (cond-> (u/app (u/v 'dsg__invoke_local)\n                   (compile-form operator false env macro-env)\n                   (compile-form (vec operands) false env macro-env)\n                   (u/lit (strip-symbol-meta operator))\n                   (guest-call-dispatch env tail?))\n      tail? (assoc :tail? true))\n\n    ;; A native lookup projects a carrier only for observation. The original\n    ;; reference remains available for saving or rethrowing.\n    (native-name? env operator)\n    (cond-> {:type :application\n             :operator (cond-> {:type :variable, :name operator}\n                         (seq (meta operator)) (with-meta (meta operator)))\n             :operands (mapv (fn [i operand]\n                               (let [ast (compile-form operand false env macro-env)]\n                                 (if (and (outcomes? env) (= operator 'get) (zero? i))\n                                   (u/app (u/v 'clj/condition-view) ast)\n                                   ast))) (range) operands)}\n      tail? (assoc :tail? true))\n\n    ;; a compiler-internal helper introduced by the pre-pass (the exception\n    ;; accessors): a direct application, never a guest invocation\n    (and (symbol? operator) (reserved-name? operator))\n    (cond-> {:type :application\n             :operator (cond-> {:type :variable, :name operator}\n                         (seq (meta operator)) (with-meta (meta operator)))\n             :operands (mapv #(compile-form % false env macro-env) operands)}\n      tail? (assoc :tail? true))\n\n    ;; anything else: one guest invocation, in tail position when the call is\n    :else\n    (compile-guest-call (compile-form operator false env macro-env)\n                        (compile-form (vec operands) false env macro-env)\n                        env tail?)))\n\n\n(defn compile-application\n  \"Compile a function application to Universal AST.\n\n  Clojure: (+ 1 2)\n  AST: {:type :application\n        :operator <compiled-operator>\n        :operands [<compiled-operand1> <compiled-operand2>]}\n\n  Under the argument-vector convention a user-function call passes its\n  operands as one vector.\"\n  ([operator operands env tail?] (compile-application operator operands env tail? initial-macro-env))\n  ([operator operands env tail? macro-env]\n   (if (and (::convention env) (not (macro-call? env macro-env operator)))\n     (compile-av-application operator operands env tail? macro-env)\n     (let [compiled-operator (compile-form operator false env macro-env)\n           compiled-operands (mapv #(compile-form % false env macro-env) operands)]\n       (cond-> {:type :application,\n                :operator compiled-operator,\n                :operands compiled-operands}\n         tail? (assoc :tail? true))))))\n\n\n(defn- local-fn-names\n  \"Names defined by this unit's own defn forms. With expander-side\n   macros the compiler cannot identify the unit's definitions.\"\n  [forms macros]\n  (when-not (or (seq macros)\n                (some #(and (seq? %) (= 'defmacro (first %))) forms))\n    (into #{}\n          (comp (filter #(and (seq? %) (#{'defn 'defn-} (first %))\n                             (symbol? (second %))))\n                (map (comp strip-symbol-meta second)))\n          forms)))\n\n\n(defn- program-env\n  \"The compile-time env of one program. Without `opts` it is empty: the\n   native path. `{:convention :arg-vector, :native #{symbol}, :macros\n   #{symbol}}` opts into the argument-vector convention: `:native` names the\n   primitives a bare symbol may call directly (a set, or a map from name to\n   its published profile, whose `:yin.k/arities` give an adapter its admitted\n   counts), `:macros` the expander-side\n   macro names whose calls must stay ordinary applications. The program's\n   own top-level definitions are never native. `:outcomes true` selects the\n   continuation lane (see its section); the `:adapters` opt is accepted for\n   compatibility but no longer consulted — the outcome adapters are retired.\"\n  [forms opts]\n  (if-not opts\n    {}\n    (do (when-not (= :arg-vector (:convention opts))\n          (reject! \"Unknown compile-program convention\" {:opts opts}))\n        (when-let [hit (seq (filter control-heads (:macros opts)))]\n          (reject! \"A :macros entry names a compiler form\" {:macros (vec hit)}))\n        (let [defined (into #{}\n                            (keep (fn [f]\n                                    (when (and (seq? f)\n                                               (contains? #{'def 'defn 'defn- 'defmacro} (first f))\n                                               (symbol? (second f)))\n                                      (strip-symbol-meta (second f)))))\n                            forms)]\n          ;; the compiler emits bare conj and vec (collection literals, apply),\n          ;; so a program definition of either would capture them\n          (when-let [hit (first (filter #{'conj 'vec} defined))]\n            (reject! (str \"Defining \" hit \" would capture the argument-vector constructor\")\n                     {:name hit}))\n          (cond-> {::convention {:native (set (if (map? (:native opts))\n                                                (keys (:native opts))\n                                                (:native opts)))\n                                 :arities (into {}\n                                                (keep (fn [[sym profile]]\n                                                        (when-let [a (if (map? profile)\n                                                                       (:yin.k/arities profile)\n                                                                       profile)]\n                                                          [sym a])))\n                                                (when (map? (:native opts)) (:native opts)))\n                                 :macros (set (:macros opts))}\n                   ::defined defined\n                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n                                                  (= 'invoke-value (second %))\n                                                  (:yin.k/invoker (meta (second %)))) forms))}\n            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}\n                                    ::local-fns (local-fn-names forms (:macros opts))))))))\n\n\n(defn- check-program-symbols!\n    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n    (coll? form) (run! check-program-symbols! form)))\n\n\n(defn- lower-top-form\n  \"A non-definition top-level expression lowers like a function body (plain\n   values, `throw`/`try` onto the continuation family); definitions keep\n   their own lowering.\"\n  [env macro-env form]\n  (if (and (seq? form) (contains? #{'def 'defn 'defn- 'defmacro} (first form)))\n    form\n    (lower-function-body env macro-env [] [form])))\n\n\n(def ^:private local-call-runtime\n  ;; Both lexical helpers share a task-owned table of this unit's definitions.\n  ;; Reuse the caller's clj context when the callable matches the definition\n  ;; we just installed. A redefinition or cell edit takes the normal route.\n  '[(fn [name meta body]\n      (let [owner (clj/make-callable meta body)\n            descriptor (cell/get owner)\n            local-entry (if (clj/prim-get meta :clj/tail-call?)\n                          (fn [args] (body args clj/invoke-callable))\n                          body)]\n        (do (cell/set! dsg__local_fns\n              (clj/prim-assoc (cell/get dsg__local_fns) name\n                (conj [] owner descriptor local-entry)))\n            owner)))\n    (fn [callee args name dispatch]\n      (let [registered (clj/prim-get (cell/get dsg__local_fns) name)]\n        (if (if registered\n              (if (data/content= (data/nth registered 0) callee)\n                (data/content= (data/nth registered 1) (cell/get callee))\n                false)\n              false)\n          ((data/nth registered 2) args)\n          (dsg__invoke_dynamic callee args dispatch))))])\n\n\n(defn- with-runtime\n  \"Wrap a unit in its clj entry boundary and install the bundled runtime.\"\n  [ast linked? env]\n  (let [ast (if (seq (::local-fns env))\n              (u/let1 'dsg__local_fns (u/sexp->uast '(cell/new {}))\n                (u/let1 'dsg__invoke_dynamic\n                  (u/lam '[callee args dispatch]\n                         (guest-call-routing (u/v 'callee) (u/v 'args) (u/v 'dispatch) env))\n                  (apply u/app (u/lam '[dsg__make_local dsg__invoke_local] ast)\n                         (map u/sexp->uast local-call-runtime))))\n              ast)\n        unit (u/app (u/v 'clj/run-unit) (u/lam [] ast))\n        helpers (u/let1 'dsg__ex_message (u/sexp->uast ex-message-form)\n                        (u/let1 'dsg__ex_data (u/sexp->uast ex-data-form) unit))]\n    (if linked?\n      helpers\n      (prelude/with-bundled-runtime helpers))))\n\n\n(defn compile-program\n  \"Compile a sequence of Clojure forms into a single Universal AST.\n   Top-level defs compile to explicit yin/def store writes, sequenced via lambda.\n   Top-level defmacros are lowered to ordinary (yin/def name (fn ...)) syntax\n   with :macro? true on the lambda; the encoder turns that flag into a\n   declaration row and the expander, not this compiler, recognizes calls.\n   The three-argument form takes `opts` opting into the argument-vector\n   convention (see `program-env`); without it the output is the native one.\"\n  ([forms] (compile-program forms true))\n  ([forms tail?] (compile-program forms tail? nil))\n  ([forms tail? opts]\n   (run! check-program-symbols! forms)\n   (let [env (program-env forms opts)]\n     ;; A discarded definition must not become a lexical binding in the\n     ;; following definitions. Descriptor entry and body closures both capture\n     ;; their environment: retaining the previous descriptor here doubles its\n     ;; paths at each definition during machine-data validation and UCF lift.\n     (letfn [(discard-result\n               [ast]\n               (if (outcomes? env) (u/then ast (u/lit nil)) ast))\n             (go\n               [forms macro-env]\n               (if (empty? forms)\n                 (compile-literal nil tail?)\n                 (let [head       (cond->> (first forms)\n                                    (outcomes? env) (lower-top-form env macro-env))\n                       rest-forms (rest forms)]\n                   (cond\n                     ;; defmacro: ordinary (yin/def name (fn ...)) syntax whose\n                     ;; lambda the encoder declares; later forms see the name\n                     ;; only so the native defn lowering can yield to it.\n                     (and (seq? head) (= 'defmacro (first head)))\n                     (let [defined (compile-defmacro (rest head) env false macro-env)]\n                       (cond-> {:type     :application\n                                :operator {:type :lambda, :params ['_]\n                                           :body (go rest-forms\n                                                     (assoc macro-env\n                                                            (strip-symbol-meta (second head))\n                                                            {:type :user}))}\n                                :operands [(discard-result defined)]}\n                         tail? (assoc :tail? true)))\n                     ;; def: sequence with current macro-env\n                     (and (seq? head) (= 'def (first head)))\n                     (let [[_ name value] head\n                           value (if (outcomes? env)\n                                   (lower-function-body env macro-env [] [value])\n                                   value)]\n                       (cond-> {:type     :application\n                                :operator {:type :lambda, :params ['_]\n                                           :body (go rest-forms macro-env)}\n                                :operands [(discard-result (compile-def name value env false macro-env))]}\n                         tail? (assoc :tail? true)))\n                     ;; single form\n                     (= 1 (count forms))\n                     (compile-form head tail? (assoc env ::top-level true) macro-env)\n                     ;; sequence\n                     :else\n                     (cond-> {:type     :application\n                              :operator {:type :lambda, :params ['_]\n                                         :body (go rest-forms macro-env)}\n                              :operands [(discard-result\n                                           (compile-form head false\n                                                         (assoc env ::top-level true) macro-env))]}\n                       tail? (assoc :tail? true))))))]\n       (annotate-call-sites\n         (cond->> (go forms initial-macro-env)\n           (outcomes? env) (#(with-runtime % (:linked-runtime opts) env))\n           (outcomes? env) tails/remark-tails))))))\n\n\n;; =============================================================================\n;; The guest collection and higher-order library (slice 7)\n;; =============================================================================\n;;\n;; Guest-side source, compiled through this compiler like any program: the\n;; functions that invoke guest closures (map, filter, reduce, comp, partial)\n;; must run on the VM, never on the host, because a closure is a VM value. It\n;; is written for the argument-vector convention with the outcome model, so a\n;; closure it calls is unwrapped by the compiler's own early-return pattern\n;; and a closure's failure ends the library function with the same outcome.\n;;\n;; What is derived, from the VM primitives and the `data` module only:\n;; identity, inc/dec, second, the collection predicates (coll?/vector?/map?/\n;; set?/seq?/list?/sequential?, from the `data/*` and `kind/*` host\n;; predicates), boolean?,\n;; fn? (data/callable?), seq, rem, reverse, list, cons, vector, count,\n;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\n;; keys/vals/disj and set union/difference,\n;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\n;; compiler intrinsic over the convention's argument vector.\n;;\n;; What stays a host primitive, named by the `kind` module: a symbol, a\n;; keyword and a host string are distinguished or built only by the host\n;; (symbol?, keyword?, name, symbol, keyword, str, int?), as is metadata access\n;; (meta and with-meta). The current data ABI has no metadata-write export,\n;; so with-meta is an explicit pure representation seam, not an ambient store.\n;; No VM primitive tells a symbol from a keyword. Clojure Var identity is an\n;; explicitly admitted kind/var? seam on the JVM; namespace lookup (resolve)\n;; still requires a separately installed host capability.\n;;\n;; Known compromises: `reduced` is an untyped tagged map, so reduced? matches\n;; any map holding :yin.k/reduced true; seq refuses a non-collection (a string\n;; is the data module's str-* ops, not a seq); eager sequences are lists;\n;; rem rejects non-integers and a zero divisor before arithmetic; the compiler\n;; emits bare conj and vec, so a program may not define or bind either.\n;; When collection calls are needed, invoke-value is a library helper whose\n;; local capture is refused explicitly.\n;;\n;; Variadic Clojure functions are fixed-arity here (the convention has no\n;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\n;; merge 0 to 4, union 0 to 6, difference 2, comp 0 to 3, partial binds 1 to 3.\n;; A larger count is the\n;; function's own arity error.\n\n(def library-adapters prelude/library-adapters)\n\n(def kind-module prelude/kind-module)\n\n(def kind-arities prelude/kind-arities)\n\n\n(def library\n  \"The library's definitions, in order, as quoted source.\"\n  '[(defn identity\n      [x]\n      x)\n    (defn inc\n      [x]\n      (+ x 1))\n    (defn dec\n      [x]\n      (- x 1))\n    (defn second\n(defn library-for\n  \"The definitions of `library` that `forms` need: those whose names `forms`\n   mention (outside quoted data), and the ones those mention in turn, in\n   library order. Compiling only these keeps a program small.\"\n  [forms]\n  (let [by-name (into {} (map (fn [f] [(second f) f])) library)\n        mentions (fn mentions\n                   [form]\n                   (cond\n                     (symbol? form) #{form}\n                     (seq? form) (if (= 'quote (first form))\n                                   #{}\n                                   (into #{} (mapcat mentions) form))\n                     (coll? form) (into #{} (mapcat mentions) form)\n                     :else #{}))\n        defined (into #{} (comp (filter seq?) (filter #(= 'defn (first %))) (map second)) forms)\n        needed (loop [todo (remove defined (mentions forms)), seen #{}]\n                 (if (empty? todo)\n                   seen\n                   (let [n (first todo)]\n                     (if (or (contains? seen n) (not (contains? by-name n)))\n                       (recur (rest todo) seen)\n                       (recur (into (rest todo)\n                                    (remove (conj defined n) (mentions (by-name n))))\n                              (conj seen n))))))]\n    (letfn [(nodes\n              [form]\n              (cons form (when (and (coll? form) (not (and (seq? form) (= 'quote (first form)))))\n                           (mapcat nodes form))))\n            (dynamic-call?\n              [source]\n              (let [tree (nodes source)\n                    possible-locals (into #{} (comp (filter vector?) (mapcat identity) (filter symbol?)) tree)]\n                (some (fn [x]\n                        (and (seq? x) (seq x) (not= 'quote (first x))\n                             (or (contains? possible-locals (first x))\n                                 (and (not (symbol? (first x))) (not (keyword? (first x))))))) tree)))\n            (close\n              [todo seen]\n              (if-let [n (first todo)]\n                (if (or (contains? seen n) (contains? defined n) (not (contains? by-name n)))\n                  (recur (rest todo) seen)\n                  (recur (concat (rest todo) (mentions (by-name n))) (conj seen n))) seen))]\n      (let [source (concat forms (map by-name needed))\n            needed (if (some dynamic-call? source) (close ['invoke-value] needed) needed)]\n        (filterv #(contains? needed (second %)) library)))))\n\n\n(defn compile\n  \"Main compiler entry point.\n\n  Compiles a Clojure form into Yin VM Universal AST.\n\n  Examples:\n    (compile 42)\n    => {:type :literal, :value 42}\n\n    (compile '(+ 1 2))\n    => {:type :application\n        :operator {:type :variable, :name +}\n        :operands [{:type :literal, :value 1}\n                   {:type :literal, :value 2}]}\n\n    (compile '(fn [x] (* x 2)))\n    => {:type :lambda\n        :params [x]\n        :body {:type :application\n               :operator {:type :variable, :name *}\n               :operands [{:type :variable, :name x}\n                          {:type :literal, :value 2}]}}\"\n  [form]\n  ;; the single-form entry runs the same reserved-prefix pre-pass as\n  ;; `compile-program`, so a REPL one-liner can no more spell a\n  ;; compiler-private (`dsg__`) name than a whole program can. Trusted\n  ;; compiler construction never reaches `compile`: it builds its own\n  ;; `dsg__` temporaries via `compile-form` directly.\n  (check-program-symbols! form)\n  (compile-form form true {}))\n\n\n;; =============================================================================\n;; The linked runtime entry (the conformance matrix round, yang.antlr.md\n;; section 8.10)\n;; =============================================================================\n;;\n;; A linked clojure program is published as an ordinary linker module whose\n;; one export, `body`, is its unmodified lowered unit, and run under its own\n;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\n;; `read-forms` is the frontend's parser — the reader itself — and\n;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n;; whose call runs the program compiled under the argument-vector\n;; convention and the outcome model over the guest library, with every\n;; top-level definition published to the runtime global namespace\n;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n;; its module's globals. No call node is rewritten and no foreign\n;; `:code` is extracted: the unit is the program's own lowering,\n;; wrapped.\n\n(def unit-opts\n  \"The `compile-program` opts a linked unit compiles with: the\n   argument-vector convention with the outcome model over the guest\n   library's adapters. The required clj module supplies the continuation\n   family; VM primitives are callable directly by bare name.\"\n  {:convention :arg-vector,\n   :outcomes true,\n   :linked-runtime true,\n   :adapters library-adapters,\n   :native vm/primitive-profiles})\n\n\n(def top-defining-operators\n  \"The operators whose second element names a top-level definition.\"\n  '#{def defn defn- defmacro})\n\n\n(defn read-forms\n  \"Every form `source` text reads. The reader is the parser: a malformed\n   source throws, as any frontend's refused parse does.\n\n   Source-string compilation is a JVM/Node capability (tools.reader is\n   an mvn dependency, absent from the jolt host's source-root classpath\n   — the jolt lane loads compiled output and ships source strings to\n   remote evaluators, so this is unreachable there; the honest error\n   says so if ever reached).\"\n  [source]\n  #?(:cljd (throw (ex-info \"Source-string compilation requires the JVM/Node reader; ClojureDart compiles from forms\"\n                           {:yang.clojure/reader :unavailable-on-cljd}))\n     :jolt (throw (ex-info \"Source-string compilation requires the JVM/Node reader; the jolt host compiles from forms or delegates source reading to its remote evaluators\"\n                           {:yang.clojure/reader :unavailable-on-jolt}))\n     :default\n     (let [rd (rt/string-push-back-reader source)]\n       (loop [forms []]\n         (let [form (treader/read rd false ::eof)]\n           (if (= form ::eof)\n             forms\n             (recur (conj forms form))))))))\n\n\n(defn top-level-names\n  \"The names `forms` define at the top level, in order: the second element\n   of each def/defn/defn-/defmacro head.\"\n  [forms]\n  (into []\n        (comp (filter #(and (seq? %) (contains? top-defining-operators (first %))))\n              (map (comp strip-symbol-meta second)))\n        forms))\n\n\n(declare publish-to-globals)\n\n\n(defn- globals-child\n  [x names bound]\n  (cond\n    (and (map? x) (contains? x :type)) (publish-to-globals x names bound)\n    (vector? x) (mapv #(globals-child % names bound) x)\n    :else x))\n\n\n(defn- publish-to-globals\n  \"Rewrite the compiled `node` for the linked unit: a top-level\n   definition in `names` becomes a `clj/define-global!` write and a free\n   read of one becomes a `clj/global-get`, both under the name's string.\n   The `names` a unit is lowered with are its own top-level definitions,\n   its guest library's and the projected names the composition bound in\n   the runtime global namespace, so a projected export and a definition\n   read through the one binding: a definition the unit itself runs\n   publishes after the projection and shadows it. A store definition\n   inside the unit thunk is conditional to the linker, so no body read\n   of it discharges (the runtime preludes avoid this by keeping every\n   definition at module level); the runtime global namespace is the\n   linked unit's definition table instead, as a Python module body\n   writes its dictionary. Lexically bound names, quoted literals and\n   macro definitions keep their store shape: a macro is not a runtime\n   value.\"\n  [node names bound]\n  (case (:type node)\n    :literal node\n    :vm/current-continuation node\n    :variable (if (and (contains? names (:name node))\n                       (not (contains? bound (:name node))))\n                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\n                node)\n    :lambda (assoc node :body (publish-to-globals (:body node) names\n                                                  (into bound (:params node))))\n    :application\n    (if (and (= 'yin/def (get-in node [:operator :name]))\n             (= 2 (count (:operands node)))\n             (= :literal (:type (first (:operands node))))\n             (contains? names (:value (first (:operands node)))))\n      (u/app (u/v 'clj/define-global!)\n             (u/lit (str (:value (first (:operands node)))))\n             (publish-to-globals (second (:operands node)) names bound))\n      (assoc node\n             :operator (publish-to-globals (:operator node) names bound)\n             :operands (mapv #(publish-to-globals % names bound)\n                             (:operands node))))\n    :if (cond-> node\n          (contains? node :test)\n          (assoc :test (publish-to-globals (:test node) names bound))\n          (contains? node :consequent)\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n          (contains? node :alternate)\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n    (reduce (fn [n k]\n              (let [v (get n k)]\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\n                  (assoc n k (globals-child v names bound))\n                  n)))\n            node (keys node))))\n\n\n(defn lower-unit\n  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n   thunk whose call runs the program — `forms` plus the definitions of\n   the guest library they need, compiled unmodified under `unit-opts`\n   and published to the runtime global namespace by\n   `publish-to-globals` — so the helper's export projection can read\n   each top-level definition. The two-argument form also takes the\n   projected `exports` (names the composition already bound in the\n   runtime global namespace): their free reads publish the same way, so\n   the projection is the caller's binding for them. The program's own\n   `yang.call` call sites need no free-name declaration: the convention\n   preamble `compile-program` emits defines those names locally, and\n   the donor publication pins the `yang.call` module for the qualified\n   reads that remain.\"\n  ([forms] (lower-unit forms []))\n  ([forms exports]\n   (let [source (vec forms)\n         library (library-for source)\n         program (compile-program (concat source library) true unit-opts)\n         macros (into #{}\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n                            (map (comp strip-symbol-meta second)))\n                      (concat source library))\n         names (reduce disj\n                       (into (set (top-level-names source))\n                             (concat (map (comp strip-symbol-meta second) library)\n                                     (map symbol exports)))\n                       macros)]\n     ;; `publish-to-globals` rewrites nodes after `compile-program`\n     ;; finalized them, so the unit is finalized again over its\n     ;; finished tree: the rewrite's own applications are occurrences.\n     (annotate-call-sites (u/lam [] (publish-to-globals program names #{}))))))\n\n\n(defn output\n