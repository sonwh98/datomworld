{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2de57fafbaa543beac70171c","type":"tool_result","content":"210\t                     :requires {'yang.call call-address},\n211\t                     :free-names module-free-names,\n212\t                     :skip? #(= \"yang.call\" (namespace %)),\n213\t                     :registry registry,\n214\t                     :message \"the clj module reads an undeclared name\",\n215\t                     :refusal-ns \"yang.clojure\"}))\n216\t\n217\t\n218\t(defn register-library-module\n219\t  \"Return `registry` with host module `name` installed over `entries`\n220\t   (`[export function]` pairs) at `arities`, each export pure.\"\n221\t  [registry name entries arities]\n222\t  (module/register-host-module\n223\t    registry name\n224\t    (into {} entries)\n225\t    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n226\t          entries)))\n227\t\n228\t\n229\t(defn admit\n230\t  \"Return `registry` with the guest library's host surface installed: the\n231\t   `kind` module and the `portable` adapters of the data exports the\n232\t   collection predicates read (yang.clojure's `library-adapters`). A\n233\t   linked clojure composition registers them beside the other runtimes'\n234\t   registry surfaces; a composition without a clojure program reads none\n235\t   of them.\"\n236\t  [registry]\n237\t  (let [portable (into {}\n238\t                       (map (fn [[source _]]\n239\t                              (let [op (symbol (name source))]\n240\t                                [op (yang/outcome-adapter data/refusal-message\n241\t                                                          (get data/data-module op))])))\n242\t                       yang/library-adapters)]\n243\t    (-> registry\n244\t        (register-library-module 'kind yang/kind-module yang/kind-arities)\n245\t        (register-library-module\n246\t          'portable portable\n247\t          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n248\t                (keys portable))))))\n249\t"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"27fee005-9f80-4ece-a2c8-fd4162301549","timestamp":"2026-11-18T16:42:37.195Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/src/cljc/yang/clojure/prelude.cljc","content":"                     :requires {'yang.call call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the clj module reads an undeclared name\",\n                     :refusal-ns \"yang.clojure\"}))\n\n\n(defn register-library-module\n  \"Return `registry` with host module `name` installed over `entries`\n   (`[export function]` pairs) at `arities`, each export pure.\"\n  [registry name entries arities]\n  (module/register-host-module\n    registry name\n    (into {} entries)\n    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n          entries)))\n\n\n(defn admit\n  \"Return `registry` with the guest library's host surface installed: the\n   `kind` module and the `portable` adapters of the data exports the\n   collection predicates read (yang.clojure's `library-adapters`). A\n   linked clojure composition registers them beside the other runtimes'\n   registry surfaces; a composition without a clojure program reads none\n   of them.\"\n  [registry]\n  (let [portable (into {}\n                       (map (fn [[source _]]\n                              (let [op (symbol (name source))]\n                                [op (yang/outcome-adapter data/refusal-message\n                                                          (get data/data-module op))])))\n                       yang/library-adapters)]\n    (-> registry\n        (register-library-module 'kind yang/kind-module yang/kind-arities)\n        (register-library-module\n          'portable portable\n          (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n                (keys portable))))))\n","numLines":40,"startLine":210,"totalLines":249}},"tool_result_meta":[{"id":"call_2de57fafbaa543beac70171c","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
