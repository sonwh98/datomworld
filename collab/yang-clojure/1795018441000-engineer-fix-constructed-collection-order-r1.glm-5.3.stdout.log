roots) \"every constructed map in the entry agrees\")\n            (is (= (find-map (:compile-form asts)) (first roots))\n                \"the entry agrees with plain compile-form\"))))))\n  (testing \"compiler-generated maps (the arity helper) are covered\"\n    (is (ascending?\n          (pair-keys (first (arity-map-constructors\n                              (yang/compile-program cohort-forms\n                                                    true yang/unit-opts)))))))\n  (testing \"a macro whose expansion constructs a map: expansion origins stay\n            unfabricated and the expansion output is canonically ordered\"\n    (let [ast (yang/compile-program\n                @[(defmacro tag-pair\n                    [k v]\n                    (array-map k v))\n                  (tag-pair (first xs) :v)]@)\n          {:keys [ctx result]} (expand-like-the-repl ast)\n          {:keys [status tree frontend-metadata log]} result\n          admission [:source :program-in (:t ctx) 0]\n          event-addrs (into #{} (map first) (nth log 1))\n          origins (into #{}\n                        (comp (filter #(= :yang/call-site (nth % 3)))\n                              (map first))\n                        frontend-metadata)\n          rows (macro/packet->row-set tree)\n          ctors (->> (vals (:rows rows))\n                     (filter (fn [r] (= :application (nth r 1))))\n                     ;; find assoc rows over the {} seed by their operator\n                     )]\n      (is (= :ok status))\n      (is (every? (fn [o]\n                    (or (= o admission)\n                        (and (vector? o) (= :expansion (first o))\n                             (contains? event-addrs (second o)))))\n                  origins)\n          \"no fabricated expansion origin\")\n      (is (seq frontend-metadata))\n      (is (seq origins)))))\n\n\n(defn- expand-like-the-repl\n  \"The REPL production expansion stages over compiled `ast` (the callsite\n   battery@s helper, l