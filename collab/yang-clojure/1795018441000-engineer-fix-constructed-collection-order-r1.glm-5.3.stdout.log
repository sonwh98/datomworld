 v1 ...}  => (assoc {} k1 v1 k2 v2 ...)\"\n310\t  [form tail? env macro-env]\n311\t  (let [ctor (cond\n312\t               (vector? form) ['conj []]\n313\t               (set? form) ['conj #{}]\n314\t               :else ['assoc {}])\n315\t        [op seed] ctor\n316\t        args (if (map? form)\n317\t               (into [] (interleave (keys form) (vals form)))\n318\t               (vec form))\n319\t        call {:type :application,\n320\t              :operator {:type :variable, :name op},\n321\t              :operands (into [{:type :literal, :value seed}]\n322\t                              (map #(compile-form % false env macro-env) args))}]\n323\t    (cond-> call tail? (assoc :tail? true))))\n324\t\n325\t\n326\t(def initial-macro-env\n327\t  \"Compile-time map of macro names known before any defmacro: none. The\n328\t   standard forms live in the expander's store, not here.\"\n329\t  {})\n330\t\n331\t\n332\t(defn- shadow-macro-env\n333\t  \"Remove shadowed names from the macro environment.\"\n334\t  [macro-env names]\n335\t  (apply dissoc macro-env names))\n336\t\n337\t\n338\t(defn- strip-symbol-meta\n339\t  \"Return an equal symbol without reader metadata.\"\n340\t  [sym]\n341\t  (if (namespace sym)\n342\t    (symbol (namespace sym) (name sym))\n343\t    (symbol (name sym))))\n344\t\n345\t\n346\t(defn- body-expression\n347\t  [body-forms]\n348\t  (cond\n349\t    (empty? body-forms) nil\n350\t    (= 1 (count body-forms)) (first body-forms)\n351\t    :else (cons 'do body-forms)))\n352\t\n353\t\n354\t(defn- mentions-recur?\n355\t  \"True when `form` holds a recur that could target the enclosing function:\n356\t   quoted data and nested fn/loop/def forms own their own recurs.\"\n357\t  [form]\n358\t  (cond\n359\t    (seq? form) (let [head (first form)]\n360\t                  (cond\n361\t                    (= 'recur head) true\n362\t                    (contains? #{'quote 'fn 'loop 'defn 'defn- 'defmacro} head) false\n363\t                    :else (boolean (some mentions-recur? form))))\n364\t    (coll? form) (boolean (some mentions-recur? form))\n365\t    :else false))\n366\t\n367\t\n368\t;; =============================================================================\n369\t;; Sequential destructuring (slice 3)\n370\t;; =============================================================================\n371\t;;\n372\t;; A destructuring pattern lowers to ordinary symbol bindings over one\n373\t;; evaluated temporary, walked with the VM's total primitives first/rest/\n374\t;; empty? (the data module's `nth` is vector-only and refuses a list, but\n375\t;; LaTTe terms are lists):\n376\t;;\n377\t;;   [a b & r :as w] against t\n378\t;;   =>  a (first t)    c1 (rest t)\n379\t;;       b (first c1)   c2 (rest c1)\n380\t;;       r (if (empty? c2) nil c2)                        ; nthnext\n381\t;;       w t\n382\t;;\n383\t;; A nil input, a missing element and an exhausted `&` tail all yield nil,\n384\t;; as in Clojure. A non-nil remainder is a vector, the VM `rest` contract.\n385\t;; Those primitives are bare names a local binding could shadow, so a\n386\t;; destructuring form is rejected wherever first, rest or empty? is bound\n387\t;; locally. Under the convention, a guest rest definition uses raw data\n388\t;; cursors instead; previously stored definitions are not detectable here.\n389\t;; Generated names carry the reserved `dsg__` prefix and derive from the\n390\t;; binding's position, so lowering is deterministic.\n391\t\n392\t(def ^:private helper-names\n393\t  (set (map symbol [\"first\" \"rest\" \"empty?\"])))\n394\t\n395\t\n396\t(defn- locals\n397\t  [env]\n398\t  (::locals env #{}))\n399\t\n400\t\n401\t(defn- with-locals\n402\t  [env names]\n403\t  (when-let [hit (and (::convention env) (some #{'conj 'vec} names))]\n404\t    (throw (ex-info (str \"Binding \" hit \" would capture the argument-vector constructor\")\n405\t                    {:names names})))\n406\t  (when (and (::invoker env) (some #{'invoke-value} names))\n407\t  