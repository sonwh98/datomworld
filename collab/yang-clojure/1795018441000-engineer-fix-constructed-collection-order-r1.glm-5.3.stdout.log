{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_6d44dc59e7244283880385aa","type":"tool_result","content":"2015\t                            (let [[c d] [(id b) (id a)]] [c d]))\n2016\t                          (f [1 2])])))\n2017\t    (is (= [:yin.k/ok :y]\n2018\t           (run-outcome '[(defn id\n2019\t                            [x]\n2020\t                            x) (defn f\n2021\t                                 [a]\n2022\t                                 (or (id nil) (and (id a) :y))) (f 1)])))))\n2023\t\n2024\t\n2025\t(deftest test-outcome-arity-names-the-function\n2026\t  (let [forms '[(defn f\n2027\t                  ([x] x)\n2028\t                  ([x y] y))]]\n2029\t    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/fn 'f, :yin.k/argc 3}]\n2030\t           (run-outcome (conj forms '(f 1 2 3)))))\n2031\t    (is (= [:yin.k/ok 2] (run-outcome (conj forms '(f 1 2)))))))\n2032\t\n2033\t\n2034\t(deftest test-outcome-primitive-adapter\n2035\t  ;; The `:adapters` outcome adapters are retired: a data/nth refusal is now\n2036\t  ;; a host refusal (not an `[:yin.k/error ...]` outcome), since the outcome\n2037\t  ;; model no longer adapts primitives. The host `outcome-adapter` helper\n2038\t  ;; itself is unchanged and still catches only the module's own refusal.\n2039\t  (is (= [:yin.k/ok 2] (run-outcome '[(data/nth [1 2] 1)])))\n2040\t  (testing \"retired adapters leave the original data/nth host refusal intact\"\n2041\t    (let [failure (try (run-outcome '[(data/nth [1 2] 5)])\n2042\t                       nil\n2043\t                       (catch clojure.lang.ExceptionInfo e e))]\n2044\t      (is (= data/refusal-message (some-> failure ex-message)))\n2045\t      (is (= 'nth (:yin.vm.data/op (ex-data failure))))\n2046\t      (is (= :out-of-range (:yin.vm.data/reason (ex-data failure))))))\n2047\t  (testing \"the adapter catches only the module's own refusal\"\n2048\t    (let [other (yang/outcome-adapter\n2049\t                  data/refusal-message\n2050\t                  (fn [] (throw (ex-info \"other\" {:yin.vm.data/op 'x, :yin.vm.data/reason :y}))))]\n2051\t      (is (thrown-with-msg? clojure.lang.ExceptionInfo #\"other\" (other))))\n2052\t    (let [npe (yang/outcome-adapter data/refusal-message\n2053\t                                    (fn [] (throw (NullPointerException.))))]\n2054\t      (is (thrown? NullPointerException (npe))))))\n2055\t\n2056\t\n2057\t(deftest test-outcome-native-path-emits-none\n2058\t  (let [forms '[(defn f\n2059\t                  [x]\n2060\t                  (throw (ex-info \"t\" {}))) (defn g\n2061\t                                              [x]\n2062\t                                              (+ x 1)) (g 1)]]\n2063\t    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true av-opts)))\n2064\t        \"the convention without :outcomes carries no outcome tags\")\n2065\t    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program '[(defn g\n2066\t                                                                        [x]\n2067\t                                                                        (+ x 1)) (g 1)]))))\n2068\t    (is (some #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true outcome-opts))))))\n2069\t\n2070\t\n2071\t(deftest test-outcome-common-call-depth\n2072\t  (let [prog (fn [defs n] (yang/compile-program (conj defs (list 'cnt n)) true outcome-opts))\n2073\t        three '[(defn c\n2074\t                  [n]"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"edd0fd63-7296-4081-b57b-e7329801d6b9","timestamp":"2026-11-18T16:42:53.038Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_test.clj","content":"                            (let [[c d] [(id b) (id a)]] [c d]))\n                          (f [1 2])])))\n    (is (= [:yin.k/ok :y]\n           (run-outcome '[(defn id\n                            [x]\n                            x) (defn f\n                                 [a]\n                                 (or (id nil) (and (id a) :y))) (f 1)])))))\n\n\n(deftest test-outcome-arity-names-the-function\n  (let [forms '[(defn f\n                  ([x] x)\n                  ([x y] y))]]\n    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/fn 'f, :yin.k/argc 3}]\n           (run-outcome (conj forms '(f 1 2 3)))))\n    (is (= [:yin.k/ok 2] (run-outcome (conj forms '(f 1 2)))))))\n\n\n(deftest test-outcome-primitive-adapter\n  ;; The `:adapters` outcome adapters are retired: a data/nth refusal is now\n  ;; a host refusal (not an `[:yin.k/error ...]` outcome), since the outcome\n  ;; model no longer adapts primitives. The host `outcome-adapter` helper\n  ;; itself is unchanged and still catches only the module's own refusal.\n  (is (= [:yin.k/ok 2] (run-outcome '[(data/nth [1 2] 1)])))\n  (testing \"retired adapters leave the original data/nth host refusal intact\"\n    (let [failure (try (run-outcome '[(data/nth [1 2] 5)])\n                       nil\n                       (catch clojure.lang.ExceptionInfo e e))]\n      (is (= data/refusal-message (some-> failure ex-message)))\n      (is (= 'nth (:yin.vm.data/op (ex-data failure))))\n      (is (= :out-of-range (:yin.vm.data/reason (ex-data failure))))))\n  (testing \"the adapter catches only the module's own refusal\"\n    (let [other (yang/outcome-adapter\n                  data/refusal-message\n                  (fn [] (throw (ex-info \"other\" {:yin.vm.data/op 'x, :yin.vm.data/reason :y}))))]\n      (is (thrown-with-msg? clojure.lang.ExceptionInfo #\"other\" (other))))\n    (let [npe (yang/outcome-adapter data/refusal-message\n                                    (fn [] (throw (NullPointerException.))))]\n      (is (thrown? NullPointerException (npe))))))\n\n\n(deftest test-outcome-native-path-emits-none\n  (let [forms '[(defn f\n                  [x]\n                  (throw (ex-info \"t\" {}))) (defn g\n                                              [x]\n                                              (+ x 1)) (g 1)]]\n    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true av-opts)))\n        \"the convention without :outcomes carries no outcome tags\")\n    (is (not-any? #(= :yin.k/ok %) (ast-nodes (yang/compile-program '[(defn g\n                                                                        [x]\n                                                                        (+ x 1)) (g 1)]))))\n    (is (some #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true outcome-opts))))))\n\n\n(deftest test-outcome-common-call-depth\n  (let [prog (fn [defs n] (yang/compile-program (conj defs (list 'cnt n)) true outcome-opts))\n        three '[(defn c\n                  [n]","numLines":60,"startLine":2015,"totalLines":3282}},"tool_result_meta":[{"id":"call_6d44dc59e7244283880385aa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
