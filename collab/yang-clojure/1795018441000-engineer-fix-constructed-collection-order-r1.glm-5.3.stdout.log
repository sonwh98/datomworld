(testing \"sizes 8/9/16/32: recorded permutations cross the thresholds\"\n    (doseq [n map-corpus-sizes\n            :let [entries (sized-map-entries n)]]\n      (testing (str \"size \" n)\n        (let [variants (into []\n                             (mapcat (fn [p]\n                                       (for [rep [:array-map :hash-map]]\n                                         (build-map rep (permute entries p)))))\n                             (recorded-permutations n 1795017757000))\n              snaps (mapv compile-snapshot variants)]\n          (is (apply = snaps))\n          (doseq [form variants\n                  :let [ctors (map-constructors (yang/compile form))]]\n            (is (every? #(ascending? (pair-keys %)) ctors)))))))\n  (testing \"the constant fast path stays a literal\"\n    (is (= {:type :literal :value {:a 1 :b 2}}\n           (yang/compile {:a 1 :b 2}))))\n'''\ndepth = 0\nfor ln, line in enumerate(mp.split(\"\\n\"), 1):\n    for ch in line:\n        if ch == \"(\": depth += 1\n        elif ch == \")\": depth -= 1\n    print(ln, depth, line[:50])\nPYEOF","description":"Trace depth per line"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"02c32def-32a8-4a7c-9c88-09d763d9725c","timestamp":"2026-11-18T17:10:28.737Z","wire_tool_inputs":{"call_5a96f366df454fb69ebcea81":{"command":"python3 - <<'PYEOF'\nsrc = open(\"/tmp/mp.txt\").read() if False else None\nmp = '''(deftest map-permutation-invariance-test\n  (testing \"sizes 0-4: every insertion permutation, both representations\"\n    (doseq [n (range 5)\n            :let [entries (sized-map-entries n)]]\n      (testing (str \"size \" n)\n        (let [variants (into []\n                             (mapcat (fn [p]\n                                       (for [rep [:array-map :hash-map]]\n                                         (build-map rep