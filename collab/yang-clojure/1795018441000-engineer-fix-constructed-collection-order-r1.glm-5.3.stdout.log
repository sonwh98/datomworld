{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_d5379e52873742738b311293","type":"tool_result","content":"346\t(deftest map-permutation-invariance-test\n347\t  (testing \"sizes 0-4: every insertion permutation, both representations\"\n348\t    (doseq [n (range 5)\n349\t            :let [entries (sized-map-entries n)]]\n350\t      (testing (str \"size \" n)\n351\t        (let [variants (into []\n352\t                             (mapcat (fn [p]\n353\t                                       (for [rep [:array-map :hash-map]]\n354\t                                         (build-map rep (permute entries p)))))\n355\t                             (all-permutations n))\n356\t               snaps (mapv compile-snapshot variants)]\n357\t          (is (pos? (count variants)))\n358\t          (is (apply = snaps)\n359\t              (str n \"-entry permutations diverge: \"\n360\t                   (pr-str (distinct snaps))))\n361\t          (when (pos? n)\n362\t            (doseq [form variants\n363\t                    :let [ctors (map-constructors (yang/compile form))]]\n364\t              (is (= 1 (count ctors)))\n365\t              (is (every? #(ascending? (pair-keys %)) ctors)))))))\n366\t  (testing \"recorded corpus: permutations of the recorded entries\"\n367\t    (doseq [[label entries] map-corpus]\n368\t      (testing (str label)\n369\t        (let [variants (into []\n370\t                             (mapcat (fn [p]\n371\t                                       (for [rep [:array-map :hash-map]]\n372\t                                         (build-map rep (permute entries p)))))\n373\t                             (all-permutations (count entries)))\n374\t               snaps (mapv compile-snapshot variants)]\n375\t          (is (apply = snaps))\n376\t          (doseq [form variants\n377\t                  :let [ctors (map-constructors (yang/compile form))]]\n378\t            (is (every? #(ascending? (pair-keys %)) ctors)))))))\n379\t  (testing \"sizes 8/9/16/32: recorded permutations cross the thresholds\"\n380\t    (doseq [n map-corpus-sizes\n381\t            :let [entries (sized-map-entries n)]]\n382\t      (testing (str \"size \" n)\n383\t        (let [variants (into []\n384\t                             (mapcat (fn [p]\n385\t                                       (for [rep [:array-map :hash-map]]\n386\t                                         (build-map rep (permute entries p)))))\n387\t                             (recorded-permutations n 1795017757000))\n388\t               snaps (mapv compile-snapshot variants)]\n389\t          (is (apply = snaps))\n390\t          (doseq [form variants\n391\t                  :let [ctors (map-constructors (yang/compile form))]]\n392\t            (is (every? #(ascending? (pair-keys %)) ctors)))))))\n393\t  (testing \"the constant fast path stays a literal\"\n394\t    (is (= {:type :literal :value {:a 1 :b 2}}\n395\t           (yang/compile {:a 1 :b 2})))))\n396\t\n397\t\n398\t\n399\t;; =============================================================================\n400\t;; RULING 3 test 3: set representation/permutation property\n401\t;; =============================================================================\n402\t\n403\t(def ^:private set-corpus\n404\t  \"The recorded corpus of dynamic set element lists.\"\n405\t  [[:dynamic-elements\n406\t    [(list '+ 'n 0) (list '+ 'n 1) (list 'first 'xs)]]\n407\t   [:nested-dynamic-sets\n408\t    [#{(list '+ 'n 1) 2} (list 'first 'xs) 3]]\n409\t   [:colliding-value-expressions\n410\t    ;; two different expressions that evaluate to the same value\n411\t    [(list '- 'n 1) (list '- 1 'n) (list '+ 'n 0)]]\n412\t   [:heterogeneous-elements\n413\t    [:kw \"str\" 3 1.5 quoted-pair-key quoted-meta-key (list '+ 'n 2)]]])\n414\t\n415\t(deftest set-permutation-invariance-test\n416\t  (testing \"sizes 0-4: every element permutation, both representations\"\n417\t    (doseq [n (range 5)\n418\t            :let [elements (sized-set-elements n)]]\n419\t      (testing (str \"size \" n)\n420\t        (let [variants (into []\n421\t                             (mapcat (fn [p]\n422\t                                       (for [rep [:vec-set :hash-set]]\n423\t                                         (build-set rep (permute elements p)))))\n424\t                             (all-permutations n))\n425\t               snaps (mapv compile-snapshot variants)]"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"526d468a-e0d8-4f51-be9a-72a0feb205c3","timestamp":"2026-11-18T17:09:15.223Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_collection_order_test.cljc","content":"(deftest map-permutation-invariance-test\n  (testing \"sizes 0-4: every insertion permutation, both representations\"\n    (doseq [n (range 5)\n            :let [entries (sized-map-entries n)]]\n      (testing (str \"size \" n)\n        (let [variants (into []\n                             (mapcat (fn [p]\n                                       (for [rep [:array-map :hash-map]]\n                                         (build-map rep (permute entries p)))))\n                             (all-permutations n))\n               snaps (mapv compile-snapshot variants)]\n          (is (pos? (count variants)))\n          (is (apply = snaps)\n              (str n \"-entry permutations diverge: \"\n                   (pr-str (distinct snaps))))\n          (when (pos? n)\n            (doseq [form variants\n                    :let [ctors (map-constructors (yang/compile form))]]\n              (is (= 1 (count ctors)))\n              (is (every? #(ascending? (pair-keys %)) ctors)))))))\n  (testing \"recorded corpus: permutations of the recorded entries\"\n    (doseq [[label entries] map-corpus]\n      (testing (str label)\n        (let [variants (into []\n                             (mapcat (fn [p]\n                                       (for [rep [:array-map :hash-map]]\n                                         (build-map rep (permute entries p)))))\n                             (all-permutations (count entries)))\n               snaps (mapv compile-snapshot variants)]\n          (is (apply = snaps))\n          (doseq [form variants\n                  :let [ctors (map-constructors (yang/compile form))]]\n            (is (every? #(ascending? (pair-keys %)) ctors)))))))\n  (testing \"sizes 8/9/16/32: recorded permutations cross the thresholds\"\n    (doseq [n map-corpus-sizes\n            :let [entries (sized-map-entries n)]]\n      (testing (str \"size \" n)\n        (let [variants (into []\n                             (mapcat (fn [p]\n                                       (for [rep [:array-map :hash-map]]\n                                         (build-map rep (permute entries p)))))\n                             (recorded-permutations n 1795017757000))\n               snaps (mapv compile-snapshot variants)]\n          (is (apply = snaps))\n          (doseq [form variants\n                  :let [ctors (map-constructors (yang/compile form))]]\n            (is (every? #(ascending? (pair-keys %)) ctors)))))))\n  (testing \"the constant fast path stays a literal\"\n    (is (= {:type :literal :value {:a 1 :b 2}}\n           (yang/compile {:a 1 :b 2})))))\n\n\n\n;; =============================================================================\n;; RULING 3 test 3: set representation/permutation property\n;; =============================================================================\n\n(def ^:private set-corpus\n  \"The recorded corpus of dynamic set element lists.\"\n  [[:dynamic-elements\n    [(list '+ 'n 0) (list '+ 'n 1) (list 'first 'xs)]]\n   [:nested-dynamic-sets\n    [#{(list '+ 'n 1) 2} (list 'first 'xs) 3]]\n   [:colliding-value-expressions\n    ;; two different expressions that evaluate to the same value\n    [(list '- 'n 1) (list '- 1 'n) (list '+ 'n 0)]]\n   [:heterogeneous-elements\n    [:kw \"str\" 3 1.5 quoted-pair-key quoted-meta-key (list '+ 'n 2)]]])\n\n(deftest set-permutation-invariance-test\n  (testing \"sizes 0-4: every element permutation, both representations\"\n    (doseq [n (range 5)\n            :let [elements (sized-set-elements n)]]\n      (testing (str \"size \" n)\n        (let [variants (into []\n                             (mapcat (fn [p]\n                                       (for [rep [:vec-set :hash-set]]\n                                         (build-set rep (permute elements p)))))\n                             (all-permutations n))\n               snaps (mapv compile-snapshot variants)]","numLines":80,"startLine":346,"totalLines":1040}},"tool_result_meta":[{"id":"call_d5379e52873742738b311293","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
