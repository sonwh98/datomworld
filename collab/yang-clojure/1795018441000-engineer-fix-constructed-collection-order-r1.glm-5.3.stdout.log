ang/compile-program [(with-meta (quote (fn [x] x)) {:line 7 :column 2})] true yang/unit-opts))\n  (show :lower-unit\n        (yang/lower-unit forms-av)))\n'''\nPath(\"test/fixorder_tmp_diag_test.cljc\").write_text(src)\nprint(\"written\", len(src))\nPYEOF","description":"Write anonymous-arity diagnostics via heredoc"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"9b3b0e7c-91a3-45df-ba98-2d4a34d0186e","timestamp":"2026-11-18T16:30:29.705Z","wire_tool_inputs":{"call_95e23a64d8ea47fb8e4df64c":{"command":"python3 - <<'PYEOF'\nfrom pathlib import Path\nsrc = r'''(ns fixorder-tmp-diag-test\n  \"Scratch diagnostics: compute canonical orders from pre-fix child rows.\"\n  (:require [clojure.test :refer [deftest is]]\n            [clojure.walk :as walk]\n            [dao.jing :as jing]\n            [yang.clojure :as yang]\n            [yin.vm :as vm]))\n\n(def forms-av\n  (quote [(defn replay\n            [x]\n            (let [[a b] [x 1.5]]\n              (+ (identity ^:replay a) (identity ^:replay a) b)))\n          (replay 2)]))\n\n(defn- ctor?\n  [n]\n  (and (map? n)\n       (= :application (:type n))\n       (= :variable (get-in n [:operator :type]))\n       (contains? #{(quote assoc) (quote conj)} (get-in n [:operator :name]))\n       (= :literal (get-in n [:operands 0 :type]))\n       (contains? #{{} [] #{}} (get-in n [:operands 0 :value]))))\n\n(defn- collect\n  [ast]\n  (let [acc (atom [])]\n    (walk/postwalk (fn [n] (when (ctor? n) (swap! acc conj n)) n) ast)\n    @acc))\n\n(defn- show\n  [label ast]\n  (doseq [c (collect ast)\n          :when (= (quote assoc) (get-in c [:operator :name]))]\n    (let [ops (:operands c)\n          roots (mapv (fn [o] (:root (vm/ast->semantic-bytecode o))) ops)]\n      (println label)\n      (println :shapes (mapv (fn [o] (if (= :literal (:type o)) [:lit (pr-str (:value o))] [(:typ