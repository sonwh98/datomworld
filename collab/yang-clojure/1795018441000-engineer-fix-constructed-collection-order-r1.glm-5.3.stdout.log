{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_2a8e7ec37e09473c9e785936","type":"tool_result","content":"1100\t      (is (> d100 (+ d0 50)) \"the semantic gate detects the missing flag\"))))\n1101\t\n1102\t\n1103\t;; =============================================================================\n1104\t;; Slice 5: the outcome model\n1105\t;; =============================================================================\n1106\t\n1107\t(def ^:private effect-log (atom []))\n1108\t\n1109\t\n1110\t(def ^:private outcome-modules\n1111\t  (let [host (fn [name entries]\n1112\t               (fn [registry]\n1113\t                 (module/register-host-module\n1114\t                   registry name\n1115\t                   (into {} (map (fn [[op f _]] [op f])) entries)\n1116\t                   (into {} (map (fn [[op _ p]] [op p])) entries))))]\n1117\t    (-> av-modules\n1118\t        ((host 'portable\n1119\t               [['nth\n1120\t                 (yang/outcome-adapter data/refusal-message (get data/data-module 'nth))\n1121\t                 (get data/data-profiles 'nth)]]))\n1122\t        ((host 'probe\n1123\t               [['note\n1124\t                 (fn [x] (swap! effect-log conj x) x)\n1125\t                 (vm/primitive-profile 'note :pure [1] #{} :none)]])))))\n1126\t\n1127\t\n1128\t(def ^:private outcome-opts\n1129\t  {:convention :arg-vector, :outcomes true\n1130\t   :native (set (keys vm/primitives))\n1131\t   :adapters {'data/nth 'portable/nth}})\n1132\t\n1133\t\n1134\t(defn- outcome-ast\n1135\t  [forms]\n1136\t  (yang/compile-program forms true outcome-opts))\n1137\t\n1138\t\n1139\t(defn- run-outcome\n1140\t  \"The raw outcome the last form of `forms` returns.\"\n1141\t  [forms]\n1142\t  (reset! effect-log [])\n1143\t  (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n1144\t      (tu/queue-ast! (outcome-ast forms))\n1145\t      tu/run-session\n1146\t      :consumer\n1147\t      vm/value))\n1148\t\n1149\t\n1150\t(defn- run-profile-outcome\n1151\t  [forms]\n1152\t  (reset! effect-log [])\n1153\t  (let [ast (walk/postwalk\n1154\t              (fn [node]\n1155\t                (if (= node (u/v 'profile-raise)) (u/v 'probe/note) node))\n1156\t              (outcome-ast forms))]\n1157\t    (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n1158\t        (tu/queue-ast! ast)\n1159\t        tu/run-session\n1160\t        :consumer\n1161\t        vm/value)))\n1162\t\n1163\t\n1164\t(deftest test-outcome-success-and-throw\n1165\t  (is (= [:yin.k/ok 2] (run-outcome '[(defn f\n1166\t                                        [x]\n1167\t                                        (+ x 1)) (f 1)])))\n1168\t  (is (= [:yin.k/ok [:ok 1]] (run-outcome '[(defn f\n1169\t                                              [x]\n1170\t                                              [:ok x]) (f 1)]))\n1171\t      \"LaTTe's own [:ok ...] stays an ordinary value inside the payload\")\n1172\t  (is (= [:yin.k/error {:yin.k/message \"boom\", :yin.k/data {:x 1}}]\n1173\t         (run-outcome '[(defn f\n1174\t                          [x]"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"daf948a5-c82c-4d73-ab91-1e65f66c004d","timestamp":"2026-11-18T16:22:28.955Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_test.clj","content":"      (is (> d100 (+ d0 50)) \"the semantic gate detects the missing flag\"))))\n\n\n;; =============================================================================\n;; Slice 5: the outcome model\n;; =============================================================================\n\n(def ^:private effect-log (atom []))\n\n\n(def ^:private outcome-modules\n  (let [host (fn [name entries]\n               (fn [registry]\n                 (module/register-host-module\n                   registry name\n                   (into {} (map (fn [[op f _]] [op f])) entries)\n                   (into {} (map (fn [[op _ p]] [op p])) entries))))]\n    (-> av-modules\n        ((host 'portable\n               [['nth\n                 (yang/outcome-adapter data/refusal-message (get data/data-module 'nth))\n                 (get data/data-profiles 'nth)]]))\n        ((host 'probe\n               [['note\n                 (fn [x] (swap! effect-log conj x) x)\n                 (vm/primitive-profile 'note :pure [1] #{} :none)]])))))\n\n\n(def ^:private outcome-opts\n  {:convention :arg-vector, :outcomes true\n   :native (set (keys vm/primitives))\n   :adapters {'data/nth 'portable/nth}})\n\n\n(defn- outcome-ast\n  [forms]\n  (yang/compile-program forms true outcome-opts))\n\n\n(defn- run-outcome\n  \"The raw outcome the last form of `forms` returns.\"\n  [forms]\n  (reset! effect-log [])\n  (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n      (tu/queue-ast! (outcome-ast forms))\n      tu/run-session\n      :consumer\n      vm/value))\n\n\n(defn- run-profile-outcome\n  [forms]\n  (reset! effect-log [])\n  (let [ast (walk/postwalk\n              (fn [node]\n                (if (= node (u/v 'profile-raise)) (u/v 'probe/note) node))\n              (outcome-ast forms))]\n    (-> (tu/make-observer-session (tu/create-vm {:modules outcome-modules}))\n        (tu/queue-ast! ast)\n        tu/run-session\n        :consumer\n        vm/value)))\n\n\n(deftest test-outcome-success-and-throw\n  (is (= [:yin.k/ok 2] (run-outcome '[(defn f\n                                        [x]\n                                        (+ x 1)) (f 1)])))\n  (is (= [:yin.k/ok [:ok 1]] (run-outcome '[(defn f\n                                              [x]\n                                              [:ok x]) (f 1)]))\n      \"LaTTe's own [:ok ...] stays an ordinary value inside the payload\")\n  (is (= [:yin.k/error {:yin.k/message \"boom\", :yin.k/data {:x 1}}]\n         (run-outcome '[(defn f\n                          [x]","numLines":75,"startLin