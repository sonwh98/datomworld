le-program-unit asts))\n          roots-b (map-operand-roots (:lower-unit asts))]\n      (is (pos? (count roots-a)))\n      (is (apply = roots-a) \"the unit's constructed maps agree\")\n      (is (= (vec roots-a) (vec roots-b)))\n      (is (every? #(ascending? (pair-keys %))\n                  (map-constructors (:lower-unit asts))))))\"\"\"\nassert old in t; t = t.replace(old, new)\np.write_text(t)\nprint(\"entry-points restructured\")\nPYEOF","description":"Restructure entry-points test per convention boundary"}}}
