   :render render}))\n2761\t\n2762\t\n2763\t(deftest repl-fabricated-retention-evidence-is-ignored-from-the-renderer-test\n2764\t  ;; cc3 r10 (astra r9 F1 residue): a frontend :render hook executes\n2765\t  ;; after run-evaluator-stage returns — outside both r9 wrap sites —\n2766\t  ;; and a throw from it reaches run-evaluation's recovery catch\n2767\t  ;; directly. The render raise carries the shell snapshot (empty\n2768\t  ;; included) over whatever the hook payload claimed, so no\n2769\t  ;; fabricated diagnostic, handle or Warning appears, while genuine\n2770\t  ;; retention — completed handles, and a real store refusal —\n2771\t  ;; survives exactly once.\n2772\t  (doseq [[label genuine-failure?] [[\"healthy retention\" false]\n2773\t                                    [\"genuine retention failure\" true]]]\n2774\t    (testing label\n2775\t      (let [fail? (atom false)\n2776\t            render-armed? (atom false)\n2777\t            [s1 _] (repl/eval-input\n2778\t                     (repl-frontends/create-state\n2779\t                       {:frontends (r10-render-catalog\n2780\t                                     (r10-forged-renderer render-armed?))\n2781\t                        :index-store (r9-refusing-store fail?)})\n2782\t                     \"(def k (fn [] 1))\")\n2783\t            [s2 _] (repl/eval-input s1 \"(def g (fn [] (+ (k) 41)))\")\n2784\t            handles-before (repl/call-provenance-handles s2)]\n2785\t        (is (seq handles-before) \"precondition: earlier retention completed\")\n2786\t        (is (empty? (repl/call-provenance-failures s2))\n2787\t            \"precondition: retention was healthy so far\")"}]},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"3d88b406-3c0b-4d43-a77d-74ceaf3f0fea","timestamp":"2026-11-18T16:17:55.640Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-fixorder/test/yang/clojure_callsite_test.cljc","content":"                          