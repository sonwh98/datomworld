ctly once\"\n    (let [traces (trace-of {(list 'tap :k) (list 'tap :v)\n                            (with-meta (list 'tap :k) {:i 1}) (list 'tap :v2)}\n                           {})]\n      (doseq [[lane {:keys [log]}] traces]\n        (is (= [:k :v :k :v2] log) (str lane)))))\"\"\"\nnew = \"\"\"  (testing \"no duplication: every occurrence evaluates exactly once\"\n    (let [traces (trace-of {(list 'tap :k) (list 'tap :v)\n                            (list 'tap :k2) (list 'tap :v2)}\n                           {})]\n      (doseq [[lane {:keys [log]}] traces]\n        (is (= (vec (mapcat identity [[:k :v] [:k2 :v2]])) log)\n            (str lane)))))\"\"\"\nassert old in t; t = t.replace(old, new)\np.write_text(t)\nprint(\"tie tests rebuilt on NaN\")\nPYEOF","description":"Rebuild tie tests on NaN keys"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"3b22ab98-3808-492f-99b7-216dd4cf8345","uuid":"5ef16dde-8e8e-4538-b1e8-0a164acdc61a","timestamp":"2026-11-18T17:18:00.202Z","wire_tool_inputs":{"call_ac2fa84bd54e4097b49ebde2":{"command":"python3 - <<'PYEOF'\nfrom pathlib import Path\np = Path(\"test/yang/clojure_collection_order_test.cljc\")\nt = p.read_text()\n\n# 1) corpus entry: metadata trick impossible (host = ignores meta); NaN keys\nold = \"\"\"   [:same-key-different-values\n    ;; identical key code under different host values (metadata), so both\n    ;; entries survive the host map and the value root breaks the tie\n    [[(with-meta (list '+ 'n 1) {:variant :left}) :left]\n     [(list '+ 'n 1) :right]]]])\"\"\"\nnew = \"\"\"   [:same-key-different-values\n    ;; two NaN keys: never = to each other, so both entries survive the\n    ;; host map, yet the codec makes every NaN one quiet NaN, so both\n    ;; compile to one key code and the value root breaks the tie\n    [[##NaN :left] [##NaN :right]]]])\"\"\"\nassert old in t; t = t.replace(old, new)\n\n# 2) 