st) :status (:status expansion)\n948\t       :tree (macro/packet->row-set (:tree expansion))\n949\t       :rows (:frontend-metadata expansion) :expansion-log (:log expansion)}\n950\t      (projected :negative ast \"admission-b\")\n951\t      (published :yang.call call-result call-spec)\n952\t      (published :clj clj-result clj-spec)])))\n953\t\n954\t\n955\t(defn replay-snapshot\n956\t  \"Digest the FULL canonical-sorted C1 relation and occurrence-key vector;\n957\t   no origin, generated name, path or expansion record is normalized away.\"\n958\t  [{:keys [id tree rows addresses provenance expansion-log status]}]\n959\t  (let [c1 (vec (sort jing/canonical-compare\n960\t                      (filter #(= :yang/call-site (nth % 3)) rows)))\n961\t        keys (vec (sort jing/canonical-compare (marked rows)))\n962\t        sem (linearize/project-rows tree nil rows)\n963\t        stack (derive/stack-image (:vector sem)\n964\t                                  {:segment-address :cc4/stack\n965\t                                   :call-provenance (:call-provenance sem)})\n966\t        register (derive/register-image (:vector sem)\n967\t                                        {:segment-address :cc4/register\n968\t                                         :call-provenance (:call-provenance sem)})]\n969\t    (cond-> {:id id :root (:root tree) :applications (count keys)\n970\t             :keys-digest (jing/content-hash keys)\n971\t             :c1-digest (jing/content-hash c1)\n972\t             :instruction-provenance-digest\n973\t             (jing/content-hash [(:call-provenance sem)\n974\t                                 (:call-provenance stack)\n975\t                                 (:call-provenance register)])}\n976\t      addresses (assoc :addresses addresses)\n977\t      provenance (assoc :provenance-digest (jing/content-hash provenance))\n978\t      expansion-log (assoc :expansion-log-digest (jing/content-hash expansion-log)\n979\t                           :expansion