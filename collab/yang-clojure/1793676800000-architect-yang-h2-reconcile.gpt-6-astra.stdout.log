chain, the initial application and the recur are tail\"\n      (is (= {[:lambda true] 2        ; initializer let, worker-binding let\n              ['dsg__loop0 true] 2    ; initial application, recur\n              ['< false] 1            ; the test\n              ['+ false] 1}           ; a recur operand is never tail\n             (frequencies (applications (yang/compile form))))))\n    (testing \"a loop in operand position is not itself tail; its recur still is\"\n      (is (= {[:lambda false] 2, ['dsg__loop0 false] 1, ['dsg__loop0 true] 1\n              ['< false] 1, ['+ false] 1}\n             (frequencies (applications (yang/compile-form form false {}))))))))\n\n\n;; --- continuation-depth gates -----------------------------------------------\n\n(defn- walker-depth\n  \"Length of the :next chain from the VM's k.\"\n  [vm]\n  (loop [k (vm/continuation vm), n 0]\n    (if k (recur (:next k) (inc n)) n)))\n\n\n(defn- semantic-depth\n  [vm]\n  (count (vm/continuation vm)))\n\n\n(defn- stepper\n  \"A run function stepping the VM one instruction at a time, recording the\n   maximum depth `depth-of` reports in :max-depth.\"\n  [depth-of]\n  (fn [vm]\n    (loop [v vm, mx (depth-of vm)]\n      (if (or (vm/halted? v) (vm/blocked? v))\n        (assoc v :max-depth mx)\n        (let [v' (vm/step v)]\n          (recur v' (max mx (depth-of v'))))))))\n\n\n(defn- walker-run\n  \"[value max-depth] of `ast` on the walker lane.\"\n  [ast]\n  (let [session (-> (tu/make-observer-session (tu/create-vm {:modules av-modules}))\n                    (tu/queue-ast! ast))\n        done (observer/run-on-stream\n               session engine/ready-for-ingress?\n               (vm/fresh-code-loader ast-walker/vm-load-program vm/ast-contract)\n               (stepper walker-depth))]\n    [(vm/value (:consumer done)) (:max-depth (:consumer done))]))\n\n\n(defn- semantic-run\n  \"[value max-depth] of `ast` on the semantic lane.\"\n  [ast]\n  (let [session (tu/make-encoder-session\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret\n                                       :modules av-modules}))\n        load-rows (vm/fresh-code-loader\n                    (fn [machine rows stamp]\n                      (vm/check-contract! vm/ast-contract stamp)\n                      (semantic/load-vector\n                        machine\n                        (:vector (if (contains? rows :yin/batch)\n                                   (linearize/project-rows\n                                     (nth (:yin/batch rows) (:yin/root rows))\n                                     (vm/source-origin (:yin/source-medium rows)\n  (testing \"without reader metadata there is no source key\"\n    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/argc 0, :yin.k/kind :anonymous}]\n           (run-library [(list (list 'fn '[x] 'x))]))))\n  (testing \"a named function still names itself and has no :anonymous kind\"\n    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/fn 'f, :yin.k/argc 2}]\n           (run-library '[(defn f\n                            [x]\n                            x) (f 1 2)])))))\n\n\n(deftest test-adapter-counts-from-profiles\n  (testing \"an adapter admits exactly the profile's fixed arities\"\n    (is (= [:yin.k/ok false] (run-library '[(let [g not] (g true))])))\n    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/fn 'not, :yin.k/argc 0}]\n           (run-library '[(let [g not] (g))])))\n    (is (= [:yin.k/error {:yin.vm.data/reason :arity, :yin.k/fn 'not, :yin.k/argc 2}]\n           (run-library '[(let [g not] (g 1 2))]))))\n  (testing \"a variadic profile extends to the stated bound, not a magic 4\"\n    (is (= [:yin.k/ok 28] (run-library '[(let [g +] (g 1 2 3 4 5 6 7))])))\n    (is (= [:yin.k/ok 36] (run-library '[(let [g +] (g 1 2 3 4 5 6 7 8))])))\n    (is (= :arity (:yin.vm.data/reason\n                    (second (run-library '[(let [g +] (g 1 2 3 4 5 6 7 8 9))]))))))\n  (testing \"a set of native names keeps the default bound\"\n    (let [opts (assoc library-opts :native (set (keys vm/primitives)))]\n      (is (= [:yin.k/ok 10] (run-library '[(let [g +] (g 1 2 3 4))] opts)))\n      (is (= :arity (:yin.vm.data/reason\n                      (second (run-library '[(let [g +] (g 1 2 3 4 5))] opts))))))))\n\n\n(deftest test-hardening-library-admissions\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok [nil 2 nil '(1 2) 'b :missing true false false {:name 'source}]]\n           (run-library '[[(last nil) (last [1 2]) (butlast [1]) (butlast [1 2 3])\n                           (nth '(a b) 1) (nth [1] 3 :missing)\n                           (string? \"\") (string? 'x) (var? 'x)\n                           (meta (with-meta 'x {:name 'source}))]]\n                        library-opts lane 1000000))))\n  (testing \"fresh supply crosses function calls and repeated loop iterations\"\n    (doseq [lane [:walker :semantic]]\n      (is (= [:yin.k/ok [false 12]]\n             (run-library\n               '[(defn allocate\n                   [s]\n                   (fresh-symbol s \"fresh\"))\n                 (let [[a s] (allocate {:counter 0})\n                       [b s] (allocate s)\n                       s (loop [s s i 0]\n                           (if (= i 10) s\n                               (let [[n next-s] (allocate s)] (recur next-s (inc i)))))]\n                   [(= a b) (:counter s)])]\n               library-opts lane 1000000)))))\n  (is (= :yin.k/error (first (run-library '[(gensym \"fresh\")])))))\n\n\n(deftest test-portable-try-outcomes\n  (doseq [lane [:walker :semantic]\n          [form expected]\n          [['(try :ok (catch Exception e :bad)) :ok]\n           ['(try (throw (ex-info \"failure\" {:extra 7}))\n                  (catch Exception e [(.getMessage e) (ex-data e)])) [\"failure\" {:extra 7}]]\n           ['(try (try (throw (ex-info \"inner\" {}))\n                       (catch Exception e (throw (ex-info \"outer\" (ex-data e)))))\n                  (catch Exception e (.getMessage e))) \"outer\"]\n           ['(let [v (try (+ 1 (throw (ex-info \"early\" {})))\n                          (catch Exception e 8))] (inc v)) 9]]]\n    (is (= [:yin.k/ok expected] (run-library [form] library-opts lane 1000000))))\n  (doseq [form '[(try 1 (catch Exception e 2) :ignored)\n                 (try 1 (finally 2))\n                 (try 1 (catch Throwable e 2))\n                 (try 1 (catch Exception e (.getStackTrace e)))]]\n    (is (thrown? clojure.lang.ExceptionInfo\n          (yang/compile-program [form] true library-opts)))))\n\n\n(deftest test-guest-callable-collections-and-threading\n  (doseq [lane [:walker :semantic]]\n    (is (= [:yin.k/ok ['b 2 :absent :k nil 3 {:n 3}]]\n           (run-library\n             '[(let [v '[a b] m {:k 2} s #{:k} k :n]\n                 [(v 1) (m :k) (m :missing :absent) (s :k) (s :missing)\n                  (k {:n 3}) (-> {:n 1} (update :n + 2))])]\n             library-opts lane 1000000))))\n  (is (= [:yin.k/ok :caught]\n         (run-library '[(try (let [v [1]] (v)) (catch Exception e :caught))]))))\n11:bb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\n12:bb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\n15:bb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\n18:bb test:all:clj      # JVM, no filter: `clojure -M:test`\n21:bb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\n24:# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n33:# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n37:# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n38:# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n39:# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n42:# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n46:# (or `clojure -M:test -i :slow -n <ns>`).\n48:# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n51:# Full repo-wide `bb test` runs twice daily on the remote hosts (03:00/17:00 VN);\n55:# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n57:# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n59:# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n60:# not yet run end to end. test:all: JVM 20+ min, also an estimate.\n63:# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n69:                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n71:                         # by name): `clojure -M:test` without it fails that test\n96:### Sharded quick JVM feedback and change routing\n99:bb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\n100:bb test:quick-sharded --changed src/cljc/yang/clojure.cljc\n102:bb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\n110:`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\n111:the JVM portion of G3. Without selection flags it selects every JVM test;\n114:the full JVM set here. It never changes `test:changed`'s selection or exit-2\n115:semantics. `--workers N` must be positive (default 4 on the laptop).\n122:`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\n123:Prerequisites are derived from the entire selected JVM reach and finish\n133:JVM wall time from total time including selection/builds. A nonzero child exit,\n136:selection prints `0 JVM namespaces selected` and exits 1, including dry plans.\n139:`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\n154:| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --change