nvocation_candidate]\n                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n                         (range (dec (count operands))))\n          compile-operand #(compile-form % false env macro-env)]\n      (cond-> (u/mark-tails\n                (apply u/app\n                       (u/lam bindings\n                              (u/if-node\n                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n                                (apply u/app (u/v operator) (map u/v bindings))\n                                (u/app (u/v 'yang.call/transfer)\n                                       (u/v (nth bindings 3))\n                                       (u/app (u/v 'yang.call/condition)\n                                              (u/lit :yang.call/not-callable)\n                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n                                                     (u/lit :yang.call/callee)\n                                                     (u/v (first bindings)))))))\n                       (map compile-operand operands)))\n        tail? (assoc :tail? true)))\n\n    ;; a statically native name: call it directly\n    (native-name? env operator)\n    (cond-> {:type :application\n             :operator (cond-> {:type :variable, :name operator}\n                         (seq (meta operator)) (with-meta (meta operator)))\n             :operands (mapv #(compile-form % false env macro-env) operands)}\n      tail? (assoc :tail? true))\n\n    ;; anything else: one guest invocation, in tail position when the call is\n    :else\n    (compile-guest-call (compile-form operator false env macro-env)\n                        (compile-form (vec operands) false env macro-env)\n                        env tail?)))\n\n\n(defn compile-application\n  \"Compile a function application to Universal AST.\n\n  Clojure: (+ 1 2)\n  AST: {:type :application\n      [x]\n      (+ x 1))\n    (defn dec\n      [x]\n      (- x 1))\n    (defn second\n      [x]\n      (first (rest x)))\n    (defn not=\n      [a b]\n      (not (= a b)))\n    (defn boolean?\n      [x]\n      (or (= x true) (= x false)))\n    (defn fn?\n      [x]\n      (if (data/callable? x) true (yang.call/eligible? x)))\n    (defn ^:yin.k/invoker invoke-value\n      [f args]\n      (cond\n        (data/callable? f) (apply f args)\n        (vector? f) (if (= 1 (count args)) (nth f (first args))\n                        (throw (ex-info \"Vector invocation requires one index\" {:argc (count args)})))\n        (or (map? f) (keyword? f))\n        (if (<= 1 (count args) 2)\n          (if (keyword? f) (get (first args) f (second args))\n              (get f (first args) (second args)))\n          (throw (ex-info \"Lookup invocation requires one key and optional default\" {:argc (count args)})))\n        (set? f) (if (= 1 (count args))\n                   (if (contains? f (first args)) (first args) nil)\n                   (throw (ex-info \"Set invocation requires one key\" {:argc (count args)})))\n        :else (apply f args)))\n    (defn update\n      ([m k f] (assoc m k (f (get m k))))\n      ([m k f a] (assoc m k (f (get m k) a)))\n      ([m k f a b] (assoc m k (f (get m k) a b)))\n      ([m k f a b c] (assoc m k (f (get m k) a b c))))\n    (defn count\n      [x]\n      (data/count x))\n    (defn contains?\n      [coll k]\n      (data/contains? coll k))\n    (defn symbol?\n      [x]\n      (kind/symbol? x))\n    (defn keyword?\n      [x]\n      (kind/keyword? x))\n    (defn int?\n      [x]\n      (kind/int? x))\n    (defn meta\n      [x]\n      (kind/meta x))\n    (defn name\n177:  (when (and (::invoker env) (some #{'invoke-value} names))\n178:    (throw (ex-info \"Binding invoke-value would capture the guest collection invoker\" {:names names})))\n1061:        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n1062:        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n1063:        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n1090:                              (u/app (u/v 'dsg__get) (u/v invocation)\n1214:                                      (u/app (u/v 'dsg__get) (u/v condition)\n1219:                                 (u/app (u/v 'dsg__get) (u/v condition)\n1247:                                (u/app (u/v 'dsg__get) (u/v escape)\n1250:                         (u/app (u/v 'dsg__get) (u/v escape) (u/lit :clj/outcome))\n1259:                      (u/app (u/v 'dsg__get) (u/v callee) (u/lit :clj/outcomes?))\n1267:          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n1272:          ;; and the guest library's invoker owns those semantics. The invoker\n1281:                             (symbol (str reserved-prefix \"invoker_result\"))\n1292:                             (outcome-node ok-tag (u/v (symbol (str reserved-prefix \"invoker_result\")))))\n1295:                                    (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape)\n1298:                             (u/app (u/v 'dsg__get) (u/v 'dsg__raise_escape) (u/lit :clj/outcome))\n1305:          routed (if (::invoker env)\n1307:                     (u/app (u/v 'dsg__get) (u/v callee) (u/lit :yang.call/entry))\n1362:                                (u/app (u/v 'dsg__admitted?) (u/v candidate))\n1379:                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n1969:                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n1971:                                                  (:yin.k/invoker (meta (second %)))) forms))}\n2093:                           'dsg__admitted?\n2097:                                  (let [dsg__entry (dsg__get dsg__candidate :yang.call/entry)\n2098:                                        dsg__witness (dsg__get dsg__candidate :clj/admission)]\n2113:                                    (dsg__get dsg__descriptor :yang.call/entry)\n2118:                                