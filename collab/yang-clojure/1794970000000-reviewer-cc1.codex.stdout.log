      (let [tree (nodes source)\n  2972\t                    possible-locals (into #{} (comp (filter vector?) (mapcat identity) (filter symbol?)) tree)]\n  2973\t                (some (fn [x]\n  2974\t                        (and (seq? x) (seq x) (not= 'quote (first x))\n  2975\t                             (or (contains? possible-locals (first x))\n  2976\t                                 (and (not (symbol? (first x))) (not (keyword? (first x))))))) tree)))\n  2977\t            (close\n  2978\t              [todo seen]\n  2979\t              (if-let [n (first todo)]\n  2980\t                (if (or (contains? seen n) (contains? defined n) (not (contains? by-name n)))\n  2981\t                  (recur (rest todo) seen)\n  2982\t                  (recur (concat (rest todo) (mentions (by-name n))) (conj seen n))) seen))]\n  2983\t      (let [source (concat forms (map by-name needed))\n  2984\t            needed (if (some dynamic-call? source) (close ['invoke-value] needed) needed)]\n  2985\t        (filterv #(contains? needed (second %)) library)))))\n  2986\t\n  2987\t\n  2988\t(defn compile\n  2989\t  \"Main compiler entry point.\n  2990\t\n  2991\t  Compiles a Clojure form into Yin VM Universal AST.\n  2992\t\n  2993\t  Examples:\n  2994\t    (compile 42)\n  2995\t    => {:type :literal, :value 42}\n  2996\t\n  2997\t    (compile '(+ 1 2))\n  2998\t    => {:type :application\n  2999\t        :operator {:type :variable, :name +}\n  3000\t        :operands [{:type :literal, :value 1}\n  3001\t                   {:type :literal, :value 2}]}\n  3002\t\n  3003\t    (compile '(fn [x] (* x 2)))\n  3004\t    => {:type :lambda\n  3005\t        :params [x]\n  3006\t        :body {:type :application\n  3007\t               :operator {:type :variable, :name *}\n  3008\t               :operands [{:type :variable, :name x}\n  3009\t                          {:type :literal, :value 2}]}}\"\n  3010\t  [form]\n  3011\t  (compile-form form true {}))\n  3012\t\n  3013\t\n  3014\t;; =============================================================================\n  3015\t;; The linked runtime entry (the conformance matrix round, yang.antlr.md\n  3016\t;; section 8.10)\n  3017\t;; =============================================================================\n  3018\t;;\n  3019\t;; A linked clojure program is published as an ordinary linker module whose\n  3020\t;; one export, `body`, is its unmodified lowered unit, and run under its own\n  3021\t;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\n  3022\t;; `read-forms` is the frontend's parser — the reader itself — and\n  3023\t;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n  3024\t;; whose call runs the program compiled under the argument-vector\n  3025\t;; convention and the outcome model over the guest library, with every\n  3130\t          (contains? node :test)\n  3131\t          (assoc :test (publish-to-globals (:test node) names bound))\n  3132\t          (contains? node :consequent)\n  3133\t          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n  3134\t          (contains? node :alternate)\n  3135\t          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n  3136\t    (reduce (fn [n k]\n  3137\t              (let [v (get n k)]\n  3138\t                (if (or (and (map? v) (contains? v :type)) (vector? v))\n  3139\t                  (assoc n k (globals-child v names bound))\n  3140\t                  n)))\n  3141\t            node (keys node))))\n  3142\t\n  3143\t\n  3144\t(defn lower-unit\n  3145\t  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n  3146\t   thunk whose call runs the program — `forms` plus the definitions of\n  3147\t   the guest library they need, compiled unmodified under `unit-opts`\n  3148\t   and published to the runtime global namespace by\n  3149\t   `publish-to-globals` — so the helper's export projection can read\n  3150\t   each top-level