[{:keys [root rows]} tree]\n   109\t    (into #{}\n   110\t          (comp (filter (fn [[_ _ id]] (= :application (nth (get rows id) 1))))\n   111\t                (map (fn [[_ path _]] [origin root path])))\n   112\t          (vm/occurrences tree))))\n   113\t\n   114\t\n   115\t(defn marked-application-sites\n   116\t  \"The deduped C1 marker set of a frontend-metadata relation: one\n   117\t   `[origin root-address path]` per distinct `:yang/call-site` row.\n   118\t   Duplicate identical transport deliveries dedupe to the same fact.\"\n   119\t  [frontend-metadata]\n   120\t  (into #{}\n   121\t        (comp (filter (fn [row]\n   122\t                        (and (= 5 (count row)) (= call-site-key (nth row 3)))))\n   123\t              (map (fn [[origin root path _ _]] [origin root path])))\n   124\t        (distinct frontend-metadata)))\n   125\t\n   126\t\n   127\t(defn validate-call-site-coverage!\n   128\t  \"Validate a complete-coverage C1 claim: the marker set of\n   129\t   `frontend-metadata` for canonical `tree` under `origin` must equal\n   130\t   the eligible application set. Returns true when the claim holds.\n   131\t   Conflicting values at one site, an unsupported marker version, a\n   132\t   marker naming no occurrence, a marker on a non-application\n   133\t   occurrence, and missing or extra markers each throw, naming the\n   134\t   failed `:rule`.\"\n   135\t  [tree frontend-metadata origin]\n   136\t  (let [{:keys [root rows]} tree\n   137\t        tag-at (into {}\n   138\t                     (map (fn [[r path id]] [[r path] (nth (get rows id) 1)]))\n   139\t                     (vm/occurrences tree))\n   140\t        eligible (eligible-application-sites tree origin)\n   141\t        rows (filter (fn [row]\n   142\t                       (and (= 5 (count row)) (= call-site-key (nth row 3))))\n   143\t                     (distinct frontend-metadata))\n   144\t        by-site (group-by (fn [[o r path _ _]] [o r path]) rows)]\n   145\t    (