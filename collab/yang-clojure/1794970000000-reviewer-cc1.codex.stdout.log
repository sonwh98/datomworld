t                 (integer? root)\n   134\t                 (<= 0 root)\n   135\t                 (< root (count batch)))\n   136\t    (throw (ex-info \"Malformed source batch envelope\"\n   137\t                    {:rule :batch-envelope, :envelope envelope})))\n   138\t  (let [projected (mapv (fn [j member]\n   139\t                          (project-member member\n   140\t                                          (vm/source-origin source-medium\n   141\t                                                            batch-token j)\n   142\t                                          j))\n   143\t                        (range) batch)]\n   144\t    (assoc envelope\n   145\t           :yin/batch (mapv :tree projected)\n   146\t           :yin/source-positions (into [] (mapcat :source-positions) projected)\n   147\t           :yin/frontend-metadata (into [] (mapcat :frontend-metadata) projected)\n   148\t           :yin/entity-occurrences (into [] (mapcat :entity-occurrences) projected))))\n   149\t\n   150\t\n   151\t(defn project\n   152\t  \"One program-medium batch to its canonical row set `{:root id, :rows …}`\n   153\t   (§6.1). A batch that is neither a map AST nor a datom batch is a defect\n   154\t   of the medium and throws here, at the boundary, naming where it failed.\"\n   155\t  [batch]\n   225\t        (sequential? member) (vm/datoms->ast (vec member))\n   226\t        :else (throw (ex-info \"Unsupported program batch member\"\n   227\t                              {:rule :batch-member, :member member}))))\n   228\t\n   229\t\n   230\t(defn program-batch\n   231\t  \"Encode frontend output as the expander's input batch (§2.1):\n   232\t   `[:yin.program/batch trees run-index declaration-rows harvest-rows]`.\n   233\t   Each member — a map AST or a `:yin/*` datom batch — projects to one tree\n   234\t   packet; `run-index` selects the one that becomes the program. Harvest\n   235\t   rows name every `(yin/def <literal-symbol> value)` occurrence in source\n  