t-cc1-p1-1-confirm.prompt.md\n./collab/yang-clojure/1795040000000-engineer-exception-r3.prompt.md\n\n\n(declare walk-module)\n\n\n(defn- walk-call-sites\n  \"Step 4b: the C1 side table and its reverse record the manifest\n   references (`:yin.module/call-sites`, `yin.vm.linker.publish`), read\n   and held to their own shape — the table is a vector of frontend-\n   metadata rows, the record is version 1, names the manifest's own\n   tree, and points at the referenced table. The origin is not\n   recomputed or reconstructed here: each marker row carries its own\n   occurrence origin (design §2.1), and the record persists the\n   publication's admission identity, which the retriever reads from\n   the record, never from the tree.\"\n  [st manifest path]\n  (if-some [call-sites (:yin.module/call-sites manifest)]\n    (let [[st table] (read-blob st (:table call-sites) :call-site path)]\n      (if (:stop st)\n        st\n        (let [[st record] (read-blob st (:record call-sites) :call-site path)]\n          (cond\n            (:stop st) st\n\n            (not (vector? table))\n            (stop st (invalid (:table call-sites) :call-site path\n                              :call-site-defect {:code :table-shape}))\n\n            (not= {:yang.call-site/version 1\n                   :yang.call-site/root (:yin.module/tree manifest)\n                   :yang.call-site/table (:table call-sites)}\n                  (select-keys record\n                               [:yang.call-site/version\n                                :yang.call-site/root\n                                :yang.call-site/table]))\n            (stop st (invalid (:record call-sites) :call-site path\n                              :call-site-defect {:code :record-shape}))\n\n            :else st))))\n    st))\n\n\n(defn- walk-requires\n  \"Step 5: list every pin with derived eagerness, then descend only into\n   eager manifests not walked before. Deferred pins load at statement time.\"\n  [st manifest-address manifest path depth]\n  (let [eager-set (requirements/eager\n                    (:yin.module/tree manifest)\n                    (fn [address]\n                      (let [[tag & slots] (get (:seen st) address)]\n                        (into {:type tag}\n      ;; a decoded list carries none until a with-meta frame adds it.\n      #?(:cljd (with-meta (apply list (map #(item->value bs %) (:value p))) nil)\n         :default (apply list (map #(item->value bs %) (:value p))))\n      (refuse :malformed-frame \"list payload is not an array\"))\n\n    (\"dao.jing/keyword\" \"dao.jing/symbol\")\n    (let [[ns-item name-item]\n          (or (pair-items p)\n              (refuse :malformed-frame \"identifier payload is not [ns name]\"))]\n      (when-not (or (and (= :simple (:kind ns-item)) (= 22 (:value ns-item)))\n                    (= :text (:kind ns-item)))\n        (refuse :malformed-frame \"namespace is neither nil nor text\"))\n      (when-not (= :text (:kind name-item))\n        (refuse :malformed-frame \"name is not text\"))\n      (let [ns (when (= :text (:kind ns-item)) (:value ns-item))]\n        (if (= frame-name \"dao.jing/keyword\")\n          (keyword ns (:value name-item))\n          (symbol ns (:value name-item)))))\n\n    \"dao.jing/float64\"\n    (let [b (:value p)]\n      (if (and (= :bytes (:kind p)) (= 8 (bytes/length b)))\n        (float64-from-bits (bytes-hex b))\n        (refuse :malformed-frame \"float64 payload is not eight bytes\")))\n\n    \"clojure/with-meta\"\n","exit_code":0,"status":"completed"}}
