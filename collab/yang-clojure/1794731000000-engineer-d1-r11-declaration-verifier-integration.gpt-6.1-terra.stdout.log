{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/correspondence_measure.clj; cat test/yang/correspondence_lane.clj'","aggregated_output":"(ns yang.correspondence-measure\n  \"Resumable measurement records. These are not D1 verification results.\"\n  (:require [clojure.edn :as edn]\n            [clojure.java.io :as io]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yang.correspondence-lane :as lane]\n            [yang.correspondence-verifier :as verifier]\n            [yin.vm :as vm]))\n\n(defn- write-progress! [file value]\n  (let [f (io/file file) parent (or (.getParentFile f) (io/file \".\"))\n        temp (io/file parent (str (.getName f) \".partial-\" (random-uuid)))]\n    (try\n      (.mkdirs parent)\n      (with-open [out (java.io.FileOutputStream. temp)]\n        (.write out (.getBytes (str (pr-str value) \"\\n\") \"UTF-8\"))\n        (.flush out)\n        (.sync (.getFD out)))\n      (java.nio.file.Files/move (.toPath temp) (.toPath f)\n        (into-array java.nio.file.CopyOption [java.nio.file.StandardCopyOption/ATOMIC_MOVE\n                                             java.nio.file.StandardCopyOption/REPLACE_EXISTING]))\n      (finally (when (.exists temp) (.delete temp))))))\n\n(defn initialize!\n  ([file ids] (initialize! file ids {:scope :d1-c-lane-measurement\n                                     :pre-declaration-tagged-execution true}))\n  ([file ids {:keys [scope pre-declaration-tagged-execution]}]\n   (when (or (.exists (io/file file)) (empty? ids) (not= (count ids) (count (set ids)))\n             (not (keyword? scope)) (not (boolean? pre-declaration-tagged-execution)))\n     (throw (ex-info \"Invalid new progress\" {:stage :progress})))\n   (write-progress! file {:scope scope :not-a-verification-result true\n                          :pre-declaration-tagged-execution pre-declaration-tagged-execution\n                          :outcomes (zipmap ids (repeat {:status :not-run}))})))\n\n(defn read-progress [file] (edn/read-string (slurp file)))\n\n(defn record! [file id outcome]\n  (let [p (read-progress file)]\n    (when-not (and (= :not-run (get-in p [:outcomes id :status]))\n                   (contains? #{:pass :refused :failed-bound} (:status outcome))\n                   (or (not= :failed-bound (:status outcome))\n                       (and (= :bound-exceeded (:stage outcome))\n                            (keyword? (:quantity outcome))\n                            (nat-int? (:observed outcome))\n                            (nat-int? (:ceiling outcome))\n                            (> (:observed outcome) (:ceiling outcome)))))\n      (throw (ex-info \"Outcome is not recordable\" {:stage :progress :fixture id})))\n    (write-progress! file (assoc-in p [:outcomes id]\n                                    (cond-> outcome\n                                      (:pre-declaration-tagged-execution p)\n                                      (assoc :pre-declaration true))))))\n\n(defn check-retained-trees!\n  \"Re-fetch both complete row closures under their recorded admission.\"\n  [handle fixture outcome]\n  (let [addresses (:addresses outcome)\n        missing ::missing\n        input (jing/get handle (:input addresses) missing)\n        snapshot (jing/get handle (:snapshot addresses) missing)]\n    (when-not (and (= :pass (:status outcome))\n                   (= fixture (get-in input [:fixture :id]) (:fixture snapshot))\n                   (= (:admission-origin outcome) (:admission-origin input) (:origin snapshot))\n                   (= (:root addresses) (:root snapshot))\n                   (= (:stamped-root addresses) (:stamped-root snapshot)))\n      (throw (ex-info \"Retained admission mismatch\" {:stage :admission :fixture fixture})))\n    (let [before (verifier/fetch-tree! handle (:root addresses) 100000)\n          stamped (verifier/fetch-tree! handle (:stamped-root addresses) 100000)]\n      {:rows {:pre-stamp (count (:rows before)) :stamped (count (:rows stamped))}\n       :before before :stamped stamped})))\n\n(defn tree-statistics\n  \"Occurrence and path sizes for one validated row tree; path bytes are the\n   sum of canonical Jing CBOR encodings of each application path.\"\n  [tree]\n  (let [occurrences (vm/occurrences tree)\n        applications (vm/application-occurrences tree)]\n    {:rows (count (:rows tree))\n     :occurrences (count occurrences)\n     :applications (count applications)\n     :depth (reduce max 0 (map (comp count second) occurrences))\n     :application-path-bytes (reduce + 0 (map (fn [[_ path]] (alength (cbor/encode path)))\n                                              applications))}))\n\n(defn measure-fixture!\n  \"Fetch both retained row closures and measure each tagged C lane. This\n   preflight collects data; it does not assert a bounded verification result.\"\n  [handle fixture outcome modules budget]\n  (let [start (System/nanoTime)\n        ms (fn [t] (quot (- (System/nanoTime) t) 1000000))\n        addresses (:addresses outcome)\n        {:keys [before stamped]} (check-retained-trees! handle fixture outcome)\n        ast (vm/semantic-bytecode->ast stamped)\n        fetch-ms (ms start)\n        lanes (into {}\n                    (for [backend [:walker :semantic]]\n                      (let [t (System/nanoTime)\n                            {:keys [machine steps]} (lane/run-measured! ast modules backend budget)\n                            run-ms (ms t)\n                            ref (get-in machine [:store 'gate-execution-trace])\n                            trace-handle (get-in machine [:resources (:id ref)])\n                            _ (when-not (and (vm/halted? machine) trace-handle)\n                                (throw (ex-info \"Lane did not halt with trace\"\n                                                {:stage :lane-completion :lane backend})))\n                            t (System/nanoTime)\n                            trace (lane/read-trace! trace-handle)]\n                        [backend (assoc (dissoc trace :records) :steps steps\n                                        :run-ms run-ms :drain-ms (ms t))])))]\n    {:status :pass :admission-origin (:admission-origin outcome) :addresses addresses\n     :rows {:pre-stamp (count (:rows before)) :stamped (count (:rows stamped))}\n     :fetch-ms fetch-ms :lanes lanes :elapsed-ms (ms start)}))\n\n(defn check-bounds!\n  \"Refuse missing/nonfinite data and any observed maximum over its declared\n   ceiling. This comparison alone does not enforce limits during execution.\"\n  [limits observed]\n  (when-not (and (map? limits) (seq limits)\n                 (every? (fn [[k v]] (and (keyword? k) (nat-int? v))) limits))\n    (throw (ex-info \"Invalid bounds declaration\" {:stage :bound-declaration})))\n  (doseq [[quantity ceiling] limits]\n    (let [value (get observed quantity)]\n      (when-not (nat-int? value)\n        (throw (ex-info \"Missing or invalid bound measurement\"\n                        {:stage :bound-measurement :quantity quantity})))\n      (when (> value ceiling)\n        (throw (ex-info \"Declared bound exceeded\"\n                        {:stage :bound-exceeded :quantity quantity\n                         :observed value :ceiling ceiling})))))\n  true)\n\n\n(defn runtime-checker\n  \"Build a per-step checker for elapsed time, used heap, trace counts and\n   printed trace bytes. `clock` returns monotonic nanoseconds; `heap` reads\n   host used heap. Limits are observations, not an OS memory cap.\"\n  [limits started clock heap]\n  (when-not (= #{:steps :elapsed-ms :heap-bytes :trace-records\n                 :trace-record-bytes :trace-bytes} (set (keys limits)))\n    (throw (ex-info \"Incomplete runtime bounds\" {:stage :bound-declaration})))\n  (let [monitored (atom nil)]\n    (fn [steps machine]\n      (let [ref (get-in machine [:store 'gate-execution-trace])\n            handle (when ref (get-in machine [:resources (:id ref)]))\n            _ (when (and ref (nil? handle))\n                (throw (ex-info \"Missing trace handle\" {:stage :trace-cursor})))\n            oldest (when handle (stream/cursor handle stream/anchor-oldest))\n            newest (when handle (stream/cursor handle stream/anchor-newest))\n            a (:dao.stream/cursor oldest)\n            b (:dao.stream/cursor newest)\n            first-pos (:dao.stream.ringbuffer/position a)\n            tail (:dao.stream.ringbuffer/position b)\n            _ (when (and handle\n                         (not (and (= :dao.stream/ok (:dao.stream/outcome oldest))\n                                   (= :dao.stream/ok (:dao.stream/outcome newest))\n                                   (nat-int? first-pos) (nat-int? tail)\n                                   (= (:dao.stream.ringbuffer/identity a)\n                                      (:dao.stream.ringbuffer/identity b)))))\n                (throw (ex-info \"Invalid trace cursor\" {:stage :trace-cursor})))\n            _ (when (and handle (pos? first-pos))\n                (throw (ex-info \"Trace prefix evicted\" {:stage :trace-loss :lost first-pos})))\n            prior (when handle (or @monitored {:cursor a :count 0 :sum 0 :max 0}))\n            _ (when (and handle (not= (:dao.stream.ringbuffer/identity (:cursor prior))\n                                      (:dao.stream.ringbuffer/identity a)))\n                (throw (ex-info \"Trace changed during run\" {:stage :trace-cursor})))\n            current (when handle\n                      (loop [{:keys [cursor] :as state} prior]\n                        (if (= cursor b)\n                          state\n                          (let [r (stream/next handle cursor)]\n                            (when-not (= :dao.stream/ok (:dao.stream/outcome r))\n                              (throw (ex-info \"Trace monitor could not read\" {:stage :trace-drain\n                                                                               :outcome (:dao.stream/outcome r)})))\n                            (let [n (alength (.getBytes (pr-str (:dao.stream/value r)) \"UTF-8\"))]\n                              (recur (-> state (assoc :cursor (:dao.stream/cursor r))\n                                         (update :count inc) (update :sum + n)\n                                         (update :max max n))))))))\n            _ (when (and handle (not= tail (:count current)))\n                (throw (ex-info \"Trace monitor count disagrees\" {:stage :trace-drain})))\n            delta (- (clock) started)\n            _ (when (neg? delta) (throw (ex-info \"Clock moved backwards\" {:stage :bound-measurement})))\n            n (or (:count current) 0)\n            bytes (if handle (+ 2 (or (:sum current) 0) (max 0 (dec n))) 0)\n            observed {:steps steps :elapsed-ms (quot (+ delta 999999) 1000000)\n                      :heap-bytes (heap) :trace-records (or tail 0)\n                      :trace-record-bytes (or (:max current) 0) :trace-bytes bytes}]\n        (check-bounds! limits observed)\n        (when handle (reset! monitored current))\n        nil))))\n(ns yang.correspondence-lane\n  \"Measurement-only JVM composition for the D1 C lanes. Not a verifier.\"\n  (:require [dao.stream :as stream]\n            [dao.stream.observer :as observer]\n            [yin.vm :as vm]\n            [yin.vm.ast-walker :as walker]\n            [yin.vm.engine :as engine]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.test-utils :as tu]))\n\n(defn run-measured!\n  \"Run the observer composition with one aggregate step budget. Answers the\n   terminal machine and exact number of vm/step calls, including across\n   multiple observer run callbacks. A blocked machine is not a completed lane.\"\n  [ast modules lane step-limit & [{:keys [check!]}]]\n  (when-not (and (contains? #{:walker :semantic} lane) (nat-int? step-limit)\n                 (or (nil? check!) (ifn? check!)))\n    (throw (ex-info \"Invalid lane or budget\" {:stage :configuration})))\n  (let [steps (atom 0)\n        run (fn [machine]\n              (loop [v machine]\n                (when check! (check! @steps v))\n                (cond\n                  (or (vm/halted? v) (vm/blocked? v)) v\n                  (= @steps step-limit)\n                  (throw (ex-info \"Guest instruction budget exhausted\"\n                                  {:stage :instruction-limit :lane lane\n                                   :steps @steps :consumer v}))\n                  :else (let [v' (vm/step v)]\n                          (swap! steps inc)\n                          (recur v')))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       walker/vm-load-program)\n        session ((if semantic? tu/queue-rows! tu/queue-ast!)\n                 (tu/make-observer-session machine) ast)\n        answer (observer/run-on-stream session engine/ready-for-ingress?\n                                       (vm/fresh-code-loader load-program vm/ast-contract)\n                                       run)]\n    (when-not (zero? (get-in answer [:observer :ingress-gaps]))\n      (throw (ex-info \"Program stream gap\" {:stage :ingress-gap})))\n    {:machine (:consumer answer) :steps @steps}))\n\n(defn read-trace!\n  \"Read a halted lane's ring trace, refusing any evicted prefix or incomplete\n   drain. Byte size is UTF-8 pr-str of the vector, not in-memory occupancy.\"\n  [handle]\n  (let [old (stream/cursor handle stream/anchor-oldest)\n        new (stream/cursor handle stream/anchor-newest)\n        start (:dao.stream/cursor old)\n        end (:dao.stream/cursor new)\n        first-position (:dao.stream.ringbuffer/position start)\n        tail (:dao.stream.ringbuffer/position end)]\n    (when-not (and (= :dao.stream/ok (:dao.stream/outcome old))\n                   (= :dao.stream/ok (:dao.stream/outcome new))\n                   (integer? first-position) (integer? tail)\n                   (= (:dao.stream.ringbuffer/identity start)\n                      (:dao.stream.ringbuffer/identity end)))\n      (throw (ex-info \"Unrecognized trace cursor\" {:stage :trace-cursor})))\n    (when-not (zero? first-position)\n      (throw (ex-info \"Trace prefix evicted\" {:stage :trace-loss :lost first-position})))\n    (loop [cursor start, records []]\n      (let [result (stream/next handle cursor)]\n        (case (:dao.stream/outcome result)\n          :dao.stream/ok (recur (:dao.stream/cursor result)\n                                (conj records (:dao.stream/value result)))\n          (:dao.stream/blocked :dao.stream/end)\n          (if (and (= cursor end) (= tail (count records)))\n            {:records records :record-count (count records)\n             :serialized-bytes (alength (.getBytes (pr-str records) \"UTF-8\"))\n             :max-record-bytes (reduce max 0 (map #(alength (.getBytes (pr-str %) \"UTF-8\")) records))\n             :lost 0 :drain-outcome (:dao.stream/outcome result)}\n            (throw (ex-info \"Incomplete trace drain\" {:stage :trace-drain})))\n          (throw (ex-info \"Trace read refused\" {:stage :trace-drain\n                                                :outcome (:dao.stream/outcome result)})))))))\n\n(defn trace-reachable-heap!\n  \"Measure the trace handle's reachable heap using a supplied host sizer.\n   This counts shared objects reachable from the trace and is not retained size.\"\n  [handle size-fn]\n  (let [n (size-fn handle)]\n    (when-not (and (integer? n) (pos? n))\n      (throw (ex-info \"Invalid trace heap measurement\" {:stage :trace-memory :value n})))\n    n))\n\n(defn measure-trace!\n  \"Capture the graph size before draining, then validate and collect the trace.\"\n  [handle size-fn]\n  (let [bytes (trace-reachable-heap! handle size-fn)]\n    (assoc (read-trace! handle) :reachable-heap-bytes bytes)))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '267,395p' src/cljc/yang/correspondence_verifier.clj; sed -n '4380,4555p' test/yang/latte_oracle_test.clj\"","aggregated_output":"\n(defn attributed?\n  \"Query one already-scoped fixture's table, bindings and complete lane traces.\n   This query does not validate those inputs or authorize reliance on them.\"\n  [{:keys [site-table bindings lanes origin root guest-symbol requested-arity carriers]}]\n  (letfn [(eligible?\n            [entry]\n            (when (and (vector? entry) (= 3 (count entry)))\n              (let [[function arity site] entry\n                    row (get site-table site)\n                    key (get bindings site)]\n                (and row (= site (:site row)) (vector? key) (= 3 (count key))\n                     (vm/occurrence-origin? origin) (= origin (first key))\n                     (jing/segment-address? root) (= root (second key)) (vector? (nth key 2))\n                     (not= :gate-site/none site)\n                     (or (and (= function guest-symbol) (= arity requested-arity))\n                         (some (fn [[carrier carrier-arity mode]]\n                                 (and (contains? #{:ambient-delegation :context-shift :context-copy} mode)\n                                      (= function carrier) (= arity carrier-arity)\n                                      (= carrier (:callee row)) (not (:delegation? row))\n                                      (or (not= :ambient-delegation mode)\n                                          (= :ambient-literal (first (:arg-shapes row))))))\n                               carriers))))))]\n    (every? (fn [lane-id]\n              (let [lane (get lanes lane-id)]\n                (and (= :completed (:status lane)) (true? (:complete? lane))\n                     (some eligible? (:executed-calls lane)))))\n            [:c-walker :c-semantic])))\n\n\n(defn check-fixture!\n  \"Run independent static checks for one supplied compilation. This does not\n   establish admission authenticity, executable-image derivations, trace\n   completeness, durable retrieval, or D1 reliance.\"\n  [{:keys [fixture before stamped origin constructors forms call source-hash\n           site-table bindings metadata]}]\n  (letfn [(require!\n            [condition stage]\n            (when-not condition\n              (throw (ex-info \"Independent fixture check refused\"\n                              {:rule :verifier/fixture :fixture fixture :stage stage}))))]\n    (require! (and fixture (vm/occurrence-origin? origin) (map? before)\n                   (map? stamped) (set? constructors) (some? forms) (some? call)\n                   (string? source-hash) (map? site-table) (map? bindings)\n                   (vector? metadata)) :inputs)\n    (let [actual-hash (try (yang.correspondence-verifier/source-hash forms call)\n                           (catch Exception e\n                             (throw (ex-info \"Source hash reconstruction failed\"\n                                             {:rule :verifier/fixture :fixture fixture :stage :source-hash} e))))]\n      (require! (= source-hash actual-hash) :source-hash))\n    (let [actual-sites (try (site-declarations stamped constructors)\n                            (catch Exception e\n                              (throw (ex-info \"Site reconstruction failed\"\n                                              {:rule :verifier/fixture :fixture fixture :stage :site-declarations} e))))]\n      (require! (= site-table actual-sites) :site-declarations))\n    (let [actual-bindings (try (reconstruct-bindings before stamped origin)\n                               (catch Exception e\n                                 (throw (ex-info \"Binding reconstruction failed\"\n                                                 {:rule :verifier/fixture :fixture fixture :stage :bindings} e))))]\n      (require! (= bindings actual-bindings) :bindings))\n    (let [tree (vm/ast->semantic-bytecode before)\n          markers (filterv #(and (vector? %) (= 5 (count %))\n                                 (= :yang/call-site (nth % 3))) metadata)\n          keys (mapv #(subvec % 0 3) markers)\n          expected (into #{} (map (fn [[root path]] [origin root path]))\n                         (vm/application-occurrences tree))]\n      (require! (and (nil? (vm/validate-rows tree))\n                     (every? #(and (vector? %) (= 5 (count %))) metadata)\n                     (every? #(= 1 (nth % 4)) markers)\n                     (= (count keys) (count (set keys)))\n                     (= expected (set keys))) :metadata))\n    {:fixture fixture :status :static-pass}))\n\n\n(defn fetch-tree!\n  \"Fetch a bounded complete canonical row closure; refuse missing or invalid rows.\"\n  [handle root max-rows]\n  (when-not (and (jing/segment-address? root) (integer? max-rows) (pos? max-rows))\n    (throw (ex-info \"Invalid row retrieval request\" {:rule :verifier/tree-request})))\n  (loop [pending [root] rows {}]\n    (if-let [address (peek pending)]\n      (if (contains? rows address)\n        (recur (pop pending) rows)\n        (do\n          (when (>= (count rows) max-rows)\n            (throw (ex-info \"Row closure exceeds bound\" {:rule :verifier/tree-bound :limit max-rows})))\n          (let [body (jing/get handle address ::missing)\n                grammar (when (and (vector? body) (seq body))\n                          (get vm/semantic-bytecode-grammar (first body)))]\n            (when-not (and grammar (= (count body) (inc (count grammar))))\n              (throw (ex-info \"Missing or malformed row\" {:rule :verifier/tree-row :address address})))\n            (let [row (into [address] body)\n                  children (into []\n                                 (mapcat (fn [[j [_ kind]]]\n                                           (let [v (nth row (+ j 2))]\n                                             (case kind :node [v] :nodes v []))))\n                                 (map-indexed vector grammar))]\n              (when-not (every? jing/segment-address? children)\n                (throw (ex-info \"Malformed child reference\" {:rule :verifier/tree-row :address address})))\n              (recur (into (pop pending) children) (assoc rows address row))))))\n      (let [tree {:root root :rows rows}]\n        (when-let [defect (vm/validate-rows tree)]\n          (throw (ex-info \"Invalid canonical row closure\" {:rule :verifier/tree :defect defect})))\n        tree))))\n\n\n(defn check-replay-root!\n  \"Refuse if a newly compiled replay does not name the retained root.\"\n  [fixture replayed-ast expected-root]\n  (when-not (and (jing/segment-address? expected-root)\n                 (= expected-root (:root (vm/ast->semantic-bytecode replayed-ast))))\n    (throw (ex-info \"Recompiled root differs from retained root\"\n                    {:rule :verifier/fixture :fixture fixture :stage :root})))\n  true)\n                          (= (subvec row 1) (jing/get reopened id ::missing)))\n                        (concat (get-in actual [:tree :rows])\n                                (get-in actual [:stamped-tree :rows])))))\n          (finally (file-store/close! reopened))))\n      (finally\n        (let [f (io/file dir)]\n          (when (.exists f) (run! #(.delete %) (reverse (file-seq f)))))))))\n\n\n(deftest test-d1-independent-site-declarations-and-source-hash\n  ;; Static pilot only. The verifier reads stamped AST expressions directly.\n  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n        compiled (kernel-compile-in-run (fresh-admission-run :d1-independent) fixture true)\n        constructors (correspondence-verifier/context-constructors context-forms)\n        expected (:site-table compiled)\n        actual (correspondence-verifier/site-declarations (:ast compiled) constructors)\n        diff (correspondence-verifier/declaration-differences expected actual)\n        input (:reconstruction-input compiled)\n        hash (correspondence-verifier/source-hash\n               (correspondence-text/read-one! (:id fixture) (:forms-edn input))\n               (correspondence-text/read-one! (:id fixture) (:call-edn input)))]\n    (is (= :compiled (:status compiled)))\n    (is (= (:canonical-source-hash compiled) hash))\n    (is (= {:missing [] :extra [] :different []} diff))\n    (let [produced (:binding (cc3-oracle-binding compiled))\n          rebuilt (correspondence-verifier/reconstruct-bindings\n                    (:compiled-ast compiled) (:ast compiled) (:admission-origin compiled))]\n      (is (= (count produced) (count rebuilt)))\n      (is (true? (= produced rebuilt))))\n    (when (and (seq expected) (= {:missing [] :extra [] :different []} diff))\n      (let [id (first (keys expected))\n            changed (assoc-in expected [id :arg-shapes] [:forged])]\n        (is (= :verifier/site-declarations\n               (try (correspondence-verifier/check-declarations! (:ast compiled) constructors changed)\n                    nil\n                    (catch Exception e (:rule (ex-data e))))))))))\n\n\n(defn- d1-spot-check-refusals!\n  \"One mutated-input check per distinct static-gate refusal class, on the\n   fetched per-fixture input (real corpus data, not synthetics). Each\n   class must refuse at exactly its own stage; anything else reports\n   false and is never a pass.\"\n  [input]\n  (let [site-id (first (keys (:site-table input)))\n        mutations [[:inputs (assoc input :site-table nil)]\n                   [:source-hash (assoc input :source-hash \"wrong\")]\n                   [:site-declarations (assoc-in input [:site-table site-id :arg-shapes] [:forged])]\n                   [:bindings (assoc input :bindings {})]\n                   [:metadata (update input :metadata conj [:malformed])]]]\n    (into {}\n          (map (fn [[expected mutated]]\n                 (let [failure (try (correspondence-verifier/check-fixture! mutated) nil\n                                    (catch Exception e (ex-data e)))]\n                   [expected (= expected (:stage failure))]))\n               mutations))))\n\n\n(defn- d1-store-bytes\n  \"Total bytes of every file currently in one durable store directory.\"\n  [dir]\n  (let [f (io/file dir)]\n    (if-not (.exists f)\n      0\n      (reduce + 0 (map (fn [x] (.length ^java.io.File x))\n                       (filter (fn [x] (.isFile ^java.io.File x))\n                               (file-seq f)))))))\n\n\n(defn- d1-heap-sampler!\n  \"Sample process used heap every interval-ms until stopped; stopping\n   answers the maximum observed. Process-wide JVM figures, a ceiling\n   measurement aid, not an object-graph census.\"\n  [interval-ms]\n  (let [running (atom true)\n        peak (atom 0)\n        sample (fn []\n                 (let [rt (Runtime/getRuntime)]\n                   (swap! peak max (- (.totalMemory rt) (.freeMemory rt)))))\n        thread (Thread. (fn []\n                          (try\n                            (while @running\n                              (sample)\n                              (Thread/sleep interval-ms))\n                            (catch Exception _ (sample)))))]\n    (.start thread)\n    {:stop! (fn []\n              (reset! running false)\n              (.join thread (long (* 5 interval-ms)))\n              (sample)\n              @peak)}))\n\n\n(defn- d1-persist-and-check-fixture!\n  \"Exercise one live admission through a temporary file store and the\n   independent static gate; with opts, also run one mutated-input check\n   per distinct gate refusal class. Does not produce a D1 record or a\n   verifier result.\"\n  [dir run fixture & [{:keys [spot-check? handle]}]]\n  (let [compiled (kernel-compile-in-run run fixture true)\n        _ (when-not (= :compiled (:status compiled))\n            (throw (ex-info \"Fixture did not compile\" {:fixture (:id fixture) :stage :compile})))\n        origin (:admission-origin compiled)\n        evidence (edn/read-string (slurp (io/resource \"yang/latte_oracle/slice9_site_tables.edn\")))\n        expected (get-in evidence [:fixtures (:id fixture)])\n        _ (when-not (and (= 1 (:version evidence)) (map? expected))\n            (throw (ex-info \"Fixture evidence missing\" {:fixture (:id fixture) :stage :evidence})))\n        producer (cc3-oracle-binding compiled)\n        independent (correspondence-verifier/reconstruct-bindings\n                      (:compiled-ast compiled) (:ast compiled) origin)\n        _ (when-not (= independent (:binding producer))\n            (throw (ex-info \"Independent binding disagreement\" {:fixture (:id fixture) :stage :bindings})))\n        snapshot {:fixture (:id fixture) :origin origin\n                  :bindings independent :metadata (:rows producer)\n                  :constructors (correspondence-verifier/context-constructors context-forms)}\n        own-store? (nil? handle)\n        handle (or handle (file-store/open {:type :file :dir dir}))\n        addresses (try (let [root (vm/materialize-tree! handle (:tree producer))\n                             stamped-root (vm/materialize-tree! handle (:stamped-tree producer))]\n                         {:evidence (correspondence/store-evidence! handle evidence)\n                          :input (jing/materialize! handle (:reconstruction-input compiled))\n                          :profile (jing/materialize! handle correspondence-text/profile)\n                          :snapshot (jing/materialize! handle (assoc snapshot :root root :stamped-root stamped-root))\n                          :root root :stamped-root stamped-root})\n                       (finally (when own-store? (file-store/close! handle))))\n        reopened (if own-store? (file-store/open {:type :file :dir dir}) handle)]\n    (try\n      (let [stored-evidence (jing/get reopened (:evidence addresses) ::missing)\n            stored-input (jing/get reopened (:input addresses) ::missing)\n            stored-snapshot (jing/get reopened (:snapshot addresses) ::missing)\n            stored-profile (jing/get reopened (:profile addresses) ::missing)\n            row (get-in stored-evidence [:fixtures (:id fixture)])\n            before-tree (correspondence-verifier/fetch-tree! reopened (:root stored-snapshot) 100000)\n            stamped-tree (correspondence-verifier/fetch-tree! reopened (:stamped-root stored-snapshot) 100000)\n            input (assoc stored-snapshot\n                         :before (vm/semantic-bytecode->ast before-tree)\n                         :stamped (vm/semantic-bytecode->ast stamped-tree)\n                         :forms (correspondence-text/read-one! (:id fixture) (:forms-edn stored-input))\n                         :call (correspondence-text/read-one! (:id fixture) (:call-edn stored-input))\n                         :source-hash (:canonical-source-hash row)\n                         :site-table (:site-table row))\n            _ (when-not (= correspondence-text/profile stored-profile)\n                (throw (ex-info \"Profile missing or changed\" {:fixture (:id fixture) :stage :profile})))\n            _ (when-not (= (:admission-origin stored-input) (:origin stored-snapshot))\n                (throw (ex-info \"Retained admission differs\" {:fixture (:id fixture) :stage :admission})))\n            replay-program (correspondence-text/read-one! (:id fixture) (:program-edn stored-input))\n            replay-options (correspondence-text/read-one! (:id fixture) (:options-edn stored-input))\n            _ (correspondence-verifier/check-replay-root!\n                (:id fixture) (yang/compile-program replay-program true replay-options) (:root stored-snapshot))\n            gate (correspondence-verifier/check-fixture! input)\n            site-id (first (keys (:site-table row)))\n            _ (when-not site-id\n                (throw (ex-info \"No declaration to mutate\" {:fixture (:id fixture) :stage :mutation})))\n            mutated (assoc-in input [:site-table site-id :arg-shapes] [:forged])\n            mutation (try (correspondence-verifier/check-fixture! mutated) nil\n                          (catch Exception e (ex-data e)))]\n        (when-not (= :site-declarations (:stage mutation))\n          (throw (ex-info \"Mutated declaration was not refused\" {:fixture (:id fixture) :stage :mutation})))\n        {:gate gate :mutation-stage (:stage mutation) :addresses addresses\n         :admission-origin (:origin stored-snapshot) :evidence-address (:evidence addresses)\n         :rows {:pre-stamp (count (:rows before-tree))\n                :stamped (count (:rows stamped-tree))}\n         :sites (count (:site-table row))\n         :spot-checks (when spot-check? (d1-spot-check-refusals! input))})\n      (finally (when own-store? (file-store/close! reopened))))))\n\n\n(deftest test-d1-persisted-per-fixture-static-gate\n  ;; A single fixture and temporary store; this is not a published D1 record.\n  (let [fixture (first (filter #(= :beta-eq-false (:id %)) (:fixtures kernel-gate-corpus)))\n        run (fresh-admission-run :d1-r7-static)\n        dir (str \"target/test-d1-r7-\" (random-uuid))]\n    (try\n      (let [result (d1-persist-and-check-fixture! dir run fixture)]\n        (is (= {:fixture :beta-eq-false :status :static-pass} (:gate result)))\n        (is (= :site-declarations (:mutation-stage result)))\n","exit_code":0,"status":"completed"}}
