{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/latte_oracle_test.clj | sed -n '2460,2600p'; nl -ba test/yang/latte_oracle_test.clj | sed -n '4150,4330p'\"","aggregated_output":"  2460\t        \"distinct generated symbols must remain distinct\")\n  2461\t    (is (not= (kernel-canonical-source-hash '[(def x 1)] 'x)\n  2462\t              (kernel-canonical-source-hash '[(def x 2)] 'x))\n  2463\t        \"ordinary source edits still invalidate the hash\")))\n  2464\t\n  2465\t\n  2466\t(defn- fresh-admission-run\n  2467\t  \"Allocate ONE admission run, at the run composition (the top of an\n  2468\t   evidence/binding run): a fresh scope supplied as plain data plus a\n  2469\t   run-local ordinal allocator. Thread the returned run through\n  2470\t   `kernel-row` / `kernel-compile` via the `-in-run` callers, which\n  2471\t   assign DISTINCT ordinals within this run. Fresh runs call this\n  2472\t   again and get distinct scopes; replay does NOT call this — it\n  2473\t   explicitly re-supplies the retained run's scope+ordinal (or reuses\n  2474\t   the retained compilation). No global counter: the atom is created\n  2475\t   per run, held only by the run map the composition threads.\"\n  2476\t  [label]\n  2477\t  {:scope (str (name label) \"-\" (java.util.UUID/randomUUID))\n  2478\t   :next-ordinal (atom 0)})\n  2479\t\n  2480\t\n  2481\t(defn- admission-run-ordinal\n  2482\t  [run]\n  2483\t  (let [ordinal @(:next-ordinal run)]\n  2484\t    (swap! (:next-ordinal run) inc)\n  2485\t    ordinal))\n  2486\t\n  2487\t\n  2488\t(defn- kernel-compile\n  2489\t  \"Compile one oracle fixture under an explicit admission coordinate.\n  2490\t\n  2491\t   The admitting composition supplies `admission-scope` and the\n  2492\t   per-scope `admission-ordinal` (both plain data); the batch token\n  2493\t   of the admission origin `[:source :program batch-token j]` is the\n  2494\t   pair `[admission-scope admission-ordinal]` and the member index\n  2495\t   `j` is zero, because each admission here is a separately admitted\n  2496\t   single-member batch — the ordinal therefore distinguishes\n  2497\t   admissions through the token, and projected keys (reconstructed\n  2498\t   from a single-member envelope, member index always zero) agree\n  2499\t   with the recorded origin for every ordinal. Both coordinates are\n  2500\t   recorded WHEN ADMITTING, before compilation, validated by the\n  2501\t   same origin-shape rules as every source origin\n  2502\t   (`vm/source-origin`), and retained with the compilation as\n  2503\t   `:admission-origin` plain data. There is no per-JVM global\n  2504\t   counter (r3 F2) and no default admission stamping every admission\n  2505\t   alike (r4 F2): every caller supplies its coordinates explicitly,\n  2506\t   and replay of one retained compilation reuses its recorded\n  2507\t   coordinate.\"\n  2508\t  ([fixture admission-scope admission-ordinal]\n  2509\t   (kernel-compile fixture admission-scope admission-ordinal false))\n  2510\t  ([fixture admission-scope admission-ordinal retain-input?]\n  2511\t   (let [call (kernel-c-program fixture)\n  2512\t         forms (kernel-closure call)\n  2513\t         source-hash (kernel-canonical-source-hash forms call)\n  2514\t         admission-origin (vm/source-origin\n  2515\t                            :program [admission-scope admission-ordinal] 0)\n  2516\t         program (into (into ['(def gate-execution-trace (stream/make 1000000))]\n  2517\t                             kernel-site-prelude)\n  2518\t                       (concat (map kernel-trace-form forms) [call]))\n  2519\t         program (into (yang/library-for program) program)\n  2520\t         opts (update arg-vector-opts :native into\n  2521\t                      (map (fn [[op profile]] [(clojure.core/symbol \"stream\" (name op)) profile])\n  2522\t                           module/stream-profiles))\n  2523\t         compiled (yang/compile-program program true opts)\n  2524\t         ;; caller-side site ids at the compiled application expressions,\n  2525\t         ;; post-macroexpansion (R2), with the mechanically derived site\n  2526\t         ;; table (R7); every assembled definition is instrumented\n  2527\t         {stamped :ast sites :sites} (kernel-stamp-sites\n  2528\t                                       compiled (into #{} (map second) forms))\n  2529\t         missing (unbound-ast-symbols stamped program)]\n  2530\t     (if (seq missing)\n  2531\t       {:status :blocked :phase :admission :blocked-by (vec (sort missing))\n  2532\t        :owners (into {} (for [s missing]\n  2533\t                           [s (mapv second (filter #(some #{s} (tree-seq coll? seq %)) program))]))}\n  2534\t       (cond-> {:status :compiled :ast stamped :forms forms :compiled-ast compiled\n  2535\t                :admission-origin admission-origin\n  2536\t                :admission-scope admission-scope\n  2537\t                :admission-ordinal admission-ordinal\n  2538\t                :site-table (into {} (map (juxt :site identity)) sites)\n  2539\t                :site-table-hash source-hash\n  2540\t                :sites sites\n  2541\t                :canonical-source-hash source-hash}\n  2542\t         retain-input?\n  2543\t         (assoc :reconstruction-input\n  2544\t                {:fixture fixture :forms forms :call call :program program\n  2545\t                 :program-edn (binding [*print-meta* true *print-length* nil *print-level* nil]\n  2546\t                                (pr-str program))\n  2547\t                 :options opts :admission-origin admission-origin}))))))\n  2548\t\n  2549\t\n  2550\t(defn- kernel-compile-in-run\n  2551\t  \"Compile `fixture` as the next admission of `run`: the run's scope\n  2552\t   with a distinct ordinal assigned by the run composition.\"\n  2553\t  ([run fixture] (kernel-compile-in-run run fixture false))\n  2554\t  ([run fixture retain-input?]\n  2555\t   (kernel-compile fixture (:scope run) (admission-run-ordinal run) retain-input?)))\n  2556\t\n  2557\t\n  2558\t(defn- kernel-c\n  2559\t  [compiled lane]\n  2560\t  (if (= :compiled (:status compiled))\n  2561\t    (assoc (kernel-attempt\n  2562\t             #(let [machine (compiler-test/run-guest-machine\n  2563\t                              (:ast compiled) (oracle-registry yang/kind-module) lane 4000000)\n  2564\t                    v (vm/value machine)\n  2565\t                    ref (get-in machine [:store 'gate-execution-trace])\n  2566\t                    handle (get-in machine [:resources (:id ref)])]\n  2567\t                (when-not (and (vm/halted? machine) handle)\n  2568\t                  (throw (ex-info \"Execution trace did not complete\" {:lane lane})))\n  2569\t                {:status :completed :outcome (evidence-data v) :shape (result-shape (evidence-data v))\n  2570\t                 :executed-calls (tu/drain handle)}))\n  2571\t           :lane lane)\n  2572\t    (assoc compiled :lane lane)))\n  2573\t\n  2574\t\n  2575\t;; =============================================================================\n  2576\t;; Depth harness (max live-K per workload)\n  2577\t;; =============================================================================\n  2578\t;;\n  2579\t;; Measurement only: no admission gate and no correctness assertions. Each\n  2580\t;; kernel-gate fixture is a workload; the max continuation depth (the semantic\n  2581\t;; lane's K-vector length, the walker lane's :next chain length) is recorded\n  2582\t;; per lane. The same instrumentation applies to the pre-port outcome-model\n  2583\t;; tree and the post-port continuation tree, so the two numbers are directly\n  2584\t;; comparable.\n  2585\t\n  2586\t(defn- kernel-lane-depth\n  2587\t  \"The max live-K depth of one compiled fixture on `lane`.\"\n  2588\t  [compiled lane]\n  2589\t  (when (= :compiled (:status compiled))\n  2590\t    (:max-depth (compiler-test/run-guest-machine-depth\n  2591\t                  (:ast compiled) (oracle-registry yang/kind-module) lane 4000000))))\n  2592\t\n  2593\t\n  2594\t(defn kernel-gate-depths\n  2595\t  \"Per-workload max live-K depth for the kernel-gate corpus, both lanes, as a\n  2596\t   sorted map fixture-id -> {:walker n :semantic m}.\"\n  2597\t  []\n  2598\t  (let [run (fresh-admission-run :depth-harness)]\n  2599\t    (into (sorted-map)\n  2600\t          (for [fixture (:fixtures kernel-gate-corpus)\n  4150\t  ;; with the compilation as plain data — no per-JVM global counter\n  4151\t  ;; and no default admission that stamps every admission alike.\n  4152\t  ;; Distinct scopes with restarted ordinals AND distinct ordinals\n  4153\t  ;; within one scope, admitting identical content, mint distinct\n  4154\t  ;; origins; every ordinal (including a nonzero one) binds\n  4155\t  ;; end-to-end, projected and searched keys agreeing; replaying one\n  4156\t  ;; retained admission keeps its one origin.\n  4157\t  (let [fixture {:id :cc3-binding\n  4158\t                 :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n  4159\t        a (kernel-compile fixture \"run-a\" 0)\n  4160\t        b (kernel-compile fixture \"run-b\" 0)\n  4161\t        a1 (kernel-compile fixture \"run-a\" 1)]\n  4162\t    (is (= :compiled (:status a)))\n  4163\t    (is (= :compiled (:status b)))\n  4164\t    (is (= :compiled (:status a1)))\n  4165\t    (is (= (:canonical-source-hash a) (:canonical-source-hash b)\n  4166\t           (:canonical-source-hash a1))\n  4167\t        \"precondition: the content really is identical\")\n  4168\t    (is (= [\"run-a\" 0] (nth (:admission-origin a) 2))\n  4169\t        \"the batch token carries both the scope and the ordinal\")\n  4170\t    (is (= [\"run-b\" 0] (nth (:admission-origin b) 2)))\n  4171\t    (is (= [\"run-a\" 1] (nth (:admission-origin a1) 2))\n  4172\t        \"a nonzero ordinal rides the token, not the member index\")\n  4173\t    (is (= 0 (nth (:admission-origin a) 3)\n  4174\t           (nth (:admission-origin b) 3)\n  4175\t           (nth (:admission-origin a1) 3))\n  4176\t        \"separately admitted single-member batches keep member index 0\")\n  4177\t    (is (not= (:admission-origin a) (:admission-origin b))\n  4178\t        \"distinct scopes with restarted ordinals mint distinct origins\")\n  4179\t    (is (not= (:admission-origin a) (:admission-origin a1))\n  4180\t        \"same scope, different ordinal mints a distinct origin\")\n  4181\t    (let [ba (cc3-oracle-binding a)\n  4182\t          bb (cc3-oracle-binding b)\n  4183\t          ba1 (cc3-oracle-binding a1)]\n  4184\t      (is (= (:admission-origin a) (:origin ba)))\n  4185\t      (is (= (:admission-origin b) (:origin bb)))\n  4186\t      (is (= (:admission-origin a1) (:origin ba1))\n  4187\t          \"a nonzero ordinal binds end-to-end: projected and searched keys agree\")\n  4188\t      (is (= (:binding ba) (:binding (cc3-oracle-binding a)))\n  4189\t          \"replay reuses the recorded coordinate of scope run-a\")\n  4190\t      (is (= (set (keys (:binding ba))) (set (keys (:binding bb)))\n  4191\t             (set (keys (:binding ba1)))))\n  4192\t      (is (not= (set (vals (:binding ba))) (set (vals (:binding bb))))\n  4193\t          \"the same sites bind under each admission's own origin\")\n  4194\t      (is (not= (set (vals (:binding ba))) (set (vals (:binding ba1))))\n  4195\t          \"the same sites bind under each ordinal's own origin\"))))\n  4196\t\n  4197\t\n  4198\t(deftest test-cc3-caller-run-threads-distinct-admissions\n  4199\t  ;; cc3 r5 F2 residue: pin through the ACTUAL caller path. One\n  4200\t  ;; evidence run allocates its scope ONCE; `kernel-row` (the caller\n  4201\t  ;; every fixture row goes through) assigns DISTINCT ordinals within\n  4202\t  ;; that run, so identical content admitted twice in one run mints\n  4203\t  ;; distinct origins. A fresh run supplies a distinct scope (ordinal\n  4204\t  ;; restar