[key [origin (:root tree) pre-path]]\n  3837\t                                                   (when-not (contains? marked key)\n  3838\t                                                     (throw (ex-info\n  3839\t                                                              \"Stamped site maps to no validated C1 occurrence\"\n  3840\t                                                              {:rule :cc3-stamp-correspondence\n  3841\t                                                               :site k\n  3842\t                                                               :key key})))\n  3843\t                                                   [k path key])))))))\n  3844\t                             (cc3-walk (:ast compiled) [] []))\n  3845\t          _ (when (not= (count site-entries)\n  2400\t\n  2401\t\n  2402\t(defn- kernel-executed-arity?\n  2403\t  \"The ruled attribution query over `row`'s two caller-site-tagged C-lane\n  2404\t   traces: upstream `symbol` at arity `n` is credited when BOTH lanes\n  2405\t   record a body entry the query admits (kernel-record-credits?), and\n  2406\t   the site table in the row is the one this program's canonical source\n  2407\t   hashed to (R2b case 3: a table from another fixture, or a stale table\n  2408\t   after an edit, refuses). The retired offset-table matching (any\n  2409\t   record at arity n+offset, from any call origin) is gone.\"\n  2410\t  [row symbol n]\n  2411\t  (let [table (:site-table row)\n  2412\t        hash-matches? (or (nil? (:site-table-hash row))\n  2413\t                          (= (:canonical-source-hash row) (:site-table-hash row)))]\n  2414\t    (and hash-matches?\n  2415\t         (every? (fn [lane]\n  2416\t                   (some #(kernel-record-credits? % table symbol n)\n  2417\t                         (get-in row [lane :executed-calls])))\n  2418\t                 [:c-walker :c-semantic]))))\n  2419\t\n  2420\t\n  2421\t(defn- kernel-canonical-source-hash\n  2422\t  \"The canonical-source-hash of one fixture's inlined adaptation (R2b\n  2423\t   case 3): the digest of the assembled context layer and guest sources —\n  2424\t   the adapter this fixture inlines. Reader-generated symbols are renamed\n  2425\t   by first occurrence across forms and call, preserving shared references\n  2426\t   without depending on the process's gensym counter. A trace evaluated\n  2427\t   against a table whose recorded hash differs refuses attribution.\"\n  2428\t  [forms call]\n  2429\t  (let [source [forms call]\n  2430\t        gensyms (distinct (filter #(and (symbol? %)\n  2431\t                                        (re-matches #\"^[a-zA-Z0-9_.-]+__\\d+(?:__auto__)?#?$\"\n  2432\t                                                    (name %)))\n  2433\t                                  (tree-seq coll? seq source)))\n  2434\t        renames (into {} (map-indexed (fn [i s] [s (symbol (str \"$gensym_\" (inc i)))])\n  2435\t                                      gensyms))\n  2436\t        payload (binding [*print-length* nil *print-level* nil]\n  2437\t                  (pr-str (walk/postwalk-replace renames source)))]\n  2438\t    (apply str (map #(format \"%02x\" (bit-and 255 %))\n  2439\t                    (.digest (java.security.MessageDigest/getInstance \"SHA-256\")\n  2440\t                             (.getBytes payload \"UTF-8\"))))))\n  2441\t\n  2442\t\n  2443\t(deftest test-kernel-canonical-source-hash\n  2444\t  (testing \"fresh reads of pinned NBE source ignore reader gensym counters\"\n   100\t    (throw (ex-info \"Malformed correspondence recipe\" {:rule :correspondence/recipe})))\n   101\t  (doseq [address [(:yang.correspondence.recipe/profile recipe)\n   102\t                   (:yang.correspondence.recipe/coverage recipe)]]\n   103\t    (require-content! handle address))\n   104\t  (jing/materialize! handle recipe))\n   105\t\n   106\t(defn store-record!\n   107\t  \"Store a structurally valid correspondence with its direct references present.\n   108\t   Checks declared roots and markers, but not paths, transitive closures,\n   109\t   derivations, or attribution.\"\n   110\t  [handle record]\n   111\t  (when-not (correspondence? record)\n   112\t    (throw (ex-info \"Malformed correspondence\" {:rule :correspondence/record})))\n   113\t  (let [recipe (require-content! handle (:yang.correspondence/recipe record))\n   114\t        inputs (:yang.correspondence/inputs record)]\n   115\t    (when-not (recipe? recipe)\n   116\t      (throw (ex-info \"Malformed correspondence recipe\" {:rule :correspondence/recipe})))\n   117\t    (let [evidence (require-content! handle (:yang.correspondence/evidence record))\n   118\t          coverage (require-content! handle (:yang.correspondence.recipe/coverage recipe))]\n   119\t      (when-not (and (= [:slice9-site-tables 1] (:yang.correspondence.recipe/evidence-contract recipe))\n   120\t                     (map? evidence) (= 1 (:version evidence)) (map? (:fixtures evidence)))\n   121\t        (throw (ex-info \"Unsupported oracle evidence contract\"\n   122\t                        {:rule :correspondence/evidence-schema})))\n   123\t      (when (and (or (empty? (:yang.correspondence/artifacts record))\n   124\t                     (empty? (:yang.correspondence/instruction-provenance record)))\n   125\t                 (not= :tree-only (:scope coverage)))\n   126\t        (throw (ex-info \"Empty image claims require tree-only coverage\"\n   127\t                        {:rule :correspondence/coverage}))))\n   128\t    (doseq [[_ index] (:yang.correspondence.recipe/input-roles recipe)]\n   129\t      (when-not (< index (count inputs))\n   130\t        (throw (ex-info \"Recipe input is absent\" {:rule :correspondence/input-role :index index}))))\n   131\t    (doseq [address (concat [(:yang.correspondence/evidence record)\n   132\t                             (:yang.correspondence.recipe/profile recipe)\n   133\t                             (:yang.correspondence.recipe/coverage recipe)\n   134\t                             (:yang.correspondence/metadata record)]\n   135\t                            inputs\n   136\t                            (:yang.correspondence/roots record)\n   137\t                            (:yang.correspondence/instruction-provenance record)\n   138\t                            (mapcat (juxt :storage :derivation)\n   139\t                                    (:yang.correspondence/artifacts record)))]\n   140\t      (require-content! handle address))\n   141\t    (let [metadata (require-content! handle (:yang.correspondence/metadata record))\n   142\t          roots (set (:yang.correspondence/roots record))\n   143\t          marker-counts (frequencies metadata)]\n   144\t      (when-not (vector? metadata)\n   145\t        (throw (ex-info \"Malformed frontend metadata\" {:rule :correspondence/metadata})))\n   146\t      (doseq [[_ [origin root path]] (:yang.correspondence/origin-bindings record)]\n   147\t        (when-not (and (contains? roots root)\n   148\t                       (= 1 (get marker-counts [origin root path :yang/call-site 1])))\n   149\t          (throw (ex-info \"Binding has no declared root and unique marker\"\n   150\t                          {:rule :correspondence/binding-endpoint})))))\n   151\t    (jing/materialize! handle record)))\n   152\t\n   153\t(defn binding-coverage?\n   154\t  \"Check one compilation's site and marker relations against its row tree.\n   155\t   This does not reconstruct the binding or independently derive site classes.\"\n   156\t  [site-table origin tree metadata bindings]\n   157\t  (and (map? site-table) (vm/occurrence-origin? origin)\n   158\t       (map? tree) (vector? metadata) (vector? bindings)\n   159\t       (every? #(and (vector? %) (= 5 (count %))) metadata)\n   160\t       (distinct-vector? bindings binding?)\n   161\t       (let [markers (filterv #(= :yang/call-site (nth % 3)) metadata)\n   162\t             keys-of (mapv #(subvec % 0 3) markers)\n   163\t             eligible (into #{} (map (fn [[root path]] [origin root path]))\n   164\t                            (vm/application-occurrences tree))\n   165\t             ids (mapv first bindings)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"agent_message","text":"I’m selecting (A): admission-captured text is the reconstruction input, with a per-input replay gate. Decoded snapshots add no ordering guarantee and can be derived from the text. The review also found that the oracle source hash traverses and prints `forms` and `call`, so preserving only `:program-edn` leaves another replay dependency unresolved."}}
