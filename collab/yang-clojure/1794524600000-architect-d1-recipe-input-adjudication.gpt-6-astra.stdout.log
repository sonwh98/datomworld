ipe))\n    34\t  (is (correspondence/correspondence? record-value))\n    35\t  (testing \"unknown keys and schema revisions are refused\"\n    36\t    (is (not (correspondence/recipe? (assoc recipe :extra true))))\n    37\t    (is (not (correspondence/correspondence? (assoc record-value :verified true))))\n    38\t    (is (not (correspondence/correspondence? (assoc record-value :yang.correspondence/schema 2)))))\n    39\t  (testing \"addresses, unique declarations, and persisted origin shapes are required\"\n    40\t    (is (not (correspondence/correspondence? (assoc record-value :yang.correspondence/evidence \"commit\"))))\n    41\t    (is (not (correspondence/correspondence? (assoc record-value :yang.correspondence/inputs [address-a address-a]))))\n    42\t    (is (not (correspondence/correspondence? (assoc record-value :yang.correspondence/origin-bindings [[0 [[:ephemeral :scope :run 0] address-b []]]]))))\n    43\t    (is (not (correspondence/correspondence? (assoc record-value :yang.correspondence/origin-bindings (vec (repeat 2 (first (:yang.correspondence/origin-bindings record-value))))))))))\n    44\t\n    45\t#?(:clj\n    46\t   (deftest frozen-evidence-content-addressed-round-trip\n    47\t     (let [file (io/resource \"yang/latte_oracle/slice9_site_tables.edn\")\n    48\t           bytes (java.nio.file.Files/readAllBytes (.toPath (io/file file)))\n    49\t           hash (format \"%064x\" (BigInteger. 1 (.digest (java.security.MessageDigest/getInstance \"SHA-256\") bytes)))\n    50\t           evidence (edn/read-string (slurp file))\n    51\t           store (mem/create-content-mem)\n    52\t           address (correspondence/store-evidence! store evidence)]\n    53\t       (is (= \"e435ac4072ba0a3c278fbe91918d22184b43f0a8d6c1e397c09f68dd629beb75\" hash))\n    54\t       (is (= 1 (:version evidence)))\n    55\t       (is (jing/segment-address? address))\n    56\t       (is (= evidence (jing/get store address ::missing)))\n    57\t       (is (thrown? Exception (correspondence/store-evidence! store (assoc evidence :version 2)))))))\n    58\t\n    59\t#?(:clj\n    60\t   (deftest addressed-record-references-must-be-retrievable\n    61\t     (let [store (mem/create-content-mem)\n    62\t           put #(jing/materialize! store %)\n    63\t           evidence (correspondence/store-evidence! store {:version 1 :fixtures {}})\n    64\t           profile (put {:frontend :test})\n    65\t           coverage (put {:scope :tree-only})\n    66\t           input (put {:source '(example)})\n    67\t           root (put [:test-root])\n    68\t           metadata (put [])\n    69\t           r (assoc recipe :yang.correspondence.recipe/profile profile\n    70\t                           :yang.correspondence.recipe/coverage coverage)\n    71\t           r-address (correspondence/store-recipe! store r)\n    72\t           d (assoc record-value :yang.correspondence/evidence evidence\n    73\t                                 :yang.correspondence/recipe r-address\n    74\t                                 :yang.correspondence/inputs [input]\n    75\t                                 :yang.correspondence/roots [root]\n    76\t                                 :yang.correspondence/metadata metadata\n    77\t                                 :yang.correspondence/origin-bindings [])\n    78\t           address (correspondence/store-record! store d)]\n    79\t       (is (= r (jing/get store r-address ::missing)))\n    80\t       (is (= d (jing/get store address ::missing)))\n    81\t       (is (= address (jing/segment-key d)))\n    82\t       (is (thrown? Exception (correspondence/store-record! store (assoc d :yang.correspondence/inputs [address-a]))))\n    83\t       (is (thrown? Exception (correspondence/store-recipe! store (assoc r :yang.correspondence.recipe/profile address-a))))\n    84\t       (is (thrown? Exception (correspondence/store-record! store (assoc d :yang.correspondence/inputs []))))\n    85\t       (let [origin [:source :program [\"live\" 0] 0]\n    86\t             site [origin root []]\n    87\t             marker [origin root [] :yang/call-site 1]\n    88\t             bound (assoc d :yang.correspondence/metadata (put [marker])\n    89\t                            :yang.correspondence/origin-bindings [[1 site]])]\n    90\t         (is (jing/segment-address? (correspondence/store-record! store bound)))\n    91\t         (is (thrown? Exception (correspondence/store-record! store (assoc bound :yang.correspondence/metadata metadata))))\n    92\t         (is (thrown? Exception (correspondence/store-record! store (assoc bound :yang.correspondence/roots [input])))))\n    93\t       (let [wrong (put {:version 2 :fixtures {}})]\n    94\t         (is (thrown? Exception (correspondence/store-record! store (assoc d :yang.correspondence/evidence wrong)))))\n    95\t       (let [other-coverage (put {:scope :images})\n    96\t             other-recipe (correspondence/store-recipe! store (assoc r :yang.correspondence.recipe/coverage other-coverage))]\n    97\t         (is (thrown? Exception (correspondence/store-record! store (assoc d :yang.correspondence/recipe other-recipe))))))))\n    98\t\n    99\t#?(:clj\n   100\t   (defn- write-durable-fixture!\n   101\t     [handle evidence]\n   102\t     (let [put #(jing/materialize! handle %)\n   103\t           evidence-address (correspondence/store-evidence! handle evidence)\n   104\t           profile (put {:frontend :test})\n   105\t           coverage (put {:scope :tree-only})\n   106\t           input (put {:source '(example)})\n   107\t           root (put [:test-root])\n   108\t           metadata (put [])\n   109\t           recipe-value (assoc recipe :yang.correspondence.recipe/profile profile\n   110\t                                      :yang.correspondence.recipe/coverage coverage)\n   111\t           recipe-address (correspondence/store-recipe! handle recipe-value)\n   112\t           d1 (assoc record-value :yang.correspondence/evidence evidence-address\n   113\t                                  :yang.correspondence/recipe recipe-address\n   114\t                                  :yang.correspondence/inputs [input]\n   115\t                                  :yang.correspondence/roots [root]\n   116\t                                  :yang.correspondence/metadata metadata\n   117\t                                  :yang.correspondence/origin-bindings [])\n   118\t           d1-address (correspondence/store-record! handle d1)]\n   119\t       (mapv (fn [[address value]]\n   120\t               [address value ((:get-bytes-fn handle) address nil)])\n   121\t             [[evidence-address evidence] [recipe-address recipe-value] [d1-address d1]]))))\n   122\t\n   123\t#?(:clj\n   124\t   (deftest file-backed-roundtrip\n   125\t     (let [dir (str \"target/test-d1-correspondence-\" (random-uuid))\n   126\t           file (io/resource \"yang/latte_oracle/slice9_site_tables.edn\")\n   127\t           evidence (edn/read-string (slurp file))\n   128\t           handle (file-store/open {:type :file :dir dir})]\n   129\t       (try\n   130\t         (let [written (try (write-durable-fixture! handle evidence)\n   131\t                            (finally (file-store/close! handle)))\n   132\t               reopened (file-store/open {:type :file :dir dir})]\n   133\t           (try\n   134\t             (doseq [[address value bytes] written]\n   135\t               (is (= value (jing/get reopened address ::missing)))\n   136\t               (is (java.util.Arrays/equals ^bytes bytes\n   137\t                                             ^bytes ((:get-bytes-fn reopened) address nil))))\n   138\t             (finally (file-store/close! reopened))))\n   139\t         (finally\n   140\t           (let [f (io/file dir)]\n   141\t             (when (.exists f)\n   142\t               (run! #(.delete %) (reverse (file-seq f))))))))))\n# D1 continuation r2: partial findings\n\nStatus: **incomplete, not verified, not accepted**. This continues `1794670000001-engineer-d1-correspondence-partial.findings.md`, which remains the round-1 record. No companion file, complete recipe/profile, published corpus record, verifier result, tagged run or commit was made. Nothing in this round authorizes reliance. Worktree mirror only; promotion to canonical collab was not performed.\n\n## Inventory refresh and decisions\n\n- At dispatch the worktree was `d1-correspondence` @ `56cc5ca36855c0d047c11b7658e79cfc27d238e6`, with the round-1 files untracked. Changed contracts are confined to the new experimental `yang.correspondence` API; no existing serialized contract was changed. The v1 site table remains byte-identical (SHA-256 `e435ac4072ba0a3c278fbe91918d22184b43f0a8d6c1e397c09f68dd629beb75`). Inspection found 155 fixtures and 20,805 total fixture-local declarations; all fixture maps have keys `:canonical-source-hash`, `:site-table`, and all site rows have keys `:site`, `:callee`, `:arg-shapes`, `:def`, `:delegation?`. These observations do not substitute for a normative oracle schema validator.\n- Row-lane-only restriction remains D1's decision; no datom bridge is claimed. `collab/exception-track/1794343000000-exception-track-surface-registry.md` has an active ledger, records cc3 landed, and gives the port the `clojure.cljc`/prelude seat; its last visible amendment is older than this base's port and shell merges. It names no active linearizer/derive claim except a conditional fallback, but status in that historical worktree cannot prove no newer external writer. No bridge or forbidden surface was edited.\n- Additional read-only image contracts: `yin.vm.linker/ast-format` (`v3`, rows), `semantic-format` (`v4`), `stack-format` (`b2`), `register-format` (`r2`), `record-format` (derive), and `manifest-format` (schema 1). `yin.vm.linker/verify` checks an individual image's identity and contract; its verifying derivation policy implements `yin.vm.ledger/lowering-profile`, `stack-lowering-profile`, and `register-lowering-profile`. Image storage identity and executable identity are distinct where their format says so. Published C1 and instruction-provenance side records remain outside the manifest. Actual retrieval/verification of each image, derivation and provenance has not been performed here.\n- `yin.vm/materialize-tree!` persists each validated canonical row body separately by its root/row address. `yin.vm.encoder/source-envelope` and `project` supply recorded source-origin coordinates and marker rows; cc3 test's `cc3-oracle-binding` supplies the post-stamp translation. `kernel-compile` records admission coordinates before compilation. Exact retained expansion environment/attempt records and all reconstruction inputs remain unestablished; the recipe must not invent them.\n- Post-port rebind note `1794519755000-engineer-post-port-oracle-reverification.glm-5.3.findings.md` §item 3 was read from canonical collab. It pins Phase 3r `8456c2e9`: two wrapper applications, site extraction `[:operands 1 :operands 1 :value]`, translated wrapped-argument path `[3 1] [3 2]`, and two inserted applications per site. This is not an independent D1 reconstruction.\n- Discovery, index projection/signature, durable retention owner, the complete reachable input closure and full artifact inventory are **not pinned**. The inventory refresh remains incomplete. The shell/refactor, port and frozen-evidence corrections in round 1 still apply.\n\n## Work and limits\n\n- `store-evidence!` materializes the entire version-1 evidence map, and the test fetches the unchanged complete value from Jing and pins the source bytes and `:version`. The test uses an in-memory store; it proves a codec/address round trip, not durable retention after process exit. The outer shape guard is not a complete row-level schema validator.\n- `store-recipe!` and `store-record!` materialize structurally valid values after checking direct address availability, input-role indexes, supported evidence contract, tree-only declaration for empty image/provenance vectors, and a declared root plus unique C1 marker for each claimed binding. They do **not** establish path existence, transitive closure, producer/reconstruction equivalence, derivations, or attribution; a stored value remains a claim. The provisional tree-only coverage map used by the tests is not a completed pinned corpus recipe.\n- `binding-coverage?` compares one compilation's marker set to row-derived application occurrences and checks exact fixture-local site IDs and unique targets. It checks supplied bindings, not how they were produced. A fresh static `:beta-eq-false` compilation reproduced its frozen source hash and table, retained the admission origin, and passed these checks; negative checks reject dropped site IDs, duplicated markers, and an ephemeral origin. This uses cc3's producer binding and cannot serve as independent verification.\n- New code and tests are uncommitted. The round-trip fixture for recipe/record storage is synthetic; there is **no** complete pinned-corpus D1 record or companion, and no claim of a persisted live corpus admission. The existing evidence table predates this run; the pilot does not manufacture an origin for its historical run.\n\n## Validation and unfinished acceptance\n\nRed-first tests: missing evidence-storage function, missing recipe-storage function, missing binding-coverage function, and rejection cases for unsupported evidence/missing tree-only coverage/marker or root were observed red before their fixes. Focused static oracle test passed 1 test / 12 assertions, without running tagged C lanes. Combined `clojure -M:test -n yang.correspondence-test -n yang.clojure-callsite-test` passed 46 tests / 608 assertions, with 0 failures and 0 errors. clj-kondo 2026.08.04 reported 0 errors and 0 warnings across the three code/test files. Full oracle suite was not run.\n\nRemaining: finish the inventory; pin and persist the complete compilation inputs, exact recipe/profile and real admission/expansion records; produce and retain the companion record for the corpus; independently rederive source hash, declarations and stamped-to-unstamped mappings; verify complete C1 and instruction multiplicities and each image under its own execution contract and verifying derivation chain; query both C traces; publish a separate verifier result with verifier revision; measure static pilots and declare all finite D1 ceilings before any tagged verification run. cc3 v2.1 measurements remain historical baselines, not D1 results. No D1 tagged preflight or tagged run has occurred.\n","exit_code":0,"status":"completed"}}
