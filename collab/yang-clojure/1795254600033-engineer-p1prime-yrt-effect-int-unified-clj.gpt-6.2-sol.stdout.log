{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2995,3078p;1547,1603p' src/cljc/yang/clojure.cljc; rg -n 'admit-call-descriptor|intra_call|intra' src/cljc/yang/clojure.cljc; sed -n '1,125p' test/yang/clojure/donor_link_test.clj; sed -n '50,105p' test/yang/call/conformance.clj; rg -n 'native-primitives|\\\\x27\\\\+|\\\\x27<=|def.*get' src/cljc/yin/vm/{module,data}.cljc | tail -25; sed -n '1,85p' src/cljc/yang/core/prelude_admission.cljc\"","aggregated_output":"\n    (and (outcomes? env)\n         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n         (<= 4 (count operands)))\n    (let [bindings (into ['dsg__invocation_candidate]\n                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n                         (range (dec (count operands))))\n          compile-operand #(compile-form % false env macro-env)]\n      (cond-> (u/mark-tails\n                (apply u/app\n                       (u/lam bindings\n                              (u/if-node\n                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n                                (apply u/app (u/v operator) (map u/v bindings))\n                                (u/app (u/v 'yang.call/transfer)\n                                       (u/v (nth bindings 3))\n                                       (u/app (u/v 'yang.call/condition)\n                                              (u/lit :yang.call/not-callable)\n                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n                                                     (u/lit :yang.call/callee)\n                                                     (u/v (first bindings)))))))\n                       (map compile-operand operands)))\n        tail? (assoc :tail? true)))\n\n    ;; a statically intra-unit defn/defn- under the outcome model: apply the\n    ;; unit's public entry with the compiler's token packet (a two-element\n    ;; vector: [token args]) - the private lane on the same unary entry,\n    ;; one conj and one lookup, no record construction\n    (intra-unit-fn? env operator)\n    (cond-> {:type :application\n             :operator {:type :variable, :name 'dsg__intra_call}\n             :operands [(cond-> {:type :variable, :name operator}\n                          (seq (meta operator)) (with-meta (meta operator)))\n                        (compile-form (vec operands) false env macro-env)]}\n      tail? (assoc :tail? true))\n\n    ;; A native lookup projects a carrier only for observation. The original\n    ;; reference remains available for saving or rethrowing.\n    (native-name? env operator)\n    (cond-> {:type :application\n             :operator (cond-> {:type :variable, :name operator}\n                         (seq (meta operator)) (with-meta (meta operator)))\n             :operands (mapv (fn [i operand]\n                               (let [ast (compile-form operand false env macro-env)]\n                                 (if (and (outcomes? env) (= operator 'get) (zero? i))\n                                   (u/app (u/v 'dsg__condition_view) ast)\n                                   ast))) (range) operands)}\n      tail? (assoc :tail? true))\n\n    ;; a compiler-internal helper introduced by the pre-pass (the exception\n    ;; accessors): a direct application, never a guest invocation\n    (and (symbol? operator) (reserved-name? operator))\n    (cond-> {:type :application\n             :operator (cond-> {:type :variable, :name operator}\n                         (seq (meta operator)) (with-meta (meta operator)))\n             :operands (mapv #(compile-form % false env macro-env) operands)}\n      tail? (assoc :tail? true))\n  (compile-form form true {}))\n\n\n;; =============================================================================\n;; The linked runtime entry (the conformance matrix round, yang.antlr.md\n;; section 8.10)\n;; =============================================================================\n;;\n;; A linked clojure program is published as an ordinary linker module whose\n;; one export, `body`, is its unmodified lowered unit, and run under its own\n;; entry, `clj/run-main` (the `clj` runtime module, yang.clojure.prelude).\n;; `read-forms` is the frontend's parser — the reader itself — and\n;; `lower-unit` lowers what it reads to the entry's argument: one thunk\n;; whose call runs the program compiled under the argument-vector\n;; convention and the outcome model over the guest library, with every\n;; top-level definition published to the runtime global namespace\n;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n;; its module's globals. No call node is rewritten and no foreign\n;; `:code` is extracted: the unit is the program's own lowering,\n;; wrapped.\n\n(def unit-opts\n  \"The `compile-program` opts a linked unit compiles with: the\n   argument-vector convention with the outcome model over the guest\n   library's adapters. The required clj module supplies the continuation\n   family; VM primitives are callable directly by bare name.\"\n  {:convention :arg-vector,\n   :outcomes true,\n   :linked-runtime true,\n   :adapters library-adapters,\n   :native vm/primitive-profiles})\n\n\n(def top-defining-operators\n  \"The operators whose second element names a top-level definition.\"\n  '#{def defn defn- defmacro})\n\n\n(defn read-forms\n  \"Every form `source` text reads. The reader is the parser: a malformed\n   source throws, as any frontend's refused parse does.\n\n   Source-string compilation is a JVM/Node capability (tools.reader is\n   an mvn dependency, absent from the jolt host's source-root classpath\n   — the jolt lane loads compiled output and ships source strings to\n   remote evaluators, so this is unreachable there; the honest error\n   says so if ever reached).\"\n  [source]\n  #?(:cljd (throw (ex-info \"Source-string compilation requires the JVM/Node reader; ClojureDart compiles from forms\"\n                           {:yang.clojure/reader :unavailable-on-cljd}))\n     :jolt (throw (ex-info \"Source-string compilation requires the JVM/Node reader; the jolt host compiles from forms or delegates source reading to its remote evaluators\"\n                           {:yang.clojure/reader :unavailable-on-jolt}))\n     :default\n     (let [rd (rt/string-push-back-reader source)]\n       (loop [forms []]\n         (let [form (treader/read rd false ::eof)]\n           (if (= form ::eof)\n             forms\n             (recur (conj forms form))))))))\n\n\n(defn top-level-names\n  \"The names `forms` define at the top level, in order: the second element\n   of each def/defn/defn-/defmacro head.\"\n  [forms]\n  (into []\n        (comp (filter #(and (seq? %) (contains? top-defining-operators (first %))))\n              (map (comp strip-symbol-meta second)))\n        forms))\n\n\n(declare publish-to-globals)\n\n\n(defn- globals-child\n  [x names bound]\n  (cond\n    (and (map? x) (contains? x :type)) (publish-to-globals x names bound)\n    (vector? x) (mapv #(globals-child % names bound) x)\n    :else x))\n\n\n(defn- publish-to-globals\n  \"Rewrite the compiled `node` for the linked unit: a top-level\n1280:(defn- admit-call-descriptor\n1302:  (admit-call-descriptor\n1379:(defn- intra-unit-fn?\n1571:    ;; a statically intra-unit defn/defn- under the outcome model: apply the\n1575:    (intra-unit-fn? env operator)\n1577:             :operator {:type :variable, :name 'dsg__intra_call}\n2138:   intra-unit dispatch so dynamic admission still governs.\"\n2341:                               (u/lam '[dsg__admitted? dsg__intra_call] %)\n2426:                               ;; The intra-unit dispatcher: resolve the unit's public entry,\n(ns yang.clojure.donor-link-test\n  (:require [clojure.test :refer [deftest is]]\n            [yang.clojure :as clj]\n            [yang.clojure.prelude :as prelude]\n            [yang.core.module :as module]\n            [yang.core.prelude :as core]\n            [yang.core.uast :as u]\n            [yang.typescript.antlr.linked-harness :as h]\n            [yin.vm :as vm]\n            [yin.vm.linker.interpreter :as link]))\n\n\n(deftest linked-donor-uses-runtime-context\n  (let [{:keys [store call-address]} @h/published\n        registry (prelude/admit (h/registry))\n        runtime (h/publish-guest-module! (prelude/module-spec registry call-address))\n        unit (clj/lower-unit '[(try (throw 42) (catch Exception e e))])\n        ast (u/annotate-call-sites\n              (module/module-tree [(module/require-node 'clj) (u/def! 'body unit)]))\n        spec (module/module-spec :test/refusal :test/undeclared registry\n                                 {:name 'test.clj-donor :ast ast :exports '#{body}\n                                  :runtime-name 'clj :runtime-address (:address runtime)\n                                  :deps {'yang.call call-address}})\n        donor (h/publish-guest-module! spec)\n        caller-ast (u/annotate-call-sites\n                     (module/module-tree\n                       [(module/require-node 'clj)\n                        (module/require-node 'test.clj-donor)\n                        (u/def! 'run (u/sexp->uast\n                                       '(fn [] (clj/run-main test.clj-donor/body))))]))\n        caller (h/publish-guest-module!\n                 (module/module-spec :test/refusal :test/undeclared registry\n                                     {:name 'test.caller :ast caller-ast :exports '#{run}\n                                      :runtime-name 'clj :runtime-address (:address runtime)\n                                      :deps {'test.clj-donor (:address donor)}}))\n        source (link/composition\n                 {:content-store store :derivation :trusted\n                  :name-env {'clj (:address runtime) 'yang.call call-address\n                             'test.clj-donor (:address donor) 'test.caller (:address caller)}})\n        program (u/sexp->uast '(do (require 'test.caller) (test.caller/run)))]\n    (is (contains? prelude/module-exports 'rt-ctx))\n    (is (some? (:address donor)) (pr-str donor))\n    (is (some? (:address caller)) (pr-str caller))\n    (is (not (contains? (core/free-names unit) 'clj.rt/ctx)))\n    (is (contains? (core/free-names unit) 'clj/try))\n    (doseq [backend [:semantic :stack :register]]\n      (is (= 42 (vm/value (h/run-linked backend program {:modules registry :link-source source})))\n          (str backend)))))\n(defn- publish-guest!\n  \"Publish guest module `spec` into the harness store, throwing immediately\n   with `result` in ex-data if publication is refused.\"\n  [spec]\n  (let [result (h/publish-guest-module! spec)]\n    (when (= :refused (:status result))\n      (throw (ex-info (str \"Guest module publication refused: \" (or (:reason result) (:status result)))\n                      result)))\n    result))\n\n\n(def ^:private published-php\n  \"`php` published once into `js`'s content store, pinning the same\n   `yang.call` revision (as `source-call-test` publishes it).\"\n  (delay (publish-guest!\n           (php-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(def ^:private published-py\n  \"`py` published beside `js` and `php`, over the same host registry and\n   `yang.call` revision.\"\n  (delay (publish-guest!\n           (py-prelude/module-spec (h/registry)\n                                   (:call-address @h/published)))))\n\n\n(def ^:private published-clj\n  \"`clj` published beside `js`, `php` and `py`, over the same host registry\n   and `yang.call` revision.\"\n  (delay (publish-guest!\n           (clj-prelude/module-spec (h/registry)\n                                    (:call-address @h/published)))))\n\n\n(defn- parse-ok\n  \"The CST packet of `source` under `parse`, refused unless the parse is ok.\"\n  [parse source]\n  (let [pk (parse source)]\n    (when-not (= :yang.cst/ok (:yang.cst/outcome pk))\n      (throw (ex-info \"donor or caller source does not parse\"\n                      {:source source, :packet (dissoc pk :yang.cst/nodes)})))\n    pk))\n\n\n(defn- python-export-symbol\n  [export]\n  (symbol (str \"xlang.python.export.\" export)))\n\n\n(defn- python-unit\n  [packet exports]\n  (u/lam [py-lower/globals-sym py-lower/globals-fn-sym]\n         (u/seq-nodes\n           (concat (map (fn [export]\n                          (u/sexp->uast\nsrc/cljc/yin/vm/module.cljc:164:(defn get-effect-handler\nsrc/cljc/yin/vm/module.cljc:397:(defn get-cell\n(ns yang.core.prelude-admission\n  \"Constructs declarations/specifications and checks registries; does not publish, link, or execute.\"\n  (:require [clojure.set :as set]\n            [clojure.string :as string]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]))\n\n\n(defn- refusal\n  [refusal-ns kind data]\n  (merge {(keyword refusal-ns \"refusal\") (keyword refusal-ns kind)} data))\n\n\n(defn host-declaration\n  \"`[n declaration]` for free name `n`: a primitive by its `vm/primitives`\n   profile, a host export `ns/name` by the profile address the registry's\n   host module `ns` publishes and its `:callable-effects` effect set; nil\n   when neither supplies it.\"\n  [registry n]\n  (if-let [profile (vm/profile-of vm/primitives n)]\n    [n profile]\n    (when-let [address (module/host-export-profile registry n)]\n      (let [entry (module/module-entry (:modules registry) (symbol (namespace n)))\n            f (get-in entry [:slice (symbol (name n))])]\n        [n {:yin.k/profile address,\n            :yin.k/effects (get (:callable-effects registry) f #{})}]))))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for module `module-name`.\n   `skip?` (n -> bool) marks free names a requirement already declares;\n   `requires` is the requirement map. A free name nothing supplies is\n   refused with `message` under `refusal-ns` before anything is published.\n   This namespace emits; it never publishes.\"\n  [{:keys [module-name ast exports requires free-names skip? registry message\n           refusal-ns]}]\n  {:name module-name,\n   :ast ast,\n   :exports exports,\n   :requires requires,\n   :primitives\n   (into {}\n         (keep (fn [n]\n                 (when-not (and skip? (skip? n))\n                   (or (host-declaration registry n)\n                       (throw (ex-info message\n                                       (refusal refusal-ns \"undeclared-free\"\n                                                {:name n})))))))\n         free-names)})\n\n\n(defn admit\n  \"Return `registry` when it supplies every one of `host-names`, else refuse\n   it before any program runs, naming each missing export in\n   `:<refusal-ns>/missing`.\"\n  [registry host-names message refusal-ns]\n  (let [missing (vec (sort-by str\n                              (remove #(some? (module/resolve-module\n                                                registry\n                                                (symbol (str (namespace %)\n                                                             \".\"\n                                                             (name %)))))\n                                      host-names)))]\n    (when (seq missing)\n      (throw (ex-info message\n                      (refusal refusal-ns \"host-names\"\n                               {(keyword refusal-ns \"missing\") missing}))))\n    registry))\n\n\n\n\n(defn- reject-profile [kind data]\n  (throw (ex-info \"Prelude profile refused\" (assoc data :yang.prelude/refusal kind))))\n\n\n(defn- portable-data? [x]\n  (cond\n    (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n        (number? x) (char? x)) true\n    (record? x) false\n    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\n    (or (vector? x) (set? x)) (every? portable-data? x)\n    :else false))\n\n","exit_code":0,"status":"completed"}}
