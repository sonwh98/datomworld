{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1140,1184p;2558,2610p' src/cljc/yang/clojure.cljc; sed -n '1175,1255p' test/yang/clojure_test.clj; sed -n '2165,2228p' src/cljc/yang/clojure.cljc; rg -n 'check-program-symbols|defn- check-binder\"'!|defn- check-source'\"' src/cljc/yang/clojure.cljc\"","aggregated_output":"                 :yin.k/argc (list 'data/count av-sym)}\n          fn-name (assoc :yin.k/fn (list 'quote fn-name))\n          (nil? fn-name) (assoc :yin.k/kind :anonymous)\n          (and (nil? fn-name) source) (assoc :yin.k/source source))))\n\n\n(defn outcome-adapter\n  \"Wrap host function `f`, a primitive declaring domain failures, as an\n   outcome-returning one: success is [:yin.k/ok value], and the module's own\n   refusal (ex-info with message `refusal-message` and :yin.vm.data/op and\n   :yin.vm.data/reason in its data) is [:yin.k/error data] with those keys.\n   Any other host exception propagates: an unexpected VM or compiler failure\n   is never a successful rejection.\"\n  [refusal-message f]\n  (fn [& args]\n    (try\n      [ok-tag (apply f args)]\n      (catch #?(:clj Throwable, :cljs :default, :cljd Object) e\n        (let [data (ex-data e)]\n          (if (and (= refusal-message (ex-message e))\n                   (contains? data :yin.vm.data/op)\n                   (contains? data :yin.vm.data/reason))\n            [error-tag data]\n            (throw e)))))))\n\n\n(defn- av-let\n  \"(let [p0 (data/nth av 0) ...] body): positional parameters of one arity.\n   A body that recurs is a loop over the same bindings: one recur target per\n   arity. Under the outcome model the body is lowered first.\"\n  [env macro-env params body-forms]\n  (let [bindings (into [] (mapcat (fn [i p] [p (list 'data/nth av-sym i)]) (range) params))\n        lowered? (outcomes? env)\n        body (if lowered?\n               (lower-function-body env macro-env params body-forms)\n               (body-expression body-forms))]\n    (if (some mentions-recur? body-forms)\n      (with-meta (if lowered?\n                   (list 'loop bindings body)\n                   (list* 'loop bindings body-forms))\n        {::fn-loop true})\n      (list 'let bindings body))))\n\n\n(defn- av-dispatch\n;; Variadic Clojure functions are fixed-arity here (the convention has no\n;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\n;; merge 0 to 4, union 0 to 6, difference 2, comp 0 to 3, partial binds 1 to 3.\n;; A larger count is the\n;; function's own arity error.\n\n(def library-adapters\n  \"The retired `:adapters` map a program using `library` once compiled with:\n   the data exports whose refusal the collection predicates read as data.\n   The continuation port rewrote those predicates onto the `data/*` and\n   `kind/*` host predicates, so no `portable/*` adapter is consulted; the\n   map stays for the `library-opts`/`unit-opts` fixtures and the prelude's\n   `admit` registration.\"\n  {'data/count 'portable/count\n   'data/peek 'portable/peek\n   'data/dissoc 'portable/dissoc\n   'data/disj 'portable/disj\n   'data/str-length 'portable/str-length})\n\n\n(def kind-module\n  \"The `kind` host module's exports, symbol to host function: the irreducible\n   kind and name primitives (see the library notes). Every export is pure.\"\n  (merge\n    {'symbol? symbol?\n     'keyword? keyword?\n     'name name\n     'namespace namespace\n     'symbol symbol\n     'keyword keyword\n     'str str\n     'int? int?\n     'with-meta with-meta\n     'meta meta\n     'coll? coll?\n     'set? set?}\n    #?(:clj {'var? var?} :default {})))\n\n\n(def kind-arities\n  \"The published arities of each `kind` export.\"\n  {'symbol? [1], 'keyword? [1], 'name [1], 'namespace [1], 'symbol [1 2], 'keyword [1 2]\n   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'var? [1], 'with-meta [2], 'meta [1]\n   'coll? [1], 'set? [1]})\n\n\n(def library\n  \"The library's definitions, in order, as quoted source.\"\n  '[(defn identity\n      [x]\n      x)\n    (defn inc\n      [x]\n                          (throw (ex-info \"boom\" {:x x}))) (f 1)])))\n  (testing \"an untaken throw branch leaves the success outcome\"\n    (is (= [:yin.k/ok :survived]\n           (run-outcome '[(defn f\n                            [x]\n                            (if x (throw (ex-info \"t\" {})) :survived))\n                          (f false)])))))\n\n\n(deftest test-common-call-descriptor-publication\n  (is (= [:yin.k/ok [:function true 2 3]]\n         (run-outcome '[(defn f\n                          [x]\n                          (+ x 1))\n                        [(get f :clj/type)\n                         (data/callable? (yang.call/entry f))\n                         (f 1)\n                         (let [plain +] (plain 1 2))]])))\n  (testing \"condition-shaped return data is still a successful value\"\n    (let [value {:yang.call/reason :yang.call/thrown\n                 :yang.call/value :ordinary-data}]\n      (is (= [:yin.k/ok value]\n             (run-outcome [(list 'defn 'f [] value) '(f)]))))))\n\n\n(deftest test-common-call-hand-constructed-descriptor\n  (testing \"explicit UAST/profile construction admits a foreign body\"\n    ;; The constructor runs inside the compiled profile's private bindings.\n    ;; No Clojure source map receives admission from its entry spelling.\n    (let [descriptor (#'yang/admit-call-descriptor\n                      (u/sexp->uast\n                        '(assoc {} :foreign/type :function\n                                :yang.call/entry\n                                (fn [record] (get record :yang.call/positional))))\n                      false)]\n      (doseq [[form expected] [['(profile-function 40 2) [:yin.k/ok [40 2]]]\n                               ['[(profile-function 40 2)] [:yin.k/ok [[40 2]]]]]\n              run [walker-run semantic-run]]\n        (let [ast (walk/postwalk\n                    (fn [node]\n             