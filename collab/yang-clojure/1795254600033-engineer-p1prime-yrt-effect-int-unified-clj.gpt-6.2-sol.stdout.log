{"type":"item.completed","item":{"id":"item_108","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1345,1436p;2068,2109p' test/yang/clojure_test.clj; sed -n '97,175p' src/cljc/yang/clojure/prelude.cljc\"","aggregated_output":"  (is (= [:yin.k/ok [false false true 21]]\n         (run-outcome '[(defn f\n                          [x]\n                          x)\n                        [(yang.call/eligible? {:yang.call/entry (yang.call/entry f)})\n                         (yang.call/eligible? (assoc f :extra :forged))\n                         (yang.call/eligible? f)\n                         (f 21)]]))))\n\n\n(deftest test-common-call-token-packet-forgery-refuses\n  (testing \"a forged vector applied to the extracted public entry never\n            enters the private body: the entry authenticates the packet on\n            the compiler-held token and forged shapes refuse. The extraction\n            and application happen INSIDE a compiled program (the packet\n            dispatch lives in its preamble scope), the call spliced in as\n            UAST over a marker call, on both evaluators.\"\n    ;; forged VECTORS are the packet-dispatch axis (the P1 axis): each must\n    ;; produce an error outcome without the body running. Scalar and empty\n    ;; invocations hit the public entry's pre-existing non-record refusal\n    ;; (a host throw, same before D2) and are covered by the entry's own\n    ;; behavior, not this regression.\n    (doseq [forged '[[] [42] [nil [42]] [a b c d]]]\n      (let [;; the packet dispatch reached at runtime: extract the public\n            ;; entry of the target (a source defn), then apply the forged\n            ;; vector to it directly - bypassing source lowering entirely\n            call-ast (u/let1 'raw\n                             (u/app (u/v 'yang.call/entry) (u/v 'target))\n                             (u/app (u/v 'raw) (u/lit forged)))\n            ast (walk/postwalk\n                  (fn [node]\n                    (if (= node (u/v 'marker-call)) call-ast node))\n                  (yang/compile-program\n                    ['(defn target\n                        [x]\n                        :private-body-entered)\n                     '(marker-call)]\n                    true\n                    {:convention :arg-vector\n                     :outcomes true\n                     :native (set (keys vm/primitive-profiles))}))]\n        (doseq [run [walker-run semantic-run]]\n          (let [result (try\n                         (first (run ast))\n                         (catch clojure.lang.ExceptionInfo e\n                           (pr-str {:caught (ex-message e) :data (ex-data e)})))]\n            (is (and (vector? result) (= :yin.k/error (first result)))\n                (str \"forged \" (pr-str forged) \" must produce an error outcome, got \"\n                     (pr-str result)))\n            ;; The sentinel must appear NOWHERE in the outcome. The codex\n            ;; mutation gate (2026-11-04) showed the previous top-level\n            ;; (not= sentinel (second result)) check passing vacuously: with\n            ;; the token check disabled the body runs and its return value\n            ;; nests inside a not-callable error payload, so the outer error\n            ;; tag satisfies assertion 1 and (second result) is the error\n            ;; map, not the sentinel. A whole-outcome traversal fails under\n            ;; that mutation and passes only when the body never ran.\n            (is (not (some #{:private-body-entered}\n                           (tree-seq coll? seq result)))\n                (str \"forged \" (pr-str forged) \" reached the body; the sentinel nests in the outcome: \"\n                     (pr-str result)))))))))\n\n\n(deftest test-common-call-invalid-continuation-refuses\n  ;; The §8.10.7 public-bridge captured a `u/capture` continuation for the\n  ;; raise exit; the continuation port replaces it with `clj/raise` over the\n  ;; handler stack, so there is no bridge continuation to tamper and no\n  ;; `missing-raise-exit` surface. A dynamic call and a static intra-unit\n  ;; call both complete normally.\n  (doseq [run [walker-run semantic-run]]\n    (is (= [:yin.k/ok 2]\n           (first (run (outcome-ast '[(defn f\n                                        []\n                                        1)\n                                      (let [g f] (+ 1 (g)))])))))\n    (is (= [:yin.k/ok 2]\n           (first (run (outcome-ast '[(defn f\n                                        []\n                                        1)\n                                      (+ 1 (f))]))))\n        \"statically intra-unit calls do not capture a bridge continuation\")))\n\n\n(deftest test-common-call-rejects-named-arguments\n  (let [forms '[(defn f\n                  [x]\n                  x)\n                (let [condition (yang.call/invoke f [] [[\"x\" 1]] profile-raise)]\n                  condition)]\n        raw-raise (fn [node]\n                    (if (= node (u/v 'profile-raise)) (u/v 'probe/note) node))\n        ast (walk/postwalk raw-raise (outcome-ast forms))\n    (is (some #(= :yin.k/ok %) (ast-nodes (yang/compile-program forms true outcome-opts))))))\n\n\n(deftest test-outcome-common-call-depth\n  (let [prog (fn [defs n] (yang/compile-program (conj defs (list 'cnt n)) true outcome-opts))\n        three '[(defn c\n                  [n]\n                  (if (= n 0) :done (a (- n 1))))\n                (defn b\n                  [n]\n                  (c n))\n                (defn a\n                  [n]\n                  (b n))\n                (defn cnt\n                  [n]\n                  (a n))]\n        direct '[(defn cnt\n                   [n]\n                   (if (= n 0) :done (cnt (- n 1))))]\n        wrapped '[(defn cnt\n                    [n]\n                    (if (= n 0) 0 (+ 1 (cnt (- n 1)))))]]\n    (doseq [[label defs] [[\"self tail call\" direct] [\"three tail calls\" three]]\n            [lane run-lane] [[:walker walker-run] [:semantic semantic-run]]]\n      (let [[v0 d0] (run-lane (prog defs 0))\n            [v100 d100] (run-lane (prog defs 100))\n            [v1000 d1000] (run-lane (prog defs 1000))\n            tag (str lane \" \" label)]\n        (is (= [:yin.k/ok :done] v0 v100 v1000) tag)\n        (is (= d100 d1000)\n            (str tag \": depth is constant in the iteration count\"))\n        (is (<= d1000 (+ d0 2))\n            (str tag \": at most two frames above the initial call\"))))\n    (testing \"a non-tail unwrap also grows with the iteration count\"\n      (let [[_ d10] (semantic-run (prog wrapped 10))\n            [_ d100] (semantic-run (prog wrapped 100))]\n        (is (> d100 (+ d10 50)))))))\n\n\n(deftest test-outcome-refusals\n  (let [opts (assoc outcome-opts :macros #{'unless})\n                                     :yang.call/owner owner))))\n                     (:clj/missing-raise-exit invocation)))\n                 (:clj/invalid-invocation invocation)))]\n         (do (cell/set! owner (assoc meta :yang.call/entry entry))\n             owner)))]\n    [clj/invoke-callable\n     (fn [callee positional named]\n       (if (clj/admitted-callable? callee)\n         (yang.call/invoke callee positional named\n           (fn [condition]\n             (clj/raise\n               (if (= (get condition :yang.call/reason) :yang.call/thrown)\n                 (get condition :yang.call/value)\n                 (cell/dsg__new-provenance condition condition)))))\n         (let [condition (yang.call/condition :yang.call/not-callable\n                           (assoc {} :yang.call/callee callee))]\n           (clj/raise (cell/dsg__new-provenance condition condition)))))]\n    ;; A caught carrier stays intact for storing or rethrowing. Source\n    ;; readers observe its value, and the program boundary reports the\n    ;; retained condition even if the carrier's public value changed.\n    [clj/condition-view\n     (fn [x]\n       (if (= (cell/dsg__provenance x) nil) x (cell/get x)))]\n    [clj/run-unit\n     (fn [body]\n       (clj/try (fn [] (conj [] :yin.k/ok (body)))\n                (fn [e]\n                  (let [retained (cell/dsg__provenance e)]\n                    (conj [] :yin.k/error (if (= retained nil) e retained))))))]\n    [clj/unwrap-outcome\n     (fn [value]\n       (if (if (data/vector? value) (= (data/count value) 2) false)\n         (if (= (data/nth value 0) :yin.k/ok)\n           (data/nth value 1)\n           value)\n         value))]\n    [clj/run-main\n     (fn [body]\n       (do (clj/init!)\n           (clj/unwrap-outcome (body))))]])\n\n\n(def bundled-primitive-forms\n  \"Guest closures can capture each other without capturing a host function.\"\n  '[(fn [coll k default]\n      (if (data/vector? coll)\n        (if (data/contains? coll k) (data/nth coll k) default)\n        (dsg__primitive/get coll k default)))\n    (fn [a b] (data/content= a b))\n    (fn [coll k v k2 v2 k3 v3 k4 v4]\n      (if (data/content= k2 nil)\n        (dsg__primitive/assoc coll k v)\n        (if (data/content= k3 nil)\n          (dsg__primitive/assoc coll k v k2 v2)\n          (if (data/content= k4 nil)\n            (dsg__primitive/assoc coll k v k2 v2 k3 v3)\n            (dsg__primitive/assoc coll k v k2 v2 k3 v3 k4 v4)))))\n    (fn [a b] (dsg__primitive/+ a b))\n    (fn [a b] (dsg__primitive/<= a b))])\n\n\n(def module-exports (core/exports \"clj\" definitions))\n\n\n(def uast\n  \"Install clj from a closed, content-addressed bundle.\"\n  (let [placeholders (mapv (fn [key] [key :clj/uninit]) runtime-keys)\n        install (apply u/app\n                       (u/lam '[get = assoc + <=]\n                              (core/definitions->uast (into placeholders definitions)))\n                       (map u/sexp->uast bundled-primitive-forms))]\n    (u/mark-tails\n      (u/app (u/lam [] (u/then (u/lit :clj/bundled-runtime) install))))))\n\n\n(def bundled-uast\n  \"Install the shared definitions before initializing bundled clj.\"\n  (let [shared (u/app (u/lam '[get = assoc + <=] (u/seq-nodes [call/uast effect/uast]))\n                      (u/v 'dsg__get) (u/v 'dsg__equal) (u/v 'dsg__assoc)\n","exit_code":0,"status":"completed"}}
