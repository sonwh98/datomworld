rogram-symbols!\n2232:          (check-program-symbols! head))\n2233:        (run! check-program-symbols! (rest form))))\n2234:    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n2235:    (coll? form) (run! check-program-symbols! form)))\n2275:   (run! check-program-symbols! forms)\n2994:  (check-program-symbols! form)\n","exit_code":0,"status":"completed"}}
