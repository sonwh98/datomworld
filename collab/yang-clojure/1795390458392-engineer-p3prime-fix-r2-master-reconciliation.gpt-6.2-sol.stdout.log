{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\npath = Path(\\\"src/cljc/yin/repl.cljc\\\")\nsource = path.read_text()\nconflict = re.compile(r\\\"\"'^<<<<<<< HEAD'\"\\\\n(.*?)\"'^======='\"\\\\n(.*?)\"'^>>>>>>> origin/master'\"\\\\n\\\", re.M | re.S)\nmatches = list(conflict.finditer(source))\nassert len(matches) == 2\nassert \\\"state {:lang lang\\\" in matches[0][2]\nassert \\\"(update :vm admit-frontend frontends lang)\\\" in matches[0][1]\nassert \\\"(store/retain-on-reset? (:index-store state))\\\" in matches[1][2]\nassert \\\"(update :vm admit-frontend (:frontends state) (:lang state)))\\\" in matches[1][1]\nreplacements = [matches[0][2], matches[1][1].splitlines(keepends=True)[0] + matches[1][2]]\nfor match, replacement in reversed(list(zip(matches, replacements))):\n    source = source[:match.start()] + replacement + source[match.end():]\npoint = \\\"    (-> session\\\\n        (update :indexer index/rehydrate recovery)\\\"\nassert source.count(point) == 1\nsource = source.replace(point, \\\"    (-> session\\\\n        (update :vm admit-frontend frontends lang)\\\\n        (update :indexer index/rehydrate recovery)\\\")\npath.write_text(source)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
