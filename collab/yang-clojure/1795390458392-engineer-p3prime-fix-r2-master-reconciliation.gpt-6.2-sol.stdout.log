{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1120,1158p' test/yin/repl/dht_test.cljc && sed -n '315,365p' test/yin/repl/serve_test.cljc && sed -n '750,785p' src/cljc/yin/repl/main.cljc && sed -n '890,965p' src/cljc/yin/repl/main.cljc && sed -n '440,472p' src/cljc/yang/clojure/prelude.cljc\"","aggregated_output":"  (or (get-in state [:session :node])\n      (:dht state)\n      (get-in state [:session :node])))\n\n\n(defn- prompt-step!\n  [driver now line]\n  (when line (driver/submit-line! (:input @driver) line))\n  (let [[state _ lines] (main/step-all @driver nil now)]\n    (vreset! driver state)\n    lines))\n\n\n(defn- use-store-line\n  [target & opts]\n  (pr-str (list* 'use-store target opts)))\n\n\n(deftest a-solo-store-swaps-in-and-releases-its-lock-on-departure\n  (let [dir (temp-dir)\n        target (str \"dht:\" dir)\n        shell (volatile! (main/boot {} shell.main/composition))]\n    (try\n      (let [lines (prompt-step! shell 0 (use-store-line target))]\n        (is (line-with lines (str \"Switched index store to \" target \" (empty code index)\")))\n        (is (line-with lines \"solo, no --dht-peer\"))\n        (is (some? (node-of @shell)))\n        (is (nil? (:seam (node-of @shell)))))\n      (is (line-with (prompt-step! shell 10 \"(require (quote dao.space.dht))\")\n                     \"'dao.space.dht\"))\n      (prompt-step! shell 20 \"(reset)\")\n      (is (line-with (prompt-step! shell 30 (use-store-line :mem))\n                     \"Switched index store to mem (code index cleared)\"))\n      (is (nil? (:session @shell)))\n      (is (empty? (get-in @shell [:repl :host-modules])))\n      (is (empty? (get-in @shell [:repl :registered-ops])))\n      (is (some? (:close-fn (let [opened (store/open {:type :file :dir dir})]\n                             (store/close! opened)\n                             opened))))\n      (is (= [(rpc/success-answer 7 \"3\")] answers)))))\n\n\n(deftest store-switching-stays-on-the-local-driver\n  (let [{:keys [endpoint host]} (endpoint!)\n        endpoint (tick host endpoint 1)\n        command \"(use-store \\\"mem\\\")\"\n        server-store (get-in endpoint [:repl :index-store])\n        client (main/boot {:adapter (:adapter host)})\n        client-store (get-in client [:repl :index-store])\n        _ (driver/submit-line! (:input client)\n                               (pr-str (list 'connect (serve/url endpoint))))\n        client (driver/repl-step client 2)\n        endpoint (tick host endpoint 2)\n        [_ client] (driver/take-outbox (driver/repl-step client 3))\n        _ (driver/submit-line! (:input client) command)\n        [entries client] (driver/take-outbox (driver/repl-step client 4))\n        answers-cursor (:dao.stream/cursor (stream/cursor (:answers endpoint)\n                                                          stream/anchor-oldest))\n        endpoint (tick host endpoint 4)]\n    (testing \"a connected client's typed command executes locally\"\n      (is (some? (:adapter client)))\n      (is (some #(= \"Switched index store to mem (code index cleared)\"\n                    (driver/text-key %)) entries))\n      (is (not (identical? client-store (get-in client [:repl :index-store]))))\n      (is (empty? (:queued client)))\n      (is (nil? (:outstanding client)))\n      (is (empty? (first (answers-since endpoint answers-cursor)))))\n    (testing \"a raw eval request cannot switch the server's store\"\n      (eval! endpoint 7 command)\n      (let [endpoint (tick host endpoint 5)\n            [answers _] (answers-since endpoint answers-cursor)]\n        (is (= [(rpc/success-answer\n                  7 \"Error: (use-store ...) is a local host command and cannot be run over a remote endpoint\")]\n               answers))\n        (is (identical? server-store (get-in endpoint [:repl :index-store])))))))\n\n\n(deftest failed-driver-installation-releases-the-replacement-only\n  (let [events (volatile! [])\n        composition {:composition-spec? #(= :mem %)\n                     :open (fn [spec _]\n                             (vswap! events conj :opened)\n                             {:index-store (assoc (store/open spec) :close-fn\n                                                  #(vswap! events conj :replacement-store))\n                              :session {:identity :replacement-session}\n                              :recovery {:manifest :invalid :datoms true}})\n                     :close! #(vswap! events conj (:identity %))}\n        state (-> (main/boot {:adapter (:adapter (fixture/host))} composition)\n                  (assoc :session {:identity :original-session})\n                  (assoc-in [:repl :index-store :close-fn]\n  (println refusal)\n  #?(:cljd (io/exit 1)\n     :jolt (do (flush) (System/exit 1))\n     :clj (.halt (Runtime/getRuntime) 1)\n     :cljs (.exit js/process 1)))\n\n\n(defn- custody-of\n  [state]\n  (get-in state [:repl :custody]))\n\n\n(defn close-index-store!\n  \"Release the composition's lifecycle resources before the host exits:\n   the custody composition's journals first (compose/close! -- the\n   authority and every journal backend the composition opened; it never\n   throws, so a failed close never blocks the exit), then whatever a\n   storage composition still owes, then the index store's own resources\n   (in durable mode, the exclusive directory lock).  The shell has already\n   stopped when a host calls this; the memory store has nothing to\n   release.  A composition's endpoints have been asked to stop and drained\n   by then (`stop-tick`), and its own `:close!` is the last resort for\n   whatever the budget left — one resource owner, one close each.\"\n  [state]\n  (when-some [c (custody-of state)]\n    (compose/close! c))\n  (composition-close! state)\n  ((or (:close-store! (:composition state)) store/close!)\n   (get-in state [:repl :index-store])))\n\n\n(defn- entry-text\n  [entry]\n  (or (get entry driver/text-key) (get entry serve/text-key)))\n\n\n   before the shell's, a hydration still outstanding leaves every typed\n   line waiting in the input medium. A startup refusal stops the shell,\n   while a refusal after a swap restores a fresh memory store.\n   The custody control plane is stepped next, before the refusal and\n   admission branches, so renewals, pending releases and request retries\n   continue during hydration and past a refusal.  A `--port` process\n   serves one shared shell, as v1's atom made it: the driver evaluates this\n   tick's local\n   lines first, so a definition typed at the local prompt is already in the\n   shell the endpoint evaluates remote requests against in the same tick, and\n   the endpoint's shell (remote definitions included) is threaded back\n   before the next tick.  The custody program step follows the driver's own\n   step and precedes the endpoint's; once the shell has stopped it is\n   replaced by the stop latch, so no custody program call runs after\n   `:running?` turns false.  A run parked on a completion this tick's\n   transport step produced is re-checked once, before any typed line and\n   with no line of its own, by the composition's own re-check — which\n   serves the link and call media the engine parks on and translates the\n   events before they cross inward, so linker progress resumes a parked run\n   and its text prints after the composition's lines.  Returns\n   `[state server lines]`; the caller only prints.\"\n  [state server now]\n  (let [[state comp-lines events] (composition-step state now)\n        state (custody-control-step state)\n        refusal (composition-refusal state)]\n    (cond\n      (and refusal (:swapped-in-session? state))\n      (let [[recovered _] (replace-store state {:spec :mem})]\n        [(dissoc recovered :swapped-in-session?)\n         (when server (assoc server :repl (:repl recovered)))\n         (conj comp-lines (str \"Recovered with a fresh mem index store after a store switch failed: \"\n                               refusal))])\n\n      refusal\n      [(custody-stop (assoc state :running? false)) server comp-lines]\n\n      (not (composition-admitting? state))\n      [state server comp-lines]\n\n      :else\n      (let [[state rechecked] (composition-recheck state events)\n            comp-lines (cond-> comp-lines\n                         (seq rechecked) (conj rechecked))\n            stepped (driver/repl-step state now)\n            [stepped after-input] (if (and (nil? (get-in state [:repl :pending-run]))\n                                           (get-in stepped [:repl :pending-run])\n                                           (:recheck-after-input (:composition stepped))\n                                           (session-of stepped))\n                                    (let [[session text] ((:recheck-after-input (:composition stepped))\n                                                          (session-of stepped))]\n                                      [(with-session stepped session) text])\n                                    [stepped nil])\n            stepped (if (:running? stepped)\n                      (custody-program-step stepped)\n                      (custody-stop stepped))\n            [entries state'] (driver/take-outbox stepped)\n            server' (when server\n                      (serve/step (assoc-in server [:repl] (:repl state'))\n                                  now))\n            [server-entries server''] (if server'\n                                        (serve/take-outbox server')\n                                        [[] nil])\n            state'' (if server'' (assoc state' :repl (:repl server'')) state')]\n        [state'' server'' (cond-> (into comp-lines\n                                        (map entry-text)\n                                        (into (vec entries) server-entries))\n                            (seq after-input) (conj after-input))]))))\n\n\n(defn moved?\n  \"The tick owner's cadence bit, computed from this tick's own results: true\n   when there are lines to print, when the endpoint reports movement (a\n   woken probe, a published notice), or when either composition still owes a\n   write -- the shell's own, a storage composition's, or a custody\n   control-plane one.  A pending write\n   keeps cadence at the base interval; it must never wait out a backoff\n   'coll? [1], 'set? [1]})\n\n\n(defn register-library-module\n  \"Return `registry` with host module `name` installed over `entries`\n   (`[export function]` pairs) at `arities`, each export pure.\"\n  [registry name entries arities]\n  (module/register-host-module\n    registry name\n    (into {} entries)\n    (into {} (map (fn [[op _]] [op (vm/primitive-profile op :pure (get arities op [1]) #{} :none)]))\n          entries)))\n\n\n(defn admit\n  \"Return `registry` with the guest library's host surface installed: the\n   `kind` module and the `portable` adapters of the data exports the\n   collection predicates read (yang.clojure's `library-adapters`). A\n   linked clojure composition registers them beside the other runtimes'\n   registry surfaces; a composition without a clojure program reads none\n   of them.\"\n  [registry]\n  (let [registry (cond-> registry\n                   (not (module/resolve-module registry 'integer))\n                   (integer/register-integer-module {::integer/max-bits 100000\n                                                     ::integer/max-digits 4300})\n                   (not (module/resolve-module registry 'float))\n                   (float/register-float-module))\n        portable (into {}\n                       (map (fn [[source _]]\n                              (let [op (symbol (name source))]\n                                [op (outcome-adapter data/refusal-message\n                                                          (get data/data-module op))])))\n","exit_code":0,"status":"completed"}}
