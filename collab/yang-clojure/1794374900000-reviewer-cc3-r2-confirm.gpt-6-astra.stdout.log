xists, and\n  1862\t   accumulate the error of a failed expansion. Expansion failure is\n  1863\t   data, so the cursor advances past it. A successful expansion's C1\n  1864\t   side table (the batch result's `:frontend-metadata`, present only\n  1865\t   when the selected member itself claimed coverage) is retained on the\n  1866\t   consumer under the occurrence identity of the staged tree — its\n  1867\t   admission origin beside its final root address (`call-site-tables`,\n  1868\t   resolved by `call-site-table`) — so the composition that drives this\n  1869\t   expander — the REPL's session — holds every executed occurrence's\n  1870\t   coverage beside the expander that produced it, each load's table\n  1871\t   surviving the next, even when two loads land on the same root.\"\n  1872\t  [expander batch]\n  1873\t  (let [{:keys [status tree log error ctx frontend-metadata\n  1874\t                call-site-origin]}\n  1875\t        (expand-batch batch (:ctx expander))]\n  1876\t    (cond-> (assoc expander :ctx ctx)\n  1877\t      (= :ok status) (assoc :out-staged tree)\n  1878\t      (and (= :ok status) frontend-metadata)\n  1879\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n  1880\t                frontend-metadata)\n  1881\t      (:log expander) (assoc :log-staged log)\n  1882\t      (= :error status) (update :errors conj error))))\n  1883\t\n  1884\t\n  1885\t(defn- flush-slot\n  1886\t  [expander writer-key slot-key on-ok]\n  1887\t  (if-let [payload (get expander slot-key)]\n  1888\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\n  1889\t      (case outcome\n  1890\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\n  1891\t        :dao.stream/full expander\n  1892\t        (throw (ex-info \"Expander could not publish a staged value\"\n  1893\t                        {:dao.stream/outcome outcome,\n  1894\t                         :destination slot-key,\n  1895\t                         :consumer expander}))))\n  1896\t    expander))\n  1897\t\n  1898\t\n  1899\t(defn flush\n  1900\t  \"Append each staged payload to its own destination (§9): `ok` clears only\n  1901\t   that slot (and counts a forwarded program), `full` retains the exact\n  1902\t   payload for retry, anything else throws with the outcome and the\n  1903\t   consumer's remaining staged slots under `:consumer`.\"\n  1904\t  [expander]\n  1905\t  ;; A log failure after a published program carries the cleared program\n  1906\t  ;; slot, so recovery never republishes it.\n  1907\t  (-> expander\n  1908\t      (flush-slot :out :out-staged #(update % :forwarded inc))\n  1909\t      (flush-slot :log :log-staged identity)))\n  1910\t\n  1911\t\n  1912\t(defn step\n  1913\t  \"Drive one expander session `{:observer o :consumer expander}` over\n  1914\t   `program-in` until it blocks, ends, or cannot flush.\"\n  1915\t  [session]\n  1916\t  (observer/run-on-stream session ready? load flush))\n  1917\t\n  1918\t\n  1919\t(defn drain-errors\n  1920\t  \"Read and reset `:errors` and `:forwarded`. Accepts a session or the bare\n  1921\t   consumer and returns `[same-shape' {:errors errors :forwarded n}]`.\"\n  1922\t  [x]\n  1923\t  (let [session? (contains? x :consumer)\n  1924\t        c (if session? (:consumer x) x)\n  1925\t        summary {:errors (:errors c), :forwarded (:forwarded c)}\n  1926\t        c' (assoc c :errors [] :forwarded 0)]\n  1927\t    [(if session? (assoc x :consumer c') c') summary]))\n  1820\t\n  1821\t(defn- pending-eval\n  1822\t  \"Answer a round whose require did not complete: the parked VM, its\n  1823\t   round-start base, and the pending links are the shell's\n  1824\t   `:pending-run`, and the prompt returns.  Nothing is wedged: another\n  1825\t   line re-checks the link, the host may step one itself with\n  1826\t   `recheck-pending`, the link policy is consulted as the run parks, and\n  1827\t   `(reset)` or `(vm ...)` drops it with the session.  What a frontend\n  1828\t   staged for the round rides on the run, committed only if it completes.\"\n  1829\t  [state state' vm' pending]\n  1830\t  (let [[state'' text] (drain-output state')]\n  1831\t    (consult-link-policy\n  1832\t      (assoc state''\n  1833\t             :vm vm'\n  1834\t             :pending-run (cond-> {:vm vm'\n  1835\t                                   :base (:vm state)\n  1836\t                                   :links pending\n  1837\t                                   :checks 0}\n  1838\t                            (::frontend state')\n  1839\t                            (assoc :frontend (::frontend state'))))\n  1840\t      text\n  1841\t      (pending-text pending))))\n  1842\t\n  1843\t\n  1844\t(defn- wedged-program\n  1845\t  [state]\n  1846\t  (ex-info\n  1847\t    \"Program stream did not form a complete, runnable Yin VM program.\n  1848\tHint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n  1849\t    {:vm-type (:vm-type state)}))\n  1850\t\n  1851\t\n  1852\t(defn- run-evaluation\n  1853\t  \"The evaluator half of a round whose expander forwarded a program: run\n  1854\t   it, then either finalize the value, drive its require to a conclusion,\n  1855\t   or park it as `:pending-run`.  `state` is the round's starting state;\n  1856\t   `expanded` already carries the expander's progress, which a failing\n  1857\t   evaluation keeps.\"\n  1858\t  [state expanded]\n  1859\t  (try\n  1860\t    (let [gaps-before (ingress-gaps expanded)\n  1861\t          evaluated (run-evaluator-stage expanded)\n  1862\t          vm (:vm evaluated)]\n  1863\t      (cond\n  1864\t        (> (ingress-gaps evaluated) gaps-before)\n  1865\t        [(assoc evaluated :ingress-loss? true)\n  1866\t         (str \"Error: \" ingress-loss-text)]\n  1867\t\n  1868\t        (vm/halted? vm)\n  1869\t        (finalize-eval state evaluated\n  1870\t                       (engine/restore-initial-env (:env (:vm expanded)) vm))\n  1871\t\n  1872\t        (or (link-waiting? vm) (query/waiting? vm))\n  1873\t        (let [[state' vm' pending] (drive-links evaluated vm false)]\n  1874\t          (cond\n  1875\t            (vm/halted? vm')\n  1876\t            (finalize-eval state\n  1877\t                           (assoc state' :vm vm')\n  1878\t                           (tokenize state'\n  1879\t                                     (engine/restore-initial-env\n  1880\t                                       (:env (:vm expanded)) vm')))\n  1881\t\n  1882\t            (link-waiting? vm')\n  1883\t            (pending-eval state state' vm' pending)\n  1884\t\n  1885\t            :else (throw (wedged-program state))))\n  1886\t\n  1887\t        :else (throw (wedged-program state))))\n  1888\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  1889\t      ;; a link raise rolls the shell back to the round's base; the\n  1890\t      ;; identity the interrupted VM had minted rides on it, so nothing\n  1891\t      ;; is minted twice on the surviving pair\n  1892\t      (let [d (ex-data error)\n  1893\t            base (query/discard-answers\n  1894\t                   (if (or (::link-counter d) (::link-origins d))\n  1895\t                     (carry-link-identity\n  1896\t                       (:vm state)\n  1897\t                       {:id-counter (::link-counter d)\n  1898\t                        :origins (::link-origins d)})\n  1899\t                     (:vm state))\n  1900\t                   (:query-pair expanded))]\n  1901\t        (consume-failed-round (carry-served (assoc expanded :vm base) d)\n  1902\t                              error)))))\n  1903\t\n  1904\t\n  1905\t(defn- eval-program\nsrc/cljc/dao/stream/observer.cljc:217:(defn run-on-stream\nsrc/cljc/yin/repl.cljc:1275:(defn- consume-failed-round\nsrc/cljc/yin/vm/engine.cljc:265:(defn ready-for-ingress?\n     1\t(ns yin.repl.store\n     2\t  \"Startup selection of the code index's store\n     3\t   (docs/design/yin.repl.dao.space-index.md; the durable-store startup\n     4\t   contract, slices 1-3, and the DHT store of epic S5).\n     5\t\n     6\t   The store is chosen once, before the shell composes: `mem` — a fresh\n     7\t   in-memory `dao.jing` store, today's behaviour — `file:<dir>`, the\n     8\t   durable directory store (dao.space.store), or `dht:<dir>`, that store\n     9\t   with a DHT node composed over it (yin.repl.dht).  This namespace parses\n    10\t   the `--index-store` value, validates the `:index-store-spec` an\n    11\t   embedder may hand `yin.repl/create-state`, and opens the store the\n    12\t   resolved spec names.  Every bad spec — a missing value, an unknown\n    13\t   scheme, an empty directory, a directory that cannot be opened, a host\n    14\t   build without file support — is refused with its reason; nothing falls\n    15\t   back to memory silently.\n    16\t\n    17\t   The durable directory itself — the exclusive lock, HEAD, the validated\n    18\t   snapshot, `:recovery` — is dao.space.store's; this namespace is one of\n    19\t   its consumers.  The shell installs the recovery before it admits any\n    20\t   evaluation (`yin.repl.index/rehydrate`), and a durable store\n    21\t   (`durable?`) also carries the index across `(reset)` and VM\n    22\t   selection; the memory store keeps today's empty rebuild.\"\n    23\t  (:require [clojure.string :as str]\n    24\t            [dao.jing :as jing]\n    25\t            [dao.jing.mem :as jing.mem]\n    26\t            [dao.space.store :as durable]\n    27\t            [dao.stream.datagram :as datagram]))\n    28\t\n    29\t\n    30\t(def file-scheme\n    31\t  \"The `--index-store` scheme prefix naming a durable file store.\"\n    32\t  \"file:\")\n    33\t\n    34\t\n    35\t(def dht-scheme\n    36\t  \"The `--index-store` scheme prefix naming the DHT store: the durable\n    37\t   directory store of `file:<dir>` composed under a `dao.jing.dht` node\n    38\t   (yin.repl.dht).\"\n    39\t  \"dht:\")\n    40\t\n    41\t\n    42\t(def ^:private supported-args\n    43\t  [\"mem\" (str file-scheme \"<dir>\") (str dht-scheme \"<dir>\")])\n    44\t\n    45\t\n    46\t(defn parse-arg\n    47\t  \"The `--index-store` value as a spec: `:mem`, or `{:type :file :dir dir}`\n    48\t   for `file:<dir>`.  A missing value, an unknown scheme, and an empty\n    49\t   directory are refused here — with the supported forms named — so the\n    50\t   arguments parser can refuse a bad flag before anything composes.\"\n    51\t  [value]\n    52\t  (cond\n    53\t    (nil? value)\n    54\t    (throw (ex-info \"--index-store needs a value: mem, file:<dir> or dht:<dir>\"\n    55\t                    {:supported supported-args}))\n    56\t\n    57\t    (= value \"mem\")\n    58\t    :mem\n    59\t\n    60\t    (str/starts-with? value file-scheme)\n    61\t    (let [dir (subs value (count file-scheme))]\n    62\t      (if (str/blank? dir)\n    63\t        (throw (ex-info \"--index-store file:<dir> needs a directory\"\n    64\t                        {:value value\n    65\t                         :supported supported-args}))\n    66\t        {:type :file :dir dir}))\n    67\t\n    68\t    (str/starts-with? value dht-scheme)\n    69\t    (let [dir (subs value (count dht-scheme))]\n    70\t      (if (str/blank? dir)\n    71\t        (throw (ex-info \"--index-store dht:<dir> needs a directory\"\n    72\t                        {:value value\n    73\t                         :supported supported-args}))\n    74\t        {:type :dht :dir dir}))\n    75\t\n    76\t    :else\n    77\t    (throw (ex-info (str \"Unknown --index-store \" (pr-str value)\n    78\t                         \"; supported: mem, file:<dir>, dht:<dir>\")\n    79\t                    {:value value\n    80\t                     :supported supported-args}))))\n    81\t\n    82\t\n    83\t(defn- dht-refusal\n    84\t  \"Why a `{:type :dht ...}` spec is not a DHT store composition, or nil.\n    85\t   A spec with no peers is solo: it opens no socket, so a manifest to\n    86\t   fetch has nothing to fetch through and is refused rather than\n    87\t   ignored.\"\n    88\t  [{:keys [dir peers publish? bind-host bind-port max-inbound-bytes manifest\n    89\t           bind!]}]\n    90\t  (cond\n    91\t    (not (and (string? dir) (not (str/blank? dir))))\n    92\t    \"--index-store dht:<dir> needs a directory\"\n    93\t\n    94\t    (not (and (vector? peers)\n    95\t              (every? #(and (map? %)\n    96\t                            (datagram/ip-literal? (:host %))\n    97\t                            (datagram/valid-port? (:port %)))\n    98\t                      peers)))\n    99\t    \"DHT peers must be {:host <IP literal> :port <1 to 65535>}\"\n   100\t\n   101\t    (not (boolean? publish?))\n   102\t    \"the DHT publication declaration must be true or false\"\n   103\t\n   104\t    (not (datagram/ip-literal? bind-host))\n   105\t    \"the DHT bind host must be an IP literal\"\n   106\t\n   107\t    (not (and (integer? bind-port) (<= 0 bind-port 65535)))\n   108\t    \"the DHT bind port must be 0 (ephemeral) or 1 to 65535\"\n   109\t\n   110\t    (not (and (integer? max-inbound-bytes) (<= 0 max-inbound-bytes)))\n   111\t    \"--dht-max-inbound-bytes must be a nonnegative integer\"\n   112\t\n   113\t    (and (empty? peers) (some? manifest))\n   114\t    (str \"--dht-manifest needs a --dht-peer to fetch from: with no peers \"\n   115\t         \"the DHT store is solo and opens no socket\")\n   116\t\n   117\t    (not (or (nil? manifest) (jing/segment-address? manifest)))\n   118\t    \"--dht-manifest must be a segment manifest address\"\n   119\t\n   120\t    (not (or (nil? bind!) (fn? bind!)))\n   121\t    \":bind! must be a dao.stream.datagram host seam function\"))\n   122\t\n   123\t\n   124\t(def default-max-inbound-bytes\n   125\t  \"The CLI default of the DHT store's inbound storage bound\n221:   (`:index-store`, the durable `dao.jing` handle a file/DHT session\n231:  (when-let [store (:index-store state)]\n955:(defn create-state\n1064:                                          \"index store: :index-store-spec \"\n1066:                                          \":index-store (a dao.jing handle), \"\n1068:                                     {:index-store-spec index-store-spec}))\n1109:        :index-store (repl.dht/without-runner index-store)\n1110:        :index-store-spec index-store-spec\n2164:                               (:index-store state)\n2166:           (store/durable? (:index-store state))\n2224:                   (if (store/durable? (:index-store state))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/observer.cljc | sed -n '210,281p'; nl -ba src/cljc/yin/repl.cljc | sed -n '1268,1310p;955,1015p'; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '260,285p'; nl -ba /Users/sto/workspace/datomworld/collab/yang-clojure/1794374077000-engineer-cc3-fix-r2.muse-wonder-1.0.findings.md | sed -n '135,200p'; nl -ba test/yang/latte_oracle_test.clj | sed -n '3690,3799p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/observer.cljc | sed -n '210,281p'; nl -ba src/cljc/yin/repl.cljc | sed -n '1268,1310p;955,1015p'; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '260,285p'; nl -ba /Users/sto/workspace/datomworld/collab/yang-clojure/1794374077000-engineer-cc3-fix-r2.muse-wonder-1.0.findings.md | sed -n '135,200p'; nl -ba test/yang/latte_oracle_test.clj | sed -n '3690,3799p'\"","aggregated_output":"   210\t   failure happened.\"\n   211\t  [session e]\n   212\t  (throw (ex-info (or (ex-message e) (str e))\n   213\t                  (assoc (ex-data e) :session session)\n   214\t                  e)))\n   215\t\n   216\t\n   217\t(defn run-on-stream\n   218\t  \"Coordinate one `{:observer observer :consumer consumer}` session over the\n   219\t   attached medium, returning the updated session.\n   220\t\n   221\t   The consumer is any value the three supplied functions agree on. `ready?`\n   222\t   decides when it may accept another batch, `load` hands it one observed\n   223\t   batch and returns the successor consumer, and `run` lets it do whatever\n   224\t   work a loaded batch implies — evaluate, expand, index, forward — and\n   225\t   returns the successor. This is coordination, not interpretation: no field\n   226\t   of the consumer is inspected, so any consumer shape can be driven.\n   227\t\n   228\t   A consumer that is not ready runs first, and observation follows only if\n   229\t   it becomes ready. A ready consumer observes one batch; `gap` commits the\n   230\t   recovery cursor and continues; `blocked` and `end` return the session.\n   231\t   After a batch loads and runs, a consumer that is ready again observes the\n   232\t   next batch, and one that is not returns the session without another read.\n   233\t\n   234\t   A `load` or `run` that throws still propagates — the throw is kept — but\n   235\t   carries the partial session in the exception's data under `:session`, so\n   236\t   recovery is opt-in. Where the failure happened decides the carried\n   237\t   session: a throwing `load` carries the cursor *before* the failing batch,\n   238\t   so a retry re-reads it; a throwing `run` carries the cursor *after* the\n   239\t   loaded batch and the consumer the failing `run` left — the partial state\n   240\t   it reported under `:consumer` in its own exception's data when it made\n   241\t   progress before throwing, else the state `load` returned — so a retry\n   242\t   neither re-reads the batch nor repeats work already delivered; a\n   243\t   terminal read after processed batches carries the session those batches\n   244\t   produced. A consumer whose input can be bad should therefore return that\n   245\t   as data from `load` rather than throw, and reserve the throw for its own\n   246\t   defects.\"\n   247\t  [session ready? load run]\n   248\t  (loop [{:keys [observer consumer]} session]\n   249\t    (if-not (ready? consumer)\n   250\t      (let [consumer' (try (run consumer)\n   251\t                           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   252\t                             (carry-session\n   253\t                               {:observer observer,\n   254\t                                :consumer (consumer-left-by-run e consumer)}\n   255\t                               e)))]\n   256\t        (if (ready? consumer')\n   257\t          (recur {:observer observer, :consumer consumer'})\n   258\t          {:observer observer, :consumer consumer'}))\n   259\t      ;; The load is the step's effect, so the cursor advances only once it has\n   260\t      ;; returned: a throwing load propagates before any successor exists, and\n   261\t      ;; the session it carries names the cursor before the failing batch.\n   262\t      (let [observed (try (observe/step (:stream observer)\n   263\t                                        (:cursor observer)\n   264\t                                        (fn [batch]\n   265\t                                          {:dao.stream/outcome :dao.stream/ok,\n   266\t                                           :dao.stream.observer/loaded\n   267\t                                           (load consumer batch)}))\n   268\t                          (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   269\t                            (carry-session {:observer observer, :consumer consumer} e)))]\n   270\t        (case (:status observed)\n   271\t          :advance (let [loaded (:dao.stream.observer/loaded (:effect observed))\n   272\t                         ;; The batch was observed and loaded before the run, so\n   273\t                         ;; a throwing run carries the post-batch cursor and the\n   274\t                         ;; consumer it left: the partial state it reported in\n   275\t                         ;; its exception's data, else the loaded value.\n   276\t                         observer' (assoc observer :cursor (:cursor observed))\n   277\t                         consumer' (try (run loaded)\n   278\t                                        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   279\t                                          (carry-session\n   280\t                                            {:observer observer',\n   281\t                                             :consumer (consumer-left-by-run e loaded)}\n   955\t(defn create-state\n   956\t  \"Create the shell value.  `:primitives` is a host-supplied map merged over\n   957\t   the REPL primitives; it is kept as `:extra-primitives` so every session\n   958\t   rebuild — `(reset)`, `(vm …)` — installs it again.\n   959\t\n   960\t   `content-store` (a `dao.jing` byte-store handle), `content-client` (a\n   961\t   `dao.stream.rpc` client state on a connection whose far end serves\n   962\t   content) and `name-env` (module name -> manifest address) compose the\n   963\t   content pair and the name environment the linker interpreter serves\n   964\t   `(require ...)` from (yin.vm.linker.interpreter/composition); with\n   965\t   neither content source, a require stays `:pending` and says so.\n   966\t\n   967\t   `:link-policy` is the session's pending-link rule\n   968\t   (yin.repl.link-policy.md), kept beside `:link-source` so `(reset)` and\n   969\t   `(vm ...)` preserve it: `:manual`, the default, ends a pending run\n   970\t   only at `(abandon)`; a function `(fn [view])` is consulted when a\n   971\t   require parks and after each re-check that leaves the run pending,\n   972\t   answering `:keep`, `:abandon` or `{:abandon reason}`; `:lease` is\n   973\t   reserved for phase 2 and refused, as is anything else, at assembly.\n   974\t\n   975\t   `:admission` configures the signed-name source's in-process\n   976\t   interpreter (yin.vm.linker.dht.md 7.5,\n   977\t   `yin.vm.linker.interpreter/composition`'s option): by default `{}`,\n   978\t   which trusts the `:dht-key`'s own principal alone;\n   979\t   `{:trusted #{principal}}`, each `ed25519:<hex>`, trusts more;\n   980\t   `:verify`, `:decision` and `:decision-medium` replace the default\n   981\t   rule.\n   982\t   `:external` runs no interpreter in process: the questions a require\n   983\t   asks wait for an answer appended to the session's answer medium.\n   984\t\n   985\t   `index-store` is the `dao.jing` byte store the code indexer publishes\n   986\t   its covered indexes into (docs/design/yin.repl.dao.space-index.md); it\n   987\t   outlives a session rebuild, and defaults to a fresh in-memory store.\n   988\t\n   989\t   `index-store-spec` is the startup selection of that store\n   990\t   (yin.repl.store): `:mem` — the default, today's behaviour — or\n   991\t   `{:type :file :dir dir}`, the durable content log at\n   992\t   `<dir>/content.jing`, opened under an exclusive directory lock with\n   993\t   its HEAD read and the snapshot it names validated — a corrupt HEAD\n   994\t   or snapshot refuses construction, and a second owner of the directory\n   995\t   is refused naming it.  The spec is resolved and the store opened once\n   996\t   here, never switched at runtime, and supplying it together with\n   997\t   `index-store` (a handle injected directly) is refused.\n   998\t\n   999\t   `:index-recovery` carries what the durable open recovered —\n  1000\t   `{:manifest <address or nil> :datoms <the validated snapshot or nil>}`\n  1001\t   — and the indexer is rehydrated from it here, before any evaluation\n  1002\t   is admitted (`yin.repl.index/rehydrate`): `q` answers the previous\n  1003\t   run's facts, which keep their own session tokens, while this process\n  1004\t   mints a new token for its own.  In durable mode `(reset)` and `(vm …)`\n  1005\t   carry the index across the rebuild; with the memory store they start\n  1006\t   an empty one, as they always have.\n  1007\t\n  1008\t   `{:type :dht :dir dir ...}` is the DHT store (yin.repl.dht): that\n  1009\t   durable directory store with a `dao.jing.dht` node composed over it.\n  1010\t   Its step-owner value is `:dht`, advanced only by `yin.repl.dht/step`\n  1011\t   from the host's ticker; a round publishes against the local store and\n  1012\t   never waits on it.  It is also the link source\n  1013\t   (yin.vm.linker.dht.md 4.1): a `(require ...)` of a name `name-env`\n  1014\t   resolves starts a closure load on the node, which may fetch from\n  1015\t   peers, and parks until the load ends; `content-store` and\n  1268\t  \"Gaps the evaluation path's observers counted.  The code indexer's are\n  1269\t   its own: an index loss is reported without refusing evaluation.\"\n  1270\t  [state]\n  1271\t  (+ (:ingress-gaps (:observer state) 0)\n  1272\t     (:ingress-gaps (:row-observer state) 0)))\n  1273\t\n  1274\t\n  1275\t(defn- consume-failed-round\n  1276\t  \"Answer a round that threw with a recoverable shell state.\n  1277\t\n  1278\t   The failed input is consumed exactly once: each of the session's\n  1279\t   observers resumes from the session the throw carried — the failing\n  1280\t   stage's, matched by the medium it holds — or from where the round began\n  1281\t   when it carried none, and reads past every batch still on its medium.\n  1282\t   The shell is the only appender and appends one batch per round, so what\n  1283\t   remains is the failed batch alone.  The VM is the one the round began\n  1284\t   with, so a half-run continuation cannot be resumed — and its error\n  1285\t   replayed — by the next input.  Output the round already emitted is\n  1286\t   drained here, once.\"\n  1287\t  [state error]\n  1288\t  (let [carried (get-in (ex-data error) [:session :observer])\n  1289\t        resume (fn [observer]\n  1290\t                 (if (and observer\n  1291\t                          carried\n  1292\t                          (= (:stream carried) (:stream observer)))\n  1293\t                   carried\n  1294\t                   observer))\n  1295\t        drained (assoc state\n  1296\t                       :observer (drain-observer (resume (:observer state)))\n  1297\t                       :row-observer (drain-observer\n  1298\t                                       (resume (:row-observer state)))\n  1299\t                       :indexer (index/skip (:indexer state))\n  1300\t                       :ast-indexer (ast-index/skip (:ast-indexer state)))\n  1301\t        [state' output-text]\n  1302\t        (drain-output\n  1303\t          (cond-> drained\n  1304\t            (> (ingress-gaps drained) (ingress-gaps state))\n  1305\t            (assoc :ingress-loss? true)))]\n  1306\t    [state' (str output-text (format-error error))]))\n  1307\t\n  1308\t\n  1309\t(defn- run-index-stage\n  1310\t  \"Drive the code indexer's observer over `program-out`: it commits each\n   260\t  \"Returns true when the currently active continuation should keep stepping.\"\n   261\t  [vm]\n   262\t  (and (not (:blocked? vm)) (not (:halted? vm))))\n   263\t\n   264\t\n   265\t(defn ready-for-ingress?\n   266\t  \"Returns true when the VM is between evaluations and can accept another\n   267\t   program batch: not blocked, nothing scheduled or waiting, no active\n   268\t   continuation, and no loaded work.\n   269\t\n   270\t   This predicate gates observer coordination above the VM. The VM itself\n   271\t   never polls a program stream: `step` and `run` execute loaded work only.\"\n   272\t  [vm]\n   273\t  (let [has-bytecode? (contains? vm :bytecode)\n   274\t        bytecode (:bytecode vm)\n   275\t        no-bytecode? (and has-bytecode?\n   276\t                          (or (nil? bytecode)\n   277\t                              (and (sequential? bytecode) (empty? bytecode))))]\n   278\t    (and (not (:blocked? vm))\n   279\t         (empty? (or (:ready-queue vm) []))\n   280\t         (empty? (or (:wait-set vm) []))\n   281\t         (nil? (:k vm))\n   282\t         (or (:halted? vm) (nil? (:control vm)) no-bytecode?))))\n   283\t\n   284\t\n   285\t;; =============================================================================\n   135\tevidence in this round was taken (the measurements are compile/binding/\n   136\tlowering only; the tagged deftest runs below cite this record).\n   137\t\n   138\t## PREFLIGHT BOUNDS (r2; design §6.3)\n   139\t\n   140\tPreserved status of the earlier run: the cc3 r1 preflight record\n   141\t(1,316 stamped rows / 3,669 occurrences / 987 stamped applications /\n   142\tmax path depth 90 / 103,650 path bytes / restated 4,000,000 guest\n   143\tinstructions and 1,000,000 trace records per C lane) supplied NO\n   144\tstatic-side storage or retained-memory bound, NO compilation/\n   145\tpublication/verification time ceilings, and NO process/heap ceiling or\n   146\tmeasurement method. It stands in the r1 findings as an\n   147\tincomplete-preflight run; nothing here re-stamps it.\n   148\t\n   149\tMeasured 2026-11-11 in-session (JVM, warm; fixture\n   150\t`{:call (latte-kernel.utils/vectorn? [1 2 3] 2)}` through\n   151\t`kernel-compile`, `cc3-oracle-binding`, `linearize/project-rows`,\n   152\t`derive/stack-image`, `derive/register-image`; bytes are\n   153\t`dao.jing/canonical-bytes` lengths; heap by\n   154\t`java.lang.Runtime.getRuntime` `totalMemory − freeMemory`, sampled in\n   155\tthe measuring JVM after binding — a process-wide figure including the\n   156\ttest harness, comparable only on this host/JVM):\n   157\t\n   158\t| Bound | Measured | Declared finite ceiling |\n   159\t|---|---|---|\n   160\t| Canonical rows (pre-stamp tree) | 1,309 | — (r1 record) |\n   161\t| Application occurrences A (pre-stamp / stamped) | 981 / 987 | — (r1 record) |\n   162\t| Oracle sites | 2 | — |\n   163\t| Call-provenance rows (semantic) | 948 | — |\n   164\t| Static side bytes: C1 rows (canonical) | 332,846 B | — |\n   165\t| Static side bytes: provenance relation, all 3 lanes (canonical) | 927,196 B | 2,000,000 B per artifact (rows + relation) |\n   166\t| Retained memory (relation retained per artifact) | 927,196 B canonical | 1,000,000 B per artifact; 8,000,000 B aggregate session closure |\n   167\t| Compilation time (`kernel-compile`, warm JVM) | 79 ms | 10,000 ms |\n   168\t| Publication/projection time (encoder projects, both trees, in binding) | within binding 335 ms | 10,000 ms |\n   169\t| Verification time (binding + project-rows + both derives) | 583 ms | 10,000 ms |\n   170\t| Process heap used (whole measuring JVM, Runtime method above) | 193,075,200 B (~184 MiB) | 1,073,741,824 B (1 GiB) used heap, same method |\n   171\t| Guest instructions / trace records per C lane | restated, NOT raised | 4,000,000 / 1,000,000 (r1 record) |\n   172\t| Binding added guest work | 0 instructions, 0 trace records | 0 (host-side only) |\n   173\t\n   174\tFailure rule (unchanged): exceeding any ceiling is a failed bounded\n   175\trun; bounds are never silently raised.\n   176\t\n   177\t## Red-first evidence\n   178\t\n   179\tTests were written before the fix for each item; observed red in this\n   180\tsession:\n   181\t\n   182\t| Item | Red | Green |\n   183\t|---|---|---|\n   184\t| 4 (durable) | `repl-packet-provenance-durable-test`: 3 failures (no handles retained; nothing retrievable) | 1 failure (first handle's lane empty — a call-free `def`), then 0 after selecting a call-bearing handle |\n   185\t| 5 (binding) | `test-cc3-oracle-site-c1-binding`: 2 failures (stamped-set equality and stamped>pre-stamp assertions as first written) | 0 (34 assertions) — the stamped set is now verified as marked ∪ derived inserted helpers |\n   186\t| 1 (mutation) | with wrapper-removal neutralized in a scratch copy (the pre-r2 behavior), `test-cc3-stamp-correspondence-nested`: 1 failure (`(get correspondence stamped-path)` = nil for the nested site) | 0 (6 assertions) against the delivered code |\n   187\t| 2 (mutation) | with the origin reverted to the content hash in a scratch copy, `test-cc3-distinct-admissions-distinct-origins`: 2 failures (identical origins; identical bound key sets) | 0 (8 assertions) against the delivered code |\n   188\t| 3 | new 3-arity admission test written against the root-only signature (its claimed-A/unclaimed-B arm is unanswerable by the old code) | 0 (15 assertions) |\n   189\t\n   190\tMutation copies lived under `/tmp/cc3-mut/` and were not delivered.\n   191\t\n   192\t## Verification\n   193\t\n   194\t| Lane | Command | Outcome |\n   195\t|---|---|---|\n   196\t| Callsite battery | `clojure -M:test -n yang.clojure-callsite-test` | 34 tests, 389 assertions, 0 failures, 0 errors |\n   197\t| Touched semantic + repl | `clojure -M:test -n yin.vm.semantic.linearize-test -n yin.vm.semantic.derive-test -n yin.repl-test` | 103 tests, 7,601 assertions, 0 failures, 0 errors |\n   198\t| Durable store (extra, repl-adjacent) | `clojure -M:test -n yin.repl.store-test` | 27 tests, 132 assertions, 0 failures, 0 errors |\n   199\t| Oracle binding | `clojure -M:test -n yang.latte-oracle-test -v yang.latte-oracle-test/test-cc3-oracle-site-c1-binding` | 1 test, 34 assertions, 0 failures, 0 errors |\n   200\t| Oracle nested correspondence | `… -v yang.latte-oracle-test/test-cc3-stamp-correspondence-nested` | 1 test, 6 assertions, 0 failures, 0 errors |\n  3690\t        ;; wraps its argument node in three new applications\n  3691\t        ;; (data/nth, dsg__intra_call, conj) — applications of the\n  3692\t        ;; stamped tree that are not C1 occurrences of the compiled\n  3693\t        ;; program, accounted for here as their own set\n  3694\t        (let [wrapper-paths (into #{}\n  3695\t                                  (comp (filter (fn [[_ node]]\n  3696\t                                                  (kernel-stamped-args? node)))\n  3697\t                                        (map first))\n  3698\t                                  (cc3-walk (:ast compiled) [] []))\n  3699\t              inserted (into #{}\n  3700\t                             (mapcat (fn [p]\n  3701\t                                       [(conj p) (conj p [3 0])\n  3702\t                                        (conj p [3 0] [3 1])]))\n  3703\t                             wrapper-paths)\n  3704\t              inserted-keys (into #{}\n  3705\t                                  (map (fn [p] [origin\n  3706\t                                                (:root stamped-tree) p]))\n  3707\t                                  inserted)]\n  3708\t          (is (= (count sites) (count wrapper-paths))\n  3709\t              \"one stamping wrapper per oracle site\")\n  3710\t          (is (empty? (set/intersection stamped-marked inserted-keys))\n  3711\t              \"inserted helpers are not marked occurrences\")\n  3712\t          (is (= stamped-eligible\n  3713\t                 (set/union stamped-marked inserted-keys))\n  3714\t              \"the stamped application set is exactly the marked occurrences plus the inserted helpers\")\n  3715\t          (is (= (+ (count marked) (* 3 (count sites)))\n  3716\t                 (count stamped-eligible))\n  3717\t              \"stamping inserted three applications per site and nothing else\")))\n  3718\t      (testing \"stamped paths are translated, never reused as pre-stamp paths (item 1)\"\n  3719\t        (is (every? (fn [[k [_ _ pre-path]]]\n  3720\t                      (= pre-path (get correspondence (get stamped-paths k))))\n  3721\t                    binding)\n  3722\t            \"every bound key's path is its stamped path through the correspondence\"))\n  3723\t      (testing \"bijection: stamped guest sites <-> selected compiled occurrences\"\n  3724\t        (is (= (set (map :site sites)) (set (keys binding))))\n  3725\t        (is (= (count binding) (count (into #{} (vals binding))))\n  3726\t            \"no two sites share an occurrence (duplicate content keeps distinct paths)\")\n  3727\t        (is (every? marked (vals binding))\n  3728\t            \"every bound key is a validated post-expansion C1 occurrence\"))\n  3729\t      (testing \"Rule R: yin/def occurrences are marked but emit no call event\"\n  3730\t        (let [sem (linearize/project-rows tree nil rows)\n  3731\t              define-paths (into #{}\n  3732\t                                 (keep (fn [[pc _o _r p]]\n  3733\t                                         (when (= :define (first (nth (:vector sem) pc)))\n  3734\t                                           p)))\n  3735\t                                 (:provenance sem))\n  3736\t              call-keys (set (map (fn [[_ o r p]] [o r p])\n  3737\t                                  (:call-provenance sem)))]\n  3738\t          (is (seq define-paths))\n  3739\t          (is (every? (fn [k] (not (contains? call-keys k)))\n  3740\t                      (filter (fn [[_ _ p]] (contains? define-paths p)) marked))\n  3741\t              \"a :define occurrence never appears as a call-provenance key\")))\n  3742\t      (testing \"lowering: exact call-PC coverage and multiplicities (item 5)\"\n  3743\t        (let [sem (linearize/project-rows tree nil rows)\n  3744\t              cp (:call-provenance sem)\n  3745\t              stack (derive/stack-image\n  3746\t                      (:vector sem) {:segment-address :seg/stack\n  3747\t                                     :call-provenance cp})\n  3748\t              register (derive/register-image\n  3749\t                         (:vector sem) {:segment-address :seg/register\n  3750\t                                        :call-provenance cp})\n  3751\t              ;; independently derived expected occurrences: every\n  3752\t              ;; marked application of the compiled tree except the\n  3753\t              ;; Rule-R `yin/def` applications (they lower to :define)\n  3754\t              define-paths (into #{}\n  3755\t                                 (comp (filter (fn [[_ node]]\n  3756\t                                                 (and (= :application (:type node))\n  3757\t                                                      (= :variable (:type (:operator node)))\n  3758\t                                                      (= 'yin/def (:name (:operator node))))))\n  3759\t                                       (map first))\n  3760\t                                 (cc3-walk (:compiled-ast compiled) [] []))\n  3761\t              expected (frequencies\n  3762\t                         (map (fn [[o r p]] [o r p])\n  3763\t                              (remove (fn [[_ _ p]] (contains? define-paths p))\n  3764\t                                      marked)))\n  3765\t              keys-of (fn [prov] (map (fn [[_ _ o r p]] [o r p]) prov))\n  3766\t              call-pcs (fn [instructions]\n  3767\t                         (into []\n  3768\t                               (keep-indexed (fn [pc ins]\n  3769\t                                               (when (= :call (first ins)) pc)))\n  3770\t                               instructions))]\n  3771\t          (is (seq define-paths) \"the fixture carries Rule-R definitions\")\n  3772\t          (is (= expected (frequencies (map (fn [[_ o r p]] [o r p]) cp)))\n  3773\t              \"semantic call provenance is exactly the expected occurrence multiset\")\n  3774\t          (is (= expected (frequencies (keys-of (:call-provenance stack)))))\n  3775\t          (is (= expected (frequencies (keys-of (:call-provenance register)))))\n  3776\t          (is (= (call-pcs (:vector sem)) (mapv first cp))\n  3777\t              \"every semantic :call pc carries provenance, in pc order\")\n  3778\t          (is (= (call-pcs (:image stack))\n  3779\t                 (mapv second (:call-provenance stack)))\n  3780\t              \"every stack :call pc carries provenance, in pc order\")\n  3781\t          (is (= (call-pcs (:instructions register))\n  3782\t                 (mapv second (:call-provenance register)))\n  3783\t              \"every register :call pc carries provenance, in pc order\")))\n  3784\t      (testing \"both C lanes resolve each executed call to the identical K\"\n  3785\t        (let [lane-keys (fn [lane]\n  3786\t                          (let [row (kernel-c compiled lane)]\n  3787\t                            (is (= :completed (:status row)) (str lane))\n  3788\t                            (into #{}\n  3789\t                                  (comp (map #(nth % 2 nil))\n  3790\t                                        (filter integer?)\n  3791\t                                        (map (fn [k]\n  3792\t                                               (is (contains? binding k)\n  3793\t                                                   (str \"executed site \" k \" is bound\"))\n  3794\t                                               (get binding k))))\n  3795\t                                  (:executed-calls row))))]\n  3796\t          (is (= (lane-keys :c-walker) (lane-keys :c-semantic))))))))\n  3797\t\n  3798\t\n  3799\t(deftest test-cc3-stamp-correspondence-nested\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"The ordinary REPL path has a one-batch-per-round invariant, so the new-table delta plus exact `[admission root]` lookup closes the borrowing case there. Persistence now reaches every loader, but if loading or evaluation throws, the artifacts are written and their handles are lost from the returned state. The oracle admission counter also resets in each JVM, allowing separate runs to mint identical origins."}}
