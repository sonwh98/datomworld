{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl.cljc | sed -n '170,300p;1470,1530p;1905,2002p'\"","aggregated_output":"   170\t\n   171\t\n   172\t(defn packet-call-provenance\n   173\t  \"The call provenance of one expanded tree `packet` under the\n   174\t   packet's retained admission identity `admission` (cc3 r2 item 3),\n   175\t   resolved from the expander's retained C1 side tables\n   176\t   (`call-site-tables`, keyed `[admission-origin final-root]`) by\n   177\t   `[admission root]` exactly: `{:semantic [[segment pc origin root\n   178\t   path] …] :stack […] :register […]}` over the same images the\n   179\t   loaders derive, or nil when THAT admission claimed no C1 for the\n   180\t   packet's root (absence, never invention — a table is never\n   181\t   borrowed across admissions, so an unclaimed admission with\n   182\t   canonical content identical to a claimed one still answers nil,\n   183\t   aligning with `record-call-site-admissions`' refusal to assign old\n   184\t   evidence to new programs). A malformed admission identity refuses\n   185\t   with `:rule :call-site-admission`. Segment coordinates are the\n   186\t   images' own content identities, as the loaders compute them.\"\n   187\t  [state packet admission]\n   188\t  (when-not (vm/occurrence-origin? admission)\n   189\t    (throw (ex-info \"Packet provenance requires a retained admission origin\"\n   190\t                    {:rule :call-site-admission, :admission admission})))\n   191\t  (let [root (first packet)\n   192\t        tables (:call-site-tables (:expander state))\n   193\t        rows (get tables [admission root])]\n   194\t    (when (some? rows)\n   195\t      (let [rows (vec rows)\n   196\t            proj (linearize/project-rows (macro/packet->row-set packet)\n   197\t                                         nil rows)\n   198\t            v (:vector proj)\n   199\t            sem-address (ucf/code-address v)\n   200\t            ;; each image is derived ONCE, provenance attached: the\n   201\t            ;; segment coordinate is the image own content identity\n   202\t            ;; (unchanged by provenance), patched into the rows as the\n   203\t            ;; loaders compute it\n   204\t            stack (derive/stack-image\n   205\t                    v {:call-provenance (:call-provenance proj)})\n   206\t            stack-address (dcode/image-hash (:image stack))\n   207\t            register (derive/register-image\n   208\t                       v {:call-provenance (:call-provenance proj)})\n   209\t            register-address (rcode/register-hash register)]\n   210\t        {:semantic (mapv (fn [[pc o r p]] [sem-address pc o r p])\n   211\t                         (:call-provenance proj))\n   212\t         :stack (mapv (fn [row] (assoc row 0 stack-address))\n   213\t                      (:call-provenance stack))\n   214\t         :register (mapv (fn [row] (assoc row 0 register-address))\n   215\t                         (:call-provenance register))}))))\n   216\t\n   217\t\n   218\t(defn retain-packet-call-provenance!\n   219\t  \"Persist one packet's admission-scoped call provenance (cc3 r2\n   220\t   item 4) as a side artifact in the session's content store\n   221\t   (`:index-store`, the durable `dao.jing` handle a file/DHT session\n   222\t   reopens): the relation `{:yin.vm.provenance/schema 1 :admission …\n   223\t   :root … :semantic […] :stack […] :register […]}` and a record\n   224\t   naming it, both content-addressed OUTSIDE any manifest hash.\n   225\t   Answers `{:handle record-address :relation address :admission a\n   226\t   :root r :provenance relation}` — the handle is the retrievable\n   227\t   lookup key `call-provenance-handles` carries on the session state —\n   228\t   or nil when the admission claimed nothing for the packet or the\n   229\t   session has no content store (absence, never invention).\"\n   230\t  [state packet admission]\n   231\t  (when-let [store (:index-store state)]\n   232\t    (when-let [prov (packet-call-provenance state packet admission)]\n   233\t      (let [relation {:yin.vm.provenance/schema 1\n   234\t                      :yin.vm.provenance/admission admission\n   235\t                      :yin.vm.provenance/root (first packet)\n   236\t                      :yin.vm.provenance/semantic (:semantic prov)\n   237\t                      :yin.vm.provenance/stack (:stack prov)\n   238\t                      :yin.vm.provenance/register (:register prov)}\n   239\t            relation-address (jing/materialize! store relation)\n   240\t            record {:yin.repl.call-provenance/schema 1\n   241\t                    :yin.repl.call-provenance/admission admission\n   242\t                    :yin.repl.call-provenance/root (first packet)\n   243\t                    :yin.repl.call-provenance/relation relation-address}]\n   244\t        {:handle (jing/materialize! store record)\n   245\t         :relation relation-address\n   246\t         :admission admission\n   247\t         :root (first packet)\n   248\t         :provenance prov}))))\n   249\t\n   250\t\n   251\t(defn retained-packet-call-provenance\n   252\t  \"The durable packet provenance retained under `handle` (a\n   253\t   `retain-packet-call-provenance!` record address) in `store`,\n   254\t   verified through its record linkage: `{:admission a :root r\n   255\t   :semantic […] :stack […] :register […]}`, or nil when the handle\n   256\t   names no verifying retained relation (a legacy session persisted\n   257\t   none). Works against a freshly reopened durable store: the handle\n   258\t   alone is the lookup key.\"\n   259\t  [store handle]\n   260\t  (when (jing/segment-address? handle)\n   261\t    (let [record (jing/get store handle nil)]\n   262\t      (when (and (map? record)\n   263\t                 (= 1 (:yin.repl.call-provenance/schema record))\n   264\t                 (jing/segment-address?\n   265\t                   (:yin.repl.call-provenance/relation record)))\n   266\t        (let [relation (jing/get store\n   267\t                                 (:yin.repl.call-provenance/relation record)\n   268\t                                 nil)]\n   269\t          (when (and (map? relation)\n   270\t                     (= 1 (:yin.vm.provenance/schema relation))\n   271\t                     (= (:yin.repl.call-provenance/admission record)\n   272\t                        (:yin.vm.provenance/admission relation))\n   273\t                     (= (:yin.repl.call-provenance/root record)\n   274\t                        (:yin.vm.provenance/root relation)))\n   275\t            {:admission (:yin.vm.provenance/admission relation)\n   276\t             :root (:yin.vm.provenance/root relation)\n   277\t             :semantic (:yin.vm.provenance/semantic relation)\n   278\t             :stack (:yin.vm.provenance/stack relation)\n   279\t             :register (:yin.vm.provenance/register relation)}))))))\n   280\t\n   281\t\n   282\t(defn call-provenance-handles\n   283\t  \"The `{[admission root] record-address}` lookup handles of the\n   284\t   packet provenance this session's production loaders durably\n   285\t   retained (cc3 r2 item 4), for retrieval through\n   286\t   `retained-packet-call-provenance` — including after the session's\n   287\t   durable store is reopened. Empty before any claimed load.\"\n   288\t  [state]\n   289\t  (:call-provenance-handles state))\n   290\t\n   291\t\n   292\t(defn- append-stack-image\n   293\t  \"Attach `image` after the stack image `vm` already holds and start at\n   294\t   its first instruction.  A closure a previous input stored (a `def`)\n   295\t   names a body pc in the earlier image, so that image is kept, not\n   296\t   replaced.  `stack/attach-image` admits the incoming image alone under\n   297\t   the current stamp (the expander and the lowerer are its fresh\n   298\t   producers), relocates and appends it, records its offset-table row,\n   299\t   and keeps `:hash` the canonical H of the whole `:segment`\n   300\t   (yin.vm.linker.md section 7.3).  Attaching touches no register, so\n  1470\t  \"Drive the evaluator's observer over `program-out`: it loads each\n  1471\t   expanded tree packet into the VM, runs it, and answers its value on the\n  1472\t   output medium.  The two stages meet only at `program-out`; neither calls\n  1473\t   the other.\"\n  1474\t  [{:keys [load-program output-stream] :as state}]\n  1475\t  (let [;; cc3 r2 item 4: every production loader passes through this\n  1476\t        ;; wrapper, so admission-scoped provenance production is\n  1477\t        ;; connected to durable retention on the ordinary REPL path —\n  1478\t        ;; a packet whose root this round's expansion claimed under\n  1479\t        ;; exactly one new admission is retained in the session's\n  1480\t        ;; content store, and its lookup handle rides the session state\n  1481\t        ;; out (`call-provenance-handles`). Unclaimed packets retain\n  1482\t        ;; nothing (absence, never invention).\n  1483\t        handles (volatile! {})\n  1484\t        retaining-load (fn [vm packet]\n  1485\t                         (when-let [admission\n  1486\t                                    (get (:call-site-round-claims state)\n  1487\t                                         (first packet))]\n  1488\t                           (when-let [retained\n  1489\t                                      (retain-packet-call-provenance!\n  1490\t                                        state packet admission)]\n  1491\t                             (vswap! handles assoc\n  1492\t                                     [admission (first packet)]\n  1493\t                                     (:handle retained))))\n  1494\t                         (load-program vm packet))\n  1495\t        {:keys [observer] vm :consumer}\n  1496\t        (observer/run-on-stream {:observer (:row-observer state),\n  1497\t                                 :consumer (:vm state)}\n  1498\t                                engine/ready-for-ingress?\n  1499\t                                retaining-load\n  1500\t                                (make-runner output-stream (round-id state)))]\n  1501\t    (cond-> (-> state\n  1502\t                (assoc :row-observer observer :vm vm)\n  1503\t                (dissoc :call-site-round-claims))\n  1504\t      (seq @handles) (update :call-provenance-handles merge @handles))))\n  1505\t\n  1506\t\n  1507\t(defn- format-expansion-errors\n  1508\t  [errors]\n  1509\t  (str/join \"\\n\" (map #(str \"Error: Macro expansion failed: \" (format-value %))\n  1510\t                      errors)))\n  1511\t\n  1512\t\n  1513\t(defn- link-waiting?\n  1514\t  \"True while `vm` parks on a link wait: the two link states `require`\n  1515\t   parks in, or the install it waits on (yin.vm.linker.md section 7.2).\n  1516\t   These are the reasons the shell's interpreter can move, so they are\n  1517\t   the ones a round drives before reporting the VM wedged.\"\n  1518\t  [vm]\n  1519\t  (boolean (some #(contains? #{:link-request :link-response :install}\n  1520\t                             (:reason %))\n  1521\t                 (:wait-set vm))))\n  1522\t\n  1523\t\n  1524\t(defn- carry-link-identity\n  1525\t  \"The round's base VM with the link identity `used` has already minted\n  1526\t   carried forward: link ids `[origin counter]` and install-child origin\n  1527\t   tags are minted once and never reused on a pair (yin.vm.linker.md\n  1528\t   section 7.2), and the shell's rollback to the round's base -- whose\n  1529\t   counters never advanced -- must not let a later require or install\n  1530\t   mint an identity the pair has already answered.\"\n  1905\t(defn- eval-program\n  1906\t  \"Evaluate one frontend program — the map AST the compilers emit or a\n  1907\t   datom-literal program — through the §10.1 composition.  The encoder\n  1908\t   projects it to an input batch of canonical rows with its harvest and\n  1909\t   declaration rows; the shell appends that batch to `program-in`, drives\n  1910\t   the expander, drains its summary, and drives the code and AST indexers and then\n  1911\t   the evaluator only when a program was forwarded.  An expansion failure is reported as data: its\n  1912\t   batch is consumed, the store keeps its previous macros, and the next\n  1913\t   input evaluates normally.  An encoding failure throws before anything\n  1914\t   is appended.\n  1915\t\n  1916\t   The observers recover across a gap on their own, but the shell reads the\n  1917\t   gap counts around the round: an increase on any medium means one or more\n  1918\t   batches were never run, so resuming as though execution were complete\n  1919\t   would report a result built on programs the VM never saw.  The loss is\n  1920\t   reported and the shell refuses further evaluation until `(reset)`.\n  1921\t\n  1922\t   A completed program's lexical environment does not outlive it: the VM's\n  1923\t   environment is restored to the one the round began with, as `vm/eval`\n  1924\t   does.  A round that throws is consumed by `consume-failed-round`.\"\n  1925\t  [state program]\n  1926\t  (if (:ingress-loss? state)\n  1927\t    [state (str \"Error: \" ingress-loss-text)]\n  1928\t    (let [state' (update (inject-last-value state) :round inc)\n  1929\t          tables-before (call-site-tables state')\n  1930\t          batch (encoder/program-batch program)\n  1931\t          append (stream/append! (:program-stream state') batch)]\n  1932\t      (if-not (= :dao.stream/ok (:dao.stream/outcome append))\n  1933\t        [state (str \"Error: program batch not ingested: \"\n  1934\t                    (name (:dao.stream/outcome append)))]\n  1935\t        (let [expanded (try\n  1936\t                         (run-expander-stage state')\n  1937\t                         (catch #?(:cljd Object\n  1938\t                                   :clj Exception\n  1939\t                                   :cljs js/Error) error\n  1940\t                           {:failed (consume-failed-round state error)}))]\n  1941\t          (if-let [failed (:failed expanded)]\n  1942\t            failed\n  1943\t            (let [[expanded {:keys [errors forwarded]}] expanded\n  1944\t                  indexed (if (pos? forwarded)\n  1945\t                            ;; commit evidence is captured BEFORE the\n  1946\t                            ;; index stage runs: the published programs\n  1947\t                            ;; and indexer as they stood, so the recorder\n  1948\t                            ;; pairs only what this round commits\n  1949\t                            (let [evidence\n  1950\t                                  {:programs-before\n  1951\t                                   (indexed-program-roots (:indexer expanded))\n  1952\t                                   :indexer-before (:indexer expanded)}]\n  1953\t                              (-> expanded\n  1954\t                                  run-index-stage\n  1955\t                                  run-ast-index-stage\n  1956\t                                  (assoc :call-site-commit-evidence evidence)\n  1957\t                                  ;; cc3 r2 item 4: this round's\n  1958\t                                  ;; provenance claims — the roots the\n  1959\t                                  ;; expander newly retained under\n  1960\t                                  ;; exactly one admission — ride the\n  1961\t                                  ;; state into the evaluator stage,\n  1962\t                                  ;; whose loader wrapper retains each\n  1963\t                                  ;; claimed packet's provenance\n  1964\t                                  (assoc :call-site-round-claims\n  1965\t                                         (let [new-entries\n  1966\t                                               (into {}\n  1967\t                                                     (remove\n  1968\t                                                       (fn [[k _]]\n  1969\t                                                         (contains?\n  1970\t                                                           (or tables-before {})\n  1971\t                                                           k)))\n  1972\t                                                     (or (call-site-tables\n  1973\t                                                           expanded)\n  1974\t                                                         {}))\n  1975\t                                               by-root\n  1976\t                                               (group-by (fn [[k _]]\n  1977\t                                                           (second k))\n  1978\t                                                         new-entries)]\n  1979\t                                           (into {}\n  1980\t                                                 (keep (fn [[root entries]]\n  1981\t                                                         (when (= 1 (count entries))\n  1982\t                                                           [root (first (ffirst entries))])))\n  1983\t                                                 by-root)))\n  1984\t                                  ((fn [s]\n  1985\t                                     (record-call-site-admissions\n  1986\t                                       tables-before s)))))\n  1987\t                            expanded)]\n  1988\t              (with-index-notice\n  1989\t                (cond\n  1990\t                  (> (ingress-gaps indexed) (ingress-gaps state'))\n  1991\t                  [(assoc indexed :ingress-loss? true)\n  1992\t                   (str \"Error: \" ingress-loss-text)]\n  1993\t\n  1994\t                  (pos? forwarded) (run-evaluation state indexed)\n  1995\t\n  1996\t                  :else [(assoc indexed :vm (:vm state))\n  1997\t                         (format-expansion-errors errors)])\n  1998\t                (when (pos? forwarded)\n  1999\t                  [(index/notice (:indexer expanded) (:indexer indexed))\n  2000\t                   (ast-index/notice (:ast-indexer indexed))])))))))))\n  2001\t\n  2002\t\n","exit_code":0,"status":"completed"}}
