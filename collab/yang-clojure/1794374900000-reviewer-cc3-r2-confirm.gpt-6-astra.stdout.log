{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/latte_oracle_test.clj | sed -n '2444,2500p;3475,3668p'; nl -ba test/yang/clojure_callsite_test.cljc | sed -n '2010,2110p'\"","aggregated_output":"  2444\t              (kernel-canonical-source-hash '[(fn [p1__123#] p1__456#)] '(p1__123#)))\n  2445\t        \"distinct generated symbols must remain distinct\")\n  2446\t    (is (not= (kernel-canonical-source-hash '[(def x 1)] 'x)\n  2447\t              (kernel-canonical-source-hash '[(def x 2)] 'x))\n  2448\t        \"ordinary source edits still invalidate the hash\")))\n  2449\t\n  2450\t\n  2451\t(def ^:private kernel-admission-counter\n  2452\t  ;; Admissions of oracle fixtures are sequential in this harness: each\n  2453\t  ;; `kernel-compile` admission mints the next ordinal, which its\n  2454\t  ;; retained admission record carries (cc3 r2 item 2). Replay of one\n  2455\t  ;; retained compilation reuses its record; a fresh admission of\n  2456\t  ;; identical content is a distinct admission with a distinct origin.\n  2457\t  (atom 0))\n  2458\t\n  2459\t\n  2460\t(defn- kernel-compile\n  2461\t  [fixture]\n  2462\t  (let [call (kernel-c-program fixture)\n  2463\t        forms (kernel-closure call)\n  2464\t        source-hash (kernel-canonical-source-hash forms call)\n  2465\t        ;; the admission coordinate is recorded WHEN ADMITTING this\n  2466\t        ;; fixture, before compilation, and retained with the\n  2467\t        ;; compilation (`:admission-origin`): the batch token names\n  2468\t        ;; this admission, not merely its content, so two admissions\n  2469\t        ;; of identical content never share an origin\n  2470\t        admission-origin [:source :program\n  2471\t                          (str source-hash \"#admission-\"\n  2472\t                               (swap! kernel-admission-counter inc))\n  2473\t                          0]\n  2474\t        program (into (into ['(def gate-execution-trace (stream/make 1000000))]\n  2475\t                            kernel-site-prelude)\n  2476\t                      (concat (map kernel-trace-form forms) [call]))\n  2477\t        program (into (yang/library-for program) program)\n  2478\t        opts (update arg-vector-opts :native into\n  2479\t                     (map (fn [[op profile]] [(clojure.core/symbol \"stream\" (name op)) profile])\n  2480\t                          module/stream-profiles))\n  2481\t        compiled (yang/compile-program program true opts)\n  2482\t        ;; caller-side site ids at the compiled application expressions,\n  2483\t        ;; post-macroexpansion (R2), with the mechanically derived site\n  2484\t        ;; table (R7); every assembled definition is instrumented\n  2485\t        {stamped :ast sites :sites} (kernel-stamp-sites\n  2486\t                                      compiled (into #{} (map second) forms))\n  2487\t        missing (unbound-ast-symbols stamped program)]\n  2488\t    (if (seq missing)\n  2489\t      {:status :blocked :phase :admission :blocked-by (vec (sort missing))\n  2490\t       :owners (into {} (for [s missing]\n  2491\t                          [s (mapv second (filter #(some #{s} (tree-seq coll? seq %)) program))]))}\n  2492\t      {:status :compiled :ast stamped :forms forms :compiled-ast compiled\n  2493\t       :admission-origin admission-origin\n  2494\t       :site-table (into {} (map (juxt :site identity)) sites)\n  2495\t       :site-table-hash source-hash\n  2496\t       :sites sites\n  2497\t       :canonical-source-hash source-hash})))\n  2498\t\n  2499\t\n  2500\t(defn- kernel-c\n  3475\t    (let [k (get-in wrapper [:operands 0 :operands 1 :operands 1 :value])]\n  3476\t      (when (integer? k) k))))\n  3477\t\n  3478\t\n  3479\t(defn- cc3-correspond\n  3480\t  \"The explicit stamped→pre-stamp path correspondence (cc3 r2 item 1):\n  3481\t   `{stamped-path pre-stamp-path}` over the grammar positions of both\n  3482\t   trees, built by traversing them together and removing the\n  3483\t   recognized stamping wrappers (`kernel-stamped-args?` — the three\n  3484\t   applications a stamp inserts around an argument node). A stamped\n  3485\t   site inside a stamped argument therefore maps to the path it held\n  3486\t   before stamping, never to the unrelated application its stamped\n  3487\t   path would name in the pre-stamp tree. A type mismatch, a child\n  3488\t   count mismatch, or a wrapper where the pre-stamp tree already\n  3489\t   carries one refuses with `:rule :cc3-stamp-correspondence` —\n  3490\t   mismatched or ambiguous correspondence is never guessed.\"\n  3491\t  [pre stamped pre-path stamped-path acc]\n  3492\t  (cond\n  3493\t    (kernel-stamped-args? stamped)\n  3494\t    (do (when (kernel-stamped-args? pre)\n  3495\t          (throw (ex-info \"Stamped wrapper over a pre-stamp wrapper is ambiguous\"\n  3496\t                          {:rule :cc3-stamp-correspondence\n  3497\t                           :pre-stamp-path pre-path\n  3498\t                           :stamped-path stamped-path})))\n  3499\t        ;; the wrapped argument node sits at operands[0]/operands[1]/\n  3500\t        ;; operands[2] of the wrapper — application operands are\n  3501\t        ;; grammar position 3\n  3502\t        (cc3-correspond pre (kernel-stamped-args? stamped)\n  3503\t                        pre-path (conj stamped-path [3 0] [3 1] [3 2])\n  3504\t                        acc))\n  3505\t\n  3506\t    (and (map? pre) (:type pre) (map? stamped) (:type stamped))\n  3507\t    (do (when (not= (:type pre) (:type stamped))\n  3508\t          (throw (ex-info \"Stamped tree diverges from the compiled tree\"\n  3509\t                          {:rule :cc3-stamp-correspondence\n  3510\t                           :pre-stamp-path pre-path\n  3511\t                           :stamped-path stamped-path\n  3512\t                           :pre-type (:type pre)\n  3513\t                          