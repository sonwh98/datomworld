                (get vm/semantic-bytecode-grammar\n  3544\t                                  (:type pre)))))\n  3545\t\n  3546\t    (or (map? pre) (map? stamped))\n  3547\t    (throw (ex-info \"Stamped tree diverges from the compiled tree\"\n  3548\t                    {:rule :cc3-stamp-correspondence\n  3549\t                     :pre-stamp-path pre-path\n  3550\t                     :stamped-path stamped-path}))\n  3551\t\n  3552\t    :else acc))\n  3553\t\n  3554\t\n  3555\t(defn- cc3-oracle-binding\n  3556\t  \"Bind each stamped oracle site id to its post-expansion C1 key\n  3557\t   K = [origin root path] in the COMPILED (pre-stamp) tree.\n  3558\t\n  3559\t   Chronology (mob condition 2): `kernel-compile` compiles FIRST and\n  3560\t   stamps by insertion afterward, so the stamped tree is a NEW tree.\n  3561\t   Stamped paths are NOT pre-stamp paths (cc3 r2 item 1): the binding\n  3562\t   translates each stamped site path through the explicit\n  3563\t   `cc3-correspond` transformation mapping before combining it with\n  3564\t   the pre-stamp root, and refuses a site whose mapped key is no\n  3565\t   validated C1 occurrence. The origin is the admission coordinate\n  3566\t   `kernel-compile` recorded WHEN ADMITTING the fixture and retained\n  3567\t   with the compilation (`:admission-origin`, cc3 r2 item 2) — never\n  3568\t   synthesized from content after compilation; a compilation without\n  3569\t   a retained record refuses with `:rule :cc3-admission-record`, and\n  3570\t   [:oracle/fixture <id>] is never minted.\"\n  3571\t  [compiled]\n  3572\t  (let [admission (:admission-origin compiled)]\n  3573\t    (when-not (vm/occurrence-origin? admission)\n  3574\t      (throw (ex-info \"Oracle binding requires the compilation's retained admission record\"\n  3575\t                      {:rule :cc3-admission-record\n  3576\t                       :admission admission})))\n  3577\t    (let [ast (:compiled-ast compiled)\n  3578\t          token (nth admission 2)\n  3579\t          origin admission\n  3580\t          projected (fn [tree-ast]\n  3581\t                      (encoder/project\n  3582\t                        (encoder/source-envelope :program token [tree-ast])))\n  3583\t          {:keys [tree rows marked eligible]}\n  3584\t          (let [p (projected ast)\n  3585\t                t (first (:yin/batch p))\n  3586\t                r (:yin/frontend-metadata p)]\n  3587\t            {:tree t :rows r\n  3588\t             :marked (into #{}\n  3589\t                           (comp (filter #(= :yang/call-site (nth % 3)))\n  3590\t                                 (map (fn [[o rr pth _ _]] [o rr pth])))\n  3591\t                           r)\n  3592\t             :eligible (into #{}\n  3593\t                             (map (fn [[rr pth]] [origin rr pth]))\n  3594\t                             (vm/application-occurrences t))})\n  3595\t          ;; the POST-transformation tree verified separately (item 5)\n  3596\t          {:keys [stamped-tree stamped-rows stamped-marked stamped-eligible]}\n  3597\t          (let [p (projected (:ast compiled))\n  3598\t                t (first (:yin/batch p))\n  3599\t                r (:yin/frontend-metadata p)]\n  3600\t            {:stamped-tree t :stamped-rows r\n  3601\t             :stamped-marked (into #{}\n  3602\t                                   (comp (filter #(= :yang/call-site (nth % 3)))\n  3603\t                                         (map (fn [[o rr pth _ _]] [o rr pth])))\n  3604\t                                   r)\n  3605\t             :stamped-eligible (into #{}\n  3606\t                                     (map (fn [[rr pth]] [origin rr pth]))\n  3607\t                                     (vm/application-occurrences t))})\n  3608\t          correspondence (cc3-correspond ast (:ast compiled) [] [] {})\n  3609\t          stamped-paths (volatile! {})\n  3610\t          stamped-sites (into {}\n  3611\t                              (comp (filter (fn [[_ node]]\n  3612\t                                              (= :application (:type node))))\n  3613\t                                    (keep (fn [[path node]]\n  3614\t                                            (let [direct (cc3-stamp-site-id\n  3615\t                                                           (second (:operands node)))\n  3616\t                                                  inner (kernel-routed-call? node)\n  3617\t                                                  routed (when inner\n  3618\t                                                           (cc3-stamp-site-id\n  3619\t                                                             (first (:operands inner))))]\n  3620\t                                              (when-let [k (or direct routed)]\n  3621\t                                                (vswap! stamped-paths assoc k path)\n  3622\t                                                (let [pre-path (get correspondence\n  3623\t                                                                    path\n  3624\t                                                                    ::unmapped)]\n  3625\t                                                  (when (= ::unmapped pre-path)\n  3626\t                                                    (throw (ex-info\n  3627\t                                                             \"Stamped site has no pre-stamp correspondence\"\n  3628\t                                                             {:rule :cc3-stamp-correspondence\n  3629\t                                                              :site k\n  3630\t                                                              :stamped-path path})))\n  3631\t                                                  (let [key [origin (:root tree) pre-path]]\n  3632\t                                                    (when-not (contains? marked key)\n  3633\t                                                      (throw (ex-info\n  3634\t                                                               \"Stamped site maps to no validated C1 occurrence\"\n  3635\t                                                               {:rule :cc3-stamp-correspondence\n  3636\t                                                                :site k\n  3637\t                                                                :key key})))\n  3638\t                                                    [k key])))))))\n  3639\t                              (cc3-walk (:ast compiled) [] []))]\n  3640\t      (when (not= (count stamped-sites)\n  3641\t                  (count (into #{} (vals stamped-sites))))\n  3642\t        (throw (ex-info \"Two stamped sites map to one pre-stamp occurrence\"\n  3643\t                        {:rule :cc3-ambiguous-stamp-correspondence\n  3644\t                         :binding stamped-sites})))\n  3645\t      {:origin origin :tree tree :rows rows :marked marked\n  3646\t       :eligible eligible :binding stamped-sites\n  3647\t       :correspondence correspondence\n  3648\t       :stamped-paths @stamped-paths\n  3649\t       :stamped-tree stamped-tree :stamped-rows stamped-rows\n  3650\t       :stamped-marked stamped-marked\n  3651\t       :stamped-eligible stamped-eligible})))\n  3652\t\n  3653\t\n  3654\t(deftest test-cc3-oracle-site-c1-binding\n  3655\t  ;; Bounds for this tagged run are recorded in the cc3 findings'\n  3656\t  ;; PREFLIGHT BOUNDS section before this test was first run:\n  3657\t  ;; 4,000,000 guest instructions and 1,000,000 trace records per C\n  3658\t  ;; lane, restated and not raised.\n  3659\t  (let [fixture {:id :cc3-binding :call '(latte-kernel.utils/vectorn? [1 2 3] 2)}\n  3660\t        compiled (kernel-compile fixture)]\n  3661\t    (is (= :compiled (:status compiled)))\n  3662\t    (let [{:keys [origin tree rows marked eligible binding correspondence\n  3663\t                  stamped-paths stamped-tree stamped-marked stamped-eligible]}\n  3664\t          (cc3-oracle-binding compiled)\n  3665\t          sites (:sites compiled)]\n  3666\t      (testing \"the origin is the retained admission record, not content synthesis\"\n  3667\t        (is (= (:admission-origin compiled) origin)\n  3668\t            \"the binding consumes the coordinate recorded when admitting\")\n  2010\t      (is (nil? (publish/published-instruction-provenance store result))))))\n  2011\t\n  2012\t\n  2013\t(deftest repl-packet-call-provenance-test\n  2014\t  ;; cc3 r2 item 3 (repl lane): provenance is selected by the packet's\n  2015\t  ;; retained admission identity `[admission root]`, never by root\n  2016\t  ;; alone; an admission with no claim for the root yields absence even\n  2017\t  ;; when another admission claimed identical canonical content.\n  2018\t  (let [{:keys [ctx result]} (expand-like-the-repl\n  2019\t                               (yang/compile-program\n  2020\t                                 '[(defn f [x] (+ x 1)) (f 2)]))\n  2021\t        {:keys [status tree frontend-metadata]} result\n  2022\t        packet tree\n  2023\t        admission [:source :program-in (:t ctx) 0]\n  2024\t        other [:source :program-in :other-admission 0]\n  2025\t        state {:expander {:call-site-tables {[admission (first packet)]\n  2026\t                                             frontend-metadata}}}]\n  2027\t    (is (= :ok status))\n  2028\t    (is (seq frontend-metadata) \"precondition: the expansion claimed C1\")\n  2029\t    (let [prov (repl/packet-call-provenance state packet admission)]\n  2030\t      (is (some? prov))\n  2031\t      (is (seq (:semantic prov)))\n  2032\t      (doseq [[_seg _pc o r _p] (:semantic prov)]\n  2033\t        (is (= (first packet) r))\n  2034\t        (is (= admission o))))\n  2035\t    (is (nil? (repl/packet-call-provenance {:expander {}} packet admission))\n  2036\t        \"no retained table: absence, never invention\")\n  2037\t    (testing \"claimed-A / unclaimed-B with an identical root: B gets absence\"\n  2038\t      (is (nil? (repl/packet-call-provenance state packet other))\n  2039\t          \"B never borrows A's table through the shared root\"))\n  2040\t    (testing \"two retained admissions for one root each resolve their own\"\n  2041\t      (let [other-rows (mapv (fn [row] (assoc row 0 other)) frontend-metadata)\n  2042\t            both (assoc-in state [:expander :call-site-tables\n  2043\t                                  [other (first packet)]]\n  2044\t                           other-rows)\n  2045\t            prov-b (repl/packet-call-provenance both packet other)]\n  2046\t        (is (some? prov-b))\n  2047\t        (is (every? (fn [[_seg _pc o _r _p]] (= other o)) (:semantic prov-b)))))\n  2048\t    (testing \"a malformed admission identity refuses\"\n  2049\t      (is (= :call-site-admission\n  2050\t             (failure-rule\n  2051\t               #(repl/packet-call-provenance state packet [:oracle/fixture 1])))))))\n  2052\t\n  2053\t\n  2054\t#?(:clj\n  2055\t   (deftest repl-packet-provenance-durable-test\n  2056\t     ;; cc3 r2 item 4: ordinary REPL loading retains admission-scoped\n  2057\t     ;; provenance in the session's durable store under a lookup handle\n  2058\t     ;; the session state carries; the relation is retrievable from a\n  2059\t     ;; freshly reopened store by that handle alone.\n  2060\t     (let [dir (str \"target/test-cc3-provenance-\" (random-uuid))\n  2061\t           cleanup (fn [] (let [f (java.io.File. dir)]\n  2062\t                            (when (.exists f)\n  2063\t                              (run! #(.delete %) (reverse (file-seq f))))))]\n  2064\t       (try\n  2065\t         (let [state (reduce (fn [s line] (first (repl/eval-input s line)))\n  2066\t                             (repl-frontends/create-state\n  2067\t                               {:index-store-spec {:type :file :dir dir}})\n  2068\t                             [\"(def k (fn [] 1))\"\n  2069\t                              \"(def g (fn [] (+ (k) 41)))\"\n  2070\t                              \"(g)\"])\n  2071\t               handles (repl/call-provenance-handles state)]\n  2072\t           (is (seq handles) \"production loading retained provenance handles\")\n  2073\t           (is (every? (fn [[_k v]] (jing/segment-address? v)) handles))\n  2074\t           (let [[[admission root] handle before]\n  2075\t                 (first (keep (fn [[[a r] h]]\n  2076\t                                (let [rel (repl/retained-packet-call-provenance\n  2077\t                                            (:index-store state) h)]\n  2078\t                                  (when (seq (:semantic rel))\n  2079\t                                    [[a r] h rel])))\n  2080\t                              handles))]\n  2081\t             (is (some? before))\n  2082\t             (is (= root (:root before)))\n  2083\t             (is (= admission (:admission before)))\n  2084\t             (is (seq (:semantic before)))\n  2085\t             (yin.repl.store/close! (:index-store state))\n  2086\t             (let [reopened (yin.repl.store/open {:type :file :dir dir})\n  2087\t                   after (repl/retained-packet-call-provenance reopened handle)]\n  2088\t               (is (= before after)\n  2089\t                   \"retrieval after reopening the store answers the same relation\")\n  2090\t               (yin.repl.store/close! reopened))))\n  2091\t         (finally (cleanup))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The new wrapper-removal traversal fixes the nested-path calculation, and the explicit-admission helper passes the claimed-A/unclaimed-B case by inspection. Two gaps remain: correspondence ignores scalar fields such as callee names and literal values, and the production loader still receives admission identity from a root-keyed round map. I’m checking how that map behaves with queued or multiple packets."}}
