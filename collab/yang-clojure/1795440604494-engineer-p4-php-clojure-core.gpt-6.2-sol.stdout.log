{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3890,3985p;4160,4220p' src/cljc/yang/php/antlr/lower.cljc; rg -n 'defn |run-main|\\\\[php/echo' src/cljc/yang/php/antlr/prelude.cljc | tail -43; rg -n 'php/run-main|php/echo|response-ref|stream/append' src/cljc/yang/php/antlr -g 'prelude*.cljc'; sed -n '1,85p' test/yang/python/antlr/descriptor_profile_test.cljc; sed -n '1,85p' deps.edn; ls -a /Users/sto/workspace/dw-p4ts/build/antlr\"","aggregated_output":"        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\n                (u/lit {})\n                (sort paths))))\n\n\n(defn lower-program\n  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n   `php/run-main` after the prelude, tail calls marked. Its value is\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n   `:warnings` are the lowering's warning-severity diagnostics\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\n   `:yang.php/computed-include-path`).\n\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\n   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\n   need); `:path` the entry unit's declared path (default `entry-path`);\n   `:paths` the normalized paths whose units the composition published,\n   which a computed include resolves against; `:class-map` true requires\n   the published `phpm.$classmap` and binds its classes and delivery thunks\n   (plan P6 R9), which takes the place of `:paths`; `:request-node` is the\n  opaque `run-main` second-operand node the harness composed from the\n  attached request stream (lowering never embeds request data — `run-main`\n  consumes the record from the stream at runtime);\n  `:response-node` and `:diag-node` are the opaque third and fourth\n  operands: the composition-supplied stream references execution emits\n  on. Absent, `run-main` runs with two operands and the cells\n  accumulate.\"\n  ([packet] (lower-program packet {}))\n  ([packet {:keys [prelude paths path class-map request-node response-node diag-node\n                   eval-service? eval-budget?],\n            :or {prelude :bundled}}]\n   (when-not (contains? #{:bundled :linked} prelude)\n     (throw (ex-info \"unknown PHP prelude profile\"\n                     {:yang.php/diagnostic :yang.php/unsupported,\n                      :construct :prelude,\n                      :prelude prelude})))\n   (let [linked? (= :linked prelude)\n         request-node (or request-node (u/sexp->uast :php/null))\n         ctx (context packet {:path (or path entry-path), :linked? linked?\n                              :eval-service? eval-service?})\n         ;; `run-main`'s second operand arrives composed by the harness from\n         ;; the attached request stream: production initialization consumes\n         ;; the record from the stream at runtime and seeds the superglobals,\n         ;; no postwalk rewrite and no request data through lowering involved.\n         ;; With stream nodes `run-main` takes four operands (request,\n         ;; response and diagnostics references); without them it takes two\n         ;; and the cells accumulate.\n         main (if (or response-node diag-node)\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\n                      (or response-node (u/sexp->uast :php/null))\n                      (or diag-node (u/sexp->uast :php/null)))\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))\n         main (if eval-service?\n                (u/seq-nodes\n                  [(app* 'require (u/lit 'eval.compiler))\n                   (app* 'require (u/lit 'code))\n                   (u/let1 '%eval-runtime (eval-runtime-node)\n                           (u/let1 '%eval-hooks\n                                   (reduce (fn [m [k v]] (app* 'assoc m (u/lit k) v))\n                                           (u/lit {})\n                                           [[:loop (if eval-budget? (u/v 'php.sp/loop) (u/lam [] (u/lit :php/null)))]\n                                            [:call (if eval-budget? (u/v 'php.sp/call) (u/lam [] (u/lit :php/null)))]\n                                            [:line (u/v 'php.sp/line)]])\n                                   main))])\n                main)]\n     {:ast (u/mark-tails\n             (if linked?\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\n                                     (app* 'require (u/lit prelude/module-name))\n                                     (app* 'php/init!)]\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\n                                    (when class-map\n                                      [(app* 'require (u/lit classmap-module))\n                                       (app* 'php/bind-class-map!\n                                             (u/v (symbol (str classmap-module) \"classes\"))\n                                             (u/v (symbol (str classmap-module) \"paths\")))])\n                                    [main]))\n               (u/then prelude/uast main))),\n      :warnings @(:warnings ctx)})))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n;; =============================================================================\n\n(def module-exports\n  \"The exports of a compiled PHP unit: its spec and body, immutable after\n   install.\"\n  '#{spec body})\n\n;; =============================================================================\n\n(def program-medium\n  \"The program medium's logical identity when the composition names none.\"\n  :yang.php/program)\n\n\n(defn- stage-config\n  \"The shared stage config; `warned` receives the packet's warnings.\"\n  [warned]\n  {:diagnostic-ns diagnostic-ns,\n   :program-medium program-medium,\n   :ok? #(= :yang.cst/ok (:yang.cst/outcome %)),\n   :lower (fn [state packet]\n            (let [{:keys [ast warnings]}\n                  (lower-program packet (select-keys state option-keys))]\n              (reset! warned warnings)\n              ast)),\n   :option-keys option-keys})\n\n\n(defn lower-transform\n  \"The lowering stage's transform (`yang.core.stage/lower-transform`):\n   an ok packet is one program batch, then one record on port `:diagnostics`\n   per warning (`:severity :warning`); a refusal is a diagnostic and no\n   program. Stateless.\"\n  [state packet]\n  (let [warned (atom [])\n        [state' outputs] (core-stage/lower-transform (stage-config warned) state packet)]\n    [state'\n     (into outputs\n           (map (fn [w] [:diagnostics (assoc w :yang.cst/unit (:yang.cst/unit packet))]))\n           @warned)]))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. The fourth argument may instead be\n   an options map `{:medium :prelude}`.\"\n  ([cst-stream program-stream diagnostics-stream]\n   (core-stage/open-stage (stage-config (atom [])) cst-stream program-stream diagnostics-stream))\n  ([cst-stream program-stream diagnostics-stream medium-or-opts]\n   (core-stage/open-stage (stage-config (atom []))\n                          cst-stream\n                          program-stream\n                          diagnostics-stream\n                          medium-or-opts)))\n\n\n(defn step-stage\n  [s]\n  (stage/step s lower-transform))\n65:   reach the unit root, `php/run-main`, which answers output, response and\n346:     ;; run-main receive