uild, and defaults to a fresh in-memory store.\nsrc/cljc/yin/repl.cljc:1128:   (yin.repl.store): `:mem` — the default, today's behaviour — or\nsrc/cljc/yin/repl.cljc:1181:   steps it; nil, the default, is today's behaviour.\nsrc/cljc/yin/repl.cljc:1189:   (`:yang/python`) or by `[id revision]`; a language keyword is not a\nsrc/cljc/yin/repl.cljc:1190:   selector. The default is the `:yang/clojure` frontend.\nsrc/cljc/yin/repl.cljc:1429:   render hook and the default result formatting are host code\nsrc/cljc/yin/repl.cljc:1599:      (catch #?(:cljd Object :clj Exception :cljs :default) _\nsrc/cljc/yin/repl.cljc:1733:                                         :cljs :default) error\nsrc/cljc/yin/repl.cljc:2062:   reason defaulting to `:yin.repl/link-policy`; a throw or a return\nsrc/cljc/yin/repl.cljc:2626:                     (catch #?(:cljd Object :clj Throwable :cljs :default) error\nsrc/cljc/yin/repl.cljc:2628:                            (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))\nsrc/cljc/yin/repl.cljc:2631:             (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))\nsrc/cljc/yin/repl.cljc:2633:      (catch #?(:cljd Object :clj Throwable :cljs :default) error\nsrc/cljc/yin/repl.cljc:2667:    (catch #?(:cljd Object :clj Exception :cljs :default) e\n20:(def include-path-text\n27:(def include-kinds\n32:(defquoted ^:private module-forms\n429:(def definitions\nsrc/cljc/yang/php/antlr/prelude.cljc:65:   reach the unit root, `php/run-main`, which answers output, response and\nsrc/cljc/yang/php/antlr/prelude.cljc:111:           stream/put! stream/cursor stream/poll!}\nsrc/cljc/yang/php/antlr/prelude.cljc:346:     ;; run-main received one, else onto the diag cell.\nsrc/cljc/yang/php/antlr/prelude.cljc:354:             (do (stream/put! h rec) :php/null)))))]\nsrc/cljc/yang/php/antlr/prelude.cljc:503:     ;; the request record `run-main` binds: a plain record binds directly,\nsrc/cljc/yang/php/antlr/prelude.cljc:513:           (let [v (stream/poll! (stream/cursor request))]\nsrc/cljc/yang/php/antlr/prelude.cljc:514:             (if (= v :dao.stream/blocked) :php/null v))\nsrc/cljc/yang/php/antlr/prelude.cljc:518:     ;; response stream DURING execution when run-main received one, else\nsrc/cljc/yang/php/antlr/prelude.cljc:524:           (do (stream/put! h record) :php/null))))]\nsrc/cljc/yang/php/antlr/prelude.cljc:526:     ;; poll `cur` to `:dao.stream/blocked`, accumulating the records in\nsrc/cljc/yang/php/antlr/prelude.cljc:529:       (let [v (stream/poll! cur)]\nsrc/cljc/yang/php/antlr/prelude.cljc:530:         (if (= v :dao.stream/blocked)\nsrc/cljc/yang/php/antlr/prelude.cljc:537:       (php/drain-loop (stream/cursor ref) []))]\nsrc/cljc/yang/php/antlr/prelude.cljc:839:     ;; run-main still runs shutdown functions, drains buffers and marks\nsrc/cljc/yang/php/antlr/prelude.cljc:4564:     ;; of unclosed buffers runs on the run-main exit path, outside the\nsrc/cljc/yang/php/antlr/prelude.cljc:5856:    [php/run-main\nsrc/cljc/yang/php/antlr/prelude.cljc:5919:                                      (stream/put! hs body-rec))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/php/antlr/{portable_harness,linked_harness}.cljc; rg -n 'test:(clj|cljs|cljd|jolt)|php|antlr' bb.edn | head -100; export MISE_TRUSTED_CONFIG_PATHS=\\\"\"'$PWD\"; eval \"$(mise env)\"; command -v clj bb node php dart jolt; ls -d lib build node_modules'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat test/yang/php/antlr/{portable_harness,linked_harness}.cljc; rg -n 'test:(clj|cljs|cljd|jolt)|php|antlr' bb.edn | head -100; export MISE_TRUSTED_CONFIG_PATHS=\\\"\"'$PWD\"; eval \"$(mise env)\"; command -v clj bb node php dart jolt; ls -d lib build node_modules'","aggregated_output":"(ns yang.php.antlr.portable-harness\n  \"What the JVM, Node and Dart lanes share: the host composition the PHP\n   profile runs over, the `packet` helper that builds a CST packet from a\n   nested form, and a parserless run of a packet on the AST walker.\"\n  (:require\n    [dao.stream :as stream]\n    [dao.stream.memory-log :as memory-log]\n    [dao.stream.ringbuffer :as ringbuffer]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]\n    [yin.vm.ast-walker :as ast-walker]\n    [yin.vm.engine :as engine]\n    [yin.vm.data :as data]\n    [yin.vm.integer :as integer]\n    [yin.vm.module :as module]))\n\n\n(def ^:private capability-secret \"yin.vm.test-utils/capability-secret\")\n\n\n(defn make-stream\n  \"The composition's stream constructor: a deterministic ring buffer, answering\n   the create outcome the engine consumes. The lifecycle streams below come\n   from this same constructor, so request consumption and response/diagnostic\n   emission travel composition-supplied streams rather than vectors.\"\n  ([] (make-stream nil))\n  ([capacity]\n   (ringbuffer/create!\n     {:dao.stream/type ringbuffer/transport-type,\n      ringbuffer/capacity-key (or capacity vm/default-stream-capacity)})))\n\n\n(defn- check-ok!\n  [result what]\n  (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n    (throw (ex-info (str \"PHP lifecycle stream failed: \" what) {:result result})))\n  result)\n\n\n(defn- lifecycle-stream\n  \"One open lifecycle stream handle from the composition's own constructor.\"\n  [what]\n  (:dao.stream/handle (check-ok! (make-stream) what)))\n\n\n(defn create-vm\n  \"An AST walker composed with the harness's deterministic ring-buffer stream.\"\n  ([] (create-vm {}))\n  ([opts]\n   (ast-walker/create-vm\n     (merge {:make-stream (fn [capacity] (make-stream capacity)),\n             :capability-secret capability-secret}\n            opts))))\n\n\n(defn- new-memory-log\n  []\n  (let [result (memory-log/create! {:dao.stream/type memory-log/transport-type})]\n    (if (= :dao.stream/ok (:dao.stream/outcome result))\n      (:dao.stream/handle result)\n      (throw (ex-info \"PHP harness memory-log creation failed\" {:result result})))))\n\n\n(defn- drain\n  [handle]\n  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\n                      [:dao.stream/cursor])]\n    (loop [cursor start, acc []]\n      (let [result (stream/next handle cursor)]\n        (if (= :dao.stream/ok (:dao.stream/outcome result))\n          (recur (:dao.stream/cursor result)\n                 (conj acc (:dao.stream/value result)))\n          acc)))))\n\n\n(def integer-limits\n  \"The `integer` limits the PHP compositions here install.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(def data-limits {::data/max-items 1048576})\n\n\n(defn host-registry\n  \"The registry with the cell, data, integer and stream modules installed,\n   admitted by the PHP profile. The stream module is what lets execution\n   emit response and diagnostic records on composition-supplied streams\n   during the run.\"\n  []\n  (-> (module/empty-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      module/register-stream-module\n      prelude/admit))\n\n\n(defn linked-registry\n  \"`host-registry` over the default registry, whose `require` handlers the\n   linked profile needs.\"\n  []\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      module/register-stream-module\n      prelude/admit))\n\n\n(defn packet\n  \"A CST packet from a nested form: `[rule child ...]` for a rule (a keyword)\n   and `[type text]` (type a string) for a token. Spans are zero-width: the\n   lowering reads them only for diagnostics. Ids are preorder, as the parser\n   numbers them, so generated names match a parsed packet's.\"\n  [form]\n  (let [out (volatile! [])]\n    (letfn [(walk\n              [f]\n              (let [id (count @out)]\n                (if (string? (first f))\n                  (vswap! out conj {:id id, :kind :token, :type (first f),\n                                    :text (second f), :span [0 0]})\n                  (do (vswap! out conj nil)\n                      (let [kids (mapv walk (rest f))]\n                        (vswap! out assoc id {:id id, :kind :rule,\n                                              :rule (name (first f)),\n                                              :children kids, :span [0 0]}))))\n                id))]\n      (walk form))\n    {:yang.cst/version 1,\n     :yang.cst/unit [:hand 0],\n     :yang.cst/grammar \"hand\",\n     :yang.cst/outcome :yang.cst/ok,\n     :yang.cst/root 0,\n     :yang.cst/nodes @out,\n     :yang.cst/complete true}))\n\n\n(defn render\n  \"The text a unit prints (ASCII here: the carrier is the text), then, for an\n   uncaught error, the fatal line (no path).\"\n  [{:php/keys [out uncaught fatal]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n       (when fatal\n         (str \"PHP Fatal error:  \" fatal))))\n\n\n(defn operand-node\n  \"A `run-main` operand node the composition supplies: the harness converts\n   the opaque reference (a request-stream, response-stream or diagnostics\n   reference) to UAST itself — lowering never embeds composition data, and\n   request records never travel as compiled UAST content.\"\n  [value]\n  (u/sexp->uast (or value :php/null)))\n\n\n(def request-node\n  \"The `run-main` second-operand node the composition supplies: the attached\n   request-stream reference (or nil for the empty defaults). The record is\n   consumed from the stream at runtime, never embedded in the program.\"\n  operand-node)\n\n\n(defn lower-through-stage\n  \"`{:ast a :warnings w}` or `{:diagnostics d}` for `pk` through the lowering\n   stage. Warning-severity diagnostics do not stop the program. `request-ref`\n   is the attached request-stream reference the harness composed as\n   `run-main`'s second operand — lowering itself never sees request data, and\n   the record reaches the runtime only through the stream at execution time.\n   With `response-ref`/`diag-ref`, the composition-supplied stream references\n   execution emits on during the run ride as the third and fourth operands.\"\n  ([pk] (lower-through-stage pk nil nil nil))\n  ([pk request-ref] (lower-through-stage pk request-ref nil nil))\n  ([pk request-ref response-ref diag-ref]\n   (let [cst-log (new-memory-log)\n         program (new-memory-log)\n         diagnostics (new-memory-log)]\n     (stream/append! cst-log pk)\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                         (cond-> {:medium lower/program-medium}\n                                           (some? request-ref) (assoc :request-node\n                                                                      (operand-node request-ref))\n                                           (some? response-ref) (assoc :response-node\n                                                                       (operand-node response-ref))\n                                           (some? diag-ref) (assoc :diag-node\n                                                                   (operand-node diag-ref)))))\n     (let [{warnings true, problems false}\n           (group-by #(= :warning (:severity %)) (drain diagnostics))]\n       (if (seq problems)\n         {:diagnostics problems}\n         (let [{:yin/keys [batch root]} (first (drain program))]\n           {:ast (nth batch root), :warnings (vec warnings)}))))))\n\n\n(defn- attach-request-stream\n  \"The composition-supplied request stream carrying `request`, attached under\n   the VM's capability secret, answering `[request-ref vm]`. The sealed\n   reference — never the record — is what the program composes; `run-main`\n   consumes the record from the stream at runtime.\"\n  [vm request]\n  (let [request-stream (lifecycle-stream \"request create\")]\n    (check-ok! (stream/append! request-stream request) \"request append\")\n    (engine/attach-resource vm request-stream)))\n\n\n(defn run-packet-raw\n  \"The unit's value, `{:php/out :php/diag :php/uncaught}`, of packet `pk` on\n   the AST walker, or `{:diagnostics d}`. A request rides the attached\n   request stream (consumed at runtime), never the compiled program.\"\n  ([pk] (run-packet-raw pk nil))\n  ([pk request]\n   (let [vm (create-vm {:modules (host-registry)})\n         [request-ref vm] (if (some? request)\n                            (attach-request-stream vm request)\n                            [nil vm])\n         {:keys [ast diagnostics]} (lower-through-stage pk request-ref)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (vm/value (vm/eval vm ast))))))\n\n\n(defn- attach-lifecycle-streams\n  \"The AST walker VM with the composition-supplied `request-stream`,\n   `response-stream` and `diagnostics-stream` handles attached under its\n   capability secret, answering `[vm request-ref response-ref diag-ref]`\n   (a nil request keeps the empty defaults and composes no reference): the\n   sealed references the program consumes and emits on DURING execution.\"\n  [request response-stream diagnostics-stream]\n  (let [vm (create-vm {:modules (host-registry)})\n        [request-ref vm] (if (some? request)\n                           (attach-request-stream vm request)\n                           [nil vm])\n        [response-ref vm] (engine/attach-resource vm response-stream)\n        [diag-ref vm] (engine/attach-resource vm diagnostics-stream)]\n    [vm request-ref response-ref diag-ref]))\n\n\n(defn run-lifecycle-raw\n  \"The full request/response/diagnostics lifecycle for packet `pk` over\n   composition-supplied streams: `request` (nil keeps the empty defaults) is\n   appended to the request stream; the attached stream reference rides the\n   composition path as `run-main`'s second operand, and the\n   response/diagnostics stream references ride as its third and fourth\n   operands. `run-main` consumes the request record from the stream at\n   runtime — the record never enters the compiled program. Execution emits\n   response and diagnostic records onto those streams DURING the run (never\n   copied after completion); the runtime no longer appends to cells on this\n   path. Returns\n   `{:value v :request request :response [...] :diag [...]}`, the drained\n   streams, or `{:diagnostics d}` when lowering refuses.\"\n  [pk request]\n  (let [response-stream (lifecycle-stream \"response create\")\n        diagnostics-stream (lifecycle-stream \"diagnostics create\")\n        [vm request-ref response-ref diag-ref]\n        (attach-lifecycle-streams request response-stream diagnostics-stream)\n        {:keys [ast diagnostics]} (lower-through-stage pk request-ref response-ref diag-ref)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [v (vm/value (vm/eval vm ast))]\n        {:value v,\n         :request request,\n         :response (drain response-stream),\n         :diag (drain diagnostics-stream)}))))\n\n\n(defn run-packet\n  \"The rendered output of packet `pk` on the AST walker, or its diagnostics.\"\n  [pk]\n  (let [r (run-packet-raw pk)]\n    (if (:diagnostics r) r (render r))))\n(ns yang.php.antlr.linked-harness\n  \"The linked profile's composition for the PHP tests (P6, docs/design/\n   yang.php.md section 11): the namespace that requires this is the\n   publisher of `php`, so it publishes the module once per process into one\n   in-memory content store, publishes a fixture's non-entry units beside it\n   bottom-up, and serves them to the entry unit's run over a\n   `yin.vm.linker.interpreter` composition under `:trusted` derivation.\n\n   A linked run builds the entry unit's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately until\n   the VM stops blocking, as the REPL's drive does. The AST walker is not a\n   backend here: its link of `php` is refused until L-b.\"\n  (:require\n    [dao.jing.mem :as mem]\n    [yang.core.call :as call]\n    [yang.core.module :as core-module]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yang.php.antlr.prelude :as prelude]\n    [yang.php.antlr.publication :as publication]\n    [yang.php.antlr.safepoint :as safepoint]\n    [yang.php.antlr.siteset :as siteset]\n    [yang.safepoint :as sp]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.linker.interpreter :as link]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.linker.sign :as sign]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn registry\n  \"The host registry a linked PHP composition registers: the `require`\n   handlers, then `cell`, `data` and `integer` under the portable limits.\"\n  []\n  (portable/linked-registry))\n\n\n(defn make-published\n  \"Create a store with the linked runtime and its hook module.\"\n  []\n  (let [store (mem/create-content-mem)\n        call-result (publish/publish-module! store (call/module-spec (registry)))\n        result (publish/publish-module! store (prelude/module-spec (registry)\n                                                                   (:address call-result)))\n        hook (publish/publish-module! store (safepoint/module-spec (registry) (:address result)))]\n    {:store store,\n     :hook-address (:address hook),\n     :result result,\n     :address (:address result),\n     :call-address (:address call-result)}))\n\n\n(def published\n  \"`yang.call` and `php` published once into their own content store.\"\n  (delay (make-published)))\n\n\n(defn publish-units!\n  \"`units` (`[{:name path :packet p :strict-types b}]`) published into\n   `php`'s own content store, where its pinned requirement already lives:\n   `publication/publish-units!`'s answer.\"\n  [units]\n  (publication/publish-units! (:store @published) (registry) (:address @published) units))\n\n\n(defn source\n  \"The linked store and signed site publications for this fixture.\"\n  ([name-env] (source name-env nil))\n  ([name-env result]\n   (let [publisher (sign/generate)\n         entries (siteset/signed-entries publisher (:sites result)\n                                         (:addresses result) (:bundles result))\n         datoms (siteset/entry-datoms entries)\n         stage (siteset/stage (registry)\n                              {:hooks true, :hooks-profile safepoint/ticks-profile,\n                               :php-sp (:hook-address @published)} {})]\n     (link/composition\n       {:content-store (:store @published),\n        :name-env (merge {'php (:address @published),\n                          'php.sp (:hook-address @published),\n                          'yang.call (:call-address @published)} name-env),\n        :derivation :trusted,\n        :stage (fn [ctx name address]\n                 (stage (assoc ctx :datoms datoms :principals [(:public publisher)])\n                        name address))}))))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task stops\n   blocking, at most 80 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 80))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`, served from\n   `src`. A refused link surfaces as the program's own diagnostics.\"\n  [backend ast src]\n  (let [pair (link/make-pair)\n        task ((get backends backend) ast (composition (registry) pair))]\n    (first (drive task pair src))))\n\n\n(defn name-env\n  \"The name environment naming every published module of `result`\n   (`publish-units!`'s answer): module symbol to address.\"\n  [result]\n  (merge (into {} (map (fn [[path address]] [(lower/path-module-symbol path) address]))\n               (:addresses result))\n         (:bundles result)))\n\n\n(defn run-fixture\n  \"`{backend value}` for the multi-unit fixture `units` (`{path packet}`,\n   the entry unit `main`, default `lower/entry-path`) on the three vector\n   VMs: the non-entry units are published bottom-up, the entry unit\n   lowered `:linked` and run. `value` is `run-main`'s map.\"\n  ([units] (run-fixture units lower/entry-path {}))\n  ([units main opts]\n   (let [entry (get units main)\n         others (cond-> (mapv (fn [[path packet]] {:name path, :packet packet})\n                              (dissoc units main))\n                  (:class-map opts) (conj (assoc (:class-map opts) :name lower/classmap-name)))\n         result (publish-units! others)]\n     (when-not (= :ok (:status result))\n       (throw (ex-info \"fixture units failed to publish\" {:result result})))\n     (let [{:keys [ast warnings]}\n           (lower/lower-program entry\n                                (cond-> (merge {:prelude :linked,\n                                                :path main,\n                                                :paths (when (:computed? opts) (keys (:addresses result)))}\n                                               (dissoc opts :computed? :src :request))\n                                  (:class-map opts) (assoc :class-map true)\n                                  (some? (:request opts)) (assoc :request-node\n                                                                 (portable/request-node (:request opts)))))\n           src (or (:src opts) (source (name-env result) result))\n           sites (:set (siteset/site-set-of ast))\n           tree (vm/ast->semantic-bytecode ast)\n           ast (u/seq-nodes [(core-module/require-node 'yang.call)\n                             (core-module/require-node 'php)\n                             (core-module/require-node 'php.sp)\n                             (vm/semantic-bytecode->ast\n                               (:tree (sp/insert tree (into {} sites) safepoint/ticks-profile)))])]\n       {:warnings warnings,\n        :values (into {}\n                      (map (fn [k] [k (vm/value (run-linked k ast src))]))\n                      (keys backends))}))))\n2: {gen:antlr\n3:  {:doc \"Generate the pinned grammars-v4 parsers for every target (antlr/*/manifest.edn): Java compiled into build/antlr/<g>/classes, JavaScript in build/antlr/<g>/js, Dart in lib/antlr/<g>; filters after --: --grammar g --target t\"\n5:                \"antlr\" *command-line-args*)}\n21:  test:jolt-bootstrap-neg\n27:  {:doc \"J0a baseline smoke under jolt -Srepro -M:jolt: tracked load of yang.antlr.export/packet and defcfn :blocking calls (needs bb bootstrap:jolt; Lane B: --target chez|gambit, the child reports jolt-target and the driver asserts it fail-closed — the gambit child runs the same smoke form under $JOLT_GAMBIT)\"\n58:  test:jolt-j5\n130:  test:jolt-host\n158:  test:jolt-shell\n163:  test:jolt-core\n168:  test:jolt-core:diag\n169:  {:doc \"J2 DIAGNOSTIC: test:jolt-core with the :jolt-diag alias added (the J1 corpus-loader stand-in for dao.jing.cbor-fixtures)\"\n173:  test:jolt-j2-jvm\n178:  test:jolt-j2-manifest\n188:  test:jolt-carrier\n199:  test:jolt-cbor-override\n204:  test:jolt-cbor-override-self-test\n209:  test:jolt-cbor-parity\n221:  test:jolt-text-perf\n233:  test:jolt-host-diag\n239:  test:jolt-json\n245:  test:jolt-runner-self\n266:   ;; The Node lanes (test:cljs and its variants) depend on this task, so the\n268:   :depends [deps:npm gen:antlr]\n277:   :depends [gen:antlr]\n284:   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n285:   ;; `bb test:cljs` without it skips those tests with a printed notice\n293:   ;; The demo pulls in yang.python.antlr.parser, whose JavaScript\n294:   ;; recognizers live in build/antlr/python3/js (a :cljs classpath root),\n296:   :depends [deps:npm gen:antlr]\n300:  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n301:            :depends [build:yin-repl-node gen:antlr]\n308:  test:cljs {:doc \"No