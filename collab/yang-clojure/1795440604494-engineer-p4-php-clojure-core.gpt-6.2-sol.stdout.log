                     [main]))\n               (u/then prelude/uast main))),\n      :warnings @(:warnings ctx)})))))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n;; =============================================================================\n\n(def module-exports\n    [impl-render-at\n     (fn [xs i n out map-entries?]\n       (if (< i n)\n         (let [x (data/nth xs i)\n               shown (if map-entries?\n                       (data/str-concat (impl-render (data/nth x 0) true) \" \"\n                                        (impl-render (data/nth x 1) true))\n                       (impl-render x true))]\n           (impl-render-at xs (+ i 1) n\n             (data/str-concat out (if (= i 0) \"\" (if map-entries? \", \" \" \")) shown)\n             map-entries?))\n         out))]\n    [impl-render-coll\n     (fn [xs open close map-entries?]\n       (let [v (impl-vec xs)]\n         (data/str-concat (impl-render-at v 0 (data/count v) open map-entries?) close)))]\n    [impl-render\n     (fn [x nested?]\n       (if (nil? x) (if nested? \"nil\" \"\")\n         (if (integer/integer? x) (impl-int-result (integer/format x))\n           (if (data/float64? x) (float/format x)\n             (if (kind/keyword? x) (data/str-concat \":\" (impl-named x))\n               (if (kind/symbol? x) (impl-named x)\n                 (if (impl-cell-ref? x) \"#<fn>\"\n                   (if (data/string? x)\n                     (if nested?\n                       (let [cs (data/str->code-points x)]\nsrc/cljc/yang/frontend.cljc:7:   never changes its argument, so an in-flight request that pinned a\nLoading initial Timbre config from: :default\nLoading initial Timbre config from: :