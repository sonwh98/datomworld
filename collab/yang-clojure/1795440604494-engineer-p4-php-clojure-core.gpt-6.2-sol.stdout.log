/diag-stream)]\n                     (php/pair (php/response-view (if (= h :php/null)\n                                                    (cell/get php.rt/response)\n                                                    (php/drain-stream h))\n                                                  0 [])\n                               (if (= dh :php/null)\n                                 (cell/get php.rt/diag)\n                                 (php/drain-stream dh)))))\n                 result (fn [exc]\n                          (let [out (data/str-join \"\" (get (cell/get php.rt/out) 0))]\n                            (do (if (= out \"\")\n                                  :php/null\n                                  ;; the body record joins the task's\n                                  ;; emissions before the read: appended to\n                                  ;; the stream when present, else conjoined\n                                  ;; onto the accumulated cells.\n                                  (let [body-rec (assoc {} :php.response/body out)\n                                        hs (cell/get php.rt/response-stream)]\n                                    (if (= hs :php/null)\n                                      (cell/set! php.rt/response\n                                                 (php/vconj (cell/get php.rt/response) body-rec))\n                                      (stream/put! hs body-rec))))\n                                (let [recs (response-records)\n                                      response (get recs 0)\n                                      diag (get recs 1)]\n                                  (assoc (assoc (assoc (assoc {} :php/out out)\n                                                       :php/diag diag)\n                                                :php/uncaught\n                                                (if (= exc :php/null) nil (php/snapshot-exc exc)))\n                                         :php/response response)))))\n                 fatal (fn [message] (assoc (result :php/null) :php/fatal message))\n                 v (php/call-terminal\n                     (fn [fesc]\n    (into (set (second form)) (mapcat binder-symbols) (drop 2 form))\n    (and (seq? form) (= 'let (first form)))\n    (into (set (take-nth 2 (second form)))\n          (mapcat binder-symbols)\n          (concat (take-nth 2 (rest (second form))) (drop 2 form)))\n    (coll? form) (into #{} (mapcat binder-symbols) (seq form))\n    :else #{}))\n\n\n(defn- unshadow\n  \"`form` with every local binder named like a module export renamed (`h` to\n   `h%l`): the module emitter strips `php/h` to the bare `h`, which a local\n   `h` would otherwise capture. Globals are qualified before stripping, so\n   every bare occurrence is the local.\"\n  [exports [k form]]\n  (let [clash (set (filter exports (binder-symbols form)))]\n    [k\n     (if (empty? clash)\n       form\n       (walk/postwalk (fn [x] (if (contains? clash x) (symbol (str x \"%l\")) x)) form))]))\n\n\n(def ^:private module-definitions\n  (core/module-definitions\n    \"php\" :php/uninit runtime-keys\n    (mapv (partial unshadow (into #{} (map (fn [[k _]] (strip k))) definitions)) definitions)))\n\n\n(def module-uast\n  \"The module tree: one application whose operands are the definitions, in\n   order. Defining runs nothing.\"\n  (core/module-tree module-definitions []))\n\n\n(def module-exports\n  \"The module's exports: every `php/` key of the definition list, stripped.\"\n  (core/exports \"php\" definitions))\n\n\n(def free-names core/free-names)\n\n\n(def defined-keys core/defined-keys)\n\n\n(def ^:private module-free-names\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `php` over\n   the host registry `registry`, requiring the pinned `yang.call` revision\n   at `call-address`; a free name nothing supplies is refused before\n   anything is published. This namespace emits; it never publishes.\"\n  [registry call-address]\n  (prelude-admission/module-spec\n    {:module-name module-name,\n     :ast module-uast,\n     :exports module-exports,\n     :requires {call/module-name call-address},\n     :free-names module-free-names,\n     :skip? #(= \"yang.call\" (namespace %)),\n     :registry registry,\n     :message \"the php module reads an undeclared name\",\n     :refusal-ns \"yang.php\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: the exact float\n   expansion `m * 5^k` needs about 2200 bits.\"\n  4096)\n\n\n(def min-integer-digits\n  \"The smallest `::integer/max-digits` this profile admits: the exact float\n   expansion has up to about 770 digits.\"\n  1000)\n\n\n(defn register-integer-module\n  \"Return `registry` with the `integer` module installed under `limits`,\n   refused when they are under this profile's minimum.\"\n  [registry limits]\n  (let [b (::integer/max-bits limits)\n        d (::integer/max-digits limits)]\n    (when-not (and (int? b) (<= min-integer-bits b) (int? d) (<= min-integer-digits d))\n      (throw (ex-info \"the PHP profile needs integer max-bits >= 4096 and max-digits >= 1000\"\n                      {:yang.php/refusal :yang.php/limits,\n                       ::integer/max-bits b,\n                       ::integer/max-digits d}))))\n  (integer/register-integer-module registry limits))\n\n\n(defn admit\n  \"Return `registry` when it supplies every one of `host-names`, else refuse\n   it before any program runs, naming each missing export in\n   `:yang.php/missing`.\"\n  [registry]\n  (prelude-admission/admit registry host-names\n                           \"the composition lacks host names the prelude calls\"\n                           \"yang.php\"))\n       vec))\n\n\n(defn select\n  \"Select an installed frontend by `request`: `:yang.frontend/id`, and\n   optionally `:yang.frontend/revision` and any other manifest key\n   section 3.7 pins (SPI, language, grammar, profiles). Answers\n   `{:status :ok, :manifest m, :binding b}`, or a refusal:\n   `:yang.frontend/unknown` when no revision of the id (or the named\n   revision) is installed, `:yang.frontend/incompatible` when installed\n   candidates exist but none matches the pins, and\n   `:yang.frontend/ambiguous` with the matching `:revisions` when more\n   than one matches. An id-only request can use the composition’s\n   :yang.frontend/preferred [id revision] when it matches.\"\n  [catalog request]\n  (let [id (:yang.frontend/id request)\n        revision (:yang.frontend/revision request)\n        pins (dissoc request :yang.frontend/id :yang.frontend/revision)\n        candidates (cond->> (revisions catalog id)\n                     revision (filter #{revision}))\n        matching (filter (fn [r]\n                           (let [m (get-in catalog\n                                           [:yang.frontend/entries [id r]\n                                            :manifest])]\n                             (= pins (select-keys m (keys pins)))))\n                         candidates)\n        [preferred-id preferred-revision] (:yang.frontend/preferred catalog)\n        preferred (when (and (nil? revision) (empty? pins) (= id preferred-id)\n                             (some #{preferred-revision} matching))\n                    preferred-revision)]\n    (cond (empty? candidates)\n          (refused :yang.frontend/unknown {:id id, :revision revision})\n          (empty? matching)\n          (refused :yang.frontend/incompatible\n                   {:id id, :revisions (vec candidates), :pins pins})\n          (and (nil? preferred) (next matching))\n          (refused :yang.frontend/ambiguous {:id id, :revisions (vec matching)})\n          :else (let [k [id (or preferred (first matching))]]\n                  (merge {:status :ok}\n                         (get-in catalog [:yang.frontend/entries k]))))))\n12:(def module-name 'clojure.core.impl)\n15:(def ^:private helpers\n253:(def ^:private operations\n359:(defn- arity-error [name]\n365:(defn- operation-body [[name & arities]]\n379:(defn- bounded-body [name max-arity form]\n384:(def ^:private entries\n429:(defn callable-entry [name]\n433:(def public-names (mapv first entries))\n436:(def ^:private definitions\n445:(def module-exports\n449:(defn bundled-uast\n470:(def module-uast\n477:(def ^:private free-names (core/free-name-vec module-uast))\n480:(defn module-spec [registry call-address clj-address int-address]\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '274,339p;640,705p;812,839p;1088,1100p;1613,1661p;1820,1895p;2175,2223p;2819,2878p;3020,3130p' src/cljc/yang/php/antlr/lower.cljc; sed -n '1,115p' src/cljc/yang/core/stage.cljc; rg -n 'defn.*ambient|entry-lowering|:descriptor' src/cljc/yang/python/antlr/lower.cljc | tail -30\"","aggregated_output":"(def ^:private app* core/app*)\n\n\n(def ^:private max-safe-int 9007199254740991)\n\n\n(defn- int-literal\n  \"The node of an integer token with `digits` in `radix`: a native literal up\n   to 2^53 - 1, otherwise an application of `php/int-lit` (decimal) or\n   `php/int-lit-radix`, which the AST can carry on every host and which\n   demote to float past PHP_INT_MAX.\"\n  [digits radix]\n  (let [c (count digits)]\n    (if (and (= 10 radix) (> c 19))\n      (app* 'php/int-lit (u/lit digits))\n      (let [m (integer/integer-module {::integer/max-bits (* 4 (max c 1)),\n                                       ::integer/max-digits (max c 1)})\n            v ((get m 'parse) digits radix)]\n        (if (<= ((get m 'compare) v max-safe-int) 0)\n          (u/lit v)\n          (if (= 10 radix)\n            (app* 'php/int-lit (u/lit digits))\n            (app* 'php/int-lit-radix (u/lit digits) (u/lit radix))))))))\n\n\n(defn- numeric-constant\n  [ctx n]\n  (let [t (first (core/kids ctx n))\n        text (str/replace (:text t) \"_\" \"\")]\n    (case (:type t)\n      \"Decimal\" (int-literal text 10)\n      \"Hex\" (int-literal (subs text 2) 16)\n      \"Binary\" (int-literal (subs text 2) 2)\n      \"Octal\" (int-literal (if (re-find #\"^0[oO]\" text) (subs text 2) (subs text 1)) 8))))\n\n\n(defn- float-literal\n  [text]\n  (let [t (str/replace text \"_\" \"\")]\n    (u/lit (cbor/float64 #?(:cljd (double/parse t)\n                            :clj (Double/parseDouble t)\n                            :cljs (js/parseFloat t))))))\n\n\n(declare leftmost-token-text line-of qname-parts