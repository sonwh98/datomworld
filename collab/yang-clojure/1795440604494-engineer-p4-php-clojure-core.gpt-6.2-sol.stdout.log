(assoc ctx :ticks (atom ticks)) ctx)\n        _ (when (and (some? ticks) (or (nil? body) semicolon?)) (reset! (:ticks ctx) ticks))]\n    (u/then (if (some? strict) (app* 'php/set-strict! (u/lit (boolean strict))) (u/lit :php/null))\n            (if body (lower body-ctx body) (u/lit :php/null)))))\n\n\n(defn- lower-class\n  \"A class declared in place (nested or conditional): declared when reached.\"\n  [ctx n]\n  (let [[_ spec] (class-spec ctx n)]\n    (u/then (app* 'php/declare-class! spec) (u/lit :php/null))))\n\n\n(defn- lower\n  \"The node of CST rule node `n`.\"\n  [ctx n]\n  (case (:rule n)\n    \"inlineHtml\" (html-node ctx n)\n    \"phpBlock\" (sequence-node (block-nodes ctx n))\n    (\"topStatement\" \"innerStatement\" \"statement\" \"namespaceStatement\")\n    (let [child (first (core/rule-kids ctx n))\n          node (lower ctx child)]\n      (if (and (= \"statement\" (:rule n)) (p/rule? child \"yieldExpression\") (pos? @(:ticks ctx)))\n        (core/site [:line (:id n) {:unit (get-in ctx [:unit :path]), :ticks @(:ticks ctx)}] node)\n        node))\n    \"globalConstantDeclaration\" (lower-const ctx n)\n    \"echoStatement\" (let [node (with-temps ctx n\n                                 (sequence-node (echo-nodes ctx (first (core/rules ctx n \"expressionList\")))))]\n                      (if (pos? @(:ticks ctx))\n                        (core/site [:line (:id n) {:unit (get-in ctx [:unit :path]), :ticks @(:ticks ctx)}] node)\n                        node))\n    \"expressionStatement\" (let [node (with-temps ctx n (lower ctx (first (core/rules ctx n \"expression\"))))]\n                            (if (pos? @(:ticks ctx))\n                              (core/site [:line (:id n) {:unit (get-in ctx [:unit :path]), :ticks @(:ticks ctx)}] node)\n                              node))\n    \"emptyStatement_\" (u/lit :php/null)\n    \"inlineHtmlStatement\" (sequence-node (block-nodes ctx n))\n    \"blockStatement\" (lower ctx (first (core/rules ctx n \"innerStatementList\")))\n    \"innerStatementList\" (sequence-node (block-nodes ctx n))\n    \"expression\" (lower-expression ctx n)\n    \"yieldExpression\" (lower-yield ctx n)\n    \"parentheses\" (lower ctx (first (core/rule-kids ctx n)))\n    \"ifStatement\" (lower-if ctx n)\n    \"whileStatement\" (lower-while ctx n)\n    (\"doWhileStatement\" \"forStatement\" \"foreachStatement\")\n    (let [node (case (:rule n)\n                 \"doWhileStatement\" (lower-do-while ctx n)\n                 \"forStatement\" (lower-for ctx n)\n                 \"foreachStatement\" (with-temps ctx n (lower-foreach ctx n)))]\n      (if (pos? @(:ticks ctx))\n        (u/then node (core/site [:line (:id n) {:unit (get-in ctx [:unit :path]), :ticks @(:ticks ctx)}]\n                                (u/lit :php/null)))\n        node))\n    \"switchStatement\" (lower-switch ctx n)\n    \"breakStatement\" (lower-escape ctx n :break)\n    \"continueStatement\" (lower-escape ctx n :continue)\n    \"returnStatement\" (lower-return ctx n)\n    \"tryCatchFinally\" (lower-try ctx n)\n    \"throwStatement\" (app* 'php/throw-value (lower ctx (first (core/rules ctx n \"expression\"))))\n    \"staticVariableStatement\" (lower-static ctx n)\n    \"globalStatement\" (lower-global ctx n)\n    \"unsetStatement\" (lower-unset ctx n (core/rules ctx (first (core/rules ctx n \"chainList\")) \"chain\"))\n    \"functionDeclaration\" (lower-function ctx n)\n    \"constant\" (lower-constant ctx n)\n    \"arrayCreation\" (lower-array ctx n)\n    (\"classDeclaration\" \"enumDeclaration\") (lower-class ctx n)\n    \"declareStatement\" (let [outer-ticks @(:ticks ctx)\n                             body (first (core/rules ctx n \"statement\"))\n                             semicolon? (and body (p/rule? (first (core/rule-kids ctx body)) \"emptyStatement_\"))\n                             zero? (some (fn [d]\n                                           (and (some #(and (p/token? %) (= \"ticks\" (str/lower-case (:text %))))\n                                                      (core/kids ctx d))\n                                                (= \"0\" (leftmost-token-text ctx (first (core/rules ctx d \"numericConstant\"))))))\n                                         (mapcat #(core/rules ctx % \"directive\") (core/rules ctx n \"declareList\")))\n                             node (lower-declare ctx n)\n                             threshold (if semicolon? @(:ticks ctx) outer-ticks)]\n                         (if (and (pos? threshold) (or semicolon? (and body zero?)))\n                           (core/site [:line (:id n) {:unit (get-in ctx [:unit :path]), :ticks threshold}] node)\n                           node))\n    (core/default-arm diagnostic-ns \"PHP\" unsupported-rules n)))\n\n\n;; =============================================================================\n;; Packets\n;; =============================================================================\n\n(defn- hoisted?\n  \"True for a top-level statement that is an unconditional function\n   declaration: PHP declares it before the unit's first statement runs.\"\n  [ctx item]\n  (p/rule? (rule-head ctx item) \"functionDeclaration\"))\n\n\n(defn- declared-functions\n  \"Every function the unit declares: lower-cased fully qualified name to the\n   vector of its by-reference parameter positions.\"\n  [ctx]\n  (letfn [(refs\n            [n]\n            (let [fps (core/rules ctx (first (core/rules ctx n \"formalParameterList\"))\n                                  \"formalParameter\")]\n              (vec (keep-indexed (fn [i fp] (when (some #(p/token? % \"&\") (core/kids ctx fp)) i))\n                                 fps))))\n          (walk\n            [ictx n]\n            (into (if (p/rule? n \"functionDeclaration\")\n                    {(str/lower-case (ns-prefixed ictx (function-written ctx n))) (refs n)}\n                    {})\n                  (mapcat #(walk ictx %))\n                  (core/rule-kids ctx n)))]\n    (into {} (mapcat #(walk (item-ctx ctx %) %)) (:items ctx))))\n\n\n(def entry-path\n  \"The entry unit's declared path when the composition names none.\"\n  \"main.php\")\n\n\n(defn- context\n  ([packet] (context packet {}))\n  ([packet {:keys [path linked? eval-service?], :or {path entry-path}}]\n   (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n         ctx {:pk pk,\n              :analysis (scope/analyze pk),\n              :loops [],\n              :unit {:path path},\n              :linked? (boolean linked?),\n              :eval-service? (boolean eval-service?),\n              :warnings (atom []),\n              :ticks (atom 0)}\n         ctx (merge ctx (unit-layout ctx))]\n     (assoc ctx :declared (declared-functions ctx)))))\n\n\n(defn- check-hoisted!\n  \"A top-level function declared twice, or over a builtin, is a compile\n   error.\"\n  [ctx hoisted]\n  (reduce (fn [seen item]\n            (let [f (rule-head ctx item)\n                  written (ns-prefixed (item-ctx ctx item) (function-written ctx f))\n                  lc (str/lower-case written)]\n              (when (or (contains? seen lc) (contains? prelude/builtin-names lc))\n                (compile-error! f (str \"Cannot redeclare \" written \"()\")))\n              (conj seen lc)))\n          #{}\n          hoisted))\n\n\n(defn- class-item?\n  [ctx item]\n  (contains? #{\"classDeclaration\" \"enumDeclaration\"} (:rule (rule-head ctx item))))\n\n\n(defn- unit-body\n  \"The unit's statements as one node, hoisted function declarations first,\n   then the classes that can be declared at that point (PHP hoists a class\n   whose parent, interfaces and traits already exist); a hoisted class is\n   skipped when execution reaches it.\"\n  [ctx]\n  (let [items (:items ctx)\n        hoisted (filterv #(hoisted? ctx %) items)\n        classes (mapv (fn [item]\n                        (let [c (rule-head ctx item)\n                              [_ spec] (class-spec (item-ctx ctx item) c)]\n                          [(:id item) (symbol (str \"%class-\" (:id c))) spec\n                           (symbol (str \"%class-hoisted-\" (:id c)))]))\n                      (filter #(class-item? ctx %) items))\n        syms (into {} (map (fn [[id sym _ state]] [id [sym state]])) classes)\n        in-place (fn [item]\n                   (if-let [[sym state] (get syms (:id item))]\n                     (app* 'php/declare-late! (u/v sym) (app* 'cell/get (u/v state)))\n                     (if (and (:eval-unit? ctx) (hoisted? ctx item))\n                       (lower-function (assoc (item-ctx ctx item) :early-function? true)\n                                       (rule-head ctx item))\n                       (lower (item-ctx ctx item) item))))]\n    (when-not (:eval-unit? ctx) (check-hoisted! ctx hoisted))\n    (let [lowered (mapv (fn [item] [item (in-place item)]) items)\n          nodes (into {} (map (fn [[item node]] [(:id item) node])) lowered)\n          early (fn [item]\n                  (if (hoisted? ctx item)\n                    (get nodes (:id item))\n                    (let [[sym state] (get syms (:id item))]\n                      (app* 'cell/set! (u/v state) (app* 'php/hoist-class! (u/v sym))))))\n          body (sequence-node\n                 (concat (if (:eval-unit? ctx)\n                           (mapv early (filter #(or (hoisted? ctx %) (class-item? ctx %)) items))\n                           (mapv early (concat hoisted (filter #(class-item? ctx %) items))))\n                         (mapv second (remove (fn [[item _]] (hoisted? ctx item)) lowered))))]\n      (reduce (fn [inner [_ sym spec state]]\n                (u/let1 sym (u/lam [] spec)\n                        (u/let1 state (app* 'cell/new (u/lit false)) inner)))\n              body\n              (reverse classes)))))\n\n\n(defn- unit-returns?\n  \"True when the unit holds a top-level `return` (outside functions and\n   classes), which needs the escape around its body.\"\n  [ctx]\n  (core/contains-rule? ctx\n                       (p/root (:pk ctx))\n                       \"returnStatement\"\n                       #{\"functionDeclaration\" \"lambdaFunctionExpr\" \"classDeclaration\"\n                         \"enumDeclaration\"}))\n\n\n(defn- unit-node\n  \"`unit-body`, inside the `return` escape when the unit has a top-level\n   `return`: the escape answers its value, the sentinel `:php/no-return`\n   when the body falls off its end (plan P6 R4). An included unit's body\n   (`module?`) always answers the sentinel at its end; the entry unit's\n   value is dropped, so its tree is unchanged when it has no `return`.\"\n  ([ctx] (unit-node ctx false))\n  ([ctx module?]\n   (cond\n     (unit-returns? ctx)\n     (app* 'php/call-ec\n           (u/lam ['%ret] (u/then (unit-body (assoc ctx :ret '%ret)) (u/lit :php/no-return))))\n     module? (u/then (unit-body ctx) (u/lit :php/no-return))\n     :else (unit-body ctx))))\n\n\n(defn lower-module-body\n  \"The unit's statements as one node, before the runtime wrapper: what\n   lowering goldens compare. Hoisted function declarations come first.\"\n  [packet]\n  (unit-body (context packet)))\n\n\n(def eval-hook-profile\n  \"Safepoint derivation aliases bound to the caller's hooks in an eval entry.\"\n  {:loop '%eval-loop\n   :call {:hook '%eval-call :sequence true}\n   :line {:hook '%eval-line :operands true :after true}})\n\n\n(defn eval-runtime-node\n  \"Build the caller's eval runtime environment from the prelude inventory.\"\n  []\n  (reduce (fn [node names]\n            (apply app* 'assoc node (mapcat (fn [name] [(u/lit name) (u/v name)]) names)))\n          (u/lit {})\n          (partition-all 16 (sort (filter #(= \"php\" (namespace %))\n                                          (map first prelude/definitions))))))\n\n\n(defn eval-entry\n  \"Lower an eval unit to a callable that borrows its caller's runtime,\n   variable scope, method context and safepoint hooks. It does not initialize\n   a runtime or own the borrowed scope. Publication is the caller's job.\"\n  ([packet] (eval-entry packet {}))\n  ([packet {:keys [path eval-service?]}]\n   (let [ctx (assoc (context packet {:path (or path entry-path) :linked? true\n                                     :eval-service? eval-service?})\n                    :module? true :eval-unit? true)\n         body (u/let1 '%eval-result (unit-node ctx true)\n                      (u/if-node (app* '= (u/v '%eval-result) (u/lit :php/no-return))\n                                 (u/lit :php/null)\n                                 (u/v '%eval-result)))\n         imports (sort (filter #(= \"php\" (namespace %)) (core-prelude/free-names body)))\n         available (set (map first prelude/definitions))\n         missing (remove available imports)]\n     (when (seq missing)\n       (throw (ex-info \"eval unit has unknown runtime imports\"\n                       {:yang.php/diagnostic :yang.php/undeclared-free :names (vec missing)})))\n     {:ast (u/mark-tails\n             (u/lam ['%runtime '%scope '%ctx '%hooks]\n                    (reduce (fn [node [name key]]\n                              (u/let1 name (app* 'get (u/v '%hooks) (u/lit key)) node))\n                            (reduce (fn [node name]\n                                      (u/let1 name (app* 'get (u/v '%runtime) (u/lit name)) node))\n                                    body (reverse imports))\n                            (reverse [['%eval-loop :loop] ['%eval-call :call] ['%eval-line :line]]))))\n      :warnings @(:warnings ctx)})))\n\n\n(defn eval-module-spec\n  \"A code-only linker module exporting an eval entry under `name`.\"\n  ([registry name packet] (eval-module-spec registry name packet {}))\n  ([registry name packet options]\n   (let [ast (core-module/module-tree [(u/def! 'entry (:ast (eval-entry packet options)))])]\n     {:name name, :ast ast, :exports '#{entry}, :requires {}\n      :primitives (core-module/free-primitives :yang.php/refusal :yang.php/undeclared-free\n                                               registry #{} ast)})))\n\n\n(def option-keys\n  \"The options `lower-program` and the lowering stage accept. Request data\n   never flows here: the harness attaches the composition-supplied request\n   stream and composes its sealed reference as `run-main`'s second operand\n   (`:request-node`, an opaque UAST node) at the composition level — the\n   record itself reaches the runtime only when `run-main` consumes it.\"\n  [:prelude :path :paths :class-map :request-node :response-node :diag-node\n   :eval-service? :eval-budget?])\n\n\n(defn- path-map-node\n  \"`(php/bind-path-map! {path thunk ...})` for the composition's published\n   paths (plan P6 R3): the computed include's lookup table.\"\n  [paths]\n  (app* 'php/bind-path-map!\n        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\n                (u/lit {})\n                (sort paths))))\n\n\n(defn lower-program\n  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n   `php/run-main` after the prelude, tail calls marked. Its value is\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n   `:warnings` are the lowering's warning-severity diagnostics\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\n   `:yang.php/computed-include-path`).\n\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\n   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\n   need); `:path` the entry unit's declared path (default `entry-path`);\n   `:paths` the normalized paths whose units the composition published,\n   which a computed include resolves against; `:class-map` true requires\n   the published `phpm.$classmap` and binds its classes and delivery thunks\n   (plan P6 R9), which takes the place of `:paths`; `:request-node` is the\n  opaque `run-main` second-operand node the harness composed from the\n  attached request stream (lowering never embeds request data — `run-main`\n  consumes the record from the stream at runtime);\n  `:response-node` and `:diag-node` are the opaque third and fourth\n  operands: the composition-supplied stream references execution emits\n  on. Absent, `run-main` runs with two operands and the cells\n  accumulate.\"\n  ([packet] (lower-program packet {}))\n  ([packet {:keys [prelude paths path class-map request-node response-node diag-node\n                   eval-service? eval-budget?],\n            :or {prelude :bundled}}]\n   (when-not (contains? #{:bundled :linked} prelude)\n     (throw (ex-info \"unknown PHP prelude profile\"\n                     {:yang.php/diagnostic :yang.php/unsupported,\n                      :construct :prelude,\n                      :prelude prelude})))\n   (let [linked? (= :linked prelude)\n         request-node (or request-node (u/sexp->uast :php/null))\n         ctx (context packet {:path (or path entry-path), :linked? linked?\n                              :eval-service? eval-service?})\n         ;; `run-main`'s second operand arrives composed by the harness from\n         ;; the attached request stream: production initialization consumes\n         ;; the record from the stream at runtime and seeds the superglobals,\n         ;; no postwalk rewrite and no request data through lowering involved.\n         ;; With stream nodes `run-main` takes four operands (request,\n         ;; response and diagnostics references); without them it takes two\n         ;; and the cells accumulate.\n         main (if (or response-node diag-node)\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\n                      (or response-node (u/sexp->uast :php/null))\n                      (or diag-node (u/sexp->uast :php/null)))\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))\n         main (if eval-service?\n                (u/seq-nodes\n                  [(app* 'require (u/lit 'eval.compiler))\n                   (app* 'require (u/lit 'code))\n                   (u/let1 '%eval-runtime (eval-runtime-node)\n                           (u/let1 '%eval-hooks\n                                   (reduce (fn [m [k v]] (app* 'assoc m (u/lit k) v))\n                                           (u/lit {})\n                                           [[:loop (if eval-budget? (u/v 'php.sp/loop) (u/lam [] (u/lit :php/null)))]\n                                            [:call (if eval-budget? (u/v 'php.sp/call) (u/lam [] (u/lit :php/null)))]\n                                            [:line (u/v 'php.sp/line)]])\n                                   main))])\n                main)]\n     {:ast (u/mark-tails\n             (if linked?\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\n                                     (app* 'require (u/lit prelude/module-name))\n                                     (app* 'php/init!)]\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\n                                    (when class-map\n                                      [(app* 'require (u/lit classmap-module))\n                                       (app* 'php/bind-class-map!\n                                             (u/v (symbol (str classmap-module) \"classes\"))\n                                             (u/v (symbol (str classmap-module) \"paths\")))])\n                                    [main]))\n               (u/then prelude/uast main))),\n      :warnings @(:warnings ctx)})))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n;; =============================================================================\n\n(def module-exports\n  \"The exports of a compiled PHP unit: its spec and body, immutable after\n;; =============================================================================\n\n(def program-medium\n  \"The program medium's logical identity when the composition names none.\"\n  :yang.php/program)\n\n\n(defn- stage-config\n  \"The shared stage config; `warned` receives the packet's warnings.\"\n  [warned]\n  {:diagnostic-ns diagnostic-ns,\n   :program-medium program-medium,\n   :ok? #(= :yang.cst/ok (:yang.cst/outcome %)),\n   :lower (fn [state packet]\n            (let [{:keys [ast warnings]}\n                  (lower-program packet (select-keys state option-keys))]\n              (reset! warned warnings)\n              ast)),\n   :option-keys option-keys})\n\n\n(defn lower-transform\n  \"The lowering stage's transform (`yang.core.stage/lower-transform`):\n   an ok packet is one program batch, then one record on port `:diagnostics`\n   per warning (`:severity :warning`); a refusal is a diagnostic and no\n   program. Stateless.\"\n  [state packet]\n  (let [warned (atom [])\n        [state' outputs] (core-stage/lower-transform (stage-config warned) state packet)]\n    [state'\n     (into outputs\n           (map (fn [w] [:diagnostics (assoc w :yang.cst/unit (:yang.cst/unit packet))]))\n           @warned)]))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. The fourth argument may instead be\n   an options map `{:medium :prelude}`.\"\n  ([cst-stream program-stream diagnostics-stream]\n   (core-stage/open-stage (stage-config (atom [])) cst-stream program-stream diagnostics-stream))\n  ([cst-stream program-stream diagnostics-stream medium-or-opts]\n   (core-stage/open-stage (stage-config (atom []))\n                          cst-stream\n                          program-stream\n                          diagnostics-stream\n                          medium-or-opts)))\n\n\n(defn step-stage\n  [s]\n  (stage/step s lower-transform))\n65:   reach the unit root, `php/run-main`, which answers output, response and\n346:     ;; run-main received one, else onto the diag cell.\n503:     ;; the request record `run-main` binds: a plain record binds directly,\n518:     ;; response stream DURING execution when run-main received one, else\n839:     ;; run-main still runs shutdown functions, drains buffers and marks\n4564:     ;; of unclosed buffers runs on the run-main exit path, outside the\n5856:    [php/run-main\n","exit_code":0,"status":"completed"}}
