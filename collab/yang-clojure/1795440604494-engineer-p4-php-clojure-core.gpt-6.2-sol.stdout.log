{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"cat /tmp/dw-p4php-minted.edn; tail -45 /tmp/dw-p4php-legacy.log; sed -n '1140,1208p;660,705p;966,987p' src/cljc/yang/php/antlr/lower.cljc; sed -n '300,319p' bb.edn; sed -n '1,57p' docs/agents/build-n-test.md\"","aggregated_output":"Loading initial Timbre config from: :default\nLoading initial Timbre config from: :default\n\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yang.php.antlr.e2e-test\n\n\n(defn- cv-node\n  \"The holder cell node of variable `name` in the current scope, or nil for a\n   global.\"\n  [ctx name]\n  (cond\n    (static-var? name)\n    (let [[cls prop] (static-parts name)]\n      (app* (hook-name ctx :php/sprop-cell) (class-ref-node ctx nil cls) (u/lit prop) (cc-node ctx)))\n    (:fn ctx) (u/v (symbol name))\n    :else nil))\n\n\n(defn- display-name\n  [name]\n  (if (static-var? name) (second (static-parts name)) (bare name)))\n\n\n(defn- scope-op\n  \"The operation `op` (`get`, `set!`, ...) on a top-level variable: the\n   globals of the entry unit, or the including scope `%scope` inside an\n   included unit's body (plan P6 R5).\"\n  [ctx op name & more]\n  (if (:module? ctx)\n    (apply app* (hook-name ctx (keyword \"php\" (str \"dict-\" op))) (u/v '%scope) (u/lit (bare name)) more)\n    (apply app* (hook-name ctx (keyword \"php\" (str \"global-\" op))) (u/lit (bare name)) more)))\n\n\n(defn- dynamic-var?\n  [name]\n  (and (map? name) (contains? name :dynamic-name)))\n\n\n(defn- dynamic-scope-node\n  [ctx]\n  (if (or (:fn ctx) (:module? ctx)) (u/v '%scope) (u/lit :php/globals)))\n\n\n(defn- dynamic-op\n  [ctx op name & more]\n  (apply app* (hook-name ctx (keyword \"php\" (str \"dict-\" op))) (dynamic-scope-node ctx)\n         (app* (hook-name ctx :op/str) (:dynamic-name name)) more))\n\n\n(defn- persistent-var [ctx name]\n  (let [[origin & mas] (core/kids ctx chain)\n        o (first (core/kids ctx origin))]\n    (when (p/rule? o \"chainBase\")\n      (let [steps (mapv #(property-steps ctx %) mas)]\n        (when (every? some? steps)\n          (when-let [base (base-location ctx o)]\n            (update base :path into (mapcat identity steps))))))))\n\n\n(defn- expression-location\n  \"The location of an `expression` that is exactly one chain.\"\n  [ctx e]\n  (let [ks (core/kids ctx e)]\n    (when (and (= 1 (count ks)) (p/rule? (first ks) \"chain\"))\n      (chain-location ctx (first ks)))))\n\n\n(defn- chain-loc\n  \"The location of the `chain` `c`, or a refusal naming `construct`.\"\n  [ctx n c construct]\n  (let [loc (or (chain-location ctx c) (unsupported! n construct))]\n    (checked-var n (:var loc))\n        (u/let1 t c (u/if-node (truthy ctx (u/v t)) (u/v t) (lower ctx (nth ks 3))))))))\n\n\n(defn- lower-cast\n  [ctx n [_ op _ operand]]\n  (let [t (first (core/kids ctx op))\n        e (lower ctx operand)]\n    (case (:type t)\n      \"IntType\" (app* (hook-name ctx :php/to-int) e)\n      (\"FloatCast\" \"DoubleType\") (app* (hook-name ctx :php/to-float) e)\n      \"StringType\" (app* (hook-name ctx :op/str) e)\n      \"BoolType\" (app* (hook-name ctx :op/truthy) e)\n      (unsupported! n (keyword \"cast\" (str/lower-case (:type t)))))))\n\n\n(defn- lower-isset\n  [ctx n chains]\n  (let [one (fn [c]\n              (let [loc (chain-loc ctx n c :isset-target)]\n                (forbid-append! n loc \"Cannot use [] for reading\")\n                (isset-loc ctx (lower-path ctx loc))))]\n    (reduce (fn [acc c] (u/if-node acc (one c) (literal ctx :bool false)))\n            (one (first chains))\n            (rest chains))))\n\n\n(defn- lower-empty\n  [ctx n c]\n  (let [loc (chain-loc ctx n c :empty-target)]\n    (forbid-append! n loc \"Cannot use [] for reading\")\n    (app* 'not (truthy ctx (peek-loc ctx (lower-path ctx loc))))))\n\n\n(defn- lower-unset\n  [ctx n chains]\n  (u/then (u/seq-nodes (mapv (fn [c]\n                               (let [loc (chain-loc ctx n c :unset-target)]\n                                 (forbid-append! n loc \"Cannot use [] for unsetting\")\n                                 (with-keys ctx loc #(unset-loc ctx n %))))\n                             chains))\n          (literal ctx :nil nil)))\n\n\n(defn- lower-incdec\n  \"`++$x`, `$x--`, `$a[k]++`: the location is read, stepped and written back,\n   its keys evaluated once; the postfix form answers the old value.\"\n  [ctx n c op-type prefix?]\n  (let [loc (chain-loc ctx n c :inc-dec-target)\n        f (if (= \"Inc\" op-type) (hook-name ctx :php/inc) (hook-name ctx :php/dec))]\n    (forbid-append! n loc \"Cannot use [] for reading\")\n    (with-keys ctx\n      loc\n      (fn [l]\n        (let [write (fn [v]\n                      ;; `$r++` on a plain variable bound to a sourced reference\n                      ;; checks the overflow of its typed sources (row 43)\n                      (if (and (empty? (:path l)) (= \"Inc\" op-type) (not (this-var? (:var l))))\n                        (let [m (core/gen \"m\" n)]\n                          (u/let1 m\n                                  (if-let [cv (cv-node ctx (:var l))]\n                                    (app* (hook-name ctx :php/marker-of-cv) cv)\n                                    (app* (hook-name ctx :php/marker-of-global) (u/lit (bare (:var l)))))\n                                  (u/if-node (app* 'nil? (u/v m))\n                                             (write-loc ctx n l v)\n                                             (app* (hook-name ctx :php/typed-inc) (u/v m)))))\n                        (write-loc ctx n l v)))]\n          (if prefix?\n            (write (app* f (read-loc ctx l)))\n            (let [old (core/gen \"old\" n)]\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  check:node-discovery\n  {:doc \"Babashka-only, no natives: scan deps.edn :paths + :cljs :extra-paths for .cljc/.cljs namespaces outside test/ matching shadow-cljs.edn :test :ns-regexp (default -test$); fail before Node discovery can load JVM-only code. Rename the ns or guard it with reader conditionals. Self-test: bb src/dev/check_node_discovery_test.clj\"\n   :task (shell {:shutdown nil} \"bb src/dev/check_node_discovery.clj\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [check:node-discovery build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:antlr]\n                :task (shell \"clojure -M:test\")}\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# When a test fails, reproduce and fix it by running ONLY the failing test\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\n","exit_code":0,"status":"completed"}}
