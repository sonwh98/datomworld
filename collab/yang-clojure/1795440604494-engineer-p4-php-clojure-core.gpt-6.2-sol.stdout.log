bit = \"4.9.8\"\ncmake = \"4.4.4\"\nandroid-sdk = \"latest\"\nflutter = { version = \"3.47.8\", platforms = \"\"\"\n[linux-x64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/linux/flutter_linux_{{ version }}-beta.tar.xz\"\n\n[macos-arm64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/macos/flutter_macos_arm64_{{ version }}-beta.zip\"\n\n[macos-x64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/macos/flutter_macos_{{ version }}-beta.zip\"\n\n[windows-x64]\nurl = \"https://storage.googleapis.com/flutter_infra_release/releases/beta/windows/flutter_windows_{{ version }}-beta.zip\"\n\"\"\", version_json_path = \".releases[?channel=beta].version\", version_list_url = \"https://storage.googleapis.com/flutter_infra_release/releases/releases_macos.json\" }\n\n[env._]\npath = [\n  \"{{env.HOME}}/.local/share/mise/installs/android-sdk/1.0/platform-tools\",\n  \"{{env.HOME}}/.local/share/mise/installs/android-sdk/1.0/emulator\",\n]\n\n[env]\n#FLUTTER_STORAGE_BASE_URL = \"https://storage.flutter-io.cn\"\n#PUB_HOSTED_URL = \"https://pub.flutter-io.cn\"\n\n[plugins]\ngambit = \"https://github.com/joeljuca/asdf-gambit#b8a901e7af845c8b0a0ee1adc5b67687ba4c582b\"\n/Users/sto/workspace/dw-p4ts/build\n/Users/sto/workspace/dw-p4ts/lib\n/Users/sto/workspace/dw-p4ts/node_modules\n/Users/sto/workspace/dw-p4ts/target\nzsh:1: no matches found: /opt/homebrew/bin/php*\n(ns yang.php.antlr.e2e-test\n  \"End to end on the JVM: source -> CST packet -> lowering stage -> program\n   envelope -> the bundled program on each of the four VMs (the AST walker,\n   the semantic, stack and register VMs). Every fixture of\n   `yang.php.antlr.programs` prints the same text on all four.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.string :as str]\n    [clojure.test :refer [deftest is testing]]\n    [yang.core.uast :as u]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.portable-harness :as php-h]\n    [yang.php.antlr.packets :as packets]\n    [yang.php.antlr.packets-p3b :as packets-p3b]\n    [yang.php.antlr.permutations :as perms]\n    [yang.php.antlr.phpt :as phpt]\n    [yang.php.antlr.programs :as programs]\n    [yang.php.antlr.programs-p3b :as p3b]\n    [yang.typescript.antlr.e2e-test :as ts]\n    [yin.vm :as vm]\n    [yin.vm.test-utils :as tu]))\n\n\n(def ^:private vms [:ast-walker :semantic :stack :register])\n\n\n(defn- rendered\n  \"The text `fixture` prints: `:out`, then the fatal line of an `:uncaught`.\"\n  [{:keys [out uncaught]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))))\n\n\n(deftest ^:slow fixtures-on-every-vm-test\n  (doseq [{:keys [id source] :as fixture} programs/fixtures\n          :let [out (rendered fixture)]]\n    (testing (name id)\n      (let [results (h/run-php source)]\n        (is (not (contains? results :diagnostics)) (pr-str results))\n        (doseq [k vms]\n          (is (= out (get results k)) (str (name id) \" on \" k)))))))\n\n\n(deftest fixtures-on-the-walker-test\n  (doseq [{:keys [id source out diag uncaught oracle]} programs/fixtures\n          :let [r (h/run-raw source)]]\n    (is (not= :pending oracle) (name id))\n    (is (= out (h/latin1->text (:php/out r))) (name id))\n    (is (= (vec diag) (mapv (juxt :errno :message) (:php/diag r))) (name id))\n    (is (= uncaught (some-> (:php/uncaught r) (select-keys [:class :message])))\n        (name id))))\n\n\n(defn- app?\n  [node op]\n  (and (map? node)\n       (= :application (:type node))\n       (= {:type :variable, :name op} (:operator node))))\n\n\n(defn- lowered-ts\n  [source]\n  (let [{:keys [program diagnostics]} (ts/lower-source source :bundled)]\n    (assert (nil? diagnostics) (pr-str diagnostics))\n    (let [{:yin/keys [batch root]} program]\n      (nth batch root))))\n\n\n(defn- find-path\n  \"Find one node while visiting each collection identity once. Lowered trees\n   share subtrees; ordinary postwalk expands those shares needlessly.\"\n  [pred tree]\n  (let [seen (java.util.IdentityHashMap.)\n        found (volatile! nil)]\n    (letfn [(visit\n              [node path]\n              (when (and (nil? @found) (pred node))\n                (vreset! found path))\n              (when (and (nil? @found) (coll? node)\n                         (not (.containsKey seen node)))\n                (.put seen node true)\n                (cond\n                  (map? node)\n                  (doseq [[k v] node :while (nil? @found)]\n                    (visit v (conj path k)))\n\n                  (sequential? node)\n                  (doseq [[i v] (map-indexed vector node) :while (nil? @found)]\n                    (visit v (conj path i)))\n\n                  :else nil)))]\n      (visit tree [])\n      @found)))\n\n\n(defn- install-php-function-export\n  \"Project a published JS global into PHP's function namespace before the\n   source body. The caller tree contains a name reference, never donor code.\"\n  [ast export-name]\n  (let [projection (u/sexp->uast\n                     (list 'cell/set! 'php.rt/functions\n                           (list 'assoc\n                                 '(cell/get php.rt/functions)\n                                 export-name\n                                 (list 'js/global-get {:js/str export-name}))))\n        path (find-path #(app? % 'php/run-main) ast)]\n    (assert path \"PHP program has no php/run-main application\")\n","exit_code":0,"status":"completed"}}
