{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/rt/int.cljc | head -103; sed -n '775,812p;1063,1088p;2287,2315p;2330,2345p;3987,4011p' src/cljc/yang/php/antlr/lower.cljc; rg -n 'defn (app\\\\*|build-vector)' src/cljc/yang/core/lower.cljc; rg -n '\\\"(stream|cell)/|stream-profiles' src/cljc/yin/vm/module.cljc | tail -30; rg -n 'CLJ|php-src' test/yang/php/antlr/phpt.clj | head -50\"","aggregated_output":"(ns yang.rt.int\n  \"Guest adapters for exact-integer policy, wrapping, and radix scanning.\"\n  (:require [yang.core.prelude :as core]\n            [yang.core.prelude-admission :as prelude-admission]\n            [yang.core.uast :as u]\n            [yang.rt.effect :as effect]))\n\n\n(def module-name 'yrt.int)\n\n\n(def definitions\n  \"The ordered source for bundled and linked emission.\"\n  '[[yrt.int/check-limit-with\n     (fn [res on-bit on-digit on-float]\n       (if (= res :yin.vm.integer/bit-limit)\n         (on-bit res)\n         (if (= res :yin.vm.integer/digit-limit)\n           (on-digit res)\n           (if (= res :yin.vm.integer/float-overflow)\n             (on-float res)\n             res))))]\n    [yrt.int/_perform\n     (fn [ctx-cell tag res]\n       (yrt.effect/perform ctx-cell tag res\n         (fn [tag payload]\n           (let [handler (get (cell/get ctx-cell) :on-unhandled-policy)]\n             (if (= handler nil)\n               (:yrt.int/unhandled-policy tag payload)\n               (handler tag payload))))))]\n    [yrt.int/check-limit\n     (fn [ctx-cell res]\n       (if (= res :yin.vm.integer/bit-limit)\n         (yrt.int/_perform ctx-cell :int/bit-limit res)\n         (if (= res :yin.vm.integer/digit-limit)\n           (yrt.int/_perform ctx-cell :int/digit-limit res)\n           (if (= res :yin.vm.integer/float-overflow)\n             (yrt.int/_perform ctx-cell :math/overflow res)\n             res))))]\n    [yrt.int/wrap-unsigned\n     (fn [x width-pow2 mask]\n       (if (= mask nil)\n         (let [qr (integer/floor-div-mod x width-pow2)]\n           (if (= qr :yin.vm.integer/bit-limit) qr (data/nth qr 1)))\n         (integer/bit-and x mask)))]\n    [yrt.int/wrap-signed\n     (fn [x half-range range]\n       (let [r (yrt.int/wrap-unsigned x range nil)]\n         (if (= r :yin.vm.integer/bit-limit)\n           r\n           (if (<= 0 (integer/compare r half-range)) (integer/sub r range) r))))]\n    [yrt.int/in-range?\n     (fn [x min-v max-v]\n       (if (<= 0 (integer/compare x min-v))\n         (<= (integer/compare x max-v) 0)\n         false))]\n    [yrt.int/digit-value\n     (fn [cp]\n       (if (if (<= 48 cp) (<= cp 57) false)\n         (- cp 48)\n         (if (if (<= 65 cp) (<= cp 90) false)\n           (- cp 55)\n           (if (if (<= 97 cp) (<= cp 122) false)\n             (- cp 87)\n             -1))))]\n    [yrt.int/_digit?\n     (fn [d radix] (if (<= 0 d) (< d radix) false))]\n    [yrt.int/all-digits?\n     (fn [cs i n radix]\n       (if (< i n)\n         (if (yrt.int/_digit? (yrt.int/digit-value (data/nth cs i)) radix)\n           (yrt.int/all-digits? cs (+ i 1) n radix)\n           false)\n         true))]\n    [yrt.int/scan-digits\n     ;; Accumulate the valid prefix and propagate a limit before using its\n     ;; keyword as an integer operand.\n     (fn [cs i n radix acc]\n       (if (= acc :yin.vm.integer/bit-limit)\n         acc\n         (if (< i n)\n           (let [d (yrt.int/digit-value (data/nth cs i))]\n             (if (yrt.int/_digit? d radix)\n               (let [scaled (integer/mul acc radix)]\n                 (if (= scaled :yin.vm.integer/bit-limit)\n                   scaled\n                   (yrt.int/scan-digits cs (+ i 1) n radix (integer/add scaled d))))\n               acc))\n           acc)))]\n    [yrt.int/skip-while\n     (fn [cs i n pred?]\n       (if (< i n)\n         (if (pred? (data/nth cs i))\n           (yrt.int/skip-while cs (+ i 1) n pred?)\n           i)\n         i))]\n    [yrt.int/skip-zeros\n     (fn [cs i n] (yrt.int/skip-while cs i n (fn [cp] (= cp 48))))]])\n\n\n(def module-exports\n  '#{check-limit check-limit-with wrap-unsigned wrap-signed in-range?\n     digit-value all-digits? scan-digits skip-while skip-zeros})\n    (boolean (or (str/starts-with? t \"[\")\n                 (re-find #\"^->[A-Za-z_\\x7f-\\xff]\" t)))))\n\n\n(defn- interpolated-node\n  \"The concatenation of a double-quoted string's parts: text runs resolved\n   to bytes, plain variables read in order. `end` is where the opening quote\n   ends, to tell `{$x}` from `$x` by the gap the braces leave.\"\n  [ctx n end parts]\n  (let [texts (fn [run]\n                (u/lit (bytes->str (unescape-double (apply str (map :text run))))))\n        pieces\n        (loop [ps parts, prev-end end, run [], out []]\n          (if (empty? ps)\n            (if (seq run) (conj out (texts run)) out)\n            (let [part (first ps)\n                  k (first (core/kids ctx part))\n                  span-end (second (:span part))]\n              (if (p/rule? k \"chain\")\n                (let [name (or (simple-var ctx k) (unsupported! n :interpolation))\n                      braced? (not= prev-end (first (:span part)))\n                      nxt (second ps)\n                      nk (when nxt (first (core/kids ctx nxt)))]\n                  (when (and (not braced?) nk (p/token? nk) (interpolation-follows? nk))\n                    (unsupported! n :interpolation))\n                  (recur (rest ps)\n                         span-end\n                         []\n                         (conj (if (seq run) (conj out (texts run)) out)\n                               (app* 'php/to-string (read-var ctx (checked-var n name))))))\n                (recur (rest ps) span-end (conj run k) out)))))]\n    (case (count pieces)\n      0 (u/lit \"\")\n      1 (first pieces)\n      (reduce (fn [acc piece] (app* 'php/concat acc piece)) pieces))))\n\n\n(defn- string-node\n(defn- lower-binary\n  [ctx n 