0 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 ;; V8 defaults to ~984 KiB: recursive guest frames and the\n                 ;; serializers of captured continuations can exhaust it before\n                 ;; Python's 1000-frame guard. 6 MiB fits Linux's 8 MiB native\n                 ;; stack. Re-exec before loading CLJS, covering shadow autorun\n                 ;; AND direct `node ... --test=...` shard invocations.\n                 :prepend \"if (!process.execArgv.includes('--stack-size=6144')) { const child = require('child_process').spawnSync(process.execPath, [...process.execArgv, '--stack-size=6144', ...process.argv.slice(1)], {stdio: 'inherit'}); if (child.error) throw child.error; if (child.signal) process.kill(process.pid, child.signal); else process.exit(child.status); }\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.shell.main/-main\n                        :output-to \"target/yin-repl.js\"}}}\n10:         (register-stream-module))\n378:(defn register-stream-module\n383:  (register-host-module registry 'stream stream-module stream-profiles))\n(ns yang.php.antlr.cst\n  \"The PHP parser worker (docs/design/yang.php.md section 6): the\n   grammars-v4 php grammar profile over the generic `yang.antlr.cst` worker.\n   The generated recognizers come from `bb gen:antlr` (antlr/php/manifest.edn);\n   the JVM and Node use the same grammar and export profile. The entry rule is `htmlDocument`.\n\n   The grammar's non-standard generics (`typeParameterListInBrackets`, the\n   `<: ... :>` brackets) are not PHP: a parse that uses them is refused as\n   `{:yang.php/not-php :generics}` rather than exported.\"\n  (:require\n    [yang.antlr.cst :as cst]\n    [dao.host.text :as text]\n    #?@(:cljs [[\"/yang/antlr/gen/php/PhpLexer.js\" :default PhpLexer]\n               [\"/yang/antlr/gen/php/PhpParser.js\" :default PhpParser]]))\n  #?(:clj (:import (yang.php.antlr.gen PhpLexer PhpParser))))\n\n\n(def grammar-id\n  \"grammars-v4 php at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/php@85e2dd1779ce556111ef98ead5d62a9858e95599 antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   :make-lexer (fn [cs] (PhpLexer. cs)),\n   :make-parser (fn [ts] (PhpParser. ts)),\n   :start #?(:clj (fn [^PhpParser p] (.htmlDocument p))\n             :cljs (fn [^js p] (.htmlDocument p)))})\n\n\n(defn make-worker\n  []\n  (cst/make-worker profile))\n\n\n(defn make-eval-worker\n  \"A worker whose lexer starts in PHP mode with default mode underneath.\"\n  []\n  (cst/make-worker\n    (assoc profile :make-lexer\n           (fn [cs]\n             (let [lexer (PhpLexer. cs)]\n               #?(:clj (.pushMode lexer PhpLexer/PHP)\n                  :cljs (.pushMode lexer (.-PHP PhpLexer)))\n               lexer)))))\n\n\n(defn- generics?\n  [pk]\n  (boolean (some #(= \"typeParameterListInBrackets\" (:rule %))\n                 (:yang.cst/nodes pk))))\n\n\n(defn- line-starts\n  \"The UTF-8 byte offsets at which each source line begins (the line side\n   table, section 17: derived at the parse boundary, where the source is\n   known, so no later stage needs the text).\"\n  [source]\n  (let [bs (text/utf8-encode source)]\n    (into [0] (keep-indexed (fn [i b] (when (= b 10) (inc i)))) bs)))\n\n\n(defn parse-source\n  \"Parse one complete PHP source string as unit `unit`: the CST packet, or\n   `{:yang.php/not-php :generics}` when the parse uses the grammar's generics\n   extension.\"\n  ([source] (parse-source (make-worker) [:unit 0] source))\n  ([worker unit source]\n   (let [pk (cst/parse-unit worker unit source)]\n     (if (generics? pk)\n       {:yang.php/not-php :generics}\n       (assoc pk :yang.php/line-starts (line-starts source))))))\nbi-pow 1\np9-minmax 4\np9-array-minmax 5\np9-bi-minmax 3\nbi-min 1\nbi-max 1\nbi-is-finite 1\nbi-is-infinite 1\nbi-array-multisort 1\ninit! 0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yang/php/antlr/descriptor_profile_test.cljc <<'EOF'\n(ns yang.php.antlr.descriptor-profile-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing.mem :as mem]\n            [yang.core.semantics :as semantics]\n            [yang.frontend :as frontend]\n            [yang.php.antlr.contract :as contract]\n            [yang.php.antlr.cst :as cst]\n            [yang.php.antlr.lower :as lower]\n            [yang.php.antlr.profiles :as profiles]\n            [yang.php.antlr.linked-harness :as linked]\n            [yang.php.antlr.portable-harness :as portable]\n            [yin.repl :as repl]\n            [yin.repl.frontends :as frontends]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.linker.interpreter :as link]))\n\n(def \"'^:private composition\n  (delay (let [store (mem/create-content-mem)\n               prepared (profiles/prepare! store)]\n           (assoc prepared :source\n                  (link/composition {:content-store store :name-env (:pins prepared)\n                                     :derivation :trusted})))))\n\n(defn- descriptor [id] (:descriptor (profiles/builtin id)))\n\n(defn- refusal [f]\n  (try (f) nil\n       (catch #?(:clj clojure.lang.ExceptionInfo :cljs ExceptionInfo) e\n         (ex-data e))))\n\n(deftest validates-frozen-entry-and-exact-roles\n  (let [{:keys [artifacts registry contract]} @composition\n        legacy (descriptor contract/legacy-id)\n        persistent (descriptor contract/clojure-id)\n        validate #(semantics/validate-descriptor %1 %2 artifacts registry)]\n    (is (= legacy (validate legacy contract)))\n    (is (= persistent (validate persistent contract)))\n    (doseq [target ['\"'add 'clj.php/sub 'cell/dsg__new-provenance\n                    'clojure.core.impl/impl-get 'php/add 'clj.php/echo]]\n      (is (= :refused\n             (:status (refusal #(validate (assoc-in persistent [:yang.semantics/hooks :op/add] target)\n                                          contract))))\n          (str target)))\n    (doseq [argc [2 3 4]]\n      (let [entry (assoc-in contract [:entry-lowering contract/legacy-id :operands]\n                            (vec (repeat argc :body-fn)))\n            check #(validate legacy entry)]\n        (if (= 3 argc)\n          (is (= :arity (:defect (refusal check))))\n          (is (= legacy (check))))))))\n\n(deftest capability-refusals-have-no-program\n  (doseq [[cap source] [[:oo/classes \\\"class C {}\\\"]\n                        [:control/generators \\\"function f() { yield 1; }\\\"]\n                        [:control/except-typed \\\"try {} catch (Exception \"'$e) {}\"]\n                        [:calls/defaults \"function f($x = 1) {}\"]\n                        [:calls/kwargs \"f(x: 1);\"]\n                        [:calls/kwstar \"f(...[1]);\"]\n                        [:calls/references \"function f(&$x) {}\"]\n                        [:mutation/subscript \"$a[0] = 1;\"]\n                        [:mutation/delete \"unset($a);\"]\n                        [:destructuring/unpack \"[$x] = [1];\"]\n                        [:modules/import \"include '\"'lib.php';\\\"]]]\n    (testing source\n      (let [packet (cst/parse-source (str \\\"<?php \\\" source))\n            [_ outputs] (lower/lower-transform {:descriptor (descriptor contract/clojure-id)} packet)\n            [[_ diagnostic]] outputs]\n        (is (= [:diagnostics] (mapv first outputs)))\n        (is (= {:status :refused :reason :yang.semantics/unsupported-capability\n                :capability cap :semantics-id contract/clojure-id}\n               (select-keys diagnostic [:status :reason :capability :semantics-id])))\n        (is (int? (:node diagnostic)))))))\nEOF\nexport MISE_TRUSTED_CONFIG_PATHS=\\\"\"'$PWD\"\neval \"$(mise env)\"\nclj -M:test -n yang.php.antlr.descriptor-profile-test'","aggregated_output":"","exit