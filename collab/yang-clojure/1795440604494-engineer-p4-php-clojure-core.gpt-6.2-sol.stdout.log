 k)))\n              (lower-initializer-part ctx k0)\n              (rest (remove #(p/token? % \".\") ks)))\n      (some #(p/rule? % \"arrayItemList\") ks) (lower-array ctx n)\n      (and (p/token? k0) (contains? #{\"OpenSquareBracket\" \"Array\"} (:type k0)))\n      (app* 'php/empty-array)\n      :else (unsupported! n :constant-expression))))\n\n\n(defn- lower-initializer-part\n  [ctx k]\n  (if (p/rule? k \"string\") (string-node ctx k) (lower ctx k)))\n\n\n(defn- lower-const\n  \"The PHP spelling of a type value, for compile-time messages.\"\n  [type]\n  (letfn [(one [a] (case (:t a) :obj \"object\" :class (:name a) (name (:t a))))]\n    (if (= :union (:t type))\n      (let [atoms (:of type)]\n        (if (and (= 2 (count atoms)) (= :null (:t (second atoms))))\n          (str \"?\" (one (first atoms)))\n          (str/join \"|\" (map one atoms))))\n      (one type))))\n\n\n(defn- check-literal-default!\n  \"A default whose kind is known at lowering and is not a member of `type` is a\n   compile-time fatal; an unresolved constant expression is checked when the\n   default is installed.\"\n  [ctx n init type what]\n  (when-let [[kind v] (init-kind ctx init)]\n    (when-not (kind-fits? type kind v)\n      (compile-error!\n        n\n        (if (and (= :null kind) (str/starts-with? what \"property\"))\n          (str \"Default value for property of type \" (type-label type)\n               \" may not be null. Use the nullable type ?\" (type-label type)\n               \" to allow null default value\")\n          (str \"Cannot use \" (name kind) \" as default value for \" what \" of type \" (type-label type)))))))\n\n\n(defn- param-binding\n  \"The cell of parameter `i`: the argument when passed, else the default\n   (evaluated here, in the callee), else an `ArgumentCountError`. A hole left\n   by named arguments is `:php/undef`; a variadic parameter gathers the rest.\"\n  [ctx n written required exact? i {:keys [name default ref? variadic? type]}]\n  (if variadic?\n    (app* 'php/gather-variadic (u/v '%args) (u/lit i))\n    (let [a (core/gen (str \"a\" i) n)\n          count-node (app* 'data/count (u/v '%args))]\n      (u/let1 a\n              (u/if-node (app* '< (u/lit i) count-node)\n                         (app* 'get (u/v '%args) (u/lit i))\n                         (u/lit :php/undef))\n              (u/if-node (app* '= (u/v a) (u/lit :php/undef))\n                         (if default\n                           (let [d (lower-initializer ctx default)]\n                             (when type (check-literal-default! ctx default default type\n                                                                (str \"parameter $\" (bare name))))\n                             (if type\n                               (app* 'php/param-default d (u/lit type) (u/lit written)\n                                     (u/lit (inc i)) (u/lit (bare name)))\n                               d))\n                           (app* 'php/not-passed\n                                 (u/lit written)\n                                 (u/lit (inc i))\n                                 (u/lit (bare name))\n                                 count-node\n                                 (u/lit required)\n                                 (u/lit exact?)))\n                         (cond\n                           (and ref? type)\n                           (app* 'php/param-ref-typed (u/v a) (u/lit type) (u/lit written)\n                                 (u/lit (inc i)) (u/lit (bare name))\n                                 (u/v '%binding-profile))\n                           ref? (app* 'php/param-ref\n                                      (u/v a)\n                                      (u/v '%binding-profile))\n                           type (app* 'php/addref\n                                      (app* 'php/coerce-arg (u/v a) (u/lit type) (u/lit written)\n                                            (u/lit (inc i)) (u/lit (bare name))))\n                           :else (app* 'php/addref (u/v a))))))))\n\n\n(defn- function-lam\n  \"`[lam spec]` for the function node `n`. `captures` is a vector of\n   `{:name :ref? :sym}` bound before the parameters (closures); `arrow?`\n   makes the body the value of an expression.\"\n  [ctx n written {:keys [captures arrow? closure?]}]\n  (let [ks (core/kids ctx n)\n        rt-src (or (first (core/rules ctx n \"returnTypeDecl\")) (when (some #(p/token? % \":\") ks) n))\n        ;; the grammar reads `: name` after a method's parameters as a base constructor call\n        bcc (first (core/rules ctx n \"baseCtorCall\"))\n        rtype (cond\n                rt-src\n                (let [th (first (core/rules ctx rt-src \"typeHint\"))]\n                  (type-data ctx th (boolean (some #(and (p/token? %) (= \"?\" (:text %))) (core/kids ctx rt-src)))\n                             (:cname ctx)))\n                (and bcc (empty? (core/rules ctx bcc \"arguments\")))\n                (let [atoms (name-atoms bcc (leftmost-token-text ctx (first (core/rules ctx bcc \"identifier\")))\n                                        (:cname ctx))]\n                  (if (= 1 (count atoms)) (first atoms) {:t :union, :of atoms})))\n        _ (when (seq (mapcat #(core/rules ctx % \"arguments\") (core/rules ctx n \"baseCtorCall\")))\n            (unsupported! n :base-constructor-call))\n        _ (when (some #(p/token? % \"&\") (take-while #(not (p/token? % \"(\")) ks))\n            (unsupported! n :reference))\n        _ (when (seq (core/rules ctx n \"attributes\")) (unsupported! n :attribute))\n        _ (when (seq (core/rules ctx n \"typeParameterListInBrackets\"))\n            (unsupported! n :generics))\n        params (formal-params ctx n)\n        scope (get-in (:analysis ctx) [:scopes (:id n)])\n        param-names (set (map :name params))\n        capture-names (set (map :name captures))\n        static-names (set (:statics scope))\n        static-names-v (vec (:statics scope))\n        locals (remove #(or (contains? param-names %) (contains? static-names %)\n                            (contains? capture-names %) (= \"$this\" %))\n                       (:vars scope))\n        block (or (first (core/rules ctx n \"blockStatement\"))\n                  (some->> (first (core/rules ctx n \"methodBody\"))\n                           (#(core/rules ctx % \"blockStatement\"))\n                           first))\n        has-return? (and block\n                         (core/contains-rule? ctx\n                                              block\n(ns yang.core.stage\n  \"The lowering stage every language shares (docs/design/yang.typescript.md\n   §17, lift L2): CST packets in, program batches on port `:program`,\n   diagnostics on port `:diagnostics`. A language supplies a `config`:\n\n     :diagnostic-ns   string, the namespace of its diagnostic keys\n     :program-medium  the program medium's default logical identity\n     :ok?             (fn [packet]) true when the packet is lowered\n     :lower           (fn [state packet]) the program tree of an ok packet\n     :option-keys     the state keys an options map may carry besides\n                      `:medium`\"\n  (:require\n    [yang.stage :as stage]\n    [yin.vm.encoder :as encoder]))\n\n\n(defn diagnostic\n  \"The record of a lowering diagnostic `data` for `unit`.\"\n  [diagnostic-ns unit data message]\n  (merge {:yang.cst/unit unit, :message message}\n         (select-keys data [(keyword diagnostic-ns \"diagnostic\") :rule\n                            :construct :span :name :status :reason :capability\n                            :semantics-id :node])))\n\n\n(defn lower-transform\n  \"The lowering stage's transform: an ok packet becomes one program batch on\n   port `:program`, a source envelope (`yin.vm.encoder/source-envelope`)\n   whose one member is the map AST `(:lower config)` returns, so its\n   `:yang/site` marks reach the frontend-metadata side table when the\n   encoder projects it. The medium is the state's `:medium` and the batch\n   token is the packet's unit. A packet that is not ok, or a lowering\n   diagnostic, becomes one record on port `:diagnostics` and no program.\n   Stateless.\"\n  [{:keys [diagnostic-ns program-medium ok? lower]} state packet]\n  (let [unit (:yang.cst/unit packet)\n        diagnostic-key (keyword diagnostic-ns \"diagnostic\")]\n    (if (ok? packet)\n      (try\n        [state [[:program (encoder/source-envelope\n                            (get state :medium program-medium)\n                            unit\n                            [(lower state packet)])]]]\n        ;; ClojureDart's ex-info type is not catchable by name portably;\n        ;; anything without a diagnostic in its ex-data is rethrown below\n        (catch #?(:cljd Object\n                  :clj clojure.lang.ExceptionInfo\n                  :cljs ExceptionInfo)\n               e\n          (if (get (ex-data e) diagnostic-key)\n            [state\n             [[:diagnostics\n               (diagnostic diagnostic-ns unit (ex-data e) (ex-message e))]]]\n            (throw e))))\n      [state\n       [[:diagnostics {:yang.cst/unit unit,\n                       diagnostic-key (keyword diagnostic-ns\n                                               (name (:yang.cst/outcome\n                                                       packet))),\n                       :errors (:yang.cst/errors packet)}]]])))\n\n\n(defn open-stage\n  \"A lowering stage reading CST packets from `cst-stream`, writing program\n   batches to `program-stream`, whose logical identity is `medium`, and\n   diagnostics to `diagnostics-stream`. The fourth argument may instead be\n   an options map of `:medium` and the config's `:option-keys`; the fifth,\n   `max-digits`, is the digit budget of every packet that declares none.\"\n  ([config cst-stream program-stream diagnostics-stream]\n   (open-stage config\n               cst-stream\n               program-stream\n               diagnostics-stream\n               (:program-medium config)))\n  ([{:keys [program-medium option-keys]}\n    cst-stream\n    program-stream\n    diagnostics-stream\n    medium-or-opts]\n   (stage/open cst-stream\n               {:program program-stream, :diagnostics diagnostics-stream}\n               (if (map? medium-or-opts)\n                 (let [{:keys [medium], :or {medium program-medium}}\n                       medium-or-opts]\n                   (assoc (select-keys medium-or-opts option-keys)\n                          :medium medium))\n                 {:medium medium-or-opts})))\n  ([_config cst-stream program-stream diagnostics-stream medium max-digits]\n   (stage/open cst-stream\n               {:program program-stream, :diagnostics diagnostics-stream}\n               {:medium medium, :max-digits max-digits})))\n\n\n(defn step-stage\n  [config s]\n  (stage/step s (partial lower-transform config)))\n240:  (= contract/legacy-id (get-in ctx [:descriptor :yang.semantics/id])))\n244:  (or (get-in ctx [:descriptor :yang.semantics/hooks role])\n245:      (unsupported! (:node ctx) (str (name role) \" under \" (get-in ctx [:descriptor :yang.semantics/id])))))\n253:  (semantics/literal (:descriptor ctx) key value))\n257:  (when (= :refused (semantics/capability (:descriptor ctx) cap))\n261:                     :capability cap :semantics-id (get-in ctx [:descriptor :yang.semantics/id])\n345:            safe-bits (get-in (:descriptor ctx) [:yang.semantics/literals :int :safe-max-bits])]\n346:        (semantics/literal (:descriptor ctx) :int v bits\n1188:                   (get-in ctx [:descriptor :yang.semantics/ambient-projections]))))\n1191:(defn- ambient-only? [ctx]\n1192:  (= :ambient-only (semantics/capability (:descriptor ctx) :modules/import)))\n1195:(defn- ambient-import! [ctx n construct]\n1199:                   :capability :modules/import :semantics-id (get-in ctx [:descriptor :yang.semantics/id])\n1203:(defn- ambient-module [ctx node target]\n2470:                        (u/then body (if (get-in ctx [:descriptor :yang.semantics/hooks :comp/finish])\n2616:     :descriptor descriptor,\n2649:(defn- ambient-resolver [descriptor]\n2662:  (let [{:keys [operands call-shapes hook]} (get contract/entry-lowering (:yang.semantics/id descriptor))\n2691:  \"Lower one ok packet using the selected, admitted `:descriptor`. Bare\n3004:                          (select-keys state [:prelude :descriptor]))),\n3005:   :option-keys [:max-digits :prelude :descriptor]})\n","exit_code":0,"status":"completed"}}
