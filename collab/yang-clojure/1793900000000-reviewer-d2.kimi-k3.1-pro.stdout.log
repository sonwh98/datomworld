{"role":"tool","tool_call_id":"tool_aLR8FX82r7ZN1U3iAPRf5a7b","content":"175\t                      (into {} (map (fn [op] [op (:yin.k/arities (get data/data-profiles op))]))\n176\t                            (keys portable)))))))\n177\t\n178\t\n179\t(def ^:private arg-vector-opts\n180\t  \"The argument-vector convention with the outcome model, the guest library's\n181\t   adapters and the VM primitives' published profiles as the native names.\"\n182\t  {:convention :arg-vector, :outcomes true\n183\t   :adapters yang/library-adapters\n184\t   :native vm/primitive-profiles})\n185\t\n186\t\n187\t(defn- result-shape\n188\t  \"Collection families and domain metadata, excluding reader provenance.\"\n189\t  [x]\n190\t  [(not-empty (apply dissoc (meta x) [:source :file :line :column :end-line :end-column]))\n191\t   (cond\n192\t     (map? x) (into {} (map (fn [[k v]] [k [(result-shape k) (result-shape v)]])) x)\n193\t     (set? x) (into #{} (map (fn [v] [v (result-shape v)])) x)\n194\t     (sequential? x) [(if (vector? x) :vector :sequence) (mapv result-shape x)]\n195\t     :else :scalar)])\n196\t\n197\t\n198\t(defn- unbound-ast-symbols\n199\t  \"Admission for the portable context module: every variable is a lexical\n200\t   binder, declared guest function, or explicitly supplied data primitive.\"\n201\t  [ast program]\n202\t  (let [globals (into #{'yin/def}\n203\t                      (concat (keys vm/primitive-profiles)\n204\t                              (map first call/definitions)\n205\t                              (for [form program :when (#{'def 'defn 'defn-} (first form))]\n206\t                                (second form))\n207\t                              (for [[module exports] {'kind yang/kind-module\n208\t                                                      'cell module/cell-module\n209\t                                                      'data data/data-module\n210\t                                                      'stream module/stream-module\n211\t                                                      'portable (into {} (map (fn [[_ v]] [(symbol (name v)) nil]))\n212\t                                                                      yang/library-adapters)}\n213\t                                    export (keys exports)]\n214\t                                (symbol (str module) (name export)))))]\n215\t    (letfn [(scan\n216\t              [node bound]\n217\t              (case (:type node)\n218\t                :variable (if (or (contains? globals (:name node))\n219\t                                  (contains? bound (:name node))) #{} #{(:name node)})\n220\t                :literal #{}\n221\t                :vm/current-continuation #{}\n222\t                :lambda (scan (:body node) (into bound (:params node)))\n223\t                :application (into (scan (:operator node) bound)\n224\t                                   (mapcat #(scan % bound)) (:operands node))\n225\t                :if (into #{} (mapcat #(scan (get node %) bound))\n226\t                          [:test :consequent :alternate])\n227\t                ;; The rejection carries the node itself (print-bounded): a\n228\t                ;; bare symbol or unknown shape names its emitter directly.\n229\t                (throw (ex-info \"Unexpected AST in context admission\"\n230\t                                {:type (:type node)\n231\t                                 :node (binding [*print-length* 40 *print-level* 8]\n232\t                                         (pr-str node))}))))]\n233\t      (scan ast #{}))))\n234\t\n235\t\n236\t(defn- run-outcome\n237\t  \"Compile `forms` plus `call-form` (with the library definitions they need)\n238\t   and return the RAW outcome of the call: the value channel carries\n239\t   [tag payload]. Every fixture runs on walker and semantic lanes under the\n240\t   same finite instruction budget.\"\n241\t  ([forms call-form] (run-outcome forms call-form (oracle-registry)))\n242\t  ([forms call-form modules] (run-outcome forms call-form modules false))\n243\t  ([forms call-form modules closed?]\n244\t   (let [program (into [] (concat forms [call-form]))\n245\t         program (into (yang/library-for program) program)\n246\t         ast (yang/compile-program program true arg-vector-opts)\n247\t         _ (when closed?\n248\t             (let [unbound (unbound-ast-symbols ast program)]\n249\t               (when (seq unbound)"}
