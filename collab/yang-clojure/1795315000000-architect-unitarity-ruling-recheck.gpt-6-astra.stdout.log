{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '136,203p;259,295p;420,495p'\nnl -ba src/cljc/yin/vm/macro.cljc | sed -n '640,710p;1250,1425p;1500,1575p'\nnl -ba src/cljc/yang/clojure.cljc | sed -n '135,193p;235,310p'\nrg -n 'call-site-origins|origin-of|call-site-table|yin.macro/log|expansion-record' src/cljc/yin/vm/macro.cljc src/cljc/yin/vm/encoder.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '136,203p;259,295p;420,495p'\nnl -ba src/cljc/yin/vm/macro.cljc | sed -n '640,710p;1250,1425p;1500,1575p'\nnl -ba src/cljc/yang/clojure.cljc | sed -n '135,193p;235,310p'\nrg -n 'call-site-origins|origin-of|call-site-table|yin.macro/log|expansion-record' src/cljc/yin/vm/macro.cljc src/cljc/yin/vm/encoder.cljc\"","aggregated_output":"   136\t(defn- scope-admission-token\n   137\t  \"The admission token a scope object draws for one publication: the\n   138\t   scope's own `id` plus the ordinal the scope's counter assigns. The\n   139\t   counter lives in the caller-owned scope object, never here.\"\n   140\t  [{:yin.link.publish/keys [scope-id ordinal]}]\n   141\t  ;; pr-str keeps the value's full identity — a keyword's namespace, a\n   142\t  ;; string's quoting, a symbol's name — so distinct caller-chosen ids\n   143\t  ;; (:a/publisher, :b/publisher, \"publisher\") never mint the same token\n   144\t  (keyword \"yin.vm.linker.publish.scope\"\n   145\t           (str (pr-str scope-id) \"#\" (swap! ordinal inc))))\n   146\t\n   147\t(defn- spec-admission-token\n   148\t  \"The default admission token: derived deterministically from the\n   149\t   publication specification's own durable identity — the module name\n   150\t   and the content address of its compiled tree — never from hidden\n   151\t   mutable state. Two publications of the same specification therefore\n   152\t   answer the same admission identity (an idempotent re-publication is\n   153\t   the same recorded admission), and distinct specifications never\n   154\t   share one, in this or any other publisher process. A composition\n   155\t   that admits the same specification more than once as separate\n   156\t   admissions passes an `:yin.link.publish/scope` (or an explicit\n   157\t   `:yin.link.publish/admission`) so the admissions stay distinct.\"\n   158\t  [{:keys [name]} tree]\n   159\t  (keyword \"yin.vm.linker.publish.publication\"\n   160\t           (str name \"::\" (:root tree))))\n   161\t\n   162\t(defn- publication-origin\n   163\t  \"The occurrence origin of the publication admission `token` names:\n   164\t   the publisher's own medium, the explicit admission token, member 0.\n   165\t   `token` is the publication's admission identity — the\n   166\t   `:yin.link.publish/admission` option when the composition pins one,\n   167\t   the `:yin.link.publish/scope` option's next drawn token when the\n   168\t   composition scopes the publisher, otherwise the token derived from\n   169\t   the publication specification's own durable identity. The origin is\n   170\t   an admission event's identity, not a function of the tree's content\n   171\t   alone: it is persisted in the side record at publication time and\n   172\t   retrieved from that record; nothing ever reconstructs it from the\n   173\t   root.\"\n   174\t  [token]\n   175\t  [:source :yin.vm.linker.publish/publish token 0])\n   176\t\n   177\t\n   178\t(defn- claims-call-sites?\n   179\t  \"True when map AST `ast` carries the C1 key anywhere. A hit inside a\n   180\t   literal payload is data, not a claim: extraction then finds no\n   181\t   markers and the module publishes unannotated, as it should.\"\n   182\t  [ast]\n   183\t  (boolean (some #(= :yang/call-site %) (tree-seq coll? seq ast))))\n   184\t\n   185\t\n   186\t(defn- call-site-claim\n   187\t  \"The C1 claim `ast` makes over its canonical `tree`: nil when it\n   188\t   carries no markers; `{:origin o :rows [...]}` in printed-row order\n   189\t   when the extracted markers exactly cover the tree's eligible\n   190\t   application occurrences; `{:missing [...] :extra [...]}` when they\n   191\t   do not; `{:unsupported-version v :path p}` when a marker's value is\n   192\t   not version 1 — a claim rejection, never a silent acceptance of a\n   193\t   table a retriever would read as version 1.\"\n   194\t  [ast tree admission]\n   195\t  (when (claims-call-sites? ast)\n   196\t    (let [origin (publication-origin admission)\n   197\t          extracted (filter #(= :yang/call-site (nth % 3))\n   198\t                            (:frontend-metadata\n   199\t                              (vm/ast-side-tables ast tree origin)))\n   200\t          eligible (into #{}\n   201\t                         (map (fn [[r p]] [origin r p]))\n   202\t                         (vm/application-occurrences tree))\n   203\t          marked (into #{}\n   259\t                                        {:name n})\n   260\t                      :missing (when (not= address (:address w))\n   261\t                                 (refusal :yin.link.publish/incomplete-requirement\n   262\t                                          {:name n :walk w})))))\n   263\t                (sort-by (fn [[n _]] (str n)) requires)))\n   264\t        fp (when (and tree (not defect) (not requirement)\n   265\t                      (not= :refused (:status tree)))\n   266\t             (footprint handle (assoc spec :tree tree)))\n   267\t        ;; a C1 claim is validated before anything is written: a module\n   268\t        ;; whose markers do not cover its tree is never published as\n   269\t        ;; though it did. One publication is one admission event\n   270\t        ;; (design §2.1): the admission identity is pinned explicitly by\n   271\t        ;; the composition when it supplies `:yin.link.publish/admission`,\n   272\t        ;; drawn from the composition's own scope object when it supplies\n   273\t        ;; `:yin.link.publish/scope`, and otherwise derived from the\n   274\t        ;; specification's own durable identity — no counter lives in\n   275\t        ;; this namespace. Either way it is persisted in the side record\n   276\t        ;; and retrieved from there\n   277\t        admission (or (:yin.link.publish/admission opts)\n   278\t                      (when-let [scope (:yin.link.publish/scope opts)]\n   279\t                        (scope-admission-token scope))\n   280\t                      (when tree (spec-admission-token spec tree)))\n   281\t        claim (when (and tree (not defect) (not requirement)\n   282\t                         (not= :refused (:status tree))\n   283\t                         (not= :refused (:status fp)))\n   284\t                (call-site-claim ast tree admission))]\n   285\t    (cond\n   286\t      undefined\n   287\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   288\t\n   289\t      (= :refused (:status tree)) tree\n   290\t\n   291\t      defect\n   292\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\n   293\t\n   294\t      requirement requirement\n   295\t\n   420\t                                         nil))))\n   421\t                           (map-indexed vector\n   422\t                                        (get vm/semantic-bytecode-grammar\n   423\t                                             (nth row 1))))]\n   424\t            (recur (into (subvec queue 1)\n   425\t                         (remove #(contains? rows %) kids))\n   426\t                   (assoc rows address row))))))))\n   427\t\n   428\t\n   429\t(defn published-call-site-table\n   430\t  \"The C1 side table the module whose manifest is at `address` in\n   431\t   `handle` claims: `{:origin o :root r :rows [...] :tree tree}` with\n   432\t   the rows exactly as stored and the module's canonical tree, or nil\n   433\t   when the module made no C1 claim. The manifest references the table\n   434\t   and its reverse record (`:yin.module/call-sites`), so the reference —\n   435\t   not a recomputation — is what is resolved here: the rows are fetched\n   436\t   from the referenced table address and the ORIGIN is the one the\n   437\t   record RECORDED at publication (`:yang.call-site/origin`, held to be\n   438\t   a well-formed occurrence origin), beside the record's version, the\n   439\t   manifest's own tree, and the referenced table. Nothing reconstructs\n   440\t   an origin from content: a replay of this retrieval answers the\n   441\t   recorded admission identity, and no other module's admission can be\n   442\t   confused with it.\"\n   443\t  [handle address]\n   444\t  (let [manifest (jing/get handle address nil)\n   445\t        call-sites (:yin.module/call-sites manifest)]\n   446\t    (when (and (map? manifest) (:yin.module/tree manifest)\n   447\t               (map? call-sites) (jing/segment-address? (:table call-sites))\n   448\t               (jing/segment-address? (:record call-sites)))\n   449\t      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\n   450\t        (let [stored-rows (jing/get handle (:table call-sites) nil)\n   451\t              stored-record (jing/get handle (:record call-sites) nil)\n   452\t              origin (:yang.call-site/origin stored-record)]\n   453\t          (when (and (vector? stored-rows)\n   454\t                     (= {:yang.call-site/version 1\n   455\t                         :yang.call-site/root (:yin.module/tree manifest)\n   456\t                         :yang.call-site/table (:table call-sites)}\n   457\t                        (select-keys stored-record\n   458\t                                     [:yang.call-site/version\n   459\t                                      :yang.call-site/root\n   460\t                                      :yang.call-site/table]))\n   461\t                     (vm/occurrence-origin? origin))\n   462\t            {:origin origin, :root (:root tree), :rows stored-rows,\n   463\t             :tree tree}))))))\n   464\t\n   465\t\n   466\t;; =============================================================================\n   467\t;; Deriving a module from indexed code (5.3)\n   468\t;; =============================================================================\n   469\t\n   470\t(defn- indexed-programs\n   471\t  \"Every program the index `db` holds -- a relation of `[e a v t m]` index\n   472\t   datoms, as `yin.repl.index` publishes them -- in ascending `t`, each\n   473\t   `{:m m :t t :ast ast}`: its tree rebuilt from its own facts, those\n   474\t   whose `m` is the program's metadata entity.\"\n   475\t  [db]\n   476\t  (let [by-m (group-by #(nth % 4)\n   477\t                       (query/collect\n   478\t                         (query/q '[:find ?e ?a ?v ?t ?m :where [?e ?a ?v ?t ?m]]\n   479\t                                  db)))]\n   480\t    (mapv (fn [[m t]] {:m m :t t :ast (vm/datoms->ast (vec (get by-m m)))})\n   481\t          (sort-by (juxt second first)\n   482\t                   (query/collect\n   483\t                     (query/q '[:find ?m ?t :where [?m :yin.repl/root _ ?t _]]\n   484\t                              db))))))\n   485\t\n   486\t\n   487\t(defn requirements\n   488\t  \"The modules `ast` unconditionally requires at module level. Scan literal\n   489\t   `(require 'm)` applications outside lambda bodies, except immediately\n   490\t   applied lambdas. Conditional branches and try-require remain deferred.\"\n   491\t  [ast]\n   492\t  (requirements/eager ast))\n   493\t\n   494\t\n   495\t(defn- free-of\n   640\t(defn- sequence-body\n   641\t  \"The reference `do` lowering: `(do a b c)` is `((fn [_] ((fn [_] c) b)) a)`;\n   642\t   one form is itself and none is the literal nil.\"\n   643\t  [trees]\n   644\t  (let [trees (vec trees)]\n   645\t    (doseq [t trees] (need-packet 'yin/sequence-body t))\n   646\t    (case (count trees)\n   647\t      0 (literal-packet nil)\n   648\t      1 (first trees)\n   649\t      (application-packet (lambda-packet ['_] (sequence-body (subvec trees 1)))\n   650\t                          [(first trees)]))))\n   651\t\n   652\t\n   653\t(defn- slot-of\n   654\t  [tree n]\n   655\t  (let [row (root-row (need-packet 'yin/slot tree))\n   656\t        kinds (into {} (slot-kinds (row-tag row)))\n   657\t        index (packet-index tree)]\n   658\t    (when-not (and (integer? n) (contains? kinds n))\n   659\t      (throw-prelude \"yin/slot position names no grammar slot\"\n   660\t                     {:op 'yin/slot, :position n}))\n   661\t    (case (get kinds n)\n   662\t      :node (packet-of index (nth row n))\n   663\t      :nodes (mapv #(packet-of index %) (nth row n))\n   664\t      (nth row n))))\n   665\t\n   666\t\n   667\t(defn prelude\n   668\t  \"The closed body environment (§5.3): the pure standard primitives (no\n   669\t   `require`, no stream or FFI constructor) and the row-native constructors,\n   670\t   each consuming and returning self-contained tree packets. `gensym` is the\n   671\t   invocation-local `yin/gensym-sym`.\"\n   672\t  [gensym]\n   673\t  (merge\n   674\t    (dissoc vm/primitives 'require 'try-require 'bytes->str)\n   675\t    {'yin/tag (fn [tree] (row-tag (root-row (need-packet 'yin/tag tree)))),\n   676\t     'yin/slot slot-of,\n   677\t     'yin/literal literal-packet,\n   678\t     'yin/variable (fn [sym]\n   679\t                     (when-not (symbol? sym)\n   680\t                       (throw-prelude \"yin/variable expects a symbol\" {:op 'yin/variable}))\n   681\t                     (construct [:variable sym] [])),\n   682\t     'yin/lambda (fn [params body] (lambda-packet params (need-packet 'yin/lambda body))),\n   683\t     'yin/application (fn [operator operands]\n   684\t                        (need-packet 'yin/application operator)\n   685\t                        (doseq [o operands] (need-packet 'yin/application o))\n   686\t                        (application-packet operator (vec operands))),\n   687\t     'yin/if (fn [t c a]\n   688\t               (doseq [x [t c a]] (need-packet 'yin/if x))\n   689\t               (construct [:if (first t) (first c) (first a)] [t c a])),\n   690\t     'yin/sequence-body sequence-body,\n   691\t     'yin/make-lambda (fn [params-tree body]\n   692\t                        (let [row (root-row (need-packet 'yin/make-lambda params-tree))]\n   693\t                          (when-not (and (= :literal (row-tag row))\n   694\t                                         (vector? (nth row 2))\n   695\t                                         (every? symbol? (nth row 2)))\n   696\t                            (throw-prelude \"yin/make-lambda reads a literal parameter vector\"\n   697\t                                           {:op 'yin/make-lambda}))\n   698\t                          (lambda-packet (nth row 2) (need-packet 'yin/make-lambda body)))),\n   699\t     'yin/make-def (fn [name-tree value-tree]\n   700\t                     (application-packet (construct [:variable 'yin/def] [])\n   701\t                                         [(literal-packet (name-of name-tree))\n   702\t                                          (need-packet 'yin/make-def value-tree)])),\n   703\t     'yin/name-of name-of,\n   704\t     'yin/gensym-sym gensym}))\n   705\t\n   706\t\n   707\t(def ^:private suspending-tags\n   708\t  #{:vm/park :vm/resume :dao.stream.apply/call})\n   709\t\n   710\t\n  1250\t\n  1251\t\n  1252\t(defn- final-call-site-metadata\n  1253\t  \"The call-site occurrence contract's (C1) side table of an expanded\n  1254\t   final tree, as frontend-metadata rows `[origin root path\n  1255\t   :yang/call-site 1]` in printed-row order: one row per\n  1256\t   `:application` occurrence of the stand-in-lowered, tail-marked tree\n  1257\t   that actually executes. The frontend's own markers named the\n  1258\t   pre-expansion tree; expansion, tail marking and stand-in lowering\n  1259\t   recompute roots and paths, so no pre-expansion table can cover this\n  1260\t   tree and the table is finalized here, over the finished rows.\n  1261\t\n  1262\t   Each row's origin is that occurrence's REAL origin (design §2.1,\n  1263\t   §2.3): `occurrence-origins` maps the final occurrence path to the\n  1264\t   origin of the admission or generation event that produced the\n  1265\t   application syntax at that path — the admitted run member's source\n  1266\t   origin for retained syntax (a no-op expansion keeps it valid), and\n  1267\t   the `[:expansion record-address]` of the recorded expansion event\n  1268\t   whose output introduced generated syntax. No expansion-record\n  1269\t   address is fabricated: only event rows the expander actually\n  1270\t   recorded appear. The table is therefore the explicit\n  1271\t   final-root correspondence §2.3 requires — every generated occurrence\n  1272\t   names its producing record, so an attribution consumer can reach the\n  1273\t   event (its input root, call path, macro root, output root) from the\n  1274\t   row alone.\"\n  1275\t  [row-set occurrence-origins admission-origin]\n  1276\t  (vec (sort-by pr-str\n  1277\t                (map (fn [[root path]]\n  1278\t                       [(get occurrence-origins path admission-origin)\n  1279\t                        root path :yang/call-site 1])\n  1280\t                     (vm/application-occurrences row-set)))))\n  1281\t\n  1282\t\n  1283\t(defn expand-batch\n  1284\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1285\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1286\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1287\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1288\t   success changes the store, to the post-harvest store. A success also\n  1289\t   carries `:frontend-metadata` — the C1 side table finalized over the\n  1290\t   final tree (`final-call-site-metadata`), covering the tree that\n  1291\t   actually executes — when, and only when, the selected member itself\n  1292\t   claimed C1 coverage (its own verdict in `batch-call-site-claims`); a\n  1293\t   sibling's claim never manufactures a table for it, and an unclaimed\n  1294\t   batch carries no table at all, never an empty one. The admission\n  1295\t   this expansion produced the tree under rides beside it as\n  1296\t   `:call-site-origin` — the source origin of the admitted run member,\n  1297\t   the key the table is stored and resolved under beside the final\n  1298\t   root address. It is the table's admission key, not a blanket\n  1299\t   stamp: each row's origin is that occurrence's own (§2.1, §2.3) —\n  1300\t   a retained occurrence keeps its own incoming provenance (its\n  1301\t   source origin, or the generating expansion's, however deeply it\n  1302\t   was passed through), and generated syntax carries the\n  1303\t   `[:expansion record-address]` of the recorded expansion event\n  1304\t   whose output introduced it. A context\n  1305\t   store binding a\n  1306\t   reserved name, or holding an entry without the current AST contract,\n  1307\t   is refused (Rule R): it is a composition defect, so it throws rather\n  1308\t   than returning an error.\"\n  1309\t  [batch ctx]\n  1310\t  (check-store! (:store ctx))\n  1311\t  (let [ctx (with-default-guards ctx)\n  1312\t        source-batch (:t ctx)\n  1313\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1314\t        finish (fn [st]\n  1315\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1316\t                   (if-let [e (:error st)]\n  1317\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1318\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1319\t                      :frontend-metadata (:frontend-metadata st),\n  1320\t                      :call-site-origin (:call-site-origin st),\n  1321\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1322\t        {:keys [admitted error]} (admit batch)]\n  1323\t    (if error\n  1324\t      (let [[st counter] (allocate-attempt base)]\n  1325\t        (finish (-> st\n  1326\t                    (record-event (event-row (attempt-id ctx counter) source-batch\n  1327\t                                             (source-origin ctx source-batch nil)\n  1328\t                                             nil nil nil nil nil error))\n  1329\t                    (fail error))))\n  1330\t      (let [{:keys [trees indexes index run-index definitions]} admitted\n  1331\t            store0 (or (:store ctx) {})\n  1332\t            store (harvest store0 #(nth indexes %) definitions)\n  1333\t            catalogue (into []\n  1334\t                            (comp (filter :declared?)\n  1335\t                                  (map (fn [{:keys [name tree path value]}]\n  1336\t                                         {:name name,\n  1337\t                                          :macro-tree (packet-of (nth indexes tree) value),\n  1338\t                                          :source [tree path]})))\n  1339\t                            definitions)\n  1340\t            ;; only the run tree is expanded, so only its declarations are\n  1341\t            ;; replaced; every catalogue entry still resolves by index\n  1342\t            [index standins]\n  1343\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1344\t                      (if (= run-index (first source))\n  1345\t                        (let [[index s] (intern-body index [standin-tag name k])]\n  1346\t                          [index (assoc acc (second source) s)])\n  1347\t                        [index acc]))\n  1348\t                    [index {}]\n  1349\t                    (map-indexed vector catalogue))\n  1350\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n  1351\t            st (assoc base :index index :store store)]\n  1352\t        (if-let [e (guard-batch-rows st)]\n  1353\t          (finish (fail st e))\n  1354\t          (let [[st root'] (expand-node st root\n  1355\t                                        {:path [], :rel [],\n  1356\t                                         :frame {:parent nil, :root root,\n  1357\t                                                 :tree-index run-index},\n  1358\t                                         :shadow #{}, :depth 0,\n  1359\t                                         ;; every syntax of the admitted\n  1360\t                                         ;; run tree starts as source\n  1361\t                                         ;; (§2.1); expansions override\n  1362\t                                         ;; below their outputs\n  1363\t                                         :origin-of\n  1364\t                                         (fn [_]\n  1365\t                                           (source-origin\n  1366\t                                             ctx source-batch run-index))})]\n  1367\t            (if (:error st)\n  1368\t              (finish st)\n  1369\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1370\t                    [index root'] (retail (:index st) root')\n  1371\t                    [index root'] (lower-standins index root')\n  1372\t                    tree (packet-of index root')\n  1373\t                    ;; the ADMISSION origin of this expansion (§2.1):\n  1374\t                    ;; the admitted run member's source origin — the key\n  1375\t                    ;; the side table is stored and resolved under beside\n  1376\t                    ;; the final root address. It is NOT blindly stamped\n  1377\t                    ;; on every row: each row's own origin is the one the\n  1378\t                    ;; occurrence walk recorded (source for retained\n  1379\t                    ;; syntax, the generating event's `[:expansion …]`\n  1380\t                    ;; for generated syntax)\n  1381\t                    origin (source-origin ctx source-batch run-index)\n  1382\t                    ;; the selected member's own verdict decides its\n  1383\t                    ;; metadata; a sibling's claim never manufactures a\n  1384\t                    ;; table for a member that made none\n  1385\t                    claims (batch-call-site-claims batch)\n  1386\t                     metadata (when (and claims (nth claims run-index))\n  1387\t                                (final-call-site-metadata\n  1388\t                                  (packet->row-set tree)\n  1389\t                                  (:call-site-origins st) origin))]\n  1390\t                (if-let [e (valid-tree? tree)]\n  1391\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1392\t                  (finish (assoc st :tree tree :next-store next-store\n  1393\t                                 :frontend-metadata metadata\n  1394\t                                  :call-site-origin (when metadata origin))))))))))))\n  1395\t\n  1396\t\n  1397\t(defn expand\n  1398\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1399\t   the error data.\"\n  1400\t  [batch ctx]\n  1401\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1402\t    (if (= :ok status)\n  1403\t      tree\n  1404\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1405\t\n  1406\t\n  1407\t(defn make-ctx\n  1408\t  \"An expander context. The composition supplies the incarnation `token`\n  1409\t   and the opaque `source-medium` identity (S3.1); the store may be\n  1410\t   seeded with `macro-entry` values. A seeded store binding a reserved\n  1411\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\n  1412\t   whose AST contract is absent (`:contract-missing`) or old\n  1413\t   (`:contract-mismatch`).\"\n  1414\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n  1415\t  (cond-> {:store (check-store! (or store {})),\n  1416\t           :incarnation {:yin.expander/token token},\n  1417\t           :attempt 0,\n  1418\t           :source-medium source-medium,\n  1419\t           :t 0,\n  1420\t           :guards (merge default-guards guards)}\n  1421\t    eval-fn (assoc :eval eval-fn)))\n  1422\t\n  1423\t\n  1424\t;; =============================================================================\n  1425\t;; Standard forms (§5.4)\n  1500\t   occurrence identity keeps their tables distinct, so resolving by the\n  1501\t   origin+root pair at hand never answers another execution's table,\n  1502\t   however many loads have run since, and an unclaimed load of a root\n  1503\t   previously loaded under a claim retrieves no stale table.\"\n  1504\t  [expander tree origin]\n  1505\t  (get (:call-site-tables expander) [origin (first tree)]))\n  1506\t\n  1507\t\n  1508\t(defn load\n  1509\t  \"Expand one observed batch once: keep the returned context, stage the\n  1510\t   tree only on success, stage the log when a log writer exists, and\n  1511\t   accumulate the error of a failed expansion. Expansion failure is\n  1512\t   data, so the cursor advances past it. A successful expansion's C1\n  1513\t   side table (the batch result's `:frontend-metadata`, present only\n  1514\t   when the selected member itself claimed coverage) is retained on the\n  1515\t   consumer under the occurrence identity of the staged tree — its\n  1516\t   admission origin beside its final root address (`call-site-tables`,\n  1517\t   resolved by `call-site-table`) — so the composition that drives this\n  1518\t   expander — the REPL's session — holds every executed occurrence's\n  1519\t   coverage beside the expander that produced it, each load's table\n  1520\t   surviving the next, even when two loads land on the same root.\"\n  1521\t  [expander batch]\n  1522\t  (let [{:keys [status tree log error ctx frontend-metadata\n  1523\t                call-site-origin]}\n  1524\t        (expand-batch batch (:ctx expander))]\n  1525\t    (cond-> (assoc expander :ctx ctx)\n  1526\t      (= :ok status) (assoc :out-staged tree)\n  1527\t      (and (= :ok status) frontend-metadata)\n  1528\t      (assoc-in [:call-site-tables [call-site-origin (first tree)]]\n  1529\t                frontend-metadata)\n  1530\t      (:log expander) (assoc :log-staged log)\n  1531\t      (= :error status) (update :errors conj error))))\n  1532\t\n  1533\t\n  1534\t(defn- flush-slot\n  1535\t  [expander writer-key slot-key on-ok]\n  1536\t  (if-let [payload (get expander slot-key)]\n  1537\t    (let [outcome (:dao.stream/outcome (stream/append! (get expander writer-key) payload))]\n  1538\t      (case outcome\n  1539\t        :dao.stream/ok (on-ok (assoc expander slot-key nil))\n  1540\t        :dao.stream/full expander\n  1541\t        (throw (ex-info \"Expander could not publish a staged value\"\n  1542\t                        {:dao.stream/outcome outcome,\n  1543\t                         :destination slot-key,\n  1544\t                         :consumer expander}))))\n  1545\t    expander))\n  1546\t\n  1547\t\n  1548\t(defn flush\n  1549\t  \"Append each staged payload to its own destination (§9): `ok` clears only\n  1550\t   that slot (and counts a forwarded program), `full` retains the exact\n  1551\t   payload for retry, anything else throws with the outcome and the\n  1552\t   consumer's remaining staged slots under `:consumer`.\"\n  1553\t  [expander]\n  1554\t  ;; A log failure after a published program carries the cleared program\n  1555\t  ;; slot, so recovery never republishes it.\n  1556\t  (-> expander\n  1557\t      (flush-slot :out :out-staged #(update % :forwarded inc))\n  1558\t      (flush-slot :log :log-staged identity)))\n  1559\t\n  1560\t\n  1561\t(defn step\n  1562\t  \"Drive one expander session `{:observer o :consumer expander}` over\n  1563\t   `program-in` until it blocks, ends, or cannot flush.\"\n  1564\t  [session]\n  1565\t  (observer/run-on-stream session ready? load flush))\n  1566\t\n  1567\t\n  1568\t(defn drain-errors\n  1569\t  \"Read and reset `:errors` and `:forwarded`. Accepts a session or the bare\n  1570\t   consumer and returns `[same-shape' {:errors errors :forwarded n}]`.\"\n  1571\t  [x]\n  1572\t  (let [session? (contains? x :consumer)\n  1573\t        c (if session? (:consumer x) x)\n  1574\t        summary {:errors (:errors c), :forwarded (:forwarded c)}\n  1575\t        c' (assoc c :errors [] :forwarded 0)]\n   135\t       (= call-site-key (nth row 3))))\n   136\t\n   137\t\n   138\t(defn validate-call-site-coverage!\n   139\t  \"Validate a complete-coverage C1 claim: the marker set of\n   140\t   `frontend-metadata` for canonical `tree` under `origin` must equal\n   141\t   the eligible application set. Returns true when the claim holds.\n   142\t\n   143\t   A row that claims the C1 key but is not a five-coordinate\n   144\t   `[origin root-address path key value]` row is malformed and is\n   145\t   rejected, never silently filtered. The delivery mode is `opts`:\n   146\t\n   147\t   - default (transport): the relation arrived over a medium, where an\n   148\t     at-least-once delivery may repeat a row; duplicate identical\n   149\t     deliveries dedupe to the same fact;\n   150\t   - `{:declared? true}`: the relation is a declared canonical table —\n   151\t     the side table a producer published as the tree's table — where a\n   152\t     duplicate entry is a second, conflicting claim to one fact and is\n   153\t     rejected;\n   154\t   - `{:per-occurrence-origins? true}`: the tree's occurrences do not\n   155\t     share one origin — the expander's final tree, whose rows carry\n   156\t     each occurrence's own admission or generating-expansion origin\n   157\t     (design §2.1, §2.3). Coverage is then compared on the\n   158\t     `[root-address path]` projection — the part a consumer derives\n   159\t     from canonical rows alone — and every marker's origin is held to\n   160\t     a well-formed occurrence origin; the origin VALUES are the\n   161\t     producer's correspondence claim, not something a consumer can\n   162\t     re-derive.\n   163\t\n   164\t   Conflicting values at one site, an unsupported marker version, a\n   165\t   malformed origin, a marker naming no occurrence, a marker on a\n   166\t   non-application occurrence, and missing or extra markers each\n   167\t   throw, naming the failed `:rule`.\"\n   168\t  ([tree frontend-metadata origin]\n   169\t   (validate-call-site-coverage! tree frontend-metadata origin {}))\n   170\t  ([tree frontend-metadata origin\n   171\t    {:keys [declared? per-occurrence-origins?] :as _opts}]\n   172\t   (doseq [row frontend-metadata]\n   173\t     (when (and (marker-row? row) (not= 5 (count row)))\n   174\t       (throw (ex-info \"Malformed call-site marker row\"\n   175\t                       {:rule :yang/call-site-malformed, :row row}))))\n   176\t   (when declared?\n   177\t     (doseq [[row n] (frequencies (filter marker-row? frontend-metadata))]\n   178\t       (when (< 1 n)\n   179\t         (throw (ex-info \"Duplicate call-site marker in a declared table\"\n   180\t                         {:rule :yang/call-site-duplicate-entry,\n   181\t                          :site (vec (take 3 row)), :row row})))))\n   182\t   (let [{:keys [root rows]} tree\n   183\t         tag-at (into {}\n   184\t                      (map (fn [[r path id]] [[r path] (nth (get rows id) 1)]))\n   185\t                      (vm/occurrences tree))\n   186\t         eligible ((if per-occurrence-origins?\n   187\t                     (fn [_] (vm/application-occurrences tree))\n   188\t                     #(eligible-application-sites tree %))\n   189\t                   origin)\n   190\t         rows (filter (fn [row]\n   191\t                        (and (= 5 (count row)) (= call-site-key (nth row 3))))\n   192\t                      (distinct frontend-metadata))\n   193\t         by-site (group-by (fn [[o r path _ _]] [o r path]) rows)]\n   235\t                           :site [o r path], :tag tag})))))\n   236\t    (let [marked (if per-occurrence-origins?\n   237\t                   (into #{}\n   238\t                         (map (fn [[_ r path]] [r path]))\n   239\t                         (marked-application-