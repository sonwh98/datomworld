et [[st counter] (allocate-attempt st)\n  1077\t        ctx (:ctx st)\n  1078\t        macro-root (first (:yin.macro/tree entry))\n  1079\t        ;; every output row whose content address is one of the input's\n  1080\t        ;; own rows is the admitted syntax retained — a no-op expansion\n  1081\t        ;; or an operand passed through — and keeps ITS OWN incoming\n  1082\t        ;; provenance (§2.1): the origin the enclosing walk's\n  1083\t        ;; `origin-of` already answers for that address, which need not\n  1084\t        ;; be the replaced application's origin (an operand packet may\n  1085\t        ;; carry syntax of mixed origin); rows the expansion itself\n  1086\t        ;; generated take the event's origin below\n  1087\t        input-addrs (into #{address}\n  1088\t                          (map first)\n  1089\t                          (second (packet-of (:index st) address)))\n  1090\t        begin (fn [output error]\n  1091\t                (event-row (attempt-id ctx counter)\n  1092\t                           (:source-batch st)\n  1093\t                           (when-not (:parent frame)\n  1094\t                             (source-origin ctx (:source-batch st) (:tree-index frame)))\n  1095\t                           (:parent frame)\n  1096\t                           (:root frame)\n  1097\t                           rel\n  1098\t                           macro-root\n  1099\t                           output\n  1100\t                           error))\n  1101\t        failed (fn [st error]\n  1102\t                 (-> st (record-event (begin nil error)) (fail error)))\n  1103\t        guards (:guards ctx)]\n  1104\t    (if (>= depth (:max-depth guards))\n  1105\t      [(failed st {:kind :depth-guard, :depth depth, :path path}) address]\n  1106\t      (let [row (get (:index st) address)\n  1107\t            operands (mapv #(packet-of (:index st) %) (nth row 3))\n  1108\t            {:keys [tree error]} (invoke* entry operands ctx counter)\