{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"git diff -- test/yang/clojure_callsite_test.cljc; nl -ba src/cljc/yin/repl.cljc | sed -n '1217,1285p'; nl -ba src/cljc/yin/repl.cljc | sed -n '1716,1788p'\"","aggregated_output":"diff --git a/test/yang/clojure_callsite_test.cljc b/test/yang/clojure_callsite_test.cljc\nindex 6bbd258b..e8ebd908 100644\n--- a/test/yang/clojure_callsite_test.cljc\n+++ b/test/yang/clojure_callsite_test.cljc\n@@ -1451,7 +1451,8 @@\n               and publishes its side table\"\n       (let [spec (publish/module-from-index\n                    db {:name 'closed :exports '[g] :primitives vm/primitives\n-                       :call-site-tables tables})\n+                       :call-site-tables tables\n+                       :call-site-admissions (repl/call-site-admissions state)})\n             store (mem/create-content-mem)\n             res (publish/publish-module! store spec)]\n         (is (not= :refused (:status spec)))\n@@ -1699,7 +1700,8 @@\n                         tables)\n             spec (publish/module-from-index\n                    db {:name 'closed :exports '[g] :primitives vm/primitives\n-                       :call-site-tables stale})]\n+                       :call-site-tables stale\n+                       :call-site-admissions (repl/call-site-admissions state)})]\n         (is (claim-free? spec)\n             \"identical content under a different admission is not borrowed\")))\n     (testing \"a wrong-version retained table proves nothing\"\n@@ -1711,7 +1713,8 @@\n                       tables))\n             spec (publish/module-from-index\n                    db {:name 'closed :exports '[g] :primitives vm/primitives\n-                       :call-site-tables bad})]\n+                       :call-site-tables bad\n+                       :call-site-admissions (repl/call-site-admissions state)})]\n         (is (claim-free? spec))))\n     (testing \"an incomplete retained table proves nothing\"\n       (let [bad (into {}\n@@ -1720,7 +1723,8 @@\n                       tables))\n             spec (publish/module-from-index\n                    db {:name 'closed :exports '[g] :primitives vm/primitives\n-                       :call-site-tables bad})]\n+                       :call-site-tables bad\n+                       :call-site-admissions (repl/call-site-admissions state)})]\n         (is (claim-free? spec))))))\n \n \n@@ -1745,3 +1749,106 @@\n           (is (some? response))\n           (is (= tables (:call-site-tables @captured))\n               \"ordinary yin.link/publish now carries the retained tables\"))))))\n+\n+;; =============================================================================\n+;; cc2 fix round r3: admission identity + explicit wrappers (astra r2 confirm)\n+;; =============================================================================\n+\n+(defn- r3-claim-free?\n+  \"True when `spec` carries no C1 claim and publishes with no side table.\"\n+  [spec]\n+  (let [tree (vm/ast->semantic-bytecode (:ast spec))\n+        side (vm/ast-side-tables (:ast spec) tree origin)\n+        res (publish/publish-module! (mem/create-content-mem) spec)]\n+    (and (empty? (filter #(= :yang/call-site (nth % 3))\n+                         (:frontend-metadata side)))\n+         (not (contains? spec :call-site-rows))\n+         (jing/segment-address? (:address res))\n+         (not (contains? res :call-sites)))))\n+\n+(defn- r3-programs\n+  \"The indexed programs of `db` as `[m root t]` rows.\"\n+  [db]\n+  (query/collect\n+    (query/q '[:find ?m ?r ?t :where [?m :yin.repl/root ?r ?t _]] db)))\n+\n+(deftest module-from-index-c1-r3-test\n+  (let [{:keys [state db]} (session-index [\"(def k (fn [] 1))\"\n+                                           \"(def g (fn [] (+ (k) 41)))\"])\n+        tables (repl/call-site-tables state)\n+        admissions (repl/call-site-admissions state)\n+        programs (r3-programs db)\n+        spec-of (fn [ts ads]\n+                  (publish/module-from-index\n+                    db {:name 'closed :exports '[g] :primitives vm/primitives\n+                        :call-site-tables ts :call-site-admissions ads}))]\n+    (is (seq admissions)\n+        \"the session records an explicit indexed-program admission mapping\")\n+    (is (every? (fn [[m o]] (and (contains? (set (map first programs)) m)\n+                                 (vm/occurrence-origin? o)))\n+                  admissions)\n+        \"the mapping is keyed by indexed program, valued by full origin\")\n+    (testing \"(a) a sole foreign table with the same root and batch but a\n+              different medium/member is not accepted\"\n+      (let [foreign (into {}\n+                          (map (fn [[[o root] rs]]\n+                                 [[[:source \"foreign-medium\" (nth o 2) 99]\n+                                   root] rs]))\n+                          tables)]\n+        (is (r3-claim-free? (spec-of foreign admissions))\n+            \"counter equality with a foreign admission proves nothing\")))\n+    (testing \"(b) the drift collision publishes claim-free, not borrowed:\n+              a second admission of one root at batch+1, whose indexed\n+              program carries the first admission's batch as its t, and\n+              for which no explicit mapping is supplied\"\n+      (let [[[o root] rows] (first tables)\n+            m (some (fn [[m r _t]] (when (= r root) m)) programs)\n+            drifted (assoc tables [[:source (nth o 1) (inc (nth o 2))\n+                                    (nth o 3)] root] rows)\n+            ads (dissoc admissions m)]\n+        (is (some? m))\n+        (is (r3-claim-free? (spec-of drifted ads))\n+            \"the drifted program's table is never borrowed from batch t\")))\n+    (testing \"(b2) an explicit mapping resolves exactly despite drift:\n+              the mapped origin's batch differs from the program's t\"\n+      (let [[[o root] rows] (first tables)\n+            [m _r t] (some (fn [[m r t]] (when (= r root) [m r t])) programs)\n+            b-origin [:source (nth o 1) (inc (nth o 2)) (nth o 3)]\n+            b-rows (assoc-in (vec rows) [0 0] b-origin)\n+            drifted (assoc tables [b-origin root] b-rows)\n+            spec (spec-of drifted (assoc admissions m b-origin))]\n+        (is (not= (inc (nth o 2)) t) \"precondition: mapped batch is not t\")\n+        (is (seq (:call-site-rows spec)))\n+        (is (some #(= b-origin (first %)) (:call-site-rows spec))\n+            \"resolution followed the explicit [origin root] key, not t\")))\n+    (testing \"(c) a deleted retained row is refused at publication, not\n+              reassigned to the publication origin\"\n+      (let [spec (spec-of tables admissions)\n+            deleted (first (:call-site-rows spec))\n+            tampered (update spec :call-site-rows (fn [rs] (vec (rest rs))))\n+            res (publish/publish-module! (mem/create-content-mem) tampered)]\n+        (is (seq (:call-site-rows spec)))\n+        (is (= :refused (:status res)) (pr-str res))\n+        (is (= :yin.link.publish/incomplete-call-site-coverage (:reason res)))\n+        (is (contains? (set (:missing res)) [(nth deleted 1) (nth deleted 2)])\n+            \"the refusal names the deleted occurrence as unmapped\")))\n+    (testing \"a tampered wrapper set is refused: the wrapper applications\n+              are the assembly's explicit set, not every uncovered site\"\n+      (let [spec (spec-of tables admissions)\n+            tampered (update spec :call-site-wrappers pop)\n+            res (publish/publish-module! (mem/create-content-mem) tampered)]\n+        (is (seq (:call-site-wrappers spec))\n+            \"assembly emits the explicit wrapper occurrence set\")\n+        (is (= :refused (:status res)) (pr-str res))))\n+    (testing \"(d) []/nil supplied rows publish claim-free, not fully claimed\"\n+      (let [spec (spec-of tables admissions)]\n+        (doseq [empty-rows [[] nil]]\n+          (let [res (publish/publish-module!\n+                      (mem/create-content-mem)\n+                      (assoc spec :call-site-rows empty-rows))]\n+            (is (jing/segment-address? (:address res)) (pr-str res))\n+            (is (not (contains? res :call-sites))\n+                \"an empty supplied table claims no application\")))))\n+    (testing \"(d2) []/nil supplied tables publish claim-free from the index\"\n+      (doseq [ts [[] nil {}]]\n+        (is (r3-claim-free? (spec-of ts admissions)))))))\n  1217\t(defn call-site-admissions\n  1218\t  \"The explicit indexed-program -> full-admission-origin mapping the\n  1219\t   session records at the point where the expander and the code indexer\n  1220\t   agree: the round in which the expander staged a program (retaining\n  1221\t   its table under `[admission-origin final-root]`) is the round in\n  1222\t   which the indexer committed that same program, so the newly indexed\n  1223\t   program's metadata entity is paired with that entry's full origin\n  1224\t   (`yin.vm.linker.publish/module-from-index`'\n  1225\t   `:call-site-admissions` option). No counter is compared: a program\n  1226\t   the round cannot pair uniquely is left unmapped, and recovery for\n  1227\t   it is refused. Empty before any claimed, indexed expansion.\"\n  1228\t  [state]\n  1229\t  (:call-site-admissions state))\n  1230\t\n  1231\t\n  1232\t(defn- indexed-program-roots\n  1233\t  \"The `[metadata-entity root]` of every program the indexer has\n  1234\t   published, or nil when the published index cannot be read.\"\n  1235\t  [indexer]\n  1236\t  (try\n  1237\t    (when (:manifest-address indexer)\n  1238\t      (into []\n  1239\t            (comp (filter (fn [[_e a _v _t _m]] (= :yin.repl/root a)))\n  1240\t                  (map (fn [[e _a v _t _m]] [e v])))\n  1241\t            (space-index/read-datoms (:content-store indexer)\n  1242\t                                     (:manifest-address indexer))))\n  1243\t    (catch #?(:cljd Object :clj Exception :cljs :default) _\n  1244\t      nil)))\n  1245\t\n  1246\t\n  1247\t(defn- record-call-site-admissions\n  1248\t  \"Pair each table entry the expander retained since `tables-before`\n  1249\t   with the indexed program this round committed under the same root,\n  1250\t   recording `{metadata-entity full-admission-origin}` on `state`.\n  1251\t   Only a uniquely identifiable program is paired; anything else is\n  1252\t   left unmapped (fail-closed), never inferred from counters.\"\n  1253\t  [tables-before state]\n  1254\t  (let [new-entries (into {}\n  1255\t                          (remove (fn [[k _]]\n  1256\t                                    (contains? tables-before k)))\n  1257\t                          (or (call-site-tables state) {}))]\n  1258\t    (if (empty? new-entries)\n  1259\t      state\n  1260\t      (if-let [programs (indexed-program-roots (:indexer state))]\n  1261\t        (reduce (fn [st [[origin root] _rows]]\n  1262\t                  (let [candidates\n  1263\t                        (filter (fn [[m r]]\n  1264\t                                  (and (= r root)\n  1265\t                                       (not (contains?\n  1266\t                                              (:call-site-admissions st)\n  1267\t                                              m))))\n  1268\t                                programs)]\n  1269\t                    (if (= 1 (count candidates))\n  1270\t                      (assoc-in st [:call-site-admissions\n  1271\t                                    (ffirst candidates)]\n  1272\t                                origin)\n  1273\t                      st)))\n  1274\t                (update state :call-site-admissions #(or % {}))\n  1275\t                new-entries)\n  1276\t        state))))\n  1277\t\n  1278\t\n  1279\t(defn- run-expander-stage\n  1280\t  \"Drive the expander over `program-in` and drain its summary.  It expands\n  1281\t   each observed batch and appends the tree packet to `program-out`; a\n  1282\t   failed expansion forwards nothing, yet its cursor advances (yin.vm.macro.md\n  1283\t   decision 12).  Returns the state with the expander's progress and the\n  1284\t   drained `{:errors :forwarded}` summary.\"\n  1285\t  [state]\n  1716\t   The observers recover across a gap on their own, but the shell reads the\n  1717\t   gap counts around the round: an increase on any medium means one or more\n  1718\t   batches were never run, so resuming as though execution were complete\n  1719\t   would report a result built on programs the VM never saw.  The loss is\n  1720\t   reported and the shell refuses further evaluation until `(reset)`.\n  1721\t\n  1722\t   A completed program's lexical environment does not outlive it: the VM's\n  1723\t   environment is restored to the one the round began with, as `vm/eval`\n  1724\t   does.  A round that throws is consumed by `consume-failed-round`.\"\n  1725\t  [state program]\n  1726\t  (if (:ingress-loss? state)\n  1727\t    [state (str \"Error: \" ingress-loss-text)]\n  1728\t    (let [state' (update (inject-last-value state) :round inc)\n  1729\t          tables-before (call-site-tables state')\n  1730\t          batch (encoder/program-batch program)\n  1731\t          append (stream/append! (:program-stream state') batch)]\n  1732\t      (if-not (= :dao.stream/ok (:dao.stream/outcome append))\n  1733\t        [state (str \"Error: program batch not ingested: \"\n  1734\t                    (name (:dao.stream/outcome append)))]\n  1735\t        (let [expanded (try\n  1736\t                         (run-expander-stage state')\n  1737\t                         (catch #?(:cljd Object\n  1738\t                                   :clj Exception\n  1739\t                                   :cljs js/Error) error\n  1740\t                           {:failed (consume-failed-round state error)}))]\n  1741\t          (if-let [failed (:failed expanded)]\n  1742\t            failed\n  1743\t            (let [[expanded {:keys [errors forwarded]}] expanded\n  1744\t                  indexed (cond-> expanded\n  1745\t                            (pos? forwarded)\n  1746\t                            (-> run-index-stage\n  1747\t                                run-ast-index-stage\n  1748\t                                ((fn [s]\n  1749\t                                   (record-call-site-admissions\n  1750\t                                     tables-before s)))))]\n  1751\t              (with-index-notice\n  1752\t                (cond\n  1753\t                  (> (ingress-gaps indexed) (ingress-gaps state'))\n  1754\t                  [(assoc indexed :ingress-loss? true)\n  1755\t                   (str \"Error: \" ingress-loss-text)]\n  1756\t\n  1757\t                  (pos? forwarded) (run-evaluation state indexed)\n  1758\t\n  1759\t                  :else [(assoc indexed :vm (:vm state))\n  1760\t                         (format-expansion-errors errors)])\n  1761\t                (when (pos? forwarded)\n  1762\t                  [(index/notice (:indexer expanded) (:indexer indexed))\n  1763\t                   (ast-index/notice (:ast-indexer indexed))])))))))))\n  1764\t\n  1765\t\n  1766\t(defn- installed-text\n  1767\t  \"The languages and ids `catalog` holds, for a refused selection to name:\n  1768\t   a name that is neither is a typo, not a missing frontend.\"\n  1769\t  [catalog]\n  1770\t  (let [entries (:yang.frontend/entries catalog)\n  1771\t        listed (fn [xs] (str/join \" \" (map pr-str (sort (distinct xs)))))]\n  1772\t    (str \"installed: \"\n  1773\t         (listed (map (comp :yang.frontend/language :manifest) (vals entries)))\n  1774\t         \" (ids \" (listed (map first (keys entries))) \")\")))\n  1775\t\n  1776\t\n  1777\t(defn- select-frontend\n  1778\t  \"Select the frontend `lang` names in `catalog`: a qualified id selects\n  1779\t   by id (ambiguous when several revisions are installed), `[id revision]`\n  1780\t   pins one revision; anything else is refused — the selector is the\n  1781\t   frontend id, never a language keyword.\"\n  1782\t  [catalog lang]\n  1783\t  (cond\n  1784\t    (vector? lang) (frontend/select catalog\n  1785\t                                    {:yang.frontend/id (first lang),\n  1786\t                                     :yang.frontend/revision (second lang)})\n  1787\t    (qualified-keyword? lang) (frontend/select catalog\n  1788\t                                               {:yang.frontend/id lang})\n","exit_code":0,"status":"completed"}}
