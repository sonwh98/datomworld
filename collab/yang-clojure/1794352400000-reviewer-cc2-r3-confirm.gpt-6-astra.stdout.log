                                                  rows)))\n   839\t                                             (map vector\n   840\t                                                  (sequenced-prefixes\n   841\t                                                    (count asts))\n   842\t                                                  recovered)))))\n   843\t                  wrappers (when recovered?\n   844\t                             (mapv (fn [p] [final-root p])\n   845\t                                   (sequenced-wrapper-paths (count asts))))\n   846\t                  ;; assembly itself must account for the tree exactly:\n   847\t                  ;; shifted rows plus the explicit wrappers, nothing else\n   848\t                  proven? (and recovered?\n   849\t                               (= (into #{}\n   850\t                                        (map (fn [[_o r p _k _v]] [r p]))\n   851\t                                        shifted)\n   852\t                                  (into #{}\n   853\t                                        (map (fn [[r p]] [r p]))\n   854\t                                        (remove (set wrappers)\n   855\t                                                (vm/application-occurrences\n   856\t                                                  final-tree))))\n   857\t                               (every? (set (vm/application-occurrences\n   858\t                                              final-tree))\n   859\t                                       wrappers))]\n   860\t              (cond-> {:name name\n   861\t                       :ast (cond-> assembled proven? mark-call-sites)\n   862\t                       :exports (set exports)\n   863\t             :requires (into {}\n   864\t                             (keep (fn [[k n a]] (when (= :requires k) [n a])))\n   865\t                             declared)\n   866\t                       :primitives (into {}\n   867\t                                     (keep (fn 