{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '728,875p' src/cljc/yin/vm/linker.cljc; sed -n '2217,2257p' src/cljc/yin/vm/linker.cljc; sed -n '2000,2038p' test/yang/clojure_test.clj; sed -n '1610,1668p' test/yang/latte_oracle_test.clj; sed -n '2407,2495p' test/yang/latte_oracle_test.clj\"","aggregated_output":";; The manifest and derivation record formats (section 8.1)\n;; =============================================================================\n\n(def manifest-schema\n  \"The one module-manifest schema version this linker implements (section\n   8.1): which keys exist and what they mean. The manifest record's\n   validator implements exactly this version; a manifest of another\n   version is a `:schema` defect, never migrated.\"\n  1)\n\n\n(def ^:private manifest-keys\n  \"The closed key set of a schema-1 manifest: every key of section 8.1's\n   example, the index alone optional.\"\n  #{:yin.module/name :yin.module/schema :yin.module/contracts\n    :yin.module/tree :yin.module/derivations :yin.module/index\n    :yin.module/exports :yin.module/requires :yin.module/primitives\n    :yin.module/footprint})\n\n\n(def ^:private derivation-formats\n  \"The formats a manifest carries derivation records for. The tree itself\n   is the manifest's one canonical tree and needs no record.\"\n  #{:yin.semantic/code :yin.debruijn.code :yin.debruijn.register})\n\n\n(defn manifest-defect\n  \"The schema-1 manifest validator (section 8.1): one schema version, the\n   closed key set, and each key's own shape -- the name is a symbol, the\n   contracts map formats to revision strings, the tree and every record\n   and declaration address is a Jing address, the declarations are\n   symbol-keyed, and every format named under `:yin.module/derivations`\n   is named under `:yin.module/contracts`. A declared name may never be\n   the definition operator (Rule R). Returns the defect map or nil.\"\n  [manifest]\n  (let [address? jing/segment-address?\n        shape (fn [k] {:rule :manifest-shape, :key k})\n        name-map? (fn [m k p]\n                    (let [v (get m k)]\n                      (and (map? v)\n                           (every? (fn [entry]\n                                     (and (symbol? (key entry))\n                                          (p (val entry))))\n                                   v))))\n        declared-names (fn [manifest]\n                         (concat (keys (:yin.module/requires manifest))\n                                 (keys (:yin.module/primitives manifest))\n                                 (:yin.module/exports manifest)))]\n    (if-not (map? manifest)\n      {:rule :manifest-shape}\n      (or (when (not= manifest-schema (:yin.module/schema manifest))\n            {:rule :schema})\n          (some (fn [k]\n                  (when-not (contains? manifest-keys k)\n                    (shape k)))\n                (keys manifest))\n          (some (fn [k]\n                  (when (or (not (contains? manifest k))\n                            (nil? (get manifest k)))\n                    (assoc (shape k) :missing true)))\n                (disj manifest-keys :yin.module/index))\n          (when-not (symbol? (:yin.module/name manifest))\n            (shape :yin.module/name))\n          (when (vm/reserved-name? (:yin.module/name manifest))\n            {:rule :reserved-name, :name (:yin.module/name manifest),\n             :role :declaration})\n          (when-not (and (map? (:yin.module/contracts manifest))\n                         (every? (fn [e]\n                                   (and (keyword? (key e))\n                                        (string? (val e))))\n                                 (:yin.module/contracts manifest)))\n            (shape :yin.module/contracts))\n          (when-not (address? (:yin.module/tree manifest))\n            (shape :yin.module/tree))\n          (when-not (and (map? (:yin.module/derivations manifest))\n                         (every? (fn [e]\n                                   (and (contains? derivation-formats (key e))\n                                        (address? (val e))))\n                                 (:yin.module/derivations manifest)))\n            (shape :yin.module/derivations))\n          (some (fn [f]\n                  (when-not (contains? (:yin.module/contracts manifest) f)\n                    {:rule :contract-missing, :format f}))\n                (keys (:yin.module/derivations manifest)))\n          ;; optional, but when present a map: vals of anything else throws\n          (let [index (:yin.module/index manifest)]\n            (when (or (and (some? index) (not (map? index)))\n                      (some (fn [f]\n                              (not (contains? #{:yin.debruijn.code :yin.debruijn.register} f)))\n                            (keys index))\n                      (some (fn [v] (not (address? v))) (vals index)))\n              (shape :yin.module/index)))\n          (when-not (and (set? (:yin.module/exports manifest))\n                         (every? (fn [n] (symbol? n))\n                                 (:yin.module/exports manifest)))\n            (shape :yin.module/exports))\n          (when-not (name-map? manifest :yin.module/requires address?)\n            (shape :yin.module/requires))\n          (when-not (name-map? manifest :yin.module/primitives keyword?)\n            (shape :yin.module/primitives))\n          (when-not (and (map? (:yin.module/footprint manifest))\n                         (set? (get-in manifest\n                                       [:yin.module/footprint :store-keys]))\n                         (set? (get-in manifest\n                                       [:yin.module/footprint :effects])))\n            (shape :yin.module/footprint))\n          (some (fn [n]\n                  (when (vm/reserved-name? n)\n                    {:rule :reserved-name, :name n,\n                     :role :declaration}))\n                (declared-names manifest))))))\n\n\n(def ^:private record-keys\n  \"The closed key set of a derivation record: exactly the keys\n   `yin.vm.ledger/derive-record` mints.\"\n  #{:yin.ledger/op :yin.ledger/input :yin.ledger/output\n    :yin.ledger/function :yin.ledger/profile})\n\n\n(defn record-defect\n  \"The derivation-record validator (section 8.1): a record is exactly\n   `yin.vm.ledger/derive-record`'s shape -- one `:derive` op, the tree's\n   Jing address as input, the lowered image's identity as output (a\n   segment address for the vector format, a contract-pinned hash for\n   the two de Bruijn formats), a function name, and the structured\n   profile map, no more and no less. Returns the defect map or nil.\"\n  [record]\n  (let [address? jing/segment-address?\n        shape (fn [k] {:rule :record-shape, :key k})\n        output? (fn [o] (or (string? o) (keyword? o)))]\n    (cond\n      (not (map? record)) {:rule :record-shape}\n      (not= record-keys (set (keys record))) {:rule :record-shape}\n      (not= :derive (:yin.ledger/op record))\n      {:rule :op, :op (:yin.ledger/op record)}\n      (not (address? (:yin.ledger/input record)))\n      (shape :yin.ledger/input)\n      (not (output? (:yin.ledger/output record)))\n      (shape :yin.ledger/output)\n      (not (keyword? (:yin.ledger/function record)))\n      (shape :yin.ledger/function)\n      (not (map? (:yin.ledger/profile record)))\n      (shape :yin.ledger/profile)\n      :else nil)))\n\n\n(def manifest-format\n(defn- checked-derivation\n  \"The derivation half of a manifest link (section 8.1): fetch the\n   format's record through `record-format`, check its two addresses --\n   the semantic input is the manifest's tree; a native input is A from\n   that semantic record, and its output is the native checksum -- and apply the policy, `:trusted`\n   stopping at the addresses, `:verifying` recomputing. Returns `[state\n   outcome]`, the outcome of `verified-policy-outcome`'s shape with\n   `:trust :composition` under `:trusted`, or a refusal. A manifest\n   with no record for the format is `:unsupported-format`.\"\n  [state drive format-kw manifest policy]\n  (let [tree-addr (:yin.module/tree manifest)\n        derivation-addr (get (:yin.module/derivations manifest) format-kw)]\n    (if (nil? derivation-addr)\n      [state (refused :unsupported-format {:format format-kw})]\n      (let [[state c] (drive-link state drive :yin.ledger/record\n                                  derivation-addr\n                                  (:contract record-format))]\n        (if (refused? c)\n          [state (dissoc c :yin.link/id)]\n          (let [derivation (get-in c [:image :value])\n                [state semantic] (if (= :yin.semantic/code format-kw)\n                                   [state nil]\n                                   (checked-derivation state drive :yin.semantic/code\n                                                       manifest policy))\n                expected (if (= :yin.semantic/code format-kw)\n                           tree-addr (:output semantic))]\n            (cond\n              (refused? semantic) [state (assoc semantic :format format-kw)]\n              (not= expected (:yin.ledger/input derivation))\n              [state (refused :derivation-mismatch\n                              {:format format-kw, :expected expected,\n                               :actual (:yin.ledger/input derivation)})]\n              :else (if (= :trusted policy)\n                      [state {:derivation derivation,\n                              :output (:yin.ledger/output derivation),\n                              :trust :composition}]\n                      (verified-policy-outcome state drive format-kw derivation\n                                               tree-addr)))))))))\n\n\n(defn- linked-image\n  {:convention :arg-vector, :outcomes true\n   :adapters yang/library-adapters\n   :native vm/primitive-profiles})\n\n\n(defn run-guest-machine\n  \"Run an AST through either observer composition with a finite instruction\n   budget. Return the terminal machine so fixtures can observe its streams.\"\n  [ast modules lane step-limit]\n  (let [run-bounded (fn [machine]\n                      (loop [v machine, n 0]\n                        (cond\n                          (or (vm/halted? v) (vm/blocked? v)) v\n                          (= n step-limit) (throw (ex-info \"Guest instruction budget exhausted\"\n                                                           {:lane lane :steps n :consumer v}))\n                          :else (recur (vm/step v) (inc n)))))\n        semantic? (= lane :semantic)\n        machine (if semantic?\n                  (semantic/create-vm {:make-stream tu/make-stream\n                                       :capability-secret tu/secret :modules modules})\n                  (tu/create-vm {:modules modules}))\n        session (tu/make-observer-session machine)\n        load-program (if semantic?\n                       (fn [v rows stamp]\n                         (vm/check-contract! vm/ast-contract stamp)\n                         (semantic/load-vector v (:vector (linearize/project-rows rows))\n                                               vm/semantic-contract))\n                       ast-walker/vm-load-program)\n        queued ((if semantic? tu/queue-rows! tu/queue-ast!) session ast)]\n    (-> (observer/run-on-stream queued engine/ready-for-ingress?\n                                (vm/fresh-code-loader load-program vm/ast-contract)\n                                run-bounded)\n        :consumer)))\n\n\n(defn run-guest-ast\n  \"The value from run-guest-machine; shared by library and oracle fixtures.\"\n  [ast modules lane step-limit]\n  (vm/value (run-guest-machine ast modules lane step-limit)))\n            (cond\n              (and (seq? x) (= 'quote (first x))) x\n              (symbol? x) (if (and (namespace x) (str/starts-with? (namespace x) \"latte-kernel.\"))\n                            (if (str/starts-with? (name x) \"->\") (symbol (name x)) (kernel-guest-name x)) x)\n              (seq? x) (apply list (map rewrite x))\n              (vector? x) (mapv rewrite x)\n              (map? x) (into {} (map (fn [[k v]] [(rewrite k) (rewrite v)])) x)\n              (set? x) (set (map rewrite x))\n              :else x))]\n    (rewrite form)))\n\n\n(defn- kernel-closure\n  [call]\n  (let [sources (merge (into {} (map (juxt second identity)) context-forms) kernel-sources)\n        mentions #(filter (set (keys sources)) (walk-symbols %))\n        needed (loop [todo (seq (mentions call)) seen #{}]\n                 (if-let [n (first todo)]\n                   (if (contains? seen n) (recur (next todo) seen)\n                       (recur (concat (next todo) (mentions (get sources n))) (conj seen n))) seen))\n        ordered (concat context-forms kernel-declaration-refusals (map #(get kernel-sources (kernel-guest-name (:symbol %))) kernel-entries))]\n    (filterv #(contains? needed (second %)) ordered)))\n\n\n(defn- kernel-fixture-call\n  [{:keys [call guest-call definitions project-proof?]} guest?]\n  (let [env (if guest? initial-context 'latte-kernel.defenv/empty-env)\n        register (if guest? 'register-definition 'latte-kernel.defenv/register-definition)\n        env (reduce (fn [env definition] (list register env (if guest? (kernel-call definition) definition))) env definitions)\n        call (if guest? (kernel-call (or guest-call call)) call)\n        call (if project-proof?\n               (list 'let ['r call] '(if (= :ok (first r)) [:ok (rest (second r))] r)) call)]\n    (list 'let ['env env] call)))\n\n\n(defn- evidence-data\n  \"EDN evidence retains all portable values and metadata. Nonportable host\n   payloads are explicit evidence, not accepted representation differences.\"\n  [x]\n  (cond\n    (fn? x) {:nonportable-host-value (str (class x))}\n    (record? x) (evidence-data (upstream-record-data x))\n    (map? x) (into {} (map (fn [[k v]] [(evidence-data k) (evidence-data v)])) x)\n    (vector? x) (mapv evidence-data x)\n    (set? x) (set (map evidence-data x))\n    (seq? x) (apply list (map evidence-data x))\n    :else x))\n\n\n(defn- kernel-attempt\n  [f]\n  (try (f)\n       (catch Exception e\n         {:status :blocked :message (ex-message e)\n          ;; The session and consumer are host VM recovery machinery, not\n          ;; portable domain payloads. Walking their closure environments can\n          ;; repeatedly expand the entire program.\n          :data (evidence-data (dissoc (ex-data e) :session :consumer))\n          :host-session-attached? (contains? (ex-data e) :session)\n\n\n(defn kernel-gate-evidence\n  \"Run every fixture in A and independently in both C lanes. Compilation or\n   VM errors are blockers, never successful LaTTe rejections. Exact arities\n   require recorded body entry in both C lanes of a passing fixture.\"\n  []\n  (let [results (mapv (fn [fixture]\n                        (let [row (kernel-row fixture)]\n                          (println \"KERNEL-FIXTURE\" (:id row) (:status row))\n                          row)) (:fixtures kernel-gate-corpus))\n        inventory (mapv #(select-keys % [:symbol :kind :arities :disposition :admission-reason]) kernel-entries)\n        exercise-entries (kernel-exercise-entries inventory (:fixtures kernel-gate-corpus) results)\n        direct (set (map :function-arity (filter #(= :direct (:exercise %)) exercise-entries)))\n        exercised (set (map :function-arity (remove #(= :unexercised (:exercise %)) exercise-entries)))\n        all-arities (set (for [{:keys [symbol arities]} inventory n arities] [symbol n]))\n        admitted-arities (set (for [{:keys [symbol arities disposition]} inventory\n                                    :when (= :admitted disposition) n arities] [symbol n]))\n        unexercised (vec (sort-by pr-str (remove exercised admitted-arities)))]\n    {:slice 9 :gate-status (if (and (every? #(contains? #{:pass :recorded-deviation :recorded-upstream-failure} (:status %)) results)\n                                    (empty? unexercised)) :pass :blocked)\n     :baseline {:revision \"7dc18478\" :fixture-count 54 :counts {:pass 4 :mismatch 2 :blocked 48}}\n     :generated-at (str (java.time.Instant/now))\n     :adaptation-version {:context 2 :kernel-assembly 4}\n     :executions {:a :original-upstream-clojure :b :context-source-clojure\n                  :c [:walker :semantic]}\n     :upstream-revision \"86fca0d1d054af005cb37395eae04500d45e6279\"\n     :compiler-vm-revision {:base \"7dc18478\" :working-tree true}\n     :compiler-source-sha256\n     (apply str (map #(format \"%02x\" (bit-and 255 %))\n                     (.digest (java.security.MessageDigest/getInstance \"SHA-256\")\n                              (.getBytes (slurp \"src/cljc/yang/clojure.cljc\") \"UTF-8\"))))\n     :integration-context-identities kernel-context-integration-names\n     :portability-refusals\n     [{:source '(.getStackTrace exc) :disposition :excluded\n       :reason \"Host stack traces have no portable error-data representation; the compiler refuses the accessor.\"}]\n     :representation-seams\n     {'kind/var? \"JVM Clojure Var predicate; explicitly declared, with no namespace lookup.\"\n      'kind/with-meta \"Pure metadata attachment on the existing host value representation; the data ABI has no metadata-write export.\"}\n     :context-fields {'latte-kernel.proof/+opacity-fn+ :opacity-policy}\n     :fresh-supply-convention\n     {:input {:counter 0} :allocation '(gensym supply prefix)\n      :result '[symbol next-supply]\n      :rebuild-type-result '[original-result next-context]\n      :ambient-prefix-only :refused}\n     :runtime {:clojure (clojure-version) :java (System/getProperty \"java.version\")}\n     :instruction-budget-per-lane 4000000\n     :instruction-budget-note \"The original uninstrumented fixtures used 1,000,000 instructions. Body-entry stream writes add guest instructions; traced fixtures have a 2,000,000 instruction bound. The harness drains only after halt. Under the D2 record lane the binding fixture's walker cell needs 2,024,912 steps (1.2% over 2M; semantic 1,105,792); the architect's 2026-11-04 ruling approves a uniform 4,000,000 acceptance budget (~1.98x headroom on the binding lane, measurement-supported, no per-fixture table).\"\n     :manifest-bindings (count manifest) :function-arity-candidates (count all-arities)\n     :manifest-functions (count (filter :arities kernel-entries))\n     :admitted-function-arity-count (count admitted-arities)\n     :excluded-function-arity-count (- (count all-arities) (count admitted-arities))\n     :binding-dispositions (frequencies (map :disposition manifest))\n     :admission-note \"Manifest dispositions define the denominator independently of fixture success; excluded bindings retain explicit portability reasons.\"\n     :program-status (if (empty? unexercised) :fixture-closure-complete :execution-evidence-incomplete)\n     :residual-closure kernel-fixture-closure\n     :coverage {:proven-direct-function-arities (vec (sort-by pr-str direct))\n                :exercised-count (count exercised) :unexercised unexercised\n                :entries exercise-entries\n                :named-integration-fixture-ids (vec (sort kernel-named-integrations))\n                :transitive-execution-coverage :recorded-function-arity-body-entry\n                :context-extra-arguments kernel-context-extra-arguments\n                :trace {:record-shape '[guest-function arity]\n                        :transport :explicit-guest-stream :lanes [:c-walker :c-semantic]\n                        :point :selected-arity-body-entry}\n                :basis \"Passing direct calls or named integrations must record the exact function/arity executing in both C lanes. Static closure membership never counts; full branch coverage is not required.\"\n                :inventory inventory}\n     :recorded-portability-boundaries\n     (mapv #(select-keys % [:id :status :recorded-deviation])\n           (filter #(= :recorded-deviation (:status %)) results))\n     :recorded-upstream-failures\n     (mapv #(select-keys % [:id :status :recorded-upstream-failure])\n           (filter #(= :recorded-upstream-failure (:status %)) results))\n     :counts (frequencies (map :status results)) :fixture-count (count results)\n     :negative-fixture-count (count (filter :negative? results))\n     :dependency-graph\n     (into (sorted-map)\n           (for [[fname source] kernel-sources]\n             [fname (vec (sort (filter (set (keys kernel-sources)) (walk-symbols source))))]))\n     :fixtures results}))\n\n\n(defn write-kernel-gate-evidence!\n  \"Explicit evidence/coverage refresh; normal tests never update these files.\n   With `dir`, writes into that directory (the round-trip test's temp dir);\n   without it, the checked-in locations.\"\n  ([] (write-kernel-gate-evidence! \"test/yang/latte_oracle\"))\n  ([dir]\n   (let [evidence (kernel-gate-evidence)]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'exact mapped arity|Gate S v1|H3-6|164/165' docs test/yang/latte_oracle --glob '\"'!*.log'\"' --glob '\"'!slice9_evidence.edn'\"' | head -85; rg -n 'compile-program|dao.stream|store-put|datom|ledger' src/cljc/yang/clojure.cljc | tail -35; rg -n 'trace|registered-definition' test/yang/latte_oracle/slice9_unexercised.edn; rg --files . | rg '(\"'^|/)defenv.cljc$|(''^|/)ledger.cljc$'\"'; rg -n 'latte-kernel' deps.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
