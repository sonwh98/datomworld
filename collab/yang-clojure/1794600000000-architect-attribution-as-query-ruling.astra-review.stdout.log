 T) {}))}\n225-{:id :h3-3-axiom-map, :negative? true, :call (latte-kernel.defenv/axiom? {})}\n226:{:id :h3-3-registered-definition-nonsymbol, :negative? true, :call (latte-kernel.defenv/registered-definition? 5), :guest-call (registered-definition? env 5)}\n227-{:id :h3-3-nbe-evaluation-missing, :negative? true, :call (latte-kernel.nbe/evaluation (quote (gate-missing)))}\n228-{:id :h3-3-nbe-instantiate-def-too-many, :negative? true, :call (latte-kernel.nbe/instantiate-def (quote [[x ✳]]) (quote x) (quote [a b]))}\n229-{:id :h3-3-redex-application, :negative? true, :call (latte-kernel.norm/redex? (quote [x y]))}\n230-{:id :h3-3-redex-variable, :negative? true, :call (latte-kernel.norm/redex? (quote x))}\n231-{:id :h3-3-beta-reduction-nonredex, :negative? true, :call (latte-kernel.norm/beta-reduction (quote [x y]))}\n232-{:id :h3-3-norm-instantiate-def-too-many, :negative? true, :call (latte-kernel.norm/instantiate-def (quote [[x ✳]]) (quote x) (quote [a b]))}\n233-{:id :h3-3-delta-step-missing, :negative? true, :call (latte-kernel.norm/delta-step env [] (quote (gate-missing)) false)}\n234-{:id :h3-3-parse-one-empty, :negative? true, :call (latte-kernel.presyntax/parse (quote ()))}\n235-{:id :h3-3-parse-one-reserved, :negative? true, :call (latte-kernel.presyntax/parse (quote lambda))}\n236-{:id :h3-3-unregister-unparser-absent, :negative? true, :mode :unparser-install, :call (latte-kernel.unparser/unregister-unparser! :absent), :guest-call (unregister-unparser env :absent)}\n237-]}\n","exit_code":0,"status":"completed"}}
