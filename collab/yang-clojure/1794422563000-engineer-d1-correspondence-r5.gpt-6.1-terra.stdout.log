{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/correspondence_text.clj; cat test/yang/correspondence_text_test.clj'","aggregated_output":"(ns yang.correspondence-text\n  \"JVM text capture pilot. Acceptance still requires a pinned dependency closure\n   and per-compilation replay of every claimed artifact.\"\n  (:require [clojure.edn :as edn]))\n\n(def profile\n  {:yang.correspondence.text/schema 1\n   :host :jvm\n   :clojure-version (clojure-version)\n   :java-version (System/getProperty \"java.version\")\n   :java-vendor (System/getProperty \"java.vendor\")\n   :encoding :utf-8\n   :normalization :none\n   :printer 'clojure.core/pr-str\n   :printer-options {:meta true :length nil :level nil :readably true\n                     :dup false :namespace-maps false}\n   :reader 'clojure.edn/read\n   :reader-options {:values 1 :eof-required true :ambient-readers false\n                    :tags :unsupported}\n   :domain :edn-with-readable-metadata})\n\n(defn- kind\n  [x]\n  (cond (map? x) :map (vector? x) :vector (set? x) :set\n        (seq? x) :list (sequential? x) :sequence :else :scalar))\n\n(defn- mismatch\n  [a b path]\n  (cond\n    (not= (kind a) (kind b)) {:path path :reason :kind :actual (kind a) :read (kind b)}\n    (not= (some? (meta a)) (some? (meta b))) {:path path :reason :metadata-presence}\n    :else\n    (or (when (some? (meta a)) (mismatch (meta a) (meta b) (conj path :metadata)))\n        (case (kind a)\n          :map (if (not= (count a) (count b))\n                 {:path path :reason :count}\n                 (some identity\n                       (map-indexed (fn [i [[ak av] [bk bv]]]\n                                      (or (mismatch ak bk (conj path [:key i]))\n                                          (mismatch av bv (conj path [:value i]))))\n                                    (map vector a b))))\n          (:vector :list :sequence :set)\n          (if (not= (count a) (count b))\n            {:path path :reason :count}\n            (some identity (map-indexed (fn [i [x y]] (mismatch x y (conj path i)))\n                                        (map vector a b))))\n          :scalar (when-not (and (= a b) (or (not (number? a))\n                                         (and (= (class a) (class b)) (.equals a b))))\n                    {:path path :reason :scalar :actual (str (class a)) :read (str (class b))})))))\n\n(defn faithful?\n  \"Compare syntax kind, collection iteration order, scalar numeric type and\n   metadata recursively. This is deliberately stricter than Clojure equality.\"\n  [a b]\n  (nil? (mismatch a b [])))\n\n(defn- refusal\n  [compilation stage cause]\n  (ex-info \"Text reconstruction refused\"\n           {:rule :correspondence/text :compilation compilation :stage stage} cause))\n\n(defn read-one!\n  \"Read one EDN value, refusing all tagged values and any trailing value.\"\n  [compilation source]\n  (try\n    (let [reader (java.io.PushbackReader. (java.io.StringReader. source))\n          eof (Object.)\n          reject-tag (fn [tag _] (throw (ex-info \"Unsupported tag\" {:tag tag})))\n          reject-builtin (fn [_] (throw (ex-info \"Unsupported tag\" {})))\n          options {:eof eof :readers {'inst reject-builtin 'uuid reject-builtin}\n                   :default reject-tag}\n          value (edn/read options reader)\n          trailing (edn/read options reader)]\n      (when (or (identical? eof value) (not (identical? eof trailing)))\n        (throw (ex-info \"Expected exactly one value\" {})))\n      value)\n    (catch Exception e (throw (refusal compilation :read e)))))\n\n(defn capture!\n  \"Print and immediately read back an actual input, refusing lossy captures.\"\n  [compilation value]\n  (let [source (try (binding [*print-meta* true *print-length* nil *print-level* nil\n                              *print-readably* true *print-dup* false\n                              *print-namespace-maps* false]\n                      (pr-str value))\n                    (catch Exception e (throw (refusal compilation :print e))))\n        restored (read-one! compilation source)]\n    (when-let [difference (mismatch value restored [])]\n      (throw (ex-info \"Text capture loses input fidelity\"\n                      {:rule :correspondence/text :compilation compilation\n                       :stage :fidelity :difference difference})))\n    source))\n(ns yang.correspondence-text-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.mem :as mem]\n            [yang.correspondence-text :as text]\n            [yang.clojure :as yang]\n            [yin.vm :as vm]))\n\n(deftest profile-fidelity-and-reader-refusals\n  (testing \"fidelity preserves syntax kinds, numeric types, metadata, and iteration order\"\n    (is (text/faithful? (list 'a 'b) (list 'a 'b)))\n    (is (not (text/faithful? '(a b) '[a b])))\n    (is (not (text/faithful? (with-meta '[a] {:m 1}) '[a])))\n    (is (not (text/faithful? (with-meta '[a] {:line (int 3)})\n                             (with-meta '[a] {:line (long 3)}))))\n    (is (not (text/faithful? 1 1N)))\n    (is (not (text/faithful? (int 1) (long 1))))\n    (is (not (text/faithful? 1.0M 1.00M)))\n    (is (not (text/faithful? (array-map :a 1 :b 2) (array-map :b 2 :a 1))))\n    (is (not (text/faithful? (sorted-set 1 2) (sorted-set-by > 1 2)))))\n  (testing \"the reader consumes exactly one value and refuses tags\"\n    (is (= '[a b] (text/read-one! :case \"[a b]\")))\n    (doseq [source [\"\" \"1 2\" \"#unknown 1\" \"#inst \\\"2020-01-01\\\"\"]]\n      (is (thrown? Exception (text/read-one! :case source)))))\n  (testing \"a supported value round trips through the pinned printer and reader\"\n    (let [original (with-meta (vector 'x 2) {:marker \"kept\"})\n          source (text/capture! :fixture original)]\n      (is (text/faithful? original (text/read-one! :fixture source)))))\n  (testing \"unsupported objects and metadata loss refuse with stage and compilation\"\n    (let [failure (try (text/capture! :fixture (Object.)) nil\n                       (catch Exception e (ex-data e)))]\n      (is (= :fixture (:compilation failure)))\n      (is (contains? #{:print :read :fidelity} (:stage failure))))\n    (let [failure (try (text/capture! :fixture (with-meta '[a] {:line (int 3)})) nil\n                       (catch Exception e (ex-data e)))]\n      (is (= :fidelity (:stage failure)))\n      (is (= :fixture (:compilation failure)))))\n  (testing \"the profile is a content-addressed data value\"\n    (let [handle (mem/create-content-mem)\n          address (jing/materialize! handle text/profile)]\n      (is (jing/segment-address? address))\n      (is (= text/profile (jing/get handle address nil))))))\n\n\n(deftest decoded-dynamic-map-is-not-authoritative-source\n  (let [source (array-map :b 'b :a 'a)\n        handle (mem/create-content-mem)\n        decoded (jing/get handle (jing/materialize! handle source) nil)\n        root #(-> % yang/compile-form vm/ast->semantic-bytecode :root)]\n    (is (= source decoded))\n    (is (not (text/faithful? source decoded)))\n    (is (not= (root source) (root decoded)))))\n","exit_code":0,"status":"completed"}}
