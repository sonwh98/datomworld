y :unfold-implicit unfold-implicit :fresh 0})\\\\n (defn local-definitions [kernel] (second (:definitions kernel)))\\\\n (defn register-definition\\\\n   ([kernel rdef] (register-definition kernel rdef false))\\\\n   ([kernel rdef local?]\\\\n    (let [[globals locals] (:definitions kernel)]\\\\n      (assoc kernel :definitions\\\\n             (if local? [globals (assoc locals (:name rdef) rdef)]\\\\n                 [(assoc globals (:name rdef) rdef) locals])))))\\\\n (defn fetch-definition\\\\n   ([kernel dname] (fetch-definition kernel dname false))\\\\n   ([kernel dname local-only?]\\\\n    (let [[globals locals] (:definitions kernel)]\\\\n      (if (symbol? dname)\\\\n        (if-let [ldef (get locals dname)]\\\\n          [:ok ldef]\\\\n          (if local-only?\\\\n            [:ko {:msg \\\\\\\"No such (local) definition\\\\\\\" :def dname}]\\\\n            (if-let [gdef (get globals dname)]\\\\n              [:ok gdef]\\\\n              [:ko {:msg \\\\\\\"No such (global) definition\\\\\\\" :def dname}])))\\\\n        (throw (ex-info \\\\\\\"Cannot fetch definition (please report)\\\\\\\" {:dname dname}))))))\\\\n (defn registered-definition?\\\\n   ([kernel dname] (registered-definition? kernel dname false))\\\\n   ([kernel dname local?] (= :ok (first (fetch-definition kernel dname local?)))))\\\\n (defn qualify-def [kernel dname]\\\\n   (if (= :ok (first (fetch-definition kernel dname)))\\\\n     dname\\\\n     (throw (ex-info \\\\\\\"Cannot qualify symbol: not a known definition\\\\\\\" {:symbol dname}))))\\\\n (defn fresh-name [kernel prefix]\\\\n   [(gensym prefix (:fresh kernel)) (assoc kernel :fresh (+ (:fresh kernel) 1))])\\\\n (defn install-unfold-implicit [kernel unfold-fn]\\\\n   (assoc kernel :unfold-implicit unfold-fn))\\\\n (defn install-opacity-function [kernel opacity-fn]\\\\n   (assoc kernel :opacity-policy opacity-fn))\\\\n (defn missing-opacity-policy [ddef opaque?]\\\\n   (throw (ex-info \\\\\\\"Opacity management function not installed