             1 (lower-tail env (first ops))\\n                (let [g (gen-sym env)]\\n                  (lower-tail env (list 'dsg__let [g (first ops)]\\n                                        (list 'if g (cons 'and (rest ops)) g)))))\\n          or (case (count ops)\\n               0 (ok-form nil)\\n               1 (lower-tail env (first ops))\\n               (let [g (gen-sym env)]\\n                 (lower-tail env (list 'dsg__let [g (first ops)]\\n                                       (list 'if g g (cons 'or (rest ops)))))))\\n          (case (call-kind env head)\\n            :macro (do (check-macro-operands! env head ops) (ok-form form))\\n            :keyword (lower-operands env (vec ops)\\n                                     (fn [vs] (ok-form (rebuild form (cons head vs)))))\\n            :native (lower-operands env (vec ops)\\n                                    (fn [vs] (ok-form (rebuild form (cons head vs)))))\\n            :adapted (lower-operands env (vec ops)\\n                                     (fn [vs] (rebuild form (cons (get (adapters env) head) vs))))\\n            :guest (lower-operands env (into [head] ops)\\n                                   (fn [vs] (rebuild form vs)))))))\\n    (or (vector? form) (set? form) (map? form))\\n    (if (failing? env form)\\n      (cond\\n        (vector? form) (lower-operands env form (fn [vs] (ok-form (vec vs))))\\n        (set? form) (lower-operands env (vec form) (fn [vs] (ok-form (set vs))))\\n        :else (lower-operands env (vec (mapcat identity form))\\n                              (fn [vs] (ok-form (into {} (map vec) (partition 2 vs))))))\\n      (ok-form form))\\n    :else (ok-form form)))\\n\\n\\n(defn- lower-function-body\\n  \\\"The outcome-returning body of one function over `params`.\\\"\\n  [env macro-env params body-forms]\\n  (lower-tail (-> env\\n                  (assoc ::macro-env macro-env, ::gen (atom 0))\\n                  (with-locals (mapcat binder-symbols params)))\\n              (rewrite-ex-info (body-expression body-forms))))\\n\\n\\n(def ^:private source-keys [:line :column :end-line :end-column])\\n\\n\\n(defn- source-meta\\n  \\\"The source position keys of `form`'s reader metadata, or nil.\\\"\\n  [form]\\n  (not-empty (select-keys (meta form) source-keys)))\\n\\n\\n(defn- arity-error-form\\n  \\\"The outcome of a call whose argument count no arity admits: it names the\\n;; Slice 8 portability source, adaptation v1, pinned LaTTe 86fca0d1.\\n;; A context occupies the def-env argument throughout the adapted kernel.\\n;; Read operations retain it; writes return a new context. No ambient defaults:\\n;; callers supply both extension bindings at initialization. A fresh allocation\\n;; returns [name context]. Runtime closures are constructed by guest evaluation.\\n[(defn context-not-empty [x] (if (seq x) x nil))\\n (defn context-ffirst [x] (first (first x)))\\n (defn context-list-star\\n   ([a tail] (cons a tail))\\n   ([a b tail] (cons a (cons b tail))))\\n (defn lookup-in [coll path]\\n   (reduce (fn [coll k] (get coll k)) coll path))\\n (defn ->Definition [name params arity parsed-term term-free-vars type opts]\\n   {:latte/kind :definition :name name :params params :arity arity\\n    :parsed-term parsed-term :term-free-vars term-free-vars :type type :opts opts})\\n (defn ->Theorem [name params arity type proof]\\n   {:latte/kind :theorem :name name :params params :arity arity :type type :proof proof})\\n (defn ->Axiom [name params arity type]\\n   {:latte/kind :axiom :name name :params params :arity arity :type type})\\n (defn ->Notation [name notation-fn]\\n   {:latte/kind :notation :name name :notation-fn notation-fn})\\n (defn ->Implicit [name implicit-fn]\\n   {:latte/kind :implicit :name name :implicit-fn implicit-fn})\\n (defn definition? [v] (= :definition (:latte/kind v)))\\n (defn theorem? [v] (= :theorem (:latte/kind v)))\\n (defn axiom? [v] (= :axiom (:latte/kind v)))\\n (defn notation? [v] (= :notation (:latte/kind v)))\\n (defn implicit? [v] (= :implicit (:latte/kind v)))\\n (defn latte-definition? [v]\\n   (or (definition? v) (theorem? v) (axiom? v) (notation? v) (implicit? v)))\\n (defn kernel-context [definitions opacity-policy unfold-implicit]\\n   {:definitions definitions\\n    :unparser-registry {:fundamental [] :standard [] :user [] :unparsers {}}\\n    :opacity-policy opacity-policy :unfold-implicit unfold-implicit :fresh 0})\\n (defn local-definitions [kernel] (second (:definitions kernel)))\\n (defn register-definition\\n   ([kernel rdef] (register-definition kernel rdef false))\\n   ([kernel rdef local?]\\n    (let [[globals locals] (:definitions kernel)]\\n      (assoc kernel :definitions\\n             (if local? [globals (assoc locals (:name rdef) rdef)]\\n                 [(assoc globals (:name rdef) rdef) locals])))))\\n (defn fetch-definition\\n   ([kernel dname] (fetch-definition kernel dname false))\\n   ([kernel dname local-only?]\\n    (let [[globals locals] (:definitions kernel)]\\n      (if (symbol? dname)\\n        (if-let [ldef (get locals dname)]\\n          [:ok ldef]\\n          (if local-only?\\n            [:ko {:msg \\\"No such (local) definition\\\" :def dname}]\\n            (if-let [gdef (get globals dname)]\\n              [:ok gdef]\\n              [:ko {:msg \\\"No such (global) definition\\\" :def dname}])))\\n        (throw (ex-info \\\"Cannot fetch definition (please report)\\\" {:dname dname}))))))\\n (defn registered-definition?\\n   ([kernel dname] (registered-definition? kernel dname false))\\n   ([kernel dname local?] (= :ok (first (fetch-definition kernel dname local?)))))\\n (defn qualify-def [kernel dname]\\n   (if (= :ok (first (fetch-definition kernel dname)))\\n     dname\\n     (throw (ex-info \\\"Cannot qualify symbol: not a known definition\\\" {:symbol dname}))))\\n (defn fresh-name [kernel prefix]\\n   [(gensym prefix (:fresh kernel)) (assoc kernel :fresh (+ (:fresh kernel) 1))])\\n (defn install-unfold-implicit [kernel unfol