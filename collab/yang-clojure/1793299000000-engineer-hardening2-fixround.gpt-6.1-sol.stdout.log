ss\\\\nKERNEL-FIXTURE :unparser-guest-closure :pass\\\\n{:gate-status :blocked, :counts {:pass 53, :blocked 2, :mismatch 2}, :fixture-count 57, :manifest-bindings 155, :function-arity-candidates 175}\\\\nKERNEL-FIXTURE :normalize-delta :pass\\\\nKERNEL-FIXTURE :beta-eq-true :pass\\\\nKERNEL-FIXTURE :beta-eq-false :pass\\\\nKERNEL-FIXTURE :beta-eq-three-arity :pass\\\\nKERNEL-FIXTURE :typing-type :pass\\\\nKERNEL-FIXTURE :typing-lambda :pass\\\\nKERNEL-FIXTURE :typing-unknown :pass\\\\nKERNEL-FIXTURE :typing-kind :pass\\\\n{:counts {:pass 53, :blocked 2, :mismatch 2}, :fixture-count 57, :admitted-function-arity-count 165, :excluded-function-arity-count 10, :binding-dispositions {:admitted 146, :excluded 9}, :compiler-source-sha256 \\\\\\\"989a3a2321059826077bc371a3a2172d796a3fef1a700081d467888935e645f7\\\\\\\"}\\\\n:direct 22 :unexercised 143\\\\ndiff --git a/src/dev/latte_oracle_tables.clj b/src/dev/latte_oracle_tables.clj\\\\nindex bbe82759..58302bda 100644\\\\n--- a/src/dev/latte_oracle_tables.clj\\\\n+++ b/src/dev/latte_oracle_tables.clj\\\\n@@ -6,6 +6,8 @@\\\\n ;; Run: clj -X:test:dev latte-oracle-tables/-main\\\\n (ns latte-oracle-tables\\\\n   (:require [clojure.java.io :as io]\\\\n+            [clojure.edn :as edn]\\\\n+            [clojure.string :as str]\\\\n             [clojure.pprint :as pp]\\\\n             [yang.latte-oracle-test]))\\\\n \\\\n@@ -23,8 +25,35 @@\\\\n   (println \\\\\\\"wrote\\\\\\\" (count rows) \\\\\\\"rows to\\\\\\\" file))\\\\n \\\\n \\\\n+(def ^:private exclusions\\\\n+  {'latte_kernel.utils/nano-time \\\\\\\"Reads the host monotonic clock; no portable clock capability is installed.\\\\\\\"\\\\n+   'latte_kernel.unparser/show-term \\\\\\\"Captures host output and invokes clojure.pprint; formatting is host-local.\\\\\\\"\\\\n+   'latte_kernel.proof/show-term \\\\\\\"Invokes the excluded host pprint/output formatter.\\\\\\\"\\\\n+   'latte_kernel.proof/show-def \\\\\\\"Invokes the excluded host pprint/output formatter.\\\\\\\"\\\\n+  