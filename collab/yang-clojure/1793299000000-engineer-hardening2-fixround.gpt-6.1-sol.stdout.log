       (recur next-k (rest operations) (conj snapshots (opacity-snapshot next-k))))\\ntest/yang/latte_oracle_test.clj:1121:(defn- a-opacity-sequence\\ntest/yang/latte_oracle_test.clj:1123:  (let [ns-sym (gensym \\\"latte-opacity-a-\\\")\\ntest/yang/latte_oracle_test.clj:1127:        opacity-var (upstream-fn 'latte-kernel.proof/+opacity-fn+)]\\ntest/yang/latte_oracle_test.clj:1130:        (with-redefs-fn {opacity-var (atom (fn [v flag] (alter-var-root v assoc-in [:opts :opaque] flag)))}\\ntest/yang/latte_oracle_test.clj:1144:(deftest test-oracle-slice8-opacity-propagation\\ntest/yang/latte_oracle_test.clj:1145:  (let [ops (:opacity slice8-sequences)\\ntest/yang/latte_oracle_test.clj:1146:        call (list 'replay-opacity\\ntest/yang/latte_oracle_test.clj:1149:    (is (= [:yin.k/ok (a-opacity-sequence ops)] (context-bc opacity-replay call))))\\ntest/yang/latte_oracle_test.clj:1183:  ;; typing/unfold-implicit, using only host-constant arguments (no inference).\\ntest/yang/latte_oracle_test.clj:1193:          a ((upstream-fn 'latte-kernel.typing/unfold-implicit) [{} {}] [] implicit args)\\ntest/yang/latte_oracle_test.clj:1195:              (list 'let ['k (list 'install-unfold-implicit initial-context 'unfold-host-constants)\\ntest/yang/latte_oracle_test.clj:1199:  (let [norm-binding (upstream-fn 'latte-kernel.norm/+unfold-implicit+)\\ntest/yang/latte_oracle_test.clj:1200:        nbe-binding (upstream-fn 'latte-kernel.nbe/+unfold-implicit+)\\ntest/yang/latte_oracle_test.clj:1206:              (let [f (upstream-fn 'latte-kernel.typing/unfold-implicit)\\ntest/yang/latte_oracle_test.clj:1210:                ((upstream-fn 'latte-kernel.norm/install-unfold-implicit!) f)\\ntest/yang/latte_oracle_test.clj:1212:                  ((upstream-fn 'latte-kernel.norm/install-unfold-implicit!) (fn [_ _ _ args] [:ok 'replacement args]))\\ntest/yang/latte_oracle_test.clj:1215:                         'k1 '(install-unfold-implicit k0 unfold-host-constants)\\ntest/yang/latte_oracle_test.c