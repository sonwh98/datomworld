t/yang/latte_oracle_test.clj:1216:                         'k2 '(install-unfold-implicit k1 (fn [k ctx ddef args] [:ok 'replacement args]))]\\\\ntest/yang/latte_oracle_test.clj:1227:                         'k1 '(install-unfold-implicit k0 (fn [k ctx d args] [:ok 'installed args]))\\\\ntest/yang/latte_oracle_test.clj:1228:                         'k2 '(install-opacity-function k1 missing-opacity-policy)]\\\\ntest/yang/latte_oracle_test.clj:1229:                   '[(= (:unfold-implicit k0) missing-unfold-implicit)\\\\ntest/yang/latte_oracle_test.clj:1230:                     (= (:unfold-implicit k1) (:unfold-implicit k0))\\\\ntest/yang/latte_oracle_test.clj:1231:                     (= (:opacity-policy k0) definition-opacity)]))))))\\\\ntest/yang/latte_oracle_test.clj:1305:      (let [a (with-redefs-fn {(upstream-fn 'latte-kernel.norm/+unfold-implicit+) (atom nil)\\\\ntest/yang/latte_oracle_test.clj:1306:                              (upstream-fn 'latte-kernel.nbe/+unfold-implicit+) (atom nil)}\\\\ntest/yang/latte_oracle_test.clj:1308:                  ((upstream-fn 'latte-kernel.norm/install-unfold-implicit!)\\\\ntest/yang/latte_oracle_test.clj:1309:                   (upstream-fn 'latte-kernel.typing/unfold-implicit))\\\\ntest/yang/latte_oracle_test.clj:1313:                                     (list 'install-unfold-implicit initial-context 'unfold-host-constants)\\\\ntest/yang/latte_oracle_test.clj:1319:(defn- a-opacity-proof\\\\ntest/yang/latte_oracle_test.clj:1321:  (let [ns-sym (gensym \\\\\\\"latte-proof-a-\\\\\\\")\\\\ntest/yang/latte_oracle_test.clj:1327:        (with-redefs-fn {(upstream-fn 'latte-kernel.proof/+opacity-fn+)\\\\ntest/yang/latte_oracle_test.clj:1338:      (let [a (a-opacity-proof script)\\\\ntest/yang/latte_oracle_test.clj:1374:        manifest))\\\\ntest/yang/latte_oracle_test.clj:1429:                  (and (#{'deref 'clojure.core/deref} op) (= xs '(+unfold-implicit+)))\\\\ntest/yang/latte_oracle_test.clj:1430:                  '(:unfold-implicit def-env)\\\\ntest/yang/latte_oracle_test.clj:1468:  ;; five existing context constructors, outside the 143-binding manifest.\\\\ntest/yang/latte_oracle_test.clj:1546:    #(let [sandbox (create-ns (gensym \\\\\\\"kernel-gate-b-\\\\\\\"))\\\\ntest/yang/latte_oracle_test.clj:1550:                       ;; Preserve the actual one-argument gensym call. Only\\\\ntest/yang/latte_oracle_test.clj:1554:                           (if (and (seq? x) (= 'gensym (first x)) (= 2 (count x)))\\\\ntest/yang/latte_oracle_test.clj:1555:                             (cons 'clojure.core/gensym (rest x)) x)) form))]\\\\ntest/yang/latte_oracle_test.clj:1654:     :manifest-bindings (count manifest) :function-arity-candidates (count all-arities)\\\\ntest/yang/latte_oracle_test.clj:1655:     :manifest-functions (count (filter :arities kernel-entries))\\\\ntest/yang/latte_oracle_test.clj:1656:     :admitted-function-arity-count :not-recorded-in-inherited-manifest\\\\ntest/yang/latte_oracle_test.clj:1657:     :admission-note \\\\\\\"The inherited manifest has no admitted/excluded dispositions or arities. All function arities are conservatively retained as gate obligations; no narrowing by fixture success.\\\\\\\"\\\\ntest/yang/latte_oracle_test.clj:1675:    (with-open [w (io/writer \\\\\\\"test/yang/latte_oracle/slice9_evidence.edn\\\\\\\")]\\\\ntest/yang/latte_oracle_test.clj:1684:    (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage])))\\\\ntest/yang/latte_oracle_test.clj:1696:    (println \\\\\\\"KERNEL-GATE\\\\\\\" (pr-str (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates])))\\\\ntest/yang/latte_oracle_test.clj:1707:             \\\\\\\". See slice9_evidence.edn; blocked fixtures are not accepted negatives.\\\\\\\"))))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/1793294621496-compiler-engineer-hardening2.gpt-6.1-sol.stdout.log:9:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_3\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '1,120p' test/yang/latte_oracle_test.clj; sed -n '1350,1720p' test/yang/latte_oracle_test.clj; cat src/dev/latte_oracle_tables.clj; cat test/yang/latte_oracle/slice9_gate.md; head -35 test/yang/latte_oracle/manifest.edn; rg -n 'commit|format' docs/agents/format.md; sed -n '1820,2040p' src/cljc/yang/clojure.cljc\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"(ns yang.latte-oracle-test\\\\n  \\\\\\\"Pinned upstream LaTTe differential harness, slices 1-9 of the Yang gap\\\\n   program. A executes the original library on Clojure. B executes explicit\\\\n   portability source on Clojure; C compiles it through Yang for the walker\\\\n   and semantic VMs. Slice 9 fails closed on the full kernel corpus. The\\\\n   legacy classifier records historical blockers;\\\\n   the context module additionally checks free-symbol admission before C.\\\\n   Adaptations, operation sequences and scope departures live beside the\\\\n   manifest in yang/latte_oracle/.\\\\\\\"\\\\n  (:require [clojure.java.io :as io]\\\\n            [clojure.edn :as edn]\\\\n            [clojure.test :refer [deftest is testing]]\\\\n            [clojure.string :as str]\\\\n            [clojure.walk :as walk]\\\\n            [dao.jing.cbor :as cbor]\\\\n            [clojure.tools.reader :as r]\\\\n            [clojure.tools.reader.reader-types :as rt]\\\\n            [yang.clojure :as yang]\\\\n            [yang.clojure-test :as compiler-test]\\\\n            [yin.vm :as vm]\\\\n            [yin.vm.data :as data]\\\\n            [yin.vm.module :as module]\\\\n            [yin.vm.encoder :as encoder]\\\\n            [yin.vm.ucf.rows :as rows]\\\\n            [yin.vm.ucf.rows-support :as rows-support]\\\\n            [yin.vm.values :as values]\\\\n            [yin.vm.semantic :as semantic]\\\\n            [yin.vm.semantic.linearize :as linearize]\\\\n            [yin.vm.ucf :as ucf]))\\\\n\\\\n\\\\n(def ^:private manifest\\\\n  (edn/read-string (slurp (io/resource \\\\\\\"yang/latte_oracle/manifest.edn\\\\\\\"))))\\\\n\\\\n\\\\n(defn- ns-declaration-aliases\\\\n  \\\\\\\"Alias -> full ns symbol, taken from the file's own (ns ...) declaration —\\\\n   never invented: ::alias/kw must read as :that.real.ns/kw.\\\\\\\"\\\\n  [ns-form]\\\\n  (let [alias-map (atom {})\\\\n        consume-spec (fn [spec]\\\\n                       (when (sequential? spec)\\\\n                         (let [lib (first spec)]\\\\n                           (loop [xs (rest spec)]\\\\n                             (when (seq xs)\\\\n                               (if (= :as (first xs))\\\\n                                 (do (swap! alias-map assoc (second xs) lib)\\\\n                                     (recur (drop 2 xs)))\\\\n                                 (recur (next xs))))))))]\\\\n    (loop [clauses (rest (rest ns-form))]\\\\n      (when (seq clauses)\\\\n        (let [clause (first clauses)]\\\\n          (if (and (seq? clause) (= :require (first clause)))\\\\n            (do (loop [reqs (next clause)]\\\\n                  (let [spec (first reqs)]\\\\n                    (when (and (not (nil? spec)) (not (keyword? spec)))\\\\n                      (consume-spec spec)\\\\n                      (recur (next reqs)))))\\\\n                (recur (next clauses)))\\\\n            (recur (next clauses))))))\\\\n    @alias-map))\\\\n\\\\n\\\\n(defn- read-forms\\\\n  \\\\\\\"Read one latte-kernel source file with reader conditionals resolved for\\\\n   :clj, ::alias/kw keywords resolved against the file's own ns declaration,\\\\n   and ::kw resolved against the file's own namespace — so the C leg compiles\\\\n   the same keyword identities the upstream A leg runs.\\\\\\\"\\\\n  [ns-sym]\\\\n  (let [f (io/resource (str (str/replace (name ns-sym) \\\\\\\".\\\\\\\" \\\\\\\"/\\\\\\\") \\\\\\\".cljc\\\\\\\"))\\\\n        pr (rt/source-logging-push-back-reader (java.io.PushbackReader. (io/reader f)) 1 (str f))]\\\\n    (let [ns-form (r/read {:read-cond :allow :features #{:clj} :eof ::eof} pr)\\\\n          declared-name (second ns-form)\\\\n          aliases (ns-declaration-aliases ns-form)]\\\\n      (binding [r/*alias-map* aliases\\\\n                *ns* (the-ns (create-ns declared-name))]\\\\n        (loop [acc []]\\\\n          (let [form (r/read {:read-cond :allow :features #{:clj} :eof ::eof} pr)]\\\\n            (if (= form ::eof) acc (recur (conj acc form)))))))))\\\\n\\\\n\\\\n(def ^:private all-forms\\\\n  (into {} (map (fn [ns-sym] [ns-sym (read-forms ns-sym)])\\\\n                (distinct (map :ns manifest)))))\\\\n\\\\n\\\\n(def ^:private top-forms\\\\n  (into {} (map (fn [{:keys [ns kind name]}]\\\\n                  [[ns name] (first (filter #(and (seq? %)\\\\n                                                  (= kind (first %))\\\\n                                                  (= name (second %)))\\\\n                                            (get all-forms ns)))]))\\\\n        manifest))\\\\n\\\\n\\\\n(def ^:private scanned-symbols\\\\n  #{'loop 'recur 'case 'throw 'ex-info 'atom 'swap! 'reset! 'lazy-seq 'gensym\\\\n    'apply 'comp 'partial 'reduced 'reduce 'map 'mapv 'filter 'remove 'into\\\\n    'concat 'merge 'str 'symbol 'keyword 'vector 'seq 'nth 'nthnext 'assoc-in\\\\n    'count 'name 'when-let 'if-let 'when-some 'if-some 'cond})\\\\n\\\\n\\\\n(defn- walk-symbols\\\\n  [form]\\\\n  (cond\\\\n    (seq? form) (if (and (= 'quote (first form)) (= 2 (count form)))\\\\n                  #{}\\\\n                  (mapcat walk-symbols form))\\\\n    (vector? form) (mapcat walk-symbols form)\\\\n    (map? form) (mapcat walk-symbols (concat (keys form) (vals form)))\\\\n    (set? form) (mapcat walk-symbols form)\\\\n    (symbol? form) (if (namespace form) #{} #{form})\\\\n    :else #{}))\\\\n\\\\n\\\\n(defn- destructuring?\\\\n  [binding]\\\\n  (not (symbol? binding)))\\\\n\\\\n\\\\n(def ^:private kernel-gate-corpus\\\\n  (edn/read-string (slurp (io/resource \\\\\\\"yang/latte_oracle/kernel_gate.edn\\\\\\\"))))\\\\n\\\\n\\\\n(defn- kernel-symbol [{:keys [ns name]}]\\\\n  (symbol (str/replace (str ns) \\\\\\\"_\\\\\\\" \\\\\\\"-\\\\\\\") (str name)))\\\\n\\\\n\\\\n(defn- kernel-guest-name [s]\\\\n  (symbol (str \\\\\\\"gate-\\\\\\\" (last (str/split (namespace s) #\\\\\\\"\\\\\\\\.\\\\\\\")) \\\\\\\"-\\\\\\\" (name s))))\\\\n\\\\n\\\\n(defn- kernel-arities [form]\\\\n  (when (#{'defn 'defn-} (first form))\\\\n    (let [header (drop-while #(not (or (vector? %) (seq? %))) (nnext form))\\\\n          params (if (vector? (first header)) [(first header)] (map first header))]\\\\n      (mapv (fn [p] (if (some #{'&} p) [:variadic (.indexOf p '&)] (count p))) params))))\\\\n\\\\n\\\\n(def ^:private kernel-entries\\\\n  (mapv (fn [entry]\\\\n          (let [s (kernel-symbol entry)]\\\\n            (upstream-fn s) ; load the real aliases and refers before resolving source\\\\n            (assoc entry :symbol s :arities (kernel-arities (get top-forms [(:ns entry) (:name entry)])))))\\\\n        manifest))\\\\n\\\\n\\\\n(defn- kernel-resolve [ns-sym s]\\\\n  (when (symbol? s)\\\\n    (let [n (the-ns (symbol (str/replace (str ns-sym) \\\\\\\"_\\\\\\\" \\\\\\\"-\\\\\\\")))\\\\n          v (ns-resolve n s)]\\\\n      (when (and (var? v) (str/starts-with? (str (:ns (meta v))) \\\\\\\"latte-kernel.\\\\\\\"))\\\\n        (symbol (str (:ns (meta v))) (str (:name (meta v))))))))\\\\n\\\\n\\\\n(defn- kernel-rewrite\\\\n  \\\\\\\"Resolve library names against their actual upstream namespace, respecting\\\\n   lexical binders and quote. No blanket alias stripping or data rewriting.\\\\\\\"\\\\n  [ns-sym form]\\\\n  (letfn [(bindings [pattern] (set (filter symbol? (tree-seq coll? seq pattern))))\\\\n          (forms [xs bound] (map #(step % bound) xs))\\\\n          (arity [xs bound]\\\\n            (let [[params & body] xs]\\\\n              (list* params (forms body (into bound (bindings params))))))\\\\n          (step [x bound]\\\\n            (cond\\\\n              (symbol? x) (cond\\\\n                            (contains? bound x) x\\\\n                            (#{\\\\\\\"set\\\\\\\" \\\\\\\"clojure.set\\\\\\\"} (namespace x)) (symbol (name x))\\\\n                            (= \\\\\\\"pp\\\\\\\" (namespace x)) (symbol \\\\\\\"clojure.pprint\\\\\\\" (name x))\\\\n                            (contains? '{get-in lookup-in not-empty context-not-empty\\\\n                                         ffirst context-ffirst list* context-list-star} x)\\\\n                            (get '{get-in lookup-in not-empty context-not-empty\\\\n                                   ffirst context-ffirst list* context-list-star} x)\\\\n                            :else (if-let [s (kernel-resolve ns-sym x)]\\\\n                                    ;; empty-env at the immutable-context boundary\\\\n                                    ;; is the same explicit initialization used by\\\\n                                    ;; the slice-8 fixtures, including default arities.\\\\n                                    (if (= s 'latte-kernel.defenv/empty-env)\\\\n                                      initial-context\\\\n                                      (if (and (= \\\\\\\"latte-kernel.defenv\\\\\\\" (namespace s))\\\\n                                               (str/starts-with? (name s) \\\\\\\"->\\\\\\\"))\\\\n                                        (symbol (name s)) (kernel-guest-name s))) x))\\\\n              (seq? x)\\\\n              (let [[op & xs] x]\\\\n                (cond\\\\n                  (= op 'quote) x\\\\n                  (and (= op 'lazy-seq) (= ns-sym 'latte_kernel.utils) (= 'zip (second form)))\\\\n                  (step (second x) bound)\\\\n                  (#{'fn 'fn*} op)\\\\n                  (cons 'fn (if (vector? (first xs)) (arity xs bound)\\\\n                                (map #(arity % bound) xs)))\\\\n                  (#{'let 'loop} op)\\\\n                  (let [[bs & body] xs\\\\n                        [bs' scope] (reduce (fn [[out scope] [p init]]\\\\n                                              [(conj out p (step init scope)) (into scope (bindings p))])\\\\n                                            [[] bound] (partition 2 bs))]\\\\n                    (list* op bs' (forms body scope)))\\\\n                  ;; The slice-8 delta boundary: both namespaces use one binding.\\\\n                  (and (#{'deref 'clojure.core/deref} op) (= xs '(+unfold-implicit+)))\\\\n                  '(:unfold-implicit def-env)\\\\n                  :else (apply list (forms x bound))))\\\\n              (vector? x) (mapv #(step % bound) x)\\\\n              (map? x) (into (empty x) (map (fn [[k v]] [(step k bound) (step v bound)])) x)\\\\n              (set? x) (into #{} (forms x bound))\\\\n              :else x))]\\\\n    (let [[kind fname & header] form\\\\n          header (drop-while #(not (or (vector? %) (seq? %))) header)\\\\n          guest (kernel-guest-name (kernel-symbol {:ns ns-sym :name fname}))]\\\\n      (if (#{'defn 'defn-} kind)\\\\n        (list* 'defn guest\\\\n               (if (vector? (first header)) (arity header #{}) (map #(arity % #{}) header)))\\\\n        (list 'def guest (step (nth form 2) #{}))))))\\\\n\\\\n\\\\n(def ^:private kernel-context-adapters\\\\n  ;; Reuse the established slice-8 representation boundary; no new compiler\\\\n  ;; workaround or truncated proof-step dispatcher is admitted here.\\\\n  '#{definition? theorem? axiom? notation? implicit? latte-definition?\\\\n     local-definitions register-definition fetch-definition registered-definition? qualify-def})\\\\n\\\\n\\\\n(defn- kernel-source [{:keys [ns name symbol arities]}]\\\\n  (cond\\\\n    (and (= ns 'latte_kernel.defenv) (contains? kernel-context-adapters name))\\\\n    (list* 'defn (kernel-guest-name symbol)\\\\n           (map (fn [n]\\\\n                  (let [ps (mapv #(clojure.core/symbol (str \\\\\\\"p\\\\\\\" %)) (range n))]\\\\n                    (list ps (list* name ps)))) arities))\\\\n    :else (kernel-rewrite ns (get top-forms [ns name]))))\\\\n\\\\n\\\\n(def ^:private kernel-sources\\\\n  (into {} (map (fn [entry] [(kernel-guest-name (:symbol entry)) (kernel-source entry)])) kernel-entries))\\\\n\\\\n\\\\n(defn- kernel-call [form]\\\\n  ;; Fixture code uses fully qualified names. Constructor adapters are the\\\\n  ;; five existing context constructors, outside the 143-binding manifest.\\\\n  (letfn [(rewrite [x]\\\\n            (cond\\\\n              (and (seq? x) (= 'quote (first x))) x\\\\n              (symbol? x) (if (and (namespace x) (str/starts-with? (namespace x) \\\\\\\"latte-kernel.\\\\\\\"))\\\\n                            (if (str/starts-with? (name x) \\\\\\\"->\\\\\\\") (symbol (name x)) (kernel-guest-name x)) x)\\\\n              (seq? x) (apply list (map rewrite x))\\\\n              (vector? x) (mapv rewrite x)\\\\n              (map? x) (into {} (map (fn [[k v]] [(rewrite k) (rewrite v)])) x)\\\\n              (set? x) (set (map rewrite x))\\\\n              :else x))]\\\\n    (rewrite form)))\\\\n\\\\n\\\\n(defn- kernel-closure [call]\\\\n  (let [sources (merge (into {} (map (juxt second identity)) context-forms) kernel-sources)\\\\n        mentions #(filter (set (keys sources)) (walk-symbols %))\\\\n        needed (loop [todo (seq (mentions call)) seen #{}]\\\\n                 (if-let [n (first todo)]\\\\n                   (if (contains? seen n) (recur (next todo) seen)\\\\n                       (recur (concat (next todo) (mentions (get sources n))) (conj seen n))) seen))\\\\n        ordered (concat context-forms (map #(get kernel-sources (kernel-guest-name (:symbol %))) kernel-entries))]\\\\n    (filterv #(contains? needed (second %)) ordered)))\\\\n\\\\n\\\\n(defn- kernel-fixture-call [{:keys [call definitions project-proof?]} guest?]\\\\n  (let [env (if guest? initial-context 'latte-kernel.defenv/empty-env)\\\\n        register (if guest? 'register-definition 'latte-kernel.defenv/register-definition)\\\\n        env (reduce (fn [env definition] (list register env (if guest? (kernel-call definition) definition))) env definitions)\\\\n        call (if guest? (kernel-call call) call)\\\\n        call (if project-proof?\\\\n               (list 'let ['r call] '(if (= :ok (first r)) [:ok (rest (second r))] r)) call)]\\\\n    (list 'let ['env env] call)))\\\\n\\\\n\\\\n(defn- evidence-data\\\\n  \\\\\\\"EDN evidence retains all portable values and metadata. Nonportable host\\\\n   payloads are explicit evidence, not accepted representation differences.\\\\\\\"\\\\n  [x]\\\\n  (cond\\\\n    (fn? x) {:nonportable-host-value (str (class x))}\\\\n    (record? x) (evidence-data (upstream-record-data x))\\\\n    (map? x) (into {} (map (fn [[k v]] [(evidence-data k) (evidence-data v)])) x)\\\\n    (vector? x) (mapv evidence-data x)\\\\n    (set? x) (set (map evidence-data x))\\\\n    (seq? x) (apply list (map evidence-data x))\\\\n    :else x))\\\\n\\\\n\\\\n(defn- kernel-attempt [f]\\\\n  (try (f)\\\\n       (catch Exception e\\\\n         {:status :blocked :message (ex-message e) :data (evidence-data (ex-data e))\\\\n          :causes (mapv (fn [cause] {:class (str (class cause)) :message (ex-message cause)})\\\\n                        (take-while some? (iterate ex-cause e)))\\\\n          :exception (str (class e))})))\\\\n\\\\n\\\\n(defn- kernel-a [fixture]\\\\n  (kernel-attempt\\\\n    #(let [value (if (= :unparser (:mode fixture))\\\\n                   (with-redefs-fn {(upstream-fn 'latte-kernel.unparser/+unparser-registry+)\\\\n                                   (atom {:fundamental [] :standard [] :user [] :unparsers {}})}\\\\n                     (fn []\\\\n                       ((upstream-fn 'latte-kernel.unparser/register-unparser!) :gate (eval (:extension fixture)))\\\\n                       (a-leg (upstream-fn 'latte-kernel.unparser/unparse) [(:term fixture)])))\\\\n                   (a-leg (eval (list 'fn [] (kernel-fixture-call fixture false))) []))]\\\\n       {:status :completed :outcome (evidence-data value) :shape (result-shape (evidence-data value))})))\\\\n\\\\n\\\\n(defn- kernel-c-program [fixture]\\\\n  (if (= :unparser (:mode fixture))\\\\n    (list 'unparse (list 'register-unparser initial-context :gate (:extension fixture)) (list 'quote (:term fixture)))\\\\n    (kernel-fixture-call fixture true)))\\\\n\\\\n\\\\n(defn- kernel-b [fixture]\\\\n  (kernel-attempt\\\\n    #(let [sandbox (create-ns (gensym \\\\\\\"kernel-gate-b-\\\\\\\"))\\\\n           call (kernel-c-program fixture)\\\\n           forms (kernel-closure call)\\\\n           host-form (fn [form]\\\\n                       ;; Preserve the actual one-argument gensym call. Only\\\\n                       ;; the slice-8 explicit two-argument supply is adapted.\\\\n                       (walk/postwalk\\\\n                         (fn [x]\\\\n                           (if (and (seq? x) (= 'gensym (first x)) (= 2 (count x)))\\\\n                             (cons 'clojure.core/gensym (rest x)) x)) form))]\\\\n       (try\\\\n         (binding [*ns* sandbox]\\\\n           (refer 'clojure.core)\\\\n           (require '[clojure.set :refer [union difference]])\\\\n           (eval (list* 'declare\\\\n                        (concat (map second forms)\\\\n                                (for [[ns-sym source] all-forms\\\\n                                      form source :when (= 'declare (first form))\\\\n                                      s (rest form)\\\\n                                      :let [qualified (kernel-resolve ns-sym s)]\\\\n                                      :when qualified]\\\\n                                  (kernel-guest-name qualified)))))\\\\n           (doseq [form forms] (eval (context-host-form (host-form form))))\\\\n           (let [v (a-leg (eval (list 'fn [] (context-host-form (host-form call)))) [])]\\\\n             {:status :completed :outcome (evidence-data v) :shape (result-shape (evidence-data v))}))\\\\n         (finally (remove-ns (ns-name sandbox)))))))\\\\n\\\\n\\\\n(defn- kernel-compile [fixture]\\\\n  (let [call (kernel-c-program fixture)\\\\n        forms (kernel-closure call)\\\\n        program (conj forms call)\\\\n        program (into (yang/library-for program) program)\\\\n        ast (yang/compile-program program true arg-vector-opts)\\\\n        missing (unbound-ast-symbols ast program)]\\\\n    (if (seq missing)\\\\n      {:status :blocked :phase :admission :blocked-by (vec (sort missing))\\\\n       :owners (into {} (for [s missing]\\\\n                         [s (mapv second (filter #(some #{s} (tree-seq coll? seq %)) program))]))}\\\\n      {:status :compiled :ast ast :forms forms})))\\\\n\\\\n\\\\n(defn- kernel-c [compiled lane]\\\\n  (if (= :compiled (:status compiled))\\\\n    (assoc (kernel-attempt\\\\n             #(let [v (compiler-test/run-guest-ast (:ast compiled) (oracle-registry yang/kind-module) lane 1000000)]\\\\n                {:status :completed :outcome (evidence-data v) :shape (result-shape (evidence-data v))}))\\\\n           :lane lane)\\\\n    (assoc compiled :lane lane)))\\\\n\\\\n\\\\n(defn- kernel-row [fixture]\\\\n  (let [a (kernel-a fixture)\\\\n        b (kernel-b fixture)\\\\n        compiled (kernel-attempt #(kernel-compile fixture))\\\\n        compiled (if (and (= :blocked (:status compiled)) (not (:blocked-by compiled)))\\\\n                   (assoc compiled :phase :compile\\\\n                          :blocked-by (if-let [n (get-in compiled [:data :name])] [n] [:compiler-exception])\\\\n                          :minimal-source (get kernel-sources (get-in compiled [:data :name]))) compiled)\\\\n        walker (kernel-c compiled :walker)\\\\n        semantic (kernel-c compiled :semantic)\\\\n        match? (and (= :completed (:status a) (:status b) (:status walker) (:status semantic))\\\\n                    (= (:outcome a) (:outcome b))\\\\n                    (agrees? (get a :outcome) (get walker :outcome))\\\\n                    (= (:outcome walker) (:outcome semantic))\\\\n                    (= (result-shape (:outcome a)) (result-shape (:outcome b)))\\\\n                    (if (contains? (:outcome a) :value)\\\\n                      (= (result-shape (:value (:outcome a)))\\\\n                         (result-shape (second (:outcome walker))))\\\\n                      (= (result-shape (get-in a [:outcome :thrown :data]))\\\\n                         (result-shape (get-in walker [:outcome 1 :yin.k/data])))))\\\\n        status (cond match? :pass\\\\n                     (some #(= :blocked (:status %)) [a b walker semantic]) :blocked\\\\n                     :else :mismatch)]\\\\n    {:id (:id fixture) :negative? (boolean (:negative? fixture)) :status status\\\\n     :dependency-of (:dependency-of fixture)\\\\n     :call (or (:call fixture) (kernel-c-program fixture))\\\\n     :a a :b b :c-walker walker :c-semantic semantic\\\\n     :included-functions (mapv second (kernel-closure (kernel-c-program fixture)))}))\\\\n\\\\n\\\\n(defn kernel-gate-evidence\\\\n  \\\\\\\"Run every fixture in A and independently in both C lanes. Compilation or\\\\n   VM errors are blockers, never successful LaTTe rejections. Source closure\\\\n   membership is recorded separately from conservative execution coverage.\\\\\\\"\\\\n  []\\\\n  (let [results (mapv kernel-row (:fixtures kernel-gate-corpus))\\\\n        inventory (mapv #(select-keys % [:symbol :kind :arities]) kernel-entries)\\\\n        ;; Direct calls are a lower bound, not a claim that every function in\\\\n        ;; a dependency closure was executed. Unproven transitive arities stay\\\\n        ;; unexercised and block closure of the gate.\\\\n        direct (into #{}\\\\n                     (for [[fixture row] (map vector (:fixtures kernel-gate-corpus) results)\\\\n                           :when (= :pass (:status row))\\\\n                           :let [call (:call fixture)]\\\\n                           :when (and (seq? call) (namespace (first call)))]\\\\n                       [(first call) (count (rest call))]))\\\\n        all-arities (set (for [{:keys [symbol arities]} inventory n arities] [symbol n]))\\\\n        unexercised (vec (sort-by pr-str (remove direct all-arities)))]\\\\n    {:slice 9 :gate-status (if (and (every? #(= :pass (:status %)) results) (empty? unexercised)) :pass :blocked)\\\\n     :generated-at (str (java.time.Instant/now))\\\\n     :adaptation-version {:context 1 :kernel-assembly 1}\\\\n     :executions {:a :original-upstream-clojure :b :context-source-clojure\\\\n                  :c [:walker :semantic]}\\\\n     :upstream-revision \\\\\\\"86fca0d1d054af005cb37395eae04500d45e6279\\\\\\\"\\\\n     :compiler-vm-revision \\\\\\\"f74f2cecccfc54813671555b15e39d254debd2d9\\\\\\\"\\\\n     :runtime {:clojure (clojure-version) :java (System/getProperty \\\\\\\"java.version\\\\\\\")}\\\\n     :instruction-budget-per-lane 1000000\\\\n     :manifest-bindings (count manifest) :function-arity-candidates (count all-arities)\\\\n     :manifest-functions (count (filter :arities kernel-entries))\\\\n     :admitted-function-arity-count :not-recorded-in-inherited-manifest\\\\n     :admission-note \\\\\\\"The inherited manifest has no admitted/excluded dispositions or arities. All function arities are conservatively retained as gate obligations; no narrowing by fixture success.\\\\\\\"\\\\n     :coverage {:proven-direct-function-arities (vec (sort-by pr-str direct))\\\\n                :exercised-count (count direct) :unexercised unexercised\\\\n                :transitive-execution-coverage :unproven\\\\n                :inventory inventory}\\\\n     :counts (frequencies (map :status results)) :fixture-count (count results)\\\\n     :negative-fixture-count (count (filter :negative? results))\\\\n     :dependency-graph\\\\n     (into (sorted-map)\\\\n           (for [[fname source] kernel-sources]\\\\n             [fname (vec (sort (filter (set (keys kernel-sources)) (walk-symbols source))))]))\\\\n     :fixtures results}))\\\\n\\\\n\\\\n(defn write-kernel-gate-evidence!\\\\n  \\\\\\\"Explicit evidence refresh; normal test runs never update the checked-in oracle.\\\\\\\"\\\\n  []\\\\n  (let [evidence (kernel-gate-evidence)]\\\\n    (with-open [w (io/writer \\\\\\\"test/yang/latte_oracle/slice9_evidence.edn\\\\\\\")]\\\\n      ;; prn keeps (quote ...) in valid EDN rather than pprint's reader\\\\n      ;; shorthand. One fixture per line keeps refreshes independently diffable.\\\\n      (binding [*out* w *print-length* nil *print-level* nil]\\\\n        (print \\\\\\\"{\\\\\\\")\\\\n        (doseq [[k v] (dissoc evidence :fixtures)] (pr k) (print \\\\\\\" \\\\\\\") (prn v))\\\\n        (println \\\\\\\":fixtures [\\\\\\\")\\\\n        (doseq [row (:fixtures evidence)] (prn row))\\\\n        (println \\\\\\\"]}\\\\\\\")))\\\\n    (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates :coverage])))\\\\n\\\\n\\\\n(deftest test-kernel-differential-gate\\\\n  (let [evidence (kernel-gate-evidence)]\\\\n    (is (= (count (:fixtures kernel-gate-corpus)) (count (set (map :id (:fixtures evidence)))))\\\\n        \\\\\\\"Every named fixture runs exactly once, including negatives\\\\\\\")\\\\n    (doseq [row (:fixtures evidence)\\\\n            :when (and (:negative? row) (= :completed (get-in row [:a :status])))\\\\n            :let [outcome (get-in row [:a :outcome]) value (:value outcome)]]\\\\n      (is (or (:thrown outcome) (false? value) (and (sequential? value) (= :ko (first value))))\\\\n          (str \\\\\\\"A must actually reject the named negative: \\\\\\\" (:id row))))\\\\n    (println \\\\\\\"KERNEL-GATE\\\\\\\" (pr-str (select-keys evidence [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates])))\\\\n    (doseq [row (:fixtures evidence) :when (not= :pass (:status row))]\\\\n      (println \\\\\\\"KERNEL-BLOCKER\\\\\\\"\\\\n               (pr-str {:id (:id row) :status (:status row)\\\\n                        :blocked-by (get-in row [:c-walker :blocked-by])\\\\n                        :a (get-in row [:a :status]) :b (get-in row [:b :status])\\\\n                        :c-walker (get-in row [:c-walker :status])\\\\n                        :c-semantic (get-in row [:c-semantic :status])})))\\\\n    (is (= :pass (:gate-status evidence))\\\\n        (str \\\\\\\"Kernel gate remains blocked: \\\\\\\" (:counts evidence)\\\\n             \\\\\\\"; admitted/candidate but unexercised function/arities=\\\\\\\" (count (get-in evidence [:coverage :unexercised]))\\\\n             \\\\\\\". See slice9_evidence.edn; blocked fixtures are not accepted negatives.\\\\\\\"))))\\\\n;; Regenerate the LaTTe oracle's derived tables from the manifest forms:\\\\n;;   test/yang/latte_oracle/throw_sites.edn  (the throw-site inventory)\\\\n;;   test/yang/latte_oracle/case_arms.edn    (the per-arm case fixtures)\\\\n;; Both are derived by yang.latte-oracle-test, so this script and the test\\\\n;; cannot disagree about what a regenerated table holds.\\\\n;; Run: clj -X:test:dev latte-oracle-tables/-main\\\\n(ns latte-oracle-tables\\\\n  (:require [clojure.java.io :as io]\\\\n            [clojure.pprint :as pp]\\\\n            [yang.latte-oracle-test]))\\\\n\\\\n\\\\n(defn- derived\\\\n  \\\\\\\"The result of calling the oracle test's private derivation `sym`.\\\\\\\"\\\\n  [sym]\\\\n  ((deref (ns-resolve 'yang.latte-oracle-test sym))))\\\\n\\\\n\\\\n(defn- write-table!\\\\n  [file header rows]\\\\n  (io/make-parents file)\\\\n  (spit file (str header (with-out-str (pp/pprint rows))))\\\\n  (println \\\\\\\"wrote\\\\\\\" (count rows) \\\\\\\"rows to\\\\\\\" file))\\\\n\\\\n\\\\n(defn -main\\\\n  [& _]\\\\n  (write-table! \\\\\\\"test/yang/latte_oracle/throw_sites.edn\\\\\\\"\\\\n                (str \\\\\\\";; GENERATED from the manifest forms by yang.latte-oracle-test/throw-site-rows.\\\\\\\\n\\\\\\\"\\\\n                     \\\\\\\";; One row per throw symbol; disposition :fixture | :deferred | :excluded.\\\\\\\\n\\\\\\\")\\\\n                (derived 'throw-site-rows))\\\\n  (write-table! \\\\\\\"test/yang/latte_oracle/case_arms.edn\\\\\\\"\\\\n                (str \\\\\\\";; GENERATED from the manifest forms by yang.latte-oracle-test/case-arm-rows.\\\\\\\\n\\\\\\\"\\\\n                     \\\\\\\";; One row per case site: each arm's clause constants, and whether it has a default.\\\\\\\\n\\\\\\\")\\\\n                (derived 'case-arm-rows))\\\\n  (shutdown-agents))\\\\n# Slice 9 kernel differential gate — BLOCKED\\\\n\\\\nThis is a failing close-out gate, not a conformance certificate. No compiler or\\\\nVM source was changed. No commit was made.\\\\n\\\\nThe 54 fixtures in `kernel_gate.edn` invoke actual pinned upstream functions on A,\\\\nexecute the explicit context source on host Clojure on B, and compile the guest\\\\nsource for C-walker and C-semantic. Guest extension closures are evaluated by the\\\\nVM; the harness supplies no host callback primitive. The original proof dispatcher\\\\nis assembled, rather than substituting slice 8's restricted state-step dispatcher.\\\\nEvery fixture, including every negative, has an A/B/C-walker/C-semantic outcome in\\\\n`slice9_evidence.edn`. Blocked fixtures are attempted and recorded independently;\\\\nno negative is skipped or counted as a successful guest rejection.\\\\n\\\\nResult: **4 passing fixtures, 2 mismatches, 48 blocked fixtures**. Passing fixtures\\\\nare `:subst-capture`, `:subst-shadow`, `:subst-three-arity`, and\\\\n`:unparser-guest-closure`. The compile/admission blockers occur before either C\\\\nlane executes those blocked programs; both lane records explicitly say so.\\\\n\\\\n## Mismatches with minimal repros\\\\n\\\\n1. `:minimal-gensym-freshness`:\\\\n\\\\n   ```clojure\\\\n   (let [a (gensym \\\\\\\"fresh\\\\\\\") b (gensym \\\\\\\"fresh\\\\\\\")] (= a b))\\\\n   ```\\\\n\\\\n   A and B return `false`; both C lanes return `[:yin.k/ok true]`. The guest\\\\n   library's one-argument `gensym` constructs `G__fresh` repeatedly. This\\\\n   dependency is reachable from `latte-kernel.typing/rebuild-type`. No fresh-name\\\\n   correspondence can turn equality of two names into inequality.\\\\n\\\\n2. `:free-vars-local-capture`:\\\\n\\\\n   ```clojure\\\\n   (latte-kernel.syntax/free-vars\\\\n     (latte-kernel.defenv/register-definition env\\\\n       (latte-kernel.defenv/->Definition 'd [] 0 'x '#{x} 'A {}) true)\\\\n     '(d))\\\\n   ```\\\\n\\\\n   A returns `#{x}`; B returns `#{}`; both C lanes return `[:yin.k/ok #{}]`.\\\\n   The upstream `free-vars` implementation uses `(second def-env)` to access\\\\n   local definitions. The inherited context adaptation passes a context map in\\\\n   that position. This is an A/B adaptation mismatch, independently of compilation.\\\\n\\\\n## Blocked dependencies\\\\n\\\\n- Parsing reaches `butlast`, `last`, bare `nth`, and `kind/var?`, which are not\\\\n  admitted by the supplied portable modules. Minimal independent fixtures for\\\\n  `last`, `nth`, and `var?` are included. The parser's valid and malformed cases\\\\n  all run on A/B, but their guest dependency closures fail admission.\\\\n- Normalization reaches `last` in `nbe/evaluation` and `with-meta` in\\\\n  `nbe/quotation-`. `:minimal-last` and `:minimal-with-meta` isolate these failures.\\\\n  Beta, transparent delta, opaque delta, and each required public normalization\\\\n  arity have named fixtures; no host normalization is substituted for C.\\\\n- Typing reaches the actual `typing/unfold-implicit` `try/catch`, including\\\\n  `.getMessage`, `ex-data`, and exception bindings. Slice 8's already-typed\\\\n  extension adapter does not replace this full typed-argument path. The two\\\\n  implicit fixtures use actual guest closure source and remain blocked.\\\\n- `typing/type-of-ascribe` is declared but has no definition in the pinned\\\\n  upstream source and no manifest entry. `:typing-ascription` also exposes the\\\\n  upstream unbound-function failure on A. It is never treated as a successful\\\\n  type rejection by C.\\\\n- Full proof elaboration/checking reaches `proof/+opacity-fn+`, an ambient atom\\\\n  initialized with a closure. Yang rejects this `def` initializer under the\\\\n  outcome convention. Each affected fixture records\\\\n  `:blocked-by [gate-proof-+opacity-fn+]` and the exact `:minimal-source`.\\\\n  The inherited partial proof-step context adapter cannot stand in for the real\\\\n  parsing/typing dispatcher. Proof compilation separately reaches the missing\\\\n  `string?` dependency; even `:compile-proof`'s single `:qed` script is explicitly\\\\n  blocked by this dependency rather than treated as a successful rejection.\\\\n- Upstream's error for steps after `qed` includes the host `clojure.core/meta`\\\\n  function in its `:meta` field. Evidence explicitly marks this nonportable host\\\\n  value; it is not normalized into an accepted portability difference. The\\\\n  malformed scalar proof-step fixture also records its native upstream exception.\\\\n\\\\nThe complete source dependency graph, per-fixture closure membership, missing\\\\nsymbols and their owning definitions, compiler exception causes, and minimal\\\\ncalls are retained in `slice9_evidence.edn`. Compiler/admission/VM exceptions are\\\\nblockers; only actual returned `:ko`, `false`, or corresponding domain exceptions\\\\ncan satisfy negative fixtures. A test assertion checks that every completed A\\\\nnegative really rejects its input.\\\\n\\\\n## Manifest and coverage\\\\n\\\\nThe inherited manifest contains **155 bindings, 147 functions, and 175\\\\nfunction/arity entries**,\\\\nnot the plan's earlier estimate of 143 definitions. It has no admitted/excluded\\\\ndispositions, and its source fields are nil. Consequently an exact admitted\\\\nfunction/arity denominator cannot be recovered honestly from that manifest.\\\\n`admitted-function-arity-count` is explicitly `:not-recorded-in-inherited-manifest`.\\\\nAll 175 entries are retained as gate obligations; successful fixtures do not\\\\nnarrow the denominator.\\\\n\\\\nThe conservative, proven direct A/B/C agreement count is **2/175 arities**:\\\\n`latte-kernel.syntax/subst` at arities 2 and 3. The successful unparser integration\\\\nalso executes its dependencies, but this harness does not claim an exact dynamic\\\\ntransitive arity count. It records `:transitive-execution-coverage :unproven`.\\\\nAll **173 remaining unexercised-or-unproven entries** are individually listed\\\\nunder `:coverage :unexercised`, alongside the complete function/arity inventory.\\\\nDependency closure membership is recorded separately and does not count as\\\\nexecution. This incomplete accounting itself blocks the close-out gate.\\\\n\\\\n## Reproduction and verification\\\\n\\\\nPins: upstream LaTTe `86fca0d1d054af005cb37395eae04500d45e6279`; compiler/VM\\\\n`f74f2cecccfc54813671555b15e39d254debd2d9`; context adaptation v1, kernel assembly v1.\\\\nThe recorded host uses Clojure 1.12.4 and Java 17.0.18. Each C execution has a\\\\n1,000,000-instruction budget. There is no continuation-depth claim for blocked\\\\nprograms.\\\\n\\\\nRun the gate:\\\\n\\\\n```sh\\\\nclj -M:test -n yang.latte-oracle-test\\\\n```\\\\n\\\\n**22 tests, 988 assertions, 1 failure, 0 errors, exit 1.** The single failed\\\\nassertion is `test-kernel-differential-gate`: the gate must remain red while the\\\\nabove blockers or unproven coverage remain. The inherited 21 tests passed in the\\\\nbaseline: 968 assertions, 0 failures, 0 errors. Do not remove the close-out\\\\nassertion to manufacture the requested zero-failure result.\\\\n\\\\nExplicitly refresh evidence from fresh A/B/C runs (normal test runs do not rewrite\\\\nit):\\\\n\\\\n```sh\\\\nclj -Sdeps '{:aliases {:gate {:main-opts [\\\\\\\"-e\\\\\\\" \\\\\\\"(require (quote yang.latte-oracle-test)) (println (select-keys (yang.latte-oracle-test/write-kernel-gate-evidence!) [:gate-status :counts :fixture-count :manifest-bindings :function-arity-candidates]))\\\\\\\"]}}}' -M:test:gate\\\\n```\\\\n\\\\nThis evidence-writing command returns normally even when the recorded gate is\\\\nblocked; only the test command above is the acceptance gate.\\\\n\\\\nUnchanged regression suites:\\\\n\\\\n```sh\\\\nclj -M:test -n yang.clojure-test -n yin.vm.macro-test -n yang.clojure.stream-eval-test -n yin.vm.store-write-audit-test\\\\n```\\\\n\\\\n**Blocked at namespace loading**, `ClassNotFoundException:\\\\nyang.python.antlr.gen.Python3Lexer`; no green four-suite result. The stream/REPL\\\\nsuite imports the frontend catalog that requires the generated Python parser.\\\\nThe prerequisite attempt\\\\n`clj -M:antlr-gen --grammar python3 --target java` failed with\\\\n`java.nio.channels.UnresolvedAddressException` while retrieving required inputs.\\\\n\\\\nThe independent suites were then run separately:\\\\n\\\\n```sh\\\\nclj -M:test -n yang.clojure-test -n yin.vm.macro-test -n yin.vm.store-write-audit-test\\\\nclj -M:test -n yin.vm.semantic.linearize-test -n yin.vm.semantic.analysis-test -n yin.vm.semantic.frame-test\\\\n```\\\\n\\\\nRespectively **106 tests / 1,007 assertions** and **45 tests / 1,944 assertions**,\\\\nboth with **0 failures and 0 errors**.\\\\n\\\\nCross-host regression availability is separate from the JVM kernel oracle:\\\\n\\\\n- `bb test:changed:cljs --changed test/yang/latte_oracle_test.clj test/yang/latte_oracle/kernel_gate.edn`\\\\n  could not start: `bb` is absent (exit 127).\\\\n- Fallback `clj -M:cljs -m shadow.cljs.devtools.cli compile test` failed before any\\\\n  Node tests ran. `CompilerOptions` requires class-file version 65 (Java 21), but\\\\n  the active runtime supports version 61 (Java 17). Node itself is available.\\\\n- Dart/Flutter are absent from PATH. No Dart suite ran; that lane is unavailable,\\\\n  not green. Four-evaluator stream/REPL verification remains blocked as above.\\\\n- `git diff --check` passed.\\\\n;; GENERATED by src/dev/latte_oracle_manifest.clj from the pinned\\\\n;; latte-kernel git dependency (deps.edn :test, sha 86fca0d1).\\\\n;; {:ns ... :kind defn|def|defn- :name ...} one entry per top-level binding.\\\\n[{:ns latte_kernel.defenv, :kind defn, :name definition?, :source nil}\\\\n {:ns latte_kernel.defenv, :kind def, :name empty-env, :source nil}\\\\n {:ns latte_kernel.defenv, :kind defn, :name mkenv, :source nil}\\\\n {:ns latte_kernel.defenv,\\\\n  :kind defn,\\\\n  :name local-definitions,\\\\n  :source nil}\\\\n {:ns latte_kernel.defenv,\\\\n  :kind defn,\\\\n  :name register-definition,\\\\n  :source nil}\\\\n {:ns latte_kernel.defenv,\\\\n  :kind defn,\\\\n  :name fetch-definition,\\\\n  :source nil}\\\\n {:ns latte_kernel.defenv,\\\\n  :kind defn,\\\\n  :name registered-definition?,\\\\n  :source nil}\\\\n {:ns latte_kernel.defenv, :kind defn, :name qualify-def, :source nil}\\\\n {:ns latte_kernel.defenv, :kind defn, :name theorem?, :source nil}\\\\n {:ns latte_kernel.defenv, :kind defn, :name axiom?, :source nil}\\\\n {:ns latte_kernel.defenv, :kind defn, :name notation?, :source nil}\\\\n {:ns latte_kernel.defenv, :kind defn, :name implicit?, :source nil}\\\\n {:ns latte_kernel.defenv,\\\\n  :kind defn,\\\\n  :name latte-definition?,\\\\n  :source nil}\\\\n {:ns latte_kernel.nbe, :kind defn, :name instantiate-def, :source nil}\\\\n {:ns latte_kernel.nbe,\\\\n  :kind def,\\\\n  :name +unfold-implicit+,\\\\n2:description: File and content format rules for datom.world — .chp/.blog EDN+Hiccup files, tables in .md files, and git commit message format\\\\n53:The example table above is itself in the format: `docs/agents/team.md` and\\\\n54:`docs/design/yin.vm.universal-continuation-format.md` are the reference\\\\n59:## Git commit messages\\\\n71:commits are exempt from this format. Never add `Co-Authored-By`, including\\\\n72:LLM attribution, to any commit in this repository.\\\\n74:Whether and when a commit is *allowed* to happen (review requirements,\\\\n75:authorization, undoing an unauthorized commit) is role-specific policy, not\\\\n76:format — see [`roles/orchestrator.md`](roles/orchestrator.md)'s Coordination\\\\n;; and a closure's failure ends the library function with the same outcome.\\\\n;;\\\\n;; What is derived, from the VM primitives and the `data` module only:\\\\n;; identity, inc/dec, second, the collection predicates (coll?/vector?/map?/\\\\n;; set?/seq?/list?/sequential?, from the `portable/*` adapters of data/count,\\\\n;; peek, dissoc and disj: a refusal as data says \\\\\\\"not that kind\\\\\\\"), boolean?,\\\\n;; fn? (data/callable?), seq, rem, reverse, list, cons, vector, count,\\\\n;; contains?, rest, map/mapv/filter/remove/reduce (with reduced)/into/concat/merge,\\\\n;; keys/vals/disj and set union/difference,\\\\n;; comp, partial, gensym (explicit supply), not=, and `apply`, which is a\\\\n;; compiler intrinsic over the convention's argument vector.\\\\n;;\\\\n;; What stays a host primitive, named by the `kind` module: a symbol, a\\\\n;; keyword and a host string are distinguished or built only by the host\\\\n;; (symbol?, keyword?, name, symbol, keyword, str, int?), as is metadata access\\\\n;; (meta). No `data` export or\\\\n;; VM primitive tells a symbol from a keyword. var? and resolve are the host's\\\\n;; Var primitives: a harness on a host with Vars registers them in `kind`\\\\n;; (`kind-module` leaves them out); a program that never mentions them does\\\\n;; not need them.\\\\n;;\\\\n;; Known compromises: `reduced` is an untyped tagged map, so reduced? matches\\\\n;; any map holding :yin.k/reduced true; seq refuses a non-collection (a string\\\\n;; is the data module's str-* ops, not a seq); eager sequences are lists;\\\\n;; rem rejects non-integers and a zero divisor before arithmetic; the compiler\\\\n;; emits bare conj and vec, so a program may not define or bind either.\\\\n;;\\\\n;; Variadic Clojure functions are fixed-arity here (the convention has no\\\\n;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\\\\n;; merge 0 to 4, union 0 to 6, difference 2, comp 0 to 3, partial binds 1 to 3.\\\\n;; A larger count is the\\\\n;; function's own arity error.\\\\n\\\\n(def library-adapters\\\\n  \\\\\\\"The `:adapters` a program using `library` is compiled with: the data\\\\n   exports whose refusal the predicates read as data. The harness registers\\\\n   `portable/<name>` as `outcome-adapter` over the same `data/<name>`.\\\\\\\"\\\\n  {'data/count 'portable/count\\\\n   'data/peek 'portable/peek\\\\n   'data/dissoc 'portable/dissoc\\\\n   'data/disj 'portable/disj})\\\\n\\\\n\\\\n(def kind-module\\\\n  \\\\\\\"The `kind` host module's exports, symbol to host function: the irreducible\\\\n   kind and name primitives (see the library notes). Every export is pure.\\\\\\\"\\\\n  {'symbol? symbol?\\\\n   'keyword? keyword?\\\\n   'name name\\\\n   'symbol symbol\\\\n   'keyword keyword\\\\n   'str str\\\\n   'int? int?\\\\n   'meta meta})\\\\n\\\\n\\\\n(def kind-arities\\\\n  \\\\\\\"The published arities of each `kind` export.\\\\\\\"\\\\n  {'symbol? [1], 'keyword? [1], 'name [1], 'symbol [1 2], 'keyword [1 2]\\\\n   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'meta [1]})\\\\n\\\\n\\\\n(def library\\\\n  \\\\\\\"The library's definitions, in order, as quoted source.\\\\\\\"\\\\n  '[(defn identity\\\\n      [x]\\\\n      x)\\\\n    (defn inc\\\\n      [x]\\\\n      (+ x 1))\\\\n    (defn dec\\\\n      [x]\\\\n      (- x 1))\\\\n    (defn second\\\\n      [x]\\\\n      (first (rest x)))\\\\n    (defn not=\\\\n      [a b]\\\\n      (not (= a b)))\\\\n    (defn boolean?\\\\n      [x]\\\\n      (or (= x true) (= x false)))\\\\n    (defn fn?\\\\n      [x]\\\\n      (data/callable? x))\\\\n    (defn count\\\\n      [x]\\\\n      (data/count x))\\\\n    (defn contains?\\\\n      [coll k]\\\\n      (data/contains? coll k))\\\\n    (defn symbol?\\\\n      [x]\\\\n      (kind/symbol? x))\\\\n    (defn keyword?\\\\n      [x]\\\\n      (kind/keyword? x))\\\\n    (defn int?\\\\n      [x]\\\\n      (kind/int? x))\\\\n    (defn meta\\\\n      [x]\\\\n      (kind/meta x))\\\\n    (defn name\\\\n      [x]\\\\n      (kind/name x))\\\\n    (defn var?\\\\n      [x]\\\\n      (kind/var? x))\\\\n    (defn resolve\\\\n      [x]\\\\n      (kind/resolve x))\\\\n    (defn symbol\\\\n      ([n] (kind/symbol n))\\\\n      ([ns n] (kind/symbol ns n)))\\\\n    (defn keyword\\\\n      ([n] (kind/keyword n))\\\\n      ([ns n] (kind/keyword ns n)))\\\\n    (defn str\\\\n      ([] \\\\\\\"\\\\\\\")\\\\n      ([a] (kind/str a))\\\\n      ([a b] (kind/str a b))\\\\n      ([a b c] (kind/str a b c))\\\\n      ([a b c d] (kind/str a b c d))\\\\n      ([a b c d e] (kind/str a b c d e))\\\\n      ([a b c d e f] (kind/str a b c d e f)))\\\\n    (defn gensym\\\\n      ([n] (kind/symbol (kind/str \\\\\\\"G__\\\\\\\" n)))\\\\n      ([prefix n] (kind/symbol (kind/str prefix n))))\\\\n    (defn coll?\\\\n      [x]\\\\n      (if (nil? x)\\\\n        false\\\\n        (= :yin.k/ok (first (yin.k/outcome-of (data/count x))))))\\\\n    (defn vector?\\\\n      [x]\\\\n      (if (nil? x)\\\\n        false\\\\n        (= :yin.k/ok (first (yin.k/outcome-of (data/peek x))))))\\\\n    (defn map?\\\\n      [x]\\\\n      (if (nil? x)\\\\n        false\\\\n        (= :yin.k/ok (first (yin.k/outcome-of (data/dissoc x))))))\\\\n    (defn set?\\\\n      [x]\\\\n      (if (nil? x)\\\\n        false\\\\n        (= :yin.k/ok (first (yin.k/outcome-of (data/disj x))))))\\\\n    (defn sequential?\\\\n      [x]\\\\n      (if (coll? x) (if (map? x) false (not (set? x))) false))\\\\n    (defn seq?\\\\n      [x]\\\\n      (if (sequential? x) (not (vector? x)) false))\\\\n    (defn list?\\\\n      [x]\\\\n      (seq? x))\\\\n    ;; The VM's rest returns a vector. Supply the source language's sequence\\\\n    ;; shape here without changing that VM primitive.\\\\n    (defn rest\\\\n      [coll]\\\\n      (let [v (vec coll)]\\\\n        (loop [i (- (count v) 1), acc '()]\\\\n          (if (< i 1) acc (recur (- i 1) (conj acc (data/nth v i)))))))\\\\n    (defn seq\\\\n      [x]\\\\n      (cond\\\\n        (nil? x) nil\\\\n        (if (coll? x) (empty? x) false) nil\\\\n        (seq? x) x\\\\n        (coll? x) (reverse (reverse x))\\\\n        :else (throw (ex-info \\\\\\\"seq of a non-collection is not supported\\\\\\\"\\\\n                              {:value x}))))\\\\n    (defn rem\\\\n      [a b]\\\\n      (cond\\\\n        (not (if (int? a) (int? b) false))\\\\n        (throw (ex-info \\\\\\\"rem requires integer operands\\\\\\\" {:a a :b b}))\\\\n        (= b 0) (throw (ex-info \\\\\\\"Divide by zero\\\\\\\" {:a a}))\\\\n        (< a 0) (- 0 (rem (- 0 a) b))\\\\n        (< b 0) (rem a (- 0 b))\\\\n        :else (loop [r a]\\\\n                (if (< r b) r (recur (- r b))))))\\\\n    (defn reverse\\\\n      [coll]\\\\n      (loop [s coll\\\\n             acc '()]\\\\n        (if (empty? s) acc (recur (rest s) (conj acc (first s))))))\\\\n    (defn cons\\\\n      [x coll]\\\\n      (conj (reverse (reverse coll)) x))\\\\n    (defn list\\\\n      ([] '())\\\\n      ([a] (conj '() a))\\\\n      ([a b] (conj '() b a))\\\\n      ([a b c] (conj '() c b a))\\\\n      ([a b c d] (conj '() d c b a))\\\\n      ([a b c d e] (conj '() e d c b a))\\\\n      ([a b c d e f] (conj '() f e d c b a)))\\\\n    (defn vector\\\\n      ([] [])\\\\n      ([a] [a])\\\\n      ([a b] [a b])\\\\n      ([a b c] [a b c])\\\\n      ([a b c d] [a b c d])\\\\n      ([a b c d e] [a b c d e])\\\\n      ([a b c d e f] [a b c d e f]))\\\\n    (defn reduced\\\\n      [x]\\\\n      {:yin.k/reduced true, :yin.k/value x})\\\\n    (defn reduced?\\\\n      [x]\\\\n      (if (nil? x) false (= true (get x :yin.k/reduced))))\\\\n    (defn unreduced\\\\n      [x]\\\\n      (if (reduced? x) (get x :yin.k/value) x))\\\\n    (defn reduce\\\\n      ([f coll]\\\\n       (if (empty? coll) (f) (reduce f (first coll) (rest coll))))\\\\n      ([f init coll]\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/1793294621496-compiler-engineer-hardening2.gpt-6.1-sol.stdout.log:12:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The baseline evidence matches the reported 4 passes, 2 mismatches, and 48 blockers. The main paths are clear: the manifest needs explicit admission decisions, the context adapter needs two boundary fixes, and the compiler needs portable try/catch lowering. I’ll preserve the upstream function bodies through those adaptations.\\\"}}\\ncollab/1793294621496-compiler-engineer-hardening2.gpt-6.1-sol.stdout.log:14:{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '640,940p' src/cljc/yang/clojure.cljc; cat test/yang/latte_oracle/context.edn; sed -n '900,937p' test/yang/latte_oracle_test.clj; sed -n '1680,1718p' test/yang/clojure_test.clj; rg -n 'meta|str\\\\\\\\\\\\\\\\?' src/cljc/yin/vm/data.cljc; rg -n 'free-vars|unfold-implicit|opacity-fn|nanoTime|pprint|getMessage' /tmp/latte-kernel/src/latte_kernel/*.cljc\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"  (some? (::outcomes env)))\\\\n\\\\n\\\\n(defn- adapters\\\\n  [env]\\\\n  (:adapters (::outcomes env)))\\\\n\\\\n\\\\n(defn- binder-symbols\\\\n  [b]\\\\n  (into #{} (comp (filter symbol?) (remove #{'&})) (tree-seq coll? seq b)))\\\\n\\\\n\\\\n(defn- ok-form\\\\n  [v]\\\\n  [ok-tag v])\\\\n\\\\n\\\\n(defn- rebuild\\\\n  \\\\\\\"A list of `items` carrying the reader metadata of `form`.\\\\\\\"\\\\n  [form items]\\\\n  (let [out (apply list items)]\\\\n    (if-let [m (meta form)]\\\\n      (with-meta out m)\\\\n      out)))\\\\n\\\\n\\\\n(defn- gen-sym\\\\n  [env]\\\\n  (symbol (str reserved-prefix \\\\\\\"o\\\\\\\" (swap! (::gen env) inc))))\\\\n\\\\n\\\\n(defn- rewrite-ex-info\\\\n  \\\\\\\"(ex-info msg data cause?) as the portable map holding its parts.\\\\\\\"\\\\n  [form]\\\\n  (cond\\\\n    (seq? form)\\\\n    (cond\\\\n      (empty? form) form\\\\n      (= 'quote (first form)) form\\\\n      (= 'ex-info (first form))\\\\n      (let [[_ msg data cause] (map rewrite-ex-info form)]\\\\n        (cond-> {:yin.k/message msg, :yin.k/data data}\\\\n          (< 3 (count form)) (assoc :yin.k/cause cause)))\\\\n      :else (rebuild form (map rewrite-ex-info form)))\\\\n    (vector? form) (with-meta (mapv rewrite-ex-info form) (meta form))\\\\n    (map? form) (into {} (map (fn [[k v]] [(rewrite-ex-info k) (rewrite-ex-info v)])) form)\\\\n    (set? form) (into #{} (map rewrite-ex-info) form)\\\\n    :else form))\\\\n\\\\n\\\\n(defn- call-kind\\\\n  [env head]\\\\n  (cond\\\\n    (keyword? head) :keyword\\\\n    (not (symbol? head)) :guest\\\\n    (macro-call? env (::macro-env env) head) :macro\\\\n    (native-name? env head) (if (contains? (adapters env) head) :adapted :native)\\\\n    :else :guest))\\\\n\\\\n\\\\n(def ^:private lowered-specials\\\\n  #{'if 'let 'do 'loop 'recur 'throw 'quote 'fn 'and 'or})\\\\n\\\\n\\\\n(declare failing? expand-control)\\\\n\\\\n\\\\n(def ^:private control-heads\\\\n  \\\\\\\"case and the standard control forms: compiler forms that lower to\\\\n   if/let/do, so the outcome pass sees through them like those.\\\\\\\"\\\\n  #{'case 'cond 'when 'if-let 'if-some 'when-let 'when-some})\\\\n\\\\n\\\\n(defn- any-failing?\\\\n  [env forms]\\\\n  (boolean (some #(failing? env %) forms)))\\\\n\\\\n\\\\n(defn- check-macro-operands!\\\\n  \\\\\\\"A macro call is opaque to the lowering pass, so an operand that may fail\\\\n   would escape the early return: refuse it, naming the macro.\\\\\\\"\\\\n  [env head ops]\\\\n  (when (any-failing? env ops)\\\\n    (reject! (str \\\\\\\"Macro call \\\\\\\" head \\\\\\\" has an operand that may fail; \\\\\\\"\\\\n                  \\\\\\\"the outcome model cannot lower it\\\\\\\")\\\\n             {:macro head})))\\\\n\\\\n\\\\n(defn- scoped-failing?\\\\n  \\\\\\\"Whether a sequence of [target init] pairs or the body after them can fail,\\\\n   each init seeing the targets before it.\\\\\\\"\\\\n  [env pairs body]\\\\n  (loop [env env, ps pairs]\\\\n    (if (empty? ps)\\\\n      (any-failing? env body)\\\\n      (let [[target init] (first ps)]\\\\n        (or (failing? env init)\\\\n            (recur (with-locals env (binder-symbols target)) (rest ps)))))))\\\\n\\\\n\\\\n(defn- failing?\\\\n  \\\\\\\"True when evaluating `form` can produce an error outcome: a throw, or a\\\\n   call that returns an outcome (a guest call or an adapted primitive).\\\\\\\"\\\\n  [env form]\\\\n  (cond\\\\n    (seq? form)\\\\n    (if (empty? form)\\\\n      false\\\\n      (let [[head & ops] form]\\\\n        (cond\\\\n          (contains? #{'quote 'fn} head) false\\\\n          (= 'throw head) true\\\\n          (= 'let head) (let [[bindings & body] ops]\\\\n                          (scoped-failing? env (partition 2 (expand-bindings bindings env)) body))\\\\n          ;; the raw outcome of one guest call is a value, not a failure\\\\n          (= 'yin.k/outcome-of head) (do (when-not (and (= 1 (count ops)) (seq? (first ops)))\\\\n                                           (reject! \\\\\\\"yin.k/outcome-of takes one call\\\\\\\" {:form form}))\\\\n                                         (when (any-failing? env (first ops))\\\\n                                           (reject! \\\\\\\"yin.k/outcome-of operands cannot fail\\\\\\\"\\\\n                                                    {:form form}))\\\\n                                         false)\\\\n          (= 'dsg__let head) (let [[bindings & body] ops]\\\\n                               (scoped-failing? env (partition 2 bindings) body))\\\\n          (= 'loop head) (let [[bindings & body] ops]\\\\n                           (scoped-failing? env (partition 2 bindings) body))\\\\n          (contains? control-heads head) (failing? env (expand-control env head ops))\\\\n          (contains? lowered-specials head) (any-failing? env ops)\\\\n          :else (case (call-kind env head)\\\\n                  (:guest :adapted) true\\\\n                  :macro (do (check-macro-operands! env head ops) false)\\\\n                  (any-failing? env ops)))))\\\\n    (or (vector? form) (set? form)) (any-failing? env form)\\\\n    (map? form) (any-failing? env (concat (keys form) (vals form)))\\\\n    :else false))\\\\n\\\\n\\\\n(defn- atomic?\\\\n  [form]\\\\n  (or (symbol? form) (constant-form? form)))\\\\n\\\\n\\\\n(declare lower-tail)\\\\n\\\\n\\\\n(defn- bind-outcome\\\\n  \\\\\\\"Bind `outcome`, return it as is when it is an error, else continue with\\\\n   its payload.\\\\\\\"\\\\n  [env outcome k]\\\\n  (let [o (gen-sym env)]\\\\n    (list 'dsg__let [o outcome]\\\\n          (list 'if (list 'data/content= (list 'data/nth o 0) error-tag)\\\\n                o\\\\n                (k (list 'data/nth o 1))))))\\\\n\\\\n\\\\n(defn- lower-operand\\\\n  \\\\\\\"Continue with a simple form for `form`: the form itself when it cannot\\\\n   fail, else the payload of its outcome.\\\\\\\"\\\\n  [env form k]\\\\n  (if (failing? env form)\\\\n    (bind-outcome env (lower-tail env form) k)\\\\n    (k form)))\\\\n\\\\n\\\\n(defn- lower-operands\\\\n  \\\\\\\"Continue with simple forms for `forms`, evaluated left to right: a form\\\\n   before a may-fail one is bound first so the order of effects survives.\\\\\\\"\\\\n  [env forms k]\\\\n  (letfn [(go\\\\n            [fs acc]\\\\n            (if (empty? fs)\\\\n              (k acc)\\\\n              (let [f (first fs), more (rest fs)]\\\\n                (cond\\\\n                  (atomic? f) (go more (conj acc f))\\\\n                  (failing? env f) (lower-operand env f (fn [v] (go more (conj acc v))))\\\\n                  (any-failing? env more) (let [t (gen-sym env)]\\\\n                                            (list 