  140\t   boundary's composition and appears in neither the URL nor this function.\"\n   141\t  [descriptor]\n   142\t  (str \"ws://\" (:ws/host descriptor) \":\" (:ws/port descriptor) (:ws/path descriptor)))\n   143\t\n   144\t\n   145\t(defn wire!\n   146\t  \"Register the adapter callbacks as the sole subscriber of one host socket.\n   147\t\n   148\t   The socket's 'open', 'message', 'close', and 'error' events become\n   149\t   adapter entries.  'open' fires only for a dialing client socket -- a\n   150\t   server-accepted socket is already open when handed to this namespace,\n   151\t   so `:opened!`'s own phase guard makes a spurious call here harmless.\n   152\t   There is no admission wire frame any more: the mirror answers\n   153\t   not-found per identity once a reflection attaches, not this\n   154\t   transport's own accept/disclaim handshake.  Text arrives as the\n   155\t   frame's UTF-8 string through `:message!`; a binary frame's bytes\n   156\t   reach `:binary!` untouched.  The host error object never crosses: the\n   157\t   adapter deposits nothing itself, the transport's diagnostic entry\n   158\t   does.\"\n   159\t  [socket adapter]\n   160\t  (.on ^js socket \"open\" (fn [] ((:opened! adapter))))\n   161\t  (.on ^js socket \"message\"\n   162\t       (fn [data is-binary]\n   163\t         (if is-binary\n   164\t           ((:binary! adapter) data)\n   165\t           ((:message! adapter) (.toString ^js data \"utf8\")))))\n   166\t  (.on ^js socket \"close\"\n   167\t       (fn [code _reason] ((:closed! adapter) code _reason)))\n   168\t  (.on ^js socket \"error\"\n   169\t       (fn [_error] ((:error! adapter))))\n   170\t  socket)\n   100\t  [target]\n   101\t  (when (string? target)\n   102\t    (let [without-fragment (first (str/split target #\"#\" 2))\n   103\t          without-query (first (str/split without-fragment #\"\\?\" 2))\n   104\t          decoded (normalize-percent-escapes without-query)]\n   105\t      (when (some? decoded)