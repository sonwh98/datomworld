46\t            (locking connection\n   147\t              (when-not (:failed? @connection)\n   148\t                (swap! connection assoc :failed? true)\n   149\t                true)))\n   150\t          (fail!\n   151\t            []\n   152\t            ;; Outside the lock: the adapter entries may re-enter through\n   153\t            ;; close!, which must find the connection already failed rather\n   154\t            ;; than block on a lock this thread holds.\n   155\t            (when (claim-failure!)\n   156\t              ((:error! adapter))\n   157\t              (when-let [socket (:socket @connection)]\n   158\t                (.abort ^WebSocket socket))\n   159\t              ((:closed! adapter) 1006 \"dao.stream/send-failed\")))\n   160\t          (chain!\n   161\t            [f]\n   162\t            ;; The successor is built and installed under the lock; its\n   163\t            ;; completion observer is registered after leaving it. An\n   164\t            ;; already-exceptional future runs that observer inline, and\n   165\t            ;; reporting a failure while holding the submission monitor would\n   166\t            ;; block every other submitter across the adapter's deposits.\n   167\t            (let [next (locking connection\n   168\t                         (when-not (:failed? @connection)\n   169\t                           (let [pending (or (:pending @connection) (completed))\n   170\t                                 next (.thenCompose\n   171\t                                        ^CompletableFuture pending\n   172\t                                        (reify java.util.function.Function\n   173\t                                          (apply [_ _] (f))))]\n   174\t                             (swap! connection assoc :pending next)\n   175\t                             next)))]\n   176\t              (if next\n   177\t                (do (.whenComplete\n   178\t                      ^CompletableFuture next\n   179\t                      (reify java.util.function.BiConsumer\n   180\t                        (accept [_ _v error] (when error (fail!)))))\n   181\t                    nil)\n   182\t                ::failed)))]\n   183\t    {:send! (fn [payload]\n   184\t              (if-let [socket (:socket @connection)]\n   185\t                (let [result (chain! #(if (string? payload)\n   186\t                                        (.sendText ^WebSocket socket payload true)\n   187\t                                        (.sendBinary ^WebSocket socket\n   188\t                                                     (ByteBuffer/wrap ^bytes payload) true)))]\n   189\t                  ;; A failed connection is permanently gone, so it answers\n   190\t                  ;; `closed`, not the retryable `full` that `false` would\n","exit_code":0,"status":"completed"}}
