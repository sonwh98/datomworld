                                                      :dao.stream/newest))\n   205\t        polled-ended (rpc/poll! (rpc/client-state request-handle ended\n   206\t                                                   :dao.stream/newest))]\n   207\t    (is (= :dao.stream.rpc/lost (:dao.stream.rpc/outcome polled-not-found)))\n   208\t    (is (= :dao.stream.apply/not-found\n   209\t           (:terminal (:dao.stream.rpc/state polled-not-found))))\n   210\t    (is (= :dao.stream.apply/detached\n   211\t           (:terminal (:dao.stream.rpc/state polled-channel-gone))))\n   212\t    (is (= :dao.stream.apply/ended\n   213\t           (:terminal (:dao.stream.rpc/state polled-ended))))))\n   214\t\n   215\t\n   216\t(deftest a-mint-failure-loses-an-already-outstanding-request-too\n   217\t  (let [request-handle (handle)\n   218\t        not-found (mint-answering-reader\n   219\t                    {:dao.stream/outcome :dao.stream/transport-error\n   220\t                     :dao.stream.remote/reason :dao.stream.remote/not-found})\n   221\t        requested (rpc/request! (rpc/client-state request-handle not-found\n   222\t                                                   :dao.stream/newest)\n   223\t                                :op/a [])\n   224\t        polled (rpc/poll! (:dao.stream.rpc/state requested))\n   225\t        state (:dao.stream.rpc/state polled)]\n   226\t    (is (= :dao.stream.apply/not-found (:terminal state)))\n   227\t    (is (empty? (:outstanding state)))\n   228\t    (is (= 1 (count (:completed state))))\n   229\t    (is (= :dao.stream.apply/not-found\n   230\t           (:dao.stream.rpc/reason (first (:completed state)))))))\n   231\t\n   232\t\n   233\t(deftest append-terminal-outcome-completes-unsent-without-marking-it-outstanding\n   234\t  (let [closed-writer (reify stream/IDaoStreamWriter\n   235\t                        (append! [_ _] {:dao.stream/outcome :dao.stream/closed}))\n   210\t   transport selected (the adapter map's `:ws/codec`), so a