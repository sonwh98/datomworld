{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/ws.cljc | sed -n '1,560p'\"","aggregated_output":"     1\t(ns dao.stream.ws\n     2\t  \"The DaoStream v2 WebSocket protocol boundary.\n     3\t\n     4\t   This namespace deliberately knows no WebSocket library.  A host adapter owns\n     5\t   its raw socket and supplies the small synchronous `:connect!`, `:send!`, and\n     6\t   `:close!` functions below.  The public DaoStream surface is consequently\n     7\t   callback-free, non-waiting, and portable; socket callbacks enter only through\n     8\t   the adapter map returned to the host while it constructs a connection.\n     9\t\n    10\t   The wire codec is a composition choice carried as an explicit codec profile\n    11\t   (see `codec-profile?`): the `dao.stream.transit-json` text subprotocol and\n    12\t   the additive `dao.stream.cbor` binary subprotocol run the same state\n    13\t   machine, envelopes, and lifecycle.  Selection is explicit on both ends — a\n    14\t   client offers exactly its selected subprotocol, an endpoint serves exactly\n    15\t   the profiles it was composed with — so no silent downgrade exists.\"\n    16\t  (:require [dao.stream :as stream]\n    17\t            [dao.stream.transit :as transit]\n    18\t            [clojure.string :as str]))\n    19\t\n    20\t\n    21\t(def transport-type :dao.stream/ws)\n    22\t(def subprotocol \"dao.stream.transit-json\")\n    23\t(def ended-close-code 4000)\n    24\t(def protocol-close-code 4002)\n    25\t\n    26\t\n    27\t(defn codec-profile?\n    28\t  \"True for one codec profile: the WebSocket subprotocol name it negotiates,\n    29\t   the frame kind its payloads ride (:text or :binary), the portable-value\n    30\t   predicate for its domain, and its encoder and decoder over host payloads\n    31\t   (strings for text profiles, host bytes for binary profiles).\"\n    32\t  [x]\n    33\t  (and (map? x)\n    34\t       (string? (:ws/subprotocol x))\n    35\t       (contains? #{:text :binary} (:ws/frame-kind x))\n    36\t       (fn? (:ws/portable-value? x))\n    37\t       (fn? (:ws/encode x))\n    38\t       (fn? (:ws/decode x))))\n    39\t\n    40\t\n    41\t(defn checked-codec\n    42\t  \"Validate one composition-supplied codec profile, defaulting to Transit.\"\n    43\t  [x]\n    44\t  (let [codec (or x transit/profile)]\n    45\t    (when-not (codec-profile? codec)\n    46\t      (throw (ex-info \"invalid DaoStream WebSocket codec profile\" {:codec x})))\n    47\t    codec))\n    48\t\n    49\t\n    50\t(defn- outcome\n    51\t  [x]\n    52\t  {:dao.stream/outcome x})\n    53\t\n    54\t\n    55\t(defn canonical-path?\n    56\t  \"True for the already-canonical request-target form carried on a descriptor.\n    57\t   URI parsing and bind policy belong to the host adapter; this gate prevents a\n    58\t   query, fragment, relative path, or unresolved dot segment from reaching the\n    59\t   exact served-path lookup.\"\n    60\t  [path]\n    61\t  (and (string? path)\n    62\t       (not (empty? path))\n    63\t       (str/starts-with? path \"/\")\n    64\t       (not (str/includes? path \"?\"))\n    65\t       (not (str/includes? path \"#\"))\n    66\t       (not (some #{\".\" \"..\"} (str/split path #\"/\")))))\n    67\t\n    68\t\n    69\t(defn descriptor?\n    70\t  \"The settled WebSocket descriptor gate.  It names a served stream, not a\n    71\t   particular connection, and contains only portable reachability data.\n    72\t   The one-argument form keeps the Transit domain as the public default; a\n    73\t   composition selecting a codec profile gates the same descriptor against\n    74\t   that profile's domain.\"\n    75\t  ([x] (descriptor? x transit/profile))\n    76\t  ([x codec]\n    77\t   (and (map? x)\n    78\t        (= transport-type (:dao.stream/type x))\n    79\t        (string? (:dao.stream/identity x))\n    80\t        (string? (:ws/host x))\n    81\t        (integer? (:ws/port x))\n    82\t        (pos? (:ws/port x))\n    83\t        (canonical-path? (:ws/path x))\n    84\t        ((:ws/portable-value? codec) x))))\n    85\t\n    86\t\n    87\t(defn admission?\n    88\t  \"Assembly-time declaration required for every transport deposit medium.\"\n    89\t  [x]\n    90\t  (and (map? x)\n    91\t       (= :evict-oldest (:retention x))\n    92\t       (integer? (:capacity x))\n    93\t       (pos? (:capacity x))\n    94\t       (contains? #{:host-values :portable-values} (:value-domain x))))\n    95\t\n    96\t\n    97\t(defn- writer-target?\n    98\t  [x]\n    99\t  (and (map? x)\n   100\t       (stream/writer? (:dao.stream/handle x))\n   101\t       (contains? (:dao.stream/surface x) :writer)))\n   102\t\n   103\t\n   104\t(defn- checked-target\n   105\t  [target declaration]\n   106\t  (when-not (and (writer-target? target) (admission? declaration))\n   107\t    (throw (ex-info \"invalid DaoStream WebSocket deposit composition\"\n   108\t                    {:target target :admission declaration})))\n   109\t  target)\n   110\t\n   111\t\n   112\t(defn- attachment-id\n   113\t  []\n   114\t  (str (random-uuid)))\n   115\t\n   116\t\n   117\t(defn- invoke-close!\n   118\t  [socket code reason]\n   119\t  (when-let [f (:close! socket)]\n   120\t    (try\n   121\t      (f code reason)\n   122\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   123\t        ;; The connection has already transitioned locally.  The caller adds a\n   124\t        ;; diagnostic where it still has a functioning composed medium.\n   125\t        :failed))))\n   126\t\n   127\t\n   128\t(defn- send-result\n   129\t  [socket payload]\n   130\t  ;; The payload is whatever the attachment's codec produced — a string for\n   131\t  ;; text profiles, host bytes for binary profiles.  The transport never\n   132\t  ;; inspects it; the host `:send!` seam owns the typed frame.\n   133\t  (try\n   134\t    (let [x ((:send! socket) payload)]\n   135\t      (cond\n   136\t        (or (nil? x) (= true x) (= :ok x)) (outcome :dao.stream/ok)\n   137\t        (= false x) (outcome :dao.stream/full)\n   138\t        (and (map? x) (:dao.stream/outcome x)) x\n   139\t        :else (outcome :dao.stream/transport-error)))\n   140\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   141\t      (outcome :dao.stream/transport-error))))\n   142\t\n   143\t\n   144\t(declare receive! closed! opened!)\n   145\t\n   146\t\n   147\t(defn- deposit!\n   148\t  [state event]\n   149\t  (let [target (:deposit @state)\n   150\t        result (stream/append! (:dao.stream/handle target) event)]\n   151\t    ;; A host promised this medium admits all boundary events.  A failed\n   152\t    ;; deposit is therefore terminal, rather than a reason to retain a hidden\n   153\t    ;; inbox or silently discard the event.\n   154\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n   155\t      (let [socket (:socket @state)]\n   156\t        (swap! state assoc :phase :closed)\n   157\t        (invoke-close! socket 1000 \"dao.stream/deposit-failed\")))\n   158\t    result))\n   159\t\n   160\t\n   161\t(defn- emit!\n   162\t  \"Deposit one boundary event.  The four-argument form carries a payload and\n   163\t   always keys it, because nil is an ordinary portable value: a consumer must be\n   164\t   able to tell `value nil` from `no value` with `contains?`.\"\n   165\t  ([state attachment event]\n   166\t   (deposit! state {:ws/attachment attachment :ws/event event}))\n   167\t  ([state attachment event value]\n   168\t   (deposit! state {:ws/attachment attachment :ws/event event :ws/value value})))\n   169\t\n   170\t\n   171\t(defn- emit-reason!\n   172\t  [state attachment event reason]\n   173\t  (deposit! state {:ws/attachment attachment :ws/event event :ws/reason reason}))\n   174\t\n   175\t\n   176\t(defn- terminal!\n   177\t  [state attachment event]\n   178\t  (let [emit? (volatile! false)]\n   179\t    (swap! state\n   180\t           (fn [s]\n   181\t             (if (:terminal? s)\n   182\t               s\n   183\t               (do (vreset! emit? true)\n   184\t                   (assoc s :terminal? true :phase :closed)))))\n   185\t    (when @emit? (emit! state attachment event))))\n   186\t\n   187\t\n   188\t(deftype WsHandle\n   189\t  [state descriptor attachment codec]\n   190\t\n   191\t  stream/IDaoStreamDescriptor\n   192\t\n   193\t  (descriptor\n   194\t    [_]\n   195\t    {:dao.stream/outcome :dao.stream/ok\n   196\t     :dao.stream/descriptor descriptor\n   197\t     :dao.stream/identity (:dao.stream/identity descriptor)})\n   198\t\n   199\t\n   200\t  stream/IDaoStreamWriter\n   201\t\n   202\t  (append!\n   203\t    [_ value]\n   204\t    (let [{:keys [phase socket]} @state]\n   205\t      (cond\n   206\t        (= :closed phase) (outcome :dao.stream/closed)\n   207\t        (not= :open phase) (outcome :dao.stream/full)\n   208\t        (not ((:ws/portable-value? codec) value)) (outcome :dao.stream/invalid-value)\n   209\t        :else (try\n   210\t                (send-result socket ((:ws/encode codec) {:ws/frame :ws/value\n   211\t                                                         :ws/value value}))\n   212\t                (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   213\t                  (outcome :dao.stream/invalid-value))))))\n   214\t\n   215\t\n   216\t  stream/IDaoStreamClosable\n   217\t\n   218\t  (close!\n   219\t    [_]\n   220\t    (let [socket (volatile! nil)]\n   221\t      (swap! state\n   222\t             (fn [s]\n   223\t               (if (= :closed (:phase s))\n   224\t                 s\n   225\t                 (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   226\t      (when (= :failed (invoke-close! @socket 1000 \"dao.stream/detached\"))\n   227\t        (emit-reason! state attachment :ws/error :ws/close-failure))\n   228\t      (outcome :dao.stream/ok))))\n   229\t\n   230\t\n   231\t(defn close-ended!\n   232\t  \"Transport-specific close for a serving composition whose source ended.\n   233\t\n   234\t   Generic `stream/close!` is a reattachable detachment.  This helper sends the\n   235\t   WebSocket ended signal (4000 / `dao.stream/ended`) so the peer can deposit\n   236\t   `:ws/ended`.  The host close callback still owns exactly-once terminal event\n   237\t   delivery, just as it does for generic close.\"\n   238\t  [handle]\n   239\t  (let [state (.-state ^WsHandle handle)\n   240\t        attachment (.-attachment ^WsHandle handle)\n   241\t        socket (volatile! nil)]\n   242\t    (swap! state\n   243\t           (fn [s]\n   244\t             (if (= :closed (:phase s))\n   245\t               s\n   246\t               (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   247\t    (when (= :failed (invoke-close! @socket ended-close-code \"dao.stream/ended\"))\n   248\t      (emit-reason! state attachment :ws/error :ws/close-failure))\n   249\t    (outcome :dao.stream/ok)))\n   250\t\n   251\t\n   252\t(defn- new-handle\n   253\t  [descriptor attachment target phase socket codec]\n   254\t  (let [state (atom {:phase phase :socket socket :deposit target\n   255\t                     :resolution? false :terminal? false})]\n   256\t    [(WsHandle. state descriptor attachment codec) state]))\n   257\t\n   258\t\n   259\t(defn- protocol-failure!\n   260\t  [state attachment]\n   261\t  (emit-reason! state attachment :ws/error :ws/decode-failure)\n   262\t  (swap! state assoc :phase :closed)\n   263\t  (invoke-close! (:socket @state) protocol-close-code \"dao.stream/protocol-error\"))\n   264\t\n   265\t\n   266\t(defn opened!\n   267\t  \"Adapter entry: the host socket itself is open -- for a client, its own\n   268\t   `connect!` seam calls this the moment the underlying connection\n   269\t   establishes, with no wire frame of ours to wait for; for a server,\n   270\t   `accept-slot!` sets `:open` directly and this stays a guarded no-op\n   271\t   for it.  There is no admission handshake any more: a served identity's\n   272\t   presence is the mirror's own answer, per identity, once attached.\"\n   273\t  [handle]\n   274\t  (let [state (.-state ^WsHandle handle)\n   275\t        attachment (.-attachment ^WsHandle handle)\n   276\t        emit? (volatile! false)]\n   277\t    (swap! state (fn [s]\n   278\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   279\t                     (do (vreset! emit? true) (assoc s :phase :open :resolution? true))\n   280\t                     s)))\n   281\t    (when @emit? (emit! state attachment :ws/opened))))\n   282\t\n   283\t\n   284\t(defn- deliver!\n   285\t  \"Decode one inbound frame payload with the handle's codec and dispatch its\n   286\t   envelope.  Wire validation only; application values are never judged.\n   287\t\n   288\t   There is no admission handshake any more, so a value frame can outrun\n   289\t   the server's own accept-slot! (the client's socket opens and its\n   290\t   append! gate is live from that moment, ahead of this endpoint's own\n   291\t   acceptor tick).  A frame arriving while still `:pending` is that race,\n   292\t   not a protocol violation: it is queued and replayed once `accept-slot!`\n   293\t   installs the real deposit target and opens the handle.\"\n   294\t  [handle payload]\n   295\t  (let [state (.-state ^WsHandle handle)\n   296\t        attachment (.-attachment ^WsHandle handle)\n   297\t        codec (.-codec ^WsHandle handle)]\n   298\t    (try\n   299\t      (let [frame ((:ws/decode codec) payload)]\n   300\t        (if-not (and (= :ws/value (:ws/frame frame))\n   301\t                     (contains? frame :ws/value)\n   302\t                     ((:ws/portable-value? codec) (:ws/value frame)))\n   303\t          (protocol-failure! state attachment)\n   304\t          (let [value (:ws/value frame)]\n   305\t            (case (:phase @state)\n   306\t              :open (emit! state attachment :ws/payload value)\n   307\t              :pending (swap! state update :pending-frames\n   308\t                              (fnil conj []) value)\n   309\t              (protocol-failure! state attachment)))))\n   310\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   311\t        (protocol-failure! state attachment)))))\n   312\t\n   313\t\n   314\t(defn receive!\n   315\t  \"Adapter entry for one text WebSocket message.  A text frame on a binary\n   316\t   profile is a protocol failure — the transport reads the frame's declared\n   317\t   kind, never its content.\"\n   318\t  [handle text]\n   319\t  (if (= :text (:ws/frame-kind (.-codec ^WsHandle handle)))\n   320\t    (deliver! handle text)\n   321\t    (protocol-failure! (.-state ^WsHandle handle)\n   322\t                       (.-attachment ^WsHandle handle))))\n   323\t\n   324\t\n   325\t(defn receive-binary!\n   326\t  \"Adapter entry for one binary WebSocket message (a host byte payload):\n   327\t   byte[] on the JVM, Uint8Array on ClojureScript, Uint8List on Dart.  A\n   328\t   binary frame on a text profile is a protocol failure.\"\n   329\t  [handle bytes]\n   330\t  (if (= :binary (:ws/frame-kind (.-codec ^WsHandle handle)))\n   331\t    (deliver! handle bytes)\n   332\t    (protocol-failure! (.-state ^WsHandle handle)\n   333\t                       (.-attachment ^WsHandle handle))))\n   334\t\n   335\t\n   336\t(defn closed!\n   337\t  \"Adapter entry for host close completion.  The terminal event is guarded so\n   338\t   close/error races cannot duplicate it.\"\n   339\t  [handle code _reason]\n   340\t  (let [state (.-state ^WsHandle handle)\n   341\t        attachment (.-attachment ^WsHandle handle)]\n   342\t    (when-not (:resolution? @state)\n   343\t      (swap! state assoc :resolution? true)\n   344\t      (emit! state attachment :ws/transport-error))\n   345\t    (terminal! state attachment (if (= ended-close-code code) :ws/ended :ws/closed))))\n   346\t\n   347\t\n   348\t(defn adapter\n   349\t  \"The only callback-shaped value, for a host socket adapter while wiring its\n   350\t   private listener.  It is not a DaoStream API and never reaches consumers.\n   351\t   `:opened!` is the host's own connection-established signal (a client's\n   352\t   `connect!` seam calls it once the socket opens, with no admission wire\n   353\t   frame to wait for; a server socket is already open when accepted, so\n   354\t   this stays a no-op there).  `:message!` receives text frames and\n   355\t   `:binary!` binary frames — the two typed facts a host reports without\n   356\t   inspecting content — and `:ws/codec` is the connection's profile, so a\n   357\t   host `:connect!` seam can negotiate the selected subprotocol without\n   358\t   any second channel.\"\n   359\t  [handle]\n   360\t  {:opened! #(opened! handle)\n   361\t   :message! #(receive! handle %)\n   362\t   :binary! #(receive-binary! handle %)\n   363\t   :closed! #(closed! handle %1 %2)\n   364\t   :ws/codec (.-codec ^WsHandle handle)\n   365\t   :error! #(emit-reason! (.-state ^WsHandle handle) (.-attachment ^WsHandle handle)\n   366\t                          :ws/error :ws/socket-error)})\n   367\t\n   368\t\n   369\t(defn make-attacher\n   370\t  \"Construct the host-composed unary `attach!` entry point.\n   371\t\n   372\t   `:connect!` receives the descriptor and the private adapter map, starts\n   373\t   connection establishment, and synchronously returns a raw-socket adapter\n   374\t   containing `:send!` and `:close!`.  It must not wait for the peer.\n   375\t\n   376\t   `:codec` selects the wire profile explicitly (default: Transit).  The\n   377\t   offer is exactly the selected subprotocol, so a peer that does not speak\n   378\t   it fails the handshake rather than being downgraded.\"\n   379\t  [{:keys [traffic admission connect! codec] :as config}]\n   380\t  (let [target (checked-target traffic admission)\n   381\t        codec (checked-codec codec)]\n   382\t    (when-not (fn? connect!)\n   383\t      (throw (ex-info \"WebSocket host composition requires :connect!\" {:config config})))\n   384\t    (fn attach!\n   385\t      [descriptor]\n   386\t      (if-not (descriptor? descriptor codec)\n   387\t        (outcome :dao.stream/invalid-descriptor)\n   388\t        (let [id (attachment-id)\n   389\t              [handle state] (new-handle descriptor id target :connecting nil codec)]\n   390\t          (try\n   391\t            (let [socket (connect! descriptor (adapter handle))]\n   392\t              (if (and (map? socket) (fn? (:send! socket)) (fn? (:close! socket)))\n   393\t                (do (swap! state assoc :socket socket)\n   394\t                    {:dao.stream/outcome :dao.stream/ok\n   395\t                     :dao.stream/handle handle\n   396\t                     :dao.stream/attachment id})\n   397\t                (outcome :dao.stream/transport-error)))\n   398\t            (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   399\t              (outcome :dao.stream/transport-error))))))))\n   400\t\n   401\t\n   402\t;; Server acceptance is intentionally an endpoint composition object, not a\n   403\t;; global transport directory.  Its slots are supplied and owned by the host.\n   404\t;; One descriptor, not a served-path table: the mirror answers not-found\n   405\t;; per identity now, so this transport no longer routes an upgrade by path\n   406\t;; at all -- every upgrade this endpoint's own codec negotiation accepts is\n   407\t;; accepted, and what a client can reach through it is entirely the\n   408\t;; mirror's own table.\n   409\t(defn make-endpoint\n   410\t  [{:keys [descriptor control control-admission slots codecs] :as config}]\n   411\t  (let [control-target (checked-target control control-admission)\n   412\t        codecs (or codecs [transit/profile])]\n   413\t    (when-not (seq slots)\n   414\t      (throw (ex-info \"WebSocket endpoint needs handoff slots\" {:config config})))\n   415\t    (when-not (and (seq codecs) (every? codec-profile? codecs))\n   416\t      (throw (ex-info \"WebSocket endpoint needs at least one codec profile\" {:codecs codecs})))\n   417\t    (when-not (apply distinct? (map :ws/subprotocol codecs))\n   418\t      (throw (ex-info \"WebSocket endpoint codec subprotocols must be distinct\" {:codecs codecs})))\n   419\t    (when-not (= :portable-values (:value-domain control-admission))\n   420\t      (throw (ex-info \"endpoint control medium must carry portable values\" {:admission control-admission})))\n   421\t    ;; The one descriptor crosses under every profile the endpoint speaks,\n   422\t    ;; or the profile that cannot carry it must not be offered.\n   423\t    (when-not (every? #(descriptor? descriptor %) codecs)\n   424\t      (throw (ex-info \"invalid served descriptor\" {:descriptor descriptor})))\n   425\t    (doseq [slot slots]\n   426\t      (checked-target (:offer slot) (:offer-admission slot))\n   427\t      (checked-target (:ack slot) (:ack-admission slot))\n   428\t      (when-not (and (= 1 (get-in slot [:offer-admission :capacity]))\n   429\t                     (= :host-values (get-in slot [:offer-admission :value-domain]))\n   430\t                     (= 1 (get-in slot [:ack-admission :capacity]))\n   431\t                     (= :host-values (get-in slot [:ack-admission :value-domain]))\n   432\t                     (some? (:ack-cursor slot)))\n   433\t        (throw (ex-info \"invalid capacity-one WebSocket handoff slot\" {:slot slot}))))\n   434\t    {:config config\n   435\t     :codecs codecs\n   436\t     :codec-index (zipmap (map :ws/subprotocol codecs) codecs)\n   437\t     :state (atom {:control control-target\n   438\t                   :slots (mapv (fn [slot]\n   439\t                                  (assoc slot :status :free)) slots)\n   440\t                   :connections {}})}))\n   441\t\n   442\t\n   443\t(defn endpoint-state\n   444\t  [endpoint]\n   445\t  @(:state endpoint))\n   446\t\n   447\t\n   448\t(defn- endpoint-target\n   449\t  [endpoint]\n   450\t  (:control (endpoint-state endpoint)))\n   451\t\n   452\t\n   453\t(defn- release-slot!\n   454\t  \"Return one handoff slot to the bounded free pool and forget the connection it\n   455\t   held.  Releasing drops the retained handle: a released slot's acknowledgement\n   456\t   is stale by construction, so nothing may resolve through it afterwards.\"\n   457\t  [endpoint index attachment]\n   458\t  (swap! (:state endpoint)\n   459\t         (fn [s]\n   460\t           (-> s\n   461\t               (update-in [:slots index] dissoc\n   462\t                          :attachment :handle :handle-state :codec :opened-at)\n   463\t               (assoc-in [:slots index :status] :free)\n   464\t               (update :connections dissoc attachment)))))\n   465\t\n   466\t\n   467\t(defn accept-connection!\n   468\t  \"Bounded upgrade callback entry.  An exhausted slot pool is closed\n   469\t   immediately; otherwise this deposits precisely one host-local offer and\n   470\t   waits for `endpoint-step` to consume a matching acknowledgement.  There\n   471\t   is no served-path lookup here any more: every upgrade this endpoint's\n   472\t   own codec negotiation accepts is accepted, and what a client can reach\n   473\t   through it is entirely the mirror's own table, answered per identity\n   474\t   after the connection opens.  `path` is the caller's own routing concern\n   475\t   (a host bound to more than one endpoint still dispatches an upgrade to\n   476\t   the right one by it); this transport no longer inspects it.\n   477\t\n   478\t   The socket seam may carry `:ws/subprotocol`, the subprotocol the host\n   479\t   negotiated for this upgrade.  An endpoint serves every profile it was\n   480\t   composed with, concurrently; a named subprotocol it does not speak is a\n   481\t   refused handshake, never a downgrade, and an absent name is the Transit\n   482\t   default for sockets that negotiated nothing (direct composition and\n   483\t   tests).\"\n   484\t  ([endpoint path socket] (accept-connection! endpoint path socket nil))\n   485\t  ([endpoint _path socket now]\n   486\t   (let [descriptor (:descriptor (:config endpoint))\n   487\t         offered (:ws/subprotocol socket)\n   488\t         codec (if (nil? offered)\n   489\t                 transit/profile\n   490\t                 (get (:codec-index endpoint) offered))]\n   491\t     (cond\n   492\t       (nil? codec)\n   493\t       (do (invoke-close! socket protocol-close-code \"dao.stream/subprotocol-unsupported\")\n   494\t           {:ws/status :ws/unsupported-subprotocol})\n   495\t\n   496\t       :else\n   497\t       (let [state (:state endpoint)\n   498\t             chosen (volatile! nil)]\n   499\t         ;; Claim before depositing.  The offer append may synchronously invoke\n   500\t         ;; host code, so leaving the slot `:free` until after it returns would\n   501\t         ;; permit a second upgrade callback to overwrite the sole offer.\n   502\t         (swap! state (fn [s]\n   503\t                        (if-let [[index slot] (first (keep-indexed (fn [i x]\n   504\t                                                                     (when (= :free (:status x)) [i x]))\n   505\t                                                                   (:slots s)))]\n   506\t                          (do (vreset! chosen [index slot])\n   507\t                              (assoc-in s [:slots index :status] :reserving))\n   508\t                          s)))\n   509\t         (if-not @chosen\n   510\t           (do (invoke-close! socket 1013 \"dao.stream/acceptance-full\")\n   511\t               {:ws/status :ws/full})\n   512\t           (let [[index slot] @chosen\n   513\t                 id (attachment-id)\n   514\t                 [handle hstate] (new-handle descriptor id (endpoint-target endpoint) :pending socket codec)\n   515\t                 offer {:ws/attachment id :ws/event :ws/accepted\n   516\t                        :ws/handle {:dao.stream/handle handle\n   517\t                                    :dao.stream/surface #{:writer :closable}}}\n   518\t                 result (stream/append! (:dao.stream/handle (:offer slot)) offer)]\n   519\t             (if (= :dao.stream/ok (:dao.stream/outcome result))\n   520\t               (do (swap! state (fn [s]\n   521\t                                  (-> s\n   522\t                                      (assoc-in [:slots index :status] :pending)\n   523\t                                      (assoc-in [:slots index :attachment] id)\n   524\t                                      (assoc-in [:slots index :handle] handle)\n   525\t                                      (assoc-in [:slots index :handle-state] hstate)\n   526\t                                      (assoc-in [:slots index :codec] codec)\n   527\t                                      (assoc-in [:slots index :opened-at] now)\n   528\t                                      (assoc-in [:connections id] handle))))\n   529\t                   {:ws/status :ws/pending :ws/attachment id :ws/handle handle})\n   530\t               (do (swap! hstate assoc :phase :closed)\n   531\t                   (invoke-close! socket 1011 \"dao.stream/offer-failed\")\n   532\t                   (release-slot! endpoint index id)\n   533\t                   {:ws/status :ws/offer-failed})))))))))\n   534\t\n   535\t\n   536\t(defn- valid-ack?\n   537\t  [ack attachment]\n   538\t  (and (map? ack)\n   539\t       (= attachment (:ws/attachment ack))\n   540\t       (= :ws/accept (:ws/command ack))\n   541\t       (writer-target? (:ws/deposit ack))\n   542\t       (admission? (:ws/admission ack))))\n   543\t\n   544\t\n   545\t(defn- accept-slot!\n   546\t  \"The client is never told over the wire: there is no admission frame any\n   547\t   more, and nothing needs one -- `opened!` already ran when its own\n   548\t   socket opened, ahead of any acknowledgement.  This installs the\n   549\t   deposit target the acknowledgement carries, replays any value frames\n   550\t   `deliver!` queued while still pending (the client's own socket can\n   551\t   outrun this endpoint's acceptor tick), and releases the slot.\"\n   552\t  [endpoint index slot ack]\n   553\t  (let [hstate (:handle-state slot)\n   554\t        target (:ws/deposit ack)\n   555\t        queued (:pending-frames @hstate)]\n   556\t    (swap! hstate assoc :deposit target :phase :open :resolution? true\n   557\t           :pending-frames [])\n   558\t    (doseq [value queued]\n   559\t      (emit! hstate (:attachment slot) :ws/payload value))\n   560\t    (release-slot! endpoint index (:attachment slot))))\n","exit_code":0,"status":"completed"}}
