{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/yin/vm/ucf/remote_test.cljc'","aggregated_output":"     1\t(ns yin.vm.ucf.remote-test\n     2\t  \"The slice 8 acceptance row\n     3\t   (`docs/design/dao.stream.remote.implementation-plan.md` slice 8;\n     4\t   `yin.vm.universal-continuation-format.md` S7.4.3, S7.5.3, S7.11.1\n     5\t   'Reflection acceptance'): a string-backed stream migrates with a\n     6\t   kept cursor and resumes through a reflection; forced eviction\n     7\t   yields `gap` with the source's own successor cursor; a source\n     8\t   `serve!` refuses is `:yin.k/unsatisfied` before lift mints a value;\n     9\t   an `attach!` that answers gone is `:yin.k/unsatisfied` naming the\n    10\t   stream at lower. The remaining S7.4.3 variants -- `:put`, `:ffi`,\n    11\t   `:ffi-request`, `:link-request`, `:link-response`, `:install` --\n    12\t   round-trip through stub `serve!`/`attach!` callbacks, since their\n    13\t   proof is the shape of the bridge, not the transport.\"\n    14\t  (:require [clojure.test :refer [deftest is testing]]\n    15\t            [dao.stream :as stream]\n    16\t            [dao.stream.remote :as remote]\n    17\t            [dao.stream.ringbuffer :as ringbuffer]\n    18\t            [yin.vm.ucf.remote :as ucf.remote]))\n    19\t\n    20\t\n    21\t;; =============================================================================\n    22\t;; The toy: two in-process ring buffers as the channel (as\n    23\t;; dao.stream.remote-test), with a served-table `serve!` on top\n    24\t;; =============================================================================\n    25\t\n    26\t(defn- ring\n    27\t  [capacity]\n    28\t  (:dao.stream/handle\n    29\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    30\t                         :dao.stream.ringbuffer/capacity capacity})))\n    31\t\n    32\t\n    33\t(defn- toy\n    34\t  []\n    35\t  (let [ab (ring 64)\n    36\t        ba (ring 64)\n    37\t        cd {:dao.stream/type :dao.stream.test/channel\n    38\t            :dao.stream/identity \"ucf-remote-toy\"}]\n    39\t    {:channel cd, :ab ab, :ba ba,\n    40\t     :a-end {:reader ba, :writer ab},\n    41\t     :b-end {:reader ab, :writer ba}}))\n    42\t\n    43\t\n    44\t(defn- served-peer\n    45\t  [t]\n    46\t  {:table (atom {})\n    47\t   :b-reader (:reader (:b-end t))\n    48\t   :b-writer (:writer (:b-end t))\n    49\t   :mirror (atom (:dao.stream/cursor\n    50\t                   (stream/cursor (:reader (:b-end t)) :dao.stream/oldest)))})\n    51\t\n    52\t\n    53\t(defn- serve-mirror!\n    54\t  \"One mirror step over everything pending on the toy's request\n    55\t   buffer.\"\n    56\t  [peer]\n    57\t  (swap! (:mirror peer)\n    58\t         #(remote/mirror-step @(:table peer) (:b-reader peer) %\n    59\t                              (:b-writer peer))))\n    60\t\n    61\t\n    62\t(defn- server\n    63\t  \"The exporter's `serve!` (dao.stream.remote.md S2.3): assigns a\n    64\t   stable identity to `h`, entering it in the peer's table under\n    65\t   `chan`, if it is not already served.\"\n    66\t  [peer chan]\n    67\t  (fn [h]\n    68\t    (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\n    69\t                            @(:table peer))]\n    70\t      {:dao.stream/identity existing, :dao.stream/channel chan}\n    71\t      (let [id (str (gensym \"seg\"))]\n    72\t        (swap! (:table peer) assoc id {:handle h, :surface #{:reader}})\n    73\t        {:dao.stream/identity id, :dao.stream/channel chan}))))\n    74\t\n    75\t\n    76\t(defn- attacher\n    77\t  [t]\n    78\t  (remote/attacher\n    79\t    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\n    80\t\n    81\t\n    82\t;; =============================================================================\n    83\t;; The acceptance row: a kept cursor migrates and resumes\n    84\t;; =============================================================================\n    85\t\n    86\t(deftest migrates-with-a-kept-cursor-and-resumes\n    87\t  (let [t (toy)\n    88\t        s (ring 8)\n    89\t        peer (served-peer t)\n    90\t        serve! (server peer (:channel t))\n    91\t        attach! (attacher t)]\n    92\t    (stream/append! s \"hello\")\n    93\t    (stream/append! s \"world\")\n    94\t    (let [c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n    95\t          lifted (ucf.remote/lift-pending\n    96\t                   serve! {:reason :next, :stream {:handle s, :position c0}})]\n    97\t      (is (= {:yin.k/reason :next, :yin.k/cell :yin.k/c-0}\n    98\t             (:yin.k/pending lifted))\n    99\t          \"the cursor CELL id, S7.5.3 -- not a bare position\")\n   100\t      (is (= #{:dao.stream.remote/v1}\n   101\t             (get-in lifted [:yin.k/requires :yin.k/cursor-profiles])))\n   102\t      (let [served-id (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/stream\n   103\t                                      :dao.stream/identity])]\n   104\t        (is (some? served-id))\n   105\t        (is (= {:dao.stream/type :dao.stream/remote,\n   106\t               :dao.stream/identity served-id,\n   107\t               :dao.stream/channel (:channel t)}\n   108\t               (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/stream\n   109\t                              :dao.stream/descriptor]))\n   110\t            \"the cell descriptor is a remote descriptor\"))\n   111\t      (let [lowered (ucf.remote/lower-pending\n   112\t                      attach! (:yin.k/pending lifted) (:yin.k/cells lifted))]\n   113\t        (serve-mirror! peer)\n   114\t        (is (= c0 (:position lowered))\n   115\t            \"the receiver resumes at the kept position\")\n   116\t        (let [r (get-in lowered [:stream :handle])]\n   117\t          (is (= :dao.stream/blocked\n   118\t                 (:dao.stream/outcome (stream/next r c0))))\n   119\t          (serve-mirror! peer)\n   120\t          (is (= (stream/next s c0) (stream/next r c0))\n   121\t              \"the source's own outcome, verbatim, at the kept cursor\"))))))\n   122\t\n   123\t\n   124\t(deftest forced-eviction-yields-gap-with-the-sources-cursor\n   125\t  (let [t (toy)\n   126\t        s (ring 2)\n   127\t        peer (served-peer t)\n   128\t        serve! (server peer (:channel t))\n   129\t        attach! (attacher t)]\n   130\t    (stream/append! s \"hello\")\n   131\t    (let [c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   132\t          lifted (ucf.remote/lift-pending\n   133\t                   serve! {:reason :next, :stream {:handle s, :position c0}})\n   134\t          lowered (ucf.remote/lower-pending\n   135\t                    attach! (:yin.k/pending lifted) (:yin.k/cells lifted))]\n   136\t      (serve-mirror! peer)\n   137\t      (let [r (get-in lowered [:stream :handle])]\n   138\t        (doseq [v [\"v1\" \"v2\" \"v3\"]]\n   139\t          (stream/append! s v))\n   140\t        (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next r c0))))\n   141\t        (serve-mirror! peer)\n   142\t        (let [expected (stream/next s c0)\n   143\t              got (stream/next r c0)]\n   144\t          (is (= :dao.stream/gap (:dao.stream/outcome got)))\n   145\t          (is (= expected got) \"the source's own outcome map, verbatim\")\n   146\t          (is (= (:dao.stream/cursor expected) (:dao.stream/cursor got))\n   147\t              \"with the source's own recovery cursor\")\n   148\t          (testing \"no replay and no silent skip: the walk continues\n   149\t                    from the recovery cursor\"\n   150\t            (is (= :dao.stream/blocked\n   151\t                   (:dao.stream/outcome\n   152\t                     (stream/next r (:dao.stream/cursor got)))))\n   153\t            (serve-mirror! peer)\n   154\t            (let [ok (stream/next r (:dao.stream/cursor got))]\n   155\t              (is (= :dao.stream/ok (:dao.stream/outcome ok)))\n   156\t              (is (= \"v2\" (:dao.stream/value ok))))))))))\n   157\t\n   158\t\n   159\t;; =============================================================================\n   160\t;; Unsatisfied: a source that cannot honor the profile, a gone\n   161\t;; reflection\n   162\t;; =============================================================================\n   163\t\n   164\t(deftest lift-refuses-unsatisfied-when-the-source-cannot-be-served\n   165\t  (let [s (ring 4)]\n   166\t    (stream/append! s \"x\")\n   167\t    (let [c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   168\t          refusal (ucf.remote/lift-pending\n   169\t                    (constantly nil)\n   170\t                    {:reason :next, :stream {:handle s, :position c0}})]\n   171\t      (is (= :yin.k/unsatisfied (:yin.k/status refusal))\n   172\t          \"lift refuses before minting the value\")\n   173\t      (is (contains? refusal :dao.stream/identity)\n   174\t          \"naming the stream identity\"))))\n   175\t\n   176\t\n   177\t(deftest lower-refuses-unsatisfied-when-the-reflection-is-gone\n   178\t  (let [attach! (constantly {:dao.stream/outcome :dao.stream/transport-error\n   179\t                             :dao.stream.remote/reason\n   180\t                             :dao.stream.remote/not-found})\n   181\t        marker {:yin.k/tag :yin.k/stream,\n   182\t               :dao.stream/identity \"missing\",\n   183\t               :dao.stream/descriptor\n   184\t               {:dao.stream/type :dao.stream/remote,\n   185\t                :dao.stream/identity \"missing\",\n   186\t                :dao.stream/channel\n   187\t                {:dao.stream/type :dao.stream.test/channel,\n   188\t                 :dao.stream/identity \"elsewhere\"}}}\n   189\t        pending {:yin.k/reason :next, :yin.k/cell :yin.k/c-0}\n   190\t        cells {:yin.k/c-0 {:yin.k/stream marker, :yin.k/position 0}}\n   191\t        lowered (ucf.remote/lower-pending attach! pending cells)]\n   192\t    (is (= :yin.k/unsatisfied (:yin.k/status lowered)))\n   193\t    (is (= \"missing\" (:dao.stream/identity lowered))\n   194\t        \"naming the stream identity\")))\n   195\t\n   196\t\n   197\t;; =============================================================================\n   198\t;; The remaining S7.4.3 variants round-trip\n   199\t;; =============================================================================\n   200\t\n   201\t(defn- stub-serve!\n   202\t  \"A `serve!` that assigns every handle to one identity per handle\n   203\t   under `chan`, with no wire underneath: these variants prove the\n   204\t   bridge's shape, the transport already proven above.\"\n   205\t  [chan]\n   206\t  (let [ids (atom {})]\n   207\t    (fn [h]\n   208\t      (let [id (or (get @ids h)\n   209\t                   (let [n (str (gensym \"seg\"))]\n   210\t                     (swap! ids assoc h n)\n   211\t                     n))]\n   212\t        {:dao.stream/identity id, :dao.stream/channel chan}))))\n   213\t\n   214\t\n   215\t(defn- stub-attach!\n   216\t  \"An `attach!` that answers ok at once with a reflection standing for\n   217\t   the descriptor's identity -- opaque here, since these variants\n   218\t   never poll it.\"\n   219\t  []\n   220\t  (fn [d]\n   221\t    {:dao.stream/outcome :dao.stream/ok,\n   222\t     :dao.stream/handle [:reflection-of (:dao.stream/identity d)]}))\n   223\t\n   224\t\n   225\t(def ^:private chan\n   226\t  {:dao.stream/type :dao.stream.test/channel, :dao.stream/identity \"c\"})\n   227\t\n   228\t\n   229\t(deftest put-round-trips\n   230\t  (let [serve! (stub-serve! chan)\n   231\t        attach! (stub-attach!)\n   232\t        h [:handle :w]\n   233\t        entry {:reason :put, :stream {:handle h}, :value \"hello\"}\n   234\t        lifted (ucf.remote/lift-pending serve! entry)]\n   235\t    (is (= :put (get-in lifted [:yin.k/pending :yin.k/reason])))\n   236\t    (is (= \"hello\" (get-in lifted [:yin.k/pending :yin.k/value])))\n   237\t    (is (empty? (:yin.k/cells lifted))\n   238\t        \"a put wait names a stream, never a cursor cell\")\n   239\t    (let [lowered (ucf.remote/lower-pending\n   240\t                    attach! (:yin.k/pending lifted) (:yin.k/cells lifted))\n   241\t          served-id (get-in lifted [:yin.k/pending :yin.k/stream\n   242\t                                    :dao.stream/identity])]\n   243\t      (is (= :put (:reason lowered)))\n   244\t      (is (= \"hello\" (:value lowered)))\n   245\t      (is (= [:reflection-of served-id]\n   246\t             (get-in lowered [:stream :handle]))))))\n   247\t\n   248\t\n   249\t(deftest ffi-sent-round-trips\n   250\t  (let [serve! (stub-serve! chan)\n   251\t        attach! (stub-attach!)\n   252\t        entry {:reason :ffi, :call-id :call-7, :op :op/add,\n   253\t               :request {:handle [:h :req]},\n   254\t               :response {:handle [:h :resp], :position 5}}\n   255\t        lifted (ucf.remote/lift-pending serve! entry)\n   256\t        pending (:yin.k/pending lifted)]\n   257\t    (is (= :ffi (:yin.k/reason pending)))\n   258\t    (is (= :call-7 (:yin.k/call-id pending)))\n   259\t    (is (= :op/add (:yin.k/op pending)))\n   260\t    (is (= :yin.k/c-0 (:yin.k/cell pending)))\n   261\t    (is (= 5 (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position])))\n   262\t    (let [lowered (ucf.remote/lower-pending\n   263\t                    attach! pending (:yin.k/cells lifted))]\n   264\t      (is (= :ffi (:reason lowered)))\n   265\t      (is (= :call-7 (:call-id lowered)))\n   266\t      (is (= :op/add (:op lowered)))\n   267\t      (is (= 5 (:position lowered))))))\n   268\t\n   269\t\n   270\t(deftest ffi-retained-round-trips\n   271\t  (let [serve! (stub-serve! chan)\n   272\t        attach! (stub-attach!)\n   273\t        entry {:reason :ffi-request, :call-id :call-7,\n   274\t               :request-op :op/add, :request-args [1 2],\n   275\t               :request {:handle [:h :req]},\n   276\t               :response {:handle [:h :resp], :position 5}}\n   277\t        lifted (ucf.remote/lift-pending serve! entry)\n   278\t        pending (:yin.k/pending lifted)]\n   279\t    (is (= :ffi-request (:yin.k/reason pending)))\n   280\t    (is (= :op/add (:yin.k/request-op pending)))\n   281\t    (is (= [1 2] (:yin.k/request-args pending)))\n   282\t    (let [lowered (ucf.remote/lower-pending\n   283\t                    attach! pending (:yin.k/cells lifted))]\n   284\t      (is (= :ffi-request (:reason lowered)))\n   285\t      (is (= [1 2] (:request-args lowered))))))\n   286\t\n   287\t\n   288\t(deftest link-request-round-trips\n   289\t  (let [serve! (stub-serve! chan)\n   290\t        attach! (stub-attach!)\n   291\t        envelope {:yin.link/id [:t0 7], :yin.link/name 'foo,\n   292\t                  :yin.link/format :yin.debruijn.code,\n   293\t                  :yin.link/contract \"b2\"}\n   294\t        entry {:reason :link-request, :link-id [:t0 7], :envelope envelope,\n   295\t               :request {:handle [:h :req]},\n   296\t               :response {:handle [:h :resp], :position :dao.stream/newest}}\n   297\t        lifted (ucf.remote/lift-pending serve! entry)\n   298\t        pending (:yin.k/pending lifted)]\n   299\t    (is (= :link-request (:yin.k/reason pending)))\n   300\t    (is (= [:t0 7] (:yin.k/link-id pending)))\n   301\t    (is (= envelope (:yin.k/envelope pending)))\n   302\t    (let [lowered (ucf.remote/lower-pending\n   303\t                    attach! pending (:yin.k/cells lifted))]\n   304\t      (is (= :link-request (:reason lowered)))\n   305\t      (is (= envelope (:envelope lowered)))\n   306\t      (is (= :dao.stream/newest (:position lowered))))))\n   307\t\n   308\t\n   309\t(deftest link-response-round-trips\n   310\t  (let [serve! (stub-serve! chan)\n   311\t        attach! (stub-attach!)\n   312\t        entry {:reason :link-response, :link-id [:t0 7],\n   313\t               :response {:handle [:h :resp], :position 3}}\n   314\t        lifted (ucf.remote/lift-pending serve! entry)\n   315\t        pending (:yin.k/pending lifted)]\n   316\t    (is (= :link-response (:yin.k/reason pending)))\n   317\t    (is (= [:t0 7] (:yin.k/link-id pending)))\n   318\t    (let [lowered (ucf.remote/lower-pending\n   319\t                    attach! pending (:yin.k/cells lifted))]\n   320\t      (is (= :link-response (:reason lowered)))\n   321\t      (is (= [:t0 7] (:link-id lowered)))\n   322\t      (is (= 3 (:position lowered))))))\n   323\t\n   324\t\n   325\t(deftest install-passes-through-unchanged\n   326\t  (let [entry {:reason :install, :name 'foo}\n   327\t        lifted (ucf.remote/lift-pending (constantly nil) entry)]\n   328\t    (is (= {:yin.k/reason :install, :yin.k/name 'foo}\n   329\t           (:yin.k/pending lifted)))\n   330\t    (is (empty? (:yin.k/cells lifted)))\n   331\t    (let [lowered (ucf.remote/lower-pending\n   332\t                    (constantly nil) (:yin.k/pending lifted) {})]\n   333\t      (is (= {:reason :install, :name 'foo} lowered)))))\n   334\t\n   335\t\n   336\t(deftest an-unrecognized-reason-is-undecodable\n   337\t  (is (= :yin.k/undecodable\n   338\t         (:yin.k/status (ucf.remote/lift-pending\n   339\t                          (constantly nil) {:reason :bogus}))))\n   340\t  (is (= :yin.k/undecodable\n   341\t         (:yin.k/status (ucf.remote/lower-pending\n   342\t                          (constantly nil) {:yin.k/reason :bogus} {})))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/vm/ucf/remote.cljc'","aggregated_output":"     1\t(ns yin.vm.ucf.remote\n     2\t  \"The UCF facade through `dao.stream.remote` descriptors: lifts a\n     3\t   parked semantic-machine's pending wait\n     4\t   (`docs/design/yin.vm.universal-continuation-format.md` S7.4.3) into\n     5\t   UCF data whose cells and stream markers name `dao.stream.remote`\n     6\t   descriptors under the `:dao.stream.remote/v1` cursor profile\n     7\t   (S7.5.3), and lowers that data back into a resumable local wait\n     8\t   through a reflection (`docs/design/dao.stream.remote.md` S2.2, S2.4).\n     9\t\n    10\t   `lift-pending` and `lower-pending` are plain-data functions,\n    11\t   parameterized by two composition callbacks rather than coupled to\n    12\t   `yin.vm` or `dao.stream.remote` internals:\n    13\t\n    14\t     serve!  : handle -> {:dao.stream/identity id\n    15\t                          :dao.stream/channel chan} | nil\n    16\t               the exporter's own table entry\n    17\t               (`dao.stream.remote.md` S2.3): nil when the handle\n    18\t               cannot be served -- a cursor holding a host object, no\n    19\t               table to enter it in, no channel to the resumer -- which\n    20\t               refuses the lift as `:yin.k/unsatisfied` before minting\n    21\t               the value (S7.4.3).\n    22\t\n    23\t     attach! : remote-descriptor -> {:dao.stream/outcome :dao.stream/ok\n    24\t                                     :dao.stream/handle reflection}\n    25\t               | outcome-map\n    26\t               the receiver's own `:dao.stream/attach` dispatch for\n    27\t               `:dao.stream/remote` (`dao.stream.remote.md` S2.4): an\n    28\t               outcome other than `ok` -- including a reflection\n    29\t               already marked gone -- refuses the lower as\n    30\t               `:yin.k/unsatisfied` naming the stream identity.\n    31\t\n    32\t   Every pending variant of S7.4.3 lifts and lowers: `:next`, `:put`,\n    33\t   `:ffi`, `:ffi-request`, and the linker's `:link-request`,\n    34\t   `:link-response` and `:install` (`yin.vm.linker.md` S7.2-7.3).\n    35\t   `:install` names no stream and passes through unchanged.\n    36\t\n    37\t   Scope: one call lifts or lowers one pending entry, with its own\n    38\t   self-contained `:yin.k/cells` table -- the aliasing a whole frame's\n    39\t   shared cell table gives two waiters on one cell (S7.5.3) is a\n    40\t   concern of whatever assembles a full frame from many pending\n    41\t   entries, not of this bridge.\"\n    42\t  (:require [dao.stream :as stream]))\n    43\t\n    44\t\n    45\t(def cursor-profiles\n    46\t  \"The one portable cursor profile S7.4.3 names in :yin.k/requires: a\n    47\t   cursor is plain data in the channel's portable domain and the\n    48\t   source honors it after serialization, cursor identity, position and\n    49\t   `gap` outcomes included.\"\n    50\t  #{:dao.stream.remote/v1})\n    51\t\n    52\t\n    53\t(def ^:private requires\n    54\t  {:yin.k/cursor-profiles cursor-profiles})\n    55\t\n    56\t\n    57\t(def ^:private response-cell-id\n    58\t  \"The one response cursor cell a single pending entry ever carries.\n    59\t   Self-contained per lift call (see namespace docstring); a caller\n    60\t   merging several entries into one frame's cell table remaps ids as\n    61\t   it merges, the way S7.5.3 already requires on lowering.\"\n    62\t  :yin.k/c-0)\n    63\t\n    64\t\n    65\t;; =============================================================================\n    66\t;; Markers (S7.5.1), through a remote descriptor\n    67\t;; =============================================================================\n    68\t\n    69\t(defn- local-identity\n    70\t  \"The identity `h` itself declares, when its descriptor answers ok;\n    71\t   nil otherwise -- the best name a refusal can give when `serve!` has\n    72\t   not minted one.\"\n    73\t  [h]\n    74\t  (let [d (stream/descriptor h)]\n    75\t    (when (= :dao.stream/ok (:dao.stream/outcome d))\n    76\t      (:dao.stream/identity d))))\n    77\t\n    78\t\n    79\t(defn- unsatisfied\n    80\t  ([] (unsatisfied nil))\n    81\t  ([identity]\n    82\t   (cond-> {:yin.k/status :yin.k/unsatisfied}\n    83\t     (some? identity) (assoc :dao.stream/identity identity))))\n    84\t\n    85\t\n    86\t(defn lift-marker\n    87\t  \"The UCF stream marker (S7.5.1) for local handle `h`, its descriptor\n    88\t   the remote descriptor `serve!` mints by entering `h` in the\n    89\t   exporter's table (`dao.stream.remote.md` S2.2). nil when `serve!`\n    90\t   refuses -- the source cannot be entered, or cannot honor the\n    91\t   profile -- so a caller mints `:yin.k/unsatisfied` before any value\n    92\t   is produced (S7.4.3).\"\n    93\t  [serve! h]\n    94\t  (when-let [served (serve! h)]\n    95\t    (let [id (:dao.stream/identity served)]\n    96\t      {:yin.k/tag :yin.k/stream,\n    97\t       :dao.stream/identity id,\n    98\t       :dao.stream/descriptor\n    99\t       {:dao.stream/type :dao.stream/remote,\n   100\t        :dao.stream/identity id,\n   101\t        :dao.stream/channel (:dao.stream/channel served)}})))\n   102\t\n   103\t\n   104\t(defn lower-marker\n   105\t  \"The local handle `attach!` gives for UCF stream marker `m` -- a\n   106\t   reflection on the original logical stream -- or nil when the attach\n   107\t   does not answer ok: a reflection marked gone, or any other refusal,\n   108\t   is unsatisfied at the caller.\"\n   109\t  [attach! m]\n   110\t  (let [result (attach! (:dao.stream/descriptor m))]\n   111\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   112\t      (:dao.stream/handle result))))\n   113\t\n   114\t\n   115\t;; =============================================================================\n   116\t;; The pending wait (S7.4.3)\n   117\t;; =============================================================================\n   118\t;;\n   119\t;; Local pending-entry shapes this namespace lifts, and lowers back to\n   120\t;; -- plain data, not `yin.vm`'s own wait-set or resource shapes:\n   121\t;;\n   122\t;;   {:reason :next          :stream {:handle h} :position pos}\n   123\t;;   {:reason :put           :stream {:handle h} :value v}\n   124\t;;   {:reason :ffi           :call-id id :op op\n   125\t;;                          :request {:handle h} :response {:handle h}\n   126\t;;                          :position pos}\n   127\t;;   {:reason :ffi-request   :call-id id\n   128\t;;                          :request-op op :request-args args\n   129\t;;                          :request {:handle h} :response {:handle h}\n   130\t;;                          :position pos}\n   131\t;;   {:reason :link-request  :link-id id :envelope env\n   132\t;;                          :request {:handle h} :response {:handle h}\n   133\t;;                          :position pos}\n   134\t;;   {:reason :link-response :link-id id :response {:handle h}\n   135\t;;                          :position pos}\n   136\t;;   {:reason :install       :name sym}\n   137\t\n   138\t\n   139\t(defn- lift-response\n   140\t  \"The response marker for S7.4.3's `:yin.k/response`, and its cursor\n   141\t   cell (`response-cell-id`, at its kept position) for `:yin.k/cell`.\n   142\t   nil when `serve!` refuses the response stream.\"\n   143\t  [serve! response]\n   144\t  (when-let [marker (lift-marker serve! (:handle response))]\n   145\t    {:marker marker,\n   146\t     :cells {response-cell-id\n   147\t             {:yin.k/stream marker, :yin.k/position (:position response)}}}))\n   148\t\n   149\t\n   150\t(defn- lower-response\n   151\t  \"The local `{:handle reflection :position pos}` S7.4.3's response\n   152\t   cell lowers to, or nil when `attach!` refuses it.\"\n   153\t  [attach! cells cell-id]\n   154\t  (when-let [cell (get cells cell-id)]\n   155\t    (when-let [h (lower-marker attach! (:yin.k/stream cell))]\n   156\t      {:handle h, :position (:yin.k/position cell)})))\n   157\t\n   158\t\n   159\t(defn- cell-identity\n   160\t  \"The stream identity a `:yin.k/cells` entry names, for a refusal\n   161\t   that names it even when the cell itself never lowered.\"\n   162\t  [cells cell-id]\n   163\t  (get-in cells [cell-id :yin.k/stream :dao.stream/identity]))\n   164\t\n   165\t\n   166\t(defn lift-pending\n   167\t  \"One pending entry of S7.4.3, lifted: `{:yin.k/pending data,\n   168\t   :yin.k/cells {cell-id cell}, :yin.k/requires requires}` on success,\n   169\t   naming `:dao.stream.remote/v1` in `:yin.k/cursor-profiles`; the\n   170\t   S7.9 `:yin.k/unsatisfied` outcome, naming the stream identity where\n   171\t   one is known, when `serve!` refuses a stream the entry needs. An\n   172\t   unrecognized `:reason` is `:yin.k/undecodable`, naming the reason.\"\n   173\t  [serve! entry]\n   174\t  (case (:reason entry)\n   175\t    :next\n   176\t    (let [{:keys [handle position]} (:stream entry)]\n   177\t      (if-let [marker (lift-marker serve! handle)]\n   178\t        {:yin.k/pending {:yin.k/reason :next, :yin.k/cell response-cell-id},\n   179\t         :yin.k/cells {response-cell-id\n   180\t                       {:yin.k/stream marker, :yin.k/position position}},\n   181\t         :yin.k/requires requires}\n   182\t        (unsatisfied (local-identity handle))))\n   183\t\n   184\t    :put\n   185\t    (let [handle (get-in entry [:stream :handle])]\n   186\t      (if-let [marker (lift-marker serve! handle)]\n   187\t        {:yin.k/pending {:yin.k/reason :put,\n   188\t                         :yin.k/stream marker,\n   189\t                         :yin.k/value (:value entry)},\n   190\t         :yin.k/cells {},\n   191\t         :yin.k/requires {}}\n   192\t        (unsatisfied (local-identity handle))))\n   193\t\n   194\t    :ffi\n   195\t    (let [req-h (get-in entry [:request :handle])\n   196\t          req (lift-marker serve! req-h)\n   197\t          resp (lift-response serve! (:response entry))]\n   198\t      (if (and req resp)\n   199\t        {:yin.k/pending {:yin.k/reason :ffi,\n   200\t                         :yin.k/call-id (:call-id entry),\n   201\t                         :yin.k/op (:op entry),\n   202\t                         :yin.k/request req,\n   203\t                         :yin.k/response (:marker resp),\n   204\t                         :yin.k/cell response-cell-id},\n   205\t         :yin.k/cells (:cells resp),\n   206\t         :yin.k/requires requires}\n   207\t        (unsatisfied (or (local-identity req-h)\n   208\t                         (local-identity (get-in entry [:response :handle]))))))\n   209\t\n   210\t    :ffi-request\n   211\t    (let [req-h (get-in entry [:request :handle])\n   212\t          req (lift-marker serve! req-h)\n   213\t          resp (lift-response serve! (:response entry))]\n   214\t      (if (and req resp)\n   215\t        {:yin.k/pending {:yin.k/reason :ffi-request,\n   216\t                         :yin.k/call-id (:call-id entry),\n   217\t                         :yin.k/request-op (:request-op entry),\n   218\t                         :yin.k/request-args (:request-args entry),\n   219\t                         :yin.k/request req,\n   220\t                         :yin.k/response (:marker resp),\n   221\t                         :yin.k/cell response-cell-id},\n   222\t         :yin.k/cells (:cells resp),\n   223\t         :yin.k/requires requires}\n   224\t        (unsatisfied (or (local-identity req-h)\n   225\t                         (local-identity (get-in entry [:response :handle]))))))\n   226\t\n   227\t    :link-request\n   228\t    (let [req-h (get-in entry [:request :handle])\n   229\t          req (lift-marker serve! req-h)\n   230\t          resp (lift-response serve! (:response entry))]\n   231\t      (if (and req resp)\n   232\t        {:yin.k/pending {:yin.k/reason :link-request,\n   233\t                         :yin.k/link-id (:link-id entry),\n   234\t                         :yin.k/envelope (:envelope entry),\n   235\t                         :yin.k/request req,\n   236\t                         :yin.k/response (:marker resp),\n   237\t                         :yin.k/cell response-cell-id},\n   238\t         :yin.k/cells (:cells resp),\n   239\t         :yin.k/requires requires}\n   240\t        (unsatisfied (or (local-identity req-h)\n   241\t                         (local-identity (get-in entry [:response :handle]))))))\n   242\t\n   243\t    :link-response\n   244\t    (let [resp (lift-response serve! (:response entry))]\n   245\t      (if resp\n   246\t        {:yin.k/pending {:yin.k/reason :link-response,\n   247\t                         :yin.k/link-id (:link-id entry),\n   248\t                         :yin.k/response (:marker resp),\n   249\t                         :yin.k/cell response-cell-id},\n   250\t         :yin.k/cells (:cells resp),\n   251\t         :yin.k/requires requires}\n   252\t        (unsatisfied (local-identity (get-in entry [:response :handle])))))\n   253\t\n   254\t    :install\n   255\t    {:yin.k/pending {:yin.k/reason :install, :yin.k/name (:name entry)},\n   256\t     :yin.k/cells {},\n   257\t     :yin.k/requires {}}\n   258\t\n   259\t    {:yin.k/status :yin.k/undecodable, :yin.k/reason (:reason entry)}))\n   260\t\n   261\t\n   262\t(defn lower-pending\n   263\t  \"One pending entry of S7.4.3, lowered from `pending` (a\n   264\t   `:yin.k/pending` value) and its `cells` table (the matching\n   265\t   `:yin.k/cells`) back into the local shape `lift-pending` accepts,\n   266\t   its markers replaced by reflections `attach!` gives on the original\n   267\t   logical streams: attaching to every descriptor the entry names and\n   268\t   re-minting an equivalent wait on the local handles (S7.4.3). The\n   269\t   S7.9 `:yin.k/unsatisfied` outcome, naming the stream identity where\n   270\t   one is known, when `attach!` refuses a stream the entry needs -- a\n   271\t   reflection marked gone included. An unrecognized `:yin.k/reason` is\n   272\t   `:yin.k/undecodable`, naming the reason.\"\n   273\t  [attach! pending cells]\n   274\t  (case (:yin.k/reason pending)\n   275\t    :next\n   276\t    (if-let [r (lower-response attach! cells (:yin.k/cell pending))]\n   277\t      {:reason :next, :stream {:handle (:handle r)}, :position (:position r)}\n   278\t      (unsatisfied (cell-identity cells (:yin.k/cell pending))))\n   279\t\n   280\t    :put\n   281\t    (if-let [h (lower-marker attach! (:yin.k/stream pending))]\n   282\t      {:reason :put, :stream {:handle h}, :value (:yin.k/value pending)}\n   283\t      (unsatisfied (get-in pending [:yin.k/stream :dao.stream/identity])))\n   284\t\n   285\t    :ffi\n   286\t    (let [req (lower-marker attach! (:yin.k/request pending))\n   287\t          resp (when req (lower-response attach! cells (:yin.k/cell pending)))]\n   288\t      (cond\n   289\t        (and req resp)\n   290\t        {:reason :ffi, :call-id (:yin.k/call-id pending),\n   291\t         :op (:yin.k/op pending),\n   292\t         :request {:handle req}, :response {:handle (:handle resp)},\n   293\t         :position (:position resp)}\n   294\t\n   295\t        (nil? req)\n   296\t        (unsatisfied (get-in pending [:yin.k/request :dao.stream/identity]))\n   297\t\n   298\t        :else (unsatisfied (cell-identity cells (:yin.k/cell pending)))))\n   299\t\n   300\t    :ffi-request\n   301\t    (let [req (lower-marker attach! (:yin.k/request pending))\n   302\t          resp (when req (lower-response attach! cells (:yin.k/cell pending)))]\n   303\t      (cond\n   304\t        (and req resp)\n   305\t        {:reason :ffi-request, :call-id (:yin.k/call-id pending),\n   306\t         :request-op (:yin.k/request-op pending),\n   307\t         :request-args (:yin.k/request-args pending),\n   308\t         :request {:handle req}, :response {:handle (:handle resp)},\n   309\t         :position (:position resp)}\n   310\t\n   311\t        (nil? req)\n   312\t        (unsatisfied (get-in pending [:yin.k/request :dao.stream/identity]))\n   313\t\n   314\t        :else (unsatisfied (cell-identity cells (:yin.k/cell pending)))))\n   315\t\n   316\t    :link-request\n   317\t    (let [req (lower-marker attach! (:yin.k/request pending))\n   318\t          resp (when req (lower-response attach! cells (:yin.k/cell pending)))]\n   319\t      (cond\n   320\t        (and req resp)\n   321\t        {:reason :link-request, :link-id (:yin.k/link-id pending),\n   322\t         :envelope (:yin.k/envelope pending),\n   323\t         :request {:handle req}, :response {:handle (:handle resp)},\n   324\t         :position (:position resp)}\n   325\t\n   326\t        (nil? req)\n   327\t        (unsatisfied (get-in pending [:yin.k/request :dao.stream/identity]))\n   328\t\n   329\t        :else (unsatisfied (cell-identity cells (:yin.k/cell pending)))))\n   330\t\n   331\t    :link-response\n   332\t    (if-let [resp (lower-response attach! cells (:yin.k/cell pending))]\n   333\t      {:reason :link-response, :link-id (:yin.k/link-id pending),\n   334\t       :response {:handle (:handle resp)}, :position (:position resp)}\n   335\t      (unsatisfied (cell-identity cells (:yin.k/cell pending))))\n   336\t\n   337\t    :install\n   338\t    {:reason :install, :name (:yin.k/name pending)}\n   339\t\n   340\t    {:yin.k/status :yin.k/undecodable, :yin.k/reason (:yin.k/reason pending)}))\n","exit_code":0,"status":"completed"}}
