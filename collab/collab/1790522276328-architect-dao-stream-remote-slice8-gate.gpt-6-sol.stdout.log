{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '90,185p;385,480p' src/cljc/yin/vm/semantic.cljc | nl -ba -v 90\"","aggregated_output":"    90\t   land when telemetry is designed. A nil segment means the machine has no\n    91\t   control left, which is the halted state.\n    92\t\n    93\t   An empty continuation is stored as nil rather than [] so that\n    94\t   `engine/ready-for-ingress?`, which asks `(nil? (:k vm))`, sees a machine\n    95\t   between evaluations.\"\n    96\t  [vm seg pc val St E K]\n    97\t  (assoc vm\n    98\t         :control (when seg {:segment seg, :pc pc})\n    99\t         :value val\n   100\t         :stack (or St [])\n   101\t         :env E\n   102\t         :k (if (seq K) K nil)\n   103\t         :halted? (and (not (:blocked? vm)) (nil? seg))))\n   104\t\n   105\t\n   106\t(defn- response-wait-entry\n   107\t  \"The polling wait entry for a sent call awaiting its correlated response:\n   108\t   the machine registers {segment pc env stack k} plus the call-out reader\n   109\t   fields, in the shape `ffi/call-response-wait-entry` gives the walker.\"\n   110\t  [seg pc env stack k call-id]\n   111\t  {:segment seg, :pc pc, :env env, :stack stack, :k k,\n   112\t   :call-id call-id,\n   113\t   :reason :next,\n   114\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   115\t   :stream-id vm/call-out-stream-key})\n   116\t\n   117\t\n   118\t(defn semantic-restore\n   119\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   120\t\n   121\t   Two entry shapes carry more than registers:\n   122\t\n   123\t   - A `:request-sent` entry is a writer whose retained FFI request has now\n   124\t     been appended. The call starts waiting for its correlated response,\n   125\t     exactly as an immediately-sent one does, so the entry is replaced by its\n   126\t     response reader and the machine stays blocked.\n   127\t   - A `:call-id` entry is a response reader. The woken value is a response\n   128\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\n   129\t     parked call leaves `:parked` rather than accumulating.\"\n   130\t  ([base entry] (semantic-restore base entry (:value entry)))\n   131\t  ([base entry val]\n   132\t   (if (:request-sent entry)\n   133\t     (assoc base\n   134\t            :wait-set (conj (vec (or (:wait-set base) []))\n   135\t                            (response-wait-entry (:segment entry)\n   136\t                                                 (:pc entry)\n   137\t                                                 (:env entry)\n   138\t                                                 (:stack entry)\n   139\t                                                 (:k entry)\n   140\t                                                 (:call-id entry)))\n   141\t            :control nil\n   142\t            :k nil\n   143\t            :value :yin/blocked\n   144\t            :blocked? true\n   145\t            :halted? false)\n   146\t     (let [call-id (:call-id entry)\n   147\t           base (if call-id (update base :parked dissoc call-id) base)\n   148\t           val (if call-id (ffi/call-result val call-id) val)]\n   149\t       (put-registers base\n   150\t                      (:segment entry)\n   151\t                      (:pc entry)\n   152\t                      val\n   153\t                      (:stack entry)\n   154\t                      (:env entry)\n   155\t                      (:k entry))))))\n   156\t\n   157\t\n   158\t(defn- call-park-entries\n   159\t  \"Wait-entry builders for an instruction whose effect may block. The\n   160\t   continuation of an effect is the machine state after the instruction:\n   161\t   {segment, pc+1, env, stack, k} plus the transport fields the engine\n   162\t   fills in (§3.5). `St` is the operand stack with the instruction's operands\n   163\t   already popped.\"\n   164\t  [seg pc E St K]\n   165\t  {:stream/put (fn [_state _effect result]\n   166\t                 {:segment seg, :pc (inc pc), :env E, :stack St, :k K,\n   167\t                  :reason :put,\n   168\t                  :stream-id (:stream-id result)})\n   169\t   :stream/next (fn [_state _effect result]\n   170\t                  {:segment seg, :pc (inc pc), :env E, :stack St, :k K,\n   171\t                   :reason :next,\n   172\t                   :cursor-ref (:cursor-ref result),\n   173\t                   :stream-id (:stream-id result)})\n   174\t   :module/require (fn [_state _effect _result]\n   175\t                     {:segment seg, :pc (inc pc), :env E, :stack St, :k K})})\n   176\t\n   177\t\n   178\t(defn- run-effect\n   179\t  \"Materialize the registers, dispatch one effect through the engine, and\n   180\t   normalize the answer for the loop: `{:continue [state value]}` to go on at\n   181\t   pc+1 with `value` in the accumulator, or `{:stop vm}` when the effect\n   182\t   parked and the machine is blocked.\n   183\t\n   184\t   No `:restore-fn` crosses this boundary. A parked entry is pure data and\n   185\t   the scheduler below resumes it explicitly, so nothing live is attached to\n   186\t                                     {:effect :stream/make,\n   187\t                                      :capacity (or (nth inst 1)\n   188\t                                                    vm/default-stream-capacity)}\n   189\t                                     nil)]\n   190\t                   (if-let [[vm' val'] (:continue r)]\n   191\t                     (recur seg (inc pc) val' St E K vm' image\n   192\t                            (and fuel (dec fuel)))\n   193\t                     (:stop r)))\n   194\t              ;; :stream-put — target popped from St, value in val (13)\n   195\t              13 (let [St' (pop St)\n   196\t                       r (run-effect vm seg pc val St' E K\n   197\t                                     {:effect :stream/put,\n   198\t                                      :stream (peek St),\n   199\t                                      :val val}\n   200\t                                     (call-park-entries seg pc E St' K))]\n   201\t                   (if-let [[vm' val'] (:continue r)]\n   202\t                     (recur seg (inc pc) val' St' E K vm' image\n   203\t                            (and fuel (dec fuel)))\n   204\t                     (:stop r)))\n   205\t              ;; :stream-cursor — source ref in val (14)\n   206\t              14 (let [r (run-effect vm seg pc val St E K\n   207\t                                     {:effect :stream/cursor, :stream val}\n   208\t                                     nil)]\n   209\t                   (if-let [[vm' val'] (:continue r)]\n   210\t                     (recur seg (inc pc) val' St E K vm' image\n   211\t                            (and fuel (dec fuel)))\n   212\t                     (:stop r)))\n   213\t              ;; :stream-next — cursor ref in val (15)\n   214\t              15 (let [r (run-effect vm seg pc val St E K\n   215\t                                     {:effect :stream/next, :cursor val}\n   216\t                                     (call-park-entries seg pc E St K))]\n   217\t                   (if-let [[vm' val'] (:continue r)]\n   218\t                     (recur seg (inc pc) val' St E K vm' image\n   219\t                            (and fuel (dec fuel)))\n   220\t                     (:stop r)))\n   221\t              ;; :stream-close — source ref in val (16)\n   222\t              16 (let [r (run-effect vm seg pc val St E K\n   223\t                                     {:effect :stream/close, :stream val}\n   224\t                                     nil)]\n   225\t                   (if-let [[vm' val'] (:continue r)]\n   226\t                     (recur seg (inc pc) val' St E K vm' image\n   227\t                            (and fuel (dec fuel)))\n   228\t                     (:stop r)))\n   229\t              ;; :ffi-call — park-and-call over the FFI pair (21)\n   230\t              21 (let [ffi-op (nth inst 1)\n   231\t                       argc (nth inst 2)\n   232\t                       total (count St)\n   233\t                       args (subvec St (- total argc))\n   234\t                       St' (subvec St 0 (- total argc))\n   235\t                       ;; The pair is checked before parking: an error raised\n   236\t                       ;; after park-continuation would strand a continuation\n   237\t                       ;; in :parked and consume an id counter.\n   238\t                       {:keys [call-in]}\n   239\t                       (ffi/require-call-pair! (:resources vm) ffi-op)\n   240\t                       vm' (put-registers vm seg pc val St' E K)\n   241\t                       parked (engine/park-continuation\n   242\t                                vm'\n   243\t                                {:segment seg, :pc (inc pc),\n   244\t                                 :env E, :stack St', :k K})\n   245\t                       call-id (get-in parked [:value :id])\n   246\t                       request (apply2/request call-id ffi-op args)\n   247\t                       result (apply2/put-request! call-in request)]\n   248\t                   (case (:dao.stream/outcome result)\n   249\t                     :dao.stream/ok\n   250\t                     (-> parked\n   251\t                         (update :wait-set (fnil conj [])\n   252\t                                 (response-wait-entry seg (inc pc) E St' K\n   253\t                                                      call-id))\n   254\t                         (assoc :control nil\n   255\t                                :k nil\n   256\t                                :value :yin/blocked\n   257\t                                :blocked? true\n   258\t                                :halted? false))\n   259\t                     :dao.stream/full\n   260\t                     (-> parked\n   261\t                         (update :wait-set (fnil conj [])\n   262\t                                 {:segment seg, :pc (inc pc),\n   263\t                                  :env E, :stack St', :k K,\n   264\t                                  :request-sent true,\n   265\t                                  :call-id call-id,\n   266\t                                  :op ffi-op,\n   267\t                                  :reason :put,\n   268\t                                  :stream-id vm/call-in-stream-key,\n   269\t                                  :datom request})\n   270\t                         (assoc :control nil\n   271\t                                :k nil\n   272\t                                :value :yin/blocked\n   273\t                                :blocked? true\n   274\t                                :halted? false))\n   275\t                     (throw (ex-info \"FFI request could not be appended\"\n   276\t                                     {:op ffi-op,\n   277\t                                      :outcome (or (:dao.stream/outcome result)\n   278\t                                                   (:dao.stream.apply/outcome\n   279\t                                                     result))}))))\n   280\t              ;; No decoded image holds another opcode (:move stays unused)\n   281\t              (throw (ex-info \"Unknown opcode in segment\"\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '730,790p' src/cljc/dao/stream/remote.cljc | nl -ba -v 730\"","aggregated_output":"   730\t       (= :dao.stream/remote (:dao.stream/type d))\n   731\t       (contains? d :dao.stream/channel)))\n   732\t\n   733\t\n   734\t(defn attacher\n   735\t  \"The composition's :dao.stream/attach entry for :dao.stream/remote\n   736\t   descriptors; a dynamic dispatch table has this entry and no\n   737\t   :dao.stream/create one, because attaching through this transport\n   738\t   never creates. `opts` carries the composition data:\n   739\t   :dao.stream.remote/channels maps each channel descriptor this peer\n   740\t   reaches to its own end {:reader r :writer w} -- two ring buffers in\n   741\t   one process today, the ws, udp and pair channels of section 3\n   742\t   later; :dao.stream.remote/events is the optional event writer the\n   743\t   links emit on; :dao.stream.remote/resend-after is the links'\n   744\t   resend-after k, unbounded on an ordered reliable channel and small\n   745\t   on udp; :dao.stream.remote/budget is the budget stamped on every\n   746\t   next request. One link is kept per channel descriptor, shared by\n   747\t   every reflection through that channel. attach! answers ok at once\n   748\t   with a reflection handle and a local, opaque\n   749\t   :dao.stream/attachment -- the contract's deferred remote\n   750\t   confirmation -- and the link sends one descriptor probe for the\n   751\t   identity: its answer is the reflection's confirmation, not-found\n   752\t   marking the reflection gone, ok recording the source's descriptor\n   753\t   and declared surface.\"\n   754\t  [opts]\n   755\t  (let [channels (:dao.stream.remote/channels opts)\n   756\t        policy (select-keys opts [:dao.stream.remote/events\n   757\t                                  :dao.stream.remote/resend-after\n   758\t                                  :dao.stream.remote/budget])\n   759\t        links (atom {})]\n   760\t    (fn [descriptor]\n   761\t      (if-not (valid-remote-descriptor? descriptor)\n   762\t        (result :dao.stream/invalid-descriptor)\n   763\t        (let [cd (:dao.stream/channel descriptor)]\n   764\t          (if-not (contains? channels cd)\n   765\t            (result :dao.stream/not-found)\n   766\t            (do (swap! links\n   767\t                       (fn [m]\n   768\t                         (if (contains? m cd)\n   769\t                           m\n   770\t                           (assoc m cd\n   771\t                                  (new-link (get channels cd) policy)))))\n   772\t                (let [link (get @links cd)\n   773\t                      refl (atom {:link link\n   774\t                                  :descriptor descriptor\n   775\t                                  :identity (:dao.stream/identity\n   776\t                                              descriptor)\n   777\t                                  :surface nil\n   778\t                                  :source-descriptor nil\n   779\t                                  :gone? false\n   780\t                                  :closed? false\n   781\t                                  :ids #{}})]\n   782\t                  (send-request!\n   783\t                    link refl\n   784\t                    (wire-request link refl :dao.stream/descriptor []))\n   785\t                  {:dao.stream/outcome :dao.stream/ok\n   786\t                   :dao.stream/handle (ReflectionHandle. refl)\n   787\t                   :dao.stream/attachment (str (random-uuid))}))))))))\n","exit_code":0,"status":"completed"}}
