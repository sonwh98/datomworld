alue `x`.\"\n   703\t  [tag x]\n   704\t  (filter #(and (map? %) (= tag (:yin.k/tag %)))\n   705\t          (tree-seq coll? (fn [n] (if (map? n) (vals n) (seq n))) x)))\n   706\t\n   707\t\n   708\t(defn- attach-stream!\n   709\t  \"The handle the composition's `:attach-stream` gives for a stream\n   710\t   marker's descriptor, or `:yin.k/unsatisfied` when it has none or the\n   711\t   attach does not answer `ok`.\"\n   712\t  [state marker]\n   713\t  (let [attach (:attach-stream state)\n   714\t        result (when (fn? attach) (attach (:dao.stream/descriptor marker)))]\n   715\t    (if (= :dao.stream/ok (outcome result))\n   716\t      (:dao.stream/handle result)\n   717\t      (fail \"Stream reference cannot be attached at the receiver\"\n   718\t            {:yin.k/status :yin.k/unsatisfied,\n   719\t             :dao.stream/identity (:dao.stream/identity marker),\n   720\t             :outcome (outcome result)}))))\n   721\t\n   722\t\n   723\t(defn- lower-resources\n   724\t  \"Resource lowering (r9): install, in the receiver's private\n   725\t   `:resources`, an attached handle under a fresh resource id for every\n   726\t   stream the encoded `values` name -- directly or through a cursor cell\n   727\t   -- and a cursor cell seeded with its carried position for every cell\n   728\t   they reference, two references to one cell sharing one entry. No store\n   729\t   key is ever created. Returns `[state streams cells]`, the id maps the\n   730\t   decoder remaps references by.\"\n   731\t  [state values cells]\n   732\t  (let [used (sort-by str (distinct (map :yin.k/cell\n   733\t                                         (markers :yin.k/cursor-ref values))))\n   734\t        lifted (mapv (fn [cid]\n   735\t                       (or (get cells cid)\n   736\t                           (fail \"Undecodable value\"\n   737\t                                 {:yin.k/status :yin.k/undecodable,\n   738\t                                  :yin.k/cell cid})))\n   739\t                     used)\n   740\t        [state streams]\n   741\t        (reduce (fn [[s acc] marker]\n   742\t                  (let [ident (:dao.stream/identity marker)]\n   743\t                    (if (contains? acc ident)\n   744\t                      [s acc]\n   745\t                      (let [handle (attach-stream! s marker)\n   746\t                            [id s] (gensym s \"stream\")]\n   747\t                        [(assoc-in s [:resources id] handle)\n   748\t                         (assoc acc ident id)]))))\n   749\t                [state {}]\n   750\t                (concat (markers :yin.k/stream values)\n   751\t                        (map :yin.k/stream lifted)))\n   752\t        [state cell-ids]\n   753\t        (reduce (fn [[s acc] [cid cell]]\n   754\t                  (let [[id s] (gensym s \"cursor\")\n   755\t                        stream-id (get streams\n   756\t                                       (get-in cell [:yin.k/stream\n   757\t                                                     :dao.stream/identity]))]\n   758\t                    [(assoc-in s [:resources id]\n   759\t                               (vm/cursor-entry stream-id\n   760\t                                                (:yin.k/position cell)))\n   761\t                     (assoc acc cid id)]))\n   762\t                [state {}]\n   763\t                (map vector used lifted))]\n   764\t    [state streams cell-ids]))\n   765\t\n   766\t\n   767\t(defn- encode-store\n   768\t  [encode store]\n   769\t  (into {} (map (fn [[k v]] [(encode k) (encode v)])) store))\n   770\t\n   771\t\n   772\t(defn- decode-store\n   773\t  [decode snapshot]\n   774\t  (into {} (map (fn [[k v]] [(decode k) (decode v)])) snapshot))\n   775\t\n   776\t\n   777\t(defn lift-slice\n   778\t  \"Act 1 of `linked` (yin.vm.linker.md section 7.3): the halted child's\n   779\t   exports and module stores in the portable encoding. `own` is the\n   780\t   module's manifest address. Return