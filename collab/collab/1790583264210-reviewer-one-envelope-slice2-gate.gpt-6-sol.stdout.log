{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/remote_pair_test.cljc | sed -n '95,260p'\"","aggregated_output":"    95\t  \"A stand-in for `in`, a reflection whose relay pair the serving peer\n    96\t   reclaimed: its cursor mints ok at 0, its next answers blocked until\n    97\t   `reclaimed?` is set, then transport-error naming `reason`.\"\n    98\t  [reclaimed? reason]\n    99\t  (reify stream/IDaoStreamReader\n   100\t    (cursor\n   101\t      [_ _anchor]\n   102\t      {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n   103\t\n   104\t    (next\n   105\t      [_ _c]\n   106\t      (if @reclaimed?\n   107\t        {:dao.stream/outcome :dao.stream/transport-error\n   108\t         :dao.stream.remote/reason reason}\n   109\t        {:dao.stream/outcome :dao.stream/blocked}))))\n   110\t\n   111\t\n   112\t(defn- flaky-in\n   113\t  \"A stand-in for `in` whose cursor mints ok at 0 and whose next\n   114\t   answers `answer`, an atom, counting every next it is asked in\n   115\t   `asks`.\"\n   116\t  [answer asks]\n   117\t  (reify stream/IDaoStreamReader\n   118\t    (cursor\n   119\t      [_ _anchor]\n   120\t      {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor 0})\n   121\t\n   122\t    (next\n   123\t      [_ _c]\n   124\t      (swap! asks inc)\n   125\t      @answer)))\n   126\t\n   127\t\n   128\t;; =============================================================================\n   129\t;; 3.3's own rule: an in gap ends the channel\n   130\t;; =============================================================================\n   131\t\n   132\t(deftest pair-gap-ends-the-channel-test\n   133\t  (let [ab (ring 8)\n   134\t        ba (ring 2)\n   135\t        events (ring 16)\n   136\t        pcd (pair-descriptor \"pair-1\" \"ba-id\" \"ab-id\")\n   137\t        attach! (pair/attacher\n   138\t                  {:dao.stream.remote.pair/attach!\n   139\t                   (lower-attach! {\"ba-id\" ba \"ab-id\" ab})\n   140\t                   :dao.stream.remote/events events})\n   141\t        r (:dao.stream/handle (attach! (outer-descriptor \"svc-1\" pcd)))]\n   142\t    (testing \"attach answers ok at once, in's cursor minted at :newest\"\n   143\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/descriptor r)))))\n   144\t    (let [sent (stream/append! r :v)]\n   145\t      (is (= :dao.stream/ok (:dao.stream/outcome sent))\n   146\t          \"the append! request crossed on ab, unanswered -- it is what\n   147\t           the channel loss below abandons\")\n   148\t      (testing \"flooding ba past its retention outruns the cursor\n   149\t                minted at attach, before any op has read it\"\n   150\t        (dotimes [_ 4] (stream/append! ba :noise))\n   151\t        (let [ans (stream/next r 0)]\n   152\t          (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   153\t          (is (= :dao.stream.remote/channel-gone\n   154\t                 (:dao.stream.remote/reason ans))\n   155\t              \"the gap on in is never relayed as a source's own gap:\n   156\t               the reader answered end, and the link ran its\n   157\t               channel-loss path\")))\n   158\t      (testing \"the abandoned append! is reported append-unknown\"\n   159\t        (is (some #(= :dao.stream.remote/append-unknown\n   160\t                      (:dao.stream.remote/event %))\n   161\t                  (values events))))\n   162\t      (testing \"reads answer channel-gone, not retryable, from here on\"\n   163\t        (let [ans (stream/cursor r :dao.stream/oldest)]\n   164\t          (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   165\t          (is (= :dao.stream.remote/channel-gone\n   166\t                 (:dao.stream.remote/reason ans))))))))\n   167\t\n   168\t\n   169\t;; =============================================================================\n   170\t;; A reclaimed relay pair ends the channel like a gap\n   171\t;; =============================================================================\n   172\t\n   173\t(deftest pair-not-found-ends-the-channel-test\n   174\t  (doseq [reason [:dao.stream.remote/not-found\n   175\t                  :dao.stream.remote/channel-gone]]\n   176\t    (let [ab (ring 8)\n   177\t          events (ring 16)\n   178\t          reclaimed? (atom false)\n   179\t          pcd (pair-descriptor \"pair-1\" \"in-id\" \"ab-id\")\n   180\t          attach! (pair/attacher\n   181\t                    {:dao.stream.remote.pair/attach!\n   182\t                     (lower-attach! {\"in-id\" (reclaimable-in reclaimed?\n   183\t                                                             reason)\n   184\t                                     \"ab-id\" ab})\n   185\t                     :dao.stream.remote/events events})\n   186\t          r (:dao.stream/handle (attach! (outer-descriptor \"svc-1\" pcd)))]\n   187\t      (testing \"attach answers ok at once, in's cursor minted at :newest\"\n   188\t        (is (= :dao.stream/ok\n   189\t               (:dao.stream/outcome (stream/descriptor r)))))\n   190\t      (let [sent (stream/append! r :v)]\n   191\t        (is (= :dao.stream/ok (:dao.stream/outcome sent))\n   192\t            \"the append! request crossed on ab, unanswered -- it is\n   193\t             what the channel loss below abandons\")\n   194\t        (testing \"in's transport-error naming not-found or channel-gone\n   195\t                  ends the binding, like a gap\"\n   196\t          (reset! reclaimed? true)\n   197\t          (let [ans (stream/next r 0)]\n   198\t            (is (= :dao.stream/transport-error\n   199\t                   (:dao.stream/outcome ans)))\n   200\t            (is (= :dao.stream.remote/channel-gone\n   201\t                   (:dao.stream.remote/reason ans))\n   202\t                \"in's loss is never relayed raw: the reader ended, and\n   203\t                 the link ran its channel-loss path\")))\n   204\t        (testing \"the abandoned append! is reported append-unknown\"\n   205\t          (is (some #(= :dao.stream.remote/append-unknown\n   206\t                        (:dao.stream.remote/event %))\n   207\t                    (values events))))\n   208\t        (testing \"reads answer channel-gone, not retryable, from here on\"\n   209\t          (let [ans (stream/cursor r :dao.stream/oldest)]\n   210\t            (is (= :dao.stream/transport-error\n   211\t                   (:dao.stream/outcome ans)))\n   212\t            (is (= :dao.stream.remote/channel-gone\n   213\t                   (:dao.stream.remote/reason ans)))))))))\n   214\t\n   215\t\n   216\t(deftest a-retryable-in-transport-error-does-not-end-the-binding-test\n   217\t  (let [ab (ring 8)\n   218\t        asks (atom 0)\n   219\t        in-next (atom {:dao.stream/outcome :dao.stream/transport-error\n   220\t                       :dao.stream/retry? true})\n   221\t        pcd (pair-descriptor \"pair-1\" \"in-id\" \"ab-id\")\n   222\t        attach! (pair/attacher\n   223\t                  {:dao.stream.remote.pair/attach!\n   224\t                   (lower-attach! {\"in-id\" (flaky-in in-next asks)\n   225\t                                   \"ab-id\" ab})})\n   226\t        r (:dao.stream/handle (attach! (outer-descriptor \"svc-1\" pcd)))]\n   227\t    (testing \"the retryable transport-error passes through, the\n   228\t              binding not ended\"\n   229\t      (is (= :dao.stream/blocked\n   230\t             (:dao.stream/outcome (stream/next r 0)))\n   231\t          \"the outer link answers as though unanswered\"))\n   232\t    (testing \"in is asked again on the next drain: the binding lives\"\n   233\t      (reset! in-next {:dao.stream/outcome :dao.stream/blocked})\n   234\t      (is (= :dao.stream/blocked\n   235\t             (:dao.stream/outcome (stream/next r 0))))\n   236\t      (is (= 2 @asks)\n   237\t          \"a reader that had ended would never ask in again\"))))\n   238\t\n   239\t\n   240\t;; =============================================================================\n   241\t;; attach! on the same pair descriptor resumes\n   242\t;; =============================================================================\n   243\t\n   244\t(deftest reattachment-resumes-test\n   245\t  (let [ab (ring 8)\n   246\t        ba (ring 2)\n   247\t        pcd (pair-descriptor \"pair-1\" \"ba-id\" \"ab-id\")\n   248\t        handles {\"ba-id\" ba \"ab-id\" ab}\n   249\t        attach! (pair/attacher\n   250\t                  {:dao.stream.remote.pair/attach! (lower-attach! handles)})\n   251\t        r1 (:dao.stream/handle (attach! (outer-descriptor \"svc-1\" pcd)))]\n   252\t    (stream/descriptor r1)\n   253\t    (dotimes [_ 4] (stream/append! ba :noise))\n   254\t    (let [gone (stream/next r1 0)]\n   255\t      (is (= :dao.stream.remote/channel-gone\n   256\t             (:dao.stream.remote/reason gone))\n   257\t          \"the first attachment is gone: forced past ba's retention\"))\n   258\t    (testing \"a fresh attach! on the same pair descriptor value builds\n   259\t              a fresh channel, minted at ba's :newest\"\n   260\t      (let [r2 (:dao.stream/handle\n","exit_code":0,"status":"completed"}}
