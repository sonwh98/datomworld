r p (grant-of t id))]\n+        hd (holder p b id)]\n     (doseq [ms (range 2 61)]\n       (holder-pass! hd ms)\n       (tick-step! t b ms))\n-    (is (< 10 (:renewals @hd)) \"the holder renewed throughout\")\n-    (is (lease/holding? (:state @hd) {:ms 60})\n+    (is (= (grant-of t id) (h/grant @hd))\n+        \"the grant it holds is the one on the grantor's stream, read\n+         through the served lease-grants entry\")\n+    (is (< 10 (::h/renewals @hd)) \"the holder renewed throughout\")\n+    (is (h/holding? @hd)\n         \"its bound advanced only on the source's ok\")\n     (is (empty? (lapses t)) \"no reclaim over 60 lease ticks: 5 durations\")\n     (is (= l (:dao.lease/lease (rs/lease-of b id))))\n@@ -894,16 +861,16 @@\n         _ (remember!)\n         _ (tick-step! t b 1)\n         p (peer (:a-end t))\n-        hd (holder p (grant-of t id))]\n+        hd (holder p b id)]\n     (doseq [ms (range 2 6)]\n       (holder-pass! hd ms)\n       (tick-step! t b ms))\n     (is (contains? (rs/table b) id))\n-    (let [{holder' :holder release :release} (lease/stop (:state @hd))]\n-      (swap! hd assoc :state holder')\n-      (is (= :dao.stream/ok\n-             (:dao.stream/outcome (stream/append! (:refl @hd) release)))\n-          \"the release is appended on the holder's attributed medium\"))\n+    (is (= (grant-of t id) (h/grant @hd)) \"observed through lease-grants\")\n+    (swap! hd h/release!)\n+    (is (nil? (::h/release @hd))\n+        \"the release was accepted on the holder's attributed medium\")\n+    (is (false? (h/holding? @hd)) \"released: the holder acts no more\")\n     (tick-step! t b 6)\n     (is (= [(lease/lapsed l :release)] (lapses t))\n         \"reclaimed for :release in the pass that read it\")\n@@ -919,7 +886,7 @@\n     (testing \"the holder observes the reclaim as not-found\"\n       (is (= :dao.stream.remote/not-found\n              (:dao.stream.remote/reason\n-               (gone-after-step b (:refl @hd) (lease/renewal l))))))))\n+               (gone-after-step b (::h/renewal @hd) (lease/renewal l))))))))\n \n \n (deftest detach-without-expiry-keeps-entry-and-lease\n@@ -1089,7 +1056,7 @@\n       (is (= #{:silence :policy} (set (map :dao.lease/cause (lapses t)))))\n       (is (= 2 (count (lapses t))) \"each recorded exactly once\")\n       (is (empty? (:ledger (rs/judge b))))\n-      (is (empty? (rs/table b)))))\n+      (is (empty? (exports b)))))\n   (testing \"a reclaim after close! is harmless, and the leases still end\"\n     (let [t (toy)\n           b (rs/open! (opts t))\n     1\t(ns yin.vm.ffi.remote-serve.responder\n     2\t  \"The FFI apply responder at the possessing peer: the interpreter that\n     3\t   reads apply requests off a VM's call-in stream and appends apply\n     4\t   responses to its call-out stream, over the call pair an export\n     5\t   binding (`yin.vm.ffi.remote-serve`) serves to a remote VM.\n     6\t\n     7\t   It is a separate namespace because it is a separate observer of the\n     8\t   same streams. The binding's mirror serves stream OPERATIONS on\n     9\t   call-in and call-out -- a remote VM's append! lands on call-in, its\n    10\t   next reads call-out -- and interprets no value; this responder\n    11\t   interprets the apply VALUES and knows nothing of the channel, the\n    12\t   table or the leases. Neither drives the other: the one drive owner\n    13\t   calls `rs/step` and `step` in turn.\n    14\t\n    15\t   `open!` exports call-in as a remote WRITER and call-out as a remote\n    16\t   READER through the binding's own `serve!`, so the binding's\n    17\t   injected authority gate (`::rs/admit?`) and surface policy decide\n    18\t   whether this peer's handlers are reachable at all -- there is no\n    19\t   second, default gate that admits everything. The handler map is\n    20\t   required and explicit.\n    21\t\n    22\t   `step` is one `dao.stream.apply/serve-once!` over the caller-owned\n    23\t   server state the responder value carries: the request is read\n    24\t   whole, as the VM appended it -- extra keys and all, never rebuilt\n    25\t   from op and args -- its id answered on call-out, and a computed\n    26\t   response retained with its successor across `full`, so no handler\n    27\t   runs twice. Two responder-level rules sit on top:\n    28\t\n    29\t   - A gap on the call-in cursor is terminal loss (as\n    30\t     `yin.vm.ffi/bridge-step` treats it locally): a request was evicted\n    31\t     and the parked call that made it could never be answered. The\n    32\t     responder reports `::request-lost` and closes call-out, so every\n    33\t     VM waiting on that pair reads end and raises through\n    34\t     `yin.vm.ffi/call-result` instead of parking forever.\n    35\t   - Once the binding no longer serves call-in or call-out -- retired,\n    36\t     closed, or reclaimed by its lease -- the responder is terminal\n    37\t     (`::retired`) and invokes no further handler for that tenure.\n    38\t\n    39\t   The responder is a plain value threaded by its drive owner; nothing\n    40\t   here loops, waits or reads a clock.\"\n    41\t  (:require [dao.stream :as stream]\n    42\t            [dao.stream.apply :as apply2]\n    43\t            [yin.vm.ffi.remote-serve :as rs]))\n    44\t\n    45\t\n    46\t(defn- handlers?\n    47\t  \"An explicit handler map: operation keyword -> function.\"\n    48\t  [m]\n    49\t  (and (map? m)\n    50\t       (every? keyword? (keys m))\n    51\t       (every? fn? (vals m))))\n    52\t\n    53\t\n    54\t(defn remote-descriptor\n    55\t  \"The portable remote descriptor for a served marker `{:dao.stream/identity\n    56\t   id :dao.stream/channel cd}` -- what a remote peer attaches.\"\n    57\t  [served]\n    58\t  {:dao.stream/type :dao.stream/remote\n    59\t   :dao.stream/identity (:dao.stream/identity served)\n    60\t   :dao.stream/channel (:dao.stream/channel served)})\n    61\t\n    62\t\n    63\t(defn- refused\n    64\t  [option reason]\n    65\t  {::status ::refused, ::refusals [{::option option, ::reason reason}]})\n    66\t\n    67\t\n    68\t(defn- served-surface\n    69\t  [binding served]\n    70\t  (get-in (rs/table binding) [(:dao.stream/identity served) :surface]))\n    71\t\n    72\t\n    73\t(defn- export\n    74\t  \"Serve call-in and call-out through `binding`, or name the refusal.\n    75\t   Returns `[in out nil]` or `[_ _ refusal]`.\"\n    76\t  [binding call-in call-out]\n    77\t  (let [in (rs/serve! binding call-in)\n    78\t        out (when in (rs/serve! binding call-out))]\n    79\t    [in out\n    80\t     (cond\n    81\t       (nil? in) (refused ::call-in ::unservable)\n    82\t       (not (contains? (served-surface binding in) :writer))\n    83\t       (refused ::call-in ::surface)\n    84\t       (nil? out) (refused ::call-out ::unservable)\n    85\t       (not (contains? (served-surface binding out) :reader))\n    86\t       (refused ::call-out ::surface))]))\n    87\t\n    88\t\n    89\t(defn open!\n    90\t  \"Export the call pair `::call-in`/`::call-out` through `binding` and\n    91\t   assemble the responder over `::handlers`, or refuse.\n    92\t\n    93\t   `opts`:\n    94\t     ::call-in   the VM's call-in stream at this peer: this responder\n    95\t                 reads it locally, a remote VM appends to it -- served\n    96\t                 with a surface containing :writer\n    97\t     ::call-out  the VM's call-out stream at this peer: this responder\n    98\t                 appends to it, a remote VM reads it -- served with a\n    99\t                 surface containing :reader\n   100\t     ::handlers  the explicit handler map, op keyword -> fn; no default\n   101\t\n   102\t   The request cursor is minted from call-in itself before anything is\n   103\t   served. A refusal -- no handler map, a call-in that mints no\n   104\t   cursor, either endpoint unservable under the binding's gate and\n   105\t   surface policy, or served without the surface it needs -- retires\n   106\t   every identity this call served, so no provisional export outlives\n   107\t   it; handles already served before it stay served.\n   108\t\n   109\t   Returns `{::binding b ::call-in h ::call-out h ::handlers m\n   110\t   ::endpoint apply-endpoint ::state apply-server-state}` --\n   111\t   `::endpoint` is the `dao.stream.apply/endpoint` of the two remote\n   112\t   descriptors a remote VM attaches -- or `{::status ::refused\n   113\t   ::refusals [...]}`.\"\n   114\t  [binding {::keys [call-in call-out handlers]}]\n   115\t  (cond\n   116\t    (not (rs/binding? binding)) (refused ::binding ::malformed)\n   117\t    (nil? handlers) (refused ::handlers ::missing)\n   118\t    (not (handlers? handlers)) (refused ::handlers ::malformed)\n   119\t    (not (stream/reader? call-in)) (refused ::call-in ::malformed)\n   120\t    (not (stream/writer? call-out)) (refused ::call-out ::malformed)\n   121\t    :else\n   122\t    (let [c (stream/cursor call-in :dao.stream/oldest)]\n   123\t      (if-not (= :dao.stream/ok (:dao.stream/outcome c))\n   124\t        (refused ::call-in ::no-cursor)\n   125\t        (let [before (into #{} (map :identity) (rs/entries binding))\n   126\t              [in out refusal] (export binding call-in call-out)]\n   127\t          (if refusal\n   128\t            (do (doseq [e (rs/entries binding)]\n   129\t                  (when-not (contains? before (:identity e))\n   130\t                    (rs/retire! binding (:identity e))))\n   131\t                refusal)\n   132\t            {::binding binding\n   133\t             ::call-in call-in\n   134\t             ::call-out call-out\n   135\t             ::handlers handlers\n   136\t             ::served {::call-in in, ::call-out out}\n   137\t             ::endpoint (apply2/endpoint (remote-descriptor in)\n   138\t                                         (remote-descriptor out))\n   139\t             ::state (apply2/server-state (:dao.stream/cursor c))}))))))\n   140\t\n   141\t\n   142\t(defn- still-served?\n   143\t  [r]\n   144\t  (let [b (::binding r)]\n   145\t    (and (rs/served? b (get-in r [::served ::call-in :dao.stream/identity]))\n   146\t         (rs/served? b (get-in r [::served ::call-out :dao.stream/identity])))))\n   147\t\n   148\t\n   149\t(defn- close-call-out!\n   150\t  [r]\n   151\t  (let [out (::call-out r)]\n   152\t    (when (stream/closable? out)\n   153\t      (stream/close! out))))\n   154\t\n   155\t\n   156\t(defn step\n   157\t  \"One responder pass: at most one request read and one response\n   158\t   append (`dao.stream.apply/serve-once!`). Returns serve-once!'s own\n   159\t   result -- `:dao.stream.apply/outcome` and its extra keys -- with the\n   160\t   responder carrying the new state under `::responder`; the drive\n   161\t   owner threads that value into its next `step`.\n   162\t\n   163\t   Outcomes beyond serve-once!'s: `::request-lost` when the call-in\n   164\t   cursor gaps (call-out is closed, the responder terminal), and\n   165\t   `::retired` when the binding no longer serves the pair. Once\n   166\t   terminal, every step answers `:dao.stream.apply/terminal` and\n   167\t   invokes nothing.\"\n   168\t  [r]\n   169\t  (let [s (::state r)\n   170\t        with (fn [result s']\n   171\t               (assoc result ::responder (assoc r ::state s')))]\n   172\t    (cond\n   173\t      (:terminal s)\n   174\t      (with {:dao.stream.apply/outcome :dao.stream.apply/terminal} s)\n   175\t\n   176\t      (not (still-served? r))\n   177\t      (with {:dao.stream.apply/outcome ::retired}\n   178\t            (assoc s :terminal ::retired))\n   179\t\n   180\t      :else\n   181\t      (let [result (apply2/serve-once! (::handlers r) (::call-in r)\n   182\t                                       (::call-out r) s)\n   183\t            s' (:dao.stream.apply/state result)]\n   184\t        (if (= :dao.stream.apply/gap (:dao.stream.apply/outcome result))\n   185\t          (do (close-call-out! r)\n   186\t              (with (assoc result :dao.stream.apply/outcome ::request-lost)\n   187\t                    (assoc s' :terminal ::request-lost)))\n   188\t          (with result s'))))))\n     1\t(ns yin.vm.ffi.remote-serve.holder\n     2\t  \"The remote lease holder for one identity an export binding\n     3\t   (`yin.vm.ffi.remote-serve`) serves: the holder half of\n     4\t   `dao.stream.remote.md` S6 on the peer that attached it, composed with\n     5\t   `dao.lease/make-holder`, reading its grant and renewing entirely\n     6\t   over reflections.\n     7\t\n     8\t   The grant is not carried to it. The binding serves its grantor's\n     9\t   stream as `lease-grants`; this holder reads that stream through a\n    10\t   reflection and takes the first grantor-authored `:accepted` whose\n    11\t   subject is the identity it holds -- which names the renewal medium,\n    12\t   and so this holder's own identity (`:dao.lease/holder`). Only then\n    13\t   is `make-holder` assembled, its fact medium that same reflection\n    14\t   (attributed to the grantor by the medium: per-author media) and its\n    15\t   outbound medium a reflection of the renewal medium.\n    16\t\n    17\t   `step` is one pass of the holder's OWN control flow: drain its own\n    18\t   tick stream for the newest reading, look for the grant until\n    19\t   observed, settle renewals whose SOURCE outcome arrived on the link's\n    20\t   event writer -- a reflection's ok is outbound acceptance only\n    21\t   (S6) -- and renew when `dao.lease/due-to-renew?` says so. An\n    22\t   append-unknown on the event writer carries no identity, so it\n    23\t   settles every renewal still pending here as unknown: no bound\n    24\t   advances on it, which errs early, never late. A not-found answer\n    25\t   on either reflection marks the lease reclaimed. `release!` is\n    26\t   `dao.lease/stop`, its release fact kept and re-appended by `step`\n    27\t   until the reflection accepts it.\n    28\t\n    29\t   A plain value threaded by its drive owner; nothing here reads a\n    30\t   clock, loops unboundedly or waits.\"\n    31\t  (:require [dao.lease :as lease]\n    32\t            [dao.stream :as stream]\n    33\t            [yin.vm.ffi.remote-serve :as rs]))\n    34\t\n    35\t\n    36\t(defn- remote-descriptor\n    37\t  [served]\n    38\t  {:dao.stream/type :dao.stream/remote\n    39\t   :dao.stream/identity (:dao.stream/identity served)\n    40\t   :dao.stream/channel (:dao.stream/channel served)})\n    41\t\n    42\t\n    43\t(defn- attach\n    44\t  [attach! served]\n    45\t  (let [r (attach! (remote-descriptor served))]\n    46\t    (when (= :dao.stream/ok (:dao.stream/outcome r))\n    47\t      (:dao.stream/handle r))))\n    48\t\n    49\t\n    50\t(defn- holder-config\n    51\t  \"The `dao.lease/make-holder` config: `self` and the renewal\n    52\t   reflection are known once the grant is read.\"\n    53\t  [opts grants grants-cursor self renewal]\n    54\t  {:self self\n    55\t   :grantor rs/grantor\n    56\t   :units rs/lease-units\n    57\t   :resolver (fn [source _fact] source)\n    58\t   :resolver-bindings #{:per-author-media}\n    59\t   :renewal-interval (::renewal-interval opts)\n    60\t   :subject (::subject opts)\n    61\t   :tick (::ticks opts)\n    62\t   :fact {:handle grants\n    63\t          :cursor grants-cursor\n    64\t          :source rs/grantor\n    65\t          :medium (::grants-medium opts)}\n    66\t   :writer {:handle renewal :medium (::renewal-medium opts)}})\n    67\t\n    68\t\n    69\t(defn- assembly-refusal\n    70\t  \"`make-holder`'s own refusal of these declarations and this interval,\n    71\t   checked before any grant with a stand-in identity and cursor, or nil.\"\n    72\t  [opts grants]\n    73\t  (try (lease/make-holder (holder-config opts grants 0 ::unknown grants))\n    74\t       nil\n    75\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n    76\t         {::option (case (:refused (ex-data e))\n    77\t                     :renewal-interval ::renewal-interval\n    78\t                     ::grants-medium)\n    79\t          ::reason ::malformed\n    80\t          ::lease-refusal (ex-data e)})))\n    81\t\n    82\t\n    83\t(defn open!\n    84\t  \"Assemble the holder for served `::subject` (an identity string),\n    85\t   or refuse. `opts`:\n    86\t     ::attach!          the composition's :dao.stream/remote attach entry\n    87\t     ::lease-grants     the binding's served `lease-grants` marker\n    88\t                        (`rs/lease-grants`)\n    89\t     ::subject          the served identity whose lease this holds\n    90\t     ::ticks            `{:handle :cursor}`, this holder's OWN tick stream\n    91\t     ::events           `{:handle :cursor}`, a reader of the event writer\n    92\t                        the attacher's links emit append outcomes on\n    93\t     ::renewal-interval the composition's renewal interval, sized\n    94\t                        against the duration it expects\n    95\t                        (`dao.lease/renewal-interval`)\n    96\t     ::budget           the positive bound on grant reads per step\n    97\t     ::grants-medium    the explicit medium declaration of `lease-grants`\n    98\t                        (`dao.lease.md` C2): its retention and capacity\n    99\t                        are the grantor's, declared by the composition\n   100\t     ::renewal-medium   the explicit declaration of the renewal medium\n   101\t                        (`rs/renewal-declaration` of the grantor's\n   102\t                        capacity)\n   103\t   The declarations and interval are checked here by `make-holder`'s own\n   104\t   assembly checks, so the assembly at grant time cannot refuse.\n   105\t   Returns the holder value, or `{::status ::refused ::refusals [...]}`.\"\n   106\t  [{::keys [attach! lease-grants subject ticks events renewal-interval\n   107\t            budget grants-medium renewal-medium]\n   108\t    :as opts}]\n   109\t  (let [missing (cond-> []\n   110\t                  (not (fn? attach!)) (conj ::attach!)\n   111\t                  (not (map? lease-grants)) (conj ::lease-grants)\n   112\t                  (nil? subject) (conj ::subject)\n   113\t                  (not (and (map? ticks) (:handle ticks) (some? (:cursor ticks))))\n   114\t                  (conj ::ticks)\n   115\t                  (not (and (map? events) (:handle events) (some? (:cursor events))))\n   116\t                  (conj ::events)\n   117\t                  (not (lease/duration? renewal-interval))\n   118\t                  (conj ::renewal-interval)\n   119\t                  (not (and (integer? budget) (pos? budget))) (conj ::budget)\n   120\t                  (not (map? grants-medium)) (conj ::grants-medium)\n   121\t                  (not (map? renewal-medium)) (conj ::renewal-medium))]\n   122\t    (if (seq missing)\n   123\t      {::status ::refused\n   124\t       ::refusals (mapv (fn [k] {::option k, ::reason ::malformed}) missing)}\n   125\t      (if-some [grants (attach attach! lease-grants)]\n   126\t        (if-some [refusal (assembly-refusal opts grants)]\n   127\t          {::status ::refused, ::refusals [refusal]}\n   128\t          {::attach! attach!\n   129\t           ::subject subject\n   130\t           ::channel (:dao.stream/channel lease-grants)\n   131\t           ::grants grants\n   132\t           ::grants-cursor nil\n   133\t           ::ticks ticks\n   134\t           ::events events\n   135\t           ::renewal-interval renewal-interval\n   136\t           ::budget budget\n   137\t           ::grants-medium grants-medium\n   138\t           ::renewal-medium renewal-medium\n   139\t           ::reading nil\n   140\t           ::composed nil\n   141\t           ::holder nil\n   142\t           ::renewal nil\n   143\t           ::pending []\n   144\t           ::release nil\n   145\t           ::renewals 0\n   146\t           ::reclaimed? false})\n   147\t        {::status ::refused\n   148\t         ::refusals [{::option ::lease-grants, ::reason ::unattachable}]}))))\n   149\t\n   150\t\n   151\t;; =============================================================================\n   152\t;; The pass\n   153\t;; =============================================================================\n   154\t\n   155\t(defn- drain-ticks\n   156\t  \"The newest reading on the holder's own tick stream, or the last one.\"\n   157\t  [h]\n   158\t  (let [{th :handle} (::ticks h)]\n   159\t    (loop [c (:cursor (::ticks h))\n   160\t           newest (::reading h)]\n   161\t      (let [r (stream/next th c)]\n   162\t        (if (= :dao.stream/ok (:dao.stream/outcome r))\n   163\t          (recur (:dao.stream/cursor r)\n   164\t                 (or (:dao.lease/reading (:dao.stream/value r)) newest))\n   165\t          (-> h\n   166\t              (assoc-in [::ticks :cursor] c)\n   167\t              (assoc ::reading newest)))))))\n   168\t\n   169\t\n   170\t(defn- gone?\n   171\t  [outcome]\n   172\t  (= :dao.stream.remote/not-found (:dao.stream.remote/reason outcome)))\n   173\t\n   174\t\n   175\t(defn- mint-grants-cursor\n   176\t  [h]\n   177\t  (if (some? (::grants-cursor h))\n   178\t    h\n   179\t    (let [r (stream/cursor (::grants h) :dao.stream/oldest)]\n   180\t      (cond\n   181\t        (= :dao.stream/ok (:dao.stream/outcome r))\n   182\t        (assoc h ::grants-cursor (:dao.stream/cursor r))\n   183\t        (gone? r) (assoc h ::reclaimed? true)\n   184\t        :else h))))\n   185\t\n   186\t\n   187\t(defn- my-grant?\n   188\t  [h v]\n   189\t  (and (lease/lease-fact? v)\n   190\t       (= :dao.lease/accepted (:dao.lease/status v))\n   191\t       (= (::subject h) (:dao.lease/subject v))))\n   192\t\n   193\t\n   194\t(defn- assemble\n   195\t  \"This subject's `grant` was read at the grants cursor: attach the\n   196\t   renewal medium it names, assemble make-holder with the holder\n   197\t   identity it names, and observe the grant at the latest reading. Nil\n   198\t   when the grant cannot be held yet -- no reading, or no attachment --\n   199\t   so the caller re-reads it on a later pass.\"\n   200\t  [h grant]\n   201\t  (when-some [renewal (attach (::attach! h)\n   202\t                              {:dao.stream/identity (:dao.lease/holder grant)\n   203\t                               :dao.stream/channel (::channel h)})]\n   204\t    (let [composed (lease/make-holder\n   205\t                     (holder-config h (::grants h) (::grants-cursor h)\n   206\t                                    (:dao.lease/holder grant) renewal))\n   207\t          holder (lease/observe-grant (:holder composed) rs/grantor\n   208\t                                      grant (::reading h))]\n   209\t      (when (some? (:grant holder))\n   210\t        (assoc h ::composed composed ::renewal renewal ::holder holder)))))\n   211\t\n   212\t\n   213\t(defn- seek-grant\n   214\t  \"Read `lease-grants` up to the budget for this subject's grant.\"\n   215\t  [h]\n   216\t  (let [h (mint-grants-cursor h)]\n   217\t    (if (or (::reclaimed? h) (nil? (::grants-cursor h)))\n   218\t      h\n   219\t      (loop [h h\n   220\t             n (::budget h)]\n   221\t        (if (zero? n)\n   222\t          h\n   223\t          (let [r (stream/next (::grants h) (::grants-cursor h))]\n   224\t            (cond\n   225\t              (= :dao.stream/ok (:dao.stream/outcome r))\n   226\t              (let [v (:dao.stream/value r)\n   227\t                    c' (:dao.stream/cursor r)]\n   228\t                (if (my-grant? h v)\n   229\t                  (if-some [h' (assemble h v)]\n   230\t                    (assoc h' ::grants-cursor c')\n   231\t                    h)\n   232\t                  (recur (assoc h ::grants-cursor c') (dec n))))\n   233\t              (gone? r) (assoc h ::reclaimed? true)\n   234\t              :else h)))))))\n   235\t\n   236\t\n   237\t(defn- settle\n   238\t  \"Settle pending renewals from the event writer: an outcome naming the\n   239\t   renewal identity settles the oldest pending one; append-unknown\n   240\t   settles all as unknown.\"\n   241\t  [h]\n   242\t  (let [rid (get-in h [::holder :self])\n   243\t        {eh :handle} (::events h)]\n   244\t    (loop [h h\n   245\t           c (:cursor (::events h))]\n   246\t      (let [r (stream/next eh c)]\n   247\t        (if-not (= :dao.stream/ok (:dao.stream/outcome r))\n   248\t          (assoc-in h [::events :cursor] c)\n   249\t          (let [v (:dao.stream/value r)\n   250\t                c' (:dao.stream/cursor r)\n   251\t                observe (fn [h at outcome]\n   252\t                          (update h ::holder lease/observe-renewal at outcome))\n   253\t                failed {:dao.stream/outcome :dao.stream/transport-error}]\n   254\t            (cond\n   255\t              (= :dao.stream.remote/append-unknown\n   256\t                 (:dao.stream.remote/event v))\n   257\t              (recur (-> (reduce #(observe %1 %2 failed) h (::pending h))\n   258\t                         (assoc ::pending []))\n   259\t                     c')\n   260\t\n   261\t              (and (= rid (:dao.stream/identity v))\n   262\t                   (not (contains? v :dao.stream/descriptor))\n   263\t                   (seq (::pending h)))\n   264\t              (let [at (first (::pending h))\n   265\t                    h (-> h\n   266\t                          (update ::pending (comp vec rest))\n   267\t                          (observe at (if (:dao.stream.remote/error v) failed v)))]\n   268\t                (recur (cond-> h\n   269\t                         (= :dao.stream.remote/not-found\n   270\t                            (:dao.stream.remote/error v))\n   271\t                         (assoc ::reclaimed? true))\n   272\t                       c'))\n   273\t\n   274\t              :else (recur h c'))))))))\n   275\t\n   276\t\n   277\t(defn- append-release\n   278\t  [h]\n   279\t  (let [o (stream/append! (::renewal h) (::release h))]\n   280\t    (cond\n   281\t      (= :dao.stream/ok (:dao.stream/outcome o)) (assoc h ::release nil)\n   282\t      (gone? o) (assoc h ::release nil ::reclaimed? true)\n   283\t      :else h)))\n   284\t\n   285\t\n   286\t(defn- renew\n   287\t  [h]\n   288\t  (let [reading (::reading h)]\n   289\t    (if (and (lease/due-to-renew? (::holder h) reading)\n   290\t             (empty? (::pending h)))\n   291\t      (let [o (stream/append! (::renewal h)\n   292\t                              (lease/renewal\n   293\t                                (get-in h [::holder :grant :dao.lease/lease])))]\n   294\t        (cond\n   295\t          (= :dao.stream/ok (:dao.stream/outcome o))\n   296\t          (-> h (update ::pending conj reading) (update ::renewals inc))\n   297\t          (gone? o) (assoc h ::reclaimed? true)\n   298\t          :else h))\n   299\t      h)))\n   300\t\n   301\t\n   302\t(defn step\n   303\t  \"One pass of the holder's own control flow; returns the holder.\"\n   304\t  [h]\n   305\t  (let [h (drain-ticks h)]\n   306\t    (cond\n   307\t      (::reclaimed? h) h\n   308\t      (nil? (::holder h)) (seek-grant h)\n   309\t      :else (let [_ (stream/descriptor (::renewal h))\n   310\t                  h (settle h)]\n   311\t              (cond\n   312\t                (::reclaimed? h) h\n   313\t                (some? (::release h)) (append-release h)\n   314\t                :else (renew h))))))\n   315\t\n   316\t\n   317\t(defn release!\n   318\t  \"The holder is done (`dao.lease/stop`): its release is appended on the\n   319\t   renewal medium now, and re-appended by `step` until accepted.\n   320\t   Returns the holder; a holder that observed no grant is unchanged.\"\n   321\t  [h]\n   322\t  (if (or (nil? (get-in h [::holder :grant])) (::reclaimed? h))\n   323\t    h\n   324\t    (let [{holder' :holder release :release} (lease/stop (::holder h))\n   325\t          h (assoc h ::holder holder')]\n   326\t      (if release\n   327\t        (append-release (assoc h ::release release))\n   328\t        h))))\n   329\t\n   330\t\n   331\t(defn holding?\n   332\t  \"True when the holder may act at its latest reading\n   333\t   (`dao.lease/holding?`).\"\n   334\t  [h]\n   335\t  (and (not (::reclaimed? h))\n   336\t       (some? (::holder h))\n   337\t       (lease/holding? (::holder h) (::reading h))))\n   338\t\n   339\t\n   340\t(defn grant\n   341\t  \"The grant this holder observed, or nil.\"\n   342\t  [h]\n   343\t  (get-in h [::holder :grant]))\n   344\t\n   345\t\n   346\t(defn reclaimed?\n   347\t  \"True once a reflection answered not-found: the lease was reclaimed.\"\n   348\t  [h]\n   349\t  (boolean (::reclaimed? h)))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ffi/remote_serve/responder.cljc; rg -n 'response|gap|call-result|call-id|ffi-request' src/cljc/yin/vm/ffi.cljc src/cljc/yin/vm/semantic.cljc src/cljc/dao/stream/apply.cljc test/yin/vm/ffi/remote_serve/responder_test.cljc; nl -ba collab/1790610416000-vm-engineer-ffi-responder-e2e.claude-opus-5-5.report.md | tail -90\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ffi/remote_serve/responder.cljc; rg -n 'response|gap|call-result|call-id|ffi-request' src/cljc/yin/vm/ffi.cljc src/cljc/yin/vm/semantic.cljc src/cljc/dao/stream/apply.cljc test/yin/vm/ffi/remote_serve/responder_test.cljc; nl -ba collab/1790610416000-vm-engineer-ffi-responder-e2e.claude-opus-5-5.report.md | tail -90\"","aggregated_output":"     1\t(ns yin.vm.ffi.remote-serve.responder\n     2\t  \"The FFI apply responder at the possessing peer: the interpreter that\n     3\t   reads apply requests off a VM's call-in stream and appends apply\n     4\t   responses to its call-out stream, over the call pair an export\n     5\t   binding (`yin.vm.ffi.remote-serve`) serves to a remote VM.\n     6\t\n     7\t   It is a separate namespace because it is a separate observer of the\n     8\t   same streams. The binding's mirror serves stream OPERATIONS on\n     9\t   call-in and call-out -- a remote VM's append! lands on call-in, its\n    10\t   next reads call-out -- and interprets no value; this responder\n    11\t   interprets the apply VALUES and knows nothing of the channel, the\n    12\t   table or the leases. Neither drives the other: the one drive owner\n    13\t   calls `rs/step` and `step` in turn.\n    14\t\n    15\t   `open!` exports call-in as a remote WRITER and call-out as a remote\n    16\t   READER through the binding's own `serve!`, so the binding's\n    17\t   injected authority gate (`::rs/admit?`) and surface policy decide\n    18\t   whether this peer's handlers are reachable at all -- there is no\n    19\t   second, default gate that admits everything. The handler map is\n    20\t   required and explicit.\n    21\t\n    22\t   `step` is one `dao.stream.apply/serve-once!` over the caller-owned\n    23\t   server state the responder value carries: the request is read\n    24\t   whole, as the VM appended it -- extra keys and all, never rebuilt\n    25\t   from op and args -- its id answered on call-out, and a computed\n    26\t   response retained with its successor across `full`, so no handler\n    27\t   runs twice. Two responder-level rules sit on top:\n    28\t\n    29\t   - A gap on the call-in cursor is terminal loss (as\n    30\t     `yin.vm.ffi/bridge-step` treats it locally): a request was evicted\n    31\t     and the parked call that made it could never be answered. The\n    32\t     responder reports `::request-lost` and closes call-out, so every\n    33\t     VM waiting on that pair reads end and raises through\n    34\t     `yin.vm.ffi/call-result` instead of parking forever.\n    35\t   - Once the binding no longer serves call-in or call-out -- retired,\n    36\t     closed, or reclaimed by its lease -- the responder is terminal\n    37\t     (`::retired`) and invokes no further handler for that tenure.\n    38\t\n    39\t   The responder is a plain value threaded by its drive owner; nothing\n    40\t   here loops, waits or reads a clock.\"\n    41\t  (:require [dao.stream :as stream]\n    42\t            [dao.stream.apply :as apply2]\n    43\t            [yin.vm.ffi.remote-serve :as rs]))\n    44\t\n    45\t\n    46\t(defn- handlers?\n    47\t  \"An explicit handler map: operation keyword -> function.\"\n    48\t  [m]\n    49\t  (and (map? m)\n    50\t       (every? keyword? (keys m))\n    51\t       (every? fn? (vals m))))\n    52\t\n    53\t\n    54\t(defn remote-descriptor\n    55\t  \"The portable remote descriptor for a served marker `{:dao.stream/identity\n    56\t   id :dao.stream/channel cd}` -- what a remote peer attaches.\"\n    57\t  [served]\n    58\t  {:dao.stream/type :dao.stream/remote\n    59\t   :dao.stream/identity (:dao.stream/identity served)\n    60\t   :dao.stream/channel (:dao.stream/channel served)})\n    61\t\n    62\t\n    63\t(defn- refused\n    64\t  [option reason]\n    65\t  {::status ::refused, ::refusals [{::option option, ::reason reason}]})\n    66\t\n    67\t\n    68\t(defn- served-surface\n    69\t  [binding served]\n    70\t  (get-in (rs/table binding) [(:dao.stream/identity served) :surface]))\n    71\t\n    72\t\n    73\t(defn- export\n    74\t  \"Serve call-in and call-out through `binding`, or name the refusal.\n    75\t   Returns `[in out nil]` or `[_ _ refusal]`.\"\n    76\t  [binding call-in call-out]\n    77\t  (let [in (rs/serve! binding call-in)\n    78\t        out (when in (rs/serve! binding call-out))]\n    79\t    [in out\n    80\t     (cond\n    81\t       (nil? in) (refused ::call-in ::unservable)\n    82\t       (not (contains? (served-surface binding in) :writer))\n    83\t       (refused ::call-in ::surface)\n    84\t       (nil? out) (refused ::call-out ::unservable)\n    85\t       (not (contains? (served-surface binding out) :reader))\n    86\t       (refused ::call-out ::surface))]))\n    87\t\n    88\t\n    89\t(defn open!\n    90\t  \"Export the call pair `::call-in`/`::call-out` through `binding` and\n    91\t   assemble the responder over `::handlers`, or refuse.\n    92\t\n    93\t   `opts`:\n    94\t     ::call-in   the VM's call-in stream at this peer: this responder\n    95\t                 reads it locally, a remote VM appends to it -- served\n    96\t                 with a surface containing :writer\n    97\t     ::call-out  the VM's call-out stream at this peer: this responder\n    98\t                 appends to it, a remote VM reads it -- served with a\n    99\t                 surface containing :reader\n   100\t     ::handlers  the explicit handler map, op keyword -> fn; no default\n   101\t\n   102\t   The request cursor is minted from call-in itself before anything is\n   103\t   served. A refusal -- no handler map, a call-in that mints no\n   104\t   cursor, either endpoint unservable under the binding's gate and\n   105\t   surface policy, or served without the surface it needs -- retires\n   106\t   every identity this call served, so no provisional export outlives\n   107\t   it; handles already served before it stay served.\n   108\t\n   109\t   Returns `{::binding b ::call-in h ::call-out h ::handlers m\n   110\t   ::endpoint apply-endpoint ::state apply-server-state}` --\n   111\t   `::endpoint` is the `dao.stream.apply/endpoint` of the two remote\n   112\t   descriptors a remote VM attaches -- or `{::status ::refused\n   113\t   ::refusals [...]}`.\"\n   114\t  [binding {::keys [call-in call-out handlers]}]\n   115\t  (cond\n   116\t    (not (rs/binding? binding)) (refused ::binding ::malformed)\n   117\t    (nil? handlers) (refused ::handlers ::missing)\n   118\t    (not (handlers? handlers)) (refused ::handlers ::malformed)\n   119\t    (not (stream/reader? call-in)) (refused ::call-in ::malformed)\n   120\t    (not (stream/writer? call-out)) (refused ::call-out ::malformed)\n   121\t    :else\n   122\t    (let [c (stream/cursor call-in :dao.stream/oldest)]\n   123\t      (if-not (= :dao.stream/ok (:dao.stream/outcome c))\n   124\t        (refused ::call-in ::no-cursor)\n   125\t        (let [before (into #{} (map :identity) (rs/entries binding))\n   126\t              [in out refusal] (export binding call-in call-out)]\n   127\t          (if refusal\n   128\t            (do (doseq [e (rs/entries binding)]\n   129\t                  (when-not (contains? before (:identity e))\n   130\t                    (rs/retire! binding (:identity e))))\n   131\t                refusal)\n   132\t            {::binding binding\n   133\t             ::call-in call-in\n   134\t             ::call-out call-out\n   135\t             ::handlers handlers\n   136\t             ::served {::call-in in, ::call-out out}\n   137\t             ::endpoint (apply2/endpoint (remote-descriptor in)\n   138\t                                         (remote-descriptor out))\n   139\t             ::state (apply2/server-state (:dao.stream/cursor c))}))))))\n   140\t\n   141\t\n   142\t(defn- still-served?\n   143\t  [r]\n   144\t  (let [b (::binding r)]\n   145\t    (and (rs/served? b (get-in r [::served ::call-in :dao.stream/identity]))\n   146\t         (rs/served? b (get-in r [::served ::call-out :dao.stream/identity])))))\n   147\t\n   148\t\n   149\t(defn- close-call-out!\n   150\t  [r]\n   151\t  (let [out (::call-out r)]\n   152\t    (when (stream/closable? out)\n   153\t      (stream/close! out))))\n   154\t\n   155\t\n   156\t(defn step\n   157\t  \"One responder pass: at most one request read and one response\n   158\t   append (`dao.stream.apply/serve-once!`). Returns serve-once!'s own\n   159\t   result -- `:dao.stream.apply/outcome` and its extra keys -- with the\n   160\t   responder carrying the new state under `::responder`; the drive\n   161\t   owner threads that value into its next `step`.\n   162\t\n   163\t   Outcomes beyond serve-once!'s: `::request-lost` when the call-in\n   164\t   cursor gaps (call-out is closed, the responder terminal), and\n   165\t   `::retired` when the binding no longer serves the pair. Once\n   166\t   terminal, every step answers `:dao.stream.apply/terminal` and\n   167\t   invokes nothing.\"\n   168\t  [r]\n   169\t  (let [s (::state r)\n   170\t        with (fn [result s']\n   171\t               (assoc result ::responder (assoc r ::state s')))]\n   172\t    (cond\n   173\t      (:terminal s)\n   174\t      (with {:dao.stream.apply/outcome :dao.stream.apply/terminal} s)\n   175\t\n   176\t      (not (still-served? r))\n   177\t      (with {:dao.stream.apply/outcome ::retired}\n   178\t            (assoc s :terminal ::retired))\n   179\t\n   180\t      :else\n   181\t      (let [result (apply2/serve-once! (::handlers r) (::call-in r)\n   182\t                                       (::call-out r) s)\n   183\t            s' (:dao.stream.apply/state result)]\n   184\t        (if (= :dao.stream.apply/gap (:dao.stream.apply/outcome result))\n   185\t          (do (close-call-out! r)\n   186\t              (with (assoc result :dao.stream.apply/outcome ::request-lost)\n