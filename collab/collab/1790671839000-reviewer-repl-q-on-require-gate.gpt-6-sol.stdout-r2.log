jc:422:   `{:pair pair :progress? bool :answered n}`, `n` the responses\nsrc/cljc/yin/repl/query.cljc:428:         answered 0]\nsrc/cljc/yin/repl/query.cljc:432:        {:pair pair, :progress? progress?, :answered answered}\nsrc/cljc/yin/repl/query.cljc:445:                   (cond-> answered response inc))\nsrc/cljc/yin/repl/query.cljc:446:            {:pair pair, :progress? progress?, :answered answered}))))))\nsrc/cljc/yin/vm.cljc:554:(defn mint-oldest\nsrc/cljc/yin/vm.cljc:571:(defn cursor-entry\n   175\t                      (some? (ffi/request-call-id %)))\n   176\t                 (:wait-set vm))))\n   177\t\n   178\t\n   179\t;; =============================================================================\n   180\t;; The call pair\n   181\t;; =============================================================================\n   182\t\n   183\t(defn- medium\n   184\t  [capacity]\n   185\t  (:dao.stream/handle\n   186\t    (ring/create! {:dao.stream/type ring/transport-type\n   187\t                   ring/capacity-key capacity})))\n   188\t\n   189\t\n   190\t(defn- newest\n   191\t  [handle]\n   192\t  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))\n   193\t\n   194\t\n   195\t(defn discard-answers\n   196\t  \"`vm`, rolled back to a base that has no call outstanding, reading its\n   197\t   call-out from the newest position of `pair`'s call-out.  The base's\n   198\t   own cursor stopped where its round began; every response since\n   199\t   answers a call of the abandoned run, which no call of the base can\n   200\t   claim, and a failed round that made more calls than the medium holds\n   201\t   would otherwise leave that cursor behind evicted responses, so the\n   202\t   next call would read a gap.  The call ids stay unique: the rollback\n   203\t   carries the abandoned run's id counter forward.  A VM without the\n   204\t   call-out cursor is returned unchanged.\"\n   205\t  [vm pair]\n   206\t  (if (contains? (:resources vm) vm/call-out-cursor-key)\n   207\t    (assoc-in vm\n   208\t              [:resources vm/call-out-cursor-key]\n   209\t              (vm/cursor-entry vm/call-out-stream-key\n   210\t                               (newest (:call-out pair))))\n   211\t    vm))\n   212\t\n   213\t\n   214\t(defn abandon-requests\n   215\t  \"`pair` with the interpreter's cursor past every request on its\n   216\t   call-in: the calls of a run the shell has abandoned are not answered.\"\n   217\t  [pair]\n   218\t  (assoc pair :cursor (newest (:call-in pair))))\n   219\t\n   220\t\n   221\t(defn make-pair\n   222\t  \"The session's query call pair: `:call-in` and `:call-out` media of\n   223\t   `capacity` elements, `:out-cursor` the call-out cursor the VM is\n   224\t   constructed with (the pair is supplied, so its cursor is too), and\n   225\t   `:cursor` the interpreter's own call-in cursor, both minted before any\n   226\t   request exists.\"\n   227\t  [capacity]\n   228\t  (let [call-in (medium capacity)\n   229\t        call-out (medium capacity)]\n   230\t    {:call-in call-in\n   231\t     :call-out call-out\n   232\t     :out-cursor (vm/mint-oldest call-out :yin.repl/query)\n   233\t     :cursor (vm/mint-oldest call-in :yin.repl/query)}))\n   234\t\n   235\t\n   236\t;; =============================================================================\n   237\t;; Answering one request\n   238\t;; =============================================================================\n   239\t\n   240\t(defn- refusal\n   375\t\n   376\t\n   377\t(defn answer\n   378\t  \"The response to one call-pair `request`, answered from `indexer`\n   379\t   under `limits` (`{:row-limit n :byte-limit n}`).\"\n   380\t  [indexer limits request]\n   381\t  (let [id (apply2/request-id request)\n   382\t        [query & more] (apply2/request-args request)\n   383\t        answer (cond\n   384\t                 (not= op (apply2/request-op request))\n   385\t                 (refusal :dao.stream.apply/unknown-operation\n   386\t                          \"No handler for operation\"\n   387\t                          nil)\n   388\t\n   389\t                 (nil? (encoded-size (apply2/request-args request)))\n   390\t                 (invalid (str \"q takes portable Yin data only: nil, booleans,\"\n   391\t                               \" numbers, strings, keywords, symbols, and\"\n   392\t                               \" vectors, lists, sets and maps of them\"))\n   393\t\n   394\t                 (not (or (vector? query) (map? query)))\n   395\t                 (invalid (str \"q expects a query vector or map, got \"\n   396\t                               (pr-str query)))\n   397\t\n   398\t                 :else\n   399\t                 (let [[inputs options] (split-args more)\n   400\t                       view (view-of options)\n   401\t                       db (when-not (refused? view) (snapshot indexer))]\n   402\t                   (cond\n   403\t                     (refused? view) view\n   404\t                     (refused? db) db\n   405\t                     :else (evaluate db view query inputs limits))))]\n   406\t    (if (refused? answer)\n   407\t      {apply2/id-key id, apply2/error-key answer}\n   408\t      (apply2/success-response id (:ok answer)))))\n   409\t\n   410\t\n   411\t;; =============================================================================\n   412\t;; The interpreter\n   413\t;; =============================================================================\n   414\t\n   415\t(defn serve\n   416\t  \"One serve round of the query interpreter over `pair`: answer every\n   417\t   request its cursor has not consumed, from `indexer` as it stands now,\n   418\t   at most `budget` of them.  A response is appended before the cursor\n   419\t   moves past its request; one the call-out refuses leaves the request to\n   420\t   be re-read.  A value that is not a request envelope is consumed\n   421\t   unanswered: no call made it.  Returns\n   422\t   `{:pair pair :progress? bool :answered n}`, `n` the responses\n   423\t   appended.\"\n   424\t  [{:keys [pair indexer limits budget]}]\n   425\t  (loop [pair pair\n   426\t         remaining budget\n   427\t         progress? false\n   428\t         answered 0]\n   429\t    (let [r (when (pos? remaining)\n   430\t              (stream/next (:call-in pair) (:cursor pair)))]\n   431\t      (if-not (= :dao.stream/ok (:dao.stream/outcome r))\n   432\t        {:pair pair, :progress? progress?, :answered answered}\n   433\t        (let [request (:dao.stream/value r)\n   434\t              response (when (apply2/request? request)\n   435\t                         (answer indexer limits request))\n   436\t              landed? (or (nil? response)\n   437\t                          (= :dao.stream/ok\n   438\t                             (:dao.stream/outcome\n   439\t                               (apply2/put-response! (:call-out pair)\n   440\t                                                     response))))]\n   441\t          (if landed?\n   442\t            (recur (assoc pair :cursor (:dao.stream/cursor r))\n   443\t                   (dec remaining)\n   444\t                   true\n   445\t                   (cond-> answered response inc))\n   446\t            {:pair pair, :progress? progress?, :answered answered}))))))\n   175\t                     (stream-values (get-in state [:query-pair :call-in])))\n   176\t               (mapv apply2/response-id\n   177\t                     (stream-values (get-in state [:query-pair :call-out]))))\n   178\t            \"the interpreter answered each request exactly once\")))))\n   179\t\n   180\t\n   181\t(defn- spin-line\n   182\t  \"Define `spin`: `n` calls of `q`, then `end` evaluated in tail position.\"\n   183\t  [end]\n   184\t  (str \"(def spin (fn [n] (if (= n 0) \" end\n   185\t       \" ((fn [_] (spin (- n 1))) \"\n   186\t       (q-line '[:find ?v . :where [?e :yin/value 42] [?e :yin/value ?v]])\n   187\t       \"))))\"))\n   188\t\n   189\t\n   190\t(deftest a-failed-round-of-more-calls-than-the-pair-holds-leaves-no-gap\n   191\t  (doseq [vm-type vm-types]\n   192\t    (testing (str vm-type)\n   193\t      (let [n (+ repl/query-pair-capacity 6)\n   194\t            [_ [_ _ _ failed answered]]\n   195\t            (evaluate (repl/create-state {:vm-type vm-type})\n   196\t                      [require-line\n   197\t                       \"(def answer 42)\"\n   198\t                       (spin-line \"(nope)\")\n   199\t                       (str \"(spin \" n \")\")\n   200\t                       (q-line '[:find ?v . :where [?e :yin/value 42]\n   201\t                                 [?e :yin/value ?v]])])]\n   202\t        (is (str/starts-with? failed \"Error: Unable to resolve symbol: nope\"))\n   203\t        (is (= \"42\" answered)\n   204\t            \"the rolled-back VM reads past the abandoned answers, not into a gap\")))))\n   205\t\n   206\t\n   207\t(deftest a-program-calling-q-without-end-is-stopped-at-the-drive-budget\n   208\t  (doseq [vm-type vm-types]\n   209\t    (testing (str vm-type)\n   210\t      (let [[state [_ _ _ stopped answered]]\n   211\t            (evaluate (repl/create-state {:vm-type vm-type})\n   212\t                      [require-line\n   213\t                       \"(def answer 42)\"\n   214\t                       (spin-line \":done\")\n   215\t                       (str \"(spin \" (inc (* 2 repl/query-drive-budget)) \")\")\n   216\t                       (q-line '[:find ?v . :where [?e :yin/value 42]\n   217\t                                 [?e :yin/value ?v]])])\n   218\t            requests (stream-values (get-in state [:query-pair :call-in]))]\n   219\t        (is (= (str \"Error: \" repl/query-call-limit-text) stopped))\n   220\t        (is (= \"42\" answered) \"the session answers the next call\")\n   221\t        (is (= (count requests) (count (distinct (map apply2/request-id requests))))\n   222\t            \"every call id is unique across the stopped run and the next\")))))\n   223\t\n   224\t\n   225\t;; =============================================================================\n   226\t;; Refusals\n   227\t;; =============================================================================\n   228\t\n   229\t(deftest an-unavailable-index-refuses-the-call\n   230\t  (testing \"a lost indexer\"\n   231\t    (doseq [vm-type vm-types]\n   232\t      (testing (str vm-type)\n   233\t        (let [writer (:dao.stream/handle\n   234\t                       (ring/create! {:dao.stream/type ring/transport-type\n   235\t                                      ring/capacity-key 1}))\n   236\t              descriptor (:dao.stream/descriptor (stream/descriptor writer))\n   237\t              lossy (observer/attach\n   238\t                      (ring/make-attacher {(:dao.stream/identity descriptor)\n   239\t                                           writer})\n   240\t                      descriptor)\n   241\t              _ (doseq [v [1 2]]\n   242\t                  (stream/append! writer\n   243\t                                  (macro/ast->packet {:type :literal\n   244\t                                                      :value v})))\n   245\t              [state _] (repl/eval-input (repl/create-state {:vm-type vm-type})\n   246\t                                         require-line)\n   247\t              [_ text] (repl/eval-input (assoc-in state [:indexer :observer]\n   248\t                                                  lossy)\n   249\t                                        (q-line names-query))]\n   250\t          (is (str/starts-with? text \"Error: FFI call failed: the code index is unavailable\"))\n   251\t          (is (str/includes? text \"(:yin.repl.query/index-unavailable)\"))))))\n   252\t  (testing \"a failed publication\"\n   253\t    (doseq [vm-type vm-types]\n   254\t      (testing (str vm-type)\n   255\t        (let [broken {:put-bytes-fn (fn [_address _bytes]\n   256\t                                      (throw (ex-info \"store refused\" {})))\n   257\t                      :get-bytes-fn (fn [_address not-found] not-found)}\n   258\t              [_ [_ text]]\n   259\t              (evaluate (repl/create-state {:vm-type vm-type\n   260\t                                            :index-store broken})\n   261\t                        [require-line (q-line names-query)])]\n   262\t          (is (str/includes? text \"(:yin.repl.query/index-unavailable)\"))\n   263\t          (is (str/includes? text \"publish failed\"))))))\n   264\t  (testing \"committed code that is not published\"\n   265\t    (let [[state _] (evaluate (repl/create-state) [\"(+ 1 2)\"])\n","exit_code":0,"status":"completed"}}
