{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/repl/index_test.cljc | sed -n '185,360p'\"","aggregated_output":"   185\t  [capacity]\n   186\t  (let [writer (:dao.stream/handle\n   187\t                 (ring/create! {:dao.stream/type ring/transport-type\n   188\t                                ring/capacity-key capacity}))\n   189\t        descriptor (:dao.stream/descriptor (stream/descriptor writer))\n   190\t        attach! (ring/make-attacher {(:dao.stream/identity descriptor) writer})]\n   191\t    {:writer writer\n   192\t     :observer (observer/attach attach! descriptor)}))\n   193\t\n   194\t\n   195\t(defn- committed-values\n   196\t  \"The literal values of every program the indexer committed.\"\n   197\t  [indexer]\n   198\t  (into #{}\n   199\t        (comp (map :dao.space/transaction)\n   200\t              (mapcat :datoms)\n   201\t              (keep (fn [[_ a v]] (when (= :yin/value a) v))))\n   202\t        (stream-values (get-in indexer [:transactor :local-stream]))))\n   203\t\n   204\t\n   205\t(defn- literal-packet\n   206\t  [v]\n   207\t  (macro/ast->packet {:type :literal, :value v}))\n   208\t\n   209\t\n   210\t(deftest a-gap-on-the-index-reader-loses-the-indexer-until-rebuilt\n   211\t  (let [{:keys [writer observer]} (small-medium 2)\n   212\t        indexer (repl.index/make-indexer\n   213\t                  {:observer observer\n   214\t                   :session-token \"token\"\n   215\t                   :content-store (:index-store (repl/create-state))})\n   216\t        _ (stream/append! writer (literal-packet 1))\n   217\t        indexed (repl.index/step indexer 1)\n   218\t        _ (doseq [v [2 3 4]] (stream/append! writer (literal-packet v)))\n   219\t        lost (repl.index/step indexed 2)\n   220\t        _ (stream/append! writer (literal-packet 5))\n   221\t        still-lost (repl.index/step lost 3)]\n   222\t    (is (= {:transactions 1 :published? true :lost? false :gaps 0 :failure nil}\n   223\t           (repl.index/status indexed)))\n   224\t    (testing \"the gap is counted and marks the indexer lost\"\n   225\t      (is (= 1 (:gaps (repl.index/status lost))))\n   226\t      (is (true? (:lost? (repl.index/status lost))))\n   227\t      (is (= #{1} (committed-values lost))\n   228\t          \"neither the evicted packet nor the retained ones after it are called indexed\"))\n   229\t    (testing \"nothing further is indexed while lost\"\n   230\t      (is (= 1 (:transactions (repl.index/status still-lost))))\n   231\t      (is (= #{1} (committed-values still-lost)))\n   232\t      (is (some? (repl.index/notice lost still-lost))\n   233\t          \"every round while lost says its code was not indexed\"))))\n   234\t\n   235\t\n   236\t(deftest a-publication-beyond-the-old-intake-bound-completes\n   237\t  (let [{:keys [writer observer]} (small-medium 16)\n   238\t        store (:index-store (repl/create-state))\n   239\t        indexer (repl.index/make-indexer\n   240\t                  {:observer observer\n   241\t                   :session-token \"token\"\n   242\t                   :content-store store\n   243\t                   ;; a small branching factor makes many node blobs\n   244\t                   :publish-opts {:branching-factor 4}})\n   245\t        program (fn [base]\n   246\t                  (macro/ast->packet\n   247\t                    {:type :application\n   248\t                     :operator {:type :variable, :name '+}\n   249\t                     :operands (mapv (fn [i] {:type :literal, :value (+ base i)})\n   250\t                                     (range 300))}))\n   251\t        _ (doseq [base [0 1000 2000 3000]]\n   252\t            (stream/append! writer (program base)))\n   253\t        ix (repl.index/step indexer 1)\n   254\t        payloads (stream-values (first (get-in ix [:transactor :intake-pool])))\n   255\t        committed (into #{}\n   256\t                        (mapcat (comp :datoms :dao.space/transaction))\n   257\t                        (stream-values (get-in ix [:transactor :local-stream])))\n   258\t        address (:manifest-address ix)]\n   259\t    (is (< 4096 (count payloads))\n   260\t        \"one publication exceeds the old 4096-payload ring intake\")\n   261\t    (is (= {:transactions 4 :published? true :lost? false :gaps 0 :failure nil}\n   262\t           (repl.index/status ix)))\n   263\t    (is (= (count committed) (:count (index/read-manifest store address))))\n   264\t    (is (= committed (set (index/read-datoms store address)))\n   265\t        \"the manifest and every node blob are read back from the store\")))\n   266\t\n   267\t\n   268\t(deftest a-publication-failure-is-reported-in-the-round-and-repl-state\n   269\t  (let [broken {:put-bytes-fn (fn [_address _bytes]\n   270\t                                (throw (ex-info \"store refused the write\" {})))\n   271\t                :get-bytes-fn (fn [_address not-found] not-found)}\n   272\t        [state [text again]] (evaluate (repl/create-state {:index-store broken})\n   273\t                                       [\"(+ 1 2)\" \"(+ 2 3)\"])\n   274\t        status (get-in (repl/repl-state state) [:index])]\n   275\t    (is (str/starts-with? text \"3\\nWarning: \"))\n   276\t    (is (str/includes? text \"publish failed: store refused the write\"))\n   277\t    (is (str/starts-with? again \"5\\nWarning: \")\n   278\t        \"each round whose code is not published says so\")\n   279\t    (is (= 2 (:transactions status)) \"the transactions were committed\")\n   280\t    (is (false? (:published? status)))\n   281\t    (is (= :publish (get-in status [:failure :stage])))\n   282\t    (is (false? (:lost? status)))))\n   283\t\n   284\t\n   285\t(deftest an-index-gap-is-reported-evaluation-continues-and-reset-recovers\n   286\t  (let [{:keys [writer observer]} (small-medium 1)\n   287\t        state (repl/create-state)\n   288\t        _ (doseq [v [1 2]] (stream