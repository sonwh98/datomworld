318\t\n   319\t(deftest vm-selection-rebuilds-the-indexer\n   320\t  (let [[state _] (evaluate (repl/create-state) [\"(+ 1 2)\"])\n   321\t        [switched _] (repl/eval-input state \"(vm :ast-walker)\")]\n   322\t    (is (= 1 (count (transactions state))))\n   323\t    (is (empty? (transactions switched)))\n   324\t    (is (not (identical? (get-in state [:indexer :observer :stream])\n   325\t                         (get-in switched [:indexer :observer :stream]))))))\n","exit_code":0,"status":"completed"}}
