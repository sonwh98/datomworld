  569\\t             :yin.k/profile (:yin.k/profile profile)})))\\n   570\\t\\n   571\\t\\n   572\\t(defn- stream-marker\\n   573\\t  \\\"UCF 7.5.1's stream marker for the stream resource `id` of `vm`: the\\n   574\\t   handle's descriptor and logical identity, never the handle. A handle\\n   575\\t   with no descriptor surface cannot be attached elsewhere and refuses as\\n   576\\t   `:in-memory-handle`.\\\"\\n   577\\t  [vm id]\\n   578\\t  (let [handle (get (:resources vm) id)\\n   579\\t        d (when (stream/descriptor? handle) (stream/descriptor handle))]\\n   580\\t    (if (= :dao.stream/ok (outcome d))\\n   581\\t      {:yin.k/tag :yin.k/stream,\\n   582\\t       :dao.stream/identity (:dao.stream/identity d),\\n   583\\t       :dao.stream/descriptor (:dao.stream/descriptor d)}\\n   584\\t      (non-portable! :in-memory-handle {:yin.k/hint id}))))\\n   585\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '90,125p;500,575p' src/cljc/yin/vm/semantic.cljc | nl -ba\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '90,125p;500,575p' src/cljc/yin/vm/semantic.cljc | nl -ba\\\"\",\"aggregated_output\":\"     1\\t   land when telemetry is designed. A nil segment means the machine has no\\n     2\\t   control left, which is the halted state.\\n     3\\t\\n     4\\t   An empty continuation is stored as nil rather than [] so that\\n     5\\t   `engine/ready-for-ingress?`, which asks `(nil? (:k vm))`, sees a machine\\n     6\\t   between evaluations.\\\"\\n     7\\t  [vm seg pc val St E K]\\n     8\\t  (assoc vm\\n     9\\t         :control (when seg {:segment seg, :pc pc})\\n    10\\t         :value val\\n    11\\t         :stack (or St [])\\n    12\\t         :env E\\n    13\\t         :k