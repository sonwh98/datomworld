sponse` state; `full` keeps it in\\n   400\\t   `:link-request`, envelope verbatim, for the next poll; the terminal\\n   401\\t   outcomes throw, naming the outcome and the link id.\\\"\\n   402\\t  [resources entry]\\n   403\\t  (let [writer (get resources link-request-resource)\\n   404\\t        o (:dao.stream/outcome (stream/append! writer (:envelope entry)))]\\n   405\\t    (case o\\n   406\\t      :dao.stream/ok (-> entry\\n   407\\t                         (dissoc :envelope)\\n   408\\t                         (assoc :reason :link-response))\\n   409\\t      :dao.stream/full entry\\n   410\\t      (throw (ex-info \\\"Link request could not be appended\\\"\\n   411\\t                      {:outcome o, :link-id (:link-id entry)})))))\\n   412\\t\\n   413\\t\\n   414\\t(defn require-handler\\n   415\\t  \\\"Resolve `:module/require` (yin.vm.linker.md sections 7.2 and 8.3).\\n   416\\t\\n   417\\t   A module already in the registry value -- a host module, or one linked\\n   418\\t   earlier and lowered into this task -- answers now. A module installing\\n   419\\t   in this scheduler (section 7.3) is neither linked nor absent: the\\n   420\\t   requiring continuation joins that install's waiters as an `:install`\\n   421\\t\\n   422\\t      (installing? state module-name)\\n   423\\t      (block-on state (assoc (registers) :reason :install :name module-name))\\n   424\\t\\n   425\\t      (not (and response (get resources link-request-resource)))\\n   426\\t      (throw (ex-info \\\"Module is not in this VM's registry\\\"\\n   427\\t                      {:module module-name,\\n   428\\t                       :available (vec (list-modules (:modules state)))}))\\n   429\\t\\n   430\\t      :else\\n   431\\t      (let [minted (stream/cursor response stream/anchor-newest)\\n   432\\t            _ (when-not (= :dao.stream/ok (:dao.stream/outcome minted))\\n   433\\t                (throw (ex-info \\\"Link response cursor mint failed\\\"\\n   434\\t                                {:outcome (:dao.stream/outcome minted),\\n   435\\t                                 :module module-name})))\\n   436\\t            [link-id state] (mint-link-id state)\\n   437\\t            {:keys [format contract]} (link-format state)\\n   438\\t            entry (assoc (registers)\\n   439\\t                         :reason :link-request\\n   440\\t                         :name module-name\\n   441\\t                         :link-id link-id\\n   442\\t                         :envelope {:yin.link/id link-id,\\n   443\\t                                    :yin.link/name module-name,\\n   444\\t                                    :yin.link/format format,\\n   445\\t                                    :yin.link/contract contract}\\n   446\\t                         :request link-request-resource\\n   447\\t                         :response link-response-resource\\n   448\\t                         :cursor (:dao.stream/cursor minted))]\\n   449\\t        (block-on state (append-link-request resources entry))))))\\n   450\\t\\n   451\\t\\n   452\\t(defn default-registry\\n   453\\t  \\\"A registry with the built-in effect handlers and no modules.\\\"\\n   454\\t  []\\n   455\\t  (-> (empty-registry)\\n   456\\t      (register-effect-handler :module/require require-handler)))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'link-request-resource|link-response-resource|defn.*settle|defn.*start-install' src/cljc/yin/vm/{module,engine}.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '545,695p;885,945p' docs/design/yin.vm.universal-continuation-format.md | nl -ba\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'link-request-resource|link-response-resource|defn.*settle|defn.*start-install' src/cljc/yin/vm/{module,engine}.cljc\\\"\",\"aggregated_output\":\"src/cljc/yin/vm/engine.cljc:1148:(defn- start-install\\nsrc/cljc/yin/vm/engine.cljc:1162:(defn- settle\\nsrc/cljc/yin/vm/engine.cljc:1215:  (let [reader (get (:resources state) module/link-response-resource)]\\nsrc/cljc/yin/vm/module.cljc:360:(def link-request-resource\\nsrc/cljc/yin/vm/module.cljc:366:(def link-response-resource\\nsrc/cljc/yin/vm/module.cljc:403:  (let [writer (get resources link-request-resource)\\nsrc/cljc/yin/vm/module.cljc:440:        response (get resources link-response-resource)]\\nsrc/cljc/yin/vm/module.cljc:454:      (not (and response (get resources link-request-resource)))\\nsrc/cljc/yin/vm/module.cljc:475:                         :request link-request-resource\\nsrc/cljc/yin/vm/module.cljc:476:                         :response link-response-resource\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '545,695p;885,945p' docs/design/yin.vm.universal-continuation-format.md | nl -ba\\\"\",\"aggregated_output\":\"     1\\t### 7.4.3 The pending wait travels as data — complete, and resumable elsewhere\\n     2\\t\\n     3\\tA parked machine was waiting for something. That something is a resource of\\n     4\\tthe emitter's host, and the resumer cannot poll it. `:yin.k/pending` records\\n     5\\tthe wait in resource-independent terms so the resumer can re-establish an\\n     6\\t*equivalent* wait, or decide it cannot. The first draft carried sketches;\\n     7\\tthe set here is exhaustive over §7.4.1's reasons, and each variant carries\\n     8\\teverything a *foreign* resumer needs — including the state the first draft\\n     9\\tleft implicit on the emitter's heap:\\n    10\\t\\n    11\\t```clojure\\n    12\\t;; blocked read (:stream-next)\\n    13\\t{:yin.k/reason   :next\\n    14\\t :yin.k/cell     :yin.k/c-17}          ; the cursor CELL id, §7.5.3 — not a bare position\\n    15\\t\\n    16\\t;; blocked write (:stream-put, or an effectful call's :stream/put)\\n    17\\t{:yin.k/reason   :put\\n    18\\t :yin.k/stream   {:dao.stream/identity … :dao.stream/descriptor …}   ; the target\\n    19\\t :yin.k/value    <encoded>}            ; the retained value — a retry appends THIS, and\\n    20\\t                                       ; without it the wait is not re-establishable\\n    21\\t\\n    22\\t;; FFI call, sent (:ffi-call → ok)\\n    23\\t{:yin.k/reason     :ffi\\n    24\\t :yin.k/call-id    :call-7             ; the :dao.stream.apply/id correlation\\n    25\\t :yin.k/op         :op/add\\n    26\\t :yin.k/request    {:dao.stream/identity … :dao.stream/descriptor …}   ; where the request went\\n    27\\t :yin.k/response   {:dao.stream/identity … :dao.stream/descriptor …}   ; where the answer lands\\n    28\\t :yin.k/cell       :yin.k/c-23         ; the response cursor cell, §7.5.3, at its KEPT position}\\n    29\\t\\n    30\\t;; FFI call, retained (:ffi-call → full): the request is still in hand\\n    31\\t{:yin.k/reason     :ffi-request\\n    32\\t :yin.k/call-id    :call-7\\n    33\\t :yin.k/request-op :op/add\\n    34\\t :yin.k/request-args [<encoded> …]     ; enough to rebuild the envelope verbatim\\n    35\\t :yin.k/request    {identity/descriptor as above}\\n    36\\t :yin.k/response   {identity/descriptor as above}\\n    37\\t :yin.k/cell       :yin.k/c-23}        ; response cell at its kept position\\n    38\\t```\\n    39\\t\\n    40\\tThree rules make these resumable somewhere other than where they were minted:\\n    41\\t\\n    42\\t- **The response position is a kept cursor, never an anchor.** Reattaching\\n    43\\t  at `:oldest` replays responses that belong to other calls; attaching at\\n    44\\t  `:newest` skips past this call's own. The response cell therefore travels\\n    45\\t  at its *kept* position, and the whole task's waiters on that cell travel\\n    46\\t  with it (§7.6.3), so the round-order semantics of `check-wait-set` —\\n    47\\t  waiters sharing a cell consume successive values — are preserved on the\\n    48\\t  resumer exactly. A first poll that observes `gap` is the honest outcome\\n    49\\t  the contract already promises a kept cursor (`dao.stream.md`, *Retention\\n    50\\t  and Gaps*). At migration the composition serves every carried stream\\n    51\\t  cell through `dao.stream.remote.md`: the exporter enters the cell's\\n    52\\t  handle in its table and the cell's stream descriptor becomes a remote\\n    53\\t  descriptor. This is an access path to the original logical stream, not\\n    54\\t  a copied stream with new positions. `dao.stream` itself assumes no\\n    55\\t  network. The mirror serves the source's declared reader and writer\\n    56\\t  surface, preserving its outcome maps and cursor namespace rather than\\n    57\\t  assigning new positions. The cell carries its kept cursor. The receiver\\n    58\\t  attaches a reflection through that descriptor and resumes at the kept\\n    59\\t  cursor. `:yin.k/cursor-profiles` in `:yin.k/requires` names\\n    60\\t  `:dao.stream.remote/v1`, the one profile: a cursor is plain data in the\\n    61\\t  channel's portable domain and the source honors it after\\n    62\\t  serialization, including cursor identity, position, and `gap` outcomes.\\n    63\\t  If the source cannot be entered in a table, preserve the cursor, or\\n    64\\t  keep a channel reachable, lift refuses as `:yin.k/unsatisfied` before\\n    65\\t  minting the value. A reflection marked gone on the receiver is also\\n    66\\t  `:yin.k/unsatisfied`, naming the stream identity. The exporter keeps\\n    67\\t  the entry served under a lease the resumer holds\\n    68\\t  (`dao.stream.remote.md`, section 6). Re-homing a stream is out of\\n    69\\t  scope: serving from the exporter pins the exporter.\\n    70\\t- **Outstanding calls route to the emitter's pair; the resumer's pair is its\\n    71\\t  own.** The reference machine restores a `:request-sent` entry into a\\n    72\\t  response wait through its fixed local store keys (`vm/call-out-stream-key`\\n    73\\t  and friends). A resumer must *not* do that: the outstanding call's\\n    74\\t  response will arrive on the **emitter's** response stream, because that is\\n    75\\t  where the request was sent. The resumer re-establishes the wait against\\n    76\\t  the carried response descriptor and the cell's fresh local key (the cell\\n    77\\t  id remapped per §7.5.3), while calls the resumed program makes *after*\\n    78\\t  lowering use the resumer's own pair under its own keys. Pending-call\\n    79\\t  routing and future-call routing are separate stores of state; conflating\\n    80\\t  them strands the migrated call exactly as the review described.\\n    81\\t- **On resume, the resumer attaches and re-mints.** Attach to every\\n    82\\t  descriptor in the frame, pending, and cells; an attachment resolving to\\n    83\\t  `not-found` is `:yin.k/unsatisfied` naming the stream identity, never a\\n    84\\t  silent `nil`; a `:put` wait retries its retained value and resumes with it\\n    85\\t  on `ok` (the engine, a woken writer's retry appends and stamps the\\n    86\\t  value), where through a reflection `ok` is acceptance on the outbound\\n    87\\t  path and the wait resumes only when the source's `ok` is observed on the\\n    88\\t  link's event writer, while an append whose effect is unknown leaves the\\n    89\\t  wait undischarged for the program or its composition to decide\\n    90\\t  (`dao.stream.remote.md`, sections 2.4 and 2.5); a `:next` wait polls\\n    91\\t  its cell. No wait is silently dropped and no\\n    92\\t  retained value is recomputed — what parks is what resumes.\\n    93\\t\\n    94\\t**Linker pending variants (M4).** Specified by `yin.vm.linker.md` and\\n    95\\timplemented in M4. The require flow adds three pending variants, one per\\n    96\\tsafepoint of the same name (`yin.vm.linker.md` 7.2, 7.3). A wait entry's\\n    97\\t`:cursor` (the kept cursor) is UCF's `:yin.k/cell`: the cell id stands for\\n    98\\tthe cursor and its kept position rides in the cells table of section\\n    99\\t7.5.3:\\n   100\\t\\n   101\\t```clojure\\n   102\\t;; module link, request in hand (:module/require miss)\\n   103\\t{:yin.k/reason    :link-request\\n   104\\t :yin.k/link-id   [:t0 7]                 ; [origin counter], below\\n   105\\t :yin.k/envelope  {:yin.link/id [:t0 7] :yin.link/name 'foo\\n   106\\t                   :yin.link/format :yin.debruijn.code\\n   107\\t                   :yin.link/contract \\\"b2\\\"}   ; rebuilt verbatim\\n   108\\t :yin.k/request   {:dao.stream/identity ... :dao.stream/descriptor ...}\\n   109\\t :yin.k/response  {:dao.stream/identity ... :dao.stream/descriptor ...}\\n   110\\t :yin.k/cell      :yin.k/c-31}            ; response cell, minted newest\\n   111\\t                                          ; before the request is appended\\n   112\\t\\n   113\\t;; module link, awaiting the correlated response (request appended ok)\\n   114\\t{:yin.k/reason    :link-response\\n   115\\t :yin.k/link-id   [:t0 7]\\n   116\\t :yin.k/response  {:dao.stream/identity ... :dao.stream/descriptor ...}\\n   117\\t :yin.k/cell      :yin.k/c-31}            ; the kept cell, at its kept\\n   118\\t                                          ; position\\n   119\\t\\n   120\\t;; module install (a matching ok discharged; the child runs)\\n   121\\t{:yin.k/reason    :install\\n   122\\t :yin.k/name      'foo}\\n   123\\t```\\n   124\\t\\n   125\\tFour rules fix the exchange. The link id is the pair `[origin\\n   126\\tcounter]`, scoped to the link pair, not to a VM: several tasks share\\n   127\\tone response stream, `origin` is a task origin tag the scheduler mints\\n   128\\tfrom its own counter and never reuses, and `counter` is the task's\\n   129\\tengine gensym, so no two requests on one pair share an id. The response\\n   130\\tcursor is minted `:dao.stream/newest` before the request is appended --\\n   131\\tthe `dao.stream.md` *Cursors* rule for observing events caused by an\\n   132\\toperation -- so a response that lands before the cursor exists is not\\n   133\\tskipped. `:link-request` carries everything needed to rebuild the\\n   134\\tenvelope, `:link-response` carries the response descriptor and the kept\\n   135\\tcell; a `full` append keeps the request state, retains the envelope\\n   136\\tverbatim, and retries on the next poll, the `:ffi-request` discipline.\\n   137\\tAnd the poll restores only on exact correlation: the entry advances\\n   138\\tpast every response whose `:yin.link/id` is not its own, keeping its\\n   139\\tcursor at the first unconsumed position -- the per-cell round-order\\n   140\\tdiscipline section 7.5.3 already gives shared cursors -- and skips\\n   141\\tduplicate, late, and unknown responses, each skip a telemetry\\n   142\\tdiagnostic that consumes nothing but the cursor position. A matching\\n   143\\trefusal, or a failed discharge, resumes the program with the refusal\\n   144\\traised as the effect's error, the way an `:ffi` `error` raises; a\\n   145\\tcomposition that abandons a link raises the reason the same way and\\n   146\\tretires the id. A matching `ok` makes the entry `:install`, and no task\\n   147\\tis restored until the install reaches `linked` or `refused`: `linked`\\n   148\\trestores every waiter with the required module's symbol as its value,\\n   149\\t`refused` with the refusal as the effect's error. On `gap` the honest\\n   150\\toutcome is a `gap`, and the composition's policy decides.\\n   151\\t\\n   152\\t### 7.5.3 Sharing, cells, and cycles\\n   153\\t\\n   154\\t**The value table.** A configuration is a DAG, not a tree: a closure's\\n   155\\tcaptured environment is the frame's environment; a value on the stack is\\n   156\\talso bound in `E`. Encoding naively duplicates, and a deep K makes\\n   157\\tduplication quadratic. The encoder therefore builds a **value table**:\\n   158\\t\\n   159\\t- On encountering a collection, closure, or continuation it has already\\n   160\\t  encoded (host identity during one lift), it emits\\n   161\\t  `{:yin.k/tag :yin.k/ref :yin.k/id addr}` where `addr` is the `dao.jing`\\n   162\\t  address of the encoded subvalue, and places the subvalue in\\n   163\\t  `:yin.k/values {addr → encoded}`.\\n   164\\t- A subvalue is placed in the table when it is referenced more than once or\\n   165\\t  its encoded size exceeds a composition-supplied threshold; otherwise it\\n   166\\t  stays inline. Both choices yield equal semantics; only the table is needed\\n   167\\t  for correctness of sharing.\\n   168\\t- A cycle (a value reachable from itself through host identity) is refused\\n   169\\t  as `:yin.k/non-portable` with `:yin.k/kind :cyclic` naming the path. The\\n   170\\t  reference machine cannot produce one — `E` is extended by `merge`, never\\n   171\\t  mutated — so the refusal guards against foreign engines and bridge-returned\\n   172\\t  host structures. Cycles *through ref data* cannot be minted at all and are\\n   173\\t  rejected at decode (§7.5.1); this single representation retires the first\\n   174\\t  draft's two competing ones.\\n   175\\t\\n   176\\tBecause table entries are content-addressed, a carrier that already holds an\\n   177\\tentry (a `dao.jing` intake pool, a DHT replica) need not carry it again, and\\n   178\\ttwo continuations parked from the same closure share its encoding. This is\\n   179\\t`streams-all-the-way-down.md` §6.3's checkpoint-as-published-fold applied to\\n   180\\ta single frame. It is also why §7.3.4 separates `:yin.k/id` (which varies\\n   181\\twith these choices, harmlessly) from `:yin.k/occurrence` (which does not).\\n   182\\t\\n   183\\t**Cursor cells.** A cursor is *observable state with aliasing*: two distinct\\n   184\\tcursor refs may sit at the same position and yet be independently\\n   185\\tadvanceable store entries, while repeated refs to one cursor ref must\\n   186\\tadvance together — `check-wait-set` advances a shared cursor ref before\\n   187\\tpolling the next waiter, so waiters on one ref read successive values, and\\n   188\\twaiters on two refs at the same position read the same next value\\n   189\\t(`yin.vm.engine`, `check-wait-set`). A position-only encoding erases\\n   190\\texactly this distinction: two cells at one position would collapse, and\\n   191\\ttheir independent advancement would be lost. The encoding therefore carries\\n   192\\t**logical cursor cells** separately from position content:\\n   193\\t\\n   194\\t```clojure\\n   195\\t:yin.k/cells {:yin.k/c-17 {:yin.k/stream   {:yin.k/tag :yin.k/stream …}\\n   196\\t                           :yin.k/position <opaque, exactly as the transport minted it>}}\\n   197\\t;; values reference cells, never positions:\\n   198\\t{:yin.k/tag :yin.k/cursor-ref :yin.k/cell :yin.k/c-17}\\n   199\\t```\\n   200\\t\\n   201\\tCell ids are minted by the emitter (stable within one lift; remapped on\\n   202\\tlowering) and are *not* content-addressed — a cell is a local identity, like\\n   203\\ta tempid, and deduplicating cells by their contents is precisely the aliasing\\n   204\\terasure this structure exists to prevent. On lowering, each cell becomes a\\n   205\\tfresh store cursor entry seeded with its carried position; every\\n   206\\t`:yin.k/cursor-ref` to it remaps to that entry; two refs to one cell share\\n   207\\tone entry and one ref per cell keeps its own. The FFI response cell of\\n   208\\t§7.4.3 is a cell like any other.\\n   209\\t\\n   210\\t**Cells lower into the private resource table (linker M4).** Specified by\\n   211\\t`yin.vm.linker.md` and implemented in M4. The lowering rule above -- each\\n   212\\tcell becomes a fresh store cursor entry -- is amended by the resource\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,395p' test/yin/vm/ucf/remote_test.cljc | nl -ba\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,395p' test/yin/vm/ucf/remote_test.cljc | nl -ba\\\"\",\"aggregated_output\":\"     1\\t(ns yin.vm.ucf.remote-test\\n     2\\t  \\\"The slice 8 acceptance row\\n     3\\t   (`docs/design/dao.stream.remote.implementation-plan.md` slice 8;\\n     4\\t   `yin.vm.universal-continuation-format.md` S7.4.3, S7.5.3, S7.11.1\\n     5\\t   'Reflection acceptance'): a REAL machine parked through the engine\\n     6\\t   on a `:stream-next` wait migrates with a kept cursor and resumes\\n     7\\t   equivalently in a fresh engine state through a reflection; forced\\n     8\\t   eviction yields `gap` with the source's own recovery cursor; a\\n     9\\t   kept cursor that cannot survive the channel codec refuses the lift\\n    10\\t   before any cell is published; a source `serve!` refuses is\\n    11\\t   `:yin.k/unsatisfied`; an `attach!` that answers gone is\\n    12\\t   `:yin.k/unsatisfied` naming the stream at lower. Cursor cells are\\n    13\\t   minted and remapped across a whole frame set: two waiters on one\\n    14\\t   engine cell lift to one UCF cell and lower back shared, and\\n    15\\t   independent cells at one position stay independent (S7.5.3). The\\n    16\\t   remaining S7.4.3 variants -- `:put`, `:ffi`, `:ffi-request`,\\n    17\\t   `:link-request`, `:link-response`, `:install` -- round-trip\\n    18\\t   through stub `serve!`/`attach!` callbacks over the engine's own\\n    19\\t   wait-set shapes, since their proof is the shape of the bridge, not\\n    20\\t   the transport.\\\"\\n    21\\t  (:require [clojure.test :refer [deftest is testing]]\\n    22\\t            [dao.stream :as stream]\\n    23\\t            [dao.stream.apply :as apply2]\\n    24\\t            [dao.stream.remote :as remote]\\n    25\\t            [dao.stream.ringbuffer :as ringbuffer]\\n    26\\t            [yin.vm :as vm]\\n    27\\t            [yin.vm.linearize :as linearize]\\n    28\\t            [yin.vm.semantic :as semantic]\\n    29\\t            [yin.vm.ucf.remote :as ucf.remote]))\\n    30\\t\\n    31\\t\\n    32\\t;; =============================================================================\\n    33\\t;; The toy: two in-process ring buffers as the channel (as\\n    34\\t;; dao.stream.remote-test), with a served-table `serve!` on top\\n    35\\t;; =============================================================================\\n    36\\t\\n    37\\t(defn- ring\\n    38\\t  [capacity]\\n    39\\t  (:dao.stream/handle\\n    40\\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\\n    41\\t                         :dao.stream.ringbuffer/capacity capacity})))\\n    42\\t\\n    43\\t\\n    44\\t(defn- toy\\n    45\\t  []\\n    46\\t  (let [ab (ring 64)\\n    47\\t        ba (ring 64)\\n    48\\t        cd {:dao.stream/type :dao.stream.test/channel\\n    49\\t            :dao.stream/identity \\\"ucf-remote-toy\\\"}]\\n    50\\t    {:channel cd, :ab ab, :ba ba,\\n    51\\t     :a-end {:reader ba, :writer ab},\\n    52\\t     :b-end {:reader ab, :writer ba}}))\\n    53\\t\\n    54\\t\\n    55\\t(defn- served-peer\\n    56\\t  [t]\\n    57\\t  {:table (atom {})\\n    58\\t   :b-reader (:reader (:b-end t))\\n    59\\t   :b-writer (:writer (:b-end t))\\n    60\\t   :mirror (atom (:dao.stream/cursor\\n    61\\t                   (stream/cursor (:reader (:b-end t)) :dao.stream/oldest)))})\\n    62\\t\\n    63\\t\\n    64\\t(defn- serve-mirror!\\n    65\\t  \\\"One mirror step over everything pending on the toy's request\\n    66\\t   buffer.\\\"\\n    67\\t  [peer]\\n    68\\t  (swap! (:mirror peer)\\n    69\\t         #(remote/mirror-step @(:table peer) (:b-reader peer) %\\n    70\\t                              (:b-writer peer))))\\n    71\\t\\n    72\\t\\n    73\\t(defn- server\\n    74\\t  \\\"The exporter's `serve!` (dao.stream.remote.md S2.3): assigns a\\n    75\\t   stable identity to `h`, entering it in the peer's table under\\n    76\\t   `chan`, if it is not already served.\\\"\\n    77\\t  [peer chan]\\n    78\\t  (fn [h]\\n    79\\t    (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\\n    80\\t                            @(:table peer))]\\n    81\\t      {:dao.stream/identity existing, :dao.stream/channel chan}\\n    82\\t      (let [id (str (gensym \\\"seg\\\"))]\\n    83\\t        (swap! (:table peer) assoc id {:handle h, :surface #{:reader}})\\n    84\\t        {:dao.stream/identity id, :dao.stream/channel chan}))))\\n    85\\t\\n    86\\t\\n    87\\t(defn- attacher\\n    88\\t  [t]\\n    89\\t  (remote/attacher\\n    90\\t    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\\n    91\\t\\n    92\\t\\n    93\\t;; =============================================================================\\n    94\\t;; The emitter side: a real machine parked through the engine\\n    95\\t;; =============================================================================\\n    96\\t\\n    97\\t(def ^:private secret\\n    98\\t  \\\"The capability secret the test composition gives its machines.\\\"\\n    99\\t  \\\"yin.vm.ucf.remote-test/capability-secret\\\")\\n   100\\t\\n   101\\t\\n   102\\t(defn- make-ring-stream\\n   103\\t  \\\"The ring-buffer `:make-stream` this composition gives its\\n   104\\t   machines -- `yin.vm.test-utils`'s choice, at test scale.\\\"\\n   105\\t  [capacity]\\n   106\\t  (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\\n   107\\t                       :dao.stream.ringbuffer/capacity capacity}))\\n   108\\t\\n   109\\t\\n   110\\t(defn- new-machine\\n   111\\t  \\\"A fresh semantic machine over that composition.\\\"\\n   112\\t  []\\n   113\\t  (semantic/create-vm {:make-stream make-ring-stream\\n   114\\t                       :capability-secret secret}))\\n   115\\t\\n   116\\t\\n   117\\t(def ^:private load-ast\\n   118\\t  \\\"The trusted fresh path: the AST linearizer behind the code loader.\\\"\\n   119\\t  (vm/fresh-code-loader (linearize/ast-loader semantic/vm-load-program)\\n   120\\t                        vm/ast-contract))\\n   121\\t\\n   122\\t\\n   123\\t(defn- var-ref\\n   124\\t  [n]\\n   125\\t  {:type :variable, :name n})\\n   126\\t\\n   127\\t\\n   128\\t(defn- let1\\n   129\\t  \\\"`((fn [param] body) init)`.\\\"\\n   130\\t  [param init body]\\n   131\\t  {:type :application,\\n   132\\t   :operator {:type :lambda, :params [param], :body body},\\n   133\\t   :operands [init]})\\n   134\\t\\n   135\\t\\n   136\\t(defn- reader-datoms\\n   137\\t  \\\"Make a stream of `capacity`, mint a cursor on it, read one value.\\\"\\n   138\\t  [capacity]\\n   139\\t  (vm/ast->datoms\\n   140\\t    (let1 's {:type :stream/make, :buffer capacity}\\n   141\\t          {:type :stream/next,\\n   142\\t           :source {:type :stream/cursor, :source (var-ref 's)}})))\\n   143\\t\\n   144\\t\\n   145\\t(defn- parked-reader\\n   146\\t  \\\"A real machine parked through the engine on a `:stream-next` wait\\n   147\\t   over a fresh ring buffer: the code datoms, the parked VM, its\\n   148\\t   wait-set entry, and the stream handle the entry polls.\\\"\\n   149\\t  [capacity]\\n   150\\t  (let [datoms (reader-datoms capacity)\\n   151\\t        parked (vm/run (load-ast (new-machine) datoms))\\n   152\\t        entry (first (:wait-set parked))]\\n   153\\t    [datoms parked entry\\n   154\\t     (get (:resources parked) (:stream-id entry))]))\\n   155\\t\\n   156\\t\\n   157\\t(defn- registers-of\\n   158\\t  \\\"The register payload a parked entry carries.\\\"\\n   159\\t  [entry]\\n   160\\t  (select-keys entry [:segment :pc :env :stack :k]))\\n   161\\t\\n   162\\t\\n   163\\t(defn- quiesced-receiver\\n   164\\t  \\\"The fresh engine state a lower installs into: a real machine over\\n   165\\t   the same code image, quiesced, holding the lowered resource table\\n   166\\t   and the lowered wait-set entry -- nothing of the emitter's state\\n   167\\t   but the code image and the registers the entry carries.\\\"\\n   168\\t  [datoms lowered]\\n   169\\t  (assoc (load-ast (new-machine) datoms)\\n   170\\t         :control nil, :k nil,\\n   171\\t         :value :yin/blocked, :blocked? true, :halted? false,\\n   172\\t         :wait-set [(:entry lowered)],\\n   173\\t         :resources (:resources lowered)))\\n   174\\t\\n   175\\t\\n   176\\t(defn- cursor-entries\\n   177\\t  \\\"The cursor entries of a lowered resource table: maps keyed by the\\n   178\\t   UCF cell ids, each carrying its stream id and kept cursor.\\\"\\n   179\\t  [table]\\n   180\\t  (into {} (filter (fn [[_ v]] (and (map? v) (contains? v :stream-id))))\\n   181\\t        table))\\n   182\\t\\n   183\\t\\n   184\\t;; =============================================================================\\n   185\\t;; The acceptance row: a real parked machine migrates and resumes\\n   186\\t;; =============================================================================\\n   187\\t\\n   188\\t(deftest migrates-a-real-parked-machine-and-resumes\\n   189\\t  (let [t (toy)\\n   190\\t        peer (served-peer t)\\n   191\\t        serve! (server peer (:channel t))\\n   192\\t        attach! (attacher t)\\n   193\\t        [datoms parked entry src] (parked-reader 4)\\n   194\\t        cid (:id (:cursor-ref entry))\\n   195\\t        sid (:stream-id entry)\\n   196\\t        kept (get-in parked [:resources cid :cursor])\\n   197\\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\\n   198\\t        lowered (ucf.remote/lower-pending attach! (:yin.k/pending lifted)\\n   199\\t                                          (:yin.k/cells lifted)\\n   200\\t                                          (registers-of entry))\\n   201\\t        receiver (quiesced-receiver datoms lowered)]\\n   202\\t    (testing \\\"the machine parked through the engine\\\"\\n   203\\t      (is (vm/blocked? parked))\\n   204\\t      (is (= :next (:reason entry)))\\n   205\\t      (is (= :cursor-ref (get-in entry [:cursor-ref :type]))))\\n   206\\t    (testing \\\"the lift reads the engine's own wait-set entry\\\"\\n   207\\t      (is (= {:yin.k/reason :next, :yin.k/cell :yin.k/c-0}\\n   208\\t             (:yin.k/pending lifted))\\n   209\\t          \\\"the cursor CELL id, S7.5.3 -- not a bare position\\\")\\n   210\\t      (is (= kept (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\\n   211\\t          \\\"the cell carries the engine's kept cursor\\\")\\n   212\\t      (is (= #{:dao.stream.remote/v1}\\n   213\\t             (get-in lifted [:yin.k/requires :yin.k/cursor-profiles]))))\\n   214\\t    (testing \\\"the lower builds a fresh engine state\\\"\\n   215\\t      (let [e (:entry lowered)\\n   216\\t            rs (:resources lowered)\\n   217\\t            cid' (get-in e [:cursor-ref :id])\\n   218\\t            sid' (:stream-id e)]\\n   219\\t        (is (= (registers-of entry) (registers-of e))\\n   220\\t            \\\"the register context rides the lower verbatim\\\")\\n   221\\t        (is (not= cid cid'))\\n   222\\t        (is (not= sid sid'))\\n   223\\t        (is (not (contains? rs cid)))\\n   224\\t        (is (not (contains? rs sid)))\\n   225\\t        (is (= {:stream-id sid', :cursor kept} (get rs cid'))\\n   226\\t            \\\"one fresh cursor entry, at the kept position\\\")\\n   227\\t        (is (not= src (get rs sid'))\\n   228\\t            \\\"the stream entry is a reflection, not the emitter's handle\\\")\\n   229\\t        (is (= sid' (get-in rs [cid' :stream-id])))))\\n   230\\t    (testing \\\"the emitter's own wait resumes equivalently\\\"\\n   231\\t      (stream/append! src \\\"hello\\\")\\n   232\\t      (is (= \\\"hello\\\" (vm/value (vm/run parked)))))\\n   233\\t    (testing \\\"the migrated wait resumes in the fresh engine state\\\"\\n   234\\t      (is (vm/blocked? (vm/run receiver))\\n   235\\t          \\\"the reflection answers blocked until the mirror serves\\\")\\n   236\\t      (serve-mirror! peer)\\n   237\\t      (let [done (vm/run receiver)]\\n   238\\t        (is (vm/halted? done))\\n   239\\t        (is (= \\\"hello\\\" (vm/value done))\\n   240\\t            \\\"the source's own value, through the kept cursor\\\")\\n   241\\t        (is (empty? (:wait-set done)))))))\\n   242\\t\\n   243\\t\\n   244\\t(deftest forced-eviction-yields-gap-with-the-sources-cursor\\n   245\\t  (let [t (toy)\\n   246\\t        peer (served-peer t)\\n   247\\t        serve! (server peer (:channel t))\\n   248\\t        attach! (attacher t)\\n   249\\t        [datoms parked entry src] (parked-reader 2)\\n   250\\t        cid (:id (:cursor-ref entry))\\n   251\\t        kept (get-in parked [:resources cid :cursor])\\n   252\\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\\n   253\\t        lowered (ucf.remote/lower-pending attach! (:yin.k/pending lifted)\\n   254\\t                                          (:yin.k/cells lifted)\\n   255\\t                                          (registers-of entry))\\n   256\\t        cid' (get-in (:entry lowered) [:cursor-ref :id])\\n   257\\t        receiver (quiesced-receiver datoms lowered)]\\n   258\\t    (stream/append! src \\\"hello\\\")\\n   259\\t    (doseq [v [\\\"v1\\\" \\\"v2\\\" \\\"v3\\\"]]\\n   260\\t      (stream/append! src v))\\n   261\\t    (is (vm/blocked? (vm/run receiver)))\\n   262\\t    (serve-mirror! peer)\\n   263\\t    (let [expected (stream/next src kept)\\n   264\\t          done (vm/run receiver)]\\n   265\\t      (testing \\\"the program reads the source's own gap, verbatim\\\"\\n   266\\t        (is (= :dao.stream/gap (vm/value done)))\\n   267\\t        (is (= (:dao.stream/cursor expected)\\n   268\\t               (get-in done [:resources cid' :cursor]))\\n   269\\t            \\\"with the source's own recovery cursor in the cell\\\"))\\n   270\\t      (testing \\\"no replay and no silent skip: the walk continues\\n   271\\t                from the recovery cursor\\\"\\n   272\\t        (let [r (get-in done [:resources (:stream-id (:entry lowered))])\\n   273\\t              recovery (get-in done [:resources cid' :cursor])]\\n   274\\t          (is (= :dao.stream/blocked\\n   275\\t                 (:dao.stream/outcome (stream/next r recovery))))\\n   276\\t          (serve-mirror! peer)\\n   277\\t          (let [ok (stream/next r recovery)]\\n   278\\t            (is (= :dao.stream/ok (:dao.stream/outcome ok)))\\n   279\\t            (is (= \\\"v2\\\" (:dao.stream/value ok)))))))))\\n   280\\t\\n   281\\t\\n   282\\t;; =============================================================================\\n   283\\t;; Unsatisfied: an unpublishable cursor, a source that cannot be\\n   284\\t;; served, a gone reflection\\n   285\\t;; =============================================================================\\n   286\\t\\n   287\\t(defn- host-cursor-stream\\n   288\\t  \\\"A handle whose cursors hold a host object -- the case\\n   289\\t   dao.stream.remote.md S2.3 says cannot be served.\\\"\\n   290\\t  []\\n   291\\t  (reify stream/IDaoStreamDescriptor\\n   292\\t    (descriptor\\n   293\\t      [_]\\n   294\\t      {:dao.stream/outcome :dao.stream/ok\\n   295\\t       :dao.stream/identity \\\"host-cursor\\\"\\n   296\\t       :dao.stream/descriptor\\n   297\\t       {:dao.stream/type :dao.stream.test/channel\\n   298\\t        :dao.stream/identity \\\"host-cursor\\\"}})\\n   299\\t\\n   300\\t\\n   301\\t    stream/IDaoStreamReader\\n   302\\t\\n   303\\t    (cursor\\n   304\\t      [_ _]\\n   305\\t      {:dao.stream/outcome :dao.stream/ok\\n   306\\t       :dao.stream/cursor {:position 0, :owner (fn [x] x)}})\\n   307\\t\\n   308\\t    (next\\n   309\\t      [_ _]\\n   310\\t      {:dao.stream/outcome :dao.stream/blocked})))\\n   311\\t\\n   312\\t\\n   313\\t(deftest a-cursor-that-cannot-round-trip-is-refused\\n   314\\t  (let [t (toy)\\n   315\\t        peer (served-peer t)\\n   316\\t        serve! (server peer (:channel t))\\n   317\\t        s (host-cursor-stream)\\n   318\\t        resources {:yin/host-stream s,\\n   319\\t                   :yin/host-cursor\\n   320\\t                   {:stream-id :yin/host-stream,\\n   321\\t                    :cursor {:position 0, :owner (fn [x] x)}}}\\n   322\\t        entry {:reason :next,\\n   323\\t               :cursor-ref {:type :cursor-ref, :id :yin/host-cursor},\\n   324\\t               :stream-id :yin/host-stream}\\n   325\\t        refusal (ucf.remote/lift-pending serve! resources entry)]\\n   326\\t    (is (= :yin.k/unsatisfied (:yin.k/status refusal))\\n   327\\t        \\\"the profile claim is checked before anything is published\\\")\\n   328\\t    (is (= \\\"host-cursor\\\" (:dao.stream/identity refusal))\\n   329\\t        \\\"naming the stream identity\\\")\\n   330\\t    (is (empty? @(:table peer))\\n   331\\t        \\\"refused before `serve!` even mints the descriptor\\\")))\\n   332\\t\\n   333\\t\\n   334\\t(deftest lift-refuses-unsatisfied-when-the-source-cannot-be-served\\n   335\\t  (let [s (ring 4)]\\n   336\\t    (stream/append! s \\\"x\\\")\\n   337\\t    (let [c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\\n   338\\t          resources {:yin/s s, :yin/c {:stream-id :yin/s, :cursor c0}}\\n   339\\t          entry {:reason :next,\\n   340\\t                 :cursor-ref {:type :cursor-ref, :id :yin/c},\\n   341\\t                 :stream-id :yin/s}\\n   342\\t          refusal (ucf.remote/lift-pending (constantly nil) resources entry)]\\n   343\\t      (is (= :yin.k/unsatisfied (:yin.k/status refusal))\\n   344\\t          \\\"lift refuses before minting the value\\\")\\n   345\\t      (is (contains? refusal :dao.stream/identity)\\n   346\\t          \\\"naming the stream identity\\\"))))\\n   347\\t\\n   348\\t\\n   349\\t(deftest lower-refuses-unsatisfied-when-the-reflection-is-gone\\n   350\\t  (let [attach! (constantly {:dao.stream/outcome :dao.stream/transport-error\\n   351\\t                             :dao.stream.remote/reason\\n   352\\t                             :dao.stream.remote/not-found})\\n   353\\t        marker {:yin.k/tag :yin.k/stream,\\n   354\\t                :dao.stream/identity \\\"missing\\\",\\n   355\\t                :dao.stream/descriptor\\n   356\\t                {:dao.stream/type :dao.stream/remote,\\n   357\\t                 :dao.stream/identity \\\"missing\\\",\\n   358\\t                 :dao.stream/channel\\n   359\\t                 {:dao.stream/type :dao.stream.test/channel,\\n   360\\t                  :dao.stream/identity \\\"elsewhere\\\"}}}\\n   361\\t        pending {:yin.k/reason :next, :yin.k/cell :yin.k/c-0}\\n   362\\t        cells {:yin.k/c-0 {:yin.k/stream marker, :yin.k/position 0}}\\n   363\\t        lowered (ucf.remote/lower-pending attach! pending cells {})]\\n   364\\t    (is (= :yin.k/unsatisfied (:yin.k/status lowered)))\\n   365\\t    (is (= \\\"missing\\\" (:dao.stream/identity lowered))\\n   366\\t        \\\"naming the stream identity\\\")))\\n   367\\t\\n   368\\t\\n   369\\t;; =============================================================================\\n   370\\t;; Frame-level cells (S7.5.3): shared and independent\\n   371\\t;; =============================================================================\\n   372\\t\\n   373\\t(defn- stub-serve!\\n   374\\t  \\\"A `serve!` that assigns every handle to one identity per handle\\n   375\\t   under `chan`, with no wire underneath: these variants prove the\\n   376\\t   bridge's shape, the transport already proven above.\\\"\\n   377\\t  [chan]\\n   378\\t  (let [ids (atom {})]\\n   379\\t    (fn [h]\\n   380\\t      (let [id (or (get @ids h)\\n   381\\t                   (let [n (str (gensym \\\"seg\\\"))]\\n   382\\t                     (swap! ids assoc h n)\\n   383\\t                     n))]\\n   384\\t        {:dao.stream/identity id, :dao.stream/channel chan}))))\\n   385\\t\\n   386\\t\\n   387\\t(defn- stub-attach!\\n   388\\t  \\\"An `attach!` that answers ok at once with a reflection standing for\\n   389\\t   the descriptor's identity -- opaque here, since these variants\\n   390\\t   never poll it.\\\"\\n   391\\t  []\\n   392\\t  (fn [d]\\n   393\\t    {:dao.stream/outcome :dao.stream/ok,\\n   394\\t     :dao.stream/handle [:reflection-of (:dao.stream/identity d)]}))\\n   395\\t\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '125,150p;440,475p' src/cljc/yin/vm/semantic.cljc | nl -ba -v125\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '125,150p;440,475p' src/cljc/yin/vm/semantic.cljc | nl -ba -v125\\\"\",\"aggregated_output\":\"   125\\t     exactly as an immediately-sent one does, so the entry is replaced by its\\n   126\\t     response reader and the machine stays blocked.\\n   127\\t   - A `:call-id` entry is a response reader. The woken value is a response\\n   128\\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\\n   129\\t     parked call leaves `:parked` rather than accumulating.\\\"\\n   130\\t  ([base entry] (semantic-restore base entry (:value entry)))\\n   131\\t  ([base entry val]\\n   132\\t   (if (:request-sent entry)\\n   133\\t     (assoc base\\n   134\\t            :wait-set (conj (vec (or (:wait-set base) []))\\n   135\\t                            (response-wait-entry (:segment entry)\\n   136\\t                                                 (:pc entry)\\n   137\\t                                                 (:env entry)\\n   138\\t                                                 (:stack entry)\\n   139\\t                                                 (:k entry)\\n   140\\t                                                 (:call-id entry)))\\n   141\\t            :control nil\\n   142\\t            :k nil\\n   143\\t            :value :yin/blocked\\n   144\\t            :blocked? true\\n   145\\t            :halted? false)\\n   146\\t     (let [call-id (:call-id entry)\\n   147\\t           base (if call-id (update base :parked dissoc call-id) base)\\n   148\\t           val (if call-id (ffi/call-result val call-id) val)]\\n   149\\t       (put-registers base\\n   150\\t                      (:segment entry)\\n   151\\t                       parked (engine/park-continuation\\n   152\\t                                vm'\\n   153\\t                                {:segment seg, :pc (inc pc),\\n   154\\t                                 :env E, :stack St', :k K})\\n   155\\t                       call-id (get-in parked [:value :id])\\n   156\\t                       request (apply2/request call-id ffi-op args)\\n   157\\t                       result (apply2/put-request! call-in request)]\\n   158\\t                   (case (:dao.stream/outcome result)\\n   159\\t                     :dao.stream/ok\\n   160\\t                     (-> parked\\n   161\\t                         (update :wait-set (fnil conj [])\\n   162\\t                                 (response-wait-entry seg (inc pc) E St' K\\n   163\\t                                                      call-id))\\n   164\\t                         (assoc :control nil\\n   165\\t                                :k nil\\n   166\\t                                :value :yin/blocked\\n   167\\t                                :blocked? true\\n   168\\t                                :halted? false))\\n   169\\t       