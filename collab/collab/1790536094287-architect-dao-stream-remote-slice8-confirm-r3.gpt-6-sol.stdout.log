r context, merged verbatim.\\\"\\n   570\\t  [attach! pendings cells contexts]\\n   571\\t  (let [ms (distinct (remove nil?\\n   572\\t                             (concat (map :yin.k/stream (vals cells))\\n   573\\t                                     (mapcat pending-markers pendings))))\\n   574\\t        a (attach-all attach! ms)]\\n   575\\t    (if (contains? a :yin.k/status)\\n   576\\t      a\\n   577\\t      (let [lowered (mapv #(lower-one %1 %2 (:streams a) cells)\\n   578\\t                          pendings contexts)]\\n   579\\t        (if-let [refusal (some #(when (contains? % :yin.k/status) %)\\n   580\\t                               lowered)]\\n   581\\t          refusal\\n   582\\t          {:entries (mapv :entry lowered),\\n   583\\t           :resources (merge (:resources a)\\n   584\\t                             (cell-resources (:streams a) cells))})))))\\n   585\\t\\n   586\\t\\n   587\\t(defn lower-pending\\n   588\\t  \\\"One pending entry of S7.4.3, lowered: `{:entry e, :resources\\n   589\\t   table}` -- the wait-set entry `ctx`'s registers ride on, and the\\n   590\\t   fresh resource entries it polls through -- with the same\\n   591\\t   `:yin.k/unsatisfied` and `:yin.k/undecodable` outcomes\\n   592\\t   `lower-frame` gives. Frame assembly that shares cursor entries\\n   593\\t   across entries is `lower-frame`'s.\\\"\\n   594\\t  [attach! pending cells ctx]\\n   595\\t  (let [r (lower-frame attach! [pending] cells [ctx])]\\n   596\\t    (if (contains? r :yin.k/status)\\n   597\\t      r\\n   598\\t      (-> r\\n   599\\t          (assoc :entry (first (:entries r)))\\n   600\\t          (dissoc :entries)))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n '7\\\\\\\\.4\\\\\\\\.3|7\\\\\\\\.5\\\\\\\\.3|7\\\\\\\\.11|ffi-request|link-request' docs/design/yin.vm.universal-continuation-format.md\\\"\",\"aggregated_output\