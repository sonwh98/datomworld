et's shared-cursor co-waiters hold\n   687\t        second (assoc (registers-of entry)\n   688\t                      :reason :next,\n   689\t                      :stream-id (:stream-id entry),\n   690\t                      :cursor-ref {:type :cursor-ref, :id cid},\n   691\t                      :pc 42)\n   692\t        lifted (ucf.remote/lift-frame serve! (:resources parked)\n   693\t                                      [entry second])]\n   694\t    (testing \"two waiters on one engine cell lift to one UCF cell\"\n   695\t      (is (= 1 (count (:yin.k/cells lifted))))\n   696\t      (let [[p1 p2] (:yin.k/pending lifted)]\n   697\t        (is (= (:yin.k/cell p1) (:yin.k/cell p2))\n   698\t            \"both waiters name the one cell\")))\n   699\t    (let [ctxs [(registers-of entry) (registers-of second)]\n   700\t          lowered (ucf.remote/lower-frame attach! (:yin.k/pending lifted)\n   701\t                                          (:yin.k/cells lifted) ctxs)\n   702\t          [e1 e2] (:entries lowered)\n   703\t          rs (:resources lowered)]\n   704\t      (testing \"and lower back into one shared cursor entry\"\n   705\t        (is (= (get-in e1 [:cursor-ref :id])\n   706\t               (get-in e2 [:cursor-ref :id]))\n   707\t            \"one cell id stands for the one entry\")\n   708\t        (is (= 1 (count (cursor-entries rs)))))\n   709\t      (testing \"each entry keeps its own register context\"\n   710\t        (is (= (:pc entry) (:pc e1)))\n   711\t        (is (= 42 (:pc e2)))))))\n   712\t\n   713\t\n   714\t(deftest independent-cells-at-one-position-stay-independent\n   715\t  (let [serve! (stub-serve! chan)\n   716\t        attach! (stub-attach!)\n   717\t        s (ring 8)\n   718\t        _ (stream/append! s \"v\")\n   719\t        c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   720\t        resources {:yin/s s,\n   721\t                   :yin/c1 {:stream-id :yin/s, :cursor c0},\n   722\t                   :yin/c2 {:stream-id :yin/s, :cursor c0}}\n   723\t        entry1 {:reason :next,\n   724\t                :cursor-ref {:type :cursor-ref, :id :yin/c1},\n   725\t                :stream-id :yin/s}\n   726\t        entry2 {:reason :next,\n   727\t                :cursor-ref {:type :cursor-ref, :id :yin/c2},\n   728\t                :stream-id :yin/s}\n   729\t        lifted (ucf.remote/lift-frame serve! resources\n   730\t                                      [entry1 entry2])]\n   731\t    (testing \"two engine cells at one position are two UCF cells\"\n   732\t      (is (= 2 (count (:yin.k/cells lifted)))\n   733\t          \"the aliasing a position-only encoding erases, kept\")\n   734\t      (let [[p1 p2] (:yin.k/pending lifted)]\n   735\t        (is (not= (:yin.k/cell p1) (:yin.k/cell p2)))\n   736\t        (is (= c0 (get-in lifted [:yin.k/cells (:yin.k/cell p1)\n   737\t                                  :yin.k/position])))\n   738\t        (is (= c0 (get-in lifted [:yin.k/cells (:yin.k/cell p2)\n   739\t                                  :yin.k/position])))))\n   740\t    (let [ctx {:segment 0, :pc 1, :env {}, :stack [], :k []}\n   741\t          lowered (ucf.remote/lower-frame attach! (:yin.k/pending lifted)\n   742\t                                          (:yin.k/cells lifted)\n   743\t                                          [ctx ctx])\n   744\t          [e1 e2] (:entries lowered)\n   745\t          rs (:resources lowered)]\n   746\t      (testing \"and lower into two independently advanceable entries\"\n   747\t        (is (not= (get-in e1 [:cursor-ref :id])\n   748\t                  (get-in e2 [:cursor-ref :id])))\n   749\t        (is (= 2 (count (cursor-entries rs))))\n   750\t        (is (= 1 (count (filter vector? (vals rs))))\n   751\t            \"one stream, so the two cells share one reflection\")))))\n   752\t\n   753\t\n   754\t(deftest a-refused-leaf-refuses-the-frame\n   755\t  (let [serve! (stub-serve! chan)\n   850\t      (is (= :op/add (:op e)))\n   851\t      (is (= :yin.k/c-0 (get-in e [:cursor-ref :id])))\n   852\t      (is (= 5 (get-in lowered [:resources (:yin.k/cell pending)\n   853\t                                :cursor]))))))\n   854\t\n   855\t\n   856\t(deftest ffi-retained-round-trips\n   857\t  (let [serve! (stub-serve! chan)\n   858\t        attach! (stub-attach!)\n   859\t        envelope (apply2/request :call-7 :op/add [1 2])\n   860\t        resources {vm/call-in-stream-key [:handle :call-in],\n   861\t                   vm/call-out-stream-key [:handle :call-out],\n   862\t                   vm/call-out-cursor-key\n   863\t                   {:stream-id vm/call-out-stream-key, :cursor 2}}\n   864\t        entry {:reason :put, :request-sent true, :call-id :call-7,\n   865\t               :op :op/add, :stream-id vm/call-in-stream-key,\n   866\t               :datom envelope}\n   867\t        lifted (ucf.remote/lift-pending serve! resources entry)\n   868\t        pending (:yin.k/pending lifted)]\n   869\t    (is (= :ffi-request (:yin.k/reason pending)))\n   870\t    (is (= :call-7 (:yin.k/call-id pending)))\n   871\t    (is (= :op/add (:yin.k/request-op pending)))\n   872\t    (is (= [1 2] (:yin.k/request-args pending)))\n   873\t    (is (= :yin.k/c-0 (:yin.k/response-cell pending))\n   874\t        \"the response route rides as a cell\")\n   875\t    (is (= 2 (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   876\t        \"the route cell at the emitter's kept call-out position\")\n   877\t    (is (= #{:dao.stream.remote/v1}\n   878\t           (get-in lifted [:yin.k/requires :yin.k/cursor-profiles]))\n   879\t        \"the frame carries a cursor profile: the route is a cell\")\n   880\t    (let [ctx {:segment 0, :pc 5, :env {}, :stack [], :k []}\n   881\t          lowered (ucf.remote/lower-pending attach! pending\n   882\t                                            (:yin.k/cells lifted) ctx)\n   883\t          e (:entry lowered)\n   884\t          rs (:resources lowered)]\n   885\t      (is (= :put (:reason e)))\n   886\t      (is (true? (:request-sent e)))\n   887\t      (is (= :call-7 (:call-id e)))\n   888\t      (is (= envelope (:datom e))\n   889\t          \"the envelope rebuilt verbatim under its call id\")\n   890\t      (is (= vm/call-in-stream-key (:stream-id e))\n   891\t          \"the retry appends at the engine's fixed call-in key\")\n   892\t      (is (contains? rs (:stream-id e)))\n   893\t      (is (contains? rs vm/call-out-stream-key)\n   894\t          \"the response route lowers onto the fixed call-out key\")\n   895\t      (is (= {:stream-id vm/call-out-stream-key, :cursor 2}\n   896\t             (get rs vm/call-out-cursor-key))\n   897\t          \"the restored response wait reads the fixed call-out cursor\"))))\n   898\t\n   899\t\n   900\t(deftest link-request-round-trips\n   901\t  (let [serve! (stub-serve! chan)\n   902\t        attach! (stub-attach!)\n   903\t        envelope {:yin.link/id [:t0 7], :yin.link/name 'foo,\n   904\t                  :yin.link/format :yin.debruijn.code,\n   905\t                  :yin.link/contract \"b2\"}\n   906\t        resources {module/link-request-resource [:handle :req],\n   907\t                   module/link-response-resource [:handle :resp]}\n   908\t        entry {:reason :link-request, :link-id [:t0 7], :name 'foo,\n   909\t               :envelope envelope,\n   910\t               :request module/link-request-resource,\n   911\t               :response module/link-response-resource,\n   912\t               :cursor :dao.stream/newest}\n   913\t        lifted (ucf.remote/lift-pending serve! resources entry)\n   914\t        pending (:yin.k/pending lifted)]\n   915\t    (is (= :link-request (:yin.k/reason pending)))\n   916\t    (is (= [:t0 7] (:yin.k/link-id pending)))\n   917\t    (is (= 'foo (:yin.k/name pending)))\n   918\t    (is (= envelope (:yin.k/envelope pending)))\n   919\t    (is (= :dao.stream/newest\n   920\t           (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   921\t        \"minted newest before the request was appended\")\n   922\t    (let [ctx {:segment 0, :pc 2, :env {}, :stack [], :k []}\n   923\t          lowered (ucf.remote/lower-pending attach! pending\n   924\t                                            (:yin.k/cells lifted) ctx)\n   925\t          e (:entry lowered)\n   926\t          rs (:resources lowered)]\n   927\t      (is (= :link-request (:reason e)))\n   928\t      (is (= envelope (:envelope e)))\n   929\t      (is (= :dao.stream/newest (:cursor e)))\n   930\t      (is (= module/link-request-resource (:request e))\n   931\t          \"the retry appends at the engine's fixed request key\")\n   932\t      (is (= module/link-response-resource (:response e))\n   933\t          \"the poll reads at the engine's fixed response key\")\n   934\t      (is (contains? rs (:request e)))\n   935\t      (is (contains? rs (:response e))\n   936\t          \"the pair's reflections stand under the fixed keys\")\n   937\t      (is (= (get rs (:response e))\n   938\t             (get rs (get-in rs [(:yin.k/cell pending) :stream-id])))\n   939\t          \"the response cell lowers onto the same reflection\"))))\n   940\t\n","exit_code":0,"status":"completed"}}
