   53\\t\\n    54\\t\\n    55\\t;; =============================================================================\\n    56\\t;; Loading\\n    57\\t;; =============================================================================\\n    58\\t\\n    59\\t(def ^:private mnemonic-aliases\\n    60\\t  \\\"The §2.4 mnemonic → `vm/opcode-table` key mapping. Everything not here\\n    61\\t   decodes under its own name.\\\"\\n    62\\t  {:const :literal,\\n    63\\t   :var :load-var,\\n    64\\t   :closure :lambda,\\n    65\\t   :branch-false :branch,\\n    66\\t   :current-continuation :current-cont,\\n    67\\t   :ffi-call :dao.stream.apply/call})\\n    68\\t\\n    69\\t\\n    70\\t(defn- index-batch\\n    71\\t  \\\"Entity ids in order of first appearance, and each entity's attribute map.\\n    72\\t   A repeated single-valued attribute keeps its last value, as\\n    73\\t   `yin.vm.code` reads one.\\\"\\n    74\\t  [datoms]\\n    75\\t  (reduce (fn [[order attrs] [e a v]]\\n    76\\t            [(if (contains? attrs e) order (conj order e))\\n    77\\t             (assoc-in attrs [e a] v)])\\n    78\\t          [[] {}]\\n    79\\t          datoms))\\n    80\\t\\n    81\\t\\n    82\\t(defn load-image\\n    83\\t  \\\"Decode one `:yin.code/*` batch into an executable image.\\n    84\\t\\n    85\\t   Returns `{:segment id, :length n, :code instructions}` where `instructions`\\n    86\\t   is a vector indexed by pc of decoded `[opcode & operands]` vectors with\\n    87\\t   every `:yin.code/target` and `:yin.code/body` ref resolved to a pc integer\\n    88\\t   of the same segment, plus `:address` when the segment entity carries\\n    89\\t   `:yin.code/hash` (§2.2) — a claim checked here: the canonical vector the\\n    90\\t   batch reconstructs to must hash to it (UCF §7.3.4's content-integrity\\n    91\\t   check, its `:yin.k/hash-mismatch` outcome), so a false claim never\\n    92\\t   reaches the alias column. Throws a load error naming the entity and rule\\n    93\\t   wh