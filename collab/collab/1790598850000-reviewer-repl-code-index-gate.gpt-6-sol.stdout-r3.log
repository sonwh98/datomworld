{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/transactor.cljc | sed -n '65,260p'\"","aggregated_output":"    65\t    (mapv (fn [[a v]]\n    66\t            (let [d [e a v t datom/default-op]]\n    67\t              (when-not (datom/local-datom? d)\n    68\t                (throw (ex-info \"invalid persistent local datom\"\n    69\t                                {:datom d, :entity m})))\n    70\t              d))\n    71\t          (remove (fn [[a _v]] (= a :db/id)) m))))\n    72\t\n    73\t\n    74\t(defn- pad-datom\n    75\t  \"Pad [e a v] / [e a v t m] to the canonical 5-tuple. The transactor owns\n    76\t   transaction time: a non-nil explicit t is rejected, a nil t is stamped\n    77\t   with the allocated `t`. A nil m takes the default assertion op; an\n    78\t   explicit m (0, a retraction) is preserved.\"\n    79\t  [d t]\n    80\t  (let [[e a v dt dm] d]\n    81\t    (when-not (nil? dt)\n    82\t      (throw\n    83\t        (ex-info\n    84\t          \"the transactor owns transaction time: explicit datom t is rejected\"\n    85\t          {:datom d})))\n    86\t    (let [padded [e a v t (if (nil? dm) datom/default-op dm)]]\n    87\t      (when-not (datom/local-datom? padded)\n    88\t        (throw (ex-info \"invalid persistent local datom\"\n    89\t                        {:datom padded, :input d})))\n    90\t      padded)))\n    91\t\n    92\t\n    93\t(defn- val->datoms\n    94\t  [val t]\n    95\t  (cond\n    96\t    (map? val) (entity->datoms val t)\n    97\t    (and (vector? val) (<= 3 (count val) 5)) [(pad-datom val t)]\n    98\t    :else\n    99\t    (throw\n   100\t      (ex-info\n   101\t        \"a value must be an entity map or datom vector [e a v] / [e a v nil m]\"\n   102\t        {:val val}))))\n   103\t\n   104\t\n   105\t#_{:clj-kondo/ignore [:unused-binding]}\n   106\t\n   107\t\n   108\t(defn- with-write-lock\n   109\t  \"Serialize timestamp allocation and append on hosts with shared-memory\n   110\t   threads. ClojureScript and ClojureDart calls are synchronous within one\n   111\t   isolate, so the direct call has the same single-writer semantics.\"\n   112\t  [lock f]\n   113\t  #?(:clj (locking lock (f))\n   114\t     :default (f)))\n   115\t\n   116\t\n   117\t(defn- derive-next-t\n   118\t  \"Derive the next transaction time from a flattened retained history: 0 for\n   119\t   an empty history, else 1 + the maximum datom t. A datom t that is not a\n   120\t   non-negative integer is a malformed history and throws — this scan is the\n   121\t   causality boundary of the value.\"\n   122\t  [datoms]\n   123\t  (if (empty? datoms)\n   124\t    0\n   125\t    (let [ts (mapv index/datom-t datoms)]\n   126\t      (when-not (every? #(and (integer? %) (<= 0 %)) ts)\n   127\t        (throw\n   128\t          (ex-info\n   129\t            \"malformed retained history: datom t must be a non-negative integer\"\n   130\t            {:history datoms})))\n   131\t      (inc (reduce max ts)))))\n   132\t\n   133\t\n   134\t(defn- append-packet!\n   135\t  \"Append one atomic transaction record to the local stream. The answer is\n   136\t   validated with the contract's own validator before it is interpreted:\n   137\t   :dao.stream/ok advances the watermark and returns the v2 receipt; any\n   138\t   other conforming outcome is returned as data with the watermark\n   139\t   unchanged, so the same t is still pending and retrying the identical\n   140\t   call re-attempts it; a non-outcome answer is folded to\n   141\t   :dao.stream/transport-error with the raw answer retained under\n   142\t   :dao.stream/answer.\"\n   143\t  [local-stream next-t t datoms]\n   144\t  (let [record {:dao.space/transaction {:t t, :datoms datoms}}\n   145\t        answer (stream/append! local-stream record)]\n   146\t    (if-not (stream/valid-outcome? :append! answer)\n   147\t      {:dao.stream/outcome :dao.stream/transport-error\n   148\t       :dao.stream/answer answer}\n   149\t      (do (when (= :dao.stream/ok (:dao.stream/outcome answer))\n   150\t            (swap! next-t inc))\n   151\t          (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   152\t            {:dao.stream/outcome :dao.stream/ok\n   153\t             :dao.space/t t\n   154\t             :dao.space/datoms datoms}\n   155\t            answer)))))\n   156\t\n   157\t\n   158\t(defn create!\n   159\t  \"Create a transactor value from a spec — the value, or a throw: the\n   160\t   failure modes are a malformed spec and a malformed retained history,\n   161\t   both of which a caller can only abort on.\n   162\t\n   163\t   Validates surfaces, never retention (D2/T18): stream/reader? and\n   164\t   stream/writer? check the dao.stream reader and writer surfaces, and\n   165\t   neither establishes the complete-retention transport the history scan\n   166\t   requires. The host composition supplies a handle created by\n   167\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n   168\t   host-assembly defect — detectable, deliberately not checked, because a\n   169\t   type check would couple dao.space to memory-log by name and reject a\n   170\t   future correct complete-retention transport.\"\n   171\t  [spec]\n   172\t  (when-not (map? spec)\n   173\t    (throw\n   174\t      (ex-info\n   175\t        \"transactor spec must be a map\"\n   176\t        {:spec spec})))\n   177\t  (let [{:keys [local-stream intake-pool name]} spec]\n   178\t    (when (contains? spec :next-t)\n   179\t      (throw\n   180\t        (ex-info\n   181\t          \"the transactor derives transaction time from retained history; :next-t is not accepted\"\n   182\t          {:spec spec})))\n   183\t    (when-not (and (stream/reader? local-stream)\n   184\t                   (stream/writer? local-stream))\n   185\t      (throw\n   186\t        (ex-info\n   187\t          \"transactor spec requires a :local-stream satisfying the dao.stream reader and writer surfaces\"\n   188\t          {:spec spec})))\n   189\t    (when-not (and (coll? intake-pool) (seq intake-pool))\n   190\t      (throw\n   191\t        (ex-info\n   192\t          \"transactor spec requires a non-empty :intake-pool of streams satisfying the dao.stream writer surface\"\n   193\t          {:spec spec})))\n   194\t    (doseq [intake intake-pool]\n   195\t      (when-not (stream/writer? intake)\n   196\t        (throw\n   197\t          (ex-info\n   198\t            \"transactor :intake-pool members must satisfy IDaoStreamWriter\"\n   199\t            {:intake-pool intake-pool}))))\n   200\t    (let [t (derive-next-t (index/snapshot-datoms local-stream))]\n   201\t      {:dao.space/transactor true\n   202\t       :local-stream local-stream\n   203\t       :intake-pool intake-pool\n   204\t       :name (or name \"transactor\")\n   205\t       :next-t (atom t)\n   206\t       :state (atom {:closed false})})))\n   207\t\n   208\t\n   209\t(defn append!\n   210\t  \"Append one entity map or datom vector as a single atomic transaction.\n   211\t   Answers the v2 receipt on ok — {:dao.stream/outcome :dao.stream/ok\n   212\t   :dao.space/t t :dao.space/datoms datoms} — the local append's conforming\n   213\t   outcome as data otherwise (watermark unchanged, same t still pending),\n   214\t   and {:dao.stream/outcome :dao.stream/closed} on a closed transactor.\n   215\t   A malformed value still throws: it is a defect in the caller's own\n   216\t   argument, detected before any stream is touched.\"\n   217\t  [log val]\n   218\t  (let [{:keys [local-stream next-t state]} log]\n   219\t    (with-write-lock\n   220\t      next-t\n   221\t      (fn []\n   222\t        (if (:closed @state)\n   223\t          {:dao.stream/outcome :dao.stream/closed}\n   224\t          (let [t @next-t\n   225\t                datoms (val->datoms val t)]\n   226\t            (when (empty? datoms)\n   227\t              (throw (ex-info \"append! produced no datoms\" {:val val})))\n   228\t            (append-packet! local-stream next-t t datoms)))))))\n   229\t\n   230\t\n   231\t(defn transact!\n   232\t  \"Commits a non-empty collection of entity maps or datom vectors as a\n   233\t  single atomic transaction: every datom shares one allocated t and lands\n   234\t  in one transaction record through exactly one local append, so no partial\n   235\t  prefix is possible. Answers the v2 receipt on ok, the local append's\n   236\t  conforming outcome as data otherwise, and\n   237\t  {:dao.stream/outcome :dao.stream/closed} on a closed transactor. Throws\n   238\t  when the collection is empty, any item is invalid, or the expansion\n   239\t  yields no datoms.\"\n   240\t  [log tx-data]\n   241\t  (when (empty? tx-data)\n   242\t    (throw (ex-info \"transact! requires at least one transaction item\"\n   243\t                    {:tx-data tx-data})))\n   244\t  (let [{:keys [local-stream next-t state]} log]\n   245\t    (with-write-lock\n   246\t      next-t\n   247\t      (fn []\n   248\t        (if (:closed @state)\n   249\t          {:dao.stream/outcome :dao.stream/closed}\n   250\t          (let [t @next-t\n   251\t                datoms (into [] (mapcat #(val->datoms % t)) tx-data)]\n   252\t            (when (empty? datoms)\n   253\t              (throw (ex-info \"transact! produced no datoms\" {:tx-data tx-data})))\n   254\t            (append-packet! local-stream next-t t datoms)))))))\n   255\t\n   256\t\n   257\t(defn close!\n   258\t  \"Close this transactor value: further append!/transact! answer\n   259\t   {:dao.stream/outcome :dao.stream/closed} rather than throwing. Per\n   260\t   value — neither the local stream nor the intake pool is closed or\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/repl/index.cljc'","aggregated_output":"     1\t(ns yin.repl.index\n     2\t  \"The shell's code indexer: a `dao.space.index` observer on `program-out`\n     3\t   (docs/design/yin.repl.dao.space-index.md).\n     4\t\n     5\t   It is a peer of the evaluator's observer on the same medium, attached\n     6\t   independently and advanced by the evaluation round, never by the\n     7\t   evaluator: neither knows the other.  Each expanded tree packet `[root\n     8\t   rows]` it observes is projected to local `[e a v t m]` AST facts\n     9\t   (yin.vm.code-as-tuples.md §6.5) and committed as ONE atomic transaction\n    10\t   record through a `dao.space.transactor`, which allocates `t`; this\n    11\t   namespace supplies no clock.  After a round that committed, the covered\n    12\t   indexes are published through `transactor/publish!` into that round's\n    13\t   own fresh intake, the intake is drained into the `dao.jing` store, the\n    14\t   manifest is read back, and the intake is dropped: between rounds the\n    15\t   indexer retains its local transaction log and nothing of any\n    16\t   publication.\n    17\t\n    18\t   Cost, accepted as the price of the owner's every-round cadence\n    19\t   (2026-09-28): each publication rebuilds the covered indexes over the\n    20\t   whole retained history, and opening the round's transactor rescans\n    21\t   that history to derive `t`, so a round's index time grows linearly with\n    22\t   the session's committed code and a session's total grows\n    23\t   quadratically.  Memory does not: at most one publication is held, and\n    24\t   only during its round.  An incremental publish in `dao.space.index`\n    25\t   would remove the time growth; nothing here would need to change but\n    26\t   the call.\n    27\t\n    28\t   Every `e` is a transactor-local entity id; the only durable name in the\n    29\t   projection is the `:yin/address` fact each node occurrence carries back\n    30\t   to its row address.  `m` is a local metadata entity, one per program,\n    31\t   carrying `:db/op`, the shell's stable session token, the program's root\n    32\t   address, and the round.  Only code is indexed: no printed output, last\n    33\t   value, or evaluation result enters.\n    34\t\n    35\t   Loss is reported, never hidden, and never stops the evaluator (owner\n    36\t   ruling, 2026-09-28): a gap is counted on the observer (`:ingress-gaps`)\n    37\t   and marks the indexer `:lost?`, after which it consumes packets without\n    38\t   indexing any until reset rebuilds it; a packet that could not be\n    39\t   committed, or a publication that did not become readable, is recorded\n    40\t   under `:failure`, never counted as indexed.  `notice` renders what a\n    41\t   round lost for the shell's round result, and `status` is the\n    42\t   evaluator-independent view `repl-state` reports.  Everything here is a\n    43\t   session-composition value; reset and VM selection rebuild it with the\n    44\t   session.\"\n    45\t  (:require [dao.datom :as datom]\n    46\t            [dao.jing :as jing]\n    47\t            [dao.space.index :as index]\n    48\t            [dao.space.transactor :as transactor]\n    49\t            [dao.stream :as stream]\n    50\t            [dao.stream.memory-log :as memory-log]\n    51\t            [dao.stream.observer :as observer]\n    52\t            [yin.vm :as vm]\n    53\t            [yin.vm.macro :as macro]))\n    54\t\n    55\t\n    56\t;; =============================================================================\n    57\t;; The §6.5 projection\n    58\t;; =============================================================================\n    59\t\n    60\t(defn- assign-local-ids\n    61\t  \"Give every node occurrence of `node`, the map AST rebuilt from row `id`,\n    62\t   a fresh local entity id as its `:eid`, pairing it with its row through\n    63\t   the §2.3 slot table.  Distinct occurrences of one shared row get distinct\n    64\t   ids, so `vm/ast->datoms` emits every occurrence exactly as it does for a\n    65\t   tree without `:eid`s.  `acc` is `[next-e addresses]`; answers\n    66\t   `[node' acc']`, `addresses` mapping each id to its row address.\"\n    67\t  [rows node id [next-e addresses]]\n    68\t  (let [row (get rows id)\n    69\t        slots (get vm/semantic-bytecode-grammar (:type node))\n    70\t        child (fn [acc child-node child-id]\n    71\t                (assign-local-ids rows child-node child-id acc))]\n    72\t    (reduce\n    73\t      (fn [[node acc] [i [field kind]]]\n    74\t        (let [slot (nth row (+ 2 i))]\n    75\t          (case kind\n    76\t            :node (let [[c acc'] (child acc (get node field) slot)]\n    77\t                    [(assoc node field c) acc'])\n    78\t            :nodes (let [[cs acc']\n    79\t                         (reduce (fn [[cs acc] [c cid]]\n    80\t                                   (let [[c' acc'] (child acc c cid)]\n    81\t                                     [(conj cs c') acc']))\n    82\t                                 [[] acc]\n    83\t                                 (map vector (get node field) slot))]\n    84\t                     [(assoc node field cs) acc'])\n    85\t            [node acc])))\n    86\t      [(assoc node :eid next-e) [(inc next-e) (assoc addresses next-e id)]]\n    87\t      (map-indexed vector slots))))\n    88\t\n    89\t\n    90\t(defn packet->tx-data\n    91\t  \"Project one expanded tree packet to transactor tx-data, allocating local\n    92\t   entity ids from `next-e`.  `provenance` is `{:session-token s :round r}`.\n    93\t\n    94\t   Answers `{:tx-data [...] :next-e n :meta-e m :root root}`: the metadata\n    95\t   entity's facts, then `vm/ast->datoms` of the expanded tree under `m`,\n    96\t   then one `[e :yin/address addr]` per node occurrence.  Every datom leaves\n    97\t   `t` nil, which the transactor stamps.\"\n    98\t  [packet next-e {:keys [session-token round]}]\n    99\t  (let [{:keys [root rows], :as row-set} (macro/packet->row-set packet)\n   100\t        meta-e next-e\n   101\t        [ast [next-e' addresses]] (assign-local-ids\n   102\t                                    rows\n   103\t                                    (vm/semantic-bytecode->ast row-set)\n   104\t                                    root\n   105\t                                    [(inc meta-e) {}])\n   106\t        facts (vm/ast->datoms ast {:m meta-e})\n   107\t        untimed (fn [e a v m] [e a v nil m])]\n   108\t    (when-let [stray (some (fn [[e]] (when (neg? e) e)) facts)]\n   109\t      (throw (ex-info \"projected node escaped local id assignment\"\n   110\t                      {:e stray, :root root})))\n   111\t    {:tx-data (-> [(untimed meta-e :db/op :db/assert datom/default-op)\n   112\t                   (untimed meta-e :yin.repl/session session-token\n   113\t                            datom/default-op)\n   114\t                   (untimed meta-e :yin.repl/root root datom/default-op)\n   115\t                   (untimed meta-e :yin.repl/round round datom/default-op)]\n   116\t                  (into (map (fn [[e a v _t m]] (untimed e a v m))) facts)\n   117\t                  (into (map (fn [[e addr]]\n   118\t                               (untimed e :yin/address addr meta-e)))\n   119\t                        (sort-by key addresses))),\n   120\t     :next-e next-e',\n   121\t     :meta-e meta-e,\n   122\t     :root root}))\n   123\t\n   124\t\n   125\t;; =============================================================================\n   126\t;; The indexer value\n   127\t;; =============================================================================\n   128\t\n   129\t(defn- memory-log\n   130\t  []\n   131\t  (:dao.stream/handle\n   132\t    (memory-log/create! {:dao.stream/type memory-log/transport-type})))\n   133\t\n   134\t\n   135\t(defn make-indexer\n   136\t  \"The indexer for one session: `observer`, attached to `program-out`\n   137\t   beside the evaluator's; `:local`, the complete-retention log its\n   138\t   transactions are committed to (dao.space.transactor requires memory-log\n   139\t   retention); and `content-store`, the `dao.jing` byte store publications\n   140\t   materialize into.  `session-token` is the shell's stable token, recorded\n   141\t   as provenance; `publish-opts` reach `transactor/publish!` as-is.\n   142\t\n   143\t   Between rounds that is all it holds.  A round that has code to commit\n   144\t   opens its `:publication` — a transactor over `:local` whose intake pool\n   145\t   is one fresh complete-retention intake — and drops it when the round\n   146\t   ends, so no earlier publication's payloads stay reachable from the\n   147\t   indexer (see `step`).\"\n   148\t  [{:keys [observer session-token content-store publish-opts]}]\n   149\t  {:observer observer\n   150\t   :local (memory-log)\n   151\t   :content-store content-store\n   152\t   :session-token session-token\n   153\t   :publish-opts publish-opts\n   154\t   :next-e datom/first-user-id\n   155\t   :transactions 0\n   156\t   :published 0\n   157\t   :published-payloads 0\n   158\t   :manifest-address nil\n   159\t   :lost? false\n   160\t   :failure nil})\n   161\t\n   162\t\n   163\t(defn- open-publication\n   164\t  \"The round's transactor and the `dao.jing` pool observer over its intake.\n   165\t   `transactor/create!` derives the next `t` from `:local`'s retained\n   166\t   history, so transaction time continues across rounds.  The intake is\n   167\t   complete-retention: `publish-index!` appends every node blob before the\n   168\t   manifest and the round drains only after it returns, so an evicting\n   169\t   intake would lose the head of any publication larger than its capacity\n   170\t   and that publication could never complete.\"\n   171\t  [ix]\n   172\t  (if (:publication ix)\n   173\t    ix\n   174\t    (let [intake (memory-log)]\n   175\t      (assoc ix\n   176\t             :publication\n   177\t             {:transactor (transactor/create! {:local-stream (:local ix)\n   178\t                                               :intake-pool [intake]\n   179\t                                               :name \"yin.repl.index\"})\n   180\t              :pool (jing/observer-state\n   181\t                      [{:stream intake\n   182\t                        :cursor (:dao.stream/cursor\n   183\t                                  (stream/cursor intake\n   184\t                                                 :dao.stream/oldest))}])}))))\n   185\t\n   186\t\n   187\t(defn- commit\n   188\t  \"Commit one packet as one transaction.  A packet that could not be\n   189\t   projected or committed is consumed and recorded as the failure, never\n   190\t   counted.\"\n   191\t  [ix packet round]\n   192\t  (try\n   193\t    (let [{:keys [tx-data next-e root]}\n   194\t          (packet->tx-data packet\n   195\t                           (:next-e ix)\n   196\t                           {:session-token (:session-token ix), :round round})\n   197\t          answer (transactor/transact! (get-in ix [:publication :transactor])\n   198\t                                       tx-data)]\n   199\t      (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   200\t        [(-> ix\n   201\t             (assoc :next-e next-e)\n   202\t             (update :transactions inc))\n   203\t         true]\n   204\t        [(assoc ix\n   205\t                :failure {:round round\n   206\t                          :root root\n   207\t                          :stage :transact\n   208\t                          :outcome (:dao.stream/outcome answer)})\n   209\t         false]))\n   210\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   211\t      [(assoc ix\n   212\t              :failure {:round round\n   213\t                        :stage :project\n   214\t                        :message (ex-message e)})\n   215\t       false])))\n   216\t\n   217\t\n   218\t(defn- materialize\n   219\t  \"Drain the intake into the store until it blocks.  Answers how many\n   220\t   payloads it materialized and, when the drain met a gap or a defect, what\n   221\t   it met.  The pool is not kept: its intake is dropped with the round.\"\n   222\t  [content-store pool]\n   223\t  (loop [pool pool\n   224\t         n 0]\n   225\t    (let [{:keys [signal], :as r} (jing/observe-step! content-store pool)]\n   226\t      (case signal\n   227\t        :dao.stream/ok (recur (:state r) (inc n))\n   228\t        :dao.stream/blocked [n nil]\n   229\t        [n signal]))))\n   230\t\n   231\t\n   232\t(defn- publish\n   233\t  \"Publish the covered indexes over every committed transaction through\n   234\t   the round's transactor, drain its intake into the store, and read the\n   235\t   manifest back from it.  Only a publication whose manifest the store\n   236\t   answers becomes the reported one, covering `:published` transactions.\"\n   237\t  [ix round]\n   238\t  (try\n   239\t    (let [{:keys [transactor pool]} (:publication ix)\n   240\t          {:keys [manifest-address]} (transactor/publish! transactor\n   241\t                                                          (:publish-opts ix))\n   242\t          [n defect] (materialize (:content-store ix) pool)]\n   243\t      (if defect\n   244\t        (assoc ix :failure {:round round :stage :materialize :outcome defect})\n   245\t        (do (index/read-manifest (:content-store ix) manifest-address)\n   246\t            (assoc ix\n   247\t                   :manifest-address manifest-address\n   248\t                   :published (:transactions ix)\n   249\t                   :published-payloads n))))\n   250\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   251\t      (assoc ix\n   252\t             :failure {:round round :stage :publish :message (ex-message e)}))))\n   253\t\n   254\t\n   255\t(defn- consume\n   256\t  \"Advance the observer past every packet still on the medium, handing each\n   257\t   to `f` with the indexer; a gap marks the indexer lost, after which no\n   258\t   packet reaches `f`.\"\n   259\t  [indexer f]\n   260\t  (loop [ix indexer]\n   261\t    (let [{:keys [status batch] observer' :observer}\n   262\t          (observer/observe-next (:observer ix))\n   263\t          ix (assoc ix :observer observer')]\n   264\t      (case status\n   265\t        :ok (recur (if (:lost? ix) ix (f ix batch)))\n   266\t        :gap (recur (assoc ix :lost? true))\n   267\t        ix))))\n   268\t\n   269\t\n   270\t(defn step\n   271\t  \"The round's index step: observe every packet `program-out` still holds\n   272\t   for this observer, commit each through the round's publication, publish\n   273\t   when any was committed, then drop the publication — its transactor,\n   274\t   intake, and pool — so the indexer carries none of this round's payloads\n   275\t   into the next.  A gap is recovered across, counted on the observer's\n   276\t   `:ingress-gaps`, and marks the indexer lost: the missing packet and\n   277\t   every later one are never called indexed.\"\n   278\t  [indexer round]\n   279\t  (let [ix (consume indexer\n   280\t                    (fn [ix packet]\n   281\t                      (first (commit (open-publication ix) packet round))))]\n   282\t    (dissoc (if (> (:transactions ix) (:transactions indexer))\n   283\t              (publish ix round)\n   284\t              ix)\n   285\t            :publication)))\n   286\t\n   287\t\n   288\t(defn skip\n   289\t  \"Advance the observer past every packet still on the medium without\n   290\t   indexing it: a round that threw before its program ran executes nothing,\n   291\t   so nothing is indexed.  A gap still marks the indexer lost.\"\n   292\t  [indexer]\n   293\t  (consume indexer (fn [ix _packet] ix)))\n   294\t\n   295\t\n   296\t(defn status\n   297\t  \"The indexer's state as the shell reports it.  It depends on the programs\n   298\t   evaluated, never on which evaluator ran them or on the shell's token,\n   299\t   so every VM reports the same status for the same inputs.\"\n   300\t  [indexer]\n   301\t  {:transactions (:transactions indexer)\n   302\t   :published? (and (some? (:manifest-address indexer))\n   303\t                    (= (:published indexer) (:transactions indexer)))\n   304\t   :lost? (:lost? indexer)\n   305\t   :gaps (:ingress-gaps (:observer indexer) 0)\n   306\t   :failure (:failure indexer)})\n   307\t\n   308\t\n   309\t(defn notice\n   310\t  \"What the round from `before` to `after` must tell the user, or nil: a\n   311\t   lost indexer (the round's code was not indexed), or a new failure (the\n   312\t   round's code was not committed or its publication is not readable).\n   313\t   A failure's `:stage` is `:project`, `:transact`, `:materialize` or\n   314\t   `:publish`.\"\n   315\t  [before after]\n   316\t  (let [{:keys [stage outcome message]} (:failure after)]\n   317\t    (cond\n   318\t      (:lost? after)\n   319\t      (str \"Warning: the code index lost a program batch; this round's code\"\n   320\t           \" was not indexed, and indexing is suspended until (reset)\")\n   321\t\n   322\t      (not= (:failure before) (:failure after))\n   323\t      (str \"Warning: this round's code is not in the published code index (\"\n   324\t           (name stage) \" failed\"\n   325\t           (when-let [detail (or message (some-> outcome name))]\n   326\t             (str \": \" detail))\n   327\t           \")\"))))\n","exit_code":0,"status":"completed"}}
