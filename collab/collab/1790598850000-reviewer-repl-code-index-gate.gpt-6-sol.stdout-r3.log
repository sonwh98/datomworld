{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/repl/index_test.cljc | sed -n '1,390p'\"","aggregated_output":"     1\t(ns yin.repl.index-test\n     2\t  \"The shell's code indexer (docs/design/yin.repl.dao.space-index.md): a\n     3\t   dao.space.index observer on program-out, one transaction per forwarded\n     4\t   program, covered indexes published into dao.jing each round.\"\n     5\t  (:require [clojure.string :as str]\n     6\t            [clojure.test :refer [deftest is testing]]\n     7\t            [dao.space.index :as index]\n     8\t            [dao.space.query :as query]\n     9\t            [dao.stream :as stream]\n    10\t            [dao.stream.observer :as observer]\n    11\t            [dao.stream.ringbuffer :as ring]\n    12\t            [yin.repl :as repl]\n    13\t            [yin.repl.index :as repl.index]\n    14\t            [yin.vm :as vm]\n    15\t            [yin.vm.macro :as macro]))\n    16\t\n    17\t\n    18\t(defn- stream-values\n    19\t  \"Every value currently on a stream, read from its oldest cursor.\"\n    20\t  [s]\n    21\t  (loop [cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n    22\t         acc []]\n    23\t    (let [r (stream/next s cursor)]\n    24\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    25\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    26\t        acc))))\n    27\t\n    28\t\n    29\t(defn- transactions\n    30\t  \"The atomic transaction records the session's indexer committed.\"\n    31\t  [state]\n    32\t  (mapv :dao.space/transaction\n    33\t        (stream-values (get-in state [:indexer :local]))))\n    34\t\n    35\t\n    36\t(defn- evaluate\n    37\t  [state lines]\n    38\t  (reduce (fn [[state texts] line]\n    39\t            (let [[state' text] (repl/eval-input state line)]\n    40\t              [state' (conj texts text)]))\n    41\t          [state []]\n    42\t          lines))\n    43\t\n    44\t\n    45\t(def ^:private ref-attrs\n    46\t  (into #{}\n    47\t        (keep (fn [[a spec]] (when (= :db.type/ref (:db/valueType spec)) a)))\n    48\t        vm/schema))\n    49\t\n    50\t\n    51\t(defn- modulo-ids\n    52\t  \"`[e a v]` of `datoms` with entity ids relabelled by first appearance, so\n    53\t   two projections of one tree compare equal whatever ids they minted.\"\n    54\t  [datoms]\n    55\t  (let [ids (into {}\n    56\t                  (map-indexed (fn [i e] [e i]))\n    57\t                  (distinct (map first datoms)))\n    58\t        relabel (fn [a v]\n    59\t                  (cond (not (contains? ref-attrs a)) v\n    60\t                        (vector? v) (mapv ids v)\n    61\t                        :else (ids v)))]\n    62\t    (mapv (fn [[e a v]] [(ids e) a (relabel a v)]) datoms)))\n    63\t\n    64\t\n    65\t(deftest one-program-is-one-transaction-of-its-expanded-projection\n    66\t  (let [state (repl/create-state)\n    67\t        [state' result] (repl/eval-input state \"(+ 1 2)\")\n    68\t        [packet] (stream-values (:row-stream state'))\n    69\t        root (first packet)\n    70\t        rows (:rows (macro/packet->row-set packet))\n    71\t        txs (transactions state')\n    72\t        {:keys [t datoms]} (first txs)\n    73\t        meta-e (some (fn [[e a]] (when (= :db/op a) e)) datoms)\n    74\t        meta-facts (filterv #(= meta-e (first %)) datoms)\n    75\t        addresses (filterv #(= :yin/address (second %)) datoms)\n    76\t        ast-facts (filterv #(and (not= meta-e (first %))\n    77\t                                 (not= :yin/address (second %)))\n    78\t                           datoms)]\n    79\t    (is (= \"3\" result) \"the evaluator's answer is unchanged\")\n    80\t    (is (= 1 (count txs)) \"exactly one transaction for the program\")\n    81\t    (testing \"its datoms are ast->datoms of the expanded tree, modulo ids\"\n    82\t      (is (= (modulo-ids (vm/ast->datoms (vm/semantic-bytecode->ast\n    83\t                                           (macro/packet->row-set packet))))\n    84\t             (modulo-ids ast-facts))))\n    85\t    (testing \"the transactor allocated t; every datom carries it\"\n    86\t      (is (integer? t))\n    87\t      (is (every? #(= t (nth % 3)) datoms)))\n    88\t    (testing \"e is transactor-local, with :yin/address back to the row\"\n    89\t      (is (every? #(and (integer? (first %)) (<= 16 (first %))) datoms))\n    90\t      (is (= (set (map first ast-facts)) (set (map first addresses)))\n    91\t          \"every node occurrence carries exactly one address fact\")\n    92\t      (is (= (count addresses) (count (set (map first addresses)))))\n    93\t      (is (every? #(contains? rows (nth % 2)) addresses))\n    94\t      (let [root-e (some (fn [[e a]] (when (= :yin/root a) e)) ast-facts)]\n    95\t        (is (some #(= [root-e :yin/address root] (subvec % 0 3)) addresses)\n    96\t            \"the root occurrence names the program's content address\")))\n    97\t    (testing \"m is a local metadata entity carrying the session provenance\"\n    98\t      (is (integer? meta-e))\n    99\t      (is (every? #(= meta-e (nth % 4)) (concat ast-facts addresses)))\n   100\t      (is (= {:db/op :db/assert\n   101\t              :yin.repl/session (:shell-token state)\n   102\t              :yin.repl/root root\n   103\t              :yin.repl/round 1}\n   104\t             (into {} (map (fn [[_ a v]] [a v])) meta-facts))))\n   105\t    (testing \"only code is indexed: no result or printed output\"\n   106\t      (is (not-any? #(= 3 (nth % 2))\n   107\t                    (filter #(= :yin/value (second %)) ast-facts))\n   108\t          \"the literal operands are 1 and 2; the result 3 appears nowhere\")\n   109\t      (is (= #{1 2}\n   110\t             (set (keep (fn [[_ a v]] (when (= :yin/value a) v)) ast-facts)))))))\n   111\t\n   112\t\n   113\t(deftest the-round-publishes-covered-indexes-readable-from-dao-jing\n   114\t  (let [[state _] (evaluate (repl/create-state)\n   115\t                            [\"(def inc2 (fn [x] (+ x 2)))\" \"(inc2 40)\"])\n   116\t        {:keys [manifest-address content-store]} (:indexer state)\n   117\t        committed (into #{} (mapcat :datoms) (transactions state))]\n   118\t    (is (some? manifest-address))\n   119\t    (is (identical? content-store (:index-store state))\n   120\t        \"publication lands in the shell's dao.jing store\")\n   121\t    (testing \"the manifest's EAVT index holds every committed datom\"\n   122\t      (is (= 2 (count (transactions state))))\n   123\t      (is (= committed (set (index/read-datoms content-store manifest-address)))))\n   124\t    (testing \"each restored covered index holds the committed facts\"\n   125\t      (let [manifest (index/read-manifest content-store manifest-address)\n   126\t            restored (index/restored-indexes content-store manifest)]\n   127\t        (doseq [k [:eavt :aevt :avet :vaet]]\n   128\t          (is (= committed (set (seq (get restored k)))) (str k)))))\n   129\t    (testing \"the datoms read back from the store answer queries\"\n   130\t      (let [published (query/relation\n   131\t                        (index/read-datoms content-store manifest-address))\n   132\t            names (query/collect\n   133\t                    (query/q '[:find ?name\n   134\t                               :where [$ ?e :yin/type :variable]\n   135\t                               [$ ?e :yin/name ?name]]\n   136\t                             (query/current published)))\n   137\t            sessions (query/collect\n   138\t                       ;; the history view exposes m; current binds [e a v]\n   139\t                       (query/q '[:find ?session ?round\n   140\t                                  :where [?e :yin/root true ?t ?m]\n   141\t                                  [?m :yin.repl/session ?session ?t1 ?m1]\n   142\t                                  [?m :yin.repl/round ?round ?t2 ?m2]]\n   143\t                                (query/history published)))]\n   144\t        (is (every? (set (map first names)) '[yin/def x + inc2]))\n   145\t        (is (= #{[(:shell-token state) 1] [(:shell-token state) 2]}\n   146\t               (set sessions))\n   147\t            \"each program's root reaches its provenance through m\")))))\n   148\t\n   149\t\n   150\t(deftest failed-expansions-add-nothing-raising-and-parking-programs-are-indexed\n   151\t  (testing \"a failed expansion forwards nothing, so nothing is committed\"\n   152\t    (let [[state [defined failed]]\n   153\t          (evaluate (repl/create-state)\n   154\t                    [\"(defmacro unless [c a b] (yin/if c b a))\"\n   155\t                     \"(unless 1 2)\"])]\n   156\t      (is (not (str/starts-with? defined \"Error\")))\n   157\t      (is (str/starts-with? failed \"Error: Macro expansion failed\"))\n   158\t      (is (= 1 (count (transactions state)))\n   159\t          \"only the defmacro program was committed\")))\n   160\t  (testing \"a program whose VM raises is still indexed\"\n   161\t    (let [[state [raised]] (evaluate (repl/create-state) [\"(nope 1)\"])]\n   162\t      (is (str/starts-with? raised \"Error: \"))\n   163\t      (is (= 1 (count (transactions state))))\n   164\t      (is (some? (get-in state [:indexer :manifest-address])))))\n   165\t  (testing \"a program whose VM parks is still indexed\"\n   166\t    (let [[state [text]] (evaluate (repl/create-state {:vm-type :stack})\n   167\t                                   [\"(require (quote mod))\"])]\n   168\t      (is (str/includes? text \"pending\"))\n   169\t      (is (some? (:pending-run state)))\n   170\t      (is (= 1 (count (transactions state)))))))\n   171\t\n   172\t\n   173\t(deftest every-evaluator-is-indexed-the-same-way\n   174\t  (doseq [vm-type (keys repl/vm-constructors)]\n   175\t    (testing (str vm-type)\n   176\t      (let [[state [text]] (evaluate (repl/create-state {:vm-type vm-type})\n   177\t                                     [\"(+ 1 2)\"])]\n   178\t        (is (= \"3\" text))\n   179\t        (is (= 1 (count (transactions state))))))))\n   180\t\n   181\t\n   182\t(defn- small-medium\n   183\t  \"A ring medium of `capacity` and an observer attached at its oldest\n   184\t   position, as make-session composes program-out.\"\n   185\t  [capacity]\n   186\t  (let [writer (:dao.stream/handle\n   187\t                 (ring/create! {:dao.stream/type ring/transport-type\n   188\t                                ring/capacity-key capacity}))\n   189\t        descriptor (:dao.stream/descriptor (stream/descriptor writer))\n   190\t        attach! (ring/make-attacher {(:dao.stream/identity descriptor) writer})]\n   191\t    {:writer writer\n   192\t     :observer (observer/attach attach! descriptor)}))\n   193\t\n   194\t\n   195\t(defn- committed-values\n   196\t  \"The literal values of every program the indexer committed.\"\n   197\t  [indexer]\n   198\t  (into #{}\n   199\t        (comp (map :dao.space/transaction)\n   200\t              (mapcat :datoms)\n   201\t              (keep (fn [[_ a v]] (when (= :yin/value a) v))))\n   202\t        (stream-values (:local indexer))))\n   203\t\n   204\t\n   205\t(defn- literal-packet\n   206\t  [v]\n   207\t  (macro/ast->packet {:type :literal, :value v}))\n   208\t\n   209\t\n   210\t(deftest a-gap-on-the-index-reader-loses-the-indexer-until-rebuilt\n   211\t  (let [{:keys [writer observer]} (small-medium 2)\n   212\t        indexer (repl.index/make-indexer\n   213\t                  {:observer observer\n   214\t                   :session-token \"token\"\n   215\t                   :content-store (:index-store (repl/create-state))})\n   216\t        _ (stream/append! writer (literal-packet 1))\n   217\t        indexed (repl.index/step indexer 1)\n   218\t        _ (doseq [v [2 3 4]] (stream/append! writer (literal-packet v)))\n   219\t        lost (repl.index/step indexed 2)\n   220\t        _ (stream/append! writer (literal-packet 5))\n   221\t        still-lost (repl.index/step lost 3)]\n   222\t    (is (= {:transactions 1 :published? true :lost? false :gaps 0 :failure nil}\n   223\t           (repl.index/status indexed)))\n   224\t    (testing \"the gap is counted and marks the indexer lost\"\n   225\t      (is (= 1 (:gaps (repl.index/status lost))))\n   226\t      (is (true? (:lost? (repl.index/status lost))))\n   227\t      (is (= #{1} (committed-values lost))\n   228\t          \"neither the evicted packet nor the retained ones after it are called indexed\"))\n   229\t    (testing \"nothing further is indexed while lost\"\n   230\t      (is (= 1 (:transactions (repl.index/status still-lost))))\n   231\t      (is (= #{1} (committed-values still-lost)))\n   232\t      (is (some? (repl.index/notice lost still-lost))\n   233\t          \"every round while lost says its code was not indexed\"))))\n   234\t\n   235\t\n   236\t(deftest no-earlier-publication-is-retained-between-rounds\n   237\t  (let [held-keys #{:observer :local :content-store :session-token\n   238\t                    :publish-opts :next-e :transactions :published\n   239\t                    :published-payloads :manifest-address :lost? :failure}\n   240\t        rounds (reductions\n   241\t                 (fn [[state _] line] (repl/eval-input state line))\n   242\t                 [(repl/create-state) nil]\n   243\t                 [\"(+ 1 2)\" \"(def f (fn [x] (* x x)))\" \"(f 7)\" \"(+ 40 2)\"])]\n   244\t    (doseq [[i [state _]] (map-indexed vector (rest rounds))\n   245\t            :let [ix (:indexer state)\n   246\t                  records (stream-values (:local ix))]]\n   247\t      (testing (str \"after round \" (inc i))\n   248\t        (is (= held-keys (set (keys ix)))\n   249\t            \"no transactor, intake, or pool outlives its round\")\n   250\t        (is (every? #(contains? % :dao.space/transaction) records)\n   251\t            \"the local log holds transaction records only, no publication payload\")\n   252\t        (is (= (inc i) (count records)))\n   253\t        (is (true? (:published? (repl.index/status ix))))\n   254\t        (is (pos? (:published-payloads ix))\n   255\t            \"the round did publish; its payloads went to dao.jing, not the indexer\")))\n   256\t    (testing \"transaction time continues across per-round transactors\"\n   257\t      (let [ix (:indexer (first (last rounds)))]\n   258\t        (is (= [0 1 2 3]\n   259\t               (mapv (comp :t :dao.space/transaction)\n   260\t                     (stream-values (:local ix)))))))))\n   261\t\n   262\t\n   263\t(deftest a-publication-beyond-the-old-intake-bound-completes\n   264\t  (let [{:keys [writer observer]} (small-medium 16)\n   265\t        store (:index-store (repl/create-state))\n   266\t        indexer (repl.index/make-indexer\n   267\t                  {:observer observer\n   268\t                   :session-token \"token\"\n   269\t                   :content-store store\n   270\t                   ;; a small branching factor makes many node blobs\n   271\t                   :publish-opts {:branching-factor 4}})\n   272\t        program (fn [base]\n   273\t                  (macro/ast->packet\n   274\t                    {:type :application\n   275\t                     :operator {:type :variable, :name '+}\n   276\t                     :operands (mapv (fn [i] {:type :literal, :value (+ base i)})\n   277\t                                     (range 300))}))\n   278\t        _ (doseq [base [0 1000 2000 3000]]\n   279\t            (stream/append! writer (program base)))\n   280\t        ix (repl.index/step indexer 1)\n   281\t        committed (into #{}\n   282\t                        (mapcat (comp :datoms :dao.space/transaction))\n   283\t                        (stream-values (:local ix)))\n   284\t        address (:manifest-address ix)]\n   285\t    (is (< 4096 (:published-payloads ix))\n   286\t        \"one publication exceeds the old 4096-payload ring intake\")\n   287\t    (is (= {:transactions 4 :published? true :lost? false :gaps 0 :failure nil}\n   288\t           (repl.index/status ix)))\n   289\t    (is (= (count committed) (:count (index/read-manifest store address))))\n   290\t    (is (= committed (set (index/read-datoms store address)))\n   291\t        \"the manifest and every node blob are read back from the store\")))\n   292\t\n   293\t\n   294\t(deftest a-publication-failure-is-reported-in-the-round-and-repl-state\n   295\t  (let [broken {:put-bytes-fn (fn [_address _bytes]\n   296\t                                (throw (ex-info \"store refused the write\" {})))\n   297\t                :get-bytes-fn (fn [_address not-found] not-found)}\n   298\t        [state [text again]] (evaluate (repl/create-state {:index-store broken})\n   299\t                                       [\"(+ 1 2)\" \"(+ 2 3)\"])\n   300\t        status (get-in (repl/repl-state state) [:index])]\n   301\t    (is (str/starts-with? text \"3\\nWarning: \"))\n   302\t    (is (str/includes? text \"publish failed: store refused the write\"))\n   303\t    (is (str/starts-with? again \"5\\nWarning: \")\n   304\t        \"each round whose code is not published says so\")\n   305\t    (is (= 2 (:transactions status)) \"the transactions were committed\")\n   306\t    (is (false? (:published? status)))\n   307\t    (is (= :publish (get-in status [:failure :stage])))\n   308\t    (is (false? (:lost? status)))))\n   309\t\n   310\t\n   311\t(deftest an-index-gap-is-reported-evaluation-continues-and-reset-recovers\n   312\t  (let [{:keys [writer observer]} (small-medium 1)\n   313\t        state (repl/create-state)\n   314\t        _ (doseq [v [1 2]] (stream/append! writer (literal-packet v)))\n   315\t        lossy (assoc-in state [:indexer :observer] observer)\n   316\t        [lost text] (repl/eval-input lossy \"(+ 1 2)\")\n   317\t        [later text'] (repl/eval-input lost \"(+ 2 3)\")]\n   318\t    (testing \"the gap is reported in the round result; evaluation continues\"\n   319\t      (is (str/starts-with? text \"3\\nWarning: \"))\n   320\t      (is (str/includes? text \"(reset)\"))\n   321\t      (is (false? (:ingress-loss? lost)) \"the evaluator is not refused\")\n   322\t      (is (= 0 (get-in (repl/repl-state lost) [:vm :in-stream :gaps]))\n   323\t          \"the evaluator's own readers lost nothing\"))\n   324\t    (testing \"the indexer is lost, and says so, until reset\"\n   325\t      (is (= {:transactions 0 :published? false :lost? true :gaps 1 :failure nil}\n   326\t             (get-in (repl/repl-state lost) [:index])))\n   327\t      (is (str/starts-with? text' \"5\\nWarning: \"))\n   328\t      (is (= 0 (get-in (repl/repl-state later) [:index :transactions]))))\n   329\t    (testing \"reset rebuilds the observer with the session\"\n   330\t      (let [[fresh message] (repl/eval-input later \"(reset)\")\n   331\t            [indexed result] (repl/eval-input fresh \"(+ 1 2)\")]\n   332\t        (is (= \"SemanticVM reset\" message))\n   333\t        (is (not (identical? (:indexer later) (:indexer fresh))))\n   334\t        (is (= {:transactions 0 :published? false :lost? false :gaps 0\n   335\t                :failure nil}\n   336\t               (get-in (repl/repl-state fresh) [:index])))\n   337\t        (is (identical? (:index-store later) (:index-store fresh))\n   338\t            \"the dao.jing store outlives the session\")\n   339\t        (is (= \"3\" result) \"a healthy round carries no notice\")\n   340\t        (is (= 1 (count (transactions indexed))))\n   341\t        (is (true? (get-in (repl/repl-state indexed)\n   342\t                           [:index :published?])))))))\n   343\t\n   344\t\n   345\t(deftest vm-selection-rebuilds-the-indexer\n   346\t  (let [[state _] (evaluate (repl/create-state) [\"(+ 1 2)\"])\n   347\t        [switched _] (repl/eval-input state \"(vm :ast-walker)\")]\n   348\t    (is (= 1 (count (transactions state))))\n   349\t    (is (empty? (transactions switched)))\n   350\t    (is (not (identical? (get-in state [:indexer :observer :stream])\n   351\t                         (get-in switched [:indexer :observer :stream]))))))\n","exit_code":0,"status":"completed"}}
