ce/store/fs.cljc:445:              (with-open [in (java.nio.file.Files/newInputStream\nsrc/cljc/dao/space/store/fs.cljc:446:                               p (make-array java.nio.file.OpenOption 0))]\nsrc/cljc/dao/space/store/fs.cljc:448:     :cljs (let [fs (js/require \"fs\")\nsrc/cljc/dao/space/store/fs.cljc:458:                     buf (js/Buffer.alloc (inc limit))]\nsrc/cljc/dao/space/store/fs.cljc:474:  #?(:cljd (.-length ^Uint8List bs)\nsrc/cljc/dao/space/store/fs.cljc:487:  #?(:cljd (.decode convert/utf8 ^Uint8List bs)\nsrc/cljc/dao/space/store/fs.cljc:488:     :clj (str (.decode (doto (.newDecoder java.nio.charset.StandardCharsets/UTF_8)\nsrc/cljc/dao/space/store/fs.cljc:490:                            java.nio.charset.CodingErrorAction/REPORT)\nsrc/cljc/dao/space/store/fs.cljc:492:                            java.nio.charset.CodingErrorAction/REPORT))\nsrc/cljc/dao/space/store/fs.cljc:493:                        (java.nio.ByteBuffer/wrap ^bytes bs)))\nsrc/cljc/dao/space/store/fs.cljc:494:     :cljs (.decode (js/TextDecoder. \"utf-8\" #js {:fatal true}) bs)))\n","exit_code":0,"status":"completed"}}
