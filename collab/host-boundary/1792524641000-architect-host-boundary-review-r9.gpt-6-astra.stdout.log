arities _]]\n               [op (vm/primitive-profile op :pure arities #{} :none)]))\n        exports))\n\n\n(defn register-integer-module\n  \"Return registry with the `integer` module installed under `limits`.\n   Composition-only: the module is never in `yin.vm/primitives`.\"\n  [registry limits]\n  (module/register-host-module registry module-name (integer-module limits)\n                               integer-profiles))\n  (doseq [s f/int-names\n          [c text] (f/int-rows s)]\n    (is (= (f/column @fixture s c) text) (str s \" \" c))))\n\n\n(deftest float-rows-recompute-on-this-host\n  (doseq [s f/float-names\n          [c text] (f/float-rows s)]\n    (is (= (f/column @fixture s c) text) (str s \" \" c))))\n\n\n(deftest text-round-trips-through-the-module\n  (testing \"parse of the frozen decimal and hex text gives back the value:\n            its canonical bytes are the frozen bytes\"\n    (doseq [s f/int-names]\n      (let [cbor (f/column @fixture s \"cbor\")]\n        (is (= cbor (f/cbor-hex (f/call (f/module 100000 100000) 'parse\n                                        (f/column @fixture s \"dec\"))))\n            (str s \" dec\"))\n        (is (= cbor (f/cbor-hex (f/call (f/module 100000 100000) 'parse\n                                        (f/column @fixture s \"hex\") 16)))\n            (str s \" hex\"))))))\n\n\n(deftest canonical-widths-at-the-boundaries\n  (testing \"the codec's width boundaries, read off the frozen bytes: the\n            last 64-bit head, the first tag 2 and tag 3, and tag 3 over\n            -1 - n rather than |n|\"\n    (doseq [[s cbor] [[\"2^53\" \"1b0020000000000000\"]\n                      [\"-2^53\" \"3b001fffffffffffff\"]\n                      [\"2^63\" \"1b8000000000000000\"]\n#!/usr/bin/env python3\n\"\"\"\nPR Reviewer Utility Script for Git-based Code Reviews.\nParses git diffs, analyzes churn and file risk categories, scans for security smells\nand debugging code, and produces structured markdown or JSON review reports.\n\"\"\"\n\nimport argparse\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nfrom dataclasses import asdict, dataclass, field\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Tuple\n\n\n@dataclass\nclass Finding:\n    severity: str  # P0 (Critical), P1 (High), P2 (Medium), P3 (Low)\n    category: str  # Security, Debug, Quality, ErrorHandling, TestCoverage\n    file_path: str\n    line_number: Optional[int]\n    message: str\n    snippet: str\n\n\n@dataclass\nclass FileStat:\n    path: str\n    additions: int\n    deletions: int\n    category: str\n    risk_level: str  # High, Medium, Low\n\n\n@dataclass\nclass ReviewSummary:\n    target: str\n    total_files: int\n    total_additions: int\n    total_deletions: int\n    test_additions: int\n    source_additions: int\n    test_to_source_ratio: float\n    file_stats: List[FileStat] = field(default_factory=list)\n    findings: List[Finding] = field(default_factory=list)\n    commits: List[str] = field(default_factory=list)\n\n\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\n    \"\"\"Helper to run git commands cleanly.\"\"\"\n    cmd = [\"git\"] + args\n    try:\n        res = subprocess.run(\n            cmd,\n            cwd=cwd,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=True,\n        )\n        return res.stdout.strip()\n    except subprocess.CalledProcessError as e:\n        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n        raise RuntimeError(f\"Git execution failed: {e.stderr.strip()}\")\n\n\ndef categorize_file(file_path: str) -> Tuple[str, str]:\n    \"\"\"Categorizes file type and assigns risk level.\"\"\"\n    path_lower = file_path.lower()\n\n    # Security & Auth\n    if any(k in path_lower for k in [\"auth\", \"secret\", \"crypto\", \"token\", \"permission\", \"jwt\", \"oauth\", \"password\"]):\n        return \"Security/Auth\", \"High\"\n\n    # Database & Schema\n    if any(k in path_lower for k in [\"migration\", \"schema\", \".sql\", \"entity\", \"db/\"]):\n        return \"Database/Schema\", \"High\"\n\n    # Infrastructure & Config\n    if any(k in path_lower for k in [\"docker\", \"terraform\", \".tf\", \".env\", \"k8s\", \"helm\", \"ci/cd\", \".github/workflows\"]):\n        return \"Infra/Config\", \"High\"\n    if any(file_path.endswith(ext) for ext in [\"package.json\", \"deps.edn\", \"Cargo.toml\", \"go.mod\", \"requirements.txt\", \"pom.xml\", \"build.gradle\"]):\n30:   :classes #{:deferred-timers}}\n42:   :classes #{:codec-track :external-stream-seam}}\n46:   :classes #{:deferred-stage}}\n54:   :classes #{:codec-track}}\n62:   :classes #{:runtime-prereq}}\n94:   :classes #{:deferred-timers}}\n146:   :classes #{:runtime-prereq}}\n162:   :classes #{:codec-track}}\n166:   :classes #{:codec-track}}\n174:   :classes #{:codec-track}}\n210:   :classes #{:codec-track}}\n230:   :classes #{:codec-track}}\n242:   :classes #{:codec-track :deferred-entropy :external-stream-seam}}\n246:   :classes #{:codec-track}}\n262:   :classes #{:deferred-stage}}\n42:         [[:number #\"^\\d+\\.?\\d*\"] [:string #\"^\\\"([^\\\"]*)\\\"\"]\n93:    :number {:php-type :literal,\n187:      (#{:number :string} type) {:ast (parse-php-literal (first tokens)),\n(defn- digits->big\n  \"The big integer of digit values `values` in radix `r`, accumulated\n   natively `chunk-digits` at a time.\"\n  [values r]\n  (let [n (count values)]\n    (loop [acc zero\n           i 0]\n      (if (< i n)\n        (let [end (min n (+ i chunk-digits))\n  (:require\n    [clojure.string :as str]\n    [yin.vm :as vm]\n    [yin.vm.integer.host :as host]\n    [yin.vm.module :as module]))\n\n\n(def module-name\n  \"The module `register-integer-module` installs.\"\n  'integer)\n\n\n(def module-version\n  \"The version of the kernels' contract. A change to any export's\n   semantics is a new version. Version 2 returns the limit reasons\n   instead of throwing them; version 3 adds `to-float`, `compare-float`,\n   `true-div`, `from-float` and the `::float-overflow` reason, and the\n   native fast paths inside `add`, `sub`, `mul` and `compare`, whose\n   results are unchanged; version 4 adds the float text kernels\n   `float-digits` and `decimal->float`, and `max-digits`, every version 3\n   semantic unchanged.\"\n  4)\n\n\n(def refusal-message\n  \"The message of every refusal an `integer` export throws.\"\n  \"integer primitive refused\")\n\n\n(defn- refuse!\n  [op reason data]\n  (throw (ex-info refusal-message (merge {::op op, ::reason reason} data))))\n\n\n(defn- wrong-type!\n  \"Refuse argument `arg` (0-based) of `op`, which must be `expected`.\"\n  [op arg expected]\n  (refuse! op :wrong-type {::arg arg, ::expected expected}))\n\n\n;; =============================================================================\n;; Promotion, demotion and limits\n;; =============================================================================\n\n(def ^:private zero (host/from-native 0))\n(def ^:private one (host/from-native 1))\n(def ^:private neg-one (host/from-native -1))\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"agent_message","text":"The per-lane structure is sound, but two gaps remain: the code and r9 table permit different classes, and the gate rejects only `#{:none}`, allowing `:none` mixed with a permitted class. The extraction also needs to specify how it preserves the VM’s namespaced overflow result.\n"}}
