rage`, `:deferred-entropy`, `:deferred-timers`, `:deferred-stage`,    |\n1092:ringbuffer.cljc` is `:seam-driver` with `:stays` (its closure class\n1119:| `src/cljc/dao/space/transactor.cljc`     | `:deferred-scope` | `:runtime-prereq`  | Deferred row for `locking` (§9.1 scheduling); §3.1   |\n1123:| `src/cljc/yin/vm/ucf/authority.cljc`     | `:deferred-scope` | `:runtime-prereq`  | Same as `transactor.cljc` (`locking`).               |\n1125:| `src/clj/dao/jing/content/driver.clj`    | `:seam-driver`    | `:deferred-timers` | Seams row takes every lane-specific file; its arms   |\n1128:| `src/clj/yang/antlr/cst.clj`             | `:seam-driver`    | `:deferred-stage`  | Seams row takes every lane-specific file; the file   |\n1131:| `src/cljs/yang/antlr/cst.cljs`           | `:seam-driver`    | `:deferred-stage`  | Same as `cst.clj`.                                   |\n1133:| `src/cljd/yang/antlr/cst.cljd`           | `:seam-driver`    | `:deferred-stage`  | Same as `cst.clj`.                                   |\n1135:| `src/cljd/dao/stream/cbor/cljd.cljd`     | `:seam-driver`    | `:codec-track`     | Seams row takes every lane-specific file; the file   |\n1140:| `src/cljd/dao/stream/transit/cljd.cljd`  | `:seam-driver`    | `:codec-track`     | Same as `stream/cbor/cljd.cljd`.                     |\n1202:`yang/python/antlr/{int_heap,int_literal,int_ops}_test`, `dao/jing/cbor_*`,\n1281:### 9.3 The parser stage (reserved H7)\n1285:r3's \"one `println`\" at `yang/python/antlr/repl.cljc:71` was inside a\n1538:| `yin/vm/data.cljc:41,421,547`; `test/yang/python/antlr/`     |                                                                                                  |\n(ns yang.php.antlr.cst\n  \"The PHP parser worker (docs/design/yang.php.md section 6): the\n   grammars-v4 php grammar profile over the generic `yang.antlr.cst` worker.\n   The generated recognizers come from `bb gen:antlr` (antlr/php/manifest.edn);\n   the JVM and Node use the same grammar and export profile. The entry rule is `htmlDocument`.\n\n   The grammar's non-standard generics (`typeParameterListInBrackets`, the\n   `<: ... :>` brackets) are not PHP: a parse that uses them is refused as\n   `{:yang.php/not-php :generics}` rather than exported.\"\n  (:require\n    [yang.antlr.cst :as cst]\n    [dao.host.text :as text]\n    #?@(:cljs [[\"/yang/antlr/gen/php/PhpLexer.js\" :default PhpLexer]\n               [\"/yang/antlr/gen/php/PhpParser.js\" :default PhpParser]]))\n  #?(:clj (:import (yang.php.antlr.gen PhpLexer PhpParser))))\n\n\n(def grammar-id\n  \"grammars-v4 php at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/php@85e2dd1779ce556111ef98ead5d62a9858e95599 antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   :make-lexer (fn [cs] (PhpLexer. cs)),\n   :make-parser (fn [ts] (PhpParser. ts)),\n   :start #?(:clj (fn [^PhpParser p] (.htmlDocument p))\n             :cljs (fn [^js p] (.htmlDocument p)))})\n\n\n(defn make-worker\n  []\n  (cst/make-worker profile))\n\n\n(defn- generics?\n  [pk]\n  (boolean (some #(= \"typeParameterListInBrackets\" (:rule %))\n                 (:yang.cst/nodes pk))))\n\n\n(defn- line-starts\n  \"The UTF-8 byte offsets at which each source line begins (the line side\n   table, section 17: derived at the parse boundary, where the source is\n   known, so no later stage needs the text).\"\n  [source]\n  (let [bs (text/utf8-encode source)]\n    (into [0] (keep-indexed (fn [i b] (when (= b 10) (inc i)))) bs)))\n\n\n(defn parse-source\n  \"Parse one complete PHP source string as unit `unit`: the CST packet, or\n   `{:yang.php/not-php :generics}` when the parse uses the grammar's generics\n   extension.\"\n  ([source] (parse-source (make-worker) [:unit 0] source))\n  ([worker unit source]\n   (let [pk (cst/parse-unit worker unit source)]\n     (if (generics? pk)\n       {:yang.php/not-php :generics}\n       (assoc pk :yang.php/line-starts (line-starts source))))))\n(ns yin.repl.frontends\n  \"The REPL's standard frontend catalog (docs/design/yang.antlr.md section\n   8.5.6, slice F2): the hand-written Clojure frontend and the ANTLR PHP and\n   Python frontends installed into a `yang.frontend` catalog. This is\n   the only place the REPL composition names a language's namespace;\n   `yin.repl` core steps whatever binding the catalog selects.\n\n   A binding is `{:parse (fn [input]) :lower (fn [parsed])}`, with\n   `:input :forms` when the frontend consumes the forms the shell reader\n   already read, else the source text.\"\n  (:require\n    [yang.clojure :as yang.clojure]\n    [yang.frontend :as frontend]\n    #?@(:cljd []\n        :jolt []\n        :default [[yang.php.antlr.cst :as php.antlr.cst]\n                  [yang.php.antlr.lower :as php.antlr.lower]])\n    #?@(:cljd [[yang.python.antlr.repl :as python.antlr.repl]\n               [yang.python.antlr.parser :as python.antlr.parser]\n               [yang.python.antlr.repl-probe :as python.antlr.probe]]\n        :default [[yang.python.antlr.repl :as python.antlr.repl]\n                  [yang.python.antlr.parser :as python.antlr.parser]\n                  [yang.python.antlr.repl-probe :as python.antlr.probe]])\n    [yin.repl :as repl]))\n\n\n(defn- manifest\n  [id language]\n  {:yang.frontend/id id,\n   :yang.frontend/spi 1,\n   :yang.frontend/revision \"legacy-1\",\n   :yang.frontend/language language,\n   :yang.frontend/grammar {:yang.grammar/package \"none\",\n                           :yang.grammar/entries {:module \"program\"},\n                           :yang.grammar/export-profile :yang.cst/v1},\n   :yang.frontend/options-schema :segment/none,\n   :yang.frontend/lowering-profile :segment/legacy,\n   :yang.frontend/runtime-profile :segment/legacy,\n   :yang.frontend/support-profile :segment/legacy})\n\n\n(defn- clojure-lower\n  [forms]\n  (if (= 1 (count forms))\n    (yang.clojure/compile (first forms))\n    (yang.clojure/compile-program forms)))\n\n\n(defn- antlr-manifest\n  []\n  (assoc (manifest :yang/python :python)\n         :yang.frontend/revision \"f4\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"python3\",\n          :yang.grammar/entries {:module \"file_input\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript :dart}}))\n\n\n(defn php-manifest\n  []\n  (assoc (manifest :yang/php :php)\n         :yang.frontend/revision \"antlr-p8\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"php\",\n          :yang.grammar/entries {:module \"htmlDocument\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript}}\n         :yang.frontend/lowering-profile :yang.php/antlr\n         :yang.frontend/runtime-profile :yang.php/antlr\n         :yang.frontend/support-profile :yang.php/antlr))\n\n\n(defn standard\n  \"The standard catalog. The Clojure frontend consumes the forms the\n   shell's own reader read, so its parse stage is the identity. The ANTLR\n   frontends show what a submission printed and the value their `:render`\n   returns.\"\n  []\n  (cond-> frontend/empty-catalog\n    true (frontend/install (manifest :yang/clojure :clojure)\n                           {:input :forms,\n                            :parse identity,\n                            :lower clojure-lower})\n    #?@(:cljd []\n        :jolt []\n        :default [true (frontend/install\n                         (php-manifest)\n                         {:parse php.antlr.cst/parse-source,\n                          :lower php.antlr.lower/lower-packet,\n                          :render :php/out})])\n    #?@(:cljd [true (frontend/install\n                      (antlr-manifest)\n                      {:parse (fn [source]\n                                (python.antlr.parser/parse-source (str source \"\\n\"))),\n                       :lower python.antlr.repl/lower,\n                       :primitives python.antlr.repl/primitives,\n                       :lower-session python.antlr.repl/lower-session,\n                       :render python.antlr.repl/display-value,\n                       :probe python.antlr.probe/probe})]\n82:    [yang.php.antlr.prelude-p9 :as p9-defs]\n---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# When a test fails, reproduce and fix it by running ONLY the failing test\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01;\n# for a fix branch, the previously-failing tests green IS the merge bar\n# (owner ruling 2026-11-07; see Gate Ladder G0).\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n# overlap lanes, see \"Remote test servers\" below).\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\nnpm test             # Node.js tests\n\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n                         # and the linker L5 Node reader that requires a module\n                         # by name): `clojure -M:test` without it fails that test\n```\n\n### Changed-only tests: `bb test:changed`\n\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\nreach: the reverse require closure of the files changed since the\nmerge-base with master, plus fixtures that mention a changed resource path,\ntests that walk a changed tree, and each src file's `_test` by convention.\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\nfs/walk-file-tree or .listFiles; each string literal argument of its\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\n(let-bound roots count), and a change under a root selects it. The three\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\nland a slice confined to a package. Exit 2 (from :list too) is a wide\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\nas for a change to the core everything requires (yin.vm engine,\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\nand spawned programs that changed (target/yin-repl.js, Dart peers).\n\n### Sharded quick JVM feedback and change routing\n\n```sh\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\nbb test:routed                                 # Git change set, same base as test:changed\nbb deps:npm                                    # Content-checked local npm ci\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\n```\n\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\nthe JVM portion of G3. Without selection flags it selects every JVM test;\n`--changed FILE...` or `--base REF` uses `affected/select` and\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\nsemantics. `--workers N` must be positive (default 4 on the laptop).\n\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\n`affected/select-subsystems` and the same longest-prefix ownership rule as\n`test:sub`. As in the shiva script below, currently unowned namespaces run\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\nPrerequisites are derived from the entire selected JVM reach and finish\nserially before workers start; the Node REPL build prerequisite\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\n\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\nand `summary.edn`. Before execution it checks **set equality** between selected\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\nThe final summary totals tests, assertions, failures and errors and separates\nJVM wall time from total time including selection/builds. A nonzero child exit,\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\nDry plans write namespace evidence but execute no builds or tests. An empty\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\n\n`test:routed <changed-files...>` applies this priority table to the whole change\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"The source supports the proposed lane membership: `prelude_p9` is required unconditionally, and both the PHP require and install forms explicitly exclude Dart. I’m checking the classification rules and arm exemption logic before settling the prefix amendment and `cst.cljc` category."}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '365,398p' docs/design/dao.stream.host-boundary.md\nsed -n '442,465p' docs/design/dao.stream.host-boundary.md\nsed -n '950,1010p' docs/design/dao.stream.host-boundary.md\nsed -n '1060,1148p' docs/design/dao.stream.host-boundary.md\nsed -n '1281,1315p' docs/design/dao.stream.host-boundary.md\nsed -n '230,335p' test/dao/host/gate_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"sed -n '365,398p' docs/design/dao.stream.host-boundary.md\nsed -n '442,465p' docs/design/dao.stream.host-boundary.md\nsed -n '950,1010p' docs/design/dao.stream.host-boundary.md\nsed -n '1060,1148p' docs/design/dao.stream.host-boundary.md\nsed -n '1281,1315p' docs/design/dao.stream.host-boundary.md\nsed -n '230,335p' test/dao/host/gate_test.clj\"","aggregated_output":"### 3.1 The transitive closure, per lane (R, computed)\n\nMethod: a require-form traversal from `yin.repl.main`, choosing each lane's\nreader arms (`:cljd` also reads `:clj`) and resolving each namespace to its\nfile under `src/<lane>` first (shadow resolution: `yin.repl.host` is\n`host.cljc` on the JVM and the `host.cljs`/`host.cljd` shadows elsewhere),\nthen `src/cljc`. It is not a compiler-resolved call graph: it can\nover-include a namespace required but unused on a path, cannot see dynamic\nloading, and **can under-include** when its reader-arm parsing fails; the\nr3 script did exactly that (it dropped requires inside `#?@` arms and\nreported 141/140/139). The r3 claim that it \"cannot under-include\" is\nwithdrawn. The reconciled totals, counted by **file** and confirmed by the\nr3 reviewer's independent traversal (R):\n\n+-------+-------+----------+---------------------------------------------------------------------------------------------------------------------+\n| Lane  | Total | Shared   | Lane-specific files (V, the files exist)                                                                            |\n+=======+=======+==========+=====================================================================================================================+\n| clj   | 142   | 133      | `clj/dao/jing/content/driver.clj` (blocking driver: clock, sleep, `locking`), `clj/dao/stream/datagram/jvm.clj`,    |\n|       |       |          | `clj/dao/stream/waitset/driver.clj`, `clj/dao/stream/ws/jvm.clj` (clock, `CompletableFuture`), `clj/yang/antlr/     |\n|       |       |          | cst.clj`, `clj/yin/repl/host/jvm.clj`, `cljc/yin/repl/host.cljc` (the JVM selector),                                |\n|       |       |          | `cljc/dao/jing/cbor/boring.cljc`, `cljc/dao/stream/cbor/boring.cljc`. Nine.                                         |\n+-------+-------+----------+---------------------------------------------------------------------------------------------------------------------+\n| cljs  | 140   | 133      | `cljs/dao/stream/datagram/node.cljs`, `cljs/dao/stream/waitset/driver.cljs` (`setTimeout`), `cljs/dao/stream/ws/    |\n|       |       |          | node.cljs` (`js/Date`), `cljs/yang/antlr/cst.cljs`, `cljs/yin/repl/host.cljs` (shadow), `cljc/dao/jing/cbor/        |\n|       |       |          | boring.cljc`, `cljc/dao/stream/cbor/boring.cljc`. Seven.                                                            |\n+-------+-------+----------+---------------------------------------------------------------------------------------------------------------------+\n| cljd  | 141   | 133      | `cljd/dao/stream/cbor/cljd.cljd`, `cljd/dao/stream/transit/cljd.cljd`, `cljd/dao/stream/datagram/dart.cljd`,        |\n|       |       |          | `cljd/dao/stream/waitset/driver.cljd` (`Timer`), `cljd/dao/stream/ws/dart.cljd` (`DateTime.now`), `cljd/yang/antlr/ |\n|       |       |          | cst.cljd`, `cljd/yin/repl/host.cljd` (shadow), `cljd/dao/jing/cbor/cljd.cljd`. Eight.                               |\n+-------+-------+----------+---------------------------------------------------------------------------------------------------------------------+\n\nThe 133 shared files are `.cljc`. H0 commits the reproducible evidence\n(§8): the traversal is re-implemented over `clojure.tools.namespace`'s\n`ns` parsing (which handles reader conditionals per platform) rather than a\n| `rpc:114` and `jing.dht:373` `rand`,                |                                        |                                                          |\n| `space.dht/secure-random-bytes`, `sign/generate`    |                                        |                                                          |\n+-----------------------------------------------------+----------------------------------------+----------------------------------------------------------+\n| `dao.jing.coordinate:80` selecting                  | JVM blocking driver with clock and     | External (property 4, 1). **Deferred** (§9.1).           |\n| `dao.jing.content.driver` (clj lane, clock, sleep,  | sleep; host promises (not timers: a    | (`dao.jing.content.async` is not in the closure, H0; its |\n| `locking`); `dao.data.btree.storage` (promise       | `CompletableFuture`/`Promise`/         | timer is out of scope until the deferred design widens   |\n| facade `:218-227`)                                  | `Completer`)                           | it.)                                                     |\n+-----------------------------------------------------+----------------------------------------+----------------------------------------------------------+\n| `yin.repl.main`, `yin.repl` (`:275-277` banner),    | Clock, stdin/stdout, exit, env         | Driver. `repl.cljc:275` and `fs.cljc:271` ambient reads  |\n| `yin.repl.state` (`dart:io`, `js/require`)          |                                        | deferred (§9.1).                                         |\n+-----------------------------------------------------+----------------------------------------+----------------------------------------------------------+\n| `yang.python.antlr.*`, `yang.antlr.cst` (x3),       | Generated recognizers                  | Stage: **deferred** (§9.3). (`antlr/repl.cljc:71` is a   |\n| `yang.frontend`, `yang.stage`, `yin.repl.frontends` |                                        | `println` inside a quoted yin program, the VM's own      |\n|                                                     |                                        | primitive, not a host call, V; r3's \"one `println`\" is   |\n|                                                     |                                        | withdrawn.)                                              |\n+-----------------------------------------------------+----------------------------------------+----------------------------------------------------------+\n| `yang.clojure:349,359`, `yang.php:575`,             | `gensym` (process counter)             | **Deferred** (§9.1), hygiene required.                   |\n| `dao.space.transact:35`                             |                                        |                                                          |\n+-----------------------------------------------------+----------------------------------------+----------------------------------------------------------+\n| `dao.data.btree` (atomic flag, weak/soft refs),     | Owned runtime state                    | Table C; no slice. (`dao.space.schema` is not in the     |\n| `locking` in `jing.file`, `journal`, `transactor`,  |                                        | closure, H0.)                                            |\n| `ucf.authority`                                     |                                        |                                                          |\n+-----------------------------------------------------+----------------------------------------+----------------------------------------------------------+\n| **H0 finding, profile consumers**: byte length in   | Bytes, text, integer and float         | Internal pure: consumers of table A and table B entries, |\n### 8.1 List 1: the files permitted non-exempt host arms, baseline and final\n\nThe gate never promises \"no arms across `src/cljc`\", only \"no non-exempt\narms outside list 1\". List 1 is generated at H0 by the gate from the actual\nclosure (every closure file holding a non-exempt arm, §3.3) and must equal\nthe **H0 baseline** below, by category, with each file's reason; a\ndifference either way is an H0 finding to resolve before H1. The baseline\nis today's tree: the seven `dao.host.*` files are **planned additions**\n(five in H1, two in H3) and are not part of the H0 baseline; they are\nmarked as such in the table.\n\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Category (reason)          | Files (V, from §1 and the closure)                                                              | After H4                    |\n+============================+=================================================================================================+=============================+\n| H1-H4 migration sources    | `yin/vm/integer/host.cljc`, `dao/jing/cbor.cljc`, `dao/jing/cbor/boring.cljc`,                  | Removed from list 1 as each |\n|                            | `src/cljd/dao/jing/cbor/cljd.cljd` (the Dart Jing writer; a lane-specific file counted here,    | slice lands; `sign.cljc`    |\n|                            | not under seams), `dao/jing.cljc`, `yin/vm/linker/sign.cljc`, `yin/vm/debruijn.cljc`,           | stays for `generate` only;  |\n|                            | `yin/vm/debruijn_code.cljc`, `yin/vm/data.cljc`, `yin/vm/values.cljc` (table C blocks stay, as  | three of these files are    |\n|                            | exempt protocol syntax), `dao/stream/chunks.cljc`, `dao/stream/base64.cljc`,                    | deleted (§8.1 paragraph).   |\n|                            | `dao/jing/dht.cljc`, `yin/vm/linker.cljc`, `dao/stream/datagram.cljc` (bytes arms only); and,   |                             |\n|                            | from H0's finding (§3.1, profile consumers, H2): `yin/vm.cljc:404`, `dao/space/index.cljc:78`,  |                             |\n|                            | `yin/repl/query.cljc:460`, `yin/vm/linker/closure.cljc:32`, `yin/vm/ucf/rows.cljc:282`,         |                             |\n|                            | `yang/php.cljc:95,98`, `yin/vm/debruijn_register_code.cljc:439`,                                |                             |\n|                            | `yin/vm/debruijn_register_effects.cljc:130`, `yang/antlr/packet.cljc:67`.                       |                             |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Profile (the arms belong   | Baseline: `dao/data/arrays.cljc`. Planned additions, not in the H0 baseline:                    | Stay; the seven additions   |\n| here by design)            | `dao/host/{integer,float,number,bytes,text,hash,sign}.cljc` (P; five join list 1 at H1, two at  | are on list 1 from the      |\n|                            | H3).                                                                                            | slice that creates them.    |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Retained runtime           | `dao/data/btree.cljc` (atomic flag `:102-119`, weak and soft references `:212-245`: substantive | Stay, with the table C      |\n| prerequisites (table C)    | arms, not protocol syntax, retained by design); `dao/data/btree/storage.cljc` (promise facade,  | reason recorded in the      |\n|                            | deferred §9.1); `dao/pretty.cljc` (`StringWriter`/pprint, display only, §3.1).                  | gate's list.                |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Codec-track files          | `dao/stream/ws.cljc`, `transit.cljc`, `cbor.cljc`, `cbor/boring.cljc`, `codec.cljc`,            | Stay; owned by that track;  |\n| (untouched by this track)  | `yin/repl/connect.cljc` (J3). (H0: `remote_channel.cljc` and `ws_project.cljc` carry only        | `codec.cljc:45` after C4.   |\n|                            | exempt `catch` arms and are not on the generated list; `jing/stream.cljc` is not in the        |                             |\n|                            | closure. All remain codec-track files under §8.3; they are simply not list-1 entries.)         |                             |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Dialect arms (H0 finding,  | `dao/space/query.cljc` (`:808`), `yang/clojure.cljc` (`:375`), `yin/vm/engine.cljc` (`:929`): a | Stay.                       |\n| retained)                  | runtime type name in diagnostic text; `yin/repl/adapter.cljc` (`:58`), `yin/repl/dht.cljc`      |                             |\n|                            | (`:104`): the dialect's EDN reader under two namespaces. Five files.                            |                             |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Seams, stream              | `src/clj`, `src/cljs`, `src/cljd` seam and shadow files (§3.1 lane-specific list) **except**    | Stay, except the Dart Jing  |\n| implementations and driver | `src/cljd/dao/jing/cbor/cljd.cljd`, which is a Jing writer H4 deletes, not a seam; it is on the | writer, deleted in H4.      |\n|                            | baseline under the first row's `dao/jing/cbor/boring.cljc` twin. `dao/stream/ringbuffer.cljc`   |                             |\n|                            | (`:168`, the in-memory stream implementation's own host atom test: an                           |                             |\n|                            | **implementation-private** arm under §4.1, its one name in this document and in the closure     |                             |\n|                            | class `:external-stream-seam`). `yin/repl/main.cljc`, `yin/repl/host.cljc`,                     |                             |\n|                            | `yin/repl/state.cljc`.                                                                          |                             |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n| Deferred-scope files (§9)  | `dao/jing/file.cljc`, `dao/space/store/fs.cljc`, `dao/space/store.cljc`,                        | Stay until the deferred     |\n|                            | `dao/stream/journal/file.cljc`, `dao/jing/coordinate.cljc`, `dao/space/dht.cljc`,               | design lands.               |\n|                            | `dao/stream/rpc.cljc` (`:114`, the `rand` arm), `yin/repl.cljc`,                                |                             |\n|                            | `yang/python/antlr/parser.cljc` and the other `yang/python/antlr/*.cljc` with arms,             |                             |\n|                            | `dao/stream/journal.cljc` (`locking`), `dao/space/transactor.cljc`, `yin/vm/ucf/authority.cljc` |                             |\n|                            | (`locking`), `yin/repl/frontends.cljc` (J3/J5), `yin/repl/store.cljc` (J3/J4). (H0:            |                             |\n|                            | `dao/jing/content/ async.cljc`, `dao/stream/udp.cljc` and `dao/space/schema.cljc` are not in   |                             |\n|                            | the closure and are dropped from list 1; the deferred design records them, §9.) Every           |                             |\n|                            | remaining closure file whose arms are only `catch`/hint/protocol syntax is **not** on list 1   |                             |\n|                            | (exempt by pattern).                                                                            |                             |\n+----------------------------+-------------------------------------------------------------------------------------------------+-----------------------------+\n**The category-to-class mapping, stated (R7-4, H0-3).** The gate today\nchecks only that each list-1 category exists, that its slice value is\npermitted, and, weakly, that the collapsed class set is not `#{:none}`\n(V `gate_test.clj:706-714`). H0's retag strengthens it to: for every\nlist-1 file, on **every lane whose closure contains it**, the file's class\nset is non-empty and does not contain `:none` (per-lane sets, never\ncollapsed across lanes), and intersects the classes its category permits,\n**or** carries the one class the bounded-exception table below admits for\nthat file in that category:\n\n+--------------------+-------------------------------------------------------------------------------------+\n| Gate category      | Permitted closure classes                                                           |\n+====================+=====================================================================================+\n| `:migration-source | `:profile-internal-pure`, `:profile-hash-sign`, `:consumer`, `:profile-consumer`    |\n| `                  |                                                                                     |\n+--------------------+-------------------------------------------------------------------------------------+\n| `:profile`         | `:profile-internal-pure`                                                            |\n+--------------------+-------------------------------------------------------------------------------------+\n| `:runtime-prereq`  | `:runtime-prereq`, `:internal-pure-display`, `:deferred-storage` (the promise       |\n|                    | facade file)                                                                        |\n+--------------------+-------------------------------------------------------------------------------------+\n| `:codec-track`     | `:codec-track`                                                                      |\n+--------------------+-------------------------------------------------------------------------------------+\n| `:dialect-arm`     | `:dialect-arm`                                                                      |\n+--------------------+-------------------------------------------------------------------------------------+\n| `:seam-driver`     | `:external-stream-seam`, `:driver`                                                  |\n+--------------------+-------------------------------------------------------------------------------------+\n| `:deferred-scope`  | `:deferred-storage`, `:deferred-entropy`, `:deferred-timers`, `:deferred-stage`,    |\n|                    | `:deferred-gensym`                                                                  |\n+--------------------+-------------------------------------------------------------------------------------+\n\nTwo placements from the r8 code review (H0-1, H0-2): `dao/stream/\nringbuffer.cljc` is `:seam-driver` with `:stays` (its closure class\n`:external-stream-seam`), not `:dialect-arm`; `yin/vm.cljc` is\n`:migration-source` with `:pending` as above.\n\nHost number-model arms (r11 H2 finding, retained): `debruijn.cljc` and\n`debruijn_code.cljc` remain on list 1 under `:migration-source` with `:stays`\n(encoding which number classes a host carries; `cbor.cljc:217,227` joins after H4).\nH2b moves `data.cljc` and `values.cljc` off list 1.\n\n**Bounded exceptions to the mapping (r10, H0-R3 reconciliation).** The\nfile rows above and the §3.1 closure classes disagree for eight files: the\nrows place them by *why the arm is permitted* (the deferred row takes the\n`locking` files; the seams row takes every lane-specific file), while §3.1\nclassifies them by *what host contact they have*. Both are kept as\nwritten, and the disagreement is closed by naming each case, bound to its\nfile **and** its category **and** its class. An exception admits exactly\nthat one class for that one file **only while the file is in that\ncategory**; it widens no other category, no other file and no other class.\nThe gate enforces this table as data: a file in the table whose closure\nclass the bare mapping already admits (the exception is no longer needed),\nor a file whose list-1 category is not the one named here, is an H0\nfinding, so the table cannot go stale silently. Adding a row here is a\ndesign amendment, not a gate edit.\n\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| File                                     | List-1 category   | Admitted class     | Why both are right                                   |\n+==========================================+===================+====================+======================================================+\n| `src/cljc/dao/space/transactor.cljc`     | `:deferred-scope` | `:runtime-prereq`  | Deferred row for `locking` (§9.1 scheduling); §3.1   |\n|                                          |                   |                    | table C classes the lock as a retained runtime       |\n|                                          |                   |                    | prerequisite.                                        |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/cljc/yin/vm/ucf/authority.cljc`     | `:deferred-scope` | `:runtime-prereq`  | Same as `transactor.cljc` (`locking`).               |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/clj/dao/jing/content/driver.clj`    | `:seam-driver`    | `:deferred-timers` | Seams row takes every lane-specific file; its arms   |\n|                                          |                   |                    | are clock/timer calls deferred under §9.1.           |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/clj/yang/antlr/cst.clj`             | `:seam-driver`    | `:deferred-stage`  | Seams row takes every lane-specific file; the file   |\n|                                          |                   |                    | is the parser stage deferred under §9.3.             |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/cljs/yang/antlr/cst.cljs`           | `:seam-driver`    | `:deferred-stage`  | Same as `cst.clj`.                                   |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/cljd/yang/antlr/cst.cljd`           | `:seam-driver`    | `:deferred-stage`  | Same as `cst.clj`.                                   |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/cljd/dao/stream/cbor/cljd.cljd`     | `:seam-driver`    | `:codec-track`     | Seams row takes every lane-specific file; the file   |\n|                                          |                   |                    | is the Dart codec shadow owned by the codec track    |\n|                                          |                   |                    | (§8.3). Not a Jing writer: the H4 deletion of        |\n|                                          |                   |                    | `src/cljd/dao/jing/cbor/cljd.cljd` is unaffected.    |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n| `src/cljd/dao/stream/transit/cljd.cljd`  | `:seam-driver`    | `:codec-track`     | Same as `stream/cbor/cljd.cljd`.                     |\n+------------------------------------------+-------------------+--------------------+------------------------------------------------------+\n\nEight files, twelve lane rows (the two `locking` files sit in all three\nlane closures). What this table does **not** do: it does not add\n`:runtime-prereq` to the deferred row's classes, nor any deferred or codec\nclass to the seams row (an unrestricted \"any class for a lane-specific\nfile\" exemption is refused; the Dart Jing writer stays excluded from seams\nand on its H4 deletion path). The deferred design (§9) and the codec track\n### 9.3 The parser stage (reserved H7)\n\nIntent: the grammar profile plus host walk as one seam value; a\nremote-stage test. Required input: none beyond the stage's own host walk;\nr3's \"one `println`\" at `yang/python/antlr/repl.cljc:71` was inside a\nquoted yin program (the VM's primitive, not a host call, V) and is\nwithdrawn.\n\n### 9.4 Stream-implementation conformance and the wasm import gate (reserved H8)\n\nIntent: the contract's outcome tables through a scripted seam against every\nimplementation; a gate asserting a wasm binary's import list against the\nseven names. Required input: which implementations declare which outcome\nsubset (`dao.stream.md`, Surfaces).\n\n## 10. Cost and what would reverse this (H0-H4)\n\nCost (P, from §1 and §8.3, revised r7 for H0's finding): **24 existing\nfiles edited** (the 16 of r5 plus the eight profile consumers H0 found:\n`dao/space/index.cljc`, `yin/repl/query.cljc`, `yin/vm/linker/closure.cljc`,\n`yin/vm/ucf/rows.cljc`, `yang/php.cljc`, `yin/vm/debruijn_register_code.cljc`,\n`yin/vm/debruijn_register_effects.cljc`, `yang/antlr/packet.cljc`; each a\nrequire plus one arm, so `dao.space.index` and the UCF rows file are no\nlonger \"untouched\") and **3 deleted**\n(`yin/vm/integer/host.cljc`, `dao/jing/cbor/boring.cljc`,\n`src/cljd/dao/jing/cbor/cljd.cljd`), **7** `dao.host.*` files added (five in\nH1, two in H3); **at least 5** test namespaces added (`gate-test` in H0,\n`conformance-test`, `bytes-test`, `text-test` in H1, `hash-test` in H3),\nthe 3 Python integer tests and `integer_test` re-pointed; about 10^3 tests\nrerun per lane (R: JVM quick tier about 4,000); about 10^1 rewritten.\nBase64 and the Jing writer are replacements, not code motion, and are\naccepted only by their byte oracles. No performance figure is claimed; H4\nmeasures.\n\nRisk, revised (reviews N4 and R7-2): the laws of §2.4 and table A are\n        walk (fn walk\n               [form ancestors]\n               (let [down (conj ancestors form)]\n                 (cond\n                   (rc? form)\n                   (do (when-not (exemption form ancestors)\n                         (swap! acc conj (or (some (comp line-of second) (rc-arms form))\n                                             (some line-of (rseq ancestors)))))\n                       (doseq [[_ arm] (rc-arms form)]\n                         (if (splicing? form)\n                           (doseq [x arm] (walk x down))\n                           (walk arm down))))\n                   (and (seq? form) (= 'comment (first form))) nil\n                   (map? form) (doseq [[k v] form] (walk k down) (walk v down))\n                   (coll? form) (doseq [x form] (walk x down))\n                   :else nil)))]\n    (doseq [f forms] (walk f []))\n    @acc))\n\n\n;; ---------------------------------------------------------------------------\n;; Resolved effect calls (§3.2 kinds, §2.4 M entries)\n;; ---------------------------------------------------------------------------\n\n(def core-ns #{nil \"clojure.core\" \"cljs.core\" \"cljd.core\"})\n\n\n(defn effect-kind\n  \"The §3.2 kind of a symbol that names a host effect, or nil. core? is\n   false when an unqualified name is shadowed in its file.\"\n  [sym core?]\n  (let [n (name sym)\n        q (namespace sym)\n        core (and (contains? core-ns q) (or q core?))]\n    (cond\n      (and core (= n \"random-uuid\")) :random-uuid\n      (and core (#{\"rand\" \"rand-int\" \"rand-nth\" \"shuffle\" \"random-sample\"} n)) :rand\n      (or (str/includes? n \"SecureRandom\")\n          (= n \"Random.secure\")\n          (= n \"randomUUID\")\n          (and (= q \"js\") (str/starts-with? n \"crypto\"))\n          (#{\"getRandomValues\" \"randomBytes\" \"generateKey\"} n)) :secure-random\n      (and core (= n \"gensym\")) :gensym\n      (or (and (#{\"System\" \"java.lang.System\"} q) (#{\"currentTimeMillis\" \"nanoTime\"} n))\n          (and (= q \"js\") (or (str/starts-with? n \"Date\") (str/starts-with? n \"performance\")))\n          (str/starts-with? n \"DateTime.now\")\n          (and q (str/ends-with? q \"Instant\") (= n \"now\"))) :clock\n      (or (and (#{\"System\" \"java.lang.System\"} q) (#{\"getenv\" \"getProperty\" \"getProperties\"} n))\n          (and (= q \"js\") (str/starts-with? n \"process\"))\n          (str/starts-with? n \"Platform.\")) :ambient\n      (or (and core (#{\"println\" \"print\" \"prn\" \"pr\" \"printf\" \"newline\"} n))\n          (and (= q \"js\") (str/starts-with? n \"console\"))) :print\n      (or (and (= q \"js\") (#{\"setTimeout\" \"setInterval\" \"setImmediate\" \"queueMicrotask\"} n))\n          (str/starts-with? n \"Timer\")\n          (and (#{\"Thread\" \"java.lang.Thread\"} q) (= n \"sleep\"))\n          (str/starts-with? n \"Future.delayed\")) :timer\n      :else nil)))\n\n\n(def m-entry-nss\n  \"The namespaces holding §2.4's M entries, now and after H1.\"\n  '#{dao.data.arrays dao.host.bytes})\n\n\n(def m-entry-names #{\"aset\" \"acopy\" \"asort\" \"set!\" \"copy!\"})\n\n\n(def scan-features\n  \"The feature sets the effect scan resolves a file under, by its lane:\n   one set per lane, and for :cljd both the traversal's {:cljd :clj}\n   (the host-eval pass, where :clj may be picked first) and :cljd alone\n   (so a :cljd arm behind a :clj arm is seen too).\"\n  {:clj [#{:clj}], :cljs [#{:cljs}], :cljd [#{:cljd :clj} #{:cljd}]})\n\n\n(defn file-lanes\n  \"The lanes a file is read on: its own for a lane-specific file, every\n   lane for .cljc.\"\n  [file]\n  (condp #(str/ends-with? %2 %1) file\n    \".clj\" [:clj]\n    \".cljs\" [:cljs]\n    \".cljd\" [:cljd]\n    lanes))\n\n\n(defn file-scope\n  \"{:aliases {alias ns} :refers {sym ns} :shadowed #{sym}} of a file's\n   forms as one lane reads them (arms already selected): its ns form,\n   its top-level defs, its :refer-clojure excludes.\"\n  [forms]\n  (let [ns-form (first (filter #(= 'ns (head %)) forms))\n        specs (->> (rest ns-form)\n                   (filter seq?)\n                   (filter #(#{:require :use} (first %)))\n                   (mapcat rest)\n                   (filter vector?))\n        opts (fn [spec] (apply hash-map (rest (if (even? (count spec)) (butlast spec) spec))))\n        excluded (->> (rest ns-form)\n                      (filter #(and (seq? %) (= :refer-clojure (first %))))\n                      (mapcat #(:exclude (apply hash-map (rest %)))))\n        defs (->> forms\n                  (mapcat (fn [f] (if (= 'do (head f)) (rest f) [f])))\n                  (keep (fn [f]\n                          (when (#{'def 'defn 'defn- 'defmacro 'defonce 'declare\n                                   'defprotocol 'defmulti} (head f))\n","exit_code":0,"status":"completed"}}
