{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"bb -e '\n(require (quote [edamame.core :as e]) (quote [clojure.java.io :as io]) (quote [clojure.string :as s]) (quote [clojure.set :as set]))\n(defn path [lane n] (let [p (s/replace (s/replace (str n) \\\".\\\" \\\"/\\\") \\\"-\\\" \\\"_\\\")] (some #(when (.exists (io/file %)) %) [(str \\\"src/\\\" (name lane) \\\"/\\\" p \\\".\\\" (name lane)) (str \\\"src/cljc/\\\" p \\\".cljc\\\")])))\n(defn deps [lane p] (let [form (e/parse-string (slurp p) {:read-cond :allow :features (if (= lane :cljd) #{:cljd :clj} #{lane}) :all true})] (for [clause (drop 2 form) :when (and (seq? clause) (= :require (first clause))) spec (rest clause) :let [n (if (vector? spec) (first spec) spec)] :when (and (symbol? n) (path lane n))] n)))\n(defn closure [lane] (loop [todo [(quote yin.repl.main)] seen {}] (if-let [n (first todo)] (if (seen n) (recur (rest todo) seen) (let [p (path lane n)] (recur (concat (rest todo) (deps lane p)) (assoc seen n p)))) seen)))\n(def cs (into {} (map (fn [l] [l (closure l)]) [:clj :cljs :cljd])))\n(def common (apply set/intersection (map #(set (vals %)) (vals cs))))\n(prn :shared-files (count common))\n(doseq [[lane c] cs] (prn lane (count c) :nonshared (sort (set/difference (set (vals c)) common))))\n(doseq [[lane c] cs [n p] c :when (some #{(quote dao.pretty) (quote dao.stream.cbor.boring) (quote dao.jing.cbor.boring)} (deps lane p))] (prn :edge lane n (vec (deps lane p))))'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
