\n  1817\t\n  1818\tThe linker may resolve `:yin.module/requires` ahead of time from the\n  1819\tmanifest and deliver every image of the closure in one response, ordered\n  1820\tso that dependencies precede dependents and a strongly connected\n  1821\tcomponent arrives as one unit. This is Phase B7's dependency closure\n  1822\t(`yin.vm.debruijn.stack.md` D5, D6); this document fixes only that the\n  1823\tresponse is a vector of `[manifest derivation image obligations]`\n  1824\tentries in install order, that the scheduler starts one child per entry\n  1825\tin that order, and that a cycle is one unit hashed with canonical\n  1826\tmember ordering. How SCC identity is minted stays open (section 12).\n    22\t\n    23\t\n    24\t(defn require-node\n    25\t  \"(require 'm) as a tree node.\"\n    26\t  [m]\n    27\t  (u/sexp->uast (list 'require (list 'quote m))))\n    28\t\n    29\t\n    30\t(defn module-tree\n    31\t  \"A wide application: all definitions remain at module level.\"\n    32\t  [operands]\n    33\t  (prelude/wide-app operands))\n    34\t\n    35\t\n    36\t(defn declare-free-name\n    37\t  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n    38\t   when `covered` (the requirement-pinned module names) covers it. A name\n    39\t   no `vm/primitives` profile or host export supplies throws, with\n    40\t   `refusal` under `refusal-key` in its data.\"\n    41\t  [refusal-key refusal registry covered n]\n    42\t  (if (and (symbol? n) (some? (namespace n))\n    43\t           (contains? covered (symbol (namespace n))))\n    44\t    nil\n    45\t    (or (prelude-admission/host-declaration registry n)\n    46\t        (throw (ex-info \"the module reads an undeclared name\"\n    47\t                        {refusal-key refusal, :name n})))))\n    48\t\n    49\t\n    50\t(defn free-primitives\n    51\t  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n    52\t  [refusal-key refusal registry covered ast]\n    53\t  (into {}\n    54\t        (keep (partial declare-free-name refusal-key refusal registry covered))\n    55\t        (prelude/free-name-vec ast)))\n    56\t\n    57\t\n    58\t(defn module-spec\n    59\t  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n    60\t   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n    61\t   ({module-symbol address}). A free name under a required module is covered\n    62\t   by it; any other is declared as `declare-free-name` does.\"\n    63\t  [refusal-key refusal registry\n    64\t   {:keys [name ast exports runtime-name runtime-address deps]}]\n    65\t  (let [requires (into {runtime-name runtime-address} deps)]\n  1458\t                          (assoc (u/app (u/v 'clj/raise)\n  1459\t                                        (u/app (u/v 'cell/dsg__new-provenance)\n  1460\t                                               (u/v condition) (u/v condition))) :tail? true))\n  1461\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n  1462\t                              common-call refused)\n  1463\t          ;; A callee carrying a call entry is convention territory whether it\n  1464\t          ;; admits or forges one, so admission rules it. Everything else is a\n  1465\t          ;; data-side invocation - a collection lookup or a raw closure call -\n  1466\t          ;; owned by the guest library's invoker, reached the same way.\n  1467\t          value-call (u/app (u/v 'yang.call/invoke)\n  1468\t                            (u/v 'invoke-value)\n  1469\t                            (u/app (u/v 'conj) (u/lit []) (u/v callee) (u/v arguments))\n  1470\t                            (u/lit [])\n  1471\t                            raise-exit)\n  1472\t          routed (if (::invoker env)\n  1473\t                   (u/if-node\n  1474\t                     (u/if-node (u/app (u/v 'data/map?) (u/v callee))\n  1475\t                                (u/if-node (u/app (u/v 'data/contains?) (u/v callee) (u/lit :yang.call/entry))\n  1476\t                                           (u/lit true)\n  1477\t                                           ;; the shape is only WHEN to ask (ruling of\n  1478\t                                           ;; record, rule 2): the heap answers\n  1479\t                                           ;; `cell/authentic?`, and an unauthenticated\n  2626\t    (defn ^:yin.k/invoker invoke-value\n  2627\t      [f args]\n  2628\t      (cond\n  2629\t        (vector? f) (if (= 1 (count args)) (nth f (first args))\n  2630\t                        (throw (ex-info \"Vector invocation requires one index\" {:argc (count args)})))\n  2631\t        (or (map? f) (keyword? f))\n  2632\t        (if (<= 1 (count args) 2)\n  2633\t          (if (keyword? f) (get (first args) f (second args))\n  2634\t              (get f (first args) (second args)))\n  2635\t          (throw (ex-info \"Lookup invocation requires one key and optional default\" {:argc (count args)})))\n  2636\t        (set? f) (if (= 1 (count args))\n  2637\t                   (if (contains? f (first args)) (first args) nil)\n  2638\t                   (throw (ex-info \"Set invocation requires one key\" {:argc (count args)})))\n  2639\t        ;; Everything unsupported - a scalar, a raw closure the convention\n  2640\t        ;; never published, a forged shape that slipped past the call-site\n  2641\t        ;; routing - refuses as the admission path would. No apply here: a\n  2642\t        ;; guest apply would re-enter the call-site dispatcher and recurse.\n  2643\t        ;; This is a SOURCE-LEVEL throw of an UNMARKED condition-shaped map\n  2644\t        ;; (codex ruling 1794332020000): the value path has no raise exit, so\n  2645\t        ;; the crossing boundary wraps it per §8.10.7 into a NEW\n  2646\t        ;; :yang.call/thrown condition and authenticates THAT outer condition\n  2647\t        ;; with the compiler-held token. The library neither 