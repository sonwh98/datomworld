ons\\\\\\\\n  5303\\\\\\\\t  \\\\\\\\\\\\\\\"The single definition list, `[store-key form]` in definition order: every\\\\\\\\n  5304\\\\\\\\t   prelude function, the literal state slot, then `php/init!`. Defining them\\\\\\\\n  5305\\\\\\\\t   runs nothing.\\\\\\\\\\\\\\\"\\\\\\\\n  5306\\\\\\\\t  (into (into (into core-definitions module-defs/definitions) p9-defs/definitions)\\\\\\\\n  5307\\\\\\\\t        [['php.rt/state :php/uninit]\\\\\\\\n  5308\\\\\\\\t         ['php/init! (init-form)]]))\\\\\\\\n  5309\\\\\\\\t\\\\\\\\n  5310\\\\\\\\t\\\\\\\\n  5311\\\\\\\\t(def functions-uast\\\\\\\\n  5312\\\\\\\\t  \\\\\\\\\\\\\\\"The bundled shared-call definitions, PHP lambdas and literal state slot.\\\\\\\\\\\\\\\"\\\\\\\\n  5313\\\\\\\\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form)))\\\\\\\\n  5314\\\\\\\\t                    (into call/definitions definitions))))\\\\\\\\n  5315\\\\\\\\t\\\\\\\\n  5316\\\\\\\\t\\\\\\\\n  5317\\\\\\\\t(def uast\\\\\\\\n  5318\\\\\\\\t  \\\\\\\\\\\\\\\"The bundled prelude: every definition, then the task's runtime state\\\\\\\\n  5319\\\\\\\\t   allocated by `php/init!`.\\\\\\\\\\\\\\\"\\\\\\\\n  5320\\\\\\\\t  (u/then functions-uast (u/sexp->uast '(php/init!))))\\\\\\\\n  5321\\\\\\\\t\\\\\\\\n  5322\\\\\\\\t\\\\\\\\n  5323\\\\\\\\t;; =============================================================================\\\\\\\\n  5324\\\\\\\\t;; The module emitter: the same definition list as the linker module `php`\\\\\\\\n  5325\\\\\\\\t;; =============================================================================\\\\\\\\n  5326\\\\\\\\t\\\\\\\\n  5327\\\\\\\\t(def module-name\\\\\\\\n  5328\\\\\\\\t  \\\\\\\\\\\\\\\"The linker module the PHP runtime profile is published as.\\\\\\\\\\\\\\\"\\\\\\\\n  5329\\\\\\\\t  'php)\\\\\\\\n  5330\\\\\\\\t\\\\\\\\n  5331\\\\\\\\t\\\\\\\\n  5332\\\\\\\\t(def runtime-keys\\\\\\\\n  5333\\\\\\\\t  \\\\\\\\\\\\\\\"Every key `php/init!` allocates, the ready flag aside, sorted.\\\\\\\\\\\\