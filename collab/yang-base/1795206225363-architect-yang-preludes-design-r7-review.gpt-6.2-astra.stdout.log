{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"nl -ba src/cljc/yang/clojure/prelude.cljc | sed -n '30,139p' && nl -ba src/cljc/yang/python/antlr/prelude.cljc | sed -n '250,316p' && nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '164,231p'\"","aggregated_output":"    30\t     `clj/raise` and its helpers: the\n    31\t     `%capture` handler-stack scheme the py/ts/php preludes carry, over a\n    32\t     dynamic-context cell `clj.rt/ctx` (allocated by `clj/init!`). It is\n    33\t     the reference implementation yang.clojure's exception lowering\n    34\t     converges onto (R3, section 8.10.7); the consumer wiring that calls\n    35\t     these entries lands after the family exists;\n    36\t   - admission, `admit`: the registry surface a linked clojure composition\n    37\t     needs beside the others — the `kind` module and the `portable`\n    38\t     adapters of the data exports the guest library's collection\n    39\t     predicates read.\n    40\t\n    41\t   The module pins the shared calling runtime (`yang.call`) at the\n    42\t   convention's call-address, as the other runtimes do, and refuses before\n    43\t   anything is published when a free name nothing supplies is read.\"\n    44\t  (:require [yang.core.prelude :as core]\n    45\t            [yang.core.prelude-admission :as prelude-admission]\n    46\t            [yang.clojure :as yang]\n    47\t            [yin.vm :as vm]\n    48\t            [yin.vm.data :as data]\n    49\t            [yin.vm.module :as module]))\n    50\t\n    51\t\n    52\t(def module-name\n    53\t  \"The linker module name of the clojure runtime.\"\n    54\t  'clj)\n    55\t\n    56\t\n    57\t(def runtime-keys\n    58\t  \"Every runtime key, each with an `:clj/uninit` placeholder at module\n    59\t   level so every read is discharged before `clj/init!` allocates the\n    60\t   real cell. They stay qualified: internal store keys, never guest\n    61\t   names.\"\n    62\t  '[clj.rt/state clj.rt/globals clj.rt/ctx])\n    63\t\n    64\t\n    65\t(def definitions\n    66\t  \"The module's definition list, in prelude notation (the module's own\n    67\t   `clj/` prefix is stripped on emit).\"\n    68\t  '[;; ------------------------------------------------- state and namespace\n    69\t    [clj/init!\n    70\t     (fn []\n    71\t       (if (= clj.rt/state :clj/uninit)\n    72\t         (do (yin/def (quote clj.rt/globals) (cell/new {}))\n    73\t             (yin/def (quote clj.rt/ctx) (cell/new (clj/ctx nil)))\n    74\t             (yin/def (quote clj.rt/state) :clj/ready))\n    75\t         :clj/ready))]\n    76\t    ;; the runtime global namespace: one task-local map in a cell, keyed by\n    77\t    ;; export name. `clj/define-global!` answers the value, so a publish\n    78\t    ;; sequence can chain through it.\n    79\t    [clj/define-global!\n    80\t     (fn [name value]\n    81\t       (do (cell/set! clj.rt/globals\n    82\t                      (assoc (cell/get clj.rt/globals) name value))\n    83\t           value))]\n    84\t    [clj/global-get\n    85\t     (fn [name]\n    86\t       (if (data/contains? (cell/get clj.rt/globals) name)\n    87\t         (get (cell/get clj.rt/globals) name)\n    88\t         :clj/unbound))]\n    89\t\n    90\t    ;; ------------------------------------------------------------- escapes\n    91\t    ;; The continuation family, mirroring py/ts/php (their preludes are the\n    92\t    ;; reference implementations): the dynamic context is one record in one\n    93\t    ;; cell, `clj.rt/ctx`, holding {:handlers} — clojure has no generators,\n    94\t    ;; no `with` managers and no recursion-limit hook, so there is no\n    95\t    ;; :depth/:base/:frame accounting the way py/php carry it. The handler\n    96\t    ;; stack is a chain of frames [tag payload rest n]: a :handler frame\n    97\t    ;; holds the continuation `throw` delivers to, a :finally frame a thunk\n    98\t    ;; of one argument (the thrown value, or nil) that every exit through\n    99\t    ;; it runs; n, the frame count, makes \"unwind to here\" an integer\n   100\t    ;; comparison. A first pass through a capture point is told from a\n   101\t    ;; re-entry by a flag cell, never by inspecting the continuation.\n   102\t    [clj/ctx (fn [hs] (assoc {} :handlers hs))]\n   103\t    [clj/rt-ctx\n   104\t     ;; the dynamic-context cell itself: `clj.rt/*` is an internal store key\n   105\t     ;; no closure of another module can name, so linked hooks read the cell\n   106\t     ;; through this export\n   107\t     (fn [] clj.rt/ctx)]\n   108\t    [clj/restore! (fn [saved] (cell/set! clj.rt/ctx saved))]\n   109\t    [clj/handlers (fn [] (get (cell/get clj.rt/ctx) :handlers))]\n   110\t    [clj/set-handlers!\n   111\t     (fn [hs] (cell/set! clj.rt/ctx (assoc (cell/get clj.rt/ctx) :handlers hs)))]\n   112\t    [clj/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n   113\t    [clj/frame\n   114\t     (fn [tag payload rest]\n   115\t       (conj (conj (conj (conj [] tag) payload) rest)\n   116\t             (+ 1 (clj/frame-depth rest))))]\n   117\t    [clj/pop-frame\n   118\t     (fn [hs]\n   119\t       (cell/set! clj.rt/ctx (assoc (cell/get clj.rt/ctx) :handlers (get hs 2))))]\n   120\t    [clj/raise\n   121\t     ;; deliver `e` to the current handler stack; with no handler above it\n   122\t     ;; the value escapes the whole stack (unreached in practice: the entry\n   123\t     ;; installs a top-level handler). A :finally frame runs its thunk with\n   124\t     ;; `e` before the raise continues.\n   125\t     (fn [e]\n   126\t       (let [hs (clj/handlers)]\n   127\t         (if (nil? hs)\n   128\t           (:clj/no-handler e)\n   129\t           (if (= (get hs 0) :finally)\n   130\t             (do (clj/pop-frame hs) ((get hs 1) e) (clj/raise e))\n   131\t             ((get hs 1) e)))))]\n   132\t    [clj/throw\n   133\t     ;; the guest `(throw e)` form: clojure throws arbitrary values with no\n   134\t     ;; wrapping, so it is `clj/raise` under the guest name\n   135\t     (fn [e] (clj/raise e))]\n   136\t    [clj/try\n   137\t     (fn [body handler]\n   138\t       (let [saved (cell/get clj.rt/ctx)\n   139\t             flag (cell/new :first)]\n   250\t    ;; ---------------------------------------------------------- escapes\n   251\t    ;; The dynamic context is one record in one cell, {:handlers :depth\n   252\t    ;; :base :frame}: every capture point saves it and every escape\n   253\t    ;; restores it with the current :base left alone (`py/restore!`), so\n   254\t    ;; an escape inside a generator restores its depth relative to the\n   255\t    ;; activation it runs in; only crossings set :base. The handler stack\n   256\t    ;; is a chain of frames [kind payload rest n depth]: :handler frames\n   257\t    ;; hold the continuation `raise` delivers to, :finally frames hold a\n   258\t    ;; thunk of one argument (the exception, or None) that every exit\n   259\t    ;; through them runs. n, the frame count, makes \"unwind to here\" an\n   260\t    ;; integer comparison; depth is the (activation-relative) call depth\n   261\t    ;; the frame was pushed at, which its thunk runs at.\n   262\t    [py/ctx\n   263\t     (fn [handlers depth base frame]\n   264\t       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\n   265\t                     :base base)\n   266\t              :frame frame))]\n   267\t    [py/abs-depth (fn [c] (+ (get c :base) (get c :depth)))]\n   268\t    [py/rt-ctx\n   269\t     ;; the dynamic-context cell itself (C4 slice P3): the base prelude\n   270\t     ;; owns the record, and the hook prelude counts frames in it, but\n   271\t     ;; `py.rt/*` is an internal store key no closure of another module\n   272\t     ;; can name, so linked hooks read the cell through this export\n   273\t     (fn [] py.rt/ctx)]\n   274\t    [py/rt-limit\n   275\t     ;; the recursion-limit cell, the same door\n   276\t     (fn [] py.rt/limit)]\n   277\t    [py/restore!\n   278\t     (fn [saved]\n   279\t       (cell/set! py.rt/ctx\n   280\t                  (assoc saved :base (get (cell/get py.rt/ctx) :base))))]\n   281\t    [py/handlers (fn [] (get (cell/get py.rt/ctx) :handlers))]\n   282\t    [py/set-handlers!\n   283\t     (fn [hs] (cell/set! py.rt/ctx (assoc (cell/get py.rt/ctx) :handlers hs)))]\n   284\t    [py/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n   285\t    [py/frame\n   286\t     (fn [kind payload rest]\n   287\t       (py/vconj (py/vconj (py/vconj (py/vconj (py/vconj [] kind) payload) rest)\n   288\t                           (+ 1 (py/frame-depth rest)))\n   289\t                 (get (cell/get py.rt/ctx) :depth)))]\n   290\t    [py/pop-frame\n   291\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\n   292\t     (fn [hs]\n   293\t       (cell/set! py.rt/ctx\n   294\t                  (assoc (assoc (cell/get py.rt/ctx) :handlers (get hs 2))\n   295\t                         :depth (get hs 4))))]\n   296\t    [py/raise\n   297\t     (fn [e]\n   298\t       (let [hs (py/handlers)]\n   299\t         (if (nil? hs)\n   300\t           (:py/no-handler e)\n   301\t           (if (= (get hs 0) :finally)\n   302\t             (do (py/pop-frame hs)\n   303\t                 ((get hs 1) e)\n   304\t                 (py/raise e))\n   305\t             ((get hs 1) e)))))]\n   306\t    [py/unwind-to\n   307\t     ;; pop frames above frame count n, running each finally thunk with None\n   308\t     (fn [n]\n   309\t       (let [hs (py/handlers)]\n   310\t         (if (nil? hs)\n   311\t           :py/None\n   312\t           (if (<= (get hs 3) n)\n   313\t             :py/None\n   314\t             (do (py/pop-frame hs)\n   315\t                 (if (= (get hs 0) :finally) ((get hs 1) :py/None) :py/None)\n   316\t                 (py/unwind-to n))))))]\n   164\t     (fn [x] (if (php/int? x) (integer/to-float x) (data/float-value x)))]\n   165\t    [php/type-name\n   166\t     (fn [k]\n   167\t       (if (= k :string) \"string\"\n   168\t           (if (= k :int) \"int\"\n   169\t               (if (= k :float) \"float\"\n   170\t                   (if (= k :bool) \"bool\"\n   171\t                       (if (= k :null) \"null\"\n   172\t                           (if (= k :array) \"array\" \"mixed\")))))))]\n   173\t\n   174\t    ;; ---------------------------------------------------------------- escapes\n   175\t    ;; The dynamic context is one record in one cell: every capture point\n   176\t    ;; saves it and every escape restores it with :base left alone. The\n   177\t    ;; handler stack is a chain of frames [kind payload rest n depth].\n   178\t    [php/ctx\n   179\t     (fn [handlers depth base frame]\n   180\t       (assoc (assoc (assoc (assoc {} :handlers handlers) :depth depth)\n   181\t                     :base base)\n   182\t              :frame frame))]\n   183\t    [php/restore!\n   184\t     (fn [saved]\n   185\t       (cell/set! php.rt/ctx\n   186\t                  (assoc saved :base (get (cell/get php.rt/ctx) :base))))]\n   187\t    [php/handlers (fn [] (get (cell/get php.rt/ctx) :handlers))]\n   188\t    [php/set-handlers!\n   189\t     (fn [hs] (cell/set! php.rt/ctx (assoc (cell/get php.rt/ctx) :handlers hs)))]\n   190\t    [php/frame-depth (fn [hs] (if (nil? hs) 0 (get hs 3)))]\n   191\t    [php/frame\n   192\t     (fn [kind payload rest]\n   193\t       (php/vconj (php/vconj (php/vconj (php/vconj (php/vconj [] kind) payload) rest)\n   194\t                             (+ 1 (php/frame-depth rest)))\n   195\t                  (get (cell/get php.rt/ctx) :depth)))]\n   196\t    [php/pop-frame\n   197\t     ;; the handler stack below frame hs, at the call depth hs was pushed at\n   198\t     (fn [hs]\n   199\t       (cell/set! php.rt/ctx\n   200\t                  (assoc (assoc (cell/get php.rt/ctx) :handlers (get hs 2))\n   201\t                         :depth (get hs 4))))]\n   202\t    [php/missing-invariant-trap\n   203\t     ;; never called in a correct run: the two-operand `cell/new` is refused\n   204\t     ;; by the host primitive's arity, so reaching this point fails loudly\n   205\t     ;; at the host level instead of answering a value\n   206\t     (fn [msg] (cell/new msg :php/unexpected-second-operand))]\n   207\t    [php/invariant-violation\n   208\t     ;; a defect-loud failure for `php/raise` with an empty handler stack.\n   209\t     ;; Never call `php/root-fatal` here: with no escape installed it falls\n   210\t     ;; back to `php/raise`, which recurses.\n   211\t     (fn [msg] (php/missing-invariant-trap msg))]\n   212\t    [php/raise\n   213\t     ;; deliver the error to the innermost handler, running each :finally\n   214\t     ;; thunk it unwinds through; the unit root always installs a handler\n   215\t     ;; before any guest code (including request binding) runs, so an empty\n   216\t     ;; stack is an invariant violation and fails loudly\n   217\t     (fn [e]\n   218\t       (let [hs (php/handlers)]\n   219\t         (if (nil? hs)\n   220\t           (php/invariant-violation \"php/raise: empty handler stack\")\n   221\t           (if (= (get hs 0) :finally)\n   222\t             (do (php/pop-frame hs)\n   223\t                 ((get hs 1) e)\n   224\t                 (php/raise e))\n   225\t             ((get hs 1) e)))))]\n   226\t    [php/unwind-to\n   227\t     ;; pop frames above frame count n, running each finally thunk with null\n   228\t     (fn [n]\n   229\t       (let [hs (php/handlers)]\n   230\t         (if (nil? hs)\n   231\t           :php/null\n","exit_code":0,"status":"completed"}}
