\\\n   113\\\\\\\\t;; =============================================================================\\\\\\\\n   114\\\\\\\\t;; Unit paths and linker names (plan P6 R2/R3)\\\\\\\\n   115\\\\\\\\t;; =============================================================================\\\\\\\\n   116\\\\\\\\t\\\\\\\\n   117\\\\\\\\t(def ^:private unit-path-chars #\\\\\\\\\\\\\\\"[A-Za-z0-9_\\\\\\\\\\\\\\\\-./]*\\\\\\\\\\\\\\\")\\\\\\\\n   118\\\\\\\\t\\\\\\\\n   119\\\\\\\\t\\\\\\\\n   120\\\\\\\\t(defn normalize-unit-path\\\\\\\\n   121\\\\\\\\t  \\\\\\\\\\\\\\\"`{:path p}` for the relative path `s` normalized (segments joined by `/`,\\\\\\\\n   122\\\\\\\\t   `.` and empty segments dropped, `..` collapsed), else `{:error e}`:\\\\\\\\n   123\\\\\\\\t   `:unit-path` for a character outside `[A-Za-z0-9_\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\-./]`, `:include-path`\\\\\\\\n   124\\\\\\\\t   for an absolute path or one escaping the composition root.\\\\\\\\\\\\\\\"\\\\\\\\n   125\\\\\\\\t  [s]\\\\\\\\n   126\\\\\\\\t  (cond\\\\\\\\n   127\\\\\\\\t    (not (re-matches unit-path-chars s)) {:error :unit-path}\\\\\\\\n   128\\\\\\\\t    (str/starts-with? s \\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\") {:error :include-path}\\\\\\\\n   129\\\\\\\\t    :else (let [segs (reduce (fn [acc seg]\\\\\\\\n   130\\\\\\\\t                               (cond\\\\\\\\n   131\\\\\\\\t                                 (or (= seg \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\") (= seg \\\\\\\\\\\\\\\".\\\\\\\\\\\\\\\")) acc\\\\\\\\n   132\\\\\\\\t                                 (= seg \\\\\\\\\\\\\\\"..\\\\\\\\\\\\\\\") (if (empty? acc) (reduced nil) (pop acc))\\\\\\\\n   133\\\\\\\\t                                 :else (conj acc seg)))\\\\\\\\n   134\\\\\\\\t                             []\\\\\\\\n   135\\\\\\\\t                             (str/split s #\\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\"))]\\\\\\\\n   136\\\\\\\\t            (if (or (nil? segs) (empty? segs))\\\\\\\\n   137\\\\\\\\t              {:error :include-path}\\\\\\\\n   138\\\\\\\\t              {:path (str/join \\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\" segs)}))))\\\\\\\\n   139\\\\\\\\t\\\\\\\\n   140\\\\\\\\t\\\\\\\\n   141\\\\\\\\t(defn path-module-symbol\\\\\\\\n   142\\\\\\\\t  \\\\\\\\\\\\\\\"The linker module of unit path `path`: `phpm.` then the path with `/` as\\\\\\\\n   143\\\\\\\\t   `$` and `.` as `$$`, nothing dropped (injective: plan P6 R2).\\\\\\\\\\\\\\\"\\\\\\\\n   144\\\\\\\\t  [path]\\\\\\\\n   145\\\\\\\\t  (symbol (str \\\\\\\\\\\\\\\"phpm.\\\\\\\\\\\\\\\" (str/replace (str/replace path \\\\\\\\\\\\\\\"/\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"$\\\\\\\\\\\\\\\") \\\\\\\\\\\\\\\".\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"$$\\\\\\\\\\\\\\\"))))\\\\\\\\n   146\\\\\\\\t\\\\\\\\n   147\\\\\\\\t\\\\\\\\n   148\\\\\\\\t(def classmap-name\\\\\\\\n   149\\\\\\\\t  \\\\\\\\\\\\\\\"The unit name of the autoload class map; a unit path cannot begin with\\\\\\\\n   150\\\\\\\\t   `$`, so no unit collides with it.\\\\\\\\\\\\\\\"\\\\\\\\n   151\\\\\\\\t  \\\\\\\\\\\\\\\"$classmap\\\\\\\\\\\\\\\")\\\\\\\\n   152\\\\\\\\t\\\\\\\\n   153\\\\\\\\t\\\\\\\\n   154\\\\\\\\t(def classmap-module\\\\\\\\n   155\\\\\\\\t  \\\\\\\\\\\\\\\"The linker module of the class map.\\\\\\\\\\\\\\\"\\\\\\\\n   156\\\\\\\\t  (path-module-symbol classmap-name))\\\\\\\\n   157\\\\\\\\t\\\\\\\\n   158\\\\\\\\t\\\\\\\\n   159\\\\\\\\t(defn- path-dirname\\\\\\\\n   160\\\\\\\\t  \\\\\\\\\\\\\\\"PHP's `dirname` of the relative path `p`: `.` for a root unit.\\\\\\\\\\\\\\\"\\\\\\\\n   230\\\\\\\\t      (if (>= i len)\\\\\\\\n   231\\\\\\\\t        out\\\\\\\\n   232\\\\\\\\t        (let [c (subs body i (inc i))\\\\\\\\n   233\\\\\\\\t              e (when (< (inc i) len) (subs body (inc i) (+ i 2)))]\\\\\\\\n   234\\\\\\\\t          (cond\\\\\\\\n   235\\\\\\\\t            (not (and (= c \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\") e))\\\\\\\\n   236\\\\\\\\t            (let [cp (first (text/code-points (subs body i (min len (+ i 2)))))]\\\\\\\\n   237\\\\\\\\