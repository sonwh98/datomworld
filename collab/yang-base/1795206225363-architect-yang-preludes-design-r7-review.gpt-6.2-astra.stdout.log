\n    13\\\\\\\\t    (yang.php.antlr.gen\\\\\\\\n    14\\\\\\\\t      PhpLexer\\\\\\\\n    15\\\\\\\\t      PhpParser)))\\\\\\\\n    16\\\\\\\\t\\\\\\\\n    17\\\\\\\\t\\\\\\\\n    18\\\\\\\\t(def grammar-id\\\\\\\\n    19\\\\\\\\t  \\\\\\\\\\\\\\\"grammars-v4 php at its pinned revision, generated by ANTLR 4.13.2.\\\\\\\\\\\\\\\"\\\\\\\\n    20\\\\\\\\t  \\\\\\\\\\\\\\\"grammars-v4/php@85e2dd1779ce556111ef98ead5d62a9858e95599 antlr-4.13.2\\\\\\\\\\\\\\\")\\\\\\\\n    21\\\\\\\\t\\\\\\\\n    22\\\\\\\\t\\\\\\\\n    23\\\\\\\\t(def profile\\\\\\\\n    24\\\\\\\\t  {:grammar-id grammar-id,\\\\\\\\n    25\\\\\\\\t   :make-lexer (fn [cs] (PhpLexer. cs)),\\\\\\\\n    26\\\\\\\\t   :make-parser (fn [ts] (PhpParser. ts)),\\\\\\\\n    27\\\\\\\\t   :start (fn [^PhpParser p] (.htmlDocument p))})\\\\\\\\n    28\\\\\\\\t\\\\\\\\n    29\\\\\\\\t\\\\\\\\n    30\\\\\\\\t(defn make-worker\\\\\\\\n    31\\\\\\\\t  []\\\\\\\\n    32\\\\\\\\t  (cst/make-worker profile))\\\\\\\\n    33\\\\\\\\t\\\\\\\\n    34\\\\\\\\t\\\\\\\\n    35\\\\\\\\t(defn- generics?\\\\\\\\n    36\\\\\\\\t  [pk]\\\\\\\\n    37\\\\\\\\t  (boolean (some #(= \\\\\\\\\\\\\\\"typeParameterListInBrackets\\\\\\\\\\\\\\\" (:rule %))\\\\\\\\n    38\\\\\\\\t                 (:yang.cst/nodes pk))))\\\\\\\\n    39\\\\\\\\t\\\\\\\\n    40\\\\\\\\t\\\\\\\\n    41\\\\\\\\t(defn- line-starts\\\\\\\\n    42\\\\\\\\t  \\\\\\\\\\\\\\\"The UTF-8 byte offsets at which each source line begins (the line side\\\\\\\\n    43\\\\\\\\t   table, section 17: derived at the parse boundary, where the source is\\\\\\\\n    44\\\\\\\\t   known, so no later stage needs the text).\\\\\\\\\\\\\\\"\\\\\\\\n    45\\\\\\\\t  [^String source]\\\\\\\\n    46\\\\\\\\t  (let [bs (.getBytes source \\\\\\\\\\\\\\\"UTF-8\\\\\\\\\\\\\\\")]\\\\\\\\n    47\\\\\\\\t    (into [0] (keep-indexed (fn [i b] (when (= b 10) (inc i)))) bs)))\\\\\\\\n    48\\\\\\\\t\\\\\\\\n    49\\\\\\\\t\\\\\\\\n    50\\\\\\\\t(defn parse-source\\\\\\\\n    51\\\\\\\\t  \\\\\\\\\\\\\\\"Parse one complete PHP source string as unit `unit`: the CST packet, or\\\\\\\\n    52\\\\\\\\t   `{:yang.php/not-php :generics}` when the parse uses the grammar's generics\\\\\\\\n    53\\\\\\\\t   extension.\\\\\\\\\\\\\\\"\\\\\\\\n    54\\\\\\\\t  ([source] (parse-source (make-worker) [:unit 0] source))\\\\\\\\n    55\\\\\\\\t  ([worker unit source]\\\\\\\\n    56\\\\\\\\t   (let [pk (cst/parse-unit worker unit source)]\\\\\\\\n    57\\\\\\\\t     (if (generics? pk)\\\\\\\\n    58\\\\\\\\t       {:yang.php/not-php :generics}\\\\\\\\n    59\\\\\\\\t       (assoc pk :yang.php/line-starts (line-starts source))))))\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_13\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"agent_message\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"The existing dynamic-scope model gives eval a useful starting point: functions with eval are marked for a heap scope, and included units already accept the caller’s `%scope` and `%ctx`. I’m checking how to reuse that path without reinitializing PHP state or resetting the run’s safepoint counter.\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_14\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"nl -ba src/cljc/yang/php/antlr/lower.cljc | sed -n '1,160p;230,380p;1740,1885p;3075,3140p;3180,3235p;3610,3807p;3835,3860p;3990,4048p'\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\n{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_14\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"nl -ba src/cljc/yang/php/antlr/lower.cljc | sed -n '1,160p;230,380p;1740,1885p;3075,3140p;3180,3235p;3610,3807p;3835,3860p;3990,4048p'\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"     1\\\\\\\\t(ns yang.php.antlr.lower\\\\\\\\n     2\\\\\\\\t  \\\\\\\\\\\\\\\"The PHP lowering interpreter: CST packets in, Universal AST program\\\\\\\\n     3\\\\\\\\t   batches out (docs/design/yang.php.md sections 3, 7). Portable.\\\\\\\\n     4\\\\\\\\t\\\\\\\\n     5\\\\\\\\t   Per packet: validate the tree, analyze scopes (`yang.php.antlr.scope`),\\\\\\\\n     6\\\\\\\\t   then lower with one `case` arm per grammar rule. A rule P1 does not lower\\\\\\\\n     7\\\\\\\\t   fails with `:yang.php/unsupported` naming the rule and construct; a rule\\\\\\\\n     8\\\\\\\\t   with no arm fails with `:yang.php/unhandled-rule`. Nothing is silently\\\\\\\\n     9\\\\\\\\t   dropped.\\\\\\\\n    10\\\\\\\\t\\\\\\\\n    11\\\\\\\\t   Decided lowering rules (collab/1792905000000 plan):\\\\\\\\n    12\\\\\\\\t   - A top-level `$x` is `(php/global-get \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"x\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")` / `(php/global-set! \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"x\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" v)`;\\\\\\\\n    13\\\\\\\\t     inside a function it is a lexical cell `$x` allocated at entry holding\\\\\\\\n    14\\\\\\\\t     `:php/undef`. Loops are self-applied `:loop`-marked lambdas whose\\\\\\\\n    15\\\\\\\\t     `break`/`continue` are `php/call-ec` escapes bound to `%brk<id>` and\\\\\\\\n    16\\\\\\\\t     `%cont<id>`, created only when the body uses them; the `:loops` stack of\\\\\\\\n    17\\\\\\\\t     the context resolves `break n`. `switch` is one stack level: a chain of\\\\\\\\n    18\\\\\\\\t     lambdas whose bodies tail-call the next case.\\\\\\\\n    19\\\\\\\\t   - A function is `(php/declare-function! name (php/make-function name spec\\\\\\\\n    20\\\\\\\\t     (fn [%fn %args] body) statics))`; top-level unconditional declarations\\\\\\\\n    21\\\\\\\\t     are hoisted. `return` is an escape from `php/call-ec`, bound only when\\\\\\\\n    22\\\\\\\\t     the body has a `return`.\\\\\\\\n    23\\\\\\\\t   - The unit is its hoisted top-level function declarations, then its\\\\\\\\n    24\\\\\\\\t     statements in order, run under `php/run-main`.\\\\\\\\n    25\\\\\\\\t   - Inline HTML is `(php/echo \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"bytes\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")`; `echo a, b` is\\\\\\\\n    26\\\\\\\\t     `(php/echo (php/to-string a))` per operand; a PHP string is a byte\\\\\\\\n    27\\\\\\\\t     carrier (a latin-1 string), literal text resolved here to UTF-8 bytes.\\\\\\\\n    28\\\\\\\\t   - `&&`, `||`, `and`, `or`, `?:` are `:if` nodes over `php/to-bool`, never\\\\\\\\n    29\\\\\\\\t     applications, so they short circuit. Every other operator is one\\\\\\\\n    30\\\\\\\\t     application of a `php/` function of the prelude.\\\\\\\\n    31\\\\\\\\t   - A call `f(a, b)` resolves `f` before any argument runs:\\\\\\\\n    32\\\\\\\\t     `(let [%f (php/resolve-fn \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"f\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"F\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")] (php/call %f [a b]))`.\\\\\\\\n    33\\\\\\\\t   - Generated names are `%<prefix><cst-id>`; `%` cannot begin a PHP name, so\\\\\\\\n    34\\\\\\\\t     no guest name shadows a name the lowering emits. The lowering never\\\\\\\\n    35\\\\\\\\t     names a runtime key (`php.rt/*`).\\\\\\\\n    36\\\\\\\\t\\\\\\\\n    37\\\\\\\\t   Diagnostic namespace: \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"yang.php\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\".\\\\\\\\\\\\\\\"\\\\\\\\n    38\\\\\\\\t  (:require\\\\\\\\n    39\\\\\\\\t    [clojure.string :as str]\\\\\\\\n    40\\\\\\\\t    [clojure.walk :as walk]\\\\\\\\n    41\\\\\\\\t    [dao.host.text :as text]\\\\\\\\n    42\\\\\\\\t    [dao.jing.cbor :as cbor]\\\\\\\\n    43\\\\\\\\t    [yang.antlr.packet :as p]\\\\\\\\n    44\\\\\\\\t    [yang.core.lower :as core]\\\\\\\\n    45\\\\\\\\t    [