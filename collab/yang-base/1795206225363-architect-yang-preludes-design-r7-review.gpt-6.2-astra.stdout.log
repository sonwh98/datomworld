{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '64,182p' src/cljc/yin/repl/frontends.cljc && nl -ba src/cljc/yin/repl.cljc | sed -n '2340,2390p' && rg -n 'python-manifest|:yang.python/antlr|:yang.frontend/revision' src | head -130\"","aggregated_output":"  [forms]\n  (if (= 1 (count forms))\n    (yang.clojure/compile (first forms))\n    (yang.clojure/compile-program forms)))\n\n\n(defn- antlr-manifest\n  []\n  (assoc (manifest :yang/python :python)\n         :yang.frontend/revision \"f4\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"python3\",\n          :yang.grammar/entries {:module \"file_input\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript :dart}}))\n\n\n(defn php-manifest\n  []\n  (assoc (manifest :yang/php :php)\n         :yang.frontend/revision \"antlr-p8\"\n         :yang.frontend/grammar\n         {:yang.grammar/package \"php\",\n          :yang.grammar/entries {:module \"htmlDocument\"},\n          :yang.grammar/export-profile :yang.cst/v1,\n          :yang.grammar/targets #{:java :javascript}}\n         :yang.frontend/lowering-profile :yang.php/antlr\n         :yang.frontend/runtime-profile :yang.php/antlr\n         :yang.frontend/support-profile :yang.php/antlr))\n\n\n(defn standard\n  \"The standard catalog. The Clojure frontend consumes the forms the\n   shell's own reader read, so its parse stage is the identity. The ANTLR\n   frontends show what a submission printed and the value their `:render`\n   returns.\"\n  []\n  (cond-> frontend/empty-catalog\n    true (frontend/install (clojure-manifest)\n                           {:input :forms,\n                            :parse identity,\n                            :lower clojure-lower})\n    #?@(:cljd []\n        :jolt []\n        :default [true (frontend/install\n                         (php-manifest)\n                         {:parse php.antlr.cst/parse-source,\n                          :lower php.antlr.lower/lower-packet,\n                          :render :php/out})])\n    #?@(:cljd [true (frontend/install\n                      (antlr-manifest)\n                      {:parse (fn [source]\n                                (python.antlr.parser/parse-source (str source \"\\n\"))),\n                       :lower python.antlr.repl/lower,\n                       :primitives python.antlr.repl/primitives,\n                       :lower-session python.antlr.repl/lower-session,\n                       :render python.antlr.repl/display-value,\n                       :probe python.antlr.probe/probe})]\n        ;; jolt (J5): installed over the C++ parser when native/jolt-parser\n        ;; is available; otherwise left out, so (lang :yang/python) answers\n        ;; unavailable-parser, never another parser\n        :jolt [(python.antlr.parser/available?)\n               (frontend/install\n                 (antlr-manifest)\n                 {;; a :parser-budget or :unavailable-parser refusal names\n                  ;; the language it refused\n                  :parse (fn [source]\n                           (try (python.antlr.parser/parse-source (str source \"\\n\"))\n                                (catch Exception e\n                                  (if (#{:parser-budget :unavailable-parser}\n                                       (:diagnostic (ex-data e)))\n                                    (throw (ex-info (ex-message e)\n                                                    (assoc (ex-data e) :lang :yang/python)\n                                                    e))\n                                    (throw e))))),\n                  :lower python.antlr.repl/lower,\n                  :primitives python.antlr.repl/primitives,\n                  :lower-session python.antlr.repl/lower-session,\n                  :render python.antlr.repl/display-value,\n                  :probe python.antlr.probe/probe})]\n        :default [true (frontend/install\n                         (antlr-manifest)\n                         {:parse (fn [source]\n                                   (python.antlr.parser/parse-source (str source \"\\n\"))),\n                          :lower python.antlr.repl/lower,\n                          :primitives python.antlr.repl/primitives,\n                          :lower-session python.antlr.repl/lower-session,\n                          :render python.antlr.repl/display-value,\n                          :probe python.antlr.probe/probe})])))\n\n\n(defn create-state\n  \"`yin.repl/create-state` composed with the standard catalog unless the\n   host supplies its own `:frontends`.  Each binding registers its own\n   `:primitives`; none is merged ambiently.\"\n  ([] (create-state {}))\n  ([opts]\n   (repl/create-state (update opts :frontends #(or % (standard))))))\n  2340\t\n  2341\t\n  2342\t(defn- installed-text\n  2343\t  \"The languages and ids `catalog` holds, for a refused selection to name:\n  2344\t   a name that is neither is a typo, not a missing frontend.\"\n  2345\t  [catalog]\n  2346\t  (let [entries (:yang.frontend/entries catalog)\n  2347\t        listed (fn [xs] (str/join \" \" (map pr-str (sort (distinct xs)))))]\n  2348\t    (str \"installed: \"\n  2349\t         (listed (map (comp :yang.frontend/language :manifest) (vals entries)))\n  2350\t         \" (ids \" (listed (map first (keys entries))) \")\")))\n  2351\t\n  2352\t\n  2353\t(defn- select-frontend\n  2354\t  \"Select the frontend `lang` names in `catalog`: a qualified id selects\n  2355\t   by id (ambiguous when several revisions are installed), `[id revision]`\n  2356\t   pins one revision; anything else is refused — the selector is the\n  2357\t   frontend id, never a language keyword.\"\n  2358\t  [catalog lang]\n  2359\t  (cond\n  2360\t    (vector? lang) (frontend/select catalog\n  2361\t                                    {:yang.frontend/id (first lang),\n  2362\t                                     :yang.frontend/revision (second lang)})\n  2363\t    (qualified-keyword? lang) (frontend/select catalog\n  2364\t                                               {:yang.frontend/id lang})\n  2365\t    :else (frontend/refused :yang.frontend/unknown {:id lang})))\n  2366\t\n  2367\t\n  2368\t(defn- selected-primitives\n  2369\t  \"The `:primitives` the binding selected by `lang` registers, else {}.\n  2370\t   A language's primitives belong to its binding; the primitives of\n  2371\t   unselected languages are never merged into the session.\"\n  2372\t  [catalog lang]\n  2373\t  (or (:primitives (:binding (select-frontend catalog lang))) {}))\n  2374\t\n  2375\t\n  2376\t(defn- switch-lang\n  2377\t  \"Select `lang`: its binding's primitives replace the previous binding's\n  2378\t   in the live VM (host `:extra-primitives` stay over them), and the\n  2379\t   frontend session is dropped.\"\n  2380\t  [state lang]\n  2381\t  (let [new (selected-primitives (:frontends state) lang)]\n  2382\t    (-> state\n  2383\t        (assoc :lang lang :frontend-session nil)\n  2384\t        (assoc-in [:vm :primitives]\n  2385\t                  (merge (make-repl-primitives (:output-stream state))\n  2386\t                         new\n  2387\t                         (:extra-primitives state))))))\n  2388\t\n  2389\t\n  2390\t(defn- usable-binding\nsrc/cljc/yang/frontend.cljc:31:    :yang.frontend/incompatible-spi :yang.frontend/revision-conflict\nsrc/cljc/yang/frontend.cljc:92:   [:yang.frontend/revision #(and (string? %) (seq %))]\nsrc/cljc/yang/frontend.cljc:163:  [(:yang.frontend/id m) (:yang.frontend/revision m)])\nsrc/cljc/yang/frontend.cljc:180:              :else (refused :yang.frontend/revision-conflict\nsrc/cljc/yang/frontend.cljc:195:   optionally `:yang.frontend/revision` and any other manifest key\nsrc/cljc/yang/frontend.cljc:205:        revision (:yang.frontend/revision request)\nsrc/cljc/yang/frontend.cljc:206:        pins (dissoc request :yang.frontend/id :yang.frontend/revision)\nsrc/cljc/yin/repl/frontends.cljc:31:   :yang.frontend/revision \"legacy-1\",\nsrc/cljc/yin/repl/frontends.cljc:58:         :yang.frontend/revision \"c1-2\"\nsrc/cljc/yin/repl/frontends.cljc:73:         :yang.frontend/revision \"f4\"\nsrc/cljc/yin/repl/frontends.cljc:84:         :yang.frontend/revision \"antlr-p8\"\nsrc/cljc/yin/repl.cljc:2362:                                     :yang.frontend/revision (second lang)})\n","exit_code":0,"status":"completed"}}
