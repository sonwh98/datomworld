tore-keys (:store-keys own)\n    82\t       :effects (into (or (:effects own) #{})\n    83\t                      (concat (mapcat :yin.k/effects (vals primitives))\n    84\t                              (mapcat (fn [address]\n    85\t                                        (get-in (jing/get handle address nil)\n    86\t                                                [:yin.module/footprint :effects]))\n    87\t                                      (vals requires))))})))\n832:                                       [:yin.module/footprint :effects])))\n   994\t(def ^:private continuation-uast\n   995\t  \"The continuation family tree: define every `clj/` entry (store-defined,\n   996\t   like `yang.core.call/uast`) then allocate the `clj.rt/ctx` cell. The\n   997\t   family's capture-sensitive primitives are the `dsg__*` names, bound at\n   998\t   emission by `compile-program`.\"\n   999\t  (u/then\n  1000\t    (reduce (fn [ast [key form]]\n  1001\t              (u/then ast (u/def! key (u/sexp->uast form))))\n  1002\t            (u/lit nil)\n  1003\t            continuation-family)\n  1004\t    (u/def! 'clj.rt/ctx\n  1005\t            (u/app (u/v 'cell/new) (u/app (u/v 'clj/ctx) (u/lit nil))))))\n","exit_code":0,"status":"completed"}}
