{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '200,255p' src/cljc/dao/jing/cbor.cljc\nsed -n '128,184p' src/cljc/dao/host/integer.cljc\nrg -n 'defn.*(float-digits|signed|fields)' src/cljc/dao/host/float.cljc\nrg --files /tmp | rg 'p0prime|prelude.*test|float.*test' | head -20\"","aggregated_output":"\n(defn- host-integer?\n  \"True for an exact integer in any host carrier, and on JavaScript also\n   for an integral Number beyond +/-(2^53 - 1), which is integer content\n   whose value is already rounded (callers refuse it); never a JS -0.\"\n  [x]\n  (or (integer/exact-integer? x)\n      #?(:cljs (and (number? x) (js/Number.isInteger x)\n                    (not (js/Number.isSafeInteger x)))\n         :default false)))\n\n\n(defn float64?\n  \"True for floating-point content: Double or Float on the JVM, the\n   Float64 carrier or a non-integral, non-finite or negative-zero number\n   on JavaScript, a double on Dart.\"\n  [x]\n  #?(:cljd (dart/is? x double)\n     :clj (or (instance? Double x) (instance? Float x))\n     :cljs (or (instance? number/Float64 x)\n               (and (number? x) (not (host-integer? x))))))\n\n\n(defn decimal?\n  \"True for decimal content: BigDecimal on the JVM, the Decimal carrier on\n   JavaScript and Dart.\"\n  [x]\n  (number/decimal? x))\n\n\n(defn ratio?\n  \"True for rational content: clojure.lang.Ratio or the Rational carrier.\"\n  [x]\n  (number/ratio? x))\n\n\n(defn numeric?\n  \"True for every value the portable numeric operations accept.\"\n  [x]\n  (or (host-integer? x) (float64? x) (decimal? x) (ratio? x)))\n\n\n(defn float64\n  \"Floating-point content with the value of host number x: a Double on\n   the JVM, the Float64 carrier on JavaScript (so integral floats such as\n   1.0 keep their kind).\"\n  [x]\n  (number/float64-of x))\n\n\n(defn float64-from-bits\n  \"Floating-point content with the IEEE-754 bits given as 16 lowercase\n   hex digits.\"\n  [hex]\n  (number/float64-of (host float/bits->float64 hex)))\n\n;; =============================================================================\n\n(defn promote\n  \"The host big integer of exact-integer carrier `x`. The caller has\n   checked `exact-integer?`.\"\n  [x]\n  #?(:cljd (if (dart/is? x BigInt) x (BigInt.from x))\n     :clj (cond (instance? BigInteger x) x\n                (instance? clojure.lang.BigInt x)\n                (.toBigInteger ^clojure.lang.BigInt x)\n                :else (BigInteger/valueOf (long x)))\n     :cljs (if (js-bigint? x) x (js/BigInt x))))\n\n\n(defn from-native\n  \"The host big integer of a native integer `n` the kernels computed\n   themselves, such as a digit or a chunk value.\"\n  [n]\n  #?(:cljd (BigInt.from n)\n     :clj (BigInteger/valueOf (long n))\n     :cljs (js/BigInt n)))\n\n\n#?(:cljs\n   (def ^:private js-zero (js/BigInt 0)))\n\n\n#?(:cljs\n   (def ^:private js-max-safe (js/BigInt 9007199254740991)))\n\n\n#?(:cljs\n   (def ^:private js-min-safe (js/BigInt -9007199254740991)))\n\n\n(defn demote\n  \"The canonical carrier of host big integer `b`: native iff `b` is in\n   the host's native range, else the host big carrier.\"\n  [b]\n  #?(:cljd (if (.-isValidInt ^BigInt b) (.toInt ^BigInt b) b)\n     :clj (if (< (.bitLength ^BigInteger b) 64)\n            (.longValue ^BigInteger b)\n            (clojure.lang.BigInt/fromBigInteger b))\n     :cljs (if (js* \"(~{} <= ~{} && ~{} <= ~{})\" js-min-safe b b js-max-safe)\n             (js/Number b)\n             b)))\n\n\n(defn to-native\n  \"Host big integer `b` as a native integer. The caller has checked that\n   `b` lies within +/-(2^53 - 1).\"\n  [b]\n  #?(:cljd (.toInt ^BigInt b)\n     :clj (.longValue ^BigInteger b)\n     :cljs (js/Number b)))\n\n\n136:(defn fields\n188:(defn signed\n353:(defn float-digits\nrg: /tmp/codex-daemon-501: Operation not permitted (os error 1)\n/tmp/datom-finally-oracle/collab/general/tiers-runs/yang.python.antlr.prelude-parity-test.quick.log\n/tmp/datom-finally-oracle/collab/general/tiers-runs/yang.python.antlr.prelude-parity-test.slow.log\n","exit_code":0,"status":"completed"}}
