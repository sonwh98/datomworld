ttern pattern}))\n   507\t              (when (or (nil? (next xs)) (= :as (second xs)))\n   901\t(def ^:private error-tag :yin.k/error)\n   902\t\n   903\t\n   904\t(defn- outcomes?\n   905\t  [env]\n   906\t  (some? (::outcomes env)))\n   907\t\n   908\t\n   909\t(defn- rebuild\n   910\t  \"A list of `items` carrying the reader metadata of `form`.\"\n   911\t  [form items]\n   912\t  (let [out (apply list items)]\n   913\t    (if-let [m (meta form)]\n   914\t      (with-meta out m)\n   915\t      out)))\n   916\t\n   917\t\n   918\t;; =============================================================================\n   919\t;; The clj continuation family (R3 §8.10.7; the (B) port)\n   920\t;; =============================================================================\n   921\t;;\n   922\t;; The port converges clojure's exception lowering onto the continuation\n   923\t;; encoding: a `%capture` handler stack in a dynamic-context cell, exactly\n   924\t;; like the py/ts/php preludes (`yang.clojure.prelude` carries the reference\n   925\t;; implementation under `clj/`). A source `(throw e)` lowers to `clj/throw`,\n   926\t;; `(try ...)` to `clj/try`/`clj/try-finally`, and function bodies return\n   927\t;; plain values. A guest call delivers a callee's escaping condition through\n   928\t;; the §8.10.7 raise exit, and the public entry installs the same bridge.\n   929\t;; Ordinary thrown values remain raw; protocol conditions travel in a\n   930\t;; provenance carrier. `compile-program` emits this family\n   931\t;; inline (the linked runtime binds the same family from the prelude); it\n   932\t;; routes the capture-sensitive primitives through the `dsg__*` helpers so a\n   933\t;; program definition of `get`/`assoc`/`=` cannot capture a frame access.\n   934\t\n   935\t(def ^:private continuation-family\n   936\t  \"The `clj/` continuation family, `[key form]` in prelude notation (each\n   937\t   form is read with `u/sexp->uast`). Mirrors `yang.clojure.prelude`'s\n   938\t   escapes section, minus `call-ec`/`unwind-to` (clojure has no\n   939\t   break/continue/return escapes). The handler stack is a chain of frames\n   940\t   [tag payload rest n]; a `:handler` frame holds the continuation\n   941\t   `clj/raise` delivers to, a `:finally` frame a one-argument thunk every\n   942\t   exit through it runs.\"\n   943\t  '[[clj/ctx (fn [hs] (dsg__assoc {} :handlers hs))]\n   944\t    [clj/handlers (fn [] (dsg__get (cell/get clj.rt/ctx) :handlers))]\n   945\t    [clj/set-handlers!\n   946\t     (fn [hs]\n   947\t       (cell/set! clj.rt/ctx (dsg__assoc (cell/get clj.rt/ctx) :handlers hs)))]\n   948\t    [clj/restore! (fn [saved] (cell/set! clj.rt/ctx saved))]\n   949\t    [clj/frame-depth (fn [hs] (if (dsg__equal hs nil) 0 (dsg__get hs 3)))]\n   950\t    [clj/frame\n   951\t     (fn [tag payload rest]\n   952\t       (conj (conj (conj (conj [] tag) payload) rest)\n   953\t             (+ 1 (clj/frame-depth rest))))]\n   954\t    [clj/pop-frame\n   955\t     (fn [hs]\n   956\t       (cell/set! clj.rt/ctx\n   957\t                  (dsg__assoc (cell/get clj.rt/ctx) :handlers (dsg__get hs 2))))]\n   958\t    [clj/raise\n   959\t     (fn [e]\n   960\t       (let [hs (clj/handlers)]\n   961\t         (if (dsg__equal hs nil)\n   962\t           (dsg__get e :clj/no-handler)\n   963\t           (if (dsg__equal (dsg__get hs 0) :finally)\n   964\t             (do (clj/pop-frame hs) ((dsg__get hs 1) e) (clj/raise e))\n   965\t             ((dsg__get hs 1) e)))))]\n   966\t    [clj/throw (fn [e] (clj/raise e))]\n   967\t    [clj/try\n   968\t     (fn [body handler]\n   969\t       (let [saved (cell/get clj.rt/ctx)\n   970\t             flag (cell/new :first)]\n   971\t         ((fn [r]\n   972\t            (if (dsg__equal (cell/get flag) :first)\n   973\t              (do (cell/set! flag :re-entered)\n   974\t                  (clj/set-handlers! (clj/frame :handler r (dsg__get saved :handlers)))\n   975\t                  (let [v (body)] (do (c