    :clj (or (instance? Double x) (instance? Float x))\n   219\t     :cljs (or (instance? number/Float64 x)\n   220\t               (and (number? x) (not (host-integer? x))))))\n   221\t\n   222\t\n   223\t(defn decimal?\n   224\t  \"True for decimal content: BigDecimal on the JVM, the Decimal carrier on\n   225\t   JavaScript and Dart.\"\n   226\t  [x]\n   227\t  (number/decimal? x))\n   228\t\n   229\t\n   230\t(defn ratio?\n   231\t  \"True for rational content: clojure.lang.Ratio or the Rational carrier.\"\n   232\t  [x]\n   233\t  (number/ratio? x))\n   234\t\n   235\t\n   236\t(defn numeric?\n   237\t  \"True for every value the portable numeric operations accept.\"\n   238\t  [x]\n   239\t  (or (host-integer? x) (float64? x) (decimal? x) (ratio? x)))\n","exit_code":0,"status":"completed"}}
