{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yang/core/call.cljc'","aggregated_output":"     1\t(ns yang.core.call\n     2\t  \"Language-neutral guest calling convention (docs/design/yang.antlr.md\n     3\t   §8.10). This namespace emits the same pure definitions into bundled\n     4\t   preludes and the linked `yang.call` module.\"\n     5\t  (:require [yang.core.prelude :as core]\n     6\t            [yang.core.prelude-admission :as prelude-admission]\n     7\t            [yang.core.uast :as u]))\n     8\t\n     9\t\n    10\t(def module-name\n    11\t  \"The linker module that publishes the shared calling runtime.\"\n    12\t  'yang.call)\n    13\t\n    14\t\n    15\t(def host-names\n    16\t  \"Host module names read by the guest definitions.\"\n    17\t  '#{cell/get cell/authentic? data/callable? data/contains? data/count\n    18\t     data/map? data/nth data/string? data/vector?})\n    19\t\n    20\t\n    21\t(def definitions\n    22\t  \"The one ordered definition list used by both emitters.\"\n    23\t  '[;; Descriptor projection remains structural after callable admission,\n    24\t    ;; with one ruling-of-record refinement: a `:cell-ref`-shaped map is\n    25\t    ;; dereferenced only when the heap authenticates it (`cell/authentic?`,\n    26\t    ;; the issuer's own answer). A map that imitates the reference language\n    27\t    ;; is data, so it projects to itself and its fate follows the ordinary\n    28\t    ;; descriptor rules, exactly as any other map's would.\n    29\t    [yang.call/_descriptor\n    30\t     (fn [callable]\n    31\t       (if (data/map? callable)\n    32\t         (if (if (= (get callable :type) :cell-ref)\n    33\t               (cell/authentic? callable)\n    34\t               false)\n    35\t           (cell/get callable)\n    36\t           callable)\n    37\t         nil))]\n    38\t    [yang.call/entry\n    39\t     (fn [callable]\n    40\t       (get (yang.call/_descriptor callable) :yang.call/entry))]\n    41\t    [yang.call/eligible?\n    42\t     (fn [callable]\n    43\t       (let [descriptor (yang.call/_descriptor callable)]\n    44\t         (if (nil? (yang.call/entry callable))\n    45\t           false\n    46\t           (if (data/contains? descriptor :yang.call/eligible?)\n    47\t             ((get descriptor :yang.call/eligible?) callable)\n    48\t             true))))]\n    49\t    [yang.call/invocation\n    50\t     (fn [callee positional named raise]\n    51\t       (assoc (assoc (assoc (assoc {} :yang.call/callee callee)\n    52\t                            :yang.call/positional positional)\n    53\t                     :yang.call/named named)\n    54\t              :yang.call/raise raise))]\n    55\t    [yang.call/invocation-with\n    56\t     (fn [callee positional named raise options]\n    57\t       (assoc (assoc (assoc (assoc options :yang.call/callee callee)\n    58\t                            :yang.call/positional positional)\n    59\t                     :yang.call/named named)\n    60\t              :yang.call/raise raise))]\n    61\t    [yang.call/_pair?\n    62\t     (fn [pair]\n    63\t       (if (data/vector? pair)\n    64\t         (= (data/count pair) 2)\n    65\t         false))]\n    66\t    [yang.call/_named-pairs?\n    67\t     (fn [pairs index]\n    68\t       (if (= index (data/count pairs))\n    69\t         true\n    70\t         (let [pair (data/nth pairs index)]\n    71\t           (if (yang.call/_pair? pair)\n    72\t             (if (data/string? (data/nth pair 0))\n    73\t               (yang.call/_named-pairs? pairs (+ index 1))\n    74\t               false)\n    75\t             false))))]\n    76\t    [yang.call/valid-invocation?\n    77\t     (fn [invocation]\n    78\t       (if (data/map? invocation)\n    79\t         (if (data/contains? invocation :yang.call/callee)\n    80\t           (if (data/contains? invocation :yang.call/positional)\n    81\t             (if (data/contains? invocation :yang.call/named)\n    82\t               (if (data/contains? invocation :yang.call/raise)\n    83\t                 (if (data/vector? (get invocation :yang.call/positional))\n    84\t                   (if (data/vector? (get invocation :yang.call/named))\n    85\t                     (yang.call/_named-pairs?\n    86\t                       (get invocation :yang.call/named) 0)\n    87\t                     false)\n    88\t                   false)\n    89\t                 false)\n    90\t               false)\n    91\t             false)\n    92\t           false)\n    93\t         false))]\n    94\t    [yang.call/condition\n    95\t     (fn [reason evidence]\n    96\t       (assoc (assoc {} :yang.call/reason reason)\n    97\t              :yang.call/data evidence))]\n    98\t    [yang.call/thrown\n    99\t     (fn [value]\n   100\t       (assoc (assoc {} :yang.call/reason :yang.call/thrown)\n   101\t              :yang.call/value value))]\n   102\t    [yang.call/transfer\n   103\t     (fn [raise condition]\n   104\t       (raise condition))]\n   105\t    [yang.call/invoke\n   106\t     (fn [callable positional named raise]\n   107\t       (if (data/callable? raise)\n   108\t         (if (yang.call/eligible? callable)\n   109\t           (let [target (yang.call/entry callable)\n   110\t                 record (yang.call/invocation callable positional named raise)]\n   111\t             (if (not (nil? target))\n   112\t               (if (yang.call/valid-invocation? record)\n   113\t                 (target record)\n   114\t                 (yang.call/transfer\n   115\t                   raise\n   116\t                   (yang.call/condition :yang.call/invalid-invocation\n   117\t                                        {:yang.call/callee callable})))\n   118\t               (yang.call/transfer\n   119\t                 raise\n   120\t                 (yang.call/condition :yang.call/invalid-invocation\n   121\t                                      {:yang.call/callee callable}))))\n   122\t           (yang.call/transfer\n   123\t             raise\n   124\t             (yang.call/condition :yang.call/not-callable\n   125\t                                  {:yang.call/callee callable})))\n   126\t         (raise (yang.call/condition :yang.call/invalid-invocation\n   127\t                                     {:yang.call/reason :missing-raise-exit}))))]\n   128\t    [yang.call/invoke-with\n   129\t     (fn [callable positional named raise options]\n   130\t       (if (data/callable? raise)\n   131\t         (if (yang.call/eligible? callable)\n   132\t           (let [target (yang.call/entry callable)\n   133\t                 record (yang.call/invocation-with\n   134\t                          callable positional named raise options)]\n   135\t             (if (not (nil? target))\n   136\t               (if (yang.call/valid-invocation? record)\n   137\t                 (target record)\n   138\t                 (yang.call/transfer\n   139\t                   raise\n   140\t                   (yang.call/condition :yang.call/invalid-invocation\n   141\t                                        {:yang.call/callee callable})))\n   142\t               (yang.call/transfer\n   143\t                 raise\n   144\t                 (yang.call/condition :yang.call/invalid-invocation\n   145\t                                      {:yang.call/callee callable}))))\n   146\t           (yang.call/transfer\n   147\t             raise\n   148\t             (yang.call/condition :yang.call/not-callable\n   149\t                                  {:yang.call/callee callable})))\n   150\t         (raise (yang.call/condition :yang.call/invalid-invocation\n   151\t                                     {:yang.call/reason :missing-raise-exit}))))]])\n   152\t\n   153\t\n   154\t(def ^:private public-exports\n   155\t  '#{entry eligible? invocation invocation-with valid-invocation? condition\n   156\t     thrown transfer invoke invoke-with})\n   157\t\n   158\t\n   159\t(def uast\n   160\t  \"The bundled definitions, in source order and tail marked.\"\n   161\t  (u/mark-tails (core/definitions->uast definitions)))\n   162\t\n   163\t\n   164\t(def module-uast\n   165\t  \"The linked module tree built from the same `definitions`. C1\n   166\t   finalized, like every published production tree: its\n   167\t   `:yang/call-site` markers publish beside its manifest (see\n   168\t   `yin.vm.linker.publish`).\"\n   169\t  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n   170\t                                          [] definitions)]\n   171\t    (u/annotate-call-sites (core/module-tree stripped []))))\n   172\t\n   173\t\n   174\t(def module-exports\n   175\t  \"Public module exports (private helper definitions stay internal).\"\n   176\t  public-exports)\n   177\t\n   178\t\n   179\t(def ^:private module-free-names\n   180\t  (core/free-name-vec module-uast))\n   181\t\n   182\t\n   183\t(defn module-spec\n   184\t  \"The linker module spec for `yang.call` over `registry`.\"\n   185\t  [registry]\n   186\t  (prelude-admission/module-spec\n   187\t    {:module-name module-name\n   188\t     :ast module-uast\n   189\t     :exports module-exports\n   190\t     :requires {}\n   191\t     :free-names module-free-names\n   192\t     :registry registry\n   193\t     :message \"the yang.call module reads an undeclared name\"\n   194\t     :refusal-ns \"yang.call\"}))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/data.cljc | sed -n '1,135p;330,602p'\"","aggregated_output":"     1\t(ns yin.vm.data\n     2\t  \"The `data` host module: pure collection and string primitives a\n     3\t   language prelude is written over (Architect ruling on mutable guest\n     4\t   objects, Q5 and Q6).\n     5\t\n     6\t   Every export is `:pure` with declared effects `#{}`. The module is not\n     7\t   part of `yin.vm/primitives`: a composition whose language runtime\n     8\t   profile names it installs it explicitly with `register-data-module`,\n     9\t   and Yin source reaches the exports as `data/count`, `data/substring`\n    10\t   and so on. Under explicit limits it also exports `max-items`, the\n    11\t   composition's sequence-size limit (`register-data-module`).\n    12\t\n    13\t   Results are identical on CLJ, CLJS and CLJD:\n    14\t\n    15\t   - Strings are indexed by code point, as Python indexes them, never by\n    16\t     the hosts' UTF-16 code units: `(data/str-length \\\"a😀\\\")` is 2 on\n    17\t     every host. An unpaired surrogate is one code point of its own.\n    18\t   - `str-compare` orders by code point, which UTF-16 unit order does not\n    19\t     for supplementary characters against U+E000 to U+FFFF.\n    20\t   - Every string call decodes its whole argument, O(n), and search is a\n    21\t     naive O(n*m) scan: a prelude loop over a string's characters calls\n    22\t     `str->code-points` once and walks the vector with `nth`, never\n    23\t     `char-at` per step.\n    24\t   - An index is any number with an integral value, so `1.0` is index 1\n    25\t     on the JVM as it is on JS and Dart, which cannot tell it from `1`.\n    26\t   - Nothing iterates a host map or a host set into an ordered result:\n    27\t     host iteration order differs by host. An ordered dict is prelude\n    28\t     code, an index map beside an order vector.\n    29\t   - A refused call throws `ex-info` with the message `refusal-message`\n    30\t     and ex-data built here, never host exception text: `::op`,\n    31\t     `::reason` (`:arity`, `:wrong-type`, `:out-of-range` or\n    32\t     `:empty-separator`), and the reason's own keys.\n    33\t\n    34\t   Key equality in `contains?`, `dissoc`, `disj`, `hash-set` and `into` a\n    35\t   set is the host's `=`, which differs for `1` and `1.0` on the JVM. A\n    36\t   runtime profile normalizes guest keys before they reach these.\"\n    37\t  (:require\n    38\t    [clojure.string :as str]\n    39\t    [dao.host.float :as float]\n    40\t    [dao.host.integer :as integer-host]\n    41\t    [dao.host.text :as text]\n    42\t    [dao.jing.cbor :as cbor]\n    43\t    [yin.vm :as vm]\n    44\t    [yin.vm.module :as module]\n    45\t    [yin.vm.values :as values])\n    46\t  #?(:cljd (:import [\"dart:core\" BigInt])))\n    47\t\n    48\t\n    49\t(def module-name\n    50\t  \"The module `register-data-module` installs.\"\n    51\t  'data)\n    52\t\n    53\t\n    54\t(def refusal-message\n    55\t  \"The message of every refusal a `data` export throws.\"\n    56\t  \"data primitive refused\")\n    57\t\n    58\t\n    59\t(defn- refuse!\n    60\t  [op reason data]\n    61\t  (throw (ex-info refusal-message (merge {::op op, ::reason reason} data))))\n    62\t\n    63\t\n    64\t(defn- wrong-type!\n    65\t  \"Refuse argument `arg` (0-based) of `op`, which must be `expected`.\"\n    66\t  [op arg expected]\n    67\t  (refuse! op :wrong-type {::arg arg, ::expected expected}))\n    68\t\n    69\t\n    70\t;; =============================================================================\n    71\t;; Indices\n    72\t;; =============================================================================\n    73\t\n    74\t(def ^:private max-safe\n    75\t  \"The largest integer every host represents exactly, 2^53 - 1.\"\n    76\t  9007199254740991)\n    77\t\n    78\t\n    79\t(def ^:private max-safe-big (integer-host/from-native max-safe))\n    80\t(def ^:private min-safe-big (integer-host/from-native (- max-safe)))\n    81\t\n    82\t\n    83\t(defn- integral\n    84\t  \"`x` as an integer when it is a number with an integral value within\n    85\t   +/- `max-safe`, else nil. The bound keeps an index identical on hosts\n    86\t   whose large numbers are doubles. An exact integer in any carrier\n    87\t   answers its canonical carrier; a host double answers its truncation\n    88\t   when it is integral (`dao.host.float/integral?`); any other number\n    89\t   (a JVM ratio, decimal or `float`) is nil.\"\n    90\t  [x]\n    91\t  (cond\n    92\t    (integer-host/safe-native? x) x\n    93\t    (integer-host/exact-integer? x)\n    94\t    (let [b (integer-host/promote x)]\n    95\t      (when (and (<= 0 (integer-host/compare-big b min-safe-big))\n    96\t                 (<= (integer-host/compare-big b max-safe-big) 0))\n    97\t        (integer-host/demote b)))\n    98\t    (integer-host/host-float? x)\n    99\t    (when (and (float/integral? x) (<= (- max-safe) x max-safe))\n   100\t      (integer-host/trunc-native x))\n   101\t    :else nil))\n   102\t\n   103\t\n   104\t(defn- index!\n   105\t  \"Argument `arg` of `op` as an integer, or a `:wrong-type` refusal.\"\n   106\t  [op arg x]\n   107\t  (let [i (integral x)]\n   108\t    (if (nil? i)\n   109\t      (wrong-type! op arg :integer)\n   110\t      i)))\n   111\t\n   112\t\n   113\t(defn- in-range!\n   114\t  \"Refuse `i` unless `lo <= i <= hi`. `::index` is always the position\n   115\t   the call would access: the caller's index, or for `pop` the last\n   116\t   index, `(count v) - 1`, so an empty vector reports `::hi` -1 for\n   117\t   both `nth` and `pop`.\"\n   118\t  [op i lo hi]\n   119\t  (when-not (<= lo i hi)\n   120\t    (refuse! op :out-of-range {::index i, ::lo lo, ::hi hi}))\n   121\t  i)\n   122\t\n   123\t\n   124\t;; =============================================================================\n   125\t;; Code points\n   126\t;; =============================================================================\n   127\t\n   128\t(defn- code-points->string\n   129\t  \"The string of code points `cps`, each already checked to lie in\n   130\t   0 to 0x10FFFF.\"\n   131\t  [cps]\n   132\t  (text/units->string\n   133\t    (mapcat (fn [cp]\n   134\t              (if (< cp 0x10000)\n   135\t                [cp]\n   330\t\n   331\t\n   332\t(defn- code-points->str\n   333\t  [cps]\n   334\t  (when-not (sequential? cps)\n   335\t    (wrong-type! 'code-points->str 0 :sequential))\n   336\t  (code-points->string\n   337\t    (mapv (fn [cp]\n   338\t            (let [c (integral cp)]\n   339\t              (when-not (and c (<= 0 c 0x10FFFF))\n   340\t                (wrong-type! 'code-points->str 0 :code-points))\n   341\t              c))\n   342\t          cps)))\n   343\t\n   344\t\n   345\t(defn- surrogate?\n   346\t  [cp]\n   347\t  (<= 0xD800 cp 0xDFFF))\n   348\t\n   349\t\n   350\t(defn- well-formed-utf16?\n   351\t  [s]\n   352\t  (not-any? surrogate? (text/code-points (string! 'well-formed-utf16? 0 s))))\n   353\t\n   354\t\n   355\t(defn- str-unit-length\n   356\t  \"The number of UTF-16 code units of `s`.\"\n   357\t  [s]\n   358\t  (text/unit-count (string! 'str-unit-length 0 s)))\n   359\t\n   360\t\n   361\t(defn- str-unit-at\n   362\t  \"The UTF-16 code unit of `s` at `i`, 0 to 0xFFFF.\"\n   363\t  [s i]\n   364\t  (let [n (text/unit-count (string! 'str-unit-at 0 s))\n   365\t        i (index! 'str-unit-at 1 i)]\n   366\t    (in-range! 'str-unit-at i 0 (dec n))\n   367\t    (text/code-unit s i)))\n   368\t\n   369\t\n   370\t(defn- str-units\n   371\t  \"The UTF-16 code units of `s` as a vector.\"\n   372\t  [s]\n   373\t  (let [n (text/unit-count (string! 'str-units 0 s))]\n   374\t    (mapv #(text/code-unit s %) (range n))))\n   375\t\n   376\t\n   377\t(defn- units->str\n   378\t  \"The host string of the code unit vector `units`, or, when the units hold\n   379\t   an unpaired surrogate (no host string may carry one), the refusal datum\n   380\t   `{::refusal :ill-formed-utf16}`.\"\n   381\t  [units]\n   382\t  (when-not (sequential? units)\n   383\t    (wrong-type! 'units->str 0 :sequential))\n   384\t  (let [us (mapv (fn [u]\n   385\t                   (let [c (integral u)]\n   386\t                     (when-not (and c (<= 0 c 0xFFFF))\n   387\t                       (wrong-type! 'units->str 0 :code-units))\n   388\t                     c))\n   389\t                 units)\n   390\t        s (text/units->string us)]\n   391\t    (if (well-formed-utf16? s)\n   392\t      s\n   393\t      {::refusal :ill-formed-utf16})))\n   394\t\n   395\t\n   396\t(defn- str-compare\n   397\t  \"-1, 0 or 1 as `a` orders before, with or after `b` by code point.\"\n   398\t  [a b]\n   399\t  (let [x (text/code-points (string! 'str-compare 0 a))\n   400\t        y (text/code-points (string! 'str-compare 1 b))\n   401\t        n (min (count x) (count y))]\n   402\t    (loop [i 0]\n   403\t      (if (< i n)\n   404\t        (let [p (nth x i)\n   405\t              q (nth y i)]\n   406\t          (cond (< p q) -1\n   407\t                (> p q) 1\n   408\t                :else (recur (inc i))))\n   409\t        (cond (< (count x) (count y)) -1\n   410\t              (> (count x) (count y)) 1\n   411\t              :else 0)))))\n   412\t\n   413\t\n   414\t;; =============================================================================\n   415\t;; Kinds\n   416\t;; =============================================================================\n   417\t\n   418\t(defn- data-number?\n   419\t  \"True when `x` is a host number or an exact-integer carrier, including\n   420\t   a JS or Dart big integer, which answers false to `number?`. A\n   421\t   closure, a continuation, nil and a map are not, whatever they answer\n   422\t   to `get`.\"\n   423\t  [x]\n   424\t  (or (number? x) (integer-host/big-carrier? x)))\n   425\t\n   426\t\n   427\t;; =============================================================================\n   428\t;; Floats: the seam between addressed float content and host arithmetic\n   429\t;; =============================================================================\n   430\t\n   431\t(defn float-value\n   432\t  \"The host double of number or float64 content `x`, for host arithmetic:\n   433\t   what the literal `1.0` is on each host, a double on the JVM and Dart, a\n   434\t   Number on JS. A prelude unwraps a float with this, computes on bare\n   435\t   numbers, and wraps the result back with `float64`.\"\n   436\t  [x]\n   437\t  (when-not (or (data-number? x) (cbor/float64? x))\n   438\t    (wrong-type! 'float-value 0 :number))\n   439\t  #?(:cljd (if (dart/is? x BigInt) (.toDouble ^BigInt x) (.toDouble ^num x))\n   440\t     :clj (double x)\n   441\t     :cljs (cond (number? x) x\n   442\t                 (cbor/float64? x) (.-v ^not-native x)\n   443\t                 :else (js/Number x))))\n   444\t\n   445\t\n   446\t(defn float64\n   447\t  \"Float content with the value of number `x`: Jing's float64, the form a\n   448\t   float keeps in any value that can reach an addressed row or image (a\n   449\t   double on the JVM and Dart, the float64 carrier on JS, where a bare\n   450\t   integral Number is an integer; dao.jing.cbor.md, Numeric identity). The\n   451\t   producer carries float kind; the codec never infers it.\"\n   452\t  [x]\n   453\t  (cbor/float64 (float-value x)))\n   454\t\n   455\t\n   456\t(defn- callable?\n   457\t  \"True when `x` can be applied: a host function, a closure or a\n   458\t   continuation. A map is never callable, whatever keys it carries.\"\n   459\t  [x]\n   460\t  (or (fn? x) (values/closure? x) (values/continuation? x)))\n   461\t\n   462\t\n   463\t(defn- data-map?\n   464\t  [x]\n   465\t  (map? x))\n   466\t\n   467\t\n   468\t(defn- data-vector?\n   469\t  [x]\n   470\t  (vector? x))\n   471\t\n   472\t\n   473\t(defn- data-string?\n   474\t  [x]\n   475\t  (string? x))\n   476\t\n   477\t\n   478\t(defn- ref?\n   479\t  \"True when `x` is a stream, cursor or cell reference.\"\n   480\t  [x]\n   481\t  (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x))))\n   482\t\n   483\t\n   484\t(defn- data-content=\n   485\t  \"True when `a` and `b` have one identity under content addressing:\n   486\t   Jing's kind-strict content equality, so every NaN is one value, 0.0 is\n   487\t   not -0.0, 1 is not 1.0, and collections recurse. A callable or a\n   488\t   reference compares by host `=`, so content addressing never walks it.\"\n   489\t  [a b]\n   490\t  (or (identical? a b)\n   491\t      (if (or (callable? a) (callable? b) (ref? a) (ref? b))\n   492\t        (= a b)\n   493\t        (cbor/content= a b))))\n   494\t\n   495\t\n   496\t;; =============================================================================\n   497\t;; The module\n   498\t;; =============================================================================\n   499\t\n   500\t(def ^:private exports\n   501\t  \"`[name arities f]` of every export. `:variadic` means the greatest\n   502\t   listed fixed arity extends to further arguments.\"\n   503\t  [['count [1] data-count]\n   504\t   ['nth [2] data-nth]\n   505\t   ['contains? [2] data-contains?]\n   506\t   ['dissoc [1 :variadic] data-dissoc]\n   507\t   ['disj [1 :variadic] data-disj]\n   508\t   ['peek [1] data-peek]\n   509\t   ['pop [1] data-pop]\n   510\t   ['subvec [2 3] data-subvec]\n   511\t   ['hash-set [0 :variadic] hash-set]\n   512\t   ['into [2] data-into]\n   513\t   ['str-concat [0 :variadic] str-concat]\n   514\t   ['str-length [1] str-length]\n   515\t   ['substring [2 3] substring]\n   516\t   ['str-index-of [2 3] str-index-of]\n   517\t   ['str-split [2] str-split]\n   518\t   ['str-join [2] str-join]\n   519\t   ['char-at [2] char-at]\n   520\t   ['str->code-points [1] str->code-points]\n   521\t   ['code-points->str [1] code-points->str]\n   522\t   ['str-compare [2] str-compare]\n   523\t   ['str-unit-length [1] str-unit-length]\n   524\t   ['str-unit-at [2] str-unit-at]\n   525\t   ['str-units [1] str-units]\n   526\t   ['units->str [1] units->str]\n   527\t   ['well-formed-utf16? [1] well-formed-utf16?]\n   528\t   ['number? [1] data-number?]\n   529\t   ['float64 [1] float64]\n   530\t   ['float-value [1] float-value]\n   531\t   ['content= [2] data-content=]\n   532\t   ['callable? [1] callable?]\n   533\t   ['map? [1] data-map?]\n   534\t   ['vector? [1] data-vector?]\n   535\t   ['string? [1] data-string?]])\n   536\t\n   537\t\n   538\t(defn- arity-checked\n   539\t  \"`f` refusing, as data, a call whose argument count `arities` does not\n   540\t   admit, so a wrong count never reaches a host arity exception.\"\n   541\t  [op arities f]\n   542\t  (let [fixed (set (filter number? arities))\n   543\t        variadic-from (when (some #{:variadic} arities) (apply max fixed))]\n   544\t    (fn [& args]\n   545\t      (let [n (count args)]\n   546\t        (when-not (or (contains? fixed n)\n   547\t                      (and variadic-from (>= n variadic-from)))\n   548\t          (refuse! op :arity {::argc n}))\n   549\t        (apply f args)))))\n   550\t\n   551\t\n   552\t(def data-module\n   553\t  \"The `data` module's exports, export symbol to host function.\"\n   554\t  (into {}\n   555\t        (map (fn [[op arities f]] [op (arity-checked op arities f)]))\n   556\t        exports))\n   557\t\n   558\t\n   559\t(def data-profiles\n   560\t  \"UCF 7.5.2 profiles for the `data` module: every export `:pure`,\n   561\t   declaring no effects and no host state.\"\n   562\t  (into {}\n   563\t        (map (fn [[op arities _]]\n   564\t               [op (vm/primitive-profile op :pure arities #{} :none)]))\n   565\t        exports))\n   566\t\n   567\t\n   568\t(defn- check-limits!\n   569\t  \"Refuse `limits` unless `::max-items` is a positive native integer: the\n   570\t   limit has no default.\"\n   571\t  [limits]\n   572\t  (let [v (get limits ::max-items)]\n   573\t    (when-not (and (integer-host/exact-integer? v)\n   574\t                   (not (integer-host/big-carrier? v))\n   575\t                   (pos? v))\n   576\t      (throw (ex-info \"data module needs an explicit max-items\"\n   577\t                      {::reason :limits, ::limit ::max-items})))))\n   578\t\n   579\t\n   580\t(defn register-data-module\n   581\t  \"Return registry with the `data` module installed. Composition-only:\n   582\t   the module is never in `yin.vm/primitives`.\n   583\t\n   584\t   Under `limits`, the module also exports `max-items`, of no arguments,\n   585\t   answering the composition's `::max-items`: the largest item or\n   586\t   character count one sequence repetition may produce (a language\n   587\t   profile checks it before it builds). `::max-items` must be a positive\n   588\t   native integer; there is no default, and without `limits` the export\n   589\t   is absent.\"\n   590\t  ([registry]\n   591\t   (module/register-host-module registry module-name data-module\n   592\t                                data-profiles))\n   593\t  ([registry limits]\n   594\t   (check-limits! limits)\n   595\t   (let [n (::max-items limits)]\n   596\t     (module/register-host-module\n   597\t       registry module-name\n   598\t       (assoc data-module\n   599\t              'max-items (arity-checked 'max-items [0] (fn [] n)))\n   600\t       (assoc data-profiles\n   601\t              'max-items (vm/primitive-profile 'max-items :pure [0] #{}\n   602\t                                               :none))))))\n","exit_code":0,"status":"completed"}}
