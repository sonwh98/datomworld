{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/clojure.cljc | sed -n '2572,2910p'\"","aggregated_output":"  2572\t   'data/peek 'portable/peek\n  2573\t   'data/dissoc 'portable/dissoc\n  2574\t   'data/disj 'portable/disj\n  2575\t   'data/str-length 'portable/str-length})\n  2576\t\n  2577\t\n  2578\t(def kind-module\n  2579\t  \"The `kind` host module's exports, symbol to host function: the irreducible\n  2580\t   kind and name primitives (see the library notes). Every export is pure.\"\n  2581\t  (merge\n  2582\t    {'symbol? symbol?\n  2583\t     'keyword? keyword?\n  2584\t     'name name\n  2585\t     'symbol symbol\n  2586\t     'keyword keyword\n  2587\t     'str str\n  2588\t     'int? int?\n  2589\t     'with-meta with-meta\n  2590\t     'meta meta\n  2591\t     'coll? coll?\n  2592\t     'set? set?}\n  2593\t    #?(:clj {'var? var?} :default {})))\n  2594\t\n  2595\t\n  2596\t(def kind-arities\n  2597\t  \"The published arities of each `kind` export.\"\n  2598\t  {'symbol? [1], 'keyword? [1], 'name [1], 'symbol [1 2], 'keyword [1 2]\n  2599\t   'str [0 1 2 3 4 5 6 :variadic], 'int? [1], 'var? [1], 'with-meta [2], 'meta [1]\n  2600\t   'coll? [1], 'set? [1]})\n  2601\t\n  2602\t\n  2603\t(def library\n  2604\t  \"The library's definitions, in order, as quoted source.\"\n  2605\t  '[(defn identity\n  2606\t      [x]\n  2607\t      x)\n  2608\t    (defn inc\n  2609\t      [x]\n  2610\t      (+ x 1))\n  2611\t    (defn dec\n  2612\t      [x]\n  2613\t      (- x 1))\n  2614\t    (defn second\n  2615\t      [x]\n  2616\t      (first (rest x)))\n  2617\t    (defn not=\n  2618\t      [a b]\n  2619\t      (not (= a b)))\n  2620\t    (defn boolean?\n  2621\t      [x]\n  2622\t      (or (= x true) (= x false)))\n  2623\t    (defn fn?\n  2624\t      [x]\n  2625\t      (if (data/callable? x) true (yang.call/eligible? x)))\n  2626\t    (defn ^:yin.k/invoker invoke-value\n  2627\t      [f args]\n  2628\t      (cond\n  2629\t        (vector? f) (if (= 1 (count args)) (nth f (first args))\n  2630\t                        (throw (ex-info \"Vector invocation requires one index\" {:argc (count args)})))\n  2631\t        (or (map? f) (keyword? f))\n  2632\t        (if (<= 1 (count args) 2)\n  2633\t          (if (keyword? f) (get (first args) f (second args))\n  2634\t              (get f (first args) (second args)))\n  2635\t          (throw (ex-info \"Lookup invocation requires one key and optional default\" {:argc (count args)})))\n  2636\t        (set? f) (if (= 1 (count args))\n  2637\t                   (if (contains? f (first args)) (first args) nil)\n  2638\t                   (throw (ex-info \"Set invocation requires one key\" {:argc (count args)})))\n  2639\t        ;; Everything unsupported - a scalar, a raw closure the convention\n  2640\t        ;; never published, a forged shape that slipped past the call-site\n  2641\t        ;; routing - refuses as the admission path would. No apply here: a\n  2642\t        ;; guest apply would re-enter the call-site dispatcher and recurse.\n  2643\t        ;; This is a SOURCE-LEVEL throw of an UNMARKED condition-shaped map\n  2644\t        ;; (codex ruling 1794332020000): the value path has no raise exit, so\n  2645\t        ;; the crossing boundary wraps it per §8.10.7 into a NEW\n  2646\t        ;; :yang.call/thrown condition and authenticates THAT outer condition\n  2647\t        ;; with the compiler-held token. The library neither stamps nor can\n  2648\t        ;; stamp the inner map (codex: \"the library does not cause the inner\n  2649\t        ;; map to be stamped\").\n  2650\t        :else (throw (yang.call/condition :yang.call/not-callable {:yang.call/callee f}))))\n  2651\t    (defn update\n  2652\t      ([m k f] (assoc m k (f (get m k))))\n  2653\t      ([m k f a] (assoc m k (f (get m k) a)))\n  2654\t      ([m k f a b] (assoc m k (f (get m k) a b)))\n  2655\t      ([m k f a b c] (assoc m k (f (get m k) a b c))))\n  2656\t    (defn count\n  2657\t      [x]\n  2658\t      (data/count x))\n  2659\t    (defn contains?\n  2660\t      [coll k]\n  2661\t      (data/contains? coll k))\n  2662\t    (defn symbol?\n  2663\t      [x]\n  2664\t      (kind/symbol? x))\n  2665\t    (defn keyword?\n  2666\t      [x]\n  2667\t      (kind/keyword? x))\n  2668\t    (defn int?\n  2669\t      [x]\n  2670\t      (kind/int? x))\n  2671\t    (defn meta\n  2672\t      [x]\n  2673\t      (kind/meta x))\n  2674\t    (defn name\n  2675\t      [x]\n  2676\t      (kind/name x))\n  2677\t    (defn var?\n  2678\t      [x]\n  2679\t      (kind/var? x))\n  2680\t    (defn resolve\n  2681\t      [x]\n  2682\t      (kind/resolve x))\n  2683\t    (defn symbol\n  2684\t      ([n] (kind/symbol n))\n  2685\t      ([ns n] (kind/symbol ns n)))\n  2686\t    (defn keyword\n  2687\t      ([n] (kind/keyword n))\n  2688\t      ([ns n] (kind/keyword ns n)))\n  2689\t    (defn str\n  2690\t      ([] \"\")\n  2691\t      ([a] (kind/str a))\n  2692\t      ([a b] (kind/str a b))\n  2693\t      ([a b c] (kind/str a b c))\n  2694\t      ([a b c d] (kind/str a b c d))\n  2695\t      ([a b c d e] (kind/str a b c d e))\n  2696\t      ([a b c d e f] (kind/str a b c d e f)))\n  2697\t    ;; A supply is immutable data. The caller must retain the returned supply;\n  2698\t    ;; there is deliberately no ambient one-argument prefix allocator.\n  2699\t    (defn fresh-symbol\n  2700\t      [supply prefix]\n  2701\t      [(kind/symbol (kind/str \"G__\" prefix (:counter supply)))\n  2702\t       (assoc supply :counter (+ (:counter supply) 1))])\n  2703\t    (defn gensym\n  2704\t      ([n] (if (int? n)\n  2705\t             (kind/symbol (kind/str \"G__\" n))\n  2706\t             (throw (ex-info \"gensym requires an explicit fresh-name supply\"\n  2707\t                             {:prefix n :required 'fresh-symbol}))))\n  2708\t      ([prefix n] (if (map? prefix) (fresh-symbol prefix n)\n  2709\t                      (kind/symbol (kind/str prefix n)))))\n  2710\t    (defn last\n  2711\t      [coll]\n  2712\t      (if (empty? coll) nil\n  2713\t          (loop [s coll]\n  2714\t            (if (empty? (rest s)) (first s) (recur (rest s))))))\n  2715\t    (defn butlast\n  2716\t      [coll]\n  2717\t      (loop [s coll acc []]\n  2718\t        (if (empty? s) (seq acc)\n  2719\t            (if (empty? (rest s)) (seq acc)\n  2720\t                (recur (rest s) (conj acc (first s)))))))\n  2721\t    (defn nth\n  2722\t      ([coll n] (if (nil? coll) nil (data/nth (vec coll) n)))\n  2723\t      ([coll n missing] (if (and (int? n) (<= 0 n) (< n (count coll)))\n  2724\t                          (data/nth (vec coll) n) missing)))\n  2725\t    (defn string?\n  2726\t      [x]\n  2727\t      (data/string? x))\n  2728\t    (defn with-meta\n  2729\t      [x m]\n  2730\t      (kind/with-meta x m))\n  2731\t    (defn coll?\n  2732\t      [x]\n  2733\t      (kind/coll? x))\n  2734\t    (defn vector?\n  2735\t      [x]\n  2736\t      (data/vector? x))\n  2737\t    (defn map?\n  2738\t      [x]\n  2739\t      (data/map? x))\n  2740\t    (defn set?\n  2741\t      [x]\n  2742\t      (kind/set? x))\n  2743\t    (defn sequential?\n  2744\t      [x]\n  2745\t      (if (coll? x) (if (map? x) false (not (set? x))) false))\n  2746\t    (defn seq?\n  2747\t      [x]\n  2748\t      (if (sequential? x) (not (vector? x)) false))\n  2749\t    (defn list?\n  2750\t      [x]\n  2751\t      (seq? x))\n  2752\t    ;; The VM's rest returns a vector. Supply the source language's sequence\n  2753\t    ;; shape here without changing that VM primitive.\n  2754\t    (defn rest\n  2755\t      [coll]\n  2756\t      (let [v (vec coll)]\n  2757\t        (loop [i (- (count v) 1), acc '()]\n  2758\t          (if (< i 1) acc (recur (- i 1) (conj acc (data/nth v i)))))))\n  2759\t    (defn seq\n  2760\t      [x]\n  2761\t      (cond\n  2762\t        (nil? x) nil\n  2763\t        (if (coll? x) (empty? x) false) nil\n  2764\t     