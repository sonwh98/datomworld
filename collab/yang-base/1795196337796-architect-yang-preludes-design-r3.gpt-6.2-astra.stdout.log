                          (if (data/callable? dsg__witness)\n  2417\t                                                (dsg__equal\n  2418\t                                                  dsg__witness\n  2419\t                                                  (dsg__make_admission\n  2420\t                                                    (dsg__assoc dsg__candidate\n  2421\t                                                                :clj/admission\n  2422\t                                                                nil)))\n  2423\t                                                false)\n  2424\t                                              false))))\n  2425\t                                      false)))\n  2426\t                               ;; The intra-unit dispatcher: resolve the unit's public entry,\n  2427\t                               ;; apply it with the compiler's token packet [token args] - one\n  2428\t                               ;; variadic conj and one application, no record construction.\n  2429\t                               ;; Non-map callees refuse.\n  2430\t                               (u/sexp->uast\n  2431\t                                 (list 'fn '[dsg__callee dsg__args]\n  2432\t                                       (list 'if '(data/map? dsg__callee)\n  2433\t                                             (list (list (if (contains? (::defined env) 'get)\n  2434\t                                                           'dsg__get\n  2435\t                                                           'get)\n  2436\t                                                         'dsg__callee\n  2437\t                                                         :yang.call/entry)\n  2438\t                                                   (list 'conj '[]\n  2439\t                                                         'dsg__call_token\n  2440\t                                                         'dsg__args))\n  2441\t                                             '(let [dsg__condition (yang.call/condition\n  2442\t                                                                     :yang.call/not-callable\n  2443\t                                                                     (dsg__assoc {} :yang.call/callee dsg__callee))]\n  2444\t                                                (clj/raise (cell/dsg__new-provenance dsg__condition dsg__condition))))))))\n  2445\t           (outcomes? env) (u/let1 'dsg__make_entry (call-entry))\n  2446\t           (outcomes? env) (u/let1\n  2447\t                             'dsg__make_admission\n  2448\t                             (u/sexp->uast\n  2449\t                               '(fn [dsg__descriptor]\n  2450\t                                  (fn [dsg__candidate]\n  2451\t                                    (if (data/callable? dsg__call_token)\n  2452\t                                      (dsg__get dsg__descriptor :yang.call/entry)\n  2453\t                                      nil)))))\n  2454\t           ;; The exception accessors and the continuation family. The\n  2455\t           ;; `dsg__ex_message`/`dsg__ex_data` accessors read the portable\n  2456\t           ;; ex-info map; the continuation family (`clj/try`, `clj/throw`,\n  2457\t           ;; `clj/raise`, ...) is the port's `%capture` handler-stack scheme,\n  2458\t           ;; emitted inline (the linked runtime binds the same family from the\n  2459\t           ;; prelude). Its capture-sensitive primitives are the `dsg__*`\n","exit_code":0,"status":"completed"}}
