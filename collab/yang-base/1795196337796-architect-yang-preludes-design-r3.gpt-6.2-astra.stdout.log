       (pure 'bytes->str\n   427\t                 (fn [b] (text/utf8-decode b))\n   428\t                 [1])\n   429\t           ['require (primitive-entry\n   430\t                       'require\n   431\t                       (fn [spec]\n   432\t                         (let [ns-sym (if (vector? spec) (first spec) spec)]\n   433\t                           (effect/make :module/require {:module ns-sym})))\n   434\t                       :effectful [1] #{:module/require})]\n   435\t           ['try-require (primitive-entry\n   436\t                           'try-require\n   437\t                           (fn [spec]\n   438\t                             (let [ns-sym (if (vector? spec) (first spec) spec)]\n   439\t                               (effect/make :module/try-require\n   440\t                                            {:module ns-sym})))\n   441\t                           :effectful [1] #{:module/try-require})]])))\n   442\t\n   443\t\n   444\t(def ^:private primitive-profile-keys\n   445\t  [:yin.k/profile :yin.k/class :yin.k/arities :yin.k/effects\n   446\t   :yin.k/host-state])\n   447\t\n   448\t\n   449\t(def primitive-profiles\n   450\t  \"Portable projection of the standard registry, retained as a convenience.\"\n   451\t  (into {} (map (fn [[name entry]]\n   452\t                  [name (select-keys entry primitive-profile-keys)]))\n   453\t        primitives))\n   454\t\n   455\t\n   456\t(def primitive-canonical-names\n   457\t  \"Canonical-name declarations for intentional aliases in `primitives`.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_81","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/module.cljc | sed -n '40,106p;227,270p'\"","aggregated_output":"    40\t(defn- walk-path\n    41\t  \"Descend a registry's :modules map along path, a sequence of symbols.\n    42\t\n    43\t   Namespace segments step through plain maps until the path reaches a\n    44\t   module entry (a map carrying :manifest); the remaining segments read\n    45\t   that entry's task-local lowered `:bindings` when it holds them -- a\n    46\t   linked module (yin.vm.linker.md section 8.3) -- and its `:slice`\n    47\t   otherwise, which for a host module is the host values themselves, so\n    48\t   a binding name resolves to its export.\"\n    49\t  [node path]\n    50\t  (if (seq path)\n    51\t    (if (and (map? node) (contains? node :manifest))\n    52\t      (if-let [child (get node (first path))]\n    53\t        (walk-path child (rest path))\n    54\t        (get-in node (into [(if (contains? node :bindings) :bindings :slice)]\n    55\t                           path)))\n    56\t      (when-let [child (get node (first path))]\n    57\t        (walk-path child (rest path))))\n    58\t    node))\n    59\t\n    60\t\n    61\t(defn module-entry\n    62\t  \"The registry entry of module `module-name` in `modules` (a registry's\n    63\t   `:modules` map), or nil when the dotted path reaches no module entry.\"\n    64\t  [modules module-name]\n    65\t  (let [node (reduce (fn [node seg] (when (map? node) (get node seg)))\n    66\t                     modules\n    67\t                     (symbol->path module-name))]\n    68\t    (when (and (map? node) (contains? node :manifest)) node)))\n    69\t\n    70\t\n    71\t(defn assoc-module\n    72\t  \"Return registry with `entry` installed as module `module-name`.\"\n    73\t  [registry module-name entry]\n    74\t  (let [registry (or registry (empty-registry))\n    75\t        path (into [:modules] (symbol->path module-name))\n    76\t        children (into {} (filter (comp symbol? key)) (get-in registry path))]\n    77\t    (assoc-in registry path (merge children entry))))\n    78\t\n    79\t\n    80\t(defn link-module\n    81\t  \"The `linked` transition's registry update (yin.vm.linker.md sections\n    82\t   7.3 and 8.3): `registry` gains the module `manifest` names as the\n    83\t   portable encoding of acts 1 to 3 -- `{:manifest m :address a\n    84\t   :derivation d :slice {sym encoded} :stores {address snapshot} :cells\n    85\t   {cell-id cell} :images {identity image}}` -- never lowered values. `a`\n    86\t   is the manifest's own address; `lifted` is the act-1 lift, `{:slice\n    87\t   :stores :cells :images}`, the cells being the logical cursor cells its\n    88\t   references name (r9) and the images the verified origin images a\n    89\t   receiving task attaches.\n    90\t   Each receiving task lowers the entry into its own `:bindings`.\"\n    91\t  [registry manifest derivation lifted]\n    92\t  (assoc-module registry\n    93\t                (:yin.module/name manifest)\n    94\t                {:manifest manifest,\n    95\t                 :address (jing/segment-key manifest),\n    96\t                 :derivation derivation,\n    97\t                 :slice (:slice lifted),\n    98\t                 :stores (:stores lifted),\n    99\t                 :cells (:cells lifted),\n   100\t                 :images (:images lifted)}))\n   101\t\n   102\t\n   103\t(defn module-entries\n   104\t  \"Every `[name entry]` a registry value holds, the module name read back\n   105\t   from each entry's manifest.\"\n   106\t  [registry]\n   227\t(defn register-host-module\n   228\t  \"Return registry with host module `module-name` installed from `fns`\n   229\t   under `profiles`.\n   230\t\n   231\t   module-name is a dotted symbol; fns maps each export symbol to the host\n   232\t   value it publishes; profiles maps each export symbol to its UCF 7.5.2\n   233\t   p