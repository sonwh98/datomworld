{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '130,180p' src/cljc/yin/vm/integer.cljc; sed -n '640,710p' src/cljc/yin/vm/integer.cljc; sed -n '110,180p' src/cljc/yang/core/prelude.cljc; rg -n '\"'^'\"\\\\(defn.*(ast->semantic-bytecode|semantic-bytecode->ast)|:if|:lambda' src/cljc/yin/vm.cljc | head -35\"","aggregated_output":"\n(defn- refuse!\n  [op reason data]\n  (throw (ex-info refusal-message (merge {::op op, ::reason reason} data))))\n\n\n(defn- wrong-type!\n  \"Refuse argument `arg` (0-based) of `op`, which must be `expected`.\"\n  [op arg expected]\n  (refuse! op :wrong-type {::arg arg, ::expected expected}))\n\n\n;; =============================================================================\n;; Promotion, demotion and limits\n;; =============================================================================\n\n(def ^:private zero (host/from-native 0))\n(def ^:private one (host/from-native 1))\n(def ^:private neg-one (host/from-native -1))\n\n\n(defn- big!\n  \"Argument `arg` of `op` promoted to the host big integer, or a\n   `:wrong-type` refusal.\"\n  [op arg x]\n  (if (host/exact-integer? x)\n    (host/promote x)\n    (wrong-type! op arg :integer)))\n\n\n(defn- sign\n  [b]\n  (host/compare-big b zero))\n\n\n(defn- bits\n  [b]\n  (host/magnitude-bit-length b))\n\n\n(defn- out\n  \"Big integer result `b` in its canonical carrier, or `::bit-limit`.\"\n  [limits b]\n  (if (> (bits b) (::max-bits limits))\n    ::bit-limit\n    (host/demote b)))\n\n\n(defn- pair\n  \"`[q r]`, or the first of them that is a limit reason.\"\n  [q r]\n    (let [v (get limits k)]\n      (when-not (and (host/exact-integer? v)\n                     (not (host/big-carrier? v))\n                     (pos? v))\n        (throw (ex-info \"integer module needs explicit limits\"\n                        {::reason :limits, ::limit k}))))))\n\n\n(defn integer-module\n  \"The `integer` module's exports under `limits`, export symbol to host\n   function. `limits` must carry `::max-bits` and `::max-digits`.\"\n  [limits]\n  (check-limits! limits)\n  (let [limits (select-keys limits [::max-bits ::max-digits])\n        ;; chosen once: every fast result fits in 53 bits\n        fast? (>= (::max-bits limits) 53)]\n    (into {}\n          (map (fn [[op arities f]]\n                 (let [f (if fast? (get fast-kernels op f) f)]\n                   [op (arity-checked op arities (partial f limits))])))\n          exports)))\n\n\n(def integer-profiles\n  \"UCF 7.5.2 profiles for the `integer` module: every export `:pure`,\n   declaring no effects and no host state.\"\n  (into {}\n        (map (fn [[op arities _]]\n               [op (vm/primitive-profile op :pure arities #{} :none)]))\n        exports))\n\n\n(defn register-integer-module\n  \"Return registry with the `integer` module installed under `limits`.\n   Composition-only: the module is never in `yin.vm/primitives`.\"\n  [registry limits]\n  (module/register-host-module registry module-name (integer-module limits)\n                               integer-profiles))\n  \"The names `ast` reads and does not define, sorted.\"\n  [ast]\n  (vec (sort-by str\n                (remove (conj (defined-keys ast) 'yin/def) (free-names ast)))))\n\n\n(defn balanced-definitions->uast\n  \"Balanced definition-to-UAST emission: each [key form] pair maps to\n   u/def! and the vector splits at its midpoint, halving sequential depth\n   versus the linear u/seq-nodes chain. The tree shape is content-addressed:\n   empty input answers nil, and callers choose balanced versus linear\n   deliberately - never migrate between the two for style.\"\n  [defs]\n  (letfn [(sequence-tree [nodes]\n            (if (<= (count nodes) 1)\n              (first nodes)\n              (let [middle (quot (count nodes) 2)]\n                (u/then (sequence-tree (subvec nodes 0 middle))\n                        (sequence-tree (subvec nodes middle))))))]\n    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n\n\n(defn definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n235:    :lambda [(:body node)]\n240:    :if [(:test node) (:consequent node) (:alternate node)]\n258:              :lambda (when-let [p (some #(when (reserved-name? %) %)\n651:   :yin/type {},      ; keyword (:literal, :variable, :lambda, ...)\n771:                  :lambda (do (emit! e :yin/type :lambda)\n788:                  :if (do (emit! e :yin/type :if)\n863:       :lambda (let [body-eid (get-attr root-id :yin/body)\n886:       :if (let [test-eid (get-attr root-id :yin/test)\n1046:   :lambda [[:params :syms] [:body :node]],\n1048:   :if [[:test :node] [:consequent :node] [:alternate :node]],\n1155:(defn ast->semantic-bytecode\n1348:                :lambda (when (some reserved-name? (nth row 2))\n1519:(defn semantic-bytecode->ast\n1670:   bound at `[root path]` iff a `:lambda` occurrence of the same root sits\n1689:     [$ast ?lam :lambda ?params _]\n1762:           :literal #{}, :variable #{}, :lambda #{}, :application #{}, :if #{}},\n","exit_code":0,"status":"completed"}}
