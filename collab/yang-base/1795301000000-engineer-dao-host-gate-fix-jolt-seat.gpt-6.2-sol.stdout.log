rget (outside list-2)\n        sources (update (read-sources (closure-files)) target str\n                        \"\\n(def injected (random-uuid))\\n\")\n        r (gate sources list-1 list-2)]\n M test/dao/host/gate_test.clj\n","exit_code":0,"status":"completed"}}
