{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2603,2735p' src/cljc/yang/clojure.cljc; sed -n '2840,2990p' src/cljc/yang/clojure.cljc; sed -n '3010,3198p' src/cljc/yang/clojure.cljc\"","aggregated_output":"(def library\n  \"The library's definitions, in order, as quoted source.\"\n  '[(defn identity\n      [x]\n      x)\n    (defn inc\n      [x]\n      (+ x 1))\n    (defn dec\n      [x]\n      (- x 1))\n    (defn second\n      [x]\n      (first (rest x)))\n    (defn not=\n      [a b]\n      (not (= a b)))\n    (defn boolean?\n      [x]\n      (or (= x true) (= x false)))\n    (defn fn?\n      [x]\n      (if (data/callable? x) true (yang.call/eligible? x)))\n    (defn ^:yin.k/invoker invoke-value\n      [f args]\n      (cond\n        (vector? f) (if (= 1 (count args)) (nth f (first args))\n                        (throw (ex-info \"Vector invocation requires one index\" {:argc (count args)})))\n        (or (map? f) (keyword? f))\n        (if (<= 1 (count args) 2)\n          (if (keyword? f) (get (first args) f (second args))\n              (get f (first args) (second args)))\n          (throw (ex-info \"Lookup invocation requires one key and optional default\" {:argc (count args)})))\n        (set? f) (if (= 1 (count args))\n                   (if (contains? f (first args)) (first args) nil)\n                   (throw (ex-info \"Set invocation requires one key\" {:argc (count args)})))\n        ;; Everything unsupported - a scalar, a raw closure the convention\n        ;; never published, a forged shape that slipped past the call-site\n        ;; routing - refuses as the admission path would. No apply here: a\n        ;; guest apply would re-enter the call-site dispatcher and recurse.\n        ;; This is a SOURCE-LEVEL throw of an UNMARKED condition-shaped map\n        ;; (codex ruling 1794332020000): the value path has no raise exit, so\n        ;; the crossing boundary wraps it per §8.10.7 into a NEW\n        ;; :yang.call/thrown condition and authenticates THAT outer condition\n        ;; with the compiler-held token. The library neither stamps nor can\n        ;; stamp the inner map (codex: \"the library does not cause the inner\n        ;; map to be stamped\").\n        :else (throw (yang.call/condition :yang.call/not-callable {:yang.call/callee f}))))\n    (defn update\n      ([m k f] (assoc m k (f (get m k))))\n      ([m k f a] (assoc m k (f (get m k) a)))\n      ([m k f a b] (assoc m k (f (get m k) a b)))\n      ([m k f a b c] (assoc m k (f (get m k) a b c))))\n    (defn count\n      [x]\n      (data/count x))\n    (defn contains?\n      [coll k]\n      (data/contains? coll k))\n    (defn symbol?\n      [x]\n      (kind/symbol? x))\n    (defn keyword?\n      [x]\n      (kind/keyword? x))\n    (defn int?\n      [x]\n      (kind/int? x))\n    (defn meta\n      [x]\n      (kind/meta x))\n    (defn name\n      [x]\n      (kind/name x))\n    (defn var?\n      [x]\n      (kind/var? x))\n    (defn resolve\n      [x]\n      (kind/resolve x))\n    (defn symbol\n      ([n] (kind/symbol n))\n      ([ns n] (kind/symbol ns n)))\n    (defn keyword\n      ([n] (kind/keyword n))\n      ([ns n] (kind/keyword ns n)))\n    (defn str\n      ([] \"\")\n      ([a] (kind/str a))\n      ([a b] (kind/str a b))\n      ([a b c] (kind/str a b c))\n      ([a b c d] (kind/str a b c d))\n      ([a b c d e] (kind/str a b c d e))\n      ([a b c d e f] (kind/str a b c d e f)))\n    ;; A supply is immutable data. The caller must retain the returned supply;\n    ;; there is deliberately no ambient one-argument prefix allocator.\n    (defn fresh-symbol\n      [supply prefix]\n      [(kind/symbol (kind/str \"G__\" prefix (:counter supply)))\n       (assoc supply :counter (+ (:counter supply) 1))])\n    (defn gensym\n      ([n] (if (int? n)\n             (kind/symbol (kind/str \"G__\" n))\n             (throw (ex-info \"gensym requires an explicit fresh-name supply\"\n                             {:prefix n :required 'fresh-symbol}))))\n      ([prefix n] (if (map? prefix) (fresh-symbol prefix n)\n                      (kind/symbol (kind/str prefix n)))))\n    (defn last\n      [coll]\n      (if (empty? coll) nil\n          (loop [s coll]\n            (if (empty? (rest s)) (first s) (recur (rest s))))))\n    (defn butlast\n      [coll]\n      (loop [s coll acc []]\n        (if (empty? s) (seq acc)\n            (if (empty? (rest s)) (seq acc)\n                (recur (rest s) (conj acc (first s)))))))\n    (defn nth\n      ([coll n] (if (nil? coll) nil (data/nth (vec coll) n)))\n      ([coll n missing] (if (and (int? n) (<= 0 n) (< n (count coll)))\n                          (data/nth (vec coll) n) missing)))\n    (defn string?\n      [x]\n      (data/string? x))\n    (defn with-meta\n      [x m]\n      (kind/with-meta x m))\n    (defn coll?\n      [x]\n      (kind/coll? x))\n    (defn vector?\n      [x]\n        (if (empty? s)\n          (reverse acc)\n          (recur (rest s) (if (pred (first s)) (conj acc (first s)) acc)))))\n    (defn remove\n      [pred coll]\n      (loop [s coll\n             acc '()]\n        (if (empty? s)\n          (reverse acc)\n          (recur (rest s) (if (pred (first s)) acc (conj acc (first s)))))))\n    (defn into\n      [to from]\n      (loop [acc to\n             s from]\n        (if (empty? s) acc (recur (conj acc (first s)) (rest s)))))\n    (defn concat\n      ([] '())\n      ([a] (reverse (reverse a)))\n      ([a b] (reverse (into (reverse a) b)))\n      ([a b c] (reverse (into (into (reverse a) b) c)))\n      ([a b c d] (reverse (into (into (into (reverse a) b) c) d))))\n    (defn keys\n      [m]\n      (map first (vec m)))\n    (defn vals\n      [m]\n      (map second (vec m)))\n    (defn disj\n      [s x]\n      (data/disj s x))\n    (defn union\n      ([] #{})\n      ([a] a)\n      ([a b] (into a b))\n      ([a b c] (into (into a b) c))\n      ([a b c d] (into (into (into a b) c) d))\n      ([a b c d e] (into (into (into (into a b) c) d) e))\n      ([a b c d e f] (into (into (into (into (into a b) c) d) e) f)))\n    (defn difference\n      [a b]\n      (reduce (fn [s x] (disj s x)) a b))\n    (defn merge\n      ([] nil)\n      ([a] a)\n      ([a b] (if (nil? b) a (if (nil? a) b (conj a b))))\n      ([a b c] (merge (merge a b) c))\n      ([a b c d] (merge (merge (merge a b) c) d)))\n    (defn comp\n      ([] identity)\n      ([f] f)\n      ([f g]\n       (fn\n         ([x] (f (g x)))\n         ([x y] (f (g x y)))\n         ([x y z] (f (g x y z)))))\n      ([f g h] (comp f (comp g h))))\n    (defn partial\n      ([f a]\n       (fn\n         ([] (f a))\n         ([x] (f a x))\n         ([x y] (f a x y))\n         ([x y z] (f a x y z))))\n      ([f a b]\n       (fn\n         ([] (f a b))\n         ([x] (f a b x))\n         ([x y] (f a b x y))\n         ([x y z] (f a b x y z))))\n      ([f a b c]\n       (fn\n         ([] (f a b c))\n         ([x] (f a b c x))\n         ([x y] (f a b c x y))\n         ([x y z] (f a b c x y z)))))])\n\n\n(defn library-for\n  \"The definitions of `library` that `forms` need: those whose names `forms`\n   mention (outside quoted data), and the ones those mention in turn, in\n   library order. Compiling only these keeps a program small.\"\n  [forms]\n  (let [by-name (into {} (map (fn [f] [(second f) f])) library)\n        mentions (fn mentions\n                   [form]\n                   (cond\n                     (symbol? form) #{form}\n                     (seq? form) (if (= 'quote (first form))\n                                   #{}\n                                   (into #{} (mapcat mentions) form))\n                     (coll? form) (into #{} (mapcat mentions) form)\n                     :else #{}))\n        defined (into #{} (comp (filter seq?) (filter #(= 'defn (first %))) (map second)) forms)\n        needed (loop [todo (remove defined (mentions forms)), seen #{}]\n                 (if (empty? todo)\n                   seen\n                   (let [n (first todo)]\n                     (if (or (contains? seen n) (not (contains? by-name n)))\n                       (recur (rest todo) seen)\n                       (recur (into (rest todo)\n                                    (remove (conj defined n) (mentions (by-name n))))\n                              (conj seen n))))))]\n    (letfn [(nodes\n              [form]\n              (cons form (when (and (coll? form) (not (and (seq? form) (= 'quote (first form)))))\n                           (mapcat nodes form))))\n            (dynamic-call?\n              [source]\n              (let [tree (nodes source)\n                    possible-locals (into #{} (comp (filter vector?) (mapcat identity) (filter symbol?)) tree)]\n                (some (fn [x]\n                        (and (seq? x) (seq x) (not= 'quote (first x))\n                             (or (contains? possible-locals (first x))\n                                 (and (not (symbol? (first x))) (not (keyword? (first x))))))) tree)))\n            (close\n              [todo seen]\n              (if-let [n (first todo)]\n                (if (or (contains? seen n) (contains? defined n) (not (contains? by-name n)))\n                  (recur (rest todo) seen)\n                  (recur (concat (rest todo) (mentions (by-name n))) (conj seen n))) seen))]\n      (let [source (concat forms (map by-name needed))\n            needed (if (some dynamic-call? source) (close ['invoke-value] needed) needed)]\n        (filterv #(contains? needed (second %)) library)))))\n\n\n(defn compile\n  \"Main compiler entry point.\n\n  Compiles a Clojure form into Yin VM Universal AST.\n\n  Examples:\n    (compile 42)\n    => {:type :literal, :value 42}\n\n    (compile '(+ 1 2))\n    => {:type :application\n        :operator {:type :variable, :name +}\n        :operands [{:type :literal, :value 1}\n                   {:type :literal, :value 2}]}\n\n    (compile '(fn [x] (* x 2)))\n    => {:type :lambda\n        :params [x]\n        :body {:type :application\n               :operator {:type :variable, :name *}\n               :operands [{:type :variable, :name x}\n                          {:type :literal, :value 2}]}}\"\n  [form]\n  ;; the single-form entry runs the same reserved-prefix pre-pass as\n  ;; `compile-program`, so a REPL one-liner can no more spell a\n  ;; compiler-private (`dsg__`) name than a whole program can. Trusted\n;; (`clj/define-global!`/`clj/global-get`), as a Python def lands in\n;; its module's globals. No call node is rewritten and no foreign\n;; `:code` is extracted: the unit is the program's own lowering,\n;; wrapped.\n\n(def unit-opts\n  \"The `compile-program` opts a linked unit compiles with: the\n   argument-vector convention with the outcome model over the guest\n   library's adapters. The required clj module supplies the continuation\n   family; VM primitives are callable directly by bare name.\"\n  {:convention :arg-vector,\n   :outcomes true,\n   :linked-runtime true,\n   :adapters library-adapters,\n   :native vm/primitive-profiles})\n\n\n(def top-defining-operators\n  \"The operators whose second element names a top-level definition.\"\n  '#{def defn defn- defmacro})\n\n\n(defn read-forms\n  \"Every form `source` text reads. The reader is the parser: a malformed\n   source throws, as any frontend's refused parse does.\n\n   Source-string compilation is a JVM/Node capability (tools.reader is\n   an mvn dependency, absent from the jolt host's source-root classpath\n   — the jolt lane loads compiled output and ships source strings to\n   remote evaluators, so this is unreachable there; the honest error\n   says so if ever reached).\"\n  [source]\n  #?(:cljd (throw (ex-info \"Source-string compilation requires the JVM/Node reader; ClojureDart compiles from forms\"\n                           {:yang.clojure/reader :unavailable-on-cljd}))\n     :jolt (throw (ex-info \"Source-string compilation requires the JVM/Node reader; the jolt host compiles from forms or delegates source reading to its remote evaluators\"\n                           {:yang.clojure/reader :unavailable-on-jolt}))\n     :default\n     (let [rd (rt/string-push-back-reader source)]\n       (loop [forms []]\n         (let [form (treader/read rd false ::eof)]\n           (if (= form ::eof)\n             forms\n             (recur (conj forms form))))))))\n\n\n(defn top-level-names\n  \"The names `forms` define at the top level, in order: the second element\n   of each def/defn/defn-/defmacro head.\"\n  [forms]\n  (into []\n        (comp (filter #(and (seq? %) (contains? top-defining-operators (first %))))\n              (map (comp strip-symbol-meta second)))\n        forms))\n\n\n(declare publish-to-globals)\n\n\n(defn- globals-child\n  [x names bound]\n  (cond\n    (and (map? x) (contains? x :type)) (publish-to-globals x names bound)\n    (vector? x) (mapv #(globals-child % names bound) x)\n    :else x))\n\n\n(defn- publish-to-globals\n  \"Rewrite the compiled `node` for the linked unit: a top-level\n   definition in `names` becomes a `clj/define-global!` write and a free\n   read of one becomes a `clj/global-get`, both under the name's string.\n   The `names` a unit is lowered with are its own top-level definitions,\n   its guest library's and the projected names the composition bound in\n   the runtime global namespace, so a projected export and a definition\n   read through the one binding: a definition the unit itself runs\n   publishes after the projection and shadows it. A store definition\n   inside the unit thunk is conditional to the linker, so no body read\n   of it discharges (the runtime preludes avoid this by keeping every\n   definition at module level); the runtime global namespace is the\n   linked unit's definition table instead, as a Python module body\n   writes its dictionary. Lexically bound names, quoted literals and\n   macro definitions keep their store shape: a macro is not a runtime\n   value.\"\n  [node names bound]\n  (case (:type node)\n    :literal node\n    :vm/current-continuation node\n    :variable (if (and (contains? names (:name node))\n                       (not (contains? bound (:name node))))\n                (u/app (u/v 'clj/global-get) (u/lit (str (:name node))))\n                node)\n    :lambda (assoc node :body (publish-to-globals (:body node) names\n                                                  (into bound (:params node))))\n    :application\n    (if (and (= 'yin/def (get-in node [:operator :name]))\n             (= 2 (count (:operands node)))\n             (= :literal (:type (first (:operands node))))\n             (contains? names (:value (first (:operands node)))))\n      (u/app (u/v 'clj/define-global!)\n             (u/lit (str (:value (first (:operands node)))))\n             (publish-to-globals (second (:operands node)) names bound))\n      (assoc node\n             :operator (publish-to-globals (:operator node) names bound)\n             :operands (mapv #(publish-to-globals % names bound)\n                             (:operands node))))\n    :if (cond-> node\n          (contains? node :test)\n          (assoc :test (publish-to-globals (:test node) names bound))\n          (contains? node :consequent)\n          (assoc :consequent (publish-to-globals (:consequent node) names bound))\n          (contains? node :alternate)\n          (assoc :alternate (publish-to-globals (:alternate node) names bound)))\n    (reduce (fn [n k]\n              (let [v (get n k)]\n                (if (or (and (map? v) (contains? v :type)) (vector? v))\n                  (assoc n k (globals-child v names bound))\n                  n)))\n            node (keys node))))\n\n\n(defn lower-unit\n  \"The `clj/run-main` entry's unit for the top-level source `forms`: one\n   thunk whose call runs the program — `forms` plus the definitions of\n   the guest library they need, compiled unmodified under `unit-opts`\n   and published to the runtime global namespace by\n   `publish-to-globals` — so the helper's export projection can read\n   each top-level definition. The two-argument form also takes the\n   projected `exports` (names the composition already bound in the\n   runtime global namespace): their free reads publish the same way, so\n   the projection is the caller's binding for them. The program's own\n   `yang.call` call sites need no free-name declaration: the convention\n   preamble `compile-program` emits defines those names locally, and\n   the donor publication pins the `yang.call` module for the qualified\n   reads that remain.\"\n  ([forms] (lower-unit forms []))\n  ([forms exports]\n   (let [source (vec forms)\n         library (library-for source)\n         program (compile-program (concat source library) true unit-opts)\n         macros (into #{}\n                      (comp (filter #(and (seq? %) (= 'defmacro (first %))))\n                            (map (comp strip-symbol-meta second)))\n                      (concat source library))\n         names (reduce disj\n                       (into (set (top-level-names source))\n                             (concat (map (comp strip-symbol-meta second) library)\n                                     (map symbol exports)))\n                       macros)]\n     ;; `publish-to-globals` rewrites nodes after `compile-program`\n     ;; finalized them, so the unit is finalized again over its\n     ;; finished tree: the rewrite's own applications are occurrences.\n     (annotate-call-sites (u/lam [] (publish-to-globals program names #{}))))))\n\n\n(defn output\n  \"The `clj/run-main` value as test data.\"\n  [value]\n  (pr-str value))\n","exit_code":0,"status":"completed"}}
