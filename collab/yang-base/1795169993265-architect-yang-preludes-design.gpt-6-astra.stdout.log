339\t\n  4340\t;; =============================================================================\n  4341\t;; The linked js module requires the separately published `yang.call` module\n  4342\t;; =============================================================================\n  4343\t\n  4344\t(def module-name\n  4345\t  \"The linker module the JavaScript runtime profile is published as.\"\n  4346\t  'js)\n  4347\t\n  4348\t\n  4349\t(def runtime-keys\n  4350\t  \"Every key `js/init!` allocates, the ready flag aside, sorted.\"\n  4351\t  (vec (sort-by str\n  4352\t                (concat '[js.rt/ctx js.rt/out js.rt/global js.rt/obj-proto\n  4353\t                          js.rt/fn-proto js.rt/symbol-proto js.rt/array-proto]\n  4354\t                        (map second error-classes)\n  4355\t                        (map first primitive-protos)))))\n  4356\t\n  4357\t\n  4358\t(defn strip\n  4359\t  \"`sym` without the module's own namespace `js`; any other value as it\n  4360\t   is. `js.rt/*` stays qualified: an internal store key.\"\n  4361\t  [sym]\n  4362\t  (core/strip \"js\" sym))\n  4363\t\n  4364\t\n  4365\t(def ^:private module-definitions\n  4366\t  \"The module's definition list: a `:js/uninit` placeholder for every\n  4367\t   runtime key, then every definition, stripped.\"\n  4368\t  (core/module-definitions \"js\" :js/uninit runtime-keys linked-definitions))\n  4369\t\n  4370\t\n  4371\t(def module-uast\n  4372\t  \"The module tree: one application whose operands are the definitions, in\n  4373\t   order, applied to a lambda that returns nil. C1 finalized, like every\n  4374\t   published production tree: its `:yang/call-site` markers publish beside\n  4375\t   its manifest (see `yin.vm.linker.publish`), never inside it, so the\n  4376\t   manifest keeps schema 1 and its address does not move.\"\n  4377\t  (u/annotate-call-sites (core/module-tree module-definitions [])))\n  4378\t\n  4379\t\n  4380\t(def module-exports\n  4381\t  \"The module's exports: ev