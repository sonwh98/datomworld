ec (collection literals, apply),\n          ;; so a program definition of either would capture them\n          (when-let [hit (first (filter #{'conj 'vec} defined))]\n            (reject! (str \"Defining \" hit \" would capture the argument-vector constructor\")\n                     {:name hit}))\n          (cond-> {::convention {:native (set (if (map? (:native opts))\n                                                (keys (:native opts))\n                                                (:native opts)))\n                                 :arities (into {}\n                                                (keep (fn [[sym profile]]\n                                                        (when-let [a (if (map? profile)\n                                                                       (:yin.k/arities profile)\n                                                                       profile)]\n                                                          [sym a])))\n                                                (when (map? (:native opts)) (:native opts)))\n                                 :macros (set (:macros opts))}\n                   ::defined defined\n                   ::defined-fns defined-fns\n                   ::invoker (boolean (some #(and (seq? %) (= 'defn (first %))\n                                                  (= 'invoke-value (second %))\n                                                  (:yin.k/invoker (meta (second %)))) forms))}\n            (:outcomes opts) (assoc ::outcomes {:adapters (or (:adapters opts) {})}))))))\n\n\n(defn- check-program-symbols!\n  \"The program pre-pass. Quoted data is exempt. The reserved prefix names\n   compiler temporaries, so no user symbol may carry it in ANY position\n   (binder, reference, definition name); `loop` and `recur` are special forms,\n   so they may only head a list, never stand as a value or a binder.\"\n  [form]\n  (cond\n    (symbol? form)\n    (do (when (reserved-name? form)\n          (reject! \"Symbol uses the reserved destructuring prefix\"\n                   {:symbol form, :prefix reserved-prefix}))\n        (when (and (nil? (namespace form)) (contains? #{'loop 'recur} form))\n          (reject! (str form \" is only legal in operator position\") {:symbol form})))\n    (seq? form)\n    (when-not (= 'quote (first form))\n      (let [head (first form)]\n        (when (and (symbol? head) (reserved-name? head))\n          (reject! \"Symbol uses the reserved destructuring prefix\"\n                   {:symbol head, :prefix reserved-prefix}))\n        (when-not (symbol? head)\n          (check-program-symbols! head))\n        (run! check-program-symbols! (rest form))))\n    (map? form) (run! check-program-symbols! (concat (keys form) (vals form)))\n    (coll? form) (run! check-program-symbols! form)))\n\n    :unit python-unit,\n    :run-main 'py/run-main,\n    :read-export (fn [export]\n                   (list 'py/global-get\n                         (list 'py/module-dict\n                               (list 'py/modules-ref {:py/str \"__main__\"}))\n                         {:py/str export})),\n    :project (fn [name value]\n               (list 'yin/def (list 'quote (python-export-symbol name)) value)),\n    :render py-render/output},\n   :clojure\n   {:runtime 'clj,\n    :address #(:address @published-clj),\n    :refusal [:yang.clojure/refusal :yang.clojure/undeclared-free],\n    :deps (fn [] {'yang.call (:call-address @h/published)}),\n    :parse clj-comp/read-forms,\n    :unit (fn [packet exports] (clj-comp/lower-unit packet exports)),\n    :run-main 'clj/run-main,\n    :read-export (fn [export] (list 'clj/global-get export)),\n    :project (fn [name value]\n               ;; The runtime global namespace is the one binding (as\n               ;; `js/define-global!` is for a JS caller): `lower-unit`\n               ;; reads each projected name through `clj/global-get`, so\n               ;; no task-store binding duplicates it. A caller top-level\n               ;; definition of the same name publishes after the\n               ;; projection and shadows it.\n               (list 'clj/define-global! name value)),\n    :render clj-comp/output}})\n\n\n(defn- profile\n  [frontend]\n  (or (get frontends frontend)\n      (throw (ex-info \"frontend not admitted\" {:frontend frontend}))))\n\n\n1342:  \"The argument counts an adapter for native `sym` admits: the fixed arities\n1344:   the profile is `:variadic`. A name with no declared profile admits\n1358:   unpacked arguments, for each admitted count.\"\n1461:          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n1464:          ;; admits or forges one, so admission rules it. Everything else is a\n1485:                     admitted\n1487:                   admitted)]\n1542:                                (u/app (u/v 'dsg__admitted?) (u/v candidate))\n1559:                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n2167:   its published profile, whose `:yin.k/arities` give an adapter its admitted\n2341:                               (u/lam '[dsg__admitted? dsg__intra_call] %)\n2348:                                      ;; descriptor projection treats a\n2364:                                      ;; admitted than any other source map,\n2370:                                      ;; admitted (authentication is not\n2547:;; explicitly admitted kind/var? seam on the JVM; namespace lookup (resolve)\n2559:;; variadic parameter): str, list and vector admit 0 to 6 arguments, concat and\n2570:   `admit` registration.\"\n3084:   publishes after the projection and shadows it. A store definition\n3134:   `publish-to-globals` — so the helper's export projection can read\n3138:   the projection is the caller's binding for them. The program's own\ntest/yang/call/exception_source_test.clj\ntest/yang/php/antlr/eval_admission_test.clj\ntest/yang/typescript/antlr/float_address_test.cljc\ntest/yang/python/antlr/float_address_test.cljc\n","exit_code":0,"st