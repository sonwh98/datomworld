{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"nl -ba src/cljc/yin/vm/linker/publish.cljc | sed -n '239,275p' && nl -ba src/cljc/yang/python/antlr/linked_harness.cljc 2>/dev/null | head -5 && nl -ba test/yang/python/antlr/linked_harness.cljc | sed -n '50,69p' && nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '1360,1382p'\"","aggregated_output":"   239\t     (merge {:contract (:contract format)\n   240\t             :derivation :verifying\n   241\t             :defer-discharge true}\n   242\t            (dissoc opts :bounds)))))\n   243\t\n   244\t\n   245\t(defn- publish-closure!\n   246\t  \"`publish-module!` under the composition bounds of `opts`.\"\n   247\t  [handle {:keys [name ast exports requires primitives] :as spec} opts]\n   248\t  (let [undefined (first (remove (definitions ast) exports))\n   249\t        tree (when-not undefined\n   250\t               (try (vm/ast->semantic-bytecode ast)\n   251\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\n   252\t                      (refusal :yin.link.publish/malformed-tree {}))))\n   253\t        defect (when (and tree (not= :refused (:status tree)))\n   254\t                 (vm/validate-rows tree))\n   255\t        ;; each pinned closure is walked before anything is written; an\n   256\t        ;; absent pinned manifest is the footprint's missing-requirement\n   257\t        requirement\n   258\t        (when (and tree (not defect) (not= :refused (:status tree)))\n   259\t          (some (fn [[n address]]\n   260\t                  (let [w (closure/walk handle address opts)]\n   261\t                    (case (:yin.link.closure/outcome w)\n   262\t                      :complete nil\n   263\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n   264\t                                        {:name n})\n   265\t                      :missing (when (not= address (:address w))\n   266\t                                 (refusal :yin.link.publish/incomplete-requirement\n   267\t                                          {:name n :walk w})))))\n   268\t                (sort-by (fn [[n _]] (str n)) requires)))\n   269\t        fp (when (and tree (not defect) (not requirement)\n   270\t                      (not= :refused (:status tree)))\n   271\t             (footprint handle (assoc spec :tree tree)))\n   272\t        ;; a C1 claim is validated before anything is written: a module\n   273\t        ;; whose markers do not cover its tree is never published as\n   274\t        ;; though it did. One publication is one admission event\n   275\t        ;; (design §2.1): the admission identity is pinned explicitly by\n    50\t       (data/register-data-module {::data/max-items 1048576})\n    51\t       (prelude/register-integer-module limits)\n    52\t       module/register-stream-module)))\n    53\t\n    54\t\n    55\t(def published\n    56\t  \"`yang.call` and `py` published once into their own content store.\"\n    57\t  (delay\n    58\t    (let [store (mem/create-content-mem)\n    59\t          call-result (publish/publish-module! store (call/module-spec (registry)))\n    60\t          result (publish/publish-module! store\n    61\t                                          (prelude/module-spec (registry)\n    62\t                                                               (:address call-result)))]\n    63\t      {:store store, :result result, :address (:address result),\n    64\t       :call-result call-result, :call-address (:address call-result)})))\n    65\t\n    66\t\n    67\t(def published-pysp\n    68\t  \"`pysp` published once into `py`'s own content store, which its pinned\n    69\t   requirement already lives in: the same shape as `published`.\"\n  1360\t    [php/pow-sq\n  1361\t     ;; x^n for an exact integer n >= 0 by squaring on doubles\n  1362\t     (fn [x n]\n  1363\t       (if (= n 0)\n  1364\t         (data/float-value 1)\n  1365\t         (let [half (get (integer/floor-div-mod n 2) 0)\n  1366\t               r (php/pow-sq (* x x) half)]\n  1367\t           (if (= (get (integer/floor-div-mod n 2) 1) 1) (* r x) r))))]\n  1368\t    [php/pow-neg\n  1369\t     ;; x ** -n for an integer n > 0: 1 / x^n while x^n is finite, so every\n  1370\t     ;; exact case is exact; when x^n overflows, the reciprocals of its two\n  1371\t     ;; halves, so 2 ** -1074 is 5e-324. Underflow of x^n is INF.\n  1372\t     (fn [x n]\n  1373\t       (let [p (php/pow-sq x n)]\n  1374\t         (if (= (php/abs-h p) (php/inf))\n  1375\t           (let [h (get (integer/floor-div-mod n 2) 0)]\n  1376\t             (* (/ (data/float-value 1) (php/pow-sq x h))\n  1377\t                (/ (data/float-value 1) (php/pow-sq x (integer/sub n h)))))\n  1378\t           (if (= p (php/zero-h))\n  1379\t             (if (< x 0)\n  1380\t               (if (= (get (integer/floor-div-mod n 2) 1) 1)\n  1381\t                 (php/neg-h (php/inf))\n  1382\t                 (php/inf))\n","exit_code":0,"status":"completed"}}
