are-free-name\n    37\t  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n    38\t   when `covered` (the requirement-pinned module names) covers it. A name\n    39\t   no `vm/primitives` profile or host export supplies throws, with\n    40\t   `refusal` under `refusal-key` in its data.\"\n    41\t  [refusal-key refusal registry covered n]\n    42\t  (if (and (symbol? n) (some? (namespace n))\n    43\t           (contains? covered (symbol (namespace n))))\n    44\t    nil\n    45\t    (or (prelude-admission/host-declaration registry n)\n    46\t        (throw (ex-info \"the module reads an undeclared name\"\n    47\t                        {refusal-key refusal, :name n})))))\n    48\t\n    49\t\n    50\t(defn free-primitives\n    51\t  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n    52\t  [refusal-key refusal registry covered ast]\n    53\t  (into {}\n    54\t        (keep (partial declare-free-name refusal-key refusal registry covered))\n    55\t        (prelude/free-name-vec ast)))\n    56\t\n    57\t\n    58\t(defn module-spec\n    59\t  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n    60\t   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n    61\t   ({module-symbol address}). A free name under a required module is covered\n    62\t   by it; any other is declared as `declare-free-name` does.\"\n    63\t  [refusal-key refusal registry\n    64\t   {:keys [name ast exports runtime-name runtime-address deps]}]\n    65\t  (let [requires (into {runtime-name runtime-address} deps)]\n    66\t    {:name name,\n    67\t     :ast ast,\n    68\t     :exports exports,\n    69\t     :requires requires,\n    70\t     :primitives (free-primitives refusal-key refusal registry\n    71\t                                  (set (keys requires)) ast)}))\n    72\t\n    73\t\n    74\t(defn alias-spec\n    75\t  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n337:;;   IEEE-754 and yield Infinity, so checked-divide makes the error\n338-;;   host-uniform.\n339-;; - require: returns an effect descriptor consumed by the engine.\n340-;; There is no `yin/def` primitive: a definition is syntax (Rule R).\n341:(defn- checked-divide\n342-  \"clojure.core `/` except a zero divisor throws on every host.\n343-\n344-   JVM `/` throws `Divide by zero` for integral division only; JS and Dart\n345-   yield Infinity, so `(/ 1 0)` through the VM silently evaluated to `##Inf`\n346-   on those hosts. The REPL corpus pins divide-by-zero as an error with this\n347-   text on both evaluators (docs/design/yin.vm.divergence-register.md).\n348-   JS and Dart cannot distinguish `0` from `0.0`, so no rule reproduces the\n349-   JVM's double-division `##Inf` cross-host; the uniform error is the\n350-   contract.\"\n351:  ([x] (checked-divide 1 x))\n352-  ([x y]\n353-   (when (and (number? y) (zero? y))\n354-     (throw (ex-info \"Divide by zero\" {:divisor y})))\n355-   (/ x y))\n356:  ([x y & more] (reduce checked-divide (checked-divide x y) more)))\n357-\n358-\n359-(defn primitive-profile\n360-  \"Build UCF §7.5.2's published profile record for `name`.\n361-\n362-   The address covers the name and all four semantic declarations. The name\n363-   remains the registry key rather than being duplicated in the returned\n364-   record. Profile values contain no host function objects and are therefore\n365-   ordinary portable data.\"\n366-  [name class arities effects host-state]\n367-  (let [description {:yin.k/name name,\n368-                     :yin.k/class class,\n369-                     :yin.k/arities (vec arities),\n370-                     :yin.k/effects (set effects),\n371-                     :yin.k/host-state host-state}\n372-        digest (jing/content-hash description {:algorithm :blake3})]\n373-    {:yin.k/profile (keyword \"yin.k.pp\" (str \"blake3-\" digest)),\n374-     :yin.k/class class,\n375-     :yin.k/arities (vec arities),\n376-     :yin.k/effects (set effects),\n377-     :yin.k/host-state host-state}))\n378-\n--\n407:           (pure '/ checked-divide [1 2 :variadic])\n408-           (pure '= = [0 1 2 :variadic])\n409-           (pure '== = [0 1 2 :variadic])\n410-           (pure '!= not= [1 2 :variadic])\n411-           (pure '< < [1 2 :variadic])\n412-           (pure '> > [1 2 :variadic])\n413-           (pure '<= <= [1 2 :variadic])\n414-           (pure '>= >= [1 2 :variadic])\n415-           (pure 'not not [1])\n416-           (pure 'nil? nil? [1])\n417-           (pure 'empty? empty? [1])\n418-           (pure 'first first [1])\n419-           (pure 'rest (fn [a] (vec (rest a))) [1])\n420-           (pure 'conj conj [1 2 :variadic])\n421-           (pure 'assoc assoc [3 :variadic])\n422-           (pure 'get get [2 3])\n423-           (pure 'vec vec [1])\n424-           ;; one arity: strict UTF-8 on every host (dao.host.text, slice\n425-           ;; H2, ratified OQ11: encoding arity 2 removed from portable profile)\n426-           (pure 'bytes->str\n427-                 (fn [b] (text/utf8-decode b))\n428-                 [1])\n429-           ['require (primitive-entry\n","exit_code":0,"status":"completed"}}
