  (py/type-error {:py/str \"can't multiply sequence by non-int\"})))]\n  1360\t    [py/sequence?\n  1361\t     (fn [x]\n  1362\t       (if (py/str? x)\n  1363\t         true\n  1364\t         (let [k (py/kind x)] (if (= k :list) true (= k :tuple)))))]\n  1365\t    [py/mul\n  1366\t     (fn [a b]\n  1367\t       (if (py/sequence? a)\n  1368\t         (py/repeat a b)\n  1369\t         (if (py/sequence? b) (py/repeat b a) (py/arith :mul a b))))]\n  1370\t    [py/imul\n  1371\t     (fn [a b]\n  1372\t       (if (= (py/kind a) :list)\n  1373\t         (let [c (cell/get a)]\n  1374\t           (do (cell/set! a (assoc c :items (get (cell/get (py/repeat a b)) :items)))\n  1375\t               a))\n  1376\t         (py/mul a b)))]\n  1377\t\n  1378\t    ;; ---------------------------------------------------------- integer ops\n  1379\t    ;; Exact guest integer arithmetic goes through the integer module.\n  1380\t    [py/int? (fn [x] (if (py/numeric? x) (not (py/float? x)) false))]\n  1381\t    [py/abs\n  1382\t     (fn [x]\n  1383\t       (if (< (integer/compare x 0) 0)\n  1384\t         (py/int-result (integer/neg x)) x))]\n  1385\t    [py/float-abs (fn [x] (if (< x 0) (- 0 x) x))]\n  1386\t    ;; |x| < Inf, not |x| <= Double.MAX_VALUE: on JS that literal is an\n  1387\t    ;; integral number past 2^53, which dao.jing.cbor refuses to hash (see\n  1388\t    ;; the safe integer literal range); NaN is false either way\n  1389\t    [py/finite? (fn [x] (< (py/float-abs x) (data/float-value ##Inf)))]\n  1390\t    [py/fmod-pos\n  1391\t     ;; fmod for doubles x >= 0, y > 0, exactly: each subtraction is of\n  1392\t     ;; values within a factor of two (Sterbenz), as in long division\n  1393\t     (fn [x y]\n  1394\t       (if (< x y)\n  1395\t         x\n  1396\t         (let [r (py/fmod-pos x (+ y y))]\n  1397\t           (if (< r y) r (- r y)))))]\n  1398\t    ;; Zero tests here go through py/zero?: host `=` tells 0.0 from 0 on the\n  1399\t    ;; JVM but not on JS or Dart. A zero result takes its sign from the\n  1400\t    ;; divisor (never zero here), chosen rather than computed, since\n  1401\t    ;; 0.0 * inf is NaN.\n  1402\t    [py/zero-like\n  1403\t     ;; copysign(0.0, y) for a nonzero y\n  1404\t     ;; -0.0 is built as (* -1.0 0.0): ClojureDart compiles one-argument\n  1405\t     ;; `-` to (0 - x), and 0 - 0.0 is +0.0; multiplying by -1.0 negates\n  1406\t     ;; exactly on every host\n  1407\t     (fn [y]\n  1408\t       (let [z (data/float-value 0)]\n  1409\t         (if (< y 0) (* (data/float-value -1) z) z)))]\n  1410\t    [py/float-mod\n  1411\t     ;; x % y as CPython computes it: the exact fmod, sign-corrected toward\n  1412\t     ;; y. No quotient is formed, so a large finite quotient is fine.\n  1413\t     (fn [x y]\n  1414\t       (if (if (py/finite? x) (<= y y) false)\n  1415\t         (let [m0 (py/fmod-pos (py/float-abs x) (py/float-abs y))\n  1416\t               m (if (< x 0) (- 0 m0) m0)]\n  1417\t           (if (py/zero? m)\n  1418\t             (py/zero-like y)\n  1419\t             (if (= (< y 0) (< m 0)) m (+ m y))))\n  1420\t         (+ (- x x) (- y y))))]\n  1421\t    [py/float-divmod\n  1422\t     ;; [floor-quotient remainder] as CPython's float_divmod computes them:\n  1423\t     ;; The remainder is exact fmod, sign-corrected. Above 2^53 a finite\n  1424\t     ;; double is already integral; a non-finite quotient passes through.\n  1425\t     (fn [x y]\n  1426\t       (if (if (py/finite? x) (<= y y) false)\n  1427\t         (let [m0 (py/fmod-pos (py/float-abs x) (py/float-abs y))\n  1428\t               m (if (< x 0) (- 0 m0) m0)\n  1429\t               adjust (if (py/zero? m) false (not (= (< y 0) (< m 0))))\n  1430\t               mod (if (py/zero? m) (py/zero-like y) (if adjust (+ m y) m))\n  1431\t               div (- (/ (- x m) y) (data/float-value (if adjust 1 0)))\n  1432\t               ;; a zero quotient is copysign(0.0, x / y); here |x| < |y|,\n  1433\t               ;; so x / y is finite and 0