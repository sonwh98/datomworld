its a b)))\n   262\t\n   263\t\n   264\t(defn- fast-compare\n   265\t  [limits a b]\n   266\t  (if (and (host/safe-native? a) (host/safe-native? b))\n   267\t    (cond (< a b) -1\n   268\t          (> a b) 1\n   269\t          :else 0)\n   270\t    (int-compare limits a b)))\n   271\t\n   272\t\n   273\t(def ^:private fast-kernels\n   274\t  {'add fast-add, 'sub fast-sub, 'mul fast-mul, 'compare fast-compare})\n   275\t\n   276\t\n   277\t(defn- divisor!\n   278\t  [op b]\n   279\t  (let [y (big! op 1 b)]\n   280\t    (when (zero? (sign y))\n   281\t      (refuse! op :zero-division {}))\n   282\t    y))\n   283\t\n   284\t\n   285\t(defn- int-quot-rem\n   286\t  [limits a b]\n   287\t  (let [x (big! 'quot-rem 0 a)\n   288\t        y (divisor! 'quot-rem b)]\n   289\t    (pair (out limits (host/quot-trunc x y))\n   290\t          (out limits (host/rem-trunc x y)))))\n   291\t\n   292\t\n   293\t(defn- int-floor-div-mod\n   294\t  [limits a b]\n   295\t  (let [x (big! 'floor-div-mod 0 a)\n   296\t        y (divisor! 'floor-div-mod b)\n   297\t        q (host/quot-trunc x y)\n   298\t        r (host/rem-trunc x y)\n   299\t        adjust? (and (not (zero? (sign r))) (not= (sign r) (sign y)))]\n   300\t    (pair (out limits (if adjust? (host/sub q one) q))\n   301\t          (out limits (if adjust? (host/add r y) r)))))\n   302\t\n   303\t\n   304\t(defn- int-pow\n   305\t  [limits a e]\n   306\t  (let [x (big! 'pow 0 a)\n   307\t        n (big! 'pow 1 e)\n   308\t        max-bits (::max-bits limits)]\n   309\t    (cond\n   310\t      (neg? (sign n)) (refuse! 'pow :negative-exponent {})\n   311\t      (zero? (sign n)) 1\n   312\t      (or (zero? (sign x)) (zero? (host/compare-big x one))) (host/demote x)\n   313\t      (zero? (host/compare-big x neg-one))\n   314\t      (if (zero? (sign (host/bit-and-big n one))) 1 -1)\n   315\t      ;; |x| >= 2 from here, so |x^n| has at least n + 1 bits\n   385\t      (out limits (host/shift-right-big x (host/to-native n)))\n   386\t      (if (neg? (sign x)) -1 0))))\n   387\t\n   388\t\n   389\t(defn- int-bit-length\n   390\t  [_limits a]\n   391\t  (bits (big! 'bit-length 0 a)))\n   392\t\n   393\t\n   394\t;; =============================================================================\n   395\t;; Floats (version 3)\n   396\t;; =============================================================================\n   397\t\n   398\t(def ^:private two-53-float (float-kernel/pow2 53))\n   399\t\n   400\t\n   401\t(defn- magnitude\n   402\t  [b]\n   403\t  (if (neg? (sign b)) (host/sub zero b) b))\n   404\t\n   405\t\n   406\t(defn- ratio->float\n   407\t  \"`dao.host.float/ratio->float`, with its overflow sentinel answered as\n   408\t   this module's `::float-overflow`.\"\n   409\t  [x y negative?]\n   410\t  (let [f (float-kernel/ratio->float x y negative?)]\n   411\t    (if (= ::float-kernel/float-overflow f) ::float-overflow f)))\n   412\t\n   413\t\n   414\t(defn- int-to-float\n   415\t  [_limits a]\n   416\t  (let [x (big! 'to-float 0 a)]\n   417\t    (ratio->float (magnitude x) one (neg? (sign x)))))\n   418\t\n   419\t\n   420\t(defn- int-true-div\n   421\t  [_limits a b]\n   422\t  (let [x (big! 'true-div 0 a)\n   423\t        y (divisor! 'true-div b)]\n   424\t    ;; CPython: 0 / -5 is -0.0\n   425\t    (ratio->float (magnitude x) (magnitude y)\n   426\t                  (not= (neg? (sign x)) (neg? (sign y))))))\n   427\t\n   428\t\n   429\t(defn- float!\n   430\t  \"Argument `arg` of `op` as a host double, or a `:wrong-type` refusal.\"\n   431\t  [op arg v]\n   432\t  (if (host/host-float? v) v (wrong-type! op arg :float)))\n   433\t\n   434\t\n   435\t(defn- int-compare-float\n   436\t  [_limits a f]\n   437\t  (let [x (big! 'compare-float 0 a)\n   438\t        v (float! 'compare-float 1 f)]\n   439\t    (cond\n   440\t      (host/nan-float? v) (wrong-type! 'compare-float 1 :non-nan-float)\n   441\t      (host/infinite-float? v) (if (pos? v) -1 1)\n   442\t      :else\n   443\t      ;; t = trunc(v): x < t means x < v, x > t means x >= t + 1 > v\n   444\t      ;; (or x > t >= v when v is negative); x = t leaves the fraction\n   445\t      (let [c (host/compare-big x (float-kernel/trunc-big v))]\n   446\t        (cond (not (zero? c)) c\n   447\t              (or (>= (float-kernel/signed (neg? v) v) two-53-float)\n   448\t                  (= v (host/native->double (host/trunc-native v))))\n   449\t              0\n   450\t              (pos? v) -1\n   451\t              :else 1)))))\n   452\t\n   453\t\n   454\t(defn- int-from-float\n   455\t  [limits f]\n   456\t  (let [v (float! 'from-float 0 f)]\n   457\t    (if (or (host/nan-float? v) (host/infinite-float? v))\n   458\t      (wrong-type! 'from-float 0 :finite-float)\n   459\t      (out limits (float-kernel/trunc-big v)))))\n   460\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"nl -ba docs/design/yang.antlr.md | sed -n '3558,3589p;3652,3736p;3840,3892p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"nl -ba docs/design/yang.antlr.md | sed -n '3558,3589p;3652,3736p;3840,3892p'\"","aggregated_output":"  3558\t#### 8.10.2 Callable representation and identity\n  3559\t\n  3560\tKeep the callable's existing identity and source-specific data. Add the\n  3561\tcommon entry beside its private code and metadata:\n  3562\t\n  3563\t```clojure\n  3564\t;; Illustrative contents of one task-owned Python function cell.\n  3565\t;; `entry` and `body-code` are live Yin closures, not literal AST maps.\n  3566\t{:yang.call/entry entry\n  3567\t :py/type :function\n  3568\t :spec parameter-spec\n  3569\t :defaults defaults\n  3570\t :code body-code}\n  3571\t```\n  3572\t\n  3573\tThe existing `:code` field is not the shared entry: its signature differs\n  3574\tbetween preludes. It may remain private. Cross-language callers must not\n  3575\tinspect it or extract it to bypass the entry.\n  3576\t\n  3577\tA cell-backed callable stores the entry in its cell contents. An\n  3578\timmutable callable descriptor, such as a bound method, may carry it\n  3579\tdirectly in its map. The common prelude projects the entry structurally:\n  3580\tread an existing sealed cell reference through `cell/get`, or inspect\n  3581\tthe immutable descriptor, then obtain `:yang.call/entry`. A\n  3582\tcell-ref-shaped map is dereferenced only when the heap authenticates it\n  3583\t(`cell/authentic?`, section 8.10.12); an unauthenticated shape projects\n  3584\tto itself and follows the ordinary descriptor rules, so data imitating\n  3585\tthe reference language stays data. The projection must not\n  3586\tdispatch on `:py/type`, `:js/type`, `:php/type`, language names, or a\n  3587\tregistry of languages.\n  3588\t\n  3589\tAn admitted callable is a runtime cell/descriptor constructed or exposed\n  3652\tand custody rules. Internal helper calls need not construct records.\n  3653\t\n  3654\t#### 8.10.3 Invocation record\n  3655\t\n  3656\tThe invocation is an ephemeral in-machine value. These keys are proposed\n  3657\tvocabulary, not existing repository APIs:\n  3658\t\n  3659\t```clojure\n  3660\t{:yang.call/callee     f\n  3661\t :yang.call/positional [v0 v1 ...]\n  3662\t :yang.call/named      [[\"name\" value] ...]\n  3663\t :yang.call/raise      raise-exit\n  3664\t ;; Optional: presence means a receiver was supplied, even when nil.\n  3665\t :yang.call/receiver   receiver\n  3666\t ;; Optional: pinned argument-binding extension, for example locations.\n  3667\t :yang.call/binding-profile \"<content-address>\"}\n  3668\t```\n  3669\t\n  3670\tThe four required fields mean:\n  3671\t\n  3672\t- `:yang.call/callee`: the original resolved callable, including its\n  3673\t  identity. The invocation helper supplies it; an extracted entry must\n  3674\t  not be applied to another object's substituted state.\n  3675\t- `:yang.call/positional`: a dense ordered vector of evaluated values.\n  3676\t  Its length records presence; no missing-argument sentinel is inserted.\n  3677\t- `:yang.call/named`: ordered name/value pairs, not a map. Names are\n  3678\t  plain text without caller-side case folding or normalization.\n  3679\t  Duplicate names remain visible until the callee's binder decides them.\n  3680\t- `:yang.call/raise`: this activation's caller-supplied, non-returning\n  3681\t  guest exit, accepting the condition in section 8.10.7. It closes over\n  3682\t  the caller's continuation and exception machinery, never a host\n  3683\t  callback or hidden global handler slot.\n  3684\t\n  3685\tAn absent receiver differs from one whose value is `nil`, `:py/None`,\n  3686\t`:php/null`, `:js/null`, or `:js/undefined`. Empty argument vectors are\n  3687\trequired rather than represented by absent keys. Presence must not be\n  3688\tinferred from truthiness.\n  3689\t\n  3690\tThe optional binding profile pins additional argument semantics. It\n  3691\tdoes not name the caller's language or select a language-pair bridge.\n  3692\tAbsent that extension, arguments are by-value runtime values as in\n  3693\tsection 8.10.6. The callee entry compares the supplied profile address\n  3694\twith its declared accepted/required binding profiles before acquiring\n  3695\treferences or entering the body. An unsupported required profile or a\n  3696\tmissing required extension fails there. The pinned profile defines the\n  3697\tshape and validation of any extra invocation fields it requires; values\n  3698\tin the base vectors alone do not establish a location protocol.\n  3699\t\n  3700\tThe PHP reference-argument profile is pinned as\n  3701\t`sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb`.\n  3702\tPHP call sites include it when their declared target has reference\n  3703\tparameters; corresponding positional values may then be PHP reference\n  3704\tmarkers for caller locations. The PHP entry rejects unknown profile\n  3705\taddresses before parameter binding, and only this profile authorizes its\n  3706\tbinder to attach a parameter to a caller marker. The markers alone carry\n  3707\tno binding authority.\n  3708\t\n  3709\tConvention revision is pinned by the existing lowering/runtime profiles.\n  3710\tIt is not a new canonical AST slot, a per-function language tag, or a\n  3711\trepeated version field in every invocation. Incompatible revisions need\n  3712\tnew profiles and explicit admission, never entry-shape guessing.\n  3713\t\n  3714\tThe shared helper validates the record's map shape, required presence,\n  3715\tpositional vector, and ordered pairs with text names. The callee entry\n  3716\tvalidates extension fields under its admitted binding profile; the shared\n  3717\thelper knows no extension-specific representation. A valid caller-owned\n  3718\traise exit is established before constructing the record, so structural\n  3719\tfailures can be transferred through it. If no valid raise exit exists,\n  3720\tthat is an operational wiring failure; do not invent a source exception\n  3721\tpath, default missing fields to `nil`, or broadly catch VM application\n  3722\terrors. Checking live entry/exit/predicate closure arity is not part of\n  3723\tthis validation; constructor fixtures and admission under pinned\n  3724\tprofiles establish those obligations.\n  3725\t\n  3726\t#### 8.10.4 Source semantics at caller and callee\n  3727\t\n  3728\tThe caller's lowering preserves its source rules for callable resolution,\n  3729\targument/receiver evaluation, and spread or unpacking. Evaluate each\n  3730\texpression exactly once, in the source-defined order. Errors required\n  3731\tbefore argument evaluation must still occur before it. The record holds\n  3732\tevaluated values; the callee must not reevaluate source expressions.\n  3733\t\n  3734\tAfter source resolution, calls use the common projection and application.\n  3735\tFor a cell-backed callable, the successful path is schematically:\n  3736\t\n  3840\t\n  3841\t#### 8.10.7 Normal return and escaping conditions\n  3842\t\n  3843\tNormal return is the value of ordinary Yin application. There is no\n  3844\textra return continuation, completion packet around each result, or new\n  3845\tlanguage-specific return instruction.\n  3846\t\n  3847\tAn escaping source exception invokes the supplied raise exit with:\n  3848\t\n  3849\t```clojure\n  3850\t{:yang.call/reason :yang.call/thrown\n  3851\t :yang.call/value  original-thrown-value}\n  3852\t```\n  3853\t\n  3854\tThis is the argument to an exceptional continuation transfer, not an\n  3855\tordinary return. Returning an identical-looking map returns normal data.\n  3856\tLikewise, a source program throwing a map with these keys throws that\n  3857\tmap as the **payload of a new condition**; its shape is never evidence\n  3858\tthat it is already a condition to forward. No engine-effect value is\n  3859\tsynthesized.\n  3860\t\n  3861\tProtocol failures use qualified reasons such as\n  3862\t`:yang.call/not-callable`, `:yang.call/invalid-invocation`, and\n  3863\t`:yang.call/unsupported-binding`, with plain evidence. The caller maps\n  3864\tthem to a documented local exception form retaining the complete\n  3865\toriginal condition. Callee argument-binding failures retain the actual\n  3866\tcallee exception under `:yang.call/thrown`. These reasons do not extend\n  3867\t`dao.stream`'s outcome algebra.\n  3868\t\n  3869\tThe receiving caller interprets an escaping exception as follows:\n  3870\t\n  3871\t1. A payload valid as an exception in its own runtime retains that\n  3872\t   runtime's ordinary catching and identity behavior.\n  3873\t2. A runtime permitting arbitrary thrown values, such as JavaScript,\n  3874\t   may deliver the original payload directly.\n  3875\t3. A runtime requiring exception objects, such as Python or PHP,\n  3876\t   represents an otherwise foreign payload with its own\n  3877\t   `ForeignException`, retaining the complete condition and original\n  3878\t   payload. Catch-all catches this local object. Typed source catches\n  3879\t   match its local hierarchy, never guessed foreign class names.\n  3880\t\n  3881\t`ForeignException` is a proposed prelude-owned type, not a VM type.\n  3882\tUnchanged rethrow propagates the original condition without adding\n  3883\twrappers. Raising a new exception creates a new condition. Crossing back\n  3884\tinto a runtime recognizing the original exception restores its original\n  3885\ttype and identity. Formatting a foreign payload must not implicitly\n  3886\tinvoke a foreign method.\n  3887\t\n  3888\tThe runtime associates its generated wrapper's identity with the retained\n  3889\tcondition for the wrapper's entire lifetime, separate from source-writable\n  3890\tattributes. The association normally lives in private wrapper-cell\n  3891\tcontents, or an equivalent task-owned identity structure with the same\n  3892\tlifetime. It survives storing or returning the wrapper after the creating\n","exit_code":0,"status":"completed"}}
