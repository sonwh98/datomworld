eep assertion payloads (the PHPT selection diagnostics and\n                  ;; the conformance compositions) overflow smaller stacks in\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n                  ;; the 4m minimum for the prelude recursion rows still holds)\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\" \"build/antlr/php/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.shell.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.shell.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n    