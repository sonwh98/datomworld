der for every runtime\n    44\t   key (stripped of `ns-str`), then every definition, stripped.\"\n    45\t  [ns-str uninit runtime-keys definitions]\n    46\t  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n    47\t        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n    48\t        definitions))\n    49\t\n    50\t\n    51\t(defn wide-app\n    52\t  \"One application whose operands are `nodes` (in order), applied to a lambda\n    53\t   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n    54\t   linker's scanners discharge every body read of a sibling or runtime key;\n    55\t   a `then` chain would nest definitions in closure bodies.\"\n    56\t  [nodes]\n    57\t  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    58\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n    59\t\n    60\t\n    61\t(defn module-tree\n    62\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    63\t   the `trailing` UAST nodes.\"\n    64\t  [defs trailing]\n    65\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    66\t                  trailing)))\n    67\t\n    68\t\n    69\t(defn exports\n    70\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    71\t   stripped.\"\n    72\t  [ns-str definitions]\n    73\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    74\t             definitions)))\n    75\t\n    76\t\n    77\t(defn free-names\n    78\t  \"Every variable name some occurrence of the map AST `ast` reads\n    79\t   unbound by an enclosing lambda.\"\n    80\t  [ast]\n    81\t  (letfn [(walk-node\n    82\t            [acc node bound]\n    83\t            (cond\n    84\t              (vector? node) (reduce (fn [a n] (walk-node a n bound)) acc node)\n    85\t              (not (map? node)) acc\n    86\t              :else\n    87\t              (case (:type node)\n    88\t                :variable (if (contains? bound (:name node))\n    89\t                            acc\n    90\t                            (conj acc (:name node)))\n    91\t                :literal acc\n    92\t                :lambda (walk-node acc (:body node) (into bound (:params node)))\n    93\t                (reduce (fn [a v] (walk-node a v bound)) acc (vals node)))))]\n    94\t    (walk-node #{} ast #{})))\n    95\t\n    96\t\n    97\t(defn defined-keys\n    98\t  \"Every literal key the map AST `ast` defines with `yin/def`, at any\n    99\t   depth.\"\n   100\t  [ast]\n   101\t  (set (keep (fn [node]\n   102\t               (when (and (map? node)\n   103\t                          (= :application (:type node))\n   104\t                          (= 'yin/def (get-in node [:operator :name])))\n   105\t                 (get-in node [:operands 0 :value])))\n   106\t             (tree-seq coll? seq ast))))\n   107\t\n   108\t\n   109\t(defn free-name-vec\n   110\t  \"The names `ast` reads and does not define, sorted.\"\n   111\t  [ast]\n   112\t  (vec (sort-by str\n   113\t                (remove (conj (defined-keys ast) 'yin/def) (free-names ast)))))\n   114\t\n   115\t\n   116\t(defn balanced-definitions->uast\n   117\t  \"Balanced definition-to-UAST emission: each [key form] pair maps to\n   118\t   u/def! and the vector splits at its midpoint, halving sequential depth\n   119\t   versus the linear u/seq-nodes chain. The tree shape is content-addressed:\n   120\t   empty input answers nil, and callers choose balanced versus linear\n   121\t   deliberately - never migrate between the two for style.\"\n   122\t  [defs]\n   123\t  (letfn [(sequence-tree [nodes]\n   124\t            (if (<= (count nodes) 1)\n   125\t              (first nodes)\n   126\t              (let [middle (quot (count nodes) 2)]\n   127\t                (u/then (sequence-tree (subvec nodes 0 middle))\n   128\t                        (sequence-tree (subvec nodes middle))))))]\n   129\t    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n   130\t\n   131\t\n   132\t(defn definitions->uast\n   133\t  [defs]\n   134\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n    70\t\n    71\t(defn seq-nodes\n    72\t  \"Evaluate every node in order; the value is the last one's.\"\n    73\t  [nodes]\n    74\t  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n    75\t\n    76\t\n    77\t(defn let1\n    78\t  [sym value body]\n    79\t  (app (lam [sym] body) value))\n    80\t\n    81\t\n    82\t(defn sexp->uast\n    83\t  [form]\n    84\t  (cond\n    85\t    (symbol? form) (v form)\n    86\t    (seq? form)\n    87\t    (let [[head & args] form]\n    88\t      (case head\n    89\t        fn (lam (first args) (sexp->uast (second args)))\n    90\t        if (if-node (sexp->uast (first args))\n    91\t                    (sexp->uast (second args))\n    92\t                    (sexp->uast (nth args 2)))\n    93\t        do (seq-nodes (map sexp->uast args))\n    94\t        let (let [[bindings body] args]\n    95\t              (reduce (fn [inner [sym value]]\n    96\t                        (let1 sym (sexp->uast value) inner))\n    97\t                      (sexp->uast body)\n    98\t                      (reverse (partition 2 bindings))))\n    99\t        quote (lit (first args))\n   100\t        %capture capture\n   101\t        (apply app (sexp->uast head) (map sexp->uast args))))\n   102\t    :else (lit form)))\n   103\t\n   104\t\n   105\t(def mark-tails\n   106\t  \"`yang.tails/mark-tails`: the lowering marks its tree with the same\n   107\t   function a rewriting stage recomputes the marks with.\"\n   108\t  tails/mark-tails)\n   109\t\n   110\t\n   111\t;; =============================================================================\n   112\t;; Call-site occurrence contract C1 (Addendum A, design §2)\n   113\t;; =============================================================================\n   114\t;;\n   115\t;; Every final `:application` occurrence of a produced tree carries the\n   116\t;; reserved frontend-metadata key `:yang/call-site` with version value `1`\n   117\t;; as a plain node key. Projection (`yin.vm/ast-side-tables`) drops the key\n   118\t;; from canonical rows and emits it into the frontend-metadata side table\n   119\t;; as `[origin root-address path :yang/call-site 1]`, where the first\n   120\t;; three coordinates are the site id. The key carries no callee identity,\n   121\t;; source arity, or ambient classification. It is distinct from\n   122\t;; `:yang/site`, the safepoint mark, which travels as node metadata.\n   123\t;; Dedicated node kinds (`:dao.stream.apply/call`, stream and\n   124\t;; continuation nodes) are not `:application` nodes and are never marked.\n   125\t;; The walk lives here, beside the other shared tree transforms, so every\n   126\t;; frontend's module trees finalize the same way; `yang.clojure` owns the\n   127\t;; contract's validation over canonical rows.\n   128\t\n   129\t(defn annotate-call-sites\n   130\t  \"The finished map AST `node` with `:yang/call-site 1` on every\n   131\t   `:application` node, at every depth the row grammar knows. Literal\n   132\t   payloads are data, never syntax, and are not walked. Marking is\n   133\t   idempotent and preserves node metadata and every other key, so\n   134\t   canonical rows, roots, and executable outcomes are unchanged.\"\n   135\t  [node]\n   136\t  (let [tag (:type node)\n   137\t        slots (get vm/semantic-bytecode-grammar tag)]\n   138\t    (when-not slots\n   139\t      (throw (ex-info \"Unknown AST node type\" {:type tag, :node node})))\n","exit_code":0,"status":"completed"}}
