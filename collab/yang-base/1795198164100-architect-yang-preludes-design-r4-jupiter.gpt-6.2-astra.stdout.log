pow integer/shift-right integer/bit-and\n   214\t           integer/bit-or integer/bit-xor integer/bit-not integer/from-float\n   215\t           integer/floor-div-mod integer/shift-left integer/format integer/parse\n   216\t           integer/float-digits integer/decimal->float integer/max-digits\n   217\t           data/substring data/max-items}\n   218\t        call/host-names))\n   219\t\n   220\t\n   221\t(defquoted ^:private core-definitions\n   222\t  \"Pure definitions: lambdas only, so defining them runs nothing.\"\n   223\t  '[;; ---------------------------------------------------------------- kinds\n   224\t    [py/cell? (fn [x] (= (get x :type) :cell-ref))]\n   225\t    [py/str? (fn [x] (not (nil? (get x :py/str))))]\n   226\t    [py/str (fn [s] (assoc {} :py/str s))]\n   894\t     (fn [cls name fallback]\n   895\t       (let [x (get (get (cell/get cls) :attrs) name :py/missing)]\n   896\t         (if (= x :py/missing) (fallback) x)))]\n   897\t\n   898\t    ;; ---------------------------------------------------------- functions\n   899\t    ;; A function's `spec` is static data from the lowering:\n   900\t    ;;   {:params [positional names] :star? bool :kwonly [names] :kwstar? bool}\n   901\t    ;; `defaults` holds the trailing positional defaults and `kwdefaults`\n   902\t    ;; [[name value] ...] the keyword-only ones, both evaluated at\n   903\t    ;; definition time. `code` takes one vector laid out as the parameters\n   904\t    ;; are written: positional, the *args tuple, keyword-only, the **kwargs\n   905\t    ;; dict.\n   906\t    [py/function-entry\n   907\t     ;; Generated boilerplate. Python functions are unbound here: a supplied\n   908\t     ;; receiver remains in the invocation but is not injected into args.\n   909\t     (fn [owner invocation]\n   910\t       (let [callee (get invocation :yang.call/callee :py/missing)\n   911\t             positional (get invocation :yang.call/positional :py/missing)\n   912\t             named (get invocation :yang.call/named :py/missing)\n   913\t             raise-exit (get invocation :yang.call/raise :py/missing)\n   914\t             binding-profile (get invocation :yang.call/binding-profile :py/missing)]\n   915\t         (if (if (= callee :py/missing) true\n   916\t                 (if (= positional :py/missing) true\n   917\t                     (if (= named :py/missing) true\n   918\t                         (if (= raise-exit :py/missing) true\n   919\t                             (not (= callee owner))))))\n   920\t           (raise-exit {:yang.call/reason :yang.call/invalid-invocation})\n   921\t           (if (not (= binding-profile :py/missing))\n   922\t             (raise-exit (assoc {:yang.call/reason :yang.call/unsupported-binding}\n   923\t                                :yang.call/binding-profile binding-profile))\n   924\t             (let [fc (cell/get owner)\n   925\t                   result (cell/new :py/None)]\n   926\t               (py/try\n   927\t                 (fn []\n   928\t                   (cell/set! result\n   929\t                              ((get fc :code)\n   930\t                               (py/bind-args fc positional named))))\n   931\t                 (fn [e]\n   932\t                   ;; A retained generated exception forwards its original\n   933\t                   ;; condition unchanged (no new wrapper); a fresh source\n   934\t                   ;; exception still becomes the plain §8.10.7 thrown\n   935\t                   ;; condition. Retention rides the exception's identity,\n   936\t                   ;; outside source-writable attributes.\n   937\t                   (let [retained (cell/dsg__provenance e)]\n   938\t                     (raise-exit\n   939\t                       (if (nil? retained)\n   940\t                         (assoc {:yang.call/reason :yang.call/thrown}\n   941\t                                :yang.call/value e)\n   942\t                         retained))))\n   943\t                 (fn [] (cell/get result))))))))]\n   944\t    [py/function-cell\n   945\t     (fn [name spec defaults kwdefaults code entry?]\n   946\t       (let [content (assoc (assoc (assoc (assoc (assoc (assoc {} :py/type :function)\n   947\t                                                        :name name)\n   948\t                                                 :spec spec)\n   949\t                                          :defaults defaults)\n   950\t                                   :kwdefaults kwdefaults)\n   951\t                            :code code)\n   952\t             f (cell/new content)]\n   953\t         (if entry?\n   954\t           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\n  1390\t    [py/fmod-pos\n  1391\t     ;; fmod for doubles x >= 0, y > 0, exactly: each subtraction is of\n  1392\t     ;; values within a factor of two (Sterbenz), as in long division\n  1393\t     (fn [x y]\n  1394\t       (if (< x y)\n  1395\t         x\n  1396\t         (let [r (py/fmod-pos x (+ y y))]\n  1397\t           (if (< r y) r (- r y)))))]\n  1398\t    ;; Zero tests here go through py/zero?: host `=` tells 0.0 from 0 on the\n  1399\t    ;; JVM but not on JS or Dart. A zero result takes its sign from the\n  1400\t    ;; divisor (never zero here), chosen rather than computed, since\n  1401\t    ;; 0.0 * inf is NaN.\n  1402\t    [py/zero-like\n  1403\t     ;; copysign(0.0, y) for a nonzero y\n  1404\t     ;; -0.0 is built as (* -1.0 0.0): ClojureDart compiles one-argument\n  1405\t     ;; `-` to (0 - x), and 0 - 0.0 is +0.0; multiplying by -1.0 negates\n  1406\t     ;; exactly on every host\n  1407\t     (fn [y]\n  1408\t       (let [z (data/float-value 0)]\n  1409\t         (if (< y 0) (* (data/float-value -1) z) z)))]\n  1410\t    [py/float-mod\n  1411\t     ;; x % y as CPython computes it: the exact fmod, sign-corrected toward\n  1412\t     ;; y. No quotient is formed, so a large finite quotient is fine.\n  1413\t     (fn [x y]\n  1414\t       (if (if (py/fin