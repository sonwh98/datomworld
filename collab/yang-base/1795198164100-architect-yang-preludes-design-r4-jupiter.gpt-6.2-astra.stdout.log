\t                   (data/float-value ##Inf)\n  1558\t                   (data/float-value 0))))))))]\n  1559\t    [py/float-power\n  4115\t(def module-exports\n  4116\t  \"The module's exports: every `py/` key of the definition list,\n  4117\t   stripped. The runtime keys and the state slot are internal.\"\n  4118\t  (core/exports \"py\" definitions))\n  4119\t\n  4120\t\n  4121\t(def free-names\n  4122\t  \"Every variable name some occurrence of the map AST reads unbound by an\n  4123\t   enclosing lambda.\"\n  4124\t  core/free-names)\n  4125\t\n  4126\t\n  4127\t(def defined-keys\n  4128\t  \"Every literal key the map AST defines with `yin/def`, at any depth.\"\n  4129\t  core/defined-keys)\n  4130\t\n  4131\t\n  4132\t(def ^:private module-free-names\n  4133\t  \"The names the module tree reads and does not define, sorted: the\n  4134\t   primitives and the host exports its manifest must declare.\"\n  4135\t  (core/free-name-vec module-uast))\n  4136\t\n  4137\t\n  4138\t(defn module-spec\n  4139\t  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `py`\n  4140\t   over the host registry `registry`. Every free name of the module tree\n  4141\t   is declared under `:primitives`; a free name nothing supplies is\n  4142\t   refused before anything is published. This namespace emits; it never\n  4143\t   publishes.\"\n  4144\t  [registry call-address]\n  4145\t  (prelude-admission/module-spec\n  4146\t    {:module-name module-name,\n  4147\t     :ast module-uast,\n  4148\t     :exports module-exports,\n  4149\t     :requires {'yang.call call-address},\n  4150\t     :free-names module-free-names,\n  4151\t     :skip? #(= \"yang.call\" (namespace %)),\n  4152\t     :registry registry,\n  4153\t     :message \"the py module reads an undeclared name\",\n  4154\t     :refusal-ns \"yang.python.antlr\"}))\n  4155\t\n  4156\t\n  4157\t(def min-integer-bits\n  4158\t  \"The smallest `::integer/max-bits` this profile admits: every inline\n  4159\t   literal (u