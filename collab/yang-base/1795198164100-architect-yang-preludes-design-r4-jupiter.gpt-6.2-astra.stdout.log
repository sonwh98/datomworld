{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'cat -n src/cljc/yang/core/prelude_admission.cljc'","aggregated_output":"     1\t(ns yang.core.prelude-admission\n     2\t  \"Constructs declarations/specifications and checks registries; does not publish, link, or execute.\"\n     3\t  (:require [yin.vm :as vm]\n     4\t            [yin.vm.module :as module]))\n     5\t\n     6\t\n     7\t(defn- refusal\n     8\t  [refusal-ns kind data]\n     9\t  (merge {(keyword refusal-ns \"refusal\") (keyword refusal-ns kind)} data))\n    10\t\n    11\t\n    12\t(defn host-declaration\n    13\t  \"`[n declaration]` for free name `n`: a primitive by its `vm/primitives`\n    14\t   profile, a host export `ns/name` by the profile address the registry's\n    15\t   host module `ns` publishes and its `:callable-effects` effect set; nil\n    16\t   when neither supplies it.\"\n    17\t  [registry n]\n    18\t  (if-let [profile (vm/profile-of vm/primitives n)]\n    19\t    [n profile]\n    20\t    (when-let [address (module/host-export-profile registry n)]\n    21\t      (let [entry (module/module-entry (:modules registry) (symbol (namespace n)))\n    22\t            f (get-in entry [:slice (symbol (name n))])]\n    23\t        [n {:yin.k/profile address,\n    24\t            :yin.k/effects (get (:callable-effects registry) f #{})}]))))\n    25\t\n    26\t\n    27\t(defn module-spec\n    28\t  \"`yin.vm.linker.publish/publish-module!`'s spec for module `module-name`.\n    29\t   `skip?` (n -> bool) marks free names a requirement already declares;\n    30\t   `requires` is the requirement map. A free name nothing supplies is\n    31\t   refused with `message` under `refusal-ns` before anything is published.\n    32\t   This namespace emits; it never publishes.\"\n    33\t  [{:keys [module-name ast exports requires free-names skip? registry message\n    34\t           refusal-ns]}]\n    35\t  {:name module-name,\n    36\t   :ast ast,\n    37\t   :exports exports,\n    38\t   :requires requires,\n    39\t   :primitives\n    40\t   (into {}\n    41\t         (keep (fn [n]\n    42\t                 (when-not (and skip? (skip? n))\n    43\t                   (or (host-declaration registry n)\n    44\t                       (throw (ex-info message\n    45\t                                       (refusal refusal-ns \"undeclared-free\"\n    46\t                                                {:name n})))))))\n    47\t         free-names)})\n    48\t\n    49\t\n    50\t(defn admit\n    51\t  \"Return `registry` when it supplies every one of `host-names`, else refuse\n    52\t   it before any program runs, naming each missing export in\n    53\t   `:<refusal-ns>/missing`.\"\n    54\t  [registry host-names message refusal-ns]\n    55\t  (let [missing (vec (sort-by str\n    56\t                              (remove #(some? (module/resolve-module\n    57\t                                                registry\n    58\t                                                (symbol (str (namespace %)\n    59\t                                                             \".\"\n    60\t                                                             (name %)))))\n    61\t                                      host-names)))]\n    62\t    (when (seq missing)\n    63\t      (throw (ex-info message\n    64\t                      (refusal refusal-ns \"host-names\"\n    65\t                               {(keyword refusal-ns \"missing\") missing}))))\n    66\t    registry))\n    67\t\n    68\t\n","exit_code":0,"status":"completed"}}
