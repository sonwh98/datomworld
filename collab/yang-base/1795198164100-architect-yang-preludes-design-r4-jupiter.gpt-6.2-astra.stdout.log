t    (defn vals\n  2865\t      [m]\n  2866\t      (map second (vec m)))\n  2867\t    (defn disj\n  2868\t      [s x]\n  2869\t      (data/disj s x))\n  2870\t    (defn union\n  2871\t      ([] #{})\n  2872\t      ([a] a)\n  2873\t      ([a b] (into a b))\n  2874\t      ([a b c] (into (into a b) c))\n  2875\t      ([a b c d] (into (into (into a b) c) d))\n  2876\t      ([a b c d e] (into (into (into (into a b) c) d) e))\n  2877\t      ([a b c d e f] (into (into (into (into (into a b) c) d) e) f)))\n  2878\t    (defn difference\n  2879\t      [a b]\n  2880\t      (reduce (fn [s x] (disj s x)) a b))\n  2881\t    (defn merge\n  2882\t      ([] nil)\n  2883\t      ([a] a)\n  2884\t      ([a b] (if (nil? b) a (if (nil? a) b (conj a b))))\n  2885\t      ([a b c] (merge (merge a b) c))\n  2886\t      ([a b c d] (merge (merge (merge a b) c) d)))\n  2887\t    (defn comp\n  2888\t      ([] identity)\n  2889\t      ([f] f)\n  2890\t      ([f g]\n  2891\t       (fn\n  2892\t         ([x] (f (g x)))\n  2893\t         ([x y] (f (g x y)))\n  2894\t         ([x y z] (f (g x y z)))))\n  2895\t      ([f g h] (comp f (comp g h))))\n  2896\t    (defn partial\n  2897\t      ([f a]\n  2898\t       (fn\n  2899\t         ([] (f a))\n  2900\t         ([x] (f a x))\n  2901\t         ([x y] (f a x y))\n  2902\t         ([x y z] (f a x y z))))\n  2903\t      ([f a b]\n  2904\t       (fn\n  2905\t         ([] (f a b))\n  2906\t         ([x] (f a b x))\n  2907\t         ([x y] (f a b x y))\n  2908\t         ([x y z] (f a b x y z))))\n  2909\t      ([f a b c]\n  2910\t       (fn\n  2911\t         ([] (f a b c))\n  2912\t         ([x] (f a b c x))\n  2913\t         ([x y] (f a b c x y))\n  2914\t         ([x y z] (f a b c x y z)))))])\n  2915\t\n  2916\t\n  2917\t(defn library-for\n  2918\t  \"The definitions of `library` that `forms` need: those whose names `forms`\n  2919\t   mention (outside quoted data), and the ones those mention in turn, in\n  2920\t   library order. Compiling only these keeps a program small.\"\n  2921\t  [forms]\n  2922\t  (let [by-name (into {} (map (fn [f] [(second f) f])) library)\n  2923\t        mentions (fn mentions\n  2924\t                   [form]\n  2925\t                   (cond\n","exit_code":0,"status":"completed"}}
