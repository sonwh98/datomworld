g.call/entry))\n  1476\t                                           (u/lit true)\n  1477\t                                           ;; the shape is only WHEN to ask (ruling of\n  1478\t                                           ;; record, rule 2): the heap answers\n  1479\t                                           ;; `cell/authentic?`, and an unauthenticated\n  1480\t                                           ;; shape takes ordinary map invocation\n  1481\t                                           (u/if-node (cell-ref-shaped-node (u/v callee))\n  1482\t                                                      (u/app (u/v 'cell/authentic?) (u/v callee))\n  1483\t                                                      (u/lit false)))\n  1484\t                                (u/lit false))\n  1485\t                     admitted\n  1486\t                     value-call)\n  1487\t                   admitted)]\n  1488\t      (cond-> (u/mark-tails (u/let1 callee callee-ast\n  1489\t                                    (u/let1 arguments arguments-ast routed)))\n  1490\t        tail? (assoc :tail? true)))))\n  1535\t\n  1536\t    (and (outcomes? env) (= operator 'yang.call/eligible?))\n  1537\t    (let [candidate 'dsg__eligibility_candidate]\n  1538\t      (cond-> (u/mark-tails\n  1539\t                (apply u/app\n  1540\t                       (u/lam [candidate]\n  1541\t                              (u/if-node\n  1542\t                                (u/app (u/v 'dsg__admitted?) (u/v candidate))\n  1543\t                                (u/app (u/v 'yang.call/eligible?) (u/v candidate))\n  1544\t                                (u/lit false)))\n  1545\t                       (map #(compile-form % false env macro-env) operands)))\n  1546\t        tail? (assoc :tail? true)))\n  1547\t\n  1548\t    (and (outcomes? env)\n  1549\t         (#{'yang.call/invoke 'yang.call/invoke-with} operator)\n  1550\t         (<= 4 (count operands)))\n  1551\t    (let [bindings (into ['dsg__invocation_candidate]\n  1552\t                         (map #(symbol (str \"dsg__invocation_operand_\" %)))\n  1553\t                         (range (dec (count operands))))\n  1554\t          compile-operand #(compile-form % false env macro-env)]\n  1555\t      (cond-> (u/mark-tails\n  1556\t                (apply u/app\n  1557\t                       (u/lam bindings\n  1558\t                              (u/if-node\n  1559\t                                (u/app (u/v 'dsg__admitted?) (u/v (first bindings)))\n  1560\t                                (apply u/app (u/v operator) (map u/v bindings))\n  1561\t                                (u/app (u/v 'yang.call/transfer)\n  1562\t                                       (u/v (nth bindings 3))\n  1563\t                                       (u/app (u/v 'yang.call/condition)\n  1564\t                                              (u/lit :yang.call/not-callable)\n  1565\t                                              (u/app (u/v 'dsg__assoc) (u/lit {})\n  1566\t                                                     (u/lit :yang.call/callee)\n  1567\t                                                     (u/v (first bindings)))))))\n  1568\t                       (map compile-operand operands)))\n  1569\t        tail? (assoc :tail? true)))\n  1570\t\n  1571\t    ;; a statically intra-unit defn/defn- under the outcome model: apply the\n  1572\t    ;; unit's public entry with the compiler's token packet (a two-element\n  1573\t    ;; vector: [token args]) - the private lane on the same unary entry,\n  1574\t    ;; one conj and one lookup, no record construction\n  1575\t    (intra-unit-fn? env operator)\n  1576\t    (cond-> {:type :application\n  1577\t             :operator {:type :variable, :name 'dsg__intra_call}\n  1578\t             :operands [(cond-> {:type :variable, :name operator}\n  1579\t                          (seq (meta operator)) (with-meta (meta operator)))\n  1580\t                        (compile-form (vec operands) false env macro-env)]}\n  1581\t      tail? (assoc :tail? true))\n  1582\t\n  1583\t    ;; A native lookup projects a carrier only for observation. The original\n  1584\t    ;; reference remains available for saving or rethrowing.\n  1585\t    (native-name? env operator)\n  1586\t    (cond-> {:type :application\n  1587\t             :operator (cond-> {:type :variable, :name operator}\n  1588\t                         (seq (meta operator)) (with-meta (meta operator)))\n  1589\t             :operands (mapv (fn [i operand]\n  1590\t                               (let [ast (compile-form operand false env macro-env)]\n  1591\t                                 (if (and (outcomes? env) (= operator 'get) (zero? i))\n  1592\t                                   (u/app (u/v 'dsg__condition_view) ast)\n  1593\t                                   ast))) (range) operands)}\n  1594\t      tail? (assoc :tail? true))\n  1595\t\n  1596\t    ;; a compiler-internal helper introduced by the pre-pass (the exception\n34:| Prelude namespace | Linker module | Size / definitions | Lowering coupling |\n44:1. **Duplicated guest runtime mechanics:** ~1,200–2,000 lines of guest UAST across `py`, `js`, `php`, and `clj` implement the same core algorithms under language-prefixed names: `%capture` handler stacks, IEEE-754 float64 math (`fmod-pos` Sterbenz loop, integer-exponent squaring with split-half reciprocal `neg-power`, `nan`/`inf`/`-0.0`, `float-floor` binary descent, `float-parts`, decimal layout over `integer/float-digits`), fixed-width integer wrapping and radix digit scanning, `gen-switch` coroutine stepping, and `stream/poll!` signal safepoint hooks.\n71:3. **No raw callbacks:** Policy hooks passed by a language prelude into `yrt.*` (`on-empty`, `on-range`, `on-underflow`, `on-bit-limit`, `on-digit-limit`, `on-float-overflow`, `fin`) are ordinary guest Yin closures, never host-boundary callbacks.\n72:4. **No shared mutable state:** Each language profile allocates its own task-local cells once per task in its own `init!` under its own private namespace (`py.rt/*`, `js.rt/*`, `php.rt/*`, `clj.rt/*`, `clj.py.rt/*`, `clojure.core.rt/*`).\n96:|   Language value encodings, coercions, error types, state cells, init!      |\n122:| **PHP `php.sp` budget/ticks hooks** | `php.sp` uses a decrementing execution-budget cell (`php.sp/remaining`) and `:line :after` statement ticks rather than `stream/poll!` signal cursors. |\n132:Remains unchanged at `src/cljc/yang/core/call.cljc` (`yang.antlr.md` §8.10): structural callable discovery (`entry`, `eligible?`), invocation records (`invocation`, `invocation-with`, `valid-invocation?`), and condition transfer (`condition`, `thrown`, `transfer`, `invoke`, `invoke-with`). Requires no `yrt.*` module so `yang.call` stays a leaf dependency.\n141:  - **4-to-5-slot migration for `js` and `clj`:** Currently `yang.typescript.antlr.prelude` and `yang.clojure.prelude` allocate `{:handlers hs}` and push 4-slot frames `[tag payload rest n]`. In P1, `js/init!`, `clj/init!`, and bundled `yang.clojure` migrate to `(yrt.escape/ctx nil 0 0 nil)` and 5-slot frames.\n147:    - **`depth` (slot 4):** activation-relative function call depth at the moment the frame was pushed, restored onto `:depth` by `pop-frame` (`py` and `php` recursion/safepoint accounting). Languages without call-depth hooks (`js`, `clj`) keep `depth = 0`.\n163:| `try-orelse` | `[ctx-cell body handler orelse]` | Install `:handler`; on normal exit restore and tail-call `(orelse)`; on escape restore and call `(handler r)` (`py`, `php`, `clj.py`) |\n184:   - **No-capture / no-safepoint rule:** All `*-raw` helpers acting on unwrapped host doubles (`data/float-value`) are pure leaf computations that **must not invoke `%capture`, safepoints, or arbitrary guest closures while an unwrapped double is live on the stack/in an environment**. Policy callbacks (`on-underflow`, `on-range`) take safe values (never returning unwrapped doubles across a continuation boundary) and are invoked only at explicit guard boundaries.\n201:| `neg-pow` | Unwrapped double `x` (finite nonzero caller-checked or IEEE), exact integer `n > 0`, `[x n] -> result` hook `on-underflow`, squaring fn | Computes `1 / x^n`; splits into halves `h` and `n - h` when `x^n` overflows to `Inf`; calls `(on-underflow x n)` when `x^n` underflows to `0.0` (so `py`/`js` raise `OverflowError` or compute `±Inf` while `php` returns signed `±Inf`) |\n255:     :rt-namespaces #{\"py.rt\" \"py.b\"}\n292:   - Collisions **are refused** whenever two components bind the same linker module symbol, when a local `module-definitions` key collides after namespace stripping, or when two source-facing `:ambient-projections` claim the same target identifier (`§6.3`).\n300:   - **Linked emission:** derives `:requires` and `:skip?` from `:yang.prelude/components`, emits `require` nodes in declared order, preserves `:rt-namespaces`, runs optional local unshadowing (`php`), and preserves exact C1 finalization (`:finalize-c1?` — matching `py`, `js`, `clj`, `yang.call` today while keeping `php` consistent).\n301:   - **Bundled emission (`compose-bundled`):** preserves existing ordering, `init!` placement, tail-marking, `:mode` (`:linear` vs `:balanced`, never silently altered because tree shape is content-addressed), and Clojure's custom preamble / `dsg__*` wrapper.\n315:Level 2 strictly subsumes Level 1: a semantics descriptor defines **both** what lowering emits for syntax constructs (`:yang.semantics/hooks` + `:yang.semantics/literals`) and which ambient modules/identifiers enter source scope (`:yang.semantics/ambient-modules` + `:yang.semantics/ambient-projections`).\n323:  3. Generic capability lookup, hook-hygiene validation (every hook must be namespace-qualified), exact export verification against a verified artifact closure, and reserved-door projection checks.\n326:  2. Structural AST lowering rules (e.g., how Python functions, loops, comprehensions, module packets, and `try`/`except`/`else`/`finally` marshal operands to those hooks).\n378: :yang.semantics/hooks\n379: {;; Arithmetic & comparisons — ALL namespace-qualified (hygienic, immune to guest shadowing)\n412:  ;; Control flow & unit entry\n418:  :unit/run-main    'clj.py/run-main}\n455:   - Every symbol in `:yang.semantics/hooks` **MUST be namespace-qualified** (e.g., `clj.py/vconj`, `py/vconj`, `clj.py/add`). Unqualified symbols (such as bare `conj`, `+`, `not`, `set`) are rejected at validation (`:yang.semantics/unqualified-hook`), because bare symbols inside lowered UAST could be silently captured by a valid Python parameter or local named `conj` or `not`.\n464:     - Verifies every hook required by `:yang.semantics/capabilities` is present, namespace-qualified, and exists as an **exact published export** in the corresponding manifest of `artifact-store` (or as a non-reserved export in a declared host module of `registry`, or an explicit non-reserved VM primitive in `yin.vm/primitives`). Namespace coverage alone is insufficient.\n466:     - **Reserved-door ban:** Refuses any descriptor whose `:hooks` or `:ambient-projections` references `cell/dsg__*`, `dsg__*`, `yin/def`, `*.rt/*`, `*.b/*`, or `yang.safepoint/*`, or exposes any unprivileged raw primitive without projection. Registry availability never grants source-level authority.\n481:   - Refactoring `yang.python.antlr.lower` (in **Slice P2** — and subsequently TypeScript/PHP) to read from `:yang.semantics/descriptor` MUST emit **byte-identical UAST rows** under the default descriptor (`:yang.python/py-v1`, carrying all 103 `py/*` hooks, `{:kind :tagged-map, :tag :py/float}`, `{:kind :tagged-map, :tag :py/str}`, `:py/None`, and existing supported capabilities) compared to the pre-refactor hardcoded lowering. Zero existing golden addresses move in P2.\n510:| `def f(x): ...` | cell `{:py/type :function :code (fn [args] ...) :yang.call/entry ...}` | authenticated cell `{:clj.py/type :function :name s :spec spec :yang.call/entry ...}` |\n546:| `:ctrl/try` | `[body handler orelse]` | **3-arg signature** calling `yrt.escape/try-orelse` on `(clj/rt-ctx)`, preserving Python `try` / `except` / `else`. |\n551:| `:unit/run-main` | `[body-fn]` | Calls `(clj/init!)` and `(clojure.core/init!)`; allocates a **fresh per-unit `globals` cell** (`(cell/new {})`) and `globals-fn`; invokes `(body-fn globals globals-fn)` inside a top-level handler; returns the value **verbatim without stripping `[:yin.k/ok ...]`** so ordinary Python data shaped like `[:yin.k/ok 42]` passes through uncorrupted. |\n562:   - Allocates `(cell/new {:clj.py/type :function, :name fname, :spec spec, :yang.call/entry entry})`.\n564:2. **Entry boundary (inside `:yang.call/entry`):**\n566:   - Executes `(body-fn args-vec)` inside `clj.py/try-orelse` (3-arg, `orelse = identity`). On escape with value `e`:\n586:   - Loading `clojure.core` defines pure lambdas only (zero task state at lift/link time). `(clojure.core/init!)` allocates the task's cell-backed `yang.call` descriptors once per task under internal `clojure.core.rt/*` cells (guarded by `clojure.core.rt/state`) and exports `(clojure.core/export sym)` for adapter lookup.\n588:4. **No implicit namespace dump & zero impact on default `yang.clojure` in P3:**\n615:All new `yang.core.*` and `yang.rt.*` (`yrt.*`) namespaces live in `src/cljc/` and obey the repository's four-host constraints:\n634:- **Bounded public APIs:** Host namespaces maintain 2–5 `defn` entry points (`yang.core.semantics`: `validate-descriptor`, `capability-status`, `literal-node`, `hook-symbol`, `resolve-ambient`), and guest `yrt.*` modules bound their public export count cleanly (grouping only cohesive primitives per module rather than creating a sprawling grab-bag).\n647:| **P0 — Composition plumbing & `defquoted` consolidation** | Consolidate `defquoted` into `yang.core.prelude`; implement `:yang.prelude/recipe` / `:yang.prelude/profile` composition and verified-closure validation in `yang.core.prelude` + `prelude-admission` (preserving operand sequencing, `init!` placement, tail marking, `:linear`/`:balanced` mode, and Clojure's custom preamble). | **Zero** (byte-identical emission) | Compare generated UAST/specs against frozen pre-change snapshots of `py`/`js`/`php`/`clj`/`yang.call`; test verified-closure edge validation, missing transitive artifact/export refusal, provenance-door/effect-ceiling exclusions, and projected-name collision refusal. |\n649:| **P2 — Lowering parameterization (`yang.core.semantics` + frontend contracts)** | Implement generic `yang.core.semantics`; define `yang.python.antlr.contract` (then TS/PHP); refactor `yang.python.antlr.lower` to read literals/hooks/capabilities/projections from `:yang.semantics/descriptor` defaulting to `:yang.python/py-v1`. | **Zero** (byte-identical default output) | Byte-for-byte UAST equality test across the full corpus under `:yang.python/py-v1`; tests covering every supported lowering path and capability mode (`:cell`, `:single-assignment`, `:ambient-only`), unqualified-hook rejection, reserved-door projection ban, and explicit refusal of generator expressions when `:control/generators :refused`. |\n662:   - *Option B:* `yang.rt.*` for both Clojure namespaces and linker module names.\n","exit_code":0,"status":"completed"}}
