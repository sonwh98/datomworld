t                                      (u/lit :yang.call/named) named)))\n  1237\t        forged-refusal (u/app\n  1238\t                         (u/v 'clj/throw)\n  1239\t                         (u/lit {:yin.k/message\n  1240\t                                 \"Invocation is neither an authenticated packet nor an invocation record\"\n  1241\t                                 :yin.k/data {}}))\n  1242\t        ;; The record path: bind and run the body under clj/try, delivering\n  1243\t        ;; an authenticated condition or a fresh :yang.call/thrown condition.\n  1244\t        entry-body (u/app\n  1245\t                     (u/v 'clj/try)\n  1246\t                     (u/lam [] (u/if-node (u/app (u/v 'dsg__empty) named)\n  1247\t                                          (u/app (u/v body) positional)\n  1248\t                                          binding-error))\n  1249\t                     (u/lam ['dsg__e]\n  1250\t                            (u/let1 'dsg__provenance\n  1251\t                                    (u/app (u/v 'cell/dsg__provenance) (u/v 'dsg__e))\n  1252\t                                    (assoc (u/app raise\n  1253\t                                                  (u/if-node\n  1254\t                                                    (u/app (u/v 'dsg__equal) (u/v 'dsg__provenance) (u/lit nil))\n  1255\t                                                    (u/app (u/v 'yang.call/thrown) (u/v 'dsg__e))\n  1256\t                                                    (u/v 'dsg__provenance))) :tail? true))))\n  1257\t        ;; The private lane forwards the body's plain value in tail position\n  1258\t        ;; (a raise from it propagates to the caller's own handler — the lane\n  1280\t(defn- admit-call-descriptor\n  1281\t  \"Admit a descriptor constructed by trusted UAST/profile code. This is not\n  1282\t   a source form: entry-spelled source maps never pass through this constructor.\"\n  1283\t  [descriptor-ast tail?]\n  1284\t  (let [descriptor