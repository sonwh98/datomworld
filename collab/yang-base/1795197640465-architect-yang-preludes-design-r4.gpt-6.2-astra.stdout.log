              :park #{},\n  1770\t                :resume #{},\n  1771\t                :gensym #{},\n  1772\t                :store-get #{},\n  1773\t                :store-put #{},\n  1774\t                :current-continuation #{},\n  1775\t                ;; a definition writes the store, machine state, like\n  1776\t                ;; :store-put; its AST side is an :application\n  1777\t                :define #{},\n  1778\t                :const #{}, :var #{}, :closure #{}, :call #{},\n  1779\t                :return #{}, :jump #{}, :branch-false #{}, :halt #{}}}})\n  1780\t\n  1781\t\n  1782\t(def ^:private extraction-fns\n  1783\t  \"The `:fns` the §7.7 queries need (§6.3: quoted-symbol keys): the\n  1784\t   effect-raising tag/mnemonic sets are judged by `contains?`, and a\n  1785\t   definition's key operand is the `first` of its operands.\"\n  1786\t  {'contains? contains?,\n  1787\t   'first first,\n  1788\t   'reserved-name? reserved-name?})\n  1789\t\n  1790\t\n  1791\t(defn- extract\n  1792\t  \"One §7.7 extraction query over `db`, its single find column as a set.\"\n  1793\t  [q db]\n  1794\t  (set (map first (query/collect (query/q q db {:fns extraction-fns})))))\n  1795\t\n  1796\t\n  1797\t(def ^:private ast-extraction-queries\n  1798\t  \"§7.7 over `$ast`, the union of the flat rows of the reachable trees,\n  1799\t   verbatim from the design.\"\n  1800\t  ;; Rule R: a definition's key is always a literal, so it is a\n  1801\t  ;; store-slice requirement exactly as a :vm/store-put key is\n  1802\t  {:store-keys '[:find ?key :in $ast\n  1803\t                 :where (or-join [?key]\n  1804\t                                 [$ast _ :vm/store-get ?key]\n  1805\t                                 [$ast _ :vm/store-put ?key _]\n","exit_code":0,"status":"completed"}}
