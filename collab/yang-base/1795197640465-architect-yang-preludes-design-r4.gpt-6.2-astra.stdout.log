{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/clojure.cljc | sed -n '1218,1257p;1426,1462p'\"","aggregated_output":"  1218\t(defn- call-entry\n  1219\t  \"The unary public entry, closed over a private argument-vector body. It\n  1220\t   installs the exception bridge (`clj/try`) before argument binding, so an\n  1221\t   escaping raise forwards an authenticated condition or wraps an ordinary\n  1222\t   value as `:yang.call/thrown` exactly once after cleanup.\"\n  1223\t  []\n  1224\t  (let [body (symbol (str reserved-prefix \"body\"))\n  1225\t        invocation (symbol (str reserved-prefix \"invocation\"))\n  1226\t        positional (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/positional))\n  1227\t        named (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/named))\n  1228\t        raise (u/app (u/v 'dsg__get) (u/v invocation) (u/lit :yang.call/raise))\n  1229\t        binding-error (u/app\n  1230\t                        (u/v 'clj/throw)\n  1231\t                        (u/app (u/v 'dsg__assoc) (u/lit {})\n  1232\t                               (u/lit :yin.k/message)\n  1233\t                               (u/lit \"Clojure functions do not accept named arguments\")\n  1234\t                               (u/lit :yin.k/data)\n  1235\t                               (u/app (u/v 'dsg__assoc) (u/lit {})\n  1236\t                                      (u/lit :yang.call/named) named)))\n  1237\t        forged-refusal (u/app\n  1238\t                         (u/v 'clj/throw)\n  1239\t                         (u/lit {:yin.k/message\n  1240\t                                 \"Invocation is neither an authenticated packet nor an invocation record\"\n  1241\t                                 :yin.k/data {}}))\n  1242\t        ;; The record path: bind and run the body under clj/try, delivering\n  1243\t        ;; an authenticated condition or a fresh :yang.call/thrown condition.\n  1244\t        entry-body (u/app\n  1245\t                     (u/v 'clj/try)\n  1246\t                     (u/lam [] (u/if-node (u/app (u/v 'dsg__empty) named)\n  1247\t                                          (u/app (u/v body) positional)\n  1248\t                                          binding-error))\n  1249\t                     (u/lam ['dsg__e]\n  1250\t                            (u/let1 'dsg__provenance\n  1251\t                                    (u/app (u/v 'cell/dsg__provenance) (u/v 'dsg__e))\n  1252\t                                    (assoc (u/app raise\n  1253\t                                                  (u/if-node\n  1254\t                                                    (u/app (u/v 'dsg__equal) (u/v 'dsg__provenance) (u/lit nil))\n  1255\t                                                    (u/app (u/v 'yang.call/thrown) (u/v 'dsg__e))\n  1256\t                                                    (u/v 'dsg__provenance))) :tail? true))))\n  1257\t        ;; The private lane forwards the body's plain value in tail position\n  1426\t(defn- compile-guest-call\n  1427\t  \"Admit a source operator before common invocation. The raise exit delivers\n  1428\t   the callee's escaping condition into the clj continuation: a\n  1429\t   `:yang.call/thrown` condition delivers its payload (the caught value IS the\n  1430\t   payload), while a protocol condition is retained in a provenance carrier.\n  1431\t   Only generated UAST implementation calls apply private closures directly.\"\n  1432\t  [callee-ast arguments-ast env tail?]\n  1433\t  (if-not (outcomes? env)\n  1434\t    (cond-> (u/app callee-ast arguments-ast)\n  1435\t      tail? (assoc :tail? true))\n  1436\t    (let [callee (symbol (str reserved-prefix \"callee\"))\n  1437\t          arguments (symbol (str reserved-prefix \"arguments\"))\n  1438\t          condition (symbol (str reserved-prefix \"condition\"))\n  1439\t          raise-exit (u/lam [condition]\n  1440\t                            (assoc (u/app (u/v 'clj/raise)\n  1441\t                                          (u/if-node\n  1442\t                                            (u/app (u/v 'dsg__equal)\n  1443\t                                                   (u/app (u/v 'dsg__get) (u/v condition)\n  1444\t                                                          (u/lit :yang.call/reason))\n  1445\t                                                   (u/lit :yang.call/thrown))\n  1446\t                                            (u/app (u/v 'dsg__get) (u/v condition)\n  1447\t                                                   (u/lit :yang.call/value))\n  1448\t                                            (u/app (u/v 'cell/dsg__new-provenance)\n  1449\t                                                   (u/v condition) (u/v condition))))\n  1450\t                                   :tail? true))\n  1451\t          common-call (u/app (u/v 'yang.call/invoke) (u/v callee) (u/v arguments)\n  1452\t                             (u/lit []) raise-exit)\n  1453\t          refused (u/let1 condition\n  1454\t                          (u/app (u/v 'yang.call/condition)\n  1455\t                                 (u/lit :yang.call/not-callable)\n  1456\t                                 (u/app (u/v 'dsg__assoc) (u/lit {})\n  1457\t                                        (u/lit :yang.call/callee) (u/v callee)))\n  1458\t                          (assoc (u/app (u/v 'clj/raise)\n  1459\t                                        (u/app (u/v 'cell/dsg__new-provenance)\n  1460\t                                               (u/v condition) (u/v condition))) :tail? true))\n  1461\t          admitted (u/if-node (u/app (u/v 'dsg__admitted?) (u/v callee))\n  1462\t                              common-call refused)\n","exit_code":0,"status":"completed"}}
