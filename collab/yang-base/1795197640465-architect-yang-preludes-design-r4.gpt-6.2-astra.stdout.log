                      :yin.semantic/code vm/semantic-contract\n   364\t                       :yin.debruijn.code vm/stack-contract\n   365\t                       :yin.debruijn.register vm/register-contract}\n   366\t                      :yin.module/tree tree-address\n   367\t                      :yin.module/derivations\n   368\t                      {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\n   369\t                       :yin.debruijn.code\n   370\t                       (mint sem h linker/stack-lowering-profile)\n   371\t                       :yin.debruijn.register\n   372\t                       (mint sem r linker/register-lowering-profile)}\n   373\t                      :yin.module/index {:yin.debruijn.code h-address\n   374\t                                         :yin.debruijn.register r-address}\n   375\t                      :yin.module/exports (set exports)\n   376\t                      :yin.module/requires (or requires {})\n   377\t                      :yin.module/primitives\n   378\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   379\t                                    primitives))\n   380\t                      :yin.module/footprint fp}\n   381\t            address (jing/materialize! handle manifest)\n   382\t            ;; the C1 side table and its publication record, beside\n","exit_code":0,"status":"completed"}}
