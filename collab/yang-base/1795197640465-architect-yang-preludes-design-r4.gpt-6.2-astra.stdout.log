{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yang/core/prelude.cljc | sed -n '18,160p'\"","aggregated_output":"    18\t(defn strip\n    19\t  \"`sym` without the module's own namespace `ns-str`; any other value as it\n    20\t   is. Qualified internal store keys stay qualified.\"\n    21\t  [ns-str sym]\n    22\t  (if (and (symbol? sym) (= ns-str (namespace sym)))\n    23\t    (symbol (name sym))\n    24\t    sym))\n    25\t\n    26\t\n    27\t(defn- strip-form\n    28\t  \"A prelude-notation form with every symbol `strip`ped: references,\n    29\t   definition keys and quoted keys alike. Keywords, strings and the\n    30\t   keys of literal maps are untouched.\"\n    31\t  [ns-str form]\n    32\t  (walk/postwalk (partial strip ns-str) form))\n    33\t\n    34\t\n    35\t(defn- placeholder\n    36\t  \"The `[k uninit]` definition for runtime key `k`, so each read of it is\n    37\t   discharged by an unconditional module-level definition.\"\n    38\t  [k uninit]\n    39\t  [k uninit])\n    40\t\n    41\t\n    42\t(defn module-definitions\n    43\t  \"The module's definition list: a `uninit` placeholder for every runtime\n    44\t   key (stripped of `ns-str`), then every definition, stripped.\"\n    45\t  [ns-str uninit runtime-keys definitions]\n    46\t  (into (mapv (fn [k] (placeholder (strip ns-str k) uninit)) runtime-keys)\n    47\t        (map (fn [[k form]] [(strip ns-str k) (strip-form ns-str form)]))\n    48\t        definitions))\n    49\t\n    50\t\n    51\t(defn wide-app\n    52\t  \"One application whose operands are `nodes` (in order), applied to a lambda\n    53\t   with one parameter per node that returns nil. Every operand runs on the main sequence before the one call, so the\n    54\t   linker's scanners discharge every body read of a sibling or runtime key;\n    55\t   a `then` chain would nest definitions in closure bodies.\"\n    56\t  [nodes]\n    57\t  (let [params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count nodes)))]\n    58\t    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) nodes))))\n    59\t\n    60\t\n    61\t(defn module-tree\n    62\t  \"The module tree for `defs` (`[key form]`, already stripped) followed by\n    63\t   the `trailing` UAST nodes.\"\n    64\t  [defs trailing]\n    65\t  (wide-app (into (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)\n    66\t                  trailing)))\n    67\t\n    68\t\n    69\t(defn exports\n    70\t  \"The module's exports: every key of `definitions` in namespace `ns-str`,\n    71\t   stripped.\"\n    72\t  [ns-str definitions]\n    73\t  (set (keep (fn [[k _]] (when (= ns-str (namespace k)) (strip ns-str k)))\n    74\t             definitions)))\n    75\t\n    76\t\n    77\t(defn free-names\n    78\t  \"Every variable name some occurrence of the map AST `ast` reads\n    79\t   unbound by an enclosing lambda.\"\n    80\t  [ast]\n    81\t  (letfn [(walk-node\n    82\t            [acc node bound]\n    83\t            (cond\n    84\t              (vector? node) (reduce (fn [a n] (walk-node a n bound)) acc node)\n    85\t              (not (map? node)) acc\n    86\t              :else\n    87\t              (case (:type node)\n    88\t                :variable (if (contains? bound (:name node))\n    89\t                            acc\n    90\t                            (conj acc (:name node)))\n    91\t                :literal acc\n    92\t                :lambda (walk-node acc (:body node) (into bound (:params node)))\n    93\t                (reduce (fn [a v] (walk-node a v bound)) acc (vals node)))))]\n    94\t    (walk-node #{} ast #{})))\n    95\t\n    96\t\n    97\t(defn defined-keys\n    98\t  \"Every literal key the map AST `ast` defines with `yin/def`, at any\n    99\t   depth.\"\n   100\t  [ast]\n   101\t  (set (keep (fn [node]\n   102\t               (when (and (map? node)\n   103\t                          (= :application (:type node))\n   104\t                          (= 'yin/def (get-in node [:operator :name])))\n   105\t                 (get-in node [:operands 0 :value])))\n   106\t             (tree-seq coll? seq ast))))\n   107\t\n   108\t\n   109\t(defn free-name-vec\n   110\t  \"The names `ast` reads and does not define, sorted.\"\n   111\t  [ast]\n   112\t  (vec (sort-by str\n   113\t                (remove (conj (defined-keys ast) 'yin/def) (free-names ast)))))\n   114\t\n   115\t\n   116\t(defn balanced-definitions->uast\n   117\t  \"Balanced definition-to-UAST emission: each [key form] pair maps to\n   118\t   u/def! and the vector splits at its midpoint, halving sequential depth\n   119\t   versus the linear u/seq-nodes chain. The tree shape is content-addressed:\n   120\t   empty input answers nil, and callers choose balanced versus linear\n   121\t   deliberately - never migrate between the two for style.\"\n   122\t  [defs]\n   123\t  (letfn [(sequence-tree [nodes]\n   124\t            (if (<= (count nodes) 1)\n   125\t              (first nodes)\n   126\t              (let [middle (quot (count nodes) 2)]\n   127\t                (u/then (sequence-tree (subvec nodes 0 middle))\n   128\t                        (sequence-tree (subvec nodes middle))))))]\n   129\t    (sequence-tree (mapv (fn [[k form]] (u/def! k (u/sexp->uast form))) defs))))\n   130\t\n   131\t\n   132\t(defn definitions->uast\n   133\t  [defs]\n   134\t  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n","exit_code":0,"status":"completed"}}
