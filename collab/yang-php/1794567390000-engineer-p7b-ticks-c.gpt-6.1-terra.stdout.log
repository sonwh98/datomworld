{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3500,3640p' src/cljc/yang/php/antlr/lower.cljc; cat src/cljc/yang/php/antlr/safepoint.cljc; cat src/cljc/yang/php/antlr/publication.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3500,3640p' src/cljc/yang/php/antlr/lower.cljc; cat src/cljc/yang/php/antlr/safepoint.cljc; cat src/cljc/yang/php/antlr/publication.cljc\"","aggregated_output":"  \"`[name spec-node]` of the `classDeclaration` or `enumDeclaration` `n`.\"\n  [ctx n]\n  (if (p/rule? n \"enumDeclaration\") (enum-spec ctx n) (class-spec* ctx n)))\n\n\n(defn- class-spec*\n  [ctx0 n]\n  (let [ks (core/kids ctx0 n)\n        cname (ns-prefixed ctx0 (leftmost-token-text ctx0 (first (core/rules ctx0 n \"identifier\"))))\n        ctx (assoc ctx0 :cname cname)\n        interface? (boolean (some #(and (p/token? %) (= \"Interface\" (:type %))) ks))\n        entry-type (some-> (first (core/rules ctx n \"classEntryType\")) (->> (leftmost-token-text ctx))\n                           str/lower-case)\n        kind (cond interface? :interface (= \"trait\" entry-type) :trait :else :class)\n        ctx (assoc ctx :ckind kind)\n        mods (set (keep #(when (p/rule? % \"modifier\") (keyword (str/lower-case (leftmost-token-text ctx %))))\n                        ks))\n        parent (when-not interface?\n                 (some->> (drop-while #(not (and (p/token? %) (= \"Extends\" (:type %)))) ks)\n                          second\n                          (class-text ctx)))\n        interfaces (cond\n                     interface? (type-names ctx (first (core/rules ctx n \"interfaceList\")))\n                     :else (type-names ctx (first (core/rules ctx n \"interfaceList\"))))\n        statements (core/rules ctx n \"classStatement\")\n        _ (doseq [st statements]\n            (when (seq (core/rules ctx st \"attributes\")) (unsupported! st :attribute)))\n        tok (fn [st] (some #(when (p/token? %) (:type %)) (core/kids ctx st)))\n        consts (mapcat #(const-entries ctx cname %) (filter #(= \"Const\" (tok %)) statements))\n        props (mapcat (fn [st]\n                        (cond\n                          (seq (core/rules ctx st \"propertyModifiers\")) (property-entries ctx cname st)\n                          (and (= \"Function_\" (tok st))\n                               (= \"__construct\" (str/lower-case (function-written ctx st))))\n                          (promoted-entries ctx st)\n                          :else []))\n                      statements)\n        methods (mapv #(method-entry ctx % %) (filter #(= \"Function_\" (tok %)) statements))\n        uses (filter #(= \"Use\" (tok %)) statements)\n        [traits rules] (trait-rules ctx uses)]\n    [cname\n     (spec-node (cond-> {:name (u/lit cname),\n                         :kind (u/lit kind),\n                         :abstract? (u/lit (boolean (:abstract mods))),\n                         :final? (u/lit (boolean (:final mods))),\n                         :interfaces (args-vector (map u/lit interfaces)),\n                         :traits (args-vector (map u/lit traits)),\n                         :trait-rules rules,\n                         :consts (args-vector consts),\n                         :props (args-vector props),\n                         :methods (args-vector methods)}\n                  parent (assoc :parent (u/lit parent))))]))\n\n\n(defn- lower-declare\n  \"`declare(strict_types=1)` switches the unit to strict scalar typing; `ticks`\n   and `encoding` are accepted and inert. A body statement runs after.\"\n  [ctx n]\n  (let [ds (mapcat #(core/rules ctx % \"directive\") (core/rules ctx n \"declareList\"))\n        strict (some (fn [d]\n                       (when (some #(and (p/token? %) (= \"StrictTypes\" (:type %))) (core/kids ctx d))\n                         (= \"1\" (leftmost-token-text ctx (first (core/rules ctx d \"numericConstant\"))))))\n                     ds)\n        body (first (core/rules ctx n \"statement\"))]\n    (u/then (if (some? strict) (app* 'php/set-strict! (u/lit (boolean strict))) (u/lit :php/null))\n            (if body (lower ctx body) (u/lit :php/null)))))\n\n\n(defn- lower-class\n  \"A class declared in place (nested or conditional): declared when reached.\"\n  [ctx n]\n  (let [[_ spec] (class-spec ctx n)]\n    (u/then (app* 'php/declare-class! spec) (u/lit :php/null))))\n\n\n(defn- lower\n  \"The node of CST rule node `n`.\"\n  [ctx n]\n  (case (:rule n)\n    \"inlineHtml\" (html-node ctx n)\n    \"phpBlock\" (sequence-node (block-nodes ctx n))\n    (\"topStatement\" \"innerStatement\" \"statement\" \"namespaceStatement\")\n    (lower ctx (first (core/rule-kids ctx n)))\n    \"globalConstantDeclaration\" (lower-const ctx n)\n    \"echoStatement\" (with-temps ctx n\n                      (sequence-node (echo-nodes ctx (first (core/rules ctx n \"expressionList\")))))\n    \"expressionStatement\" (with-temps ctx n (lower ctx (first (core/rules ctx n \"expression\"))))\n    \"emptyStatement_\" (u/lit :php/null)\n    \"inlineHtmlStatement\" (sequence-node (block-nodes ctx n))\n    \"blockStatement\" (lower ctx (first (core/rules ctx n \"innerStatementList\")))\n    \"innerStatementList\" (sequence-node (block-nodes ctx n))\n    \"expression\" (lower-expression ctx n)\n    \"yieldExpression\" (lower-yield ctx n)\n    \"parentheses\" (lower ctx (first (core/rule-kids ctx n)))\n    \"ifStatement\" (lower-if ctx n)\n    \"whileStatement\" (lower-while ctx n)\n    \"doWhileStatement\" (lower-do-while ctx n)\n    \"forStatement\" (lower-for ctx n)\n    \"foreachStatement\" (lower-foreach ctx n)\n    \"switchStatement\" (lower-switch ctx n)\n    \"breakStatement\" (lower-escape ctx n :break)\n    \"continueStatement\" (lower-escape ctx n :continue)\n    \"returnStatement\" (lower-return ctx n)\n    \"tryCatchFinally\" (lower-try ctx n)\n    \"throwStatement\" (app* 'php/throw-value (lower ctx (first (core/rules ctx n \"expression\"))))\n    \"staticVariableStatement\" (lower-static ctx n)\n    \"globalStatement\" (lower-global ctx n)\n    \"unsetStatement\" (lower-unset ctx n (core/rules ctx (first (core/rules ctx n \"chainList\")) \"chain\"))\n    \"functionDeclaration\" (lower-function ctx n)\n    \"constant\" (lower-constant ctx n)\n    \"arrayCreation\" (lower-array ctx n)\n    (\"classDeclaration\" \"enumDeclaration\") (lower-class ctx n)\n    \"declareStatement\" (lower-declare ctx n)\n    (core/default-arm diagnostic-ns \"PHP\" unsupported-rules n)))\n\n\n;; =============================================================================\n;; Packets\n;; =============================================================================\n\n(defn- hoisted?\n  \"True for a top-level statement that is an unconditional function\n   declaration: PHP declares it before the unit's first statement runs.\"\n  [ctx item]\n  (p/rule? (rule-head ctx item) \"functionDeclaration\"))\n\n\n(defn- declared-functions\n  \"Every function the unit declares: lower-cased fully qualified name to the\n   vector of its by-reference parameter positions.\"\n  [ctx]\n  (letfn [(refs\n            [n]\n            (let [fps (core/rules ctx (first (core/rules ctx n \"formalParameterList\"))\n                                  \"formalParameter\")]\n              (vec (keep-indexed (fn [i fp] (when (some #(p/token? % \"&\") (core/kids ctx fp)) i))\n                                 fps))))\n          (walk\n            [ictx n]\n            (into (if (p/rule? n \"functionDeclaration\")\n                    {(str/lower-case (ns-prefixed ictx (function-written ctx n))) (refs n)}\n(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\n(ns yang.php.antlr.publication\n  \"P6 (docs/design/yang.php.md section 11): a set of compiled PHP units\n   published as linker modules. The ordering, SCC bundling and publish loop\n   are `yang.core.publication`'s; this namespace supplies the PHP hooks: the\n   includes `lower/imported-unit-names` folds, the `lower/module-spec` and\n   `lower/scc-module-specs` emitters, no site set and no binder table (the\n   PHP hook profile is P7).\n\n   A unit is `{:name path :packet p :strict-types b}`, `path` its normalized\n   relative path; the optional class map entry is `{:name \\\"$classmap\\\"\n   :classes {class path} :paths [path ...]}`. Name assertions stay the\n   linker's: this namespace publishes content, it signs nothing.\"\n  (:require\n    [yang.core.publication :as core]\n    [yang.php.antlr.lower :as lower]\n    [yin.vm.linker.publish :as publish]))\n\n\n(defn- class-map?\n  \"The autoload class map entry of a unit set, `{:name \\\"$classmap\\\" :classes\n   {class path} :paths [path ...]}`: it imports every path it lists, so it\n   publishes last and an unpublished path is refused by name (plan P6 R9).\"\n  [unit]\n  (= lower/classmap-name (:name unit)))\n\n\n(defn- config\n  [publish-fn]\n  {:imported-names (fn [{:keys [name packet], :as unit}]\n                     (if (class-map? unit)\n                       (lower/classmap-paths unit)\n                       (lower/imported-unit-names packet {:path name}))),\n   :module-spec (fn [registry {:keys [name packet strict-types], :as unit} php-address deps]\n                  (if (class-map? unit)\n                    (lower/classmap-spec registry unit php-address deps)\n                    (lower/module-spec registry packet\n                                       {:path name,\n                                        :strict-types strict-types,\n                                        :php-address php-address,\n                                        :deps deps}))),\n   :scc-module-specs lower/scc-module-specs,\n   :site-set nil,\n   :binder-table nil,\n   :refusal-ns \"yang.php\",\n   :publish-fn publish-fn})\n\n\n(defn publication-order\n  \"Dependency-first names, retaining the input order for acyclic units.\n   Cyclic components appear as sorted member vectors in :order, one\n   publication step per SCC. An include edge no unit and no `published`\n   entry supplies is refused `:yang.php/unpublished-import` by name.\"\n  [units published]\n  (core/publication-order (config publish/publish-module!) units published))\n\n\n(defn publish-units!\n  \"Publish `units` into the content store `handle` over the host registry\n   `registry`, `php` pinned at `php-address` and each include outside the\n   set at its address in `published` ({path address}), in\n   `publication-order`. Answers `{:status :ok :addresses {path address}\n   :bundles {bundle-symbol address}}`, or the first refusal:\n   `publication-order`'s before anything is written, else\n   `publish-module!`'s with a string `:unit`.\"\n  ([handle registry php-address units]\n   (publish-units! handle registry php-address units {}))\n  ([handle registry php-address units published]\n   (publish-units! handle registry php-address units published publish/publish-module!))\n  ([handle registry php-address units published publish-fn]\n   (core/publish-units! (config publish-fn) handle registry php-address units published)))\n","exit_code":0,"status":"completed"}}
