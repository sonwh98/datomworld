{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/php/antlr/ticks_test.clj test/yang/php/antlr/programs_p7b.cljc'","aggregated_output":"(ns yang.php.antlr.ticks-test\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.linked-harness :as lh]\n    [yang.php.antlr.programs-p7b :as p7b]))\n\n\n(deftest tick-fixtures-test\n  (doseq [{:keys [id source out units]} p7b/fixtures\n          :when (nil? units)]\n    (testing (name id)\n      (is (= out (:php/out (h/run-raw (str \"<?php \" p7b/prologue source))))))))\n\n\n(deftest include-handoff-test\n  (let [{:keys [source units out]} (last p7b/fixtures)\n        packets (update-vals (assoc units \"main.php\" (str \"<?php \" p7b/prologue source))\n                             cst/parse-source)\n        result (lh/run-fixture packets \"main.php\" {})]\n    (doseq [[vm value] (:values result)]\n      (is (= out (h/latin1->text (:php/out value))) (name vm)))))\n(ns yang.php.antlr.programs-p7b\n  \"Hand-derived tick expectations pending the pinned PHP oracle pass.\")\n\n\n(def prologue\n  \"function tick_handler() { echo 'T'; } register_tick_function('tick_handler'); \")\n\n\n(def fixtures\n  [{:id :sequence, :source \"declare(ticks=1) { echo 'A'; $x = 1; echo 'B'; }\",\n    :out \"ATTBT\", :oracle :pending}\n   {:id :loop-body, :source \"for ($i=0; $i<2; $i++) { declare(ticks=1) { echo 'A'; } }\",\n    :out \"ATAT\", :oracle :pending}\n   {:id :function-call, :source \"function f() { echo 'F'; } declare(ticks=1) { f(); }\",\n    :out \"FT\", :oracle :pending}\n   {:id :generator-resume,\n    :source \"function g() { declare(ticks=1) { yield 1; echo 'B'; } } $g=g(); $g->current(); echo 'A'; $g->next();\",\n    :out \"ATBT\", :oracle :pending}\n   {:id :include-handoff, :source \"include 'lib.php';\",\n    :units {\"lib.php\" \"<?php declare(ticks=1) { echo 'L'; }\"},\n    :out \"LT\", :oracle :pending}])\n","exit_code":0,"status":"completed"}}
