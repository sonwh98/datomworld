st.clj:59:(deftest foreach-targets-are-assigned-test\ntest/yang/php/antlr/scope_test.clj:61:         (get-in (analysis \"<?php foreach ($s as $k => $v) { echo $k; }\") [:unit :assigned])))\ntest/yang/php/antlr/scope_test.clj:63:         (get-in (analysis \"<?php foreach ($s as $o['x'] => $p[0]) {}\") [:unit :assigned])))\ntest/yang/php/antlr/scope_test.clj:65:         (:assigned (function-scope \"<?php function f($s) { foreach ($s as $v) {} }\")))))\ntest/yang/php/antlr/scope_test.clj:70:    (is (= [\"$a\" \"$b\"] (get-in a [:unit :assigned])))))\ntest/yang/php/antlr/scope_test.clj:81:    (is (some #{\"$y\"} (:assigned outer)))))\ntest/yang/php/antlr/programs_p5.cljc:2:  \"P5 request-context fixtures. Expectations are hand-derived from PHP 8.3;\ntest/yang/php/antlr/linked_harness.cljc:7:   `yin.vm.linker.interpreter` composition under `:trusted` derivation.\ntest/yang/php/antlr/linked_harness.cljc:26:    [yin.vm.semantic.derive :as derive]\ntest/yang/php/antlr/linked_harness.cljc:61:   and each published module, derivation `:trusted`, the test being the\ntest/yang/php/antlr/linked_harness.cljc:67:                     :derivation :trusted}))\ntest/yang/php/antlr/linked_harness.cljc:77:            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\ntest/yang/php/antlr/linked_harness.cljc:80:               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\ntest/yang/php/antlr/programs.cljc:657:    :criterion \"an array element assignment yields the assigned value\",\ntest/yang/php/antlr/programs_p4.cljc:628:   (fx :decl-signed-literal-defaults-accepted :closures-v1 [] #{:p4-s6}\ntest/yang/php/antlr/programs_p3b.cljc:345:   :foreach-ref-array-reassigned-in-loop {:out \"177777\", :diag [], :uncaught nil}})\ntest/yang/php/antlr/programs_p3b.cljc:480:   {:id :foreach-ref-array-reassigned-in-loop,\ntest/yang/php/antlr/phpt_selection.edn:56:   \"Bug #22725 (A derived class can call a parent's protected method that calls a private method)\",\ntest/yang/php/antlr/phpt_selection.edn:312:   \"Bug #29674 (inherited method doesn't have access to private variables of the derived class)\",\ntest/yang/php/antlr/phpt_selection.edn:517:   \"Notice: Only variables should be assigned by reference in %sbug31525.php on line 7\\nobject(Foo)#1 (0) {\\n}\",\ntest/yang/php/antlr/phpt_selection.edn:578:   \"Try static instance inside class :\\nNew class Singleton1 created \\nUsing old class Singleton1\\n\\nNotice: Only variables should be assigned by reference in %sbug32322.php on line 49\\nUsing old class Singleton1\\nTry static instance inside function :\\nNew class Singleton2 created \\nUsing old class Singleton2\\n\\nNotice: Only variables should be assigned by reference in %sbug32322.php on line 55\\nUsing old class Singleton2\\nClass Singleton1 destroyed at script end\\nClass Singleton2 destroyed at script end\",\ntest/yang/php/antlr/phpt_selection.edn:1577:   :title \"Bug #43851 (Memory corrution on reuse of assigned value)\",\ntest/yang/php/antlr/phpt_selection.edn:6899:   \"Readonly property cannot be op-assigned twice during cloning\",\ntest/yang/php/antlr/phpt_selection.edn:6916:   \"Test that readonly properties cannot be reassigned by invoking the __clone() method directly\",\ntest/yang/php/antlr/phpt_selection.edn:7178:   \"Live range of ZEND_NEW must be assigned to correct variable\",\ntest/yang/php/antlr/phpt_selection.edn:8152:   \"<?php\\n\\n// This test checks for:\\n// - inherited constructors/destructors are not called automatically\\n// - base classes know about derived properties in constructor/destructor\\n// - base class constructors/destructors know the instantiated class name\\n\\nclass base {\\n    public $name;\\n\\n    function __construct() {\\n        echo __CLASS__ . \\\"::\\\" . __FUNCTION__ . \\\"\\\\n\\\";\\n        $this->name = 'base';\\n        print_r($this);\\n    }\\n\\n    function __destruct() {\\n        echo __CLASS__ . \\\"::\\\" . __FUNCTION__ . \\\"\\\\n\\\";\\n        print_r($this);\\n    }\\n}\\n\\nclass derived extends base {\\n    public $other;\\n\\n    function __construct() {\\n        $this->name = 'init';\\n        $this->other = 'other';\\n        print_r($this);\\n        parent::__construct();\\n        echo __CLASS__ . \\\"::\\\" . __FUNCTION__ . \\\"\\\\n\\\";\\n        $this->name = 'derived';\\n        print_r($this);\\n    }\\n\\n    function __destruct() {\\n        parent::__destruct();\\n        echo __CLASS__ . \\\"::\\\" . __FUNCTION__ . \\\"\\\\n\\\";\\n        print_r($this);\\n    }\\n}\\n\\necho \\\"Testing class base\\\\n\\\";\\n$t = new base();\\nunset($t);\\necho \\\"Testing class derived\\\\n\\\";\\n$t = new derived();\\nunset($t);\\n\\necho \\\"Done\\\\n\\\";\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8154:   \"ZE2 A derived class can use the inherited constructor/destructor\",\ntest/yang/php/antlr/phpt_selection.edn:8156:   \"Testing class base\\nbase::__construct\\nbase Object\\n(\\n    [name] => base\\n)\\nbase::__destruct\\nbase Object\\n(\\n    [name] => base\\n)\\nTesting class derived\\nderived Object\\n(\\n    [name] => init\\n    [other] => other\\n)\\nbase::__construct\\nderived Object\\n(\\n    [name] => base\\n    [other] => other\\n)\\nderived::__construct\\nderived Object\\n(\\n    [name] => derived\\n    [other] => other\\n)\\nbase::__destruct\\nderived Object\\n(\\n    [name] => derived\\n    [other] => other\\n)\\nderived::__destruct\\nderived Object\\n(\\n    [name] => derived\\n    [other] => other\\n)\\nDone\",\ntest/yang/php/antlr/phpt_selection.edn:8186:   \"<?php\\ninterface constr\\n{\\n    function __construct();\\n}\\n\\nabstract class implem implements constr\\n{\\n}\\n\\nclass derived extends implem\\n{\\n    function __construct($a)\\n    {\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8190:   \"Fatal error: Declaration of derived::__construct($a) must be compatible with constr::__construct() in %s on line %d\",\ntest/yang/php/antlr/phpt_selection.edn:8195:   \"<?php\\ninterface constr\\n{\\n    function __construct();\\n}\\n\\nclass implem implements constr\\n{\\n    function __construct()\\n    {\\n    }\\n}\\n\\nclass derived extends implem\\n{\\n    function __construct($a)\\n    {\\n    }\\n}\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8199:   \"Fatal error: Declaration of derived::__construct($a) must be compatible with constr::__construct() in %s on line %d\",\ntest/yang/php/antlr/phpt_selection.edn:8242:   \"<?php\\nclass base {\\n   function __construct() {\\n      echo __METHOD__ . \\\"\\\\n\\\";\\n   }\\n\\n   function __destruct() {\\n      echo __METHOD__ . \\\"\\\\n\\\";\\n   }\\n}\\n\\nclass derived extends base {\\n}\\n\\n$obj = new derived;\\n\\nunset($obj);\\n\\necho 'Done';\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8272:   \"<?php\\n\\nfunction f() {\\n    echo \\\"in f()\\\\n\\\";\\n    return \\\"name\\\";\\n}\\n\\nfunction g() {\\n    echo \\\"in g()\\\\n\\\";\\n    return \\\"assigned value\\\";\\n}\\n\\n\\necho \\\"\\\\n\\\\nOrder with local assignment:\\\\n\\\";\\n${f()} = g();\\nvar_dump($name);\\n\\necho \\\"\\\\n\\\\nOrder with array assignment:\\\\n\\\";\\n$a[f()] = g();\\nvar_dump($a);\\n\\necho \\\"\\\\n\\\\nOrder with object property assignment:\\\\n\\\";\\n$oa = new stdClass;\\n$oa->${f()} = g();\\nvar_dump($oa);\\n\\necho \\\"\\\\n\\\\nOrder with nested object property assignment:\\\\n\\\";\\n$ob = new stdClass;\\n$ob->o1 = new stdClass;\\n$ob->o1->o2 = new stdClass;\\n$ob->o1->o2->${f()} = g();\\nvar_dump($ob);\\n\\necho \\\"\\\\n\\\\nOrder with dim_list property assignment:\\\\n\\\";\\n$oc = new stdClass;\\n$oc->a[${f()}] = g();\\nvar_dump($oc);\\n\\n\\nclass C {\\n    public static $name = \\\"original\\\";\\n    public static $a = array();\\n    public static $string = \\\"hello\\\";\\n}\\necho \\\"\\\\n\\\\nOrder with static property assignment:\\\\n\\\";\\nC::${f()} = g();\\nvar_dump(C::$name);\\n\\necho \\\"\\\\n\\\\nOrder with static array property assignment:\\\\n\\\";\\nC::$a[f()] = g();\\nvar_dump(C::$a);\\n\\necho \\\"\\\\n\\\\nOrder with indexed string assignment:\\\\n\\\";\\n$string = \\\"hello\\\";\\nfunction getOffset() {\\n    echo \\\"in getOffset()\\\\n\\\";\\n    return 0;\\n}\\nfunction newChar() {\\n    echo \\\"in newChar()\\\\n\\\";\\n    return 'j';\\n}\\n$string[getOffset()] = newChar();\\nvar_dump($string);\\n\\necho \\\"\\\\n\\\\nOrder with static string property assignment:\\\\n\\\";\\nC::$string[getOffset()] = newChar();\\nvar_dump(C::$string);\\n\\n?>\",\ntest/yang/php/antlr/phpt_selection.edn:8275:   \"Order with local assignment:\\nin f()\\nin g()\\nstring(14) \\\"assigned value\\\"\\n\\n\\nOrder with array assignment:\\nin f()\\nin g()\\narray(1) {\\n  [\\\"name\\\"]=>\\n  string(14) \\\"assigned value\\\"\\n}\\n\\n\\nOrder with object property assignment:\\nin f()\\nin g()\\nobject(stdClass)#%d (1) {\\n  [\\\"assigned value\\\"]=>\\n  string(14) \\\"assigned value\\\"\\n}\\n\\n\\nOrder with nested object property assignment:\\nin f()\\nin g()\\nobject(stdClass)#%d (1) {\\n  [\\\"o1\\\"]=>\\n  object(stdClass)#%d (1) {\\n    [\\\"o2\\\"]=>\\n    object(stdClass)#%d (1) {\\n      [\\\"assigned value\\\"]=>\\n      string(14) \\\"assigned value\\\"\\n    }\\n  }\\n}\\n\\n\\nOrder with dim_list property assignment:\\nin f()\\nin g()\\nobject(stdClass)#%d (1) {\\n  [\\\"a\\\"]=>\\n  array(1) {\\n    [\\\"assigned value\\\"]=>\\n    string(14) \\\"assigned value\\\"\\n  }\\n}\\n\\n\\nOrder with static property assignment:\\nin f()\\nin g()\\nstring(14) \\\"assigned value\\\"\\n\\n\\nOrder with static array property assignment:\\nin f()\\nin g()\\narray(1) {\\n  [\\\"name\\\"]=>\\n  string(14) \\\"assigned value\\\"\\n}\\n\\n\\nOrder with indexed string assignment:\\nin getOffset()\\nin newChar()\\nstring(5) \\\"jello\\\"\\n\\n\\nOrder with static string property assignment:\\nin getOffset()\\nin newChar()\\nstring(5) \\\"jello\\\"\",\n","exit_code":0,"status":"completed"}}
