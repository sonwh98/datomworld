{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='src/cljc/yang/php/antlr/siteset.cljc'\ns=open(p).read().replace('[yin.vm.encoder :as encoder]))','[yin.vm.encoder :as encoder]\\\\n    [yin.vm.linker.sign :as sign]))')\ns += '''\n\n(defn signed-entry\n  \\\"Sign the association between a published manifest and its site record.\\\"\n  [key manifest record-address]\n  (let [env {:yang.site/op :publish,\n             :yang.site/manifest manifest,\n             :yang.site/record record-address,\n             :yin.module/asserted-by (sign/principal (:public key))}]\n    {:envelope env, :proof (sign/sign-envelope (:seed key) env)}))\n\n\n(defn entry-datoms\n  \\\"Index signed site publications alongside name assertions.\\\"\n  [signed]\n  (vec (mapcat (fn [e {:keys [envelope proof]}]\n                 [[e :yang.site/envelope envelope]\n                  [e :yang.site/proof proof]])\n               (range) signed)))\n\n\n(defn discover\n  \\\"Find site record addresses signed by a declared public key for manifest.\\\"\n  [datoms publics manifest]\n  (let [proofs (reduce (fn [acc [e a v]]\n                         (cond-> acc\n                           (= a :yang.site/proof) (update e (fnil conj #{}) v)))\n                       {} datoms)]\n    (vec (distinct\n           (keep (fn [[e a env]]\n                   (when (and (= a :yang.site/envelope) (map? env)\n                              (= :publish (:yang.site/op env))\n                              (= manifest (:yang.site/manifest env)))\n                     (let [ps (get proofs e)\n                           sig (when (= 1 (count ps))\n                                 (:yin.module/signature (first ps)))]\n                       (when (and (string? sig)\n                                  (some #(and (= (:yin.module/asserted-by env)\n                                                 (sign/principal %))\n                                              (sign/verify-envelope\n                                                % (jing/canonical-bytes env) sig))\n                                        publics))\n                         (:yang.site/record env)))))\n                 datoms)))))\n\n\n(defn signed-entries\n  \\\"Sign all site publications returned by unit publication, including aliases.\\\"\n  [publisher sites addresses bundles]\n  (mapv (fn [[k s]]\n          (signed-entry publisher (or (get addresses k) (get bundles k))\n                        (:record-address s)))\n        (sort-by (comp str key) sites)))\n'''\nopen(p,'w').write(s)\np='test/yang/php/antlr/siteset_test.clj';s=open(p).read().replace('[yang.php.antlr.siteset :as siteset]))','[yang.php.antlr.siteset :as siteset]\\\\n    [yin.vm.linker.sign :as sign]))');s+='''\n\n(deftest signed-discovery-requires-an-authorized-untampered-entry\n  (let [key (sign/generate)\n        other (sign/generate)\n        entry (siteset/signed-entry key :manifest :record)\n        datoms (siteset/entry-datoms [entry])\n        tampered (siteset/entry-datoms [(assoc-in entry [:envelope :yang.site/record] :other)])]\n    (is (= [:record] (siteset/discover datoms [(:public key)] :manifest)))\n    (is (empty? (siteset/discover datoms [(:public other)] :manifest)))\n    (is (empty? (siteset/discover datoms [(:public key)] :other)))\n    (is (empty? (siteset/discover tampered [(:public key)] :manifest)))))\n''';open(p,'w').write(s)\nPY\nclojure -M:test -n yang.php.antlr.siteset-test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
