{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/eval_coordinator.cljc src/cljc/yang/php/antlr/eval_publication.cljc test/yang/php/antlr/e2e_harness.clj test/yang/php/antlr/eval_service_test.clj'","aggregated_output":"(ns yang.php.antlr.eval-coordinator\n  \"Composition-supplied eval frontend and stream service.\"\n  (:require [dao.jing :as jing]\n            [dao.stream :as stream]\n            [yang.antlr.packet :as packet]\n            [yang.php.antlr.cst :as cst]\n            [yang.php.antlr.eval-admission :as admission]\n            [yang.php.antlr.eval-publication :as publication]\n            [yang.php.antlr.eval-transport :as transport]\n            [yang.php.antlr.scope :as scope]\n            [yang.php.antlr.siteset :as siteset]))\n\n\n(defn make-worker\n  []\n  (cst/make-eval-worker))\n\n\n(defn compile-request\n  \"Prepare one request for later eval-unit emission. Identity includes the\n   complete request (including bytes and caller-supplied revisions/options),\n   the source goal, grammar and admission profile. No caller runtime state is\n   needed by this service.\"\n  [worker request]\n  (let [{:keys [source] :as admitted} (admission/admit-request request)]\n    (if-not source\n      admitted\n      (let [pk (cst/parse-source worker (:yang.compile/unit request) source)\n            identity {:request request\n                      :yang.php/source (:yang.php/source request)\n                      :yang.php.eval/profile-revision admission/profile-revision\n                      :yang.php/source-goal :eval\n                      :yang.php/grammar cst/grammar-id}]\n        (if (:yang.php/not-php pk)\n          {:request request :identity identity :cst pk}\n          (let [validated (packet/validate! pk {:source source})]\n            (cond-> {:request request :identity identity :cst validated}\n              (= :yang.cst/ok (:yang.cst/outcome validated))\n              (assoc :scope (scope/analyze validated)))))))))\n\n\n(defn compile-transport-request\n  \"Validate a sealed transport request before handing it to the parser worker.\n   Refusals include the request identity only when it is portable data.\"\n  [worker request]\n  (if-let [defect (transport/request-defect request)]\n    (cond-> {:yang.compile/outcome :yang.compile/rejected\n             :yang.compile/reason :yang.compile/invalid-request\n             :yang.compile/detail defect}\n      (and (map? request) (contains? request :yang.compile/request)\n           (transport/portable-data? (:yang.compile/request request)))\n      (assoc :yang.compile/request (:yang.compile/request request)))\n    (compile-request worker request)))\n\n\n(defn- compile-and-publish*!\n  \"Compile a sealed request and publish its canonical module and occurrence\n   set to the composition's store. Linker admission is a separate step.\"\n  [{:keys [worker store registry stage-requirement]} request]\n  (let [{:keys [cst identity] :as prepared} (compile-transport-request worker request)\n        correlation (when (map? request)\n                      (select-keys request [:yang.compile/request :yang.compile/unit\n                                            :yang.compile/provenance]))]\n    (cond\n      (:yang.compile/outcome prepared) prepared\n      (not= :yang.cst/ok (:yang.cst/outcome cst))\n      (merge correlation {:yang.compile/outcome :yang.compile/rejected\n                          :yang.compile/reason :yang.compile/invalid-source\n                          :yang.compile/diagnostics (:yang.cst/errors cst)})\n      :else\n      (let [name (symbol (str \"eval.\" (name (jing/segment-key identity))))\n            result (publication/publish! store registry name prepared)]\n        (if (= :ok (:status result))\n          (let [address (:address result)\n                site (:sites result)\n                stage (when stage-requirement\n                        (siteset/stage registry stage-requirement\n                                       {address [(:record-address site)]}))\n                derived (when stage (stage {:store store :datoms [] :principals []}\n                                           name address))]\n            (if (and derived (not= :ok (:status derived)))\n              (merge correlation {:yang.compile/outcome :yang.compile/rejected\n                                  :yang.compile/reason :yang.compile/derivation-failed\n                                  :yang.compile/detail derived})\n              (merge correlation {:yang.compile/outcome :yang.compile/published\n                                  :yang.compile/module name\n                                  :yang.compile/address address\n                                  :yang.compile/source-address (:source-address result)\n                                  :yang.compile/site-record (:record-address site)}\n                     (when derived {:yang.compile/active-address (:address derived)\n                                    :yang.compile/derivation (:derivation derived)}))))\n          (merge correlation {:yang.compile/outcome :yang.compile/rejected\n                              :yang.compile/reason :yang.compile/publication-failed\n                              :yang.compile/detail (select-keys result [:reason :status])}))))))\n\n\n(defn compile-and-publish!\n  \"Compile and publish, returning classified frontend diagnostics to the caller.\"\n  [state request]\n  (try\n    (compile-and-publish*! state request)\n    (catch #?(:cljd Object :clj Exception :cljs :default) e\n      (let [diagnostic (ex-data e)]\n        (if (:yang.php/diagnostic diagnostic)\n          (merge (when (map? request)\n                   (select-keys request [:yang.compile/request :yang.compile/unit\n                                         :yang.compile/provenance]))\n                 {:yang.compile/outcome :yang.compile/rejected\n                  :yang.compile/reason (if (= :yang.php/compile-error\n                                              (:yang.php/diagnostic diagnostic))\n                                         :yang.compile/invalid-source\n                                         :yang.compile/unsupported)\n                  :yang.compile/diagnostic diagnostic})\n          (throw e))))))\n\n\n(defn serve\n  \"Serve at most `budget` requests. Advance the immutable request cursor only\n   after its answer is appended, so a full response stream loses no request.\"\n  ([state] (serve state 32))\n  ([state budget]\n   (loop [state state, remaining budget]\n     (if (not (pos? remaining))\n       state\n       (let [read (or (:pending state)\n                      (let [item (stream/next (:requests state) (:cursor state))]\n                        (when (= :dao.stream/ok (:dao.stream/outcome item))\n                          {:cursor (:dao.stream/cursor item)\n                           :answer (compile-and-publish! state (:dao.stream/value item))})))]\n         (if read\n           (let [written (stream/append! (:responses state) (:answer read))]\n             (if (= :dao.stream/ok (:dao.stream/outcome written))\n               (recur (-> state (assoc :cursor (:cursor read)) (dissoc :pending))\n                      (dec remaining))\n               (assoc state :pending read)))\n           state))))))\n(ns yang.php.antlr.eval-publication\n  \"Publish an admitted eval unit and its canonical safepoint occurrences.\"\n  (:require [dao.jing :as jing]\n            [yang.php.antlr.lower :as lower]\n            [yang.php.antlr.siteset :as siteset]\n            [yin.vm.linker.publish :as publish]))\n\n\n(defn publish!\n  \"Publish a prepared, successfully parsed eval unit under the supplied name.\n   Retain the coordinator's identity and bind its site set to the manifest.\"\n  [store registry name prepared]\n  (if (= :yang.cst/ok (get-in prepared [:cst :yang.cst/outcome]))\n    (let [spec (lower/eval-module-spec registry name (:cst prepared))\n          result (publish/publish-module! store spec)]\n      (if (= :refused (:status result))\n        result\n        (assoc result :status :ok :identity (:identity prepared)\n               :source-address (jing/materialize! store (:identity prepared))\n               :sites (siteset/publish! store (:address result) (:ast spec)))))\n    {:status :refused :reason :eval-source-not-ready :identity (:identity prepared)}))\n(ns yang.php.antlr.e2e-harness\n  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n   program envelope -> the bundled program on each of the four VMs. Output\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n   here at the boundary.\"\n  (:require\n    [dao.host.text :as text]\n    [dao.stream :as stream]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.eval-coordinator :as eval-coordinator]\n    [yang.php.antlr.linked-harness :as linked]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yang.php.antlr.safepoint :as hooks]\n    [yang.core.uast :as u]\n    [yang.safepoint :as safepoint]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.encoder :as encoder]\n    [yin.vm.module :as module]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn host-registry\n  \"The registry the PHP compositions run over.\"\n  []\n  (portable/host-registry))\n\n\n(defn eval-compiler\n  \"A configured compiler service and its request/response streams for a run.\n   The composition drives `eval-coordinator/serve` with the returned state.\"\n  ([] (eval-compiler (linked/make-published)))\n  ([published]\n   (let [requests (tu/new-stream)\n         responses (tu/new-stream)\n         cursor (:dao.stream/cursor (stream/cursor requests stream/anchor-oldest))]\n     {:worker (eval-coordinator/make-worker), :store (:store published),\n      :registry (module/register-code-module (linked/registry)),\n      :requests requests, :responses responses,\n      :cursor cursor,\n      :stage-requirement {:hooks true, :hooks-profile lower/eval-hook-profile,\n                          :php-sp (:hook-address published)}})))\n\n\n(def ^:private base-opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn request-node\n  \"The `run-main` second-operand node the composition supplies for `request`:\n   the harness converts the record to UAST itself — lowering never embeds\n   request data.\"\n  [request]\n  (u/sexp->uast (or request :php/null)))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\n  The request record travels the composition path: the harness consumes it\n  (a plain record here) and composes it as `run-main`'s second operand —\n  lowering itself never sees request data.\"\n  ([source] (lower-program source nil))\n  ([source request]\n   (let [cst-log (tu/new-memory-log)\n         program (tu/new-memory-log)\n         diagnostics (tu/new-memory-log)]\n     (stream/append! cst-log (cst/parse-source source))\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                         (cond-> {:medium lower/program-medium}\n                                           (some? request) (assoc :request-node\n                                                                  (request-node request)))))\n     (let [{warnings true, problems false}\n           (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n       (if (seq problems)\n         {:diagnostics problems}\n         (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\n           {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)}))))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught fatal]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n       (when fatal\n         (str \"PHP Fatal error:  \" fatal))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\n   and starts one per-run counter; no option leaves the AST unchanged.\"\n  ([registry ast] (run-vms registry ast {}))\n  ([registry ast {:keys [execution-budget envelope]}]\n   (let [profile (cond-> hooks/ticks-profile\n                   (some? execution-budget) (merge hooks/profile))\n         ast (if envelope\n               (let [projected (encoder/project envelope)\n                     derived (:envelope (safepoint/derive-envelope projected profile :test/derived))\n                     tree (nth (:yin/batch derived) (:yin/root derived))]\n                 (vm/semantic-bytecode->ast tree))\n               ast)\n         ast (if (some? execution-budget) (hooks/program execution-budget ast) ast)\n         opts (assoc base-opts :modules registry)\n         session (tu/make-observer-session (tu/create-vm {:modules registry}))\n         datoms (vec (vm/ast->datoms ast))\n         projected #(:vector (sr-linearize/project ast))\n         attempt (fn [f]\n                   (try (render (f))\n                        (catch Exception e [:thrown (ex-message e)])))]\n     (tu/queue-ast! session ast)\n     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n                                                           datoms)))),\n      :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                           (:image (derive/stack-image (projected)))\n                                           (assoc opts :contract vm/stack-contract))))),\n      :register (attempt #(vm/value (vm/run (rvm/create-vm\n                                              (derive/register-image (projected))\n                                              (assoc opts\n                                                     :contract\n                                                     vm/register-contract)))))})))\n\n\n(defn run-php\n  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\n   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\"\n  ([source] (run-php source {}))\n  ([source options]\n   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\n\n\n(defn run-walker\n  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [registry (host-registry)\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n        (tu/queue-ast! session ast)\n        (try (render (vm/value (:consumer (tu/run-session session))))\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value on the AST walker, consuming an optional request record\n  through the production channel: the harness composes the record as\n  `run-main`'s second operand — no AST rewrite involved, and lowering\n  never sees request data.\"\n  ([source] (run-raw source nil))\n  ([source request]\n   (let [{:keys [diagnostics envelope]} (lower-program source request)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (let [derived (:envelope (safepoint/derive-envelope\n                                  (encoder/project envelope) hooks/ticks-profile :test/ticks))\n             ast (vm/semantic-bytecode->ast (nth (:yin/batch derived) (:yin/root derived)))\n             session (tu/make-observer-session\n                       (tu/create-vm {:modules (host-registry)}))]\n         (tu/queue-ast! session ast)\n         (vm/value (:consumer (tu/run-session session))))))))\n(ns yang.php.antlr.eval-service-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.jing.mem :as mem]\n            [dao.stream :as stream]\n            [yang.php.antlr.e2e-harness :as harness]\n            [yang.php.antlr.eval-coordinator :as coordinator]\n            [yang.php.antlr.eval-transport-test :as fixture]\n            [yang.php.antlr.linked-harness :as linked]\n            [yang.php.antlr.siteset :as siteset]\n            [yang.core.module :as core-module]\n            [yang.core.uast :as u]\n            [yin.vm :as vm]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]))\n\n\n(deftest invalid-request-is-answered-on-stream\n  (let [requests (:dao.stream/handle (tu/make-stream 8))\n        responses (:dao.stream/handle (tu/make-stream 8))\n        start (:dao.stream/cursor (stream/cursor requests stream/anchor-oldest))\n        response-start (:dao.stream/cursor (stream/cursor responses stream/anchor-oldest))\n        state {:requests requests :responses responses :cursor start\n               :worker (coordinator/make-worker)}]\n    (stream/append! requests (assoc fixture/request :scope {}))\n    (stream/append! requests (assoc fixture/request :yang.php/source (str (char 255))))\n    (coordinator/serve state)\n    (let [read (stream/next responses response-start)\n          answer (:dao.stream/value read)\n          malformed (:dao.stream/value (stream/next responses (:dao.stream/cursor read)))]\n      (is (= [:caller 1] (:yang.compile/request answer)))\n      (is (= :yang.compile/rejected (:yang.compile/outcome answer)))\n      (is (= :unknown-field (:yang.compile/detail answer)))\n      (is (= :source-encoding (get-in malformed [:yang.compile/diagnostic :reason])))\n      (is (= [:caller 1] (:yang.compile/request malformed))))))\n\n\n(deftest response-refusal-keeps-request-cursor\n  (let [requests (:dao.stream/handle (tu/make-stream 8))\n        responses (:dao.stream/handle (tu/make-stream 8))\n        cursor (:dao.stream/cursor (stream/cursor requests stream/anchor-oldest))\n        state {:requests requests :responses responses :cursor cursor\n               :worker (coordinator/make-worker)}]\n    (stream/append! requests (assoc fixture/request :scope {}))\n    (stream/close! responses)\n    (let [blocked (coordinator/serve state)\n          replacement (:dao.stream/handle (tu/make-stream 8))\n          start (:dao.stream/cursor (stream/cursor replacement stream/anchor-oldest))\n          resumed (coordinator/serve (assoc blocked :responses replacement))]\n      (is (= cursor (:cursor blocked)))\n      (is (:pending blocked))\n      (is (not= cursor (:cursor resumed)))\n      (is (nil? (:pending resumed)))\n      (is (= :unknown-field (:yang.compile/detail\n                              (:dao.stream/value (stream/next replacement start))))))))\n\n\n(deftest valid-and-invalid-source-are-answered\n  (let [requests (:dao.stream/handle (tu/make-stream 8))\n        responses (:dao.stream/handle (tu/make-stream 8))\n        start (:dao.stream/cursor (stream/cursor requests stream/anchor-oldest))\n        response-start (:dao.stream/cursor (stream/cursor responses stream/anchor-oldest))\n        state {:requests requests :responses responses :cursor start\n               :worker (coordinator/make-worker)\n               :store (mem/create-content-mem) :registry (linked/registry)}]\n    (stream/append! requests fixture/request)\n    (stream/append! requests (assoc fixture/request :yang.php/source \"return (;\"))\n    (stream/append! requests (assoc fixture/request :yang.php/source \"eval('return 1;');\"))\n    (coordinator/serve state)\n    (let [first-read (stream/next responses response-start)\n          published (:dao.stream/value first-read)\n          second-read (stream/next responses (:dao.stream/cursor first-read))\n          refused (:dao.stream/value second-read)\n          unsupported (:dao.stream/value (stream/next responses (:dao.stream/cursor second-read)))]\n      (is (= :yang.compile/published (:yang.compile/outcome published)) (pr-str published))\n      (is (:yang.compile/address published))\n      (is (:yang.compile/site-record published))\n      (is (= :yang.compile/invalid-source (:yang.compile/reason refused)))\n      (is (= [:caller 1] (:yang.compile/request refused)))\n      (is (= :yang.compile/unsupported (:yang.compile/reason unsupported)))\n      (is (= :eval (get-in unsupported [:yang.compile/diagnostic :construct]))))))\n\n\n(deftest published-eval-is-admitted-by-site-stage\n  (let [store (mem/create-content-mem)\n        registry (linked/registry)\n        hook (publish/publish-module! store {:name 'php.sp :ast (core-module/module-tree [])\n                                             :exports #{} :requires {} :primitives {}})\n        service (harness/eval-compiler {:store store :hook-address (:address hook)})\n        requests (:requests service)\n        responses (:responses service)\n        response-cursor (:dao.stream/cursor (stream/cursor responses stream/anchor-oldest))\n        requirement (:stage-requirement service)\n        _ (stream/append! requests (assoc fixture/request :yang.php/source \"while (false) {} return 1;\"))\n        _ (coordinator/serve service)\n        result (:dao.stream/value (stream/next responses response-cursor))\n        address (:yang.compile/address result)\n        stage (siteset/stage registry requirement\n                             {address [(:yang.compile/site-record result)]})\n        name (:yang.compile/module result)\n        admitted (stage {:store store :datoms [] :principals []} name address)\n        source (link/composition {:content-store store\n                                  :name-env {name address 'php.sp (:address hook)}\n                                  :derivation :trusted :stage stage})\n        pair (link/make-pair)\n        program (u/seq-nodes [(u/app (u/v 'require) (u/lit 'code))\n                              (u/app (u/v 'require) (u/lit name))\n                              (u/app (u/v 'code/entry) (u/lit name)\n                                     (u/lit (:address admitted)) (u/lit 'entry))])\n        task ((:semantic linked/backends) program\n                                          (linked/composition (module/register-code-module registry) pair))\n        done (try (first (linked/drive task pair source))\n                  (catch Exception e {:error (ex-data e)}))]\n    (is (= :ok (:status admitted)) (pr-str admitted))\n    (is (seq (:set (siteset/verify store address (:yang.compile/site-record result)))))\n    (is (:derivation admitted))\n    (is (= (:address admitted) (:yang.compile/active-address result)))\n    (is (not= address (:address admitted)))\n    (is (nil? (:error done)) (pr-str (:error done)))\n    (is (not (vm/blocked? done)))\n    (is (values/closure? (vm/value done)) (pr-str (vm/value done)))))\n","exit_code":0,"status":"completed"}}
