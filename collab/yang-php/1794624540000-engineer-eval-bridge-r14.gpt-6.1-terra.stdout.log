lit path) (delivery-thunk path) (u/lit kind) scope frame))\n      (do (warn! ctx n :yang.php/computed-include-path\n                 \"include path is computed; it resolves through the published path map at run time\" {})\n          (app* 'php/include-computed (lower ctx operand) (u/lit kind) scope frame)))))\n\n\n(defn- lower-prefix\n  [ctx n [op operand :as ks]]\n  (let [t (:type op)]\n    (case t\n      \"Minus\" (app* 'php/neg (lower ctx operand))\n      \"Plus\" (app* 'php/plus (lower ctx operand))\n      \"Bang\" (app* 'not (truthy (lower ctx operand)))\n      \"Tilde\" (app* 'php/bit-not (lower ctx operand))\n      \"SuppressWarnings\" (lower-silence ctx operand)\n      (\"Inc\" \"Dec\") (lower-incdec ctx n operand t true)\n      \"IsSet\" (lower-isset ctx n (core/rules ctx (nth ks 2) \"chain\"))\n      \"Empty\" (lower-empty ctx n (nth ks 2))\n      \"Print\" (u/then (app* 'php/echo (app* 'php/to-string (lower ctx operand)))\n                      (u/lit 1))\n      \"Exit\" (app* 'php/exit (if operand (lower ctx operand) (u/lit 0)))\n      \"OpenRoundBracket\" (lower-cast ctx n ks)\n      \"Throw\" (app* 'php/throw-value (lower ctx operand))\n      \"Clone\" (app* 'php/clone-obj (lower ctx operand) (cc-node ctx))\n      \"List\" (lower-destructure ctx n\n                                (pattern-of ctx n (first (core/rules ctx n \"assignmentList\")))\n                                (last ks))\n      (if-let [kind (get include-kinds t)]\n        (lower-include ctx n kind operand)\n        (if-let [construct (get prefix-refusals t)]\n          (unsupported! n construct)\n          (unsupported! n (keyword (str/lower-case t))))))))\n\n\n(def ^:private assignment-ops\n  {\"PlusEqual\" 'php/add,\n   \"MinusEqual\" 'php/sub,\n   \"MulEqual\" 'php/mul,\n   \"PowEqual\" 'php/pow,\n   \"DivEqual\" 'php/div,\n105:   \"Eval\" :eval,\n880:  \"A vector of the nodes `nodes`, evaluated left to right.\"\n967:  \"`loc` with its keys lowered in place: nested applications evaluate them\n1052:   other operand is evaluated as written.\"\n1141:   its keys evaluated once; the postfix form answers the old value.\"\n1374:;; The source is evaluated once; a missing key warns and assigns null, a\n1844:        ;; that builtin (user-lc nil). isset / unset / empty / exit / eval\n1866:          \"eval\" (unsupported! n :eval)\n2552:  \"`foreach (e as $v)` / `as $k => $v`: the operand is evaluated once.\n3039:   (evaluated here, in the callee), else an `ArgumentCountError`. A hole left\n3748:                     (if (and (:eval-unit? ctx) (hoisted? ctx item))\n3752:    (when-not (:eval-unit? ctx) (check-hoisted! ctx hoisted))\n3761:                 (concat (if (:eval-unit? ctx)\n3806:(def eval-hook-profile\n3807:  \"Safepoint derivation aliases bound to the caller's hooks in an eval entry.\"\n3808:  {:loop '%eval-loop\n3809:   :call {:hook '%eval-call :sequence true}\n3810:   :line {:hook '%eval-line :operands true :after true}})\n3813:(defn eval-runtime-node\n3814:  \"Build the caller's eval runtime environment from the prelude inventory.\"\n3821:(defn eval-entry\n3822:  \"Lower an eval unit to a callable that borrows its caller's runtime,\n3825:  ([packet] (eval-entry packet {}))\n3828:                    :module? true :eval-unit? true)\n3829:         body (u/let1 '%eval-result (unit-node ctx true)\n3830:                      (u/if-node (app* '= (u/v '%eval-result) (u/lit :php/no-return))\n3832:                                 (u/v '%eval-result)))\n3837:       (throw (ex-info \"eval unit has unknown runtime imports\"\n3846:                            (reverse [['%eval-loop :loop] ['%eval-call :call] ['%eval-line :line]]))))\n3850:(defn eval-module-spec\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The existing `code/entry` handler already enforces the manifest and export pin. The missing integration is larger than a single lowering substitution: the runtime must publish and install each compiled unit before that handler can return its closure, while preserving the caller’s scope and hooks. I’m tracing that installation path now."}}
