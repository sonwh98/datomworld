ame`.\"\nsrc/cljc/yang/php/antlr/lower.cljc:3853:  (let [ast (core-module/module-tree [(u/def! 'entry (:ast (eval-entry packet)))])]\n  [state effect opts]\n  (handle-require state effect opts false))\n\n\n(defn try-require-handler\n  \"Resolve `:module/try-require`, returning linker outcomes as data.\"\n  [state effect opts]\n  (handle-require state effect opts true))\n\n\n(defn code-entry-handler\n  \"Read a declared export from an already installed, address-pinned module.\"\n  [state effect _opts]\n  (let [{:keys [module address export]} effect\n        entry (when (symbol? module) (module-entry (:modules (:modules state)) module))\n        manifest (:manifest entry)\n        reason (cond\n                 (nil? entry) :module-missing\n                 (or (nil? address) (not= address (:address entry))\n                     (not= address (jing/segment-key manifest))\n                     (not= module (:yin.module/name manifest))) :manifest-mismatch\n                 (not (contains? (:yin.module/exports manifest) export)) :export-undeclared\n                 (not (contains? (:bindings entry) export)) :binding-missing)]\n    {:state state, :blocked? false\n     :value (if reason\n              {:status :refused :reason reason :module module :export export}\n              (get (:bindings entry) export))}))\n\n\n(defn code-entry\n  \"Construct an effect to retrieve a previously installed export.\"\n  [module address export]\n  (make-effect :code/entry {:module module :address address :export export}))\n\n\n(defn register-code-module\n  \"Expose the profiled code/entry constructor to a composition.\"\n  [registry]\n  (register-host-module registry 'code {'entry code-entry}\n                        {'entry (vm/primitive-profile 'entry :effectful [3]\n                                                      #{:code/entry} :none)}))\n\n\n(defn default-registry\n  \"A registry with the built-in effect handlers and no modules.\"\n  []\n  (-> (empty-registry)\n      (register-effect-handler :module/require require-handler)\n      (register-effect-handler :module/try-require try-require-handler)\n      (register-effect-handler :code/entry code-entry-handler)))\n(ns yang.php.antlr.eval-transport\n  \"Validation of the portable, sealed eval compiler request.\")\n\n\n(def request-fields\n  #{:yang.compile/request :yang.compile/unit :yang.compile/frontend-revision\n    :yang.compile/compiler-revision :yang.compile/goal :yang.compile/provenance\n    :yang.compile/options :yang.php/source})\n\n\n(defn portable-data?\n  \"True for the data forms accepted by this request protocol.\"\n  [x]\n  (cond\n    (or (nil? x) (boolean? x) (string? x) (number? x)\n        (keyword? x) (symbol? x)) true\n    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\n    (or (vector? x) (set? x) (list? x)) (every? portable-data? x)\n    :else false))\n\n\n(defn request-defect\n  \"Return a protocol defect or nil. Unknown fields are refused so that\n   caller runtime state cannot accidentally be included at the top level.\"\n  [request]\n  (cond\n    (not (map? request)) :request-shape\n    (some #(not (contains? request %)) request-fields) :missing-field\n    (some #(not (contains? request-fields %)) (keys request)) :unknown-field\n    (not= :eval (:yang.compile/goal request)) :wrong-goal\n    (not (string? (:yang.php/source request))) :source-shape\n    (not (map? (:yang.compile/options request))) :options-shape\n    (not (portable-data? request)) :non-portable-data\n    :else nil))\n(ns yang.php.antlr.eval-transport-test\n  (:require [clojure.test :refer [deftest is]]\n            [yang.php.antlr.eval-transport :as transport]\n            [yang.php.antlr.eval-coordinator :as coordinator]))\n\n\n(def request\n  {:yang.compile/request [:caller 1]\n   :yang.compile/unit :unit\n   :yang.compile/frontend-revision :frontend-v1\n   :yang.compile/compiler-revision :compiler-v1\n   :yang.compile/goal :eval\n   :yang.compile/provenance {:path \"caller.php\"}\n   :yang.compile/options {}\n   :yang.php/source \"return 1;\"})\n\n\n(deftest sealed-request-boundary\n  (is (nil? (transport/request-defect request)))\n  (is (= :unknown-field (transport/request-defect (assoc request :scope {}))))\n  (is (= :missing-field (transport/request-defect (dissoc request :yang.compile/request))))\n  (is (= :wrong-goal (transport/request-defect (assoc request :yang.compile/goal :file))))\n  (is (= :non-portable-data (transport/request-defect\n                              (assoc-in request [:yang.compile/options :handle] (Object.))))))\n\n\n(deftest coordinator-consumes-sealed-requests\n  (let [worker (coordinator/make-worker)\n        prepared (coordinator/compile-transport-request worker request)\n        refused (coordinator/compile-transport-request worker (assoc request :scope {}))]\n    (is (= :yang.cst/ok (get-in prepared [:cst :yang.cst/outcome])))\n    (is (= :yang.compile/rejected (:yang.compile/outcome refused)))\n    (is (= :yang.compile/invalid-request (:yang.compile/reason refused)))\n    (is (= :unknown-field (:yang.compile/detail refused)))\n    (is (= [:caller 1] (:yang.compile/request refused)))\n    (is (not (contains? refused :scope)))))\n","exit_code":0,"status":"completed"}}
