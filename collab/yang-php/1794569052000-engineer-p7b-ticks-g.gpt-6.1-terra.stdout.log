down-function\\n     (fn [args]\\n       (do (cell/set! php.rt/shutdown-fns\\n                      (php/vconj (cell/get php.rt/shutdown-fns)\\n                                 (php/pair (get args 0) (php/args-tail args 1 []))))\\n           :php/null))]\\n    [php/freeze-finalizable\\n     ;; step 4 frees without destructors: whatever is left counts as destructed\\n     (fn [objs i]\\n       (if (< i (data/count objs))\\n         (do (cell/set! (get (get objs i) :php/obj) (assoc (php/obj-state (get objs i)) :destructed? true))\\n             (php/freeze-finalizable objs (+ i 1)))\\n         :php/null))]\\n    [php/release-globals\\n     (fn [order i]\\n       (if (< i 0)\\n;; =============================================================================\\n;; The module emitter: the same definition list as the linker module `php`\\n;; =============================================================================\\n\\n(def module-name\\n  \\\"The linker module the PHP runtime profile is published as.\\\"\\n  'php)\\n\\n\\n(def runtime-keys\\n  \\\"Every key `php/init!` allocates, the ready flag aside, sorted.\\\"\\n  '[php.rt/class-index php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/diag-stream\\n    php.rt/error-handler\\n    php.rt/error-mask php.rt/error-masks\\n    php.rt/class-order php.rt/exception-handler php.rt/exception-handlers php.rt/finalizable php.rt/pending-exc\\n    php.rt/shutdown-fns php.rt/exit-status php.rt/in-shutdown php.rt/fatal-escape\\n    php.rt/exit-escape php.rt/shutdown-escape php.rt/strict php.rt/included php.rt/path-map php.rt/unit\\n    php.rt/autoloaders php.rt/autoloading php.rt/class-map php.rt/constants\\n    php.rt/error-reporting php.rt/error-handlers php.rt/functions php.rt/globals php.rt/int-max\\n    php.rt/int-min php.rt/next-cell php.rt/next-ord\\n    php.rt/out php.rt/request php.rt/response php.rt/response-stream\\n    php.rt/headers-sent php.rt/status php.rt/tmps])\\n\\n\\n(defn strip\\n  \\\"`sym` without the module's own namespace `php`; `php.rt/*` stays\\n   qualified.\\\"\\n  [sym]\\n  (core/strip \\\"php\\\" sym))\\n\\n\\n(ns yang.php.antlr.builtins\\n  \\\"The pinned PHP builtin catalogue (docs/design/yang.php.md section 3.8): the\\n   lower-cased names of the PHP 8.3 core functions a program is likely to\\n   call. A call to a name in this set that is neither declared by the unit nor\\n   supplied by the prelude gets the `:yang.php/unknown-builtin` warning\\n   diagnostic at lowering, so an unsupported library function fails honestly\\n   before the program runs. At run time such a call is still\\n   `Error: Call to undefined function`; nothing is stubbed to return\\n   success. The list is checked in, not derived: regenerate it from\\n   `get_defined_functions()['internal']` of the pinned PHP when the target\\n   version moves.\\\")\\n\\n\\n(def supported\\n  \\\"The builtins the prelude supplies: lower-cased PHP name to the prelude\\n   definition that implements it and, for a by-reference builtin, the\\n   by-reference argument positions (`:by-ref`). The prelude derives its\\n   registration from this table and the lowering reads `:by-ref`, so a\\n   position is stated once. A by-reference builtin answers `[ret outs]`.\\\"\\n  (let [plain (fn [m] (into {} (map (fn [[k v]] [k {:prelude v}])) m))\\n        by-ref (fn [m] (into {} (map (fn [[k v]] [k {:prelude v, :by-ref [0]}])) m))\\n        ;; the replacement count of str_replace/str_ireplace is the fourth\\n        ;; argument, so its by-reference position is 3, not 0\\n        count-out {\\\"str_replace\\\" {:prelude 'php/bi-str-replace, :by-ref [3]},\\n                   \\\"str_ireplace\\\" {:prelude 'php/bi-str-ireplace, :by-ref [3]}}]\\n    (merge count-out\\n           (plain {\\\"var_dump\\\" 'php/bi-var-dump, \\\"intdiv\\\" 'php/bi-intdiv, \\\"fmod\\\" 'php/bi-fmod,\\n                   \\\"strlen\\\" 'php/bi-strlen, \\\"intval\\\" 'php/bi-intval, \\\"floatval\\\" 'php/bi-floatval,\\n                   \\\"strval\\\" 'php/bi-strval, \\\"boolval\\\" 'php/bi-boolval, \\\"is_nan\\\" 'php/bi-is-nan,\\n                   \\\"set_error_handler\\\" 'php/bi-set-error-handler,\\n                   \\\"restore_error_handler\\\" 'php/bi-restore-error-handler,\\n                   \\\"error_reporting\\\" 'php/bi-error-reporting,\\n                   \\\"trigger_error\\\" 'php/bi-trigger-error, \\\"user_error\\\" 'php/bi-trigger-error,\\n                   \\\"ob_start\\\" 'php/bi-ob-start, \\\"ob_get_contents\\\" 'php/bi-ob-get-contents,\\n                   \\\"ob_get_clean\\\" 'php/bi-ob-get-clean, \\\"ob_end_clean\\\" 'php/bi-ob-end-clean,\\n                   \\\"ob_end_flush\\\" 'php/bi-ob-end-flush,\\n                   \\\"header\\\" 'php/bi-header, \\\"headers_sent\\\" 'php/bi-headers-sent,\\n                   \\\"http_response_code\\\" 'php/bi-http-response-code,\\n                   \\\"setcookie\\\" 'php/bi-setcookie, \\\"setrawcookie\\\" 'php/bi-setrawcookie,\\n                   \\\"php_sapi_name\\\" 'php/php-sapi-name, \\\"getenv\\\" 'php/bi-getenv,\\n                   \\\"count\\\" 'php/bi-count, \\\"sizeof\\\" 'php/bi-count,\\n                   \\\"array_keys\\\" 'php/bi-array-keys, \\\"array_values\\\" 'php/bi-array-values,\\n                   \\\"array_merge\\\" 'php/bi-array-merge,\\n                   \\\"current\\\" 'php/bi-current, \\\"pos\\\" 'php/bi-current, \\\"key\\\" 'php/bi-key,\\n                   \\\"implode\\\" 'php/bi-implode, \\\"join\\\" 'php/bi-implode, \\\"array_sum\\\" 'php/bi-array-sum,\\n                   \\\"array_key_exists\\\" 'php/bi-array-key-exists,\\n                   \\\"key_exists\\\" 'php/bi-array-key-exists, \\\"in_array\\\" 'php/bi-in-array,\\n                   \\\"is_array\\\" 'php/bi-is-array, \\\"array_key_first\\\" 'php/bi-array-key-first,\\n                   \\\"array_key_last\\\" 'php/bi-array-key-last, \\\"get_class\\\" 'php/bi-get-class,\\n                   \\\"register_shutdown_function\\\" 'php/bi-register-shutdown-function,\\n                   \\\"define\\\" 'php/bi-define, \\\"defined\\\" 'php/bi-defined, \\\"constant\\\" 'php/bi-constant,\\n                   \\\"function_exists\\\" 'php/bi-function-exists, \\\"class_exists\\\" 'php/bi-class-exists,\\n                   \\\"spl_autoload_register\\\" 'php/bi-spl-autoload-register,\\n                   \\\"spl_autoload_unregister\\\" 'php/bi-spl-autoload-unregister,\\n                   \\\"spl_autoload_functions\\\" 'php/bi-spl-autoload-functions,\\n                   \\\"spl_autoload_call\\\" 'php/bi-spl-autoload-call,\\n                   \\\"set_exception_handler\\\" 'php/bi-set-exception-handler,\\n                   \\\"restore_exception_handler\\\" 'php/bi-restore-exception-handler,\\n                   \\\"substr\\\" 'php/bi-substr, \\\"strpos\\\" 'php/bi-strpos, \\\"stripos\\\" 'php/bi-stripos,\\n                   \\\"strrpos\\\" 'php/bi-strrpos,\\n                   \\\"str_contains\\\" 'php/bi-str-contains,\\n                   \\\"str_starts_with\\\" 'php/bi-str-starts-with, \\\"str_ends_with\\\" 'php/bi-str-ends-with,\\n                   \\\"trim\\\" 'php/bi-trim, \\\"ltrim\\\" 'php/bi-ltrim, \\\"rtrim\\\" 'php/bi-rtrim,\\n                   \\\"strtolower\\\" 'php/bi-strtolower, \\\"strtoupper\\\" 'php/bi-strtoupper,\\n                   \\\"str_repeat\\\" 'php/bi-str-repeat, \\\"str_pad\\\" 'php/bi-str-pad, \\\"strrev\\\" 'php/bi-strrev,\\nsrc/cljc/yang/safepoint.cljc:75:(defn sites\\nsrc/cljc/yang/safepoint.cljc:86:(defn site-set\\nsrc/cljc/yang/safepoint.cljc:122:(defn- site-hooks\\nsrc/cljc/yang/safepoint.cljc:323:(defn- derive-call-sites\\nsrc/cljc/yang/clojure.cljc:79:(defn annotate-call-sites\\nsrc/cljc/yang/clojure.cljc:93:(defn eligible-application-sites\\nsrc/cljc/yang/clojure.cljc:103:(defn call-site-metadata\\nsrc/cljc/yang/clojure.cljc:118:(defn marked-application-sites\\nsrc/cljc/yang/clojure.cljc:140:(defn validate-call-site-coverage!\\nsrc/cljc/yang/clojure.cljc:253:(defn validate-ast-call-sites!\\nsrc/cljc/yang/core/uast.cljc:129:(defn annotate-call-sites\\nsrc/cljc/yang/core/lower.cljc:76:(defn site\\nsrc/cljc/yang/python/antlr/siteset.cljc:65:(defn site-set-of\\n  [paths]\\n  (app* 'php/bind-path-map!\\n        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\\n                (u/lit {})\\n                (sort paths))))\\n\\n\\n(defn lower-program\\n  \\\"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\\n   `php/run-main` after the prelude, tail calls marked. Its value is\\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\\n   `:warnings` are the lowering's warning-severity diagnostics\\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\\n   `:yang.php/computed-include-path`).\\n\\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\\n   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\\n   need); `:path` the entry unit's declared path (default `entry-path`);\\n   `:paths` the normalized paths whose units the composition published,\\n   which a computed include resolves against; `:class-map` true requires\\n   the published `phpm.$classmap` and binds its classes and delivery thunks\\n   (plan P6 R9), which takes the place of `:paths`; `:request-node` is the\\n  opaque `run-main` second-operand node the harness composed from the\\n  attached request stream (lowering never embeds request data — `run-main`\\n  consumes the record from the stream at runtime);\\n  `:response-node` and `:diag-node` are the opaque third and fourth\\n  operands: the composition-supplied stream references execution emits\\n  on. Absent, `run-main` runs with two operands and the cells\\n  accumulate.\\\"\\n  ([packet] (lower-program packet {}))\\n  ([packet {:keys [prelude paths path class-map request-node response-node diag-node],\\n            :or {prelude :bundled}}]\\n   (when-not (contains? #{:bundled :linked} prelude)\\n     (throw (ex-info \\\"unknown PHP prelude profile\\\"\\n                     {:yang.php/diagnostic :yang.php/unsupported,\\n                      :construct :prelude,\\n                      :prelude prelude})))\\n   (let [linked? (= :linked prelude)\\n         request-node (or request-node (u/sexp->uast :php/null))\\n         ctx (context packet {:path (or path entry-path), :linked? linked?})\\n         ;; `run-main`'s second operand arrives composed by the harness from\\n         ;; the attached request stream: production initialization consumes\\n         ;; the record from the stream at runtime and seeds the superglobals,\\n         ;; no postwalk rewrite and no request data through lowering involved.\\n         ;; With stream nodes `run-main` takes four operands (request,\\n         ;; response and diagnostics references); without them it takes two\\n         ;; and the cells accumulate.\\n         main (if (or response-node diag-node)\\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\\n                      (or response-node (u/sexp->uast :php/null))\\n                      (or diag-node (u/sexp->uast :php/null)))\\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))]\\n     {:ast (u/mark-tails\\n             (if linked?\\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\\n                                     (app* 'require (u/lit prelude/module-name))\\n                                     (app* 'php/init!)]\\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\\n                                    (when class-map\\n                                      [(app* 'require (u/lit classmap-module))\\n                                       (app* 'php/bind-class-map!\\n                                             (u/v (symbol (str classmap-module) \\\"classes\\\"))\\n                                             (u/v (symbol (str classmap-module) \\\"paths\\\")))])\\n                                    [main]))\\n               (u/then prelude/uast main))),\\n      :warnings @(:warnings ctx)})))\\n\\n\\n(defn lower-packet\\n  \\\"The complete program for one ok packet (`lower-program`'s `:ast`).\\\"\\n  ([packet] (lower-packet packet {}))\\n  ([packet opts] (:ast (lower-program packet opts))))\\n\\n\\n;; =============================================================================\\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\\n;; =============================================================================\\n\\n(def module-exports\\n  \\\"The exports of a compiled PHP unit: its spec and body, immutable after\\n   install.\\\"\\n(ns yang.php.antlr.e2e-harness\\n  \\\"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\\n   program envelope -> the bundled program on each of the four VMs. Output\\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\n   here at the boundary.\\\"\\n  (:require\\n    [dao.host.text :as text]\\n    [dao.stream :as stream]\\n    [yang.php.antlr.cst :as cst]\\n    [yang.php.antlr.lower :as lower]\\n    [yang.php.antlr.portable-harness :as portable]\\n    [yang.php.antlr.safepoint :as hooks]\\n    [yang.core.uast :as u]\\n    [yang.safepoint :as safepoint]\\n    [yin.vm :as vm]\\n    [yin.vm.debruijn.register :as rvm]\\n    [yin.vm.debruijn.stack :as dvm]\\n    [yin.vm.encoder :as encoder]\\n    [yin.vm.semantic :as semantic]\\n    [yin.vm.semantic.derive :as derive]\\n    [yin.vm.semantic.linearize :as sr-linearize]\\n    [yin.vm.test-utils :as tu]))\\n\\n\\n(defn host-registry\\n  \\\"The registry the PHP compositions run over.\\\"\\n  []\\n  (portable/host-registry))\\n\\n\\n(def ^:private base-opts\\n  {:make-stream tu/make-stream,\\n   :capability-secret tu/secret,\\n   :primitives vm/primitives})\\n\\n\\n(def ^:private load-semantic\\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\n\\n\\n(defn request-node\\n  \\\"The `run-main` second-operand node the composition supplies for `request`:\\n   the harness converts the record to UAST itself — lowering never embeds\\n   request data.\\\"\\n  [request]\\n  (u/sexp->uast (or request :php/null)))\\n\\n\\n(defn lower-program\\n  \\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\n  The request record travels the composition path: the harness consumes it\\n  (a plain record here) and composes it as `run-main`'s second operand —\\n  lowering itself never sees request data.\\\"\\n  ([source] (lower-program source nil))\\n  ([source request]\\n   (let [cst-log (tu/new-memory-log)\\n         program (tu/new-memory-log)\\n         diagnostics (tu/new-memory-log)]\\n     (stream/append! cst-log (cst/parse-source source))\\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\\n                                         (cond-> {:medium lower/program-medium}\\n                                           (some? request) (assoc :request-node\\n                                                                  (request-node request)))))\\n     (let [{warnings true, problems false}\\n           (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\n       (if (seq problems)\\n         {:diagnostics problems}\\n         (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\n           {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)}))))))\\n\\n\\n(defn packet->form\\n  \\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\n   rule, `[\\\\\\\"TYPE\\\\\\\" \\\\\\\"text\\\\\\\"]` for a token. The inverse of\\n   `portable-harness/packet`.\\\"\\n  [{:yang.cst/keys [root nodes]}]\\n  (letfn [(form\\n            [id]\\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\\n              (if (= :token kind)\