ddress-algorithm\n+  (let [manifest {:yin.module/name 'eval.unit :yin.module/exports #{'entry}}\n+        address (jing/segment-key manifest {:algorithm :sha256})\n+        malformed :segment/sha256-xyz\n+        unknown (keyword \"segment\" (str \"sha512-\" (jing/segment-digest address)))\n+        lookup (fn [stored-manifest stored-address requested-address]\n+                 (let [registry (module/assoc-module (module/default-registry) 'eval.unit\n+                                                     {:manifest stored-manifest\n+                                                      :address stored-address\n+                                                      :bindings {'entry :callable}})]\n+                   (:value (module/code-entry-handler\n+                             {:modules registry}\n+                             {:module 'eval.unit :address requested-address :export 'entry}\n+                             {}))))]\n+    (testing \"an installed SHA-256 manifest serves its export\"\n+      (is (= :callable (lookup manifest address address))))\n+    (doseq [[label stored-manifest stored-address requested-address]\n+            [[\"tampered manifest\" (assoc manifest :extra true) address address]\n+             [\"nil requested address\" manifest address nil]\n+             [\"nil stored and requested addresses\" manifest nil nil]\n+             [\"malformed address\" manifest malformed malformed]\n+             [\"unknown algorithm\" manifest unknown unknown]]]\n+      (testing label\n+        (is (= {:status :refused :reason :manifest-mismatch\n+                :module 'eval.unit :export 'entry}\n+               (lookup stored-manifest stored-address requested-address)))))))\ndiff --git a/test/yin/vm/store_write_audit_test.clj b/test/yin/vm/store_write_audit_test.clj\nindex 94d2a31a..548dcc96 100644\n--- a/test/yin/vm/store_write_audit_test.clj\n+++ b/test/yin/vm/store_write_audit_test.clj\n@@ -299,6 +299,9 @@\n    ;; handle in its context; this is not a VM program store write.\n    \"src/cljc/yang/php/antlr/siteset.cljc\"\n    {[\"stage\" \"assoc\"] 1}\n+   ;; The eval staging context carries the composition's dao.jing byte-store handle.\n+   \"src/cljc/yang/php/antlr/eval_coordinator.cljc\"\n+   {[\"compile-and-publish*!\" :map] 1}\n    \"src/cljc/yin/vm/engine.cljc\"\n    {;; the one program write, and `put-active`, which routes every program\n     ;; write -- definitions, direct store instructions, the :vm/store-put\n(ns yang.php.antlr.eval-coordinator\n  \"Composition-supplied eval frontend and stream service.\"\n  (:require [dao.jing :as jing]\n            [dao.stream :as stream]\n            [yang.antlr.packet :as packet]\n            [yang.php.antlr.cst :as cst]\n            [yang.php.antlr.eval-admission :as admission]\n            [yang.php.antlr.eval-publication :as publication]\n            [yang.php.antlr.eval-transport :as transport]\n            [yang.php.antlr.scope :as scope]\n            [yang.php.antlr.siteset :as siteset]))\n\n\n(defn make-worker\n  []\n  (cst/make-eval-worker))\n\n\n(defn compile-request\n  \"Prepare one request for later eval-unit emission. Identity includes the\n   complete request (including bytes and caller-supplied revisions/options),\n   the source goal, grammar and admission profile. No caller runtime state is\n   needed by this service.\"\n  [worker request]\n  (let [{:keys [source] :as admitted} (admission/admit-request request)]\n    (if-not source\n      admitted\n10:(defn publish!\n22:               :source-address (jing/materialize! store (:identity prepared))\nAmerica/New_York\n","exit_code":0,"status":"completed"}}
