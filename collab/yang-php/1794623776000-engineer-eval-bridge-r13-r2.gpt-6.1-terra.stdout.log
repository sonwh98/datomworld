{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,60p' test/yang/php/antlr/p5b2_lifecycle_test.clj; sed -n '5875,5975p' src/cljc/yang/php/antlr/prelude.cljc\"","aggregated_output":"(ns yang.php.antlr.p5b2-lifecycle-test\n  \"P5b2 regressions: the request lifecycle, merge, header/cookie/status and\n  error-triggering completions. Expectations are hand-derived from PHP 8.3;\n  every fixture stays available to the oracle recording pass.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [clojure.walk :as walk]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.e2e-harness :as h]\n    [yang.php.antlr.linked-harness :as lh]\n    [yang.php.antlr.portable-harness :as ph]\n    [yang.php.antlr.prelude :as prelude]\n    [yang.php.antlr.programs-p5b2 :as p5b2]))\n\n\n(defn- diagnostics\n  [r]\n  (mapv (juxt :errno :message) (:php/diag r)))\n\n\n(deftest p5b2-lifecycle-fixtures-test\n  (doseq [{:keys [id source request out diag response status fatal uncaught]} p5b2/fixtures]\n    (testing (name id)\n      (let [r (h/run-raw source request)]\n        (is (= out (:php/out r)))\n        (is (= (vec diag) (diagnostics r)))\n        (when response (is (= response (:php/response r))))\n        (when status (is (= status (:php/status r))))\n        (when fatal (is (= fatal (:php/fatal r))))\n        (when-not fatal (is (nil? (:php/fatal r))))\n        (if uncaught\n          (is (= uncaught (select-keys (:php/uncaught r) [:class :message])))\n          (is (nil? (:php/uncaught r))))))))\n\n\n(deftest run-main-consumes-request-without-rewrite-test\n  (testing \"production initialization seeds superglobals from the operand\"\n    (let [r (h/run-raw \"<?php echo $_GET['v'];\" (assoc p5b2/base-request\n                                                       :php.request/query\n                                                       (p5b2/request-array [[\"v\" \"Q\"]])))]\n      (is (= \"Q\" (:php/out r)))\n      (is (= [] (:php/diag r))))))\n\n\n(deftest stream-lifecycle-consumes-and-emits-over-streams-test\n  (testing \"the request consumed from the request stream seeds the superglobals\"\n    (let [request (assoc p5b2/base-request\n                         :php.request/query (p5b2/request-array [[\"v\" \"Q\"]])\n                         :php.request/body (p5b2/request-array [[\"w\" \"W\"]]))\n          source \"<?php echo $_GET['v'], $_POST['w'], $_REQUEST['v'], $_REQUEST['w'];\"\n          {:keys [value response diag] :as lifecycle}\n          (ph/run-lifecycle-raw (cst/parse-source source) request)]\n      (is (= request (:request lifecycle)))\n      (is (= [{:php.response/body \"QWQW\"}] response))\n      (is (= [] diag))\n      (is (= response (:php/response value)))\n      (is (= diag (:php/diag value)))\n      (is (= \"QWQW\" (:php/out value)))\n      (is (= \"QWQW\" (:php/out (h/run-raw source request))))))\n  (testing \"diagnostic records are emitted on the diagnostics stream\"\n           (cell/set! php.rt/in-shutdown false)\n           (cell/set! php.rt/fatal-escape :php/null)\n           (cell/set! php.rt/exit-escape :php/null)\n           (cell/set! php.rt/shutdown-escape :php/null)\n           (let [response-records\n                 (fn []\n                   ;; what execution emitted: drained from the\n                   ;; composition-supplied streams when present (the drain\n                   ;; runs at the end of the run, after shutdown), else the\n                   ;; accumulated cells; replacement is always interpreted\n                   ;; from the appended commands at read time.\n                   (let [h (cell/get php.rt/response-stream)\n                         dh (cell/get php.rt/diag-stream)]\n                     (php/pair (php/response-view (if (= h :php/null)\n                                                    (cell/get php.rt/response)\n                                                    (php/drain-stream h))\n                                                  0 [])\n                               (if (= dh :php/null)\n                                 (cell/get php.rt/diag)\n                                 (php/drain-stream dh)))))\n                 result (fn [exc]\n                          (let [out (data/str-join \"\" (get (cell/get php.rt/out) 0))]\n                            (do (if (= out \"\")\n                                  :php/null\n                                  ;; the body record joins the task's\n                                  ;; emissions before the read: appended to\n                                  ;; the stream when present, else conjoined\n                                  ;; onto the accumulated cells.\n                                  (let [body-rec (assoc {} :php.response/body out)\n                                        hs (cell/get php.rt/response-stream)]\n                                    (if (= hs :php/null)\n                                      (cell/set! php.rt/response\n                                                 (php/vconj (cell/get php.rt/response) body-rec))\n                                      (stream/put! hs body-rec))))\n                                (let [recs (response-records)\n                                      response (get recs 0)\n                                      diag (get recs 1)]\n                                  (assoc (assoc (assoc (assoc {} :php/out out)\n                                                       :php/diag diag)\n                                                :php/uncaught\n                                                (if (= exc :php/null) nil (php/snapshot-exc exc)))\n                                         :php/response response)))))\n                 fatal (fn [message] (assoc (result :php/null) :php/fatal message))\n                 v (php/call-terminal\n                     (fn [fesc]\n                       (do (cell/set! php.rt/fatal-escape fesc)\n                           (php/call-terminal\n                             (fn [eesc]\n                               (do (cell/set! php.rt/exit-escape eesc)\n                                   (let [exc0 (php/try (fn []\n                                                         (do (let [resolved (php/resolve-request request)]\n                                                               (if (if (nil? resolved) true (= resolved :php/null))\n                                                                 :php/null\n                                                                 (php/bind-request! resolved)))\n                                                             (body) :php/null))\n                                                       (fn [e] e)\n                                                       (fn [] :php/null))]\n                                     (if (= true (get exc0 :php/operational))\n                                       (fesc (assoc (assoc (assoc {} :php/terminal :fatal)\n                                                           :php/operational true)\n                                                    :message (get exc0 :message)))\n                                       (php/pair :normal exc0)))))))))]\n             (if (= (get v :php/terminal) :fatal)\n               (fatal (get v :message))\n               (let [guest? (= (get v :php/terminal) :guest-fatal)\n                     ex (cell/get php.rt/exit-status)\n                     exc0 (if (if (= (get v :php/terminal) :exit) true guest?) :php/null (get v 1))\n                     exc1 (if (= ex :php/null) (php/handle-uncaught exc0) :php/null)\n                     s (php/call-terminal\n                         (fn [sesc]\n                           (do (cell/set! php.rt/shutdown-escape sesc)\n                               (cell/set! php.rt/in-shutdown true)\n                               (let [exc2 (php/try (fn [] (do (php/shutdown!) :php/null))\n                                                   (fn [e] e)\n                                                   (fn [] :php/null))]\n                                 (if (= true (get exc2 :php/operational))\n                                   (php/root-fatal (get exc2 :message))\n                                   (php/pair :normal exc2))))))\n                     ;; the drain of unclosed buffers, outside the shutdown\n                     ;; escape: an exit during shutdown aborts the sequence\n                     ;; past this point, so the drain must run here, on every\n                     ;; path that reaches the exit status; the operational\n                     ;; fatal escapes past everything and never reaches here\n                     ex2 (do (php/drain-buffers!) (cell/get php.rt/exit-status))\n                     st (if (= ex2 :php/null) ex ex2)\n                     ;; a guest fatal always answers status 255, even when it\n                     ;; escaped through the shutdown continuation past the\n                     ;; exit-status cell (PHP main.c: the fatal status)\n                     st (if (if (= st :php/null)\n                              (if (= guest? true) true (= (get s :php/terminal) :guest-fatal))\n                              false)\n                          255\n                          st)\n                     exc2 (if (if (= (get s :php/terminal) :exit) true (= (get s :php/terminal) :guest-fatal)) :php/null (get s 1))\n                     e (if (= exc1 :php/null) exc2 exc1)\n                     ;; an uncaught guest throwable terminates the script with\n                     ;; status 255 (php main.c: uncaught Error/Exception exit)\n                     st (if (= st :php/null) (if (= e :php/null) st 255) st)\n                     r (result (if (= e :php/null) :php/null e))\n                     r2 (if (= st :php/null) r (assoc r :php/status st))\n                     gmsg (if (= guest? true) (get v :message)\n","exit_code":0,"status":"completed"}}
