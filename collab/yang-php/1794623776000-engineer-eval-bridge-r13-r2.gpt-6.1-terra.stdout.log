ull) \\\"global scope\\\" (data/str-concat \\\"scope \\\" ctx)))]\\n    [php/vis-word (fn [vis] (if (= vis :private) \\\"private\\\" (if (= vis :protected) \\\"protected\\\" \\\"public\\\")))]\\n    [php/prop-find\\n     ;; {:kind :ok | :denied | :none :entry e} for property `name` of class `c`\\n     ;; seen from `ctx`\\n     (fn [c name ctx]\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'eval.*(service|publication|coordinator)|guest-fatal' test/yang/php | head -100\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'eval.*(service|publication|coordinator)|guest-fatal' test/yang/php | head -100\\\"\",\"aggregated_output\":\"test/yang/php/antlr/eval_coordinator_test.clj:1:(ns yang.php.antlr.eval-coordinator-test\\ntest/yang/php/antlr/eval_coordinator_test.clj:6:            [yang.php.antlr.eval-coordinator :as coordinator]))\\ntest/yang/php/antlr/eval_publication_test.clj:1:(ns yang.php.antlr.eval-publication-test\\ntest/yang/php/antlr/eval_publication_test.clj:7:            [yang.php.antlr.eval-coordinator :as coordinator]\\ntest/yang/php/antlr/eval_publication_test.clj:8:            [yang.php.antlr.eval-publication :as publication]\\ntest/yang/php/antlr/eval_service_test.clj:1:(ns yang.php.antlr.eval-service-test\\ntest/yang/php/antlr/eval_service_test.clj:6:            [yang.php.antlr.eval-coordinator :as coordinator]\\ntest/yang/php/antlr/e2e_harness.clj:10:    [yang.php.antlr.eval-coordinator :as eval-coordinator]\\ntest/yang/php/antlr/e2e_harness.clj:36:   The composition drives `eval-coordinator/serve` with the returned state.\\\"\\ntest/yang/php/antlr/e2e_harness.clj:42:     {:worker (eval-coordinator/make-worker), :store (:store published),\\ntest/yang/php/antlr/eval_transport_test