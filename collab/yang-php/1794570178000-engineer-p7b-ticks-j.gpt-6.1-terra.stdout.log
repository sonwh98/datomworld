ement\\\\\\\" (lower-unset ctx n (core/rules ctx (first (core/rules ctx n \\\\\\\"chainList\\\\\\\")) \\\\\\\"chain\\\\\\\"))\\\\n    \\\\\\\"functionDeclaration\\\\\\\" (lower-function ctx n)\\\\n    \\\\\\\"constant\\\\\\\" (lower-constant ctx n)\\\\n    \\\\\\\"arrayCreation\\\\\\\" (lower-array ctx n)\\\\n    (\\\\\\\"classDeclaration\\\\\\\" \\\\\\\"enumDeclaration\\\\\\\") (lower-class ctx n)\\\\n    \\\\\\\"declareStatement\\\\\\\" (lower-declare ctx n)\\\\n    (core/default-arm diagnostic-ns \\\\\\\"PHP\\\\\\\" unsupported-rules n)))\\\\n\\\\n\\\\n;; =============================================================================\\\\n;; Packets\\\\n;; =============================================================================\\\\n\\\\n(defn- hoisted?\\\\n  \\\\\\\"True for a top-level statement that is an unconditional function\\\\n   declaration: PHP declares it before the unit's first statement runs.\\\\\\\"\\\\n  [ctx item]\\\\n  (p/rule? (rule-head ctx item) \\\\\\\"functionDeclaration\\\\\\\"))\\\\n\\\\n\\\\n(defn- declared-functions\\\\n  \\\\\\\"Every function the unit declares: lower-cased fully qualified name to the\\\\n   vector of its by-reference parameter positions.\\\\\\\"\\\\n  [ctx]\\\\n\\\\n(defn- class-item?\\\\n  [ctx item]\\\\n  (contains? #{\\\\\\\"classDeclaration\\\\\\\" \\\\\\\"enumDeclaration\\\\\\\"} (:rule (rule-head ctx item))))\\\\n\\\\n\\\\n(defn- unit-body\\\\n  \\\\\\\"The unit's statements as one node, hoisted function declarations first,\\\\n   then the classes that can be declared at that point (PHP hoists a class\\\\n   whose parent, interfaces and traits already exist); a hoisted class is\\\\n   skipped when execution reaches it.\\\\\\\"\\\\n  [ctx]\\\\n  (let [items (:items ctx)\\\\n        hoisted (filterv #(hoisted? ctx %) items)\\\\n        classes (mapv (fn [item]\\\\n                        (let [c (rule-head ctx item)\\\\n                              [_ spec] (class-spec (item-ctx ctx item) c)]\\\\n                          [(:id item) (symbol (str \\\\\\\"%class-\\\\\\\" (:id c))) spec]))\\\\n                      (filter #(class-item? ctx %) items))\\\\n        syms (into {} (map (fn [[id sym _]] [id sym])) classes)\\\\n        in-place (fn [item]\\\\n                   (if-let [sym (get syms (:id item))]\\\\n                     (app* 'php/declare-late! (u/v sym))\\\\n                     (lower (item-ctx ctx item) item)))]\\\\n    (check-hoisted! ctx hoisted)\\\\n    (let [body (sequence-node\\\\n                 (concat (mapv #(lower (item-ctx ctx %) %) hoisted)\\\\n                         (mapv (fn [[_ sym _]] (app* 'php/hoist-class! (u/v sym))) classes)\\\\n                         (mapv in-place (remove #(hoisted? ctx %) items))))]\\\\n      (reduce (fn [inner [_ sym spec]] (u/let1 sym (u/lam [] spec) inner))\\\\n              body\\\\n              (reverse classes)))))\\\\n\\\\n\\\\n(defn- unit-returns?\\\\n  \\\\\\\"True when the unit holds a top-level `return` (outside functions and\\\\n   classes), which needs the escape around its body.\\\\\\\"\\\\n  [ctx]\\\\n  (core/contains-rule? ctx\\\\n                       (p/root (:pk ctx))\\\\n                       \\\\\\\"returnStatement\\\\\\\"\\\\n                       #{\\\\\\\"functionDeclaration\\\\\\\" \\\\\\\"lambdaFunctionExpr\\\\\\\" \\\\\\\"classDeclaration\\\\\\\"\\\\n                         \\\\\\\"enumDeclaration\\\\\\\"}))\\\\n\\\\n\\\\n(defn- unit-node\\\\n  \\\\\\\"`unit-body`, inside the `return` escape when the unit has a top-level\\\\n   `return`: the escape answers its value, the sentinel `:php/no-return`\\\\n   when the body falls off its end (plan P6 R4). An included unit's body\\\\n   (`module?`) always answers the sentinel at its end; the entry unit's\\\\n   value is dropped, so its tree is unchanged when it has no `return`.\\\\\\\"\\\\n  ([ctx] (unit-node ctx false))\\\\n  ([ctx module?]\\\\n   (cond\\\\n     (unit-returns? ctx)\\\\n     (app* 'php/call-ec\\\\n           (u/lam ['%ret] (u/then (unit-body (assoc ctx :ret '%ret)) (u/lit :php/no-return))))\\\\n     module? (u/then (unit-body ctx) (u/lit :php/no-return))\\\\n     :else (unit-body ctx))))\\\\n\\\\n\\\\n(defn lower-module-body\\\\n  \\\\\\\"The unit's statements as one node, before the runtime wrapper: what\\\\n   lowering goldens compare. Hoisted function declarations come first.\\\\\\\"\\\\n  [packet]\\\\n  (unit-body (context packet)))\\\\n\\\\n\\\\n(def option-keys\\\\n  \\\\\\\"The options `lower-program` and the lowering stage accept. Request data\\\\n   never flows here: the harness attaches the composition-supplied request\\\\n   stream and composes its sealed reference as `run-main`'s second operand\\\\n   (`:request-node`, an opaque UAST node) at the composition level — the\\\\n   record itself reaches the runtime only when `run-main` consumes it.\\\\\\\"\\\\n  [:prelude :path :paths :class-map :request-node :response-node :diag-node])\\\\n\\\\n\\\\n(defn- path-map-node\\\\n  \\\\\\\"`(php/bind-path-map! {path thunk ...})` for the composition's published\\\\n   paths (plan P6 R3): the computed include's lookup table.\\\\\\\"\\\\n  [paths]\\\\n  (app* 'php/bind-path-map!\\\\n        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\\\\n                (u/lit {})\\\\n                (sort paths))))\\\\n\\\\n\\\\n(defn lower-program\\\\n  \\\\\\\"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\\\\n   `php/run-main` after the prelude, tail calls marked. Its value is\\\\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\\\\n   `:warnings` are the lowering's warning-severity diagnostics\\\\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\\\\n   `:yang.php/computed-include-path`).\\\\n\\\\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\\\\n   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\\\\n   need); `:path` the entry unit's declared path (default `entry-path`);\\\\n   `:paths` the normalized paths whose units the composition published,\\\\n   which a computed include resolves against; `:class-map` true requires\\\\n   the published `phpm.$classmap` and binds its classes and delivery thunks\\\\n   (plan P6 R9), which takes the place of `:paths`; `:request-node` is the\\\\n  opaque `run-main` second-operand node the harness composed from the\\\\n  attached request stream (lowering never embeds request data — `run-main`\\\\n  consumes the record from the stream at runtime);\\\\n  `:response-node` and `:diag-node` are the opaque third and fourth\\\\n  operands: the composition-supplied stream references execution emits\\\\n  on. Absent, `run-main` runs with two operands and the cells\\\\n  accumulate.\\\\\\\"\\\\n  ([packet] (lower-program packet {}))\\\\n  ([packet {:keys [prelude paths path class-map request-node response-node diag-node],\\\\n            :or {prelude :bundled}}]\\\\n   (when-not (contains? #{:bundled :linked} prelude)\\\\n     (throw (ex-info \\\\\\\"unknown PHP prelude profile\\\\\\\"\\\\n                     {:yang.php/diagnostic :yang.php/unsupported,\\\\n                      :construct :prelude,\\\\n                      :prelude prelude})))\\\\n   (let [linked? (= :linked prelude)\\\\n         request-node (or request-node (u/sexp->uast :php/null))\\\\n         ctx (context packet {:path (or path entry-path), :linked? linked?})\\\\n         ;; `run-main`'s second operand arrives composed by the harness from\\\\n         ;; the attached request stream: production initialization consumes\\\\n         ;; the record from the stream at runtime and seeds the superglobals,\\\\n         ;; no postwalk rewrite and no request data through lowering involved.\\\\n         ;; With stream nodes `run-main` takes four operands (request,\\\\n         ;; response and diagnostics references); without them it takes two\\\\n         ;; and the cells accumulate.\\\\n         main (if (or response-node diag-node)\\\\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\\\\n                      (or response-node (u/sexp->uast :php/null))\\\\n                      (or diag-node (u/sexp->uast :php/null)))\\\\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))]\\\\n     {:ast (u/mark-tails\\\\n             (if linked?\\\\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\\\\n                                     (app* 'require (u/lit prelude/module-name))\\\\n                                     (app* 'php/init!)]\\\\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\\\\n                                    (when class-map\\\\n                                      [(app* 'require (u/lit classmap-module))\\\\n                                       (app* 'php/bind-class-map!\\\\n                                             (u/v (symbol (str classmap-module) \\\\\\\"classes\\\\\\\"))\\\\n                                             (u/v (symbol (str classmap-module) \\\\\\\"paths\\\\\\\")))])\\\\n                                    [main]))\\\\n               (u/then prelude/uast main))),\\\\n      :warnings @(:warnings ctx)})))\\\\n\\\\n\\\\n(defn lower-packet\\\\n  \\\\\\\"The complete program for one ok packet (`lower-program`'s `:ast`).\\\\\\\"\\\\n  ([packet] (lower-packet packet {}))\\\\n  ([packet opts] (:ast (lower-program packet opts))))\\\\n\\\\n\\\\n;; =============================================================================\\\\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\\\\n;; =============================================================================\\\\n\\\\n(def module-exports\\\\n  \\\\\\\"The exports of a compiled PHP unit: its spec and body, immutable after\\\\n   install.\\\\\\\"\\\\n  '#{spec body})\\\\n\\\\n\\\\n(defn imported-unit-names\\\\n  \\\\\\\"The normalized paths the unit statically includes through folded literal\\\\n   paths, source order, distinct, the unit's own path aside. A computed path\\\\n   contributes nothing: it is by name at run time (plan P6 R3). A path that\\\\n   cannot normalize is refused as `lower-include` refuses it.\\\\\\\"\\\\n  [packet {:keys [path], :or {path entry-path}}]\\\\n  (let [ctx (context packet {:path path, :linked? true})]\\\\n(ns yang.php.antlr.e2e-harness\\\\n  \\\\\\\"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\\\\n   program envelope -> the bundled program on each of the four VMs. Output\\\\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\\\n   here at the boundary.\\\\\\\"\\\\n  (:require\\\\n    [dao.host.text :as text]\\\\n    [dao.stream :as stream]\\\\n    [yang.php.antlr.cst :as cst]\\\\n    [yang.php.antlr.lower :as lower]\\\\n    [yang.php.antlr.portable-harness :as portable]\\\\n    [yang.php.antlr.safepoint :as hooks]\\\\n    [yang.core.uast :as u]\\\\n    [yang.safepoint :as safepoint]\\\\n    [yin.vm :as vm]\\\\n    [yin.vm.debruijn.register :as rvm]\\\\n    [yin.vm.debruijn.stack :as dvm]\\\\n    [yin.vm.encoder :as encoder]\\\\n    [yin.vm.semantic :as semantic]\\\\n    [yin.vm.semantic.derive :as derive]\\\\n    [yin.vm.semantic.linearize :as sr-linearize]\\\\n    [yin.vm.test-utils :as tu]))\\\\n\\\\n\\\\n(defn host-registry\\\\n  \\\\\\\"The registry the PHP compositions run over.\\\\\\\"\\\\n  []\\\\n  (portable/host-registry))\\\\n\\\\n\\\\n(def ^:private base-opts\\\\n  {:make-stream tu/make-stream,\\\\n   :capability-secret tu/secret,\\\\n   :primitives vm/primitives})\\\\n\\\\n\\\\n(def ^:private load-semantic\\\\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\\\n\\\\n\\\\n(defn request-node\\\\n  \\\\\\\"The `run-main` second-operand node the composition supplies for `request`:\\\\n   the harness converts the record to UAST itself — lowering never embeds\\\\n   request data.\\\\\\\"\\\\n  [request]\\\\n  (u/sexp->uast (or request :php/null)))\\\\n\\\\n\\\\n(defn lower-program\\\\n  \\\\\\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\\\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\\\n  The request record travels the composition path: the harness consumes it\\\\n  (a plain record here) and composes it as `run-main`'s second operand —\\\\n  lowering itself never sees request data.\\\\\\\"\\\\n  ([source] (lower-program source nil))\\\\n  ([source request]\\\\n   (let [cst-log (tu/new-memory-log)\\\\n         program (tu/new-memory-log)\\\\n         diagnostics (tu/new-memory-log)]\\\\n     (stream/append! cst-log (cst/parse-source source))\\\\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\\\\n                                         (cond-> {:medium lower/program-medium}\\\\n                                           (some? request) (assoc :request-node\\\\n                                                                  (request-node request)))))\\\\n     (let [{warnings true, problems false}\\\\n           (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\\\n       (if (seq problems)\\\\n         {:diagnostics problems}\\\\n         (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\\\n           {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)}))))))\\\\n\\\\n\\\\n(defn packet->form\\\\n  \\\\\\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\\\n   rule, `[\\\\\\\\\\\\\\\"TYPE\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\"]` for a token. The inverse of\\\\n   `portable-harness/packet`.\\\\\\\"\\\\n  [{:yang.cst/keys [root nodes]}]\\\\n  (letfn [(form\\\\n            [id]\\\\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\\\\n              (if (= :token kind)\\\\n                [type text]\\\\n                (into [(keyword rule)] (map form) children))))]\\\\n    (form root)))\\\\n\\\\n\\\\n(defn latin1->text\\\\n  \\\\\\\"The UTF-8 text of the byte carrier `s`.\\\\\\\"\\\\n  [s]\\\\n  (text/utf8-decode (.getBytes ^String s \\\\\\\"ISO-8859-1\\\\\\\")))\\\\n\\\\n\\\\n(defn render\\\\n  \\\\\\\"The text a unit prints: its output, then, for an uncaught error, the\\\\n   fatal line (no path, plan section 3.9).\\\\\\\"\\\\n  [{:php/keys [out uncaught fatal]}]\\\\n  (str (latin1->text out)\\\\n       (when uncaught\\\\n         (str \\\\\\\"PHP Fatal error:  Uncaught \\\\\\\" (:class uncaught) \\\\\\\": \\\\\\\" (:message uncaught)))\\\\n       (when fatal\\\\n         (str \\\\\\\"PHP Fatal error:  \\\\\\\" fatal))))\\\\n\\\\n\\\\n(defn run-vms\\\\n  \\\\\\\"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\\\\n   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\\\\n   and starts one per-run counter; no option leaves the AST unchanged.\\\\\\\"\\\\n  ([registry ast] (run-vms registry ast {}))\\\\n  ([registry ast {:keys [execution-budget envelope]}]\\\\n   (let [ast (if (some? execution-budget)\\\\n               (let [projected (encoder/project envelope)\\\\n                     derived (:envelope (safepoint/derive-envelope\\\\n                                          projected hooks/profile :test/derived))\\\\n                     tree (nth (:yin/batch derived) (:yin/root derived))]\\\\n                 (hooks/program execution-budget\\\\n                                (vm/semantic-bytecode->ast tree)))\\\\n               ast)\\\\n         opts (assoc base-opts :modules registry)\\\\n         session (tu/make-observer-session (tu/create-vm {:modules registry}))\\\\n         datoms (vec (vm/ast->datoms ast))\\\\n         projected #(:vector (sr-linearize/project ast))\\\\n         attempt (fn [f]\\\\n                   (try (render (f))\\\\n                        (catch Exception e [:thrown (ex-message e)])))]\\\\n     (tu/queue-ast! session ast)\\\\n     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\\\\n      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\\\\n                                                           datoms)))),\\\\n      :stack (attempt #(vm/value (vm/run (dvm/create-vm\\\\n                                           (:image (derive/stack-image (projected)))\\\\n                                           (assoc opts :contract vm/stack-contract))))),\\\\n      :register (attempt #(vm/value (vm/run (rvm/create-vm\\\\n                                              (derive/register-image (projected))\\\\n                                              (assoc opts\\\\n                                                     :contract\\\\n                                                     vm/register-contract)))))})))\\\\n\\\\n\\\\n(defn run-php\\\\n  \\\\\\\"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\\\\n   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\\\\\\\"\\\\n  ([source] (run-php source {}))\\\\n  ([source options]\\\\n   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\\\\n     (if diagnostics\\\\n       {:diagnostics diagnostics}\\\\n       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\\\\n\\\\n\\\\n(defn run-walker\\\\n  \\\\\\\"The ast-walker's rendering of `source` alone (fast iteration).\\\\\\\"\\\\n  [source]\\\\n  (let [{:keys [ast diagnostics]} (lower-program source)]\\\\n    (if diagnostics\\\\n      {:diagnostics diagnostics}\\\\n      (let [registry (host-registry)\\\\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\\\\n        (tu/queue-ast! session ast)\\\\n        (try (render (vm/value (:consumer (tu/run-session session))))\\\\n             (catch Exception e [:thrown (ex-message e)]))))))\\\\n\\\\n\\\\n(defn run-raw\\\\n  \\\\\\\"The unit's value on the AST walker, consuming an optional request record\\\\n  through the production channel: the harne