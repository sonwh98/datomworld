; the distinct root exit continuation: an exit during shutdown only\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:798:     ;; records its status and aborts the shutdown sequence\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:801:           (let [esc (if (= (cell/get php.rt/in-shutdown) true)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:802:                       (cell/get php.rt/shutdown-escape)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:828:     ;; run-main still runs shutdown functions, drains buffers and marks\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:831:     ;; existing object counts destructed before the ordinary shutdown\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:838:             (if (= (cell/get php.rt/in-shutdown) true)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:839:               (let [sesc (cell/get php.rt/shutdown-escape)]\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:855:     ;; body while shutdown still runs.\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4364:    ;; ---- finalization (rows 48 to 51), clone (row 52), shutdown (row 22)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4421:    [php/shutdown-pass\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4433:               (php/shutdown-pass order (- i 1))))))]\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4434:    [php/shutdown-globals\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4437:         (do (php/shutdown-pass (get (cell/get php.rt/globals) :order) (- before 1))\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4440:               (php/shutdown-globals)))))]\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4441:    [php/shutdown-finalizable\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4450:               (php/shutdown-finalizable objs (+ i 1))))\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4452:    [php/run-shutdown-fns\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4455:       (let [fns (cell/get php.rt/shutdown-fns)]\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4458:               (php/run-shutdown-fns (+ i 1)))\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4463:    [php/bi-register-shutdown-function\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4465:       (do (cell/set! php.rt/shutdown-fns\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4466:                      (php/vconj (cell/get php.rt/shutdown-fns)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4502:    [php/shutdown!\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4503:     ;; row 22: shutdown functions, the destructor phase, then the release\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4506:     ;; shutdown escape, so an exit during shutdown keeps buffered output;\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4509:       (do (php/run-shutdown-fns 0)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4510:           (php/shutdown-globals)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:4511:           (php/shutdown-finalizable (cell/get php.rt/finalizable) 0)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:5806:     ;; and its status is preserved through shutdown\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:5824:           (cell/set! php.rt/in-shutdown false)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:5827:           (cell/set! php.rt/shutdown-escape :php/null)\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:5832:                   ;; runs at the end of the run, after shutdown), else the\\\\nsrc/cljc/yang/php/antlr/prelude.cljc:5894:                           (do (cell/set! php.rt/shutdown-escape sesc)\\\\n-rw-r--r--@ 1 sto  staff  156005 Nov 13 18:12 collab/yang-php/1794568287000-engineer-p7b-ticks-e.gpt-6.1-terra.stdout.log\\\\n-rw-r--r--@ 1 sto  staff    2214 Nov 13 18:11 collab/yang-php/1794568287000-engineer-p7b-ticks-e.prompt.md\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_13\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"time clojure -M:test -e \\\\\\\\\\\\\\\"(require 'yang.php.antlr.ticks-test)(clojure.test/test-vars [#'yang.php.antlr.ticks-test/tick-fixtures-test])\\\\\\\\\\\\\\\"\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n      (get profile kind) (assoc :enter (entry-hook (get profile kind) mark))\\n      (and (map? (get profile kind)) (:sequence (get profile kind)))\\n      (assoc :sequence? true)\\n      (and (map? (get profile kind)) (:after (get profile kind)))\\n      (assoc :after? true)\\n      exit (assoc :exit (entry-hook exit mark)))))\\n\\n\\n(defn- hook-application\\n  [{:keys [hook operands]} args]\\n  {:type :application,\\n   :operator {:type :variable, :name hook},\\n   :operands (into (mapv (fn [x] {:type :literal, :value x}) operands) args)})\\n\\n\\n(defn- sequence-hook\\n  \\\"`node` evaluated after `hook` is applied.\\\"\\n  [node hook]\\n  {:type :application,\\n   :operator {:type :lambda, :params [binder], :body node},\\n   :operands [(hook-application hook [])]})\\n\\n\\n(defn- after-hook\\n  [node hook]\\n  {:type :application,\\n   :operator {:type :lambda, :params [result-binder],\\n              :body (sequence-hook {:type :variable, :name result-binder} hook)},\\n   :operands [node]})\\n\\n\\n(defn- prefix-hook\\n  \\\"Lambda `node` with `hook` applied before its body runs.\\\"\\n  [node hook]\\n  (assoc node\\n         :body (sequence-hook (:body node) hook)))\\n\\n\\n(defn- wrap-hook\\n  \\\"Lambda `node` with `hook` applied to its body's value.\\\"\\n  [node hook]\\n  (assoc node :body (hook-application hook [(:body node)])))\\n\\n\\n(defn- rewrite\\n  \\\"The map AST `ast` with each `{path {:enter h :exit h}}` site's exit hook\\n   wrapped around its body and its entry hook prefixed. Throws when a site\\n   names no node, or a node that is not a lambda.\\\"\\n  [ast hooks]\\n  (let [seen (volatile! #{})]\\n    (letfn [(walk\\n    [clojure.string :as str]\\n    [clojure.walk :as walk]\\n    [yang.core.prelude :as core]\\n    [yang.core.call :as call]\\n    [yang.core.uast :as u]\\n    [yang.php.antlr.builtins :as builtins]\\n    [yang.php.antlr.prelude-module :as module-defs]\\n    [yang.php.antlr.prelude-p9 :as p9-defs]\\n    [yang.php.antlr.quoted :refer [defquoted]]\\n    [yin.vm.integer :as integer]))\\n\\n\\n(def host-names\\n  \\\"Module exports the prelude calls. The two `dsg__` doors are the VM\\n   provenance primitive's reserved mint and reader (yin.vm.module: guest\\n   code may neither spell nor construct their names); the php module\\n   declares them the way python's adoption did — §8.10.7 wrapper retention\\n   mints and authenticates through them, never through prelude code.\\\"\\n  (into '#{cell/new cell/get cell/set! cell/dsg__new-provenance cell/dsg__provenance\\n           data/count data/nth data/subvec data/str-concat\\n           data/str-length data/str-join data/str-compare data/str->code-points\\n           data/code-points->str data/substring data/float64 data/float-value\\n           data/content= data/dissoc data/into\\n           integer/integer? integer/add integer/sub integer/neg integer/mul integer/compare\\n           integer/to-float integer/compare-float integer/true-div integer/pow\\n           integer/shift-left integer/shift-right integer/bit-and integer/bit-or\\n           integer/bit-xor integer/bit-not integer/from-float integer/quot-rem\\n           integer/floor-div-mod integer/format integer/parse\\n           integer/float-digits integer/decimal->float\\n           stream/put! stream/cursor stream/poll!}\\n        call/host-names))\\n\\n\\n(defquoted ^:private core-definitions\\n  \\\"Pure definitions: lambdas only, so defining them runs nothing.\\\"\\n  '[;; ---------------------------------------------------------------- basics\\n    [php/vconj (fn [xs x] (conj xs x))]\\n    [php/pair (fn [a b] (php/vconj (php/vconj [] a) b))]\\n    [php/f (fn [h] (data/float64 h))]\\n    [php/h (fn [x] (data/float-value x))]\\n    [php/inf (fn [] (data/float-value ##Inf))]\\n    [php/nan (fn [] (- (php/inf) (php/inf)))]\\n    [php/nan? (fn [h] (not (<= h h)))]\\n    [php/zero-h (fn [] (data/float-value 0))]\\n    ;; -0.0 is built as (* -1.0 0.0): ClojureDart compiles one-argument `-`\\n    ;; to (0 - x), and 0 - 0.0 is +0.0\\n               (php/shutdown-finalizable objs (+ i 1))))\\n         :php/null))]\\n    [php/run-shutdown-fns\\n     ;; callbacks in registration order; one may register more\\n     (fn [i]\\n       (let [fns (cell/get php.rt/shutdown-fns)]\\n         (if (< i (data/count fns))\\n           (do (php/call-value (get (get fns i) 0) (get (get fns i) 1))\\n               (php/run-shutdown-fns (+ i 1)))\\n           :php/null)))]\\n    [php/args-tail\\n     (fn [args i acc]\\n       (if (< i (data/count args)) (php/args-tail args (+ i 1) (php/vconj acc (get args i))) acc))]\\n    [php/bi-register-shutdown-function\\n     (fn [args]\\n       (do (cell/set! php.rt/shutdown-fns\\n                      (php/vconj (cell/get php.rt/shutdown-fns)\\n                                 (php/pair (get args 0) (php/args-tail args 1 []))))\\n           :php/null))]\\n    [php/freeze-finalizable\\n     ;; step 4 frees without destructors: whatever is left counts as destructed\\n     (fn [objs i]\\n       (if (< i (data/count objs))\\n         (do (cell/set! (get (get objs i) :php/obj) (assoc (php/obj-state (get objs i)) :destructed? true))\\n             (php/freeze-finalizable objs (+ i 1)))\\n         :php/null))]\\nsrc/cljc/yang/php/antlr/builtins.cljc:50:                   \\\"register_shutdown_function\\\" 'php/bi-register-shutdown-function,\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569052000-engineer-p7b-ticks-g.gpt-6.1-terra.stdout.log:9:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"ls collab/yang-php | rg 'ticks-f|1794568768|1794567519'; cat collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.findings.md; git status --short --branch\\\"\",\"aggregated_output\":\"1794568493000-engineer-p7b-ticks-f.gpt-6.1-terra.stdout.log\\n1794568493000-engineer-p7b-ticks-f.prompt.md\\n1794568960000-engineer-p7b-ticks-f.gpt-6.1-terra.findings.md\\nCompleted-GMT: 2026-11-13 11:04:20 GMT\\nCompleted-Local: 2026-11-13 18:04:20 +0700\\nCoding-Agent: codex\\nRole: Architect, slice-3 design consult\\nReviewed checkout: p7b-ticks @ 38375bf7\\nStatus: counter ruling complete; implementation and formal corpus acceptance remain outstanding\\n\\n**Ruling: one counter per PHP request, with the threshold supplied by each selected statement-completion hook.** There is no counter per declare occurrence, source file, function/op_array, closure, or generator. Lexical scope controls which completion sites exist and their thresholds; it does not partition the runtime count.\\n\\nThis is supported both by PHP-8.3 source inspection and direct execution of 21 small programs on shiva's PHP 8.3.35 oracle image. All five staged expectations match. This consult changes only this findings artifact: no source, test, design-document, fixture-provenance, or branch changes; no commit or push.\\n\\n**Findings and reconciliation**\\n\\n| Severity | Location | Evidence / required correction |\\n|---|---|---|\\n| P1 — contradictory implementation instruction | `collab/yang-php/1794567390000-engineer-p7b-ticks-c.prompt.md:20` | The explicit “a count is per declare-site, PHP semantics” instruction is incorrect. Replace it with the request-owned counter rule in this ruling. Part C was right to escalate the conflict instead of claiming parity. |\\n| Resolved — slice-3 ownership | `collab/orch-lane/1794700000000-architect-safepoint-slice3-design.gpt-6.1-sol.findings.md:103` | The text explicitly says “request-owned counter” and says state survives calls, includes, and generator switches. Its lifecycle table at lines 123–127 and implementation assignment at line 257 reinforce that contract. The implementer's request-wide reading is correct. |\\n| P2 — stale design status/timing | `docs/design/yang.php.md:1938` | §12 still says sites are before statements and the generic extension refuses non-lambdas. The implemented after-wrapper is at `src/cljc/yang/safepoint.cljc:153`; PHP's profile is at `src/cljc/yang/php/antlr/safepoint.cljc:13`. Reconcile §12 in the implementation round. |\\n| P1 — acceptance does not discriminate ownership | `test/yang/php/antlr/programs_p7b.cljc:10` | Every staged tick threshold is 1. All these outputs can pass with an incorrectly partitioned counter. Add N>1 boundary/threshold cases below before claiming counter parity. |\\n| P2 — oracle exit status is insufficient for pending rows | `src/dev/yang/php/oracle.clj:558` | Pending rows are excluded from failures, while `check-p7-fixture` at line 492 deliberately leaves their `:pass?` false. Read and compare actual records; exit 0 / “failures: 0” alone proves no parity for these rows. |\\n\\nI own the reconciliation failure between the design, stale documentation, and implementation brief. The slice-3 counter paragraph itself was explicit, not ambiguous. Its omission of a compact lexical-versus-runtime decision table made the broader artifact set easier to misread. At this checkout, neither §12 nor the §15 P7-b row (`yang.php.md:2106`) actually specifies a per-declare counter; §15 requires PHP-equivalent tick counts. File-scoped compilation does not imply file-owned execution state.\\n\\n**PHP 8.3 source evidence**\\n\\nThe links below refer to the PHP-8.3 branch inspected for this consult; line numbers are ordinary one-based file lines. They are source references, not a claim that the moving branch is the exact source hash of the oracle image.\\n\\n- [Zend/zend_globals.h:187](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_globals.h#L187): `ticks_count` is a field of executor globals.\\n- [Zend/zend_execute_API.c:151](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute_API.c#L151): `init_executor()` initializes it to zero for execution/request startup.\\n- [Zend/zend_execute.c:5153](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute.c#L5153) includes generated `zend_vm_execute.h`. The tick handler's maintained definition is [Zend/zend_vm_def.h:7439–7452](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7439). Its test is `(uint32_t)++EG(ticks_count) >= opline->extended_value`; it resets the count before calling the tick dispatcher. It counts even when no dispatcher is installed. This is an executor-global accumulator and an instruction-local threshold, not op_array-local state.\\n- Compiler mechanism: [Zend/zend_compile.c:344–361](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L344) initializes a new file's compile-time ticks setting to zero and restores the prior file context on exit. [Lines 5938–5994](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L5938) convert the directive literal to a long, update that setting, compile a block, and restore its prior setting; the semicolon form leaves it changed. [Lines 7065–7200](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L7065) switch function op_arrays without starting a fresh file context. [Lines 9784–9785](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9784) emit ticks after selected statements when the setting is nonzero. [Lines 2110–2121](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2110) place that setting in the instruction's extended operand and suppress adjacent duplicate tick emission. [Lines 2518–2522](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2518) enumerate excluded statement categories; [lines 9659–9668](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9659) separately handle top-level function/class declarations. A blanket “hook every AST statement” translation is insufficient.\\n- [Zend/zend_vm_def.h:7867–7874](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7867): yield saves the next instruction and returns. [Zend/zend_generators.c:706–828](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_generators.c#L706) restores execution frames/JIT context around resume, not a saved tick count.\\n- [ext/standard/basic_functions.c:1549–1569](https://github.com/php/php-src/blob/PHP-8.3/ext/standard/basic_functions.c#L1549): user tick dispatch guards each executing registered entry against reentry. Do not replace this with a global “ticks busy” rule that stops counting all guest tick sites. Registered callback arguments are its registration arguments, not the line/unit/threshold operands.\\n\\nThus switching files or op_arrays changes the instructions being executed, and possibly their embedded thresholds, without selecting a different counter. The runtime probes below independently confirm the relevant observable consequences.\\n\\n**Normative decision table for the implementer**\\n\\n| Concern | Required behavior |\\n|---|---|\\n| Counter owner | Allocate one explicit guest request-owned counter, initially 0, shared by all PHP tick hooks in that request. Keep it in existing guest execution/store machinery; introduce no host global or shared process state. |\\n| Increment and firing | On each selected normal completion, increment once. If the new count is **greater than or equal to** that site's N, reset to 0 **before** dispatching registered handlers. Do not use equality, modulo, subtraction of N, or a threshold-global “current N.” |\\n| Reset points | Request initialization and threshold firing only. No reset at declare entry/exit, function call/return, include/return, registration/unregistration, generator switch, or exception/context restoration. A new independent request starts from zero. |\\n| Empty registry | Continue incrementing/resetting at selected sites. Registration changes dispatch membership, not counter phase. Confirmed by the empty-registry probe. |\\n| Lexical N | Each mark carries its own effective compile-time N. An inner block directive overrides the enclosing value for its body; exiting that block restores the outer value for subsequent emitted sites. Entering/leaving either block does not reset the accumulated count. |\\n| N=0 | That lexical region contributes no tick instructions for its own statements; it does not clear accumulated progress. An enclosing nonzero context may still select the completion of the declare construct itself. |\\n| Directive syntax | Preserve block versus semicolon behavior and Zend's statement-selection/adjacent-suppression behavior. A directive can itself lead to a tick: the measured semicolon case below produces ATB, not ABT. There is no extra generic “enter declare” runtime reset or hook. |\\n| N validation/range | Ordinary positive integer thresholds and zero are the cases established here. Do not invent “all N<=0 disable ticks”: Zend's literal conversion and unsigned instruction operand are separate concerns. Broader literal/range acceptance needs its own oracle cases or an explicit supported-subset refusal. |\\n| Functions and closures | Retain body-site thresholds from compilation. A call from ticked code does not dynamically instrument an unticked body. A ticked body contributes to the same request count even when called from unticked code or after its defining include has returned. |\\n| Generator yield/resume | Preserve the pending after-hook in the continuation. Suspension itself does not complete the yield statement. On eventual normal completion run that hook once using the then-current request counter. Repeated inspection of a suspended value does not replay it. Never snapshot/restore the count with generator context. |\\n| Nonlocal exit | A statement whose normal completion is bypassed contributes no after-hook. Already completed sites retain their count effects through throw/unwind. A callback exception cannot undo the reset that preceded dispatch. A pending hook is not a finally hook. |\\n| Include/include_once | Included code has its own lexical sites/N; the caller's pragma is not inherited dynamically. All executed sites share the request counter. Repeated includes revisit their sites; a skipped once body contributes none. A selected caller include statement still completes and can tick even when the once body is skipped. |\\n| Budget/profile separation | Statement ticks do not charge `php.sp/tick`, the existing execution-budget hook. Preserve independently selected `:call`/`:loop` sites and the shared VM semantics. |\\n\\nThe intended profile and operand contract remains exactly:\\n\\n```clojure\\n{:line {:hook 'php.sp/line :operands true :after true}}\\n\\n[:line n {:unit unit-path :ticks N}]\\n;; derives:\\n(php.sp/line n {:unit unit-path :ticks N})\\n```\\n\\nHere `n` and `:unit` identify the source occurrence; neither is a counter key. `:ticks` is the effective instruction threshold, not a declaration identifier. The generic safepoint stage transports literals and performs value-preserving normal-completion placement; PHP lowering owns eligible-site selection and PHP runtime code owns counting/dispatch. Omitting `:line` from a derivation profile omits these hooks; canonical program rows remain unchanged.\\n\\n**Include-site handoff remains a landing requirement**\\n\\nThe source-unit operand does not itself transport marks through publication. At `src/cljc/yang/php/antlr/publication.cljc:42`, `:site-set` is still nil. Preserve slice-3 lines 133–154: publish and retrieve verified occurrence site sets bound to the canonical root/source association; derive included executable images using the selected ticks profile; pin the hook dependency and derived images; handle SCC bundles and repin member aliases. Missing required metadata must fail closed, whereas a verified empty set for an unticked unit is legitimate.\\n\\nEvery derived module must resolve the same request's hook/state. Including a module must not reinitialize the tick registry or accumulator. A retained closure keeps its defining unit's operands and uses the active request's shared counter. No extra counter indexed by declaration, unit, or line is needed.\\n\\n**Measured fixture evidence**\\n\\nExecuted on `shiva.stigmergy.systems`, 2026-11-13, in fresh disposable containers per program. Existing tag `php:8.3-cli` reports PHP 8.3.35 CLI NTS / Zend 4.3.35, built 2026-10-06. The shorter `php:8.3` tag was not installed; no image was pulled.\\n\\n- Image ID: `sha256:7855de8f54c32ffc92720b20b550f2dbc1c82c2000c7a850ccf350f71c36293f`\\n- Repository digest: `php@sha256:aafe21201943a8a6e497ddfb471e2ce68ada76adede38c7d61fede8918b24319`\\n\\nEach main program and included unit was placed in a temporary directory, mounted read-only at /w, with this invocation:\\n\\n```sh\\ndocker run --rm --pull=never --network=none --read-only \\\\\\n  -v <temporary-directory>:/w:ro -w /w php:8.3-cli php \\\\\\n  -d display_errors=1 -d html_errors=0 -d error_reporting=E_ALL \\\\\\n  -d log_errors=0 -d auto_prepend_file=/w/pre.php main.php\\n```\\n\\nThe unticked pre.php was the exact staged prologue:\\n\\n```php\\n<?php function tick_handler() { echo 'T'; } register_tick_function('tick_handler');\\n```\\n\\nThis matches the P7 oracle runner's prepend-unit arrangement. Every one of the 21 executions exited 0 with empty stderr and exactly the stdout recorded here, with no diagnostics. Temporary directories were removed. These are independent direct PHP oracle measurements, **not** a run of the Clojure `--p7` wrapper or of yang.php.\\n\\n| Fixture and source location | Staged expected | Measured PHP 8.3.35 | Interpretation |\\n|---|---|---|---|\\n| sequence, `programs_p7b.cljc:10` | ATTBT | ATTBT | Three completions: echo A, assignment, echo B. |\\n| loop-body, line 12 | ATAT | ATAT | Only the inner declared body is ticked; loop machinery is outside its directive. |\\n| function-call, line 14 | FT | FT | f's body is unticked; the call statement's normal completion ticks. |\\n| generator-resume, line 16 | ATBT | ATBT | current() suspends at yield; A prints; next() completes yield and ticks, then B completes and ticks. |\\n| include-handoff, line 19 | LT | LT | Included lib.php owns a ticked echo site; the caller is unticked. |\\n\\nThe sequence variants also confirm the slice-3 proposals: N=2 gives ATB; N=0 gives AB.\\n\\n**Oracle acceptance ruling**\\n\\nThere is no remaining choice between counter architectures: the source mechanism and the N>1 measurements settle it in favor of the request-owned count. PHP remains the authority for exact site selection and observable output if a lowering prediction disagrees.\\n\\nThe formal `--p7` pass on shiva MUST compare all five current IDs: `:sequence`, `:loop-body`, `:function-call`, `:generator-resume`, and `:include-handoff`, including output, absence of diagnostics/uncaught errors, and successful exit. Record actual version, image digest, host, and date. Do not infer a passing fixture from the current runner's pending-row exit status. This consult leaves all `:oracle :pending` fields untouched.\\n\\nFor counter-ownership acceptance, the implementer must add and oracle-confirm at least separate-declares, nested-threshold, cross-function, cross-include, and generator-shared from the appendix. Also retain the zero-gap, unticked-include, registration/empty-registry, retained-closure, exception, once-skip, and semicolon regressions. The original five N=1 rows cannot replace these discriminators. P7-b's remaining lowering/runtime/linking gates and the broader slice-3 callback/escape/cleanup cases remain required; this consult is not implementation sign-off.\\n\\n**Reproducible additional probes**\\n\\nEach source below is main.php after an opening PHP tag, with the same separate pre.php above. Where shown, lib.php is a separate file. Outputs are observations, not new hand-derived goldens.\\n\\n**sequence-n2 — measured `ATB`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\\n```\\n\\n**sequence-n0 — measured `AB`.**\\n\\n```php\\ndeclare(ticks=0) { echo 'A'; $x = 1; echo 'B'; }\\n```\\n\\n**separate-declares — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } declare(ticks=2) { echo 'B'; }\\n```\\n\\n**nested-threshold — measured `ABCTD`.**\\n\\n```php\\ndeclare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\n```\\n\\n**zero-gap — measured `ABCT`.**\\n\\n```php\\ndeclare(ticks=3) { echo 'A'; } declare(ticks=0) { echo 'B'; } declare(ticks=3) { echo 'C'; $x=1; }\\n```\\n\\n**cross-function — measured `AFT`.**\\n\\n```php\\nfunction f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\n```\\n\\n**repeat-function — measured `F|FT`.**\\n\\n```php\\nfunction f() { declare(ticks=2) { echo 'F'; } } f(); echo '|'; f();\\n```\\n\\n**cross-include — measured `ALT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } include 'lib.php';\\n```\\nlib.php:\\n```php\\n<?php declare(ticks=2) { echo 'L'; }\\n```\\n\\n**unticked-include — measured `ALTB`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; include 'lib.php'; echo 'B'; }\\n```\\nlib.php:\\n```php\\n<?php echo 'L';\\n```\\n\\n**generator-shared — measured `ABTC`.**\\n\\n```php\\nfunction g() { declare(ticks=2) { yield 1; } } $a=g(); $b=g(); $a->current(); $b->current(); echo 'A'; $a->next(); echo 'B'; $b->next(); echo 'C';\\n```\\n\\n**registration-no-reset — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } unregister_tick_function('tick_handler'); register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\n```\\n\\n**empty-registry — measured `ABT`.**\\n\\n```php\\nunregister_tick_function('tick_handler'); declare(ticks=2) { echo 'A'; } register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\n```\\n\\n**semicolon-directive — measured `ATB`.**\\n\\n```php\\ndeclare(ticks=2); echo 'A'; echo 'B';\\n```\\n\\n**include-closure — measured `AFBFT`.**\\n\\n```php\\ninclude 'lib.php'; echo 'A'; $f(); echo 'B'; $f();\\n```\\nlib.php:\\n```php\\n<?php $f=function(){ declare(ticks=2) { echo 'F'; } };\\n```\\n\\n**exception-no-reset — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } try { throw new Exception(); } catch (Exception $e) {} declare(ticks=2) { echo 'B'; }\\n```\\n\\n**once-skip — measured `LBT`.**\\n\\n```php\\ninclude_once 'lib.php'; include_once 'lib.php'; declare(ticks=2) { echo 'B'; }\\n```\\nlib.php:\\n```php\\n<?php declare(ticks=2) { echo 'L'; }\\n```\\n\\n**Review scope and properties confirmed**\\n\\nRead the repository architecture rules, slice-3 design, §12/§15, part-C brief/findings, staged programs/tests, PHP profile and shared after-wrapper, publication seam, and P7 oracle wrapper. Inspected the cited PHP-8.3 compiler/executor/generator/callback sources. Confirmed request-owned explicit state, lexical operand ownership, budget separation, after-normal-completion placement, and unchanged generic VM semantics as the intended architecture. Ran only the 21 direct PHP probes; no Clojure/Node/Dart implementation gates or formal corpus fold were run. The profile declaration exists, but `php.sp/line`, lowering/registry integration, and linked site handoff remain the implementer's work.\\n## p7b-ticks...origin/p7b-ticks\\n?? collab/yang-php/1794568287000-engineer-p7b-ticks-e.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794568287000-engineer-p7b-ticks-e.prompt.md\\n?? collab/yang-php/1794568408000-engineer-p7b-ticks-e.gpt-6.1-terra.findings.md\\n?? collab/yang-php/1794568493000-engineer-p7b-ticks-f.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794568493000-engineer-p7b-ticks-f.prompt.md\\n?? collab/yang-php/1794569052000-engineer-p7b-ticks-g.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794569052000-engineer-p7b-ticks-g.prompt.md\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569052000-engineer-p7b-ticks-g.gpt-6.1-terra.stdout.log:15:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat src/cljc/yang/core/publication.cljc; rg -n 'site-set|derive.*profile' src/cljc/yang src/cljc/yin/vm/linker | head -120; cat test/yang/php/antlr/ticks_test.clj\\\"\",\"aggregated_output\":\"(ns yang.core.publication\\n  \\\"Language-neutral publication of a set of compiled units as linker modules\\n   (docs/design/yang.typescript.md §17, lift L3; the Python instance is\\n   docs/design/yang.antlr.md 8.5.6). A unit set publishes bottom-up: each\\n   unit's static imports order it after the units it imports, and each is\\n   published pinning the manifest address of every import. Cyclic components\\n   are bundled into one unit with lazy member bodies and thin member aliases,\\n   eliminating circular content pins. Name assertions stay the linker's: this\\n   namespace publishes content, it signs nothing.\\n\\n   A frontend supplies a config map:\\n   `:imported-names`    `(fn [unit])` -> the module names `unit` imports\\n   `:module-spec`       `(fn [registry unit runtime-address deps])`\\n   `:scc-module-specs`  `(fn [registry units runtime-address deps])`\\n   `:site-set`          `(fn [handle address ast])` -> site publication, or nil\\n                        (Python's I7 mark set; none for a frontend without)\\n   `:binder-table`      `(fn [handle address ast])` -> table publication, or\\n                        nil (frontend-supplied; Python passes none)\\n   `:refusal-ns`        the namespace string of the refusal keywords\\n   `:publish-fn`        `[handle spec]`, default `publish/publish-module!`.\\\"\\n  (:require\\n    [yin.vm.linker.publish :as publish]))\\n\\n\\n(defn- refused\\n  [reason data]\\n  (merge {:status :refused, :reason reason} data))\\n\\n\\n(defn- components\\n  \\\"Kosaraju's two passes, with immutable search state. Members are sorted;\\n   singleton components keep the old depth-first publication order.\\\"\\n  [names imports]\\n  (let [names-set (set names)\\n        edges (into {} (map (fn [n] [n (filterv names-set (get imports n))])) names)\\n        reverse-edges (reduce (fn [acc [n deps]]\\n                                (reduce #(update %1 %2 (fnil conj []) n) acc deps))\\n                              {} edges)]\\n    (letfn [(finish\\n              [acc n]\\n              (if (contains? (:seen acc) n)\\n                acc\\n                (update (reduce finish (update acc :seen conj n) (get edges n))\\n                        :order conj n)))\\n            (collect\\n              [acc n]\\n              (if (contains? (:seen acc) n)\\n                acc\\n                (reduce collect (-> acc (update :seen conj n) (update :members conj n))\\n                        (get reverse-edges n))))]\\n      (let [finished (:order (reduce finish {:seen #{}, :order []} names))\\n            partition (reduce (fn [acc n]\\n                                (if (contains? (:seen acc) n)\\n                                  acc\\n                                  (let [r (collect {:seen (:seen acc), :members []} n)]\\n                                    {:seen (:seen r),\\n                                     :groups (conj (:groups acc) (vec (sort (:members r))))})))\\n                              {:seen #{}, :groups []} (reverse finished))\\n            group-of (into {} (mapcat (fn [g] (map #(vector % g) g))) (:groups partition))]\\n        (letfn [(order-group\\n                  [acc g]\\n                  (if (contains? (:done acc) g)\\n                    acc\\n                    (let [deps (distinct (map group-of (mapcat edges g)))\\n                          next (reduce order-group (update acc :done conj g)\\n                                       (remove #{g} deps))]\\n                      (update next :order conj g))))]\\n          (:order (reduce order-group {:done #{}, :order []} (map group-of names))))))))\\n\\n\\n(defn publication-order\\n  \\\"Dependency-first names, retaining the input order for acyclic units.\\n   Cyclic components appear as sorted member vectors in :order, one\\n   publication step per SCC. External imports must be in `published`.\\\"\\n  [{:keys [imported-names refusal-ns]} units published]\\n  (let [by-name (into {} (map (juxt :name identity)) units)\\n        imports (into {} (map (juxt :name imported-names)) units)\\n        missing (some (fn [u]\\n                        (some (fn [m]\\n                                (when-not (or (contains? by-name m)\\n                                              (contains? published m))\\n                                  {:module m, :imported-by (:name u)}))\\n                              (get imports (:name u))))\\n                      units)]\\n    (if missing\\n      (refused (keyword refusal-ns \\\"unpublished-import\\\") missing)\\n      {:status :ok,\\n       :order (mapv #(if (= 1 (count %)) (first %) %)\\n                    (components (mapv :name units) imports))})))\\n\\n\\n(defn publish-units!\\n  \\\"Publish `units` into the content store `handle` over the host registry\\n   `registry`, the runtime module pinned at `runtime-address` and each\\n   import outside the set at its address in `published`, in\\n   `publication-order`, per the config `cfg` (see the namespace doc). Answers\\n   `{:status :ok :addresses {name address} :bundles {bundle-symbol address}\\n     :sites {name-or-bundle-symbol publication}\\n     :binders {name-or-bundle-symbol publication}}`, or the first refusal:\\n   `publication-order`'s before anything is written, else the publisher's\\n   with a string `:unit`. An SCC member alias carries no marks and no\\n   binder table: its bundle does.\\\"\\n  [cfg handle registry runtime-address units published]\\n  (let [{:keys [imported-names module-spec scc-module-specs site-set\\n                binder-table refusal-ns publish-fn]\\n         :or {publish-fn publish/publish-module!}}\\n        cfg\\n        plan (publication-order cfg units published)\\n        by-name (into {} (map (juxt :name identity)) units)]\\n    (if (= :refused (:status plan))\\n      plan\\n      (reduce\\n        (fn [acc step]\\n          (let [members (if (vector? step) step [step])\\n                known (merge published (:addresses acc))\\n                deps (select-keys known\\n                                  (mapcat #(imported-names (get by-name %)) members))\\n                specs (if (vector? step)\\n                        (scc-module-specs registry (mapv by-name members)\\n                                          runtime-address deps)\\n                        [(module-spec registry (get by-name step)\\n                                      runtime-address deps)])\\n                bundle (first specs)\\n                result (publish-fn handle bundle)\\n                emit (fn [acc k r]\\n                       ;; a handle with no byte store (a stub publisher)\\n                       ;; has nowhere to put a set; a backend failure is\\n                       ;; a refusal, not a throw\\n                       (if-not (:put-bytes-fn handle)\\n                         acc\\n                         (try (let [emit1 (fn [acc slot f]\\n                                            (if-let [pub (when f\\n                                                           (f handle (:address r)\\n                                                              (:ast bundle)))]\\n                                              (assoc-in acc [slot k] pub)\\n                                              acc))]\\n                                (-> acc\\n                                    (emit1 :sites site-set)\\n                                    (emit1 :binders binder-table)))\\n                              (catch #?(:cljd Object :clj Exception :cljs :default) e\\n                                (reduced\\n                                  (refused (keyword refusal-ns \\\"site-set-unpublished\\\")\\n                                           {:unit k,\\n                                            :message (ex-message e)}))))))]\\n            (if (= :refused (:status result))\\n              (reduced (assoc result :unit (if (vector? step) (str (:name bundle)) step)))\\n              (if (vector? step)\\n                ;; a member alias holds no marks: the marks live in the\\n                ;; bundle, so the bundle alone carries a site set and an\\n                ;; alias import under a hook profile is refused as having none\\n                (let [base (-> acc\\n                               (assoc-in [:bundles (:name bundle)] (:address result))\\n                               (emit (:name bundle) result))]\\n                  (if (reduced? base)\\n                    base\\n                    (let [aliases (reduce (fn [a [n spec]]\\n                                            (let [r (publish-fn\\n                                                      handle (assoc spec :requires\\n                                                                    {(:name bundle) (:address result)}))]\\n                                              (if (= :refused (:status r))\\n                                                (reduced (assoc r :unit n))\\n                                                (assoc-in a [:addresses n] (:address r)))))\\n                                          base\\n                                          (map vector members (rest specs)))]\\n                      (if (= :refused (:status aliases)) (reduced aliases) aliases))))\\n                (-> acc\\n                    (assoc-in [:addresses step] (:address result))\\n                    (emit step result))))))\\n        {:status :ok, :addresses {}, :bundles {}}\\n        (:order plan)))))\\nsrc/cljc/yin/vm/linker/publish.cljc:108:;; a manifest, never the reverse (the site-set precedent,\\nsrc/cljc/yang/safepoint.cljc:21:     frontend knows and the derived tree may need. A profile entry is a\\nsrc/cljc/yang/safepoint.cljc:86:(defn site-set\\nsrc/cljc/yang/safepoint.cljc:426:                                                (site-set selected))}})\\nsrc/cljc/yang/safepoint.cljc:442:   (derive-envelope envelope profile medium nil))\\nsrc/cljc/yang/safepoint.cljc:458:         record (derive-record (:root tree) (:root derived) profile selected)\\nsrc/cljc/yang/safepoint.cljc:477:   its `:derive` record on port `:ledger`. State is `{:profile p :medium m}`\\nsrc/cljc/yang/safepoint.cljc:480:  (let [{:keys [envelope record]} (derive-envelope envelope profile medium)]\\nsrc/cljc/yang/python/antlr/publication.cljc:37:   :site-set siteset/publish!,\\nsrc/cljc/yang/core/publication.cljc:15:   `:site-set`          `(fn [handle address ast])` -> site publication, or nil\\nsrc/cljc/yang/core/publication.cljc:104:  (let [{:keys [imported-names module-spec scc-module-specs site-set\\nsrc/cljc/yang/core/publication.cljc:138:                                    (emit1 :sites site-set)\\nsrc/cljc/yang/core/publication.cljc:142:                                  (refused (keyword refusal-ns \\\"site-set-unpublished\\\")\\nsrc/cljc/yang/python/antlr/siteset.cljc:8:   sorted (`yang.safepoint/site-set`) and content-addressed. A separate\\nsrc/cljc/yang/python/antlr/siteset.cljc:30:   and publishes it beside its `:derive` record. An explicitly noninterruptible profile imports the module\\nsrc/cljc/yang/python/antlr/siteset.cljc:62:  :yang.python.antlr/site-set)\\nsrc/cljc/yang/python/antlr/siteset.cljc:65:(defn site-set-of\\nsrc/cljc/yang/python/antlr/siteset.cljc:71:                               (medium) [:site-set 0] [ast]))\\nsrc/cljc/yang/python/antlr/siteset.cljc:76:    {:root (:root tree), :tree tree, :set (safepoint/site-set sites)}))\\nsrc/cljc/yang/python/antlr/siteset.cljc:95:  (let [{:keys [root set]} (site-set-of ast)\\nsrc/cljc/yang/python/antlr/siteset.cljc:275:      (refusal :yang.python.antlr/missing-site-set requirement\\nsrc/cljc/yang/python/antlr/siteset.cljc:294:            (refusal :yang.python.antlr/site-set-mismatch requirement\\nsrc/cljc/yang/python/antlr/siteset.cljc:496:  #{:yang.python.antlr/missing-site-set\\nsrc/cljc/yang/python/antlr/siteset.cljc:497:    :yang.python.antlr/site-set-mismatch\\nsrc/cljc/yang/php/antlr/publication.cljc:42:   :site-set nil,\\n(ns yang.php.antlr.ticks-test\\n  (:require\\n    [clojure.test :refer [deftest is testing]]\\n    [yang.php.antlr.cst :as cst]\\n    [yang.php.antlr.e2e-harness :as h]\\n    [yang.php.antlr.linked-harness :as lh]\\n    [yang.php.antlr.programs-p7b :as p7b]))\\n\\n\\n(deftest tick-fixtures-test\\n  (doseq [{:keys [id source out units]} p7b/fixtures\\n          :when (nil? units)]\\n    (testing (name id)\\n      (is (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))))))\\n\\n\\n(deftest include-handoff-test\\n  (let [{:keys [source units out]} (last p7b/fixtures)\\n        packets (update-vals (assoc units \\\"main.php\\\" (str \\\"<?php \\\" p7b/prologue source))\\n                             cst/parse-source)\\n        result (lh/run-fixture packets \\\"main.php\\\" {})]\\n    (doseq [[vm value] (:values result)]\\n      (is (= out (h/latin1->text (:php/out value))) (name vm)))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569052000-engineer-p7b-ticks-g.gpt-6.1-terra.stdout.log:17:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'siteset|derive-linked|derive.*module|hook-profile' src/cljc/yang/python test/yang/php/antlr/linked_harness.clj src/cljc/yang/php -g '*.clj*' | head -100; cat test/yang/php/antlr/linked_harness.clj\\\"\",\"aggregated_output\":\"rg: test/yang/php/antlr/linked_harness.clj: No such file or directory (os error 2)\\nsrc/cljc/yang/python/antlr/siteset.cljc:1:(ns yang.python.antlr.siteset\\nsrc/cljc/yang/python/antlr/siteset.cljc:28:   composition's `:stage`: it derives the instrumented module `A'` from the\\nsrc/cljc/yang/python/antlr/siteset.cljc:30:   and publishes it beside its `:derive` record. An explicitly noninterruptible profile imports the module\\nsrc/cljc/yang/python/antlr/siteset.cljc:339:(defn- derive-module\\nsrc/cljc/yang/python/antlr/siteset.cljc:417:   derived module pins the derived requirements it will link (`derived`,\\nsrc/cljc/yang/python/antlr/siteset.cljc:451:          (let [out (derive-module handle registry manifest m adm requirement\\nsrc/cljc/yang/python/antlr/siteset.cljc:547:   by every hook-profile reader.\\\"\\nsrc/cljc/yang/python/antlr/publication.cljc:16:            [yang.python.antlr.siteset :as siteset]\\nsrc/cljc/yang/python/antlr/publication.cljc:37:   :site-set siteset/publish!,\\nsrc/cljc/yang/python/antlr/publication.cljc:59:   of the set (`siteset/publish!`'s answer for each module published beside\\nsrc/cljc/yang/python/antlr/publication.cljc:62:   indexes `siteset/signed-entries` of `:sites` in the same index\\nsrc/cljc/yang/python/antlr/publication.cljc:64:   hook-profile reader. Or the\\ncat: test/yang/php/antlr/linked_harness.clj: No such file or directory\\n\",\"exit_code\":1,\"status\":\"failed\"}}\ncollab/yang-php/1794569052000-engineer-p7b-ticks-g.gpt-6.1-terra.stdout.log:19:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg --files | rg 'linked_harness|siteset.cljc|ticks.*prompt'; cat src/cljc/yang/python/antlr/siteset.cljc\\\"\",\"aggregated_output\":\"src/cljc/yang/python/antlr/siteset.cljc\\ntest/yang/php/antlr/linked_harness.cljc\\ntest/yang/typescript/antlr/linked_harness.cljc\\ntest/yang/python/antlr/linked_harness.cljc\\ncollab/yang-php/1794565785000-engineer-p7b-ticks.prompt.md\\ncollab/yang-php/1794568493000-engineer-p7b-ticks-f.prompt.md\\ncollab/yang-php/1794568287000-engineer-p7b-ticks-e.prompt.md\\ncollab/yang-php/1794566777000-engineer-p7b-ticks-b.prompt.md\\ncollab/yang-php/1794567390000-engineer-p7b-ticks-c.prompt.md\\ncollab/yang-php/1794567570000-architect-ticks-counter-ruling.prompt.md\\ncollab/yang-php/1794568084000-engineer-p7b-ticks-d.prompt.md\\ncollab/yang-php/1794569052000-engineer-p7b-ticks-g.prompt.md\\n(ns yang.python.antlr.siteset\\n  \\\"C4 slice I7 (docs/design/yang.antlr.md 8.5.6, ruling 14): published site\\n   sets for imported modules.\\n\\n   Site marks never enter canonical rows, so a published module tree\\n   carries none; they live in the frontend-metadata side table. A module's\\n   site set is that side table's `:yang/site` marks for the module tree,\\n   sorted (`yang.safepoint/site-set`) and content-addressed. A separate\\n   publication record, keyed by the module's manifest address, pins the\\n   association: the exact code root (the manifest's `:yin.module/tree`),\\n   the frontend revision, the transformation profile and the set's\\n   address. The module manifest keeps its schema: a manifest address names\\n   code, and a record names a manifest.\\n\\n   Discovery. The publisher signs a publication entry per module,\\n   `{:yang.site/manifest m :yang.site/record record-address ...}`, and\\n   indexes it as the datoms `[e :yang.site/envelope env]` and `[e\\n   :yang.site/proof proof]` beside its name envelopes (`signed-entry`).\\n   A reader `discover`s a manifest's record addresses from the index\\n   datoms it loaded, under the principals it declares; only a declared\\n   principal's signature makes an entry count. The record and the set are\\n   fetched by address and verified against it.\\n\\n   A consumer under a profile requiring hooks `admit`s an import: it\\n   verifies every pin against the published code root and refuses a\\n   missing, empty or mismatched set, naming the profile and the set.\\n   `stage` then applies a verified set at link time, as the linker\\n   composition's `:stage`: it derives the instrumented module `A'` from the\\n   published tree alone, bottom-up over the module's guest requirements,\\n   and publishes it beside its `:derive` record. An explicitly noninterruptible profile imports the module\\n   as published, with none.\\\"\\n  (:require [dao.jing :as jing]\\n            [yang.python.antlr.lower :as lower]\\n            [yang.safepoint :as safepoint]\\n            [yin.vm :as vm]\\n            [yin.vm.encoder :as encoder]\\n            [yin.vm.linker.publish :as publish]\\n            [yin.vm.linker.sign :as sign]))\\n\\n\\n(def frontend-revision\\n  \\\"The frontend revision the marks are pinned to: it moves with any change\\n   to which nodes the Python lowering marks, or how.\\\"\\n  \\\"yang.python.antlr.lower/sites-1\\\")\\n\\n\\n(def lowering-profile\\n  \\\"The transformation profile the marks were made under: the module\\n   emitter over the linked prelude, marking these kinds.\\\"\\n  {:yang.site/unit :module,\\n   :yang.site/prelude :linked,\\n   :yang.site/kinds [:call :line :loop]})\\n\\n\\n(def profile-address\\n  \\\"The address the transformation profile is pinned by.\\\"\\n  (jing/segment-key lowering-profile))\\n\\n\\n(defn- medium\\n  []\\n  :yang.python.antlr/site-set)\\n\\n\\n(defn site-set-of\\n  \\\"`{:root address :tree tree :set [[path mark] ...]}` for the module map\\n   AST `ast`: the address of its canonical tree, the tree's rows and its\\n   sorted site set.\\\"\\n  [ast]\\n  (let [env (encoder/project (encoder/source-envelope\\n                               (medium) [:site-set 0] [ast]))\\n        tree (nth (:yin/batch env) (:yin/root env))\\n        origin (vm/source-origin (:yin/source-medium env)\\n                                 (:yin/batch-token env) (:yin/root env))\\n        sites (safepoint/sites (:yin/frontend-metadata env) origin (:root tree))]\\n    {:root (:root tree), :tree tree, :set (safepoint/site-set sites)}))\\n\\n\\n(defn record\\n  \\\"The publication record associating manifest `manifest` with site set\\n   `set-address` over code root `root`.\\\"\\n  [manifest root set-address]\\n  {:yang.site/manifest manifest,\\n   :yang.site/root root,\\n   :yang.site/revision frontend-revision,\\n   :yang.site/profile profile-address,\\n   :yang.site/set set-address})\\n\\n\\n(defn publish!\\n  \\\"Publish the site set of module `ast` (published at manifest address\\n   `manifest`) into `handle`: the set as one blob, then its record. Answers\\n   `{:record r :record-address a :set-address s :set [...]}`.\\\"\\n  [handle manifest ast]\\n  (let [{:keys [root set]} (site-set-of ast)\\n        set-address (jing/materialize! handle (vec set))\\n        r (record manifest root set-address)]\\n    {:record r,\\n     :record-address (jing/materialize! handle r),\\n     :set-address set-address,\\n     :set set}))\\n\\n\\n(defn- read-at\\n  \\\"The value at `address` in `handle`: `::absent` when the handle holds no\\n   bytes for a segment address (the handle is asked with a not-found\\n   sentinel, as a byte store is), nil when `address` is no segment address\\n   or its bytes do not hash to it, else the value.\\\"\\n  [handle address]\\n  (if-not (jing/segment-address? address)\\n    nil\\n    (let [bs ((:get-bytes-fn handle) address ::absent)]\\n      (cond\\n        (= ::absent bs) ::absent\\n        (nil? bs) ::absent\\n        (jing/segment-bytes-match? address bs) (jing/segment-value address bs)\\n        :else nil))))\\n\\n\\n(defn- absent?\\n  [x]\\n  (= ::absent x))\\n\\n\\n(defn- missing\\n  \\\"The stage's report of the absent `address`: first one met, nothing\\n   written.\\\"\\n  [address]\\n  {:status :missing, :address address})\\n\\n\\n(defn- fetch\\n  \\\"The value at `address` in `handle`, or nil when absent or not its\\n   address.\\\"\\n  [handle address]\\n  (let [v (read-at handle address)]\\n    (when-not (absent? v) v)))\\n\\n\\n;; =============================================================================\\n;; Discovery\\n;; =============================================================================\\n\\n(defn signed-entry\\n  \\\"The publisher `key`'s (`{:seed :public}`) signed publication entry\\n   `{:envelope e :proof p}` for the record at `record-address` of the\\n   module at `manifest`: what the index carries so a reader discovers the\\n   record from the published code.\\\"\\n  [key manifest record-address]\\n  (let [env {:yang.site/op :publish,\\n             :yang.site/manifest manifest,\\n             :yang.site/record record-address,\\n             :yin.module/asserted-by (sign/principal (:public key))}]\\n    {:envelope env, :proof (sign/sign-envelope (:seed key) env)}))\\n\\n\\n(defn entry-datoms\\n  \\\"The index datoms of the signed entries `signed`, entity ids from 0.\\\"\\n  [signed]\\n  (vec (mapcat (fn [e {:keys [envelope proof]}]\\n                 [[e :yang.site/envelope envelope]\\n                  [e :yang.site/proof proof]])\\n               (range) signed)))\\n\\n\\n(defn discover\\n  \\\"The record addresses `datoms` (`[e a v ...]`, a loaded index's) publish\\n   for the module at `manifest`, in datom order: the entries whose proof is\\n   a valid signature by one of the `publics` (64 hex keys) the reader\\n   declares, and no other.\\\"\\n  [datoms publics manifest]\\n  (let [proofs (reduce (fn [acc [e a v]]\\n                         (cond-> acc\\n                           (= a :yang.site/proof) (update e (fnil conj #{}) v)))\\n                       {} datoms)]\\n    (vec (distinct\\n           (keep (fn [[e a env]]\\n                   (when (and (= a :yang.site/envelope)\\n                              (map? env)\\n                              (= :publish (:yang.site/op env))\\n                              (= manifest (:yang.site/manifest env)))\\n                     (let [ps (get proofs e)\\n                           sig (when (= 1 (count ps))\\n                                 (:yin.module/signature (first ps)))]\\n                       (when (and (string? sig)\\n                                  (some #(sign/verify-envelope\\n                                           % (jing/canonical-bytes env) sig)\\n                                        publics))\\n                         (:yang.site/record env)))))\\n                 datoms)))))\\n\\n\\n;; =============================================================================\\n;; Verification and admission\\n;; =============================================================================\\n\\n(defn- refusal\\n  [reason requirement message data]\\n  (merge {:status :refused,\\n          :reason reason,\\n          :profile (:profile requirement),\\n          :message (str \\\"profile \\\" (pr-str (:profile requirement))\\n                        \\\" requires hooks: \\\" message)}\\n         data))\\n\\n\\n(defn- entry-ok?\\n  \\\"A set entry is `[path mark]`, a path vector and a mark of the profile's\\n   kinds (a kind, or `[kind datum ...]`).\\\"\\n  [entry]\\n  (and (vector? entry)\\n       (= 2 (count entry))\\n       (vector? (first entry))\\n       (let [mark (second entry)]\\n         (boolean (some #{(if (vector? mark) (first mark) mark)}\\n                        (:yang.site/kinds lowering-profile))))))\\n\\n\\n(defn verify\\n  \\\"Nil when the record at `record-address` verifies as the site set of the\\n   module published at `manifest` in `handle`; `{:status :missing :address\\n   a}` for the first address (manifest, record, set, in that order) the\\n   handle does not hold; else the first defect `{:defect k ...}` (with the\\n   record's `:set` address when it names one): the manifest or record not\\n   its address, the record naming another manifest, the code root, the\\n   frontend revision or the profile not the published ones, the set not its\\n   address or empty, or an entry not a path with a mark kind of the\\n   profile's.\\\"\\n  [handle manifest record-address]\\n  (let [m (read-at handle manifest)\\n        r (when-not (absent? m) (read-at handle record-address))\\n        set-address (when (map? r) (:yang.site/set r))\\n        set (when-not (or (absent? m) (absent? r))\\n              (read-at handle set-address))\\n        defect (cond\\n                 (not (map? m)) {:defect :manifest-absent}\\n                 (not (map? r)) {:defect :record-absent}\\n                 (not= manifest (:yang.site/manifest r)) {:defect :manifest}\\n                 (not= (:yin.module/tree m) (:yang.site/root r)) {:defect :root}\\n                 (not= frontend-revision (:yang.site/revision r))\\n                 {:defect :revision}\\n                 (not= profile-address (:yang.site/profile r)) {:defect :profile}\\n                 (not (vector? set)) {:defect :set-absent}\\n                 (empty? set) {:defect :set-empty}\\n                 (not (every? entry-ok? set)) {:defect :kind}\\n                 :else nil)]\\n    (cond\\n      (absent? m) (missing manifest)\\n      (absent? r) (missing record-address)\\n      (absent? set) (missing set-address)\\n      defect (cond-> defect set-address (assoc :set set-address)))))\\n\\n\\n(defn admit\\n  \\\"A consumer's decision for the import of the module at `manifest` in\\n   `handle`, `record-addresses` the publication records it discovered for\\n   it, under `requirement`: `{:profile name :hooks true}` or `{:profile\\n   name :noninterruptible true}`. Answers `{:status :ok :instrumented? true\\n   :set [...] :set-address s :record a}` when a record verifies, `{:status\\n   :ok :instrumented? false :note ...}` for a noninterruptible profile,\\n   else a refusal naming the profile and the missing or mismatched set (its\\n   address when the record names one); or `{:status :missing :address a}`,\\n   the first address a record's verification reads that `handle` does not\\n   hold (`verify`).\\\"\\n  [handle manifest record-addresses requirement]\\n  (cond\\n    (:noninterruptible requirement)\\n    {:status :ok,\\n     :instrumented? false,\\n     :note (str \\\"profile \\\" (pr-str (:profile requirement))\\n                \\\" is noninterruptible: imported without a site set\\\")}\\n\\n    (:hooks requirement)\\n    (if (empty? record-addresses)\\n      (refusal :yang.python.antlr/missing-site-set requirement\\n               \\\"no published site set for the module\\\" {:manifest manifest})\\n      (loop [todo record-addresses\\n             first-defect nil]\\n        (if-let [a (first todo)]\\n          (let [v (verify handle manifest a)]\\n            (cond\\n              (nil? v)\\n              (let [set-address (:yang.site/set (fetch handle a))]\\n                {:status :ok,\\n                 :instrumented? true,\\n                 :record a,\\n                 :set-address set-address,\\n                 :set (fetch handle set-address)})\\n\\n              (= :missing (:status v)) v\\n\\n              :else (recur (rest todo) (or first-defect [a v]))))\\n          (let [[a defect] first-defect]\\n            (refusal :yang.python.antlr/site-set-mismatch requirement\\n                     (str \\\"the published site set\\\"\\n                          (when-let [s (:set defect)] (str \\\" \\\" s))\\n                          \\\" does not verify (\\\" (name (:defect defect)) \\\")\\\")\\n                     (assoc defect :manifest manifest :record a))))))\\n\\n    :else\\n    (refusal :yang.python.antlr/profile-undeclared requirement\\n             \\\"the profile declares neither :hooks nor :noninterruptible\\\"\\n             {:manifest manifest})))\\n\\n\\n;; =============================================================================\\n;; Link-time application\\n;; =============================================================================\\n\\n(defn- load-tree\\n  \\\"The canonical row set `{:root :rows}` of the tree at `root` in `handle`,\\n   every row fetched by its address, depth-first: `{:status :missing\\n   :address a}` for the first row the handle does not hold, nil when a row\\n   is not its address or no tree row.\\\"\\n  [handle root]\\n  (loop [todo [root]\\n         rows {}]\\n    (if-let [id (peek todo)]\\n      (if (contains? rows id)\\n        (recur (pop todo) rows)\\n        (let [body (read-at handle id)\\n              slots (when (vector? body)\\n                      (get vm/semantic-bytecode-grammar (first body)))]\\n          (cond\\n            (absent? body) (missing id)\\n            slots (recur (into (pop todo)\\n                               (mapcat (fn [[_ kind] v]\\n                                         (case kind\\n                                           :node [v]\\n                                           :nodes v\\n                                           nil))\\n                                       slots\\n                                       (rest body)))\\n                         (assoc rows id (into [id] body)))\\n            :else nil)))\\n      {:root root, :rows rows})))\\n\\n\\n(defn- derive-module\\n  \\\"Publish into `handle` the instrumented module `A'` of the module `m` at\\n   `manifest` for the verified set of `adm`: the published tree with the\\n   hooks of `(:hooks-profile requirement)` at its sites, requiring\\n   `(:pysp requirement)` beside its own requirements, each guest\\n   requirement rebound through `derived` ({A A'}). The `:derive` record\\n   (`yang.safepoint/derive-record`) is materialized beside it and its\\n   address answered as `:derivation`; nothing transacts it into a ledger.\\n   Answers `{:status :ok :address a' :derivation d}`, a refusal, or\\n   `{:status :missing :address a}` for the first tree row the handle does\\n   not hold, before anything is written.\\\"\\n  [handle registry manifest m adm requirement derived]\\n  (let [fail (fn [message data]\\n               (refusal :yang.python.antlr/instrumentation-failed requirement\\n                        message (assoc data :manifest manifest)))]\\n    (if-not (jing/segment-address? (:pysp requirement))\\n      (fail \\\"the hook module is not published\\\" {})\\n      (try\\n        (let [tree (load-tree handle (:yin.module/tree m))\\n              absent (= :missing (:status tree))\\n              sites (into {} (:set adm))\\n              inserted (when (and tree (not absent))\\n                         (safepoint/insert tree sites\\n                                           (:hooks-profile requirement)))\\n              ast (when inserted\\n                    (vm/semantic-bytecode->ast (:tree inserted)))\\n              runtime (or (:runtime requirement) '#{py pysp yang.call})\\n              out (when ast\\n                    (publish/publish-module!\\n                      handle\\n                      {:name (:yin.module/name m),\\n                       :ast ast,\\n                       :exports (:yin.module/exports m),\\n                       :requires (assoc (into {}\\n                                              (map (fn [[n a]]\\n                                                     [n (if (contains? runtime n)\\n                                                          a\\n                                                          (get derived a a))]))\\n                                              (:yin.module/requires m))\\n                                        'pysp (:pysp requirement)),\\n                       :primitives (into {}\\n                                         (map (fn [[n _]]\\n                                                [n (lower/primitive-declaration\\n                                                     registry n)]))\\n                                         (:yin.module/primitives m))}))]\\n          (cond\\n            absent tree\\n            (nil? tree) (fail \\\"the module's tree is not published\\\" {})\\n            (= :refused (:status out))\\n            (fail \\\"the instrumented module did not publish\\\" {:cause out})\\n            :else\\n            {:status :ok,\\n             :address (:address out),\\n             :instrumented? true,\\n             :set-address (:set-address adm),\\n             :derivation (jing/materialize!\\n                           handle\\n                           (safepoint/derive-record\\n                             (:yin.module/tree m)\\n                             (:yin.module/tree (:manifest out))\\n                             (:hooks-profile requirement)\\n                             (:sites inserted)))}))\\n        (catch #?(:cljd Object :clj Exception :cljs :default) e\\n          (fail (str \\\"the instrumented module did not derive: \\\" (ex-message e))\\n                {}))))))\\n\\n\\n(defn- records-for\\n  \\\"The record addresses for `manifest`: the local map `records`'s, then\\n   those `ctx`'s loaded index datoms publish under its principals.\\\"\\n  [ctx records manifest]\\n  (into (vec (get records manifest))\\n        (discover (:datoms ctx) (:principals ctx) manifest)))\\n\\n\\n(defn- derive-closure\\n  \\\"The instrumented module of `manifest` under a hook profile, derived\\n   bottom-up: each guest requirement is admitted and derived first, so the\\n   derived module pins the derived requirements it will link (`derived`,\\n   {A A'}, derives a shared requirement once). Answers `{:status :ok\\n   :address a' :derivation d :derived derived}`, the first refusal, with\\n   `:name` the requirement that was refused and `:via` the module that\\n   required it, or `{:status :missing :address a}` for the first address\\n   (record, set, guest manifest, tree row) read in a fixed depth-first\\n   order that the handle does not hold. Nothing is written until every\\n   read has succeeded.\\\"\\n  [ctx registry records requirement manifest derived]\\n  (let [handle (:store ctx)\\n        runtime (or (:runtime requirement) '#{py pysp yang.call})\\n        adm (admit handle manifest (records-for ctx records manifest)\\n                   requirement)]\\n    (if (not= :ok (:status adm))\\n      adm\\n      (let [m (fetch handle manifest)\\n            deps (sort-by (comp str key)\\n                          (remove (comp runtime key)\\n                                  (:yin.module/requires m)))\\n            below (reduce (fn [acc [n a]]\\n                            (if (contains? (:derived acc) a)\\n                              acc\\n                              (let [r (derive-closure ctx registry records\\n                                                      requirement a\\n                                                      (:derived acc))]\\n                                (case (:status r)\\n                                  :ok (assoc acc :derived (:derived r))\\n                                  :missing (reduced r)\\n                                  (reduced (cond-> (assoc r :via manifest)\\n                                             (nil? (:name r)) (assoc :name n)))))))\\n                          {:derived derived}\\n                          deps)]\\n        (if (:status below)\\n          below\\n          (let [out (derive-module handle registry manifest m adm requirement\\n                                   (:derived below))]\\n            (if (not= :ok (:status out))\\n              out\\n              (assoc out :derived (assoc (:derived below) manifest\\n                                         (:address out))))))))))\\n\\n\\n(defn- overlay\\n  \\\"A write-buffering handle over `base`: reads see the buffer first, then\\n   `base`; puts land in the buffer only, in put order. `flush!` writes the\\n   buffer to `base`; dropping the overlay writes nothing.\\\"\\n  [base]\\n  (let [buf (atom {:bytes {}, :order []})\\n        sentinel #?(:cljs (js-obj)\\n                    :default (Object.))]\\n    {:handle (assoc base\\n                    :get-bytes-fn (fn [address not-found]\\n                                    (let [bs (get-in @buf [:bytes address])]\\n                                      (if (nil? bs)\\n                                        ((:get-bytes-fn base) address not-found)\\n                                        bs)))\\n                    :put-bytes-fn (fn [address bs]\\n                                    (if (or (contains? (:bytes @buf) address)\\n                                            (let [existing ((:get-bytes-fn base)\\n                                                            address\\n                                                            sentinel)]\\n                                              (and (some? existing)\\n                                                   (not (identical? sentinel\\n                                                                    existing)))))\\n                                      :present\\n                                      (do (swap! buf (fn [b]\\n                                                       (-> b\\n                                                           (assoc-in [:bytes address]\\n                                                                     bs)\\n                                                           (update :order conj\\n                                                                   address))))\\n                                          :inserted))))\\n     :flush! (fn []\\n               (let [{:keys [bytes order]} @buf]\\n                 (doseq [a order] ((:put-bytes-fn base) a (get bytes a)))))}))\\n\\n\\n(def reasons\\n  \\\"The refusal reasons the stage answers, the composition's own.\\\"\\n  #{:yang.python.antlr/missing-site-set\\n    :yang.python.antlr/site-set-mismatch\\n    :yang.python.antlr/profile-undeclared\\n    :yang.python.antlr/instrumentation-failed})\\n\\n\\n(defn stage\\n  \\\"The link-time stage (`yin.vm.linker.interpreter/composition`'s `:stage`)\\n   of a Python import under `requirement`: `{:profile name :hooks true\\n   :hooks-profile p :pysp address}` or `{:profile name :noninterruptible\\n   true}`, with `:runtime` the names of the runtime modules (default `py`,\\n   `pysp`, and `yang.call`) it passes through. `yang.call` is the shared\\n   call dispatcher, not guest Python code, so it has no Python site marks.\\n   `records` ({manifest [record-address ...]})\\n   are the local publication's records; a DHT source supplies none and the\\n   stage discovers them from the index datoms of its context. The stage\\n   reads only the context's `:store` and never fetches: it answers\\n   `{:status :missing :address a}` for the first address that store does\\n   not hold, and is run again once it is there. Answers\\n   `(fn [ctx name address])`: `{:status :ok :address address}` as published\\n   when noninterruptible, else the address of the instrumented module\\n   derived bottom-up from the verified sets (`:derivation` its `:derive`\\n   record's address), or the refusal naming the profile, the set and the\\n   `:name` refused.\\\"\\n  [registry requirement records]\\n  (let [runtime (or (:runtime requirement) '#{py pysp yang.call})]\\n    (fn [ctx name address]\\n      (cond\\n        (contains? runtime name) {:status :ok, :address address}\\n\\n        (:noninterruptible requirement)\\n        (assoc (admit (:store ctx) address [] requirement) :address address)\\n\\n        :else\\n        (let [{:keys [handle flush!]} (overlay (:store ctx))\\n              r (derive-closure (assoc ctx :store handle) registry records\\n                                requirement address {})]\\n          (case (:status r)\\n            :ok (do (flush!)\\n                    (select-keys r [:status :address :derivation :instrumented?\\n                                    :set-address]))\\n            :missing (select-keys r [:status :address])\\n            (cond-> r (nil? (:name r)) (assoc :name name))))))))\\n\\n\\n(defn signed-entries\\n  \\\"The `publisher` key's signed publication entries for the site sets\\n   `publish-units!` answered: `sites` (`:sites`), the manifest of each\\n   from `addresses` (a Python name) or `bundles` (a bundle symbol), in\\n   key order. The publisher that asserts these names indexes them in the\\n   same transaction (`entry-datoms`); a module with no entry is refused\\n   by every hook-profile reader.\\\"\\n  [publisher sites addresses bundles]\\n  (mapv (fn [[k s]]\\n          (signed-entry publisher (or (get addresses k) (get bundles k))\\n                        (:record-address s)))\\n        (sort-by (comp str key) sites)))\\n\",\"exit_code\":0,\"status\"