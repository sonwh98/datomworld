 :manifest :record)\\n        datoms (siteset/entry-datoms [entry])\\n        tampered (siteset/entry-datoms [(assoc-in entry [:envelope :yang.site/record] :other)])]\\n    (is (= [:record] (siteset/discover datoms [(:public key)] :manifest)))\\n    (is (empty? (siteset/discover datoms [(:public other)] :manifest)))\\n    (is (empty? (siteset/discover datoms [(:public key)] :other)))\\n    (is (empty? (siteset/discover tampered [(:public key)] :manifest)))))\\n''';open(p,'w').write(s)\\nPY\\nclojure -M:test -n yang.php.antlr.siteset-test\\\"\",\"aggregated_output\":\"Loading initial Timbre config from: :default\\n\\nRunning tests in #{\\\"test\\\"}\\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\\n\\nTesting yang.php.antlr.siteset-test\\n\\nRan 4 tests containing 15 assertions.\\n0 failures, 0 errors.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:51:{\"type\":\"item.started\",\"item\":{\"id\":\"item_26\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat >> src/cljc/yang/php/antlr/siteset.cljc <<'EOF'\\n\\n\\n(defn derive-verified\\n  \\\\\\\"Re-derive a validated module tree from its verified published occurrence set.\\n   Returns nil when the tree or publication does not match the manifest.\\\\\\\"\\n  [handle manifest record-address tree profile]\\n  (when-let [{:keys [record set]} (verify handle manifest record-address)]\\n    (when (and (= (:yang.site/root record) (:root tree))\\n               (nil? (vm/validate-rows tree)))\\n      (let [{derived :tree selected :sites} (safepoint/insert tree (into {} set) profile)\\n            derivation (safepoint/derive-record (:root tree) (:root derived)\\n                                                profile selected)]\\n        {:tree derived, :record derivation,\\n         :record-address (jing/segment-key derivation),\\n         :site-set-address (:yang.site/set record)}))))\\nEOF\\ncat >> test/yang/php/antlr/siteset_test.clj <<'EOF'\\n\\n\\n(deftest derivation-requires-the-verified-publication\\n  (let [store (mem/create-content-mem)\\n        ast (vary-meta (u/lit 1) assoc :yang/site [:line 1 {:ticks 1}])\\n        env (siteset/site-set-of ast)\\n        tree (vm/ast->semantic-bytecode ast)\\n        manifest (jing/materialize\\\"'! store {:yin.module/tree (:root env)})\\n        pub (siteset/publish! store manifest ast)\\n        profile {:line {:hook '\\\"'php.sp/line, :operands true, :after true}}\\n        derived (siteset/derive-verified store manifest (:record-address pub) tree profile)]\\n    (is (some? derived))\\n    (is (= (:root tree) (get-in derived [:record :yin.ledger/input])))\\n    (is (= (:root (:tree derived)) (get-in derived [:record :yin.ledger/output])))\\n    (is (= (:set-address pub) (:site-set-address derived)))\\n    (is (nil? (siteset/derive-verified store manifest :missing tree profile)))\\n    (is (nil? (siteset/derive-verified store manifest (:record-address pub)\\n                                       (assoc tree :root :wrong) profile)))))\\nEOF\\npython3 - <<'PY'\\np='test/yang/php/antlr/siteset_test.clj';s=open(p).read().replace('[yin.vm.linker.sign :as sign]))','[yin.vm.linker.sign :as sign]\\\\\\\\n    [yin.vm :as vm]))');open(p,'w').write(s)\\nPY\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:52:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_26\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat >> src/cljc/yang/php/antlr/siteset.cljc <<'EOF'\\n\\n\\n(defn derive-verified\\n  \\\\\\\"Re-derive a validated module tree from its verified published occurrence set.\\n   Returns nil when the tree or publication does not match the manifest.\\\\\\\"\\n  [handle manifest record-address tree profile]\\n  (when-let [{:keys [record set]} (verify handle manifest record-address)]\\n    (when (and (= (:yang.site/root record) (:root tree))\\n               (nil? (vm/validate-rows tree)))\\n      (let [{derived :tree selected :sites} (safepoint/insert tree (into {} set) profile)\\n            derivation (safepoint/derive-record (:root tree) (:root derived)\\n                                                profile selected)]\\n        {:tree derived, :record derivation,\\n         :record-address (jing/segment-key derivation),\\n         :site-set-address (:yang.site/set record)}))))\\nEOF\\ncat >> test/yang/php/antlr/siteset_test.clj <<'EOF'\\n\\n\\n(deftest derivation-requires-the-verified-publication\\n  (let [store (mem/create-content-mem)\\n        ast (vary-meta (u/lit 1) assoc :yang/site [:line 1 {:ticks 1}])\\n        env (siteset/site-set-of ast)\\n        tree (vm/ast->semantic-bytecode ast)\\n        manifest (jing/materialize\\\"'! store {:yin.module/tree (:root env)})\\n        pub (siteset/publish! store manifest ast)\\n        profile {:line {:hook '\\\"'php.sp/line, :operands true, :after true}}\\n        derived (siteset/derive-verified store manifest (:record-address pub) tree profile)]\\n    (is (some? derived))\\n    (is (= (:root tree) (get-in derived [:record :yin.ledger/input])))\\n    (is (= (:root (:tree derived)) (get-in derived [:record :yin.ledger/output])))\\n    (is (= (:set-address pub) (:site-set-address derived)))\\n    (is (nil? (siteset/derive-verified store manifest :missing tree profile)))\\n    (is (nil? (siteset/derive-verified store manifest (:record-address pub)\\n                                       (assoc tree :root :wrong) profile)))))\\nEOF\\npython3 - <<'PY'\\np='test/yang/php/antlr/siteset_test.clj';s=open(p).read().replace('[yin.vm.linker.sign :as sign]))','[yin.vm.linker.sign :as sign]\\\\\\\\n    [yin.vm :as vm]))');open(p,'w').write(s)\\nPY\\\"\",\"aggregated_output\":\"\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:63:{\"type\":\"item.started\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'clojure -M:test -n yang.php.antlr.ticks-test -v yang.php.antlr.ticks-test/include-handoff-test'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:66:{\"type\":\"item.started\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat > collab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md <<'EOF'\\nCreated-GMT: 2026-11-13 11:36:09 GMT\\nCoding-Agent: codex\\nRole: Engineer\\nStatus: partial; consumer integration and include gate remain incomplete\\n\\nPHP site sets now have signed-entry, entry-datoms, discover and signed-entries helpers, following the Python site-set discovery pattern. Discovery checks the declared signer's principal as well as its signature. derive-verified checks the manifest-bound record via the existing PHP verifier, validates and hashes each input tree row, and applies the published occurrence marks with the requested safepoint profile. It returns the input/output derivation record and the published site-set address; it does not publish or serve the derived module.\\n\\nVerified sequentially: tick-fixtures-test 1 test / 8 assertions green; siteset-test 5 / 21 green; yang.safepoint-test 9 / 20 green. clj-kondo on both touched code/test files: 0 errors, 0 warnings. The include-handoff test result is recorded below.\\n\\nNext steps: integrate discovery from signed linker index datoms into a PHP linker stage (see yang.python.antlr.siteset/stage and interpreter composition); publish/pin a module exporting the tick hook and derive the dependency closure bottom-up, rebind SCC alias requirements to derived bundle addresses, and materialize derivation records. Ensure the derivation record pins the intended published full site-set address as well as the selected sites when these differ. Apply the selected profile to the entry production paths and exercise the linked harness through this stage. Current helpers are not wired into any execution path; do not claim production ticks or include acceptance. Statement selection and registry fixture work remains part I.\\nEOF\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:67:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_34\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat > collab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md <<'EOF'\\nCreated-GMT: 2026-11-13 11:36:09 GMT\\nCoding-Agent: codex\\nRole: Engineer\\nStatus: partial; consumer integration and include gate remain incomplete\\n\\nPHP site sets now have signed-entry, entry-datoms, discover and signed-entries helpers, following the Python site-set discovery pattern. Discovery checks the declared signer's principal as well as its signature. derive-verified checks the manifest-bound record via the existing PHP verifier, validates and hashes each input tree row, and applies the published occurrence marks with the requested safepoint profile. It returns the input/output derivation record and the published site-set address; it does not publish or serve the derived module.\\n\\nVerified sequentially: tick-fixtures-test 1 test / 8 assertions green; siteset-test 5 / 21 green; yang.safepoint-test 9 / 20 green. clj-kondo on both touched code/test files: 0 errors, 0 warnings. The include-handoff test result is recorded below.\\n\\nNext steps: integrate discovery from signed linker index datoms into a PHP linker stage (see yang.python.antlr.siteset/stage and interpreter composition); publish/pin a module exporting the tick hook and derive the dependency closure bottom-up, rebind SCC alias requirements to derived bundle addresses, and materialize derivation records. Ensure the derivation record pins the intended published full site-set address as well as the selected sites when these differ. Apply the selected profile to the entry production paths and exercise the linked harness through this stage. Current helpers are not wired into any execution path; do not claim production ticks or include acceptance. Statement selection and registry fixture work remains part I.\\nEOF\\\"\",\"aggregated_output\":\"\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:76:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_32\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'clojure -M:test -n yang.php.antlr.ticks-test -v yang.php.antlr.ticks-test/include-handoff-test'\",\"aggregated_output\":\"Loading initial Timbre config from: :default\\n\\nRunning tests in #{\\\"test\\\"}\\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\\n\\nTesting yang.php.antlr.ticks-test\\n\\nFAIL in (include-handoff-test) (ticks_test.clj:23)\\nsemantic\\nexpected: (= out (h/latin1->text (:php/out value)))\\n  actual: (not (= \\\"LT\\\" \\\"L\\\"))\\n\\nFAIL in (include-handoff-test) (ticks_test.clj:23)\\nstack\\nexpected: (= out (h/latin1->text (:php/out value)))\\n  actual: (not (= \\\"LT\\\" \\\"L\\\"))\\n\\nFAIL in (include-handoff-test) (ticks_test.clj:23)\\nregister\\nexpected: (= out (h/latin1->text (:php/out value)))\\n  actual: (not (= \\\"LT\\\" \\\"L\\\"))\\n\\nRan 1 tests containing 3 assertions.\\n3 failures, 0 errors.\\n\",\"exit_code\":1,\"status\":\"failed\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:77:{\"type\":\"item.started\",\"item\":{\"id\":\"item_40\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\np='collab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md';s=open(p).read().replace('The include-handoff test result is recorded below.', 'include-handoff-test completed with 3 failures / 0 errors: semantic, stack and register each returned \\\"'`L` instead of `LT`.'\\\"');open(p,'w').write(s)\\nPY\\ngit diff --check\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:78:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_40\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\np='collab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md';s=open(p).read().replace('The include-handoff test result is recorded below.', 'include-handoff-test completed with 3 failures / 0 errors: semantic, stack and register each returned \\\"'`L` instead of `LT`.'\\\"');open(p,'w').write(s)\\nPY\\ngit diff --check\\\"\",\"aggregated_output\":\"\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.gpt-6.1-terra.stdout.log:81:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_42\",\"type\":\"agent_message\",\"text\":\"Pushed verified partial work to `p7b-ticks` in commits `e0d915e2` and `811e484b`. **The include-handoff goal remains incomplete:** all three backends returned `L` instead of `LT`.\\n\\nThe partial adds signed site-set discovery helpers and a verified derivation helper. They are not yet connected to the linker, dependency publication, SCC alias rebinding, or production entry paths. Exact next steps are in the [findings](/Users/sto/workspace/datomworld-p7b/collab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md).\\n\\nVerification: tick fixtures passed 8/8; site-set tests passed 5 tests/21 assertions; safepoint tests passed 9 tests/20 assertions; clj-kondo reported 0 errors and 0 warnings on touched code and test files.\"}}\ncollab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md:6:PHP site sets now have signed-entry, entry-datoms, discover and signed-entries helpers, following the Python site-set discovery pattern. Discovery checks the declared signer's principal as well as its signature. derive-verified checks the manifest-bound record via the existing PHP verifier, validates and hashes each input tree row, and applies the published occurrence marks with the requested safepoint profile. It returns the input/output derivation record and the published site-set address; it does not publish or serve the derived module.\ncollab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md:8:Verified sequentially: tick-fixtures-test 1 test / 8 assertions green; siteset-test 5 / 21 green; yang.safepoint-test 9 / 20 green. clj-kondo on both touched code/test files: 0 errors, 0 warnings. include-handoff-test completed with 3 failures / 0 errors: semantic, stack and register each returned `L` instead of `LT`.\ncollab/yang-php/1794569769000-engineer-p7b-ticks-h.gpt-6.1-terra.findings.md:10:Next steps: integrate discovery from signed linker index datoms into a PHP linker stage (see yang.python.antlr.siteset/stage and interpreter composition); publish/pin a module exporting the tick hook and derive the dependency closure bottom-up, rebind SCC alias requirements to derived bundle addresses, and materialize derivation records. Ensure the derivation record pins the intended published full site-set address as well as the selected sites when these differ. Apply the selected profile to the entry production paths and exercise the linked harness through this stage. Current helpers are not wired into any execution path; do not claim production ticks or include acceptance. Statement selection and registry fixture work remains part I.\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.prompt.md:6:# Task: P7-b part H — the consumer chain: verified link-time derivation + production entry profile. SOLE goal: include-handoff-test green.\ncollab/yang-php/1794569650000-engineer-p7b-ticks-h.prompt.md:25:`yang.php.antlr.ticks-test/include-handoff-test` green (sequential, 600s budget); tick-fixtures\ncollab/yang-php/1794567390000-engineer-p7b-ticks-c.gpt-6.1-terra.findings.md:10:Fixture chronology: the predecessor recorded sequence, loop-body, function-call and generator-resume red with empty output, and the include case timed out. No fixture was turned green in this session. All fixtures retain `:oracle :pending`; Docker was not run. The linked include handoff remains unimplemented; no new include run was attempted. The predecessor's exact isolated command `timeout 90 clojure -M:test -n yang.php.antlr.ticks-test -v yang.php.antlr.ticks-test/include-handoff-test` timed out after 90 seconds; its combined run timed out after 120 seconds.\ncollab/yang-php/1794568493000-engineer-p7b-ticks-f.gpt-6.1-terra.stdout.log:7:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.findings.md'\",\"aggregated_output\":\"Completed-GMT: 2026-11-13 11:04:20 GMT\\nCompleted-Local: 2026-11-13 18:04:20 +0700\\nCoding-Agent: codex\\nRole: Architect, slice-3 design consult\\nReviewed checkout: p7b-ticks @ 38375bf7\\nStatus: counter ruling complete; implementation and formal corpus acceptance remain outstanding\\n\\n**Ruling: one counter per PHP request, with the threshold supplied by each selected statement-completion hook.** There is no counter per declare occurrence, source file, function/op_array, closure, or generator. Lexical scope controls which completion sites exist and their thresholds; it does not partition the runtime count.\\n\\nThis is supported both by PHP-8.3 source inspection and direct execution of 21 small programs on shiva's PHP 8.3.35 oracle image. All five staged expectations match. This consult changes only this findings artifact: no source, test, design-document, fixture-provenance, or branch changes; no commit or push.\\n\\n**Findings and reconciliation**\\n\\n| Severity | Location | Evidence / required correction |\\n|---|---|---|\\n| P1 — contradictory implementation instruction | `collab/yang-php/1794567390000-engineer-p7b-ticks-c.prompt.md:20` | The explicit “a count is per declare-site, PHP semantics” instruction is incorrect. Replace it with the request-owned counter rule in this ruling. Part C was right to escalate the conflict instead of claiming parity. |\\n| Resolved — slice-3 ownership | `collab/orch-lane/1794700000000-architect-safepoint-slice3-design.gpt-6.1-sol.findings.md:103` | The text explicitly says “request-owned counter” and says state survives calls, includes, and generator switches. Its lifecycle table at lines 123–127 and implementation assignment at line 257 reinforce that contract. The implementer's request-wide reading is correct. |\\n| P2 — stale design status/timing | `docs/design/yang.php.md:1938` | §12 still says sites are before statements and the generic extension refuses non-lambdas. The implemented after-wrapper is at `src/cljc/yang/safepoint.cljc:153`; PHP's profile is at `src/cljc/yang/php/antlr/safepoint.cljc:13`. Reconcile §12 in the implementation round. |\\n| P1 — acceptance does not discriminate ownership | `test/yang/php/antlr/programs_p7b.cljc:10` | Every staged tick threshold is 1. All these outputs can pass with an incorrectly partitioned counter. Add N>1 boundary/threshold cases below before claiming counter parity. |\\n| P2 — oracle exit status is insufficient for pending rows | `src/dev/yang/php/oracle.clj:558` | Pending rows are excluded from failures, while `check-p7-fixture` at line 492 deliberately leaves their `:pass?` false. Read and compare actual records; exit 0 / “failures: 0” alone proves no parity for these rows. |\\n\\nI own the reconciliation failure between the design, stale documentation, and implementation brief. The slice-3 counter paragraph itself was explicit, not ambiguous. Its omission of a compact lexical-versus-runtime decision table made the broader artifact set easier to misread. At this checkout, neither §12 nor the §15 P7-b row (`yang.php.md:2106`) actually specifies a per-declare counter; §15 requires PHP-equivalent tick counts. File-scoped compilation does not imply file-owned execution state.\\n\\n**PHP 8.3 source evidence**\\n\\nThe links below refer to the PHP-8.3 branch inspected for this consult; line numbers are ordinary one-based file lines. They are source references, not a claim that the moving branch is the exact source hash of the oracle image.\\n\\n- [Zend/zend_globals.h:187](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_globals.h#L187): `ticks_count` is a field of executor globals.\\n- [Zend/zend_execute_API.c:151](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute_API.c#L151): `init_executor()` initializes it to zero for execution/request startup.\\n- [Zend/zend_execute.c:5153](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute.c#L5153) includes generated `zend_vm_execute.h`. The tick handler's maintained definition is [Zend/zend_vm_def.h:7439–7452](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7439). Its test is `(uint32_t)++EG(ticks_count) >= opline->extended_value`; it resets the count before calling the tick dispatcher. It counts even when no dispatcher is installed. This is an executor-global accumulator and an instruction-local threshold, not op_array-local state.\\n- Compiler mechanism: [Zend/zend_compile.c:344–361](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L344) initializes a new file's compile-time ticks setting to zero and restores the prior file context on exit. [Lines 5938–5994](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L5938) convert the directive literal to a long, update that setting, compile a block, and restore its prior setting; the semicolon form leaves it changed. [Lines 7065–7200](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L7065) switch function op_arrays without starting a fresh file context. [Lines 9784–9785](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9784) emit ticks after selected statements when the setting is nonzero. [Lines 2110–2121](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2110) place that setting in the instruction's extended operand and suppress adjacent duplicate tick emission. [Lines 2518–2522](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2518) enumerate excluded statement categories; [lines 9659–9668](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9659) separately handle top-level function/class declarations. A blanket “hook every AST statement” translation is insufficient.\\n- [Zend/zend_vm_def.h:7867–7874](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7867): yield saves the next instruction and returns. [Zend/zend_generators.c:706–828](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_generators.c#L706) restores execution frames/JIT context around resume, not a saved tick count.\\n- [ext/standard/basic_functions.c:1549–1569](https://github.com/php/php-src/blob/PHP-8.3/ext/standard/basic_functions.c#L1549): user tick dispatch guards each executing registered entry against reentry. Do not replace this with a global “ticks busy” rule that stops counting all guest tick sites. Registered callback arguments are its registration arguments, not the line/unit/threshold operands.\\n\\nThus switching files or op_arrays changes the instructions being executed, and possibly their embedded thresholds, without selecting a different counter. The runtime probes below independently confirm the relevant observable consequences.\\n\\n**Normative decision table for the implementer**\\n\\n| Concern | Required behavior |\\n|---|---|\\n| Counter owner | Allocate one explicit guest request-owned counter, initially 0, shared by all PHP tick hooks in that request. Keep it in existing guest execution/store machinery; introduce no host global or shared process state. |\\n| Increment and firing | On each selected normal completion, increment once. If the new count is **greater than or equal to** that site's N, reset to 0 **before** dispatching registered handlers. Do not use equality, modulo, subtraction of N, or a threshold-global “current N.” |\\n| Reset points | Request initialization and threshold firing only. No reset at declare entry/exit, function call/return, include/return, registration/unregistration, generator switch, or exception/context restoration. A new independent request starts from zero. |\\n| Empty registry | Continue incrementing/resetting at selected sites. Registration changes dispatch membership, not counter phase. Confirmed by the empty-registry probe. |\\n| Lexical N | Each mark carries its own effective compile-time N. An inner block directive overrides the enclosing value for its body; exiting that block restores the outer value for subsequent emitted sites. Entering/leaving either block does not reset the accumulated count. |\\n| N=0 | That lexical region contributes no tick instructions for its own statements; it does not clear accumulated progress. An enclosing nonzero context may still select the completion of the declare construct itself. |\\n| Directive syntax | Preserve block versus semicolon behavior and Zend's statement-selection/adjacent-suppression behavior. A directive can itself lead to a tick: the measured semicolon case below produces ATB, not ABT. There is no extra generic “enter declare” runtime reset or hook. |\\n| N validation/range | Ordinary positive integer thresholds and zero are the cases established here. Do not invent “all N<=0 disable ticks”: Zend's literal conversion and unsigned instruction operand are separate concerns. Broader literal/range acceptance needs its own oracle cases or an explicit supported-subset refusal. |\\n| Functions and closures | Retain body-site thresholds from compilation. A call from ticked code does not dynamically instrument an unticked body. A ticked body contributes to the same request count even when called from unticked code or after its defining include has returned. |\\n| Generator yield/resume | Preserve the pending after-hook in the continuation. Suspension itself does not complete the yield statement. On eventual normal completion run that hook once using the then-current request counter. Repeated inspection of a suspended value does not replay it. Never snapshot/restore the count with generator context. |\\n| Nonlocal exit | A statement whose normal completion is bypassed contributes no after-hook. Already completed sites retain their count effects through throw/unwind. A callback exception cannot undo the reset that preceded dispatch. A pending hook is not a finally hook. |\\n| Include/include_once | Included code has its own lexical sites/N; the caller's pragma is not inherited dynamically. All executed sites share the request counter. Repeated includes revisit their sites; a skipped once body contributes none. A selected caller include statement still completes and can tick even when the once body is skipped. |\\n| Budget/profile separation | Statement ticks do not charge `php.sp/tick`, the existing execution-budget hook. Preserve independently selected `:call`/`:loop` sites and the shared VM semantics. |\\n\\nThe intended profile and operand contract remains exactly:\\n\\n```clojure\\n{:line {:hook 'php.sp/line :operands true :after true}}\\n\\n[:line n {:unit unit-path :ticks N}]\\n;; derives:\\n(php.sp/line n {:unit unit-path :ticks N})\\n```\\n\\nHere `n` and `:unit` identify the source occurrence; neither is a counter key. `:ticks` is the effective instruction threshold, not a declaration identifier. The generic safepoint stage transports literals and performs value-preserving normal-completion placement; PHP lowering owns eligible-site selection and PHP runtime code owns counting/dispatch. Omitting `:line` from a derivation profile omits these hooks; canonical program rows remain unchanged.\\n\\n**Include-site handoff remains a landing requirement**\\n\\nThe source-unit operand does not itself transport marks through publication. At `src/cljc/yang/php/antlr/publication.cljc:42`, `:site-set` is still nil. Preserve slice-3 lines 133–154: publish and retrieve verified occurrence site sets bound to the canonical root/source association; derive included executable images using the selected ticks profile; pin the hook dependency and derived images; handle SCC bundles and repin member aliases. Missing required metadata must fail closed, whereas a verified empty set for an unticked unit is legitimate.\\n\\nEvery derived module must resolve the same request's hook/state. Including a module must not reinitialize the tick registry or accumulator. A retained closure keeps its defining unit's operands and uses the active request's shared counter. No extra counter indexed by declaration, unit, or line is needed.\\n\\n**Measured fixture evidence**\\n\\nExecuted on `shiva.stigmergy.systems`, 2026-11-13, in fresh disposable containers per program. Existing tag `php:8.3-cli` reports PHP 8.3.35 CLI NTS / Zend 4.3.35, built 2026-10-06. The shorter `php:8.3` tag was not installed; no image was pulled.\\n\\n- Image ID: `sha256:7855de8f54c32ffc92720b20b550f2dbc1c82c2000c7a850ccf350f71c36293f`\\n- Repository digest: `php@sha256:aafe21201943a8a6e497ddfb471e2ce68ada76adede38c7d61fede8918b24319`\\n\\nEach main program and included unit was placed in a temporary directory, mounted read-only at /w, with this invocation:\\n\\n```sh\\ndocker run --rm --pull=never --network=none --read-only \\\\\\n  -v <temporary-directory>:/w:ro -w /w php:8.3-cli php \\\\\\n  -d display_errors=1 -d html_errors=0 -d error_reporting=E_ALL \\\\\\n  -d log_errors=0 -d auto_prepend_file=/w/pre.php main.php\\n```\\n\\nThe unticked pre.php was the exact staged prologue:\\n\\n```php\\n<?php function tick_handler() { echo 'T'; } register_tick_function('tick_handler');\\n```\\n\\nThis matches the P7 oracle runner's prepend-unit arrangement. Every one of the 21 executions exited 0 with empty stderr and exactly the stdout recorded here, with no diagnostics. Temporary directories were removed. These are independent direct PHP oracle measurements, **not** a run of the Clojure `--p7` wrapper or of yang.php.\\n\\n| Fixture and source location | Staged expected | Measured PHP 8.3.35 | Interpretation |\\n|---|---|---|---|\\n| sequence, `programs_p7b.cljc:10` | ATTBT | ATTBT | Three completions: echo A, assignment, echo B. |\\n| loop-body, line 12 | ATAT | ATAT | Only the inner declared body is ticked; loop machinery is outside its directive. |\\n| function-call, line 14 | FT | FT | f's body is unticked; the call statement's normal completion ticks. |\\n| generator-resume, line 16 | ATBT | ATBT | current() suspends at yield; A prints; next() completes yield and ticks, then B completes and ticks. |\\n| include-handoff, line 19 | LT | LT | Included lib.php owns a ticked echo site; the caller is unticked. |\\n\\nThe sequence variants also confirm the slice-3 proposals: N=2 gives ATB; N=0 gives AB.\\n\\n**Oracle acceptance ruling**\\n\\nThere is no remaining choice between counter architectures: the source mechanism and the N>1 measurements settle it in favor of the request-owned count. PHP remains the authority for exact site selection and observable output if a lowering prediction disagrees.\\n\\nThe formal `--p7` pass on shiva MUST compare all five current IDs: `:sequence`, `:loop-body`, `:function-call`, `:generator-resume`, and `:include-handoff`, including output, absence of diagnostics/uncaught errors, and successful exit. Record actual version, image digest, host, and date. Do not infer a passing fixture from the current runner's pending-row exit status. This consult leaves all `:oracle :pending` fields untouched.\\n\\nFor counter-ownership acceptance, the implementer must add and oracle-confirm at least separate-declares, nested-threshold, cross-function, cross-include, and generator-shared from the appendix. Also retain the zero-gap, unticked-include, registration/empty-registry, retained-closure, exception, once-skip, and semicolon regressions. The original five N=1 rows cannot replace these discriminators. P7-b's remaining lowering/runtime/linking gates and the broader slice-3 callback/escape/cleanup cases remain required; this consult is not implementation sign-off.\\n\\n**Reproducible additional probes**\\n\\nEach source below is main.php after an opening PHP tag, with the same separate pre.php above. Where shown, lib.php is a separate file. Outputs are observations, not new hand-derived goldens.\\n\\n**sequence-n2 — measured `ATB`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\\n```\\n\\n**sequence-n0 — measured `AB`.**\\n\\n```php\\ndeclare(ticks=0) { echo 'A'; $x = 1; echo 'B'; }\\n```\\n\\n**separate-declares — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } declare(ticks=2) { echo 'B'; }\\n```\\n\\n**nested-threshold — measured `ABCTD`.**\\n\\n```php\\ndeclare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\n```\\n\\n**zero-gap — measured `ABCT`.**\\n\\n```php\\ndeclare(ticks=3) { echo 'A'; } declare(ticks=0) { echo 'B'; } declare(ticks=3) { echo 'C'; $x=1; }\\n```\\n\\n**cross-function — measured `AFT`.**\\n\\n```php\\nfunction f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\n```\\n\\n**repeat-function — measured `F|FT`.**\\n\\n```php\\nfunction f() { declare(ticks=2) { echo 'F'; } } f(); echo '|'; f();\\n```\\n\\n**cross-include — measured `ALT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } include 'lib.php';\\n```\\nlib.php:\\n```php\\n<?php declare(ticks=2) { echo 'L'; }\\n```\\n\\n**unticked-include — measured `ALTB`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; include 'lib.php'; echo 'B'; }\\n```\\nlib.php:\\n```php\\n<?php echo 'L';\\n```\\n\\n**generator-shared — measured `ABTC`.**\\n\\n```php\\nfunction g() { declare(ticks=2) { yield 1; } } $a=g(); $b=g(); $a->current(); $b->current(); echo 'A'; $a->next(); echo 'B'; $b->next(); echo 'C';\\n```\\n\\n**registration-no-reset — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } unregister_tick_function('tick_handler'); register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\n```\\n\\n**empty-registry — measured `ABT`.**\\n\\n```php\\nunregister_tick_function('tick_handler'); declare(ticks=2) { echo 'A'; } register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\n```\\n\\n**semicolon-directive — measured `ATB`.**\\n\\n```php\\ndeclare(ticks=2); echo 'A'; echo 'B';\\n```\\n\\n**include-closure — measured `AFBFT`.**\\n\\n```php\\ninclude 'lib.php'; echo 'A'; $f(); echo 'B'; $f();\\n```\\nlib.php:\\n```php\\n<?php $f=function(){ declare(ticks=2) { echo 'F'; } };\\n```\\n\\n**exception-no-reset — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } try { throw new Exception(); } catch (Exception $e) {} declare(ticks=2) { echo 'B'; }\\n```\\n\\n**once-skip — measured `LBT`.**\\n\\n```php\\ninclude_once 'lib.php'; include_once 'lib.php'; declare(ticks=2) { echo 'B'; }\\n```\\nlib.php:\\n```php\\n<?php declare(ticks=2) { echo 'L'; }\\n```\\n\\n**Review scope and properties confirmed**\\n\\nRead the repository architecture rules, slice-3 design, §12/§15, part-C brief/findings, staged programs/tests, PHP profile and shared after-wrapper, publication seam, and P7 oracle wrapper. Inspected the cited PHP-8.3 compiler/executor/generator/callback sources. Confirmed request-owned explicit state, lexical operand ownership, budget separation, after-normal-completion placement, and unchanged generic VM semantics as the intended architecture. Ran only the 21 direct PHP probes; no Clojure/Node/Dart implementation gates or formal corpus fold were run. The profile declaration exists, but `php.sp/line`, lowering/registry integration, and linked site handoff remain the implementer's work.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794568493000-engineer-p7b-ticks-f.gpt-6.1-terra.stdout.log:17:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat test/yang/php/antlr/ticks_test.clj; cat test/yang/php/antlr/programs_p7b.cljc; rg -n 'shutdown-fn|register_shutdown|bi-register|defn site|defn.*envelope|:yang/site' src/cljc/yang/php/antlr/{prelude,builtins,core,lower}.cljc src/cljc/yang/core/uast.cljc\\\"\",\"aggregated_output\":\"(ns yang.php.antlr.ticks-test\\n  (:require\\n    [clojure.test :refer [deftest is testing]]\\n    [yang.php.antlr.cst :as cst]\\n    [yang.php.antlr.e2e-harness :as h]\\n    [yang.php.antlr.linked-harness :as lh]\\n    [yang.php.antlr.programs-p7b :as p7b]))\\n\\n\\n(deftest tick-fixtures-test\\n  (doseq [{:keys [id source out units]} p7b/fixtures\\n          :when (nil? units)]\\n    (testing (name id)\\n      (is (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))))))\\n\\n\\n(deftest include-handoff-test\\n  (let [{:keys [source units out]} (last p7b/fixtures)\\n        packets (update-vals (assoc units \\\"main.php\\\" (str \\\"<?php \\\" p7b/prologue source))\\n                             cst/parse-source)\\n        result (lh/run-fixture packets \\\"main.php\\\" {})]\\n    (doseq [[vm value] (:values result)]\\n      (is (= out (h/latin1->text (:php/out value))) (name vm)))))\\n(ns yang.php.antlr.programs-p7b\\n  \\\"Hand-derived tick expectations pending the pinned PHP oracle pass.\\\")\\n\\n\\n(def prologue\\n  \\\"function tick_handler() { echo 'T'; } register_tick_function('tick_handler'); \\\")\\n\\n\\n(def fixtures\\n  [{:id :sequence, :source \\\"declare(ticks=1) { echo 'A'; $x = 1; echo 'B'; }\\\",\\n    :out \\\"ATTBT\\\", :oracle :pending}\\n   {:id :loop-body, :source \\\"for ($i=0; $i<2; $i++) { declare(ticks=1) { echo 'A'; } }\\\",\\n    :out \\\"ATAT\\\", :oracle :pending}\\n   {:id :function-call, :source \\\"function f() { echo 'F'; } declare(ticks=1) { f(); }\\\",\\n    :out \\\"FT\\\", :oracle :pending}\\n   {:id :generator-resume,\\n    :source \\\"function g() { declare(ticks=1) { yield 1; echo 'B'; } } $g=g(); $g->current(); echo 'A'; $g->next();\\\",\\n    :out \\\"ATBT\\\", :oracle :pending}\\n   {:id :sequence-n2, :source \\\"declare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\\\",\\n    :out \\\"ATB\\\", :oracle :pending}\\n   {:id :nested-threshold,\\n    :source \\\"declare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\\",\\n    :out \\\"ABCTD\\\", :oracle :pending}\\n   {:id :cross-function,\\n    :source \\\"function f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\\",\\n    :out \\\"AFT\\\", :oracle :pending}\\n   {:id :semicolon-directive, :source \\\"declare(ticks=2); echo 'A'; echo 'B';\\\",\\n    :out \\\"ATB\\\", :oracle :pending}\\n   {:id :include-handoff, :source \\\"include 'lib.php';\\\",\\n    :units {\\\"lib.php\\\" \\\"<?php declare(ticks=1) { echo 'L'; }\\\"},\\n    :out \\\"LT\\\", :oracle :pending}])\\nrg: src/cljc/yang/php/antlr/core.cljc: No such file or directory (os error 2)\\nsrc/cljc/yang/core/uast.cljc:122:;; `:yang/site`, the safepoint mark, which travels as node metadata.\\nsrc/cljc/yang/php/antlr/builtins.cljc:50:                   \\\"register_shutdown_function\\\" 'php/bi-register-shutdown-function,\\nsrc/cljc/yang/php/antlr/prelude.cljc:4452:    [php/run-shutdown-fns\\nsrc/cljc/yang/php/antlr/prelude.cljc:4455:       (let [fns (cell/get php.rt/shutdown-fns)]\\nsrc/cljc/yang/php/antlr/prelude.cljc:4458:               (php/run-shutdown-fns (+ i 1)))\\nsrc/cljc/yang/php/antlr/prelude.cljc:4463:    [php/bi-register-shutdown-function\\nsrc/cljc/yang/php/antlr/prelude.cljc:4465:       (do (cell/set! php.rt/shutdown-fns\\nsrc/cljc/yang/php/antlr/prelude.cljc:4466:                      (php/vconj (cell/get php.rt/shutdown-fns)\\nsrc/cljc/yang/php/antlr/prelude.cljc:4509:       (do (php/run-shutdown-fns 0)\\nsrc/cljc/yang/php/antlr/prelude.cljc:6106:                 (define 'php.rt/shutdown-fns '(cell/new []))\\nsrc/cljc/yang/php/antlr/prelude.cljc:6195:    php.rt/shutdown-fns php.rt/exit-status php.rt/in-shutdown php.rt/fatal-escape\\n\",\"exit_code\":2,\"status\":\"failed\"}}\ncollab/yang-php/1794568084000-engineer-p7b-ticks-d.gpt-6.1-terra.stdout.log:5:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.findings.md && cat docs/design/datom.world.md'\",\"aggregated_output\":\"Completed-GMT: 2026-11-13 11:04:20 GMT\\nCompleted-Local: 2026-11-13 18:04:20 +0700\\nCoding-Agent: codex\\nRole: Architect, slice-3 design consult\\nReviewed checkout: p7b-ticks @ 38375bf7\\nStatus: counter ruling complete; implementation and formal corpus acceptance remain outstanding\\n\\n**Ruling: one counter per PHP request, with the threshold supplied by each selected statement-completion hook.** There is no counter per declare occurrence, source file, function/op_array, closure, or generator. Lexical scope controls which completion sites exist and their thresholds; it does not partition the runtime count.\\n\\nThis is supported both by PHP-8.3 source inspection and direct execution of 21 small programs on shiva's PHP 8.3.35 oracle image. All five staged expectations match. This consult changes only this findings artifact: no source, test, design-document, fixture-provenance, or branch changes; no commit or push.\\n\\n**Findings and reconciliation**\\n\\n| Severity | Location | Evidence / required correction |\\n|---|---|---|\\n| P1 — contradictory implementation instruction | `collab/yang-php/1794567390000-engineer-p7b-ticks-c.prompt.md:20` | The explicit “a count is per declare-site, PHP semantics” instruction is incorrect. Replace it with the request-owned counter rule in this ruling. Part C was right to escalate the conflict instead of claiming parity. |\\n| Resolved — slice-3 ownership | `collab/orch-lane/1794700000000-architect-safepoint-slice3-design.gpt-6.1-sol.findings.md:103` | The text explicitly says “request-owned counter” and says state survives calls, includes, and generator switches. Its lifecycle table at lines 123–127 and implementation assignment at line 257 reinforce that contract. The implementer's request-wide reading is correct. |\\n| P2 — stale design status/timing | `docs/design/yang.php.md:1938` | §12 still says sites are before statements and the generic extension refuses non-lambdas. The implemented after-wrapper is at `src/cljc/yang/safepoint.cljc:153`; PHP's profile is at `src/cljc/yang/php/antlr/safepoint.cljc:13`. Reconcile §12 in the implementation round. |\\n| P1 — acceptance does not discriminate ownership | `test/yang/php/antlr/programs_p7b.cljc:10` | Every staged tick threshold is 1. All these outputs can pass with an incorrectly partitioned counter. Add N>1 boundary/threshold cases below before claiming counter parity. |\\n| P2 — oracle exit status is insufficient for pending rows | `src/dev/yang/php/oracle.clj:558` | Pending rows are excluded from failures, while `check-p7-fixture` at line 492 deliberately leaves their `:pass?` false. Read and compare actual records; exit 0 / “failures: 0” alone proves no parity for these rows. |\\n\\nI own the reconciliation failure between the design, stale documentation, and implementation brief. The slice-3 counter paragraph itself was explicit, not ambiguous. Its omission of a compact lexical-versus-runtime decision table made the broader artifact set easier to misread. At this checkout, neither §12 nor the §15 P7-b row (`yang.php.md:2106`) actually specifies a per-declare counter; §15 requires PHP-equivalent tick counts. File-scoped compilation does not imply file-owned execution state.\\n\\n**PHP 8.3 source evidence**\\n\\nThe links below refer to the PHP-8.3 branch inspected for this consult; line numbers are ordinary one-based file lines. They are source references, not a claim that the moving branch is the exact source hash of the oracle image.\\n\\n- [Zend/zend_globals.h:187](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_globals.h#L187): `ticks_count` is a field of executor globals.\\n- [Zend/zend_execute_API.c:151](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute_API.c#L151): `init_executor()` initializes it to zero for execution/request startup.\\n- [Zend/zend_execute.c:5153](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute.c#L5153) includes generated `zend_vm_execute.h`. The tick handler's maintained definition is [Zend/zend_vm_def.h:7439–7452](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7439). Its test is `(uint32_t)++EG(ticks_count) >= opline->extended_value`; it resets the count before calling the tick dispatcher. It counts even when no dispatcher is installed. This is an executor-global accumulator and an instruction-local threshold, not op_array-local state.\\n- Compiler mechanism: [Zend/zend_compile.c:344–361](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L344) initializes a new file's compile-time ticks setting to zero and restores the prior file context on exit. [Lines 5938–5994](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L5938) convert the directive literal to a long, update that setting, compile a block, and restore its prior setting; the semicolon form leaves it changed. [Lines 7065–7200](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L7065) switch function op_arrays without starting a fresh file context. [Lines 9784–9785](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9784) emit ticks after selected statements when the setting is nonzero. [Lines 2110–2121](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2110) place that setting in the instruction's extended operand and suppress adjacent duplicate tick emission. [Lines 2518–2522](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2518) enumerate excluded statement categories; [lines 9659–9668](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9659) separately handle top-level function/class declarations. A blanket “hook every AST statement” translation is insufficient.\\n- [Zend/zend_vm_def.h:7867–7874](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7867): yield saves the next instruction and returns. [Zend/zend_generators.c:706–828](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_generators.c#L706) restores execution frames/JIT context around resume, not a saved tick count.\\n- [ext/standard/basic_functions.c:1549–1569](https://github.com/php/php-src/blob/PHP-8.3/ext/standard/basic_functions.c#L1549): user tick dispatch guards each executing registered entry against reentry. Do not replace this with a global “ticks busy” rule that stops counting all guest tick sites. Registered callback arguments are its registration arguments, not the line/unit/threshold operands.\\n\\nThus switching files or op_arrays changes the instructions being executed, and possibly their embedded thresholds, without selecting a different counter. The runtime probes below independently confirm the relevant observable consequences.\\n\\n**Normative decision table for the implementer**\\n\\n| Concern | Required behavior |\\n|---|---|\\n| Counter owner | Allocate one explicit guest request-owned counter, initially 0, shared by all PHP tick hooks in that request. Keep it in existing guest execution/store machinery; introduce no host global or shared process state. |\\n| Increment and firing | On each selected normal completion, increment once. If the new count is **greater than or equal to** that site's N, reset to 0 **before** dispatching registered handlers. Do not use equality, modulo, subtraction of N, or a threshold-global “current N.” |\\n| Reset points | Request initialization and threshold firing only. No reset at declare entry/exit, function call/return, include/return, registration/unregistration, generator switch, or exception/context restoration. A new independent request starts from zero. |\\n| Empty registry | Continue incrementing/resetting at selected sites. Registration changes dispatch membership, not counter phase. Confirmed by the empty-registry probe. |\\n| Lexical N | Each mark carries its own effective compile-time N. An inner block directive overrides the enclosing value for its body; exiting that block restores the outer value for subsequent emitted sites. Entering/leaving either block does not reset the accumulated count. |\\n| N=0 | That lexical region contributes no tick instructions for its own statements; it does not clear accumulated progress. An enclosing nonzero context may still select the completion of the declare construct itself. |\\n| Directive syntax | Preserve block versus semicolon behavior and Zend's statement-selection/adjacent-suppression behavior. A directive can itself lead to a tick: the measured semicolon case below produces ATB, not ABT. There is no extra generic “enter declare” runtime reset or hook. |\\n| N validation/range | Ordinary positive integer thresholds and zero are the cases established here. Do not invent “all N<=0 disable ticks”: Zend's literal conversion and unsigned instruction operand are separate concerns. Broader literal/range acceptance needs its own oracle cases or an explicit supported-subset refusal. |\\n| Functions and closures | Retain body-site thresholds from compilation. A call from ticked code does not dynamically instrument an unticked body. A ticked body contributes to the same request count even when called from unticked code or after its defining include has returned. |\\n| Generator yield/resume | Preserve the pending after-hook in the continuation. Suspension itself does not complete the yield statement. On eventual normal completion run that hook once using the then-current request counter. Repeated inspection of a suspended value does not replay it. Never snapshot/restore the count with generator context. |\\n| Nonlocal exit | A statement whose normal completion is bypassed contributes no after-hook. Already completed sites retain their count effects through throw/unwind. A callback exception cannot undo the reset that preceded dispatch. A pending hook is not a finally hook. |\\n| Include/include_once | Included code has its own lexical sites/N; the caller's pragma is not inherited dynamically. All executed sites share the request counter. Repeated includes revisit their sites; a skipped once body contributes none. A selected caller include statement still completes and can tick even when the once body is skipped. |\\n| Budget/profile separation | Statement ticks do not charge `php.sp/tick`, the existing execution-budget hook. Preserve independently selected `:call`/`:loop` sites and the shared VM semantics. |\\n\\nThe intended profile and operand contract remains exactly:\\n\\n```clojure\\n{:line {:hook 'php.sp/line :operands true :after true}}\\n\\n[:line n {:unit unit-path :ticks N}]\\n;; derives:\\n(php.sp/line n {:unit unit-path :ticks N})\\n```\\n\\nHere `n` and `:unit` identify the source occurrence; neither is a counter key. `:ticks` is the effective instruction threshold, not a declaration identifier. The generic safepoint stage transports literals and performs value-preserving normal-completion placement; PHP lowering owns eligible-site selection and PHP runtime code owns counting/dispatch. Omitting `:line` from a derivation profile omits these hooks; canonical program rows remain unchanged.\\n\\n**Include-site handoff remains a landing requirement**\\n\\nThe source-unit operand does not itself transport marks through publication. At `src/cljc/yang/php/antlr/publication.cljc:42`, `:site-set` is still nil. Preserve slice-3 lines 133–154: publish and retrieve verified occurrence site sets bound to the canonical root/source association; derive included executable images using the selected ticks profile; pin the hook dependency and derived images; handle SCC bundles and repin member aliases. Missing required metadata must fail closed, whereas a verified empty set for an unticked unit is legitimate.\\n\\nEvery derived module must resolve the same request's hook/state. Including a module must not reinitialize the tick registry or accumulator. A retained closure keeps its defining unit's operands and uses the active request's shared counter. No extra counter indexed by declaration, unit, or line is needed.\\n\\n**Measured fixture evidence**\\n\\nExecuted on `shiva.stigmergy.systems`, 2026-11-13, in fresh disposable containers per program. Existing tag `php:8.3-cli` reports PHP 8.3.35 CLI NTS / Zend 4.3.35, built 2026-10-06. The shorter `php:8.3` tag was not installed; no image was pulled.\\n\\n- Image ID: `sha256:7855de8f54c32ffc92720b20b550f2dbc1c82c2000c7a850ccf350f71c36293f`\\n- Repository digest: `php@sha256:aafe21201943a8a6e497ddfb471e2ce68ada76adede38c7d61fede8918b24319`\\n\\nEach main program and included unit was placed in a temporary directory, mounted read-only at /w, with this invocation:\\n\\n```sh\\ndocker run --rm --pull=never --network=none --read-only \\\\\\n  -v <temporary-directory>:/w:ro -w /w php:8.3-cli php \\\\\\n  -d display_errors=1 -d html_errors=0 -d error_reporting=E_ALL \\\\\\n  -d log_errors=0 -d auto_prepend_file=/w/pre.php main.php\\n```\\n\\nThe unticked pre.php was the exact staged prologue:\\n\\n```php\\n<?php function tick_handler() { echo 'T'; } register_tick_function('tick_handler');\\n```\\n\\nThis matches the P7 oracle runner's prepend-unit arrangement. Every one of the 21 executions exited 0 with empty stderr and exactly the stdout recorded here, with no diagnostics. Temporary directories were removed. These are independent direct PHP oracle measurements, **not** a run of the Clojure `--p7` wrapper or of yang.php.\\n\\n| Fixture and source location | Staged expected | Measured PHP 8.3.35 | Interpretation |\\n|---|---|---|---|\\n| sequence, `programs_p7b.cljc:10` | ATTBT | ATTBT | Three completions: echo A, assignment, echo B. |\\n| loop-body, line 12 | ATAT | ATAT | Only the inner declared body is ticked; loop machinery is outside its directive. |\\n| function-call, line 14 | FT | FT | f's body is unticked; the call statement's normal completion ticks. |\\n| generator-resume, line 16 | ATBT | ATBT | current() suspends at yield; A prints; next() completes yield and ticks, then B completes and ticks. |\\n| include-handoff, line 19 | LT | LT | Included lib.php owns a ticked echo site; the caller is unticked. |\\n\\nThe sequence variants also confirm the slice-3 proposals: N=2 gives ATB; N=0 gives AB.\\n\\n**Oracle acceptance ruling**\\n\\nThere is no remaining choice between counter architectures: the source mechanism and the N>1 measurements settle it in favor of the request-owned count. PHP remains the authority for exact site selection and observable output if a lowering prediction disagrees.\\n\\nThe formal `--p7` pass on shiva MUST compare all five current IDs: `:sequence`, `:loop-body`, `:function-call`, `:generator-resume`, and `:include-handoff`, including output, absence of diagnostics/uncaught errors, and successful exit. Record actual version, image digest, host, and date. Do not infer a passing fixture from the current runner's pending-row exit status. This consult leaves all `:oracle :pending` fields untouched.\\n\\nFor counter-ownership acceptance, the implementer must add and oracle-confirm at least separate-declares, nested-threshold, cross-function, cross-include, and generator-shared from the appendix. Also retain the zero-gap, unticked-include, registration/empty-registry, retained-closure, exception, once-skip, and semicolon regressions. The original five N=1 rows cannot replace these discriminators. P7-b's remaining lowering/runtime/linking gates and the broader slice-3 callback/escape/cleanup cases remain required; this consult is not implementation sign-off.\\n\\n**Reproducible additional probes**\\n\\nEach source below is main.php after an opening PHP tag, with the same separate pre.php above. Where shown, lib.php is a separate file. Outputs are observations, not new hand-derived goldens.\\n\\n**sequence-n2 — measured `ATB`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\\n```\\n\\n**sequence-n0 — measured `AB`.**\\n\\n```php\\ndeclare(ticks=0) { echo 'A'; $x = 1; echo 'B'; }\\n```\\n\\n**separate-declares — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } declare(ticks=2) { echo 'B'; }\\n```\\n\\n**nested-threshold — measured `ABCTD`.**\\n\\n```php\\ndeclare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\n```\\n\\n**zero-gap — measured `ABCT`.**\\n\\n```php\\ndeclare(ticks=3) { echo 'A'; } declare(ticks=0) { echo 'B'; } declare(ticks=3) { echo 'C'; $x=1; }\\n```\\n\\n**cross-function — measured `AFT`.**\\n\\n```php\\nfunction f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\n```\\n\\n**repeat-function — measured `F|FT`.**\\n\\n```php\\nfunction f() { declare(ticks=2) { echo 'F'; } } f(); echo '|'; f();\\n```\\n\\n**cross-include — measured `ALT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } include 'lib.php';\\n```\\nlib.php:\\n```php\\n<?php declare(ticks=2) { echo 'L'; }\\n```\\n\\n**unticked-include — measured `ALTB`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; include 'lib.php'; echo 'B'; }\\n```\\nlib.php:\\n```php\\n<?php echo 'L';\\n```\\n\\n**generator-shared — measured `ABTC`.**\\n\\n```php\\nfunction g() { declare(ticks=2) { yield 1; } } $a=g(); $b=g(); $a->current(); $b->current(); echo 'A'; $a->next(); echo 'B'; $b->next(); echo 'C';\\n```\\n\\n**registration-no-reset — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } unregister_tick_function('tick_handler'); register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\n```\\n\\n**empty-registry — measured `ABT`.**\\n\\n```php\\nunregister_tick_function('tick_handler'); declare(ticks=2) { echo 'A'; } register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\n```\\n\\n**semicolon-directive — measured `ATB`.**\\n\\n```php\\ndeclare(ticks=2); echo 'A'; echo 'B';\\n```\\n\\n**include-closure — measured `AFBFT`.**\\n\\n```php\\ninclude 'lib.php'; echo 'A'; $f(); echo 'B'; $f();\\n```\\nlib.php:\\n```php\\n<?php $f=function(){ declare(ticks=2) { echo 'F'; } };\\n```\\n\\n**exception-no-reset — measured `ABT`.**\\n\\n```php\\ndeclare(ticks=2) { echo 'A'; } try { throw new Exception(); } catch (Exception $e) {} declare(ticks=2) { echo 'B'; }\\n```\\n\\n**once-skip — measured `LBT`.**\\n\\n```php\\ninclude_once 'lib.php'; include_once 'lib.php'; declare(ticks=2) { echo 'B'; }\\n```\\nlib.php:\\n```php\\n<?php declare(ticks=2) { echo 'L'; }\\n```\\n\\n**Review scope and properties confirmed**\\n\\nRead the repository architecture rules, slice-3 design, §12/§15, part-C brief/findings, staged programs/tests, PHP profile and shared after-wrapper, publication seam, and P7 oracle wrapper. Inspected the cited PHP-8.3 compiler/executor/generator/callback sources. Confirmed request-owned explicit state, lexical operand ownership, budget separation, after-normal-completion placement, and unchanged generic VM semantics as the intended architecture. Ran only the 21 direct PHP probes; no Clojure/Node/Dart implementation gates or formal corpus fold were run. The profile declaration exists, but `php.sp/line`, lowering/registry integration, and linked site handoff remain the implementer's work.\\n---\\ndescription: Core philosophy, foundational axioms, invariants, primitives (tuples, streams, host boundaries), architectural commitments, design principles, code style, and development workflow for datom.world\\n---\\n\\n# DATOM.WORLD ARCHITECTURAL FOUNDATIONS & DEVELOPMENT RULES\\n\\n## Core Philosophy\\n\\nEverything is data.\\nInterpretation > abstraction.\\nExplicit causality > implicit assumptions.\\nRestrictions are a feature.\\n\\n### Foundational Axioms\\n\\n1. **Everything is a Stream**: Portable I/O and system data flow through append-only streams; hosts may also install explicit local functions that perform direct I/O.\\n2. **Interpretation Creates Semantics**: Data is syntax; semantics only emerge through interpretation (one truth, many perspectives).\\n   At system scale, a \\\"system\\\" is an emergent property of interpreters of\\n   pure data, not an object, service, or stored artifact. Find the\\n   interpreters and the data they share to find the system.\\n3. **Code and State are Datoms**: Code (Universal AST) and runtime execution state are structured datoms, enabling syntax independence and structural reflection.\\n4. **Everything is a Continuation**: Computation is modeled as serializable, portable continuations that can pause, travel across streams, and resume anywhere.\\n\\n## Non-Negotiable Invariants\\n\\n- Do not introduce hidden global state.\\n- Do not introduce implicit control flow.\\n- Do not introduce callbacks; every callback is an event on a stream.\\n- Do not introduce shared mutable state.\\n- Do not collapse interpretation and execution into the same layer.\\n- Do not assume graphs: graphs must be constructed explicitly from tuples.\\n- Do not lose information (unitarity): streams are append-only and no datom is destroyed, only reinterpreted. The Universal AST is never lost: it is always retrievable wherever code is lowered, by address or by a query over its datoms. Every derived form (semantic vector, native images, indexes) is an interpretation of it and may drop facts only because the AST remains.\\n\\n## Tuples and Datoms\\n\\nTuples are elements in an open moduli space, graded by dimension $n$. A tuple can be any dimension/size.\\nA datom is the canonical persistent tuple `[e a v t m]` (entity, attribute, value, transaction, metadata). Persistent facts are immutable datoms.\\nSource scope belongs to the interpreter, never to an appended tuple slot. Queries keep physical sources as separate db-values and express union or joins explicitly.\\n\\nSee [`docs/design/datom.md`](./datom.md) for full specification.\\n\\n## Streams\\n\\n`dao.stream` is an I/O monad and the system's portable I/O ABI. Functions consume streams and produce streams.\\nHosts may install arbitrary local functions, including direct I/O; their availability and migration semantics must be explicit.\\nPortable behavior cannot assume them; portable side effects appear as stream emissions. Direct-I/O host modules are explicitly local and non-migratable (owner decision, 2026-10-23).\\nStreams are values that can be sent through streams.\\nStreams carry whatever values the consumer needs: no datom requirement, no privileged payload shape.\\n\\nA stream has no privileged reader, and its meaning is not in it. Any number\\nof interpreters may observe the same medium, and each constructs its own\\nsemantics from the same batches: a `yin.vm` evaluator observing a program\\nstream constructs CESK state and executes it; `dao.space.index` observing\\nthe very same stream materializes covered indexes, so `dao.space.query/q`\\nanswers Datalog over the program as it grows. Neither knows the other\\nexists. The medium is their only coupling, and each observer's ignorance of\\nthe other is load-bearing: the evaluator never consults an index to run,\\nand the index never evaluates a form to index it. This is how axiom 2\\nbecomes architecture: one stream, many interpretations, none of them\\nthe stream's own.\\n\\nFunctions can take anything and return anything.\\nAgents are functions, closures, or continuations in `yin.vm` that communicate portably with the outside world through `dao.stream`. Portable agent behavior is specified through stream effects; host-local functions may also perform direct I/O.\\n\\nSee [`docs/design/dao.stream.md`](./dao.stream.md) for full stream specification.\\nSee [`docs/design/yin.vm.streams-all-the-way-down.md`](./yin.vm.streams-all-the-way-down.md) for VM architecture.\\n\\n### Host Boundaries\\n\\nA host boundary is the dao.stream abstraction boundary; implementations do not add contracts.\\n[datom.world.abi.md](./datom.world.abi.md) owns the doctrine, owner rulings, taxonomy, floor and custody rules.\\n\\n## Architectural Commitments\\n\\n- **`dao.jing` is syntax, agents are semantics**: the content-addressed encoding stays passive and payload-agnostic.\\n- **Macros are stream topology**: an evaluator knows nothing about macro expansion; expansion happens on the syntax side of a medium boundary, upstream of any evaluator.\\n- **Peer observers, one stream**: a generic evaluator and `dao.space` independently observe the same stream topic, as described under Streams. This is not a claim about any two consumers regardless of what they consume.\\n- **Observers are independent and optional**: nothing requires a medium to have any particular set of consumers. Which observers exist for a stream is a per-composition choice, not a design-time commitment.\\n\\n## Design Principles\\n\\nCode quality is measured by malleability: how cheaply can changes adapt without breaking promises?\\nStigmergic coordination emerges from sharing data across streams.\\n\\n**Systems emerge from interpreters of pure data.** Streams are the\\ncomposition medium; each interpreter gives the same data a perspective\\nwithout collapsing interpretation into execution or owning the truth.\\n\\n- `dao.space` emerges from `dao.space.index` and `dao.space.query` over\\n  ordinary streams.\\n- ShiBi capability, metering, and budget emerge from different\\n  interpreters over the same tuples; no token object is stored.\\n- The four VMs interpret one Universal AST; many syntaxes feed that AST.\\n- The semantic AST in `dao.space` is queryable facts projected by the\\n  auto-index observer.\\n- Client and server are roles in one stigmergic behavior implemented by\\n  interpreters, not distinct kinds of nodes.\\n\\n**Derive, don't persist.** Before adding a tag, slot, or field to any\\ncanonical content-hashed structure (an AST grammar, a datom schema, a row\\nshape), check whether a correctly scoped Datalog query over\\n`dao.space.query/q` can already compute the fact. If it can, it belongs as a\\nquery or projection: new persisted structure migrates every downstream\\nconsumer and duplicates authority over a fact a query derives fresh. The\\nretired `:global` tag in\\n[`docs/design/yin.vm.code-as-tuples.md`](./yin.vm.code-as-tuples.md) is the\\ncase study, including the scoping bug that a naive query introduced.\\n\\nSee [`docs/agents/malleability.md`](../agents/malleability.md) for complete design guidance (cohesion, coupling, bounded complexity, evolution, testing strategy).\\nSee [`docs/agents/vocabulary.md`](../agents/vocabulary.md) for domain vocabulary reference (biology, economics, physics, philosophy).\\n\\n## Code Style\\n\\n- Prefer simple data over rich types.\\n- Prefer total functions over partial ones.\\n- Prefer declarative pipelines over imperative logic.\\n- Avoid cleverness.\\n- Name things after what they do to streams.\\n\\n## Development Workflow\\n\\n- Do not invent abstractions that hide streams.\\n- Do not suggest mainstream frameworks unless explicitly asked.\\n- Do not optimize prematurely.\\n- When uncertain, ask at the architectural level, not the implementation level.\\n- Explanations should align with Plan 9 / Datomic / Lisp lineage.\\n- Program store writes go through `engine/store-put`; any other store write\\n  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\\n  detects must be on its allowlist; its docstring states the residual it\\n  leaves to review.\\n\\n### Problem Decomposition\\n\\nIf a problem appears complex:\\n1. Decompose it into streams.\\n2. Identify invariants.\\n3. Restrict degrees of freedom.\\n4. Make causality explicit.\\n5. Let structure emerge from constraints.\\n\\n## Operational & Specialized Guides\\n\\n- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\\n- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\\n- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\\n- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; each orchestrator session has its own append-only log at `orchestrator-logs/<unix-time-stamp>-<brief-orchestrator-descriptive-name>.md` under the repository root.\\n- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794568084000-engineer-p7b-ticks-d.gpt-6.1-terra.stdout.log:7:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"git status --short --branch && sed -n '1910,1960p;2080,2120p' docs/design/yang.php.md && cat collab/orch-lane/1794700000000-architect-safepoint-slice3-design.gpt-6.1-sol.findings.md && cat test/yang/php/antlr/programs_p7b.cljc && cat test/yang/php/antlr/ticks_test.clj\\\"\",\"aggregated_output\":\"## p7b-ticks...origin/p7b-ticks\\n?? collab/yang-php/1794566777000-engineer-p7b-ticks-b.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794566777000-engineer-p7b-ticks-b.prompt.md\\n?? collab/yang-php/1794567390000-engineer-p7b-ticks-c.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794567390000-engineer-p7b-ticks-c.prompt.md\\n?? collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.findings.md\\n?? collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.stdout.log\\n?? collab/yang-php/1794567570000-architect-ticks-counter-ruling.prompt.md\\n?? collab/yang-php/1794568084000-engineer-p7b-ticks-d.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794568084000-engineer-p7b-ticks-d.prompt.md\\n   include; that is the known-gaps ledger's open item\\n   (\\\"publication-time-unavailable optional imports cannot be represented\\n   without concrete segment pins\\\"), not solved here (owner decision B8.10).\\n2. **Run time**: \\\"missing\\\" means the pinned content is unavailable or its\\n   delivery is refused (`:absent` with `:address`, a mismatch, an untrusted\\n   principal). `include` and `include_once` emit PHP's two warning records\\n   and yield `false`; `require` and `require_once` emit the first warning and\\n   throw `Error` with PHP's fatal text. The warning text retains the written\\n   kind. A refused path is not added to the included-files dict, so a later\\n   `_once` retries delivery. Each record carries the structured refusal under\\n   `:yang.php/refusal`.\\n\\n## 12. Safepoints\\n\\n- `:loop` and `:call` hooks (`phpsp`) serve signals: `pcntl_signal` handlers\\n  run at hooks via `stream/poll!` on a signal stream, and\\n  `pcntl_async_signals` is the default and only mode. A recursion-depth bound\\n  is available if a composition wants one (PHP has none; default off).\\n- `max_execution_time` and `set_time_limit` are wall-clock in PHP and so\\n  nondeterministic: the profile offers a deterministic **safepoint-count\\n  budget** instead, raising the fatal with PHP's text, a recorded departure\\n  (owner decision B8.5, corner C21). A composition may supply one non-negative\\n  integer budget per run; omission means unlimited. Each entry to a `:loop` or\\n  `:call` hook consumes one unit, and the hook after the last available unit\\n  raises `PHP Fatal error:  Maximum execution time of 30 seconds exceeded`.\\n  This operational fatal is not guest-catchable and skips shutdown functions\\n  and destructors. It bounds execution between hooks, not wall-clock time or\\n  blocking host operations; no generic VM instructions are charged.\\n- **Statement ticks** (`declare(ticks=N)`, `register_tick_function`) need\\n  `:line` sites before non-lambda statement nodes. `yang.safepoint` currently\\n  refuses a selected site that is not a `:lambda` (`site-not-lambda`), and\\n  `:line` insertion is safepoint slice 3, which Python tracing also needs.\\n  Ticks therefore **depend on the shared `:line` extension**: P7 splits into\\n  P7-a (signals, no dependency) and P7-b (ticks, behind safepoint slice 3).\\n  Neither L1 to L4 nor this frontend extends `yang.safepoint`; the extension\\n  is the safepoint seat's.\\n- No thread switches: PHP is single-threaded, and one request is one task.\\n\\n## 13. Diagnostics\\n\\nCompile time: `:yang.php/syntax`; `:yang.php/unsupported {:construct}`;\\n`:yang.php/not-php`; `:yang.php/unknown-builtin` (a warning);\\n`:yang.php/compile-error` for PHP's compile-time fatals (a function redeclared\\nin one unit, `break 0`, a duplicate parameter, `$this` reassignment, a\\npositional argument after a named one). Run time: guest warnings, notices and\\ndeprecations as records on the guest-diagnostics stream; fatals as `Error`\\nthrows; the uncaught-exception text pinned. Operational failures stay\\noperational (`yang.antlr.md` section 11).\\n\\n## 14. The differential-corpus plan\\n\\n+-------+----------------------------------+-----------------------------------+\\n| P5    | request context: `$_*` from the  | superglobals reproducible from a  |\\n|       | request record, `ob_*`, headers, | fixture record (exit criterion    |\\n|       | cookies and status as response   | 3); the headers-after-output      |\\n|       | records, `exit`, the error       | warning; two requests in two      |\\n|       | handler, the warnings stream     | tasks share nothing (exit         |\\n|       |                                  | criterion 5)                      |\\n+-------+----------------------------------+-----------------------------------+\\n| P6    | `include`/`require` over the     | the inclusion group; a            |\\n|       | linker, `_once`, namespaces and  | JVM-published `phpm.*` unit set   |\\n|       | `use`, constants, the autoload   | imports on Node and Dart with     |\\n|       | class map, publication and DHT   | equal output; the computed-path   |\\n|       | import parserless on Node and    | diagnostic; an unpublished target |\\n|       | Dart, the dynamic-scope profile  | refused at publication by name; a |\\n|       | for including functions          | pinned but unserved target:       |\\n|       |                                  | `include` warns and yields        |\\n|       |                                  | `false`, `require` and            |\\n|       |                                  | `require_once` throw `Error`; a   |\\n|       |                                  | refused `_once` retries delivery  |\\n+-------+----------------------------------+-----------------------------------+\\n| P7-a  | signals: `phpsp` hooks at        | a signal at a `:loop` hook runs   |\\n|       | `:loop` and `:call`,             | the handler; an empty signal      |\\n|       | `pcntl_signal`, the safepoint    | stream never parks; budget        |\\n|       | budget                           | exhaustion raises the pinned      |\\n|       |                                  | fatal text                        |\\n+-------+----------------------------------+-----------------------------------+\\n| P7-b  | ticks: `declare(ticks)`,         | tick counts equal PHP's for the   |\\n|       | `register_tick_function`; behind | statement fixture                 |\\n|       | safepoint slice 3                |                                   |\\n+-------+----------------------------------+-----------------------------------+\\n| P8    | legacy retirement: the legacy    | the REPL prints `1` for `<?php $x |\\n|       | test programs in the new corpus, | = 1; echo $x;`; every legacy test |\\n|       | the demo on checked-in CST       | program passes with corrected     |\\n|       | packets,                         | expectations; the demo runs its   |\\n|       | `src/dev/subsystems.edn`         | samples parserless in the         |\\n|       | retargeted, `yang/php.cljc`      | browser; no reference to the      |\\n|       | deleted, the compiler revision   | legacy `yang.php` namespace       |\\n|       | removed from the standard        | remains                           |\\n|       | catalog                          |                                   |\\n+-------+----------------------------------+-----------------------------------+\\n| P9    | builtin surface slices (strings  | each a corpus group with PHP      |\\nCreated-Local: 2026-11-05 0x:xx +0700\\nCoding-Agent: codex (gpt-6.1-sol, architect design — safepoint slice 3)\\n\\nI’ll read the architecture rules, section 12, and the current safepoint code, then develop a shared `:line` design for PHP ticks and Python tracing. I’ll keep this read-only and cite the relevant file locations.\\n\\n---\\n\\nThe shared `:line` extension is already in this checkout, along with Python tracing hooks and tests. The PHP section still describes it as pending. I’ll distinguish the existing contract from the PHP integration that remains, including whether a shared “current line” API needs anything beyond the hook operand already implemented.\\n\\n---\\n\\nThe main semantic issue is tick timing: the shared `:line` hook runs before its marked node, while Zend counts ticks after executing selected statements. A counter at every statement start would get callback order wrong. I’m checking how PHP lowering can preserve that timing while reusing the shared insertion primitive.\\n\\n---\\n\\nI’ve confirmed that include units need an explicit site-set handoff: canonical published rows carry no marks. I’ll make that a landing requirement for PHP, alongside a small profile option for hooks that run after normal statement completion. Python will keep its existing hook-before behavior, and neither path needs a VM semantic change.\\n\\n---\\n\\nThe shared `:line` mechanism already exists in this checkout. The remaining design work is PHP integration and one timing extension: Python needs a hook **before** a statement; PHP ticks need a hook **after normal completion**. Both can use the same marks, literal-operand API, and derivation stage.\\n\\nThis is a proposed design, based on source inspection. No files were edited and no tests were run.\\n\\n**1. Existing contract and proposed extension**\\n\\nThe PHP dependency statement is stale: [yang.php.md:1938](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1938) says non-lambda sites are refused, but the implementation already defines `statement-kinds #{:line}` and sequences the hook before any marked node. See [safepoint.cljc:85](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:85) and [safepoint.cljc:172](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:172). Python tracing has bundled and linked profiles, and the design records its landing at `a822e152`: [yang.antlr.md:4645](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:4645).\\n\\nNo separate `docs/design/yang.python.md` is present. Python’s relevant specification is §8.5.2 of `yang.antlr.md`.\\n\\nRetain the existing mark model:\\n\\n- A `:line` mark belongs to the **occurrence of the lowered statement node**, including its statement cleanup.\\n- It does not belong to every expression, instruction, physical newline, or lambda.\\n- Separate statements on the same source line remain separate sites.\\n- A closure’s construction statement and statements inside its body have separate occurrences.\\n- Prelude code and generated implementation machinery remain unmarked.\\n\\nThis follows [yang.antlr.md:1596](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:1596). PHP’s existing temporary-cleanup boundary is particularly relevant: [lower.cljc:2279](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:2279).\\n\\nAdd one **proposed**, language-neutral profile option:\\n\\n```clojure\\n;; Existing behavior: before the marked node.\\n{:line {:hook 'py.sp/tline :operands true}}\\n\\n;; Proposed behavior: after the marked node completes normally.\\n{:line {:hook 'php.sp/line :operands true :after true}}\\n```\\n\\nThe default remains hook-before. `:after true` is valid only for statement sites; invalid combinations should fail during derivation.\\n\\nThe reason is observable PHP behavior. Zend emits tick instructions following statement compilation, excludes particular statement categories, and suppresses adjacent duplicate tick instructions. Consequently, counting every statement entry is insufficient for PHP parity. PHP lowering must select the corresponding completion sites, including declaration and control-flow cases. [PHP 8.3 compiler](https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_compile.c)\\n\\nFor a marked node `S`, the two rewrites are conceptually:\\n\\n```clojure\\n;; Before: existing.\\n(do (hook literal-operands...) S)\\n\\n;; After: proposed. Preserve S's value mechanically.\\n(let [yang.safepoint/value S]\\n  (do (hook literal-operands...)\\n      yang.safepoint/value))\\n```\\n\\nBoth lower entirely to ordinary applications and lambdas. The after-hook runs once on normal completion, including completion after a suspension resumes. An escape bypassing completion skips it. It is not a `finally` hook.\\n\\nMarks must not overwrite existing `:call` or `:loop` marks. PHP should mark the outer statement/cleanup node while preserving inner call sites and loop lambdas. The current representation holds one mark per path; adding multiple marks per occurrence is outside this slice. See [core/lower.cljc:76](/Users/sto/workspace/datomworld/src/cljc/yang/core/lower.cljc:76).\\n\\n**2. Writer and reader API**\\n\\nUse the existing metadata and literal-operand API, without introducing a VM “current line” register.\\n\\n| Operation | Contract |\\n|---|---|\\n| Frontend writes a site | `(core/site [:line n ...literal-data] statement-node)` |\\n| Projection transports it | `[origin root path :yang/site mark]` |\\n| Stage reads sites | `(safepoint/sites metadata origin root)` |\\n| Composition selects behavior | Profile entry for `:line` |\\n| Runtime consumer reads the line | First literal argument passed to its hook |\\n\\nThese APIs already exist: [core/lower.cljc:76](/Users/sto/workspace/datomworld/src/cljc/yang/core/lower.cljc:76), [yin/vm.cljc:1217](/Users/sto/workspace/datomworld/src/cljc/yin/vm.cljc:1217), and [safepoint.cljc:96](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:96).\\n\\nRecommended consumer shapes:\\n\\n```clojure\\n;; Python: existing.\\n[:line n]\\n;; -> (py.sp/tline n)\\n\\n;; PHP: proposed payload; generic insertion does not interpret the map.\\n[:line n {:unit unit-path :ticks N}]\\n;; -> (php.sp/line n {:unit unit-path :ticks N})\\n```\\n\\nPHP receives the unit explicitly because a closure can execute after its defining include has returned. Reading only the currently including unit would misidentify its source.\\n\\nThe line-number conventions remain frontend-owned:\\n\\n- PHP uses its packet’s physical-line side table; existing code returns `0` when unavailable: [lower.cljc:3298](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3298).\\n- Python currently uses logical lines counted from `NEWLINE` tokens. This slice preserves that documented limitation: [lower.cljc:198](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/lower.cljc:198).\\n\\nThe PHP tick consumer uses the supplied `N` and a request-owned counter. Increment at each selected completion; when the counter reaches that site’s threshold, reset it before dispatch. Counter state survives calls, includes, and generator switches. Zend likewise uses one execution counter with the threshold carried by each tick instruction. [PHP 8.3 tick handler](https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_vm_def.h)\\n\\nKeep this state separate from:\\n\\n- The execution-budget counter, currently named `php.sp/tick`: [PHP safepoint.cljc:23](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/safepoint.cljc:23).\\n- Escape-restored dynamic context.\\n- Source-location data.\\n\\nPHP callback dispatch needs its own semantics. In particular, suppression is **per executing registered handler**, rather than Python’s global tracing-busy flag. Hook operands are not additional arguments to registered PHP callbacks. [PHP tick callback implementation](https://raw.githubusercontent.com/php/php-src/PHP-8.3/ext/standard/basic_functions.c)\\n\\nPython already consumes the same primitive: `py.sp/tline` receives `n`, finds the running function’s frame, writes `f_lineno`, and invokes its local trace function. See [Python safepoint.cljc:265](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/safepoint.cljc:265). Its tracing state and frame restoration remain Python-owned.\\n\\nThus “current line” means the location supplied to the current hook. A consumer may retain that location in its own frame or context. There is no ambient cross-language mutable location.\\n\\n**3. Mark lifecycle and linked retention**\\n\\nMarks are static occurrence data. Executing a mark does not consume or remove it.\\n\\n| Boundary | Required behavior |\\n|---|---|\\n| Include unit | Retain that unit’s own statement locations and lexical tick thresholds. Sharing caller variables does not share its source map. Repeated execution revisits its sites; `_once` skips the body when appropriate. |\\n| Eval unit, P9 | A new compilation produces its own source occurrence, site set, and derivation under the run’s selected profile. Caller scope sharing does not substitute caller locations. Until P9, preserve the existing unsupported result. |\\n| Generator suspension | Instrumented code and the pending continuation survive suspension. A before-hook is not replayed merely by resuming; a pending after-hook runs when its statement eventually completes normally. |\\n| Closure | Its body retains defining-unit locations and compile-time tick thresholds. Invocation uses the invoking request’s runtime tick state. Creating a closure does not execute its body’s sites. |\\n| Exception/escape | Static sites remain available. Frame/location restoration follows language context restoration; the request’s tick counter is not rolled back. |\\n\\nRelevant existing boundaries are [yang.php.md:1875](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1875), [yang.php.md:360](/Users/sto/workspace/datomworld/docs/design/yang.php.md:360), and [PHP prelude.cljc:4506](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:4506). PHP already saves generator context at yield and restores the caller context: [prelude.cljc:4538](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:4538).\\n\\nThis guarantees location retention, not complete CPython generator-tracing parity. Python’s existing call mark surrounds function invocation, including generator construction: [Python lower.cljc:1482](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/lower.cljc:1482). Generator trace-event policy needs separate acceptance before broader parity is claimed.\\n\\nThe linker retention contract is:\\n\\n| Artifact | Retain |\\n|---|---|\\n| Canonical program `A` | Original rows, without line literals or mark fields |\\n| Published source association | Content-addressed occurrence site set, bound to the exact canonical root and frontend/profile revision |\\n| Derived executable `A′` | Selected hook applications and their literal operands |\\n| Derivation record | Input/output roots, complete hook profile—including `:after`—and selected-site-set address |\\n| Source archive | Original occurrence metadata and positions needed to recover provenance |\\n\\nThis matches the existing separation between canonical publication and derived execution: [yang.antlr.md:1613](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:1613). Derived envelopes intentionally contain empty side tables: [safepoint.cljc:234](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:234).\\n\\nA published canonical tree alone cannot recover marks. Python addresses this through published site sets and link-time derivation: [yang.antlr.md:3040](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:3040). **PHP does not yet publish them**—its publication configuration explicitly sets `:site-set nil`: [publication.cljc:41](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/publication.cljc:41).\\n\\nTherefore PHP’s linked ticks profile must:\\n\\n- Publish and retrieve verified site sets for included guest code.\\n- Require the appropriate hook module and rebind dependencies to derived images.\\n- Refuse missing or invalid site metadata when ticks are required; it must not silently run that dependency without ticks.\\n- Pin the selected source/site association explicitly when multiple source occurrences share canonical rows.\\n\\nFor include cycles, instrument the SCC bundle and repin member aliases to that derived bundle. The existing publisher places marks on bundles, not aliases: [core/publication.cljc:147](/Users/sto/workspace/datomworld/src/cljc/yang/core/publication.cljc:147). Python currently documents an SCC admission limitation; copying that limitation would not establish PHP’s cyclic-include acceptance.\\n\\n**Stripping rule:** omit `:line` from the profile to derive an executable without line hooks. Never delete inserted calls from an already derived image. A compact execution package may omit side tables after derivation, provided its pinned provenance remains retrievable. A package intended for later instrumentation must retain/retrieve its site set.\\n\\nThere is no automatic hook-prelude dead-code stripping promised here. Python’s current module emitter includes its definition list regardless of selected profile: [Python safepoint.cljc:425](/Users/sto/workspace/datomworld/src/cljc/yang/python/antlr/safepoint.cljc:425).\\n\\n**4. Cost and host deltas**\\n\\nAt an executed selected site, excluding consumer work:\\n\\n| Placement | Added application occurrences | Added lambdas |\\n|---|---:|---:|\\n| Before | 2 | 1 |\\n| After, value preserving | 3 | 2 |\\n| `:line` omitted | 0 | 0 |\\n\\nThe existing before shape is visible at [safepoint.cljc:128](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:128). Runtime cell accesses, polling, frame updates, and guest calls are additional consumer costs; “one cell read per statement” is not a sufficient description of the current Python tracing hook.\\n\\nDerivation traverses the program and recomputes tail marks; sorted site-set construction adds sorting work. Bundle growth includes wrappers, operands, changed ancestors, and tail-mark changes. Content addressing shares identical rows, so these occurrence counts are not byte estimates. Measure rows and serialized bytes in acceptance.\\n\\n**No `yin.vm` semantic change is required.** No new opcode, effect, semantic-contract stamp, UCF field, or host location register is introduced.\\n\\nLanguage instrumentation hooks are ordinary calls. They are distinct from the VM’s parking/migration safepoints, whose table concerns blocked operations, explicit parks, and halt: [yin.vm.semantic.md:655](/Users/sto/workspace/datomworld/docs/design/yin.vm.semantic.md:655).\\n\\nThe after-wrapper needs a distinct reserved result binder and tail recomputation. Its continuation uses existing machinery. Application placement alone adds no host effect capability.\\n\\n**5. Acceptance and landing contract**\\n\\nUse this PHP fixture to expose both count and callback ordering:\\n\\n```php\\n<?php\\nfunction tick_handler() { echo \\\"T\\\"; }\\nregister_tick_function('tick_handler');\\n\\ndeclare(ticks=1) {\\n    echo \\\"A\\\";\\n    $x = 1;\\n    echo \\\"B\\\";\\n}\\n\\nunregister_tick_function('tick_handler');\\n```\\n\\nProposed oracle assertions:\\n\\n| Threshold | Output | Handler calls |\\n|---|---|---:|\\n| `1` | `ATTBT` | 3 |\\n| `2` | `ATB` | 1 |\\n| `0` | `AB` | 0 |\\n\\nRecord these against the project’s pinned PHP oracle before accepting them as goldens; the repository records PHP `8.3.35` oracle provenance at [programs.cljc:10](/Users/sto/workspace/datomworld/test/yang/php/antlr/programs.cljc:10).\\n\\nPHP acceptance must additionally cover:\\n\\n- Same-line statements and non-tickable expression subparts.\\n- Nested directives, threshold changes, and adjacent-tick suppression.\\n- Registration/unregistration inside ticked code and handler exceptions.\\n- Temporary destruction before the completion callback.\\n- Return, throw, break, continue, and `finally`.\\n- Included units with and without their own directives; `_once`; include cycles.\\n- Closures invoked after their defining include returns.\\n- Two generators interleaved across a yield, proving no replay and one shared request counter.\\n- Unchanged execution-budget charging: adding `:line` must not charge the `:loop`/`:call` budget.\\n\\nFor Python, retain the existing basic trace fixture and golden:\\n\\n```text\\ncall f 7\\nline f 8\\ncall g 5\\nline g 6\\nreturn g 6\\nline f 9\\nreturn f 9\\n```\\n\\nIt already exists in bundled and linked tests: [safepoint_test.cljc:805](/Users/sto/workspace/datomworld/test/yang/python/antlr/safepoint_test.cljc:805), [linked_safepoint_test.cljc:401](/Users/sto/workspace/datomworld/test/yang/python/antlr/linked_safepoint_test.cljc:401). Preserve unwind restoration, callback suppression, newline handling, and unsupported-profile tests.\\n\\nDo not enlarge Python’s parity claim: the documented slice excludes exception/C-call events, module-level events, and certain header events: [yang.antlr.md:1770](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:1770).\\n\\nThe **shared landing gate** is:\\n\\n- Before and after placement work on non-lambda nodes, preserving values and evaluation order.\\n- Escapes skip after-hooks; suspension/resumption neither loses nor duplicates them.\\n- Empty selection remains identity; canonical input remains unchanged.\\n- Existing Python derivation goldens remain unchanged.\\n- Derivation is deterministic across JVM, Node, and Dart.\\n- All four evaluators pass applicable execution fixtures.\\n- Prelude exclusion, tail behavior, provenance joins, and fail-closed hook resolution hold.\\n\\nPassing that gate unblocks PHP P7-b. P7-b itself remains incomplete until its tick semantics and linked-unit acceptance pass. Eval execution fixtures remain P9 work.\\n\\n**6. Implementation slices, seats, and ordering**\\n\\n| Order | Seat | Files and work |\\n|---|---|---|\\n| 1 | Architect + safepoint owner | Reconcile stale status in `docs/design/yang.php.md` §12 and `docs/design/yang.antlr.md` §8.5.2; specify `:after`, payloads, retention, and acceptance. |\\n| 2 | Shared safepoint compiler seat | `src/cljc/yang/safepoint.cljc`: add validated after-placement, value-preserving rewrite, and provenance-path handling. Reserve the result binder in `src/cljc/yang/core/names.cljc`. Add focused cases to `test/yang/safepoint_test.cljc`. |\\n| 3 | QA/verification seat | Run shared cross-host derivation checks and existing Python bundled/linked tracing regressions. Establish the shared landing gate. |\\n| 4 | PHP compiler/runtime seat | `src/cljc/yang/php/antlr/lower.cljc`: lexical directive tracking and completion-site selection. `safepoint.cljc`: distinct statement-tick hooks and bundled/linked emission. `prelude.cljc`: request-owned state and builtin wiring. Extend PHP safepoint fixtures. |\\n| 5 | Publication/linker integration seat | Enable the existing publication `:site-set` seam in PHP; add a PHP site-set adapter, verified link-time derivation, hook dependency pins, and SCC alias rebinding. Extend include and portable publication fixtures. |\\n| 6 | QA + independent reviewer | Record pinned PHP oracle results; verify consumer semantics, lifecycle, bundle sizes, and the required host/evaluator lanes. Review shared and PHP completion separately. |\\n| Later | P9 eval seat | Feed each admitted eval compilation through the same site/profiling contract and add eval-boundary fixtures. |\\n\\nThe shared insertion change belongs to the safepoint seat, as PHP explicitly requires at [yang.php.md:1944](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1944). Python needs regression coverage for this work; its existing tracing implementation does not need to be rebuilt.(ns yang.php.antlr.programs-p7b\\n  \\\"Hand-derived tick expectations pending the pinned PHP oracle pass.\\\")\\n\\n\\n(def prologue\\n  \\\"function tick_handler() { echo 'T'; } register_tick_function('tick_handler'); \\\")\\n\\n\\n(def fixtures\\n  [{:id :sequence, :source \\\"declare(ticks=1) { echo 'A'; $x = 1; echo 'B'; }\\\",\\n    :out \\\"ATTBT\\\", :oracle :pending}\\n   {:id :loop-body, :source \\\"for ($i=0; $i<2; $i++) { declare(ticks=1) { echo 'A'; } }\\\",\\n    :out \\\"ATAT\\\", :oracle :pending}\\n   {:id :function-call, :source \\\"function f() { echo 'F'; } declare(ticks=1) { f(); }\\\",\\n    :out \\\"FT\\\", :oracle :pending}\\n   {:id :generator-resume,\\n    :source \\\"function g() { declare(ticks=1) { yield 1; echo 'B'; } } $g=g(); $g->current(); echo 'A'; $g->next();\\\",\\n    :out \\\"ATBT\\\", :oracle :pending}\\n   {:id :include-handoff, :source \\\"include 'lib.php';\\\",\\n    :units {\\\"lib.php\\\" \\\"<?php declare(ticks=1) { echo 'L'; }\\\"},\\n    :out \\\"LT\\\", :oracle :pending}])\\n(ns yang.php.antlr.ticks-test\\n  (:require\\n    [clojure.test :refer [deftest is testing]]\\n    [yang.php.antlr.cst :as cst]\\n    [yang.php.antlr.e2e-harness :as h]\\n    [yang.php.antlr.linked-harness :as lh]\\n    [yang.php.antlr.programs-p7b :as p7b]))\\n\\n\\n(deftest tick-fixtures-test\\n  (doseq [{:keys [id source out units]} p7b/fixtures\\n          :when (nil? units)]\\n    (testing (name id)\\n      (is (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))))))\\n\\n\\n(deftest include-handoff-test\\n  (let [{:keys [source units out]} (last p7b/fixtures)\\n        packets (update-vals (assoc units \\\"main.php\\\" (str \\\"<?php \\\" p7b/prologue source))\\n                             cst/parse-source)\\n        result (lh/run-fixture packets \\\"main.php\\\" {})]\\n    (doseq [[vm value] (:values result)]\\n      (is (= out (h/latin1->text (:php/out value))) (name vm)))))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794568084000-engineer-p7b-ticks-d.gpt-6.1-terra.stdout.log:13:{\"type\":\"item.started\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\np='test/yang/php/antlr/programs_p7b.cljc'\\ns=open(p).read(); needle='   {:id :include-handoff, :source \\\\\\\"include \\\\\\\\'lib.php\\\\\\\\';\\\\\\\",'\\naddition='''   {:id :sequence-n2, :source \\\\\\\"declare(ticks=2) { echo 'A'; \\\"'$x = 1; echo '\\\"'B'; }\\\\\\\",\\n    :out \\\\\\\"ATB\\\\\\\", :oracle :pending}\\n   {:id :nested-threshold,\\n    :source \\\\\\\"declare(ticks=5) { echo 'A'; \\\"'$x=1; echo '\\\"'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\\\\\\",\\n    :out \\\\\\\"ABCTD\\\\\\\", :oracle :pending}\\n   {:id :cross-function,\\n    :source \\\\\\\"function f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\\\\\\",\\n    :out \\\\\\\"AFT\\\\\\\", :oracle :pending}\\n   {:id :semicolon-directive, :source \\\\\\\"declare(ticks=2); echo 'A'; echo 'B';\\\\\\\",\\n    :out \\\\\\\"ATB\\\\\\\", :oracle :pending}\\n'''\\nassert needle in s;s=s.replace(needle,addition+needle);open(p,'w').write(s)\\np='docs/design/yang.php.md';s=open(p).read();a=s.index('- **Statement ticks**',s.index('## 12. Safepoints'));b=s.index('- No thread switches:',a);s=s[:a]+'''- **Statement ticks** (\\\"'`declare(ticks=N)`, `register_tick_function`) use\\n  selected `:line` sites after normal statement completion. The shared\\n  `yang.safepoint` extension supports non-lambda statement sites and preserves\\n  their values; PHP supplies each site'\\\"'s lexical threshold. P7-b integrates\\n  this mechanism with PHP's request-owned counter and callback registry.\\n'''+s[b:];open(p,'w').write(s)\\nPY\\nclojure -M:test -n yang.php.antlr.ticks-test -v yang.php.antlr.ticks-test/tick-fixtures-test\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794568084000-engineer-p7b-ticks-d.gpt-6.1-terra.stdout.log:14:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\np='test/yang/php/antlr/programs_p7b.cljc'\\ns=open(p).read(); needle='   {:id :include-handoff, :source \\\\\\\"include \\\\\\\\'lib.php\\\\\\\\';\\\\\\\",'\\naddition='''   {:id :sequence-n2, :source \\\\\\\"declare(ticks=2) { echo 'A'; \\\"'$x = 1; echo '\\\"'B'; }\\\\\\\",\\n    :out \\\\\\\"ATB\\\\\\\", :oracle :pending}\\n   {:id :nested-threshold,\\n    :source \\\\\\\"declare(ticks=5) { echo 'A'; \\\"'$x=1; echo '\\\"'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\\\\\\",\\n    :out \\\\\\\"ABCTD\\\\\\\", :oracle :pending}\\n   {:id :cross-function,\\n    :source \\\\\\\"function f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\\\\\\",\\n    :out \\\\\\\"AFT\\\\\\\", :oracle :pending}\\n   {:id :semicolon-directive, :source \\\\\\\"declare(ticks=2); echo 'A'; echo 'B';\\\\\\\",\\n    :out \\\\\\\"ATB\\\\\\\", :oracle :pending}\\n'''\\nassert needle in s;s=s.replace(needle,addition+needle);open(p,'w').write(s)\\np='docs/design/yang.php.md';s=open(p).read();a=s.index('- **Statement ticks**',s.index('## 12. Safepoints'));b=s.index('- No thread switches:',a);s=s[:a]+'''- **Statement ticks** (\\\"'`declare(ticks=N)`, `register_tick_function`) use\\n  selected `:line` sites after normal statement completion. The shared\\n  `yang.safepoint` extension supports non-lambda statement sites and preserves\\n  their values; PHP supplies each site'\\\"'s lexical threshold. P7-b integrates\\n  this mechanism with PHP's request-owned counter and callback registry.\\n'''+s[b:];open(p,'w').write(s)\\nPY\\nclojure -M:test -n yang.php.antlr.ticks-test -v yang.php.antlr.ticks-test/tick-fixtures-test\\\"\",\"aggregated_output\":\"Loading initial Timbre config from: :default\\n\\nRunning tests in #{\\\"test\\\"}\\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\\n\\nTesting yang.php.antlr.ticks-test\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nsequence\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATTBT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nloop-body\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATAT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nfunction-call\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"FT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\ngenerator-resume\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATBT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nsequence-n2\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATB\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nnested-threshold\\nexpected: (= out (:php/out (h/run-raw (str \\\"<