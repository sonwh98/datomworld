st)) (not declare?)) (assoc :code-before? true))\\nsrc/cljc/yang/php/antlr/lower.cljc:619:(declare chain-calls member-vis class-ref-node class-name-node leftmost-token-text lower-class lower-new\\nsrc/cljc/yang/php/antlr/lower.cljc:642:      (app* 'php/sprop-cell (class-ref-node ctx nil cls) (u/lit prop) (cc-node ctx)))\\nsrc/cljc/yang/php/antlr/lower.cljc:737:        (app* 'php/sprop-ref (class-ref-node ctx nil cls) (u/lit prop) (cc-node ctx)))\\nsrc/cljc/yang/php/antlr/lower.cljc:846:(declare lower lower-assign-value lower-assign-target lower-lambda lower-destructure pattern-of)\\nsrc/cljc/yang/php/antlr/lower.cljc:865:   \\\"Spaceship\\\" 'php/spaceship,\\nsrc/cljc/yang/php/antlr/lower.cljc:895:(declare base-location)\\nsrc/cljc/yang/php/antlr/lower.cljc:1209:   computed (plan P6 R3). `__FILE__` is the unit's declared path, `__DIR__`\\nsrc/cljc/yang/php/antlr/lower.cljc:1377:(declare pattern-of)\\nsrc/cljc/yang/php/antlr/lower.cljc:1683:  \\\"Warn when `lc` names a catalogue function that neither the unit declares\\nsrc/cljc/yang/php/antlr/lower.cljc:1688:             (not (contains? (:declared ctx) lc)))\\nsrc/cljc/yang/php/antlr/lower.cljc:1822:        user-lc (first (filter #(contains? (:declared ctx) %) [primary-lc fallback-lc]))\\nsrc/cljc/yang/php/antlr/lower.cljc:1844:        ;; are language constructs and cannot be user-declared.\\nsrc/cljc/yang/php/antlr/lower.cljc:1876:                      (let [call (call-node ctx (u/v f) arguments (get (:declared ctx) user-lc))]\\nsrc/cljc/yang/php/antlr/lower.cljc:2144:   `__FILE__`/`__DIR__` the unit's declared path and directory (C37),\\nsrc/cljc/yang/php/antlr/lower.cljc:2811:   declared type value, `:promote` `{:vis :readonly?}` for a promoted\\nsrc/cljc/yang/php/antlr/lower.cljc:2868:  \\\"`const X = e, Y = f;` at unit or namespace level: each name is declared\\nsrc/cljc/yang/php/antlr/lower.cljc:2875:                    (app* 'php/const-declare!\\nsrc/cljc/yang/php/antlr/lower.cljc:2922:  \\\"A returned value held to the declared type `rtype`; `static` resolves to the\\nsrc/cljc/yang/php/antlr/lower.cljc:3242:    (app* 'php/declare-function!\\nsrc/cljc/yang/php/antlr/lower.cljc:3356:  \\\"The property entries a constructor's promoted parameters declare.\\\"\\nsrc/cljc/yang/php/antlr/lower.cljc:3406:  \\\"The method declared by `st` (a `classStatement` or a `functionDeclaration`);\\nsrc/cljc/yang/php/antlr/lower.cljc:3554:(defn- lower-declare\\nsrc/cljc/yang/php/antlr/lower.cljc:3555:  \\\"`declare(strict_types=1)` switches the unit to strict scalar typing; `ticks`\\nsrc/cljc/yang/php/antlr/lower.cljc:3558:  (let [ds (mapcat #(core/rules ctx % \\\"directive\\\") (core/rules ctx n \\\"declareList\\\"))\\nsrc/cljc/yang/php/antlr/lower.cljc:3569:  \\\"A class declared in place (nested or conditional): declared when reached.\\\"\\nsrc/cljc/yang/php/antlr/lower.cljc:3572:    (u/then (app* 'php/declare-class! spec) (u/lit :php/null))))\\nsrc/cljc/yang/php/antlr/lower.cljc:3612:    \\\"declareStatement\\\" (lower-declare ctx n)\\nsrc/cljc/yang/php/antlr/lower.cljc:3622:   declaration: PHP declares it before the unit's first statement runs.\\\"\\nsrc/cljc/yang/php/antlr/lower.cljc:3627:(defn- declared-functions\\nsrc/cljc/yang/php/antlr/lower.cljc:3628:  \\\"Every function the unit declares: lower-cased fully qualified name to the\\nsrc/cljc/yang/php/antlr/lower.cljc:3648:  \\\"The entry unit's declared path when the composition names none.\\\"\\nsrc/cljc/yang/php/antlr/lower.cljc:3663:     (assoc ctx :declared (declared-functions ctx)))))\\nsrc/cljc/yang/php/antlr/lower.cljc:3667:  \\\"A top-level function declared twice, or over a builtin, is a compile\\nsrc/cljc/yang/php/antlr/lower.cljc:3675:                (compile-error! f (str \\\"Cannot redeclare \\\" written \\\"()\\\")))\\nsrc/cljc/yang/php/antlr/lower.cljc:3688:   then the classes that can be declared at that point (PHP hoists a class\\nsrc/cljc/yang/php/antlr/lower.cljc:3702:                     (app* 'php/declare-late! (u/v sym))\\nsrc/cljc/yang/php/antlr/lower.cljc:3777:   need); `:path` the entry unit's declared path (default `entry-path`);\\nsrc/cljc/yang/php/antlr/lower.cljc:3891:    :yang.php/refusal :yang.php/undeclared-free registry\\nsrc/cljc/yang/php/antlr/lower.cljc:3948:    :yang.php/refusal :yang.php/undeclared-free registry\\nsrc/cljc/yang/php/antlr/lower.cljc:4000:                 :yang.php/refusal :yang.php/undeclared-free registry\\n\",\"exit_code\":2,\"status\":\"failed\"}}\ncollab/yang-php/1794568287000-engineer-p7b-ticks-e.gpt-6.1-terra.stdout.log:29:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"tail -50 collab/yang-php/1794568287000-engineer-p7b-ticks-e.gpt-6.1-terra.stdout.log; sed -n '130,180p' src/cljc/yang/safepoint.cljc; sed -n '80,125p' src/cljc/yang/php/antlr/prelude.cljc; sed -n '4450,4475p' src/cljc/yang/php/antlr/prelude.cljc; rg -n 'register_shutdown_function' src/cljc/yang/php\\\"\",\"aggregated_output\":\"{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"01a1d49b-0c87-7321-8438-2a53e8c82621\\\"}\\n{\\\"type\\\":\\\"turn.started\\\"}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_0\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"I’ll read the binding ruling and repository workflow first, then implement the tick runtime and lowering against the existing fixtures. I’ll keep the include-handoff case deferred and record verification and any conflicts in the requested findings file.\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat docs/design/datom.world.md'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat docs/design/datom.world.md'\\\",\\\"aggregated_output\\\":\\\"---\\\\ndescription: Core philosophy, foundational axioms, invariants, primitives (tuples, streams, host boundaries), architectural commitments, design principles, code style, and development workflow for datom.world\\\\n---\\\\n\\\\n# DATOM.WORLD ARCHITECTURAL FOUNDATIONS & DEVELOPMENT RULES\\\\n\\\\n## Core Philosophy\\\\n\\\\nEverything is data.\\\\nInterpretation > abstraction.\\\\nExplicit causality > implicit assumptions.\\\\nRestrictions are a feature.\\\\n\\\\n### Foundational Axioms\\\\n\\\\n1. **Everything is a Stream**: Portable I/O and system data flow through append-only streams; hosts may also install explicit local functions that perform direct I/O.\\\\n2. **Interpretation Creates Semantics**: Data is syntax; semantics only emerge through interpretation (one truth, many perspectives).\\\\n   At system scale, a \\\\\\\"system\\\\\\\" is an emergent property of interpreters of\\\\n   pure data, not an object, service, or stored artifact. Find the\\\\n   interpreters and the data they share to find the system.\\\\n3. **Code and State are Datoms**: Code (Universal AST) and runtime execution state are structured datoms, enabling syntax independence and structural reflection.\\\\n4. **Everything is a Continuation**: Computation is modeled as serializable, portable continuations that can pause, travel across streams, and resume anywhere.\\\\n\\\\n## Non-Negotiable Invariants\\\\n\\\\n- Do not introduce hidden global state.\\\\n- Do not introduce implicit control flow.\\\\n- Do not introduce callbacks; every callback is an event on a stream.\\\\n- Do not introduce shared mutable state.\\\\n- Do not collapse interpretation and execution into the same layer.\\\\n- Do not assume graphs: graphs must be constructed explicitly from tuples.\\\\n- Do not lose information (unitarity): streams are append-only and no datom is destroyed, only reinterpreted. The Universal AST is never lost: it is always retrievable wherever code is lowered, by address or by a query over its datoms. Every derived form (semantic vector, native images, indexes) is an interpretation of it and may drop facts only because the AST remains.\\\\n\\\\n## Tuples and Datoms\\\\n\\\\nTuples are elements in an open moduli space, graded by dimension $n$. A tuple can be any dimension/size.\\\\nA datom is the canonical persistent tuple `[e a v t m]` (entity, attribute, value, transaction, metadata). Persistent facts are immutable datoms.\\\\nSource scope belongs to the interpreter, never to an appended tuple slot. Queries keep physical sources as separate db-values and express union or joins explicitly.\\\\n\\\\nSee [`docs/design/datom.md`](./datom.md) for full specification.\\\\n\\\\n## Streams\\\\n\\\\n`dao.stream` is an I/O monad and the system's portable I/O ABI. Functions consume streams and produce streams.\\\\nHosts may install arbitrary local functions, including direct I/O; their availability and migration semantics must be explicit.\\\\nPortable behavior cannot assume them; portable side effects appear as stream emissions. Direct-I/O host modules are explicitly local and non-migratable (owner decision, 2026-10-23).\\\\nStreams are values that can be sent through streams.\\\\nStreams carry whatever values the consumer needs: no datom requirement, no privileged payload shape.\\\\n\\\\nA stream has no privileged reader, and its meaning is not in it. Any number\\\\nof interpreters may observe the same medium, and each constructs its own\\\\nsemantics from the same batches: a `yin.vm` evaluator observing a program\\\\nstream constructs CESK state and executes it; `dao.space.index` observing\\\\nthe very same stream materializes covered indexes, so `dao.space.query/q`\\\\nanswers Datalog over the program as it grows. Neither knows the other\\\\nexists. The medium is their only coupling, and each observer's ignorance of\\\\nthe other is load-bearing: the evaluator never consults an index to run,\\\\nand the index never evaluates a form to index it. This is how axiom 2\\\\nbecomes architecture: one stream, many interpretations, none of them\\\\nthe stream's own.\\\\n\\\\nFunctions can take anything and return anything.\\\\nAgents are functions, closures, or continuations in `yin.vm` that communicate portably with the outside world through `dao.stream`. Portable agent behavior is specified through stream effects; host-local functions may also perform direct I/O.\\\\n\\\\nSee [`docs/design/dao.stream.md`](./dao.stream.md) for full stream specification.\\\\nSee [`docs/design/yin.vm.streams-all-the-way-down.md`](./yin.vm.streams-all-the-way-down.md) for VM architecture.\\\\n\\\\n### Host Boundaries\\\\n\\\\nA host boundary is the dao.stream abstraction boundary; implementations do not add contracts.\\\\n[datom.world.abi.md](./datom.world.abi.md) owns the doctrine, owner rulings, taxonomy, floor and custody rules.\\\\n\\\\n## Architectural Commitments\\\\n\\\\n- **`dao.jing` is syntax, agents are semantics**: the content-addressed encoding stays passive and payload-agnostic.\\\\n- **Macros are stream topology**: an evaluator knows nothing about macro expansion; expansion happens on the syntax side of a medium boundary, upstream of any evaluator.\\\\n- **Peer observers, one stream**: a generic evaluator and `dao.space` independently observe the same stream topic, as described under Streams. This is not a claim about any two consumers regardless of what they consume.\\\\n- **Observers are independent and optional**: nothing requires a medium to have any particular set of consumers. Which observers exist for a stream is a per-composition choice, not a design-time commitment.\\\\n\\\\n## Design Principles\\\\n\\\\nCode quality is measured by malleability: how cheaply can changes adapt without breaking promises?\\\\nStigmergic coordination emerges from sharing data across streams.\\\\n\\\\n**Systems emerge from interpreters of pure data.** Streams are the\\\\ncomposition medium; each interpreter gives the same data a perspective\\\\nwithout collapsing interpretation into execution or owning the truth.\\\\n\\\\n- `dao.space` emerges from `dao.space.index` and `dao.space.query` over\\\\n  ordinary streams.\\\\n- ShiBi capability, metering, and budget emerge from different\\\\n  interpreters over the same tuples; no token object is stored.\\\\n- The four VMs interpret one Universal AST; many syntaxes feed that AST.\\\\n- The semantic AST in `dao.space` is queryable facts projected by the\\\\n  auto-index observer.\\\\n- Client and server are roles in one stigmergic behavior implemented by\\\\n  interpreters, not distinct kinds of nodes.\\\\n\\\\n**Derive, don't persist.** Before adding a tag, slot, or field to any\\\\ncanonical content-hashed structure (an AST grammar, a datom schema, a row\\\\nshape), check whether a correctly scoped Datalog query over\\\\n`dao.space.query/q` can already compute the fact. If it can, it belongs as a\\\\nquery or projection: new persisted structure migrates every downstream\\\\nconsumer and duplicates authority over a fact a query derives fresh. The\\\\nretired `:global` tag in\\\\n[`docs/design/yin.vm.code-as-tuples.md`](./yin.vm.code-as-tuples.md) is the\\\\ncase study, including the scoping bug that a naive query introduced.\\\\n\\\\nSee [`docs/agents/malleability.md`](../agents/malleability.md) for complete design guidance (cohesion, coupling, bounded complexity, evolution, testing strategy).\\\\nSee [`docs/agents/vocabulary.md`](../agents/vocabulary.md) for domain vocabulary reference (biology, economics, physics, philosophy).\\\\n\\\\n## Code Style\\\\n\\\\n- Prefer simple data over rich types.\\\\n- Prefer total functions over partial ones.\\\\n- Prefer declarative pipelines over imperative logic.\\\\n- Avoid cleverness.\\\\n- Name things after what they do to streams.\\\\n\\\\n## Development Workflow\\\\n\\\\n- Do not invent abstractions that hide streams.\\\\n- Do not suggest mainstream frameworks unless explicitly asked.\\\\n- Do not optimize prematurely.\\\\n- When uncertain, ask at the architectural level, not the implementation level.\\\\n- Explanations should align with Plan 9 / Datomic / Lisp lineage.\\\\n- Program store writes go through `engine/store-put`; any other store write\\\\n  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\\\\n  detects must be on its allowlist; its docstring states the residual it\\\\n  leaves to review.\\\\n\\\\n### Problem Decomposition\\\\n\\\\nIf a problem appears complex:\\\\n1. Decompose it into streams.\\\\n2. Identify invariants.\\\\n3. Restrict degrees of freedom.\\\\n4. Make causality explicit.\\\\n5. Let structure emerge from constraints.\\\\n\\\\n## Operational & Specialized Guides\\\\n\\\\n- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\\\\n- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\\\\n- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\\\\n- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; each orchestrator session has its own append-only log at `orchestrator-logs/<unix-time-stamp>-<brief-orchestrator-descriptive-name>.md` under the repository root.\\\\n- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_2\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat docs/agents/build-n-test.md'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_2\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat docs/agents/build-n-test.md'\\\",\\\"aggregated_output\\\":\\\"---\\\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\\\n---\\\\n\\\\n# BUILD & TEST\\\\n\\\\n## Commands\\\\n\\\\n```sh\\\\n# Tests (Babashka runner)\\\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\\\nbb test:slow         # Only the slow tests, on every lane\\\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\\\n# (dao.test-slow/guard \\\\\\\"name\\\\\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\\\n# under test/), so the non-slow tests inside those namespaces also run there.\\\\n# On Node, shadow also runs the test namespaces those nine require (about\\\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\\\n# not subsystems). On the many-core remote hosts see \\\\\\\"Remote test servers\\\\\\\" below for\\\\n# which lanes may overlap.\\\\n#\\\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\\\n# (or `clojure -M:test -i :slow -n <ns>`).\\\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\\\n# When a test fails, reproduce and fix it by running ONLY the failing test\\\\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\\\\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\\\\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\\\\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\\\\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\\\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\\\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\\\\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01;\\\\n# for a fix branch, the previously-failing tests green IS the merge bar\\\\n# (owner ruling 2026-11-07; see Gate Ladder G0).\\\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\\\n# overlap lanes, see \\\\\\\"Remote test servers\\\\\\\" below).\\\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\\\nnpm test             # Node.js tests\\\\n\\\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\\\n                         # and the linker L5 Node reader that requires a module\\\\n                         # by name): `clojure -M:test` without it fails that test\\\\n```\\\\n\\\\n### Changed-only tests: `bb test:changed`\\\\n\\\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\\\nreach: the reverse require closure of the files changed since the\\\\nmerge-base with master, plus fixtures that mention a changed resource path,\\\\ntests that walk a changed tree, and each src file's `_test` by convention.\\\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\\\n(let-bound roots count), and a change under a root selects it. The three\\\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\\\nas for a change to the core everything requires (yin.vm engine,\\\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\\\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\\\\nand spawned programs that changed (target/yin-repl.js, Dart peers).\\\\n\\\\n### Sharded quick JVM feedback and change routing\\\\n\\\\n```sh\\\\nbb test:quick-sharded                           # Full G3-sized JVM quick lane, 4 workers\\\\nbb test:quick-sharded --changed src/cljc/yang/clojure.cljc\\\\nbb test:quick-sharded --base master --workers 6  # Changed selection, explicit worker limit\\\\nbb test:quick-sharded --list --changed src/cljc/yang/clojure.cljc\\\\nbb test:routed docs/agents/build-n-test.md       # Explicit changed paths (absolute OK)\\\\nbb test:routed --dry-run deps.edn               # Print dispatch; executes no gate\\\\nbb test:routed                                 # Git change set, same base as test:changed\\\\nbb deps:npm                                    # Content-checked local npm ci\\\\nbb -cp src/dev -m quick-sharded-test            # Runner/routing/cache self-tests\\\\n```\\\\n\\\\n`test:quick-sharded` is a JVM-only execution alternative for broad G2 and\\\\nthe JVM portion of G3. Without selection flags it selects every JVM test;\\\\n`--changed FILE...` or `--base REF` uses `affected/select` and\\\\n`affected/lane-tests`, exactly as `test:changed:clj` does. Wide input selects\\\\nthe full JVM set here. It never changes `test:changed`'s selection or exit-2\\\\nsemantics. `--workers N` must be positive (default 4 on the laptop).\\\\n\\\\nShard membership comes from every entry in `src/dev/subsystems.edn`, using\\\\n`affected/select-subsystems` and the same longest-prefix ownership rule as\\\\n`test:sub`. As in the shiva script below, currently unowned namespaces run\\\\nin an explicit `unmapped` residual shard, printed by name. Registry omissions\\\\ntherefore cannot silently shrink coverage. Each nonempty shard gets its own\\\\n`clojure -M:test -e :slow -n <ns> ...` process, with at most N JVMs running.\\\\nPrerequisites are derived from the entire selected JVM reach and finish\\\\nserially before workers start; the Node REPL build prerequisite\\\\n(`build:yin-repl-node`) also ensures `bb deps:npm`.\\\\n\\\\nEach invocation writes a separate `target/profile/quick-sharded-<id>/`:\\\\n`selected.txt`, `ns-<shard>.txt`, `covered.txt`, `uncovered.txt`, per-shard logs,\\\\nand `summary.edn`. Before execution it checks **set equality** between selected\\\\nnamespaces and the union of shard lists, plus absence of duplicate assignments.\\\\nAny uncovered, unexpected, or duplicate namespace fails loudly before tests.\\\\nThe final summary totals tests, assertions, failures and errors and separates\\\\nJVM wall time from total time including selection/builds. A nonzero child exit,\\\\nfailure/error, or missing final test-runner summary makes the task exit nonzero.\\\\nDry plans write namespace evidence but execute no builds or tests. An empty\\\\nselection prints `0 JVM namespaces selected` and exits 1, including dry plans.\\\\nThe final `summary.edn` includes a `:verification-scope` record; the same EDN\\\\nrecord is printed on stdout with `:type :verification-scope`, `:runner`,\\\\n`:scope`, `:exit`, `:dry-run?`, and `:gate-complete?`. JVM feedback always has\\\\n`:scope :jvm-feedback` and `:gate-complete? false`, even on exit 0.\\\\n\\\\n`test:routed <changed-files...>` applies this priority table to the whole change\\\\nset, prints the exact dispatch, executes it and propagates its result:\\\\n\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Change class (first match wins)                                                              | Dispatch                                                              |\\\\n+==============================================================================================+=======================================================================+\\\\n| Existing wide inputs (`deps.edn`, `bb.edn`, `src/dev/`, ANTLR, package locks, runner         | `bb test` — full quick tri-host; success required                     |\\\\n| configs, etc.), toolchain manifests, CI workflows, build scripts                             |                                                                       |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Only `.md`, `.txt`, `.rst` documentation, excluding test resources                           | `git diff --check HEAD -- <paths>` — documentation whitespace/format  |\\\\n|                                                                                              | lint only                                                             |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Foundation code owned by a layer-0 entry in `subsystems.edn`, or `yang.clojure`, `yang.php`, | `bb test:quick-sharded --changed <paths>` — broad selected JVM        |\\\\n| `yang.typescript`, `yang.python` code                                                        | feedback                                                              |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Other code/tests/fixtures with a nonempty affected selection                                 | `bb test:changed --changed <paths>` — existing quick tri-host         |\\\\n|                                                                                              | selection                                                             |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n| Other non-doc input with no statically selected tests                                        | `bb test` — fail closed rather than report a vacuous green gate       |\\\\n+----------------------------------------------------------------------------------------------+-----------------------------------------------------------------------+\\\\n\\\\nMixed changes take the widest matching route. Missing paths, an empty git change\\\\nset, unknown flags, and the wrong cwd fail. Deleted paths are validated against\\\\nthe base tree. If the leaf command returns exit 2, routing immediately dispatches\\\\n`bb test` and requires its success. `--dry-run`/`--list` only reports the route;\\\\nits zero exit is **not** a verification result. Documentation checks inspect\\\\nstaged and unstaged changes together against HEAD. Paths absent from\\\\n`git ls-files` print `unchecked (untracked)` and appear in the scope record\\\\nunder `:unchecked`; they cannot complete the docs gate. These checks do not lint\\\\nexecutable examples or validate documentation links.\\\\n\\\\nRouting prints its own final EDN verification-scope record. `:gate-complete?`\\\\nmeans the dispatched gate completed successfully, not that every landing gate\\\\nis satisfied. It is false for foundation/JVM feedback, dry runs, unchecked docs,\\\\nand failed dispatches. Successful checked docs, selected tri-host, and full\\\\nquick tri-host routes report `:docs-whitespace`, `:selected-quick-tri-host`, and\\\\n`:full-quick-tri-host` respectively. Exit codes continue to propagate child\\\\nresults, so automation must inspect the scope as well as the exit code.\\\\n\\\\n**Gate requirements are unchanged.** Sharded JVM success alone is not G2/G3\\\\ntri-host success: for foundation/compiler changes also run\\\\n`bb test:changed:cljs --changed <paths>` and\\\\n`bb test:changed:cljd --changed <paths>`, respecting the existing JVM/Dart\\\\nserialization rule. G1, full post-merge `bb test` (G3), applicable slow G4,\\\\ndemo smoke checks and review/landing gates all remain required. Node and Dart\\\\nlanes retain their current commands. The original unsharded tasks remain\\\\navailable. **Individual tests may run on the laptop; suite-scale runs may\\\\nnot (owner ruling 2026-11-04).** A single failing test or one namespace\\\\nreproduces quickly and is fine locally. Everything suite-scale — subsystem\\\\nlane sets (G1), changed-set runs (G2), the full quick suite, the slow tier,\\\\n`bb test:all`, and `nightly.clj` — runs on the remote hosts: the suite has\\\\noutgrown the laptop. The slow tier is 52 long namespaces whose JVM\\\\nprocesses each multi-thread (test workers, JIT, GC threads sized by core\\\\ncount); four of them GC-thrashing at once drove a laptop load average over\\\\n100 on 2026-11-01 while making no progress (the remote hosts run this tier:\\\\njupiter 5,645 s at 12 workers, shiva comparable). Do not run another lane\\\\nset concurrently on the laptop either.\\\\n\\\\n#### Worktree-local prerequisite caches\\\\n\\\\n`bb gen:antlr` now checks a content key over all grammar/manifests (including\\\\nrecorded helper/generated digests and runtime pins), the generator/cache source,\\\\n`deps.edn`, `mise.toml`, actual Java/javac versions and canonical worktree path.\\\\nIt also verifies the names and SHA-256 bytes of all generated targets, compiled\\\\nclasses and cached upstream helpers before a hit. Changed inputs or missing,\\\\nremoved or corrupted outputs trigger a full generation, retaining the generator's\\\\ndigest checks. Filtered/discovery invocations retain their CLI behavior and\\\\ninvalidate the complete-build stamp.\\\\n\\\\n`bb deps:npm` wraps `npm ci` with a key covering `package-lock.json`,\\\\n`package.json`, npm configuration, Node/npm versions, platform, relevant npm/Node\\\\nenvironment and worktree identity; it verifies the installed file tree before\\\\nreuse. A failed command never establishes a cache hit. Existing Node build tasks\\\\nensure this dependency too. Direct `npm ci` is still available.\\\\n\\\\nStamps and fail-fast writer locks live under `target/prereq-cache/`. Remove a\\\\nlock only after confirming its owning process died. Symlinked output parents\\\\nthat escape the worktree are refused. This is reuse **within one worktree**,\\\\nnot a shared artifact store: never share mutable `build/`, `lib/`, `target/` or\\\\n`node_modules/` across live worktrees. ANTLR generation and Dart compilation\\\\nstill require the existing worktree isolation/serialization rules; the cache\\\\ndoes not make overlapping builds and tests safe. Peer executables and shadow\\\\nbuilds themselves are not cached by this mechanism.\\\\n\\\\nLaptop pilot (2026-10-29, 8 cores, 4 workers, `yang.clojure.cljc` changed):\\\\nthe unchanged selector and the sharded plan both covered **61 JVM namespaces**;\\\\nboth completed with **955 tests, 14,848 assertions, zero failures/errors**.\\\\nSharded JVM wall time was **177.165 s** (total including prerequisites **257.207 s**;\\\\nouter command **258.27 s**). The original `test:changed:clj` command completed\\\\nin **376.79 s** overall and reported **298 s** for its JVM lane (that runner\\\\nrounds to whole seconds). The investigation's earlier unsharded command had\\\\ntimed out at 300 s without a summary. These are single-run observations, not\\\\na median/p95 claim or a replacement for tri-host landing verification.\\\\n\\\\n### Subsystem-first tests: `bb test:sub`\\\\n\\\\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\\\\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\\\\nis by longest namespace prefix matching.\\\\n\\\\n```sh\\\\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\\\\nbb test:sub:clj <subsystem>...    # JVM lane alone\\\\nbb test:sub:cljs <subsystem>...   # Node lane alone\\\\nbb test:sub:cljd <subsystem>...   # Dart lane alone\\\\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\\\\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\\\\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\\\\n```\\\\n\\\\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\\\\n\\\\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\\\\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\\\\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\\\\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\\\\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\\\\n- **Infrastructure**: `dev`, `bench`\\\\n\\\\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:antlr`)\\\\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\\\\nselected namespaces and run automatically when needed.\\\\n\\\\n#### Gate Ladder (docs/design/test.subsystems.md)\\\\n\\\\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\\\\n   **Failure-reproduction rule (owner ruling 2026-11-01): when a test fails anywhere — a\\\\n   gate, the nightly, or a delegate report — reproduce and fix it by running ONLY the\\\\n   failing test, never the whole suite.** JVM: `clojure -M:test -n <ns>` (a single\\\\n   deftest: add `-v <ns>/<var-name>`). Node: `node target/node-tests.js --test=<ns>`\\\\n   (built by `bb build:yin-repl-node` first only if that test needs the Node REPL).\\\\n   Dart: `bb src/dev/cljd_agg.clj --only <ns>[/<test-name>]` (owner ruling\\\\n   2026-11-07: the focus rule runs the failing TEST, not the namespace —\\\\n   `NS/test-name` entries become flutter `--plain-name` filters so only the\\\\n   named deftests execute; fall back to bare `<ns>` only when the failing\\\\n   var inside the namespace is not yet known, and narrow as soon as it is).\\\\n   Fix against the failing test alone, re-run it green, then climb back up\\\\n   (G1 for the home subsystem, G2 for dependents).\\\\n   Dart bug-chases may set `DATOM_FAIL_FAST=1` (owner ruling 2026-11-07): the\\\\n   scoped run stops at the first failure so the report arrives in minutes instead\\\\n   of after the full scoped set. Gate runs never set it — the merge bar needs the\\\\n   complete pass/fail picture. All dart runs use `--reporter expanded`, which\\\\n   streams failure names and positions inline so an interrupted run still retains\\\\n   them (the nightly's compact reporter lost 7 failure names to its 30000s wall,\\\\n   2026-11-06).\\\\n   Merge bar for a fix branch (owner ruling 2026-11-07, sharpening the 2026-11-01\\\\n   ruling): when the work is fixing already-failing tests, the previously-failing\\\\n   tests re-run green IS the merge bar — a fix branch merges on that alone; the\\\\n   G1/G2 climb applies to new feature slices, not to fixes. The full suite still\\\\n   gets its end-to-end confirmation from the daily nightly (04:00 VN), which is\\\\n   what catches collateral damage, not a pre-merge suite run.\\\\n   Never reproduce or chase a failure with the full suite or the slow tier — the full\\\\n   suite is not a debugging tool, and running it locally for one failing test is the\\\\n   exact misuse that drove a laptop load average over 100 (2026-11-01). A failure that\\\\n   only reproduces under the full suite's concurrency is diagnosed with the suite's own\\\\n   logs (its per-shard/per-test output), not by re-running the suite repeatedly.\\\\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\\\\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\\\\n4. **G3 Master (merged in place by the 2026-11-01 owner ruling)**: The landing gate\\\\n   for a change is the **tests that cover the feature being built** — `bb test:changed`\\\\n   (G2) already includes the reverse-require closure of the changed files, and a wide\\\\n   change still routes to the full quick lane. The complete suite is no longer a\\\\n   per-merge gate: it runs twice a day on the remote hosts (see \\\\\\\"Cadence\\\\\\\" below), so a\\\\n   break is caught within hours without charging every merge ~400 minutes of slow tier.\\\\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge\\\\n   (`bb test:slow` or `bb test:all`), at each phase boundary of a multi-phase track\\\\n   (owner decision 2026-10-12), and implicitly twice daily by the scheduled run below.\\\\n   G0 to G3 run the quick tier; G4 runs the slow tier.\\\\n\\\\n\\\\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\\\\nslice L5) is two tests:\\\\n\\\\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\\\\n  processes over real loopback UDP. A JVM publisher with a key file\\\\n  publishes modules by name, and JVM and Node readers require them by\\\\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\\\\n  and checks each section 9 failure as data. Ports are ephemeral, and\\\\n  every wait is bounded. A run takes a few minutes. Run it alone with\\\\n  `clojure -M:test -n yin.repl.dht-process-test`, after\\\\n  `bb build:yin-repl-node`.\\\\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\\\\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\\\\n  signed-name leg runs here, because no Dart `yin.repl.main` process\\\\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\\\\n  REPL.\\\\n\\\\n```sh\\\\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\\\\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\\\\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\\\\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\\\\n\\\\n# ClojureDart\\\\nclj -M:clojuredart:cljd compile\\\\n\\\\n# Linting\\\\nclj -M:kondo --lint <path>\\\\n```\\\\n\\\\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\\\\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\\\\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\\\\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\\\\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\\\\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\\\\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\\\\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\\\\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\\\\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\\\\n(greedy by file size; each imports its files and calls their `main`), runs\\\\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\\\\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\\\\ndifferent namespaces share an isolate per shard. Failures stay attributable:\\\\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\\\\n\\\\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\\\\ncompile does not prune it when a source file is deleted or renamed. The\\\\naggregated lanes only run namespaces that still exist under `test/`, but a\\\\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\\\\nbefore relying on that to prove a deletion or rename took effect.\\\\n\\\\n## Test tiers: quick and slow\\\\n\\\\nThe suite has two tiers so that slow tests run less often than quick ones\\\\n(owner decision, 2026-10-12).\\\\n\\\\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\\\\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\\\\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\\\\n- **Slow tier:** the tagged deftests. `bb test:slow` or\\\\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\\\\n- **The tagging rule** is the one above (\\\\\\\"When to tag a test slow\\\\\\\"): a deftest that\\\\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\\\\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\\\\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\\\\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\\\\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\\\\n  in all (some were already tagged). Per-test times are not in the repo: measure again\\\\n  with the method below before changing the cut.\\\\n- **Cadence (owner ruling 2026-11-05):** a merge needs only the tests that cover the\\\\n  feature being built — the affected/dependent set from `bb test:changed` (or\\\\n  `bb test:sub <own> --slow` when the change touches slow-tagged code). The FULL suite,\\\\n  including the slow tier, runs **once a day at 04:00 Asia/Ho_Chi_Minh** as a\\\\n  disjoint lane pair (`src/dev/nightly.clj`): **jupiter takes the jvm lane, shiva\\\\n  takes node and dart** (each lane in its own clone; shiva publishes the run pin,\\\\n  jupiter reads it and falls back to its own current master as an advisory run).\\\\n  The measured long set is ~400 minutes of serial slow-tier work, so it cannot be\\\\n  a per-merge cost; a break is instead caught by the next scheduled run.\\\\n  The schedule is an **hourly cron plus a Vietnam-time guard** in\\\\n  `~/ci/nightly-cron.sh` on each host (the guard fires only at the 04 VN hour and\\\\n  `flock` skips a slot whose previous run is still active), so it is immune to the\\\\n  DST shifts of either host's local timezone. **The cron entries are currently\\\\n  REMOVED (owner instruction 2026-11-06)**: the wrappers remain installed on both\\\\n  hosts and re-arming is one crontab line each\\\\n  (`0 * * * * ~/ci/nightly-cron.sh >> ~/ci/nightly-cron.log 2>&1`). Logs:\\\\n  `~/ci/nightly-cron.log`; results: `~/ci/nightly-results/<stamp>/summary.txt`.\\\\n\\\\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \\\\\\\"Remote test\\\\nservers\\\\\\\" for how to run them):\\\\n\\\\n| Run | Time |\\\\n|---|---|\\\\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\\\\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\\\\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\\\\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\\\\n\\\\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\\\\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\\\\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\\\\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\\\\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\\\\n\\\\n**How the per-test times were measured.** To time every deftest of a namespace alone,\\\\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\\\\notherwise swallows `-e`, and every JVM runs the whole suite):\\\\n\\\\n```sh\\\\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\\\\\\\"test\\\\\\\"]}}}' -M:t timing.clj\\\\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\\\\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\\\\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\\\\n# load) is paid by the first test in file order; check before tagging that test alone.\\\\n```\\\\n\\\\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\\\\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\\\\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\\\\nJVM test namespace under `test/`:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nPAR=\\\\\\\"${2:-8}\\\\\\\"\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nOUT=\\\\\\\"$1/target-ci/shards\\\\\\\"; rm -rf \\\\\\\"$OUT\\\\\\\"; mkdir -p \\\\\\\"$OUT\\\\\\\"\\\\nts() { date +%H:%M:%S; }\\\\necho \\\\\\\"start $(ts) $(git rev-parse --short HEAD) par=$PAR\\\\\\\" | tee \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nnpm ci --silent >\\\\\\\"$OUT/npm.log\\\\\\\" 2>&1                   && echo \\\\\\\"npm ok $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nbb build:yin-repl-node >\\\\\\\"$OUT/build-node.log\\\\\\\" 2>&1     && echo \\\\\\\"node repl built $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nbb gen:antlr >\\\\\\\"$OUT/antlr.log\\\\\\\" 2>&1             && echo \\\\\\\"antlr ok $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nSUBS=\\\\\\\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\\\\\\\"\\\\n: > \\\\\\\"$OUT/covered.txt\\\\\\\"\\\\nfor s in $SUBS; do\\\\n  bb test:sub:list \\\\\\\"$s\\\\\\\" 2>/dev/null | awk \\\\\\\"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");print}\\\\\\\" > \\\\\\\"$OUT/ns-$s.txt\\\\\\\"\\\\n  cat \\\\\\\"$OUT/ns-$s.txt\\\\\\\" >> \\\\\\\"$OUT/covered.txt\\\\\\\"\\\\n  echo \\\\\\\"$s $(wc -l < \\\\\\\"$OUT/ns-$s.txt\\\\\\\")\\\\\\\" >> \\\\\\\"$OUT/plan.txt\\\\\\\"\\\\ndone\\\\n# coverage: every JVM test namespace under test/ vs the union of the shards\\\\nfind test -type f \\\\\\\\( -name \\\\\\\"*_test.clj\\\\\\\" -o -name \\\\\\\"*_test.cljc\\\\\\\" \\\\\\\\) | sed -e \\\\\\\"s#^test/##\\\\\\\" -e \\\\\\\"s#\\\\\\\\.cljc\\\\\\\\?\\\\\\\\$##\\\\\\\" -e \\\\\\\"s#/#.#g\\\\\\\" -e \\\\\\\"s#_#-#g\\\\\\\" | sort -u > \\\\\\\"$OUT/all.txt\\\\\\\"\\\\nsort -u \\\\\\\"$OUT/covered.txt\\\\\\\" > \\\\\\\"$OUT/covered.sorted\\\\\\\"\\\\ncomm -23 \\\\\\\"$OUT/all.txt\\\\\\\" \\\\\\\"$OUT/covered.sorted\\\\\\\" > \\\\\\\"$OUT/ns-uncovered.txt\\\\\\\"\\\\necho \\\\\\\"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nrun_shard() {\\\\n  s=$1; f=\\\\\\\"$OUT/ns-$s.txt\\\\\\\"; [ -s \\\\\\\"$f\\\\\\\" ] || return 0\\\\n  args=(); while read -r n; do args+=(-n \\\\\\\"$n\\\\\\\"); done < \\\\\\\"$f\\\\\\\"\\\\n  t0=$(date +%s); clojure -M:test -e :slow \\\\\\\"${args[@]}\\\\\\\" >\\\\\\\"$OUT/$s.log\\\\\\\" 2>&1; rc=$?\\\\n  echo \\\\\\\"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \\\\\\\"^Ran \\\\\\\" \\\\\\\"$OUT/$s.log\\\\\\\" | tail -1)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n}\\\\nexport -f run_shard; export OUT; export -f ts\\\\nprintf \\\\\\\"%s\\\\\\\\n\\\\\\\" $SUBS uncovered | xargs -P \\\\\\\"$PAR\\\\\\\" -I{} bash -c \\\\\\\"run_shard {}\\\\\\\"\\\\necho \\\\\\\"done $(ts)\\\\\\\" | tee -a \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nPAR=\\\\\\\"${2:-6}\\\\\\\"\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nOUT=\\\\\\\"$1/target-ci/slowtier\\\\\\\"; rm -rf \\\\\\\"$OUT\\\\\\\"; mkdir -p \\\\\\\"$OUT\\\\\\\"\\\\nrun_ns() {\\\\n  n=$1; t0=$(date +%s)\\\\n  clojure -M:test -i :slow -n \\\\\\\"$n\\\\\\\" > \\\\\\\"$OUT/$n.log\\\\\\\" 2>&1; rc=$?\\\\n  echo \\\\\\\"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \\\\\\\"^Ran \\\\\\\" \\\\\\\"$OUT/$n.log\\\\\\\" | tail -1)\\\\\\\" >> \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n}\\\\nexport -f run_ns; export OUT\\\\necho \\\\\\\"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\\\\\\\" > \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\nxargs -P \\\\\\\"$PAR\\\\\\\" -I{} bash -c \\\\\\\"run_ns {}\\\\\\\" < \\\\\\\"$HOME/ci/pertest-ns.txt\\\\\\\"\\\\necho \\\\\\\"done $(date +%H:%M:%S)\\\\\\\" >> \\\\\\\"$OUT/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n## Remote test servers: shiva and jupiter\\\\n\\\\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\\\\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\\\\nand `git`.\\\\n\\\\n| Host | Cores / RAM | Toolchain state (server snapshot checked 2026-10-11; repo selection comes from `mise.toml`) |\\\\n|---|---|---|\\\\n| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\\\\n| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). mise was moved off the apt package to the official user-local install (`~/.local/bin/mise`, 2026.11.2, owner action 2026-11-07) so both hosts share shiva's layout; toolchains in `~/.local/share/mise/installs/` were untouched. Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\\\\n\\\\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\\\\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\\\\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\\\\n\\\\n### Kill remote processes by exact PID, never by name pattern\\\\n\\\\nOn these hosts, kill a runaway nightly/lane process by its exact PID\\\\n(`pgrep -af <pattern>` only to LIST, then `kill <pid>`), never with\\\\n`pkill -f <string>` / `killall <name>`. Measured 2026-11-06: `pkill -f\\\\n\\\\\\\"nightly.clj\\\\\\\"` over SSH matched the invoking bash command line itself\\\\n(the pattern appears in `ps` output of the session carrying the kill),\\\\nterminating the SSH session mid-command — exit 255 with the kill\\\\nhalf-done. A name-pattern kill also races concurrent seats: another\\\\norchestrator's delegate process whose arguments embed the same string\\\\ndies with yours. If the PID from `pgrep -af` is ambiguous (several\\\\ncandidates), inspect with `ps -o pid,etime,args -p <pid>` first and kill\\\\nthe exact process; a session that dies under you is a symptom of this\\\\nmistake, not a host outage.\\\\n\\\\n### Get the code there: push to origin, never rsync\\\\n\\\\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\\\\nwould take about an hour), and an unanchored `--exclude build` also dropped source\\\\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\\\\nbranch from the laptop (a feature branch, never master), make one scratch clone on\\\\nthe host from its existing checkout (a local clone takes seconds), and fetch:\\\\n\\\\n```sh\\\\n# once per host: a separate scratch clone, not the working copy\\\\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\\\\n  URL=$(git remote get-url origin);\\\\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\\\\n  cd ~/ci/datomworld-<name>; git remote set-url origin \\\\\\\"$URL\\\\\\\";\\\\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\\\\n```\\\\n\\\\nTo test another branch later, fetch and check it out in the scratch clone with\\\\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\\\\nwas never pushed cannot be tested remotely.\\\\n\\\\n### A clone is only current if it updated from real master\\\\n\\\\nA scratch clone's `origin/master` ref is only as fresh as the place it fetches\\\\nfrom — and a clone made from another scratch clone inherits that clone's *stale*\\\\nrefs. Measured on shiva 2026-11-02: the `dg` clone was created from the `p4`\\\\nscratch clone, whose local `master` ref had not moved since October 26 because\\\\nevery lane on it ran detached off fetched branches; the `dg` lane's\\\\n`checkout origin/master` therefore produced a commit 436 commits behind real\\\\nmaster, and the G3 Dart leg honestly reported failures (the datagram fix) for a\\\\ntree that did not contain them.\\\\n\\\\nBefore any lane runs in a clone — every time, not just the first:\\\\n\\\\n```sh\\\\ncd ~/ci/datomworld-<name>\\\\ngit remote get-url origin          # must be the GitHub URL, never another scratch clone\\\\ngit fetch -q origin \\\\\\\"+refs/heads/*:refs/remotes/origin/*\\\\\\\"\\\\ngit checkout -q --detach origin/master   # or the lane's branch\\\\ngit merge-base --is-ancestor <the-commit-hash-you-pushed> HEAD && echo CURRENT\\\\n```\\\\n\\\\nIf `origin` is not GitHub, repoint it (`git remote set-url origin \\\\\\\"$URL\\\\\\\"`). If\\\\nthe `merge-base` check fails, the clone's bookkeeping lies: refetch, or delete\\\\nand recreate the clone from GitHub directly. Never trust a hash the clone\\\\nreports without comparing it to the hash your push from the laptop printed.\\\\n\\\\n### Activate the toolchain in the right order\\\\n\\\\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\\\\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\\\\ninto the clone:\\\\n\\\\n```sh\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\\\\ncd ~/ci/datomworld-<name>\\\\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\\\\nmise install                                    # install versions selected by this checkout's mise.toml\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"                       # puts the repo-selected tools on PATH\\\\nmise current flutter                            # verify the selected Flutter version\\\\n```\\\\n\\\\nActivating mise before the `cd` and `mise trust` leaves the repo-selected tools\\\\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \\\\\\\"Can't\\\\nfind flutter on PATH\\\\\\\", and so does `bb build:yin-repl-peer`.\\\\n\\\\n### Which lanes may overlap (reconciling the one-lane-set rule)\\\\n\\\\n\\\\\\\"One lane set at a time\\\\\\\" and \\\\\\\"one Dart lane at a time\\\\\\\" are per-machine rules about\\\\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\\\\n`test.subsystems.md` section 5 item 6 says the same (\\\\\\\"on one machine where\\\\navoidable\\\\\\\"). The laptop additionally never runs the slow tier or the nightly\\\\ndriver (see the sharded-lane section) — a full slow tier there reached a load\\\\naverage over 100 on 2026-11-01; the remote hosts own that tier. On shiva (24 cores) and jupiter (48) the cores are not the limit, so\\\\nlanes may overlap, with these limits:\\\\n\\\\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\\\\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\\\\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\\\\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\\\\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\\\\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\\\\n  by the design's own reasoning (\\\\\\\"each worktree owns its own `cljd-out`\\\\\\\"), not yet\\\\n  verified by a measured run.\\\\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\\\\n  JVM lane only reads `target/yin-repl.js`.\\\\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\\\\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\\\\n- **Different branches in different clones** are independent, so two branches may\\\\n  run on one host if its cores and RAM allow (62 GB each).\\\\n- Do not treat this as permission to overlap lanes on the laptop.\\\\n\\\\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\\\\nthis rule was written down; its results are advisory until repeated with a\\\\nseparate Dart clone.\\\\n\\\\n**The nightly driver now enforces this by construction.** `src/dev/nightly.clj`\\\\n(2026-11-03, kimi-reviewed) runs a multi-lane invocation as one concurrent\\\\nfuture per lane, each in its OWN clone — jvm keeps the primary clone, node\\\\nand dart get `<primary>-node` / `<primary>-dart`. The pinned SHA is resolved\\\\nonce and checked out in every lane clone; a cache-warm pass\\\\n(`clojure -P -M:test:cljs:clojuredart:cljd`) runs in the primary before\\\\nfan-out so two clones never fetch into the shared `~/.m2`/`~/.gitlibs`\\\\nconcurrently; per-lane summaries are appended serially after the futures\\\\njoin. A single-lane invocation (jupiter's `jvm`) is unchanged: one clone,\\\\none serial lane. Both hosts run the same driver — the lane list on the\\\\ncommand line (shiva: `node,dart` + `--pin-publish`; jupiter: `jvm` +\\\\n`--pin-read --pin-peer shiva...`) is the only difference.\\\\n\\\\n### Scratch-clone first-run gaps (two measured sightings)\\\\n\\\\nA fresh scratch clone needs two things the lane runner does not yet set up\\\\nitself; until the runner heuristic is fixed, do them by hand before the\\\\nfirst lane:\\\\n\\\\n1. **`npm install`** — the Node tests require npm deps (`@noble/hashes` was\\\\n   the measured miss on shiva 2026-11-02: the cljs lane ran but the\\\\n   node-tests bundle died with `MODULE_NOT_FOUND`).\\\\n2. **`bb gen:antlr`** — the `prerequisites` heuristic in\\\\n   `src/dev/affected.clj` decides `:gen:antlr` from the JVM lane's reach\\\\n   only (\\\\\\\"ANTLR classes are JVM only\\\\\\\" — stale: python keeps multi-target\\\\n   parsers), so a cljs/cljd-only selection that reaches\\\\n   `yang.python.antlr.parser` (e.g. `bb test:sub:cljs yang.base` via\\\\n   `yin.repl.frontends`) skips the generation and the shadow build dies on\\\\n   the missing `Python3Lexer.js`. Sighted independently on the p4 lane\\\\n   (PhpLexer ClassNotFoundException) and the yang.base cljs lane\\\\n   (2026-11-02). The lane-runner fix landed 2026-11-03 (eb27fd47).\\\\n\\\\n### Merge verification: run the suite from a fresh clone, not the authoring worktree\\\\n\\\\nA merge whose new code reads a file that was never `git add`ed passes in\\\\nthe authoring worktree (the untracked file is still on disk there) and\\\\nbreaks everywhere else. Measured: the H3-0 landing (1fd7236b) merged\\\\n`kernel-declarations` — which reads\\\\n`yang/latte_oracle/slice9_declarations.edn` via `io/resource` at load —\\\\nwithout the file (untracked in the authoring worktree); master's\\\\nyang.latte-oracle-test died at load until the file was restored\\\\n(2026-11-04). Before landing any merge that adds code reading a new\\\\nresource, or after any merge at all when in doubt:\\\\n\\\\n```sh\\\\ngit worktree add /tmp/merge-verify <merge-commit>\\\\ncd /tmp/merge-verify && <the touched subsystem's focused test>\\\\ngit worktree remove /tmp/merge-verify\\\\n```\\\\n\\\\nA fresh clone/worktree has only committed files — a missing untracked\\\\nresource fails there immediately.\\\\n\\\\n### Ledger commit hygiene: never commit a conflict marker\\\\n\\\\nThe append-only ledgers (`docs/agents/known-gaps.md`,\\\\n`orchestrator-logs/*.md`, `docs/agents/routing-status.md`) resolve rebase\\\\nand merge conflicts by the union rule, which means conflicts are common —\\\\nand a conflict marker that reaches a commit silently corrupts the record\\\\n(measured: the 2026-10-30 rebase landed a log with three committed\\\\n`<<<<<<<`/`>>>>>>>` markers and dropped records the union was supposed to\\\\nkeep; caught by the architect four rounds later). Before committing ANY\\\\nchange to a ledger file:\\\\n\\\\n```sh\\\\ngit diff --cached | grep -E '^\\\\\\\\+(<{7}|={7}$|>{7})' && echo CONFLICT-MARKERS-STAGED\\\\ngit grep -E '^(<{7}|={7}$|>{7})' -- docs/agents/known-gaps.md orchestrator-logs docs/agents/routing-status.md\\\\n```\\\\n\\\\nIf either hits, the commit stops until the union is redone. When resolving\\\\na ledger conflict, prefer regenerating the union from both sides' section\\\\nlists over hand-merging, and re-read the result against BOTH parents before\\\\nstaging.\\\\n\\\\n### The jolt J2 lane: run it with `--jobs` on the servers\\\\n\\\\nThe jolt lane's core mode (`bb src/dev/jolt_j2_lane.clj core [--jobs N]\\\\n[--only re] [--timeout-ms M]`) runs each test namespace as its own child jolt\\\\nprocess (own Chez VM, own native parser library load, own log under\\\\n`build/j2-logs/core/`), so the namespaces cannot corrupt one another — the\\\\nonly thing `--jobs N` overlaps is the waiting. The default is `jobs 1`\\\\n(strictly serial), which on jupiter makes the full ~179-namespace lane a\\\\n5-6-hour run.\\\\n\\\\nOn the servers, run it with `--jobs 16`:\\\\n\\\\n- jolt children are essentially single-threaded (the 16 MiB parse thread\\\\n  only burns during parses) and cost 1-2 GB each, so 16 concurrent children\\\\n  sit far inside jupiter's 48 cores / 62 GB and shiva's 24 / 62;\\\\n- the lane's wall time is dominated by a few long namespaces\\\\n  (`yin.repl.python-antlr-test` has an explicit 3-hour step,\\\\n  `yin.vm.semantic.safepoint-harness-test` needs one — see\\\\n  `step-timeout-ms` in `src/dev/jolt_j2_lane.clj`), so beyond ~16 workers\\\\n  the critical path is the longest child, not the count;\\\\n- **parallel is unproven until checked once**: the recorded lane evidence\\\\n  (J2 closure, the safepoint 60/265,225/0 pass) was all produced `jobs 1`.\\\\n  The first parallel run must be compared per-namespace against a serial\\\\n  baseline; any namespace that flips red gets one serial re-run to\\\\n  attribute before its evidence is trusted. Until that first comparison\\\\n  passes, keep `jobs 1` for anything whose verdict is timing-sensitive —\\\\n  timeout and wall-time measurements, native-memory/leak gates, and the\\\\n  merge-decision qualification runs.\\\\n\\\\nSuites that exceed the lane's default step budget are pinned in the lane's\\\\n`step-timeout-ms` map with their measured wall time; a namespace timing out\\\\nunder the default budget is a reason to measure it serially and add an\\\\nentry, not to re-run under the same bound.\\\\n\\\\n### The full run\\\\n\\\\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\\\\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\\\\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\\\\ntasks use (the `bb test` task runs them one after another), and records each\\\\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\\\\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\\\\n\\\\n```sh\\\\n#!/usr/bin/env bash\\\\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (both hosts run all three lanes; a second clone for Dart is recommended)\\\\nset -u\\\\nexport PATH=\\\\\\\"$HOME/.local/bin:/snap/bin:$PATH\\\\\\\"\\\\nDART=\\\\\\\"${2:-}\\\\\\\"\\\\ncd \\\\\\\"$1\\\\\\\" || exit 2\\\\nmise trust >/dev/null 2>&1\\\\neval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\nLOG=\\\\\\\"$1/target-ci\\\\\\\"; mkdir -p \\\\\\\"$LOG\\\\\\\"\\\\nts() { date +%H:%M:%S; }\\\\necho \\\\\\\"start $(ts) $(git rev-parse --short HEAD)\\\\\\\" | tee \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nnpm ci --silent >\\\\\\\"$LOG/npm.log\\\\\\\" 2>&1               && echo \\\\\\\"npm ok $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb build:yin-repl-node >\\\\\\\"$LOG/build-node.log\\\\\\\" 2>&1 && echo \\\\\\\"node repl built $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb gen:antlr >\\\\\\\"$LOG/antlr.log\\\\\\\" 2>&1         && echo \\\\\\\"antlr ok $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nbb build:yin-repl-peer >\\\\\\\"$LOG/build-peer.log\\\\\\\" 2>&1 && echo \\\\\\\"dart peer built $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\nlane() { name=$1; shift; s=$(date +%s); \\\\\\\"$@\\\\\\\" >\\\\\\\"$LOG/$name.log\\\\\\\" 2>&1; rc=$?\\\\n         echo \\\\\\\"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"; }\\\\nlane jvm  clojure -M:test -e :slow &\\\\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\\\\nif [ -n \\\\\\\"$DART\\\\\\\" ]; then                            # its own clone (own lib/cljd-out, build/)\\\\n  ( cd \\\\\\\"$DART\\\\\\\" && mise trust >/dev/null 2>&1 && eval \\\\\\\"$(mise env -s bash)\\\\\\\"\\\\n    bb build:yin-repl-peer >\\\\\\\"$LOG/build-peer-dart.log\\\\\\\" 2>&1\\\\n    lane dart bb src/dev/cljd_agg.clj ) &\\\\nfi\\\\nwait\\\\necho \\\\\\\"done $(ts)\\\\\\\" | tee -a \\\\\\\"$LOG/summary.txt\\\\\\\"\\\\n```\\\\n\\\\n```sh\\\\nssh <host> 'tmux new-session -d -s ci-full \\\\\\\"bash -lc \\\\\\\\\\\\\\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\\\\\\\\\\\\\"\\\\\\\"'\\\\n```\\\\n\\\\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\\\\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\\\\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\\\\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\\\\n`bb test:clj`. For the slow set use `-i :slow` (or `bb test:slow`); the slow C4\\\\nscanner row took about 11-19 minutes on the JVM and about 79 minutes on Node\\\\n(measured 2026-10-11).\\\\n\\\\n### Known differences from the laptop\\\\n\\\\n- **`dao.stream.datagram.dart-test/refusals-and-lifecycle-events` on Linux —\\\\n  MEASURED AND FIXED (2026-11-02).** The old entry inferred that \\\\\\\"a second UDP bind on\\\\n  a taken port behaves differently on Linux\\\\\\\"; confirmed, with the cause. Dart's\\\\n  `RawDatagramSocket.bind` defaults to `reuseAddress: true`, and **Linux honours\\\\n  `SO_REUSEADDR` for UDP**, so a second bind to a port a reuse-enabled socket already\\\\n  holds *succeeds* (`strace`: `SO_REUSEADDR=1` on both sockets, no `SO_REUSEPORT`, both\\\\n  kernel `bind()` calls succeed); macOS refuses with errno 48. The seam was correct\\\\n  throughout — given a genuinely exclusive holder (`reuseAddress: false`) it deposits\\\\n  `bind-failed` in ~10 ms with errno 98. The test asserted one host's binding policy\\\\n  rather than the contract, so it now binds its own exclusive blocker\\\\n  (`RawDatagramSocket.bind \\\\\\\"127.0.0.1\\\\\\\" 0 .reuseAddress false .reusePort false`) and\\\\n  points the seam at that port: the failure path is exercised on both hosts. Verified\\\\n  on shiva: the namespace passes 5/5.\\\\n- A JVM lane started before the Dart peer is built skips the Dart-peer tests with a\\\\n  printed notice. The script builds the peer first so they run.\\\\n- Both hosts run other work (a QEMU guest and rustdesk on shiva); idle load is\\\\n  under 1, but timings are not a clean benchmark.\\\\n\\\\n### The nightly full suite and the branch-testing rule (2026-10-30 owner ruling)\\\\n\\\\nOwner, verbatim: \\\\\\\"since the complete test can take a good 7-8hrs to run\\\\ncompletely, it should be schedule to run once a day at 3am. while\\\\nbranch/worktree test should only run test that are targeting code\\\\nchanges\\\\\\\" — and, clarifying the nightly's target: \\\\\\\"it should not be for\\\\nonly a worktree/branch. the nightly complete test should be for master.\\\\\\\"\\\\n\\\\nTwo tiers, by target and purpose:\\\\n\\\\n- **The nightly full suite runs MASTER ONLY** (`~/ci/nightly-cron.sh` on\\\\n  shiva and jupiter, hourly cron plus a 04:00 Vietnam guard and flock,\\\\n  documented under \\\\\\\"Cadence\\\\\\\" above; the driver fetches and checks out\\\\n  origin/master before anything runs). Every lane, across the host pair:\\\\n  the JVM full suite on jupiter, the full Node and Dart suites on shiva.\\\\n  Its results are a\\\\n  post-hoc integrity net for master, NOT a landing gate. Failures it\\\\n  finds route to fix rounds the next morning.\\\\n- **Branch/worktree testing runs only the namespaces that target the\\\\n  changed code** (the diff's own tests plus the surfaces the diff\\\\n  touches), one JVM per namespace, plus one cheap portable lane (Node)\\\\n  when cljc goldens or fixtures moved. Never the full tier on a branch:\\\\n  a branch gate needs the changed code proven, not the whole tree\\\\n  re-proven. A branch is never promoted by its own testing — the merge\\\\n  to master is what puts it under the nightly.\\\\n\\\\nAn orchestrator landing a slice cites the subset runs plus the gate\\\\nsign-off; the nightly catches what the subset could not see, and a red\\\\nnightly owns the follow-up.\\\\n\\\\n**The merge precondition (2026-10-30 owner ruling, restored 2026-10-31 —\\\\na dedup pass dropped this section along with a stale duplicate of the\\\\ntwo-tier policy; both stand):** before any merge into master, the\\\\n`dao.stream` tests must run and pass — dao.stream is what everything is\\\\nbuilt on. Concretely: `bb test:sub dao.stream` (the subsystem's tests,\\\\n`--slow` when the slice touches slow-guarded surfaces) is part of every\\\\nbranch gate regardless of which subsystems the diff's own changes\\\\nselect, because a change can break the foundation without touching it.\\\\nA red dao.stream blocks the merge until fixed or diagnosed as\\\\npre-existing by the owning seat.\\\\n\\\\n### Measured times (first runs, 2026-10-11, commit 84c7c9b7, all lanes concurrent)\\\\n\\\\nShiva, Dart lane: 1054 s (17.5 min) cold, with the JVM and Node lanes running beside\\\\nit, against about 9 minutes on the 8-core laptop run alone. Prerequisites (`npm ci`,\\\\nNode REPL, ANTLR) took about 30 s; the Dart peer 91 s. JVM and Node lane times are\\\\nnot recorded yet: fill them in from `summary.txt` after a completed run. Running the\\\\nlanes concurrently on one host did not make the Dart lane faster, so count on the\\\\nextra cores, and measure before relying on a speedup. (Historical record — the\\\\n\\\\\\\"free laptop\\\\\\\" comparison predates the 2026-11-04 ruling that suite-scale runs\\\\nbelong on the remote hosts.)\\\\n\\\\n### Jupiter verification run (2026-10-29, commit 7c0a078f, scratch clone, sequential lanes)\\\\n\\\\nFirst full tri-host verification of jupiter. Prerequisites (npm ci, Node REPL,\\\\nANTLR via `gen:antlr`, Dart peer) all succeeded; the stale 3.41.9 Flutter was\\\\nreplaced with 3.47.8 before the Dart lane. Results: **JVM quick tier\\\\n(`test:quick-sharded`, 12 workers) rc=0 in 702 s** (cold, every shard green);\\\\n**Node quick tier rc=0 in 4583 s** (all tests pass, but roughly 15x the\\\\nlaptop — route Node lanes to shiva; the laptop comparison is historical and\\\\nsuite-scale Node runs no longer belong there per the 2026-11-04 ruling);\\\\n**Dart quick tier\\\\nrc=1 in 1495 s with the ONLY failure the documented known Linux-only red**\\\\n(`dao.stream.datagram.dart-test/refusals-and-lifecycle-events`, same\\\\ntaken-port/bind-failed signature recorded above). Routing summary: jupiter\\\\nis the preferred JVM/sharding box (48 cores); Node stays off it when wall\\\\ntime matters; Dart works on either host. Timings are single cold runs, not\\\\nmedians, and two foreign QEMU guests idle on the host.\\\\n\\\\nOne exception to the concurrency above: never run two lanes that both trigger\\\\n`gen:antlr` (the quick `test:cljs`/`test:cljd` tasks) in the SAME worktree at the\\\\nsame time — they race on `build/antlr` and `lib/antlr` and fail with\\\\n\\\\\\\"Patch does not apply\\\\\\\" or \\\\\\\"Generated sources differ from the recorded digests\\\\\\\".\\\\nRun them sequentially, or in separate clones (as the slow-tier harness does).\\\\nThe fix after a collision is `rm -rf build/antlr lib/antlr` and a rerun; the\\\\ngenerator is not idempotent over an already-patched tree. Corroborated twice in\\\\none week (the M3 round and the C3 completion round, 2026-10-18).\\\\n\\\\n### Remote agent execution (delegate CLIs on shiva and jupiter)\\\\n\\\\nOwner relay, 2026-10-24: the delegate agent CLIs — `claude`, `codex`, `glm` —\\\\nare installed and usable **on the remote hosts themselves**, not only from the\\\\norchestrator's laptop. This generalizes this section from \\\\\\\"run tests remotely\\\\nover SSH\\\\\\\" to \\\\\\\"delegate whole work agents remotely\\\\\\\": a heavy implementation or\\\\nverification leg (test lanes, native builds, fault-injection runs, multi-hour\\\\nsuites) can be executed by a delegate agent running on the server, keeping the\\\\norchestrator's laptop unloaded.\\\\n\\\\nThe pattern (composed from the rules above plus the delegate-invocation\\\\nreference):\\\\n\\\\n1. **Land the branch on origin first** (push from the laptop; never rsync) and\\\\n   prepare the scratch clone per \\\\\\\"Get the code there\\\\\\\".\\\\n2. **Start a named tmux session** for the task; run the agent inside it with\\\\n   the toolchain activated *inside* the tmux command (`eval \\\\\\\"$(mise env -s\\\\n   bash)\\\\\\\"` after the `cd` — the non-interactive SSH shell does not have it).\\\\n   A fresh clone hits mise's interactive trust prompt, which blocks the whole\\\\n   session until answered via `tmux send-keys`; pre-empt it with `mise trust`\\\\n   inside the same command.\\\\n3. **The remote agent works in the clone**: implement, build, run lanes,\\\\n   write its findings artifact — the same brief form as any delegate dispatch\\\\n   (role template, bounded file ownership, deliverable path), just executing\\\\n   on the host. Long jobs survive SSH drops because of tmux.\\\\n4. **The orchestrator polls detached files, never the pane** (pane captures\\\\n   carry control characters that make output look empty): rc files, summary\\\\n   logs and `ls *.flag` sentinels written by the run.\\\\n5. **Division of labor**: bookkeeping and polling are orchestrator SSH\\\\n   one-liners; execution belongs to the remote agent. Do not run heavy lanes\\\\n   from the orchestrator's laptop while a remote agent owns the same gate.\\\\n6. **Same trust rules as any delegate**: remote execution does not waive\\\\n   Workflow steps 6–7 of the orchestrator role — artifacts are verified, and\\\\n   review before commit applies to remote-produced work identically.\\\\n   Session-ID capture and resume rules from the delegate-invocation reference\\\\n   apply per host (each host's `~/.claude`, `~/.codex` store is its own).\\\\n\\\\nKnown state: `claude` and `codex` verified working on shiva (2026-10-24, the\\\\njolt canonical-fixes verification ran there); `glm` reported available by the\\\\nowner on both hosts, not yet exercised. Both hosts are toolchain-verified for\\\\nthe full tri-host suite (jupiter verified 2026-10-29 — see Measured times;\\\\nits 3.41.9 Flutter was replaced with 3.47.8, and model availability per\\\\nhost is governed by `routing-status.md`, not this file).\\\\n\\\\n## Testing Philosophy & TDD\\\\n\\\\nWrite tests before implementing features (TDD).\\\\n\\\\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\\\\n\\\\nWhen implementing a feature or fix:\\\\n1. **Red phase**: Write the test first — define what should happen.\\\\n2. **Green phase**: Implement the minimum code to pass the test.\\\\n3. **Refactor phase**: Refactor if needed while keeping tests green.\\\\n\\\\nThis ensures code is testable by design and implementation matches actual requirements.\\\\n\\\\n## Debugging Malformed CLJ / EDN / CLJS\\\\n\\\\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\\\\n\\\\n1. **Run clj-kondo first**:\\\\n   ```sh\\\\n   clj -M:kondo --lint path/to/file.cljs\\\\n   ```\\\\n\\\\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\\\\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\\\\n\\\\n3. **Fix one bracket at a time, re-run checker after each fix**:\\\\n   Common patterns:\\\\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\\\\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\\\\n   - Both can coexist while total bracket count is zero-sum.\\\\n\\\\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_3\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat test/yang/php/antlr/ticks_test.clj'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/safepoint.cljc'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.findings.md'\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_4\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/safepoint.cljc'\\\",\\\"aggregated_output\\\":\\\"(ns yang.php.antlr.safepoint\\\\n  \\\\\\\"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\\\\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\\\\n   operational fatal, not a guest Throwable.\\\\\\\"\\\\n  (:require\\\\n    [yang.core.uast :as u]))\\\\n\\\\n\\\\n(def profile\\\\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\\\\n\\\\n\\\\n(def ticks-profile\\\\n  \\\\\\\"Statement completion hooks for PHP's lexical ticks directives. This is\\\\n   separate from the execution-budget profile so ticks do not charge it.\\\\\\\"\\\\n  {:line {:hook 'php.sp/line, :operands true, :after true}})\\\\n\\\\n\\\\n(def fatal-text\\\\n  \\\\\\\"Maximum execution time of 30 seconds exceeded\\\\\\\")\\\\n\\\\n\\\\n(def ^:private function-definitions\\\\n  '[[php.sp/exhaust!\\\\n     ;; the terminal root escape: guest handlers, returns and finalizers\\\\n     ;; cannot replace the operational fatal\\\\n     (fn []\\\\n       (php/root-fatal \\\\\\\"Maximum execution time of 30 seconds exceeded\\\\\\\"))]\\\\n    [php.sp/tick\\\\n     (fn []\\\\n       (let [n (cell/get php.sp/remaining)]\\\\n         (if (= n 0)\\\\n           (php.sp/exhaust!)\\\\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\\\\n    [php.sp/loop (fn [] (php.sp/tick))]\\\\n    [php.sp/call (fn [] (php.sp/tick))]])\\\\n\\\\n\\\\n(defn- definitions->uast\\\\n  [defs]\\\\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\\\\n\\\\n\\\\n(defn program\\\\n  \\\\\\\"The bounded run: hook definitions and a counter holding `budget`, then the\\\\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\\\\n   anything else is a named host-side error, not a guest diagnostic.\\\\\\\"\\\\n  [budget ast]\\\\n  (when-not (and (integer? budget) (not (neg? budget)))\\\\n    (throw (ex-info \\\\\\\"php.sp/remaining budget must be a non-negative integer\\\\\\\"\\\\n                    {:yang.php.antlr.safepoint/error :invalid-budget\\\\n                     :budget budget})))\\\\n  (u/mark-tails\\\\n    (u/then (definitions->uast function-definitions)\\\\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\\\\n                    ast))))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_3\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat test/yang/php/antlr/ticks_test.clj'\\\",\\\"aggregated_output\\\":\\\"(ns yang.php.antlr.ticks-test\\\\n  (:require\\\\n    [clojure.test :refer [deftest is testing]]\\\\n    [yang.php.antlr.cst :as cst]\\\\n    [yang.php.antlr.e2e-harness :as h]\\\\n    [yang.php.antlr.linked-harness :as lh]\\\\n    [yang.php.antlr.programs-p7b :as p7b]))\\\\n\\\\n\\\\n(deftest tick-fixtures-test\\\\n  (doseq [{:keys [id source out units]} p7b/fixtures\\\\n          :when (nil? units)]\\\\n    (testing (name id)\\\\n      (is (= out (:php/out (h/run-raw (str \\\\\\\"<?php \\\\\\\" p7b/prologue source))))))))\\\\n\\\\n\\\\n(deftest include-handoff-test\\\\n  (let [{:keys [source units out]} (last p7b/fixtures)\\\\n        packets (update-vals (assoc units \\\\\\\"main.php\\\\\\\" (str \\\\\\\"<?php \\\\\\\" p7b/prologue source))\\\\n                             cst/parse-source)\\\\n        result (lh/run-fixture packets \\\\\\\"main.php\\\\\\\" {})]\\\\n    (doseq [[vm value] (:values result)]\\\\n      (is (= out (h/latin1->text (:php/out value))) (name vm)))))\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_5\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc 'cat collab/yang-php/1794567570000-architect-ticks-counter-ruling.gpt-6-astra.findings.md'\\\",\\\"aggregated_output\\\":\\\"Completed-GMT: 2026-11-13 11:04:20 GMT\\\\nCompleted-Local: 2026-11-13 18:04:20 +0700\\\\nCoding-Agent: codex\\\\nRole: Architect, slice-3 design consult\\\\nReviewed checkout: p7b-ticks @ 38375bf7\\\\nStatus: counter ruling complete; implementation and formal corpus acceptance remain outstanding\\\\n\\\\n**Ruling: one counter per PHP request, with the threshold supplied by each selected statement-completion hook.** There is no counter per declare occurrence, source file, function/op_array, closure, or generator. Lexical scope controls which completion sites exist and their thresholds; it does not partition the runtime count.\\\\n\\\\nThis is supported both by PHP-8.3 source inspection and direct execution of 21 small programs on shiva's PHP 8.3.35 oracle image. All five staged expectations match. This consult changes only this findings artifact: no source, test, design-document, fixture-provenance, or branch changes; no commit or push.\\\\n\\\\n**Findings and reconciliation**\\\\n\\\\n| Severity | Location | Evidence / required correction |\\\\n|---|---|---|\\\\n| P1 — contradictory implementation instruction | `collab/yang-php/1794567390000-engineer-p7b-ticks-c.prompt.md:20` | The explicit “a count is per declare-site, PHP semantics” instruction is incorrect. Replace it with the request-owned counter rule in this ruling. Part C was right to escalate the conflict instead of claiming parity. |\\\\n| Resolved — slice-3 ownership | `collab/orch-lane/1794700000000-architect-safepoint-slice3-design.gpt-6.1-sol.findings.md:103` | The text explicitly says “request-owned counter” and says state survives calls, includes, and generator switches. Its lifecycle table at lines 123–127 and implementation assignment at line 257 reinforce that contract. The implementer's request-wide reading is correct. |\\\\n| P2 — stale design status/timing | `docs/design/yang.php.md:1938` | §12 still says sites are before statements and the generic extension refuses non-lambdas. The implemented after-wrapper is at `src/cljc/yang/safepoint.cljc:153`; PHP's profile is at `src/cljc/yang/php/antlr/safepoint.cljc:13`. Reconcile §12 in the implementation round. |\\\\n| P1 — acceptance does not discriminate ownership | `test/yang/php/antlr/programs_p7b.cljc:10` | Every staged tick threshold is 1. All these outputs can pass with an incorrectly partitioned counter. Add N>1 boundary/threshold cases below before claiming counter parity. |\\\\n| P2 — oracle exit status is insufficient for pending rows | `src/dev/yang/php/oracle.clj:558` | Pending rows are excluded from failures, while `check-p7-fixture` at line 492 deliberately leaves their `:pass?` false. Read and compare actual records; exit 0 / “failures: 0” alone proves no parity for these rows. |\\\\n\\\\nI own the reconciliation failure between the design, stale documentation, and implementation brief. The slice-3 counter paragraph itself was explicit, not ambiguous. Its omission of a compact lexical-versus-runtime decision table made the broader artifact set easier to misread. At this checkout, neither §12 nor the §15 P7-b row (`yang.php.md:2106`) actually specifies a per-declare counter; §15 requires PHP-equivalent tick counts. File-scoped compilation does not imply file-owned execution state.\\\\n\\\\n**PHP 8.3 source evidence**\\\\n\\\\nThe links below refer to the PHP-8.3 branch inspected for this consult; line numbers are ordinary one-based file lines. They are source references, not a claim that the moving branch is the exact source hash of the oracle image.\\\\n\\\\n- [Zend/zend_globals.h:187](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_globals.h#L187): `ticks_count` is a field of executor globals.\\\\n- [Zend/zend_execute_API.c:151](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute_API.c#L151): `init_executor()` initializes it to zero for execution/request startup.\\\\n- [Zend/zend_execute.c:5153](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_execute.c#L5153) includes generated `zend_vm_execute.h`. The tick handler's maintained definition is [Zend/zend_vm_def.h:7439–7452](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7439). Its test is `(uint32_t)++EG(ticks_count) >= opline->extended_value`; it resets the count before calling the tick dispatcher. It counts even when no dispatcher is installed. This is an executor-global accumulator and an instruction-local threshold, not op_array-local state.\\\\n- Compiler mechanism: [Zend/zend_compile.c:344–361](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L344) initializes a new file's compile-time ticks setting to zero and restores the prior file context on exit. [Lines 5938–5994](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L5938) convert the directive literal to a long, update that setting, compile a block, and restore its prior setting; the semicolon form leaves it changed. [Lines 7065–7200](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L7065) switch function op_arrays without starting a fresh file context. [Lines 9784–9785](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9784) emit ticks after selected statements when the setting is nonzero. [Lines 2110–2121](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2110) place that setting in the instruction's extended operand and suppress adjacent duplicate tick emission. [Lines 2518–2522](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L2518) enumerate excluded statement categories; [lines 9659–9668](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_compile.c#L9659) separately handle top-level function/class declarations. A blanket “hook every AST statement” translation is insufficient.\\\\n- [Zend/zend_vm_def.h:7867–7874](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_vm_def.h#L7867): yield saves the next instruction and returns. [Zend/zend_generators.c:706–828](https://github.com/php/php-src/blob/PHP-8.3/Zend/zend_generators.c#L706) restores execution frames/JIT context around resume, not a saved tick count.\\\\n- [ext/standard/basic_functions.c:1549–1569](https://github.com/php/php-src/blob/PHP-8.3/ext/standard/basic_functions.c#L1549): user tick dispatch guards each executing registered entry against reentry. Do not replace this with a global “ticks busy” rule that stops counting all guest tick sites. Registered callback arguments are its registration arguments, not the line/unit/threshold operands.\\\\n\\\\nThus switching files or op_arrays changes the instructions being executed, and possibly their embedded thresholds, without selecting a different counter. The runtime probes below independently confirm the relevant observable consequences.\\\\n\\\\n**Normative decision table for the implementer**\\\\n\\\\n| Concern | Required behavior |\\\\n|---|---|\\\\n| Counter owner | Allocate one explicit guest request-owned counter, initially 0, shared by all PHP tick hooks in that request. Keep it in existing guest execution/store machinery; introduce no host global or shared process state. |\\\\n| Increment and firing | On each selected normal completion, increment once. If the new count is **greater than or equal to** that site's N, reset to 0 **before** dispatching registered handlers. Do not use equality, modulo, subtraction of N, or a threshold-global “current N.” |\\\\n| Reset points | Request initialization and threshold firing only. No reset at declare entry/exit, function call/return, include/return, registration/unregistration, generator switch, or exception/context restoration. A new independent request starts from zero. |\\\\n| Empty registry | Continue incrementing/resetting at selected sites. Registration changes dispatch membership, not counter phase. Confirmed by the empty-registry probe. |\\\\n| Lexical N | Each mark carries its own effective compile-time N. An inner block directive overrides the enclosing value for its body; exiting that block restores the outer value for subsequent emitted sites. Entering/leaving either block does not reset the accumulated count. |\\\\n| N=0 | That lexical region contributes no tick instructions for its own statements; it does not clear accumulated progress. An enclosing nonzero context may still select the completion of the declare construct itself. |\\\\n| Directive syntax | Preserve block versus semicolon behavior and Zend's statement-selection/adjacent-suppression behavior. A directive can itself lead to a tick: the measured semicolon case below produces ATB, not ABT. There is no extra generic “enter declare” runtime reset or hook. |\\\\n| N validation/range | Ordinary positive integer thresholds and zero are the cases established here. Do not invent “all N<=0 disable ticks”: Zend's literal conversion and unsigned instruction operand are separate concerns. Broader literal/range acceptance needs its own oracle cases or an explicit supported-subset refusal. |\\\\n| Functions and closures | Retain body-site thresholds from compilation. A call from ticked code does not dynamically instrument an unticked body. A ticked body contributes to the same request count even when called from unticked code or after its defining include has returned. |\\\\n| Generator yield/resume | Preserve the pending after-hook in the continuation. Suspension itself does not complete the yield statement. On eventual normal completion run that hook once using the then-current request counter. Repeated inspection of a suspended value does not replay it. Never snapshot/restore the count with generator context. |\\\\n| Nonlocal exit | A statement whose normal completion is bypassed contributes no after-hook. Already completed sites retain their count effects through throw/unwind. A callback exception cannot undo the reset that preceded dispatch. A pending hook is not a finally hook. |\\\\n| Include/include_once | Included code has its own lexical sites/N; the caller's pragma is not inherited dynamically. All executed sites share the request counter. Repeated includes revisit their sites; a skipped once body contributes none. A selected caller include statement still completes and can tick even when the once body is skipped. |\\\\n| Budget/profile separation | Statement ticks do not charge `php.sp/tick`, the existing execution-budget hook. Preserve independently selected `:call`/`:loop` sites and the shared VM semantics. |\\\\n\\\\nThe intended profile and operand contract remains exactly:\\\\n\\\\n```clojure\\\\n{:line {:hook 'php.sp/line :operands true :after true}}\\\\n\\\\n[:line n {:unit unit-path :ticks N}]\\\\n;; derives:\\\\n(php.sp/line n {:unit unit-path :ticks N})\\\\n```\\\\n\\\\nHere `n` and `:unit` identify the source occurrence; neither is a counter key. `:ticks` is the effective instruction threshold, not a declaration identifier. The generic safepoint stage transports literals and performs value-preserving normal-completion placement; PHP lowering owns eligible-site selection and PHP runtime code owns counting/dispatch. Omitting `:line` from a derivation profile omits these hooks; canonical program rows remain unchanged.\\\\n\\\\n**Include-site handoff remains a landing requirement**\\\\n\\\\nThe source-unit operand does not itself transport marks through publication. At `src/cljc/yang/php/antlr/publication.cljc:42`, `:site-set` is still nil. Preserve slice-3 lines 133–154: publish and retrieve verified occurrence site sets bound to the canonical root/source association; derive included executable images using the selected ticks profile; pin the hook dependency and derived images; handle SCC bundles and repin member aliases. Missing required metadata must fail closed, whereas a verified empty set for an unticked unit is legitimate.\\\\n\\\\nEvery derived module must resolve the same request's hook/state. Including a module must not reinitialize the tick registry or accumulator. A retained closure keeps its defining unit's operands and uses the active request's shared counter. No extra counter indexed by declaration, unit, or line is needed.\\\\n\\\\n**Measured fixture evidence**\\\\n\\\\nExecuted on `shiva.stigmergy.systems`, 2026-11-13, in fresh disposable containers per program. Existing tag `php:8.3-cli` reports PHP 8.3.35 CLI NTS / Zend 4.3.35, built 2026-10-06. The shorter `php:8.3` tag was not installed; no image was pulled.\\\\n\\\\n- Image ID: `sha256:7855de8f54c32ffc92720b20b550f2dbc1c82c2000c7a850ccf350f71c36293f`\\\\n- Repository digest: `php@sha256:aafe21201943a8a6e497ddfb471e2ce68ada76adede38c7d61fede8918b24319`\\\\n\\\\nEach main program and included unit was placed in a temporary directory, mounted read-only at /w, with this invocation:\\\\n\\\\n```sh\\\\ndocker run --rm --pull=never --network=none --read-only \\\\\\\\\\\\n  -v <temporary-directory>:/w:ro -w /w php:8.3-cli php \\\\\\\\\\\\n  -d display_errors=1 -d html_errors=0 -d error_reporting=E_ALL \\\\\\\\\\\\n  -d log_errors=0 -d auto_prepend_file=/w/pre.php main.php\\\\n```\\\\n\\\\nThe unticked pre.php was the exact staged prologue:\\\\n\\\\n```php\\\\n<?php function tick_handler() { echo 'T'; } register_tick_function('tick_handler');\\\\n```\\\\n\\\\nThis matches the P7 oracle runner's prepend-unit arrangement. Every one of the 21 executions exited 0 with empty stderr and exactly the stdout recorded here, with no diagnostics. Temporary directories were removed. These are independent direct PHP oracle measurements, **not** a run of the Clojure `--p7` wrapper or of yang.php.\\\\n\\\\n| Fixture and source location | Staged expected | Measured PHP 8.3.35 | Interpretation |\\\\n|---|---|---|---|\\\\n| sequence, `programs_p7b.cljc:10` | ATTBT | ATTBT | Three completions: echo A, assignment, echo B. |\\\\n| loop-body, line 12 | ATAT | ATAT | Only the inner declared body is ticked; loop machinery is outside its directive. |\\\\n| function-call, line 14 | FT | FT | f's body is unticked; the call statement's normal completion ticks. |\\\\n| generator-resume, line 16 | ATBT | ATBT | current() suspends at yield; A prints; next() completes yield and ticks, then B completes and ticks. |\\\\n| include-handoff, line 19 | LT | LT | Included lib.php owns a ticked echo site; the caller is unticked. |\\\\n\\\\nThe sequence variants also confirm the slice-3 proposals: N=2 gives ATB; N=0 gives AB.\\\\n\\\\n**Oracle acceptance ruling**\\\\n\\\\nThere is no remaining choice between counter architectures: the source mechanism and the N>1 measurements settle it in favor of the request-owned count. PHP remains the authority for exact site selection and observable output if a lowering prediction disagrees.\\\\n\\\\nThe formal `--p7` pass on shiva MUST compare all five current IDs: `:sequence`, `:loop-body`, `:function-call`, `:generator-resume`, and `:include-handoff`, including output, absence of diagnostics/uncaught errors, and successful exit. Record actual version, image digest, host, and date. Do not infer a passing fixture from the current runner's pending-row exit status. This consult leaves all `:oracle :pending` fields untouched.\\\\n\\\\nFor counter-ownership acceptance, the implementer must add and oracle-confirm at least separate-declares, nested-threshold, cross-function, cross-include, and generator-shared from the appendix. Also retain the zero-gap, unticked-include, registration/empty-registry, retained-closure, exception, once-skip, and semicolon regressions. The original five N=1 rows cannot replace these discriminators. P7-b's remaining lowering/runtime/linking gates and the broader slice-3 callback/escape/cleanup cases remain required; this consult is not implementation sign-off.\\\\n\\\\n**Reproducible additional probes**\\\\n\\\\nEach source below is main.php after an opening PHP tag, with the same separate pre.php above. Where shown, lib.php is a separate file. Outputs are observations, not new hand-derived goldens.\\\\n\\\\n**sequence-n2 — measured `ATB`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\\\\n```\\\\n\\\\n**sequence-n0 — measured `AB`.**\\\\n\\\\n```php\\\\ndeclare(ticks=0) { echo 'A'; $x = 1; echo 'B'; }\\\\n```\\\\n\\\\n**separate-declares — measured `ABT`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2) { echo 'A'; } declare(ticks=2) { echo 'B'; }\\\\n```\\\\n\\\\n**nested-threshold — measured `ABCTD`.**\\\\n\\\\n```php\\\\ndeclare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\\\\n```\\\\n\\\\n**zero-gap — measured `ABCT`.**\\\\n\\\\n```php\\\\ndeclare(ticks=3) { echo 'A'; } declare(ticks=0) { echo 'B'; } declare(ticks=3) { echo 'C'; $x=1; }\\\\n```\\\\n\\\\n**cross-function — measured `AFT`.**\\\\n\\\\n```php\\\\nfunction f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\\\\n```\\\\n\\\\n**repeat-function — measured `F|FT`.**\\\\n\\\\n```php\\\\nfunction f() { declare(ticks=2) { echo 'F'; } } f(); echo '|'; f();\\\\n```\\\\n\\\\n**cross-include — measured `ALT`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2) { echo 'A'; } include 'lib.php';\\\\n```\\\\nlib.php:\\\\n```php\\\\n<?php declare(ticks=2) { echo 'L'; }\\\\n```\\\\n\\\\n**unticked-include — measured `ALTB`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2) { echo 'A'; include 'lib.php'; echo 'B'; }\\\\n```\\\\nlib.php:\\\\n```php\\\\n<?php echo 'L';\\\\n```\\\\n\\\\n**generator-shared — measured `ABTC`.**\\\\n\\\\n```php\\\\nfunction g() { declare(ticks=2) { yield 1; } } $a=g(); $b=g(); $a->current(); $b->current(); echo 'A'; $a->next(); echo 'B'; $b->next(); echo 'C';\\\\n```\\\\n\\\\n**registration-no-reset — measured `ABT`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2) { echo 'A'; } unregister_tick_function('tick_handler'); register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\\\n```\\\\n\\\\n**empty-registry — measured `ABT`.**\\\\n\\\\n```php\\\\nunregister_tick_function('tick_handler'); declare(ticks=2) { echo 'A'; } register_tick_function('tick_handler'); declare(ticks=2) { echo 'B'; }\\\\n```\\\\n\\\\n**semicolon-directive — measured `ATB`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2); echo 'A'; echo 'B';\\\\n```\\\\n\\\\n**include-closure — measured `AFBFT`.**\\\\n\\\\n```php\\\\ninclude 'lib.php'; echo 'A'; $f(); echo 'B'; $f();\\\\n```\\\\nlib.php:\\\\n```php\\\\n<?php $f=function(){ declare(ticks=2) { echo 'F'; } };\\\\n```\\\\n\\\\n**exception-no-reset — measured `ABT`.**\\\\n\\\\n```php\\\\ndeclare(ticks=2) { echo 'A'; } try { throw new Exception(); } catch (Exception $e) {} declare(ticks=2) { echo 'B'; }\\\\n```\\\\n\\\\n**once-skip — measured `LBT`.**\\\\n\\\\n```php\\\\ninclude_once 'lib.php'; include_once 'lib.php'; declare(ticks=2) { echo 'B'; }\\\\n```\\\\nlib.php:\\\\n```php\\\\n<?php declare(ticks=2) { echo 'L'; }\\\\n```\\\\n\\\\n**Review scope and properties confirmed**\\\\n\\\\nRead the repository architecture rules, slice-3 design, §12/§15, part-C brief/findings, staged programs/tests, PHP profile and shared after-wrapper, publication seam, and P7 oracle wrapper. Inspected the cited PHP-8.3 compiler/executor/generator/callback sources. Confirmed request-owned explicit state, lexical operand ownership, budget separation, after-normal-completion placement, and unchanged generic VM semantics as the intended architecture. Ran only the 21 direct PHP probes; no Clojure/Node/Dart implementation gates or formal corpus fold were run. The profile declaration exists, but `php.sp/line`, lowering/registry integration, and linked site handoff remain the implementer's work.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\