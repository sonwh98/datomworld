tlr.ticks-test\\\"\",\"aggregated_output\":\"Reformatting source file src/dev/yang/php/oracle.clj\\nCorrected formatting of 1 files\\nLoading initial Timbre config from: :default\\n\\nRunning tests in #{\\\"test\\\"}\\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\\n\\nTesting yang.php.antlr.ticks-test\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nsequence\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATTBT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nloop-body\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATAT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\nfunction-call\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"FT\\\" \\\"\\\"))\\n\\nFAIL in (tick-fixtures-test) (ticks_test.clj:14)\\ngenerator-resume\\nexpected: (= out (:php/out (h/run-raw (str \\\"<?php \\\" p7b/prologue source))))\\n  actual: (not (= \\\"ATBT\\\" \\\"\\\"))\\n\",\"exit_code\":124,\"status\":\"failed\"}}\ncollab/yang-php/1794566777000-engineer-p7b-ticks-b.gpt-6.1-terra.stdout.log:79:{\"type\":\"item.started\",\"item\":{\"id\":\"item_41\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"timeout 45 clojure -A:oracle -e '(require (quote yang.php.oracle) (quote clojure.java.shell) (quote yang.php.antlr.programs-p7b)) (let [d (.toFile (java.nio.file.Files/createTempDirectory \\\\\\\"p7-check-\\\\\\\" (make-array java.nio.file.attribute.FileAttribute 0))) f (last yang.php.antlr.programs-p7b/fixtures) calls (atom nil)] (with-redefs [clojure.java.shell/sh (fn [& args] (reset\\\"'! calls args) {:out \\\"LT\\\" :err \\\"\\\" :exit 0})] (let [r (yang.php.oracle/check-p7-fixture d f)] (assert (= \\\"LT\\\" (get-in r [:actual :out]))) (assert (= :pending (:oracle r))) (assert