{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat src/cljc/yang/php/antlr/safepoint.cljc; rg -n 'primitive-declaration|module-spec|php.sp/line' src/cljc/yang/php/antlr/{lower,prelude}.cljc; sed -n '410,430p' src/cljc/yang/safepoint.cljc; rg -n ':stage|:datoms|:principals' src/cljc/yin/vm/linker/interpreter.cljc\"","aggregated_output":"(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def ticks-profile\n  \"Statement completion hooks for PHP's lexical ticks directives. This is\n   separate from the execution-budget profile so ticks do not charge it.\"\n  {:line {:hook 'php.sp/line, :operands true, :after true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\nsrc/cljc/yang/php/antlr/lower.cljc:3911:(defn module-spec\nsrc/cljc/yang/php/antlr/lower.cljc:3918:  (core-module/module-spec\nsrc/cljc/yang/php/antlr/lower.cljc:3975:  (core-module/module-spec\nsrc/cljc/yang/php/antlr/lower.cljc:3985:(defn scc-module-specs\nsrc/cljc/yang/php/antlr/lower.cljc:4027:        bundle (core-module/module-spec\nsrc/cljc/yang/php/antlr/lower.cljc:4036:    (core-module/scc-module-specs\nsrc/cljc/yang/php/antlr/prelude.cljc:4498:    [php.sp/line\nsrc/cljc/yang/php/antlr/prelude.cljc:6306:(defn module-spec\nsrc/cljc/yang/php/antlr/prelude.cljc:6312:  (core/module-spec {:module-name module-name,\n                                         (into injected-entries\n                                               (sorted (into (:unmapped parts)\n                                                             refused-injected))))}}))))\n\n\n(defn derive-record\n  \"The `:derive` record linking canonical root `input` to derived root\n   `output`: function `function`, profile pinning the hook map and the\n   address of the sorted site set.\"\n  [input output profile selected]\n  {:yin.ledger/op :derive,\n   :yin.ledger/input input,\n   :yin.ledger/output output,\n   :yin.ledger/function function,\n   :yin.ledger/profile {:yang.safepoint/hooks profile,\n                        :yang.safepoint/sites (jing/segment-key\n                                                (site-set selected))}})\n\n\n(defn derive-envelope\n  \"One projected envelope from the row medium to the derived one:\n74:  (linker.dht/authority (select-keys source [:principals :name-env])))\n158:   :datoms (into []\n161:   :principals (:principals source)})\n181:    (if (or (nil? (:stage source))\n189:          {:node (linker.dht/load-stage node (:stage source)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '6220,6255p;6300,6335p' src/cljc/yang/php/antlr/prelude.cljc; sed -n '1,150p' src/cljc/yang/core/module.cljc; cat test/yang/php/antlr/siteset_test.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '6220,6255p;6300,6335p' src/cljc/yang/php/antlr/prelude.cljc; sed -n '1,150p' src/cljc/yang/core/module.cljc; cat test/yang/php/antlr/siteset_test.clj\"","aggregated_output":";; =============================================================================\n;; The module emitter: the same definition list as the linker module `php`\n;; =============================================================================\n\n(def module-name\n  \"The linker module the PHP runtime profile is published as.\"\n  'php)\n\n\n(def runtime-keys\n  \"Every key `php/init!` allocates, the ready flag aside, sorted.\"\n  '[php.rt/class-index php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/diag-stream\n    php.rt/error-handler\n    php.rt/error-mask php.rt/error-masks\n    php.rt/class-order php.rt/exception-handler php.rt/exception-handlers php.rt/finalizable php.rt/pending-exc\n    php.rt/tick-count php.rt/tick-functions php.rt/shutdown-fns php.rt/exit-status php.rt/in-shutdown php.rt/fatal-escape\n    php.rt/exit-escape php.rt/shutdown-escape php.rt/strict php.rt/included php.rt/path-map php.rt/unit\n    php.rt/autoloaders php.rt/autoloading php.rt/class-map php.rt/constants\n    php.rt/error-reporting php.rt/error-handlers php.rt/functions php.rt/globals php.rt/int-max\n    php.rt/int-min php.rt/next-cell php.rt/next-ord\n    php.rt/out php.rt/request php.rt/response php.rt/response-stream\n    php.rt/headers-sent php.rt/status php.rt/tmps])\n\n\n(defn strip\n  \"`sym` without the module's own namespace `php`; `php.rt/*` stays\n   qualified.\"\n  [sym]\n  (core/strip \"php\" sym))\n\n\n(defn- binder-symbols\n  \"Every symbol a `fn` parameter list or `let` binding vector in `form`\n   binds.\"\n  [form]\n  (cond\n\n\n(def ^:private module-free-names\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `php` over\n   the host registry `registry`, requiring the pinned `yang.call` revision\n   at `call-address`; a free name nothing supplies is refused before\n   anything is published. This namespace emits; it never publishes.\"\n  [registry call-address]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {call/module-name call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the php module reads an undeclared name\",\n                     :refusal-ns \"yang.php\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: the exact float\n   expansion `m * 5^k` needs about 2200 bits.\"\n  4096)\n\n\n(def min-integer-digits\n  \"The smallest `::integer/max-digits` this profile admits: the exact float\n   expansion has up to about 770 digits.\"\n  1000)\n\n\n(defn register-integer-module\n(ns yang.core.module\n  \"Module emitter machinery shared by every language frontend\n   (docs/design/yang.typescript.md §17, lift L3): the linker module naming\n   rule, the `require` and wide-application tree nodes, free-name\n   declaration over a host registry, and the `module-spec` and SCC bundle\n   shapes `yin.vm.linker.publish/publish-module!` takes. A language supplies\n   its prefix, its runtime module and its module AST; nothing here knows a\n   source language.\"\n  (:require\n    [clojure.string :as str]\n    [yang.core.prelude :as prelude]\n    [yang.core.uast :as u]\n    [yin.vm :as vm]\n    [yin.vm.module :as module]))\n\n\n(defn module-symbol\n  \"The linker module name of source module `name` under language `prefix`\n   (\\\"py\\\", \\\"php\\\", \\\"js\\\"): `<prefix>m.` then the name with each dot a `$`,\n   so no linker module name is a dotted prefix of another.\"\n  [prefix name]\n  (symbol (str prefix \"m.\" (str/replace name \".\" \"$\"))))\n\n\n(defn require-node\n  \"(require 'm) as a tree node.\"\n  [m]\n  (u/sexp->uast (list 'require (list 'quote m))))\n\n\n(defn module-tree\n  \"A wide application: all definitions remain at module level.\"\n  [operands]\n  (prelude/wide-app operands))\n\n\n(defn declare-free-name\n  \"The `:primitives` entry free name `n` declares over `registry`, or nil\n   when `covered` (the requirement-pinned module names) covers it. A name\n   no `vm/primitives` profile or host export supplies throws, with\n   `refusal` under `refusal-key` in its data.\"\n  [refusal-key refusal registry covered n]\n  (if (and (symbol? n) (some? (namespace n))\n           (contains? covered (symbol (namespace n))))\n    nil\n    (if-let [profile (vm/profile-of vm/primitives n)]\n      [n profile]\n      (if-let [address (module/host-export-profile registry n)]\n        (let [entry (module/module-entry (:modules registry)\n                                         (symbol (namespace n)))\n              f (get-in entry [:slice (symbol (name n))])]\n          [n {:yin.k/profile address,\n              :yin.k/effects\n              (get (:callable-effects registry) f #{})}])\n        (throw (ex-info \"the module reads an undeclared name\"\n                        {refusal-key refusal, :name n}))))))\n\n\n(defn free-primitives\n  \"The `:primitives` map declaring every free name of `ast` over `registry`.\"\n  [refusal-key refusal registry covered ast]\n  (let [free (remove (conj (prelude/defined-keys ast) 'yin/def)\n                     (prelude/free-names ast))]\n    (into {}\n          (keep (partial declare-free-name refusal-key refusal registry covered))\n          (sort-by str free))))\n\n\n(defn module-spec\n  \"`publish-module!`'s spec for module `name`: `ast` with `exports`, requiring\n   the runtime module `runtime-name` at `runtime-address` and each of `deps`\n   ({module-symbol address}). A free name under a required module is covered\n   by it; any other is declared as `declare-free-name` does.\"\n  [refusal-key refusal registry\n   {:keys [name ast exports runtime-name runtime-address deps]}]\n  (let [requires (into {runtime-name runtime-address} deps)]\n    {:name name,\n     :ast ast,\n     :exports exports,\n     :requires requires,\n     :primitives (free-primitives refusal-key refusal registry\n                                  (set (keys requires)) ast)}))\n\n\n(defn alias-spec\n  \"A thin member alias of the SCC bundle `bundle-name`: it requires the\n   bundle and defines `spec` and `body` as the bundle's `spec-key` and\n   `body-key` exports.\"\n  [name exports require-profile bundle-name spec-key body-key]\n  {:name name,\n   :exports exports,\n   :primitives {'require require-profile},\n   :ast (module-tree\n          [(require-node bundle-name)\n           (u/def! 'spec (u/v (symbol (str bundle-name) (str spec-key))))\n           (u/def! 'body (u/v (symbol (str bundle-name) (str body-key))))])})\n\n\n(defn scc-module-specs\n  \"The SCC publication shape: the `bundle` spec first, then the member alias\n   specs (each `alias-spec`'s output) in member order.\"\n  [bundle aliases]\n  (into [bundle] aliases))\n(ns yang.php.antlr.siteset-test\n  (:require\n    [clojure.test :refer [deftest is]]\n    [dao.jing :as jing]\n    [dao.jing.mem :as mem]\n    [yang.core.publication :as publication]\n    [yang.core.uast :as u]\n    [yang.php.antlr.siteset :as siteset]\n    [yin.vm.linker.sign :as sign]\n    [yin.vm :as vm]))\n\n\n(deftest publication-binds-occurrences-to-root\n  (let [mark [:line 42 {:unit \"lib.php\", :ticks 2}]\n        ast (vary-meta (u/lit 1) assoc :yang/site mark)\n        store (mem/create-content-mem)\n        pub (siteset/publish! store :manifest ast)\n        empty-pub (siteset/publish! store :other (u/lit 1))]\n    (is (= [[[] mark]] (:set pub)))\n    (is (= [] (:set empty-pub)))\n    (is (= (:yang.site/root (:record pub)) (:yang.site/root (:record empty-pub))))\n    (is (= :manifest (:yang.site/manifest (:record pub))))))\n\n\n(deftest verification-requires-the-bound-module-and-set\n  (let [store (mem/create-content-mem)\n        ast (u/lit 1)\n        root (:root (siteset/site-set-of ast))\n        manifest (jing/materialize! store {:yin.module/tree root})\n        other (jing/materialize! store {:yin.module/tree :wrong})\n        pub (siteset/publish! store manifest ast)]\n    (is (= [] (:set (siteset/verify store manifest (:record-address pub)))))\n    (is (nil? (siteset/verify store other (:record-address pub))))\n    (is (nil? (siteset/verify store manifest :missing)))))\n\n\n(deftest cyclic-aliases-publish-empty-sets\n  (let [store (mem/create-content-mem)\n        ast (u/lit 1)\n        bundle {:name 'bundle, :ast ast}\n        cfg {:imported-names :imports,\n             :module-spec (fn [& _] (throw (ex-info \"expected cycle\" {}))),\n             :scc-module-specs (fn [& _]\n                                 [bundle {:name 'a, :ast ast}\n                                  {:name 'b, :ast ast}]),\n             :site-set siteset/publish!, :alias-site-set true,\n             :refusal-ns \"test\",\n             :publish-fn (fn [h spec]\n                           {:status :ok, :address (jing/materialize!\n                                                    h {:yin.module/tree (:root (siteset/site-set-of (:ast spec))),\n                                                       :name (:name spec)})})}\n        result (publication/publish-units! cfg store {} nil\n                                           [{:name \"a\", :imports [\"b\"]}\n                                            {:name \"b\", :imports [\"a\"]}] {})]\n    (is (= :ok (:status result)))\n    (is (= #{'bundle \"a\" \"b\"} (set (keys (:sites result)))))\n    (doseq [[name address] (:addresses result)]\n      (is (= [] (:set (siteset/verify store address\n                                      (get-in result [:sites name :record-address]))))))))\n\n\n(deftest signed-discovery-requires-an-authorized-untampered-entry\n  (let [key (sign/generate)\n        other (sign/generate)\n        entry (siteset/signed-entry key :manifest :record)\n        datoms (siteset/entry-datoms [entry])\n        tampered (siteset/entry-datoms [(assoc-in entry [:envelope :yang.site/record] :other)])]\n    (is (= [:record] (siteset/discover datoms [(:public key)] :manifest)))\n    (is (empty? (siteset/discover datoms [(:public other)] :manifest)))\n    (is (empty? (siteset/discover datoms [(:public key)] :other)))\n    (is (empty? (siteset/discover tampered [(:public key)] :manifest)))))\n\n\n(deftest derivation-requires-the-verified-publication\n  (let [store (mem/create-content-mem)\n        ast (vary-meta (u/lit 1) assoc :yang/site [:line 1 {:ticks 1}])\n        env (siteset/site-set-of ast)\n        tree (vm/ast->semantic-bytecode ast)\n        manifest (jing/materialize! store {:yin.module/tree (:root env)})\n        pub (siteset/publish! store manifest ast)\n        profile {:line {:hook 'php.sp/line, :operands true, :after true}}\n        derived (siteset/derive-verified store manifest (:record-address pub) tree profile)]\n    (is (some? derived))\n    (is (= (:root tree) (get-in derived [:record :yin.ledger/input])))\n    (is (= (:root (:tree derived)) (get-in derived [:record :yin.ledger/output])))\n    (is (= (:set-address pub) (:site-set-address derived)))\n    (is (nil? (siteset/derive-verified store manifest :missing tree profile)))\n    (is (nil? (siteset/derive-verified store manifest (:record-address pub)\n                                       (assoc tree :root :wrong) profile)))))\n","exit_code":0,"status":"completed"}}
