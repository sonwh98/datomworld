.\\\"\\n  2882\\t  [ctx n]\\n  2883\\t  (when-not (:fn ctx) (unsupported! n :static))\\n  2884\\t  (sequence-node\\n  2885\\t    (mapv (fn [vi]\\n  2886\\t            (let [vks (core/kids ctx vi)\\n  2887\\t                  init (if (> (count vks) 1) (lower ctx (nth vks 2)) (u/lit :php/null))]\\n  2888\\t              (app* 'php/static-bind!\\n  2889\\t                    (u/v '%fn)\\n  2890\\t                    (u/lit (bare (:text (first vks))))\\n  2891\\t                    (u/v (symbol (:text (first vks))))\\n  2892\\t                    (u/lam [] init))))\\n  2893\\t          (core/rules ctx n \\\"staticInitializer\\\"))))\\n  2894\\t\\n  2895\\t\\n  2896\\t(defn- lower-global\\n  2917\\t(defn- coerce-return-node\\n  2918\\t  \\\"A returned value held to the declared type `rtype`; `static` resolves to the\\n  2919\\t   class the method was called on.\\\"\\n  2920\\t  [ctx v rtype fname]\\n  2921\\t  (let [atoms (if (= :union (:t rtype)) (:of rtype) [rtype])]\\n  2922\\t    (if (some #(= :static (:t %)) atoms)\\n  2923\\t      (app* 'php/coerce-return-s v (u/lit rtype) (u/lit fname)\\n  2924\\t            (if (:fn ctx) (app* 'php/static-or-nil (u/v '%fn)) (u/lit nil)))\\n  2925\\t      (app* 'php/coerce-return v (u/lit rtype) (u/lit fname)))))\\n  2926\\t\\n  2927\\t\\n  2928\\t(defn- lower-return\\n  2929\\t  [ctx n]\\n  2930\\t  (when-not (:ret ctx) (unsupported! n :return))\\n  2931\\t  (let [e (or (first (core/rules ctx n \\\"expression\\\"))\\n  2932\\t              (first (core/rules ctx n \\\"yieldExpression\\\")))\\n  2933\\t        rtype (:rtype ctx)\\n  2934\\t        void? (= :void (:t rtype))]\\n  2935\\t    (when (= :never (:t rtype)) (compile-error! n \\\"A never-returning function must not return\\\"))\\n  2936\\t    (when (and void? e) (compile-error! n \\\"A void function must not return a value\\\"))\\n  2937\\t    (when (and rtype (not void?) (nil? e))\\n  2938\\t      (compile-error! n \\\"A function with return type must return a value\\\"))\\n  2939\\t    (u/app (u/v (:ret ctx))\\n  2940\\t           (if e\\n  2941\\t             (let [v (app* 'php/addref (lower ctx e))]\\n  2942\\t               (if rtype (coerce-return-node ctx v rtype (:fname ctx)) v))\\n  2943\\t             (u/lit :php/null)))))\\n  2944\\t\\n  2945\\t\\n  2946\\t(defn- mentions-reference?\\n  2207\\t|                     | effect                              |                  |\\n  2208\\t+---------------------+-------------------------------------+------------------+\\n  2209\\t| C5 string offset    | Engine: `$s[i] = 'x'`, padding past | restricted; P9   |\\n  2210\\t| writes              | the end, negative offsets, the      | (strings II)     |\\n  2211\\t|                     | `$s[] =` `Error`, multi-byte        |                  |\\n  2212\\t|                     | warnings. Here: row 3 specifies     |                  |\\n  2213\\t|                     | only reads and single-byte in-range |                  |\\n  2214\\t|                     | writes                              |                  |\\n  2215\\t+---------------------+-------------------------------------+------------------+\\n  2216\\t| C6 internal         | Engine: `sort`, `array_push`,       | restricted; P2   |\\n  2217\\t| by-reference        | `preg_match`'s `&$m`, prefer-ref    | (core), P9       |\\n  2218\\t| parameters          | `array_multisort`, the \\\"Only        | (prefer-ref)     |\\n  2219\\t|                     | variables should be passed by       |                  |\\n  2220\\t|                     | reference\\\" notice. Here: each       |                  |\\n  2221\\t|                     | supported builtin declares its      |                  |\\n  2222\\t|                     | by-reference positions; the notice  |                  |\\n  2223\\t|                     | is emitted; prefer-ref builtins are |                  |\\n  2224\\t|                     | refused                             |                  |\\n  2225