CST packet -> lowering stage ->\\n     3\\t   program envelope -> the bundled program on each of the four VMs. Output\\n     4\\t   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\n     5\\t   here at the boundary.\\\"\\n     6\\t  (:require\\n     7\\t    [clojure.walk :as walk]\\n     8\\t    [dao.host.text :as text]\\n     9\\t    [dao.stream :as stream]\\n    10\\t    [yang.php.antlr.cst :as cst]\\n    11\\t    [yang.php.antlr.lower :as lower]\\n    12\\t    [yang.php.antlr.portable-harness :as portable]\\n    13\\t    [yang.php.antlr.safepoint :as hooks]\\n    14\\t    [yang.core.uast :as u]\\n    15\\t    [yang.safepoint :as safepoint]\\n    16\\t    [yin.vm :as vm]\\n    17\\t    [yin.vm.debruijn.register :as rvm]\\n    18\\t    [yin.vm.debruijn.stack :as dvm]\\n    19\\t    [yin.vm.encoder :as encoder]\\n    20\\t    [yin.vm.semantic :as semantic]\\n    21\\t    [yin.vm.semantic.derive :as derive]\\n    22\\t    [yin.vm.semantic.linearize :as sr-linearize]\\n    23\\t    [yin.vm.test-utils :as tu]))\\n    24\\t\\n    25\\t\\n    26\\t(defn host-registry\\n    27\\t  \\\"The registry the PHP compositions run over.\\\"\\n    28\\t  []\\n    29\\t  (portable/host-registry))\\n    30\\t\\n    31\\t\\n    32\\t(def ^:private base-opts\\n    33\\t  {:make-stream tu/make-stream,\\n    34\\t   :capability-secret tu/secret,\\n    35\\t   :primitives vm/primitives})\\n    36\\t\\n    37\\t\\n    38\\t(def ^:private load-semantic\\n    39\\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\n    40\\t\\n    41\\t\\n    42\\t(defn lower-program\\n    43\\t  \\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\n    44\\t   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\\"\\n    45\\t  [source]\\n    46\\t  (let [cst-log (tu/new-memory-log)\\n    47\\t        program (tu/new-memory-log)\\n    48\\t        diagnostics (tu/new-memory-log)]\\n    49\\t    (stream/append! cst-log (cst/parse-source source))\\n    50\\t    (lower/step-stage (lower/open-stage cst-log program diagnostics\\n    51\\t                                        {:medium lower/program-medium}))\\n    52\\t    (let [{warnings true, problems false}\\n    53\\t          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\n    54\\t      (if (seq problems)\\n    55\\t        {:diagnostics problems}\\n    56\\t        (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\n    57\\t          {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)})))))\\n    58\\t\\n    59\\t\\n    60\\t(defn packet->form\\n    61\\t  \\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\n    62\\t   rule, `[\\\\\\\"TYPE\\\\\\\" \\\\\\\"text\\\\\\\"]` for a token. The inverse of\\n    63\\t   `portable-harness/packet`.\\\"\\n    64\\t  [{:yang.cst/keys [root nodes]}]\\n    65\\t  (letfn [(form\\n    66\\t            [id]\\n    67\\t            (let [{:keys [kind rule type text children]} (nth nodes id)]\\n    68\\t              (if (= :token kind)\\n    69\\t                [type text]\\n    70\\t                (into [(keyword rule)] (map form) children))))]\\n    71\\t    (form root)))\\n    72\\t\\n    73\\t\\n    74\\t(defn latin1->text\\n    75\\t  \\\"The UTF-8 text of the byte carrier `s`.\\\"\\n    76\\t  [s]\\n    77\\t  (text/utf8-decode (.getBytes ^String s \\\"ISO-8859-1\\\")))\\n    78\\t\\n    79\\t\\n    80\\t(defn render\\n    81\\t  \\\"The text a unit prints: its output, then, for an uncaught error, the\\n    82\\t   fatal line (no path, plan section 3.9).\\\"\\n    83\\t  [{:php/keys [out uncaught fatal]}]\\n    84\\t  (str (latin1->text out)\\n    85\\t       (when uncaught\\n    86\\t         (str \\\"PHP Fatal error:  Uncaught \\\" (:class uncaught) \\\": \\\" (:message uncaught)))\\n    87\\t       (when fatal\\n    88\\t         (str \\\"PHP Fatal error:  \\\" fatal))))\\n    89\\t\\n    90\\t\\n    91\\t(defn run-vms\\n    92\\t  \\\"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\\n    93\\t   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\\n    94\\t   and starts one per-run counter; no option leaves the AST unchanged.\\\"\\n    95\\t  ([registry ast] (run-vms registry ast {}))\\n    96\\t  ([registry ast {:keys [execution-budget envelope]}]\\n    97\\t   (let [ast (if (some? execution-budget)\\n    98\\t               (let [projected (encoder/project envelope)\\n    99\\t                     derived (:envelope (safepoint/derive-envelope\\n   100\\t                                          projected hooks/profile :test/derived))\\n   101\\t                     tree (nth (:yin/batch derived) (:yin/root derived))]\\n   102\\t                 (hooks/program execution-budget\\n   103\\t                                (vm/semantic-bytecode->ast tree)))\\n   104\\t               ast)\\n   105\\t         opts (assoc base-opts :modules registry)\\n   106\\t         session (tu/make-observer-session (tu/create-vm {:modules registry}))\\n   107\\t         datoms (vec (vm/ast->datoms ast))\\n   108\\t         projected #(:vector (sr-linearize/project ast))\\n   109\\t         attempt (fn [f]\\n   110\\t                   (try (render (f))\\n   111\\t                        (catch Exception e [:thrown (ex-message e)])))]\\n   112\\t     (tu/queue-ast! session ast)\\n   113\\t     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\\n   114\\t      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\\n   115\\t                                                           datoms)))),\\n   116\\t      :stack (attempt #(vm/value (vm/run (dvm/create-vm\\n   117\\t                                           (:image (derive/stack-image (projected)))\\n   118\\t                                           (assoc opts :contract vm/stack-contract))))),\\n   119\\t      :register (attempt #(vm/value (vm/run (rvm/create-vm\\n   120\\t                                              (derive/register-image (projected))\\n   121\\t                                              (assoc opts\\n   122\\t                                                     :contract\\n   123\\t                                                     vm/register-contract)))))})))\\n   124\\t\\n   125\\t\\n   126\\t(defn run-php\\n   127\\t  \\\"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\\n   128\\t   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\\\"\\n   129\\t  ([source] (run-php source {}))\\n   130\\t  ([source options]\\n   131\\t   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\\n   132\\t     (if diagnostics\\n   133\\t       {:diagnostics diagnostics}\\n   134\\t       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\\n   135\\t\\n   136\\t\\n   137\\t(defn run-walker\\n   138\\t  \\\"The ast-walker's rendering of `source` alone (fast iteration).\\\"\\n   139\\t  [source]\\n   140\\t  (let [{:keys [ast diagnostics]} (lower-program source)]\\n   141\\t    (if diagnostics\\n   142\\t      {:diagnostics diagnostics}\\n   143\\t      (let [registry (host-registry)\\n   144\\t            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\\n   145\\t        (tu/queue-ast! session ast)\\n   146\\t        (try (render (vm/value (:consumer (tu/run-session session))))\\n   147\\t             (catch Exception e [:thrown (ex-message e)]))))))\\n   148\\t\\n   149\\t\\n   150\\t(defn run-raw\\n   151\\t  \\\"The unit's value on the AST walker, optionally after binding a request record.\\\"\\n   152\\t  ([source] (run-raw source nil))\\n   153\\t  ([source request]\\n   154\\t   (let [{:keys [ast diagnostics]} (lower-program source)]\\n   155\\t     (if diagnostics\\n   156\\t       {:diagnostics diagnostics}\\n   157\\t       (let [session (tu/make-observer-session\\n   158\\t                       (tu/create-vm {:modules (host-registry)}))\\n   159\\t             ast (if request\\n   160\\t                   (walk/postwalk\\n   161\\t                     (fn [node]\\n   162\\t                       (if (and (map? node)\\n   163\\t                                (= :application (:type node))\\n   164\\t                                (= 'php/run-main (get-in node [:operator :name])))\\n   165\\t                         (let [body (first (:operands node))]\\n   166\\t                           (assoc node :operands\\n   167\\t                                  [(u/lam []\\n   168\\t                                          (u/then\\n   169\\t                                            (u/sexp->uast (list 'php/bind-request! request))\\n   170\\t                                            (u/app body)))]))\\n   171\\t                         node))\\n   172\\t                     ast)\\n   173\\t                   ast)]\\n   174\\t         (tu/queue-ast! session ast)\\n   175\\t         (vm/value (:consumer (tu/run-session session))))))))\\n     1\\t(ns yang.php.antlr.programs-p9\\n     2\\t  \\\"P9 builtin surfaces, dynamic scopes, and engine-fidelity corner fixtures.\\n     3\\t   Outputs are hand-derived from PHP 8.3; all remain available to the oracle.\\\")\\n     4\\t\\n     5\\t\\n     6\\t(defn- fx\\n     7\\t  [id group source out & {:as more}]\\n     8\\t  (merge {:id id, :group group, :source source, :out out, :oracle :pending}\\n     9\\t         more))\\n    10\\t\\n    11\\t\\n    12\\t(def strings-ii\\n    13\\t  [(fx :substring-and-search :strings-ii\\n    14\\t       \\\"<?php echo substr('abcdef', 1, 3), strpos('abca', 'c'), strrpos('abca', 'a'), stripos('AbC', 'b');\\\"\\n    15\\t       \\\"bcd231\\\")\\n    16\\t   (fx :replace-and-contains :strings-ii\\n    17\\t       \\\"<?php echo str_replace('a', 'x', 'abca'), str_contains('abc', 'b'), str_starts_with('abc', 'a'), str_ends_with('abc', 'c');\\\"\\n    18\\t       \\\"xbcx111\\\")\\n    19\\t   (fx :trim-case-repeat :strings-ii\\n    20\\t       \\\"<?php echo trim(\\\\\\\" \\\\\\\\tA\\\\\\\\n\\\\\\\"), strtolower('AbC'), strtoupper('aBc'), str_repeat('x', 3), strrev('abc');\\\"\\n    21\\t       \\\"AabcABCxxxcba\\\")\\n    22\\t   (fx :pad-compare-and-count :strings-ii\\n    23\\t       \\\"<?php echo str_pad('x', 3, '-'), strcmp('a', 'b'), strncmp('abcd', 'abzz', 2), substr_count('aaaa', 'aa');\\\"\\n    24\\t       \\\"x---102\\\")\\n    25\\t   (fx :html-slashes-and-bytes :strings-ii\\n    26\\t       \\\"<?php echo bin2hex('Az'), hex2bin('417a'), ord('A'), chr(66), addslashes(\\\\\\\"a'b\\\\\\\"), stripslashes(\\\\\\\"a\\\\\\\\\\\\\\\\'b\\\\\\\");\\\"\\n    27\\t       \\\"417aAz65Ba\\\\\\\\'ba'b\\\")\\n    28\\t   (fx :string-offset-write :strings-ii\\n    29\\t       \\\"<?php $s = 'abc'; $s[1] = 'XYZ'; $s[-1] = 'Z'; echo $s;\\\"\\n    30\\t       \\\"aXZ\\\")])\\n    31\\t\\n    32\\t\\n    33\\t(def arrays-ii\\n    34\\t  [(fx :explode-split-reverse :arrays-ii\\n    35\\t       \\\"<?php echo implode('|', explode(',', 'a,b')), implode('', array_reverse(str_split('abc'))), array_product([2, 3, 4]);\\\"\\n    36\\t       \\\"a|bcba24\\\")\\n    37\\t   (fx :search-fill-combine :arrays-ii\\n    38\\t       \\\"<?php echo array_search(2, [1, 2], true), implode(',', array_fill(0, 2, 'x')), implode(',', array_combine(['a', 'b'], [1, 2]));\\\"\\n    39\\t       \\\"1x,x1,2\\\")\\n    40\\t   (fx :flip-pad-chunk :arrays-ii\\n    41\\t       \\\"<?php $f = array_flip(['a' => 3]); echo $f[3], implode(',', array_pad([1], 3, 0)), count(array_chunk([1, 2, 3], 2));\\\"\\n    42\\t       \\\"a1,0,02\\\")\\n    43\\t   (fx :slice-splice :arrays-ii\\n    44\\t       \\\"<?php $a = [1, 2, 3, 4]; $r = array_splice($a, 1, 2, [8, 9]); echo implode(',', $a), '|', implode(',', $r), '|', implode(',', array_slice($a, 1));\\\"\\n    45\\t       \\\"1,8,9,4|2,3|8,9,4\\\")\\n    46\\t   (fx :map-filter-reduce :arrays-ii\\n    47\\t       \\\"<?php $a = array_map(fn($x) => $x * $x, [1, 2, 3]); $a = array_filter($a, fn($x) => $x > 1); echo implode(',', $a), array_reduce($a, fn($x, $y) => $x + $y, 0);\\\"\\n    48\\t       \\\"4,913\\\")\\n    49\\t   (fx :unique-diff-intersect :arrays-ii\\n    50\\t       \\\"<?php echo implode(',', array_unique([1, 1, 2])), '|', implode(',', array_diff([1, 2, 3], [2])), '|', implode(',', array_intersect([1, 2, 3], [2, 3]));\\\"\\n    51\\t       \\\"1,2|1,3|2,3\\\")\\n    52\\t   (fx :range-and-list :arrays-ii\\n    53\\t       \\\"<?php echo implode(',', range(3, 1)), implode(',', range('a', 'c')), array_is_list([1, 2]), array_is_list([1 => 1]);\\\"\\n    54\\t       \\\"3,2,1a,b,c1\\\")])\\n    55\\t\\n    56\\t\\n    57\\t(def json\\n    58\\t  [(fx :encode-scalars-and-arrays :json\\n    59\\t       \\\"<?php echo json_encode(['a', true, null, 2]), json_encode(['a' => 4]);\\\"\\n    60\\t       \\\"[\\\\\\\"a\\\\\\\",true,null,2]{\\\\\\\"a\\\\\\\":4}\\\")\\n    61\\t   (fx :encode-escapes-and-pretty :json\\n    62\\t       \\\"<?php echo json_encode(\\\\\\\"a\\\\\\\\nb\\\\\\\\\\\\\\\"c\\\\\\\"), json_encode([1], JSON_PRETTY_PRINT);\\\"\\n    63\\t       \\\"\\\\\\\"a\\\\\\\\nb\\\\\\\\\\\\\\\"c\\\\\\\"[\\\\n    1\\\\n]\\\")\\n    64\\t   (fx :decode-scalars-and-array :json\\n    65\\t       \\\"<?php echo json_decode('1'), json_decode('\\\\\\\"x\\\\\\\"'), implode(',', json_decode('[1,2,3]', true));\\\"\\n    66\\t       \\\"1x1,2,3\\\")\\n    67\\t   (fx :decode-object-and-escape :json\\n    68\\t       \\\"<?php $a = json_decode('{\\\\\\\"a\\\\\\\":4,\\\\\\\"s\\\\\\\":\\\\\\\"x\\\\\\\\ny\\\\\\\"}', true); echo $a['a'], json_encode($a['s']);\\\"\\n    69\\t       \\\"4\\\\\\\"x\\\\\\\\ny\\\\\\\"\\\")])\\n    70\\t\\n    71\\t\\n    72\\t(def math-ii\\n    73\\t  [(fx :rounding-and-absolute :math-ii\\n    74\\t       \\\"<?php echo abs(-3), ceil(1.2), floor(1.8), round(1.5), round(-1.5);\\\"\\n    75\\t       \\\"3212-2\\\")\\n    76\\t   (fx :sqrt-pow-minmax :math-ii\\n    77\\t       \\\"<?php echo sqrt(9), pow(2, 3), min(3, 1, 2), max(3, 1, 2), is_finite(1.0), is_infinite(INF);\\\"\\n    78\\t       \\\"381311\\\")])\\n    79\\t\\n    80\\t\\n    81\\t(def dynamic-scope\\n    82\\t  [(fx :variable-variable-global :dynamic-scope\\n    83\\t       \\\"<?php $n = 'x'; $$n = 22; echo $x, $$n;\\\"\\n    84\\t       \\\"2222\\\")\\n    85\\t   (fx :variable-variable-function :dynamic-scope\\n    86\\t       \\\"<?php function f($n) { $$n = 3; return $x; } echo f('x');\\\"\\n    87\\t       \\\"3\\\")\\n    88\\t   (fx :extract-overwrite :dynamic-scope\\n    89\\t       \\\"<?php $x = 1; $n = extract(['x' => 4, 'y' => 5]); echo $n, $x, $y;\\\"\\n    90\\t       \\\"245\\\")\\n    91\\t   (fx :extract-skip-and-prefix :dynamic-scope\\n    92\\t       \\\"<?php $x = 1; extract(['x' => 4, 'y' => 5], EXTR_SKIP); extract(['z' => 6], EXTR_PREFIX_ALL, 'p_'); echo $x, $y, $p_z;\\\"\\n    93\\t       \\\"156\\\")\\n    94\\t   (fx :compact-nested :dynamic-scope\\n    95\\t       \\\"<?php $x = 3; $y = 4; $a = compact('x', ['y', 'missing']); echo implode(',', $a);\\\"\\n    96\\t       \\\"3,4\\\")\\n    97\\t   (fx :globals-element-write :dynamic-scope\\n    98\\t       \\\"<?php $GLOBALS['x'] = 7; echo $x, $GLOBALS['x'];\\\"\\n    99\\t       \\\"77\\\")])\\n   100\\t\\n     1\\t(ns yang.php.antlr.safepoint-test\\n     2\\t  (:require\\n     3\\t    [clojure.test :refer [deftest is testing]]\\n     4\\t    [yang.php.antlr.e2e-harness :as h]\\n     5\\t    [yang.php.antlr.safepoint :as hooks]))\\n     6\\t\\n     7\\t\\n     8\\t(def ^:private vms [:ast-walker :semantic :stack :register])\\n     9\\t\\n    10\\t\\n    11\\t(defn- every-vm=\\n    12\\t  [expected results]\\n    13\\t  (doseq [k vms]\\n    14\\t    (is (= expected (get results k)) (name k))))\\n    15\\t\\n    16\\t\\n    17\\t(deftest exhaustion-is-an-operational-fatal-test\\n    18\\t  (let [source (str \\\"<?php class C { function __destruct() { echo 'D'; } } \\\"\\n    19\\t                    \\\"$c = new C; try {