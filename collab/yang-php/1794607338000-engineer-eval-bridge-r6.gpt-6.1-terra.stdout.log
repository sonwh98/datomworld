he including frame's `%fn`, `%ctx` or null.\\\"\\n  1273\\t  [ctx n kind operand]\\n  1274\\t  (when-not (:linked? ctx) (unsupported! n :include))\\n  1275\\t  (let [scope (if (or (:fn ctx) (:module? ctx)) (u/v '%scope) (u/lit :php/globals))\\n  1276\\t        frame (cond (:fn ctx) (u/v '%fn) (:module? ctx) (u/v '%ctx) :else (u/lit :php/null))]\\n  1277\\t    (if-let [folded (fold-path ctx operand)]\\n  1278\\t      (let [{:keys [path error]} (normalize-unit-path folded)]\\n  1279\\t        (when error (unsupported! n error))\\n  1280\\t        (app* 'php/include-run (u/lit path) (delivery-thunk path) (u/lit kind) scope frame))\\n  1281\\t      (do (warn! ctx n :yang.php/computed-include-path\\n  1282\\t                 \\\"include path is computed; it resolves through the published path map at run time\\\" {})\\n  1283\\t          (app* 'php/include-computed (lower ctx operand) (u/lit kind) scope frame)))))\\n  1284\\t\\n  1285\\t\\n  1286\\t(defn- lower-prefix\\n  1287\\t  [ctx n [op operand :as ks]]\\n  1288\\t  (let [t (:type op)]\\n  1289\\t    (case t\\n  1290\\t      \\\"Minus\\\" (app* 'php/neg (lower ctx operand))\\n  1291\\t      \\\"Plus\\\" (app* 'php/plus (lower ctx operand))\\n  1292\\t      \\\"Bang\\\" (app* 'not (truthy (lower ctx operand)))\\n  1293\\t      \\\"Tilde\\\" (app* 'php/bit-not (lower ctx operand))\\n  1294\\t      \\\"SuppressWarnings\\\" (lower-silence ctx operand)\\n  1295\\t      (\\\"Inc\\\" \\\"Dec\\\") (lower-incdec ctx n operand t true)\\n  1296\\t      \\\"IsSet\\\" (lower-isset ctx n (core/rules ctx (nth ks 2) \\\"chain\\\"))\\n  1297\\t      \\\"Empty\\\" (lower-empty ctx n (nth ks 2))\\n  1298\\t      \\\"Print\\\" (u/then (app* 'php/echo (app* 'php/to-string (lower ctx operand)))\\n  1299\\t                      (u/lit 1))\\n  1300\\t      \\\"Exit\\\" (app* 'php/exit (if operand (lower ctx operand) (u/lit 0)))\\n  1301\\t      \\\"OpenRoundBracket\\\" (lower-cast ctx n ks)\\n  1302\\t      \\\"Throw\\\" (app* 'php/throw-va