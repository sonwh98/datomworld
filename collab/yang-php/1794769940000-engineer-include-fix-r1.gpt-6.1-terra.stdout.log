       (fn [occ]\n          (let [at (:at occ)]\n            (if (nil? at)\n              :retained\n              (let [defs (get by-name (:name occ))]\n                (if-not (:in-body? occ)\n                  (let [dominating (filter (fn [d]\n                                             (precedes? (:at d) at))\n                                           (unconditional defs))]\n                    (cond\n                      (seq dominating) :discharged\n                      (and (seq defs)\n                           (every? (fn [d]\n                                     (and (some? (:at d))\n                                          (precedes? at (:at d))))\n                                   defs))\n                      :use-before-definition\n                      :else :retained))\n                  (cond\n                    (not usable-sites?) :retained\n                    (empty? sites)\n                    (if (seq (unconditional defs))\n                      :discharged\n                      :retained)\n                    :else\n                    (if (seq (filter (fn [d]\n                                       (every? (fn [s]\n                                                 (precedes? (:at d)\n                                                            (:at s)))\n                                               sites))\n                                     (unconditional defs)))\n                      :discharged\n                      :retained)))))))]\n    (reduce (fn [acc occ]\n              (case (verdict occ)\n                :discharged acc\n                :retained (update acc :obligations conj occ)\n                :use-before-definition\n                (reduced {:obligations []\n                          :defect (refused :use-before-definition\n                                           {:name (:name occ),\n                                            :at (:at occ)})})))\n            {:obligations []}\n            occurrences)))\n\n53:(d