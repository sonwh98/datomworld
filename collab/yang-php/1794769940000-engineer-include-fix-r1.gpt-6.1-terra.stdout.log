ix-r1'\\nbranch 'codex/include-fix-r1' set up to track 'origin/master'.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"agent_message\",\"text\":\"The requested branch is now based on the local `origin/master` reference at `fc7e9353`. The workspace contains many pre-existing untracked files, which I’ll leave untouched. I’m starting the scoped slow test with a 2,400-second limit.\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 -c 'import subprocess,sys; p=subprocess.run([\\\\\\\"clojure\\\\\\\",\\\\\\\"-M:test\\\\\\\",\\\\\\\"-n\\\\\\\",\\\\\\\"yang.php.antlr.include-test\\\\\\\",\\\\\\\"-i\\\\\\\",\\\\\\\":slow\\\\\\\",\\\\\\\"-v\\\\\\\",\\\\\\\"yang.php.antlr.include-test/p6-fixtures-linked-on-every-vm-test\\\\\\\"],timeout=2400); sys.exit(p.returncode)'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat test/yang/php/antlr/include_test.clj && sed -n '1,160p' test/yang/php/antlr/programs_p6.cljc\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat test/yang/php/antlr/include_test.clj && sed -n '1,160p' test/yang/php/antlr/programs_p6.cljc\\\"\",\"aggregated_output\":\"(ns yang.php.antlr.include-test\\n  \\\"P6 S1-S5: linked inclusion, dynamic scope, namespaces, constants and the\\n   autoload class map. Linked fixtures run on the three vector VMs (the AST\\n   walker cannot link `php` until L-b); path rules, publication order,\\n   constant folding, namespace block rules and the two missing stages have\\n   focused tests.\\\"\\n  (:require\\n    [clojure.test :refer [deftest is testing]]\\n    [yang.php.antlr.cst :as cst]\\n    [yang.php.antlr.e2e-harness :as h]\\n    [yang.php.antlr.linked-harness :as lh]\\n    [yang.php.antlr.lower :as lower]\\n    [yang.php.antlr.programs-p6 :as p6]\\n    [yang.php.antlr.publication :as publication]\\n    [yin.vm :as vm]))\\n\\n\\n(defn- parse-units\\n  [{:keys [units source], :or {units nil}}]\\n  (if units\\n    (update-vals units cst/parse-source)\\n    {\\\"main.php\\\" (cst/parse-source source)}))\\n\\n\\n(defn- observed\\n  \\\"`[out diag uncaught]` of the linked run `value`.\\\"\\n  [value]\\n  [(h/latin1->text (:php/out value))\\n   (mapv (juxt :errno :message) (:php/diag value))\\n   (some-> (:php/uncaught value) (select-keys [:class :message]))])\\n\\n\\n(defn- run\\n  [fixture]\\n  (lh/run-fixture (parse-units fixture) \\\"main.php\\\"\\n                  {:computed? (:computed fixture), :class-map (:class-map fixture)}))\\n\\n\\n(deftest ^:slow p6-fixtures-linked-on-every-vm-test\\n  (doseq [{:keys [id out diag uncaught warnings oracle] :as fixture} p6/enabled\\n          :when (contains? fixture :out)\\n          :let [r (try (run fixture)\\n                       (catch Throwable e\\n                         (println \\\"FIXTURE THREW\\\" id (ex-message e) (pr-str (ex-data e)))\\n                         {:values {}}))]]\\n    (testing (name id)\\n      (is (not= :banner oracle))\\n      (doseq [[k v] (:values r)]\\n        (is (= [out (vec diag) uncaught] (observed v)) (str (name id) \\\" on \\\" k)))\\n      (when warnings\\n        (is (= warnings (mapv :yang.php/diagnostic (:warnings r))) (name id))))))\\n\\n\\n(deftest unit-path-rules-test\\n  (testing \\\"normalization\\\"\\n    (is (= {:path \\\"x.php\\\"} (lower/normalize-unit-path \\\"./x.php\\\")))\\n    (is (= {:path \\\"a/b.php\\\"} (lower/normalize-unit-path \\\"a//./c/../b.php\\\")))\\n    (is (= {:error :include-path} (lower/normalize-unit-path \\\"../x.php\\\")))\\n    (is (= {:error :include-path} (lower/normalize-unit-path \\\"/etc/x.php\\\")))\\n    (is (= {:error :unit-path} (lower/normalize-unit-path \\\"a+b.php\\\")))\\n    (is (= {:error :unit-path} (lower/normalize-unit-path \\\"a$b.php\\\"))))\\n  (testing \\\"the module name is injective\\\"\\n    (is (= 'phpm.src$lib$util$$php (lower/path-module-symbol \\\"src/lib/util.php\\\")))\\n    (is (not= (lower/path-module-symbol \\\"a/b.php\\\") (lower/path-module-symbol \\\"a/b\\\")))\\n    (is (= 'phpm.a$$b$$php (lower/path-module-symbol \\\"a.b.php\\\")))))\\n\\n\\n(defn- edges\\n  [source path]\\n  (lower/imported-unit-names (cst/parse-source source) {:path path}))\\n\\n\\n(deftest folded-include-edges-test\\n  (is (= [\\\"lib/a.php\\\"] (edges \\\"<?php include __DIR__ . '/lib/a.php';\\\" \\\"main.php\\\")))\\n  (is (= [\\\"lib/b.php\\\"] (edges \\\"<?php require_once dirname(__FILE__) . '/b.php';\\\" \\\"lib/a.php\\\")))\\n  (is (= [\\\"x.php\\\" \\\"y.php\\\"] (edges \\\"<?php include 'x.php'; if (1) { include_once \\\\\\\"y.php\\\\\\\"; }\\\" \\\"main.php\\\")))\\n  (is (= [] (edges \\\"<?php include $p; include 'a.php' . $q;\\\" \\\"main.php\\\")))\\n  (is (= [\\\"lib/b.php\\\"] (edges \\\"<?php include dirname(__DIR__) . '/lib/b.php';\\\" \\\"sub/a.php\\\"))))\\n\\n\\n(deftest imported-constant-resolves-before-global-refusal-test\\n  (let [fixture (some #(when (= :ns-use-function-const (:id %)) %) p6/enabled)\\n        result (run fixture)]\\n    (is (some? fixture))\\n    (doseq [[engine value] (:values result)]\\n      (is (= [\\\"gk\\\" [] nil] (observed value)) (str engine)))))\\n\\n\\n(deftest include-refusals-test\\n  (testing \\\"a bundled program cannot include\\\"\\n    (is (thrown-with-msg? clojure.lang.ExceptionInfo #\\\"(?i)include\\\"\\n          (lower/lower-program (cst/parse-source \\\"<?php include 'a.php';\\\")))))\\n  (testing \\\"an escaping or absolute literal path\\\"\\n    (doseq [src [\\\"<?php include '../x.php';\\\" \\\"<?php include '/etc/x.php';\\\"]]\\n      (is (= :include-path\\n             (try (lower/lower-program (cst/parse-source src) {:prelude :linked})\\n                  (catch clojure.lang.ExceptionInfo e (:construct (ex-data e)))))\\n          src)))\\n  (testing \\\"an include inside a function lowers (the dynamic-scope profile)\\\"\\n    (is (map? (lower/lower-program (cst/parse-source \\\"<?php function f() { include 'a.php'; }\\\")\\n                                   {:prelude :linked})))))\\n\\n\\n(deftest computed-path-warning-test\\n  (let [{:keys [warnings]} (lower/lower-program (cst/parse-source \\\"<?php include $p;\\\") {:prelude :linked})]\\n    (is (= [:yang.php/computed-include-path] (mapv :yang.php/diagnostic warnings)))\\n    (is (= [:warning] (mapv :severity warnings)))))\\n\\n\\n(deftest ^:slow linked-profile-matches-bundled-test\\n  (let [src \\\"<?php function f($n) { return $n < 2 ? $n : f($n - 1) + f($n - 2); } echo f(10); var_dump([1, 'a' => 2.5]);\\\"\\n        bundled (h/run-php src)\\n        linked (lh/run-fixture {\\\"main.php\\\" (cst/parse-source src)})]\\n    (doseq [[k v] (:values linked)]\\n      (is (= (:semantic bundled) (h/render v)) (str k)))))\\n\\n\\n(deftest publication-order-test\\n  (let [u (fn [name src] {:name name, :packet (cst/parse-source src)})\\n        units [(u \\\"main.php\\\" \\\"<?php include 'a.php'; include 'c.php';\\\")\\n               (u \\\"a.php\\\" \\\"<?php include 'b.php';\\\")\\n               (u \\\"b.php\\\" \\\"<?php echo 1;\\\")\\n               (u \\\"c.php\\\" \\\"<?php echo 2;\\\")]]\\n    (testing \\\"dependency first\\\"\\n      (let [order (:order (publication/publication-order units {}))]\\n        (is (< (.indexOf order \\\"b.php\\\") (.indexOf order \\\"a.php\\\") (.indexOf order \\\"main.php\\\")))))\\n    (testing \\\"a cyclic pair is one step\\\"\\n      (let [cyc [(u \\\"a.php\\\" \\\"<?php include 'b.php';\\\") (u \\\"b.php\\\" \\\"<?php include 'a.php';\\\")]]\\n        (is (= [[\\\"a.php\\\" \\\"b.php\\\"]] (:order (publication/publication-order cyc {}))))))\\n    (testing \\\"an unpublished edge is refused by name and nothing is written\\\"\\n      (let [bad [(u \\\"main.php\\\" \\\"<?php include 'missing.php';\\\")]\\n            r (publication/publication-order bad {})]\\n        (is (= :refused (:status r)))\\n        (is (= :yang.php/unpublished-import (:reason r)))\\n        (is (= \\\"missing.php\\\" (:module r)))\\n        (is (= \\\"main.php\\\" (:imported-by r)))))))\\n\\n\\n(defn- unserved-source\\n  \\\"A serving composition whose store lacks the module published for `path`:\\n   the name resolves, the content is absent.\\\"\\n  [result path]\\n  (let [env (dissoc (lh/name-env result) (lower/path-module-symbol path))]\\n    (lh/source (assoc env (lower/path-module-symbol path) \\\"no-such-address\\\"))))\\n\\n\\n(deftest ^:slow missing-stage-refusals-are-data-test\\n  (testing \\\"all four kinds against a pinned-but-unserved target\\\"\\n    (doseq [[kind src texts diag-n err?]\\n            [[\\\"include\\\" \\\"<?php var_dump(include 'a.php');\\\" \\\"bool(false)\\\\n\\\" 2 false]\\n             [\\\"include_once\\\" \\\"<?php var_dump(include_once 'a.php');\\\" \\\"bool(false)\\\\n\\\" 2 false]\\n             [\\\"require\\\" \\\"<?php try { require 'a.php'; } catch (Error $e) { echo get_class($e); }\\\" \\\"Error\\\" 1 true]\\n             [\\\"require_once\\\" \\\"<?php try { require_once 'a.php'; } catch (Error $e) { echo get_class($e); }\\\" \\\"Error\\\" 1 true]]]\\n      (let [units {\\\"main.php\\\" (cst/parse-source src), \\\"a.php\\\" (cst/parse-source \\\"<?php echo 'a';\\\")}\\n            result (lh/publish-units! [{:name \\\"a.php\\\", :packet (get units \\\"a.php\\\")}])\\n            {:keys [ast]} (lower/lower-program (get units \\\"main.php\\\") {:prelude :linked})\\n            src' (unserved-source result \\\"a.php\\\")]\\n        (doseq [k (keys lh/backends)\\n                :let [[out diag] (observed (vm/value (lh/run-linked k ast src')))]]\\n          (is (= texts out) (str kind \\\" \\\" k))\\n          (is (= diag-n (count diag)) (str kind \\\" \\\" k))\\n          (is (every? #(.startsWith ^String (second %) (str kind \\\"(\\\")) diag) (str kind \\\" \\\" k \\\" names the kind\\\"))\\n          (when err? (is (= 1 (count diag))))))))\\n  (testing \\\"a refusal is never marked: the retry warns again\\\"\\n    (let [units {\\\"main.php\\\" (cst/parse-source (str \\\"<?php try { require_once 'a.php'; } catch (Error $e) { echo 'E'; }\\\"\\n                                                   \\\" var_dump(include_once 'a.php');\\\")),\\n                 \\\"a.php\\\" (cst/parse-source \\\"<?php echo 'a';\\\")}\\n          result (lh/publish-units! [{:name \\\"a.php\\\", :packet (get units \\\"a.php\\\")}])\\n          {:keys [ast]} (lower/lower-program (get units \\\"main.php\\\") {:prelude :linked})\\n          [out diag] (observed (vm/value (lh/run-linked :semantic ast (unserved-source result \\\"a.php\\\"))))]\\n      (is (= \\\"Ebool(false)\\\\n\\\" out))\\n      (is (= 3 (count diag))))))\\n\\n\\n;; ---------------------------------------------------------------------------\\n;; P6 S3-S5: namespaces, constants, the autoload class map\\n;; ---------------------------------------------------------------------------\\n\\n(defn- lowered-text\\n  \\\"The lowered tree of `src` as a string, to assert what it contains.\\\"\\n  [src opts]\\n  (pr-str (:ast (lower/lower-program (cst/parse-source src) (assoc opts :prelude :linked)))))\\n\\n\\n(deftest builtin-constants-fold-only-where-php-folds-test\\n  (testing \\\"the global block and fully qualified reads fold to the literal\\\"\\n    (doseq [src [\\\"<?php echo PHP_EOL;\\\" \\\"<?php namespace A; echo \\\\\\\\PHP_EOL;\\\"]]\\n      (is (not (re-find #\\\"const-get\\\" (lowered-text src {}))) src)))\\n  (testing \\\"an unqualified read inside a namespace is the two-key lookup, no literal folded\\\"\\n    (let [t (lowered-text \\\"<?php namespace A; echo PHP_EOL;\\\" {})]\\n      (is (re-find #\\\"php/const-get\\\" t))\\n      (is (re-find #\\\"A\\\\W+PHP_EOL\\\" t))))\\n  (testing \\\"a name in the const import table is a fully qualified read\\\"\\n    (let [t (lowered-text \\\"<?php namespace A; use const B\\\\\\\\X; echo X;\\\" {})]\\n      (is (re-find #\\\"php/const-get-fq\\\" t))\\n      (is (re-find #\\\"B\\\\W+X\\\" t)))))\\n\\n\\n(deftest namespace-block-rules-test\\n  (doseq [[src msg]\\n          [[\\\"<?php namespace A; namespace B { }\\\" #\\\"Cannot mix bracketed\\\"]\\n           [\\\"<?php echo 1; namespace A;\\\" #\\\"very first statement\\\"]\\n           [\\\"<?php namespace A { } echo 1;\\\" #\\\"No code may exist outside\\\"]]]\\n    (is (thrown-with-msg? clojure.lang.ExceptionInfo msg\\n          (lower/lower-program (cst/parse-source src)))\\n        src))\\n  (testing \\\"declare before the namespace is allowed\\\"\\n    (is (map? (lower/lower-program (cst/parse-source \\\"<?php declare(strict_types=1); namespace A; echo 1;\\\"))))))\\n\\n\\n(deftest class-map-publication-test\\n  (let [u (fn [name src] {:name name, :packet (cst/parse-source src)})\\n        cm (fn [classes] (assoc classes :name lower/classmap-name))\\n        units [(u \\\"lib/Foo.php\\\" \\\"<?php class Foo {}\\\")\\n               (cm {:classes {\\\"Foo\\\" \\\"lib/Foo.php\\\"}})]]\\n    (testing \\\"the class map publishes after every path it lists\\\"\\n      (let [order (:order (publication/publication-order units {}))]\\n        (is (= lower/classmap-name (last order)))))\\n    (testing \\\"a listed path no unit supplies is refused by name\\\"\\n      (let [r (publication/publication-order [(cm {:classes {\\\"Bar\\\" \\\"lib/Bar.php\\\"}})] {})]\\n        (is (= :yang.php/unpublished-import (:reason r)))\\n        (is (= \\\"lib/Bar.php\\\" (:module r)))\\n        (is (= lower/classmap-name (:imported-by r)))))\\n    (testing \\\"an unmappable path is refused at emit\\\"\\n      (is (thrown? clojure.lang.ExceptionInfo\\n            (lower/classmap-paths {:classes {\\\"X\\\" \\\"../x.php\\\"}}))))))\\n\\n\\n(deftest default-autoloader-is-refused-test\\n  (let [r (h/run-walker \\\"<?php try { spl_autoload_register(null); } catch (Error $e) { echo $e->getMessage(); }\\\")]\\n    (is (re-find #\\\"G-default-autoload\\\" (pr-str r)))))\\n(ns yang.php.antlr.programs-p6\\n  \\\"Slice P6 Stage 0 (S0) fixture data: include/require over the linker\\n   (P6 plan v2, S0). Same schema as `yang.php.antlr.programs-p3b`, plus:\\n     :units     {path source} for a multi-unit fixture, every unit including\\n                the entry unit; absent for a one-file fixture\\n     :main      the entry unit's path, default \\\\\\\"main.php\\\\\\\"\\n     :computed  true when the entry unit's computed includes resolve through\\n                the composition's published path map (every non-entry unit)\\n     :warnings  the lowering warnings the entry unit must report\\n   Every fixture is `:oracle :pending` until the shiva recording pass, and\\n   `:requires` names the P6 steps (:p6-s2 .. :p6-s5, :p6-s2-r8 for the\\n   per-unit strict_types rule) that must land before an implementation\\n   runner may execute it. `:out` and `:diag` are pinned only where the\\n   language fixes them; otherwise they are absent and the recorded output is\\n   taken. A mismatch is escalated to the Architect and never fixed by\\n   editing the expectation.\\n\\n   Groups: :inclusion-v1, :missing-v1 (the oracle-pinned half; the\\n   pinned-but-unserved half is asserted in the linked tests), :namespaces-v1,\\n   :constants-v1, :autoload-v1, :strict-v1. `all-fixtures` is unconditional\\n   (the oracle iterates it); `enabled` is the subset whose :requires have all\\n   landed in `completed-steps`.\\\"\\n  (:require\\n    [yang.php.antlr.programs-p3b :as p3b]))\\n\\n\\n(def completed-steps\\n  \\\"P6 steps that have landed: S1 (the linked profile, module emitter,\\n   publication), S2 (include/require, the two missing stages, the computed\\n   arm), S3 (the dynamic-scope profile), S4 (namespaces, `use`, the\\n   constants read path) and S5 (constant declarations, magic constants,\\n   the autoload runtime). `:p6-s2-r8` (per-unit strict_types) is not here.\\\"\\n  #{:p6-s0 :p6-s1 :p6-s2 :p6-s3 :p6-s4 :p6-s5})\\n\\n\\n(def include-path\\n  \\\"The `include_path` the missing-include texts print: php:8.3-cli's\\n   default, PENDING the shiva pin (plan S0 item 2).\\\"\\n  \\\".:/usr/local/lib/php\\\")\\n\\n\\n(defn- fx\\n  [id group requires units main-source out & {:as more}]\\n  (merge (cond-> {:id id,\\n                  :group group,\\n                  :rows [],\\n                  :level :program,\\n                  :requires requires,\\n                  :source main-source,\\n                  :oracle :pending}\\n           (seq units) (assoc :units (assoc units \\\"main.php\\\" main-source))\\n           out (assoc :out out))\\n         more))\\n\\n\\n(defn- missing-warnings\\n  \\\"The two warnings of a missing `include`/`include_once` of `path`.\\\"\\n  [kind path]\\n  [[2 (str kind \\\"(\\\" path \\\"): Failed to open stream: No such file or directory\\\")]\\n   [2 (str kind \\\"(): Failed opening '\\\" path \\\"' for inclusion (include_path='\\\" include-path \\\"')\\\")]])\\n\\n\\n(def inclusion-v1\\n  [(fx :inc-basic :inclusion-v1 #{:p6-s2} {\\\"lib/a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php echo 'm'; include 'lib/a.php'; echo 'z';\\\" \\\"maz\\\")\\n   (fx :inc-return-value :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php return 5;\\\"}\\n       \\\"<?php $r = include 'a.php'; var_dump($r);\\\" \\\"int(5)\\\\n\\\")\\n   (fx :inc-default-one :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php var_dump(include 'a.php');\\\" \\\"aint(1)\\\\n\\\")\\n   (fx :inc-once-repeat :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php var_dump(include_once 'a.php'); var_dump(include_once 'a.php');\\\"\\n       \\\"aint(1)\\\\nbool(true)\\\\n\\\")\\n   (fx :inc-plain-then-once :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php include 'a.php'; var_dump(include_once 'a.php');\\\" \\\"abool(true)\\\\n\\\")\\n   (fx :inc-plain-twice :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php include 'a.php'; include 'a.php';\\\" \\\"aa\\\")\\n   (fx :inc-require-once-repeat :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php var_dump(require_once 'a.php'); var_dump(require_once 'a.php');\\\"\\n       \\\"aint(1)\\\\nbool(true)\\\\n\\\")\\n   (fx :inc-scope-sharing :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php $v = $v + 1;\\\"}\\n       \\\"<?php $v = 1; include 'a.php'; include 'a.php'; echo $v;\\\" \\\"3\\\")\\n   (fx :inc-dir-literal :inclusion-v1 #{:p6-s2} {\\\"lib/a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php include __DIR__ . '/lib/a.php';\\\" \\\"a\\\")\\n   (fx :inc-dirname-file :inclusion-v1 #{:p6-s2} {\\\"lib/a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php include dirname(__FILE__) . '/lib/a.php';\\\" \\\"a\\\")\\n   (fx :inc-nested :inclusion-v1 #{:p6-s2}\\n       {\\\"lib/a.php\\\" \\\"<?php echo 'a'; include 'lib/b.php';\\\", \\\"lib/b.php\\\" \\\"<?php echo 'b';\\\"}\\n       \\\"<?php include 'lib/a.php';\\\" \\\"ab\\\")\\n   (fx :inc-return-top-level-entry :inclusion-v1 #{:p6-s2} nil\\n       \\\"<?php echo 'a'; return; echo 'b';\\\" \\\"a\\\")\\n   (fx :inc-return-in-included :inclusion-v1 #{:p6-s2}\\n       {\\\"a.php\\\" \\\"<?php echo 'a'; return 3; echo 'x';\\\"}\\n       \\\"<?php var_dump(include 'a.php');\\\" \\\"aint(3)\\\\n\\\")\\n   (fx :inc-function-declared :inclusion-v1 #{:p6-s2}\\n       {\\\"a.php\\\" \\\"<?php function f() { return 'f'; }\\\"}\\n       \\\"<?php include 'a.php'; echo f();\\\" \\\"f\\\")\\n   (fx :inc-mutual-once :inclusion-v1 #{:p6-s2}\\n       {\\\"a.php\\\" \\\"<?php echo 'a'; include_once 'b.php';\\\",\\n        \\\"b.php\\\" \\\"<?php echo 'b'; include_once 'a.php';\\\"}\\n       \\\"<?php include_once 'a.php';\\\" \\\"ab\\\")\\n   (fx :inc-redeclare-across-units :inclusion-v1 #{:p6-s2}\\n       {\\\"a.php\\\" \\\"<?php function f() {}\\\"}\\n       \\\"<?php function f() {} include 'a.php';\\\" nil)\\n   (fx :inc-warning-in-included :inclusion-v1 #{:p6-s2}\\n       {\\\"a.php\\\" \\\"<?php echo $undef;\\\"}\\n       \\\"<?php include 'a.php'; echo 'z';\\\" \\\"z\\\"\\n       :diag [[2 \\\"Undefined variable $undef\\\"]])\\n   (fx :inc-throwing-body-still-marked :inclusion-v1 #{:p6-s2}\\n       {\\\"a.php\\\" \\\"<?php throw new Exception('x');\\\"}\\n       (str \\\"<?php try { include_once 'a.php'; } catch (Exception $e) { echo 'c'; }\\\"\\n            \\\" var_dump(include_once 'a.php');\\\")\\n       \\\"cbool(true)\\\\n\\\")\\n   (fx :inc-once-path-forms :inclusion-v1 #{:p6-s2} {\\\"lib/a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php include_once 'lib/a.php'; var_dump(include_once './lib/a.php');\\\"\\n       \\\"abool(true)\\\\n\\\")\\n   (fx :inc-in-condition :inclusion-v1 #{:p6-s2} {\\\"a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php if ((include 'a.php') === 1) { echo 'one'; }\\\" \\\"aone\\\")\\n   (fx :inc-computed-path :inclusion-v1 #{:p6-s2} {\\\"lib/a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php $p = 'lib/a.php'; include $p;\\\" \\\"a\\\"\\n       :computed true\\n       :warnings [:yang.php/computed-include-path])\\n   (fx :inc-computed-path-unmapped :inclusion-v1 #{:p6-s2} {\\\"lib/a.php\\\" \\\"<?php echo 'a';\\\"}\\n       \\\"<?php $p = 'lib/' . 'b.php'; var_dump(include $p);\\\" \\\"bool(false)\\\\n\\\"\\n       :computed true\\n       :diag (missing-warnings \\\"include\\\" \\\"lib/b.php\\\")\\n       :warnings [:yang.php/computed-include-path])])\\n\\n\\n(def missing-v1\\n  \\\"The oracle-pinned half: a genuinely missing file, every kind, each run\\n   twice (a refusal never marks the path), and the not-marked probe.\\\"\\n  [(fx :miss-include :missing-v1 #{:p6-s2} nil\\n       \\\"<?php var_dump(include 'x.php'); var_dump(include 'x.php');\\\" \\\"bool(false)\\\\nbool(false)\\\\n\\\"\\n       :diag (into (missing-warnings \\\"include\\\" \\\"x.php\\\") (missing-warnings \\\"include\\\" \\\"x.php\\\")))\\n   (fx :miss-include-once :missing-v1 #{:p6-s2} nil\\n       \\\"<?php var_dump(include_once 'x.php'); var_dump(include_once 'x.php');\\\"\\n       \\\"bool(false)\\\\nbool(false)\\\\n\\\"\\n       :diag (into (missing-warnings \\\"include_once\\\" \\\"x.php\\\") (missing-warnings \\\"include_once\\\" \\\"x.php\\\")))\\n   (fx :miss-require :missing-v1 #{:p6-s2} nil\\n       (str \\\"<?php for ($i = 0; $i < 2; $i++) {\\\"\\n            \\\" try { require 'x.php'; } catch (Error $e) { echo get_class($e), ': ', $e->getMessage(), \\\\\\\"\\\\\\\\n\\\\\\\"; } }\\\")\\n       (str (apply str (repeat 2 (str \\\"Error: Failed opening required 'x.php' (include_path='\\\" include-path \\\"')\\\\n\\\"))))\\n       :diag (vec (repeat 2 [2 \\\"require(x.php): Failed to open stream: No such file or directory\\\"])))\\n   (fx :miss-require-once :missing-v1 #{:p6-s2} nil\\n       (str \\\"<?php for ($i = 0; $i < 2; $i++) {\\\"\\n            \\\" try { require_once 'x.php'; } catch (Error $e) { echo get_class($e), ': ', $e->getMessage(), \\\\\\\"\\\\\\\\n\\\\\\\"; } }\\\")\\n       (str (apply str (repeat 2 (str \\\"Error: Failed opening required 'x.php' (include_path='\\\" include-path \\\"')\\\\n\\\"))))\\n       :diag (vec (repeat 2 [2 \\\"require_once(x.php): Failed to open stream: No such file or directory\\\"])))\\n   (fx :miss-not-marked-probe :missing-v1 #{:p6-s2} nil\\n       (str \\\"<?php try { require_once 'x.php'; } catch (Error $e) { echo get_class($e), \\\\\\\"\\\\\\\\n\\\\\\\"; }\\\"\\n            \\\" var_dump(include_once 'x.php');\\\")\\n       \\\"Error\\\\nbool(false)\\\\n\\\"\\n       :diag (into [[2 \\\"require_once(x.php): Failed to open stream: No such file or directory\\\"]]\\n                   (missing-warnings \\\"include_once\\\" \\\"x.php\\\")))])\\n\\n\\n(def strict-v1\\n  \\\"R8: the caller's unit governs argument coercion, the callee's the rest.\\\"\\n  [(fx :strict-caller-strict-callee-coercive :strict-v1 #{:p6-s2-r8}\\n       {\\\"f.php\\\" \\\"<?php function f(int $x) { return $x; }\\\"}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
