{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '365,395p' src/dev/yang/php/oracle.clj; sed -n '470,512p' src/dev/yang/php/oracle.clj; sed -n '539,574p' src/dev/yang/php/oracle.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"sed -n '365,395p' src/dev/yang/php/oracle.clj; sed -n '470,512p' src/dev/yang/php/oracle.clj; sed -n '539,574p' src/dev/yang/php/oracle.clj\"","aggregated_output":"       (when (:http-profile fixture)\n         \"http_response_code(200);\\n\")))\n\n\n(defn run-php-file-with-prepend\n  \"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` with `prepend-file`\n   (a path relative to `<dir>`) as `auto_prepend_file`, and return the\n   parsed `{:out :diag :uncaught :exit}`.\"\n  ([dir file prepend-file] (run-php-file-with-prepend dir file prepend-file nil))\n  ([dir file prepend-file unit-dir]\n   (let [{:keys [out err exit]}\n         (sh/sh \"docker\" \"run\" \"--rm\"\n                \"-v\" (str (.toAbsolutePath (.toPath (io/file dir))) \":/w\")\n                \"-w\" (if unit-dir (str \"/w/\" unit-dir) \"/w\")\n                \"php:8.3-cli\" \"php\"\n                \"-d\" \"display_errors=1\"\n                \"-d\" \"html_errors=0\"\n                \"-d\" \"error_reporting=E_ALL\"\n                \"-d\" \"log_errors=0\"\n                \"-d\" (str \"auto_prepend_file=/w/\" prepend-file)\n                file\n                :out-enc \"UTF-8\")]\n     (assoc (parse-stdout out (if unit-dir (str unit-dir \"/\" file) file) unit-dir)\n            :err err\n            :exit exit))))\n\n\n(defn check-p5-fixture\n  \"Run P5 `fixture` in temporary directory `dir`: the fixture source plus,\n   for `:request`-bearing fixtures, the [[p5-prologue]] as\n   `auto_prepend_file`. Returns a check record like [[check-fixture]].\"\n          (.delete ^java.io.File f))))))\n\n\n(defn p7-prologue\n  \"Register the tick handler before compiling the fixture's ticked unit.\"\n  []\n  (str \"<?php \" p7b/prologue))\n\n\n(defn check-p7-fixture\n  \"Run a P7 fixture with its prologue and optional included units.\"\n  [dir {:keys [id source units out oracle]}]\n  (let [unit-dir (name id)\n        pre (str unit-dir \"/pre.php\")]\n    (doseq [[path contents] (merge units {\"main.php\" (str \"<?php \" source),\n                                          \"pre.php\" (p7-prologue)})]\n      (let [f (io/file dir unit-dir path)]\n        (io/make-parents f)\n        (write-source! dir (str unit-dir \"/\" path) contents)))\n    (let [actual (run-php-file-with-prepend dir \"main.php\" pre unit-dir)\n          expected {:out out, :diag [], :uncaught nil}]\n      {:id id, :oracle oracle,\n       :pass? (and (not= :pending oracle)\n                   (= expected (select-keys actual [:out :diag :uncaught]))),\n       :expected expected,\n       :actual (assoc (select-keys actual [:out :diag :uncaught :fatal]) :exit (:exit actual))})))\n\n\n(defn run-p7\n  \"Run the pending P7-b ticks fixtures against php:8.3-cli.\"\n  []\n  (let [dir (.toFile (Files/createTempDirectory \"yang-php-oracle-p7-\"\n                                                (make-array FileAttribute 0)))]\n    (try\n      (mapv #(check-p7-fixture dir %) p7b/fixtures)\n      (finally\n        (doseq [f (reverse (file-seq dir))]\n          (.delete ^java.io.File f))))))\n\n\n(defn print-fold\n  \"Print the fold lines for `results`: one paste-ready record per fixture\n   in the P4 [[p4/pin]] shape `{:oracle p5-banner :out :diag :uncaught}`,\n(defn -main\n  [& args]\n  (when (some #{\"--print-prologue\"} args)\n    (let [id (keyword (or (second (drop-while #(not= \"--print-prologue\" %) args))\n                          \"superglobals-from-request\"))\n          fixture (first (filter #(= id (:id %)) p5/fixtures))\n          b2-fixture (first (filter #(= id (:id %)) p5b2/fixtures))]\n      (when-not (or fixture b2-fixture)\n        (println \"Unknown P5 fixture:\" id)\n        (System/exit 2))\n      ;; Dry run: no docker, no oracle. Print the generated prologue for\n      ;; eyeball comparison against the engine's expected superglobal\n      ;; values (the fixture's hand-derived :out is the reference).\n      (print (if b2-fixture\n               (p5b2-prologue b2-fixture)\n               (p5-prologue (:request fixture))))\n      (flush)\n      (shutdown-agents)\n      (System/exit 0)))\n  (when (some #{\"--p7\"} args)\n    (let [results (run-p7)\n          pending (filter #(= :pending (:oracle %)) results)\n          failures (remove #(or (:pass? %) (= :pending (:oracle %))) results)]\n      (println \"Banner: pending; record the actual oracle provenance\")\n      (println \"Checked:\" (count results) \"P7 targets; failures:\" (count failures))\n      (print-fold pending :pending)\n      (doseq [f failures]\n        (println \"FAIL\" (:id f) (pr-str (:expected f)) (pr-str (:actual f))))\n      (shutdown-agents)\n      (System/exit (if (seq failures) 1 0))))\n  (when (some #{\"--p5\"} args)\n    (let [results (run-p5)\n          recorded (filter #(= :pending (:oracle %)) results)\n          failures (remove #(or (:pass? %) (= :pending (:oracle %))) results)]\n      (println \"Banner:\" p5-banner)\n      (println \"Checked:\" (count results) \"P5 targets; failures:\" (count failures))\n","exit_code":0,"status":"completed"}}
