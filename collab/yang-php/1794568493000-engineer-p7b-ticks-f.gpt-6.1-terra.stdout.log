A'; $g->next();\",\n    :out \"ATBT\", :oracle :pending}\n   {:id :sequence-n2, :source \"declare(ticks=2) { echo 'A'; $x = 1; echo 'B'; }\",\n    :out \"ATB\", :oracle :pending}\n   {:id :nested-threshold,\n    :source \"declare(ticks=5) { echo 'A'; $x=1; echo 'B'; declare(ticks=2) { echo 'C'; } echo 'D'; }\",\n    :out \"ABCTD\", :oracle :pending}\n   {:id :cross-function,\n    :source \"function f() { declare(ticks=2) { echo 'F'; } } declare(ticks=2) { echo 'A'; } f();\",\n    :out \"AFT\", :oracle :pending}\n   {:id :semicolon-directive, :source \"declare(ticks=2); echo 'A'; echo 'B';\",\n    :out \"ATB\", :oracle :pending}\n   {:id :include-handoff, :source \"include 'lib.php';\",\n    :units {\"lib.php\" \"<?php declare(ticks=1) { echo 'L'; }\"},\n    :out \"LT\", :oracle :pending}])\nrg: src/cljc/yang/php/antlr/core.cljc: No such file or directory (os error 2)\nsrc/cljc/yang/core/uast.cljc:122:;; `:yang/site`, the safepoint mark, which travels as node metadata.\nsrc/cljc/yang/php/antlr/builtins.cljc:50:                   \"register_shutdown_function\" 'php/bi-register-shutdown-function,\nsrc/cljc/yang/php/antlr/prelude.cljc:4452:    [php/run-shutdown-fns\nsrc/cljc/yang/php/antlr/prelude.cljc:4455:       (let [fns (cell/get php.rt/shutdown-fns)]\nsrc/cljc/yang/php/antlr/prelude.cljc:4458:               (php/run-shutdown-fns (+ i 1)))\nsrc/cljc/yang/php/antlr/prelude.cljc:4463:    [php/bi-register-shutdown-function\nsrc/cljc/yang/php/antlr/prelude.cljc:4465:       (do (cell/set! php.rt/shutdown-fns\nsrc/cljc/yang/php/antlr/prelude.cljc:4466:                      (php/vconj (cell/get php.rt/shutdown-fns)\nsrc/cljc/yang/php/antlr/prelude.cljc:4509:       (do (php/run-shutdown-fns 0)\nsrc/cljc/yang/php/antlr/prelude.cljc:6106:                 (define 'php.rt/shutdown-fns '(cell/new []))\nsrc/cljc/yang/php/antlr/prelude.cljc:6195:    php.rt/shutdown-fns php.rt/exit-status php.rt/in-shutdown php.rt/fatal-escape\n","exit_code":2,"status":"failed"}}
