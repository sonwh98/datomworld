{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '5760,5830p;6040,6120p' src/cljc/yang/php/antlr/prelude.cljc; sed -n '2260,2330p;3520,3595p;3650,3720p' src/cljc/yang/php/antlr/lower.cljc; cat src/cljc/yang/php/antlr/safepoint.cljc; sed -n '110,220p' src/cljc/yang/safepoint.cljc; sed -n '80,190p' test/yang/php/antlr/e2e_harness.clj\"","aggregated_output":"    [php/bi-ksort (fn [args] (php/do-sort \"ksort\" args 0 true 1))]\n    [php/bi-krsort (fn [args] (php/do-sort \"krsort\" args 0 true -1))]\n    [php/bi-usort (fn [args] (php/do-usort \"usort\" args 1 false))]\n    [php/bi-uasort (fn [args] (php/do-usort \"uasort\" args 1 true))]\n    [php/bi-uksort (fn [args] (php/do-usort \"uksort\" args 0 true))]\n\n    ;; ---------------------------------------------------------------- unit\n    [php/bi-set-exception-handler\n     (fn [args]\n       (let [old (cell/get php.rt/exception-handler)]\n         (do (cell/set! php.rt/exception-handlers\n                        (php/vconj (cell/get php.rt/exception-handlers) old))\n             (cell/set! php.rt/exception-handler (get args 0))\n             old)))]\n    [php/bi-restore-exception-handler\n     ;; back to the handler in force before the last `set_exception_handler`\n     (fn [args]\n       (let [stack (cell/get php.rt/exception-handlers)\n             n (data/count stack)]\n         (do (if (= n 0)\n               (cell/set! php.rt/exception-handler :php/null)\n               (do (cell/set! php.rt/exception-handler (get stack (- n 1)))\n                   (cell/set! php.rt/exception-handlers (php/args-prefix stack (- n 1) 0 []))))\n             true)))]\n    [php/handle-uncaught\n     ;; the user exception handler takes an uncaught throwable; the script then ends\n     (fn [exc]\n       (let [h (cell/get php.rt/exception-handler)]\n         (if (= exc :php/null)\n           exc\n           (if (= h :php/null)\n             exc\n             (do (cell/set! php.rt/exception-handler :php/null)\n                 (php/try (fn [] (do (php/call-value h (php/vconj [] exc)) :php/null))\n                          (fn [e] e)\n                          (fn [] :php/null)))))))]\n    [php/run-main\n     ;; the unit root: one task consuming one request record from the\n     ;; composition-supplied stream. The request seeds the superglobals here\n     ;; at initialization (not via a test-only rewrite): a nil request keeps\n     ;; the empty defaults. `response-stream` and `diag-stream` are the\n     ;; composition-supplied stream references execution emits response and\n     ;; diagnostic records on DURING the run (:php/null without them, when\n     ;; the cells accumulate instead).\n     ;; The operational fatal escapes past everything through php/root-fatal;\n     ;; exit escapes past handlers and finally blocks through php/root-exit\n     ;; and its status is preserved through shutdown\n     (fn [body request response-stream diag-stream]\n       (do (cell/set! php.rt/out [[]])\n           (cell/set! php.rt/ctx (php/ctx nil 0 0 nil))\n           (cell/set! php.rt/response [])\n           (cell/set! php.rt/response-stream (if (if (nil? response-stream)\n                                                   true\n                                                   (= response-stream :php/null))\n                                               :php/null\n                                               response-stream))\n           (cell/set! php.rt/diag-stream (if (if (nil? diag-stream)\n                                               true\n                                               (= diag-stream :php/null))\n                                           :php/null\n                                           diag-stream))\n           (cell/set! php.rt/headers-sent false)\n           (cell/set! php.rt/status 200)\n           (cell/set! php.rt/exit-status :php/null)\n           (cell/set! php.rt/in-shutdown false)\n           (cell/set! php.rt/fatal-escape :php/null)\n           (cell/set! php.rt/exit-escape :php/null)\n           (cell/set! php.rt/shutdown-escape :php/null)\n           (let [response-records\n                 (fn []\n                   ;; what execution emitted: drained from the\n                                :final? (boolean final?),\n                                :constants [],\n                                :props-decl [],\n                                :static-props [],\n                                :methods [],\n                                :cases [],\n                                :attrs []}\n                               members))))\n          {}\n          seed-classes))\n\n\n(def ^:private define core/define)\n\n\n(defn- constants-form\n  \"The guest map expression seeding `php.rt/constants` from\n   `builtins/constants`, so `defined` and `constant` agree with the\n   lowering's folded literals.\"\n  []\n  (reduce (fn [m [nm v]]\n            (list 'assoc\n                  m\n                  nm\n                  (cond\n                    (= v :nan) '(php/nan-const)\n                    (= v :inf) '(php/inf-const)\n                    (and (vector? v) (= :int (first v)))\n                    (if (str/starts-with? (second v) \"-\")\n                      (list 'php/int-lit-radix (second v) 10)\n                      (list 'php/int-lit (second v)))\n                    (and (vector? v) (= :float (first v)))\n                    (list 'php/f (list 'data/float-value (nth v 2)))\n                    :else v)))\n          {}\n          (sort-by key builtins/constants)))\n\n\n(defn- init-form\n  \"`php/init!`'s body: the runtime cells, the builtins, the ready flag, under\n   the uninit guard.\"\n  []\n  (list 'fn []\n        (list 'if (list '= 'php.rt/state :php/uninit)\n              (concat\n                ['do\n                 (define 'php.rt/ctx '(cell/new (php/ctx nil 0 0 nil)))\n                 (define 'php.rt/out '(cell/new [[]]))\n                 (define 'php.rt/request '(cell/new {}))\n                 (define 'php.rt/response '(cell/new []))\n                 (define 'php.rt/headers-sent '(cell/new false))\n                 (define 'php.rt/status '(cell/new 200))\n                 (define 'php.rt/error-handlers '(cell/new []))\n                 (define 'php.rt/globals\n                   '(cell/new (php/empty-array)))\n                 (define 'php.rt/functions '(cell/new {}))\n                 (define 'php.rt/classes (list 'cell/new seed-table))\n                 (define 'php.rt/class-index\n                   (list 'cell/new\n                         (into {} (map (fn [nm] [(str/lower-case nm) nm])) (keys seed-table))))\n                 (define 'php.rt/next-ord '(cell/new 1))\n                 (define 'php.rt/finalizable '(cell/new []))\n                 (define 'php.rt/strict '(cell/new false))\n                 (define 'php.rt/exception-handler '(cell/new :php/null))\n                 (define 'php.rt/exception-handlers '(cell/new []))\n                 (define 'php.rt/class-order '(cell/new []))\n                 (define 'php.rt/shutdown-fns '(cell/new []))\n                 (define 'php.rt/exit-status '(cell/new :php/null))\n                 (define 'php.rt/in-shutdown '(cell/new false))\n                 (define 'php.rt/fatal-escape '(cell/new :php/null))\n                 (define 'php.rt/exit-escape '(cell/new :php/null))\n                 (define 'php.rt/shutdown-escape '(cell/new :php/null))\n                 (define 'php.rt/pending-exc '(cell/new :php/null))\n                 (define 'php.rt/cmp-depth '(cell/new 0))\n                 (define 'php.rt/tmps '(cell/new []))\n                 (define 'php.rt/next-cell '(cell/new 1))\n                 (define 'php.rt/error-handler '(cell/new :php/null))\n                 (define 'php.rt/error-masks '(cell/new []))\n                 (define 'php.rt/error-mask '(cell/new 32767))\n                 ;; E_ALL\n                 (define 'php.rt/error-reporting '(cell/new 32767))\n  (mapv (fn [e] (app* 'php/echo (app* 'php/to-string (lower ctx e))))\n        (core/rules ctx expression-list \"expression\")))\n\n\n(defn- html-node\n  \"`(php/echo bytes)` of an `inlineHtml` rule: the `:text` of every token\n   under it, in preorder (markup tokens included).\"\n  [ctx n]\n  (letfn [(texts\n            [x]\n            (mapcat (fn [k] (if (p/rule? k) (texts k) [(:text k)]))\n                    (core/kids ctx x)))]\n    (app* 'php/echo (u/lit (byte-string (apply str (texts n)))))))\n\n\n(defn- contains-token?\n  \"True when a token of type `t` occurs below `n`.\"\n  [ctx n t]\n  (boolean\n    (some (fn [k] (if (p/rule? k) (contains-token? ctx k t) (= t (:type k))))\n          (core/kids ctx n))))\n\n\n(defn- with-temps\n  \"`node` followed by the release of the temporaries it registered, when the\n   statement `n` holds a call that can leave one (row 37).\"\n  [ctx n node]\n  (if (or (some #(core/contains-rule? ctx n % #{}) [\"functionCall\" \"newExpr\" \"memberAccess\"])\n          (contains-token? ctx n \"Clone\"))\n    (let [mark (core/gen \"tm\" n)]\n      (u/let1 mark (app* 'php/tmp-mark) (u/then node (app* 'php/release-tmps (u/v mark)))))\n    node))\n\n\n(defn- block-nodes\n  [ctx n]\n  (mapv #(lower ctx %) (core/rule-kids ctx n)))\n\n\n(defn- sequence-node\n  [nodes]\n  (if (seq nodes) (u/seq-nodes nodes) (u/lit :php/null)))\n\n\n;; -----------------------------------------------------------------------------\n;; Loops and escapes\n;; -----------------------------------------------------------------------------\n\n(defn- loop-frame\n  \"A level of the `:loops` stack. `:used` collects the escapes the body\n   takes (`:brk`, `:cont`), so only those are bound.\"\n  [n switch?]\n  {:brk (core/gen \"brk\" n),\n   :cont (core/gen \"cont\" n),\n   :used (atom #{}),\n   :switch? switch?})\n\n\n(defn- push-frame\n  [ctx frame]\n  (update ctx :loops conj frame))\n\n\n(defn- wrap-escape\n  \"`node` under a `php/call-ec` that binds the frame's `kind` escape, when the\n   body used it.\"\n  [frame kind node]\n  (if (contains? @(:used frame) kind)\n    (app* 'php/call-ec (u/lam [(get frame kind)] node))\n    node))\n\n                          (class-text ctx)))\n        interfaces (cond\n                     interface? (type-names ctx (first (core/rules ctx n \"interfaceList\")))\n                     :else (type-names ctx (first (core/rules ctx n \"interfaceList\"))))\n        statements (core/rules ctx n \"classStatement\")\n        _ (doseq [st statements]\n            (when (seq (core/rules ctx st \"attributes\")) (unsupported! st :attribute)))\n        tok (fn [st] (some #(when (p/token? %) (:type %)) (core/kids ctx st)))\n        consts (mapcat #(const-entries ctx cname %) (filter #(= \"Const\" (tok %)) statements))\n        props (mapcat (fn [st]\n                        (cond\n                          (seq (core/rules ctx st \"propertyModifiers\")) (property-entries ctx cname st)\n                          (and (= \"Function_\" (tok st))\n                               (= \"__construct\" (str/lower-case (function-written ctx st))))\n                          (promoted-entries ctx st)\n                          :else []))\n                      statements)\n        methods (mapv #(method-entry ctx % %) (filter #(= \"Function_\" (tok %)) statements))\n        uses (filter #(= \"Use\" (tok %)) statements)\n        [traits rules] (trait-rules ctx uses)]\n    [cname\n     (spec-node (cond-> {:name (u/lit cname),\n                         :kind (u/lit kind),\n                         :abstract? (u/lit (boolean (:abstract mods))),\n                         :final? (u/lit (boolean (:final mods))),\n                         :interfaces (args-vector (map u/lit interfaces)),\n                         :traits (args-vector (map u/lit traits)),\n                         :trait-rules rules,\n                         :consts (args-vector consts),\n                         :props (args-vector props),\n                         :methods (args-vector methods)}\n                  parent (assoc :parent (u/lit parent))))]))\n\n\n(defn- lower-declare\n  \"`declare(strict_types=1)` switches the unit to strict scalar typing; `ticks`\n   and `encoding` are accepted and inert. A body statement runs after.\"\n  [ctx n]\n  (let [ds (mapcat #(core/rules ctx % \"directive\") (core/rules ctx n \"declareList\"))\n        strict (some (fn [d]\n                       (when (some #(and (p/token? %) (= \"StrictTypes\" (:type %))) (core/kids ctx d))\n                         (= \"1\" (leftmost-token-text ctx (first (core/rules ctx d \"numericConstant\"))))))\n                     ds)\n        body (first (core/rules ctx n \"statement\"))]\n    (u/then (if (some? strict) (app* 'php/set-strict! (u/lit (boolean strict))) (u/lit :php/null))\n            (if body (lower ctx body) (u/lit :php/null)))))\n\n\n(defn- lower-class\n  \"A class declared in place (nested or conditional): declared when reached.\"\n  [ctx n]\n  (let [[_ spec] (class-spec ctx n)]\n    (u/then (app* 'php/declare-class! spec) (u/lit :php/null))))\n\n\n(defn- lower\n  \"The node of CST rule node `n`.\"\n  [ctx n]\n  (case (:rule n)\n    \"inlineHtml\" (html-node ctx n)\n    \"phpBlock\" (sequence-node (block-nodes ctx n))\n    (\"topStatement\" \"innerStatement\" \"statement\" \"namespaceStatement\")\n    (lower ctx (first (core/rule-kids ctx n)))\n    \"globalConstantDeclaration\" (lower-const ctx n)\n    \"echoStatement\" (with-temps ctx n\n                      (sequence-node (echo-nodes ctx (first (core/rules ctx n \"expressionList\")))))\n    \"expressionStatement\" (with-temps ctx n (lower ctx (first (core/rules ctx n \"expression\"))))\n    \"emptyStatement_\" (u/lit :php/null)\n    \"inlineHtmlStatement\" (sequence-node (block-nodes ctx n))\n    \"blockStatement\" (lower ctx (first (core/rules ctx n \"innerStatementList\")))\n    \"innerStatementList\" (sequence-node (block-nodes ctx n))\n    \"expression\" (lower-expression ctx n)\n    \"yieldExpression\" (lower-yield ctx n)\n    \"parentheses\" (lower ctx (first (core/rule-kids ctx n)))\n    \"ifStatement\" (lower-if ctx n)\n    \"whileStatement\" (lower-while ctx n)\n\n\n(defn- context\n  ([packet] (context packet {}))\n  ([packet {:keys [path linked?], :or {path entry-path}}]\n   (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n         ctx {:pk pk,\n              :analysis (scope/analyze pk),\n              :loops [],\n              :unit {:path path},\n              :linked? (boolean linked?),\n              :warnings (atom [])}\n         ctx (merge ctx (unit-layout ctx))]\n     (assoc ctx :declared (declared-functions ctx)))))\n\n\n(defn- check-hoisted!\n  \"A top-level function declared twice, or over a builtin, is a compile\n   error.\"\n  [ctx hoisted]\n  (reduce (fn [seen item]\n            (let [f (rule-head ctx item)\n                  written (ns-prefixed (item-ctx ctx item) (function-written ctx f))\n                  lc (str/lower-case written)]\n              (when (or (contains? seen lc) (contains? prelude/builtin-names lc))\n                (compile-error! f (str \"Cannot redeclare \" written \"()\")))\n              (conj seen lc)))\n          #{}\n          hoisted))\n\n\n(defn- class-item?\n  [ctx item]\n  (contains? #{\"classDeclaration\" \"enumDeclaration\"} (:rule (rule-head ctx item))))\n\n\n(defn- unit-body\n  \"The unit's statements as one node, hoisted function declarations first,\n   then the classes that can be declared at that point (PHP hoists a class\n   whose parent, interfaces and traits already exist); a hoisted class is\n   skipped when execution reaches it.\"\n  [ctx]\n  (let [items (:items ctx)\n        hoisted (filterv #(hoisted? ctx %) items)\n        classes (mapv (fn [item]\n                        (let [c (rule-head ctx item)\n                              [_ spec] (class-spec (item-ctx ctx item) c)]\n                          [(:id item) (symbol (str \"%class-\" (:id c))) spec]))\n                      (filter #(class-item? ctx %) items))\n        syms (into {} (map (fn [[id sym _]] [id sym])) classes)\n        in-place (fn [item]\n                   (if-let [sym (get syms (:id item))]\n                     (app* 'php/declare-late! (u/v sym))\n                     (lower (item-ctx ctx item) item)))]\n    (check-hoisted! ctx hoisted)\n    (let [body (sequence-node\n                 (concat (mapv #(lower (item-ctx ctx %) %) hoisted)\n                         (mapv (fn [[_ sym _]] (app* 'php/hoist-class! (u/v sym))) classes)\n                         (mapv in-place (remove #(hoisted? ctx %) items))))]\n      (reduce (fn [inner [_ sym spec]] (u/let1 sym (u/lam [] spec) inner))\n              body\n              (reverse classes)))))\n\n\n(defn- unit-returns?\n  \"True when the unit holds a top-level `return` (outside functions and\n   classes), which needs the escape around its body.\"\n  [ctx]\n  (core/contains-rule? ctx\n                       (p/root (:pk ctx))\n                       \"returnStatement\"\n(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def ticks-profile\n  \"Statement completion hooks for PHP's lexical ticks directives. This is\n   separate from the execution-budget profile so ticks do not charge it.\"\n  {:line {:hook 'php.sp/line, :operands true, :after true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\n\n(defn- entry-hook\n  \"The `{:hook sym :operands [literal ...]}` of profile entry `entry` at a\n   site marked `mark`, or nil.\"\n  [entry mark]\n  (when entry\n    (if (map? entry)\n      {:hook (:hook entry),\n       :operands (when (:operands entry) (vec (rest mark)))}\n      {:hook entry})))\n\n\n(defn- site-hooks\n  \"`{:enter h :exit h}` (either absent), each an `entry-hook`, for a site\n   marked `mark` under `profile`.\"\n  [profile mark]\n  (let [kind (mark-kind mark)\n        exit (some (fn [[x entry]] (when (= entry kind) (get profile x)))\n                   exit-kinds)]\n    (cond-> {}\n      (get profile kind) (assoc :enter (entry-hook (get profile kind) mark))\n      (and (map? (get profile kind)) (:sequence (get profile kind)))\n      (assoc :sequence? true)\n      (and (map? (get profile kind)) (:after (get profile kind)))\n      (assoc :after? true)\n      exit (assoc :exit (entry-hook exit mark)))))\n\n\n(defn- hook-application\n  [{:keys [hook operands]} args]\n  {:type :application,\n   :operator {:type :variable, :name hook},\n   :operands (into (mapv (fn [x] {:type :literal, :value x}) operands) args)})\n\n\n(defn- sequence-hook\n  \"`node` evaluated after `hook` is applied.\"\n  [node hook]\n  {:type :application,\n   :operator {:type :lambda, :params [binder], :body node},\n   :operands [(hook-application hook [])]})\n\n\n(defn- after-hook\n  [node hook]\n  {:type :application,\n   :operator {:type :lambda, :params [result-binder],\n              :body (sequence-hook {:type :variable, :name result-binder} hook)},\n   :operands [node]})\n\n\n(defn- prefix-hook\n  \"Lambda `node` with `hook` applied before its body runs.\"\n  [node hook]\n  (assoc node\n         :body (sequence-hook (:body node) hook)))\n\n\n(defn- wrap-hook\n  \"Lambda `node` with `hook` applied to its body's value.\"\n  [node hook]\n  (assoc node :body (hook-application hook [(:body node)])))\n\n\n(defn- rewrite\n  \"The map AST `ast` with each `{path {:enter h :exit h}}` site's exit hook\n   wrapped around its body and its entry hook prefixed. Throws when a site\n   names no node, or a node that is not a lambda.\"\n  [ast hooks]\n  (let [seen (volatile! #{})]\n    (letfn [(walk\n              [node path]\n              (let [slots (get vm/semantic-bytecode-grammar (:type node))\n                    node (reduce\n                           (fn [n [j [field kind]]]\n                             (let [pos (+ j 2)]\n                               (case kind\n                                 :node (update n field walk (conj path pos))\n                                 :nodes (update n field\n                                                (fn [children]\n                                                  (vec (map-indexed\n                                                         (fn [i child]\n                                                           (walk child (conj path [pos i])))\n                                                         children))))\n                                 n)))\n                           node\n                           (map-indexed vector slots))]\n                (if-let [{:keys [enter exit statement? sequence? after?]} (get hooks path)]\n                  (do (vswap! seen conj path)\n                      (if (or statement? sequence?)\n                        (if after? (after-hook node enter) (sequence-hook node enter))\n                        (do (when-not (= :lambda (:type node))\n                              (throw (ex-info \"Safepoint site is not a lambda\"\n                                              {:rule :site-not-lambda, :path path,\n                                               :type (:type node)})))\n                            (cond-> node\n                              exit (wrap-hook exit)\n                              enter (prefix-hook enter)))))\n                  node)))]\n      (let [out (walk ast [])\n            missing (remove @seen (keys hooks))]\n        (when (seq missing)\n          (throw (ex-info \"Safepoint site names no node\"\n                          {:rule :site-missing, :paths (vec (sort-by pr-str missing))})))\n        out))))\n\n\n(defn- selected-hooks\n  \"`{path {:enter h :exit h}}` of the sites `profile` selects.\"\n  [sites profile]\n  (into {}\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught fatal]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n       (when fatal\n         (str \"PHP Fatal error:  \" fatal))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\n   and starts one per-run counter; no option leaves the AST unchanged.\"\n  ([registry ast] (run-vms registry ast {}))\n  ([registry ast {:keys [execution-budget envelope]}]\n   (let [ast (if (some? execution-budget)\n               (let [projected (encoder/project envelope)\n                     derived (:envelope (safepoint/derive-envelope\n                                          projected hooks/profile :test/derived))\n                     tree (nth (:yin/batch derived) (:yin/root derived))]\n                 (hooks/program execution-budget\n                                (vm/semantic-bytecode->ast tree)))\n               ast)\n         opts (assoc base-opts :modules registry)\n         session (tu/make-observer-session (tu/create-vm {:modules registry}))\n         datoms (vec (vm/ast->datoms ast))\n         projected #(:vector (sr-linearize/project ast))\n         attempt (fn [f]\n                   (try (render (f))\n                        (catch Exception e [:thrown (ex-message e)])))]\n     (tu/queue-ast! session ast)\n     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\n      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\n                                                           datoms)))),\n      :stack (attempt #(vm/value (vm/run (dvm/create-vm\n                                           (:image (derive/stack-image (projected)))\n                                           (assoc opts :contract vm/stack-contract))))),\n      :register (attempt #(vm/value (vm/run (rvm/create-vm\n                                              (derive/register-image (projected))\n                                              (assoc opts\n                                                     :contract\n                                                     vm/register-contract)))))})))\n\n\n(defn run-php\n  \"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\n   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\"\n  ([source] (run-php source {}))\n  ([source options]\n   (let [{:keys [ast diagnostics envelope]} (lower-program source)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (run-vms (host-registry) ast (assoc options :envelope envelope))))))\n\n\n(defn run-walker\n  \"The ast-walker's rendering of `source` alone (fast iteration).\"\n  [source]\n  (let [{:keys [ast diagnostics]} (lower-program source)]\n    (if diagnostics\n      {:diagnostics diagnostics}\n      (let [registry (host-registry)\n            session (tu/make-observer-session (tu/create-vm {:modules registry}))]\n        (tu/queue-ast! session ast)\n        (try (render (vm/value (:consumer (tu/run-session session))))\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value on the AST walker, consuming an optional request record\n  through the production channel: the harness composes the record as\n  `run-main`'s second operand — no AST rewrite involved, and lowering\n  never sees request data.\"\n  ([source] (run-raw source nil))\n  ([source request]\n   (let [{:keys [ast diagnostics]} (lower-program source request)]\n     (if diagnostics\n       {:diagnostics diagnostics}\n       (let [session (tu/make-observer-session\n                       (tu/create-vm {:modules (host-registry)}))]\n         (tu/queue-ast! session ast)\n         (vm/value (:consumer (tu/run-session session))))))))\n","exit_code":0,"status":"completed"}}
