{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn eval|defn create-vm|defn vm-load' src/cljc/yin/vm.cljc src/cljc/yin/vm/ast_walker.cljc; sed -n '70,110p' test/yin/vm/test_utils.cljc; sed -n '1,100p' src/cljc/yang/php/antlr/eval_publication.cljc; sed -n '1,85p' src/cljc/yang/php/antlr/safepoint.cljc\"","aggregated_output":"src/cljc/yin/vm/ast_walker.cljc:855:(defn vm-load-program\nsrc/cljc/yin/vm/ast_walker.cljc:934:(defn vm-load-rows\nsrc/cljc/yin/vm/ast_walker.cljc:1087:(defn create-vm\n(defn drain\n  \"Every value a reader handle holds, oldest first. The read is the\n   contract's own shape — a cursor minted at `:dao.stream/oldest`, then\n   `next` until something other than `ok` — so draining changes no state the\n   handle's owner depends on.\"\n  [handle]\n  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\n                      [:dao.stream/cursor])]\n    (loop [cursor start\n           acc []]\n      (let [result (stream/next handle cursor)]\n        (if (= :dao.stream/ok (:dao.stream/outcome result))\n          (recur (:dao.stream/cursor result)\n                 (conj acc (:dao.stream/value result)))\n          acc)))))\n\n\n(defn create-vm\n  \"An ast-walker VM wired to the ring buffer.\"\n  ([] (create-vm {}))\n  ([opts]\n   (ast-walker/create-vm (merge {:make-stream make-stream,\n                                 :capability-secret secret}\n                                opts))))\n\n\n(defn- run-vm\n  \"Run the VM through its protocol entry point, as a plain function so it can\n   be handed to observer coordination on every host.\"\n  [vm]\n  (vm/run vm))\n\n\n(defn make-attachment\n  \"One owned medium, its descriptor-bound unary attacher, and an attached\n   observer: the piece every stream-driven session composes.\"\n  [capacity]\n  (let [handle (new-stream capacity)\n        descriptor (:dao.stream/descriptor (stream/descriptor handle))\n        attach! (ringbuffer/make-attacher\n                  {(:dao.stream/identity descriptor) handle})]\n(ns yang.php.antlr.eval-publication\n  \"Publish an admitted eval unit and its canonical safepoint occurrences.\"\n  (:require [dao.jing :as jing]\n            [yang.php.antlr.lower :as lower]\n            [yang.php.antlr.siteset :as siteset]\n            [yin.vm.linker.publish :as publish]))\n\n\n(defn publish!\n  \"Publish a prepared, successfully parsed eval unit under the supplied name.\n   Retain the coordinator's identity and bind its site set to the manifest.\"\n  [store registry name prepared]\n  (if (= :yang.cst/ok (get-in prepared [:cst :yang.cst/outcome]))\n    (let [spec (lower/eval-module-spec registry name (:cst prepared))\n          result (publish/publish-module! store spec)]\n      (if (= :refused (:status result))\n        result\n        (assoc result :status :ok :identity (:identity prepared)\n               :source-address (jing/materialize! store (:identity prepared))\n               :sites (siteset/publish! store (:address result) (:ast spec)))))\n    {:status :refused :reason :eval-source-not-ready :identity (:identity prepared)}))\n(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]\n    [yang.core.module :as module]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def ticks-profile\n  \"Statement completion hooks for PHP's lexical ticks directives. This is\n   separate from the execution-budget profile so ticks do not charge it.\"\n  {:line {:hook 'php.sp/line, :operands true, :after true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\n\n\n(defn module-spec\n  \"The linked ticks hook delegates to the shared PHP runtime.\"\n  [registry php-address]\n  (let [ast (module/module-tree\n              [(module/require-node 'php)\n               (u/def! 'line (u/sexp->uast '(fn [line site] (php/tick-line line site))))])\n        requires {'php php-address}]\n    {:name 'php.sp, :ast ast, :exports '#{line}, :requires requires,\n     :primitives (module/free-primitives :yang.php/error :yang.php/undeclared\n                                         registry (set (keys requires)) ast)}))\n","exit_code":0,"status":"completed"}}
