eclared effect set is also entered in the registry's\n   identity-keyed `:callable-effects`, which the engine checks an\n   effect's kind against (D4).\n\n   The module is entered as an already-linked manifest with\n   `:yin.module/tree` absent, `:yin.module/derivations {}`, and its\n   exports listed under `:yin.module/primitives` by profile address; the\n   exports themselves are its `:slice`, and its `:address` and\n   `:derivation` are nil because no content was fetched or derived: the\n   host is the boundary.\"\n  [registry module-name fns profiles]\n  (doseq [sym (sort-by str (keys fns))]\n    (check-binding! module-name sym (get profiles sym)))\n  (-> (or registry (empty-registry))\n      (update :callable-effects\n              (partial merge-with into)\n              (vm/callable-effects fns profiles))\n      (assoc-in (into [:modules] (symbol->path module-name))\n                {:manifest {:yin.module/name module-name,\n                            :yin.module/derivations {},\n                            :yin.module/primitives\n                            (into {} (map (fn [[sym _f]]\n                                            [sym (:yin.k/profile\n                                                   (get profiles sym))]))\n                                  fns)},\n                 :address nil,\n                 :derivation nil,\n                 :slice fns,\n                 :stores {}})))\n\n\n(defn host-export-profile\n  \"The profile address host module `ns` publishes for export `name`, when\n   `qualified-sym` is `ns/name` and `registry` holds `ns` as a\n   host-registered entry (`register-host-module`'s shape, `:address`\n   nil); else nil. A linked entry never answers: the\n   `:yin.module/primitives` of a fetched manifest are the primitives that\n                id))]\n      (walk form))\n    {:yang.cst/version 1,\n     :yang.cst/unit [:hand 0],\n     :yang.cst/grammar \"hand\",\n     :yang.cst/outcome :yang.cst/ok,\n     :yang.cst/root 0,\n     :yang.cst/nodes @out,\n     :yang.cst/complete true}))\n\n\n(defn render\n  \"The text a unit prints (ASCII here: the carrier is the text), then, for an\n   uncaught error, the fatal line (no path).\"\n  [{:php/keys [out uncaught fatal]}]\n  (str out\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n       (when fatal\n         (str \"PHP Fatal error:  \" fatal))))\n\n\n(defn operand-node\n  \"A `run-main` operand node the composition supplies: the harness converts\n   the opaque reference (a request-stream, response-stream or diagnostics\n   reference) to UAST itself — lowering never embeds composition data, and\n   request records never travel as compiled UAST content.\"\n  [value]\n  (u/sexp->uast (or value :php/null)))\n\n\n(def request-node\n  \"The `run-main` second-operand node the composition supplies: the attached\n   request-stream reference (or nil for the empty defaults). The record is\n   consumed from the stream at runtime, never embedded in the program.\"\n  operand-node)\n\n\n(defn lower-through-stage\n  \"`{:ast a :warnings w}` or `{:diagnostics d}` for `pk` through the lowering\n   stage. Warning-severity diagnostics do not stop the program. `request-ref`\n   is the attached request-stream reference the harness composed as\n   `run-main`'s second operand — lowering itself never sees request data, and\n   the record reaches the runtime only through the stream at execution time.\n   With `response-ref`/`diag-ref`, the composition-supplied stream references\n   execution emits on during the run ride as the third and fourth operands.\"\n  ([pk] (lower-through-stage pk nil nil nil))\n  ([pk request-ref] (lower-through-stage pk request-ref nil nil))\n  ([pk request-ref response-ref diag-ref]\n   (let [cst-log (new-memory-log)\n         program (new-memory-log)\n         diagnostics (new-memory-log)]\n     (stream/append! cst-log pk)\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                         (cond-> {:medium lower/program-medium}\n                                           (some? request-ref) (assoc :request-node\n                                                                      (operand-node request-ref))\n                                           (some? response-ref) (assoc :response-node\n                                                                       (operand-node response-ref))\n                                           (some? diag-ref) (assoc :diag-node\n                                                                   (operand-node diag-ref)))))\nsrc/cljc/yin/vm.cljc:359:(defn primitive-profile\ntest/yin/vm/stream_poll_test.cljc:26:    {'sneak (vm/primitive-profile 'sneak :effectful [1] #{:stream/next} :none)}))\ntest/yin/vm/module_test.cljc:14:   (vm/primitive-profile sym :effectful arities effects :none)))\n(ns yang.php.antlr.eval-bridge-test\n  (:require [clojure.test :refer [deftest is]]\n            [yang.php.antlr.e2e-harness :as h]))\n\n\n(deftest eval-in-caller-scope-on-every-vm\n  (doseq [[source expected] [[\"<?php echo eval(\\\"return 6 * 7;\\\");\" \"42\"]\n                             [\"<?php $x = 40; echo eval(\\\"return $x + 2;\\\");\" \"42\"]]]\n    (let [results (h/run-php source)]\n      (doseq [backend [:ast-walker :semantic :stack :register]]\n        (is (= expected (get results backend)) (pr-str [backend source results]))))))\n3859:(def option-keys\n4145:                  (lower-program packet (select-keys state option-keys))]\n4148:   :option-keys option-keys})\n4151:(defn lower-transform\n","exit_code":0,"status":"completed"}}
