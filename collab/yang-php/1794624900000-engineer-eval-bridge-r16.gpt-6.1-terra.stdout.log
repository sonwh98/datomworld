ast))))))\n\n\n(defn- attach-lifecycle-streams\n  \"The AST walker VM with the composition-supplied `request-stream`,\n   `response-stream` and `diagnostics-stream` handles attached under its\n   capability secret, answering `[vm request-ref response-ref diag-ref]`\n   (a nil request keeps the empty defaults and composes no reference): the\n   sealed references the program consumes and emits on DURING execution.\"\n  [request response-stream diagnostics-stream]\n  (let [vm (create-vm {:modules (host-registry)})\n        [request-ref vm] (if (some? request)\n                           (attach-request-stream vm request)\n87:(defn create-vm\n115:(defn make-observer-session\n126:(defn queue-ast!\n199:(defn run-session\n               (u/then prelude/uast main))),\n      :warnings @(:warnings ctx)})))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n;; =============================================================================\n\n(def module-exports\n  \"The exports of a compiled PHP unit: its spec and body, immutable after\n   install.\"\n  '#{spec body})\n\n\n(defn imported-unit-names\n  \"The normalized paths the unit statically includes through folded literal\n   paths, source order, distinct, the unit's own path aside. A computed path\n   contributes nothing: it is by name at run time (plan P6 R3). A path that\n   cannot normalize is refused as `lower-include` refuses it.\"\n  [packet {:keys [path], :or {path entry-path}}]\n  (let [ctx (context packet {:path path, :linked? true})]\n    (letfn [(edges\n              [n]\n              (let [ks (core/kids ctx n)\n                    k0 (first ks)]\n     (into outputs\n           (map (fn [w] [:diagnostics (assoc w