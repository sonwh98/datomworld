{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1630,1675p;3640,3715p;3870,3935p' src/cljc/yang/php/antlr/lower.cljc; sed -n '465,495p' src/cljc/yin/vm/module.cljc; rg -n 'defn.*uast|host-names|require.*stream' src/cljc/yang/php/antlr/prelude.cljc | tail -25; rg -n '%.*loop|ticks-profile' src/cljc/yang/php/antlr/safepoint.cljc\"","aggregated_output":"                          pos\n                          (if (and chain (chain-location ctx chain))\n                            (ref-source ctx a chain)\n                            (lower ctx e)))\n                    named]))))\n           [(u/lit []) []]\n           (map-indexed vector items))]\n     [pos (when (seq named) (args-vector named))])))\n\n\n(defn- call-node\n  \"Call function cell node `f` with the arguments of `arguments`.\"\n  [ctx f arguments refs]\n  (let [[pos named] (lower-arguments ctx arguments refs)]\n    (core/site :call\n               (if (seq refs)\n                 (app* 'php/call-with-binding-profile\n                       f pos (or named (u/lit []))\n                       (u/lit \"sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb\"))\n                 (if named\n                   (app* 'php/call-named f pos named)\n                   (app* 'php/call f pos))))))\n\n\n(defn- argument-chains\n  \"The `chain` of each argument of `arguments`, for the language constructs\n   that take variables (`isset`, `empty`, `unset`).\"\n  [ctx n args]\n  (mapv (fn [a]\n          (let [ks (core/kids ctx a)\n                e (first ks)\n                c (when (and (= 1 (count ks)) (p/rule? e \"expression\"))\n                    (first (core/rules ctx e \"chain\")))]\n            (or c (unsupported! n :argument-form))))\n        (core/rules ctx args \"actualArgument\")))\n\n\n(defn- function-name\n  \"`{:lc :written :fallback-lc :fallback}` for a call's `functionCallName`:\n   the lower-cased fully qualified name and the name as written, plus the\n   global name an unqualified call inside a namespace falls back to.\"\n  [ctx n]\n  (let [ks (core/kids ctx n)\n        q (first ks)]\n    (when-not (and (= 1 (count ks)) (p/rule? q \"qualifiedNamespaceName\"))\n      (unsupported! n :dynamic-call))\n    \"constant\" (lower-constant ctx n)\n    \"arrayCreation\" (lower-array ctx n)\n    (\"classDeclaration\" \"enumDeclaration\") (lower-class ctx n)\n    \"declareStatement\" (let [outer-ticks @(:ticks ctx)\n                             body (first (core/rules ctx n \"statement\"))\n                             semicolon? (and body (p/rule? (first (core/rule-kids ctx body)) \"emptyStatement_\"))\n                             zero? (some (fn [d]\n                                           (and (some #(and (p/token? %) (= \"ticks\" (str/lower-case (:text %))))\n                                                      (core/kids ctx d))\n                                                (= \"0\" (leftmost-token-text ctx (first (core/rules ctx d \"numericConstant\"))))))\n                                         (mapcat #(core/rules ctx % \"directive\") (core/rules ctx n \"declareList\")))\n                             node (lower-declare ctx n)\n                             threshold (if semicolon? @(:ticks ctx) outer-ticks)]\n                         (if (and (pos? threshold) (or semicolon? (and body zero?)))\n                           (core/site [:line (:id n) {:unit (get-in ctx [:unit :path]), :ticks threshold}] node)\n                           node))\n    (core/default-arm diagnostic-ns \"PHP\" unsupported-rules n)))\n\n\n;; =============================================================================\n;; Packets\n;; =============================================================================\n\n(defn- hoisted?\n  \"True for a top-level statement that is an unconditional function\n   declaration: PHP declares it before the unit's first statement runs.\"\n  [ctx item]\n  (p/rule? (rule-head ctx item) \"functionDeclaration\"))\n\n\n(defn- declared-functions\n  \"Every function the unit declares: lower-cased fully qualified name to the\n   vector of its by-reference parameter positions.\"\n  [ctx]\n  (letfn [(refs\n            [n]\n            (let [fps (core/rules ctx (first (core/rules ctx n \"formalParameterList\"))\n                                  \"formalParameter\")]\n              (vec (keep-indexed (fn [i fp] (when (some #(p/token? % \"&\") (core/kids ctx fp)) i))\n                                 fps))))\n          (walk\n            [ictx n]\n            (into (if (p/rule? n \"functionDeclaration\")\n                    {(str/lower-case (ns-prefixed ictx (function-written ctx n))) (refs n)}\n                    {})\n                  (mapcat #(walk ictx %))\n                  (core/rule-kids ctx n)))]\n    (into {} (mapcat #(walk (item-ctx ctx %) %)) (:items ctx))))\n\n\n(def entry-path\n  \"The entry unit's declared path when the composition names none.\"\n  \"main.php\")\n\n\n(defn- context\n  ([packet] (context packet {}))\n  ([packet {:keys [path linked?], :or {path entry-path}}]\n   (let [pk (p/validate! packet {:diagnostic-ns diagnostic-ns})\n         ctx {:pk pk,\n              :analysis (scope/analyze pk),\n              :loops [],\n              :unit {:path path},\n              :linked? (boolean linked?),\n              :warnings (atom []),\n              :ticks (atom 0)}\n         ctx (merge ctx (unit-layout ctx))]\n     (assoc ctx :declared (declared-functions ctx)))))\n\n\n(defn- check-hoisted!\n  \"A top-level function declared twice, or over a builtin, is a compile\n   error.\"\n  [ctx hoisted]\n  (reduce (fn [seen item]\n            (let [f (rule-head ctx item)\n   paths (plan P6 R3): the computed include's lookup table.\"\n  [paths]\n  (app* 'php/bind-path-map!\n        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\n                (u/lit {})\n                (sort paths))))\n\n\n(defn lower-program\n  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n   `php/run-main` after the prelude, tail calls marked. Its value is\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n   `:warnings` are the lowering's warning-severity diagnostics\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\n   `:yang.php/computed-include-path`).\n\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\n   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\n   need); `:path` the entry unit's declared path (default `entry-path`);\n   `:paths` the normalized paths whose units the composition published,\n   which a computed include resolves against; `:class-map` true requires\n   the published `phpm.$classmap` and binds its classes and delivery thunks\n   (plan P6 R9), which takes the place of `:paths`; `:request-node` is the\n  opaque `run-main` second-operand node the harness composed from the\n  attached request stream (lowering never embeds request data — `run-main`\n  consumes the record from the stream at runtime);\n  `:response-node` and `:diag-node` are the opaque third and fourth\n  operands: the composition-supplied stream references execution emits\n  on. Absent, `run-main` runs with two operands and the cells\n  accumulate.\"\n  ([packet] (lower-program packet {}))\n  ([packet {:keys [prelude paths path class-map request-node response-node diag-node],\n            :or {prelude :bundled}}]\n   (when-not (contains? #{:bundled :linked} prelude)\n     (throw (ex-info \"unknown PHP prelude profile\"\n                     {:yang.php/diagnostic :yang.php/unsupported,\n                      :construct :prelude,\n                      :prelude prelude})))\n   (let [linked? (= :linked prelude)\n         request-node (or request-node (u/sexp->uast :php/null))\n         ctx (context packet {:path (or path entry-path), :linked? linked?})\n         ;; `run-main`'s second operand arrives composed by the harness from\n         ;; the attached request stream: production initialization consumes\n         ;; the record from the stream at runtime and seeds the superglobals,\n         ;; no postwalk rewrite and no request data through lowering involved.\n         ;; With stream nodes `run-main` takes four operands (request,\n         ;; response and diagnostics references); without them it takes two\n         ;; and the cells accumulate.\n         main (if (or response-node diag-node)\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\n                      (or response-node (u/sexp->uast :php/null))\n                      (or diag-node (u/sexp->uast :php/null)))\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))]\n     {:ast (u/mark-tails\n             (if linked?\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\n                                     (app* 'require (u/lit prelude/module-name))\n                                     (app* 'php/init!)]\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\n                                    (when class-map\n                                      [(app* 'require (u/lit classmap-module))\n                                       (app* 'php/bind-class-map!\n                                             (u/v (symbol (str classmap-module) \"classes\"))\n                                             (u/v (symbol (str classmap-module) \"paths\")))])\n                                    [main]))\n               (u/then prelude/uast main))),\n  (register-host-module registry 'cell cell-module cell-profiles))\n\n\n;; =============================================================================\n;; Built-in effect handlers\n;; =============================================================================\n\n;; =============================================================================\n;; `require` lowers to the linker (yin.vm.linker.md section 7)\n;; =============================================================================\n\n(defprotocol IModuleKernel\n  \"What a kernel supplies the install child and the `linked` transition\n   (yin.vm.linker.md section 7.3). Every method is a pure function of a\n   VM value; the engine owns the phases, the kernel owns its coordinates.\"\n\n  (link-format\n    [vm]\n    \"`{:format kw :contract s}`: the format this kernel links, and the\n     execution contract it runs.\")\n\n  (spawn-module\n    [vm image opts]\n    \"A fresh VM of this backend with the verified `image` loaded by the\n     ordinary loader, holding nothing of `vm`'s state but its composition\n     values (primitives, stream constructor, link pair). `opts` carries\n     `:modules` (the child's module view), `:origin`, and `:ancestry`.\")\n\n  (image-identity\n    [vm image]\n    \"The identity this kernel's code space names `image` by: H, R, the\n77:   Host names the prelude depends on and does not define: `host-names`.\"\n92:(def host-names\n110:        call/host-names))\n6206:(defn- definitions->uast\n6363:  \"Return `registry` when it supplies every one of `host-names`, else refuse\n6367:  (core/admit registry host-names\n14:(def ticks-profile\n","exit_code":0,"status":"completed"}}
