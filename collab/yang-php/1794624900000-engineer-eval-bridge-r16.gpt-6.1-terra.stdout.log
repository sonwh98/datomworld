m/cursor second-read)))]\ntest/yang/php/antlr/eval_service_test.clj:94:        response-cursor (:dao.stream/cursor (stream/cursor responses stream/anchor-oldest))\ntest/yang/php/antlr/eval_service_test.clj:96:        _ (stream/append! requests (assoc fixture/request :yang.php/source \"while (false) {} return 1;\"))\ntest/yang/php/antlr/eval_service_test.clj:98:        result (:dao.stream/value (stream/next responses response-cursor))\ntest/yang/php/antlr/eval_service_test.clj:108:        program (u/seq-nodes [(u/app (u/v 'require) (u/lit 'code))\ntest/yang/php/antlr/eval_service_test.clj:109:                              (u/app (u/v 'require) (u/lit name))\ntest/yang/php/antlr/generators_test.clj:48:  {:make-stream tu/make-stream\ntest/yang/php/antlr/portable_harness.cljc:53:     (merge {:make-stream (fn [capacity] (make-stream capacity)),\ntest/yang/php/antlr/portable_harness.cljc:68:  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\ntest/yang/php/antlr/portable_harness.cljc:69:                      [:dao.stream/cursor])]\ntest/yang/php/antlr/portable_harness.cljc:71:      (let [result (stream/next handle cursor)]\ntest/yang/php/antlr/portable_harness.cljc:73:          (recur (:dao.stream/cursor result)\ntest/yang/php/antlr/portable_harness.cljc:182:     (stream/append! cst-log pk)\ntest/yang/php/antlr/portable_harness.cljc:206:    (check-ok! (stream/append! request-stream request) \"request append\")\nsrc/cljc/yang/php/antlr/prelude.cljc:109:           stream/put! stream/cursor stream/poll!}\nsrc/cljc/yang/php/antlr/prelude.cljc:502:           (let [v (stream/poll! (stream/cursor request))]\nsrc/cljc/yang/php/antlr/prelude.cljc:526:       (php/drain-loop (stream/cursor ref) []))]\nsrc/cljc/yang/php/antlr/lower.cljc:4118:        require-profile (vm/profile-of vm/primitives 'require)]\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:126:                      (let [item (stream/next (:requests state) (:cursor state))]\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:128:                          {:cursor (:dao.stream/cursor item)\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:131:           (let [written (stream/append! (:responses state) (:answer read))]\nsrc/cljc/yang/php/antlr/prelude_module.cljc:39:           (if (= kind :require) \"require\" \"require_once\"))))]\nsrc/cljc/yang/php/antlr/prelude_module.cljc:41:     (fn [kind] (if (= kind :require) true (= kind :require-once)))]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' src/cljc/yin/vm/module.cljc; rg -n 'register-host-module|register-effect-handler|make-effect|:blocked\\\\?' src/cljc/yin/vm/module.cljc | head -60; sed -n '120,230p' src/cljc/yin/vm/linker/pair.cljc; sed -n '1,110p' test/yang/php/antlr/portable_harness.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' src/cljc/yin/vm/module.cljc; rg -n 'register-host-module|register-effect-handler|make-effect|:blocked\\\\?' src/cljc/yin/vm/module.cljc | head -60; sed -n '120,230p' src/cljc/yin/vm/linker/pair.cljc; sed -n '1,110p' test/yang/php/antlr/portable_harness.cljc\"","aggregated_output":"(ns yin.vm.module\n  \"Module system for Yin VM v2.\n\n   The v1 module system kept two `defonce` atoms and mutated them at load\n   time. A registry is a value here: an ordinary map carried in VM state and\n   supplied by the composition that wires the VM.\n\n     (-> (empty-registry)\n         (register-host-module 'my.lib {'foo (fn [x] x)} profiles)\n         (register-stream-module))\n\n   Nothing in this namespace runs at load time, and nothing registers itself.\n   A composition that wants Yin source to reach `(stream/...)` registers the\n   stream module explicitly and supplies `:make-stream` beside it.\"\n  (:require\n    [clojure.string :as str]\n    [dao.jing :as jing]\n    [dao.stream :as stream]\n    [yin.vm :as vm]\n    [yin.vm.effect :as effect]))\n\n\n;; =============================================================================\n;; Registry values\n;; =============================================================================\n\n(defn empty-registry\n  \"An empty module registry value.\"\n  []\n  {:modules {}, :effect-handlers {}})\n\n\n(defn- symbol->path\n  \"Split a dotted symbol into a get-in path of symbols.\n   'yin.io.file-input-stream → ['yin 'io 'file-input-stream]\"\n  [sym]\n  (mapv symbol (str/split (str sym) #\"\\.\")))\n\n\n(defn- walk-path\n  \"Descend a registry's :modules map along path, a sequence of symbols.\n\n   Namespace segments step through plain maps until the path reaches a\n   module entry (a map carrying :manifest); the remaining segments read\n   that entry's task-local lowered `:bindings` when it holds them -- a\n   linked module (yin.vm.linker.md section 8.3) -- and its `:slice`\n   otherwise, which for a host module is the host values themselves, so\n   a binding name resolves to its export.\"\n  [node path]\n  (if (seq path)\n    (if (and (map? node) (contains? node :manifest))\n      (if-let [child (get node (first path))]\n        (walk-path child (rest path))\n        (get-in node (into [(if (contains? node :bindings) :bindings :slice)]\n                           path)))\n      (when-let [child (get node (first path))]\n        (walk-path child (rest path))))\n    node))\n\n\n(defn module-entry\n  \"The registry entry of module `module-name` in `modules` (a registry's\n   `:modules` map), or nil when the dotted path reaches no module entry.\"\n  [modules module-name]\n  (let [node (reduce (fn [node seg] (when (map? node) (get node seg)))\n                     modules\n                     (symbol->path module-name))]\n    (when (and (map? node) (contains? node :manifest)) node)))\n\n\n(defn assoc-module\n  \"Return registry with `entry` installed as module `module-name`.\"\n  [registry module-name entry]\n  (let [registry (or registry (empty-registry))\n        path (into [:modules] (symbol->path module-name))\n        children (into {} (filter (comp symbol? key)) (get-in registry path))]\n    (assoc-in registry path (merge children entry))))\n\n\n(defn link-module\n  \"The `linked` transition's registry update (yin.vm.linker.md sections\n   7.3 and 8.3): `registry` gains the module `manifest` names as the\n   portable encoding of acts 1 to 3 -- `{:manifest m :address a\n   :derivation d :slice {sym encoded} :stores {address snapshot} :cells\n   {cell-id cell} :images {identity image}}` -- never lowered values. `a`\n   is the manifest's own address; `lifted` is the act-1 lift, `{:slice\n   :stores :cells :images}`, the cells being the logical cursor cells its\n   references name (r9) and the images the verified origin images a\n   receiving task attaches.\n   Each receiving task lowers the entry into its own `:bindings`.\"\n  [registry manifest derivation lifted]\n  (assoc-module registry\n                (:yin.module/name manifest)\n                {:manifest manifest,\n                 :address (jing/segment-key manifest),\n                 :derivation derivation,\n                 :slice (:slice lifted),\n                 :stores (:stores lifted),\n                 :cells (:cells lifted),\n                 :images (:images lifted)}))\n\n\n(defn module-entries\n  \"Every `[name entry]` a registry value holds, the module name read back\n   from each entry's manifest.\"\n  [registry]\n  (letfn [(walk\n            [node]\n            (when (map? node)\n              (if (contains? node :manifest)\n                (cons [(:yin.module/name (:manifest node)) node]\n                      (mapcat (comp walk val) (filter (comp symbol? key) node)))\n                (mapcat walk (vals node)))))]\n    (vec (walk (:modules registry)))))\n\n\n(defn pin-conflict\n  \"The deterministic refusal when receiving `entry` as `module-name`\n   would disagree with a linked manifest's dependency pin. Missing\n   dependencies are permitted; pins are derived from registry manifests.\"\n  [registry module-name entry]\n  (let [linked (filter (fn [[_ e]] (some? (:address e)))\n                       (module-entries registry))\n        existing (keep (fn [[owner e]]\n                         (let [requires (:yin.module/requires (:manifest e))]\n                           (when (and (contains? requires module-name)\n                                      (not= (get requires module-name)\n                                            (:address entry)))\n                             [module-name owner (get requires module-name)\n                              (:address entry)])))\n                       linked)\n        incoming (keep (fn [[name pinned]]\n                         (when-let [held (module-entry (:modules registry) name)]\n                           (when (not= pinned (:address held))\n                             [name module-name pinned (:address held)])))\n                       (:yin.module/requires (:manifest entry)))\n        conflict (first (sort-by (fn [[name owner pinned address]]\n                                   [(str name) (str owner) (str pinned) (str address)])\n                                 (concat existing incoming)))]\n    (when-let [[name _ pinned address] conflict]\n      {:status :refused,\n       :reason :dependency-pin-mismatch,\n       :module module-name,\n       :name name,\n       :pinned pinned,\n       :linked address})))\n\n\n(defn resolve-module\n  \"Get a value from a registry value by dotted symbol path.\n   (resolve-module r 'io)                    → the 'io registry entry\n   (resolve-module r 'io.file-output-stream) → the specific export\"\n  [registry sym]\n  (walk-path (:modules registry) (symbol->path sym)))\n\n\n(defn register-effect-handler\n  \"Return registry with handler-fn installed for effect keyword kw.\n   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\"\n  [registry kw handler-fn]\n  (assoc-in (or registry (empty-registry)) [:effect-handlers kw] handler-fn))\n\n\n(defn get-effect-handler\n  \"Get the handler function for an effect keyword.\"\n  [registry kw]\n  (get (:effect-handlers registry) kw))\n\n\n(defn list-modules\n  \"List the top-level module names in a registry value.\"\n  [registry]\n  (keys (:modules registry)))\n\n\n;; =============================================================================\n;; Host modules\n;; =============================================================================\n;;\n;; A host module is the trusted composition boundary (yin.vm.linker.md\n9:         (register-host-module 'my.lib {'foo (fn [x] x)} profiles)\n157:(defn register-effect-handler\n159:   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\"\n227:(defn register-host-module\n237:   effect minted by `make-effect` for the engine to interpret and\n273:   host-registered entry (`register-host-module`'s shape, `:address`\n291:;; type test, and a map is data whatever keys it carries. `make-effect` is\n296:  \"True when a value is an effect minted by `make-effect`.\"\n300:(def make-effect\n301:  \"Mint an effect: `(make-effect kind)` or `(make-effect kind params-map)`.\"\n317:  ([cap] (make-effect :stream/make {:capacity cap})))\n322:  (make-effect :stream/put {:stream s, :val v}))\n327:  (make-effect :stream/cursor {:stream s}))\n332:  (make-effect :stream/next {:cursor c}))\n340:  (make-effect :stream/poll {:cursor c}))\n345:  (make-effect :stream/close {:stream s}))\n375:  (register-host-module registry 'stream stream-module stream-profiles))\n394:  (make-effect :cell/new {:val v}))\n399:  (make-effect :cell/get {:cell c}))\n404:  (make-effect :cell/set! {:cell c, :val v}))\n414:  (make-effect :cell/authentic? {:cell c}))\n424:  (make-effect :cell/new-provenance {:val value, :provenance provenance}))\n434:  (make-effect :cell/provenance {:cell candidate}))\n465:  (register-host-module registry 'cell cell-module cell-profiles))\n567:                     :blocked? true\n570:   :blocked? true})\n639:       :state state, :blocked? false}\n647:           :state state, :blocked? false}\n713:    {:state state, :blocked? false\n722:  (make-effect :code/entry {:module module :address address :export export}))\n728:  (register-host-module registry 'code {'entry code-entry}\n737:      (register-effect-handler :module/require require-handler)\n738:      (register-effect-handler :module/try-require try-require-handler)\n739:      (register-effect-handler :code/entry code-entry-handler)))\n  \"The link pair of one session (section 6.1): the request and response\n   media, `capacity` elements each (`pair-capacity` by default), and the\n   interpreter's own request cursor, minted before any request exists.\"\n  ([] (make-pair pair-capacity))\n  ([capacity]\n   (let [requests (medium capacity)\n         responses (medium capacity)]\n     {:requests requests\n      :responses responses\n      :cursor (:dao.stream/cursor\n                (stream/cursor requests stream/anchor-oldest))})))\n\n\n(defn composition\n  \"The content side of the shell's link composition, from the host's\n   creation options.  `content-store` is a `dao.jing` byte-store handle\n   served in process over its own ring-buffer content pair (the\n   single-process and durable-local rows of section 6.1);\n   `content-client` is the linker's content-pair client map\n   `{:requests w :answers r :cursor c}` on a connection whose far end\n   serves content (the remote-content row), and the drive then only\n   steps the linker, the server running elsewhere (section 6.4).  A\n   content source is optional: with none, every link stays `:pending`\n   and says so.  Supplying both is a composition defect.  `dht?` is the\n   signed-name link source (yin.vm.linker.dht.md 4.1): it reads content\n   from the node each serve round is handed, holds nothing here, and is\n   refused together with either content source.  This namespace builds\n   its record and serves it not; its composition does\n   (`yin.vm.linker.interpreter`).\n\n   `principals` are the public keys (64 lowercase hex) whose signed name\n   assertions the reader honors (yin.vm.linker.dht.md 7.1), and `key`\n   the node's own publisher key, whose principal is declared too (6.5):\n   a node resolves the names it published.  Only the public half is\n   kept here.  `follow` are the principal ids (`ed25519:<hex>`) whose\n   published heads the signed-name source follows\n   (yin.vm.linker.dht.head.md 5.6): a name that is `:absent` while one of\n   them has no installed head is pending on it, not refused.\n\n   `derivation` is the composition's derivation policy (section 8.1) for\n   the manifest links it serves from a content source: `:verifying`, the\n   default, or `:trusted`, which only a composition that is its own\n   publisher asks for. The response names the trust it applied.\n\n   `admission`, optional, is the policy of the in-process admission\n   interpreter (yin.vm.linker.dht.md 7.5,\n   `yin.vm.linker.admission/policy`):\n   `{:trusted #{principal} :verify f :decision d :decision-medium m}`,\n   the key's own principal joining it as `:own`.  Without it no\n   interpreter runs in process: the questions a signed-name source asks\n   are answered elsewhere or not at all. `:holder` is the context\n   subject, a principal id or a token understood by verify; it defaults\n   to the own key's principal.\n\n   `stage`, optional, is the link-time stage (yang.antlr.md 8.5.2)\n   applied at delivery: `(stage ctx name address)` answers `{:status :ok\n   :address a' ...}` (`a'` may equal `address`), `{:status :refused\n   ...}` or `{:status :missing :address a}`, an address the store does not\n   hold: the stage reports the first it meets and stops, and never\n   fetches.  A signed-name source fetches what is reported missing (a\n   staged load, `yin.vm.linker.dht/load-stage`) and runs the stage again;\n   a local content store fails closed, refused `:absent`.  `ctx` is plain\n   data, `{:store handle :datoms [...] :principals [...]}`: the store the\n   stage may write its output into, the index datoms the source has\n   loaded (none for a name-env source), and the declared principals'\n   public keys.  The interpreter applies it after resolution and trust\n   admission and before the attempt, links `a'` in place of `address`\n   under the same derivation policy, pin checks and profile checks (a\n   stage never relaxes them), and never interprets what the stage did.  A\n   substituted `:ok` response names the resolved address under\n   `:yin.link/canonical` and the stage's `:derivation`, if any, under\n   `:yin.link/derivation`; a refusal is the stage's, with `:name` and\n   `:yin.link/canonical`.  Its reasons are the composition's, as the\n   admission interpreter's are.  Refused with `content-client`.\"\n  [{:keys [name-env content-store content-client dht? principals key\n           follow derivation admission stage] :as opts}]\n  (when (and content-store content-client)\n    (throw (ex-info \"content-store and content-client are exclusive\"\n                    {:content-store content-store})))\n  (when (and stage content-client)\n    (throw (ex-info (str \"a stage writes its output into a local store: \"\n                         \"content-client is refused with it\")\n                    {:stage stage})))\n  (when (and dht? (or content-store content-client))\n    (throw (ex-info (str \"a dht:<dir> index store is the link source; \"\n                         \"content-store and content-client are refused with it\")\n                    {:dht? dht?})))\n  {:name-env (or name-env {})\n   :principals (vec (distinct (cond-> (vec principals)\n                                key (conj (:public key)))))\n   :holder (:yin.admit/subject (admission/context\n                                 (select-keys opts [:key :holder])))\n   :own (when key #{(sign/principal (:public key))})\n   :follow (vec follow)\n   :stage stage\n   :derivation (or derivation :verifying)\n   :admission (when admission\n                (admission/policy\n                  (assoc admission\n                         :own (when key #{(sign/principal (:public key))}))))\n   :content (cond\n              dht? {:kind :dht}\n\n              content-store\n              {:kind :local\n               :store content-store\n               :requests (medium content-capacity)\n               :responses (medium content-capacity)}\n\n              content-client\n              {:kind :remote, :client content-client}\n(ns yang.php.antlr.portable-harness\n  \"What the JVM, Node and Dart lanes share: the host composition the PHP\n   profile runs over, the `packet` helper that builds a CST packet from a\n   nested form, and a parserless run of a packet on the AST walker.\"\n  (:require\n    [dao.stream :as stream]\n    [dao.stream.memory-log :as memory-log]\n    [dao.stream.ringbuffer :as ringbuffer]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.prelude :as prelude]\n    [yin.vm :as vm]\n    [yin.vm.ast-walker :as ast-walker]\n    [yin.vm.engine :as engine]\n    [yin.vm.data :as data]\n    [yin.vm.integer :as integer]\n    [yin.vm.module :as module]))\n\n\n(def ^:private capability-secret \"yin.vm.test-utils/capability-secret\")\n\n\n(defn make-stream\n  \"The composition's stream constructor: a deterministic ring buffer, answering\n   the create outcome the engine consumes. The lifecycle streams below come\n   from this same constructor, so request consumption and response/diagnostic\n   emission travel composition-supplied streams rather than vectors.\"\n  ([] (make-stream nil))\n  ([capacity]\n   (ringbuffer/create!\n     {:dao.stream/type ringbuffer/transport-type,\n      ringbuffer/capacity-key (or capacity vm/default-stream-capacity)})))\n\n\n(defn- check-ok!\n  [result what]\n  (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n    (throw (ex-info (str \"PHP lifecycle stream failed: \" what) {:result result})))\n  result)\n\n\n(defn- lifecycle-stream\n  \"One open lifecycle stream handle from the composition's own constructor.\"\n  [what]\n  (:dao.stream/handle (check-ok! (make-stream) what)))\n\n\n(defn create-vm\n  \"An AST walker composed with the harness's deterministic ring-buffer stream.\"\n  ([] (create-vm {}))\n  ([opts]\n   (ast-walker/create-vm\n     (merge {:make-stream (fn [capacity] (make-stream capacity)),\n             :capability-secret capability-secret}\n            opts))))\n\n\n(defn- new-memory-log\n  []\n  (let [result (memory-log/create! {:dao.stream/type memory-log/transport-type})]\n    (if (= :dao.stream/ok (:dao.stream/outcome result))\n      (:dao.stream/handle result)\n      (throw (ex-info \"PHP harness memory-log creation failed\" {:result result})))))\n\n\n(defn- drain\n  [handle]\n  (let [start (get-in (stream/cursor handle stream/anchor-oldest)\n                      [:dao.stream/cursor])]\n    (loop [cursor start, acc []]\n      (let [result (stream/next handle cursor)]\n        (if (= :dao.stream/ok (:dao.stream/outcome result))\n          (recur (:dao.stream/cursor result)\n                 (conj acc (:dao.stream/value result)))\n          acc)))))\n\n\n(def integer-limits\n  \"The `integer` limits the PHP compositions here install.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(def data-limits {::data/max-items 1048576})\n\n\n(defn host-registry\n  \"The registry with the cell, data, integer and stream modules installed,\n   admitted by the PHP profile. The stream module is what lets execution\n   emit response and diagnostic records on composition-supplied streams\n   during the run.\"\n  []\n  (-> (module/empty-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      module/register-stream-module\n      prelude/admit))\n\n\n(defn linked-registry\n  \"`host-registry` over the default registry, whose `require` handlers the\n   linked profile needs.\"\n  []\n  (-> (module/default-registry)\n      module/register-cell-module\n      (data/register-data-module data-limits)\n      (prelude/register-integer-module integer-limits)\n      module/register-stream-module\n      prelude/admit))\n\n","exit_code":0,"status":"completed"}}
