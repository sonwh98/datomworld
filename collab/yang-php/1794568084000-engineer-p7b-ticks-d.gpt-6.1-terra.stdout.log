    [php/bi-sort (fn [args] (php/do-sort \"sort\" args 1 false 1))]\n    [php/bi-rsort (fn [args] (php/do-sort \"rsort\" args 1 false -1))]\n    [php/bi-asort (fn [args] (php/do-sort \"asort\" args 1 true 1))]\n    [php/bi-arsort (fn [args] (php/do-sort \"arsort\" args 1 true -1))]\n    [php/bi-ksort (fn [args] (php/do-sort \"ksort\" args 0 true 1))]\n    [php/bi-krsort (fn [args] (php/do-sort \"krsort\" args 0 true -1))]\n    [php/bi-usort (fn [args] (php/do-usort \"usort\" args 1 false))]\n    [php/bi-uasort (fn [args] (php/do-usort \"uasort\" args 1 true))]\n    [php/bi-uksort (fn [args] (php/do-usort \"uksort\" args 0 true))]\n\n    ;; ---------------------------------------------------------------- unit\n    [php/bi-set-exception-handler\n     (fn [args]\n       (let [old (cell/get php.rt/exception-handler)]\n         (do (cell/set! php.rt/exception-handlers\n                        (php/vconj (cell/get php.rt/exception-handlers) old))\n             (cell/set! php.rt/exception-handler (get args 0))\n             old)))]\n    [php/bi-restore-exception-handler\n     ;; back to the handler in force before the last `set_exception_handler`\n     (fn [args]\n       (let [stack (cell/get php.rt/exception-handlers)\n             n (data/count stack)]\n         (do (if (= n 0)\n               (cell/set! php.rt/exception-handler :php/null)\n               (do (cell/set! php.rt/exception-handler (get stack (- n 1)))\n                   (cell/set! php.rt/exception-handlers (php/args-prefix stack (- n 1) 0 []))))\n             true)))]\n    [php/handle-uncaught\n     ;; the user exception handler takes an uncaught throwable; the script then ends\n     (fn [exc]\n       (let [h (cell/get php.rt/exception-handler)]\n         (if (= exc :php/null)\n           exc\n           (if (= h :php/null)\n             exc\n             (do (cell/set! php.rt/exception-handler :php/null)\n                 (php/try (fn [] (do (php/call-value h (php/vconj [] exc)) :php/null))\n                          (fn [e] e)\n                          (fn [] :php/null)))))))]\n    [php/run-main\n     ;; the unit root: one task consuming one request record from the\n     ;; composition-supplied stream. The request seeds the superglobals here\n     ;; at initialization (not via a test-only rewrite): a nil request keeps\n     ;; the empty defaults. `response-stream` and `diag-stream` are the\n     ;; composition-supplied stream references execution emits response and\n     ;; diagnostic records on DURING the run (:php/null without them, when\n     ;; the cells accumulate instead).\n     ;; The operational fatal escapes past everything through php/root-fatal;\n     ;; exit escapes past handlers and finally blocks through php/root-exit\n     ;; and its status is preserved through shutdown\n     (fn [body request response-stream diag-stream]\n       (do (cell/set! php.rt/out [[]])\n           (cell/set! php.rt/ctx (php/ctx nil 0 0 nil))\n           (cell/set! php.rt/response [])\n           (cell/set! php.rt/response-stream (if (if (nil? response-stream)\n                                                   true\n                                                   (= response-stream :php/null))\n                                               :php/null\n                                               response-stream))\n                    (= v :nan) '(php/nan-const)\n                    (= v :inf) '(php/inf-const)\n                    (and (vector? v) (= :int (first v)))\n                    (if (str/starts-with? (second v) \"-\")\n                      (list 'php/int-lit-radix (second v) 10)\n                      (list 'php/int-lit (second v)))\n                    (and (vector? v) (= :float (first v)))\n                    (list 'php/f (list 'data/float-value (nth v 2)))\n                    :else v)))\n          {}\n          (sort-by key builtins/constants)))\n\n\n(defn- init-form\n  \"`php/init!`'s body: the runtime cells, the builtins, the ready flag, under\n   the uninit guard.\"\n  []\n  (list 'fn []\n        (list 'if (list '= 'php.rt/state :php/uninit)\n              (concat\n                ['do\n                 (define 'php.rt/ctx '(cell/new (php/ctx nil 0 0 nil)))\n                 (define 'php.rt/out '(cell/new [[]]))\n                 (define 'php.rt/request '(cell/new {}))\n                 (define 'php.rt/response '(cell/new []))\n                 (define 'php.rt/headers-sent '(cell/new false))\n                 (define 'php.rt/status '(cell/new 200))\n                 (define 'php.rt/error-handlers '(cell/new []))\n                 (define 'php.rt/globals\n                   '(cell/new (php/empty-array)))\n                 (define 'php.rt/functions '(cell/new {}))\n                 (define 'php.rt/classes (list 'cell/new seed-table))\n                 (define 'php.rt/class-index\n                   (list 'cell/new\n                         (into {} (map (fn [nm] [(str/lower-case nm) nm])) (keys seed-table))))\n                 (define 'php.rt/next-ord '(cell/new 1))\n                 (define 'php.rt/finalizable '(cell/new []))\n                 (define 'php.rt/strict '(cell/new false))\n                 (define 'php.rt/exception-handler '(cell/new :php/null))\n                 (define 'php.rt/exception-handlers '(cell/new []))\n                 (define 'php.rt/class-order '(cell/new []))\n                 (define 'php.rt/shutdown-fns '(cell/new []))\n                 (define 'php.rt/exit-status '(cell/new :php/null))\n                 (define 'php.rt/in-shutdown '(cell/new false))\n                 (define 'php.rt/fatal-escape '(cell/new :php/null))\n                 (define 'php.rt/exit-escape '(cell/new :php/null))\n                 (define 'php.rt/shutdown-escape '(cell/new :php/null))\n                 (define 'php.rt/pending-exc '(cell/new :php/null))\n                 (define 'php.rt/cmp-depth '(cell/new 0))\n                 (define 'php.rt/tmps '(cell/new []))\n                 (define 'php.rt/next-cell '(cell/new 1))\n                 (define 'php.rt/error-handler '(cell/new :php/null))\n                 (define 'php.rt/error-masks '(cell/new []))\n                 (define 'php.rt/error-mask '(cell/new 32767))\n                 ;; E_ALL\n                 (define 'php.rt/error-reporting '(cell/new 32767))\n                 (define 'php.rt/diag '(cell/new []))\n                 (define 'php.rt/response-stream '(cell/new :php/null))\n                 (define 'php.rt/diag-stream '(cell/new :php/null))\n                 (define 'php.rt/included '(cell/new {}))\n                 (define 'php.rt/unit '(cell/new :php/null))\n                 (define 'php.rt/path-map '(cell/new {}))\n                 (define 'php.rt/class-map '(cell/new {}))\n                 (define 'php.rt/autoloaders '(cell/new []))\n                 (define 'php.rt/autoloading '(cell/new {}))\n                 (define 'php.rt/int-max\n                   '(integer/sub (integer/shift-left 1 63) 1))\n                 (define 'php.rt/int-min\n                   '(integer/neg (integer/shift-left 1 63)))\n                 ;; after the integer bounds: the seeds build integers\n                 (define 'php.rt/constants (list 'cell/new (constants-form)))]\n                [(cons 'do\n                       (mapv (fn [[nm sym]] (list 'php/register! nm sym))\n                             builtins))]\n                ;; last, so a failed init never reports ready\n                [(define 'php.rt/state :php/ready) :php/null])\n              :php/null)))\n\n\n(def definitions\n  \"The single definition list, `[store-key form]` in definition order: every\n;; =============================================================================\n;; The module emitter: the same definition list as the linker module `php`\n;; =============================================================================\n\n(def module-name\n  \"The linker module the PHP runtime profile is published as.\"\n  'php)\n\n\n(def runtime-keys\n  \"Every key `php/init!` allocates, the ready flag aside, sorted.\"\n  '[php.rt/class-index php.rt/classes php.rt/cmp-depth php.rt/ctx php.rt/diag php.rt/diag-stream\n    php.rt/error-handler\n    php.rt/error-mask php.rt/error-masks\n    php.rt/class-order php.rt/exception-handler php.rt/exception-handlers php.rt/finalizable php.rt/pending-exc\n    php.rt/shutdown-fns php.rt/exit-status php.rt/in-shutdown php.rt/fatal-escape\n    php.rt/exit-escape php.rt/shutdown-escape php.rt/strict php.rt/included php.rt/path-map php.rt/unit\n    php.rt/autoloaders php.rt/autoloading php.rt/class-map php.rt/constants\n    php.rt/error-reporting php.rt/error-handlers php.rt/functions php.rt/globals php.rt/int-max\n    php.rt/int-min php.rt/next-cell php.rt/next-ord\n    php.rt/out php.rt/request php.rt/response php.rt/response-stream\n    php.rt/headers-sent php.rt/status php.rt/tmps])\n\n\n(defn strip\n  \"`sym` without the module's own namespace `php`; `php.rt/*` stays\n   qualified.\"\n  [sym]\n  (core/strip \"php\" sym))\n\n\n(defn- binder-symbols\n  \"Every symbol a `fn` parameter list or `let` binding vector in `form`\n   binds.\"\n  [form]\n  (cond\n    (and (seq? form) (= 'fn (first form)))\n    (into (set (second form)) (mapcat binder-symbols) (drop 2 form))\n    (and (seq? form) (= 'let (first form)))\n    (into (set (take-nth 2 (second form)))\n          (mapcat binder-symbols)\n          (concat (take-nth 2 (rest (second form))) (drop 2 form)))\n    (coll? form) (into #{} (mapcat binder-symbols) (seq form))\n    :else #{}))\n\n\n(defn- unshadow\n  \"`form` with every local binder named like a module export renamed (`h` to\n   `h%l`): the module emitter strips `php/h` to the bare `h`, which a local\n   `h` would otherwise capture. Globals are qualified before stripping, so\n   every bare occurrence is the local.\"\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn request-node\n  \"The `run-main` second-operand node the composition supplies for `request`:\n   the harness converts the record to UAST itself — lowering never embeds\n   request data.\"\n  [request]\n  (u/sexp->uast (or request :php/null)))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\n  The request record travels the composition path: the harness consumes it\n  (a plain record here) and composes it as `run-main`'s second operand —\n  lowering itself never sees request data.\"\n  ([source] (lower-program source nil))\n  ([source request]\n   (let [cst-log (tu/new-memory-log)\n         program (tu/new-memory-log)\n         diagnostics (tu/new-memory-log)]\n     (stream/append! cst-log (cst/parse-source source))\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                         (cond-> {:medium lower/program-medium}\n                                           (some? request) (assoc :request-node\n                                                                  (request-node request)))))\n     (let [{warnings true, problems false}\n           (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n       (if (seq problems)\n         {:diagnostics problems}\n         (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\n           {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)}))))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n             (catch Exception e [:thrown (ex-message e)]))))))\n\n\n(defn run-raw\n  \"The unit's value on the AST walker, consuming an optional request record\n  through the production