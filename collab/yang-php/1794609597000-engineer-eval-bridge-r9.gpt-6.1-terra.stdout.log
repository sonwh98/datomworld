ntifier = token.getText().substring(3).trim().replace(\\\\\\\\\\\\\\\"'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n\\\\\\\"\\\\n    67\\\\t      \\\\\\\"                    _heredocIdentifier = token.getText().substring(3).trim().replace(\\\\\\\\\\\\\\\"'\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\").replace(\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\");\\\\\\\\n                    _heredocLineStart = false;\\\\\\\\n\\\\\\\"]\\\\n    68\\\\t     [\\\\\\\"                case PhpLexer.HereDocText:\\\\\\\\n                    if (CheckHeredocEnd(token.getText()))\\\\\\\\n                    {\\\\\\\\n                        popMode();\\\\\\\\n\\\\\\\\n                        String heredocIdentifier = GetHeredocIdentifier(token.getText());\\\\\\\\n                        if (token.getText().trim().endsWith(\\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\"))\\\\\\\\n                        {\\\\\\\\n                            token = new CommonToken(PhpLexer.SemiColon, heredocIdentifier + \\\\\\\\\\\\\\\";\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\");\\\\\\\\n                        }\\\\\\\\n                        else\\\\\\\\n                        {\\\\\\\\n                            token = (CommonToken)super.nextToken();\\\\\\\\n                            token.setText(heredocIdentifier + \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n;\\\\\\\\\\\\\\\");\\\\\\\\n                        }\\\\\\\\n                    }\\\\\\\\n                    break;\\\\\\\"\\\\n    69\\\\t      \\\\\\\"                case PhpLexer.HereDocText:\\\\\\\\n                    _heredocLineStart = true;\\\\\\\\n                    break;\\\\\\\"]\\\\n    70\\\\t     [\\\\\\\"    private String GetHeredocIdentifier(String text) {\\\\\\\\n        String trimmedText = text.trim();\\\\\\\\n        boolean semi = (trimmedText.length() > 0) ? (trimmedText.charAt(trimmedText.length() - 1) == ';') : false;\\\\\\\\n        return semi ? trimmedText.substring(0, trimmedText.length() - 1) : trimmedText;\\\\\\\\n    }\\\\\\\\n\\\\\\\\n    private boolean CheckHeredocEnd(String text) {\\\\\\\\n        return GetHeredocIdentifier(text).equals(_heredocIdentifier);\\\\\\\\n    }\\\\\\\\n\\\\\\\"\\\\n    71\\\\t      \\\\\\\"    // At the start of a heredoc line: the closing identifier, after optional\\\\\\\\n    // indentation and before any non-name character (or EOF), is its own\\\\\\\\n    // token; whatever follows it on the line (`;`, `)`, `,`) lexes as PHP.\\\\\\\\n    private Token HeredocEndToken() {\\\\\\\\n        int[] id = _heredocIdentifier.codePoints().toArray();\\\\\\\\n        int p = 1;\\\\\\\\n        while (_input.LA(p) == ' ' || _input.LA(p) == '\\\\\\\\\\\\\\\\t') p++;\\\\\\\\n        for (int k = 0; k < id.length; k++, p++)\\\\\\\\n        {\\\\\\\\n            if (_input.LA(p) != id[k]) return null;\\\\\\\\n        }\\\\\\\\n        int c = _input.LA(p);\\\\\\\\n        if (c == '_' || c >= 0x80 || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))\\\\\\\\n        {\\\\\\\\n            return null;\\\\\\\\n        }\\\\\\\\n        int start = _input.index();\\\\\\\\n        int line = getLine();\\\\\\\\n        int column = getCharPositionInLine();\\\\\\\\n        for (int k = 1; k < p; k++) getInterpreter().consume(_input);\\\\\\\\n        popMode();\\\\\\\\n        return _factory.create(_tokenFactorySourcePair, PhpLexer.HereDocEnd, null, Token.DEFAULT_CHANNEL,\\\\\\\\n                               start, _input.index() - 1, line, column);\\\\\\\\n    }\\\\\\\\n\\\\\\\"]]},\\\\n    72\\\\t   :generated {\\\\\\\"PhpLexer.java\\\\\\\"\\\\n    73\\\\t               \\\\\\\"e90e476819db8457adc365b1027ec7c8e401725403201784c4ec07f6db1c4ec4\\\\\\\",\\\\n    74\\\\t               \\\\\\\"PhpLexerBase.java\\\\\\\"\\\\n    75\\\\t               \\\\\\\"9d719b7c28a361458a0cc55870c2d39034ef34cdd329b175d8c847268e3769ca\\\\\\\",\\\\n    76\\\\t               \\\\\\\"PhpParser.java\\\\\\\"\\\\n    77\\\\t               \\\\\\\"cbbe279f2f03e8ff63d61eed8d051350233abfc9c45d4beacbb9d234343bf121\\\\\\\"}}},\\\\n    78\\\\t ;; yang.php.md section 6 license review\\\\n    79\\\\t :license {\\\\\\\"PhpLexer.g4\\\\\\\" \\\\\\\"MIT (header: Copyright (c) 2015-2019 Ivan Kochurkin, Positive Technologies; (c) 2019 Thierry Marianne); vendored with its notice verbatim\\\\\\\",\\\\n    80\\\\t           \\\\\\\"PhpParser.g4\\\\\\\" \\\\\\\"MIT (header: Copyright (c) 2015-2019 Ivan Kochurkin, Positive Technologies; (c) 2019 Thierry Marianne); vendored with its notice verbatim\\\\\\\",\\\\n    81\\\\t           \\\\\\\"Java/PhpLexerBase.java\\\\\\\" \\\\\\\"MIT (header: Copyright (c) 2015-2019 Ivan Kochurkin, Positive Technologies; (c) 2019 Thierry Marianne); vendored with its notice verbatim\\\\\\\",\\\\n    82\\\\t           \\\\\\\"antlr4-runtime 4.13.2\\\\\\\" \\\\\\\"BSD-3-Clause\\\\\\\"},\\\\n    83\\\\t :redistribution {:vendored-sources [\\\\\\\"antlr/php/PhpLexer.g4\\\\\\\"\\\\n    84\\\\t                                     \\\\\\\"antlr/php/PhpParser.g4\\\\\\\"\\\\n    85\\\\t                                     \\\\\\\"antlr/php/PhpLexerBase.java\\\\\\\"],\\\\n    86\\\\t                  :generated-artifacts :none}}\\\\n    20\\\\t   interpreters and the data they share to find the system.\\\\n    21\\\\t3. **Code and State are Datoms**: Code (Universal AST) and runtime execution state are structured datoms, enabling syntax independence and structural reflection.\\\\n    22\\\\t4. **Everything is a Continuation**: Computation is modeled as serializable, portable continuations that can pause, travel across streams, and resume anywhere.\\\\n    23\\\\t\\\\n    24\\\\t## Non-Negotiable Invariants\\\\n    25\\\\t\\\\n    26\\\\t- Do not introduce hidden global state.\\\\n    27\\\\t- Do not introduce implicit control flow.\\\\n    28\\\\t- Do not introduce callbacks; every callback is an event on a stream.\\\\n    29\\\\t- Do not introduce shared mutable state.\\\\n    30\\\\t- Do not collapse interpretation and execution into the same layer.\\\\n    31\\\\t- Do not assume graphs: graphs must be constructed explicitly from tuples.\\\\n    32\\\\t- Do not lose information (unitarity): streams are append-only and no datom is destroyed, only reinterpreted. The Universal AST is never lost: it is always retrievable wherever code is lowered, by address or by a query over its datoms. Every derived form (semantic vector, native images, indexes) is an interpretation of it and may drop facts only because the AST remains.\\\\n    33\\\\t\\\\n    34\\\\t## Tuples and Datoms\\\\n    35\\\\t\\\\n   125\\\\t- When uncertain, ask at the architectural level, not the implementation level.\\\\n   126\\\\t- Explanations should align with Plan 9 / Datomic / Lisp lineage.\\\\n   127\\\\t- Program store writes go through `engine/store-put`; any other store write\\\\n   128\\\\t  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\\\\n   129\\\\t  detects must be on its allowlist; its docstring states the residual it\\\\n   130\\\\t  leaves to review.\\\\n   131\\\\t\\\\n   132\\\\t### Problem Decomposition\\\\n   133\\\\t\\\\n   134\\\\tIf a problem appears complex:\\\\n   135\\\\t1. Decompose it into streams.\\\\n   136\\\\t2. Identify invariants.\\\\n   137\\\\t3. Restrict degrees of freedom.\\\\n   138\\\\t4. Make causality explicit.\\\\n   139\\\\t5. Let structure emerge from constraints.\\\\n   140\\\\t\\\\n   141\\\\t## Operational & Specialized Guides\\\\n   142\\\\t\\\\n   143\\\\t- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\\\\n   144\\\\t- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\\\\n   145\\\\t- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\\\\n   146\\\\t- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; each orchestrator session has its own append-only log at `orchestrator-logs/<unix-time-stamp>-<brief-orchestrator-descriptive-name>.md` under the repository root.\\\\n   147\\\\t- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg --files test/yang/php/antlr | head -65; rg -n 'source-envelope|execution-budget|safepoint/program|hooks/program|phpsp|derive' test/yang/php src/cljc/yang/php* src/cljc/yin/vm/encoder.cljc; rg -n 'eval|compile|load|stream/(append|read)|program' src/cljc/yin/vm/primitives* src/cljc/yin/vm/module* src/cljc/yin/vm/linker/*.cljc | head -130\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_23\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg --files test/yang/php/antlr | head -65; rg -n 'source-envelope|execution-budget|safepoint/program|hooks/program|phpsp|derive' test/yang/php src/cljc/yang/php* src/cljc/yin/vm/encoder.cljc; rg -n 'eval|compile|load|stream/(append|read)|program' src/cljc/yin/vm/primitives* src/cljc/yin/vm/module* src/cljc/yin/vm/linker/*.cljc | head -130\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"test/yang/php/antlr/scope_test.clj\\\\ntest/yang/php/antlr/builtin_surfaces_test.clj\\\\ntest/yang/php/antlr/linked_harness.cljc\\\\ntest/yang/php/antlr/programs_p3b.cljc\\\\ntest/yang/php/antlr/permutation_oracle_quick.edn\\\\ntest/yang/p