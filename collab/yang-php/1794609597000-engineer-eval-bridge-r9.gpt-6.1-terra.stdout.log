-budget\\\\ntest/yang/php/antlr/e2e_harness.clj:117:                                           (:image (derive/stack-image (projected)))\\\\ntest/yang/php/antlr/e2e_harness.clj:120:                                              (derive/register-image (projected))\\\\ntest/yang/php/antlr/e2e_harness.clj:128:   `:execution-budget` is a count of PHP `:loop` and `:call` safepoints.\\\\\\\"\\\\ntest/yang/php/antlr/phpt_selection.edn:56:   \\\\\\\"Bug #22725 (A derived class can call a parent's protected method that calls a private method)\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:312:   \\\\\\\"Bug #29674 (inherited method doesn't have access to private variables of the derived class)\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:6188:   :title \\\\\\\"GC 033: Crash in GC while run with phpspec\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8152:   \\\\\\\"<?php\\\\\\\\n\\\\\\\\n// This test checks for:\\\\\\\\n// - inherited constructors/destructors are not called automatically\\\\\\\\n// - base classes know about derived properties in constructor/destructor\\\\\\\\n// - base class constructors/destructors know the instantiated class name\\\\\\\\n\\\\\\\\nclass base {\\\\\\\\n    public $name;\\\\\\\\n\\\\\\\\n    function __construct() {\\\\\\\\n        echo __CLASS__ . \\\\\\\\\\\\\\\"::\\\\\\\\\\\\\\\" . __FUNCTION__ . \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n        $this->name = 'base';\\\\\\\\n        print_r($this);\\\\\\\\n    }\\\\\\\\n\\\\\\\\n    function __destruct() {\\\\\\\\n        echo __CLASS__ . \\\\\\\\\\\\\\\"::\\\\\\\\\\\\\\\" . __FUNCTION__ . \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n        print_r($this);\\\\\\\\n    }\\\\\\\\n}\\\\\\\\n\\\\\\\\nclass derived extends base {\\\\\\\\n    public $other;\\\\\\\\n\\\\\\\\n    function __construct() {\\\\\\\\n        $this->name = 'init';\\\\\\\\n        $this->other = 'other';\\\\\\\\n        print_r($this);\\\\\\\\n        parent::__construct();\\\\\\\\n        echo __CLASS__ . \\\\\\\\\\\\\\\"::\\\\\\\\\\\\\\\" . __FUNCTION__ . \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n        $this->name = 'derived';\\\\\\\\n        print_r($this);\\\\\\\\n    }\\\\\\\\n\\\\\\\\n    function __destruct() {\\\\\\\\n        parent::__destruct();\\\\\\\\n        echo __CLASS__ . \\\\\\\\\\\\\\\"::\\\\\\\\\\\\\\\" . __FUNCTION__ . \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n        print_r($this);\\\\\\\\n    }\\\\\\\\n}\\\\\\\\n\\\\\\\\necho \\\\\\\\\\\\\\\"Testing class base\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n$t = new base();\\\\\\\\nunset($t);\\\\\\\\necho \\\\\\\\\\\\\\\"Testing class derived\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n$t = new derived();\\\\\\\\nunset($t);\\\\\\\\n\\\\\\\\necho \\\\\\\\\\\\\\\"Done\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n?>\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8154:   \\\\\\\"ZE2 A derived class can use the inherited constructor/destructor\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8156:   \\\\\\\"Testing class base\\\\\\\\nbase::__construct\\\\\\\\nbase Object\\\\\\\\n(\\\\\\\\n    [name] => base\\\\\\\\n)\\\\\\\\nbase::__destruct\\\\\\\\nbase Object\\\\\\\\n(\\\\\\\\n    [name] => base\\\\\\\\n)\\\\\\\\nTesting class derived\\\\\\\\nderived Object\\\\\\\\n(\\\\\\\\n    [name] => init\\\\\\\\n    [other] => other\\\\\\\\n)\\\\\\\\nbase::__construct\\\\\\\\nderived Object\\\\\\\\n(\\\\\\\\n    [name] => base\\\\\\\\n    [other] => other\\\\\\\\n)\\\\\\\\nderived::__construct\\\\\\\\nderived Object\\\\\\\\n(\\\\\\\\n    [name] => derived\\\\\\\\n    [other] => other\\\\\\\\n)\\\\\\\\nbase::__destruct\\\\\\\\nderived Object\\\\\\\\n(\\\\\\\\n    [name] => derived\\\\\\\\n    [other] => other\\\\\\\\n)\\\\\\\\nderived::__destruct\\\\\\\\nderived Object\\\\\\\\n(\\\\\\\\n    [name] => derived\\\\\\\\n    [other] => other\\\\\\\\n)\\\\\\\\nDone\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8186:   \\\\\\\"<?php\\\\\\\\ninterface constr\\\\\\\\n{\\\\\\\\n    function __construct();\\\\\\\\n}\\\\\\\\n\\\\\\\\nabstract class implem implements constr\\\\\\\\n{\\\\\\\\n}\\\\\\\\n\\\\\\\\nclass derived extends implem\\\\\\\\n{\\\\\\\\n    function __construct($a)\\\\\\\\n    {\\\\\\\\n    }\\\\\\\\n}\\\\\\\\n\\\\\\\\n?>\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8190:   \\\\\\\"Fatal error: Declaration of derived::__construct($a) must be compatible with constr::__construct() in %s on line %d\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8195:   \\\\\\\"<?php\\\\\\\\ninterface constr\\\\\\\\n{\\\\\\\\n    function __construct();\\\\\\\\n}\\\\\\\\n\\\\\\\\nclass implem implements constr\\\\\\\\n{\\\\\\\\n    function __construct()\\\\\\\\n    {\\\\\\\\n    }\\\\\\\\n}\\\\\\\\n\\\\\\\\nclass derived extends implem\\\\\\\\n{\\\\\\\\n    function __construct($a)\\\\\\\\n    {\\\\\\\\n    }\\\\\\\\n}\\\\\\\\n\\\\\\\\n?>\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8199:   \\\\\\\"Fatal error: Declaration of derived::__construct($a) must be compatible with constr::__construct() in %s on line %d\\\\\\\",\\\\ntest/yang/php/antlr/phpt_selection.edn:8242:   \\\\\\\"<?php\\\\\\\\nclass base {\\\\\\\\n   function __construct() {\\\\\\\\n      echo __METHOD__ . \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n   }\\\\\\\\n\\\\\\\\n   function __destruct() {\\\\\\\\n      echo __METHOD__ . \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\";\\\\\\\\n   }\\\\\\\\n}\\\\\\\\n\\\\\\\\nclass derived extends base {\\\\\\\\n}\\\\\\\\n\\\\\\\\n$obj = new derived;\\\\\\\\n\\\\\\\\nunset($obj);\\\\\\\\n\\\\\\\\necho 'Done';\\\\\\\\n?>\\\\\\\",\\\\nzsh:1: no matches found: src/cljc/yin/vm/primitives*\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_24\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/yang/php/antlr/e2e_harness.clj | sed -n '1,190p'; nl -ba test/yang/php/antlr/programs_p9.cljc | head -100; nl -ba test/yang/php/antlr/safepoint_test.clj; rg --files src/cljc/yin | rg '(primitive|registry|module|stream)' | head -45\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_24\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba test/yang/php/antlr/e2e_harness.clj | sed -n '1,190p'; nl -ba test/yang/php/antlr/programs_p9.cljc | head -100; nl -ba test/yang/php/antlr/safepoint_test.clj; rg --files src/cljc/yin | rg '(primitive|registry|module|stream)' | head -45\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"     1\\\\t(ns yang.php.antlr.e2e-harness\\\\n     2\\\\t  \\\\\\\"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\\\\n     3\\\\t   program envelope -> the bundled program on each of the four VMs. Output\\\\n     4\\\\t   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\\\\n     5\\\\t   here at the boundary.\\\\\\\"\\\\n     6\\\\t  (:require\\\\n     7\\\\t    [clojure.walk :as walk]\\\\n     8\\\\t    [dao.host.text :as text]\\\\n     9\\\\t    [dao.stream :as stream]\\\\n    10\\\\t    [yang.php.antlr.cst :as cst]\\\\n    11\\\\t    [yang.php.antlr.lower :as lower]\\\\n    12\\\\t    [yang.php.antlr.portable-harness :as portable]\\\\n    13\\\\t    [yang.php.antlr.safepoint :as hooks]\\\\n    14\\\\t    [yang.core.uast :as u]\\\\n    15\\\\t    [yang.safepoint :as safepoint]\\\\n    16\\\\t    [yin.vm :as vm]\\\\n    17\\\\t    [yin.vm.debruijn.register :as rvm]\\\\n    18\\\\t    [yin.vm.debruijn.stack :as dvm]\\\\n    19\\\\t    [yin.vm.encoder :as encoder]\\\\n    20\\\\t    [yin.vm.semantic :as semantic]\\\\n    21\\\\t    [yin.vm.semantic.derive :as derive]\\\\n    22\\\\t    [yin.vm.semantic.linearize :as sr-linearize]\\\\n    23\\\\t    [yin.vm.test-utils :as tu]))\\\\n    24\\\\t\\\\n    25\\\\t\\\\n    26\\\\t(defn host-registry\\\\n    27\\\\t  \\\\\\\"The registry the PHP compositions run over.\\\\\\\"\\\\n    28\\\\t  []\\\\n    29\\\\t  (portable/host-registry))\\\\n    30\\\\t\\\\n    31\\\\t\\\\n    32\\\\t(def ^:private base-opts\\\\n    33\\\\t  {:make-stream tu/make-stream,\\\\n    34\\\\t   :capability-secret tu/secret,\\\\n    35\\\\t   :primitives vm/primitives})\\\\n    36\\\\t\\\\n    37\\\\t\\\\n    38\\\\t(def ^:private load-semantic\\\\n    39\\\\t  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\\\n    40\\\\t\\\\n    41\\\\t\\\\n    42\\\\t(defn lower-program\\\\n    43\\\\t  \\\\\\\"`{:ast a :warnings w}` for `source` through the lowering stage, or\\\\n    44\\\\t   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\\\\\\\"\\\\n    45\\\\t  [source]\\\\n    46\\\\t  (let [cst-log (tu/new-memory-log)\\\\n    47\\\\t        program (tu/new-memory-log)\\\\n    48\\\\t        diagnostics (tu/new-memory-log)]\\\\n    49\\\\t    (stream/append! cst-log (cst/parse-source source))\\\\n    50\\\\t    (lower/step-stage (lower/open-stage cst-log program diagnostics\\\\n    51\\\\t                                        {:medium lower/program-medium}))\\\\n    52\\\\t    (let [{warnings true, problems false}\\\\n    53\\\\t          (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\\\\n    54\\\\t      (if (seq problems)\\\\n    55\\\\t        {:diagnostics problems}\\\\n    56\\\\t        (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\\\\n    57\\\\t          {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)})))))\\\\n    58\\\\t\\\\n    59\\\\t\\\\n    60\\\\t(defn packet->form\\\\n    61\\\\t  \\\\\\\"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\\\\n    62\\\\t   rule, `[\\\\\\\\\\\\\\\"TYPE\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"text\\\\\\\\\\\\\\\"]` for a token. The inverse of\\\\n    63\\\\t   `portable-harness/packet`.\\\\\\\"\\\\n    64\\\\t  [{:yang.cst/keys [root nodes]}]\\\\n    65\\\\t  (letfn [(form\\\\n    66\\\\t            [id]\\\\n    67\\\\t            (let [{:keys [kind rule type text children]} (nth nodes id)]\\\\n    68\\\\t              (if (= :token kind)\\\\n    69\\\\t                [type text]\\\\n    70\\\\t                (into [(keyword rule)] (map form) children))))]\\\\n    71\\\\t    (form root)))\\\\n    72\\\\t\\\\n    73\\\\t\\\\n    74\\\\t(defn latin1->text\\\\n    75\\\\t  \\\\\\\"The UTF-8 text of the byte carrier `s`.\\\\\\\"\\\\n    76\\\\t  [s]\\\\n    77\\\\t  (text/utf8-decode (.getBytes ^String s \\\\\\\"ISO-8859-1\\\\\\\")))\\\\n    78\\\\t\\\\n    79\\\\t\\\\n    80\\\\t(defn render\\\\n    81\\\\t  \\\\\\\"The text a unit prints: its output, then, for an uncaught error, the\\\\n    82\\\\t   fatal line (no path, plan section 3.9).\\\\\\\"\\\\n    83\\\\t  [{:php/keys [out uncaught fatal]}]\\\\n    84\\\\t  (str (latin1->text out)\\\\n    85\\\\t       (when uncaught\\\\n    86\\\\t         (str \\\\\\\"PHP Fatal error:  Uncaught \\\\\\\" (:class uncaught) \\\\\\\": \\\\\\\" (:message uncaught)))\\\\n    87\\\\t       (when fatal\\\\n    88\\\\t         (str \\\\\\\"PHP Fatal error:  \\\\\\\" fatal))))\\\\n    89\\\\t\\\\n    90\\\\t\\\\n    91\\\\t(defn run-vms\\\\n    92\\\\t  \\\\\\\"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\\\\n    93\\\\t   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\\\\n    94\\\\t   and starts one per-run counter; no option leaves the AST unchanged.\\\\\\\"\\\\n    95\\\\t  ([registry ast] (run-vms registry ast {}))\\\\n    96\\\\t  ([registry ast {:keys [execution-budget envelope]}]\\\\n    97\\\\t   (let [ast (if (some? execution-budget)\\\\n    98\\\\t               (let [projected (encoder/project envelope)\\\\n    99\\\\t                     derived (:envelope (safepoint/derive-envelope\\\\n   100\\\\t                                          projected hooks/profile :test/derived))\\\\n   101\\\\t                     tree (nth (:yin/batch derived) (:yin/root derived))]\\\\n   102\\\\t                 (hooks/program execution-budget\\\\n   103\\\\t                                (vm/semantic-bytecode->ast tree)))\\\\n   104\\\\t               ast)\\\\n   105\\\\t         opts (assoc base-opts :modules registry)\\\\n   106\\\\t         session (tu/make-observer-session (tu/create-vm {:modules registry}))\\\\n   107\\\\t         datoms (vec (vm/ast->datoms ast))\\\\n   108\\\\t         projected #(:vector (sr-linearize/project ast))\\\\n   109\\\\t         attempt (fn [f]\\\\n   110\\\\t                   (try (render (f))\\\\n   111\\\\t                        (catch Exception e [:thrown (ex-message e)])))]\\\\n   112\\\\t     (tu/queue-ast! session ast)\\\\n   113\\\\t     {:ast-walker (attempt #(vm/value (:consumer (tu/run-session session)))),\\\\n   114\\\\t      :semantic (attempt #(vm/value (vm/run (load-semantic (semantic/create-vm opts)\\\\n   115\\\\t                                                           datoms)))),\\\\n   116\\\\t      :stack (attempt #(vm/value (vm/run (dvm/create-vm\\\\n   117\\\\t                                           (:image (derive/stack-image (projected)))\\\\n   118\\\\t                                           (assoc opts :contract vm/stack-contract))))),\\\\n   119\\\\t      :register (attempt #(vm/value (vm/run (rvm/create-vm\\\\n   120\\\\t                                              (derive/register-image (projected))\\\\n   121\\\\t                                              (assoc opts\\\\n   122\\\\t                                                     :contract\\\\n   123\\\\t                                                     vm/register-contract)))))})))\\\\n   124\\\\t\\\\n   125\\\\t\\\\n   126\\\\t(defn run-php\\\\n   127\\\\t  \\\\\\\"`{vm-key rendered}` for `source`, or `{:diagnostics d}`. The optional\\\\n   128\\\\t   `:execution-budget` is a count of PHP `:loop` and `:call`