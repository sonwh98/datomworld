\\\n  (let [file (str (name id) \\\\\\\\\\\\\\\".php\\\\\\\\\\\\\\\")\\\\\\\\n        pre (str (name id) \\\\\\\\\\\\\\\"-pre.php\\\\\\\\\\\\\\\")]\\\\\\\\n    (write-source! dir file source)\\\\\\\\n    (when request (write-source! dir pre (p5-prologue request)))\\\\\\\\n    (let [actual (if request\\\\\\\\n                   (run-php-file-with-prepend dir file pre)\\\\\\\\n                   (run-php-file dir file))\\\\\\\\n          expected-out (or out \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\")\\\\\\\\n          expected-diag (vec (or diag []))\\\\\\\\n          pass? (and (not= :pending oracle)\\\\\\\\n                     (= expected-out (:out actual))\\\\\\\\n                     (diag-match? expected-diag (:diag actual))\\\\\\\\n                     (= uncaught (:uncaught actual))\\\\\\\\n                     (or (nil? status) (= status (:exit actual))))]\\\\\\\\n      {:id id,\\\\\\\\n       :pass? pass?,\\\\\\\\n       :oracle oracle,\\\\\\\\n       :expected {:out expected-out, :diag expected-diag, :uncaught uncaught, :status status},\\\\\\\\n       :actual (assoc (select-keys actual [:out :diag :uncaught]) :exit (:exit actual))})))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn run-p5\\\\\\\\n  \\\\\\\\\\\\\\\"Run all `p5/fixtures` (the request-context fixtures) against\\\\\\\\n   `php:8.3-cli`.\\\\\\\\\\\\\\\"\\\\\\\\n  []\\\\\\\\n  (let [dir (.toFile (Files/createTempDirectory \\\\\\\\\\\\\\\"yang-php-oracle-p5-\\\\\\\\\\\\\\\"\\\\\\\\n                                                (make-array FileAttribute 0)))]\\\\\\\\n    (try\\\\\\\\n      (mapv #(check-p5-fixture dir %) p5/fixtures)\\\\\\\\n      (finally\\\\\\\\n        (doseq [f (reverse (file-seq dir))]\\\\\\\\n          (.delete ^java.io.File f))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn check-p5b2-fixture\\\\\\\\n  \\\\\\\\\\\\\\\"Run P5b2 `fixture` in temporary directory `dir`: the fixture source plus\\\\\\\\n   the [[p5b2-prologue]] as `auto_prepend_file` (the ruled recursive merge\\\\\\\\n   and, for `:http-profile` fixtures, the explicit initial status 200 — bare\\\\\\\\n   CLI starts without the engine's assumed HTTP 200). Returns a check record\\\\\\\\n   like [[check-fixture]], with the engine's guest-fatal representation\\\\\\\\n   (`:fatal`) compared against the parser's preserved `:fatal`.\\\\\\\\\\\\\\\"\\\\\\\\n  [dir {:keys [id source out diag uncaught status fatal oracle]}]\\\\\\\\n  (let [file (str (name id) \\\\\\\\\\\\\\\".php\\\\\\\\\\\\\\\")\\\\\\\\n        pre (str (name id) \\\\\\\\\\\\\\\"-pre.php\\\\\\\\\\\\\\\")\\\\\\\\n        fixture (first (filter #(= id (:id %)) p5b2/fixtures))]\\\\\\\\n    (write-source! dir file source)\\\\\\\\n    (write-source! dir pre (p5b2-prologue fixture))\\\\\\\\n    (let [actual (run-php-file-with-prepend dir file pre)\\\\\\\\n          expected-out (or out \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\")\\\\\\\\n          expected-diag (vec (or diag []))\\\\\\\\n          pass? (and (not= :pending oracle)\\\\\\\\n                     (= expected-out (:out actual))\\\\\\\\n                     (diag-match? expected-diag (:diag actual))\\\\\\\\n                     (= uncaught (:uncaught actual))\\\\\\\\n                     (= fatal (:fatal actual))\\\\\\\\n                     (or (nil? status) (= status (:exit actual))))]\\\\\\\\n      {:id id,\\\\\\\\n       :pass? pass?,\\\\\\\\n       :oracle oracle,\\\\\\\\n       :expected {:out expected-out, :diag expected-diag, :uncaught uncaught,\\\\\\\\n                  :fatal fatal, :status status},\\\\\\\\n       :actual (assoc (select-keys actual [:out :diag :uncaught :fatal]) :exit (:exit actual))})))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn run-p5b2\\\\\\\\n  \\\\\\\\\\\\\\\"Run all `p5b2/fixtures` (the B2 step-7 fixtures) against `php:8.3-cli`.\\\\\\\\\\\\\\\"\\\\\\\\n  []\\\\\\\\n  (let [dir (.toFile (Files/createTempDirectory \\\\\\\\\\\\\\\"yang-php-oracle-p5b2-\\\\\\\\\\\\\\\"\\\\\\\\n                                                (make-array FileAttribute 0)))]\\\\\\\\n    (try\\\\\\\\n      (mapv #(check-p5b2-fixture dir %) p5b2/fixtures)\\\\\\\\n      (finally\\\\\\\\n        (doseq [f (reverse (file-seq dir))]\\\\\\\\n          (.delete ^java.io.File f))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn print-fold\\\\\\\\n  \\\\\\\\\\\\\\\"Print the fold lines for `results`: one paste-ready record per fixture\\\\\\\\n   in the P4 [[p4/pin]] shape `{:oracle p5-banner :out :diag :uncaught}`,\\\\\\\\n   carrying the guest-fatal representation (`:fatal`) and the process exit\\\\\\\\n   status (`:status`) alongside.\\\\\\\\\\\\\\\"\\\\\\\\n  [results]\\\\\\\\n  (doseq [{:keys [id actual]} results]\\\\\\\\n    (println \\\\\\\\\\\\\\\"FOLD\\\\\\\\\\\\\\\" (name id)\\\\\\\\n             (pr-str (assoc (select-keys actual [:out :diag :uncaught :fatal])\\\\\\\\n                            :oracle p5-banner\\\\\\\\n                            :status (:exit actual))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn run-all\\\\\\\\n  \\\\\\\\\\\\\\\"Run all `programs/fixtures`, `matrix-source` and `float-cases` against\\\\\\\\n   `php:8.3-cli`.\\\\\\\\\\\\\\\"\\\\\\\\n  []\\\\\\\\n  (let [dir (.toFile (Files/createTempDirectory \\\\\\\\\\\\\\\"yang-php-oracle-\\\\\\\\\\\\\\\"\\\\\\\\n                                                (make-array FileAttribute 0)))]\\\\\\\\n    (try\\\\\\\\n      (-> (mapv #(check-fixture dir %) (concat programs/fixtures p3b/all-fixtures p4/all-fixtures p6/all-fixtures))\\\\\\\\n          (conj (check-matrix dir))\\\\\\\\n          (conj (check-floats dir)))\\\\\\\\n      (finally\\\\\\\\n        (doseq [f (reverse (file-seq dir))]\\\\\\\\n          (.delete ^java.io.File f))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(defn -main\\\\\\\\n  [& args]\\\\\\\\n  (when (some #{\\\\\\\\\\\\\\\"--print-prologue\\\\\\\\\\\\\\\"} args)\\\\\\\\n    (let [id (keyword (or (second (drop-while #(not= \\\\\\\\\\\\\\\"--print-prologue\\\\\\\\\\\\\\\" %) args))\\\\\\\\n                          \\\\\\\\\\\\\\\"superglobals-from-request\\\\\\\\\\\\\\\"))\\\\\\\\n          fixture (first (filter #(= id (:id %)) p5/fixtures))\\\\\\\\n          b2-fixture (first (filter #(= id (:id %)) p5b2/fixtures))]\\\\\\\\n      (when-not (or fixture b2-fixture)\\\\\\\\n        (println \\\\\\\\\\\\\\\"Unknown P5 fixture:\\\\\\\\\\\\\\\" id)\\\\\\\\n        (System/exit 2))\\\\\\\\n      ;; Dry run: no docker, no oracle. Print the generated prologue for\\\\\\\\n      ;; eyeball comparison against the engine's expected superglobal\\\\\\\\n      ;; values (the fixture's hand-derived :out is the reference).\\\\\\\\n      (print (if b2-fixture\\\\\\\\n               (p5b2-prologue b2-fixture)\\\\\\\\n               (p5-prologue (:request fixture))))\\\\\\\\n      (flush)\\\\\\\\n      (shutdown-agents)\\\\\\\\n      (System/exit 0)))\\\\\\\\n  (when (some #{\\\\\\\\\\\\\\\"--p5\\\\\\\\\\\\\\\"} args)\\\\\\\\n    (let [results (run-p5)\\\\\\\\n          recorded (filter #(= :pending (:oracle %)) results)\\\\\\\\n          failures (remove #(or (:pass? %) (= :pending (:oracle %))) results)]\\\\\\\\n      (println \\\\\\\\\\\\\\\"Banner:\\\\\\\\\\\\\\\" p5-banner)\\\\\\\\n      (println \\\\\\\\\\\\\\\"Checked:\\\\\\\\\\\\\\\" (count results) \\\\\\\\\\\\\\\"P5 targets; failures:\\\\\\\\\\\\\\\" (count failures))\\\\\\\\n      (print-fold recorded)\\\\\\\\n      (doseq [f failures]\\\\\\\\n        (println \\\\\\\\\\\\\\\"FAIL\\\\\\\\\\\\\\\" (:id f))\\\\\\\\n        (println \\\\\\\\\\\\\\\"  expected:\\\\\\\\\\\\\\\" (pr-str (:expected f)))\\\\\\\\n        (println \\\\\\\\\\\\\\\"  actual:  \\\\\\\\\\\\\\\" (pr-str (:actual f))))\\\\\\\\n      (shutdown-agents)\\\\\\\\n      (when (seq failures)\\\\\\\\n        (System/exit 1))\\\\\\\\n      (System/exit 0)))\\\\\\\\n  (when (some #{\\\\\\\\\\\\\\\"--p5b2\\\\\\\\\\\\\\\"} args)\\\\\\\\n    (let [results (run-p5b2)\\\\\\\\n          recorded (filter #(= :pending (:oracle %)) results)\\\\\\\\n          failures (remove #(or (:pass? %) (= :pending (:oracle %))) results)]\\\\\\\\n      (println \\\\\\\\\\\\\\\"Banner:\\\\\\\\\\\\\\\" p5-banner)\\\\\\\\n      (println \\\\\\\\\\\\\\\"Checked:\\\\\\\\\\\\\\\" (count results) \\\\\\\\\\\\\\\"P5b2 targets; failures:\\\\\\\\\\\\\\\" (count failures))\\\\\\\\n      (print-fold recorded)\\\\\\\\n      (doseq [f failures]\\\\\\\\n        (println \\\\\\\\\\\\\\\"FAIL\\\\\\\\\\\\\\\" (:id f))\\\\\\\\n        (println \\\\\\\\\\\\\\\"  expected:\\\\\\\\\\\\\\\" (pr-str (:expected f)))\\\\\\\\n        (println \\\\\\\\\\\\\\\"  actual:  \\\\\\\\\\\\\\\" (pr-str (:actual f))))\\\\\\\\n      (shutdown-agents)\\\\\\\\n      (when (seq failures)\\\\\\\\n        (System/exit 1))\\\\\\\\n      (System/exit 0)))\\\\\\\\n  (let [results (run-all)\\\\\\\\n        recorded (filter #(= :pending (:oracle %)) results)\\\\\\\\n        failures (remove #(or (:pass? %) (= :pending (:oracle %))) results)]\\\\\\\\n(ns yang.php.antlr.generators-test\\\\\\\\n  \\\\\\\\\\\\\\\"P4 S8 generators, live iteration and protocol integration on the JVM.\\\\\\\\\\\\\\\"\\\\\\\\n  (:require\\\\\\\\n    [clojure.test :refer [deftest is testing]]\\\\\\\\n    [yang.php.antlr.e2e-harness :as h]\\\\\\\\n    [yang.php.antlr.programs-p4 :as p4]\\\\\\\\n    [yin.vm :as vm]\\\\\\\\n    [yin.vm.debruijn.register :as rvm]\\\\\\\\n    [yin.vm.debruijn.stack :as dvm]\\\\\\\\n    [yin.vm.engine :as engine]\\\\\\\\n    [yin.vm.semantic :as semantic]\\\\\\\\n    [yin.vm.semantic.derive :as derive]\\\\\\\\n    [yin.vm.semantic.linearize :as sr-linearize]\\\\\\\\n    [yin.vm.test-utils :as tu]\\\\\\\\n    [yin.vm.values :as values])\\\\\\\\n  (:import\\\\\\\\n    [java.util IdentityHashMap]))\\\\\\\\n\\\\\\\\n\\\\\\\\n(def ^:private vms [:ast-walker :semantic :stack :register])\\\\\\\\n\\\\\\\\n\\\\\\\\n(deftest generator-fixtures-on-every-vm-test\\\\\\\\n  (doseq [{:keys [id source out]} p4/generators-v1]\\\\\\\\n    (testing (name id)\\\\\\\\n      (let [results (h/run-php source)]\\\\\\\\n        (is (not (contains? results :diagnostics)) (pr-str results))\\\\\\\\n        (doseq [k vms]\\\\\\\\n          (is (= out (get results k)) (str (name id) \\\\\\\\\\\\\\\" on \\\\\\\\\\\\\\\" k)))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(deftest iteration-protocols-test\\\\\\\\n  (testing \\\\\\\\\\\\\\\"Iterator drives foreach directly\\\\\\\\\\\\\\\"\\\\\\\\n    (is (= \\\\\\\\\\\\\\\"01\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\n                            \\\\\\\\\\\\\\\"<?php class I implements Iterator { private $i=0; function rewind(): void {$this->i=0;} function valid(): bool {return $this->i<2;} function current(): mixed {return $this->i;} function key(): mixed {return $this->i;} function next(): void {$this->i++;} } foreach(new I as $v) echo $v;\\\\\\\\\\\\\\\")))))\\\\\\\\n  (testing \\\\\\\\\\\\\\\"IteratorAggregate supplies the live iterator\\\\\\\\\\\\\\\"\\\\\\\\n    (is (= \\\\\\\\\\\\\\\"23\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\n                            \\\\\\\\\\\\\\\"<?php class I implements Iterator {private $i=2;function rewind():void{}function valid():bool{return $this->i<4;}function current(){return $this->i;}function key(){return $this->i;}function next():void{$this->i++;}} class A implements IteratorAggregate {function getIterator():Iterator{return new I;}} foreach(new A as $v)echo $v;\\\\\\\\\\\\\\\")))))\\\\\\\\n  (testing \\\\\\\\\\\\\\\"property iteration filters visibility from the calling scope\\\\\\\\\\\\\\\"\\\\\\\\n    (is (= \\\\\\\\\\\\\\\"aabc\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\n                              \\\\\\\\\\\\\\\"<?php class P {public $a='a'; protected $b='b'; private $c='c'; function f(){foreach($this as $v)echo $v;}} $p=new P;foreach($p as $v)echo $v;$p->f();\\\\\\\\\\\\\\\")))))\\\\\\\\n  (testing \\\\\\\\\\\\\\\"ArrayAccess reads by value; Countable and Stringable dispatch\\\\\\\\\\\\\\\"\\\\\\\\n    (is (= \\\\\\\\\\\\\\\"43s\\\\\\\\\\\\\\\" (:php/out (h/run-raw\\\\\\\\n                             \\\\\\\\\\\\\\\"<?php class A implements ArrayAccess, Countable, Stringable {function offsetExists($x):bool{return true;} function offsetGet($x){return 4;} function offsetSet($x,$v):void{} function offsetUnset($x):void{} function count():int{return 3;} function __toString():string{return 's';}} $a=new A;echo $a[0],count($a),(string)$a;\\\\\\\\\\\\\\\"))))))\\\\\\\\n\\\\\\\\n\\\\\\\\n(def ^:private opts\\\\\\\\n  {:make-stream tu/make-stream\\\\\\\\n   :capability-secret tu/secret\\\\\\\\n   :primitives vm/primitives\\\\\\\\n   :modules (h/host-registry)})\\\\\\\\n\\\\\\\\n\\\\\\\\n(def ^:private load-semantic\\\\\\\\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\\\\\\\\n---\\\\\\\\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\\\\\\\\n---\\\\\\\\n\\\\\\\\n# BUILD & TEST\\\\\\\\n\\\\\\\\n## Commands\\\\\\\\n\\\\\\\\n```sh\\\\\\\\n# Tests (Babashka runner)\\\\\\\\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\\\\\\\\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\\\\\\\\nbb test:slow         # Only the slow tests, on every lane\\\\\\\\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\\\\\\\\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\\\\\\\\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\\\\\\\\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\\\\\\\\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\\\\\\\\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\\\\\\\\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\\\\\\\\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\\\\\\\\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\\\\\\\\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\\\\\\\\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\\\\\\\\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\\\\\\\\n# (dao.test-slow/guard \\\\\\\\\\\\\\\"name\\\\\\\\\\\\\\\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\\\\\\\\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\\\\\\\\n# under test/), so the non-slow tests inside those namespaces also run there.\\\\\\\\n# On Node, shadow also runs the test namespaces those nine require (about\\\\\\\\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\\\\\\\\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\\\\\\\\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\\\\\\\\n# not subsystems). On the many-core remote hosts see \\\\\\\\\\\\\\\"Remote test servers\\\\\\\\\\\\\\\" below for\\\\\\\\n# which lanes may overlap.\\\\\\\\n#\\\\\\\\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\\\\\\\\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\\\\\\\\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\\\\\\\\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\\\\\\\\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\\\\\\\\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\\\\\\\\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\\\\\\\\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\\\\\\\\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\\\\\\\\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\\\\\\\\n# (or `clojure -M:test -i :slow -n <ns>`).\\\\\\\\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\\\\\\\\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\\\\\\\\n# When a test fails, reproduce and fix it by running ONLY the failing test\\\\\\\\n# (`clojure -M:test -n <ns> -v <ns>/<var>`, Node `--test=<ns>`, Dart `--only <ns>`) --\\\\\\\\n# never the whole suite (owner ruling 2026-11-01; see Gate Ladder G0).\\\\\\\\n# Individual tests run fine on the laptop; suite-scale runs (G1 subsystem sets,\\\\\\\\n# G2 changed sets, full suites, slow tier, nightly) run on shiva/jupiter --\\\\\\\\n# the suite has outgrown the laptop (owner ruling 2026-11-04).\\\\\\\\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\\\\\\\\n# G2 (`bb test:changed` in the worktree across all three lanes).\\\\\\\\n# Full repo-wide `bb test` runs once daily on the remote hosts (04:00 VN);\\\\\\\\n# a MERGE needs only the affected tests (bb test:changed) -- owner ruling 2026-11-01;\\\\\\\\n# for a fix branch, the previously-failing tests green IS the merge bar\\\\\\\\n# (owner ruling 2026-11-07; see Gate Ladder G0).\\\\\\\\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\\\\\\\\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\\\\\\\\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\\\\\\\\n# overlap lanes, see \\\\\\\\\\\\\\\"Remote test servers\\\\\\\\\\\\\\\" below).\\\\\\\\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\\\\\\\\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\\\\\\\\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\\\\\\\\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\\\\\\\\nnpm test             # Node.js tests\\\\\\\\n\\\\\\\\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\\\\\\\\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\\\\\\\\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\\\\\\\\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\\\\\\\\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\\\\\\\\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\\\\\\\\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\\\\\\\\n                         # and the linker L5 Node reader that requires a module\\\\\\\\n                         # by name): `clojure -M:test` without it fails that test\\\\\\\\n```\\\\\\\\n\\\\\\\\n### Changed-only tests: `bb test:changed`\\\\\\\\n\\\\\\\\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\\\\\\\\nreach: the reverse require closure of the files changed since the\\\\\\\\nmerge-base with master, plus fixtures that mention a changed resource path,\\\\\\\\ntests that walk a changed tree, and each src file's `_test` by convention.\\\\\\\\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\\\\\\\\nfs/walk-file-tree or .listFiles; each string literal argument of its\\\\\\\\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\\\\\\\\n(let-bound roots count), and a change under a root selects it. The three\\\\\\\\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\\\\\\\\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\\\\\\\\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\\\\\\\\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\\\\\\\\nland a slice confined to a package. Exit 2 (from :list too) is a wide\\\\\\\\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\\\\\\\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\\\\\\\nas for a change to the core everything requires (yin.vm engine,\\\\\\\\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\ncollab/yang-php/1794566777000-engineer-p7b-ticks-b.gpt-6.1-terra.stdout.log:27:{\\\\\\\"type\\\\\\\":\\\\\\\"item.started\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_13\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc \\\\\\\\\\\\\\\"cat > test/yang/php/antlr/programs_p7b.cljc <<'EOF'\\\\\\\\n(ns yang.php.antlr.programs-p7b\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"Hand-derived tick expectations pending the pinned PHP oracle pass.\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\\n\\\\\\\\n(def prologue\\\\\\\\n  \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"function tick_handler() { echo 'T'; } register_tick_function('tick_handler'); \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\\n\\\\\\\\n(def fixtures\\\\\\\\n  [{:id :sequence, :source \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"declare(ticks=1) { echo 'A'; \\\\\\\\\\\\\\\"'$x = 1; echo '\\\\\\\\\\\\\\\"'B'; }\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\",\\\\\\\\n    :out \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"ATTBT\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\", :oracle :pending}])\\\\\\\\nEOF\\\\\\\\ncat > test/yang/php/antlr/ticks_test.clj <<'EOF'\\\\\\\\n(ns yang.php.antlr.ticks-test\\\\\\\\n  (:require\\\\\\\\n    [clojure.test :refer [deftest is testing]]\\\\\\\\n    [yang.php.antlr.e2e-harness :as h]\\\\\\\\n    [yang.php.antlr.programs-p7b :as p7b]))\\\\\\\\n\\\\\\\\n\\\\\\\\n(deftest tick-fixtures-test\\\\\\\\n  (doseq [{:keys [id source out]} p7b/fixtures]\\\\\\\\n    (testing (name id)\\\\\\\\n      (is (= out (:php/out (h/run-raw (str \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"<?php \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\" p7b/prologue source))))))))\\\\\\\\nEOF\\\\\\\\ntimeout 120 clojure -M:test -n yang.php.antlr.ticks-test\\\\\\\\\\\\\\\"\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"exit_code\\\\\\\":null,\\\\\\\"status\\\\\\\":\\\\\\\"in_progress\\\\\\\"}}\\\\ncollab/yang-php/1794566777000-engineer-p7b-ticks-b.gpt-6.1-terr