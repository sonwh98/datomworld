21\\\\t\\\\n    22\\\\t\\\\n    23\\\\t;; =============================================================================\\\\n    24\\\\t;; Registry values\\\\n    25\\\\t;; =============================================================================\\\\n    26\\\\t\\\\n    27\\\\t(defn empty-registry\\\\n    28\\\\t  \\\\\\\"An empty module registry value.\\\\\\\"\\\\n    29\\\\t  []\\\\n    30\\\\t  {:modules {}, :effect-handlers {}})\\\\n    31\\\\t\\\\n    32\\\\t\\\\n    33\\\\t(defn- symbol->path\\\\n    34\\\\t  \\\\\\\"Split a dotted symbol into a get-in path of symbols.\\\\n    35\\\\t   'yin.io.file-input-stream → ['yin 'io 'file-input-stream]\\\\\\\"\\\\n    36\\\\t  [sym]\\\\n    37\\\\t  (mapv symbol (str/split (str sym) #\\\\\\\"\\\\\\\\.\\\\\\\")))\\\\n    38\\\\t\\\\n    39\\\\t\\\\n    40\\\\t(defn- walk-path\\\\n    41\\\\t  \\\\\\\"Descend a registry's :modules map along path, a sequence of symbols.\\\\n    42\\\\t\\\\n    43\\\\t   Namespace segments step through plain maps until the path reaches a\\\\n    44\\\\t   module entry (a map carrying :manifest); the remaining segments read\\\\n    45\\\\t   that entry's task-local lowered `:bindings` when it holds them -- a\\\\n    46\\\\t   linked module (yin.vm.linker.md section 8.3) -- and its `:slice`\\\\n    47\\\\t   otherwise, which for a host module is the host values themselves, so\\\\n    48\\\\t   a binding name resolves to its export.\\\\\\\"\\\\n    49\\\\t  [node path]\\\\n    50\\\\t  (if (seq path)\\\\n    51\\\\t    (if (and (map? node) (contains? node :manifest))\\\\n    52\\\\t      (get-in node (into [(if (contains? node :bindings) :bindings :slice)]\\\\n    53\\\\t                         path))\\\\n    54\\\\t      (when-let [child (get node (first path))]\\\\n    55\\\\t        (walk-path child (rest path))))\\\\n    56\\\\t    node))\\\\n    57\\\\t\\\\n    58\\\\t\\\\n    59\\\\t(defn module-entry\\\\n    60\\\\t  \\\\\\\"The registry entry of module `module-name` in `modules` (a registry's\\\\n    61\\\\t   `:modules` map), or nil when the dotted path reaches no module entry.\\\\\\\"\\\\n    62\\\\t  [modules module-name]\\\\n    63\\\\t  (let [node (reduce (fn [node seg] (when (map? node) (get node seg)))\\\\n    64\\\\t                     modules\\\\n    65\\\\t                     (symbol->path module-name))]\\\\n    66\\\\t    (when (and (map? node) (contains? node :manifest)) node)))\\\\n    67\\\\t\\\\n    68\\\\t\\\\n    69\\\\t(defn assoc-module\\\\n    70\\\\t  \\\\\\\"Return registry with `entry` installed as module `module-name`.\\\\\\\"\\\\n    71\\\\t  [registry module-name entry]\\\\n    72\\\\t  (assoc-in (or registry (empty-registry))\\\\n    73\\\\t            (into [:modules] (symbol->path module-name))\\\\n    74\\\\t            entry))\\\\n    75\\\\t\\\\n    76\\\\t\\\\n    77\\\\t(defn link-module\\\\n    78\\\\t  \\\\\\\"The `linked` transition's registry update (yin.vm.linker.md sections\\\\n    79\\\\t   7.3 and 8.3): `registry` gains the module `manifest` names as the\\\\n    80\\\\t   portable encoding of acts 1 to 3 -- `{:manifest m :address a\\\\n    81\\\\t   :derivation d :slice {sym encoded} :stores {address snapshot} :cells\\\\n    82\\\\t   {cell-id cell} :images {identity image}}` -- never lowered values. `a`\\\\n    83\\\\t   is the manifest's own address; `lifted` is the act-1 lift, `{:slice\\\\n    84\\\\t   :stores :cells :images}`, the cells being the logical cursor cells its\\\\n    85\\\\t   references name (r9) and the images the verified origin images a\\\\n    86\\\\t   receiving task attaches.\\\\n    87\\\\t   Each receiving task lowers the entry into its own `:bindings`.\\\\\\\"\\\\n    88\\\\t  [registry manifest derivation lifted]\\\\n    89\\\\t  (assoc-module registry\\\\n    90\\\\t                (:yin.module/name manifest)\\\\n    91\\\\t                {:manifest manifest,\\\\n    92\\\\t                 :address (jing/segment-key manifest),\\\\n    93\\\\t                 :derivation derivation,\\\\n    94\\\\t                 :slice (:slice lifted),\\\\n    95\\\\t                 :stores (:stores lifted),\\\\n    96\\\\t                 :cells (:cells lifted),\\\\n    97\\\\t                 :images (:images lifted)}))\\\\n    98\\\\t\\\\n    99\\\\t\\\\n   100\\\\t(defn module-entries\\\\n   101\\\\t  \\\\\\\"Every `[name entry]` a registry value holds, the module name read back\\\\n   102\\\\t   from each entry's manifest.\\\\\\\"\\\\n   103\\\\t  [registry]\\\\n   104\\\\t  (letfn [(walk\\\\n   105\\\\t            [node]\\\\n   106\\\\t            (when (map? node)\\\\n   107\\\\t              (if (contains? node :manifest)\\\\n   108\\\\t                [[(:yin.module/name (:manifest node)) node]]\\\\n   109\\\\t                (mapcat walk (vals node)))))]\\\\n   110\\\\t    (vec (walk (:modules registry)))))\\\\n   111\\\\t\\\\n   112\\\\t\\\\n   113\\\\t(defn pin-conflict\\\\n   114\\\\t  \\\\\\\"The deterministic refusal when receiving `entry` as `module-name`\\\\n   115\\\\t   would disagree with a linked manifest's dependency pin. Missing\\\\n   116\\\\t   dependencies are permitted; pins are derived from registry manifests.\\\\\\\"\\\\n   117\\\\t  [registry module-name entry]\\\\n   118\\\\t  (let [linked (filter (fn [[_ e]] (some? (:address e)))\\\\n   119\\\\t                       (module-entries registry))\\\\n   120\\\\t        existing (keep (fn [[owner e]]\\\\n   121\\\\t                         (let [requires (:yin.module/requires (:manifest e))]\\\\n   122\\\\t                           (when (and (contains? requires module-name)\\\\n   123\\\\t                                      (not= (get requires module-name)\\\\n   124\\\\t                                            (:address entry)))\\\\n   125\\\\t                             [module-name owner (get requires module-name)\\\\n   126\\\\t                              (:address entry)])))\\\\n   127\\\\t                       linked)\\\\n   128\\\\t        incoming (keep (fn [[name pinned]]\\\\n   129\\\\t                         (when-let [held (module-entry (:modules registry) name)]\\\\n   130\\\\t                           (when (not= pinned (:address held))\\\\n   131\\\\t                             [name module-name pinned (:address held)])))\\\\n   132\\\\t                       (:yin.module/requires (:manifest entry)))\\\\n   133\\\\t        conflict (first (sort-by (fn [[name owner pinned address]]\\\\n   134\\\\t                                   [(str name) (str owner) (str pinned) (str address)])\\\\n   135\\\\t                                 (concat existing incoming)))]\\\\n   136\\\\t    (when-let [[name _ pinned address] conflict]\\\\n   137\\\\t      {:status :refused,\\\\n   138\\\\t       :reason :dependency-pin-mismatch,\\\\n   139\\\\t       :module module-name,\\\\n   140\\\\t       :name name,\\\\n   141\\\\t       :pinned pinned,\\\\n   142\\\\t       :linked address})))\\\\n   143\\\\t\\\\n   144\\\\t\\\\n   145\\\\t(defn resolve-module\\\\n   146\\\\t  \\\\\\\"Get a value from a registry value by dotted symbol path.\\\\n   147\\\\t   (resolve-module r 'io)                    → the 'io registry entry\\\\n   148\\\\t   (resolve-module r 'io.file-output-stream) → the specific export\\\\\\\"\\\\n   149\\\\t  [registry sym]\\\\n   150\\\\t  (walk-path (:modules registry) (symbol->path sym)))\\\\n   151\\\\t\\\\n   152\\\\t\\\\n   153\\\\t(defn register-effect-handler\\\\n   154\\\\t  \\\\\\\"Return registry with handler-fn installed for effect keyword kw.\\\\n   155\\\\t   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\\\\\\\"\\\\n   156\\\\t  [registry kw handler-fn]\\\\n   157\\\\t  (assoc-in (or registry (empty-registry)) [:effect-handlers kw] handler-fn))\\\\n   158\\\\t\\\\n   159\\\\t\\\\n   160\\\\t(defn get-effect-handler\\\\n   161\\\\t  \\\\\\\"Get the handler function for an effect keyword.\\\\\\\"\\\\n   162\\\\t  [registry kw]\\\\n   163\\\\t  (get (:effect-handlers