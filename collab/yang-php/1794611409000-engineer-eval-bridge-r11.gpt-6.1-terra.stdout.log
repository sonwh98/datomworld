\\\\\\\"))\\\\n  3410\\\\t                           first))\\\\n  3411\\\\t        base {:name (u/lit written),\\\\n  3412\\\\t              :vis (u/lit (member-vis mods)),\\\\n  3413\\\\t              :static? (u/lit (boolean (:static mods))),\\\\n  3414\\\\t              :abstract? (u/lit (boolean (or (:abstract mods) (nil? block)))),\\\\n  3415\\\\t              :final? (u/lit (boolean (:final mods)))}]\\\\n  3416\\\\t    (if block\\\\n  3417\\\\t      (let [[lam spec statics] (function-lam (assoc ctx :cc true) st\\\\n  3418\\\\t                                             (if (:cname ctx) (str (:cname ctx) \\\\\\\"::\\\\\\\" written) written) {})]\\\\n  3419\\\\t        (spec-node (assoc base\\\\n  3420\\\\t                          :make (u/lam ['%cc]\\\\n  3421\\\\t                                       (app* 'php/make-function (u/lit written) (u/lit spec) lam\\\\n  3422\\\\t                                             (u/lit statics))))))\\\\n  3423\\\\t      (spec-node base))))\\\\n  3424\\\\t\\\\n  3425\\\\t\\\\n  3426\\\\t(defn- type-names\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_42\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg -n \\\\\\\\\\\\\\\"'yang\\\\\\\\\\\\\\\\.|'php\\\\\\\\\\\\\\\\.rt|u/v 'php|call/\\\\\\\\\\\\\\\" src/cljc/yang/php/antlr/lower.cljc | head -30; nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '5380,5405p'; nl -ba src/cljc/yin/vm/module.cljc | sed -n '421,445p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_42\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"rg -n \\\\\\\\\\\\\\\"'yang\\\\\\\\\\\\\\\\.|'php\\\\\\\\\\\\\\\\.rt|u/v 'php|call/\\\\\\\\\\\\\\\" src/cljc/yang/php/antlr/lower.cljc | head -30; nl -ba src/cljc/yang/php/antlr/prelude.cljc | sed -n '5380,5405p'; nl -ba src/cljc/yin/vm/module.cljc | sed -n '421,445p'\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"3768:   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\\\\n3786:               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\\\\n  5380\\\\t    \\\\\\\"php\\\\\\\" :php/uninit runtime-keys\\\\n  5381\\\\t    (mapv (partial unshadow (into #{} (map (fn [[k _]] (strip k))) definitions)) definitions)))\\\\n  5382\\\\t\\\\n  5383\\\\t\\\\n  5384\\\\t(def module-uast\\\\n  5385\\\\t  \\\\\\\"The module tree: one application whose operands are the definitions, in\\\\n  5386\\\\t   order. Defining runs nothing.\\\\\\\"\\\\n  5387\\\\t  (core/module-tree module-definitions []))\\\\n  5388\\\\t\\\\n  5389\\\\t\\\\n  5390\\\\t(def module-exports\\\\n  5391\\\\t  \\\\\\\"The module's exports: every `php/` key of the definition list, stripped.\\\\\\\"\\\\n  5392\\\\t  (core/exports \\\\\\\"php\\\\\\\" definitions))\\\\n  5393\\\\t\\\\n  5394\\\\t\\\\n  5395\\\\t(def free-names core/free-names)\\\\n  5396\\\\t\\\\n  5397\\\\t\\\\n  5398\\\\t(def defined-keys core/defined-keys)\\\\n  5399\\\\t\\\\n  5400\\\\t\\\\n  5401\\\\t(def ^:private module-free-names\\\\n  5402\\\\t  (core/free-name-vec module-uast))\\\\n  5403\\\\t\\\\n  5404\\\\t\\\\n  5405\\\\t(defn module-spec\\\\n   421\\\\t;; =============================================================================\\\\n   422\\\\t\\\\n   423\\\\t;; =============================================================================\\\\n   424\\\\t;; `require` lowers to the linker (yin.vm.linker.md section 7)\\\\n   425\\\\t;; =============================================================================\\\\n   426\\\\t\\\\n   427\\\\t(defprotocol IModuleKernel\\\\n   428\\\\t  \\\\\\\"What a kernel supplies the install child and the `linked` transition\\\\n   429\\\\t   (yin.vm.linker.md section 7.3). Every method is a pure function of a\\\\n   430\\\\t   VM value; the engine owns the phases, the kernel owns its coordinates.\\\\\\\"\\\\n   431\\\\t\\\\n   432\\\\t  (link-format\\\\n   433\\\\t    [vm]\\\\n   434\\\\t    \\\\\\\"`{:format kw :contract s}`: the format this kernel links, and the\\\\n   435\\\\t     execution contract it runs.\\\\\\\")\\\\n   436\\\\t\\\\n   437\\\\t  (spawn-module\\\\n   438\\\\t    [vm image opts]\\\\n   439\\\\t    \\\\\\\"A fresh VM of this backend with the verified `image` loaded by the\\\\n   440\\\\t     ordinary loader, holding nothing of `vm`'s state but its composition\\\\n   441\\\\t     values (primitives, stream constructor, link pair). `opts` carries\\\\n   442\\\\t     `:modules` (the child's module view), `:origin`, and `:ancestry`.\\\\\\\")\\\\n   443\\\\t\\\\n   444\\\\t  (image-identity\\\\n   445\\\\t    [vm image]\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_43\\\",\\\"type\\\":\\\"agent_message\\\",\\\"text\\\":\\\"The bridge should compile eval source through a composition-supplied compiler service, then execute the resulting entry **in the caller’s task, against the caller’s existing variable cells and run budget**. Parsing remains outside the VM. Node and Dart need a configured service; without one, eval retains the pinned refusal.\\\\n\\\\nThis is a proposed design, not an implementation report. No files were edited or tests run.\\\\n\\\\n**1. Compilation path and host policy**\\\\n\\\\nThe current refusal has two paths: the `Eval` prefix is listed in `prefix-refusals`, and the plain-call path explicitly refuses `\\\\\\\"eval\\\\\\\"`. The pinned diagnostic is a map containing `:yang.php/diagnostic :yang.php/unsupported`, `:construct :eval`, and the source rule/span. See [lower.cljc:100](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:100), [lower.cljc:1307](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:1307), [lower.cljc:1861](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:1861), and [core/lower.cljc:17](/Users/sto/workspace/datomworld/src/cljc/yang/core/lower.cljc:17).\\\\n\\\\nReplace the supported eval expression with this conceptual sequence:\\\\n\\\\n```clojure\\\\n(let [source <evaluate operand once>]\\\\n  (php/eval-run source caller-scope caller-context run-context))\\\\n```\\\\n\\\\n`php/eval-run` submits a compilation request and waits for its correlated outcome using ordinary stream effects. It must never call `cst/parse-source`, `lower-program`, or a host PHP evaluator directly. This follows the existing requirement that portable code requests compilation through streams and that the coordinator answers those requests. See [yang.antlr.md:868](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:868).\\\\n\\\\nThe proposed path is:\\\\n\\\\n```text\\\\ncaller evaluates source operand\\\\n  → compilation request stream\\\\n  → PHP parser worker, eval source goal\\\\n  → CST validation and scope analysis\\\\n  → PHP lowering, eval-unit entry\\\\n  → canonical source envelope\\\\n  → active safepoint derivation\\\\n  → publication and ordinary linker admission\\\\n  → installed entry called in caller task\\\\n```\\\\n\\\\nReuse the normal parser and lowering machinery, with an explicit **eval-unit emission mode**. Do not invoke `lower-program` unchanged: it wraps the body in `php/run-main`, and its linked form calls `php/init!`. `php/run-main` resets output and dynamic handler context; that would break the surrounding execution. See [lower.cljc:3759](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3759) and [prelude.cljc:5070](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:5070).\\\\n\\\\nThe eval emitter should reuse `context`, `unit-body`, and the unit return escape, producing an entry conceptually shaped as:\\\\n\\\\n```clojure\\\\n(fn [%runtime %scope %ctx %hooks]\\\\n  <eval unit>)\\\\n```\\\\n\\\\nThe existing included-unit emitter already demonstrates `%scope`/`%ctx` arguments. Its return sentinel is also reusable, but eval must map fall-through to `:php/null`; the include wrapper currently maps it to `1`. See [lower.cljc:3648](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3648), [lower.cljc:3721](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3721), [lower.cljc:3840](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3840), and [prelude_module.cljc:84](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude_module.cljc:84).\\\\n\\\\nThree details complete this path:\\\\n\\\\n- **Eval source goal.** Start the existing lexer in PHP mode, retaining its default mode beneath it so `?>` can leave PHP mode. Do not prepend an opening tag and then repair offsets. The grammar already has PHP mode and mixed HTML parsing; Zend likewise compiles eval after the opening-tag position. Preserve original eval-byte spans and line starts. See [PhpLexer.g4:117](/Users/sto/workspace/datomworld/antlr/php/PhpLexer.g4:117), [PhpParser.g4:38](/Users/sto/workspace/datomworld/antlr/php/PhpParser.g4:38), [cst.clj:41](/Users/sto/workspace/datomworld/src/clj/yang/php/antlr/cst.clj:41), and [PHP 8.3.35 zend_execute.c:4630](https://github.com/php/php-src/blob/php-8.3.35/Zend/zend_execute.c#L4630).\\\\n- **Runtime imports.** `%runtime` supplies the caller’s actual PHP runtime callable values. Bind the eval tree’s free `php/` names from that environment; do not instantiate another PHP runtime inside the installed artifact. Generate the environment from the existing definition inventory rather than maintaining another list. This supports bundled and linked callers without duplicating their globals, function tables, or class tables. The lowering already avoids naming `php.rt/*`, and the prelude has one definition inventory. See [lower.cljc:33](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:33), [prelude.cljc:32](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:32), and [prelude.cljc:5302](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:5302).\\\\n- **Entry retrieval.** Add a small profiled `code/entry` effect that retrieves a declared export from an **already installed, manifest-pinned module**. This is necessary: `try-require` returns a module name, not its exports. The accessor checks the installed manifest address and export name, then returns the receiver’s lowered binding. It neither parses nor installs code. Implement it through the existing effect-handler registry; no PHP-specific VM opcode or evaluator branch is needed. See [engine.cljc:1168](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:1168), [module.cljc:40](/Users/sto/workspace/datomworld/src/cljc/yin/vm/module.cljc:40), [module.cljc:153](/Users/sto/workspace/datomworld/src/cljc/yin/vm/module.cljc:153), and [engine.cljc:2737](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2737).\\\\n\\\\nThe compilation request carries source bytes, request identity, frontend/compiler revisions, eval goal, source provenance, and compilation options. **It carries no caller cells, values, continuation, or host handles.** Those stay with the suspended caller and become arguments only after installation. Source envelopes must preserve frontend metadata so the normal safepoint pass can find eval’s sites. See [yang.antlr.md:856](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:856), [core/stage.cljc:25](/Users/sto/workspace/datomworld/src/cljc/yang/core/stage.cljc:25), and [core/lower.cljc:76](/Users/sto/workspace/datomworld/src/cljc/yang/core/lower.cljc:76).\\\\n\\\\nHost policy:\\\\n\\\\n| Composition | Proposed behavior |\\\\n|---|---|\\\\n| JVM with configured compiler worker | Compile at runtime through the PHP worker. |\\\\n| Node/Dart with configured compiler service | Submit the same request; receive portable artifacts and execute locally. |\\\\n| Any host without a configured compiler | Refuse eval with the pinned `:yang.php/unsupported`, `:construct :eval` diagnostic. |\\\\n| Parserless host holding only the outer program | Still refuse; precompiling the outer program does not compile a future runtime string. |\\\\n\\\\nThe current PHP parser is explicitly JVM-only. Service-backed compilation is already an architectural alternative, distinct from offline local compilation. See [cst.clj:1](/Users/sto/workspace/datomworld/src/clj/yang/php/antlr/cst.clj:1) and [yang.antlr.md:493](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:493).\\\\n\\\\nPrecompiled eval artifacts may later satisfy the same request by an exact source/profile/provenance key. They must execute at the eval statement every time; artifact reuse must not become include-once behavior. This is optional caching, not the first implementation slice.\\\\n\\\\n**2. Exact symbol sharing, ownership, and budget**\\\\n\\\\nUse **one dictionary of variable-cell identities**, not a dictionary of copied values.\\\\n\\\\nFor a function containing eval, allocate its normal CV cells and adopt those exact cells into `%scope` before the body runs. Eval’s top-level `$x` lowers through `php/dict-*`; the caller’s ordinary `$x` may continue using its lexical CV. Both paths reach the same cell. A name introduced only by eval gets a cell through `php/scope-cell`. Existing dictionary operations already preserve reference markers and delegate assignment/unset to the local-cell operations. See [lower.cljc:3188](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3188), [prelude_module.cljc:129](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude_module.cljc:129), and [prelude.cljc:2158](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:2158).\\\\n\\\\nConsequently:\\\\n\\\\n```text\\\\ncaller CV $x ───────────────┐\\\\n                           ├── same task-local cell\\\\neval scope[\\\\\\\"x\\\\\\\"] ────────────┘\\\\n```\\\\n\\\\nThere is no copy-back phase, including on exceptions. Writes, reference rebinding, and unset become visible immediately. For global eval, pass `:php/globals`; the dictionary operations already dispatch that sentinel to the existing global operations. See [prelude_module.cljc:154](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude_module.cljc:154). This matches Zend’s use of the caller’s existing symbol table, rebuilding its CV projection when necessary. See [PHP 8.3.35 zend_vm_def.h:6068](https://github.com/php/php-src/blob/php-8.3.35/Zend/zend_vm_def.h#L6068).\\\\n\\\\nTwo implementation corrections are required:\\\\n\\\\n- **Recognize the actual Eval expression.** Scope analysis currently recognizes `\\\\\\\"eval\\\\\\\"` through `functionCallName`, while the grammar also defines a dedicated `Eval '(' expression ')'` alternative. Mark that expression’s owning scope dynamic without descending into nested function scopes. Test it directly; do not infer coverage from `\\\\\\\"eval\\\\\\\"` appearing in `dynamic-call?`. See [scope.cljc:113](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/scope.cljc:113), [scope.cljc:193](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/scope.cljc:193), and [PhpParser.g4:500](/Users/sto/workspace/datomworld/antlr/php/PhpParser.g4:500).\\\\n- **Release the complete dynamic scope.** Ordinary function exit must release `%scope` even when the static CV list is empty. Eval may create the function’s first variable. Generator cleanup must likewise release its dynamic dictionary, including eval-created cells, rather than only the original CV vector. Eval itself borrows this scope and must not release it on return. See [lower.cljc:3157](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3157), [lower.cljc:3191](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3191), and [prelude_module.cljc:146](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude_module.cljc:146).\\\\n\\\\nThis sharing stays inside one task. The compiler service receives syntax; the linker installs code; the caller applies that code to its own cells. It introduces no shared mutable heap between tasks, consistent with [datom.world.md:24](/Users/sto/workspace/datomworld/docs/design/datom.world.md:24).\\\\n\\\\n**Eval execution counts against the caller’s P7-a budget.** Mark the eval invocation as one `:call` site, after operand evaluation and before submitting compilation. Derive all eval-unit loop/call sites, including sites in functions declared by eval. Supply the caller’s active hook closures through `%hooks`, using local hook aliases in the derivation profile. Do not run `safepoint/program` for the eval unit: that function creates a new counter. See [safepoint.cljc:9](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/safepoint.cljc:9), [safepoint.cljc:23](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/safepoint.cljc:23), [safepoint.cljc:38](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/safepoint.cljc:38), and [yang/safepoint.cljc:96](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:96).\\\\n\\\\nUnbounded runs supply no-op budget hooks. Nested eval and later calls to eval-declared functions retain the same run hooks. Compiler parsing, hashing, transport waits, and publication use separate compiler limits; they are not PHP safepoint units. P7-a explicitly bounds execution between hooks rather than wall time or blocking host operations. See [yang.php.md:1928](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1928).\\\\n\\\\n**3. Scope and error decisions**\\\\n\\\\n| Case | Proposed rule |\\\\n|---|---|\\\\n| Nested eval | A new correlated compilation request; reuse the current scope and run context. Each eval has its own return escape. |\\\\n| Eval inside a function | Share that invocation’s dictionary, including parameters, statics already bound into CVs, and reference captures. Do not expose another invocation’s locals. |\\\\n| Global eval | Use `:php/globals`; ordinary assignments and `$GLOBALS` element operations reach the same global state. |\\\\n| Named functions/classes declared by eval | Register in the request’s normal declaration tables. They survive eval return and function return. Named function bodies get their normal function scope, not implicit capture of the eval caller’s locals. |\\\\n| Hoisting | Occurs when that eval unit executes, never while compiling the outer program. Reuse the unit’s function/class ordering, subject to the redeclaration correction below. |\\\\n| Methods/closures calling eval | Pass `$this`, lexical class scope, and called-class context explicitly; sharing variable scope alone is insufficient. |\\\\n| Namespace/import environment | Treat eval as a separate compilation unit; do not copy the caller’s `namespace`/`use` environment. Explicit declarations in eval establish its own environment. |\\\\n| Top-level eval `return` | Return from that eval only. Fall-through and bare `return` yield PHP null. |\\\\n\\\\nThe existing scope, declaration, hoisting, and included-context mechanisms are at [yang.php.md:179](/Users/sto/workspace/datomworld/docs/design/yang.php.md:179), [lower.cljc:3075](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3075), [lower.cljc:3682](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3682), [prelude.cljc:2293](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:2293), and [prelude.cljc:4120](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:4120). PHP’s eval contract establishes inherited variable scope, separate-unit compilation, persistent variable changes, and null/explicit-return results; Zend additionally preserves method scope and `$this`. See the [PHP eval manual](https://www.php.net/manual/en/function.eval.php) and [zend_vm_def.h:6068](https://github.com/php/php-src/blob/php-8.3.35/Zend/zend_vm_def.h#L6068).\\\\n\\\\nDo not blindly inherit the current class hoister’s “class already exists, skip” behavior. The eval path must distinguish “hoisted earlier in **this execution**” from “declared by an earlier eval.” The latter must not silently suppress a redeclaration. Pin exact fatal timing and catchability before changing the shared helper. See [prelude.cljc:3338](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:3338).\\\\n\\\\nFailure classification:\\\\n\\\\n- Invalid eval syntax becomes guest `ParseError`, with no eval statements executed. Add `CompileError extends Error` and `ParseError extends CompileError`; neither is in the current seed table. See [prelude.cljc:5114](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:5114) and the [PHP eval manual](https://www.php.net/manual/en/function.eval.php).\\\\n- Unsupported profile constructs retain their compiler diagnostics. Missing compiler/parser, worker failure, cancellation, resource limits, and link/admission failures remain operational outcomes, outside guest `Throwable` handling. Preserve their structured refusal in the run result instead of inventing a PHP exception or returning false. See [yang.antlr.md:4397](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:4397) and [yang.php.md:1948](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1948).\\\\n- Runtime guest exceptions use the existing caller handler stack. Mutations already made remain visible; eval introduces no transaction or rollback. The existing handler machinery is at [prelude.cljc:163](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:163).\\\\n\\\\nEval-local `static` declarations, strict-types details, magic constants, and coercion of non-string operands require oracle fixtures. Do not bind an eval-unit static declaration to the caller function’s persistent static table merely because eval shares its variables. The current unit-level static lowering is refused, so supporting it is a separate, explicit scope decision. See [lower.cljc:2878](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:2878).\\\\n\\\\n**4. Acceptance fixtures**\\\\n\\\\nAdd a distinct eval corpus group for §3.12 and P9’s symbol-table acceptance. Keep hand-derived expectations separate from oracle evidence: every unrecorded fixture remains `:oracle :pending`, including those with clear expected output. That follows the current P9 fixture convention; claimed behavior must be oracle-confirmed before landing. See [programs_p9.cljc:6](/Users/sto/workspace/datomworld/test/yang/php/antlr/programs_p9.cljc:6), [yang.php.md:2120](/Users/sto/workspace/datomworld/docs/design/yang.php.md:2120), and [yang.php.md:2436](/Users/sto/workspace/datomworld/docs/design/yang.php.md:2436).\\\\n\\\\nThe following are hand-derived expectations. Sources below omit the outer `<?php`.\\\\n\\\\n| Fixture | Source or precise case | Expected stdout |\\\\n|---|---|---|\\\\n| Global read/write/create | `$x=1; eval('$x=2; $y=3;'); echo $GLOBALS['x'],$y;` | `23` |\\\\n| Function local scope | `$x=90; function f(){ $x=2; eval('$x+=3; $y=7;'); return $x+$y; } echo f(),':',$x;` | `12:90` |\\\\n| Nested eval | `$x=1; $inner='$x+=2;'; eval('eval($inner); $x*=3;'); echo $x;` | `9` |\\\\n| Existing reference | `$a=1; $b=&$a; eval('$a=4;'); echo $a,$b;` | `44` |\\\\n| Eval-created reference | `$x=1; eval('$y =& $x;'); $y=9; echo $x;` | `9` |\\\\n| Unset and recreate | `$x=1; eval('unset($x);'); echo isset($x)?1:0; eval('$x=2;'); echo $x;` | `02` |\\\\n| Explicit global in local eval | `$g=1; function f(){ eval('global $g; $g=5;'); echo $g; } f(); echo $g;` | `55` |\\\\n| Fall-through result | `$r=eval('$x=1;'); echo $r===null?'N':'X'; echo $x;` | `N1` |\\\\n| Eval return boundary | `echo eval('return 7; echo \\\\\\\"X\\\\\\\";'),'A';` | `7A` |\\\\n| Mutation before exception | `$x=1; try { eval('$x=2; throw new Exception(\\\\\\\"e\\\\\\\");'); } catch(Exception $e){ echo $x; }` | `2` |\\\\n| Parse failure is atomic | `$x=1; try { eval('$x=2; @@@'); } catch(ParseError $e){ echo 'P'; } echo $x;` | `P1` |\\\\n| Declaration persistence | Function `f()` runs `eval('function made(){return 6;} class Made {}');`; after `f()` returns, print `made()` and `class_exists('Made',false)` | `61` |\\\\n| Empty-static-CV cleanup | `class C{function __destruct(){echo 'D';}} function f(){eval('$o=new C;');} f(); echo 'A';` | `DA` |\\\\n| Mixed HTML | `eval('echo \\\\\\\"A\\\\\\\"; ?>B<?php echo \\\\\\\"C\\\\\\\";');` | `ABC` |\\\\n\\\\nAlso author an operand-side-effect fixture proving the source expression runs once, and a closure/reference fixture proving eval sees the closure’s bound local cells. These exercise the same evaluation and ownership paths identified above, rather than a mocked symbol-table implementation.\\\\n\\\\nKeep these oracle-first cases pending without guessing exact diagnostic text or timing:\\\\n\\\\n| Fixture family | What the oracle must settle |\\\\n|---|---|\\\\n| Hoisting | Call before an unconditional function declaration; instantiate before a class declaration; conditional declarations; unavailable parent/interface/trait. |\\\\n| Repeated declarations | Same eval twice; collision with outer declarations/builtins; class/function fatal timing, catchability, and partial declaration visibility. |\\\\n| Method context | `$this`, private access, `self`, `parent`, late-static binding, rebound closures. |\\\\n| Separate compilation environment | Caller namespace and aliases versus eval’s explicit namespace/imports. |\\\\n| Eval-unit statics | Repeated eval and nested eval; lifetime independent of caller function statics. |\\\\n| Source identity | `__FILE__`, `__DIR__`, `__LINE__`, nested eval diagnostic locations and messages. |\\\\n| Operand/encoding | Scalar/null/array/object coercion; UTF-8 source bytes versus the PHP byte-string carrier; invalid byte sequences. |\\\\n| Errors | Duplicate declarations within one eval unit and other compile-time fatals versus runtime guest exceptions. |\\\\n| Generator lifecycle | Eval-created object/reference cleanup on completion, throw, and generator destruction. |\\\\n\\\\nThe encoding fixture is necessary because PHP runtime strings are byte carriers while the current parser accepts a host string and computes UTF-8 offsets. The bridge must avoid double encoding or silently replacing bytes. See [prelude.cljc:19](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:19) and [antlr/cst.clj:123](/Users/sto/workspace/datomworld/src/clj/yang/antlr/cst.clj:123).\\\\n\\\\nAdd operational fixtures independently of the PHP oracle:\\\\n\\\\n- Empty eval with budget zero; exhaustion inside an eval loop; repeated/nested eval sharing one counter; calling an eval-declared function after eval returns. Assert the existing fatal text and absence of guest catch/shutdown/destructor output.\\\\n- Missing compiler on JVM, Node, and Dart: the pinned eval refusal, without guest `ParseError`.\\\\n- Configured service on Node/Dart; delayed response; full request stream; duplicate response; cancellation and terminal transport loss. Assert one execution and preserved caller state.\\\\n- Same compiled artifact executed twice: assignments run twice; declarations are checked again.\\\\n- Canonical source and derivation remain retrievable.\\\\n\\\\nThese extend the current safepoint fatal tests and stream-stage retry contract. See [safepoint_test.clj:17](/Users/sto/workspace/datomworld/test/yang/php/antlr/safepoint_test.clj:17), [stage.cljc:16](/Users/sto/workspace/datomworld/src/cljc/yang/stage.cljc:16), and [yang/safepoint.cljc:26](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:26).\\\\n\\\\nEval must preserve the existing C5/C6/C11/C12/C13 restrictions. Passing unsupported source through eval must not bypass them, and the bridge must not claim those corners closed. Their existing classifications and P9 refusal fixtures are at [yang.php.md:2216](/Users/sto/workspace/datomworld/docs/design/yang.php.md:2216), [yang.php.md:2245](/Users/sto/workspace/datomworld/docs/design/yang.php.md:2245), and [builtin_surfaces_test.clj:18](/Users/sto/workspace/datomworld/test/yang/php/antlr/builtin_surfaces_test.clj:18).\\\\n\\\\n**5. Smallest engineer-round plan**\\\\n\\\\nThe plan is independent of the assigned engineer or delegate.\\\\n\\\\n1. **Pin contracts and oracle cases.** Add eval fixtures, request/outcome shapes, eval goal, runtime import inventory, and missing-compiler behavior. Keep the current refusal test until the supported path is available. Start with globals, function locals, return/null, references, syntax failure, and declaration timing.\\\\n2. **Build one JVM vertical path.** Add the eval parser goal and eval-unit emitter through the existing stage pipeline. Publish a code-only entry, retrieve it through the profiled installed-export accessor, and execute it using explicit runtime/scope/context arguments. Prove global write-back and local write-back through a real compiler request.\\\\n3. **Complete ownership and failure handling.** Fix Eval-expression scope recognition, empty-CV cleanup, generator dictionary cleanup, `ParseError` hierarchy, structured operational refusal, and declaration collision handling. The lifecycle and declaration fixtures are gates, not follow-up cleanup.\\\\n4. **Join the run context.** Derive eval sites using caller hook closures; verify one budget across eval, nested eval, and later declared-function calls. Keep compilation limits separate.\\\\n5. **Complete the execution matrix.** Run source-driven JVM tests on all four evaluators, then parserless/service-backed Node and Dart tests, in bundled and linked caller profiles wherever those profiles are claimed. The existing JVM harness already runs four evaluators, but its current budget wrapper covers only the initially supplied AST; runtime artifacts need their own derivation. See [e2e_harness.clj:91](/Users/sto/workspace/datomworld/test/yang/php/antlr/e2e_harness.clj:91).\\\\n\\\\nThe first vertical slice is a useful engineering checkpoint, **not P9 completion**. Landing support requires the claimed semantic fixtures to be recorded against PHP 8.3.35 and all remaining limitations to be explicitly classified under §17.3.\\\\n\\\\n**6. Draft §3.12 amendment**\\\\n\\\\nReplace the current two-sentence section at [yang.php.md:358](/Users/sto/workspace/datomworld/docs/design/yang.php.md:358) with:\\\\n\\\\n> `eval` submits a new compilation request through the configured compiler composition (`yang.antlr.md` sections 6.1 and 8.6). The VM does not parse source. The request pins the frontend/compiler profile and eval source goal; parsing begins in PHP mode and retains source spans relative to the supplied eval bytes.\\\\n>\\\\n> Eval executes its compiled unit in the caller’s task. A function containing eval uses the dynamic-scope profile. Its symbol table maps names to the caller’s existing CV cells; eval reads, writes, reference bindings and unset operate on those same cells. New variables enter that table. There is no value snapshot or copy-back step. At global scope the table is `$GLOBALS`. Eval borrows the scope; its owner releases the complete table at function or generator exit.\\\\n>\\\\n> Each eval has its own return boundary. An explicit return supplies eval’s result; falling through or returning without a value yields PHP null. Runtime exceptions propagate through the caller’s handlers, preserving earlier mutations. Invalid eval syntax raises guest `ParseError`. Compiler, transport, resource and admission failures remain operational outcomes.\\\\n>\\\\n> Eval is a separate compilation unit. Its declarations use the normal request-level function and class tables and remain available after eval returns. Hoisting occurs when the eval unit executes; repeated eval does not suppress redeclaration checks. The caller’s variable and method execution context is supplied explicitly; its namespace/import environment is not implicitly copied.\\\\n>\\\\n> Eval invocation and eval-generated loop/call sites use the caller’s active safepoint hooks. Nested eval and functions declared by eval consume the same run budget. Eval never initializes another budget counter. Compiler work and transport waits use separate composition limits.\\\\n>\\\\n> The current local PHP parser is JVM-only. Node and Dart may use an explicitly configured compiler service. Without a configured compiler, eval is refused with `:yang.php/diagnostic :yang.php/unsupported` and `:construct :eval`. Precompiling the enclosing program does not provide runtime eval support. Reused artifacts must match the compilation request and execute at every eval invocation.\\\\n>\\\\n> Eval retains the enclosing frontend’s supported and refused constructs. Its compiler bridge does not close unrelated P9 corners. Pending semantic details require pinned oracle fixtures before support is claimed.\\\\n\\\\nAlso update the P9 status wording to distinguish **builtin surfaces landed; eval bridge pending** until this acceptance gate passes. The row’s existing symbol-table acceptance should remain unchanged.\\\"}}\\n{\\\"type\\\":\\\"turn.completed\\\",\\\"usage\\\":{\\\"input_tokens\\\":1891336,\\\"cached_input_tokens\\\":1754112,\\\"cache_write_input_tokens\\\":0,\\\"output_tokens\\\":18371,\\\"reasoning_output_tokens\\\":7573}}\\nOracle lifecycle probes: eval compile-fatal (class collision) on php:8.3.35 (shiva docker)\\nlc1: output-before flushed; collision fatal uncatchable; SHUTDOWN FUNCTION RUNS after the fatal; destructors SUPPRESSED (created object's dtor did not fire); exit status 255\\nlc2: an eval is ATOMIC — all declarations in one eval commit together; a collision fatal kills the remainder of THAT eval and the process (S3 never ran); PRIOR evals' declarations persist (S2 observed, first eval's classes/functions live)\\nConsistency: matches the P5b2 oracle rows (fatal suppresses destructor output, shutdown runs, 255) — the existing guest/compile-fatal terminal path is the conforming engine policy.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:11:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/eval_coordinator.cljc src/cljc/yang/php/antlr/eval_admission.cljc'\",\"aggregated_output\":\"(ns yang.php.antlr.eval-coordinator\\n  \\\"Composition-supplied eval frontend: admit bytes, parse and validate source.\\n   This stage produces no executable artifact.\\\"\\n  (:require [yang.antlr.packet :as packet]\\n            [yang.php.antlr.cst :as cst]\\n            [yang.php.antlr.eval-admission :as admission]\\n            [yang.php.antlr.scope :as scope]))\\n\\n\\n(defn make-worker\\n  []\\n  (cst/make-eval-worker))\\n\\n\\n(defn compile-request\\n  \\\"Prepare one request for later eval-unit emission. Identity includes the\\n   complete request (including bytes and caller-supplied revisions/options),\\n   the source goal, grammar and admission profile. No caller runtime state is\\n   needed by this service.\\\"\\n  [worker request]\\n  (let [{:keys [source] :as admitted} (admission/admit-request request)]\\n    (if-not source\\n      admitted\\n      (let [pk (cst/parse-source worker (:yang.compile/unit request) source)\\n            identity {:request request\\n                      :yang.php/source (:yang.php/source request)\\n                      :yang.php.eval/profile-revision admission/profile-revision\\n                      :yang.php/source-goal :eval\\n                      :yang.php/grammar cst/grammar-id}]\\n        (if (:yang.php/not-php pk)\\n          {:request request :identity identity :cst pk}\\n          (let [validated (packet/validate! pk {:source source})]\\n            (cond-> {:request request :identity identity :cst validated}\\n              (= :yang.cst/ok (:yang.cst/outcome validated))\\n              (assoc :scope (scope/analyze validated)))))))))\\n(ns yang.php.antlr.eval-admission\\n  \\\"Strict UTF-8 admission for an eval source carried as one character per byte.\\n   This boundary does not execute or compile the admitted source.\\\"\\n  (:require [dao.host.text :as text])\\n  #?(:cljd (:import [\\\"dart:typed_data\\\" Uint8List])))\\n\\n\\n(def profile-revision :yang.php.eval/utf8-v1)\\n\\n\\n(defn- bad-sequence\\n  \\\"Return the first malformed interval. An invalid continuation is included;\\n   truncation ends at EOF. Illegal leaders occupy one byte.\\\"\\n  [bs]\\n  (let [n (count bs)]\\n    (loop [i 0]\\n      (when (< i n)\\n        (let [b (nth bs i)\\n              width (cond (< b 0x80) 1 (<= 0xc2 b 0xdf) 2\\n                          (<= 0xe0 b 0xef) 3 (<= 0xf0 b 0xf4) 4\\n                          :else 0)]\\n          (cond\\n            (zero? width) [i (inc i)]\\n            (= width 1) (recur (inc i))\\n            :else\\n            (let [end (loop [j 1]\\n                        (if (= j width)\\n                          nil\\n                          (let [p (+ i j)]\\n                            (cond\\n                              (>= p n) n\\n                              (let [v (nth bs p)]\\n                                (not (and (<= 0x80 v 0xbf)\\n                                          (or (not= j 1)\\n                                              (and (or (not= b 0xe0) (>= v 0xa0))\\n                                                   (or (not= b 0xed) (< v 0xa0))\\n                                                   (or (not= b 0xf0) (>= v 0x90))\\n                                                   (or (not= b 0xf4) (< v 0x90)))))))\\n                              (inc p)\\n                              :else (recur (inc j))))))]\\n              (if end [i end] (recur (+ i width))))))))))\\n\\n\\n(defn- host-bytes\\n  [bs]\\n  #?(:cljd (Uint8List.fromList bs)\\n     :clj (byte-array (map unchecked-byte bs))\\n     :cljs (js/Uint8Array. (clj->js bs))))\\n\\n\\n(defn admit\\n  \\\"Decode a byte carrier once. Malformed carriers are protocol violations;\\n   malformed UTF-8 produces the classified PHP diagnostic.\\\"\\n  [carrier]\\n  (if-not (string? carrier)\\n    {:reason :carrier-representation}\\n    (let [bs (mapv #(text/code-unit carrier %) (range (text/unit-count carrier)))]\\n      (if (some #(> % 255) bs)\\n        {:reason :carrier-representation}\\n        (if-let [[start end] (bad-sequence bs)]\\n          {:diagnostic {:yang.php/diagnostic :yang.php/unsupported\\n                        :construct :eval :reason :source-encoding :encoding :utf-8\\n                        :byte-offset start :span [start end]}}\\n          (let [source (text/utf8-decode (host-bytes bs))\\n                encoded (mapv #(bit-and % 255) (text/utf8-encode source))]\\n            (if (= bs encoded)\\n              {:source source}\\n              (throw (ex-info \\\"UTF-8 round trip failed\\\" {:reason :utf8-round-trip})))))))))\\n\\n\\n(defn admit-request\\n  \\\"Admit a sealed eval request, preserving correlation and provenance on refusal.\\n   On success the original request and its derived parser view travel together.\\\"\\n  [request]\\n  (let [{:keys [source diagnostic reason]} (admit (:yang.php/source request))]\\n    (cond\\n      diagnostic (assoc (select-keys request [:yang.compile/request :yang.compile/unit\\n                                              :yang.compile/provenance])\\n                        :yang.compile/outcome :yang.compile/rejected\\n                        :yang.compile/reason :yang.compile/unsupported\\n                        :yang.compile/diagnostic diagnostic)\\n      reason (assoc (select-keys request [:yang.compile/request :yang.compile/unit\\n                                          :yang.compile/provenance])\\n                    :yang.compile/outcome :yang.compile/rejected\\n                    :yang.compile/reason :yang.compile/invalid-request\\n                    :yang.compile/detail reason)\\n      :else {:request request :source source})))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:13:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"ls src/cljc/yang/php/antlr/*eval*; rg -n 'eval|compile' src/cljc/yang/php/antlr/eval* test/yang/php/antlr/eval* | head -180; rg -n 'prefix-refusals|eval-run|:eval|\\\\\\\"eval\\\\\\\"' src/cljc/yang/php/antlr/lower.cljc\\\"\",\"aggregated_output\":\"src/cljc/yang/php/antlr/eval_admission.cljc\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc\\nsrc/cljc/yang/php/antlr/eval_publication.cljc\\ntest/yang/php/antlr/eval_publication_test.clj:1:(ns yang.php.antlr.eval-publication-test\\ntest/yang/php/antlr/eval_publication_test.clj:7:            [yang.php.antlr.eval-coordinator :as coordinator]\\ntest/yang/php/antlr/eval_publication_test.clj:8:            [yang.php.antlr.eval-publication :as publication]\\ntest/yang/php/antlr/eval_publication_test.clj:14:        request {:yang.compile/request :r :yang.compile/unit :eval\\ntest/yang/php/antlr/eval_publication_test.clj:16:        prepared (coordinator/compile-request worker request)\\ntest/yang/php/antlr/eval_publication_test.clj:18:        result (publication/publish! store (harness/host-registry) 'eval.unit prepared)]\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:1:(ns yang.php.antlr.eval-admission\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:2:  \\\"Strict UTF-8 admission for an eval source carried as one character per byte.\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:3:   This boundary does not execute or compile the admitted source.\\\"\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:8:(def profile-revision :yang.php.eval/utf8-v1)\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:62:                        :construct :eval :reason :source-encoding :encoding :utf-8\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:72:  \\\"Admit 