(stream/append! (charged (get-in state [:composition :writer :handle]) allowance)\nsrc/cljc/dao/stream/remote_route.cljc:512:(defn acknowledge-ready\nsrc/cljc/dao/stream/udp.cljc:165:   reassembled datagram's event is appended to (`dao.stream/writer?`).\nsrc/cljc/dao/stream/udp.cljc:173:  (when-not (and (fn? send!) (stream/writer? traffic))\nsrc/cljc/dao/stream/udp.cljc:176:  (when (and (some? raw-traffic) (not (stream/reader? raw-traffic)))\nsrc/cljc/dao/stream/udp.cljc:293:  (stream/append! (:traffic @port)\nsrc/cljc/dao/stream/udp.cljc:342:                 (stream/reader? traffic)\nsrc/cljc/dao/stream/udp.cljc:344:                 (stream/reader? ring)\nsrc/cljc/dao/stream/udp.cljc:345:                 (stream/writer? ring))\nsrc/cljc/dao/stream/udp.cljc:368:            (stream/append! (:ring s) (:dao.stream.udp/value event)))\nsrc/cljc/dao/stream/udp.cljc:378:(defn reading-cursor\nsrc/cljc/dao/stream/remote_meet.cljc:62:     (if (= :dao.stream/append! (:dao.stream.remote/op req))\nsrc/cljc/dao/stream/remote_meet.cljc:86:       (when (and (= :dao.stream/append! (:dao.stream.remote/op req))\nsrc/cljc/dao/stream/remote_meet.cljc:146:                  (stream/append! h v))\nsrc/cljc/dao/stream/remote_meet.cljc:310:          (when-not (and (stream/reader? h) (stream/writer? h) (stream/closable? h))\nsrc/cljc/dao/stream/remote_meet.cljc:348:  (let [r (stream/append! (:board @m) post)]\nsrc/cljc/dao/stream/remote_meet.cljc:365:        (stream/append! (:board @m)\nsrc/cljc/dao/stream/remote_meet.cljc:372:          (stream/append! (:board @m) v)\nsrc/cljc/dao/stream/remote_meet.cljc:383:            (stream/append! (:board @m)\nsrc/cljc/dao/stream/remote_meet.cljc:440:           r (when-not expired? (stream/append! (:board @m) post))]\nsrc/cljc/dao/stream/remote_meet.cljc:444:     (stream/append! decision {:meet/active-pairs active-pairs\nsrc/cljc/dao/stream/ble/mesh.cljc:180:  (when-not (stream/writer? raw-writer)\nsrc/cljc/dao/stream/ble/mesh.cljc:183:  (when-not (stream/reader? raw-traffic)\nsrc/cljc/dao/stream/ble/mesh.cljc:186:  (when-not (stream/writer? deposit)\nsrc/cljc/dao/stream/ble/mesh.cljc:233:                         (stream/append!\nsrc/cljc/dao/stream/ble/mesh.cljc:320:                (try (stream/append!\nsrc/cljc/dao/stream/ble/links.cljc:299:(defn- append-deposits!\nsrc/cljc/dao/stream/ble/links.cljc:306:    (try (stream/append! deposit ev)\ntest/yin/vm/code_entry_test.cljc:23:           (module/get-effect-handler registry :code/entry)))\ntest/yin/vm/code_entry_test.cljc:24:    (is (= {:effect :code/entry :module 'eval.unit :address address :export 'entry}\ntest/yang/php/antlr/eval_emitter_test.clj:48:  (let [spec (lower/eval-module-spec (harness/host-registry)\ntest/yin/vm/linker_require_test.cljc:333:                           (app (app (v 'code/entry) (lit 'foo) (lit address) (lit 'f))))\n","exit_code":0,"status":"completed"}}
