gister r-address}\\\\\\\\n-                      :yin.module/exports (set exports)\\\\\\\\n-                      :yin.module/requires (or requires {})\\\\\\\\n-                      :yin.module/primitives\\\\\\\\n-                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\\\\\\\\n-                                    primitives))\\\\\\\\n-                      :yin.module/footprint fp}\\\\\\\\n+            ;; the C1 side table and its reverse record, materialized\\\\\\\\n+            ;; BEFORE the manifest so the manifest can reference them:\\\\\\\\n+            ;; the module closure follows manifest references, so only a\\\\\\\\n+            ;; referenced table travels with the module through transfer\\\\\\\\n+            call-sites (when (:rows claim)\\\\\\\\n+                         (let [table (jing/materialize! handle (:rows claim))\\\\\\\\n+                               record {:yang.call-site/version 1\\\\\\\\n+                                       :yang.call-site/root tree-address\\\\\\\\n+                                       :yang.call-site/origin (:origin claim)\\\\\\\\n+                                       :yang.call-site/table table}]\\\\\\\\n+                           {:record (jing/materialize! handle record)\\\\\\\\n+                            :table table\\\\\\\\n+                            :origin (:origin claim)\\\\\\\\n+                            :root (:root tree)}))\\\\\\\\n+            manifest (cond-> {:yin.module/name name\\\\\\\\n+                              :yin.module/schema linker/manifest-schema\\\\\\\\n+                              :yin.module/contracts\\\\\\\\n+                              {:yin.ast/code vm/ast-contract\\\\\\\\n+                               :yin.semantic/code vm/semantic-contract\\\\\\\\n+                               :yin.debruijn.code vm/stack-contract\\\\\\\\n+                               :yin.debruijn.register vm/register-contract}\\\\\\\\n+                              :yin.module/tree tree-address\\\\\\\\n+                              :yin.module/derivations\\\\\\\\n+                              {:yin.semantic/code (mint tree-address sem ledger/lowering-profile)\\\\\\\\n+                               :yin.debruijn.code\\\\\\\\n+                               (mint sem h linker/stack-lowering-profile)\\\\\\\\n+                               :yin.debruijn.register\\\\\\\\n+                               (mint sem r linker/register-lowering-profile)}\\\\\\\\n+                              :yin.module/index {:yin.debruijn.code h-address\\\\\\\\n+                                                 :yin.debruijn.register r-address}\\\\\\\\n+                              :yin.module/exports (set exports)\\\\\\\\n+                              :yin.module/requires (or requires {})\\\\\\\\n+                              :yin.module/primitives\\\\\\\\n+                              (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\\\\\\\\n+                                            primitives))\\\\\\\\n+                              :yin.module/footprint fp}\\\\\\\\n+                       call-sites (assoc :yin.module/call-sites\\\\\\\\n+                                         {:table (:table call-sites)\\\\\\\\n+                                          :record (:record call-sites)}))\\\\\\\\n             address (jing/materialize! handle manifest)\\\\\\\\n             walked (closure/walk handle address opts)]\\\\\\\\n         (if (not= :complete (:yin.link.closure/outcome walked))\\\\\\\\n@@ -201,23 +371,98 @@\\\\\\\\n                                                 (select-keys opts\\\\\\\\n                                                              [:bounds]))]))\\\\\\\\n                             code-formats)]\\\\\\\\n-            {:address address :manifest manifest\\\\\\\\n-             :identities {:yin.semantic/code sem\\\\\\\\n-                          :yin.debruijn.code sem\\\\\\\\n-                          :yin.debruijn.register sem}\\\\\\\\n-             :checksums {:yin.debruijn.code h :yin.debruijn.register r}\\\\\\\\n-             :links links}))))))\\\\\\\\n+            (cond-> {:address address :manifest manifest\\\\\\\\n+                     :identities {:yin.semantic/code sem\\\\\\\\n+                                  :yin.debruijn.code sem\\\\\\\\n+                                  :yin.debruijn.register sem}\\\\\\\\n+                     :checksums {:yin.debruijn.code h\\\\\\\\n+                                 :yin.debruijn.register r}\\\\\\\\n+                     :links links}\\\\\\\\n+              call-sites (assoc :call-sites call-sites))))))))\\\\\\\\n \\\\\\\\n \\\\\\\\n (defn publish-module!\\\\\\\\n   \\\\\\\\\\\\\\\"Mint all four code formats, derivation records, and one schema-1 manifest.\\\\\\\\n    `opts` `{:bounds {...}}` are the composition bounds (section 4.2 step\\\\\\\\n    2) of every closure walk and local link the publication runs, every\\\\\\\\n-   bound left out taking `linker/default-bounds`.\\\\\\\\\\\\\\\"\\\\\\\\n+   bound left out taking `linker/default-bounds`. `opts` may also pin\\\\\\\\n+   the publication's admission identity explicitly\\\\\\\\n+   (`:yin.link.publish/admission`) or scope it — a scope object from\\\\\\\\n+   `admission-scope` under `:yin.link.publish/scope`, whose counter the\\\\\\\\n+   caller owns; without either, the admission identity is derived from\\\\\\\\n+   the specification's own durable identity, so re-publishing the same\\\\\\\\n+   specification is the same recorded admission.\\\\\\\\\\\\\\\"\\\\\\\\n   ([handle spec] (publish-module! handle spec nil))\\\\\\\\n   ([handle spec opts] (publish-closure! handle spec opts)))\\\\\\\\n \\\\\\\\n \\\\\\\\n+(defn- stored-tree\\\\\\\\n+  \\\\\\\\\\\\\\\"The canonical row tree stored under `root` in `handle`, rebuilt\\\\\\\\n+   from its individually materialized rows (`vm/materialize-tree!`\\\\\\\\n+   stores each row body under its own address), or nil when a reached\\\\\\\\n+   row is absent.\\\\\\\\\\\\\\\"\\\\\\\\n+  [handle root]\\\\\\\\n+  (loop [queue [root]\\\\\\\\n+         rows {}]\\\\\\\\n+    (if (empty? queue)\\\\\\\\n+      {:root root, :rows rows}\\\\\\\\n+      (let [address (first queue)\\\\\\\\n+            body (jing/get handle address nil)]\\\\\\\\n+        (if-not (vector? body)\\\\\\\\n+          nil\\\\\\\\n+          (let [row (into [address] body)\\\\\\\\n+                kids (into []\\\\\\\\n+                           (mapcat (fn [[j [_ kind]]]\\\\\\\\n+                                     (let [pos (+ j 2)]\\\\\\\\n+                                       (case kind\\\\\\\\n+                                         :node [(nth row pos)]\\\\\\\\n+                                         :nodes (nth row pos)\\\\\\\\n+                                         nil))))\\\\\\\\n+                           (map-indexed vector\\\\\\\\n+                                        (get vm/semantic-bytecode-grammar\\\\\\\\n+                                             (nth row 1))))]\\\\\\\\n+            (recur (into (subvec queue 1)\\\\\\\\n+                         (remove #(contains? rows %) kids))\\\\\\\\n+                   (assoc rows address row))))))))\\\\\\\\n+\\\\\\\\n+\\\\\\\\n+(defn published-call-site-table\\\\\\\\n+  \\\\\\\\\\\\\\\"The C1 side table the module whose manifest is at `address` in\\\\\\\\n+   `handle` claims: `{:origin o :root r :rows [...] :tree tree}` with\\\\\\\\n+   the rows exactly as stored and the module's canonical tree, or nil\\\\\\\\n+   when the module made no C1 claim. The manifest references the table\\\\\\\\n+   and its reverse record (`:yin.module/call-sites`), so the reference —\\\\\\\\n+   not a recomputation — is what is resolved here: the rows are fetched\\\\\\\\n+   from the referenced table address and the ORIGIN is the one the\\\\\\\\n+   record RECORDED at publication (`:yang.call-site/origin`, held to be\\\\\\\\n+   a well-formed occurrence origin), beside the record's version, the\\\\\\\\n+   manifest's own tree, and the referenced table. Nothing reconstructs\\\\\\\\n+   an origin from content: a replay of this retrieval answers the\\\\\\\\n+   recorded admission identity, and no other module's admission can be\\\\\\\\n+   confused with it.\\\\\\\\\\\\\\\"\\\\\\\\n+  [handle address]\\\\\\\\n+  (let [manifest (jing/get handle address nil)\\\\\\\\n+        call-sites (:yin.module/call-sites manifest)]\\\\\\\\n+    (when (and (map? manifest) (:yin.module/tree manifest)\\\\\\\\n+               (map? call-sites) (jing/segment-address? (:table call-sites))\\\\\\\\n+               (jing/segment-address? (:record call-sites)))\\\\\\\\n+      (when-let [tree (stored-tree handle (:yin.module/tree manifest))]\\\\\\\\n+        (let [stored-rows (jing/get handle (:table call-sites) nil)\\\\\\\\n+              stored-record (jing/get handle (:record call-sites) nil)\\\\\\\\n+              origin (:yang.call-site/origin stored-record)]\\\\\\\\n+          (when (and (vector? stored-rows)\\\\\\\\n+                     (= {:yang.call-site/version 1\\\\\\\\n+                         :yang.call-site/root (:yin.module/tree manifest)\\\\\\\\n+                         :yang.call-site/table (:table call-sites)}\\\\\\\\n+                        (select-keys stored-record\\\\\\\\n+                                     [:yang.call-site/version\\\\\\\\n+                                      :yang.call-site/root\\\\\\\\n+                                      :yang.call-site/table]))\\\\\\\\n+                     (vm/occurrence-origin? origin))\\\\\\\\n+            {:origin origin, :root (:root tree), :rows stored-rows,\\\\\\\\n+             :tree tree}))))))\\\\\\\\n+\\\\\\\\n+\\\\\\\\n ;; =============================================================================\\\\\\\\n ;; Deriving a module from indexed code (5.3)\\\\\\\\n ;; =============================================================================\\\\\\\\n\\\\\\\",\\\\\\\"exit_code\\\\\\\":0,\\\\\\\"status\\\\\\\":\\\\\\\"completed\\\\\\\"}}\\\\n23:{\\\\\\\"type\\\\\\\":\\\\\\\"item.completed\\\\\\\",\\\\\\\"item\\\\\\\":{\\\\\\\"id\\\\\\\":\\\\\\\"item_10\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"command_execution\\\\\\\",\\\\\\\"command\\\\\\\":\\\\\\\"/bin/zsh -lc '/Library/Developer/CommandLineTools/usr/bin/git show 368297c3:collab/yang-clojure/1795310000000-owner-ruling-occurrence-identity-unitarity.md; /Library/Developer/CommandLineTools/usr/bin/git diff 368297c3...fa70516f -- src/cljc/yin/vm/macro.cljc'\\\\\\\",\\\\\\\"aggregated_output\\\\\\\":\\\\\\\"Created-Local: 2026-11-08 2x:xx +0700\\\\\\\\nCoding-Agent: interactive (ZCode, yang.clojure orchestrator seat)\\\\\\\\nStatus: DRAFT — pending owner sign-off (ruling text from the owner's words in session; filed verbatim-in-substance below)\\\\\\\\n\\\\\\\\n# OWNER RULING OF RECORD — occurrence identity under unitarity (resolves the codex cc1 gate reject)\\\\\\\\n\\\\\\\\n## The owner's principle (quoted-in-substance)\\\\\\\\n\\\\\\\\nThe compilation pipeline is transformation of values over dao.stream, so unitarity applies: **information is never lost**. The mapping is **bijective** — two things may compile to the same thing and should have the same content hash, but because of unitarity, **the complete history of the transformation is intact**. Two things may compile to the same thing and have the same hash **but have different history that can be recovered**.\\\\\\\\n\\\\\\\\n## Rulings derived (U1–U3)\\\\\\\\n\\\\\\\\n**U1 — an occurrence is not its content address.** The occurrence identity is **(content address, origin)** — the address as reached through a specific transformation event. \\\\\\\\\\\\\\\"Two occurrences of identical content\\\\\\\\\\\\\\\" is well-formed: they differ in history, not content. The per-occurrence origins in the call-site side table, keyed on `[origin root-address path]`, ARE the query that recovers the distinction (design §2.1/§2.3). Codex's P1-a objection (\\\\\\\\\\\\\\\"identical generated/input applications share an address, so provenance cannot be classified by content\\\\\\\\\\\\\\\") is ANSWERED: provenance is not classified by content — it is read from the retained history: the expansion-event record behind a `[:expansion record-address]` origin, the source position behind a `[:source …]` origin. Never minted, never guessed from content.\\\\\\\\n\\\\\\\\n**U2 — admission identity is history-recoverable, declared by the composition.** If the composition's history contains two admission events, bijectivity demands both are recoverable — collapsing them into one deterministic token loses information and violates unitarity. If the history contains one event, minting a fresh token fabricates history — the violation in the other direction. Only the composition knows which its history contains, so the composition DECLARES the distinction when it exists (the caller-owned admission scope / explicit `:yin.link.publish/admission` token), and the deterministic content-derived default is CORRECT precisely because re-publication of identical content with no declared distinction IS one event. Codex's P1-b objection is ANSWERED on these grounds: the requirement is not \\\\\\\\\\\\\\\"every admission mints a fresh token\\\\\\\\\\\\\\\" (that fabricates history) but \\\\\\\\\\\\\\\"every DISTINCT event is representable and recoverable\\\\\\\\\\\\\\\" (the scoped/explicit mechanism provides it; the composition supplies it when its history contains two events).\\\\\\\\n\\\\\\\\n**U3 — the general principle.** Identity is never minted from structure OR from process. Occurrence distinctness is either (i) READ from retained history (per-occurrence origins, expansion events), or (ii) DECLARED by the party whose history it is (composition-supplied admission identities). Provenance remains recoverable by address or query over datoms — axiom 2 holds in both channels.\\\\\\\\n\\\\\\\\n## Consequences\\\\\\\\n\\\\\\\\n- The cc1 branch state (d91489f7) STANDS as the implementation of U1/U2 — no further design-level code change is required to answer the codex reject; the objection is resolved on the record by this ruling.\\\\\\\\n- The landing sequence proceeds: astra re-check against this ruling → codex re-gate → merge to master → the exception track's R3 dispatch → adoption rounds 2–4 + D1.\\\\\\\\n- Addendum A's occurrence contract is unaffected in shape: K = [origin root-address path], `:yang/call-site 1`, the occurrence/content boundary — all unchanged. U1 clarifies WHAT an origin identifies (an event in the retained history), not how it attaches.\\\\\\\\n\\\\\\\\n— drafted by the yang.clojure orchestrator seat from the owner's ruling in session\\\\\\\\n\\\\\\\\n## Sign-off (owner, 2026-11-09 01:5x +07)\\\\\\\\n\\\\\\\\nThe owner reviewed U1–U3 and signed off verbatim: \\\\\\\\\\\\\\\"sign-off\\\\\\\\\\\\\\\". Status:\\\\\\\\n**RULING OF RECORD** — the codex cc1 gate reject (P1-a/P1-b) is answered on\\\\\\\\nthe record; the landing sequence proceeds (astra re-check → codex re-gate →\\\\\\\\nmerge). Signed off by the owner in session to the master-green orchestrator\\\\\\\\nseat, witnessed and recorded here.\\\\\\\\ndiff --git a/src/cljc/yin/vm/macro.cljc b/src/cljc/yin/vm/macro.cljc\\\\\\\\nindex 59d4b343..07240a92 100644\\\\\\\\n--- a/src/cljc/yin/vm/macro.cljc\\\\\\\\n+++ b/src/cljc/yin/vm/macro.cljc\\\\\\\\n@@ -2,7 +2,11 @@\\\\\\\\n   \\\\\\\\\\\\\\\"The row-native macro expander (`docs/design/yin.vm.macro.md`, Phase 1).\\\\\\\\n \\\\\\\\n    A process between two media: it observes `program-in` batches\\\\\\\\n-   `[:yin.program/batch trees run-index declaration-rows harvest-rows]`,\\\\\\\\n+   `[:yin.program/batch trees run-index declaration-rows harvest-rows\\\\\\\\n+   call-site-claims]` — the trailing element present only when some\\\\\\\\n+   member's frontend claimed call-site (C1) coverage, holding one\\\\\\\\n+   boolean verdict per member, so every older five-element batch is\\\\\\\\n+   still a valid unclaimed batch —\\\\\\\\n    rewrites the selected tree to a fixpoint, and appends one canonical tree\\\\\\\\n    packet `[root rows]` to `program-out`, with one event row per attempt on\\\\\\\\n    an optional log medium. Evaluators know nothing of any of this (decision\\\\\\\\n@@ -377,9 +381,9 @@\\\\\\\\n (defn- batch-shape-ok?\\\\\\\\n   [batch]\\\\\\\\n   (and (vector? batch)\\\\\\\\n-       (= 5 (count batch))\\\\\\\\n+       (<= 5 (count batch) 6)\\\\\\\\n        (= :yin.program/batch (nth batch 0))\\\\\\\\n-       (let [[_ trees run-index decls harvest] batch]\\\\\\\\n+       (let [[_ trees run-index decls harvest claim] batch]\\\\\\\\n          (and (vector? trees) (seq trees)\\\\\\\\n               (integer? run-index) (<= 0 run-index) (< run-index (count trees))\\\\\\\\n               (vector? decls)\\\\\\\\n@@ -389,7 +393,11 @@\\\\\\\\n               (vector? harvest)\\\\\\\\n               (every? #(and (vector? %) (= 4 (count %))\\\\\\\\n                             (= :yin.macro/harvest (first %)))\\\\\\\\n-                      harvest)))))\\\\\\\\n+                      harvest)\\\\\\\\n+              (or (nil? claim)\\\\\\\\n+                  (and (vector? claim)\\\\\\\\n+                       (= (count claim) (count trees))\\\\\\\\n+                       (every? boolean? claim)))))))\\\\\\\\n \\\\\\\\n \\\\\\\\n (defn- merge-indexes\\\\\\\\n@@ -587,12 +595,68 @@\\\\\\\\n           (mapcat second packets)))\\\\\\\\n \\\\\\\\n \\\\\\\\n+(def ^:private pending-expansion-origin\\\\\\\\n+  \\\\\\\\\\\\\\\"The construction origin the prelude attaches to every node the\\\\\\\\n+   macro's code builds during one invocation (ruling U1: identity comes\\\\\\\\n+   from the construction event, never from comparing content\\\\\\\\n+   addresses). `expand-call` substitutes the recorded expansion event's\\\\\\\\n+   `[:expansion record-address]` origin for it when the output's\\\\\\\\n+   occurrence correspondence is read — the placeholder never reaches a\\\\\\\\