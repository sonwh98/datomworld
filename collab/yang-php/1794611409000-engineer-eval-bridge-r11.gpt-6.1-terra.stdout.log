{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '460,520p' src/cljc/yin/vm/linker/pair.cljc; rg -n 'defn (make-stream|segment-key)' test/yin/vm/test_utils.cljc src/cljc/dao/jing.cljc; sed -n '1,110p' test/yang/php/antlr/e2e_harness.clj; rg -n ':yang.cst/outcome|:yang.cst/' src/cljc/yang/antlr/packet.cljc | head -30\"","aggregated_output":"   `{:pair pair :pending pending :progress? bool :dht node :admission a}`,\n   `:progress?` true when at least one response or admission question\n   was appended, so the shell knows the round moved something; a\n   pending entry a closure load holds names that load's manifest under\n   `:manifest`, one awaiting a first head names those principals under\n   `:principals`, and one parked on an admission question names its id\n   under `:admission`.\n\n   `admission` is the composition's admission state\n   (`yin.vm.linker.admission/make-state`, yin.vm.linker.dht.md 7.5): the\n   successor state is answered under `:admission`, with the question\n   and answer of every request whose response landed dropped.\"\n  [{:keys [pair source dht admission serve-dht]} budget]\n  (loop [pair pair\n         node dht\n         admission admission\n         remaining budget\n         pending []\n         progress? false]\n    (let [done {:pair pair, :pending pending, :progress? progress?,\n                :dht node, :admission admission}]\n      (if (zero? remaining)\n        done\n        (let [r (stream/next (:requests pair) (:cursor pair))]\n          (if-not (= :dao.stream/ok (:dao.stream/outcome r))\n            ;; blocked, or a gap: nothing more is answerable this round\n            done\n            (let [request (:dao.stream/value r)\n                  link-id (:yin.link/id request)\n                  res (answer source node admission request serve-dht)\n                  {:keys [node body waits heads asking asked?]} res\n                  admission (get res :admission admission)\n                  answered? (and (not= pending-body body)\n                                 (respond! pair request body))]\n              (if answered?\n                (recur (assoc pair :cursor (:dao.stream/cursor r))\n                       node\n                       (some-> admission (admission/settle link-id))\n                       (dec remaining)\n                       pending\n                       true)\n                {:pair pair\n                 :pending (conj pending\n                                (cond-> {:name (:yin.link/name request)\n                                         :yin.link/id link-id}\n                                  waits (assoc :manifest waits)\n                                  heads (assoc :principals heads)\n                                  asking (assoc :admission asking)))\n                 :progress? (or progress? (true? asked?))\n                 :dht node\n                 :admission admission}))))))))\n\n\n(defn serve\n  \"Serve requests over the legacy composition, draining answers once.\"\n  ([comp] (serve comp serve-budget))\n  ([comp budget]\n   (serve-requests\n     (update comp :admission #(some-> % (admission/drain budget)))\n     budget)))\n\ntest/yin/vm/test_utils.cljc:41:(defn make-stream\nsrc/cljc/dao/jing.cljc:223:(defn segment-key\n(ns yang.php.antlr.e2e-harness\n  \"The JVM end-to-end harness: PHP source -> CST packet -> lowering stage ->\n   program envelope -> the bundled program on each of the four VMs. Output\n   is the unit's bottom buffer, a latin-1 byte carrier, decoded as UTF-8\n   here at the boundary.\"\n  (:require\n    [dao.host.text :as text]\n    [dao.stream :as stream]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yang.php.antlr.safepoint :as hooks]\n    [yang.core.uast :as u]\n    [yang.safepoint :as safepoint]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.encoder :as encoder]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn host-registry\n  \"The registry the PHP compositions run over.\"\n  []\n  (portable/host-registry))\n\n\n(def ^:private base-opts\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :primitives vm/primitives})\n\n\n(def ^:private load-semantic\n  (vm/fresh-code-loader semantic/load-ast vm/ast-contract))\n\n\n(defn request-node\n  \"The `run-main` second-operand node the composition supplies for `request`:\n   the harness converts the record to UAST itself — lowering never embeds\n   request data.\"\n  [request]\n  (u/sexp->uast (or request :php/null)))\n\n\n(defn lower-program\n  \"`{:ast a :warnings w}` for `source` through the lowering stage, or\n   `{:diagnostics d}`. Warning-severity diagnostics do not stop the program.\n  The request record travels the composition path: the harness consumes it\n  (a plain record here) and composes it as `run-main`'s second operand —\n  lowering itself never sees request data.\"\n  ([source] (lower-program source nil))\n  ([source request]\n   (let [cst-log (tu/new-memory-log)\n         program (tu/new-memory-log)\n         diagnostics (tu/new-memory-log)]\n     (stream/append! cst-log (cst/parse-source source))\n     (lower/step-stage (lower/open-stage cst-log program diagnostics\n                                         (cond-> {:medium lower/program-medium}\n                                           (some? request) (assoc :request-node\n                                                                  (request-node request)))))\n     (let [{warnings true, problems false}\n           (group-by #(= :warning (:severity %)) (tu/drain diagnostics))]\n       (if (seq problems)\n         {:diagnostics problems}\n         (let [{:yin/keys [batch root] :as envelope} (first (tu/drain program))]\n           {:ast (nth batch root), :envelope envelope, :warnings (vec warnings)}))))))\n\n\n(defn packet->form\n  \"The nested form of a CST packet, spans dropped: `[:rule child ...]` for a\n   rule, `[\\\"TYPE\\\" \\\"text\\\"]` for a token. The inverse of\n   `portable-harness/packet`.\"\n  [{:yang.cst/keys [root nodes]}]\n  (letfn [(form\n            [id]\n            (let [{:keys [kind rule type text children]} (nth nodes id)]\n              (if (= :token kind)\n                [type text]\n                (into [(keyword rule)] (map form) children))))]\n    (form root)))\n\n\n(defn latin1->text\n  \"The UTF-8 text of the byte carrier `s`.\"\n  [s]\n  (text/utf8-decode (.getBytes ^String s \"ISO-8859-1\")))\n\n\n(defn render\n  \"The text a unit prints: its output, then, for an uncaught error, the\n   fatal line (no path, plan section 3.9).\"\n  [{:php/keys [out uncaught fatal]}]\n  (str (latin1->text out)\n       (when uncaught\n         (str \"PHP Fatal error:  Uncaught \" (:class uncaught) \": \" (:message uncaught)))\n       (when fatal\n         (str \"PHP Fatal error:  \" fatal))))\n\n\n(defn run-vms\n  \"`{vm-key rendered}` of `ast` on the four VMs; a host throw is\n   `[:thrown message]`. `:execution-budget` derives the PHP safepoint hooks\n   and starts one per-run counter; no option leaves the AST unchanged.\"\n  ([registry ast] (run-vms registry ast {}))\n  ([registry ast {:keys [execution-budget envelope]}]\n   (let [profile (cond-> hooks/ticks-profile\n10:     {:yang.cst/version 1\n11:      :yang.cst/unit u\n12:      :yang.cst/grammar id\n13:      :yang.cst/outcome :yang.cst/ok | :yang.cst/syntax-error | :yang.cst/source-error\n14:      :yang.cst/root 0                       ; ok only\n15:      :yang.cst/nodes [record ...]           ; ok only, preorder, id = index\n16:      :yang.cst/errors [error ...]           ; non-ok only\n17:      :yang.cst/complete true}\n48:     6. Any syntax error yields an error packet with :yang.cst/errors and no\n50:     7. :yang.cst/grammar names the grammar revision and tool; the target does\n117:  {:yang.cst/version packet-version,\n118:   :yang.cst/unit unit,\n119:   :yang.cst/grammar grammar-id,\n120:   :yang.cst/complete true})\n126:         :yang.cst/outcome :yang.cst/source-error\n127:         :yang.cst/errors [(merge {:kind :source-error, :message message}\n206:  (let [outcome (:yang.cst/outcome packet)\n207:        errors (:yang.cst/errors packet)\n210:      (not= packet-version (:yang.cst/version packet))\n212:      (not (contains? packet :yang.cst/unit))\n214:      (blank-string? (:yang.cst/grammar packet))\n216:      (not (true? (:yang.cst/complete packet)))\n218:      (not (contains? #{:yang.cst/ok :yang.cst/syntax-error :yang.cst/source-error}\n221:      (and (= :yang.cst/ok outcome) (contains? packet :yang.cst/errors))\n223:      (and (= :yang.cst/ok outcome) (not= 0 (:yang.cst/root packet)))\n225:      (and (not= :yang.cst/ok outcome)\n226:           (or (contains? packet :yang.cst/nodes)\n227:               (contains? packet :yang.cst/root)))\n229:      (and (contains? #{:yang.cst/syntax-error :yang.cst/source-error} outcome)\n239:  (let [kind ({:yang.cst/syntax-error :syntax-error,\n","exit_code":0,"status":"completed"}}
