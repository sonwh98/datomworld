{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' test/yang/php/antlr/eval_emitter_test.clj; sed -n '1,160p' src/cljc/dao/stream.cljc; sed -n '410,460p' src/cljc/yin/vm/linker/pair.cljc; sed -n '180,300p' src/cljc/yang/php/antlr/siteset.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' test/yang/php/antlr/eval_emitter_test.clj; sed -n '1,160p' src/cljc/dao/stream.cljc; sed -n '410,460p' src/cljc/yin/vm/linker/pair.cljc; sed -n '180,300p' src/cljc/yang/php/antlr/siteset.cljc\"","aggregated_output":"(ns yang.php.antlr.eval-emitter-test\n  (:require [clojure.test :refer [deftest is]]\n            [dao.host.text :as text]\n            [yang.core.prelude :as core-prelude]\n            [yang.core.uast :as u]\n            [yang.php.antlr.e2e-harness :as harness]\n            [yang.php.antlr.eval-coordinator :as coordinator]\n            [yang.php.antlr.lower :as lower]\n            [yang.php.antlr.prelude :as prelude]))\n\n\n(defn- packet\n  [source]\n  (:cst (coordinator/compile-request\n          (coordinator/make-worker)\n          {:yang.compile/unit :eval\n           :yang.php/source (text/units->string (map #(bit-and % 255) (text/utf8-encode source)))})))\n\n\n(deftest eval-entry-borrows-runtime-and-scope\n  (let [entry (:ast (lower/eval-entry (packet \"$x = 2; return $x;\")))\n        free (core-prelude/free-names entry)]\n    (is (= :lambda (:type entry)))\n    (is (= '[%runtime %scope %ctx %hooks] (:params entry)))\n    (is (not-any? #(= \"php\" (namespace %)) free))\n    (is (not (contains? free '%scope)))\n    (is (not (contains? free '%ctx)))))\n\n\n(deftest eval-entry-binds-derived-hooks\n  (let [entry (:ast (lower/eval-entry (packet \"while (false) {}\")))\n        params (into #{} (mapcat :params) (filter #(and (map? %) (= :lambda (:type %)))\n                                                  (tree-seq coll? seq entry)))]\n    (is (= '%eval-loop (:loop lower/eval-hook-profile)))\n    (is (= '%eval-call (get-in lower/eval-hook-profile [:call :hook])))\n    (is (= '%eval-line (get-in lower/eval-hook-profile [:line :hook])))\n    (is (every? params '[%eval-loop %eval-call %eval-line]))))\n\n\n(deftest runtime-environment-uses-prelude-inventory\n  (let [free (core-prelude/free-names (lower/eval-runtime-node))]\n    (is (contains? free 'php/dict-get))\n    (is (contains? free 'php/call-ec))\n    (is (not-any? #(= \"php.rt\" (namespace %)) free))))\n\n\n(deftest eval-module-is-code-only\n  (let [spec (lower/eval-module-spec (harness/host-registry)\n                                     'eval.test (packet \"return 7;\"))]\n    (is (= 'eval.test (:name spec)))\n    (is (= '#{entry} (:exports spec)))\n    (is (empty? (:requires spec)))\n    (is (= '#{entry} (core-prelude/defined-keys (:ast spec))))))\n\n\n(deftest eval-entry-runs-with-the-callers-runtime\n  (let [entry (:ast (lower/eval-entry (packet \"$x = 2; return $x;\")))\n        invoke (u/app entry (lower/eval-runtime-node) (u/lit :php/globals)\n                      (u/lit :php/null) (u/lit {}))\n        main (u/app (u/v 'php/run-main)\n                    (u/lam [] (u/app (u/v 'php/echo) (u/app (u/v 'php/to-string) invoke)))\n                    (u/lit :php/null))\n        ast (u/then prelude/uast main)]\n    (is (= {:ast-walker \"2\", :semantic \"2\", :stack \"2\", :register \"2\"}\n           (harness/run-vms (harness/host-registry) ast)))))\n(ns dao.stream\n  \"DaoStream v2: passive substrate for IO in datom.world.\n\n   Seven operations:\n     Five handle operations (protocols implemented per declared surface):\n       descriptor (universal reachability and identity projection)\n       cursor     (reader surface)\n       next       (reader surface)\n       append!    (writer surface)\n       close!     (closable surface)\n     Two transport entry functions (per-transport, host-composed):\n       create!    (creates a new logical stream from a creation specification)\n       attach!    (attaches to an existing stream via portable descriptor)\n\n   Result Convention:\n     Every operation returns an open outcome map keyed by :dao.stream/outcome.\n     All qualified keywords live under :dao.stream/…\n     Each operation has an exhaustive, closed outcome set.\"\n  (:refer-clojure :exclude [next]))\n\n\n;; =============================================================================\n;; The Seven Operations and Standard Keywords\n;; =============================================================================\n\n(def operations\n  \"The seven DaoStream v2 operations.\"\n  #{:create! :attach! :descriptor :cursor :next :append! :close!})\n\n\n(def surfaces\n  \"The public operational surfaces a handle may declare.\"\n  #{:reader :writer :closable})\n\n\n;; Anchors\n(def anchor-oldest\n  \"Earliest retained position on the stream.\"\n  :dao.stream/oldest)\n\n\n(def anchor-newest\n  \"Positioned after the newest appended value (observes next arrival).\"\n  :dao.stream/newest)\n\n\n(def standard-anchors\n  \"Contract-defined anchor keywords.\"\n  #{anchor-oldest anchor-newest})\n\n\n;; Closed outcome sets per operation (contract exhaustive tables)\n(def outcomes-create\n  #{:dao.stream/ok\n    :dao.stream/invalid-spec\n    :dao.stream/not-found\n    :dao.stream/transport-error})\n\n\n(def outcomes-attach\n  #{:dao.stream/ok\n    :dao.stream/invalid-descriptor\n    :dao.stream/not-found\n    :dao.stream/transport-error})\n\n\n(def outcomes-descriptor\n  #{:dao.stream/ok})\n\n\n(def outcomes-cursor\n  #{:dao.stream/ok\n    :dao.stream/invalid-anchor\n    :dao.stream/closed\n    :dao.stream/refused\n    :dao.stream/transport-error})\n\n\n(def outcomes-next\n  #{:dao.stream/ok\n    :dao.stream/blocked\n    :dao.stream/end\n    :dao.stream/gap\n    :dao.stream/cursor-mismatch\n    :dao.stream/invalid-cursor\n    :dao.stream/refused\n    :dao.stream/transport-error})\n\n\n(def outcomes-append\n  #{:dao.stream/ok\n    :dao.stream/full\n    :dao.stream/invalid-value\n    :dao.stream/closed\n    :dao.stream/refused\n    :dao.stream/transport-error})\n\n\n(def outcomes-close\n  #{:dao.stream/ok})\n\n\n(def operation-outcomes\n  \"Map of operation keyword to its closed outcome set.\"\n  {:create! outcomes-create\n   :attach! outcomes-attach\n   :descriptor outcomes-descriptor\n   :cursor outcomes-cursor\n   :next outcomes-next\n   :append! outcomes-append\n   :close! outcomes-close})\n\n\n(def outcome-required-keys\n  \"Map from [operation outcome] to required keys in the result map.\"\n  {[:create! :dao.stream/ok] #{:dao.stream/handle}\n   [:attach! :dao.stream/ok] #{:dao.stream/handle}\n   [:descriptor :dao.stream/ok] #{:dao.stream/descriptor :dao.stream/identity}\n   [:cursor :dao.stream/ok] #{:dao.stream/cursor}\n   [:next :dao.stream/ok] #{:dao.stream/value :dao.stream/cursor}\n   [:next :dao.stream/gap] #{:dao.stream/cursor}})\n\n\n;; =============================================================================\n;; Canonical Operation Resolution Helper\n;; =============================================================================\n\n(defn canonical-op\n  \"Normalizes op to canonical keyword (:create!, :attach!, :descriptor,\n   :cursor, :next, :append!, :close!). Supports aliases without '!'.\"\n  [op]\n  (case op\n    (:create :create!) :create!\n    (:attach :attach!) :attach!\n    (:descriptor) :descriptor\n    (:cursor) :cursor\n    (:next) :next\n    (:append :append!) :append!\n    (:close :close!) :close!\n    nil))\n\n\n;; =============================================================================\n;; Handle Protocols (Five Handle Operations)\n;; =============================================================================\n\n(defprotocol IDaoStreamDescriptor\n  \"Universal reachability and identity projection. Belongs to no surface:\n   implemented by every handle regardless of declared reader/writer/closable surfaces.\"\n\n  (descriptor\n    [handle]\n    \"Returns descriptor outcome map:\n     {:dao.stream/outcome :dao.stream/ok\n      :dao.stream/descriptor <portable-descriptor>\n      :dao.stream/identity <logical-stream-identity>}\"))\n\n\n(defprotocol IDaoStreamReader\n  \"Reader surface: positioned, non-destructive observation via immutable cursors.\"\n      (nil? name)\n      {:node node\n       :body {:status :refused, :reason :invalid-request,\n              :defect :yin.repl/name-required}}\n\n      dht? (if serve-dht\n             (serve-dht source node admission request)\n             {:node node, :body pending-body})\n\n      :else\n      {:node node\n       :body (if-let [address (get (:name-env source) name)]\n               (let [d (stage-decision\n                         source\n                         {:store (get-in source [:content :store]),\n                          :datoms [],\n                          :principals (:principals source)}\n                         request address)]\n                 (if (:refused d)\n                   (:refused d)\n                   (annotated (attempt source request (:address d))\n                              (:extra d))))\n               {:status :refused, :reason :absent, :name name})})))\n\n\n(defn- respond!\n  \"Append `body` under the request's id on the response stream.  Returns\n   true when it landed, so the interpreter's cursor advances past the\n   request only then; a refused append leaves it to be re-read.\"\n  [pair request body]\n  (let [o (stream/append! (:responses pair)\n                          (assoc body :yin.link/id (:yin.link/id request)))]\n    (= :dao.stream/ok (:dao.stream/outcome o))))\n\n\n(defn serve-requests\n  \"One serve round of the interpreter over the link pair: read every\n   request `pair`'s cursor has not yet consumed and answer each in\n   request order, at most `budget` of them.  The first request nothing\n   can answer yet stops the round -- the requests behind it keep their\n   order -- and is reported under `:pending`; its cursor stays, so a\n   later round re-reads and re-attempts it.  A response the response\n   medium refuses reports its request pending the same way, and the\n   round reports no progress.  A content source links each manifest under\n   the composition's `:derivation` policy (`composition`'s option,\n   `:verifying` unless the composition asked for `:trusted`), and an\n   `:ok` response of a lowered format names its `:trust`.  `dht` is the\n   composition's node, which the signed-name source reads and advances,\n   and `serve-dht` its interpreter's answering function (`answer`).\n   Returns\n   `{:pair pair :pending pending :progress? bool :dht node :admission a}`,\n          (cond\n            (absent? body) (missing id)\n            slots (recur (into (pop todo)\n                               (mapcat (fn [[_ kind] v]\n                                         (case kind\n                                           :node [v]\n                                           :nodes v\n                                           nil))\n                                       slots\n                                       (rest body)))\n                         (assoc rows id (into [id] body)))\n            :else nil)))\n      {:root root, :rows rows})))\n\n\n(defn- overlay\n  \"A write-buffering handle over `base`: reads see the buffer first, then\n   `base`; puts land in the buffer only, in put order. `flush!` writes the\n   buffer to `base`; dropping the overlay writes nothing.\"\n  [base]\n  (let [buf (atom {:bytes {}, :order []})\n        sentinel #?(:cljs (js-obj)\n                    :default (Object.))]\n    {:handle (assoc base\n                    :get-bytes-fn (fn [address not-found]\n                                    (let [bs (get-in @buf [:bytes address])]\n                                      (if (nil? bs)\n                                        ((:get-bytes-fn base) address not-found)\n                                        bs)))\n                    :put-bytes-fn (fn [address bs]\n                                    (if (or (contains? (:bytes @buf) address)\n                                            (let [existing ((:get-bytes-fn base)\n                                                            address\n                                                            sentinel)]\n                                              (and (some? existing)\n                                                   (not (identical? sentinel\n                                                                    existing)))))\n                                      :present\n                                      (do (swap! buf (fn [b]\n                                                       (-> b\n                                                           (assoc-in [:bytes address]\n                                                                     bs)\n                                                           (update :order conj\n                                                                   address))))\n                                          :inserted))))\n     :flush! (fn []\n               (let [{:keys [bytes order]} @buf]\n                 (doseq [a order] ((:put-bytes-fn base) a (get bytes a)))))}))\n\n\n(defn- stage-refusal\n  [reason manifest]\n  {:status :refused, :reason reason, :manifest manifest})\n\n\n(defn- stage-admit\n  [handle manifest records]\n  (let [m (read-at handle manifest)]\n    (cond\n      (absent? m) (missing manifest)\n      (not (map? m)) (stage-refusal :yang.php.antlr/site-set-mismatch manifest)\n      (empty? records) (stage-refusal :yang.php.antlr/missing-site-set manifest)\n      :else\n      (loop [[a & more] records]\n        (if-not a\n          (stage-refusal :yang.php.antlr/site-set-mismatch manifest)\n          (let [record (read-at handle a)\n                set-address (when (map? record) (:yang.site/set record))\n                sites (when set-address (read-at handle set-address))]\n            (cond\n              (absent? record) (missing a)\n              (absent? sites) (missing set-address)\n              (verify handle manifest a) {:status :ok, :record a}\n              :else (recur more))))))))\n\n\n(defn- derive-closure\n  [ctx registry requirement records manifest derived]\n  (let [handle (:store ctx)\n        runtime (or (:runtime requirement) '#{php php.sp yang.call})\n        candidates (into (vec (get records manifest))\n                         (discover (:datoms ctx) (:principals ctx) manifest))\n        admitted (stage-admit handle manifest candidates)]\n    (if (not= :ok (:status admitted)) admitted\n        (let [m (read-at handle manifest)\n              deps (sort-by (comp str key)\n                            (remove (comp runtime key) (:yin.module/requires m)))\n              below (reduce (fn [acc [name address]]\n                              (if (contains? (:derived acc) address) acc\n                                  (let [r (derive-closure ctx registry requirement records\n                                                          address (:derived acc))]\n                                    (if (= :ok (:status r))\n                                      (assoc acc :derived (:derived r))\n                                      (reduced (cond-> r\n                                                 (nil? (:name r)) (assoc :name name)\n                                                 true (assoc :via manifest)))))))\n                            {:derived derived} deps)]\n          (if (:status below) below\n              (let [tree (load-tree handle (:yin.module/tree m))]\n                (cond\n                  (= :missing (:status tree)) tree\n                  (nil? tree) (stage-refusal :yang.php.antlr/instrumentation-failed manifest)\n                  :else\n                  (try\n                    (let [d (derive-verified handle manifest (:record admitted) tree\n                                             (:hooks-profile requirement))\n                          ast (when d (u/then (core-module/require-node 'php.sp)\n                                              (vm/semantic-bytecode->ast (:tree d))))\n                          requires (assoc (into {} (map (fn [[n a]]\n                                                          [n (if (contains? runtime n) a\n                                                                 (get (:derived below) a a))]))\n                                                (:yin.module/requires m))\n                                          'php.sp (:php-sp requirement))\n                          primitives (when ast\n                                       (core-module/free-primitives\n                                         :yang.php/error :yang.php/undeclared registry\n                                         (set (keys requires)) ast))\n                          out (when ast (publish/publish-module!\n                                          handle {:name (:yin.module/name m), :ast ast,\n                                                  :exports (:yin.module/exports m),\n                                                  :requires requires, :primitives primitives}))]\n","exit_code":0,"status":"completed"}}
