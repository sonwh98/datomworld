value`\\\\n    19\\\\t     string          a host string whose every char is one byte (a latin-1\\\\n    20\\\\t                     carrier); the lowering resolves literal text to bytes\\\\n    21\\\\t     bool            host true / false\\\\n    22\\\\t     null            :php/null\\\\n    23\\\\t     array           {:php/type :array :index {key value} :order [key ...]\\\\n    24\\\\t                     :next-index n}: a persistent ordered map; keys are\\\\n    25\\\\t                     ints or strings (`php/array-key`); `:next-index` is\\\\n    26\\\\t                     absent until the first integer key is written\\\\n    27\\\\t     error object    {:php/type :obj :class name :ord n :props {\\\\\\\\\\\\\\\"message\\\\\\\\\\\\\\\"\\\\n    28\\\\t                     \\\\\\\\\\\\\\\"code\\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\"previous\\\\\\\\\\\\\\\"}}\\\\n    29\\\\t     function        a cell {:php/type :function :name s :code (fn [args])\\\\n    30\\\\t                             :yang.call/entry (fn [invocation])}\\\\n    31\\\\t\\\\n    32\\\\t   Runtime state is allocated by `php/init!`, once per task, under the slot\\\\n    33\\\\t   `php.rt/state` (the literal `:php/uninit` until `php/init!` flips it to\\\\n    34\\\\t   `:php/ready` as its last write):\\\\n    35\\\\t     php.rt/ctx            the dynamic context {:handlers :depth :base :frame}\\\\n    36\\\\t     php.rt/out            a cell holding the buffer stack, a vector of\\\\n    37\\\\t                           buffers, each a vector of byte-string chunks;\\\\n    38\\\\t                           `php/echo` conjs onto the last buffer, the\\\\n    39\\\\t                           bottom buffer is never popped\\\\n    40\\\\t     php.rt/globals        a cell holding the plain array of section 10.1\\\\n    41\\\\t                           (`$GLOBALS`), `(php/empty-array)` initially\\\\n    42\\\\t     php.rt/functions      a cell holding a map of lower-cased name to\\\\n    43\\\\t                           function cell; builtins are pre-seeded\\\\n    44\\\\t     php.rt/classes        a cell holding a map of class name to class record\\\\n    45\\\\t                           (the Throwable hierarchy, data only)\\\\n    46\\\\t     php.rt/next-ord       a cell, the per-task object ordinal\\\\n    47\\\\t     php.rt/next-cell      a cell, the per-task counted-cell id (`:id`)\\\\n    48\\\\t     php.rt/request        a cell holding the explicit request record\\\\n    49\\\\t     php.rt/response       a cell holding ordered response records\\\\n    50\\\\t     php.rt/headers-sent, php.rt/status   output state and the response status\\\\n    51\\\\t     php.rt/error-handler  a cell, :php/null or a callable\\\\n    52\\\\t     php.rt/error-handlers a cell holding previous handlers for restoration\\\\n    53\\\\t     php.rt/error-reporting a cell, the mask (E_ALL initially)\\\\n    54\\\\t     php.rt/diag           a cell, the vector of diagnostic records\\\\n    55\\\\t     php.rt/int-max, php.rt/int-min   exact integers computed in `init!`,\\\\n    56\\\\t                           never literals (literals past 2^53 are not\\\\n    57\\\\t                           portable)\\\\n    58\\\\t\\\\n    59\\\\t   Errors are raised with `php/raise`; with no handler frame above them they\\\\n    60\\\\t   reach the unit root, `php/run-main`, which answers output, response and\\\\n    61\\\\t   diagnostic records, any uncaught error, and an exit status when present.\\\\n    62\\\\t\\\\n    63\\\\t   Float text: `php/float-text x ndigit` is `zend_gcvt`; `ndigit` 14 is\\\\n    64\\\\t   `echo` (precision), 17 is `var_dump` (serialize_precision -1, the\\\\n    65\\\\t   shortest round trip from `integer/float-digits`).\\\\n    66\\\\t\\\\n    67\\\\t   Two emitters, one source: `definitions` is the only definition list.\\\\n    68\\\\t   `uast` is the bundled prelude; `module-uast` is the same list as the\\\\n    69\\\\t   linker module `php`. The module emitter strips only the module's own\\\\n    70\\\\t   namespace `php/`; `php.rt/*` stays qualified.\\\\n    71\\\\t\\\\n    72\\\\t   Host names the prelude depends on and does not define: `host-names`.\\\\\\\"\\\\n    73\\\\t  (:require\\\\n    74\\\\t    #?(:cljd [clojure.edn :as edn])\\\\n    75\\\\t    [clojure.string :as str]\\\\n    76\\\\t    [clojure.walk :as walk]\\\\n    77\\\\t    [yang.core.prelude :as core]\\\\n    78\\\\t    [yang.core.call :as call]\\\\n    79\\\\t    [yang.core.uast :as u]\\\\n    80\\\\t    [yang.php.antlr.builtins :as builtins]\\\\n  2125\\\\t     (fn [old v]\\\\n  2126\\\\t       (let [id (php/cell-id old)]\\\\n  2127\\\\t         (if (nil? id) :php/null (if (= id (php/cell-id v)) :php/null (php/delref old)))))]\\\\n  2128\\\\t    [php/global-make-ref!\\\\n  2129\\\\t     (fn [name]\\\\n  2130\\\\t       (let [cur (php/global-slot name)]\\\\n  2131\\\\t         (if (= (php/slot-kind cur) :ref-marker)\\\\n  2132\\\\t           cur\\\\n  2133\\\\t           (let [m (php/new-ref (if (nil? cur) :php/null cur))]\\\\n  2134\\\\t             (do (php/global-store! name m) m)))))]\\\\n  2135\\\\t    [php/global-bind!\\\\n  2136\\\\t     (fn [name m]\\\\n  2137\\\\t       (let [cur (php/global-slot name)]\\\\n  2138\\\\t         (do (php/addref m) (php/global-store! name m) (php/delref cur) :php/null)))]\\\\n  2139\\\\t    [php/global-isset? (fn [name] (not (= (php/global-peek name) :php/null)))]\\\\n  2140\\\\t    [php/vec-remove\\\\n  2141\\\\t     (fn [xs x i n acc]\\\\n  2142\\\\t       (if (< i n)\\\\n  2143\\\\t         (php/vec-remove xs x (+ i 1) n\\\\n  2144\\\\t                         (if (= (get xs i) x) acc (php/vconj acc (get xs i))))\\\\n  2145\\\\t         acc))]\\\\n  2146\\\\t    [php/global-unset!\\\\n  2147\\\\t     (fn [name]\\\\n  2148\\\\t       (let [g (cell/get php.rt/globals)\\\\n  2149\\\\t             cur (php/global-slot name)]\\\\n  2150\\\\t         (do (cell/set! php.rt/globals\\\\n  2151\\\\t                        (