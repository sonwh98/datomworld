ry (lower/eval-runtime-node) (u/lit :php/globals)\\ntest/yang/php/antlr/eval_coordinator_test.clj:1:(ns yang.php.antlr.eval-coordinator-test\\ntest/yang/php/antlr/eval_coordinator_test.clj:5:            [yang.php.antlr.eval-admission :as admission]\\ntest/yang/php/antlr/eval_coordinator_test.clj:6:            [yang.php.antlr.eval-coordinator :as coordinator]))\\ntest/yang/php/antlr/eval_coordinator_test.clj:15:  (let [source \\\"function f() { eval('return 1;'); } ?>é<?php return 2;\\\"\\ntest/yang/php/antlr/eval_coordinator_test.clj:16:        request {:yang.compile/request :r :yang.compile/unit :u\\ntest/yang/php/antlr/eval_coordinator_test.clj:17:                 :yang.compile/provenance :p :yang.php/source (carrier source)}\\ntest/yang/php/antlr/eval_coordinator_test.clj:18:        result (coordinator/compile-request (coordinator/make-worker) request)]\\ntest/yang/php/antlr/eval_coordinator_test.clj:23:    (is (= admission/profile-revision (get-in result [:identity :yang.php.eval/profile-revision])))\\ntest/yang/php/antlr/eval_coordinator_test.clj:25:              (:identity (coordinator/compile-request (coordinator/make-worker)\\ntest/yang/php/antlr/eval_coordinator_test.clj:30:  (let [result (coordinator/compile-request (coordinator/make-worker)\\ntest/yang/php/antlr/eval_coordinator_test.clj:31:                                            {:yang.compile/request :r :yang.compile/unit :u\\ntest/yang/php/antlr/eval_coordinator_test.clj:32:                                             :yang.compile/provenance :p :yang.php/source (text/units->string [255])})]\\ntest/yang/php/antlr/eval_coordinator_test.clj:33:    (is (= :yang.compile/rejected (:yang.compile/outcome result)))\\ntest/yang/php/antlr/eval_coordinator_test.clj:34:    (is (= :source-encoding (get-in result [:yang.compile/diagnostic :reason])))\\ntest/yang/php/antlr/eval_coordinator_test.clj:35:    (is (= :p (:yang.compile/provenance result)))))\\ntest/yang/php/antlr/eval_coordinator_test.clj:40:    (let [request {:yang.compile/unit :u :yang.php/source (carrier source)}\\ntest/yang/php/antlr/eval_coordinator_test.clj:41:          result (coordinator/compile-request (coordinator/make-worker) request)\\ntest/yang/php/antlr/eval_coordinator_test.clj:52:  (let [request {:yang.compile/unit :u :yang.php/source (carrier \\\"return 1;\\\")}\\ntest/yang/php/antlr/eval_coordinator_test.clj:54:    (is (not= (:identity (coordinator/compile-request worker request))\\ntest/yang/php/antlr/eval_coordinator_test.clj:55:              (:identity (coordinator/compile-request worker (assoc request :revision 2)))))))\\ntest/yang/php/antlr/eval_admission_test.clj:1:(ns yang.php.antlr.eval-admission-test\\ntest/yang/php/antlr/eval_admission_test.clj:4:            [yang.php.antlr.eval-admission :as admission]))\\ntest/yang/php/antlr/eval_admission_test.clj:18:      (is (= {:yang.php/diagnostic :yang.php/unsupported :construct :eval\\ntest/yang/php/antlr/eval_admission_test.clj:28:  (let [request {:yang.compile/request [:caller 17]\\ntest/yang/php/antlr/eval_admission_test.clj:29:                 :yang.compile/unit :unit-1\\ntest/yang/php/antlr/eval_admission_test.clj:30:                 :yang.compile/provenance {:source :original}\\ntest/yang/php/antlr/eval_admission_test.clj:33:    (is (= :yang.compile/rejected (:yang.compile/outcome result)))\\ntest/yang/php/antlr/eval_admission_test.clj:34:    (is (= [:caller 17] (:yang.compile/request result)))\\ntest/yang/php/antlr/eval_admission_test.clj:35:    (is (= :unit-1 (:yang.compile/unit result)))\\ntest/yang/php/antlr/eval_admission_test.clj:36:    (is (= {:source :original} (:yang.compile/provenance result)))\\ntest/yang/php/antlr/eval_admission_test.clj:37:    (is (= [0 1] (get-in result [:yang.compile/diagnostic :span])))))\\ntest/yang/php/antlr/eval_admission_test.clj:49:          result (admission/admit-request {:yang.compile/request :r\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:1:(ns yang.php.antlr.eval-coordinator\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:2:  \\\"Composition-supplied eval frontend: admit bytes, parse and validate source.\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:6:            [yang.php.antlr.eval-admission :as admission]\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:12:  (cst/make-eval-worker))\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:15:(defn compile-request\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:16:  \\\"Prepare one request for later eval-unit emission. Identity includes the\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:24:      (let [pk (cst/parse-source worker (:yang.compile/unit request) source)\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:27:                      :yang.php.eval/profile-revision admission/profile-revision\\nsrc/cljc/yang/php/antlr/eval_coordinator.cljc:28:                      :yang.php/source-goal :eval\\n101:(def ^:private prefix-refusals\\n105:   \\\"Eval\\\" :eval,\\n1310:        (if-let [construct (get prefix-refusals t)]\\n1866:          \\\"eval\\\" (unsupported! n :eval)\\n3800:(defn eval-runtime-node\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:16:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"agent_message\",\"text\":\"The repository already has byte admission, eval-unit emission, and publication as separate pieces. The missing connection is substantial: the coordinator currently stops at CST preparation, and both lowering paths still reject eval. I’m tracing the existing stream and linker contracts before connecting them.\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:19:{\"type\":\"item.started\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\nimport json\\np='collab/orch-lane/1794400000000-architect-eval-bridge-design.gpt-6.1-sol.stdout.log'\\nfor line in open(p):\\n try:\\n  x=json.loads(line)\\n  if x.get('item',{}).get('type')=='agent_message' and '**1.' in x['item'].get('text',''):\\n   open('/tmp/eval-design.txt','w').write(x['item']['text'])\\n except: pass\\nPY\\nrg -n 'transport|request|outcome|entry|linker|stream' /tmp/eval-design.txt | head -70\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 - <<'PY'\\nimport json\\np='collab/orch-lane/1794400000000-architect-eval-bridge-design.gpt-6.1-sol.stdout.log'\\nfor line in open(p):\\n try:\\n  x=json.loads(line)\\n  if x.get('item',{}).get('type')=='agent_message' and '**1.' in x['item'].get('text',''):\\n   open('/tmp/eval-design.txt','w').write(x['item']['text'])\\n except: pass\\nPY\\nrg -n 'transport|request|outcome|entry|linker|stream' /tmp/eval-design.txt | head -70\\\"\",\"aggregated_output\":\"1:The bridge should compile eval source through a composition-supplied compiler service, then execute the resulting entry **in the caller’s task, against the caller’s existing variable cells and run budget**. Parsing remains outside the VM. Node and Dart need a configured service; without one, eval retains the pinned refusal.\\n16:`php/eval-run` submits a compilation request and waits for its correlated outcome using ordinary stream effects. It must never call `cst/parse-source`, `lower-program`, or a host PHP evaluator directly. This follows the existing requirement that portable code requests compilation through streams and that the coordinator answers those requests. See [yang.antlr.md:868](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:868).\\n22:  → compilation request stream\\n25:  → PHP lowering, eval-unit entry\\n28:  → publication and ordinary linker admission\\n29:  → installed entry called in caller task\\n34:The eval emitter should reuse `context`, `unit-body`, and the unit return escape, producing an entry conceptually shaped as:\\n47:- **Entry retrieval.** Add a small profiled `code/entry` effect that retrieves a declared export from an **already installed, manifest-pinned module**. This is necessary: `try-require` returns a module name, not its exports. The accessor checks the installed manifest address and export name, then returns the receiver’s lowered binding. It neither parses nor installs code. Implement it through the existing effect-handler registry; no PHP-specific VM opcode or evaluator branch is needed. See [engine.cljc:1168](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:1168), [module.cljc:40](/Users/sto/workspace/datomworld/src/cljc/yin/vm/module.cljc:40), [module.cljc:153](/Users/sto/workspace/datomworld/src/cljc/yin/vm/module.cljc:153), and [engine.cljc:2737](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2737).\\n49:The compilation request carries source bytes, request identity, frontend/compiler revisions, eval goal, source provenance, and compilation options. **It carries no caller cells, values, continuation, or host handles.** Those stay with the suspended caller and become arguments only after installation. Source envelopes must preserve frontend metadata so the normal safepoint pass can find eval’s sites. See [yang.antlr.md:856](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:856), [core/stage.cljc:25](/Users/sto/workspace/datomworld/src/cljc/yang/core/stage.cljc:25), and [core/lower.cljc:76](/Users/sto/workspace/datomworld/src/cljc/yang/core/lower.cljc:76).\\n56:| Node/Dart with configured compiler service | Submit the same request; receive portable artifacts and execute locally. |\\n62:Precompiled eval artifacts may later satisfy the same request by an exact source/profile/provenance key. They must execute at the eval statement every time; artifact reuse must not become include-once behavior. This is optional caching, not the first implementation slice.\\n85:This sharing stays inside one task. The compiler service receives syntax; the linker installs code; the caller applies that code to its own cells. It introduces no shared mutable heap between tasks, consistent with [datom.world.md:24](/Users/sto/workspace/datomworld/docs/design/datom.world.md:24).\\n89:Unbounded runs supply no-op budget hooks. Nested eval and later calls to eval-declared functions retain the same run hooks. Compiler parsing, hashing, transport waits, and publication use separate compiler limits; they are not PHP safepoint units. P7-a explicitly bounds execution between hooks rather than wall time or blocking host operations. See [yang.php.md:1928](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1928).\\n95:| Nested eval | A new correlated compilation request; reuse the current scope and run context. Each eval has its own return escape. |\\n98:| Named functions/classes declared by eval | Register in the request’s normal declaration tables. They survive eval return and function return. Named function bodies get their normal function scope, not implicit capture of the eval caller’s locals. |\\n111:- Unsupported profile constructs retain their compiler diagnostics. Missing compiler/parser, worker failure, cancellation, resource limits, and link/admission failures remain operational outcomes, outside guest `Throwable` handling. Preserve their structured refusal in the run result instead of inventing a PHP exception or returning false. See [yang.antlr.md:4397](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:4397) and [yang.php.md:1948](/Users/sto/workspace/datomworld/docs/design/yang.php.md:1948).\\n161:- Configured service on Node/Dart; delayed response; full request stream; duplicate response; cancellation and terminal transport loss. Assert one execution and preserved caller state.\\n165:These extend the current safepoint fatal tests and stream-stage retry contract. See [safepoint_test.clj:17](/Users/sto/workspace/datomworld/test/yang/php/antlr/safepoint_test.clj:17), [stage.cljc:16](/Users/sto/workspace/datomworld/src/cljc/yang/stage.cljc:16), and [yang/safepoint.cljc:26](/Users/sto/workspace/datomworld/src/cljc/yang/safepoint.cljc:26).\\n173:1. **Pin contracts and oracle cases.** Add eval fixtures, request/outcome shapes, eval goal, runtime import inventory, and missing-compiler behavior. Keep the current refusal test until the supported path is available. Start with globals, function locals, return/null, references, syntax failure, and declaration timing.\\n174:2. **Build one JVM vertical path.** Add the eval parser goal and eval-unit emitter through the existing stage pipeline. Publish a code-only entry, retrieve it through the profiled installed-export accessor, and execute it using explicit runtime/scope/context arguments. Prove global write-back and local write-back through a real compiler request.\\n185:> `eval` submits a new compilation request through the configured compiler composition (`yang.antlr.md` sections 6.1 and 8.6). The VM does not parse source. The request pins the frontend/compiler profile and eval source goal; parsing begins in PHP mode and retains source spans relative to the supplied eval bytes.\\n189:> Each eval has its own return boundary. An explicit return supplies eval’s result; falling through or returning without a value yields PHP null. Runtime exceptions propagate through the caller’s handlers, preserving earlier mutations. Invalid eval syntax raises guest `ParseError`. Compiler, transport, resource and admission failures remain operational outcomes.\\n191:> Eval is a separate compilation unit. Its declarations use the normal request-level function and class tables and remain available after eval returns. Hoisting occurs when the eval unit executes; repeated eval does not suppress redeclaration checks. The caller’s variable and method execution context is supplied explicitly; its namespace/import environment is not implicitly copied.\\n193:> Eval invocation and eval-generated loop/call sites use the caller’s active safepoint hooks. Nested eval and functions declared by eval consume the same run budget. Eval never initializes another budget counter. Compiler work and transport waits use separate composition limits.\\n195:> The current local PHP parser is JVM-only. Node and Dart may use an explicitly configured compiler service. Without a configured compiler, eval is refused with `:yang.php/diagnostic :yang.php/unsupported` and `:construct :eval`. Precompiling the enclosing program does not provide runtime eval support. Reused artifacts must match the compilation request and execute at every eval invocation.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:23:{\"type\":\"item.started\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'yang.compile/(request|unit|frontend|options|provenance|revision|goal)' src/cljc/yang | head -100; rg -n 'eval-bridge-r(6|8).*findings' -l collab/yang-php | head; rg --files collab/yang-php | rg 'eval-bridge-r[68].*findings' \\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:24:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_11\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'yang.compile/(request|unit|frontend|options|provenance|revision|goal)' src/cljc/yang | head -100; rg -n 'eval-bridge-r(6|8).*findings' -l collab/yang-php | head; rg --files collab/yang-php | rg 'eval-bridge-r[68].*findings' \\\"\",\"aggregated_output\":\"src/cljc/yang/php/antlr/eval_coordinator.cljc:24:      (let [pk (cst/parse-source worker (:yang.compile/unit request) source)\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:77:      diagnostic (assoc (select-keys request [:yang.compile/request :yang.compile/unit\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:78:                                              :yang.compile/provenance])\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:82:      reason (assoc (select-keys request [:yang.compile/request :yang.compile/unit\\nsrc/cljc/yang/php/antlr/eval_admission.cljc:83:                                          :yang.compile/provenance])\\ncollab/yang-php/1794608699000-engineer-eval-bridge-r8.prompt.md\\ncollab/yang-php/1794607599000-engineer-eval-bridge-r7.gpt-6.1-terra.stdout.log\\ncollab/yang-php/1794608699000-engineer-eval-bridge-r8.gpt-6.1-terra.stdout.log\\ncollab/yang-php/1794609597000-engineer-eval-bridge-r9.gpt-6.1-terra.stdout.log\\ncollab/yang-php/1794607599000-engineer-eval-bridge-r7.prompt.md\\ncollab/yang-php/1794607338000-engineer-eval-bridge-r6.gpt-6.1-terra.stdout.log\\ncollab/yang-php/1794607338000-engineer-eval-bridge-r6.prompt.md\\ncollab/yang-php/1794607460000-engineer-eval-bridge-r6.gpt-6.1-terra.findings.md\\ncollab/yang-php/1794608699000-engineer-eval-bridge-r8.gpt-6.1-terra.findings.md\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:25:{\"type\":\"item.started\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/yang-php/1794608699000-engineer-eval-bridge-r8.gpt-6.1-terra.findings.md collab/yang-php/1794607460000-engineer-eval-bridge-r6.gpt-6.1-terra.findings.md'\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:26:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'cat collab/yang-php/1794608699000-engineer-eval-bridge-r8.gpt-6.1-terra.findings.md collab/yang-php/1794607460000-engineer-eval-bridge-r6.gpt-6.1-terra.findings.md'\",\"aggregated_output\":\"# Eval bridge r8: design gap; bridge incomplete\\n\\nGenerator destruction now releases its dynamic scope dictionary, including cells introduced after function entry, rather than only the original CV vector. The structural regression failed before the change; a pending-oracle suspended-generator fixture produced `DZ` on all four JVM evaluators after it. The installed-export effect was also exercised via actual linker installation and application of the returned closure on all four JVM backends (a stub linker response, not real-service admission): 8 assertions passed.\\n\\n**Design gap, stop:** generator normal completion currently does not call its cleanup. A pending-oracle probe with a dynamic object binding printed `ZD` on all four evaluators rather than the hand-derived `DZ`. A trial calling cleanup from `php/gen-exit` produced `DZ`, but a destructor throwing during that cleanup re-entered the generator's handler after the state had been closed and yielded `[:thrown \\\"Cannot apply non-function\\\"]` rather than the hand-derived `XA`. The trial was withdrawn. The ordering of closing state, releasing CVs/dictionary, restoring caller handlers/context, and routing destructor exceptions needs a lifecycle design and PHP 8.3 oracle before a safe completion/throw fix. Destruction cleanup with throwing destructors also needs investigation. The generator dictionary work is therefore partial, not a completed lifecycle claim.\\n\\nThe part-7 extract probe is `<?php class C { function __destruct(){ echo 'D'; } } function f(){ extract(['o' => new C]); } f(); echo 'A';` and previously produced `AD` on the walker, against the hand-derived `DA`. PHP 8.3 is unavailable locally; the orchestrator was asked for the exact oracle. The array-literal lowering does not register the resulting counted array as a statement temporary, even though `array-put` adds a reference to a counted element: this is a plausible ownership leak, not a proven complete cause. Do not claim the issue fixed or the expected output confirmed.\\n\\nValidation: `generator-fixtures-on-every-vm-test` passed 60 assertions with the subsequently withdrawn completion trial present (a 120-second attempt timed out; the successful attempt had a 600-second timeout). `lower-portable-test` passed 8 tests / 1254 assertions with that trial present, also under 600 seconds; neither result is a post-withdrawal gate. The accessor test passed 8 assertions with a 180-second timeout. The post-withdrawal scope cleanup test passed 3 tests / 6 assertions under 180 seconds. PHP 8.3 fixtures remain `:oracle :pending`.\\n\\nThe bridge remains incomplete: request/response transport and service-backed admission/publication, caller-task `php/eval-run` including scope/budget, both expression routes, atomic guest compile fatal, real-service fixtures and the full gate set remain outstanding. The standalone publisher is not an admission decision. No end-to-end eval support is claimed. Node/Dart and lint validation remain outstanding.\\n# Eval bridge r6: investigation only, implementation outstanding\\n\\nBase: `eval-bridge` at `9f589e1d`. The branch is checked out in a separate worktree outside this session's writable roots; investigation and the test below used a fresh isolated clone at `/private/tmp/eval-bridge-r6`. No production code or tests were changed, committed, or pushed.\\n\\nThe coordinator at `src/cljc/yang/php/antlr/eval_coordinator.cljc` admits, parses and analyzes the source but explicitly produces no executable artifact. Both `Eval` in `prefix-refusals` and the plain `eval` call refusal remain in `lower.cljc`. The existing `module-packet` uses `unit-node` with the include fall-through sentinel and a required PHP module; it is not an eval entry with caller runtime and hooks. `try-require` answers `{:status :ok :module name}` and cannot itself retrieve the installed binding. `yin.vm.module/module-entry` exposes manifest, address, and task-local bindings to an effect handler; the accessor still needs its manifest/address/export checks and profile. The existing `php/guest-fatal` performs the oracle-required terminal handling, including shutdown and destructor suppression. The lifecycle record is `collab/orch-lane/p7-lifecycle-probes.txt` on the branch.\\n\\nVerification: `clojure -M:test -n yang.php.antlr.eval-coordinator-test` passed 3 tests / 22 assertions in the isolated clone after copying the existing generated PHP parser classes from the branch worktree. Its first run failed because the fresh clone had no generated `PhpLexer`; `bb` is not on PATH here. This is a baseline only, not an eval execution test. No Docker was used. No eval end-to-end, admission, scope, CST, kondo or cljstyle gate was run in this round.\\n\\nRemaining: implement and test the eval-unit emitter and runtime import/hook bindings; compile request/response transport and artifact publication; installed manifest-pinned `code/entry`; `php/eval-run` in caller task; both expression paths; atomic redeclaration checks through guest fatal; caller scope and budget integration; the requested real-service fixtures and all named gates. The current e2e harness has no configured eval compiler service, so simply changing the refusal would not constitute a working bridge. This round does not meet the definition of done.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:32:{\"type\":\"item.started\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat > src/cljc/yang/php/antlr/eval_transport.cljc <<'EOF'\\n(ns yang.php.antlr.eval-transport\\n  \\\\\\\"Validation of the portable, sealed eval compiler request.\\\\\\\")\\n\\n\\n(def request-fields\\n  #{:yang.compile/request :yang.compile/unit :yang.compile/frontend-revision\\n    :yang.compile/compiler-revision :yang.compile/goal :yang.compile/provenance\\n    :yang.compile/options :yang.php/source})\\n\\n\\n(defn- portable-data?\\n  [x]\\n  (cond\\n    (or (nil? x) (boolean? x) (string? x) (number? x)\\n        (keyword? x) (symbol? x)) true\\n    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\\n    (or (vector? x) (set? x) (list? x)) (every? portable-data? x)\\n    :else false))\\n\\n\\n(defn request-defect\\n  \\\\\\\"Return a protocol defect or nil. Unknown fields are refused so that\\n   caller runtime state cannot accidentally be included at the top level.\\\\\\\"\\n  [request]\\n  (cond\\n    (not (map? request)) :request-shape\\n    (some #(not (contains? request %)) request-fields) :missing-field\\n    (some #(not (contains? request-fields %)) (keys request)) :unknown-field\\n    (not= :eval (:yang.compile/goal request)) :wrong-goal\\n    (not (string? (:yang.php/source request))) :source-shape\\n    (not (map? (:yang.compile/options request))) :options-shape\\n    (not (portable-data? request)) :non-portable-data\\n    :else nil))\\nEOF\\nclojure -M:test -n yang.php.antlr.eval-transport-test\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:33:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"cat > src/cljc/yang/php/antlr/eval_transport.cljc <<'EOF'\\n(ns yang.php.antlr.eval-transport\\n  \\\\\\\"Validation of the portable, sealed eval compiler request.\\\\\\\")\\n\\n\\n(def request-fields\\n  #{:yang.compile/request :yang.compile/unit :yang.compile/frontend-revision\\n    :yang.compile/compiler-revision :yang.compile/goal :yang.compile/provenance\\n    :yang.compile/options :yang.php/source})\\n\\n\\n(defn- portable-data?\\n  [x]\\n  (cond\\n    (or (nil? x) (boolean? x) (string? x) (number? x)\\n        (keyword? x) (symbol? x)) true\\n    (map? x) (every? (fn [[k v]] (and (portable-data? k) (portable-data? v))) x)\\n    (or (vector? x) (set? x) (list? x)) (every? portable-data? x)\\n    :else false))\\n\\n\\n(defn request-defect\\n  \\\\\\\"Return a protocol defect or nil. Unknown fields are refused so that\\n   caller runtime state cannot accidentally be included at the top level.\\\\\\\"\\n  [request]\\n  (cond\\n    (not (map? request)) :request-shape\\n    (some #(not (contains? request %)) request-fields) :missing-field\\n    (some #(not (contains? request-fields %)) (keys request)) :unknown-field\\n    (not= :eval (:yang.compile/goal request)) :wrong-goal\\n    (not (string? (:yang.php/source request))) :source-shape\\n    (not (map? (:yang.compile/options request))) :options-shape\\n    (not (portable-data? request)) :non-portable-data\\n    :else nil))\\nEOF\\nclojure -M:test -n yang.php.antlr.eval-transport-test\\\"\",\"aggregated_output\":\"Loading initial Timbre config from: :default\\n\\nRunning tests in #{\\\"test\\\"}\\n\\nTesting yang.php.antlr.eval-transport-test\\n\\nRan 1 tests containing 5 assertions.\\n0 failures, 0 errors.\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:45:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_22\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'clj-kondo|cljstyle' docs/agents/build-n-test.md | head -40; git status --short; date +%s\\\"\",\"aggregated_output\":\"97:change (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\\n98:antlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\\n510:| `shiva.stigmergy.systems` | 24 / 62 GB | Server snapshot: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1. The repo's `mise.toml` selects Flutter `latest` on beta, not a fixed version. Activate the repo toolchain before running any lane. |\\n511:| `jupiter.stigmergy.systems` | 48 / 62 GB | Server snapshot (rechecked 2026-10-29): java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.8 (the stale hand-symlinked 3.41.9 was replaced via `mise install flutter@3.47.8` after it failed to compile `dart:ui`-using cljd namespaces; if the Dart lane dies in the cljd compile, check `mise ls flutter` first). mise was moved off the apt package to the official user-local install (`~/.local/bin/mise`, 2026.11.2, owner action 2026-11-07) so both hosts share shiva's layout; toolchains in `~/.local/share/mise/installs/` were untouched. Tri-host quick tier verified green on 2026-10-29 (see Measured times). |\\n945:1. **Run clj-kondo first**:\\n950:2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\\n959:4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\\n M src/cljc/yang/php/antlr/eval_coordinator.cljc\\n?? collab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log\\n?? collab/yang-php/1794611156000-engineer-eval-bridge-r10.prompt.md\\n?? src/cljc/yang/php/antlr/eval_transport.cljc\\n?? test/yang/php/antlr/eval_transport_test.clj\\n1794611295\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ncollab/yang-php/1794611156000-engineer-eval-bridge-r10.gpt-6.1-terra.stdout.log:47:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_23\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n 'stream/(append|next)|try-require|code/entry|effect' src/cljc/yang/php/antlr/prelude.cljc src/cljc/yang/php/antlr/prelude_module.cljc | head -80; rg -n 'make-observer-session|linker|:stage' test/yang/php/antlr/linked* test/yang/php/antlr/*safepoint* | head -100; sed -n '25,65p' /tmp/eval-design.txt\\\"\",\"aggregated_output\":\"src/cljc/yang/php/antlr/prelude.cljc:2682:                     \\\"Decrement on type null has no effect, this will change in the next major version of PHP\\\")\\nsrc/cljc/yang/php/antlr/prelude.cljc:6203:  ;; left-to-right effects and the last definition's value.\\ntest/yang/php/antlr/linked_harness.cljc:7:   `yin.vm.linker.interpreter` composition under `:trusted` derivation.\\ntest/yang/php/antlr/linked_harness.cljc:28:    [yin.vm.linker.interpreter :as link]\\ntest/yang/php/antlr/linked_harness.cljc:29:    [yin.vm.linker.publish :as publish]\\ntest/yang/php/antlr/linked_harness.cljc:30:    [yin.vm.linker.sign :as sign]\\ntest/yang/php/antlr/linked_harness.cljc:84:        :stage (fn [ctx name address]\\n  → PHP lowering, eval-unit entry\\n  → canonical source envelope\\n  → active safepoint derivation\\n  → publication and ordinary linker admission\\n  → installed entry called in caller task\\n```\\n\\nReuse the normal parser and lowering machinery, with an explicit **eval-unit emission mode**. Do not invoke `lower-program` unchanged: it wraps the body in `php/run-main`, and its linked form calls `php/init!`. `php/run-main` resets output and dynamic handler context; that would break the surrounding execution. See [lower.cljc:3759](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3759) and [prelude.cljc:5070](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:5070).\\n\\nThe eval emitter should reuse `context`, `unit-body`, and the unit return escape, producing an entry conceptually shaped as:\\n\\n```clojure\\n(fn [%runtime %scope %ctx %hooks]\\n  <eval unit>)\\n```\\n\\nThe existing included-unit emitter already demonstrates `%scope`/`%ctx` arguments. Its return sentinel is also reusable, but eval must map fall-through to `:php/null`; the include wrapper currently maps it to `1`. See [lower.cljc:3648](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3648), [lower.cljc:3721](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3721), [lower.cljc:3840](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:3840), and [prelude_module.cljc:84](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude_module.cljc:84).\\n\\nThree details complete this path:\\n\\n- **Eval source goal.** Start the existing lexer in PHP mode, retaining its default mode beneath it so `?>` can leave PHP mode. Do not prepend an opening tag and then repair offsets. The grammar already has PHP mode and mixed HTML parsing; Zend likewise compiles eval after the opening-tag position. Preserve original eval-byte spans and line starts. See [PhpLexer.g4:117](/Users/sto/workspace/datomworld/antlr/php/PhpLexer.g4:117), [PhpParser.g4:38](/Users/sto/workspace/datomworld/antlr/php/PhpParser.g4:38), [cst.clj:41](/Users/sto/workspace/datomworld/src/clj/yang/php/antlr/cst.clj:41), and [PHP 8.3.35 zend_execute.c:4630](https://github.com/php/php-src/blob/php-8.3.35/Zend/zend_execute.c#L4630).\\n- **Runtime imports.** `%runtime` supplies the caller’s actual PHP runtime callable values. Bind the eval tree’s free `php/` names from that environment; do not instantiate another PHP runtime inside the installed artifact. Generate the environment from the existing definition inventory rather than maintaining another list. This supports bundled and linked callers without duplicating their globals, function tables, or class tables. The lowering already avoids naming `php.rt/*`, and the prelude has one definition inventory. See [lower.cljc:33](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/lower.cljc:33), [prelude.cljc:32](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:32), and [prelude.cljc:5302](/Users/sto/workspace/datomworld/src/cljc/yang/php/antlr/prelude.cljc:5302).\\n- **Entry retrieval.** Add a small profiled `code/entry` effect that retrieves a declared export from an **already installed, manifest-pinned module**. This is necessary: `try-require` returns a module name, not its exports. The accessor checks the installed manifest address and export name, then returns the receiver’s lowered binding. It neither parses nor installs code. Implement it through the existing effect-handler registry; no PHP-specific VM opcode or evaluator branch is needed. See [engine.cljc:1168](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:1168), [module.cljc:40](/Users/sto/workspace/datomworld/src/cljc/yin/vm/module.cljc:40), [module.cljc:153](/Users/sto/workspace/datomworld/src/cljc/yin/vm/module.cljc:153), and [engine.cljc:2737](/Users/sto/workspace/datomworld/src/cljc/yin/vm/engine.cljc:2737).\\n\\nThe compilation request carries source bytes, request identity, frontend/compiler revisions, eval goal, source provenance, and compilation options. **It carries no caller cells, values, continuation, or host handles.** Those stay with the suspended caller and become arguments only after installation. Source envelopes must preserve frontend metadata so the normal safepoint pass can find eval’s sites. See [yang.antlr.md:856](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:856), [core/stage.cljc:25](/Users/sto/workspace/datomworld/src/cljc/yang/core/stage.cljc:25), and [core/lower.cljc:76](/Users/sto/workspace/datomworld/src/cljc/yang/core/lower.cljc:76).\\n\\nHost policy:\\n\\n| Composition | Proposed behavior |\\n|---|---|\\n| JVM with configured compiler worker | Compile at runtime through the PHP worker. |\\n| Node/Dart with configured compiler service | Submit the same request; receive portable artifacts and execute locally. |\\n| Any host without a configured compiler | Refuse eval with the pinned `:yang.php/unsupported`, `:construct :eval` diagnostic. |\\n| Parserless host holding only the outer program | Still refuse; precompiling the outer program does not compile a future runtime string. |\\n\\nThe current PHP parser is explicitly JVM-only. Service-backed compilation is already an architectural alternative, distinct from offline local compilation. See [cst.clj:1](/Users/sto/workspace/datomworld/src/clj/yang/php/antlr/cst.clj:1) and [yang.antlr.md:493](/Users/sto/workspace/datomworld/docs/design/yang.antlr.md:493).\\n\\nPrecompiled eval artifacts may later satisfy the same request by an exact source/profile/provenance key. They must execute at the eval statement every time; artifact reuse must not become include-once behavior. This is optional caching, not the first implementation slice.\\n\\n**2. Exact symbol sharing, ownership, and budget**\\n\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/eval_coordinator.cljc src/cljc/yang/php/antlr/eval_admission.cljc test/yang/php/antlr/linked_harness.cljc'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/eval_coordinator.cljc src/cljc/yang/php/antlr/eval_admission.cljc test/yang/php/antlr/linked_harness.cljc'","aggregated_output":"(ns yang.php.antlr.eval-coordinator\n  \"Composition-supplied eval frontend: admit bytes, parse and validate source.\n   This stage produces no executable artifact.\"\n  (:require [yang.antlr.packet :as packet]\n            [yang.php.antlr.cst :as cst]\n            [yang.php.antlr.eval-admission :as admission]\n            [yang.php.antlr.eval-transport :as transport]\n            [yang.php.antlr.scope :as scope]))\n\n\n(defn make-worker\n  []\n  (cst/make-eval-worker))\n\n\n(defn compile-request\n  \"Prepare one request for later eval-unit emission. Identity includes the\n   complete request (including bytes and caller-supplied revisions/options),\n   the source goal, grammar and admission profile. No caller runtime state is\n   needed by this service.\"\n  [worker request]\n  (let [{:keys [source] :as admitted} (admission/admit-request request)]\n    (if-not source\n      admitted\n      (let [pk (cst/parse-source worker (:yang.compile/unit request) source)\n            identity {:request request\n                      :yang.php/source (:yang.php/source request)\n                      :yang.php.eval/profile-revision admission/profile-revision\n                      :yang.php/source-goal :eval\n                      :yang.php/grammar cst/grammar-id}]\n        (if (:yang.php/not-php pk)\n          {:request request :identity identity :cst pk}\n          (let [validated (packet/validate! pk {:source source})]\n            (cond-> {:request request :identity identity :cst validated}\n              (= :yang.cst/ok (:yang.cst/outcome validated))\n              (assoc :scope (scope/analyze validated)))))))))\n\n\n(defn compile-transport-request\n  \"Validate a sealed transport request before handing it to the parser worker.\n   Refusals include the request identity only when it is portable data.\"\n  [worker request]\n  (if-let [defect (transport/request-defect request)]\n    (cond-> {:yang.compile/outcome :yang.compile/rejected\n             :yang.compile/reason :yang.compile/invalid-request\n             :yang.compile/detail defect}\n      (and (map? request) (contains? request :yang.compile/request)\n           (transport/portable-data? (:yang.compile/request request)))\n      (assoc :yang.compile/request (:yang.compile/request request)))\n    (compile-request worker request)))\n(ns yang.php.antlr.eval-admission\n  \"Strict UTF-8 admission for an eval source carried as one character per byte.\n   This boundary does not execute or compile the admitted source.\"\n  (:require [dao.host.text :as text])\n  #?(:cljd (:import [\"dart:typed_data\" Uint8List])))\n\n\n(def profile-revision :yang.php.eval/utf8-v1)\n\n\n(defn- bad-sequence\n  \"Return the first malformed interval. An invalid continuation is included;\n   truncation ends at EOF. Illegal leaders occupy one byte.\"\n  [bs]\n  (let [n (count bs)]\n    (loop [i 0]\n      (when (< i n)\n        (let [b (nth bs i)\n              width (cond (< b 0x80) 1 (<= 0xc2 b 0xdf) 2\n                          (<= 0xe0 b 0xef) 3 (<= 0xf0 b 0xf4) 4\n                          :else 0)]\n          (cond\n            (zero? width) [i (inc i)]\n            (= width 1) (recur (inc i))\n            :else\n            (let [end (loop [j 1]\n                        (if (= j width)\n                          nil\n                          (let [p (+ i j)]\n                            (cond\n                              (>= p n) n\n                              (let [v (nth bs p)]\n                                (not (and (<= 0x80 v 0xbf)\n                                          (or (not= j 1)\n                                              (and (or (not= b 0xe0) (>= v 0xa0))\n                                                   (or (not= b 0xed) (< v 0xa0))\n                                                   (or (not= b 0xf0) (>= v 0x90))\n                                                   (or (not= b 0xf4) (< v 0x90)))))))\n                              (inc p)\n                              :else (recur (inc j))))))]\n              (if end [i end] (recur (+ i width))))))))))\n\n\n(defn- host-bytes\n  [bs]\n  #?(:cljd (Uint8List.fromList bs)\n     :clj (byte-array (map unchecked-byte bs))\n     :cljs (js/Uint8Array. (clj->js bs))))\n\n\n(defn admit\n  \"Decode a byte carrier once. Malformed carriers are protocol violations;\n   malformed UTF-8 produces the classified PHP diagnostic.\"\n  [carrier]\n  (if-not (string? carrier)\n    {:reason :carrier-representation}\n    (let [bs (mapv #(text/code-unit carrier %) (range (text/unit-count carrier)))]\n      (if (some #(> % 255) bs)\n        {:reason :carrier-representation}\n        (if-let [[start end] (bad-sequence bs)]\n          {:diagnostic {:yang.php/diagnostic :yang.php/unsupported\n                        :construct :eval :reason :source-encoding :encoding :utf-8\n                        :byte-offset start :span [start end]}}\n          (let [source (text/utf8-decode (host-bytes bs))\n                encoded (mapv #(bit-and % 255) (text/utf8-encode source))]\n            (if (= bs encoded)\n              {:source source}\n              (throw (ex-info \"UTF-8 round trip failed\" {:reason :utf8-round-trip})))))))))\n\n\n(defn admit-request\n  \"Admit a sealed eval request, preserving correlation and provenance on refusal.\n   On success the original request and its derived parser view travel together.\"\n  [request]\n  (let [{:keys [source diagnostic reason]} (admit (:yang.php/source request))]\n    (cond\n      diagnostic (assoc (select-keys request [:yang.compile/request :yang.compile/unit\n                                              :yang.compile/provenance])\n                        :yang.compile/outcome :yang.compile/rejected\n                        :yang.compile/reason :yang.compile/unsupported\n                        :yang.compile/diagnostic diagnostic)\n      reason (assoc (select-keys request [:yang.compile/request :yang.compile/unit\n                                          :yang.compile/provenance])\n                    :yang.compile/outcome :yang.compile/rejected\n                    :yang.compile/reason :yang.compile/invalid-request\n                    :yang.compile/detail reason)\n      :else {:request request :source source})))\n(ns yang.php.antlr.linked-harness\n  \"The linked profile's composition for the PHP tests (P6, docs/design/\n   yang.php.md section 11): the namespace that requires this is the\n   publisher of `php`, so it publishes the module once per process into one\n   in-memory content store, publishes a fixture's non-entry units beside it\n   bottom-up, and serves them to the entry unit's run over a\n   `yin.vm.linker.interpreter` composition under `:trusted` derivation.\n\n   A linked run builds the entry unit's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately until\n   the VM stops blocking, as the REPL's drive does. The AST walker is not a\n   backend here: its link of `php` is refused until L-b.\"\n  (:require\n    [dao.jing.mem :as mem]\n    [yang.core.call :as call]\n    [yang.core.module :as core-module]\n    [yang.core.uast :as u]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.portable-harness :as portable]\n    [yang.php.antlr.prelude :as prelude]\n    [yang.php.antlr.publication :as publication]\n    [yang.php.antlr.safepoint :as safepoint]\n    [yang.php.antlr.siteset :as siteset]\n    [yang.safepoint :as sp]\n    [yin.vm :as vm]\n    [yin.vm.debruijn.register :as rvm]\n    [yin.vm.debruijn.stack :as dvm]\n    [yin.vm.linker.interpreter :as link]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.linker.sign :as sign]\n    [yin.vm.semantic :as semantic]\n    [yin.vm.semantic.derive :as derive]\n    [yin.vm.semantic.linearize :as sr-linearize]\n    [yin.vm.test-utils :as tu]))\n\n\n(defn registry\n  \"The host registry a linked PHP composition registers: the `require`\n   handlers, then `cell`, `data` and `integer` under the portable limits.\"\n  []\n  (portable/linked-registry))\n\n\n(def published\n  \"`yang.call` and `php` published once into their own content store.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store (prelude/module-spec (registry)\n                                                                     (:address call-result)))\n          hook (publish/publish-module! store (safepoint/module-spec (registry) (:address result)))]\n      {:store store,\n       :hook-address (:address hook),\n       :result result,\n       :address (:address result),\n       :call-address (:address call-result)})))\n\n\n(defn publish-units!\n  \"`units` (`[{:name path :packet p :strict-types b}]`) published into\n   `php`'s own content store, where its pinned requirement already lives:\n   `publication/publish-units!`'s answer.\"\n  [units]\n  (publication/publish-units! (:store @published) (registry) (:address @published) units))\n\n\n(defn source\n  \"The linked store and signed site publications for this fixture.\"\n  ([name-env] (source name-env nil))\n  ([name-env result]\n   (let [publisher (sign/generate)\n         entries (siteset/signed-entries publisher (:sites result)\n                                         (:addresses result) (:bundles result))\n         datoms (siteset/entry-datoms entries)\n         stage (siteset/stage (registry)\n                              {:hooks true, :hooks-profile safepoint/ticks-profile,\n                               :php-sp (:hook-address @published)} {})]\n     (link/composition\n       {:content-store (:store @published),\n        :name-env (merge {'php (:address @published),\n                          'php.sp (:hook-address @published),\n                          'yang.call (:call-address @published)} name-env),\n        :derivation :trusted,\n        :stage (fn [ctx name address]\n                 (stage (assoc ctx :datoms datoms :principals [(:public publisher)])\n                        name address))}))))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task stops\n   blocking, at most 80 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 80))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`, served from\n   `src`. A refused link surfaces as the program's own diagnostics.\"\n  [backend ast src]\n  (let [pair (link/make-pair)\n        task ((get backends backend) ast (composition (registry) pair))]\n    (first (drive task pair src))))\n\n\n(defn name-env\n  \"The name environment naming every published module of `result`\n   (`publish-units!`'s answer): module symbol to address.\"\n  [result]\n  (merge (into {} (map (fn [[path address]] [(lower/path-module-symbol path) address]))\n               (:addresses result))\n         (:bundles result)))\n\n\n(defn run-fixture\n  \"`{backend value}` for the multi-unit fixture `units` (`{path packet}`,\n   the entry unit `main`, default `lower/entry-path`) on the three vector\n   VMs: the non-entry units are published bottom-up, the entry unit\n   lowered `:linked` and run. `value` is `run-main`'s map.\"\n  ([units] (run-fixture units lower/entry-path {}))\n  ([units main opts]\n   (let [entry (get units main)\n         others (cond-> (mapv (fn [[path packet]] {:name path, :packet packet})\n                              (dissoc units main))\n                  (:class-map opts) (conj (assoc (:class-map opts) :name lower/classmap-name)))\n         result (publish-units! others)]\n     (when-not (= :ok (:status result))\n       (throw (ex-info \"fixture units failed to publish\" {:result result})))\n     (let [{:keys [ast warnings]}\n           (lower/lower-program entry\n                                (cond-> (merge {:prelude :linked,\n                                                :path main,\n                                                :paths (when (:computed? opts) (keys (:addresses result)))}\n                                               (dissoc opts :computed? :src :request))\n                                  (:class-map opts) (assoc :class-map true)\n                                  (some? (:request opts)) (assoc :request-node\n                                                                 (portable/request-node (:request opts)))))\n           src (or (:src opts) (source (name-env result) result))\n           sites (:set (siteset/site-set-of ast))\n           tree (vm/ast->semantic-bytecode ast)\n           ast (u/seq-nodes [(core-module/require-node 'yang.call)\n                             (core-module/require-node 'php)\n                             (core-module/require-node 'php.sp)\n                             (vm/semantic-bytecode->ast\n                               (:tree (sp/insert tree (into {} sites) safepoint/ticks-profile)))])]\n       {:warnings warnings,\n        :values (into {}\n                      (map (fn [k] [k (vm/value (run-linked k ast src))]))\n                      (keys backends))}))))\n","exit_code":0,"status":"completed"}}
