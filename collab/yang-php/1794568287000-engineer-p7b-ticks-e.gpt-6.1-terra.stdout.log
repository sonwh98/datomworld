ord\nsrc/cljc/yang/php/antlr/prelude.cljc:98:  (into '#{cell/new cell/get cell/set! cell/dsg__new-provenance cell/dsg__provenance\nsrc/cljc/yang/php/antlr/prelude.cljc:103:           integer/integer? integer/add integer/sub integer/neg integer/mul integer/compare\nsrc/cljc/yang/php/antlr/prelude.cljc:202:     ;; never called in a correct run: the two-operand `cell/new` is refused\nsrc/cljc/yang/php/antlr/prelude.cljc:205:     (fn [msg] (cell/new msg :php/unexpected-second-operand))]\nsrc/cljc/yang/php/antlr/prelude.cljc:214:     ;; before any guest code (including request binding) runs, so an empty\nsrc/cljc/yang/php/antlr/prelude.cljc:253:             flag (cell/new :first)]\nsrc/cljc/yang/php/antlr/prelude.cljc:266:             flag (cell/new :first)]\nsrc/cljc/yang/php/antlr/prelude.cljc:292:             flag (cell/new :first)]\nsrc/cljc/yang/php/antlr/prelude.cljc:384:    ;; ---------------------------------------------------------------- request and output\nsrc/cljc/yang/php/antlr/prelude.cljc:385:    [php/request-array-loop\nsrc/cljc/yang/php/antlr/prelude.cljc:389:           (php/request-array-loop entries (+ i 1)\nsrc/cljc/yang/php/antlr/prelude.cljc:392:    [php/request-array\nsrc/cljc/yang/php/antlr/prelude.cljc:398:           (php/request-array-loop entries 0 (php/empty-array)))))]\nsrc/cljc/yang/php/antlr/prelude.cljc:399:    [php/request-field\nsrc/cljc/yang/php/antlr/prelude.cljc:400:     (fn [request field]\nsrc/cljc/yang/php/antlr/prelude.cljc:401:       (php/request-array (get request field)))]\nsrc/cljc/yang/php/antlr/prelude.cljc:402:    [php/request-max-key\nsrc/cljc/yang/php/antlr/prelude.cljc:407:           (php/request-max-key order (+ i 1) n\nsrc/cljc/yang/php/antlr/prelude.cljc:414:    [php/request-ensure-next\nsrc/cljc/yang/php/antlr/prelude.cljc:422:         (let [m (php/request-max-key (php/array-order arr) 0\nsrc/cljc/yang/php/antlr/prelude.cljc:426:    [php/request-merge-into\nsrc/cljc/yang/php/antlr/prelude.cljc:427:     ;; PHP's requests-table merge (php-src main/php_variables.c,\nsrc/cljc/yang/php/antlr/prelude.cljc:433:       (php/request-merge-keys (php/request-ensure-next base)\nsrc/cljc/yang/php/antlr/prelude.cljc:436:    [php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:437:     ;; PHP's requests-table merge (php-src main/php_variables.c,\nsrc/cljc/yang/php/antlr/prelude.cljc:449:                   (php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:450:                     (php/array-put base k (php/request-merge-into old v))\nsrc/cljc/yang/php/antlr/prelude.cljc:452:                   (php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:454:               (php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:459:                   (php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:460:                     (php/array-put base k (php/request-merge-into old v))\nsrc/cljc/yang/php/antlr/prelude.cljc:462:                   (php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:464:               (php/request-merge-keys\nsrc/cljc/yang/php/antlr/prelude.cljc:467:    [php/bind-request!\nsrc/cljc/yang/php/antlr/prelude.cljc:468:     (fn [request]\nsrc/cljc/yang/php/antlr/prelude.cljc:469:       (let [geta (php/request-field request :php.request/query)\nsrc/cljc/yang/php/antlr/prelude.cljc:470:             post (php/request-field request :php.request/body)\nsrc/cljc/yang/php/antlr/prelude.cljc:471:             cookies (php/request-field request :php.request/cookies)\nsrc/cljc/yang/php/antlr/prelude.cljc:473:                      (php/array-put (php/request-field request :php.request/server)\nsrc/cljc/yang/php/antlr/prelude.cljc:475:                                     (let [method (get request :php.request/method)]\nsrc/cljc/yang/php/antlr/prelude.cljc:477:                      \"REQUEST_URI\" (let [uri (get request :php.request/uri)]\nsrc/cljc/yang/php/antlr/prelude.cljc:479:             env (php/request-field request :php.request/env)\nsrc