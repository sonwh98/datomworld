{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'admit-request|parse-unit|source-violations|eval.*revision|compiler' src/clj/yang src/cljc/yang/php test/yang/php | head -180\"","aggregated_output":"src/clj/yang/io.clj:2:  \"Platform-specific I/O for Yang compiler on JVM.\nsrc/clj/yang/typescript/antlr/cst.clj:48:  ([worker unit source] (cst/parse-unit worker unit source)))\nsrc/clj/yang/antlr/cst.clj:123:(defn parse-unit\nsrc/clj/yang/antlr/cst.clj:159:  (packet/transform parse-unit worker))\nsrc/cljc/yang/php/antlr/cst.cljc:57:   (let [pk (cst/parse-unit worker unit source)]\nsrc/cljc/yang/php/antlr/quoted.cljc:13:     (if (find-ns 'cljd.compiler)\ntest/yang/php/antlr/programs_p8.cljc:2:  \"P8 corpus for the programs formerly run through the legacy compiler.\ntest/yang/php/antlr/programs_p8.cljc:3:   Expectations are PHP semantics, not the legacy compiler's returned values.\")\ntest/yang/php/antlr/eval_admission_test.clj:32:        result (admission/admit-request request)]\ntest/yang/php/antlr/eval_admission_test.clj:49:          result (admission/admit-request {:yang.compile/request :r\ntest/yang/php/antlr/include_test.clj:18:(defn- parse-units\ntest/yang/php/antlr/include_test.clj:35:  (lh/run-fixture (parse-units fixture) \"main.php\"\nsrc/cljc/yang/php/antlr/eval_admission.cljc:71:(defn admit-request\ntest/yang/php/antlr/phpt_selection.edn:2885:   \"<?php\\nclass Test implements ArrayAccess {\\n    public function offsetExists($offset): bool {\\n        echo \\\"offsetExists given \\\";\\n        var_dump($offset);\\n        return true;\\n    }\\n    public function offsetUnset($offset): void {\\n        echo \\\"offsetUnset given \\\";\\n        var_dump($offset);\\n    }\\n    public function offsetSet($offset, $value): void {\\n        echo \\\"offsetSet given \\\";\\n        var_dump($offset);\\n    }\\n    public function offsetGet($offset): mixed {\\n        echo \\\"offsetGet given \\\";\\n        var_dump($offset);\\n        return null;\\n    }\\n}\\n\\n$test = new Test;\\n\\n/* These should all produce string(...) \\\"...\\\" output and not int(...) */\\nisset($test['0']);\\nisset($test['123']);\\nunset($test['0']);\\nunset($test['123']);\\n$test['0'] = true;\\n$test['123'] = true;\\n$foo = $test['0'];\\n$foo = $test['123'];\\n\\n/* These caused the same bug, but in opcache rather than the compiler */\\nisset($test[(string)'0']);\\nisset($test[(string)'123']);\\nunset($test[(string)'0']);\\nunset($test[(string)'123']);\\n$test[(string)'0'] = true;\\n$test[(string)'123'] = true;\\n$foo = $test[(string)'0'];\\n$foo = $test[(string)'123'];\\n\\n/**\\n * @see https://github.com/php/php-src/pull/2607#issuecomment-313781748\\n */\\nfunction test(): string {\\n    $array[\\\"10\\\"] = 42;\\n    foreach ($array as $key => $value) {\\n        return $key;\\n    }\\n}\\n\\nvar_dump(test());\\n\\n/**\\n * Make sure we don't break arrays.\\n */\\n$array = [];\\n\\n$key = '123';\\n\\n$array[$key] = 1;\\n$array['321'] = 2;\\n$array['abc'] = 3;\\n\\nvar_dump($array);\\n\\n/**\\n * Make sure that we haven't broken ArrayObject\\n */\\n$ao = new ArrayObject();\\n\\n$key = '123';\\n\\n$ao = [];\\n$ao[$key] = 1;\\n$ao['321'] = 2;\\n$ao['abc'] = 3;\\n\\nvar_dump($ao);\\n\\n?>\",\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/eval_admission.cljc src/cljc/yang/php/antlr/cst.cljc test/yang/php/antlr/eval_admission_test.clj'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/php/antlr/eval_admission.cljc src/cljc/yang/php/antlr/cst.cljc test/yang/php/antlr/eval_admission_test.clj'","aggregated_output":"(ns yang.php.antlr.eval-admission\n  \"Strict UTF-8 admission for an eval source carried as one character per byte.\n   This boundary does not execute or compile the admitted source.\"\n  (:require [dao.host.text :as text])\n  #?(:cljd (:import [\"dart:typed_data\" Uint8List])))\n\n\n(def profile-revision :yang.php.eval/utf8-v1)\n\n\n(defn- bad-sequence\n  \"Return the first malformed interval. An invalid continuation is included;\n   truncation ends at EOF. Illegal leaders occupy one byte.\"\n  [bs]\n  (let [n (count bs)]\n    (loop [i 0]\n      (when (< i n)\n        (let [b (nth bs i)\n              width (cond (< b 0x80) 1 (<= 0xc2 b 0xdf) 2\n                          (<= 0xe0 b 0xef) 3 (<= 0xf0 b 0xf4) 4\n                          :else 0)]\n          (cond\n            (zero? width) [i (inc i)]\n            (= width 1) (recur (inc i))\n            :else\n            (let [end (loop [j 1]\n                        (if (= j width)\n                          nil\n                          (let [p (+ i j)]\n                            (cond\n                              (>= p n) n\n                              (let [v (nth bs p)]\n                                (not (and (<= 0x80 v 0xbf)\n                                          (or (not= j 1)\n                                              (and (or (not= b 0xe0) (>= v 0xa0))\n                                                   (or (not= b 0xed) (< v 0xa0))\n                                                   (or (not= b 0xf0) (>= v 0x90))\n                                                   (or (not= b 0xf4) (< v 0x90)))))))\n                              (inc p)\n                              :else (recur (inc j))))))]\n              (if end [i end] (recur (+ i width))))))))))\n\n\n(defn- host-bytes\n  [bs]\n  #?(:cljd (Uint8List.fromList bs)\n     :clj (byte-array (map unchecked-byte bs))\n     :cljs (js/Uint8Array. (clj->js bs))))\n\n\n(defn admit\n  \"Decode a byte carrier once. Malformed carriers are protocol violations;\n   malformed UTF-8 produces the classified PHP diagnostic.\"\n  [carrier]\n  (if-not (string? carrier)\n    {:reason :carrier-representation}\n    (let [bs (mapv #(text/code-unit carrier %) (range (text/unit-count carrier)))]\n      (if (some #(> % 255) bs)\n        {:reason :carrier-representation}\n        (if-let [[start end] (bad-sequence bs)]\n          {:diagnostic {:yang.php/diagnostic :yang.php/unsupported\n                        :construct :eval :reason :source-encoding :encoding :utf-8\n                        :byte-offset start :span [start end]}}\n          (let [source (text/utf8-decode (host-bytes bs))\n                encoded (mapv #(bit-and % 255) (text/utf8-encode source))]\n            (if (= bs encoded)\n              {:source source}\n              (throw (ex-info \"UTF-8 round trip failed\" {:reason :utf8-round-trip})))))))))\n\n\n(defn admit-request\n  \"Admit a sealed eval request, preserving correlation and provenance on refusal.\n   On success the original request and its derived parser view travel together.\"\n  [request]\n  (let [{:keys [source diagnostic reason]} (admit (:yang.php/source request))]\n    (cond\n      diagnostic (assoc (select-keys request [:yang.compile/request :yang.compile/unit\n                                              :yang.compile/provenance])\n                        :yang.compile/outcome :yang.compile/rejected\n                        :yang.compile/reason :yang.compile/unsupported\n                        :yang.compile/diagnostic diagnostic)\n      reason (assoc (select-keys request [:yang.compile/request :yang.compile/unit\n                                          :yang.compile/provenance])\n                    :yang.compile/outcome :yang.compile/rejected\n                    :yang.compile/reason :yang.compile/invalid-request\n                    :yang.compile/detail reason)\n      :else {:request request :source source})))\n(ns yang.php.antlr.cst\n  \"The PHP parser worker (docs/design/yang.php.md section 6): the\n   grammars-v4 php grammar profile over the generic `yang.antlr.cst` worker.\n   The generated recognizers come from `bb gen:antlr` (antlr/php/manifest.edn);\n   the JVM and Node use the same grammar and export profile. The entry rule is `htmlDocument`.\n\n   The grammar's non-standard generics (`typeParameterListInBrackets`, the\n   `<: ... :>` brackets) are not PHP: a parse that uses them is refused as\n   `{:yang.php/not-php :generics}` rather than exported.\"\n  (:require\n    [yang.antlr.cst :as cst]\n    [dao.host.text :as text]\n    #?@(:cljs [[\"/yang/antlr/gen/php/PhpLexer.js\" :default PhpLexer]\n               [\"/yang/antlr/gen/php/PhpParser.js\" :default PhpParser]]))\n  #?(:clj (:import (yang.php.antlr.gen PhpLexer PhpParser))))\n\n\n(def grammar-id\n  \"grammars-v4 php at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/php@85e2dd1779ce556111ef98ead5d62a9858e95599 antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   :make-lexer (fn [cs] (PhpLexer. cs)),\n   :make-parser (fn [ts] (PhpParser. ts)),\n   :start #?(:clj (fn [^PhpParser p] (.htmlDocument p))\n             :cljs (fn [^js p] (.htmlDocument p)))})\n\n\n(defn make-worker\n  []\n  (cst/make-worker profile))\n\n\n(defn- generics?\n  [pk]\n  (boolean (some #(= \"typeParameterListInBrackets\" (:rule %))\n                 (:yang.cst/nodes pk))))\n\n\n(defn- line-starts\n  \"The UTF-8 byte offsets at which each source line begins (the line side\n   table, section 17: derived at the parse boundary, where the source is\n   known, so no later stage needs the text).\"\n  [source]\n  (let [bs (text/utf8-encode source)]\n    (into [0] (keep-indexed (fn [i b] (when (= b 10) (inc i)))) bs)))\n\n\n(defn parse-source\n  \"Parse one complete PHP source string as unit `unit`: the CST packet, or\n   `{:yang.php/not-php :generics}` when the parse uses the grammar's generics\n   extension.\"\n  ([source] (parse-source (make-worker) [:unit 0] source))\n  ([worker unit source]\n   (let [pk (cst/parse-unit worker unit source)]\n     (if (generics? pk)\n       {:yang.php/not-php :generics}\n       (assoc pk :yang.php/line-starts (line-starts source))))))\n(ns yang.php.antlr.eval-admission-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.host.text :as text]\n            [yang.php.antlr.eval-admission :as admission]))\n\n\n(defn carrier\n  [bytes]\n  (text/units->string (map #(bit-and % 255) bytes)))\n\n\n(deftest strict-source-admission\n  (doseq [[bytes span] [[[0x80] [0 1]] [[0xc0 0xaf] [0 1]]\n                        [[0xe0 0x80 0xaf] [0 2]] [[0xed 0xa0 0x80] [0 2]]\n                        [[0xf4 0x90 0x80 0x80] [0 2]] [[0xe2 0x82] [0 2]]\n                        [[0xc3 0x28] [0 2]] [[0xc3 0xa9 0xff] [2 3]]]]\n    (testing (str bytes)\n      (is (= {:yang.php/diagnostic :yang.php/unsupported :construct :eval\n              :reason :source-encoding :encoding :utf-8\n              :byte-offset (first span) :span span}\n             (:diagnostic (admission/admit (carrier bytes)))))))\n  (doseq [s [\"\" \"return 'é中😀';\" \"\\uFEFF\\u0000\\uFFFD\" \"é\" \"é\"]]\n    (is (= s (:source (admission/admit (carrier (text/utf8-encode s)))))))\n  (is (= :carrier-representation (:reason (admission/admit \"中\")))))\n\n\n(deftest correlated-worker-refusal\n  (let [request {:yang.compile/request [:caller 17]\n                 :yang.compile/unit :unit-1\n                 :yang.compile/provenance {:source :original}\n                 :yang.php/source (carrier [0xff])}\n        result (admission/admit-request request)]\n    (is (= :yang.compile/rejected (:yang.compile/outcome result)))\n    (is (= [:caller 17] (:yang.compile/request result)))\n    (is (= :unit-1 (:yang.compile/unit result)))\n    (is (= {:source :original} (:yang.compile/provenance result)))\n    (is (= [0 1] (get-in result [:yang.compile/diagnostic :span])))))\n\n\n(deftest byte-domain-fixtures\n  ;; These are admission expectations, not observations from PHP's oracle.\n  (doseq [source [\"return 'é中😀';\" \"return \\\"é中😀 $x\\\";\"\n                  \"return <<<TEXT\\né中😀 $x\\nTEXT;\"\n                  \"return <<<'TEXT'\\né中😀\\nTEXT;\"\n                  \"echo '😀'; ?>é中<?php return 1;\"\n                  \"// é\\r\\nreturn __LINE__;\\rreturn 1;\"\n                  \"\\uFEFFreturn 1;\" \"return '\\u0000\\uFFFD';\"]]\n    (let [bytes (vec (map #(bit-and % 255) (text/utf8-encode source)))\n          result (admission/admit-request {:yang.compile/request :r\n                                           :yang.php/source (carrier bytes)})]\n      (is (= source (:source result)))\n      (is (= (carrier bytes) (get-in result [:request :yang.php/source])))))\n  (doseq [bad [[0xbf] [0xc1] [0xf5] [0xff] [0xf0 0x80 0x80 0xaf]\n               [0xf0 0x9f 0x98] [0xe2 0x28 0xa1] [0xf0 0x28 0x8c 0xbc]]]\n    (is (= :source-encoding\n           (get-in (admission/admit (carrier (into [0xc3 0xa9] bad)))\n                   [:diagnostic :reason])))))\n","exit_code":0,"status":"completed"}}
