{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'cat src/clj/yang/antlr/cst.clj; cat src/cljs/yang/antlr/cst.cljs'","aggregated_output":"(ns yang.antlr.cst\n  \"The host parser interpreter's generic half (docs/design/yang.antlr.md §4.3,\n   §5.1, §5.5): assemble sealed source units, parse each with an ANTLR\n   grammar profile, and export one portable CST packet per unit.\n\n   Nothing here knows a language. A grammar profile supplies the host\n   constructors:\n\n     {:grammar-id  string naming grammar revision and tool\n      :make-lexer  (fn [CharStream] Lexer)\n      :make-parser (fn [TokenStream] Parser)\n      :start       (fn [Parser] ParserRuleContext)}\n\n   No ANTLR object leaves this namespace: a packet is plain data, in the\n   target-neutral shape `yang.antlr.packet` owns (the IR). The host-free half\n   of the export lives in `yang.antlr.export`; this file holds the JVM walk.\"\n  (:require\n    [yang.antlr.export :as export]\n    [yang.antlr.packet :as packet])\n  (:import\n    (org.antlr.v4.runtime\n      ANTLRErrorListener\n      BaseErrorListener\n      CharStreams\n      CommonTokenStream\n      Lexer\n      NoViableAltException\n      Parser\n      ParserRuleContext\n      Recognizer\n      Token)\n    (org.antlr.v4.runtime.atn\n      ATN\n      LexerATNSimulator\n      ParserATNSimulator\n      PredictionContextCache)\n    (org.antlr.v4.runtime.dfa\n      DFA)\n    (org.antlr.v4.runtime.tree\n      TerminalNode)))\n\n\n;; =============================================================================\n;; Worker: exclusively owned recognizer caches (§4.3)\n;; =============================================================================\n\n(defn- fresh-dfa\n  ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\" [^ATN atn]\n  (into-array DFA\n              (map (fn [i] (DFA. (.getDecisionState atn i) i))\n                   (range (.getNumberOfDecisions atn)))))\n\n\n(defn make-worker\n  \"A host worker for `profile` owning its own DFA and prediction-context\n   caches, so no parse shares mutable recognizer state with another worker.\n   The worker is host state owned by one parser stage; it is not data and\n   never crosses a stream.\"\n  [profile]\n  (let [lexer ^Lexer ((:make-lexer profile) (CharStreams/fromString \"\"))\n        parser ^Parser ((:make-parser profile)\n                        (CommonTokenStream. lexer))\n        lexer-atn (.getATN lexer)\n        parser-atn (.getATN parser)]\n    {:profile profile,\n     :lexer-atn lexer-atn,\n     :lexer-dfa (fresh-dfa lexer-atn),\n     :lexer-cache (PredictionContextCache.),\n     :parser-atn parser-atn,\n     :parser-dfa (fresh-dfa parser-atn),\n     :parser-cache (PredictionContextCache.)}))\n\n\n;; =============================================================================\n;; Export\n;; =============================================================================\n\n(defn- error-listener\n  \"Collects syntax errors as data into `errors` (a volatile).\"\n  [errors offsets]\n  (proxy [BaseErrorListener] []\n    (syntaxError\n      [^Recognizer recognizer offending line column msg _e]\n      (let [span (if (instance? Token offending)\n                   (let [^Token t offending]\n                     (export/token-span offsets (.getStartIndex t)\n                                        (.getStopIndex t)))\n                   (if (instance? Lexer recognizer)\n                     (let [^Lexer lx recognizer]\n                       [(export/offset-at offsets (._tokenStartCharIndex lx))\n                        (export/offset-at offsets\n                                          (.index (.getInputStream lx)))])\n                     nil))]\n        (vswap! errors conj (export/syntax-error msg line column span))))))\n\n\n(defn- ops\n  [^Parser parser]\n  (let [rule-names (.getRuleNames parser)\n        vocab (.getVocabulary parser)]\n    {:token? (fn [t] (instance? TerminalNode t)),\n     :token (fn [t]\n              (let [tok (.getSymbol ^TerminalNode t)\n                    type (.getType tok)]\n                {:type-name (if (= type Token/EOF)\n                              \"EOF\"\n                              (or (.getSymbolicName vocab type)\n                                  (.getLiteralName vocab type)\n                                  (str type))),\n                 :start (.getStartIndex tok),\n                 :stop (.getStopIndex tok),\n                 :text (.getText tok)})),\n     :rule-name (fn [ctx]\n                  (aget rule-names (.getRuleIndex ^ParserRuleContext ctx))),\n     :children (fn [^ParserRuleContext ctx]\n                 (mapv #(.getChild ctx (int %))\n                       (range (.getChildCount ctx)))),\n     :start (fn [^ParserRuleContext ctx]\n              (some-> (.getStart ctx)\n                      (.getStartIndex)))}))\n\n\n(defn parse-unit\n  \"Parse one sealed unit's `source` with `worker`; return its CST packet.\"\n  [worker unit ^String source]\n  (let [{:keys [profile]} worker\n        cps (packet/code-points source)\n        offsets (export/byte-offsets cps)\n        errors (volatile! [])\n        listener (error-listener errors offsets)\n        lexer ^Lexer ((:make-lexer profile) (CharStreams/fromString source))\n        _ (.setInterpreter lexer\n                           (LexerATNSimulator. lexer\n                                               ^ATN (:lexer-atn worker)\n                                               ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\"\n                                               (:lexer-dfa worker)\n                                               ^PredictionContextCache\n                                               (:lexer-cache worker)))\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer listener)\n        parser ^Parser ((:make-parser profile) (CommonTokenStream. lexer))\n        _ (.setInterpreter parser\n                           (ParserATNSimulator. parser\n                                                ^ATN (:parser-atn worker)\n                                                ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\"\n                                                (:parser-dfa worker)\n                                                ^PredictionContextCache\n                                                (:parser-cache worker)))\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser listener)\n        tree ((:start profile) parser)]\n    (export/result profile unit @errors\n                   #(export/export-nodes (ops parser) cps offsets tree))))\n\n\n(defn parse-transform\n  \"The parser stage's transform over source events (`packet/transform`).\"\n  [worker]\n  (packet/transform parse-unit worker))\n\n\n(defn utf8-bytes\n  \"The UTF-8 byte count of a string: span ends are checked against it.\"\n  [^String s]\n  (packet/utf8-bytes s))\n\n\n(defn first-failure\n  \"Where the grammar first refuses `source` with `worker`: nil when it\n   parses, `:end` when the first error failed on an end-of-input token, else\n   `:early` (`export/failure-kind` decides).\n\n   The failing token is the offending token of a mismatch; for a\n   no-viable-alternative error the JVM runtime lazy-fills its token\n   buffer, so the buffer's last token is the furthest the parser had read\n   when the error was reported (the JS and Dart runtimes fill to EOF and\n   use the listener's offending token instead — their hosts' cst\n   namespaces carry that rationale). A lexer error has no token.\"\n  [worker source]\n  (let [{:keys [profile lexer-atn lexer-dfa lexer-cache parser-atn\n                parser-dfa parser-cache]}\n        worker\n        failure (volatile! nil)\n        lexer ^Lexer ((:make-lexer profile) (CharStreams/fromString source))\n        tokens (CommonTokenStream. lexer)\n        listener (proxy [BaseErrorListener] []\n                   (syntaxError\n                     [_recognizer offending _line _column _msg e]\n                     (when-not @failure\n                       (vreset! failure\n                                (cond\n                                  (not (instance? Token offending)) :lexical\n                                  (instance? NoViableAltException e)\n                                  (dec (count (.getTokens tokens)))\n                                  :else (.getTokenIndex ^Token offending))))))\n        _ (.setInterpreter\n            lexer\n            (LexerATNSimulator. lexer\n                                ^ATN lexer-atn\n                                ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\" lexer-dfa\n                                ^PredictionContextCache lexer-cache))\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer ^ANTLRErrorListener listener)\n        parser ^Parser ((:make-parser profile) tokens)\n        _ (.setInterpreter\n            parser\n            (ParserATNSimulator. parser\n                                 ^ATN parser-atn\n                                 ^\"[Lorg.antlr.v4.runtime.dfa.DFA;\" parser-dfa\n                                 ^PredictionContextCache parser-cache))\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser ^ANTLRErrorListener listener)]\n    ((:start profile) parser)\n    (export/failure-kind\n      @failure\n      (keep (fn [^Token t]\n              (when (not= Token/EOF (.getType t))\n                {:index (.getTokenIndex t),\n                 :start (.getStartIndex t),\n                 :stop (.getStopIndex t)}))\n            (.getTokens tokens)))))\n(ns yang.antlr.cst\n  \"The Node host's parser interpreter (docs/design/yang.antlr.md §4.3, §5.5):\n   the same public names as the JVM's `yang.antlr.cst` over the antlr4 npm\n   runtime. A grammar profile supplies the host constructors:\n\n     {:grammar-id  string naming grammar revision and tool\n      :make-lexer  (fn [CharStream] Lexer)\n      :make-parser (fn [TokenStream] Parser)\n      :start       (fn [Parser] ParserRuleContext)}\n\n   No ANTLR object leaves this namespace: a packet is plain data, in the\n   target-neutral shape `yang.antlr.packet` owns (the IR). The host-free half\n   of the export lives in `yang.antlr.export`; this file holds the Node\n   walk. `CharStreams.fromString` opens a code-point stream, the unit the JVM\n   indexes.\"\n  (:require\n    [\"antlr4\" :default antlr4]\n    [yang.antlr.export :as export]\n    [yang.antlr.packet :as packet]))\n\n\n;; Depending on how the host binds the package, the `atn`/`dfa` namespaces\n;; sit at top level or only under `default`; the generated parsers use the\n;; same fallback.\n(def ^:private antlr4-default (or (.-default antlr4) antlr4))\n\n\n;; The runtime's NoViableAltException: top level in the CommonJS build, under\n;; `error` in the ES module's default export.\n(def ^:private no-viable-alt-exception\n  (or (.-NoViableAltException antlr4)\n      (some-> antlr4 .-error .-NoViableAltException)\n      (some-> antlr4-default .-error .-NoViableAltException)))\n\n\n(defn- char-stream\n  [source]\n  (.fromString (.-CharStreams antlr4) source))\n\n\n;; =============================================================================\n;; Worker: exclusively owned recognizer caches (§4.3)\n;; =============================================================================\n\n(defn- fresh-dfa\n  [^js atn]\n  (.map (.-decisionToState atn)\n        (fn [state i] (new (.. antlr4-default -dfa -DFA) state i))))\n\n\n(defn make-worker\n  \"A host worker for `profile` owning its own DFA and prediction-context\n   caches, so no parse shares mutable recognizer state with another worker.\n   The worker is host state owned by one parser stage; it is not data and\n   never crosses a stream.\"\n  [profile]\n  (let [^js lexer ((:make-lexer profile) (char-stream \"\"))\n        ^js parser ((:make-parser profile) (new (.-CommonTokenStream antlr4) lexer))\n        lexer-atn (.. lexer -_interp -atn)\n        parser-atn (.. parser -_interp -atn)]\n    {:profile profile,\n     :lexer-atn lexer-atn,\n     :lexer-dfa (fresh-dfa lexer-atn),\n     :lexer-cache (new (.. antlr4-default -atn -PredictionContextCache)),\n     :parser-atn parser-atn,\n     :parser-dfa (fresh-dfa parser-atn),\n     :parser-cache (new (.. antlr4-default -atn -PredictionContextCache))}))\n\n\n(defn- own-lexer!\n  [^js lexer {:keys [lexer-atn lexer-dfa lexer-cache]}]\n  (set! (.-_interp lexer)\n        (new (.. antlr4-default -atn -LexerATNSimulator)\n             lexer lexer-atn lexer-dfa lexer-cache)))\n\n\n(defn- own-parser!\n  [^js parser {:keys [parser-atn parser-dfa parser-cache]}]\n  (set! (.-_interp parser)\n        (new (.. antlr4-default -atn -ParserATNSimulator)\n             parser parser-atn parser-dfa parser-cache)))\n\n\n;; =============================================================================\n;; Export\n;; =============================================================================\n\n(defn- token?\n  [t]\n  (and (some? t) (number? (.-start t)) (number? (.-stop t))))\n\n\n(defn- listener\n  \"An error listener whose `syntaxError` is `f`.\"\n  [f]\n  (let [^js l (new (.. antlr4-default -error -ErrorListener))]\n    (set! (.-syntaxError l) f)\n    l))\n\n\n(defn- error-listener\n  \"Collects syntax errors as data into `errors` (a volatile).\"\n  [errors offsets]\n  (listener\n    (fn [^js recognizer ^js offending line column msg _e]\n      (let [span (cond\n                   (token? offending)\n                   (export/token-span offsets (.-start offending)\n                                      (.-stop offending))\n\n                   (instance? (.-Lexer antlr4) recognizer)\n                   [(export/offset-at offsets (._tokenStartCharIndex recognizer))\n                    (export/offset-at offsets (.. recognizer -_input -index))]\n\n                   :else nil)]\n        (vswap! errors conj (export/syntax-error msg line column span))))))\n\n\n(defn- ops\n  [^js parser]\n  (let [rule-names (.-ruleNames parser)\n        symbolic (.-symbolicNames parser)\n        literal (.-literalNames parser)]\n    {:token? (fn [t] (instance? (.. antlr4-default -tree -TerminalNode) t)),\n     :token (fn [^js t]\n              (let [^js tok (.-symbol t)\n                    type (.-type tok)]\n                {:type-name (if (= type -1)\n                              \"EOF\"\n                              (or (aget symbolic type)\n                                  (aget literal type)\n                                  (str type))),\n                 :start (.-start tok),\n                 :stop (.-stop tok),\n                 :text (.-text tok)})),\n     :rule-name (fn [^js ctx] (aget rule-names (.-ruleIndex ctx))),\n     :children (fn [^js ctx] (vec (.-children ctx))),\n     :start (fn [^js ctx] (some-> (.-start ctx) (.-start)))}))\n\n\n(defn parse-unit\n  \"Parse one sealed unit's `source` with `worker`; return its CST packet.\"\n  [worker unit source]\n  (let [{:keys [profile]} worker\n        cps (packet/code-points source)\n        offsets (export/byte-offsets cps)\n        errors (volatile! [])\n        l (error-listener errors offsets)\n        ^js lexer ((:make-lexer profile) (char-stream source))\n        _ (own-lexer! lexer worker)\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer l)\n        ^js parser ((:make-parser profile) (new (.-CommonTokenStream antlr4) lexer))\n        _ (own-parser! parser worker)\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser l)\n        tree ((:start profile) parser)]\n    (export/result profile unit @errors\n                   #(export/export-nodes (ops parser) cps offsets tree))))\n\n\n(defn parse-transform\n  \"The parser stage's transform over source events (`packet/transform`).\"\n  [worker]\n  (packet/transform parse-unit worker))\n\n\n(defn utf8-bytes\n  \"The UTF-8 byte count of a string: span ends are checked against it.\"\n  [s]\n  (packet/utf8-bytes s))\n\n\n(defn first-failure\n  \"Where the grammar first refuses `source` with `worker`: nil when it\n   parses, `:end` when the first error failed on an end-of-input token, else\n   `:early` (`export/failure-kind` decides). See the JVM namespace, whose\n   lazy-buffer rule is canonical (owner, 2026-10-24).\n\n   For a no-viable-alternative error the JVM takes the last token its lazily\n   filled buffer holds: the furthest token the parser asked the stream to\n   sync. The JS stream is filled to EOF by the time the listener runs (the\n   error strategy's getText calls fill(), which bypasses sync), so its\n   buffer size cannot say that; instead the stream records the furthest\n   sync target, and the failing token is that index, capped at the last\n   token as the JVM's fetch is. Any other error uses the listener's\n   offending token, as on the JVM.\"\n  [worker source]\n  (let [{:keys [profile]} worker\n        failure (volatile! nil)\n        furthest (volatile! -1)\n        ^js lexer ((:make-lexer profile) (char-stream source))\n        ^js tokens (new (.-CommonTokenStream antlr4) lexer)\n        sync (.-sync tokens)\n        _ (set! (.-sync tokens)\n                (fn [i]\n                  (vswap! furthest max i)\n                  (.call sync tokens i)))\n        l (listener\n            (fn [_recognizer ^js offending _line _column _msg e]\n              (when-not @failure\n                (vreset! failure\n                         (cond\n                           (not (token? offending)) :lexical\n                           (instance? no-viable-alt-exception e)\n                           (min @furthest (dec (.-length (.-tokens tokens))))\n                           :else (.-tokenIndex offending))))))\n        _ (own-lexer! lexer worker)\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer l)\n        ^js parser ((:make-parser profile) tokens)\n        _ (own-parser! parser worker)\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser l)]\n    ((:start profile) parser)\n    (export/failure-kind\n      @failure\n      (keep (fn [^js t]\n              (when (not= -1 (.-type t))\n                {:index (.-tokenIndex t), :start (.-start t), :stop (.-stop t)}))\n            (.-tokens tokens)))))\n","exit_code":0,"status":"completed"}}
