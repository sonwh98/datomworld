\\\\\\\\n  1301\\\\\\\\t      \\\\\\\\\\\\\\\"OpenRoundBracket\\\\\\\\\\\\\\\" (lower-cast ctx n ks)\\\\\\\\n  1302\\\\\\\\t      \\\\\\\\\\\\\\\"Throw\\\\\\\\\\\\\\\" (app* 'php/throw-value (lower ctx operand))\\\\\\\\n  1303\\\\\\\\t      \\\\\\\\\\\\\\\"Clone\\\\\\\\\\\\\\\" (app* 'php/clone-obj (lower ctx operand) (cc-node ctx))\\\\\\\\n  1304\\\\\\\\t      \\\\\\\\\\\\\\\"List\\\\\\\\\\\\\\\" (lower-destructure ctx n\\\\\\\\n  1305\\\\\\\\t                                (pattern-of ctx n (first (core/rules ctx n \\\\\\\\\\\\\\\"assignmentList\\\\\\\\\\\\\\\")))\\\\\\\\n  1306\\\\\\\\t                                (last ks))\\\\\\\\n  1307\\\\\\\\t      (if-let [kind (get include-kinds t)]\\\\\\\\n  1308\\\\\\\\t        (lower-include ctx n kind operand)\\\\\\\\n  1309\\\\\\\\t        (if-let [construct (get prefix-refusals t)]\\\\\\\\n  1310\\\\\\\\t          (unsupported! n construct)\\\\\\\\n  1311\\\\\\\\t          (unsupported! n (keyword (str/lower-case t))))))))\\\\\\\\n  1312\\\\\\\\t\\\\\\\\n  1313\\\\\\\\t\\\\\\\\n  1314\\\\\\\\t(def ^:private assignment-ops\\\\\\\\n  1315\\\\\\\\t  {\\\\\\\\\\\\\\\"PlusEqual\\\\\\\\\\\\\\\" 'php/add,\\\\\\\\n  1316\\\\\\\\t   \\\\\\\\\\\\\\\"MinusEqual\\\\\\\\\\\\\\\" 'php/sub,\\\\\\\\n  1317\\\\\\\\t   \\\\\\\\\\\\\\\"MulEqual\\\\\\\\\\\\\\\" 'php/mul,\\\\\\\\n  1318\\\\\\\\t   \\\\\\\\\\\\\\\"PowEqual\\\\\\\\\\\\\\\" 'php/pow,\\\\\\\\n  1319\\\\\\\\t   \\\\\\\\\\\\\\\"DivEqual\\\\\\\\\\\\\\\" 'php/div,\\\\\\\\n  1320\\\\\\\\t   \\\\\\\\\\\\\\\"Concaequal\\\\\\\\\\\\\\\" 'php/concat,\\\\\\\\n  1321\\\\\\\\t   \\\\\\\\\\\\\\\"ModEqual\\\\\\\\\\\\\\\" 'php/mod,\\\\\\\\n  1322\\\\\\\\t   \\\\\\\\\\\\\\\"ShiftLeftEqual\\\\\\\\\\\\\\\" 'php/shl,\\\\\\\\n  1323\\\\\\\\t   \\\\\\\\\\\\\\\"ShiftRightEqual\\\\\\\\\\\\\\\" 'php/shr,\\\\\\\\n  1324\\\\\\\\t   \\\\\\\\\\\\\\\"AndEqual\\\\\\\\\\\\\\\" 'php/bit-and,\\\\\\\\n  1325\\\\\\\\t   \\\\\\\\\\\\\\\"OrEqual\\\\\\\\\\\\\\\" 'php/bit-or,\\\\\\\\n  1326\\\\\\\\t   \\\\\\\\\\\\\\\"XorEqual\\\\\\\\\\\\\\\" 'php/bit-xor})\\\\\\\\n  1327\\\\\\\\t\\\\\\\\n  1328\\\\\\\\t\\\\\\\\n  1329\\\\\\\\t(defn- fresh-value?\\\\\\\\n  1330\\\\\\\\t  \\\\\\\\\\\\\\\"True when expression `e` is syntactically a literal or constant, so the\\\\\\\\n  1331\\\\\\\\t   value it answers is not another holder's (no ADDREF needed).\\\\\\\\\\\\\\\"\\\\\\\\n  1332\\\\\\\\t  [ctx e]\\\\\\\\n  1333\\\\\\\\t  (let [ks (core/kids ctx e)]\\\\\\\\n  1334\\\\\\\\t    (and (= 1 (count ks))\\\\\\\\n  1335\\\\\\\\t         (p/rule? (first ks))\\\\\\\\n  3135\\\\\\\\t                         (app* 'php/prop-write!\\\\\\\\n  3136\\\\\\\\t                               (app* 'php/this-of (u/v '%fn))\\\\\\\\n  3137\\\\\\\\t                               (u/lit (bare (:name pp)))\\\\\\\\n  3138\\\\\\\\t                               (u/v '%cc)\\\\\\\\n  3139\\\\\\\\t                               (app* 'php/addref (read-var fctx (:name pp)))))\\\\\\\\n  3140\\\\\\\\t                       promoted)\\\\\\\\n  3141\\\\\\\\t        body (if arrow?\\\\\\\\n  3142\\\\\\\\t               (let [e (lower fctx (last (core/rules ctx n \\\\\\\\\\\\\\\"expression\\\\\\\\\\\\\\\")))]\\\\\\\\n  3143\\\\\\\\t                 (if checked? (coerce-return-node fctx e rtype written) e))\\\\\\\\n  3144\\\\\\\\t               (u/then (lower fctx block)\\\\\\\\n  3145\\\\\\\\t                       (cond\\\\\\\\n  3146\\\\\\\\t                         checked? (app* 'php/return-none (u/lit rtype) (u/lit written))\\\\\\\\n  3147\\\\\\\\t                         never? (app* 'php/never-returned (u/lit written))\\\\\\\\n  3148\\\\\\\\t                         :else (u/lit :php/null))))\\\\\\\\n  3149\\\\\\\\t        body (if (seq prologue) (u/then (u/seq-nodes prologue) body) body)\\\\\\\\n  3150\\\\\\\\t        checks (keep-indexed (fn [i pp]\\\\\\\\n  3151\\\\\\\\t                               (when (and (:type pp) (not (:variadic? pp)))\\\\\\\\n  3152\\\\\\\\t                                 (app* 'php/check-param-cell! (u/v (symbol (:name pp))) (u/lit (:type pp))\\\\\\\\n  3153\\\\\\\\t                                       (u/lit written) (u/lit (inc i)) (u/lit (bare (:name pp))))))\\\\\\\\n  3154\\\\\\\\t                             params)\\\\\\\\n  3155\\\\\\\\t        body (if (seq checks) (u/then (u/seq-nodes checks) body) body)\\\\\\\\n  3156\\\\\\\\t        body (if has-return? (app* 'php/call-ec (u/lam ['%ret] body)) body)\\\\\\\\n  3157\\\\\\\\t        cvs (concat (map :name params) (map :name captures) static-names-v locals)\\\\\\\\n  3158\\\\\\\\t        body (if generator?\\\\\\\\n  3159\\\\\\\\t               (app* 'php/make-generator\\\\\\\\n  3160\\\\\\\\t                     (u/lit written)\\\\\\\\n  3161\\\\\\\\t                     (u/lam ['%gen] body)\\\\\\\\n  3162\\\\\\\\t                     (u/lam []\\\\\\\\n  3163\\\\\\\\t                            (app* 'php/release-cvs\\\\\\\\n  3164\\\\\\\\t                                  (args-vector (map #(u/v (symbol %)) cvs))\\\\\\\\n  3165\\\\\\\\t                                  (u/lit 0)\\\\\\\\n  3166\\\\\\\\t                                  (u/lit (count cvs)))))\\\\\\\\n  3167\\\\\\\\t               body)\\\\\\\\n  3168\\\\\\\\t        variadic? (boolean (some :variadic? params))\\\\\\\\n  3169\\\\\\\\t        fixed (remove :variadic? params)\\\\\\\\n  3170\\\\\\\\t        total (count fixed)\\\\\\\\n  3171\\\\\\\\t        required (inc (or (last (keep-indexed (fn [i p] (when-not (:default p) i)) fixed)) -1))\\\\\\\\n  3172\\\\\\\\t        bindings (concat\\\\\\\\n  3173\\\\\\\\t                   (map-indexed (fn [i p]\\\\\\\\n  3174\\\\\\\\t                                  [(symbol (:name p))\\\\\\\\n  3175\\\\\\\\t                                   (param-binding fctx n written required (= required total) i p)])\\\\\\\\n  3176\\\\\\\\t                                params)\\\\\\\\n  3177\\\\\\\\t                   (map (fn [c]\\\\\\\\n  3178\\\\\\\\t                          [(symbol (:name c))\\\\\\\\n  3179\\\\\\\\t                           (if (:ref? c)\\\\\\\\n  3180\\\\\\\\t                             (app* 'php/param-ref\\\\\\\\n  3181\\\\\\\\t                                   (u/v (:sym c))\\\\\\\\n  3182\\\\\\\\t                                   (u/lit \\\\\\\\\\\\\\\"sha256:171656777d777865312132fe18cbc7a057a4721844a4dc450c0800381d2223eb\\\\\\\\\\\\\\\"))\\\\\\\\n100:(def ^:private prefix-refusals\\\\\\\\n1309:        (if-let [construct (get prefix-refusals t)]\\\\\\\\n1819:        ;; the name builtins and special forms are keyed by, and the unit's\\\\\\\\n     1\\\\\\\\t(ns yang.stage\\\\\\\\n     2\\\\\\\\t  \\\\\\\\\\\\\\\"One compiler stage: an interpreter that reads one dao.stream and writes\\\\\\\\n     3\\\\\\\\t   others (docs/design/yang.antlr.md §1.1, §5.4, §6.2). Language-neutral:\\\\\\\\n     4\\\\\\\\t   the Python parser and lowering and the `yang.safepoint` stage all run on\\\\\\\\n     5\\\\\\\\t   it.\\\\\\\\n     6\\\\\\\\t\\\\\\\\n     7\\\\\\\\t   A stage is a value:\\\\\\\\n     8\\\\\\\\t\\\\\\\\n     9\\\\\\\\t     {:in      reader handle\\\\\\\\n    10\\\\\\\\t      :cursor  its read position\\\\\\\\n    11\\\\\\\\t      :outs    {port writer-handle}\\\\\\\\n    12\\\\\\\\t      :outbox  [[port value] ...]   ; staged, not yet appended\\\\\\\\n    13\\\\\\\\t      :state   the transform's own state\\\\\\\\n    14\\\\\\\\t      :status  :blocked | :end | :full | nil}\\\\\\\\n    15\\\\\\\\t\\\\\\\\n    16\\\\\\\\t   `step` flushes the outbox, then reads until the input blocks or ends or an\\\\\\\\n    17\\\\\\\\t   output is full. The transform is a pure function\\\\\\\\n    18\\\\\\\\t   `(transform state value) -> [state' [[port value] ...]]`; it never touches\\\\\\\\n    19\\\\\\\\t   a stream. A `full` append keeps the identical staged value and yields; a\\\\\\\\n    20\\\\\\\\t   `blocked` read keeps state and cursor and yields. Nothing buffers without\\\\\\\\n    21\\\\\\\\t   bound: a non-empty outbox stops reading.\\\\\\\\\\\\\\\"\\\\\\\\n    22\\\\\\\\t  (:require\\\\\\\\n    23\\\\\\\\t    [dao.stream :as stream]))\\\\\\\\n    24\\\\\\\\t\\\\\\\\n    25\\\\\\\\t\\\\\\\\n    26\\\\\\\\t(defn- oldest-cursor\\\\\\\\n    27\\\\\\\\t  [handle]\\\\\\\\n    28\\\\\\\\t  (let [result (stream/cursor handle stream/anchor-oldest)]\\\\\\\\n    29\\\\\\\\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\\\\\\\\n    30\\\\\\\\t      (throw (ex-info \\\\\\\\\\\\\\\"Stage input refused a cursor\\\\\\\\\\\\\\\" {:result result})))\\\\\\\\n    31\\\\\\\\t    (:dao.stream/cursor result)))\\\\\\\\n    32\\\\\\\\t\\\\\\\\n    33\\\\\\\\t\\\\\\\\n    34\\\\\\\\t(defn open\\\\\\\\n    35\\\\\\\\t  \\\\\\\\\\\\\\\"A stage reading `in` from its oldest value and writing the `outs` ports.\\\\\\\\\\\\\\\"\\\\\\\\n    36\\\\\\\\t  [in outs initial-state]\\\\\\\\n    37\\\\\\\\t  {:in in,\\\\\\\\n    38\\\\\\\\t   :cursor (oldest-cursor in),\\\\\\\\n    39\\\\\\\\t   :outs outs,\\\\\\\\n    40\\\\\\\\t   :outbox [],\\\\\\\\n    41\\\\\\\\t   :state initial-state,\\\\\\\\n    42\\\\\\\\t   :status nil})\\\\\\\\n    43\\\\\\\\t\\\\\\\\n    44\\\\\\\\t\\\\\\\\n    45\\\\\\\\t(defn- flush-outbox\\\\\\\\n    46\\\\\\\\t  \\\\\\\\\\\\\\\"Append staged values in order; stop at the first that is not appended.\\\\\\\\\\\\\\\"\\\\\\\\n    47\\\\\\\\t  [{:keys [outs], :as stage}]\\\\\\\\n    48\\\\\\\\t  (loop [stage stage]\\\\\\\\n    49\\\\\\\\t    (if-let [[port value] (first (:outbox stage))]\\\\\\\\n    50\\\\\\\\t      (let [handle (get outs port)\\\\\\\\n    51\\\\\\\\t            _ (when-not handle\\\\\\\\n    52\\\\\\\\t                (throw (ex-info \\\\\\\\\\\\\\\"Stage wrote an unwired port\\\\\\\\\\\\\\\" {:port port})))\\\\\\\\n    53\\\\\\\\t            result (stream/append! handle value)\\\\\\\\n    54\\\\\\\\t            outcome (:dao.stream/outcome result)]\\\\\\\\n    55\\\\\\\\t        (case outcome\\\\\\\\n    56\\\\\\\\t          :dao.stream/ok (recur (update stage :outbox (comp vec rest)))\\\\\\\\n    57\\\\\\\\t          :dao.stream/full (assoc stage :status :full)\\\\\\\\n    58\\\\\\\\t          (throw (ex-info \\\\\\\\\\\\\\\"Stage output refused a value\\\\\\\\\\\\\\\"\\\\\\\\n    59\\\\\\\\t                          {:port port, :outcome outcome}))))\\\\\\\\n    60\\\\\\\\t      stage)))\\\\\\\\n    61\\\\\\\\t\\\\\\\\n    62\\\\\\\\t\\\\\\\\n    63\\\\\\\\t(defn step\\\\\\\\n    64\\\\\\\\t  \\\\\\\\\\\\\\\"Advance the stage as far as its streams allow; returns the new stage.\\\\\\\\\\\\\\\"\\\\\\\\n    65\\\\\\\\t  [stage transform]\\\\\\\\n    66\\\\\\\\t  (loop [stage (flush-outbox (assoc stage :status nil))]\\\\\\\\n    67\\\\\\\\t    (cond\\\\\\\\n    68\\\\\\\\t      (= :full (:status stage)) stage\\\\\\\\n    69\\\\\\\\t      (seq (:outbox stage)) stage\\\\\\\\n    70\\\\\\\\t      :else\\\\\\\\n    71\\\\\\\\t      (let [result (stream/next (:in stage) (:cursor stage))\\\\\\\\n    72\\\\\\\\t            outcome (:dao.stream/outcome result)]\\\\\\\\n    73\\\\\\\\t        (case outcome\\\\\\\\n    74\\\\\\\\t          :dao.stream/ok\\\\\\\\n    75\\\\\\\\t          (let [[state' emitted] (transform (:state stage)\\\\\\\\n    76\\\\\\\\t                                            (:dao.stream/value result))]\\\\\\\\n    77\\\\\\\\t            (recur (flush-outbox (assoc stage\\\\\\\\n    78\\\\\\\\t                                        :cursor (:dao.stream/cursor result)\\\\\\\\n    79\\\\\\\\t                                        :state state'\\\\\\\\n    80\\\\\\\\t                                        :outbox (vec emitted)))))\\\\\\\\n    81\\\\\\\\t          :dao.stream/blocked (assoc stage :status :blocked)\\\\\\\\n    82\\\\\\\\t          :dao.stream/end (assoc stage :status :end)\\\\\\\\n    83\\\\\\\\t          (throw (ex-info \\\\\\\\\\\\\\\"Stage input read failed\\\\\\\\\\\\\\\" {:outcome outcome})))))))\\\\\\\\n     1\\\\\\\\t(ns yin.vm.linker.interpreter\\\\\\\\n     2\\\\\\\\t  \\\\\\\\\\\\\\\"The REPL's linker-side composition (yin.vm.linker.md sections 6.1 and 9,\\\\\\\\n     3\\\\\\\\t   M5): the interpreter box of the four-stream topology.\\\\\\\\n     4\\\\\\\\t\\\\\\\\n     5\\\\\\\\t   The shell composes the link pair per VM (`yin.repl/make-session`) and\\\\\\\\n     6\\\\\\\\t   the content pair per content source; this namespace owns the second\\\\\\\\n     7\\\\\\\\t   and answers what the first receives.  One serve round reads every link\\\\\\\\n     8\\\\\\\\t   request the interpreter has not yet seen, resolves each by name\\\\\\\\n     9\\\\\\\\t   through the composition's name environment -- the snapshot the host\\\\\\\\n    10\\\\\\\\t   supplies, an authority fold (`yin.vm.linker.authority/name-environment`)\\\\\\\\n    11\\\\\\\\t   reduced to `name -> manifest address` -- and links the manifest's\\\\\\\\n    12\\\\\\\\t   image over the content pair, appending the response the requesting\\\\\\\\n    13\\\\\\\\t   task correlates on (section 7.2, steps 5 to 6).\\\\\\\\n    14\\\\\\\\t\\\\\\\\n    15\\\\\\\\t   Step 5b is deferred: the obligations travel on the response and the\\\\\\\\n    16\\\\\\\\t   receiving task's engine discharges them against its live state\\\\\\\\n    17\\\\\\\\t   (section 7.2, step 7), so the interpreter passes\\\\\\\\n    18\\\\\\\\t   `:defer-discharge` to `link-manifest` and discharges nothing here.\\\\\\\\n    19\\\\\\\\t\\\\\\\\n    20\\\\\\\\t   Liveness is the composition's (section 6.3, D6): an attempt serves the\\\\\\\\n    21\\\\\\\\t   content pair for at most `attempt-budget` drive rounds and then\\\\\\\\n    22\\\\\\\\t   reports the link `:pending` -- nothing is appended, the request is\\\\\\\\n    23\\\\\\\\t   re-read and re-attempted on a later round, and `abandon` is the\\\\\\\\n    24\\\\\\\\t   shell's.  No clock, no atom, no global: every input is an argument or\\\\\\\\n    25\\\\\\\\t   a composition value, and every outcome is plain data.\\\\\\\\n    26\\\\\\\\t\\\\\\\\n    27\\\\\\\\t   A DHT link source (docs/design/yin.vm.linker.dht.md 4.1) holds no\\\\\\\\n    28\\\\\\\\t   handle: each serve round receives the shell's `dao.space.dht` node\\\\\\\\n    29\\\\\\\\t   and answers the node after it.  A resolved name whose closure is not\\\\\\\\n    30\\\\\\\\t   loaded starts its load (`yin.vm.linker.dht/load-module`) and reports\\\\\\\\n    31\\\\\\\\t   the link `:pending`, naming the manifest it waits on; the node's own\\\\\\\\n    32\\\\\\\\t   step fetches.  A failed load is refused in its section 9 shape and\\\\\\\\n    33\\\\\\\\t   forgotten; a loaded one has its dependency bindings checked, then\\\\\\\\n    34\\\\\\\\t   links over a local runtime on the node's store, asking no peer.\\\\\\\\\\\\\\\"\\\\\\\\n    35\\\\\\\\t  (:require [clojure.string :as str]\\\\\\\\n    36\\\\\\\\t            [dao.jing.content :as content]\\\\\\\\n    37\\\\\\\\t            [dao.space.dht :as dht]\\\\\\\\n    38\\\\\\\\t            [dao.stream :as stream]\\\\\\\\n    39\\\\\\\\t            [dao.stream.ringbuffer :as ring]\\\\\\\\n    40\\\\\\\\t            [yin.vm.linker :as linker]\\\\\\\\n    41\\\\\\\\t            [yin.vm.linker.admission :as admission]\\\\\\\\n    42\\\\\\\\t            [yin.vm.linker.dht :as linker.dht]\\\\\\\\n    43\\\\\\\\t            [yin.vm.linker.sign :as sign]))\\\\\\\\n    44\\\\\\\\t\\\\\\\\n    45\\\\\\\\t\\\\\\\\n    46\\\\\\\\t(def pair-capacity\\\\\\\\n    47\\\\\\\\t  \\\\\\\\\\\\\\\"Declared capacity of each link-pair medium, in elements.  The shell\\\\\\\\n    48\\\\\\\\t   appends one request per require, and a response medium a receiver\\\\\\\\n    49\\\\\\\\t   never drains answers `gap` (an evicted request is never re-read), so\\\\\\\\n    50\\\\\\\\t   the bound is generous and the eviction it guards against is a host\\\\\\\\n    51\\\\\\\\t   assembly defect, not an operating condition.\\\\\\\\\\\\\\\"\\\\\\\\n    52\\\\\\\\t  1024)\\\\\\\\n    53\\\\\\\\t\\\\\\\\n    54\\\\\\\\t\\\\\\\\n    55\\\\\\\\t(def content-capacity\\\\\\\\n    56\\\\\\\\t  \\\\\\\\\\\\\\\"Declared capacity of each content-pair medium, in elements.  One\\\\\\\\n    57\\\\\\\\t   attempt's traffic is a handful of requests; the media persist across\\\\\\\\n    58\\\\\\\\t   attempts and every attempt mints its cursors at their newest end, so\\\\\\\\n    59\\\\\\\\t   an old element is never read again.\\\\\\\\\\\\\\\"\\\\\\\\n    60\\\\\\\\t  1024)\\\\\\\\n    61\\\\\\\\t\\\\\\\\n    62\\\\\\\\t\\\\\\\\n    63\\\\\\\\t(def attempt-budget\\\\\\\\n    64\\\\\\\\t  \\\\\\\\\\\\\\\"Drive rounds one link attempt may spend before it reports `:pending`.\\\\\\\\n    65\\\\\\\\t   A local pair answers within a few rounds per content request, so the\\\\\\\\n    66\\\\\\\\t   budget is reached only by a content source that never answers.\\\\\\\\\\\\\\\"\\\\\\\\n    67\\\\\\\\t  64)\\\\\\\\n    68\\\\\\\\t\\\\\\\\n    69\\\\\\\\t\\\\\\\\n    70\\\\\\\\t(def serve-steps\\\\\\\\n    71\\\\\\\\t  \\\\\\\\\\\\\\\"Server advances one drive round performs at most.  Each answers at\\\\\\\\n    72\\\\\\\\t   least one waiting content request, so a local pair drains in a bound\\\\\\\\n    73\\\\\\\\t   number of rounds.\\\\\\\\\\\\\\\"\\\\\\\\n    74\\\\\\\\t  32)\\\\\\\\n    75\\\\\\\\t\\\\\\\\n    76\\\\\\\\t\\\\\\\\n    77\\\\\\\\t(def serve-budget\\\\\\\\n    78\\\\\\\\t  \\\\\\\\\\\\\\\"Link requests one serve round answers, in request order.  It exceeds\\\\\\\\n    79\\\\\\\\t   what one evaluation's requires can enqueue, so a round that spends it\\\\\\\\n    80\\\\\\\\t   is answering a queue the shell did not write.\\\\\\\\\\\\\\\"\\\\\\\\n    81\\\\\\\\t  64)\\\\\\\\n    82\\\\\\\\t\\\\\\\\n    83\\\\\\\\t\\\\\\\\n    84\\\\\\\\t(def formats\\\\\\\\n    85\\\\\\\\t  \\\\\\\\\\\\\\\"The six format records a serving composition holds (sections 5 and\\\\\\\\n    86\\\\\\\\t   8.1): the four execution formats a requesting kernel names, and the\\\\\\\\n    87\\\\\\\\t   two the manifest flow fetches internally