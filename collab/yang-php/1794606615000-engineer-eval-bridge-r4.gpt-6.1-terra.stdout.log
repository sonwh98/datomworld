{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/zsh -lc \"sed -n '3840,3990p' src/cljc/yang/php/antlr/lower.cljc; rg -n 'module-body|lower-module|%ctx|%scope' src/cljc/yang/php/antlr/publication.cljc | head -60; cat src/cljc/yang/php/antlr/publication.cljc | head -100\"","aggregated_output":"         request-node (or request-node (u/sexp->uast :php/null))\n         ctx (context packet {:path (or path entry-path), :linked? linked?})\n         ;; `run-main`'s second operand arrives composed by the harness from\n         ;; the attached request stream: production initialization consumes\n         ;; the record from the stream at runtime and seeds the superglobals,\n         ;; no postwalk rewrite and no request data through lowering involved.\n         ;; With stream nodes `run-main` takes four operands (request,\n         ;; response and diagnostics references); without them it takes two\n         ;; and the cells accumulate.\n         main (if (or response-node diag-node)\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\n                      (or response-node (u/sexp->uast :php/null))\n                      (or diag-node (u/sexp->uast :php/null)))\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))]\n     {:ast (u/mark-tails\n             (if linked?\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\n                                     (app* 'require (u/lit prelude/module-name))\n                                     (app* 'php/init!)]\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\n                                    (when class-map\n                                      [(app* 'require (u/lit classmap-module))\n                                       (app* 'php/bind-class-map!\n                                             (u/v (symbol (str classmap-module) \"classes\"))\n                                             (u/v (symbol (str classmap-module) \"paths\")))])\n                                    [main]))\n               (u/then prelude/uast main))),\n      :warnings @(:warnings ctx)})))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n;; =============================================================================\n\n(def module-exports\n  \"The exports of a compiled PHP unit: its spec and body, immutable after\n   install.\"\n  '#{spec body})\n\n\n(defn imported-unit-names\n  \"The normalized paths the unit statically includes through folded literal\n   paths, source order, distinct, the unit's own path aside. A computed path\n   contributes nothing: it is by name at run time (plan P6 R3). A path that\n   cannot normalize is refused as `lower-include` refuses it.\"\n  [packet {:keys [path], :or {path entry-path}}]\n  (let [ctx (context packet {:path path, :linked? true})]\n    (letfn [(edges\n              [n]\n              (let [ks (core/kids ctx n)\n                    k0 (first ks)]\n                (concat\n                  (when (and (p/rule? n \"expression\")\n                             (= 2 (count ks))\n                             (p/token? k0)\n                             (contains? include-kinds (:type k0)))\n                    (when-let [folded (fold-path ctx (second ks))]\n                      (let [{p :path, error :error} (normalize-unit-path folded)]\n                        (when error (unsupported! n error))\n                        [p])))\n                  (mapcat edges (filter p/rule? ks)))))]\n      (into [] (comp (distinct) (remove #(= % path))) (edges (p/root (:pk ctx)))))))\n\n\n(defn module-packet\n  \"One ok packet as the linker module `phpm.<mangled-path>`: one wide\n   application whose operands are `(require 'php)`, then the spec and body\n   definitions. The body is `(fn [%scope %ctx] <unit>)`: the including\n   scope arrives as arguments (P6 S3 gives them meaning; S2 includes only\n   at an entry unit's top level, whose variables are the globals).\"\n  [packet {:keys [path strict-types]}]\n  (let [ctx (assoc (context packet {:path path, :linked? true}) :module? true)\n        defs [(u/def! 'spec (u/lit {:path path, :strict-types (if strict-types 1 0)}))\n              (u/def! 'body (u/lam ['%scope '%ctx] (unit-node ctx true)))]\n        operands (into [(core-module/require-node prelude/module-name)] defs)\n        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the unit at `path` over\n   the host registry `registry`, requiring `php` at `php-address` and each\n   included unit at its address in `deps` ({path address}). A free name no\n   requirement or profile supplies is refused before anything is published.\n   This namespace emits; it never publishes.\"\n  [registry packet {:keys [path strict-types php-address deps]}]\n  (core-module/module-spec\n    :yang.php/refusal :yang.php/undeclared-free registry\n    {:name (path-module-symbol path),\n     :ast (module-packet packet {:path path, :strict-types strict-types}),\n     :exports module-exports,\n     :runtime-name prelude/module-name,\n     :runtime-address php-address,\n     :deps (into {} (map (fn [[p a]] [(path-module-symbol p) a])) deps)}))\n\n\n;; =============================================================================\n;; The autoload class map (plan P6 R9)\n;; =============================================================================\n\n(def classmap-exports\n  \"The exports of the class map module: the lower-cased class name to path\n   map, and the path to delivery-thunk map the computed include resolves\n   through.\"\n  '#{classes paths})\n\n\n(defn classmap-paths\n  \"The literal paths a class map `{:classes {class path} :paths [path ...]}`\n   publishes thunks for: `:paths`, else the class map's values, and always the\n   class map's values. Normalized, sorted, distinct.\"\n  [{:keys [classes paths]}]\n  (vec (sort (distinct (map #(let [r (normalize-unit-path %)]\n                               (when (:error r) (throw (ex-info \"unmappable class map path\"\n                                                                {:yang.php/diagnostic :yang.php/unsupported,\n                                                                 :construct (:error r), :path %})))\n                               (:path r))\n                            (concat (vals classes) paths))))))\n\n\n(defn classmap-packet\n  \"The class map as one linker module (the unit module shape): `classes`\n   maps each lower-cased class name to its normalized path, `paths` each\n   listed path to its delivery thunk.\"\n  [{:keys [classes] :as cm}]\n  (let [paths (classmap-paths cm)\n        norm (fn [p] (:path (normalize-unit-path p)))\n        defs [(u/def! 'classes\n                      (u/lit (into {} (map (fn [[c p]] [(str/lower-case c) (norm p)])) classes)))\n              (u/def! 'paths\n                      (reduce (fn [m p] (app* 'assoc m (u/lit p) (delivery-thunk p)))\n                              (u/lit {})\n                              paths))]\n        operands (into [(core-module/require-node prelude/module-name)] defs)\n        params (mapv (fn [i] (symbol (str \"%d\" i))) (range (count operands)))]\n    (u/mark-tails (apply u/app (u/lam params (u/lit nil)) operands))))\n\n\n(defn classmap-spec\n  \"`publish-module!`'s spec for the class map `cm` over the host registry\n   `registry`, `php` at `php-address` and each listed path's module at its\n   address in `deps` ({path address}).\"\n  [registry cm php-address deps]\n  (core-module/module-spec\n    :yang.php/refusal :yang.php/undeclared-free registry\n(ns yang.php.antlr.publication\n  \"P6 (docs/design/yang.php.md section 11): a set of compiled PHP units\n   published as linker modules. The ordering, SCC bundling and publish loop\n   are `yang.core.publication`'s; this namespace supplies the PHP hooks: the\n   includes `lower/imported-unit-names` folds, the `lower/module-spec` and\n   `lower/scc-module-specs` emitters and site sets; no binder table.\n\n   A unit is `{:name path :packet p :strict-types b}`, `path` its normalized\n   relative path; the optional class map entry is `{:name \\\"$classmap\\\"\n   :classes {class path} :paths [path ...]}`. Name assertions stay the\n   linker's: this namespace publishes content, it signs nothing.\"\n  (:require\n    [yang.core.publication :as core]\n    [yang.php.antlr.lower :as lower]\n    [yang.php.antlr.siteset :as siteset]\n    [yin.vm.linker.publish :as publish]))\n\n\n(defn- class-map?\n  \"The autoload class map entry of a unit set, `{:name \\\"$classmap\\\" :classes\n   {class path} :paths [path ...]}`: it imports every path it lists, so it\n   publishes last and an unpublished path is refused by name (plan P6 R9).\"\n  [unit]\n  (= lower/classmap-name (:name unit)))\n\n\n(defn- config\n  [publish-fn]\n  {:imported-names (fn [{:keys [name packet], :as unit}]\n                     (if (class-map? unit)\n                       (lower/classmap-paths unit)\n                       (lower/imported-unit-names packet {:path name}))),\n   :module-spec (fn [registry {:keys [name packet strict-types], :as unit} php-address deps]\n                  (if (class-map? unit)\n                    (lower/classmap-spec registry unit php-address deps)\n                    (lower/module-spec registry packet\n                                       {:path name,\n                                        :strict-types strict-types,\n                                        :php-address php-address,\n                                        :deps deps}))),\n   :scc-module-specs lower/scc-module-specs,\n   :site-set siteset/publish!,\n   :alias-site-set true,\n   :binder-table nil,\n   :refusal-ns \"yang.php\",\n   :publish-fn publish-fn})\n\n\n(defn publication-order\n  \"Dependency-first names, retaining the input order for acyclic units.\n   Cyclic components appear as sorted member vectors in :order, one\n   publication step per SCC. An include edge no unit and no `published`\n   entry supplies is refused `:yang.php/unpublished-import` by name.\"\n  [units published]\n  (core/publication-order (config publish/publish-module!) units published))\n\n\n(defn publish-units!\n  \"Publish `units` into the content store `handle` over the host registry\n   `registry`, `php` pinned at `php-address` and each include outside the\n   set at its address in `published` ({path address}), in\n   `publication-order`. Answers `{:status :ok :addresses {path address}\n   :bundles {bundle-symbol address}}`, or the first refusal:\n   `publication-order`'s before anything is written, else\n   `publish-module!`'s with a string `:unit`.\"\n  ([handle registry php-address units]\n   (publish-units! handle registry php-address units {}))\n  ([handle registry php-address units published]\n   (publish-units! handle registry php-address units published publish/publish-module!))\n  ([handle registry php-address units published publish-fn]\n   (core/publish-units! (config publish-fn) handle registry php-address units published)))\n","exit_code":0,"status":"completed"}}
