t                  lc (str/lower-case written)]\\\\n  3670\\\\t              (when (or (contains? seen lc) (contains? prelude/builtin-names lc))\\\\n  3671\\\\t                (compile-error! f (str \\\\\\\"Cannot redeclare \\\\\\\" written \\\\\\\"()\\\\\\\")))\\\\n  3672\\\\t              (conj seen lc)))\\\\n  3673\\\\t          #{}\\\\n  3674\\\\t          hoisted))\\\\n  3675\\\\t\\\\n  3676\\\\t\\\\n  3677\\\\t(defn- class-item?\\\\n  3678\\\\t  [ctx item]\\\\n  3679\\\\t  (contains? #{\\\\\\\"classDeclaration\\\\\\\" \\\\\\\"enumDeclaration\\\\\\\"} (:rule (rule-head ctx item))))\\\\n  3680\\\\t\\\\n  3681\\\\t\\\\n  3682\\\\t(defn- unit-body\\\\n  3683\\\\t  \\\\\\\"The unit's statements as one node, hoisted function declarations first,\\\\n  3684\\\\t   then the classes that can be declared at that point (PHP hoists a class\\\\n  3685\\\\t   whose parent, interfaces and traits already exist); a hoisted class is\\\\n  3686\\\\t   skipped when execution reaches it.\\\\\\\"\\\\n  3687\\\\t  [ctx]\\\\n  3688\\\\t  (let [items (:items ctx)\\\\n  3689\\\\t        hoisted (filterv #(hoisted? ctx %) items)\\\\n  3690\\\\t        classes (mapv (fn [item]\\\\n  3691\\\\t                        (let [c (rule-head ctx item)\\\\n  3692\\\\t                              [_ spec] (class-spec (item-ctx ctx item) c)]\\\\n  3693\\\\t                          [(:id item) (symbol (str \\\\\\\"%class-\\\\\\\" (:id c))) spec]))\\\\n  3694\\\\t                      (filter #(class-item? ctx %) items))\\\\n  3695\\\\t        syms (into {} (map (fn [[id sym _]] [id sym])) classes)\\\\n  3696\\\\t        in-place (fn [item]\\\\n  3697\\\\t                   (if-let [sym (get syms (:id item))]\\\\n  3698\\\\t                     (app* 'php/declare-late! (u/v sym))\\\\n  3699\\\\t                     (lower (item-ctx ctx item) item)))]\\\\n  3700\\\\t    (check-hoisted! ctx hoisted)\\\\n  3701\\\\t    (let [body (sequence-node\\\\n  3702\\\\t                 (concat (mapv #(lower (ite