736\\\\t\\\\n  3737\\\\t(defn lower-module-body\\\\n  3738\\\\t  \\\\\\\"The unit's statements as one node, before the runtime wrapper: what\\\\n  3739\\\\t   lowering goldens compare. Hoisted function declarations come first.\\\\\\\"\\\\n  3740\\\\t  [packet]\\\\n  3741\\\\t  (unit-body (context packet)))\\\\n  3742\\\\t\\\\n  3743\\\\t\\\\n  3744\\\\t(def option-keys\\\\n  3745\\\\t  \\\\\\\"The options `lower-program` and the lowering stage accept.\\\\\\\"\\\\n  3746\\\\t  [:prelude :path :paths :class-map])\\\\n  3747\\\\t\\\\n  3748\\\\t\\\\n  3749\\\\t(defn- path-map-node\\\\n  3750\\\\t  \\\\\\\"`(php/bind-path-map! {path thunk ...})` for the composition's published\\\\n  3751\\\\t   paths (plan P6 R3): the computed include's lookup table.\\\\\\\"\\\\n  3752\\\\t  [paths]\\\\n  3753\\\\t  (app* 'php/bind-path-map!\\\\n  3754\\\\t        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\\\\n  3755\\\\t                (u/lit {})\\\\n  3756\\\\t                (sort paths))))\\\\n  3757\\\\t\\\\n  3758\\\\t\\\\n  3759\\\\t(defn lower-program\\\\n  3760\\\\t  \\\\\\\"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\\\\n  3761\\\\t   `php/run-main` after the prelude, tail calls marked. Its value is\\\\n  3762\\\\t   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\\\\n  3763\\\\t   `:warnings` are the lowering's warning-severity diagnostics\\\\n  3764\\\\t   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\\\\n  3765\\\\t   `:yang.php/computed-include-path`).\\\\n  3766\\\\t\\\\n  3767\\\\t   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\\\\n  3768\\\\t   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\\\\n  3769\\\\t   need); `:path` the entry unit's declared path (default `entry-path`);\\\\n  3770\\\\t   `:paths` the normalized paths whose units the composition published,\\\\n  3771\\\\t   which a computed include res