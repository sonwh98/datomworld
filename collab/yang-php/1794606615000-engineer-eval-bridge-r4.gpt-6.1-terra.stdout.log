==============================\\\\n  1128\\\\t;; Link waits and the install child (yin.vm.linker.md sections 7.2 to 7.4)\\\\n  1129\\\\t;; =============================================================================\\\\n  1130\\\\t\\\\n  1131\\\\t(def ^:private link-reasons\\\\n  1132\\\\t  \\\\\\\"The wait reasons `require` adds: the two link states and the install.\\\\\\\"\\\\n  1133\\\\t  #{:link-request :link-response :install})\\\\n  1134\\\\t\\\\n  1135\\\\t\\\\n  1136\\\\t(defn- link-entry?\\\\n  1137\\\\t  [entry]\\\\n  1138\\\\t  (contains? link-reasons (:reason entry)))\\\\n  1139\\\\t\\\\n  1140\\\\t\\\\n  1141\\\\t(defn- observe-entry?\\\\n  1142\\\\t  \\\\\\\"True for a held observation (`:reason :observe`): a machine-only entry\\\\n  1143\\\\t   the driver applies through `apply-observation`; the sweep never polls it.\\\\\\\"\\\\n  1144\\\\t  [entry]\\\\n  1145\\\\t  (= :observe (:reason entry)))\\\\n  1146\\\\t\\\\n  1147\\\\t\\\\n  1148\\\\t(defn- ready\\\\n  1149\\\\t  \\\\\\\"A woken ready entry: the registers, resumed with `value`.\\\\\\\"\\\\n  1150\\\\t  [entry value]\\\\n  1151\\\\t  (-> entry\\\\n  1152\\\\t      (dissoc :envelope :request :response :cursor)\\\\n  1153\\\\t      (assoc :value value)))\\\\n  1154\\\\t\\\\n  1155\\\\t\\\\n  1156\\\\t(defn- refused-entry\\\\n  1157\\\\t  \\\\\\\"Resume a try waiter with outcome data; plain require raises at resume.\\\\\\\"\\\\n  1158\\\\t  [entry refusal]\\\\n  1159\\\\t  (if (:try? entry)\\\\n  1160\\\\t    (ready entry (cond-> refusal\\\\n  1161\\\\t                   (= :refused (:status refusal))\\\\n  1162\\\\t                   (assoc :module (or (:module refusal) (:name entry)))\\\\n  1163\\\\t                   (= :lost (:status refusal))\\\\n  1164\\\\t                   (assoc :link-id (or (:link-id refusal) (:link-id entry)))))\\\\n  1165\\\\t    (assoc (ready entry nil) :status :link-refused :refusal refusal)))\\\\n  1166\\\\t\\\\n  1167\\\\t\\\\n  1168\\\\t(defn- linked-entry\\\\n  