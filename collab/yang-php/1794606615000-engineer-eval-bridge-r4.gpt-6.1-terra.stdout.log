ves\\\\\\\\n784:                  :stream/make (do\\\\\\\\n785:                                 (emit! e :yin/type :stream/make)\\\\\\\\n787:                  :stream/put (do (emit! e :yin/type :stream/put)\\\\\\\\n792:                  :stream/cursor (do (emit! e :yin/type :stream/cursor)\\\\\\\\n795:                  :stream/next (do (emit! e :yin/type :stream/next)\\\\\\\\n798:                  :stream/close (do (emit! e :yin/type :stream/close)\\\\\\\\n801:                  ;; Continuation primitives\\\\\\\\n851:                      ;; §2.4 saturation, applied by the loader: the codec\\\\\\\\n854:                      ;; and this loader and the row loader (§7.2 part 2)\\\\\\\\n860:       :dao.stream.apply/call (let [op (get-attr root-id :yin/op)\\\\\\\\n878:       :stream/make (assoc base :buffer (get-attr root-id :yin/buffer))\\\\\\\\n879:       :stream/put (let [target-eid (get-attr root-id :yin/target)\\\\\\\\n884:       :stream/cursor (assoc base\\\\\\\\n886:       :stream/next (assoc base\\\\\\\\n888:       :stream/close (assoc base\\\\\\\\n919:  \\\\\\\\\\\\\\\"`plain-data?` for a value inside a machine payload: a closure or a\\\\\\\\n920:   continuation, a host type only a kernel mints, counts as its payload,\\\\\\\\n926:        (machine-data? (values/payload x))\\\\\\\\n973:(defn loaded-code-floor\\\\\\\\n975:   code map — each segment id minus its length — or 0 when none is loaded.\\\\\\\\n976:   A loader minting a fresh local segment id allocates below this floor\\\\\\\\n977:   (`semantic/load-ast` for projected AST batches, `semantic/load-vector`\\\\\\\\n978:   for canonical instruction vectors), so successive loads never collide\\\\\\\\n1007:   :dao.stream.apply/call [[:op :kw] [:operands :nodes]],\\\\\\\\n1014:   :stream/make [[:buffer :int]],\\\\\\\\n1015:   :stream/put [[:target :node] [:val :node]],\\\\\\\\n1016:   :stream/cursor [[:source :node]],\\\\\\\\n1017:   :stream/next [[:source :node]],\\\\\\\\n1018:   :stream/close [[:source :node]]})\