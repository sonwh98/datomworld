\\t                                  (if (= \\\\\\\\\\\\\\\"VarName\\\\\\\\\\\\\\\" (:type v))\\\\\\\\n   177\\\\\\\\t                                    (note-name sc :globals (:text v))\\\\\\\\n   178\\\\\\\\t                                    sc)\\\\\\\\n   179\\\\\\\\t                                  sc))\\\\\\\\n   180\\\\\\\\t                              scope\\\\\\\\n   181\\\\\\\\t                              (mapcat #(p/children pk %)\\\\\\\\n   182\\\\\\\\t                                      (p/child-rules pk k \\\\\\\\\\\\\\\"globalVar\\\\\\\\\\\\\\\")))\\\\\\\\n   183\\\\\\\\t                      \\\\\\\\\\\\\\\"expression\\\\\\\\\\\\\\\"\\\\\\\\n   184\\\\\\\\t                      (cond-> (reduce #(note-name %1 :assigned %2)\\\\\\\\n   185\\\\\\\\t                                      scope\\\\\\\\n   186\\\\\\\\t                                      (assign-targets pk k))\\\\\\\\n   187\\\\\\\\t                        (include-expr? pk k) (assoc :includes? true))\\\\\\\\n   188\\\\\\\\t                      \\\\\\\\\\\\\\\"foreachStatement\\\\\\\\\\\\\\\"\\\\\\\\n   189\\\\\\\\t                      (reduce #(note-name %1 :assigned %2)\\\\\\\\n   190\\\\\\\\t                              scope\\\\\\\\n   191\\\\\\\\t                              (foreach-targets pk k))\\\\\\\\n   192\\\\\\\\t                      scope)\\\\\\\\n   193\\\\\\\\t              scope (if (or (and (p/rule? k \\\\\\\\\\\\\\\"keyedVariable\\\\\\\\\\\\\\\")\\\\\\\\n   194\\\\\\\\t                                 (some #(p/token? % \\\\\\\\\\\\\\\"$\\\\\\\\\\\\\\\") (p/children pk k)))\\\\\\\\n   195\\\\\\\\t                            (and (p/rule? k \\\\\\\\\\\\\\\"functionCallName\\\\\\\\\\\\\\\") (dynamic-call? pk k)))\\\\\\\\n   196\\\\\\\\t                      (assoc scope :dynamic? true)\\\\\\\\n   197\\\\\\\\t                      scope)\\\\\\\\n   198\\\\\\\\t              scope (if (some #(p/token? % \\\\\\\\\\\\\\\"$this\\\\\\\\\\\\\\\") (p/children pk k))\\\