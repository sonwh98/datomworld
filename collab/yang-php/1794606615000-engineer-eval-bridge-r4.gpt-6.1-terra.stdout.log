{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc 'cat test/yang/php/antlr/scope_test.clj | tail -100'","aggregated_output":"(ns yang.php.antlr.scope-test\n  \"P1: PHP scope analysis (section 7.3). Sources parse on the JVM.\"\n  (:require\n    [clojure.test :refer [deftest is]]\n    [yang.antlr.packet :as packet]\n    [yang.php.antlr.cst :as cst]\n    [yang.php.antlr.scope :as scope]))\n\n\n(defn- analysis\n  [src]\n  (scope/analyze (packet/validate! (cst/parse-source src))))\n\n\n(defn- function-scope\n  [src]\n  (first (vals (:scopes (analysis src)))))\n\n\n(deftest unit-scope-test\n  (let [a (analysis \"<?php $x = 1; $y = 2; $x = 3; echo $x;\")]\n    (is (= :unit (get-in a [:unit :kind])))\n    (is (= [\"$x\" \"$y\"] (get-in a [:unit :assigned])))\n    (is (= {} (:scopes a)))))\n\n\n(deftest function-scope-test\n  (let [s (function-scope \"<?php function f($a, $b) { static $n = 0; global $g; $c = 1; return $this; }\")]\n    (is (= :function (:kind s)))\n    (is (= [\"$a\" \"$b\"] (:params s)))\n    (is (= [\"$n\"] (:statics s)))\n    (is (= [\"$g\"] (:globals s)))\n    (is (= [\"$a\" \"$b\" \"$n\" \"$c\"] (:assigned s)))\n    (is (true? (:this? s)))\n    (is (false? (:dynamic? s)))))\n\n\n(deftest nested-function-does-not-leak-test\n  (let [a (analysis \"<?php $x = 1; function f() { $y = 2; } $z = 3;\")]\n    (is (= [\"$x\" \"$z\"] (get-in a [:unit :assigned])))\n    (is (= [\"$y\"] (:assigned (first (vals (:scopes a))))))))\n\n\n(deftest dynamic-variable-test\n  (is (true? (:dynamic? (function-scope \"<?php function f() { $$a = 1; }\")))))\n\n\n(deftest function-vars-test\n  (let [s (function-scope \"<?php function f($a) { static $n = 0; $b = $a; echo $c; unset($d); }\")]\n    (is (= [\"$a\" \"$n\" \"$b\" \"$c\" \"$d\"] (:vars s)))))\n\n\n(deftest keyed-assignment-assigns-its-base-test\n  (is (= [\"$a\" \"$b\" \"$c\"]\n         (get-in (analysis \"<?php $a['x'][0] = 1; $b[] = 2; $c{1} .= 3; echo $d[0];\")\n                 [:unit :assigned]))))\n\n\n(deftest foreach-targets-are-assigned-test\n  (is (= [\"$k\" \"$v\"]\n         (get-in (analysis \"<?php foreach ($s as $k => $v) { echo $k; }\") [:unit :assigned])))\n  (is (= [\"$o\" \"$p\"]\n         (get-in (analysis \"<?php foreach ($s as $o['x'] => $p[0]) {}\") [:unit :assigned])))\n  (is (= [\"$s\" \"$v\"]\n         (:assigned (function-scope \"<?php function f($s) { foreach ($s as $v) {} }\")))))\n\n\n(deftest array-spread-is-a-read-test\n  (let [a (analysis \"<?php $a = [1]; $b = [...$a, ...$c];\")]\n    (is (= [\"$a\" \"$b\"] (get-in a [:unit :assigned])))))\n\n\n(deftest closure-use-folds-into-the-enclosing-scope-test\n  (let [a (analysis \"<?php function f() { $g = function ($p) use ($x, &$y) { return $x; }; }\")\n        scopes (vals (:scopes a))\n        outer (first (filter #(= [] (:params %)) scopes))\n        closure (first (filter #(= [\"$p\"] (:params %)) scopes))]\n    (is (= 2 (count scopes)) \"the declaration and the closure each open a scope\")\n    (is (some #{\"$x\"} (:vars closure)))\n    (is (every? (set (:vars outer)) [\"$x\" \"$y\"]))\n    (is (some #{\"$y\"} (:assigned outer)))))\n\n\n(deftest arrow-captures-fold-transitively-test\n  (let [a (analysis \"<?php function f() { $h = fn($x) => fn($y) => $x + $y + $z; }\")\n        outer (first (filter #(= [] (:params %)) (vals (:scopes a))))]\n    (is (= 3 (count (:scopes a))))\n    (is (some #{\"$z\"} (:vars outer)) \"the free variable of the nested arrow reaches the function\")\n    (is (not-any? #{\"$x\" \"$y\"} (:vars outer)) \"its own parameters do not escape\")))\n","exit_code":0,"status":"completed"}}
