{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2260,2355p;3520,3635p;3720,3850p' src/cljc/yang/php/antlr/lower.cljc && cat src/cljc/yang/php/antlr/safepoint.cljc && sed -n '1,180p' src/dev/yang/php/oracle.clj\"","aggregated_output":"  (mapv (fn [e] (app* 'php/echo (app* 'php/to-string (lower ctx e))))\n        (core/rules ctx expression-list \"expression\")))\n\n\n(defn- html-node\n  \"`(php/echo bytes)` of an `inlineHtml` rule: the `:text` of every token\n   under it, in preorder (markup tokens included).\"\n  [ctx n]\n  (letfn [(texts\n            [x]\n            (mapcat (fn [k] (if (p/rule? k) (texts k) [(:text k)]))\n                    (core/kids ctx x)))]\n    (app* 'php/echo (u/lit (byte-string (apply str (texts n)))))))\n\n\n(defn- contains-token?\n  \"True when a token of type `t` occurs below `n`.\"\n  [ctx n t]\n  (boolean\n    (some (fn [k] (if (p/rule? k) (contains-token? ctx k t) (= t (:type k))))\n          (core/kids ctx n))))\n\n\n(defn- with-temps\n  \"`node` followed by the release of the temporaries it registered, when the\n   statement `n` holds a call that can leave one (row 37).\"\n  [ctx n node]\n  (if (or (some #(core/contains-rule? ctx n % #{}) [\"functionCall\" \"newExpr\" \"memberAccess\"])\n          (contains-token? ctx n \"Clone\"))\n    (let [mark (core/gen \"tm\" n)]\n      (u/let1 mark (app* 'php/tmp-mark) (u/then node (app* 'php/release-tmps (u/v mark)))))\n    node))\n\n\n(defn- block-nodes\n  [ctx n]\n  (mapv #(lower ctx %) (core/rule-kids ctx n)))\n\n\n(defn- sequence-node\n  [nodes]\n  (if (seq nodes) (u/seq-nodes nodes) (u/lit :php/null)))\n\n\n;; -----------------------------------------------------------------------------\n;; Loops and escapes\n;; -----------------------------------------------------------------------------\n\n(defn- loop-frame\n  \"A level of the `:loops` stack. `:used` collects the escapes the body\n   takes (`:brk`, `:cont`), so only those are bound.\"\n  [n switch?]\n  {:brk (core/gen \"brk\" n),\n   :cont (core/gen \"cont\" n),\n   :used (atom #{}),\n   :switch? switch?})\n\n\n(defn- push-frame\n  [ctx frame]\n  (update ctx :loops conj frame))\n\n\n(defn- wrap-escape\n  \"`node` under a `php/call-ec` that binds the frame's `kind` escape, when the\n   body used it.\"\n  [frame kind node]\n  (if (contains? @(:used frame) kind)\n    (app* 'php/call-ec (u/lam [(get frame kind)] node))\n    node))\n\n\n(defn- digits-value\n  [digits]\n  (reduce (fn [acc ch] (+ (* acc 10) (str/index-of \"0123456789\" (str ch)))) 0 digits))\n\n\n(defn- decimal-literal\n  \"The value of expression `e` when it is one decimal integer literal.\"\n  [ctx e]\n  (loop [x e\n         names [\"expression\" \"constant\" \"literalConstant\" \"numericConstant\"]]\n    (cond\n      (not (p/rule? x (first names))) nil\n      (= 1 (count names)) (let [t (first (core/kids ctx x))]\n                            (when (and (p/token? t) (= \"Decimal\" (:type t)))\n                              (digits-value (str/replace (:text t) \"_\" \"\"))))\n      :else (let [ks (core/kids ctx x)]\n              (when (= 1 (count ks)) (recur (first ks) (rest names)))))))\n\n\n(defn- lower-escape\n  \"`break n` / `continue n`: the escape of the n-th enclosing level. A level\n   count that is not a positive literal, or that is deeper than the loops\n   around the statement, is a compile error.\"\n  [ctx n kind]\n                          (class-text ctx)))\n        interfaces (cond\n                     interface? (type-names ctx (first (core/rules ctx n \"interfaceList\")))\n                     :else (type-names ctx (first (core/rules ctx n \"interfaceList\"))))\n        statements (core/rules ctx n \"classStatement\")\n        _ (doseq [st statements]\n            (when (seq (core/rules ctx st \"attributes\")) (unsupported! st :attribute)))\n        tok (fn [st] (some #(when (p/token? %) (:type %)) (core/kids ctx st)))\n        consts (mapcat #(const-entries ctx cname %) (filter #(= \"Const\" (tok %)) statements))\n        props (mapcat (fn [st]\n                        (cond\n                          (seq (core/rules ctx st \"propertyModifiers\")) (property-entries ctx cname st)\n                          (and (= \"Function_\" (tok st))\n                               (= \"__construct\" (str/lower-case (function-written ctx st))))\n                          (promoted-entries ctx st)\n                          :else []))\n                      statements)\n        methods (mapv #(method-entry ctx % %) (filter #(= \"Function_\" (tok %)) statements))\n        uses (filter #(= \"Use\" (tok %)) statements)\n        [traits rules] (trait-rules ctx uses)]\n    [cname\n     (spec-node (cond-> {:name (u/lit cname),\n                         :kind (u/lit kind),\n                         :abstract? (u/lit (boolean (:abstract mods))),\n                         :final? (u/lit (boolean (:final mods))),\n                         :interfaces (args-vector (map u/lit interfaces)),\n                         :traits (args-vector (map u/lit traits)),\n                         :trait-rules rules,\n                         :consts (args-vector consts),\n                         :props (args-vector props),\n                         :methods (args-vector methods)}\n                  parent (assoc :parent (u/lit parent))))]))\n\n\n(defn- lower-declare\n  \"`declare(strict_types=1)` switches the unit to strict scalar typing; `ticks`\n   and `encoding` are accepted and inert. A body statement runs after.\"\n  [ctx n]\n  (let [ds (mapcat #(core/rules ctx % \"directive\") (core/rules ctx n \"declareList\"))\n        strict (some (fn [d]\n                       (when (some #(and (p/token? %) (= \"StrictTypes\" (:type %))) (core/kids ctx d))\n                         (= \"1\" (leftmost-token-text ctx (first (core/rules ctx d \"numericConstant\"))))))\n                     ds)\n        body (first (core/rules ctx n \"statement\"))]\n    (u/then (if (some? strict) (app* 'php/set-strict! (u/lit (boolean strict))) (u/lit :php/null))\n            (if body (lower ctx body) (u/lit :php/null)))))\n\n\n(defn- lower-class\n  \"A class declared in place (nested or conditional): declared when reached.\"\n  [ctx n]\n  (let [[_ spec] (class-spec ctx n)]\n    (u/then (app* 'php/declare-class! spec) (u/lit :php/null))))\n\n\n(defn- lower\n  \"The node of CST rule node `n`.\"\n  [ctx n]\n  (case (:rule n)\n    \"inlineHtml\" (html-node ctx n)\n    \"phpBlock\" (sequence-node (block-nodes ctx n))\n    (\"topStatement\" \"innerStatement\" \"statement\" \"namespaceStatement\")\n    (lower ctx (first (core/rule-kids ctx n)))\n    \"globalConstantDeclaration\" (lower-const ctx n)\n    \"echoStatement\" (with-temps ctx n\n                      (sequence-node (echo-nodes ctx (first (core/rules ctx n \"expressionList\")))))\n    \"expressionStatement\" (with-temps ctx n (lower ctx (first (core/rules ctx n \"expression\"))))\n    \"emptyStatement_\" (u/lit :php/null)\n    \"inlineHtmlStatement\" (sequence-node (block-nodes ctx n))\n    \"blockStatement\" (lower ctx (first (core/rules ctx n \"innerStatementList\")))\n    \"innerStatementList\" (sequence-node (block-nodes ctx n))\n    \"expression\" (lower-expression ctx n)\n    \"yieldExpression\" (lower-yield ctx n)\n    \"parentheses\" (lower ctx (first (core/rule-kids ctx n)))\n    \"ifStatement\" (lower-if ctx n)\n    \"whileStatement\" (lower-while ctx n)\n    \"doWhileStatement\" (lower-do-while ctx n)\n    \"forStatement\" (lower-for ctx n)\n    \"foreachStatement\" (lower-foreach ctx n)\n    \"switchStatement\" (lower-switch ctx n)\n    \"breakStatement\" (lower-escape ctx n :break)\n    \"continueStatement\" (lower-escape ctx n :continue)\n    \"returnStatement\" (lower-return ctx n)\n    \"tryCatchFinally\" (lower-try ctx n)\n    \"throwStatement\" (app* 'php/throw-value (lower ctx (first (core/rules ctx n \"expression\"))))\n    \"staticVariableStatement\" (lower-static ctx n)\n    \"globalStatement\" (lower-global ctx n)\n    \"unsetStatement\" (lower-unset ctx n (core/rules ctx (first (core/rules ctx n \"chainList\")) \"chain\"))\n    \"functionDeclaration\" (lower-function ctx n)\n    \"constant\" (lower-constant ctx n)\n    \"arrayCreation\" (lower-array ctx n)\n    (\"classDeclaration\" \"enumDeclaration\") (lower-class ctx n)\n    \"declareStatement\" (lower-declare ctx n)\n    (core/default-arm diagnostic-ns \"PHP\" unsupported-rules n)))\n\n\n;; =============================================================================\n;; Packets\n;; =============================================================================\n\n(defn- hoisted?\n  \"True for a top-level statement that is an unconditional function\n   declaration: PHP declares it before the unit's first statement runs.\"\n  [ctx item]\n  (p/rule? (rule-head ctx item) \"functionDeclaration\"))\n\n\n(defn- declared-functions\n  \"Every function the unit declares: lower-cased fully qualified name to the\n   vector of its by-reference parameter positions.\"\n  [ctx]\n  (letfn [(refs\n            [n]\n            (let [fps (core/rules ctx (first (core/rules ctx n \"formalParameterList\"))\n                                  \"formalParameter\")]\n              (vec (keep-indexed (fn [i fp] (when (some #(p/token? % \"&\") (core/kids ctx fp)) i))\n                       \"returnStatement\"\n                       #{\"functionDeclaration\" \"lambdaFunctionExpr\" \"classDeclaration\"\n                         \"enumDeclaration\"}))\n\n\n(defn- unit-node\n  \"`unit-body`, inside the `return` escape when the unit has a top-level\n   `return`: the escape answers its value, the sentinel `:php/no-return`\n   when the body falls off its end (plan P6 R4). An included unit's body\n   (`module?`) always answers the sentinel at its end; the entry unit's\n   value is dropped, so its tree is unchanged when it has no `return`.\"\n  ([ctx] (unit-node ctx false))\n  ([ctx module?]\n   (cond\n     (unit-returns? ctx)\n     (app* 'php/call-ec\n           (u/lam ['%ret] (u/then (unit-body (assoc ctx :ret '%ret)) (u/lit :php/no-return))))\n     module? (u/then (unit-body ctx) (u/lit :php/no-return))\n     :else (unit-body ctx))))\n\n\n(defn lower-module-body\n  \"The unit's statements as one node, before the runtime wrapper: what\n   lowering goldens compare. Hoisted function declarations come first.\"\n  [packet]\n  (unit-body (context packet)))\n\n\n(def option-keys\n  \"The options `lower-program` and the lowering stage accept. Request data\n   never flows here: the harness attaches the composition-supplied request\n   stream and composes its sealed reference as `run-main`'s second operand\n   (`:request-node`, an opaque UAST node) at the composition level — the\n   record itself reaches the runtime only when `run-main` consumes it.\"\n  [:prelude :path :paths :class-map :request-node :response-node :diag-node])\n\n\n(defn- path-map-node\n  \"`(php/bind-path-map! {path thunk ...})` for the composition's published\n   paths (plan P6 R3): the computed include's lookup table.\"\n  [paths]\n  (app* 'php/bind-path-map!\n        (reduce (fn [m path] (app* 'assoc m (u/lit path) (delivery-thunk path)))\n                (u/lit {})\n                (sort paths))))\n\n\n(defn lower-program\n  \"`{:ast a :warnings [d ...]}` for one ok packet: the unit body run by\n   `php/run-main` after the prelude, tail calls marked. Its value is\n   `{:php/out s :php/diag [...] :php/uncaught nil-or-{:class :message}}`.\n   `:warnings` are the lowering's warning-severity diagnostics\n   (`:yang.php/unknown-builtin`, `:yang.php/compile-warning`,\n   `:yang.php/computed-include-path`).\n\n   Options: `:prelude` is `:bundled` (default; the prelude tree ahead of the\n   body) or `:linked` (`(require 'yang.call) (require 'php) (php/init!)`, the profile includes\n   need); `:path` the entry unit's declared path (default `entry-path`);\n   `:paths` the normalized paths whose units the composition published,\n   which a computed include resolves against; `:class-map` true requires\n   the published `phpm.$classmap` and binds its classes and delivery thunks\n   (plan P6 R9), which takes the place of `:paths`; `:request-node` is the\n  opaque `run-main` second-operand node the harness composed from the\n  attached request stream (lowering never embeds request data — `run-main`\n  consumes the record from the stream at runtime);\n  `:response-node` and `:diag-node` are the opaque third and fourth\n  operands: the composition-supplied stream references execution emits\n  on. Absent, `run-main` runs with two operands and the cells\n  accumulate.\"\n  ([packet] (lower-program packet {}))\n  ([packet {:keys [prelude paths path class-map request-node response-node diag-node],\n            :or {prelude :bundled}}]\n   (when-not (contains? #{:bundled :linked} prelude)\n     (throw (ex-info \"unknown PHP prelude profile\"\n                     {:yang.php/diagnostic :yang.php/unsupported,\n                      :construct :prelude,\n                      :prelude prelude})))\n   (let [linked? (= :linked prelude)\n         request-node (or request-node (u/sexp->uast :php/null))\n         ctx (context packet {:path (or path entry-path), :linked? linked?})\n         ;; `run-main`'s second operand arrives composed by the harness from\n         ;; the attached request stream: production initialization consumes\n         ;; the record from the stream at runtime and seeds the superglobals,\n         ;; no postwalk rewrite and no request data through lowering involved.\n         ;; With stream nodes `run-main` takes four operands (request,\n         ;; response and diagnostics references); without them it takes two\n         ;; and the cells accumulate.\n         main (if (or response-node diag-node)\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node\n                      (or response-node (u/sexp->uast :php/null))\n                      (or diag-node (u/sexp->uast :php/null)))\n                (app* 'php/run-main (u/lam [] (unit-node ctx)) request-node))]\n     {:ast (u/mark-tails\n             (if linked?\n               (u/seq-nodes (concat [(app* 'require (u/lit 'yang.call))\n                                     (app* 'require (u/lit prelude/module-name))\n                                     (app* 'php/init!)]\n                                    (when (and (seq paths) (not class-map)) [(path-map-node paths)])\n                                    (when class-map\n                                      [(app* 'require (u/lit classmap-module))\n                                       (app* 'php/bind-class-map!\n                                             (u/v (symbol (str classmap-module) \"classes\"))\n                                             (u/v (symbol (str classmap-module) \"paths\")))])\n                                    [main]))\n               (u/then prelude/uast main))),\n      :warnings @(:warnings ctx)})))\n\n\n(defn lower-packet\n  \"The complete program for one ok packet (`lower-program`'s `:ast`).\"\n  ([packet] (lower-packet packet {}))\n  ([packet opts] (:ast (lower-program packet opts))))\n\n\n;; =============================================================================\n;; The module emitter: one PHP unit as the linker module phpm.<mangled-path>\n;; =============================================================================\n\n(def module-exports\n  \"The exports of a compiled PHP unit: its spec and body, immutable after\n   install.\"\n  '#{spec body})\n\n\n(defn imported-unit-names\n  \"The normalized paths the unit statically includes through folded literal\n   paths, source order, distinct, the unit's own path aside. A computed path\n   contributes nothing: it is by name at run time (plan P6 R3). A path that\n   cannot normalize is refused as `lower-include` refuses it.\"\n  [packet {:keys [path], :or {path entry-path}}]\n  (let [ctx (context packet {:path path, :linked? true})]\n(ns yang.php.antlr.safepoint\n  \"The PHP `:loop` and `:call` hooks. A bounded run charges one safepoint to\n   its per-run counter; exhaustion unwinds past guest handlers and raises the\n   operational fatal, not a guest Throwable.\"\n  (:require\n    [yang.core.uast :as u]))\n\n\n(def profile\n  {:loop 'php.sp/loop, :call {:hook 'php.sp/call, :sequence true}})\n\n\n(def fatal-text\n  \"Maximum execution time of 30 seconds exceeded\")\n\n\n(def ^:private function-definitions\n  '[[php.sp/exhaust!\n     ;; the terminal root escape: guest handlers, returns and finalizers\n     ;; cannot replace the operational fatal\n     (fn []\n       (php/root-fatal \"Maximum execution time of 30 seconds exceeded\"))]\n    [php.sp/tick\n     (fn []\n       (let [n (cell/get php.sp/remaining)]\n         (if (= n 0)\n           (php.sp/exhaust!)\n           (do (cell/set! php.sp/remaining (- n 1)) :php/null))))]\n    [php.sp/loop (fn [] (php.sp/tick))]\n    [php.sp/call (fn [] (php.sp/tick))]])\n\n\n(defn- definitions->uast\n  [defs]\n  (u/seq-nodes (map (fn [[k form]] (u/def! k (u/sexp->uast form))) defs)))\n\n\n(defn program\n  \"The bounded run: hook definitions and a counter holding `budget`, then the\n   safepoint-derived program `ast`. `budget` must be a non-negative integer;\n   anything else is a named host-side error, not a guest diagnostic.\"\n  [budget ast]\n  (when-not (and (integer? budget) (not (neg? budget)))\n    (throw (ex-info \"php.sp/remaining budget must be a non-negative integer\"\n                    {:yang.php.antlr.safepoint/error :invalid-budget\n                     :budget budget})))\n  (u/mark-tails\n    (u/then (definitions->uast function-definitions)\n            (u/then (u/def! 'php.sp/remaining (u/sexp->uast (list 'cell/new budget)))\n                    ast))))\n(ns yang.php.oracle\n  \"PHP 8.3 CLI oracle runner for `yang.php.antlr.programs`\n   (docs/design/yang.php.md sections 14, 17.3).\n\n   For every fixture in `programs/fixtures` (plus `matrix-source` and\n   `float-cases`), writes the PHP source to a temporary file and runs:\n     docker run --rm -v <dir>:/w -w /w php:8.3-cli php \\\\\n       -d display_errors=1 -d html_errors=0 -d error_reporting=E_ALL \\\\\n       -d log_errors=0 <file>\n   Parses stdout into `:out`, `:diag` (`[[errno message] ...]`) and `:uncaught`\n   (`{:class c :message m}`), and compares against each fixture's expectation\n   (or `:departure/:zend` for departure fixtures).\"\n  (:require\n    [clojure.java.io :as io]\n    [clojure.java.shell :as sh]\n    [clojure.string :as str]\n    [yang.php.antlr.programs :as programs]\n    [yang.php.antlr.programs-p3b :as p3b]\n    [yang.php.antlr.programs-p4 :as p4]\n    [yang.php.antlr.programs-p5 :as p5]\n    [yang.php.antlr.programs-p5b2 :as p5b2]\n    [yang.php.antlr.programs-p6 :as p6])\n  (:import\n    (java.nio.charset\n      StandardCharsets)\n    (java.nio.file\n      Files)\n    (java.nio.file.attribute\n      FileAttribute)))\n\n\n(def banner\n  \"The pinned PHP 8.3 CLI oracle provenance banner.\"\n  p3b/banner)\n\n\n(def p5-banner\n  \"The P5 request-context run's own provenance banner (version/host/date of\n  the P5 recording pass, not P3-b's).\"\n  \"php-8.3.35 shiva 2026-10-25\")\n\n\n(def ^:private errno-of\n  {\"Warning\" 2,\n   \"Notice\" 8,\n   \"Deprecated\" 8192,\n   \"Fatal error\" 1})\n\n\n(defn class-derived?\n  \"Whether the recorded diag entry carries a class-derived errno: the runner\n  parses only the `Warning|Notice|...` kind line, so the recorded number is\n  derived from the message class, not the true constant (e.g. `Notice` parses\n  to 8 where the engine's semantic truth for `E_USER_NOTICE` is 1024).\"\n  [diag-entry]\n  (boolean (:yang.php.oracle/class-derived (meta diag-entry))))\n\n\n(defn- mark-class-derived\n  \"Mark a recorded `[errno message]` pair as class-derived (see [[class-derived?]]).\"\n  [pair]\n  (with-meta pair {:yang.php.oracle/class-derived true}))\n\n\n(defn errno-match?\n  \"Whether expected errno `e` matches recorded diag entry `a`: identical\n  numbers match, and a class-derived parse mismatch counts as equal ONLY when\n  the oracle record is marked class-derived (the runner parses only the\n  `Warning|Notice|...` kind line: E_USER_NOTICE parses to 8 and E_USER_WARNING\n  to 2 where the engine's semantic truth is 1024 and 512).\"\n  [e a]\n  (let [[actual-errno] a]\n    (or (= e actual-errno)\n        (and (= 1024 e) (= 8 actual-errno) (class-derived? a))\n        (and (= 512 e) (= 2 actual-errno) (class-derived? a)))))\n\n\n(defn diag-match?\n  \"Whether the expected diag vector matches the recorded one entry-wise under\n  [[errno-match?]] (messages compare literally).\"\n  [expected-diag actual-diag]\n  (and (= (count expected-diag) (count actual-diag))\n       (every? true? (map (fn [[e-errno e-msg] a]\n                            (and (errno-match? e-errno a)\n                                 (= e-msg (second a))))\n                          expected-diag actual-diag))))\n\n\n(defn- location-pattern\n  \"The regex source of a PHP source location below `/w/`: the entry `file`\n   itself, or, for a multi-unit fixture run in `/w/<unit-dir>`, any unit file\n   below the directory.\"\n  [file unit-dir]\n  (if unit-dir\n    (str (java.util.regex.Pattern/quote unit-dir) \"/[^\\\\s:]+\")\n    (java.util.regex.Pattern/quote file)))\n\n\n(defn- strip-location\n  ([s file] (strip-location s file nil))\n  ([s file unit-dir]\n   (str/replace s\n                (re-pattern (str \" in /w/\" (location-pattern file unit-dir) \" on line \\\\d+\"))\n                \"\")))\n\n\n(defn parse-stdout\n  \"Parse PHP CLI stdout for `/w/<file>` into\n   `{:out <string> :diag [[errno msg] ...] :uncaught {:class c :message m}-or-nil}`.\n   With `unit-dir`, locations in any file below `/w/<unit-dir>` are stripped\n   (a multi-unit fixture).\"\n  ([raw file] (parse-stdout raw file nil))\n  ([raw file unit-dir]\n   (let [qfile (location-pattern file unit-dir)\n         strip-location (fn [s file] (strip-location s file unit-dir))\n         ;; The uncaught block ends at PHP's own terminator, so output written\n         ;; after it (shutdown functions, destructors) stays in :out.\n         uncaught-re (re-pattern\n                       (str \"(?s)\\\\nFatal error: Uncaught ([^:]+): ([^\\\\r\\\\n]*) in /w/\"\n                            qfile\n                            \":\\\\d+\\\\nStack trace:\\\\n.*?\\\\n  thrown in /w/\"\n                            qfile\n                            \" on line \\\\d+\\\\n\"))\n         fatal-re (re-pattern\n                    (str \"\\\\nFatal error: ([^\\\\r\\\\n]*) in /w/\"\n                         qfile\n                         \" on line \\\\d+\\\\n\"))\n         diag-re (re-pattern\n                   (str \"\\\\n(Warning|Notice|Deprecated): ([^\\\\r\\\\n]*?) in /w/\"\n                        qfile\n                        \" on line \\\\d+\\\\n\"))\n         [without-fatal uncaught fatal]\n         (if-let [[_ cls msg] (re-find uncaught-re raw)]\n           [(str/replace raw uncaught-re \"\")\n            {:class cls, :message (strip-location msg file)}\n            nil]\n           (if-let [[_ msg] (re-find fatal-re raw)]\n             ;; a plain (non-uncaught-exception) fatal: the engine's\n             ;; guest-fatal representation (`:php/fatal message`, shutdown\n             ;; already run) is preserved as `:fatal`, and `:uncaught`\n             ;; stays nil — a plain fatal populates one slot only.\n             [(str/replace raw fatal-re \"\")\n              nil\n              (strip-location msg file)]\n             [raw nil nil]))\n         diags (volatile! [])\n         out (str/replace without-fatal\n                          diag-re\n                          (fn [[_ kind msg]]\n                            (vswap! diags conj (mark-class-derived [(get errno-of kind) (strip-location msg file)]))\n                            \"\"))]\n     ;; a single-slot plain fatal carries its own diagnostic: the engine\n     ;; records the fatal's E_USER_ERROR-class diagnostic (errno 256)\n     ;; alongside `:fatal`, so `:diag` carries it too.\n     {:out out,\n      :diag (if fatal (conj @diags [256 fatal]) @diags),\n      :uncaught uncaught,\n      :fatal fatal})))\n\n\n(defn run-php-file\n  \"Run `<file>` inside `<dir>` via Docker `php:8.3-cli` and return the parsed\n   `{:out :diag :uncaught :exit}`. With `unit-dir`, the working directory is\n   `/w/<unit-dir>` and `file` is relative to it (a multi-unit fixture).\"\n  ([dir file] (run-php-file dir file nil))\n  ([dir file unit-dir]\n   (let [{:keys [out err exit]}\n         (sh/sh \"docker\" \"run\" \"--rm\"\n                \"-v\" (str (.toAbsolutePath (.toPath (io/file dir))) \":/w\")\n                \"-w\" (if unit-dir (str \"/w/\" unit-dir) \"/w\")\n                \"php:8.3-cli\" \"php\"\n                \"-d\" \"display_errors=1\"\n                \"-d\" \"html_errors=0\"\n                \"-d\" \"error_reporting=E_ALL\"\n                \"-d\" \"log_errors=0\"\n                file\n                :out-enc \"UTF-8\")]\n     (assoc (parse-stdout out (if unit-dir (str unit-dir \"/\" file) file) unit-dir)\n            :err err\n            :exit exit))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"The shared design requires more than inserting hooks: PHP’s linked includes need verified site-set publication and rebinding, and callback state must belong to the request. I’m tracing the existing fixture and publication paths before choosing the smallest independently verifiable changes."}}
