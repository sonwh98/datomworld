:3575:(defn- lower\nsrc/cljc/yang/php/antlr/lower.cljc:3612:    \"declareStatement\" (lower-declare ctx n)\nsrc/cljc/yang/php/antlr/lower.cljc:3741:(defn lower-module-body\nsrc/cljc/yang/php/antlr/lower.cljc:3767:(defn lower-program\nsrc/cljc/yang/php/antlr/lower.cljc:3828:(defn lower-packet\nsrc/cljc/yang/php/antlr/lower.cljc:4040:(defn lower-transform\nsrc/cljc/yang/php/antlr/prelude.cljc:4678:                               (if (= kind :line) (php/prop-raw o \"line\")\nsrc/cljc/yang/php/antlr/prelude.cljc:5996:                   [\"getPrevious\" :previous] [\"getFile\" :file] [\"getLine\" :line]\n","exit_code":0,"status":"completed"}}
