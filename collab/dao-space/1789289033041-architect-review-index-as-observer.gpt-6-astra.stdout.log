{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/query.cljc | sed -n '30,118p;180,260p;329,409p'; rg -n 'store|address' src/cljc/dao/data/btree.cljc | head -65; cat src/cljc/dao/data/btree/storage.cljc\"","aggregated_output":"    30\t;; =============================================================================\n    31\t\n    32\t(defn- flatten-datoms\n    33\t  \"Flatten one source's row elements into canonical d5 rows. An element is\n    34\t   either a canonical d5 vector `[e a v t m]` or an atomic transaction record\n    35\t   `{:dao.space/transaction {:t n :datoms [...]}}`; the record is flattened\n    36\t   into its datoms.\"\n    37\t  [elements]\n    38\t  (into\n    39\t    []\n    40\t    (mapcat\n    41\t      (fn [x]\n    42\t        (cond\n    43\t          (and (map? x) (contains? x :dao.space/transaction))\n    44\t          (let [tx (:dao.space/transaction x)\n    45\t                _ (when-not (and (map? tx)\n    46\t                                 (= #{:t :datoms} (set (keys tx)))\n    47\t                                 (integer? (:t tx))\n    48\t                                 (not (neg? (:t tx)))\n    49\t                                 (vector? (:datoms tx))\n    50\t                                 (seq (:datoms tx)))\n    51\t                    (throw (ex-info \"malformed dao.space transaction record\"\n    52\t                                    {:payload x})))\n    53\t                _ (when-not (every? #(= (:t tx) (index/datom-t %))\n    54\t                                    (:datoms tx))\n    55\t                    (throw (ex-info\n    56\t                             \"transaction record datoms carry mismatched t\"\n    57\t                             {:payload x})))]\n    58\t            (:datoms tx))\n    59\t          (and (vector? x) (= 5 (count x))) [x]\n    60\t          :else\n    61\t          (throw\n    62\t            (ex-info\n    63\t              \"canonical d5 source element must be a 5-datom vector or a transaction record\"\n    64\t              {:element x})))))\n    65\t    elements))\n    66\t\n    67\t\n    68\t(defn- bound-datoms\n    69\t  \"Bound a d5 sequence to t <= as-of when an as-of is given.\"\n    70\t  [datoms as-of]\n    71\t  (if as-of\n    72\t    (filterv #(<= (index/compare-vals (index/datom-t %) as-of) 0) datoms)\n    73\t    datoms))\n    74\t\n    75\t\n    76\t(defn current-state-seq\n    77\t  \"Takes a sequence of canonical d5 datoms and returns the sequence of\n    78\t   currently-asserted datoms. Facts are keyed by local [e a v]: the greatest\n    79\t   t wins within each key, and two rows sharing [e a v t] but differing in m\n    80\t   are conflicting transaction history and are rejected (metadata is not an\n    81\t   implicit tie-break). Retractions are removed; the result is EAVT-ordered.\"\n    82\t  [s]\n    83\t  (->> (reduce\n    84\t         (fn [acc d]\n    85\t           (let [key [(index/datom-e d) (index/datom-a d) (index/datom-v d)]]\n    86\t             (update\n    87\t               acc\n    88\t               key\n    89\t               (fn [winner]\n    90\t                 (cond (nil? winner) d\n    91\t                       (< (index/datom-t winner) (index/datom-t d)) d\n    92\t                       (> (index/datom-t winner) (index/datom-t d)) winner\n    93\t                       (not= (index/datom-m winner) (index/datom-m d))\n    94\t                       (throw\n    95\t                         (ex-info\n    96\t                           \"conflicting d5 rows: same [e a v t], different m\"\n    97\t                           {:a winner, :b d}))\n    98\t                       :else winner)))))\n    99\t         {}\n   100\t         s)\n   101\t       (vals)\n   102\t       (remove datom/retracted?)\n   103\t       (sort index/eavt-cmp)))\n   104\t\n   105\t\n   106\t(defn- d5->current-facts\n   107\t  [elements as-of]\n   108\t  (->> (bound-datoms (flatten-datoms elements) as-of)\n   109\t       current-state-seq\n   110\t       (mapv #(subvec (vec %) 0 3))))\n   111\t\n   112\t\n   113\t(defn- d5->history-rows\n   114\t  [elements as-of]\n   115\t  (mapv vec (bound-datoms (flatten-datoms elements) as-of)))\n   116\t\n   117\t\n   118\t;; =============================================================================\n   180\t(defn- snapshot-value?\n   181\t  [x]\n   182\t  (and (map? x) (contains? x :relation) (contains? x :status)))\n   183\t\n   184\t\n   185\t(defn- db-source\n   186\t  \"Normalize a current/history source. Query values and snapshots pass\n   187\t   through (a snapshot contributes its relation); everything else — raw\n   188\t   maps and vectors included — throws.\"\n   189\t  [source]\n   190\t  (cond\n   191\t    (value? source) source\n   192\t    (snapshot-value? source) (:relation source)\n   193\t    :else\n   194\t    (throw (ex-info \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   195\t                    {:input source}))))\n   196\t\n   197\t\n   198\t(defn- view-value\n   199\t  [kind source as-of]\n   200\t  (cond-> {:dao.space.query/view kind, :source source}\n   201\t    (some? as-of) (assoc :as-of as-of)))\n   202\t\n   203\t\n   204\t(defn current\n   205\t  \"The explicit current d5 interpreter: a view value over source. Resolves\n   206\t   the greatest t per [e a v], removes retractions, and rejects conflicting\n   207\t   [e a v t] rows with differing m. An optional as-of bounds visible datoms\n   208\t   to t <= as-of.\"\n   209\t  ([source] (current source nil))\n   210\t  ([source as-of]\n   211\t   (view-value :current (db-source source) as-of)))\n   212\t\n   213\t\n   214\t(defn history\n   215\t  \"The explicit history d5 interpreter: a view value over source exposing\n   216\t   the exact logical d5 rows. An optional as-of bounds visible datoms to\n   217\t   t <= as-of.\"\n   218\t  ([source] (history source nil))\n   219\t  ([source as-of]\n   220\t   (view-value :history (db-source source) as-of)))\n   221\t\n   222\t\n   223\t;; =============================================================================\n   224\t;; Published indexes: open-published! / close-published! (Decision 1)\n   225\t;; =============================================================================\n   226\t\n   227\t(defn open-published!\n   228\t  \"Open a published covered-index coordinate — the serializable map\n   229\t   `index/published-index` builds — as a query value the caller owns: the\n   230\t   content-store handle it opens is closed by `close-published!`, never by\n   231\t   a query. Nothing is fetched beyond the manifest; the row vector stays\n   232\t   deferred behind :rows and the covered sets behind restored B-trees, so a\n   233\t   `current` view with no as-of can answer selective clauses without a\n   234\t   full drain.\"\n   235\t  [coordinate]\n   236\t  (when-not (and (map? coordinate)\n   237\t                 (= :dao.space.index/published (:dao.stream/type coordinate)))\n   238\t    (throw (ex-info \"open-published! takes a published-index coordinate\"\n   239\t                    {:coordinate coordinate})))\n   240\t  (let [{:keys [content-store manifest-address]} coordinate\n   241\t        expected (index/published-index content-store manifest-address)]\n   242\t    (when-not (= expected coordinate)\n   243\t      (throw (ex-info \"invalid published-index coordinate\"\n   244\t                      {:coordinate coordinate, :expected expected})))\n   245\t    (let [store (jing-coordinate/open! content-store)]\n   246\t      (try\n   247\t        (let [manifest (index/read-manifest store manifest-address)]\n   248\t          {:dao.space.query/published coordinate\n   249\t           :indexes (index/restored-indexes store manifest)\n   250\t           :rows (delay (index/read-datoms store manifest-address))\n   251\t           :store store\n   252\t           :close-guard (atom false)})\n   253\t        (catch #?(:cljd Object\n   254\t                  :clj Throwable\n   255\t                  :cljs :default)\n   256\t               error\n   257\t          (jing/close! store)\n   258\t          (throw error))))))\n   259\t\n   260\t\n   329\t(defn- relation->fact-index\n   330\t  [relation]\n   331\t  (index/index-datoms (mapv (fn [tuple]\n   332\t                              [(nth tuple 0) (nth tuple 1)\n   333\t                               (nth tuple 2) 0 datom/default-op])\n   334\t                            relation)))\n   335\t\n   336\t\n   337\t(defn- force-relation\n   338\t  \"Force a relation if it is delayed (e.g. from a lazy covered-index\n   339\t   realization) or return it directly. Memoization belongs to the delay:\n   340\t   forcing is therefore at most one walk, but this function itself neither\n   341\t   creates nor guarantees non-nilness.\"\n   342\t  [relation]\n   343\t  (if (delay? relation) @relation relation))\n   344\t\n   345\t\n   346\t(declare realize-db-value!)\n   347\t\n   348\t\n   349\t(defn- realize-datom-view\n   350\t  \"Interpret a current/history view inside the query layer. The nested\n   351\t   source is another query value; a current view with no as-of over an\n   352\t   opened published index routes through the restored covered sets, every\n   353\t   other combination resolves the source's rows.\"\n   354\t  [d]\n   355\t  (let [kind (:dao.space.query/view d)\n   356\t        as-of (:as-of d)\n   357\t        {src-relation ::relation, src-indexes ::indexes}\n   358\t        (realize-db-value! (:source d))]\n   359\t    (if (and (= :current kind) (nil? as-of) src-indexes)\n   360\t      {::relation (delay (d5->current-facts (force-relation src-relation) nil)),\n   361\t       ::fact-index src-indexes}\n   362\t      (let [forced-rel (force-relation src-relation)\n   363\t            rows (case kind\n   364\t                   :current (d5->current-facts forced-rel as-of)\n   365\t                   :history (d5->history-rows forced-rel as-of))]\n   366\t        {::relation rows,\n   367\t         ::fact-index (when (= :current kind)\n   368\t                        (relation->fact-index rows))}))))\n   369\t\n   370\t\n   371\t(defn ^:no-doc realize-db-value!\n   372\t  \"Turn one db-value into an immutable tuple relation plus, for current\n   373\t   fact views, an in-memory fact index. Opens nothing, closes nothing.\"\n   374\t  [db-value]\n   375\t  (when-not (map? db-value)\n   376\t    (throw\n   377\t      (ex-info\n   378\t        \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   379\t        {:input db-value})))\n   380\t  (cond\n   381\t    (contains? db-value :dao.space.query/relation)\n   382\t    (let [tuples (:dao.space.query/relation db-value)]\n   383\t      {::relation tuples,\n   384\t       ::fact-index (when (:fact? db-value) (relation->fact-index tuples))})\n   385\t\n   386\t    (contains? db-value :dao.space.query/published)\n   387\t    (let [indexes (index/covered-indexes db-value)]\n   388\t      {::relation (:rows db-value),\n   389\t       ::indexes indexes,\n   390\t       ::fact-index nil})\n   391\t\n   392\t    (contains? db-value :dao.space.query/view)\n   393\t    (realize-datom-view db-value)\n   394\t\n   395\t    :else\n   396\t    (throw\n   397\t      (ex-info\n   398\t        \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   399\t        {:input db-value}))))\n   400\t\n   401\t\n   402\t;; =============================================================================\n   403\t;; match: Linda-style positional template (an ergonomic materializer)\n   404\t;; =============================================================================\n   405\t\n   406\t(def ^:private FREE ::free)\n   407\t\n   408\t\n   409\t(defn- wildcard?\n8:  throughout this phase (§3.1); durability (IStorage, store/restore) lands\n14:  acopy shape, no restored-count sentinel, stale-transient-throws).\n151:;; the §5.1 settings-threading rule: the storage and the trees restored\n152:;; through it share one Settings, so no restored node can ever carry\n157:  (-store\n159:    \"Serialize node, materialize it content-addressed, return the address. Called\n160:     only after all of the node's children have been stored and have\n161:     addresses (§5.1).\")\n163:  (-restore\n164:    [storage address]\n165:    \"Fetch + deserialize the node at address; node type from blob shape\n171:    [storage address]\n176:    \"The Settings shared by every tree restored through this storage.\"))\n205:  \"Wrap a freshly faulted (or newly stored) node per the settings ref-type.\n219:(defn- make-store-ref\n220:  \"Ref for a just-stored child (§3.1 dirty->stored conversion). When the\n222:   stored), a cleared reference could never refault — so pin strong\n223:   regardless of ref-type; the node was strongly held before the store, so\n224:   this is not a memory regression. Trees restored through a storage get\n309:;; the slots stay nil), which is how lazily-restored branches with nil\n310:;; children/addresses arrays flow through node surgery.\n334:;; this file's existing mutable fields (§3.1's dirty/stored ones) as the\n424:    \"The stored element equal to k under cmp, or nil.\")\n451:  (node-addresses-arr\n453:    \"Branch addresses array or nil; leaf: nil.\")\n458:     the slot is stored-but-unfaulted (§3.1 state 3). Throws \\\"unhydrated\n459:     segment\\\" when no storage or address can satisfy the fault (§5.4).\")\n461:  (node-store\n464:     skips slots that already carry an address (§3.1). Returns this node's\n465:     address.\"))\n629:  (node-addresses-arr [_] nil)\n635:  (node-store [this storage] (-store storage this)))\n640:;; all-dirty (addresses nil, children resident and strong).\n652:   #?(:cljd ^:mutable addresses\n653:      :clj ^:unsynchronized-mutable addresses\n654:      :cljs ^:mutable addresses) settings]\n668:        (arr/aget keys idx) ; separator is the stored max element\n690:                  (when addresses (arr/aset addresses ins nil))\n703:                    na (when addresses\n704:                         (let [as (arr/asub addresses 0 len)]\n722:                  as (when addresses (arr/anew cap))]\n735:                      (stitch-all as o addresses 0 ins)\n738:                      (stitch-all as o addresses (inc ins) len)))\n753:                      as1 (when addresses (arr/anew h1))\n754:                      as2 (when addresses (arr/anew h2))]\n770:                          (stitch-all as1 o addresses 0 ins)\n773:                          (stitch-all as1 o addresses (inc ins) (dec h1)))\n774:                    (arr/acopy addresses (dec h1) as2 0 (- len (dec h1))))\n782:                      as1 (when addresses (arr/asub addresses 0 h1))\n783:                      as2 (when addresses (arr/anew h2))]\n796:                          (stitch-all as2 o addresses h1 ins)\n799:                          (stitch-all as2 o addresses (inc ins) len)))\n838:                  addr-at (fn [i] (when addresses (arr/aget addresses i)))\n856:                  stitch-center-addresses!\n872:                          (stitch-all as o addresses (+ idx 2) len)))]\n879:                      as (when addresses (arr/anew new-len))]\n887:                    (stitch-center-addresses! as\n890:                                                          addresses\n901:                      la (node-addresses-arr left)\n904:                      as (when (or la addresses) (arr/anew jl))]\n916:                          (stitch-all as o addresses 0 (dec idx))\n917:                          (stitch-center-addresses! as o)))\n924:                      ra (node-addresses-arr right)\n927:                      as (when (or addresses ra) (arr/anew jl))]\n938:                          (stitch-all as o addresses 0 (dec idx))\n(ns dao.data.btree.storage\n  \"IStorage adapters over dao.jing content-store handles (docs/design/dao.data.btree.md\n   §5.1, §5.4). A handle is the plain-data content store carrying\n   :put-content-fn, :get-content-fn, and :close-fn (docs/design/dao.jing.md,\n   Materialization rule); addresses are derived from payloads by\n   dao.jing/materialize!, never supplied by this layer. Two adapters, one\n   error taxonomy:\n\n   - KVStorage (kv-storage): the sync rule-1 adapter. Absence is\n     authoritative: a missing blob throws \\\"missing index segment\\\".\n     Optional same-host integrity verification (§5.2): rehash the fetched\n     blob against its content address; mismatch throws \\\"corrupt index\n     segment\\\". Off by default — dao.jing's print-based content hash is not\n     host-stable, so cross-host reads must not verify (dao.jing.md, Current\n     Scope).\n   - HydrationStorage (hydration-storage): the §5.4 hydration-cache\n     adapter for async-only backends. Reads answer only from the cache;\n     any miss throws \\\"unhydrated segment\\\" — the cache cannot distinguish\n     absent from not-yet-fetched without blocking on the backend. hydrate!\n     copies the reachable blob graph from the source into the cache.\n\n   dao.data.btree itself stays storage-agnostic; this namespace is the one\n   place the tree meets dao.jing (Decision 1: no new storage protocol —\n   everything below is materialize!/get, plus segment-key for §5.2\n   verification).\"\n  (:require [dao.data.btree :as bt]\n            [dao.jing :as jing]))\n\n\n(def ^:private absent\n  \"Identity sentinel for handle misses (§5.1 sketch): keywords are not\n   reliably `identical?` on cljs, an opaque host object is.\"\n  #?(:cljd (Object.)\n     :clj (Object.)\n     :cljs (js-obj)))\n\n\n(deftype KVStorage\n  [store settings verify?]\n\n  bt/IStorage\n\n  (-store [_ node] (jing/materialize! store (bt/node->blob node)))\n\n\n  (-restore\n    [_ addr]\n    (let [blob (jing/get store addr absent)]\n      (when (identical? blob absent)\n        (throw (ex-info \"missing index segment\" {:address addr})))\n      (when verify?\n        (let [actual (jing/segment-key blob)]\n          (when (not= addr actual)\n            (throw (ex-info \"corrupt index segment\"\n                            {:expected addr, :actual actual})))))\n      (bt/blob->node blob settings)))\n\n\n  (-accessed [_ _addr] nil)\n\n\n  (-settings [_] settings))\n\n\n(defn kv-storage\n  \"A sync IStorage over a dao.jing content-store handle. opts:\n   {:branching-factor n (default 512) :ref-type k (default per host, §5.3)\n   :verify? bool (default false, §5.2 — same-host mint+read only)}. The\n   returned storage owns the Settings every tree restored through it shares\n   (§5.1 threading rule); pass the manifest's :branching-factor here.\"\n  ([store] (kv-storage store nil))\n  ([store opts]\n   (let [box (volatile! nil)\n         sett (bt/->Settings (or (:branching-factor opts) 512)\n                             (or (:ref-type opts) (bt/default-ref-type*))\n                             nil\n                             box)\n         storage (KVStorage. store sett (boolean (:verify? opts)))]\n     (vreset! box storage)\n     storage)))\n\n\n;; ---------------------------------------------------------------------------\n;; Hydration cache (§5.4)\n\n(deftype HydrationStorage\n  [source cache settings]\n\n  bt/IStorage\n\n  (-store\n    [_ node]\n    ;; writes land in the durable source AND the read cache; both are\n    ;; content-addressed, so both must answer with the same address\n    (let [blob (bt/node->blob node)\n          source-addr (jing/materialize! source blob)\n          cache-addr (jing/materialize! cache blob)]\n      (when-not (= source-addr cache-addr)\n        (throw (ex-info \"hydration source and cache diverged\"\n                        {:source source-addr, :cache cache-addr})))\n      source-addr))\n\n\n  (-restore\n    [_ addr]\n    (let [blob (jing/get cache addr absent)]\n      (if (identical? blob absent)\n        ;; absent vs not-hydrated is undecidable synchronously (§5.4)\n        (throw (ex-info \"unhydrated segment\" {:address addr}))\n        (bt/blob->node blob settings))))\n\n\n  (-accessed [_ _addr] nil)\n\n\n  (-settings [_] settings))\n\n\n(defn hydration-storage\n  \"The §5.4 hydration-cache adapter: reads answer only from `cache` (miss\n   => \\\"unhydrated segment\\\"); `hydrate!` fills the cache from `source`.\n   In production `source` is an async backend accessed only by the\n   hydration pre-pass; in tests any content handle stands in.\"\n  ([source cache] (hydration-storage source cache nil))\n  ([source cache opts]\n   (let [box (volatile! nil)\n         sett (bt/->Settings (or (:branching-factor opts) 512)\n                             (or (:ref-type opts) (bt/default-ref-type*))\n                             nil\n                             box)\n         storage (HydrationStorage. source cache sett)]\n     (vreset! box storage)\n     storage)))\n\n\n(defn hydrate!\n  \"Full-graph hydration (§5.4 rule 2, blocking variant): copy every blob\n   reachable from the set's root address out of the source backend into\n   the hydration cache, so subsequent reads — and mutations, whose write\n   path requires residency — succeed. Idempotent: already-cached segments\n   are re-materialized as no-ops. Returns the set. On a non-hydration\n   storage this is a no-op (sync backends need no hydration).\"\n  [s]\n  (let [storage (bt/set-storage s)]\n    (when (instance? HydrationStorage storage)\n      (let [^HydrationStorage hs storage\n            source (.-source hs)\n            cache (.-cache hs)]\n        (letfn [(pull!\n                  [addr]\n                  (let [blob (jing/get source addr absent)]\n                    (when (identical? blob absent)\n                      (throw (ex-info \"missing index segment\" {:address addr})))\n                    (let [addr' (jing/materialize! cache blob)]\n                      (when-not (= addr addr')\n                        (throw (ex-info \"hydration address mismatch\"\n                                        {:expected addr, :actual addr'}))))\n                    (doseq [a (:addresses blob)] (pull! a))))]\n          (when-some [addr (bt/set-address s)] (pull! addr)))))\n    s))\n","exit_code":0,"status":"completed"}}
