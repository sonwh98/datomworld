{:dao.stream/outcome :dao.stream/ok ...}\n   where both :dao.stream/descriptor and :dao.stream/identity are present,\n   descriptor is a valid descriptor envelope, and the sibling :dao.stream/identity\n   projection structurally equals the identity inside the descriptor envelope.\"\n  [result]\n  (and (map? result)\n       (= :dao.stream/ok (:dao.stream/outcome result))\n   260\t       (map? (:indexes manifest))\n   261\t       (= #{:eavt :aevt :avet :vaet} (set (keys (:indexes manifest))))\n   262\t       (integer? (:count manifest))\n   263\t       (not (neg? (:count manifest)))\n   264\t       (integer? (:branching-factor manifest))\n   265\t       (<= 2 (:branching-factor manifest))\n   266\t       (if (zero? (:count manifest))\n   267\t         (every? nil? (vals (:indexes manifest)))\n   268\t         (every? jing/segment-address? (vals (:indexes manifest))))))\n   269\t\n   270\t\n   271\t(defn read-manifest\n   272\t  \"Retrieve the manifest stored at a content address. Throws on a missing\n   273\t   address and on a stored value that is not a conforming manifest.\"\n   274\t  [content-store manifest-address]\n   275\t  (let [manifest (jing/get content-store manifest-address content-missing)]\n   276\t    (when (identical? manifest content-missing)\n   277\t      (throw (ex-info \"missing index manifest\" {:address manifest-address})))\n   278\t    (when-not (valid-manifest? manifest)\n   279\t      (throw (ex-info \"invalid index manifest\"\n   280\t                      {:address manifest-address, :manifest manifest})))\n   281\t    (let [actual-address (jing/segment-key manifest)]\n   282\t      (when-not (= manifest-address actual-address)\n   283\t        (throw (ex-info \"index manifest content address mismatch\"\n   284\t                        {:expected manifest-address,\n   285\t                         :actual actual-address,\n   286\t                         :manifest manifest}))))\n   287\t    manifest))\n   288\t\n   289\t\n   290\t(defn read-datoms\n   291\t  \"Eagerly read every datom in the EAVT index of a published manifest, in\n   292\t   index order, by walking the node graph with plain `jing/get`. Takes the\n   293\t   manifest's content address; an empty index reads as ().\"\n   294\t  [content-store manifest-address]\n   295\t  (let [manifest (read-manifest content-store manifest-address)]\n   296\t    (vec (walk-index-datoms content-store (:eavt (:indexes manifest))))))\n   297\t\n   298\t\n   299\t(defn restored-indexes\n   300\t  \"Lazily-loaded {:eavt :aevt :avet :vaet} dao.data.btree sets over a\n   301\t   published manifest (`{:indexes {...} :count n :branching-factor n}`).\n   302\t   Nothing is fetched until a query traverses; slice (subseq-from) then\n   303\t   loads only the seek path plus the matching range. Works on every\n   304\t   platform.\n   305\t\n   306\t   The manifest's :count and :branching-factor are threaded through\n   307\t   restore-tree deliberately: count keeps O(1) `count` on restored trees\n   308\t   without faulting the graph, and the branching factor reaches every\n   309\t   restored node so mutation splits at the published thresholds. A manifest\n   310\t   without :count or :branching-factor is foreign or hand-built and belongs\n   311\t   to the eager path (walk-index-datoms), not here.\"\n   312\t  [content-store manifest]\n   313\t  (let [{:keys [indexes count branching-factor]} manifest\n   314\t        storage (bts/kv-storage content-store\n   315\t                                {:branching-factor (or branching-factor 512)})]\n   316\t    {:eavt (bt/restore-tree eavt-cmp (:eavt indexes) storage count),\n   317\t     :aevt (bt/restore-tree aevt-cmp (:aevt indexes) storage count),\n   318\t     :avet (bt/restore-tree avet-cmp (:avet indexes) storage count),\n   319\t     :vaet (bt/restore-tree vaet-cmp (:vaet indexes) storage count)}))\n   320\t\n   321\t\n   322\t;; =============================================================================\n   323\t;; Published covered index as a bounded logical d5 stream\n   324\t;; =============================================================================\n   325\t\n   326\t(defn published-index\n   327\t  \"Construct a transportable descriptor for one immutable covered-index\n   328\t   manifest. `content-store` is a serializable DaoJing coordinate, not a live\n   329\t   handle. The manifest address is the exact stream bound.\"\n   330\t  [content-store manifest-address]\n   331\t  (when-not (and (map? content-store) (keyword? (:dao.jing/type content-store)))\n   332\t    (throw (ex-info \"published index requires a DaoJing store coordinate\"\n   333\t                    {:content-store content-store})))\n   334\t  (when-not (jing/segment-address? manifest-address)\n   335\t    (throw (ex-info \"published index requires a manifest content address\"\n   336\t                    {:manifest-address manifest-address})))\n   337\t  {:dao.stream/type :dao.space.index/published,\n   338\t   :dao.stream/bound {:manifest-address manifest-address},\n   339\t   :dao.stream/comparator :dao.space.index/eavt,\n   340\t   :content-store content-store,\n   341\t   :manifest-address manifest-address})\n   342\t\n   343\t\n   344\t(defrecord PublishedIndexStream\n   345\t  [descriptor datoms indexes store]\n   346\t\n   347\t  ds/IDaoStreamReader\n   348\t\n   349\t  (next\n   350\t    [_ cursor]\n   351\t    (let [rows (force datoms)\n   352\t          position (or (:position cursor) 0)]\n   353\t      (if (< position (count rows))\n   354\t        {:ok (nth rows position), :cursor {:position (inc position)}}\n   355\t        :end)))\n   356\t\n   357\t\n   358\t  ds/IDaoStreamBound\n   359\t\n   360\t  (close! [_] (jing/close! store) {:woke []})\n   361\t\n   362\t\n   363\t  (closed? [_] true))\n   364\t\n   365\t\n   366\t(defn covered-indexes\n   367\t  \"Return the {:eavt :aevt :avet :vaet} covered d5 sets carried in a\n   368\t   realization's :indexes field, or nil when the realization carries none.\n   369\t   Structural check only: the realization must be a map whose :indexes field\n   370\t   is a map with exactly those four keys, so it is clj/cljs/cljd-portable and\n   371\t   never an instance/type check. It means the realization carries covered d5\n   372\t   sets, not that it is lazy: an in-memory index-datoms map is structurally\n   373\t   indistinguishable, and that is fine (resolution happens the same way\n   374\t   either way).\"\n   375\t  [realization]\n   376\t  (when (map? realization)\n   377\t    (let [indexes (:indexes realization)]\n   378\t      (when (and (map? indexes)\n   379\t                 (= #{:eavt :aevt :avet :vaet} (set (keys indexes))))\n   380\t        indexes))))\n7:   maps are rejected. `q` opens nothing and closes nothing; it returns a\n594:   closes :opened through query/close-published!, :store through\n630:(deftest lazy-published-point-clause-and-entity-projection-equivalence\n687:(deftest opened-published-index-stays-open-across-queries\n715:(deftest close-published-closes-once-and-is-idempotent\n737:(deftest lazy-published-node-budget-is-strictly-bounded\n773:(deftest lazy-published-multi-clause-budget-is-strictly-bounded\n820:(deftest lazy-published-rest-pattern-regression\n849:(deftest lazy-published-mixed-multi-source-join\n868:(deftest lazy-published-history-and-as-of-stay-eager-and-correct\n897:(deftest lazy-published-datoms-projections-match-eager\n","exit_code":0,"status":"completed"}}
