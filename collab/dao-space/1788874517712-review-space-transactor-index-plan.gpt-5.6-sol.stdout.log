{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"open-published|close-published|fetches-only|counting-content|empty manifest|empty.*published|coordinate|manifest\\\" test/dao/space/query_test.cljc\nnl -ba test/dao/space/index_test.cljc | sed -n '560,815p'\nnl -ba test/dao/space/query_test.cljc | sed -n '540,790p'\nnl -ba src/cljc/dao/space/query.cljc | sed -n '210,285p'\"","aggregated_output":"13:            [dao.jing.coordinate :as jing-coordinate]\n275:    (testing \"a result is not a coordinate and claims no stream type\"\n542:(defn- counting-content-store\n592:   {:store scratch-store :path path :manifest-address addr\n593:    :coordinate published-index :opened opened-query-value}. The caller\n594:   closes :opened through query/close-published!, :store through\n603:                {:keys [manifest-address]}\n613:            (let [coordinate (index/published-index\n615:                               manifest-address)]\n618:               :manifest-address manifest-address,\n619:               :coordinate coordinate,\n620:               :opened (query/open-published! coordinate)}))\n682:         (finally (query/close-published! (:opened fx))\n710:      (finally (query/close-published! (:opened fx))\n715:(deftest close-published-closes-once-and-is-idempotent\n727:             (query/close-published! (:opened fx))\n729:                 \"close-published! closes the store it opened, exactly once\")\n730:             (query/close-published! (:opened fx))\n742:      (let [counter (counting-content-store (:store fx))]\n747:           :default (with-redefs [jing-coordinate/open! (fn [_]\n749:                      (let [opened (query/open-published! (:coordinate fx))\n756:                        ;; Total gets includes: 1 (manifest) + seek path to\n767:                        (query/close-published! opened)))))\n768:      (finally (query/close-published! (:opened fx))\n784:      (let [counter (counting-content-store (:store fx))]\n790:           (with-redefs [jing-coordinate/open! (fn [_] (:store counter))]\n796:             (let [opened (query/open-published! (:coordinate fx))\n803:               ;; 1 manifest + two seek paths (tree height ~5 at bf 4) +\n814:               (query/close-published! opened)))))\n815:      (finally (query/close-published! (:opened fx))\n844:        (finally (query/close-published! (:opened fx))\n863:           (finally (query/close-published! (:opened fx))\n892:      (finally (query/close-published! opened)\n922:      (finally (query/close-published! (:opened fx))\n   560\t\n   561\t\n   562\t(deftest published-index-constructor-validates-its-arguments\n   563\t  (testing \"the content-store coordinate must name a DaoJing backend type\"\n   564\t    (is (thrown-with-msg? #?(:cljs js/Error\n   565\t                             :cljd Object\n   566\t                             :default Exception)\n   567\t                          #\"DaoJing store coordinate\"\n   568\t          (index/published-index :not-a-map :segment/sha256-x))\n   569\t        \"a non-map coordinate is rejected\")\n   570\t    (is (thrown-with-msg? #?(:cljs js/Error\n   571\t                             :cljd Object\n   572\t                             :default Exception)\n   573\t                          #\"DaoJing store coordinate\"\n   574\t          (index/published-index {:no :type} :segment/sha256-x))\n   575\t        \"a coordinate without :dao.jing/type is rejected\"))\n   576\t  (testing \"the manifest address must be a content address\"\n   577\t    (is (thrown-with-msg? #?(:cljs js/Error\n   578\t                             :cljd Object\n   579\t                             :default Exception)\n   580\t                          #\"manifest content address\"\n   581\t          (index/published-index {:dao.jing/type :dao.jing/file,\n   582\t                                  :path \"x\"}\n   583\t                                 :not/a-segment)))))\n   584\t\n   585\t\n   586\t(deftest open-published-rejects-unresolvable-and-malformed-descriptors\n   587\t  (let [empty-manifest-addr (jing/segment-key\n   588\t                              {:indexes\n   589\t                               {:eavt nil, :aevt nil, :avet nil, :vaet nil},\n   590\t                               :count 0,\n   591\t                               :branching-factor 512})]\n   592\t    (testing \"an unsupported coordinate type fails closed at open\"\n   593\t      (let [d (index/published-index {:dao.jing/type :dao.jing/missing,\n   594\t                                      :path \"x\"}\n   595\t                                     empty-manifest-addr)]\n   596\t        (is (thrown-with-msg? #?(:cljs js/Error\n   597\t                                 :cljd Object\n   598\t                                 :default Exception)\n   599\t                              #\"unsupported DaoJing content-store coordinate\"\n   600\t              (ds/open! d))\n   601\t            \"the store coordinate is resolved explicitly, never inferred\")))\n   602\t    (testing \"a malformed published-index descriptor is rejected at open\"\n   603\t      (let [bogus (assoc (index/published-index {:dao.jing/type :dao.jing/file,\n   604\t                                                 :path \"x\"}\n   605\t                                                empty-manifest-addr)\n   606\t                         :extra/key :noise)]\n   607\t        (is (thrown-with-msg? #?(:cljs js/Error\n   608\t                                 :cljd Object\n   609\t                                 :default Exception)\n   610\t                              #\"invalid published-index descriptor\"\n   611\t              (ds/open! bogus)))))))\n   612\t\n   613\t\n   614\t(deftest remote-coordinate-allows-an-explicit-nil-options-entry\n   615\t  #?(:clj (with-redefs [jing-remote/connect-content!\n   616\t                        (fn [url options] {:url url, :options options})]\n   617\t            (is (= {:url \"ws://example.test/jing\", :options {}}\n   618\t                   (jing-coordinate/open! {:dao.jing/type :dao.jing/remote,\n   619\t                                           :url \"ws://example.test/jing\",\n   620\t                                           :options nil}))))\n   621\t     :default (is true \"the synchronous remote coordinate is JVM-only\")))\n   622\t\n   623\t\n   624\t(deftest open-published-rejects-missing-and-invalid-manifests\n   625\t  (let [fx (publish-into-file (datoms 8))]\n   626\t    (try (testing \"a manifest address absent from the store throws at open\"\n   627\t           (let [d (index/published-index\n   628\t                     {:dao.jing/type :dao.jing/file, :path (:path fx)}\n   629\t                     (jing/segment-key\n   630\t                       {:indexes {:eavt nil, :aevt nil, :avet nil, :vaet nil},\n   631\t                        :count 0,\n   632\t                        :branching-factor 512}))]\n   633\t             (is (thrown-with-msg? #?(:cljs js/Error\n   634\t                                      :cljd Object\n   635\t                                      :default Exception)\n   636\t                                   #\"missing index manifest\"\n   637\t                   (ds/open! d)))))\n   638\t         (testing \"a stored non-manifest value throws at open\"\n   639\t           (let [bad-addr (jing/materialize! (:store fx) {:not :a-manifest})\n   640\t                 d (index/published-index {:dao.jing/type :dao.jing/file,\n   641\t                                           :path (:path fx)}\n   642\t                                          bad-addr)]\n   643\t             (is (thrown-with-msg? #?(:cljs js/Error\n   644\t                                      :cljd Object\n   645\t                                      :default Exception)\n   646\t                                   #\"invalid index manifest\"\n   647\t                   (ds/open! d)))))\n   648\t         (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n   649\t\n   650\t\n   651\t(deftest published-realization-is-read-only-with-a-stable-lifecycle\n   652\t  (let [published-input (vec (reverse (datoms 12))) ; non-EAVT insertion\n   653\t        ;; order\n   654\t        expected-eavt (vec (sort index/eavt-cmp published-input))\n   655\t        fx (publish-into-file published-input)]\n   656\t    (try (let [published (ds/open! (:descriptor fx))]\n   657\t           (testing \"read-only: a reader and bound, never a writer\"\n   658\t             (is (satisfies? ds/IDaoStreamReader published))\n   659\t             (is (satisfies? ds/IDaoStreamBound published))\n   660\t             (is (not (satisfies? ds/IDaoStreamWriter published))))\n   661\t           (testing \"logical elements are canonical d5 in EAVT order\"\n   662\t             (is (= expected-eavt (stream-values published))))\n   663\t           (testing\n   664\t             \"closed from construction; close is idempotent and non-erasing\"\n   665\t             (is (ds/closed? published))\n   666\t             (is (= {:woke []} (ds/close! published)))\n   667\t             (is (= {:woke []} (ds/close! published)) \"close! is idempotent\")\n   668\t             (is (= expected-eavt (stream-values published))\n   669\t                 \"close does not erase retained elements\"))\n   670\t           (testing \"two cursors advance independently over one realization\"\n   671\t             (let [r1 (ds/next published {:position 0})\n   672\t                   r2 (ds/next published {:position 0})\n   673\t                   r1' (ds/next published (:cursor r1))]\n   674\t               (is (= (first expected-eavt) (:ok r1)))\n   675\t               (is (= (:ok r1) (:ok r2)) \"both cursors read position 0\")\n   676\t               (is (= (second expected-eavt) (:ok r1'))\n   677\t                   \"advancing one cursor reads the next element\"))))\n   678\t         (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n   679\t\n   680\t\n   681\t(deftest published-empty-index-drains-to-end\n   682\t  (let [fx (publish-into-file [])]\n   683\t    (try (let [published (ds/open! (:descriptor fx))]\n   684\t           (is (ds/closed? published))\n   685\t           (is (= [] (stream-values published)))\n   686\t           (is (= :end (ds/next published {:position 0}))))\n   687\t         (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n   688\t\n   689\t\n   690\t(deftest published-open-fetches-only-the-manifest\n   691\t  (let [fx (publish-into-file (datoms 64))]\n   692\t    (try\n   693\t      (let [counter (counting-content-store (:store fx))]\n   694\t        #?(:cljd\n   695\t           (is\n   696\t             true\n   697\t             \"the counting harness needs with-redefs, unavailable on ClojureDart\")\n   698\t           :default\n   699\t           (with-redefs [jing-coordinate/open! (fn [_] (:store counter))]\n   700\t             (let [published (ds/open! (:descriptor fx))]\n   701\t               (is\n   702\t                 (= 1 ((:gets counter)))\n   703\t                 \"opening a published descriptor performs exactly one content fetch: the manifest, with zero tree nodes faulted\")\n   704\t               (ds/close! published)))))\n   705\t      (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n   706\t\n   707\t\n   708\t(deftest covered-indexes-returns-the-four-covered-sets\n   709\t  (let [fx (publish-into-file (datoms 8))]\n   710\t    (try (let [published (ds/open! (:descriptor fx))]\n   711\t           (try\n   712\t             (testing \"an opened published realization carries the four sets\"\n   713\t               (let [idx (index/covered-indexes published)]\n   714\t                 (is (map? idx))\n   715\t                 (is (= #{:eavt :aevt :avet :vaet} (set (keys idx))))\n   716\t                 (doseq [order [:eavt :aevt :avet :vaet]]\n   717\t                   (is (= (count (datoms 8)) (bt/count (order idx)))\n   718\t                       (str order \" covers the snapshot\")))))\n   719\t             (testing \"nil when the realization carries no covered sets\"\n   720\t               (is (nil? (index/covered-indexes nil)))\n   721\t               (is (nil? (index/covered-indexes {})))\n   722\t               (is (nil? (index/covered-indexes :not-a-realization)))\n   723\t               (is (nil? (index/covered-indexes {:indexes :not-a-map})))\n   724\t               (is (nil? (index/covered-indexes {:indexes {:eavt 1, :aevt 2}})))\n   725\t               (is (nil? (index/covered-indexes\n   726\t                           {:indexes {:eavt 1, :aevt 2, :avet 3}}))))\n   727\t             (testing \"a structural check, never a type check\"\n   728\t               (is (= {:eavt :a, :aevt :b, :avet :c, :vaet :d}\n   729\t                      (index/covered-indexes\n   730\t                        {:indexes {:eavt :a, :aevt :b, :avet :c, :vaet :d}}))\n   731\t                   \"a plain map with the four keys passes, no instance check\"))\n   732\t             (finally (ds/close! published))))\n   733\t         (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n   734\t\n   735\t\n   736\t(deftest published-next-yields-the-same-eavt-rows-as-the-eager-walk\n   737\t  (let [datoms (vec (reverse (datoms 24))) ; non-EAVT insertion order\n   738\t        fx (publish-into-file datoms)]\n   739\t    (try\n   740\t      (let [eager (index/read-datoms (:store fx) (:manifest-address fx))\n   741\t            published (ds/open! (:descriptor fx))]\n   742\t        (try\n   743\t          (is (= eager (stream-values published))\n   744\t              \"strict-vec forces the deferred EAVT and yields the eager rows\")\n   745\t          (is (= eager\n   746\t                 (loop [cursor {:position 0}\n   747\t                        acc []]\n   748\t                   (let [r (ds/next published cursor)]\n   749\t                     (if (map? r) (recur (:cursor r) (conj acc (:ok r))) acc))))\n   750\t              \"stepwise next over the forced delay yields the eager rows\")\n   751\t          (finally (ds/close! published))))\n   752\t      (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n   753\t\n   754\t\n   755\t;; ---------------------------------------------------------------------------\n   756\t;; Observer materialization, then read / restore parity\n   757\t;; ---------------------------------------------------------------------------\n   758\t\n   759\t(deftest published-index-is-a-transportable-bounded-stream\n   760\t  (let [path (temp-content-path \"descriptor\")\n   761\t        source-datoms [[2 :work/status :done 1 1] [1 :work/status :todo 0 1]]\n   762\t        local (open-local source-datoms)\n   763\t        intake (open-intake)\n   764\t        store (jing-file/create-content-file path)]\n   765\t    (try (let [{:keys [manifest-address]} (index/publish-index! local [intake])\n   766\t               _ (loop [state (pool-state [intake])]\n   767\t                   (let [{:keys [signal state] :as r} (jing/observe-step! store\n   768\t                                                                          state)]\n   769\t                     (case signal\n   770\t                       :dao.stream/ok (recur state)\n   771\t                       (:dao.stream/blocked :dao.stream/end) nil\n   772\t                       (throw (ex-info \"test observer hit a gap or defect\" r)))))\n   773\t               descriptor (index/published-index {:dao.jing/type :dao.jing/file,\n   774\t                                                  :path path}\n   775\t                                                 manifest-address)\n   776\t               transported (edn/read-string (pr-str descriptor))\n   777\t               carrier (ds/open! {:dao.stream/type :ringbuffer})]\n   778\t           (is (= descriptor transported) \"descriptor is plain EDN\")\n   779\t           (is (ds/exact-bound? (:dao.stream/bound descriptor)))\n   780\t           (is (= :dao.space.index/eavt (:dao.stream/comparator descriptor)))\n   781\t           (ds/append! carrier transported)\n   782\t           (is (= descriptor (:ok (ds/next carrier {:position 0}))))\n   783\t           (let [published (ds/open! transported)]\n   784\t             (try (is (satisfies? ds/IDaoStreamReader published))\n   785\t                  (is (satisfies? ds/IDaoStreamBound published))\n   786\t                  (is (not (satisfies? ds/IDaoStreamWriter published)))\n   787\t                  (is (ds/closed? published))\n   788\t                  (is (= (sort index/eavt-cmp source-datoms)\n   789\t                         (stream-values published)))\n   790\t                  (finally (ds/close! published)))))\n   791\t         (finally (jing/close! store) (cleanup-file path)))))\n   792\t\n   793\t\n   794\t(deftest observer-materialization-read-restore-parity\n   795\t  (testing\n   796\t    \"a DaoJing observer materializing the intake stream makes the published\n   797\t          manifest readable: the eager walk and the lazy restore agree with\n   798\t          each other and with the source snapshot, on every covered order\"\n   799\t    (let [datoms (datoms 600)\n   800\t          local (open-local datoms)\n   801\t          intake (open-intake 1024)\n   802\t          {:keys [manifest-address manifest]}\n   803\t          (index/publish-index! local [intake] {:branching-factor 32})\n   804\t          store (materialize-through-observer [intake])\n   805\t          eager (index/read-datoms store manifest-address)\n   806\t          restored (index/restored-indexes store manifest)]\n   807\t      (is (= (count datoms) (count eager)))\n   808\t      (is (= (set datoms) (set eager)))\n   809\t      (is (= manifest (index/read-manifest store manifest-address)))\n   810\t      (doseq [order [:eavt :aevt :avet :vaet]]\n   811\t        (let [tree (order restored)]\n   812\t          (is (= (count datoms) (bt/count tree)) (str order \" count\"))\n   813\t          (is (= (set datoms) (set (bt/seq tree)))\n   814\t              (str order \" lazy restore covers the snapshot\"))\n   815\t          (is (= (set eager) (set (bt/seq tree)))\n   540\t;; ---------------------------------------------------------------------------\n   541\t\n   542\t(defn- counting-content-store\n   543\t  [store]\n   544\t  (let [gets (atom 0)\n   545\t        get-fn (:get-content-fn store)]\n   546\t    {:store (assoc store\n   547\t                   :get-content-fn (fn [address not-found]\n   548\t                                     (swap! gets inc)\n   549\t                                     (get-fn address not-found))),\n   550\t     :gets (fn [] @gets)}))\n   551\t\n   552\t\n   553\t(defn- temp-content-path\n   554\t  [prefix]\n   555\t  (str \"target/test-query-stream-\" prefix \"-\" (random-uuid) \".log\"))\n   556\t\n   557\t\n   558\t(defn- cleanup-file\n   559\t  [path]\n   560\t  #?(:clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n   561\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))\n   562\t     :cljd (try (let [f (dart-io/File path)]\n   563\t                  (when (.existsSync f) (.deleteSync f)))\n   564\t                (catch Object _ nil))))\n   565\t\n   566\t\n   567\t(defn- open-local\n   568\t  [datoms]\n   569\t  (let [s (ds/open! {:dao.stream/type :ringbuffer})]\n   570\t    (doseq [d datoms] (ds/append! s d))\n   571\t    s))\n   572\t\n   573\t\n   574\t(defn- open-intake\n   575\t  \"A dao.stream ringbuffer intake writer.\"\n   576\t  []\n   577\t  (:dao.stream/handle\n   578\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n   579\t                         :dao.stream.ringbuffer/capacity 4096})))\n   580\t\n   581\t\n   582\t(defn- pool-state\n   583\t  \"Observer state over one v2 intake handle, entered at its oldest cursor.\"\n   584\t  [s]\n   585\t  (jing/observer-state\n   586\t    [{:stream s\n   587\t      :cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))}]))\n   588\t\n   589\t\n   590\t(defn- publish-into-file\n   591\t  \"Publish datoms into a fresh file content store and return\n   592\t   {:store scratch-store :path path :manifest-address addr\n   593\t    :coordinate published-index :opened opened-query-value}. The caller\n   594\t   closes :opened through query/close-published!, :store through\n   595\t   jing/close!, and removes :path.\"\n   596\t  ([datoms] (publish-into-file datoms \"pub\"))\n   597\t  ([datoms prefix] (publish-into-file datoms prefix nil))\n   598\t  ([datoms prefix opts]\n   599\t   (let [path (temp-content-path prefix)\n   600\t         store (jing-file/create-content-file path)]\n   601\t     (try (let [local (open-local datoms)\n   602\t                intake (open-intake)\n   603\t                {:keys [manifest-address]}\n   604\t                (index/publish-index! local [intake] opts)\n   605\t                drain (fn drain\n   606\t                        [state]\n   607\t                        (let [r (jing/observe-step! store state)]\n   608\t                          (case (:signal r)\n   609\t                            :dao.stream/ok (drain (:state r))\n   610\t                            (:dao.stream/blocked :dao.stream/end) nil\n   611\t                            (throw (ex-info \"test observer hit a gap or defect\" r)))))]\n   612\t            (drain (pool-state intake))\n   613\t            (let [coordinate (index/published-index\n   614\t                               {:dao.jing/type :dao.jing/file, :path path}\n   615\t                               manifest-address)]\n   616\t              {:store store,\n   617\t               :path path,\n   618\t               :manifest-address manifest-address,\n   619\t               :coordinate coordinate,\n   620\t               :opened (query/open-published! coordinate)}))\n   621\t          (catch #?(:clj Throwable\n   622\t                    :cljs :default\n   623\t                    :cljd Object)\n   624\t                 e\n   625\t            (jing/close! store)\n   626\t            (cleanup-file path)\n   627\t            (throw e))))))\n   628\t\n   629\t\n   630\t(deftest lazy-published-point-clause-and-entity-projection-equivalence\n   631\t  (let [test-datoms\n   632\t        [[42 :user/email \"ada@example.com\" 1 1] [42 :user/name \"Ada\" 1 1]\n   633\t         [42 :user/role 100 1 1] [100 :role/name :admin 1 1]\n   634\t         [43 :user/email \"grace@example.com\" 1 1] [43 :user/name \"Grace\" 1 1]\n   635\t         ;; Add an asserted and then retracted datom (matching e a v)\n   636\t         [42 :user/status :active 1 1] [42 :user/status :active 2 0]]\n   637\t        fx (publish-into-file test-datoms)\n   638\t        eager-cur (query/current (rel test-datoms))\n   639\t        lazy-cur (query/current (:opened fx))]\n   640\t    (try (testing \"q point-clause equivalence: lazy current matches eager\"\n   641\t           (let [query-form '[:find ?v :where [$ 42 :user/email ?v]]]\n   642\t             (is (= (query/collect (query/q query-form eager-cur))\n   643\t                    (query/collect (query/q query-form lazy-cur))))\n   644\t             (is (= #{[\"ada@example.com\"]}\n   645\t                    (query/collect (query/q query-form lazy-cur))))))\n   646\t         (testing \"get-else / missing? equivalence over lazy current view\"\n   647\t           (let [q-get-else '[:find ?name :where\n   648\t                              [(get-else $ 42 :user/name \"default\") ?name]]\n   649\t                 q-get-else-missing\n   650\t                 '[:find ?val :where\n   651\t                   [(get-else $ 42 :user/nonexistent \"default\") ?val]]\n   652\t                 q-missing-false '[:find ?e :where [$ ?e :user/name _]\n   653\t                                   [(missing? $ ?e :user/name)]]\n   654\t                 q-missing-true '[:find ?e :where [$ ?e :user/name _]\n   655\t                                  [(missing? $ ?e :user/status)]]]\n   656\t             (is (= (query/collect (query/q q-get-else eager-cur))\n   657\t                    (query/collect (query/q q-get-else lazy-cur))))\n   658\t             (is (= #{[\"Ada\"]} (query/collect (query/q q-get-else lazy-cur))))\n   659\t             (is (= (query/collect (query/q q-get-else-missing eager-cur))\n   660\t                    (query/collect (query/q q-get-else-missing lazy-cur))))\n   661\t             (is (= #{[\"default\"]}\n   662\t                    (query/collect (query/q q-get-else-missing lazy-cur))))\n   663\t             (is (= (query/collect (query/q q-missing-false eager-cur))\n   664\t                    (query/collect (query/q q-missing-false lazy-cur))))\n   665\t             (is (= #{} (query/collect (query/q q-missing-false lazy-cur))))\n   666\t             (is (= (query/collect (query/q q-missing-true eager-cur))\n   667\t                    (query/collect (query/q q-missing-true lazy-cur))))\n   668\t             (is (= #{[42] [43]}\n   669\t                    (query/collect (query/q q-missing-true lazy-cur))))))\n   670\t         (testing \"pull and pull-many equivalence over lazy current view\"\n   671\t           (let [pattern [:db/id :user/email :user/name\n   672\t                          {:user/role [:db/id :role/name]}]]\n   673\t             (is (= (query/pull eager-cur 42 pattern)\n   674\t                    (query/pull lazy-cur 42 pattern)))\n   675\t             (is (= {:db/id 42,\n   676\t                     :user/email \"ada@example.com\",\n   677\t                     :user/name \"Ada\",\n   678\t                     :user/role {:db/id 100, :role/name :admin}}\n   679\t                    (query/pull lazy-cur 42 pattern)))\n   680\t             (is (= (query/pull-many eager-cur [42 43 99] pattern)\n   681\t                    (query/pull-many lazy-cur [42 43 99] pattern)))))\n   682\t         (finally (query/close-published! (:opened fx))\n   683\t                  (jing/close! (:store fx))\n   684\t                  (cleanup-file (:path fx))))))\n   685\t\n   686\t\n   687\t(deftest opened-published-index-stays-open-across-queries\n   688\t  (let [fx (publish-into-file [[42 :user/email \"ada@example.com\" 1 1]])\n   689\t        form '[:find ?v :where [$ 42 :user/email ?v]]]\n   690\t    (try\n   691\t      #?(:cljd\n   692\t         (do (is (= #{[\"ada@example.com\"]}\n   693\t                    (query/collect (query/q form (query/current (:opened fx))))))\n   694\t             (is (= #{[\"ada@example.com\"]}\n   695\t                    (query/collect (query/q form (query/current (:opened fx)))))\n   696\t                 \"the same opened index answers a second query\"))\n   697\t         :default\n   698\t         (let [closes (atom 0)\n   699\t               orig-close jing/close!]\n   700\t           (with-redefs [jing/close! (fn [handle]\n   701\t                                       (swap! closes inc)\n   702\t                                       (orig-close handle))]\n   703\t             (is (= #{[\"ada@example.com\"]}\n   704\t                    (query/collect (query/q form (query/current (:opened fx))))))\n   705\t             (is (zero? @closes)\n   706\t                 \"neither q nor collect closed the caller's store\")\n   707\t             (is (= #{[\"ada@example.com\"]}\n   708\t                    (query/collect (query/q form (query/current (:opened fx)))))\n   709\t                 \"the same opened index answers a second query after q and collect\"))))\n   710\t      (finally (query/close-published! (:opened fx))\n   711\t               (jing/close! (:store fx))\n   712\t               (cleanup-file (:path fx))))))\n   713\t\n   714\t\n   715\t(deftest close-published-closes-once-and-is-idempotent\n   716\t  (let [fx (publish-into-file [[1 :work/task \"Code\" 10 1]])]\n   717\t    (try\n   718\t      #?(:cljd\n   719\t         (is true\n   720\t             \"the close-count spy needs with-redefs, unavailable on ClojureDart; the opened-value flow is covered by the equivalence tests\")\n   721\t         :default\n   722\t         (let [closes (atom 0)\n   723\t               orig-close jing/close!]\n   724\t           (with-redefs [jing/close! (fn [handle]\n   725\t                                       (swap! closes inc)\n   726\t                                       (orig-close handle))]\n   727\t             (query/close-published! (:opened fx))\n   728\t             (is (= 1 @closes)\n   729\t                 \"close-published! closes the store it opened, exactly once\")\n   730\t             (query/close-published! (:opened fx))\n   731\t             (is (= 1 @closes)\n   732\t                 \"a second close is a no-op\"))))\n   733\t      (finally (jing/close! (:store fx))\n   734\t               (cleanup-file (:path fx))))))\n   735\t\n   736\t\n   737\t(deftest lazy-published-node-budget-is-strictly-bounded\n   738\t  (let [datoms (mapv (fn [i] [i :user/email (str \"user-\" i \"@example.com\") 0 1])\n   739\t                     (range 200))\n   740\t        fx (publish-into-file datoms)]\n   741\t    (try\n   742\t      (let [counter (counting-content-store (:store fx))]\n   743\t        #?(:cljd\n   744\t           (is\n   745\t             true\n   746\t             \"counting harness requires with-redefs, unavailable on ClojureDart\")\n   747\t           :default (with-redefs [jing-coordinate/open! (fn [_]\n   748\t                                                          (:store counter))]\n   749\t                      (let [opened (query/open-published! (:coordinate fx))\n   750\t                            query-form '[:find ?v :where [$ 42 :user/email ?v]]\n   751\t                            res (query/collect (query/q query-form\n   752\t                                                        (query/current\n   753\t                                                          opened)))\n   754\t                            total-gets ((:gets counter))]\n   755\t                        (is (= #{[\"user-42@example.com\"]} res))\n   756\t                        ;; Total gets includes: 1 (manifest) + seek path to\n   757\t                        ;; leaf + 1 (take-while bound leaf). For 200\n   758\t                        ;; elements, tree height is <= 2. Max gets <= 4.\n   759\t                        ;; Eager read-datoms would have read all node\n   760\t                        ;; blobs.\n   761\t                        (is (<= total-gets 4)\n   762\t                            (str \"lazy point query used \"\n   763\t                                 total-gets\n   764\t                                 \" gets, strictly bounded <= 4\"))\n   765\t                        (is (< total-gets 10)\n   766\t                            \"strictly fewer gets than reading full index\")\n   767\t                        (query/close-published! opened)))))\n   768\t      (finally (query/close-published! (:opened fx))\n   769\t               (jing/close! (:store fx))\n   770\t               (cleanup-file (:path fx))))))\n   771\t\n   772\t\n   773\t(deftest lazy-published-multi-clause-budget-is-strictly-bounded\n   774\t  (let [datoms (mapcat (fn [i]\n   775\t                         [[i :user/email (str \"user-\" i \"@example.com\") 0\n   776\t                           1] [i :user/age i 0 1]])\n   777\t                       (range 200))\n   778\t        ;; branching-factor 4 makes a real multi-node tree (~135 nodes for\n   779\t        ;; 400 rows), so a full drain is distinguishable from a seek path.\n   780\t        ;; At the default 512 every row fits one leaf and even a drain\n   781\t        ;; looks lazy.\n   782\t        fx (publish-into-file datoms \"pub-multi\" {:branching-factor 4})]\n   783\t    (try\n   784\t      (let [counter (counting-content-store (:store fx))]\n   785\t        #?(:cljd\n   786\t           (is\n   787\t             true\n   788\t             \"counting harness requires with-redefs, unavailable on ClojureDart\")\n   789\t           :default\n   790\t           (with-redefs [jing-coordinate/open! (fn [_] (:store counter))]\n   210\t  ([source as-of]\n   211\t   (view-value :current (db-source source) as-of)))\n   212\t\n   213\t\n   214\t(defn history\n   215\t  \"The explicit history d5 interpreter: a view value over source exposing\n   216\t   the exact logical d5 rows. An optional as-of bounds visible datoms to\n   217\t   t <= as-of.\"\n   218\t  ([source] (history source nil))\n   219\t  ([source as-of]\n   220\t   (view-value :history (db-source source) as-of)))\n   221\t\n   222\t\n   223\t;; =============================================================================\n   224\t;; Published indexes: open-published! / close-published! (Decision 1)\n   225\t;; =============================================================================\n   226\t\n   227\t(defn open-published!\n   228\t  \"Open a published covered-index coordinate — the serializable map\n   229\t   `index/published-index` builds — as a query value the caller owns: the\n   230\t   content-store handle it opens is closed by `close-published!`, never by\n   231\t   a query. Nothing is fetched beyond the manifest; the row vector stays\n   232\t   deferred behind :rows and the covered sets behind restored B-trees, so a\n   233\t   `current` view with no as-of can answer selective clauses without a\n   234\t   full drain.\"\n   235\t  [coordinate]\n   236\t  (when-not (and (map? coordinate)\n   237\t                 (= :dao.space.index/published (:dao.stream/type coordinate)))\n   238\t    (throw (ex-info \"open-published! takes a published-index coordinate\"\n   239\t                    {:coordinate coordinate})))\n   240\t  (let [{:keys [content-store manifest-address]} coordinate\n   241\t        expected (index/published-index content-store manifest-address)]\n   242\t    (when-not (= expected coordinate)\n   243\t      (throw (ex-info \"invalid published-index coordinate\"\n   244\t                      {:coordinate coordinate, :expected expected})))\n   245\t    (let [store (jing-coordinate/open! content-store)]\n   246\t      (try\n   247\t        (let [manifest (index/read-manifest store manifest-address)]\n   248\t          {:dao.space.query/published coordinate\n   249\t           :indexes (index/restored-indexes store manifest)\n   250\t           :rows (delay (index/read-datoms store manifest-address))\n   251\t           :store store\n   252\t           :close-guard (atom false)})\n   253\t        (catch #?(:cljd Object\n   254\t                  :clj Throwable\n   255\t                  :cljs :default)\n   256\t               error\n   257\t          (jing/close! store)\n   258\t          (throw error))))))\n   259\t\n   260\t\n   261\t(defn close-published!\n   262\t  \"Close the content-store handle an opened published index owns. A second\n   263\t   close is a no-op here, before the backend is even asked.\"\n   264\t  [opened]\n   265\t  (when-let [guard (:close-guard opened)]\n   266\t    (when (compare-and-set! guard false true)\n   267\t      (jing/close! (:store opened))))\n   268\t  nil)\n   269\t\n   270\t\n   271\t;; =============================================================================\n   272\t;; snapshot: the one dao.stream interpreter (Decision 3)\n   273\t;; =============================================================================\n   274\t\n   275\t(defn snapshot\n   276\t  \"Turn a dao.stream reader handle into a relation value:\n   277\t\n   278\t     {:relation <relation value>\n   279\t      :status   :ended | :blocked | :gap | :defect\n   280\t      :cursor   c            ; the cursor reached; :gap keeps the last retained\n   281\t      :recovery c'}          ; :gap only\n   282\t      :read     raw}         ; :defect only\n   283\t\n   284\t   Mints at :dao.stream/oldest and loops observe/step with a total effect\n   285\t   (conj onto the accumulator, answering ok) until the step stops. Every\n","exit_code":0,"status":"completed"}}
