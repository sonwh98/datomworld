{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/query.cljc | sed -n '1,390p' && nl -ba src/cljc/dao/stream/observe.cljc | sed -n '1,280p' && nl -ba src/cljc/dao/stream.cljc | sed -n '1,260p' && nl -ba src/cljc/dao/space/schema.cljc | sed -n '1,390p'\"","aggregated_output":"     1\t(ns dao.space.query\n     2\t  \"The reader-side index consumer (docs/design/dao.space.query.md).\n     3\t\n     4\t   An embeddable Peer over finite relations of tuples: positional `match`,\n     5\t   Datalog `q` and `pull` above them, with `current` and `history` as the\n     6\t   two explicit interpreters of canonical d5 datoms. The library is pure and\n     7\t   stateless: it owns no durable state, never writes, and enforces no\n     8\t   schema. It never opens and never closes an input — every database input\n     9\t   is a value the caller constructed:\n    10\t\n    11\t   - a relation value (`relation`, `entity-map-relation`, `fact-relation`);\n    12\t   - a datom view over a value (`current`, `history`);\n    13\t   - an opened published index (`open-published!`, released by the caller\n    14\t     through `close-published!`).\n    15\t\n    16\t   Raw vectors and raw maps are not database inputs and throw. A live\n    17\t   dao.stream handle becomes an input only through `snapshot`, the one\n    18\t   place this namespace touches v2. Source scope is interpreter context,\n    19\t   never a tuple slot.\"\n    20\t  (:require [dao.datom :as datom]\n    21\t            [dao.jing :as jing]\n    22\t            [dao.jing.coordinate :as jing-coordinate]\n    23\t            [dao.space.index :as index]\n    24\t            [dao.stream :as stream]\n    25\t            [dao.stream.observe :as observe]))\n    26\t\n    27\t\n    28\t;; =============================================================================\n    29\t;; Canonical d5 interpretation (current / history)\n    30\t;; =============================================================================\n    31\t\n    32\t(defn- flatten-datoms\n    33\t  \"Flatten one source's row elements into canonical d5 rows. An element is\n    34\t   either a canonical d5 vector `[e a v t m]` or an atomic transaction record\n    35\t   `{:dao.space/transaction {:t n :datoms [...]}}`; the record is flattened\n    36\t   into its datoms.\"\n    37\t  [elements]\n    38\t  (into\n    39\t    []\n    40\t    (mapcat\n    41\t      (fn [x]\n    42\t        (cond\n    43\t          (and (map? x) (contains? x :dao.space/transaction))\n    44\t          (let [tx (:dao.space/transaction x)\n    45\t                _ (when-not (and (map? tx)\n    46\t                                 (= #{:t :datoms} (set (keys tx)))\n    47\t                                 (integer? (:t tx))\n    48\t                                 (not (neg? (:t tx)))\n    49\t                                 (vector? (:datoms tx))\n    50\t                                 (seq (:datoms tx)))\n    51\t                    (throw (ex-info \"malformed dao.space transaction record\"\n    52\t                                    {:payload x})))\n    53\t                _ (when-not (every? #(= (:t tx) (index/datom-t %))\n    54\t                                    (:datoms tx))\n    55\t                    (throw (ex-info\n    56\t                             \"transaction record datoms carry mismatched t\"\n    57\t                             {:payload x})))]\n    58\t            (:datoms tx))\n    59\t          (and (vector? x) (= 5 (count x))) [x]\n    60\t          :else\n    61\t          (throw\n    62\t            (ex-info\n    63\t              \"canonical d5 source element must be a 5-datom vector or a transaction record\"\n    64\t              {:element x})))))\n    65\t    elements))\n    66\t\n    67\t\n    68\t(defn- bound-datoms\n    69\t  \"Bound a d5 sequence to t <= as-of when an as-of is given.\"\n    70\t  [datoms as-of]\n    71\t  (if as-of\n    72\t    (filterv #(<= (index/compare-vals (index/datom-t %) as-of) 0) datoms)\n    73\t    datoms))\n    74\t\n    75\t\n    76\t(defn current-state-seq\n    77\t  \"Takes a sequence of canonical d5 datoms and returns the sequence of\n    78\t   currently-asserted datoms. Facts are keyed by local [e a v]: the greatest\n    79\t   t wins within each key, and two rows sharing [e a v t] but differing in m\n    80\t   are conflicting transaction history and are rejected (metadata is not an\n    81\t   implicit tie-break). Retractions are removed; the result is EAVT-ordered.\"\n    82\t  [s]\n    83\t  (->> (reduce\n    84\t         (fn [acc d]\n    85\t           (let [key [(index/datom-e d) (index/datom-a d) (index/datom-v d)]]\n    86\t             (update\n    87\t               acc\n    88\t               key\n    89\t               (fn [winner]\n    90\t                 (cond (nil? winner) d\n    91\t                       (< (index/datom-t winner) (index/datom-t d)) d\n    92\t                       (> (index/datom-t winner) (index/datom-t d)) winner\n    93\t                       (not= (index/datom-m winner) (index/datom-m d))\n    94\t                       (throw\n    95\t                         (ex-info\n    96\t                           \"conflicting d5 rows: same [e a v t], different m\"\n    97\t                           {:a winner, :b d}))\n    98\t                       :else winner)))))\n    99\t         {}\n   100\t         s)\n   101\t       (vals)\n   102\t       (remove datom/retracted?)\n   103\t       (sort index/eavt-cmp)))\n   104\t\n   105\t\n   106\t(defn- d5->current-facts\n   107\t  [elements as-of]\n   108\t  (->> (bound-datoms (flatten-datoms elements) as-of)\n   109\t       current-state-seq\n   110\t       (mapv #(subvec (vec %) 0 3))))\n   111\t\n   112\t\n   113\t(defn- d5->history-rows\n   114\t  [elements as-of]\n   115\t  (mapv vec (bound-datoms (flatten-datoms elements) as-of)))\n   116\t\n   117\t\n   118\t;; =============================================================================\n   119\t;; Entity-map relation normalization (explicit d3 projection)\n   120\t;; =============================================================================\n   121\t\n   122\t(defn- entity-map->d3\n   123\t  [m]\n   124\t  (when-not (map? m)\n   125\t    (throw (ex-info \"entity-map-relation requires entity maps\" {:entity m})))\n   126\t  (when-not (contains? m :db/id)\n   127\t    (throw (ex-info \"raw entity-map source requires an explicit :db/id\"\n   128\t                    {:entity m})))\n   129\t  (let [e (:db/id m)]\n   130\t    (into [] (keep (fn [[a v]] (when (not= a :db/id) [e a v]))) m)))\n   131\t\n   132\t\n   133\t(defn- entity-maps->d3\n   134\t  [maps]\n   135\t  (into [] (mapcat entity-map->d3) maps))\n   136\t\n   137\t\n   138\t;; =============================================================================\n   139\t;; Query values: relation, view, opened published index (Decision 2)\n   140\t;; =============================================================================\n   141\t\n   142\t(defn value?\n   143\t  \"True for the query values q/match/pull take as database inputs: a\n   144\t   relation value, a datom view, or an opened published index. Raw vectors\n   145\t   and raw maps answer false.\"\n   146\t  [x]\n   147\t  (and (map? x)\n   148\t       (or (contains? x :dao.space.query/relation)\n   149\t           (contains? x :dao.space.query/view)\n   150\t           (contains? x :dao.space.query/published))))\n   151\t\n   152\t\n   153\t(defn relation\n   154\t  \"An in-memory relation value. Its retained contents are an arbitrary,\n   155\t   mixed-dimensional tuple collection; arity never selects an\n   156\t   interpretation. This is the replacement for the direct raw-vector input.\n   157\t\n   158\t   The vestigial `:dao.stream/type` key is carried so dao.space.schema's\n   159\t   descriptor validation and nested-view check classify the value without\n   160\t   reaching into query's own tags.\"\n   161\t  [tuples]\n   162\t  {:dao.stream/type :dao.space.query/relation\n   163\t   :dao.space.query/relation (vec tuples)})\n   164\t\n   165\t\n   166\t(defn entity-map-relation\n   167\t  \"An entity-map relation value: a bounded relation of entity maps,\n   168\t   projected explicitly to [e a v] facts on the read side. The read side is\n   169\t   pure and never mints an entity id, so every map must carry :db/id.\"\n   170\t  [maps]\n   171\t  ;; Normalize at the explicit constructor boundary. The resulting value is\n   172\t  ;; the same generic relation value q consumes; no second transport type\n   173\t  ;; or opening path is needed merely because the input syntax was maps.\n   174\t  (relation (entity-maps->d3 maps)))\n   175\t\n   176\t\n   177\t(defn fact-relation\n   178\t  \"The explicit current-fact relation: d3 rows that are already\n   179\t   current-state facts, so the fact index is built for them without a d5\n   180\t   pass. dao.space.schema builds these directly.\"\n   181\t  [tuples]\n   182\t  (assoc (relation tuples) :fact? true))\n   183\t\n   184\t\n   185\t(defn- snapshot-value?\n   186\t  [x]\n   187\t  (and (map? x) (contains? x :relation) (contains? x :status)))\n   188\t\n   189\t\n   190\t(defn- legacy-v1-realization?\n   191\t  \"An opaque host object that is not data: a v1 reader realization still\n   192\t   handed over by dao.space.schema's test surface. Defrecords are maps and\n   193\t   are drained by their owners (schema's interpret-view drains before\n   194\t   calling here), so only deftype-shaped realizations take this path.\"\n   195\t  [x]\n   196\t  (not (or (nil? x) (boolean? x) (number? x) (string? x) (keyword? x)\n   197\t           (symbol? x) (char? x) (seq? x) (set? x) (map? x) (vector? x)\n   198\t           (fn? x))))\n   199\t\n   200\t\n   201\t(defn- db-source\n   202\t  \"Normalize a current/history source. Query values and snapshots pass\n   203\t   through (a snapshot contributes its relation); raw maps and vectors\n   204\t   throw.\"\n   205\t  [source]\n   206\t  (cond\n   207\t    (value? source) source\n   208\t    (snapshot-value? source) (:relation source)\n   209\t    :else\n   210\t    (throw (ex-info \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   211\t                    {:input source}))))\n   212\t\n   213\t\n   214\t(defn- view-value\n   215\t  [kind source as-of]\n   216\t  (cond-> {:dao.stream/type (case kind\n   217\t                             :current :dao.space/current\n   218\t                             :history :dao.space/history),\n   219\t           :dao.space.query/view kind,\n   220\t           :source source}\n   221\t    (some? as-of) (assoc :as-of as-of)))\n   222\t\n   223\t\n   224\t(defn current\n   225\t  \"The explicit current d5 interpreter: a view value over source. Resolves\n   226\t   the greatest t per [e a v], removes retractions, and rejects conflicting\n   227\t   [e a v t] rows with differing m. An optional as-of bounds visible datoms\n   228\t   to t <= as-of.\n   229\t\n   230\t   A legacy v1 realization (an opaque host object) is drained eagerly and\n   231\t   resolved at call time — reading is non-destructive and the handle is\n   232\t   never closed — returning a fact relation of the current d3 facts.\"\n   233\t  ([source] (current source nil))\n   234\t  ([source as-of]\n   235\t   (if (legacy-v1-realization? source)\n   236\t     (fact-relation (d5->current-facts (index/snapshot-datoms source) as-of))\n   237\t     (view-value :current (db-source source) as-of))))\n   238\t\n   239\t\n   240\t(defn history\n   241\t  \"The explicit history d5 interpreter: a view value over source exposing\n   242\t   the exact logical d5 rows. An optional as-of bounds visible datoms to\n   243\t   t <= as-of. A legacy v1 realization is drained eagerly into a d5\n   244\t   relation value.\"\n   245\t  ([source] (history source nil))\n   246\t  ([source as-of]\n   247\t   (if (legacy-v1-realization? source)\n   248\t     (relation (d5->history-rows (index/snapshot-datoms source) as-of))\n   249\t     (view-value :history (db-source source) as-of))))\n   250\t\n   251\t\n   252\t;; =============================================================================\n   253\t;; Published indexes: open-published! / close-published! (Decision 1)\n   254\t;; =============================================================================\n   255\t\n   256\t(defn open-published!\n   257\t  \"Open a published covered-index coordinate — the serializable map\n   258\t   `index/published-index` builds — as a query value the caller owns: the\n   259\t   content-store handle it opens is closed by `close-published!`, never by\n   260\t   a query. Nothing is fetched beyond the manifest; the row vector stays\n   261\t   deferred behind :rows and the covered sets behind restored B-trees, so a\n   262\t   `current` view with no as-of can answer selective clauses without a\n   263\t   full drain.\"\n   264\t  [coordinate]\n   265\t  (when-not (and (map? coordinate)\n   266\t                 (= :dao.space.index/published (:dao.stream/type coordinate)))\n   267\t    (throw (ex-info \"open-published! takes a published-index coordinate\"\n   268\t                    {:coordinate coordinate})))\n   269\t  (let [{:keys [content-store manifest-address]} coordinate\n   270\t        expected (index/published-index content-store manifest-address)]\n   271\t    (when-not (= expected coordinate)\n   272\t      (throw (ex-info \"invalid published-index coordinate\"\n   273\t                      {:coordinate coordinate, :expected expected})))\n   274\t    (let [store (jing-coordinate/open! content-store)]\n   275\t      (try\n   276\t        (let [manifest (index/read-manifest store manifest-address)]\n   277\t          {:dao.space.query/published coordinate\n   278\t           :indexes (index/restored-indexes store manifest)\n   279\t           :rows (delay (index/read-datoms store manifest-address))\n   280\t           :store store\n   281\t           :close-guard (atom false)})\n   282\t        (catch #?(:cljd Object\n   283\t                  :clj Throwable\n   284\t                  :cljs :default)\n   285\t               error\n   286\t          (jing/close! store)\n   287\t          (throw error))))))\n   288\t\n   289\t\n   290\t(defn close-published!\n   291\t  \"Close the content-store handle an opened published index owns. A second\n   292\t   close is a no-op here, before the backend is even asked.\"\n   293\t  [opened]\n   294\t  (when-let [guard (:close-guard opened)]\n   295\t    (when (compare-and-set! guard false true)\n   296\t      (jing/close! (:store opened))))\n   297\t  nil)\n   298\t\n   299\t\n   300\t;; =============================================================================\n   301\t;; snapshot: the one dao.stream interpreter (Decision 3)\n   302\t;; =============================================================================\n   303\t\n   304\t(defn snapshot\n   305\t  \"Turn a dao.stream reader handle into a relation value:\n   306\t\n   307\t     {:relation <relation value>\n   308\t      :status   :ended | :blocked | :gap | :defect\n   309\t      :cursor   c            ; the cursor reached; :gap keeps the last retained\n   310\t      :recovery c'}          ; :gap only\n   311\t      :read     raw}         ; :defect only\n   312\t\n   313\t   Mints at :dao.stream/oldest and loops observe/step with a total effect\n   314\t   (conj onto the accumulator, answering ok) until the step stops. Every\n   315\t   stopping outcome is data: :blocked is an open stream caught up (a\n   316\t   snapshot at call time), :gap carries the values read before the hole and\n   317\t   the recovery cursor, :defect the raw answer. The caller decides whether a\n   318\t   partial snapshot is a usable relation. The handle is never closed, and a\n   319\t   cursor never advances past a value the accumulator did not retain (the\n   320\t   step's effect-before-commit).\"\n   321\t  [handle]\n   322\t  (let [mint (stream/cursor handle :dao.stream/oldest)]\n   323\t    (if-not (= :dao.stream/ok (:dao.stream/outcome mint))\n   324\t      {:relation (relation [])\n   325\t       :status :defect\n   326\t       :cursor nil\n   327\t       :read mint}\n   328\t      (loop [cursor (:dao.stream/cursor mint), values []]\n   329\t        (let [acc (volatile! values)\n   330\t              step (observe/step handle cursor\n   331\t                                 (fn [value]\n   332\t                                   (vswap! acc conj value)\n   333\t                                   {:dao.stream/outcome :dao.stream/ok}))]\n   334\t          (case (:status step)\n   335\t            :advance (recur (:cursor step) @acc)\n   336\t            :retry {:relation (relation @acc)\n   337\t                    :status :blocked\n   338\t                    :cursor cursor}\n   339\t            :ended {:relation (relation @acc)\n   340\t                    :status :ended\n   341\t                    :cursor cursor}\n   342\t            :gap {:relation (relation @acc)\n   343\t                  :status :gap\n   344\t                  :cursor cursor\n   345\t                  :recovery (:recovery step)}\n   346\t            ;; :defect, and :failed (impossible for this total effect,\n   347\t            ;; classified the same way if a composition ever produces it)\n   348\t            {:relation (relation @acc)\n   349\t             :status :defect\n   350\t             :cursor cursor\n   351\t             :read (:read step)}))))))\n   352\t\n   353\t\n   354\t;; =============================================================================\n   355\t;; Realize a db-value: value tag -> {::relation ::fact-index ::indexes}\n   356\t;; =============================================================================\n   357\t\n   358\t(defn- relation->fact-index\n   359\t  [relation]\n   360\t  (index/index-datoms (mapv (fn [tuple]\n   361\t                              [(nth tuple 0) (nth tuple 1)\n   362\t                               (nth tuple 2) 0 datom/default-op])\n   363\t                            relation)))\n   364\t\n   365\t\n   366\t(defn- force-relation\n   367\t  \"Force a relation if it is delayed (e.g. from a lazy covered-index\n   368\t   realization) or return it directly. Memoization belongs to the delay:\n   369\t   forcing is therefore at most one walk, but this function itself neither\n   370\t   creates nor guarantees non-nilness.\"\n   371\t  [relation]\n   372\t  (if (delay? relation) @relation relation))\n   373\t\n   374\t\n   375\t(declare realize-db-value!)\n   376\t\n   377\t\n   378\t(defn- realize-datom-view\n   379\t  \"Interpret a current/history view inside the query layer. The nested\n   380\t   source is another query value; a current view with no as-of over an\n   381\t   opened published index routes through the restored covered sets, every\n   382\t   other combination resolves the source's rows.\"\n   383\t  [d]\n   384\t  (let [kind (:dao.space.query/view d)\n   385\t        as-of (:as-of d)\n   386\t        {src-relation ::relation, src-indexes ::indexes}\n   387\t        (realize-db-value! (:source d))]\n   388\t    (if (and (= :current kind) (nil? as-of) src-indexes)\n   389\t      {::relation (delay (d5->current-facts (force-relation src-relation) nil)),\n   390\t       ::fact-index src-indexes}\n     1\t(ns dao.stream.observe\n     2\t  \"One observation step over a DaoStream reader: read a value, act on it, and\n     3\t   advance the cursor only if the act succeeded.\n     4\t\n     5\t   `step` owns no scheduler, loop, state, callback or policy.  It classifies\n     6\t   every outcome the contract declares as data and hands the caller what it\n     7\t   needs to decide: the successor cursor on progress, the recovery cursor on a\n     8\t   gap, the raw answer on a defect.  What to do about a gap, whether a defect\n     9\t   is fatal, how many values to take per turn, and what state to carry between\n    10\t   turns all belong to the caller.\n    11\t\n    12\t   The cursor advances in exactly one place -- after the effect has answered\n    13\t   `ok` -- so effect-before-commit is a property of this seam rather than a\n    14\t   rule each caller keeps.  An effect that throws propagates before any\n    15\t   successor exists, which gives a throwing effect the same guarantee for\n    16\t   free.\n    17\t\n    18\t   Callers are `dao.stream.forward` (effect: append to another stream),\n    19\t   `yin.vm.stream-observer` (effect: load a program into a VM) and\n    20\t   `dao.jing` (effect: materialize content).  Each adds its own loop and its\n    21\t   own policy above this step.\n    22\t\n    23\t   The law every interpreter here obeys is that an element's cursor advances\n    24\t   exactly when its disposition has been durably recorded.  This step serves\n    25\t   the interpreters whose disposition is an external, refusable effect -- an\n    26\t   append, a load, a materialization -- where that means advancing only after\n    27\t   the effect answered ok.  Interpreters whose disposition is a local, total\n    28\t   state transition keep their own read loops: `dao.stream.rpc/poll!`,\n    29\t   `dao.stream.apply/serve-once!` and `dao.runtime`'s wait set thread\n    30\t   whole caller state under a budget with terminal short-circuits, and for\n    31\t   them advancing first and advancing after the commit are the same fact,\n    32\t   because no window exists in which one happened and the other did not.\n    33\t   `serve-once!` is the proof that this is one law and not two families: it\n    34\t   advances after delivery for a correlatable request, on the diagnostic for\n    35\t   an uncorrelatable one, and on terminal loss for an undeliverable response.\n    36\t\n    37\t   There is no ordering parameter here and none is needed.  A consumer that\n    38\t   wants an element consumed even when its interpretation is defective writes\n    39\t   a *total* effect -- one that classifies every element as data and so always\n    40\t   answers ok -- and gets consume-exactly-once through this same step.\"\n    41\t  (:require [dao.stream :as stream]))\n    42\t\n    43\t\n    44\t(defn- valid-or-transport-error\n    45\t  \"Fold a defective host answer into the contract's outcome algebra.\n    46\t\n    47\t   A conforming operation already returns one of the contract outcomes; this\n    48\t   keeps the step's branch total when a composition supplies a bad handle or\n    49\t   an effect answers with something that is not an outcome map.\"\n    50\t  [operation result]\n    51\t  (if (stream/valid-outcome? operation result)\n    52\t    result\n    53\t    {:dao.stream/outcome :dao.stream/transport-error\n    54\t     :dao.stream/error :dao.stream/invalid-operation-result\n    55\t     :dao.stream/answer result}))\n    56\t\n    57\t\n    58\t(defn step\n    59\t  \"Read one value from `source` at `cursor` and run `effect` on it.\n    60\t\n    61\t   `effect` is `(fn [value] -> outcome-map)` answering with the writer outcome\n    62\t   set: `ok`, `full` (\\\"not yet\\\"), `invalid-value`, `closed`, or\n    63\t   `transport-error`.  Any other answer is classified as `transport-error`\n    64\t   with the raw answer retained.  An effect that throws propagates.\n    65\t\n    66\t   Returns a map carrying `:cursor` and `:read` (the raw read answer) in every\n    67\t   case:\n    68\t\n    69\t   | status     | when                                    | cursor    | also         |\n    70\t   | ---------- | --------------------------------------- | --------- | ------------ |\n    71\t   | `:advance` | read ok, effect ok                      | successor | `:effect`    |\n    72\t   | `:retry`   | read blocked, or effect full            | unchanged | `:outcome`   |\n    73\t   | `:ended`   | read end                                | unchanged | `:outcome`   |\n    74\t   | `:gap`     | read gap                                | unchanged | `:recovery`  |\n    75\t   | `:defect`  | read cursor-mismatch, invalid-cursor,\n    76\t                  transport-error, or malformed                | unchanged | `:outcome`   |\n    77\t   | `:failed`  | effect invalid-value, closed,\n    78\t                  transport-error, or malformed                | unchanged | `:outcome`, `:effect` |\n    79\t\n    80\t   A `:retry` from the effect also carries `:effect`.  The cursor is the\n    81\t   successor on `:advance` and unchanged on every other status.\"\n    82\t  [source cursor effect]\n    83\t  (let [read-result (valid-or-transport-error :next (stream/next source cursor))\n    84\t        read-outcome (:dao.stream/outcome read-result)]\n    85\t    (case read-outcome\n    86\t      :dao.stream/ok\n    87\t      (let [effect-result (valid-or-transport-error\n    88\t                            :append!\n    89\t                            (effect (:dao.stream/value read-result)))\n    90\t            effect-outcome (:dao.stream/outcome effect-result)]\n    91\t        (case effect-outcome\n    92\t          :dao.stream/ok {:status :advance\n    93\t                          :cursor (:dao.stream/cursor read-result)\n    94\t                          :read read-result\n    95\t                          :effect effect-result}\n    96\t          :dao.stream/full {:status :retry\n    97\t                            :cursor cursor\n    98\t                            :outcome effect-outcome\n    99\t                            :read read-result\n   100\t                            :effect effect-result}\n   101\t          {:status :failed\n   102\t           :cursor cursor\n   103\t           :outcome effect-outcome\n   104\t           :read read-result\n   105\t           :effect effect-result}))\n   106\t\n   107\t      :dao.stream/blocked {:status :retry\n   108\t                           :cursor cursor\n   109\t                           :outcome read-outcome\n   110\t                           :read read-result}\n   111\t\n   112\t      :dao.stream/end {:status :ended\n   113\t                       :cursor cursor\n   114\t                       :outcome read-outcome\n   115\t                       :read read-result}\n   116\t\n   117\t      :dao.stream/gap {:status :gap\n   118\t                       :cursor cursor\n   119\t                       :outcome read-outcome\n   120\t                       :recovery (:dao.stream/cursor read-result)\n   121\t                       :read read-result}\n   122\t\n   123\t      {:status :defect\n   124\t       :cursor cursor\n   125\t       :outcome read-outcome\n   126\t       :read read-result})))\n     1\t(ns dao.stream\n     2\t  \"DaoStream v2: passive substrate for IO in datom.world.\n     3\t\n     4\t   Seven operations:\n     5\t     Five handle operations (protocols implemented per declared surface):\n     6\t       descriptor (universal reachability and identity projection)\n     7\t       cursor     (reader surface)\n     8\t       next       (reader surface)\n     9\t       append!    (writer surface)\n    10\t       close!     (closable surface)\n    11\t     Two transport entry functions (per-transport, host-composed):\n    12\t       create!    (creates a new logical stream from a creation specification)\n    13\t       attach!    (attaches to an existing stream via portable descriptor)\n    14\t\n    15\t   Result Convention:\n    16\t     Every operation returns an open outcome map keyed by :dao.stream/outcome.\n    17\t     All qualified keywords live under :dao.stream/…\n    18\t     Each operation has an exhaustive, closed outcome set.\"\n    19\t  (:refer-clojure :exclude [next]))\n    20\t\n    21\t\n    22\t;; =============================================================================\n    23\t;; The Seven Operations and Standard Keywords\n    24\t;; =============================================================================\n    25\t\n    26\t(def operations\n    27\t  \"The seven DaoStream v2 operations.\"\n    28\t  #{:create! :attach! :descriptor :cursor :next :append! :close!})\n    29\t\n    30\t\n    31\t(def surfaces\n    32\t  \"The public operational surfaces a handle may declare.\"\n    33\t  #{:reader :writer :closable})\n    34\t\n    35\t\n    36\t;; Anchors\n    37\t(def anchor-oldest\n    38\t  \"Earliest retained position on the stream.\"\n    39\t  :dao.stream/oldest)\n    40\t\n    41\t\n    42\t(def anchor-newest\n    43\t  \"Positioned after the newest appended value (observes next arrival).\"\n    44\t  :dao.stream/newest)\n    45\t\n    46\t\n    47\t(def standard-anchors\n    48\t  \"Contract-defined anchor keywords.\"\n    49\t  #{anchor-oldest anchor-newest})\n    50\t\n    51\t\n    52\t;; Closed outcome sets per operation (contract exhaustive tables)\n    53\t(def outcomes-create\n    54\t  #{:dao.stream/ok\n    55\t    :dao.stream/invalid-spec\n    56\t    :dao.stream/not-found\n    57\t    :dao.stream/transport-error})\n    58\t\n    59\t\n    60\t(def outcomes-attach\n    61\t  #{:dao.stream/ok\n    62\t    :dao.stream/invalid-descriptor\n    63\t    :dao.stream/not-found\n    64\t    :dao.stream/transport-error})\n    65\t\n    66\t\n    67\t(def outcomes-descriptor\n    68\t  #{:dao.stream/ok})\n    69\t\n    70\t\n    71\t(def outcomes-cursor\n    72\t  #{:dao.stream/ok\n    73\t    :dao.stream/invalid-anchor\n    74\t    :dao.stream/closed\n    75\t    :dao.stream/transport-error})\n    76\t\n    77\t\n    78\t(def outcomes-next\n    79\t  #{:dao.stream/ok\n    80\t    :dao.stream/blocked\n    81\t    :dao.stream/end\n    82\t    :dao.stream/gap\n    83\t    :dao.stream/cursor-mismatch\n    84\t    :dao.stream/invalid-cursor\n    85\t    :dao.stream/transport-error})\n    86\t\n    87\t\n    88\t(def outcomes-append\n    89\t  #{:dao.stream/ok\n    90\t    :dao.stream/full\n    91\t    :dao.stream/invalid-value\n    92\t    :dao.stream/closed\n    93\t    :dao.stream/transport-error})\n    94\t\n    95\t\n    96\t(def outcomes-close\n    97\t  #{:dao.stream/ok})\n    98\t\n    99\t\n   100\t(def operation-outcomes\n   101\t  \"Map of operation keyword to its closed outcome set.\"\n   102\t  {:create! outcomes-create\n   103\t   :attach! outcomes-attach\n   104\t   :descriptor outcomes-descriptor\n   105\t   :cursor outcomes-cursor\n   106\t   :next outcomes-next\n   107\t   :append! outcomes-append\n   108\t   :close! outcomes-close})\n   109\t\n   110\t\n   111\t(def outcome-required-keys\n   112\t  \"Map from [operation outcome] to required keys in the result map.\"\n   113\t  {[:create! :dao.stream/ok] #{:dao.stream/handle}\n   114\t   [:attach! :dao.stream/ok] #{:dao.stream/handle}\n   115\t   [:descriptor :dao.stream/ok] #{:dao.stream/descriptor :dao.stream/identity}\n   116\t   [:cursor :dao.stream/ok] #{:dao.stream/cursor}\n   117\t   [:next :dao.stream/ok] #{:dao.stream/value :dao.stream/cursor}\n   118\t   [:next :dao.stream/gap] #{:dao.stream/cursor}})\n   119\t\n   120\t\n   121\t;; =============================================================================\n   122\t;; Canonical Operation Resolution Helper\n   123\t;; =============================================================================\n   124\t\n   125\t(defn canonical-op\n   126\t  \"Normalizes op to canonical keyword (:create!, :attach!, :descriptor,\n   127\t   :cursor, :next, :append!, :close!). Supports aliases without '!'.\"\n   128\t  [op]\n   129\t  (case op\n   130\t    (:create :create!) :create!\n   131\t    (:attach :attach!) :attach!\n   132\t    (:descriptor) :descriptor\n   133\t    (:cursor) :cursor\n   134\t    (:next) :next\n   135\t    (:append :append!) :append!\n   136\t    (:close :close!) :close!\n   137\t    nil))\n   138\t\n   139\t\n   140\t;; =============================================================================\n   141\t;; Handle Protocols (Five Handle Operations)\n   142\t;; =============================================================================\n   143\t\n   144\t(defprotocol IDaoStreamDescriptor\n   145\t  \"Universal reachability and identity projection. Belongs to no surface:\n   146\t   implemented by every handle regardless of declared reader/writer/closable surfaces.\"\n   147\t\n   148\t  (descriptor\n   149\t    [handle]\n   150\t    \"Returns descriptor outcome map:\n   151\t     {:dao.stream/outcome :dao.stream/ok\n   152\t      :dao.stream/descriptor <portable-descriptor>\n   153\t      :dao.stream/identity <logical-stream-identity>}\"))\n   154\t\n   155\t\n   156\t(defprotocol IDaoStreamReader\n   157\t  \"Reader surface: positioned, non-destructive observation via immutable cursors.\"\n   158\t\n   159\t  (cursor\n   160\t    [handle anchor]\n   161\t    \"Mint an immutable cursor from anchor (:dao.stream/oldest, :dao.stream/newest,\n   162\t     or transport-specific anchor).\n   163\t     Returns outcome map with :dao.stream/cursor on :dao.stream/ok.\")\n   164\t\n   165\t  (next\n   166\t    [handle cursor]\n   167\t    \"Read the value at cursor position. Total and non-blocking.\n   168\t     Returns read outcome map.\"))\n   169\t\n   170\t\n   171\t(defprotocol IDaoStreamWriter\n   172\t  \"Writer surface: append values to the sequence this handle's writer surface is on.\"\n   173\t\n   174\t  (append!\n   175\t    [handle val]\n   176\t    \"Append val to the sequence. Total and non-blocking.\n   177\t     Returns write outcome map.\"))\n   178\t\n   179\t\n   180\t(defprotocol IDaoStreamClosable\n   181\t  \"Closable surface: close what this handle is on (logical stream or attachment).\n   182\t   Idempotent.\"\n   183\t\n   184\t  (close!\n   185\t    [handle]\n   186\t    \"Closes what this handle is on. Irrevocable.\n   187\t     Returns outcome map {:dao.stream/outcome :dao.stream/ok}.\"))\n   188\t\n   189\t\n   190\t;; =============================================================================\n   191\t;; Surface Inspection & Gating\n   192\t;; =============================================================================\n   193\t\n   194\t(defn reader?\n   195\t  \"True if handle implements the reader surface (IDaoStreamReader).\"\n   196\t  [handle]\n   197\t  (satisfies? IDaoStreamReader handle))\n   198\t\n   199\t\n   200\t(defn writer?\n   201\t  \"True if handle implements the writer surface (IDaoStreamWriter).\"\n   202\t  [handle]\n   203\t  (satisfies? IDaoStreamWriter handle))\n   204\t\n   205\t\n   206\t(defn closable?\n   207\t  \"True if handle implements the closable surface (IDaoStreamClosable).\"\n   208\t  [handle]\n   209\t  (satisfies? IDaoStreamClosable handle))\n   210\t\n   211\t\n   212\t(defn descriptor?\n   213\t  \"True if handle implements IDaoStreamDescriptor.\"\n   214\t  [handle]\n   215\t  (satisfies? IDaoStreamDescriptor handle))\n   216\t\n   217\t\n   218\t(defn declared-surfaces\n   219\t  \"Returns set of public surfaces implemented by handle:\n   220\t   subset of #{:reader :writer :closable}.\"\n   221\t  [handle]\n   222\t  (cond-> #{}\n   223\t    (reader? handle) (conj :reader)\n   224\t    (writer? handle) (conj :writer)\n   225\t    (closable? handle) (conj :closable)))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; Result Convention & Envelope Validation\n   230\t;; =============================================================================\n   231\t\n   232\t(defn qualified-keyword?*\n   233\t  \"True if x is a qualified keyword. Portable across CLJ, CLJS, CLJD.\"\n   234\t  [x]\n   235\t  (boolean (and (keyword? x) (namespace x))))\n   236\t\n   237\t\n   238\t(defn outcome-map?\n   239\t  \"True if x is an open outcome map with a qualified keyword under :dao.stream/outcome.\"\n   240\t  [x]\n   241\t  (and (map? x)\n   242\t       (qualified-keyword?* (:dao.stream/outcome x))))\n   243\t\n   244\t\n   245\t(defn validate-outcome\n   246\t  \"Validates an operation outcome against contract requirements.\n   247\t   Returns nil if valid, or a failure map describing the defect if invalid.\"\n   248\t  [op result]\n   249\t  (if-let [canon-op (canonical-op op)]\n   250\t    (cond\n   251\t      (not (outcome-map? result))\n   252\t      {:valid? false :error :invalid-outcome-map :operation canon-op :result result}\n   253\t\n   254\t      :else\n   255\t      (let [outcome (:dao.stream/outcome result)\n   256\t            allowed (get operation-outcomes canon-op)]\n   257\t        (cond\n   258\t          (not (contains? allowed outcome))\n   259\t          {:valid? false\n   260\t           :error :unauthorized-outcome\n     1\t(ns dao.space.schema\n     2\t  \"Schema representation and extraction over the tuple space\n     3\t   (docs/design/dao.space.schema.md).\n     4\t\n     5\t   The schema lives in the medium it describes: schema rows are ordinary\n     6\t   d5 tuples distinguished by the fixed :db/* attribute vocabulary. This\n     7\t   namespace provides the axiom definitions (the single source of truth for\n     8\t   the five interpreter properties), the bootstrap transaction data, the\n     9\t   value-type predicates, the extraction function that reads schema from a\n    10\t   d5 source through the public q surface, the resolve-props seam used\n    11\t   by the view and wrapper, the validating write wrapper, and the\n    12\t   publisher (publish!, published, :dao.space.schema/published opener).\"\n    13\t  (:require [dao.datom :as datom]\n    14\t            [dao.jing :as jing]\n    15\t            [dao.space.index :as index]\n    16\t            [dao.space.query :as query]\n    17\t            [dao.space.transactor :as tx]\n    18\t            [dao.stream :as ds])\n    19\t  #?(:cljs (:require-macros [dao.stream])))\n    20\t\n    21\t\n    22\t;; =============================================================================\n    23\t;; Axioms: the five property idents and their fixed property maps\n    24\t;; =============================================================================\n    25\t\n    26\t(def axioms\n    27\t  \"The axiom property map: each of the five :db/* property idents maps to\n    28\t   its fixed property map. This is the single source of truth for the\n    29\t   interpreter axioms. All five are card-one; :db/ident is unique;\n    30\t   :db/unique and :db/index are booleans. Rows describing :db/* attributes\n    31\t   themselves resolve from this map regardless of what the stream says\n    32\t   (resolve-props).\"\n    33\t  {:db/ident     {:db/valueType :db.type/keyword\n    34\t                  :db/cardinality :db.cardinality/one\n    35\t                  :db/unique true}\n    36\t   :db/valueType  {:db/valueType :db.type/keyword\n    37\t                   :db/cardinality :db.cardinality/one}\n    38\t   :db/cardinality {:db/valueType :db.type/keyword\n    39\t                    :db/cardinality :db.cardinality/one}\n    40\t   :db/unique     {:db/valueType :db.type/boolean\n    41\t                   :db/cardinality :db.cardinality/one}\n    42\t   :db/index      {:db/valueType :db.type/boolean\n    43\t                   :db/cardinality :db.cardinality/one}})\n    44\t\n    45\t\n    46\t;; =============================================================================\n    47\t;; Bootstrap: genesis tx-data from the axioms\n    48\t;; =============================================================================\n    49\t\n    50\t(defn- entity-id-for\n    51\t  \"Return the conventional genesis entity id for a :db/* property ident.\n    52\t   16 :db/ident, 17 :db/valueType, 18 :db/cardinality, 19 :db/unique,\n    53\t   20 :db/index.\"\n    54\t  [ident]\n    55\t  ({:db/ident datom/first-user-id\n    56\t    :db/valueType 17\n    57\t    :db/cardinality 18\n    58\t    :db/unique 19\n    59\t    :db/index 20}\n    60\t   ident))\n    61\t\n    62\t\n    63\t(defn bootstrap\n    64\t  \"Return tx-data: one flat vector of [:db/add e a v] triples for the\n    65\t   bootstrap. Each entity gets its :db/ident row first, then property\n    66\t   triples. Entity ids by convention: 16 :db/ident, 17 :db/valueType,\n    67\t   18 :db/cardinality, 19 :db/unique, 20 :db/index.\"\n    68\t  []\n    69\t  (into []\n    70\t        (mapcat (fn [[ident props]]\n    71\t                  (let [eid (entity-id-for ident)]\n    72\t                    (cons [:db/add eid :db/ident ident]\n    73\t                          (map (fn [[a v]] [:db/add eid a v]) props)))))\n    74\t        axioms))\n    75\t\n    76\t\n    77\t;; =============================================================================\n    78\t;; Type predicates: :db.type/* -> cross-platform value predicates\n    79\t;; =============================================================================\n    80\t\n    81\t(defn- non-integral?\n    82\t  \"True when x is a number but not an integer (e.g. a double). Used\n    83\t   cross-platform to identify :db.type/double values.\"\n    84\t  [x]\n    85\t  (and (number? x) (not (integer? x))))\n    86\t\n    87\t\n    88\t(def type-pred\n    89\t  \"Map from :db.type/* keywords to predicates that validate values\n    90\t   identically on JVM Clojure and ClojureScript.\n    91\t\n    92\t   :db.type/string  - string? (core predicate, identical on both hosts)\n    93\t   :db.type/keyword - keyword? (core predicate, identical on both hosts)\n    94\t   :db.type/boolean - boolean? (core predicate, identical on both hosts)\n    95\t   :db.type/long    - int? (core predicate, identical on all hosts)\n    96\t   :db.type/double  - number? but not integer? (cross-platform via non-integral?)\n    97\t   :db.type/ref     - non-negative integer (entity id); int? and (not neg?)\"\n    98\t  {:db.type/string  string?\n    99\t   :db.type/keyword keyword?\n   100\t   :db.type/boolean boolean?\n   101\t   :db.type/long    int?\n   102\t   :db.type/double  non-integral?\n   103\t   :db.type/ref     #(and (int? %) (not (neg? %)))})\n   104\t\n   105\t\n   106\t;; =============================================================================\n   107\t;; Extraction: read schema from d5 rows through the public q surface\n   108\t;; =============================================================================\n   109\t\n   110\t(defn- property?\n   111\t  \"True when ident is one of the five :db/* property idents.\"\n   112\t  [ident]\n   113\t  (contains? axioms ident))\n   114\t\n   115\t\n   116\t(defn extract-schema\n   117\t  \"Pure function: extract the live schema from canonical d5 rows. Rows are\n   118\t   [e a v t m] vectors, already as-of-bounded by the caller. Fetches\n   119\t   through the public q surface over the history view, then applies the\n   120\t   private fold: current-state semantics per [se p v], name entities by\n   121\t   live :db/ident, collapse per [entity property] (greatest t, tie under\n   122\t   index/compare-vals). Returns {ident property-map} of live,\n   123\t   declared properties. Includes :db/* entities if present but does not\n   124\t   synthesize them. Throws on unknown :db.type and on conflicting\n   125\t   same-[se p v t]-different-m rows.\"\n   126\t  [d5-rows]\n   127\t  (let [source (query/relation d5-rows)\n   128\t        view   (query/history source)\n   129\t        ;; Fetch all property rows through the public q surface.\n   130\t        fetched (query/collect\n   131\t                  (query/q '[:find ?se ?p ?v ?t ?m\n   132\t                             :where [?se ?p ?v ?t ?m] [(property? ?p)]]\n   133\t                           view\n   134\t                           {:fns {'property? property?}}))\n   135\t        ;; Step 1: current-state semantics per [se p v].\n   136\t        ;; Greatest t wins; same [se p v t] different m throws;\n   137\t        ;; retractions removed.\n   138\t        live (query/current-state-seq (mapv vec fetched))\n   139\t        ;; current-state-seq has already removed the reserved retraction\n   140\t        ;; marker. Keep every surviving fact, including one whose m names a\n   141\t        ;; reified metadata entity rather than the reserved assert marker.\n   142\t        facts live\n   143\t        ;; Build entity -> ident map from live :db/ident facts.\n   144\t        ident-rows (filterv #(= :db/ident (index/datom-a %)) facts)\n   145\t        entity->ident\n   146\t        (persistent!\n   147\t          (reduce (fn [m row]\n   148\t                    (let [e    (index/datom-e row)\n   149\t                          prev (get m e)]\n   150\t                      (cond (nil? prev) (assoc! m e row)\n   151\t                            (< (index/datom-t prev) (index/datom-t row))\n   152\t                            (assoc! m e row)\n   153\t                            (> (index/datom-t prev) (index/datom-t row))\n   154\t                            m\n   155\t                            :else\n   156\t                            (let [c (index/compare-vals\n   157\t                                      (index/datom-v prev)\n   158\t                                      (index/datom-v row))]\n   159\t                              (if (neg? c) m (assoc! m e row))))))\n   160\t                  (transient {})\n   161\t                  ident-rows))\n   162\t        ;; Step 2: collapse per [entity property] over surviving asserts.\n   163\t        ;; Entities without a live :db/ident are ignored.\n   164\t        valid-es (set (keys entity->ident))\n   165\t        prop-asserts (filterv #(and (not= :db/ident (index/datom-a %))\n   166\t                                    (contains? valid-es (index/datom-e %)))\n   167\t                              facts)\n   168\t        ;; Greatest t wins; on a same-t tie, least v under compare-vals.\n   169\t        ;; m is a metadata entity reference, never an ordering coordinate.\n   170\t        by-ep (persistent!\n   171\t                (reduce (fn [m row]\n   172\t                          (let [k [(index/datom-e row) (index/datom-a row)]]\n   173\t                            (assoc! m k\n   174\t                                    (let [prev (get m k)]\n   175\t                                      (cond (nil? prev) row\n   176\t                                            (< (index/datom-t prev)\n   177\t                                               (index/datom-t row)) row\n   178\t                                            (> (index/datom-t prev)\n   179\t                                               (index/datom-t row)) prev\n   180\t                                            :else\n   181\t                                            (let [c (index/compare-vals\n   182\t                                                      (index/datom-v prev)\n   183\t                                                      (index/datom-v row))]\n   184\t                                              (if (neg? c) prev row)))))))\n   185\t                        (transient {})\n   186\t                        prop-asserts))\n   187\t        ;; Build schema: {ident {prop val, ...}}\n   188\t        schema\n   189\t        (reduce-kv\n   190\t          (fn [m _eid-ea row]\n   191\t            (let [e     (index/datom-e row)\n   192\t                  ident (-> (entity->ident e) index/datom-v)]\n   193\t              (when ident\n   194\t                (let [prop (index/datom-a row)\n   195\t                      val  (index/datom-v row)]\n   196\t                  (when (= prop :db/valueType)\n   197\t                    (when-not (contains? type-pred val)\n   198\t                      (throw\n   199\t                        (ex-info\n   200\t                          (str \"unknown :db.type: \" (pr-str val))\n   201\t                          {:db/type val, :entity e}))))\n   202\t                  (assoc m ident\n   203\t                         (assoc (get m ident {}) prop val))))))\n   204\t          {}\n   205\t          by-ep)]\n   206\t    schema))\n   207\t\n   208\t\n   209\t;; =============================================================================\n   210\t;; Resolve: the seam the view and wrapper both use\n   211\t;; =============================================================================\n   212\t\n   213\t(defn resolve-props\n   214\t  \"Resolve the property map for ident. If ident is one of the five :db/*\n   215\t   idents, returns (get axioms ident) regardless of what schema says\n   216\t   (axioms are authority; stream rows are provenance). Otherwise\n   217\t   (get schema ident).\"\n   218\t  [schema ident]\n   219\t  (if (contains? axioms ident)\n   220\t    (get axioms ident)\n   221\t    (get schema ident)))\n   222\t\n   223\t\n   224\t;; =============================================================================\n   225\t;; The read view: schema/current (extraction + card-one collapse)\n   226\t;; =============================================================================\n   227\t\n   228\t(defn- validate-not-nested-view!\n   229\t  \"Reject descriptors whose :dao.stream/type is a query-layer view or\n   230\t   another schema view — these are not open!-dispatchable d5 sources.\"\n   231\t  [d]\n   232\t  (let [t (:dao.stream/type d)]\n   233\t    (when (or (= t :dao.space/current)\n   234\t              (= t :dao.space/history)\n   235\t              (= t :dao.space.schema/current))\n   236\t      (throw (ex-info\n   237\t               (str \"schema/current source must be an open!-dispatchable d5 \"\n   238\t                    \"descriptor, not a nested view: \" (pr-str t))\n   239\t               {:dao.stream/type t})))))\n   240\t\n   241\t\n   242\t#_{:clj-kondo/ignore [:unresolved-var]}\n   243\t\n   244\t\n   245\t;; kondo cannot resolve dao.stream vars defined behind :clj reader\n   246\t;; conditionals; query.cljc/transactor.cljc carry these unsuppressed.\n   247\t(defn- interpret-view\n   248\t  \"Shared interpretation core for the schema/current view. Given an\n   249\t   already-opened (and closed) source realization plus as-of /\n   250\t   schema-as-of bounds, returns a fact relation of d3 facts with\n   251\t   card-one collapse applied. Composition of public interpretations:\n   252\t   history view for data, history view for schema, extract-schema,\n   253\t   current-state-seq, then card-one collapse per [e a].\"\n   254\t  [source as-of schema-as-of]\n   255\t  ;; A v1 realization is drained here, where dao.stream already lives: the\n   256\t  ;; query read side takes values only, and the published defopen pre-forces\n   257\t  ;; its rows so the drain never touches the closed store.\n   258\t  (let [source (if (ds/realization? source)\n   259\t                 (query/relation (ds/strict-vec source))\n   260\t                 source)\n   261\t        data-rows   (query/rows (query/history source as-of))\n   262\t        schema-rows (query/rows (query/history source\n   263\t                                               (or schema-as-of as-of)))\n   264\t        schema (extract-schema schema-rows)\n   265\t        ;; Seed with axiom idents: the five :db/* attrs are card-one by\n   266\t        ;; axiom, with or without bootstrap/ident rows present.\n   267\t        card-one-es (into (set (keys axioms))\n   268\t                          (keep (fn [[ident _pm]]\n   269\t                                  (when (= :db.cardinality/one\n   270\t                                           (get (resolve-props schema ident)\n   271\t                                                :db/cardinality))\n   272\t                                    ident)))\n   273\t                          schema)\n   274\t        surviving (query/current-state-seq data-rows)\n   275\t        {card-one-rows true,\n   276\t         pass-through  false}\n   277\t        (group-by #(contains? card-one-es (index/datom-a %)) surviving)\n   278\t        collapsed\n   279\t        (vals\n   280\t          (reduce\n   281\t            (fn [m row]\n   282\t              (let [k [(index/datom-e row) (index/datom-a row)]]\n   283\t                (assoc m k\n   284\t                       (let [prev (get m k)]\n   285\t                         (cond (nil? prev) row\n   286\t                               (< (index/datom-t prev)\n   287\t                                  (index/datom-t row)) row\n   288\t                               (> (index/datom-t prev)\n   289\t                                  (index/datom-t row)) prev\n   290\t                               :else\n   291\t                               (let [c (index/compare-vals\n   292\t                                         (index/datom-v prev)\n   293\t                                         (index/datom-v row))]\n   294\t                                 (if (neg? c) prev row)))))))\n   295\t            {}\n   296\t            (or card-one-rows [])))\n   297\t        all-rows (sort index/eavt-cmp\n   298\t                       (into (vec collapsed) pass-through))\n   299\t        d3-rows (mapv #(subvec (vec %) 0 3) all-rows)]\n   300\t    (query/fact-relation d3-rows)))\n   301\t\n   302\t\n   303\t#_{:clj-kondo/ignore [:unresolved-var]}\n   304\t\n   305\t\n   306\t(defn current\n   307\t  \"The schema-aware current view: d3 facts with card-one collapse applied,\n   308\t   as a query fact-relation value q accepts directly. A query value source\n   309\t   (relation value, opened published index) and an already-opened closed\n   310\t   realization interpret immediately; a v1 open!-dispatchable descriptor\n   311\t   is opened, closed, and interpreted through the defopen route.\n   312\t   Opts map: {:as-of n :schema-as-of n}, both optional.\"\n   313\t  ([source] (current source nil))\n   314\t  ([source opts]\n   315\t   (let [as-of       (when (map? opts) (:as-of opts))\n   316\t         schema-as-of (when (map? opts) (:schema-as-of opts))]\n   317\t     (if (ds/realization? source)\n   318\t       (do (when-not (satisfies? ds/IDaoStreamBound source)\n   319\t             (throw (ex-info\n   320\t                      \"borrowed input must satisfy IDaoStreamBound\"\n   321\t                      {:source source})))\n   322\t           (when-not (ds/closed? source)\n   323\t             (throw (ex-info\n   324\t                      \"borrowed input must be closed\"\n   325\t                      {:source source})))\n   326\t           (interpret-view source as-of schema-as-of))\n   327\t       (let [d (when (map? source) source)]\n   328\t         (when-not d\n   329\t           (throw (ex-info\n   330\t                    \"source must be a descriptor or a closed realization\"\n   331\t                    {:source source})))\n   332\t         (when-not (keyword? (:dao.stream/type d))\n   333\t           (throw (ex-info\n   334\t                    \"descriptor must carry :dao.stream/type\"\n   335\t                    {:source source})))\n   336\t         (validate-not-nested-view! d)\n   337\t         (let [view (cond-> {:dao.stream/type :dao.space.schema/current\n   338\t                             :source d\n   339\t                             :dao.stream/bound (:dao.stream/bound d)}\n   340\t                      (some? as-of)        (assoc :as-of as-of)\n   341\t                      (some? schema-as-of) (assoc :schema-as-of schema-as-of))]\n   342\t           ;; query/q opens nothing, so the schema view is interpreted here,\n   343\t           ;; not by its consumer. A query value (relation value, opened\n   344\t           ;; published index) interprets directly; a v1 open!-dispatchable\n   345\t           ;; descriptor keeps the defopen route.\n   346\t           (if (query/value? d)\n   347\t             (interpret-view d as-of schema-as-of)\n   348\t             (ds/open! view))))))))\n   349\t\n   350\t\n   351\t#_{:clj-kondo/ignore [:unresolved-symbol :unresolved-var]}\n   352\t\n   353\t\n   354\t(ds/defopen :dao.space.schema/current\n   355\t            [desc]\n   356\t            (let [src (:source desc)]\n   357\t              (when-not (map? src)\n   358\t                (throw (ex-info \"schema/current descriptor must carry :source\"\n   359\t                                {:descriptor desc})))\n   360\t              (let [r (ds/open! src)]\n   361\t                (try (when-not (satisfies? ds/IDaoStreamReader r)\n   362\t                       (throw (ex-info \"open! did not produce a reader realization\"\n   363\t                                       {:descriptor desc})))\n   364\t                     (ds/close! r)\n   365\t                     (interpret-view r (:as-of desc) (:schema-as-of desc))\n   366\t                     (catch #?(:clj Throwable\n   367\t                               :cljs :default\n   368\t                               :cljd Object)\n   369\t                            error\n   370\t                       (ds/close! r)\n   371\t                       (throw error))))))\n   372\t\n   373\t\n   374\t;; =============================================================================\n   375\t;; The write boundary: validating wrapper (wave 3a)\n   376\t;; =============================================================================\n   377\t\n   378\t(defn- resolve-lookup-ref\n   379\t  \"Resolve a lookup ref [:attr value] against the planned unique state.\n   380\t   A unique index retains every claimant so lax violations remain explicit.\n   381\t   Returns the sole entity id, nil when absent, and throws when ambiguous.\"\n   382\t  [ref state]\n   383\t  (when (and (vector? ref) (= 2 (count ref)))\n   384\t    (let [[attr val] ref\n   385\t          owners (get-in (:unique state) [attr val] #{})]\n   386\t      (case (count owners)\n   387\t        0 nil\n   388\t        1 (first owners)\n   389\t        (throw (ex-info (str \"ambiguous lookup ref: \" (pr-str ref)\n   390\t                             \" names entities \" (pr-str owners))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/observe.cljc | sed -n '1,220p'; nl -ba src/cljc/dao/space/query.cljc | sed -n '375,490p'; rg -n \\\"dao.space.schema|dao.space.query\\\" src/cljc/dao/space/query.cljc src/cljc/dao/space/schema.cljc src/cljc/dao/space/index.cljc src/cljc/dao/space/transactor.cljc; rg -n \\\"schema/current|:as-of|:schema-as-of|borrowed-path-does-not-close-again|nested|RecordingStream\\\" test/dao/space/schema_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/observe.cljc | sed -n '1,220p'; nl -ba src/cljc/dao/space/query.cljc | sed -n '375,490p'; rg -n \\\"dao.space.schema|dao.space.query\\\" src/cljc/dao/space/query.cljc src/cljc/dao/space/schema.cljc src/cljc/dao/space/index.cljc src/cljc/dao/space/transactor.cljc; rg -n \\\"schema/current|:as-of|:schema-as-of|borrowed-path-does-not-close-again|nested|RecordingStream\\\" test/dao/space/schema_test.cljc\"","aggregated_output":"     1\t(ns dao.stream.observe\n     2\t  \"One observation step over a DaoStream reader: read a value, act on it, and\n     3\t   advance the cursor only if the act succeeded.\n     4\t\n     5\t   `step` owns no scheduler, loop, state, callback or policy.  It classifies\n     6\t   every outcome the contract declares as data and hands the caller what it\n     7\t   needs to decide: the successor cursor on progress, the recovery cursor on a\n     8\t   gap, the raw answer on a defect.  What to do about a gap, whether a defect\n     9\t   is fatal, how many values to take per turn, and what state to carry between\n    10\t   turns all belong to the caller.\n    11\t\n    12\t   The cursor advances in exactly one place -- after the effect has answered\n    13\t   `ok` -- so effect-before-commit is a property of this seam rather than a\n    14\t   rule each caller keeps.  An effect that throws propagates before any\n    15\t   successor exists, which gives a throwing effect the same guarantee for\n    16\t   free.\n    17\t\n    18\t   Callers are `dao.stream.forward` (effect: append to another stream),\n    19\t   `yin.vm.stream-observer` (effect: load a program into a VM) and\n    20\t   `dao.jing` (effect: materialize content).  Each adds its own loop and its\n    21\t   own policy above this step.\n    22\t\n    23\t   The law every interpreter here obeys is that an element's cursor advances\n    24\t   exactly when its disposition has been durably recorded.  This step serves\n    25\t   the interpreters whose disposition is an external, refusable effect -- an\n    26\t   append, a load, a materialization -- where that means advancing only after\n    27\t   the effect answered ok.  Interpreters whose disposition is a local, total\n    28\t   state transition keep their own read loops: `dao.stream.rpc/poll!`,\n    29\t   `dao.stream.apply/serve-once!` and `dao.runtime`'s wait set thread\n    30\t   whole caller state under a budget with terminal short-circuits, and for\n    31\t   them advancing first and advancing after the commit are the same fact,\n    32\t   because no window exists in which one happened and the other did not.\n    33\t   `serve-once!` is the proof that this is one law and not two families: it\n    34\t   advances after delivery for a correlatable request, on the diagnostic for\n    35\t   an uncorrelatable one, and on terminal loss for an undeliverable response.\n    36\t\n    37\t   There is no ordering parameter here and none is needed.  A consumer that\n    38\t   wants an element consumed even when its interpretation is defective writes\n    39\t   a *total* effect -- one that classifies every element as data and so always\n    40\t   answers ok -- and gets consume-exactly-once through this same step.\"\n    41\t  (:require [dao.stream :as stream]))\n    42\t\n    43\t\n    44\t(defn- valid-or-transport-error\n    45\t  \"Fold a defective host answer into the contract's outcome algebra.\n    46\t\n    47\t   A conforming operation already returns one of the contract outcomes; this\n    48\t   keeps the step's branch total when a composition supplies a bad handle or\n    49\t   an effect answers with something that is not an outcome map.\"\n    50\t  [operation result]\n    51\t  (if (stream/valid-outcome? operation result)\n    52\t    result\n    53\t    {:dao.stream/outcome :dao.stream/transport-error\n    54\t     :dao.stream/error :dao.stream/invalid-operation-result\n    55\t     :dao.stream/answer result}))\n    56\t\n    57\t\n    58\t(defn step\n    59\t  \"Read one value from `source` at `cursor` and run `effect` on it.\n    60\t\n    61\t   `effect` is `(fn [value] -> outcome-map)` answering with the writer outcome\n    62\t   set: `ok`, `full` (\\\"not yet\\\"), `invalid-value`, `closed`, or\n    63\t   `transport-error`.  Any other answer is classified as `transport-error`\n    64\t   with the raw answer retained.  An effect that throws propagates.\n    65\t\n    66\t   Returns a map carrying `:cursor` and `:read` (the raw read answer) in every\n    67\t   case:\n    68\t\n    69\t   | status     | when                                    | cursor    | also         |\n    70\t   | ---------- | --------------------------------------- | --------- | ------------ |\n    71\t   | `:advance` | read ok, effect ok                      | successor | `:effect`    |\n    72\t   | `:retry`   | read blocked, or effect full            | unchanged | `:outcome`   |\n    73\t   | `:ended`   | read end                                | unchanged | `:outcome`   |\n    74\t   | `:gap`     | read gap                                | unchanged | `:recovery`  |\n    75\t   | `:defect`  | read cursor-mismatch, invalid-cursor,\n    76\t                  transport-error, or malformed                | unchanged | `:outcome`   |\n    77\t   | `:failed`  | effect invalid-value, closed,\n    78\t                  transport-error, or malformed                | unchanged | `:outcome`, `:effect` |\n    79\t\n    80\t   A `:retry` from the effect also carries `:effect`.  The cursor is the\n    81\t   successor on `:advance` and unchanged on every other status.\"\n    82\t  [source cursor effect]\n    83\t  (let [read-result (valid-or-transport-error :next (stream/next source cursor))\n    84\t        read-outcome (:dao.stream/outcome read-result)]\n    85\t    (case read-outcome\n    86\t      :dao.stream/ok\n    87\t      (let [effect-result (valid-or-transport-error\n    88\t                            :append!\n    89\t                            (effect (:dao.stream/value read-result)))\n    90\t            effect-outcome (:dao.stream/outcome effect-result)]\n    91\t        (case effect-outcome\n    92\t          :dao.stream/ok {:status :advance\n    93\t                          :cursor (:dao.stream/cursor read-result)\n    94\t                          :read read-result\n    95\t                          :effect effect-result}\n    96\t          :dao.stream/full {:status :retry\n    97\t                            :cursor cursor\n    98\t                            :outcome effect-outcome\n    99\t                            :read read-result\n   100\t                            :effect effect-result}\n   101\t          {:status :failed\n   102\t           :cursor cursor\n   103\t           :outcome effect-outcome\n   104\t           :read read-result\n   105\t           :effect effect-result}))\n   106\t\n   107\t      :dao.stream/blocked {:status :retry\n   108\t                           :cursor cursor\n   109\t                           :outcome read-outcome\n   110\t                           :read read-result}\n   111\t\n   112\t      :dao.stream/end {:status :ended\n   113\t                       :cursor cursor\n   114\t                       :outcome read-outcome\n   115\t                       :read read-result}\n   116\t\n   117\t      :dao.stream/gap {:status :gap\n   118\t                       :cursor cursor\n   119\t                       :outcome read-outcome\n   120\t                       :recovery (:dao.stream/cursor read-result)\n   121\t                       :read read-result}\n   122\t\n   123\t      {:status :defect\n   124\t       :cursor cursor\n   125\t       :outcome read-outcome\n   126\t       :read read-result})))\n   375\t(declare realize-db-value!)\n   376\t\n   377\t\n   378\t(defn- realize-datom-view\n   379\t  \"Interpret a current/history view inside the query layer. The nested\n   380\t   source is another query value; a current view with no as-of over an\n   381\t   opened published index routes through the restored covered sets, every\n   382\t   other combination resolves the source's rows.\"\n   383\t  [d]\n   384\t  (let [kind (:dao.space.query/view d)\n   385\t        as-of (:as-of d)\n   386\t        {src-relation ::relation, src-indexes ::indexes}\n   387\t        (realize-db-value! (:source d))]\n   388\t    (if (and (= :current kind) (nil? as-of) src-indexes)\n   389\t      {::relation (delay (d5->current-facts (force-relation src-relation) nil)),\n   390\t       ::fact-index src-indexes}\n   391\t      (let [forced-rel (force-relation src-relation)\n   392\t            rows (case kind\n   393\t                   :current (d5->current-facts forced-rel as-of)\n   394\t                   :history (d5->history-rows forced-rel as-of))]\n   395\t        {::relation rows,\n   396\t         ::fact-index (when (= :current kind)\n   397\t                        (relation->fact-index rows))}))))\n   398\t\n   399\t\n   400\t(defn ^:no-doc realize-db-value!\n   401\t  \"Turn one db-value into an immutable tuple relation plus, for current\n   402\t   fact views, an in-memory fact index. Opens nothing, closes nothing.\"\n   403\t  [db-value]\n   404\t  (when-not (map? db-value)\n   405\t    (throw\n   406\t      (ex-info\n   407\t        \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   408\t        {:input db-value})))\n   409\t  (cond\n   410\t    (contains? db-value :dao.space.query/relation)\n   411\t    (let [tuples (:dao.space.query/relation db-value)]\n   412\t      {::relation tuples,\n   413\t       ::fact-index (when (:fact? db-value) (relation->fact-index tuples))})\n   414\t\n   415\t    (contains? db-value :dao.space.query/published)\n   416\t    (let [indexes (index/covered-indexes db-value)]\n   417\t      {::relation (:rows db-value),\n   418\t       ::indexes indexes,\n   419\t       ::fact-index nil})\n   420\t\n   421\t    (contains? db-value :dao.space.query/view)\n   422\t    (realize-datom-view db-value)\n   423\t\n   424\t    :else\n   425\t    (throw\n   426\t      (ex-info\n   427\t        \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   428\t        {:input db-value}))))\n   429\t\n   430\t\n   431\t;; =============================================================================\n   432\t;; match: Linda-style positional template (an ergonomic materializer)\n   433\t;; =============================================================================\n   434\t\n   435\t(def ^:private FREE ::free)\n   436\t\n   437\t\n   438\t(defn- wildcard?\n   439\t  [x]\n   440\t  (or (= x '_) (nil? x) (= x FREE)))\n   441\t\n   442\t\n   443\t(defn- query-var-symbol?\n   444\t  [x]\n   445\t  (and (symbol? x) (= \\? (first (name x)))))\n   446\t\n   447\t\n   448\t(defn- parse-tuple-pattern\n   449\t  \"Parse exact positional syntax plus an optional final `& tail`.\"\n   450\t  [pattern]\n   451\t  (let [pattern (vec pattern)\n   452\t        amps (vec (keep-indexed #(when (= '& %2) %1) pattern))]\n   453\t    (cond\n   454\t      (empty? amps) {:fixed pattern, :rest nil}\n   455\t      (or (not= 1 (count amps)) (not= (first amps) (- (count pattern) 2)))\n   456\t      (throw\n   457\t        (ex-info\n   458\t          \"Malformed tuple rest pattern: & must precede one final tail form\"\n   459\t          {:pattern pattern}))\n   460\t      :else (let [tail (peek pattern)]\n   461\t              (when-not (or (= tail '_) (query-var-symbol? tail))\n   462\t                (throw (ex-info\n   463\t                         \"Tuple rest pattern tail must be _ or a query variable\"\n   464\t                         {:pattern pattern, :tail tail})))\n   465\t              {:fixed (subvec pattern 0 (first amps)), :rest tail}))))\