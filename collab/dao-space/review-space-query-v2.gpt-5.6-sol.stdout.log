(defn- interpret-view\n   248\t  \"Shared interpretation core for the schema/current view. Given an\n   249\t   already-opened (and closed) source realization plus as-of /\n   250\t   schema-as-of bounds, returns a closed ViewStream of d3 facts with\n   251\t   card-one collapse applied. Composition of public interpretations:\n   252\t   history view for data, history view for schema, extract-schema,\n   253\t   current-state-seq, then card-one collapse per [e a].\"\n   254\t  [source as-of schema-as-of]\n   255\t  (let [data-rows   (ds/strict-vec (query/history source as-of))\n   256\t        schema-rows (ds/strict-vec (query/history source\n   257\t                                                  (or schema-as-of as-of)))\n   258\t        schema (extract-schema schema-rows)\n   259\t        ;; Seed with axiom idents: the five :db/* attrs are card-one by\n   260\t        ;; axiom, with or without bootstrap/ident rows present.\n   261\t        card-one-es (into (set (keys axioms))\n   262\t                          (keep (fn [[ident _pm]]\n   263\t                                  (when (= :db.cardinality/one\n   264\t                                           (get (resolve-props schema ident)\n   265\t                                                :db/cardinality))\n   266\t                                    ident)))\n   267\t                          schema)\n   268\t        surviving (query/current-state-seq data-rows)\n   269\t        {card-one-rows true,\n   270\t         pass-through  false}\n   271\t        (group-by #(contains? card-one-es (index/datom-a %)) surviving)\n   272\t        collapsed\n   273\t        (vals\n   274\t          (reduce\n   275\t            (fn [m row]\n   276\t              (let [k [(index/datom-e row) (index/datom-a row)]]\n   277\t                (assoc m k\n   278\t                       (let [prev (get m k)]\n   279\t                         (cond (nil? prev) row\n   280\t                               (< (index/datom-t prev)\n   281\t                                  (index/datom-t row)) row\n   282\t                               (> (index/datom-t prev)\n   283\t                                  (index/datom-t row)) prev\n   284\t                               :else\n   285\t                               (let [c (index/compare-vals\n   286\t                                         (index/datom-v prev)\n   287\t                                         (index/datom-v row))]\n   288\t                                 (if (neg? c) prev row)))))))\n   289\t            {}\n   290\t            (or card-one-rows [])))\n   291\t        all-rows (sort index/eavt-cmp\n   292\t                       (into (vec collapsed) pass-through))\n   293\t        d3-rows (mapv #(subvec (vec %) 0 3) all-rows)]\n   294\t    (query/->ViewStream d3-rows true)))\n   295\t\n   296\t\n   297\t#_{:clj-kondo/ignore [:unresolved-var]}\n   298\t\n   299\t\n   300\t(defn current\n   301\t  \"The schema-aware current view. Given a descriptor, returns a pure\n   302\t   semantic view value `{:dao.stream/type :dao.space.schema/current ...}`\n   303\t   interpreted by q; given an already-opened closed realization, returns\n   304\t   a read-only, closed, derived ViewStream of d3 facts with card-one\n   305\t   collapse applied. Opts map: {:as-of n :schema-as-of n}, both optional.\n   306\t   Dual-path: descriptor returns view value, realization interprets directly.\"\n   307\t  ([source] (current source nil))\n   308\t  ([source opts]\n   309\t   (let [as-of       (when (map? opts) (:as-of opts))\n   310\t         schema-as-of (when (map? opts) (:schema-as-of opts))]\n   311\t     (if (ds/realization? source)\n   312\t       (do (when-not (satisfies? ds/IDaoStreamBound source)\n   313\t             (throw (ex-info\n   314\t                      \"borrowed input must satisfy IDaoStreamBound\"\n   315\t                      {:source source})))\n   316\t           (when-not (ds/closed? source)\n   317\t             (throw (ex