l/embed_test.cljc\ntest/yin/repl/connect_test.cljc\ntest/yin/repl/driver_test.cljc\ntest/yin/repl/host_node_test.cljs\ntest/yin/repl/build_test.clj\ntest/yin/repl/host/jvm_test.clj\ntest/yin/repl/slice_peer.cljc\nsrc/cljc/dao/stream/remote_pair.cljc\nsrc/cljc/dao/stream/observer.cljc\nsrc/cljc/dao/stream/apply.cljc\nsrc/cljc/dao/stream/rpc.cljc\nsrc/cljc/dao/stream/remote.cljc\nsrc/cljc/dao/stream/observe.cljc\nsrc/cljc/dao/stream/remote_meet.cljc\ntest/dao/stream/remote_meet_test.cljc\ntest/dao/stream/observe_test.cljc\ntest/dao/stream/observer_test.cljc\ntest/dao/stream/rpc_test.cljc\ntest/dao/stream/remote_test.cljc\ntest/dao/stream/apply_test.cljc\ntest/dao/stream/remote_pair_test.cljc\npublic/demo.html\nsrc/cljc/yin/repl/host.cljc\nsrc/cljc/yin/repl/serve.cljc\nsrc/cljc/yin/repl/embed.cljc\nsrc/cljc/yin/repl/connect.cljc\nsrc/cljc/yin/repl/adapter.cljc\nsrc/cljc/yin/repl/main.cljc\nsrc/cljc/yin/repl/driver.cljc\nsrc/cljc/yin/repl/host/common.cljc\nsrc/cljc/yin/repl/link.cljc\nsrc/cljc/datomworld/demo/artifact_scene.cljc\nsrc/cljc/datomworld/demo/earth_moon_runner.cljc\nsrc/cljc/datomworld/demo/voxel_controls.cljc\nsrc/cljc/datomworld/demo/artifact_runner.cljc\nsrc/cljc/datomworld/demo/voxel_runner.cljc\nsrc/cljc/datomworld/demo/solar_system_scene.cljc\nsrc/cljc/datomworld/demo/continuation_handoff.cljc\nsrc/cljc/datomworld/demo/continuation_transport.cljc\nsrc/cljc/datomworld/demo/voxel_input.cljc\nsrc/cljc/datomworld/demo/earth_moon_scene.cljc\nsrc/cljc/datomworld/demo/voxel_scene.cljc\nsrc/cljc/yin/repl.cljc\npublic/chp/blog/maxwells-demon-economic-value.blog\npublic/chp/blog/trilemma-thermodynamics-maxwells-demon.blog\nsrc/cljc/yin/vm/ffi.cljc\n","exit_code":0,"status":"completed"}}
