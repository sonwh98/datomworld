nnect/requests-identity {:handle requests :surface #{:writer}}\n   225\t               connect/answers-identity {:handle answers :surface #{:reader}}}\n   226\t        base {:control control\n   227\t              :control-cursor control-cursor\n   228\t              :lifecycle lifecycle\n   229\t              :lifecycle-cursor lifecycle-cursor\n   230\t              :lifecycle-ledger :untried\n   231\t              :slots pool\n   232\t              :path path\n   233\t              :descriptor descriptor\n   234\t              :bind-host bind-host\n   235\t              :bind-port bind-port\n   236\t              :resolution nil\n   237\t              :requests requests\n   238\t              :answers answers\n   239\t              :requests-cursor requests-cursor\n   240\t              :pending-answer nil\n   241\t              :pending-successor nil\n   242\t              :host host\n   243\t              :resources (atom nil)\n   244\t              :repl (or repl (repl/create-state))\n   245\t              :status :new\n   246\t              :stop-initiated? false\n   247\t              :step-moved? false\n   248\t              :outbox []}]\n   249\t    (cond\n   250\t      (nil? advertised-host)\n   420\t;; =============================================================================\n   421\t;; Requests\n   422\t;; =============================================================================\n   423\t\n   424\t(defn- evaluate\n   425\t  \"Answer one validated request against the one shared shell, serially.\"\n   426\t  [repl request]\n   427\t  (let [id (rpc/request-id request)]\n   428\t    (cond\n   429\t      (not= eval-operation (rpc/request-op request))\n   430\t      [repl (rpc/error-answer id :yin.repl.serve/unknown-operation\n   431\t                              \"This endpoint answers :op/eval only; it does not proxy\")]\n   432\t\n   433\t      (not (string? (first (rpc/request-args request))))\n   434\t      [repl (rpc/error-answer id :yin.repl.serve/invalid-arguments\n   435\t                              \"An :op/eval request carries one source string\")]\n   436\t\n   437\t      :else\n   438\t      (try\n   439\t        (let [[repl' text] (repl/eval-input repl (first (rpc/request-args request)))]\n   440\t          (if (:pending-input repl')\n   441\t            ;; Line continuation is a terminal concern.  One shared shell means\n   442\t            ;; an unbalanced request would otherwise prefix the *next*\n   443\t            ;; caller's source, so the fragment is refused and dropped here\n   444\t            ;; rather than retained across a caller boundary.  The envelope\n   445\t            ;; was well formed, so the refusal is this server's decision and\n   446\t            ;; carries this server's code: a client can tell it from a codec\n   447\t            ;; defect.\n   448\t            [(assoc repl' :pending-input nil)\n   449\t             (rpc/error-answer id incomplete-input-code\n   450\t                               \"Incomplete input: a request carries one complete form\")]\n   451\t            [repl' (rpc/success-answer id text)]))\n   452\t        (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   453\t          [repl (rpc/error-answer id :yin.repl.serve/handler-error \"Handler failed\")])))))\n   454\t\n   455\t\n   456\t(defn- deliver-answer\n   457\t  \"Append one retained answer, advancing the requests cursor only when the\n   458\t   append is accepted.  `full` retries the identical answer on a later step\n   459\t   without re-running the handler.\"\n   460\t  [endpoint]\n   461\t  (let [result (stream/append! (:answers endpoint) (:pending-answer endpoint))\n   462\t        outcome (:dao.stream/outcome result)]\n   463\t    (case outcome\n   464\t      :dao.stream/ok\n   465\t      (assoc endpoint\n   466\t             :requests-cursor (:pending-successor endpoint)\n   467\t             :pending-answer nil\n   468\t             :pending-successor nil)\n   469\t\n   470\t      :dao.stream/full\n   471\t      endpoint\n   472\t\n   473\t      (-> endpoint\n   474\t          (assoc :requests-cursor (:pending-successor endpoint)\n   475\t                 :pending-answer nil\n   476\t                 :pending-successor nil)\n   477\t          (publish :yin.repl.serve/notice\n   478\t                   (str \";; answer undeliverable: \" (name outcome)))))))\n   479\t\n   480\t\n   481\t(defn- advance-requests\n   482\t  \"One bounded sweep of the shared requests/answers pair: a pending answer\n   483\t   is retried first (its retry runs on the host's cadence, gated on\n   484\t   nothing), then at most `request-budget` further request/answer cycles.\n   485\t   Correlation is by the self-minted random id every request and answer\n   486\t   carries (`dao.stream.rpc`), never by which connection carried it -- the\n   487\t   mirror already answered every wire-protocol question a reflection\n   488\t   asked; this is the interpreter over the local requests/answers ends the\n   489\t   service convention names.\"\n   490\t  [endpoint]\n   491\t  (loop [remaining request-budget\n   492\t         endpoint endpoint]\n   493\t    (cond\n   494\t      (zero? remaining) endpoint\n   495\t\n   496\t      (:pending-answer endpoint)\n   497\t      (let [endpoint (deliver-answer endpoint)]\n   498\t        (if (:pending-answer endpoint)\n   499\t          endpoint\n   500\t          (recur (dec remaining) endpoint)))\n   501\t\n   502\t      :else\n   503\t      (let [result (stream/next (:requests endpoint) (:requests-cursor endpoint))\n   504\t            outcome (:dao.stream/outcome result)]\n   505\t        (case outcome\n   506\t          :dao.stream/ok\n   507\t          (let [request (:dao.stream/value result)\n   508\t                successor (:dao.stream/cursor result)]\n   509\t            (cond\n   510\t              (rpc/request-value? request)\n   511\t              (let [[repl' answer] (evaluate (:repl endpoint) request)]\n   512\t                (recur remaining\n   513\t                       (assoc endpoint\n   514\t                              :repl repl'\n   515\t                              :pending-answer answer\n   516\t                              :pending-successor successor)))\n   517\t\n   518\t              ;; Correlatable but malformed: an error answer at least tells\n   519\t              ;; the caller their own request failed, distinct from silence.\n   520\t              (and (map? request) (rpc/safe-id? (:dao.stream.rpc/id request)))\n   521\t              (recur remaining\n   522\t                     (assoc endpoint\n   523\t                            :pending-answer\n   524\t                            (rpc/error-answer (:dao.stream.rpc/id request)\n   525\t                                              :yin.repl.serve/malformed-request\n   526\t                                              \"Malformed request envelope\")\n   527\t                            :pending-successor successor))\n   528\t\n   529\t              :else\n   530\t              (recur (dec remaining)\n","exit_code":0,"status":"completed"}}
