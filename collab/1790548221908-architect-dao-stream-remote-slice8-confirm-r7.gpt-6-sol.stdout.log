{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/ucf/remote_test.cljc | sed -n '710,812p'; nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '95,175p;445,478p'\"","aggregated_output":"   710\t(defn- stub-serve!\n   711\t  \"A `serve!` that assigns every handle to one identity per handle\n   712\t   under `chan`, with no wire underneath: these variants prove the\n   713\t   bridge's shape, the transport already proven above.\"\n   714\t  [chan]\n   715\t  (let [ids (atom {})]\n   716\t    (fn [h]\n   717\t      (let [id (or (get @ids h)\n   718\t                   (let [n (str (gensym \"seg\"))]\n   719\t                     (swap! ids assoc h n)\n   720\t                     n))]\n   721\t        {:dao.stream/identity id, :dao.stream/channel chan}))))\n   722\t\n   723\t\n   724\t(defn- stub-attach!\n   725\t  \"An `attach!` that answers ok at once with a reflection standing for\n   726\t   the descriptor's identity -- opaque here, since these variants\n   727\t   never poll it.\"\n   728\t  []\n   729\t  (fn [d]\n   730\t    {:dao.stream/outcome :dao.stream/ok,\n   731\t     :dao.stream/handle [:reflection-of (:dao.stream/identity d)]}))\n   732\t\n   733\t\n   734\t(def ^:private chan\n   735\t  {:dao.stream/type :dao.stream.test/channel, :dao.stream/identity \"c\"})\n   736\t\n   737\t\n   738\t(deftest shared-cursor-cells-lift-and-lower-shared\n   739\t  (let [serve! (stub-serve! chan)\n   740\t        attach! (stub-attach!)\n   741\t        [_datoms parked entry _src] (parked-reader 4)\n   742\t        cid (:id (:cursor-ref entry))\n   743\t        ;; a second waiter on the SAME engine cursor cell, as\n   744\t        ;; check-wait-set's shared-cursor co-waiters hold\n   745\t        second (assoc (registers-of entry)\n   746\t                      :reason :next,\n   747\t                      :stream-id (:stream-id entry),\n   748\t                      :cursor-ref {:type :cursor-ref, :id cid},\n   749\t                      :pc 42)\n   750\t        lifted (ucf.remote/lift-frame serve! (:resources parked)\n   751\t                                      [entry second])]\n   752\t    (testing \"two waiters on one engine cell lift to one UCF cell\"\n   753\t      (is (= 1 (count (:yin.k/cells lifted))))\n   754\t      (let [[p1 p2] (:yin.k/pending lifted)]\n   755\t        (is (= (:yin.k/cell p1) (:yin.k/cell p2))\n   756\t            \"both waiters name the one cell\")))\n   757\t    (let [ctxs [(registers-of entry) (registers-of second)]\n   758\t          lowered (ucf.remote/lower-frame attach! (:yin.k/pending lifted)\n   759\t                                          (:yin.k/cells lifted) ctxs)\n   760\t          [e1 e2] (:entries lowered)\n   761\t          rs (:resources lowered)]\n   762\t      (testing \"and lower back into one shared cursor entry\"\n   763\t        (is (= (get-in e1 [:cursor-ref :id])\n   764\t               (get-in e2 [:cursor-ref :id]))\n   765\t            \"one cell id stands for the one entry\")\n   766\t        (is (= 1 (count (cursor-entries rs)))))\n   767\t      (testing \"each entry keeps its own register context\"\n   768\t        (is (= (:pc entry) (:pc e1)))\n   769\t        (is (= 42 (:pc e2)))))))\n   770\t\n   771\t\n   772\t(deftest independent-cells-at-one-position-stay-independent\n   773\t  (let [serve! (stub-serve! chan)\n   774\t        attach! (stub-attach!)\n   775\t        s (ring 8)\n   776\t        _ (stream/append! s \"v\")\n   777\t        c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   778\t        resources {:yin/s s,\n   779\t                   :yin/c1 {:stream-id :yin/s, :cursor c0},\n   780\t                   :yin/c2 {:stream-id :yin/s, :cursor c0}}\n   781\t        entry1 {:reason :next,\n   782\t                :cursor-ref {:type :cursor-ref, :id :yin/c1},\n   783\t                :stream-id :yin/s}\n   784\t        entry2 {:reason :next,\n   785\t                :cursor-ref {:type :cursor-ref, :id :yin/c2},\n   786\t                :stream-id :yin/s}\n   787\t        lifted (ucf.remote/lift-frame serve! resources\n   788\t                                      [entry1 entry2])]\n   789\t    (testing \"two engine cells at one position are two UCF cells\"\n   790\t      (is (= 2 (count (:yin.k/cells lifted)))\n   791\t          \"the aliasing a position-only encoding erases, kept\")\n   792\t      (let [[p1 p2] (:yin.k/pending lifted)]\n   793\t        (is (not= (:yin.k/cell p1) (:yin.k/cell p2)))\n   794\t        (is (= c0 (get-in lifted [:yin.k/cells (:yin.k/cell p1)\n   795\t                                  :yin.k/position])))\n   796\t        (is (= c0 (get-in lifted [:yin.k/cells (:yin.k/cell p2)\n   797\t                                  :yin.k/position])))))\n   798\t    (let [ctx {:segment 0, :pc 1, :env {}, :stack [], :k []}\n   799\t          lowered (ucf.remote/lower-frame attach! (:yin.k/pending lifted)\n   800\t                                          (:yin.k/cells lifted)\n   801\t                                          [ctx ctx])\n   802\t          [e1 e2] (:entries lowered)\n   803\t          rs (:resources lowered)]\n   804\t      (testing \"and lower into two independently advanceable entries\"\n   805\t        (is (not= (get-in e1 [:cursor-ref :id])\n   806\t                  (get-in e2 [:cursor-ref :id])))\n   807\t        (is (= 2 (count (cursor-entries rs))))\n   808\t        (is (= 1 (count (filter vector? (vals rs))))\n   809\t            \"one stream, so the two cells share one reflection\")))))\n   810\t\n   811\t\n   812\t(deftest a-refused-leaf-refuses-the-frame\n    95\t   between evaluations.\"\n    96\t  [vm seg pc val St E K]\n    97\t  (assoc vm\n    98\t         :control (when seg {:segment seg, :pc pc})\n    99\t         :value val\n   100\t         :stack (or St [])\n   101\t         :env E\n   102\t         :k (if (seq K) K nil)\n   103\t         :halted? (and (not (:blocked? vm)) (nil? seg))))\n   104\t\n   105\t\n   106\t(defn- response-wait-entry\n   107\t  \"The polling wait entry for a sent call awaiting its correlated response:\n   108\t   the machine registers {segment pc env stack k} plus the call-out reader\n   109\t   fields, in the shape `ffi/call-response-wait-entry` gives the walker.\"\n   110\t  [seg pc env stack k call-id]\n   111\t  {:segment seg, :pc pc, :env env, :stack stack, :k k,\n   112\t   :call-id call-id,\n   113\t   :reason :next,\n   114\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   115\t   :stream-id vm/call-out-stream-key})\n   116\t\n   117\t\n   118\t(defn- carried-response-route\n   119\t  \"The response route a lowered retained writer carries -- its\n   120\t   [response cursor key, response stream key] pair, the route data\n   121\t   `yin.vm.ucf.remote` stamps on the lowered entry\n   122\t   (`yin.vm.universal-continuation-format.md` S7.4.3). nil when the\n   123\t   writer carries none: an ordinary retained call waits on the fixed\n   124\t   local call-out keys.\"\n   125\t  [entry]\n   126\t  (when (and (contains? entry :response-cursor)\n   127\t             (contains? entry :response-stream))\n   128\t    [(:response-cursor entry) (:response-stream entry)]))\n   129\t\n   130\t\n   131\t(defn semantic-restore\n   132\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   133\t\n   134\t   Two entry shapes carry more than registers:\n   135\t\n   136\t   - A `:request-sent` entry is a writer whose retained FFI request has now\n   137\t     been appended. The call starts waiting for its correlated response,\n   138\t     exactly as an immediately-sent one does, so the entry is replaced by its\n   139\t     response reader and the machine stays blocked. A writer carrying a\n   140\t     lowered call's response route (`:response-cursor`, `:response-stream`)\n   141\t     waits on that carried route; an ordinary one waits on the fixed local\n   142\t     call-out keys.\n   143\t   - A `:call-id` entry is a response reader. The woken value is a response\n   144\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\n   145\t     parked call leaves `:parked` rather than accumulating.\"\n   146\t  ([base entry] (semantic-restore base entry (:value entry)))\n   147\t  ([base entry val]\n   148\t   (if (:request-sent entry)\n   149\t     (let [wait (response-wait-entry (:segment entry)\n   150\t                                     (:pc entry)\n   151\t                                     (:env entry)\n   152\t                                     (:stack entry)\n   153\t                                     (:k entry)\n   154\t                                     (:call-id entry))\n   155\t           wait (if-let [[cursor-key stream-key]\n   156\t                         (carried-response-route entry)]\n   157\t                  (assoc wait\n   158\t                         :cursor-ref {:type :cursor-ref, :id cursor-key}\n   159\t                         :stream-id stream-key)\n   160\t                  wait)]\n   161\t       (assoc base\n   162\t              :wait-set (conj (vec (or (:wait-set base) [])) wait)\n   163\t              :control nil\n   164\t              :k nil\n   165\t              :value :yin/blocked\n   166\t              :blocked? true\n   167\t              :halted? false))\n   168\t     (let [call-id (:call-id entry)\n   169\t           base (if call-id (update base :parked dissoc call-id) base)\n   170\t           val (if call-id (ffi/call-result val call-id) val)]\n   171\t       (put-registers base\n   172\t                      (:segment entry)\n   173\t                      (:pc entry)\n   174\t                      val\n   175\t                      (:stack entry)\n   445\t                                     nil)]\n   446\t                   (if-let [[vm' val'] (:continue r)]\n   447\t                     (recur seg (inc pc) val' St E K vm' image\n   448\t                            (and fuel (dec fuel)))\n   449\t                     (:stop r)))\n   450\t              ;; :ffi-call — park-and-call over the FFI pair (21)\n   451\t              21 (let [ffi-op (nth inst 1)\n   452\t                       argc (nth inst 2)\n   453\t                       total (count St)\n   454\t                       args (subvec St (- total argc))\n   455\t                       St' (subvec St 0 (- total argc))\n   456\t                       ;; The pair is checked before parking: an error raised\n   457\t                       ;; after park-continuation would strand a continuation\n   458\t                       ;; in :parked and consume an id counter.\n   459\t                       {:keys [call-in]}\n   460\t                       (ffi/require-call-pair! (:resources vm) ffi-op)\n   461\t                       vm' (put-registers vm seg pc val St' E K)\n   462\t                       parked (engine/park-continuation\n   463\t                                vm'\n   464\t                                {:segment seg, :pc (inc pc),\n   465\t                                 :env E, :stack St', :k K})\n   466\t                       call-id (get-in parked [:value :id])\n   467\t                       request (apply2/request call-id ffi-op args)\n   468\t                       result (apply2/put-request! call-in request)]\n   469\t                   (case (:dao.stream/outcome result)\n   470\t                     :dao.stream/ok\n   471\t                     (-> parked\n   472\t                         (update :wait-set (fnil conj [])\n   473\t                                 (response-wait-entry seg (inc pc) E St' K\n   474\t                                                      call-id))\n   475\t                         (assoc :control nil\n   476\t                                :k nil\n   477\t                                :value :yin/blocked\n   478\t                                :blocked? true\n","exit_code":0,"status":"completed"}}
