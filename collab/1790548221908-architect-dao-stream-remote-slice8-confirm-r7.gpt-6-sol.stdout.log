{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '280,660p'; nl -ba test/yin/vm/ucf/remote_test.cljc | sed -n '1,720p'\"","aggregated_output":"   280\t   round-order on the cell is preserved on the resumer (S7.4.3).\n   281\t   The call's `:op` rides when the entry carries it (the engine's\n   282\t   own response wait does not; a caller assembling the frame takes\n   283\t   it from the call's parked record).\"\n   284\t  [resources mint codec entry]\n   285\t  (if-let [cell (cursor-cell resources entry)]\n   286\t    (if-let [cid (mint codec (:id cell)\n   287\t                       (get resources (:stream-id cell))\n   288\t                       (:cursor cell))]\n   289\t      {:pending (cond-> {:yin.k/reason :ffi,\n   290\t                         :yin.k/call-id (:call-id entry),\n   291\t                         :yin.k/cell cid}\n   292\t                  (contains? entry :op) (assoc :yin.k/op (:op entry))),\n   293\t       :cell? true}\n   294\t      (unsatisfied (local-identity (get resources (:stream-id cell)))))\n   295\t    (unsatisfied)))\n   296\t\n   297\t\n   298\t(defn- lift-write\n   299\t  \"S7.4.3's blocked write: the target stream's marker and the\n   300\t   retained `:datom` -- the value a retry appends, without which the\n   301\t   wait is not re-establishable. A put names a stream, never a\n   302\t   cursor cell.\"\n   303\t  [serve! resources entry]\n   304\t  (let [h (get resources (:stream-id entry))]\n   305\t    (if-let [marker (lift-marker serve! h)]\n   306\t      {:pending {:yin.k/reason :put,\n   307\t                 :yin.k/stream marker,\n   308\t                 :yin.k/value (:datom entry)}}\n   309\t      (unsatisfied (local-identity h)))))\n   310\t\n   311\t\n   312\t(defn- call-out-cell\n   313\t  \"The emitter's call-out cursor cell -- the response route the\n   314\t   retained call had on the emitter: the cursor entry under\n   315\t   `vm/call-out-cursor-key`, reading the call-out stream under\n   316\t   `vm/call-out-stream-key` at its kept position. nil when the\n   317\t   composition holds no call pair, which no real retained request\n   318\t   does -- the pair is checked before the call parked.\"\n   319\t  [resources]\n   320\t  (let [cursor (get resources vm/call-out-cursor-key)\n   321\t        handle (get resources vm/call-out-stream-key)]\n   322\t    (when (and (map? cursor) (contains? cursor :stream-id) handle)\n   323\t      {:id vm/call-out-cursor-key,\n   324\t       :stream-id vm/call-out-stream-key,\n   325\t       :cursor (:cursor cursor)})))\n   326\t\n   327\t\n   328\t(defn- lift-retained-request\n   329\t  \"S7.4.3's retained call: a `:put` entry carrying `:request-sent`,\n   330\t   the request the engine holds unsent. Both endpoints are served --\n   331\t   the request stream's marker and the response stream's marker,\n   332\t   `call-out-cell`'s -- and the retained envelope is read out\n   333\t   verbatim (`:request-op`, `:request-args`) beside the kept\n   334\t   response cell (`:yin.k/response-cell`), so a resumer can\n   335\t   re-establish the carried pair: retry through the request\n   336\t   reflection, wait for the response through the response reflection\n   337\t   at the kept position. Either endpoint unservable refuses as\n   338\t   `:yin.k/unsatisfied` naming that endpoint's identity, before any\n   339\t   value is minted.\"\n   340\t  [serve! resources mint codec entry]\n   341\t  (let [h (get resources (:stream-id entry))\n   342\t        envelope (:datom entry)\n   343\t        route (call-out-cell resources)\n   344\t        resp-h (and route (get resources (:stream-id route)))]\n   345\t    (if-let [marker (lift-marker serve! h)]\n   346\t      (if-let [resp-marker (and resp-h (lift-marker serve! resp-h))]\n   347\t        (if-let [cid (mint codec (:id route) resp-h (:cursor route))]\n   348\t          {:pending {:yin.k/reason :ffi-request,\n   349\t                     :yin.k/call-id (:call-id entry),\n   350\t                     :yin.k/request-op (or (apply2/request-op envelope)\n   351\t                                           (:op entry)),\n   352\t                     :yin.k/request-args (apply2/request-args envelope),\n   353\t                     :yin.k/request marker,\n   354\t                     :yin.k/response resp-marker,\n   355\t                     :yin.k/response-cell cid},\n   356\t           :cell? true}\n   357\t          (unsatisfied (local-identity resp-h)))\n   358\t        (unsatisfied (local-identity resp-h)))\n   359\t      (unsatisfied (local-identity h)))))\n   360\t\n   361\t\n   362\t(defn- lift-link\n   363\t  \"S7.4.3's link variants: the link pair name the engine's own fixed\n   364\t   link keys on a real entry (`module/link-request-resource` and\n   365\t   `module/link-response-resource`), resolved into `:resources`, and\n   366\t   the kept `:cursor` on the response stream\n   367\t   (`module/require-handler` mints it before the envelope is appended)\n   368\t   is the response cell -- a cell like any other, at its kept\n   369\t   position. Both pair markers travel, the engine's `:link-response`\n   370\t   entry retaining its `:request` beside the response side; the\n   371\t   envelope rides verbatim on the request-in-hand variant.\"\n   372\t  [serve! resources mint codec entry]\n   373\t  (let [reason (:reason entry)\n   374\t        resp-h (get resources (:response entry))\n   375\t        req-h (get resources (:request entry))\n   376\t        kept (:cursor entry)]\n   377\t    (if-let [cid (mint codec [(:response entry) kept] resp-h kept)]\n   378\t      (let [resp (lift-marker serve! resp-h)\n   379\t            req (lift-marker serve! req-h)]\n   380\t        (if (and resp req)\n   381\t          {:pending (cond-> {:yin.k/reason reason,\n   382\t                             :yin.k/link-id (:link-id entry),\n   383\t                             :yin.k/name (:name entry),\n   384\t                             :yin.k/request req,\n   385\t                             :yin.k/response resp,\n   386\t                             :yin.k/cell cid}\n   387\t                      (= :link-request reason)\n   388\t                      (assoc :yin.k/envelope (:envelope entry))),\n   389\t           :cell? true}\n   390\t          (unsatisfied (local-identity (or req-h resp-h)))))\n   391\t      (unsatisfied (local-identity resp-h)))))\n   392\t\n   393\t\n   394\t(defn- lift-one\n   395\t  \"One pending entry of S7.4.3, lifted into `{:pending data,\n   396\t   :cell? bool}` -- `:cell?` true when the variant names a cursor\n   397\t   cell, which is what puts `:dao.stream.remote/v1` in\n   398\t   `:yin.k/cursor-profiles` -- or an outcome carrying\n   399\t   `:yin.k/status`: `:yin.k/unsatisfied` when a stream cannot be\n   400\t   served or a kept cursor does not survive the codec round trip;\n   401\t   `:yin.k/undecodable`, naming the reason, when the entry is no\n   402\t   variant at all.\"\n   403\t  [serve! resources mint codec entry]\n   404\t  (case (:reason entry)\n   405\t    :next\n   406\t    (if (:call-id entry)\n   407\t      (lift-response-wait resources mint codec entry)\n   408\t      (lift-read resources mint codec entry))\n   409\t\n   410\t    :put\n   411\t    (if (:request-sent entry)\n   412\t      (lift-retained-request serve! resources mint codec entry)\n   413\t      (lift-write serve! resources entry))\n   414\t\n   415\t    :link-request (lift-link serve! resources mint codec entry)\n   416\t\n   417\t    :link-response (lift-link serve! resources mint codec entry)\n   418\t\n   419\t    :install\n   420\t    {:pending {:yin.k/reason :install, :yin.k/name (:name entry)}}\n   421\t\n   422\t    {:yin.k/status :yin.k/undecodable, :yin.k/reason (:reason entry)}))\n   423\t\n   424\t\n   425\t;; =============================================================================\n   426\t;; Lift: the frame and the single entry\n   427\t;; =============================================================================\n   428\t\n   429\t(defn lift-frame\n   430\t  \"A whole frame set of S7.4.3 pending entries, lifted together:\n   431\t   `{:yin.k/pending [data ...], :yin.k/cells {cell-id cell},\n   432\t   :yin.k/requires requires}` on success -- the cells minted across\n   433\t   the WHOLE set, so two waiters on one engine cursor cell lift to\n   434\t   one UCF cell (S7.5.3) and `:dao.stream.remote/v1` rides in\n   435\t   `:yin.k/cursor-profiles` when any entry names a cell; the S7.9\n   436\t   `:yin.k/unsatisfied` outcome, naming the stream identity where one\n   437\t   is known, when any entry's stream cannot be served or its kept\n   438\t   cursor does not survive the codec round trip; the S7.9\n   439\t   `:yin.k/undecodable` outcome when any entry names no variant.\n   440\t   Failure is total (S7.5.4): a refused leaf refuses the frame.\"\n   441\t  ([serve! resources entries]\n   442\t   (lift-frame serve! resources entries cursor-codec))\n   443\t  ([serve! resources entries codec]\n   444\t   (let [found (atom {:cells {}, :of {}})\n   445\t         mint (mint-cell serve! found)\n   446\t         lifted (mapv #(lift-one serve! resources mint codec %) entries)]\n   447\t     (if-let [refusal (some #(when (contains? % :yin.k/status) %) lifted)]\n   448\t       refusal\n   449\t       {:yin.k/pending (mapv :pending lifted),\n   450\t        :yin.k/cells (:cells @found),\n   451\t        :yin.k/requires (if (some :cell? lifted) requires {})}))))\n   452\t\n   453\t\n   454\t(defn lift-pending\n   455\t  \"One pending entry of S7.4.3, lifted into its own self-contained\n   456\t   cell table: `{:yin.k/pending data, :yin.k/cells {cell-id cell},\n   457\t   :yin.k/requires requires}` on success, with the same `:yin.k/\n   458\t   unsatisfied` and `:yin.k/undecodable` outcomes `lift-frame`\n   459\t   gives. Frame assembly that shares cells across entries is\n   460\t   `lift-frame`'s.\"\n   461\t  ([serve! resources entry]\n   462\t   (lift-pending serve! resources entry cursor-codec))\n   463\t  ([serve! resources entry codec]\n   464\t   (let [r (lift-frame serve! resources [entry] codec)]\n   465\t     (if (contains? r :yin.k/status)\n   466\t       r\n   467\t       (assoc r :yin.k/pending (first (:yin.k/pending r)))))))\n   468\t\n   469\t\n   470\t;; =============================================================================\n   471\t;; Lower: back into resources and a wait-set entry\n   472\t;; =============================================================================\n   473\t\n   474\t(def ^:private fixed-resource-keys\n   475\t  \"The VM's fixed private resource keys -- the FFI call pair and the\n   476\t   link pair. Batch-allocated keys never collide with them, and the\n   477\t   lower installs nothing at them but what the engine's own dispatch\n   478\t   reads there: the link pair, and a retained request's fixed local\n   479\t   call-in key.\"\n   480\t  #{vm/call-in-stream-key vm/call-out-stream-key\n   481\t    vm/call-out-cursor-key module/link-request-resource\n   482\t    module/link-response-resource})\n   483\t\n   484\t\n   485\t(defn- fresh-key\n   486\t  \"The next private resource key `used` does not hold, claiming it:\n   487\t   `:yin.k/k-1`, `:yin.k/k-2`, ... regenerating on any collision\n   488\t   with the receiver's existing resources, the VM's fixed keys, or\n   489\t   keys this batch already allocated.\"\n   490\t  [used]\n   491\t  (loop [n (inc (count @used))]\n   492\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n   493\t      (if (contains? @used k)\n   494\t        (recur (inc n))\n   495\t        (do (swap! used conj k) k)))))\n   496\t\n   497\t\n   498\t(defn- pending-markers\n   499\t  \"Every stream marker `pending` names beside its cells' -- the\n   500\t   target of a put, both endpoints of a retained call, the pair of\n   501\t   a link request.\"\n   502\t  [pending]\n   503\t  (case (:yin.k/reason pending)\n   504\t    :put [(:yin.k/stream pending)]\n   505\t    :ffi-request [(:yin.k/request pending)\n   506\t                  (:yin.k/response pending)]\n   507\t    (:link-request :link-response)\n   508\t    [(:yin.k/request pending)\n   509\t     (:yin.k/response pending)]\n   510\t    []))\n   511\t\n   512\t\n   513\t(defn- attach-all\n   514\t  \"One attach per distinct stream identity. The first attach that\n   515\t   does not answer ok -- a reflection marked gone included -- refuses\n   516\t   the lower as `:yin.k/unsatisfied` naming that identity. Returns\n   517\t   {:handles {identity handle}}; `lower-frame` allocates each\n   518\t   reflection its own collision-free resource key.\"\n   519\t  [attach! markers]\n   520\t  (let [by-id (reduce (fn [m mkr]\n   521\t                        (update m (:dao.stream/identity mkr) #(or % mkr)))\n   522\t                      {} markers)]\n   523\t    (reduce-kv (fn [acc identity mkr]\n   524\t                 (if-let [h (lower-marker attach! mkr)]\n   525\t                   (assoc-in acc [:handles identity] h)\n   526\t                   (reduced (unsatisfied identity))))\n   527\t               {:handles {}}\n   528\t               by-id)))\n   529\t\n   530\t\n   531\t(defn- cell-resources\n   532\t  \"The fresh cursor entry each UCF cell lowers to, under the key\n   533\t   `cell-keys` allocated for it: its carried position, on the\n   534\t   reflection of the stream the cell names. Two references to one\n   535\t   cell share the one entry, and one ref per cell keeps its own\n   536\t   (S7.5.3); equal cell ids across separately lowered frames got\n   537\t   different keys, so no two frames ever share an entry. A response\n   538\t   route is no exception: it lowers under its own fresh key, never\n   539\t   at a fixed key, so distinct routes stay distinct and no migrated\n   540\t   route can ever misroute a new call.\"\n   541\t  [streams cells cell-keys]\n   542\t  (into {}\n   543\t        (map (fn [[cid cell]]\n   544\t               [(cell-keys cid)\n   545\t                {:stream-id (streams (cell-identity cells cid)),\n   546\t                 :cursor (:yin.k/position cell)}]))\n   547\t        cells))\n   548\t\n   549\t\n   550\t(defn- link-pair-resources\n   551\t  \"The engine's fixed link keys (`module/link-request-resource`,\n   552\t   `module/link-response-resource`) mapped onto the reflections a\n   553\t   lowered link wait uses: the engine's sweep retries a\n   554\t   `:link-request` by appending at the fixed request key\n   555\t   (`module/append-link-request`) and polls a `:link-response` at the\n   556\t   fixed response key (`poll-link-response`), so a lowered link wait\n   557\t   parks where the engine looks. One pair per task: the identity of\n   558\t   each side rides the pending's own markers.\"\n   559\t  [streams resources pendings]\n   560\t  (reduce (fn [acc pending]\n   561\t            (if (contains? #{:link-request :link-response}\n   562\t                           (:yin.k/reason pending))\n   563\t              (let [req-id (get-in pending [:yin.k/request\n   564\t                                            :dao.stream/identity])\n   565\t                    resp-id (get-in pending [:yin.k/response\n   566\t                                             :dao.stream/identity])\n   567\t                    req (get resources (streams req-id))\n   568\t                    resp (get resources (streams resp-id))]\n   569\t                (if (and req resp)\n   570\t                  (assoc acc\n   571\t                         module/link-request-resource req,\n   572\t                         module/link-response-resource resp)\n   573\t                  acc))\n   574\t              acc))\n   575\t          {}\n   576\t          pendings))\n   577\t\n   578\t\n   579\t(defn- lower-one\n   580\t  \"One pending of S7.4.3, lowered: `{:entry e}` -- the wait-set\n   581\t   entry the receiver parks, the caller's register context `ctx`\n   582\t   merged verbatim under the stream and cell fields the data\n   583\t   rebuilds -- or an outcome carrying `:yin.k/status`, naming the\n   584\t   stream identity where one is known. Every wait polls the key\n   585\t   `cell-keys` allocated for its cell, reading the stream key\n   586\t   `streams` allocated for the cell's reflection: migrated waits\n   587\t   poll routes no new call shares. A retained request's retry\n   588\t   writes through the request reflection's allocated key and stamps\n   589\t   the carried response route (`:response-cursor`,\n   590\t   `:response-stream`) for its restore.\"\n   591\t  [pending ctx streams cells cell-keys]\n   592\t  (case (:yin.k/reason pending)\n   593\t    :next\n   594\t    (let [cid (:yin.k/cell pending)]\n   595\t      (if-let [sid (streams (cell-identity cells cid))]\n   596\t        {:entry (merge ctx\n   597\t                       {:reason :next,\n   598\t                        :stream-id sid,\n   599\t                        :cursor-ref {:type :cursor-ref,\n   600\t                                     :id (cell-keys cid)}})}\n   601\t        (unsatisfied (cell-identity cells cid))))\n   602\t\n   603\t    :put\n   604\t    (if-let [sid (streams (get-in pending [:yin.k/stream\n   605\t                                           :dao.stream/identity]))]\n   606\t      {:entry (merge ctx\n   607\t                     {:reason :put,\n   608\t                      :stream-id sid,\n   609\t                      :datom (:yin.k/value pending)})}\n   610\t      (unsatisfied (get-in pending [:yin.k/stream :dao.stream/identity])))\n   611\t\n   612\t    :ffi\n   613\t    (let [cid (:yin.k/cell pending)]\n   614\t      (if-let [sid (streams (cell-identity cells cid))]\n   615\t        {:entry (merge ctx\n   616\t                       (cond-> {:reason :next,\n   617\t                                :call-id (:yin.k/call-id pending),\n   618\t                                :stream-id sid,\n   619\t                                :cursor-ref {:type :cursor-ref,\n   620\t                                             :id (cell-keys cid)}}\n   621\t                         (contains? pending :yin.k/op)\n   622\t                         (assoc :op (:yin.k/op pending))))}\n   623\t        (unsatisfied (cell-identity cells cid))))\n   624\t\n   625\t    :ffi-request\n   626\t    (let [req-id (get-in pending [:yin.k/request\n   627\t                                  :dao.stream/identity])\n   628\t          resp-id (get-in pending [:yin.k/response\n   629\t                                   :dao.stream/identity])\n   630\t          route-cid (:yin.k/response-cell pending)\n   631\t          route-id (cell-identity cells route-cid)]\n   632\t      (if-let [req (streams req-id)]\n   633\t        (if-let [resp (streams resp-id)]\n   634\t          (if-let [route (streams route-id)]\n   635\t            {:entry (merge ctx\n   636\t                           {:reason :put,\n   637\t                            :request-sent true,\n   638\t                            :call-id (:yin.k/call-id pending),\n   639\t                            :op (:yin.k/request-op pending),\n   640\t                            :stream-id req,\n   641\t                            :datom (apply2/request\n   642\t                                     (:yin.k/call-id pending)\n   643\t                                     (:yin.k/request-op pending)\n   644\t                                     (:yin.k/request-args pending)),\n   645\t                            :response-cursor (cell-keys route-cid),\n   646\t                            :response-stream resp})}\n   647\t            (unsatisfied route-id))\n   648\t          (unsatisfied resp-id))\n   649\t        (unsatisfied req-id)))\n   650\t\n   651\t    (:link-request :link-response)\n   652\t    (let [reason (:yin.k/reason pending)\n   653\t          cid (:yin.k/cell pending)\n   654\t          sid (streams (cell-identity cells cid))\n   655\t          req (streams (get-in pending [:yin.k/request\n   656\t                                        :dao.stream/identity]))]\n   657\t      (if (and sid req)\n   658\t        {:entry (merge ctx\n   659\t                       (cond-> {:reason reason,\n   660\t                                :link-id (:yin.k/link-id pending),\n     1\t(ns yin.vm.ucf.remote-test\n     2\t  \"The slice 8 acceptance row\n     3\t   (`docs/design/dao.stream.remote.implementation-plan.md` slice 8;\n     4\t   `yin.vm.universal-continuation-format.md` S7.4.3, S7.5.3, S7.11.1\n     5\t   'Reflection acceptance'): a REAL machine parked through the engine\n     6\t   on a `:stream-next` wait migrates with a kept cursor and resumes\n     7\t   equivalently in a fresh engine state through a reflection; forced\n     8\t   eviction yields `gap` with the source's own recovery cursor; a\n     9\t   kept cursor that cannot survive the channel codec refuses the lift\n    10\t   before any cell is published; a source `serve!` refuses is\n    11\t   `:yin.k/unsatisfied`; an `attach!` that answers gone is\n    12\t   `:yin.k/unsatisfied` naming the stream at lower. Cursor cells are\n    13\t   minted and remapped across a whole frame set: two waiters on one\n    14\t   engine cell lift to one UCF cell and lower back shared, and\n    15\t   independent cells at one position stay independent (S7.5.3). The\n    16\t   remaining S7.4.3 variants -- `:put`, `:ffi`, `:ffi-request`,\n    17\t   `:link-request`, `:link-response`, `:install` -- round-trip\n    18\t   through stub `serve!`/`attach!` callbacks over the engine's own\n    19\t   wait-set shapes, since their proof is the shape of the bridge, not\n    20\t   the transport. The lowered waits the engine resolves at its own\n    21\t   fixed resource keys resume there for real: a retained\n    22\t   `:link-request` migrates and the engine's own poll retries it and\n    23\t   resumes on the response read at the fixed link keys; a retained\n    24\t   FFI request migrates, its retry appends at the fixed call-in key,\n    25\t   and the restored response wait -- `semantic-restore` parks it on\n    26\t   the receiver's fixed local call-out keys -- receives the retried\n    27\t   response the route cell carried.\"\n    28\t  (:require [clojure.test :refer [deftest is testing]]\n    29\t            [dao.stream :as stream]\n    30\t            [dao.stream.apply :as apply2]\n    31\t            [dao.stream.remote :as remote]\n    32\t            [dao.stream.ringbuffer :as ringbuffer]\n    33\t            [yin.vm :as vm]\n    34\t            [yin.vm.linearize :as linearize]\n    35\t            [yin.vm.module :as module]\n    36\t            [yin.vm.semantic :as semantic]\n    37\t            [yin.vm.ucf.remote :as ucf.remote]))\n    38\t\n    39\t\n    40\t;; =============================================================================\n    41\t;; The toy: two in-process ring buffers as the channel (as\n    42\t;; dao.stream.remote-test), with a served-table `serve!` on top\n    43\t;; =============================================================================\n    44\t\n    45\t(defn- ring\n    46\t  [capacity]\n    47\t  (:dao.stream/handle\n    48\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    49\t                         :dao.stream.ringbuffer/capacity capacity})))\n    50\t\n    51\t\n    52\t(defn- toy\n    53\t  []\n    54\t  (let [ab (ring 64)\n    55\t        ba (ring 64)\n    56\t        cd {:dao.stream/type :dao.stream.test/channel\n    57\t            :dao.stream/identity \"ucf-remote-toy\"}]\n    58\t    {:channel cd, :ab ab, :ba ba,\n    59\t     :a-end {:reader ba, :writer ab},\n    60\t     :b-end {:reader ab, :writer ba}}))\n    61\t\n    62\t\n    63\t(defn- served-peer\n    64\t  [t]\n    65\t  {:table (atom {})\n    66\t   :b-reader (:reader (:b-end t))\n    67\t   :b-writer (:writer (:b-end t))\n    68\t   :mirror (atom (:dao.stream/cursor\n    69\t                   (stream/cursor (:reader (:b-end t)) :dao.stream/oldest)))})\n    70\t\n    71\t\n    72\t(defn- serve-mirror!\n    73\t  \"One mirror step over everything pending on the toy's request\n    74\t   buffer.\"\n    75\t  [peer]\n    76\t  (swap! (:mirror peer)\n    77\t         #(remote/mirror-step @(:table peer) (:b-reader peer) %\n    78\t                              (:b-writer peer))))\n    79\t\n    80\t\n    81\t(defn- server\n    82\t  \"The exporter's `serve!` (dao.stream.remote.md S2.3): assigns a\n    83\t   stable identity to `h`, entering it in the peer's table under\n    84\t   `chan`, if it is not already served. The served surface defaults\n    85\t   to reader only; a stream the remote writes through -- a link\n    86\t   request stream the lowered retry appends to, a call-in stream the\n    87\t   retried FFI request lands on -- is served with the writer surface\n    88\t   too.\"\n    89\t  ([peer chan] (server peer chan #{:reader}))\n    90\t  ([peer chan surfaces]\n    91\t   (fn [h]\n    92\t     (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\n    93\t                             @(:table peer))]\n    94\t       {:dao.stream/identity existing, :dao.stream/channel chan}\n    95\t       (let [id (str (gensym \"seg\"))]\n    96\t         (swap! (:table peer) assoc id {:handle h, :surface surfaces})\n    97\t         {:dao.stream/identity id, :dao.stream/channel chan})))))\n    98\t\n    99\t\n   100\t(defn- attacher\n   101\t  [t]\n   102\t  (remote/attacher\n   103\t    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\n   104\t\n   105\t\n   106\t;; =============================================================================\n   107\t;; The emitter side: a real machine parked through the engine\n   108\t;; =============================================================================\n   109\t\n   110\t(def ^:private secret\n   111\t  \"The capability secret the test composition gives its machines.\"\n   112\t  \"yin.vm.ucf.remote-test/capability-secret\")\n   113\t\n   114\t\n   115\t(defn- make-ring-stream\n   116\t  \"The ring-buffer `:make-stream` this composition gives its\n   117\t   machines -- `yin.vm.test-utils`'s choice, at test scale.\"\n   118\t  [capacity]\n   119\t  (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n   120\t                       :dao.stream.ringbuffer/capacity capacity}))\n   121\t\n   122\t\n   123\t(defn- new-machine\n   124\t  \"A fresh semantic machine over that composition.\"\n   125\t  []\n   126\t  (semantic/create-vm {:make-stream make-ring-stream\n   127\t                       :capability-secret secret}))\n   128\t\n   129\t\n   130\t(def ^:private load-ast\n   131\t  \"The trusted fresh path: the AST linearizer behind the code loader.\"\n   132\t  (vm/fresh-code-loader (linearize/ast-loader semantic/vm-load-program)\n   133\t                        vm/ast-contract))\n   134\t\n   135\t\n   136\t(defn- var-ref\n   137\t  [n]\n   138\t  {:type :variable, :name n})\n   139\t\n   140\t\n   141\t(defn- let1\n   142\t  \"`((fn [param] body) init)`.\"\n   143\t  [param init body]\n   144\t  {:type :application,\n   145\t   :operator {:type :lambda, :params [param], :body body},\n   146\t   :operands [init]})\n   147\t\n   148\t\n   149\t(defn- reader-datoms\n   150\t  \"Make a stream of `capacity`, mint a cursor on it, read one value.\"\n   151\t  [capacity]\n   152\t  (vm/ast->datoms\n   153\t    (let1 's {:type :stream/make, :buffer capacity}\n   154\t          {:type :stream/next,\n   155\t           :source {:type :stream/cursor, :source (var-ref 's)}})))\n   156\t\n   157\t\n   158\t(defn- parked-reader\n   159\t  \"A real machine parked through the engine on a `:stream-next` wait\n   160\t   over a fresh ring buffer: the code datoms, the parked VM, its\n   161\t   wait-set entry, and the stream handle the entry polls.\"\n   162\t  [capacity]\n   163\t  (let [datoms (reader-datoms capacity)\n   164\t        parked (vm/run (load-ast (new-machine) datoms))\n   165\t        entry (first (:wait-set parked))]\n   166\t    [datoms parked entry\n   167\t     (get (:resources parked) (:stream-id entry))]))\n   168\t\n   169\t\n   170\t(defn- lit\n   171\t  [v]\n   172\t  {:type :literal, :value v})\n   173\t\n   174\t\n   175\t(defn- one-slot-stream\n   176\t  \"A stream that answers `full` while one value sits in it -- the one\n   177\t   append outcome a ring buffer never gives (a ringbuffer evicts),\n   178\t   without which no request stays retained. Reading the value frees\n   179\t   the slot. The descriptor answers ok, so the reflection's attach\n   180\t   probe is answerable.\"\n   181\t  [identity]\n   182\t  (let [slot (atom :empty)]\n   183\t    (reify\n   184\t      stream/IDaoStreamDescriptor\n   185\t      (descriptor\n   186\t        [_]\n   187\t        {:dao.stream/outcome :dao.stream/ok,\n   188\t         :dao.stream/identity identity,\n   189\t         :dao.stream/descriptor\n   190\t         {:dao.stream/type :dao.stream.test/channel,\n   191\t          :dao.stream/identity identity}})\n   192\t\n   193\t\n   194\t      stream/IDaoStreamReader\n   195\t\n   196\t      (cursor\n   197\t        [_ _anchor]\n   198\t        {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor 0})\n   199\t\n   200\t      (next\n   201\t        [_ cursor]\n   202\t        (if (and (= 0 cursor) (not= :empty @slot))\n   203\t          (let [v @slot]\n   204\t            (reset! slot :empty)\n   205\t            {:dao.stream/outcome :dao.stream/ok,\n   206\t             :dao.stream/value v, :dao.stream/cursor 1})\n   207\t          {:dao.stream/outcome :dao.stream/blocked}))\n   208\t\n   209\t\n   210\t      stream/IDaoStreamWriter\n   211\t\n   212\t      (append!\n   213\t        [_ v]\n   214\t        (if (not= :empty @slot)\n   215\t          {:dao.stream/outcome :dao.stream/full}\n   216\t          (do (reset! slot v)\n   217\t              {:dao.stream/outcome :dao.stream/ok}))))))\n   218\t\n   219\t\n   220\t(defn- requirer-datoms\n   221\t  \"The datoms of `(require name)` -- the effectful primitive whose\n   222\t   miss parks mid-link (`module/require-handler`).\"\n   223\t  [name]\n   224\t  (vm/ast->datoms\n   225\t    {:type :application,\n   226\t     :operator {:type :variable, :name 'require},\n   227\t     :operands [(lit name)]}))\n   228\t\n   229\t\n   230\t(defn- linking-machine\n   231\t  \"A fresh semantic machine composed over a link pair, the module\n   232\t   kernel's own composition keys (`yin.vm.linker.md` S6.1).\"\n   233\t  [request response]\n   234\t  (semantic/create-vm\n   235\t    {:make-stream make-ring-stream,\n   236\t     :capability-secret secret,\n   237\t     :modules (module/default-registry),\n   238\t     :link-request request,\n   239\t     :link-response response}))\n   240\t\n   241\t\n   242\t(defn- linked-machine\n   243\t  \"A fresh semantic machine whose registry already holds `name` as a\n   244\t   host module: `settle`'s own linked-meanwhile answer, no install\n   245\t   child needed.\"\n   246\t  [name]\n   247\t  (semantic/create-vm\n   248\t    {:make-stream make-ring-stream,\n   249\t     :capability-secret secret,\n   250\t     :modules (module/register-host-module\n   251\t                (module/default-registry) name\n   252\t                {'answer 42}\n   253\t                {'answer (vm/primitive-profile 'answer :pure [0]\n   254\t                                               #{} :none)})}))\n   255\t\n   256\t\n   257\t(defn- parked-requirer\n   258\t  \"A real machine parked mid-link by a require: the request stream\n   259\t   holds one warm-up value, so `require-handler`'s append refuses\n   260\t   with full and the entry keeps its envelope -- a retained\n   261\t   `:link-request`, the engine's own fields, registers and pair.\"\n   262\t  [name]\n   263\t  (let [request (one-slot-stream \"link-request\")\n   264\t        response (ring 64)\n   265\t        _ (stream/append! request :warmed)\n   266\t        datoms (requirer-datoms name)\n   267\t        parked (vm/run (load-ast (linking-machine request response)\n   268\t                                 datoms))\n   269\t        entry (first (:wait-set parked))]\n   270\t    [datoms parked entry request response]))\n   271\t\n   272\t\n   273\t(defn- call-node\n   274\t  \"A `:dao.stream.apply/call` of `op` with one literal argument.\"\n   275\t  [op arg]\n   276\t  {:type :dao.stream.apply/call, :op op,\n   277\t   :operands [(lit arg)]})\n   278\t\n   279\t\n   280\t(defn- then\n   281\t  \"`((fn [_] second) first)`: first for its effect, then second.\"\n   282\t  [first-ast second-ast]\n   283\t  {:type :application,\n   284\t   :operator {:type :lambda, :params ['_], :body second-ast},\n   285\t   :operands [first-ast]})\n   286\t\n   287\t\n   288\t(defn- calling-machine\n   289\t  \"A fresh semantic machine composed over an FFI call pair, under the\n   290\t   engine's own fixed pair keys (`vm.cljc`'s `:call-in`/`:call-out`\n   291\t   composition keys).\"\n   292\t  [call-in call-out]\n   293\t  (semantic/create-vm\n   294\t    {:make-stream make-ring-stream,\n   295\t     :capability-secret secret,\n   296\t     :call-in call-in,\n   297\t     :call-out call-out}))\n   298\t\n   299\t\n   300\t(defn- parked-caller\n   301\t  \"A real machine parked on a retained FFI request: the call-in\n   302\t   stream holds one warm-up value, so the first call's put refuses\n   303\t   with full and the entry keeps the request -- the engine's own\n   304\t   `:request-sent` shape, the pair under its fixed resource keys.\n   305\t   `ast` may call again after the first call, so a resume can watch\n   306\t   where a future call routes.\"\n   307\t  [ast]\n   308\t  (let [call-in (one-slot-stream \"call-in\")\n   309\t        call-out (ring 8)\n   310\t        _ (stream/append! call-in :warmed)\n   311\t        datoms (vm/ast->datoms ast)\n   312\t        parked (vm/run (load-ast (calling-machine call-in call-out)\n   313\t                                 datoms))\n   314\t        entry (first (:wait-set parked))]\n   315\t    [datoms parked entry call-in call-out]))\n   316\t\n   317\t\n   318\t(defn- registers-of\n   319\t  \"The register payload a parked entry carries.\"\n   320\t  [entry]\n   321\t  (select-keys entry [:segment :pc :env :stack :k]))\n   322\t\n   323\t\n   324\t(defn- quiesced-receiver\n   325\t  \"The fresh engine state a lower installs into: a real machine over\n   326\t   the same code image, quiesced, holding the lowered resource table\n   327\t   and the lowered wait-set entry -- nothing of the emitter's state\n   328\t   but the code image and the registers the entry carries.\"\n   329\t  ([datoms lowered] (quiesced-receiver datoms lowered (new-machine)))\n   330\t  ([datoms lowered machine]\n   331\t   (assoc (load-ast machine datoms)\n   332\t          :control nil, :k nil,\n   333\t          :value :yin/blocked, :blocked? true, :halted? false,\n   334\t          :wait-set [(:entry lowered)],\n   335\t          :resources (:resources lowered))))\n   336\t\n   337\t\n   338\t(defn- cursor-entries\n   339\t  \"The cursor entries of a lowered resource table: maps keyed by the\n   340\t   UCF cell ids, each carrying its stream id and kept cursor.\"\n   341\t  [table]\n   342\t  (into {} (filter (fn [[_ v]] (and (map? v) (contains? v :stream-id))))\n   343\t        table))\n   344\t\n   345\t\n   346\t;; =============================================================================\n   347\t;; The acceptance row: a real parked machine migrates and resumes\n   348\t;; =============================================================================\n   349\t\n   350\t(deftest migrates-a-real-parked-machine-and-resumes\n   351\t  (let [t (toy)\n   352\t        peer (served-peer t)\n   353\t        serve! (server peer (:channel t))\n   354\t        attach! (attacher t)\n   355\t        [datoms parked entry src] (parked-reader 4)\n   356\t        cid (:id (:cursor-ref entry))\n   357\t        sid (:stream-id entry)\n   358\t        kept (get-in parked [:resources cid :cursor])\n   359\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   360\t        lowered (ucf.remote/lower-pending attach! (:yin.k/pending lifted)\n   361\t                                          (:yin.k/cells lifted)\n   362\t                                          (registers-of entry))\n   363\t        receiver (quiesced-receiver datoms lowered)]\n   364\t    (testing \"the machine parked through the engine\"\n   365\t      (is (vm/blocked? parked))\n   366\t      (is (= :next (:reason entry)))\n   367\t      (is (= :cursor-ref (get-in entry [:cursor-ref :type]))))\n   368\t    (testing \"the lift reads the engine's own wait-set entry\"\n   369\t      (is (= {:yin.k/reason :next, :yin.k/cell :yin.k/c-0}\n   370\t             (:yin.k/pending lifted))\n   371\t          \"the cursor CELL id, S7.5.3 -- not a bare position\")\n   372\t      (is (= kept (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   373\t          \"the cell carries the engine's kept cursor\")\n   374\t      (is (= #{:dao.stream.remote/v1}\n   375\t             (get-in lifted [:yin.k/requires :yin.k/cursor-profiles]))))\n   376\t    (testing \"the lower builds a fresh engine state\"\n   377\t      (let [e (:entry lowered)\n   378\t            rs (:resources lowered)\n   379\t            cid' (get-in e [:cursor-ref :id])\n   380\t            sid' (:stream-id e)]\n   381\t        (is (= (registers-of entry) (registers-of e))\n   382\t            \"the register context rides the lower verbatim\")\n   383\t        (is (not= cid cid'))\n   384\t        (is (not= sid sid'))\n   385\t        (is (not (contains? rs cid)))\n   386\t        (is (not (contains? rs sid)))\n   387\t        (is (= {:stream-id sid', :cursor kept} (get rs cid'))\n   388\t            \"one fresh cursor entry, at the kept position\")\n   389\t        (is (not= src (get rs sid'))\n   390\t            \"the stream entry is a reflection, not the emitter's handle\")\n   391\t        (is (= sid' (get-in rs [cid' :stream-id])))))\n   392\t    (testing \"the emitter's own wait resumes equivalently\"\n   393\t      (stream/append! src \"hello\")\n   394\t      (is (= \"hello\" (vm/value (vm/run parked)))))\n   395\t    (testing \"the migrated wait resumes in the fresh engine state\"\n   396\t      (is (vm/blocked? (vm/run receiver))\n   397\t          \"the reflection answers blocked until the mirror serves\")\n   398\t      (serve-mirror! peer)\n   399\t      (let [done (vm/run receiver)]\n   400\t        (is (vm/halted? done))\n   401\t        (is (= \"hello\" (vm/value done))\n   402\t            \"the source's own value, through the kept cursor\")\n   403\t        (is (empty? (:wait-set done)))))))\n   404\t\n   405\t\n   406\t(deftest forced-eviction-yields-gap-with-the-sources-cursor\n   407\t  (let [t (toy)\n   408\t        peer (served-peer t)\n   409\t        serve! (server peer (:channel t))\n   410\t        attach! (attacher t)\n   411\t        [datoms parked entry src] (parked-reader 2)\n   412\t        cid (:id (:cursor-ref entry))\n   413\t        kept (get-in parked [:resources cid :cursor])\n   414\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   415\t        lowered (ucf.remote/lower-pending attach! (:yin.k/pending lifted)\n   416\t                                          (:yin.k/cells lifted)\n   417\t                                          (registers-of entry))\n   418\t        cid' (get-in (:entry lowered) [:cursor-ref :id])\n   419\t        receiver (quiesced-receiver datoms lowered)]\n   420\t    (stream/append! src \"hello\")\n   421\t    (doseq [v [\"v1\" \"v2\" \"v3\"]]\n   422\t      (stream/append! src v))\n   423\t    (is (vm/blocked? (vm/run receiver)))\n   424\t    (serve-mirror! peer)\n   425\t    (let [expected (stream/next src kept)\n   426\t          done (vm/run receiver)]\n   427\t      (testing \"the program reads the source's own gap, verbatim\"\n   428\t        (is (= :dao.stream/gap (vm/value done)))\n   429\t        (is (= (:dao.stream/cursor expected)\n   430\t               (get-in done [:resources cid' :cursor]))\n   431\t            \"with the source's own recovery cursor in the cell\"))\n   432\t      (testing \"no replay and no silent skip: the walk continues\n   433\t                from the recovery cursor\"\n   434\t        (let [r (get-in done [:resources (:stream-id (:entry lowered))])\n   435\t              recovery (get-in done [:resources cid' :cursor])]\n   436\t          (is (= :dao.stream/blocked\n   437\t                 (:dao.stream/outcome (stream/next r recovery))))\n   438\t          (serve-mirror! peer)\n   439\t          (let [ok (stream/next r recovery)]\n   440\t            (is (= :dao.stream/ok (:dao.stream/outcome ok)))\n   441\t            (is (= \"v2\" (:dao.stream/value ok)))))))))\n   442\t\n   443\t\n   444\t;; =============================================================================\n   445\t;; The fixed keys: lowered link waits and retained FFI requests\n   446\t;; resume through the engine's own poll and retry paths\n   447\t;; =============================================================================\n   448\t\n   449\t(deftest a-lowered-link-request-retries-and-resumes-through-the-engine\n   450\t  (let [t (toy)\n   451\t        peer (served-peer t)\n   452\t        serve! (server peer (:channel t) #{:reader :writer})\n   453\t        attach! (attacher t)\n   454\t        [datoms parked entry req-src resp-src]\n   455\t        (parked-requirer 'host.the-module)\n   456\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   457\t        pending (:yin.k/pending lifted)\n   458\t        lowered (ucf.remote/lower-pending attach! pending\n   459\t                                          (:yin.k/cells lifted)\n   460\t                                          (registers-of entry))\n   461\t        e (:entry lowered)\n   462\t        rs (:resources lowered)\n   463\t        receiver (quiesced-receiver datoms lowered\n   464\t                                    (linked-machine 'host.the-module))]\n   465\t    (testing \"the machine parked through the engine, envelope retained\"\n   466\t      (is (vm/blocked? parked))\n   467\t      (is (= :link-request (:reason entry)))\n   468\t      (is (= module/link-request-resource (:request entry)))\n   469\t      (is (= module/link-response-resource (:response entry)))\n   470\t      (is (map? (:envelope entry)) \"the request the retry appends\"))\n   471\t    (testing \"the lower parks the wait where the engine polls\"\n   472\t      (is (= module/link-request-resource (:request e))\n   473\t          \"the retry appends at the engine's fixed request key\")\n   474\t      (is (= module/link-response-resource (:response e))\n   475\t          \"the poll reads at the engine's fixed response key\")\n   476\t      (is (contains? rs (:request e)))\n   477\t      (is (contains? rs (:response e))\n   478\t          \"the pair's reflections stand under the fixed keys\"))\n   479\t    (testing \"the engine's own poll retries and resumes the require\"\n   480\t      ;; the linker answered before the migration: the response sits\n   481\t      ;; on the emitter's response stream, past the kept cursor\n   482\t      (stream/append! resp-src\n   483\t                      {:status :ok,\n   484\t                       :yin.link/id (:link-id entry),\n   485\t                       :manifest {:yin.module/name 'host.the-module}})\n   486\t      (is (vm/blocked? (vm/run receiver))\n   487\t          \"first poll: the envelope is retried, the answer not yet read\")\n   488\t      (let [w0 (:dao.stream/cursor\n   489\t                 (stream/cursor req-src :dao.stream/oldest))]\n   490\t        (is (= :warmed\n   491\t               (:dao.stream/value (stream/next req-src w0)))\n   492\t            \"reading the warm-up frees the slot the retry needs\"))\n   493\t      (serve-mirror! peer)\n   494\t      (let [c0 (:dao.stream/cursor\n   495\t                 (stream/cursor req-src :dao.stream/oldest))\n   496\t            r (stream/next req-src c0)]\n   497\t        (is (= :dao.stream/ok (:dao.stream/outcome r)))\n   498\t        (is (= (:envelope entry) (:dao.stream/value r))\n   499\t            \"the envelope verbatim, appended via the fixed request key\"))\n   500\t      (let [done (vm/run receiver)]\n   501\t        (is (vm/halted? done))\n   502\t        (is (= 'host.the-module (vm/value done))\n   503\t            \"the require resumes with the module's own value\")\n   504\t        (is (empty? (:wait-set done)))))))\n   505\t\n   506\t\n   507\t(deftest a-retained-ffi-request-migrates-and-the-retry-resumes\n   508\t  (let [t (toy)\n   509\t        peer (served-peer t)\n   510\t        serve! (server peer (:channel t) #{:reader :writer})\n   511\t        attach! (attacher t)\n   512\t        program (then (call-node :op/echo \"hello\")\n   513\t                      (call-node :op/echo \"world\"))\n   514\t        [datoms parked entry call-in-src call-out-src]\n   515\t        (parked-caller program)\n   516\t        kept (get-in parked [:resources vm/call-out-cursor-key :cursor])\n   517\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   518\t        pending (:yin.k/pending lifted)\n   519\t        lowered (ucf.remote/lower-pending attach! pending\n   520\t                                          (:yin.k/cells lifted)\n   521\t                                          (registers-of entry))\n   522\t        e (:entry lowered)\n   523\t        rs (:resources lowered)\n   524\t        ;; the resumer's own pair: the receiving composition supplies\n   525\t        ;; it under the fixed stream keys, and it serves the retried\n   526\t        ;; request and every call the resumed program makes\n   527\t        own-call-in (ring 8)\n   528\t        own-call-out (ring 8)\n   529\t        own (calling-machine own-call-in own-call-out)\n   530\t        own-pair (select-keys (:resources own)\n   531\t                              [vm/call-in-stream-key\n   532\t                               vm/call-out-stream-key\n   533\t                               vm/call-out-cursor-key])\n   534\t        receiver (-> (quiesced-receiver datoms lowered own)\n   535\t                     (update :resources #(merge own-pair %)))\n   536\t        oldest (fn [h]\n   537\t                 (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n   538\t        ;; phase 1: the sweep retries the retained request on the\n   539\t        ;; receiver's own call-in and the restored response wait parks\n   540\t        r1 (vm/run receiver)\n   541\t        a-request (stream/next own-call-in (oldest own-call-in))\n   542\t        a-response (apply2/success-response\n   543\t                     (apply2/request-id (:dao.stream/value a-request))\n   544\t                     \"echo!\")\n   545\t        _ (stream/append! own-call-out a-response)\n   546\t        ;; phase 2: the migrated call resumes and the program's own\n   547\t        ;; next call parks on the receiver's own pair -- no manual\n   548\t        ;; handoff anywhere\n   549\t        r2 (vm/run r1)\n   550\t        b-request (stream/next own-call-in\n   551\t                               (:dao.stream/cursor a-request))\n   552\t        b-response (apply2/success-response\n   553\t                     (apply2/request-id (:dao.stream/value b-request))\n   554\t                     \"world!\")\n   555\t        _ (stream/append! own-call-out b-response)\n   556\t        ;; phase 3: the second call resumes; the program halts\n   557\t        r3 (vm/run r2)]\n   558\t    (testing \"the machine parked through the engine, request retained\"\n   559\t      (is (vm/blocked? parked))\n   560\t      (is (true? (:request-sent entry)))\n   561\t      (is (= vm/call-in-stream-key (:stream-id entry)))\n   562\t      (is (apply2/request? (:datom entry))))\n   563\t    (testing \"the lift carries the response route as a cell\"\n   564\t      (is (= :yin.k/c-0 (:yin.k/response-cell pending)))\n   565\t      (is (= kept\n   566\t             (get-in lifted [:yin.k/cells :yin.k/c-0 :yin.k/position]))\n   567\t          \"the emitter's call-out cursor at its kept position\"))\n   568\t    (testing \"the lower keeps the engine's own shape, pair untouched\"\n   569\t      (is (= vm/call-in-stream-key (:stream-id e))\n   570\t          \"the engine's own retained shape: the receiver's own pair\n   571\t           serves the retried request\")\n   572\t      (is (not (contains? rs vm/call-in-stream-key))\n   573\t          \"the pair itself is the composition's own supply, never\n   574\t           lowered\")\n   575\t      (is (not (contains? rs vm/call-out-stream-key)))\n   576\t      (is (not (contains? rs vm/call-out-cursor-key))\n   577\t          \"no route is ever installed at the fixed call-out cursor\")\n   578\t      (let [route (get rs :yin.k/c-0)]\n   579\t        (is (= kept (:cursor route))\n   580\t            \"the route cell lowers as its own fresh cursor entry\")\n   581\t        (is (not= vm/call-out-stream-key (:stream-id route))\n   582\t            \"naming the emitter's call-out reflection, never the\n   583\t             receiver's key\")\n   584\t        (is (contains? rs (:stream-id route))\n   585\t            \"which is attached, so a co-waiting response wait resolves\n   586\t             it\")))\n   587\t    (testing \"the retried request is served by the receiver's own pair\"\n   588\t      (is (vm/blocked? r1)\n   589\t          \"first round: the request is retried, the response not yet\n   590\t           read\")\n   591\t      (is (= :dao.stream/ok (:dao.stream/outcome a-request)))\n   592\t      (is (= (:datom entry) (:dao.stream/value a-request))\n   593\t          \"the retain