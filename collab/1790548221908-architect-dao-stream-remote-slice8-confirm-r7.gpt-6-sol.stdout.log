or\n   630\t      [_]\n   631\t      {:dao.stream/outcome :dao.stream/ok\n   632\t       :dao.stream/identity \"host-cursor\"\n   633\t       :dao.stream/descriptor\n   634\t       {:dao.stream/type :dao.stream.test/channel\n   635\t        :dao.stream/identity \"host-cursor\"}})\n   636\t\n   637\t\n   638\t    stream/IDaoStreamReader\n   639\t\n   640\t    (cursor\n   641\t      [_ _]\n   642\t      {:dao.stream/outcome :dao.stream/ok\n   643\t       :dao.stream/cursor {:position 0, :owner (fn [x] x)}})\n   644\t\n   645\t    (next\n   646\t      [_ _]\n   647\t      {:dao.stream/outcome :dao.stream/blocked})))\n   648\t\n   649\t\n   650\t(deftest a-cursor-that-cannot-round-trip-is-refused\n   651\t  (let [t (toy)\n   652\t        peer (served-peer t)\n   653\t        serve! (server peer (:channel t))\n   654\t        s (host-cursor-stream)\n   655\t        resources {:yin/host-stream s,\n   656\t                   :yin/host-cursor\n   657\t                   {:stream-id :yin/host-stream,\n   658\t                    :cursor {:position 0, :owner (fn [x] x)}}}\n   659\t        entry {:reason :next,\n   660\t               :cursor-ref {:type :cursor-ref, :id :yin/host-cursor},\n   661\t               :stream-id :yin/host-stream}\n   662\t        refusal (ucf.remote/lift-pending serve! resources entry)]\n   663\t    (is (= :yin.k/unsatisfied (:yin.k/status refusal))\n   664\t        \"the profile claim is checked before anything is published\")\n   665\t    (is (= \"host-cursor\" (:dao.stream/identity refusal))\n   666\t        \"naming the stream identity\")\n   667\t    (is (empty? @(:table peer))\n   668\t        \"refused before `serve!` even mints the descriptor\")))\n   669\t\n   670\t\n   671\t(deftest lift-refuses-unsatisfied-when-the-source-cannot-be-served\n   672\t  (let [s (ring 4)]\n   673\t    (stream/append! s \"x\")\n   674\t    (let [c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   675\t          resources {:yin/s s, :yin/c {:stream-id :yin/s, :cursor c0}}\n   676\t          entry {:reason :next,\n   677\t                 :cursor-ref {:type :cursor-ref, :id :yin/c},\n   678\t                 :stream-id :yin/s}\n   679\t          refusal (ucf.remote/lift-pending (constantly nil) resources entry)]\n   680\t      (is (= :yin.k/unsatisfied (:yin.k/status refusal))\n   681\t          \"lift refuses before minting the value\")\n   682\t      (is (contains? refusal :dao.stream/identity)\n   683\t          \"naming the stream identity\"))))\n   684\t\n   685\t\n   686\t(deftest lower-refuses-unsatisfied-when-the-reflection-is-gone\n   687\t  (let [attach! (constantly {:dao.stream/outcome :dao.stream/transport-error\n   688\t                             :dao.stream.remote/reason\n   689\t                             :dao.stream.remote/not-found})\n   690\t        marker {:yin.k/tag :yin.k/stream,\n   691\t                :dao.stream/identity \"missing\",\n   692\t                :dao.stream/descriptor\n   693\t                {:dao.stream/type :dao.stream/remote,\n   694\t                 :dao.stream/identity \"missing\",\n   695\t                 :dao.stream/channel\n   696\t                 {:dao.stream/type :dao.stream.test/channel,\n   697\t                  :dao.stream/identity \"elsewhere\"}}}\n   698\t        pending {:yin.k/reason :next, :yin.k/cell :yin.k/c-0}\n   699\t        cells {:yin.k/c-0 {:yin.k/stream marker, :yin.k/position 0}}\n   700\t        lowered (ucf.remote/lower-pending attach! pending cells {})]\n   701\t    (is (= :yin.k/unsatisfied (:yin.k/status lowered)))\n   702\t    (is (= \"missing\" (:dao.stream/identity lowered))\n   703\t        \"naming the stream identity\")))\n   704\t\n   705\t\n   706\t;; =============================================================================\n   707\t;; Frame-level cells (S7.5.3): shared and independent\n   708\t;; =============================================================================\n   709\t\n   710\t(defn- stub-serve!\n   711\t