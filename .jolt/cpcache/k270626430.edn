{:material "10340:{:deps {org.clojure/core.async {:mvn/version \"1.8.741\"}\n        org.clojure/tools.reader {:mvn/version \"1.5.0\"}\n        ring/ring {:mvn/version \"1.14.1\"}\n        com.cognitect/transit-clj {:mvn/version \"1.0.333\"}\n        org.replikativ/boring {:mvn/version \"0.1.30\"}\n        com.datomic/peer {:mvn/version \"1.0.7364\"}\n        org.postgresql/postgresql {:mvn/version \"42.7.3\"}\n        org.clojure/data.json {:mvn/version \"2.5.0\"}\n        http-kit/http-kit {:mvn/version \"2.8.0\"}\n        org.jsoup/jsoup {:mvn/version \"1.18.3\"}\n        instaparse/instaparse {:mvn/version \"1.5.0\"}\n        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n        criterium/criterium {:mvn/version \"0.4.6\"}\n        io.github.rctcwyvrn/blake3 {:mvn/version \"1.3\"}\n        stigmergy/chp {:mvn/version \"0.1.0-SNAPSHOT\"\n                       :exclusions [refactor-nrepl/refactor-nrepl]}}\n :cljd/opts {}\n ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n :paths [\"src/clj\" \"src/cljc\" \"src/cljs\" \"src/cljd\"\n         \"build/antlr/python3/classes\" \"build/antlr/php/classes\"\n         \"build/antlr/typescript/classes\"]\n :aliases {:clean {:extra-paths [\"src/dev\"]\n                   :exec-fn clean/clean}\n           :profile-btree {:extra-paths [\"src/dev\"]\n                           :extra-deps {persistent-sorted-set/persistent-sorted-set\n                                        {:mvn/version \"0.3.0\"}}\n                           :main-opts [\"-m\" \"btree-bench\"]}\n           :test {:extra-paths [\"test\"]\n                  :extra-deps {io.github.cognitect-labs/test-runner\n                               {:git/tag \"v0.5.1\" :git/sha \"dfb30dd\"}\n                               ;; latte-kernel: the LaTTe proof assistant's kernel,\n                               ;; the differential oracle for the yang.clojure gap\n                               ;; program (pinned; MIT; dependency-free)\n                               latte-kernel/latte-kernel\n                               {:git/url \"https://github.com/latte-central/latte-kernel\"\n                                :git/sha \"86fca0d1d054af005cb37395eae04500d45e6279\"}}\n                  ;; The guest recursion limit allows depth that needs more than the\n                  ;; JVM's platform default thread stack (1024 KB on Linux, 2048 KB on\n                  ;; macOS): under 1 MB the guard loses to a JVM StackOverflowError\n                  ;; before it can raise Python's RecursionError, so the same tests\n                  ;; pass on macOS and fail on Linux. 4 MB is twice the measured\n                  ;; macOS-default minimum, leaving headroom as the prelude grows.\n                  ;; Evidence: docs/agents/known-gaps.md (the recursion rows).\n                  ;; merged stack policy: -Xss64m supersedes the earlier -Xss4m —\n                  ;; deep assertion payloads (the PHPT selection diagnostics and\n                  ;; the conformance compositions) overflow smaller stacks in\n                  ;; clojure.test's printer on shiva (verified green at -Xss64m;\n                  ;; the 4m minimum for the prelude recursion rows still holds)\n                  :jvm-opts [\"-Xss64m\"]\n                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n                  :exec-fn cognitect.test-runner.api/test}\n           :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           ;; The one ClojureDart pin. Compose it with the build aliases:\n           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...\n           :clojuredart {:extra-deps {sonwh98/clojuredart\n                                      {:git/url \"https://github.com/sonwh98/ClojureDart.git\"\n                                       :sha \"7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31\"}\n                                      }}\n           :cljd {:extra-paths [\"test\"]\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; jolt host configuration (docs/design/yin.repl-jolt-implementation.md\n           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n           ;; src/jolt precedes src/cljc so a host override wins; src/clj is\n           ;; listed for audited portable namespaces only (its JVM namespaces\n           ;; are selected away by :jolt reader branches, never loaded). No\n           ;; generated Java parser classes, no JS/Dart roots, and no\n           ;; dependency coordinate is fetched until a jolt-loaded namespace\n           ;; needs one.\n           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n                  :replace-deps {}}\n           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n           ;; src/dev (src/dev/jolt_test_runner.clj and its sentinel)\n           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n           ;; for the corpus loader dao.jing.cbor-fixtures, whose root must\n           ;; precede test (src/dev/jolt_diag/dao/jing/cbor_fixtures.cljc);\n           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           ;; Build-time generation of the grammars-v4 Python3 parser.\n           ;; The tool version must equal the antlr4-runtime above.\n           :antlr-gen {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           ;; Development/oracle only (datomic-q-v1 Client oracle runner,\n           ;; docs/design/dao.space.query.datomic-compat.md); never a production\n           ;; dependency. Backend deps/config are pinned separately once selected.\n           :oracle {:extra-paths [\"src/dev\" \"test\"]\n                    :extra-deps {com.datomic/client-api {:mvn/version \"1.0.69\"}\n                                 ;; oracle backend: Datomic Local, in-process,\n                                 ;; run in docker/oracle (dev-scope only)\n                                 com.datomic/local {:mvn/version \"1.0.301\"}}}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.repl.main\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yin.repl.python-antlr-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj 