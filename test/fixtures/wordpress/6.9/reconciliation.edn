  "CREATE DEFINER='mysql.sys'@'localhost' PROCEDURE ps_setup_disable_background_threads () COMMENT ' Description ----------- Disable all background thread instrumentation within Performance Schema. Parameters ----------- None. Example ----------- mysql> CALL sys.ps_setup_disable_background_threads(); +--------------------------------+ | summary | +--------------------------------+ | Disabled 18 background threads | +--------------------------------+ 1 row in set (0.00 sec) ' SQL SECURITY INVOKER NOT DETERMINISTIC MODIFIES SQL DATA BEGIN UPDATE performance_schema.threads SET instrumented = 'NO' WHERE type = 'BACKGROUND'; SELECT CONCAT('Disabled ', @rows := ROW_COUNT(), ' background thread', IF(@rows != 1, 's', '')) AS summary; END"
