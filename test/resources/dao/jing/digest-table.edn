;; Cross-provider BLAKE3-256 digest table for Phase H0 of the DaoJing
;; multihash content-addressing rollout
;; (docs/design/dao.jing.hash-registry.md, "Host libraries" section).
;;
;; This is the committed evidence-of-record for the portability spike
;; referenced by that design: the spike's own cross-provider comparison
;; left no durable repository artifact, so this table is regenerated here
;; as the frozen fixture H1's three provider implementations must match
;; byte-for-byte:
;;   :jvm   io.github.rctcwyvrn/blake3 1.3
;;   :cljs  @noble/hashes 2.4.0 (Node and browser Shadow-CLJS builds)
;;   :cljd  blake3_dart 1.0.0
;;
;; Because BLAKE3-256 unkeyed hashing is a fully specified, deterministic
;; algorithm, a conforming provider on every host must produce exactly the
;; digest recorded under :blake3-256 for each case below -- there is no
;; per-host variation to record. This table's role is to pin the one
;; correct answer each provider is checked against, not to record three
;; different observed values. H1's provider-conformance tests read this
;; file and assert (= observed (:blake3-256 case)) on every host.
;;
;; :input-hex is the exact byte sequence hashed, independent of any
;; particular host's string/number representation, so JVM, CLJS, and CLJD
;; fixture readers agree on what bytes to feed their provider before any
;; comparison happens. A hex string too long for one line is written as a
;; vector of string chunks, concatenated by the reader.
;;
;; Canonical-Clojure-data-structure cases were produced by hashing the
;; exact bytes `dao.jing/canonical-bytes` returns for the given value:
;; the canonical CBOR payload of docs/design/dao.jing.cbor.md, as
;; `dao.jing.cbor/encode` writes it (the clean break from the earlier
;; order-normalized print encoder; regenerated 2026-09-24 along with every
;; other DaoJing address fixture, per that plan's clean-break ruling).

{:providers {:jvm  "io.github.rctcwyvrn/blake3 1.3"
             :cljs "@noble/hashes 2.4.0"
             :cljd "blake3_dart 1.0.0"}

 :cases
 [{:label       :empty-bytes
   :input-hex   ""
   :blake3-256
   "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"}

  {:label       :ascii-datom-world
   :description "UTF-8 bytes of the string \"datom.world\""
   :input-hex   "6461746f6d2e776f726c64"
   :blake3-256
   "86a59a1c881ff0b031a6507901256be8141ebb7d257f0311a4dbc9f20e663f0d"}

  {:label       :ascii-hello-world
   :description "UTF-8 bytes of the string \"Hello, world!\""
   :input-hex   "48656c6c6f2c20776f726c6421"
   :blake3-256
   "ede5c0b10f2ec4979c69b52f61e42ff5b413519ce09be0f14d098dcfe5f6f98d"}

  ;; Canonical Clojure data structures, hashed as the exact bytes
  ;; `dao.jing/canonical-bytes` produces (canonical CBOR, dao.jing.cbor.md).
  ;; :input-hex is that byte string; :value is the source form for
  ;; readability only and is not itself hashed.
  {:label       :canonical-nil
   :value       nil
   :input-hex   "f6"
   :blake3-256
   "61a9bf10f0ffedc7dc77589ae2ab4ca80b006c806e6636e41b60410cd8f0bbc4"}

  {:label       :canonical-true
   :value       true
   :input-hex   "f5"
   :blake3-256
   "518f7263ffb8a410e4874915a1f9a3bd7f11daa2f490abcb00939cdeb002fc81"}

  {:label       :canonical-false
   :value       false
   :input-hex   "f4"
   :blake3-256
   "c12fc7f0c31ef2d9f0fcbd2e708b7adeb8bad0e60884f89a2073a16127521641"}

  {:label       :canonical-int
   :value       42
   :input-hex   "182a"
   :blake3-256
   "b828e7bda50941d5618ae287093288dd06a229250fca262764a408defd29f91c"}

  {:label       :canonical-string
   :value       "datom.world"
   :input-hex   "6b6461746f6d2e776f726c64"
   :blake3-256
   "a992800b8b036a740083af906933ef8786431b98f2ce95892f16d13d2f431590"}

  {:label       :canonical-keyword
   :value       :foo/bar
   :input-hex   "d81b827064616f2e6a696e672f6b6579776f72648263666f6f63626172"
   :blake3-256
   "e8a08d8a9ec14cd554139cd4a07e58499901f6d9297ce936b0b2fc0261d5d698"}

  {:label       :canonical-symbol
   :value       sym
   :input-hex   "d81b826f64616f2e6a696e672f73796d626f6c82f66373796d"
   :blake3-256
   "605564e14afdc03ae5342ef2e6cb5c9cffff12da1812bdeb5971facd3e556fb6"}

  {:label       :canonical-vector
   :value       [1 2 3]
   :input-hex   "83010203"
   :blake3-256
   "ae95735439e543cd063b7692a40da8df2c0a94b8d81dc190166bbeddaa8a01f4"}

  {:label       :canonical-set
   :value       #{1 2 3}
   :input-hex   "d9010283010203"
   :blake3-256
   "e89bdf95d8c4b52d7761aa97560e5b3b8f307d063dc2e8a8ba00a92bc246881d"}

  {:label       :canonical-map
   :value       {:a 1, :b [1 2 3]}
   :input-hex   ["a2d81b827064616f2e6a696e672f6b6579776f726482f6616101d81b"
                 "827064616f2e6a696e672f6b6579776f726482f6616283010203"]
   :blake3-256
   "3448f9a67583e234dc0869e808fb8c855daa1d937a7d90a9b1dbbfb1b5ded2fc"}

  {:label       :canonical-list
   :value       (1 2 3)
   :input-hex   "d81b826d64616f2e6a696e672f6c69737483010203"
   :blake3-256
   "b75126a91fdda787248f8b170fd984c27c871a88ef68815d1f8ed882f7adc435"}

  ;; 1023/1024/1025-byte boundary buffers: BLAKE3's chunk length is 1024
  ;; bytes, so these three lengths straddle the single-chunk/two-chunk
  ;; tree-hashing boundary that stresses parent-node construction.
  ;; Byte pattern: input[i] = i mod 251 (the same official-vector rule
  ;; used in blake3-vectors.json, reused here for cross-file
  ;; consistency -- these are the identical byte buffers, not
  ;; independently chosen ones).
  {:label       :boundary-1023
   :input-len   1023
   :input-rule  "input[i] = i % 251"
   :blake3-256
   "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11"}

  {:label       :boundary-1024
   :input-len   1024
   :input-rule  "input[i] = i % 251"
   :blake3-256
   "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7"}

  {:label       :boundary-1025
   :input-len   1025
   :input-rule  "input[i] = i % 251"
   :blake3-256
   "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444"}]}
