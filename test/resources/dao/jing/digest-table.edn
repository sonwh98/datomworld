;; Cross-provider BLAKE3-256 digest table for Phase H0 of the DaoJing
;; multihash content-addressing rollout
;; (docs/design/dao.jing.hash-registry.md, "Host libraries" section).
;;
;; This is the committed evidence-of-record for the portability spike
;; referenced by that design: the spike's own cross-provider comparison
;; left no durable repository artifact, so this table is regenerated here
;; as the frozen fixture H1's three provider implementations must match
;; byte-for-byte:
;;   :jvm   io.github.rctcwyvrn/blake3 1.3
;;   :cljs  @noble/hashes 2.4.0 (Node and browser Shadow-CLJS builds)
;;   :cljd  blake3_dart 1.0.0
;;
;; Because BLAKE3-256 unkeyed hashing is a fully specified, deterministic
;; algorithm, a conforming provider on every host must produce exactly the
;; digest recorded under :blake3-256 for each case below -- there is no
;; per-host variation to record. This table's role is to pin the one
;; correct answer each provider is checked against, not to record three
;; different observed values. H1's provider-conformance tests read this
;; file and assert (= observed (:blake3-256 case)) on every host.
;;
;; :input-hex is the exact byte sequence hashed, independent of any
;; particular host's string/number representation, so JVM, CLJS, and CLJD
;; fixture readers agree on what bytes to feed their provider before any
;; comparison happens.
;;
;; Canonical-Clojure-data-structure cases were produced by hashing the
;; exact bytes `dao.jing/canonical-bytes` returns for the given value at
;; HEAD ba88f769 (the current order-normalized print encoder; this table
;; freezes bytes, not the encoder's mutable behavior -- a future CBOR
;; clean break regenerates this table's canonical-value rows along with
;; every other DaoJing fixture, per dao.jing.cbor.md's clean-break ruling).

{:providers {:jvm  "io.github.rctcwyvrn/blake3 1.3"
             :cljs "@noble/hashes 2.4.0"
             :cljd "blake3_dart 1.0.0"}

 :cases
 [{:label       :empty-bytes
   :input-hex   ""
   :blake3-256  "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"}

  {:label       :ascii-datom-world
   :description "UTF-8 bytes of the string \"datom.world\""
   :input-hex   "6461746f6d2e776f726c64"
   :blake3-256  "86a59a1c881ff0b031a6507901256be8141ebb7d257f0311a4dbc9f20e663f0d"}

  {:label       :ascii-hello-world
   :description "UTF-8 bytes of the string \"Hello, world!\""
   :input-hex   "48656c6c6f2c20776f726c6421"
   :blake3-256  "ede5c0b10f2ec4979c69b52f61e42ff5b413519ce09be0f14d098dcfe5f6f98d"}

  ;; Canonical Clojure data structures, hashed as the exact bytes
  ;; `dao.jing/canonical-bytes` produces (order-normalized print encoder,
  ;; HEAD ba88f769). :input-hex is that byte string; :value is the source
  ;; form for readability only and is not itself hashed.
  {:label       :canonical-nil
   :value       nil
   :input-hex   "6e696c"
   :blake3-256  "f2ebafc4960f3bcffbd79b2478942adcbc0846fd66f3700ecb552754ddd883c5"}

  {:label       :canonical-true
   :value       true
   :input-hex   "74727565"
   :blake3-256  "acc8a7699a2bf4cbd05f69678eac4fc236572041c28dfd0ab558e5fcf2ab6540"}

  {:label       :canonical-false
   :value       false
   :input-hex   "66616c7365"
   :blake3-256  "401f18ad0cca38559086c36f9e0295f1ca3a7023e5f095aeef69177a9b8f10ce"}

  {:label       :canonical-int
   :value       42
   :input-hex   "3432"
   :blake3-256  "da136474d7575c325f702bb7aa75f1123864033cc488bf7d9c074eadaf9bd0d3"}

  {:label       :canonical-string
   :value       "datom.world"
   :input-hex   "226461746f6d2e776f726c6422"
   :blake3-256  "58e563d83507ae1e24c15019f3dd2db61ec3818a5f8ea8e662564a420133fe7f"}

  {:label       :canonical-keyword
   :value       :foo/bar
   :input-hex   "3a666f6f2f626172"
   :blake3-256  "29e9991e5ccc58eba37e2cc672fd027cdefb9d8b0a66e4aefd8fc33b2a41efd2"}

  {:label       :canonical-symbol
   :value       sym
   :input-hex   "73796d"
   :blake3-256  "7c7a38437690e8d421bdc4eac95ae04560687741a203b2c7425b808b9372f57d"}

  {:label       :canonical-vector
   :value       [1 2 3]
   :input-hex   "5b31203220335d"
   :blake3-256  "c3a8cc55ea53e056552eab337f404b352cc9415d386d8cc399edc356f5d9b012"}

  {:label       :canonical-set
   :value       #{1 2 3}
   :input-hex   "237b31203220337d"
   :blake3-256  "d7f04e71efc563f1eb156135e263015577473bc1bd6573c898bd052c6c01abc4"}

  {:label       :canonical-map
   :value       {:a 1, :b [1 2 3]}
   :input-hex   "7b3a6120312c203a62205b31203220335d7d"
   :blake3-256  "071b8ef1a7ed55cee6f16c9c103981783c773b21dab1222b49cba0130dcf0103"}

  {:label       :canonical-list
   :value       (1 2 3)
   :input-hex   "28312032203329"
   :blake3-256  "c43c8b25455f5f9e3b7c163347b3b7ee1d34738acc0d67d41c64e329effe387f"}

  ;; 1023/1024/1025-byte boundary buffers: BLAKE3's chunk length is 1024
  ;; bytes, so these three lengths straddle the single-chunk/two-chunk
  ;; tree-hashing boundary that stresses parent-node construction.
  ;; Byte pattern: input[i] = i mod 251 (the same official-vector rule
  ;; used in blake3-vectors.json, reused here for cross-file
  ;; consistency -- these are the identical byte buffers, not
  ;; independently chosen ones).
  {:label       :boundary-1023
   :input-len   1023
   :input-rule  "input[i] = i % 251"
   :blake3-256  "10108970eeda3eb932baac1428c7a2163b0e924c9a9e25b35bba72b28f70bd11"}

  {:label       :boundary-1024
   :input-len   1024
   :input-rule  "input[i] = i % 251"
   :blake3-256  "42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7"}

  {:label       :boundary-1025
   :input-len   1025
   :input-rule  "input[i] = i % 251"
   :blake3-256  "d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444"}]}
