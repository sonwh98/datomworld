   :source
   "<?php\nclass Foo {\n    public int $bbb;\n}\n\nfunction foo() {\n    return new Foo();\n}\n\nfunction bar() {\n    return str_repeat(\"b\", 3);\n}\n\nfor ($i = 0; $i < 5; $i++) {\n    try {\n        foo()->{bar()} = str_repeat(\"a\", 3);\n    } catch (Throwable $e) {\n        echo $e->getMessage() . \"\\n\";\n    }\n}\n?>",
