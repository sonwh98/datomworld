er);\n$OuterMatcher->methodNameMatcher = null;\n$OuterMatcher->stub = new PHPUnit_Framework_MockObject_Stub_ReturnCallback([$foo, 'callback']);\n$a = $b = $c = 0;\n$foo->bar($a, $b, $c);\n?>",
