  {:id "Zend/tests/readonly_props/readonly_clone_error5.phpt",
   :path "Zend/tests/readonly_props/readonly_clone_error5.phpt",
   :source
   "<?php\n\ntrait CloneSetOnceTrait {\n    public function __clone() {\n        $this->prop[] = 1;\n    }\n}\n\ntrait CloneSetTwiceTrait {\n    public function __clone() {\n        $this->prop[] = 1;\n        $this->prop[] = 2;\n    }\n}\n\nclass TestSetOnce {\n    use CloneSetOnceTrait;\n    public readonly array $prop;\n    public function __construct() {\n        $this->prop = [];\n    }\n}\n\nclass TestSetTwice {\n    use CloneSetTwiceTrait;\n    public readonly array $prop;\n    public function __construct() {\n        $this->prop = [];\n    }\n}\n\ntry {\n    var_dump(clone (new TestSetOnce()));\n} catch (Error $e) {\n    echo $e->getMessage(), \"\\n\";\n}\n\ntry {\n    var_dump(clone (new TestSetOnce()));\n} catch (Error $e) {\n    echo $e->getMessage(), \"\\n\";\n}\n\ntry {\n    var_dump(clone (new TestSetTwice()));\n} catch (Error $e) {\n    echo $e->getMessage(), \"\\n\";\n}\n\ntry {\n    var_dump(clone (new TestSetTwice()));\n} catch (Error $e) {\n    echo $e->getMessage(), \"\\n\";\n}\n\n?>",
   :title "Readonly property clone indirect variation for JIT",
   :expect
   "object(TestSetOnce)#2 (1) {\n  [\"prop\"]=>\n  array(1) {\n    [0]=>\n    int(1)\n  }\n}\nobject(TestSetOnce)#1 (1) {\n  [\"prop\"]=>\n  array(1) {\n    [0]=>\n    int(1)\n  }\n}\nCannot modify readonly property TestSetTwice::$prop\nCannot modify readonly property TestSetTwice::$prop",
   :needs :p4}
  {:id "Zend/tests/readonly_props/readonly_clone_error6.phpt",
   :path "Zend/tests/readonly_props/readonly_clone_error6.phpt",
   :source
   "<?php\n\nclass Foo\n{\n    public function __construct(\n        public readonly int $bar\n    ) {}\n\n    public function __clone()\n    {\n        $this->bar = 1;\n    }\n}\n\n$foo = new Foo(0);\n\nvar_dump($foo);\n\ntry {\n    $foo->__clone();\n} catch (Error $e) {\n    echo $e->getMessage() . \"\\n\";\n}\n\ntry {\n    $foo->__clone();\n} catch (Error $e) {\n    echo $e->getMessage() . \"\\n\";\n}\n\nvar_dump($foo);\n\n?>",
