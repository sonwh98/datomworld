  {:id "Zend/tests/readonly_props/readonly_clone_error1.phpt",
   :path "Zend/tests/readonly_props/readonly_clone_error1.phpt",
   :source
   "<?php\n\nclass Foo {\n    public function __construct(\n        public readonly int $bar\n    ) {}\n\n    public function __clone()\n    {\n        $this->bar = 2;\n        var_dump($this);\n        $this->bar = 3;\n    }\n}\n\n$foo = new Foo(1);\n\ntry {\n    clone $foo;\n} catch (Error $exception) {\n    echo $exception->getMessage() . \"\\n\";\n}\n\necho \"done\";\n\n?>",
   :title "Readonly property cannot be reset twice during cloning",
   :expect
   "object(Foo)#2 (1) {\n  [\"bar\"]=>\n  int(2)\n}\nCannot modify readonly property Foo::$bar\ndone",
   :needs :p4}
  {:id "Zend/tests/readonly_props/readonly_clone_error2.phpt",
   :path "Zend/tests/readonly_props/readonly_clone_error2.phpt",
   :source
   "<?php\n\nclass Foo {\n    public function __construct(\n        public readonly int $bar,\n        public readonly int $baz\n    ) {}\n\n    public function wrongCloneOld()\n    {\n        $instance = clone $this;\n        $this->bar++;\n    }\n\n    public function wrongCloneNew()\n    {\n        $instance = clone $this;\n        $instance->baz++;\n    }\n}\n\n$foo = new Foo(1, 1);\n\ntry {\n    $foo->wrongCloneOld();\n} catch (Error $exception) {\n    echo $exception->getMessage() . \"\\n\";\n}\n\ntry {\n    $foo->wrongCloneNew();\n} catch (Error $exception) {\n    echo $exception->getMessage() . \"\\n\";\n}\n\n?>",
   :title
   "Readonly property cannot be reset after cloning when there is no custom clone handler",
   :expect
   "Cannot modify readonly property Foo::$bar\nCannot modify readonly property Foo::$baz",
   :needs :p4}
  {:id "Zend/tests/readonly_props/readonly_clone_error3.phpt",
   :path "Zend/tests/readonly_props/readonly_clone_error3.phpt",
   :source
   "<?php\n\nclass Foo {\n    public function __construct(\n        public readonly int $bar,\n        public readonly int $baz\n    ) {}\n\n    public function __clone() {}\n\n    public function wrongCloneOld()\n    {\n        $instance = clone $this;\n        $this->bar++;\n    }\n\n    public function wrongCloneNew()\n    {\n        $instance = clone $this;\n        $instance->baz++;\n    }\n}\n\n$foo = new Foo(1, 1);\n\ntry {\n    $foo->wrongCloneOld();\n} catch (Error $exception) {\n    echo $exception->getMessage() . \"\\n\";\n}\n\ntry {\n    $foo->wrongCloneNew();\n} catch (Error $exception) {\n    echo $exception->getMessage() . \"\\n\";\n}\n\n?>",
   :title
