\n===C===\\n\";\nvar_dump($x->doSomethingParent(1));\necho \"\\n===D===\\n\";\nvar_dump($x->doSomethingParentThis(1));\necho \"\\n===E===\\n\";\nvar_dump($x->doSomethingStatic(1));\n\n?>",
