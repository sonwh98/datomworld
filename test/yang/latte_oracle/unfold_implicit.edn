;; B-leg adaptation of latte-kernel.typing/unfold-implicit (typing.cljc:453, the
;; one try in the corpus). It is NOT compiled from upstream source: the manifest
;; marks it as explicitly adapted. The implicit function is a guest closure;
;; the catch merges the raised value's data
;; over :implicit and :msg in upstream's order (the data wins). The upstream
;; def-env and ctx parameters only reach type-of-implicit-args and
;; call-implicit, so this fixture takes the implicit definition and the
;; already-typed arguments.
(defn unfold-implicit
  [implicit-def args]
  (try [:ok ((:fn implicit-def) args) args]
       (catch Exception e
         [:ko (merge {:implicit (:name implicit-def) :msg (ex-message e)}
                     (ex-data e)) nil])))
