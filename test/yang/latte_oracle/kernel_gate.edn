{:id :syntax-term-refusal, :negative? true, :call (latte-kernel.syntax/term? {})}
{:id :syntax-bound-vars, :call (latte-kernel.syntax/bound-vars (quote (λ [x A] [x y])))}
{:id :syntax-bound-vars-free, :call (latte-kernel.syntax/bound-vars (quote [x y]))}
