{:id :fundamental-install-use, :mode :unparser-install,
 :call (do (latte-kernel.unparser/install-fundamental-unparsers!)
           [(latte-kernel.unparser/unparse (quote (Π [x A] (Π [y B] C))))
            (latte-kernel.unparser/unparse (quote (Π [x A] [B x])))
            (latte-kernel.unparser/unparse (quote z))]),
 :guest-call (let [installed (install-fundamental-unparsers env)]
               [(unparse installed (quote (Π [x A] (Π [y B] C))))
                (unparse installed (quote (Π [x A] [B x])))
                (unparse installed (quote z))])}
{:id :predicate-pair, :call (latte-kernel.utils/pair? [1 2])}
