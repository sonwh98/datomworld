{:id :removal-vremove, :call (latte-kernel.utils/vremove (fn [x] (= x 2)) [1 2 3 2])}
{:id :removal-vremove-none, :call (latte-kernel.utils/vremove (fn [x] (= x 2)) [1 3])}
