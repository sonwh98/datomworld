{:id :unfold-install-use, :mode :unfold-install,
 :definitions [(latte-kernel.defenv/->Implicit (quote i) (fn [k ctx x] x))],
 :call (do (latte-kernel.norm/install-unfold-implicit! (fn [k ctx ddef args] [:ok (first args) args]))
           [(latte-kernel.norm/delta-normalize env [] (quote (i x)))
            (latte-kernel.nbe/norm env [] (quote (i x)))]),
 :guest-call (let [installed (install-unfold-implicit env (fn [k ctx ddef args] [:ok (first args) args]))]
               [(latte-kernel.norm/delta-normalize installed [] (quote (i x)))
                (latte-kernel.nbe/norm installed [] (quote (i x)))])}
{:id :unfold-install-refusal, :mode :unfold-install, :negative? true,
 :definitions [(latte-kernel.defenv/->Implicit (quote i) (fn [k ctx x] x))],
 :call (do (latte-kernel.norm/install-unfold-implicit! (fn [k ctx ddef args] [:ko {:msg "installed refusal"} args]))
           (latte-kernel.norm/delta-normalize env [] (quote (i x)))),
 :guest-call (let [installed (install-unfold-implicit env (fn [k ctx ddef args] [:ko {:msg "installed refusal"} args]))]
               (latte-kernel.norm/delta-normalize installed [] (quote (i x))))}
{:id :opacity-install-use, :mode :opacity-install,
 :script [[:opaque d] [:transparent d] [:qed (lambda [A :type] (lambda [x A] x)) {}]],
 :definitions [(latte-kernel.defenv/->Definition (quote d) [] 0 (quote body) #{} (quote T) {})],
 :project-proof? true,
 :call (latte-kernel.proof/elab-proof env [] (quote [[:opaque d] [:transparent d] [:qed (lambda [A :type] (lambda [x A] x)) {}]])),
 :guest-call (let [installed (latte-kernel.proof/install-opacity-function
                              (install-opacity-function env missing-opacity-policy) definition-opacity)]
               (latte-kernel.proof/elab-proof installed [] (quote [[:opaque d] [:transparent d] [:qed (lambda [A :type] (lambda [x A] x)) {}]])))}
{:id :opacity-install-refusal, :mode :opacity-install, :negative? true,
 :script [[:opaque d] [:opaque d]],
 :definitions [(latte-kernel.defenv/->Definition (quote d) [] 0 (quote body) #{} (quote T) {})],
 :call (latte-kernel.proof/elab-proof env [] (quote [[:opaque d] [:opaque d]])),
 :guest-call (let [installed (latte-kernel.proof/install-opacity-function
                              (install-opacity-function env missing-opacity-policy) definition-opacity)]
               (latte-kernel.proof/elab-proof installed [] (quote [[:opaque d] [:opaque d]])))}
]}
