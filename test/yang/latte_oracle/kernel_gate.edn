 (latte-kernel.defenv/->Implicit (quote i) (fn [k ctx x] x)))}
{:id :display-deftype-unknown, :call (latte-kernel.proof/show-deftype {})}
{:id :syntax-appify, :call (latte-kernel.syntax/appify (quote f) (quote [x y]))}
{:id :syntax-appify-empty, :call (latte-kernel.syntax/appify (quote f) [])}
