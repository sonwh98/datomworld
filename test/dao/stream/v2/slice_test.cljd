(ns dao.stream.v2.slice-test
  "Phase 5 — the WebSocket slice, end to end, across two operating-system
   processes on Dart.

   The JVM half of this phase is `test/dao/stream/v2/slice_test.clj` and the
   Node half is `test/dao/stream/v2/slice_test.cljs`; all three carry the same
   five facts against the same peer program.  The three files share a
   namespace name and no code: each is invisible to the others' compiler, and
   the plan's host matrix wants a Dart server plus a Dart client proven as its
   own slice rather than inferred from another host's run.

   Process A is here.  Process B is `dao.stream.v2.slice-peer`, compiled
   ahead of time to `build/slice-peer` and spawned as a real child process —
   see the `test:cljd` task in `bb.edn`, which builds that program before this
   suite runs.  B receives A's descriptor as Transit JSON text in `argv` and
   learns nothing else about A.

   Dart runs one isolate, so every wait here is a turn on the event loop: the
   driver is an explicit `Timer.periodic` the test owns, and each step of a
   fact is an `await` over a poll.  Nothing in the transport schedules itself.

   One reporting quirk is worth knowing before it wastes anyone's afternoon:
   `cljd.test` runs each test inside its own error-handling zone, so a failed
   `is` after an `await` is reported immediately but does not complete the
   test's future.  The failing fact is named and explained at once, and then
   sits until `dart test`'s own timeout expires.  The assertion output above
   that timeout is the real failure."
  (:require ["dart:async" :as async]
            ["dart:convert" :as convert]
            ["dart:core" :as core]
            ["dart:io" :as io]
            [clojure.test :refer [deftest is testing]]
            [dao.stream.v2 :as stream]
            [dao.stream.v2.ringbuffer :as ring]
            [dao.stream.v2.serving :as serving]
            [dao.stream.v2.transit :as transit]
            [dao.stream.v2.ws :as ws]
            [dao.stream.v2.ws.dart :as dart]))


;; =============================================================================
;; Explicit composition data
;; =============================================================================

(def admission
  {:retention :evict-oldest :capacity 256 :value-domain :portable-values})


(def handoff-admission
  {:retention :evict-oldest :capacity 1 :value-domain :host-values})


(def peer-program
  "Process B, compiled ahead of time.  A Dart program cannot be started from
   its ClojureDart sources here: this project's `cljd.core` carries the
   Flutter extensions, so only an AOT program is a peer the plain Dart VM can
   run."
  "build/slice-peer")


(def ^:private bind-ms 5000)
(def ^:private reply-ms 15000)
(def ^:private event-ms 15000)
(def ^:private tick-ms 5)


(defn- now-ms
  []
  (.-millisecondsSinceEpoch (core/DateTime.now)))


(defn- buffer
  ([] (buffer 256))
  ([capacity]
   (:dao.stream/handle (ring/create! {:dao.stream/type ring/transport-type
                                      ring/capacity-key capacity}))))


(defn- newest
  [handle]
  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))


(defn- drain
  "Every retained value on a medium, read from the oldest position.  Reads are
   non-destructive, so this never disturbs the driver's own cursor."
  [handle]
  (loop [cursor (:dao.stream/cursor (stream/cursor handle stream/anchor-oldest))
         seen []]
    (let [result (stream/next handle cursor)]
      (if (= :dao.stream/ok (:dao.stream/outcome result))
        (recur (:dao.stream/cursor result) (conj seen (:dao.stream/value result)))
        seen))))


(defn- terminal-event
  "The lifecycle event that ends an attachment's history, if it has arrived."
  [events]
  (first (filter #(contains? #{:ws/closed :ws/ended} (:ws/event %)) events)))


(defn- logical-identity
  "The served stream's own logical-stream identity, taken from the handle
   rather than invented by this test.  A constant here would prove only that
   two hand-written descriptors share a constant."
  [source]
  (:dao.stream/identity (stream/descriptor source)))


(defn- table-descriptor
  "The served table's descriptor.  Its port is a placeholder because the bound
   port is only known after listening; path lookup never consults the port, and
   each test repairs reachability for its peer from the bound address."
  [source path]
  {:dao.stream/type :dao.stream/ws
   :dao.stream/identity (logical-identity source)
   :ws/host "127.0.0.1"
   :ws/port 1
   :ws/path path})


;; =============================================================================
;; Waiting, as futures over the event loop
;; =============================================================================

(defn- ^:async sleep!
  [ms]
  (await (async/Future.delayed (core/Duration .milliseconds ms))))


(defn- ^:async poll-until
  "Resolve with the first truthy value `pred` returns, or throw at the
   deadline.  Polling is the only honest wait here: no operation blocks, and
   nothing notifies."
  [pred timeout-ms explain]
  (let [deadline (+ (now-ms) timeout-ms)]
    (loop []
      (if-some [value (pred)]
        value
        (if (< deadline (now-ms))
          (throw (core/StateError. (explain)))
          (do (await (sleep! 10))
              (recur)))))))


;; =============================================================================
;; Process A: one served ring buffer behind two endpoints
;; =============================================================================

(defn- make-endpoint-composition
  "Compose one serving endpoint over `source`, with `slot-count` capacity-one
   acceptance-handoff slots.  One slot would make fact 3 a race against the
   driver's cadence rather than a test of attachment identity."
  [source path slot-count]
  (let [descriptor (table-descriptor source path)
        control (buffer)
        slots (vec (repeatedly slot-count (fn [] {:offer (buffer 1) :ack (buffer 1)})))
        endpoint (ws/make-endpoint
                   {:served {path descriptor}
                    :control {:dao.stream/handle control :dao.stream/surface #{:writer}}
                    :control-admission admission
                    :slots (mapv (fn [{:keys [offer ack]}]
                                   {:offer {:dao.stream/handle offer
                                            :dao.stream/surface #{:writer}}
                                    :offer-admission handoff-admission
                                    :ack {:dao.stream/handle ack
                                          :dao.stream/surface #{:writer}}
                                    :ack-admission handoff-admission
                                    :ack-cursor (newest ack)})
                                 slots)
                    :expiry-ms nil})
        media (atom {})
        listener (atom nil)
        port (atom nil)
        composition
        (serving/make-serving
          {:endpoint endpoint
           :served {path {:descriptor descriptor :stream source}}
           :control-reader control
           :control-cursor (newest control)
           :slots (mapv (fn [{:keys [offer ack]}]
                          {:offer-reader offer
                           :offer-cursor (newest offer)
                           :ack-writer {:dao.stream/handle ack
                                        :dao.stream/surface #{:writer}}})
                        slots)
           ;; Newest rather than the default oldest: an attachment observes
           ;; what is appended after it joined, so one fact's appends cannot
           ;; be replayed into another fact's attachment.
           :forward-anchor stream/anchor-newest
           :forward-options {:batch-budget 16 :gap-policy :terminate}
           :make-traffic (fn [offer-event]
                           (let [traffic (buffer)]
                             (swap! media assoc (:ws/attachment offer-event) traffic)
                             {:traffic {:dao.stream/handle traffic
                                        :dao.stream/surface #{:writer}}
                              :admission admission
                              :reader traffic
                              :cursor (newest traffic)}))
           ;; No `:inbound-step`: inbound payload stays ordinary traffic data
           ;; on the per-attachment medium and is deliberately not interpreted
           ;; into appends on the served stream.
           :start-endpoint! (fn [ep]
                              ;; The bound port is only reported through the
                              ;; host's own deposit callback, so reachability
                              ;; is repaired from data, never guessed.
                              (reset! listener
                                      (dart/bind!
                                        {:bind-host "127.0.0.1"
                                         :bind-port 0
                                         :accept! (fn [target socket now]
                                                    (ws/accept-connection! ep target socket now))
                                         :deposit! (fn [kind data]
                                                     (when (= :bind-succeeded kind)
                                                       (reset! port (:port data))))}))
                              {:dao.stream/outcome :dao.stream/ok})
           :stop-endpoint! (fn [_]
                             (dart/unbind! @listener (fn [_kind _data] nil))
                             {:dao.stream/outcome :dao.stream/ok})})]
    {:path path
     :descriptor descriptor
     :composition composition
     :media media
     :port port}))


(defn- server-fixture
  []
  (let [source (buffer)]
    {:source source
     :primary (make-endpoint-composition source "/slice" 4)
     :secondary (make-endpoint-composition source "/slice-b" 4)}))


(defn- reachable
  "Repair a served descriptor's reachability from the bound port.  This is the
   value that crosses to B as text, and the only thing B ever learns about A."
  [endpoint]
  (assoc (:descriptor endpoint) :ws/port @(:port endpoint)))


(defn- ^:async await-terminal
  "Resolve with one server-side medium's history once it is complete.

   Asserting attribution over a history that has not yet ended is the hole this
   closes: `every?` over events that exclude the terminal one is satisfied by an
   implementation that mislabels `:ws/attachment` exactly on `:ws/closed`."
  [endpoint attachment]
  (await (poll-until (fn []
                       (let [events (drain (get @(:media endpoint) attachment))]
                         (when (terminal-event events) events)))
                     event-ms
                     (fn [] "a server medium never deposited its terminal event"))))


;; =============================================================================
;; Process B: a real child process, spoken to only over pipes
;; =============================================================================

(defn- lines!
  "Deliver whole newline-terminated lines out of one child pipe."
  [^#/(async/Stream #/(List int)) readable on-line]
  (-> readable
      (.transform (.-decoder convert/utf8))
      (.transform (convert/LineSplitter.))
      (.listen on-line)))


(defn- ^:async start-peer!
  [descriptor]
  (when-not (.existsSync (io/File. peer-program))
    (throw (core/StateError.
             (str "process B was never built: " peer-program
                  " is missing.  `bb test:cljd` compiles it before this suite."))))
  (let [process (await (io/Process.start peer-program
                                         #dart ^String [(transit/encode-descriptor descriptor)]))
        replies (atom [])
        errors (atom [])]
    ;; Anything B prints before the peer protocol starts is noise rather than a
    ;; protocol failure: recording it and carrying on keeps one banner from
    ;; silently stopping the reader.
    (lines! (.-stdout ^io/Process process)
            (fn [line]
              (let [reply (try (transit/decode line) (catch Object _ nil))]
                (if (:reply reply)
                  (swap! replies conj reply)
                  (swap! errors conj line)))))
    (lines! (.-stderr ^io/Process process) (fn [line] (swap! errors conj line)))
    {:process process :replies replies :errors errors :seen (atom [])}))


(defn- stop-peer!
  [peer]
  (try (.kill ^io/Process (:process peer)) (catch Object _ nil)))


(defn- ^:async take-reply!
  "Consume the first reply of `kind`."
  [peer kind]
  (await (poll-until
           (fn []
             (when-some [index (first (keep-indexed (fn [i r] (when (= kind (:reply r)) i))
                                                    @(:replies peer)))]
               (let [reply (nth @(:replies peer) index)]
                 (swap! (:replies peer)
                        (fn [rs] (into (subvec rs 0 index) (subvec rs (inc index)))))
                 reply)))
           reply-ms
           (fn []
             (str "process B never replied " kind "; its other output was "
                  (pr-str @(:errors peer)))))))


(defn- ^:async ask!
  [peer command kind]
  (.writeln (.-stdin ^io/Process (:process peer)) (transit/encode command))
  (await (take-reply! peer kind)))


(defn- ^:async poll-events!
  "Ask B for whatever its medium has accumulated since B last reported, and
   remember it.  B advances only its own kept cursor; A never touches it."
  [peer]
  (let [reply (await (ask! peer {:cmd :events} :events))]
    (swap! (:seen peer) into (:events reply))
    @(:seen peer)))


(defn- ^:async await-event
  [peer pred message]
  (let [deadline (+ (now-ms) event-ms)]
    (loop []
      (let [seen (await (poll-events! peer))]
        (if-some [hit (first (filter pred seen))]
          hit
          (if (< deadline (now-ms))
            (throw (core/StateError. message))
            (do (await (sleep! 20))
                (recur))))))))


(defn- ^:async attach-peer!
  "Spawn B, wait for its bootstrap, attach, and wait for the opened event."
  [peers descriptor]
  (let [peer (await (start-peer! descriptor))
        _ (swap! peers conj peer)
        ready (await (take-reply! peer :ready))]
    (is (= descriptor (:descriptor ready))
        "the descriptor B decoded from text differs from the one A encoded")
    (let [attach (await (ask! peer {:cmd :attach} :attach))]
      (is (= :dao.stream/ok (:outcome attach)))
      (await (await-event peer #(= :ws/opened (:ws/event %))
                          "the attachment never opened"))
      (assoc peer :attachment (:attachment attach)))))


(defn- ^:async server-attachment
  "Correlate B to the server-side session it joined by the token it appended.
   The two sides mint their own attachment identities, so nothing but a
   payload can connect them — which is itself worth asserting."
  [endpoint token]
  (await (poll-until
           (fn []
             (first (first (filter (fn [[_ medium]]
                                     (some #(= token (:ws/value %)) (drain medium)))
                                   @(:media endpoint)))))
           event-ms
           (fn [] "A never received B's outbound payload"))))


(defn- ^:async run-slice
  "Start process A, run one fact, then tear everything down exactly once."
  [body]
  (let [{:keys [primary secondary] :as fixture} (server-fixture)
        peers (atom [])]
    (serving/start! (:composition primary))
    (serving/start! (:composition secondary))
    (let [ticker (async/Timer.periodic
                   (core/Duration .milliseconds tick-ms)
                   (fn [_]
                     (let [now (now-ms)]
                       (serving/step! (:composition primary) now)
                       (serving/step! (:composition secondary) now))))]
      (try
        (await (poll-until #(and @(:port primary) @(:port secondary))
                           bind-ms
                           (fn [] "the listeners never reported bound ports")))
        (await (body fixture peers))
        (finally
          (.cancel ticker)
          (doseq [peer @peers] (stop-peer! peer))
          (serving/stop! (:composition primary))
          (serving/stop! (:composition secondary)))))))


;; =============================================================================
;; The five facts
;; =============================================================================

(deftest detachment-is-observable-on-both-sides
  ;; Fact 1.
  (await
    (run-slice
      (fn [{:keys [source primary]} peers]
        (let [peer (await (attach-peer! peers (reachable primary)))
              token [:slice/fact-1 (:attachment peer)]]
          (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :append :value :slice/established}
                                                       :append))))
              "an established attachment must accept an outbound append")
          (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :append :value token} :append)))))
          (let [attachment (await (server-attachment primary token))]
            (is (some? attachment) "A never received B's outbound payload")

            ;; Kill the connection from B's side.
            (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :close} :close)))))

            (testing "B's handle answers closed"
              (is (= :dao.stream/closed
                     (:outcome (await (ask! peer {:cmd :append :value :after-close} :append)))))
              (let [departure (await (await-event peer #(= :ws/closed (:ws/event %))
                                                  "B's own medium never received the terminal event"))]
                (is (= (:attachment peer) (:ws/attachment departure))
                    "B's terminal event was not attributed to its attachment")))

            (testing "A's boundary deposits the departure"
              (let [events (await (await-terminal primary attachment))
                    departure (terminal-event events)]
                (is (= :ws/closed (:ws/event (last events)))
                    "A's per-attachment medium never deposited the departure")
                (is (= attachment (:ws/attachment departure))
                    "A's terminal event was not attributed to its session"))
              (is (not (contains? (:sessions (serving/state (:composition primary)))
                                  attachment))
                  "the driver kept a session for a departed attachment"))

            (testing "the served stream is untouched by a connection's death"
              (is (= :dao.stream/ok (:dao.stream/outcome
                                      (stream/append! source :slice/still-alive)))))))))))


(deftest the-same-descriptor-rejoins-the-same-logical-stream
  ;; Fact 2.  The peer is killed at the socket, then reattaches with the
  ;; identical bootstrapped descriptor value.
  (await
    (run-slice
      (fn [{:keys [source primary]} peers]
        (let [peer (await (attach-peer! peers (reachable primary)))]
          (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :close} :close)))))
          (await (await-event peer #(= :ws/closed (:ws/event %))
                              "the attachment never closed"))
          ;; The identical bootstrapped descriptor value, reused verbatim.
          (let [again (await (ask! peer {:cmd :attach} :attach))]
            (is (= :dao.stream/ok (:outcome again))
                "reattachment with the same descriptor was refused")
            (is (not= (:attachment peer) (:attachment again))
                "a reattachment is a new attachment, not a resurrected one")
            (await (await-event peer
                                (fn [event]
                                  (and (= :ws/opened (:ws/event event))
                                       (= (:attachment again) (:ws/attachment event))))
                                "the reattachment never opened"))
            (let [token [:slice/fact-2 (:attachment again)]]
              ;; A appends to the surviving logical stream; the rejoined
              ;; attachment receives it, which is what "same logical stream"
              ;; means operationally.
              (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source token))))
              (is (some? (await (await-event peer #(= token (:ws/value %))
                                             "the rejoined attachment received nothing from the served stream")))))))))))


(deftest simultaneous-attachments-carry-distinct-attachment-identity
  ;; Fact 3.  Two whole processes, so nothing but the wire could make their
  ;; identities agree by accident.
  (await
    (run-slice
      (fn [{:keys [source primary]} peers]
        (let [descriptor (reachable primary)
              peer-1 (await (attach-peer! peers descriptor))
              peer-2 (await (attach-peer! peers descriptor))]
          (is (string? (:attachment peer-1)))
          (is (string? (:attachment peer-2)))
          (is (not= (:attachment peer-1) (:attachment peer-2))
              "two simultaneous attachments shared one attachment identity")

          (let [token-1 [:slice/fact-3 (:attachment peer-1)]
                token-2 [:slice/fact-3 (:attachment peer-2)]]
            (await (ask! peer-1 {:cmd :append :value token-1} :append))
            (await (ask! peer-2 {:cmd :append :value token-2} :append))
            (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source :slice/fanout))))
            (await (await-event peer-1 #(= :slice/fanout (:ws/value %))
                                "the first attachment received nothing"))
            (await (await-event peer-2 #(= :slice/fanout (:ws/value %))
                                "the second attachment received nothing"))

            (let [a-1 (await (server-attachment primary token-1))
                  a-2 (await (server-attachment primary token-2))]
              (is (some? a-1))
              (is (some? a-2))
              (is (not= a-1 a-2)
                  "two connections were folded into one server-side attachment")

              ;; Close both before asserting attribution.  Correlation checked
              ;; while the attachments are live sees only resolution and
              ;; payload events; the terminal ones would arrive later, during
              ;; teardown, unobserved.  An implementation that emitted a wrong
              ;; or missing `:ws/attachment` exactly on `:ws/closed` would pass
              ;; such a check.
              (doseq [peer [peer-1 peer-2]]
                (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :close} :close))))))

              (testing "every event on a client medium carries that client's identity"
                (doseq [peer [peer-1 peer-2]]
                  (await (await-event peer #(= :ws/closed (:ws/event %))
                                      "a client medium never received its terminal event"))
                  (let [events @(:seen peer)
                        terminal (terminal-event events)]
                    (is (seq events))
                    ;; Resolution, payload, and lifecycle alike.
                    (is (every? #(= (:attachment peer) (:ws/attachment %)) events)
                        "an event on B's medium was attributed to another attachment")
                    (is (some? terminal))
                    (is (= (:attachment peer) (:ws/attachment terminal))
                        "B's terminal event was not attributed to its attachment"))))

              (testing "every event on a server medium carries that session's identity"
                (doseq [attachment [a-1 a-2]]
                  (let [events (await (await-terminal primary attachment))
                        terminal (terminal-event events)]
                    (is (seq events))
                    (is (some? terminal)
                        "a server medium never deposited its terminal event")
                    ;; Payload and lifecycle alike.
                    (is (every? #(= attachment (:ws/attachment %)) events))
                    (is (= attachment (:ws/attachment terminal))
                        "A's terminal event was not attributed to its session")))))))))))


(deftest the-deposit-medium-outlives-the-socket
  ;; Fact 4.  The cursor is B's, on B's medium; it is never handed to
  ;; `attach!` and never used through the WebSocket handle.
  (await
    (run-slice
      (fn [{:keys [source primary]} peers]
        (let [peer (await (attach-peer! peers (reachable primary)))
              token [:slice/fact-4 (:attachment peer)]]
          (is (= #{:writer :closable} (:value (await (ask! peer {:cmd :surfaces} :surfaces))))
              "the ws handle must have no reader surface for this fact to mean anything")

          (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source token))))
          (await (await-event peer #(= token (:ws/value %)) "the payload never arrived"))

          ;; The socket dies.  B's medium and B's position on it do not.
          (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :close} :close)))))
          (await (await-event peer #(= :ws/closed (:ws/event %))
                              "the kept cursor did not resume across the socket's death"))

          (testing "the cursor resumed rather than restarted"
            ;; Every event B has reported came from one uninterrupted walk of
            ;; one cursor: an opened, a payload, and exactly one terminal
            ;; event, in order and without repetition.
            (let [events @(:seen peer)]
              (is (= [:ws/opened :ws/payload :ws/closed] (mapv :ws/event events)))
              (is (apply distinct? events)))))))))


(deftest two-endpoints-differ-in-reachability-and-agree-on-identity
  ;; Fact 5.
  (await
    (run-slice
      (fn [{:keys [source primary secondary]} peers]
        (let [projection (stream/descriptor source)
              identity (:dao.stream/identity projection)
              d-1 (reachable primary)
              d-2 (reachable secondary)]
          (is (not= d-1 d-2) "two endpoints produced the same descriptor")
          (is (not= (select-keys d-1 [:ws/host :ws/port :ws/path])
                    (select-keys d-2 [:ws/host :ws/port :ws/path]))
              "the two endpoints are not separately reachable")

          (testing "the served descriptors carry the ring buffer's own identity"
            ;; Not a constant this test chose: the value the served stream mints.
            (is (= :dao.stream/ok (:dao.stream/outcome projection)))
            (is (string? identity))
            (is (= identity (:dao.stream/identity (:dao.stream/descriptor projection)))
                "the sibling identity disagrees with the one inside the envelope")
            (is (= identity (:dao.stream/identity d-1)))
            (is (= identity (:dao.stream/identity d-2))
                "one logical stream served twice must carry one identity"))

          (let [peer-1 (await (attach-peer! peers d-1))
                peer-2 (await (attach-peer! peers d-2))
                h-1 (await (ask! peer-1 {:cmd :handle-descriptor} :handle-descriptor))
                h-2 (await (ask! peer-2 {:cmd :handle-descriptor} :handle-descriptor))]
            (testing "each handle projects its own reachability and the shared identity"
              (is (not= (:descriptor h-1) (:descriptor h-2)))
              (is (= identity (:identity h-1)))
              (is (= identity (:identity h-2))
                  "an attached handle projected an identity the served stream never minted"))

            (testing "cursors compare identity, never a descriptor"
              ;; One cursor on the served stream is valid for the logical
              ;; stream both endpoints serve; neither descriptor participates.
              ;; The cursor carries the same identity the descriptors do, which
              ;; is what makes that comparison possible without either
              ;; descriptor.
              (let [minted (stream/cursor source stream/anchor-newest)]
                (is (= :dao.stream/ok (:dao.stream/outcome minted)))
                (is (= identity (:dao.stream.ringbuffer/identity (:dao.stream/cursor minted)))
                    "the cursor's identity disagrees with the served descriptors'")
                (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source :slice/both))))
                (is (= :slice/both (:dao.stream/value
                                     (stream/next source (:dao.stream/cursor minted)))))))

            (testing "both endpoints serve the same logical stream"
              (is (some? (await (await-event peer-1 #(= :slice/both (:ws/value %))
                                             "the first endpoint's attachment received nothing"))))
              (is (some? (await (await-event peer-2 #(= :slice/both (:ws/value %))
                                             "the second endpoint's attachment received nothing")))))))))))
