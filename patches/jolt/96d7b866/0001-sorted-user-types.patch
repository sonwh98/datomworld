+  (if (tree-sorted? sc)
+    (let [cmp (the-cmp sc) map? (sorted-map? sc)]
+      (fn [e] (test (cmp (if map? (key e) e) k) 0)))
+    (let [cmp (.comparator sc)]                 ; clojure.core/mk-bound-fn
+      (fn [e] (test (.compare cmp (.entryKey sc e) k) 0)))))
 
