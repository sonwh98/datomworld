{:deps {org.clojure/core.async {:mvn/version "1.8.741"}
        org.clojure/tools.reader {:mvn/version "1.5.0"}
        ring/ring {:mvn/version "1.14.1"}
        com.cognitect/transit-clj {:mvn/version "1.0.333"}
        org.replikativ/boring {:mvn/version "0.1.30"}
        com.datomic/peer {:mvn/version "1.0.7364"}
        org.postgresql/postgresql {:mvn/version "42.7.3"}
        org.clojure/data.json {:mvn/version "2.5.0"}
        http-kit/http-kit {:mvn/version "2.8.0"}
        org.jsoup/jsoup {:mvn/version "1.18.3"}
        instaparse/instaparse {:mvn/version "1.5.0"}
        ;; yang.python.antlr: the runtime the generated Python3 parser runs
        ;; on; pinned to the tool version in :antlr-gen (they are one release)
        org.antlr/antlr4-runtime {:mvn/version "4.13.2"}
        criterium/criterium {:mvn/version "0.4.6"}
        io.github.rctcwyvrn/blake3 {:mvn/version "1.3"}
        stigmergy/chp {:mvn/version "0.1.0-SNAPSHOT"
                       :exclusions [refactor-nrepl/refactor-nrepl]}}
 :cljd/opts {}
 ;; build/antlr/python3/classes: the generated Python3 parser, produced by
 ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated
 :paths ["src/clj" "src/cljc" "src/cljs" "src/cljd"
         "build/antlr/python3/classes"]
 :aliases {:clean {:extra-paths ["src/dev"]
                   :exec-fn clean/clean}
           :profile-btree {:extra-paths ["src/dev"]
                           :extra-deps {persistent-sorted-set/persistent-sorted-set
                                        {:mvn/version "0.3.0"}}
                           :main-opts ["-m" "btree-bench"]}
           :test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}
           :nREPL {:extra-paths ["test"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.0.0"}
                                cider/cider-nrepl {:mvn/version "0.58.0"}}
                   :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}
           :cljs {:extra-paths ["test" "src/dev"]
                  :extra-deps {thheller/shadow-cljs {:mvn/version "3.3.5"}
                               reagent/reagent {:mvn/version "2.0.1"}
                               com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}
           :dev {:extra-paths ["src/dev"]
                 :extra-deps {thheller/shadow-cljs {:mvn/version "3.3.5"}
                              cider/cider-nrepl {:mvn/version "0.58.0"}
                              reagent/reagent {:mvn/version "2.0.1"}
                              com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                              ;; benchmark baseline + psset-fixtures
                              ;; generator only; production uses
                              ;; dao.data.btree
                              persistent-sorted-set/persistent-sorted-set
                              {:mvn/version "0.3.0"}}
                 :jvm-opts ["-Dconfig=config.clj"]}
           ;; The one ClojureDart pin. Compose it with the build aliases:
           ;; clj -M:clojuredart:cljd ..., clj -M:clojuredart:cljd-yin-repl-build ...
           :clojuredart {:extra-deps {sonwh98/clojuredart
                                      {:git/url "https://github.com/sonwh98/ClojureDart.git"
                                       :sha "7d00ee2aa7fa9d990581e78ebc4a66b93cb70a31"}
                                      }}
           :cljd {:extra-paths ["test"]
                  :main-opts ["-m" "cljd.build"]
                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}
           :server {:extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}}
                    :jvm-opts ["-Dconfig=config.clj"]
                    :main-opts ["-m" "world.server"]}
           :clj-yin-repl {:main-opts ["-m" "yin.repl.main"]}
           :cljs-yin-repl
           {:extra-paths ["test" "src/dev"]
            :extra-deps {thheller/shadow-cljs {:mvn/version "3.3.5"}
                         reagent/reagent {:mvn/version "2.0.1"}
                         com.cognitect/transit-cljs {:mvn/version "0.8.280"}}
            :main-opts ["-m" "shadow.cljs.devtools.cli" "run" "yin.repl.main/-main"]}
           :fmt {:extra-paths ["src/dev"]
                 :exec-fn tasks/fix-all}
           ;; Build-time generation of the grammars-v4 Python3 parser.
           ;; The tool version must equal the antlr4-runtime above.
           :antlr-gen {:extra-paths ["src/dev"]
                       :extra-deps {org.antlr/antlr4 {:mvn/version "4.13.2"}}
                       :main-opts ["-m" "yang-antlr-gen"]}
           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.01.19"}}
                   :main-opts ["-m" "clj-kondo.main"]}
           :dbg {:extra-paths ["test"]
                 :main-opts ["-m" "debug-cljd"]
                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}
           :cljd-yin-repl {:main-opts ["-m" "yin.repl.runner"]}
           :cljd-yin-repl-build
           {:main-opts  ["-m" "cljd.build"]
            :cljd/opts  {:kind       :dart
                         :main       yin.repl.main
                         :output-dir "build/yin-repl"
                         :output-to  "build/yin-repl/yin_repl.dart"}}
           :dep-graph {:extra-paths ["src/dev"]
                       :extra-deps {org.clojure/tools.namespace {:mvn/version "1.5.0"}}
                       :main-opts ["-m" "dep-graph"]}}}


