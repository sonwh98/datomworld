;; shadow-cljs configuration
;; Source paths come from deps.edn (:paths plus the :cljs alias's
;; :extra-paths); shadow ignores any :source-paths set here when :deps
;; is used.
{:deps {:aliases [:cljs]}

 :dev-http {9000 "public"}

 :builds {:demo {:target :browser
                 :devtools {:use-document-protocol true}
                 :modules {:main {:init-fn datomworld.demo/init}}}

          :local {:target :browser
                  :devtools {:use-document-protocol true}
                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}
                  :modules {:main {:init-fn datomworld.demo/init}}}

          :test {:target :node-test
                 :output-to "target/node-tests.js"
                 ;; V8 defaults to ~984 KiB: recursive guest frames and the
                 ;; serializers of captured continuations can exhaust it before
                 ;; Python's 1000-frame guard. 6 MiB fits Linux's 8 MiB native
                 ;; stack. Re-exec before loading CLJS, covering shadow autorun
                 ;; AND direct `node ... --test=...` shard invocations.
                 :prepend "if (!process.execArgv.includes('--stack-size=6144')) { const child = require('child_process').spawnSync(process.execPath, [...process.execArgv, '--stack-size=6144', ...process.argv.slice(1)], {stdio: 'inherit'}); if (child.error) throw child.error; if (child.signal) process.kill(process.pid, child.signal); else process.exit(child.status); }"
                 :autorun true}

          :vm-bench {:target :node-script
                     :main bench.yin-vm-bench/-main
                     :output-to "target/vm-bench.js"}

          :yin-repl {:target :node-script
                        :main yin.shell.main/-main
                        :output-to "target/yin-repl.js"}}}
