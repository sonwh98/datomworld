;; shadow-cljs configuration
;; Source paths come from deps.edn (:paths plus the :cljs alias's
;; :extra-paths); shadow ignores any :source-paths set here when :deps
;; is used.
{:deps {:aliases [:cljs]}

 :dev-http {9000 "public"}

 :builds {:demo {:target :browser
                 :devtools {:use-document-protocol true}
                 :modules {:main {:init-fn datomworld.demo/init}}}

          :local {:target :browser
                  :devtools {:use-document-protocol true}
                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}
                  :modules {:main {:init-fn datomworld.demo/init}}}

          :test {:target :node-test
                 :output-to "target/node-tests.js"
                 :autorun true}

          :bench {:target :node-script
                  :main dao.stream-bench/-main
                  :output-to "target/bench.js"}

          :vm-bench {:target :node-script
                     :main bench.yin-vm-v2-bench/-main
                     :output-to "target/vm-bench.js"}

          :slice-peer {:target :node-script
                       :main dao.stream.v2.slice-peer/-main
                       :output-to "target/slice-peer.js"}

          :yin-repl-v2 {:target :node-script
                        :main yin.repl.v2/-main
                        :output-to "target/yin-repl-v2.js"}

          :ws-client-demo {:target :node-script
                           :main datomworld.ws-client-demo/-main
                           :output-to "target/ws-client-demo.js"}}}
