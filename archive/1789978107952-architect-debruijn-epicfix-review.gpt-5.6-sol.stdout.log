       \"tail flags and macro-name never enter identity\")))\n   677\t\n   678\t\n   679\t(deftest content-changes-change-the-fingerprint\n   680\t  (let [fp (comp :fingerprint project)]\n   681\t    (are [a b] (not= (fp a) (fp b))\n   682\t      (lam '[x] (app (v '+) (v 'x) (lit 1)))\n   683\t      (lam '[x] (app (v '+) (v 'x) (lit 2)))\n   684\t      (lam '[x] (v 'y))\n   685\t      (lam '[x] (v 'z))\n   686\t      {:type :vm/store-get, :key 'k}\n   687\t      {:type :vm/store-get, :key 'k2}\n   688\t      (lam '[x] (v 'x))\n   689\t      (lam '[x y] (v 'x))\n   690\t      (lam '[x] (v 'x))\n   691\t      (lam '[x x] (v 'x))\n   692\t      (if-node (v 'a) (lit 1) (lit 2))\n   693\t      (if-node (v 'a) (lit 2) (lit 1))\n   694\t      {:type :stream/make, :buffer 4}\n   695\t      {:type :stream/make, :buffer 8}\n   696\t      {:type :vm/resume, :parked-id :p1, :val (lit 1)}\n   697\t      {:type :vm/resume, :parked-id :p2, :val (lit 1)}\n   698\t      {:type :dao.stream.apply/call, :op :op/echo, :operands [(lit 1)]}\n   699\t      {:type :dao.stream.apply/call, :op :op/ping, :operands [(lit 1)]}\n   700\t      (lam '[x] (v 'x))\n   701\t      {:type :lambda, :macro? true, :params '[x], :body (v 'x)})))\n   702\t\n   703\t\n   704\t(deftest operand-order-changes-the-hash\n   705\t  (let [left (project (app (v 'f) (v 'x) (v 'y)))\n   706\t        right (project (app (v 'f) (v 'y) (v 'x)))]\n   707\t    (is (not= (:fingerprint left) (:fingerprint right)))\n   708\t    (is (not= (:records left) (:records right)))))\n   709\t\n   710\t\n   711\t(deftest tree-and-graph-emission-are-one-merkle-graph\n   712\t  (let [shared (assoc (lam '[x] (v 'x)) :eid -60)\n   713\t        graph (project (app (v 'list) shared shared))\n   714\t        tree (project (app (v 'list) (lam '[x] (v 'x)) (lam '[x] (v 'x))))]\n   715\t    (is (= (:records tree) (:records graph)))\n   716\t    (is (= (:fingerprint tree) (:fingerprint graph)))\n   717\t    (is (= 4 (count (:records graph)))\n   718\t        \"app, free list, one hash-consed lambda, its bound body\")))\n   719\t\n   720\t\n   721\t(deftest equal-subterms-hash-cons-to-one-record\n   722\t  (let [p (project (app (v 'f) (lam '[x] (v 'x)) (lam '[y] (v 'y))))\n   723\t        lambdas (filter #(= :lambda (:yin.debruijn/type %)) (vals (:records p)))]\n   724\t    (is (= 1 (count lambdas))\n   725\t        \"two alpha-equal source lambdas are one projected record\")\n   726\t    (is (= 4 (count (:records p))))))\n   727\t\n   728\t\n   729\t(deftest shared-under-unequal-contexts-hash-differently\n   730\t  (let [body (assoc (v 'x) :eid -41)\n   731\t        p (project (app (v 'list) (lam '[x] body) (lam '[y] body)))\n   732\t        vars (vals (:records p))\n   733\t        bound-h (:yin.debruijn/hash (some #(when (:yin.debruijn/bound %) %) vars))\n   734\t        free-h (:yin.debruijn/hash (some #(when (= 'x (:yin.debruijn/free %)) %) vars))]\n   735\t    (is (not= bound-h free-h))\n   736\t    (is (= 6 (count (:records p)))\n   737\t        \"the two lambdas stay distinct: their bodies differ by resolution\")))\n   738\t\n   739\t\n   740\t(deftest the-storage-adapter-round-trips\n   230\t(deftest every-node-type-projects-in-grammar-order\n   231\t  (is (= {:yin.debruijn/type :application,\n   232\t          :yin.debruijn/operator\n   233\t          {:yin.debruijn/type :lambda,\n   234\t           :yin.debruijn/arity 2,\n   235\t           :yin.debruijn/body\n   236\t           {:yin.debruijn/type :if,\n   237\t            :yin.debruijn/test {:yin.debruijn/type :application,\n   238\t                                :yin.debruijn/operator {:yin.debruijn/type :variable,\n   239\t                                                        :yin.debruijn/free '<},\n   240\t                                :yin.debruijn/operands [{:yin.debruijn/type :variable,\n   241\t                                                         :yin.debruijn/bound [0 0]}\n   242\t                                                        {:yin.debruijn/type :literal,\n   243\t                                                         :yin.debruijn/value 1}]},\n   244\t            :yin.debruijn/consequent\n   245\t            {:yin.debruijn/type :stream/put,\n   246\t             :yin.debruijn/target {:yin.debruijn/type :stream/make,\n   247\t                                   :yin.debruijn/buffer 4},\n   248\t             :yin.debruijn/val-node\n   249\t             {:yin.debruijn/type :stream/next,\n   250\t              :yin.debruijn/source {:yin.debruijn/type :stream/cursor,\n   251\t                                    :yin.debruijn/source {:yin.debruijn/type :stream/close,\n   252\t                                                          :yin.debruijn/source {:yin.debruijn/type :vm/store-get,\n   253\t                                                                                :yin.debruijn/key 'k}}}}},\n   254\t            :yin.debruijn/alternate\n   255\t            {:yin.debruijn/type :application,\n   256\t             :yin.debruijn/operator {:yin.debruijn/type :variable,\n   257\t                                     :yin.debruijn/free 'list},\n   258\t             :yin.debruijn/operands\n   259\t             [{:yin.debruijn/type :literal, :yin.debruijn/value {:a [1 2]}}\n   260\t              {:yin.debruijn/type :vm/store-put,\n   261\t               :yin.debruijn/value 5,\n   262\t               :yin.debruijn/key 'k}\n   263\t              {:yin.debruijn/type :vm/gensym, :yin.debruijn/prefix \"g\"}\n   264\t              {:yin.debruijn/type :vm/current-continuation}\n   265\t              {:yin.debruijn/type :vm/resume,\n   266\t               :yin.debruijn/parked-id :p1,\n   267\t               :yin.debruijn/val-node {:yin.debruijn/type :literal,\n   268\t                                       :yin.debruijn/value 7}}\n   269\t              {:yin.debruijn/type :dao.stream.apply/call,\n   270\t               :yin.debruijn/op :op/echo,\n   271\t               :yin.debruijn/operands [{:yin.debruijn/type :literal,\n   272\t                                        :yin.debruijn/value 1}]}\n   273\t              {:yin.debruijn/type :if,\n   274\t               :yin.debruijn/test {:yin.debruijn/type :literal,\n   275\t                                   :yin.debruijn/value true},\n   276\t               :yin.debruijn/consequent {:yin.debruijn/type :vm/park},\n   277\t               :yin.debruijn/alternate {:yin.debruijn/type :literal,\n   278\t                                        :yin.debruijn/value nil}}]}}},\n   279\t          :yin.debruijn/operands [{:yin.debruijn/type :literal,\n   280\t                                   :yin.debruijn/value 3}]}\n   281\t         (:root (project every-type)))))\n   282\t\n   283\t\n   284\t(deftest the-walk-names-children-in-fixed-order\n   285\t  (testing \":if walks test, consequent, alternate\"\n   286\t    (is (= [:yin/test]\n   287\t           (:path (throws-data\n   288\t                    #(d/project-datoms\n   289\t                       [[-16 :yin/type :if 0 1]\n   290\t                        [-16 :yin/test -901 0 1]\n   291\t                        [-16 :yin/consequent -902 0 1]\n   292\t                        [-16 :yin/alternate -903 0 1]\n   293\t                        [-16 :yin/root true 0 1]]))))))\n   294\t  (testing \"an application walks its operator before its operands\"\n   295\t    (is (= [:yin/operator]\n   296\t           (:path (throws-data\n   297\t                    #(d/project-datoms\n   298\t                       [[-16 :yin/type :application 0 1]\n   299\t                        [-16 :yin/operator -901 0 1]\n   300\t                        [-16 :yin/operands [-902] 0 1]\n   301\t                        [-16 :yin/root true 0 1]]))))))\n   302\t  (testing \"a stream put walks its target before its value\"\n   303\t    (is (= [:yin/target]\n   304\t           (:path (throws-data\n   305\t                    #(d/project-datoms\n   306\t                       [[-16 :yin/type :stream/put 0 1]\n   307\t                        [-16 :yin/target -901 0 1]\n   308\t                        [-16 :yin/val-node -902 0 1]\n   309\t                        [-16 :yin/root true 0 1]])))))))\n   310\t\n   311\t\n   312\t;; =============================================================================\n   313\t;; D1: scope resolution (§3)\n   314\t;; =============================================================================\n   315\t\n  1040\t  \"A reader answering one fixed non-ok outcome forever.\"\n  1041\t  [outcome]\n  1042\t  (reify stream/IDaoStreamReader\n  1043\t    (next\n  1044\t      [_ _cursor]\n  1045\t      {:dao.stream/outcome outcome})))\n  1046\t\n  1047\t\n  1048\t(deftest forward-step-projects-one-graph-to-a-destination\n  1049\t  (let [expected (d/projected->datoms (project worked-example))\n  1050\t        source (-> (buffer 64) (fill! (datoms-of worked-example)) (sealed!))\n  1051\t        destination (buffer 64)\n  1052\t        final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1053\t    (is (= :source-ended (:status final)))\n  1054\t    (is (= expected (drain destination)))\n  1055\t    (is (pos? (:forwarded final))\n  1056\t        \":forwarded counts this call's writes, as dao.stream.forward's does\")))\n  1057\t\n  1058\t\n  1059\t(deftest forward-step-frames-adjacent-graphs-that-reuse-tempids\n  1060\t  (let [[_ ds-one] (vm/ast->datoms-with-root (lam '[x] (v 'x)))\n  1061\t        [_ ds-two] (vm/ast->datoms-with-root (lam '[x] (lit 42)))\n  1062\t        source (-> (buffer 64) (fill! (concat ds-one ds-two)) (sealed!))\n  1063\t        destination (buffer 64)\n  1064\t        final (drive source destination (d/forward-initial-state (oldest-cursor source)))\n  1065\t        forwarded (drain destination)]\n  1066\t    (is (= :source-ended (:status final)))\n  1067\t    (is (= (set (map first ds-one)) (set (map first ds-two)))\n  1068\t        \"both graphs mint -16-based tempids\")\n  1069\t    (is (not= (d/project-datoms ds-one) (d/project-datoms ds-two))\n  1070\t        \"the two graphs are semantically different, so a replay of one\n  1071\t         projection for the other cannot pass\")\n  1072\t    (is (= (concat (d/projected->datoms (d/project-datoms ds-one))\n  1073\t                   (d/projected->datoms (d/project-datoms ds-two)))\n  1074\t           forwarded))\n  1075\t    (is (= 2 (count (filter #(= :yin.debruijn/root (nth % 1)) forwarded)))\n  1076\t        \"two graphs, two explicit root markers\")))\n  1077\t\n  1078\t\n  1079\t(deftest end-of-stream-with-a-partial-frame-diagnoses\n  1080\t  (testing \"unclosed :yin/* datoms are a terminal partial frame\"\n  1081\t    (let [partial (vec (butlast (datoms-of worked-example)))\n  1082\t          source (-> (buffer 64) (fill! partial) (sealed!))\n  1083\t          destination (buffer 64)\n  1084\t          final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1085\t      (is (= :partial-frame (:status final)))\n  1086\t      (is (= :partial-frame (:rule (:diagnostic final))))\n  1087\t      (is (= partial (:datoms (:diagnostic final))))\n  1088\t      (is (zero? (:forwarded final)))\n  1089\t      (is (= final (d/forward-step source destination final {:batch-budget 8}))\n  1090\t          \"terminal state is data: re-stepping it is a no-op\")))\n  1091\t  (testing \"trailing decorations from other namespaces close cleanly\"\n  1092\t    (let [source (-> (buffer 64)\n  1093\t                     (fill! (datoms-of worked-example))\n  1094\t                     (fill! [[-16 :yin.code/pc 3 0 1], [-9 :db/ident :x 0 1]])\n  1095\t                     (sealed!))\n  1096\t          destination (buffer 64)\n  1097\t          final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1098\t      (is (= :source-ended (:status final))))))\n  1099\t\n  1100\t\n  1101\t(deftest blocked-input-retries-without-progress\n  1102\t  (let [source (fill! (buffer 64) (datoms-of worked-example))\n  1103\t        destination (buffer 64)\n  1104\t        final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1105\t    (is (= :retry (:status final)))\n  1106\t    (is (= :dao.stream/blocked (:outcome final)))\n  1107\t    (is (= (d/projected->datoms (project worked-example)) (drain destination))\n  1108\t        \"the closed graph was forwarded before the tail blocked\")))\n  1109\t\n  1110\t\n  1111\t(deftest a-half-read-frame-is-carried-across-a-retry\n  1112\t  (let [datoms (datoms-of worked-example)\n  1113\t        half (quot (count datoms) 2)\n  1114\t        source (fill! (buffer 64) (take half datoms))\n  1115\t        destination (buffer 64)\n  1116\t        blocked (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1117\t    (is (= :retry (:status blocked)))\n  1118\t    (is (= :dao.stream/blocked (:outcome blocked)))\n  1119\t    (is (= (vec (take half datoms)) (:frame blocked))\n  1120\t        \"the half-read frame rides in the retry state — dropping it would\n  1121\t         silently lose the graph's first datoms\")\n  1122\t    (is (zero? (:forwarded blocked))\n  1123\t        \"nothing is forwarded before the frame closes\")\n  1124\t    (fill! source (drop half datoms))\n  1125\t    (sealed! source)\n  1126\t    (let [final (pump source destination blocked)]\n  1127\t      (is (= :source-ended (:status final)))\n  1128\t      (is (= (d/projected->datoms (project worked-example)) (drain destination))\n  1129\t          \"the retried step completes the SAME graph, first half included\"))))\n  1130\t\n  1131\t\n  1132\t(deftest internal-defects-are-never-mislabeled-input\n  1133\t  (is (= {:status :invalid-input, :diagnostic {:rule :dangling-ref}}\n  1134\t         (d/exception-diagnostic (ex-info \"dangling\" {:rule :dangling-ref}))))\n  1135\t  ;; a throwable carrying no diagnostic data is an internal defect with\n  1136\t  ;; its message — never :invalid-input. The message is the host's\n  1137\t  ;; ex-message: ClojureDart renders a plain Exception's as its toString.\n  1138\t  (let [plain #?(:clj (RuntimeException. \"boom\")\n  1139\t                 :cljs (js/Error. \"boom\")\n  1140\t                 :cljd (Exception. \"boom\"))\n  1141\t        message #?(:clj \"boom\"\n  1142\t                   :cljs \"boom\"\n  1143\t                   :cljd \"Exception: boom\")]\n  1144\t    (is (= {:status :internal-error,\n  1145\t            :diagnostic {:rule :internal-error, :message message}}\n  1146\t           (d/exception-diagnostic plain)))))\n  1147\t\n  1148\t\n  1149\t(deftest pending-writes-wait-for-host-cadence\n  1150\t  (let [expected (d/projected->datoms (project worked-example))\n  1151\t        source (-> (buffer 64) (fill! (datoms-of worked-example)) (sealed!))\n  1152\t        {:keys [accepted writer]} (scripted-writer [:dao.stream/full])\n  1153\t        first-pass (drive source writer (d/forward-initial-state (oldest-cursor source)))]\n  1154\t    (is (= :retry (:status first-pass)))\n  1155\t    (is (= :dao.stream/full (:outcome first-pass)))\n  1156\t    (is (= (count expected) (count (:pending first-pass))))\n  1157\t    (is (empty? @accepted)\n  1158\t        \"a full destination keeps every pending write explicit\")\n  1159\t    (let [second-pass (pump source writer first-pass)]\n  1160\t      (is (= :source-ended (:status second-pass)))\n  1161\t      (is (= expected @accepted))\n  1162\t      (is (pos? (:forwarded second-pass)) \"the retry cadence completed the writes\"))))\n  1163\t\n  1164\t\n  1165\t(deftest destination-defects-are-terminal\n  1166\t  (let [source (-> (buffer 64) (fill! (datoms-of worked-example)) (sealed!))\n  1167\t        destination (sealed! (buffer 64))\n  1168\t        final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1169\t    (is (= :destination-closed (:status final)))\n  1170\t    (is (= :dao.stream/closed (:outcome final)))))\n  1171\t\n  1172\t\n  1173\t(deftest source-transport-defects-are-terminal\n  1174\t  (let [destination (buffer 8)]\n  1175\t    (doseq [[outcome status] [[:dao.stream/transport-error :source-transport-error]\n  1176\t                              [:dao.stream/gap :source-gap]\n  1177\t                              [:dao.stream/cursor-mismatch :source-cursor-mismatch]\n  1178\t                              [:dao.stream/invalid-cursor :source-invalid-cursor]]]\n  1179\t      (let [final (d/forward-step (refusing-reader outcome)\n  1180\t                                  destination\n  1181\t                                  (d/forward-initial-state :cursor)\n  1182\t                                  {:batch-budget 4})]\n  1183\t        (is (= status (:status final)))\n  1184\t        (is (= outcome (:outcome final)))))))\n  1185\t\n  1186\t\n  1187\t(deftest invalid-stream-input-is-a-terminal-diagnostic\n  1188\t  (testing \"a malformed datom\"\n  1189\t    (let [source (-> (buffer 64) (fill! [(first (datoms-of worked-example))])\n  1190\t                     (fill! [[16 :yin/type]])\n  1191\t                     (sealed!))\n  1192\t          destination (buffer 8)\n  1193\t          final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1194\t      (is (= :invalid-input (:status final)))\n  1195\t      (is (= :malformed-datom (:rule (:diagnostic final))))))\n  1196\t  (testing \"a projection defect through the stream\"\n  1197\t    (let [dangling (mapv (fn [[e a _v :as x]]\n  1198\t                           (if (= :yin/body a) [e a -999 (nth x 3) (nth x 4)] x))\n  1199\t                         (datoms-of (lam '[x] (v 'x))))\n  1200\t          source (-> (buffer 64) (fill! dangling) (sealed!))\n  1201\t          destination (buffer 8)\n  1202\t          final (drive source destination (d/forward-initial-state (oldest-cursor source)))]\n  1203\t      (is (= :invalid-input (:status final)))\n  1204\t      (is (= :dangling-ref (:rule (:diagnostic final)))))))\n  1205\t\n  1206\t\n  1207\t(deftest wrongly-typed-projected-slots-diagnose-before-hashing\n  1208\t  (let [ds (d/projected->datoms (project (lam '[x] (v 'x))))\n  1209\t        revalue (fn [attr value]\n  1210\t                  (mapv (fn [x]\n  1211\t                          (if (= attr (nth x 1))\n  1212\t                            [(nth x 0) (nth x 1) value (nth x 3) (nth x 4)]\n  1213\t                            x))\n  1214\t                        ds))]\n  1215\t    (is (= :unsupported-value\n     1\t(ns yin.vm.pipeline\n     2\t  \"D5 of the de Bruijn projection (docs/design/yin.vm.debruijn-projection.md\n     3\t   §6-§7-D5, §9): the post-emission orchestration that wires Yang's output\n     4\t   to projected persistence.\n     5\t\n     6\t   `persist-compiled!` is the composition adapter the architect's D5\n     7\t   clearance named: it emits the named :yin/* datom batch itself (or takes\n     8\t   a pre-emitted one), persists the NAMED batch first through the caller's\n     9\t   named writer, and only after named persistence succeeds materializes\n    10\t   the canonical projected envelope into a separate DaoJing content store.\n    11\t   The two sides report independently: a projection failure is a\n    12\t   :diagnostic on the projected side and never fails the named side; a\n    13\t   named failure means projected persistence is not attempted.\n    14\t\n    15\t   Ordering: only one COMPLETE root-framed batch is ever projected — never\n    16\t   a mid-emission prefix — and framing and index state are per batch, so\n    17\t   adjacent calls reusing the emitter's -16-based tempids project\n    18\t   independently. The batch passes the stream path's own framing gate,\n    19\t   `debruijn/frame-datoms`, before either side persists: a partial frame,\n    20\t   a malformed or retract datom, or anything but exactly one complete\n    21\t   frame rejects the whole call.\n    22\t\n    23\t   Dedupe is DaoJing's write idempotence alone: `dao.jing/materialize!`\n    24\t   inserts or finds :present, verifies the read-back, and never\n    25\t   overwrites; there is no pre-write lookup, and named artifacts are never\n    26\t   deduplicated by fingerprint. The result carries both identities — the\n    27\t   physical DaoJing segment address of the envelope and the semantic\n    28\t   Merkle fingerprint inside it. The physical address comes from\n    29\t   DaoJing's transitional print-based hash and is portable only between\n    30\t   implementations sharing that print rule; the Merkle fingerprint is the\n    31\t   cross-host identity.\n    32\t\n    33\t   Nothing here edits or is consumed by named consumers or runtime\n    34\t   layers: no yang.* compiler, emitter, encoder, VM, linearizer,\n    35\t   dao.stream, lease, or waitset code reads anything this namespace\n    36\t   writes.\"\n    37\t  (:require [dao.jing :as jing]\n    38\t            [yin.vm :as vm]\n    39\t            [yin.vm.debruijn :as debruijn]))\n    40\t\n    41\t\n    42\t(defn projected-envelope\n    43\t  \"The canonical projected persistence value: the Merkle fingerprint and\n    44\t   the projected d5 datoms as one plain-data envelope, the exact value\n    45\t   `dao.jing/materialize!` content-addresses. The fingerprint inside is\n    46\t   the semantic identity; the segment address the store returns for this\n    47\t   envelope is the physical one.\"\n    48\t  [{:keys [fingerprint records]}]\n    49\t  {:yin.debruijn/fingerprint fingerprint,\n    50\t   :yin.debruijn/datoms (debruijn/projected->datoms {:fingerprint fingerprint,\n    51\t                                                     :records records})})\n    52\t\n    53\t\n    54\t(defn- batch-of\n    55\t  \"The complete named batch for one request: emitted from :ast through\n    56\t   `vm/ast->datoms-with-root` — always complete, the root marker last —\n    57\t   or taken pre-emitted from :datoms, the path on which the complete-batch\n    58\t   rule is observable (an :ast cannot emit a partial batch). Exactly one\n    59\t   of the two; both or neither is a caller defect.\"\n    60\t  [request]\n    61\t  (let [ast? (some? (:ast request))\n    62\t        datoms? (some? (:datoms request))]\n    63\t    (cond\n    64\t      (and ast? datoms?)\n    65\t      (throw (ex-info \"persist-compiled! takes :ast or :datoms, not both\"\n    66\t                      {:rule :bad-request, :request-keys (vec (keys request))}))\n    67\t\n    68\t      ast? (second (vm/ast->datoms-with-root (:ast request)))\n    69\t      datoms? (vec (:datoms request))\n    70\t      :else (throw (ex-info \"persist-compiled! requires :ast or :datoms\"\n    71\t                            {:rule :bad-request, :request-keys (vec (keys request))})))))\n    72\t\n    73\t\n    74\t(defn- framing-defect\n    75\t  \"The batch's framing defect under the stream path's own gate\n    76\t   (`debruijn/frame-datoms`), or nil when it is exactly one complete\n    77\t   root-framed graph. The defect is {:rule …}: frame-datoms' own rule —\n    78\t   :partial-frame, :malformed-datom, :retract — :missing-root for a batch\n    79\t   with no frame at all, or :multiple-frames for several.\"\n    80\t  [datoms]\n    81\t  (try\n    82\t    (let [frames (debruijn/frame-datoms datoms)]\n    83\t      (case (count frames)\n    84\t        1 nil\n    85\t        0 {:rule :missing-root}\n    86\t        {:rule :multiple-frames, :frames (count frames)}))\n    87\t    (catch #?(:cljd Object :clj Throwable :cljs :default) t\n    88\t      (let [{:keys [status diagnostic]} (debruijn/exception-diagnostic t)]\n    89\t        (if (= :invalid-input status)\n    90\t          {:rule (:rule diagnostic)}\n    91\t          diagnostic)))))\n    92\t\n    93\t\n    94\t(defn- persist-projected!\n    95\t  \"The projected side in isolation: project the complete batch, then\n    96\t   materialize the canonical envelope. A projection diagnostic is\n    97\t   {:outcome :diagnostic, :diagnostic …}; an internal defect in the\n    98\t   projection is {:outcome :internal-error, :diagnostic …}; a store\n    99\t   failure is a :diagnostic with :rule :projected-write-failed and only\n   100\t   the store's :result and :address as :cause, never the envelope. None\n   101\t   is thrown across the boundary the named side already crossed.\"\n   102\t  [datoms projected-store]\n   103\t  (let [projection (try\n   104\t                     (debruijn/project-datoms datoms)\n   105\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) t\n   106\t                       (debruijn/exception-diagnostic t)))]\n   107\t    (if-let [status (:status projection)]\n   108\t      {:outcome (if (= :internal-error status) :internal-error :diagnostic),\n   109\t       :diagnostic (:diagnostic projection)}\n   110\t      (try\n   111\t        (let [address (jing/materialize! projected-store\n   112\t                                         (projected-envelope projection))]\n   113\t          {:outcome :ok,\n   114\t           :fingerprint (:fingerprint projection),\n   115\t           :address address})\n   116\t        (catch #?(:cljd Object :clj Throwable :cljs :default) t\n   117\t          {:outcome :diagnostic,\n   118\t           :diagnostic {:rule :projected-write-failed,\n   119\t                        :message (ex-message t),\n   120\t                        :cause (select-keys (ex-data t) [:result :address])}})))))\n   121\t\n   122\t\n   123\t(defn persist-compiled!\n   124\t  \"Persist one compiled program's two artifacts, named first.\n   125\t\n   126\t   Takes {:ast <map AST> | :datoms <pre-emitted named batch>\n   127\t          :named-writer (fn [datoms] -> outcome map)\n   128\t          :projected-store <dao.jing content-store handle>\n   129\t          :provenance <opaque caller data>}.\n   130\t\n   131\t   :named-writer receives the complete named :yin/* batch and answers a\n   132\t   dao.stream outcome map; its :dao.stream/outcome decides the named side\n   133\t   and its whole receipt rides under :receipt. A writer that throws\n   134\t   propagates: that is a defect in the caller's own argument, exactly as\n   135\t   dao.space.transactor treats malformed input.\n   136\t\n   137\t   Returns {:named {...} :projected {...} :provenance <echo>} where the\n   138\t   two sides report independently:\n   139\t\n   140\t   | named :outcome          | when                             | projected :outcome                       |\n   141\t   |-------------------------|----------------------------------|------------------------------------------|\n   142\t   | :ok                     | writer answered :dao.stream/ok   | :ok (with :fingerprint and :address),    |\n   143\t   |                         |                                  | :diagnostic — projection or the store —, |\n   144\t   |                         |                                  | or :internal-error — a projection defect |\n   145\t   | <writer's non-ok kw>    | writer answered another keyword  | :not-attempted                           |\n   146\t   | :invalid-writer-answer  | answer carries no keyword outcome| :not-attempted                           |\n   147\t   | :rejected               | batch fails the framing gate     | :not-attempted (same :rule)              |\n   148\t\n   149\t   :provenance is opaque caller data echoed for correlation; it is never\n   150\t   interpreted and never enters either artifact.\"\n   151\t  [{:keys [named-writer projected-store provenance] :as request}]\n   152\t  (let [datoms (batch-of request)]\n   153\t    (if-let [{:keys [rule]} (framing-defect datoms)]\n   154\t      {:named {:outcome :rejected, :rule rule},\n   155\t       :projected {:outcome :not-attempted, :rule rule},\n   156\t       :provenance provenance}\n   157\t      (let [named-receipt (named-writer datoms)\n   158\t            answered (when (map? named-receipt)\n   159\t                       (get named-receipt :dao.stream/outcome))\n   160\t            named-outcome (if (keyword? answered) answered :invalid-writer-answer)]\n   161\t        (if-not (= :dao.stream/ok named-outcome)\n   162\t          {:named {:outcome named-outcome, :receipt named-receipt},\n   163\t           :projected {:outcome :not-attempted, :named-outcome named-outcome},\n   164\t           :provenance provenance}\n   165\t          {:named {:outcome :ok, :receipt named-receipt},\n   166\t           :projected (persist-projected! datoms projected-store),\n   167\t           :provenance provenance})))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"F[1-9]|P1|P2|P3|NOT READY|READY|missing-root|multiple-frames|memo|check-record\" collab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md collab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md | head -160'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"F[1-9]|P1|P2|P3|NOT READY|READY|missing-root|multiple-frames|memo|check-record\" collab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md collab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md | head -160'","aggregated_output":"collab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:27:1. **Epic-audit fixes** for the opus-5 audit that returned NOT READY. The full\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:30:   Findings: F1 sets merge silently under canonicalization; F2 the reader\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:32:   F3 exponential hashing on shared subgraphs; F4 known attribute on the wrong\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:33:   node type ignored; F6 internal defects surfacing as :invalid-input; F7 a\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:34:   batch budget of 0 returning :continue forever; F9/D6 gap tests.\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:38:2. **D5 fixes** from a claude-sonnet-5 review (NOT READY, then applied):\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:58:1. **Hash neutrality.** F2/F3 must not change any minted hash or the\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:63:   particular attention to the new `check-record`: canonical-spelling checks\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:68:2. **F3 memo soundness.** Records are now minted once per `[eid stack]` memo\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:70:   Is the memo key complete (the full frame-vector stack, per the D1 lesson —\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:75:3. **F1 / encode-value set rule** on every host, including the count-shrink\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:77:4. **F6 / F7 classification and budget rules** — is `exception-diagnostic`'s\ncollab/1789976750630-reviewer-debruijn-epicfix-glm.prompt.md:106:Then a verdict line — READY or NOT READY — then findings as P1/P2/P3.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:3:Task: collab/1789968388070-reviewer-debruijn-epic-audit.prompt.md. I read only the committed files through `git show debruijn-impl:…`. Line numbers below refer to `git show debruijn-impl:src/cljc/yin/vm/debruijn.cljc`. The P2 findings F1–F3 and P3 finding F4 were confirmed on the JVM. I did that by loading the committed file from /tmp into a REPL. I did not rerun any test suites.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:7:### P2\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:9:**F1. A set whose elements merge under canonicalisation collapses silently. The map rule diagnoses the same case.**\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:17:**F2. The storage reader verifies the preimage, not the record.**\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:30:**F3. `merkle-node` takes time exponential in how deeply shared subgraphs nest (the D1/D2 seam).**\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:31:- `project-node`'s memo (line 743) returns the same resolved node object for a shared `[eid stack]`. `merkle-node` (lines 1035–1061) then recurses into every child before it looks up the hash-cons table, so it walks the fully unfolded tree.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:35:- §5's promise that \"memoisation and sharing cannot change identity\" still holds; sharing just stops paying off.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:36:- Fix: thread the hash through the D1 memo so a shared occurrence reuses its hash. For example, have `project-node` cache `[node h]`, or fold `merkle-node` into the walk. Add a timing-free test that counts hash-cons misses against a doubling chain.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:38:### P3\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:40:- **F4. Known attributes on the wrong node type are ignored, including dangling refs.** `known-attributes` (lines 357–364) is the union over every node type, so `check-attributes` (lines 472–483) accepts, for example, `:yin/body 999` on a `:literal`. Confirmed: it projects with no diagnostic. §2 says \"unknown `:yin/*` attribute\", which is ambiguous here, but a dangling ref slipping through undiagnosed conflicts with §1. Fix: a per-type allowed set.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:41:- **F5. `projected->datoms` uses three local atoms** (lines 1118–1120). This holds to §1's literal \"no namespace atom\", but it is the only mutable state in the namespace. A `reduce` would make the whole file mutation-free. Not blocking.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:42:- **F6. `exception-diagnostic` (lines 1331–1341) labels every `ex-info` as `:invalid-input`.** That includes the writer-internal defect at line 1130 (\"record set does not contain a child hash\"), which can only mean a projection bug. The narrow fix is to label `:rule` values that only internal code can produce as `:internal-error`.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:43:- **F7. `forward-positive-budget` (lines 1294–1299) accepts a budget of 0** despite its name. The result is `:continue` with no progress, forever, under host cadence. Either require `pos-int?` or return a terminal status.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:44:- **F8. `check-unexpanded` (lines 486–500) only catches an operator that is literally a `:lambda`.** A macro lambda reached through a bound variable (let-bound) also escapes. That limit is wider than the free-variable-name limit §1 documents; either say so in the doc or accept it.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:45:- **F9. The projected writer emits nil-valued datoms**, e.g. `[e :yin.debruijn/value nil]` for `(lit nil)` (line 1138). The D2 round-trip covers this only in memory. If D5's store drops nil values, the reader will report `:hash-mismatch`. D5 must prove a nil literal round-trips through real storage.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:60:  - F1 set collapse. This is new and beyond the declared limits.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:61:  - F2 lets a reader return different record content under one address.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:70:  - D2 records vs D3 canonical spelling: F1, and F2(b).\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:71:  - D1 memo vs D2 hash-consing: F3.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:72:  - D0 grammar vs D2 preimage vs D2 reader: F2(a).\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:76:- The only mutation is F5's local atoms, which nothing outside the function can observe.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:80:- Result: holds, with the F5 caveat.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:83:- *D0–D5 criteria pass*: D0–D4 are committed and green. D5 has not landed, and it must also cover the F9 nil round-trip.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:85:- *Non-equivalent fixtures remain distinct*: `content-changes-change-the-fingerprint` and `operand-order-changes-the-hash` cover this. F1 is a counterexample outside the fixtures; fix it and add the fixture.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:90:- *Reader canonical-spelling gate*: not benign in combination. On its own it only admits differences the declared limits already cover. Combined with the slot-name-free preimage (F2a), the reader accepts records no writer can produce, under valid addresses. D5 is where stored segments start being read, so this should be fixed before D5 relies on the reader.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:91:- *§1 state-list wording*: benign. Index, scope, and memo are threaded explicitly inside the pure per-frame projection, and there is no output cursor (append-only). It is a documentation mismatch only. I recommend a one-line edit to the §1 list, e.g. \"explicit in the forward-step state or threaded through the pure per-frame projection\". It does not combine with anything else; F5's atoms are local to the writer, not step state.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:93:**5. What the four phase reviews all missed:** F1, F2(a), F3, and F4. Each one only appears when you look across phases: the set rule against the D3 map ruling, the D0 grammar against the D2 reader, the D1 memo against the D2 hash-consing, and the D0 attribute set against the §1 dangling-ref rule.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:96:F1–F3 all touch `debruijn.cljc`, which the D5 delegate is editing in the working tree. They should land as a separate fix round after D5 commits, or be handed to that delegate, rather than edited alongside its work. F4–F9 can go in the same round or be accepted as recorded limits.\ncollab/1789975149204-compiler-engineer-debruijn-epicfix-claude.ref-epic-audit-full.md:99:EPIC NOT READY — blocking: F1 (set cardinality collapse under canonicalisation), F2 (the reader accepts slot-swapped and non-canonically spelled records under valid addresses), F3 (exponential Merkle pass over shared graphs the emitter produces).\n","exit_code":0,"status":"completed"}}
