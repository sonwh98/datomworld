82:   Statuses: :continue (budget spent, work may remain) and :retry\n1489:   ex-data under :diagnostic; or a :batch-budget that is not a positive\n1490:   integer, :rule :invalid-budget, before any work), :internal-error (a non-diagnostic\n1509:         budget (:batch-budget options)]\n1514:       (not (forward-budget-ok? budget))\n1521:                       {:rule :invalid-budget, :batch-budget budget})\n1527:              remaining budget\n   300\t  \"The one NFC seam of the projection (§5): every string entering\n   301\t   canonical encoding passes through here. :clj delegates to\n   302\t   java.text.Normalizer, :cljs to String.prototype.normalize, and :cljd\n   303\t   to the unorm_dart package (Unicode 16.0, owner-settled 2026-09-21) so\n   304\t   every ClojureDart target normalizes identically. NFC normalisation\n   305\t   collisions — distinct inputs with one composed form — are an\n   306\t   inherited limit of the repository encoding.\"\n   307\t  [^String s]\n   308\t  #?(:clj (java.text.Normalizer/normalize s java.text.Normalizer$Form/NFC)\n   309\t     :cljs (.normalize s \"NFC\")\n   310\t     :cljd (unorm/nfc s)))\n   311\t\n   312\t\n   313\t;; =============================================================================\n   314\t;; D0: the walked node grammar (§2)\n   315\t;; =============================================================================\n   316\t\n   317\t(def node-grammar\n   318\t  \"§2's walked node grammar and child order as the walk vocabulary —\n   319\t   exactly the emitter's table. Scalars are [attribute slot-kind] in\n   320\t   declared order; children are [attribute cardinality] in the fixed\n   321\t   walk order. Slot kinds: :canonical is the full §5 value domain;\n   322\t   :syms is an ordered vector of symbols; the rest are the obvious\n   323\t   scalar types.\"\n   324\t  {:literal {:scalars [[:yin/value :canonical]], :children []}\n   325\t   :variable {:scalars [[:yin/name :symbol]], :children []}\n   326\t   :lambda {:scalars [[:yin/params :syms] [:yin/macro? :bool]],\n   327\t            :children [[:yin/body :node]]}\n   328\t   :application {:scalars [],\n   329\t                 :children [[:yin/operator :node] [:yin/operands :nodes]]}\n   330\t   :dao.stream.apply/call {:scalars [[:yin/op :keyword]],\n   331\t                           :children [[:yin/operands :nodes]]}\n   332\t   :if {:scalars [],\n   333\t        :children [[:yin/test :node] [:yin/consequent :node]\n   334\t                   [:yin/alternate :node]]}\n   335\t   :vm/gensym {:scalars [[:yin/prefix :string]], :children []}\n   336\t   :vm/store-get {:scalars [[:yin/key :symbol]], :children []}\n   337\t   :vm/store-put {:scalars [[:yin/key :symbol] [:yin/value :canonical]],\n   338\t                  :children []}\n   339\t   :vm/current-continuation {:scalars [], :children []}\n   340\t   :vm/park {:scalars [], :children []}\n   341\t   :vm/resume {:scalars [[:yin/parked-id :keyword]],\n   342\t               :children [[:yin/val-node :node]]}\n   343\t   :stream/make {:scalars [[:yin/buffer :int64]], :children []}\n   344\t   :stream/put {:scalars [],\n   345\t                :children [[:yin/target :node] [:yin/val-node :node]]}\n   346\t   :stream/cursor {:scalars [], :children [[:yin/source :node]]}\n   347\t   :stream/next {:scalars [], :children [[:yin/source :node]]}\n   348\t   :stream/close {:scalars [], :children [[:yin/source :node]]}})\n   349\t\n   350\t\n   351\t(def ^:private optional-attributes\n   352\t  \"§2's optional scalar: only :yin/macro? may be absent from a\n   353\t   well-formed emitter batch. Every other grammar slot is required.\"\n   354\t  #{:yin/macro?})\n   355\t\n   356\t\n   357\t(def ^:private tolerated-attributes\n   358\t  \"The :yin/* facts legal on a walked node of any type: :yin/type, the\n   359\t   :yin/root framing fact, and §2's tolerated-and-ignored emission\n   360\t   metadata.\"\n   361\t  #{:yin/type :yin/root :yin/tail? :yin/macro-name})\n   362\t\n   363\t\n   364\t(def ^:private known-attributes\n   365\t  \"Per node type, the complete legal :yin/* vocabulary on a walked node\n   366\t   of that type: its grammar row's slots plus the tolerated set. A known\n   367\t   attribute on a type whose row does not list it — a :yin/body on a\n   368\t   :literal, dangling or not — is as unknown there as :yin/extra, never\n   369\t   silently ignored.\"\n   370\t  (into {}\n   371\t        (map (fn [[tag {:keys [scalars children]}]]\n   372\t               [tag (into tolerated-attributes\n   373\t                          (map first)\n   374\t                          (concat scalars children))]))\n   375\t        node-grammar))\n   376\t\n   377\t\n   378\t;; =============================================================================\n   379\t;; D0: root framing and input validation (§2)\n   380\t;; =============================================================================\n   381\t\n   382\t(defn- check-datom\n   383\t  \"Validate one input datom as a d5 [e a v t m] assert. Shape first, then\n   384\t   §2's assert-only rule: m must not be dao.datom's reserved :db/retract\n   385\t   op — read through `reserved`, never a bare literal. An assert carrying\n   386\t   any other provenance m stays valid; once this passes, t and m are\n   387\t   excluded from projected identity.\"\n   388\t  [d]\n   389\t  (when-not (and (vector? d) (= 5 (count d)))\n   390\t    (throw (ex-info \"Malformed d5 datom in projection input\"\n   391\t                    {:rule :malformed-datom, :datom d})))\n   392\t  (let [[e a _v t m] d]\n   393\t    (when-not (and (int? e)\n   394\t                   (keyword? a)\n   395\t                   (some? (namespace a))\n   396\t                   (int? t)\n   397\t                   (int? m))\n   398\t      (throw (ex-info \"Malformed d5 datom in projection input\"\n   399\t                      {:rule :malformed-datom, :datom d})))\n   400\t    (when (= m (:db/retract datom/reserved))\n   401\t      (throw (ex-info \"Retract datom in assert-only projection input\"\n   402\t                      {:rule :retract, :datom d})))\n   403\t    d))\n   404\t\n   405\t\n   406\t(defn frame-datoms\n   407\t  \"§2 root framing: split one datom stream into its rooted graphs. A\n   408\t   :yin/root true marker closes the graph accumulated above it; the next\n   409\t   graph starts empty, so its fact index is a fresh one — emitter\n   410\t   temporary ids may restart at -16 per graph, and never merge across\n   411\t   graphs. Datoms outside the :yin namespace never reach the projection,\n   412\t   so they neither open nor extend a frame: trailing decorations after\n   413\t   the last marker are not a partial graph, and the returned frames carry\n   414\t   :yin/* datoms only. End-of-stream with :yin/* datoms no marker closes\n   415\t   is a diagnostic.\"\n   416\t  [datoms]\n   417\t  (let [[frames partial]\n   418\t        (reduce (fn [[frames frame] d]\n   419\t                  (let [[_e a v] (check-datom d)]\n   420\t                    (cond\n   421\t                      (and (= :yin/root a) (true? v))\n   422\t                      [(conj frames (conj frame d)) []]\n   423\t\n   424\t                      (not= \"yin\" (namespace a))\n   425\t                      [frames frame]\n   426\t\n   427\t                      :else [frames (conj frame d)])))\n   428\t                [[] []]\n   429\t                datoms)]\n   430\t    (when (seq partial)\n   431\t      (throw (ex-info \"End of stream with a partial rooted graph\"\n   432\t                      {:rule :partial-frame, :datoms (vec partial)})))\n   433\t    frames))\n   434\t\n   435\t\n   436\t(defn- index-frame\n   437\t  \"Build one frame's fact index {eid {attribute v}} over the attributes of\n   438\t   one namespace. Input order never matters: the index is keyed by [e a],\n   439\t   t and m are dropped, attributes in other namespaces are ignored, and a\n   440\t   second fact on