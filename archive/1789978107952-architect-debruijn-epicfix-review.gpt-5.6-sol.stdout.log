\t\n   483\t(defn- check-attributes\n   484\t  \"§2's unknown-attribute diagnostic: every :yin/* fact on a walked node\n   485\t   must be inside its own type's grammar row or §2's tolerated set. Facts\n   486\t   on entities the walk never reaches are not diagnosed.\"\n   487\t  [tag facts eid path]\n   488\t  (let [known (get known-attributes tag)]\n   489\t    (doseq [a (keys facts)]\n   490\t      (when-not (contains? known a)\n   491\t        (throw (ex-info \"Unknown :yin/* attribute on a walked node\"\n   492\t                        {:rule :unknown-attribute,\n   493\t                         :attribute a,\n   494\t                         :type tag,\n   495\t                         :entity eid,\n   496\t                         :path path}))))))\n   497\t\n   498\t\n   499\t(defn- check-unexpanded\n   500\t  \"§1's unexpanded-macro detection: an application whose operator is a\n   501\t   :lambda carrying :macro? true is an unexpanded call site — a terminal\n   502\t   diagnostic, never silently interpreted. The stated limit: a free\n   503\t   variable whose name matches a registry macro is not detectable from\n   504\t   these datoms.\"\n   505\t  [index eid operator-eid path]\n   506\t  (when-let [operator (get index operator-eid)]\n   507\t    (when (and (= :lambda (get operator :yin/type))\n   508\t               (true? (get operator :yin/macro?)))\n   509\t      (throw (ex-info \"Unexpanded macro call site\"\n   510\t                      {:rule :unexpanded-macro,\n   511\t                       :entity eid,\n   512\t                       :operator operator-eid,\n   513\t                       :path path})))))\n   514\t\n   515\t\n   516\t(defn- slot-kind-ok?\n   517\t  [kind v]\n   518\t  (case kind\n   519\t    :canonical (canonical-value? v)\n   520\t    :symbol (symbol? v)\n   521\t    :syms (and (vector? v) (every? symbol? v))\n   522\t    :bool (or (true? v) (false? v))\n   523\t    :keyword (keyword? v)\n   524\t    :string (string? v)\n   525\t    ;; number? first: a non-number reaching numeric-class would be a host\n   526\t    ;; type error on :cljd, not the :unsupported-value diagnostic\n   527\t    :int64 (and (number? v) (= :int64 (numeric-class v)))))\n   528\t\n   529\t\n   530\t(defn- validated-scalars\n   531\t  \"Read the grammar's scalar slots off one walked node's facts, §5-valid\n   532\t   in kind and required unless optional. Returns {attribute value} for\n   533\t   the present ones; anything else is a diagnostic.\"\n   534\t  [tag {:keys [scalars]} facts eid path]\n   535\t  (reduce (fn [out [attr kind]]\n   536\t            (if (contains? facts attr)\n   537\t              (let [v (get facts attr)]\n   538\t                (if (slot-kind-ok? kind v)\n   539\t                  (assoc out attr v)\n   540\t                  (throw (ex-info \"Unsupported slot value in AST datoms\"\n   541\t                                  {:rule :unsupported-value,\n   542\t                                   :slot attr,\n   543\t                                   :kind kind,\n   544\t                                   :value v,\n   545\t                                   :entity eid,\n   546\t                                   :path path}))))\n   547\t              (if (contains? optional-attributes attr)\n   548\t                out\n   549\t                (throw (ex-info \"Missing required AST attribute\"\n   550\t                                {:rule :missing-slot,\n   551\t                                 :slot attr,\n   552\t                                 :type tag,\n   553\t                                 :entity eid,\n   554\t                                 :path path})))))\n   555\t          {}\n   556\t          scalars))\n   557\t\n   558\t\n   559\t(defn- child-ref\n   560\t  \"One :node child slot's entity id, validated as an integer ref.\"\n   561\t  [facts attr eid path]\n   562\t  (let [v (if (contains? facts attr)\n   563\t            (get facts attr)\n   564\t            (throw (ex-info \"Missing required AST attribute\"\n   565\t                            {:rule :missing-slot,\n   566\t                             :slot attr,\n   567\t                             :entity eid,\n   568\t                             :path path})))]\n   569\t    (if (int? v)\n   570\t      v\n   571\t      (throw (ex-info \"Unsupported slot value in AST datoms\"\n   572\t                      {:rule :unsupported-value,\n   573\t                       :slot attr,\n   574\t                       :kind :ref,\n   575\t                       :value v,\n   576\t                       :entity eid,\n   577\t                       :path path})))))\n   578\t\n   579\t\n   580\t(defn- child-refs\n   581\t  \"One :nodes child slot's ordered entity ids, validated as integer refs.\n   582\t   A vector is ordered data, never a set (§2).\"\n   583\t  [facts attr eid path]\n   584\t  (let [v (if (contains? facts attr)\n   585\t            (get facts attr)\n   586\t            (throw (ex-info \"Missing required AST attribute\"\n   587\t                            {:rule :missing-slot,\n   588\t                             :slot attr,\n   589\t                             :entity eid,\n   590\t                             :path path})))]\n   591\t    (if (and (vector? v) (every? int? v))\n   592\t      v\n   593\t      (throw (ex-info \"Unsupported slot value in AST datoms\"\n   594\t                      {:rule :unsupported-value,\n   595\t                       :slot attr,\n   596\t                       :kind :refs,\n   597\t                       :value v,\n   598\t                       :entity eid,\n   599\t                       :path path})))))\n   600\t\n   601\t\n   602\t;; =============================================================================\n   603\t;; D1: the scope resolver (§3)\n   604\t;; =============================================================================\n   605\t\n   606\t(defn resolve-name\n   607\t  \"§3 scope resolution of `name` against `stack`, the ordered frame\n   608\t   vector stack: frame depth 0 is the innermost frame, each frame is the\n   609\t   source-ordered parameter vector, position is the source parameter\n   610\t   index with the leftmost parameter at 0. Frames search inner-to-outer;\n   611\t   positions search right-to-left within a frame, so duplicate\n   612\t   parameters are rightmost-wins exactly as `yin.vm.engine/bind-params`\n   613\t   binds them — (fn [x x] x) resolves to the second x, [0 1]. Returns\n   614\t   {:bound [frame-depth position]} or {:free name} with the symbol\n   615\t   preserved exactly.\"\n   616\t  [stack name]\n   617\t  (let [position-in (fn [frame]\n   618\t                      (first (filter (fn [p] (= name (nth frame p)))\n   619\t                                     (range (dec (count frame)) -1 -1))))\n   620\t        binding (first (keep (fn [depth]\n   621\t                               (when-let [p (position-in (nth stack depth))]\n   622\t                                 [depth p]))\n   623\t                             (range (count stack))))]\n   624\t    (if binding\n   625\t      {:bound binding}\n   626\t      {:free name})))\n   627\t\n   628\t\n   629\t;; =============================================================================\n   630\t;; D1: the projection walk (§2 grammar, §3 scopes, no hashing)\n   631\t;; =============================================================================\n   632\t\n   633\t(declare project-node mint-record)\n   634\t\n   635\t\n   636\t(defn- build-node\n   637\t  \"Build one walked node's resolved semantic node — the §4 projected\n   638\t   slots, children as resolved nodes — recursing over children in the\n   639\t   grammar's fixed order under the scope at each occurrence. Returns\n   640\t   [node child-hashes acc'], child-hashes being {slot h} with an ordered\n   641\t   vector of hashes under :yin.debruijn/operands; `active` is the set of\n   642\t   eids on the current path.\"\n   643\t  [tag index facts scalar eid stack acc active path]\n   644\t  (let [;; each step threads [node child-hashes acc]\n   645\t        child (fn [[node refs acc] slot attr stack]\n   646\t                (let [[n h acc'] (project-node index\n   647\t                                               (child-ref facts attr eid path)\n   648\t                                               stack\n   649\t                                               acc\n   650\t                                               active\n   651\t                                               (conj path attr))]\n   652\t                  [(assoc node slot n) (assoc refs slot h) acc']))\n   653\t        children (fn [[node refs acc] slot attr]\n   654\t                   (let [[ns hs acc']\n   655\t                         (reduce (fn [[ns hs a] ref]\n   656\t                                   (let [[n h a'] (project-node index\n   657\t                                                                ref\n   658\t                                                                stack\n   659\t                                                                a\n   660\t                                                                active\n   661\t                                                                (conj path attr))]\n   662\t                                     [(conj ns n) (conj hs h) a']))\n   663\t                                 [[] [] acc]\n   664\t                                 (child-refs facts attr eid path))]\n   665\t                     [(assoc node slot ns) (assoc refs slot hs) acc']))\n   666\t        leaf (fn [node] [node {} acc])]\n   667\t    (case tag\n   668\t      :literal (leaf {:yin.debruijn/type :literal,\n   669\t                      :yin.debruijn/value (get scalar :yin/value)})\n   670\t      :variable (let [name (get scalar :yin/name)\n   671\t                      resolution (resolve-name stack name)]\n   672\t                  (leaf (if-let [bound (:bound resolution)]\n   673\t                          {:yin.debruijn/type :variable,\n   674\t                           :yin.debruijn/bound bound}\n   675\t                          {:yin.debruijn/type :variable,\n   676\t                           :yin.debruijn/free (:free resolution)})))\n   677\t      :lambda (let [params (get scalar :yin/params)]\n   678\t                (child (leaf (merge {:yin.debruijn/type :lambda,\n   679\t                                     :yin.debruijn/arity (count params)}\n   680\t                                    ;; truthy only: an explicit false and an\n   681\t                                    ;; absent :yin/macro? project identically\n   682\t                                    (when (get scalar :yin/macro?)\n   683\t                                      {:yin.debruijn/macro? (get scalar :yin/macro?)})))\n   684\t                       :yin.debruijn/body\n   685\t                       :yin/body\n   686\t                       (into [params] stack)))\n   687\t      :application (let [operator-eid (child-ref facts :yin/operator eid path)]\n   688\t                     (check-unexpanded index eid operator-eid path)\n   689\t                     (-> (leaf {:yin.debruijn/type :application})\n   690\t                         (child :yin.debruijn/operator :yin/operator stack)\n   691\t                         (children :yin.debruijn/operands :yin/operands)))\n   692\t      :dao.stream.apply/call (children (leaf {:yin.debruijn/type :dao.stream.apply/call,\n   693\t                                              :yin.debruijn/op (get scalar :yin/op)})\n   694\t                                       :yin.debruijn/operands\n   695\t                                       :yin/operands)\n   696\t      :if (-> (leaf {:yin.debruijn/type :if})\n   697\t              (child :yin.debruijn/test :yin/test stack)\n   698\t              (child :yin.debruijn/consequent :yin/consequent stack)\n   699\t              (child :yin.debruijn/alternate :yin/alternate stack))\n   700\t      :vm/gensym (leaf {:yin.debruijn/type :vm/gensym,\n   701\t                        :yin.debruijn/prefix (get scalar :yin/prefix)})\n   702\t      :vm/store-get (leaf {:yin.debruijn/type :vm/store-get,\n   703\t                           :yin.debruijn/key (get scalar :yin/key)})\n   704\t      :vm/store-put (leaf {:yin.debruijn/type :vm/store-put,\n   705\t                           :yin.debruijn/value (get scalar :yin/value),\n   706\t                           :yin.debruijn/key (get scalar :yin/key)})\n   707\t      :vm/current-continuation (leaf {:yin.debruijn/type :vm/current-continuation})\n   708\t      :vm/park (leaf {:yin.debruijn/type :vm/park})\n   709\t      :vm/resume (child (leaf {:yin.debruijn/type :vm/resume,\n   710\t                               :yin.debruijn/parked-id (get scalar :yin/parked-id)})\n   711\t                        :yin.debruijn/val-node\n   712\t                        :yin/val-node\n   713\t                        stack)\n   714\t      :stream/make (leaf {:yin.debruijn/type :stream/make,\n   715\t                          :yin.debruijn/buffer (get scalar :yin/buffer)})\n   716\t      :stream/put (-> (leaf {:yin.debruijn/type :stream/put})\n   717\t                      (child :yin.debruijn/target :yin/target stack)\n   718\t                      (child :yin.debruijn/val-node :yin/val-node stack))\n   719\t      (:stream/cursor :stream/next :stream/close)\n   720\t      (child (leaf {:yin.debruijn/type tag})\n   721\t             :yin.debruijn/source\n   722\t             :yin/source\n   723\t             stack))))\n   724\t\n   725\t\n   726\t(defn- project-node\n   727\t  \"Project and hash-cons one source node under `stack`, memoized by\n   728\t   [source-eid stack] — §2's [source-eid lexical-context] key, where the\n   729\t   lexical context is the complete stack of frame parameter vectors.\n   730\t   Returns [node h acc']. The memo carries the resolved node AND its\n   731\t   hash, so a shared occurrence is resolved and hashed once: without the\n   732\t   hash in the memo, a doubling chain of shared subgraphs is minted once\n   733\t   per unfolded path, exponentially. The memo is an optimisation only:\n   734\t   it is threaded explicitly in `acc` and can never affect output\n   735\t   identity. Cycle detection runs before the memo, so an eid on the\n   736\t   active path is a diagnostic even if it was memoized at another\n   737\t   occurrence.\"\n   738\t  [index eid stack acc active path]\n   739\t  (if (contains? active eid)\n   740\t    (throw (ex-info \"Cyclic AST reference\"\n   741\t                    {:rule :cycle, :entity eid, :path path}))\n   742\t    (if-let [cached (find (:memo acc) [eid stack])]\n   743\t      (let [[node h] (val cached)]\n   744\t        [node h acc])\n   745\t      (let [facts (node-facts index eid path)\n   746\t            tag (get facts :yin/type)\n   747\t            grammar (or (get node-grammar tag)\n   748\t                        (throw (ex-info \"Unknown AST node type in projection\"\n   749\t                                        {:rule :unknown-node-type,\n   750\t                                         :type tag,\n   751\t                                         :entity eid,\n   752\t                                         :path path})))\n   753\t            _ (check-attributes tag facts eid path)\n   754\t            scalar (validated-scalars tag grammar facts eid path)\n   755\t            [node refs acc'] (build-node tag\n   756\t                                         index\n   757\t                                         facts\n   758\t                                         scalar\n   759\t                                         eid\n   760\t                                         stack\n   760\t                                         stack\n   761\t                                         acc\n   762\t                                         (conj active eid)\n   763\t                                         path)\n   764\t            [h acc''] (mint-record node refs acc')]\n   765\t        [node h (assoc-in acc'' [:memo [eid stack]] [node h])]))))\n   766\t\n   767\t\n   768\t;; =============================================================================\n   769\t;; D2: the canonical encoder and node hashes (§5)\n   770\t;; =============================================================================\n   771\t\n   772\t(def ^:private hex-digit-chars \"0123456789abcdef\")\n   773\t\n   774\t\n   775\t(defn- to-hex\n   776\t  \"Width-padded lowercase hex of the non-negative integer n.\"\n   777\t  [n width]\n   778\t  (let [base (if (zero? n)\n   779\t               \"0\"\n   780\t               (loop [n n, acc \"\"]\n   781\t                 (if (zero? n)\n   782\t                   acc\n   783\t                   (recur (unsigned-bit-shift-right n 4)\n   784\t                          (str (nth hex-digit-chars (bit-and n 0xf)) acc)))))\n   785\t        padded (str (apply str (repeat width \"0\")) base)]\n   786\t    (subs padded (- (count padded) width))))\n   787\t\n   788\t\n   789\t(def ^:private slot-tag\n   790\t  \"The settled tag byte (hex) each canonical class and compound slot type\n   791\t   renders under. Class tags are the class's index in the value table's\n   792\t   declared :classes order — read through the descriptor — and the\n   793\t   compound types (child refs, the fixed pair, the ordered vector) take\n   794\t   bytes outside that range.\"\n   795\t  (into {:ref \"c0\", :hash \"c1\", :tuple \"c2\", :ordered-vector \"c3\"}\n   796\t        (map-indexed (fn [i class] [class (to-hex i 2)]))\n   797\t        (:classes canonical-value-table)))\n   798\t\n   799\t\n   800\t;; code-unit-at lives with the D0 classifier: well-formed-utf16? reads\n   801\t;; code units there, before any encoder definition.\n   802\t\n   803\t\n   804\t(defn- utf8-byte-length\n   805\t  \"The byte length of `s` under UTF-8, from its code units: a surrogate\n   806\t   pair is one 4-byte sequence, never two 3-byte ones, and an unpaired\n   807\t   surrogate — which the classifier has already refused — would be the\n   808\t   3-byte replacement character. Pure arithmetic over code units, so\n   809\t   every host agrees without encoding anything.\"\n   810\t  [s]\n   811\t  (let [unit-length (fn [c]\n   812\t                      (cond (< c 0x80) 1\n   813\t                            (< c 0x800) 2\n   814\t                            :else 3))\n   815\t        n (count s)]\n   816\t    (loop [i 0, total 0]\n   817\t      (if (>= i n)\n   818\t        total\n   819\t        (let [c (code-unit-at s i)]\n   820\t          (if (and (<= 0xD800 c 0xDBFF)\n   821\t                   (< (inc i) n)\n   822\t                   (<= 0xDC00 (code-unit-at s (inc i)) 0xDFFF))\n   823\t            (recur (+ i 2) (+ total 4))\n   824\t            (recur (inc i) (+ total (unit-length c)))))))))\n   825\t\n   826\t\n   827\t(defn- framed\n   828\t  \"One self-delimiting encoded part: the class's tag byte, the 8-hex byte\n   829\t   length of the content, and the content. §5's tagged, length-delimited\n   830\t   framing with the settled rule that lengths count UTF-8 bytes — the\n   831\t   preimage is carried as text whose UTF-8 bytes are the hashed stream,\n   832\t   so a byte-count prefix keeps the framing's extents on that stream.\"\n   833\t  [class content]\n   834\t  (str (get slot-tag class) (to-hex (utf8-byte-length content) 8) content))\n   835\t\n   836\t\n   837\t(defn- int64-le-hex\n   838\t  \"The settled int64 byte rule: 8 bytes, two's complement, little-endian\n   839\t   (datom.md). Exact host integers go through bit ops; a :cljs number —\n   840\t   which the classifier only lets here as a safe integer — decomposes\n   841\t   exactly through floor and mod by 2^32, whose low bytes survive the\n   842\t   host's 32-bit bit ops.\"\n   843\t  [v]\n   844\t  #?(:cljs (let [lo (mod v 4294967296)\n   845\t                 hi (js/Math.floor (/ v 4294967296))\n   846\t                 byte-at (fn [x i]\n   847\t                           (to-hex (bit-and (unsigned-bit-shift-right x (* i 8))\n   848\t                                            0xff)\n   849\t                                   2))]\n   850\t             (apply str (map #(byte-at (if (< % 4) lo hi) (mod % 4)) (range 8))))\n   851\t     :default (let [n (long v)]\n   852\t                (apply str (map #(to-hex (bit-and (unsigned-bit-shift-right n (* % 8)) 0xff) 2)\n   853\t                                (range 8))))))\n   854\t\n   855\t\n   856\t(defn- double-le-hex\n   857\t  \"The settled :double byte rule: the IEEE-754 bits, little-endian, with\n   858\t   every NaN the one quiet encoding 7ff8000000000000 regardless of the\n   859\t   payload a host happens to hold. :clj reads the bits through\n   860\t   doubleToLongBits, :cljs through a DataView store with littleEndian\n   861\t   explicitly true, :cljd through a big-endian ByteData store read in\n   862\t   reverse — the endianness is stated, never the platform's default.\"\n   863\t  [v]\n   864\t  (if (not= v v)\n   865\t    \"000000000000f87f\"\n   866\t    #?(:clj (int64-le-hex (Double/doubleToLongBits (double v)))\n   867\t       :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\n   868\t               (.setFloat64 view 0 v true)\n   869\t               (apply str (map #(to-hex (.getUint8 view %) 2) (range 8))))\n   870\t       :cljd (let [bd (ByteData. 8)]\n   871\t               (.setFloat64 bd 0 v)\n   872\t               (apply str (map #(to-hex (.getUint8 bd %) 2) (range 7 -1 -1)))))))\n   873\t\n   874\t\n   875\t(defn- ident-content\n   876\t  \"§5 keywords and symbols encode namespace and name separately, each\n   877\t   through the NFC seam — the value table declares :nfc-utf-8 for both\n   878\t   parts; an absent namespace has nil's own framing, never an empty\n   879\t   string's.\"\n   880\t  [x]\n   881\t  (str (if-let [ns (namespace x)]\n   882\t         (framed :string (normalize-nfc ns))\n   883\t         (framed :nil \"\"))\n   884\t       (framed :string (normalize-nfc (name x)))))\n   885\t\n   886\t\n   887\t(defn encode-value\n   888\t  \"Encode one canonical-domain value under its value-table class: the\n   889\t   full tagged, length-delimited part, under the settled D3 byte rules —\n   890\t   int64 little-endian two's complement for integers and integral\n   891\t   doubles alike (the recorded 1 ≡ 1.0 collision), IEEE-754 bits with one\n   892\t   quiet-NaN encoding for the other doubles, UTF-8 byte lengths, NFC\n   893\t   strings and ident parts. Maps and sets sort by their encoded parts,\n   894\t   the §5 order rule; vectors and lists are the distinct classes the D0\n   895\t   ruling split. An out-of-domain value is a diagnostic.\"\n   896\t  [v]\n   897\t  (let [class (canonical-class v)]\n   898\t    (case class\n   899\t      :nil (framed :nil \"\")\n   900\t      :bool (framed :bool (if v \"01\" \"00\"))\n   901\t      :int64 (framed :int64 (int64-le-hex v))\n   902\t      :double (framed :double (double-le-hex v))\n   903\t      :string (framed :string (normalize-nfc v))\n   904\t      :bytes (framed :bytes (apply str (map #(to-hex (bit-and % 0xff) 2) v)))\n   905\t      :keyword (framed :keyword (ident-content v))\n   906\t      :symbol (framed :symbol (ident-content v))\n   907\t      :map (let [entries (sort (map (fn [[k x]]\n   908\t                                      [(encode-value k) (encode-value x)])\n   909\t                                    v))]\n   910\t             (when (some (fn [[a b]] (= (first a) (first b)))\n","exit_code":0,"status":"completed"}}
