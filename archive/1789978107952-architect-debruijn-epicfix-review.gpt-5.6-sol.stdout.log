)))))))\n   344\t\n   345\t\n   346\t(deftest the-essays-example-resolves-its-binder\n   347\t  (is (= {:yin.debruijn/type :lambda,\n   348\t          :yin.debruijn/arity 1,\n   349\t          :yin.debruijn/body\n   350\t          {:yin.debruijn/type :application,\n   351\t           :yin.debruijn/operator {:yin.debruijn/type :variable,\n   352\t                                   :yin.debruijn/free '+},\n   353\t           :yin.debruijn/operands [{:yin.debruijn/type :variable,\n   354\t                                    :yin.debruijn/bound [0 0]}\n   355\t                                   {:yin.debruijn/type :literal,\n   356\t                                    :yin.debruijn/value 1}]}}\n   357\t         (:root (project worked-example))\n   358\t         (:root (project (lam '[n] (app (v '+) (v 'n) (lit 1))))))))\n   359\t\n   360\t\n   361\t(deftest nearest-binder-shadows-with-frame-depth-and-position\n   362\t  (is (= {:bound [0 0]} (d/resolve-name '[[x]] 'x)))\n   363\t  (is (= {:bound [1 0]} (d/resolve-name '[[] [x]] 'x)))\n   364\t  (is (= {:bound [1 0]} (d/resolve-name '[[y] [x]] 'x)))\n   365\t  (is (= {:bound [0 1]} (d/resolve-name '[[a b]] 'b)))\n   366\t  (is (= {:bound [0 2]} (d/resolve-name '[[a b c]] 'c)))\n   367\t  (testing \"an intermediate binder shifts only its own frame depth\"\n   368\t    (is (= [1 0]\n   369\t           (get-in (project (lam '[x] (lam '[p q r] (v 'x))))\n   370\t                   [:root :yin.debruijn/body :yin.debruijn/body :yin.debruijn/bound])))\n   371\t    (is (= [0 2]\n   372\t           (get-in (project (lam '[x] (lam '[p q r] (v 'r))))\n   373\t                   [:root :yin.debruijn/body :yin.debruijn/body :yin.debruijn/bound]))))\n   374\t  (testing \"shadowing picks the innermost binder\"\n   375\t    (is (= [1 0]\n   376\t           (get-in (project (lam '[x] (lam '[y] (v 'x))))\n   377\t                   [:root :yin.debruijn/body :yin.debruijn/body :yin.debruijn/bound]))\n   378\t        \"distinct names: the occurrence still reaches the outer binder\")\n   379\t    (is (= [0 0]\n   380\t           (get-in (project (lam '[x] (lam '[x] (v 'x))))\n   381\t                   [:root :yin.debruijn/body :yin.debruijn/body :yin.debruijn/bound]))\n   382\t        \"the inner binder shadows the outer\")\n   383\t    (is (= [0 0]\n   384\t           (get-in (project (lam '[x] (lam '[y] (lam '[x] (v 'x)))))\n   385\t                   [:root :yin.debruijn/body :yin.debruijn/body :yin.debruijn/body\n   386\t                    :yin.debruijn/bound])))))\n   387\t\n   388\t\n   389\t(deftest duplicate-parameters-are-rightmost-wins\n   390\t  (is (= {:yin.debruijn/type :lambda,\n   391\t          :yin.debruijn/arity 2,\n   392\t          :yin.debruijn/body {:yin.debruijn/type :variable,\n   393\t                              :yin.debruijn/bound [0 1]}}\n   394\t         (:root (project (lam '[x x] (v 'x))))))\n   395\t  (testing \"the position names the argument the VM binds\"\n   396\t    (let [params '[x x]\n   397\t          args [1 2]\n   398\t          bound (second (:bound (d/resolve-name [params] 'x)))]\n   399\t      (is (= (nth args bound) (get (engine/bind-params params args) 'x)))\n   400\t      (is (= 2 (get (engine/bind-params params args) 'x))))))\n   401\t\n   402\t\n   403\t(deftest free-names-are-preserved-exactly\n   404\t  (is (= {:yin.debruijn/type :variable, :yin.debruijn/free 'y}\n   405\t         (:yin.debruijn/body (:root (project (lam '[x] (v 'y)))))))\n   406\t  (is (= {:yin.debruijn/type :variable, :yin.debruijn/free 'foo/bar}\n   407\t         (:root (project (v 'foo/bar)))))\n   408\t  (is (= {:free 'z} (d/resolve-name [] 'z))))\n   409\t\n   410\t\n   411\t;; =============================================================================\n   412\t;; Input identity: order, metadata, tolerated attributes (§2)\n   413\t;; =============================================================================\n   414\t\n   415\t(deftest shuffled-datom-input-projects-the-same-graph\n   416\t  (let [direct (project every-type)\n   417\t        ds (datoms-of every-type)\n   418\t        rotated (vec (concat (drop 3 ds) (take 3 ds)))]\n   419\t    (is (= direct (d/project-datoms ds)))\n   420\t    (is (= direct (d/project-datoms (vec (reverse ds)))))\n   421\t    (is (= direct (d/project-datoms rotated)))))\n   422\t\n   423\t\n   424\t(deftest transaction-metadata-and-other-namespaces-never-enter-identity\n   425\t  (let [ds (datoms-of worked-example)\n   426\t        restamped (mapv (fn [x] [(nth x 0) (nth x 1) (nth x 2) 5 42]) ds)\n   427\t        decorated (into (vec ds)\n   428\t                        [[-16 :yin.code/pc 3 0 1]\n   429\t                         [-16 :db/ident :whatever 0 1]\n   430\t                         [-999 :yin.macro/event :x 0 1]])]\n   431\t    (is (= (d/project-datoms ds) (d/project-datoms restamped))\n   432\t        \"t and m — here an assert with other provenance — are not identity\")\n   433\t    (is (= (d/project-datoms ds) (d/project-datoms decorated))\n   434\t        \"non-:yin/* namespaces are ignored, walked or not\")))\n   435\t\n   436\t\n   437\t(deftest tolerated-emission-metadata-is-ignored\n   438\t  (let [ds (datoms-of worked-example)]\n   439\t    (is (= (d/project-datoms ds)\n   440\t           (d/project-datoms (conj (vec ds) [-16 :yin/macro-name 'm 0 1])))\n   441\t        \":yin/macro-name is tolerated emission metadata\")))\n   442\t\n   443\t\n   444\t(deftest the-tail-flag-changes-nothing\n   445\t  (let [plain (lam '[x] (app (v 'f) (v 'x) (lit 1)))\n   446\t        tailed (tail (lam '[x] (tail (app (v 'f) (tail (v 'x)) (lit 1)))))]\n   447\t    (is (= (project plain) (project tailed)))))\n   448\t\n   449\t\n   450\t(deftest an-explicit-macro-false-projects-like-an-absent-one\n   451\t  (let [ds (datoms-of (lam '[x] (v 'x)))]\n   452\t    (is (= (d/project-datoms ds)\n   453\t           (d/project-datoms (conj (vec ds) [-17 :yin/macro? false 0 1])))\n   454\t        \"only a truthy :yin/macro? projects :yin.debruijn/macro?\")))\n   455\t\n  1260\t(deftest the-reader-checks-records-against-the-grammar\n  1261\t  (let [free-ds (d/projected->datoms (project (lam '[x] (v 'y))))\n  1262\t        reader-rule (fn [ds] (:rule (throws-data #(d/datoms->projected ds))))]\n  1263\t    (testing \"a slot renamed within its type's tag class keeps its hash\"\n  1264\t      (let [swapped (restated free-ds :yin.debruijn/free :yin.debruijn/key identity)]\n  1265\t        (is (= (filter #(= :yin.debruijn/hash (nth % 1)) free-ds)\n  1266\t               (filter #(= :yin.debruijn/hash (nth % 1)) swapped))\n  1267\t            \"the stored addresses are untouched: only the grammar can tell\")\n  1268\t        (is (= {:rule :unknown-attribute,\n  1269\t                :attribute :yin.debruijn/key,\n  1270\t                :type :variable}\n  1271\t               (select-keys (throws-data #(d/datoms->projected swapped))\n  1272\t                            [:rule :attribute :type])))))\n  1273\t    (is (= :unknown-attribute\n  1274\t           (reader-rule (restated free-ds :yin.debruijn/free :yin.debruijn/value identity)))\n  1275\t        \":free to :value on a :variable\")\n  1276\t    (is (= :unknown-attribute\n  1277\t           (reader-rule (restated free-ds :yin.debruijn/arity :yin.debruijn/buffer identity)))\n  1278\t        \":arity to :buffer on a :lambda — both int64\")\n  1279\t    (is (= :missing-slot\n  1280\t           (reader-rule (vec (remove #(= :yin.debruijn/arity (nth % 1)) free-ds))))\n  1281\t        \"a required slot absent from its record\")\n  1282\t    (is (= :missing-slot\n  1283\t           (reader-rule (vec (remove #(= :yin.debruijn/free (nth % 1)) free-ds))))\n  1284\t        \"a :variable carries one of :bound and :free\")))\n  1285\t\n  1286\t\n  1287\t(deftest the-reader-requires-canonical-spellings\n  1288\t  (let [reader-rule (fn [ds] (:rule (throws-data #(d/datoms->projected ds))))\n  1289\t        respelled (fn [ast attr value]\n  1290\t                    (restated (d/projected->datoms (project ast)) attr attr (constantly value)))]\n  1291\t    ;; a JS number has one spelling per value, so 1.0 is 1 there\n  1292\t    (when #?(:cljs false :default true)\n  1293\t      (is (= :noncanonical-value\n  1294\t             (reader-rule (respelled (lit 1) :yin.debruijn/value 1.0)))\n  1295\t          \"a stored 1.0 under 1's address\")\n  1296\t      (is (= :noncanonical-value\n  1297\t             (reader-rule (respelled (lam '[x] (v 'x)) :yin.debruijn/arity 1.0)))\n  1298\t          \"an int64 slot spelled as a double\"))\n  1299\t    (is (= :noncanonical-value\n  1300\t           (reader-rule (respelled (lit \"é\") :yin.debruijn/value \"é\")))\n  1301\t        \"a decomposed string under the composed one's address\")\n  1302\t    (is (= :noncanonical-value\n  1303\t           (reader-rule (respelled (lit {:a [1 \"é\"]})\n  1304\t                                   :yin.debruijn/value\n  1305\t                                   {:a [1 \"é\"]})))\n  1306\t        \"spelling is checked inside collections\")\n  1307\t    (is (= :noncanonical-value\n  1308\t           (reader-rule (respelled (v (symbol \"é\"))\n  1309\t                                   :yin.debruijn/free\n  1310\t                                   (symbol \"é\"))))\n  1311\t        \"and in ident parts\")))\n  1312\t\n  1313\t\n  1314\t(deftest every-written-record-passes-the-reader\n  1315\t  (let [p (project (app (v 'f)\n  1316\t                        {:type :lambda, :macro? true, :params '[x], :body (v 'x)}\n  1317\t                        (lit false)\n  1318\t                        (lit nil)\n  1319\t                        (lit #{\"a\" 1 :k})\n  1320\t                        (lit (list 1.5 -0.0 (/ 0.0 0.0)))\n  1321\t                        (lit {\"é\" [1 2.5]})))]\n  1322\t    (is (= (:fingerprint p)\n  1323\t           (:fingerprint (d/datoms->projected (d/projected->datoms p))))\n  1324\t        \"the gate adds nothing the writer does not already guarantee: false\n  1325\t         literals, nil, a true :macro?, sets, doubles, NaN, and NFC keys\n  1326\t         round-trip\")))\n  1327\t\n  1328\t\n  1329\t(defn- doubling-chain\n  1330\t  \"`depth` applications, each of whose two operands is the previous\n  1331\t   level — ONE shared source entity per level, so the unfolded term has\n  1332\t   2^depth leaves while the emitted graph grows linearly.\"\n  1333\t  [depth]\n  1334\t  (reduce (fn [prev k]\n  1335\t            (assoc (app (v 'f) prev prev) :eid (- -1000 k)))\n  1336\t          (assoc (lit 0) :eid -999)\n  1337\t          (range depth)))\n  1338\t\n  1339\t\n  1340\t(defn- doubling-tree\n  1341\t  [depth]\n  1342\t  (reduce (fn [prev _] (app (v 'f) prev prev)) (lit 0) (range depth)))\n  1343\t\n  1344\t\n  1345\t(deftest shared-subgraphs-are-minted-once\n  1346\t  (testing \"a deep doubling chain mints once per source entity\"\n  1347\t    (let [depth 40\n  1348\t          ds (datoms-of (doubling-chain depth))\n  1349\t          entities (count (distinct (keep (fn [[e a]] (when (= :yin/type a) e)) ds)))\n  1350\t          counted (d/project-datoms-counted ds)]\n  1351\t      (is (= (inc (* 2 depth)) entities)\n  1352\t          \"one entity per level, one per level's `f`, and the leaf\")\n  1353\t      (is (= entities (:mints counted))\n  1354\t          \"one mint per [eid lexical-context] occurrence, never one per\n  1355\t           unfolded path — 2^40 paths here\")\n  1356\t      (is (= (+ depth 2) (count (:records counted)))\n  1357\t          \"the levels, the leaf, and one hash-consed free `f`\")\n  1358\t      ;; never compare :root here: it is a 2^40-leaf tree under structural\n  1359\t      ;; sharing, and = over two separately built copies walks every leaf\n  1360\t      (is (= (select-keys (d/project-datoms ds) [:fingerprint :records])\n  1361\t             (select-keys counted [:fingerprint :records]))\n  1362\t          \"the counted seam is output-neutral\")))\n  1363\t  (testing \"the graph is the tree-built term's Merkle graph\"\n  1364\t    (let [graph (project (doubling-chain 6))\n  1365\t          tree (project (doubling-tree 6))]\n  1366\t      (is (= (:fingerprint tree) (:fingerprint graph)))\n  1367\t      (is (= (:records tree) (:records graph))))))\n  1368\t\n  1369\t\n  1370\t(deftest known-attributes-on-the-wrong-type-diagnose\n  1371\t  ;; the emitter mints the root first, at -17\n  1372\t  (is (= {:rule :unknown-attribute, :entity -17, :path [], :attribute :yin/body}\n  1373\t         (defect (conj (datoms-of (lit 1)) [-17 :yin/body 999 0 1])))\n  1374\t      \"a dangling :yin/body on a :literal is diagnosed, not ignored\")\n  1375\t  (is (= {:rule :unknown-attribute, :entity -17, :path [], :attribute :yin/macro?}\n  1376\t         (defect (conj (datoms-of (app (v 'f) (lit 1))) [-17 :yin/macro? true 0 1])))\n  1377\t      \":macro? belongs to the :lambda row only\")\n  1378\t  (is (= {:rule :unknown-attribute, :entity -17, :path [], :attribute :yin/params}\n  1379\t         (defect (conj (datoms-of (v 'x)) [-17 :yin/params '[x] 0 1])))))\n  1380\t\n  1381\t\n  1382\t(deftest renamed-programs-store-equal-datoms\n  1383\t  (is (= (d/projected->datoms (project worked-example))\n  1384\t         (d/projected->datoms (project (lam '[n] (app (v '+) (v 'n) (lit 1))))))\n  1385\t      \"alpha-equivalent programs write the identical projected d5 tuples,\n  1386\t       not only one fingerprint\"))\n  1387\t\n  1388\t\n  1389\t(deftest internal-rules-are-internal-errors\n  1390\t  (is (= :internal-error\n  1391\t         (:status (d/exception-diagnostic\n  1392\t                    (ex-info \"writer defect\" {:rule :missing-record, :hash \"h\"}))))\n  1393\t      \"a rule only the projection's own code can produce is its defect\")\n  1394\t  (is (= {:rule :missing-record, :hash \"h\"}\n  1395\t         (get-in (d/exception-diagnostic\n  1396\t                   (ex-info \"writer defect\" {:rule :missing-record, :