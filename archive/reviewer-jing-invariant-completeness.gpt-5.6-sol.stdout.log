{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/jing/file_test.cljc'","aggregated_output":"     1\t(ns dao.jing.file-test\n     2\t  \"Tests for dao.jing.file persistent content files.\"\n     3\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n     4\t            [clojure.test :refer [deftest is testing]]\n     5\t            [dao.jing :as jing]\n     6\t            [dao.jing.file :as jing-file]\n     7\t            [dao.stream :as ds]\n     8\t            [dao.stream.log]\n     9\t            [dao.stream.ringbuffer]))\n    10\t\n    11\t\n    12\t(defn- temp-path\n    13\t  [prefix]\n    14\t  (str \"target/test-jing-content-\" prefix \"-\" (random-uuid) \".log\"))\n    15\t\n    16\t\n    17\t(defn- cleanup-file\n    18\t  [path]\n    19\t  #?(:clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n    20\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))\n    21\t     :cljd (try (let [f (dart-io/File path)]\n    22\t                  (when (.existsSync f) (.deleteSync f)))\n    23\t                (catch #?(:cljd Object\n    24\t                          :default Exception)\n    25\t                       _\n    26\t                  nil))))\n    27\t\n    28\t\n    29\t(defn- count-records\n    30\t  [log]\n    31\t  (loop [cursor {:position 0}\n    32\t         n 0]\n    33\t    (let [res (ds/next log cursor)]\n    34\t      (if (and (map? res) (contains? res :ok))\n    35\t        (recur (:cursor res) (inc n))\n    36\t        n))))\n    37\t\n    38\t\n    39\t(deftest codec-test\n    40\t  (testing\n    41\t    \"encode-record/decode-record round trip [address payload] including nil\"\n    42\t    (let [cases [[(jing/segment-key {:a 1}) {:a 1}] [(jing/segment-key nil) nil]\n    43\t                 [(jing/segment-key \"plain\") \"plain\"]\n    44\t                 [(jing/segment-key [1 2 3]) [1 2 3]]]]\n    45\t      (doseq [[address payload] cases]\n    46\t        (is (= [address payload]\n    47\t               (jing-file/decode-record (jing-file/encode-record address\n    48\t                                                                 payload))))))))\n    49\t\n    50\t\n    51\t(deftest handle-shape-test\n    52\t  (testing\n    53\t    \"content file handle exposes log, state, lock and functions, no :stream\"\n    54\t    (let [path (temp-path \"shape\")\n    55\t          handle (jing-file/create-content-file path)]\n    56\t      (try (is (not (contains? handle :stream)))\n    57\t           (is (= path (:path handle)))\n    58\t           (is (some? (:log handle)))\n    59\t           (is (= {:closed? false, :content {}} @(:state handle)))\n    60\t           (is (some? (:write-lock handle)))\n    61\t           (is (fn? (:put-content-fn handle)))\n    62\t           (is (fn? (:get-content-fn handle)))\n    63\t           (is (fn? (:close-fn handle)))\n    64\t           (finally (jing/close! handle) (cleanup-file path))))))\n    65\t\n    66\t\n    67\t(deftest materialize-idempotence-test\n    68\t  (testing \"put/get idempotence and file length unchanged on :present\"\n    69\t    (let [path (temp-path \"idempotence\")\n    70\t          address (jing/segment-key {:v 1})\n    71\t          payload {:v 1}\n    72\t          handle (jing-file/create-content-file path)]\n    73\t      (try (is (= address (jing/materialize! handle payload)))\n    74\t           (is (= payload (jing/get handle address ::missing)))\n    75\t           (is (= :present ((:put-content-fn handle) address payload)))\n    76\t           (is (= payload (jing/get handle address ::missing)))\n    77\t           (jing/close! handle)\n    78\t           (let [log (ds/open! {:dao.stream/type :append-log, :path path})]\n    79\t             (try (is (= 1 (count-records log))) (finally (ds/close! log))))\n    80\t           (let [h2 (jing-file/create-content-file path)]\n    81\t             (try (is (= payload (jing/get h2 address ::missing)))\n    82\t                  (finally (jing/close! h2))))\n    83\t           (finally (cleanup-file path))))))\n    84\t\n    85\t\n    86\t(deftest close-reopen-durability-test\n    87\t  (testing \"payloads survive close and reopen\"\n    88\t    (let [path (temp-path \"durability\")\n    89\t          a1 (jing/segment-key \"alpha\")\n    90\t          a2 (jing/segment-key {:n 2})\n    91\t          handle (jing-file/create-content-file path)]\n    92\t      (jing/materialize! handle \"alpha\")\n    93\t      (jing/materialize! handle {:n 2})\n    94\t      (jing/close! handle)\n    95\t      (let [h2 (jing-file/create-content-file path)]\n    96\t        (try (is (= \"alpha\" (jing/get h2 a1 ::missing)))\n    97\t             (is (= {:n 2} (jing/get h2 a2 ::missing)))\n    98\t             (finally (jing/close! h2) (cleanup-file path)))))))\n    99\t\n   100\t\n   101\t(deftest nil-and-absence-test\n   102\t  (testing \"nil payload is stored distinctly from an absent address\"\n   103\t    (let [path (temp-path \"nil\")\n   104\t          address (jing/segment-key nil)\n   105\t          handle (jing-file/create-content-file path)]\n   106\t      (try (is (= ::missing (jing/get handle address ::missing)))\n   107\t           (jing/materialize! handle nil)\n   108\t           (is (nil? (jing/get handle address ::missing)))\n   109\t           (is (contains? (:content @(:state handle)) address))\n   110\t           (finally (jing/close! handle) (cleanup-file path))))))\n   111\t\n   112\t\n   113\t(deftest observer-convergence-test\n   114\t  (testing\n   115\t    \"two ringbuffers carrying the same payload converge on one content address\"\n   116\t    (let [path (temp-path \"observe\")\n   117\t          payload {:observed true}\n   118\t          handle (jing-file/create-content-file path)\n   119\t          rb1 (ds/open! {:dao.stream/type :ringbuffer, :capacity 8})\n   120\t          rb2 (ds/open! {:dao.stream/type :ringbuffer, :capacity 8})]\n   121\t      (try (ds/append! rb1 payload)\n   122\t           (ds/append! rb2 payload)\n   123\t           (let [observer (jing/observer-state [rb1 rb2])\n   124\t                 r1 (jing/observe-step! handle observer)\n   125\t                 r2 (jing/observe-step! handle (:state r1))]\n   126\t             (is (= :ok (:signal r1)))\n   127\t             (is (= :ok (:signal r2)))\n   128\t             (is (= (jing/segment-key payload) (:address r1)))\n   129\t             (is (= (jing/segment-key payload) (:address r2)))\n   130\t             (is (= 1 (count (:content @(:state handle))))))\n   131\t           (is (= 1 (count-records (:log handle))))\n   132\t           (finally (jing/close! handle)\n   133\t                    (ds/close! rb1)\n   134\t                    (ds/close! rb2)\n   135\t                    (cleanup-file path))))))\n   136\t\n   137\t\n   138\t(deftest raw-duplicate-recovery-test\n   139\t  (testing \"equal duplicate raw records recover on replay\"\n   140\t    (let [path (temp-path \"rawdup\")\n   141\t          address (jing/segment-key {:k 1})\n   142\t          payload {:k 1}\n   143\t          log (ds/open! {:dao.stream/type :append-log, :path path})]\n   144\t      (ds/append! log (jing-file/encode-record address payload))\n   145\t      (ds/append! log (jing-file/encode-record address payload))\n   146\t      (ds/close! log)\n   147\t      (let [log2 (ds/open! {:dao.stream/type :append-log, :path path})]\n   148\t        (try (is (= 2 (count-records log2))) (finally (ds/close! log2))))\n   149\t      (let [handle (jing-file/create-content-file path)]\n   150\t        (try (is (= payload (jing/get handle address ::missing)))\n   151\t             (is (= :present ((:put-content-fn handle) address payload)))\n   152\t             (finally (jing/close! handle) (cleanup-file path)))))))\n   153\t\n   154\t\n   155\t(deftest corrupt-record-categories-test\n   156\t  (testing \"each corrupt raw record category throws on construction\"\n   157\t    (let [good-address (jing/segment-key \"ok\")\n   158\t          categories\n   159\t          [{:name \"malformed EDN\", :record (jing-file/->bytes \"[[[not edn\")}\n   160\t           {:name \"wrong shape\",\n   161\t            :record (jing-file/->bytes (pr-str [good-address \"ok\" :extra]))}\n   162\t           {:name \"invalid address\",\n   163\t            :record (jing-file/->bytes (pr-str [:root/not-content \"ok\"]))}\n   164\t           {:name \"hash mismatch\",\n   165\t            :record (jing-file/->bytes (pr-str [good-address \"different\"]))}]]\n   166\t      (doseq [{:keys [name record]} categories]\n   167\t        (let [path (temp-path \"corrupt\")\n   168\t              log (ds/open! {:dao.stream/type :append-log, :path path})]\n   169\t          (ds/append! log record)\n   170\t          (ds/close! log)\n   171\t          (try (is (thrown? #?(:clj Exception\n   172\t                               :cljs :default\n   173\t                               :cljd Object)\n   174\t                     (jing-file/create-content-file path))\n   175\t                   name)\n   176\t               (finally (cleanup-file path))))))))\n   177\t\n   178\t\n   179\t(deftest collision-test\n   180\t  (testing \"unequal payload for existing address throws and preserves existing\"\n   181\t    (let [path (temp-path \"collision\")\n   182\t          address (jing/segment-key \"original\")\n   183\t          handle (jing-file/create-content-file path)]\n   184\t      (try (is (= :inserted ((:put-content-fn handle) address \"original\")))\n   185\t           (is (= :present ((:put-content-fn handle) address \"original\")))\n   186\t           (swap! (:state handle) assoc-in [:content address] \"corrupted\")\n   187\t           (is (thrown? #?(:clj Exception\n   188\t                           :cljs :default\n   189\t                           :cljd Object)\n   190\t                 ((:put-content-fn handle) address \"original\")))\n   191\t           (is (=