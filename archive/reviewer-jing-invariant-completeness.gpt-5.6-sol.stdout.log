{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '318,560p' test/dao/jing_test.cljc | nl -ba -v318\"","aggregated_output":"   318\t;; ---------------------------------------------------------------------------\n   319\t;; Observer: observer-state / observe-step!\n   320\t;; ---------------------------------------------------------------------------\n   321\t\n   322\t(deftest observer-state-is-plain-data\n   323\t  (testing\n   324\t    \"observer-state returns immutable data with one operational member\n   325\t            per pool stream, a fresh cursor, an explicit status, and the next\n   326\t            fair scheduling index\"\n   327\t    (let [a (open-stream)\n   328\t          b (open-stream)\n   329\t          st (jing/observer-state [a b])]\n   330\t      (is (= [a b] (mapv :stream (:members st))))\n   331\t      (is (every? #(= {:position 0} (:cursor %)) (:members st)))\n   332\t      (is (every? #(= :pending (:status %)) (:members st)))\n   333\t      (is (= 0 (:next st))))))\n   334\t\n   335\t\n   336\t(deftest observer-empty-pool-is-blocked\n   337\t  (let [h (mem-handle)\n   338\t        state (jing/observer-state [])]\n   339\t    (is (= {:state state, :signal :blocked} (jing/observe-step! h state)))))\n   340\t\n   341\t\n   342\t(deftest observer-all-blocked\n   343\t  (let [h (mem-handle)\n   344\t        a (open-stream)\n   345\t        b (open-stream)\n   346\t        state (jing/observer-state [a b])\n   347\t        r (jing/observe-step! h state)]\n   348\t    (is (= :blocked (:signal r)))\n   349\t    (is (every? #(= :blocked (:status %)) (:members (:state r))))\n   350\t    (is (every? #(= {:position 0} (:cursor %)) (:members (:state r))))))\n   351\t\n   352\t\n   353\t(deftest observer-automatic-hashing-and-retrieval\n   354\t  (testing\n   355\t    \"a payload arriving through a pool stream is content-addressed\n   356\t            without the caller minting any key\"\n   357\t    (let [h (mem-handle)\n   358\t          payload {:hello \"world\"}\n   359\t          s (open-stream payload)\n   360\t          r (jing/observe-step! h (jing/observer-state [s]))]\n   361\t      (is (= :ok (:signal r)))\n   362\t      (is (= (jing/segment-key payload) (:address r)))\n   363\t      (is (= payload (jing/get h (:address r) ::missing))))))\n   364\t\n   365\t\n   366\t(deftest observer-equal-payloads-from-two-streams-converge\n   367\t  (testing\n   368\t    \"identical content arriving through different pool streams lands\n   369\t            on exactly one KV entry, with no provenance stamp\"\n   370\t    (let [h (mem-handle)\n   371\t          store (:store h)\n   372\t          payload {:nested {:v [1 2 3]}}\n   373\t          address (jing/segment-key payload)\n   374\t          a (open-stream payload payload)\n   375\t          b (open-stream payload)\n   376\t          state (jing/observer-state [a b])\n   377\t          r1 (jing/observe-step! h state)\n   378\t          r2 (jing/observe-step! h (:state r1))\n   379\t          r3 (jing/observe-step! h (:state r2))]\n   380\t      (doseq [r [r1 r2 r3]]\n   381\t        (is (= :ok (:signal r)))\n   382\t        (is (= address (:address r))\n   383\t            \"both streams converge on the same content address\"))\n   384\t      (is\n   385\t        (= {address payload} @store)\n   386\t        \"exactly one KV entry exists, holding exactly the payload: no\n   387\t          duplicate entries, no source identity, no provenance stamp\"))))\n   388\t\n   389\t\n   390\t(deftest observer-blocked-before-ready-does-not-prevent-later-members\n   391\t  (let [h (mem-handle)\n   392\t        a (open-stream)\n   393\t        b (open-stream {:payload 1})\n   394\t        r (jing/observe-step! h (jing/observer-state [a b]))]\n   395\t    (is (= :ok (:signal r)))\n   396\t    (is (= {:payload 1} (jing/get h (:address r) ::missing)))\n   397\t    (is (= :blocked (get-in (:state r) [:members 0 :status]))\n   398\t        \"the blocked member is checked and marked, but does not block the scan\")\n   399\t    (is (= :ok (get-in (:state r) [:members 1 :status])))))\n   400\t\n   401\t\n   402\t(deftest observer-ended-before-ready-does-not-starve-active-members\n   403\t  (let [h (mem-handle)\n   404\t        a (open-stream)\n   405\t        _ (ds/close! a)\n   406\t        b (open-stream {:payload 1})\n   407\t        r (jing/observe-step! h (jing/observer-state [a b]))]\n   408\t    (is (= :ok (:signal r)))\n   409\t    (is (= {:payload 1} (jing/get h (:address r) ::missing)))\n   410\t    (is (= :end (get-in (:state r) [:members 0 :status]))\n   411\t        \"the closed member is explicitly :end and skipped\")\n   412\t    (is (= :ok (get-in (:state r) [:members 1 :status])))))\n   413\t\n   414\t\n   415\t(deftest observer-all-ended\n   416\t  (let [h (mem-handle)\n   417\t        a (open-stream)\n   418\t        b (open-stream)]\n   419\t    (ds/close! a)\n   420\t    (ds/close! b)\n   421\t    (let [r (jing/observe-step! h (jing/observer-state [a b]))]\n   422\t      (is (= :end (:signal r)))\n   423\t      (is (every? #(= :end (:status %)) (:members (:state r)))))))\n   424\t\n   425\t\n   426\t(deftest observer-drains-then-reports-end\n   427\t  (testing \"a closed stream still yields its buffered payloads, then :end\"\n   428\t    (let [h (mem-handle)\n   429\t          s (open-stream {:last 1})\n   430\t          _ (ds/close! s)\n   431\t          state (jing/observer-state [s])\n   432\t          r1 (jing/observe-step! h state)\n   433\t          r2 (jing/observe-step! h (:state r1))]\n   434\t      (is (= :ok (:signal r1)))\n   435\t      (is (= {:last 1} (jing/get h (:address r1) ::missing)))\n   436\t      (is (= :end (:signal r2))))))\n   437\t\n   438\t\n   439\t(deftest observer-fair-round-robin-and-independent-cursors\n   440\t  (testing\n   441\t    \"round-robin alternates members and a continuously ready member\n   442\t            cannot starve another\"\n   443\t    (let [h (mem-handle)\n   444\t          a (open-stream {:who :a, :n 1} {:who :a, :n 2})\n   445\t          b (open-stream {:who :b, :n 1})\n   446\t          state (jing/observer-state [a b])\n   447\t          r1 (jing/observe-step! h state)\n   448\t          r2 (jing/observe-step! h (:state r1))\n   449\t          r3 (jing/observe-step! h (:state r2))]\n   450\t      (is (= {:who :a, :n 1} (jing/get h (:address r1) ::missing)))\n   451\t      (is (= {:who :b, :n 1} (jing/get h (:address r2) ::missing))\n   452\t          \"A is continuously ready, yet B gets its turn before A's second item\")\n   453\t      (is (= {:who :a, :n 2} (jing/get h (:address r3) ::missing)))\n   454\t      (is (= {:position 2} (get-in (:state r3) [:members 0 :cursor])))\n   455\t      (is (= {:position 1} (get-in (:state r3) [:members 1 :cursor]))))))\n   456\t\n   457\t\n   458\t(deftest observer-independent-cursors-interleave\n   459\t  (testing \"two equal-length ready streams drain strictly A B A B\"\n   460\t    (let [h (mem-handle)\n   461\t          a (open-stream :a1 :a2)\n   462\t          b (open-stream :b1 :b2)\n   463\t          state (jing/observer-state [a b])\n   464\t          [addrs final-state]\n   465\t          (loop [st state\n   466\t                 acc []\n   467\t                 i 0]\n   468\t            (if (= i 4)\n   469\t              [acc st]\n   470\t              (let [r (jing/observe-step! h st)]\n   471\t                (recur (:state r) (conj acc (:address r)) (inc i)))))]\n   472\t      (is (= [(jing/segment-key :a1) (jing/segment-key :b1)\n   473\t              (jing/segment-key :a2) (jing/segment-key :b2)]\n   474\t             addrs)\n   475\t          \"round-robin alternates A B A B, cursors advancing independently\")\n   476\t      (is (= :blocked (:signal (jing/observe-step! h final-state)))\n   477\t          \"the pool is drained after four payloads\"))))\n   478\t\n   479\t\n   480\t(deftest observer-gap-is-reported-and-never-auto-resynced\n   481\t  (testing\n   482\t    \"a cursor behind the retention boundary reports :daostream/gap\n   483\t            immediately, leaves its cursor unchanged, is never resynced, and\n   484\t            does not starve the rest of the pool\"\n   485\t    (let [h (mem-handle)\n   486\t          a (ds/open! {:dao.stream/type :ringbuffer,\n   487\t                       :capacity 2,\n   488\t                       :eviction-policy :evict-oldest})\n   489\t          _ (ds/append! a {:evicted 1})\n   490\t          _ (ds/append! a {:evicted 2})\n   491\t          _ (ds/append! a {:live 3})\n   492\t          b (open-stream {:payload :ready})\n   493\t          state (jing/observer-state [a b])\n   494\t          r1 (jing/observe-step! h state)]\n   495\t      (is (= :daostream/gap (:signal r1)))\n   496\t      (is (= 0 (:member r1)))\n   497\t      (is (= {:position 0} (get-in (:state r1) [:members 0 :cursor]))\n   498\t          \"the gap leaves the cursor unchanged\")\n   499\t      (is (= :daostream/gap (get-in (:state r1) [:members 0 :status])))\n   500\t      (let [r2 (jing/observe-step! h (:state r1))]\n   501\t        (is (= :ok (:signal r2)))\n   502\t        (is (= {:payload :ready} (jing/get h (:address r2) ::missing)))\n   503\t        (let [r3 (jing/observe-step! h (:state r2))]\n   504\t          (is (= :daostream/gap (:signal r3)))\n   505\t          (is (= {:position 0} (get-in (:state r3) [:members 0 :cursor]))\n   506\t              \"the gap persists: the cursor is never auto-resynchronized\"))))))\n   507\t\n   508\t\n   509\t(deftest observer-rejects-malformed-stream-maps\n   510\t  (testing\n   511\t    \"a map from ds/next is a successful read only when it explicitly\n   512\t            carries both :ok and :cursor; malformed maps throw instead of\n   513\t            content-addressing nil or installing a nil cursor\"\n   514\t    (let [h (mem-handle)]\n   515\t      (doseq [bad [{} {:ok nil} {:ok :payload} {:cursor {:position 1}}]]\n   516\t        (let [s (->MalformedResultStream bad)]\n   517\t          (is (thrown? #?(:clj Exception\n   518\t                          :cljs js/Error\n   519\t                          :cljd Object)\n   520\t                (jing/observe-step! h (jing/observer-state [s])))\n   521\t              (str \"must reject \" (pr-str bad)))))))\n   522\t  (testing\n   523\t    \"a well-formed {:ok ... :cursor ...} read through the same double\n   524\t            still materializes\"\n   525\t    (let [h (mem-handle)\n   526\t          s (->MalformedResultStream {:ok :payload, :cursor {:position 1}})\n   527\t          r (jing/observe-step! h (jing/observer-state [s]))]\n   528\t      (is (= :ok (:signal r)))\n   529\t      (is (= (jing/segment-key :payload) (:address r)))\n   530\t      (is (= :payload (jing/get h (:address r) ::missing)))\n   531\t      (is (= {:position 1} (get-in (:state r) [:members 0 :cursor]))))))\n   532\t\n   533\t\n   534\t(deftest observer-cursor-advances-only-after-successful-materialization\n   535\t  (testing\n   536\t    \"a failed materialization propagates and leaves the caller-owned\n   537\t            state untouched; the same payload is reprocessed from the same\n   538\t            cursor once the backend succeeds\"\n   539\t    (let [good (mem-handle)\n   540\t          failing {:put-content-fn (fn [address payload]\n   541\t                                     (if (= payload :poison)\n   542\t                                       (throw (ex-info \"injected failure\"\n   543\t                                                       {:address address}))\n   544\t                                       :inserted)),\n   545\t                   :get-content-fn (fn [_ _] nil)}\n   546\t          s (open-stream {:a 1} :poison {:a 2})\n   547\t          state (jing/observer-state [s])\n   548\t          r1 (jing/observe-step! good state)]\n   549\t      (is (= :ok (:signal r1)))\n   550\t      (is (= {:position 1} (get-in (:state r1) [:members 0 :cursor])))\n   551\t      (is (thrown? #?(:clj Exception\n   552\t                      :cljs js/Error\n   553\t                      :cljd Object)\n   554\t            (jing/observe-step! failing (:state r1))))\n   555\t      (is (= {:position 1} (get-in (:state r1) [:members 0 :cursor]))\n   556\t          \"the caller's state must not advance past the failed payload\")\n   557\t      (let [r2 (jing/observe-step! good (:state r1))]\n   558\t        (is (= :ok (:signal r2)))\n   559\t        (is (= (jing/segment-key :poison) (:address r2)))\n   560\t        (is (= {:position 2} (get-in (:state r2) [:members 0 :cursor])))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/jing/mem_test.cljc'","aggregated_output":"     1\t(ns dao.jing.mem-test\n     2\t  \"Contract tests for dao.jing.mem/create-content-mem: the ephemeral\n     3\t   content-addressed in-memory DaoJing content store\n     4\t   (docs/design/dao.jing.md, Materialization rule and Reads).\n     5\t\n     6\t   The handle is plain data carrying explicit private state plus\n     7\t   :put-content-fn, :get-content-fn, and :close-fn, and is consumed by\n     8\t   dao.jing/materialize!, dao.jing/get, and dao.jing/close!. It embeds no\n     9\t   intake stream and no source identity: addresses are derived solely from\n    10\t   payloads, equal payloads from a pool of intake streams converge on\n    11\t   exactly one entry, and an unequal payload at an existing address is an\n    12\t   integrity failure, never an overwrite.\"\n    13\t  (:require [clojure.test :refer [deftest is testing]]\n    14\t            [dao.jing :as jing]\n    15\t            [dao.jing.mem :as mem]\n    16\t            [dao.stream :as ds]\n    17\t            [dao.stream.ringbuffer]))\n    18\t\n    19\t\n    20\t(defn throws?\n    21\t  \"True when (f) throws on every supported host.\"\n    22\t  [f]\n    23\t  (try (f)\n    24\t       false\n    25\t       (catch #?(:clj Exception\n    26\t                 :cljs :default\n    27\t                 :cljd Object)\n    28\t              _\n    29\t         true)))\n    30\t\n    31\t\n    32\t(defn open-stream\n    33\t  \"Open a ringbuffer transport pre-loaded with vals.\"\n    34\t  [& vals]\n    35\t  (let [s (ds/open! {:dao.stream/type :ringbuffer, :capacity 8})]\n    36\t    (doseq [v vals] (ds/append! s v))\n    37\t    s))\n    38\t\n    39\t\n    40\t;; ---------------------------------------------------------------------------\n    41\t;; Handle shape\n    42\t;; ---------------------------------------------------------------------------\n    43\t\n    44\t(deftest create-content-mem-returns-a-stream-free-content-handle\n    45\t  (testing\n    46\t    \"the handle is plain data with explicit private state and the\n    47\t            three backend effects\"\n    48\t    (let [h (mem/create-content-mem)]\n    49\t      (is (map? h))\n    50\t      (is (fn? (:put-content-fn h)))\n    51\t      (is (fn? (:get-content-fn h)))\n    52\t      (is (fn? (:close-fn h)))\n    53\t      (is (= {:closed? false, :content {}} @(:state h)))))\n    54\t  (testing \"the handle embeds no intake stream and stores no source identity\"\n    55\t    (let [h (mem/create-content-mem)]\n    56\t      (is (not (contains? h :stream))\n    57\t          \"a content store carries no intake stream\")\n    58\t      (is (empty? (:content @(:state h)))))))\n    59\t\n    60\t\n    61\t;; ---------------------------------------------------------------------------\n    62\t;; Opaque-payload contract\n    63\t;; ---------------------------------------------------------------------------\n    64\t\n    65\t(deftest materialize-mints-the-address-automatically\n    66\t  (testing\n    67\t    \"jing/materialize! derives the address from the payload alone and\n    68\t            the value round-trips unchanged\"\n    69\t    (let [h (mem/create-content-mem)\n    70\t          payload {:a 1, :b [1 2 3]}\n    71\t          address (jing/materialize! h payload)]\n    72\t      (is (= (jing/segment-key payload) address))\n    73\t      (is (= \"segment\" (namespace address)))\n    74\t      (is (= payload (jing/get h address ::missing)))\n    75\t      (is\n    76\t        (= {address payload} (:content @(:state h)))\n    77\t        \"exactly the payload is stored: no provenance stamp, no source identity\"))))\n    78\t\n    79\t\n    80\t(deftest opaque-payloads-round-trip-including-nil\n    81\t  (testing\n    82\t    \"any payload value is stored and retrieved unchanged; nil is a\n    83\t            legal opaque payload\"\n    84\t    (doseq [p [nil 42 \"hello\" :kw [1 2 3] {:a 1} #{:x :y} [:a [:b]]]]\n    85\t      (let [h (mem/create-content-mem)\n    86\t            address (jing/materialize! h p)]\n    87\t        (is (= (jing/segment-key p) address) (str \"address of \" (pr-str p)))\n    88\t        (is (= p (jing/get h address ::missing))\n    89\t            (str \"round trip of \" (pr-str p)))))))\n    90\t\n    91\t\n    92\t(deftest insert-is-idempotent\n    93\t  (testing\n    94\t    \"the first put reports :inserted; an equal payload reports\n    95\t            :present and is never overwritten\"\n    96\t    (let [h (mem/create-content-mem)\n    97\t          payload {:x 42}\n    98\t          address (jing/segment-key payload)]\n    99\t      (is (= :inserted ((:put-content-fn h) address payload)))\n   100\t      (is (= :present ((:put-content-fn h) address payload)))\n   101\t      (is (= payload (jing/get h address ::missing)))\n   102\t      (is (= {address payload} (:content @(:state h))))))\n   103\t  (testing \"materialize! is idempotent end to end\"\n   104\t    (let [h (mem/create-content-mem)\n   105\t          payload {:x 42}]\n   106\t      (is (= (jing/materialize! h payload) (jing/materialize! h payload)))\n   107\t      (is (= 1 (count (:content @(:state h))))))))\n   108\t\n   109\t\n   110\t(deftest put-rejects-invalid-content-addresses\n   111\t  (testing\n   112\t    \"only :segment/sha256-... content addresses are insertable;\n   113\t            arbitrary keys, roots, and malformed hashes throw before any\n   114\t            write\"\n   115\t    (let [h (mem/create-content-mem)]\n   116\t      (doseq [bad [:root/pointer :plain :segment/not-a-hash :segment/sha256-xyz\n   117\t                   42 \"abc\" nil [1 2] {:k :v}]]\n   118\t        (is (throws? #((:put-content-fn h) bad {:x 1}))\n   119\t            (str \"must reject \" (pr-str bad))))\n   120\t      (is (= {} (:content @(:state h)))))))\n   121\t\n   122\t\n   123\t(deftest put-rejects-address-payload-hash-mismatch\n   124\t  (testing\n   125\t    \"a well-formed address whose hash does not match the payload is\n   126\t            rejected before any write\"\n   127\t    (let [h (mem/create-content-mem)\n   128\t          address (jing/segment-key {:a 1})]\n   129\t      (is (throws? #((:put-content-fn h) address {:a 2})))\n   130\t      (is (= {} (:content @(:state h))))))\n   131\t  (testing \"an address that does hash to the payload is accepted\"\n   132\t    (let [h (mem/create-content-mem)]\n   133\t      (is (= :inserted\n   134\t             ((:put-content-fn h) (jing/segment-key {:a 1}) {:a 1}))))))\n   135\t\n   136\t\n   137\t(deftest collision-preserves-the-existing-value\n   138\t  (testing\n   139\t    \"an unequal payload already seated at an address is never\n   140\t            overwritten and the mismatch is reported loudly\"\n   141\t    (let [h (mem/create-content-mem)\n   142\t          payload {:b 1}\n   143\t          address (jing/segment-key payload)]\n   144\t      (swap! (:state h) assoc-in [:content address] {:a 1})\n   145\t      (is (throws? #((:put-content-fn h) address payload)))\n   146\t      (is (= {:a 1} (get-in @(:state h) [:content address]))\n   147\t          \"the existing value is untouched\")))\n   148\t  (testing\n   149\t    \"the collision is visible through materialize! as an integrity\n   150\t            failure\"\n   151\t    (let [h (mem/create-content-mem)\n   152\t          payload {:b 1}\n   153\t          address (jing/segment-key payload)]\n   154\t      (swap! (:state h) assoc-in [:content address] {:a 1})\n   155\t      (is (throws? #(jing/materialize! h payload)))\n   156\t      (is (= {:a 1} (get-in @(:state h) [:content address]))\n   157\t          \"materialize! never overwrites\"))))\n   158\t\n   159\t\n   160\t(deftest close-is-idempotent-and-throws-after\n   161\t  (testing \"close! and :close-fn are idempotent and return nil\"\n   162\t    (let [h (mem/create-content-mem)]\n   163\t      (is (nil? (jing/close! h)))\n   164\t      (is (nil? (jing/close! h)))\n   165\t      (is (nil? ((:close-fn h))))\n   166\t      (is (true? (:closed? @(:state h))))))\n   167\t  (testing\n   168\t    \"get/put through every entry point throw after close and never\n   169\t            mutate content\"\n   170\t    (let [h (mem/create-content-mem)\n   171\t          payload {:a 1}\n   172\t          address (jing/materialize! h payload)\n   173\t          content-before (:content @(:state h))]\n   174\t      (jing/close! h)\n   175\t      (is (throws? #(jing/materialize! h payload)))\n   176\t      (is (throws? #(jing/get h address ::missing)))\n   177\t      (is (throws? #((:put-content-fn h) address payload)))\n   178\t      (is (throws? #((:get-content-fn h) address ::missing)))\n   179\t      (is (= content-before (:content @(:state h)))\n   180\t          \"close neither clears nor rewrites stored content\")\n   181\t      (is (true? (:closed? @(:state h)))))))\n   182\t\n   183\t\n   184\t(deftest get-distinguishes-absence-from-stored-nil\n   185\t  (testing\n   186\t    \"the caller-supplied not-found is returned only for absent\n   187\t            addresses; stored nil is returned as nil, never conflated with\n   188\t            absence\"\n   189\t    (let [h (mem/create-content-mem)\n   190\t          nil-address (jing/materialize! h nil)\n   191\t          absent-address (jing/segment-key {:never 1})]\n   192\t      (is (nil? (jing/get h nil-address ::missing))\n   193\t          \"stored nil round-trips as nil\")\n   194\t      (is (= ::missing (jing/get h absent-address ::missing))\n   195\t          \"absence returns the caller-supplied not-found\")\n   196\t      (is (nil? ((:get-content-fn h) nil-address ::missing)))\n   197\t      (is (= ::missing ((:get-content-fn h) absent-address ::missing))))))\n   198\t\n   199\t\n   200\t;; ---------------------------------------------------------------------------\n   201\t;; Observer pool integration\n   202\t;; ---------------------------------------------------------------------------\n   203\t\n   204\t(deftest observer-pool-equal-payloads-converge-to-one-entry\n   205\t  (testing\n   206\t    \"equal payloads arriving through two intake streams land on\n   207\t            exactly one stored entry carrying no source identity\"\n   208\t    (let [h (mem/create-content-mem)\n   209\t          payload {:nested {:v [1 2 3]}}\n   210\t          address (jing/segment-key payload)\n   211\t          a (open-stream payload)\n   212\t          b (open-stream payload)\n   213\t          state (jing/observer-state [a b])\n   214\t          r1 (jing/observe-step! h state)\n   215\t          r2 (jing/observe-step! h (:state r1))]\n   216\t      (is (= :ok (:signal r1)))\n   217\t      (is (= :ok (:signal r2)))\n   218\t      (is (= address (:address r1)))\n   219\t      (is (= address (:address r2))\n   220\t          \"both intake streams converge on the same content address\")\n   221\t      (is\n   222\t        (= {address payload} (:content @(:state h)))\n   223\t        \"exactly one entry: no duplicates, no provenance, no source identity\"))))\n   224\t\n   225\t\n   226\t;; ---------------------------------------------------------------------------\n   227\t;; Concurrency (JVM only)\n   228\t;; ---------------------------------------------------------------------------\n   229\t\n   230\t(deftest concurrent-inserts-report-exactly-one-inserted\n   231\t  #?(:clj\n   232\t     (testing\n   233\t       \"under JVM thread contention exactly one put wins with\n   234\t               :inserted, every other thread observes :present, and the\n   235\t               store holds exactly one entry\"\n   236\t       (let [h (mem/create-content-mem)\n   237\t             payload {:contended :payload}\n   238\t             address (jing/segment-key payload)\n   239\t             n 16\n   240\t             results (java.util.concurrent.ConcurrentLinkedQueue.)\n   241\t             barrier (java.util.concurrent.CyclicBarrier. n)]\n   242\t         (let [threads (mapv (fn [_]\n   243\t                               (Thread. (fn []\n   244\t                                          (.await barrier)\n   245\t                                          (.add results\n   246\t                                                ((:put-content-fn h)\n   247\t                                                 address\n   248\t                                                 payload)))))\n   249\t                             (range n))]\n   250\t           (doseq [t threads] (.start t))\n   251\t           (doseq [t threads] (.join t)))\n   252\t         (let [rs (into [] results)]\n   253\t           (is (= 1 (count (filter #(= :inserted %) rs))))\n   254\t           (is (= (dec n) (count (filter #(= :present %) rs))))\n   255\t           (is (= 1 (count (:content @(:state h)))))\n   256\t           (is (= {address payload} (:content @(:state h)))))))\n   257\t     :cljs (is true)\n   258\t     :cljd (is true)))\n","exit_code":0,"status":"completed"}}
