name]\n    87\t  (when (vm/reserved-name? name)\n    88\t    (vm/refuse-reserved! :variable name))\n    89\t  (if-let [pair (find env name)]\n    90\t    (val pair)\n    91\t    (if-let [pair (find store name)]\n    92\t      (val pair)\n    93\t      (if-let [pair (find primitives name)]\n    94\t        (vm/primitive-function (val pair))\n    95\t        (if-let [resolved (when (namespace name)\n    96\t                            (module/resolve-module\n    97\t                              registry\n    98\t                              (symbol (str (namespace name)\n    99\t                                           \".\"\n   100\t                                           (clojure.core/name name)))))]\n   101\t          resolved\n   102\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n   103\t                {:symbol name}))))))\n   104\t\n   105\t\n   106\t(defn check-store-key!\n   107\t  \"Refuse a program store access whose key is a reserved name (Rule R):\n   108\t   the definition operator is never a store key.\"\n   109\t  [key]\n   110\t  (when (vm/reserved-name? key)\n   111\t    (vm/refuse-reserved! :store-key key)))\n   112\t\n   113\t\n   114\t(defn store-put\n   115\t  \"The one program store write: every definition transition, the\n   116\t   `:vm/store-put` effect, and the four direct store instructions write\n   117\t   through here, and a reserved key is refused. Every other store write\n   118\t   `yin.vm.store-write-audit-test` detects is state construction on its\n   119\t   allowlist; that namespace states what it detects and the residual it\n   120\t   leaves to review.\"\n   121\t  [store key val]\n   122\t  (check-store-key! key)\n   123\t  (assoc store key val))\n   124\t\n   125\t\n   126\t;; =============================================================================\n   127\t;; Module stores (yin.vm.linker.md section 7.3, r6 and r7)\n   128\t;; =============================================================================\n   129\t;;\n   130\t;; A linked module's closures carry `:yin.k/store-of m`, the manifest\n   245\t\n   246\t;; =============================================================================\n   247\t;; Private engine resources and sealed references (yin.vm.linker.md section\n   248\t;; 7.3, r8 to r11)\n   249\t;; =============================================================================\n   250\t;;\n   251\t;; Stream handles, cursor cells, the FFI pair, and the link pair live in the\n   252\t;; private `:resources` table of VM state. The engine's own machinery reads\n   253\t;; and writes only that table; no store instruction and no `resolve-var`\n   254\t;; step consults it. A program holds only references, and every reference\n   255\t;; the engine issues carries a seal over its kind and id under the task's\n   256\t;; capability secret, which the composition minted and which lives in VM\n   257\t;; state alone. Every effect that resolves a program-supplied reference\n   258\t;; verifies the seal first: a literal with a wrong or missing seal fails\n   259\t;; closed with `:forged-resource-reference`.\n   260\t\n   261\t(defn- seal-of\n   262\t  \"The seal of a `kind` reference to resource `id` under `secret`.\"\n   263\t  [secret kind id]\n   264\t  (jing/content-hash [:yin.k/seal secret kind id] {:algorithm :sha256}))\n   265\t\n   266\t\n   267\t(defn- cursor-cell?\n   268\t  \"True when a resource is a cursor cell, `{:stream-id id :cursor c}`.\"\n   269\t  [resource]\n   270\t  (and (map? resource) (contains? resource :stream-id)))\n   271\t\n   272\t\n   273\t(defn issue-ref\n   274\t  \"A reference of `kind` (`:stream-ref` or `:cursor-ref`) to resource\n   275\t   `id`, sealed under the task's capability secret. A task composed\n   276\t   without a secret cannot issue one: it fails closed rather than issue a\n   277\t   reference anyone could forge.\"\n   278\t  [state kind id]\n   279\t  (let [secret (:capability-secret state)]\n   280\t    (when (nil? secret)\n   281\t      (fail (str \"This task has no capability secret, so it cannot issue\"\n   282\t                 \" a resource reference\")\n   283\t            {:reason :no-capability-secret, :kind kind, :id id}))\n   284\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\n   285\t\n   286\t\n   287\t(defn authentic-ref?\n   288\t  \"True when `ref` is a `kind` reference this task issued: its seal\n   289\t   verifies under the task's secret, and it names a live resource of that\n   290\t   kind.\"\n   291\t  [state kind ref]\n   292\t  (let [secret (:capability-secret state)\n   293\t        id (when (map? ref) (:id ref))\n   294\t        resource (get (:resources state) id)]\n   295\t    (boolean (and (some? secret)\n   296\t                  (= kind (:type ref))\n   297\t                  (some? resource)\n   298\t                  (= (:seal ref) (seal-of secret kind id))\n   299\t                  (= (= :cursor-ref kind) (cursor-cell? resource))))))\n   300\t\n   301\t\n   302\t(defn check-ref!\n   303\t  \"The resource id a program-supplied `kind` reference names, once its\n   304\t   seal verifies (r10). Anything else fails closed with\n   305\t   `:forged-resource-reference`, naming the effect and the id it named.\"\n   306\t  [state effect-kind kind ref]\n   307\t  (if (authentic-ref? state kind ref)\n   308\t    (:id ref)\n   309\t    (fail \"Forged resource reference\"\n   310\t          {:reason :forged-resource-reference,\n   311\t           :effect effect-kind,\n   312\t           :kind kind,\n   313\t           :id (when (map? ref) (:id ref))})))\n   314\t\n   315\t\n   316\t(declare gensym)\n   317\t\n   318\t\n   319\t(defn attach-resource\n   320\t  \"Install the host stream `handle` a composition hands a task under a\n   555\t\n   556\t;; =============================================================================\n   557\t;; Lift and lower: the portable encoding a linked slice crosses in\n   558\t;; (yin.vm.linker.md section 7.3, acts 1 and 4; UCF section 7.5.1)\n   559\t;; =============================================================================\n   560\t\n   561\t(defn- non-portable!\n   562\t  [kind data]\n   563\t  (fail \"Value is not portable\"\n   564\t        (merge data {:yin.k/status :yin.k/non-portable, :yin.k/kind kind})))\n   565\t\n   566\t\n   567\t(defn- scalar?\n   568\t  [x]\n   569\t  (or (nil? x) (boolean? x) (number? x) (string? x) (keyword? x)\n   570\t      (symbol? x)))\n   571\t\n   572\t\n   573\t(defn- encode-primitive\n   574\t  \"A host function as UCF 7.5.2's primitive marker: its one name in\n   575\t   `vm`'s primitives, with that name's profile address.\"\n   576\t  [vm f]\n   577\t  (let [n (vm/name-of (:primitives vm)\n   578\t                      (or (:primitive-canonical-names vm) {})\n   579\t                      f)\n   580\t        profile (when (symbol? n) (vm/profile-of (:primitives vm) n))]\n   581\t    (cond\n   582\t      (nil? n) (non-portable! :unnamed-function {})\n   583\t      (not (symbol? n)) (non-portable! :ambiguous-primitive {})\n   584\t      (= :host (:yin.k/class profile))\n   585\t      (non-portable! :host-state-primitive {:yin.k/name n})\n   586\t      :else {:yin.k/tag :yin.k/primitive,\n   587\t             :yin.k/name n,\n   588\t             :yin.k/profile (:yin.k/profile profile)})))\n   589\t\n   590\t\n   591\t(defn- stream-marker\n   592\t  \"UCF 7.5.1's stream marker for the stream resource `id` of `vm`: the\n   593\t   handle's descriptor and logical identity, never the handle. A handle\n   594\t   with no descriptor surface cannot be attached elsewhere and refuses as\n   595\t   `:in-memory-handle`.\"\n   596\t  [vm id]\n   597\t  (let [handle (get (:resources vm) id)\n   598\t        d (when (stream/descriptor? handle) (stream/descriptor handle))]\n   599\t    (if (= :dao.stream/ok (outcome d))\n   600\t      {:yin.k/tag :yin.k/stream,\n   601\t       :dao.stream/identity (:dao.stream/identity d),\n   602\t       :dao.stream/descriptor (:dao.stream/descriptor d)}\n   603\t      (non-portable! :in-memory-handle {:yin.k/hint id}))))\n   604\t\n   605\t\n   606\t(defn- cell-for!\n   607\t  \"The logical cursor cell (UCF 7.5.3) the cursor resource `id` of `vm`\n   608\t   lifts to, minted once per lift: two references to one cell share it.\"\n   609\t  [vm found id]\n   610\t  (or (get-in @found [:cell-of id])\n   611\t      (let [cid (keyword \"yin.k\" (str \"c-\" (count (:cells @found))))\n   612\t            cell (get (:resources vm) id)\n   613\t            lifted {:yin.k/stream (stream-marker vm (:stream-id cell)),\n   614\t                    :yin.k/position (:cursor cell)}]\n   615\t        (swap! found #(-> %\n   616\t                          (assoc-in [:cell-of id] cid)\n   617\t                          (assoc-in [:cells cid] lifted)))\n   618\t        cid)))\n   619\t\n   620\t\n   621\t(defn- encoder\n   622\t  \"UCF 7.5.1's `encode` over values of `vm`, recording into `found` every\n   623\t   closure origin segment, module store, and cursor cell the encoding\n   624\t   reaches. A closure lifts through the kernel and names the module store\n   625\t   its body resolves against: its own `:store-of`, or `own` when it has\n   626\t   none -- a closure the child's own body made. Every literal map is\n   627\t   wrapped, so a program's data can never forge a marker. A stream or\n   628\t   cursor reference is authenticated before it is encoded (r11): its seal\n   629\t   and resource kind must verify under the emitter's own secret, or it\n   630\t   refuses as `:forged-resource-reference`; only then is it encoded,\n   631\t   without its seal, as a stream marker or a cell reference. A\n   632\t   continuation, a host object, and an unnamed host function refuse as\n   633\t   UCF 7.5.4 kinds.\"\n   634\t  [vm own found]\n   635\t  (letfn [(encode\n   636\t            [x]\n   637\t            (cond\n   638\t              (scalar? x) x\n   639\t              (map? x)\n   640\t              (case (:type x)\n   641\t                :closure\n   642\t                (let [marker (module/lift-closure vm x encode)\n   643\t                      m (or (get marker store-of-key) own)]\n   644\t                  (swap! found (fn [acc]\n   645\t                                 (-> acc\n   646\t                                     (update :origins conj\n   647\t                                             (:yin.k/segment marker))\n   648\t                                     (update :stores conj m))))\n   649\t                  (assoc marker store-of-key m))\n   650\t                (:stream-ref :cursor-ref)\n   651\t                (cond\n   652\t                  (not (authentic-ref? vm (:type x) x))\n   653\t                  (non-portable! :forged-resource-reference\n   654\t                                 {:yin.k/hint (:type x)})\n   655\t                  (= :stream-ref (:type x)) (stream-marker vm (:id x))\n   656\t                  :else {:yin.k/tag :yin.k/cursor-ref,\n   657\t                         :yin.k/cell (cell-for! vm found (:id x))})\n   658\t                (:reified-continuation :parked-continuation)\n   659\t                (non-portable! :non-canonicalizable {:yin.k/hint (:type x)})\n   660\t                {:yin.k/tag :yin.k/literal,\n   661\t                 :yin.k/entries (into []\n   662\t                                      (mapcat (fn [[k v]]\n   663\t                                                [(encode k) (encode v)]))\n   664\t                                      x)})\n   665\t              (vector? x) (mapv encode x)\n   666\t              (set? x) (into #{} (map encode) x)\n   667\t              (seq? x) (apply list (map encode x))\n   668\t              (fn? x) (encode-primitive vm x)\n   669\t              :else (non-portable! :host-object\n   670\t                                   {:yin.k/hint\n   671\t                                    #?(:cljd (str (.-runtimeType x))\n   672\t                                       :default (str (type x)))})))]\n   673\t    encode))\n   674\t\n   675\t\n   676\t(defn- decoder\n   677\t  \"UCF 7.5.1's `decode` into `vm`'s coordinates: every map is a marker, a\n   678\t   closure lowers through the kernel, a primitive is the receiver's own\n   679\t   function under an equal profile or `:yin.k/unsatisfied`, and a stream\n   680\t   or cursor marker is a fresh reference sealed under the receiver's\n   820\t                           (if-let [s (get-in child [:module-stores m])]\n   821\t                             (assoc acc m (encode-store encode s))\n   822\t                             (non-portable! :missing-module-store\n   823\t                                            {store-of-key m})))\n   824\t                         stores\n   825\t                         pending)))))]\n   826\t    {:slice slice,\n   827\t     :stores stores,\n   828\t     :cells (:cells @found),\n   829\t     :origins (:origins @found)}))\n   830\t\n   831\t\n   832\t(defn receive-module\n   833\t  \"Acts 3 and 4 of `linked` for one receiving task (yin.vm.linker.md\n   834\t   section 7.3): attach every origin image of `entry` the kernel does not\n   835\t   yet hold, non-destructively; lower the resources the slice and the\n   836\t   snapshots it instantiates reference into the task's private\n   837\t   `:resources` (r9); lower the slice against this task's own\n   838\t   coordinates into the entry's `:bindings`, every reference re-sealed\n   839\t   under this task's secret (r10); and instantiate each store snapshot\n   840\t   into `:module-stores` unless the task already holds that module's\n   841\t   store -- first link wins, a live instance is never overwritten.\n   842\t   Nothing is written into the task's own `:store`.\"\n   843\t  [state module-name entry]\n   844\t  (let [attached (reduce module/attach-module state\n   845\t                         (map val (sort-by key (:images entry))))\n   846\t        held (or (:module-stores attached) {})\n   847\t        fresh (into {} (remove #(contains? held (key %))) (:stores entry))\n   848\t        [attached streams cells]\n   849\t        (lower-resources attached\n   850\t                         (concat (vals (:slice entry)) (vals fresh))\n   851\t                         (:cells entry))\n   852\t        decode (decoder attached streams cells)\n   853\t        bindings (into {}\n   854\t                       (map (fn [[k v]] [k (decode v)]))\n   855\t                       (:slice entry))\n   856\t        stores (into held\n   857\t                     (map (fn [[m snapshot]]\n   858\t                            [m (decode-store decode snapshot)]))\n   859\t                     fresh)]\n   860\t    (-> attached\n   861\t        (assoc :module-stores stores)\n   862\t        (update :modules module/assoc-module module-name\n   863\t                (assoc entry :bindings bindings)))))\n   864\t\n   865\t\n   866\t;; =============================================================================\n   867\t;; Link waits and the install child (yin.vm.linker.md sections 7.2 to 7.4)\n   868\t;; =============================================================================\n   869\t\n   870\t(def ^:private link-reasons\n   871\t  \"The wait reasons `require` adds: the two link states and the install.\"\n   872\t  #{:link-request :link-response :install})\n   873\t\n   874\t\n   875\t(defn- link-entry?\n  1750\t                               :halted? false))]\n  1751\t      {:state new-state, :value :yin/blocked, :blocked? true})\n  1752\t    {:state (:state result), :value (:value result), :blocked? false}))\n  1753\t\n  1754\t\n  1755\t(defn handle-effect\n  1756\t  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n  1757\t   park-entry-fns maps :stream/put and :stream/next to functions that build\n  1758\t   wait entries.\n  1759\t\n  1760\t   A parked entry is stored as the builder left it plus, for a writer, the\n  1761\t   `:datom` it retries: registers and resource ids only. Neither the live\n  1762\t   stream handle nor a restore closure is attached — `check-wait-set`\n  1763\t   resolves handles from `:resources` at every poll, and the scheduler that pops\n  1764\t   a woken entry dispatches restoration itself — so a blocked entry is pure\n  1765\t   data and survives serialization.\"\n  1766\t  [state effect {:keys [park-entry-fns], :as opts}]\n  1767\t  (let [park-entry (get park-entry-fns (:effect effect))\n  1768\t        result\n  1769\t        (case (:effect effect)\n  1770\t          :vm/store-put {:state (put-active state\n  1771\t                                            (store-context state)\n  1772\t                                            (:key effect)\n  1773\t                                            (:val effect)),\n  1774\t                         :value (:val effect),\n  1775\t                         :blocked? false}\n  1776\t          :stream/make\n  1777\t          (let [[id s'] (gensym state \"stream\")\n  1778\t                [stream-ref new-state] (handle-make s' effect id)]\n  1779\t            {:state new-state, :value stream-ref, :blocked? false})\n  1780\t          :stream/cursor\n  1781\t          (let [[id s'] (gensym state \"cursor\")\n  1782\t                [cursor-ref new-state] (handle-cursor s' effect id)]\n  1783\t            {:state new-state, :value cursor-ref, :blocked? false})\n  1784\t          :stream/put\n  1785\t          (let [result (handle-put state effect)]\n  1786\t            (if (:park result)\n  1787\t              (let [built-entry (when park-entry\n  1788\t                                  (park-entry state effect result))\n  1789\t                    built-entry (if (and built-entry (not (:datom built-entry)))\n  1790\t                                  (assoc built-entry :datom (:val effect))\n  1791\t                                  built-entry)]\n  1792\t                (handle-stream-block result built-entry))\n  1793\t              {:state (:state result),\n  1794\t               :value (:value result),\n  1795\t               :blocked? false}))\n  1796\t          :stream/next\n  1797\t          (let [result (handle-next state effect)]\n  1798\t            (if (:park result)\n  1799\t              (let [built-entry (when park-entry\n  1800\t                                  (park-entry state effect result))]\n  1801\t                (handle-stream-block result built-entry))\n  1802\t              {:state (:state result),\n  1803\t               :value (:value result),\n  1804\t               :blocked? false}))\n  1805\t          :stream/close\n  1806\t          (let [close-result (handle-close state effect)]\n  1807\t            {:state (:state close-result), :value nil, :blocked? false})\n  1808\t          (let [[id s'] (gensym state \"effect\")\n  1809\t                handler (module/get-effect-handler (:modules state)\n  1810\t                                                   (:effect effect))]\n  1811\t            (if handler\n  1812\t              (handler s' effect (assoc opts :id id))\n  1813\t              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n  1814\t    (update result\n  1815\t            :state\n  1816\t            (fn [result-state]\n  1817\t              (telemetry/emit-snapshot (assoc result-state\n  1818\t                                              :value (:value result))\n  1819\t                                       :effect\n  1820\t                                       {:effect-type (:effect effect)})))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/module.cljc | sed -n '1,310p'; nl -ba src/cljc/yin/vm/completion.cljc | sed -n '55,125p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '225,270p;515,540p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/module.cljc | sed -n '1,310p'; nl -ba src/cljc/yin/vm/completion.cljc | sed -n '55,125p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '225,270p;515,540p'\"","aggregated_output":"     1\t(ns yin.vm.module\n     2\t  \"Module system for Yin VM v2.\n     3\t\n     4\t   The v1 module system kept two `defonce` atoms and mutated them at load\n     5\t   time. A registry is a value here: an ordinary map carried in VM state and\n     6\t   supplied by the composition that wires the VM.\n     7\t\n     8\t     (-> (empty-registry)\n     9\t         (register-host-module 'my.lib {'foo (fn [x] x)} profiles)\n    10\t         (register-stream-module))\n    11\t\n    12\t   Nothing in this namespace runs at load time, and nothing registers itself.\n    13\t   A composition that wants Yin source to reach `(stream/...)` registers the\n    14\t   stream module explicitly and supplies `:make-stream` beside it.\"\n    15\t  (:require\n    16\t    [clojure.string :as str]\n    17\t    [dao.jing :as jing]\n    18\t    [dao.stream :as stream]\n    19\t    [yin.vm :as vm]))\n    20\t\n    21\t\n    22\t;; =============================================================================\n    23\t;; Registry values\n    24\t;; =============================================================================\n    25\t\n    26\t(defn empty-registry\n    27\t  \"An empty module registry value.\"\n    28\t  []\n    29\t  {:modules {}, :effect-handlers {}})\n    30\t\n    31\t\n    32\t(defn- symbol->path\n    33\t  \"Split a dotted symbol into a get-in path of symbols.\n    34\t   'yin.io.file-input-stream → ['yin 'io 'file-input-stream]\"\n    35\t  [sym]\n    36\t  (mapv symbol (str/split (str sym) #\"\\.\")))\n    37\t\n    38\t\n    39\t(defn- walk-path\n    40\t  \"Descend a registry's :modules map along path, a sequence of symbols.\n    41\t\n    42\t   Namespace segments step through plain maps until the path reaches a\n    43\t   module entry (a map carrying :manifest); the remaining segments read\n    44\t   that entry's task-local lowered `:bindings` when it holds them -- a\n    45\t   linked module (yin.vm.linker.md section 8.3) -- and its `:slice`\n    46\t   otherwise, which for a host module is the host values themselves, so\n    47\t   a binding name resolves to its export.\"\n    48\t  [node path]\n    49\t  (if (seq path)\n    50\t    (if (and (map? node) (contains? node :manifest))\n    51\t      (get-in node (into [(if (contains? node :bindings) :bindings :slice)]\n    52\t                         path))\n    53\t      (when-let [child (get node (first path))]\n    54\t        (walk-path child (rest path))))\n    55\t    node))\n    56\t\n    57\t\n    58\t(defn module-entry\n    59\t  \"The registry entry of module `module-name` in `modules` (a registry's\n    60\t   `:modules` map), or nil when the dotted path reaches no module entry.\"\n    61\t  [modules module-name]\n    62\t  (let [node (reduce (fn [node seg] (when (map? node) (get node seg)))\n    63\t                     modules\n    64\t                     (symbol->path module-name))]\n    65\t    (when (and (map? node) (contains? node :manifest)) node)))\n    66\t\n    67\t\n    68\t(defn assoc-module\n    69\t  \"Return registry with `entry` installed as module `module-name`.\"\n    70\t  [registry module-name entry]\n    71\t  (assoc-in (or registry (empty-registry))\n    72\t            (into [:modules] (symbol->path module-name))\n    73\t            entry))\n    74\t\n    75\t\n    76\t(defn link-module\n    77\t  \"The `linked` transition's registry update (yin.vm.linker.md sections\n    78\t   7.3 and 8.3): `registry` gains the module `manifest` names as the\n    79\t   portable encoding of acts 1 to 3 -- `{:manifest m :address a\n    80\t   :derivation d :slice {sym encoded} :stores {address snapshot} :cells\n    81\t   {cell-id cell} :images {identity image}}` -- never lowered values. `a`\n    82\t   is the manifest's own address; `lifted` is the act-1 lift, `{:slice\n    83\t   :stores :cells :images}`, the cells being the logical cursor cells its\n    84\t   references name (r9) and the images the verified origin images a\n    85\t   receiving task attaches.\n    86\t   Each receiving task lowers the entry into its own `:bindings`.\"\n    87\t  [registry manifest derivation lifted]\n    88\t  (assoc-module registry\n    89\t                (:yin.module/name manifest)\n    90\t                {:manifest manifest,\n    91\t                 :address (jing/segment-key manifest),\n    92\t                 :derivation derivation,\n    93\t                 :slice (:slice lifted),\n    94\t                 :stores (:stores lifted),\n    95\t                 :cells (:cells lifted),\n    96\t                 :images (:images lifted)}))\n    97\t\n    98\t\n    99\t(defn module-entries\n   100\t  \"Every `[name entry]` a registry value holds, the module name read back\n   101\t   from each entry's manifest.\"\n   102\t  [registry]\n   103\t  (letfn [(walk\n   104\t            [node]\n   105\t            (when (map? node)\n   106\t              (if (contains? node :manifest)\n   107\t                [[(:yin.module/name (:manifest node)) node]]\n   108\t                (mapcat walk (vals node)))))]\n   109\t    (vec (walk (:modules registry)))))\n   110\t\n   111\t\n   112\t(defn resolve-module\n   113\t  \"Get a value from a registry value by dotted symbol path.\n   114\t   (resolve-module r 'io)                    → the 'io registry entry\n   115\t   (resolve-module r 'io.file-output-stream) → the specific export\"\n   116\t  [registry sym]\n   117\t  (walk-path (:modules registry) (symbol->path sym)))\n   118\t\n   119\t\n   120\t(defn register-effect-handler\n   121\t  \"Return registry with handler-fn installed for effect keyword kw.\n   122\t   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\"\n   123\t  [registry kw handler-fn]\n   124\t  (assoc-in (or registry (empty-registry)) [:effect-handlers kw] handler-fn))\n   125\t\n   126\t\n   127\t(defn get-effect-handler\n   128\t  \"Get the handler function for an effect keyword.\"\n   129\t  [registry kw]\n   130\t  (get (:effect-handlers registry) kw))\n   131\t\n   132\t\n   133\t(defn list-modules\n   134\t  \"List the top-level module names in a registry value.\"\n   135\t  [registry]\n   136\t  (keys (:modules registry)))\n   137\t\n   138\t\n   139\t;; =============================================================================\n   140\t;; Host modules\n   141\t;; =============================================================================\n   142\t;;\n   143\t;; A host module is the trusted composition boundary (yin.vm.linker.md\n   144\t;; section 8.3): the host is where the code already is, so no code is\n   145\t;; fetched. Registration checks the declaration, not the code -- a host\n   146\t;; function is opaque, and its profile is the warranty the composition\n   147\t;; publishes with it and answers for as trusted, reviewed code.\n   148\t\n   149\t(def ^:private profile-keys\n   150\t  \"The five keys of a UCF 7.5.2 profile record, the shape\n   151\t   `yin.vm/primitive-profiles` publishes.\"\n   152\t  [:yin.k/profile :yin.k/class :yin.k/arities :yin.k/effects\n   153\t   :yin.k/host-state])\n   154\t\n   155\t\n   156\t(defn- profile-rule\n   157\t  \"The registration rule a binding's profile breaks, or nil when it is a\n   158\t   UCF 7.5.2 record of a class a host module may export: `:pure`, or\n   159\t   `:effectful` with a declared non-empty effect set, and no declared\n   160\t   host state.\"\n   161\t  [profile]\n   162\t  (cond\n   163\t    (not (and (map? profile)\n   164\t              (every? #(contains? profile %) profile-keys)))\n   165\t    :malformed-profile\n   166\t\n   167\t    (not= :none (:yin.k/host-state profile))\n   168\t    :host-state\n   169\t\n   170\t    :else\n   171\t    (case (:yin.k/class profile)\n   172\t      :pure nil\n   173\t      :effectful (if (seq (:yin.k/effects profile))\n   174\t                   nil\n   175\t                   :undeclared-effects)\n   176\t      :host-class)))\n   177\t\n   178\t\n   179\t(defn- check-binding!\n   180\t  \"Refuse, as a host assembly defect detected before any operation runs,\n   181\t   a binding whose profile breaks a registration rule.\"\n   182\t  [module-name sym profile]\n   183\t  (when-let [rule (if (nil? profile)\n   184\t                    :missing-profile\n   185\t                    (profile-rule profile))]\n   186\t    (throw (ex-info \"Host module registration refused\"\n   187\t                    {:rule rule, :module module-name, :name sym}))))\n   188\t\n   189\t\n   190\t(defn register-host-module\n   191\t  \"Return registry with host module `module-name` installed from `fns`\n   192\t   under `profiles`.\n   193\t\n   194\t   module-name is a dotted symbol; fns maps each export symbol to the host\n   195\t   value it publishes; profiles maps each export symbol to its UCF 7.5.2\n   196\t   profile record in the shape of `yin.vm/primitive-profiles`. Every\n   197\t   binding must carry a profile, and the profile's class must be `:pure`,\n   198\t   or `:effectful` with a declared, non-empty `:yin.k/effects` set, with\n   199\t   `:yin.k/host-state` `:none`. An `:effectful` export returns plain\n   200\t   effect data for the engine to interpret and performs no IO itself;\n   201\t   `stream/make` is exactly such a constructor.\n   202\t\n   203\t   The module is entered as an already-linked manifest with\n   204\t   `:yin.module/tree` absent, `:yin.module/derivations {}`, and its\n   205\t   exports listed under `:yin.module/primitives` by profile address; the\n   206\t   exports themselves are its `:slice`, and its `:address` and\n   207\t   `:derivation` are nil because no content was fetched or derived: the\n   208\t   host is the boundary.\"\n   209\t  [registry module-name fns profiles]\n   210\t  (doseq [sym (sort-by str (keys fns))]\n   211\t    (check-binding! module-name sym (get profiles sym)))\n   212\t  (assoc-in (or registry (empty-registry))\n   213\t            (into [:modules] (symbol->path module-name))\n   214\t            {:manifest {:yin.module/name module-name,\n   215\t                        :yin.module/derivations {},\n   216\t                        :yin.module/primitives\n   217\t                        (into {} (map (fn [[sym _f]]\n   218\t                                        [sym (:yin.k/profile\n   219\t                                               (get profiles sym))]))\n   220\t                              fns)},\n   221\t             :address nil,\n   222\t             :derivation nil,\n   223\t             :slice fns,\n   224\t             :stores {}}))\n   225\t\n   226\t\n   227\t;; =============================================================================\n   228\t;; Effect descriptors\n   229\t;; =============================================================================\n   230\t\n   231\t(defn effect?\n   232\t  \"Check if a value is an effect descriptor.\"\n   233\t  [x]\n   234\t  (and (map? x) (contains? x :effect)))\n   235\t\n   236\t\n   237\t(defn make-effect\n   238\t  \"Create an effect descriptor.\"\n   239\t  [effect-type & {:as params}]\n   240\t  (assoc params :effect effect-type))\n   241\t\n   242\t\n   243\t;; =============================================================================\n   244\t;; The `stream` module\n   245\t;; =============================================================================\n   246\t;;\n   247\t;; These are pure data constructors. They touch no stream: Yin source calls\n   248\t;; them through the module system, they return effect maps, and the engine\n   249\t;; interprets those. `take!` is deliberately absent: destructive read is one\n   250\t;; reader's progress and every other reader's data loss, and a v2 `take!` would\n   251\t;; need the reader-position-in-the-medium the contract retired.\n   252\t\n   253\t(defn make\n   254\t  ([] (make nil))\n   255\t  ([cap] {:effect :stream/make, :capacity cap}))\n   256\t\n   257\t\n   258\t(defn put!\n   259\t  [s v]\n   260\t  {:effect :stream/put, :stream s, :val v})\n   261\t\n   262\t\n   263\t(defn cursor\n   264\t  [s]\n   265\t  {:effect :stream/cursor, :stream s})\n   266\t\n   267\t\n   268\t(defn next!\n   269\t  [c]\n   270\t  {:effect :stream/next, :cursor c})\n   271\t\n   272\t\n   273\t(defn close!\n   274\t  [s]\n   275\t  {:effect :stream/close, :stream s})\n   276\t\n   277\t\n   278\t(def stream-module\n   279\t  \"The v2 `stream` module definition. Registering it is a composition step.\"\n   280\t  {'make make, 'put! put!, 'cursor cursor, 'next! next!, 'close! close!})\n   281\t\n   282\t\n   283\t(def stream-profiles\n   284\t  \"UCF 7.5.2 profiles for the v2 `stream` module's bindings. Each binding\n   285\t   is an `:effectful` pure effect constructor: it returns plain effect\n   286\t   data declaring the one effect kind the engine interprets, and touches\n   287\t   no stream itself.\"\n   288\t  {'make (vm/primitive-profile 'make :effectful [0 1] #{:stream/make}\n   289\t                               :none)\n   290\t   'put! (vm/primitive-profile 'put! :effectful [2] #{:stream/put} :none)\n   291\t   'cursor (vm/primitive-profile 'cursor :effectful [1] #{:stream/cursor}\n   292\t                                 :none)\n   293\t   'next! (vm/primitive-profile 'next! :effectful [1] #{:stream/next} :none)\n   294\t   'close! (vm/primitive-profile 'close! :effectful [1] #{:stream/close}\n   295\t                                 :none)})\n   296\t\n   297\t\n   298\t(defn register-stream-module\n   299\t  \"Return registry with the v2 `stream` module registered.\n   300\t   A composition that calls this must also supply `:make-stream`, or\n   301\t   `(stream/make)` is unsupported and says so.\"\n   302\t  [registry]\n   303\t  (register-host-module registry 'stream stream-module stream-profiles))\n   304\t\n   305\t\n   306\t;; =============================================================================\n   307\t;; Built-in effect handlers\n   308\t;; =============================================================================\n   309\t\n   310\t;; =============================================================================\n    55\t;; =============================================================================\n    56\t;; §4 The context abstraction\n    57\t;; =============================================================================\n    58\t\n    59\t(declare context-of)\n    60\t\n    61\t\n    62\t(defn- address-of\n    63\t  \"The content address of runtime segment id `seg`, through the loaded\n    64\t   image's `:address`; nil when the image claims none (§3).\"\n    65\t  [vm seg]\n    66\t  (get-in vm [:code seg :address]))\n    67\t\n    68\t\n    69\t(defn- typed?\n    70\t  [v type]\n    71\t  (and (map? v) (= type (:type v))))\n    72\t\n    73\t\n    74\t(defn abstract-value\n    75\t  \"§4 `abstract`, flattened: the set of abstract values `v` contributes.\n    76\t   A scalar contributes none; a collection the union over its elements;\n    77\t   one VM value exactly one. `env` is `{:vm vm :registry r :canonical-names\n    78\t   c}`. A closure or continuation over an unaddressed segment contributes\n    79\t   `[:unaddressed seg]`, which the fold turns into a refusal — there is\n    80\t   nothing portable to name.\"\n    81\t  [env v]\n    82\t  (let [{:keys [vm registry canonical-names]} env\n    83\t        addr (fn [seg] (address-of vm seg))\n    84\t        frame (fn [f]\n    85\t                (if-let [a (addr (:segment f))]\n    86\t                  [:frame a (:pc f) (context-of env (:env f))]\n    87\t                  [:unaddressed (:segment f)]))]\n    88\t    (cond\n    89\t      (typed? v :closure)\n    90\t      (if-let [a (addr (:segment v))]\n    91\t        #{[:closure a (:entry v) (context-of env (:env v))]}\n    92\t        #{[:unaddressed (:segment v)]})\n    93\t\n    94\t      (typed? v :stream-ref) #{[:stream (:id v)]}\n    95\t      (typed? v :cursor-ref) #{[:cursor (:id v)]}\n    96\t      (typed? v :parked-continuation) #{[:parked (:id v)]}\n    97\t\n    98\t      (typed? v :reified-continuation)\n    99\t      (if-let [a (addr (:segment v))]\n   100\t        #{[:k a (:pc v) (context-of env (:env v))\n   101\t           (mapv frame (:k v))\n   102\t           (into #{} (mapcat #(abstract-value env %)) (:stack v))]}\n   103\t        #{[:unaddressed (:segment v)]})\n   104\t\n   105\t      (fn? v)\n   106\t      (let [sym (vm/name-of registry canonical-names v)]\n   107\t        (cond\n   108\t          (nil? sym) #{[:unnamed-function]}\n   109\t          (= ::vm/ambiguous sym) #{[:ambiguous-primitive]}\n   110\t          :else #{[:primitive sym]}))\n   111\t\n   112\t      (map? v) (into #{} (mapcat #(abstract-value env %))\n   113\t                     (concat (keys v) (vals v)))\n   114\t      (coll? v) (into #{} (mapcat #(abstract-value env %)) v)\n   115\t      :else #{})))\n   116\t\n   117\t\n   118\t(defn context-of\n   119\t  \"§4 `context(E)`: the set of abstract values of E's bindings. A plain\n   120\t   persistent set — structural equality is context identity. Well-founded:\n   121\t   env values were created before the env that holds them, so the\n   122\t   env-reachable graph is acyclic; cycles arise only through the store,\n   123\t   which is no part of any context.\"\n   124\t  [env E]\n   125\t  (into #{} (mapcat #(abstract-value env %)) (vals E)))\n   225\t                  (fnil conj [])\n   226\t                  {:k {:type :dao.stream.apply/request-sent,\n   227\t                       :parked-id parked-id,\n   228\t                       :next k,\n   229\t                       :env env,\n   230\t                       :op op},\n   231\t                   :env env,\n   232\t                   :reason :put,\n   233\t                   :stream-id vm/call-in-stream-key,\n   234\t                   :datom request})\n   235\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   236\t          (assoc :control nil\n   237\t                 :k nil\n   238\t                 :value :yin/blocked\n   239\t                 :blocked? true\n   240\t                 :halted? false))\n   241\t      (throw (ex-info \"FFI request could not be appended\"\n   242\t                      {:op op,\n   243\t                       :outcome (or (:dao.stream/outcome result)\n   244\t                                    (:dao.stream.apply/outcome result))})))))\n   245\t\n   246\t\n   247\t(defn- apply-function\n   248\t  \"Shared logic for applying a function (primitive or closure) to arguments.\n   249\t   env is the active environment at the call site.\"\n   250\t  [state fn-value evaluated-operands k env]\n   251\t  (cond (fn? fn-value)\n   252\t        (handle-primitive-result state\n   253\t                                 (apply fn-value evaluated-operands)\n   254\t                                 k\n   255\t                                 env)\n   256\t        (= :closure (:type fn-value))\n   257\t        (let [{:keys [params body], closure-env :env} fn-value\n   258\t              extended-env (merge closure-env\n   259\t                                  (engine/bind-params params evaluated-operands))]\n   260\t          (cesk-return state body extended-env k (:value state)))\n   261\t        (engine/reified-continuation? fn-value)\n   262\t        (cesk-return state\n   263\t                     nil\n   264\t                     (:env fn-value)\n   265\t                     (:k fn-value)\n   266\t                     (engine/continuation-argument fn-value\n   267\t                                                   evaluated-operands))\n   268\t        :else (throw (ex-info \"Cannot apply non-function\" {:fn fn-value}))))\n   269\t\n   270\t\n   515\t                        (cesk-return (engine/put-active\n   516\t                                       state (engine/env-store-of env)\n   517\t                                       key value)\n   518\t                                     nil env k value))\n   519\t        :vm/store-update (let [key (:key node)\n   520\t                               f (:fn node)\n   521\t                               args (:args node)\n   522\t                               store-of (engine/env-store-of env)\n   523\t                               _ (engine/check-store-key! key)\n   524\t                               current (get (engine/active-store state store-of)\n   525\t                                            key)\n   526\t                               new-value (apply f current args)]\n   527\t                           (cesk-return (engine/put-active state store-of key\n   528\t                                                           new-value)\n   529\t                                        nil env k new-value))\n   530\t        :vm/current-continuation\n   531\t        (cesk-return state\n   532\t                     nil\n   533\t                     env\n   534\t                     k\n   535\t                     {:type :reified-continuation, :k k, :env env})\n   536\t        :vm/park (-> (engine/park-continuation state {:k k, :env env})\n   537\t                     (assoc :control nil\n   538\t                            :k nil))\n   539\t        :vm/resume (cesk-return state\n   540\t                                (:val node)\n","exit_code":0,"status":"completed"}}
