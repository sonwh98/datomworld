    28	;; =============================================================================
    29	;; WebSocketStream record
    30	;; =============================================================================
    31	
    32	(defn- do-put!
    33	  "Apply val to link-state-atom's local side and send it over the wire if
    34	   connected. Not safe to run concurrently on the same link-state-atom -- callers
    35	   on platforms with real thread parallelism (:clj) must serialize calls (see
    36	   WebSocketStream's put!, which locks on link-state-atom for :clj; :cljs/:cljd
    37	   have no true concurrent threads calling into one stream, so no lock is
    38	   needed there)."
    39	  [link-state-atom send-fn-atom val]
    40	  (let [state @link-state-atom
    41	        [state' msg] (link/local-put state val)]
    42	    (if-let [send-fn @send-fn-atom]
    43	      (do (reset! link-state-atom (assoc state'
    44	                                         :local-sent-pos (:local-pos state')))
    45	          (send-fn (transit/encode msg)))
    46	      (reset! link-state-atom state'))
    47	    {:result :ok, :woke []}))
    48	
    49	
    50	(defrecord WebSocketStream
    51	  [link-state-atom send-fn-atom]
    52	
    53	  ds/IDaoStreamWriter
    54	
    55	  (append!
    56	    [_ val]
    57	    ;; :clj's send-fn synchronously blocks on the in-flight send
    58	    ;; (java.net.http's WebSocket throws if a second sendText is issued
    59	    ;; before the first completes), so concurrent put! calls on one
    60	    ;; stream must be serialized; :cljs/:cljd have no real concurrent
    61	    ;; threads sharing one stream.
    62	    #?(:clj (locking link-state-atom
    63	              (do-put! link-state-atom send-fn-atom val))
    64	       :cljs (do-put! link-state-atom send-fn-atom val)
    65	       :cljd (do-put! link-state-atom send-fn-atom val)))
    66	
    67	
    68	  ds/IDaoStreamReader
    69	
    70	  (next [_ c] (ds/next (:remote-stream @link-state-atom) c))
    71	
    72	
    73	  ds/IDaoStreamBound
    74	
    75	  (close!
    76	    [_]
    77	    (when-let [send-fn @send-fn-atom]
    78	      (send-fn (transit/encode (link/close-msg))))
    79	    (let [state (:remote-stream @link-state-atom)] (ds/close! state))
    80	    (swap! link-state-atom assoc :status :closed)
    81	    (when-let [close-fn (:socket-close-fn @link-state-atom)] (close-fn))
    82	    {:woke []})
    83	
    84	
    85	  (closed? [_] (= :closed (:status @link-state-atom))))
