     1	(ns dao.stream.ws
     2	  "WebSocket-backed stream using three orthogonal protocols.
     3	
     4	   Three entry points:
     5	     CLJ listen!    — start an http-kit WebSocket server, return WebSocketStream
     6	     CLJS listen!   — start a 'ws' Node.js WebSocket server, return WebSocketStream
     7	     CLJD listen!   — start a 'dart:io' WebSocket server, return WebSocketStream
     8	     CLJ/CLJS connect! — connect to a WebSocket server
     9	
    10	   Both sides get back a WebSocketStream satisfying:
    11	     IDaoStreamWriter — put! sends a datom to the remote peer
    12	     IDaoStreamReader — next reads non-destructively from remote-stream at cursor
    13	     IDaoStreamBound  — close! and closed? manage lifecycle
    14	
    15	   Utilities (non-protocol):
    16	     drain-one!      — destructive read from remote-stream (consumers needing take semantics)
    17	     await-connected — poll a stream's connection-status until :connected or timeout"
    18	  (:require #?(:cljd ["dart:async" :as async])
    19	            #?(:cljd ["dart:core" :as core])
    20	            #?(:cljd ["dart:io" :as io])
    21	            [dao.stream :as ds]
    22	            [dao.stream.link :as link]
    23	            [dao.stream.ringbuffer :as ringbuffer]
    24	            [dao.stream.transit :as transit]
    25	            #?(:clj [org.httpkit.server :as http-server])))
