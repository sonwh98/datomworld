    99	(defn- stream->vec-from
   100	  [stream from-pos]
   101	  (loop [c {:position from-pos}
   102	         acc []]
   103	    (let [r (ds/next stream c)]
   104	      (if (map? r) (recur (:cursor r) (conj acc (:ok r))) acc))))
   105	
   106	
   107	(defn- unsent-local-put-msg
   108	  [state]
   109	  (let [from-pos (or (:local-sent-pos state) 0)
   110	        to-pos (:local-pos state)
   111	        datoms (when (< from-pos to-pos)
   112	                 (stream->vec-from (:local-stream state) from-pos))]
   113	    (when (seq datoms) (link/put-msg datoms from-pos))))
   114	
   115	
   116	(defn on-open!
   117	  [ws-stream send-fn]
   118	  (swap! (:link-state-atom ws-stream)
   119	         (fn [state]
   120	           (let [remote-stream (:remote-stream state)]
   121	             (cond-> (assoc state :status :connecting)
   122	               (ds/closed? remote-stream)
   123	               (assoc :remote-stream
   124	                      (ringbuffer/make-ring-buffer-stream nil (:remote-pos state)))))))
   125	  (reset! (:send-fn-atom ws-stream) send-fn)
   126	  (let [state @(:link-state-atom ws-stream)]
   127	    (send-fn (transit/encode (link/connect-msg state)))
   128	    (when-let [msg (unsent-local-put-msg state)]
   129	      (send-fn (transit/encode msg))
   130	      (swap! (:link-state-atom ws-stream) assoc
   131	             :local-sent-pos
   132	             (:local-pos state)))))
   133	
   134	
   135	(defn on-message!
   136	  [ws-stream raw]
   137	  (let [msg (transit/decode raw)
   138	        state @(:link-state-atom ws-stream)
   139	        [state' resp] (link/dispatch state msg)]
   140	    (reset! (:link-state-atom ws-stream) state')
   141	    (when resp
   142	      (when-let [send-fn @(:send-fn-atom ws-stream)]
   143	        (send-fn (transit/encode resp))))))
   144	
   145	
   146	(defn on-close!
   147	  [ws-stream]
   148	  (let [remote (:remote-stream @(:link-state-atom ws-stream))]
   149	    (when-not (ds/closed? remote) (ds/close! remote)))
   150	  (reset! (:send-fn-atom ws-stream) nil)
   151	  (swap! (:link-state-atom ws-stream) assoc :status :closed))
