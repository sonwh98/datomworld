    88	;; =============================================================================
    89	;; Shared internal helpers
    90	;; =============================================================================
    91	
    92	(defn make-ws-stream
    93	  [local]
    94	  (->WebSocketStream (atom (assoc (link/make-link-state local)
    95	                                  :local-sent-pos 0))
    96	                     (atom nil)))
