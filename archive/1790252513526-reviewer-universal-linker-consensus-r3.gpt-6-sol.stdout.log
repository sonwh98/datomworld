3\t        (assoc vm\n   394\t               :pc (inc pc)\n   395\t               :registers (assoc registers (nth inst 1) val)))\n   396\t\n   397\t      :closure\n   398\t      (let [clos {:type :closure,\n   399\t                  :arity (nth inst 2),\n   400\t                  :body-pc (nth inst 3),\n   401\t                  :frames frames}]\n   402\t        (assoc vm\n   403\t               :pc (inc pc)\n   404\t               :registers (assoc registers (nth inst 1) clos)))\n   405\t\n   406\t      :move\n   407\t      (let [val (nth registers (nth inst 2))]\n   408\t        (assoc vm\n   260\t              1 (recur seg (inc pc) (nth inst 1) St E K vm image\n   261\t                       (and fuel (dec fuel)))\n   262\t              ;; :var — val ← resolve(E, S, prims, modules, name) (2, :load-var)\n   263\t              2 (recur seg (inc pc)\n   264\t                       (engine/resolve-var E (:store vm) (:primitives vm)\n   265\t                                           (:modules vm) (nth inst 1))\n   266\t                       St E K vm image (and fuel (dec fuel)))\n   267\t              ;; :closure — val ← clo(params, entry, seg, E) (4, :lambda)\n   268\t              4 (recur seg (inc pc)\n   269\t                       {:type :closure,\n   270\t                        :params (nth inst 1),\n   271\t                        :entry (nth inst 2),\n   272\t                        :segment seg,\n   273\t                        :env E}\n   274\t                       St E K vm image (and fuel (dec fuel)))\n   275\t              ;; :push — St ← St ⧺ [val] (22, :push)\n   276\t              22 (recur seg (inc pc) val (conj St val) E K vm image\n   277\t                        (and fuel (dec fuel)))\n   278\t              ;; :jump — pc ← target (8, :jump)\n   279\t              8 (recur seg (nth inst 1) val St E K vm image\n   280\t                       (and fuel (dec fuel)))\n","exit_code":0,"status":"completed"}}
