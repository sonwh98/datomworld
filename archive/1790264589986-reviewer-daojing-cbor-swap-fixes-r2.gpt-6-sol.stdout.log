1])])]\n   302\t               [\"text payload, not bytes\" (cbor/encode [d \"ok\"])]\n   303\t               [\"a map, not an array\" (cbor/encode {:digest d, :payload p})]\n   304\t               [\"digest of the wrong length\"\n   305\t                (cbor-frame (host-bytes (take 16 (bytes->ints d))) p)]\n   306\t               [\"digest of another payload\"\n   307\t                (cbor-frame (digest-of (bytes-of \"different\")) p)]\n   308\t               [\"non-canonical payload bytes\"\n   309\t                (cbor-frame (digest-of noncanonical) noncanonical)]\n   310\t               [\"truncated payload bytes\"\n   311\t                (cbor-frame (digest-of truncated) truncated)]\n   312\t               [\"payload with trailing data\"\n   313\t                (cbor-frame (digest-of trailing) trailing)]\n   314\t               [\"non-canonical frame encoding\" indefinite]]]\n   315\t        (let [path (temp-path \"corrupt\")\n   316\t              frame-bytes (frame-of record)]\n   317\t          (append-raw-bytes! path frame-bytes)\n   318\t          (try (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   319\t                     (jing-file/create-content-file path))\n   320\t                   name)\n   321\t               (is (= (byte-count frame-bytes) (file-length path))\n   322\t                   (str name \": the refused file is not mutated\"))\n   323\t               (finally (cleanup-file path))))))))\n   324\t\n   325\t\n   326\t(deftest a-mutated-byte-fails-the-open-without-mutation\n   327\t  (testing\n   328\t    \"a stored frame whose payload bytes change on disk no longer hashes to\n   329\t            its digest: the open and records both refuse, and neither\n   330\t            truncates or rewrites anything\"\n   331\t    (let [path (temp-path \"mutated\")\n   332\t          payload {:mutation \"target\"}\n   333\t          handle (jing-file/create-content-file path)]\n   334\t      (jing/materialize! handle payload)\n   335\t      (jing/close! handle)\n   336\t      (let [len (file-length path)\n   337\t            last-offset (dec len)\n   338\t            original (last (bytes->ints\n   339\t                             (jing-file/encode-record\n   340\t                               (jing/segment-key payload) payload)))]\n   341\t        (try\n   342\t          ;; the payload is the frame's tail, so its last byte is the\n   343\t          ;; file's last byte; flip it\n   344\t          (overwrite-byte! path last-offset (bit-xor original 0xff))\n   345\t          (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   346\t                (jing-file/create-content-file path))\n   347\t              \"the open refuses the mutated frame\")\n   348\t          (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   349\t                (jing-file/records path))\n   350\t              \"records refuses it too\")\n   351\t          (is (= len (file-length path)) \"nothing was truncated\")\n   352\t          ;; restoring the byte restores the store\n   353\t          (overwrite-byte! path last-offset original)\n   354\t          (let [h2 (jing-file/create-content-file path)]\n   355\t            (try (is (= payload (jing/get h2 (jing/segment-key payload)\n   356\t                                          ::absent)))\n   357\t                 (finally (jing/close! h2))))\n   358\t          (finally (cleanup-file path)))))))\n   359\t\n   360\t\n   361\t(deftest unequal-duplicate-at-one-address-fails-the-open\n   362\t  (testing\n   363\t    \"F2's collision case. Two individually valid frames at one address must\n   364\t            be equal (B6: the address hashes the payload), so an unequal\n   365\t            duplicate necessarily fails the second frame's own hash check --\n   366\t            the open fails on F4's ground before the accumulation's\n   367\t            defensive collision branch, which is unreachable by\n   368\t            construction, is ever reached\"\n   369\t    (let [path (temp-path \"collision\")\n   370\t          good (jing/segment-key \"ok\")]\n   371\t      (append-raw-bytes! path (frame-of (jing-file/encode-record good \"ok\")))\n   372\t      (append-raw-bytes!\n   373\t        path (frame-of (cbor-frame (digest-of (bytes-of \"ok\"))\n   374\t                                   (bytes-of \"other\"))))\n   375\t      (try (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   376\t                 (jing-file/create-content-file path)))\n   377\t           (finally (cleanup-file path))))))\n   378\t\n   379\t\n   380\t;; =============================================================================\n   381\t;; F3 -- torn-tail truncation, each category hand-written per host\n   382\t;; =============================================================================\n   383\t\n   384\t(defn- torn-tail-recovers\n   385\t  \"The F3 proof shape: one valid record, a torn tail of raw bytes, and the\n   386\t   open must truncate, replay the survivor, accept a clean put, and reopen\n   387\t   with both records.\"\n   388\t  [prefix torn-bytes]\n   389\t  (let [path (temp-path prefix)\n   390\t        a1 (jing/segment-key \"survivor\")\n   391\t        a2 (jing/segment-key {:after :truncation})\n   392\t        handle (jing-file/create-content-file path)]\n   393\t    (jing/materialize! handle \"survivor\")\n   394\t    (jing/close! handle)\n   395\t    (append-raw-bytes! path torn-bytes)\n   396\t    (try\n   397\t      (let [h2 (jing-file/create-content-file path)]\n   398\t        ;; close is idempotent, so the outer finally may re-close h2.\n   399\t        (try\n   400\t          (is (= [[a1 \"survivor\"]] (jing-file/records path))\n   401\t              \"the torn tail is truncated; only the survivor replays\")\n   402\t          (is (= \"survivor\" (jing/get h2 a1 ::absent)))\n   403\t          (jing/materialize! h2 {:after :truncation})\n   404\t          (jing/close! h2)\n   405\t          (let [h3 (jing-file/create-content-file path)]\n   406\t            (try\n   407\t              (is (= [[a1 \"survivor\"] [a2 {:after :truncation}]]\n   408\t                     (jing-file/records path))\n   409\t                  \"a put after truncation lands clean and survives\")\n   410\t              (is (= {:after :truncation} (jing/get h3 a2 ::absent)))\n   411\t              (finally (jing/close! h3))))\n   412\t          (finally (jing/close! h2))))\n   413\t      (finally (cleanup-file path)))))\n   414\t\n   415\t\n   416\t(deftest torn-tail-overlong-length-is-truncated\n   417\t  (testing\n   418\t    \"F3: a length reaching past end of file is torn -- int32 999 with only\n   419\t            two payload bytes (hand-written, not the v1 fixture: the torn\n   420\t            bytes must follow a valid record)\"\n   421\t    (torn-tail-recovers \"torn-overlong\"\n   422\t                        (host-bytes (into (int32-be 999) [1 2])))))\n   423\t\n   424\t\n   425\t(deftest torn-tail-shorter-than-prefix-is-truncated\n   426\t  (testing \"F3: a tail shorter than the 4-byte length prefix is torn\"\n   427\t    (torn-tail-recovers \"torn-subprefix\" (host-bytes [7 7]))))\n   428\t\n   429\t\n   430\t(deftest torn-tail-negative-length-is-truncated\n   431\t  (testing \"F3: a negative frame length is torn\"\n   432\t    (torn-tail-recovers \"torn-negative\" (host-bytes (int32-be -1)))))\n   433\t\n   434\t\n   435\t;; =============================================================================\n   436\t;; D2, D3, F6 -- handle lifecycle\n   437\t;; =============================================================================\n   438\t\n   439\t(deftest close-semantics\n   440\t  (testing\n   441\t    \"D2/D3/F6: close! returns nil and is idempotent; after close every\n   442\t            entry point throws; stored content is neither cleared nor\n   443\t            rewritten\"\n   444\t    (let [path (temp-path \"close\")\n   445\t          payload {:v 1}\n   446\t          address (jing/segment-key payload)\n   447\t          handle (jing-file/create-content-file path)]\n   448\t      (jing/materialize! handle payload)\n   449\t      (is (nil? (jing/close! handle)))\n   450\t      (is (nil? (jing/close! handle)) \"close is idempotent\")\n   275\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   276\t                    {:algorithm algorithm}))))\n   277\t\n   278\t\n   279\t(defn canonical-bytes\n   280\t  \"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\n   281\t   of v -- the exact bytes content hashing digests, so\n   282\t   `(digest-bytes algo (canonical-bytes v))` is\n   283\t   `(content-hash v {:algorithm algo})`.\n   284\t   This is the byte form Jing content travels in across a `dao.stream`\n   285\t   boundary.\"\n   286\t  [v]\n   287\t  (cbor/encode v))\n   288\t\n   289\t\n   290\t(defn content-hash\n   375\t  \"The content hash carried by a segment address. Equivalent to segment-digest.\n   376\t   Total only over valid segment addresses; throws on invalid input.\"\n   377\t  [k]\n   378\t  (segment-digest k))\n   379\t\n   380\t\n   381\t(defn segment-matches?\n   382\t  \"Total verification predicate: true when address is a valid segment address\n   383\t   and its digest matches the hash of canonical-bytes of payload under the\n   384\t   address-carried algorithm.\n   385\t   Never throws: malformed addresses, unknown algorithms, digest mismatches,\n   386\t   and canonical-encoder refusal all return false.\"\n   387\t  [address payload]\n   388\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\n   389\t    (try\n   390\t      (let [bs (canonical-bytes payload)\n   391\t            actual (digest-bytes algorithm bs)]\n   392\t        (= digest actual))\n   393\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   394\t        false))\n   395\t    false))\n   396\t\n   397\t\n   398\t(defn segment-bytes-match?\n   399\t  \"Total verification predicate over bytes: true when address is a valid\n   400\t   segment address whose digest is the hash of bs under the address-carried\n   401\t   algorithm. Never throws: a malformed address, a foreign algorithm, or a\n   402\t   non-byte bs all answer false.\"\n   403\t  [address bs]\n   404\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\n   405\t    (try\n   406\t      (= digest (digest-bytes algorithm bs))\n   407\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   408\t        false))\n   409\t    false))\n   410\t\n   411\t\n   412\t(def ^:private base64-pattern\n   413\t  \"Padded standard-alphabet Base64: no whitespace, no URL-safe alphabet.\"\n   452\t      (throw (ex-info \"content address does not match the payload\"\n   453\t                      {:address address, :payload payload})))\n   454\t    bs))\n   455\t\n   456\t\n   457\t(defn segment-value\n   458\t  \"The value of payload bytes stored at address: verifies the bytes hash to\n   459\t   the address under its carried algorithm, then decodes exactly one\n   460\t   canonical payload. Throws on a malformed address, a digest mismatch, or\n   461\t   a non-canonical payload.\"\n   462\t  [address bs]\n   463\t  (let [{:keys [algorithm digest]}\n   464\t        (or (parse-segment-address address)\n   465\t            (throw (ex-info \"not a segment content address\"\n   466\t                            {:address address})))]\n   467\t    (when-not (= digest (digest-bytes algorithm bs))\n   468\t      (throw (ex-info \"stored bytes do not hash to their content address\"\n   469\t                      {:address address})))\n   470\t    (cbor/decode bs)))\n   471\t\n   472\t\n   473\t(defn materialize!\n   474\t  \"Content-address payload and store it through the handle's byte store.\n   475\t\n   476\t   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\n   477\t   and [handle payload {:keys [algorithm]}].\n   478\t\n   479