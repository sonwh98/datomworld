dresses))\n   508\t        (doseq [[ast datoms] (map vector durable-programs stored)]\n   509\t          (is (= (select-keys (debruijn/project-datoms\n   510\t                                (second (vm/ast->datoms-with-root ast)))\n   511\t                              [:fingerprint :records])\n   512\t                 (debruijn/datoms->projected datoms))\n   513\t              \"the reopened envelope reads back to the original projection\")))\n   514\t      (finally (cleanup-file path)))))\n   515\t\n   516\t\n   517\t(def ^:private host\n   518\t  ;; :cljd first: the ClojureDart host pass also reads :clj\n   519\t  #?(:cljd :cljd :clj :clj :cljs :cljs))\n   520\t\n   560\t              (do (is (= :diagnostic (:outcome projected)))\n   561\t                  (is (= :projected-write-failed (get-in projected [:diagnostic :rule]))\n   562\t                      \"refused at write by the store's own codec check\")\n   563\t                  (is (empty? (jing-file/records path))\n   564\t                      \"nothing was half-written for the refused program\")))\n   565\t            (when (contains? exact-on host)\n   566\t              (is (= :ok (:outcome projected)))\n   567\t              (when (= :ok (:outcome projected))\n   568\t                (is (= original\n   569\t                       (let [reopened (jing-file/create-content-file path)\n   570\t                             stored (:yin.debruijn/datoms\n   571\t                                      (jing/get reopened (:address projected) ::absent))]\n   572\t                         (jing/close! reopened)\n   573\t                         (debruijn/datoms->projected stored)))\n   574\t                    \"hosts already shown to carry the value carry it exactly\"))))\n   575\t          (finally (cleanup-file path)))))))\n   576\t\n   577\t\n   578\t(deftest list-literals-persist-in-memory\n   579\t  ;; the durable file codec does not carry lists on every host; the\n   580\t  ;; pipeline itself does, and keeps a list distinct from a vector\n   581\t  (let [store (mem-store)\n   582\t        as-list (persist! (app (v 'list) (lit (list 1 2.5))) (recording-writer) store)\n   583\t        as-vector (persist! (app (v 'list) (lit [1 2.5])) (recording-writer) store)]\n   584\t    (is (= :ok (:outcome (:projected as-list)) (:outcome (:projected as-vector))))\n   585\t    (is (= {:yin.debruijn/fingerprint (get-in as-list [:projected :fingerprint]),\n   586\t            :yin.debruijn/datoms (debruijn/projected->datoms\n   587\t                                   (debruijn/project-datoms\n   588\t                                     (second (vm/ast->datoms-with-root\n   589\t                                               (app (v 'list) (lit (list 1 2.5)))))))}\n   590\t           (jing/get store (get-in as-list [:projected :address]) ::absent)))\n   591\t    (is (not= (get-in as-list [:projected :fingerprint])\n   592\t              (get-in as-vector [:projected :fingerprint])))))\n   593\t\n   594\t\n   595\t(deftest renamed-programs-store-equal-projected-datoms\n   596\t  (let [one-store (mem-store)\n   597\t        two-store (mem-store)\n   598\t        one (persist! worked-example (recording-writer) one-store)\n   599\t        two (persist! (lam '[n] (app (v '+) (v 'n) (lit 1))) (recording-writer) two-store)\n   600\t        stored (fn [store result]\n","exit_code":0,"status":"completed"}}
