{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/jing.cljc | sed -n '270,600p'\"","aggregated_output":"   270\t   Returns lowercase hexadecimal string. Unknown algorithms throw.\"\n   271\t  [algorithm s]\n   272\t  (case algorithm\n   273\t    :blake3 (blake3 s)\n   274\t    :sha256 (sha256 s)\n   275\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   276\t                    {:algorithm algorithm}))))\n   277\t\n   278\t\n   279\t(defn canonical-bytes\n   280\t  \"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\n   281\t   of v -- the exact bytes content hashing digests, so\n   282\t   `(digest-bytes algo (canonical-bytes v))` is\n   283\t   `(content-hash v {:algorithm algo})`.\n   284\t   This is the byte form Jing content travels in across a `dao.stream`\n   285\t   boundary.\"\n   286\t  [v]\n   287\t  (cbor/encode v))\n   288\t\n   289\t\n   290\t(defn content-hash\n   291\t  \"Hash the canonical-bytes of v using the specified algorithm (defaulting to\n   292\t   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\n   293\t   Arities: [v] and [v {:keys [algorithm]}].\"\n   294\t  ([v]\n   295\t   (content-hash v {:algorithm default-hash-algorithm}))\n   296\t  ([v opts]\n   297\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\n   298\t     (digest-bytes algo (canonical-bytes v)))))\n   299\t\n   300\t\n   301\t(defn segment-key\n   302\t  \"Mint the content-addressed key for an opaque payload, derived solely from\n   303\t   the payload: :segment/<algorithm-id>-<digest>.\n   304\t   The 1-arg form defaults to default-hash-algorithm (:blake3).\n   305\t   The 2-arg form accepts {:algorithm :sha256} (or any registered algorithm).\"\n   306\t  ([v]\n   307\t   (segment-key v {:algorithm default-hash-algorithm}))\n   308\t  ([v opts]\n   309\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n   310\t         reg (clojure.core/get registry algo)]\n   311\t     (when-not reg\n   312\t       (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n   313\t                       {:algorithm algo})))\n   314\t     (let [algo-id (:address-id reg)\n   315\t           digest (content-hash v {:algorithm algo})]\n   316\t       (keyword \"segment\" (str algo-id \"-\" digest))))))\n   317\t\n   318\t\n   319\t(defn parse-segment-address\n   320\t  \"The authoritative address parser: requires a `segment` namespace keyword,\n   321\t   splits the name on the first `-` into algorithm identifier and digest,\n   322\t   looks the identifier up by exact match (no prefix matching), validates\n   323\t   digest length from the registry entry and lowercase-hex text, and\n   324\t   reconstructs the canonical address to reject alternative spellings.\n   325\t   Returns {:algorithm :<algo>, :digest \\\"<hex>\\\", :canonical :segment/...}\n   326\t   or nil on any rejection (never throws).\"\n   327\t  [address]\n   328\t  (when (keyword? address)\n   329\t    (when (= \"segment\" (namespace address))\n   330\t      (let [n (name address)\n   331\t            i (str/index-of n \"-\")]\n   332\t        (when (and i (pos? i))\n   333\t          (let [algo-id (subs n 0 i)\n   334\t                digest (subs n (inc i))]\n   335\t            (when (re-matches algorithm-id-pattern algo-id)\n   336\t              (when-let [algo (clojure.core/get registry-by-address-id algo-id)]\n   337\t                (let [{:keys [digest-bytes]}\n   338\t                      (clojure.core/get registry algo)]\n   339\t                  (when (and (= (* 2 digest-bytes) (count digest))\n   340\t                             (re-matches hex-digit-pattern digest))\n   341\t                    (let [canonical (keyword \"segment\"\n   342\t                                             (str algo-id \"-\" digest))]\n   343\t                      (when (= canonical address)\n   344\t                        {:algorithm algo,\n   345\t                         :digest digest,\n   346\t                         :canonical canonical}))))))))))))\n   347\t\n   348\t\n   349\t(defn segment-address?\n   350\t  \"True when x is a valid content address in the closed registry:\n   351\t   :segment/<algorithm>-<digest-hex>.\"\n   352\t  [x]\n   353\t  (boolean (parse-segment-address x)))\n   354\t\n   355\t\n   356\t(defn segment-algorithm\n   357\t  \"The algorithm keyword (:blake3, :sha256) carried by a segment address.\n   358\t   Throws on invalid input.\"\n   359\t  [address]\n   360\t  (if-let [parsed (parse-segment-address address)]\n   361\t    (:algorithm parsed)\n   362\t    (throw (ex-info \"not a segment content address\" {:address address}))))\n   363\t\n   364\t\n   365\t(defn segment-digest\n   366\t  \"The lowercase hex digest carried by a segment address.\n   367\t   Throws on invalid input.\"\n   368\t  [address]\n   369\t  (if-let [parsed (parse-segment-address address)]\n   370\t    (:digest parsed)\n   371\t    (throw (ex-info \"not a segment content address\" {:address address}))))\n   372\t\n   373\t\n   374\t(defn segment-hash\n   375\t  \"The content hash carried by a segment address. Equivalent to segment-digest.\n   376\t   Total only over valid segment addresses; throws on invalid input.\"\n   377\t  [k]\n   378\t  (segment-digest k))\n   379\t\n   380\t\n   381\t(defn segment-matches?\n   382\t  \"Total verification predicate: true when address is a valid segment address\n   383\t   and its digest matches the hash of canonical-bytes of payload under the\n   384\t   address-carried algorithm.\n   385\t   Never throws: malformed addresses, unknown algorithms, digest mismatches,\n   386\t   and canonical-encoder refusal all return false.\"\n   387\t  [address payload]\n   388\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\n   389\t    (try\n   390\t      (let [bs (canonical-bytes payload)\n   391\t            actual (digest-bytes algorithm bs)]\n   392\t        (= digest actual))\n   393\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   394\t        false))\n   395\t    false))\n   396\t\n   397\t\n   398\t(defn segment-bytes-match?\n   399\t  \"Total verification predicate over bytes: true when address is a valid\n   400\t   segment address whose digest is the hash of bs under the address-carried\n   401\t   algorithm. Never throws: a malformed address, a foreign algorithm, or a\n   402\t   non-byte bs all answer false.\"\n   403\t  [address bs]\n   404\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\n   405\t    (try\n   406\t      (= digest (digest-bytes algorithm bs))\n   407\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   408\t        false))\n   409\t    false))\n   410\t\n   411\t\n   412\t(def ^:private base64-pattern\n   413\t  \"Padded standard-alphabet Base64: no whitespace, no URL-safe alphabet.\"\n   414\t  #\"(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?\")\n   415\t\n   416\t\n   417\t(defn bytes->base64\n   418\t  \"The padded standard-alphabet Base64 text of host bytes bs: the transport\n   419\t   representation of canonical payload bytes inside Transit envelopes\n   420\t   (docs/design/dao.jing.cbor.md, Remote and DHT).\"\n   421\t  [bs]\n   422\t  #?(:clj (.encodeToString (java.util.Base64/getEncoder) ^bytes bs)\n   423\t     :cljs (base64/encodeByteArray bs)\n   424\t     :cljd (convert/base64Encode bs)))\n   425\t\n   426\t\n   427\t(defn base64->bytes\n   428\t  \"The host bytes of padded standard-alphabet Base64 text s, decoded\n   429\t   strictly: anything else (whitespace, the URL-safe alphabet, missing\n   430\t   padding, a non-string) throws.\"\n   431\t  [s]\n   432\t  (when-not (and (string? s) (re-matches base64-pattern s))\n   433\t    (throw (ex-info \"not padded standard-alphabet Base64\" {:text s})))\n   434\t  #?(:clj (.decode (java.util.Base64/getDecoder) ^String s)\n   435\t     :cljs (base64/decodeStringToUint8Array s)\n   436\t     :cljd (convert/base64Decode s)))\n   437\t\n   438\t\n   439\t(defn segment-bytes\n   440\t  \"The canonical payload bytes of payload, which must hash to address\n   441\t   under the address-carried algorithm; the byte-level twin of\n   442\t   segment-matches? for a backend that stores bytes and needs them.\n   443\t   Throws on a malformed address, an unencodable payload, or a digest\n   444\t   mismatch.\"\n   445\t  [address payload]\n   446\t  (let [{:keys [algorithm digest]}\n   447\t        (or (parse-segment-address address)\n   448\t            (throw (ex-info \"not a segment content address\"\n   449\t                            {:address address})))\n   450\t        bs (canonical-bytes payload)]\n   451\t    (when-not (= digest (digest-bytes algorithm bs))\n   452\t      (throw (ex-info \"content address does not match the payload\"\n   453\t                      {:address address, :payload payload})))\n   454\t    bs))\n   455\t\n   456\t\n   457\t(defn segment-value\n   458\t  \"The value of payload bytes stored at address: verifies the bytes hash to\n   459\t   the address under its carried algorithm, then decodes exactly one\n   460\t   canonical payload. Throws on a malformed address, a digest mismatch, or\n   461\t   a non-canonical payload.\"\n   462\t  [address bs]\n   463\t  (let [{:keys [algorithm digest]}\n   464\t        (or (parse-segment-address address)\n   465\t            (throw (ex-info \"not a segment content address\"\n   466\t                            {:address address})))]\n   467\t    (when-not (= digest (digest-bytes algorithm bs))\n   468\t      (throw (ex-info \"stored bytes do not hash to their content address\"\n   469\t                      {:address address})))\n   470\t    (cbor/decode bs)))\n   471\t\n   472\t\n   473\t(defn materialize!\n   474\t  \"Content-address payload and store it through the handle's byte store.\n   475\t\n   476\t   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\n   477\t   and [handle payload {:keys [algorithm]}].\n   478\t\n   479\t   The payload is encoded exactly once. The address is derived solely from\n   480\t   those canonical bytes, and the same bytes go to the backend effect\n   481\t   :put-bytes-fn as (put-bytes-fn address bytes). The backend must answer\n   482\t   with one of:\n   483\t\n   484\t     :inserted -- the bytes are durably stored now;\n   485\t     :present  -- bytes are already stored under that address.\n   486\t\n   487\t   Any other answer is an invalid backend result and throws: DaoJing does\n   488\t   not accept ambiguous truthiness. The address is returned only after the\n   489\t   backend reports success.\n   490\t\n   491\t   On :present the stored bytes are read back through :get-bytes-fn and\n   492\t   verified both by hash against the address and byte for byte against the\n   493\t   proposed bytes. Equal content is idempotent and returns the same\n   494\t   address. Content that does not hash to its own address is an integrity\n   495\t   failure and throws loudly. Nothing is ever overwritten.\"\n   496\t  ([handle payload]\n   497\t   (materialize! handle payload {:algorithm default-hash-algorithm}))\n   498\t  ([handle payload opts]\n   499\t   (let [put (:put-bytes-fn handle)\n   500\t         get-fn (:get-bytes-fn handle)]\n   501\t     (when-not (fn? put)\n   502\t       (throw (ex-info \"dao.jing handle requires :put-bytes-fn\"\n   503\t                       {:handle handle})))\n   504\t     (when-not (fn? get-fn)\n   505\t       (throw (ex-info \"dao.jing handle requires :get-bytes-fn\"\n   506\t                       {:handle handle})))\n   507\t     (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n   508\t           reg (clojure.core/get registry algo)]\n   509\t       (when-not reg\n   510\t         (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n   511\t                         {:algorithm algo})))\n   512\t       (let [bs (canonical-bytes payload)\n   513\t             address (keyword \"segment\"\n   514\t                              (str (:address-id reg) \"-\"\n   515\t                                   (digest-bytes algo bs)))\n   516\t             result (put address bs)]\n   517\t         (case result\n   518\t           :inserted address\n   519\t           :present\n   520\t           (let [stored (get-fn address content-missing)]\n   521\t             (cond\n   522\t               (identical? stored content-missing)\n   523\t               (throw\n   524\t                 (ex-info\n   525\t                   \"backend reported :present but the content address is absent\"\n   526\t                   {:address address, :payload payload}))\n   527\t               ;; the read-back must hash to the address it sits at and be\n   528\t               ;; the very bytes proposed\n   529\t               (and (segment-bytes-match? address stored)\n   530\t                    (cbor/bytes= stored bs))\n   531\t               address\n   532\t               :else\n   533\t               (throw\n   534\t                 (ex-info\n   535\t                   (str \"content collision: the stored bytes do not match \"\n   536\t                        \"their content address\")\n   537\t                   {:address address, :payload payload}))))\n   538\t           (throw (ex-info\n   539\t                    \"invalid backend put result\"\n   540\t                    {:result result, :address address, :payload payload}))))))))\n   541\t\n   542\t\n   543\t(defn get\n   544\t  \"Retrieve the value stored at a content address.\n   545\t\n   546\t   Only valid registered content addresses are valid DaoJing reads;\n   547\t   arbitrary keys and mutable roots are outside DaoJing and throw before the\n   548\t   backend is consulted. The backend's bytes are hash-verified against the\n   549\t   address and decoded; bytes that do not hash to the address throw.\n   550\t   Returns not-found when the address is absent.\"\n   551\t  [handle address not-found]\n   552\t  (when-not (segment-address? address)\n   553\t    (throw (ex-info \"dao.jing reads only valid segment content addresses\"\n   554\t                    {:address address})))\n   555\t  (let [get-fn (:get-bytes-fn handle)]\n   556\t    (when-not (fn? get-fn)\n   557\t      (throw (ex-info \"dao.jing handle requires :get-bytes-fn\"\n   558\t                      {:handle handle})))\n   559\t    (let [stored (get-fn address not-found)]\n   560\t      (if (identical? stored not-found)\n   561\t        not-found\n   562\t        (segment-value address stored)))))\n   563\t\n   564\t\n   565\t(defn close!\n   566\t  \"Close the backend through its optional :close-fn. Idempotency is the\n   567\t   backend's contract: close! simply delegates, so a backend that tolerates\n   568\t   repeated closes may be closed repeatedly. Returns nil. Handles without\n   569\t   :close-fn have nothing to release.\"\n   570\t  [handle]\n   571\t  (when-let [close-fn (:close-fn handle)] (close-fn))\n   572\t  nil)\n   573\t\n   574\t\n   575\t;; =============================================================================\n   576\t;; Intake-pool observer (docs/design/dao.jing.md, The intake pool and\n   577\t;; Cursor tracking and recovery)\n   578\t;; =============================================================================\n   579\t\n   580\t(defn observer-state\n   581\t  \"Construct the observer state for an explicit intake pool.\n   582\t\n   583\t   members is a sequence of {:stream <dao.stream reader handle> :cursor\n   584\t   <opaque>} entries. The composition mints each cursor itself, from an\n   585\t   anchor of its choosing, and hands it in; DaoJing never fabricates one.\n   586\t   Returns plain data, no atoms or registration:\n   587\t\n   588\t     {:members [{:stream s, :cursor c, :status :pending} ...]\n   589\t      :next 0}\n   590\t\n   591\t   A member without a :cursor, or whose :stream lacks the reader surface,\n   592\t   is a composition defect and throws here, before any operation. :next is\n   593\t   the fair round-robin index observe-step! polls first; :pending is the\n   594\t   never-polled status. Because the state is plain data,\n   595\t   (observer-state (:members state)) rebuilds one from its members.\"\n   596\t  [members]\n   597\t  {:members (mapv (fn [member]\n   598\t                    (when-not (map? member)\n   599\t                      (throw (ex-info\n   600\t                               (str \"dao.jing pool members are \"\n","exit_code":0,"status":"completed"}}
