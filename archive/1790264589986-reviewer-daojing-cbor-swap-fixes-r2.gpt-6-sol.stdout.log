       (try (jing/base64->bytes (:value resp))\nsrc/cljc/dao/jing/dht.cljc:9:      :put-bytes-fn f, :get-bytes-fn g, :close-fn c}\nsrc/cljc/dao/jing/dht.cljc:162:  (when-not (jing/segment-bytes-match? address bs)\nsrc/cljc/dao/jing/dht.cljc:172:  (try (let [bs (jing/base64->bytes b64)]\nsrc/cljc/dao/jing/dht.cljc:173:         (when (jing/segment-bytes-match? address bs)\nsrc/cljc/dao/jing/dht.cljc:208:    (let [result ((:put-bytes-fn local) address bs)]\nsrc/cljc/dao/jing/dht.cljc:231:    (let [v ((:get-bytes-fn local) address content-missing)]\nsrc/cljc/dao/jing/dht.cljc:245:                  result ((:put-bytes-fn local) address bs)]\nsrc/cljc/dao/jing/dht.cljc:291:      :put-bytes-fn f, :get-bytes-fn g, :close-fn c}\nsrc/cljc/dao/jing/dht.cljc:295:   :put-bytes-fn and :get-bytes-fn (dao.jing.mem/create-content-mem or\nsrc/cljc/dao/jing/dht.cljc:306:  (when-not (fn? (:put-bytes-fn local))\nsrc/cljc/dao/jing/dht.cljc:307:    (throw (ex-info \"dao.jing.dht local requires :put-bytes-fn\"\nsrc/cljc/dao/jing/dht.cljc:309:  (when-not (fn? (:get-bytes-fn local))\nsrc/cljc/dao/jing/dht.cljc:310:    (throw (ex-info \"dao.jing.dht local requires :get-bytes-fn\"\nsrc/cljc/dao/jing/dht.cljc:315:           :put-bytes-fn (make-put handle)\nsrc/cljc/dao/jing/dht.cljc:316:           :get-bytes-fn (make-get handle)\n  1135\t\n  1136\t\n  1137\t(defn byte-payload?\n  1138\t  \"True for the host byte array `encode` returns and `decode` accepts:\n  1139\t   byte[] on the JVM, Uint8Array on JavaScript, Uint8List on Dart.\"\n  1140\t  [x]\n  1141\t  (wire/byte-payload? x))\n  1142\t\n  1143\t\n  1144\t(defn copy-bytes\n  1145\t  \"A fresh copy of host byte array bs, so a holder's snapshot cannot be\n  1146\t   changed through the array a caller keeps.\"\n  1147\t  [bs]\n  1148\t  (copy-range bs 0 (blen bs)))\n  1149\t\n  1150\t\n  1151\t(defn encoded-compare\n  1152\t  \"Order two supported values by their canonical encodings: the shorter\n  1153\t   encoding first, then unsigned bytewise (the order this profile already\n   460\t\n   461\t\n   462\t(deftest contention-writes-exactly-one-record\n   463\t  (testing\n   464\t    \"D5/F6: under JVM contention, N concurrent puts of one payload yield\n   465\t            exactly one :inserted, N-1 :present, and one record\"\n   466\t    #?(:clj (let [path (temp-path \"contention\")\n   467\t                  payload {:contended true}\n   468\t                  address (jing/segment-key payload)\n   469\t                  handle (jing-file/create-content-file path)]\n   470\t              (try (let [results (mapv #(deref % 5000 ::timeout)\n   471\t                                       (doall (repeatedly\n   472\t                                                16\n   473\t                                                (fn []\n   474\t                                                  (future\n   475\t                                                    ((:put-bytes-fn handle)\n   476\t                                                     address\n   477\t                                                     (bytes-of payload)))))))]\n   478\t                     (is (not-any? #{::timeout} results))\n   479\t                     (is (= 1 (count (filter #{:inserted} results))))\n   480\t                     (is (= 15 (count (filter #{:present} results))))\n   481\t                     (is (= [[address payload]] (jing-file/records path))))\n   482\t                   (finally (jing/close! handle) (cleanup-file path))))\n   483\t       :cljs (is true \"JVM contention is a clj-only property\")\n   484\t       :cljd (is true \"JVM contention is a clj-only property\"))))\n   485\t\n   486\t\n   487\t(deftest multi-algorithm-file-store-and-replay-test\n   488\t  (testing \"file backend stores both algorithms and replays cleanly\"\n   489\t    (let [path         (temp-path \"multi-algo\")\n   490\t          h1           (jing-file/create-content-file path)\n   491\t          p1           {:msg \"first payload\", :n 1}\n   492\t          p2           {:msg \"second payload\", :n 2}\n   493\t          addr-b3      (jing/materialize! h1 p1)\n   494\t          addr-s256    (jing/materialize! h1 p2 {:algorithm :sha256})\n   495\t          addr-p1-s256 (jing/materialize! h1 p1 {:algorithm :sha256})]\n    65\t(deftest create-content-mem-returns-a-stream-free-byte-store-handle\n    66\t  (testing\n    67\t    \"the handle is plain data carrying the three backend effects and the\n    68\t            test-facing snapshot, and nothing mutable\"\n    69\t    (let [h (mem/create-content-mem)]\n    70\t      (is (map? h))\n    71\t      (is (fn? (:put-bytes-fn h)))\n    72\t      (is (fn? (:get-bytes-fn h)))\n    73\t      (is (fn? (:close-fn h)))\n    74\t      (is (fn? (:entries-fn h)))\n    75\t      (is (every? fn? (vals h))\n    76\t          \"no atom, array or state reaches a caller through the handle\")))\n    77\t  (testing \"a fresh store holds nothing and identifies no source\"\n    78\t    (let [h (mem/create-content-mem)]\n    79\t      (is (empty? (mem/entries h))\n    80\t          \"a content store starts with no entries and no provenance\"))))\n","exit_code":0,"status":"completed"}}
