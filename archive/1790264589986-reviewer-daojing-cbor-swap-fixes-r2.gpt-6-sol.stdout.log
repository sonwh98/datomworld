{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/jing/file_test.cljc | sed -n '200,450p'; nl -ba src/cljc/dao/jing.cljc | sed -n '275,290p;375,413p;452,565p'; rg -n 'FAIL|ERROR|debruijn/value|list-literals-persist|Ran [0-9]+ tests' target/test-cljs.log\"","aggregated_output":"   200\t            \"records preserves frame order, duplicates included\")\n   201\t        (finally (jing/close! handle) (cleanup-file path))))))\n   202\t\n   203\t\n   204\t(deftest invalid-put-writes-nothing\n   205\t  (testing\n   206\t    \"B6: the backend validates at its own door -- a non-segment address or an\n   207\t            address that does not hash to the payload throws and stores\n   208\t            nothing\"\n   209\t    (let [path (temp-path \"invalid-put\")\n   210\t          handle (jing-file/create-content-file path)]\n   211\t      (try\n   212\t        (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   213\t              ((:put-bytes-fn handle) :root/not-content (bytes-of \"x\"))))\n   214\t        (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   215\t              ((:put-bytes-fn handle) (jing/segment-key \"y\") (bytes-of \"x\"))))\n   216\t        (is (= [] (jing-file/records path)) \"nothing was written\")\n   217\t        (finally (jing/close! handle) (cleanup-file path))))))\n   218\t\n   219\t\n   220\t;; =============================================================================\n   221\t;; F2, F4 -- replay, duplicates, and failing the open\n   222\t;; =============================================================================\n   223\t\n   224\t(deftest durability-across-close-and-reopen\n   225\t  (testing\n   226\t    \"F2/F5: every record replays into the content map on the next open\"\n   227\t    (let [path (temp-path \"durability\")\n   228\t          a1 (jing/segment-key \"alpha\")\n   229\t          a2 (jing/segment-key {:n 2})\n   230\t          handle (jing-file/create-content-file path)]\n   231\t      (jing/materialize! handle \"alpha\")\n   232\t      (jing/materialize! handle {:n 2})\n   233\t      (jing/close! handle)\n   234\t      (let [h2 (jing-file/create-content-file path)]\n   235\t        (try (is (= \"alpha\" (jing/get h2 a1 ::absent)))\n   236\t             (is (= {:n 2} (jing/get h2 a2 ::absent)))\n   237\t             (finally (jing/close! h2) (cleanup-file path)))))))\n   238\t\n   239\t\n   240\t(deftest acknowledged-insert-survives-immediate-close\n   241\t  (testing\n   242\t    \"F1/F5: the :inserted verdict is returned only after the flush, so an\n   243\t            immediate close cannot lose the record\"\n   244\t    (let [path (temp-path \"ack\")\n   245\t          payload {:ack 1}\n   246\t          address (jing/segment-key payload)\n   247\t          handle (jing-file/create-content-file path)]\n   248\t      (jing/materialize! handle payload)\n   249\t      (jing/close! handle)\n   250\t      (let [h2 (jing-file/create-content-file path)]\n   251\t        (try (is (= payload (jing/get h2 address ::absent)))\n   252\t             (finally (jing/close! h2) (cleanup-file path)))))))\n   253\t\n   254\t\n   255\t(deftest equal-duplicate-frames-recover\n   256\t  (testing\n   257\t    \"F2: an equal duplicate record is tolerated on replay; the duplicate\n   258\t            frame is visible to records and writes nothing new\"\n   259\t    (let [path (temp-path \"dup\")\n   260\t          address (jing/segment-key {:k 1})\n   261\t          payload {:k 1}\n   262\t          handle (jing-file/create-content-file path)]\n   263\t      (jing/materialize! handle payload)\n   264\t      (jing/close! handle)\n   265\t      ;; Hand-write the identical frame again, bypassing the backend.\n   266\t      (append-raw-bytes! path\n   267\t                         (frame-of (jing-file/encode-record address payload)))\n   268\t      (is (= 2 (count (jing-file/records path)))\n   269\t          \"records