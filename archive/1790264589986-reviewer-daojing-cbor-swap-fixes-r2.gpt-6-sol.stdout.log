dle must expose a :get-bytes-fn\" {:handle handle})))\n    88\t    {:jing/put-content\n    89\t     (fn [address b64]\n    90\t       (let [bs (accept-bytes! address b64)\n    91\t             result (put address bs)]\n    92\t         (if (#{:inserted :present} result)\n    93\t           result\n    94\t           (throw (ex-info\n    95\t                    \"backend returned an invalid put result\"\n    96\t                    {:address address, :result result}))))),\n    97\t     :jing/get-content (fn [address]\n    98\t                         (when-not (jing/segment-address? address)\n    99\t                           (throw (ex-info\n   100\t                                    \"content address must be a segment address\"\n   101\t                                    {:address address})))\n   102\t                         (let [result (get-fn address local-missing)]\n   103\t                           (if (identical? result local-missing)\n   104\t                             {:found? false, :value nil}\n   105\t                             {:found? true,\n   106\t                              :value (jing/bytes->base64 result)})))}))\n   107\t\n   108\t\n   109\t(defn content-client\n   110\t  \"Wrap an RPC client as a dao.jing byte-store handle: puts send the\n   111\t   canonical bytes as Base64 text, gets decode the Base64 the server\n   112\t   answers (the caller, dao.jing/get, hash-verifies the bytes).\n   113\t\n   114\t   call-fn is invoked as (call-fn client op args) and close-fn as\n   115\t   (close-fn client). Close is guarded so concurrent JVM closes call the\n   116\t   underlying close-fn exactly once; if close-fn throws, the client stays\n   117\t   open for retry.\"\n   118\t  [client call-fn close-fn]\n   119\t  (when-not (ifn? call-fn)\n   120\t    (throw (ex-info \"call-fn must be a function\" {:call-fn call-fn})))\n   121\t  (when-not (ifn? close-fn)\n   122\t    (throw (ex-info \"close-fn must be a function\" {:close-fn close-fn})))\n   123\t  (let [closed-atom (atom false)\n   124\t        close-lock #?(:clj (Object.)\n   125\t                      :default nil)\n   126\t        ensure-open (fn []\n   127\t                      (when @closed-atom\n   128\t                        (throw (ex-info \"content client is closed\"\n   129\t                                        {:client client}))))]\n   130\t    {:client client,\n   131\t     :closed-atom closed-atom,\n   132\t     :put-bytes-fn (fn [address bs]\n   133\t                     (ensure-open)\n   134\t                     (call-fn client :jing/put-content\n   135\t                              [address (jing/bytes->base64 bs)])),\n   136\t     :get-bytes-fn\n   137\t     (fn [address not-found]\n   138\t       (ensure-open)\n   139\t       (let [resp (call-fn client :jing/get-content [address])\n   140\t             bs (when (and (valid-presence-envelope? resp) (:found? resp))\n   141\t                  (try (jing/base64->bytes (:value resp))\n   142\t                       (catch #?(:cljd Object :clj Throwable :cljs :default)\n   143\t                              _\n   144\t                         nil)))]\n   145\t         (cond\n   146\t           (some? bs) bs\n   147\t           (and (valid-presence-envelope? resp) (not (:found? resp)))\n   148\t           not-found\n   149\t           :else\n   150\t           (throw\n   151\t             (ex-info\n   154\t\n   155\t(defn- validate-address-bytes!\n   156\t  \"Reject a put before any local or network action: the address must be a\n   157\t   valid segment content address whose digest is the hash of the bytes.\"\n   158\t  [address bs]\n   159\t  (when-not (jing/segment-address? address)\n   160\t    (throw (ex-info \"dao.jing.dht: not a segment content address\"\n   161\t                    {:address address})))\n   162\t  (when-not (jing/segment-bytes-match? address bs)\n   163\t    (throw (ex-info \"dao.jing.dht: content address does not match the bytes\"\n   164\t                    {:address address}))))\n   165\t\n   166\t\n   167\t(defn- accept-bytes\n   168\t  \"The canonical bytes of the Base64 text a peer answered for address, or\n   169\t   nil when the text, the digest, or the payload's canonicality fails: a\n   170\t   peer is untrusted, so this is the one ingress check before caching.\"\n   171\t  [address b64]\n   172\t  (try (let [bs (jing/base64->bytes b64)]\n   173\t         (when (jing/segment-bytes-match? address bs)\n   174\t           (cbor/decode bs)\n   175\t           bs))\n   176\t       (catch #?(:clj Throwable\n   177\t                 :cljs :default\n   178\t                 :cljd Object)\n   179\t              _\n   180\t         nil)))\n   193\t(defn- safe-fetch-content\n   194\t  [net peer address]\n   195\t  (try (fetch-content net peer address)\n   196\t       (catch #?(:clj Throwable\n   197\t                 :cljs :default\n   198\t                 :cljd Object)\n   199\t              _\n   200\t         nil)))\n   201\t\n   202\t\n   203\t(defn- make-put\n   204\t  [{:keys [net local], :as handle}]\n   205\t  (fn [address bs]\n   206\t    (validate-address-bytes! address bs)\n   207\t    (ensure-open handle)\n   208\t    (let [result ((:put-bytes-fn local) address bs)]\n   209\t      (when-not (#{:inserted :present} result)\n   210\t        (throw (ex-info \"dao.jing.dht: invalid local put result\"\n   211\t                        {:result result, :address address})))\n   212\t      (let [self-id (:id (self-peer net))\n   213\t            b64 (jing/bytes->base64 bs)\n   214\t            peers (remove #(= self-id (:id %))\n   215\t                          (lookup net (content-target address)))]\n   216\t        #?(:clj (run! deref\n   217\t                      (mapv (fn [peer]\n   218\t                              (future\n   219\t                                (safe-store-content! net peer address b64)))\n   220\t                            peers))\n   221\t           :default (run! (fn [peer]\n   222\t                            (safe-store-content! net peer address b64))\n   223\t                          peers)))\n   224\t      result)))\n   225\t\n   226\t\n   227\t(defn- make-get\n   228\t  [{:keys [net local], :as handle}]\n   229\t  (fn [address not-found]\n   230\t    (ensure-open handle)\n   231\t    (let [v ((:get-bytes-fn local) address content-missing)]\n   232\t      (if (not (identical? v content-missing))\n   233\t        v\n   234\t        (let [self-id (:id (self-peer net))\n   235\t              fetched\n   236\t              (some (fn [peer]\n   237\t                      (when (not= self-id (:id peer))\n   238\t                        (when-let [res (safe-fetch-content net peer address)]\n   239\t                          (when (:found? res)\n   240\t                            (when-let [bs (accept-bytes address (:value res))]\n   241\t                              [bs])))))\n   242\t                    (lookup net (content-target address)))]\n   243\t          (if fetched\n   244\t            (let [bs (first fetched)\n   245\t                  result ((:put-bytes-fn local) address bs)]\n   246\t              (when-not (#{:inserted :present} result)\n   247\t                (throw\n   248\t                  (ex-info\n   249\t                    \"dao.jing.dht: fetched content could not be cached\"\n   250\t                    {:address address, :result result})))\n   251\t              bs)\n   252\t            not-found))))))\n   253\t\n   254\t\n   108\t       ;; segment address for the payload, never a bare hash, a\n   109\t       ;; foreign namespace, or a mismatched value, and the local\n   110\t       ;; backend's verdict must be an explicit :inserted/:present\n   111\t       ;; :v is the canonical payload bytes as padded standard Base64;\n   112\t       ;; the bytes must decode as one canonical payload (the ingress\n   113\t       ;; check) before the local byte store sees them\n   114\t       :store-content\n   115\t       (let [{:keys [address v]} msg]\n   116\t         (try\n   117\t           (if (jing/segment-address? address)\n   118\t             (let [bs (jing/base64->bytes v)]\n   119\t               (if (jing/segment-bytes-match? address bs)\n   120\t                 (do (cbor/decode bs)\n   121\t                     (let [result ((:put-bytes-fn local) address bs)]\n   122\t                       (if (#{:inserted :present} result)\n   123\t                         {:ok true}\n   124\t                         {:ok false})))\n   125\t                 {:ok false}))\n   126\t             {:ok false})\n   127\t           (catch Exception _ {:ok false})))\n   128\t       ;; :found travels explicitly on both reads: nil is a legal stored\n   129\t       ;; value, so presence cannot be inferred from :v\n   130\t       :fetch-content\n   131\t       (let [bs (if (jing/segment-address? (:address msg))\n   132\t                  ((:get-bytes-fn local) (:address msg) missing)\n   246\t                                 {:algorithm algo})))\n   247\t         addr (keyword \"segment\"\n   248\t                       (str (:address-id reg) \"-\" (jing/digest-bytes algo bs)))]\n   249\t     (submit state put-content-op [addr (jing/bytes->base64 bs)] true))))\n   250\t\n   251\t\n   252\t(defn- accepted-bytes\n   253\t  \"The canonical bytes a `:jing/get-content` envelope carries for address\n   254\t   as Base64 text, or nil when the text is not strict Base64 or the bytes\n   255\t   do not hash to the address.\"\n   256\t  [address b64]\n   257\t  (try (let [bs (jing/base64->bytes b64)]\n   258\t         (when (jing/segment-bytes-match? address bs) bs))\n   259\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   260\t         nil)))\n   261\t\n   262\t\n   263\t;; =============================================================================\n   264\t;; Completion decode\n   290\t            (if (#{:inserted :present} value)\n   291\t              {:id id :op op :address (first (:dao.stream.rpc/args completion))\n   292\t               :result value}\n   293\t              {:id id :op op :error (malformed-response op)})\n   294\t\n   295\t            ;; a found value arrives as Base64 of its canonical bytes; the\n   296\t            ;; bytes must hash to the requested address and decode as one\n   297\t            ;; canonical payload before a value is published\n   298\t            (= get-content-op op)\n   299\t            (if (presence-envelope? value)\n   300\t              (if (:found? value)\n   301\t                (let [address (first (:dao.stream.rpc/args completion))\n   302\t                      bs (accepted-bytes address (:value value))\n   303\t                      decoded (when bs\n   304\t                                (try (jing/segment-value address bs)\n   305\t                                     (catch #?(:cljd Object\n   306\t                                               :clj Throwable\n   307\t                                               :cljs :default)\n   308\t                                            _\n   309\t                                       ::refused)))]\n   310\t                  (if (or (nil? bs) (identical? ::refused decoded))\n   311\t                    {:id id :op op\n   124\t- Verify every retrieved payload against its requested address before\n   125\t  decoding exactly one supported value. Canonicality verification (decode,\n   126\t  re-encode, byte-compare) occurs exactly once at each ingress of bytes Jing\n   127\t  did not encode itself: remote/DHT receipt and file replay acceptance,\n   128\t  before storage, caching, or exposure. Ordinary reads of accepted snapshots\n   129\t  hash-verify and decode without re-encoding. Validation belongs to the\n   130\t  shared codec/wrapper at those boundaries, not to backend value handlers;\n   131\t  immutable local forwarding does not repeat ingress validation. Missing\n   132\t  content remains distinct from stored nil, which has a CBOR representation.\n   133\t- Store immutable snapshots. Memory backends copy byte arrays on insertion\n   134\t  and retrieval so caller mutation cannot change previously addressed\n","exit_code":0,"status":"completed"}}
