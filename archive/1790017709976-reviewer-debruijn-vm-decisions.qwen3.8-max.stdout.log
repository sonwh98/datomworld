e":"tool_result","tool_use_id":"call_105e316c4ad4452a8c9e821f","content":[{"type":"text","text":"src/cljc/yin/vm/ast_walker.cljc:200:                                  (engine/bind-params params evaluated-operands))]\nsrc/cljc/yin/vm/ast_walker.cljc:379:        (let [value (engine/resolve-var env store primitives modules (:name node))]\nsrc/cljc/yin/vm/ast_walker.cljc:536:                                                (engine/bind-params params []))]\nsrc/cljc/yin/vm/ast_walker.cljc:578:                                                  (engine/bind-params params\nsrc/cljc/yin/vm/ast_walker.cljc:628:               :variable (let [v (engine/resolve-var env\nsrc/cljc/yin/vm/code.cljc:194:(def vector-operand-table\nsrc/cljc/yin/vm/code.cljc:262:  (mapv second (get vector-operand-table (nth t 0))))\nsrc/cljc/yin/vm/code.cljc:293:            (when-not (= (inc (count (get vector-operand-table (nth t 0))))\nsrc/cljc/yin/vm/completion.cljc:42:  \"The one lowering profile whose body layout `segment-scope` reads.\"\nsrc/cljc/yin/vm/completion.cljc:132:(defn- closure-ranges\nsrc/cljc/yin/vm/completion.cljc:147:(defn- layout-conforms?\nsrc/cljc/yin/vm/completion.cljc:153:  (let [ranges (closure-ranges v)\nsrc/cljc/yin/vm/completion.cljc:162:(defn segment-scope\nsrc/cljc/yin/vm/completion.cljc:171:          (closure-ranges v))))\nsrc/cljc/yin/vm/completion.cljc:174:(def ^:private segment-scope-rules\nsrc/cljc/yin/vm/completion.cljc:196:     (if (and (= layout-profile profile) (layout-conforms? v))\nsrc/cljc/yin/vm/completion.cljc:204:                            (query/relation (segment-scope v))\nsrc/cljc/yin/vm/completion.cljc:205:                            segment-scope-rules\nsrc/cljc/yin/vm/completion.cljc:436:   `resolve-var`'s terms, as `{:name module :manifest address-or-nil\nsrc/cljc/yin/vm/completion.cljc:454:  \"§6: rule one obligation, in `resolve-var`'s order minus env — store,\nsrc/cljc/yin/vm/semantic.cljc:206:    (let [E' (merge (:env f) (engine/bind-params (:para