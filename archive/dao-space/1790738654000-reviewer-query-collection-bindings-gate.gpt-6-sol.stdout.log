...] yields one binding per element; relation [[?a ?b]] one per\n  1291\t   tuple. Terms unify as in patterns, so _ is blank and a bare symbol is a\n  1292\t   constant. A collection or relation form takes a sequential or a set ret\n  1293\t   (order is irrelevant: the result is a set); nil or an empty one yields\n  1294\t   no binding, and anything else, a map included, is a query error.\"\n  1295\t  [binding out ret clause]\n  1296\t  (if-not (vector? out)\n  1297\t    (if-let [b (unify binding out ret)] [b] [])\n  1298\t    (let [kind (classify-in-pattern out)\n  1299\t          terms (case kind\n  1300\t                  :coll (butlast out)\n  1301\t                  :relation (first out)\n  1302\t                  :tuple out)]\n  1303\t      (when (or (and (= :coll kind) (not= 2 (count out)))\n  1304\t                (and (= :relation kind) (not= 1 (count out)))\n  1305\t                (some #(or (= '... %) (vector? %)) terms))\n  1306\t        (throw (ex-info\n  1307\t                 \"Unsupported binding form — use ?x, [?a ?b], [?x ...] or [[?a ?b]]\"\n  1308\t                 {:binding-form out, :clause clause})))\n  1309\t      (when (and (#{:coll :relation} kind)\n  1310\t                 (not (or (nil? ret) (sequential? ret) (set? ret))))\n  1311\t        (throw (ex-info (str \"Function return for a \"\n  1312\t                             (if (= :coll kind) \"collection\" \"relation\")\n  1313\t                             \" binding must be nil, sequential or a set\")\n  1314\t                        {:binding-form out, :returned ret, :clause clause})))\n  1315\t      (case kind\n  1316\t        :tuple (if-let [b (unify-tuple binding out ret clause)] [b] [])\n  1317\t        :coll (let [term (first out)]\n  1318\t                (into [] (keep #(unify binding term %)) ret))\n  1319\t        :relation (into [] (keep #(unify-tuple binding terms % clause)) ret)))))\n  1320\t\n  1321\t\n  1322\t(defn- eval-fn-clause\n  1323\t  [clause binding ctx]\n  1324