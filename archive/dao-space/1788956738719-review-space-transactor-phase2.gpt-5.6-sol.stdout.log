tes surfaces, never retention (D2/T18): stream/reader? and\n+   stream/writer? check the dao.stream reader and writer surfaces, and\n+   neither establishes the complete-retention transport the history scan\n+   requires. The host composition supplies a handle created by\n+   dao.stream.memory-log/create!; supplying an evicting transport is a\n+   host-assembly defect — detectable, deliberately not checked, because a\n+   type check would couple dao.space to memory-log by name and reject a\n+   future correct complete-retention transport.\"\n+  [spec]\n+  (let [{:keys [local-stream intake-pool name]} spec]\n+    (when (contains? spec :next-t)\n       (throw\n         (ex-info\n-          \":transactor derives transaction time from retained history; :next-t is not accepted\"\n-          {:descriptor descriptor})))\n-    (when-not (and (satisfies? ds/IDaoStreamReader local-stream)\n-                   (satisfies? ds/IDaoStreamWriter local-stream))\n+          \"the transactor derives transaction time from retained history; :next-t is not accepted\"\n+          {:spec spec})))\n+    (when-not (and (stream/reader? local-stream)\n+                   (stream/writer? local-stream))\n       (throw\n         (ex-info\n-          \":transactor descriptor requires a :local-stream satisfying IDaoStreamReader and IDaoStreamWriter\"\n-          {:descriptor descriptor})))\n+          \"transactor spec requires a :local-stream satisfying the dao.stream reader and writer surfaces\"\n+          {:spec spec})))\n     (when-not (and (coll? intake-pool) (seq intake-pool))\n       (throw\n         (ex-info\n-          \":transactor descriptor requires a non-empty :intake-pool of streams satisfying the dao.stream writer surface\"\n-          {:descriptor descriptor})))\n+          \"transactor spec requires a non-empty :intake-pool of streams satisfying the dao.stream writer surface\"\n+          {:spec spec})))\n     (doseq [intake intake-pool]\n       (when-not (stream/writer? intake)\n         (throw\n           (ex-info\n-            \":transactor :intake-pool members must satisfy IDaoStreamWriter\"\n+            \"transactor :intake-pool members must satisfy IDaoStreamWriter\"\n             {:intake-pool intake-pool}))))\n-    (let [next-t (derive-next-t (index/snapshot-datoms local-stream))]\n-      (->DaoStreamLog local-stream\n-                      intake-pool\n-                      stream-name\n-                      (atom next-t)\n-                      (atom {:closed false})))))\n-\n-\n-(defn publish!\n-  \"Build and enqueue the covered indexes over the local stream into the\n-   intake pool (dao.space.index/publish-index!), returning its\n-   {:manifest-address ... :manifest ...}. opts are passed through to\n-   publish-index! (e.g. :branching-factor, :select-stream). Publication is\n-   explicit and acknowledges enqueuing only, never observer\n-   materialization.\"\n-  ([log] (publish! log nil))\n-  ([^DaoStreamLog log opts]\n-   (index/publish-index! (.-local-stream log) (.-intake-pool log) opts)))\n+    (let [t (derive-next-t (index/snapshot-datoms local-stream))]\n+      {:dao.space/transactor true\n+       :local-stream local-stream\n+       :intake-pool intake-pool\n+       :name (or name \"transactor\")\n+       :next-t (atom t)\n+       :state (atom {:closed false})})))\n+\n+\n+(defn append!\n+  \"Append one entity map or datom vector as a single atomic transaction.\n+   Answers the v2 receipt on ok — {:dao.stream/outcome :dao.stream/ok\n+   :dao.space/t t :dao.space/datoms datoms} — the local append's conforming\n+   outcome as data otherwise (watermark unchanged, same t still pending),\n+   and {:dao.stream/outcome :dao.stream/closed} on a closed transactor.\n+   A malformed value still throws: it is a defect in the caller's own\n+   argument, detected before any stream is touched.\"\n+  [log val]\n+  (let [{:keys [local-stream next-t state]} log]\n+    (with-write-lock\n+      next-t\n+      (fn []\n+        (if (:closed @state)\n+          {:dao.stream/outcome :dao.stream/closed}\n+          (let [t @next-t\n+                datoms (val->datoms val t)]\n+            (when (empty? datoms)\n+              (throw (ex-info \"append! produced no datoms\" {:val val})))\n+            (append-packet! local-stream next-t t datoms)))))))\n \n \n (defn transact!\n   \"Commits a non-empty collection of entity maps or datom vectors as a\n   single atomic transaction: every datom shares one allocated t and lands\n-   in one transaction record through exactly one ds/append!, so no partial\n-   prefix is possible. Throws when the stream is closed, the collection is\n-   empty, any item is invalid, or the expansion yields no datoms.\"\n-  [^DaoStreamLog log tx-data]\n+  in one transaction record through exactly one local append, so no partial\n+  prefix is possible. Answers the v2 receipt on ok, the local append's\n+  conforming outcome as data otherwise, and\n+  {:dao.stream/outcome :dao.stream/closed} on a closed transactor. Throws\n+  when the collection is empty, any item is invalid, or the expansion\n+  yields no datoms.\"\n+  [log tx-data]\n   (when (empty? tx-data)\n     (throw (ex-info \"transact! requires at least one transaction item\"\n                     {:tx-data tx-data})))\n-  (let [next-t (.-next-t log)]\n+  (let [{:keys [local-stream next-t state]} log]\n+    (with-write-lock\n+      next-t\n+      (fn []\n+        (if (:closed @state)\n+          {:dao.stream/outcome :dao.stream/closed}\n+          (let [t @next-t\n+                datoms (into [] (mapcat #(val->datoms % t)) tx-data)]\n+            (when (empty? datoms)\n+              (throw (ex-info \"transact! produced no datoms\" {:tx-data tx-data})))\n+            (append-packet! local-stream next-t t datoms)))))))\n+\n+\n+(defn close!\n+  \"Close this transactor value: further append!/transact! answer\n+   {:dao.stream/outcome :dao.stream/closed} rather than throwing. Per\n+   value — neither the local stream nor the intake pool is closed or\n+   erased. Idempotent; linearizes after an in-flight append.\"\n+  [log]\n+  (let [{:keys [next-t state]} log]\n     (with-write-lock\n       next-t\n       (fn []\n-        (when (ds/closed? log)\n-          (throw (ex-info \"Cannot transact! to closed stream\"\n-                          {:name (.-stream-name log)})))\n-        (let [t @next-t\n-              datoms (into [] (mapcat #(val->datoms % t)) tx-data)]\n-          (when (empty? datoms)\n-            (throw (ex-info \"transact! produced no datoms\" {:tx-data tx-data})))\n-          (append-packet! (.-local-stream log) next-t t datoms \"transact!\"))))))\n+        (swap! state assoc :closed true)\n+        {:dao.stream/outcome :dao.stream/ok}))))\n+\n+\n+(defn publish!\n+  \"Build and enqueue the covered indexes over the local stream into the\n+   intake pool (dao.space.index/publish-index!), returning its\n+   {:manifest-address ... :manifest ...}. opts are passed through to\n+   publish-index! (e.g. :branching-factor, :select-stream). Publication is\n+   explicit and acknowledges enqueuing only, never observer\n+   materialization.\"\n+  ([log] (publish! log nil))\n+  ([log opts]\n+   (index/publish-index! (:local-stream log) (:intake-pool log) opts)))\n     1\t(ns dao.space.transactor\n     2\t  \"The agent-side transactor: a plain value with explicit named operations\n     3\t   over an explicit local dao.stream handle plus an explicit intake pool\n     4\t   of dao.stream writers (docs/design/dao.jing.md, Publication from an\n     5\t   agent; docs/design/dao.space.transactor.md).\n     6\t\n     7\t   A transactor is not a stream in v2 — it is an interpreter over one\n     8\t   (dao.stream.md, Composition): append!/transact! allocate transaction time\n     9\t   and write transaction records through the local stream's writer surface,\n    10\t   and reads go through the caller's own local handle, which the transactor\n    11\t   never owns.\n    12\t\n    13\t   Spec (create!):\n    14\t\n    15\t     {:local-stream s   ; must satisfy stream/reader? and stream/writer?;\n    16\t                        ; supplied, never created, registered, or closed\n    17\t      :intake-pool [p]  ; non-empty; every member satisfies stream/writer?;\n    18\t                        ; supplied, never created, registered, or closed\n    19\t      :name n}          ; optional, diagnostic only\n    20\t\n    21\t   create! validates surfaces, never retention: stream/reader? and\n    22\t   stream/writer? do not establish the complete retention the history scan\n    23\t   requires. The host composition supplies a handle created by\n    24\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n    25\t   host-assembly defect (detectable, deliberately not checked — T18,\n    26\t   docs/design/dao.space.transactor.md).\n    27\t\n    28\t   The transactor owns transaction time. Every append! or transact! writes\n    29\t   exactly ONE atomic transaction record to the local stream\n    30\t\n    31\t     {:dao.space/transaction {:t <nonnegative-integer> :datoms [...]}}\n    32\t\n    33\t   through exactly one local append, so no reader can ever observe a torn\n    34\t   transaction. t is allocated from a per-value watermark: on create! the\n    35\t   retained history is read from its origin (index/snapshot-datoms) and the\n    36\t   next t is derived as 0 for an empty history or 1 + the maximum integer\n    37\t   datom t otherwise. A malformed history throws. The scan is the causality\n    38\t   boundary; a caller-supplied next-t is never accepted.\n    39\t\n    40\t   Operational outcomes are data; argument defects keep throwing. The\n    41\t   watermark advances if and only if the local append answered\n    42\t   :dao.stream/ok, so retrying the identical call re-attempts the identical\n    43\t   t. publish! builds the covered indexes over the local stream and\n    44\t   enqueues them into the intake pool (dao.space.index/publish-index!).\n    45\t   Publication is explicit and acknowledges enqueuing only, never observer\n    46\t   materialization.\n    47\t\n    48\t   Closing is per value: it rejects further appends/transacts with\n    49\t   {:dao.stream/outcome :dao.stream/closed} but neither closes nor erases\n    50\t   the local stream or the intake pool.\"\n    51\t  (:require [dao.datom :as datom]\n    52\t            [dao.space.index :as index]\n    53\t            [dao.stream :as stream]))\n    54\t\n    55\t\n    56\t(defn- entity->datoms\n    57\t  \"One datom per k/v pair, all sharing transaction time `t`. `:db/id` is\n    58\t   required: a durable log cannot mint per-batch tempids without colliding\n    59\t   across appends. Attribute order within one entity's own datoms is\n    60\t   whatever the host's map iteration yields — unspecified across platforms.\"\n    61\t  [m t]\n    62\t  (when-not (contains? m :db/id)\n    63\t    (throw (ex-info \"entity map requires :db/id\" {:entity m})))\n    64\t  (let [e (:db/id m)]\n    65\t    (mapv (fn [[a v]]\n    66\t            (let [d [e a v t datom/default-op]]\n    67\t              (when-not (datom/local-datom? d)\n    68\t                (throw (ex-info \"invalid persistent local datom\"\n    69\t                                {:datom d, :entity m})))\n    70\t              d))\n    71\t          (remove (fn [[a _v]] (= a :db/id)) m))))\n    72\t\n    73\t\n    74\t(defn- pad-datom\n    75\t  \"Pad [e a v] / [e a v t m] to the canonical 5-tuple. The transactor owns\n    76\t   transaction time: a non-nil explicit t is rejected, a nil t is stamped\n    77\t   with the allocated `t`. A nil m takes the default assertion op; an\n    78\t   explicit m (0, a retraction) is preserved.\"\n    79\t  [d t]\n    80\t  (let [[e a v dt dm] d]\n    81\t    (when-not (nil? dt)\n    82\t      (throw\n    83\t        (ex-info\n    84\t          \"the transactor owns transaction time: explicit datom t is rejected\"\n    85\t          {:datom d})))\n    86\t    (let [padded [e a v t (if (nil? dm) datom/default-op dm)]]\n    87\t      (when-not (datom/local-datom? padded)\n    88\t        (throw (ex-info \"invalid persistent local datom\"\n    89\t                        {:datom padded, :input d})))\n    90\t      padded)))\n    91\t\n    92\t\n    93\t(defn- val->datoms\n    94\t  [val t]\n    95\t  (cond\n    96\t    (map? val) (entity->datoms val t)\n    97\t    (and (vector? val) (<= 3 (count val) 5)) [(pad-datom val t)]\n    98\t    :else\n    99\t    (throw\n   100\t      (ex-info\n   101\t        \"a value must be an entity map or datom vector [e a v] / [e a v nil m]\"\n   102\t        {:val val}))))\n   103\t\n   104\t\n   105\t#_{:clj-kondo/ignore [:unused-binding]}\n   106\t\n   107\t\n   108\t(defn- with-write-lock\n   109\t  \"Serialize timestamp allocation and append on hosts with shared-memory\n   110\t   threads. ClojureScript and ClojureDart calls are synchronous within one\n   111\t   isolate, so the direct call has the same single-writer semantics.\"\n   112\t  [lock f]\n   113\t  #?(:clj (locking lock (f))\n   114\t     :default (f)))\n   115\t\n   116\t\n   117\t(defn- derive-next-t\n   118\t  \"Derive the next transaction time from a flattened retained history: 0 for\n   119\t   an empty history, else 1 + the maximum datom t. A datom t that is not a\n   120\t   non-negative integer is a malformed history and throws — this scan is the\n   121\t   causality boundary of the value.\"\n   122\t  [datoms]\n   123\t  (if (empty? datoms)\n   124\t    0\n   125\t    (let [ts (mapv index/datom-t datoms)]\n   126\t      (when-not (every? #(and (integer? %) (<= 0 %)) ts)\n   127\t        (throw\n   128\t          (ex-info\n   129\t            \"malformed retained history: datom t must be a non-negative integer\"\n   130\t            {:history datoms})))\n   131\t      (inc (reduce max ts)))))\n   132\t\n   133\t\n   134\t(defn- append-packet!\n   135\t  \"Append one atomic transaction record to the local stream. The answer is\n   136\t   validated with the contract's own validator before it is interpreted:\n   137\t   :dao.stream/ok advances the watermark and returns the v2 receipt; any\n   138\t   other conforming outcome is returned as data with the watermark\n   139\t   unchanged, so the same t is still pending and retrying the identical\n   140\t   call re-attempts it; a non-outcome answer is folded to\n   141\t   :dao.stream/transport-error with the raw answer retained under\n   142\t   :dao.stream/answer.\"\n   143\t  [local-stream next-t t datoms]\n   144\t  (let [record {:dao.space/transaction {:t t, :datoms datoms}}\n   145\t        answer (stream/append! local-stream record)]\n   146\t    (if-not (stream/valid-outcome? :append! answer)\n   147\t      {:dao.stream/outcome :dao.stream/transport-error\n   148\t       :dao.stream/answer answer}\n   149\t      (do (when (= :dao.stream/ok (:dao.stream/outcome answer))\n   150\t            (swap! next-t inc))\n   151\t          (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   152\t            {:dao.stream/outcome :dao.stream/ok\n   153\t             :dao.space/t t\n   154\t             :dao.space/datoms datoms}\n   155\t            answer)))))\n   156\t\n   157\t\n   158\t(defn create!\n   159\t  \"Create a transactor value from a spec — the value, or a throw: the\n   160\t   failure modes are a malformed spec and a malformed retained history,\n   161\t   both of which a caller can only abort on.\n   162\t\n   163\t   Validates surfaces, never retention (D2/T18): stream/reader? and\n   164\t   stream/writer? check the dao.stream reader and writer surfaces, and\n   165\t   neither establishes the complete-retention transport the history scan\n   166\t   requires. The host composition supplies a handle created by\n   167\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n   168\t   host-assembly defect — detectable, deliberately not checked, because a\n   169\t   type check would couple dao.space to memory-log by name and reject a\n   170\t   future correct complete-retention transport.\"\n   171\t  [spec]\n   172\t  (let [{:keys [local-stream intake-pool name]} spec]\n   173\t    (when (contains? spec :next-t)\n   174\t      (throw\n   175\t        (ex-info\n   176\t          \"the transactor derives transaction time from retained history; :next-t is not accepted\"\n   177\t          {:spec spec})))\n   178\t    (when-not (and (stream/reader? local-stream)\n   179\t                   (stream/writer? local-stream))\n   180\t      (throw\n   181\t        (ex-info\n   182\t          \"transactor spec requires a :local-stream satisfying the dao.stream reader and writer surfaces\"\n   183\t          {:spec spec})))\n   184\t    (when-not (and (coll? intake-pool) (seq intake-pool))\n   185\t      (throw\n   186\t        (ex-info\n   187\t          \"transactor spec requires a non-empty :intake-pool of streams satisfying the dao.stream writer surface\"\n   188\t          {:spec spec})))\n   189\t    (doseq [intake intake-pool]\n   190\t      (when-not (stream/writer? intake)\n   191\t        (throw\n   192\t          (ex-info\n   193\t            \"transactor :intake-pool members must satisfy IDaoStreamWriter\"\n   194\t            {:intake-pool intake-pool}))))\n   195\t    (let [t (derive-next-t (index/snapshot-datoms local-stream))]\n   196\t      {:dao.space/transactor true\n   197\t       :local-stream local-stream\n   198\t       :intake-pool intake-pool\n   199\t       :name (or name \"transactor\")\n   200\t       :next-t (atom t)\n   201\t       :state (atom {:closed false})})))\n   202\t\n   203\t\n   204\t(defn append!\n   205\t  \"Append one entity map or datom vector as a single atomic transaction.\n   206\t   Answers the v2 receipt on ok — {:dao.stream/outcome :dao.stream/ok\n   207\t   :dao.space/t t :dao.space/datoms datoms} — the local append's conforming\n   208\t   outcome as data otherwise (watermark unchanged, same t still pending),\n   209\t   and {:dao.stream/outcome :dao.stream/closed} on a closed transactor.\n   210\t   A malformed value still throws: it is a defect in the caller's own\n   211\t   argument, detected before any stream is touched.\"\n   212\t  [log val]\n   213\t  (let [{:keys [local-stream next-t state]} log]\n   214\t    (with-write-lock\n   215\t      next-t\n   216\t      (fn []\n   217\t        (if (:closed @state)\n   218\t          {:dao.stream/outcome :dao.stream/closed}\n   219\t          (let [t @next-t\n   220\t                datoms (val->datoms val t)]\n   221\t            (when (empty? datoms)\n   222\t              (throw (ex-info \"append! produced no datoms\" {:val val})))\n   223\t            (append-packet! local-stream next-t t datoms)))))))\n   224\t\n   225\t\n   226\t(defn transact!\n   227\t  \"Commits a non-empty collection of entity maps or datom vectors as a\n   228\t  single atomic transaction: every datom shares one allocated t and lands\n   229\t  in one transaction record through exactly one local append, so no partial\n   230\t  prefix is possible. Answers the v2 receipt on ok, the local append's\n   231\t  conforming outcome as data otherwise, and\n   232\t  {:dao.stream/outcome :dao.stream/closed} on a closed transactor. Throws\n   233\t  when the collection is empty, any item is invalid, or the expansion\n   234\t  yields no datoms.\"\n   235\t  [log tx-data]\n   236\t  (when (empty? tx-data)\n   237\t    (throw (ex-info \"transact! requires at least one transaction item\"\n   238\t                    {:tx-data tx-data})))\n   239\t  (let [{:keys [local-stream next-t state]} log]\n   240\t    (with-write-lock\n   241\t      next-t\n   242\t      (fn []\n   243\t        (if (:closed @state)\n   244\t          {:dao.stream/outcome :dao.stream/closed}\n   245\t          (let [t @next-t\n   246\t                datoms (into [] (mapcat #(val->datoms % t)) tx-data)]\n   247\t            (when (empty? datoms)\n   248\t              (throw (ex-info \"transact! produced no datoms\" {:tx-data tx-data})))\n   249\t            (append-packet! local-stream next-t t datoms)))))))\n   250\t\n   251\t\n   252\t(defn close!\n   253\t  \"Close this transactor value: further append!/transact! answer\n   254\t   {:dao.stream/outcome :dao.stream/closed} rather than throwing. Per\n   255\t   value — neither the local stream nor the intake pool is closed or\n   256\t   erased. Idempotent; linearizes after an in-flight append.\"\n   257\t  [log]\n   258\t  (let [{:keys [next-t state]} log]\n   259\t    (with-write-lock\n   260\t      next-t\n   261\t      (fn []\n   262\t        (swap! state assoc :closed true)\n   263\t        {:dao.stream/outcome :dao.stream/ok}))))\n   264\t\n   265\t\n   266\t(defn publish!\n   267\t  \"Build and enqueue the covered indexes over the local stream into the\n   268\t   intake pool (dao.space.index/publish-index!), returning its\n   269\t   {:manifest-address ... :manifest ...}. opts are passed through to\n   270\t   publish-index! (e.g. :branching-factor, :select-stream). Publication is\n   271\t   explicit and acknowledges enqueuing only, never observer\n   272\t   materialization.\"\n   273\t  ([log] (publish! log nil))\n   274\t  ([log opts]\n   275\t   (index/publish-index! (:local-stream log) (:intake-pool log) opts)))\n   430\t      (and (vector? payload) (= 5 (count payload)))\n   431\t      (throw\n   432\t        (ex-info\n   433\t          \"malformed local datom: e and t must be non-negative integers, m an integer, and a a namespaced keyword\"\n   434\t          {:datom payload}))\n   435\t      :else\n   436\t      (throw\n   437\t        (ex-info\n   438\t          \"local stream payload must be a datom or dao.space transaction record\"\n   439\t          {:payload payload})))))\n   440\t\n   441\t\n   442\t(defn datoms-from-elements\n   443\t  \"Flatten a seq of local-stream elements to canonical local d5 datoms —\n   444\t   the payload vocabulary's public, seq-level spelling. Each element is\n   445\t   validated and flattened by the same per-element rule snapshot-datoms\n   446\t   applies inside its read loop: a canonical datom vector passes through, an\n   447\t   atomic {:dao.space/transaction {:t n :datoms [...]}} record flattens to\n   448\t   its datoms, and anything malformed throws.\"\n   449\t  [elements]\n   450\t  (into [] (mapcat element-datoms) elements))\n   451\t\n   452\t\n   453\t(defn- checked\n   454\t  \"Fold a defective result into an exception before anything is read from it.\n   455\t   The contract's own validator (dao.stream/validate-outcome) answers nil\n   456\t   for a conforming result and a defect map otherwise; interpreting an\n   457\t   unvalidated result is how a loop ends up recurring on a nil cursor.\"\n   458\t  [operation result]\n   459\t  (if-let [defect (stream/validate-outcome operation result)]\n   460\t    (throw (ex-info \"malformed local stream result\"\n   461\t                    {:operation operation, :result result, :defect defect}))\n   462\t    result))\n   463\t\n   464\t\n   465\t(defn snapshot-datoms\n   466\t  \"Read an agent-local stream in full and flatten it to canonical local d5\n   467\t   datoms.\n   468\t\n   469\t   The local stream is on a complete-retention transport\n   470\t   (dao.stream.memory-log), so a fresh :oldest cursor is the origin and\n   471\t   `gap` cannot occur — completeness comes from the transport's declared\n   472\t   retention, never from the anchor (dao.stream.md, *Complete history*).\n   473\t   `blocked` (an open stream caught up) and `end` (a closed one fully read)\n   474\t   finish the read at the tail. Each element is validated and flattened as it\n   475\t   is read, so the first defect in stream order is the one reported and no\n   476\t   read happens past it. A well-formed but unexpected outcome means the handle\n   477\t   is not the transport the composition owes.\"\n   478\t  [local-stream]\n   479\t  (let [mint (checked :cursor (stream/cursor local-stream :dao.stream/oldest))]\n   480\t    (when-not (= :dao.stream/ok (:dao.stream/outcome mint))\n   481\t      (throw (ex-info \"local stream refused an :oldest cursor\" {:result mint})))\n   482\t    (loop [cursor (:dao.stream/cursor mint)\n   483\t           datoms []]\n   484\t      (let [r (checked :next (stream/next local-stream cursor))]\n   485\t        (case (:dao.stream/outcome r)\n   486\t          :dao.stream/ok\n   487\t          (recur (:dao.stream/cursor r)\n   488\t                 (into datoms (element-datoms (:dao.stream/value r))))\n   489\t          (:dao.stream/blocked :dao.stream/end) datoms\n   490\t          (throw (ex-info \"local stream is not a complete-retention transport\"\n   491\t                          {:outcome (:dao.stream/outcome r), :result r})))))))\n   492\t\n   493\t\n   494\t(defn- recording-content-handle\n   495\t  \"Temporary in-memory content store for the publish build. :put-content-fn\n   496\t   records each unique node blob on first insertion (answering :present for\n   497\t   duplicates, so the recorded order is first-insertion order, deduplicated);\n   498\t   :get-content-fn reads recorded blobs back. Addresses are minted by\n   499\t   jing/materialize! through dao.data.btree.storage/kv-storage, so the\n   500\t   recorded order is exactly the store-tree children-before-parent traversal.\n   501\t   The handle is a build-time value: no global state is introduced.\"\n   502\t  []\n   503\t  (let [state (atom {:content {}, :order []})]\n   504\t    {:state state,\n   505\t     :put-content-fn (fn [address payload]\n   506\t                       (if (contains? (:content @state) address)\n   507\t                         :present\n   508\t                         (do (swap! state\n   509\t                                    (fn [s]\n   510\t                                      (-> s\n   511\t                                          (assoc-in [:content address] payload)\n   512\t                                          (update :order conj [address payload]))))\n   513\t                             :inserted))),\n   514\t     :get-content-fn (fn [address not-found]\n   515\t                       (get-in @state [:content address] not-found))}))\n   925\t    schema\n   926\t    (let [rows (index/snapshot-datoms local-stream)\n   927\t          t (next-transaction-time rows)]\n   928\t      (extract-schema (into rows (map #(stamp-candidate t %) datoms))))))\n   929\t\n   930\t\n   931\t#_{:clj-kondo/ignore [:unused-binding]}\n   932\t\n   933\t\n   934\t(defn- with-write-lock\n   935\t  \"Serialize one wrapper's validate -> append -> state transition. The state\n   936\t   atom is a private per-wrapper coordination handle, never global state.\"\n   937\t  [lock f]\n   938\t  #?(:clj (locking lock (f))\n   939\t     :default (f)))\n   940\t\n   941\t\n   942\t(deftype SchemaWrapper\n   943\t  [inner local-stream strict? state]\n   944\t\n   945\t  ds/IDaoStreamBound\n   946\t\n   947\t  (close!\n   948\t    [_]\n   949\t    (with-write-lock\n   950\t      state\n   951\t      #(do (swap! state assoc :closed true)\n   952\t           (tx/close! inner)\n   953\t           {:woke []})))\n   954\t\n   955\t\n   956\t  (closed?\n   957\t    [_]\n   958\t    (:closed @state)))\n   959\t\n   960\t\n   961\t(defn transactor\n   962\t  \"Open a schema-validating wrapper over a local stream and intake pool.\n   963\t   opts: {:strict true} for strict mode (default lax). OWNS the inner\n   964\t   transactor value; closing the wrapper delegates inward and returns\n   965\t   {:woke []}. The wrapper owns its own closedness flag — the inner\n   966\t   transactor has no closed? to delegate to.\"\n   967\t  ([local-stream intake-pool]\n   968\t   (transactor local-stream intake-pool nil))\n   969\t  ([local-stream intake-pool opts]\n   970\t   (let [strict? (boolean (:strict opts))\n   971\t         inner (tx/create! {:local-stream local-stream\n   972\t                            :intake-pool intake-pool\n   973\t                            :name \"schema\"})\n   974\t         rows (index/snapshot-datoms local-stream)\n   975\t         schema (extract-schema rows)]\n   976\t     (->SchemaWrapper inner local-stream strict?\n   977\t                      (atom (rows->state rows schema strict?))))))\n   978\t\n   979\t\n   980\t(defn- contains-schema-row?\n   981\t  \"True when any datom in the batch has an attribute that is one of the\n   982\t   five :db/* property names.\"\n   983\t  [datoms]\n   984\t  (some (fn [d] (schema-row? (second d))) datoms))\n   985\t\n   986\t\n   987\t(defn- validate-record-ops!\n   988\t  \"Reject item-order ambiguity between assertion and retraction for one EAV.\n   989\t   Persisted current-state semantics treats same-t opposite operations as\n   990\t   conflicting history, so such a record cannot cross the append boundary.\"\n   991\t  [datoms]\n   992\t  (reduce\n   993\t    (fn [ops d]\n   994\t      (let [eav (subvec (vec d) 0 3)\n   995\t            op (if (= 5 (count d)) (nth d 4) datom/default-op)]\n   996\t        (when (and (contains? ops eav) (not= (get ops eav) op))\n   997\t          (throw (ex-info (str \"opposite operations on one EAV in a single \"\n   998\t                               \"transaction: \" (pr-str eav))\n   999\t                          {:eav eav, :operations #{(get ops eav) op}})))\n  1000\t        (assoc ops eav op)))\n  1001\t    {}\n  1002\t    datoms)\n  1003\t  nil)\n  1004\t\n  1005\t\n  1006\t(defn- translated-op\n  1007\t  [d]\n  1008\t  (if (= 5 (count d)) (nth d 4) datom/default-op))\n  1009\t\n  1010\t\n  1011\t(defn- validate-axiom-datoms!\n  1012\t  \"Protect axiom entities using the complete translated record. Looking at\n  1013\t   the whole record makes the rule independent of item order: an axiom ident\n  1014\t   declared in this record protects every row on that entity in this record.\"\n  1015\t  [datoms state]\n  1016\t  (let [established\n  1017\t        (reduce-kv\n  1018\t          (fn [m [e a] values]\n  1019\t            (if (= :db/ident a)\n  1020\t              (reduce (fn [acc ident]\n  1021\t                        (if (contains? axioms ident)\n  1022\t                          (update acc e (fnil conj #{}) ident)\n  1023\t                          acc))\n  1024\t                      m\n  1025\t                      values)\n  1026\t              m))\n  1027\t          {}\n  1028\t          (:values state))\n  1029\t        axiom-idents\n  1030\t        (reduce\n  1031\t          (fn [m d]\n  1032\t            (let [[e a v] d]\n  1033\t              (if (and (= :db/ident a)\n  1034\t                       (= datom/default-op (translated-op d))\n  1035\t                       (contains? axioms v))\n  1036\t                (update m e (fnil conj #{}) v)\n  1037\t                m)))\n  1038\t          established\n  1039\t          datoms)]\n  1040\t    (doseq [[e idents] axiom-idents]\n  1041\t      (when (< 1 (count idents))\n  1042\t        (throw (ex-info (str \"axiom protection: entity \" (pr-str e)\n  1043\t                             \" cannot name multiple axioms \"\n  1044\t                             (pr-str idents))\n  1045\t                        {:entity e, :idents idents}))))\n  1046\t    (doseq [d datoms\n  1047\t            :let [[e a v] d\n  1048\t                  ident (first (get axiom-idents e))]\n  1049\t            :when ident]\n  1050\t      (let [expected (assoc (get axioms ident) :db/ident ident)]\n  1051\t        (when (or (not= datom/default-op (translated-op d))\n  1052\t                  (not (contains? expected a))\n  1053\t                  (not= (get expected a) v))\n  1054\t          (throw (ex-info (str \"axiom protection: \" (pr-str ident)\n  1055\t                               \" permits only its verbatim axiom facts, got \"\n  1056\t                               (pr-str [e a v]))\n  1057\t                          {:entity e, :ident ident, :attr a, :value v,\n  1058\t                           :expected (get expected a),\n  1059\t                           :operation (translated-op d)}))))))\n  1060\t  nil)\n  1061\t\n  1062\t\n  1063\t(defn transact!\n  1064\t  \"Translate, validate, and commit tx-data as one atomic record. Returns\n  1065\t   {:result :ok :t t :datoms datoms} on success — schema's v1 public shape,\n  1066\t   kept until schema's own plan (D10) — and the inner transactor's\n  1067\t   conforming non-ok outcome map unchanged otherwise. One per-wrapper\n  1068\t   serialized transition plans and validates the complete next state before\n  1069\t   the single append, then installs that already-planned state only when the\n  1070\t   append answered :dao.stream/ok; a failed or thrown append leaves the\n  1071\t   wrapper's schema, uniqueness, and current-value state exactly as it was.\n  1072\t   Schema changes become effective for the next transaction.\"\n  1073\t  [^SchemaWrapper wrapper tx-data]\n  1074\t  (let [lock (.-state wrapper)]\n  1075\t    (with-write-lock\n  1076\t      lock\n  1077\t      (fn []\n  1078\t        (when (ds/closed? wrapper)\n  1079\t          (throw (ex-info \"cannot transact! on closed wrapper\" {})))\n  1080\t        (when (empty? tx-data)\n  1081\t          (throw (ex-info \"transact! requires at least one item\"\n  1082\t                          {:tx-data tx-data})))\n  1083\t        (let [st @lock\n  1084\t              schema (:schema st)\n  1085\t              strict? (.-strict? wrapper)\n  1086\t              translated\n  1087\t              (loop [items (vec tx-data)\n  1088\t                     datoms []\n  1089\t                     state st]\n  1090\t                (if (empty? items)\n  1091\t                  {:datoms datoms, :state state}\n  1092\t                  (let [item (first items)\n  1093\t                        result (translate-record item state schema strict?)]\n  1094\t                    ;; Both-mode schema structure validation is part of the\n  1095\t                    ;; plan, before any append can occur.\n  1096\t                    (doseq [d (:datoms result)]\n  1097\t                      (validate-schema-row! (nth d 0) (nth d 1) (nth d 2)\n  1098\t                                            (:state result)))\n  1099\t                    (recur (rest items)\n  1100\t                           (into datoms (:datoms result))\n  1101\t                           (:state result)))))\n  1102\t              datoms (:datoms translated)]\n  1103\t          (when (empty? datoms)\n  1104\t            (throw (ex-info \"transact! produced no datoms\"\n  1105\t                            {:tx-data tx-data})))\n  1106\t          (validate-record-ops! datoms)\n  1107\t          (validate-axiom-datoms! datoms st)\n  1108\t          (let [schema-change? (boolean (contains-schema-row? datoms))\n  1109\t                next-schema (proposed-schema (.-local-stream wrapper)\n  1110\t                                             schema\n  1111\t                                             datoms)\n  1112\t                _ (validate-unique-card-one! next-schema)\n  1113\t                next-state (if schema-change?\n  1114\t                             (reindex-state (:state translated)\n  1115\t                                            next-schema\n  1116\t                                            strict?)\n  1117\t                             (-> (:state translated)\n  1118\t                                 (dissoc :datoms)\n  1119\t                                 (assoc :schema next-schema\n  1120\t                                        :strict? strict?)))\n  1121\t                result (tx/transact! (.-inner wrapper) datoms)]\n  1122\t            (if (= :dao.stream/ok (:dao.stream/outcome result))\n  1123\t              (do (reset! lock next-state)\n  1124\t                  {:result :ok\n  1125\t                   :t (:dao.space/t result)\n  1126\t                   :datoms (:dao.space/datoms result)})\n  1127\t              result)))))))\n  1128\t\n  1129\t\n  1130\t;; =============================================================================\n  1131\t;; Publisher: publish! and published descriptor (§5)\n  1132\t;; =============================================================================\n  1133\t\n  1134\t(defn publish!\n  1135\t  \"Build and enqueue covered indexes over the wrapper's local stream.\n  1136\t   Thin passthrough to the inner handle's dao.space.transactor/publish!.\n  1137\t   Returns {:manifest-address ... :manifest ...}. The closedness guard is\n  1138\t   serialized with tx/publish! under the wrapper lock, so a concurrent\n  1139\t   close cannot land between the check and the publication — the cost is\n  1140\t   that the lock is held across an index build, and on a single-writer\n  1141\t   wrapper a concurrent transact! would serialize against the publish's\n  1142\t   snapshot anyway.\"\n  1143\t  ([^SchemaWrapper wrapper] (publish! wrapper nil))\n  1144\t  ([^SchemaWrapper wrapper opts]\n  1145\t   (let [lock (.-state wrapper)]\n  1146\t     (with-write-lock\n  1147\t       lock\n  1148\t       (fn []\n  1149\t         (when (:closed @lock)\n  1150\t           (throw (ex-info \"cannot publish! on closed wrapper\" {})))\n  1151\t         (tx/publish! (.-inner wrapper) opts))))))\n  1152\t\n  1153\t\n  1154\t(defn published\n  1155\t  \"Construct a §5 published descriptor for one immutable covered-index\n  1156\t   manifest. content-store is a serializable DaoJing coordinate (map with\n  1157\t   :dao.jing/type); manifest-address is a segment content address.\n  1158\t   Validates like index/published-index but carries the schema type.\"\n  1159\t  [content-store manifest-address]\n  1160\t  (when-not (and (map? content-store) (keyword? (:dao.jing/type content-store)))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/transactor.cljc | sed -n '1,310p'; git diff -- test/dao/space/transactor_test.cljc | sed -n '1,900p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/transactor.cljc | sed -n '1,310p'; git diff -- test/dao/space/transactor_test.cljc | sed -n '1,900p'\"","aggregated_output":"     1\t(ns dao.space.transactor\n     2\t  \"The agent-side transactor: a plain value with explicit named operations\n     3\t   over an explicit local dao.stream handle plus an explicit intake pool\n     4\t   of dao.stream writers (docs/design/dao.jing.md, Publication from an\n     5\t   agent; docs/design/dao.space.transactor.md).\n     6\t\n     7\t   A transactor is not a stream in v2 — it is an interpreter over one\n     8\t   (dao.stream.md, Composition): append!/transact! allocate transaction time\n     9\t   and write transaction records through the local stream's writer surface,\n    10\t   and reads go through the caller's own local handle, which the transactor\n    11\t   never owns.\n    12\t\n    13\t   Spec (create!):\n    14\t\n    15\t     {:local-stream s   ; must satisfy stream/reader? and stream/writer?;\n    16\t                        ; supplied, never created, registered, or closed\n    17\t      :intake-pool [p]  ; non-empty; every member satisfies stream/writer?;\n    18\t                        ; supplied, never created, registered, or closed\n    19\t      :name n}          ; optional, diagnostic only\n    20\t\n    21\t   create! validates surfaces, never retention: stream/reader? and\n    22\t   stream/writer? do not establish the complete retention the history scan\n    23\t   requires. The host composition supplies a handle created by\n    24\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n    25\t   host-assembly defect (detectable, deliberately not checked — T18,\n    26\t   docs/design/dao.space.transactor.md).\n    27\t\n    28\t   The transactor owns transaction time. Every append! or transact! writes\n    29\t   exactly ONE atomic transaction record to the local stream\n    30\t\n    31\t     {:dao.space/transaction {:t <nonnegative-integer> :datoms [...]}}\n    32\t\n    33\t   through exactly one local append, so no reader can ever observe a torn\n    34\t   transaction. t is allocated from a per-value watermark: on create! the\n    35\t   retained history is read from its origin (index/snapshot-datoms) and the\n    36\t   next t is derived as 0 for an empty history or 1 + the maximum integer\n    37\t   datom t otherwise. A malformed history throws. The scan is the causality\n    38\t   boundary; a caller-supplied next-t is never accepted.\n    39\t\n    40\t   Operational outcomes are data; argument defects keep throwing. The\n    41\t   watermark advances if and only if the local append answered\n    42\t   :dao.stream/ok, so retrying the identical call re-attempts the identical\n    43\t   t. publish! builds the covered indexes over the local stream and\n    44\t   enqueues them into the intake pool (dao.space.index/publish-index!).\n    45\t   Publication is explicit and acknowledges enqueuing only, never observer\n    46\t   materialization.\n    47\t\n    48\t   Closing is per value: it rejects further appends/transacts with\n    49\t   {:dao.stream/outcome :dao.stream/closed} but neither closes nor erases\n    50\t   the local stream or the intake pool.\"\n    51\t  (:require [dao.datom :as datom]\n    52\t            [dao.space.index :as index]\n    53\t            [dao.stream :as stream]))\n    54\t\n    55\t\n    56\t(defn- entity->datoms\n    57\t  \"One datom per k/v pair, all sharing transaction time `t`. `:db/id` is\n    58\t   required: a durable log cannot mint per-batch tempids without colliding\n    59\t   across appends. Attribute order within one entity's own datoms is\n    60\t   whatever the host's map iteration yields — unspecified across platforms.\"\n    61\t  [m t]\n    62\t  (when-not (contains? m :db/id)\n    63\t    (throw (ex-info \"entity map requires :db/id\" {:entity m})))\n    64\t  (let [e (:db/id m)]\n    65\t    (mapv (fn [[a v]]\n    66\t            (let [d [e a v t datom/default-op]]\n    67\t              (when-not (datom/local-datom? d)\n    68\t                (throw (ex-info \"invalid persistent local datom\"\n    69\t                                {:datom d, :entity m})))\n    70\t              d))\n    71\t          (remove (fn [[a _v]] (= a :db/id)) m))))\n    72\t\n    73\t\n    74\t(defn- pad-datom\n    75\t  \"Pad [e a v] / [e a v t m] to the canonical 5-tuple. The transactor owns\n    76\t   transaction time: a non-nil explicit t is rejected, a nil t is stamped\n    77\t   with the allocated `t`. A nil m takes the default assertion op; an\n    78\t   explicit m (0, a retraction) is preserved.\"\n    79\t  [d t]\n    80\t  (let [[e a v dt dm] d]\n    81\t    (when-not (nil? dt)\n    82\t      (throw\n    83\t        (ex-info\n    84\t          \"the transactor owns transaction time: explicit datom t is rejected\"\n    85\t          {:datom d})))\n    86\t    (let [padded [e a v t (if (nil? dm) datom/default-op dm)]]\n    87\t      (when-not (datom/local-datom? padded)\n    88\t        (throw (ex-info \"invalid persistent local datom\"\n    89\t                        {:datom padded, :input d})))\n    90\t      padded)))\n    91\t\n    92\t\n    93\t(defn- val->datoms\n    94\t  [val t]\n    95\t  (cond\n    96\t    (map? val) (entity->datoms val t)\n    97\t    (and (vector? val) (<= 3 (count val) 5)) [(pad-datom val t)]\n    98\t    :else\n    99\t    (throw\n   100\t      (ex-info\n   101\t        \"a value must be an entity map or datom vector [e a v] / [e a v nil m]\"\n   102\t        {:val val}))))\n   103\t\n   104\t\n   105\t#_{:clj-kondo/ignore [:unused-binding]}\n   106\t\n   107\t\n   108\t(defn- with-write-lock\n   109\t  \"Serialize timestamp allocation and append on hosts with shared-memory\n   110\t   threads. ClojureScript and ClojureDart calls are synchronous within one\n   111\t   isolate, so the direct call has the same single-writer semantics.\"\n   112\t  [lock f]\n   113\t  #?(:clj (locking lock (f))\n   114\t     :default (f)))\n   115\t\n   116\t\n   117\t(defn- derive-next-t\n   118\t  \"Derive the next transaction time from a flattened retained history: 0 for\n   119\t   an empty history, else 1 + the maximum datom t. A datom t that is not a\n   120\t   non-negative integer is a malformed history and throws — this scan is the\n   121\t   causality boundary of the value.\"\n   122\t  [datoms]\n   123\t  (if (empty? datoms)\n   124\t    0\n   125\t    (let [ts (mapv index/datom-t datoms)]\n   126\t      (when-not (every? #(and (integer? %) (<= 0 %)) ts)\n   127\t        (throw\n   128\t          (ex-info\n   129\t            \"malformed retained history: datom t must be a non-negative integer\"\n   130\t            {:history datoms})))\n   131\t      (inc (reduce max ts)))))\n   132\t\n   133\t\n   134\t(defn- append-packet!\n   135\t  \"Append one atomic transaction record to the local stream. The answer is\n   136\t   validated with the contract's own validator before it is interpreted:\n   137\t   :dao.stream/ok advances the watermark and returns the v2 receipt; any\n   138\t   other conforming outcome is returned as data with the watermark\n   139\t   unchanged, so the same t is still pending and retrying the identical\n   140\t   call re-attempts it; a non-outcome answer is folded to\n   141\t   :dao.stream/transport-error with the raw answer retained under\n   142\t   :dao.stream/answer.\"\n   143\t  [local-stream next-t t datoms]\n   144\t  (let [record {:dao.space/transaction {:t t, :datoms datoms}}\n   145\t        answer (stream/append! local-stream record)]\n   146\t    (if-not (stream/valid-outcome? :append! answer)\n   147\t      {:dao.stream/outcome :dao.stream/transport-error\n   148\t       :dao.stream/answer answer}\n   149\t      (do (when (= :dao.stream/ok (:dao.stream/outcome answer))\n   150\t            (swap! next-t inc))\n   151\t          (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   152\t            {:dao.stream/outcome :dao.stream/ok\n   153\t             :dao.space/t t\n   154\t             :dao.space/datoms datoms}\n   155\t            answer)))))\n   156\t\n   157\t\n   158\t(defn create!\n   159\t  \"Create a transactor value from a spec — the value, or a throw: the\n   160\t   failure modes are a malformed spec and a malformed retained history,\n   161\t   both of which a caller can only abort on.\n   162\t\n   163\t   Validates surfaces, never retention (D2/T18): stream/reader? and\n   164\t   stream/writer? check the dao.stream reader and writer surfaces, and\n   165\t   neither establishes the complete-retention transport the history scan\n   166\t   requires. The host composition supplies a handle created by\n   167\t   dao.stream.memory-log/create!; supplying an evicting transport is a\n   168\t   host-assembly defect — detectable, deliberately not checked, because a\n   169\t   type check would couple dao.space to memory-log by name and reject a\n   170\t   future correct complete-retention transport.\"\n   171\t  [spec]\n   172\t  (let [{:keys [local-stream intake-pool name]} spec]\n   173\t    (when (contains? spec :next-t)\n   174\t      (throw\n   175\t        (ex-info\n   176\t          \"the transactor derives transaction time from retained history; :next-t is not accepted\"\n   177\t          {:spec spec})))\n   178\t    (when-not (and (stream/reader? local-stream)\n   179\t                   (stream/writer? local-stream))\n   180\t      (throw\n   181\t        (ex-info\n   182\t          \"transactor spec requires a :local-stream satisfying the dao.stream reader and writer surfaces\"\n   183\t          {:spec spec})))\n   184\t    (when-not (and (coll? intake-pool) (seq intake-pool))\n   185\t      (throw\n   186\t        (ex-info\n   187\t          \"transactor spec requires a non-empty :intake-pool of streams satisfying the dao.stream writer surface\"\n   188\t          {:spec spec})))\n   189\t    (doseq [intake intake-pool]\n   190\t      (when-not (stream/writer? intake)\n   191\t        (throw\n   192\t          (ex-info\n   193\t            \"transactor :intake-pool members must satisfy IDaoStreamWriter\"\n   194\t            {:intake-pool intake-pool}))))\n   195\t    (let [t (derive-next-t (index/snapshot-datoms local-stream))]\n   196\t      {:dao.space/transactor true\n   197\t       :local-stream local-stream\n   198\t       :intake-pool intake-pool\n   199\t       :name (or name \"transactor\")\n   200\t       :next-t (atom t)\n   201\t       :state (atom {:closed false})})))\n   202\t\n   203\t\n   204\t(defn append!\n   205\t  \"Append one entity map or datom vector as a single atomic transaction.\n   206\t   Answers the v2 receipt on ok — {:dao.stream/outcome :dao.stream/ok\n   207\t   :dao.space/t t :dao.space/datoms datoms} — the local append's conforming\n   208\t   outcome as data otherwise (watermark unchanged, same t still pending),\n   209\t   and {:dao.stream/outcome :dao.stream/closed} on a closed transactor.\n   210\t   A malformed value still throws: it is a defect in the caller's own\n   211\t   argument, detected before any stream is touched.\"\n   212\t  [log val]\n   213\t  (let [{:keys [local-stream next-t state]} log]\n   214\t    (with-write-lock\n   215\t      next-t\n   216\t      (fn []\n   217\t        (if (:closed @state)\n   218\t          {:dao.stream/outcome :dao.stream/closed}\n   219\t          (let [t @next-t\n   220\t                datoms (val->datoms val t)]\n   221\t            (when (empty? datoms)\n   222\t              (throw (ex-info \"append! produced no datoms\" {:val val})))\n   223\t            (append-packet! local-stream next-t t datoms)))))))\n   224\t\n   225\t\n   226\t(defn transact!\n   227\t  \"Commits a non-empty collection of entity maps or datom vectors as a\n   228\t  single atomic transaction: every datom shares one allocated t and lands\n   229\t  in one transaction record through exactly one local append, so no partial\n   230\t  prefix is possible. Answers the v2 receipt on ok, the local append's\n   231\t  conforming outcome as data otherwise, and\n   232\t  {:dao.stream/outcome :dao.stream/closed} on a closed transactor. Throws\n   233\t  when the collection is empty, any item is invalid, or the expansion\n   234\t  yields no datoms.\"\n   235\t  [log tx-data]\n   236\t  (when (empty? tx-data)\n   237\t    (throw (ex-info \"transact! requires at least one transaction item\"\n   238\t                    {:tx-data tx-data})))\n   239\t  (let [{:keys [local-stream next-t state]} log]\n   240\t    (with-write-lock\n   241\t      next-t\n   242\t      (fn []\n   243\t        (if (:closed @state)\n   244\t          {:dao.stream/outcome :dao.stream/closed}\n   245\t          (let [t @next-t\n   246\t                datoms (into [] (mapcat #(val->datoms % t)) tx-data)]\n   247\t            (when (empty? datoms)\n   248\t              (throw (ex-info \"transact! produced no datoms\" {:tx-data tx-data})))\n   249\t            (append-packet! local-stream next-t t datoms)))))))\n   250\t\n   251\t\n   252\t(defn close!\n   253\t  \"Close this transactor value: further append!/transact! answer\n   254\t   {:dao.stream/outcome :dao.stream/closed} rather than throwing. Per\n   255\t   value — neither the local stream nor the intake pool is closed or\n   256\t   erased. Idempotent; linearizes after an in-flight append.\"\n   257\t  [log]\n   258\t  (let [{:keys [next-t state]} log]\n   259\t    (with-write-lock\n   260\t      next-t\n   261\t      (fn []\n   262\t        (swap! state assoc :closed true)\n   263\t        {:dao.stream/outcome :dao.stream/ok}))))\n   264\t\n   265\t\n   266\t(defn publish!\n   267\t  \"Build and enqueue the covered indexes over the local stream into the\n   268\t   intake pool (dao.space.index/publish-index!), returning its\n   269\t   {:manifest-address ... :manifest ...}. opts are passed through to\n   270\t   publish-index! (e.g. :branching-factor, :select-stream). Publication is\n   271\t   explicit and acknowledges enqueuing only, never observer\n   272\t   materialization.\"\n   273\t  ([log] (publish! log nil))\n   274\t  ([log opts]\n   275\t   (index/publish-index! (:local-stream log) (:intake-pool log) opts)))\ndiff --git a/test/dao/space/transactor_test.cljc b/test/dao/space/transactor_test.cljc\nindex 25f59ff..639d756 100644\n--- a/test/dao/space/transactor_test.cljc\n+++ b/test/dao/space/transactor_test.cljc\n@@ -1,20 +1,19 @@\n (ns dao.space.transactor-test\n-  \"Contract tests for the :transactor stream (dao.space.transactor): a\n-   single-writer wrapper over an explicit local dao.stream and an explicit\n-   DaoJing intake pool (docs/design/dao.jing.md, Publication from an agent).\n+  \"Contract tests for dao.space.transactor: a single-writer value over an\n+   explicit local dao.stream memory-log and an explicit DaoJing intake\n+   pool (docs/design/dao.jing.md, Publication from an agent).\n \n    Every append!/transact! emits exactly ONE atomic transaction record\n-   {:dao.space/transaction {:t n :datoms [...]}} through exactly one\n-   ds/append!; t is owned by the wrapper and derived on open from the\n+   {:dao.space/transaction {:t n :datoms [...]}} through exactly one local\n+   stream/append!; t is owned by the value and derived on create! from the\n    retained history. publish! builds and enqueues the covered indexes into\n    the intake pool.\"\n   (:require [clojure.test :refer [deftest is testing]]\n             [dao.jing :as jing]\n             [dao.space.index :as index]\n             [dao.space.transactor :as transactor]\n-            [dao.stream :as ds]\n-            [dao.stream.ringbuffer]\n             [dao.stream :as stream]\n+            [dao.stream.memory-log :as memory-log]\n             [dao.stream.ringbuffer :as ringbuffer]))\n \n \n@@ -25,95 +24,90 @@\n (defrecord ReaderOnlyStream\n   []\n \n-  ds/IDaoStreamReader\n+  strea