ocs/design/dao.space.md                           |  67 ++-\n docs/design/dao.space.schema.md                    |  22 +-\n docs/design/dao.stream.md                          |   5 +-\n src/cljc/dao/space/index.cljc                      |  68 +--\n src/cljc/dao/space/schema.cljc                     |  56 ++-\n src/cljc/dao/space/transactor.cljc                 | 285 ++++++------\n test/dao/space/index_test.cljc                     |  78 ++--\n test/dao/space/query_test.cljc                     |  11 +-\n test/dao/space/schema_test.cljc                    | 128 +++++-\n test/dao/space/stigmergy_test.clj                  |  36 +-\n test/dao/space/transactor_test.cljc                | 510 ++++++++++-----------\n 14 files changed, 866 insertions(+), 542 deletions(-)\ndiff --git a/test/dao/space/index_test.cljc b/test/dao/space/index_test.cljc\nindex 2fa35b7..8c5c2d4 100644\n--- a/test/dao/space/index_test.cljc\n+++ b/test/dao/space/index_test.cljc\n@@ -18,16 +18,23 @@\n             [dao.space.index :as index]\n             [dao.stream :as ds]\n             [dao.stream :as stream]\n+            [dao.stream.memory-log :as memory-log]\n             [dao.stream.ringbuffer :as ringbuffer]\n             #?@(:cljd [[\"dart:io\" :as dart-io]])))\n \n \n (defrecord MalformedResultStream\n   [result]\n-  ;; Test double: a reader whose every ds/next answer is the configured\n-  ;; result, used to feed malformed responses into publish-index!'s\n-  ;; snapshot reading.\n-  ds/IDaoStreamReader\n+  ;; Test double: a v2 reader whose cursor answers a conforming ok mint and\n+  ;; whose every next answer is the configured result, used to feed\n+  ;; malformed responses into publish-index!'s snapshot reading.\n+  stream/IDaoStreamReader\n+\n+  (cursor\n+    [_this _anchor]\n+    {:dao.stream/outcome :dao.stream/ok\n+     :dao.stream/cursor {:position 0}})\n+\n \n   (next [_this _cursor] result))\n \n@@ -63,10 +70,11 @@\n \n \n (defn- open-local\n-  \"Open a ringbuffer local (agent) stream