  (ds/append! inner val)))\n+      (stream/append! inner val)))\n \n \n-  ds/IDaoStreamReader\n+  stream/IDaoStreamReader\n \n-  (next [_this cursor] (ds/next inner cursor))\n+  (cursor [_this anchor] (stream/cursor inner anchor))\n \n \n-  ds/IDaoStreamBound\n-\n-  (close! [_this] (ds/close! inner))\n-\n-\n-  (closed? [_this] (ds/closed? inner)))\n+  (next [_this cursor] (stream/next inner cursor)))\n \n \n ;; ---------------------------------------------------------------------------\n ;; Helpers\n ;; ---------------------------------------------------------------------------\n \n+(defn- open-local\n+  \"A complete-retention memory-log local (agent) stream.\"\n+  []\n+  (:dao.stream/handle\n+    (memory-log/create! {:dao.stream/type :dao.stream/memory-log})))\n+\n+\n (defn- open-intake\n   \"A dao.stream ringbuffer intake writer.\"\n   [capacity]\n@@ -122,9 +116,8 @@\n                          :dao.stream.ringbuffer/capacity capacity})))\n \n \n-(defn- intake-values\n-  \"Every value currently on a v2 intake stream, read from its oldest\n-   cursor — the test's view of what publication enqueued.\"\n+(defn- stream-values\n+  \"Every value currently on a v2 stream, read from its oldest cursor.\"\n   [s]\n   (loop [cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n          acc []]\n@@ -134,12 +127,18 @@\n         acc))))\n \n \n+(defn- intake-values\n+  \"Every value currently on a v2 intake stream — the test's view of what\n+   publication enqueued.\"\n+  [s]\n+  (stream-values s))\n+\n+\n (defn- open-with-intake\n   ([local] (open-with-intake local (open-intake 4096)))\n   ([local intake]\n-   (ds/open! {:dao.stream/type :transactor,\n-              :local-stream local,\n-              :intake-pool [intake]})))\n+   (transactor/create! {:local-stream local,\n+                        :intake-pool [intake]})))\n \n \n (defn- content-handle\n@@ -178,106 +177,104 @@\n (defn- tx-ts\n   \"The transaction times of every atomic record currently on a local 