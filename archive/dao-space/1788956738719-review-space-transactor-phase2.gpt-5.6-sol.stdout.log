 permitted-key? (keys spec))))\n    63\t\n    64\t\n    65\t(defn- fresh-state\n    66\t  []\n    67\t  ;; As in the ring buffer, the logical identity is plain data — it\n    68\t  ;; travels in descriptors and cursors — never a host UUID object.\n    69\t  ;; A vector, dense from 0: positions are never reused and never\n    70\t  ;; dropped, and the tail is (count values).\n    71\t  (atom {:identity (str (random-uuid))\n    72\t         :values []\n    73\t         :closed? false}))\n    74\t\n    75\t\n    76\t(deftype MemoryLogHandle\n    77\t  [state]\n    78\t\n    79\t  stream/IDaoStreamDescriptor\n    80\t\n    81\t  (descriptor\n    82\t    [_]\n    83\t    (let [s @state]\n    84\t      {:dao.stream/outcome :dao.stream/ok\n    85\t       :dao.stream/descriptor {:dao.stream/type transport-type\n    86\t                               :dao.stream/identity (:identity s)}\n    87\t       :dao.stream/identity (:identity s)}))\n    88\t\n    89\t\n    90\t  stream/IDaoStreamReader\n    91\t\n    92\t  (cursor\n    93\t    [_ anchor]\n    94\t    (let [s @state]\n    95\t      ;; Every handle is the logical stream's owner: there is no\n    96\t      ;; attachment to be closed, and an owner keeps minting cursors\n    97\t      ;; after close so retained history stays readable.\n    98\t      (case anchor\n    99\t        ;; Complete retention: :oldest is the origin, before the first\n   100\t        ;; append and after close alike.\n   101\t        :dao.stream/oldest\n   102\t        (assoc (result :dao.stream/ok)\n   103\t               :dao.stream/cursor\n   104\t               {:dao.stream.memory-log/identity (:identity s)\n   105\t                :dao.stream.memory-log/position 0})\n   106\t        :dao.stream/newest\n   107\t        (assoc (result :dao.stream/ok)\n   108\t               :dao.stream/cursor\n   109\t               {:dao.stream.memory-log/identity (:identity s)\n   110\t                :dao.stream.memory-log/position (count (:values s))})\n   111\t        (result :dao.stream/invalid-anchor))))\n   112\t\n   113\t\n   114\t  (next\n   115\t    [_ cursor-value]\n   116\t    ;; Total: the position is range-checked before any indexed read, so a\n   117\t    ;; fabricated negative position answers invalid-cursor instead of\n   118\t    ;; reaching nth and throwing on the JVM.  No cursor this stream can\n   119\t    ;; mint holds a position above the tail — positions never disappear\n   120\t    ;; and the tail never retreats — so an above-tail position is a\n425:its declared retention; wiring one that can refuse is a host assembly\n426:defect. Deposit admission is declared, never interrogated: the contract's\n427:public surface has no way to ask a handle its retention policy. A constructor\n503:  declared retention (see *Retention and Gaps*), never from an anchor.\n511:  that declares complete retention this is unnecessary — a fresh `:oldest` is\n530:  cursor can still observe is governed only by retention.\n600:what *this handle* is on. (Not every outcome is: `gap` is retention-relative\n622:  retention concern, not a lifecycle one.\n667:deliberately. Bounded retention is bounded, and a cursor that falls behind\n670:When bounded retention evicts a value, a cursor still pointing at it gets the\n784:- **a retention or completeness predicate** — retention is declared, through\ndocs/design/dao.space.md:182:;; terminates on cyclic data). q returns a closed bounded result DaoStream.\ndocs/design/dao.space.transactor.md:157:writes are not durable, and never were — v1's local streams were in-memory\n","exit_code":0,"status":"completed"}}
