. Scalars still print\n    51\t   through pr-str.\"\n    52\t  [n]\n    53\t  (let [prefixed (fn [body]\n    54\t                   (if (meta n)\n    55\t                     (str \"^\" (canonical-print (meta n)) \" \" body)\n    56\t                     body))]\n    57\t    (cond (map? n)\n    58\t          (prefixed\n    59\t            (str \"{\"\n    60\t                 (str/join \", \" (map (fn [[k v]]\n    61\t                                       (str (canonical-print k) \" \"\n    62\t                                            (canonical-print v)))\n    63\t                                     n))\n    64\t                 \"}\"))\n    65\t          (set? n)\n    66\t          (prefixed\n    67\t            (str \"#{\" (str/join \" \" (map canonical-print n)) \"}\"))\n    68\t          (vector? n)\n    69\t          (prefixed\n    70\t            (str \"[\" (str/join \" \" (map canonical-print n)) \"]\"))\n    71\t          (sequential? n)\n    72\t          (prefixed\n    73\t            (str \"(\" (str/join \" \" (map canonical-print n)) \")\"))\n    74\t          :else (pr-str n))))\n    75\t\n    76\t\n    77\t(defn- order-normalize\n    78\t  \"Normalize a value so equal values print identically: maps and sets sort by\n    79\t   canonically-printed key/element, sequences recurse, and collection metadata is\n    80\t   normalized and reattached so it survives into the address. Reader position\n    81\t   metadata (:line/:column and friends) is not content and is dropped; every\n    82\t   other metadata difference changes the address.\n    83\t\n    84\t   A normalized set stays a (sorted) set and therefore prints with #{}\n    85\t   braces: the set-ness marker comes from the printer, never from a tag like\n    86\t   '(set ...) placed inside the ordinary value domain where a real list of\n    87\t   that shape could collide with it.\n    88\t\n    89\t   Records are not a supported payload: the hosts cannot even agree on how\n    90\t   to print one (tagged literal on the JVM and JS, plain map on Dart), so a\n    91\t   record and its equal plain map would collide somewhere. order-normalize\n    92\t   throws on records — anywhere in the value — rather than silently\n    93\t   addressing them as maps.\n    94\t\n    95\t   Transitional: this exists only to make the print-based content hash\n    96\t   deterministic and order-insensitive until the pinned, cross-platform\n    97\t   canonical byte encoding lands (docs/design/dao.jing.md, Canonical\n    98\t   encoding). It is NOT that canonical encoding.\"\n    99\t  [v]\n   100\t  (let [attach-meta (fn [normalized]\n   101\t                      (let [;; reader position is not content: the hosts'\n   102\t                            ;; readers stamp source coordinates onto list\n   103\t                            ;; literals, which would make an address depend\n   104\t                            ;; on where a payload was written. Everything\n   105\t                            ;; else in the metadata is address-significant.\n   106\t                            m (dissoc (meta v)\n   107\t                                      :line :column :end-line :end-column)]\n   108\t                        ;; empty metadata is dropped: = ignores metadata\n   109\t                        ;; entirely, and the hosts disagree on whether ^{}\n   110\t                        ;; prints (the JVM skips it, Dart prints it)\n   111\t                        (if (seq m)\n   112\t                          (with-meta normalized (order-normalize m))\n   113\t                          normalized)))]\n   114\t    (cond (record? v)\n   115\t          (throw (ex-info \"dao.jing does not address records: hosts print them differently, so their addresses would collide across hosts\"\n   116\t                          {:payload v}))\n   117\t          (map? v) (attach-meta\n   118\t                     (->> v\n   119\t                          (map (fn [[k x]]\n   120\t                                 [(order-normalize k)\n   121\t                                  (order-normalize x)]))\n   122\t                          ;; a canonically-printed-keyed sorted map prints\n   123\t                          ;; its keys in a fixed order on every platform\n   124\t                          ;; (array-map is not in ClojureDart)\n   125\t                          (into (sorted-map-by\n   126\t                                  #(compare (canonical-print %1)\n   127\t                                            (canonical-print %2))))))\n   128\t          (set? v) (attach-meta\n   129\t                     ;; a sorted set prints its elements in one fixed order\n   130\t                     ;; on every platform and keeps its #{} braces, so it can\n   131\t                     ;; never print like the list or vector of the same\n   132\t                     ;; elements\n   133\t                     (into (sorted-set-by\n   134\t                             #(compare (canonical-print %1)\n   135\t                                       (canonical-print %2)))\n   136\t                           (map order-normalize v)))\n   137\t          (vector? v) (attach-meta (mapv order-normalize v))\n   138\t          ;; lists and seqs are one canonical value: = calls them equal and\n   139\t          ;; both print (e1 e2 ...), so both normalize to a list\n   140\t          (sequential? v) (attach-meta (apply list (map order-normalize v)))\n   141\t          :else v)))\n   142\t\n   143\t\n   144\t(defn- order-normalized-print\n   145\t  \"Transitional encoder: canonical-print over the order-normalized form,\n   146\t   which prints collection metadata instead of dropping it. NOT the final\n\n(defn- fail\n  [message data]\n  (throw (ex-info message data)))\n\n\n(defn resolve-var\n  \"Look up a variable name: env -> store -> primitives -> module registry.\n\n   The registry is a value supplied by the composition, not a global.\"\n  [env store primitives registry name]\n  (if-let [pair (find env name)]\n    (val pair)\n    (if-let [pair (find store name)]\n      (val pair)\n      (if-let [pair (find primitives name)]\n        (val pair)\n        (if-let [resolved (when (namespace name)\n                            (module/resolve-module\n                              registry\n                              (symbol (str (namespace name)\n                                           \".\"\n                                           (clojure.core/name name)))))]\n","exit_code":0,"status":"completed"}}
