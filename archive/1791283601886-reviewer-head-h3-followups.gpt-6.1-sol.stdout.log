+(defn- movers\n+  \"Of `installed`, this step's install events, those whose install moved\n+   each name of `moves` to where it resolves now in `node`, `{name\n+   [event]}`: an install moved a name when, with only that principal's\n+   head put back where it stood in `before`, the name resolves elsewhere\n+   or not at all.  Derived from the two nodes, stored nowhere.  One\n+   install moved every name; a name no single install accounts for is\n+   given every install.\"\n+  [shell before node installed moves]\n+  (if (< (count installed) 2)\n+    (into {} (map (fn [m] [(:name m) installed])) moves)\n+    (let [authority (link/authority (:link-source shell))\n+          without (fn [{:keys [principal]}]\n+                    (let [put-back (get-in before [ld/installed-key principal])]\n+                      (:names (ld/names\n+                                (if (some? put-back)\n+                                  (assoc-in node [ld/installed-key principal]\n+                                            put-back)\n+                                  (update node ld/installed-key dissoc\n+                                          principal))\n+                                authority))))\n+          envs (mapv without installed)]\n+      (into {}\n+            (map (fn [{n :name :keys [resolved]}]\n+                   (let [mine (into []\n+                                    (keep-indexed\n+                                      (fn [i e]\n+                                        (let [entry (get (nth envs i) n)]\n+                                          (when-not (and (= :ok (:status entry))\n+                                                         (= resolved\n+                                                            (:address entry)))\n+                                            e))))\n+                                    installed)]\n+                     [n (if (seq mine) mine installed)])))\n+            moves))))\n+\n+\n+(defn moved-lines\n+  \"The line of 5.7 for each linked name an installed head moved, naming\n+   the head of the principal whose install moved it (`movers`): only\n    moves that were not already standing before this step's installs\n    (`before`, the node then), so a name is reported once per new\n-   address, and nothing is stored.\"\n+   address, and nothing is stored.  `installed` is the step's\n+   `:installed` events.\"\n   [shell before node installed]\n   (when (seq installed)\n-    (let [heads (str/join \", \"\n-                          (map (fn [{:keys [principal trace]}]\n-                                 (str principal \" seq \"\n-                                      (get-in trace [:yin.head/envelope\n-                                                     :yin.head/seq])))\n-                               installed))\n-          standing (set (map (juxt :name :resolved) (moved shell before)))]\n-      (into []\n-            (comp (remove #(contains? standing [(:name %) (:resolved %)]))\n-                  (map (fn [{n :name :keys [linked resolved]}]\n-                         (str \"dht: \" n \" moved: linked \" linked\n-                              \", now resolves to \" resolved \" (head of \"\n-                              heads \"); (reset) then (require '\" n\n-                              \") links it\"))))\n-            (moved shell node)))))\n+    (let [standing (set (map (juxt :name :resolved) (moved shell before)))\n+          moves (into []\n+                      (remove #(contains? standing [(:name %) (:resolved %)]))\n+                      (moved shell node))\n+          by-name (movers shell before node installed moves)]\n+      (mapv (fn [{n :name :keys [linked resolved]}]\n+              (str \"dht: \" n \" moved: linked \" linked\n+                   \", now resolves to \" resolved \" (head of \"\n+                   (str/join \", \"\n+                             (map (fn [{:keys [principal trace]}]\n+                                    (str principal \" seq \"\n+                                         (get-in trace [:yin.head/envelope\n+                                                        :yin.head/seq])))\n+                                  (get by-name n)))\n+                   \"); (reset) then (require '\" n \") links it\"))\n+            moves))))\n \n \n (defn- step-follow\ndiff --git a/src/cljc/yin/repl/query.cljc b/src/cljc/yin/repl/query.cljc\nindex a362fa5a..0690e009 100644\n--- a/src/cljc/yin/repl/query.cljc\n+++ b/src/cljc/yin/repl/query.cljc\n@@ -763,10 +763,9 @@\n    entry carries its manifest's address -- and the names of its host\n    modules, which carry none.\"\n   [registry]\n-  (let [entries (module/module-entries registry)]\n-    [(into {} (keep (fn [[n e]] (when (some? (:address e)) [n (:address e)])))\n-           entries)\n-     (set (keep (fn [[n e]] (when (nil? (:address e)) n)) entries))]))\n+  [(repl.dht/linked-registry registry)\n+   (set (keep (fn [[n e]] (when (nil? (:address e)) n))\n+              (module/module-entries registry)))])\n \n \n (defn- link-answer\n(ns dao.space.store.fs-test\n  \"The host file reads of dao.space.store.fs a caller bounds and decodes\n   itself: `read-bounded` (absence, the bound, a regular file only) and\n   `decode-utf8` (strict UTF-8), on every host.  `heads.edn`'s use of\n   them is yin.repl.dht-head-test.\"\n  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n            [clojure.test :refer [deftest is testing]]\n            [dao.space.store.fs :as fs])\n  #?@(:cljd [(:import [\"dart:typed_data\" Uint8List])]))\n\n\n(defn- temp-dir\n  []\n  (str \"target/test-store-fs-\" (random-uuid)))\n\n\n(defn- mkdirs!\n  [dir]\n  #?(:cljd (.createSync (dart-io/Directory. dir) .recursive true)\n     :clj (.mkdirs (java.io.File. ^String dir))\n     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n\n\n(defn- write-bytes!\n  [path codes]\n  #?(:cljd (.writeAsBytesSync (dart-io/File. path) (Uint8List.fromList codes))\n     :clj (java.nio.file.Files/write\n            (java.nio.file.Paths/get path (make-array String 0))\n            ^bytes (byte-array (map unchecked-byte codes))\n            ^\"[Ljava.nio.file.OpenOption;\" (make-array java.nio.file.OpenOption 0))\n     :cljs (.writeFileSync (js/require \"fs\") path (js/Buffer.from (clj->js codes)))))\n\n\n(defn- symlink!\n  \"A symlink at `path` to `target`, relative to the link's directory.\"\n  [path target]\n  #?(:cljd (.createSync (dart-io/Link. path) target)\n     :clj (java.nio.file.Files/createSymbolicLink\n            (java.nio.file.Paths/get path (make-array String 0))\n            (java.nio.file.Paths/get target (make-array String 0))\n            (make-array java.nio.file.attribute.FileAttribute 0))\n     :cljs (.symlinkSync (js/require \"fs\") target path)))\n\n\n(defn- thrown-message\n  [thunk]\n  (try (thunk) nil\n       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n         (or (ex-message e) (str e)))))\n\n\n(defn- file-with\n  \"A fresh directory's file `f` holding `codes`: its path.\"\n  [codes]\n  (let [dir (temp-dir)\n        path (str dir \"/f\")]\n    (mkdirs! dir)\n    (write-bytes! path codes)\n    path))\n\n\n(deftest read-bounded-reads-at-most-one-byte-past-the-bound\n  (testing \"no entry is nil, not a refusal\"\n    (let [dir (temp-dir)]\n      (mkdirs! dir)\n      (is (nil? (fs/read-bounded (str dir \"/absent\") 8)))))\n  (testing \"a file within the bound is read whole\"\n    (let [bs (fs/read-bounded (file-with [104 105]) 8)]\n      (is (= 2 (fs/byte-length bs)))\n      (is (= \"hi\" (fs/decode-utf8 bs)))))\n  (testing \"a file at the bound is read whole\"\n    (is (= 8 (fs/byte-length (fs/read-bounded (file-with (vec (repeat 8 120)))\n                                              8)))))\n  (testing \"a larger file is read to one byte past the bound, no further\"\n    (is (= 9 (fs/byte-length (fs/read-bounded (file-with (vec (repeat 100 120)))\n                                              8)))))\n  (testing \"an empty file is no bytes, not absence\"\n    (let [bs (fs/read-bounded (file-with []) 8)]\n      (is (some? bs))\n      (is (zero? (fs/byte-length bs))))))\n\n\n(deftest read-bounded-opens-only-a-regular-file\n  (testing \"a directory is refused\"\n    (let [dir (temp-dir)]\n      (mkdirs! (str dir \"/d\"))\n      (is (= \"it is not a regular file\"\n             (thrown-message #(fs/read-bounded (str dir \"/d\") 8))))))\n  (testing \"a symlink to a regular file is followed\"\n    (let [target (file-with [104 105])\n          link (str target \"-link\")]\n      (symlink! link \"f\")\n      (is (= \"hi\" (fs/decode-utf8 (fs/read-bounded link 8))))))\n  (testing \"a dangling symlink is refused, never read as absence\"\n    (let [dir (temp-dir)]\n      (mkdirs! dir)\n      (symlink! (str dir \"/link\") \"missing\")\n      (is (= \"it is not a regular file\"\n             (thrown-message #(fs/read-bounded (str dir \"/link\") 8)))))))\n\n\n(deftest decode-utf8-is-strict\n  (testing \"valid UTF-8, multi-byte included, decodes\"\n    (is (= \"aéb\" (fs/decode-utf8 (fs/read-bounded\n                                        (file-with [97 0xc3 0xa9 98]) 8)))))\n  (doseq [[label bad] [[\"an invalid byte\" [0xff]]\n                       [\"a truncated sequence\" [0xc3]]\n                       [\"an overlong encoding\" [0xc0 0xaf]]\n                       [\"an encoded surrogate\" [0xed 0xa0 0x80]]]]\n    (testing label\n      (let [bs (fs/read-bounded (file-with (into [97] (conj bad 98))) 8)]\n        (is (some? (thrown-message #(fs/decode-utf8 bs)))\n            \"throws, never a replacement character\")))))\ndiff --git a/docs/design/yin.vm.linker.dht.head.md b/docs/design/yin.vm.linker.dht.head.md\nindex 72cf8746..d5b193a8 100644\n--- a/docs/design/yin.vm.linker.dht.head.md\n+++ b/docs/design/yin.vm.linker.dht.head.md\n@@ -858,6 +858,12 @@ the checks below. No design beyond this section is expected.\n   `yin.repl.serve` on all three hosts without moving code.\n - That a TCP listener binds at the UDP socket's number on each host,\n   including after an ephemeral UDP bind.\n+- That a lost request on an attached reflection is detected. On\n+  loopback a dead peer closes its connection, and the reader sees\n+  `:lost` and the follower's `:source-lost`; a live but silent source\n+  is \"withholding\" (section 10) and its liveness is deferred to\n+  `dao.lease`. Off loopback a half-open connection is real and the\n+  follower would see retryable errors until TCP gives up.\n \n ### 8.4 The assumption cross-machine adds: locality is not trust\n \ndiff --git a/test/yin/repl/dht_head_test.cljc b/test/yin/repl/dht_head_test.cljc\nindex 36771d97..8bdaa797 100644\n--- a/test/yin/repl/dht_head_test.cljc\n+++ b/test/yin/repl/dht_head_test.cljc\n@@ -205,7 +205,7 @@\n \n (defn- world\n   []\n-  {:mesh (mesh/mesh) :ws (ws-net) :now 0 :lines {:a [] :b []}})\n+  {:mesh (mesh/mesh) :ws (ws-net) :now 0 :lines {:a [] :b [] :c []}})\n \n \n (defn- tick\n@@ -218,7 +218,7 @@\n                    (pump! (:ws w))\n                    (-> w (assoc k s) (update-in [:lines k] into lines)))\n                  w))]\n-    (-> w (step :a) (step :b) (assoc :now (+ now 10)))))\n+    (-> w (step :a) (step :b) (step :c) (assoc :now (+ now 10)))))\n \n \n (defn- run\n@@ -263,7 +263,7 @@\n \n (defn- close!\n   [w]\n-  (doseq [k [:a :b]]\n+  (doseq [k [:a :b :c]]\n     (when-some [s (get w k)] (main/close-index-store! s))))\n \n \n@@ -825,6 +825,22 @@\n         (write-bytes! (str dir \"/\" repl.dht/heads-file)\n                       (into [0xef 0xbb 0xbf] (ascii-codes empty-text)))\n         (is (= {:records {:version 1 :heads {}}} (repl.dht/read-heads dir)))))\n+    (testing \"every leading byte order mark is ignored, on every host\"\n+      (doseq [n [2 3]]\n+        (let [dir (temp-dir)]\n+          (mkdirs! dir)\n+          (write-bytes! (str dir \"/\" repl.dht/heads-file)\n+                        (into (vec (mapcat identity (repeat n [0xef 0xbb 0xbf])))\n+                              (ascii-codes empty-text)))\n+          (is (= {:records {:version 1 :heads {}}} (repl.dht/read-heads dir))\n+              (str n \" marks\")))))\n+    (testing \"a byte order mark inside the record is not stripped\"\n+      (let [dir (temp-dir)\n+            text (str \"{:ver\" \"﻿\" \"sion 1 :heads {}}\")]\n+        (mkdirs! dir)\n+        (write-heads! dir text)\n+        (is (contains? (repl.dht/read-heads dir) :refusal)\n+            (pr-str (repl.dht/read-heads dir)))))\n     (testing \"an overlong encoding and an encoded surrogate stay refused\"\n       (doseq [bad [[0xc0 0xaf] [0xed 0xa0 0x80]]]\n         (let [dir (temp-dir)]\n@@ -875,10 +891,148 @@\n     (close! w)))\n \n \n+(defn- board-trace\n+  \"The trace on the publisher's board now, or nil.\"\n+  [w]\n+  (let [board (get-in w [:a :repl :dht ::repl.dht/publisher :board])\n+        c (stream/cursor board :dao.stream/oldest)]\n+    (when (= :dao.stream/ok (:dao.stream/outcome c))\n+      (:dao.stream/value (stream/next board (:dao.stream/cursor c))))))\n+\n+\n+(deftest a-refused-deposit-is-reported-once-and-fails-nothing\n+  ;; The refusal is made real by the board itself: a trace this process\n+  ;; did not sign stands on it at a sequence above the next HEAD's, so\n+  ;; `yin.vm.linker.head/deposit!` refuses that HEAD :yin.head/seq-regression.\n+  (let [key (sign/generate)\n+        dir (temp-dir)\n+        w (world)\n+        w (run (assoc w :a (publisher w key dir)) 2 (fn [_] false))\n+        w (publish! w 1)\n+        t1 (board-trace w)\n+        s1 (get-in t1 [:yin.head/envelope :yin.head/seq])\n+        board (get-in w [:a :repl :dht ::repl.dht/publisher :board])\n+        forged (keyword (str \"segment/blake3-\" (apply str (repeat 64 \"f\"))))\n+        _ (stream/append! board (head/trace key forged (+ s1 1000)))\n+        ;; one evaluation, one HEAD move\n+        w (type! w :a \"(def g (fn [] 2))\")\n+        m2 (get-in w [:a :repl :indexer :manifest-address])\n+        answer (last (get-in w [:lines :a]))\n+        w (run w 20 (fn [_] false))\n+        refused (lines-with w :a \"was not deposited\")]\n+    (testing \"the refusal is reported once, with its manifest and reason\"\n+      (is (= [(str \"dht: the head trace of \" m2 \" was not deposited: \"\n+                   \":yin.head/seq-regression\")]\n+             refused)\n+          (pr-str (get-in w [:lines :a]))))\n+    (testing \"the HEAD write did not fail\"\n+      (is (= \"{:type :closure}\" answer) \"the evaluation answered\")\n+      (is (str/includes? (str (fs/read-file-text dir \"HEAD\")) (str m2)))\n+      (is (= forged (get-in (board-trace w) [:yin.head/envelope\n+                                             :yin.head/manifest]))\n+          \"a refusal appends nothing\"))\n+    (testing \"a later deposit, once the board admits it, is made\"\n+      (stream/append! board t1)\n+      (let [w (run (publish! w 3) 20 (fn [_] false))\n+            m3 (get-in w [:a :repl :indexer :manifest-address])]\n+        (is (not= m2 m3))\n+        (is (= m3 (get-in (board-trace w) [:yin.head/envelope\n+                                           :yin.head/manifest])))\n+        (is (= 1 (count (lines-with w :a \"was not deposited\")))\n+            \"nothing more is reported\")\n+        (close! w)))))\n+\n+\n ;; =============================================================================\n ;; The moved line names only new moves; a dial failure prints once\n ;; =============================================================================\n \n+(def ^:private second-pub-port 13)\n+\n+\n+(defn- moved-by-installs\n+  \"A reader of two publishers, A (`key`, alib from `a-code`) and C\n+   (`other`, the module `c-name` from `c-code`), that linked both names;\n+   then both republish (`a-code'`, `c-code'`) and the reader installs\n+   both heads.  Answers the moved lines `moved-lines` derives for those\n+   two installs taken as one step: the reader's node before them, its\n+   node after, and both `:installed` events.\"\n+  [key other c-name [a-code a-code'] [c-code c-code']]\n+  (let [p1 (sign/principal (:public key))\n+        p2 (sign/principal (:public other))\n+        w (world)\n+        w (assoc w\n+                 :a (publisher w key (temp-dir))\n+                 :c (shell {:mesh (:mesh w) :ws (:ws w) :dir (temp-dir)\n+                            :port second-pub-port :peers [reader-port]\n+                            :key other :principals []})\n+                 :b (reader w key (temp-dir)\n+                            {:peers [pub-port second-pub-port]\n+                             :principals [(:public key) (:public other)]\n+                             :follow [{:principal (:public key)\n+                                       :host \"127.0.0.1\" :port pub-port}\n+                                      {:principal (:public other)\n+                                       :host \"127.0.0.1\"\n+                                       :port second-pub-port}]}))\n+        publish (fn [w k n code]\n+                  (-> w\n+                      (type! k (str \"(def f (fn [] \" code \"))\"))\n+                      (type! k \"(require (quote yin.link))\")\n+                      (type! k (str \"(yin.link/publish (quote \" n\n+                                    \") (quote [f]))\"))))\n+        newest #(get-in %1 [%2 :repl :indexer :manifest-address])\n+        caught-up #(and (= (newest % :a) (:manifest (heads-of % :b key)))\n+                        (= (newest % :c) (:manifest (heads-of % :b other))))\n+        w (-> w\n+              (publish :a \"alib\" a-code)\n+              (publish :c c-name c-code)\n+              (run 3000 caught-up)\n+              (type! :b \"(require (quote alib))\")\n+              (type! :b (str \"(require (quote \" c-name \"))\"))\n+              (run 3000 #(not (pending? % :b))))\n+        _ (is (= (symbol c-name) (value w :b)) (pr-str (get-in w [:lines :b])))\n+        before (get-in w [:b :repl :dht])\n+        w (-> w\n+              (publish :a \"alib\" a-code')\n+              (publish :c c-name c-code')\n+              (run 3000 caught-up))\n+        _ (is (caught-up w) (pr-str (get-in w [:lines :b])))\n+        installed [{:yin.head/event :installed :principal p1\n+                    :trace (:installed (heads-of w :b key))}\n+                   {:yin.head/event :installed :principal p2\n+                    :trace (:installed (heads-of w :b other))}]\n+        lines (repl.dht/moved-lines (get-in w [:b :repl]) before\n+                                    (get-in w [:b :repl :dht]) installed)]\n+    (close! w)\n+    lines))\n+\n+\n+(deftest the-moved-line-names-the-principal-that-moved-each-name\n+  (let [key (sign/generate)\n+        other (sign/generate)\n+        p1 (sign/principal (:public key))\n+        p2 (sign/principal (:public other))\n+        head-of (fn [line] (re-find #\"\\(head of [^)]*\\)\" (str line)))]\n+    (testing \"two principals installed in one step, each moving its own name\"\n+      (let [lines (moved-by-installs key other \"blib\" [1 2] [10 20])\n+            line-of (fn [n] (first (filter #(str/starts-with?\n+                                               % (str \"dht: \" n \" moved: \"))\n+                                           lines)))]\n+        (is (= 2 (count lines)) (pr-str lines))\n+        (is (str/includes? (str (head-of (line-of \"alib\"))) p1) (pr-str lines))\n+        (is (not (str/includes? (str (head-of (line-of \"alib\"))) p2))\n+            (pr-str lines))\n+        (is (str/includes? (str (head-of (line-of \"blib\"))) p2) (pr-str lines))\n+        (is (not (str/includes? (str (head-of (line-of \"blib\"))) p1))\n+            (pr-str lines))))\n+    (testing \"two principals installed in one step, moving the same name\n+              together: both are named\"\n+      (let [lines (moved-by-installs key other \"alib\" [1 2] [1 2])]\n+        (is (= 1 (count lines)) (pr-str lines))\n+        (is (str/includes? (str (head-of (first lines))) p1) (pr-str lines))\n+        (is (str/includes? (str (head-of (first lines))) p2)\n+            (pr-str lines))))))\n+\n (deftest a-move-is-reported-once-and-each-name-its-own\n   (let [key (sign/generate)\n         w (world)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"cat docs/design/datom.world.md | tail -65; rg -n 'defn module-entries|defn names|defn snapshots|defn moved|defn seq-of|defn deposit|source-lost|defn dial-step' src/cljc/yin/vm/module.cljc src/cljc/yin/vm/linker/dht.cljc src/cljc/yin/vm/linker/head.cljc src/cljc/yin/vm/linker/head/ws.cljc; ls .cpcache; tail -90 collab/1791281512129-repl-engineer-head-h3-followups.claude-opus-5-5.stdout.log; rg -n 'max-t|seq-of|deposit-head' src/cljc/yin/repl/index.cljc src/cljc/dao/space/index.cljc src/cljc/yin/vm/linker/head.cljc src/cljc/yin/repl/dht.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"cat docs/design/datom.world.md | tail -65; rg -n 'defn module-entries|defn names|defn snapshots|defn moved|defn seq-of|defn deposit|source-lost|defn dial-step' src/cljc/yin/vm/module.cljc src/cljc/yin/vm/linker/dht.cljc src/cljc/yin/vm/linker/head.cljc src/cljc/yin/vm/linker/head/ws.cljc; ls .cpcache; tail -90 collab/1791281512129-repl-engineer-head-h3-followups.claude-opus-5-5.stdout.log; rg -n 'max-t|seq-of|deposit-head' src/cljc/yin/repl/index.cljc src/cljc/dao/space/index.cljc src/cljc/yin/vm/linker/head.cljc src/cljc/yin/repl/dht.cljc\"","aggregated_output":"Stigmergic coordination emerges from sharing data across streams.\n\n**Systems emerge from interpreters of pure data.** Streams are the\ncomposition medium; each interpreter gives the same data a perspective\nwithout collapsing interpretation into execution or owning the truth.\n\n- `dao.space` emerges from `dao.space.index` and `dao.space.query` over\n  ordinary streams.\n- ShiBi capability, metering, and budget emerge from different\n  interpreters over the same tuples; no token object is stored.\n- The four VMs interpret one Universal AST; many syntaxes feed that AST.\n- The semantic AST in `dao.space` is queryable facts projected by the\n  auto-index observer.\n- Client and server are roles in one stigmergic behavior implemented by\n  interpreters, not distinct kinds of nodes.\n\n**Derive, don't persist.** Before adding a tag, slot, or field to any\ncanonical content-hashed structure (an AST grammar, a datom schema, a row\nshape), check whether a correctly scoped Datalog query over\n`dao.space.query/q` can already compute the fact. If it can, it belongs as a\nquery or projection: new persisted structure migrates every downstream\nconsumer and duplicates authority over a fact a query derives fresh. The\nretired `:global` tag in\n[`docs/design/yin.vm.code-as-tuples.md`](./yin.vm.code-as-tuples.md) is the\ncase study, including the scoping bug that a naive query introduced.\n\nSee [`docs/agents/malleability.md`](../agents/malleability.md) for complete design guidance (cohesion, coupling, bounded complexity, evolution, testing strategy).\nSee [`docs/agents/vocabulary.md`](../agents/vocabulary.md) for domain vocabulary reference (biology, economics, physics, philosophy).\n\n## Code Style\n\n- Prefer simple data over rich types.\n- Prefer total functions over partial ones.\n- Prefer declarative pipelines over imperative logic.\n- Avoid cleverness.\n- Name things after what they do to streams.\n\n## Development Workflow\n\n- Do not invent abstractions that hide streams.\n- Do not suggest mainstream frameworks unless explicitly asked.\n- Do not optimize prematurely.\n- When uncertain, ask at the architectural level, not the implementation level.\n- Explanations should align with Plan 9 / Datomic / Lisp lineage.\n- Program store writes go through `engine/store-put`; any other store write\n  the store-write audit (`test/yin/vm/store_write_audit_test.clj`)\n  detects must be on its allowlist; its docstring states the residual it\n  leaves to review.\n\n### Problem Decomposition\n\nIf a problem appears complex:\n1. Decompose it into streams.\n2. Identify invariants.\n3. Restrict degrees of freedom.\n4. Make causality explicit.\n5. Let structure emerge from constraints.\n\n## Operational & Specialized Guides\n\n- **Advanced Concepts**: See [`docs/agents/advanced-concepts.md`](../agents/advanced-concepts.md) for parallel transport, capability tokens, and entanglement.\n- **Build & Test**: See [`docs/agents/build-n-test.md`](../agents/build-n-test.md) for build, lint, and test commands and TDD guidelines.\n- **Engineering Team Roster**: See [`docs/agents/team.md`](../agents/team.md) for engineering team roles and LLM model assignments.\n- **Agent Delegation**: See [`docs/agents/roles/orchestrator.md`](../agents/roles/orchestrator.md) for collaboration protocols and delegating tasks or reviews through `agy`, `cmd`, `glm`, `deepseek`, and `codex`; the orchestrator's append-only work log is [`docs/orchestrator-log.md`](../orchestrator-log.md).\n- **Website & Content**: See [`docs/agents/format.md`](../agents/format.md) for `.chp` and `.blog` EDN/Hiccup file specifications.\nsrc/cljc/yin/vm/linker/dht.cljc:167:(defn snapshots\nsrc/cljc/yin/vm/linker/dht.cljc:254:(defn names\nsrc/cljc/yin/vm/module.cljc:100:(defn module-entries\nsrc/cljc/yin/vm/linker/head/ws.cljc:324:(defn dial-step\nsrc/cljc/yin/vm/linker/head.cljc:49:     `:unloadable` with `:trace` and `:failure`; `:source-lost` with\nsrc/cljc/yin/vm/linker/head.cljc:150:(defn seq-of\nsrc/cljc/yin/vm/linker/head.cljc:210:(defn deposit!\nsrc/cljc/yin/vm/linker/head.cljc:588:           lost (conj {:yin.head/event :source-lost :principal principal\nsrc/cljc/yin/vm/linker/head.cljc:779:(defn moved\n2410757473.basis\n2410757473.cp\n2410757473.main\n2770481537.basis\n2770481537.cp\n2770481537.main\n3246607206.basis\n3246607206.cp\n3246607206.main\n3246607206.manifest\n3644903311.basis\n3644903311.cp\n3644903311.main\n3644903311.manifest\n3936417337.basis\n3936417337.cp\nCompleted-GMT: 2026-10-06 10:38:53 GMT\nCompleted-Local: 2026-10-06 17:38:53 +07\nCoding-Agent: claude\nSession-ID: 3a4d543e-01d3-49d0-892d-61355cef093b\n\nFour items are done (1, 2, 3, 7), item 4 is done with one caveat about how its test builds the step, and items 5 and 6 are not done. Item 5 needs new durable state. Item 6 can't happen in the current code. The JVM lane, the process test, the focused Dart runs, the peer build and kondo are all clean.\n\nI could not read the landed slice's reports in the main checkout's `collab/` (permission denied), so every citation below comes from reading the code, not the reports.\n\n## Per item\n\n**1. Double BOM: done.** `read-heads` now strips every leading U+FEFF after decoding, through a new private `without-boms` in `dht.cljc`. Everything else stays strict.\n- **Test:** in `heads-edn-is-bounded-and-strict-utf-8`, explicit bytes with 2 and 3 leading BOMs must read as an empty version-1 record. Another case puts a BOM inside a keyword (`:ver<BOM>sion`) and expects a refusal.\n- **Fails without the change:** with the old single strip restored, the 2- and 3-BOM cases fail on the JVM. Both pass on the JVM and on Dart.\n\n**2. File interop moved to `dao.space.store.fs`: done.**\n- `read-bounded`, `byte-length` and `decode-utf8` are now public in `fs.cljc` with docstrings, placed after `read-file-text`. The private `not-regular` moved with them.\n- The code is unchanged: the same JVM, Node and Dart branches, the same messages, and the check-then-open limit comment moved with it.\n- `dht.cljc` now calls `fs/...` and no longer requires `dart:convert`, `dart:io` or `Uint8List`. `fs.cljc` gained only `dart:convert` and `Uint8List` (Dart only), so it has no REPL dependency.\n- **Tests:** a new namespace, `test/dao/space/store/fs_test.cljc`, pins absence, the bound, an empty file, a directory, a symlink and a dangling symlink, plus valid, invalid, truncated, overlong and surrogate UTF-8. The `heads.edn` tests are unchanged and pass, including the slow FIFO test.\n\n**3. Refused deposit: done (test only, no code change).** The new test `a-refused-deposit-is-reported-once-and-fails-nothing` puts a trace this process didn't sign, with a high sequence number, on the real board. One `(def g ...)` HEAD move is then refused `:yin.head/seq-regression`.\n- The refusal is reported exactly once with that manifest and reason, the evaluation still answers, `HEAD` names the new manifest, and the board is unchanged.\n- Once the board admits deposits again (the test puts the earlier legitimate trace back), the next deposit lands and nothing more is reported.\n- One thing I learned: a three-line publish makes several HEAD moves, and each one's refusal is reported once.\n\n**4. Moved-line attribution: done, with a caveat on the test.** `moved-lines` (now public) gives each name the principals that moved it, using a new private `movers`. With two or more installs, it re-folds the names with only that principal's head set back to its value in `before`. If the name then resolves elsewhere, that principal moved it. If no single install explains the move, all installs are named. With one install, nothing extra is computed. Nothing is stored.\n- **Test:** `the-moved-line-names-the-principal-that-moved-each-name` uses a second publisher shell on port 13.\n  - When the two principals move different names, each line names only its own principal.\n  - When both move `alib` to the same address, both are named.\n- **Caveat:** the test captures the reader's real node before and after both installs and calls `moved-lines` with both `:installed` events. It does not force both installs into one simulated tick.\n- **Fails without the change:** with the old \"name every install\" behaviour, 2 assertions fail.\n\n**5. Whole-index read per deposit: not done; the read stays.** The sequence is the greatest `t` over the index's datoms (`head.cljc:150`).\n- **What the code offers:**\n  - The manifest holds only the index roots, a count and the branching factor (`index.cljc:300-338`), so it has no `t` bound.\n  - None of the four index orders sorts by `t`.\n  - The board holds only the previous trace.\n  - `:max-t` exists only in the in-memory index state (`index.cljc:656`).\n- **Why that isn't enough:**\n  - Using `:max-t` would mean threading it from `yin.repl.index` through the store's `:head-fn` contract, which is outside my file scope.\n  - It is also not proven equal to the index's row maximum. Followers recheck the sequence and would refuse a mismatch (`head.cljc:328`).\n  - Anything cheaper needs a new persisted `t` bound, which the brief rules out.\n\n**6. Double backoff: not done; stopped as the brief requires.** The described sequence can't happen in the current code.\n- An attached dial never becomes `:lost`: `dial-step` returns an attached dial before resolving (`yin/vm/linker/head/ws.cljc:337`).\n- A lost source clears the follower's reader in the same poll (`head.cljc:578`).\n- So no dial loss can follow a source loss on the same handle. I wrote a test where the board's listener goes away. With the guard and without it, the delay was 200 (one step), and no \"cannot follow\" line ever appeared.\n- I reverted both the guard and the test.\n\n**7. Duplicate derivation: done.** `repl.dht/linked-registry` is now public and takes a module registry. `query/session-modules` calls it for its linked half and keeps the host-name half. The host module itself is unchanged and holds no rule.\n\n## Commands and outcomes\n- `clj -M:kondo --lint` on the 3 source files and 2 test files: 0 errors, 0 warnings.\n- `clojure -M:test -n dao.space.store.fs-test -n yin.repl.dht-head-test -n yin.repl.query-test -n yin.repl.dht-test -n yin.vm.store-write-audit-test`: 96 tests, 1145 assertions, 0 failures.\n- `bb src/dev/cljd_agg.clj --only dao.space.store.fs-test,yin.repl.dht-head-test,yin.repl.query-test`: 3 files, all 45 passed (4 slow ones skipped, as the guard does).\n- `bb build:yin-repl-peer`: succeeded, with no warnings in the touched files.\n- `bb test:clj`: 3394 tests, 233184 assertions, 0 failures, 0 errors.\n- `clojure -M:test -n yin.repl.dht-process-test`, run alone because it isn't in the fast lane: 3 tests, 131 assertions, 0 failures.\n\n## Unresolved\n- **Node lane not run.** From the reader source, I expect a BOM *between* tokens is treated as whitespace on Node and refused on the JVM. That would be a cross-host difference. I haven't verified it, and I didn't add a refusal for it because that would go beyond the item. The test puts the BOM inside a keyword, which every host refuses.\n- **Rule slip:** I ran `git diff --stat` once (read-only), which the brief forbids. It showed `docs/design/yin.vm.linker.dht.head.md` as modified. I didn't touch it; it's probably the orchestrator's design edit.\n- **No design sentence needs to change.** `docs/agents/build-n-test.md` could mention that `dht-process-test` isn't in `bb test:clj`.\nsrc/cljc/yin/vm/linker/head.cljc:16:   manifest names (`seq-of`).\nsrc/cljc/yin/vm/linker/head.cljc:150:(defn seq-of\nsrc/cljc/yin/vm/linker/head.cljc:212:   derive (`seq-of`), and append it to `board`.  The board's current\nsrc/cljc/yin/vm/linker/head.cljc:218:  (let [n (seq-of datoms)\nsrc/cljc/yin/vm/linker/head.cljc:276:(defn- seq-of-trace\nsrc/cljc/yin/vm/linker/head.cljc:301:      {:seq (seq-of datoms)}\nsrc/cljc/yin/vm/linker/head.cljc:327:      (when-not (= (seq-of-trace trace) n)\nsrc/cljc/yin/vm/linker/head.cljc:350:   `:repair-ticks` and `:repair-max-ticks` (the node's bounds by\nsrc/cljc/yin/vm/linker/head.cljc:382:        :repair-max-ticks (limit :repair-max-ticks)}\nsrc/cljc/yin/vm/linker/head.cljc:464:        verdict (judge principal (seq-of-trace installed)\nsrc/cljc/yin/vm/linker/head.cljc:485:                      :seq (seq-of-trace trace)\nsrc/cljc/yin/vm/linker/head.cljc:702:                                (:repair-max-ticks follower)))\nsrc/cljc/yin/vm/linker/head.cljc:754:                   :floor (seq-of-trace installed)\nsrc/cljc/yin/repl/dht.cljc:201:(defn- deposit-head!\nsrc/cljc/yin/repl/dht.cljc:333:      (deposit-head! pub recovered))\nsrc/cljc/yin/repl/dht.cljc:338:                      (when pub (deposit-head! pub manifest-address)))\nsrc/cljc/yin/repl/dht.cljc:648:      (deposit-head! pub manifest))\nsrc/cljc/yin/repl/dht.cljc:662:    (min (* 2 delay) (:repair-max-ticks follower))\nsrc/cljc/dao/space/index.cljc:656:;;    :max-t    nil | n                               ; greatest writer t folded; nil\nsrc/cljc/dao/space/index.cljc:835:     :max-t nil,\nsrc/cljc/dao/space/index.cljc:1023:  \"§2.2's atomic rejection: trees, :ids, and :max-t unchanged, the monotonic\nsrc/cljc/dao/space/index.cljc:1043:   trees, :ids, and :max-t unchanged, increments :rejected, appends one\nsrc/cljc/dao/space/index.cljc:1047:   else changes. :max-t becomes the greater of itself and the batch's\nsrc/cljc/dao/space/index.cljc:1067:            (update :max-t\nsrc/cljc/dao/space/index.cljc:1233:   (:max-t nil — the transactor's empty history), else one plus the greatest\nsrc/cljc/dao/space/index.cljc:1239:  (if-some [t (:max-t index-state)] (inc t) 0))\nsrc/cljc/dao/space/index.cljc:1267:   and :max-t. The value promises nothing about appends the observer has not\nsrc/cljc/dao/space/index.cljc:1276:     :max-t (:max-t consumer)}))\nsrc/cljc/dao/space/index.cljc:1303:     :max-t (:max-t consumer),\nsrc/cljc/dao/space/index.cljc:1411:     :max-t (:max-t candidate),\n","exit_code":0,"status":"completed"}}
