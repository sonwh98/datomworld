{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/clojure/stream_eval_test.cljc | sed -n '1,150p'\"","aggregated_output":"     1\t(ns yang.clojure.stream-eval-test\n     2\t  \"yang.clojure stream programs on yin.vm, evaluated through the yin.repl\n     3\t   shell, which is the composition around dao.stream media: each program\n     4\t   is compiled by yang.clojure, appended to the program medium as one row\n     5\t   batch, expanded onto the row medium, loaded and run by the evaluator's\n     6\t   observer, and answered on the output medium as printed chunks followed\n     7\t   by one result token (yin.repl; docs/design/dao.stream.md).  The streams\n     8\t   a program makes -- `stream/make`, `put!`, `cursor`, `next!`, `close!`\n     9\t   -- are ring buffers the shell hands the VM as `:make-stream`, so every\n    10\t   stream a program touches is a dao.stream medium.\n    11\t\n    12\t   Every case runs on the four evaluators the shell composes, with the\n    13\t   value texts pinned, so the cases double as a cross-VM parity corpus.\"\n    14\t  (:require [clojure.string :as str]\n    15\t            [clojure.test :refer [deftest is testing]]\n    16\t            [dao.stream :as stream]\n    17\t            [dao.stream.ringbuffer :as ring]\n    18\t            [yin.repl :as repl]))\n    19\t\n    20\t\n    21\t;; =============================================================================\n    22\t;; Harness\n    23\t;; =============================================================================\n    24\t\n    25\t(def vm-types\n    26\t  \"Every evaluator the shell composes (`yin.repl/vm-constructors`).\"\n    27\t  [:ast-walker :semantic :stack :register])\n    28\t\n    29\t\n    30\t(defn- session\n    31\t  \"A fresh shell on `vm-type`, optionally around a caller-owned output\n    32\t   medium.\"\n    33\t  ([vm-type] (session vm-type nil))\n    34\t  ([vm-type output]\n    35\t   (repl/create-state (cond-> {:vm-type vm-type}\n    36\t                        output (assoc :output-stream output)))))\n    37\t\n    38\t\n    39\t(defn- evaluate\n    40\t  \"Evaluate `lines` in order against one threaded state; `[state texts]`.\n    41\t   The shell is synchronous, so no driver is needed.  The program media are\n    42\t   shared by every state threaded from one session, so a state is never\n    43\t   evaluated against twice.\"\n    44\t  [state lines]\n    45\t  (reduce (fn [[state texts] line]\n    46\t            (let [[state' text] (repl/eval-input state line)]\n    47\t              [state' (conj texts text)]))\n    48\t          [state []]\n    49\t          lines))\n    50\t\n    51\t\n    52\t(defn- texts\n    53\t  [vm-type lines]\n    54\t  (second (evaluate (session vm-type) lines)))\n    55\t\n    56\t\n    57\t(defn- ring-handle\n    58\t  [capacity]\n    59\t  (:dao.stream/handle\n    60\t    (ring/create! {:dao.stream/type ring/transport-type\n    61\t                   ring/capacity-key capacity})))\n    62\t\n    63\t\n    64\t(defn- read-all\n    65\t  \"Every element on `handle` from its oldest, then `[:end outcome]` for\n    66\t   the outcome that ended the read.\"\n    67\t  [handle]\n    68\t  (loop [cursor (:dao.stream/cursor\n    69\t                  (stream/cursor handle :dao.stream/oldest))\n    70\t         elements []]\n    71\t    (let [result (stream/next handle cursor)]\n    72\t      (if (= :dao.stream/ok (:dao.stream/outcome result))\n    73\t        (recur (:dao.stream/cursor result)\n    74\t               (conj elements (:dao.stream/value result)))\n    75\t        (conj elements [:end (:dao.stream/outcome result)])))))\n    76\t\n    77\t\n    78\t(defn- stream-ref?\n    79\t  \"A rendered stream reference; hosts print map keys in their own order.\"\n    80\t  [text]\n    81\t  (and (str/starts-with? text \"{\")\n    82\t       (str/includes? text \":type :stream-ref\")))\n    83\t\n    84\t\n    85\t(defn- error?\n    86\t  [text]\n    87\t  (str/starts-with? text \"Error: \"))\n    88\t\n    89\t\n    90\t;; =============================================================================\n    91\t;; Pure expressions and let bindings\n    92\t;; =============================================================================\n    93\t\n    94\t(def pure-corpus\n    95\t  \"`[source expected]` pairs: literals, primitives, conditionals, lambdas,\n    96\t   and let bindings, each answered as the shell renders the value.\"\n    97\t  [[\"42\" \"42\"]\n    98\t   [\"\\\"hi\\\"\" \"\\\"hi\\\"\"]\n    99\t   [\":k\" \":k\"]\n   100\t   [\"nil\" \"nil\"]\n   101\t   [\"[1 2 3]\" \"[1 2 3]\"]\n   102\t   [\"(+ 1 2)\" \"3\"]\n   103\t   [\"(* (+ 1 2) (- 10 6))\" \"12\"]\n   104\t   [\"(if (< 1 2) :yes :no)\" \":yes\"]\n   105\t   [\"(if false 1)\" \"nil\"]\n   106\t   [\"(and 1 2)\" \"2\"]\n   107\t   [\"(or nil 3)\" \"3\"]\n   108\t   [\"(first [9 8 7])\" \"9\"]\n   109\t   [\"(conj [1 2] 3)\" \"[1 2 3]\"]\n   110\t   [\"(let [x 5] (+ x 3))\" \"8\"]\n   111\t   [\"(let [x 2 y 3] (* x y))\" \"6\"]\n   112\t   [\"(let [x 1] (let [y 2] (+ x y)))\" \"3\"]\n   113\t   [\"(let [x 1 x (+ x 1)] x)\" \"2\"]\n   114\t   [\"(let [x 5] (+ x 1) (* x 3))\" \"15\"]\n   115\t   [\"(let [double (fn [x] (* x 2))] (double 5))\" \"10\"]\n   116\t   [\"((fn [x y] (+ x y)) 10 20)\" \"30\"]\n   117\t   [\"((fn [f x] (f x)) (fn [n] (* n 2)) 21)\" \"42\"]\n   118\t   [\"(do 1 2 3)\" \"3\"]])\n   119\t\n   120\t\n   121\t(deftest pure-expressions-and-let-bindings-evaluate-on-every-vm\n   122\t  (doseq [vm-type vm-types]\n   123\t    (testing (str vm-type)\n   124\t      (let [[state results]\n   125\t            (evaluate (session vm-type) (map first pure-corpus))]\n   126\t        (doseq [[[source expected] result] (map vector pure-corpus results)]\n   127\t          (is (= expected result) source))\n   128\t        (is (= 3 (:last-value state))\n   129\t            \"the last value is the last program's, not a stream token\")))))\n   130\t\n   131\t\n   132\t;; =============================================================================\n   133\t;; Stream ingestion, transformation, and emission\n   134\t;; =============================================================================\n   135\t\n   136\t(def ^:private pump-source\n   137\t  (str \"(defn pump [c out]\"\n   138\t       \" (let [v (stream/next! c)]\"\n   139\t       \"  (if (= v nil)\"\n   140\t       \"   out\"\n   141\t       \"   (do (stream/put! out (* v 10)) (pump c out)))))\"))\n   142\t\n   143\t\n   144\t(def ^:private drain-source\n   145\t  (str \"(defn drain [c acc]\"\n   146\t       \" (let [v (stream/next! c)]\"\n   147\t       \"  (if (= v nil) acc (drain c (conj acc v)))))\"))\n   148\t\n   149\t\n   150\t(deftest a-program-makes-writes-and-reads-a-stream-in-one-round\n","exit_code":0,"status":"completed"}}
