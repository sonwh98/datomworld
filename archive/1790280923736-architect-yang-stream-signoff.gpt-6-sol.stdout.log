is (= [] (jing-file/records path)) \\\"nothing was written\\\")\\n   217\\t        (finally (jing/close! handle) (cleanup-file path))))))\\n   218\\t\\n   219\\t\\n   220\\t;; =============================================================================\\n   221\\t;; F2, F4 -- replay, duplicates, and failing the open\\n   222\\t;; =============================================================================\\n   223\\t\\n   224\\t(deftest durability-across-close-and-reopen\\n   225\\t  (testing\\n   226\\t    \\\"F2/F5: every record replays into the content map on the next open\\\"\\n   227\\t    (let [path (temp-path \\\"durability\\\")\\n   228\\t          a1 (jing/segment-key \\\"alpha\\\")\\n   229\\t          a2 (jing/segment-key {:n 2})\\n   230\\t          handle (jing-file/create-content-file path)]\\n   231\\t      (jing/materialize! handle \\\"alpha\\\")\\n   232\\t      (jing/materialize! handle {:n 2})\\n   233\\t      (jing/close! handle)\\n   234\\t      (let [h2 (jing-file/create-content-file path)]\\n   235\\t        (try (is (= \\\"alpha\\\" (jing/get h2 a1 ::absent)))\\n   236\\t             (is (= {:n 2} (jing/get h2 a2 ::absent)))\\n   237\\t             (finally (jing/close! h2) (cleanup-file path)))))))\\n   238\\t\\n   239\\t\\n   240\\t(deftest acknowledged-insert-survives-immediate-close\\n   241\\t  (testing\\n   242\\t    \\\"F1/F5: the :inserted verdict is returned only after the flush, so an\\n   243\\t            immediate close cannot lose the record\\\"\\n   244\\t    (let [path (temp-path \\\"ack\\\")\\n   245\\t          payload {:ack 1}\\n   246\\t          address (jing/segment-key payload)\\n   247\\t          handle (jing-file/create-content-file path)]\\n   248\\t      (jing/materialize! handle payload)\\n   249\\t      (jing/close! handle)\\n   250\\t      (let [h2 (jing-file/create-content-file path)]\\n   251\\t        (try (is (= payload (jing/get h2 address ::absent)))\\n   252\\t             (finally (jing/close! h2) (cleanup-file path)))))))\\n   253\\t\\n   254\\t\\n   255\\t(deftest equal-duplicate-frames-recover\\n   256\\t  (testing\\n   257\\t    \\\"F2: an equal duplicate record is tolerated on replay; the duplicate\\n   258\\t            frame is visible to records and writes nothing new\\\"\\n   259\\t    (let [path (temp-path \\\"dup\\\")\\n   260\\t          address (jing/segment-key {:k 1})\\n   261\\t          payload {:k 1}\\n   262\\t          handle (jing-file/create-content-file path)]\\n   263\\t      (jing/materialize! handle payload)\\n   264\\t      (jing/close! handle)\\n   265\\t      ;; Hand-write the identical frame again, bypassing the backend.\\n   266\\t      (append-raw-bytes! path\\n   267\\t                         (frame-of (jing-file/encode-record address payload)))\\n   268\\t      (is (= 2 (count (jing-file/records path)))\\n   269\\t          \\\"records sees both frames, equal duplicates included\\\")\\n   270\\t      (let [h2 (jing-file/create-content-file path)]\\n   271\\t        (try (is (= payload (jing/get h2 address ::absent)))\\n   272\\t             (is (= :present ((:put-bytes-fn h2) address (bytes-of payload))))\\n   273\\t             (is (= 2 (count (jing-file/records path)))\\n   274\\t                 \\\"a :present put writes no record\\\")\\n   275\\t             (finally (jing/close! h2) (cleanup-file path)))))))\\n   276\\t\\n   277\\t\\n   278\\t(deftest fail-closed-categories-fail-the-open\\n   279\\t  (testing\\n   280\\t    \\\"F4: a complete frame that is not one canonical two-element CBOR array\\n   281\\t            of byte strings, whose digest is not its payload's under a\\n   282\\t            registered algorithm, or whose payload bytes are not one\\n   283\\t            canonical Jing payload fails the open, loudly and without\\n   284\\t            mutating the file\\\"\\n   285\\t    (let [p (bytes-of \\\"ok\\\")\\n   286\\t          d (digest-of p)\\n   287\\t          ;; int 1 in a non-shortest head: valid CBOR, refused as\\n   288\\t          ;; non-canonical; its digest still matches\\n   289\\t          noncanonical (host-bytes [0x18 0x01])\\n   290\\t          ;; the array head promises two items, one follows\\n   291\\t          truncated (host-bytes [0x82 0x01])\\n   292\\t          ;; two complete items where exactly one is allowed\\n   293\\t          trailing (host-bytes [0x01 0x02])\\n   294\\t          ;; a well-formed frame written with an indefinite-length array\\n   295\\t          indefinite (host-bytes (concat [0x9f]\\n   296\\t                                         (bytes->ints (cbor/encode d))\\n   297\\t                                         (bytes->ints (cbor/encode p))\\n   298\\t                                         [0xff]))]\\n   299\\t      (doseq [[name record]\\n   300\\t              [[\\\"not CBOR at all\\\" (jing-file/->bytes \\\"[[[not cbor\\\")]\\n   301\\t               [\\\"three-element array\\\" (cbor/encode [d p (host-bytes [1])])]\\n   302\\t               [\\\"text payload, not bytes\\\" (cbor/encode [d \\\"ok\\\"])]\\n   303\\t               [\\\"a map, not an array\\\" (cbor/encode {:digest d, :payload p})]\\n   304\\t               [\\\"digest of the wrong length\\\"\\n   305\\t                (cbor-frame (host-bytes (take 16 (bytes->ints d))) p)]\\n   306\\t               [\\\"digest of another payload\\\"\\n   307\\t                (cbor-frame (digest-of (bytes-of \\\"different\\\")) p)]\\n   308\\t               [\\\"non-canonical payload bytes\\\"\\n   309\\t                (cbor-frame (digest-of noncanonical) noncanonical)]\\n   310\\t               [\\\"truncated payload bytes\\\"\\n   311\\t                (cbor-frame (digest-of truncated) truncated)]\\n   312\\t               [\\\"payload with trailing data\\\"\\n   313\\t                (cbor-frame (digest-of trailing) trailing)]\\n   314\\t               [\\\"non-canonical frame encoding\\\" indefinite]]]\\n   315\\t        (let [path (temp-path \\\"corrupt\\\")\\n   316\\t              frame-bytes (frame-of record)]\\n   317\\t          (append-raw-bytes! path frame-bytes)\\n   318\\t          (try (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\\n   319\\t                     (jing-file/create-content-file path))\\n   320\\t                   name)\\n   321\\t               (is (= (byte-count frame-bytes) (file-length path))\\n   322\\t                   (str name \\\": the refused file is not mutated\\\"))\\n   323\\t               (finally (cleanup-file path))))))))\\n   324\\t\\n   325\\t\\n   326\\t(deftest a-mutated-byte-fails-the-open-without-mutation\\n   327\\t  (testing\\n   328\\t    \\\"a stored frame whose payload bytes change on disk no longer hashes to\\n   329\\t            its digest: the open and records both refuse, and neither\\n   330\\t            truncates or rewrites anything\\\"\\n   331\\t    (let [path (temp-path \\\"mutated\\\")\\n   332\\t          payload {:mutation \\\"target\\\"}\\n   333\\t          handle (jing-file/create-content-file path)]\\n   334\\t      (jing/materialize! handle payload)\\n   335\\t      (jing/close! handle)\\n   336\\t      (let [len (file-length path)\\n   337\\t            last-offset (dec len)\\n   338\\t            original (last (bytes->ints\\n   339\\t                             (jing-file/encode-record\\n   340\\t                               (jing/segment-key payload) payload)))]\\n   341\\t        (try\\n   342\\t          ;; the payload is the frame's tail, so its last byte is the\\n   343\\t          ;; file's last byte; flip it\\n   344\\t          (overwrite-byte! path last-offset (bit-xor original 0xff))\\n   345\\t          (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\\n   346\\t                (jing-file/create-content-file path))\\n   347\\t              \\\"the open refuses the mutated frame\\\")\\n   348\\t          (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\\n   349\\t                (jing-file/records path))\\n   350\\t              \\\"records refuses it too\\\")\\n   351\\t          (is (= len (file-length path)) \\\"nothing was truncated\\\")\\n   352\\t          ;; restoring the byte restores the store\\n   353\\t          (overwrite-byte! path last-offset original)\\n   354\\t          (let [h2 (jing-file/create-content-file path)]\\n   355\\t            (try (is (= payload (jing/get h2 (jing/segment-key payload)\\n   356\\t                                          ::absent)))\\n   357\\t                 (finally (jing/close! h2))))\\n   358\\t          (finally (cleanup-file path)))))))\\n   359\\t\\n   360\\t\\n   361\\t(deftest unequal-duplicate-at-one-address-fails-the-open\\n   362\\t  (testing\\n   363\\t    \\\"F2's collision case. Two individually valid frames at one address must\\n   364\\t            be equal (B6: the address hashes the payload), so an unequal\\n   365\\t            duplicate necessarily fails the second frame's own hash check --\\n   366\\t            the open fails on F4's ground before the accumulation's\\n   367\\t            defensive collision branch, which is unreachable by\\n   368\\t            construction, is ever reached\\\"\\n   369\\t    (let [path (temp-path \\\"collision\\\")\\n   370\\t          good (jing/segment-key \\\"ok\\\")]\\n   371\\t      (append-raw-bytes! path (frame-of (jing-file/encode-record good \\\"ok\\\")))\\n   372\\t      (append-raw-bytes!\\n   373\\t        path (frame-of (cbor-frame (digest-of (bytes-of \\\"ok\\\"))\\n   374\\t                                   (bytes-of \\\"other\\\"))))\\n   375\\t      (try (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\\n   376\\t                 (jing-file/create-content-file path)))\\n   377\\t           (finally (cleanup-file path))))))\\n   378\\t\\n   379\\t\\n   380\\t;; =============================================================================\\n   381\\t;; F3 -- torn-tail truncation, each category hand-written per host\\n   382\\t;; =============================================================================\\n   383\\t\\n   384\\t(defn- torn-tail-recovers\\n   385\\t  \\\"The F3 proof shape: one valid record, a torn tail of raw bytes, and the\\n   386\\t   open must truncate, replay the survivor, accept a clean put, and reopen\\n   387\\t   with both records.\\\"\\n   388\\t  [prefix torn-bytes]\\n   389\\t  (let [path (temp-path prefix)\\n   390\\t        a1 (jing/segment-key \\\"survivor\\\")\\n   391\\t        a2 (jing/segment-key {:after :truncation})\\n   392\\t        handle (jing-file/create-content-file path)]\\n   393\\t    (jing/materialize! handle \\\"survivor\\\")\\n   394\\t    (jing/close! handle)\\n   395\\t    (append-raw-bytes! path torn-bytes)\\n   396\\t    (try\\n   397\\t      (let [h2 (jing-file/create-content-file path)]\\n   398\\t        ;; close is idempotent, so the outer finally may re-close h2.\\n   399\\t        (try\\n   400\\t          (is (= [[a1 \\\"survivor\\\"]] (jing-file/records path))\\n   401\\t              \\\"the torn tail is truncated; only the survivor replays\\\")\\n   402\\t          (is (= \\\"survivor\\\" (jing/get h2 a1 ::absent)))\\n   403\\t          (jing/materialize! h2 {:after :truncation})\\n   404\\t          (jing/close! h2)\\n   405\\t          (let [h3 (jing-file/create-content-file path)]\\n   406\\t            (try\\n   407\\t              (is (= [[a1 \\\"survivor\\\"] [a2 {:after :truncation}]]\\n   408\\t                     (jing-file/records path))\\n   409\\t                  \\\"a put after truncation lands clean and survives\\\")\\n   410\\t              (is (= {:after :truncation} (jing/get h3 a2 ::absent)))\\n   411\\t              (finally (jing/close! h3))))\\n   412\\t          (finally (jing/close! h2))))\\n   413\\t      (finally (cleanup-file path)))))\\n   414\\t\\n   415\\t\\n   416\\t(deftest torn-tail-overlong-length-is-truncated\\n   417\\t  (testing\\n   418\\t    \\\"F3: a length reaching past end of file is torn -- int32 999 with only\\n   419\\t            two payload bytes (hand-written, not the v1 fixture: the torn\\n   420\\t            bytes must follow a valid record)\\\"\\n   421\\t    (torn-tail-recovers \\\"torn-overlong\\\"\\n   422\\t                        (host-bytes (into (int32-be 999) [1 2])))))\\n   423\\t\\n   424\\t\\n   425\\t(deftest torn-tail-shorter-than-prefix-is-truncated\\n   426\\t  (testing \\\"F3: a tail shorter than the 4-byte length prefix is torn\\\"\\n   427\\t    (torn-tail-recovers \\\"torn-subprefix\\\" (host-bytes [7 7]))))\\n   428\\t\\n   429\\t\\n   430\\t(deftest torn-tail-negative-length-is-truncated\\n   431\\t  (testing \\\"F3: a negative frame length is torn\\\"\\n   432\\t    (torn-tail-recovers \\\"torn-negative\\\" (host-bytes (int32-be -1)))))\\n   433\\t\\n   434\\t\\n   435\\t;; =============================================================================\\n   436\\t;; D2, D3, F6 -- handle lifecycle\\n   437\\t;; =============================================================================\\n   438\\t\\n   439\\t(deftest close-semantics\\n   440\\t  (testing\\n   441\\t    \\\"D2/D3/F6: close! returns nil and is idempotent; after close every\\n   442\\t            entry point throws; stored content is neither cleared nor\\n   443\\t            rewritten\\\"\\n   444\\t    (let [path (temp-path \\\"close\\\")\\n   445\\t          payload {:v 1}\\n   446\\t          address (jing/segment-key payload)\\n   447\\t          handle (jing-file/create-content-file path)]\\n   448\\t      (jing/materialize! handle payload)\\n   449\\t      (is (nil? (jing/close! handle)))\\n   450\\t      (is (nil? (jing/close! handle)) \\\"close is idempotent\\\")\\n   275\\t    (throw (ex-info (str \\\"unsupported hash algorithm: \\\" algorithm)\\n   276\\t                    {:algorithm algorithm}))))\\n   277\\t\\n   278\\t\\n   279\\t(defn canonical-bytes\\n   280\\t  \\\"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\\n   281\\t   of v -- the exact bytes content hashing digests, so\\n   282\\t   `(digest-bytes algo (canonical-bytes v))` is\\n   283\\t   `(content-hash v {:algorithm algo})`.\\n   284\\t   This is the byte form Jing content travels in across a `dao.stream`\\n   285\\t   boundary.\\\"\\n   286\\t  [v]\\n   287\\t  (cbor/encode v))\\n   288\\t\\n   289\\t\\n   290\\t(defn content-hash\\n   375\\t  \\\"The content hash carried by a segment address. Equivalent to segment-digest.\\n   376\\t   Total only over valid segment addresses; throws on invalid input.\\\"\\n   377\\t  [k]\\n   378\\t  (segment-digest k))\\n   379\\t\\n   380\\t\\n   381\\t(defn segment-matches?\\n   382\\t  \\\"Total verification predicate: true when address is a valid segment address\\n   383\\t   and its digest matches the hash of canonical-bytes of payload under the\\n   384\\t   address-carried algorithm.\\n   385\\t   Never throws: malformed addresses, unknown algorithms, digest mismatches,\\n   386\\t   and canonical-encoder refusal all return false.\\\"\\n   387\\t  [address payload]\\n   388\\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\\n   389\\t    (try\\n   390\\t      (let [bs (canonical-bytes payload)\\n   391\\t            actual (digest-bytes algorithm bs)]\\n   392\\t        (= digest actual))\\n   393\\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\\n   394\\t        false))\\n   395\\t    false))\\n   396\\t\\n   397\\t\\n   398\\t(defn segment-bytes-match?\\n   399\\t  \\\"Total verification predicate over bytes: true when address is a valid\\n   400\\t   segment address whose digest is the hash of bs under the address-carried\\n   401\\t   algorithm. Never throws: a malformed address, a foreign algorithm, or a\\n   402\\t   non-byte bs all answer false.\\\"\\n   403\\t  [address bs]\\n   404\\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\\n   405\\t    (try\\n   406\\t      (= digest (digest-bytes algorithm bs))\\n   407\\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\\n   408\\t        false))\\n   409\\t    false))\\n   410\\t\\n   411\\t\\n   412\\t(def ^:private base64-pattern\\n   413\\t  \\\"Padded standard-alphabet Base64: no whitespace, no URL-safe alphabet.\\\"\\n   452\\t      (throw (ex-info \\\"content address does not match the payload\\\"\\n   453\\t                      {:address address, :payload payload})))\\n   454\\t    bs))\\n   455\\t\\n   456\\t\\n   457\\t(defn segment-value\\n   458\\t  \\\"The value of payload bytes stored at address: verifies the bytes hash to\\n   459\\t   the address under its carried algorithm, then decodes exactly one\\n   460\\t   canonical payload. Throws on a malformed address, a digest mismatch, or\\n   461\\t   a non-canonical payload.\\\"\\n   462\\t  [address bs]\\n   463\\t  (let [{:keys [algorithm digest]}\\n   464\\t        (or (parse-segment-address address)\\n   465\\t            (throw (ex-info \\\"not a segment content address\\\"\\n   466\\t                            {:address address})))]\\n   467\\t    (when-not (= digest (digest-bytes algorithm bs))\\n   468\\t      (throw (ex-info \\\"stored bytes do not hash to their content address\\\"\\n   469\\t                      {:address address})))\\n   470\\t    (cbor/decode bs)))\\n   471\\t\\n   472\\t\\n   473\\t(defn materialize!\\n   474\\t  \\\"Content-address payload and store it through the handle's byte store.\\n   475\\t\\n   476\\t   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\\n   477\\t   and [handle payload {:keys [algorithm]}].\\n   478\\t\\n   479\\t   The payload is encoded exactly once. The address is derived solely from\\n   480\\t   those canonical bytes, and the same bytes go to the backend effect\\n   481\\t   :put-bytes-fn as (put-bytes-fn address bytes). The backend must answer\\n   482\\t   with one of:\\n   483\\t\\n   484\\t     :inserted -- the bytes are durably stored now;\\n   485\\t     :present  -- bytes are already stored under that address.\\n   486\\t\\n   487\\t   Any other answer is an invalid backend result and throws: DaoJing does\\n   488\\t   not accept ambiguous truthiness. The address is returned only after the\\n   489\\t   backend reports success.\\n   490\\t\\n   491\\t   On :present the stored bytes are read back through :get-bytes-fn and\\n   492\\t   verified both by hash against the address and byte for byte against the\\n   493\\t   proposed bytes. Equal content is idempotent and returns the same\\n   494\\t   address. Content that does not hash to its own address is an integrity\\n   495\\t   failure and throws loudly. Nothing is ever overwritten.\\\"\\n   496\\t  ([handle payload]\\n   497\\t   (materialize! handle payload {:algorithm default-hash-algorithm}))\\n   498\\t  ([handle payload opts]\\n   499\\t   (let [put (:put-bytes-fn handle)\\n   500\\t         get-fn (:get-bytes-fn handle)]\\n   501\\t     (when-not (fn? put)\\n   502\\t       (throw (ex-info \\\"dao.jing handle requires :put-bytes-fn\\\"\\n   503\\t                       {:handle handle})))\\n   504\\t     (when-not (fn? get-fn)\\n   505\\t       (throw (ex-info \\\"dao.jing handle requires :get-bytes-fn\\\"\\n   506\\t                       {:handle handle})))\\n   507\\t     (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\\n   508\\t           reg (clojure.core/get registry algo)]\\n   509\\t       (when-not reg\\n   510\\t         (throw (ex-info (str \\\"unsupported hash algorithm: \\\" algo)\\n   511\\t                         {:algorithm algo})))\\n   512\\t       (let [bs (canonical-bytes payload)\\n   513\\t             address (keyword \\\"segment\\\"\\n   514\\t                              (str (:address-id reg) \\\"-\\\"\\n   515\\t                                   (digest-bytes algo bs)))\\n   516\\t             result (put address bs)]\\n   517\\t         (case result\\n   518\\t           :inserted address\\n   519\\t           :present\\n   520\\t           (let [stored (get-fn address content-missing)]\\n   521\\t             (cond\\n   522\\t               (identical? stored content-missing)\\n   523\\t               (throw\\n   524\\t                 (ex-info\\n   525\\t                   \\\"backend reported :present but the content address is absent\\\"\\n   526\\t                   {:address address, :payload payload}))\\n   527\\t               ;; the read-back must hash to the address it sits at and be\\n   528\\t               ;; the very bytes proposed\\n   529\\t               (and (segment-bytes-match? address stored)\\n   530\\t                    (cbor/bytes= stored bs))\\n   531\\t               address\\n   532\\t               :else\\n   533\\t               (throw\\n   534\\t                 (ex-info\\n   535\\t                   (str \\\"content collision: the stored bytes do not match \\\"\\n   536\\t                        \\\"their content address\\\")\\n   537\\t                   {:address address, :payload payload}))))\\n   538\\t           (throw (ex-info\\n   539\\t                    \\\"invalid backend put result\\\"\\n   540\\t                    {:result result, :address address, :payload payload}))))))))\\n   541\\t\\n   542\\t\\n   543\\t(defn get\\n   544\\t  \\\"Retrieve the value stored at a content address.\\n   545\\t\\n   546\\t   Only valid registered content addresses are valid DaoJing reads;\\n   547\\t   arbitrary keys and mutable roots are outside DaoJing and throw before the\\n   548\\t   backend is consulted. The backend's bytes are hash-verified against the\\n   549\\t   address and decoded; bytes that do not hash to the address throw.\\n   550\\t   Returns not-found when the address is absent.\\\"\\n   551\\t  [handle address not-found]\\n   552\\t  (when-not (segment-address? address)\\n   553\\t    (throw (ex-info \\\"dao.jing reads only valid segment content addresses\\\"\\n   554\\t                    {:address address})))\\n   555\\t  (let [get-fn (:get-bytes-fn handle)]\\n   556\\t    (when-not (fn? get-fn)\\n   557\\t      (throw (ex-info \\\"dao.jing handle requires :get-bytes-fn\\\"\\n   558\\t                      {:handle handle})))\\n   559\\t    (let [stored (get-fn address not-found)]\\n   560\\t      (if (identical? stored not-found)\\n   561\\t        not-found\\n   562\\t        (segment-value address stored)))))\\n   563\\t\\n   564\\t\\n   565\\t(defn close!\\n311:ERROR in (every-node-type-and-scalar-class-round-trips-through-durable-storage) (yin/vm/pipeline_test.cljc:509:15)\\n314:  actual: #error {:message \\\"Projected slot value does not fit its declared type\\\", :data {:rule :unsupported-value, :slot :yin.debruijn/value, :value #dao.jing/float64 1.5, :entity 24}}\\n316:FAIL in (list-literals-persist-in-memory) (yin/vm/pipeline_test.cljc:585:9)\\n318:  actual: (not (= {:yin.debruijn/fingerprint \\\"3bdfdf0f7a4d58d783b000daa59d643c9426a7e32968f7ac211bfdbae0299fd9\\\", :yin.debruijn/datoms [[16 :yin.debruijn/hash \\\"3bdfdf0f7a4d58d783b000daa59d643c9426a7e32968f7ac211bfdbae0299fd9\\\" 0 1] [16 :yin.debruijn/type :application 0 1] [16 :yin.debruijn/operator \\\"68ed141e232db278a6ad62db526a2aafccb3140893315eef66c0b5174e900dc4\\\" 0 1] [17 :yin.debruijn/hash \\\"68ed141e232db278a6ad62db526a2aafccb3140893315eef66c0b5174e900dc4\\\" 0 1] [17 :yin.debruijn/type :variable 0 1] [17 :yin.debruijn/free list 0 1] [16 :yin.debruijn/operands [\\\"4a5c386aca1e08bb85ff2762ece0e59faaadf423674d009f56bcf4619a7ecff4\\\"] 0 1] [18 :yin.debruijn/hash \\\"4a5c386aca1e08bb85ff2762ece0e59faaadf423674d009f56bcf4619a7ecff4\\\" 0 1] [18 :yin.debruijn/type :literal 0 1] [18 :yin.debruijn/value (1 2.5) 0 1] [16 :yin.debruijn/root true 0 1]]} {:yin.debruijn/datoms [[16 :yin.debruijn/hash \\\"3bdfdf0f7a4d58d783b000daa59d643c9426a7e32968f7ac211bfdbae0299fd9\\\" 0 1] [16 :yin.debruijn/type :application 0 1] [16 :yin.debruijn/operator \\\"68ed141e232db278a6ad62db526a2aafccb3140893315eef66c0b5174e900dc