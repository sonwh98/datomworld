ey (inc d))]\\\\n  1047\\\\t    (wire/map-node wired)))\\\\n  1048\\\\t\\\\n  1049\\\\t\\\\n  1050\\\\t(defn- set-wire\\\\n  1051\\\\t  \\\\\\\"Tag 258 at depth d over an array at d+1; elements at d+2.\\\\\\\"\\\\n  1052\\\\t  [s d]\\\\n  1053\\\\t  (deep! (inc d) :unsupported-value)\\\\n  1054\\\\t  (let [wired (members-wire (map (fn [x] [x nil]) s)\\\\n  1055\\\\t                            true\\\\n  1056\\\\t                            :duplicate-element\\\\n  1057\\\\t                            (+ d 2))]\\\\n  1058\\\\t    (wire/tagged 258 (mapv second (sort-by first wired)))))\\\\n  1059\\\\t\\\\n  1060\\\\t\\\\n  1061\\\\t(defn- meta-wire\\\\n  1062\\\\t  \\\\\\\"The wire node of x at depth d, where (build depth) wires x's own\\\\n  1063\\\\t   content starting at that depth. If x carries metadata that survives\\\\n  1064\\\\t   stripping, a with-meta frame sits at d and x's content moves two\\\\n  1065\\\\t   levels deeper (tag, [meta value]). Stripped values are validated\\\\n  1066\\\\t   first (ruling A9); a metadata map carrying its own metadata is\\\\n  1067\\\\t   refused (ruling A3).\\\\\\\"\\\\n  1068\\\\t  [x d build]\\\\n  1069\\\\t  (let [m (meta x)]\\\\n  1070\\\\t    (if (nil? m)\\\\n  1071\\\\t      (build d)\\\\n  1072\\\\t      (do (when (some? (meta m))\\\\n  1073\\\\t            (refuse :malformed-frame \\\\\\\"metadata map carries metadata\\\\\\\"))\\\\n  1074\\\\t          (doseq [k reader-position-keys\\\\n  1075\\\\t                  :when (contains? m k)]\\\\n  1080\\\\t              (wire/frame 'clojure/with-meta\\\\n  1081\\\\t                          [(map-wire kept (+ d 2)) (build (+ d 2))])))))))\\\\n  1082\\\\t\\\\n  1083\\\\t\\\\n  1084\\\\t(defn- identifier-wire\\\\n  1085\\\\t  \\\\\\\"Tag 27 at depth d over [name [ns name]]: the components at d+3.\\\\\\\"\\\\n  1086\\\\t  [tag-symbol x d]\\\\n  1087\\\\t  (deep! (+ d 3) :unsupported-value)\\\\n  1088\\\\t  (wire/frame tag-symbol\\\\n  1089\\\\t              (wire/array-node [(if-some [ns (namespace x)]\\\\n  1090\\\\t                                  (wire/text (check-text ns))\\\\n  1091\\\\t                                  (wire/null))\\\\n  1092\\\\t                                (wire/text (check-text (name x)))])))\\\\n  1093\\\\t\\\\n  1094\\\\t\\\\n  1095\\\\t(defn- list-wire\\\\n  1096\\\\t  \\\\\\\"Tag 27 at depth d over [\\\\\\\\\\\\\\\"dao.jing/list\\\\\\\\\\\\\\\" items]: items at d+3.\\\\\\\"\\\\n  1097\\\\t  [x d]\\\\n  1098\\\\t  (deep! (+ d 2) :unsupported-value)\\\\n  1099\\\\t  (wire/frame 'dao.jing/list (mapv #(wire-of % (+ d 3)) x)))\\\\n  1100\\\\t\\\\n  1101\\\\t\\\\n  1102\\\\t(defn- wire-of\\\\n  1103\\\\t  \\\\\\\"The wire tree of one value whose outermost item sits at depth d, or a\\\\n  1104\\\\t   refusal.\\\\\\\"\\\\n  1105\\\\t  [x d]\\\\n  1106\\\\t  (cond\\\\n  1107\\\\t    (nil? x) (do (deep! d :unsupported-value) (wire/null))\\\\n  1108\\\\t    (boolean? x) (do (deep! d :unsupported-value) (wire/bool x))\\\\n  1109\\\\t    (string? x) (do (deep! d :unsupported-value) (wire/text (check-text x)))\\\\n  1110\\\\t    ;; Keywords cannot carry metadata on any host (not IObj / IWithMeta;\\\\n  1111\\\\t    ;; pinned by a test), so there is none to wrap.\\\\n  1112\\\\t    (keyword? x) (identifier-wire 'dao.jing/keyword x d)\\\\n  1113\\\\t    (symbol? x) (meta-wire x d #(identifier-wire 'dao.jing/symbol x %))\\\\n  1114\\\\t    (wire/byte-payload? x) (do (deep! d :unsupported-value)\\\\n  1115\\\\t                               (wire/byte-string (copy-range x 0 (blen x))))\\\\n  1116\\\\t    (numeric? x) (number-wire x d)\\\\n  1117\\\\t    (record? x) (refuse :unsupported-value \\\\\\\"record\\\\\\\")\\\\n  1118\\\\t    (map? x) (meta-wire x d #(map-wire x %))\\\\n  1119\\\\t    (vector? x) (meta-wire x d (fn [d]\\\\n  1120\\\\t                                 (deep! d :unsupported-value)\\\\n  1121\\\\t                                 (wire/array-node\\\\n  1122\\\\t                                   (mapv #(wire-of % (inc d)) x))))\\\\n  1123\\\\t    (set? x) (meta-wire x d #(set-wire x %))\\\\n  1124\\\\t    (or (list? x) (seq? x)) (meta-wire x d #(list-wire x %))\\\\n  1125\\\\t    :else (refuse :unsupported-value (type-name x))))\\\\n  1126\\\\t\\\\n  1127\\\\t\\\\n  1128\\\\t(defn encode\\\\n  1129\\\\t  \\\\\\\"The canonical CBOR payload bytes of one supported value (byte[] on the\\\\n  1130\\\\t   JVM, Uint8Array on JavaScript, Uint8List on Dart). Refuses unsupported\\\\n  1131\\\\t   values, unpaired surrogates, nesting deeper than max-depth, and\\\\n  1132\\\\t   collections whose members collide after normalization.\\\\\\\"\\\\n  1133\\\\t  [value]\\\\n  1134\\\\t  (wire/encode (wire-of value 1)))\\\\n  1135\\\\t\\\\n   143\\\\tfixed, not backend-configurable. The hash covers only canonical payload\\\\n   144\\\\tbytes, never a backend coordinate, file frame, address envelope, or network\\\\n   145\\\\tmessage.\\\\n   146\\\\t\\\\n   147\\\\tSupported values are nil, booleans, strings, keywords, symbols, byte strings,\\\\n   148\\\\tvectors, finite lists/sequences, maps, sets, metadata, integers,\\\\n   149\\\\tfloating-point numbers, big integers, decimals, and ratios. Reject arbitrary\\\\n   150\\\\trecords, functions, and unsupported host objects before storage. The numeric\\\\n   151\\\\tcarriers described below are explicitly supported exceptions to the record\\\\n   152\\\\trestriction; arbitrary Boring records do not become Jing values. **This is\\\\n   153\\\\ta narrower domain than today's transitional `pr-str`-based encoder, which\\\\n   154\\\\taddresses anything printable/readable** — characters, `#inst`, `#uuid`, and\\\\n   155\\\\tother tagged literals are addressable today and have no slot in this\\\\n   156\\\\tsupported-values list or in Jing's four named CBOR extensions; they become\\\\n   157\\\\trejected, unsupported values once this plan lands. No current producer\\\\n   158\\\\temits them, so nothing observed breaks, but \\\\\\\"existing stores... must be\\\\n   159\\\\trebuilt together\\\\\\\" (*Addressing and clean break*) presumes every stored\\\\n   160\\\\tvalue is re-encodable under the new domain — an assumption this delta\\\\n   161\\\\tshould be checked against before rebuild, not discovered during it.\\\\n   162\\\\t\\\\n   163\\\\t- Normalize sorted collections to ordinary maps and sets. Sort map keys\\\\n   164\\\\t  and set elements lexicographically by unsigned canonical encoded bytes\\\\n   165\\\\t  (a proper prefix sorts first), not length-first. Reject duplicate canonical\\\\n   166\\\\t  keys or elements introduced by normalization instead of losing entries.\\\\n   167\\\\t  Supported maps/sets must also survive portable decoded equality without\\\\n   168\\\\t  collapsing entries: reject such collisions on encode and before decoded\\\\n   169\\\\t  collection construction, including numerically equal keys of different\\\\n   170\\\\t  kinds. Do not let the accepting host determine this boundary.\\\\n   171\\\\t- Encode strings as UTF-8 without Unicode normalization. Reject unpaired\\\\n   172\\\\t  high or low surrogates before encoding on every host, including in\\\\n   173\\\\t  identifier components and metadata; normal astral text and noncharacters\\\\n   174\\\\t  remain legal. Reject invalid UTF-8 on decode. Boring's own surrogate\\\\n   175\\\\t  pre-validation is unverified; Jing owns this rule regardless.\\\\n   176\\\\t- Lists and sequences share a representation distinct from vectors. Use\\\\n   177\\\\t  CBOR tag 27 with the name `dao.jing/list` and an array argument; plain\\\\n   178\\\\t  CBOR arrays represent vectors.\\\\n   179\\\\t- Preserve collection and symbol metadata using Boring's `clojure/with-meta`\\\\n   180\\\\t  mapping. Strip `:line`, `:column`, `:end-line`, and `:end-column`; omit empty\\\\n   181\\\\t  metadata. Clear metadata on internally constructed Dart collections\\\\n   182\\\\t  before attaching supplied metadata. Do not strip arbitrary user `:tag`\\\\n   183\\\\t  metadata as a workaround for Dart constructor metadata. This clearing\\\\n   184\\\\t  covers only collections Jing constructs at decode: a Dart producer\\\\n   185\\\\t  building a payload with `list` must still clear ClojureDart's constructor\\\\n   186\\\\t  metadata itself (`(with-meta (apply list xs) nil)`); that `dao.jing.md`\\\\n   187\\\\t  open item carries forward, it is not retired by this plan.\\\\n   188\\\\t- Encode **all** keywords and symbols as tag 27 with `dao.jing/keyword` or\\\\n   189\\\\t  `dao.jing/symbol` and `[namespace name]`, where namespace is nil or a\\\\n   545\\\\tand recreation is always safe.\\\\n   546\\\\t\\\\n   547\\\\tUpdate the main Jing design, backend documentation, and downstream canonical\\\\n   548\\\\tencoding references to describe the shared byte-store boundary and remove\\\\n   549\\\\tthe superseded transitional-printer limitations. Name exactly which\\\\n   550\\\\t`dao.jing.md` open items this plan retires — the canonical-encoding item\\\\n   551\\\\twith its three residuals (symbol metadata not address-significant,\\\\n   552\\\\tpathological print collisions, ambient print-var leakage), byte-array\\\\n   553\\\\tidentity hashing, and metadata carriage for the file/remote/DHT codecs —\\\\n   554\\\\tand which stay open: the intake transport's portable domain still carries\\\\n   555\\\\tno metadata, byte strings, or rich numerics (`dao.stream` Transit), so\\\\n   556\\\\tsuch payloads reach Jing only through direct `materialize!` calls and the\\\\n   557\\\\tintake fail-closed rule carries forward unchanged. The ClojureDart `list`\\\\n   558\\\\tproducer obligation likewise carries forward, as *Encoding contract*\\\\n   559\\\\trecords.\\\\n   560\\\\t\\\\n   517\\\\t  `dao.jing/canonical-bytes` is `dao.jing.cbor/encode`, every backend is a\\\\n   518\\\\t  byte store that carries the canonical bytes verbatim, and the file\\\\n   519\\\\t  backend's frame is the CBOR `[digest payload-bytes]` record. The\\\\n   520\\\\t  `pr-str`/EDN round-trip validator the file backend once needed is gone.\\\\n   521\\\\t  What remains open from that family is below.\\\\n   522\\\\t- **ClojureDart's `list` mints metadata.** On ClojureDart, `(list ...)` and\\\\n   523\\\\t  `(apply list ...)` return a list carrying `cljd.core`'s own reader metadata\\\\n   524\\\\t  (`{:line ... :column ... :end-line ... :end-column ... :tag\\\\n   525\\\\t  PersistentList}`), and vector literals can carry a Dart `Type` under\\\\n   526\\\\t  `:tag`. The codec strips reader positions but refuses a `Type`, so a\\\\n   527\\\\t  Dart producer must clear constructor metadata itself\\\\n   528\\\\t  (`(with-meta (apply list xs) nil)`) before handing a payload to\\\\n   529\\\\t  `dao.jing`; decoded lists carry none. This obligation carries forward\\\\n   530\\\\t  unchanged from `dao.jing.cbor.md`.\\\\n   531\\\\t- **The intake transport's portable domain is narrower than Jing's.** The\\\\n   532\\\\t  `dao.stream` Transit codec carries no metadata, byte strings, or rich\\\\n   533\\\\t  numerics, so such payloads reach Jing only through direct `materialize!`\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\ncollab/1790274832538-architect-cbor-dart-diagnosis.gpt-6-sol.stdout.log:14:{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_6\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"nl -ba src/cljc/dao/jing/cbor.cljc | sed -n '1059,1083p'; rg -n 'content-hash-keeps-the-set-tag|semantic-bytecode-strips-reader-positions-inside-payloads|list-literals-persist-in-memory' test/dao/jing_test.cljc test/yin/vm_test.cljc test/yin/vm/pipeline_test.cljc; rg -n 'ast->semantic-bytecode|strip|reader-position|with-meta|:tag|defn lit|defn- lit' src/cljc/yin/vm.cljc test/yin/vm_test.cljc test/yin/vm/pipeline_test.cljc | head -150; rg -n '81b5c03|cljd' deps.edn | head -30\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":n