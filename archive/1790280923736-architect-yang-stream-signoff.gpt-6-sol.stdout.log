{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/repl_test.cljc | sed -n '1,70p'; rg -n 'defn.*(cursor|next|make|put)|stream/next\"'!|stream/make'\"' src/cljc/yang/clojure src/cljc/yin | head -n 65\"","aggregated_output":"     1\t(ns yin.repl-test\n     2\t  (:require [clojure.string :as str]\n     3\t            [clojure.test :refer [deftest is testing]]\n     4\t            [dao.stream :as stream]\n     5\t            [dao.stream.ringbuffer :as ring]\n     6\t            [yin.repl :as repl]\n     7\t            [yin.vm.debruijn-code :as dcode]\n     8\t            [yin.vm.debruijn-register-code :as rcode]\n     9\t            [dao.stream.observer :as observer]))\n    10\t\n    11\t\n    12\t(defn- handle\n    13\t  [capacity]\n    14\t  (:dao.stream/handle\n    15\t    (ring/create! {:dao.stream/type ring/transport-type\n    16\t                   ring/capacity-key capacity})))\n    17\t\n    18\t\n    19\t(defn- oldest\n    20\t  [h]\n    21\t  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n    22\t\n    23\t\n    24\t(defn- evaluate\n    25\t  \"Evaluate each line in order against one state value, returning the last\n    26\t   result text.  The core is synchronous, so a test needs no driver.\"\n    27\t  [state lines]\n    28\t  (reduce (fn [[state _] line] (repl/eval-input state line))\n    29\t          [state nil]\n    30\t          lines))\n    31\t\n    32\t\n    33\t(deftest fresh-state-is-a-semantic-shell-with-an-untried-ledger\n    34\t  (let [state (repl/create-state)]\n    35\t    (is (= :semantic (:vm-type state))\n    36\t        \"the semantic VM is the default after Phase 4 (yin.vm.semantic.md §8)\")\n    37\t    (is (= :clojure (:lang state)))\n    38\t    (is (true? (:running? state)))\n    39\t    (is (= :untried (get-in state [:ledger :output]))\n    40\t        \"an idle medium has no last operation, so the ledger says so\")\n    41\t    (is (some? (:program-stream state))\n    42\t        \"the shell owns the program medium's writer handle\")\n    43\t    (is (some? (:observer state))\n    44\t        \"an observer is attached beside the VM, not inside it\")\n    45\t    (is (zero? (:ingress-gaps (:observer state))))\n    46\t    (is (some? (:row-stream state))\n    47\t        \"the semantic session owns a row medium beside the program medium\")\n    48\t    (is (some? (:row-observer state))\n    49\t        \"the VM's own observer is attached to the row medium\")\n    50\t    (is (zero? (:ingress-gaps (:row-observer state))))\n    51\t    (is (false? (:ingress-loss? state)))))\n    52\t\n    53\t\n    54\t(deftest ordinary-source-evaluates-locally\n    55\t  (let [[_ result] (repl/eval-input (repl/create-state) \"(+ 1 2)\")]\n    56\t    (is (= \"3\" result))))\n    57\t\n    58\t\n    59\t(deftest printed-output-precedes-the-value\n    60\t  (let [[state result] (repl/eval-input (repl/create-state) \"(println \\\"hi\\\")\")]\n    61\t    (is (= \"hi\\nnil\" result))\n    62\t    (is (= :dao.stream/blocked (get-in state [:ledger :output]))\n    63\t        \"the drain records the outcome that ended it\")))\n    64\t\n    65\t\n    66\t(deftest value-history-is-injected-for-the-next-evaluation\n    67\t  (let [[_ result] (evaluate (repl/create-state) [\"(+ 1 2)\" \"(+ *1 1)\"])]\n    68\t    (is (= \"4\" result))))\n    69\t\n    70\t\nrg: src/cljc/yang/clojure: No such file or directory (os error 2)\nsrc/cljc/yin/vm/debruijn_register_compile.cljc:224:      :stream/make\nsrc/cljc/yin/vm/ast_walker.cljc:456:        :stream/make (let [capacity (or (:buffer node)\nsrc/cljc/yin/vm/ast_walker.cljc:458:                           effect {:effect :stream/make, :capacity capacity}\nsrc/cljc/yin/vm/linearize.cljc:117:             :stream/make (emit! e :stream-make\nsrc/cljc/yin/vm/linearize.cljc:291:             :stream/make (emit! path [:stream-make (nth slots 0)])\nsrc/cljc/yin/vm/semantic.cljc:85:(defn- put-registers\nsrc/cljc/y