{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yang/clojure/stream_eval_test.cljc | sed -n '221,460p'\"","aggregated_output":"   221\t                          \"      _ (stream/put! t 2)\"\n   222\t                          \"      c (stream/cursor t)]\"\n   223\t                          \"  (stream/next! c))\")]))\n   224\t          \"put! never answers full; the oldest element is gone\"))))\n   225\t\n   226\t\n   227\t(deftest a-closed-stream-refuses-writes-and-ends-reads\n   228\t  (doseq [vm-type vm-types]\n   229\t    (testing (str vm-type)\n   230\t      (let [[state results]\n   231\t            (evaluate (session vm-type)\n   232\t                      [\"(def s (stream/make 4))\"\n   233\t                       \"(stream/put! s 1)\"\n   234\t                       \"(stream/close! s)\"\n   235\t                       \"(stream/put! s 2)\"\n   236\t                       \"(+ 1 2)\"\n   237\t                       drain-source\n   238\t                       \"(drain (stream/cursor s) [])\"\n   239\t                       (str \"(let [c (stream/cursor s)]\"\n   240\t                            \" (stream/next! c) (stream/next! c))\")])\n   241\t            [_ _ _ refused next-round _ drained past-end] results]\n   242\t        (is (error? refused) \"put! on a closed stream is an error\")\n   243\t        (is (str/includes? refused \"Stream append failed\"))\n   244\t        (is (= \"3\" next-round) \"the failed round is consumed, not replayed\")\n   245\t        (is (= \"[1]\" drained) \"the elements before the close remain\")\n   246\t        (is (= \"nil\" past-end) \"reading past a closed stream's end is nil\")\n   247\t        (is (true? (:running? state)))))))\n   248\t\n   249\t\n   250\t(deftest a-read-on-an-empty-stream-parks-and-the-round-is-consumed\n   251\t  (doseq [vm-type vm-types]\n   252\t    (testing (str vm-type)\n   253\t      (let [[state results]\n   254\t            (evaluate (session vm-type)\n   255\t                      [\"(def e (stream/make 2))\"\n   256\t                       \"(stream/next! (stream/cursor e))\"\n   257\t                       \"(+ 1 2)\"\n   258\t                       \"(stream/put! e 5)\"\n   259\t                       \"(stream/next! (stream/cursor e))\"])\n   260\t            [_ parked next-round put after] results\n   261\t            summary (repl/repl-state state)]\n   262\t        (is (error? parked)\n   263\t            \"a program that blocks on its own stream is not a halted one\")\n   264\t        (is (str/includes? parked \"runnable\"))\n   265\t        (is (= \"3\" next-round) \"the next input runs on the restored VM\")\n   266\t        (is (= [\"5\" \"5\"] [put after])\n   267\t            \"the stream outlives the parked round; a later read succeeds\")\n   268\t        (is (true? (get-in summary [:vm :halted?])))\n   269\t        (is (false? (get-in summary [:vm :blocked?])))))))\n   270\t\n   271\t\n   272\t;; =============================================================================\n   273\t;; The shell's own media: program-in, program-out, and output\n   274\t;; =============================================================================\n   275\t\n   276\t(deftest output-and-results-are-emitted-on-the-output-medium\n   277\t  (doseq [vm-type vm-types]\n   278\t    (testing (str vm-type)\n   279\t      (let [output (ring-handle 16)\n   280\t            [state results]\n   281\t            (evaluate (session vm-type output)\n   282\t                      [\"(do (print \\\"a\\\") (println \\\"b\\\") 7)\"\n   283\t                       \"(prn :k)\"])\n   284\t            token (:shell-token state)]\n   285\t        (is (= [\"ab\\n7\" \":k\\nnil\"] results)\n   286\t            \"printed text precedes the value in what the shell answers\")\n   287\t        (is (= [{:type :repl/output :op :print :text \"a\"}\n   288\t                {:type :repl/output :op :println :text \"b\\n\"}\n   289\t                {:type :repl/result :round [token 1] :value 7}\n   290\t                {:type :repl/output :op :prn :text \":k\\n\"}\n   291\t                {:type :repl/result :round [token 2] :value nil}\n   292\t                [:end :dao.stream/blocked]]\n   293\t               (read-all output))\n   294\t            \"every print is an element, and each round ends in its result\")\n   295\t        (is (= :dao.stream/blocked (get-in state [:ledger :output]))\n   296\t            \"the drain ran to the end of the medium\")))))\n   297\t\n   298\t\n   299\t(deftest programs-are-ingested-as-batches-on-the-program-media\n   300\t  (doseq [vm-type vm-types]\n   301\t    (testing (str vm-type)\n   302\t      (let [[state results]\n   303\t            (evaluate (session vm-type)\n   304\t                      [\"(+ 1 2)\"\n   305\t                       \"(help)\"\n   306\t                       \"(let [s (stream/make 2)] (stream/put! s :v))\"\n   307\t                       \"(repl-state)\"\n   308\t                       \"(stream/put! 1 2)\"])\n   309\t            batches (butlast (read-all (:program-stream state)))\n   310\t            packets (butlast (read-all (:row-stream state)))]\n   311\t        (is (= [\"3\" \":v\"] [(nth results 0) (nth results 2)]))\n   312\t        (is (error? (nth results 4)) \"a bad put! fails in the evaluator\")\n   313\t        (is (= 3 (count batches))\n   314\t            \"one batch per program; a command appends nothing\")\n   315\t        (doseq [batch batches]\n   316\t          (is (= :yin.program/batch (first batch)))\n   317\t          (is (vector? (second batch)) \"the batch carries its rows\"))\n   318\t        (is (= 3 (count packets))\n   319\t            \"the expander forwards every program, the failing one too\")\n   320\t        (doseq [[root rows] packets]\n   321\t          (is (some #(= root (first %)) rows)\n   322\t              \"a packet's root names one of its own rows\"))\n   323\t        (is (zero? (get-in (repl/repl-state state) [:vm :in-stream :gaps]))\n   324\t            \"no batch was lost on the way\")))))\n   325\t\n   326\t\n   327\t;; =============================================================================\n   328\t;; Multi-turn sessions\n   329\t;; =============================================================================\n   330\t\n   331\t(deftest a-session-threads-definitions-streams-and-history\n   332\t  (doseq [vm-type vm-types]\n   333\t    (testing (str vm-type)\n   334\t      (let [[state results]\n   335\t            (evaluate (session vm-type)\n   336\t                      [\"(def s (stream/make 4))\"\n   337\t                       \"(defn twice [x] (* 2 x))\"\n   338\t                       \"(stream/put! s 1)\"\n   339\t                       \"(def c (stream/cursor s))\"\n   340\t                       \"(stream/next! c)\"\n   341\t                       \"(+ *1 41)\"\n   342\t                       \"(twice *1)\"\n   343\t                       \"(stream/put! s (+ *1 (+ *2 *3)))\"\n   344\t                       \"(stream/next! c)\"])]\n   345\t        (is (= [\"1\" \"42\" \"84\" \"127\" \"127\"] (drop 4 results))\n   346\t            \"a stream, a closure, and the history span successive rounds\")\n   347\t        (is (= [127 127 84]\n   348\t               [(:last-value state)\n   349\t                (:last-value-2 state)\n   350\t                (:last-value-3 state)]))))))\n   351\t\n   352\t\n   353\t(deftest reset-and-vm-selection-forget-streams-with-the-session\n   354\t  (doseq [vm-type vm-types\n   355\t          command [\"(reset)\" \"(vm :semantic)\"]]\n   356\t    (testing (str vm-type \" \" command)\n   357\t      (let [[state results]\n   358\t            (evaluate (session vm-type)\n   359\t                      [\"(def s (stream/make 4))\"\n   360\t                       \"(stream/put! s 1)\"\n   361\t                       \"(def c (stream/cursor s))\"\n   362\t                       command\n   363\t       