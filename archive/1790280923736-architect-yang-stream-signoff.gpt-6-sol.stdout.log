\\t        (throw (ex-info \\\"Content file is closed\\\" {:address address})))\\n   379\\t      (if (contains? content address)\\n   380\\t        (cbor/copy-bytes (clojure.core/get content address))\\n   381\\t        not-found))))\\n   382\\t\\n   383\\t\\n   384\\t(defn- make-close\\n   385\\t  [state f lock]\\n   284\\t                                       (canonical-class (val entry))))\\n   285\\t                                v))\\n   286\\t               :map)\\n   287\\t    (set? v) (when (every? canonical-class v) :set)\\n   288\\t    (vector? v) (when (every? canonical-class v) :vector)\\n   289\\t    (sequential? v) (when (every? canonical-class v) :list)\\n   290\\t    (number? v) (numeric-class v)))\\n   291\\t\\n   292\\t\\n   293\\t(defn canonical-value?\\n   294\\t  \\\"True when `v` is inside §5's canonical value domain — equivalently,\\n   295\\t   when `canonical-class` is non-nil.\\\"\\n   296\\t  [v]\\n   297\\t  (some? (canonical-class v)))\\n   298\\t\\n   299\\t\\n   300\\t(defn normalize-nfc\\n   301\\t  \\\"The one NFC seam of the projection (§5): every string entering\\n   302\\t   canonical encoding passes through here. :clj delegates to\\n   303\\t   java.text.Normalizer, :cljs to String.prototype.normalize, and :cljd\\n   304\\t   to the unorm_dart package (Unicode 16.0, owner-settled 2026-09-21) so\\n   305\\t   every ClojureDart target normalizes identically. NFC normalisation\\n   306\\t   collisions — distinct inputs with one composed form — are an\\n   307\\t   inherited limit of the repository encoding.\\\"\\n   308\\t  [^String s]\\n   309\\t  #?(:clj (java.text.Normalizer/normalize s java.text.Normalizer$Form/NFC)\\n   310\\t     :cljs (.normalize s \\\"NFC\\\")\\n   311\\t     :cljd (unorm/nfc s)))\\n   312\\t\\n  1160\\t\\n  1161\\t\\n  1162\\t(def ^:private record-attributes\\n  1163\\t  \\\"Every attribute a projected record entity may carry: the declared\\n  1164\\t   dimension slots, markers included.\\\"\\n  1165\\t  (into #{} (map first) dimension-slots))\\n  1166\\t\\n  1167\\t\\n  1168\\t(defn- slot-shape-ok?\\n  1169\\t  \\\"Whether `v` fits the descriptor `type` on a projected record: the\\n  1170\\t   deterministic gate the storage reader hashes behind, so a wrongly\\n  1171\\t   typed slot — :yin.debruijn/bound 5, a numeric child ref — diagnoses\\n  1172\\t   :unsupported-value instead of reaching host arithmetic inside the\\n  1173\\t   hash recomputation.\\\"\\n  1174\\t  [type v]\\n  1175\\t  (cond\\n  1176\\t    (= :canonical type) (canonical-value? v)\\n  1177\\t    (= :keyword type) (keyword? v)\\n  1178\\t    (= :symbol type) (symbol? v)\\n  1179\\t    (= :string type) (string? v)\\n  1180\\t    (= :bool type) (or (true? v) (false? v))\\n  1181\\t    (= :int64 type) (and (number? v) (= :int64 (numeric-class v)))\\n  1182\\t    (or (= :ref type) (= :hash type)) (and (string? v)\\n  1183\\t                                           (re-matches #\\\"^[0-9a-f]{64}$\\\" v))\\n   485\\t        (lit 1.5)\\n   486\\t        (lit :ns/kw)\\n   487\\t        (lit 'ns/sym)\\n   488\\t        (lit [1 \\\"a\\\" :k])\\n   489\\t        (lit #{1 \\\"b\\\" :c})\\n   490\\t        (lit {:a [1 2], \\\"k\\\" #{nil}}))])\\n   491\\t\\n   492\\t\\n   493\\t(deftest every-node-type-and-scalar-class-round-trips-through-durable-storage\\n   494\\t  (let [path (temp-path)]\\n   495\\t    (try\\n   496\\t      (let [store (jing-file/create-content-file path)\\n   497\\t            addresses (mapv (fn [ast]\\n   498\\t                              (get-in (persist! ast (recording-writer) store)\\n   499\\t                                      [:projected :address]))\\n   500\\t                            durable-programs)\\n   501\\t            _ (jing/close! store)\\n   502\\t            reopened (jing-file/create-content-file path)\\n   503\\t            stored (mapv (fn [address]\\n   504\\t                           (:yin.debruijn/datoms (jing/get reopened address ::absent)))\\n   505\\t                         addresses)]\\n   506\\t        (jing/close! reopened)\\n   507\\t        (is (every? jing/segment-address? addresses))\\n   508\\t        (doseq [[ast datoms] (map vector durable-programs stored)]\\n   509\\t          (is (= (select-keys (debruijn/project-datoms\\n   510\\t                                (second (vm/ast->datoms-with-root ast)))\\n   511\\t                              [:fingerprint :records])\\n   512\\t                 (debruijn/datoms->projected datoms))\\n   513\\t              \\\"the reopened envelope reads back to the original projection\\\")))\\n   514\\t      (finally (cleanup-file path)))))\\n   515\\t\\n   516\\t\\n   517\\t(def ^:private host\\n   567\\t              (when (= :ok (:outcome projected))\\n   568\\t                (is (= original\\n   569\\t                       (let [reopened (jing-file/create-content-file path)\\n   570\\t                             stored (:yin.debruijn/datoms\\n   571\\t                                      (jing/get reopened (:address projected) ::absent))]\\n   572\\t                         (jing/close! reopened)\\n   573\\t                         (debruijn/datoms->projected stored)))\\n   574\\t                    \\\"hosts already shown to carry the value carry it exactly\\\"))))\\n   575\\t          (finally (cleanup-file path)))))))\\n   576\\t\\n   577\\t\\n   578\\t(deftest list-literals-persist-in-memory\\n   579\\t  ;; the durable file codec does not carry lists on every host; the\\n   580\\t  ;; pipeline itself does, and keeps a list distinct from a vector\\n   581\\t  (let [store (mem-store)\\n   582\\t        as-list (persist! (app (v 'list) (lit (list 1 2.5))) (recording-writer) store)\\n   583\\t        as-vector (persist! (app (v 'list) (lit [1 2.5])) (recording-writer) store)]\\n   584\\t    (is (= :ok (:outcome (:projected as-list)) (:outcome (:projected as-vector))))\\n   585\\t    (is (= {:yin.debruijn/fingerprint (get-in as-list [:projected :fingerprint]),\\n   586\\t            :yin.debruijn/datoms (debruijn/projected->datoms\\n   587\\t                                   (debruijn/project-datoms\\n   588\\t                                     (second (vm/ast->datoms-with-root\\n   589\\t                                               (app (v 'list) (lit (list 1 2.5)))))))}\\n   590\\t           (jing/get store (get-in as-list [:projected :address]) ::absent)))\\n   591\\t    (is (not= (get-in as-list [:projected :fingerprint])\\n   592\\t              (get-in as-vector [:projected :fingerprint])))))\\n   593\\t\\n   594\\t\\n   595\\t(deftest renamed-programs-store-equal-projected-datoms\\n   527\\t  Dart producer must clear constructor metadata itself\\n   528\\t  (`(with-meta (apply list xs) nil)`) before handing a payload to\\n   529\\t  `dao.jing`; decoded lists carry none. This obligation carries forward\\n   530\\t  unchanged from `dao.jing.cbor.md`.\\n   531\\t- **The intake transport's portable domain is narrower than Jing's.** The\\n   532\\t  `dao.stream` Transit codec carries no metadata, byte strings, or rich\\n   533\\t  numerics, so such payloads reach Jing only through direct `materialize!`\\n   534\\t  calls; the intake fail-closed rule carries forward unchanged.\\n   535\\t- **Decoded numeric carriers on JavaScript.** Floating-point, decimal, and\\n   536\\t  rational content decode to Jing's portable carriers on JavaScript, never\\n   537\\t  to a bare number; a consumer that reads values back from a store and\\n   538\\t  pattern-matches on host number types (today, `yin.vm.debruijn`'s slot\\n   539\\t  type check) must accept the carriers, per `dao.jing.cbor.md`'s numeric\\n   540\\t  identity section.\\n   541\\t- **Durable observer checkpoints / long-running runner.** `observer-state`\\n   542\\t  and `observe-step!` are single-step and in-process. The checkpoint records,\\n   543\\t  per member, the stream coordinate plus the transport-minted cursor; the\\n\",\"exit_code\":0,\"status\":\"comple