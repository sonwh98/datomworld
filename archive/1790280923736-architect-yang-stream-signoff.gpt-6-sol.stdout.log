\n   112\t  \"Map from [operation outcome] to required keys in the result map.\"\n   113\t  {[:create! :dao.stream/ok] #{:dao.stream/handle}\n   114\t   [:attach! :dao.stream/ok] #{:dao.stream/handle}\n   115\t   [:descriptor :dao.stream/ok] #{:dao.stream/descriptor :dao.stream/identity}\n   116\t   [:cursor :dao.stream/ok] #{:dao.stream/cursor}\n   117\t   [:next :dao.stream/ok] #{:dao.stream/value :dao.stream/cursor}\n   118\t   [:next :dao.stream/gap] #{:dao.stream/cursor}})\n   119\t\n   120\t\n   121\t;; =============================================================================\n   122\t;; Canonical Operation Resolution Helper\n   123\t;; =============================================================================\n   124\t\n   125\t(defn canonical-op\n   126\t  \"Normalizes op to canonical keyword (:create!, :attach!, :descriptor,\n   127\t   :cursor, :next, :append!, :close!). Supports aliases without '!'.\"\n   128\t  [op]\n   129\t  (case op\n   130\t    (:create :create!) :create!\n   131\t    (:attach :attach!) :attach!\n   132\t    (:descriptor) :descriptor\n   133\t    (:cursor) :cursor\n   134\t    (:next) :next\n   135\t    (:append :append!) :append!\n   136\t    (:close :close!) :close!\n   137\t    nil))\n   138\t\n   139\t\n   140\t;; =============================================================================\n   141\t;; Handle Protocols (Five Handle Operations)\n   142\t;; =============================================================================\n   143\t\n   144\t(defprotocol IDaoStreamDescriptor\n   145\t  \"Universal reachability and identity projection. Belongs to no surface:\n   146\t   implemented by every handle regardless of declared reader/writer/closable surfaces.\"\n   147\t\n   148\t  (descriptor\n   149\t    [handle]\n   150\t    \"Returns descriptor outcome map:\n   151\t     {:dao.stream/outcome :dao.stream/ok\n   152\t      :dao.stream/descriptor <portable-descriptor>\n   153\t      :dao.stream/identity <logical-stream-identity>}\"))\n   154\t\n   155\t\n   156\t(defprotocol IDaoStreamReader\n   157\t  \"Reader surface: positioned, non-destructive observation via immutable cursors.\"\n   158\t\n   159\t  (cursor\n   160\t    [handle anchor]\n   161\t    \"Mint an immutable cursor from anchor (:dao.stream/oldest, :dao.stream/newest,\n   162\t     or transport-specific anchor).\n   163\t     Returns outcome map with :dao.stream/cursor on :dao.stream/ok.\")\n   164\t\n   165\t  (next\n   166\t    [handle cursor]\n   167\t    \"Read the value at cursor position. Total and non-blocking.\n   168\t     Returns read outcome map.\"))\n   169\t\n   170\t\n   171\t(defprotocol IDaoStreamWriter\n   172\t  \"Writer surface: append values to the sequence this handle's writer surface is on.\"\n   173\t\n   174\t  (append!\n   175\t    [handle val]\n   176\t    \"Append val to the sequence. Total and non-blocking.\n   177\t     Returns write outcome map.\"))\n   178\t\n   179\t\n   180\t(defprotocol IDaoStreamClosable\n   181\t  \"Closable surface: close what this handle is on (logical stream or attachment).\n   182\t   Idempotent.\"\n   183\t\n   184\t  (close!\n   185\t    [handle]\n   186\t    \"Closes what this handle is on. Irrevocable.\n   187\t     Returns outcome map {:dao.stream/outcome :dao.stream/ok}.\"))\n   188\t\n   189\t\n   190\t;; =============================================================================\n   191\t;; Surface Inspection & Gating\n   192\t;; =============================================================================\n   193\t\n   194\t(defn reader?\n   195\t  \"True if handle implements the reader surface (IDaoStreamReader).\"\n","exit_code":0,"status":"completed"}}
