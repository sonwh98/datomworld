rs a stream reference\")\n   185\t        (is (= [\"1\" \"2\" \"3\"] [put-1 put-2 put-3]) \"put! answers the value\")\n   186\t        (is (= \"nil\" closed) \"close! answers nil\")\n   187\t        (is (stream-ref? out))\n   188\t        (is (= out pumped) \"the pump returns the output stream it filled\")\n   189\t        (is (= \"nil\" closed-out))\n   190\t        (is (= \"[10 20 30]\" drained)\n   191\t            \"the transformed elements are read back in order\")\n   192\t        (is (= \"[1 2 3]\" replayed)\n   193\t            \"a second cursor on the source reads its whole history again\")\n   194\t        (is (= [1 2 3] (:last-value state)))))))\n   195\t\n   196\t\n   197\t(deftest a-cursor-is-one-readers-progress\n   198\t  (doseq [vm-type vm-types]\n   199\t    (testing (str vm-type)\n   200\t      (is (= [\"1\" \"2\" \"1\" \"1\"]\n   201\t             (drop 4 (texts vm-type\n   202\t                            [\"(def s (stream/make 4))\"\n   203\t                             \"(stream/put! s 1)\"\n   204\t                             \"(stream/put! s 2)\"\n   205\t                             \"(def c (stream/cursor s))\"\n   206\t                             \"(stream/next! c)\"\n   207\t                             \"(stream/next! c)\"\n   208\t                             \"(stream/next! (stream/cursor s))\"\n   209\t                             (str \"(let [c2 (stream/cursor s)]\"\n   210\t                                  \" (stream/next! c2))\")])))\n   211\t          \"a held cursor advances per read; a fresh one starts at oldest\"))))\n   212\t\n   213\t\n   214\t(deftest a-full-ring-evicts-its-oldest-element\n   215\t  (doseq [vm-type vm-types]\n   216\t    (testing (str vm-type)\n   217\t      (is (= [\"2\"]\n   218\t             (texts vm-type\n   219\t                    [(str \"(let [t (stream/make 1)\"\n   220\t                          \"      _ (stream/put! t 1)\"\n   221\t                          \"      _ (stream/put! t 2)\"\n   222\t                          \"      c (stream/cursor t)]\"\n   223\t                          \"  (stream/next! c))\")]))\n   224\t          \"put! never answers full; the oldest element is gone\"))))\n   225\t\n   226\t\n   227\t(deftest a-closed-stream-refuses-writes-and-ends-reads\n   228\t  (doseq [vm-type vm-types]\n   229\t    (testing (str vm-type)\n   230\t      (let [[state results]\n   231\t            (evaluate (session vm-type)\n   232\t                      [\"(def s (stream/make 4))\"\n   233\t                       \"(stream/put! s 1)\"\n   234\t                       \"(stream/close! s)\"\n   235\t                       \"(stream/put! s 2)\"\n   236\t                       \"(+ 1 2)\"\n   237\t                       drain-source\n   238\t                       \"(drain (stream/cursor s) [])\"\n   239\t                       (str \"(let [c (stream/cursor s)]\"\n   240\t                            \" (stream/next! c) (stream/next! c))\")])\n   241\t            [_ _ _ refused next-round _ drained past-end] results]\n   242\t        (is (error? refused) \"put! on a closed stream is an error\")\n   243\t        (is (str/includes? refused \"Stream append failed\"))\n   244\t        (is (= \"3\" next-round) \"the failed round is consumed, not replayed\")\n   245\t        (is (= \"[1]\" drained) \"the elements before the close remain\")\n   246\t        (is (= \"nil\" past-end) \"reading past a closed stream's end is nil\")\n   247\t        (is (true? (:running? state)))))))\n   248\t\n   249\t\n   250\t(deftest a-read-on-an-empty-stream-parks-and-the-round-is-consumed\n   251\t  (doseq [vm-type vm-types]\n   252\t    (testing (str vm-type)\n   253\t      (let [[state results]\n   254\t            (evaluate (session vm-type)\n   255\t                      [\"(def e (stream/make 2))\"\n   256\t                       \"(stream/next! (stream/cursor e))\"\n   257\t                       \"(+ 1 2)\"\n   258\t                       \"(stream/put! e 5)\"\n   259\t