{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '560,1000p' src/cljc/yin/vm/ucf/handoff.cljc | nl -ba -v560; nl -ba test/yin/vm/ucf/handoff_test.cljc\"","aggregated_output":"   560\t   module of the registry under its manifest address.\"\n   561\t  [vm]\n   562\t  (into {}\n   563\t        (map (fn [[m entry]]\n   564\t               [m {:yin.k/manifest (:address entry)}]))\n   565\t        (module/module-entries (:modules vm))))\n   566\t\n   567\t\n   568\t(defn- export-refusals\n   569\t  \"The completion walk's refusals as one data outcome.\"\n   570\t  [refusals]\n   571\t  (when-some [r (first refusals)]\n   572\t    (refuse! (if (= :yin.k/not-quiescent (:kind r))\n   573\t               :yin.k/not-quiescent\n   574\t               :yin.k/non-portable)\n   575\t             (assoc (dissoc r :kind) :yin.k/kind (:kind r)))))\n   576\t\n   577\t\n   578\t(defn- snapshot-module-stores\n   579\t  \"The encoded store snapshot of every module the encoding reached,\n   580\t   exactly as it stands in the task at export, mutations included.\"\n   581\t  [vm encode found]\n   582\t  (when-some [m (first (remove #(contains? (:module-stores vm) %)\n   583\t                               (sort-by str (:stores @found))))]\n   584\t    (non-portable! :missing-module-store {engine/store-of-key m}))\n   585\t  (into {}\n   586\t        (map (fn [m]\n   587\t               [m (into {}\n   588\t                        (map (fn [[k v]] [(encode k) (encode v)]))\n   589\t                        (get (:module-stores vm) m))]))\n   590\t        (sort-by str (:stores @found))))\n   591\t\n   592\t\n   593\t(defn export-task\n   594\t  \"The lift of 14.1.2: `vm`, a blocked or halted task at a safepoint,\n   595\t   as canonical bytes under their content address.  Answers\n   596\t   `{:status :ok :kind k :body b :bytes encoded :address a}` with `k`\n   597\t   `:blocked`, `:parked` or `:halted`, or the S7.9 data outcome of the\n   598\t   first refusal -- `:yin.k/not-quiescent` for queued work,\n   599\t   `:yin.k/not-at-safepoint` for an undeclared pc, `:yin.k/non-portable`\n   600\t   for a value or reference that cannot cross, `:yin.k/unsatisfied`\n   601\t   for a stream that cannot be served, a cursor that cannot survive\n   602\t   the canonical codec, or -- when `opts` names cursor profiles that\n   603\t   do not cover the cells -- a claim the body cannot make.\n   604\t   `serve!` is the exporter's remote-table entry, exactly\n   605\t   `yin.vm.ucf.remote`'s.\"\n   606\t  ([vm serve!]\n   607\t   (export-task vm serve! nil))\n   608\t  ([vm serve! opts]\n   609\t   (call!\n   610\t     (fn []\n   611\t       (when (seq (:ready-queue vm))\n   612\t         (refuse! :yin.k/not-quiescent\n   613\t                  {:yin.k/ready (count (:ready-queue vm))}))\n   614\t       (let [walked (completion/complete\n   615\t                      {:vm vm\n   616\t                       :cursor-profile (constantly :dao.stream.remote/v1)\n   617\t                       :modules (module-decls vm)})\n   618\t             _ (export-refusals (:yin.k/refusals walked))\n   619\t             ;; the pending-child gap the walk cannot close itself: an\n   620\t             ;; obligation a live install child will bind when it\n   621\t             ;; completes is discharged by the child this body carries\n   622\t             ;; beside the waiter, not by a store the emitter holds\n   623\t             installing (into #{}\n   624\t                              (mapcat (fn [[m inst]]\n   625\t                                        (map (fn [x]\n   626\t                                               (symbol (str (name m) \"/\"\n   627\t                                                            (name x))))\n   628\t                                             (get-in inst\n   629\t                                                     [:response :manifest\n   630\t                                                      :yin.module/exports])))\n   631\t                                      (:installs vm)))\n   632\t             missing (update (:yin.k/missing walked) :obligations\n   633\t                             #(set/difference (set %) installing))\n   634\t             discovery (cond\n   635\t                         (seq (:segments missing)) :blocked\n   636\t                         (some seq (vals (dissoc missing :segments)))\n   637\t                         :incomplete\n   638\t                         :else :complete)]\n   639\t         (when-not (= :complete discovery)\n   640\t           (refuse! :yin.k/unsatisfied\n   641\t                    {:yin.k/discovery discovery\n   642\t                     :yin.k/missing missing}))\n   643\t         (let [value (:value vm)\n   644\t               active (and (map? value)\n   645\t                           (= :parked-continuation (:type value))\n   646\t                           (contains? (:parked vm) (:id value)))\n   647\t               active-rec (when active (get (:parked vm) (:id value)))\n   648\t               kind (cond\n   649\t                      active :parked\n   650\t                      (engine/halted-with-empty-queue? vm) :halted\n   651\t                      (seq (:wait-set vm)) :blocked\n   652\t                      :else (not-at-safepoint!\n   653\t                              (get-in vm [:control :pc])))\n   654\t               _ (when (and (= :halted kind) (seq (:wait-set vm)))\n   655\t                   (non-portable! :inconsistent-halt {}))\n   656\t               _ (when (and active\n   657\t                            (not (some #(= :explicit-park %)\n   658\t                                       (safepoint-kinds-at\n   659\t                                         vm (:segment active-rec)\n   660\t                                         (:pc active-rec)))))\n   661\t                   (non-portable! :reason-mismatch\n   662\t                                  {:yin.k/pc (:pc active-rec)}))\n   663\t               found (atom {:cells {} :cell-of {} :markers {}\n   664\t                            :stores #{} :segments #{}})\n   665\t               encode (value-encoder vm serve! found)\n   666\t               frames (mapv (partial lift-frame! vm serve! found encode)\n   667\t                            (:wait-set vm))\n   668\t               parked (into {}\n   669\t                            (map (fn [[pid rec]]\n   670\t                                   (safepoint-kinds-at vm (:segment rec)\n   671\t                                                       (:pc rec))\n   672\t                                   [pid (encode-registers found encode\n   673\t                                                          vm rec)]))\n   674\t                            (:yin.k/parked (:yin.k/scheduler walked)))\n   675\t               store (into {}\n   676\t                           (map (fn [[k v]] [(encode k) (encode v)]))\n   677\t                           (:yin.k/store walked))\n   678\t               module-stores (snapshot-module-stores vm encode found)\n   679\t               installs (export-installs vm serve!)\n   680\t               cells (:cells @found)\n   681\t               profiles (or (:cursor-profiles opts)\n   682\t                            (if (seq cells)\n   683\t                              ucf.remote/cursor-profiles\n   684\t                              #{}))\n   685\t               _ (when (and (seq cells)\n   686\t                            (not (contains? profiles\n   687\t                                            :dao.stream.remote/v1)))\n   688\t                   (unsatisfied!))\n   689\t               segments (:segments @found)\n   690\t               fetch (completion/vm-fetch vm nil)\n   691\t               code (into {}\n   692\t                          (map (fn [a]\n   693\t                                 (if-some [v (fetch a)]\n   694\t                                   [a v]\n   695\t                                   (refuse! :yin.k/unsatisfied\n   696\t                                            {:yin.k/segment a}))))\n   697\t                          (sort-by str segments))\n   698\t               body (cond-> {handoff-tag true\n   699\t                             :yin.k/version handoff-version\n   700\t                             :yin.k/kind kind\n   701\t                             :yin.k/contract ucf/contract-stamp\n   702\t                             :yin.k/id-counter (or (:id-counter vm) 0)\n   703\t                             :yin.k/store store\n   704\t                             :yin.k/module-stores module-stores\n   705\t                             :yin.k/parked parked\n   706\t                             :yin.k/cells cells\n   707\t                             :yin.k/requires\n   708\t                             {:yin.k/cursor-profiles profiles\n   709\t                              :yin.k/segments (set segments)}\n   710\t                             :yin.k/code code}\n   711\t                      (seq installs)\n   712\t                      (assoc :yin.k/installs installs)\n   713\t                      (seq frames)\n   714\t                      (assoc :yin.k/frames frames)\n   715\t                      (= :parked kind)\n   716\t                      (assoc :yin.k/parked-id (:id value))\n   717\t                      (= :halted kind)\n   718\t                      (assoc :yin.k/result (encode (:value vm))))\n   719\t               bytes (cbor/encode body)\n   720\t               _ (validate-body (cbor/decode bytes))]\n   721\t           {:status :ok\n   722\t            :kind kind\n   723\t            :body body\n   724\t            :bytes bytes\n   725\t            :address (jing/content-hash body)}))))))\n   726\t\n   727\t\n   728\t;; =============================================================================\n   729\t;; Grammar (S7.5.4): total, before anything is attached or restored\n   730\t;; =============================================================================\n   731\t\n   732\t(defn- marker?\n   733\t  [x]\n   734\t  (and (map? x) (= :yin.k/stream (:yin.k/tag x))\n   735\t       (string? (:dao.stream/identity x))\n   736\t       (map? (:dao.stream/descriptor x))))\n   737\t\n   738\t\n   739\t(defn- tagged-of\n   740\t  \"Every marker tagged `tag` inside `x`, map keys and values both: a\n   741\t   sealed reference may sit anywhere an encoded value can, including\n   742\t   a store key or a literal entry, so the walk covers both halves of\n   743\t   every map it meets.\"\n   744\t  [tag x]\n   745\t  (into []\n   746\t        (comp (filter #(and (map? %) (= tag (:yin.k/tag %))))\n   747\t              (distinct))\n   748\t        (tree-seq coll? (fn [n]\n   749\t                          (if (map? n)\n   750\t                            (concat (keys n) (vals n))\n   751\t                            (seq n)))\n   752\t                  x)))\n   753\t\n   754\t\n   755\t(defn- cell-ids-of\n   756\t  \"Every cell id the value's cursor-ref markers name.\"\n   757\t  [x]\n   758\t  (into #{}\n   759\t        (map :yin.k/cell)\n   760\t        (tagged-of :yin.k/cursor-ref x)))\n   761\t\n   762\t\n   763\t(defn- check-cell\n   764\t  [cells cid path]\n   765\t  (when-not (map? (get cells cid))\n   766\t    (undecodable! {:yin.k/cell cid :yin.k/path path})))\n   767\t\n   768\t\n   769\t(defn- require-keys\n   770\t  [pending keys path]\n   771\t  (doseq [k keys]\n   772\t    (when-not (contains? pending k)\n   773\t      (undecodable! {:yin.k/path (conj path k)}))))\n   774\t\n   775\t\n   776\t(defn- validate-pending\n   777\t  [cells pending path]\n   778\t  (let [reason (:yin.k/reason pending)]\n   779\t    (case reason\n   780\t      (:next :ffi)\n   781\t      (do (require-keys pending [:yin.k/cell] path)\n   782\t          (check-cell cells (:yin.k/cell pending)\n   783\t                      (conj path :yin.k/cell)))\n   784\t\n   785\t      :put\n   786\t      (do (require-keys pending [:yin.k/value] path)\n   787\t          (when-not (marker? (:yin.k/stream pending))\n   788\t            (undecodable! {:yin.k/path (conj path :yin.k/stream)})))\n   789\t\n   790\t      :ffi-request\n   791\t      (do (require-keys pending [:yin.k/call-id :yin.k/request-envelope\n   792\t                                 :yin.k/request :yin.k/response\n   793\t                                 :yin.k/response-cell]\n   794\t                        path)\n   795\t          (check-cell cells (:yin.k/response-cell pending)\n   796\t                      (conj path :yin.k/response-cell))\n   797\t          (when-not (marker? (:yin.k/request pending))\n   798\t            (undecodable! {:yin.k/path (conj path :yin.k/request)}))\n   799\t          (when-not (marker? (:yin.k/response pending))\n   800\t            (undecodable! {:yin.k/path (conj path :yin.k/response)})))\n   801\t\n   802\t      (:link-request :link-response)\n   803\t      (do (require-keys pending [:yin.k/link-id :yin.k/name\n   804\t                                 :yin.k/request :yin.k/response\n   805\t                                 :yin.k/cell]\n   806\t                        path)\n   807\t          (check-cell cells (:yin.k/cell pending)\n   808\t                      (conj path :yin.k/cell))\n   809\t          (when-not (marker? (:yin.k/request pending))\n   810\t            (undecodable! {:yin.k/path (conj path :yin.k/request)}))\n   811\t          (when-not (marker? (:yin.k/response pending))\n   812\t            (undecodable! {:yin.k/path (conj path :yin.k/response)}))\n   813\t          (when (= :link-request reason)\n   814\t            (require-keys pending [:yin.k/envelope] path)))\n   815\t\n   816\t      :install\n   817\t      (require-keys pending [:yin.k/name] path)\n   818\t\n   819\t      (undecodable! {:yin.k/reason reason :yin.k/path path}))))\n   820\t\n   821\t\n   822\t(defn- validate-registers\n   823\t  [code r path]\n   824\t  (doseq [k [:yin.k/pc :yin.k/env :yin.k/stack :yin.k/k]]\n   825\t    (when-not (contains? r k)\n   826\t      (undecodable! {:yin.k/path (conj path k)})))\n   827\t  (when-not (and (nat-int? (:yin.k/pc r))\n   828\t                 (map? (:yin.k/env r))\n   829\t                 (vector? (:yin.k/stack r))\n   830\t                 (vector? (:yin.k/k r)))\n   831\t    (undecodable! {:yin.k/path path :yin.k/kind :registers}))\n   832\t  (when-some [a (:yin.k/segment r)]\n   833\t    (when-not (contains? code a)\n   834\t      (undecodable! {:yin.k/segment a :yin.k/path path}))\n   835\t    (when-not (< (:yin.k/pc r) (count (get code a)))\n   836\t      (undecodable! {:yin.k/pc (:yin.k/pc r)\n   837\t                     :yin.k/segment a\n   838\t                     :yin.k/path path}))))\n   839\t\n   840\t\n   841\t(defn- check-frame-pc\n   842\t  \"The resume pc must sit at a static safepoint whose kinds admit the\n   843\t   pending's wire reason: the same eligibility the lift proved on the\n   844\t   live entry, re-proved on the bytes before anything is restored, so\n   845\t   a tampered frame cannot lower at an arbitrary pc.\"\n   846\t  [code pending registers path]\n   847\t  (let [reason (:yin.k/reason pending)\n   848\t        a (:yin.k/segment registers)\n   849\t        pc (:yin.k/pc registers)]\n   850\t    (when (and (some? a) (some? pc) (contains? code a))\n   851\t      (let [at (ucf/safepoint-at (get code a) pc)]\n   852\t        (if (contains? at :yin.k/status)\n   853\t          (undecodable! {:yin.k/pc pc :yin.k/path path})\n   854\t          (when-not (some #(contains? (get wire-of-kind %) reason)\n   855\t                          (:yin.safepoint/kinds at))\n   856\t            (undecodable! {:yin.k/kind :reason-mismatch\n   857\t                           :yin.k/pc pc\n   858\t                           :yin.k/reason reason\n   859\t                           :yin.k/path path})))))))\n   860\t\n   861\t\n   862\t(defn- validate-frames\n   863\t  [body code cells]\n   864\t  (let [frames (:yin.k/frames body)]\n   865\t    (when (some? frames)\n   866\t      (when-not (vector? frames)\n   867\t        (undecodable! {:yin.k/path [:yin.k/frames]}))\n   868\t      (mapv (fn [i frame]\n   869\t              (let [path [:yin.k/frames i]]\n   870\t                (when-not (and (map? frame)\n   871\t                               (map? (:yin.k/registers frame)))\n   872\t                  (undecodable! {:yin.k/path path}))\n   873\t                (validate-registers code (:yin.k/registers frame)\n   874\t                                    (conj path :yin.k/registers))\n   875\t                (when-not (map? (:yin.k/pending frame))\n   876\t                  (undecodable! {:yin.k/path\n   877\t                                 (conj path :yin.k/pending)}))\n   878\t                (validate-pending cells (:yin.k/pending frame)\n   879\t                                  (conj path :yin.k/pending))\n   880\t                (check-frame-pc code (:yin.k/pending frame)\n   881\t                                (:yin.k/registers frame)\n   882\t                                (conj path :yin.k/registers))))\n   883\t            (range)\n   884\t            frames))))\n   885\t\n   886\t\n   887\t(defn- reachable-values\n   888\t  \"Every encoded root of `body` whose markers name cells and streams:\n   889\t   the cell table itself, each frame's registers AND pending (the\n   890\t   retained values and envelopes are values inside the pending), the\n   891\t   store and the module stores, the parked records, and the halt\n   892\t   result.  Install children are whole bodies of their own, resumed\n   893\t   separately, so they are not roots here.\"\n   894\t  [body]\n   895\t  (let [frames (or (:yin.k/frames body) [])]\n   896\t    (concat [(:yin.k/cells body)]\n   897\t            (mapcat (fn [frame]\n   898\t                      [(:yin.k/registers frame)\n   899\t                       (:yin.k/pending frame)])\n   900\t                    frames)\n   901\t            [(:yin.k/store body)\n   902\t             (:yin.k/module-stores body)\n   903\t             (:yin.k/parked body)]\n   904\t            (when (contains? body :yin.k/result)\n   905\t              [(:yin.k/result body)]))))\n   906\t\n   907\t\n   908\t(defn- referenced-cells\n   909\t  \"Every cell id the body names: through the pendings' own cell\n   910\t   fields, and through the cursor-ref markers of every encoded root\n   911\t   it carries -- a cell the encoder minted inside wait-frame\n   912\t   registers, a store key, or a retained envelope is as referenced as\n   913\t   one a pending names.  Exactly these, and the body's cells, must\n   914\t   agree.\"\n   915\t  [body]\n   916\t  (let [direct (mapcat (fn [p]\n   917\t                         (remove nil? [(:yin.k/cell p)\n   918\t                                       (:yin.k/response-cell p)]))\n   919\t                       (map :yin.k/pending\n   920\t                            (or (:yin.k/frames body) [])))]\n   921\t    (into (set direct)\n   922\t          (mapcat #(cell-ids-of %))\n   923\t          (reachable-values body))))\n   924\t\n   925\t\n   926\t(defn validate-body\n   927\t  \"The body grammar both ends run (S7.5.4): the tag, the version, the\n   928\t   kind's own shape, every cell reference resolved to exactly the\n   929\t   cells the body carries -- none missing, none extra -- every pending\n   930\t   a known variant with the keys that variant requires, every frame's\n   931\t   segment among the code the body names, and each code vector still\n   932\t   hashing to its own address and admissible as a vector.  A malformed\n   933\t   body is refused whole, before any attachment or restoration.\"\n   934\t  [body]\n   935\t  (when-not (and (map? body) (true? (get body handoff-tag)))\n   936\t    (undecodable! {:yin.k/kind :body}))\n   937\t  (when-not (= handoff-version (:yin.k/version body))\n   938\t    (refuse! :yin.k/profile-mismatch\n   939\t             {:yin.k/version (:yin.k/version body)}))\n   940\t  (let [kind (:yin.k/kind body)\n   941\t        cells (or (:yin.k/cells body) {})\n   942\t        code (or (:yin.k/code body) {})]\n   943\t    (when-not (contains? #{:blocked :parked :halted} kind)\n   944\t      (undecodable! {:yin.k/kind kind :yin.k/path [:yin.k/kind]}))\n   945\t    (when-not (and (map? cells) (map? code))\n   946\t      (undecodable! {:yin.k/path [:yin.k/cells]}))\n   947\t    (doseq [[cid cell] cells]\n   948\t      (when-not (and (map? cell) (marker? (:yin.k/stream cell))\n   949\t                     (contains? cell :yin.k/position))\n   950\t        (undecodable! {:yin.k/cell cid :yin.k/path [:yin.k/cells cid]})))\n   951\t    (doseq [[a v] code]\n   952\t      (when-not (= a (ucf/code-address v))\n   953\t        (refuse! :yin.k/hash-mismatch {:yin.k/segment a}))\n   954\t      (when-some [defect (code/well-formed-vector? v)]\n   955\t        (undecodable! {:yin.k/segment a :yin.k/pc (:pc defect)\n   956\t                       :yin.k/defect defect})))\n   957\t    (validate-frames body code cells)\n   958\t    (when (contains? body :yin.k/frames)\n   959\t      (when (= :halted kind)\n   960\t        (undecodable! {:yin.k/path [:yin.k/frames]})))\n   961\t    (when (and (= :blocked kind)\n   962\t               (not (seq (or (:yin.k/frames body) []))))\n   963\t      (undecodable! {:yin.k/path [:yin.k/frames]\n   964\t                     :yin.k/kind :blocked-without-frames}))\n   965\t    (when (contains? body :yin.k/result)\n   966\t      (when-not (= :halted kind)\n   967\t        (undecodable! {:yin.k/path [:yin.k/result]})))\n   968\t    (when (= :halted kind)\n   969\t      (when-not (contains? body :yin.k/result)\n   970\t        (undecodable! {:yin.k/path [:yin.k/result]})))\n   971\t    (when (= :parked kind)\n   972\t      (when-not (contains? (:yin.k/parked body)\n   973\t                           (:yin.k/parked-id body))\n   974\t        (undecodable! {:yin.k/parked-id (:yin.k/parked-id body)\n   975\t                       :yin.k/path [:yin.k/parked-id]})))\n   976\t    (doseq [[pid r] (:yin.k/parked body)]\n   977\t      (validate-registers code r [:yin.k/parked pid]))\n   978\t    (doseq [[m inst] (:yin.k/installs body)]\n   979\t      (when-not (and (contains? inst :yin.k/response)\n   980\t                     (map? (:yin.k/child inst))\n   981\t                     (true? (get (:yin.k/child inst) handoff-tag)))\n   982\t        (undecodable! {:yin.k/name m\n   983\t                       :yin.k/path [:yin.k/installs m]}))\n   984\t      ;; a child is a whole body: validated with the same grammar\n   985\t      ;; before anything of the parent is restored.  Decoded bytes\n   986\t      ;; are trees, so the recursion terminates.\n   987\t      (validate-body (:yin.k/child inst)))\n   988\t    (let [referenced (referenced-cells body)\n   989\t          missing (remove #(contains? cells %) referenced)\n   990\t          extra (remove #(contains? referenced %) (keys cells))]\n   991\t      (when-some [cid (first missing)]\n   992\t        (undecodable! {:yin.k/cell cid :yin.k/path [:yin.k/cells]}))\n   993\t      (when-some [cid (first (sort-by str extra))]\n   994\t        (undecodable! {:yin.k/cell cid :yin.k/kind :extra-cell\n   995\t                       :yin.k/path [:yin.k/cells cid]})))\n   996\t    (when (and (seq cells)\n   997\t               (not (contains?\n   998\t                      (get-in (or (:yin.k/requires body) {})\n   999\t                              [:yin.k/cursor-profiles])\n  1000\t                      :dao.stream.remote/v1)))\n     1\t(ns yin.vm.ucf.handoff-test\n     2\t  \"Stage 1 of the post-M5 hardening (docs/design/yin.vm.linker.dht.md\n     3\t   14.1.3): the kept-cursor rows over ACTUAL canonical bytes.\n     4\t\n     5\t   Every proof here exports a real machine parked through the engine,\n     6\t   moves the body as CBOR bytes, and lowers into a fresh machine of\n     7\t   the same composition: the three same-host pairs of 14.1.1's matrix\n     8\t   are these proofs run on their own lanes (JVM here, Node and Dart on\n     9\t   theirs), with the toy channel of `yin.vm.ucf.remote-test` as the\n    10\t   in-process transport seam and a served table as the remote table.\n    11\t   The six cross-host pairs of the nine-pair matrix are NOT covered\n    12\t   here: they need a handoff peer program per host and process\n    13\t   transport beside this namespace, which stage 1 records as its\n    14\t   outstanding coverage gap rather than inferring from same-host\n    15\t   bytes (14.1.3: process transport is recorded separately).\n    16\t\n    17\t   Row 1 aliases one shared cell in two ordered waiters, a closure and\n    18\t   the store, beside two independent cells at one position.  Row 2\n    19\t   runs every safepoint kind of 14.1.1's table -- a blocked read at\n    20\t   two activation depths, a blocked write, a sent and a retained FFI\n    21\t   call, a retained and a polling link wait, an install waiter beside\n    22\t   its whole child, an explicit park and a halt -- each with parity\n    23\t   against the source's own resumed run.  Row 3 interleaves unrelated,\n    24\t   duplicate and late responses around the target.  Row 4 evicts, ends\n    25\t   a route, and omits the cursor profile.  Row 5 is the refusal\n    26\t   battery.\"\n    27\t  (:require [clojure.set :as set]\n    28\t            [clojure.test :refer [deftest is testing]]\n    29\t            [dao.jing :as jing]\n    30\t            [dao.stream :as stream]\n    31\t            [dao.stream.apply :as apply2]\n    32\t            [dao.stream.cbor :as cbor]\n    33\t            [dao.stream.remote :as remote]\n    34\t            [dao.stream.ringbuffer :as ringbuffer]\n    35\t            [yin.vm :as vm]\n    36\t            [yin.vm.engine :as engine]\n    37\t            [yin.vm.linearize :as linearize]\n    38\t            [yin.vm.module :as module]\n    39\t            [yin.vm.semantic :as semantic]\n    40\t            [yin.vm.ucf.handoff :as handoff]\n    41\t            [yin.vm.test-utils :as tu]))\n    42\t\n    43\t\n    44\t;; =============================================================================\n    45\t;; The composition: machines, the toy channel, the served table\n    46\t;; =============================================================================\n    47\t\n    48\t(defn- ring\n    49\t  [capacity]\n    50\t  (:dao.stream/handle\n    51\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    52\t                         ringbuffer/capacity-key capacity})))\n    53\t\n    54\t\n    55\t(defn- make-ring-stream\n    56\t  [capacity]\n    57\t  (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    58\t                       ringbuffer/capacity-key capacity}))\n    59\t\n    60\t\n    61\t(defn- new-machine\n    62\t  []\n    63\t  (semantic/create-vm {:make-stream make-ring-stream\n    64\t                       :capability-secret tu/secret\n    65\t                       :modules (module/default-registry)\n    66\t                       :secret-source (fn [origin]\n    67\t                                        (str tu/secret \"/\"\n    68\t                                             (name origin)))}))\n    69\t\n    70\t\n    71\t(def ^:private semantic-vector\n    72\t  \"The direct path's canonical vector of `ast` -- the loader that\n    73\t   addresses what it loads (`load-vector` records the vector's own\n    74\t   address in the alias column, where the AST batch path records\n    75\t   none), so every segment a handoff names is portable.\"\n    76\t  (comp :vector linearize/lower-rows vm/ast->semantic-bytecode))\n    77\t\n    78\t\n    79\t(defn- load-ast\n    80\t  [machine ast]\n    81\t  (semantic/load-vector machine (semantic-vector ast)\n    82\t                        vm/semantic-contract))\n    83\t\n    84\t\n    85\t(defn- toy\n    86\t  []\n    87\t  (let [ab (ring 64)\n    88\t        ba (ring 64)\n    89\t        cd {:dao.stream/type :dao.stream.test/channel\n    90\t            :dao.stream/identity \"ucf-handoff-toy\"}]\n    91\t    {:channel cd, :ab ab, :ba ba,\n    92\t     :a-end {:reader ba, :writer ab},\n    93\t     :b-end {:reader ab, :writer ba}}))\n    94\t\n    95\t\n    96\t(defn- served-peer\n    97\t  [t]\n    98\t  {:table (atom {})\n    99\t   :b-reader (:reader (:b-end t))\n   100\t   :b-writer (:writer (:b-end t))\n   101\t   :mirror (atom (:dao.stream/cursor\n   102\t                   (stream/cursor (:reader (:b-end t))\n   103\t                                  :dao.stream/oldest)))})\n   104\t\n   105\t\n   106\t(defn- serve-mirror!\n   107\t  [peer]\n   108\t  (swap! (:mirror peer)\n   109\t         #(remote/mirror-step @(:table peer) (:b-reader peer) %\n   110\t                              (:b-writer peer))))\n   111\t\n   112\t\n   113\t(defn- server\n   114\t  \"The exporter's `serve!`: a stable identity per handle, entering it\n   115\t   in the peer's table under the toy channel.\"\n   116\t  ([peer chan] (server peer chan #{:reader}))\n   117\t  ([peer chan surfaces]\n   118\t   (fn [h]\n   119\t     (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\n   120\t                             @(:table peer))]\n   121\t       {:dao.stream/identity existing, :dao.stream/channel chan}\n   122\t       (let [id (str (gensym \"seg\"))]\n   123\t         (swap! (:table peer) assoc id {:handle h, :surface surfaces})\n   124\t         {:dao.stream/identity id, :dao.stream/channel chan})))))\n   125\t\n   126\t\n   127\t(defn- attacher\n   128\t  [t]\n   129\t  (remote/attacher\n   130\t    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\n   131\t\n   132\t\n   133\t(defn- one-slot-stream\n   134\t  \"A stream that answers `full` while one value sits in it; reading the\n   135\t   value frees the slot.\"\n   136\t  [identity]\n   137\t  (let [slot (atom :empty)]\n   138\t    (reify\n   139\t      stream/IDaoStreamDescriptor\n   140\t      (descriptor\n   141\t        [_]\n   142\t        {:dao.stream/outcome :dao.stream/ok,\n   143\t         :dao.stream/identity identity,\n   144\t         :dao.stream/descriptor\n   145\t         {:dao.stream/type :dao.stream.test/channel,\n   146\t          :dao.stream/identity identity}})\n   147\t\n   148\t\n   149\t      stream/IDaoStreamReader\n   150\t\n   151\t      (cursor\n   152\t        [_ _anchor]\n   153\t        {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor 0})\n   154\t\n   155\t      (next\n   156\t        [_ cursor]\n   157\t        (if (and (= 0 cursor) (not= :empty @slot))\n   158\t          (let [v @slot]\n   159\t            (reset! slot :empty)\n   160\t            {:dao.stream/outcome :dao.stream/ok,\n   161\t             :dao.stream/value v, :dao.stream/cursor 1})\n   162\t          {:dao.stream/outcome :dao.stream/blocked}))\n   163\t\n   164\t\n   165\t      stream/IDaoStreamWriter\n   166\t\n   167\t      (append!\n   168\t        [_ v]\n   169\t        (if (not= :empty @slot)\n   170\t          {:dao.stream/outcome :dao.stream/full}\n   171\t          (do (reset! slot v)\n   172\t              {:dao.stream/outcome :dao.stream/ok}))))))\n   173\t\n   174\t\n   175\t;; =============================================================================\n   176\t;; AST helpers and the programs that park each way\n   177\t;; =============================================================================\n   178\t\n   179\t(defn- lit\n   180\t  [x]\n   181\t  {:type :literal, :value x})\n   182\t\n   183\t\n   184\t(defn- v\n   185\t  [n]\n   186\t  {:type :variable, :name n})\n   187\t\n   188\t\n   189\t(defn- lam\n   190\t  [params body]\n   191\t  {:type :lambda, :params params, :body body})\n   192\t\n   193\t\n   194\t(defn- app\n   195\t  [f & args]\n   196\t  {:type :application, :operator f, :operands (vec args)})\n   197\t\n   198\t\n   199\t(defn- def!\n   200\t  [k val]\n   201\t  (app (v 'yin/def) (lit k) val))\n   202\t\n   203\t\n   204\t(defn- then\n   205\t  [first-ast second-ast]\n   206\t  (app (lam ['_] second-ast) first-ast))\n   207\t\n   208\t\n   209\t(defn- cursor-of\n   210\t  [source]\n   211\t  {:type :stream/cursor, :source source})\n   212\t\n   213\t\n   214\t(defn- next-of\n   215\t  [source]\n   216\t  {:type :stream/next, :source source})\n   217\t\n   218\t\n   219\t(defn- let1\n   220\t  [param init body]\n   221\t  (app (lam [param] body) init))\n   222\t\n   223\t\n   224\t(defn- nested-reads\n   225\t  \"`depth` nested ordinary calls around two reads of the cursor bound\n   226\t   to `name`: the first answers A, the second parks.\"\n   227\t  [depth name]\n   228\t  (letfn [(go\n   229\t            [d]\n   230\t            (if (zero? d)\n   231\t              (then (next-of (v name)) (next-of (v name)))\n   232\t              (app (lam ['x] (go (dec d))) (lit 1))))]\n   233\t    (go depth)))\n   234\t\n   235\t\n   236\t(defn- reader-at-depth\n   237\t  \"A program that parks on a blocked read of the stream it makes:\n   238\t   the cursor is passed as a closure parameter (so the parked frame's\n   239\t   captured environment holds the cell -- the alias row's closure),\n   240\t   inside `depth` nested ordinary calls.  With `held`, the store also\n   241\t   holds the cursor under 'held.\"\n   242\t  [depth held]\n   243\t  (let1 's {:type :stream/make, :buffer 4}\n   244\t        (let [read (app (lam ['c] (nested-reads depth 'c))\n   245\t                        (if held (v 'held) (cursor-of (v 's))))]\n   246\t          (if held\n   247\t            (then (def! 'held (cursor-of (v 's))) read)\n   248\t            read))))\n   249\t\n   250\t\n   251\t(defn- parked-machine\n   252\t  [program-ast]\n   253\t  (vm/run (load-ast (new-machine) program-ast)))\n   254\t\n   255\t\n   256\t(defn- halted-machine\n   257\t  [ast]\n   258\t  (vm/run (load-ast (new-machine) ast)))\n   259\t\n   260\t\n   261\t(defn- stream-of\n   262\t  \"The stream handle a parked reader's wait entry polls.\"\n   263\t  [parked]\n   264\t  (let [entry (first (:wait-set parked))]\n   265\t    (get (:resources parked) (:stream-id entry))))\n   266\t\n   267\t\n   268\t(defn- parked-reader\n   269\t  \"A real machine parked on a blocked read with A consumed: park on the\n   270\t   empty stream, append A, run on -- the read answers, the program\n   271\t   parks again on the second read, its cursor past A.\"\n   272\t  [depth held]\n   273\t  (let [m0 (parked-machine (reader-at-depth depth held))\n   274\t        src (stream-of m0)]\n   275\t    (stream/append! src \"A\")\n   276\t    [(vm/run m0) src]))\n   277\t\n   278\t\n   279\t(defn- parked-writer\n   280\t  \"A real machine parked on a blocked write: the warm one-slot stream\n   281\t   keeps the value retained.\"\n   282\t  []\n   283\t  (let [w (one-slot-stream \"w\")]\n   284\t    (stream/append! w :warmed)\n   285\t    (let [m0 (load-ast (new-machine)\n   286\t                       {:type :stream/put, :target (v 'w),\n   287\t                        :val (lit \"v\")})\n   288\t          [ref m0'] (engine/attach-resource m0 w)]\n   289\t      [(vm/run (assoc m0' :store {'w ref})) w])))\n   290\t\n   291\t\n   292\t(defn- calling-machine\n   293\t  ([call-in call-out]\n   294\t   (calling-machine call-in call-out nil))\n   295\t  ([call-in call-out bridge]\n   296\t   (semantic/create-vm\n   297\t     {:make-stream make-ring-stream,\n   298\t      :capability-secret tu/secret,\n   299\t      :modules (module/default-registry),\n   300\t      :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   301\t      :call-in call-in,\n   302\t      :call-out call-out,\n   303\t      :call-out-cursor (vm/mint-oldest call-out :test),\n   304\t      :bridge bridge})))\n   305\t\n   306\t\n   307\t(defn- call-node\n   308\t  [op arg]\n   309\t  {:type :dao.stream.apply/call, :op op, :operands [(lit arg)]})\n   310\t\n   311\t\n   312\t(defn- parked-sent-caller\n   313\t  []\n   314\t  (let [call-in (ring 8)\n   315\t        call-out (ring 8)\n   316\t        program (then (call-node :op/echo \"hello\")\n   317\t                      (call-node :op/echo \"world\"))\n   318\t        parked (vm/run (load-ast (calling-machine call-in call-out)\n   319\t                                 program))]\n   320\t    [parked call-in call-out]))\n   321\t\n   322\t\n   323\t(defn- parked-retained-caller\n   324\t  []\n   325\t  (let [call-in (one-slot-stream \"call-in\")\n   326\t        call-out (ring 8)\n   327\t        _ (stream/append! call-in :warmed)\n   328\t        program (then (call-node :op/echo \"hello\")\n   329\t                      (call-node :op/echo \"world\"))\n   330\t        parked (vm/run (load-ast (calling-machine call-in call-out)\n   331\t                                 program))]\n   332\t    [parked call-in call-out]))\n   333\t\n   334\t\n   335\t(defn- linking-machine\n   336\t  [request response]\n   337\t  (semantic/create-vm\n   338\t    {:make-stream make-ring-stream,\n   339\t     :capability-secret tu/secret,\n   340\t     :modules (module/default-registry),\n   341\t     :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   342\t     :link-request request,\n   343\t     :link-response response}))\n   344\t\n   345\t\n   346\t(defn- require-program\n   347\t  [name]\n   348\t  (app (v 'require) (lit name)))\n   349\t\n   350\t\n   351\t(defn- parked-link-request\n   352\t  []\n   353\t  (let [request (one-slot-stream \"link-request\")\n   354\t        response (ring 64)\n   355\t        _ (stream/append! request :warmed)\n   356\t        parked (vm/run (load-ast (linking-machine request response)\n   357\t                                 (require-program\n   358\t                                   'host.the-module)))]\n   359\t    [parked]))\n   360\t\n   361\t\n   362\t(defn- parked-link-response\n   363\t  []\n   364\t  (let [request (ring 64)\n   365\t        response (ring 64)\n   366\t        parked (vm/run (load-ast (linking-machine request response)\n   367\t                                 (require-program\n   368\t                                   'host.the-module)))]\n   369\t    [parked]))\n   370\t\n   371\t\n   372\t(defn- module-response\n   373\t  []\n   374\t  {:status :ok,\n   375\t   :image {:value (semantic-vector\n   376\t                    (let1 's {:type :stream/make, :buffer 4}\n   377\t                          (then (next-of (cursor-of (v 's)))\n   378\t                                (def! 'f (lam [] (lit 42))))))},\n   379\t   :manifest {:yin.module/name 'host.mod,\n   380\t              :yin.module/exports #{'f}},\n   381\t   :obligations []})\n   382\t\n   383\t\n   384\t(defn- parked-installer\n   385\t  \"A real machine parked at :install with a live child: the response is\n   386\t   appended after the first park, and the spawned child blocks on its\n   387\t   own read.  With `plain`, the program reads nothing of the module\n   388\t   after the require.  Answers [parked child-stream].\"\n   389\t  ([] (parked-installer false))\n   390\t  ([plain]\n   391\t   (let [request (ring 64)\n   392\t         response (ring 64)\n   393\t         m0 (vm/run (load-ast (linking-machine request response)\n   394\t                              (then (require-program 'host.mod)\n   395\t                                    (if plain\n   396\t                                      (lit 7)\n   397\t                                      (app (v 'host.mod/f))))))\n   398\t         entry (first (:wait-set m0))\n   399\t         _ (stream/append! response\n   400\t                           (assoc (module-response)\n   401\t                                  :yin.link/id (:link-id entry)))\n   402\t         parked (vm/run m0)\n   403\t         child (get-in parked [:installs 'host.mod :vm])\n   404\t         child-stream (get (:resources child)\n   405\t                           (:stream-id (first (:wait-set child))))]\n   406\t     [parked child-stream])))\n   407\t\n   408\t\n   409\t(defn- parked-explicit\n   410\t  \"A real machine at an explicit park, its record's environment holding\n   411\t   a cursor on a blocked stream, so reachable cells keep positions.\"\n   412\t  []\n   413\t  (vm/run (load-ast (new-machine)\n   414\t                    (let1 's {:type :stream/make, :buffer 4}\n   415\t                          (app (lam ['c] {:type :vm/park})\n   416\t                               (cursor-of (v 's)))))))\n   417\t\n   418\t\n   419\t;; =============================================================================\n   420\t;; The transfer and the drivers\n   421\t;; =============================================================================\n   422\t\n   423\t(defn- drive-local\n   424\t  \"Run a blocked machine against its own local streams until it stops\n   425\t   blocking or rounds run out: the reference run.\"\n   426\t  ([m] (drive-local m 64))\n   427\t  ([m rounds]\n   428\t   (loop [m (vm/run m), n rounds]\n   429\t     (if (or (not (vm/blocked? m)) (zero? n))\n   430\t       m\n   431\t       (recur (vm/run m) (dec n))))))\n   432\t\n   433\t\n   434\t(defn- drive\n   435\t  \"Run a resumed machine through its reflections, stepping the source's\n   436\t   mirror between rounds, until it stops blocking.\"\n   437\t  ([m peer] (drive m peer 64))\n   438\t  ([m peer rounds]\n   439\t   (loop [m (vm/run m), n rounds]\n   440\t     (if (or (not (vm/blocked? m)) (zero? n))\n   441\t       m\n   442\t       (do (serve-mirror! peer)\n   443\t           (recur (vm/run m) (dec n)))))))\n   444\t\n   445\t\n   446\t(defn- keywords-of\n   447\t  [x]\n   448\t  (into #{}\n   449\t        (filter keyword?)\n   450\t        (tree-seq coll? (fn [n]\n   451\t                          (if (map? n)\n   452\t                            (concat (keys n) (vals n))\n   453\t                            (seq n))) x)))\n   454\t\n   455\t\n   456\t(defn- encoded-cell-ids\n   457\t  \"Every cell id the encoded value's cursor-ref markers name.\"\n   458\t  [x]\n   459\t  (into #{}\n   460\t        (comp (filter #(and (map? %)\n   461\t                            (= :yin.k/cursor-ref (:yin.k/tag %))))\n   462\t              (map :yin.k/cell))\n   463\t        (tree-seq coll? (fn [n] (if (map? n) (vals n) (seq n))) x)))\n   464\t\n   465\t\n   466\t(defn- source-resource-keys\n   467\t  [vm-m]\n   468\t  (into #{} (filter keyword?)\n   469\t        (concat (keys (:resources vm-m))\n   470\t                (mapcat (fn [r]\n   471\t                          (when (map? r) [(:stream-id r)]))\n   472\t                        (vals (:resources vm-m))))))\n   473\t\n   474\t\n   475\t(defn- parked-frame\n   476\t  [export]\n   477\t  (get-in export [:body :yin.k/frames 0 :yin.k/pending]))\n   478\t\n   479\t\n   480\t;; =============================================================================\n   481\t;; Row 1: aliasing across the transfer\n   482\t;; =============================================================================\n   483\t\n   484\t(deftest shared-and-independent-cells-cross-as-bytes\n   485\t  (let [t (toy)\n   486\t        peer (served-peer t)\n   487\t        serve! (server peer (:channel t))\n   488\t        [parked src] (parked-reader 1 true)\n   489\t        entry (first (:wait-set parked))\n   490\t        cid (get-in entry [:cursor-ref :id])\n   491\t        sid (:stream-id entry)\n   492\t        kept (get-in parked [:resources cid :cursor])\n   493\t        held (engine/issue-ref parked :cursor-ref cid)\n   494\t        parked (-> parked\n   495\t                   (assoc-in [:store 'held] held)\n   496\t                   (update :resources assoc\n   497\t                           :yin/i1 {:stream-id sid, :cursor kept}\n   498\t                           :yin/i2 {:stream-id sid, :cursor kept}))\n   499\t        base (first (:wait-set parked))\n   500\t        indep (fn [id]\n   501\t                (-> base\n   502\t                    (assoc :cursor-ref {:type :cursor-ref, :id id})))\n   503\t        waiter-2 base\n   504\t        parked (assoc parked\n   505\t                      :wait-set [base waiter-2\n   506\t                                 (indep :yin/i1)\n   507\t                                 (indep :yin/i2)])\n   508\t        export (handoff/export-task parked serve!)\n   509\t        body (:body export)\n   510\t        resume (handoff/resume-task (new-machine) (:bytes export)\n   511\t                                    (attacher t))\n   512\t        recv (:vm resume)]\n   513\t    (testing \"the export is canonical bytes under their address\"\n   514\t      (is (= :ok (:status export)) (pr-str export))\n   515\t      (is (cbor/byte-payload? (:bytes export)))\n   516\t      (is (= body (cbor/decode (:bytes export)))\n   517\t          \"the bytes are the canonical encoding of the body\")\n   518\t      (is (= (:address export) (jing/content-hash body))))\n   519\t    (testing \"one cell for the waiters, the closure and the store;\n   520\t              two more for the independents\"\n   521\t      (is (= 3 (count (:yin.k/cells body)))\n   522\t          (pr-str (:yin.k/cells body)))\n   523\t      (let [pendings (mapv :yin.k/pending (:yin.k/frames body))\n   524\t            shared (:yin.k/cell (first pendings))\n   525\t            env-cells (into #{}\n   526\t                            (mapcat encoded-cell-ids)\n   527\t                            (map :yin.k/env\n   528\t                                 (map :yin.k/registers\n   529\t                                      (:yin.k/frames body))))\n   530\t            store-cell (get-in body [:yin.k/store 'held :yin.k/cell])]\n   531\t        (is (= shared (:yin.k/cell (second pendings)))\n   532\t            \"both shared waiters name the one cell\")\n   533\t        (is (contains? env-cells shared)\n   534\t            \"the closure's captured environment names the same cell\")\n   535\t        (is (= shared store-cell)\n   536\t            \"the store's held cursor is the same cell\")\n   537\t        (is (= kept (get-in body [:yin.k/cells shared :yin.k/position]))\n   538\t            \"the cell sits at the source-minted kept position\")\n   539\t        (is (= 3 (count (into #{} (map :yin.k/cell) pendings)))\n   540\t            \"the two independents are their own cells beside it\")))\n   541\t    (testing \"no source handle, id or seal crosses\"\n   542\t      (is (empty? (set/intersection\n   543\t                    (keywords-of body)\n   544\t                    (source-resource-keys parked)))))\n   545\t    (testing \"the lower shares one fresh cursor entry across the\n   546\t              waiters, the closure and the store\"\n   547\t      (is (= :ok (:status resume)) (pr-str resume))\n   548\t      (let [[e1 e2 e3 e4] (:wait-set recv)\n   549\t            k1 (get-in e1 [:cursor-ref :id])\n   550\t            held' (get-in recv [:store 'held])]\n   551\t        (is (= k1 (get-in e2 [:cursor-ref :id])))\n   552\t        (is (not= k1 (get-in e3 [:cursor-ref :id])))\n   553\t        (is (not= (get-in e3 [:cursor-ref :id])\n   554\t                  (get-in e4 [:cursor-ref :id])))\n   555\t        (is (= k1 (:id held'))\n   556\t            \"the store's re-sealed cursor-ref names the shared entry\")\n   557\t        (is (= kept (:cursor (get (:resources recv) k1))))\n   558\t        (is (= 3 (count (into #{} (map (fn [e]\n   559\t                                         (get-in e [:cursor-ref :id])))\n   560\t                              (:wait-set recv))))\n   561\t            \"three cells lower to three fresh cursor entries\")))\n   562\t    (testing \"shared waiters see B then C; independents see B each\"\n   563\t      (stream/append! src \"B\")\n   564\t      (stream/append! src \"C\")\n   565\t      (let [swept (loop [w (engine/check-wait-set recv) n 12]\n   566\t                    (if (or (zero? n) (empty? (:wait-set w)))\n   567\t                      w\n   568\t                      (do (serve-mirror! peer)\n   569\t                          (recur (engine/check-wait-set w)\n   570\t                                 (dec n)))))]\n   571\t        (is (= [\"B\" \"C\" \"B\" \"B\"] (mapv :value (:ready-queue swept)))\n   572\t            \"the shared pair advance in order on the one cell; each\n   573\t             independent reads B at its own position\")\n   574\t        (is (empty? (:wait-set swept))\n   575\t            \"no waiter sees A, and nothing is left waiting\")))))\n   576\t\n   577\t\n   578\t;; =============================================================================\n   579\t;; Row 2: every declared park, with parity against the reference run\n   580\t;; =============================================================================\n   581\t\n   582\t(deftest a-blocked-read-crosses-at-two-depths-and-resumes\n   583\t  (doseq [[depth frames] [[1 4] [3 6]]]\n   584\t    (let [t (toy)\n   585\t          peer (served-peer t)\n   586\t          serve! (server peer (:channel t))\n   587\t          [parked src] (parked-reader depth false)\n   588\t          export (handoff/export-task parked serve!)\n   589\t          reference (do (stream/append! src \"R\")\n   590\t                        (vm/value (drive-local parked)))\n   591\t          recv (:vm (handoff/resume-task (new-machine)\n   592\t                                         (:bytes export)\n   593\t                                         (attacher t)))]\n   594\t      (testing (str \"depth \" depth)\n   595\t        (is (= :ok (:status export)) (pr-str export))\n   596\t        (is (= frames\n   597\t               (count (get-in export [:body :yin.k/frames 0\n   598\t                                      :yin.k/registers :yin.k/k])))\n   599\t            \"the carried K is the depth of ordinary calls\")\n   600\t        (is (= :next (:yin.k/reason (parked-frame export))))\n   601\t        (is (contains? (get-in export [:body :yin.k/requires\n   602\t                                       :yin.k/cursor-profiles])\n   603\t                       :dao.stream.remote/v1))\n   604\t        (is (= reference (vm/value (drive recv peer)))\n   605\t            \"the resumed task answers what the source's own run did\")))))\n   606\t\n   607\t\n   608\t(deftest a-blocked-write-retries-its-retained-value\n   609\t  (let [t (toy)\n   610\t        peer (served-peer t)\n   611\t        serve! (server peer (:channel t) #{:reader :writer})\n   612\t        [parked w] (parked-writer)\n   613\t        export (handoff/export-task parked serve!)\n   614\t        reference (do (stream/next w 0)\n   615\t                      (vm/value (drive-local parked)))\n   616\t        recv (:vm (handoff/resume-task (new-machine)\n   617\t                                       (:bytes export)\n   618\t                                       (attacher t)))\n   619\t        done (drive recv peer)]\n   620\t    (is (= :ok (:status export)) (pr-str export))\n   621\t    (is (= :put (:yin.k/reason (parked-frame export))))\n   622\t    (is (= \"v\" (:yin.k/value (parked-frame export))))\n   623\t    (is (= reference (vm/value done))\n   624\t        \"the retry appends the retained value through the reflection\")\n   625\t    (is (= \"v\" (:dao.stream/value (stream/next w 0))))))\n   626\t\n   627\t\n   628\t(deftest a-sent-ffi-call-keeps-its-cell-and-correlation\n   629\t  (let [t (toy)\n   630\t        peer (served-peer t)\n   631\t        serve! (server peer (:channel t))\n   632\t        [parked call-in call-out] (parked-sent-caller)\n   633\t        entry (first (:wait-set parked))\n   634\t        export (handoff/export-task parked serve!)\n   635\t        reference (do (stream/append! call-out\n   636\t                                      (apply2/success-response\n   637\t                                        (:call-id entry) \"echo!\"))\n   638\t                      (vm/value (drive-local parked)))\n   639\t        after-reference (count (tu/drain call-in))\n   640\t        ;; the receiver's own pair serves the program's NEXT call\n   641\t        own-in (ring 8)\n   642\t        own-out (ring 8)\n   643\t        recv (:vm (handoff/resume-task (calling-machine own-in own-out)\n   644\t                                       (:bytes export)\n   645\t                                       (attacher t)))\n   646\t        done (drive recv peer)]\n   647\t    (is (= :ok (:status export)) (pr-str export))\n   648\t    (is (= :ffi (:yin.k/reason (parked-frame export))))\n   649\t    (is (= (:call-id entry) (:yin.k/call-id (parked-frame export))))\n   650\t    (is (= #{:dao.stream.remote/v1}\n   651\t           (get-in export [:body :yin.k/requires\n   652\t                           :yin.k/cursor-profiles])))\n   653\t    (is (= reference (vm/value done)))\n   654\t    (is (= after-reference (count (tu/drain call-in)))\n   655\t        \"no sent request is ever reissued: the source's stream saw only\n   656\t         what the source's own runs appended\")\n   657\t    (is (= 1 (count (tu/drain own-in)))\n   658\t        \"the program's next call used the receiver's own pair\")))\n   659\t\n   660\t\n   661\t(deftest a-retained-ffi-request-retries-its-envelope-verbatim\n   662\t  (let [t (toy)\n   663\t        peer (served-peer t)\n   664\t        serve! (server peer (:channel t) #{:reader :writer})\n   665\t        [parked call-in _call-out] (parked-retained-caller)\n   666\t        entry (first (:wait-set parked))\n   667\t        export (handoff/export-task parked serve!)\n   668\t        _ (do (stream/next call-in 0)\n   669\t              (drive-local parked))\n   670\t        recv (:vm (handoff/resume-task (new-machine)\n   671\t                                       (:bytes export)\n   672\t                                       (attacher t)))\n   673\t        done (drive recv peer)]\n   674\t    (is (= :ok (:status export)) (pr-str export))\n   675\t    (is (= :ffi-request (:yin.k/reason (parked-frame export))))\n   676\t    (is (= (:datom entry)\n   677\t           (apply hash-map\n   678\t                  (:yin.k/entries\n   679\t                    (:yin.k/request-envelope (parked-frame export)))))\n   680\t        \"the retained envelope rides verbatim, wrapped as the literal\n   681\t         it is\")\n   682\t    (is (vm/blocked? done)\n   683\t        \"the retry stays parked: the emitter's bridge never answered\")\n   684\t    (let [landed (stream/next call-in 0)]\n   685\t      (is (= :dao.stream/ok (:dao.stream/outcome landed)))\n   686\t      (is (= (:datom entry) (:dao.stream/value landed))\n   687\t          \"the identical envelope, appended through the reflection\"))))\n   688\t\n   689\t\n   690\t(deftest link-waits-carry-their-envelope-and-kept-cursor\n   691\t  (let [t (toy)\n   692\t        serve! (server (served-peer t) (:channel t) #{:reader :writer})\n   693\t        [parked] (parked-link-request)\n   694\t        entry (first (:wait-set parked))\n   695\t        export (handoff/export-task parked serve!)\n   696\t        recv (:vm (handoff/resume-task (new-machine)\n   697\t                                       (:bytes export)\n   698\t                                       (attacher t)))\n   699\t        lowered (first (:wait-set recv))\n   700\t        [parked2] (parked-link-response)\n   701\t        entry2 (first (:wait-set parked2))\n   702\t        export2 (handoff/export-task parked2 serve!)]\n   703\t    (is (= :ok (:status export)) (pr-str export))\n   704\t    (is (= :link-request (:yin.k/reason (parked-frame export))))\n   705\t    (is (= (:envelope entry)\n   706\t           (:envelope lowered))\n   707\t        \"the retained envelope rides verbatim, wrapped as the literal\n   708\t         it is, and the lower unwraps it\")\n   709\t    (is (= module/link-request-resource (:request lowered))\n   710\t        \"the lowered wait parks where the engine retries it\")\n   711\t    (is (= module/link-response-resource (:response lowered))\n   712\t        \"and polls where the engine reads it\")\n   713\t    (is (= :link-response (:yin.k/reason (parked-frame export2))))\n   714\t    (is (= (:cursor entry2)\n   715\t           (get-in export2\n   716\t                   [:body :yin.k/cells\n   717\t                    (:yin.k/cell (parked-frame export2))\n   718\t                    :yin.k/position]))\n   719\t        (str \"the polling wait's kept cursor is the cell's position: \"\n   720\t             (pr-str {:cursor (:cursor entry2)\n   721\t                      :cells (get-in export2 [:body :yin.k/cells])\n   722\t                      :frame (parked-frame export2)})))))\n   723\t\n   724\t\n   725\t(deftest an-install-waiter-crosses-beside-its-whole-child\n   726\t  (let [t (toy)\n   727\t        peer (served-peer t)\n   728\t        serve! (server peer (:channel t))\n   729\t        [parked child-stream] (parked-installer)\n   730\t        export (handoff/export-task parked serve!)\n   731\t        ;; the receiving task composes an attach seam, which the\n   732\t        ;; install's own slice lowering resolves the child's cells\n   733\t        ;; through, exactly as the engine's receive-module does\n   734\t        recv (:vm (handoff/resume-task (assoc (new-machine)\n   735\t                                              :attach-stream\n   736\t                                              (attacher t))\n   737\t                                       (:bytes export)\n   738\t                                       (attacher t)))]\n   739\t    (is (= :ok (:status export)) (pr-str export))\n   740\t    (is (= :install (:yin.k/reason (parked-frame export))))\n   741\t    (testing \"the child's phase and waits travel\"\n   742\t      (let [child (get-in export [:body :yin.k/installs 'host.mod])]\n   743\t        (is (true? (get (:yin.k/child child) handoff/handoff-tag)))\n   744\t        (is (= :blocked (:yin.k/kind (:yin.k/child child)))\n   745\t            \"the child is itself parked on its read\")))\n   746\t    (testing \"the receiver steps the child and wakes the waiter\"\n   747\t      (is (contains? (:installs recv) 'host.mod))\n   748\t      (stream/append! child-stream \"go\")\n   749\t      (let [done (drive recv peer)]\n   750\t        (is (not (vm/blocked? done)) (pr-str (:wait-set done)))\n   751\t        (is (= 42 (vm/value done))\n   752\t            \"the install completed, the waiter woke with the module,\n   753\t             and the program called its export\")\n   754\t        (is (empty? (:installs done)))))))\n   755\t\n   756\t\n   757\t(deftest an-explicit-park-is-the-no-wait-shape\n   758\t  (let [t (toy)\n   759\t        serve! (server (served-peer t) (:channel t))\n   760\t        parked (parked-explicit)\n   761\t        pid (:id (:value parked))\n   762\t        export (handoff/export-task parked serve!)\n   763\t        body (:body export)\n   764\t        recv (:vm (handoff/resume-task (new-machine)\n   765\t                                       (:bytes export)\n   766\t                                       (attacher t)))\n   767\t        resume-prog {:type :vm/resume, :parked-id pid,\n   768\t                     :val (lit \"back\")}\n   769\t        reference (vm/value\n   770\t                    (vm/run (load-ast parked resume-prog)))]\n   771\t    (is (= :ok (:status export)) (pr-str export))\n   772\t    (is (= :parked (:yin.k/kind body)))\n   773\t    (is (not (contains? body :yin.k/frames))\n   774\t        \"no pending wait is minted for an explicit park\")\n   775\t    (is (contains? (:yin.k/parked body) pid))\n   776\t    (is (= 1 (count (:yin.k/cells body)))\n   777\t        \"the record's captured cursor keeps its position\")\n   778\t    (is (= (:value recv) (get (:parked recv) pid)))\n   779\t    (is (= reference\n   780\t           (vm/value (vm/run (load-ast recv resume-prog))))\n   781\t        \"the parked continuation resumes on the receiver too\")))\n   782\t\n   783\t\n   784\t(deftest a-halt-crosses-as-a-result-with-no-frame\n   785\t  (let [t (toy)\n   786\t        serve! (server (served-peer t) (:channel t))\n   787\t        halted (halted-machine (lit 42))\n   788\t        export (handoff/export-task halted serve!)\n   789\t        body (:body export)\n   790\t        recv (:vm (handoff/resume-task (new-machine)\n   791\t                                       (:bytes export)\n   792\t                                       (attacher t)))]\n   793\t    (is (= :ok (:status export)) (pr-str export))\n   794\t    (is (= :halted (:yin.k/kind body)))\n   795\t    (is (not (contains? body :yin.k/frames)))\n   796\t    (is (= 42 (:yin.k/result body)))\n   797\t    (is (vm/halted? recv))\n   798\t    (is (= 42 (vm/value recv)))\n   799\t    (is (empty? (:wait-set recv)))\n   800\t    (is (empty? (:parked recv)))))\n   801\t\n   802\t\n   803\t;; =============================================================================\n   804\t;; Row 3: interleaved responses around the target\n   805\t;; =============================================================================\n   806\t\n   807\t(deftest interleaved-responses-find-the-correlated-one-once\n   808\t  (let [t (toy)\n   809\t        peer (served-peer t)\n   810\t        serve! (server peer (:channel t))\n   811\t        [parked call-in call-out] (parked-sent-caller)\n   812\t        entry (first (:wait-set parked))\n   813\t        id (:call-id entry)\n   814\t        export (handoff/export-task parked serve!)\n   815\t        own-in (ring 8)\n   816\t        own-out (ring 8)\n   817\t        recv (:vm (handoff/resume-task\n   818\t                    (calling-machine own-in own-out\n   819\t                                     {:op/echo (constantly \"local!\")})\n   820\t                    (:bytes export)\n   821\t                    (attacher t)))\n   822\t        ;; unrelated, duplicate and late responses around the target,\n   823\t        ;; appended while the task is in transit\n   824\t        _ (stream/append! call-out\n   825\t                          (apply2/success-response :other \"noise\"))\n   826\t        _ (stream/append! call-out\n   827\t                          (apply2/success-response id \"echo!\"))\n   828\t        done (drive recv peer)]\n   829\t    (is (= :ok (:status export)))\n   830\t    (is (vm/halted? done))\n   831\t    (is (= \"local!\" (vm/value done))\n   832\t        \"the kept position found the correlated response once, past\n   833\t         the unrelated one before it, and the program's next call was\n   834\t         answered by the receiver's own pair\")\n   835\t    (is (= [\"world\"]\n   836\t           (apply2/request-args (first (tu/drain own-in))))\n   837\t        \"the next call's request is on the receiver's own call-in\")\n   838\t    (is (= 1 (count (tu/drain call-in)))\n   839\t        \"the sent request was not reissued\")))\n   840\t\n   841\t\n   842\t;; =============================================================================\n   843\t;; Row 4: eviction, route loss, profile omission\n   844\t;; =============================================================================\n   845\t\n   846\t(deftest eviction-yields-the-sources-gap-and-successor\n   847\t  (let [t (toy)\n   848\t        peer (served-peer t)\n   849\t        serve! (server peer (:channel t))\n   850\t        [parked src] (parked-reader 1 false)\n   851\t        kept (get-in parked [:resources\n   852\t                             (get-in (first (:wait-set parked))\n   853\t                                     [:cursor-ref :id])\n   854\t                             :cursor])\n   855\t        export (handoff/export-task parked serve!)\n   856\t        _ (doseq [x [\"B\" \"C\" \"D\" \"E\" \"F\"]]\n   857\t            (stream/append! src x))\n   858\t        expected (stream/next src kept)\n   859\t        recv (:vm (handoff/resume-task (new-machine)\n   860\t                                       (:bytes export)\n   861\t                                       (attacher t)))\n   862\t        done (drive recv peer)]\n   863\t    (is (= :ok (:status export)))\n   864\t    (is (= :dao.stream/gap (vm/value done))\n   865\t        \"the receiver reads the source's own gap, never a replay\")\n   866\t    (is (= (:dao.stream/cursor expected)\n   867\t           (get-in done [:resources\n   868\t                         (get-in (first (:wait-set recv))\n   869\t                                 [:cursor-ref :id])\n   870\t                         :cursor]))\n   871\t        \"with the source's exact successor cursor in the cell\")))\n   872\t\n   873\t\n   874\t(deftest a-lost-route-refuses-unsatisfied-naming-the-stream\n   875\t  (let [t (toy)\n   876\t        serve! (server (served-peer t) (:channel t))\n   877\t        [parked _src] (parked-reader 1 false)\n   878\t        export (handoff/export-task parked serve!)\n   879\t        identity (get-in export [:body :yin.k/cells :yin.k/c-0\n   880\t                                 :yin.k/stream :dao.stream/identity])\n   881\t        attach-gone! (fn [_descriptor]\n   882\t                       {:dao.stream/outcome :dao.stream/transport-error,\n   883\t                        :dao.stream.remote/reason\n   884\t                        :dao.stream.remote/not-found})\n   885\t        resumed (handoff/resume-task (new-machine)\n   886\t                                     (:bytes export)\n   887\t                                     attach-gone!)]\n   888\t    (is (= :ok (:status export)))\n   889\t    (is (= :yin.k/unsatisfied (:yin.k/status resumed)))\n   890\t    (is (= identity (:dao.stream/identity resumed))\n   891\t        \"naming the stream identity, with no anchor fallback\")\n   892\t    (is (not= :ok (:status resumed)))))\n   893\t\n   894\t\n   895\t(deftest an-omitted-cursor-profile-refuses-before-publication\n   896\t  (let [t (toy)\n   897\t        serve! (server (served-peer t) (:channel t))\n   898\t        [parked _src] (parked-reader 1 false)\n   899\t        refused (handoff/export-task parked serve!\n   900\t                                     {:cursor-profiles #{}})]\n   901\t    (is (= :yin.k/unsatisfied (:yin.k/status refused))\n   902\t        \"a body with cells cannot drop the profile claim\")\n   903\t    (is (not (contains? refused :bytes))\n   904\t        \"nothing was published\")))\n   905\t\n   906\t\n   907\t;; =============================================================================\n   908\t;; Row 5: the refusal battery\n   909\t;; =============================================================================\n   910\t\n   911\t(deftest queued-work-undeclared-pcs-and-mismatched-evidence-refuse\n   912\t  (let [t (toy)\n   913\t        serve! (server (served-peer t) (:channel t))\n   914\t        [parked _src] (parked-reader 1 false)\n   915\t        as-put (fn [m]\n   916\t                 (update m :wait-set\n   917\t                         (fn [ws]\n   918\t                           (mapv #(assoc % :reason :put :datom \"v\")\n   919\t                                 ws))))]\n   920\t    (is (= :yin.k/not-quiescent\n   921\t           (:yin.k/status\n   922\t             (handoff/export-task\n   923\t               (update parked :ready-queue (fnil conj [])\n   924\t                       {:reason :next, :pc 0})\n   925\t               serve!))))\n   926\t    (is (= :yin.k/not-at-safepoint\n   927\t           (:yin.k/status\n   928\t             (handoff/export-task\n   929\t               (update parked :wait-set\n   930\t                       (fn [ws] (mapv #(assoc % :pc 0) ws)))\n   931\t               serve!))))\n   932\t    (is (= :yin.k/non-portable\n   933\t           (:yin.k/status (handoff/export-task (as-put parked)\n   934\t                                               serve!)))\n   935\t        \"a blocked-read pc admits no write variant: the kinds gate\n   936\t         eligibility, the observed entry is the evidence\")\n   937\t    (is (= :reason-mismatch\n   938\t           (:yin.k/kind (handoff/export-task (as-put parked)\n   939\t                                             serve!))))))\n   940\t\n   941\t\n   942\t(deftest a-forged-resource-reference-refuses-with-its-kind\n   943\t  (let [t (toy)\n   944\t        serve! (server (served-peer t) (:channel t))\n   945\t        [parked _src] (parked-reader 1 false)\n   946\t        m0 (load-ast (new-machine) (lit nil))\n   947\t        forged (engine/issue-ref m0 :cursor-ref :yin/no-such-cell)]\n   948\t    (is (= :forged-resource-reference\n   949\t           (:yin.k/kind\n   950\t             (handoff/export-task\n   951\t               (update parked :wait-set\n   952\t                       (fn [ws]\n   953\t                         (mapv #(assoc-in % [:env 'ghost] forged)\n   954\t                               ws)))\n   955\t               serve!)))\n   956\t        \"a reference the source never issued names nothing portable\")))\n   957\t\n   958\t\n   959\t(defn- tamper\n   960\t  \"Decode the export's bytes, apply `f` to the body, re-encode.\"\n   961\t  [export f]\n   962\t  (cbor/encode (f (cbor/decode (:bytes export)))))\n   963\t\n   964\t\n   965\t(deftest malformed-bodies-refuse-undecodable-whole\n   966\t  (let [t (toy)\n   967\t        serve! (server (served-peer t) (:channel t))\n   968\t        [parked _src] (parked-reader 1 true)\n   969\t        parked (assoc-in parked [:store 'held]\n   970\t                         (engine/issue-ref\n   971\t                           parked :cursor-ref\n   972\t                           (get-in (first (:wait-set parked))\n   973\t                                   [:cursor-ref :id])))\n   974\t        export (handoff/export-task parked serve!)\n   975\t        attach! (attacher t)\n   976\t        resume (fn [bytes]\n   977\t                 (handoff/resume-task (new-machine) bytes attach!))]\n   978\t    (is (= :ok (:status export)))\n   979\t    (testing \"a missing cell reference\"\n   980\t      (is (= :yin.k/undecodable\n   981\t             (:yin.k/status\n   982\t               (resume (tamper export\n   983\t                               #(update % :yin.k/cells\n   984\t                                        dissoc :yin.k/c-0)))))))\n   985\t    (testing \"an extra cell nobody references\"\n   986\t      (is (= :extra-cell\n   987\t             (:yin.k/kind\n   988\t               (resume (tamper\n   989\t                         export\n   990\t                         #(assoc-in %\n   991\t                                    [:yin.k/cells :yin.k/c-9]\n   992\t                                    {:yin.k/stream\n   993\t                                     (get-in %\n   994\t                                             [:yin.k/cells :yin.k/c-0\n   995\t                                              :yin.k/stream]),\n   996\t                                     :yin.k/position 0})))))))\n   997\t    (testing \"a malformed cell\"\n   998\t      (is (= :yin.k/undecodable\n   999\t             (:yin.k/status\n  1000\t               (resume (tamper\n  1001\t                         export\n  1002\t                         #(assoc-in % [:yin.k/cells :yin.k/c-0\n  1003\t                                       :yin.k/stream]\n  1004\t                                    :not-a-marker)))))))\n  1005\t    (testing \"frames that are not a vector\"\n  1006\t      (is (= :yin.k/undecodable\n  1007\t             (:yin.k/status\n  1008\t               (resume (tamper export\n  1009\t                               #(assoc % :yin.k/frames\n  1010\t                                       {:not :a-vector})))))))\n  1011\t    (testing \"code that no longer hashes to its address\"\n  1012\t      (is (= :yin.k/hash-mismatch\n  1013\t             (:yin.k/status\n  1014\t               (resume (tamper\n  1015\t                         export\n  1016\t                         #(update % :yin.k/code\n  1017\t                                  (fn [code]\n  1018\t                                    (into {}\n  1019\t                                          (map (fn [[a _v]]\n  1020\t                                                 [a [[:halt]]]))\n  1021\t                                          code)))))))))\n  1022\t    (testing \"a wrong wire version\"\n  1023\t      (is (= :yin.k/profile-mismatch\n  1024\t             (:yin.k/status\n  1025\t               (resume (tamper export\n  1026\t                               #(assoc % :yin.k/version 1)))))))\n  1027\t    (testing \"bytes that are no body at all\"\n  1028\t      (is (= :yin.k/undecodable\n  1029\t             (:yin.k/status\n  1030\t               (resume (cbor/encode \"not a body\"))))))))\n  1031\t\n  1032\t\n  1033\t(deftest an-install-name-alone-refuses-export\n  1034\t  (let [t (toy)\n  1035\t        serve! (server (served-peer t) (:channel t))\n  1036\t        [parked _child] (parked-installer true)\n  1037\t        stripped (-> parked\n  1038\t                     (update :installs dissoc 'host.mod)\n  1039\t                     (update :wait-set\n  1040\t                             (fn [ws]\n  1041\t                               (mapv #(assoc % :reason :install\n  1042\t                                             :name 'host.mod)\n  1043\t                                     ws))))\n  1044\t        refused (handoff/export-task stripped serve!)]\n  1045\t    (is (= :incomplete-install (:yin.k/kind refused))\n  1046\t        (pr-str refused))\n  1047\t    (is (not (contains? refused :bytes))\n  1048\t        \"an install name alone reconstructs nothing, so nothing is\n  1049\t         published\")))\n  1050\t\n  1051\t\n  1052\t;; =============================================================================\n  1053\t;; Round 5: the graph the two traversals must cover, the child\n  1054\t;; refusal, and the frame grammar\n  1055\t;; =============================================================================\n  1056\t\n  1057\t(deftest a-cell-reachable-only-through-registers-or-an-envelope-crosses\n  1058\t  (let [t (toy)\n  1059\t        serve! (server (served-peer t) (:channel t) #{:reader :writer})\n  1060\t        attach! (attacher t)\n  1061\t        [parked _src] (parked-reader 1 false)\n  1062\t        entry (first (:wait-set parked))\n  1063\t        sid (:stream-id entry)\n  1064\t        kept (get-in parked [:resources\n  1065\t                             (get-in entry [:cursor-ref :id]) :cursor])\n  1066\t        ;; a cell no pending, store or halt result names: only the\n  1067\t        ;; wait frame's captured environment reaches it\n  1068\t        env-only (-> parked\n  1069\t                     (update :resources assoc\n  1070\t                             :yin/lonely {:stream-id sid, :cursor kept})\n  1071\t                     (update-in [:wait-set 0 :env]\n  1072\t                                assoc 'lonely\n  1073\t                                (engine/issue-ref parked :cursor-ref\n  1074\t                                                  :yin/lonely)))\n  1075\t        export (handoff/export-task env-only serve!)\n  1076\t        resumed (when (= :ok (:status export))\n  1077\t                  (handoff/resume-task (new-machine) (:bytes export)\n  1078\t                                       attach!))\n  1079\t        ;; a cell only the retained request's own argument reaches\n  1080\t        call-in (one-slot-stream \"call-in\")\n  1081\t        call-out (ring 8)\n  1082\t        _ (stream/append! call-in :warmed)\n  1083\t        arg-program (let1 's {:type :stream/make, :buffer 4}\n  1084\t                          (let1 'c (cursor-of (v 's))\n  1085\t                                {:type :dao.stream.apply/call,\n  1086\t                                 :op :op/echo, :operands [(v 'c)]}))\n  1087\t        arg-parked (vm/run (load-ast (calling-machine call-in call-out)\n  1088\t                                     arg-program))\n  1089\t        arg-export (handoff/export-task arg-parked serve!)\n  1090\t        arg-resumed (when (= :ok (:status arg-export))\n  1091\t                      (handoff/resume-task (new-machine)\n  1092\t                                           (:bytes arg-export) attach!))]\n  1093\t    (testing \"the register-reached cell is no extra cell\"\n  1094\t      (is (= :ok (:status export)) (pr-str export))\n  1095\t      (is (= 2 (count (get-in export [:body :yin.k/cells])))\n  1096\t          \"the waiter's cell beside the lonely one\")\n  1097\t      (is (contains? (encoded-cell-ids\n  1098\t                       (get-in export [:body :yin.k/frames 0\n  1099\t                                       :yin.k/registers]))\n  1100\t                     (second (keys (get-in export\n  1101\t                                           [:body :yin.k/cells])))))\n  1102\t      (is (= :ok (:status resumed)) (pr-str resumed)))\n  1103\t    (testing \"the envelope-reached cell crosses too\"\n  1104\t      (is (= :ok (:status arg-export)) (pr-str arg-export))\n  1105\t      (is (= 2 (count (get-in arg-export [:body :yin.k/cells])))\n  1106\t          \"the response route beside the argument's own cell\")\n  1107\t      (is (contains? (encoded-cell-ids\n  1108\t                       (get-in arg-export [:body :yin.k/frames 0\n  1109\t                                           :yin.k/pending\n  1110\t                                           :yin.k/request-envelope]))\n  1111\t                     (first (keys (get-in arg-export\n  1112\t                                          [:body :yin.k/cells])))))\n  1113\t      (is (= :ok (:status arg-resumed)) (pr-str arg-resumed)))))\n  1114\t\n  1115\t\n  1116\t(deftest a-stream-carried-only-in-a-register-or-store-attaches\n  1117\t  (let [t (toy)\n  1118\t        serve! (server (served-peer t) (:channel t))\n  1119\t        attach! (attacher t)\n  1120\t        [parked _src] (parked-reader 1 false)\n  1121\t        entry (first (:wait-set parked))\n  1122\t        sid (:stream-id entry)\n  1123\t        carried (engine/issue-ref parked :stream-ref sid)\n  1124\t        parked (-> parked\n  1125\t                   (update-in [:wait-set 0 :env] assoc 'carried carried)\n  1126\t                   (assoc-in [:store 'held-stream] carried))\n  1127\t        export (handoff/export-task parked serve!)\n  1128\t        resumed (when (= :ok (:status export))\n  1129\t                  (handoff/resume-task (new-machine) (:bytes export)\n  1130\t                                       attach!))]\n  1131\t    (is (= :ok (:status export)) (pr-str export))\n  1132\t    (is (= :ok (:status resumed))\n  1133\t        \"the lower attaches what only a register and the store name,\n  1134\t         where collecting less would refuse the decoder's reference\")\n  1135\t    (when (= :ok (:status resumed))\n  1136\t      (let [recv (:vm resumed)\n  1137\t            ref (get-in recv [:wait-set 0 :env 'carried])]\n  1138\t        (is (contains? (:resources recv) (:id ref))\n  1139\t            \"the re-sealed stream reference resolves to an attached\n  1140\t             reflection\")))))\n  1141\t\n  1142\t\n  1143\t(deftest a-refused-install-child-aborts-the-parents-resume\n  1144\t  (let [t (toy)\n  1145\t        serve! (server (served-peer t) (:channel t))\n  1146\t        attach! (attacher t)\n  1147\t        [parked _child] (parked-installer)\n  1148\t        export (handoff/export-task parked serve!)\n  1149\t        grammar-broken (tamper export\n  1150\t                               #(assoc-in %\n  1151\t                                          [:yin.k/installs 'host.mod\n  1152\t                                           :yin.k/child :yin.k/code]\n  1153\t                                          {}))\n  1154\t        route-gone (tamper export\n  1155\t                           #(assoc-in %\n  1156\t                                      [:yin.k/installs 'host.mod\n  1157\t                                       :yin.k/child :yin.k/cells\n  1158\t                                       :yin.k/c-0 :yin.k/stream\n  1159\t                                       :dao.stream/descriptor\n  1160\t                                       :dao.stream/channel]\n  1161\t                                      {:dao.stream.type/x 1}))\n  1162\t        broken (handoff/resume-task (new-machine) grammar-broken\n  1163\t                                    attach!)\n  1164\t        gone (handoff/resume-task (new-machine) route-gone attach!)]\n  1165\t    (testing \"a child the grammar refuses aborts before attachment\"\n  1166\t      (is (= :yin.k/undecodable (:yin.k/status broken))\n  1167\t          (pr-str broken)))\n  1168\t    (testing \"a child whose stream cannot attach propagates\"\n  1169\t      (is (= :yin.k/unsatisfied (:yin.k/status gone))\n  1170\t          (pr-str gone))\n  1171\t      (is (not= :ok (:status gone))\n  1172\t          \"the parent never answers :ok over a child that did not\n  1173\t           lower\"))))\n  1174\t\n  1175\t\n  1176\t(deftest malformed-frames-and-registers-refuse-undecodable-whole\n  1177\t  (let [t (toy)\n  1178\t        serve! (server (served-peer t) (:channel t))\n  1179\t        [parked _src] (parked-reader 1 false)\n  1180\t        export (handoff/export-task parked serve!)\n  1181\t        attach! (attacher t)\n  1182\t        resume (fn [f]\n  1183\t                 (handoff/resume-task (new-machine)\n  1184\t                                      (tamper export f) attach!))\n  1185\t        pc-path [:yin.k/frames 0 :yin.k/registers :yin.k/pc]]\n  1186\t    (is (= :ok (:status export)))\n  1187\t    (testing \"a blocked body without frames\"\n  1188\t      (is (= :yin.k/undecodable\n  1189\t             (:yin.k/status (resume #(dissoc % :yin.k/frames)))))\n  1190\t      (is (= :yin.k/undecodable\n  1191\t             (:yin.k/status (resume #(assoc % :yin.k/frames []))))))\n  1192\t    (testing \"a resume pc outside the segment or below zero\"\n  1193\t      (is (= :yin.k/undecodable\n  1194\t             (:yin.k/status (resume #(assoc-in % pc-path 9999)))))\n  1195\t      (is (= :yin.k/undecodable\n  1196\t             (:yin.k/status (resume #(assoc-in % pc-path -1))))))\n  1197\t    (testing \"a resume pc at no safepoint\"\n  1198\t      (is (= :yin.k/undecodable\n  1199\t             (:yin.k/status (resume #(assoc-in % pc-path 0))))\n  1200\t          \"pc 0 of this program is the outer closure's creation, a\n  1201\t           step, not a parking instruction\"))\n  1202\t    (testing \"a reason the pc's kinds do not admit\"\n  1203\t      (let [refused (resume\n  1204\t                      #(assoc-in %\n  1205\t                                 [:yin.k/frames 0 :yin.k/pending]\n  1206\t                                 {:yin.k/reason :put\n  1207\t                                  :yin.k/stream\n  1208\t                                  (get-in % [:yin.k/cells :yin.k/c-0\n  1209\t                                             :yin.k/stream])\n  1210\t                                  :yin.k/value \"x\"}))]\n  1211\t        (is (= :yin.k/undecodable (:yin.k/status refused))\n  1212\t            (pr-str refused))\n  1213\t        (is (= :reason-mismatch (:yin.k/kind refused)))))\n  1214\t    (testing \"register fields of the wrong type\"\n  1215\t      (is (= :yin.k/undecodable\n  1216\t             (:yin.k/status\n  1217\t               (resume #(assoc-in % [:yin.k/frames 0\n  1218\t                                     :yin.k/registers :yin.k/env]\n  1219\t                                  [])))))\n  1220\t      (is (= :yin.k/undecodable\n  1221\t             (:yin.k/status\n  1222\t               (resume #(assoc-in % [:yin.k/frames 0\n  1223\t                                     :yin.k/registers :yin.k/stack]\n  1224\t                                  {}))))))))\n","exit_code":0,"status":"completed"}}
