{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/handoff.cljc | sed -n '400,555p;934,1005p'; rg -n 'segment|register|safepoint' docs/design/yin.vm.linker.dht.md | tail -30; cat STAGE1-R5-BRIEF.md; git diff -- docs/design/yin.vm.ucf-revisions.md test/yin/vm/ucf_test.cljc\"","aggregated_output":"   400\t(defn- safepoint-kinds-at\n   401\t  \"The static `:yin.safepoint/kinds` at the resume pc of `seg`, from\n   402\t   the loaded image's own canonical vector; an undeclared pc refuses\n   403\t   with the existing :yin.k/not-at-safepoint outcome.\"\n   404\t  [vm seg pc]\n   405\t  (let [image (get (:code vm) seg)\n   406\t        v (when image (completion/image->vector image))]\n   407\t    (cond\n   408\t      (nil? image) (non-portable! :unaddressed-segment {:yin.k/hint seg})\n   409\t      (nil? v) (non-portable! :address-mismatch {:yin.k/hint seg})\n   410\t      :else\n   411\t      (let [at (ucf/safepoint-at v pc)]\n   412\t        (if (contains? at :yin.k/status)\n   413\t          (not-at-safepoint! pc)\n   414\t          (:yin.safepoint/kinds at))))))\n   415\t\n   416\t\n   417\t;; =============================================================================\n   418\t;; Lift: one pending variant each, from the observed entry\n   419\t;; =============================================================================\n   420\t\n   421\t(defn- call-out-cell\n   422\t  \"The emitter's call-out cursor cell -- the response route a retained\n   423\t   call held.  nil when the composition holds no call pair, which no\n   424\t   real retained request does.\"\n   425\t  [resources]\n   426\t  (let [cursor (get resources vm/call-out-cursor-key)\n   427\t        handle (get resources vm/call-out-stream-key)]\n   428\t    (when (and (map? cursor) (contains? cursor :stream-id) handle)\n   429\t      {:id vm/call-out-cursor-key\n   430\t       :stream-id vm/call-out-stream-key\n   431\t       :cursor (:cursor cursor)})))\n   432\t\n   433\t\n   434\t(defn- lift-pending!\n   435\t  \"The S7.4.3 pending of one observed entry, in `yin.vm.ucf.remote`'s\n   436\t   wire shapes, minted through THIS export's one cell and marker maps:\n   437\t   the cell a waiter names is the same cell a closure or the store\n   438\t   reaches, and the response route a retained call held is a cell like\n   439\t   any other, at its kept position.\"\n   440\t  [vm serve! found encode entry]\n   441\t  (case (observed-wire entry)\n   442\t    :next\n   443\t    {:yin.k/reason :next\n   444\t     :yin.k/cell (cell-for! vm serve! found\n   445\t                            (get-in entry [:cursor-ref :id]))}\n   446\t\n   447\t    :ffi\n   448\t    (cond-> {:yin.k/reason :ffi\n   449\t             :yin.k/call-id (:call-id entry)\n   450\t             :yin.k/cell (cell-for! vm serve! found\n   451\t                                    (get-in entry [:cursor-ref :id]))}\n   452\t      (contains? entry :op) (assoc :yin.k/op (:op entry)))\n   453\t\n   454\t    :put\n   455\t    (do (when-not (contains? entry :datom)\n   456\t          (non-portable! :incomplete-write\n   457\t                         {:yin.k/pc (:pc entry)}))\n   458\t        {:yin.k/reason :put\n   459\t         :yin.k/stream (marker-for! vm serve! found (:stream-id entry))\n   460\t         :yin.k/value (encode (:datom entry))})\n   461\t\n   462\t    :ffi-request\n   463\t    (let [route (call-out-cell (:resources vm))]\n   464\t      (if (nil? route)\n   465\t        (unsatisfied!)\n   466\t        (let [envelope (:datom entry)]\n   467\t          {:yin.k/reason :ffi-request\n   468\t           :yin.k/call-id (:call-id entry)\n   469\t           :yin.k/request-envelope (encode envelope)\n   470\t           :yin.k/request-op (or (apply2/request-op envelope)\n   471\t                                 (:op entry))\n   472\t           :yin.k/request-args (apply2/request-args envelope)\n   473\t           :yin.k/request (marker-for! vm serve! found\n   474\t                                       (:stream-id entry))\n   475\t           :yin.k/response (marker-for! vm serve! found\n   476\t                                        (:stream-id route))\n   477\t           :yin.k/response-cell (cell-for! vm serve! found\n   478\t                                           (:id route))})))\n   479\t\n   480\t    (:link-request :link-response)\n   481\t    (let [reason (:reason entry)\n   482\t          kept (:cursor entry)]\n   483\t      (cond-> {:yin.k/reason reason\n   484\t               :yin.k/link-id (:link-id entry)\n   485\t               :yin.k/name (:name entry)\n   486\t               :yin.k/request (marker-for! vm serve! found\n   487\t                                           (:request entry))\n   488\t               :yin.k/response (marker-for! vm serve! found\n   489\t                                            (:response entry))\n   490\t               :yin.k/cell (cell-at! vm serve! found\n   491\t                                     [(:response entry) kept]\n   492\t                                     (:response entry) kept)}\n   493\t        (= :link-request reason)\n   494\t        (assoc :yin.k/envelope (encode (:envelope entry)))))\n   495\t\n   496\t    :install\n   497\t    (do (when-not (contains? (:installs vm) (:name entry))\n   498\t          (non-portable! :incomplete-install {:yin.k/name (:name entry)}))\n   499\t        {:yin.k/reason :install\n   500\t         :yin.k/name (:name entry)})\n   501\t\n   502\t    (undecodable! {:yin.k/reason (:reason entry)\n   503\t                   :yin.k/path [:yin.k/wait (:pc entry)]})))\n   504\t\n   505\t\n   506\t(defn- lift-frame!\n   507\t  \"One wait entry lifted: its registers and its pending, the dynamic\n   508\t   reason checked against the static kinds at its pc -- the kinds gate\n   509\t   eligibility only, and a variant they do not admit is evidence the\n   510\t   frame is not exportable here, never a wire reason to invent.\"\n   511\t  [vm serve! found encode entry]\n   512\t  (let [kinds (safepoint-kinds-at vm (:segment entry) (:pc entry))\n   513\t        wire (observed-wire entry)]\n   514\t    (when (nil? wire)\n   515\t      (undecodable! {:yin.k/reason (:reason entry)\n   516\t                     :yin.k/path [:yin.k/wait (:pc entry)]}))\n   517\t    (when-not (some #(contains? (get wire-of-kind %) wire) kinds)\n   518\t      (non-portable! :reason-mismatch\n   519\t                     {:yin.k/pc (:pc entry)\n   520\t                      :yin.k/reason wire\n   521\t                      :yin.safepoint/kinds (vec kinds)}))\n   522\t    {:yin.k/registers (encode-registers found encode vm entry)\n   523\t     :yin.k/pending (lift-pending! vm serve! found encode entry)}))\n   524\t\n   525\t\n   526\t;; =============================================================================\n   527\t;; The install children: a whole child travels, or nothing does\n   528\t;; =============================================================================\n   529\t\n   530\t(declare export-task validate-body resume-task)\n   531\t\n   532\t\n   533\t(defn- export-installs\n   534\t  \"Each live install child of `vm` as its own handoff body beside the\n   535\t   response that spawned it, preserving the child's phase and waits\n   536\t   (14.1.1's :install row).  A child that cannot export itself refuses\n   537\t   the parent's export -- a refusal is thrown, never embedded -- and a\n   538\t   response outside the canonical bytes domain refuses it too.\"\n   539\t  [vm serve!]\n   540\t  (into {}\n   541\t        (map (fn [[m {:keys [vm phase parent response]}]]\n   542\t               (when-not (cbor/portable-value? response)\n   543\t                 (non-portable! :install-response {:yin.k/name m}))\n   544\t               (let [r (export-task vm serve!)]\n   545\t                 (when (not= :ok (:status r))\n   546\t                   (refuse! (:yin.k/status r) (dissoc r :status)))\n   547\t                 [m {:yin.k/phase phase\n   548\t                     :yin.k/parent parent\n   549\t                     :yin.k/response response\n   550\t                     :yin.k/child (:body r)}])))\n   551\t        (:installs vm)))\n   552\t\n   553\t\n   554\t;; =============================================================================\n   555\t;; Export (14.1.2 lift): the whole blocked task as canonical bytes\n   934\t  [body]\n   935\t  (when-not (and (map? body) (true? (get body handoff-tag)))\n   936\t    (undecodable! {:yin.k/kind :body}))\n   937\t  (when-not (= handoff-version (:yin.k/version body))\n   938\t    (refuse! :yin.k/profile-mismatch\n   939\t             {:yin.k/version (:yin.k/version body)}))\n   940\t  (let [kind (:yin.k/kind body)\n   941\t        cells (or (:yin.k/cells body) {})\n   942\t        code (or (:yin.k/code body) {})]\n   943\t    (when-not (contains? #{:blocked :parked :halted} kind)\n   944\t      (undecodable! {:yin.k/kind kind :yin.k/path [:yin.k/kind]}))\n   945\t    (when-not (and (map? cells) (map? code))\n   946\t      (undecodable! {:yin.k/path [:yin.k/cells]}))\n   947\t    (doseq [[cid cell] cells]\n   948\t      (when-not (and (map? cell) (marker? (:yin.k/stream cell))\n   949\t                     (contains? cell :yin.k/position))\n   950\t        (undecodable! {:yin.k/cell cid :yin.k/path [:yin.k/cells cid]})))\n   951\t    (doseq [[a v] code]\n   952\t      (when-not (= a (ucf/code-address v))\n   953\t        (refuse! :yin.k/hash-mismatch {:yin.k/segment a}))\n   954\t      (when-some [defect (code/well-formed-vector? v)]\n   955\t        (undecodable! {:yin.k/segment a :yin.k/pc (:pc defect)\n   956\t                       :yin.k/defect defect})))\n   957\t    (validate-frames body code cells)\n   958\t    (when (contains? body :yin.k/frames)\n   959\t      (when (= :halted kind)\n   960\t        (undecodable! {:yin.k/path [:yin.k/frames]})))\n   961\t    (when (and (= :blocked kind)\n   96