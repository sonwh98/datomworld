xt :put} (:reason entry))\n  1685\t      (when (contains? (get wake-error-outcomes (:reason entry)) status)\n  1686\t        status))))\n  1687\t\n  1688\t\n  1689\t(defn- throw-terminal-resume!\n  1690\t  \"Fail a resumed entry exactly as the immediate operation would have. A\n  1691\t   waitset diagnostic names its status and the entry that earned it: there\n  1692\t   is no stream operation whose error vocabulary it belongs to.\"\n  1693\t  [entry o]\n  1694\t  (cond\n  1695\t    (contains? waitset-diagnostics o)\n  1696\t    (fail \"Wait-set entry woke with a diagnostic\" {:status o, :entry entry})\n  1697\t    ;; a refused or lost link, or a refused install: the effect's error\n  1698\t    (= :link-refused o)\n  1699\t    (fail (str \"Module link refused: \"\n  1700\t               (clojure.core/name (or (:reason (:refusal entry)) :refused)))\n  1701\t          (assoc (:refusal entry) :link-module (:name entry)))\n  1702\t    ;; an FFI response stream that can no longer answer this call\n  1703\t    (contains? ffi/response-loss-statuses o)\n  1704\t    (ffi/throw-response-lost! (ffi/response-call-id entry) o)\n  1705\t    (= :next (:reason entry))\n  1706\t    (fail \"Stream read failed\"\n  1707\t          {:outcome o,\n  1708\t           :stream-id (:stream-id entry),\n  1709\t           :cursor-id (:id (:cursor-ref entry))})\n  1710\t    :else (fail \"Stream append failed\"\n  1711\t                {:outcome o, :stream-id (:stream-id entry)})))\n  1712\t\n  1713\t\n  1714\t(defn resume-from-run-queue\n  1715\t  \"Pop first entry from the ready-queue, merge its resource updates into\n1667:(defn- terminal-resume-outcome\n1689:(defn- throw-terminal-resume!\n1714:(defn resume-from-run-queue\n1789:(defn resume-continuation\n","exit_code":0,"status":"completed"}}
