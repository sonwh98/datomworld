and every minted address\n   change together.\"\n  [v]\n  (sha256 (order-normalized-print v)))\n\n\n(defn segment-key\n  \"Mint the content-addressed key for an opaque payload, derived solely from\n   the payload: :segment/sha256-<hash(payload)>. The algorithm prefix is\n   load-bearing twice over: it names the hash function, and it keeps the\n   keyword readable EDN — a name starting with a bare hex digit cannot\n   survive print -> read, which poisons every EDN boundary content\n   addresses cross.\"\n  [v]\n  (keyword \"segment\" (str \"sha256-\" (content-hash v))))\n\n\n(defn segment-address?\n   171\t(def ^:private semantic-bytecode-corpus\n   172\t  \"Canonical map ASTs (every saturated field stated) covering every §2.3 tag.\"\n   173\t  [(lit 1) (lit \"s\") (lit nil) (lit :k) (lit '[1 (2 3) #{4}]) (lit {:a 1})\n   174\t   (local 'x)\n   175\t   (global '+)\n   176\t   {:type :lambda, :params [], :body (lit 0)}\n   177\t   {:type :lambda, :params '[x], :body (local 'x)}\n   178\t   {:type :lambda,\n   179\t    :params '[x y z],\n   180\t    :body (app (global '+) [(local 'x) (local 'y) (local 'z)] true)}\n   181\t   (app (global 'f) [] false)\n   182\t   (app (global 'f) [(lit 1)] true)\n   183\t   (app {:type :lambda, :params '[x], :body (local 'x)} [(lit 1) (lit 2)] false)\n   184\t   {:type :if,\n   185\t    :test (app (global '<) [(lit 1) (lit 2)] false),\n   186\t    :consequent (app (global 'f) [(lit 41)] true),\n   187\t    :alternate (lit 0)}\n   188\t   {:type :dao.stream.apply/call, :op :op/none, :operands []}\n   189\t   {:type :dao.stream.apply/call, :op :op/add, :operands [(lit 1) (lit 2)]}\n   190\t   {:type :vm/gensym, :prefix \"id\"}\n   191\t   {:type :vm/gensym, :prefix \"g\"}\n   192\t   {:type :vm/store-get, :key 'yin/def}\n   193\t   {:type :vm/store-get, :key :k}\n   194\t   {:type :vm/store-get, :key 3}\n   195\t   {:type :vm/store-put, :key :k, :val [1 {:b 2}]}\n   196\t   {:type :vm/current-continuation}\n   197\t   {:type :vm/park}\n 