{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn step|first \\\\(candidates|:mint \\\\(engine|:link-mint \\\\(engine|defn- quiet|defn- cell-candidates|defn- apply-candidate' src/cljc/yin/vm/ucf/holder/reader.cljc\nrg -n 'cursor.*outcome|:cursor|invalid-answer' src/cljc/dao/stream.cljc | head -24\nsed -n '1928,1970p' src/cljc/yin/vm/engine.cljc\nsed -n '1048,1088p' test/yin/vm/ucf/holder/reader_test.cljc\"","aggregated_output":"174:(defn- cell-candidates\n279:(defn- apply-candidate\n287:                  :mint (engine/apply-mint m (:cell-id candidate)\n289:                  :link-mint (engine/apply-link-cursor m\n459:(defn step\n491:            (if-some [candidate (first (candidates machine))]\n648:(defn- quiet?\n28:  #{:create! :attach! :descriptor :cursor :next :append! :close!})\n108:   :cursor outcomes-cursor\n119:   [:cursor :dao.stream/ok] #{:dao.stream/cursor}\n130:   :cursor, :next, :append!, :close!). Supports aliases without '!'.\"\n136:    (:cursor) :cursor\n      :else (wake-slot state i\n                       [(if (= :dao.stream/ok o)\n                          (woken-answer entry :ok (:datom entry) nil)\n                          (woken-answer entry o o nil))]))))\n\n\n(defn apply-next\n  \"Apply the driver's read `outcome` to the gated parked `:next` entry\n   `entry`, as the ungated sweep applies a retry: `blocked` keeps\n   waiting; `ok` and `gap` advance the cursor cell to the outcome's\n   position and wake it; `end` and every other outcome wake it under\n   their own status. Performs no stream call. Refused as `apply-put` is,\n   for an FFI response reader (`apply-ffi-read`), and for an entry whose\n   cursor cell is still unminted (the driver mints it first).\"\n  [state entry outcome]\n  (require-running! state {})\n  (let [i (wait-slot state entry\n                     #(and (= :next (:reason %))\n                           (map? (:cursor-ref %))\n                           (nil? (ffi/response-call-id %)))\n                     :next)\n        _ (refuse-unminted! state entry)\n        o (:dao.stream/outcome outcome)\n        cursor (:dao.stream/cursor outcome)\n        cursor-id (:id (:cursor-ref entry))\n        advance #(assoc-in state [:resources cursor-id :cursor] cursor)]\n    (cond\n      (invalid-answer? :next outcome)\n      (wake-slot state i [{:entry entry,\n                           :status :dao.stream.waitset/invalid-answer}])\n      (= :dao.stream/blocked o) state\n      (= :dao.stream/ok o)\n      (wake-slot (advance) i\n                 [(woken-answer entry :ok (:dao.stream/value outcome) cursor)])\n      (= :dao.stream/end o)\n      (wake-slot state i [(woken-answer entry :end nil nil)])\n      (= :dao.stream/gap o)\n      (wake-slot (advance) i\n                 [(woken-answer entry :dao.stream/gap :dao.stream/gap\n                                cursor)])\n      :else (wake-slot state i [(woken-answer entry o o nil)]))))\n\n\n(deftest a-custody-map-without-a-frontier-fails-closed-test\n\n  (let [h (ring 8)\n        _ (stream/append! h \"A\")\n        [_cref parked] (gated-poll h)\n        base (assoc parked :yin.k/custody (prefix-custody []))\n        no-input (assoc parked :yin.k/custody\n                        (dissoc (prefix-custody []) :input))\n        [observe! calls] (counting-observe)\n        sink (fn [_r] {:dao.stream/outcome :dao.stream/ok})]\n    (doseq [[label m] [[\"a missing :input map\" no-input]\n                       [\"an empty prefix map\" (assoc-in base\n                                                        [:yin.k/custody :input :prefix]\n                                                        {})]\n                       [\"a status-bearing prefix\" (assoc-in base\n                                                            [:yin.k/custody :input :prefix]\n                                                            {:yin.k/status :suspended\n                                                             :yin.k/reason :unavailable})]]\n            :let [out (reader/step m sink observe!)]]\n      (testing label\n        (is (= {:yin.k/status :yin.k/unsatisfied :yin.k/reason :no-prefix}\n               (:unsatisfied out)))\n        (is (empty? (:appended out)))\n        (is (= m (:machine out)))))\n    (is (zero? @calls) \"nothing was ever observed\")\n    (testing \"replay fails closed the same way\"\n      (let [out (reader/replay no-input)]\n        (is (= {:yin.k/status :yin.k/unsatisfied :yin.k/reason :no-prefix}\n               (:unsatisfied out)))\n        (is (empty? (:applied out)))))))\n","exit_code":0,"status":"completed"}}
