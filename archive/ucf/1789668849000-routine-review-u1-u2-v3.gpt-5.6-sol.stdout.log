     :slot-kind-str [{:rule :slot-kind, :path [1]} (one-row-bc [:vm/gensym :not-a-string])]\n593:+     :slot-kind-node [{:rule :slot-kind, :path [1]} (one-row-bc [:stream/next 123])]\n594:+     :slot-kind-nodes [{:rule :slot-kind, :path [2]} (one-row-bc [:application fake-address-a :not-a-vector false])]\n595:+     :slot-kind-data [{:rule :slot-kind, :path [2]} (one-row-bc [:vm/store-put :key-ok (fn [])])]\n596:+     :slot-kind-sym [{:rule :slot-kind, :path [1]} (one-row-bc [:variable \"not-a-sym\"])]\n597:+     :slot-kind-kw [{:rule :slot-kind, :path [1]} (one-row-bc [:vm/resume \"not-a-kw\" fake-address-a])]\n598:+     :slot-kind-int [{:rule :slot-kind, :path [1]} (one-row-bc [:stream/make :not-int])]\n607:diff --git a/test/yin/vm/parity_test.cljc b/test/yin/vm/parity_test.cljc\n629:+          \"put is refused on closed stream\"))))\n630:diff --git a/test/yin/vm_test.cljc b/test/yin/vm_test.cljc\n663:+   '(stream/put! s 42)\n695:+      (is (= expected (vm/validate-rows bc)))\n709:+                                ;; validate-rows checks root-reachable first, so the\n","exit_code":0,"status":"completed"}}
