d only the unknown effect\")\n644:(deftest an-at-least-once-write-carries-no-id-and-is-appended-bare-test\n678:(deftest a-fail-stop-write-ends-the-run-before-performing-it-test\n708:(deftest an-undeclared-target-is-unsatisfied-test\n727:(deftest intent-conflict-ends-emission-and-quarantine-survives-release-test\n769:                         [:occurrences occ :yin.k/quarantined]))\n770:          \"the authenticated conflict quarantined the occurrence\")\n778:      (testing \"the release is carried\"\n779:        (let [release {:yin.k/request :yin.k/release\n782:              _ (stream/append! (:in w) release)\n784:          (is (= (lease/release lease-1) (last (read-all (:medium w)))))\n789:            (is (= :release (get-in p [:leases lease-1 :dao.lease/cause]))\n790:                \"the release lapsed the lease\")\n791:            (is (true? (get-in p [:occurrences occ :yin.k/quarantined]))\n792:                \"the D11 release cleared no quarantine\")\n793:            (is (nil? (get-in p [:occurrences occ :yin.k/closed]))\n801:                    \"no second grant for the quarantined occurrence\")\n860:(deftest a-read-apply-refuses-an-unminted-cursor-cell-test\n903:(deftest apply-ffi-outcome-covers-the-terminal-append-outcomes-test\n924:            via-outcome (engine/apply-ffi-outcome m call\n932:      (is (= m (engine/apply-ffi-outcome m call\n936:      (let [refused (engine/apply-ffi-outcome m call\n938:                                               :dao.stream/closed})]\n940:        (is (= [:dao.stream/closed] (mapv :status (:ready-queue refused))))))\n942:      (is (throws? #(engine/apply-ffi-outcome\n945:      (is (throws? #(engine/apply-ffi-outcome m :no-such-call\n948:      (let [sent (engine/apply-ffi-outcome m call\n951:        (is (throws? #(engine/apply-ffi-outcome sent call\n\n\n(defn- poll-links\n  \"Poll every link wait entry once, in wait-set order, and then step the\n   install children. Returns the state with the still-waiting link\n   entries appended to `others` and the woken ones queued.\"\n  [state links others]\n  (let [[state waiting woken]\n        (reduce (fn [[state waiting woken] entry]\n                  (let [[state w k] (poll-link-entry state entry)]\n                    [state\n                     (cond-> waiting w (conj w))\n                     (cond-> woken k (conj k))]))\n                [state [] []]\n                links)]\n    (-> state\n        (assoc :wait-set (into (vec others) waiting))\n        (update :ready-queue (fnil into []) woken)\n        advance-installs)))\n\n\n(defn- require-running!\n  \"Refuse a driver apply on an ungated task (it drives itself) and in the\n   `:exporting` and `:ended` gates (a late result).\"\n  [state data]\n  (let [mode (vm/gate-mode state)]\n    (when-not (= :running mode)\n      (fail (if (nil? mode)\n              \"Ungated task: it drives its own streams\"\n              \"Gate is closed: late apply refused\")\n            (assoc data :yin.k/gate mode)))))\n\n\n(defn- link-entry-slot\n  \"The index of the gated task's wait entry in `reason` for `link-id`;\n   refuses an ungated task, the `:exporting` and `:ended` gates, and an id\n   no such entry holds.\"\n  [state link-id reason]\n  (require-running! state {:link-id link-id})\n  (or (first (keep-indexed (fn [i e]\n                             (when (and (= reason (:reason e))\n                                        (= link-id (:link-id e)))\n                               i))\n                           (:wait-set state)))\n      (fail \"No such link entry\" {:link-id link-id, :reason reason})))\n\n\n(defn apply-link-cursor\n  \"Apply the driver's mint of the link response cursor for the gated\n   `:link-request` entry `link-id`: sets `:cursor` to the portable\n   `position`. The entry stays a `:link-request`, envelope verbatim;\n   nothing is woken. Performs no stream call. Refused for an ungated\n   task, in the `:exporting` and `:ended` gates, for an id no\n   `:link-request` entry holds, and for an entry that has a cursor.\"\n  [state link-id position]\n  (let [i (link-entry-slot state link-id :link-request)]\n    (when (contains? (get-in state [:wait-set i]) :cursor)\n      (fail \"Link cursor already installed\" {:link-id link-id}))\n    (assoc-in state [:wait-set i :cursor] position)))\n\n\n(defn apply-link-sent\n  \"Apply the driver's send of the gated `:link-request` entry `link-id`:\n   the entry moves to `:link-response` and drops its envelope. Performs no\n   stream call. Refused as `apply-link-cursor` is, and for an entry\n   without `:cursor`: the cursor precedes the append.\"\n  [state link-id]\n  (let [i (link-entry-slot state link-id :link-request)]\n    (when-not (contains? (get-in state [:wait-set i]) :cursor)\n      (fail \"Link request sent before its cursor\" {:link-id link-id}))\n    (update-in state\n               [:wait-set i]\n               #(-> % (dissoc :envelope) (assoc :reason :link-response)))))\n\n\n(defn apply-link-read\n  \"Apply one read `outcome` of the link response stream to the gated\n   `:link-response` entry `link-id`, as `poll-link-response` applies one\n   read; the successor position is inside the outcome. Another id's\n   response advances the cursor and is skipped, `blocked` keeps waiting,\n   the entry's own response settles and the rest refuse. Performs no\n1:(ns yin.vm.ucf.authority.admission\n5:   `admit!` is the one admission entry point: a fenced envelope that\n30:   The answer is one map on the closed `:yin.k/admission` family\n31:   (`admissions`), a defective-envelope diagnostic, or `::unenrolled`\n33:   admission.  A defective envelope commits nothing; exactly one\n47:   (`authority/transition!`), so an admission and a reclaim serialize.\"\n56:(def admissions\n57:  \"The closed `:yin.k/admission` family (UCF 7.9).\"\n83:  \"The admission outcome `k` answering `envelope`, with `more`.  Only a\n84:   member of `admissions` can be made.\"\n86:  (when-not (contains? admissions k)\n87:    (throw (ex-info \"not an admission outcome\" {:yin.k/admission k})))\n88:  (merge {:yin.k/admission k\n90:          :yin.k/incarnation (get envelope :yin.k/incarnation)}\n105:  [:yin.k/envelope :yin.k/incarnation :yin.k/epoch :yin.k/op-id\n114:       (some? (get e :yin.k/incarnation))\n141:                             (select-keys envelope [:yin.k/incarnation\n172:   occurrences) plus one content-store read per inherited admission, all\n239:  \"The admission of well-formed envelope `e` with intent h at target i\n245:          l (get e :yin.k/incarnation)\n331:(defn reply-evidence\n332-  \"Whether `record`, read from a stream the composition attributes to\n333-   `author`, is an outcome authored by the authority whose identity is\n334-   `arbitration`: a reply of this front, or a `:yin.k/admission` outcome\n335-   of the outcome projection.  Answers the record when `author` equals\n336-   `arbitration` and the record is an outcome, else `{::no-evidence\n337-   reason}`, reason :other-author or :not-an-outcome.  Identity\n338-   equality only: a descriptor is never compared, and a record from any\n339-   other author discharges nothing, whatever it claims.\"\n340-  [arbitration author record]\n341-  (cond\n    80\t   retained FFI request.\"\n    81\t  [entry]\n    82\t  (= :put (:reason entry)))\n    83\t\n    84\t\n    85\t(defn- call-id\n    86\t  \"The call id when `entry` is a retained FFI request.\"\n    87\t  [entry]\n    88\t  (ffi/request-call-id entry))\n    89\t\n    90\t\n    91\t(defn- writes\n    92\t  \"The `[path entry]` of every retained write: the root's wait set in\n    93\t   order, then each child's.\"\n    94\t  [root]\n    95\t  (into []\n    96\t        (mapcat (fn [[prefix m]]\n    97\t                  (keep (fn [e] (when (write? e) [prefix e]))\n    98\t                        (:wait-set m))))\n    99\t        (machines root)))\n   100\t\n   265\t                class (classes m path entry)]\n   266\t            (cond\n   267\t              (nil? cla