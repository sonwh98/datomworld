ts) primitives),\n   230\t   :stream-put 13,\n   231\t   :stream-cursor 14,\n   232\t   :stream-next 15,\n   233\t   :stream-close 16,\n   234\t   :park 17,\n   235\t   :resume 18,\n   236\t   :current-cont 19,\n   237\t   :tailcall 20,\n   238\t   :dao.stream.apply/call 21,\n   239\t   :push 22,\n   240\t   :halt 23})\n   241\t\n   242\t\n   243\t#?(:clj\n   244\t   (defmacro opcase\n   245\t     \"Dispatch on a numeric opcode using keyword mnemonics.\n   246\t      Resolved at compile-time to a standard 'case' over integers.\"\n   247\t     [op-expr & clauses]\n   248\t     (let [default (when (odd? (count clauses)) (last clauses))\n   249\t           paired (if default (butlast clauses) clauses)\n   250\t           pairs (partition 2 paired)\n   251\t           ;; Keep a local literal map so CLJD macro host compilation\n   252\t           ;; does not depend on resolving `opcode-table` as a host\n   253\t           ;; symbol.\n   254\t           opcodes {:literal 1,\n   255\t                    :load-var 2,\n   256\t                    :move 3,\n   257\t                    :lambda 4,\n   258\t                    :call 5,\n   259\t                    :return 6,\n   260\t                    :branch 7,\n   261\t                    :jump 8,\n   262\t                    :gensym 9,\n   263\t                    :store-get 10,\n   264\t                    :store-put 11,\n   265\t                    :stream-make 12,\n   266\t                    :stream-put 13,\n   267\t                    :stream-cursor 14,\n   268\t                    :stream-next 15,\n   269\t                    :stream-close 16,\n   270\t                    :park 17,\n   271\t                    :resume 18,\n   272\t                    :current-cont 19,\n   273\t                    :tailcall 20,\n   274\t                    :dao.stream.apply/call 21,\n   275\t                    :push 22,\n   276\t                    :halt 23}\n   277\t           resolved (mapcat (fn [[kw body]] [(get opcodes kw) body]) pairs)]\n   278\t       `(case (int ~op-expr) ~@resolved ~@(when default [default])))))\n   279\t\n   280\t\n   281\t(def schema\n   282\t  \"DaoDB schema for :yin/ AST datoms.\n   283\t   Complete data model for the Universal AST as queryable datoms.\"\n   284\t  {;; Ref attributes (entity references, tempid resolution)\n   285\t   :yin/body {:db/valueType :db.type/ref},\n   286\t   :yin/operator {:db/valueType :db.type/ref},\n   287\t   :yin/operands {:db/valueType :db.type/ref,\n   288\t                  :db/cardinality :db.cardinality/many},\n   289\t   :yin/test {:db/valueType :db.type/ref},\n   290\t   :yin/consequent {:db/valueType :db.type/ref},\n   291\t   :yin/alternate {:db/valueType :db.type/ref},\n   292\t   :yin/source {:db/valueType :db.type/ref},\n   293\t   :yin/target {:db/valueType :db.type/ref},\n   294\t   :yin/val-node {:db/valueType :db.type/ref},\n   295\t   ;; Ground-value attributes. The data model uses Datomic-style schema\n   296\t   ;; definitions. Value types are declared in comments for the data\n   297\t   ;; model.\n   298\t   :yin/type {},      ; keyword (:literal, :variable, :lambda, ...)\n   299\t   :yin/value {},     ; polymorphic (number, string, boolean, keyword, ...)\n   300\t   :yin/name {},      ; symbol\n   301\t   :yin/op {},        ; keyword (dao.stream.apply operation key)\n   302\t   :yin/params {},    ; vector of symbols\n   303\t   :yin/key {},       ; symbol\n   304\t   :yin/prefix {},    ; string\n   305\t   :yin/buffer {},    ; long\n   306\t   :yin/parked-id {}, ; keyword\n   307\t   :yin/tail? {},     ; boolean (tail-position flag)\n   308\t   :yin/root {},      ; boolean — marks the batch's root entity; the last\n   309\t   ;; one in batch order wins (yin.vm.macro.md §2.4)\n   310\t   ;; Macro attributes. Expansion events and their refs belong to the\n   311\t   ;; expander's `event-schema`, not to the Universal AST.\n   312\t   :yin/macro? {},    ; boolean — true if lambda is a macro\n   313\t   :yin/macro-name {} ; symbol — the macro operator's name when it was a\n   314\t   ;; :variable\n   315\t   })\n   316\t\n   317\t\n   318\t(def code-schema\n   319\t  \"DaoDB schema for :yin.code/ linear executable datoms.\n   320\t   A segment entity plus instruction entities ordered by an explicit\n   321\t   :yin.code/pc fact; see docs/design/yin.vm.semantic.md §2.\"\n   322\t  {;; Ref attributes (entity references, tempid resolution)\n   323\t   :yin.code/segment {:db/valueType :db.type/ref},      ; instruction → segment\n   324\t   :yin.code/target {:db/valueType :db.type/ref},       ; branch → instruction\n   325\t   :yin.code/body {:db/valueType :db.type/ref},         ; closure → entry\n   153\t(defn relation\n   154\t  \"An in-memory relation value. Its retained contents are an arbitrary,\n   155\t   mixed-dimensional tuple collection; arity never selects an\n   156\t   interpretation. This is the replacement for the direct raw-vector input.\"\n   157\t  [tuples]\n   158\t  {:dao.space.query/relation (vec tuples)})\n   159\t\n   154\t\n   155\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   156\t| `:yin.code/op`          | Operand attributes                            | Effect on the machine                                                            |\n   157\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   158\t| `:const`                | `:yin.code/value v`                           | `val ← v`                                                                        |\n   159\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   160\t| `:var`                  | `:yin.code/name sym`                          | `val ← resolve(E, S, prims, modules, sym)`                                       |\n   161\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   162\t| `:closure`              | `:yin.code/params [..]`, `:yin.code/body ref` | `val ← {:type :closure :params .. :entry pc(body) :segment seg :env E}`          |\n   163\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   164\t| `:push`                 | —                                             | `St ← St ⧺ [val]`                                                                |\n   165\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   166\t| `:call`                 | `:yin.code/argc n`, `:yin.code/tail? bool`    | pop `n` args and the operator below them; apply (§4.3)                           |\n   167\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   168\t| `:return`               | —                                             | pop frame from `K`; restore `pc`, `E`, stack base; `val` unchanged; empty `K`    |\n   169\t|                         |                                               | halts                                                                            |\n   170\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   171\t| `:jump`                 | `:yin.code/target ref`                        | `pc ← target`                                                                    |\n   172\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   173\t| `:branch-false`         | `:yin.code/target ref`                        | `pc ← val ? pc+1 : target`                                                       |\n   174\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   175\t| `:halt`                 | —                                             | halt with `val` as the result                                                    |\n   176\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   177\t| `:gensym`               | `:yin.code/prefix`                            | `val ← fresh id`; id counter advances                                            |\n   178\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   179\t| `:store-get`            | `:yin.code/key`                               | `val ← S[key]`                                                                   |\n   180\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   181\t| `:store-put`            | `:yin.code/key`, `:yin.code/value`            | `S[key] ← v; val ← v`                                                            |\n   182\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   183\t| `:stream-make`          | `:yin.code/buffer`                            | effect `:stream/make` via engine                                                 |\n   184\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   185\t| `:stream-put`           | —                                             | target ref popped from `St`, value in `val`; effect `:stream/put`                |\n   186\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   187\t| `:stream-cursor`        | —                                             | source ref in `val`; effect `:stream/cursor`                                     |\n   188\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   189\t| `:stream-next`          | —                                             | cursor ref in `val`; effect `:stream/next`                                       |\n   190\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   191\t| `:stream-close`         | —                                             | source ref in `val`; effect `:stream/close`                                      |\n   192\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   193\t| `:park`                 | —                                             | `engine/park-continuation` with the current frame                                |\n   194\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   195\t| `:resume`               | `:yin.code/parked-id`                         | resume value in `val`; `engine/resume-continuation`                              |\n   196\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   197\t| `:current-continuation` | —                                             | `val ← {:type :reified-continuation :segment :pc :env :stack :k}`                |\n   198\t+-------------------------+-----------------------------------------------+----------------------------------------------------------------------------------+\n   218\t\n   219\t### 2.5 Constants and literals\n   220\t\n   221\tA literal lives inline in the `v` slot of `:yin.code/value`, polymorphic\n   222\texactly as `:yin/value` is today (numbers, strings, keywords, vectors, maps,\n   223\tsets, nil). Host functions never appear in code datoms; a primitive is named\n   224\tby symbol in `:var` and resolved at run time through the supplied\n   225\t`:primitives`, which is how the walker already avoids putting host objects in\n   226\tthe program. A shared or large constant pool (`:yin.code/const-ref` to a\n   227\tconstant entity) is reserved and not needed for the current corpus.\n   228\t\n   229\t### 2.6 Well-formedness (checked by the loader, tested in Phase 0)\n   230\t\n   231\t1. Exactly one entity with `:yin.code/type :segment` per batch.\n   232\t2. Instruction pcs are exactly `0 .. length-1`, each once.\n   233\t3. The batch is sorted by pc (so a loader can fill the array in one pass).\n   234\t4. Every `:yin.code/target` and `:yin.code/body` resolves to an instruction\n   235\t   of the same segment.\n   236\t5. Every basic block ends in a terminator (`:jump`, `:return`, `:halt`) or\n   237\t   falls into a labelled successor; pc `length-1` is a terminator.\n   238\t6. Every `:call`/`:ffi-call` has a non-negative `:yin.code/argc`.\n   239\t\n115:  operation returns data: closed, full, blocked, end, gap, not found,\n148:position holds nothing yet. `append!`'s `:dao.stream/full` is the same\n272:  minted from a host connection accepted without an `attach!` call. An\n313:| `:dao.stream/transport-error` | The handler failed.                           | —                    |\n322:| `:dao.stream/transport-error`    | The handler failed.                                                                 | —                    |\n328:yet accept values. The handle reports that through its own operations, exactly\n422:— where the reading model applies in full. The log lives beside such a\n447:spans the eviction, and never as `full`); or the answer is displaced to another channel, named (a transport\n478:  whose medium is naturally addressable may accept additional\n487:  yields `:dao.stream/transport-error` for it; a transport whose medium\n491:  `:dao.stream/closed`, and `:dao.stream/transport-error`.\n518:  same logical stream accepts it, so a cursor handed to another interpreter\n524:  descriptors for the same logical stream accept the same cursor.\n546:| `:dao.stream/transport-error` | The transport failed to perform the read; nothing was observed.               | —                                                                                       |\n560:| `:dao.stream/ok`              | The value is accepted at the next position in the sequence this handle's writer surface is on. Implies neither local readability nor remote delivery. | —             |\n561:| `:dao.stream/full`            | The transport does not accept the value; nothing was appended. Whether this is transient or permanent is the transport's declared nature (see Retention and Gaps). | —             |\n564:| `:dao.stream/transport-error` | The transport failed to perform the append; nothing was appended.                                                                                    | —             |\n592:server-side accepted-connection handle is an attachment and does not gain\n632:Writing). A successfully appended value occupies exactly one definite position\n657:`full` on append, `gap` on read — and whether its `full` is transient or\n718:retained history it reports `transport-error`; it never silently substitutes a\n725:returns `full` on reaching it, without appending and without evicting: refusing\n729:`full`. Logically unbounded is not physically infinite, and the line runs\n732:`transport-error`, while fatal host or runtime exhaustion, from which the\n737:`transport-error` and excludes it like any other outcome.\n    46\t(defn resolve-var\n    47\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n    48\t\n    49\t   The registry is a value supplied by the composition, not a global.\"\n    50\t  [env store primitives registry name]\n    51\t  (if-let [pair (find env name)]\n    52\t    (val pair)\n    53\t    (if-let [pair (find store name)]\n    54\t      (val pair)\n    55\t      (if-let [pair (find primitives name)]\n    56\t        (val pair)\n    57\t        (if-let [resolved (when (namespace name)\n    58\t                            (module/resolve-module\n    59\t                              registry\n    60\t                              (symbol (str (namespace name)\n    61\t                                           \".\"\n    62\t                                           (clojure.core/name name)))))]\n    63\t          resolved\n    64\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n    65\t                {:symbol name}))))))\n   381\t(defn park-continuation\n   382\t  \"Add a parked continuation entry and halt the VM.\"\n   383\t  [state cont-fields]\n   384\t  (let [id-counter (or (:id-counter state) 0)\n   385\t        park-id (keyword (str \"parked-\" id-counter))\n   386\t        parked (merge {:type :parked-continuation, :id park-id} cont-fields)]\n   387\t    (-> state\n   388\t        (update :parked assoc park-id parked)\n   389\t        (assoc :value parked\n   390\t               :halted? true\n   391\t               :id-counter (inc id-counter))\n   392\t        (telemetry/emit-snapshot :park {:parked-id park-id}))))\n   393\t\n   394\t\n   395\t(defn resume-continuation\n   396\t  \"Restore state from a parked continuation.\"\n   397\t  [state parked-id resume-val restore-fn]\n   398\t  (if-let [parked (get-in state [:parked parked-id])]\n   399\t    (let [new-state (update state :parked dissoc parked-id)]\n   400\t      (-> (restore-fn new-state parked resume-val)\n   401\t          (telemetry/emit-snapshot :resume {:parked-id parked-id})))\n   402\t    (fail \"Cannot resume: parked continuation not found\"\n   403\t          {:parked-id parked-id})))\n   404\t\n   405\t\n   406\t(defn gensym\n   407\t  \"Generate a unique ID and return [id updated-state].\"\n   408\t  ([state] (gensym state \"id\"))\n   409\t  ([state prefix]\n   410\t   (let [id-counter (or (:id-counter state) 0)\n   411\t         id (gen-id prefix id-counter)]\n   412\t     [id (assoc state :id-counter (inc id-counter))])))\n   430\t(defn handle-effect\n   431\t  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n   432\t   park-entry-fns maps :stream/put and :stream/next to functions that build\n   433\t   wait entries.\n   434\t\n   435\t   A parked entry is stored as the builder left it plus, for a writer, the\n   436\t   `:datom` it retries: registers and resource ids only. Neither the live\n   437\t   stream handle nor a restore closure is attached — `check-wait-set`\n   438\t   resolves handles from the store at every poll, and the scheduler that pops\n   439\t   a woken entry dispatches restoration itself — so a blocked entry is pure\n   440\t   data and survives serialization.\"\n   441\t  [state effect {:keys [park-entry-fns], :as opts}]\n   442\t  (let [park-entry (get park-entry-fns (:effect effect))\n   443\t        result\n   444\t        (case (:effect effect)\n   445\t          :vm/store-put {:state (assoc state\n   446\t                                       :store (assoc (:store state)\n   447\t                                                     (:key effect)\n   448\t                                                     (:val effect))),\n   449\t                         :value (:val effect),\n   450\t                         :blocked? false}\n   451\t          :stream/make\n   452\t          (let [[id s'] (gensym state \"stream\")\n   453\t                [stream-ref new-state] (handle-make s' effect id)]\n   454\t            {:state new-state, :value stream-ref, :blocked? false})\n   455\t          :stream/cursor\n   456\t          (let [[id s'] (gensym state \"cursor\")\n   457\t                [cursor-ref new-state] (handle-cursor s' effect id)]\n   458\t            {:state new-state, :value cursor-ref, :blocked? false})\n   459\t          :stream/put\n   460\t          (let [result (handle-put state effect)]\n   461\t            (if (:park result)\n   462\t              (let [built-entry (when park-entry\n   463\t                                  (park-entry state effect result))\n   464\t                    built-entry (if (and built-entry (not (:datom built-entry)))\n   465\t                                  (assoc built-entry :datom (:val effect))\n   466\t                                  built-entry)]\n   467\t                (handle-stream-block result built-entry))\n   468\t              {:state (:state result),\n   469\t               :value (:value result),\n   470\t               :blocked? false}))\n   471\t          :stream/next\n   472\t          (let [result (handle-next state effect)]\n   473\t            (if (:park result)\n   474\t              (let [built-entry (when park-entry\n   475\t                                  (park-entry state effect result))]\n   476\t                (handle-stream-block result built-entry))\n   477\t              {:state (:state result),\n   478\t               :value (:value result),\n   479\t               :blocked? false}))\n   480\t          :stream/close\n   481\t          (let [close-result (handle-close state effect)]\n   482\t            {:state (:state close-result), :value nil, :blocked? false})\n   483\t          (let [[id s'] (gensym state \"effect\")\n   484\t                handler (module/get-effect-handler (:modules state)\n   485\t                                                   (:effect effect))]\n   486\t            (if handler\n   487\t              (handler s' effect (assoc opts :id id))\n   488\t              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n","exit_code":0,"status":"completed"}}
