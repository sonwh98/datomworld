{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '99,166p;189,218p;288,335p;512,638p'; nl -ba src/cljc/yin/vm/code.cljc | sed -n '70,147p'; nl -ba src/cljc/dao/space/query.cljc | sed -n '140,166p'\"","aggregated_output":"    99\t(defn- response-wait-entry\n   100\t  \"The polling wait entry for a sent call awaiting its correlated response:\n   101\t   the machine registers {segment pc env stack k} plus the call-out reader\n   102\t   fields, in the shape `ffi/call-response-wait-entry` gives the walker.\"\n   103\t  [seg pc env stack k call-id]\n   104\t  {:segment seg, :pc pc, :env env, :stack stack, :k k,\n   105\t   :call-id call-id,\n   106\t   :reason :next,\n   107\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   108\t   :stream-id vm/call-out-stream-key})\n   109\t\n   110\t\n   111\t(defn semantic-restore\n   112\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   113\t\n   114\t   Two entry shapes carry more than registers:\n   115\t\n   116\t   - A `:request-sent` entry is a writer whose retained FFI request has now\n   117\t     been appended. The call starts waiting for its correlated response,\n   118\t     exactly as an immediately-sent one does, so the entry is replaced by its\n   119\t     response reader and the machine stays blocked.\n   120\t   - A `:call-id` entry is a response reader. The woken value is a response\n   121\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\n   122\t     parked call leaves `:parked` rather than accumulating.\"\n   123\t  ([base entry] (semantic-restore base entry (:value entry)))\n   124\t  ([base entry val]\n   125\t   (if (:request-sent entry)\n   126\t     (assoc base\n   127\t            :wait-set (conj (vec (or (:wait-set base) []))\n   128\t                            (response-wait-entry (:segment entry)\n   129\t                                                 (:pc entry)\n   130\t                                                 (:env entry)\n   131\t                                                 (:stack entry)\n   132\t                                                 (:k entry)\n   133\t                                                 (:call-id entry)))\n   134\t            :control nil\n   135\t            :k nil\n   136\t            :value :yin/blocked\n   137\t            :blocked? true\n   138\t            :halted? false)\n   139\t     (let [call-id (:call-id entry)\n   140\t           base (if call-id (update base :parked dissoc call-id) base)\n   141\t           val (if call-id (ffi/call-result val call-id) val)]\n   142\t       (put-registers base\n   143\t                      (:segment entry)\n   144\t                      (:pc entry)\n   145\t                      val\n   146\t                      (:stack entry)\n   147\t                      (:env entry)\n   148\t                      (:k entry))))))\n   149\t\n   150\t\n   151\t(defn- call-park-entries\n   152\t  \"Wait-entry builders for an instruction whose effect may block. The\n   153\t   continuation of an effect is the machine state after the instruction:\n   154\t   {segment, pc+1, env, stack, k} plus the transport fields the engine\n   155\t   fills in (§3.5). `St` is the operand stack with the instruction's operands\n   156\t   already popped.\"\n   157\t  [seg pc E St K]\n   158\t  {:stream/put (fn [_state _effect result]\n   159\t                 {:segment seg, :pc (inc pc), :env E, :stack St, :k K,\n   160\t                  :reason :put,\n   161\t                  :stream-id (:stream-id result)})\n   162\t   :stream/next (fn [_state _effect result]\n   163\t                  {:segment seg, :pc (inc pc), :env E, :stack St, :k K,\n   164\t                   :reason :next,\n   165\t                   :cursor-ref (:cursor-ref result),\n   166\t                   :stream-id (:stream-id result)})})\n   189\t(defn- apply-call\n   190\t  \"The §4.2 call transition, with the arguments already isolated from the\n   191\t   operand stack. Returns `{:goto [seg pc val St E K vm image]}` to continue,\n   192\t   `{:stop vm}` when the call blocked, or throws for a non-function.\n   193\t\n   194\t   A tail call grows neither K nor St: the frame the caller would have pushed\n   195\t   is the frame its own caller gave it. A primitive that yields an effect\n   196\t   parks with the continuation after the call site.\"\n   197\t  [code seg pc val St E K vm tail? f args]\n   198\t  (cond\n   199\t    (= :closure (:type f))\n   200\t    (let [E' (merge (:env f) (zipmap (:params f) args))\n   201\t          frame {:type :return, :segment seg, :pc (inc pc), :env E,\n   202\t                 :stack-base (count St)}\n   203\t          seg' (:segment f)]\n   204\t      {:goto [seg' (:entry f) val St E' (if tail? K (conj K frame))\n   205\t              vm (get code seg')]})\n   206\t    (fn? f)\n   207\t    (let [result (apply f args)]\n   208\t      (if (module/effect? result)\n   209\t        (let [{:keys [state value blocked?]}\n   210\t              (engine/handle-effect\n   211\t                (put-registers vm seg pc val St E K)\n   212\t                result\n   213\t                {:park-entry-fns (call-park-entries seg pc E St K)})]\n   214\t          (if blocked?\n   215\t            {:stop (assoc state :control nil :k nil)}\n   216\t            {:goto [seg (inc pc) value St E K state (get code seg)]}))\n   217\t        {:goto [seg (inc pc) result St E K vm (get code seg)]}))\n   218\t    :else (throw (ex-info \"Cannot apply non-function\" {:fn f}))))\n   288\t              ;; :gensym — val ← fresh id; counter advances (9, :gensym)\n   289\t              9 (let [[id vm'] (engine/gensym vm (nth inst 1))]\n   290\t                  (recur seg (inc pc) id St E K vm' image\n   291\t                         (and fuel (dec fuel))))\n   292\t              ;; :store-get — val ← S[key] (10, :store-get)\n   293\t              10 (recur seg (inc pc) (get (:store vm) (nth inst 1))\n   294\t                        St E K vm image (and fuel (dec fuel)))\n   295\t              ;; :store-put — S[key] ← v; val ← v (11, :store-put)\n   296\t              11 (let [vm' (assoc vm :store (assoc (:store vm)\n   297\t                                                   (nth inst 1)\n   298\t                                                   (nth inst 2)))]\n   299\t                   (recur seg (inc pc) (nth inst 2) St E K vm' image\n   300\t                          (and fuel (dec fuel))))\n   301\t              ;; :current-continuation — val ← {seg, pc+1, E, St, K} (19)\n   302\t              19 (recur seg (inc pc)\n   303\t                        {:type :reified-continuation,\n   304\t                         :segment seg,\n   305\t                         :pc (inc pc),\n   306\t                         :env E,\n   307\t                         :stack St,\n   308\t                         :k K}\n   309\t                        St E K vm image (and fuel (dec fuel)))\n   310\t              ;; :park — write {segment pc+1 env stack k} and halt (17)\n   311\t              17 (-> (put-registers vm seg pc val St E K)\n   312\t                     (engine/park-continuation {:segment seg,\n   313\t                                                :pc (inc pc),\n   314\t                                                :env E,\n   315\t                                                :stack St,\n   316\t                                                :k K})\n   317\t                     (assoc :control nil :k nil))\n   318\t              ;; :resume — restore the parked configuration with val (18)\n   319\t              18 (let [vm' (engine/resume-continuation\n   320\t                             (put-registers vm seg pc val St E K)\n   321\t                             (nth inst 1)\n   322\t                             val\n   323\t                             (fn [base parked resume-val]\n   324\t                               (put-registers base\n   325\t                                              (:segment parked)\n   326\t                                              (:pc parked)\n   327\t                                              resume-val\n   328\t                                              (:stack parked)\n   329\t                                              (:env parked)\n   330\t                                              (:k parked))))\n   331\t                       control (:control vm')]\n   332\t                   (recur (:segment control) (:pc control) val\n   333\t                          (or (:stack vm') []) (:env vm') (or (:k vm') [])\n   334\t                          vm' (get (:code vm') (:segment control))\n   335\t                          (and fuel (dec fuel))))\n   512\t(defn- index-batch\n   513\t  \"Entity ids in order of first appearance, and each entity's attribute map.\n   514\t   A repeated single-valued attribute keeps its last value, as\n   515\t   `yin.vm.code` reads one.\"\n   516\t  [datoms]\n   517\t  (reduce (fn [[order attrs] [e a v]]\n   518\t            [(if (contains? attrs e) order (conj order e))\n   519\t             (assoc-in attrs [e a] v)])\n   520\t          [[] {}]\n   521\t          datoms))\n   522\t\n   523\t\n   524\t(defn load-image\n   525\t  \"Decode one `:yin.code/*` batch into an executable image.\n   526\t\n   527\t   Returns `{:segment id, :length n, :code instructions}` where `instructions`\n   528\t   is a vector indexed by pc of decoded `[opcode & operands]` vectors with\n   529\t   every `:yin.code/target` and `:yin.code/body` ref resolved to a pc integer\n   530\t   of the same segment. Throws a load error naming the entity and rule when\n   531\t   the batch is not well formed (§2.6); the loader is total over the outcomes\n   532\t   of its inputs and does not guess.\"\n   533\t  [datoms]\n   534\t  (let [defect (code/well-formed? datoms)]\n   535\t    (when defect\n   536\t      (throw (ex-info (str \"Cannot load segment: \" (name (:rule defect))\n   537\t                           \" (entity \" (:entity defect) \")\")\n   538\t                      {:defect defect})))\n   539\t    (let [[order attrs] (index-batch datoms)\n   540\t          segments (filterv #(= :segment (get-in attrs [% :yin.code/type]))\n   541\t                            order)\n   542\t          seg (first segments)\n   543\t          structural [:yin.code/segment :yin.code/pc :yin.code/op]\n   544\t          instructions (filterv (fn [e]\n   545\t                                  (and (not= seg e)\n   546\t                                       (some #(contains? (get attrs e) %)\n   547\t                                             structural)))\n   548\t                                order)\n   549\t          ;; Rule 3 sorts by pc, so an instruction's position is its pc.\n   550\t          pc-of (zipmap instructions (range))\n   551\t          resolve-ref (fn [e ref]\n   552\t                        (or (get pc-of ref)\n   553\t                            (throw (ex-info\n   554\t                                     \"Ref resolves to no instruction of this segment\"\n   555\t                                     {:entity e, :ref ref}))))\n   556\t          decode (fn [e]\n   557\t                   (let [ia (get attrs e)\n   558\t                         mnem (:yin.code/op ia)\n   559\t                         opcode (or (get vm/opcode-table\n   560\t                                         (get mnemonic-aliases mnem mnem))\n   561\t                                    (throw (ex-info \"Mnemonic has no opcode\"\n   562\t                                                    {:op mnem, :entity e})))]\n   563\t                     (case mnem\n   564\t                       :const [opcode (:yin.code/value ia)]\n   565\t                       :var [opcode (:yin.code/name ia)]\n   566\t                       :closure [opcode (:yin.code/params ia)\n   567\t                                 (resolve-ref e (:yin.code/body ia))]\n   568\t                       :call (if (:yin.code/tail? ia)\n   569\t                               [(:tailcall vm/opcode-table) (:yin.code/argc ia)]\n   570\t                               [opcode (:yin.code/argc ia)])\n   571\t                       :return [opcode]\n   572\t                       :jump [opcode (resolve-ref e (:yin.code/target ia))]\n   573\t                       :branch-false [opcode\n   574\t                                      (resolve-ref e (:yin.code/target ia))]\n   575\t                       :halt [opcode]\n   576\t                       :gensym [opcode (or (:yin.code/prefix ia) \"id\")]\n   577\t                       :store-get [opcode (:yin.code/key ia)]\n   578\t                       :store-put [opcode (:yin.code/key ia)\n   579\t                                   (:yin.code/value ia)]\n   580\t                       :stream-make [opcode (or (:yin.code/buffer ia)\n   581\t                                                vm/default-stream-capacity)]\n   582\t                       :stream-put [opcode]\n   583\t                       :stream-cursor [opcode]\n   584\t                       :stream-next [opcode]\n   585\t                       :stream-close [opcode]\n   586\t                       :park [opcode]\n   587\t                       :resume [opcode (:yin.code/parked-id ia)]\n   588\t                       :current-continuation [opcode]\n   589\t                       :ffi-call [opcode (:yin.code/ffi-op ia)\n   590\t                                  (or (:yin.code/argc ia) 0)]\n   591\t                       :push [opcode]\n   592\t                       (throw (ex-info \"Unknown mnemonic\"\n   593\t                                       {:op mnem, :entity e})))))]\n   594\t      {:segment seg,\n   595\t       :length (get-in attrs [seg :yin.code/length]),\n   596\t       :code (mapv decode instructions)})))\n   597\t\n   598\t\n   599\t(defn- store-image\n   600\t  \"Register one decoded image under its segment id, returning the code map.\n   601\t\n   602\t   Segment identity is stable: continuations, frames, and closures name\n   603\t   segments by id, so an id must never come to mean different code. An\n   604\t   identical reload — a batch re-sent, a batch run twice — decodes to the\n   605\t   same image and is accepted. A different image under a live id is a\n   606\t   conflict, and loading it fails rather than silently redirecting every\n   607\t   continuation that names the id.\"\n   608\t  [code image]\n   609\t  (let [seg (:segment image)]\n   610\t    (if-let [existing (find code seg)]\n   611\t      (if (= (val existing) image)\n   612\t        code\n   613\t        (throw (ex-info \"Cannot load segment: the id already holds different code\"\n   614\t                        {:segment seg})))\n   615\t      (assoc code seg image))))\n   616\t\n   617\t\n   618\t(defn vm-load-program\n   619\t  \"Load one `:yin.code/*` batch: validate it, decode it, store the image under\n   620\t   `:code {segment-id image}`, and set control to `{:segment id :pc 0}`.\n   621\t\n   622\t   This is the loader a composition hands to `dao.stream.observer/\n   623\t   run-on-stream` beside `engine/ready-for-ingress?` and the VM's runner; a\n   624\t   composition whose program stream carries `:yin/*` AST datoms composes the\n   625\t   Phase 2 linearizer in front of it. Parked continuations survive a load, so\n   626\t   one segment can resume another's. A segment id already holding different\n   627\t   code is a load error; loading the same image again is accepted.\"\n   628\t  [vm datoms]\n   629\t  (let [image (load-image datoms)]\n   630\t    (assoc vm\n   631\t           :program (:segment image)\n   632\t           :code (store-image (:code vm) image)\n   633\t           :control {:segment (:segment image), :pc 0}\n   634\t           :stack []\n   635\t           :k nil\n   636\t           :halted? false\n   637\t           :blocked? false\n   638\t           :value nil)))\n    70\t(defn- instruction-shape\n    71\t  \"§2.3: every instruction names this segment and carries a §2.4 op. The\n    72\t   later rules read both, so a batch that lacks them cannot be judged by them.\"\n    73\t  [{:keys [seg attrs instructions]}]\n    74\t  (some (fn [e]\n    75\t          (let [ia (get attrs e)]\n    76\t            (when-not (and (= seg (:yin.code/segment ia))\n    77\t                           (contains? mnemonics (:yin.code/op ia)))\n    78\t              (defect :instruction-shape e))))\n    79\t        instructions))\n    80\t\n    81\t\n    82\t(defn- dense-pcs\n    83\t  \"Rule 2. The first instruction whose pc is missing, out of range, or\n    84\t   already taken is named; a count short of the length names the segment.\"\n    85\t  [{:keys [seg attrs instructions]}]\n    86\t  (let [length (get-in attrs [seg :yin.code/length])]\n    87\t    (if-not (count? length)\n    88\t      (defect :dense-pcs seg)\n    89\t      (loop [es instructions\n    90\t             seen #{}]\n    91\t        (if-let [[e & more] (seq es)]\n    92\t          (let [pc (get-in attrs [e :yin.code/pc])]\n    93\t            (if (and (count? pc) (< pc length) (not (contains? seen pc)))\n    94\t              (recur more (conj seen pc))\n    95\t              (defect :dense-pcs e)))\n    96\t          (when-not (= length (count seen))\n    97\t            (defect :dense-pcs seg)))))))\n    98\t\n    99\t\n   100\t(defn- sorted-by-pc\n   101\t  \"Rule 3. The pcs are a permutation of 0 .. length-1 by rule 2, so the batch\n   102\t   is sorted exactly when each instruction's pc is its position among the\n   103\t   instructions.\"\n   104\t  [{:keys [attrs instructions]}]\n   105\t  (some (fn [[i e]]\n   106\t          (when-not (= i (get-in attrs [e :yin.code/pc]))\n   107\t            (defect :sorted-by-pc e)))\n   108\t        (map-indexed vector instructions)))\n   109\t\n   110\t\n   111\t(defn- dangling-target\n   112\t  \"Rule 4. A ref that is present must name an instruction of this batch, and\n   113\t   a `:jump`, `:branch-false`, or `:closure` without its ref resolves nowhere.\"\n   114\t  [{:keys [attrs instructions]}]\n   115\t  (let [instruction? (set instructions)]\n   116\t    (some (fn [e]\n   117\t            (let [ia (get attrs e)\n   118\t                  required (get required-ref (:yin.code/op ia))\n   119\t                  refs (cond-> (filterv #(contains? ia %) ref-attrs)\n   120\t                         required (conj required))]\n   121\t              (when-not (every? #(instruction? (get ia %)) refs)\n   122\t                (defect :dangling-target e))))\n   123\t          instructions)))\n   124\t\n   125\t\n   126\t(defn- missing-terminator\n   127\t  \"Rule 5. Blocks are delimited by labels (pc 0, targets, bodies) and by\n   128\t   terminators. A block that does not end in a terminator ends only because\n   129\t   its successor is labelled, which the rule allows, so the one instruction\n   130\t   that can violate it is the last: nothing labelled follows pc length-1. An\n   131\t   empty segment has no terminator at all and names the segment.\"\n   132\t  [{:keys [seg attrs instructions]}]\n   133\t  (if-let [e (peek instructions)]\n   134\t    (when-not (contains? terminators (get-in attrs [e :yin.code/op]))\n   135\t      (defect :missing-terminator e))\n   136\t    (defect :missing-terminator seg)))\n   137\t\n   138\t\n   139\t(defn- negative-argc\n   140\t  \"Rule 6.\"\n   141\t  [{:keys [attrs instructions]}]\n   142\t  (some (fn [e]\n   143\t          (let [ia (get attrs e)]\n   144\t            (when (and (contains? #{:call :ffi-call} (:yin.code/op ia))\n   145\t                       (not (count? (:yin.code/argc ia))))\n   146\t              (defect :negative-argc e))))\n   147\t        instructions))\n   140\t;; =============================================================================\n   141\t\n   142\t(defn value?\n   143\t  \"True for the query values q/match/pull take as database inputs: a\n   144\t   relation value, a datom view, or an opened published index. Raw vectors\n   145\t   and raw maps answer false.\"\n   146\t  [x]\n   147\t  (and (map? x)\n   148\t       (or (contains? x :dao.space.query/relation)\n   149\t           (contains? x :dao.space.query/view)\n   150\t           (contains? x :dao.space.query/published))))\n   151\t\n   152\t\n   153\t(defn relation\n   154\t  \"An in-memory relation value. Its retained contents are an arbitrary,\n   155\t   mixed-dimensional tuple collection; arity never selects an\n   156\t   interpretation. This is the replacement for the direct raw-vector input.\"\n   157\t  [tuples]\n   158\t  {:dao.space.query/relation (vec tuples)})\n   159\t\n   160\t\n   161\t(defn entity-map-relation\n   162\t  \"An entity-map relation value: a bounded relation of entity maps,\n   163\t   projected explicitly to [e a v] facts on the read side. The read side is\n   164\t   pure and never mints an entity id, so every map must carry :db/id.\"\n   165\t  [maps]\n   166\t  ;; Normalize at the explicit constructor boundary. The resulting value is\n","exit_code":0,"status":"completed"}}
