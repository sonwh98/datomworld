{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/vm/code.cljc'","aggregated_output":"     1\t(ns yin.vm.code\n     2\t  \"Well-formedness of linear executable datoms (`:yin.code/*`).\n     3\t\n     4\t   A segment is one batch: exactly one `:yin.code/type :segment` entity plus\n     5\t   its instruction entities, whose order is an explicit `:yin.code/pc` fact\n     6\t   (`docs/design/yin.vm.semantic.md` §2). This namespace judges the shape of a\n     7\t   batch and nothing else. Decoding it into an image and executing that image\n     8\t   belong to the semantic VM; the mnemonic-to-opcode mapping is the loader's\n     9\t   interpretation, not a fact checked here.\n    10\t\n    11\t   The same split holds one level up, for the canonical instruction vector of\n    12\t   UCF §7.3.2 (`docs/design/yin.vm.code-as-tuples.md` §7.5): the §7.5\n    13\t   validator lives here; decoding the vector into an image belongs to the\n    14\t   semantic VM.\"\n    15\t  (:require [dao.jing :as jing]\n    16\t            [yin.vm :as vm]))\n    17\t\n    18\t\n    19\t(def mnemonics\n    20\t  \"The instruction vocabulary of §2.4.\"\n    21\t  #{:const :var :closure :push :call :return :jump :branch-false :halt :gensym\n    22\t    :store-get :store-put :stream-make :stream-put :stream-cursor :stream-next\n    23\t    :stream-close :park :resume :current-continuation :ffi-call})\n    24\t\n    25\t\n    26\t(def terminators\n    27\t  \"Instructions after which control never reaches pc + 1.\"\n    28\t  #{:jump :return :halt})\n    29\t\n    30\t\n    31\t(def ^:private structural-attrs\n    32\t  #{:yin.code/segment :yin.code/pc :yin.code/op})\n    33\t\n    34\t\n    35\t(def ^:private ref-attrs\n    36\t  [:yin.code/target :yin.code/body])\n    37\t\n    38\t\n    39\t(def ^:private required-ref\n    40\t  {:jump :yin.code/target, :branch-false :yin.code/target, :closure :yin.code/body})\n    41\t\n    42\t\n    43\t(defn- count?\n    44\t  [x]\n    45\t  (and (integer? x) (not (neg? x))))\n    46\t\n    47\t\n    48\t(defn- defect\n    49\t  [rule entity]\n    50\t  {:rule rule, :entity entity})\n    51\t\n    52\t\n    53\t(defn- index-batch\n    54\t  \"Entity ids in order of first appearance, and each entity's attribute map.\n    55\t   A repeated single-valued attribute keeps its last value, as\n    56\t   `yin.vm/index-datoms` reads one.\"\n    57\t  [datoms]\n    58\t  (reduce (fn [[order attrs] [e a v]]\n    59\t            [(if (contains? attrs e) order (conj order e))\n    60\t             (assoc-in attrs [e a] v)])\n    61\t          [[] {}]\n    62\t          datoms))\n    63\t\n    64\t\n    65\t;; Each rule below takes the indexed batch and returns a defect or nil. Rules\n    66\t;; run in order and the first defect wins, so a rule may assume every earlier\n    67\t;; one held.\n    68\t\n    69\t(defn- one-segment\n    70\t  \"Rule 1. A batch with no segment entity names no entity; a batch with\n    71\t   several names the second.\"\n    72\t  [{:keys [segments]}]\n    73\t  (when-not (= 1 (count segments))\n    74\t    (defect :one-segment (second segments))))\n    75\t\n    76\t\n    77\t(defn- instruction-shape\n    78\t  \"§2.3: every instruction names this segment and carries a §2.4 op. The\n    79\t   later rules read both, so a batch that lacks them cannot be judged by them.\"\n    80\t  [{:keys [seg attrs instructions]}]\n    81\t  (some (fn [e]\n    82\t          (let [ia (get attrs e)]\n    83\t            (when-not (and (= seg (:yin.code/segment ia))\n    84\t                           (contains? mnemonics (:yin.code/op ia)))\n    85\t              (defect :instruction-shape e))))\n    86\t        instructions))\n    87\t\n    88\t\n    89\t(defn- dense-pcs\n    90\t  \"Rule 2. The first instruction whose pc is missing, out of range, or\n    91\t   already taken is named; a count short of the length names the segment.\"\n    92\t  [{:keys [seg attrs instructions]}]\n    93\t  (let [length (get-in attrs [seg :yin.code/length])]\n    94\t    (if-not (count? length)\n    95\t      (defect :dense-pcs seg)\n    96\t      (loop [es instructions\n    97\t             seen #{}]\n    98\t        (if-let [[e & more] (seq es)]\n    99\t          (let [pc (get-in attrs [e :yin.code/pc])]\n   100\t            (if (and (count? pc) (< pc length) (not (contains? seen pc)))\n   101\t              (recur more (conj seen pc))\n   102\t              (defect :dense-pcs e)))\n   103\t          (when-not (= length (count seen))\n   104\t            (defect :dense-pcs seg)))))))\n   105\t\n   106\t\n   107\t(defn- sorted-by-pc\n   108\t  \"Rule 3. The pcs are a permutation of 0 .. length-1 by rule 2, so the batch\n   109\t   is sorted exactly when each instruction's pc is its position among the\n   110\t   instructions.\"\n   111\t  [{:keys [attrs instructions]}]\n   112\t  (some (fn [[i e]]\n   113\t          (when-not (= i (get-in attrs [e :yin.code/pc]))\n   114\t            (defect :sorted-by-pc e)))\n   115\t        (map-indexed vector instructions)))\n   116\t\n   117\t\n   118\t(defn- dangling-target\n   119\t  \"Rule 4. A ref that is present must name an instruction of this batch, and\n   120\t   a `:jump`, `:branch-false`, or `:closure` without its ref resolves nowhere.\"\n   121\t  [{:keys [attrs instructions]}]\n   122\t  (let [instruction? (set instructions)]\n   123\t    (some (fn [e]\n   124\t            (let [ia (get attrs e)\n   125\t                  required (get required-ref (:yin.code/op ia))\n   126\t                  refs (cond-> (filterv #(contains? ia %) ref-attrs)\n   127\t                         required (conj required))]\n   128\t              (when-not (every? #(instruction? (get ia %)) refs)\n   129\t                (defect :dangling-target e))))\n   130\t          instructions)))\n   131\t\n   132\t\n   133\t(defn- missing-terminator\n   134\t  \"Rule 5. Blocks are delimited by labels (pc 0, targets, bodies) and by\n   135\t   terminators. A block that does not end in a terminator ends only because\n   136\t   its successor is labelled, which the rule allows, so the one instruction\n   137\t   that can violate it is the last: nothing labelled follows pc length-1. An\n   138\t   empty segment has no terminator at all and names the segment.\"\n   139\t  [{:keys [seg attrs instructions]}]\n   140\t  (if-let [e (peek instructions)]\n   141\t    (when-not (contains? terminators (get-in attrs [e :yin.code/op]))\n   142\t      (defect :missing-terminator e))\n   143\t    (defect :missing-terminator seg)))\n   144\t\n   145\t\n   146\t(defn- negative-argc\n   147\t  \"Rule 6.\"\n   148\t  [{:keys [attrs instructions]}]\n   149\t  (some (fn [e]\n   150\t          (let [ia (get attrs e)]\n   151\t            (when (and (contains? #{:call :ffi-call} (:yin.code/op ia))\n   152\t                       (not (count? (:yin.code/argc ia))))\n   153\t              (defect :negative-argc e))))\n   154\t        instructions))\n   155\t\n   156\t\n   157\t(def ^:private rules\n   158\t  [one-segment instruction-shape dense-pcs sorted-by-pc dangling-target\n   159\t   missing-terminator negative-argc])\n   160\t\n   161\t\n   162\t(defn well-formed?\n   163\t  \"Check one segment batch of `[e a v t m]` datoms against §2.6.\n   164\t\n   165\t   Returns nil when the batch is well formed, else the first defect as\n   166\t   `{:rule r :entity e}`, where r is one of `:one-segment`,\n   167\t   `:instruction-shape`, `:dense-pcs`, `:sorted-by-pc`, `:dangling-target`,\n   168\t   `:missing-terminator`, `:negative-argc`, and e is the offending entity\n   169\t   (nil when the defect is an absent segment).\n   170\t\n   171\t   An instruction is any non-segment entity carrying `:yin.code/segment`,\n   172\t   `:yin.code/pc`, or `:yin.code/op`; entities with none of them are not\n   173\t   judged.\"\n   174\t  [datoms]\n   175\t  (let [[order attrs] (index-batch datoms)\n   176\t        segments (filterv #(= :segment (get-in attrs [% :yin.code/type])) order)\n   177\t        segment? (set segments)\n   178\t        instructions (filterv (fn [e]\n   179\t                                (and (not (segment? e))\n   180\t                                     (some #(contains? (get attrs e) %)\n   181\t                                           structural-attrs)))\n   182\t                              order)\n   183\t        batch {:attrs attrs,\n   184\t               :segments segments,\n   185\t               :seg (first segments),\n   186\t               :instructions instructions}]\n   187\t    (some #(% batch) rules)))\n   188\t\n   189\t\n   190\t;; =============================================================================\n   191\t;; The canonical instruction vector (UCF §7.3.2, §7.5)\n   192\t;; =============================================================================\n   193\t\n   194\t(def vector-operand-table\n   195\t  \"§2.4's operand table in UCF §7.3.2's positional form: mnemonic → ordered\n   196\t   `[attribute kind]` operands. Position `i` of a canonical tuple (from 1)\n   197\t   holds the operand entry `i-1` names; this one table drives the §7.5\n   198\t   validator's rules. Each kind names the\n   199\t   rule that judges it: `:data`, `:sym`, `:syms`, `:kw`, `:str`, `:bool`,\n   200\t   and `:buffer` belong to `:operand-kind` (a nil passes it and is\n   201\t   `:saturation`'s defect); `:pc` to `:target-bounds`; `:uint` to `:argc`.\"\n   202\t  {:const [[:yin.code/value :data]],\n   203\t   :var [[:yin.code/name :sym]],\n   204\t   :closure [[:yin.code/params :syms] [:yin.code/body :pc]],\n   205\t   :push [],\n   206\t   :call [[:yin.code/argc :uint] [:yin.code/tail? :bool]],\n   207\t   :return [],\n   208\t   :jump [[:yin.code/target :pc]],\n   209\t   :branch-false [[:yin.code/target :pc]],\n   210\t   :halt [],\n   211\t   :gensym [[:yin.code/prefix :str]],\n   212\t   :store-get [[:yin.code/key :data]],\n   213\t   :store-put [[:yin.code/key :data] [:yin.code/value :data]],\n   214\t   :stream-make [[:yin.code/buffer :buffer]],\n   215\t   :stream-put [],\n   216\t   :stream-cursor [],\n   217\t   :stream-next [],\n   218\t   :stream-close [],\n   219\t   :park [],\n   220\t   :resume [[:yin.code/parked-id :kw]],\n   221\t   :current-continuation [],\n   222\t   :ffi-call [[:yin.code/ffi-op :kw] [:yin.code/argc :uint]]})\n   223\t\n   224\t\n   225\t(def ^:private operand-kind-checks\n   226\t  \"§7.5 :operand-kind — kind → predicate. Absent kinds (`:pc`, `:uint`) are\n   227\t   not judged by the rule: `:target-bounds` and `:argc` own them. A nil in\n   228\t   a saturated slot passes here; `:saturation` owns it, the §7.4 `:slot-kind`\n   229\t   precedent.\"\n   230\t  {:data vm/plain-data?,\n   231\t   :sym symbol?,\n   232\t   :syms (fn [x] (and (vector? x) (every? symbol? x))),\n   233\t   :kw keyword?,\n   234\t   :str (fn [x] (or (nil? x) (string? x))),\n   235\t   :bool (fn [x] (or (nil? x) (boolean? x))),\n   236\t   :buffer (fn [x] (or (nil? x) (count? x)))})\n   237\t\n   238\t\n   239\t(def ^:private saturated-operands\n   240\t  \"§7.5 :saturation — the `[mnemonic index]` operands a canonical tuple\n   241\t   materializes (UCF §7.3.2); a nil in one of them is that rule's defect.\"\n   242\t  #{[:gensym 1] [:stream-make 1] [:call 2] [:ffi-call 2]})\n   243\t\n   244\t\n   245\t(defn- tuple-defect\n   246\t  [rule pc]\n   247\t  {:rule rule, :pc pc})\n   248\t\n   249\t\n   250\t(defn- mnemonic-of\n   251\t  \"The mnemonic of one tuple, or nil when the element has no first element\n   252\t   that could be one. A tuple is a vector — UCF §7.3.2's positional form —\n   253\t   so a list element has no mnemonic.\"\n   254\t  [t]\n   255\t  (when (and (vector? t) (seq t))\n   256\t    (nth t 0)))\n   257\t\n   258\t\n   259\t(defn- tuple-kinds\n   260\t  \"The operand kinds of one tuple's mnemonic, in tuple order.\"\n   261\t  [t]\n   262\t  (mapv second (get vector-operand-table (nth t 0))))\n   263\t\n   264\t\n   265\t;; Each rule below takes the whole vector and returns a defect or nil. Rules\n   266\t;; run in §7.5's order and the first defect wins, so a rule may assume every\n   267\t;; earlier one held — exactly as `rules` above runs over a batch.\n   268\t\n   269\t(defn- nonempty\n   270\t  \"Rule 1. An empty vector names pc 0, where the first instruction belongs;\n   271\t   so does anything a pc cannot index: the canonical form is a vector\n   272\t   (UCF §7.3.2), so a list outer is not the form at any length.\"\n   273\t  [v]\n   274\t  (when-not (and (vector? v) (pos? (count v)))\n   275\t    (tuple-defect :nonempty 0)))\n   276\t\n   277\t\n   278\t(defn- mnemonic\n   279\t  \"Rule 2.\"\n   280\t  [v]\n   281\t  (some (fn [pc]\n   282\t          (when-not (contains? mnemonics (mnemonic-of (nth v pc)))\n   283\t            (tuple-defect :mnemonic pc)))\n   284\t        (range (count v))))\n   285\t\n   286\t\n   287\t(defn- arity\n   288\t  \"Rule 3. §2.4's operand table as saturated and made positional by UCF\n   289\t   §7.3.2: the mnemonic plus exactly its operands.\"\n   290\t  [v]\n   291\t  (some (fn [pc]\n   292\t          (let [t (nth v pc)]\n   293\t            (when-not (= (inc (count (get vector-operand-table (nth t 0))))\n   294\t                         (count t))\n   295\t              (tuple-defect :arity pc))))\n   296\t        (range (count v))))\n   297\t\n   298\t\n   299\t(defn- operand-kind\n   300\t  \"Rule 4. An operand is judged only by the kind §7.5 gives it.\"\n   301\t  [v]\n   302\t  (some (fn [pc]\n   303\t          (let [t (nth v pc)\n   304\t                kinds (tuple-kinds t)]\n   305\t            (some (fn [i]\n   306\t                    (let [check (get operand-kind-checks (nth kinds (dec i)))]\n   307\t                      (when (and check (not (check (nth t i))))\n   308\t                        (tuple-defect :operand-kind pc))))\n   309\t                  (range 1 (count t)))))\n   310\t        (range (count v))))\n   311\t\n   312\t\n   313\t(defn- saturation\n   314\t  \"Rule 5. A saturated operand is materialized in a canonical tuple; a nil\n   315\t   one names its pc.\"\n   316\t  [v]\n   317\t  (some (fn [pc]\n   318\t          (let [t (nth v pc)]\n   319\t            (when (some #(and (contains? saturated-operands [(nth t 0) %])\n   320\t                              (nil? (nth t %)))\n   321\t                        (range 1 (count t)))\n   322\t              (tuple-defect :saturation pc))))\n   323\t        (range (count v))))\n   324\t\n   325\t\n   326\t(defn- target-bounds\n   327\t  \"Rule 6. A resolved pc must be an integer inside the segment.\"\n   328\t  [v]\n   329\t  (let [length (count v)]\n   330\t    (some (fn [pc]\n   331\t            (let [t (nth v pc)\n   332\t                  kinds (tuple-kinds t)]\n   333\t              (some (fn [i]\n   334\t                      (when (= :pc (nth kinds (dec i)))\n   335\t                        (let [x (nth t i)]\n   336\t                          (when-not (and (integer? x) (<= 0 x (dec length)))\n   337\t                            (tuple-defect :target-bounds pc)))))\n   338\t                    (range 1 (count t)))))\n   339\t          (range (count v)))))\n   340\t\n   341\t\n   342\t(defn- terminator\n   343\t  \"Rule 7. Nothing labelled follows pc length-1, so the one instruction\n   344\t   that can violate the rule is the last.\"\n   345\t  [v]\n   346\t  (let [pc (dec (count v))]\n   347\t    (when-not (contains? terminators (mnemonic-of (nth v pc)))\n   348\t      (tuple-defect :terminator pc))))\n   349\t\n   350\t\n   351\t(defn- argc\n   352\t  \"Rule 8. The :uint operands of `:call` and `:ffi-call`.\"\n   353\t  [v]\n   354\t  (some (fn [pc]\n   355\t          (let [t (nth v pc)\n   356\t                kinds (tuple-kinds t)]\n   357\t            (some (fn [i]\n   358\t                    (when (= :uint (nth kinds (dec i)))\n   359\t                      (when-not (count? (nth t i))\n   360\t                        (tuple-defect :argc pc))))\n   361\t                  (range 1 (count t)))))\n   362\t        (range (count v))))\n   363\t\n   364\t\n   365\t(def ^:private vector-rules\n   366\t  [nonempty mnemonic arity operand-kind saturation target-bounds terminator\n   367\t   argc])\n   368\t\n   369\t\n   370\t(defn well-formed-vector?\n   371\t  \"Check one canonical instruction vector (UCF §7.3.2) against §7.5\n   372\t   (`docs/design/yin.vm.code-as-tuples.md`).\n   373\t\n   374\t   Returns nil when the vector is well formed, else the first defect as\n   375\t   `{:rule r :pc p}` — `:nonempty`, `:mnemonic`, `:arity`,\n   376\t   `:operand-kind`, `:saturation`, `:target-bounds`, `:terminator`, or\n   377\t   `:argc` — with p the offending pc (`:nonempty` names pc 0, where the\n   378\t   missing first instruction belongs). Rules run in §7.5's order, each\n   379\t   assuming the earlier ones held. §2.6 rules 1–4 are satisfied by the\n   380\t   vector form by construction (pc is the index); rules 5–6 and the UCF\n   381\t   §7.3.4 checks are the eight here. The address check — a vector hashing\n   382\t   to the address it claims — is not a structural rule and is not made\n   383\t   here: a correct hash is never structural validation.\"\n   384\t  [v]\n   385\t  (some #(% v) vector-rules))\n   386\t\n   387\t\n   388\t;; =============================================================================\n   389\t;; Segment rows (§6.2)\n   390\t;; =============================================================================\n   391\t\n   392\t(defn project-segment\n   393\t  \"§6.2 (`docs/design/yin.vm.code-as-tuples.md`): the canonical instruction\n   394\t   vector with pc prepended — one `[pc tag & ops]` row per instruction, the\n   395\t   tag being the mnemonic. The relation is per segment: pcs collide across\n   396\t   segments, and source scope belongs to the interpreter, never to a tuple\n   397\t   slot, so bare-pc rows from different segments are never unioned into one\n   398\t   relation. A query over several segments takes them as separate sources\n   399\t   or uses the segment-qualified form (`project-segment-qualified`).\"\n   400\t  [v]\n   401\t  (mapv (fn [pc t] (into [pc] t)) (range) v))\n   402\t\n   403\t\n   404\t(defn project-segment-qualified\n   405\t  \"§6.2's segment-qualified form `[segment-address pc tag & ops]`: one\n   406\t   address column prepended, so every tag's arity gains one uniformly and\n   407\t   per-tag arity stays fixed. The address is the vector's own\n   408\t   `(jing/segment-key v)` — the §7.1/UCF §7.3.2 rule the loaders already\n   409\t   follow — computed here rather than claimed by a caller, so a segment's\n   410\t   rows are named by the content they are projected from.\"\n   411\t  [v]\n   412\t  (let [addr (jing/segment-key v)]\n   413\t    (mapv (fn [r] (into [addr] r)) (project-segment v))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/vm/engine.cljc'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/vm/engine.cljc'","aggregated_output":"     1\t(ns yin.vm.engine\n     2\t  \"Shared evaluation machinery for Yin VMs on DaoStream v2.\n     3\t\n     4\t   What the port changed, and why:\n     5\t\n     6\t   - **The host supplies streams.** `:stream/make` calls the composition's\n     7\t     `:make-stream`; there is no transport identity in this namespace. Every\n     8\t     other stream handler is a protocol call on a handle already in the store.\n     9\t   - **Cursors are opaque.** A store cursor entry is\n    10\t     `{:stream-id id :cursor <opaque>}`. Nothing increments one.\n    11\t   - **Outcomes are maps, and every handler is total over its closed set.**\n    12\t     `blocked` and `full` park; `end` and `gap` are values the program sees;\n    13\t     the rest are errors that name their outcome.\n    14\t   - **Waiters are gone.** No v2 transport is waitable, so the polling wait\n    15\t     set is the mechanism rather than a fallback. A poll is a synchronous\n    16\t     `next` or `append!` on the handle in the store; no scheduler runtime\n    17\t     sits between the VM and its streams. Cadence comes from the driver\n    18\t     above the VM.\n    19\t   - **`:stream/take` is gone.** Destructive read needs a reader position in\n    20\t     the medium, which the contract retired.\n    21\t   - **The module registry is a value** carried in VM state, so effect\n    22\t     dispatch and `resolve-var` read a supplied registry rather than a global.\n    23\t   - **Program observation is not engine work.** `ready-for-ingress?` lives\n    24\t     here because it speaks the scheduler's own vocabulary, but the program\n    25\t     handle, cursor, and gap count belong to `dao.stream.observer`;\n    26\t     nothing in this namespace polls a program stream.\"\n    27\t  (:refer-clojure :exclude [gensym])\n    28\t  (:require [clojure.set]\n    29\t            [dao.stream :as stream]\n    30\t            [dao.stream.waitset :as waitset]\n    31\t            [yin.vm :as vm]\n    32\t            [yin.vm.module :as module]\n    33\t            [yin.vm.telemetry :as telemetry]))\n    34\t\n    35\t\n    36\t(defn- outcome\n    37\t  [result]\n    38\t  (:dao.stream/outcome result))\n    39\t\n    40\t\n    41\t(defn- fail\n    42\t  [message data]\n    43\t  (throw (ex-info message data)))\n    44\t\n    45\t\n    46\t(defn bind-params\n    47\t  \"Zips params with args, nil-filling any params beyond args' length.\n    48\t   Extra args beyond params' length are dropped. §7.7.2: an under-arity\n    49\t   call leaves missing parameter names bound to nil, not absent.\"\n    50\t  [params args]\n    51\t  (into {} (map vector params (concat args (repeat nil)))))\n    52\t\n    53\t\n    54\t(defn resolve-var\n    55\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n    56\t\n    57\t   The registry is a value supplied by the composition, not a global.\"\n    58\t  [env store primitives registry name]\n    59\t  (if-let [pair (find env name)]\n    60\t    (val pair)\n    61\t    (if-let [pair (find store name)]\n    62\t      (val pair)\n    63\t      (if-let [pair (find primitives name)]\n    64\t        (vm/primitive-function (val pair))\n    65\t        (if-let [resolved (when (namespace name)\n    66\t                            (module/resolve-module\n    67\t                              registry\n    68\t                              (symbol (str (namespace name)\n    69\t                                           \".\"\n    70\t                                           (clojure.core/name name)))))]\n    71\t          resolved\n    72\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n    73\t                {:symbol name}))))))\n    74\t\n    75\t\n    76\t(defn- gen-id\n    77\t  \"Generate a unique keyword ID from a prefix and counter value.\"\n    78\t  [prefix id-counter]\n    79\t  (keyword (str prefix \"-\" id-counter)))\n    80\t\n    81\t\n    82\t(defn vm-blocked?\n    83\t  \"Returns true if the VM is blocked.\"\n    84\t  [vm]\n    85\t  (boolean (:blocked? vm)))\n    86\t\n    87\t\n    88\t(defn vm-value\n    89\t  \"Returns the current value of the VM.\"\n    90\t  [vm]\n    91\t  (:value vm))\n    92\t\n    93\t\n    94\t(defn halted-with-empty-queue?\n    95\t  \"Returns true if the VM has halted and its ready-queue is empty.\"\n    96\t  [vm]\n    97\t  (and (boolean (:halted? vm)) (empty? (or (:ready-queue vm) []))))\n    98\t\n    99\t\n   100\t(defn restore-initial-env\n   101\t  \"After eval, restore :env to initial-env when the computation halted.\n   102\t   Blocked and parked states keep the active lexical env for resumption.\"\n   103\t  [initial-env result]\n   104\t  (if (halted-with-empty-queue? result) (assoc result :env initial-env) result))\n   105\t\n   106\t\n   107\t(defn active-continuation?\n   108\t  \"Returns true when the currently active continuation should keep stepping.\"\n   109\t  [vm]\n   110\t  (and (not (:blocked? vm)) (not (:halted? vm))))\n   111\t\n   112\t\n   113\t(defn ready-for-ingress?\n   114\t  \"Returns true when the VM is between evaluations and can accept another\n   115\t   program batch: not blocked, nothing scheduled or waiting, no active\n   116\t   continuation, and no loaded work.\n   117\t\n   118\t   This predicate gates observer coordination above the VM. The VM itself\n   119\t   never polls a program stream: `step` and `run` execute loaded work only.\"\n   120\t  [vm]\n   121\t  (let [has-bytecode? (contains? vm :bytecode)\n   122\t        bytecode (:bytecode vm)\n   123\t        no-bytecode? (and has-bytecode?\n   124\t                          (or (nil? bytecode)\n   125\t                              (and (sequential? bytecode) (empty? bytecode))))]\n   126\t    (and (not (:blocked? vm))\n   127\t         (empty? (or (:ready-queue vm) []))\n   128\t         (empty? (or (:wait-set vm) []))\n   129\t         (nil? (:k vm))\n   130\t         (or (:halted? vm) (nil? (:control vm)) no-bytecode?))))\n   131\t\n   132\t\n   133\t(defn make-woken-run-queue-entries\n   134\t  \"Transform woken wait-set entries into ready-queue entries.\n   135\t   Readers (with :cursor-ref) store the successor cursor the transport\n   136\t   returned. Writers (no :cursor-ref) just stamp :value. Each woken\n   137\t   result's :status rides onto the ready entry, where\n   138\t   terminal-resume-outcome reads it.\n   139\t\n   140\t   The ready entry stays pure data: any `:stream` handle a poll resolved\n   141\t   is dropped — the store-updates carry the successor cursor, and handles\n   142\t   are re-resolved from ids when needed again — so an entry neither waits\n   143\t   nor runs holding a host object.\"\n   144\t  [state woken]\n   145\t  (mapv (fn [{:keys [entry value cursor status], :as woken-entry}]\n   146\t          (let [cursor-ref (:cursor-ref entry)\n   147\t                store-updates\n   148\t                (or (:store-updates woken-entry)\n   149\t                    (when (and cursor-ref cursor)\n   150\t                      (let [cursor-id (:id cursor-ref)\n   151\t                            cursor-data (get (:store state) cursor-id)]\n   152\t                        {cursor-id (assoc cursor-data :cursor cursor)})))]\n   153\t            (dissoc (assoc entry\n   154\t                           :value value\n   155\t                           :store-updates store-updates\n   156\t                           :status status\n   157\t                           :cursor cursor)\n   158\t                    :stream)))\n   159\t        woken))\n   160\t\n   161\t\n   162\t(defn handle-make\n   163\t  \"Handle :stream/make. Creates a stream through the composition's\n   164\t   `:make-stream` and stores the handle.\n   165\t\n   166\t   A nil capacity has no v2 meaning, so the module path defaults exactly as\n   167\t   the AST path does. Absent a supplied constructor this fails and says so;\n   168\t   silently falling back to a private transport is the failure mode the rule\n   169\t   exists to prevent.\n   170\t   Returns [stream-ref updated-state].\"\n   171\t  [state effect id]\n   172\t  (let [capacity (or (:capacity effect) vm/default-stream-capacity)\n   173\t        handle (vm/create-stream! (:make-stream state) capacity :stream/make)\n   174\t        new-store (assoc (:store state) id handle)\n   175\t        stream-ref {:type :stream-ref, :id id}]\n   176\t    [stream-ref (assoc state :store new-store)]))\n   177\t\n   178\t\n   179\t(defn handle-put\n   180\t  \"Handle :stream/put. Total over the five append outcomes.\n   181\t   Returns {:value v :state s} on success, {:park true :stream-id id :state s}\n   182\t   on `full`. `closed`, `invalid-value` and `transport-error` are errors that\n   183\t   name their outcome, as v1's throw on a closed stream did.\"\n   184\t  [state effect]\n   185\t  (let [stream-ref (:stream effect)\n   186\t        val (:val effect)\n   187\t        stream-id (:id stream-ref)\n   188\t        handle (get (:store state) stream-id)]\n   189\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   190\t    (let [result (stream/append! handle val)\n   191\t          o (outcome result)]\n   192\t      (case o\n   193\t        :dao.stream/ok {:value val, :state state}\n   194\t        :dao.stream/full {:park true, :stream-id stream-id, :state state}\n   195\t        (fail \"Stream append failed\" {:outcome o, :stream-id stream-id})))))\n   196\t\n   197\t\n   198\t(defn handle-cursor\n   199\t  \"Handle :stream/cursor. Mints an opaque cursor at `:dao.stream/oldest`.\n   200\t\n   201\t   v1 fabricated `{:position 0}` and touched no stream. Minting is a stream\n   202\t   operation, so `closed` and `transport-error` arrive here.\n   203\t   Returns [cursor-ref updated-state].\"\n   204\t  [state effect id]\n   205\t  (let [stream-ref (:stream effect)\n   206\t        stream-id (:id stream-ref)\n   207\t        handle (get (:store state) stream-id)]\n   208\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   209\t    (let [cursor (vm/mint-oldest handle :stream/cursor)\n   210\t          cursor-data (vm/cursor-entry stream-id cursor)\n   211\t          new-store (assoc (:store state) id cursor-data)\n   212\t          cursor-ref {:type :cursor-ref, :id id}]\n   213\t      [cursor-ref (assoc state :store new-store)])))\n   214\t\n   215\t\n   216\t(defn handle-next\n   217\t  \"Handle :stream/next. Total over the seven read outcomes.\n   218\t\n   219\t   `ok` advances the store cursor to the exact returned successor. `blocked`\n   220\t   parks. `end` yields nil, as v1 did. `gap` advances to the recovery cursor\n   221\t   and yields `:dao.stream/gap`, so a program that reads it learns values were\n   222\t   lost. The three terminal outcomes are errors.\"\n   223\t  [state effect]\n   224\t  (let [cursor-ref (:cursor effect)\n   225\t        cursor-id (:id cursor-ref)\n   226\t        store (:store state)\n   227\t        cursor-data (get store cursor-id)]\n   228\t    (when (nil? cursor-data) (fail \"Invalid cursor reference\" {:ref cursor-ref}))\n   229\t    (let [stream-id (:stream-id cursor-data)\n   230\t          handle (get store stream-id)]\n   231\t      (when (nil? handle)\n   232\t        (fail \"Stream not found for cursor\" {:stream-id stream-id}))\n   233\t      (let [result (stream/next handle (:cursor cursor-data))\n   234\t            o (outcome result)\n   235\t            advance (fn [state* value]\n   236\t                      {:value value,\n   237\t                       :state (assoc state*\n   238\t                                     :store\n   239\t                                     (assoc store\n   240\t                                            cursor-id\n   241\t                                            (assoc cursor-data\n   242\t                                                   :cursor\n   243\t                                                   (:dao.stream/cursor\n   244\t                                                     result))))})]\n   245\t        (case o\n   246\t          :dao.stream/ok (advance state (:dao.stream/value result))\n   247\t          :dao.stream/blocked {:park true,\n   248\t                               :cursor-ref cursor-ref,\n   249\t                               :stream-id stream-id,\n   250\t                               :state state}\n   251\t          :dao.stream/end {:value nil, :state state}\n   252\t          :dao.stream/gap (advance state :dao.stream/gap)\n   253\t          (fail \"Stream read failed\"\n   254\t                {:outcome o, :stream-id stream-id, :cursor-id cursor-id}))))))\n   255\t\n   256\t\n   257\t(defn handle-close\n   258\t  \"Handle :stream/close. `close!` is total over {ok} and wakes nothing: a\n   259\t   reader parked on this stream learns of the close from its own next `next`.\n   260\t   Returns {:state s'}.\"\n   261\t  [state effect]\n   262\t  (let [stream-ref (:stream effect)\n   263\t        stream-id (:id stream-ref)\n   264\t        handle (get (:store state) stream-id)]\n   265\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   266\t    (stream/close! handle)\n   267\t    {:state state}))\n   268\t\n   269\t\n   270\t(def ^:private waitset-resolver\n   271\t  \"The engine's composition for `dao.stream.waitset/check`: the whole\n   272\t   resolver contract in one value, both functions synchronous and pure over\n   273\t   the immutable store. Neither touches a transport — the library polls,\n   274\t   the engine maps.\n   275\t\n   276\t   `:resolve` is the sweep's old resolution step nearly verbatim: it maps one\n   277\t   whole parked entry to its live handle plus the cursor to read from — or\n   278\t   the value to append — out of the VM's `:store`. The cursor is\n   279\t   re-resolved on every round even when an earlier round baked a value into\n   280\t   the entry: another waiter on the same cursor-ref may have advanced the\n   281\t   stored cursor since. `:advance` is the sweep's old write-back: it\n   282\t   commits a woken reader's successor — or recovery — cursor to the store\n   283\t   before later entries resolve, so a shared cursor-ref advances within the\n   284\t   round.\"\n   285\t  {:resolve (fn [store entry]\n   286\t              (if-let [cursor-ref (:cursor-ref entry)]\n   287\t                (let [cursor-data (get store (:id cursor-ref))]\n   288\t                  {:stream (or (:stream entry)\n   289\t                               (get store (:stream-id cursor-data)))\n   290\t                   :cursor (:cursor cursor-data)})\n   291\t                {:stream (or (:stream entry) (get store (:stream-id entry)))\n   292\t                 :value (:datom entry)}))\n   293\t   :advance (fn [store entry cursor]\n   294\t              (let [cursor-id (:id (:cursor-ref entry))]\n   295\t                (if cursor-id\n   296\t                  (assoc store\n   297\t                         cursor-id\n   298\t                         (assoc (get store cursor-id) :cursor cursor))\n   299\t                  store)))})\n   300\t\n   301\t\n   302\t(defn check-wait-set\n   303\t  \"Check wait-set entries against their transports.\n   304\t\n   305\t   The sweep is `dao.stream.waitset/check` — this engine was that library's\n   306\t   seed and is now its first consumer. Every entry is resolved to a live\n   307\t   handle and an opaque cursor out of the store by `waitset-resolver` and\n   308\t   polled with a synchronous `next` or `append!` — resolution happens per\n   309\t   poll, so the stored entry itself never carries a handle. There is no\n   310\t   transport-local waking to fall back from: this is the only mechanism.\n   311\t\n   312\t   Entries are polled one at a time in wait-set order, and a woken reader's\n   313\t   successor cursor is written back to the store before the next entry is\n   314\t   resolved. Waiters sharing a cursor-ref therefore read distinct values —\n   315\t   the value at the cursor wakes the first, its successor wakes the next —\n   316\t   instead of every waiter reading the value at the shared pre-poll\n   317\t   cursor. An entry that stays waiting is retained in its stored,\n   318\t   resource-id form.\n   319\t\n   320\t   Each woken result's `:status` is stamped onto its ready entry, where\n   321\t   `terminal-resume-outcome` reads it: an outcome the immediate operation\n   322\t   raises as an error fails the same way when the resume pops it — and a\n   323\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n   324\t   there too, before any continuation is restored.\"\n   325\t  [state]\n   326\t  (let [wait-set (:wait-set state)]\n   327\t    (if (empty? wait-set)\n   328\t      state\n   329\t      (let [{:keys [woken store], :as result}\n   330\t            (waitset/check {:waiting wait-set} waitset-resolver (:store state))\n   331\t            v (assoc state\n   332\t                     :store store\n   333\t                     :wait-set (:waiting (:waitset result)))]\n   334\t        (update v\n   335\t                :ready-queue (fnil into [])\n   336\t                (make-woken-run-queue-entries v woken))))))\n   337\t\n   338\t\n   339\t(declare handle-effect resume-continuation)\n   340\t\n   341\t\n   342\t(defn run-loop\n   343\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n   344\t   `resume-fn` pops and restores them.\"\n   345\t  [state active? step-fn resume-fn]\n   346\t  (loop [v state]\n   347\t    (let [q (or (:ready-queue v) [])]\n   348\t      (cond (active? v) (recur (step-fn v))\n   349\t            (:blocked? v) (let [v' (check-wait-set v)]\n   350\t                            (if-let [resumed (resume-fn v')]\n   351\t                              (recur resumed)\n   352\t                              (telemetry/emit-snapshot v' :blocked)))\n   353\t            (seq q) (if-let [resumed (resume-fn v)]\n   354\t                      (recur resumed)\n   355\t                      v)\n   356\t            :else (if (:halted? v) (telemetry/emit-snapshot v :halt) v)))))\n   357\t\n   358\t\n   359\t(def ^:private waitset-diagnostics\n   360\t  \"The statuses `dao.stream.waitset/check` wakes an entry it could not poll\n   361\t   at all with: an unsupported reason, an unresolvable entry, or an answer —\n   362\t   or transport — it could not interpret. No park site in `yin.vm` produces\n   363\t   an entry that earns one, and an entry that earns one must not reach a\n   364\t   restore function as a value.\"\n   365\t  #{:dao.stream.waitset/unsupported-reason\n   366\t    :dao.stream.waitset/unresolved\n   367\t    :dao.stream.waitset/invalid-answer})\n   368\t\n   369\t\n   370\t(defn- terminal-resume-outcome\n   371\t  \"The outcome a woken entry resolved with, when it is one the immediate\n   372\t   path raises as an error. `handle-put` and `handle-next` throw for every\n   373\t   outcome outside ok/end/gap, and whether the first attempt blocked must not\n   374\t   change that. A waitset diagnostic is terminal whatever the entry's\n   375\t   `:reason` — an unsupported reason is by definition outside the\n   376\t   `#{:next :put}` this check otherwise reads — so it is named here rather\n   377\t   than falling through to the restore. An entry that was never polled\n   378\t   carries no status.\"\n   379\t  [entry]\n   380\t  (let [status (:status entry)]\n   381\t    (cond\n   382\t      (contains? waitset-diagnostics status) status\n   383\t      (contains? #{:next :put} (:reason entry))\n   384\t      (when-not (contains? #{nil :ok :end :dao.stream/gap} status) status))))\n   385\t\n   386\t\n   387\t(defn- throw-terminal-resume!\n   388\t  \"Fail a resumed entry exactly as the immediate operation would have. A\n   389\t   waitset diagnostic names its status and the entry that earned it: there\n   390\t   is no stream operation whose error vocabulary it belongs to.\"\n   391\t  [entry o]\n   392\t  (cond\n   393\t    (contains? waitset-diagnostics o)\n   394\t    (fail \"Wait-set entry woke with a diagnostic\" {:status o, :entry entry})\n   395\t    (= :next (:reason entry))\n   396\t    (fail \"Stream read failed\"\n   397\t          {:outcome o,\n   398\t           :stream-id (:stream-id entry),\n   399\t           :cursor-id (:id (:cursor-ref entry))})\n   400\t    :else (fail \"Stream append failed\"\n   401\t                {:outcome o, :stream-id (:stream-id entry)})))\n   402\t\n   403\t\n   404\t(defn resume-from-run-queue\n   405\t  \"Pop first entry from the ready-queue, merge store-updates, and restore\n   406\t   VM-specific context.\n   407\t\n   408\t   Restoration is dispatched here rather than carried on the entry, so a\n   409\t   ready entry holds registers, ids, and values — never a closure. The\n   410\t   terminal-outcome check runs before the restore: a woken retry that ended\n   411\t   in an outcome the immediate operation raises as an error must fail the\n   412\t   same way here, not reach Yin code as a value.\n   413\t\n   414\t   `restore-fn` is called with three arguments, `base entry val`, where\n   415\t   `val` is the woken `:value` — the same signature `resume-continuation`\n   416\t   uses, so one restore serves both engine call sites\n   417\t   (`yin.vm.engine.md` §7, edit 2).\"\n   418\t  [state restore-fn]\n   419\t  (let [run-queue (or (:ready-queue state) [])]\n   420\t    (when (seq run-queue)\n   421\t      (let [entry (first run-queue)\n   422\t            rest-queue (subvec run-queue 1)\n   423\t            base (assoc state\n   424\t                        :ready-queue rest-queue\n   425\t                        :store (merge (:store state) (:store-updates entry))\n   426\t                        :blocked? false\n   427\t                        :halted? false)]\n   428\t        (if-let [terminal (terminal-resume-outcome entry)]\n   429\t          (throw-terminal-resume! entry terminal)\n   430\t          (restore-fn base entry (:value entry)))))))\n   431\t\n   432\t\n   433\t(defn scheduler-round\n   434\t  \"One round between continuations: poll the wait set, then resume whatever\n   435\t   woke, through `restore-fn` (`base entry val -> state`, the one restore\n   436\t   signature `yin.vm.engine.md` §2.1 states). Returns the polled state when\n   437\t   nothing woke, so a caller always gets a state back.\n   438\t\n   439\t   This is `yin.vm.semantic/scheduler-round` with its restore made a\n   440\t   parameter (`yin.vm.engine.md` §7, edit 1); every VM was writing this\n   441\t   composition by hand.\"\n   442\t  [state restore-fn]\n   443\t  (let [v' (check-wait-set state)]\n   444\t    (or (resume-from-run-queue v' restore-fn) v')))\n   445\t\n   446\t\n   447\t(defn park-continuation\n   448\t  \"Add a parked continuation entry and halt the VM.\"\n   449\t  [state cont-fields]\n   450\t  (let [id-counter (or (:id-counter state) 0)\n   451\t        park-id (keyword (str \"parked-\" id-counter))\n   452\t        parked (merge {:type :parked-continuation, :id park-id} cont-fields)]\n   453\t    (-> state\n   454\t        (update :parked assoc park-id parked)\n   455\t        (assoc :value parked\n   456\t               :halted? true\n   457\t               :id-counter (inc id-counter))\n   458\t        (telemetry/emit-snapshot :park {:parked-id park-id}))))\n   459\t\n   460\t\n   461\t(defn resume-continuation\n   462\t  \"Restore state from a parked continuation.\"\n   463\t  [state parked-id resume-val restore-fn]\n   464\t  (if-let [parked (get-in state [:parked parked-id])]\n   465\t    (let [new-state (update state :parked dissoc parked-id)]\n   466\t      (-> (restore-fn new-state parked resume-val)\n   467\t          (telemetry/emit-snapshot :resume {:parked-id parked-id})))\n   468\t    (fail \"Cannot resume: parked continuation not found\"\n   469\t          {:parked-id parked-id})))\n   470\t\n   471\t\n   472\t(defn gensym\n   473\t  \"Generate a unique ID and return [id updated-state].\"\n   474\t  ([state] (gensym state \"id\"))\n   475\t  ([state prefix]\n   476\t   (let [id-counter (or (:id-counter state) 0)\n   477\t         id (gen-id prefix id-counter)]\n   478\t     [id (assoc state :id-counter (inc id-counter))])))\n   479\t\n   480\t\n   481\t(defn handle-stream-block\n   482\t  [result entry]\n   483\t  (if (:park result)\n   484\t    (let [entry (or entry\n   485\t                    (fail \"Parked entry required for blocking stream\"\n   486\t                          {:result result}))\n   487\t          new-state (-> (:state result)\n   488\t                        (update :wait-set (fnil conj []) entry)\n   489\t                        (assoc :value :yin/blocked\n   490\t                               :blocked? true\n   491\t                               :halted? false))]\n   492\t      {:state new-state, :value :yin/blocked, :blocked? true})\n   493\t    {:state (:state result), :value (:value result), :blocked? false}))\n   494\t\n   495\t\n   496\t(defn handle-effect\n   497\t  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n   498\t   park-entry-fns maps :stream/put and :stream/next to functions that build\n   499\t   wait entries.\n   500\t\n   501\t   A parked entry is stored as the builder left it plus, for a writer, the\n   502\t   `:datom` it retries: registers and resource ids only. Neither the live\n   503\t   stream handle nor a restore closure is attached — `check-wait-set`\n   504\t   resolves handles from the store at every poll, and the scheduler that pops\n   505\t   a woken entry dispatches restoration itself — so a blocked entry is pure\n   506\t   data and survives serialization.\"\n   507\t  [state effect {:keys [park-entry-fns], :as opts}]\n   508\t  (let [park-entry (get park-entry-fns (:effect effect))\n   509\t        result\n   510\t        (case (:effect effect)\n   511\t          :vm/store-put {:state (assoc state\n   512\t                                       :store (assoc (:store state)\n   513\t                                                     (:key effect)\n   514\t                                                     (:val effect))),\n   515\t                         :value (:val effect),\n   516\t                         :blocked? false}\n   517\t          :stream/make\n   518\t          (let [[id s'] (gensym state \"stream\")\n   519\t                [stream-ref new-state] (handle-make s' effect id)]\n   520\t            {:state new-state, :value stream-ref, :blocked? false})\n   521\t          :stream/cursor\n   522\t          (let [[id s'] (gensym state \"cursor\")\n   523\t                [cursor-ref new-state] (handle-cursor s' effect id)]\n   524\t            {:state new-state, :value cursor-ref, :blocked? false})\n   525\t          :stream/put\n   526\t          (let [result (handle-put state effect)]\n   527\t            (if (:park result)\n   528\t              (let [built-entry (when park-entry\n   529\t                                  (park-entry state effect result))\n   530\t                    built-entry (if (and built-entry (not (:datom built-entry)))\n   531\t                                  (assoc built-entry :datom (:val effect))\n   532\t                                  built-entry)]\n   533\t                (handle-stream-block result built-entry))\n   534\t              {:state (:state result),\n   535\t               :value (:value result),\n   536\t               :blocked? false}))\n   537\t          :stream/next\n   538\t          (let [result (handle-next state effect)]\n   539\t            (if (:park result)\n   540\t              (let [built-entry (when park-entry\n   541\t                                  (park-entry state effect result))]\n   542\t                (handle-stream-block result built-entry))\n   543\t              {:state (:state result),\n   544\t               :value (:value result),\n   545\t               :blocked? false}))\n   546\t          :stream/close\n   547\t          (let [close-result (handle-close state effect)]\n   548\t            {:state (:state close-result), :value nil, :blocked? false})\n   549\t          (let [[id s'] (gensym state \"effect\")\n   550\t                handler (module/get-effect-handler (:modules state)\n   551\t                                                   (:effect effect))]\n   552\t            (if handler\n   553\t              (handler s' effect (assoc opts :id id))\n   554\t              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n   555\t    (update result\n   556\t            :state\n   557\t            (fn [result-state]\n   558\t              (telemetry/emit-snapshot (assoc result-state\n   559\t                                              :value (:value result))\n   560\t                                       :effect\n   561\t                                       {:effect-type (:effect effect)})))))\n   562\t\n   563\t\n   564\t;; =============================================================================\n   565\t;; Program Cache Machinery\n   566\t;; =============================================================================\n   567\t\n   568\t(def default-compiled-cache-limit 8)\n   569\t\n   570\t\n   571\t(defn build-program-index\n   572\t  [datoms]\n   573\t  (group-by first (vec datoms)))\n   574\t\n   575\t\n   576\t(defn frame-versions\n   577\t  [frame]\n   578\t  (loop [f frame\n   579\t         acc #{}]\n   580\t    (if (map? f)\n   581\t      (let [acc (cond-> acc (:compiled-version f) (conj (:compiled-version f)))]\n   582\t        (recur (:next f) acc))\n   583\t      acc)))\n   584\t\n   585\t\n   586\t(defn collect-frame-versions\n   587\t  [frames]\n   588\t  (reduce (fn [acc f] (into acc (frame-versions f))) #{} (or frames [])))\n   589\t\n   590\t\n   591\t(defn pinned-compiled-versions\n   592\t  [vm]\n   593\t  (let [active (:active-compiled-version vm)\n   594\t        k-versions (frame-versions (:k vm))\n   595\t        parked-versions (collect-frame-versions (vals (:parked vm)))\n   596\t        ready-versions (collect-frame-versions (:ready-queue vm))\n   597\t        wait-versions (collect-frame-versions (:wait-set vm))]\n   598\t    (cond-> (clojure.set/union k-versions\n   599\t                               parked-versions\n   600\t                               ready-versions\n   601\t                               wait-versions)\n   602\t      active (conj active))))\n   603\t\n   604\t\n   605\t(defn trim-compiled-cache\n   606\t  [vm]\n   607\t  (let [cache (:compiled-by-version vm)\n   608\t        limit\n   609\t        (max 1 (or (:compiled-cache-limit vm) default-compiled-cache-limit))]\n   610\t    (if (> (count cache) limit)\n   611\t      (let [pinned (pinned-compiled-versions vm)\n   612\t            sorted-versions (reverse (sort (keys cache)))\n   613\t            to-keep (into pinned (take limit sorted-versions))]\n   614\t        (assoc vm :compiled-by-version (select-keys cache to-keep)))\n   615\t      vm)))\n   616\t\n   617\t\n   618\t(defn cache-compiled-artifact\n   619\t  [vm version artifact program-index]\n   620\t  (-> vm\n   621\t      (assoc :compile-dirty? false\n   622\t             :datom-index program-index\n   623\t             :active-compiled-version version)\n   624\t      (update :compiled-by-version (fnil assoc {}) version artifact)\n   625\t      trim-compiled-cache))\n   626\t\n   627\t\n   628\t(defn ensure-compiled-version\n   629\t  [vm version compile-fn]\n   630\t  (if-let [artifact (get-in vm [:compiled-by-version version])]\n   631\t    [vm artifact]\n   632\t    (let [program-datoms (vec (or (:datoms vm) []))\n   633\t          program-root-eid (:program-root-eid vm)]\n   634\t      (when (or (empty? program-datoms) (nil? program-root-eid))\n   635\t        (fail \"Canonical program is not loaded\" {:program-version version}))\n   636\t      (let [program-index (or (:datom-index vm)\n   637\t                              (build-program-index program-datoms))\n   638\t            artifact (compile-fn program-root-eid program-datoms program-index)\n   639\t            vm' (cache-compiled-artifact vm version artifact program-index)]\n   640\t        [vm' artifact]))))\n   641\t\n   642\t\n   643\t(defn maybe-recompile-at-boundary\n   644\t  [vm compile-fn]\n   645\t  (if (and (:compile-dirty? vm)\n   646\t           (seq (:datoms vm))\n   647\t           (some? (:program-root-eid vm)))\n   648\t    (ensure-compiled-version vm (:program-version vm) compile-fn)\n   649\t    [vm nil]))\n","exit_code":0,"status":"completed"}}
