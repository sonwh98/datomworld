{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/yin/vm/ucf_test.cljc'","aggregated_output":"     1\t(ns yin.vm.ucf-test\n     2\t  \"UCF Phase 1 (`docs/design/yin.vm.universal-continuation-format.md` S7.3,\n     3\t   S7.4): the canonical instruction vector, its address and contract stamp,\n     4\t   and the static safepoint map -- checked against the reference machine.\n     5\t\n     6\t   Fixtures are S2.7-shaped batches assembled by hand, as in\n     7\t   `yin.vm.semantic-test`, so the resolved interpretation under test is the\n     8\t   loader's own.\"\n     9\t  (:require [clojure.test :refer [deftest is testing]]\n    10\t            [dao.datom :as datom]\n    11\t            [dao.jing :as jing]\n    12\t            [dao.stream :as stream]\n    13\t            [yin.vm :as vm]\n    14\t            [yin.vm.semantic :as semantic]\n    15\t            [yin.vm.test-utils :as tu]\n    16\t            [yin.vm.ucf :as ucf]))\n    17\t\n    18\t\n    19\t;; =============================================================================\n    20\t;; Hand assembly\n    21\t;; =============================================================================\n    22\t\n    23\t(def ^:private seg -1)\n    24\t\n    25\t\n    26\t(defn- eid\n    27\t  [pc]\n    28\t  (- -10 pc))\n    29\t\n    30\t\n    31\t(defn- entity-datoms\n    32\t  [e attr-values]\n    33\t  (mapv (fn [[a v]] [e a v 0 datom/default-op]) attr-values))\n    34\t\n    35\t\n    36\t(defn- segment\n    37\t  ([length] (segment length []))\n    38\t  ([length extra]\n    39\t   (entity-datoms seg (into [[:yin.code/type :segment]\n    40\t                             [:yin.code/length length]]\n    41\t                            extra))))\n    42\t\n    43\t\n    44\t(defn- instruction*\n    45\t  [e pc op operands]\n    46\t  (entity-datoms e (into [[:yin.code/segment seg] [:yin.code/pc pc]\n    47\t                          [:yin.code/op op]]\n    48\t                         (partition 2 operands))))\n    49\t\n    50\t\n    51\t(defn- instruction\n    52\t  [pc op & operands]\n    53\t  (instruction* (eid pc) pc op operands))\n    54\t\n    55\t\n    56\t(defn- assemble\n    57\t  [& parts]\n    58\t  (vec (apply concat parts)))\n    59\t\n    60\t\n    61\t(defn- make-vm\n    62\t  ([] (make-vm {}))\n    63\t  ([opts] (semantic/create-vm (merge {:make-stream tu/make-stream} opts))))\n    64\t\n    65\t\n    66\t(defn- ex-data-of\n    67\t  [thunk]\n    68\t  (try (thunk) nil\n    69\t       (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n    70\t         (ex-data e))))\n    71\t\n    72\t\n    73\t(defn- worked-segment\n    74\t  \"`((fn [x] (+ x 1)) 10)` as lowered in yin.vm.semantic.md S2.7.\"\n    75\t  []\n    76\t  (assemble (segment 14)\n    77\t            (instruction 0 :closure :yin.code/params '[x]\n    78\t                         :yin.code/body (eid 6))\n    79\t            (instruction 1 :push)\n    80\t            (instruction 2 :const :yin.code/value 10)\n    81\t            (instruction 3 :push)\n    82\t            (instruction 4 :call :yin.code/argc 1 :yin.code/tail? false)\n    83\t            (instruction 5 :halt)\n    84\t            (instruction 6 :var :yin.code/name '+)\n    85\t            (instruction 7 :push)\n    86\t            (instruction 8 :var :yin.code/name 'x)\n    87\t            (instruction 9 :push)\n    88\t            (instruction 10 :const :yin.code/value 1)\n    89\t            (instruction 11 :push)\n    90\t            (instruction 12 :call :yin.code/argc 2 :yin.code/tail? true)\n    91\t            (instruction 13 :return)))\n    92\t\n    93\t\n    94\t(def ^:private worked-vector\n    95\t  [[:closure '[x] 6] [:push] [:const 10] [:push] [:call 1 false] [:halt]\n    96\t   [:var '+] [:push] [:var 'x] [:push] [:const 1] [:push] [:call 2 true]\n    97\t   [:return]])\n    98\t\n    99\t\n   100\t(defn- effects-segment\n   101\t  \"Every defaulted operand stated: a gensym, a stream-make, an ffi-call\n   102\t   and a non-tail call, then halt.\"\n   103\t  [& {:keys [prefix buffer argc tail?]\n   104\t      :or {prefix \"id\", buffer vm/default-stream-capacity, argc 0,\n   105\t           tail? false}}]\n   106\t  (assemble (segment 8)\n   107\t            (instruction 0 :gensym :yin.code/prefix prefix)\n   108\t            (instruction 1 :push)\n   109\t            (instruction 2 :stream-make :yin.code/buffer buffer)\n   110\t            (instruction 3 :push)\n   111\t            (instruction 4 :ffi-call :yin.code/ffi-op :op/add\n   112\t                         :yin.code/argc argc)\n   113\t            (instruction 5 :push)\n   114\t            (instruction 6 :call :yin.code/argc 2 :yin.code/tail? tail?)\n   115\t            (instruction 7 :halt)))\n   116\t\n   117\t\n   118\t(defn- without-attrs\n   119\t  \"The batch with every datom on one of `attrs` removed.\"\n   120\t  [batch attrs]\n   121\t  (vec (remove (fn [[_ a]] (contains? attrs a)) batch)))\n   122\t\n   123\t\n   124\t;; =============================================================================\n   125\t;; S7.3.2 the canonical instruction vector\n   126\t;; =============================================================================\n   127\t\n   128\t(deftest canonical-vector-of-the-worked-segment-test\n   129\t  (let [v (ucf/batch->canonical-instruction-vector (worked-segment))]\n   130\t    (testing \"pc is the index; tuples are mnemonic plus S2.4 operands\"\n   131\t      (is (= worked-vector v))\n   132\t      (is (= 14 (count v))))\n   133\t    (testing \"No entity id, attribute keyword or provenance survives\"\n   134\t      (is (not-any? (fn [t] (some keyword? (rest t))) v))\n   135\t      (is (every? vector? v)))\n   136\t    (testing \"Refs are the loader's resolved pcs\"\n   137\t      (is (= 6 (nth (nth v 0) 2))))\n   138\t    (testing \"The direct path accepts and runs what canonicalization mints\"\n   139\t      (let [loaded (semantic/load-vector (make-vm) v)]\n   140\t        (is (= 11 (vm/value (vm/run loaded))))\n   141\t        (is (= (:code (semantic/load-image (worked-segment)))\n   142\t               (:code (get-in loaded [:code (:program loaded)])))\n   143\t            \"projection and direct paths yield one image (S7.3.4)\")))))\n   144\t\n   145\t\n   146\t(deftest code-identity-and-contract-stamp-test\n   147\t  (let [outcome (ucf/canonicalize (worked-segment))]\n   148\t    (testing \"The address is dao.jing's segment key of the vector\"\n   149\t      (is (= :yin.k/ok (:yin.k/status outcome)))\n   150\t      (is (= worked-vector (:yin.code/vector outcome)))\n   151\t      (is (= (jing/segment-key worked-vector) (:yin.code/hash outcome)))\n   152\t      (is (= (ucf/code-address worked-vector) (:yin.code/hash outcome)))\n   153\t      (is (jing/segment-address? (:yin.code/hash outcome))))\n   154\t    (testing \"The stamp names the v2 contract and the envelope version\"\n   155\t      (is (= {:yin.code/contract \"v2\", :yin.k/version 0}\n   156\t             (:yin.k/contract outcome)))\n   157\t      (is (= ucf/contract-stamp (:yin.k/contract outcome))))))\n   158\t\n   159\t\n   160\t(deftest loader-verifies-the-address-canonicalization-mints-test\n   161\t  (let [address (:yin.code/hash (ucf/canonicalize (effects-segment)))\n   162\t        claimed (fn [batch]\n   163\t                  (into (segment 8 [[:yin.code/hash address]])\n   164\t                        (remove (fn [[e]] (= seg e)) batch)))]\n   165\t    (testing \"A batch stating its defaults earns the claim\"\n   166\t      (is (= address (:address (semantic/load-image\n   167\t                                 (claimed (effects-segment)))))))\n   168\t    (testing \"A batch omitting them earns the same claim: one canonicalizer\"\n   169\t      (is (= address\n   170\t             (:address (semantic/load-image\n   171\t                         (claimed (without-attrs\n   172\t                                    (effects-segment)\n   173\t                                    #{:yin.code/prefix :yin.code/buffer\n   174\t                                      :yin.code/tail?})))))))\n   175\t    (testing \"A different segment does not\"\n   176\t      (is (= {:rule :hash-mismatch, :entity seg}\n   177\t             (:defect (ex-data-of\n   178\t                        #(semantic/load-image\n   179\t                           (claimed (effects-segment :prefix \"g\"))))))))))\n   180\t\n   181\t\n   182\t;; =============================================================================\n   183\t;; Equivalence laws\n   184\t;; =============================================================================\n   185\t\n   186\t(deftest equivalence-under-relabelling-and-reordering-test\n   187\t  (let [reference (ucf/canonicalize (worked-segment))\n   188\t        same? (fn [batch]\n   189\t                (let [o (ucf/canonicalize batch)]\n   190\t                  (and (= (:yin.code/vector reference) (:yin.code/vector o))\n   191\t                       (= (:yin.code/hash reference) (:yin.code/hash o)))))]\n   192\t    (testing \"Entity ids are relabelled: alpha-equivalent batches agree\"\n   193\t      (is (same? (mapv (fn [[e a v t m]]\n   194\t                         [(* 1000 e)\n   195\t                          a\n   196\t                          (if (contains? #{:yin.code/segment :yin.code/body}\n   197\t                                         a)\n   198\t                            (* 1000 v)\n   199\t                            v)\n   200\t                          t m])\n   201\t                       (worked-segment)))))\n   202\t    (testing \"Datom order within an entity, and the segment's place, are\n   203\t              transport accidents\"\n   204\t      (let [by-entity (group-by first (worked-segment))\n   205\t            shuffled (into []\n   206\t                           (mapcat (fn [e] (vec (reverse (get by-entity e)))))\n   207\t                           (conj (mapv eid (range 14)) seg))]\n   208\t        (is (same? shuffled))))\n   209\t    (testing \"Provenance is excluded\"\n   210\t      (is (same? (into (worked-segment)\n   211\t                       (into [[seg :yin.code/derived-from -99 0\n   212\t                               datom/default-op]]\n   213\t                             (map (fn [pc]\n   214\t                                    [(eid pc) :yin.code/source (- -100 pc)\n   215\t                                     0 datom/default-op]))\n   216\t                             (range 14))))))))\n   217\t\n   218\t\n   219\t(deftest equivalence-under-saturation-and-resolution-test\n   220\t  (let [stated (ucf/canonicalize (effects-segment))]\n   221\t    (testing \"Omitted defaulted operands are materialized (S7.3.2); an\n   222\t              argc is not omissible, S2.6 rule 7 requires it on the batch\"\n   223\t      (let [omitted (ucf/canonicalize\n   224\t                      (without-attrs (effects-segment)\n   225\t                                     #{:yin.code/prefix :yin.code/buffer\n   226\t                                       :yin.code/tail?}))]\n   227\t        (is (= [:gensym \"id\"] (nth (:yin.code/vector omitted) 0)))\n   228\t        (is (= [:stream-make vm/default-stream-capacity]\n   229\t               (nth (:yin.code/vector omitted) 2)))\n   230\t        (is (= [:ffi-call :op/add 0] (nth (:yin.code/vector omitted) 4)))\n   231\t        (is (= [:call 2 false] (nth (:yin.code/vector omitted) 6)))\n   232\t        (is (= (:yin.code/vector stated) (:yin.code/vector omitted)))\n   233\t        (is (= (:yin.code/hash stated) (:yin.code/hash omitted)))))\n   234\t    (testing \"A repeated attribute keeps its last value, as execution does\"\n   235\t      (let [twice (assemble (segment 2)\n   236\t                            (instruction 0 :const :yin.code/value 1)\n   237\t                            [[(eid 0) :yin.code/value 10 0\n   238\t                              datom/default-op]]\n   239\t                            (instruction 1 :halt))\n   240\t            once (assemble (segment 2)\n   241\t                           (instruction 0 :const :yin.code/value 10)\n   242\t                           (instruction 1 :halt))]\n   243\t        (is (= [[:const 10] [:halt]]\n   244\t               (ucf/batch->canonical-instruction-vector twice)))\n   245\t        (is (= (:yin.code/hash (ucf/canonicalize once))\n   246\t               (:yin.code/hash (ucf/canonicalize twice))))))))\n   247\t\n   248\t\n   249\t;; =============================================================================\n   250\t;; Distinction laws\n   251\t;; =============================================================================\n   252\t\n   253\t(deftest distinction-test\n   254\t  (let [address (fn [batch] (:yin.code/hash (ucf/canonicalize batch)))\n   255\t        vector-of ucf/batch->canonical-instruction-vector\n   256\t        const-program (fn [& values]\n   257\t                        (assemble (segment 2)\n   258\t                                  (instruction 0 :const)\n   259\t                                  (mapv (fn [v]\n   260\t                                          [(eid 0) :yin.code/value v 0\n   261\t                                           datom/default-op])\n   262\t                                        values)\n   263\t                                  (instruction 1 :halt)))]\n   264\t    (testing \"Different constants differ\"\n   265\t      (is (not= (vector-of (const-program 1)) (vector-of (const-program 2))))\n   266\t      (is (not= (address (const-program 1)) (address (const-program 2)))))\n   267\t    (testing \"Resolution order is identity: 1,2 and 2,1 execute differently\"\n   268\t      (is (= [[:const 2] [:halt]] (vector-of (const-program 1 2))))\n   269\t      (is (= [[:const 1] [:halt]] (vector-of (const-program 2 1))))\n   270\t      (is (not= (address (const-program 1 2)) (address (const-program 2 1)))))\n   271\t    (testing \"A tail call is not a call\"\n   272\t      (is (not= (address (effects-segment :tail? true))\n   273\t                (address (effects-segment :tail? false)))))\n   274\t    (testing \"A gensym prefix, a buffer, and an argc are identity\"\n   275\t      (is (not= (address (effects-segment)) (address (effects-segment\n   276\t                                                       :prefix \"g\"))))\n   277\t      (is (not= (address (effects-segment)) (address (effects-segment\n   278\t                                                       :buffer 1))))\n   279\t      (is (not= (address (effects-segment)) (address (effects-segment\n   280\t                                                       :argc 1)))))\n   281\t    (testing \"A different branch target is a different control graph\"\n   282\t      (let [branch (fn [target]\n   283\t                     (assemble (segment 5)\n   284\t                               (instruction 0 :const :yin.code/value true)\n   285\t                               (instruction 1 :branch-false\n   286\t                                            :yin.code/target (eid target))\n   287\t                               (instruction 2 :const :yin.code/value 1)\n   288\t                               (instruction 3 :const :yin.code/value 2)\n   289\t                               (instruction 4 :halt)))]\n   290\t        (is (not= (address (branch 3)) (address (branch 4))))))))\n   291\t\n   292\t\n   293\t;; =============================================================================\n   294\t;; Non-canonicalizable batches\n   295\t;; =============================================================================\n   296\t\n   297\t(defn- refusal-of\n   298\t  [batch]\n   299\t  (ex-data-of #(ucf/batch->canonical-instruction-vector batch)))\n   300\t\n   301\t\n   302\t(deftest non-canonicalizable-test\n   303\t  (testing \"An unknown mnemonic is refused as non-portable\"\n   304\t    (let [bad (assemble (segment 2)\n   305\t                        (instruction 0 :frobnicate)\n   306\t                        (instruction 1 :halt))\n   307\t          r (refusal-of bad)]\n   308\t      (is (= :yin.k/non-portable (:yin.k/status r)))\n   309\t      (is (= :non-canonicalizable (:yin.k/kind r)))\n   310\t      (is (= r (ucf/canonicalize bad))\n   311\t          \"canonicalize returns the same outcome rather than throwing\")))\n   312\t  (testing \"An operand the tuple has no slot for is refused, naming the pc\"\n   313\t    (let [r (refusal-of (assemble (segment 2)\n   314\t                                  (instruction 0 :const :yin.code/value 1\n   315\t                                               :yin.code/argc 3)\n   316\t                                  (instruction 1 :halt)))]\n   317\t      (is (= :non-canonicalizable (:yin.k/kind r)))\n   318\t      (is (= [:pc 0] (:yin.k/path r)))\n   319\t      (is (= :operand-slot (get-in r [:yin.k/defect :rule])))\n   320\t      (is (= [:yin.code/argc] (get-in r [:yin.k/defect :attrs])))))\n   321\t  (testing \"A segment attribute beyond the folded and excluded set is refused\"\n   322\t    (let [r (refusal-of (assemble (segment 2 [[:yin.code/entry 1]])\n   323\t                                  (instruction 0 :const :yin.code/value 1)\n   324\t                                  (instruction 1 :halt)))]\n   325\t      (is (= :non-canonicalizable (:yin.k/kind r)))\n   326\t      (is (= [:entity seg] (:yin.k/path r)))\n   327\t      (is (= :segment-attribute (get-in r [:yin.k/defect :rule])))))\n   328\t  (testing \"An operand of the wrong kind resolves to an inadmissible tuple\"\n   329\t    (let [r (refusal-of (assemble (segment 2)\n   330\t                                  (instruction 0 :var :yin.code/name \"x\")\n   331\t                                  (instruction 1 :halt)))]\n   332\t      (is (= :non-canonicalizable (:yin.k/kind r)))\n   333\t      (is (= :operand-kind (get-in r [:yin.k/defect :rule])))\n   334\t      (is (= 0 (get-in r [:yin.k/defect :pc])))))\n   335\t  (testing \"A batch that is not a segment is refused with the loader's rule\"\n   336\t    (let [r (refusal-of (assemble (segment 2)\n   337\t                                  (instruction 0 :const :yin.code/value 1)\n   338\t                                  (instruction 1 :push)))]\n   339\t      (is (= :non-canonicalizable (:yin.k/kind r)))\n   340\t      (is (= :missing-terminator (get-in r [:yin.k/defect :rule])))))\n   341\t  (testing \"Nothing in the folded and excluded set is refused\"\n   342\t    (is (vector? (ucf/batch->canonical-instruction-vector\n   343\t                   (assemble (segment 2 [[:yin.code/derived-from -50]\n   344\t                                         [:yin.code/hash :segment/x]])\n   345\t                             (instruction 0 :const :yin.code/value 1)\n   346\t                             (instruction 1 :halt)))))))\n   347\t\n   348\t\n   349\t;; =============================================================================\n   350\t;; S7.4 safepoints: the static half\n   351\t;; =============================================================================\n   352\t\n   353\t(deftest transitions-cover-the-vocabulary-test\n   354\t  (testing \"Every S2.4 mnemonic is classified exactly once\"\n   355\t    (is (= #{:const :var :closure :push :call :return :jump :branch-false\n   356\t             :halt :gensym :store-get :store-put :stream-make :stream-put\n   357\t             :stream-cursor :stream-next :stream-close :park :resume\n   358\t             :current-continuation :ffi-call}\n   359\t           (set (keys ucf/transitions)))))\n   360\t  (testing \"The parking transitions are S7.4.1's, effectful calls included\"\n   361\t    (is (= #{:park :stream-next :stream-put :ffi-call :call}\n   362\t           (set (keep (fn [[m k]] (when (= :parking k) m))\n   363\t                      ucf/transitions)))))\n   364\t  (testing \"Reifying a continuation is not a safepoint\"\n   365\t    (is (= :step (get ucf/transitions :current-continuation)))))\n   366\t\n   367\t\n   368\t(deftest safepoints-of-the-worked-segment-test\n   369\t  (let [sps (ucf/safepoints worked-vector)]\n   370\t    (testing \"The two calls are the safepoints; resume is pc+1\"\n   371\t      (is (= [4 12] (mapv :yin.safepoint/at sps)))\n   372\t      (is (= [5 13] (mapv :yin.safepoint/pc sps)))\n   373\t      (is (= [[:call-effect] [:call-effect]]\n   374\t             (mapv :yin.safepoint/reasons sps))))\n   375\t    (testing \"Stack effect pops operator and arguments\"\n   376\t      (is (= [-2 -3] (mapv :yin.safepoint/stack-effect sps))))\n   377\t    (testing \"Nothing is read from E after either call\"\n   378\t      (is (= [[] []] (mapv :yin.safepoint/lexically-required sps))))))\n   379\t\n   380\t\n   381\t(deftest stack-effect-per-parking-kind-test\n   382\t  (is (= 0 (ucf/stack-effect [:park])))\n   383\t  (is (= 0 (ucf/stack-effect [:stream-next])))\n   384\t  (is (= -1 (ucf/stack-effect [:stream-put])))\n   385\t  (is (= -2 (ucf/stack-effect [:ffi-call :op/add 2])))\n   386\t  (is (= -1 (ucf/stack-effect [:call 0 false])))\n   387\t  (is (= -3 (ucf/stack-effect [:call 2 true])))\n   388\t  (is (nil? (ucf/stack-effect [:const 1]))))\n   389\t\n   390\t\n   391\t(deftest safepoint-table-and-lookup-test\n   392\t  (let [v [[:stream-make 8] [:stream-cursor] [:stream-next] [:push]\n   393\t           [:var 'q] [:halt]]\n   394\t        table (ucf/safepoint-table v)]\n   395\t    (testing \"The table is keyed by the code's address and an engine profile\"\n   396\t      (is (= (jing/segment-key v) (:yin.safepoint/segment table)))\n   397\t      (is (= :yin.vm.semantic/reference (:yin.safepoint/engine table)))\n   398\t      (is (= :wasm32/v1\n   399\t             (:yin.safepoint/engine (ucf/safepoint-table v :wasm32/v1))))\n   400\t      (is (= [{:yin.safepoint/at 2,\n   401\t               :yin.safepoint/pc 3,\n   402\t               :yin.safepoint/reasons [:next],\n   403\t               :yin.safepoint/stack-effect 0,\n   404\t               :yin.safepoint/lexically-required '[q]}]\n   405\t             (:yin.safepoint/safepoints table))))\n   406\t    (testing \"A pc that is not a safepoint is named\"\n   407\t      (is (= 3 (:yin.safepoint/pc (ucf/safepoint-at v 3))))\n   408\t      (is (= {:yin.k/status :yin.k/not-at-safepoint, :yin.k/pc 4}\n   409\t             (ucf/safepoint-at v 4))))))\n   410\t\n   411\t\n   412\t(deftest lexically-required-test\n   413\t  (let [v [[:park]\n   414\t           [:var 'x]\n   415\t           [:push]\n   416\t           [:closure '[y] 7]\n   417\t           [:push]\n   418\t           [:call 1 false]\n   419\t           [:halt]\n   420\t           [:var 'z]\n   421\t           [:push]\n   422\t           [:var 'y]\n   423\t           [:push]\n   424\t           [:closure '[z] 13]\n   425\t           [:return]\n   426\t           [:var 'z]\n   427\t           [:push]\n   428\t           [:var 'w]\n   429\t           [:return]]]\n   430\t    (testing \"Names read on every path from the resume pc; a closure body\n   431\t              entered from its creation has its params bound\"\n   432\t      (is (= '[w x z] (ucf/lexically-required v 1)))\n   433\t      (is (= '[w x z] (:yin.safepoint/lexically-required\n   434\t                        (first (ucf/safepoints v)))))\n   435\t      (is (= '[w] (ucf/lexically-required v 11))\n   436\t          \"z is bound by the inner closure created at 11\"))\n   437\t    (testing \"Resuming inside a body, its params are E's business: the\n   438\t              static walk reports them as read, the frame carries them\"\n   439\t      (is (= '[w y z] (ucf/lexically-required v 7)))\n   440\t      (is (= '[w z] (ucf/lexically-required v 13)))))\n   441\t  (testing \"Both arms of a branch are read; a jump skips nothing reachable\"\n   442\t    (let [v [[:const true] [:branch-false 4] [:var 'a] [:jump 5] [:var 'b]\n   443\t             [:halt]]]\n   444\t      (is (= '[a b] (ucf/lexically-required v 0)))\n   445\t      (is (= '[b] (ucf/lexically-required v 4)))))\n   446\t  (testing \"A loop terminates and reads each name once\"\n   447\t    (let [v [[:var 'n] [:push] [:jump 0]]]\n   448\t      (is (= '[n] (ucf/lexically-required v 0)))))\n   449\t  (testing \"A resume transfers control: nothing after it is reachable\"\n   450\t    (is (= '[] (ucf/lexically-required [[:resume :parked-0] [:var 'x]\n   451\t                                        [:halt]]\n   452\t                                       0)))))\n   453\t\n   454\t\n   455\t;; =============================================================================\n   456\t;; S7.4 safepoints: conformance against the reference machine\n   457\t;; =============================================================================\n   458\t\n   459\t(defn- step-to\n   460\t  \"Step the loaded machine until control sits at `pc`.\"\n   461\t  [vm pc]\n   462\t  (loop [vm vm\n   463\t         n 0]\n   464\t    (cond\n   465\t      (= pc (:pc (vm/control vm))) vm\n   466\t      (< 64 n) (throw (ex-info \"pc never reached\" {:pc pc}))\n   467\t      :else (recur (vm/step vm) (inc n)))))\n   468\t\n   469\t\n   470\t(defn- observe-park\n   471\t  \"Run the batch to the parking instruction at `at`, take the transition,\n   472\t   and return the operand depth before it with the frame the machine left:\n   473\t   a wait entry, or the parked record for an explicit park.\"\n   474\t  [vm batch at]\n   475\t  (let [before (step-to (semantic/vm-load-program vm batch) at)\n   476\t        after (vm/step before)\n   477\t        frame (or (first (:wait-set after))\n   478\t                  (first (vals (:parked after))))]\n   479\t    {:depth (count (:stack before)), :frame frame, :vm after}))\n   480\t\n   481\t\n   482\t(defn- conforms?\n   483\t  \"The static safepoint entry agrees with the observed frame: the frame's\n   484\t   pc is the canonical resume pc and its stack depth is the depth before\n   485\t   the instruction plus the static stack effect.\"\n   486\t  [batch at {:keys [depth frame]}]\n   487\t  (let [sp (ucf/safepoint-at (ucf/batch->canonical-instruction-vector batch)\n   488\t                             (inc at))]\n   489\t    (and (= at (:yin.safepoint/at sp))\n   490\t         (= (:yin.safepoint/pc sp) (:pc frame))\n   491\t         (= (+ depth (:yin.safepoint/stack-effect sp))\n   492\t            (count (:stack frame))))))\n   493\t\n   494\t\n   495\t(defn- one-slot-writer\n   496\t  \"A `:make-stream` whose handle answers `full` once one value sits in it,\n   497\t   so a second put parks. The reader surface is the minimum the FFI pair's\n   498\t   construction needs: a cursor that never advances.\"\n   499\t  [_capacity]\n   500\t  (let [slot (atom ::empty)]\n   501\t    {:dao.stream/outcome :dao.stream/ok,\n   502\t     :dao.stream/handle\n   503\t     (reify\n   504\t       stream/IDaoStreamReader\n   505\t       (cursor\n   506\t         [_ _anchor]\n   507\t         {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor 0})\n   508\t\n   509\t       (next\n   510\t         [_ _cursor]\n   511\t         {:dao.stream/outcome :dao.stream/blocked})\n   512\t\n   513\t\n   514\t       stream/IDaoStreamWriter\n   515\t\n   516\t       (append!\n   517\t         [_ v]\n   518\t         (if (= ::empty @slot)\n   519\t           (do (reset! slot v) {:dao.stream/outcome :dao.stream/ok})\n   520\t           {:dao.stream/outcome :dao.stream/full})))}))\n   521\t\n   522\t\n   523\t(deftest explicit-park-conformance-test\n   524\t  (let [batch (assemble (segment 4)\n   525\t                        (instruction 0 :const :yin.code/value 5)\n   526\t                        (instruction 1 :push)\n   527\t                        (instruction 2 :park)\n   528\t                        (instruction 3 :halt))\n   529\t        obs (observe-park (make-vm) batch 2)]\n   530\t    (is (= 1 (:depth obs)))\n   531\t    (is (= 3 (:pc (:frame obs))))\n   532\t    (is (conforms? batch 2 obs))))\n   533\t\n   534\t\n   535\t(deftest blocked-read-conformance-test\n   536\t  (let [batch (assemble (segment 6)\n   537\t                        (instruction 0 :const :yin.code/value :below)\n   538\t                        (instruction 1 :push)\n   539\t                        (instruction 2 :stream-make :yin.code/buffer 8)\n   540\t                        (instruction 3 :stream-cursor)\n   541\t                        (instruction 4 :stream-next)\n   542\t                        (instruction 5 :halt))\n   543\t        obs (observe-park (make-vm) batch 4)]\n   544\t    (is (vm/blocked? (:vm obs)))\n   545\t    (is (= :next (:reason (:frame obs))))\n   546\t    (is (= 1 (:depth obs)))\n   547\t    (is (conforms? batch 4 obs))))\n   548\t\n   549\t\n   550\t(deftest blocked-write-conformance-test\n   551\t  (let [batch (assemble (segment 8)\n   552\t                        (instruction 0 :stream-make :yin.code/buffer 1)\n   553\t                        (instruction 1 :push)\n   554\t                        (instruction 2 :push)\n   555\t                        (instruction 3 :const :yin.code/value :a)\n   556\t                        (instruction 4 :stream-put)\n   557\t                        (instruction 5 :const :yin.code/value :b)\n   558\t                        (instruction 6 :stream-put)\n   559\t                        (instruction 7 :halt))\n   560\t        obs (observe-park (make-vm {:make-stream one-slot-writer}) batch 6)]\n   561\t    (is (vm/blocked? (:vm obs)))\n   562\t    (is (= :put (:reason (:frame obs))))\n   563\t    (is (= 1 (:depth obs)) \"one target ref remains below the popped one\")\n   564\t    (is (conforms? batch 6 obs))))\n   565\t\n   566\t\n   567\t(deftest ffi-call-conformance-test\n   568\t  (let [batch (assemble (segment 6)\n   569\t                        (instruction 0 :const :yin.code/value 1)\n   570\t                        (instruction 1 :push)\n   571\t                        (instruction 2 :const :yin.code/value 2)\n   572\t                        (instruction 3 :push)\n   573\t                        (instruction 4 :ffi-call :yin.code/ffi-op :op/add\n   574\t                                     :yin.code/argc 1)\n   575\t                        (instruction 5 :halt))\n   576\t        obs (observe-park (make-vm) batch 4)]\n   577\t    (is (vm/blocked? (:vm obs)))\n   578\t    (is (= 2 (:depth obs)))\n   579\t    (is (= [1] (:stack (:frame obs))) \"the argument is popped, not the 1\")\n   580\t    (is (conforms? batch 4 obs))))\n   581\t\n   582\t\n   583\t(deftest effectful-call-conformance-test\n   584\t  (let [blocking-next (fn [cursor] {:effect :stream/next, :cursor cursor})\n   585\t        batch (assemble (segment 7)\n   586\t                        (instruction 0 :var :yin.code/name 'blocking-next)\n   587\t                        (instruction 1 :push)\n   588\t                        (instruction 2 :stream-make :yin.code/buffer 8)\n   589\t                        (instruction 3 :stream-cursor)\n   590\t                        (instruction 4 :push)\n   591\t                        (instruction 5 :call :yin.code/argc 1\n   592\t                                     :yin.code/tail? false)\n   593\t                        (instruction 6 :halt))\n   594\t        obs (observe-park (make-vm {:primitives {'blocking-next blocking-next}})\n   595\t                          batch 5)]\n   596\t    (is (vm/blocked? (:vm obs)))\n   597\t    (is (= :next (:reason (:frame obs))))\n   598\t    (is (= 2 (:depth obs)) \"operator and cursor were on the stack\")\n   599\t    (is (= [] (:stack (:frame obs))))\n   600\t    (is (conforms? batch 5 obs))))\n   601\t\n   602\t\n   603\t;; =============================================================================\n   604\t;; The dynamic half rides in the frame\n   605\t;; =============================================================================\n   606\t\n   607\t(deftest activation-state-and-requirements-test\n   608\t  (let [v [[:stream-make 8] [:stream-cursor] [:stream-next] [:push]\n   609\t           [:var 'q] [:push] [:var '+] [:halt]]\n   610\t        sp (ucf/safepoint-at v 3)\n   611\t        frame {:segment seg, :pc 3, :env {'q 1, 'r 2},\n   612\t               :stack [:x :y], :k [{:type :return, :stack-base 1}]}]\n   613\t    (testing \"Static: what the code will read\"\n   614\t      (is (= '[+ q] (:yin.safepoint/lexically-required sp))))\n   615\t    (testing \"Dynamic: depth, bound names and bases come from the frame\"\n   616\t      (is (= {:yin.k/depth 2, :yin.k/bound '[q r], :yin.k/stack-bases [1]}\n   617\t             (ucf/activation-state frame))))\n   618\t    (testing \"A requirement is met by E or by the rest of resolution\"\n   619\t      (is (= '[+] (ucf/unsatisfied-names sp frame (constantly false))))\n   620\t      (is (= '[] (ucf/unsatisfied-names sp frame #{'+})))\n   621\t      (is (= '[+ q]\n   622\t             (ucf/unsatisfied-names sp {:env {}} (constantly false)))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '95,520p' src/cljc/yin/vm/ucf.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '95,520p' src/cljc/yin/vm/ucf.cljc\"","aggregated_output":"   vector, naming the offending place (`:yin.k/path`) and the defect.\"\n  [path defect hint]\n  {:yin.k/status :yin.k/non-portable,\n   :yin.k/kind :non-canonicalizable,\n   :yin.k/path path,\n   :yin.k/defect defect,\n   :yin.k/hint hint})\n\n\n(defn- refuse\n  [path defect hint]\n  (throw (ex-info (str \"Cannot canonicalize segment: \" hint)\n                  (refusal path defect hint))))\n\n\n(defn- resolved-batch\n  \"The loader's reading of a batch: `{:seg :attrs :instructions}` with\n   instructions in pc order. A batch that is not well formed (S2.6) is not\n   a segment, and is refused with the loader's own defect.\"\n  [datoms]\n  (when-let [defect (code/well-formed? datoms)]\n    (refuse [:entity (:entity defect)]\n            defect\n            (str \"the batch is not well formed: \" (name (:rule defect)))))\n  (let [[order attrs] (index-batch datoms)\n        seg (some #(when (= :segment (get-in attrs [% :yin.code/type])) %)\n                  order)\n        instructions (filterv (fn [e]\n                                (and (not= seg e)\n                                     (some #(contains? (get attrs e) %)\n                                           structural-attrs)))\n                              order)]\n    {:seg seg, :attrs attrs, :instructions instructions}))\n\n\n(defn- check-segment-entity\n  [seg attrs]\n  (let [extra (remove segment-attrs (keys (get attrs seg)))]\n    (when (seq extra)\n      (refuse [:entity seg]\n              {:rule :segment-attribute, :entity seg, :attrs (vec extra)}\n              \"the segment entity carries an attribute with no slot\"))))\n\n\n(defn- canonical-tuple\n  \"One instruction's tuple: the mnemonic, then its S2.4 operands in table\n   order, refs resolved to pcs and defaults materialized. Refused when the\n   mnemonic has no tuple or the instruction carries an operand its tuple\n   has no slot for.\"\n  [pc-of pc e ia]\n  (let [mnem (:yin.code/op ia)\n        operands (get code/vector-operand-table mnem)]\n    (when-not operands\n      (refuse [:pc pc]\n              {:rule :mnemonic, :pc pc, :entity e, :op mnem}\n              \"the mnemonic is outside the S2.4 table\"))\n    (let [slots (into #{} (map first) operands)\n          extra (remove (fn [a]\n                          (or (structural-attrs a)\n                              (excluded-instruction-attrs a)\n                              (slots a)))\n                        (keys ia))]\n      (when (seq extra)\n        (refuse [:pc pc]\n                {:rule :operand-slot, :pc pc, :entity e, :attrs (vec extra)}\n                \"the instruction carries an operand its tuple has no slot for\"))\n      (into [mnem]\n            (map (fn [[a kind]]\n                   (let [v (get ia a)]\n                     (cond\n                       (= :pc kind)\n                       (or (get pc-of v)\n                           (refuse [:pc pc]\n                                   {:rule :dangling-target, :pc pc,\n                                    :entity e, :ref v}\n                                   \"a ref resolves to no instruction\"))\n                       (nil? v) (get saturation-defaults [mnem a])\n                       :else v))))\n            operands))))\n\n\n(defn batch->canonical-instruction-vector\n  \"The canonical instruction vector (S7.3.2) of one `:yin.code/*` segment\n   batch, or a thrown `:yin.k/non-portable` refusal (`refusal`, kind\n   `:non-canonicalizable`) when the batch has none.\n\n   The batch is read through the loader's resolved interpretation, so two\n   batches that execute alike canonicalize alike: entity ids, datom order\n   within an entity, provenance, and omitted defaulted operands leave the\n   vector unchanged; a repeated attribute keeps its last value. The result\n   is checked against the S7.5 tuple grammar before it is returned, so a\n   vector this function yields is always one `load-vector` accepts.\"\n  [datoms]\n  (let [{:keys [seg attrs instructions]} (resolved-batch datoms)\n        pc-of (zipmap instructions (range))]\n    (check-segment-entity seg attrs)\n    (let [v (into []\n                  (map-indexed (fn [pc e]\n                                 (canonical-tuple pc-of pc e (get attrs e))))\n                  instructions)]\n      (when-let [defect (code/well-formed-vector? v)]\n        (refuse [:pc (:pc defect)]\n                defect\n                (str \"the resolved tuple is not admissible: \"\n                     (name (:rule defect)))))\n      v)))\n\n\n(defn code-address\n  \"`:yin.code/hash` of a canonical vector: its `dao.jing` segment address.\n   UCF mints no second addressing scheme.\"\n  [v]\n  (jing/segment-key v))\n\n\n(defn canonicalize\n  \"Code identity as one S7.9 outcome. On success\n   `{:yin.k/status :yin.k/ok, :yin.code/vector v, :yin.code/hash address,\n   :yin.k/contract contract-stamp}`; otherwise the `refusal` map the\n   vector function would have thrown.\"\n  [datoms]\n  (try\n    (let [v (batch->canonical-instruction-vector datoms)]\n      {:yin.k/status :yin.k/ok,\n       :yin.code/vector v,\n       :yin.code/hash (code-address v),\n       :yin.k/contract contract-stamp})\n    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n      (let [data (ex-data e)]\n        (if (= :yin.k/non-portable (:yin.k/status data))\n          data\n          (throw e))))))\n\n\n;; =============================================================================\n;; Safepoints (S7.4)\n;; =============================================================================\n\n(def transitions\n  \"Every S2.4 mnemonic classified by what its S4.2 transition does to\n   control. `:step` continues at pc+1; `:jump`, `:branch` and `:transfer`\n   move control (a `:resume` restores a parked configuration, so its\n   successor is not pc+1); `:terminal` leaves no successor; `:parking` may\n   leave the machine parked with a canonical configuration at pc+1 -- the\n   safepoints of S7.4.1. `:call` is parking because the operator may be a\n   primitive whose result is a blocking effect; `:current-continuation`\n   is a step, not a safepoint (it reifies and continues).\"\n  {:const :step,\n   :var :step,\n   :closure :step,\n   :push :step,\n   :gensym :step,\n   :store-get :step,\n   :store-put :step,\n   :stream-make :step,\n   :stream-cursor :step,\n   :stream-close :step,\n   :current-continuation :step,\n   :jump :jump,\n   :branch-false :branch,\n   :resume :transfer,\n   :return :terminal,\n   :halt :terminal,\n   :park :parking,\n   :stream-next :parking,\n   :stream-put :parking,\n   :ffi-call :parking,\n   :call :parking})\n\n\n(def ^:private parking-reasons\n  \"S7.4.1's safepoint kinds, by parking mnemonic. An `:ffi-call` parks\n   under two reasons -- sent, or retained while the request is in hand --\n   at one safepoint.\"\n  {:park [:park],\n   :stream-next [:next],\n   :stream-put [:put],\n   :ffi-call [:ffi :ffi-request],\n   :call [:call-effect]})\n\n\n(defn stack-effect\n  \"Delta |St| across one parking instruction, from the tuple alone\n   (S7.4.1's `Stack in frame` column): a park and a blocked read leave St;\n   a blocked write has popped its target; an FFI call its arguments; an\n   effectful call its operator and arguments.\"\n  [t]\n  (case (nth t 0)\n    :park 0\n    :stream-next 0\n    :stream-put -1\n    :ffi-call (- (nth t 2))\n    :call (- (inc (nth t 1)))\n    nil))\n\n\n(defn- successors\n  \"The pcs control may reach next from `pc`, with the names bound on the\n   way: a closure's body is entered with its params bound, everything else\n   keeps the current binding set.\"\n  [v pc bound]\n  (let [t (nth v pc)\n        mnem (nth t 0)]\n    (case (get transitions mnem)\n      :step (if (= :closure mnem)\n              [[(inc pc) bound] [(nth t 2) (into bound (nth t 1))]]\n              [[(inc pc) bound]])\n      :parking [[(inc pc) bound]]\n      :jump [[(nth t 1) bound]]\n      :branch [[(inc pc) bound] [(nth t 1) bound]]\n      [])))\n\n\n(defn lexically-required\n  \"The names the code reachable from `pc` reads from E, from the vector\n   alone (S7.4.2): every `:var` name on a control path from `pc` --\n   through fall-through, jumps, branches, and the bodies of closures\n   created on the way -- minus the names those closures bind. Callees are\n   values, not code reachable here: a closure already on the stack carries\n   its own captured environment, which is the frame's business. Sorted by\n   name so the result is a stable value.\"\n  [v pc]\n  (loop [work [[pc #{}]]\n         seen #{}\n         names #{}]\n    (if-let [[p bound :as item] (peek work)]\n      (let [work (pop work)]\n        (if (contains? seen item)\n          (recur work seen names)\n          (let [t (nth v p)\n                names (if (and (= :var (nth t 0))\n                               (not (contains? bound (nth t 1))))\n                        (conj names (nth t 1))\n                        names)]\n            (recur (into work (successors v p bound))\n                   (conj seen item)\n                   names))))\n      (vec (sort-by str names)))))\n\n\n(defn safepoints\n  \"The static safepoint map of one canonical vector (S7.4.2): one entry per\n   parking instruction, each carrying only what the vector alone fixes --\n   the parking pc, the canonical resume pc (pc+1, always inside the segment\n   by S2.6), the reasons under which the machine parks there, the stack\n   effect across the instruction, and the lexically required names at the\n   resume pc. Absolute depth, activation bases, captured environments and\n   physical layouts are not here: they ride in the frame\n   (`activation-state`).\"\n  [v]\n  (into []\n        (keep-indexed\n          (fn [pc t]\n            (when (= :parking (get transitions (nth t 0)))\n              {:yin.safepoint/at pc,\n               :yin.safepoint/pc (inc pc),\n               :yin.safepoint/reasons (get parking-reasons (nth t 0)),\n               :yin.safepoint/stack-effect (stack-effect t),\n               :yin.safepoint/lexically-required\n               (lexically-required v (inc pc))})))\n        v))\n\n\n(defn safepoint-table\n  \"`safepoints` published per segment, keyed by the code's address and the\n   engine profile that derived it (the reference machine by default).\"\n  ([v] (safepoint-table v :yin.vm.semantic/reference))\n  ([v engine]\n   {:yin.safepoint/segment (code-address v),\n    :yin.safepoint/engine engine,\n    :yin.safepoint/safepoints (safepoints v)}))\n\n\n(defn safepoint-at\n  \"The static safepoint entry whose canonical resume pc is `pc`, or the\n   S7.9 `:yin.k/not-at-safepoint` outcome naming the pc.\"\n  [v pc]\n  (or (some #(when (= pc (:yin.safepoint/pc %)) %) (safepoints v))\n      {:yin.k/status :yin.k/not-at-safepoint, :yin.k/pc pc}))\n\n\n(defn activation-state\n  \"The dynamic half of a parked configuration, read off a frame -- a wait\n   entry or parked record `{segment pc env stack k}` -- never derived from\n   code: the absolute operand-stack depth, the names E actually binds, and\n   each return frame's activation base.\"\n  [frame]\n  {:yin.k/depth (count (:stack frame)),\n   :yin.k/bound (vec (sort-by str (keys (:env frame)))),\n   :yin.k/stack-bases (mapv :stack-base (:k frame))})\n\n\n(defn unsatisfied-names\n  \"The lexically required names of a static safepoint that the frame's\n   environment does not bind and that `resolvable` (store, primitives,\n   modules -- the rest of `resolve-var`'s order) does not answer: the\n   conformance check that a frame carries what its code will read.\"\n  [safepoint frame resolvable]\n  (vec (remove (fn [n]\n                 (or (contains? (:env frame) n) (resolvable n)))\n               (:yin.safepoint/lexically-required safepoint))))\n","exit_code":0,"status":"completed"}}
