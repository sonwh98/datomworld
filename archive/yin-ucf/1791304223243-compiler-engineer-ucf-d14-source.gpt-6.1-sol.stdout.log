{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat /private/tmp/d14-record-probe.log; sed -n '2450,2490p' test/yin/vm/ucf/holder/driver_test.cljc; rg --files docs/design | rg 'ucf|journal'; rg -n 'round.trip|cbor|record' test/yin/vm/ucf/holder/export_test.cljc | tail -20; sed -n '1,130p' /private/tmp/d14-initial.diff\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat /private/tmp/d14-record-probe.log; sed -n '2450,2490p' test/yin/vm/ucf/holder/driver_test.cljc; rg --files docs/design | rg 'ucf|journal'; rg -n 'round.trip|cbor|record' test/yin/vm/ucf/holder/export_test.cljc | tail -20; sed -n '1,130p' /private/tmp/d14-initial.diff\"","aggregated_output":"Loading initial Timbre config from: :default\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n:encoding-error \"dao.jing.cbor refused: unsupported-value (class yin.vm.values.Closure)\" {:dao.jing.cbor/refusal :unsupported-value, :detail \"class yin.vm.values.Closure\"}\n                          [:occurrences o :dao.lease/lease]))\n            \"no lease was ever granted\")))))\n\n\n;; =============================================================================\n;; D14: abort over the journaled attempts; the enrollment discipline\n;; =============================================================================\n\n(deftest abort-reads-the-journaled-offer-attempts-test\n  (testing \"before any offer attempt: local execution restored\"\n    (let [machine (source-machine)\n          w (world :holders [\"holder-a\"])\n          d (nth (iterate #(step-source w %)\n                          (source-driver w \"holder-a\" machine nil))\n                 2)\n          _ (is (= [:yin.k/minted :yin.k/fenced]\n                   (kinds-of (:journal-frames d))))\n          aborted (driver/abort (:state d))]\n      (is (= :aborted (:phase aborted)))\n      (is (= :yin.k/ok (:status aborted)))\n      (is (= (:wait-set machine)\n             (:wait-set (:machine aborted))))\n      (is (= :running (vm/gate-mode (:machine aborted)))\n          \"the old local machine, as it was\")))\n  (testing \"a provably unappended attempt may still abort\"\n    (let [machine (source-machine)\n          w (world :holders [\"holder-a\"]\n                   :inbound {\"holder-a\" (bounded-stream \"in-a\" 1)})\n          d (source-driver w \"holder-a\" machine nil)\n          _ (stream/append! (get (:inbounds w) \"holder-a\") :blocked)\n          d4 (nth (iterate #(step-source w %) d) 4)\n          _ (is (= [:dao.stream/full]\n                   (mapv :yin.k/append\n                         (filter #(= :yin.k/attempt (:yin.k/journal %))\n                                 (journal-of (:journal-frames d4))))))\n          aborted (driver/abort (:state d4))]\n      (is (= :aborted (:phase aborted)))\n      (is (= (:wait-set machine) (:wait-set (:machine aborted)))))))\n  (testing \"an admitted offer never restores local execution\"\n    (let [machine (source-machine)\n          w (world :holders [\"holder-a\"])\ndocs/design/yin.vm.ucf-revisions.md\ndocs/design/dao.stream.journal.md\n491:        refused (export/prepare m' record stingy nil)]\n493:    (is (= 1 (count (get-in refused [:record :served]))))\n494:    (testing \"a retry with the returned record never re-serves that stream\"\n497:            retry (export/prepare m' (:record refused)\n508:  \"A real machine at an explicit park, its record's environment holding\n517:(deftest an-explicit-park-travels-in-the-record-test\n519:        {m' :machine record :record} (export/enter m)\n521:        prepared (export/prepare m' record serve! nil)]\n522:    (is (seq (:parked m)) \"the source holds a parked record\")\n523:    (is (seq (:parked record)) \"the record holds it\")\n524:    (is (every? #(not (contains? (:parked m') %)) (keys (:parked record)))\n528:    (let [e (export/encode m' (:record prepared))]\n531:    (is (= m (:machine (export/abort m' record [] nil)))\n535:(deftest an-install-childs-parked-records-stay-in-the-child-test\n539:        {m' :machine record :record :as r} (export/enter m)]\n542:        \"the child's parked records are not moved\")\n543:    (is (not-any? #(contains? (:parked record) %) (keys parked)))))\n547:  (let [[m record _] (exporting (parked-machine))\n548:        restored (:machine (export/abort m record [] nil))]\n550:           (:yin.k/status (export/abort restored record [] nil))))))\ndiff --git a/src/cljc/yin/vm/ucf/holder/driver.cljc b/src/cljc/yin/vm/ucf/holder/driver.cljc\nindex cce9a6a4..5915e7b8 100644\n--- a/src/cljc/yin/vm/ucf/holder/driver.cljc\n+++ b/src/cljc/yin/vm/ucf/holder/driver.cljc\n@@ -1,9 +1,12 @@\n (ns yin.vm.ucf.holder.driver\n-  \"The candidate half of the custody driver of M-next D slice D13 (UCF\n-   7.7.2 to 7.7.8, 7.8, 7.9; r3 1.5, 1.6 and 1.7; the D10 lower-inputs\n-   ruling; linker-dht 14.2.2): one explicit composition-local step state,\n-   stepped by the composition, that carries a candidate from bytes to a\n-   task under custody and then drives that task's run.\n+  \"The custody driver of M-next D slices D13 and D14 (UCF 7.7.2 to\n+   7.7.8, 7.8, 7.9; r3 1.5, 1.6, 1.7, 1.8, 1.9 and 1.10; the D9 header\n+   and D10 lower-inputs rulings; linker-dht 14.2.2): one explicit\n+   composition-local step state, stepped by the composition, that\n+   carries a candidate from bytes to a task under custody, drives that\n+   task's run, and -- D14 -- carries the source half (a first export\n+   and its offer) and the exit half (the successor, the report, the\n+   release and the closure) over a write-ahead progress journal.\n \n    The driver reaches the authority through exactly the three remote\n    paths of r3 1.5, all composition-supplied functions: the front's\n@@ -63,26 +66,56 @@\n    stays regrantable under the ordinary policy.\n \n    :safepoint -- the machine has nothing left to drive (halted, no wait\n-   entry, no queued work); the exit half (D14) owns what follows.\n-   Tenure is still held: renewal and the recheck continue.\n+   entry, no queued work); the exit half (D14) owns what follows, under\n+   tenure that is still held: renewal and the recheck continue while it\n+   runs, and all IO stops at the bound.\n \n    :releasing -- a pending release is retried with the identical\n    request until authenticated carriage is acknowledged, then its failure is\n    the driver's answer.  :failed is terminal.\n \n+   The D14 phases and entries beside these:\n+\n+   :exporting -- the source half over a machine the composition hands\n+   the driver (`source`, below): enter exporting, mint the occurrence\n+   once and journal it before prepare (the D9 ruling), prepare, encode,\n+   put the prepared record and the body bytes in the content store,\n+   journal the fenced record, then the bracketed offer -- an intent\n+   record durable before each send, an attempt record after it, an\n+   acknowledgment once the front's authenticated reply admits the offer.\n+   A nil :arbitration in the config is the composition's fork decision:\n+   the lift is version 0, nothing is minted, offered or journaled, and\n+   the driver answers the bytes (:lifted).\n+\n+   :exiting -- the exit half of a restarted holder, journaled but\n+   machine-less: it resends the report and the release and watches the\n+   ledger for the closure; a live driver runs the same exit body from\n+   :safepoint instead, under its own tenure.\n+\n+   :exited -- the exit completed: the report committed, the release\n+   carried, the closure observed and, for a continuation, the\n+   successor's offer admitted.  :lifted and :aborted are the fork's and\n+   a legal abort's terminals.  :stalled is an uncertain journal append:\n+   everything stops -- program steps and sends alike -- until the\n+   composition reopens the journal and reconciles through `reopen`.\n+\n    The source is a candidate like any other: the driver holds bytes,\n    never the source's local machine, so the source itself resumes only\n    through a grant to itself, never on data.  No transport is known\n    here; the machine's own resource handles are the only ones touched,\n    by the writer and the reader.\"\n-  (:require [dao.lease :as lease]\n+  (:require [dao.jing :as jing]\n+            [dao.jing.cbor :as cbor]\n+            [dao.lease :as lease]\n             [dao.stream :as stream]\n             [yin.vm :as vm]\n+            [yin.vm.ucf.authority.completion :as completion]\n             [yin.vm.ucf.authority.front :as front]\n             [yin.vm.ucf.checkpoint :as checkpoint]\n             [yin.vm.ucf.custody :as custody]\n             [yin.vm.ucf.handoff :as handoff]\n             [yin.vm.ucf.holder.evidence :as evidence]\n+            [yin.vm.ucf.holder.export :as export]\n             [yin.vm.ucf.holder.reader :as reader]\n             [yin.vm.ucf.holder.writer :as writer]\n             [yin.vm.ucf.ledger :as ledger]))\n@@ -100,7 +133,11 @@\n (def ^:private seams\n   \"The composition-supplied functions the driver steps through.\"\n   [:append-request! :read-reply! :read-outcome! :read-ledger!\n-   :clock :observe! :append-diagnostic! :attach!])\n+   :clock :observe! :append-diagnostic! :attach! :serve!])\n+\n+(def ^:private optional-seams\n+  \"Composition-supplied functions the driver uses only when asked.\"\n+  [:enroll!])\n \n \n (defn- check!\n@@ -128,6 +165,72 @@\n             {:renewal-interval interval})))\n \n \n+(defn- check-common!\n+  \"The checks every driver constructor runs: the identity, the\n+   protection declaration, the receiving machine, the renewal interval,\n+   the fn seams, the progress journal, the content store and the carrier\n+   medium -- the D14 seams beside the D13 ones.  A candidate that never\n+   exits still carries them: a grant may make it a holder whose run\n+   ends in an exit.\"\n+  [config units]\n+  (check! (some? (:me config)) \"an identity: the holder a grant would name\"\n+          {:me (:me config)})\n+  (check! (and (map? (:protection config))\n+               (every? classes (vals (:protection config))))\n+          \"a protection declaration over the three classes\"\n+          {:protection (:protection config)})\n+  (check! (map? (:receiver config)) \"a receiving machine\" {})\n+  (check-interval! units (:renewal-interval config))\n+  (doseq [s seams]\n+    (check! (fn? (get config s)) (str \"the seam \" (name s)) {}))\n+  (doseq [s optional-seams\n+          :when (some? (get config s))]\n+    (check! (fn? (get config s)) (str \"the seam \" (name s)) {}))\n+  (check! (some? (get config :journal))\n+          \"a progress journal: a dao.stream.journal handle\" {})\n+  (check! (and (map? (:store config))\n+               (fn? (:put-bytes-fn (:store config)))\n+               (fn? (:get-bytes-fn (:store config))))\n+          \"a content store: a dao.jing byte-store handle\"\n+          {})\n+  (check! (some? (:medium config)) \"a carrier medium name\" {}))\n+\n+\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^'\"\\\\(defn|\"'^'\"\\\\(defprotocol' src/cljc/yin/vm/values.cljc src/cljc/yin/vm/ucf/handoff.cljc src/cljc/yin/vm/completion.cljc | head -100; rg -n 'record.*round|round.*record|record-round|served.*canonical' test/yin/vm/ucf/handoff_v1_test.cljc; rg -n 'restart|enrollment carries|uncertain|7\\\\.7\\\\.4|7\\\\.7\\\\.7' docs/design/yin.vm.ucf-revisions.md | head -25; rg -n '###.*7\\\\.7|####.*7\\\\.7' docs/design/*.md | head\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
