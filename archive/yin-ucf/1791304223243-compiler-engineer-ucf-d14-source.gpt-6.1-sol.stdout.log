nsrc/cljc/yin/vm/completion.cljc:416:(defn- pull-record\nsrc/cljc/yin/vm/completion.cljc:434:(defn- pull-parked\nsrc/cljc/yin/vm/completion.cljc:450:(defn- module-of\nsrc/cljc/yin/vm/completion.cljc:469:(defn discharge\nsrc/cljc/yin/vm/completion.cljc:505:(defn- apply-value-facts\nsrc/cljc/yin/vm/completion.cljc:525:(defn- apply-code-facts\nsrc/cljc/yin/vm/completion.cljc:554:(defn- queue-pop\nsrc/cljc/yin/vm/completion.cljc:559:(defn- queue-peek\nsrc/cljc/yin/vm/completion.cljc:564:(defn- initial-state\nsrc/cljc/yin/vm/completion.cljc:591:(defn- ensure-code\nsrc/cljc/yin/vm/completion.cljc:612:(defn- ensure-context\nsrc/cljc/yin/vm/completion.cljc:619:(defn- analyze\nsrc/cljc/yin/vm/completion.cljc:632:(defn- drain\nsrc/cljc/yin/vm/completion.cljc:644:(defn- seed\nsrc/cljc/yin/vm/completion.cljc:676:(defn- verify\nsrc/cljc/yin/vm/completion.cljc:692:(defn discovery\nsrc/cljc/yin/vm/completion.cljc:701:(defn walk\nsrc/cljc/yin/vm/completion.cljc:720:(defn complete\nsrc/cljc/yin/vm/ucf/handoff.cljc:89:(defn- refuse!\nsrc/cljc/yin/vm/ucf/handoff.cljc:95:(defn- non-portable!\nsrc/cljc/yin/vm/ucf/handoff.cljc:100:(defn- unsatisfied!\nsrc/cljc/yin/vm/ucf/handoff.cljc:108:(defn- undecodable!\nsrc/cljc/yin/vm/ucf/handoff.cljc:113:(defn- not-at-safepoint!\nsrc/cljc/yin/vm/ucf/handoff.cljc:118:(defn- outcome\nsrc/cljc/yin/vm/ucf/handoff.cljc:125:(defn- call!\nsrc/cljc/yin/vm/ucf/handoff.cljc:139:(defn- scalar?\nsrc/cljc/yin/vm/ucf/handoff.cljc:145:(defn- local-identity\nsrc/cljc/yin/vm/ucf/handoff.cljc:154:(defn- marker-for!\nsrc/cljc/yin/vm/ucf/handoff.cljc:185:(defn- portable-cursor\nsrc/cljc/yin/vm/ucf/handoff.cljc:197:(defn- cell-at!\nsrc/cljc/yin/vm/ucf/handoff.cljc:225:(defn- cell-for!\nsrc/cljc/yin/vm/ucf/handoff.cljc:240:(defn- new-found\nsrc/cljc/yin/vm/ucf/handoff.cljc:245:(defn- ordered\nsrc/cljc/yin/vm/ucf/handoff.cljc:259:(defn- canonical-order\nsrc/cljc/yin/vm/ucf/handoff.cljc:285:(defn- encode-primitive\nsrc/cljc/yin/vm/ucf/handoff.cljc:304:(defn- value-encoder\nsrc/cljc/yin/vm/ucf/handoff.cljc:385:(defn- seg-address!\nsrc/cljc/yin/vm/ucf/handoff.cljc:395:(defn- encode-env\nsrc/cljc/yin/vm/ucf/handoff.cljc:405:(defn- encode-frame\nsrc/cljc/yin/vm/ucf/handoff.cljc:418:(defn- encode-registers\nsrc/cljc/yin/vm/ucf/handoff.cljc:431:(defn- decode-env\nsrc/cljc/yin/vm/ucf/handoff.cljc:436:(defn- decode-frame\nsrc/cljc/yin/vm/ucf/handoff.cljc:447:(defn- decode-registers\nsrc/cljc/yin/vm/ucf/handoff.cljc:481:(defn- observed-wire\nsrc/cljc/yin/vm/ucf/handoff.cljc:496:(defn- safepoint-kinds-at\nsrc/cljc/yin/vm/ucf/handoff.cljc:517:(defn- held?\nsrc/cljc/yin/vm/ucf/handoff.cljc:522:(defn- unliftable-hold\nsrc/cljc/yin/vm/ucf/handoff.cljc:557:(defn- protected!\nsrc/cljc/yin/vm/ucf/handoff.cljc:595:(defn- call-out-cell\nsrc/cljc/yin/vm/ucf/handoff.cljc:608:(defn- lift-pending!\nsrc/cljc/yin/vm/ucf/handoff.cljc:680:(defn- lift-frame!\nsrc/cljc/yin/vm/ucf/handoff.cljc:709:(defn- portable-response?\nsrc/cljc/yin/vm/ucf/handoff.cljc:718:(defn- export-installs\nsrc/cljc/yin/vm/ucf/handoff.cljc:753:(defn- module-decls\nsrc/cljc/yin/vm/ucf/handoff.cljc:763:(defn- export-refusals\nsrc/cljc/yin/vm/ucf/handoff.cljc:773:(defn- snapshot-module-stores\nsrc/cljc/yin/vm/ucf/handoff.cljc:789:(defn- bytes-address\nsrc/cljc/yin/vm/ucf/handoff.cljc:799:(defn- header-of\nsrc/cljc/yin/vm/ucf/handoff.cljc:815:(defn export-task\nsrc/cljc/yin/vm/ucf/handoff.cljc:1031:(defn- marker?\nsrc/cljc/yin/vm/ucf/handoff.cljc:1038:(defn- tagged-of\nsrc/cljc/yin/vm/ucf/handoff.cljc:1054:(defn- cell-ids-of\nsrc/cljc/yin/vm/ucf/handoff.cljc:1062:(defn- check-cell\nsrc/cljc/yin/vm/ucf/handoff.cljc:1068:(defn- require-keys\nsrc/cljc/yin/vm/ucf/handoff.cljc:1075:(defn- validate-pending\nsrc/cljc/yin/vm/ucf/handoff.cljc:1121:(defn- validate-registers\nsrc/cljc/yin/vm/ucf/handoff.cljc:1144:(defn- check-frame-pc\nsrc/cljc/yin/vm/ucf/handoff.cljc:1166:(defn- validate-frames\nsrc/cljc/yin/vm/ucf/handoff.cljc:1191:(defn- reachable-values\nsrc/cljc/yin/vm/ucf/handoff.cljc:1212:(defn- referenced-cells\nsrc/cljc/yin/vm/ucf/handoff.cljc:1230:(defn validate-body\nsrc/cljc/yin/vm/ucf/handoff.cljc:1364:(defn- fresh-key\nsrc/cljc/yin/vm/ucf/handoff.cljc:1373:(defn- body-markers\n338:    uncertainty separated from terminal refusal; epoch exhaustion\n373:    recorded), 7.7.6 (the halted result), 7.7.7 (the reopen steps),\n388:    C12 sentences in 7.7.7 (enrollment retry), 7.11.1 (the stage-C\n391:    sentences in 7.7.4 (the gate modes, the custody holds, the header\ndocs/design/yin.vm.code-as-tuples.md:1242:### 7.7 Dependency closure is Datalog over the tuples\ndocs/design/yin.vm.code-as-tuples.md:1328:#### 7.7.1 Effect normalization: the footprint table\ndocs/design/yin.vm.code-as-tuples.md:1407:#### 7.7.2 Name obligations are resolved per store slice, and completion is conservative\ndocs/design/yin.vm.code-as-tuples.md:1455:#### 7.7.3 The fixed point converges over work items, not addresses\ndocs/design/yin.vm.universal-continuation-format.md:1561:### 7.7.1 The race, named\ndocs/design/yin.vm.universal-continuation-format.md:1576:### 7.7.2 Custody facts, and their dispatch keys\ndocs/design/yin.vm.universal-continuation-format.md:1655:### 7.7.3 The authority: what the grantor possesses\ndocs/design/yin.vm.universal-continuation-format.md:1701:### 7.7.4 The exporting state: fencing the source before publication\ndocs/design/yin.vm.universal-continuation-format.md:1822:### 7.7.5 Fencing effects: epochs, operation ids, and what exactly-once costs\ndocs/design/yin.vm.universal-continuation-format.md:1906:### 7.7.6 Successors and chains\n","exit_code":0,"status":"completed"}}
