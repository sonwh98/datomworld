{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '480,520p' src/cljc/yin/vm/ucf/holder/writer.cljc; sed -n '1920,1955p' src/cljc/yin/vm/ucf/holder/driver.cljc; rg -n 'deftest (control|program|stop|.*tenure|.*grant|.*binding)' test/yin/vm/ucf/holder/driver_test.cljc; sed -n '1050,1250p' test/yin/vm/ucf/holder/driver_test.cljc\"","aggregated_output":"      (retained machine :incarnation)\n      (settle machine path entry record))\n    (retained machine :no-entry)))\n\n\n(defn discharge\n  \"Outcome `record`, read from a stream the composition attributed to\n   `author`, against `machine`'s unfinished writes.  The record counts\n   only when `front/reply-evidence` authenticates it -- the author is\n   the arbitration identity, by identity equality -- and then, for a\n   reply, when the five match fields hold, or, for a projected\n   admission outcome, when its op id and incarnation match the entry.\n   Anything else, from any other author a forged `:committed` or\n   `:intent-conflict` included, discharges nothing.\n\n   Answers `{:machine m :discharged {...} | nil :run-end {...} | nil}`\n   with `::retain reason` naming why nothing was applied: the five\n   fields' own reasons, `:no-entry` (no unfinished write carries the op\n   id), `:suspended`, or `:not-running` (the run has ended; every apply\n   refuses a late result).  A machine that holds no custody map is a\n   caller defect.\"\n  [machine author record]\n  (when-not (map? (:yin.k/custody machine))\n    (throw (ex-info \"Discharge over a task that holds no custody\"\n                    {:yin.k/hint :no-custody})))\n  (if (not= :running (vm/gate-mode machine))\n    (retained machine :not-running)\n    (let [custody (:yin.k/custody machine)\n          evidence (front/reply-evidence (arbitration-id custody)\n                                         author record)]\n      (if (contains? evidence ::front/no-evidence)\n        (retained machine (::front/no-evidence evidence))\n        (if (contains? record :yin.k/reply)\n          (discharge-reply machine custody record)\n          (discharge-projected machine custody record))))))\n\n\n;; =============================================================================\n;; Drain: the composition's outcome reader\n;; =============================================================================\n\n                         (update-in [:inbox :program] #(vec (rest %)))))))))\n      state)))\n\n\n(defn- drain\n  [state mode]\n  (let [state (if (contains? #{:program :control-buffered} mode) state (collect-inbox state))]\n    (if (or (contains? #{:control :control-buffered} mode) (:stopped? state) (:inbox-unavailable? state)\n            (not (contains? #{:running :safepoint} (:phase state))))\n      state\n      (apply-program-inbox state))))\n\n\n(defn- activate\n  [state]\n  (let [{checked :state projection :projection proof :proof} (binding-check state)]\n    (if-not projection\n      checked\n      (let [checked (assoc checked :evidence proof)\n            result (lower checked (:lease checked) (:holder checked)\n                          proof (clock checked))]\n        (if (= :ok (:status result))\n          (assoc checked :phase :running :machine (:vm result))\n          (releasing checked (:yin.k/status result)\n                     (dissoc result :yin.k/status) (:lease checked)))))))\n\n\n(defn- require-tenure!\n  [state]\n  (when-not (lease/holding? (:holder state) (clock state))\n    (throw (ex-info \"Program IO past lease bound\" {::cause :lease-bound}))))\n\n\n(defn- guarded-handle\n  [state handle]\n  (reify\n681:(deftest paused-grant-and-delayed-activation-test\n701:(deftest control-isolation-and-renewal-test\n741:(deftest paused-grant-renewal-keeps-the-original-observation-basis-test\n757:(deftest independent-program-tenure-test\n776:(deftest shutdown-before-grant-never-lowers-test\n1084:(deftest control-does-not-apply-a-real-regrant-prefix-test\n1370:(deftest invalid-bindings-answer-not-holder-and-release-test\n1496:(deftest the-epoch-dimension-of-the-tenure-recheck-test\n1708:(deftest post-grant-failure-releases-or-retains-test\n1902:(deftest a-regrant-replays-from-the-checkpoint-test\n1973:(deftest the-source-resumes-only-after-its-own-grant-test\n2058:(deftest a-halted-result-lowers-without-a-grant-test\n2072:(deftest foreign-grants-never-activate-a-restarted-driver-test\n2095:(deftest stale-own-grant-mints-only-one-successor-proposal-test\n2288:(deftest tenure-is-rechecked-between-bare-effects-test\n2377:(deftest computation-cannot-spend-tenure-and-then-perform-io-test\n2945:(deftest accepted-grant-is-durable-before-lower-attachment-test\n3259:(deftest a-later-grant-outranks-an-earlier-completed-exit-test\n3313:(deftest after-a-replay-divergence-the-released-occurrence-is-regrantable-test\n3500:(deftest a-holder-aborts-a-hand-off-only-with-tenure-test\n3801:(deftest abort-rechecks-tenure-after-its-durable-terminal-record-test\n        replies (get-in world' [:replies \"holder-a\"])\n        _ (doseq [request-id [:first :second]]\n            (stream/append! replies {:yin.k/reply :yin.k/input :yin.k/request-id request-id}))\n        _ (reset! (:clock record) {:s 11})\n        renewed (driver/control-step running)\n        _ (carry! world')\n        acknowledged (driver/control-step renewed)\n        receipts (get-in acknowledged [:inbox :program])\n        recovered (driver/reopen (assoc (reopen-config acknowledged)\n                                        :reply-inbox (inbox-over (reopened-journal (get-in world' [:reply-frames \"holder-a\"])) arb)\n                                        :outcome-inbox (inbox-over (reopened-journal (:frames outcome-source)) arb)\n                                        :journal (reopened-journal (:journal-frames record))))]\n    (is (= [:first :second :third] (mapv #(get-in % [:yin.k/record :yin.k/request-id]) receipts)))\n    (is (= 1 (:renewals acknowledged)))\n    (is (= (:machine running) (:machine acknowledged)))\n    (is (= receipts (get-in recovered [:inbox :program])))\n    (is (= (get-in acknowledged [:inbox :positions]) (get-in recovered [:inbox :positions])))))\n\n\n(deftest old-run-results-are-not-applied-to-a-new-run-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\"] :sources sources)\n        record (split-grant world' sources)\n        running (driver/program-step (:state record))\n        receipt (retained-record :reply :source 0 arb {:yin.k/reply :yin.k/input}\n                                 {:yin.k/occurrence occurrence :dao.lease/lease \"old-lease\" :yin.k/epoch 0})\n        queued (assoc-in running [:inbox :program] [receipt])\n        advanced (driver/program-step queued)]\n    (is (empty? (get-in advanced [:inbox :program])))\n    (is (= (mapv #(dissoc % :yin.k/held) (:wait-set (:machine running)))\n           (mapv #(dissoc % :yin.k/held) (:wait-set (:machine advanced)))))\n    (is (not (:halted? (:machine advanced))))))\n\n\n(deftest control-does-not-apply-a-real-regrant-prefix-test\n  (let [{:keys [sources]} (reader-source)\n        world' (world :holders [\"holder-a\" \"holder-b\"] :sources sources)\n        first-holder (to-running world' (driver-for world' \"holder-a\" sources \"v1\"))\n        _ (stream/append! (:prog first-holder) :carried-input)\n        _ (driver/program-step (:state first-holder))\n        _ (carry! world')\n        _ (judge! world' {:s 40})\n        second-holder (driver-for world' \"holder-b\" sources \"v1\")\n        proposed (driver/control-step (driver/program-step (:state second-holder)))\n        _ (carry! world')\n        _ (judge! world' {:s 41})\n        accepted (driver/control-step proposed)\n        activated (driver/program-step accepted)\n        controlled (nth (iterate driver/control-step activated) 3)\n        programmed (nth (iterate driver/program-step controlled) 2)]\n    (is (= 1 (get-in controlled [:machine :yin.k/custody :input :prefix :yin.k/frontier])))\n    (is (= (:machine activated) (:machine controlled)))\n    (is (zero? @(:observations second-holder)))\n    (is (= :done (get-in programmed [:machine :value])))))\n\n\n(deftest bounded-stop-drain-and-recovery-test\n  (doseq [eventually-accept? [false true]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (split-grant world' sources)\n          attempts (atom [])\n          original (get-in record [:state :seams :append-request!])\n          stopped (driver/stop (assoc-in (:state record) [:seams :append-request!]\n                                         (fn [request]\n                                           (is (= :yin.k/intent\n                                                  (:yin.k/journal (last (driver/journal-records\n                                                                          (get-in record [:state :seams :journal]))))))\n                                           (swap! attempts conj request)\n                                           (if (and eventually-accept? (> (count @attempts) 2))\n                                             (original request)\n                                             {:dao.stream/outcome :dao.stream/full}))))\n          drained (loop [state stopped budget 5]\n                    (if (zero? budget) state\n                        (let [next-state (driver/control-step state)]\n                          (carry! world')\n                          (recur next-state (dec budget)))))\n          recovered (driver/stop (driver/reopen (assoc (reopen-config drained)\n                                                       :journal (reopened-journal (:journal-frames record)))))]\n      (is (<= (count @attempts) 5))\n      (is (= 1 (count (distinct @attempts))))\n      (is (zero? @(:attaches record)))\n      (if eventually-accept?\n        (is (= :failed (:phase drained)))\n        (do (is (= :releasing (:phase drained)))\n            (is (= (get-in drained [:release :request]) (get-in recovered [:release :request])))))\n      (is (= recovered (driver/program-step recovered))))))\n\n\n(deftest split-and-convenience-program-cycles-agree-test\n  (let [{:keys [sources]} (reader-source)\n        outcomes (for [split? [false true]]\n                   (let [world' (world :holders [\"holder-a\"] :sources sources)\n                         record (driver-for world' \"holder-a\" sources \"v1\")\n                         tick (fn [state]\n                                (if split?\n                                  (driver/program-step (driver/control-step state))\n                                  (driver/step state)))\n                         running (loop [state (:state record) budget 8]\n                                   (if (or (= :running (:phase state)) (zero? budget)) state\n                                       (let [next-state (tick state)]\n                                         (carry! world') (judge! world' {:s 2})\n                                         (recur next-state (dec budget)))))\n                         _ (stream/append! (:prog record) :input)\n                         halted (loop [state running budget 8]\n                                  (if (or (= :safepoint (:phase state)) (zero? budget)) state\n                                      (let [next-state (tick state)]\n                                        (carry! world')\n                                        (recur next-state (dec budget)))))]\n                     [(get-in halted [:machine :value]) @(:observations record)\n                      @(:attaches record) (count (requests-of world' \"holder-a\" :yin.k/input))]))]\n    (is (= (first outcomes) (second outcomes)))\n    (is (= :done (first (first outcomes))))))\n\n\n(deftest split-brackets-stop-on-uncertain-journal-append-test\n  (doseq [action [:yin.k/grant :yin.k/renewal :yin.k/release]\n          cut [:before-frame :after-frame-before-visible]]\n    (let [{:keys [sources]} (reader-source)\n          world' (world :holders [\"holder-a\"] :sources sources)\n          record (if (= :yin.k/grant action)\n                   (own-grant-driver world' sources \"v1\")\n                   (split-grant world' sources))\n          state (case action\n                  :yin.k/grant (:state record)\n                  :yin.k/renewal (do (reset! (:clock record) {:s 11}) (:state record))\n                  :yin.k/release (driver/stop (:state record)))\n          frames (:journal-frames record)\n          journal' (:dao.stream/handle\n                     (journal/open! (cut-record-backend frames #(= action (:yin.k/action %)) cut)))\n          state (assoc-in state [:seams :journal] journal')\n          sent-before (inbound world' \"holder-a\")\n          stalled (driver/control-step state)]\n      (is (= :stalled (:phase stalled)))\n      (is (= sent-before (inbound world' \"holder-a\")))\n      (is (nil? (:machine stalled)))\n      (is (zero? @(:attaches record)))\n      (is (= stalled (driver/program-step stalled)))\n      (is (= stalled (driver/control-step stalled)))\n      (let [recovered (driver/reopen (assoc (reopen-config state) :journal (reopened-journal frames)))]\n        (is (nil? (:machine recovered)))\n        (is (contains? #{:proposing :releasing} (:phase recovered)))))))\n\n\n;; =============================================================================\n;; Two candidates over two encodings of one occurrence (14.2.4 row 1)\n;; =============================================================================\n\n(deftest two-candidates-over-two-encodings-test\n  (let [{:keys [sources]} (reader-source)\n        w (world :holders [\"holder-a\" \"holder-b\"] :sources sources)\n        a (driver-for w \"holder-a\" sources \"v1\")\n        b (driver-for w \"holder-b\" sources \"v2\")\n        a2 (drive w (drive w a))                 ; validate, propose\n        b2 (drive w (drive w b))                 ; validate, propose\n        _ (judge! w {:s 2})]                     ; the judge grants holder-a\n    (testing \"the winner activates\"\n      (is (zero? @(:attaches a))\n          \"no stream was attached before the grant was accepted\")\n      (let [s (drive w a2)\n            st (:state s)]\n        (is (= :running (:phase st)))\n        (is (= :yin.k/ok (:status st)))\n        (is (= :running (vm/gate-mode (:machine st))))\n        (is (= occurrence (get-in st [:machine :yin.k/custody\n                                      :yin.k/occurrence])))\n        (is (= \"holder-a\" (get-in st [:machine :yin.k/custody\n                                      :dao.lease/holder])))\n        (is (= 0 (get-in st [:machine :yin.k/custody :input :next]))\n            \"a first grant starts input at zero\")))\n    (testing \"the loser: awaiting-grant, then not-holder\"\n      (is (= :yin.k/awaiting-grant (:status (:state b2)))\n          \"while its proposal was unanswered\")\n      (let [s (drive w b2)\n            st (:state s)]\n        (is (= :yin.k/not-holder (:status st)))\n        (is (= \"holder-a\" (:dao.lease/holder (:detail st)))\n            \"the lease state observed names the holder that won\")\n        (is (some? (:dao.lease/lease (:detail st))))\n        (is (nil? (:machine st)))\n        (is (= [] (filter #(= :dao.lease/released (:dao.lease/status %))\n                          (read-all (get (:media w) \"holder-b\"))))\n            \"nothing was released: the loser acquired nothing\")\n        (is (= 1 (count (requests-of w \"holder-b\" :yin.k/proposal)))\n            \"and it proposes no further while the occurrence is held\")\n        (testing \"the refused proposal id is never reused (7.7.8)\"\n          (let [pid (get-in b2 [:state :proposal :id])\n                lease (get-in (authority/projection (:a w))\n                              [:occurrences occurrence :dao.lease/lease])]\n            (is (= :dao.lease/rejected\n                   (get-in (authority/projection (:a w))\n                           [:answered [\"holder-b\" pid]]))\n                \"the judge's granting pass refused the losing proposal\")\n            ;; the winner's lease lapses: the occurrence is grantable\n            ;; again and holder-b is a candidate once more\n            (lapse-direct! w lease :policy)\n            (let [st' (:state (drive w s))]\n              (is (= :yin.k/awaiting-grant (:status st')))\n              (is (not= pid (get-in st' [:proposal :id]))\n                  \"the fresh step proposes a fresh id, never the\n                   answered one\")\n","exit_code":0,"status":"completed"}}
