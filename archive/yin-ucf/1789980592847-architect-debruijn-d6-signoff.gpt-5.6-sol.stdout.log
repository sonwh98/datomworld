   \"each call persisted its own named batch\")))\n   394\t\n   395\t\n   396\t;; =============================================================================\n   397\t;; D6 gaps: durable round trip and stored-tuple equality\n   398\t;; =============================================================================\n   399\t\n   400\t(defn- temp-path\n   401\t  []\n   402\t  (str \"target/test-pipeline-projected-\" (random-uuid) \".log\"))\n   403\t\n   404\t\n   405\t(defn- cleanup-file\n   406\t  \"Delete the file at path; :cljd first, since the ClojureDart host pass\n   407\t   also reads :clj.\"\n   408\t  [path]\n   409\t  #?(:cljd (try (let [f (dart-io/File. path)]\n   410\t                  (when (.existsSync f) (.deleteSync f)))\n   411\t                (catch Object _ nil))\n   412\t     :clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n   413\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))))\n   414\t\n   415\t\n   416\t(deftest a-nil-literal-round-trips-through-durable-storage\n   417\t  (let [path (temp-path)\n   418\t        ast (lam '[x] (app (v 'f) (lit nil) (v 'x)))]\n   419\t    (try\n   420\t      (let [store (jing-file/create-content-file path)\n   421\t            result (persist! ast (recording-writer) store)\n   422\t            address (get-in result [:projected :address])\n   423\t            _ (jing/close! store)\n   424\t            ;; reopen: the envelope now comes back through the backend's\n   425\t            ;; own text codec, replayed from disk\n   426\t            reopened (jing-file/create-content-file path)\n   427\t            stored (:yin.debruijn/datoms (jing/get reopened address ::absent))]\n   428\t        (jing/close! reopened)\n   429\t        (is (= :ok (:outcome (:projected result))))\n   430\t        (is (some (fn [d] (and (= :yin.debruijn/value (nth d 1)) (nil? (nth d 2))))\n   431\t                  stored)\n   432\t            \"the nil-valued datom survived storage as a pre