                                                            :key 'k}}}}},\n   464\t              :alternate (app (v 'list)\n   465\t                              {:type :vm/store-put, :key 'k, :val 5}\n   466\t                              {:type :vm/gensym, :prefix \"g\"}\n   467\t                              {:type :vm/current-continuation}\n   468\t                              {:type :vm/park}\n   469\t                              {:type :vm/resume, :parked-id :p1, :val (v 'y)}\n   470\t                              {:type :dao.stream.apply/call,\n   471\t                               :op :op/echo,\n   472\t                               :operands [(lit 1)]}\n   473\t                              {:type :lambda, :macro? true, :params '[m], :body (v 'm)})})\n   474\t        (lit 3))\n   475\t   (app (v 'list)\n   476\t        (lit nil)\n   477\t        (lit true)\n   478\t        (lit false)\n   479\t        (lit \"é\")\n   480\t        (lit 7)\n   481\t        (lit 2.0)\n   482\t        (lit 1.5)\n   483\t        (lit :ns/kw)\n   484\t        (lit 'ns/sym)\n   485\t        (lit [1 \"a\" :k])\n   486\t        (lit #{1 \"b\" :c})\n   487\t        (lit {:a [1 2], \"k\" #{nil}}))])\n   488\t\n   489\t\n   490\t(deftest every-node-type-and-scalar-class-round-trips-through-durable-storage\n   491\t  (let [path (temp-path)]\n   492\t    (try\n   493\t      (let [store (jing-file/create-content-file path)\n   494\t            addresses (mapv (fn [ast]\n   495\t                              (get-in (persist! ast (recording-writer) store)\n   496\t                                      [:projected :address]))\n   497\t                            durable-programs)\n   498\t            _ (jing/close! store)\n   499\t            reopened (jing-file/create-content-file path)\n   500\t            stored (mapv (fn [address]\n   501\t                           (:yin.debruijn/datoms (jing/get reopened address ::absent)))\n   502\t                         addresses)]\n   503\t        (jing/close! reopened)\n   504\t        (is (every? jing/segment-address? addresses))\n   505\t        (doseq [[ast datoms] (map vector durable-programs stored)]\n   506\t          (is (= (select-keys (debruijn/project-datoms\n   507\t                                (second (vm/ast->datoms-with-root ast)))\n   508\t                              [:fingerprint :records])\n   509\t                 (debruijn/datoms->projected datoms))\n   510\t              \"the reopened envelope reads back to the original projection\")))\n   511\t      (finally (cleanup-file path)))))\n   512\t\n   513\t\n   514\t(def ^:private host\n   515\t  ;; :cljd first: the ClojureDart host pass also reads :clj\n   516\t  #?(:cljd :cljd :clj :clj :cljs :cljs))\n   517\t\n   518\t\n   519\t(deftest values-the-file-codec-cannot-carry-are-refused-not-corrupted\n   520\t  ;; one law on every host: a durable round trip is exact, or it is refused\n   521\t  ;; loudly — at write, nothing stored (Dart's list case), or at read as\n   522\t  ;; :hash-mismatch (CLJS's -0.0 case) — never a silent change of value.\n   523\t  ;; No case requires a refusal on any host, so a codec fix cannot break\n   524\t  ;; it; :exact-on names only the hosts already shown to carry the value.\n   525\t  (doseq [{:keys [label ast exact-on]}\n   526\t          [{:label \"negative zero\",\n   527\t            :ast (app (v 'list) (lit -0.0) (lit 0.0)),\n   528\t            :exact-on #{:clj :cljd}}\n   529\t           {:label \"a list of integers\",\n   530\t            :ast (app (v 'list) (lit (list 1 2))),\n   531\t            :exact-on #{:clj}}\n   532\t           {:label \"a list holding a double\",\n   533\t            :ast (app (v 'list) (lit (list 1 2.5))),\n   534\t            :exact-on #{:clj}}]]\n   535\t    (testing label\n   536\t      (let [path (temp-path)]\n   537\t        (try\n   538\t          (let [store (jing-file/create-content-file path)\n   539\t                projected (:projected (persist! ast (re