+             (if (nil? row)
+               {:rule :id-resolves, :path path}
+               (let [tag (semantic-bytecode-row-tag row)
+                     slots (get semantic-bytecode-grammar tag)]
+                 (if (nil? slots)
+                   {:rule :tag, :path path}
+                   (let [body (subvec row 1)]
+                     (if (not= (count slots) (dec (count body)))
+                       {:rule :arity, :path path}
+                       (or (slot-defect tag slots body path)
+                           (let [on-path' (conj on-path id)]
+                             (some (fn [[suffix cid]]
+                                     (visit cid (conj path suffix) on-path'))
+                                   (semantic-bytecode-child-refs tag body)))
+                           (do (swap! reached conj id) nil)))))))))))]
