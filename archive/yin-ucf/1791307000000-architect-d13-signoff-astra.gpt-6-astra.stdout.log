{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/holder/driver.cljc | sed -n '375,460p;680,946p'; rg -n 'observe-renewal|carried|renewal|release' src/cljc/yin/vm/ucf/front.cljc src/cljc/dao/lease.cljc\"","aggregated_output":"   375\t  (assoc state :status status :detail detail))\n   376\t\n   377\t\n   378\t(defn- unsatisfied\n   379\t  ([state reason] (unsatisfied state reason nil))\n   380\t  ([state reason data]\n   381\t   (with-status state :yin.k/unsatisfied\n   382\t     (cond-> {:yin.k/reason reason}\n   383\t       (map? data) (merge data)))))\n   384\t\n   385\t\n   386\t(defn- failed\n   387\t  \"A terminal refusal no cleanup is owed for: before custody, none.\"\n   388\t  [state refusal]\n   389\t  (assoc state :phase :failed\n   390\t         :status (:yin.k/status refusal)\n   391\t         :detail (dissoc refusal :yin.k/status)))\n   392\t\n   393\t\n   394\t(def ^:private invalid-binding\n   395\t  \"custody/binding-evidence's no-evidence reasons that make the binding\n   396\t   of a grant to this driver invalid -- as against a history that is\n   397\t   merely unavailable.\"\n   398\t  #{:no-binding :duplicate-binding :inexact-epoch\n   399\t    :not-in-grant-transaction :grant-mismatch})\n   400\t\n   401\t\n   402\t;; =============================================================================\n   403\t;; The release: cleanup, retried until it has left\n   404\t;; =============================================================================\n   405\t\n   406\t(defn- release-request\n   407\t  [l]\n   408\t  {:yin.k/request :yin.k/release\n   409\t   :yin.k/request-id [:yin.k/release l]\n   410\t   :dao.lease/lease l})\n   411\t\n   412\t\n   413\t(defn- releasing\n   414\t  \"`state` entering :releasing over lease `l`, carrying the failure it\n   415\t   will answer once the release has left: any machine is gated ended,\n   416\t   the dao.lease holder has stopped, and the release request is sent at\n   417\t   once -- a send that does not answer ok is retained and the identical\n   418\t   request is retried.  This is cleanup, never recovery: it clears no\n   419\t   quarantine, completes nothing without accepted completion evidence,\n   420\t   and the occurrence of an ordinary failed run stays regrantable under\n   421\t   the ordinary policy.\"\n   422\t  [state status detail l]\n   423\t  (let [request (release-request l)\n   424\t        outcome (append-request! state request)]\n   425\t    (assoc state\n   426\t           :phase :releasing\n   427\t           :status status\n   428\t           :detail detail\n   429\t           :machine (some-> (:machine state) ended)\n   430\t           :holder (some-> (:holder state)\n   431\t                           (as-> h (when (some? (:grant h))\n   432\t                                     (:holder (lease/stop h)))))\n   433\t           :release {:lease l\n   434\t                     :request request\n   435\t                     :sent (= :dao.stream/ok (:dao.stream/outcome outcome))})))\n   436\t\n   437\t\n   438\t(defn- end-run\n   439\t  \"End the run (r3 1.6): all program IO stops, the machine is gated\n   440\t   ended, one diagnostic is appended to the composition's diagnostic\n   441\t   stream, and the lease is released while it may still be live.\"\n   442\t  [state cause detail]\n   443\t  (let [diagnostic {:yin.k/diagnostic :yin.k/run-ended\n   444\t                    :yin.k/occurrence (:occurrence state)\n   445\t                    :dao.lease/lease (:lease state)\n   446\t                    :yin.k/end (merge {:cause cause} detail)}]\n   447\t    (append-diagnostic! state diagnostic)\n   448\t    (releasing (update state :diagnostics conj diagnostic)\n   449\t               :yin.k/ended (merge {:cause cause} detail) (:lease state))))\n   450\t\n   451\t\n   452\t;; =============================================================================\n   453\t;; The candidate loop: propose, observe the grant, accept it whole\n   454\t;; =============================================================================\n   455\t\n   456\t(defn- proposal-request\n   457\t  [occurrence pid]\n   458\t  {:yin.k/request :yin.k/proposal\n   459\t   :yin.k/request-id [:yin.k/proposal occurrence pid]\n   460\t   :dao.lease/proposal pid\n   680\t                    ;; was acquired and nothing is released\n   681\t                    (some? (:dao.lease/lease entry))\n   682\t                    (with-status (drain-control state)\n   683\t                      :yin.k/not-holder\n   684\t                      (occurrence-state\n   685\t                        projection (:occurrence state)))\n   686\t\n   687\t                    (never-granted-again? entry)\n   688\t                    (with-status (drain-control state)\n   689\t                      :yin.k/not-holder\n   690\t                      (occurrence-state\n   691\t                        projection (:occurrence state)))\n   692\t\n   693\t                    :else (propose (drain-control state)\n   694\t                                   projection)))))))))))\n   695\t\n   696\t\n   697\t;; =============================================================================\n   698\t;; The run: tenure first, then renewal, machine, writer, reader, drains\n   699\t;; =============================================================================\n   700\t\n   701\t(defn- control-outstanding?\n   702\t  \"The one divergence fact the machine cannot see (r3 1.4): a control\n   703\t   request this driver still owes -- a renewal that has not left, or a\n   704\t   release.\"\n   705\t  [state]\n   706\t  (boolean (or (:renewal-pending? state)\n   707\t               (and (map? (:release state))\n   708\t                    (not (true? (:sent (:release state))))))))\n   709\t\n   710\t\n   711\t(defn- renewal-request\n   712\t  [l n]\n   713\t  {:yin.k/request :yin.k/renewal\n   714\t   :yin.k/request-id [:yin.k/renewal l n]\n   715\t   :dao.lease/lease l})\n   716\t\n   717\t\n   718\t(defn- renew\n   719\t  \"The renewal discipline (H2, H3) at `reading`: send at the interval,\n   720\t  the reading taken before the append, only while holding; an append\n   721\t  that does not answer ok advances nothing and the same attempt is\n   722\t  resent; a renewal at or past the bound latches it and moves nothing.\"\n   723\t  [state holder reading]\n   724\t  (if-not (lease/due-to-renew? holder reading)\n   725\t    [(assoc state :renewal-pending? false) holder]\n   726\t    (let [n (:renewals state)\n   727\t          o (append-request! state (renewal-request (:lease state) n))\n   728\t          ok? (= :dao.stream/ok (:dao.stream/outcome o))]\n   729\t      [(assoc state\n   730\t              :renewals (if ok? (inc n) n)\n   731\t              :renewal-pending? (not ok?))\n   732\t       (lease/observe-renewal holder reading o)])))\n   733\t\n   734\t\n   735\t(defn- drain\n   736\t  \"Fold every attributed record the composition's two readers answer --\n   737\t  the front's replies and the outcome projection -- into the machine,\n   738\t  routing each to the writer's `discharge`, the reader's `settle` or\n   739\t  this driver's own control arm.  A record that matches nothing changes\n   740\t  nothing, and draining continues past a run end, for the readers are\n   741\t  read dry either way.\"\n   742\t  [state]\n   743\t  (loop [state state]\n   744\t    (if-some [pair (or (when-some [p (read-reply! state)] [:reply p])\n   745\t                       (when-some [p (read-outcome! state)] [:outcome p]))]\n   746\t      (let [[author record] (second pair)\n   747\t            m (:machine state)\n   748\t            kind (get record :yin.k/reply)\n   749\t            r (cond\n   750\t                ;; the writer's: an admit reply, or a projected\n   751\t                ;; admission outcome with no request wrapper\n   752\t                (or (= :yin.k/admit kind)\n   753\t                    (and (nil? kind) (contains? record :yin.k/admission)))\n   754\t                (writer/discharge m author record)\n   755\t\n   756\t                ;; the reader's: an input acknowledgment\n   757\t                (= :yin.k/input kind)\n   758\t                (reader/settle m author record)\n   759\t\n   760\t                ;; this driver's own\n   761\t                :else {:machine m})]\n   762\t        (recur (control-reply\n   763\t                 (assoc state\n   764\t                        :machine (:machine r)\n   765\t                        :run-end (or (:run-end state) (:run-end r)))\n   766\t                 author record)))\n   767\t      state)))\n   768\t\n   769\t\n   770\t(defn- run-cycle\n   771\t  \"One program cycle of the run, after tenure: the machine's internal\n   772\t   computation, replay below the frontier, the writer's emit, the\n   773\t   reader's live step.  The unsatisfied answers of the writer and the\n   774\t   reader ride the state as :step-unsatisfied; a run end anywhere\n   775\t   rides it as :run-end.\"\n   776\t  [state]\n   777\t  (let [m0 (:machine state)\n   778\t        m1 (if (and (= :running (vm/gate-mode m0)) (not (:halted? m0)))\n   779\t             (vm/run m0)\n   780\t             m0)\n   781\t        replay (reader/replay m1 {:control-outstanding?\n   782\t                                  (control-outstanding? state)})\n   783\t        m2 (:machine replay)\n   784\t        emit (writer/emit m2 #(append-request! state %)\n   785\t                          #(append-diagnostic! state %))\n   786\t        m3 (:machine emit)\n   787\t        live (reader/step m3 #(append-request! state %)\n   788\t                          (fn [h op arg] (observe! state h op arg)))\n   789\t        m4 (:machine live)]\n   790\t    (assoc state\n   791\t           :machine m4\n   792\t           :run-end (or (:run-end replay) (:run-end emit) (:run-end live))\n   793\t           :step-unsatisfied (or (:unsatisfied replay)\n   794\t                                 (:unsatisfied emit)\n   795\t                                 (:unsatisfied live)))))\n   796\t\n   797\t\n   798\t(defn- at-safepoint?\n   799\t  \"True when the machine has nothing left the candidate half owes it:\n   800\t   halted with no wait entry and no queued work anywhere in the tree.\"\n   801\t  [machine]\n   802\t  (and (:halted? machine)\n   803\t       (every? (fn [[_ m]]\n   804\t                 (and (empty? (:wait-set m)) (empty? (:ready-queue m))))\n   805\t               (machines machine))))\n   806\t\n   807\t\n   808\t(defn- step-active\n   809\t  \"The step of :running and :safepoint alike: tenure is rechecked\n   810\t   before any execution or IO is scheduled (the D10 ruling); not\n   811\t   holding ends the run and releases; then the renewal, the program\n   812\t   cycle and the drains.  A halted result published without custody\n   813\t   steps to itself.\"\n   814\t  [state]\n   815\t  (if (nil? (:lease state))\n   816\t    state\n   817\t    (let [records (read-ledger! state)]\n   818\t      (if (nil? records)\n   819\t        (unsatisfied state :no-arbitration\n   820\t                     {:dao.stream/identity (:arbitration state)})\n   821\t        (let [arb (:arbitration state)\n   822\t              mine-records (vec (mine arb records))\n   823\t              defect (history-defect mine-records)\n   824\t              projection (when (nil? defect) (fold arb mine-records))\n   825\t              o (:occurrence state)\n   826\t              l (:lease state)\n   827\t              entry (get-in projection [:occurrences o])]\n   828\t          (cond\n   829\t            ;; unknown tenure: no execution and no IO scheduled\n   830\t            (or (some? defect) (nil? projection) (nil? entry))\n   831\t            (unsatisfied state (or defect :fold-defect) {})\n   832\t\n   833\t            ;; the lease is no longer the occurrence's live lease\n   834\t            (not= l 