{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'aborted|report-refused|report-answer|suspended|holding\\\\?|incomplete-preparation' src/cljc/yin/vm/ucf/holder/driver.cljc | tail -30; sed -n '1260,1298p;2420,2475p;2540,2650p' src/cljc/yin/vm/ucf/holder/driver.cljc; git diff -- src/cljc/yin/vm/ucf/handoff.cljc | head -85; tail -48 test/yin/vm/ucf/holder/export_test.cljc\"","aggregated_output":"425:           :yin.k/aborted (some? (:yin.k/occurrence record))\n511:        :yin.k/aborted\n512:        (assoc-in f [:aborted (:yin.k/occurrence record)] {:index index})\n1270:      (= :suspended (:yin.k/status answer)) (exit-report-step state)\n1273:      (end-run state (or (:yin.k/reason answer) :report-refused)\n1568:      (not (lease/holding? holder' reading))\n1582:          (if-not (lease/holding? holder' current-reading)\n1694:          (if (lease/holding? (:holder state) (clock state))\n1696:              (if (lease/holding? (:holder state) (clock state))\n1840:  (when-not (lease/holding? (:holder state) (clock state))\n1960:        (if-not (lease/holding? (:holder state) (clock state))\n1998:                        (if-not (lease/holding? holder reading)\n2137:   :aborted, :stalled or :failed), `:status` (:yin.k/ok,\n2379:                       :detail {:yin.k/reason :incomplete-preparation}))\n2425:               (and (get-in folded [:aborted (:occurrence mint)])\n2427:               (assoc (bare-state config units) :phase :aborted :status :yin.k/ok\n2428:                      :detail {:yin.k/aborted (:occurrence mint)})\n2433:                      :detail {:yin.k/reason :incomplete-preparation\n2436:               (and exit? (not (get-in folded [:aborted (:occurrence mint)])))\n2485:                       {:yin.k/status :suspended :yin.k/reason :threw}))\n2534:   The terminal :aborted record is durable in the journal before local\n2536:   own `holding?`, cap and latches -- across that append: tenure that\n2542:   machine (:running for a holder mid-run, :aborted for a first\n2575:                      :live (and (lease/holding? holder reading)\n2585:          (journal! state {:yin.k/journal :yin.k/aborted :yin.k/occurrence occurrence}))\n2587:          (if-not (lease/holding? (:holder state) (clock state))\n2589:                          :yin.k/aborted (:occurrence cell)\n2611:                  {:yin.k/aborted (:occurrence cell)})))\n2615:              (assoc :phase :aborted)\n2617:                {:yin.k/aborted (:occurrence cell)}))))\n\n      ;; the successor append: sent once before the report, per the\n      ;; exit's order; the authority refuses it :awaiting-completion\n      ;; until the closure, and the closure step drives its admission\n      (and (= :yin.k/successor (:role cell))\n           (nil? (:offer cell)))\n      (export-offer-step state :exit)\n\n      (nil? (get-in cell [:report :answer])) (exit-report-step state)\n\n      (= :suspended (:yin.k/status answer)) (exit-report-step state)\n\n      (not (admitted? (get-in cell [:report :answer])))\n      (end-run state (or (:yin.k/reason answer) :report-refused)\n               {:yin.k/answer answer})\n\n      (not (true? (get-in state [:release :carried])))\n      (release! state (:lease state))\n\n      :else (exit-closure-step state projection))))\n\n\n(defn- step-exiting\n  \"The step of :exiting, the exit of a restarted holder: no machine and\n   no holder state -- the process died -- so no renewal and no local\n   tenure arithmetic.  The ledger's own fold says whether the closure\n   stands; a tenure that ended before the report committed leaves the\n   successor an orphan and the exit over.\"\n  [state]\n  (let [state (drain-control state)\n        records (read-ledger! state)]\n    (if (nil? records)\n      (unsatisfied state :no-arbitration\n                   {:dao.stream/identity (:arbitration state)})\n      (let [mine-records (vec (mine (:arbitration state) records))\n            defect (history-defect mine-records)\n            projection (when (nil? defect)\n                         (fold (:arbitration state) mine-records))\n            o1 (:occurrence state)]\n                         (> (:index mint) (get-in folded [:grant :index])))\n                     (contains? #{:yin.k/successor :yin.k/result}\n                                (:role mint))\n                     (contains? (:fences folded) (:occurrence mint)))]\n      (assoc (cond\n               (and (get-in folded [:aborted (:occurrence mint)])\n                    (= :yin.k/first (:role mint)))\n               (assoc (bare-state config units) :phase :aborted :status :yin.k/ok\n                      :detail {:yin.k/aborted (:occurrence mint)})\n\n               (and (some? mint) (not (contains? (:fences folded) (:occurrence mint)))\n                    (or (= :yin.k/first (:role mint)) (nil? (:grant folded))))\n               (assoc (bare-state config units) :phase :stalled :status :yin.k/unsatisfied\n                      :detail {:yin.k/reason :incomplete-preparation\n                               :yin.k/occurrence (:occurrence mint)})\n\n               (and exit? (not (get-in folded [:aborted (:occurrence mint)])))\n               (reopen-exit config units folded)\n\n               (some? (:grant folded))\n               (reopen-holder config units folded)\n\n               (some? mint)\n               (reopen-source config units folded)\n\n               :else (reopen-candidate config folded))\n             :enroll (:enroll folded)))))\n\n\n;; =============================================================================\n;; Enrollment (r3 1.10; UCF 7.7.7's C12 identity discipline)\n;; =============================================================================\n\n(defn- enroll-attempt*\n  \"One bracketed enrollment step (r3 1.10; UCF 7.7.7 as amended by\n   C12): enrollment carries no request identity, so an uncertain answer\n   is reconciled by rereading the projection -- the driver enr