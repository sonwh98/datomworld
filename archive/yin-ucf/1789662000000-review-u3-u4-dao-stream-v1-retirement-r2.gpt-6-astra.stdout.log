(reset! frame* frame) (swap! frame-seq* inc)),\n                    :signal-handle signal-stream,\n                    :on-error (or on-error\n                                  (fn [e]\n                                    (dart/print\n                                      (str \"Invalid frame rejected (\"\n                                           (name (terminal/rejection-reason e))\n                                           \"): \" e))))})) :dispose nil\n               :refresh-on :never _bound (when on-bind (on-bind)) :dispose nil\n               :refresh-on :never _ticker (start-frame-ticker! binding*)\n               :dispose cancel-frame-ticker! :refresh-on :never]\n              :watch\n              [_frame-seq frame-seq* _image image-holder]\n              (m/CustomPaint. .painter\n                              (PostgraphicsPainter. frame*\n                                                    gpu-render/submit-gpu!\n                                                    image-holder\n                                                    decoding?\n                                                    frame-seq*\n                                                    rendered-seq*\n                                                    backend-mode\n                                                    on-paint-error)))))\n\n\n(defn postgraphics-widget\n  \"Returns a Flutter widget that renders dao.postgraphics frame programs from\n  frame-stream, a DaoStream v2 handle.\n\n  Options:\n  - :on-error      callback receiving the exception when a frame is rejected\n  - :on-paint-error callback receiving exceptions raised while painting\n  - :backend       :auto (default), :gpu, or :software\n  - :signal-stream DaoStream v2 writer to which canonical terminal signals\n                   (:dao.terminal/reset, :dao.terminal/rejection) are emitted;\n                   required for participants in dao.gui.event\n  - :on-bind       no-arg fn called once per mount, right after the te