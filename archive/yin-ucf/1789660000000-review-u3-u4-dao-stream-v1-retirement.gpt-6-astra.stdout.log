oned after the discarded input. The\n+  The caller supplies a cursor positioned after the discarded input — the\n+  recovery cursor an :input-gap advance result carried, or any cursor the\n+  host minted on the input stream; it is never a fabricated position. The\n   envelope is interpreted normally, so active pointer arenas and held keys\n   are cancelled and the cancellation outputs remain ordered with pending\n   output. This is deliberately separate from `advance`: a bare stream gap\n@@ -818,8 +853,11 @@\n   input stream and read cursor, the seven output streams, the immutable\n   interpreter state, the ordered pending-output queue, teardown and\n   parked-interval state, and an :offer function exposing the total reducer\n-  for direct replay.\"\n-  [{:keys [inputs outputs], :as _spec}]\n+  for direct replay. The spec's optional :cursor is the initial read\n+  cursor; without one the first advance mints :dao.stream/oldest, so a\n+  binding created before the input stream has any value still observes\n+  from its origin.\"\n+  [{:keys [inputs outputs cursor], :as _spec}]\n   (letfn [(make\n             [state cursor pending teardown?]\n             {:dao.gui.event/binding-version state-version,\n@@ -836,4 +874,4 @@\n                             (step state runtime-input)]\n                         {:binding (make next-state cursor pending teardown?),\n                          :outputs out}))})]\n-    (make (initial-state) {:position 0} [] false)))\n+    (make (initial-state) cursor [] false)))\n(ns datomworld.demo.dao-gui\n  (:require [\"package:flutter/material.dart\" :as m]\n            [dao.gui.compiler :as dao.gui]\n            [dao.postgraphics.flutter :as pg]\n            [dao.stream.ringbuffer :as rb]\n            [yin.repl.flutter :as flutter-repl]))\n\n\n(def ^:private frame-stream\n  (:dao.stream/handle (rb/create! {:dao.stream/type rb/transport-type,\n                                   rb/capacity-key 8})))\n\n\n(def ^:private design-width 420.0)\n(def ^:private design-height 320.0)\n(def ^:private surface-size (atom nil))\n(def ^:private surface-mode (atom :empty))\n\n\n(defn- put-frame!\n  [frame]\n  (pg/put-frame! frame-stream frame) frame)\n\n\n(defn- sample-frame\n  [width height]\n  (let [sx (/ width design-width)\n        sy (/ height design-height)\n        s (min sx sy)\n        x #(* sx %)\n        y #(* sy %)\n        u #(* s %)]\n    [{:op/kind :frame/clear, :color [0.05 0.06 0.1 1.0]}\n     {:op/kind :draw/fill-rect,\n      :rect [(x 24.0) (y 24.0) (x 372.0) (y 272.0)],\n      :color [0.09 0.1 0.16 1.0]}\n     {:op/kind :draw/stroke-rect,\n      :rect [(x 24.0) (y 24.0) (x 372.0) (y 272.0)],\n      :color [0.23 0.28 0.4 1.0],\n      :stroke-width (u 1.0)}\n     {:op/kind :draw/fill-circle,\n      :center [(x 98.0) (y 228.0)],\n      :radius (u 34.0),\n      :color [0.12 0.56 0.98 1.0]}\n     {:op/kind :transform/push, :translate [(x 210.0) (y 160.0)], :rotate 0.4}\n     {:op/kind :draw/fill-rect,\n      :rect [(- (u 44.0)) (- (u 26.0)) (u 88.0) (u 52.0)],\n      :color [0.98 0.46 0.14 1.0]} {:op/kind :transform/pop}\n     {:op/kind :clip/push-rect, :rect [(x 246.0) (y 54.0) (x 118.0) (y 62.0)]}\n     {:op/kind :draw/fill-rect,\n      :rect [(x 246.0) (y 54.0) (x 118.0) (y 62.0)],\n      :color [0.1 0.14 0.2 1.0]}\n     {:op/kind :draw/text,\n      :text \"Remote REPL\",\n      :position [(x 258.0) (y 93.0)],\n      :font-size (u 14.0),\n      :color [0.9 0.93 1.0 1.0]}\n     {:op/kind :draw/text,\n      :text \"(set-frame! ...)\",\n      :position [(x 258.0) (y 71.0)],\n      :font-size (u 11.0),\n      :color [0.45 0.52 0.72 1.0]} {:op/kind :clip/pop}]))\n\n\n(defn- clear-frame!\n  []\n  (reset! surface-mode :empty) (put-frame! []))\n\n\n(defn- approx-measure-text\n  [spec]\n  (let [font-size (double (or (:text/font-size spec) 14.0))\n        text (str (or (:text/value spec) \"\"))]\n    {:width (* (count text) font-size 0.6), :height (* font-size 1.2)}))\n\n\n(defn- compile-ui->frame\n  ([ui] (com