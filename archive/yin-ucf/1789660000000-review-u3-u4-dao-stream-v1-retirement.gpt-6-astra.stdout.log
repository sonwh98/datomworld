:status :parked}\n   812\t                    (:teardown? flushed')\n   813\t                    {:binding (close-outputs flushed'), :status :closed}\n   814\t                    :else {:binding flushed', :status :advanced}))\n   815\t                :dao.stream/blocked {:binding binding', :status :blocked}\n   816\t                :dao.stream/end {:binding binding', :status :end}\n   817\t                ;; a bare gap cannot construct the canonical input-loss\n   818\t                ;; envelope: report the transport's recovery cursor\n   819\t                ;; without advancing the binding's own cursor\n   820\t                :dao.stream/gap {:binding binding',\n   821\t                                 :status :input-gap,\n   822\t                                 :recovery-cursor (:dao.stream/cursor result)}\n   823\t                ;; cursor-mismatch, invalid-cursor, and transport-error:\n   824\t                ;; a binding that retried a dead cursor forever is the\n   825\t                ;; spin the runtime plan's classifier forbids\n   826\t                {:binding binding', :status :transport-error}))))))))\n   827\t\n   828\t\n   829\t(defn recover-input-gap\n   830\t  \"Resume a binding after a transport-owned input-loss envelope.\n   831\t\n   832\t  The caller supplies a cursor positioned after the discarded input — the\n   833\t  recovery cursor an :input-gap advance result carried, or any cursor the\n   834\t  host minted on the input stream; it is never a fabricated position. The\n   835\t  envelope is interpreted normally, so active pointer arenas and held keys\n   836\t  are cancelled and the cancellation outputs remain ordered with pending\n   837\t  output. This is deliberately separate from `advance`: a bare stream gap\n   838\t  does not contain enough information to recover by itself.\"\n    76\t   {:keys [validate-frame! present-frame! on-error signal-handle generation-id\n    77\t           generation-id-fn],\n    78\t    :or {validate-frame! identity,\n    79\t         present-frame! (fn [_] nil),\n    80\t         generation-id-fn new-generation-id}}]\n    81\t  (let [generation-id (or generation-id (generation-id-fn))\n    82\t        minted (stream/cursor frame-handle :dao.stream/newest)]\n    83\t    (emit-signal! signal-handle (reset-signal generation-id))\n    84\t    {:frame-handle frame-handle,\n    85\t     :cursor (when (= :dao.stream/ok (:dao.stream/outcome minted))\n    86\t               (:dao.stream/cursor minted)),\n    87\t     :generation-id generation-id,\n    88\t     :submission-id 0,\n    89\t     :closed? false,\n    90\t     :validate-frame! validate-frame!,\n    91\t     :present-frame! present-frame!,\n    92\t     :on-error on-error,\n    93\t     :signal-handle signal-handle}))\n    94\t\n    95\t\n    96\t(defn- accept-frame!\n    97\t  \"Validate and present frame. Returns :presented or :rejected.\"\n    98\t  [{:keys [validate-frame! present-frame! on-error signal-handle submission-id]}\n    99\t   frame]\n   100\t  (try (validate-frame! frame)\n   101\t       (present-frame! frame)\n   102\t       :presented\n   103\t       (catch #?(:clj Exception\n   104\t                 :cljs :default\n   105\t                 :cljd Object)\n   106\t              e\n   107\t         (emit-signal! signal-handle\n   108\t                       (rejection-signal submission-id (rejection-reason e)))\n   109\t         (when on-error (on-error e))\n   110\t         :rejected)))\n   111\t\n   112\t\n   113\t(defn step\n   114\t  \"Read at most one frame. Returns {:binding binding' :status s}, s one of\n   115\t   :presented, :rejected, :blocked, :gap, :end, :error, :closed.\n   116\t\n   117\t   On gap the binding adopts the recovery cursor the outcome carries. On end\n   118\t   or any other non-ok outcome a protocol-error signal is appended and the\n   119\t   binding closes; later steps answer :closed.\"\n   120\t  [{:keys [frame-handle cursor closed? submission-id signal-handle],\n   121\t    :as binding}]\n   122\t  (if closed?\n   123\t    {:binding binding, :status :closed}\n   124\t    (let [read (if (some? cursor)\n   125\t                 (stream/next frame-handle cursor)\n   126\t                 {:dao.stream/outcome :dao.stream/invalid-cursor})\n   127\t          outcome (:dao.stream/outcome read)]\n   128\t      (case outcome\n   129\t        :dao.stream/ok {:binding (assoc binding\n   130\t                                        :cursor (:dao.stream/cursor read)\n   131\t                                        :submission-id (inc submission-id)),\n   132\t                        :status (accept-frame! binding\n   133\t                                               (:dao.stream/value read))}\n   134\t        :dao.stream/blocked {:binding binding, :status :blocked}\n   135\t        :dao.stream/gap\n   136\t        (do (emit-signal! signal-handle (frame-skipped-signal submission-id))\n   137\t            {:binding (assoc binding\n   138\t                             :cursor (:dao.stream/cursor read)\n   139\t                             :submission-id (inc submission-id)),\n   140\t             :status :gap})\n   141\t        (do (emit-signal! signal-handle\n   142\t                          (protocol-error-signal outcome submission-id))\n   143\t            {:binding (assoc binding :closed? true),\n   144\t             :status (if (= :dao.stream/end outcome) :end :error)})))))\n   145\t\n   146\t\nrg: src/cljd/datomworld/main.cljd: No such file or directory (os error 2)\nsrc/cljd/datomworld/demo/dao_gui.cljd:1:(ns datomworld.demo.dao-gui\nsrc/cljd/datomworld/demo/main.cljd:3:            [datomworld.demo.dao-gui :as dao-gui-demo]\nsrc/cljd/datomworld/demo/main.cljd:40:                                 (dao-gui-demo/start!)\nsrc/cljd/datomworld/demo/main.cljd:45:                                            (fn [_] (dao-gui-demo/view))))\nsrc/cljd/datomworld/demo/main.cljd:46:                                        (fn [_] (dao-gui-demo/stop!