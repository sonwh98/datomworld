ranslate [(x 12.0) (y 78.0)]}\n        [:rect\n         {:width (x 184.0), :height (y 12.0), :color [0.17 0.25 0.38 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 78.0)]}\n        [:clip {:width (x 156.0), :height (y 12.0)}\n         [:rect\n          {:width (x 184.0), :height (y 12.0), :color [0.43 0.87 0.56 1.0]}]]]\n       [:transform {:translate [(x 12.0) (y 106.0)]}\n        [:text\n         {:value \"frames, clips, transforms, overlays\",\n          :font-size (u 11.0),\n          :color [0.62 0.71 0.85 1.0]}]]]]\n     [:transform {:translate [(x 268.0) (y 68.0)]}\n      [:stack\n       [:rect\n        {:width (x 132.0), :height (y 124.0), :color [0.11 0.12 0.18 1.0]}]\n       [:transform {:translate [(x 12.0) (y 12.0)]}\n        [:text\n         {:value \"live ops\", :font-size (u 15.0), :color [0.93 0.97 1.0 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 36.0)]}\n        [:text\n         {:value \"(show-demo-ui!)\",\n          :font-size (u 12.0),\n          :color [0.34 0.82 0.99 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 56.0)]}\n        [:text\n         {:value \"(set-ui! ...)\",\n          :font-size (u 12.0),\n          :color [0.34 0.82 0.99 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 76.0)]}\n        [:text\n         {:value \"(set-frame! ...)\",\n          :font-size (u 12.0),\n          :color [0.34 0.82 0.99 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 102.0)]}\n        [:rect {:width (x 94.0), :height (y 8.0), :color [0.21 0.28 0.42 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 102.0)]}\n        [:clip {:width (x 72.0), :height (y 8.0)}\n         [:rect\n          {:width (x 94.0), :height (y 8.0), :color [0.98 0.46 0.14 1.0]}]]]]]\n     [:transform {:translate [(x 20.0) (y 210.0)]}\n      [:stack\n       [:rect {:width (x 380.0), :height (y 84.0), :color [0.08 0.09 0.14 1.0]}]\n       [:transform {:translate [(x 12.0) (y 12.0)]}\n        [:text\n         {:value \"layout map\",\n          :font-size (u 15.0),\n          :color [0.92 0.96 1.0 1.0]}]]\n       [:transform {:translate [(x 12.0) (y 34.0)]}\n        [:row\n         [:rect\n          {:width (x 56.0), :height (y 34.0), :color [0.18 0.61 0.98 1.0]}]\n         [:rect\n          {:width (x 12.0), :height (y 34.0), :color [0.08 0.09 0.14 0.0]}]\n         [:rect\n          {:width (x 92.0), :height (y 34.0), :color [0.98 0.53 0.18 1.0]}]\n         [:rect\n          {:width (x 12.0), :height (y 34.0), :color [0.08 0.09 0.14 0.0]}]\n         [:rect\n          {:width (x 74.0), :height (y 34.0), :color [0.42 0.87 0.57 1.0]}]\n         [:rect\n          {:width (x 12.0), :height (y 34.0), :color [0.08 0.09 0.14 0.0]}]\n         [:rect\n          {:width (x 86.0), :height (y 34.0), :color [0.74 0.35 0.96 1.0]}]]]\n       [:transform {:translate [(x 12.0) (y 74.0)]}\n        [:text\n         {:value \"explicit transforms give the spacing some bite\",\n          :font-size (u 11.0),\n          :color [0.61 0.71 0.84 1.0]}]]]]\n     [dao.gui/overlay\n      [:transform {:translate [(x 246.0) (y 12.0)]}\n       [:stack\n        [:transform {:rotate 0.2}\n         [:rect\n          {:width (x 146.0), :height (y 50.0), :color [0.99 0.46 0.15 1.0]}]]\n        [:transform {:translate [(x 16.0) (y 14.0)]}\n         [:text\n          {:value \"overlay layer\",\n           :font-size (u 15.0),\n           :color [1.0 0.97 0.94 1.0]}]]\n        [:transform {:translate [(x 16.0) (y 31.0)]}\n         [:text\n          {:value \"always floating above flow\",\n           :font-size (u 11.0),\n           :color [1.0 0.9 0.84 1.0]}]]]]]]))\n\n\n(defn- render-built-in-surface!\n  []\n  (when-let [[width height] @surface-size]\n    (case @surface-mode\n      :sample (put-frame! (sample-frame width height))\n      :demo (put-frame! (compile-ui->frame (demo-ui width height)))\n      nil)))\n\n\n(defn- show-demo-ui!\n  []\n  (reset! surface-mode :demo)\n  (render-built-in-surface!)\n  :ok)\n\n\n(defn- show-sample-frame!\n  []\n  (reset! surface-mode :sample)\n  (render-built-in-surface!)\n  :ok)\n\n\n(defn- extra-primitives\n  []\n  {'set-frame! (fn [frame] (reset! surface-mode :custom) (put-frame! frame)),\n   'clear-frame! (fn [] (clear-frame!) :cleared),\n   'show-sample-frame! (fn [] (show-sample-frame!)),\n   'show-demo-ui! (fn [] (show-demo-ui!)),\n   'compile-ui (fn\n                 ([ui] (compile-ui->frame ui))\n                 ([ui props] (compile-ui->frame ui props))),\n   'set-ui! (fn\n              ([ui] (reset! surface-mode :custom) (set-ui! ui))\n              ([ui props] (reset! surface-mode :custom) (set-ui! ui props)))})\n\n\n(defn- mono\n  ([text] (mono text 12.0))\n  ([text size]\n   (m/Text text .style (m/TextStyle .fontFamily \"monospace\" .fontSize size))))\n\n\n(defn- repl-info-button\n  []\n  (m/Builder\n    .builder\n    (fn [ctx]\n      (m/OutlinedButton\n        .onPressed\n        (fn []\n          (m/showDialog\n            .context\n            ctx\n            .builder\n            (fn [_]\n              (m/AlertDialog\n                .title\n                (m/Text \"Remote REPL\")\n                .content\n                (m/SingleChildScrollView\n                  .child\n                  (m/Column\n                    .crossAxisAlignment\n                    m/CrossAxisAlignment.start\n                    .mainAxisSize\n                    m/MainAxisSize.min\n                    .children\n                    [(flutter-repl/info-card {}) (m/SizedBox .height 8.0)\n                     (mono\n                       \"1. Run `mise exec -- clj -M:clj-yin-repl` on your desktop.\")\n                     (mono (str\n                             \"2. Connect with `(connect \\\"daostream:ws://<ip>:\"\n                             flutter-repl/default-port\n                             \"/repl\\\")`.\"))\n                     (mono\n                       \"3. Push frames or dao.gui UI into the attached DaoStream.\")\n                     (m/SizedBox .height 12.0) (mono \"(show-demo-ui!)\")\n                     (mono \"(show-sample-frame!)\") (mono \"(clear-frame!)\")\n                     (mono \"(set-frame! [{:op/kind :draw/fill-rect\")\n                     (mono \"             :rect [20 20 120 60]\")\n                     (mono \"             :color [0.2 0.6 1 1]}])\")\n                     (m/SizedBox .height 12.0) (mono \"(set-ui! [:column\")\n                     (mono \"          [:rect {:width 80 :height 24}]\")\n                     (mono\n                       \"          [:text {:value \\\"hello\\\" :font-size 18}]])\")]))\n                .actions\n                [(m/TextButton .onPressed\n                               (fn [] (.pop (m/Navigator.of ctx)))\n                               .child\n                               (m/Text \"Close\"))])))\n          nil)\n        .child\n        (m/Text \"Remote REPL Info\")))))\n\n\n(defn start!\n  []\n  (show-sample-frame!)\n  (flutter-repl/start-server! {:extra-primitives (extra-primitives)}))\n\n\n(defn stop!\n  []\n  (flutter-repl/stop-server!))\n\n\n(defn view\n  []\n  (m/Scaffold\n    .appBar\n    (m/AppBar .title (m/Text \"dao.gui demo\"))\n    .body\n    (m/LayoutBuilder\n      .builder\n      (fn [_ ^m/BoxConstraints constraints]\n        (let [max-width (.-maxWidth constraints)\n              content-width (if (< max-width 720.0) max-width 720.0)]\n          (m/Center\n            .child\n            (m/SizedBox\n              .width\n              content-width\n              .child\n              (m/ListView\n                .padding\n                (m/EdgeInsets.all 16.0)\n                .children\n                [(repl-info-button) (m/SizedBox .height 16.0)\n                 (m/Text \"Remote Frame Surface\"\n                         .style\n                         (m/TextStyle .fontWeight m/FontWeight.bold))\n                 (m/SizedBox .height 8.0)\n                 (m/LayoutBuilder\n                   .builder\n                   (fn [_ ^m/BoxConstraints constraints]\n                     (let [max-width (.-maxWidth constraints)\n                           surface-width (max 0.0 (- max-width 24.0))\n                           surface-height (* surface-width\n                                             (/ design-height design-width))\n                           dims [surface-width surface-height]]\n                       (when (not= dims @surface-size)\n                         (reset! surface-size dims)\n                         (when (contains? #{:sample :demo} @surface-mode)\n                           (render-built-in-surface!)))\n                       (m/Center .child\n                                 (m/Container\n                                   .padding\n                                   (m/EdgeInsets.all 12.0)\n                                   .decoration\n                                   (m/BoxDecoration\n                                     .color\n                                     (m/Color.fromARGB 255 10 10 18)\n                                     .border\n                                     (m/Border.all .color\n                                                   (m/Color.fromARGB 255 56\n                                                                     64 88))\n                                     .borderRadius\n                                     (m/BorderRadius.circular 8.0))\n                                   .child\n                                   (m/SizedBox .width\n                                               surface-width\n                                               .height\n                                               surface-height\n                                               .child\n                                               (pg/postgraphics-widget\n                                                 frame-stream)))))))\n                 (m/SizedBox .height 12.0)\n                 (m/Row .children\n                        [(m/Expanded .child\n                                     (m/OutlinedButton .onPressed\n                                                       show-sample-frame!\n                                                       .child\n                                                       (m/Text\n                                                         \"Load sample frame\")))\n                         (m/SizedBox .width 12.0)\n                         (m/Expanded .child\n                                     (m/OutlinedButton\n                                       .onPressed\n                                       clear-frame!\n                                       .child\n                                       (m/Text \"Clear frame\")))])]))))))))\n\n\n(defn main\n  []\n  (start!)\n  (m/runApp (m/MaterialApp .title\n                           \"Yin.VM Postgraphics REPL Prototype\"\n                           .theme\n                           (m/ThemeData .primarySwatch m.Colors/indigo)\n                           .home\n                           (view))))\n168:(defn advance-until-progress\n169-  \"Advances a binding for at most max-steps calls. Hosts use this bounded\n170-   helper after draining outputs; a blocked input is returned to the host for\n171-   retry on its next progress opportunity rather than spinning.\"\n172-  [binding max-steps]\n173-  (loop [binding binding\n174-         n 0\n175-         statuses []]\n176-    (if (>= n max-steps)\n177-      {:binding binding, :statuses statuses, :retry? true}\n178-      (let [{next-binding :binding, status :status} (event/advance binding)\n179-            statuses (conj statuses status)]\n180-        (if (= :advanced status)\n181-          (recur next-binding (inc n) statuses)\n182-          {:binding next-binding,\n183-           :statuses statuses,\n184-           :retry? (= :blocked status)})))))\n185-\n186-\n187-(defn- value-or\n188-  [x fallback]\n189-  (if (number? x) (double x) fallback))\n190-\n191-\n192-(defn drag-gesture?\n193-  [gesture]\n","exit_code":0,"status":"completed"}}
