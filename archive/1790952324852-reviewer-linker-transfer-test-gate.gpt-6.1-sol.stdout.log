{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/yin/vm/linker/cross_host_transfer_test.clj'","aggregated_output":"     1\t(ns yin.vm.linker.cross-host-transfer-test\n     2\t  \"Criterion 5a/10: a JVM publisher and a separate Dart receiver.\n     3\t   The receiver starts with identity and index, never an image. Remote\n     4\t   stream envelopes cross Transit pipes between two ring compositions.\n     5\t   Build the test-only peer on every run so this gate cannot skip.\"\n     6\t  (:require [clojure.java.io :as io]\n     7\t            [clojure.java.shell :as shell]\n     8\t            [clojure.test :refer [deftest is testing]]\n     9\t            [dao.jing :as jing]\n    10\t            [dao.jing.content :as content]\n    11\t            [dao.jing.mem :as mem]\n    12\t            [dao.stream :as stream]\n    13\t            [dao.stream.remote :as remote]\n    14\t            [dao.stream.ringbuffer :as ring]\n    15\t            [dao.stream.transit :as transit]\n    16\t            [yin.vm :as vm]\n    17\t            [yin.vm.debruijn-linearize :as dl]\n    18\t            [yin.vm.debruijn-register-compile :as rc]\n    19\t            [yin.vm.debruijn-vm-contract-test :as b0]\n    20\t            [yin.vm.linker :as linker]\n    21\t            [yin.vm.linker.publish :as publish]\n    22\t            [yin.vm.linker.remote-transfer-test :as fixtures]\n    23\t            [yin.vm.test-utils :as tu]))\n    24\t\n    25\t\n    26\t(defn- build-peer!\n    27\t  []\n    28\t  (doseq [command\n    29\t          [[\"mise\" \"exec\" \"--\" \"clojure\" \"-M:clojuredart:cljd\" \"compile\"\n    30\t            \"yin.vm.linker.transfer-peer\"]\n    31\t           [\"mise\" \"exec\" \"--\" \"dart\" \"compile\" \"exe\"\n    32\t            \"lib/cljd-out/yin/vm/linker/transfer-peer.dart\"\n    33\t            \"-o\" \"build/linker-transfer-peer\"]]]\n    34\t    (let [{:keys [exit out err]} (apply shell/sh command)]\n    35\t      (when-not (zero? exit)\n    36\t        (throw (ex-info \"Dart transfer peer build failed\"\n    37\t                        {:command command :exit exit :out out :err err}))))))\n    38\t\n    39\t\n    40\t(defn- medium\n    41\t  []\n    42\t  (:dao.stream/handle\n    43\t    (ring/create! {:dao.stream/type ring/transport-type\n    44\t                   ring/capacity-key 256})))\n    45\t\n    46\t\n    47\t(defn- oldest\n    48\t  [h]\n    49\t  (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n    50\t\n    51\t\n    52\t(defn- drain!\n    53\t  [h cursor]\n    54\t  (loop [values []]\n    55\t    (let [r (stream/next h @cursor)]\n    56\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    57\t        (do (reset! cursor (:dao.stream/cursor r))\n    58\t            (recur (conj values (:dao.stream/value r))))\n    59\t        values))))\n    60\t\n    61\t\n    62\t(defn- receive!\n    63\t  [store initial]\n    64\t  (let [process (.start (ProcessBuilder.\n    65\t                          ^java.util.List [\"build/linker-transfer-peer\"]))\n    66\t        stderr (future (slurp (.getErrorStream process)))\n    67\t        reader (io/reader (.getInputStream process))\n    68\t        writer (io/writer (.getOutputStream process))\n    69\t        incoming (medium)\n    70\t        outgoing (medium)\n    71\t        requests (medium)\n    72\t        answers (medium)\n    73\t        mirror-cursor (atom (oldest incoming))\n    74\t        serve-cursor (atom (oldest requests))\n    75\t        out-cursor (atom (oldest outgoing))\n    76\t        table {\"requests\" {:handle requests :surface #{:reader :writer}}\n    77\t               \"answers\" {:handle answers :surface #{:reader :writer}}}\n    78\t        send! (fn [value]\n    79\t                (.write writer (str (transit/encode value) \"\\n\"))\n    80\t                (.flush writer))\n    81\t        task (future\n    82\t               (send! initial)\n    83\t               (loop [rounds 0]\n    84\t                 (when (> rounds 10000)\n    85\t                   (throw (ex-info \"Transfer exceeded round budget\" {})))\n    86\t                 (if-let [line (.readLine reader)]\n    87\t                   (let [reply (transit/decode line)]\n    88\t                     (if (contains? reply :result)\n    89\t                       reply\n    90\t                       (do\n    91\t                         (doseq [v (:wire reply)]\n    92\t                           (stream/append! incoming v))\n    93\t                         (swap! mirror-cursor\n    94\t                                #(remote/mirror-step table incoming %\n    95\t                                                     outgoing))\n    96\t                         (swap! serve-cursor\n    97\t                                #(content/serve-step store requests %\n    98\t                                                     answers 64))\n    99\t                         (send! {:wire (drain! outgoing out-cursor)})\n   100\t                         (recur (inc rounds)))))\n   101\t                   (throw (ex-info \"Dart peer ended before result\"\n   102\t                                   {:stderr @stderr})))))]\n   103\t    (try\n   104\t      (let [reply (deref task 60000 ::timeout)]\n   105\t        (when (= ::timeout reply)\n   106\t          (throw (ex-info \"Dart transfer timed out\" {})))\n   107\t        reply)\n   108\t      (finally\n   109\t        (.destroyForcibly process)\n   110\t        (.waitFor process)\n   111\t        (future-cancel task)\n   112\t        (.close writer)\n   113\t        (.close reader)))))\n   114\t\n   115\t\n   116\t(defn- image\n   117\t  [lower ast]\n   118\t  (:image (lower (second (vm/ast->datoms-with-root ast)))))\n   119\t\n   120\t\n   121\t(deftest jvm-images-transfer-to-an-identity-only-dart-receiver\n   122\t  (build-peer!)\n   123\t  (doseq [[kind format lower]\n   124\t          [[:H linker/stack-format dl/adapt]\n   125\t           [:R linker/register-format rc/adapt]]]\n   126\t    (testing (name kind)\n   127\t      (let [store (mem/create-content-mem)]\n   128\t        (try\n   129\t          (let [published (publish/publish-module!\n   130\t                            store {:name 'transfer.example\n   131\t                                   :ast fixtures/worked-example\n   132\t                                   :exports #{} :requires {}\n   133\t                                   :primitives\n   134\t                                   {'+ {:yin.k/profile :test/add\n   135\t                                        :yin.k/effects #{}}}})\n   136\t                identity (get-in published [:identities (:format format)])\n   137\t                index (select-keys\n   138\t                        (get-in published [:manifest :yin.module/index])\n   139\t                        [identity])\n   140\t                initial {:kind kind :identity identity :index index}\n   141\t                received (receive! store initial)\n   142\t                local (b0/normalize\n   143\t                        (vm/value (vm/eval (tu/create-vm)\n   144\t                                           fixtures/worked-example)))]\n   145\t            (is (jing/segment-address? (:address published)))\n   146\t            (is (every? #(= :ok (:status %)) (vals (:links published))))\n   147\t            (is (= #{:kind :identity :index} (set (keys initial))))\n   148\t            (is (= :ok (get-in received [:result :status]))\n   149\t                (pr-str received))\n   150\t            (is (true? (:identity-matches received)))\n   151\t            (is (= identity (get-in received [:result :identity])))\n   152\t            (is (= local (b0/normalize (:value received))))\n   153\t            (testing \"a foreign image at the claimed index address\"\n   154\t              (let [[foreign _ address]\n   155\t                    (linker/publish! store format\n   156\t                                     (image lower fixtures/other-program))\n   157\t                    reply (receive! store\n   158\t                                    (assoc initial :index {identity address}))]\n   159\t                (is (= {:status :refused :reason :hash-mismatch\n   160\t                        :expected identity :actual foreign}\n   161\t                       (:result reply)))\n   162\t                (is (not (contains? reply :value)))))\n   163\t            (testing \"corrupt bytes served under the published address\"\n   164\t              (let [bad-store (assoc store :get-bytes-fn\n   165\t                                     (fn [_ _]\n   166\t                                       (jing/canonical-bytes [:corrupt])))\n   167\t                    reply (receive! bad-store initial)]\n   168\t                (is (= :refused (get-in reply [:result :status])))\n   169\t                (is (= :address-mismatch\n   170\t                       (get-in reply [:result :reason])))\n   171\t                (is (not (contains? reply :value))))))\n   172\t          (finally (jing/close! store)))))))\n","exit_code":0,"status":"completed"}}
