{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/driver.cljc | sed -n '440,510p'; nl -ba src/cljc/yin/repl/adapter.cljc | sed -n '96,130p'; nl -ba test/yin/repl/driver_test.cljc | sed -n '205,253p'; rg -n 'response-cursor-unminted|submit-remote|pending-write' src/cljc/yin/repl/driver.cljc; rg -n ':dao\\\\.stream\\\\.apply/(detached|ended|not-found|no-surface|oversize|transport-error)|:dao\\\\.stream.apply/gap' test/yin/vm/ffi_test.cljc test/yin/vm/ffi/remote_serve/responder_test.cljc test/yin/repl/serve_connect_wire_test.clj test/yin/repl/adapter_test.cljc test/yin/repl/connect_test.cljc test/dao/stream/rpc_test.cljc\"","aggregated_output":"   440\t        ;; sent, so it waits for an explicit reattachment decision.\n   441\t        (remote-terminal state)\n   442\t        (-> state\n   443\t            (update :queued conj line)\n   444\t            (publish :yin.repl.driver/notice\n   445\t                     \";; not connected: queued until (connect …) reattaches\"))\n   446\t\n   447\t        ;; `:unsent` is the RPC client's own retained envelope, and the\n   448\t        ;; authority on whether the request path is free: submitting here would\n   449\t        ;; resend it and discard this line.  `:retrying` is only the driver's\n   450\t        ;; record of which line that envelope carries.  An unminted response\n   451\t        ;; cursor holds the line too: its answer could land before the cursor.\n   452\t        (or (:outstanding state) (:retrying state) (remote-unsent? state)\n   453\t            (response-cursor-unminted? state))\n   454\t        (update state :queued conj line)\n   455\t\n   456\t        :else (submit-remote state line))\n   457\t\n   458\t      :else (evaluate-locally state line))))\n   459\t\n   460\t\n   461\t;; =============================================================================\n   462\t;; Remote completions\n   463\t;; =============================================================================\n   464\t\n   465\t(defn- completion-text\n   466\t  [event]\n   467\t  (case (:yin.repl.adapter/event event)\n   468\t    :yin.repl.adapter/response\n   469\t    (if (contains? event :yin.repl.adapter/error)\n   470\t      (str \"Error: \" (repl/format-value (:yin.repl.adapter/error event)))\n   471\t      (let [value (:yin.repl.adapter/value event)]\n   472\t        (if (string? value) value (repl/format-value value))))\n   473\t\n   474\t    :yin.repl.adapter/lost\n   475\t    (str \";; remote request \" (:yin.repl.adapter/id event) \" lost: \"\n   476\t         (pr-str (data/summarize (:yin.repl.adapter/reason event) diagnostic-bounds)))\n   477\t\n   478\t    (str \";; \" (pr-str (data/summarize event diagnostic-bounds)))))\n   479\t\n   480\t\n   481\t(defn- completion-event-kind\n   482\t  [event]\n   483\t  (if (= :yin.repl.adapter/response (:yin.repl.adapter/event event))\n   484\t    :yin.repl.driver/response\n   485\t    :yin.repl.driver/notice))\n   486\t\n   487\t\n   488\t(defn- clears-outstanding?\n   489\t  [state event]\n   490\t  (and (:outstanding state)\n   491\t       (contains? #{:yin.repl.adapter/response :yin.repl.adapter/lost}\n   492\t                  (:yin.repl.adapter/event event))\n   493\t       (= (:outstanding state) (:yin.repl.adapter/id event))))\n   494\t\n   495\t\n   496\t(defn- publish-adapter-events\n   497\t  \"Move the adapter's event outbox into the driver's, exactly once.\"\n   498\t  [state]\n   499\t  (let [[events adapter] (adapter/take-events (:adapter state))]\n   500\t    (reduce (fn [state event]\n   501\t              (-> state\n   502\t                  (cond-> (clears-outstanding? state event)\n   503\t                    (assoc :outstanding nil))\n   504\t                  (publish (completion-event-kind event) (completion-text event))))\n   505\t            (assoc state :adapter adapter)\n   506\t            events)))\n   507\t\n   508\t\n   509\t(defn- poll-remote\n   510\t  [state]\n    96\t\n    97\t\n    98\t(defn- adapter-result\n    99\t  [outcome state & {:as extra}]\n   100\t  (merge {:yin.repl.adapter/outcome outcome\n   101\t          :yin.repl.adapter/state state}\n   102\t         extra))\n   103\t\n   104\t\n   105\t(defn- append-event\n   106\t  [state event]\n   107\t  (update state :yin.repl.adapter/events conj event))\n   108\t\n   109\t\n   110\t(defn- request-outcome\n   111\t  [rpc-outcome]\n   112\t  (case rpc-outcome\n   113\t    :dao.stream.rpc/requested :yin.repl.adapter/requested\n   114\t    :dao.stream.rpc/pending-request :yin.repl.adapter/pending-request\n   115\t    :dao.stream.rpc/request-undeliverable :yin.repl.adapter/request-undeliverable\n   116\t    :dao.stream.rpc/invalid-request :yin.repl.adapter/invalid-input\n   117\t    :dao.stream.rpc/backpressure :yin.repl.adapter/backpressure\n   118\t    :dao.stream.rpc/allocator-error :yin.repl.adapter/terminal\n   119\t    :dao.stream.rpc/terminal :yin.repl.adapter/terminal\n   120\t    :yin.repl.adapter/transport-result))\n   121\t\n   122\t\n   123\t(defn submit-input\n   124\t  \"Advance one input transition.\n   125\t\n   126\t   A local command becomes an explicit event and leaves RPC state untouched, as\n   127\t   does a command this slice rejects.  Other strings are submitted as a\n   128\t   `:op/eval` request.  This function makes at\n   129\t   most one append attempt through `rpc/request!`; it never waits or retries.\"\n   130\t  [state input]\n   205\t         :dao.stream/retry? true}))\n   206\t\n   207\t    (next [_ c] (stream/next responses c))))\n   208\t\n   209\t\n   210\t(deftest no-request-crosses-before-its-response-cursor-is-minted\n   211\t  ;; The R5 flake: a request sent while `newest` was unminted was answered\n   212\t  ;; at a position the later-resolved cursor lay past, so its answer was\n   213\t  ;; never read.\n   214\t  (let [requests (handle 8)\n   215\t        responses (handle 8)\n   216\t        minted? (atom false)\n   217\t        state (-> (driver/create-state)\n   218\t                  (driver/attach-remote\n   219\t                    (adapter/state (rpc/client-state\n   220\t                                     requests\n   221\t                                     (unminted-reflection responses minted?)\n   222\t                                     stream/anchor-newest))))]\n   223\t    (driver/submit-line! (:input state) \"(+ 1 2)\")\n   224\t    (let [stepped (driver/repl-step state 0)]\n   225\t      (is (= :dao.stream/blocked\n   226\t             (:dao.stream/outcome (stream/next requests (oldest requests))))\n   227\t          \"nothing is appended while the response cursor is an anchor\")\n   228\t      (is (= [\"(+ 1 2)\"] (:queued stepped)) \"the line waits in the queue\")\n   229\t      (is (true? (driver/pending-write? stepped))\n   230\t          \"a line held for the mint keeps the cadence at the base interval\")\n   231\t      (testing \"once the mint answers, the line is sent on that step\"\n   232\t        (reset! minted? true)\n   233\t        (let [stepped' (driver/repl-step stepped 1)\n   234\t              read (stream/next requests (oldest requests))\n   235\t              id (rpc/request-id (:dao.stream/value read))]\n   236\t          (is (= :dao.stream/ok (:dao.stream/outcome read)))\n   237\t          (is (= [\"(+ 1 2)\"] (rpc/request-args (:dao.stream/value read))))\n   238\t          (is (empty? (:queued stepped')))\n   239\t          (testing \"and its answer, appended after the mint, is read\"\n   240\t            (stream/append! responses (rpc/success-answer id \"3\"))\n   241\t            (is (= [\"3\"] (texts (driver/repl-step stepped' 2))))))))))\n   242\t\n   243\t\n   244\t(deftest pending-write?-names-every-write-the-operator-is-owed\n   245\t  (testing \"a fresh driver owes nothing, and neither does an idle step\"\n   246\t    (is (false? (driver/pending-write? (driver/create-state))))\n   247\t    (is (false? (driver/pending-write? (driver/repl-step (driver/create-state) 0)))))\n   248\t  (testing \"a request awaiting its response holds the cadence at the base interval\"\n   249\t    (let [{:keys [requests request-cursor state]} (remote)]\n   250\t      (driver/submit-line! (:input state) \"(+ 1 2)\")\n   251\t      (let [stepped (driver/repl-step state 0)]\n   252\t        (is (true? (driver/pending-write? stepped))\n   253\t            \"an outstanding request is a pending write: it must never wait out\n197:(defn- response-cursor-unminted?\n208:(defn pending-write?\n218:               (and (seq (:queued state)) (response-cursor-unminted? state)))))\n387:(defn- submit-remote\n453:            (response-cursor-unminted? state))\n456:        :else (submit-remote state line))\n544:    (submit-remote state (:retrying state))\n556:           (not (response-cursor-unminted? state)))\n560:          (submit-remote line)))\ntest/yin/repl/connect_test.cljc:146:                           connection :dao.stream.apply/detached)]\ntest/yin/repl/connect_test.cljc:151:                            detached :dao.stream.apply/detached)]\ntest/yin/repl/connect_test.cljc:162:            [[:dao.stream.apply/ended :ended \"nothing to reattach\"]\ntest/yin/repl/connect_test.cljc:163:             [:dao.stream.apply/not-found :not-found \"not retried\"]\ntest/yin/repl/connect_test.cljc:164:             [:dao.stream.apply/transport-error :transport-error\ntest/yin/repl/connect_test.cljc:172:  (is (true? (connect/reattachable? {:terminal :dao.stream.apply/detached})))\ntest/yin/repl/connect_test.cljc:173:  (is (false? (connect/reattachable? {:terminal :dao.stream.apply/ended})))\ntest/dao/stream/rpc_test.cljc:170:    (is (= :dao.stream.apply/not-found\ntest/dao/stream/rpc_test.cljc:172:    (is (= :dao.stream.apply/not-found\ntest/dao/stream/rpc_test.cljc:174:    (is (= :dao.stream.apply/detached\ntest/dao/stream/rpc_test.cljc:176:    (is (= :dao.stream.apply/ended\ntest/dao/stream/rpc_test.cljc:178:    (is (= :dao.