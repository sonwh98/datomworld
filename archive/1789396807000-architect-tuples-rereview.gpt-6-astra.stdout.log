     1	(ns dao.space.transact
     2	  "Stateless transaction processing library. Extracts tx-data into raw datoms
     3	   by parsing entity maps, resolving tempids, enforcing uniqueness, and
     4	   generating cardinality-one retractions using dao.space.query."
     5	  (:require [clojure.string :as str]
     6	            [dao.datom :as datom]
     7	            [dao.space.query :as query]))
     8	
     9	
    10	(defn- tempid?
    11	  [x]
    12	  (or (and (string? x) (str/starts-with? x "tid_")) (and (number? x) (neg? x))))
    13	
    14	
    15	(defn- parse-op
    16	  [m e a v default-op]
    17	  (if (map? m)
    18	    (let [{:keys [db/op], :as without-op} (dissoc m :db/op)
    19	          op-kw (or op default-op)
    20	          datom-m-val (get datom/reserved op-kw op-kw)]
    21	      {:op op-kw,
    22	       :e e,
    23	       :a a,
    24	       :v v,
    25	       :m-raw datom-m-val,
    26	       :m-map (when (seq without-op) without-op)})
    27	    (let [op-kw (if (= m (:db/retract datom/reserved)) :db/retract :db/add)
    28	          m-raw (or m (:db/assert datom/reserved))]
    29	      {:op op-kw, :e e, :a a, :v v, :m-raw m-raw, :m-map nil})))
    30	
    31	
    32	(defn- map->datoms
    33	  "Convert an entity map into a seq of [e a v] or parsed ops."
    34	  [m]
    35	  (let [e (or (:db/id m) (str "tid_" (gensym)))]
    36	    (mapcat (fn [[a v]]
    37	              (if (and (or (sequential? v) (set? v))
    38	                       (not (map? v))
    39	                       (not= a :db/valueType)
    40	                       (not= a :db/cardinality))
    41	                (map #(parse-op nil e a % :db/add) v)
    42	                [(parse-op nil e a v :db/add)]))
    43	            (dissoc m :db/id))))
    44	
    45	
    46	(defn- parse-tx-data
    47	  "Normalize tx-data into a flat sequence of parsed ops."
    48	  [tx-data]
    49	  (mapcat (fn [item]
    50	            (if (map? item)
    51	              (map->datoms item)
    52	              (let [[op e a v m] item] [(parse-op m e a v op)])))
    53	          tx-data))
    54	
    55	
    56	(defn- lookup-ident-eid
    57	  "Resolve an ident keyword to its entity id."
    58	  [base-datoms same-tx-ident->eid ident]
    59	  (or (get same-tx-ident->eid ident)
    60	      (let [res (query/match (query/current (query/relation base-datoms))
    61	                  ['_ :db/ident ident])]
    62	        (when (seq res) (nth (first res) 0)))))
    63	
    64	
    65	(defn- effective-ref-attrs-for-tx
    66	  "Compute the set of :db.type/ref attributes, incorporating same-tx schema changes."
    67	  [base-datoms parsed-ops same-tx-ident->eid]
    68	  (let [eid->ident (into {}
    69	                         (keep (fn [d]
    70	                                 (when (= (nth d 1) :db/ident)
    71	                                   [(nth d 0) (nth d 2)])))
    72	                         base-datoms)
    73	        eid->ident (into eid->ident
    74	                         (keep (fn [{:keys [op e a v]}]
    75	                                 (when (and (= op :db/add) (= a :db/ident))
    76	                                   [e v])))
