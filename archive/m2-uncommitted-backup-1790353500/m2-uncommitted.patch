+  (loop [[child & more] (filter (fn [a] (not (contains? enqueued a)))
+                                (distinct child-addrs))
+         n (count enqueued)
+         acc []]
+    (cond
+      (nil? child)
+      {:queue (mapv (fn [a] [a (inc depth)]) acc), :fresh acc}
+
+      (>= n max-parts)
+      (refused :parts-limit {:bound :max-parts, :address child})
+
+      :else
+      (recur more (inc n) (conj acc child)))))
