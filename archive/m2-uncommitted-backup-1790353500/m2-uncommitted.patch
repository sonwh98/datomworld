+  (let [{:keys [root db occ]} (tree-rows tree)]
+    (->> (query/collect
+           (query/q tree-occurrence-query db occ
+                    vm/occurrence-rules root
+                    {:fns vm/occurrence-fns}))
+         (map (fn [[name path]]
