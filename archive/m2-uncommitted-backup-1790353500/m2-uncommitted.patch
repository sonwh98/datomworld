+                  (let [value (:value res)
+                        bytes' (+ bytes (:bytes res))
+                        child-addrs ((:parts-fn format) value)
+                        multi?' (if (nil? multi?)
+                                  (not (nil? child-addrs))
+                                  multi?)
+                        enqueued' (enqueue-children child-addrs enqueued
+                                                    depth max-parts)]
+                    (if (refused? enqueued')
+                      enqueued'
+                      (recur (into queue (:queue enqueued'))
+                             (inc index)
+                             (assoc parts address value)
+                             bytes'
+                             (into enqueued (:fresh enqueued'))
+                             multi?'))))))))))))
