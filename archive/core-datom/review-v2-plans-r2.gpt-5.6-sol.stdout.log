    62	(defn- cesk-return
    63	  "Create a new ASTWalkerVM with updated CESK fields in a single allocation.
    64	   Preserves blocked, store, and scheduler fields from vm.
    65	   Derives :halted? from the new CESK state."
    66	  [^ASTWalkerVM vm control env k val]
    67	  (let [blocked (:blocked? vm)]
    68	    (->ASTWalkerVM blocked
    69	                   (:bridge vm)
    70	                   (:in-stream vm)
    71	                   (:in-cursor vm)
    72	                   (and (not blocked) (nil? control) (nil? k))
    73	                   k
    74	                   (:program vm)
    75	                   control
