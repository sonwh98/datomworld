   381	(defn- collect-telemetry
   382	  [state]
   383	  (if-not (:telemetry-stream state)
   384	    [state []]
   385	    (loop [cursor (:telemetry-cursor state)
   386	           datoms []]
   387	      (let [result (ds/next (:telemetry-stream state) cursor)]
   388	        (if (map? result)
   389	          (recur (:cursor result) (conj datoms (:ok result)))
   390	          [(assoc state :telemetry-cursor cursor) datoms])))))
