   406	(defn handle-effect
   407	  "Dispatch an effect and return {:state updated-state :value v :blocked? bool}.
   408	   park-entry-fns maps :stream/put/:stream/next etc to functions that build wait entries."
   409	  [state effect {:keys [park-entry-fns restore-fn], :as opts}]
   410	  (let [park-entry (get park-entry-fns (:effect effect))
   411	        result
   412	        (case (:effect effect)
   413	          :vm/store-put {:state (assoc state
   414	                                       :store (assoc (:store state)
   415	                                                     (:key effect) (:val effect))),
   416	                         :value (:val effect),
   417	                         :blocked? false}
   418	          :stream/make
   419	          (let [[id s'] (gensym state "stream")
   420	                [stream-ref new-state] (handle-make s' effect id)]
   421	            {:state new-state, :value stream-ref, :blocked? false})
   422	          :stream/cursor
   423	          (let [[id s'] (gensym state "cursor")
   424	                [cursor-ref new-state] (handle-cursor s' effect id)]
   425	            {:state new-state, :value cursor-ref, :blocked? false})
   426	          :stream/put
   427	          (let [result (handle-put state effect)]
   428	            (if (:park result)
   429	              (let [built-entry (when park-entry
   430	                                  (park-entry state effect result))
   431	                    stream-id (:stream-id result)
   432	                    stream (get (:store state) stream-id)
   433	                    ;; Augment for dao.runtime compatibility
   434	                    built-entry
   435	                    (cond-> built-entry
   436	                      (and built-entry (not (:stream built-entry)))
   437	                      (assoc :stream stream)
   438	                      (and built-entry (not (:datom built-entry)))
   439	                      (assoc :datom (:val effect)))
   440	                    task (when (and built-entry restore-fn)
   441	                           (adapter/vm-task built-entry restore-fn))]
   442	                (if (satisfies? ds/IDaoStreamWaitable stream)
   443	                  (if task
   444	                    (rt-result->vm-result
   445	                      (rt/handle-write state stream (:val effect) task)
   446	                      effect)
   447	                    (do (ds/register-writer-waiter! stream built-entry)
   448	                        {:state (assoc (:state result)
   449	                                       :blocked? true
   450	                                       :halted? false
   451	                                       :value :yin/blocked),
   452	                         :value :yin/blocked,
   453	                         :blocked? true}))
   454	                  (handle-stream-block result (or task built-entry))))
   455	              (let [woken (:woke result)
   456	                    base {:state (:state result),
   457	                          :value (:value result),
   458	                          :blocked? false}]
   459	                (if (seq woken)
   460	                  (let [entries (make-woken-run-queue-entries (:state
   461	                                                                result)
   462	                                                              woken
   463	                                                              restore-fn)]
   464	                    (update base :state update :ready-queue into entries))
   465	                  base))))
   466	          :stream/next
   467	          (let [result (handle-next state effect)]
   468	            (if (:park result)
   469	              (let [built-entry (when park-entry
   470	                                  (park-entry state effect result))
   471	                    stream-id (:stream-id result)
   472	                    stream (get (:store state) stream-id)
   473	                    cursor-id (:id (:cursor-ref result))
   474	                    position (:position (get (:store state) cursor-id))
   475	                    ;; Augment for dao.runtime compatibility
   476	                    built-entry
   477	                    (cond-> built-entry
   478	                      (and built-entry (not (:stream built-entry)))
   479	                      (assoc :stream stream)
   480	                      (and built-entry (not (:cursor built-entry)))
   481	                      (assoc :cursor {:position position}))
   482	                    task (when (and built-entry restore-fn)
   483	                           (adapter/vm-task built-entry restore-fn))]
   484	                (if (satisfies? ds/IDaoStreamWaitable stream)
   485	                  (if task
   486	                    (rt-result->vm-result (rt/handle-read state
   487	                                                          stream
   488	                                                          {:position
   489	                                                           position}
   490	                                                          task)
   491	                                          effect)
   492	                    (do (ds/register-reader-waiter! stream
   493	                                                    position
   494	                                                    built-entry)
   495	                        {:state (assoc (:state result)
   496	                                       :blocked? true
   497	                                       :halted? false
   498	                                       :value :yin/blocked),
   499	                         :value :yin/blocked,
   500	                         :blocked? true}))
   501	                  (handle-stream-block result (or task built-entry))))
   502	              {:state (:state result),
   503	               :value (:value result),
   504	               :blocked? false}))
   505	          :stream/take
   506	          (let [result (handle-take state effect)]
   507	            (if (:park result)
   508	              (let [built-entry (when park-entry
   509	                                  (park-entry state effect result))
   510	                    stream-id (:stream-id result)
   511	                    stream (get (:store state) stream-id)
   512	                    ;; Augment for dao.runtime compatibility
   513	                    built-entry (cond-> built-entry
   514	                                  (and built-entry
   515	                                       (not (:stream built-entry)))
