    14	  (:dao.stream.apply/request endpoint))
    15	
    16	
    17	(defn endpoint-response
    18	  "Return the response stream descriptor from an endpoint descriptor."
    19	  [endpoint]
    20	  (:dao.stream.apply/response endpoint))
    21	
    22	
    23	(defn make-endpoint
    24	  "Create an endpoint descriptor from two stream descriptors.
    25	
    26	  Args:
    27	    request-descriptor  - stream descriptor where callee reads requests
    28	    response-descriptor - stream descriptor where caller reads responses
    29	
    30	  Returns:
    31	    {:dao.stream.apply/request <request-desc>
    32	     :dao.stream.apply/response <response-desc>}
