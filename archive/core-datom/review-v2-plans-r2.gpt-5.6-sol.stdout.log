   155	(defn- apply-function
   156	  "Shared logic for applying a function (primitive or closure) to arguments.
   157	   env is the active environment at the call site."
   158	  [state fn-value evaluated-operands k env]
   159	  (cond
   160	    ;; Primitive function
   161	    (fn? fn-value)
   162	    (handle-primitive-result state (apply fn-value evaluated-operands) k env)
   163	    ;; User-defined closure
   164	    (= :closure (:type fn-value))
   165	    (let [{:keys [params body], closure-env :env} fn-value
