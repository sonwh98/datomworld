    61	
    62	(defn- dispatch-call
    63	  [handlers call-op call-args]
    64	  (let [handler (get handlers call-op)]
    65	    (when-not handler
    66	      (throw (ex-info "No bridge handler for dao.stream.apply op"
    67	                      {:op call-op, :available (vec (keys handlers))})))
    68	    (apply handler (or call-args []))))
