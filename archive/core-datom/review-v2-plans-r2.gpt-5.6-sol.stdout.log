    82	(defn- quote-symbols
    83	  [x]
    84	  (cond (symbol? x) (list 'quote x)
    85	        (vector? x) (mapv quote-symbols x)
    86	        (map? x)
    87	        (into {} (map (fn [[k v]] [(quote-symbols k) (quote-symbols v)]) x))
    88	        (or (list? x) (seq? x))
    89	        (if (= 'quote (first x)) x (map quote-symbols x))
    90	        :else x))
