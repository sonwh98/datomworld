   130	(defn maybe-run
   131	  "Run a VM with bridge dispatch if explicit bridge handlers are installed.
   132	
   133	   run-fn must be the VM-specific raw runner that advances the VM until halt or
   134	   block without recursively calling vm/run again."
   135	  [vm run-fn]
   136	  (if-not (installed? vm)
   137	    (run-fn vm)
   138	    (loop [v (run-fn vm)]
   139	      (if (:blocked? v)
   140	        (let [{:keys [handled? vm]} (bridge-step v)]
   141	          (if handled? (recur (run-fn vm)) v))
   142	        v))))
