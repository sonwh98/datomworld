   101	(defn make-woken-run-queue-entries
   102	  "Transform transport-level woken entries (readers or writers) into ready-queue entries.
   103	   Readers (with :cursor-ref) compute :store-updates for cursor advance.
   104	   Writers (no :cursor-ref) just stamp :value.
   105	   If restore-fn is provided, wraps entries as dao.runtime tasks."
   106	  ([state woken] (make-woken-run-queue-entries state woken nil))
   107	  ([state woken restore-fn]
   108	   (mapv (fn [{:keys [entry value position], :as woken-entry}]
   109	           (let [cursor-ref (:cursor-ref entry)
   110	                 store-updates
   111	                 (or (:store-updates woken-entry)
   112	                     (when cursor-ref
   113	                       (let [cursor-id (:id cursor-ref)
