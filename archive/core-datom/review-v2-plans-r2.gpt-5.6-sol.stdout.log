   393	(defn- flush-telemetry
   394	  [state]
   395	  (let [[state' datoms] (collect-telemetry state)
   396	        telemetry-mode (:telemetry-mode state')]
   397	    (doseq [datom datoms]
   398	      (case (if (map? telemetry-mode) (:type telemetry-mode) telemetry-mode)
   399	        :stderr #?(:clj (binding [*out* *err*] (println (format-value datom)))
   400	                   :cljs (*print-err-fn* (format-value datom))
   401	                   :cljd (binding [*out* *err*] (println (format-value datom))))
   402	        :stream (ds/append! (:stream telemetry-mode) datom)
   403	        nil))
   404	    state'))
