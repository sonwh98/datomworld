    22	(defonce ^:private effect-registry (atom {}))
    23	
    24	
    25	(defn- symbol->path
    26	  "Split a dotted symbol into a get-in path of symbols.
    27	   'yin.io.file-input-stream → ['yin 'io 'file-input-stream]"
    28	  [sym]
    29	  (mapv symbol (str/split (str sym) #"\.")))
