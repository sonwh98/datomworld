     1	(ns dao.datom
     2	  "Reserved metadata-entity ids for the d5 m slot (validity + provenance).
     3	
     4	   In a (e a v t m) datom, m is a metadata-entity reference. Low reserved ids
     5	   mirror Datomic's `added` boolean and extend it; ids at `first-user-id` and
     6	   above reference reified metadata entities that carry :db/op and provenance
     7	   as their own datoms.
     8	
     9	   This namespace is the single source of truth for the reserved ids and for
    10	   the boundary between reserved and user space; nothing should compare m or e
    11	   against a bare literal. See docs/design/datom.md.")
    12	
    13	
    14	(def reserved
    15	  "Reserved metadata-entity ids (ident -> id) for the m slot.
    16	   0/1 mirror Datomic's `added` boolean; 2 extends it."
    17	  {:db/retract 0, ; added=false
    18	   :db/assert 1,  ; added=true (emit default)
    19	   :db/derived 2})  ; computed/derived; excluded from content hash
    20	
    21	
    22	(def default-op
    23	  "The m written for emitted datoms when no metadata is supplied: assertion."
    24	  (:db/assert reserved))
    25	
    26	
    27	(def first-user-id
    28	  "Lowest entity id available to user entities; 0 through 15 are reserved.
    29	
    30	   The block is 16 wide rather than 1024 because only the m-slot markers need
    31	   globally fixed numbers. Built-in attributes and type markers live in the a
    32	   and v slots as namespaced keywords, already globally meaningful without an
    33	   id, and a schema entity in e position takes an ordinary stream-local id
    34	   named across streams by its :db/ident. Reserving more would put global
    35	   coordinates in a slot the spec declares a stream-local gauge, and would put
    36	   the floor above what an int8-wide e can represent at all.
    37	
    38	   See docs/design/datom.md, Reserved Entities."
    39	  16)
    40	
    41	
    42	(defn local-datom?
    43	  "True for the runtime-enforced portion of a persisted local d5 datom:
    44	   `[e a v t m]`, with non-negative integer stream-local coordinates `e` and
    45	   `t`, integer `m`, and a namespaced keyword attribute. Negative tempids are
    46	   compilation values and must be resolved before commitment. Canonical value
    47	   encoding is a separate persistence concern and is not decided here."
    48	  [x]
    49	  (and (vector? x)
    50	       (= 5 (count x))
    51	       (integer? (nth x 0))
    52	       (not (neg? (nth x 0)))
    53	       (keyword? (nth x 1))
    54	       (some? (namespace (nth x 1)))
    55	       (integer? (nth x 3))
    56	       (not (neg? (nth x 3)))
    57	       (integer? (nth x 4))))
    58	
    59	
    60	(defn op
    61	  "The m (metadata/op) slot of a datom (a [e a v t m] vector or a Datom record)."
    62	  [datom]
    63	  (if (map? datom) (:m datom) (nth datom 4)))
    64	
    65	
    66	(defn asserted?
    67	  [datom]
    68	  (= (op datom) (:db/assert reserved)))
    69	
    70	
    71	(defn retracted?
    72	  [datom]
    73	  (= (op datom) (:db/retract reserved)))
    74	
    75	
