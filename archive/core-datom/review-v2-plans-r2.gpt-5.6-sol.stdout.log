     1	(ns yin.vm.ffi
     2	  "Explicit host-side dao.stream.apply bridge state for Yin VMs.
     3	
     4	   The bridge is data carried by the VM itself:
     5	     {:handlers {:op/name (fn [& args] ...)}
     6	      :cursor   {:position 0}}
     7	
     8	   Construct VMs with {:bridge handlers} and use ordinary vm/run or vm/eval.
     9	   This namespace provides the normalization and stepping logic those VM
    10	   implementations delegate to."
    11	  (:require [dao.stream :as ds]
    12	            [dao.stream.apply :as dao.stream.apply]
    13	            [yin.vm :as vm]
    14	            [yin.vm.engine :as engine]
    15	            [yin.vm.telemetry :as telemetry]))
    16	
    17	
    18	(defn normalize
    19	  "Normalize bridge input to explicit bridge state.
    20	
    21	   Accepted forms:
    22	   - nil
    23	   - handler map {:op/name fn}
    24	   - explicit bridge map {:handlers {...} :cursor {:position n}}"
    25	  [bridge]
    26	  (cond
    27	    (nil? bridge) nil
    28	    (and (map? bridge) (contains? bridge :handlers))
    29	    (-> bridge
    30	        (update :handlers #(or % {}))
    31	        (update :cursor #(or % {:position 0})))
    32	    (map? bridge) {:handlers bridge, :cursor {:position 0}}
    33	    :else
    34	    (throw
    35	      (ex-info
    36	        "Bridge must be nil, a handler map, or {:handlers ... :cursor ...}"
    37	        {:bridge bridge}))))
    38	
    39	
    40	(defn bridge-from-opts
    41	  "Read bridge configuration from create-vm opts.
    42	
    43	   :bridge is the canonical key."
    44	  [opts]
    45	  (normalize (:bridge opts)))
    46	
    47	
    48	(defn attach
    49	  "Attach explicit bridge state to a VM value."
    50	  [vm bridge]
    51	  (if-let [bridge* (normalize bridge)]
    52	    (assoc vm :bridge bridge*)
    53	    vm))
    54	
    55	
    56	(defn installed?
    57	  "True when the VM carries explicit bridge handlers."
    58	  [vm]
    59	  (boolean (seq (get-in vm [:bridge :handlers]))))
