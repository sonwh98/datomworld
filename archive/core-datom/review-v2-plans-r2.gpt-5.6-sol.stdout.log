    71	(defn- synthesize-resume-entry
    72	  [vm call-id response]
    73	  (let [parked (get-in vm [:parked call-id])
    74	        cursor-data (get-in vm [:store vm/call-out-cursor-key])]
    75	    (when-not parked
    76	      (throw (ex-info "Cannot synthesize dao.stream.apply resume entry"
    77	                      {:call-id call-id,
    78	                       :parked-ids (vec (keys (:parked vm)))})))
    79	    (assoc parked
    80	           :type :dao.stream.apply/resumer
    81	           :value response
    82	           :store-updates {vm/call-out-cursor-key
    83	                           (update cursor-data :position inc)})))
