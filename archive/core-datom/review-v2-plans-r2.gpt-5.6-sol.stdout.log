     1	(ns dao.stream.apply
     2	  "Function application over streams.
     3	
     4	   This namespace models a request/reply stream pair that reifies function
     5	   application as explicit data. A caller emits an operation plus evaluated
     6	   arguments on the request stream, and a callee emits the resulting value on
     7	   the reply stream."
     8	  (:require [dao.stream :as ds]))
     9	
