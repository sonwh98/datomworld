   304	(defn run-on-stream
   305	  "Run a VM while polling its ingress DaoStream between evaluations.
   306	   Internal VM blocking still returns immediately; ingress polling only happens
   307	   when the VM is idle between program batches."
   308	  [vm in-stream load-fn step-fn resume-fn restore-fn]
   309	  (loop [v vm]
   310	    (if (and in-stream (ready-for-ingress? v))
   311	      (let [{:keys [status state]} (ingest-next-program v in-stream load-fn)]
   312	        (case status
   313	          :ok (recur state)
   314	          state))
   315	      (if (ready-for-ingress? v)
   316	        v
   317	        (let [v' (run-loop v active-continuation? step-fn resume-fn restore-fn)]
   318	          (if (and in-stream (not (:blocked? v')) (ready-for-ingress? v'))
   319	            (recur v')
   320	            v'))))))
