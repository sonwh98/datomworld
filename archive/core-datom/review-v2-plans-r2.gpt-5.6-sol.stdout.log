   652	(defn- eval-input-sync-preparsed
   653	  [state' trimmed parsed]
   654	  (try (cond (and (:forms parsed)
   655	                  (= 1 (count (:forms parsed)))
   656	                  (local-only-command-form? (first (:forms parsed))))
   657	             (handle-command state' (first (:forms parsed)))
   658	             (and (:forms parsed)
   659	                  (= 1 (count (:forms parsed)))
   660	                  (shell-command-form? (first (:forms parsed))))
   661	             (handle-command state' (first (:forms parsed)))
   662	             (and (:forms parsed)
   663	                  (= 1 (count (:forms parsed)))
   664	                  (datom-stream? (first (:forms parsed))))
   665	             (eval-datoms state' (first (:forms parsed)))
   666	             (and (:forms parsed)
   667	                  (= 1 (count (:forms parsed)))
   668	                  (ast-map? (first (:forms parsed))))
   669	             (eval-ast state' (first (:forms parsed)))
   670	             (:forms parsed) (if (= :clojure (:lang state'))
   671	                               (eval-clojure-forms state' (:forms parsed))
   672	                               (eval-source state' trimmed))
   673	             (= :clojure (:lang state')) [state' (format-error (:error parsed))]
   674	             :else (eval-source state' trimmed))
   675	       (catch #?(:clj Exception
   676	                 :cljs js/Error
   677	                 :cljd Object)
   678	              error
   679	         (let [[state'' output-text] (collect-output state')]
   680	           [state'' (str output-text (format-error error))]))))
