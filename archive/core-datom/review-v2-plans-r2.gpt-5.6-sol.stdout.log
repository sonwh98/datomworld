   117	                                           :position (inc pos))})))
   118	                 base-entry (assoc entry
   119	                                   :value value
   120	                                   :store-updates store-updates
   121	                                   :position position)]
   122	             (if restore-fn
   123	               (let [task (adapter/vm-task base-entry restore-fn)]
   124	                 (assoc task
   125	                        :value value
   126	                        :position position))
   127	               base-entry)))
   128	         woken)))
