    37	(defrecord ASTWalkerVM
    38	  [blocked?    ; boolean, true if blocked
    39	   bridge      ; explicit host-side FFI bridge state
    40	   in-stream   ; ingress DaoStream carrying AST programs
    41	   in-cursor   ; ingress cursor position
    42	   halted?     ; boolean, true when active continuation has completed
    43	   k           ; reified continuation or nil
    44	   program     ; last ingested AST program
    45	   control     ; current AST node or nil
    46	   env         ; persistent lexical scope map
    47	   id-counter  ; integer counter for unique IDs
    48	   parked      ; parked continuations map
    49	   primitives  ; primitive operations map
    50	   ready-queue ; vector of runnable continuations
    51	   store       ; heap memory map
    52	   value       ; last computed value
    53	   wait-set    ; vector of parked continuations
    54	   telemetry   ; optional telemetry config
    55	   telemetry-step ; telemetry snapshot counter
    56	   telemetry-t ; telemetry transaction counter
    57	   vm-model    ; telemetry model keyword
    58	   ;; waiting on streams
    59	   ])
