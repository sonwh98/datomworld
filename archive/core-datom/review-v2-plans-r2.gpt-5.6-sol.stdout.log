   391	(defn handle-stream-block
   392	  [result entry]
   393	  (if (:park result)
   394	    (let [entry (or entry
   395	                    (throw (ex-info "Parked entry required for blocking stream"
   396	                                    {:result result})))
   397	          new-state (-> (:state result)
   398	                        (rt/park-task entry)
   399	                        (assoc :value :yin/blocked
   400	                               :blocked? true
   401	                               :halted? false))]
   402	      {:state new-state, :value :yin/blocked, :blocked? true})
   403	    {:state (:state result), :value (:value result), :blocked? false}))
