    15	;; AST Walker VM
    16	;; =============================================================================
    17	;;
    18	;; Interprets raw AST maps directly (e.g., {:type :literal, :value 42}).
    19	;; Traverses the in-memory tree via direct map field access
    20	;; (:operator, :operands, :body).
    21	;;
    22	;; Continuations are a linked list with :next pointers:
    23	;;   {:type :eval-operand, :frame ..., :next k}
    24	;; Control is the AST node itself, or nil when awaiting continuation.
    25	;;
    26	;; Scheduler: run-queue + wait-set for cooperative multitasking.
    27	;;   run-queue:  [{:k k, :env env, :value v}]
    28	;;   wait-set:   [{:k k, :env env, :reason :next/:put,
    29	;;                  :cursor-ref ref, :stream-id id}]
