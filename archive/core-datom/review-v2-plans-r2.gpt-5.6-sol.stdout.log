   145	(defn run-with-bridge
   146	  "Compatibility helper: attach handlers to a VM and return the final value.
   147	
   148	   New code should prefer constructing the VM with {:bridge handlers} and then
   149	   using ordinary vm/run or vm/eval."
   150	  [vm handlers]
   151	  (-> vm
   152	      (attach handlers)
   153	      (vm/run)
   154	      (vm/value)))
    90	(defn- handle-primitive-result
    91	  "Shared logic for handling the result of a primitive function application.
    92	   Handles effect dispatch and blocking via engine/handle-effect."
    93	  [state result k env]
    94	  (if (module/effect? result)
    95	    (let [{:keys [state value blocked?]}
    96	          (engine/handle-effect
    97	            state
    98	            result
    99	            {:restore-fn ast-walker-restore,
   100	             :park-entry-fns {:stream/put (fn [_s _e r]
   101	                                            {:k k,
   102	                                             :env env,
   103	                                             :reason :put,
   104	                                             :stream-id (:stream-id r),
   105	                                             :datom (:val result)}),
   106	                              :stream/next (fn [_s _e r]
   107	                                             {:k k,
   108	                                              :env env,
   109	                                              :reason :next,
   110	                                              :cursor-ref (:cursor-ref r),
   111	                                              :stream-id (:stream-id r)})}})]
   112	      (if blocked?
   113	        (assoc state
   114	               :control nil
   115	               :k nil
   116	               :halted? false)
   117	        (cesk-return state nil env k value)))
   118	    (cesk-return state nil env k result)))
