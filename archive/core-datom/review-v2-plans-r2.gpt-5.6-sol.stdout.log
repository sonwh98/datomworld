    31	
    32	(defn register-module!
    33	  "Register bindings into a module. Merges with any existing bindings.
    34	   module-name is a dotted symbol; bindings is a map of symbol -> function.
    35	   (register-module! 'yin.io {'file-input-stream f}) registers under ['yin 'io]."
    36	  [module-name bindings]
    37	  (swap! module-registry update-in (symbol->path module-name) merge bindings)
    38	  module-name)
    39	
    40	
