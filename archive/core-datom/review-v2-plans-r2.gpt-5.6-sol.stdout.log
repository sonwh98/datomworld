   121	(defn- park-and-call
   122	  "Park continuation and register as reader-waiter on call-out response stream."
   123	  [state op args k env]
   124	  (let [;; 1. Park the continuation with a response-processing frame
   125	        response-cont {:type :dao.stream.apply/eval-call, :next k, :env env}
   126	        parked (engine/park-continuation state {:k response-cont, :env env})
   127	        parked-id (get-in parked [:value :id])
   128	        ;; 2. Get response stream from store
   129	        call-out (get-in parked [:store vm/call-out-stream-key])
   130	        cursor-data (get-in parked [:store vm/call-out-cursor-key])
   131	        cursor-pos (:position cursor-data)
   132	        ;; 3. Register as reader-waiter on response stream
   133	        waiter-entry {:k response-cont,
   134	                      :env env,
   135	                      :cursor-ref {:type :cursor-ref,
   136	                                   :id vm/call-out-cursor-key},
   137	                      :reason :next,
   138	                      :stream-id vm/call-out-stream-key}
   139	        _ (when (satisfies? ds/IDaoStreamWaitable call-out)
   140	            (ds/register-reader-waiter! call-out cursor-pos waiter-entry))
   141	        ;; 4. Get request stream from store
   142	        call-in (get-in parked [:store vm/call-in-stream-key])
   143	        ;; 5. Build and emit request
   144	        request (dao.stream.apply/request parked-id op args)
   145	        _ (ds/append! call-in request)]
   146	    ;; 6. Return blocked state
   147	    (assoc (telemetry/emit-snapshot parked :bridge {:bridge-op op})
   148	           :control nil
   149	           :k nil
   150	           :value :yin/blocked
   151	           :blocked? true
   152	           :halted? false)))
