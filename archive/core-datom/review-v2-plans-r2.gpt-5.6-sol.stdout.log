   241	(defn check-wait-set
   242	  "Check wait-set entries against current store.
   243	   Returns updated state with newly runnable entries moved to ready-queue.
   244	
   245	   NOTE: Transport-local waking (IDaoStreamWaitable) is an optimization that
   246	   removes entries from the scheduler's wait-set. This function serves as the
   247	   universal fallback for transports that do not support local registration."
   248	  ([state] (check-wait-set state nil))
   249	  ([state restore-fn]
   250	   (let [wait-set (:wait-set state)
   251	         store (:store state)
   252	         augmented-wait-set
   253	         (mapv (fn [entry]
   254	                 (cond (and (not (:stream entry)) (:cursor-ref entry))
   255	                       (let [cursor-id (:id (:cursor-ref entry))
   256	                             cursor-data (get store cursor-id)
   257	                             stream-id (:stream-id cursor-data)
   258	                             stream (get store stream-id)]
   259	                         (assoc entry
   260	                                :stream stream
   261	                                :cursor {:position (:position cursor-data)}))
   262	                       (and (not (:stream entry)) (:stream-id entry))
   263	                       (assoc entry :stream (get store (:stream-id entry)))
   264	                       :else entry))
   265	               wait-set)
   266	         rt-result (rt/check-wait-set (assoc state
   267	                                             :wait-set augmented-wait-set))
