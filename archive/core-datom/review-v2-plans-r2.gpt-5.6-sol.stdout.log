   702	
   703	(defn eval-input
   704	  [state input-str]
   705	  (let [pending (:pending-input state "")
   706	        combined (if (str/blank? pending)
   707	                   (str/trim input-str)
   708	                   (str pending "\n" (str/trim input-str)))
   709	        balance (bracket-balance combined)]
   710	    (if (pos? balance)
   711	      (deliver-result [(assoc state :pending-input combined) ""])
   712	      (let [state' (dissoc state :pending-input)
   713	            trimmed combined
   714	            parsed (try {:forms (read-clojure-forms trimmed)}
   715	                        (catch #?(:clj Exception
   716	                                  :cljs js/Error
   717	                                  :cljd Object)
   718	                               error
   719	                          {:error error}))
   720	            local-only? (and (:forms parsed)
   721	                             (= 1 (count (:forms parsed)))
   722	                             (local-only-command-form? (first (:forms
   723	                                                                parsed))))]
   724	        (if (and (:remote-endpoint state') (not local-only?))
   725	          (eval-remote-input state' trimmed)
   726	          (let [res (eval-input-sync-preparsed state' trimmed parsed)]
   727	            (if #?(:cljs (and res (.-then res))
   728	                   :cljd (instance? async/Future res)
   729	                   :default false)
   730	              res
   731	              (deliver-result res))))))))
