   284	(defn run-loop
   285	  "Generic eval loop with scheduler support.
   286	   active? is a predicate that returns true when the VM should keep stepping.
   287	   step-fn steps the VM one tick.
   288	   resume-fn pops the ready-queue and resumes, returning updated state or nil."
   289	  [state active? step-fn resume-fn restore-fn]
   290	  (loop [v state]
   291	    (let [q (or (:ready-queue v) [])]
   292	      (cond (active? v) (recur (step-fn v))
   293	            (:blocked? v) (let [v' (check-wait-set v restore-fn)]
   294	                            (if-let [resumed (or (rt/run-once v')
   295	                                                 (resume-fn v'))]
   296	                              (recur resumed)
   297	                              (telemetry/emit-snapshot v' :blocked)))
   298	            (seq q) (if-let [resumed (or (rt/run-once v) (resume-fn v))]
   299	                      (recur resumed)
   300	                      v)
   301	            :else (if (:halted? v) (telemetry/emit-snapshot v :halt) v)))))
