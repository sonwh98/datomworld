    86	(defn bridge-step
    87	  "Handle one pending dao.stream.apply request from the VM's call-in stream.
    88	
    89	   Returns:
    90	   - {:handled? true  :vm vm' ...} when a request was dispatched and resume work
    91	     was enqueued
    92	   - {:handled? false :vm vm  :stream-result <ds/next result>} when the VM is
    93	     blocked for some non-bridge reason"
    94	  [vm]
    95	  (let [handlers (get-in vm [:bridge :handlers])
    96	        cursor (or (get-in vm [:bridge :cursor]) {:position 0})
    97	        store-data (vm/store vm)
    98	        call-in (get store-data vm/call-in-stream-key)
    99	        next-result (ds/next call-in cursor)
   100	        ok (:ok next-result)
   101	        cursor' (:cursor next-result)]
   102	    (if ok
   103	      (let [{request-id :dao.stream.apply/id,
   104	             request-op :dao.stream.apply/op,
   105	             request-args :dao.stream.apply/args}
   106	            ok
   107	            result (dispatch-call handlers request-op request-args)
   108	            call-out (get store-data vm/call-out-stream-key)
   109	            response (dao.stream.apply/response request-id result)
   110	            put-result (ds/append! call-out response)
   111	            woke (:woke put-result)
   112	            entries (if (seq woke)
   113	                      (engine/make-woken-run-queue-entries vm woke)
   114	                      [(synthesize-resume-entry vm request-id response)])
   115	            vm' (-> vm
   116	                    (assoc-in [:bridge :cursor] cursor')
   117	                    (update :ready-queue (fnil into []) entries)
   118	                    (telemetry/emit-snapshot
   119	                      :bridge
   120	                      {:bridge-op request-op,
   121	                       :arg-shape (mapv telemetry/type-tag request-args)}))]
   122	        {:handled? true,
   123	         :vm vm',
   124	         :request ok,
   125	         :wake-count (count woke),
   126	         :entry-count (count entries)})
   127	      {:handled? false, :vm vm, :stream-result next-result})))
