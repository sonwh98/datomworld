     1	(ns yin.vm.runtime-adapter
     2	  (:require
     3	    [dao.runtime :as rt]))
     4	
     5	
     6	(defn- calculate-store-updates
     7	  [rt vm-entry _value position]
     8	  (if-let [cursor-ref (:cursor-ref vm-entry)]
     9	    (let [cursor-id (:id cursor-ref)
    10	          cursor-data (get (:store rt) cursor-id)]
    11	      (when position {cursor-id (assoc cursor-data :position (inc position))}))
    12	    (:store-updates vm-entry)))
    13	
    14	
    15	(defn vm-task
    16	  "Wrap a VM entry as a dao.runtime task."
    17	  [vm-entry restore-fn]
    18	  (let [vm-entry (or (:task vm-entry) vm-entry)]
    19	    (merge vm-entry
    20	           {:task vm-entry,
    21	            :resume
    22	            (fn [rt task-entry value]
    23	              (let [vm-entry (:task task-entry)
    24	                    value (or value (:value task-entry))
    25	                    position (or (:position task-entry) (:position vm-entry))
    26	                    store-updates
    27	                    (calculate-store-updates rt vm-entry value position)
    28	                    base (assoc rt
    29	                                :store (merge (:store rt) store-updates)
    30	                                :blocked? false
    31	                                :halted? false
    32	                                :ready-queue (:ready-queue rt)
    33	                                :wait-set (:wait-set rt))]
    34	                (restore-fn base vm-entry value)))})))
    35	
    36	
    37	(defn enqueue-woken-vm-entries
    38	  "Translate raw transport woken entries into dao.runtime ready-queue entries
    39	   using the VM-specific resume wrapper."
    40	  [rt woken restore-fn]
    41	  (let [tasks (mapv (fn [{:keys [entry value position]}]
    42	                      (let [task (vm-task entry restore-fn)]
    43	                        (assoc task
    44	                               :value value
    45	                               :position position)))
    46	                    woken)]
    47	    (rt/enqueue-ready rt tasks)))
