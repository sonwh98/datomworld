     1	(ns yin.vm.stream-driver
     2	  (:require
     3	    [dao.stream :as ds]))
     4	
     5	
     6	(defn ready-for-ingress?
     7	  "Returns true when the VM is between evaluations and can poll :in-stream."
     8	  [vm]
     9	  (let [has-bytecode? (contains? vm :bytecode)
    10	        bytecode (:bytecode vm)
    11	        no-bytecode? (and has-bytecode?
    12	                          (or (nil? bytecode)
    13	                              (and (sequential? bytecode) (empty? bytecode))))]
    14	    (and (not (:blocked? vm))
    15	         (empty? (or (:ready-queue vm) []))
    16	         (empty? (or (:wait-set vm) []))
    17	         (nil? (:k vm))
    18	         (or (:halted? vm) (nil? (:control vm)) no-bytecode?))))
    19	
    20	
    21	(defn ingest-next-program
    22	  "Poll one program batch from in-stream and hand it to load-fn.
    23	   Returns {:status :ok|:blocked|:end :state vm'}."
    24	  [vm in-stream load-fn]
    25	  (let [cursor (or (:in-cursor vm) {:position 0})
    26	        result (ds/next in-stream cursor)]
    27	    (cond (map? result) (let [cursor' (:cursor result)
    28	                              vm' (-> (assoc vm :in-cursor cursor')
    29	                                      (load-fn (:ok result))
    30	                                      (assoc :in-cursor cursor'))]
    31	                          {:status :ok, :state vm'})
    32	          (= :blocked result) {:status :blocked,
    33	                               :state (assoc vm
    34	                                             :halted? true
    35	                                             :blocked? false)}
    36	          (= :end result) {:status :end,
    37	                           :state (assoc vm
    38	                                         :halted? true
    39	                                         :blocked? false)}
    40	          (= :daostream/gap result)
    41	          (throw (ex-info "VM ingress cursor fell behind the input stream"
    42	                          {:cursor cursor, :vm-model (:vm-model vm)}))
    43	          :else (throw
    44	                  (ex-info
    45	                    "Unexpected DaoStream response while ingesting VM program"
    46	                    {:result result, :vm-model (:vm-model vm)})))))
    47	
    48	
    49	(defn step-on-stream
    50	  "If the VM is idle, ingest one pending program batch before executing a single step."
    51	  [vm in-stream load-fn step-fn]
    52	  (cond (and in-stream (ready-for-ingress? vm))
    53	        (let [{:keys [status state]}
    54	              (ingest-next-program vm in-stream load-fn)]
    55	          (case status
    56	            :ok (step-fn state)
    57	            state))
    58	        (ready-for-ingress? vm) vm
    59	        :else (step-fn vm)))
