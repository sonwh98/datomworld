t    (refl-descriptor state))\n   691\t\n   692\t\n   693\t  stream/IDaoStreamReader\n   694\t\n   695\t  (cursor\n   696\t    [_ anchor]\n   697\t    (refl-cursor state anchor))\n   698\t\n   699\t\n   700\t  (next\n   701\t    [_ c]\n   702\t    (refl-next state c))\n   703\t\n   704\t\n   705\t  stream/IDaoStreamWriter\n   706\t\n   707\t  (append!\n   708\t    [_ v]\n   709\t    (refl-append state v))\n   710\t\n   711\t\n   712\t  stream/IDaoStreamClosable\n   713\t\n   714\t  (close!\n   715\t    [_]\n   716\t    (refl-close state)))\n   717\t\n   718\t\n   719\t;; =============================================================================\n   720\t;; The remote descriptor dispatch (2.2)\n   721\t;; =============================================================================\n   722\t\n   723\t(defn- valid-remote-descriptor?\n   724\t  \"A remote descriptor names a stream and a channel: the generic\n   725\t   envelope rules, the :dao.stream/remote type, and a channel\n   726\t   descriptor. It carries no authorization, no surface and no\n   727\t   anchors; the mirror answers those.\"\n   728\t  [d]\n   729\t  (and (stream/valid-descriptor? d)\n   730\t       (= :dao.stream/remote (:dao.stream/type d))\n   731\t       (contains? d :dao.stream/channel)))\n   732\t\n   733\t\n   734\t(defn attacher\n   735\t  \"The composition's :dao.stream/attach entry for :dao.stream/remote\n   736\t   descriptors; a dynamic dispatch table has this entry and no\n   737\t   :dao.stream/create one, because attaching through this transport\n   738\t   never creates. `opts` carries the composition data:\n   739\t   :dao.stream.remote/channels maps each channel descriptor this peer\n   740\t   reaches to its own end {:reader r :writer w} -- two ring buffers in\n   741\t   one process today, the ws, udp and pair channels of section 3\n   742\t   later; :dao.stream.remote/events is the optional event writer the\n   743\t   links emit on; :dao.stream.remote/resend-after is the links'\n   744\t   resend-after k, unbounded on an ordered reliable channel and small\n   745\t   on udp; :dao.stream.remote/budget is the budget stamped on every\n   746\t   next request. One link is kept per channel descriptor, shared by\n   747\t   every reflection through that channel. attach! answers ok at once\n   748\t   with a reflection handle and a local, opaque\n   749\t   :dao.stream/attachment -- the contract's deferred remote\n   750\t   confirmation -- and the link sends one descriptor probe for the\n   751\t   identity: its answer is the reflection's confirmation, not-found\n   752\t   marking the reflection gone, ok recording the source's descriptor\n   753\t   and declared surface.\"\n   754\t  [opts]\n   755\t  (let [channels (:dao.stream.remote/channels opts)\n   756\t        policy (select-keys opts [:dao.stream.remote/events\n   757\t                                  :dao.stream.remote/resend-after\n   758\t                                  :dao.stream.remote/budget])\n   759\t        links (atom {})]\n   760\t    (fn [descriptor]\n   761\t      (if-not (valid-remote-descriptor? descriptor)\n   762\t        (result :dao.stream/invalid-descriptor)\n   763\t        (let [cd (:dao.stream/channel descriptor)]\n   764\t          (if-not (contains? channels cd)\n   765\t            (result :dao.stream/not-found)\n   766\t            (do (swap! links\n   767\t                       (fn [m]\n   768\t                         (if (contains? m cd)\n   769\t                           m\n   770\t                           (assoc m cd\n   771\t                                  (new-link (get channels cd) policy)))))\n   772\t                (let [link (get @links cd)\n   773\t                      refl (atom {:link link\n   774\t                                  :descriptor descriptor\n   775\t                                  :identity (:dao.stream/identity\n   145\t                                   :dao.stream.rpc/value value}))\n   146\t\n   147\t\n   148\t(defn- ids-in-use?\n   149\t  [state id]\n   150\t  (or (= id (get-in state [:unsent :id]))\n   151\t      (contains? (:outstanding state) id)\n   152\t      (boolean (some #(= id (:dao.stream.rpc/id %)) (:completed state)))))\n   153\t\n   154\t\n   155\t;; Defined below with the other completion bookkeeping; allocation failure is\n   156\t;; a terminal transition and owes the same conservative loss as every other.\n   157\t(declare lose-outstanding)\n   158\t\n   159\t\n   160\t(defn- allocation-failure\n   161\t  [state code]\n   162\t  (let [state (-> state\n   163\t                  (lose-outstanding :dao.stream.rpc/allocator-error true)\n   164\t                  (append-diagnostic code (:next-id state)))]\n   165\t    (rpc-result :dao.stream.rpc/allocator-error state\n   166\t                :dao.stream.rpc/diagnostic (last (:diagnostics state)))))\n   167\t\n   168\t\n   169\t(defn- allocate-request\n   170\t  [state op args]\n   171\t  (let [id (:next-id state)]\n   172\t    (cond\n   173\t      (not (safe-id? id))\n   174\t      (allocation-failure state :dao.stream.rpc/id-exhausted)\n   175\t\n   176\t      (ids-in-use? state id)\n   177\t      (allocation-failure state :dao.stream.rpc/id-collision)\n   178\t\n   179\t      :else\n   180\t      (let [request {:id id\n   181\t                     :op op\n   182\t                     :args args\n   183\t                     :encoded (apply/request id op args)}]\n   184\t        (rpc-result :dao.stream.rpc/allocated\n   185\t                    (-> state\n   186\t                        (assoc :unsent request)\n   187\t                        (update :next-id inc)))))))\n   188\t\n   189\t\n   190\t(defn- accept-unsent\n   191\t  [state request]\n   192\t  (-> state\n   193\t      (assoc :unsent nil)\n   194\t      (assoc-in [:outstanding (:id request)]\n   195\t                {:op (:op request) :args (:args request)})))\n   196\t\n   197\t\n   198\t(defn- attempt-unsent\n   199\t  [state]\n   200\t  (let [request (:unsent state)\n   201\t        append-result (valid-operation-result\n   202\t                        :append!\n   203\t                        (apply/put-request! (:writer state) (:encoded request)))\n   204\t        outcome (:dao.stream/outcome append-result)]\n   205\t    (case outcome\n   206\t      :dao.stream/ok\n   207\t      (rpc-result :dao.stream.rpc/requested\n   208\t                  (accept-unsent state request)\n   209\t                  :dao.stream.rpc/id (:id request)\n   210\t                  :dao.stream.rpc/append append-result)\n   211\t\n   212\t      :dao.stream/full\n   213\t      (rpc-result :dao.stream.rpc/pending-request state\n   214\t                  :dao.stream.rpc/id (:id request)\n   215\t                  :dao.stream.rpc/append append-result)\n   216\t\n   217\t      (:dao.stream/closed :dao.stream/invalid-value :dao.stream/transport-error)\n   218\t      (let [state (-> state\n   219\t                      (assoc :unsent nil)\n   220\t                      (append-completion request :reason outcome))]\n   221\t        (rpc-result :dao.stream.rpc/request-undeliverable state\n   222\t                    :dao.stream.rpc/id (:id request)\n   223\t                    :dao.stream.rpc/reason outcome\n   224\t                    :dao.stream.rpc/append append-result))\n   225\t\n   226\t      ;; A malformed writer answer becomes transport-error in\n   227\t      ;; valid-operation-result, so this branch is defensive only.\n   228\t      (let [state (-> state\n   229\t                      (assoc :unsent nil)\n   230\t                      (append-completion request :reason :dao.stream/transport-error))]\n   231\t        (rpc-result :dao.stream.rpc/request-undeliverable state\n   232\t                    :dao.stream.rpc/id (:id request)\n   233\t                    :dao.stream.rpc/reason :dao.stream/transport-error\n   234\t                    :dao.stream.rpc/append append-result)))))\n   235\t\n   236\t\n   237\t(defn request!\n   238\t  \"Attempt one request append, returning an explicit next state.\n   239\t\n   240\t   If a previous append was full, this retries the exact already-allocated\n   241\t   envelope and ignores `op`/`args`; it never allocates a replacement id.  The\n   242\t   function makes one append attempt at most and never spins on `:full`.\"\n   243\t  [state op args]\n   244\t  (cond\n   245\t    (:terminal state)\n   460\t\n   461\t(defn take-diagnostics\n   462\t  \"Return `[diagnostics next-state]`, clearing the unpublished diagnostic outbox\n   463\t   exactly once.  Diagnostics are bounded by publication exactly as completions\n   464\t   are: a noisy shared response medium can produce one per read, so a caller\n   465\t   that never publishes would grow this vector for the session's lifetime.\"\n   466\t  [state]\n   467\t  [(:diagnostics state) (assoc state :diagnostics [])])\n   468\t\n   469\t\n   470\t(defn rebind\n   471\t  \"Replace a detached client's writer (and optionally reader) without creating\n   472\t   a cursor or replacing its monotonic id allocator. Only `/detached` is\n   473\t   reconnectable; other terminal reasons remain terminal.\"\n   474\t  ([state writer me]\n   475\t   (if (= :dao.stream.apply/detached (:terminal state))\n   476\t     (assoc state :writer writer :me me :terminal nil)\n   477\t     state))\n   478\t  ([state writer reader me]\n   479\t   (if (= :dao.stream.apply/detached (:terminal state))\n   480\t     (assoc state :writer writer :reader reader :me me :terminal nil)\n   481\t     state)))\n   338\t  \"Compose one client boundary and attach, returning immediately.\n   339\t\n   340\t   The order is the point and is observable: descriptor, then medium, then both\n   341\t   cursors, then the boundary, and only then `attach!`.  A successful result\n   342\t   carries the connection value and the RPC client state built from the *whole*\n   343\t   attach result, so the response decoder filters on the attachment the\n   344\t   transport minted.\"\n   345\t  [{:keys [url identity host traffic]}]\n   346\t  (let [parsed (parse-url url {:identity identity})]\n   347\t    (if-not (= :yin.repl.connect/parsed (get parsed outcome-key))\n   348\t      parsed\n   349\t      (let [descriptor (get parsed descriptor-key)]\n   350\t        (if-not (host-common/adapter? host)\n   351\t          (failure :yin.repl.connect/no-host-adapter\n   352\t                   (host-common/missing-message \"(connect …) is not wired\"))\n   353\t          (let [{:keys [traffic response-cursor lifecycle-cursor]} (boundary traffic)\n   354\t                attach! (try (attacher traffic (:connect! host))\n   355\t                             (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))]\n   356\t            (cond\n   357\t              (nil? attach!)\n   358\t              (failure :yin.repl.connect/invalid-composition\n   359\t                       \"The client boundary composition was refused\")\n   360\t\n   361\t              (or (nil? response-cursor) (nil? lifecycle-cursor))\n   362\t              (failure :yin.repl.connect/invalid-composition\n   363\t                       \"The traffic medium minted no cursor\")\n   364\t\n   365\t              :else\n   366\t              (let [result (attach! descriptor)\n   367\t                    attachment (:dao.stream/attachment result)]\n   368\t                (if-not (= :dao.stream/ok (:dao.stream/outcome result))\n   369\t                  (failure :yin.repl.connect/attach-failed\n   370\t                           (attach-outcome-message url result))\n   371\t                  {outcome-key :yin.repl.connect/attached\n   372\t                   connection-key {:url url\n   373\t                                   :descriptor descriptor\n   374\t                                   :traffic traffic\n   375\t                                   :response-cursor response-cursor\n   376\t                                   :lifecycle-cursor lifecycle-cursor\n   377\t                                   :attach! attach!\n   378\t                                   :attachment attachment\n   379\t                                   :handle (:dao.stream/handle result)\n   380\t                                   :decode (rpc-ws/decoder attachment)\n   381\t                                   :status :connecting\n   382\t                                   :detached-by nil\n   383\t                                   :ledger :untried}\n   384\t                   client-key (rpc-ws/init-client result traffic response-cursor)})))))))))\n   385\t\n   386\t\n   387\t(def terminal-statuses\n   388\t  \"Statuses the boundary itself reported.  They are conclusions, so a later\n   420\t\n   421\t\n   422\t(defn reattachable?\n   423\t  \"True when the RPC client's terminal reason is the one reconnectable one.\"\n   424\t  [client]\n   425\t  (= :dao.stream.apply/detached (:terminal client)))\n   426\t\n   427\t\n   428\t(defn reattach\n   429\t  \"Reattach an existing connection: `attach!` plus `rebind`.\n   430\t\n   431\t   The traffic medium, both cursors, and the monotonic id allocator survive;\n   432\t   only the writer, the attachment id, and the decoder built around it change.\"\n   433\t  [connection client]\n   434\t  (cond\n   435\t    (not (fn? (:attach! connection)))\n   436\t    (failure :yin.repl.connect/invalid-composition\n   437\t             \"This connection has no boundary to reattach through\")\n   438\t\n   439\t    (not (reattachable? client))\n   440\t    (failure :yin.repl.connect/not-reattachable\n   441\t             (str \"Only a dropped connection reattaches; this one ended as \"\n   442\t                  (pr-str (:terminal client))))\n   443\t\n   444\t    :else\n   445\t    (let [result ((:attach! connection) (:descriptor connection))\n   446\t          attachment (:dao.stream/attachment result)]\n   447\t      (if-not (= :dao.stream/ok (:dao.stream/outcome result))\n   448\t        (failure :yin.repl.connect/attach-failed\n   449\t                 (attach-outcome-message (:url connection) result))\n   450\t        {outcome-key :yin.repl.connect/reattached\n   451\t         connection-key (assoc connection\n   452\t                               :attachment attachment\n   453\t                               :handle (:dao.stream/handle result)\n   454\t                               :decode (rpc-ws/decoder attachment)\n   455\t                               :status :connecting\n   456\t                               :detached-by nil)\n   457\t         client-key (rpc-ws/rebind client result)}))))\n   458\t\n   459\t\n   460\t;; =============================================================================\n   525\t(defn observe\n   526\t  \"Advance the boundary's lifecycle cursor, returning `[connection events]`.\n   527\t\n   528\t   This is the whole of `Connected to …` and its failures: the R1 decoder\n   529\t   translates each deposited envelope, and only the neutral vocabulary is\n   530\t   interpreted here.  It is total over `next`: `ok` advances to the exact\n   531\t   successor, `gap` reports the loss and resumes at the recovery cursor, and\n   532\t   every other outcome is recorded in the ledger and ends the observation.\"\n   533\t  ([connection] (observe connection lifecycle-budget))\n   534\t  ([connection budget]\n   535\t   (if (or (nil? connection) (nil? (:lifecycle-cursor connection)))\n   536\t     [connection []]\n   537\t     (loop [remaining budget\n   538\t            connection connection\n   539\t            events []]\n   540\t       (if (zero? remaining)\n   541\t         [connection events]\n   542\t         (let [result (stream/next (:traffic connection) (:lifecycle-cursor connection))\n   543\t               outcome (:dao.stream/outcome result)]\n   544\t           (case outcome\n   545\t             :dao.stream/ok\n   546\t             (let [connection (assoc connection\n   547\t                                     :lifecycle-cursor (:dao.stream/cursor result)\n   548\t                                     :ledger outcome)\n   549\t                   lifecycle (decode-lifecycle connection (:dao.stream/value result))\n   550\t                   [connection' produced] (if lifecycle\n   551\t                                            (transition connection lifecycle)\n   552\t                                            [connection nil])]\n   553\t               (recur (dec remaining) connection' (cond-> events produced (conj produced))))\n   554\t\n   555\t             :dao.stream/gap\n   556\t             (recur (dec remaining)\n   557\t                    (assoc connection\n   558\t                           :lifecycle-cursor (:dao.stream/cursor result)\n   559\t                           :ledger outcome)\n   560\t                    (conj events\n   561\t                          (event :yin.repl.connect/notice\n   562\t                                 \";; connection events lost: resumed at the recovery cursor\")))\n   563\t\n   564\t             :dao.stream/blocked\n   565\t             [(assoc connection :ledger outcome) events]\n   566\t\n   567\t             [(assoc connection :ledger outcome)\n   568\t              (conj events\n   569\t                    (event :yin.repl.connect/notice\n   570\t                           (str \";; connection events \" (name outcome))))])))))))\nsrc/cljc/dao/stream/ws_project.cljc:161:(defn make-acceptor\nsrc/cljc/dao/stream/ws_project.cljc:248:(defn accept-step!\nsrc/cljc/dao/stream/ws_project.cljc:305:(defn dial\nsrc/cljc/dao/stream/ws_project.cljc:348:(defn dial-attach!\nsrc/cljc/dao/stream/ws_project.cljc:387:(defn dial-step!\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"Completed-GMT: 2026-09-27 13:19:51 GMT\nCompleted-Local: 2026-09-27 20:19:51 Asia/Ho_Chi_Minh\n\n**Ruling: A, with a strict network boundary.** Keep `dao.stream.apply.cljc` and the VM FFI bridge unchanged. The VM constructs requests and validates responses through that namespace, and its walker appends those requests to the VM call stream ([ast_walker.cljc](/Users/sto/workspace/datomworld/src/cljc/yin/vm/ast_walker.cljc:195), [ffi.cljc](/Users/sto/workspace/datomworld/src/cljc/yin/vm/ffi.cljc:95), [ffi.cljc](/Users/sto/workspace/datomworld/src/cljc/yin/vm/ffi.cljc:225)). Moving this API into `dao.stream.rpc` would make core VM evaluation depend on a REPL client module. The plan retires `dao.stream.apply` **as a wire envelope** while expressly retaining the VM FFI bridge ([implementation plan](/Users/sto/workspace/datomworld/docs/design/dao.stream.remote.implementation-plan.md:199)). The implementer’s dependency finding is correct ([findings](/Users/sto/workspace/datomworld/collab/1790497441896-vm-engineer-dao-stream-remote-slice5.r4.claude.findings.md:8)).\n\nGive the implementer these slice 5 instructions:\n\n1. **Delete** `dao.stream.serving.cljc` and `dao.stream.rpc.ws.cljc`, and remove their REPL requires and call sites. The plan explicitly retires both ([implementation plan](/Users/sto/workspace/datomworld/docs/design/dao.stream.remote.implementation-plan.md:188), [implementation plan](/Users/sto/workspace/datomworld/docs/design/dao.stream.remote.implementation-plan.md:197)). Leave `dao.stream.apply.cljc`, `yin.vm.ffi.cljc`, and `yin.vm.ast_walker.cljc` intact.\n\n2. **Rework `dao.stream.rpc.cljc` for the REPL reflection pair.** Keep its caller-owned ID allocation, pending request, completion, and rebind state. Its current request encoder, response validator, and server alias still use the apply envelope ([rpc.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/rpc.cljc:100), [rpc.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/rpc.cljc:169), [rpc.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/rpc.cljc:295)). Replace those **network-path** uses with the REPL service’s request and answer values and direct `stream/append!`/`stream/next`; correlate by the RPC ID. Do not put `apply/request` or `apply/success-response` on either reflection. Translate reflection read failures into the existing client terminal vocabulary: `:dao.stream/transport-error` with `:dao.stream.remote/reason :dao.stream.remote/not-found` → `:dao.stream.apply/not-found`; with `:dao.stream.remote/channel-gone` → `:dao.stream.apply/detached`; bare `:dao.stream/end` → `:dao.stream.apply/ended`; other transport errors → `:dao.stream.apply/transport-error`. Preserve the underlying read result for diagnostics. The reflection returns those reasoned errors and `end` directly ([remote.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/remote.cljc:603)); the RPC client and driver already distinguish a reconnectable `detached` terminal ([rpc.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/rpc.cljc:366), [driver.cljc](/Users/sto/workspace/datomworld/src/cljc/yin/repl/driver.cljc:209)). **Translation alone is insufficient** while RPC still emits apply envelopes.\n\n3. **Rework `yin.repl.serve.cljc`, `connect.cljc`, and `adapter.cljc` together.** Serve one shared REPL state over two identities, `yin.repl/requests` and `yin.repl/answers`; retain the existing eval and incomplete-input decisions, but express replies as service answer values instead of apply success/error envelopes ([serve.cljc](/Users/sto/workspace/datomworld/src/cljc/yin/repl/serve.cljc:559), [adapter.cljc](/Users/sto/workspace/datomworld/src/cljc/yin/repl/adapter.cljc:167)). The server composes the two retained streams with `dao.stream.remote`’s mirror over a WebSocket channel accepted through `dao.stream.ws-project/make-acceptor` and `accept-step!`. The client uses `dao.stream.ws-project/dial` and `dial-attach!`, then attaches both remote descriptors through `dao.stream.remote/attacher`; the requests reflection writes and the answers reflection reads ([ws_project.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/ws_project.cljc:161), [ws_project.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/ws_project.cljc:305), [ws_project.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/ws_project.cljc:348), [remote.cljc](/Users/sto/workspace/datomworld/src/cljc/dao/stream/remote.cljc:734)). Keep the URL as the convention for that descriptor pair, as the plan requires ([implementation plan](/Users/sto/workspace/datomworld/docs/design/dao.stream.remote.implementation-plan.md:202)). Update `driver.cljc` only where the new connection composition changes its calls or state.\n\nThis leaves the apply envelope solely on the VM’s local FFI call bridge. It does **not** relabel generic DaoStream descriptor or operation envelopes as apply envelopes; those are separate contract data ([dao.stream.md](/Users/sto/workspace/datomworld/docs/design/dao.stream.md:322)).\n\nStatus: COMPLETE"}}
