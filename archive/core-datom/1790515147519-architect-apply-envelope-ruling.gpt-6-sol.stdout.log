the returned state and\n     7\t   decides when to call `serve-once!` again.\"\n     8\t  (:require [dao.stream :as stream]))\n     9\t\n    10\t\n    11\t;; =============================================================================\n    12\t;; Envelope\n    13\t;; =============================================================================\n    14\t\n    15\t(def id-key :dao.stream.apply/id)\n    16\t(def op-key :dao.stream.apply/op)\n    17\t(def args-key :dao.stream.apply/args)\n    18\t(def ok-key :dao.stream.apply/ok)\n    19\t(def error-key :dao.stream.apply/error)\n    20\t(def code-key :dao.stream.apply/code)\n    21\t(def message-key :dao.stream.apply/message)\n    22\t\n    23\t\n    24\t(defn correlation-id?\n    25\t  \"True for a usable opaque correlation id.  Allocation policy (including the\n    26\t   cross-host safe-integer bound) belongs to the RPC client, not this envelope.\"\n    27\t  [id]\n    28\t  (some? id))\n    29\t\n    30\t\n    31\t(defn request\n    32\t  \"Construct a request envelope.  Use `request?` to validate data received from\n    33\t   a stream; constructors deliberately add no interpretation to arguments.\"\n    34\t  [id op args]\n    35\t  {id-key id op-key op args-key args})\n    36\t\n    37\t\n    38\t(defn request?\n    39\t  \"True when value is a valid request envelope.  Unknown keys are intentionally\n    40\t   ignored so the envelope remains open.\"\n    41\t  [value]\n    42\t  (and (map? value)\n    43\t       (correlation-id? (get value id-key))\n    44\t       (keyword? (get value op-key))\n    45\t       (vector? (get value args-key))))\n    46\t\n    47\t\n    48\t(defn request-id\n    49\t  [value]\n    50\t  (get value id-key))\n    51\t\n    52\t\n    53\t(defn request-op\n    54\t  [value]\n    55\t  (get value op-key))\n    56\t\n    57\t\n    58\t(defn request-args\n    59\t  [value]\n    60\t  (get value args-key))\n    61\t\n    62\t\n    63\t(defn error\n    64\t  \"Construct portable error data.  Codes are qualified keywords and messages\n    65\t   are ordinary strings, never host exception values.\"\n    66\t  [code message]\n    67\t  {code-key code message-key message})\n    68\t\n    69\t\n    70\t(defn error?\n    71\t  [value]\n    72\t  (and (map? value)\n    73\t       (stream/qualified-keyword?* (get value code-key))\n    74\t       (string? (get value message-key))))\n    75\t\n    76\t\n    77\t(defn success-response\n    78\t  \"Construct a successful response preserving the request id.\"\n    79\t  [id value]\n    80\t  {id-key id ok-key value})\n    81\t\n    82\t\n    83\t(defn error-response\n    84\t  \"Construct an error response preserving the request id.\"\n    85\t  [id code message]\n    86\t  {id-key id error-key (error code message)})\n    87\t\n    88\t\n    89\t(defn response?\n    90\t  \"True when value is a valid response envelope.  A response contains exactly\n    91\t   one of `:dao.stream.apply/ok` or `/error`; nil is a valid success value.\"\n    92\t  [value]\n    93\t  (and (map? value)\n    94\t       (correlation-id? (get value id-key))\n    95\t       (not= (contains? value ok-key) (contains? value error-key))\n    96\t       (or (contains? value ok-key)\n    97\t           (error? (get value error-key)))))\n    98\t\n    99\t\n   100\t(defn response-id\n   101\t  [value]\n   102\t  (get value id-key))\n   103\t\n   104\t\n   105\t(defn response-ok\n   106\t  [value]\n   107\t  (get value ok-key))\n   108\t\n   109\t\n   110\t(defn response-error\n   111\t  [value]\n   112\t  (get value error-key))\n   113\t\n   114\t\n   115\t;; =============================================================================\n   145\t\n   146\t(defn endpoint-response\n   147\t  [value]\n   148\t  (get value response-key))\n   149\t\n   150\t\n   151\t(defn put-request!\n   152\t  \"Append one validated request to an explicit writer handle.  Invalid envelope\n   153\t   data is reported as application data and is never appended.\"\n   154\t  [request-handle request-value]\n   155\t  (if (request? request-value)\n   156\t    (stream/append! request-handle request-value)\n   157\t    {:dao.stream.apply/outcome :dao.stream.apply/invalid-request\n   158\t     :dao.stream.apply/value request-value}))\n   159\t\n   160\t\n   161\t(defn put-response!\n   162\t  \"Append one validated response to an explicit writer handle.\"\n   163\t  [response-handle response-value]\n   164\t  (if (response? response-value)\n   165\t    (stream/append! response-handle response-value)\n   166\t    {:dao.stream.apply/outcome :dao.stream.apply/invalid-response\n   167\t     :dao.stream.apply/value response-value}))\n   168\t\n   169\t\n   170\t(defn next-request\n   171\t  \"Read one raw request value at the explicit cursor.  Validation belongs to the\n   172\t   server step because malformed stream data must be consumed once, not retried.\"\n   173\t  [request-handle request-cursor]\n   174\t  (stream/next request-handle request-cursor))\n   175\t\n   176\t\n   177\t(defn next-response\n   178\t  \"Read one raw response value at the explicit cursor.\"\n   179\t  [response-handle response-cursor]\n   180\t  (stream/next response-handle response-cursor))\n   181\t\n   182\t\n   183\t;; =============================================================================\n   184\t;; Pure request dispatch\n   185\t;; =============================================================================\n   186\t\n   187\t(defn dispatch-request\n   188\t  \"Invoke at most one handler for a validated request and return its correlated\n   189\t   response data.  Unknown operations and host handler failures are ordinary,\n   190\t   portable error responses; no exception escapes into a polling driver.\"\n   191\t  [handlers request-value]\n   192\t  (cond\n   193\t    (not (request? request-value))\n   194\t    (when (correlation-id? (request-id request-value))\n   195\t      (error-response (request-id request-value)\n   196\t                      :dao.stream.apply/malformed-request\n   197\t                      \"Malformed request envelope\"))\n   198\t\n   199\t    :else\n   200\t    (let [id (request-id request-value)\n   201\t          op (request-op request-value)\n   202\t          handler (get handlers op)]\n   203\t      (if-not (fn? handler)\n   204\t        (error-response id :dao.stream.apply/unknown-operation\n   205\t                        \"No handler for operation\")\n   206\t        (try\n   207\t          (success-response id (apply handler (request-args request-value)))\n   208\t          (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   209\t            (error-response id :dao.stream.apply/handler-error\n   210\t                            \"Handler failed\")))))))\n   211\t\n   145\t                      :yin.repl.adapter/event event))\n   146\t\n   147\t    (local-command input)\n   148\t    (let [command (local-command input)\n   149\t          event {:yin.repl.adapter/event :yin.repl.adapter/local-command\n   150\t                 :yin.repl.adapter/command command\n   151\t                 :yin.repl.adapter/input input}\n   152\t          state (append-event state event)]\n   153\t      (adapter-result :yin.repl.adapter/local-command state\n   154\t                      :yin.repl.adapter/event event))\n   155\t\n   156\t    :else\n   157\t    (let [rpc-result (rpc/request! (:yin.repl.adapter/rpc state)\n   158\t                                   eval-operation\n   159\t                                   [input])\n   160\t          state (assoc state :yin.repl.adapter/rpc\n   161\t                       (:dao.stream.rpc/state rpc-result))]\n   162\t      (adapter-result (request-outcome (:dao.stream.rpc/outcome rpc-result))\n   163\t                      state\n   164\t                      :yin.repl.adapter/rpc-result rpc-result))))\n   165\t\n   166\t\n   167\t(defn- completion-event\n   168\t  [completion]\n   169\t  (let [base {:yin.repl.adapter/id (:dao.stream.rpc/id completion)\n   170\t              :yin.repl.adapter/op (:dao.stream.rpc/op completion)\n   171\t              :yin.repl.adapter/args (:dao.stream.rpc/args completion)}]\n   172\t    (if-let [response (:dao.stream.rpc/response completion)]\n   173\t      (if (contains? response apply/ok-key)\n   174\t        (assoc base\n   175\t               :yin.repl.adapter/event :yin.repl.adapter/response\n   176\t               :yin.repl.adapter/value (apply/response-ok response))\n   177\t        (assoc base\n   178\t               :yin.repl.adapter/event :yin.repl.adapter/response\n   179\t               :yin.repl.adapter/error (apply/response-error response)))\n   180\t      (assoc base\n   181\t             :yin.repl.adapter/event :yin.repl.adapter/lost\n   182\t             :yin.repl.adapter/reason (:dao.stream.rpc/reason completion)))))\n   183\t\n   184\t\n   185\t(defn publish-completions\n   186\t  \"Move RPC's completion outbox into the REPL event outbox exactly once.\n   187\t   The returned RPC state has an empty completion vector, so a later driver tick\n   188\t   cannot publish the same correlated response or loss again.\"\n   205\t               (:retrying state)\n   206\t               (remote-unsent? state))))\n   207\t\n   208\t\n   209\t(def queueable-terminals\n   210\t  \"Terminal reasons after which an ordinary line still has a reattachment\n   211\t   decision to wait for.  Only `/detached` reattaches.  A reachability failure\n   212\t   may succeed through a *fresh* connection, but that connection cannot inherit\n   213\t   this binding's queued lines, so promising to deliver them would be false.\n   214\t   Every other terminal returns input to the local shell.\"\n   215\t  #{:dao.stream.apply/detached})\n   216\t\n   217\t\n   218\t(defn- remote-routed?\n   219\t  \"True while ordinary input belongs to the remote shell.  An operator\n   220\t   `(disconnect)` ends that immediately — the shell is local again from the next\n   470\t\n   471\t\n   472\t(defn- clears-outstanding?\n   473\t  [state event]\n   474\t  (and (:outstanding state)\n   475\t       (contains? #{:yin.repl.adapter/response :yin.repl.adapter/lost}\n   476\t                  (:yin.repl.adapter/event event))\n   477\t       (= (:outstanding state) (:yin.repl.adapter/id event))))\n   478\t\n   479\t\n   480\t(defn- publish-adapter-events\n   481\t  \"Move the adapter's event outbox into the driver's, exactly once.\"\n   482\t  [state]\n   483\t  (let [[events adapter] (adapter/take-events (:adapter state))]\n   484\t    (reduce (fn [state event]\n   485\t              (-> state\n   486\t                  (cond-> (clears-outstanding? state event)\n   487\t                    (assoc :outstanding nil))\n   488\t                  (publish (completion-event-kind event) (completion-text event))))\n   489\t            (assoc state :adapter adapter)\n   490\t            events)))\n   491\t\n   492\t\n   493\t(defn- poll-remote\n   494\t  [state]\n   495\t  (if-not (:adapter state)\n   496\t    state\n   497\t    (let [result (adapter/poll-responses (:adapter state) response-budget)]\n   498\t      (publish-adapter-events (assoc state :adapter\n   499\t                                     (:yin.repl.adapter/state result))))))\n   500\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"The VM does depend on the full `dao.stream.apply` API, so deleting that namespace would move core FFI behavior into the REPL layer. I’m checking the reflection result shape and current RPC correlation path so the ruling is precise about what stays internal and what leaves the network."}}
