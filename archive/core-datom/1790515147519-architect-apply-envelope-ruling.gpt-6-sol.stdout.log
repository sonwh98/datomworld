{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/remote.cljc | sed -n '355,430p;575,655p;690,775p'; nl -ba src/cljc/dao/stream/rpc.cljc | sed -n '145,245p;460,495p'; nl -ba src/cljc/yin/repl/connect.cljc | sed -n '338,388p;420,460p;525,570p'; rg -n 'defn (dial|dial-attach\"'!|make-acceptor|accept-step!)|defn.*reflect|defn.*bind'\"' src/cljc/dao/stream/ws_project.cljc src/cljc/dao/stream/remote.cljc src/cljc/dao/stream/ws.cljc\"","aggregated_output":"   355\t      [id (get filed id)])))\n   356\t\n   357\t\n   358\t(defn- bare-outcome\n   359\t  \"The source's own outcome map, verbatim: the correlation keys the\n   360\t   answer envelope added are removed, nothing else.\"\n   361\t  [ans]\n   362\t  (dissoc ans :dao.stream.remote/id :dao.stream/identity))\n   363\t\n   364\t\n   365\t(defn- translated\n   366\t  \"A filed protocol error at the reflection: transport-error with the\n   367\t   error's name as the reason. not-found marks the reflection gone at\n   368\t   filing; no-surface and oversize mark nothing.\"\n   369\t  [e]\n   370\t  {:dao.stream/outcome :dao.stream/transport-error\n   371\t   :dao.stream.remote/reason e})\n   372\t\n   373\t\n   374\t(defn- learn!\n   375\t  \"The attach probe's ok: record the source's descriptor and declared\n   376\t   surface, plus :closable.\"\n   377\t  [refl answer]\n   378\t  (swap! refl assoc\n   379\t         :source-descriptor (:dao.stream/descriptor answer)\n   380\t         :surface (conj (into #{} (:dao.stream.remote/surface answer))\n   381\t                        :closable)))\n   382\t\n   383\t\n   384\t(defn- install-more!\n   385\t  \"Install each more outcome under the answer's served identity and at\n   386\t   the cursor that precedes it, so a later next at that cursor by a\n   387\t   reflection of the same stream returns the source's own outcome\n   388\t   without a request. The identity is half of the key: two served\n   389\t   identities can carry equal cursor values, and an outcome belongs to\n   390\t   its own stream.\"\n   391\t  [link answer]\n   392\t  (let [identity (:dao.stream/identity answer)]\n   393\t    (loop [cur (:dao.stream/cursor answer)\n   394\t           more (:dao.stream.remote/more answer)]\n   395\t      (when (and cur (seq more))\n   396\t        (let [[o & further] more]\n   397\t          (swap! link assoc-in [:filed-cursors [identity cur]] o)\n   398\t          (recur (:dao.stream/cursor o) further))))))\n   399\t\n   400\t\n   401\t(defn- absorb!\n   402\t  \"Consume one value read off the channel. A well-formed answer whose\n   403\t   id is outstanding is taken: a not-found error marks the reflection\n   404\t   gone; the attach probe's ok records the source's descriptor and\n   405\t   declared surface; an append!'s source outcome is emitted on the\n   406\t   event writer, correlated by id; any other answer is filed under its\n   407\t   id and its more outcomes installed. Answers whose id is not\n   408\t   outstanding, and values that are not well-formed answers, are\n   409\t   dropped as diagnostics.\"\n   410\t  [link v]\n   411\t  (when (well-formed-answer? v)\n   412\t    (let [id (:dao.stream.remote/id v)]\n   413\t      (when-some [entry (get (:outstanding @link) id)]\n   414\t        (let [refl (:reflection entry)\n   415\t              req (:req entry)\n   416\t              op (:dao.stream.remote/op req)\n   417\t              e (:dao.stream.remote/error v)]\n   418\t          (swap! link update :outstanding dissoc id)\n   419\t          (swap! refl update :ids disj id)\n   420\t          (cond\n   421\t            (= :dao.stream.remote/not-found e)\n   422\t            (do (swap! refl assoc :gone? true)\n   423\t                (when (or (= :dao.stream/descriptor op)\n   424\t                          (= :dao.stream/append! op))\n   425\t                  (emit! link v)))\n   426\t\n   427\t            (= :dao.stream/descriptor op)\n   428\t            ;; The attach probe's confirmation. ok records; a\n   429\t            ;; no-surface or oversize error marks nothing.\n   430\t            (when (nil? e)\n   575\t  [link refl op arg]\n   576\t  (if-some [id (outstanding-for link refl op arg)]\n   577\t    (count-ask! link id)\n   578\t    (send-request! link refl (wire-request link refl op [arg]))))\n   579\t\n   580\t\n   581\t(defn- refl-cursor\n   582\t  \"The cursor operation: a filed answer for the anchor is returned,\n   583\t   and a filed protocol error translated; otherwise a cursor request\n   584\t   is sent if none is outstanding, and the answer is transport-error\n   585\t   with :dao.stream/retry? true. Once closed, cursor answers closed;\n   586\t   once gone, transport-error naming not-found.\"\n   587\t  [refl a]\n   588\t  (let [link (:link @refl)]\n   589\t    (drain! link)\n   590\t    (cond\n   591\t      (:closed? @refl) (result :dao.stream/closed)\n   592\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   593\t      (surface-lacks? refl :dao.stream/cursor)\n   594\t      (translated :dao.stream.remote/no-surface)\n   595\t      :else\n   596\t      (or (filed-cursor link refl a)\n   597\t          (when-not (:channel-gone? @link)\n   598\t            (send-or-count! link refl :dao.stream/cursor a)\n   599\t            (retry-read))\n   600\t          (translated :dao.stream.remote/channel-gone)))))\n   601\t\n   602\t\n   603\t(defn- refl-next\n   604\t  \"The next operation: a filed answer for the cursor is returned and\n   605\t   forgotten; otherwise a next request is sent if none is outstanding,\n   606\t   and the answer is blocked -- nothing is observable at this position\n   607\t   through this handle yet. After close, filed outcomes then end. The\n   608\t   reflection never judges a cursor: cursor-mismatch and\n   609\t   invalid-cursor are only ever relayed from the source.\"\n   610\t  [refl c]\n   611\t  (let [link (:link @refl)]\n   612\t    (dr