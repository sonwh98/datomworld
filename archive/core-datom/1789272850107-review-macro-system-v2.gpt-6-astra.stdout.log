{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '100,165p;346,410p;475,592p'\"","aggregated_output":"   100\t(def primitives\n   101\t  {'+ +,\n   102\t   '- -,\n   103\t   '* *,\n   104\t   '/ /,\n   105\t   '= =,\n   106\t   '== =,\n   107\t   '!= not=,\n   108\t   '< <,\n   109\t   '> >,\n   110\t   '<= <=,\n   111\t   '>= >=,\n   112\t   'not not,\n   113\t   'nil? nil?,\n   114\t   'empty? empty?,\n   115\t   'first first,\n   116\t   'rest (fn [a] (vec (rest a))), ; clojure.core/rest returns a lazy seq;\n   117\t   ;; vec coerces to vector so conj appends rather than prepends\n   118\t   'conj conj,\n   119\t   'assoc assoc,\n   120\t   'get get,\n   121\t   'vec vec,\n   122\t   'bytes->str #?(:clj (fn\n   123\t                         ([b] (String. ^bytes b \"UTF-8\"))\n   124\t                         ([b enc] (String. ^bytes b ^String enc)))\n   125\t                  :cljs (fn [b] (.apply js/String.fromCharCode nil b))\n   126\t                  :cljd (fn [b] (dart:core/String.fromCharCodes b))),\n   127\t   ;; Definition primitive - returns an effect\n   128\t   'yin/def (fn [k v] {:effect :vm/store-put, :key k, :val v}),\n   129\t   ;; Module loading primitive - returns an effect dispatched to the host\n   130\t   'require (fn [spec]\n   131\t              (let [ns-sym (if (vector? spec) (first spec) spec)]\n   132\t                {:effect :module/require, :module ns-sym}))})\n   133\t\n   134\t\n   135\t(def call-in-stream-key\n   136\t  \"Store key for the shared apply inbound request stream (caller writes, callee reads).\"\n   137\t  :yin/call-in)\n   138\t\n   139\t\n   140\t(def call-out-stream-key\n   141\t  \"Store key for the shared apply outbound response stream (callee writes, caller reads).\"\n   142\t  :yin/call-out)\n   143\t\n   144\t\n   145\t(def call-out-cursor-key\n   146\t  \"Store key for the shared apply outbound stream cursor.\"\n   147\t  :yin/call-out-cursor)\n   148\t\n   149\t\n   150\t(def default-call-capacity\n   151\t  \"Capacity of the FFI request/response pair when the composition does not\n   152\t   declare one.\n   153\t\n   154\t   This is a correctness parameter, not a tuning knob. The FFI state machine\n   155\t   bounds outstanding requests to one per parked call and an already-read\n   156\t   response is harmlessly evictable, so the rule is: capacity at least the\n   157\t   maximum number of simultaneously parked calls, plus one. Under an\n   158\t   evict-oldest transport an evicted response leaves its parked call waiting\n   159\t   forever, which is why a gap at the bridge cursor is fatal rather than\n   160\t   resumable.\"\n   161\t  1024)\n   162\t\n   163\t\n   164\t(def default-stream-capacity\n   165\t  \"Capacity for `(stream/make)` and `:stream/make` with no declared capacity.\n   346\t(defn ast->datoms-with-root\n   347\t  \"Convert AST map into a vector of datoms. A datom is [e a v t m].\n   348\t   Returns [root-id datoms].\n   349\t\n   350\t   Entity IDs are tempids (negative integers: -16, -17, -18...) that get resolved\n   351\t   to actual entity IDs when transacted. The transactor assigns real positive IDs.\n   352\t\n   353\t   Options:\n   354\t     :t - transaction ID (default 0)\n   355\t     :m - metadata entity reference (default assert; see dao.datom/reserved)\n   356\t     :id-start - starting entity ID for tempids (default (- datom/first-user-id))\"\n   357\t  ([ast] (ast->datoms-with-root ast {}))\n   358\t  ([ast opts]\n   359\t   (let [id-counter (atom (or (:id-start opts) (- datom/first-user-id)))\n   360\t         t (or (:t opts) 0)\n   361\t         m (or (:m opts) datom/default-op)\n   362\t         gen-id #(swap! id-counter dec)\n   363\t         datoms (atom [])\n   364\t         emit! (fn [e attr val] (swap! datoms conj [e attr val t m]))\n   365\t         ;; Track pre-assigned EIDs already emitted so that a shared\n   366\t         ;; lambda-ast\n   367\t         ;; (same :eid in definition operand and call-site operator) is\n   368\t         ;; processed exactly once; every reference resolves to the same\n   369\t         ;; EID.\n   370\t         seen-eids (atom #{})]\n   371\t     (letfn\n   372\t       [(convert\n   373\t          [node]\n   374\t          (let [pre-eid (:eid node)\n   375\t                e (or pre-eid (gen-id))\n   376\t                {:keys [type tail?]} node]\n   377\t            (if (and pre-eid (contains? @seen-eids pre-eid))\n   378\t              ;; Shared reference already emitted — return EID without\n   379\t              ;; re-emitting.\n   380\t              e\n   381\t              (do\n   382\t                (when pre-eid (swap! seen-eids conj pre-eid))\n   383\t                (when tail? (emit! e :yin/tail? true))\n   384\t                (case type\n   385\t                  :literal (do (emit! e :yin/type :literal)\n   386\t                               (emit! e :yin/value (:value node)))\n   387\t                  :variable (do (emit! e :yin/type :variable)\n   388\t                                (emit! e :yin/name (:name node)))\n   389\t                  :lambda (do (emit! e :yin/type :lambda)\n   390\t                              (when (:macro? node)\n   391\t                                (emit! e :yin/macro? true)\n   392\t                                (emit! e\n   393\t                                       :yin/phase-policy\n   394\t                                       (or (:phase-policy node) :compile)))\n   395\t                              (emit! e :yin/params (:params node))\n   396\t                              (let [body-id (convert (:body node))]\n   397\t                                (emit! e :yin/body body-id)))\n   398\t                  :application (do (emit! e :yin/type :application)\n   399\t                                   (let [op-id (convert (:operator node))\n   400\t                                         operand-ids (mapv convert\n   401\t                                                           (:operands node))]\n   402\t                                     (emit! e :yin/operator op-id)\n   403\t                                     (emit! e :yin/operands operand-ids)))\n   404\t                  :dao.stream.apply/call\n   405\t                  (do (emit! e :yin/type :dao.stream.apply/call)\n   406\t                      (emit! e :yin/op (:op node))\n   407\t                      (let [operand-ids (mapv convert (:operands node))]\n   408\t                        (emit! e :yin/operands operand-ids)))\n   409\t                  :if (do (emit! e :yin/type :if)\n   410\t                          (let [test-id (convert (:test node))\n   475\t(defn datoms->ast\n   476\t  \"Convert a vector of datoms [e a v t m] back into an AST map.\"\n   477\t  ([datoms]\n   478\t   (let [indexed (index-datoms datoms)\n   479\t         root-id (:root-id indexed)]\n   480\t     (datoms->ast datoms {:indexed indexed, :root-id root-id})))\n   481\t  ([datoms {:keys [indexed root-id]}]\n   482\t   (let [{:keys [get-attr]} indexed\n   483\t         node-type (get-attr root-id :yin/type)\n   484\t         tail? (get-attr root-id :yin/tail?)\n   485\t         base (cond-> {:type node-type} tail? (assoc :tail? true))\n   486\t         recur-ast (fn [eid]\n   487\t                     (datoms->ast datoms {:indexed indexed, :root-id eid}))]\n   488\t     (case node-type\n   489\t       :literal (assoc base :value (get-attr root-id :yin/value))\n   490\t       :variable (assoc base :name (get-attr root-id :yin/name))\n   491\t       :lambda (let [body-eid (get-attr root-id :yin/body)\n   492\t                     macro? (get-attr root-id :yin/macro?)]\n   493\t                 (cond-> (assoc base\n   494\t                                :params (get-attr root-id :yin/params)\n   495\t                                :body (recur-ast body-eid))\n   496\t                   macro? (assoc :macro?\n   497\t                                 true :phase-policy\n   498\t                                 (get-attr root-id :yin/phase-policy))))\n   499\t       :application (let [op-eid (get-attr root-id :yin/operator)\n   500\t                          operand-eids (get-attr root-id :yin/operands)]\n   501\t                      (assoc base\n   502\t                             :operator (recur-ast op-eid)\n   503\t                             :operands (mapv recur-ast operand-eids)))\n   504\t       :dao.stream.apply/call (let [op (get-attr root-id :yin/op)\n   505\t                                    operand-eids (get-attr root-id\n   506\t                                                           :yin/operands)]\n   507\t                                (assoc base\n   508\t                                       :op op\n   509\t                                       :operands (mapv recur-ast operand-eids)))\n   510\t       :if (let [test-eid (get-attr root-id :yin/test)\n   511\t                 cons-eid (get-attr root-id :yin/consequent)\n   512\t                 alt-eid (get-attr root-id :yin/alternate)]\n   513\t             (assoc base\n   514\t                    :test (recur-ast test-eid)\n   515\t                    :consequent (recur-ast cons-eid)\n   516\t                    :alternate (recur-ast alt-eid)))\n   517\t       :vm/gensym (assoc base :prefix (get-attr root-id :yin/prefix))\n   518\t       :vm/store-get (assoc base :key (get-attr root-id :yin/key))\n   519\t       :vm/store-put (assoc base\n   520\t                            :key (get-attr root-id :yin/key)\n   521\t                            :val (get-attr root-id :yin/value))\n   522\t       :stream/make (assoc base :buffer (get-attr root-id :yin/buffer))\n   523\t       :stream/put (let [target-eid (get-attr root-id :yin/target)\n   524\t                         val-eid (get-attr root-id :yin/val-node)]\n   525\t                     (assoc base\n   526\t                            :target (recur-ast target-eid)\n   527\t                            :val (recur-ast val-eid)))\n   528\t       :stream/cursor (assoc base\n   529\t                             :source (recur-ast (get-attr root-id :yin/source)))\n   530\t       :stream/next (assoc base\n   531\t                           :source (recur-ast (get-attr root-id :yin/source)))\n   532\t       :stream/close (assoc base\n   533\t                            :source (recur-ast (get-attr root-id :yin/source)))\n   534\t       :vm/park base\n   535\t       :vm/resume (let [val-eid (get-attr root-id :yin/val-node)]\n   536\t                    (assoc base\n   537\t                           :parked-id (get-attr root-id :yin/parked-id)\n   538\t                           :val (recur-ast val-eid)))\n   539\t       :vm/current-continuation base\n   540\t       :yin/macro-expand (let [op-eid (get-attr root-id :yin/operator)\n   541\t                               operand-eids (get-attr root-id :yin/operands)]\n   542\t                           (assoc base\n   543\t                                  :operator (recur-ast op-eid)\n   544\t                                  :operands (mapv recur-ast operand-eids)))\n   545\t       ;; fallback\n   546\t       (throw (ex-info \"Unknown AST node type in datoms\"\n   547\t                       {:type node-type, :root-id root-id}))))))\n   548\t\n   549\t\n   550\t(def ^:private many-attrs #{:yin/operands :yin/args :yin/params})\n   551\t\n   552\t\n   553\t(defn index-datoms\n   554\t  \"Index AST datoms by entity.\n   555\t   Returns {:by-entity map, :get-attr fn, :root-id int}.\n   556\t\n   557\t   Optional opts:\n   558\t   - :by-entity precomputed {eid [datom ...]} index\n   559\t   - :root-id explicit root entity id override\"\n   560\t  ([ast-as-datoms] (index-datoms ast-as-datoms {}))\n   561\t  ([ast-as-datoms {:keys [by-entity root-id]}]\n   562\t   (let [datoms (vec ast-as-datoms)\n   563\t         by-entity (or by-entity (group-by first datoms))\n   564\t         get-attr (fn [e attr]\n   565\t                    (let [matching (filter (fn [d] (= (nth d 1) attr))\n   566\t                                           (get by-entity e))]\n   567\t                      (if (contains? many-attrs attr)\n   568\t                        (vec (mapcat (fn [d]\n   569\t                                       (let [v (nth d 2)]\n   570\t                                         (if (vector? v) v [v])))\n   571\t                                     matching))\n   572\t                        (when (seq matching) (nth (last matching) 2)))))\n   573\t         root-id\n   574\t         (or root-id\n   575\t             (when (seq by-entity)\n   576\t               ;; Heuristic for finding the root:\n   577\t               ;; 1. Find all eids that have a :yin/type\n   578\t               ;; 2. Prefer the ones that are NOT used as structural\n   579\t               ;; children\n   580\t               ;; 3. Return the LAST such eid (most recent addition)\n   581\t               ;; 4. Fallback to max eid\n   582\t               (let [type-eids (keep (fn [[e datoms]]\n   583\t                                       (when (some #(= :yin/type (nth % 1))\n   584\t                                                   datoms)\n   585\t                                         e))\n   586\t                                     by-entity)\n   587\t                     referenced-eids\n   588\t                     (set (mapcat (fn [[_ a v]]\n   589\t                                    (when (contains?\n   590\t                                            #{:yin/body :yin/operator\n   591\t                                              :yin/operands :yin/target\n   592\t                                              :yin/val-node}\n","exit_code":0,"status":"completed"}}
