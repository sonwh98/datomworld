                              k\n   642\t                              {:type :closure,\n   643\t                               :params (:params node),\n   644\t                               :body (:body node),\n   645\t                               :env env}\n   646\t                              vm)\n   647\t               :application\n   648\t               (recur (:operator node)\n   649\t                      env\n   650\t                      {:frame node, :next k, :env env, :type :eval-operator}\n   651\t                      val\n   652\t                      vm)\n   653\t               :if (recur (:test node)\n   654\t                          env\n   655\t                          {:frame node, :next k, :env env, :type :eval-test}\n   656\t                          val\n   657\t                          vm)\n   658\t               (let [state (cesk-return vm node env k val)\n   659\t                     next (cesk-transition state nil)]\n   660\t                 (if (or (:blocked? next)\n   661\t                         (and (nil? (:control next)) (nil? (:k next))))\n   662\t                   next\n   663\t                   (recur (:control next)\n   664\t                          (:env next)\n   665\t                          (:k next)\n   666\t                          (:value next)\n   667\t                          next))))\n   668\t        :else (let [result (cesk-return vm control env k val)]\n   669\t                (cond (:blocked? result)\n   670\t                      (let [v' (engine/check-wait-set result)]\n   671\t                        (if-let [resumed (resume-from-run-queue v')]\n   672\t                          (recur (:control resumed)\n   673\t                                 (:env resumed)\n   674\t                                 (:k resumed)\n   675\t                                 (:value resumed)\n   676\t                                 resumed)\n   677\t                          v'))\n   678\t                      (seq (or (:ready-queue result) []))\n   679\t                      (if-let [resumed (resume-from-run-queue result)]\n   680\t                        (recur (:control resumed)\n   681\t                               (:env resumed)\n   682\t                               (:k resumed)\n   683\t                               (:value resumed)\n   684\t                               resumed)\n   685\t                        result)\n   686\t                      :else result))))))\n   687\t\n   688\t\n   689\t;; =============================================================================\n   690\t;; ASTWalkerVM Protocol Implementation\n   691\t;; =============================================================================\n   692\t\n   693\t(defn- vm-step\n   694\t  \"Execute one step of ASTWalkerVM. Returns updated VM.\"\n   695\t  [^ASTWalkerVM vm]\n   696\t  (cesk-transition vm nil))\n   697\t\n   698\t\n   699\t(defn- vm-halted?\n   700\t  [^ASTWalkerVM vm]\n   701\t  (engine/halted-with-empty-queue? vm))\n   702\t\n   703\t\n   704\t(defn- vm-blocked?\n   705\t  [^ASTWalkerVM vm]\n   706\t  (engine/vm-blocked? vm))\n   707\t\n   708\t\n   709\t(defn- vm-value\n   710\t  [^ASTWalkerVM vm]\n   711\t  (engine/vm-value vm))\n   712\t\n   713\t\n   714\t(defn vm-load-program\n   715\t  \"Load one datom batch into the VM: the existing datom-to-AST conversion\n   716\t   plus the execution-field updates. This is the loader host composition\n   717\t   hands to `yin.vm.stream-observer/run-on-stream` alongside\n   718\t   `engine/ready-for-ingress?` and the VM's runner.\"\n   719\t  [^ASTWalkerVM vm datoms]\n   720\t  (let [ast (vm/datoms->ast datoms)]\n   721\t    (assoc vm\n   722\t           :program ast\n   723\t           :control ast\n   724\t           :halted? false\n   725\t           :blocked? false\n   726\t           :value nil)))\n   727\t\n   728\t\n   729\t(defn- vm-reset\n   730\t  \"Reset execution state, preserving the loaded AST program.\"\n   731\t  [^ASTWalkerVM vm]\n   732\t  (assoc vm\n   733\t         :control (:program vm)\n   734\t         :k nil\n   735\t         :halted? (nil? (:program vm))\n   736\t         :value nil\n   737\t         :blocked? false))\n   738\t\n   739\t\n   740\t(defn- ast-walker-run-scheduler\n   741\t  \"The raw runner: already-loaded work only, through the shared scheduler\n   742\t   loop. `ffi/maybe-run` wraps this for bridge dispatch, and `vm/run` stops\n   743\t   here — no program stream is polled.\"\n   744\t  [vm]\n   745\t  (engine/run-loop vm\n   746\t                   engine/active-continuation?\n   747\t                   vm-step\n   748\t                   resume-from-run-queue\n   749\t                   ast-walker-restore))\n   750\t\n   751\t\n   752\t(defn- vm-eval\n   753\t  \"Evaluate an AST: convert it to datoms, load it, and run. When ast is\n   754\t   non-nil it is loaded first; when nil, the current state resumes. Either\n   755\t   way this is direct evaluation of supplied work: it does not observe or\n   756\t   drain any independently queued program input, which is the observer\n   757\t   composition's job.\"\n   758\t  [^ASTWalkerVM vm ast]\n   759\t  (let [initial-env (:env vm)\n   760\t        res (if ast\n   761\t              (-> vm\n   762\t                  (vm-load-program (vm/ast->datoms ast))\n   763\t                  (vm/run))\n   764\t              (vm/run vm))]\n   765\t    (engine/restore-initial-env initial-env res)))\n   766\t\n   767\t\n   768\t(extend-type ASTWalkerVM\n   769\t  vm/IVM\n   770\t  (step [vm]\n   771\t    (telemetry/emit-snapshot\n   772\t      (if (engine/ready-for-ingress? vm) vm (vm-step vm))\n   773\t      :step))\n   774\t  (run [vm] (ffi/maybe-run vm ast-walker-run-scheduler))\n   775\t  (eval [vm ast] (vm-eval vm ast))\n   776\t  (reset [vm] (vm-reset vm))\n   777\t  (halted? [vm] (vm-halted? vm))\n   778\t  (blocked? [vm] (vm-blocked? vm))\n   779\t  (value [vm] (vm-value vm))\n   780\t  vm/IVMState\n   781\t  (control [vm] (:control vm))\n   782\t  (environment [vm] (:env vm))\n   783\t  (store [vm] (:store vm))\n   784\t  (continuation [vm]\n   785\t    (when-let [k-head (:k vm)]\n   786\t      (loop [k k-head\n   787\t             acc []]\n   788\t        (if (nil? k) acc (recur (:next k) (conj acc k)))))))\n   789\t\n   790\t\n   791\t(defn create-vm\n   792\t  \"Create a new ASTWalkerVM.\n   793\t\n   794\t   Options:\n   795\t     :env           initial lexical environment\n   796\t     :primitives    primitive operations map\n   797\t     :modules       module registry value (see `yin.vm.module`)\n   798\t     :make-stream   (fn [capacity] -> create outcome); no default\n   799\t     :call-in       explicit inbound request handle\n   800\t     :call-out      explicit outbound response handle\n   801\t     :call-capacity capacity for a constructed FFI pair\n   802\t     :bridge        host FFI handlers\n   803\t\n   804\t   There is no `:in-stream`: program observation belongs to\n   805\t   `yin.vm.stream-observer`, and an obsolete `:in-stream` option is\n   806\t   rejected here, before any FFI resource is allocated.\n   807\t\n   808\t   Construction is all-or-nothing: creating the FFI pair and minting the\n   809\t   call-out cursor are stream operations, and any non-`ok` outcome fails here\n   810\t   rather than leaving a half-built VM. The bridge cursor is minted by\n   811\t   `ffi/attach` below; the program cursor belongs to observer attachment.\"\n   812\t  ([] (create-vm {}))\n   813\t  ([opts]\n   814\t   (when (contains? opts :in-stream)\n   815\t     (throw (ex-info\n   816\t              \"Program observation moved to yin.vm.stream-observer: a VM no longer accepts :in-stream\"\n   817\t              {:in-stream (:in-stream opts)})))\n   818\t   (let [env (or (:env opts) {})\n   819\t         base (vm/empty-state\n   820\t                (assoc (select-keys opts\n   821\t                                    [:primitives :modules :make-stream :call-in\n   822\t                                     :call-out :call-capacity])\n   823\t                       :telemetry (:telemetry opts)\n   824\t                       :vm-model :ast-walker))]\n   825\t     (-> (map->ASTWalkerVM (merge base\n   826\t                                  {:bridge nil,\n   827\t                                   :program nil,\n   828\t                                   :control nil,\n   829\t                                   :env env,\n   830\t                                   :k nil,\n   831\t                                   :value nil,\n   832\t                                   :halted? true,\n   833\t                                   :blocked? false}))\n   834\t         (telemetry/install :ast-walker)\n   835\t         (ffi/attach (:bridge opts))\n   836\t         (telemetry/emit-snapshot :init)))))\n","exit_code":0,"status":"completed"}}
