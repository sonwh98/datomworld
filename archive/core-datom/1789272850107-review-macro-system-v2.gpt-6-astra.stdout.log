t\n   476\t                                                   {:restore-fn\n   477\t                                                    ast-walker-restore})]\n   478\t                       (cesk-return state nil env k value))\n   479\t        :stream/put\n   480\t        (cesk-return\n   481\t          state\n   482\t          (:target node)\n   483\t          env\n   484\t          {:frame node, :next k, :env env, :type :eval-stream-put-target}\n   485\t          (:value state))\n   486\t        :stream/cursor\n   487\t        (cesk-return\n   488\t          state\n   489\t          (:source node)\n   490\t          env\n   491\t          {:frame node, :next k, :env env, :type :eval-stream-cursor-source}\n   492\t          (:value state))\n   493\t        :stream/next\n   494\t        (cesk-return\n   495\t          state\n   496\t          (:source node)\n   497\t          env\n   498\t          {:frame node, :next k, :env env, :type :eval-stream-next-cursor}\n   499\t          (:value state))\n   500\t        (throw (ex-info \"Unknown AST node type\" {:type type, :node node}))))))\n   501\t\n   502\t\n   503\t;; =============================================================================\n   504\t;; Scheduler\n   505\t;; =============================================================================\n   506\t\n   507\t(defn- ast-walker-restore\n   508\t  ([base entry] (ast-walker-restore base entry (:value entry)))\n   509\t  ([base entry val] (cesk-return base nil (:env entry) (:k entry) val)))\n   510\t\n   511\t\n   512\t(defn- resume-from-run-queue\n   513\t  \"Pop first entry from the ready-queue and resume it as the active\n   514\t   computation. Returns updated state or nil if the queue is empty.\"\n   515\t  [state]\n   516\t  (engine/resume-from-run-queue state ast-walker-restore))\n   517\t\n   518\t\n   519\t(defn- ast-walker-run-active-continuation\n   520\t  \"Hot loop that keeps CESK state in host locals instead of an immutable\n   521\t   record. 