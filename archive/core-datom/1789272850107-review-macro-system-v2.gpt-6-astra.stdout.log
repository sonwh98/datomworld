        {:frame node, :next k, :env env, :type :eval-operator}\n   407\t                       (:value state))\n   408\t        :if (cesk-return state\n   409\t                         (:test node)\n   410\t                         env\n   411\t                         {:frame node, :next k, :env env, :type :eval-test}\n   412\t                         (:value state))\n   413\t        :dao.stream.apply/call\n   414\t        (let [operands (or (:operands node) [])\n   415\t              op (:op node)]\n   416\t          (if (empty? operands)\n   417\t            (park-and-call state op [] k env)\n   418\t            (cesk-return state\n   419\t                         (first operands)\n   420\t                         env\n   421\t                         {:frame {:op op, :operands operands, :evaluated []},\n   422\t                          :next k,\n   423\t                          :env env,\n   424\t                          :type :dao.stream.apply/eval-operand}\n   425\t                         (:value state))))\n   426\t        :vm/gensym (let [prefix (or (:prefix node) \"id\")\n   427\t                         [id s'] (engine/gensym state prefix)]\n   428\t                     (assoc s'\n   429\t                            :value id\n   430\t                            :control nil\n   431\t                            :halted? (nil? k)))\n   432\t        :vm/store-get (cesk-return state nil env k (get store (:key node)))\n   433\t        :vm/store-put (let [key (:key node)\n   434\t                            value (:val node)\n   435\t                            new-store (assoc store key value)]\n   436\t                        (assoc state\n   437\t                               :store new-store\n   438\t                               :value value\n   439\t                               :control nil\n   440\t                               :halted? (and (not (:blocked? state)) (nil? k))))\n   441\t        :vm/store-update (let [key (:key node)\n   442\t     