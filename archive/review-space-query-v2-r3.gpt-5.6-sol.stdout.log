y/q q-cur (query/current desc 2)))))))\n+                 (query/collect (query/q q-cur (query/current opened 2)))))))\n       (testing\n-        \"as-of history view over published descriptor matches eager as-of history\"\n+        \"as-of history view over the opened index matches eager as-of history\"\n         (let [q-hist '[:find ?v ?t ?op :where [1 :item/status ?v ?t ?op]]]\n           (is (= (query/collect (query/q q-hist (query/history eager-source 2)))\n-                 (query/collect (query/q q-hist (query/history desc 2)))))))\n-      (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n+                 (query/collect (query/q q-hist (query/history opened 2)))))))\n+      (finally (query/close-published! opened)\n+               (jing/close! (:store fx))\n+               (cleanup-file (:path fx))))))\n \n \n (deftest lazy-published-datoms-projections-match-eager\n   (let [test-datoms [[1 :work/task \"Code\" 10 1] [1 :work/owner \"Ada\" 11 1]\n                      [2 :work/task \"Review\" 12 1]]\n         fx (publish-into-file test-datoms)\n-        lazy-cur (query/current (:descriptor fx))\n+        lazy-cur (query/current (:opened fx))\n         eager-cur (query/current (rel test-datoms))]\n     (try\n-      (let [{lazy-idx ::query/fact-index, lazy-owned ::query/owned}\n+      (let [{lazy-idx ::query/fact-index}\n             (query/realize-db-value! lazy-cur)\n-            {eager-idx ::query/fact-index, eager-owned ::query/owned}\n+            {eager-idx ::query/fact-index}\n             (query/realize-db-value! eager-cur)]\n-        (try\n-          (testing\n-            \"datoms [e a v] projections match eager (note: t/m differ by design: eager has synthetic t=0 m=1, lazy has real provenance t/m)\"\n-            (let [project-eav (fn [d-seq]\n-                                (mapv (fn [d]\n-                                        [(index/datom-e d)\n-                                         (index/datom-a d)\n-                                         (index/datom-v d)])\n-                                      d-seq))]\n-              (is (= (project-eav (query/datoms eager-idx 1 '_ '_))\n-                     (project-eav (query/datoms lazy-idx 1 '_ '_))))\n-              (is (= (project-eav (query/datoms eager-idx '_ :work/task '_))\n-                     (project-eav (query/datoms lazy-idx '_ :work/task '_))))\n-              (is (= (project-eav (query/datoms eager-idx '_ '_ \"Ada\"))\n-                     (project-eav (query/datoms lazy-idx '_ '_ \"Ada\"))))))\n-          (finally (query/close-owned! lazy-owned)\n-                   (query/close-owned! eager-owned))))\n-      (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n-\n-\n-(deftest lazy-published-current-closes-owned-store-once\n-  (let [test-datoms [[1 :work/task \"Code\" 10 1]]\n-        fx (publish-into-file test-datoms)]\n-    (try\n-      #?(:cljd\n-         (is\n-           true\n-           \"the close-once spy needs with-redefs, unavailable on ClojureDart; equivalence tests cover correctness there\")\n-         :default\n-         (let [closes (atom 0)\n-               orig-close jing/close!]\n-           (with-redefs [jing/close! (fn [handle]\n-                                       (swap! closes inc)\n-                                       (orig-close handle))]\n-             (is (= #{[1]}\n-                    (query/collect (query/q\n-                                     '[:find ?e :where [?e :work/task \"Code\"]]\n-                                     (query/current (:descriptor fx))))))\n-             (is\n-               (= 1 @closes)\n-               \"index-routed query: one owned realization means exactly one store close\")\n-             (reset! closes 0)\n-             (is (= #{[1 :work/task \"Code\"]}\n-                    (query/collect (query/q\n-                                     '[:find ?e ?a ?v :where [?e ?a ?v & _]]\n-                                     (query/current (:descriptor fx))))))\n-             (is (= 1 @closes)\n-                 \"scan query over the lazy view: also exactly one close\"))))\n-      (finally (jing/close! (:store fx)) (cleanup-file (:path fx))))))\n+        (testing\n+          \"datoms [e a v] projections match eager (note: t/m differ by design: eager has synthetic t=0 m=1, lazy has real provenance t/m)\"\n+          (let [project-eav (fn [d-seq]\n+                              (mapv (fn [d]\n+                                      [(index/datom-e d)\n+                                       (index/datom-a d)\n+                                       (index/datom-v d)])\n+                                    d-seq))]\n+            (is (= (project-eav (query/datoms eager-idx 1 '_ '_))\n+                   (project-eav (query/datoms lazy-idx 1 '_ '_))))\n+            (is (= (project-eav (query/datoms eager-idx '_ :work/task '_))\n+                   (project-eav (query/datoms lazy-idx '_ :work/task '_))))\n+            (is (= (project-eav (query/datoms eager-idx '_ '_ \"Ada\"))\n+                   (project-eav (query/datoms lazy-idx '_ '_ \"Ada\")))))))\n+      (finally (query/close-published! (:opened fx))\n+               (jing/close! (:store fx))\n+               (cleanup-file (:path fx))))))\ndiff --git a/test/dao/space/schema_test.cljc b/test/dao/space/schema_test.cljc\nindex 0e22874..b0db1e7 100644\n--- a/test/dao/space/schema_test.cljc\n+++ b/test/dao/space/schema_test.cljc\n@@ -521,6 +521,11 @@\n ;; ---------------------------------------------------------------------------\n \n (deftest borrowed-and-descriptor-paths-agree\n+  ;; query/history takes values only now, so the borrowed leg passes the\n+  ;; closed realization directly to schema/current, whose interpret-view\n+  ;; drains it where dao.stream lives. What the test pins is unchanged:\n+  ;; the borrowed (realization) path and the value path interpret the same\n+  ;; rows the same way.\n   (let [data (into schema-rows\n                    [[7 :person/name \"Alice\" 0 1]\n                     [7 :person/name \"Alicia\" 1 1]])\n@@ -528,17 +533,23 @@\n         borrowed (open-closed data)\n         q-form '[:find ?v :where [7 :person/name ?v]]]\n     (is (= (qq q-form (schema/current rel))\n-           (qq q-form (schema/current (query/history borrowed)))))))\n+           (qq q-form (schema/current borrowed))))))\n \n \n ;; ---------------------------------------------------------------------------\n-;; W11: bound inherited from source\n+;; W11: schema/current's result is a fact-relation value\n ;; ---------------------------------------------------------------------------\n \n-(deftest bound-inherited-from-source\n+(deftest schema-current-returns-a-fact-relation-value\n+  ;; The v1 bound-inheritance property this site used to pin is gone with\n+  ;; descriptors: relation values carry no :dao.stream/bound to inherit,\n+  ;; so the old assertion compared two nils. What is real at this site:\n+  ;; schema/current's result is a query fact-relation value q accepts\n+  ;; directly, with the current-fact marker set.\n   (let [rel (query/relation schema-rows)\n         v   (schema/current rel)]\n-    (is (= (:dao.stream/bound rel) (:dao.stream/bound v)))))\n+    (is (query/value? v))\n+    (is (true? (:fact? v)))))\n \n \n ;; ---------------------------------------------------------------------------\n@@ -598,14 +609,17 @@\n \n (deftest borrowed-path-does-not-close-again\n   ;; Use a RecordingStream closed by hand (close-count 1). schema/current\n-  ;; over it must NOT close it again — close-count stays 1.\n+  ;; over it must NOT close it again — close-count stays 1. The borrowed\n+  ;; realization is passed directly to schema/current (query/history takes\n+  ;; values only now); interpret-view drains it read-only via ds/strict-vec,\n+  ;; so the count proves neither the drain nor the interpretation closed it.\n   (let [rows    (atom schema-rows)\n         cc      (atom 0)\n         closed  (atom false)\n         stream  (fixtures/->RecordingStream rows cc closed)]\n     (ds/close! stream)\n     (is (= 1 @cc) \"precondition: hand-close fired once\")\n-    (schema/current (query/history stream))\n+    (schema/current stream)\n     (is (= 1 @cc)\n         \"schema/current never closes a borrowed source\")))\n \n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/query.cljc | sed -n '135,250p'; nl -ba src/cljc/dao/space/schema.cljc | sed -n '220,365p'; nl -ba test/dao/space/query_test.cljc | sed -n '60,145p'; nl -ba test/dao/space/schema_test.cljc | sed -n '515,625p'; rg -n \\\"\\\\(:dao.stream/type\\\\s+[\"'^)]*query/(relation|current|history)|:dao.stream/type.*dao'\"\\\\.space\\\\.(query/relation|current|history)|=\\\\s*:dao\\\\.space\\\\.(current|history)|query/value\\\\?|:dao.space.query/view\\\" src test --glob '*.{clj,cljc,cljs}'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/query.cljc | sed -n '135,250p'; nl -ba src/cljc/dao/space/schema.cljc | sed -n '220,365p'; nl -ba test/dao/space/query_test.cljc | sed -n '60,145p'; nl -ba test/dao/space/schema_test.cljc | sed -n '515,625p'; rg -n \\\"\\\\(:dao.stream/type\\\\s+[\"'^)]*query/(relation|current|history)|:dao.stream/type.*dao'\"\\\\.space\\\\.(query/relation|current|history)|=\\\\s*:dao\\\\.space\\\\.(current|history)|query/value\\\\?|:dao.space.query/view\\\" src test --glob '*.{clj,cljc,cljs}'\"","aggregated_output":"   135\t  (into [] (mapcat entity-map->d3) maps))\n   136\t\n   137\t\n   138\t;; =============================================================================\n   139\t;; Query values: relation, view, opened published index (Decision 2)\n   140\t;; =============================================================================\n   141\t\n   142\t(defn value?\n   143\t  \"True for the query values q/match/pull take as database inputs: a\n   144\t   relation value, a datom view, or an opened published index. Raw vectors\n   145\t   and raw maps answer false.\"\n   146\t  [x]\n   147\t  (and (map? x)\n   148\t       (or (contains? x :dao.space.query/relation)\n   149\t           (contains? x :dao.space.query/view)\n   150\t           (contains? x :dao.space.query/published))))\n   151\t\n   152\t\n   153\t(defn relation\n   154\t  \"An in-memory relation value. Its retained contents are an arbitrary,\n   155\t   mixed-dimensional tuple collection; arity never selects an\n   156\t   interpretation. This is the replacement for the direct raw-vector input.\"\n   157\t  [tuples]\n   158\t  {:dao.space.query/relation (vec tuples)})\n   159\t\n   160\t\n   161\t(defn entity-map-relation\n   162\t  \"An entity-map relation value: a bounded relation of entity maps,\n   163\t   projected explicitly to [e a v] facts on the read side. The read side is\n   164\t   pure and never mints an entity id, so every map must carry :db/id.\"\n   165\t  [maps]\n   166\t  ;; Normalize at the explicit constructor boundary. The resulting value is\n   167\t  ;; the same generic relation value q consumes; no second transport type\n   168\t  ;; or opening path is needed merely because the input syntax was maps.\n   169\t  (relation (entity-maps->d3 maps)))\n   170\t\n   171\t\n   172\t(defn fact-relation\n   173\t  \"The explicit current-fact relation: d3 rows that are already\n   174\t   current-state facts, so the fact index is built for them without a d5\n   175\t   pass. dao.space.schema builds these directly.\"\n   176\t  [tuples]\n   177\t  (assoc (relation tuples) :fact? true))\n   178\t\n   179\t\n   180\t(defn- snapshot-value?\n   181\t  [x]\n   182\t  (and (map? x) (contains? x :relation) (contains? x :status)))\n   183\t\n   184\t\n   185\t(defn- db-source\n   186\t  \"Normalize a current/history source. Query values and snapshots pass\n   187\t   through (a snapshot contributes its relation); everything else — raw\n   188\t   maps and vectors included — throws.\"\n   189\t  [source]\n   190\t  (cond\n   191\t    (value? source) source\n   192\t    (snapshot-value? source) (:relation source)\n   193\t    :else\n   194\t    (throw (ex-info \"query db input must be a relation value, a datom view, or an opened published index; raw vectors and maps are rejected\"\n   195\t                    {:input source}))))\n   196\t\n   197\t\n   198\t(defn- view-value\n   199\t  [kind source as-of]\n   200\t  (cond-> {:dao.space.query/view kind, :source source}\n   201\t    (some? as-of) (assoc :as-of as-of)))\n   202\t\n   203\t\n   204\t(defn current\n   205\t  \"The explicit current d5 interpreter: a view value over source. Resolves\n   206\t   the greatest t per [e a v], removes retractions, and rejects conflicting\n   207\t   [e a v t] rows with differing m. An optional as-of bounds visible datoms\n   208\t   to t <= as-of.\"\n   209\t  ([source] (current source nil))\n   210\t  ([source as-of]\n   211\t   (view-value :current (db-source source) as-of)))\n   212\t\n   213\t\n   214\t(defn history\n   215\t  \"The explicit history d5 interpreter: a view value over source exposing\n   216\t   the exact logical d5 rows. An optional as-of bounds visible datoms to\n   217\t   t <= as-of.\"\n   218\t  ([source] (history source nil))\n   219\t  ([source as-of]\n   220\t   (view-value :history (db-source source) as-of)))\n   221\t\n   222\t\n   223\t;; =============================================================================\n   224\t;; Published indexes: open-published! / close-published! (Decision 1)\n   225\t;; =============================================================================\n   226\t\n   227\t(defn open-published!\n   228\t  \"Open a published covered-index coordinate — the serializable map\n   229\t   `index/published-index` builds — as a query value the caller owns: the\n   230\t   content-store handle it opens is closed by `close-published!`, never by\n   231\t   a query. Nothing is fetched beyond the manifest; the row vector stays\n   232\t   deferred behind :rows and the covered sets behind restored B-trees, so a\n   233\t   `current` view with no as-of can answer selective clauses without a\n   234\t   full drain.\"\n   235\t  [coordinate]\n   236\t  (when-not (and (map? coordinate)\n   237\t                 (= :dao.space.index/published (:dao.stream/type coordinate)))\n   238\t    (throw (ex-info \"open-published! takes a published-index coordinate\"\n   239\t                    {:coordinate coordinate})))\n   240\t  (let [{:keys [content-store manifest-address]} coordinate\n   241\t        expected (index/published-index content-store manifest-address)]\n   242\t    (when-not (= expected coordinate)\n   243\t      (throw (ex-info \"invalid published-index coordinate\"\n   244\t                      {:coordinate coordinate, :expected expected})))\n   245\t    (let [store (jing-coordinate/open! content-store)]\n   246\t      (try\n   247\t        (let [manifest (index/read-manifest store manifest-address)]\n   248\t          {:dao.space.query/published coordinate\n   249\t           :indexes (index/restored-indexes store manifest)\n   250\t           :rows (delay (index/read-datoms store manifest-address))\n   220\t    (get axioms ident)\n   221\t    (get schema ident)))\n   222\t\n   223\t\n   224\t;; =============================================================================\n   225\t;; The read view: schema/current (extraction + card-one collapse)\n   226\t;; =============================================================================\n   227\t\n   228\t(defn- validate-not-nested-view!\n   229\t  \"Reject nested views — a query current/history view value (tagged\n   230\t   :dao.space.query/view) or a legacy schema/current view descriptor.\n   231\t   Neither is an open!-dispatchable d5 source nor a raw query value.\"\n   232\t  [d]\n   233\t  (let [v (:dao.space.query/view d)\n   234\t        t (:dao.stream/type d)]\n   235\t    (when (or (#{:current :history} v)\n   236\t              (= t :dao.space.schema/current))\n   237\t      (throw (ex-info\n   238\t               (str \"schema/current source must be an open!-dispatchable d5 \"\n   239\t                    \"descriptor, not a nested view: \" (pr-str (or v t)))\n   240\t               {:dao.space.query/view v, :dao.stream/type t})))))\n   241\t\n   242\t\n   243\t#_{:clj-kondo/ignore [:unresolved-var]}\n   244\t\n   245\t\n   246\t;; kondo cannot resolve dao.stream vars defined behind :clj reader\n   247\t;; conditionals; query.cljc/transactor.cljc carry these unsuppressed.\n   248\t(defn- interpret-view\n   249\t  \"Shared interpretation core for the schema/current view. Given an\n   250\t   already-opened (and closed) source realization plus as-of /\n   251\t   schema-as-of bounds, returns a fact relation of d3 facts with\n   252\t   card-one collapse applied. Composition of public interpretations:\n   253\t   history view for data, history view for schema, extract-schema,\n   254\t   current-state-seq, then card-one collapse per [e a].\"\n   255\t  [source as-of schema-as-of]\n   256\t  ;; A v1 realization is drained here, where dao.stream already lives: the\n   257\t  ;; query read side takes values only, and the published defopen pre-forces\n   258\t  ;; its rows so the drain never touches the closed store.\n   259\t  (let [source (if (ds/realization? source)\n   260\t                 (query/relation (ds/strict-vec source))\n   261\t                 source)\n   262\t        data-rows   (query/rows (query/history source as-of))\n   263\t        schema-rows (query/rows (query/history source\n   264\t                                               (or schema-as-of as-of)))\n   265\t        schema (extract-schema schema-rows)\n   266\t        ;; Seed with axiom idents: the five :db/* attrs are card-one by\n   267\t        ;; axiom, with or without bootstrap/ident rows present.\n   268\t        card-one-es (into (set (keys axioms))\n   269\t                          (keep (fn [[ident _pm]]\n   270\t                                  (when (= :db.cardinality/one\n   271\t                                           (get (resolve-props schema ident)\n   272\t                                                :db/cardinality))\n   273\t                                    ident)))\n   274\t                          schema)\n   275\t        surviving (query/current-state-seq data-rows)\n   276\t        {card-one-rows true,\n   277\t         pass-through  false}\n   278\t        (group-by #(contains? card-one-es (index/datom-a %)) surviving)\n   279\t        collapsed\n   280\t        (vals\n   281\t          (reduce\n   282\t            (fn [m row]\n   283\t              (let [k [(index/datom-e row) (index/datom-a row)]]\n   284\t                (assoc m k\n   285\t                       (let [prev (get m k)]\n   286\t                         (cond (nil? prev) row\n   287\t                               (< (index/datom-t prev)\n   288\t                                  (index/datom-t row)) row\n   289\t                               (> (index/datom-t prev)\n   290\t                                  (index/datom-t row)) prev\n   291\t                               :else\n   292\t                               (let [c (index/compare-vals\n   293\t                                         (index/datom-v prev)\n   294\t                                         (index/datom-v row))]\n   295\t                                 (if (neg? c) prev row)))))))\n   296\t            {}\n   297\t            (or card-one-rows [])))\n   298\t        all-rows (sort index/eavt-cmp\n   299\t                       (into (vec collapsed) pass-through))\n   300\t        d3-rows (mapv #(subvec (vec %) 0 3) all-rows)]\n   301\t    (query/fact-relation d3-rows)))\n   302\t\n   303\t\n   304\t#_{:clj-kondo/ignore [:unresolved-var]}\n   305\t\n   306\t\n   307\t(defn current\n   308\t  \"The schema-aware current view: d3 facts with card-one collapse applied,\n   309\t   as a query fact-relation value q accepts directly. A query value source\n   310\t   (relation value, opened published index) and an already-opened closed\n   311\t   realization interpret immediately; a v1 open!-dispatchable descriptor\n   312\t   is opened, closed, and interpreted through the defopen route.\n   313\t   Opts map: {:as-of n :schema-as-of n}, both optional.\"\n   314\t  ([source] (current source nil))\n   315\t  ([source opts]\n   316\t   (let [as-of       (when (map? opts) (:as-of opts))\n   317\t         schema-as-of (when (map? opts) (:schema-as-of opts))]\n   318\t     (if (ds/realization? source)\n   319\t       (do (when-not (satisfies? ds/IDaoStreamBound source)\n   320\t             (throw (ex-info\n   321\t                      \"borrowed input must satisfy IDaoStreamBound\"\n   322\t                      {:source source})))\n   323\t           (when-not (ds/closed? source)\n   324\t             (throw (ex-info\n   325\t                      \"borrowed input must be closed\"\n   326\t                      {:source source})))\n   327\t           (interpret-view source as-of schema-as-of))\n   328\t       (let [d (when (map? source) source)]\n   329\t         (when-not d\n   330\t           (throw (ex-info\n   331\t                    \"source must be a descriptor or a closed realization\"\n   332\t                    {:source source})))\n   333\t         ;; Either a query value (relation value, opened published index,\n   334\t         ;; not a nested view) or a legacy descriptor carrying a keyword\n   335\t         ;; :dao.stream/type.\n   336\t         (when-not (or (query/value? d) (keyword? (:dao.stream/type d)))\n   337\t           (throw (ex-info\n   338\t                    \"descriptor must carry :dao.stream/type\"\n   339\t                    {:source source})))\n   340\t         (validate-not-nested-view! d)\n   341\t         ;; query/q opens nothing, so the schema view is interpreted here,\n   342\t         ;; not by its consumer: a query value interprets directly; a v1\n   343\t         ;; open!-dispatchable descriptor keeps the defopen route.\n   344\t         (if (query/value? d)\n   345\t           (interpret-view d as-of schema-as-of)\n   346\t           (let [view (cond-> {:dao.stream/type :dao.space.schema/current\n   347\t                               :source d\n   348\t                               :dao.stream/bound (:dao.stream/bound d)}\n   349\t                        (some? as-of)        (assoc :as-of as-of)\n   350\t                        (some? schema-as-of) (assoc :schema-as-of schema-as-of))]\n   351\t             (ds/open! view))))))))\n   352\t\n   353\t\n   354\t#_{:clj-kondo/ignore [:unresolved-symbol :unresolved-var]}\n   355\t\n   356\t\n   357\t(ds/defopen :dao.space.schema/current\n   358\t            [desc]\n   359\t            (let [src (:source desc)]\n   360\t              (when-not (map? src)\n   361\t                (throw (ex-info \"schema/current descriptor must carry :source\"\n   362\t                                {:descriptor desc})))\n   363\t              (let [r (ds/open! src)]\n   364\t                (try (when-not (satisfies? ds/IDaoStreamReader r)\n   365\t                       (throw (ex-info \"open! did not produce a reader realization\"\n    60\t\n    61\t\n    62\t;; ---------------------------------------------------------------------------\n    63\t;; I: inputs — raw data is not a database input\n    64\t;; ---------------------------------------------------------------------------\n    65\t\n    66\t(deftest raw-vectors-and-maps-are-rejected\n    67\t  (testing \"a raw vector of datoms is not a db-value\"\n    68\t    (is (thrown-with-msg?\n    69\t          #?(:cljs js/Error\n    70\t             :cljd Object\n    71\t             :default Exception)\n    72\t          #\"raw vectors and maps are rejected\"\n    73\t          (qq '[:find ?e :where [?e _ _]] [[1 :a 1 0 1]]))))\n    74\t  (testing \"a raw entity map is not a db-value\"\n    75\t    (is (thrown-with-msg?\n    76\t          #?(:cljs js/Error\n    77\t             :cljd Object\n    78\t             :default Exception)\n    79\t          #\"raw vectors and maps are rejected\"\n    80\t          (qq '[:find ?e :where [?e :a 1]] {:db/id 1, :a 1}))))\n    81\t  (testing \"a bare content-store handle carries no source and is not a db-value\"\n    82\t    (is (thrown-with-msg?\n    83\t          #?(:cljs js/Error\n    84\t             :cljd Object\n    85\t             :default Exception)\n    86\t          #\"raw vectors and maps are rejected\"\n    87\t          (qq '[:find ?e :where [?e _ _]] (jing-mem/create-content-mem))))))\n    88\t\n    89\t\n    90\t(deftest loose-stream-type-maps-are-rejected\n    91\t  (testing \"a map with :dao.stream/type is neither a value query built nor an opened index\"\n    92\t    (is (thrown-with-msg?\n    93\t          #?(:cljs js/Error\n    94\t             :cljd Object\n    95\t             :default Exception)\n    96\t          #\"raw vectors and maps are rejected\"\n    97\t          (qq '[:find ?e :where [?e _ _]]\n    98\t              {:dao.stream/type :ringbuffer})))\n    99\t    (is (thrown-with-msg?\n   100\t          #?(:cljs js/Error\n   101\t             :cljd Object\n   102\t             :default Exception)\n   103\t          #\"raw vectors and maps are rejected\"\n   104\t          (qq '[:find ?e :where [?e _ _]]\n   105\t              {:dao.stream/type :dao.stream/relation,\n   106\t               :tuples [],\n   107\t               :dao.stream/bound true})))))\n   108\t\n   109\t\n   110\t(deftest unrecognized-host-objects-are-rejected\n   111\t  ;; No legacy path exists: an arbitrary host object is not silently\n   112\t  ;; classified as a v1 reader and drained — it receives the same I1\n   113\t  ;; rejection as raw vectors and raw maps.\n   114\t  (testing \"an atom is not a source\"\n   115\t    (is (thrown-with-msg?\n   116\t          #?(:cljs js/Error\n   117\t             :cljd Object\n   118\t             :default Exception)\n   119\t          #\"raw vectors and maps are rejected\"\n   120\t          (query/history (atom [[1 :a 1 0 1]]))))\n   121\t    (is (thrown-with-msg?\n   122\t          #?(:cljs js/Error\n   123\t             :cljd Object\n   124\t             :default Exception)\n   125\t          #\"raw vectors and maps are rejected\"\n   126\t          (query/current (atom nil)))))\n   127\t  (testing \"a delay is not a source\"\n   128\t    (is (thrown-with-msg?\n   129\t          #?(:cljs js/Error\n   130\t             :cljd Object\n   131\t             :default Exception)\n   132\t          #\"raw vectors and maps are rejected\"\n   133\t          (query/current (delay [[1 :a 1 0 1]])))))\n   134\t  #?(:clj\n   135\t     (testing \"a host object (a Date) is not a source\"\n   136\t       (is (thrown-with-msg?\n   137\t             Exception\n   138\t             #\"raw vectors and maps are rejected\"\n   139\t             (query/history (java.util.Date.)))))))\n   140\t\n   141\t\n   142\t(deftest relation-and-entity-map-relation-are-accepted\n   143\t  (is (= #{[1] [2]}\n   144\t         (qq '[:find ?e :where [?e :work/status _]]\n   145\t             (query/current (rel sample-datoms)))))\n   515\t             (count (qq '[:find ?v :where [7 :person/tag ?v]]\n   516\t                        (schema/current rel {:as-of 6 :schema-as-of 5}))))))))\n   517\t\n   518\t\n   519\t;; ---------------------------------------------------------------------------\n   520\t;; W10: borrowed and descriptor paths agree\n   521\t;; ---------------------------------------------------------------------------\n   522\t\n   523\t(deftest borrowed-and-descriptor-paths-agree\n   524\t  ;; query/history takes values only now, so the borrowed leg passes the\n   525\t  ;; closed realization directly to schema/current, whose interpret-view\n   526\t  ;; drains it where dao.stream lives. What the test pins is unchanged:\n   527\t  ;; the borrowed (realization) path and the value path interpret the same\n   528\t  ;; rows the same way.\n   529\t  (let [data (into schema-rows\n   530\t                   [[7 :person/name \"Alice\" 0 1]\n   531\t                    [7 :person/name \"Alicia\" 1 1]])\n   532\t        rel  (query/relation data)\n   533\t        borrowed (open-closed data)\n   534\t        q-form '[:find ?v :where [7 :person/name ?v]]]\n   535\t    (is (= (qq q-form (schema/current rel))\n   536\t           (qq q-form (schema/current borrowed))))))\n   537\t\n   538\t\n   539\t;; ---------------------------------------------------------------------------\n   540\t;; W11: schema/current's result is a fact-relation value\n   541\t;; ---------------------------------------------------------------------------\n   542\t\n   543\t(deftest schema-current-returns-a-fact-relation-value\n   544\t  ;; The v1 bound-inheritance property this site used to pin is gone with\n   545\t  ;; descriptors: relation values carry no :dao.stream/bound to inherit,\n   546\t  ;; so the old assertion compared two nils. What is real at this site:\n   547\t  ;; schema/current's result is a query fact-relation value q accepts\n   548\t  ;; directly, with the current-fact marker set.\n   549\t  (let [rel (query/relation schema-rows)\n   550\t        v   (schema/current rel)]\n   551\t    (is (query/value? v))\n   552\t    (is (true? (:fact? v)))))\n   553\t\n   554\t\n   555\t;; ---------------------------------------------------------------------------\n   556\t;; W12: nested view descriptor rejected\n   557\t;; ---------------------------------------------------------------------------\n   558\t\n   559\t(deftest nested-view-descriptor-rejected\n   560\t  (let [rel (query/relation schema-rows)]\n   561\t    (testing \"nested query/current is rejected\"\n   562\t      (is (thrown-with-msg?\n   563\t            #?(:cljs js/Error\n   564\t               :cljd Object\n   565\t               :default Exception)\n   566\t            #\"nested view|not an open!-dispatchable\"\n   567\t            (schema/current (query/current rel)))))\n   568\t    (testing \"nested query/history is rejected\"\n   569\t      (is (thrown-with-msg?\n   570\t            #?(:cljs js/Error\n   571\t               :cljd Object\n   572\t               :default Exception)\n   573\t            #\"nested view|not an open!-dispatchable\"\n   574\t            (schema/current (query/history rel)))))\n   575\t    (testing \"nested schema/current is rejected\"\n   576\t      ;; Need to test that a schema/current descriptor is rejected\n   577\t      ;; when passed as source to schema/current again.\n   578\t      ;; This is a descriptor test, not a realization test.\n   579\t      (let [schema-desc {:dao.stream/type :dao.space.schema/current\n   580\t                         :source rel\n   581\t                         :dao.stream/bound (:dao.stream/bound rel)}]\n   582\t        (is (thrown-with-msg?\n   583\t              #?(:cljs js/Error\n   584\t                 :cljd Object\n   585\t                 :default Exception)\n   586\t              #\"nested view|not an open!-dispatchable\"\n   587\t              (schema/current schema-desc)))))))\n   588\t\n   589\t\n   590\t;; ---------------------------------------------------------------------------\n   591\t;; W13: inner stream closed after descriptor path\n   592\t;; ---------------------------------------------------------------------------\n   593\t;; The recording stream and its :schema.test/recording open! registration\n   594\t;; live in dao.space.schema-fixtures: defopen must not be emitted from a\n   595\t;; test namespace (see that namespace's docstring).\n   596\t\n   597\t\n   598\t(deftest inner-stream-closed-after-descriptor-path\n   599\t  (let [data schema-rows]\n   600\t    (reset! fixtures/recording-rows data)\n   601\t    (let [desc {:dao.stream/type :schema.test/recording\n   602\t                :dao.stream/bound {:schema.test/recording true}}\n   603\t          schema-desc (schema/current desc)]\n   604\t      (testing \"q over the schema view works\"\n   605\t        (is (some? (qq '[:find ?v :where [21 :db/ident ?v]] schema-desc))))\n   606\t      (testing \"inner recording stream was closed exactly once\"\n   607\t        (is (= 1 @@fixtures/recording-close-count))))))\n   608\t\n   609\t\n   610\t(deftest borrowed-path-does-not-close-again\n   611\t  ;; Use a RecordingStream closed by hand (close-count 1). schema/current\n   612\t  ;; over it must NOT close it again — close-count stays 1. The borrowed\n   613\t  ;; realization is passed directly to schema/current (query/history takes\n   614\t  ;; values only now); interpret-view drains it read-only via ds/strict-vec,\n   615\t  ;; so the count proves neither the drain nor the interpretation closed it.\n   616\t  (let [rows    (atom schema-rows)\n   617\t        cc      (atom 0)\n   618\t        closed  (atom false)\n   619\t        stream  (fixtures/->RecordingStream rows cc closed)]\n   620\t    (ds/close! stream)\n   621\t    (is (= 1 @cc) \"precondition: hand-close fired once\")\n   622\t    (schema/current stream)\n   623\t    (is (= 1 @cc)\n   624\t        \"schema/current never closes a borrowed source\")))\n   625\t\ntest/dao/space/schema_test.cljc:551:    (is (query/value? v))\ntest/dao/space/query_test.cljc:146:  (is (query/value? (rel sample-datoms)))\ntest/dao/space/query_test.cljc:147:  (is (query/value? (query/current (rel sample-datoms))))\ntest/dao/space/query_test.cljc:150:  (is (not (query/value? [[1 :a 1]])))\ntest/dao/space/query_test.cljc:151:  (is (not (query/value? {:db/id 1}))))\ntest/dao/space/query_test.cljc:177:    (is (= :current (:dao.space.query/view v)))\ntest/dao/space/query_test.cljc:189:    (is (= :history (:dao.space.query/view v)))\nsrc/cljc/dao/space/query.cljc:149:           (contains? x :dao.space.query/view)\nsrc/cljc/dao/space/query.cljc:200:  (cond-> {:dao.space.query/view kind, :source source}\nsrc/cljc/dao/space/query.cljc:355:  (let [kind (:dao.space.query/view d)\nsrc/cljc/dao/space/query.cljc:392:    (contains? db-value :dao.space.query/view)\nsrc/cljc/dao/space/query.cljc:504:    (contains? x :dao.space.query/view)\nsrc/cljc/dao/space/query.cljc:505:    (let [kind (:dao.space.query/view x)\nsrc/cljc/dao/space/schema.cljc:230:   :dao.space.query/view) or a legacy schema/current view descriptor.\nsrc/cljc/dao/space/schema.cljc:233:  (let [v (:dao.space.query/view d)\nsrc/cljc/dao/space/schema.cljc:240:               {:dao.space.query/view v, :dao.stream/type t})))))\nsrc/cljc/dao/space/schema.cljc:336:         (when-not (or (query/value? d) (keyword? (:dao.stream/type d)))\nsrc/cljc/dao/space/schema.cljc:344:         (if (query/value? d)\n","exit_code":0,"status":"completed"}}
