                                           :node (if (semantic-bytecode-slot-kind-ok? kind v) [[[i] v]] [])\n                                            :nodes (if (semantic-bytecode-slot-kind-ok? kind v)\n                                                     (map-indexed (fn [j cid] [[i j] cid]) v)\n                                                     [])\n                                            nil))\n                                        (range 1 (inc (count slots))) slots (rest (subvec row 1)))\n                                []))\n                            [])))\n        paths (loop [queue [[root []]]\n                     q-idx 0\n                     visited {root []}]\n                (if (= q-idx (count queue))\n                  visited\n                  (let [[id path] (nth queue q-idx)\n                        children (safe-children id)\n                        unvisited (remove #(contains? visited (second %)) children)\n                        new-visited (into {} (map (fn [[suffix cid]] [cid (into path suffix)])) unvisited)]\n                    (recur (into queue (map (fn [[suffix cid]] [cid (into path suffix)]) unvisited))\n                           (inc q-idx)\n                           (merge visited new-visited)))))\n        defect-path (fn [id] (get paths id))\n        defect-res (fn [rule id & [path-suffix]]\n                     (if-let [p (defect-path id)]\n                       {:rule rule :path (if path-suffix (into p path-suffix) p)}\n                       {:rule rule :id id}))\n        tag-defect (some (fn [[id row]]\n                           (let [tag (safe-tag row)]\n                             (when-not (safe-slots tag)\n                               (defect-res :tag id))))\n                         rows)\n        arity-defect (some (fn [[id row]]\n                             (let [tag (safe-tag row)\n                                   slots (safe-slots tag)\n                                   body (subvec row 1)]\n                               (when (not= (count slots) (dec (count body)))\n                                 (defect-res :arity id))))\n                           rows)\n        slot-kind-defect (some (fn [[id row]]\n                                 (let [tag (safe-tag row)\n                                       slots (safe-slots tag)\n                                       body (subvec row 1)]\n                                   (some identity\n                                         (map (fn [i [field kind] v]\n                                                (when-not (or (semantic-bytecode-slot-kind-ok? kind v)\n                                                              (and (nil? v) (contains? semantic-bytecode-defaults [tag field])))\n                                                  (defect-res :slot-kind id [i])))\n                                              (range 1 (inc (count slots))) slots (rest body)))))\n                               rows)\n        saturation-defect (some (fn [[id row]]\n                                  (let [tag (safe-tag row)\n                                        slots (safe-slots tag)\n                                        body (subvec row 1)]\n                                    (some identity\n    45\t  \"`{:root r :rows {id row} :occurrences #{[root path node]}}` for one\n    46\t   packet, or `{:failure {...}}` when it is malformed or disagrees with\n    47\t   `held`, the rows already indexed.\"\n    48\t  [held packet]\n    49\t  (if-not (and (vector? packet)\n    50\t               (= 2 (count packet))\n    51\t               (sequential? (second packet))\n    52\t               (every? #(and (vector? %) (<= 2 (count %))) (second packet)))\n    53\t    {:failure {:stage :packet :reason :shape}}\n    54\t    (let [[root packet-rows] packet\n    55\t          rows (into {} (map (fn [r] [(first r) r])) packet-rows)]\n    56\t      (if-let [dup (some (fn [r] (when (not= r (get rows (first r))) (first r)))\n    57\t                         packet-rows)]\n    58\t        {:failure {:stage :packet :root root :reason :duplicate-address :id dup}}\n    59\t        (if-let [defect (vm/validate-rows {:root root :rows rows})]\n    60\t          {:failure {:stage :packet :root root :reason :invalid-rows\n    61\t                     :defect defect}}\n    62\t          (if-let [conflict (some (fn [[id row]]\n    63\t                                    (when (and (contains? held id)\n    64\t                                               (not= row (get held id)))\n    65\t                                      id))\n    66\t                                  rows)]\n    67\t            {:failure {:stage :packet :root root :reason :address-conflict\n    68\t                       :id conflict}}\n    69\t            {:root root\n    70\t             :rows rows\n    71\t             :occurrences (vm/occurrences {:root root :rows rows})}))))))\n    72\t\n    73\t\n    74\t(defn- index-packet\n    75\t  \"Merge one packet's rows and occurrences, or record why it could not be\n    76\t   and leave both relations as they were.\"\n    77\t  [ix packet]\n    78\t  (let [derived (try\n    79\t                  (derive-packet (:rows ix) packet)\n    80\t                  (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n    81\t                    {:failure {:stage :derive :message (ex-message e)}}))]\n    82\t    (if-let [failure (:failure derived)]\n    83\t      (assoc ix :failure failure)\n    84\t      (-> ix\n    85\t          (update :rows into (:rows derived))\n    86\t          (update :occurrences into (:occurrences derived))\n    87\t          (update :programs inc)))))\n    88\t\n    89\t\n    90\t(defn- consume\n    91\t  \"Advance the observer past every packet still on the medium, handing each\n    92\t   to `f` while the indexer is available; a gap marks it lost.\"\n    93\t  [indexer f]\n    94\t  (loop [ix indexer]\n    95\t    (let [{:keys [status batch] observer' :observer}\n    96\t          (observer/observe-next (:observer ix))\n    97\t          ix (assoc ix :observer observer')]\n    98\t      (case status\n    99\t        :ok (recur (if (or (:lost? ix) (:failure ix)) ix (f ix batch)))\n   100\t        :gap (recur (assoc ix :lost? true))\n   101\t        ix))))\n   102\t\n   103\t\n   104\t(defn step\n   105\t  \"The round's AST index step: index every packet `program-out` still\n   106\t   holds for this observer.\"\n   107\t  [indexer]\n   108\t  (consume indexer index-packet))\n   109\t\n   110\t\n   111\t(defn skip\n   112\t  \"Advance the observer past every packet still on the medium without\n   113\t   indexing it: a round that threw before its program ran indexes nothing.\n   114\t   A gap still marks the indexer lost.\"\n   115\t  [indexer]\n   116\t  (consume indexer (fn [ix _packet] ix)))\n   117\t\n   118\t\n   119\t(defn available?\n   120\t  \"Whether the relations are complete for every packet observed.\"\n   121\t  [indexer]\n   122\t  (not (or (:lost? indexer) (:failure indexer))))\n   123\t\n   124\t\n   125\t(defn relations\n   126\t  \"`{:ast [row ...] :occ #{[root path node] ...}}` — the `$ast` rows, one\n   127\t   per distinct address, and the `$occ` tuples — or nil when the indexer\n   128\t   is lost or failed.\"\n   129\t  [indexer]\n   130\t  (when (available? indexer)\n   131\t    {:ast (vec (vals (:rows indexer)))\n   132\t     :occ (:occurrences indexer)}))\n   133\t\n   134\t\n   135\t(defn status\n   136\t  \"The AST indexer's state as the shell reports it.  It depends only on the\n   137\t   expanded programs, never on which evaluator ran them, so every VM\n   138\t   reports the same status for the same inputs.\"\n   139\t  [indexer]\n   140\t  {:programs (:programs indexer)\n   141\t   :rows (count (:rows indexer))\n   142\t   :occurrences (count (:occurrences indexer))\n   143\t   :lost? (:lost? indexer)\n   144\t   :gaps (:ingress-gaps (:observer indexer) 0)\n   145\t   :failure (:failure indexer)})\n116:(defn packet->row-set\n","exit_code":0,"status":"completed"}}
