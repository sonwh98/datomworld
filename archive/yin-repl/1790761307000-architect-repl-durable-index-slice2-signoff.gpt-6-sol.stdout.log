{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/repl/store/fs.cljc'","aggregated_output":"     1\t(ns yin.repl.store.fs\n     2\t  \"Explicit host file operations for the durable index store directory\n     3\t   (docs/design/yin.repl.dao.space-index.md, the durable-store design's\n     4\t   host section): an exclusive directory lock held by the one process\n     5\t   that owns the store, and an atomic write-temp, sync, rename\n     6\t   replacement for HEAD. CLJ, Node, and Dart each implement them with\n     7\t   their own primitives; nothing here falls back silently.\n     8\t\n     9\t   Lock ownership is an operating-system fact on the JVM — an exclusive\n    10\t   `FileChannel` lock on `<dir>/lock`, released when the holding process\n    11\t   dies — and on Dart, `RandomAccessFile.lockSync`. Node\n    12\t   has no flock in its core, so the lock is a create-exclusive lock file\n    13\t   carrying the owner's pid: a live owner refuses, and a dead owner's\n    14\t   file is replaced, so a crashed process never bricks the directory.\n    15\t\n    16\t   HEAD replacement writes the whole record to a temp file in the same\n    17\t   directory, syncs it, and renames it over HEAD — rename is the\n    18\t   atomicity, so a torn or interrupted write is never observed as HEAD.\n    19\t   The directory itself is synced afterwards where the host can open one\n    20\t   for fsync (Node and the JVM try; Dart's core cannot).\n    21\t\n    22\t   The operating-system locks are per process — a POSIX `fcntl` lock\n    23\t   never refuses its own process — so this process's own holdings are\n    24\t   kept here too: a second owner inside the one process is refused by\n    25\t   that record before any second handle on the lock file is opened.\"\n    26\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n    27\t            [clojure.string :as str]))\n    28\t\n    29\t\n    30\t(def lock-name\n    31\t  \"The lock file's own name inside the durable store directory. Its\n    32\t   presence is bookkeeping, never authority: the JVM and Dart locks live\n    33\t   on open handles, and Node's file names a pid that is checked for\n    34\t   life.\"\n    35\t  \"lock\")\n    36\t\n    37\t\n    38\t(defn- refuse-locked\n    39\t  [dir]\n    40\t  (throw (ex-info (str dir \" is locked by another process\")\n    41\t                  {:dir dir})))\n    42\t\n    43\t\n    44\t(defn- read-text!\n    45\t  \"The file at `path` as text — trimmed, for one-record files read whole —\n    46\t   or nil when absent.\"\n    47\t  [path]\n    48\t  #?(:cljd (let [f (dart-io/File. path)]\n    49\t             (when (.existsSync f)\n    50\t               (str/trim (.readAsStringSync f))))\n    51\t     :clj (let [f (java.io.File. ^String path)]\n    52\t            (when (.exists f) (str/trim (slurp f))))\n    53\t     :cljs (let [fs (js/require \"fs\")]\n    54\t             (when (.existsSync ^js fs path)\n    55\t               (str/trim (.readFileSync ^js fs path \"utf8\"))))))\n    56\t\n    57\t\n    58\t#?(:cljs\n    59\t   (defn- live-pid?\n    60\t     \"True when a pid names a live process — the lock file's owner is\n    61\t      alive.  A process this one may not signal (`EPERM`) is alive too.\"\n    62\t     [pid]\n    63\t     (try (.kill js/process pid 0)\n    64\t          true\n    65\t          (catch :default e\n    66\t            (= \"EPERM\" (.-code e))))))\n    67\t\n    68\t\n    69\t#?(:cljs\n    70\t   (defn- steal-dead-owner!\n    71\t     \"True when the lock file names a dead owner and was removed, so the\n    72\t      caller may create its own: a crashed process's leftover lock is\n    73\t      replaced, not obeyed.\"\n    74\t     [fs path]\n    75\t     (try (let [pid (js/parseInt (str/trim (.readFileSync ^js fs path \"utf8\")) 10)]\n    76\t            (when (and (not (js/isNaN pid)) (not (live-pid? pid)))\n    77\t              (try (.unlinkSync ^js fs path) (catch :default _ nil))\n    78\t              true))\n    79\t          (catch :default _\n    80\t            false))))\n    81\t\n    82\t\n    83\t(defonce ^:private held\n    84\t  (atom #{}))\n    85\t\n    86\t\n    87\t(defn- canonical-dir\n    88\t  \"The directory's one canonical path: the key of this process's own\n    89\t   holdings, so two spellings of one directory are one owner.\"\n    90\t  [dir]\n    91\t  #?(:cljd (.resolveSymbolicLinksSync (dart-io/Directory. dir))\n    92\t     :clj (.getCanonicalPath (java.io.File. ^String dir))\n    93\t     :cljs (.realpathSync ^js (js/require \"fs\") dir)))\n    94\t\n    95\t\n    96\t(defn- claim!\n    97\t  \"Record `key` as held by this process, answering false when it already\n    98\t   was — a second owner inside the one process, refused before it opens\n    99\t   any handle on the lock file (closing such a handle would drop this\n   100\t   process's `fcntl` lock).\"\n   101\t  [key]\n   102\t  (let [claimed? (volatile! false)]\n   103\t    (swap! held (fn [keys]\n   104\t                  (vreset! claimed? (not (contains? keys key)))\n   105\t                  (conj keys key)))\n   106\t    @claimed?))\n   107\t\n   108\t\n   109\t(defn- host-lock!\n   110\t  \"Take the host's exclusive lock on `path`, answering its release\n   111\t   function, or refuse naming the directory.\"\n   112\t  [dir path]\n   113\t  #?(:cljd (let [raf (.openSync (dart-io/File. path)\n   114\t                                .mode dart-io/FileMode.append)]\n   115\t             (try\n   116\t               (.lockSync raf)\n   117\t               (fn []\n   118\t                 (try (.unlockSync raf) (catch Object _ nil))\n   119\t                 (try (.closeSync raf) (catch Object _ nil)))\n   120\t               (catch Object _\n   121\t                 (try (.closeSync raf) (catch Object _ nil))\n   122\t                 (refuse-locked dir))))\n   123\t     :clj (let [f (java.io.RandomAccessFile. ^String path \"rw\")]\n   124\t            (try\n   125\t              (let [fl (try (.tryLock (.getChannel f))\n   126\t                            (catch java.nio.channels.OverlappingFileLockException _\n   127\t                              nil))]\n   128\t                (if (nil? fl)\n   129\t                  (do (.close f)\n   130\t                      (refuse-locked dir))\n   131\t                  (fn []\n   132\t                    (try (.release ^java.nio.channels.FileLock fl)\n   133\t                         (catch Exception _ nil))\n   134\t                    (try (.close f)\n   135\t                         (catch Exception _ nil)))))\n   136\t              (catch Throwable t\n   137\t                (try (.close f) (catch Exception _ nil))\n   138\t                (throw t))))\n   139\t     :cljs (let [fs (js/require \"fs\")]\n   140\t             (letfn [(acquire!\n   141\t                       [stole?]\n   142\t                       (try\n   143\t                         (let [fd (.openSync ^js fs path \"wx\")]\n   144\t                           (.writeSync ^js fs fd (str (.-pid js/process)))\n   145\t                           (.closeSync ^js fs fd)\n   146\t                           (fn []\n   147\t                             (try (.unlinkSync ^js fs path)\n   148\t                                  (catch :default _ nil))))\n   149\t                         (catch :default e\n   150\t                           (cond\n   151\t                             (and (not stole?)\n   152\t                                  (= \"EEXIST\" (.-code e))\n   153\t                                  (steal-dead-owner! fs path))\n   154\t                             (acquire! true)\n   155\t\n   156\t                             (= \"EEXIST\" (.-code e))\n   157\t                             (refuse-locked dir)\n   158\t\n   159\t                             :else (throw e)))))]\n   160\t               (acquire! false)))))\n   161\t\n   162\t\n   163\t(defn lock!\n   164\t  \"Acquire the exclusive lock of the durable store directory, or refuse\n   165\t   naming the directory — whether the other owner is another process or\n   166\t   this one. The answer is a plain release; closing whatever the host\n   167\t   needs closed is all releasing takes.\"\n   168\t  [dir]\n   169\t  (let [key (canonical-dir dir)]\n   170\t    (when-not (claim! key)\n   171\t      (refuse-locked dir))\n   172\t    (let [release! (try (host-lock! dir (str dir \"/\" lock-name))\n   173\t                        (catch #?(:cljd Object\n   174\t                                  :clj Throwable\n   175\t                                  :cljs :default)\n   176\t                               e\n   177\t                          (swap! held disj key)\n   178\t                          (throw e)))\n   179\t          released? (volatile! false)]\n   180\t      {:release! (fn []\n   181\t                   (when-not @released?\n   182\t                     (vreset! released? true)\n   183\t                     (release!)\n   184\t                     (swap! held disj key)))})))\n   185\t\n   186\t\n   187\t(defn unlock!\n   188\t  \"Release a lock `lock!` answered. Idempotent: a released lock releases\n   189\t   again as a no-op, never a later owner's lock of the same directory.\"\n   190\t  [lock]\n   191\t  (when-let [release! (:release! lock)]\n   192\t    (release!)))\n   193\t\n   194\t\n   195\t#?(:cljs\n   196\t   (defn- sync-directory!\n   197\t     \"Sync the directory entry itself, where the host can open one for\n   198\t      fsync — the rename is durable, not merely visible.\"\n   199\t     [fs dir]\n   200\t     (try (let [fd (.openSync ^js fs dir \"r\")]\n   201\t            (.fsyncSync ^js fs fd)\n   202\t            (.closeSync ^js fs fd))\n   203\t          (catch :default _\n   204\t            nil))))\n   205\t\n   206\t\n   207\t#?(:cljd nil\n   208\t   :clj\n   209\t   (defn- sync-directory!\n   210\t     \"Sync the directory entry itself where this JVM can open the\n   211\t      directory for fsync (Linux and macOS can) — the rename is durable,\n   212\t      not merely visible.\"\n   213\t     [dir]\n   214\t     (try (with-open [ch (java.nio.channels.FileChannel/open\n   215\t                           (java.nio.file.Paths/get ^String dir\n   216\t                                                    (make-array String 0))\n   217\t                           ^\"[Ljava.nio.file.OpenOption;\"\n   218\t                           (into-array java.nio.file.OpenOption\n   219\t                                       [java.nio.file.StandardOpenOption/READ]))]\n   220\t            (.force ch true))\n   221\t          (catch Exception _\n   222\t            nil))))\n   223\t\n   224\t\n   225\t(defn atomic-replace!\n   226\t  \"Replace `<dir>/<name>` with `text` atomically: write the whole record\n   227\t   to a temp file beside it, sync the temp, rename it over the target,\n   228\t   and sync the directory where the host supports opening one. A reader\n   229\t   observes either the whole previous record or the whole new one, never\n   230\t   a partial write.\n   231\t\n   232\t   `before-rename`, `(fn [temp-path])`, runs in the one window a crash\n   233\t   can interrupt — after the temp is synced, before the rename — so a\n   234\t   test can interrupt the replacement there; a throw leaves the target\n   235\t   exactly as it was.\"\n   236\t  ([dir name text] (atomic-replace! dir name text {}))\n   237\t  ([dir name text {:keys [before-rename]}]\n   238\t   (let [target (str dir \"/\" name)\n   239\t         temp (str dir \"/\" name \".tmp-\" (random-uuid))]\n   240\t     #?(:cljd (try (.writeAsStringSync (dart-io/File. temp) text .flush true)\n   241\t                   (when before-rename (before-rename temp))\n   242\t                   (.renameSync (dart-io/File. temp) target)\n   243\t                   (catch Object e\n   244\t                     (throw (ex-info (str \"cannot replace \" target \": \" e)\n   245\t                                     {:dir dir :target target}\n   246\t                                     e))))\n   247\t        :clj (try (with-open [out (java.io.FileOutputStream. ^String temp)]\n   248\t                    (.write out (.getBytes ^String text \"UTF-8\"))\n   249\t                    (.flush out)\n   250\t                    (.sync (.getFD out)))\n   251\t                  (when before-rename (before-rename temp))\n   252\t                  (java.nio.file.Files/move\n   253\t                    (java.nio.file.Paths/get temp (make-array String 0))\n   254\t                    (java.nio.file.Paths/get target (make-array String 0))\n   255\t                    (into-array java.nio.file.StandardCopyOption\n   256\t                                [java.nio.file.StandardCopyOption/ATOMIC_MOVE\n   257\t                                 java.nio.file.StandardCopyOption/REPLACE_EXISTING]))\n   258\t                  (sync-directory! dir)\n   259\t                  (catch Throwable e\n   260\t                    (throw (ex-info (str \"cannot replace \" target \": \" e)\n   261\t                                    {:dir dir :target target}\n   262\t                                    e))))\n   263\t        :cljs (let [fs (js/require \"fs\")]\n   264\t                (try (let [fd (.openSync ^js fs temp \"w\")]\n   265\t                       (.writeSync ^js fs fd text)\n   266\t                       (.fsyncSync ^js fs fd)\n   267\t                       (.closeSync ^js fs fd))\n   268\t                     (when before-rename (before-rename temp))\n   269\t                     (.renameSync ^js fs temp target)\n   270\t                     (sync-directory! fs dir)\n   271\t                     (catch :default e\n   272\t                       (throw (ex-info (str \"cannot replace \" target \": \" e)\n   273\t                                       {:dir dir :target target}\n   274\t                                       e)))))))))\n   275\t\n   276\t\n   277\t(defn read-file-text\n   278\t  \"The file `<dir>/<name>` as text, or nil when absent — the public read\n   279\t   the store's HEAD parsing uses.\"\n   280\t  [dir name]\n   281\t  (read-text! (str dir \"/\" name)))\n","exit_code":0,"status":"completed"}}
