-store` (a handle injected directly) is refused.\n   816\t\n   817\t   `:index-recovery` carries what the durable open recovered —\n   818\t   `{:manifest <address or nil> :datoms <the validated snapshot or nil>}`\n   819\t   — exposed for the rehydration slice; nothing installs it yet, so `q`\n   820\t   answers from this session's own publications and `(reset)` keeps\n   821\t   today's rebuild semantics.\"\n   822\t  ([] (create-state {}))\n   823\t  ([{:keys [lang output-cursor output-stream vm-type primitives\n   824\t            content-store content-client name-env link-policy index-store\n   825\t            index-store-spec]\n   826\t     :or {lang :clojure vm-type :semantic}}]\n   827\t   (let [output-stream (or output-stream (make-output-medium!))\n   828\t         output-cursor (or output-cursor (mint-cursor output-stream))\n   829\t         shell-token (str (random-uuid))\n   830\t         index-store-spec (cond\n   831\t                            (and index-store index-store-spec)\n   832\t                            (throw (ex-info\n   833\t                                     (str \"yin.repl/create-state takes one \"\n   834\t                                          \"index store: :index-store-spec \"\n   835\t                                          \"(mem or a file directory) or \"\n   836\t                                          \":index-store (a dao.jing handle), \"\n   837\t                                          \"not both\")\n   838\t                                     {:index-store-spec index-store-spec}))\n   839\t\n   840\t                            index-store nil\n   841\t\n   842\t                            :else (store/checked-spec index-store-spec))\n   843\t         index-store (or index-store (store/open index-store-spec))\n   844\t         link-source (link/composition\n   845\t                       {:name-env name-env\n   846\t                        :content-store content-store\n   847\t                        :content-