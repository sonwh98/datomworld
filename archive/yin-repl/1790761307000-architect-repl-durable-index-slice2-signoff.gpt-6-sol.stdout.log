{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/store.cljc | sed -n '210,375p'; nl -ba src/cljc/yin/repl/main.cljc | sed -n '65,145p;280,325p;370,415p;485,525p'; nl -ba src/cljc/yin/repl.cljc | sed -n '815,865p'\"","aggregated_output":"   210\t  ([dir] (file-refusal (host-file-support) dir))\n   211\t  ([capable? dir]\n   212\t   (or (when-not capable? unsupported-host-text)\n   213\t       (dir-refusal dir))))\n   214\t\n   215\t\n   216\t;; =============================================================================\n   217\t;; HEAD — the durable root pointer, and the snapshot it names\n   218\t;; =============================================================================\n   219\t\n   220\t(defn- head-record\n   221\t  \"The text of one HEAD record: the version and the manifest address,\n   222\t   written whole and replaced whole.\"\n   223\t  [manifest-address]\n   224\t  (str (pr-str {:version head-version :manifest manifest-address}) \"\\n\"))\n   225\t\n   226\t\n   227\t(defn- read-edn\n   228\t  [text]\n   229\t  #?(:cljd (edn/read-string text)\n   230\t     :clj (edn/read-string text)\n   231\t     :cljs (reader/read-string text)))\n   232\t\n   233\t\n   234\t(defn- recovered-head\n   235\t  \"The manifest address HEAD names, or nil for an empty index.  A missing\n   236\t   file is an empty index; a file that is not exactly the versioned\n   237\t   record naming a content address is a corrupt pointer, and a corrupt\n   238\t   pointer refuses startup rather than pretending there was no index.\"\n   239\t  [dir]\n   240\t  (if-some [text (fs/read-file-text dir head-name)]\n   241\t    (let [head (try (read-edn text)\n   242\t                    (catch #?(:cljd Object\n   243\t                              :clj Exception\n   244\t                              :cljs :default)\n   245\t                           e\n   246\t                      (throw (ex-info (str \"the HEAD at \" dir\n   247\t                                           \" is not a readable record: \"\n   248\t                                           (error-text e))\n   249\t                                      {:dir dir :head text}\n   250\t                                      e))))]\n   251\t      (when-not (and (map? head)\n   252\t                     (= head-version (:version head))\n   253\t                     (jing/segment-address? (:manifest head)))\n   254\t        (throw (ex-info (str \"the HEAD at \" dir \" is not a version-\"\n   255\t                             head-version\n   256\t                             \" record naming a manifest address\")\n   257\t                        {:dir dir :head head})))\n   258\t      (:manifest head))\n   259\t    nil))\n   260\t\n   261\t\n   262\t(defn- validated-snapshot\n   263\t  \"The datoms of the snapshot HEAD names, walked eagerly through the\n   264\t   opened store — the design's full read-manifest and read-datoms\n   265\t   traversal.  A missing or invalid manifest, or any unreadable index\n   266\t   node, refuses startup here; never a silent empty index.\"\n   267\t  [store dir manifest-address]\n   268\t  (try\n   269\t    (vec (dao.index/read-datoms store manifest-address))\n   270\t    (catch #?(:cljd Object\n   271\t              :clj Throwable\n   272\t              :cljs :default)\n   273\t           e\n   274\t      (throw (ex-info (str \"the durable index at \" dir \" is corrupt: \"\n   275\t                           (error-text e))\n   276\t                      {:dir dir :manifest manifest-address}\n   277\t                      e)))))\n   278\t\n   279\t\n   280\t(defn- open-locked-dir\n   281\t  \"Open the durable directory as its one owner: take the lock before\n   282\t   anything else in the directory is touched, then open the content log,\n   283\t   read HEAD, and walk the snapshot it names.  Every failure after the\n   284\t   lock releases it again, so a refused startup never leaves this\n   285\t   process holding a directory it did not open.\"\n   286\t  [dir]\n   287\t  (let [lock (fs/lock! dir)]\n   288\t    (try\n   289\t      (let [handle (try (jing.file/create-content-file (content-path dir))\n   290\t                        (catch #?(:cljd Object\n   291\t                                  :clj Exception\n   292\t                                  :cljs :default)\n   293\t                               e\n   294\t                          (throw (ex-info (str \"cannot open the index store at \"\n   295\t                                               (content-path dir) \": \"\n   296\t                                               (error-text e))\n   297\t                                          {:dir dir}\n   298\t                                          e))))\n   299\t            manifest (recovered-head dir)\n   300\t            datoms (when manifest\n   301\t                     (validated-snapshot handle dir manifest))]\n   302\t        {:handle handle\n   303\t         :lock lock\n   304\t         :recovery {:manifest manifest\n   305\t                    :datoms datoms}})\n   306\t      (catch #?(:cljd Object\n   307\t                :clj Throwable\n   308\t                :cljs :default)\n   309\t             e\n   310\t        (fs/unlock! lock)\n   311\t        (throw e)))))\n   312\t\n   313\t\n   314\t(defn open\n   315\t  \"Open the store `spec` names and keep it plain: `:mem` (or nil) is a\n   316\t   fresh in-memory `dao.jing` store; `{:type :file :dir dir}` is the\n   317\t   durable content log at `<dir>/content.jing`, opened once here and\n   318\t   carried by the shell for its lifetime.  A spec this build cannot open\n   319\t   is refused with its reason.\n   320\t\n   321\t   The durable open is exclusive and validating.  The directory lock is\n   322\t   acquired before the content log or HEAD is touched — a second owner\n   323\t   is refused naming the directory — and every failure after it releases\n   324\t   the lock again.  HEAD is read and the snapshot it names walked in\n   325\t   full: an absent HEAD is an empty index; a malformed HEAD or a corrupt\n   326\t   snapshot refuses startup rather than starting empty.\n   327\t\n   328\t   Beside the plain byte-store fns, the durable handle carries what its\n   329\t   lifecycle owns: `:close-fn`, wrapped to release the lock with the\n   330\t   content log; `:head-fn`, `(fn [manifest-address])`, the atomic HEAD\n   331\t   write a round performs after its manifest is read back; `:recovery`,\n   332\t   `{:manifest <address or nil> :datoms <the walked snapshot or nil>}`,\n   333\t   exposed for the rehydration slice; and `:durable-dir`, the directory\n   334\t   an operator's refusal can name.\"\n   335\t  [spec]\n   336\t  (let [checked (checked-spec spec)]\n   337\t    (if (= :mem checked)\n   338\t      (jing.mem/create-content-mem)\n   339\t      (let [dir (:dir checked)]\n   340\t        (if-some [refusal (file-refusal dir)]\n   341\t          (throw (ex-info refusal {:dir dir}))\n   342\t          (let [{:keys [handle lock recovery]} (open-locked-dir dir)\n   343\t                close-content! (:close-fn handle)]\n   344\t            (assoc handle\n   345\t                   :close-fn (fn []\n   346\t                               (close-content!)\n   347\t                               (fs/unlock! lock))\n   348\t                   :head-fn (fn publish-head!\n   349\t                              [manifest-address]\n   350\t                              (fs/atomic-replace!\n   351\t                                dir head-name\n   352\t                                (head-record manifest-address)))\n   353\t                   :recovery recovery\n   354\t                   :durable-dir dir)))))))\n   355\t\n   356\t\n   357\t(defn close!\n   358\t  \"Release the store's lifecycle resources — the content log handle and,\n   359\t   in durable mode, the directory lock.  Nothing further can be read or\n   360\t   written through the handle afterwards.  Idempotent.\"\n   361\t  [store]\n   362\t  (when-let [close! (:close-fn store)]\n   363\t    (close!)))\n    65\t        \"--port\" (recur (nnext args)\n    66\t                        (assoc opts :port (when-let [p (second args)]\n    67\t                                            #?(:cljd (int/parse p)\n    68\t                                               :cljs (js/parseInt p 10)\n    69\t                                               :clj (Long/parseLong p)))))\n    70\t        \"--host\" (recur (nnext args) (assoc opts :host (second args)))\n    71\t        \"--headless\" (recur (next args) (assoc opts :headless? true))\n    72\t        \"--index-store\" (recur (nnext args)\n    73\t                               (assoc opts\n    74\t                                      :index-store-spec\n    75\t                                      (store/parse-arg (second args))))\n    76\t        \"--telemetry\" (recur (next args) (update opts :rejected conj arg))\n    77\t        \"--telemetry-stream\" (recur (nnext args) (update opts :rejected conj arg))\n    78\t        (recur (next args) (update opts :extra (fnil conj []) arg)))\n    79\t      opts)))\n    80\t\n    81\t\n    82\t(defn boot\n    83\t  \"Create the composition: one shell, one input medium, one cursor held only by\n    84\t   the step owner, and the host WebSocket adapter `(connect …)` attaches\n    85\t   through.  The parsed `:index-store-spec` reaches the shell's store\n    86\t   selection, which resolves and opens it once at construction.\"\n    87\t  ([] (boot {}))\n    88\t  ([opts] (driver/create-state\n    89\t            {:host (or (:adapter opts) (host/websocket))\n    90\t             :repl (shell/create-state {:index-store-spec\n    91\t                                        (:index-store-spec opts)})})))\n    92\t\n    93\t\n    94\t(defn boot-server\n    95\t  \"Compose the served endpoint for `--port`, or nil when no port was asked for.\n    96\t\n    97\t   `serve!` returns immediately.  Whether a listener bound is a fact the\n    98\t   endpoint's lifecycle medium reports, and the ticker prints it.\"\n    99\t  [opts]\n   100\t  (when (:port opts)\n   101\t    (serve/serve! {:bind-port (:port opts)\n   102\t                   :bind-host (or (:host opts) serve/default-bind-host)\n   103\t                   :host (or (:adapter opts) (host/websocket))})))\n   104\t\n   105\t\n   106\t(defn startup\n   107\t  \"Parse the arguments and compose the whole shell — the store the parsed\n   108\t   `:index-store-spec` names included — or answer the refusal text.  This\n   109\t   is the one gate every host's `-main` passes through before it prints a\n   110\t   banner or starts a loop, so an invalid `--index-store`, an unsupported\n   111\t   host for it, or a directory that cannot be opened refuses startup with\n   112\t   its reason rather than composing a shell around a fallback store.\n   113\t\n   114\t   Only a designed refusal is answered: an error carrying no ex-info\n   115\t   keeps its stack trace, because it is a defect, not an operator error.\"\n   116\t  [args]\n   117\t  (try\n   118\t    (let [opts (parse-args args)]\n   119\t      {:opts opts\n   120\t       :state (boot opts)\n   121\t       :server (boot-server opts)})\n   122\t    (catch #?(:cljd Object\n   123\t              :clj Throwable\n   124\t              :cljs :default)\n   125\t           e\n   126\t      (if (ex-data e)\n   127\t        {:refusal (or (ex-message e) (str e))}\n   128\t        (throw e)))))\n   129\t\n   130\t\n   131\t(defn- refuse!\n   132\t  \"Print why the composition refused to start and end the process with a\n   133\t   failing status, so a refused startup never looks like a working shell.\"\n   134\t  [refusal]\n   135\t  (println refusal)\n   136\t  #?(:cljd (io/exit 1)\n   137\t     :clj (.halt (Runtime/getRuntime) 1)\n   138\t     :cljs (.exit js/process 1)))\n   139\t\n   140\t\n   141\t(defn close-index-store!\n   142\t  \"Release the index store's lifecycle resources before the host exits —\n   143\t   in durable mode, the exclusive directory lock.  The shell has already\n   144\t   stopped when a host calls this; the memory store has nothing to\n   145\t   release.\"\n   280\t               (zero? remaining) (println stop-timeout-text)\n   281\t               :else (do (wake/sleep! w tick-millis)\n   282\t                         (recur server' (dec remaining))))))))\n   283\t\n   284\t     (defn poll-loop!\n   285\t       \"The sole owner of REPL and endpoint state on the JVM.  It carries both\n   286\t        values through serial steps; nothing is shared with the reader.\n   287\t\n   288\t        Its cadence is `cadence/cadence-step` over `default-cadence`, slept\n   289\t        through the wake source `w` (one is made when the caller supplied\n   290\t        none): any line the reader deposits — and the explicit stop trigger —\n   291\t        nudges it, so operator actions never wait out the idle curve.\n   292\t\n   293\t        It also owns the exit.  The reader is parked in `read-line` and cannot\n   294\t        observe that the shell has quit, so a typed `(quit)` would otherwise\n   295\t        stop the endpoint and then wait for end-of-input that only Ctrl-D\n   296\t        produces.  `exit!` is called once, by this thread, after the endpoint\n   297\t        has drained.\"\n   298\t       ([state server headless?]\n   299\t        (poll-loop! state server headless? #(.halt (Runtime/getRuntime) 0)))\n   300\t       ([state server headless? exit!]\n   301\t        (poll-loop! state server headless? exit! (wake/make-wake)))\n   302\t       ([state server headless? exit! w]\n   303\t        (loop [state state\n   304\t               server server\n   305\t               cadence (cadence/init default-cadence)]\n   306\t          (let [[state' server' lines] (step-all state server\n   307\t                                                 (System/currentTimeMillis))]\n   308\t            (doseq [line lines]\n   309\t              (println line))\n   310\t            (if (:running? state')\n   311\t              (do (when (and (seq lines) (not headless?))\n   312\t                    (print-prompt!))\n   313\t                  (let [{:keys [cadence-state sleep-ms]}\n   314\t                        (cadence/cadence-step cadence (moved? state' server' lines))]\n   315\t                    (wake/sleep! w sleep-ms)\n   316\t                    (recur state' server' cadence-state)))\n   317\t              (do (drain-server! server' w)\n   318\t                  (println)\n   319\t                  (close-index-store! state')\n   320\t                  (exit!)))))))\n   321\t\n   322\t     (defn- read-loop!\n   323\t       \"The reader parks in `read-line` and appends, nudging the step owner's\n   324\t        wake: a typed line ends the idle sleep at once.  It reads no state.\"\n   325\t       [input w]\n   370\t             (.halt (Runtime/getRuntime) 0)))))))\n   371\t\n   372\t\n   373\t;; =============================================================================\n   374\t;; cljs (Node) — a readline handler that only appends, and one interval owner\n   375\t;; =============================================================================\n   376\t\n   377\t#?(:cljs\n   378\t   (do\n   379\t     (defn- run-node!\n   380\t       \"The tick owner on Node: one wake source arms exactly one timer per\n   381\t        round, at the interval `cadence-step` computes over\n   382\t        `default-cadence`.  Returns the wake so the composition can wire its\n   383\t        line producers — the readline handlers, the stop signals — as\n   384\t        `nudge!` callers.\n   385\t\n   386\t        `repl-step` is synchronous and the Node event loop is single\n   387\t        threaded, so a tick cannot overlap itself.  The box is host cadence\n   388\t        plumbing: the tick is the only reader and writer of it.  `:stopping`\n   389\t        is nil while the shell runs and a tick budget afterwards: the\n   390\t        endpoint is asked to stop once and stepped at the base interval — a\n   391\t        bounded drain, not a curve — until it reports it.\"\n   392\t       [state server rl]\n   393\t       (let [box (atom {:state state :server server :stopping nil\n   394\t                        :cadence (cadence/init default-cadence)})\n   395\t             wake-ref (volatile! nil)\n   396\t             finish! (fn []\n   397\t                       (wake/disarm! @wake-ref)\n   398\t                       (when rl (.close rl))\n   399\t                       (close-index-store! (:state @box))\n   400\t                       (js/process.exit 0))\n   401\t             tick (fn []\n   402\t                    ;; The interval timer this namespace replaced fired\n   403\t                    ;; again whatever happened, so a tick whose body throws\n   404\t                    ;; must not kill the owner: arm the fallback first and\n   405\t                    ;; let the body's own `arm!` replace it. `finish!`\n   406\t                    ;; disarms, so a finished owner parks nothing.\n   407\t                    (wake/arm! @wake-ref tick-millis)\n   408\t                    (let [{:keys [state server stopping cadence]} @box]\n   409\t                      (if (nil? stopping)\n   410\t                        (let [[state' server' lines] (step-all state server\n   411\t                                                               (js/Date.now))]\n   412\t                          (reset! box {:state state'\n   413\t                                       :server server'\n   414\t                                       :stopping nil\n   415\t                                       :cadence cadence})\n   485\t;; =============================================================================\n   486\t\n   487\t#?(:cljd\n   488\t   (do\n   489\t     (defn- write-line!\n   490\t       [message]\n   491\t       (p