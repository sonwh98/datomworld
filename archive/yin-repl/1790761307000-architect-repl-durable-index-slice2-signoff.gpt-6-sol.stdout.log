\n   327\t                                 (jing/segment-key manifest {:algorithm algo})),\n   328\t                       :manifest manifest})))\n   329\t    manifest))\n   330\t\n   331\t\n   332\t(defn read-datoms\n   333\t  \"Eagerly read every datom in the EAVT index of a published manifest, in\n   334\t   index order, by walking the node graph with plain `jing/get`. Takes the\n   335\t   manifest's content address; an empty index reads as ().\"\n   336\t  [content-store manifest-address]\n   337\t  (let [manifest (read-manifest content-store manifest-address)]\n   338\t    (vec (walk-index-datoms content-store (:eavt (:indexes manifest))))))\n   339\t\n   340\t\n   341\t(defn restored-indexes\n   342\t  \"Lazily-loaded {:eavt :aevt :avet :vaet} dao.data.btree sets over a\n   343\t   published manifest (`{:indexes {...} :count n :branching-factor n}`).\n   344\t   Nothing is fetched until a query traverses; slice (subseq-from) then\n   345\t   loads only the seek path plus the matching range. Works on every\n   346\t   platform.\n   347\t\n   348\t   The manifest's :count and :branching-factor are threaded through\n   349\t   restore-tree deliberately: count keeps O(1) `count` on restored trees\n   350\t   without faulting the graph, and the branching factor reaches every\n   351\t   restored node so mutation splits at the published thresholds. A manifest\n   352\t   without :count or :branching-factor is foreign or hand-built and belongs\n   353\t   to the eager path (walk-index-datoms), not here.\"\n   354\t  [content-store manifest]\n   355\t  (let [{:keys [indexes count branching-factor]} manifest\n   155\t\n   156\t(defn- error-text\n   157\t  \"The host error's own message, for the tail of a refusal.\"\n   158\t  [e]\n   159\t  #?(:cljd (str e)\n   160\t     :clj (or (ex-message e) (str e))\n   161\t     :cljs (or (ex-message e) (str e))))\n   162\t\n   163\t\n   164\t(defn- dir-refusal\n   165\t  \"Why `dir` cannot hold the durable content log, or nil when it can: a\n   166\t   path occupied by something that is not a directory, a directory this\n   167\t   process cannot write, or a directory that cannot be created.  Nothing\n   168\t   is opened here — the content log itself is opened later, and its open\n   169\t   failure is refused with its own reason.\"\n   170\t  [dir]\n   171\t  #?(:cljd (let [d (dart-io/Directory. dir)\n   172\t                 f (dart-io/File. dir)]\n   173\t             (cond\n   174\t               (.existsSync d) nil\n   175\t               (.existsSync f) (str dir \" is not a directory\")\n   176\t               :else (try (.createSync d .recursive true)\n   177\t                          nil\n   178\t                          (catch Object e\n   179\t                            (str \"cannot create \" dir \": \" (error-text e))))))\n   180\t     :clj (let [f (java.io.File. dir)]\n   181\t            (cond\n   182\t              (and (.exists f) (not (.isDirectory f)))\n   183\t              (str dir \" is not a directory\")\n   184\t\n   185\t              (and (.isDirectory f) (not (.canWrite f)))\n   186\t              (str dir \" is not writable\")\n   187\t\n   188\t              :else\n   189\t              (try (when (and (not (.isDirectory f)) (not (.mkdirs f)))\n   190\t                     (str \"cannot create \" dir))\n   191\t                   (catch Exception e\n   192\t                     (str \"cannot create \" dir \": \" (error-text e))))))\n   193\t     :cljs (let [fs (js/require \"fs\")]\n   194\t             (if (.existsSync fs dir)\n   195\t               (when-not (.isDirectory (.statSync fs dir))\n   196\t                 (str dir \" is not a directory\"))\n   197\t               (try (.mkdirSync fs dir #js {:recursive true})\n   198\t                    nil\n   199\t                    (catch :default e\n   200\t                      (str \"cannot create \" dir \": \" (error-text e))))))))\n   201\t\n   202\t\n   203\t(defn file-refusal\n   204\t  \"Why a `file:<dir>` store cannot open, or nil when it can: a host without\n   205\t   file support is named first — never answered with a memory fallback —\n   206\t   then the directory's own refusal.  The one-argument arity asks this\n   207\t   build's own capability; the two-argument one answers for the capability\n   208\t   it is handed, which is how the unsupported-host refusal is tested on\n   209\t   hosts that do have file support.\"\n   210\t  ([dir] (file-refusal (host-file-support) dir))\n   211\t  ([capable? dir]\n   212\t   (or (when-not capable? unsupported-host-text)\n   213\t       (dir-refusal dir))))\n   390\t  (fn content-close!\n   391\t    []\n   392\t    (with-lock\n   393\t      lock\n   394\t      (fn []\n   395\t        (when-not (:closed? @state)\n   396\t          (swap! state assoc :closed? true)\n   397\t          (close-file! f))\n   398\t        nil))))\n   399\t\n   400\t\n   401\t;; =============================================================================\n   402\t;; Constructor\n   403\t;; =============================================================================\n   404\t\n   405\t(defn create-content-file\n   406\t  \"Open or create a content file at path: validate every complete frame,\n   407\t   truncate any incomplete tail (F3), replay every record into an\n   408\t   in-memory map of address to payload bytes (F2, F4), and return the\n   409\t   plain-data byte-store handle {:put-bytes-fn :get-bytes-fn :close-fn}\n   410\t   (D1). A\n   411\t   frame that is not a canonical [digest payload] record, whose digest is\n   412\t   not its payload's under a registered algorithm, or whose payload is not\n   413\t   canonical fails the open, loudly and without mutation (F4).\"\n   414\t  [path]\n   415\t  (let [f (open-file! path)]\n   416\t    (try (let [recovered (replay-records (recover! f))\n   417\t               state (atom {:closed? false, :content recovered})\n   418\t               lock #?(:clj (Object.)\n   419\t                       :cljs (js-obj)\n   420\t                       :cljd (Object.))]\n   421\t           {:put-bytes-fn (make-put state f lock),\n   422\t            :get-bytes-fn (make-get state),\n   423\t            :close-fn (make-close state f lock)})\n   424\t         (catch #?(:clj Exception\n   425\t                   :cljs :default\n   426\t                   :cljd Object)\n   427\t                e\n   428\t           (try (close-file! f)\n   429\t                (catch #?(:clj Exception\n   430\t                          :cljs :default\n   431\t                          :cljd Object)\n   432\t                       _\n   433\t                  nil))\n   434\t           (throw e)))))\n   435\t\n   436\t\n   437\t;; =============================================================================\n   438\t;; The test's view of a path (F5)\n   439\t;; =============================================================================\n   440\t\n   441\t(defn records\n   442\t  \"The decoded, validated [address value] record vector of the file at\n   443\t   path -- every frame in order, equal duplicates included. Opens with the\n   444\t   same validate-then-truncate pass as create-content-file, reads and\n   445\t   closes. This is the file backend's test-facing view (D4): what the\n   446\t   in-memory map holds is observable through the handle; what the file\n   447\t   holds is observable here.\"\n   448\t  [path]\n   449\t  (let [f (open-file! path)]\n   450\t    (try (mapv (fn [[address payload]]\n   451\t                 [address (jing/segment-value address payload)])\n   452\t               (recover! f))\n   453\t         (finally (close-file! f)))))\n","exit_code":0,"status":"completed"}}
