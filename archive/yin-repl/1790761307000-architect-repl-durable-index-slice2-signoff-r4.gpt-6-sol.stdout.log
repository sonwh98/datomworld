Throwable\n   287\t              :cljs :default)\n   288\t           e\n   289\t      (throw (ex-info (str \"the durable index at \" dir \" is corrupt: \"\n   290\t                           (error-text e))\n   291\t                      {:dir dir :manifest manifest-address}\n   292\t                      e)))))\n   293\t\n   294\t\n   295\t(defn- open-locked-dir\n   296\t  \"Open the durable directory as its one owner: take the lock before\n   297\t   anything else in the directory is touched, then open the content log,\n   298\t   read HEAD, and walk the snapshot it names.  Every failure after the\n   299\t   lock closes the content log it opened and releases the lock again, so\n   300\t   a refused startup never leaves this process holding a directory it\n   301\t   did not open.\"\n   302\t  [dir]\n   303\t  (let [lock (fs/lock! dir)\n   304\t        opened (volatile! nil)]\n   305\t    (try\n   306\t      (let [handle (try (jing.file/create-content-file (content-path dir))\n   307\t                        (catch #?(:cljd Object\n   308\t                                  :clj Exception\n   309\t                                  :cljs :default)\n   310\t                               e\n   311\t                          (throw (ex-info (str \"cannot open the index store at \"\n   312\t                                               (content-path dir) \": \"\n   313\t                                               (error-text e))\n   314\t                                          {:dir dir}\n   315\t                                          e))))\n   316\t            _ (vreset! opened handle)\n   317\t            manifest (recovered-head dir)\n   318\t            datoms (when manifest\n   319\t                     (validated-snapshot handle dir manifest))]\n   320\t        {:handle handle\n   321\t         :lock lock\n   322\t         :recovery {:manifest manifest\n   323\t                    :datoms datoms}})\n   324\t      (catch #?(:cljd Object\n   325\t         