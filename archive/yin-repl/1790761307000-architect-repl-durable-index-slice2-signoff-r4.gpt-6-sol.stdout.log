 with this build's\ntest/yin/repl/store_test.cljc:638:      and the runner's autorun — so the worker has its own `held`\ntest/yin/repl/store_test.cljc:639:      registry and shares the process's pid, exactly like a second worker\ntest/yin/repl/store_test.cljc:643:      random pause, as an operator restarting would, so the pair settles\ntest/yin/repl/store_test.cljc:646:       \"const {workerData} = require('worker_threads');\\n\"\ntest/yin/repl/store_test.cljc:648:       \"const {sab, bundle, dir, id} = workerData;\\n\"\ntest/yin/repl/store_test.cljc:675:   (deftest two-worker-threads-of-one-process-never-both-own-the-directory\ntest/yin/repl/store_test.cljc:677:           Worker (.-Worker (js/require \"worker_threads\"))\ntest/yin/repl/store_test.cljc:688:                   (Worker. worker-contender-js\ntest/yin/repl/store_test.cljc:690:                                 :workerData #js {:sab sab\ntest/yin/repl/store_test.cljc:694:           workers (atom [])]\ntest/yin/repl/store_test.cljc:697:         (swap! workers conj (spawn 1) (spawn 2))\ntest/yin/repl/store_test.cljc:699:             \"both workers loaded the store namespace\")\ntest/yin/repl/store_test.cljc:704:               (str \"exactly one worker owns the directory, never both: \"\ntest/yin/repl/store_test.cljc:713:           (doseq [w @workers] (.terminate w))\ntest/yin/repl/store_test.cljc:1039:              \"the refusal names the directory an operator can act on\")))\n   515\t               (store/close! after))))\n   516\t         (finally\n   517\t           (cleanup-dir! dir))))))\n   518\t\n   519\t\n   520\t#?(:cljd nil\n   521\t   :cljs\n   522\t   (defn- claim-files\n   523\t     \"The Node claim entries in `dir`: `lock.<pid>.<nonce>`.\"\n   524\t     [dir]\n   525\t     (set (filter #(str/starts-with? % (str fs/lock-name \".\"))\n   526\t                  (.readdirSync (js/require \"fs\") dir)))))\n   527\t\n   528\t\n   529\t#?(:cljd nil\n   530\t   :cljs\n   531\t   (defn- dead-pid\n   532\t     \"The pid of a process that has already exited and been reaped.\"\n   533\t     []\n   534\t     (.-pid (.spawnSync (js/require \"child_process\") \"true\"))))\n   535\t\n   536\t\n   537\t#?(:cljd nil\n   538\t   :cljs\n   539\t   (deftest a-live-foreign-owner-is-refused-and-a-dead-ones-lock-is-replaced\n   540\t     (let [dir (temp-dir)\n   541\t           node-fs (js/require \"fs\")]\n   542\t       (try\n   543\t         (store/close! (store/open {:type :file :dir dir}))\n   544\t         (is (empty? (claim-files dir)) \"close withdraws the claim\")\n   545\t         (testing \"a claim by another live process refuses, naming the dir\"\n   546\t           (let [owner (str fs/lock-name \".\" (.-ppid js/process) \".0\")]\n   547\t             (.writeFileSync node-fs (str dir \"/\" owner) \"\")\n   548\t             (let [refusal (refusal-of #(store/open {:type :file :dir dir}))]\n   549\t               (is (str/includes? (str (ex-message refusal)) dir))\n   550\t               (is (str/includes? (str (ex-message refusal)) \"locked\"))\n   551\t               (is (str/includes? (str (ex-message refusal)) owner)\n   552\t                   \"the refusal names the claim an operator would remove\n   553\t                    were its pid a reused one\"))\n   554\t             (is (= #{owner} (claim-files dir))\n   555\t                 \"the live owner's claim is left as it was; the refused\n   556\t                  contender withdrew its own\")\n   557\t             (.unlinkSync node-fs (str dir \"/\" owner))))\n   558\t         (testing \"a crashed owner's claim is removed, never obeyed\"\n   559\t           (let [crashed (str fs/lock-name \".\" (dead-pid) \".0\")]\n   560\t             (.writeFileSync node-fs (str dir \"/\" crashed) \"\")\n   561\t             (let [opened (store/open {:type :file :dir dir})\n   562\t                   claims (claim-files dir)]\n   563\t               (is (= 1 (count claims)))\n   564\t               (is (str/starts-with? (fir