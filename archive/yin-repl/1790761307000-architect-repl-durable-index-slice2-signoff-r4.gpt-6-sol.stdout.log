he test namespaces\n   638\t      and the runner's autorun — so the worker has its own `held`\n   639\t      registry and shares the process's pid, exactly like a second worker\n   640\t      in a real process.  Flags (an Int32Array over a SharedArrayBuffer):\n   641\t      [1|2] loaded, [0] start, [3|4] outcome (1 owns, 2 refused), [5]\n   642\t      release, [6|7] released.  A refused contender retries with a small\n   643\t      random pause, as an operator restarting would, so the pair settles\n   644\t      on exactly one owner.\"\n   645\t     (str\n   646\t       \"const {workerData} = require('worker_threads');\\n\"\n   647\t       \"const nodeFs = require('fs'); const nodePath = require('path');\\n\"\n   648\t       \"const {sab, bundle, dir, id} = workerData;\\n\"\n   649\t       \"const flags = new Int32Array(sab);\\n\"\n   650\t       \"const pause = new Int32Array(new SharedArrayBuffer(4));\\n\"\n   651\t       \"const last = 'SHADOW_IMPORT(\\\"yin.repl.store.fs.js\\\");';\\n\"\n   652\t       \"let text = nodeFs.readFileSync(bundle, 'utf8');\\n\"\n   653\t       \"text = text.slice(text.indexOf('\\\\n') + 1, text.indexOf(last) + last.length);\\n\"\n   654\t       \"text = text.split('\\\\n').filter(l => !(l.startsWith('SHADOW_IMPORT(') && l.includes('_test.js'))).join('\\\\n') + '\\\\n})();';\\n\"\n   655\t       \"new Function('require', 'module', '__filename', '__dirname', text)\"\n   656\t       \"(require, module, bundle, nodePath.dirname(bundle));\\n\"\n   657\t       \"const fsns = global.yin.repl.store.fs;\\n\"\n   658\t       \"Atomics.store(flags, id, 1); Atomics.notify(flags, id);\\n\"\n   659\t       \"while (Atomics.load(flags, 0) === 0) Atomics.wait(flags, 0, 0, 100);\\n\"\n   660\t       \"let held = null;\\n\"\n   661\t       \"for (let i = 0; i < 50 && held === null; i++) {\\n\"\n   662\t       \"  try { held = fsns.lock_BANG_(dir); }\\n\"\n   663\t       \"  catch (e) { Atomics.wait(pause, 0, 0, Math.floor(Math.random() * 20)); }\\n\"\n   664\t       \"}\\n\"\n   665\t       \"Atomics.store(flags, 2 + id, held === null ? 2 : 1); Atomics.notify(flags, 2 + id);\\n\"\n   666\t       \"if (held !== null) {\\n\"\n   667\t       \"  while (Atomics.load(flags, 5) === 0) Atomics.wait(flags, 5, 0, 100);\\n\"\n   668\t       \"  fsns.unlock_BANG_(held);\\n\"\n   669\t       \"  Atomics.store(flags, 5 + id, 1); Atomics.notify(flags, 5 + id);\\n\"\n   670\t       \"}\\n\")))\n   671\t\n   672\t\n   673\t#?(:cljd nil\n   674\t   :cljs\n   675\t   (deftest two-worker-threads-of-one-process-never-both-own-the-directory\n   676\t     (let [dir (temp-dir)\n   677\t           Worker (.-Worker (js/require \"worker_threads\"))\n   678\t           sab (js/SharedArrayBuffer. 32)\n   679\t           flags (js/Int32Array. sab)\n   680\t           await! (fn [i]\n   681\t                    (loop [n 0]\n   682\t                      (cond\n   683\t                        (not= 0 (aget flags i)) (aget flags i)\n   684\t                        (< n 600) (do (js/Atomics.wait flags i 0 100)\n   685\t                                      (recur (inc n)))\n   686\t                        :else nil)))\n   687\t           spawn (fn [id]\n   688\t                   (Worker. worker-contender-js\n   689\t                            #js {:eval true\n   690\t                                 :workerData #js {:sab sab\n   691\t                                                  :bundle js/__filename\n   692\t                                                  :dir dir\n   693\t                                                  :id id}}))\n   694\t           workers (atom [])]\n   695\t       (try\n   696\t         (store/close! (store/open {:type :file :dir dir}))\n   697\t         (swap! workers conj (spawn 1) (spawn 2))\n   698\t         (is (= [1 1] [(await! 1) (await! 2)])\n   699\t             \"both workers loaded the store namespace\")\n   700\t         (js/Atomics.store flags 0 1)\nThe Dart run is still going; it is not hung on anything this round touched. The log is still being written, and the current test, `yin.vm.semantic-test/step-test`, is unrelated to the store. The machine is under heavy load (load average 12–16).\n\nEvery round-3 change sits in ClojureScript-only code (`node-lock!`), cljs-only tests, or docstrings, so the Dart-compiled code is the same as the green round-2 run. I'm still waiting for the real result before writing the report. I'll pick up as soon as the run finishes.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"git diff --stat; nl -ba src/cljc/yin/repl/store/fs.cljc | sed -n '1,255p'; nl -ba src/cljc/yin/repl/store/fs.cljc | sed -n '255,365p'\"","aggregated_output":" docs/design/yin.repl.dao.space-index.md |  96 ++++\n src/cljc/yin/repl.cljc                  |  27 +-\n src/cljc/yin/repl/index.cljc            |  17 +-\n src/cljc/yin/repl/main.cljc             |  12 +\n src/cljc/yin/repl/store.cljc            | 227 +++++++-\n test/yin/repl/index_test.cljc           | 112 +++-\n test/yin/repl/store_test.cljc           | 893 +++++++++++++++++++++++++++++++-\n 7 files changed, 1344 insertions(+), 40 deletions(-)\n     1\t(ns yin.repl.store.fs\n     2\t  \"Explicit host file operations for the durable index store directory\n     3\t   (docs/design/yin.repl.dao.space-index.md, the durable-store design's\n     4\t   host section): an exclusive directory lock held by the one process\n     5\t   that owns the store, and an atomic write-temp, sync, rename\n     6\t   replacement for HEAD. CLJ, Node, and Dart each implement them with\n     7\t   their own primitives; nothing here falls back silently.\n     8\t\n     9\t   Lock ownership is an operating-system fact on the JVM — an exclusive\n    10\t   `FileChannel` lock on `<dir>/lock`, released when the holding process\n    11\t   dies — and on Dart, `RandomAccessFile.lockSync`. Node has no flock in\n    12\t   its core, so each contender creates its own uniquely named claim\n    13\t   entry, `lock.<pid>.<nonce>`, and then reads the others: a live one\n    14\t   refuses, and a dead one — an owner or a contender that crashed at any\n    15\t   point — is removed without a race, because a unique name is never\n    16\t   created again.  A crashed process never bricks the directory, and two\n    17\t   contenders never both own it (`node-lock!`) — two worker threads of\n    18\t   one process included, since a claim naming this pid is live unless it\n    19\t   is this call's own entry.\n    20\t\n    21\t   Contract, pid reuse (Node only): a claim's liveness is its pid's, so a\n    22\t   crashed owner's claim whose pid the OS has since given to an\n    23\t   unrelated live process reads as live, and startup refuses — the safe\n    24\t   direction; it is never read as dead while alive.  The refusal names\n    25\t   the claim entries it saw.  Operator remedy: confirm that no REPL uses\n    26\t   the directory, then delete the named `<dir>/lock.<pid>.<nonce>`\n    27\t   entries (or wait until the process holding that pid exits); the next\n    28\t   start opens normally.  The JVM and Dart locks are held by the\n    29\t   operating system and have no pid-reuse case.\n    30\t\n    31\t   HEAD replacement writes the whole record to a temp file in the same\n    32\t   directory — every byte of it, however many writes the host takes —\n    33\t   syncs it, and renames it over HEAD — rename is the atomicity, so a\n    34\t   torn, short, or interrupted write is never observed as HEAD.\n    35\t   The directory itself is then synced where the host can\n    36\t   (`directory-sync-supported?`: Node and the JVM on POSIX systems), and\n    37\t   there a failed sync fails the replacement; a host that cannot sync a\n    38\t   directory at all (Dart's core, Windows) is not a failed sync.\n    39\t\n    40\t   The operating-system locks are per process — a POSIX `fcntl` lock\n    41\t   never refuses its own process — so this process's own holdings are\n    42\t   kept here too, in `held`: a second owner inside the one process is\n    43\t   refused by that record before any second handle on the lock file is\n    44\t   opened.  `held` is process-global mutable state, an explicit\n    45\t   exception to the no-hidden-global-state invariant: it mirrors a fact\n    46\t   the host itself keeps per process (which files this process has\n    47\t   locked), so it can be no narrower than the process, and it holds\n    48\t   nothing but the canonical paths of the directories this process\n    49\t   currently owns.  On Node each worker thread has its own `held`; across\n    50\t   workers the claim entries decide.\"\n    51\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n    52\t            [clojure.string :as str]))\n    53\t\n    54\t\n    55\t(def lock-name\n    56\t  \"The lock file's own name inside the durable store directory, and the\n    57\t   prefix of Node's claim entries (`lock.<pid>.<nonce>`).  Its presence\n    58\t   is bookkeeping, never authority: the JVM and Dart locks live on open\n    59\t   handles, and each Node entry names a pid that is checked for life — a\n    60\t   reused pid keeps a dead claim live until an operator removes the\n    61\t   entry (see the namespace docstring's pid-reuse contract).\"\n    62\t  \"lock\")\n    63\t\n    64\t\n    65\t(defn- refuse-locked\n    66\t  [dir]\n    67\t  (throw (ex-info (str dir \" is locked by another process\")\n    68\t                  {:dir dir})))\n    69\t\n    70\t\n    71\t(defn- read-text!\n    72\t  \"The file at `path` as text — trimmed, for one-record files read whole —\n    73\t   or nil when absent.\"\n    74\t  [path]\n    75\t  #?(:cljd (let [f (dart-io/File. path)]\n    76\t             (when (.existsSync f)\n    77\t               (str/trim (.readAsStringSync f))))\n    78\t     :clj (let [f (java.io.File. ^String path)]\n    79\t            (when (.exists f) (str/trim (slurp f))))\n    80\t     :cljs (let [fs (js/require \"fs\")]\n    81\t             (when (.existsSync ^js fs path)\n    82\t               (str/trim (.readFileSync ^js fs path \"utf8\"))))))\n    83\t\n    84\t\n    85\t#?(:cljs\n    86\t   (defn- live-pid?\n    87\t     \"True when a pid names a live process — the lock file's owner is\n    88\t      alive.  A process this one may not signal (`EPERM`) is alive too.\"\n    89\t     [pid]\n    90\t     (try (.kill js/process pid 0)\n    91\t          true\n    92\t          (catch :default e\n    93\t            (= \"EPERM\" (.-code e))))))\n    94\t\n    95\t\n    96\t#?(:cljs\n    97\t   (defn- claim-entries\n    98\t     \"Every Node claim entry in the directory, as `[file-name pid]`: the\n    99\t      files `lock.<pid>.<nonce>`, each created by the one process whose\n   100\t      pid it names.\"\n   101\t     [fs dir]\n   102\t     (keep (fn [file-name]\n   103\t             (when-some [[_ pid] (re-matches #\"lock\\.(\\d+)\\.[0-9a-f-]+\"\n   104\t                                             file-name)]\n   105\t               [file-name (js/parseInt pid 10)]))\n   106\t           (.readdirSync ^js fs dir))))\n   107\t\n   108\t\n   109\t#?(:cljs\n   110\t   (defn- node-lock!\n   111\t     \"Claim the directory on Node, answering the release, or refuse.\n   112\t\n   113\t      Each contender creates its own uniquely named claim entry,\n   114\t      `lock.<pid>.<nonce>`, and only then reads the others.  An entry\n   115\t      naming a live process is an owner or a rival contender: the claim\n   116\t      is withdrawn and refused.  An entry naming a dead process — an\n   117\t      owner that crashed, or a contender that crashed midway through its\n   118\t      own claim — is removed, and that removal is race-free because the\n   119\t      name is unique: no later process ever creates it again, so it can\n   120\t      never be a newer live claim.  Of two contenders, each creates\n   121\t      before it reads, so at most one reads no live rival; at worst two\n   122\t      simultaneous starts both refuse, never both own.\n   123\t\n   124\t      An entry naming this very pid is live like any other: worker\n   125\t      threads share the process's pid but each has its own `held`, so\n   126\t      another worker's claim looks exactly like that — only this call's\n   127\t      own entry, by its exact name, is this contender's.  Liveness is by\n   128\t      pid, so a dead claim whose pid was reused by an unrelated live\n   129\t      process is read as live and refuses; the refusal names the claim\n   130\t      entries it saw, for the operator remedy in the namespace\n   131\t      docstring.\"\n   132\t     [dir claimed]\n   133\t     (let [fs (js/require \"fs\")\n   134\t           own-pid (.-pid js/process)\n   135\t           own (str lock-name \".\" own-pid \".\" (random-uuid))\n   136\t           own-path (str dir \"/\" own)\n   137\t           release! (fn []\n   138\t                      (try (.unlinkSync ^js fs own-path)\n   139\t                           (catch :default _ nil)))]\n   140\t       (.closeSync ^js fs (.openSync ^js fs own-path \"wx\"))\n   141\t       (try\n   142\t         (when claimed (claimed))\n   143\t         (let [live (into []\n   144\t                          (remove\n   145\t                            (fn [[file-name pid]]\n   146\t                              (when-not (live-pid? pid)\n   147\t                                (try (.unlinkSync ^js fs (str dir \"/\" file-name))\n   148\t                                     (catch :default _ nil))\n   149\t                                true)))\n   150\t                          (remove #(= own (first %)) (claim-entries fs dir)))]\n   151\t           (when (seq live)\n   152\t             (throw (ex-info (str dir \" is locked by another process\"\n   153\t                                  \" (claims: \"\n   154\t                                  (str/join \", \" (map first live)) \")\")\n   155\t                             {:dir dir :claims (mapv first live)})))\n   156\t           release!)\n   157\t         (catch :default e\n   158\t           (release!)\n   159\t           (throw e))))))\n   160\t\n   161\t\n   162\t(defonce ^:private held\n   163\t  ;; The host-ownership exception to the no-hidden-global-state invariant\n   164\t  ;; (see the namespace docstring): the canonical paths of the durable\n   165\t  ;; directories this process holds locked.\n   166\t  (atom #{}))\n   167\t\n   168\t\n   169\t(defn- canonical-dir\n   170\t  \"The directory's one canonical path: the key of this process's own\n   171\t   holdings, so two spellings of one directory are one owner.\"\n   172\t  [dir]\n   173\t  #?(:cljd (.resolveSymbolicLinksSync (dart-io/Directory. dir))\n   174\t     :clj (.getCanonicalPath (java.io.File. ^String dir))\n   175\t     :cljs (.realpathSync ^js (js/require \"fs\") dir)))\n   176\t\n   177\t\n   178\t(defn- claim!\n   179\t  \"Record `key` as held by this process, answering false when it already\n   180\t   was — a second owner inside the one process, refused before it opens\n   181\t   any handle on the lock file (closing such a handle would drop this\n   182\t   process's `fcntl` lock).\"\n   183\t  [key]\n   184\t  (let [claimed? (volatile! false)]\n   185\t    (swap! held (fn [keys]\n   186\t                  (vreset! claimed? (not (contains? keys key)))\n   187\t                  (conj keys key)))\n   188\t    @claimed?))\n   189\t\n   190\t\n   191\t(defn- host-lock!\n   192\t  \"Take the host's exclusive lock on `path`, answering its release\n   193\t   function, or refuse naming the directory.\"\n   194\t  #_{:clj-kondo/ignore [:unused-binding]}\n   195\t  [dir path claimed]\n   196\t  #?(:cljd (let [raf (.openSync (dart-io/File. path)\n   197\t                                .mode dart-io/FileMode.append)]\n   198\t             (try\n   199\t               (.lockSync raf)\n   200\t               (fn []\n   201\t                 (try (.unlockSync raf) (catch Object _ nil))\n   202\t                 (try (.closeSync raf) (catch Object _ nil)))\n   203\t               (catch Object _\n   204\t                 (try (.closeSync raf) (catch Object _ nil))\n   205\t                 (refuse-locked dir))))\n   206\t     :clj (let [f (java.io.RandomAccessFile. ^String path \"rw\")]\n   207\t            (try\n   208\t              (let [fl (try (.tryLock (.getChannel f))\n   209\t                            (catch java.nio.channels.OverlappingFileLockException _\n   210\t                              nil))]\n   211\t                (if (nil? fl)\n   212\t                  (do (.close f)\n   213\t                      (refuse-locked dir))\n   214\t                  (fn []\n   215\t                    (try (.release ^java.nio.channels.FileLock fl)\n   216\t                         (catch Exception _ nil))\n   217\t                    (try (.close f)\n   218\t                         (catch Exception _ nil)))))\n   219\t              (catch Throwable t\n   220\t                (try (.close f) (catch Exception _ nil))\n   221\t                (throw t))))\n   222\t     :cljs (node-lock! dir claimed)))\n   223\t\n   224\t\n   225\t(defn lock!\n   226\t  \"Acquire the exclusive lock of the durable store directory, or refuse\n   227\t   naming the directory — whether the other owner is another process or\n   228\t   this one. The answer is a plain release; closing whatever the host\n   229\t   needs closed is all releasing takes.\n   230\t\n   231\t   `claimed`, `(fn [])`, runs on Node once this process's claim entry\n   232\t   exists and before it reads the others — the window a concurrent\n   233\t   contender can race — so the tests can interleave one there.\"\n   234\t  ([dir] (lock! dir {}))\n   235\t  ([dir {:keys [claimed]}]\n   236\t   (let [key (canonical-dir dir)]\n   237\t     (when-not (claim! key)\n   238\t       (refuse-locked dir))\n   239\t     (let [release! (try (host-lock! dir (str dir \"/\" lock-name) claimed)\n   240\t                         (catch #?(:cljd Object\n   241\t                                   :clj Throwable\n   242\t                                   :cljs :default)\n   243\t                                e\n   244\t                           (swap! held disj key)\n   245\t                           (throw e)))\n   246\t           released? (volatile! false)]\n   247\t       {:release! (fn []\n   248\t                    (when-not @released?\n   249\t                      (vreset! released? true)\n   250\t                      (release!)\n   251\t                      (swap! held disj key)))}))))\n   252\t\n   253\t\n   254\t(defn unlock!\n   255\t  \"Release a lock `lock!` answered. Idempotent: a released lock releases\n   255\t  \"Release a lock `lock!` answered. Idempotent: a released lock releases\n   256\t   again as a no-op, never a later owner's lock of the same directory.\"\n   257\t  [lock]\n   258\t  (when-let [release! (:release! lock)]\n   259\t    (release!)))\n   260\t\n   261\t\n   262\t(defn directory-sync-supported?\n   263\t  \"True when this host can open a directory and fsync it, so a HEAD\n   264\t   replacement's rename can be made durable, not merely visible: Node\n   265\t   and the JVM on POSIX systems can; Windows cannot open a directory for\n   266\t   sync, and Dart's core has no directory sync at all.\"\n   267\t  []\n   268\t  #?(:cljd false\n   269\t     :clj (not (str/starts-with? (str (System/getProperty \"os.name\"))\n   270\t                                 \"Windows\"))\n   271\t     :cljs (not= \"win32\" (.-platform js/process))))\n   272\t\n   273\t\n   274\t(defn- sync-failure\n   275\t  [dir e]\n   276\t  (ex-info (str \"cannot sync the directory \" dir \" after the rename: \" e)\n   277\t           {:dir dir}\n   278\t           e))\n   279\t\n   280\t\n   281\t#?(:cljs\n   282\t   (defn- sync-directory!\n   283\t     \"Sync the directory entry itself where the host supports it — the\n   284\t      rename is durable, not merely visible.  There, a failure throws: a\n   285\t      replacement whose directory entry is not known durable is not\n   286\t      reported done.\"\n   287\t     [fs dir]\n   288\t     (when (directory-sync-supported?)\n   289\t       (try (let [fd (.openSync ^js fs dir \"r\")]\n   290\t              (try (.fsyncSync ^js fs fd)\n   291\t                   (finally\n   292\t                     (.closeSync ^js fs fd))))\n   293\t            (catch :default e\n   294\t              (throw (sync-failure dir e)))))))\n   295\t\n   296\t\n   297\t#?(:cljd nil\n   298\t   :clj\n   299\t   (defn- sync-directory!\n   300\t     \"Sync the directory entry itself where the host supports it — the\n   301\t      rename is durable, not merely visible.  There, a failure throws: a\n   302\t      replacement whose directory entry is not known durable is not\n   303\t      reported done.\"\n   304\t     [dir]\n   305\t     (when (directory-sync-supported?)\n   306\t       (try (with-open [ch (java.nio.channels.FileChannel/open\n   307\t                             (java.nio.file.Paths/get ^String dir\n   308\t                                                      (make-array String 0))\n   309\t                             ^\"[Ljava.nio.file.OpenOption;\"\n   310\t                             (into-array java.nio.file.OpenOption\n   311\t                                         [java.nio.file.StandardOpenOption/READ]))]\n   312\t              (.force ch true))\n   313\t            (catch Exception e\n   314\t              (throw (sync-failure dir e)))))))\n   315\t\n   316\t\n   317\t#?(:cljs\n   318\t   (defn- write-fully!\n   319\t     \"Write every byte of `buf` to `fd`.  `writeSync` may store fewer\n   320\t      bytes than asked and says how many in its answer, so the rest is\n   321\t      written from there until none remain; a write that stores nothing\n   322\t      fails rather than looping.  (The JVM's `OutputStream.write(byte[])`\n   323\t      and Dart's `writeAsStringSync` write the whole buffer or throw.)\"\n   324\t     [fs fd buf]\n   325\t     (loop [offset 0]\n   326\t       (when (< offset (.-length buf))\n   327\t         (let [written (.writeSync ^js fs fd buf offset\n   328\t                                   (- (.-length buf) offset))]\n   329\t           (when-not (pos? written)\n   330\t             (throw (ex-info \"the write stored no bytes\"\n   331\t                             {:offset offset :length (.-length buf)})))\n   332\t           (recur (+ offset written)))))))\n   333\t\n   334\t\n   335\t(defn atomic-replace!\n   336\t  \"Replace `<dir>/<name>` with `text` atomically: write the whole record\n   337\t   to a temp file beside it, sync the temp, rename it over the target,\n   338\t   and sync the directory where the host supports it — a failed\n   339\t   directory sync fails the replacement. A reader observes either the\n   340\t   whole previous record or the whole new one, never a partial write.\n   341\t\n   342\t   `before-rename`, `(fn [temp-path])`, runs in the one window a crash\n   343\t   can interrupt — after the temp is synced, before the rename — so a\n   344\t   test can interrupt the replacement there; a throw leaves the target\n   345\t   exactly as it was.\"\n   346\t  ([dir name text] (atomic-replace! dir name text {}))\n   347\t  ([dir name text {:keys [before-rename]}]\n   348\t   (let [target (str dir \"/\" name)\n   349\t         temp (str dir \"/\" name \".tmp-\" (random-uuid))]\n   350\t     #?(:cljd (try (.writeAsStringSync (dart-io/File. temp) text .flush true)\n   351\t                   (when before-rename (before-rename temp))\n   352\t                   (.renameSync (dart-io/File. temp) target)\n   353\t                   (catch Object e\n   354\t                     (throw (ex-info (str \"cannot replace \" target \": \" e)\n   355\t                                     {:dir dir :target target}\n   356\t                                     e))))\n   357\t        :clj (try (with-open [out (java.io.FileOutputStream. ^String temp)]\n   358\t                    (.write out (.getBytes ^String text \"UTF-8\"))\n   359\t                    (.flush out)\n   360\t                    (.sync (.getFD out)))\n   361\t                  (when before-rename (before-rename temp))\n   362\t                  (java.nio.file.Files/move\n   363\t                    (java.nio.file.Paths/get temp (make-array String 0))\n   364\t                    (java.nio.file.Paths/get target (make-array String 0))\n   365\t                    (into-array java.nio.file.StandardCopyOption\n","exit_code":0,"status":"completed"}}
