{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/stream.cljc'","aggregated_output":"     1\t(ns dao.stream\n     2\t  \"DaoStream v2: passive substrate for IO in datom.world.\n     3\t\n     4\t   Seven operations:\n     5\t     Five handle operations (protocols implemented per declared surface):\n     6\t       descriptor (universal reachability and identity projection)\n     7\t       cursor     (reader surface)\n     8\t       next       (reader surface)\n     9\t       append!    (writer surface)\n    10\t       close!     (closable surface)\n    11\t     Two transport entry functions (per-transport, host-composed):\n    12\t       create!    (creates a new logical stream from a creation specification)\n    13\t       attach!    (attaches to an existing stream via portable descriptor)\n    14\t\n    15\t   Result Convention:\n    16\t     Every operation returns an open outcome map keyed by :dao.stream/outcome.\n    17\t     All qualified keywords live under :dao.stream/…\n    18\t     Each operation has an exhaustive, closed outcome set.\"\n    19\t  (:refer-clojure :exclude [next]))\n    20\t\n    21\t\n    22\t;; =============================================================================\n    23\t;; The Seven Operations and Standard Keywords\n    24\t;; =============================================================================\n    25\t\n    26\t(def operations\n    27\t  \"The seven DaoStream v2 operations.\"\n    28\t  #{:create! :attach! :descriptor :cursor :next :append! :close!})\n    29\t\n    30\t\n    31\t(def surfaces\n    32\t  \"The public operational surfaces a handle may declare.\"\n    33\t  #{:reader :writer :closable})\n    34\t\n    35\t\n    36\t;; Anchors\n    37\t(def anchor-oldest\n    38\t  \"Earliest retained position on the stream.\"\n    39\t  :dao.stream/oldest)\n    40\t\n    41\t\n    42\t(def anchor-newest\n    43\t  \"Positioned after the newest appended value (observes next arrival).\"\n    44\t  :dao.stream/newest)\n    45\t\n    46\t\n    47\t(def standard-anchors\n    48\t  \"Contract-defined anchor keywords.\"\n    49\t  #{anchor-oldest anchor-newest})\n    50\t\n    51\t\n    52\t;; Closed outcome sets per operation (contract exhaustive tables)\n    53\t(def outcomes-create\n    54\t  #{:dao.stream/ok\n    55\t    :dao.stream/invalid-spec\n    56\t    :dao.stream/not-found\n    57\t    :dao.stream/transport-error})\n    58\t\n    59\t\n    60\t(def outcomes-attach\n    61\t  #{:dao.stream/ok\n    62\t    :dao.stream/invalid-descriptor\n    63\t    :dao.stream/not-found\n    64\t    :dao.stream/transport-error})\n    65\t\n    66\t\n    67\t(def outcomes-descriptor\n    68\t  #{:dao.stream/ok})\n    69\t\n    70\t\n    71\t(def outcomes-cursor\n    72\t  #{:dao.stream/ok\n    73\t    :dao.stream/invalid-anchor\n    74\t    :dao.stream/closed\n    75\t    :dao.stream/transport-error})\n    76\t\n    77\t\n    78\t(def outcomes-next\n    79\t  #{:dao.stream/ok\n    80\t    :dao.stream/blocked\n    81\t    :dao.stream/end\n    82\t    :dao.stream/gap\n    83\t    :dao.stream/cursor-mismatch\n    84\t    :dao.stream/invalid-cursor\n    85\t    :dao.stream/transport-error})\n    86\t\n    87\t\n    88\t(def outcomes-append\n    89\t  #{:dao.stream/ok\n    90\t    :dao.stream/full\n    91\t    :dao.stream/invalid-value\n    92\t    :dao.stream/closed\n    93\t    :dao.stream/transport-error})\n    94\t\n    95\t\n    96\t(def outcomes-close\n    97\t  #{:dao.stream/ok})\n    98\t\n    99\t\n   100\t(def operation-outcomes\n   101\t  \"Map of operation keyword to its closed outcome set.\"\n   102\t  {:create! outcomes-create\n   103\t   :attach! outcomes-attach\n   104\t   :descriptor outcomes-descriptor\n   105\t   :cursor outcomes-cursor\n   106\t   :next outcomes-next\n   107\t   :append! outcomes-append\n   108\t   :close! outcomes-close})\n   109\t\n   110\t\n   111\t(def outcome-required-keys\n   112\t  \"Map from [operation outcome] to required keys in the result map.\"\n   113\t  {[:create! :dao.stream/ok] #{:dao.stream/handle}\n   114\t   [:attach! :dao.stream/ok] #{:dao.stream/handle}\n   115\t   [:descriptor :dao.stream/ok] #{:dao.stream/descriptor :dao.stream/identity}\n   116\t   [:cursor :dao.stream/ok] #{:dao.stream/cursor}\n   117\t   [:next :dao.stream/ok] #{:dao.stream/value :dao.stream/cursor}\n   118\t   [:next :dao.stream/gap] #{:dao.stream/cursor}})\n   119\t\n   120\t\n   121\t;; =============================================================================\n   122\t;; Canonical Operation Resolution Helper\n   123\t;; =============================================================================\n   124\t\n   125\t(defn canonical-op\n   126\t  \"Normalizes op to canonical keyword (:create!, :attach!, :descriptor,\n   127\t   :cursor, :next, :append!, :close!). Supports aliases without '!'.\"\n   128\t  [op]\n   129\t  (case op\n   130\t    (:create :create!) :create!\n   131\t    (:attach :attach!) :attach!\n   132\t    (:descriptor) :descriptor\n   133\t    (:cursor) :cursor\n   134\t    (:next) :next\n   135\t    (:append :append!) :append!\n   136\t    (:close :close!) :close!\n   137\t    nil))\n   138\t\n   139\t\n   140\t;; =============================================================================\n   141\t;; Handle Protocols (Five Handle Operations)\n   142\t;; =============================================================================\n   143\t\n   144\t(defprotocol IDaoStreamDescriptor\n   145\t  \"Universal reachability and identity projection. Belongs to no surface:\n   146\t   implemented by every handle regardless of declared reader/writer/closable surfaces.\"\n   147\t\n   148\t  (descriptor\n   149\t    [handle]\n   150\t    \"Returns descriptor outcome map:\n   151\t     {:dao.stream/outcome :dao.stream/ok\n   152\t      :dao.stream/descriptor <portable-descriptor>\n   153\t      :dao.stream/identity <logical-stream-identity>}\"))\n   154\t\n   155\t\n   156\t(defprotocol IDaoStreamReader\n   157\t  \"Reader surface: positioned, non-destructive observation via immutable cursors.\"\n   158\t\n   159\t  (cursor\n   160\t    [handle anchor]\n   161\t    \"Mint an immutable cursor from anchor (:dao.stream/oldest, :dao.stream/newest,\n   162\t     or transport-specific anchor).\n   163\t     Returns outcome map with :dao.stream/cursor on :dao.stream/ok.\")\n   164\t\n   165\t  (next\n   166\t    [handle cursor]\n   167\t    \"Read the value at cursor position. Total and non-blocking.\n   168\t     Returns read outcome map.\"))\n   169\t\n   170\t\n   171\t(defprotocol IDaoStreamWriter\n   172\t  \"Writer surface: append values to the sequence this handle's writer surface is on.\"\n   173\t\n   174\t  (append!\n   175\t    [handle val]\n   176\t    \"Append val to the sequence. Total and non-blocking.\n   177\t     Returns write outcome map.\"))\n   178\t\n   179\t\n   180\t(defprotocol IDaoStreamClosable\n   181\t  \"Closable surface: close what this handle is on (logical stream or attachment).\n   182\t   Idempotent.\"\n   183\t\n   184\t  (close!\n   185\t    [handle]\n   186\t    \"Closes what this handle is on. Irrevocable.\n   187\t     Returns outcome map {:dao.stream/outcome :dao.stream/ok}.\"))\n   188\t\n   189\t\n   190\t;; =============================================================================\n   191\t;; Surface Inspection & Gating\n   192\t;; =============================================================================\n   193\t\n   194\t(defn reader?\n   195\t  \"True if handle implements the reader surface (IDaoStreamReader).\"\n   196\t  [handle]\n   197\t  (satisfies? IDaoStreamReader handle))\n   198\t\n   199\t\n   200\t(defn writer?\n   201\t  \"True if handle implements the writer surface (IDaoStreamWriter).\"\n   202\t  [handle]\n   203\t  (satisfies? IDaoStreamWriter handle))\n   204\t\n   205\t\n   206\t(defn closable?\n   207\t  \"True if handle implements the closable surface (IDaoStreamClosable).\"\n   208\t  [handle]\n   209\t  (satisfies? IDaoStreamClosable handle))\n   210\t\n   211\t\n   212\t(defn descriptor?\n   213\t  \"True if handle implements IDaoStreamDescriptor.\"\n   214\t  [handle]\n   215\t  (satisfies? IDaoStreamDescriptor handle))\n   216\t\n   217\t\n   218\t(defn declared-surfaces\n   219\t  \"Returns set of public surfaces implemented by handle:\n   220\t   subset of #{:reader :writer :closable}.\"\n   221\t  [handle]\n   222\t  (cond-> #{}\n   223\t    (reader? handle) (conj :reader)\n   224\t    (writer? handle) (conj :writer)\n   225\t    (closable? handle) (conj :closable)))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; Result Convention & Envelope Validation\n   230\t;; =============================================================================\n   231\t\n   232\t(defn qualified-keyword?*\n   233\t  \"True if x is a qualified keyword. Portable across CLJ, CLJS, CLJD.\"\n   234\t  [x]\n   235\t  (boolean (and (keyword? x) (namespace x))))\n   236\t\n   237\t\n   238\t(defn outcome-map?\n   239\t  \"True if x is an open outcome map with a qualified keyword under :dao.stream/outcome.\"\n   240\t  [x]\n   241\t  (and (map? x)\n   242\t       (qualified-keyword?* (:dao.stream/outcome x))))\n   243\t\n   244\t\n   245\t(defn validate-outcome\n   246\t  \"Validates an operation outcome against contract requirements.\n   247\t   Returns nil if valid, or a failure map describing the defect if invalid.\"\n   248\t  [op result]\n   249\t  (if-let [canon-op (canonical-op op)]\n   250\t    (cond\n   251\t      (not (outcome-map? result))\n   252\t      {:valid? false :error :invalid-outcome-map :operation canon-op :result result}\n   253\t\n   254\t      :else\n   255\t      (let [outcome (:dao.stream/outcome result)\n   256\t            allowed (get operation-outcomes canon-op)]\n   257\t        (cond\n   258\t          (not (contains? allowed outcome))\n   259\t          {:valid? false\n   260\t           :error :unauthorized-outcome\n   261\t           :operation canon-op\n   262\t           :outcome outcome\n   263\t           :allowed allowed}\n   264\t\n   265\t          :else\n   266\t          (let [req-keys (get outcome-required-keys [canon-op outcome] #{})\n   267\t                missing (into #{} (remove #(contains? result %) req-keys))]\n   268\t            (if (seq missing)\n   269\t              {:valid? false\n   270\t               :error :missing-required-keys\n   271\t               :operation canon-op\n   272\t               :outcome outcome\n   273\t               :missing missing}\n   274\t              nil)))))\n   275\t    {:valid? false :error :unknown-operation :operation op}))\n   276\t\n   277\t\n   278\t(defn valid-outcome?\n   279\t  \"True if result is a valid outcome map for op according to the contract.\"\n   280\t  [op result]\n   281\t  (nil? (validate-outcome op result)))\n   282\t\n   283\t\n   284\t(defn valid-envelope?\n   285\t  \"Generic envelope validation: envelope must be a map with a qualified keyword\n   286\t   under :dao.stream/type. Everything else is transport-owned.\"\n   287\t  [envelope]\n   288\t  (and (map? envelope)\n   289\t       (qualified-keyword?* (:dao.stream/type envelope))))\n   290\t\n   291\t\n   292\t(defn valid-creation-spec?\n   293\t  \"True if spec is a generically valid creation specification envelope:\n   294\t   must be a map with a qualified keyword under :dao.stream/type.\"\n   295\t  [spec]\n   296\t  (valid-envelope? spec))\n   297\t\n   298\t\n   299\t(defn valid-descriptor?\n   300\t  \"True if descriptor is a generically valid portable descriptor envelope:\n   301\t   must be a valid envelope (:dao.stream/type present and qualified)\n   302\t   and carry :dao.stream/identity.\"\n   303\t  [descriptor]\n   304\t  (and (valid-envelope? descriptor)\n   305\t       (contains? descriptor :dao.stream/identity)))\n   306\t\n   307\t\n   308\t(defn descriptor-identity-consistent?\n   309\t  \"True if a descriptor operation result is {:dao.stream/outcome :dao.stream/ok ...}\n   310\t   where both :dao.stream/descriptor and :dao.stream/identity are present,\n   311\t   descriptor is a valid descriptor envelope, and the sibling :dao.stream/identity\n   312\t   projection structurally equals the identity inside the descriptor envelope.\"\n   313\t  [result]\n   314\t  (and (map? result)\n   315\t       (= :dao.stream/ok (:dao.stream/outcome result))\n   316\t       (contains? result :dao.stream/descriptor)\n   317\t       (contains? result :dao.stream/identity)\n   318\t       (let [sibling-id (:dao.stream/identity result)\n   319\t             desc (:dao.stream/descriptor result)]\n   320\t         (and (some? sibling-id)\n   321\t              (valid-descriptor? desc)\n   322\t              (= sibling-id (:dao.stream/identity desc))))))\n   323\t\n   324\t\n   325\t;; =============================================================================\n   326\t;; Open Result Map Constructors\n   327\t;; =============================================================================\n   328\t\n   329\t(defn ok-result\n   330\t  \"Convenience constructor for an open :dao.stream/ok outcome map.\"\n   331\t  ([]\n   332\t   {:dao.stream/outcome :dao.stream/ok})\n   333\t  ([extra-map]\n   334\t   (assoc extra-map :dao.stream/outcome :dao.stream/ok)))\n   335\t\n   336\t\n   337\t(defn outcome-result\n   338\t  \"Convenience constructor for an open outcome map.\"\n   339\t  ([outcome]\n   340\t   {:dao.stream/outcome outcome})\n   341\t  ([outcome extra-map]\n   342\t   (assoc extra-map :dao.stream/outcome outcome)))\n   343\t\n   344\t\n   345\t;; =============================================================================\n   346\t;; Transport Entry Functions & Host Dispatch\n   347\t;; =============================================================================\n   348\t;;\n   349\t;; Two transport entry functions: create! and attach!\n   350\t;; These take no handle because none exists yet. These are per-transport functions,\n   351\t;; host-composed, taking whatever composition state the transport needs.\n   352\t;;\n   353\t;; Putting create! or attach! on a protocol is how the retired registry grows back;\n   354\t;; DaoStream v2 ships no dispatch machinery (no multimethod, no registry,\n   355\t;; no load-time side effect).\n   356\t;;\n   357\t;; Dynamic dispatch on :dao.stream/type is performed by the host using an ordinary\n   358\t;; host-owned lookup table:\n   359\t;;\n   360\t;;   {:dao.stream/ringbuffer {:dao.stream/create ringbuffer/create!\n   361\t;;                            :dao.stream/attach ringbuffer/attach!}\n   362\t;;    :dao.stream/ws         {:dao.stream/attach ws/attach!}}\n   363\t;;\n   364\t;; The helper functions below provide transparent, purely functional host dispatch.\n   365\t\n   366\t(defn host-dispatch-create!\n   367\t  \"Host dispatch helper: looks up :dao.stream/create in dispatch-table\n   368\t   for (:dao.stream/type creation-spec).\n   369\t   Returns :dao.stream/invalid-spec if spec is not a valid envelope.\n   370\t   Returns :dao.stream/not-found if transport or :dao.stream/create is absent.\n   371\t   Otherwise invokes the transport's create function.\"\n   372\t  [dispatch-table creation-spec]\n   373\t  (if-not (valid-creation-spec? creation-spec)\n   374\t    {:dao.stream/outcome :dao.stream/invalid-spec}\n   375\t    (if-let [create-fn (get-in dispatch-table [(:dao.stream/type creation-spec) :dao.stream/create])]\n   376\t      (create-fn creation-spec)\n   377\t      {:dao.stream/outcome :dao.stream/not-found})))\n   378\t\n   379\t\n   380\t(defn host-dispatch-attach!\n   381\t  \"Host dispatch helper: looks up :dao.stream/attach in dispatch-table\n   382\t   for (:dao.stream/type descriptor).\n   383\t   Returns :dao.stream/invalid-descriptor if descriptor is not a valid descriptor envelope.\n   384\t   Returns :dao.stream/not-found if transport or :dao.stream/attach is absent.\n   385\t   Otherwise invokes the transport's attach function.\"\n   386\t  [dispatch-table descriptor]\n   387\t  (if-not (valid-descriptor? descriptor)\n   388\t    {:dao.stream/outcome :dao.stream/invalid-descriptor}\n   389\t    (if-let [attach-fn (get-in dispatch-table [(:dao.stream/type descriptor) :dao.stream/attach])]\n   390\t      (attach-fn descriptor)\n   391\t      {:dao.stream/outcome :dao.stream/not-found})))\n","exit_code":0,"status":"completed"}}
