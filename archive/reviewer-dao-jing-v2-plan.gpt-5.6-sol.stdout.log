{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' src/cljc/dao/stream/rpc.cljc | nl -ba -v1\"","aggregated_output":"     1\t(ns dao.stream.rpc\n     2\t  \"Transport-neutral, polling RPC state machines for DaoStream v2.\n     3\t\n     4\t   This layer deliberately owns no socket, scheduler, atom, promise, callback,\n     5\t   retry policy, or transport registry.  A composition supplies two explicit\n     6\t   handles (a request writer and a response reader), owns the returned state,\n     7\t   and chooses when to step `request!`, `poll!`, and `serve-once!`.\"\n     8\t  (:require [dao.stream :as stream]\n     9\t            [dao.stream.apply :as apply]))\n    10\t\n    11\t\n    12\t;; =============================================================================\n    13\t;; Public data vocabulary\n    14\t;; =============================================================================\n    15\t\n    16\t(def max-safe-id\n    17\t  \"Largest integer that remains exactly representable by every supported host.\"\n    18\t  9007199254740991)\n    19\t\n    20\t\n    21\t(def event-key :dao.stream.rpc/event)\n    22\t(def response-key :dao.stream.rpc/response)\n    23\t(def lifecycle-key :dao.stream.rpc/lifecycle)\n    24\t(def diagnostic-key :dao.stream.rpc/diagnostic)\n    25\t(def code-key :dao.stream.rpc/code)\n    26\t\n    27\t\n    28\t(def lifecycle-values\n    29\t  \"The lifecycle vocabulary belongs to dao.stream.apply.  Transports decode\n    30\t   their local events into these values before the RPC core sees them.\"\n    31\t  #{:dao.stream.apply/established\n    32\t    :dao.stream.apply/detached\n    33\t    :dao.stream.apply/ended\n    34\t    :dao.stream.apply/not-found\n    35\t    :dao.stream.apply/transport-error\n    36\t    :dao.stream.apply/diagnostic})\n    37\t\n    38\t\n    39\t(defn response-event\n    40\t  [response]\n    41\t  {event-key :dao.stream.rpc/response response-key response})\n    42\t\n    43\t\n    44\t(defn lifecycle-event\n    45\t  [lifecycle]\n    46\t  {event-key :dao.stream.rpc/lifecycle lifecycle-key lifecycle})\n    47\t\n    48\t\n    49\t(defn diagnostic-event\n    50\t  ([code]\n    51\t   (diagnostic-event code nil))\n    52\t  ([code value]\n    53\t   {event-key :dao.stream.rpc/diagnostic\n    54\t    diagnostic-key {code-key code\n    55\t                    :dao.stream.rpc/value value}}))\n    56\t\n    57\t\n    58\t(defn ignore-event\n    59\t  []\n    60\t  {event-key :dao.stream.rpc/ignore})\n    61\t\n    62\t\n    63\t(defn safe-id?\n    64\t  \"True for an integer which round-trips without precision loss across CLJ,\n    65\t   CLJS, and CLJD.  IDs are routing tokens, not application values.\"\n    66\t  [id]\n    67\t  (and (integer? id) (<= 0 id max-safe-id)))\n    68\t\n    69\t\n    70\t;; =============================================================================\n    71\t;; Explicit client state\n    72\t;; =============================================================================\n    73\t\n    74\t(defn client-state\n    75\t  \"Create caller-owned RPC client state.\n    76\t\n    77\t   `writer` is the request path. `reader` and `response-cursor` are the\n    78\t   independent response path.  `:decode`, when present, transforms one raw\n    79\t   response-medium value into an RPC event made by this namespace; nil means a\n    80\t   bare apply response stream.  No cursor is fabricated here.\"\n    81\t  ([writer reader response-cursor]\n    82\t   (client-state writer reader response-cursor {}))\n    83\t  ([writer reader response-cursor {:keys [me decode]}]\n    84\t   {:writer writer\n    85\t    :reader reader\n    86\t    :cursor response-cursor\n    87\t    :me me\n    88\t    :decode decode\n    89\t    :next-id 0\n    90\t    :outstanding {}\n    91\t    :unsent nil\n    92\t    :completed []\n    93\t    :diagnostics []\n    94\t    :terminal nil}))\n    95\t\n    96\t\n    97\t(def init-client client-state)\n    98\t\n    99\t\n   100\t(defn server-state\n   101\t  \"The server state is owned by dao.stream.apply, which owns the envelope.\"\n   102\t  [request-cursor]\n   103\t  (apply/server-state request-cursor))\n   104\t\n   105\t\n   106\t(defn serve-once!\n   107\t  \"Advance one server request/response step.  This is an aliasing boundary, not\n   108\t   a second server implementation; apply remains the sole envelope owner.\"\n   109\t  [handlers request-handle response-handle state]\n   110\t  (apply/serve-once! handlers request-handle response-handle state))\n   111\t\n   112\t\n   113\t(defn- rpc-result\n   114\t  [outcome state & {:as extra}]\n   115\t  (merge {:dao.stream.rpc/outcome outcome\n   116\t          :dao.stream.rpc/state state}\n   117\t         extra))\n   118\t\n   119\t\n   120\t(defn- valid-operation-result\n   121\t  [op result]\n   122\t  (if (stream/valid-outcome? op result)\n   123\t    result\n   124\t    {:dao.stream/outcome :dao.stream/transport-error\n   125\t     :dao.stream/error :dao.stream/invalid-operation-result}))\n   126\t\n   127\t\n   128\t(defn- completion\n   129\t  [request & {:keys [response reason]}]\n   130\t  (cond-> {:dao.stream.rpc/id (:id request)\n   131\t           :dao.stream.rpc/op (:op request)\n   132\t           :dao.stream.rpc/args (:args request)}\n   133\t    response (assoc :dao.stream.rpc/response response)\n   134\t    reason (assoc :dao.stream.rpc/reason reason)))\n   135\t\n   136\t\n   137\t(defn- append-completion\n   138\t  [state request & {:as fields}]\n   139\t  (update state :completed conj (apply completion request (mapcat identity fields))))\n   140\t\n   141\t\n   142\t(defn- append-diagnostic\n   143\t  [state code value]\n   144\t  (update state :diagnostics conj {code-key code\n   145\t                                   :dao.stream.rpc/value value}))\n   146\t\n   147\t\n   148\t(defn- ids-in-use?\n   149\t  [state id]\n   150\t  (or (= id (get-in state