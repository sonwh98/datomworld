{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/jing/file.cljc'","aggregated_output":"     1\t(ns dao.jing.file\n     2\t  \"Content-addressed segment store backed by an append-only log stream.\n     3\t\n     4\t   Each log record is `[address payload]`, where address is a content address\n     5\t   keyword returned by `(jing/segment-key payload)` whose segment hash must\n     6\t   match the payload's content hash. Writes are serialized through a write\n     7\t   lock, acknowledged only after the log is flushed, and replayed on open to\n     8\t   rebuild the in-memory content map.\n     9\t\n    10\t   Returns a plain map handle `{:path :log :state :write-lock\n    11\t   :put-content-fn :get-content-fn :close-fn}`.\"\n    12\t  (:require #?@(:cljd [[\"dart:convert\" :as convert] [\"dart:io\" :as dart-io]\n    13\t                       [\"dart:typed_data\" :as typed]])\n    14\t            [clojure.edn :as edn]\n    15\t            [dao.jing :as jing]\n    16\t            [dao.stream :as ds]\n    17\t            [dao.stream.log]))\n    18\t\n    19\t\n    20\t;; =============================================================================\n    21\t;; Serialization / Byte Conversion\n    22\t;; =============================================================================\n    23\t\n    24\t(defn ->bytes\n    25\t  \"Convert a string or serializable payload into UTF-8 bytes.\"\n    26\t  [payload]\n    27\t  #?(:clj (.getBytes ^String payload \"UTF-8\")\n    28\t     :cljs (js/Buffer.from payload \"utf8\")\n    29\t     :cljd (typed/Uint8List.fromList (convert/utf8.encode payload))))\n    30\t\n    31\t\n    32\t(defn bytes->str\n    33\t  \"Convert UTF-8 bytes back to a string.\"\n    34\t  [b]\n    35\t  #?(:clj (String. ^bytes b \"UTF-8\")\n    36\t     :cljs (.toString ^js b \"utf8\")\n    37\t     :cljd (convert/utf8.decode b)))\n    38\t\n    39\t\n    40\t(defn encode-record\n    41\t  \"Encode an [address payload] tuple into a UTF-8 byte array.\"\n    42\t  [address payload]\n    43\t  (->bytes (pr-str [address payload])))\n    44\t\n    45\t\n    46\t(defn decode-record\n    47\t  \"Decode a byte array or UTF-8 payload back into its EDN value.\n    48\t   Returns the parsed value as-is; throws on malformed EDN.\"\n    49\t  [b]\n    50\t  (let [s (if (string? b) b (bytes->str b))] (edn/read-string s)))\n    51\t\n    52\t\n    53\t;; =============================================================================\n    54\t;; Record Validation\n    55\t;; =============================================================================\n    56\t\n    57\t(defn- validate-address-payload!\n    58\t  [address payload]\n    59\t  (if (and (jing/segment-address? address)\n    60\t           (= (jing/segment-hash address) (jing/content-hash payload)))\n    61\t    [address payload]\n    62\t    (throw (ex-info \"Segment address does not match payload\"\n    63\t                    {:address address, :payload payload}))))\n    64\t\n    65\t\n    66\t(defn- validate-record!\n    67\t  [record]\n    68\t  (if (and (vector? record) (= 2 (count record)))\n    69\t    (validate-address-payload! (first record) (second record))\n    70\t    (throw (ex-info \"Record is not a 2-element [address payload] vector\"\n    71\t                    {:record record}))))\n    72\t\n    73\t\n    74\t;; =============================================================================\n    75\t;; Replay\n    76\t;; =============================================================================\n    77\t\n    78\t(defn- replay-log\n    79\t  \"Replay an append-only log into its content map.\"\n    80\t  [log]\n    81\t  (loop [cursor {:position 0}\n    82\t         content {}]\n    83\t    (let [res (ds/next log cursor)]\n    84\t      (cond\n    85\t        (and (map? res) (contains? res :ok) (contains? res :cursor))\n    86\t        (let [[address payload] (validate-record! (decode-record (:ok res)))]\n    87\t          (if (contains? content address)\n    88\t            (if (= (clojure.core/get content address) payload)\n    89\t              (recur (:cursor res) content)\n    90\t              (throw (ex-info\n    91\t                       \"Collision: address already holds a different payload\"\n    92\t                       {:address address})))\n    93\t            (recur (:cursor res) (assoc content address payload))))\n    94\t        (and (map? res) (contains? res :ok))\n    95\t        (throw\n    96\t          (ex-info\n    97\t            \"Malformed stream response: :ok without :cursor while replaying log\"\n    98\t            {:response res, :position cursor}))\n    99\t        (= res :end) content\n   100\t        (= res :blocked) content\n   101\t        (= res :daostream/gap)\n   102\t        (throw (ex-info \"Stream gap encountered while replaying log\"\n   103\t                        {:position cursor}))\n   104\t        :else (throw (ex-info \"Unexpected stream response while replaying log\"\n   105\t                              {:response res, :position cursor}))))))\n   106\t\n   107\t\n   108\t;; =============================================================================\n   109\t;; Write Lock & Flush\n   110\t;; =============================================================================\n   111\t\n   112\t#_{:clj-kondo/ignore [:unused-binding]}\n   113\t\n   114\t\n   115\t(defn- with-lock\n   116\t  [lock f]\n   117\t  #?(:clj (locking lock (f))\n   118\t     :default (f)))\n   119\t\n   120\t\n   121\t(defn- flush-log!\n   122\t  [log]\n   123\t  #?(:clj (.sync (.getFD (:raf log)))\n   124\t     :cljs (.fsyncSync ^js (:fs log) (:fd log))\n   125\t     :cljd (.flushSync ^dart-io/RandomAccessFile (:raf log))))\n   126\t\n   127\t\n   128\t;; =============================================================================\n   129\t;; Handle Functions\n   130\t;; =============================================================================\n   131\t\n   132\t(defn- make-put\n   133\t  [state log lock]\n   134\t  (fn content-put!\n   135\t    [address payload]\n   136\t    (validate-address-payload! address payload)\n   137\t    (with-lock\n   138\t      lock\n   139\t      (fn []\n   140\t        (let [{:keys [closed? content]} @state]\n   141\t          (when closed?\n   142\t            (throw (ex-info \"Content file is closed\" {:address address})))\n   143\t          (if (contains? content address)\n   144\t            (if (= (clojure.core/get content address) payload)\n   145\t              :present\n   146\t              (throw (ex-info\n   147\t                       \"Collision: address already holds a different payload\"\n   148\t                       {:address address})))\n   149\t            (let [res (ds/append! log (encode-record address payload))]\n   150\t              (if (and (map? res) (= :ok (:result res)))\n   151\t                (do (flush-log! log)\n   152\t                    (swap! state assoc-in [:content address] payload)\n   153\t                    :inserted)\n   154\t                (throw (ex-info \"Failed to append record to log\"\n   155\t                                {:address address, :response res}))))))))))\n   156\t\n   157\t\n   158\t(defn- make-get\n   159\t  [state]\n   160\t  (fn content-get\n   161\t    [address not-found]\n   162\t    (let [{:keys [closed? content]} @state]\n   163\t      (when closed?\n   164\t        (throw (ex-info \"Content file is closed\" {:address address})))\n   165\t      (clojure.core/get content address not-found))))\n   166\t\n   167\t\n   168\t(defn- make-close\n   169\t  [state log lock]\n   170\t  (fn content-close!\n   171\t    []\n   172\t    (with-lock lock\n   173\t      (fn []\n   174\t        (when-not (:closed? @state)\n   175\t          (ds/close! log)\n   176\t          (swap! state assoc :closed? true))\n   177\t        nil))))\n   178\t\n   179\t\n   180\t;; =============================================================================\n   181\t;; Constructor\n   182\t;; =============================================================================\n   183\t\n   184\t(defn create-content-file\n   185\t  \"Open or create a content file at path, replaying the append-only log into\n   186\t   an in-memory content map. Returns a plain map handle with :path, :log,\n   187\t   :state, :write-lock and :put-content-fn, :get-content-fn, :close-fn\n   188\t   functions.\"\n   189\t  [path]\n   190\t  (let [log (ds/open! {:dao.stream/type :append-log, :path path})]\n   191\t    (try (let [recovered (replay-log log)\n   192\t               state (atom {:closed? false, :content recovered})\n   193\t               lock #?(:clj (Object.)\n   194\t                       :cljs (js-obj)\n   195\t                       :cljd (Object.))]\n   196\t           {:path path,\n   197\t            :log log,\n   198\t            :state state,\n   199\t            :write-lock lock,\n   200\t            :put-content-fn (make-put state log lock),\n   201\t            :get-content-fn (make-get state),\n   202\t            :close-fn (make-close state log lock)})\n   203\t         (catch #?(:clj Exception\n   204\t                   :cljs :default\n   205\t                   :cljd Object)\n   206\t                e\n   207\t           (try (ds/close! log)\n   208\t                (catch #?(:clj Exception\n   209\t                          :cljs :default\n   210\t                          :cljd Object)\n   211\t                       _\n   212\t                  nil))\n   213\t           (throw e)))))\n","exit_code":0,"status":"completed"}}
