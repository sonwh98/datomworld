clj (let [f (io/file path)]\n   200\t            (when-let [parent (.getParentFile f)] (.mkdirs parent))\n   201\t            (let [raf (java.io.RandomAccessFile. f \"rw\")\n   202\t                  end (.length raf)]\n   203\t              (loop [offset 0]\n   204\t                (cond (>= offset end) nil\n   205\t                      (< (- end offset) 4) (.setLength raf offset)\n   206\t                      :else (do (.seek raf offset)\n   207\t                                (let [len (.readInt raf)]\n   208\t                                  (if (or (neg? len) (> (+ offset 4 len) end))\n   209\t                                    (.setLength raf offset)\n   210\t                                    (recur (+ offset 4 len)))))))\n   211\t              (->CljLogStream raf (Object.) (atom {:closed false}))))\n   212\t     :cljs (if-not (exists? js/require)\n   213\t             (throw (ex-info \"dao.stream.log requires Node.js fs module.\"\n   214\t                             {:path path}))\n   215\t             (let [fs (js/require \"fs\")\n   216\t                   path-module (js/require \"path\")\n   217\t                   dir (.dirname path-module path)]\n   218\t               (when-not (.existsSync fs dir)\n   219\t                 (.mkdirSync fs dir #js {:recursive true}))\n   220\t               (let [fd (.openSync fs path \"a+\")\n   221\t                     end (.-size (.fstatSync fs fd))]\n   222\t                 (loop [offset 0]\n   223\t                   (cond (>= offset end) nil\n   224\t                         (< (- end offset) 4) (.ftruncateSync fs fd offset)\n   225\t                         :else (let [head (js/Buffer.alloc 4)]\n   226\t                                 (.readSync fs fd head 0 4 offset)\n   227\t                                 (let [len (.readInt32BE head 0)]\n   228\t                                   (if (or (neg? len) (> (+ offset 4 len) end))\n   229\t                                     (.ftruncateSync fs fd offset