57\t    (let [good-address (jing/segment-key \"ok\")\n   158\t          categories\n   159\t          [{:name \"malformed EDN\", :record (jing-file/->bytes \"[[[not edn\")}\n   160\t           {:name \"wrong shape\",\n   161\t            :record (jing-file/->bytes (pr-str [good-address \"ok\" :extra]))}\n   162\t           {:name \"invalid address\",\n   163\t            :record (jing-file/->bytes (pr-str [:root/not-content \"ok\"]))}\n   164\t           {:name \"hash mismatch\",\n   165\t            :record (jing-file/->bytes (pr-str [good-address \"different\"]))}]]\n   166\t      (doseq [{:keys [name record]} categories]\n   167\t        (let [path (temp-path \"corrupt\")\n   168\t              log (ds/open! {:dao.stream/type :append-log, :path path})]\n   169\t          (ds/append! log record)\n   170\t          (ds/close! log)\n   171\t          (try (is (thrown? #?(:clj Exception\n   172\t                               :cljs :default\n   173\t                               :cljd Object)\n   174\t                     (jing-file/create-content-file path))\n   175\t                   name)\n   176\t               (finally (cleanup-file path))))))))\n   177\t\n   178\t\n   179\t(deftest collision-test\n   180\t  (testing \"unequal payload for existing address throws and preserves existing\"\n   181\t    (let [path (temp-path \"collision\")\n   182\t          address (jing/segment-key \"original\")\n   183\t          handle (jing-file/create-content-file path)]\n   184\t      (try (is (= :inserted ((:put-content-fn handle) address \"original\")))\n   185\t           (is (= :present ((:put-content-fn handle) address \"original\")))\n   186\t           (swap! (:state handle) assoc-in [:content address] \"corrupted\")\n   187\t           (is (thrown? #?(:clj Exception\n   188\t                           :cljs :default\n   189\t                           :cljd Object)\n   190\t                 ((:put-content-fn handle) address \"original\")))\n   191\t           (is (=