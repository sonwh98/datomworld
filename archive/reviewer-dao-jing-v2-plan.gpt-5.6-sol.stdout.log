     :dao.stream/ok\n   202\t      (rpc-result :dao.stream.rpc/requested\n   203\t                  (accept-unsent state request)\n   204\t                  :dao.stream.rpc/id (:id request)\n   205\t                  :dao.stream.rpc/append append-result)\n   206\t\n   207\t      :dao.stream/full\n   208\t      (rpc-result :dao.stream.rpc/pending-request state\n   209\t                  :dao.stream.rpc/id (:id request)\n   210\t                  :dao.stream.rpc/append append-result)\n   211\t\n   212\t      (:dao.stream/closed :dao.stream/invalid-value :dao.stream/transport-error)\n   213\t      (let [state (-> state\n   214\t                      (assoc :unsent nil)\n   215\t                      (append-completion request :reason outcome))]\n   216\t        (rpc-result :dao.stream.rpc/request-undeliverable state\n   217\t                    :dao.stream.rpc/id (:id request)\n   218\t                    :dao.stream.rpc/reason outcome\n   219\t                    :dao.stream.rpc/append append-result))\n   220\t\n   221\t      ;; A malformed writer answer becomes transport-error in\n   222\t      ;; valid-operation-result, so this branch is defensive only.\n   223\t      (let [state (-> state\n   224\t                      (assoc :unsent nil)\n   225\t                      (append-completion request :reason :dao.stream/transport-error))]\n   226\t        (rpc-result :dao.stream.rpc/request-undeliverable state\n   227\t                    :dao.stream.rpc/id (:id request)\n   228\t                    :dao.stream.rpc/reason :dao.stream/transport-error\n   229\t                    :dao.stream.rpc/append append-result)))))\n   230\t\n   231\t\n   232\t(defn request!\n   233\t  \"Attempt one request append, returning an explicit next state.\n   234\t\n   235\t   If a previous append was full, this retries the exact already-allocated\n   236\t   envelope and ignores `op`/`args`; it never allocates a replacement id.  The\n   237\t   function makes one append attempt at most and never spins on `:full`.\"\n   238\t  [state op args]\n   239\t  (cond\n   240\t    (:terminal state)\n   241\t    (rpc-result :dao.stream.rpc/terminal state)\n   242\t\n   243\t    (:unsent state)\n   244\t    (attempt-unsent state)\n   245\t\n   246\t    (not (and (keyword? op) (vector? args)))\n   247\t    (let [state (append-diagnostic state :dao.stream.rpc/invalid-request\n   248\t                                   {:op op :args args})]\n   249\t      (rpc-result :dao.stream.rpc/invalid-request state\n   250\t                  :dao.stream.rpc/diagnostic (last (:diagnostics state))))\n   251\t\n   252\t    :else\n   253\t    (let [allocated (allocate-request state op args)]\n   254\t      (if (= :dao.stream.rpc/allocated (:dao.stream.rpc/outcome allocated))\n   255\t        (attempt-unsent (:dao.stream.rpc/state allocated))\n   256\t        allocated))))\n   257\t\n   258\t\n   259\t(defn unsent?\n   260\t  \"True while an allocated request is still owed one accepted append.  A caller\n","exit_code":0,"status":"completed"}}
