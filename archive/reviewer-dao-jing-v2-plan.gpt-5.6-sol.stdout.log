n (:state r1) [:members 0 :cursor])))\n   551\t      (is (thrown? #?(:clj Exception\n   552\t                      :cljs js/Error\n   553\t                      :cljd Object)\n   554\t            (jing/observe-step! failing (:state r1))))\n   555\t      (is (= {:position 1} (get-in (:state r1) [:members 0 :cursor]))\n   556\t          \"the caller's state must not advance past the failed payload\")\n   557\t      (let [r2 (jing/observe-step! good (:state r1))]\n   558\t        (is (= :ok (:signal r2)))\n   559\t        (is (= (jing/segment-key :poison) (:address r2)))\n   560\t        (is (= {:position 2} (get-in (:state r2) [:members 0 :cursor])))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/zsh -lc \"sed -n '201,400p' test/dao/jing_test.cljc | nl -ba -v201\"","aggregated_output":"   201\t    \"get returns the caller-supplied not-found for an absent content\n   202\t            address and only for that address\"\n   203\t    (let [h (mem-handle)\n   204\t          address (jing/segment-key {:never 1})]\n   205\t      (is (= ::missing (jing/get h address ::missing)))\n   206\t      (jing/materialize! h {:never 1})\n   207\t      (is (= {:never 1} (jing/get h address ::missing)))\n   208\t      (is (= ::missing (jing/get h (jing/segment-key {:other 2}) ::missing))\n   209\t          \"a present address leaves other addresses absent\"))))\n   210\t\n   211\t\n   212\t(deftest get-rejects-arbitrary-addresses\n   213\t  (testing\n   214\t    \"only :segment/sha256-... content addresses are valid reads;\n   215\t            arbitrary keys and mutable roots are outside DaoJing\"\n   216\t    (let [h (mem-handle)\n   217\t          payload {:x 1}\n   218\t          _ (jing/materialize! h payload)]\n   219\t      (is (= payload (jing/get h (jing/segment-key payload) ::missing)))\n   220\t      (doseq [bad [:root/pointer :plain :segment/not-a-hash :segment/sha256-xyz\n   221\t                   42 \"abc\" nil [1 2] {:k :v}]]\n   222\t        (is (thrown? #?(:clj Exception\n   223\t                        :cljs js/Error\n   224\t                        :cljd Object)\n   225\t              (jing/get h bad ::missing))\n   226\t            (str \"must reject \" (pr-str bad)))))))\n   227\t\n   228\t\n   229\t(deftest get-rejects-arbitrary-addresses-before-touching-the-backend\n   230\t  (testing \"validation happens before any backend call\"\n   231\t    (let [h {:put-content-fn (fn [_ _] :inserted),\n   232\t             :get-content-fn\n   233\t             (fn [_ _] (throw (ex-info \"backend must not be consulted\" {})))}]\n   234\t      (is (thrown? #?(:clj Exception\n   235\t                      :cljs js/Error\n   236\t                      :cljd Object)\n   237\t            (jing/get h :root/pointer ::missing))))))\n   238\t\n   239\t\n   240\t(deftest forced-collision-is-an-integrity-failure\n   241\t  (testing\n   242\t    \"a different value already seated at the address is never\n   243\t            overwritten and the mismatch is reported loudly\"\n   244\t    (let [address (jing/segment-key {:b 1})\n   245\t          h (mem-handle {address {:a 1}})]\n   246\t      (is (thrown? #?(:clj Exception\n   247\t                      :cljs js/Error\n   248\t                      :cljd Object)\n   249\t            (jing/materialize! h {:b 1})))\n   250\t      (is (= {:a 1} (jing/get h address ::missing))\n   251\t          \"the existing value is untouched\"))))\n   252\t\n   253\t\n   254\t(deftest present-without-readable-content-is-an-integrity-failure\n   255\t  (testing\n   256\t    \"a backend that reports :present but cannot read the value back\n   257\t            is inconsistent\"\n   258\t    (let [h {:put-content-fn (fn [_ _] :present),\n   259\t             :get-content-fn (fn [_ _] ::missing)}]\n   260\t      (is (thrown? #?(:clj Exception\n   261\t                      :cljs js/Error\n   262\t                      :cljd Object)\n   263\t            (jing/materialize! h {:x 1}))))))\n   264\t\n   265\t\n   266\t(deftest content-missing-keyword-is-a-legal-payload\n   267\t  (testing\n   268\t    \"the former sentinel keyword :dao.jing/content-missing is a legal\n   269\t            opaque payload: a backend that reports :present but then returns\n   270\t            not-found for the content address must throw, not fake success by\n   271\t            equating its not-found with the payload\"\n   272\t    (let [h {:put-content-fn (fn [_ _] :present),\n   273\t             :get-content-fn (fn [_ not-found] not-found)}]\n   274\t      (is (thrown? #?(:clj Exception\n   275\t                      :cljs js/Error\n   276\t                      :cljd Object)\n   277\t            (jing/materialize! h :dao.jing/content-missing)))))\n   278\t  (testing\n   279\t    \"a conforming backend stores the keyword as an ordinary payload,\n   280\t            idempotently\"\n   281\t    (let [h (mem-handle)]\n   282\t      (is (= (jing/segment-key :dao.jing/content-missing)\n   283\t             (jing/materialize! h :dao.jing/content-missing)))\n   284\t      (is (= (jing/segment-key :dao.jing/content-missing)\n   285\t             (jing/materialize! h :dao.jing/content-missing)))\n   286\t      (is (= :dao.jing/content-missing\n   287\t             (jing/get h\n   288\t                       (jing/segment-key :dao.jing/content-missing)\n   289\t                       ::missing))))))\n   290\t\n   291\t\n   292\t(deftest invalid-backend-result-is-rejected\n   293\t  (testing \"ambiguous truthiness is not a valid result vocabulary\"\n   294\t    (doseq [bad [true nil :ok \"inserted\" 1 {:status :ok}]]\n   295\t      (let [h {:put-content-fn (fn [_ _] bad), :get-content-fn (fn [_ _] nil)}]\n   296\t        (is (thrown? #?(:clj Exception\n   297\t                        :cljs js/Error\n   298\t                        :cljd Object)\n   299\t              (jing/materialize! h {:x 1}))\n   300\t            (str \"backend result \" (pr-str bad) \" must be rejected\"))))))\n   301\t\n   302\t\n   303\t(deftest close-delegates-and-is-optional\n   304\t  (testing\n   305\t    \"close! returns nil, delegates to :close-fn, and tolerates\n   306\t            repeated calls and handles without a close-fn\"\n   307\t    (let [closed (atom 0)\n   308\t          h (assoc (mem-handle) :close-fn (fn [] (swap! closed inc)))]\n   309\t      (is (nil? (jing/close! h)))\n   310\t      (is (nil? (jing/close! h)))\n   311\t      (is (= 2 @closed) \"close! delegates to :close-fn on every call\"))\n   312\t    (is (nil? (jing/close! (assoc (mem-handle) :close-fn nil)))\n   313\t        \"a handle without :close-fn has nothing to release\")\n   314\t    (is (nil? (jing/close! {:put-content-fn (fn [_ _] :inserted),\n   315\t                            :get-content-fn (fn [_ _] nil)})))))\n   316\t\n   317\t\n   318\t;; ---------------------------------------------------------------------------\n   319\t;; Observer: observer-state / observe-step!\n   320\t;; ---------------------------------------------------------------------------\n   321\t\n   322\t(deftest observer-state-is-plain-data\n   323\t  (testing\n   324\t    \"observer-state returns immutable data with one operational member\n   325\t            per pool stream, a fresh cursor, an explicit status, and the next\n   326\t            fair scheduling index\"\n   327\t    (let [a (open-stream)\n   328\t          b (open-stream)\n   329\t          st (jing/observer-state [a b])]\n   330\t      (is (= [a b] (mapv :stream (:members st))))\n   331\t      (is (every? #(= {:position 0} (:cursor %)) (:members st)))\n   332\t      (is (every? #(= :pending (:status %)) (:members st)))\n   333\t      (is (= 0 (:next st))))))\n   334\t\n   335\t\n   336\t(deftest observer-empty-pool-is-blocked\n   337\t  (let [h (mem-handle)\n   338\t        state (jing/observer-state [])]\n   339\t    (is (= {:state state, :signal :blocked} (jing/observe-step! h state)))))\n   340\t\n   341\t\n   342\t(deftest observer-all-blocked\n   343\t  (let [h (mem-handle)\n   344\t        a (open-stream)\n   345\t        b (open-stream)\n   346\t        state (jing/observer-state [a b])\n   347\t        r (jing/observe-step! h state)]\n   348\t    (is (= :blocked (:signal r)))\n   349\t    (is (every? #(= :blocked (:status %)) (:members (:state r))))\n   350\t    (is (every? #(= {:position 0} (:cursor %)) (:members (:state r))))))\n   351\t\n   352\t\n   353\t(deftest observer-automatic-hashing-and-retrieval\n   354\t  (testing\n   355\t    \"a payload arriving through a pool stream is content-addressed\n   356\t            without the caller minting any key\"\n   357\t    (let [h (mem-handle)\n   358\t          payload {:hello \"world\"}\n   359\t          s (open-stream payload)\n   360\t          r (jing/observe-step! h (jing/observer-state [s]))]\n   361\t      (is (= :ok (:signal r)))\n   362\t      (is (= (jing/segment-key payload) (:address r)))\n   363\t      (is (= payload (jing/get h (:address r) ::missing))))))\n   364\t\n   365\t\n   366\t(deftest observer-equal-payloads-from-two-streams-converge\n   367\t  (testing\n   368\t    \"identical content arriving through different pool streams lands\n   369\t            on exactly one KV entry, with no provenance stamp\"\n   370\t    (let [h (mem-handle)\n   371\t          store (:store h)\n   372\t          payload {:nested {:v [1 2 3]}}\n   373\t          address (jing/segment-key payload)\n   374\t          a (open-stream payload payload)\n   375\t          b (open-stream payload)\n   376\t          state (jing/observer-state [a b])\n   377\t          r1 (jing/observe-step! h state)\n   378\t          r2 (jing/observe-step! h (:state r1))\n   379\t          r3 (jing/observe-step! h (:state r2))]\n   380\t      (doseq [r [r1 r2 r3]]\n   381\t        (is (= :ok (:signal r)))\n   382\t        (is (= address (:address r))\n   383\t            \"both streams converge on the same content address\"))\n   384\t      (is\n   385\t        (= {address payload} @store)\n   386\t        \"exactly one KV entry exists, holding exactly the payload: no\n   387\t          duplicate entries, no source identity, no provenance stamp\"))))\n   388\t\n   389\t\n   390\t(deftest observer-blocked-before-ready-does-not-prevent-later-members\n   391\t  (let [h (mem-handle)\n   392\t        a (open-stream)\n   393\t        b (open-stream {:payload 1})\n   394\t        r (jing/observe-step! h (jing/observer-state [a b]))]\n   395\t    (is (= :ok (:signal r)))\n   396\t    (is (= {:payload 1} (jing/get h (:address r) ::missing)))\n   397\t    (is (= :blocked (get-in (:state r) [:members 0 :status]))\n   398\t        \"the blocked member is checked and marked, but does not block the scan\")\n   399\t    (is (= :ok (get-in (:state r) [:members 1 :status])))))\n   400\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/zsh -lc \"sed -n '228,391p' src/cljc/dao/stream.cljc | nl -ba -v228\"","aggregated_output":"   228\t;; =============================================================================\n   229\t;; Result Convention & Envelope Validation\n   230\t;; =============================================================================\n   231\t\n   232\t(defn qualified-keyword?*\n   233\t  \"True if x is a qualified keyword. Portable across CLJ, CLJS, CLJD.\"\n   234\t  [x]\n   235\t  (boolean (and (keyword? x) (namespace x))))\n   236\t\n   237\t\n   238\t(defn outcome-map?\n   239\t  \"True if x is an open outcome map with a qualified keyword under :dao.stream/outcome.\"\n   240\t  [x]\n   241\t  (and (map? x)\n   242\t       (qualified-keyword?* (:dao.stream/outcome x))))\n   243\t\n   244\t\n   245\t(defn validate-outcome\n   246\t  \"Validates an operation outcome against contract requirements.\n   247\t   Returns nil if valid, or a failure map describing the defect if invalid.\"\n   248\t  [op result]\n   249\t  (if-let [canon-op (canonical-op op)]\n   250\t    (cond\n   251\t      (not (outcome-map? result))\n   252\t      {:valid? false :error :invalid-outcome-map :operation canon-op :result result}\n   253\t\n   254\t      :else\n   255\t      (let [outcome (:dao.stream/outcome result)\n   256\t            allowed (get operation-outcomes canon-op)]\n   257\t        (cond\n   258\t          (not (contains? allowed outcome))\n   259\t          {:valid? false\n   260\t           :error :unauthorized-outcome\n   261\t           :operation canon-op\n   262\t           :outcome outcome\n   263\t           :allowed allowed}\n   264\t\n   265\t          :else\n   266\t          (let [req-keys (get outcome-required-keys [canon-op outcome] #{})\n   267\t                missing (into #{} (remove #(contains? result %) req-keys))]\n   268\t            (if (seq missing)\n   269\t              {:valid? false\n   270\t               :error :missing-required-keys\n   271\t               :operation canon-op\n   272\t               :outcome outcome\n   273\t               :missing missing}\n   274\t              nil)))))\n   275\t    {:valid? false :error :unknown-operation :operation op}))\n   276\t\n   277\t\n   278\t(defn valid-outcome?\n   279\t  \"True if result is a valid outcome map for op according to the contract.\"\n   280\t  [op result]\n   281\t  (nil? (validate-outcome op result)))\n   282\t\n   283\t\n   284\t(defn valid-envelope?\n   285\t  \"Generic envelope validation: envelope must be a map with a qualified keyword\n   286\t   under :dao.stream/type. Everything else is transport-owned.\"\n   287\t  [envelope]\n   288\t  (and (map? envelope)\n   289\t       (qualified-keyword?* (:dao.stream/type envelope))))\n   290\t\n   291\t\n   292\t(defn valid-creation-spec?\n   293\t  \"True if spec is a generically valid creation specification envelope:\n   294\t   must be a map with a qualified keyword under :dao.stream/type.\"\n   295\t  [spec]\n   296\t  (valid-envelope? spec))\n   297\t\n   298\t\n   299\t(defn valid-descriptor?\n   300\t  \"True if descriptor is a generically valid portable descriptor envelope:\n   301\t   must be a valid envelope (:dao.stream/type present and qualified)\n   302\t   and carry :dao.stream/identity.\"\n   303\t  [descriptor]\n   304\t  (and (valid-envelope? descriptor)\n   305\t       (contains? descriptor :dao.stream/identity)))\n   306\t\n   307\t\n   308\t(defn descriptor-identity-consistent?\n   309\t  \"True if a descriptor operation result is {:dao.stream/outcome :dao.stream/ok ...}\n   310\t   where both :dao.stream/descriptor and :dao.stream/identity are present,\n   311\t   descriptor is a valid descriptor envelope, and the sibling :dao.stream/identity\n   312\t   projection structurally equals the identity inside the descriptor envelope.\"\n   313\t  [result]\n   314\t  (and (map? result)\n   315\t       (= :dao.stream/ok (:dao.stream/outcome result))\n   316\t       (contains? result :dao.stream/descriptor)\n   317\t       (contains? result :dao.stream/identity)\n   318\t       (let [sibling-id (:dao.stream/identity result)\n   319\t             desc (:dao.stream/descriptor result)]\n   320\t         (and (some? sibling-id)\n   321\t              (valid-descriptor? desc)\n   322\t              (= sibling-id (:dao.stream/identity desc))))))\n   323\t\n   324\t\n   325\t;; =============================================================================\n   326\t;; Open Result Map Constructors\n   327\t;; =============================================================================\n   328\t\n   329\t(defn ok-result\n   330\t  \"Convenience constructor for an open :dao.stream/ok outcome map.\"\n   331\t  ([]\n   332\t   {:dao.stream/outcome :dao.stream/ok})\n   333\t  ([extra-map]\n   334\t   (assoc extra-map :dao.stream/outcome :dao.stream/ok)))\n   335\t\n   336\t\n   337\t(defn outcome-result\n   338\t  \"Convenience constructor for an open outcome map.\"\n   339\t  ([outcome]\n   340\t   {:dao.stream/outcome outcome})\n   341\t  ([outcome extra-map]\n   342\t   (assoc extra-map :dao.stream/outcome outcome)))\n   343\t\n   344\t\n   345\t;; =============================================================================\n   346\t;; Transport Entry Functions & Host Dispatch\n   347\t;; =============================================================================\n   348\t;;\n   349\t;; Two transport entry functions: create! and attach!\n   350\t;; These take no handle because none exists yet. These are per-transport functions,\n   351\t;; host-composed, taking whatever composition state the transport needs.\n   352\t;;\n   353\t;; Putting create! or attach! on a protocol is how the retired registry grows back;\n   354\t;; DaoStream v2 ships no dispatch machinery (no multimethod, no registry,\n   355\t;; no load-time side effect).\n   356\t;;\n   357\t;; Dynamic dispatch on :dao.stream/type is performed by the host using an ordinary\n   358\t;; host-owned lookup table:\n   359\t;;\n   360\t;;   {:dao.stream/ringbuffer {:dao.stream/create ringbuffer/create!\n   361\t;;                            :dao.stream/attach ringbuffer/attach!}\n   362\t;;    :dao.stream/ws         {:dao.stream/attach ws/attach!}}\n   363\t;;\n   364\t;; The helper functions below provide transparent, purely functional host dispatch.\n   365\t\n   366\t(defn host-dispatch-create!\n   367\t  \"Host dispatch helper: looks up :dao.stream/create in dispatch-table\n   368\t   for (:dao.stream/type creation-spec).\n   369\t   Returns :dao.stream/invalid-spec if spec is not a valid envelope.\n   370\t   Returns :dao.stream/not-found if transport or :dao.stream/create is absent.\n   371\t   Otherwise invokes the transport's create function.\"\n   372\t  [dispatch-table creation-spec]\n   373\t  (if-not (valid-creation-spec? creation-spec)\n   374\t    {:dao.stream/outcome :dao.stream/invalid-spec}\n   375\t    (if-let [create-fn (get-in dispatch-table [(:dao.stream/type creation-spec) :dao.stream/create])]\n   376\t      (create-fn creation-spec)\n   377\t      {:dao.stream/outcome :dao.stream/not-found})))\n   378\t\n   379\t\n   380\t(defn host-dispatch-attach!\n   381\t  \"Host dispatch helper: looks up :dao.stream/attach in dispatch-table\n   382\t   for (:dao.stream/type descriptor).\n   383\t   Returns :dao.stream/invalid-descriptor if descriptor is not a valid descriptor envelope.\n   384\t   Returns :dao.stream/not-found if transport or :dao.stream/attach is absent.\n   385\t   Otherwise invokes the transport's attach function.\"\n   386\t  [dispatch-table descriptor]\n   387\t  (if-not (valid-descriptor? descriptor)\n   388\t    {:dao.stream/outcome :dao.stream/invalid-descriptor}\n   389\t    (if-let [attach-fn (get-in dispatch-table [(:dao.stream/type descriptor) :dao.stream/attach])]\n   390\t      (attach-fn descriptor)\n   391\t      {:dao.stream/outcome :dao.stream/not-found})))\n","exit_code":0,"status":"completed"}}
