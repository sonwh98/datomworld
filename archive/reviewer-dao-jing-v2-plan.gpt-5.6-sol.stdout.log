oad (jing/get h2 address ::missing)))\n    82\t                  (finally (jing/close! h2))))\n    83\t           (finally (cleanup-file path))))))\n    84\t\n    85\t\n    86\t(deftest close-reopen-durability-test\n    87\t  (testing \"payloads survive close and reopen\"\n    88\t    (let [path (temp-path \"durability\")\n    89\t          a1 (jing/segment-key \"alpha\")\n    90\t          a2 (jing/segment-key {:n 2})\n    91\t          handle (jing-file/create-content-file path)]\n    92\t      (jing/materialize! handle \"alpha\")\n    93\t      (jing/materialize! handle {:n 2})\n    94\t      (jing/close! handle)\n    95\t      (let [h2 (jing-file/create-content-file path)]\n    96\t        (try (is (= \"alpha\" (jing/get h2 a1 ::missing)))\n    97\t             (is (= {:n 2} (jing/get h2 a2 ::missing)))\n    98\t             (finally (jing/close! h2) (cleanup-file path)))))))\n    99\t\n   100\t\n   101\t(deftest nil-and-absence-test\n   102\t  (testing \"nil payload is stored distinctly from an absent address\"\n   103\t    (let [path (temp-path \"nil\")\n   104\t          address (jing/segment-key nil)\n   105\t          handle (jing-file/create-content-file path)]\n   106\t      (try (is (= ::missing (jing/get handle address ::missing)))\n   107\t           (jing/materialize! handle nil)\n   108\t           (is (nil? (jing/get handle address ::missing)))\n   109\t           (is (contains? (:content @(:state handle)) address))\n   110\t           (finally (jing/close! handle) (cleanup-file path))))))\n   111\t\n   112\t\n   113\t(deftest observer-convergence-test\n   114\t  (testing\n   115\t    \"two ringbuffers carrying the same payload converge on one content address\"\n   116\t    (let [path (temp-path \"observe\")\n   117\t          payload {:observed true}\n   118\t          handle (jing-file/create-content-file path)\n   119\t          rb1 (ds/open! {:dao.stream/type :ringbuffer, :capacity 8})\n   120\t          rb2 (ds/open! {:dao.stream/type :ringbuff