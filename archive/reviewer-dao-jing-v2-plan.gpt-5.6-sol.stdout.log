{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/stream/apply.cljc'","aggregated_output":"     1\t(ns dao.stream.apply\n     2\t  \"The transport-neutral request/response envelope for DaoStream v2.\n     3\t\n     4\t   This namespace owns only application data and one explicit server step.  It\n     5\t   neither creates streams nor retains handles, cursors, handlers, or requests\n     6\t   outside values supplied by its caller.  A driver owns the returned state and\n     7\t   decides when to call `serve-once!` again.\"\n     8\t  (:require [dao.stream :as stream]))\n     9\t\n    10\t\n    11\t;; =============================================================================\n    12\t;; Envelope\n    13\t;; =============================================================================\n    14\t\n    15\t(def id-key :dao.stream.apply/id)\n    16\t(def op-key :dao.stream.apply/op)\n    17\t(def args-key :dao.stream.apply/args)\n    18\t(def ok-key :dao.stream.apply/ok)\n    19\t(def error-key :dao.stream.apply/error)\n    20\t(def code-key :dao.stream.apply/code)\n    21\t(def message-key :dao.stream.apply/message)\n    22\t\n    23\t\n    24\t(defn correlation-id?\n    25\t  \"True for a usable opaque correlation id.  Allocation policy (including the\n    26\t   cross-host safe-integer bound) belongs to the RPC client, not this envelope.\"\n    27\t  [id]\n    28\t  (some? id))\n    29\t\n    30\t\n    31\t(defn request\n    32\t  \"Construct a request envelope.  Use `request?` to validate data received from\n    33\t   a stream; constructors deliberately add no interpretation to arguments.\"\n    34\t  [id op args]\n    35\t  {id-key id op-key op args-key args})\n    36\t\n    37\t\n    38\t(defn request?\n    39\t  \"True when value is a valid request envelope.  Unknown keys are intentionally\n    40\t   ignored so the envelope remains open.\"\n    41\t  [value]\n    42\t  (and (map? value)\n    43\t       (correlation-id? (get value id-key))\n    44\t       (keyword? (get value op-key))\n    45\t       (vector? (get value args-key))))\n    46\t\n    47\t\n    48\t(defn request-id\n    49\t  [value]\n    50\t  (get value id-key))\n    51\t\n    52\t\n    53\t(defn request-op\n    54\t  [value]\n    55\t  (get value op-key))\n    56\t\n    57\t\n    58\t(defn request-args\n    59\t  [value]\n    60\t  (get value args-key))\n    61\t\n    62\t\n    63\t(defn error\n    64\t  \"Construct portable error data.  Codes are qualified keywords and messages\n    65\t   are ordinary strings, never host exception values.\"\n    66\t  [code message]\n    67\t  {code-key code message-key message})\n    68\t\n    69\t\n    70\t(defn error?\n    71\t  [value]\n    72\t  (and (map? value)\n    73\t       (stream/qualified-keyword?* (get value code-key))\n    74\t       (string? (get value message-key))))\n    75\t\n    76\t\n    77\t(defn success-response\n    78\t  \"Construct a successful response preserving the request id.\"\n    79\t  [id value]\n    80\t  {id-key id ok-key value})\n    81\t\n    82\t\n    83\t(defn error-response\n    84\t  \"Construct an error response preserving the request id.\"\n    85\t  [id code message]\n    86\t  {id-key id error-key (error code message)})\n    87\t\n    88\t\n    89\t(defn response?\n    90\t  \"True when value is a valid response envelope.  A response contains exactly\n    91\t   one of `:dao.stream.apply/ok` or `/error`; nil is a valid success value.\"\n    92\t  [value]\n    93\t  (and (map? value)\n    94\t       (correlation-id? (get value id-key))\n    95\t       (not= (contains? value ok-key) (contains? value error-key))\n    96\t       (or (contains? value ok-key)\n    97\t           (error? (get value error-key)))))\n    98\t\n    99\t\n   100\t(defn response-id\n   101\t  [value]\n   102\t  (get value id-key))\n   103\t\n   104\t\n   105\t(defn response-ok\n   106\t  [value]\n   107\t  (get value ok-key))\n   108\t\n   109\t\n   110\t(defn response-error\n   111\t  [value]\n   112\t  (get value error-key))\n   113\t\n   114\t\n   115\t;; =============================================================================\n   116\t;; Endpoint descriptors and explicit stream helpers\n   117\t;; =============================================================================\n   118\t\n   119\t(def request-key :dao.stream.apply/request)\n   120\t(def response-key :dao.stream.apply/response)\n   121\t\n   122\t\n   123\t(defn endpoint\n   124\t  \"Construct a portable endpoint pair from request and response descriptors.\n   125\t   Resolving descriptors into handles is host composition and stays outside this\n   126\t   namespace.\"\n   127\t  [request-descriptor response-descriptor]\n   128\t  {request-key request-descriptor response-key response-descriptor})\n   129\t\n   130\t\n   131\t(def make-endpoint endpoint)\n   132\t\n   133\t\n   134\t(defn endpoint?\n   135\t  [value]\n   136\t  (and (map? value)\n   137\t       (stream/valid-descriptor? (get value request-key))\n   138\t       (stream/valid-descriptor? (get value response-key))))\n   139\t\n   140\t\n   141\t(defn endpoint-request\n   142\t  [value]\n   143\t  (get value request-key))\n   144\t\n   145\t\n   146\t(defn endpoint-response\n   147\t  [value]\n   148\t  (get value response-key))\n   149\t\n   150\t\n   151\t(defn put-request!\n   152\t  \"Append one validated request to an explicit writer handle.  Invalid envelope\n   153\t   data is reported as application data and is never appended.\"\n   154\t  [request-handle request-value]\n   155\t  (if (request? request-value)\n   156\t    (stream/append! request-handle request-value)\n   157\t    {:dao.stream.apply/outcome :dao.stream.apply/invalid-request\n   158\t     :dao.stream.apply/value request-value}))\n   159\t\n   160\t\n   161\t(defn put-response!\n   162\t  \"Append one validated response to an explicit writer handle.\"\n   163\t  [response-handle response-value]\n   164\t  (if (response? response-value)\n   165\t    (stream/append! response-handle response-value)\n   166\t    {:dao.stream.apply/outcome :dao.stream.apply/invalid-response\n   167\t     :dao.stream.apply/value response-value}))\n   168\t\n   169\t\n   170\t(defn next-request\n   171\t  \"Read one raw request value at the explicit cursor.  Validation belongs to the\n   172\t   server step because malformed stream data must be consumed once, not retried.\"\n   173\t  [request-handle request-cursor]\n   174\t  (stream/next request-handle request-cursor))\n   175\t\n   176\t\n   177\t(defn next-response\n   178\t  \"Read one raw response value at the explicit cursor.\"\n   179\t  [response-handle response-cursor]\n   180\t  (stream/next response-handle response-cursor))\n   181\t\n   182\t\n   183\t;; =============================================================================\n   184\t;; Pure request dispatch\n   185\t;; =============================================================================\n   186\t\n   187\t(defn dispatch-request\n   188\t  \"Invoke at most one handler for a validated request and return its correlated\n   189\t   response data.  Unknown operations and host handler failures are ordinary,\n   190\t   portable error responses; no exception escapes into a polling driver.\"\n   191\t  [handlers request-value]\n   192\t  (cond\n   193\t    (not (request? request-value))\n   194\t    (when (correlation-id? (request-id request-value))\n   195\t      (error-response (request-id request-value)\n   196\t                      :dao.stream.apply/malformed-request\n   197\t                      \"Malformed request envelope\"))\n   198\t\n   199\t    :else\n   200\t    (let [id (request-id request-value)\n   201\t          op (request-op request-value)\n   202\t          handler (get handlers op)]\n   203\t      (if-not (fn? handler)\n   204\t        (error-response id :dao.stream.apply/unknown-operation\n   205\t                        \"No handler for operation\")\n   206\t        (try\n   207\t          (success-response id (apply handler (request-args request-value)))\n   208\t          (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   209\t            (error-response id :dao.stream.apply/handler-error\n   210\t                            \"Handler failed\")))))))\n   211\t\n   212\t\n   213\t;; =============================================================================\n   214\t;; One explicit server step\n   215\t;; =============================================================================\n   216\t\n   217\t(defn server-state\n   218\t  \"Create caller-owned state for `serve-once!`.  The cursor must have been\n   219\t   minted by the request handle; this namespace never fabricates one.\"\n   220\t  [request-cursor]\n   221\t  {:request-cursor request-cursor\n   222\t   :pending-response nil\n   223\t   :pending-request-id nil\n   224\t   :pending-successor nil\n   225\t   :terminal nil\n   226\t   :diagnostics []})\n   227\t\n   228\t\n   229\t(defn- step-result\n   230\t  [outcome state & {:as extra}]\n   231\t  (merge {:dao.stream.apply/outcome outcome\n   232\t          :dao.stream.apply/state state}\n   233\t         extra))\n   234\t\n   235\t\n   236\t(defn- clear-pending\n   237\t  [state]\n   238\t  (assoc state\n   239\t         :pending-response nil\n   240\t         :pending-request-id nil\n   241\t         :pending-successor nil))\n   242\t\n   243\t\n   244\t(defn- retain-response\n   245\t  [state response successor]\n   246\t  (assoc state\n   247\t         :pending-response response\n   248\t         :pending-request-id (response-id response)\n   249\t         :pending-successor successor))\n   250\t\n   251\t\n   252\t(defn- deliver-pending\n   253\t  [response-handle state]\n   254\t  (let [response (:pending-response state)\n   255\t        put-result (put-response! response-handle response)\n   256\t        outcome (:dao.stream/outcome put-result)]\n   257\t    (case outcome\n   258\t      :dao.stream/ok\n   259\t      (step-result :dao.stream.apply/responded\n   260\t                   (-> state\n   261\t                       (assoc :request-cursor (:pending-successor state))\n   262\t                       clear-pending)\n   263\t                   :dao.stream.apply/response response\n   264\t                   :dao.stream.apply/append put-result)\n   265\t\n   266\t      :dao.stream/full\n   267\t      (step-result :dao.stream.apply/pending-response state\n   268\t                   :dao.stream.apply/response response\n   269\t                   :dao.stream.apply/append put-result)\n   270\t\n   271\t      ;; A response that cannot be delivered is consumed once and terminal for\n   272\t      ;; this binding.  Retrying would rerun neither handler nor cursor, but\n   273\t      ;; would conceal the known loss from the caller.\n   274\t      (:dao.stream/invalid-value :dao.stream/closed :dao.stream/transport-error)\n   275\t      (step-result :dao.stream.apply/response-undeliverable\n   276\t                   (-> state\n   277\t                       (assoc :request-cursor (:pending-successor state)\n   278\t                              :terminal outcome)\n   279\t                       clear-pending)\n   280\t                   :dao.stream.apply/response response\n   281\t                   :dao.stream.apply/append put-result)\n   282\t\n   283\t      ;; A helper-level invalid response is also terminal.  It indicates a\n   284\t      ;; caller/handler defect but still must not leave a request poison-pill.\n   285\t      (step-result :dao.stream.apply/response-undeliverable\n   286\t                   (-> state\n   287\t                       (assoc :request-cursor (:pending-successor state)\n   288\t                              :terminal outcome)\n   289\t                       clear-pending)\n   290\t                   :dao.stream.apply/response response\n   291\t                   :dao.stream.apply/append put-result))))\n   292\t\n   293\t\n   294\t(defn- terminal-result\n   295\t  [state outcome read-result]\n   296\t  (step-result :dao.stream.apply/terminal\n   297\t               (assoc state :terminal outcome)\n   298\t               :dao.stream.apply/read read-result))\n   299\t\n   300\t\n   301\t(defn serve-once!\n   302\t  \"Advance one server session by at most one request and one response append.\n   303\t\n   304\t   `state` is explicit caller-owned data.  A computed response and its exact\n   305\t   successor cursor remain in that state until append succeeds, so retrying on\n   306\t   `:dao.stream/full` cannot invoke the handler twice.  This function neither\n   307\t   loops nor waits.\"\n   308\t  [handlers request-handle response-handle state]\n   309\t  (cond\n   310\t    (:terminal state)\n   311\t    (step-result :dao.stream.apply/terminal state)\n   312\t\n   313\t    (:pending-response state)\n   314\t    (deliver-pending response-handle state)\n   315\t\n   316\t    :else\n   317\t    (let [read-result (next-request request-handle (:request-cursor state))\n   318\t          outcome (:dao.stream/outcome read-result)]\n   319\t      (case outcome\n   320\t        :dao.stream/ok\n   321\t        (let [request-value (:dao.stream/value read-result)\n   322\t              successor (:dao.stream/cursor read-result)]\n   323\t          (if-let [response (dispatch-request handlers request-value)]\n   324\t            (deliver-pending response-handle\n   325\t                             (retain-response state response successor))\n   326\t            ;; A malformed element with no usable id cannot be correlated, but\n   327\t            ;; it still advances exactly once and becomes a local diagnostic.\n   328\t            (step-result :dao.stream.apply/malformed-request\n   329\t                         (-> state\n   330\t                             (assoc :request-cursor successor)\n   331\t                             (update :diagnostics conj\n   332\t                                     {:dao.stream.apply/code\n   333\t                                      :dao.stream.apply/malformed-request\n   334\t                                      :dao.stream.apply/value request-value}))\n   335\t                         :dao.stream.apply/read read-result)))\n   336\t\n   337\t        :dao.stream/blocked\n   338\t        (step-result :dao.stream.apply/idle state\n   339\t                     :dao.stream.apply/read read-result)\n   340\t\n   341\t        :dao.stream/gap\n   342\t        (step-result :dao.stream.apply/gap\n   343\t                     (-> state\n   344\t                         (assoc :request-cursor (:dao.stream/cursor read-result))\n   345\t                         (update :diagnostics conj\n   346\t                                 {:dao.stream.apply/code\n   347\t                                  :dao.stream.apply/request-gap}))\n   348\t                     :dao.stream.apply/read read-result)\n   349\t\n   350\t        (:dao.stream/end :dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n   351\t                         :dao.stream/transport-error)\n   352\t        (terminal-result state outcome read-result)\n   353\t\n   354\t        ;; A malformed transport implementation is terminal at this consumer;\n   355\t        ;; retrying an unknown answer could spin forever.\n   356\t        (terminal-result state outcome read-result)))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' test/dao/jing/remote_test.cljc | nl -ba -v1\"","aggregated_output":"     1\t(ns dao.jing.remote-test\n     2\t  \"Tests for dao.jing.remote, the WebSocket-remote content adapter.\n     3\t\n     4\t   Server side: dao.stream.rpc.ws serves dao.jing.remote/default-handlers over\n     5\t   a local dao.jing content handle. Client side:\n     6\t   dao.jing.remote/connect-content! wraps a dao.stream.rpc.client connection as\n     7\t   a dao.jing content handle. The synchronous WebSocket constructor is\n     8\t   JVM-only, so network tests are gated with #?(:clj ...) while the\n     9\t   in-process content-client unit tests run on all hosts.\"\n    10\t  (:require [clojure.test :refer [deftest is]]\n    11\t            [dao.jing :as jing]\n    12\t            [dao.jing.mem :as mem]\n    13\t            #?(:clj [dao.jing.file :as jing.file])\n    14\t            [dao.jing.remote :as remote]\n    15\t            #?(:clj [dao.stream.rpc.ws :as rpc-ws])))\n    16\t\n    17\t\n    18\t(defn- local-client\n    19\t  \"Build an in-process handlers + content-client pair over a memory store.\n    20\t   Returns {:store s :handlers h :client c :close-counter a}.\"\n    21\t  ([] (local-client (mem/create-content-mem)))\n    22\t  ([store]\n    23\t   (let [handlers (remote/default-handlers store)\n    24\t         close-counter (atom 0)\n    25\t         client (remote/content-client ::local\n    26\t                                       (fn [_ op args]\n    27\t                                         (apply (get handlers op) args))\n    28\t                                       (fn [_] (swap! close-counter inc)))]\n    29\t     {:store store,\n    30\t      :handlers handlers,\n    31\t      :client client,\n    32\t      :close-counter close-counter})))\n    33\t\n    34\t\n    35\t#?(:clj (defn- with-server\n    36\t          [f]\n    37\t          (let [port (+ 20000 (rand-int 30000))\n    38\t                url (str \"ws://localhost:\" port)\n    39\t                backing (mem/create-content-mem)\n    40\t                server (rpc-ws/start! (remote/default-handlers backing) port)\n    41\t                _ (Thread/sleep 100)]\n    42\t            (try (let [client (remote/connect-content! url)]\n    43\t                   (try (f url client) (finally (jing/close! client))))\n    44\t                 (finally (rpc-ws/stop! server) (jing/close! backing))))))\n    45\t\n    46\t\n    47\t(deftest default-handlers-exact-test\n    48\t  (let [store (mem/create-content-mem)\n    49\t        handlers (remote/default-handlers store)]\n    50\t    (is (= #{:jing/put-content :jing/get-content} (set (keys handlers)))\n    51\t        \"server handlers must expose exactly the two content ops\")\n    52\t    (is (every? ifn? (vals handlers)))\n    53\t    (is (thrown? #?(:clj Exception\n    54\t                    :cljd Object\n    55\t                    :cljs js/Error)\n    56\t          (remote/default-handlers {}))\n    57\t        \"construction must throw when :put-content-fn is missing\")\n    58\t    (jing/close! store)))\n    59\t\n    60\t\n    61\t(deftest put-automatic-materialize-test\n    62\t  (let [fx (local-client)\n    63\t        client (:client fx)\n    64\t        payload {:hello \"world\"}\n    65\t        address (jing/materialize! client payload)]\n    66\t    (is (= (jing/segment-key payload) address)\n    67\t        \"materialize! must return the payload's segment address\")\n    68\t    (is (= payload (jing/get client address ::miss))\n    69\t        \"materialized content must be readable by its segment-key address\")\n    70\t    (jing/close! client)\n    71\t    (jing/close! (:store fx))))\n    72\t\n    73\t\n    74\t(deftest get-nil-opaque-absent-test\n    75\t  (let [fx (local-client)\n    76\t        client (:client fx)]\n    77\t    (let [nil-address (jing/materialize! client nil)]\n    78\t      (is (= (jing/segment-key nil) nil-address)\n    79\t          \"materialize! must mint the address of a nil payload\")\n    80\t      (is (nil? (jing/get client nil-address ::miss))\n    81\t          \"a stored nil must be returned as nil, not as the absent sentinel\"))\n    82\t    (let [opaque [1 2 3 {:nested true}]\n    83\t          opaque-address (jing/materialize! client opaque)]\n    84\t      (is (= (jing/segment-key opaque) opaque-address)\n    85\t          \"materialize! must mint the address of an opaque payload\")\n    86\t      (is (= opaque (jing/get client opaque-address ::miss))\n    87\t          \"opaque values must round-trip\"))\n    88\t    (is (= ::miss\n    89\t           (jing/get client (jing/segment-key {:never \"written\"}) ::miss))\n    90\t        \"an absent address must return the not-found sentinel\")\n    91\t    (jing/close! client)\n    92\t    (jing/close! (:store fx))))\n    93\t\n    94\t\n    95\t(deftest put-duplicate-reports-present-test\n    96\t  (let [fx (local-client)\n    97\t        client (:client fx)\n    98\t        payload {:dedup \"same content\"}\n    99\t        address (jing/materialize! client payload)]\n   100\t    (is (= (jing/segment-key payload) address)\n   101\t        \"materialize! must return the segment address\")\n   102\t    (is (= :present ((:put-content-fn client) address payload))\n   103\t        \"materializing identical content again must report :present\")\n   104\t    (jing/close! client)\n   105\t    (jing/close! (:store fx))))\n   106\t\n   107\t\n   108\t(deftest server-put-rejects-non-keyword-address-test\n   109\t  (let [fx (local-client)\n   110\t        handlers (:handlers fx)\n   111\t        payload {:x 1}]\n   112\t    (is (thrown? #?(:clj Exception\n   113\t                    :cljd Object\n   114\t                    :cljs js/Error)\n   115\t          ((:jing/put-content handlers) \"not-a-keyword\" payload))\n   116\t        \"a non-keyword address must be rejected\")\n   117\t    (jing/close! (:client fx))\n   118\t    (jing/close! (:store fx))))\n   119\t\n   120\t\n   121\t(deftest server-put-rejects-hash-mismatch-test\n   122\t  (let [fx (local-client)\n   123\t        handlers (:handlers fx)\n   124\t        payload {:x 1}]\n   125\t    (is (thrown?\n   126\t          #?(:clj Exception\n   127\t             :cljd Object\n   128\t             :cljs js/Error)\n   129\t          ((:jing/put-content handlers) (jing/segment-key {:x 2}) payload))\n   130\t        \"an address whose hash does not match the payload must be rejected\")\n   131\t    (jing/close! (:client fx))\n   132\t    (jing/close! (:store fx))))\n   133\t\n   134\t\n   135\t(deftest backend-invalid-put-result-test\n   136\t  (let [handlers (remote/default-handlers {:put-content-fn (fn [_ _] :bogus)})]\n   137\t    (is (thrown?\n   138\t          #?(:clj Exception\n   139\t             :cljd Object\n   140\t             :cljs js/Error)\n   141\t          ((:jing/put-content handlers) (jing/segment-key {:x 1}) {:x 1}))\n   142\t        \"a backend result outside #{:inserted :present} must throw\")))\n   143\t\n   144\t\n   145\t(deftest client-get-arbitrary-address-test\n   146\t  (let [fx (local-client)\n   147\t        client (:client fx)]\n   148\t    (is (thrown? #?(:clj Exception\n   149\t                    :cljd Object\n   150\t                    :cljs js/Error)\n   151\t          (jing/get client :anything-at-all ::miss))\n   152\t        \"client get must reject an arbitrary keyword address\")\n   153\t    (is (thrown? #?(:clj Exception\n   154\t                    :cljd Object\n   155\t                    :cljs js/Error)\n   156\t          (jing/get client \"string-address\" ::miss))\n   157\t        \"client get must reject a string address\")\n   158\t    (jing/close! client)\n   159\t    (jing/close! (:store fx))))\n   160\t\n   161\t\n   162\t(deftest close-idempotent-ops-throw-test\n   163\t  (let [fx (local-client)\n   164\t        client (:client fx)\n   165\t        close-counter (:close-counter fx)]\n   166\t    (jing/close! client)\n   167\t    (jing/close! client)\n   168\t    (is (= 1 @close-counter) \"the underlying close must run exactly once\")\n   169\t    (is (thrown? #?(:clj Exception\n   170\t                    :cljd Object\n   171\t                    :cljs js/Error)\n   172\t          (jing/materialize! client {:x 1}))\n   173\t        \"materialize! after close must throw\")\n   174\t    (is (thrown? #?(:clj Exception\n   175\t                    :cljd Object\n   176\t                    :cljs js/Error)\n   177\t          (jing/get client (jing/segment-key {:x 1}) ::miss))\n   178\t        \"get after close must throw\")\n   179\t    (jing/close! (:store fx))))\n   180\t\n   181\t\n   182\t(deftest close-failure-retry-test\n   183\t  (let [store (mem/create-content-mem)\n   184\t        handlers (remote/default-handlers store)\n   185\t        attempts (atom 0)\n   186\t        client (remote/content-client\n   187\t                 ::local\n   188\t                 (fn [_ op args] (apply (get handlers op) args))\n   189\t                 (fn [_]\n   190\t                   (swap! attempts inc)\n   191\t                   (when (< @attempts 2) (throw (ex-info \"close failed\" {})))))]\n   192\t    (is (thrown? #?(:clj Exception\n   193\t                    :cljd Object\n   194\t                    :cljs js/Error)\n   195\t          (jing/close! client))\n   196\t        \"a failed close must propagate the error\")\n   197\t    (is (= 1 @attempts))\n   198\t    (is (false? @(:closed-atom client))\n   199\t        \"the client must stay open after a failed close\")\n   200\t    (is (= (jing/segment-key {:still \"open\"})\n   201\t           (jing/materialize! client {:still \"open\"}))\n   202\t        \"a valid materialize! must still work after a failed close\")\n   203\t    (is (nil? (jing/close! client)) \"a retry close must succeed and return nil\")\n   204\t    (is (= 2 @attempts))\n   20