{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/jing/coordinate.cljc'","aggregated_output":"     1\t(ns dao.jing.coordinate\n     2\t  \"Explicit interpreter from serializable DaoJing coordinates to local live\n     3\t   content-store handles. Coordinates are data; this namespace owns the\n     4\t   closed-world interpretation of the backends implemented in this release.\"\n     5\t  (:require [dao.jing.file :as file]\n     6\t            #?(:clj [dao.jing.remote :as remote])))\n     7\t\n     8\t\n     9\t(defn- validate-file!\n    10\t  [{:keys [path], :as coordinate}]\n    11\t  (when-not (and (= #{:dao.jing/type :path} (set (keys coordinate)))\n    12\t                 (string? path)\n    13\t                 (not (empty? path)))\n    14\t    (throw (ex-info \"invalid file-backed DaoJing coordinate\"\n    15\t                    {:coordinate coordinate})))\n    16\t  coordinate)\n    17\t\n    18\t\n    19\t#?(:clj (defn- validate-remote!\n    20\t          [{:keys [url options], :as coordinate}]\n    21\t          (when-not (and (string? url)\n    22\t                         (not (empty? url))\n    23\t                         (or (nil? options) (map? options))\n    24\t                         (= (set (keys coordinate))\n    25\t                            (cond-> #{:dao.jing/type :url}\n    26\t                              (contains? coordinate :options) (conj :options))))\n    27\t            (throw (ex-info \"invalid remote DaoJing coordinate\"\n    28\t                            {:coordinate coordinate})))\n    29\t          coordinate))\n    30\t\n    31\t\n    32\t(defn open!\n    33\t  \"Open a serializable content-store coordinate as a live DaoJing handle.\n    34\t   Unsupported coordinate types fail closed; no runtime registry is consulted.\"\n    35\t  [{coordinate-type :dao.jing/type, :as coordinate}]\n    36\t  (case coordinate-type\n    37\t    :dao.jing/file (file/create-content-file (:path (validate-file!\n    38\t                                                      coordinate)))\n    39\t    #?@(:clj [:dao.jing/remote (let [{:keys [url options]} (validate-remote!\n    40\t                                                             coordinate)]\n    41\t                                 (remote/connect-content! url (or options {})))])\n    42\t    (throw (ex-info \"unsupported DaoJing content-store coordinate\"\n    43\t                    {:coordinate coordinate}))))\n","exit_code":0,"status":"completed"}}
