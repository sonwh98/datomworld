{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/jing/remote.cljc'","aggregated_output":"     1\t(ns dao.jing.remote\n     2\t  \"Remote content adapter over dao.stream.rpc.\n     3\t   Server side: dao.jing.remote/default-handlers exposes a local dao.jing\n     4\t   content handle as the :jing/put-content and :jing/get-content RPC ops.\n     5\t   Client side: dao.jing.remote/content-client wraps an RPC client as a\n     6\t   dao.jing content handle map {:client c :closed-atom a :put-content-fn f\n     7\t   :get-content-fn g :close-fn h} that jing/materialize!, jing/get, and\n     8\t   jing/close! dispatch through automatically. The synchronous WebSocket\n     9\t   constructor connect-content! is JVM-only.\"\n    10\t  (:require [dao.jing :as jing]\n    11\t            #?(:clj [dao.stream.rpc.client :as rpc-client])\n    12\t            #?(:clj [dao.stream.rpc.ws :as rpc-ws]))\n    13\t  #?(:cljs (:require-macros [dao.jing])))\n    14\t\n    15\t\n    16\t(defn- validate-address-payload!\n    17\t  \"Throw unless address is a strict segment address matching the payload's\n    18\t   content-derived hash.\"\n    19\t  [address payload]\n    20\t  (when-not (jing/segment-address? address)\n    21\t    (throw (ex-info \"content address must be a segment address\"\n    22\t                    {:address address, :payload payload})))\n    23\t  (when-not (= (jing/segment-hash address) (jing/content-hash payload))\n    24\t    (throw (ex-info \"content address does not match payload hash\"\n    25\t                    {:address address,\n    26\t                     :content-hash (jing/content-hash payload)}))))\n    27\t\n    28\t\n    29\t#_{:clj-kondo/ignore [:unused-binding]}\n    30\t\n    31\t\n    32\t(defn- with-lock\n    33\t  [lock f]\n    34\t  #?(:clj (locking lock (f))\n    35\t     :default (f)))\n    36\t\n    37\t\n    38\t(defn- valid-presence-envelope?\n    39\t  \"True only for the exact wire envelope {:found? boolean, :value value}.\"\n    40\t  [x]\n    41\t  (and (map? x)\n    42\t       (= #{:found? :value} (set (keys x)))\n    43\t       (let [f (:found? x)] (or (true? f) (false? f)))))\n    44\t\n    45\t\n    46\t(defn default-handlers\n    47\t  \"Build the RPC handler map from a local dao.jing content handle.\"\n    48\t  [handle]\n    49\t  (let [put (:put-content-fn handle)\n    50\t        local-missing #?(:clj (Object.)\n    51\t                         :cljs (js-obj)\n    52\t                         :cljd (Object.))]\n    53\t    (when-not (ifn? put)\n    54\t      (throw (ex-info \"handle must expose a :put-content-fn\" {:handle handle})))\n    55\t    {:jing/put-content\n    56\t     (fn [address payload]\n    57\t       (validate-address-payload! address payload)\n    58\t       (let [result (put address payload)]\n    59\t         (if (#{:inserted :present} result)\n    60\t           result\n    61\t           (throw (ex-info\n    62\t                    \"backend returned an invalid put result\"\n    63\t                    {:address address, :payload payload, :result result}))))),\n    64\t     :jing/get-content (fn [address]\n    65\t                         (let [result (jing/get handle address local-missing)]\n    66\t                           (if (identical? result local-missing)\n    67\t                             {:found? false, :value nil}\n    68\t                             {:found? true, :value result})))}))\n    69\t\n    70\t\n    71\t(defn content-client\n    72\t  \"Wrap an RPC client as a dao.jing content handle.\n    73\t\n    74\t   call-fn is invoked as (call-fn client op args) and close-fn as\n    75\t   (close-fn client). Close is guarded so concurrent JVM closes call the\n    76\t   underlying close-fn exactly once; if close-fn throws, the client stays\n    77\t   open for retry.\"\n    78\t  [client call-fn close-fn]\n    79\t  (when-not (ifn? call-fn)\n    80\t    (throw (ex-info \"call-fn must be a function\" {:call-fn call-fn})))\n    81\t  (when-not (ifn? close-fn)\n    82\t    (throw (ex-info \"close-fn must be a function\" {:close-fn close-fn})))\n    83\t  (let [closed-atom (atom false)\n    84\t        close-lock #?(:clj (Object.)\n    85\t                      :default nil)\n    86\t        ensure-open (fn []\n    87\t                      (when @closed-atom\n    88\t                        (throw (ex-info \"content client is closed\"\n    89\t                                        {:client client}))))]\n    90\t    {:client client,\n    91\t     :closed-atom closed-atom,\n    92\t     :put-content-fn (fn [address payload]\n    93\t                       (ensure-open)\n    94\t                       (call-fn client :jing/put-content [address payload])),\n    95\t     :get-content-fn\n    96\t     (fn [address not-found]\n    97\t       (ensure-open)\n    98\t       (let [resp (call-fn client :jing/get-content [address])]\n    99\t         (if (valid-presence-envelope? resp)\n   100\t           (if (:found? resp) (:value resp) not-found)\n   101\t           (throw\n   102\t             (ex-info\n   103\t               \"malformed RPC response: presence envelope must contain exactly :found? (boolean) and :value keys\"\n   104\t               {:operation :jing/get-content,\n   105\t                :address address,\n   106\t                :response resp}))))),\n   107\t     :close-fn (fn []\n   108\t                 (with-lock close-lock\n   109\t                   (fn []\n   110\t                     (when-not @closed-atom\n   111\t                       (close-fn client)\n   112\t                       (compare-and-set! closed-atom false true)))))}))\n   113\t\n   114\t\n   115\t#?(:clj\n   116\t   (defn connect-content!\n   117\t     \"Connect to a remote dao.jing content server over WebSocket and return a\n   118\t      content client handle map (see content-client).\"\n   119\t     ([url] (connect-content! url {}))\n   120\t     ([url opts]\n   121\t      (let [client (rpc-ws/connect! url opts)]\n   122\t        (content-client client rpc-client/call! rpc-client/close!)))))\n   123\t\n   124\t\n   125\t#?(:clj (comment\n   126\t          (require '[dao.jing.file :as file])\n   127\t          (def store\n   128\t            (file/create-content-file \"target/dao-jing-remote-demo.log\"))\n   129\t          (def server (rpc-ws/start! (default-handlers store) 7070))\n   130\t          (def client (connect-content! \"ws://localhost:7070\"))\n   131\t          (def address (jing/materialize! client {:hello \"world\"}))\n   132\t          (jing/get client address nil)\n   133\t          (jing/close! client)\n   134\t          (rpc-ws/stop! server)\n   135\t          (jing/close! store)))\n","exit_code":0,"status":"completed"}}
