{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,140p' test/dao/jing/file_test.cljc | nl -ba -v1\"","aggregated_output":"     1\t(ns dao.jing.file-test\n     2\t  \"Tests for dao.jing.file persistent content files.\"\n     3\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n     4\t            [clojure.test :refer [deftest is testing]]\n     5\t            [dao.jing :as jing]\n     6\t            [dao.jing.file :as jing-file]\n     7\t            [dao.stream :as ds]\n     8\t            [dao.stream.log]\n     9\t            [dao.stream.ringbuffer]))\n    10\t\n    11\t\n    12\t(defn- temp-path\n    13\t  [prefix]\n    14\t  (str \"target/test-jing-content-\" prefix \"-\" (random-uuid) \".log\"))\n    15\t\n    16\t\n    17\t(defn- cleanup-file\n    18\t  [path]\n    19\t  #?(:clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n    20\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))\n    21\t     :cljd (try (let [f (dart-io/File path)]\n    22\t                  (when (.existsSync f) (.deleteSync f)))\n    23\t                (catch #?(:cljd Object\n    24\t                          :default Exception)\n    25\t                       _\n    26\t                  nil))))\n    27\t\n    28\t\n    29\t(defn- count-records\n    30\t  [log]\n    31\t  (loop [cursor {:position 0}\n    32\t         n 0]\n    33\t    (let [res (ds/next log cursor)]\n    34\t      (if (and (map? res) (contains? res :ok))\n    35\t        (recur (:cursor res) (inc n))\n    36\t        n))))\n    37\t\n    38\t\n    39\t(deftest codec-test\n    40\t  (testing\n    41\t    \"encode-record/decode-record round trip [address payload] including nil\"\n    42\t    (let [cases [[(jing/segment-key {:a 1}) {:a 1}] [(jing/segment-key nil) nil]\n    43\t                 [(jing/segment-key \"plain\") \"plain\"]\n    44\t                 [(jing/segment-key [1 2 3]) [1 2 3]]]]\n    45\t      (doseq [[a