{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,200p' test/dao/jing_test.cljc | nl -ba -v1\"","aggregated_output":"     1\t(ns dao.jing-test\n     2\t  \"Contract tests for the DaoJing content-addressed storage observer\n     3\t   (docs/design/dao.jing.md, target architecture).\n     4\t\n     5\t   Covers the plain-data handle API (materialize!/get/close!), the explicit\n     6\t   intake-pool observer (observer-state/observe-step!), and the\n     7\t   content-addressing discipline. The transitional CAS/root/evaluator/\n     8\t   file/mem compatibility contracts are gone: this namespace requires only\n     9\t   dao.jing plus the ringbuffer stream transport.\"\n    10\t  (:require [clojure.test :refer [deftest is testing]]\n    11\t            #?(:clj [clojure.edn])\n    12\t            [clojure.string :as str]\n    13\t            [dao.jing :as jing]\n    14\t            [dao.stream :as ds]\n    15\t            [dao.stream.ringbuffer]))\n    16\t\n    17\t\n    18\t(defn mem-handle\n    19\t  \"In-memory content backend for tests: a map keyed by content address. The\n    20\t   store atom is exposed as :store so tests can assert on the exact contents\n    21\t   of the backend. The seed accepts an address->payload map, used to force\n    22\t   collisions.\"\n    23\t  ([] (mem-handle {}))\n    24\t  ([seed]\n    25\t   (let [store (atom seed)]\n    26\t     {:store store,\n    27\t      :put-content-fn (fn [address payload]\n    28\t                        (if (contains? @store address)\n    29\t                          :present\n    30\t                          (do (swap! store assoc address payload) :inserted))),\n    31\t      :get-content-fn (fn [address not-found] (get @store address not-found)),\n    32\t      :close-fn (fn [] (swap! store assoc ::closed true))})))\n    33\t\n    34\t\n    35\t(defn open-stream\n    36\t  \"Open a ringbuffer transport pre-loaded with vals.\"\n    37\t  [& vals]\n    38\t  (let [s (ds/open! {:dao.stream/type :ringbuffer, :capacity 8})]\n    39\t    (doseq [v vals] (ds/append! s v))\n    40\t    s))\n    41\t\n    42\t\n    43\t(defrecord MalformedResultStream\n    44\t  [result]\n    45\t  ;; Test double: a reader whose every ds/next answer is the configured\n    46\t  ;; result, used to feed malformed maps into observe-step!.\n    47\t  ds/IDaoStreamReader\n    48\t\n    49\t  (next [_this _cursor] result))\n    50\t\n    51\t\n    52\t;; ---------------------------------------------------------------------------\n    53\t;; Content addressing\n    54\t;; ---------------------------------------------------------------------------\n    55\t\n    56\t(deftest sha256-known-answer\n    57\t  ;; Pins the actual digest function; load-bearing across hosts: :clj\n    58\t  ;; delegates to MessageDigest, :cljs to goog.crypt, :cljd to the\n    59\t  ;; hand-rolled\n    60\t  ;; SHA-256 in dao.jing. If that implementation drifts, cljd peers mint\n    61\t  ;; different segment-keys than JVM/JS peers for identical values and\n    62\t  ;; content addressing silently fractures. Vectors are the NIST/FIPS-180-4\n    63\t  ;; digests.\n    64\t  (testing \"published vectors\"\n    65\t    (doseq\n    66\t      [[in want]\n    67\t       {\"\" \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n    68\t        \"abc\"\n    69\t        \"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\n    70\t        \"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq\"\n    71\t        \"248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1\",\n    72\t        \"hello world\"\n    73\t        \"b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9\"}]\n    74\t      (is (= want (jing/sha256 in)) (str \"sha256 of \" (pr-str in)))))\n    75\t  (testing \"a 65-byte input, which crosses the 64-byte block boundary\"\n    76\t    (is (= \"635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0\"\n    77\t           (jing/sha256 (apply str (repeat 65 \"a\")))))))\n    78\t\n    79\t\n    80\t(deftest segment-key-is-content-addressed\n    81\t  (testing \"the key is deterministic and order-insensitive\"\n    82\t    (is (= (jing/segment-key {:a 1, :b 2}) (jing/segment-key {:b 2, :a 1})))\n    83\t    (is (not= (jing/segment-key {:a 1}) (jing/segment-key {:a 2})))\n    84\t    (is (= \"segment\" (namespace (jing/segment-key {:a 1})))))\n    85\t  (testing \"and is total over non-map values, which are legal payloads\"\n    86\t    (doseq [v [42 \"hello\" :kw [1 2 3] nil #{:a}]]\n    87\t      (is (= (jing/segment-key v) (jing/segment-key v))\n    88\t          (str (pr-str v) \" must hash deterministically\"))\n    89\t      (is (= \"segment\" (namespace (jing/segment-key v)))))\n    90\t    (is (not= (jing/segment-key 42) (jing/segment-key \"42\"))\n    91\t        \"distinct values must not collide across types\")))\n    92\t\n    93\t\n    94\t(deftest segment-keys-are-readable-edn\n    95\t  ;; An EDN keyword name must not start with a digit, but a bare sha-256\n    96\t  ;; hex often does. A key that cannot survive print -> read poisons every\n    97\t  ;; EDN boundary content addresses cross.\n    98\t  (testing \"no minted key starts with a digit\"\n    99\t    (doseq [n (range 16)]\n   100\t      (let [k (jing/segment-key {:n n})]\n   101\t        (is (not (contains? (set \"0123456789\") (first (name k))))\n   102\t            (str k \" is not readable EDN\")))))\n   103\t  #?(:clj (testing \"a minted key survives print -> read\"\n   104\t            (let [k (jing/segment-key {:a 1})]\n   105\t              (is (= k (clojure.edn/read-string (pr-str k))))))))\n   106\t\n   107\t\n   108\t(deftest segment-hash-recovers-the-content-hash\n   109\t  (testing \"the hash is extractable from the key and matches the content\"\n   110\t    (let [v {:a 1}]\n   111\t      (is (= (jing/content-hash v) (jing/segment-hash (jing/segment-key v)))))))\n   112\t\n   113\t\n   114\t(deftest segment-hash-rejects-invalid-keys\n   115\t  (testing\n   116\t    \"segment-hash extracts the hash only from a valid\n   117\t            :segment/sha256-<64 lowercase hex> address; foreign namespaces,\n   118\t            malformed hashes, non-hex characters, and wrong lengths throw\n   119\t            instead of merely stripping a name prefix\"\n   120\t    (let [h64 (jing/segment-hash (jing/segment-key {:a 1}))]\n   121\t      (is (= 64 (count h64)))\n   122\t      (is (re-matches #\"[0-9a-f]{64}\" h64))\n   123\t      (doseq [bad [(keyword \"other\" (str \"sha256-\" h64))\n   124\t                   (keyword \"segment\" \"sha256-\")\n   125\t                   (keyword \"segment\" (str \"sha256-\" (subs h64 0 63)))\n   126\t                   (keyword \"segment\" (str \"sha256-\" h64 \"0\"))\n   127\t                   (keyword \"segment\" (str \"sha256-\" (str/upper-case h64)))\n   128\t                   (keyword \"segment\"\n   129\t                            (str \"sha256-\" (str/replace h64 (first h64) \\g)))\n   130\t                   :plain :segment/not-a-hash :segment/sha256-xyz 42 \"abc\" nil\n   131\t                   [1 2]]]\n   132\t        (is (thrown? #?(:clj Exception\n   133\t                        :cljs js/Error\n   134\t                        :cljd Object)\n   135\t              (jing/segment-hash bad))\n   136\t            (str \"segment-hash must reject \" (pr-str bad)))))))\n   137\t\n   138\t\n   139\t(deftest content-hash-is-order-insensitive\n   140\t  (testing \"equal maps print identically regardless of insertion order\"\n   141\t    (is (= (jing/content-hash {:a 1, :b 2}) (jing/content-hash {:b 2, :a 1})))\n   142\t    (is (= (jing/content-hash #{:x :y}) (jing/content-hash #{:y :x}))))\n   143\t  (testing \"distinct values differ\"\n   144\t    (is (not= (jing/content-hash {:a 1}) (jing/content-hash {:a 2}))))\n   145\t  (testing \"content-hash drives the segment key\"\n   146\t    (is (= (jing/segment-hash (jing/segment-key {:a 1}))\n   147\t           (jing/content-hash {:a 1})))))\n   148\t\n   149\t\n   150\t;; ---------------------------------------------------------------------------\n   151\t;; Handle API: materialize! / get / close!\n   152\t;; ---------------------------------------------------------------------------\n   153\t\n   154\t(deftest materialize-hashes-and-retrieves\n   155\t  (testing\n   156\t    \"the address is derived automatically from the payload and the\n   157\t            value round-trips unchanged\"\n   158\t    (let [h (mem-handle)\n   159\t          payload {:a 1, :b [1 2 3]}\n   160\t          address (jing/materialize! h payload)]\n   161\t      (is (= (jing/segment-key payload) address))\n   162\t      (is (= \"segment\" (namespace address)))\n   163\t      (is (str/starts-with? (name address) \"sha256-\"))\n   164\t      (is (= payload (jing/get h address ::missing))\n   165\t          \"the stored value is exactly the payload: nothing stamped in\"))))\n   166\t\n   167\t\n   168\t(deftest put-receives-the-derived-address-and-payload\n   169\t  (testing \"the backend effect is invoked as (put-content-fn address payload)\"\n   170\t    (let [seen (atom nil)\n   171\t          payload {:v 1}\n   172\t          h {:put-content-fn (fn [a p] (reset! seen [a p]) :inserted),\n   173\t             :get-content-fn (fn [_ _] nil)}]\n   174\t      (jing/materialize! h payload)\n   175\t      (is (= [(jing/segment-key payload) payload] @seen)))))\n   176\t\n   177\t\n   178\t(deftest materialize-is-idempotent\n   179\t  (testing\n   180\t    \"duplicate materialization returns the same address, reports\n   181\t            :present on the second write, and never overwrites\"\n   182\t    (let [results (atom [])\n   183\t          store (atom {})\n   184\t          payload {:x 42}\n   185\t          h {:put-content-fn\n   186\t             (fn [address p]\n   187\t               (let [r (if (contains? @store address) :present :inserted)]\n   188\t                 (swap! store assoc address p)\n   189\t                 (swap! results conj r)\n   190\t                 r)),\n   191\t             :get-content-fn (fn [address nf] (get @store address nf))}\n   192\t          a1 (jing/materialize! h payload)\n   193\t          a2 (jing/materialize! h payload)]\n   194\t      (is (= a1 a2))\n   195\t      (is (= payload (jing/get h a1 ::missing)))\n   196\t      (is (= [:inserted :present] @results)))))\n   197\t\n   198\t\n   199\t(deftest get-absent-returns-not-found\n   200\t  (testing\n","exit_code":0,"status":"completed"}}
