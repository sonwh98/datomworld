{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '230,422p' src/cljc/dao/jing.cljc | nl -ba -v230\"","aggregated_output":"   230\t  [x]\n   231\t  (and (keyword? x)\n   232\t       (= \"segment\" (namespace x))\n   233\t       (let [n (name x)]\n   234\t         (and (str/starts-with? n \"sha256-\")\n   235\t              (let [h (subs n 7)]\n   236\t                (and (= 64 (count h)) (every? hex-digits-set h)))))))\n   237\t\n   238\t\n   239\t(defn segment-hash\n   240\t  \"The content hash carried by a segment address. Total only over valid\n   241\t   :segment/sha256-<64 lowercase hex> addresses; foreign namespaces,\n   242\t   malformed hashes, non-hex characters, and wrong lengths throw.\"\n   243\t  [k]\n   244\t  (when-not (segment-address? k)\n   245\t    (throw (ex-info \"not a sha256 segment key\" {:k k})))\n   246\t  (subs (name k) 7))\n   247\t\n   248\t\n   249\t(defn materialize!\n   250\t  \"Content-address payload and store it through the handle's backend.\n   251\t\n   252\t   The address is derived solely from the payload via segment-key, and the\n   253\t   backend effect :put-content-fn is invoked as (put-content-fn address\n   254\t   payload). The backend must answer with one of:\n   255\t\n   256\t     :inserted — the value is durably stored now;\n   257\t     :present  — an equal value is already stored under that address.\n   258\t\n   259\t   Any other answer is an invalid backend result and throws: DaoJing does\n   260\t   not accept ambiguous truthiness. The address is returned only after the\n   261\t   backend reports success.\n   262\t\n   263\t   On :present the stored value is read back through :get-content-fn and\n   264\t   verified. Equal content is idempotent and returns the same address.\n   265\t   Unequal content at the same address is an integrity failure and throws\n   266\t   loudly. Nothing is ever overwritten.\"\n   267\t  [handle payload]\n   268\t  (let [put (:put-content-fn handle)\n   269\t        get-fn (:get-content-fn handle)]\n   270\t    (when-not (fn? put)\n   271\t      (throw (ex-info \"dao.jing handle requires :put-content-fn\"\n   272\t                      {:handle handle})))\n   273\t    (when-not (fn? get-fn)\n   274\t      (throw (ex-info \"dao.jing handle requires :get-content-fn\"\n   275\t                      {:handle handle})))\n   276\t    (let [address (segment-key payload)\n   277\t          result (put address payload)]\n   278\t      (case result\n   279\t        :inserted address\n   280\t        :present\n   281\t        (let [stored (get-fn address content-missing)]\n   282\t          (cond\n   283\t            (identical? stored content-missing)\n   284\t            (throw\n   285\t              (ex-info\n   286\t                \"backend reported :present but the content address is absent\"\n   287\t                {:address address, :payload payload}))\n   288\t            (= stored payload) address\n   289\t            :else\n   290\t            (throw\n   291\t              (ex-info\n   292\t                \"content collision: unequal values at the same content address\"\n   293\t                {:address address, :stored stored, :payload payload}))))\n   294\t        (throw (ex-info\n   295\t                 \"invalid backend put result\"\n   296\t                 {:result result, :address address, :payload payload}))))))\n   297\t\n   298\t\n   299\t(defn get\n   300\t  \"Retrieve the opaque value stored at a content address.\n   301\t\n   302\t   Only :segment/sha256-<64 hex> content addresses are valid DaoJing reads;\n   303\t   arbitrary keys and mutable roots are outside DaoJing and throw before the\n   304\t   backend is consulted. Returns not-found when the address is absent.\"\n   305\t  [handle address not-found]\n   306\t  (when-not (segment-address? address)\n   307\t    (throw (ex-info \"dao.jing reads only :segment/sha256-... content addresses\"\n   308\t                    {:address address})))\n   309\t  (let [get-fn (:get-content-fn handle)]\n   310\t    (when-not (fn? get-fn)\n   311\t      (throw (ex-info \"dao.jing handle requires :get-content-fn\"\n   312\t                      {:handle handle})))\n   313\t    (get-fn address not-found)))\n   314\t\n   315\t\n   316\t(defn close!\n   317\t  \"Close the backend through its optional :close-fn. Idempotency is the\n   318\t   backend's contract: close! simply delegates, so a backend that tolerates\n   319\t   repeated closes may be closed repeatedly. Returns nil. Handles without\n   320\t   :close-fn have nothing to release.\"\n   321\t  [handle]\n   322\t  (when-let [close-fn (:close-fn handle)] (close-fn))\n   323\t  nil)\n   324\t\n   325\t\n   326\t;; =============================================================================\n   327\t;; Intake-pool observer (docs/design/dao.jing.md, The intake pool and\n   328\t;; Cursor tracking and recovery)\n   329\t;; =============================================================================\n   330\t\n   331\t(defn observer-state\n   332\t  \"Construct the immutable observer state for an explicit intake pool.\n   333\t\n   334\t   Returns plain data, no atoms or registration:\n   335\t\n   336\t     {:members [{:stream <ref>, :cursor {:position 0}, :status :pending} ...]\n   337\t      :next 0}\n   338\t\n   339\t   :members has one entry per pool stream; each entry holds only the stream\n   340\t   reference, its operational cursor (initialized to position 0), and its\n   341\t   explicit status. :next is the fair round-robin index of the member the\n   342\t   next observe-step! polls first. Member status is one of :pending (never\n   343\t   polled), :ok, :blocked, :end, or :daostream/gap.\n   344\t\n   345\t   Pool membership is supplied here; DaoJing performs no registration or\n   346\t   discovery. The source stream is operational state only and never becomes\n   347\t   part of any address or stored payload.\"\n   348\t  [streams]\n   349\t  {:members (mapv (fn [s] {:stream s, :cursor {:position 0}, :status :pending})\n   350\t                  streams),\n   351\t   :next 0})\n   352\t\n   353\t\n   354\t(defn observe-step!\n   355\t  \"Poll the intake pool round-robin and process at most one payload.\n   356\t\n   357\t   Starts polling at the member selected by (:next state) and walks the pool\n   358\t   once, so every active member is checked within the call. Returns:\n   359\t\n   360\t     {:state next-state, :signal :ok, :address address}\n   361\t       a payload was materialized and that member's cursor advanced;\n   362\t     {:state next-state, :signal :blocked}\n   363\t       the pool is empty, or no member had anything to read;\n   364\t     {:state next-state, :signal :end}\n   365\t       every member has explicitly ended;\n   366\t     {:state next-state, :signal :daostream/gap, :member i}\n   367\t       member i's cursor is behind the retention boundary. The gap is\n   368\t       returned immediately, its cursor is left unchanged, and it is never\n   369\t       auto-resynchronized: resync is the caller's decision.\n   370\t\n   371\t   On {:ok payload :cursor next-cursor} the payload is materialized before\n   372\t   the member cursor advances; if materialization throws, the exception\n   373\t   propagates and the caller-owned state is untouched. Blocked and ended\n   374\t   members never prevent later members from being checked, and a member\n   375\t   that produced a payload yields its turn, so a continuously ready member\n   376\t   cannot starve another.\"\n   377\t  [handle state]\n   378\t  (let [{:keys [members next]} state\n   379\t        n (count members)]\n   380\t    (if (zero? n)\n   381\t      {:state state, :signal :blocked}\n   382\t      (loop [i next\n   383\t             scanned 0\n   384\t             state' state]\n   385\t        (if (>= scanned n)\n   386\t          (let [all-ended? (every? #(= :end (:status %)) (:members state'))]\n   387\t            {:state state', :signal (if all-ended? :end :blocked)})\n   388\t          (let [member (nth members i)]\n   389\t            (if (= :end (:status member))\n   390\t              (recur (mod (inc i) n) (inc scanned) state')\n   391\t              (let [res (ds/next (:stream member) (:cursor member))]\n   392\t                (cond\n   393\t                  (map? res)\n   394\t                  (if (and (contains? res :ok) (contains? res :cursor))\n   395\t                    (let [address (materialize! handle (:ok res))]\n   396\t                      {:state (-> state'\n   397\t                                  (assoc-in [:members i :cursor]\n   398\t                                            (:cursor res))\n   399\t                                  (assoc-in [:members i :status] :ok)\n   400\t                                  (assoc :next (mod (inc i) n))),\n   401\t                       :signal :ok,\n   402\t                       :address address})\n   403\t                    (throw\n   404\t                      (ex-info\n   405\t                        \"unexpected stream result: a successful read must carry both :ok and :cursor\"\n   406\t                        {:result res, :member i})))\n   407\t                  (= res :blocked)\n   408\t                  (recur (mod (inc i) n)\n   409\t                         (inc scanned)\n   410\t                         (assoc-in state' [:members i :status] :blocked))\n   411\t                  (= res :end) (recur\n   412\t                                 (mod (inc i) n)\n   413\t                                 (inc scanned)\n   414\t                                 (assoc-in state' [:members i :status] :end))\n   415\t                  (= res :daostream/gap)\n   416\t                  {:state (-> state'\n   417\t                              (assoc-in [:members i :status] :daostream/gap)\n   418\t                              (assoc :next (mod (inc i) n))),\n   419\t                   :signal :daostream/gap,\n   420\t                   :member i}\n   421\t                  :else (throw (ex-info \"unexpected stream signal\"\n   422\t                                        {:signal res, :member i})))))))))))\n","exit_code":0,"status":"completed"}}
