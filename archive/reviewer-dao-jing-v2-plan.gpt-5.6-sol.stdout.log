{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"sed -n '261,476p' src/cljc/dao/stream/rpc.cljc | nl -ba -v261\"","aggregated_output":"   261\t   that allocates ids from this state must not submit new work while it holds:\n   262\t   `request!` retries the unsent envelope and ignores the operation it is given.\"\n   263\t  [state]\n   264\t  (some? (:unsent state)))\n   265\t\n   266\t\n   267\t(defn abandon-unsent\n   268\t  \"Give up on an allocated-but-unsent request, appending its completion with\n   269\t   `reason`.\n   270\t\n   271\t   A composition that changes what the writer *is* — an operator disconnect, a\n   272\t   rebind onto a fresh attachment — owns the decision that the retained\n   273\t   envelope no longer belongs to the new binding.  Abandoning it here reports\n   274\t   the loss on the ordinary completion path, so it is neither silently dropped\n   275\t   nor resent in place of the caller's next request.  The id is retired with\n   276\t   it; `:next-id` never goes back.\"\n   277\t  ([state] (abandon-unsent state :dao.stream.rpc/abandoned))\n   278\t  ([state reason]\n   279\t   (if-let [request (:unsent state)]\n   280\t     (-> state\n   281\t         (assoc :unsent nil)\n   282\t         (append-completion request :reason reason))\n   283\t     state)))\n   284\t\n   285\t\n   286\t;; =============================================================================\n   287\t;; Response decoding and correlation\n   288\t;; =============================================================================\n   289\t\n   290\t(defn- normalize-event\n   291\t  [value]\n   292\t  (cond\n   293\t    (nil? value) (ignore-event)\n   294\t    (apply/response? value) (response-event value)\n   295\t    (contains? lifecycle-values value) (lifecycle-event value)\n   296\t    (and (map? value) (keyword? (get value event-key))) value\n   297\t    :else (diagnostic-event :dao.stream.rpc/malformed-response value)))\n   298\t\n   299\t\n   300\t(defn- decode-value\n   301\t  [state value]\n   302\t  (try\n   303\t    (normalize-event (if-let [decode (:decode state)] (decode value) value))\n   304\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   305\t      (diagnostic-event :dao.stream.rpc/decode-error value))))\n   306\t\n   307\t\n   308\t(defn- lose-outstanding\n   309\t  [state reason terminal?]\n   310\t  (let [state (reduce (fn [s [id request]]\n   311\t                        (append-completion s (assoc request :id id) :reason reason))\n   312\t                      state\n   313\t                      (:outstanding state))]\n   314\t    (cond-> (assoc state :outstanding {})\n   315\t      terminal? (assoc :terminal reason))))\n   316\t\n   317\t\n   318\t(defn handle-event\n   319\t  \"Apply one decoded RPC event to explicit client state.\n   320\t\n   321\t   Transport adapters use `response-event`, `lifecycle-event`,\n   322\t   `diagnostic-event`, and `ignore-event`; raw bare apply responses are also\n   323\t   accepted.  This function has no cursor operation and is useful for testing\n   324\t   adapters independently from a response medium.\"\n   325\t  [state event]\n   326\t  (let [event (normalize-event event)\n   327\t        kind (get event event-key)]\n   328\t    (cond\n   329\t      ;; A terminal binding cannot complete an old request later.  Keep the\n   330\t      ;; event as diagnostic data rather than silently treating it as a reply.\n   331\t      (:terminal state)\n   332\t      (let [state (append-diagnostic state :dao.stream.rpc/event-after-terminal event)]\n   333\t        (rpc-result :dao.stream.rpc/diagnostic state\n   334\t                    :dao.stream.rpc/diagnostic (last (:diagnostics state))))\n   335\t\n   336\t      (= kind :dao.stream.rpc/ignore)\n   337\t      (rpc-result :dao.stream.rpc/ignored state)\n   338\t\n   339\t      (= kind :dao.stream.rpc/diagnostic)\n   340\t      (let [diagnostic (get event diagnostic-key)\n   341\t            state (append-diagnostic state (get diagnostic code-key) diagnostic)]\n   342\t        (rpc-result :dao.stream.rpc/diagnostic state\n   343\t                    :dao.stream.rpc/diagnostic (last (:diagnostics state))))\n   344\t\n   345\t      (= kind :dao.stream.rpc/response)\n   346\t      (let [response (get event response-key)]\n   347\t        (if-not (apply/response? response)\n   348\t          (handle-event state (diagnostic-event :dao.stream.rpc/malformed-response response))\n   349\t          (let [id (apply/response-id response)]\n   350\t            (if-let [request (get (:outstanding state) id)]\n   351\t              (let [state (-> state\n   352\t                              (update :outstanding dissoc id)\n   353\t                              (append-completion (assoc request :id id)\n   354\t                                                 :response response))]\n   355\t                (rpc-result :dao.stream.rpc/responded state\n   356\t                            :dao.stream.rpc/id id\n   357\t                            :dao.stream.rpc/response response))\n   358\t              (handle-event state\n   359\t                            (diagnostic-event :dao.stream.rpc/unsolicited-response response))))))\n   360\t\n   361\t      (= kind :dao.stream.rpc/lifecycle)\n   362\t      (let [lifecycle (get event lifecycle-key)]\n   363\t        (case lifecycle\n   364\t          :dao.stream.apply/established\n   365\t          (rpc-result :dao.stream.rpc/established state)\n   366\t\n   367\t          :dao.stream.apply/diagnostic\n   368\t          (handle-event state (diagnostic-event :dao.stream.rpc/transport-diagnostic event))\n   369\t\n   370\t          :dao.stream.apply/detached\n   371\t          (let [state (lose-outstanding state lifecycle true)]\n   372\t            (rpc-result :dao.stream.rpc/lost state :dao.stream.rpc/reason lifecycle))\n   373\t\n   374\t          (:dao.stream.apply/ended\n   375\t            :dao.stream.apply/not-found\n   376\t            :dao.stream.apply/transport-error)\n   377\t          (let [state (lose-outstanding state lifecycle true)]\n   378\t            (rpc-result :dao.stream.rpc/lost state :dao.stream.rpc/reason lifecycle))\n   379\t\n   380\t          (handle-event state (diagnostic-event :dao.stream.rpc/unhandled-event event))))\n   381\t\n   382\t      :else\n   383\t      (handle-event state (diagnostic-event :dao.stream.rpc/unhandled-event event)))))\n   384\t\n   385\t\n   386\t(defn- poll-read\n   387\t  [state]\n   388\t  (let [read-result (valid-operation-result :next (stream/next (:reader state) (:cursor state)))\n   389\t        outcome (:dao.stream/outcome read-result)]\n   390\t    (case outcome\n   391\t      :dao.stream/ok\n   392\t      ;; Advance before decoding. A malformed or unsolicited element is thereby\n   393\t      ;; consumed exactly once and cannot poison polling.\n   394\t      (handle-event (assoc state :cursor (:dao.stream/cursor read-result))\n   395\t                    (decode-value state (:dao.stream/value read-result)))\n   396\t\n   397\t      :dao.stream/blocked\n   398\t      (rpc-result :dao.stream.rpc/idle state :dao.stream.rpc/read read-result)\n   399\t\n   400\t      :dao.stream/gap\n   401\t      (let [state (-> state\n   402\t                      (assoc :cursor (:dao.stream/cursor read-result))\n   403\t                      (lose-outstanding :dao.stream/gap false))]\n   404\t        (rpc-result :dao.stream.rpc/lost state\n   405\t                    :dao.stream.rpc/reason :dao.stream/gap\n   406\t                    :dao.stream.rpc/read read-result))\n   407\t\n   408\t      (:dao.stream/end :dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n   409\t                       :dao.stream/transport-error)\n   410\t      (let [state (lose-outstanding state outcome true)]\n   411\t        (rpc-result :dao.stream.rpc/lost state\n   412\t                    :dao.stream.rpc/reason outcome\n   413\t                    :dao.stream.rpc/read read-result))\n   414\t\n   415\t      (let [state (lose-outstanding state :dao.stream/transport-error true)]\n   416\t        (rpc-result :dao.stream.rpc/lost state\n   417\t                    :dao.stream.rpc/reason :dao.stream/transport-error\n   418\t                    :dao.stream.rpc/read read-result)))))\n   419\t\n   420\t\n   421\t(defn poll!\n   422\t  \"Read at most `budget` response-medium elements.\n   423\t\n   424\t   A `:dao.stream/blocked` result yields immediately; this function never loops\n   425\t   waiting for a response.  Each successful read installs the exact successor\n   426\t   cursor returned by that handle before decoding the element.\"\n   427\t  ([state] (poll! state 1))\n   428\t  ([state budget]\n   429\t   (cond\n   430\t     (:terminal state) (rpc-result :dao.stream.rpc/terminal state)\n   431\t     (not (and (integer? budget) (pos? budget)))\n   432\t     (rpc-result :dao.stream.rpc/idle state)\n   433\t     :else\n   434\t     (loop [remaining budget\n   435\t            state state\n   436\t            last-result nil]\n   437\t       (if (zero? remaining)\n   438\t         (or last-result (rpc-result :dao.stream.rpc/idle state))\n   439\t         (let [result (poll-read state)\n   440\t               next-state (:dao.stream.rpc/state result)\n   441\t               outcome (:dao.stream.rpc/outcome result)]\n   442\t           (if (or (:terminal next-state)\n   443\t                   (= outcome :dao.stream.rpc/idle))\n   444\t             result\n   445\t             (recur (dec remaining) next-state result))))))))\n   446\t\n   447\t\n   448\t(defn take-completed\n   449\t  \"Return `[completions next-state]`, clearing the unpublished completion\n   450\t   outbox exactly once.  The caller owns publication and must call this only\n   451\t   from its single state-owning driver step.\"\n   452\t  [state]\n   453\t  [(:completed state) (assoc state :completed [])])\n   454\t\n   455\t\n   456\t(defn take-diagnostics\n   457\t  \"Return `[diagnostics next-state]`, clearing the unpublished diagnostic outbox\n   458\t   exactly once.  Diagnostics are bounded by publication exactly as completions\n   459\t   are: a noisy shared response medium can produce one per read, so a caller\n   460\t   that never publishes would grow this vector for the session's lifetime.\"\n   461\t  [state]\n   462\t  [(:diagnostics state) (assoc state :diagnostics [])])\n   463\t\n   464\t\n   465\t(defn rebind\n   466\t  \"Replace a detached client's writer (and optionally reader) without creating\n   467\t   a cursor or replacing its monotonic id allocator. Only `/detached` is\n   468\t   reconnectable; other terminal reasons remain terminal.\"\n   469\t  ([state writer me]\n   470\t   (if (= :dao.stream.apply/detached (:terminal state))\n   471\t     (assoc state :writer writer :me me :terminal nil)\n   472\t     state))\n   473\t  ([state writer reader me]\n   474\t   (if (= :dao.stream.apply/detached (:terminal state))\n   475\t     (assoc state :writer writer :reader reader :me me :terminal nil)\n   476\t     state)))\n","exit_code":0,"status":"completed"}}
