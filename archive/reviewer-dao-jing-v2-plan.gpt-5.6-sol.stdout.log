ported-and-never-auto-resynced\n   481\t  (testing\n   482\t    \"a cursor behind the retention boundary reports :daostream/gap\n   483\t            immediately, leaves its cursor unchanged, is never resynced, and\n   484\t            does not starve the rest of the pool\"\n   485\t    (let [h (mem-handle)\n   486\t          a (ds/open! {:dao.stream/type :ringbuffer,\n   487\t                       :capacity 2,\n   488\t                       :eviction-policy :evict-oldest})\n   489\t          _ (ds/append! a {:evicted 1})\n   490\t          _ (ds/append! a {:evicted 2})\n   491\t          _ (ds/append! a {:live 3})\n   492\t          b (open-stream {:payload :ready})\n   493\t          state (jing/observer-state [a b])\n   494\t          r1 (jing/observe-step! h state)]\n   495\t      (is (= :daostream/gap (:signal r1)))\n   496\t      (is (= 0 (:member r1)))\n   497\t      (is (= {:position 0} (get-in (:state r1) [:members 0 :cursor]))\n   498\t          \"the gap leaves the cursor unchanged\")\n   499\t      (is (= :daostream/gap (get-in (:state r1) [:members 0 :status])))\n   500\t      (let [r2 (jing/observe-step! h (:state r1))]\n   501\t        (is (= :ok (:signal r2)))\n   502\t        (is (= {:payload :ready} (jing/get h (:address r2) ::missing)))\n   503\t        (let [r3 (jing/observe-step! h (:state r2))]\n   504\t          (is (= :daostream/gap (:signal r3)))\n   505\t          (is (= {:position 0} (get-in (:state r3) [:members 0 :cursor]))\n   506\t              \"the gap persists: the cursor is never auto-resynchronized\"))))))\n   507\t\n   508\t\n   509\t(deftest observer-rejects-malformed-stream-maps\n   510\t  (testing\n   511\t    \"a map from ds/next is a successful read only when it explicitly\n   512\t            carries both :ok and :cursor; malformed maps throw instead of\n   513\t            content-addressing nil or installing a nil cursor\"\n   514\t    (let [h (mem-handle)]\n   515\t      (doseq [bad [{} {:ok nil} {:ok :payload} {:cursor