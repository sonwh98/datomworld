0\t     symbol            -> :variable\n    11\t     (fn [params] b)   -> :lambda\n    12\t     (if t c a)        -> :if\n    13\t     (do a b ... z)    -> sequencing through one-parameter lambdas\n    14\t     (let [x v ...] b) -> nested immediately applied lambdas\n    15\t     (quote x)         -> :literal x\n    16\t     (%capture)        -> :vm/current-continuation\n    17\t     (yin/def k v)     -> the definition application\n    18\t     (f a ...)         -> :application\n    19\t     any other value   -> :literal\"\n    20\t  (:require\n    21\t    [yang.tails :as tails]))\n    22\t\n    23\t\n    24\t(defn lit\n    25\t  [x]\n    26\t  {:type :literal, :value x})\n    27\t\n    28\t\n    29\t(defn v\n    30\t  [sym]\n    31\t  {:type :variable, :name sym})\n    32\t\n    33\t\n    34\t(defn lam\n    35\t  [params body]\n    36\t  {:type :lambda, :params (vec params), :body body})\n    37\t\n    38\t\n    39\t(defn app\n    40\t  [op & args]\n    41\t  {:type :application, :operator op, :operands (vec args)})\n    42\t\n    43\t\n    44\t(defn if-node\n    45\t  [t c a]\n    46\t  {:type :if, :test t, :consequent c, :alternate a})\n    47\t\n    48\t\n    49\t(def capture {:type :vm/current-continuation})\n    50\t\n    51\t\n    52\t(defn def!\n    53\t  \"`(yin/def key value)`: key is a literal symbol.\"\n    54\t  [key value]\n    55\t  (app (v 'yin/def) (lit key) value))\n    56\t\n    57\t\n    58\t(def discard\n    59\t  \"The parameter a sequencing lambda binds and ignores. `%` cannot begin a\n    60\t   Python identifier, so it never shadows a guest name.\"\n    61\t  '%_)\n    62\t\n    63\t\n    64\t(defn then\n    65\t  \"Evaluate `a` for effect, then `b`.\"\n    66\t  [a b]\n    67\t  (app (lam [discard] b) a))\n    68\t\n    69\t\n    70\t(defn seq-nodes\n    71\t  \"Evaluate every node in order; the value is the last one's.\"\n    72\t  [nodes]\n    73\t  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n    74\t\n    75\t\n    76\t(defn let1\n    77\t  [sym value body]\n    78\t  (app (lam [sym] body) value))\n    79\t\n    80\t\n    81\t(defn sexp->uast\n    82\t  [form]\n    83\t  (cond\n    84\t    (symbol? form) (v form)\n    85\t    (seq? form)\n    86\t    (let [[head & args] form]\n    87\t      (case head\n    88\t        fn (lam (first args) (sexp->uast (second args)))\n    89\t        if (if-node (sexp->uast (first args))\n    90\t                    (sexp->uast (second args))\n    91\t                    (sexp->uast (nth args 2)))\n    92\t        do (seq-nodes (map sexp->uast args))\n    93\t        let (let [[bindings body] args]\n    94\t              (reduce (fn [inner [sym value]]\n    95\t                        (let1 sym (sexp->uast value) inner))\n    96\t                      (sexp->uast body)\n    97\t                      (reverse (partition 2 bindings))))\n    98\t        quote (lit (first args))\n    99\t        %capture capture\n   100\t        (apply app (sexp->uast head) (map sexp->uast args))))\n","exit_code":0,"status":"completed"}}
