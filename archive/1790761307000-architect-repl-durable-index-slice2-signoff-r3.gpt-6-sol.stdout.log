sal)))\n   652\t           (is (= record (read-text! (head-path dir)))\n   653\t               \"HEAD holds the whole record, never a short write's prefix\"))\n   654\t         (finally\n   655\t           (set! (.-writeSync node-fs) original)\n   656\t           (cleanup-dir! dir))))))\n   657\t\n   658\t\n   659\t(defn- set-dir-readable!\n   660\t  \"Grant or take away read permission on the directory: without it the\n   661\t   directory can still be written into and renamed within, but not\n   662\t   opened — so its sync fails while the HEAD rename succeeds.\"\n   663\t  [dir readable?]\n   664\t  #?(:cljd (.runSync dart-io/Process \"chmod\" [(if readable? \"755\" \"300\") dir])\n   665\t     :clj (.setReadable (java.io.File. ^String dir) (boolean readable?) false)\n   666\t     :cljs (.chmodSync (js/require \"fs\") dir (if readable? 493 192))))\n   667\t\n   668\t\n   669\t(deftest a-failed-directory-sync-fails-the-head-replacement\n   670\t  (let [dir (temp-dir)]\nsrc/cljc/yin/repl/store/fs.cljc:294:     \"Write every byte of `buf` to `fd`.  `writeSync` may store fewer\nsrc/cljc/yin/repl/store/fs.cljc:298:      and Dart's `writeAsStringSync` write the whole buffer or throw.)\"\nsrc/cljc/yin/repl/store/fs.cljc:302:         (let [written (.writeSync ^js fs fd buf offset\nsrc/cljc/yin/repl/store/fs.cljc:325:     #?(:cljd (try (.writeAsStringSync (dart-io/File. temp) text .flush true)\nsrc/cljc/yin/repl/store/fs.cljc:332:        :clj (try (with-open [out (java.io.FileOutputStream. ^String temp)]\nsrc/cljc/dao/jing/file.cljc:159:(defn- open-file!\nsrc/cljc/dao/jing/file.cljc:235:             (.writeSync ^js fs fd head)\nsrc/cljc/dao/jing/file.cljc:236:             (.writeSync ^js fs fd frame))\nsrc/cljc/dao/jing/file.cljc:242:             (.writeFromSync raf (.asUint8List (.-buffer head)))\nsrc/cljc/dao/jing/file.cljc:243:             (.writeFromSync raf frame))))\n","exit_code":0,"status":"completed"}}
