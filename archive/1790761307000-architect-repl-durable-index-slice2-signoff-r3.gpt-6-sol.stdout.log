close!\n+  \"Release the store's lifecycle resources — the content log handle and,\n+   in durable mode, the directory lock.  Nothing further can be read or\n+   written through the handle afterwards.  Idempotent.\"\n+  [store]\n+  (when-let [close! (:close-fn store)]\n+    (close!)))\n     1\t(ns yin.repl.store.fs\n     2\t  \"Explicit host file operations for the durable index store directory\n     3\t   (docs/design/yin.repl.dao.space-index.md, the durable-store design's\n     4\t   host section): an exclusive directory lock held by the one process\n     5\t   that owns the store, and an atomic write-temp, sync, rename\n     6\t   replacement for HEAD. CLJ, Node, and Dart each implement them with\n     7\t   their own primitives; nothing here falls back silently.\n     8\t\n     9\t   Lock ownership is an operating-system fact on the JVM — an exclusive\n    10\t   `FileChannel` lock on `<dir>/lock`, released when the holding process\n    11\t   dies — and on Dart, `RandomAccessFile.lockSync`. Node has no flock in\n    12\t   its core, so each contender creates its own uniquely named claim\n    13\t   entry, `lock.<pid>.<nonce>`, and then reads the others: a live one\n    14\t   refuses, and a dead one — an owner or a contender that crashed at any\n    15\t   point — is removed without a race, because a unique name is never\n    16\t   created again.  A crashed process never bricks the directory, and two\n    17\t   contenders never both own it (`node-lock!`).\n    18\t\n    19\t   HEAD replacement writes the whole record to a temp file in the same\n    20\t   directory — every byte of it, however many writes the host takes —\n    21\t   syncs it, and renames it over HEAD — rename is the atomicity, so a\n    22\t   torn, short, or interrupted write is never observed as HEAD.\n    23\t   The directory itself is then synced where the host can\n    24\t   (`directory-sync-supported?`: Node and the JVM on POSIX systems), and\n    25\t   there a failed sync fails the replacement; a host that cannot sync a\n    26\t   directory at all (Dart's core, Windows) is not a failed sync.\n    27\t\n    28\t   The operating-system locks are per process — a POSIX `fcntl` lock\n    29\t   never refuses its own process — so this process's own holdings are\n    30\t   kept here too, in `held`: a second owner inside the one process is\n    31\t   refused by that record before any second handle on the lock file is\n    32\t   opened.  `held` is process-global mutable state, an explicit\n    33\t   exception to the no-hidden-global-state invariant: it mirrors a fact\n    34\t   the host itself keeps per process (which files this process has\n    35\t   locked), so it can be no narrower than the process, and it holds\n    36\t   nothing but the canonical paths of the directories this process\n    37\t   currently owns.\"\n    38\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n    39\t            [clojure.string :as str]))\n    40\t\n    41\t\n    42\t(def lock-name\n    43\t  \"The lock file's own name inside the durable store directory, and the\n    44\t   prefix of Node's claim entries (`lock.<pid>.<nonce>`).  Its presence\n    45\t   is bookkeeping, never authority: the JVM and Dart locks live on open\n    46\t   handles, and each Node entry names a pid that is checked for life.\"\n    47\t  \"lock\")\n    48\t\n    49\t\n    50\t(defn- refuse-locked\n    51\t  [dir]\n    52\t  (throw (ex-info (str dir \" is locked by another process\")\n    53\t                  {:dir dir})))\n    54\t\n    55\t\n    56\t(defn- read-text!\n    57\t  \"The file at `path` as text — trimmed, for one-record files read whole —\n    58\t   or nil when absent.\"\n    59\t  [path]\n    60\t  #?(:cljd (let [f (dart-io/File. path)]\n    61\t             (when (.existsSync f)\n    62\t               (str/trim (.readAsStringSync f))))\n    63\t     :clj (let [f (java.io.File. ^String path)]\n    64\t            (when (.exists f) (str/trim (slurp f))))\n    65\t     :cljs (let [fs (js/require \"fs\")]\n    66\t             (when (.existsSync ^js fs path)\n    67\t               (str/trim (.readFileSync ^js fs path \"utf8\"))))))\n    68\t\n    69\t\n    70\t#?(:cljs\n    71\t   (defn- live-pid?\n    72\t     \"True when a pid names a live process — the lock file's owner is\n    73\t      alive.  A process this one may not signal (`EPERM`) is alive too.\"\n    74\t     [pid]\n    75\t     (try (.kill js/process pid 0)\n    76\t          true\n    77\t          (catch :default e\n    78\t            (= \"EPERM\" (.-code e))))))\n    79\t\n    80\t\n    81\t#?(:cljs\n    82\t   (defn- claim-entries\n    83\t     \"Every Node claim entry in the directory, as `[file-name pid]`: the\n    84\t      files `lock.<pid>.<nonce>`, each created by the one process whose\n    85\t      pid it names.\"\n    86\t     [fs dir]\n    87\t     (keep (fn [file-name]\n    88\t             (when-some [[_ pid] (re-matches #\"lock\\.(\\d+)\\.[0-9a-f-]+\"\n    89\t                                             file-name)]\n    90\t               [file-name (js/parseInt pid 10)]))\n    91\t           (.readdirSync ^js fs dir))))\n    92\t\n    93\t\n    94\t#?(:cljs\n    95\t   (defn- node-lock!\n    96\t     \"Claim the directory on Node, answering the release, or refuse.\n    97\t\n    98\t      Each contender creates its own uniquely named claim entry,\n    99\t      `lock.<pid>.<nonce>`, and only then reads the others.  An entry\n   100\t      naming a live process is an owner or a rival contender: the claim\n   101\t      is withdrawn and refused.  An entry naming a dead process — an\n   102\t      owner that crashed, or a contender that crashed midway through its\n   103\t      own claim — is removed, and that removal is race-free because the\n   104\t      name is unique: no later process ever creates it again, so it can\n   105\t      never be a newer live claim.  Of two contenders, each creates\n   106\t      before it reads, so at most one reads no live rival; at worst two\n   107\t      simultaneous starts both refuse, never both own.  An entry naming\n   108\t      this very pid is a previous process's leftover — `held` has already\n   109\t      established that this process does not hold the directory.\"\n   110\t     [dir claimed]\n   111\t     (let [fs (js/require \"fs\")\n   112\t           own-pid (.-pid js/process)\n   113\t           own (str lock-name \".\" own-pid \".\" (random-uuid))\n   114\t           own-path (str dir \"/\" own)\n   115\t           release! (fn []\n   116\t                      (try (.unlinkSync ^js fs own-path)\n   117\t                           (catch :default _ nil)))]\n   118\t       (.closeSync ^js fs (.openSync ^js fs own-path \"wx\"))\n   119\t       (try\n   120\t         (when claimed (claimed))\n   121\t         (let [live (into []\n   122\t                          (remove\n   123\t                            (fn [[file-name pid]]\n   124\t                              (when (or (= own-pid pid) (not (live-pid? pid)))\n   125\t                                (try (.unlinkSync ^js fs (str dir \"/\" file-name))\n   126\t                                     (catch :default _ nil))\n   127\t                                true)))\n   128\t                          (remove #(= own (first %)) (claim-entries fs dir)))]\n   129\t           (when (seq live)\n   130\t             (refuse-locked dir))\n   131\t           release!)\n   132\t         (catch :default e\n   133\t           (release!)\n   134\t           (throw e))))))\n   135\t\n   136\t\n   137\t(defonce ^:private held\n   138\t  ;; The host-ownership exception to the no-hidden-global-state invariant\n   139\t  ;; (see the namespace docstring): the canonical paths of the durable\n   140\t  ;; directories this process holds locked.\n   141\t  (atom #{}))\n   142\t\n   143\t\n   144\t(defn- canonical-dir\n   145\t  \"The directory's one canonical path: the key of this process's own\n   146\t   holdings, so two spell