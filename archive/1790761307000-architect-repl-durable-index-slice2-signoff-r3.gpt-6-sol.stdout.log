close f)\n   188\t                      (refuse-locked dir))\n   189\t                  (fn []\n   190\t                    (try (.release ^java.nio.channels.FileLock fl)\n   191\t                         (catch Exception _ nil))\n   192\t                    (try (.close f)\n   193\t                         (catch Exception _ nil)))))\n   194\t              (catch Throwable t\n   195\t                (try (.close f) (catch Exception _ nil))\n   196\t                (throw t))))\n   197\t     :cljs (node-lock! dir claimed)))\n   198\t\n   199\t\n   200\t(defn lock!\n   201\t  \"Acquire the exclusive lock of the durable store directory, or refuse\n   202\t   naming the directory — whether the other owner is another process or\n   203\t   this one. The answer is a plain release; closing whatever the host\n   204\t   needs closed is all releasing takes.\n   205\t\n   206\t   `claimed`, `(fn [])`, runs on Node once this process's claim entry\n   207\t   exists and before it reads the others — the window a concurrent\n   208\t   contender can race — so the tests can interleave one there.\"\n   209\t  ([dir] (lock! dir {}))\n   210\t  ([dir {:keys [claimed]}]\n   211\t   (let [key (canonical-dir dir)]\n   212\t     (when-not (claim! key)\n   213\t       (refuse-locked dir))\n   214\t     (let [release! (try (host-lock! dir (str dir \"/\" lock-name) claimed)\n   215\t                         (catch #?(:cljd Object\n   216\t                                   :clj Throwable\n   217\t                                   :cljs :default)\n   218\t                                e\n   219\t                           (swap! held disj key)\n   220\t                           (throw e)))\n   221\t           released? (volatile! false)]\n   222\t       {:release! (fn []\n   223\t                    (when-not @released?\n   224\t                      (vreset! released? true)\n   225\t                      (release!)\n   226\t                      (swap! held disj key)))}))))\n   227\t\n