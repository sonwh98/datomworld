(def uast\n  1517\t  \"The whole prelude: function definitions, then runtime state.\"\n  1518\t  (u/then functions-uast (definitions->uast state-definitions)))\n  1519\t\n  1520\t\n  1521\t(def builtin-names\n  1522\t  \"Python builtin name -> the prelude store key holding it.\"\n  1523\t  (into {\"len\" 'py.b/len,\n  1524\t         \"isinstance\" 'py.b/isinstance,\n  1525\t         \"print\" 'py.b/print,\n  1526\t         \"range\" 'py.b/range,\n  1527\t         \"list\" 'py.b/list,\n  1528\t         \"tuple\" 'py.b/tuple,\n  1529\t         \"set\" 'py.b/set,\n  1530\t         \"sum\" 'py.b/sum,\n  1531\t         \"any\" 'py.b/any,\n  1532\t         \"all\" 'py.b/all}\n  1533\t        (map (fn [[nm key _]] [nm key]))\n  1534\t        builtin-classes))\n","exit_code":0,"status":"completed"}}
