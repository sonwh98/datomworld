\t   [\"BaseException\" 'py.b/BaseException 'py.b/object]\n  1413\t   [\"Exception\" 'py.b/Exception 'py.b/BaseException]\n  1414\t   [\"ArithmeticError\" 'py.b/ArithmeticError 'py.b/Exception]\n  1415\t   [\"ZeroDivisionError\" 'py.b/ZeroDivisionError 'py.b/ArithmeticError]\n  1416\t   [\"LookupError\" 'py.b/LookupError 'py.b/Exception]\n  1417\t   [\"IndexError\" 'py.b/IndexError 'py.b/LookupError]\n  1418\t   [\"KeyError\" 'py.b/KeyError 'py.b/LookupError]\n  1419\t   [\"TypeError\" 'py.b/TypeError 'py.b/Exception]\n  1420\t   [\"ValueError\" 'py.b/ValueError 'py.b/Exception]\n  1421\t   [\"AttributeError\" 'py.b/AttributeError 'py.b/Exception]\n  1422\t   [\"NameError\" 'py.b/NameError 'py.b/Exception]\n  1423\t   [\"UnboundLocalError\" 'py.b/UnboundLocalError 'py.b/NameError]\n  1424\t   [\"RuntimeError\" 'py.b/RuntimeError 'py.b/Exception]\n  1425\t   [\"NotImplementedError\" 'py.b/NotImplementedError 'py.b/RuntimeError]\n  1426\t   [\"OverflowError\" 'py.b/OverflowError 'py.b/ArithmeticError]])\n  1427\t\n  1428\t\n  1429\t(def ^:private builtin-function-definitions\n  1430\t  \"Builtin functions are function objects like any guest function, so they\n  1431\t   can be passed, stored, called with keywords and checked for arity\n  1432\t   through `py/call-kw`.\"\n  1433\t  '[[py.b/len\n  1434\t     (py/make-function \"len\" {:params [\"obj\"], :no-kw true} [] []\n  1435\t                       (fn [args] (py/len (py/arg args 0))))]\n  1436\t    [py.b/isinstance\n  1437\t     (py/make-function \"isinstance\" {:params [\"obj\" \"cls\"], :no-kw true} [] []\n  1438\t                       (fn [args] (py/isinstance (py/arg args 0) (py/arg args 1))))]\n  1439\t    [py.b/print\n  1440\t     (py/make-function \"print\" {:params [], :star? true, :no-kw true} [] []\n  1441\t                       (fn [args] (py/print (get (py/arg args 0) :items))))]\n  1442\t    [py.b/range\n  1443\t     (py/make-function \"range\" {:params [\"start\"], :star? true, :no-kw true} [] []\n  1444\t                       (fn [args] (py/range-args (py/arg args 0) (py/arg args 1))))]\n  1445\t    [py.b/list\n  1446\t     (py/make-function \"list\" {:params [\"iterable\"], :no-kw true} [(py/tuple [])] []\n  1447\t                       (fn [args] (py/list (py/to-vector (py/arg args 0)))))]\n  1448\t    [py.b/tuple\n  1449\t     (py/make-function \"tuple\" {:params [\"iterable\"], :no-kw true} [(py/tuple [])] []\n  1450\t                       (fn [args] (py/tuple (py/to-vector (py/arg args 0)))))]\n  1451\t    [py.b/set\n  1452\t     (py/make-function \"set\" {:params [\"iterable\"], :no-kw true} [(py/tuple [])] []\n  1453\t                       (fn [args] (py/set-from (py/to-vector (py/arg args 0)))))]\n  1454\t    [py.b/sum\n  1455\t     (py/make-function \"sum\" {:params [\"iterable\" \"start\"]} [0] []\n  1456\t                       (fn [args]\n  1457\t                         (py/sum-from (py/to-vector (py/arg args 0)) 0\n  1458\t                                      (py/arg args 1))))]\n  1459\t    [py.b/any\n  1460\t     (py/make-function \"any\" {:params [\"iterable\"], :no-kw true} [] []\n  1461\t                       (fn [args] (py/any-of (py/to-vector (py/arg args 0)) 0)))]\n  1462\t    [py.b/all\n  1463\t     (py/make-function \"all\" {:params [\"iterable\"], :no-kw true} [] []\n  1464\t                       (fn [args] (py/all-of (py/to-vector (py/arg args 0)) 0)))]\n  1465\t    [py.b/list-append\n  1466\t     (py/make-function \"append\" {:params [\"self\" \"x\"], :no-kw true} [] []\n  1467\t                       (fn [args] (py/list-append (py/arg args 0) (py/arg args 1))))]\n  1468\t    [py.b/set-add\n  1469\t     (py/make-function \"add\" {:params [\"self\" \"x\"], :no-kw true} [] []\n  1470\t                       (fn [args] (py/set-add (py/arg args 0) (py/arg args 1))))]\n  1471\t    [py.b/dict-items\n  1472\t     (py/make-function \"items\" {:params [\"self\"], :no-kw true} [] []\n  1473\t                       (fn [args] (py/dict-i