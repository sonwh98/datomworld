{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat test/resources/yang/python/dht-import-v1.generate.clj; cat test/yang/python/antlr/linked_harness.cljc; cat test/yang/python/antlr/dht_import_fixture.cljc'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'cat test/resources/yang/python/dht-import-v1.generate.clj; cat test/yang/python/antlr/linked_harness.cljc; cat test/yang/python/antlr/dht_import_fixture.cljc'","aggregated_output":";; Generator of test/resources/yang/python/dht-import-v1.edn.\n;;\n;; Provenance: the JVM publication of C4 slice I3's DHT import\n;; (yang.python.antlr.dht-import-fixture). Run from the repository root\n;; on the JVM, with the test paths on the classpath, to rewrite the\n;; artifact:\n;;\n;;   clojure -Sdeps '{:aliases {:t {:extra-paths [\"test\"]}}}' -M:t \\\n;;    test/resources/yang/python/dht-import-v1.generate.clj\n;;\n;; (not -A:test: that alias's main is the test runner and runs the suite)\n;;\n;; It publishes the committed CST packets of the guest units through\n;; `yang.python.antlr.publication` against `py` as the JVM publishes it,\n;; signs the name envelopes with the fixture's fixed test seeds, and\n;; writes the guest blobs, the manifest addresses, the envelopes and the\n;; importer packets. Every input is checked in, and Ed25519 signatures are\n;; deterministic, so a rerun on an unchanged tree rewrites the same data.\n;; Rerun it whenever the prelude, the lowering or the linker's\n;; publication moves an address; `dht-import-test` fails until it is.\n\n(require '[yang.python.antlr.dht-import-fixture :as fixture])\n\n\n(let [{:keys [lines refused]} (fixture/generate)]\n  (when refused\n    (throw (ex-info \"the artifact's publication was refused\" refused)))\n  (spit fixture/path (fixture/text lines))\n  (println \"wrote\" fixture/path))\n(ns yang.python.antlr.linked-harness\n  \"The linked profile's composition for the Python tests (C4 slices P2\n   and P3, docs/design/yang.antlr.md 8.5.6): the namespace that requires\n   this is the publisher of `py` and `pysp`, so it publishes each module\n   once per process into one in-memory content store and serves them to\n   every linked run over a `yin.vm.linker.interpreter` composition under\n   `:trusted` derivation (the remediation ruling's R6). The `:verifying`\n   evidence is `publish-module!`'s own `link-local` links, which\n   `linked-prelude-test` asserts.\n\n   A linked run builds the program's task on one of the three vector VMs\n   with a link pair, then runs the VM and serves the pair alternately\n   until the VM stops blocking, as the REPL's drive does. The AST walker\n   is not a backend here: its link of `py` is refused `:undeclared-free`\n   until L-b.\"\n  (:require [yin.vm.semantic.linearize :as sr-linearize]\n            [yin.vm.semantic.derive :as derive]\n            [dao.jing.mem :as mem]\n            [yang.python.antlr.prelude :as prelude]\n            [yang.python.antlr.safepoint :as safepoint]\n            [yin.vm :as vm]\n            [yin.vm.data :as data]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.register :as rvm]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.integer :as integer]\n            [yin.vm.linker.interpreter :as link]\n            [yin.vm.linker.publish :as publish]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(def integer-limits\n  \"The ordinary Python composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked Python composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `pysp` polls a signal stream, so the\n   safepointed composition needs it even though `py` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`py` published once into its own content store:\n   `{:store s :result r :address a}`, `r` `publish-module!`'s answer.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(def published-pysp\n  \"`pysp` published once into `py`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{py <address>}`, derivation `:trusted`, the test being the\n   publisher. `pysp`-serving sources pass their own `name-env`, the\n   safepointed runs' `{'py a :pysp b}` both.\"\n  ([] (source {'py (:address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition over both published modules: `pysp` requires\n   `py`, so a safepointed linked run resolves both names.\"\n  []\n  (source {'py (:address @published), 'pysp (:address @published-pysp)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `py`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `py`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n               (semantic/load-ast (semantic/create-vm opts)\n                                  (vm/ast->datoms ast)\n                                  vm/ast-contract)),\n   :stack (fn [ast opts]\n            (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                           (assoc opts :contract vm/stack-contract))),\n   :register (fn [ast opts]\n               (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\n                              (assoc opts :contract vm/register-contract)))})\n\n\n(def continues\n  \"Each vector backend's admission of the next top-level unit to a halted\n   task, as `yin.repl` admits an input line: the task keeps its store,\n   heap, module registry and module stores.\"\n  {:semantic (fn [task ast]\n               (semantic/load-ast task (vm/ast->datoms ast) vm/ast-contract)),\n   :stack (fn [task ast]\n            (let [img (:image (derive/stack-image (:vector (sr-linearize/project ast))))\n                  attached (dvm/attach-image task img vm/stack-contract)]\n              (assoc attached\n                     :pc (dvm/absolute-pc attached [(dcode/image-hash img) 0])\n                     :frames [] :stack [] :continuation []\n                     :halted? false :blocked? false :value nil))),\n   :register (fn [task ast]\n               (let [img (derive/register-image (:vector (sr-linearize/project ast)))\n                     attached (rvm/attach-image task img vm/register-contract)\n                     pc (rvm/absolute-pc attached\n                                         [(rcode/register-hash img) 0])\n                     body (some #(when (= pc (:start %)) %)\n                                (:bodies (:segment attached)))]\n                 (assoc attached\n                        :pc pc :frames [] :continuation []\n                        :registers (vec (repeat (:registers body) nil))\n                        :halted? false :blocked? false :value nil)))})\n\n\n(defn composition\n  \"A task's composition over `modules` and the link `pair`.\"\n  [modules pair]\n  {:make-stream tu/make-stream,\n   :capability-secret tu/secret,\n   :secret-source (fn [origin] (str tu/secret \"/\" (name origin))),\n   :primitives vm/primitives,\n   :modules modules,\n   :link-request (:requests pair),\n   :link-response (:responses pair)})\n\n\n(defn drive\n  \"Run `task` and serve `pair` from `src` alternately until the task\n   stops blocking, at most 40 rounds. Returns `[task pair]`.\"\n  [task pair src]\n  (loop [task (vm/run task)\n         pair pair\n         i 0]\n    (if (and (vm/blocked? task) (< i 40))\n      (let [pair (:pair (link/serve {:pair pair, :source src}))]\n        (recur (vm/run task) pair (inc i)))\n      [task pair])))\n\n\n(defn run-linked\n  \"The finished task of the linked program `ast` on `backend`. Options:\n   `:modules` (default the full registry), `:link-source` (default the\n   `:trusted` composition over `py`), and `:prep`, applied to the task\n   before it runs (a composition handing the task its streams, binding\n   `pysp`'s signal stream among them). A refused link throws as the task's\n   own error.\"\n  ([backend ast] (run-linked backend ast {}))\n  ([backend ast {:keys [modules link-source prep]}]\n   (let [pair (link/make-pair)\n         task ((get backends backend)\n               ast\n               (composition (or modules (registry)) pair))]\n     (first (drive (if prep (prep task) task)\n                   pair (or link-source (source)))))))\n\n\n(defn runners-under\n  \"Each vector VM's runner of a linked program over `modules`: the\n   program's value.\"\n  [modules]\n  (into {}\n        (map (fn [k]\n               [k (fn [ast]\n                    (vm/value (run-linked k ast {:modules modules})))]))\n        (keys backends)))\n\n\n(def runners\n  \"The linked runners under the ordinary limits.\"\n  (runners-under (registry)))\n(ns yang.python.antlr.dht-import-fixture\n  \"The JVM publication artifact of C4 slice I3's DHT import\n   (docs/design/yang.antlr.md 8.5.6): test/resources/yang/python/\n   dht-import-v1.edn, written on the JVM by\n   test/resources/yang/python/dht-import-v1.generate.clj.\n\n   It holds what a publisher `A` publishes and signs: the guest blobs of\n   the units m, k, t and e and of k's republication k2 (every blob of\n   their closures but `py`'s, which each reader has installed), each\n   unit's manifest address, the signed name envelopes of three index\n   transactions -- `A` naming py, m, k and t; `A` retracting k and\n   naming k2; a foreign principal `B` naming e -- and the importer\n   packets the reader lowers. The keys are fixed test seeds, and Ed25519\n   signatures are deterministic, so one host's `generate` is the file\n   byte for byte.\n\n   `yang.python.antlr.dht-import-test` consumes the file on every host\n   without republishing anything, and checks that this host's own\n   `generate` equals it: a host whose publication of the same packets\n   differs from the JVM's fails there.\n\n   One EDN form per line: the magic, the header maps, then one\n   `[address hex]` line per blob in address order.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.string :as str]\n    [dao.jing :as jing]\n    [dao.jing.cbor-fixtures :as cfx]\n    [dao.jing.dht :as jing.dht]\n    [dao.jing.mem :as mem]\n    [yang.python.antlr.import-programs :as programs]\n    [yang.python.antlr.linked-harness :as h]\n    [yang.python.antlr.publication :as publication]\n    [yin.vm.linker.closure :as closure]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.linker.sign :as sign]))\n\n\n(def path\n  \"The artifact, relative to the repository root.\"\n  \"test/resources/yang/python/dht-import-v1.edn\")\n\n\n(def magic \"dht-import-v1\")\n\n\n(def key-a\n  \"The publisher `A`: a fixed test seed.\"\n  (let [seed (apply str (repeat 32 \"a1\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(def key-b\n  \"The foreign principal `B`: a fixed test seed.\"\n  (let [seed (apply str (repeat 32 \"b2\"))]\n    {:seed seed, :public (sign/public-of seed)}))\n\n\n(defn closure-addresses\n  \"Every blob address of the closure of `manifest` in `store`: the reads\n   one closure walk makes.\"\n  [store manifest]\n  (let [seen (atom #{})\n        get-bytes (:get-bytes-fn store)\n        recording (assoc store\n                         :get-bytes-fn\n                         (fn [address not-found]\n                           (swap! seen conj address)\n                           (get-bytes address not-found)))]\n    (closure/walk recording manifest)\n    @seen))\n\n\n(defn installed-py\n  \"`py`'s closure as this host published it, `{address bytes}`: the\n   Python runtime every reader has installed. It does not travel: three\n   of its blobs (the code images, about 1 MB each) exceed the DHT's\n   64 KiB message bound, which a `dao.space.dht` node does not let a\n   composition raise.\"\n  []\n  (let [{:keys [store address]} @h/published]\n    (select-keys ((:entries-fn store)) (closure-addresses store address))))\n\n\n(defn- unit\n  [nm pk]\n  {:name nm, :packet pk, :package? false})\n\n\n(defn- assert-names\n  \"`key`'s assertions binding each `[module address]` of `bound`, at\n   consecutive sequences from `seq0`.\"\n  [key seq0 bound]\n  (vec (map-indexed (fn [i [n a]]\n                      (publish/assertion key {:name n,\n                                              :manifest a,\n                                              :seq (+ seq0 i)}))\n                    bound)))\n\n\n(defn- signed-only\n  [signed]\n  (mapv #(select-keys % [:envelope :proof]) signed))\n\n\n(defn generate\n  \"This host's artifact: the units published from the committed packets\n   into a store holding `py` as this host published it, `A`'s and `B`'s\n   envelopes signed over the addresses. Answers `{:lines [...]}`, or the\n   first publication refusal as `{:refused r}`.\"\n  []\n  (let [py (:address @h/published)\n        installed (installed-py)\n        store (mem/create-content-mem installed)\n        units (publication/publish-units!\n                store (h/registry) py\n                [(unit \"m\" programs/m-packet) (unit \"k\" programs/k-packet)\n                 (unit \"t\" programs/t-packet) (unit \"e\" programs/e-packet)])\n        k2 (publication/publish-units! store (h/registry) py\n                                       [(unit \"k\" programs/k2-packet)])]\n    (if-let [refused (some #(when (not= :ok (:status %)) %) [units k2])]\n      {:refused refused}\n      (let [addresses (:addresses units)\n            own (assert-names key-a 1 [['py py]\n                                       ['pym.m (get addresses \"m\")]\n                                       ['pym.k (get addresses \"k\")]\n                                       ['pym.t (get addresses \"t\")]])\n            republish [(publish/retraction\n                         key-a\n                         {:of (jing/segment-key (:envelope (nth own 2))),\n                          :seq 5})\n                       (publish/assertion\n                         key-a\n                         {:name 'pym.k,\n                          :manifest (get-in k2 [:addresses \"k\"]),\n                          :seq 6})]\n            foreign (assert-names key-b 1 [['pym.e (get addresses \"e\")]])\n            blobs (sort-by (comp str key)\n                           (remove (fn [[a _]] (contains? installed a))\n                                   ((:entries-fn store))))]\n        {:lines\n         (into [magic\n                (pr-str {:py py})\n                (pr-str {:principals {:a (:public key-a),\n                                      :b (:public key-b)}})\n                (pr-str {:units addresses,\n                         :republished {\"k\" (get-in k2 [:addresses \"k\"])}})\n                (pr-str {:importers {:d programs/d-packet,\n                                     :tt programs/tt-packet,\n                                     :x programs/x-packet}})\n                (pr-str {:index :own, :signed (signed-only own)})\n                (pr-str {:index :republish, :signed (signed-only republish)})\n                (pr-str {:index :foreign, :signed (signed-only foreign)})]\n               (map (fn [[a bs]] (pr-str [a (jing.dht/bytes->hex bs)])))\n               blobs)}))))\n\n\n(defn text\n  \"The artifact text of `lines`: one per line, newline terminated.\"\n  [lines]\n  (str (str/join \"\\n\" lines) \"\\n\"))\n\n\n(defn read-lines\n  \"The artifact's lines, blank ones dropped (Dart keeps a trailing one).\"\n  []\n  (vec (remove str/blank? (str/split-lines (cfx/read-path path)))))\n\n\n(defn parse\n  \"Artifact `lines` as data, `{:py :principals :units :republished\n   :importers :indexes {kind [signed ...]} :blobs {address hex}}`: what\n   two artifacts are compared by, since a host prints a map's entries in\n   its own order.\"\n  [lines]\n  (let [[m & forms] lines]\n    (when-not (= magic m)\n      (throw (ex-info \"not a dht-import-v1 artifact\" {:path path})))\n    (reduce (fn [acc line]\n              (let [form (edn/read-string line)]\n                (cond\n                  (vector? form) (assoc-in acc [:blobs (first form)]\n                                           (second form))\n                  (:index form) (assoc-in acc [:indexes (:index form)]\n                                          (:signed form))\n                  :else (merge acc form))))\n            {:blobs {}, :indexes {}}\n            forms)))\n\n\n(defn read-file\n  \"The checked-in artifact, `parse`'s data with each blob as host\n   bytes.\"\n  []\n  (update (parse (read-lines))\n          :blobs\n          (fn [blobs]\n            (into {} (map (fn [[a hex]] [a (jing.dht/hex->bytes hex)]))\n                  blobs))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat docs/agents/build-n-test.md; sed -n '1,160p' test/yang/python/antlr/dht_import_test.cljc; sed -n '340,420p' test/yang/python/antlr/dht_import_test.cljc; cat bb.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"cat docs/agents/build-n-test.md; sed -n '1,160p' test/yang/python/antlr/dht_import_test.cljc; sed -n '340,420p' test/yang/python/antlr/dht_import_test.cljc; cat bb.edn\"","aggregated_output":"---\ndescription: Build, lint, test commands, TDD guidelines, and bracket debugging for Clojure, ClojureScript, Node.js, and ClojureDart\n---\n\n# BUILD & TEST\n\n## Commands\n\n```sh\n# Tests (Babashka runner)\nbb test              # All three lanes (JVM, Node, Dart), fast default form: no slow tests\nbb test:all          # Every test on every lane, slow ones included (JVM takes 20+ min)\nbb test:slow         # Only the slow tests, on every lane\n# One lane alone: <task>:clj, <task>:cljs, <task>:cljd\nbb test:clj          # JVM, fast: skips ^:slow (bare `clj -M:test` runs them too)\nbb test:cljs         # Node (shadow-cljs :cljs alias), fast: guarded slow bodies print SKIP\nbb test:cljd         # Dart (needs flutter on PATH), fast: guarded slow bodies print SKIP\nbb test:all:clj      # JVM, no filter: `clojure -M:test`\nbb test:all:cljs     # Node with DATOM_SLOW_TESTS=1\nbb test:all:cljd     # Dart with DATOM_SLOW_TESTS=1\nbb test:slow:clj     # JVM: `-i :slow` (long-loops-test, ~14 min)\nbb test:slow:cljs    # Node: only the namespaces that use dao.test-slow/guard, DATOM_SLOW_TESTS=1\nbb test:slow:cljd    # Dart: only those namespaces' generated tests, DATOM_SLOW_TESTS=1\n# Slow tests: tag a deftest ^:slow. The JVM runner then excludes it from `bb test:clj`.\n# Node and Dart have no tag filter, so a .cljc slow test also wraps its body in\n# (dao.test-slow/guard \"name\" (fn [] ...)); it prints SKIP unless DATOM_SLOW_TESTS=1.\n# Node and Dart select slow tests by NAMESPACE (derived by grepping `slow/guard`\n# under test/), so the non-slow tests inside those namespaces also run there.\n# On Node, shadow also runs the test namespaces those nine require (about\n# seven more, e.g. lower-portable-test); on Dart only the nine namespaces run.\n# Run test:slow / test:all before a big merge or a commit that touches many parts.\n# Run one Dart lane at a time per machine (the limit is cores and the Flutter cache,\n# not subsystems). On the many-core remote hosts see \"Remote test servers\" below for\n# which lanes may overlap.\n#\n# When to tag a test slow: when it takes more than about 5 s on any lane (the\n# Python e2e tests sit on a ~3 s floor, so their JVM cut is 3.0 s). The\n# default lanes must stay in minutes; 22 JVM tests (0.75% of the suite) were\n# 81% of its test time. Tag it ^:slow on the JVM; if it is a .cljc test, also\n# wrap its body in dao.test-slow/guard so Node and Dart skip it by default. A\n# test that is slow only on Dart (dao.jing.dht-test/unproven-chunks-... takes\n# 72 s there, 3.6 s on the JVM) is a candidate for a speed investigation first.\n# Python slow set (2026-10-06): 65 ^:slow and 15 guard-only tests in the\n# yang.python.antlr e2e, e2e-c1, prelude-parity, safepoint, float-address\n# and int-contract tests; a Python slice landing runs `bb test:sub:clj yang.python --slow`\n# (or `clojure -M:test -i :slow -n <ns>`).\n# While iterating, use the Gate Ladder (see below): G0 iterate via `bb test:sub:clj <own>`\n# or `clojure -M:test -n <ns>`. Do not run the full `bb test` while iterating.\n# At slice checkpoints, run G1 (`bb test:sub <own>`). Before landing a slice, run\n# G2 (`bb test:changed` in the worktree across all three lanes).\n# Full repo-wide `bb test` (G3) is the mandatory landing gate on master after merge.\n# Cross-host bugs show only on Node or Dart, so tri-host verification is mandatory\n# for every gate from G1 upward. Run one lane set at a time per machine to avoid\n# contention (a laptop has 8 cores; the 24- and 48-core remote hosts have room to\n# overlap lanes, see \"Remote test servers\" below).\n# Measured fast-lane times (2026-10-03): bb test about 14 min = JVM 5.5 + Node\n# 3.8 + Dart 4.3, plus builds. test:slow: Node and Dart about 5 min each (mostly\n# compile); the JVM half is estimated at 17 min (long-loops-test alone is 14),\n# not yet run end to end. test:all: JVM 20+ min, also an estimate.\nnpm test             # Node.js tests\n\n# Cross-host peers the JVM lane spawns. `bb test` builds both. A bare\n# `bb test:clj` builds only the Node REPL (it depends on build:yin-repl-node);\n# without build:yin-repl-peer first, the Dart-peer tests skip with a printed notice.\n# Under `bb test:sub` and `bb test:changed`, prerequisites are derived automatically.\nbb build:yin-repl-peer   # Dart exe build/yin-repl-peer (yin.repl R5 pairs)\nbb build:yin-repl-node   # Node REPL target/yin-repl.js; REQUIRED by\n                         # yin.repl.dht-process-test (JVM-to-Node DHT reader,\n                         # and the linker L5 Node reader that requires a module\n                         # by name): `clojure -M:test` without it fails that test\n```\n\n### Changed-only tests: `bb test:changed`\n\n`bb test:changed` (src/dev/affected.clj) runs the fast tests a change can\nreach: the reverse require closure of the files changed since the\nmerge-base with master, plus fixtures that mention a changed resource path,\ntests that walk a changed tree, and each src file's `_test` by convention.\nA walker is a file calling file-seq, fs/glob, fs/list-dir,\nfs/walk-file-tree or .listFiles; each string literal argument of its\nio/file, fs/file, fs/path, fs/glob, java.io.File. or File. calls is a root\n(let-bound roots count), and a change under a root selects it. The three\nlanes run in parallel (logs: target/profile/changed-<lane>.log) after the\nneeded builds. `test:changed:list` shows what and why; `:clj`/`:cljs`/\n`:cljd` run one lane; `--base REF`; `--changed FILE...` (absolute OK; a\ntypo, an empty list or the wrong cwd exits 1). Use it to iterate and to\nland a slice confined to a package. Exit 2 (from :list too) is a wide\nchange (deps.edn bb.edn shadow-cljs.edn mise.toml .cljstyle src/dev/\nantlr/ .clj-kondo/ package*/pubspec*): it runs nothing; run `bb test`,\nas for a change to the core everything requires (yin.vm engine,\ndao.stream, codecs) and before a big merge. Not seen: dynamic loads\n(`requiring-resolve`, `resolve`), paths or walk roots built at run time,\nand spawned programs that changed (target/yin-repl.js, Dart peers).\n\n### Subsystem-first tests: `bb test:sub`\n\n`bb test:sub <subsystem>...` (src/dev/affected.clj) runs the tests belonging to\none or more canonical subsystems (defined in `src/dev/subsystems.edn`). Selection\nis by longest namespace prefix matching.\n\n```sh\nbb test:sub <subsystem>...        # All three lanes in parallel (fast form)\nbb test:sub:clj <subsystem>...    # JVM lane alone\nbb test:sub:cljs <subsystem>...   # Node lane alone\nbb test:sub:cljd <subsystem>...   # Dart lane alone\nbb test:sub:list <subsystem>...   # Show namespaces, builds, Class B seams & dependents; runs nothing\nbb test:sub <subsystem>... --slow # Include slow tests (-i :slow on JVM, DATOM_SLOW_TESTS=1 on Node/Dart)\nbb -cp src/dev -m affected-test   # Run affected-test self-tests directly in Babashka\n```\n\n#### Canonical Subsystems (`src/dev/subsystems.edn`)\n\n- **Layer 0 (Core Data & Transport)**: `dao.stream`, `dao.jing`, `dao.data`, `dao.base`\n- **Layer 1 (Space & UI)**: `dao.space`, `dao.gui`, `dao.postgraphics`\n- **Layer 2 (Execution Engine)**: `yin.vm.ucf`, `yin.vm`\n- **Layer 3 (Languages & Interop)**: `yin.repl`, `yang.python`, `yang.base`\n- **Layer 4 (Applications & Demos)**: `demo`, `world`\n- **Infrastructure**: `dev`, `bench`\n\nPrerequisites (`build:yin-repl-peer`, `build:yin-repl-node`, `gen:python-antlr`)\nand lane serialization (`[:clj :cljd]`) are derived purely from text reach of the\nselected namespaces and run automatically when needed.\n\n#### Gate Ladder (docs/design/test.subsystems.md)\n\n1. **G0 Iterate**: Run only the subsystem's JVM lane (`bb test:sub:clj <own>` or `clojure -M:test -n <ns>`).\n2. **G1 Checkpoint**: Run the three-lane subsystem test (`bb test:sub <own>`). Proves the home suite across all three hosts before reporting ready.\n3. **G2 Land**: Run `bb test:changed` in the worktree across all three lanes (plus `bb test:sub <own> --slow` if slow tests are present). Covers dependents across the change (for foundation subsystems like `dao.stream` or `dao.jing`, this correctly runs nearly the full suite).\n4. **G3 Master**: The mandatory landing gate on master after merge, and for any wide change (`bb test`).\n5. **G4 Release**: Full or slow test run before a big release or cross-cutting merge (`bb test:slow` or `bb test:all`), and at each phase boundary of a multi-phase track (owner decision 2026-10-12; see \"Test tiers: quick and slow\" below). G0 to G3 run the quick tier; G4 runs the slow tier.\n\n\nThe linker-over-DHT end-to-end gate (docs/design/yin.vm.linker.dht.md,\nslice L5) is two tests:\n\n- `yin.repl.dht-process-test` (JVM lane only): real `yin.repl.main`\n  processes over real loopback UDP. A JVM publisher with a key file\n  publishes modules by name, and JVM and Node readers require them by\n  name on all four VMs. Plain Clojure in the test JVM takes the same path\n  and checks each section 9 failure as data. Ports are ephemeral, and\n  every wait is bounded. A run takes a few minutes. Run it alone with\n  `clojure -M:test -n yin.repl.dht-process-test`, after\n  `bb build:yin-repl-node`.\n- `yin.vm.linker.dht-end-to-end-test` (all three lanes): the same\n  scenario in process, over the `dao.jing.dht` test mesh seam. Dart's\n  signed-name leg runs here, because no Dart `yin.repl.main` process\n  exists to spawn. `build/yin-repl-peer` is the R5 slice peer, not a\n  REPL.\n\n```sh\n# ClojureScript / shadow-cljs (always via deps.edn :cljs alias, never npx)\nclj -M:cljs -m shadow.cljs.devtools.cli watch <build-id>    # e.g. watch demo\nclj -M:cljs -m shadow.cljs.devtools.cli compile <build-id>  # e.g. compile demo\nclj -M:cljs -m shadow.cljs.devtools.cli release <build-id>  # production release\n\n# ClojureDart\nclj -M:clojuredart:cljd compile\n\n# Linting\nclj -M:kondo --lint <path>\n```\n\nThe Dart `bb` lanes run `src/dev/cljd_agg.clj` (`bb src/dev/cljd_agg.clj\n[--slow-only | --slow-regex]`), not `cljd test`. `--slow-only` runs only the\nnamespaces that use `dao.test-slow/guard` and fails if one has no generated\nDart file. `--slow-regex` prints those namespaces as an anchored alternation\nwith its dots already escaped for an EDN string (bb.edn feeds it to shadow-cljs\n`--config-merge` for `test:slow:cljs`); it is not a ready-to-use regex, and it\nexits 1 when no namespace uses the guard. `flutter test` spends about 7.5 s loading\neach of the ~166 generated `test/cljd-out/**/*_test.dart` files, so the\nscript compiles every test namespace via `clojure -M:clojuredart:cljd compile\n<namespaces>`, writes up to min(8, cores) shard files under `build/cljd-agg/`\n(greedy by file size; each imports its files and calls their `main`), runs\n`flutter test --concurrency N` on the shards, and deletes them. Shards never sit\nunder `test/`, so plain `clojure -M:clojuredart:cljd test` still works. Tests of\ndifferent namespaces share an isolate per shard. Failures stay attributable:\npackage:test names are ns-qualified (`dao.foo-test/bar-test`).\n\n`flutter test`/`cljd test` globs everything under `test/cljd-out/`, and the\ncompile does not prune it when a source file is deleted or renamed. The\naggregated lanes only run namespaces that still exist under `test/`, but a\nstale file can silently pass a plain `cljd test`. Run `rm -rf test/cljd-out`\nbefore relying on that to prove a deletion or rename took effect.\n\n## Test tiers: quick and slow\n\nThe suite has two tiers so that slow tests run less often than quick ones\n(owner decision, 2026-10-12).\n\n- **Quick tier:** every test not tagged `^:slow`. `bb test:clj` or\n  `clojure -M:test -e :slow` on the JVM; the Node and Dart lanes skip the\n  guarded bodies (`dao.test-slow/guard`) unless `DATOM_SLOW_TESTS=1`.\n- **Slow tier:** the tagged deftests. `bb test:slow` or\n  `clojure -M:test -i :slow -n <ns>` on the JVM.\n- **The tagging rule** is the one above (\"When to tag a test slow\"): a deftest that\n  takes about 5 s or more run alone. On 2026-10-12 every JVM test namespace and every\n  deftest in the 22 slowest namespaces were timed on a 48-core Linux server, and the\n  **63 deftests at 5 s or more** were tagged: `^:slow` on the deftest, plus the guard\n  wrapper in `.cljc` files. 37 are guarded, 26 are `^:slow` only (`.clj` files and\n  `:clj` reader-conditional branches). Those 22 namespaces now hold **168 slow tests**\n  in all (some were already tagged). Per-test times are not in the repo: measure again\n  with the method below before changing the cut.\n- **Cadence:** the quick tier at every checkpoint (G1) and landing (G2, G3); the slow\n  tier before merging a big change and at each phase boundary of a multi-phase track\n  (the existing G4). There is no nightly run.\n\nMeasured (2026-10-12, origin master plus the tags, Linux servers; see \"Remote test\nservers\" for how to run them):\n\n| Run | Time |\n|---|---|\n| Full JVM lane, one process, before tagging (shiva) | 70 min |\n| Full JVM lane, sharded by subsystem, before tagging (jupiter, 13 shards, 8 at a time) | 46.5 min, set by `yin.repl.python-antlr-test` |\n| **Quick tier, sharded by subsystem (jupiter, same 13 shards)** | **5 min 3 s**, 4055 tests, all shards exit 0; longest shards `yang.python` 253 s and `yin.vm.ucf` 204 s |\n| **Slow tier (shiva, one JVM per namespace, 6 at a time)** | **53 min**, 22 namespaces, 168 tests, all exit 0; longest `yin.repl.python-antlr-test` 3183 s (about 1580 s alone on the laptop) |\n\nThe quick tier has exactly 63 fewer tests than the untagged suite (4118 to 4055).\nSome quick parts are still 25 to 69 s when a namespace is run alone (`e2e-c2`,\n`prelude-parity`, `int-ops`, `holder.driver`, `compose-rows`): many tests each just\nunder the 5 s cut (the Python e2e per-test floor is about 2 to 3 s), not shared setup.\nA lower cut would shrink the quick tier further and move more tests to the slow tier.\n\n**How the per-test times were measured.** To time every deftest of a namespace alone,\nrun it without the test runner's alias main (the `:test` alias's `-m cognitect.test-runner`\notherwise swallows `-e`, and every JVM runs the whole suite):\n\n```sh\nNS=<namespace> clojure -Sdeps '{:aliases {:t {:extra-paths [\"test\"]}}}' -M:t timing.clj\n# timing.clj: require the namespace, for each deftest var that is not ^:slow:\n#   (binding [clojure.test/*test-out* (java.io.StringWriter.)] (clojure.test/test-vars [v]))\n# and print the elapsed nanoseconds. One-off setup (a `use-fixtures :once` or a parser\n# load) is paid by the first test in file order; check before tagging that test alone.\n```\n\n**Sharding the JVM lane by subsystem** (the quick tier; run on a server, see below). The\nshards come from `bb test:sub:list <subsystem>` for the 13 subsystems that hold JVM\ntests, so each subsystem is one JVM; the script also checks that the shards cover every\nJVM test namespace under `test/`:\n\n```sh\n#!/usr/bin/env bash\n# Usage: shard-jvm.sh <clone> [parallel]  -- JVM lane sharded by subsystem (fast tests, -e :slow)\nset -u\nexport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"\ncd \"$1\" || exit 2\nPAR=\"${2:-8}\"\nmise trust >/dev/null 2>&1\neval \"$(mise env -s bash)\"\nOUT=\"$1/target-ci/shards\"; rm -rf \"$OUT\"; mkdir -p \"$OUT\"\nts() { date +%H:%M:%S; }\necho \"start $(ts) $(git rev-parse --short HEAD) par=$PAR\" | tee \"$OUT/summary.txt\"\nnpm ci --silent >\"$OUT/npm.log\" 2>&1                   && echo \"npm ok $(ts)\" | tee -a \"$OUT/summary.txt\"\nbb build:yin-repl-node >\"$OUT/build-node.log\" 2>&1     && echo \"node repl built $(ts)\" | tee -a \"$OUT/summary.txt\"\nbb gen:python-antlr >\"$OUT/antlr.log\" 2>&1             && echo \"antlr ok $(ts)\" | tee -a \"$OUT/summary.txt\"\nSUBS=\"yang.python yin.repl yin.vm yin.vm.ucf dao.stream dao.jing dao.gui dao.space demo dao.data dao.postgraphics yang.base dao.base\"\n: > \"$OUT/covered.txt\"\nfor s in $SUBS; do\n  bb test:sub:list \"$s\" 2>/dev/null | awk \"/^clj:/{f=1;next} /^[A-Za-z]/{f=0} f{gsub(/ /,\\\"\\\");print}\" > \"$OUT/ns-$s.txt\"\n  cat \"$OUT/ns-$s.txt\" >> \"$OUT/covered.txt\"\n  echo \"$s $(wc -l < \"$OUT/ns-$s.txt\")\" >> \"$OUT/plan.txt\"\ndone\n# coverage: every JVM test namespace under test/ vs the union of the shards\nfind test -type f \\( -name \"*_test.clj\" -o -name \"*_test.cljc\" \\) | sed -e \"s#^test/##\" -e \"s#\\.cljc\\?\\$##\" -e \"s#/#.#g\" -e \"s#_#-#g\" | sort -u > \"$OUT/all.txt\"\nsort -u \"$OUT/covered.txt\" > \"$OUT/covered.sorted\"\ncomm -23 \"$OUT/all.txt\" \"$OUT/covered.sorted\" > \"$OUT/ns-uncovered.txt\"\necho \"all=$(wc -l < $OUT/all.txt) covered=$(wc -l < $OUT/covered.sorted) uncovered=$(wc -l < $OUT/ns-uncovered.txt)\" | tee -a \"$OUT/summary.txt\"\nrun_shard() {\n  s=$1; f=\"$OUT/ns-$s.txt\"; [ -s \"$f\" ] || return 0\n  args=(); while read -r n; do args+=(-n \"$n\"); done < \"$f\"\n  t0=$(date +%s); clojure -M:test -e :slow \"${args[@]}\" >\"$OUT/$s.log\" 2>&1; rc=$?\n  echo \"$s rc=$rc secs=$(( $(date +%s)-t0 )) $(ts) $(grep -E \"^Ran \" \"$OUT/$s.log\" | tail -1)\" | tee -a \"$OUT/summary.txt\"\n}\nexport -f run_shard; export OUT; export -f ts\nprintf \"%s\\n\" $SUBS uncovered | xargs -P \"$PAR\" -I{} bash -c \"run_shard {}\"\necho \"done $(ts)\" | tee -a \"$OUT/summary.txt\"\n```\n\n**The slow tier** runs each tagged namespace on its own JVM, a few at a time:\n\n```sh\n#!/usr/bin/env bash\n# Usage: slow-tier.sh <clone> [parallel] -- the ^:slow tests of the tagged namespaces, one JVM per namespace\nset -u\nexport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"\ncd \"$1\" || exit 2\nPAR=\"${2:-6}\"\nmise trust >/dev/null 2>&1\neval \"$(mise env -s bash)\"\nOUT=\"$1/target-ci/slowtier\"; rm -rf \"$OUT\"; mkdir -p \"$OUT\"\nrun_ns() {\n  n=$1; t0=$(date +%s)\n  clojure -M:test -i :slow -n \"$n\" > \"$OUT/$n.log\" 2>&1; rc=$?\n  echo \"$n rc=$rc secs=$(( $(date +%s)-t0 )) $(grep -E \"^Ran \" \"$OUT/$n.log\" | tail -1)\" >> \"$OUT/summary.txt\"\n}\nexport -f run_ns; export OUT\necho \"start $(date +%H:%M:%S) $(git rev-parse --short HEAD) par=$PAR\" > \"$OUT/summary.txt\"\nxargs -P \"$PAR\" -I{} bash -c \"run_ns {}\" < \"$HOME/ci/pertest-ns.txt\"\necho \"done $(date +%H:%M:%S)\" >> \"$OUT/summary.txt\"\n```\n\n## Remote test servers: shiva and jupiter\n\nTwo Linux x86_64 servers run the full suite faster than a laptop. Both are\nreached over SSH as `sto` with key authentication, and both have `mise`, `tmux`\nand `git`.\n\n| Host | Cores / RAM | Toolchain state (checked 2026-10-11) |\n|---|---|---|\n| `shiva.stigmergy.systems` | 24 / 62 GB | Complete: java 21, clojure 1.12.4.1602, node 25.6.1, babashka, cljstyle, zprint, flutter 3.47.1-stable. All three lanes run. |\n| `jupiter.stigmergy.systems` | 48 / 62 GB | java 21, clojure, node, zprint; babashka installed with `mise install babashka@latest`; flutter 3.41.9 is NOT the pinned version. Run the JVM and Node lanes here, not Dart. |\n\n**Never test in `~/workspace/datomworld` on either host.** It is a working copy\nthat is behind origin (shiva: 45 commits behind on 2026-10-11) and belongs to its\nowner. Use a scratch clone under `~/ci/` and leave the working copy alone.\n\n### Get the code there: push to origin, never rsync\n\nRsyncing a worktree over the WAN ran at about 150 KB/s (576 MB of tracked files\nwould take about an hour), and an unanchored `--exclude build` also dropped source\ndirectories named `build`, `out` and `target`. Both hosts reach GitHub, so push the\nbranch from the laptop (a feature branch, never master), make one scratch clone on\nthe host from its existing checkout (a local clone takes seconds), and fetch:\n\n```sh\n# once per host: a separate scratch clone, not the working copy\nssh shiva.stigmergy.systems 'set -e; mkdir -p ~/ci; cd ~/workspace/datomworld;\n  URL=$(git remote get-url origin);\n  git clone -q --no-checkout ~/workspace/datomworld ~/ci/datomworld-<name>;\n  cd ~/ci/datomworld-<name>; git remote set-url origin \"$URL\";\n  git fetch -q origin; git checkout -q --detach origin/<branch>'\n```\n\nTo test another branch later, fetch and check it out in the scratch clone with\n`git fetch origin` then `git checkout --detach origin/<branch>`. A branch that\nwas never pushed cannot be tested remotely.\n\n### Activate the toolchain in the right order\n\nA non-interactive `ssh host cmd` does not load the shell profile, so `mise` and its\ntools are not on PATH. In a script, do this in exactly this order, after the `cd`\ninto the clone:\n\n```sh\nexport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"   # mise: ~/.local/bin on shiva, /snap/bin on jupiter\ncd ~/ci/datomworld-<name>\nmise trust >/dev/null 2>&1                       # trust is per path; a fresh clone is untrusted\neval \"$(mise env -s bash)\"                       # puts the repo-pinned tools on PATH\n```\n\nActivating mise before the `cd` and `mise trust` leaves the repo-pinned tools\n(flutter in particular) off PATH: the Dart lane then dies in seconds with \"Can't\nfind flutter on PATH\", and so does `bb build:yin-repl-peer`.\n\n### Which lanes may overlap (reconciling the one-lane-set rule)\n\n\"One lane set at a time\" and \"one Dart lane at a time\" are per-machine rules about\nCPU: they exist because a laptop has 8 cores. They are not a rule about repos.\n`test.subsystems.md` section 5 item 6 says the same (\"on one machine where\navoidable\"). On shiva (24 cores) and jupiter (48) the cores are not the limit, so\nlanes may overlap, with these limits:\n\n- **JVM and Dart lanes must not share one clone.** `src/dev/affected.clj`\n  (`serialized-pairs`, the `[:clj :cljd]` pair) serializes them whenever a JVM test\n  runs the cljd compiler, and some do (`yin.repl.build-test`,\n  `yin.vm.linker.cross-host-transfer-test`, `dao.stream.ws-project-cross-jvm-test`);\n  the compiler writes the clone's `lib/cljd-out` and `build/`. A second scratch clone\n  gives the Dart lane its own copies, so the two lanes then overlap safely. This is\n  by the design's own reasoning (\"each worktree owns its own `cljd-out`\"), not yet\n  verified by a measured run.\n- **JVM and Node may share a clone.** Node writes `target/` and `.shadow-cljs/`; the\n  JVM lane only reads `target/yin-repl.js`.\n- **One Dart lane per host at a time**, even across clones: the lane shards up to\n  `min(8, cores)` Flutter processes and shares the host's Flutter cache.\n- **Different branches in different clones** are independent, so two branches may\n  run on one host if its cores and RAM allow (62 GB each).\n- Do not treat this as permission to overlap lanes on the laptop.\n\nThe first run on shiva (2026-10-11) overlapped JVM and Dart in one clone before\nthis rule was written down; its results are advisory until repeated with a\nseparate Dart clone.\n\n### The full run\n\nRun long jobs inside `tmux` so the SSH session can drop. The script below does the\nserial prerequisites once, then runs the JVM and Node lanes in the first clone and\nthe Dart lane in a second clone, all concurrently, with the same commands the `bb`\ntasks use (the `bb test` task runs them one after another), and records each\nlane's exit code and seconds. Make the Dart clone the same way as the first, at the\nsame commit, with a name like `~/ci/datomworld-<name>-dart`:\n\n```sh\n#!/usr/bin/env bash\n# ~/ci/run-full.sh <jvm-node-clone> [<dart-clone>]   (omit the second on jupiter: no Dart)\nset -u\nexport PATH=\"$HOME/.local/bin:/snap/bin:$PATH\"\nDART=\"${2:-}\"\ncd \"$1\" || exit 2\nmise trust >/dev/null 2>&1\neval \"$(mise env -s bash)\"\nLOG=\"$1/target-ci\"; mkdir -p \"$LOG\"\nts() { date +%H:%M:%S; }\necho \"start $(ts) $(git rev-parse --short HEAD)\" | tee \"$LOG/summary.txt\"\nnpm ci --silent >\"$LOG/npm.log\" 2>&1               && echo \"npm ok $(ts)\" | tee -a \"$LOG/summary.txt\"\nbb build:yin-repl-node >\"$LOG/build-node.log\" 2>&1 && echo \"node repl built $(ts)\" | tee -a \"$LOG/summary.txt\"\nbb gen:python-antlr >\"$LOG/antlr.log\" 2>&1         && echo \"antlr ok $(ts)\" | tee -a \"$LOG/summary.txt\"\nbb build:yin-repl-peer >\"$LOG/build-peer.log\" 2>&1 && echo \"dart peer built $(ts)\" | tee -a \"$LOG/summary.txt\"  # shiva only\nlane() { name=$1; shift; s=$(date +%s); \"$@\" >\"$LOG/$name.log\" 2>&1; rc=$?\n         echo \"$name rc=$rc secs=$(( $(date +%s)-s )) $(ts)\" | tee -a \"$LOG/summary.txt\"; }\nlane jvm  clojure -M:test -e :slow &\nlane node clj -M:cljs -m shadow.cljs.devtools.cli compile test &\nif [ -n \"$DART\" ]; then                            # shiva only: its own clone (own lib/cljd-out, build/)\n  ( cd \"$DART\" && mise trust >/dev/null 2>&1 && eval \"$(mise env -s bash)\"\n    bb build:yin-repl-peer >\"$LOG/build-peer-dart.log\" 2>&1\n    lane dart bb src/dev/cljd_agg.clj ) &\nfi\nwait\necho \"done $(ts)\" | tee -a \"$LOG/summary.txt\"\n```\n\n```sh\nssh <host> 'tmux new-session -d -s ci-full \"bash -lc \\\"~/ci/run-full.sh ~/ci/datomworld-<name> ~/ci/datomworld-<name>-dart > ~/ci/run-full.out 2>&1\\\"\"'\n```\n\nWatch it: `ssh <host>`, then `tmux attach -t ci-full` (detach with `Ctrl-b d`; do not\npress Ctrl-C inside it), or `tail -f ~/ci/datomworld-<name>/target-ci/{jvm,node,dart}.log`\nand `cat .../summary.txt` (all logs and the summary are in the first clone). The session's own output is empty by design: the lanes\nwrite to the logs. The JVM lane uses `-e :slow`, so it skips `^:slow` tests, like\n`bb test:clj`. For the slow set use `-i :slow` (or `bb test:slow`); the slow C4\nscanner row took about 11-19 minutes on the JVM and about 79 minutes on Node\n(measured 2026-10-11).\n\n### Known differences from the laptop\n\n- **`dao.stream.datagram.dart-test/refusals-and-lifecycle-events` fails on Linux.**\n  The assertion \"a bind on a taken port deposits bind-failed\" gets no `bind-failed`\n  event. A second UDP bind on a taken port evidently behaves differently on Linux\n  than on macOS (inferred, not confirmed). The test is in `dao.stream`, which the\n  semantic-register slices do not touch: treat it as a known Linux-only failure,\n  not a regression, until it is fixed or guarded.\n- A JVM lane started before the Dart peer is built skips the Dart-peer tests with a\n  printed notice. The script builds the peer first so they run.\n- Both hosts run other work (a QEMU guest and rustdesk on shiva); idle load is\n  under 1, but timings are not a clean benchmark.\n\n### Measured times (first runs, 2026-10-11, commit 84c7c9b7, all lanes concurrent)\n\nShiva, Dart lane: 1054 s (17.5 min) cold, with the JVM and Node lanes running beside\nit, against about 9 minutes on the 8-core laptop run alone. Prerequisites (`npm ci`,\nNode REPL, ANTLR) took about 30 s; the Dart peer 91 s. JVM and Node lane times are\nnot recorded yet: fill them in from `summary.txt` after a completed run. Running the\nlanes concurrently on one host did not make the Dart lane faster, so count on the\nextra cores and a free laptop, and measure before relying on a speedup.\n\n## Testing Philosophy & TDD\n\nWrite tests before implementing features (TDD).\n\nTests define the contract and expected behavior. Implementation follows from the tests, not the other way around.\n\nWhen implementing a feature or fix:\n1. **Red phase**: Write the test first — define what should happen.\n2. **Green phase**: Implement the minimum code to pass the test.\n3. **Refactor phase**: Refactor if needed while keeping tests green.\n\nThis ensures code is testable by design and implementation matches actual requirements.\n\n## Debugging Malformed CLJ / EDN / CLJS\n\nA single missing bracket can silently break an entire file. The compiler may still succeed, with subsequent forms nesting inside the broken one.\n\n1. **Run clj-kondo first**:\n   ```sh\n   clj -M:kondo --lint path/to/file.cljs\n   ```\n\n2. **If clj-kondo reports a mismatch, write a bracket-tracing script**:\n   Do NOT try to eyeball-count brackets. Track a stack of `(char, line, col)` for every opener. Handle: string literals, escaped chars, and `;;` line comments.\n\n3. **Fix one bracket at a time, re-run checker after each fix**:\n   Common patterns:\n   - Hiccup vector missing `]` causes siblings to become extra arguments.\n   - `defn`/`let` missing `)` causes subsequent top-level forms to nest inside.\n   - Both can coexist while total bracket count is zero-sum.\n\n4. **After brackets balance**, rerun `clj-kondo`, then rebuild with `clj -M:cljs -m shadow.cljs.devtools.cli compile <build>`.\n(ns yang.python.antlr.dht-import-test\n  \"C4 slices I3/I5 (docs/design/yang.antlr.md 8.5.6): Python modules published\n   by name and imported over the DHT.\n\n   The fast tests pin the publication: a unit set publishes bottom-up, a\n   cyclic pair publishes as one SCC bundle step, an import\n   no unit or publication supplies is refused.\n\n   The slow test is the acceptance over the `dao.jing.dht` mesh seam, the\n   in-process form `yin.vm.linker.dht-end-to-end-test` uses, so it runs on\n   the JVM, Node and Dart alike. What travels is the JVM's publication:\n   the artifact `yang.python.antlr.dht-import-fixture` reads, written on\n   the JVM by its generator script -- the guest blobs, manifest addresses\n   and signed envelopes of `A`'s units and `B`'s name, and the importer\n   packets. No host republishes it: the publisher node serves the\n   artifact's bytes and envelopes as they are. Each host also publishes\n   the same packets itself, into a store of its own, and must arrive at\n   the artifact: a host-specific publication difference fails there.\n   `py` is the runtime every node has installed, one manifest address on\n   every host (`linked-prelude-test`'s golden, and the artifact's), since\n   its code images exceed the DHT's message bound.\n\n   One reader, handed `A`'s index manifest and declaring `A`, imports\n   through the DHT link source on the semantic, stack and register VMs.\n   Then `B` vouches for a module, and the reader, declaring `B` too, is\n   refused it by the default admission interpreter while it trusts only `A`\n   (yin.vm.linker.dht.md 7.5), raising ImportError in Python with no install\n   child and no output, and allowed it once it trusts `B`. Next, `B`'s head\n   moves the name to another module between the admission question and its\n   answer: the allow binds the module the question was asked about. Last,\n   `A`'s republication of `k` is indexed, and the reader's import of `t`,\n   which pinned the old `k`, encounters a dependency pin mismatch at\n   statement-time receive when `k` is delivered, raising ImportError before `k`\n   is installed or runs.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.datom :as datom]\n    [dao.jing :as jing]\n    [dao.jing.dht :as jing.dht]\n    [dao.jing.dht.mesh :as mesh]\n    [dao.jing.mem :as mem]\n    [dao.space.dht :as dht]\n    [dao.space.dht-test :as dht-test]\n    [dao.space.index :as index]\n    [dao.stream :as stream]\n    [dao.test-slow :as slow]\n    [yang.python.antlr.dht-import-fixture :as fixture]\n    [yang.python.antlr.import-programs :as programs]\n    [yang.python.antlr.linked-harness :as h]\n    [yang.python.antlr.lower :as lower]\n    [yang.python.antlr.publication :as publication]\n    [yang.python.antlr.render :as render]\n    [yin.vm :as vm]\n    [yin.vm.linker.admission :as admission]\n    [yin.vm.linker.dht :as ld]\n    [yin.vm.linker.head :as head]\n    [yin.vm.linker.interpreter :as link]\n    [yin.vm.linker.publish :as publish]\n    [yin.vm.linker.sign :as sign]\n    [yin.vm.module :as module]))\n\n\n;; =============================================================================\n;; The fast tests: publication order, cycles, admission\n;; =============================================================================\n\n(def ^:private stand-in-address\n  \"A stand-in `py` address: a refused publication never reads it.\"\n  :test/address)\n\n\n(defn- unit\n  [nm pk]\n  {:name nm, :packet pk, :package? false})\n\n\n(deftest units-publish-after-what-they-import-test\n  (testing \"t imports k: k is ordered first whatever the input order\"\n    (is (= {:status :ok, :order [\"k\" \"t\" \"m\"]}\n           (publication/publication-order\n             [(unit \"t\" programs/t-packet) (unit \"k\" programs/k-packet)\n              (unit \"m\" programs/m-packet)]\n             {}))))\n  (testing \"an import a publication already supplies needs no unit\"\n    (is (= {:status :ok, :order [\"t\"]}\n           (publication/publication-order [(unit \"t\" programs/t-packet)]\n                                          {\"k\" :test/k})))))\n\n\n(deftest cyclic-components-are-ordered-as-one-publication-step-test\n  (doseq [units [[(unit \"ca\" programs/ca-packet) (unit \"cb\" programs/cb-packet)]\n                 [(unit \"cb\" programs/cb-packet) (unit \"ca\" programs/ca-packet)]]]\n    (is (= {:status :ok, :order [[\"ca\" \"cb\"]]}\n           (publication/publication-order units {})))))\n\n\n(deftest an-unsupplied-import-is-refused-at-publication-test\n  (let [store (mem/create-content-mem)]\n    (is (= {:status :refused,\n            :reason :yang.python.antlr/unpublished-import,\n            :module \"k\",\n            :imported-by \"t\"}\n           (publication/publish-units! store (h/registry) stand-in-address\n                                       [(unit \"t\" programs/t-packet)])))\n    (is (empty? ((:entries-fn store))))))\n\n\n;; =============================================================================\n;; The mesh world: a publisher, two plain peers, a reader\n;; =============================================================================\n\n(def ^:private big\n  \"Every node's inbound bound: py's closure is replicated whole.\"\n  (* 512 1024 1024))\n\n\n(defn- peer-node\n  [net port]\n  (let [c (mesh/join! net port {::jing.dht/publish? true\n                                ::jing.dht/max-inbound-bytes big})]\n    {:composition c, :state (jing.dht/state c)}))\n\n\n(defn- node-at\n  \"A node at mesh `port` whose local store already holds `seed`\n   ({address bytes}): content it has, not content it publishes.\"\n  [net port peer-ports publish? seed]\n  (dht/join {:local (mem/create-content-mem seed),\n             :publish? publish?,\n             :peers (mapv (fn [p] {:host mesh/host, :port p}) peer-ports),\n             :bind! (mesh/seam net port),\n             :max-inbound-bytes big}))\n\n\n(defn- step-world\n  \"One reading: the publisher, the reader when there is one, then every\n   plain peer.\"\n  [w]\n  (let [now (:now w)\n        [pub pub-events] (dht/step (:pub w) now)\n        [reader] (when (:reader w) (dht/step (:reader w) now))]\n    (-> w\n        (assoc :pub pub\n               :reader reader\n               :peers (into {}\n                            (map (fn [[port {:keys [composition state]}]]\n                                   (mesh/tick! composition now)\n                                   [port {:composition composition,\n                                          :state (jing.dht/step state 256)}]))\n                            (:peers w))\n               :now (+ now 10))\n        (update :events into pub-events))))\n\n\n(defn- run-world\n  \"Step `w` until `(done? w)`; `:failure` names `cause` when `span` more\n   readings pass first.\"\n  [w span cause done?]\n  (let [limit (+ (:now w) span)]\n    (loop [w w]\n\n;; =============================================================================\n;; The acceptance\n;; =============================================================================\n\n(defn- first-difference\n  \"The first key of the artifacts `a` and `b` (`fixture/parse`'s data)\n   whose values differ, with the blob addresses only one holds or holds\n   other bytes at; nil when they are equal.\"\n  [a b]\n  (when (not= a b)\n    (let [blobs (fn [x y]\n                  (sort (map str (remove #(= (get x %) (get y %))\n                                         (keys x)))))]\n      {:keys (vec (sort (map str (filter #(not= (get a %) (get b %))\n                                         (distinct (concat (keys a)\n                                                           (keys b))))))),\n       :blobs-differ (vec (take 4 (blobs (:blobs a) (:blobs b)))),\n       :blobs-only-here (vec (take 4 (blobs (:blobs b) (:blobs a))))})))\n\n\n(defn- this-host-publishes-the-artifact\n  [artifact-lines]\n  (testing \"this host's own publication of the committed packets is the\n            JVM's artifact: same manifests, blobs and envelopes\"\n    (let [{:keys [lines refused]} (fixture/generate)]\n      (is (nil? refused) (pr-str refused))\n      (when lines\n        (is (nil? (first-difference (fixture/parse artifact-lines)\n                                    (fixture/parse lines))))))))\n\n\n(defn- publish-world\n  \"Publisher `A` at mesh port 1, plain peers at 2 and 3, a reader at 4,\n   `A` and the reader with `py` installed: `A`'s node serves the\n   artifact's guest blobs as they are and its first index (py, m, k and\n   t named by `A`), which the reader loads.\"\n  [artifact]\n  (let [net (mesh/mesh)\n        installed (fixture/installed-py)\n        pub (node-at net 1 [2 3] true installed)\n        put! (:put-bytes-fn (dht/store pub))\n        w {:net net,\n           :pub pub,\n           :reader (node-at net 4 [2 3 1] false installed),\n           :peers (into {} (map (fn [p] [p (peer-node net p)])) [2 3]),\n           :now 0,\n           :events []}]\n    (testing \"every node's installed py is the artifact's\"\n      (is (= (:py artifact) (:address @h/published))))\n    (run! (fn [[address bs]] (put! address bs))\n          (sort-by (comp str key) (:blobs artifact)))\n    (first (publish-index w (get-in artifact [:indexes :own])))))\n\n\n(def ^:private nothing-ran\n  \"A refused import's observation: no line printed and no guest install\n   child; the one child started is py's.\"\n  {:output [], :guests #{}, :children 1})\n\n\n(defn- observes\n  \"Assert each key of the observation `expected` of backend `k` on its\n   own, so a failure names the key.\"\n  [k expected seen]\n  (doseq [[key v] expected]\n    (is (= v (get seen key)) (str k \" \" key))))\n\n\n(defn- imports-over-the-dht\n  [w artifact src]\n  (testing \"a JVM-published pym.m imports over the DHT, parserless, with\n            the in-store linked run's output and CPython's\"\n    (let [[w results] (on-every-vm w (get-in artifact [:importers :d]) src)]\n      (doseq [[k [outcome response seen]] results]\n        (is (= [true false {:py/out [\"m-body\" \"7\"], :py/exception nil}]\n               outcome)\n            (str k \" \" (pr-str response)))\n        (testing \"and the observation sees the same run\"\n          (observes k {:output [\"m-body\" \"7\"], :guests #{\"pym.m\"},\n                       :children 2}\n{:tasks\n {gen:python-antlr\n  {:doc \"Generate and compile the pinned grammars-v4 Python3 parser into build/antlr/python3/classes (antlr/python3/manifest.edn)\"\n   :task (shell \"clojure -M:antlr-gen\")}\n\n  build:yin-repl-node\n  {:doc \"Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js\"\n   ;; yin.repl.dht-process-test spawns it as the JVM-to-Node reader of\n   ;; DHT epic S5, a required leg: a missing build fails that test.\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl\")}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; Process B of the R5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM\n   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n   ;; `bb test:cljs` without it skips those tests with a printed notice\n   ;; rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:python-antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:python-antlr]\n                :task (shell \"clojure -M:test\")}\n\n  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-node]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-peer]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Only the slow tests. Node and Dart select by namespace, so the other\n  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.\n  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\n                 :depends [build:yin-repl-node gen:python-antlr]\n                 :task (shell \"clojure -M:test -i :slow\")}\n\n  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-node]\n                  :task (let [re (-> (shell {:out :string}\n                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\n                                     :out\n                                     clojure.string/trim)]\n                          (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                                 \"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                                 \"compile\" \"test\" \"--config-merge\"\n                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\n\n  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-peer]\n                  :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                               \"bb src/dev/cljd_agg.clj --slow-only\")}\n\n  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\n             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\n\n  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\n            :depends [test:all:clj test:all:cljs test:all:cljd]}\n\n  test {:doc \"All three lanes in their fast default form (JVM, Node, Dart)\"\n        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n\n  ;; Only the tests a change can affect (src/dev/affected.clj): the\n  ;; reverse require closure of the changed files since the merge-base\n  ;; with master. Extra args pass through (--base REF, --changed FILE...).\n  ;; Exit 2 on a wide change (deps.edn, bb.edn, src/dev/, ...): run bb test.\n  test:changed {:doc \"Fast tests a change can affect, three lanes in parallel\"\n                :task (System/exit\n                        (:exit (apply shell {:continue true}\n                                      \"bb\" \"src/dev/affected.clj\"\n                                      *command-line-args*)))}\n\n  test:changed:clj {:doc \"JVM lane of test:changed\"\n                    :task (System/exit\n                            (:exit (apply shell {:continue true}\n                                          \"bb\" \"src/dev/affected.clj\"\n                                          \"--lane\" \"clj\" *command-line-args*)))}\n\n  test:changed:cljs {:doc \"Node lane of test:changed\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--lane\" \"cljs\"\n                                           *command-line-args*)))}\n\n  test:changed:cljd {:doc \"Dart lane of test:changed\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--lane\" \"cljd\"\n                                           *command-line-args*)))}\n\n  test:changed:list {:doc \"What test:changed would run and why; runs nothing\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--list\" *command-line-args*)))}\n\n  ;; Subsystem tests (src/dev/affected.clj): canonical subsystems defined\n  ;; in src/dev/subsystems.edn. Positional arguments name subsystems; flags\n  ;; pass through (--lane L, --list, --slow).\n  test:sub {:doc \"Subsystem tests, three lanes in parallel: bb test:sub <subsystem>... [--slow]\"\n            :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                 *command-line-args*)\n                        sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                    (System/exit\n                      (:exit (apply shell {:continue true}\n                                    \"bb\" \"src/dev/affected.clj\"\n                                    (concat sub-args flags)))))}\n\n  test:sub:clj {:doc \"JVM lane of test:sub: bb test:sub:clj <subsystem>... [--slow]\"\n                :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                     *command-line-args*)\n                            sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                        (System/exit\n                          (:exit (apply shell {:continue true}\n                                        \"bb\" \"src/dev/affected.clj\"\n                                        \"--lane\" \"clj\"\n                                        (concat sub-args flags)))))}\n\n  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljs\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljd\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:list {:doc \"What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>...\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--list\"\n                                         (concat sub-args flags)))))}\n  }}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat deps.edn; rg -n 'with-redefs|alter-var|intern|prelude|module-spec|defonce' test/yang/python/antlr/dht_import_test.cljc src/yang/python/antlr/prelude.cljc test/yang/python/antlr/*test*; head -65 /tmp/i5-dht-pin.log; rg -n 'clj-kondo|cljstyle' docs/agents/build-n-test.md; cat .mise.toml\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
