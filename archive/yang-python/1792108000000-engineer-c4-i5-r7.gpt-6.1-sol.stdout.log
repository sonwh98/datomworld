lambda binds and ignores. `%` cannot begin a\n   Python identifier, so it never shadows a guest name.\"\n  '%_)\n\n\n(defn then\n  \"Evaluate `a` for effect, then `b`.\"\n  [a b]\n  (app (lam [discard] b) a))\n\n\n(defn seq-nodes\n  \"Evaluate every node in order; the value is the last one's.\"\n  [nodes]\n  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n\n\n(defn let1\n  [sym value body]\n  (app (lam [sym] body) value))\n\n\n(defn sexp->uast\n  [form]\n  (cond\n    (symbol? form) (v form)\n    (seq? form)\n    (let [[head & args] form]\n      (case head\n        fn (lam (first args) (sexp->uast (second args)))\n        if (if-node (sexp->uast (first args))\n                    (sexp->uast (second args))\n                    (sexp->uast (nth args 2)))\n        do (seq-nodes (map sexp->uast args))\n        let (let [[bindings body] args]\n              (reduce (fn [inner [sym value]]\n                        (let1 sym (sexp->uast value) inner))\n                      (sexp->uast body)\n                      (reverse (partition 2 bindings))))\n        quote (lit (first args))\n        %capture capture\n        (apply app (sexp->uast head) (map sexp->uast args))))\ntest/dao/space/dht_test.cljc:536:        (do (reset! outcomes more) {:dao.stream/outcome outcome})\ntest/dao/space/dht_test.cljc:1064:          _ (reset! (:refuse w) #{refused})\ntest/dao/space/dht_test.cljc:1075:          _ (reset! (:refuse w) #{manifest})\ntest/dao/space/dht_test.cljc:1092:        _ (reset! (:refuse w) #{refused})\ntest/dao/space/dht_test.cljc:1095:        _ (reset! (:refuse w) #{})\ntest/dao/space/dht_test.cljc:1114:        _ (reset! (:refuse w) refused)\ntest/dao/space/dht_test.cljc:1118:        _ (reset! (:refuse w) (disj refused manifest))\ntest/dao/space/dht_test.cljc:1120:        _ (reset! (:refuse w) #{})\ntest/dao/space/dht_test.cljc:1177:     _ (reset! (:refuse w) (constantly true))\ntest/dao/space/dht_test.cljc:1229:            _ (reset! (:refuse w) (consta