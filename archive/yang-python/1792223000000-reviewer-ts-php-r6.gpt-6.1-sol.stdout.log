{"type":"item.completed","item":{"id":"item_4","type":"web_search","id":"exec-900e16ed-407d-4536-9a40-3b4184282e7c","query":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_hash.c","action":{"type":"open_page","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_hash.c"},"results":[{"type":"text_result","domain":"raw.githubusercontent.com","ref_id":"turn17view0","snippet":"Total lines: 3254","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_hash.c"},{"type":"text_result","domain":"raw.githubusercontent.com","ref_id":"turn17view1","snippet":"Total lines: 291","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_objects.c"},{"type":"text_result","domain":"raw.githubusercontent.com","ref_id":"turn17view2","snippet":"Total lines: 1966","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_object_handlers.c"},{"type":"text_result","domain":"raw.githubusercontent.com","ref_id":"turn17view3","snippet":"Total lines: 1966","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_object_handlers.c"},{"type":"text_result","domain":"raw.githubusercontent.com","ref_id":"turn17view4","snippet":"Total lines: 1966","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_object_handlers.c"},{"type":"text_result","domain":"raw.githubusercontent.com","ref_id":"turn17view5","snippet":"Total lines: 5180","url":"https://raw.githubusercontent.com/php/php-src/PHP-8.3/Zend/zend_execute.c"}]}}
