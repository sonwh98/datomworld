{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'cat src/cljc/yang/python/antlr/parser.cljc; cat src/dev/yang_antlr_gen.clj'","aggregated_output":"(ns yang.python.antlr.parser\n  \"The Python parser interpreter: the grammars-v4 Python3 grammar profile\n   plus the stage that reads sealed source units from one stream and writes\n   CST packets to another. The generated recognizers come from `bb gen:antlr`\n   (antlr/python3/manifest.edn), one per host target; this is the only\n   namespace that names them, and the profile's three constructors are the\n   entire per-host surface.\"\n  (:require\n    #?@(:cljd [[\"package:antlr4/antlr4.dart\" :as antlr4]\n               [\"package:datomworld_cljd/antlr/python3/Python3Lexer.dart\"\n                :as lexer-ns]\n               [\"package:datomworld_cljd/antlr/python3/Python3Parser.dart\"\n                :as parser-ns]]\n        :cljs [[\"/yang/antlr/gen/python3/Python3Lexer.js\" :default Python3Lexer]\n               [\"/yang/antlr/gen/python3/Python3Parser.js\" :default Python3Parser]])\n    [yang.antlr.cst :as cst]\n    [yang.stage :as stage])\n  #?@(:cljd []\n      :clj [(:import\n              (yang.python.antlr.gen\n                Python3Lexer\n                Python3Parser))]))\n\n\n(def grammar-id\n  \"grammars-v4 python/python3 at its pinned revision, generated by ANTLR 4.13.2.\"\n  \"grammars-v4/python/python3@8af0d4c26c796ea27c15c3d85418f2d0f77c3adb antlr-4.13.2\")\n\n\n(def profile\n  {:grammar-id grammar-id,\n   :make-lexer #?(:cljd (fn [cs] (lexer-ns/Python3Lexer cs))\n                  :default (fn [cs] (Python3Lexer. cs))),\n   :make-parser #?(:cljd (fn [ts] (parser-ns/Python3Parser ts))\n                   :default (fn [ts] (Python3Parser. ts))),\n   :start #?(:cljd (fn [p] (.file_input ^parser-ns/Python3Parser p))\n             :clj (fn [^Python3Parser p] (.file_input p))\n             :cljs (fn [p] (.file_input p)))})\n\n\n(def rule-names\n  \"The grammar's rule-name table.\"\n  ;; Dart's table is an instance member of the generated parser.\n  #?(:cljd (vec (.-ruleNames\n                  (parser-ns/Python3Parser\n                    (antlr4/CommonTokenStream\n                      (lexer-ns/Python3Lexer\n                        (antlr4/InputStream.fromString \"\"))))))\n     :clj (vec (seq Python3Parser/ruleNames))\n     :cljs (vec (.-ruleNames Python3Parser))))\n\n\n(defn make-worker\n  []\n  (cst/make-worker profile))\n\n\n(defn parse-source\n  \"Parse one complete source string as unit `unit`: the packet a sealed unit\n   with this text produces.\"\n  ([source] (parse-source (make-worker) [:unit 0] source))\n  ([worker unit source] (cst/parse-unit worker unit source)))\n\n\n(defn open-stage\n  \"A parser stage reading source events from `source-stream` and writing\n   CST packets to `cst-stream`, with its own worker.\"\n  [source-stream cst-stream]\n  (assoc (stage/open source-stream {:cst cst-stream} {})\n         ::transform (cst/parse-transform (make-worker))))\n\n\n(defn step-stage\n  [s]\n  (stage/step s (::transform s)))\n(ns yang-antlr-gen\n  \"Build-time generation of the grammars-v4 parsers for every host target\n   (docs/design/yang.antlr.md §4.2). Reproducible from clean:\n\n     clj -M:antlr-gen [--grammar g] [--target java|javascript|dart]\n                                 ; or: bb gen:antlr\n\n   1. Read the vendored grammars (antlr/<grammar>/*.g4, MIT, committed) and\n      fetch the remaining pinned files at the manifest's revision (cached\n      under build/, re-fetched only when absent); refuse any digest mismatch.\n   2. For each manifest :targets entry (:java, :javascript, :dart), stage the\n      grammars and that target's helpers, applying the recorded patches (the\n      Java helpers also get their package clause prepended).\n   3. Run the pinned ANTLR tool with the target's flags, then apply the\n      target's recorded :output-patches to the files it wrote.\n   4. Java only: compile with the host javac into build/antlr/<g>/classes,\n      which deps.edn puts on the classpath.\n   5. Digest every generated source file of the target and compare with the\n      target's recorded :generated digests; a mismatch fails the build.\n\n   `clj -M:antlr-gen discover` prints the head commit of the grammar path, for\n   deliberately moving the pin. Nothing here runs at admission time.\"\n  (:require\n    [clojure.edn :as edn]\n    [clojure.java.io :as io]\n    [clojure.pprint :as pprint]\n    [clojure.string :as str])\n  (:import\n    (io.github.rctcwyvrn.blake3\n      Blake3)\n    (java.net\n      URI)\n    (java.net.http\n      HttpClient\n      HttpClient$Redirect\n      HttpRequest\n      HttpResponse$BodyHandlers)\n    (javax.tools\n      ToolProvider)))\n\n\n(def ^:dynamic *grammar* \"python3\")\n\n\n(defn- manifest-path\n  []\n  (str \"antlr/\" *grammar* \"/manifest.edn\"))\n\n\n(defn- build-dir\n  []\n  (str \"build/antlr/\" *grammar*))\n\n\n(defn- blake3\n  [^bytes bs]\n  (let [b (Blake3/newInstance)]\n    (.update b bs)\n    (.hexdigest b)))\n\n\n(defn- http-get-bytes\n  ^bytes [url]\n  (let [client (-> (HttpClient/newBuilder)\n                   (.followRedirects HttpClient$Redirect/NORMAL)\n                   (.build))\n        req (-> (HttpRequest/newBuilder (URI/create url))\n                (.header \"User-Agent\" \"datomworld-yang-antlr-gen\")\n                (.build))\n        resp (.send client req (HttpResponse$BodyHandlers/ofByteArray))]\n    (when-not (= 200 (.statusCode resp))\n      (throw (ex-info \"Fetch failed\" {:url url, :status (.statusCode resp)})))\n    (.body resp)))\n\n\n(defn- read-manifest\n  []\n  (edn/read-string (slurp (manifest-path))))\n\n\n(defn- raw-url\n  [{:keys [repo revision path]} file]\n  (str \"https://raw.githubusercontent.com/\" repo \"/\" revision \"/\" path \"/\" file))\n\n\n(defn- read-bytes\n  ^bytes [f]\n  (java.nio.file.Files/readAllBytes (.toPath (io/file f))))\n\n\n(defn- source-bytes!\n  \"A pinned file's bytes: a vendored file from the repository, otherwise\n   the build cache, fetched from the pinned revision when absent.\"\n  [grammar file {:keys [vendored]} target]\n  (cond\n    vendored (let [bs (read-bytes vendored)]\n               (io/copy bs target)\n               bs)\n    (.exists target) (read-bytes target)\n    :else (let [bs (http-get-bytes (raw-url grammar file))]\n            (io/copy bs target)\n            bs)))\n\n\n(defn- fetch-grammar!\n  \"Each pinned file, vendored or fetched, digest-checked. A vendored file\n   must also be ASCII (§4.5). A mismatching fetched file leaves the cache; a\n   vendored file is never deleted.\"\n  [{:keys [grammar]}]\n  (let [src-dir (io/file (build-dir) \"upstream\")]\n    (.mkdirs src-dir)\n    (let [mismatches\n          (vec (for [[file {expected :blake3, :as entry}]\n                     (sort-by key (:files grammar))\n                     :let [target (io/file src-dir (str/replace file \"/\" \"__\"))\n                           bs (source-bytes! grammar file entry target)\n                           actual (blake3 bs)\n                           ascii? (every? #(<= 0 % 127) bs)]\n                     :when (or (println (if (:vendored entry) \"vendored\" \"fetched\")\n                                        file actual)\n                               (not= expected actual)\n                               (and (:vendored entry) (not ascii?)))]\n                 (do (.delete target)\n                     {:file file, :expected expected, :actual actual,\n                      :ascii ascii?})))]\n      (when (seq mismatches)\n        (throw (ex-info \"Grammar digest or ASCII check failed\"\n                        {:mismatches mismatches}))))\n    src-dir))\n\n\n(defn- delete-tree!\n  [f]\n  (let [f (io/file f)]\n    (when (.isDirectory f)\n      (doseq [c (.listFiles f)] (delete-tree! c)))\n    (.delete f)))\n\n\n(defn- apply-patch\n  \"One recorded exact-text replacement; the old text must occur exactly once.\"\n  [file text [old new]]\n  (let [n (count (re-seq (re-pattern (java.util.regex.Pattern/quote old))\n                         text))]\n    (when-not (= 1 n)\n      (throw (ex-info \"Patch does not apply\" {:file file, :old old, :matches n})))\n    (str/replace text old new)))\n\n\n(defn- helper-ext\n  [{:keys [helpers]}]\n  (let [base (last (str/split (first helpers) #\"/\"))]\n    (subs base (str/last-index-of base \".\"))))\n\n\n(defn- target-dir\n  \"Where a target's generated files (and copied helpers) land.\"\n  ^java.io.File [{:keys [out package]}]\n  (if package\n    (io/file out (str/replace package \".\" \"/\"))\n    (io/file out)))\n\n\n(defn- stage-sources!\n  \"Copy the grammars and the target's helpers into one generation directory,\n   applying the recorded patches: the package clause for the Java helpers,\n   then the target's exact-text replacements.\"\n  [{:keys [grammar]} {:keys [package patches helpers]} src-dir]\n  (let [gen-in (io/file (build-dir) \"grammar\")]\n    (delete-tree! gen-in)\n    (.mkdirs gen-in)\n    (doseq [file (sort (concat (filter #(not (str/includes? % \"/\"))\n                                       (keys (:files grammar)))\n                               helpers))]\n      (let [text (slurp (io/file src-dir (str/replace file \"/\" \"__\")))\n            base (last (str/split file #\"/\"))\n            text (if (and package (str/ends-with? base \".java\"))\n                   (str \"package \" package \";\\n\" text)\n                   text)\n            text (reduce (partial apply-patch file)\n                         text\n                         (get patches file))]\n        (spit (io/file gen-in base) text)))\n    gen-in))\n\n\n(defn- run-antlr!\n  [{:keys [grammar]} {:keys [flags helpers output-patches] :as target} gen-in]\n  (let [out (target-dir target)\n        ext (helper-ext target)]\n    (delete-tree! (io/file (:out target)))\n    (.mkdirs out)\n    (let [tool (org.antlr.v4.Tool.\n                 (into-array String\n                             (concat flags\n                                     [\"-Xexact-output-dir\" \"-o\" (.getPath out)\n                                      \"-lib\" (.getPath gen-in)]\n                                     (map #(.getPath (io/file gen-in %))\n                                          (:generate grammar)))))]\n      (.processGrammarsOnCommandLine tool)\n      (when (pos? (.getNumErrors tool))\n        (throw (ex-info \"ANTLR generation failed\"\n                        {:errors (.getNumErrors tool)}))))\n    (doseq [[file ps] output-patches\n            :let [f (io/file out file)]]\n      (spit f (reduce (partial apply-patch file) (slurp f) ps)))\n    (doseq [h helpers\n            :let [f (io/file gen-in (last (str/split h #\"/\")))]]\n      (io/copy f (io/file out (.getName f))))\n    (doseq [f (.listFiles out)\n            :when (not (str/ends-with? (.getName f) ext))]\n      (.delete f))\n    out))\n\n\n(defn- generated-digests\n  [out ext]\n  (into (sorted-map)\n        (for [f (.listFiles (io/file out))\n              :when (str/ends-with? (.getName f) ext)]\n          [(.getName f)\n           (blake3 (java.nio.file.Files/readAllBytes (.toPath f)))])))\n\n\n(defn- non-ascii-files\n  \"§4.5: generated textual sources stay ASCII.\"\n  [out]\n  (vec (for [f (.listFiles (io/file out))\n             :when (some #(> (int %) 127) (slurp f))]\n         (.getName f))))\n\n\n(defn- compile-java!\n  [pkg-dir]\n  (let [classes (io/file (build-dir) \"classes\")\n        compiler (ToolProvider/getSystemJavaCompiler)\n        sources (sort (map #(.getPath %)\n                           (filter #(str/ends-with? (.getName %) \".java\")\n                                   (.listFiles (io/file pkg-dir)))))]\n    (delete-tree! classes)\n    (.mkdirs classes)\n    (when-not compiler\n      (throw (ex-info \"No system Java compiler (a JDK is required)\" {})))\n    (let [rc (.run compiler nil nil nil\n                   (into-array String\n                               (concat [\"-nowarn\" \"--release\" \"11\" \"-cp\"\n                                        (System/getProperty \"java.class.path\")\n                                        \"-d\" (.getPath classes)]\n                                       sources)))]\n      (when-not (zero? rc)\n        (throw (ex-info \"javac failed\" {:exit rc}))))\n    classes))\n\n\n(defn- generate-target!\n  [m src-dir [tname target]]\n  (let [gen-in (stage-sources! m target src-dir)\n        out (run-antlr! m target gen-in)\n        digests (generated-digests out (helper-ext target))\n        non-ascii (non-ascii-files out)]\n    (spit (io/file out \"generated-digests.edn\")\n          (with-out-str (pprint/pprint digests)))\n    (when (seq non-ascii)\n      (throw (ex-info \"Non-ASCII generated source\" {:target tname\n                                                    :files non-ascii})))\n    (when-let [expected (:generated target)]\n      (when-not (= expected digests)\n        (throw (ex-info \"Generated sources differ from the recorded digests\"\n                        {:target tname, :expected expected, :actual digests}))))\n    (when (= :java tname) (compile-java! out))\n    (println \"generated\" (count digests) (name tname) \"files in\" (.getPath out))\n    (when-not (:generated target)\n      (println \"no :generated digests recorded yet for\" tname \"; record these:\")\n      (pprint/pprint digests))))\n\n\n(defn generate!\n  [only-target]\n  (let [m (read-manifest)\n        src-dir (fetch-grammar! m)]\n    (doseq [t (sort-by key (:targets m))\n            :when (or (nil? only-target) (= only-target (name (key t))))]\n      (generate-target! m src-dir t))))\n\n\n(defn discover!\n  []\n  (let [{:keys [grammar]} (read-manifest)\n        url (str \"https://api.github.com/repos/\" (:repo grammar)\n                 \"/commits?per_page=1&path=\" (:path grammar))\n        body (String. (http-get-bytes url) \"UTF-8\")]\n    (println (re-find #\"\\\"sha\\\":\\s*\\\"[0-9a-f]{40}\\\"\" body))\n    (println (re-find #\"\\\"date\\\":\\s*\\\"[^\\\"]+\\\"\" body))\n    (doseq [dir [(:path grammar) (str (:path grammar) \"/Java\")]]\n      (let [url (str \"https://api.github.com/repos/\" (:repo grammar)\n                     \"/contents/\" dir\n                     (when (:revision grammar)\n                       (str \"?ref=\" (:revision grammar))))\n            listing (String. (http-get-bytes url) \"UTF-8\")]\n        (println dir (mapv second (re-seq #\"\\\"path\\\":\\s*\\\"([^\\\"]+)\\\"\"\n                                          listing)))))))\n\n\n(defn- arg-value\n  [args flag]\n  (second (drop-while #(not= flag %) args)))\n\n\n(defn -main\n  [& args]\n  (let [only-target (arg-value args \"--target\")\n        grammars (if-let [g (arg-value args \"--grammar\")]\n                   [g]\n                   (sort (for [d (.listFiles (io/file \"antlr\"))\n                               :when (.exists (io/file d \"manifest.edn\"))]\n                           (.getName d))))]\n    (doseq [g grammars]\n      (binding [*grammar* g]\n        (if (= \"discover\" (first args)) (discover!) (generate! only-target)))))\n  (shutdown-agents))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '621,678p' docs/design/yang.antlr.md; cat test/yang/antlr/conformance.cljc test/yang/python/antlr/cst_export_test.cljc; cat antlr/python3/manifest.edn\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '621,678p' docs/design/yang.antlr.md; cat test/yang/antlr/conformance.cljc test/yang/python/antlr/cst_export_test.cljc; cat antlr/python3/manifest.edn\"","aggregated_output":"### 4.6 The multi-target pipeline and the parse-tree IR\n\nThe multi-target design (2026-10-17; approved by a codex adversarial\nreview after two revision rounds) makes the per-host generation of\nsection 4.2 concrete for the Python frontend and generalizes the\nrecipe to every future ANTLR-supported language.\n\nThe manifest gains a `:targets` map: one entry per host target (Java,\nJavaScript, Dart), each carrying its generation flags, helper bases and\npatches, digests, and output directory. The generator loops the map;\nthe Java digests stay byte-identical to today. The runtimes pin per\ntarget (the Maven runtime, the antlr4 npm package, the antlr4 pub\npackage, all at the tool version).\n\nThe target-neutral parse-tree IR is the existing CST packet v1,\nformalized. ANTLR has no target-neutral tree, and the per-target parse\ntrees differ in their objects, but for the same grammar their structure\nis equivalent. The design names the CST packet the IR: each host's\nexporter translates its target's parse tree into the same packet\nvalues, the packet's `validate!` enforces the seven invariants with a\none-pass recursive preorder walk and outcome-specific contracts\n(duplicate edges, DFS preorder, real-token text against source bytes,\nUTF-8 boundary alignment, terminal ordering, rule extents over real\ndescendants, grammar-metadata name checks, and error packets as their\nown outcome), and a portable `conform` is the per-target oracle. A\n`:synthetic-policy` map keys synthetic justification on grammar role\n(DEDENT always, NEWLINE at end, EOF always, other types never), and\nerror packets carry two independent coordinate systems: the byte span\ncomputed from token indexes, and ANTLR's line and column captured\nverbatim, which are not required to agree.\n\nThe lowering stays per language by design and consumes the IR\nhost-neutrally; it never sees a target runtime. Per language, the whole\nper-host surface is one small parser adapter with three\nreader-conditional constructor profiles.\n\nAdding a new ANTLR-supported language becomes a bounded recipe: vendor\nthe grammars, add the manifest's target entries, generate, write the\nsmall parser adapter and the language's lowering and prelude, add the\nconformance goldens. The Python multi-host work is the first instance of\nthis recipe, not a special case.\n\n---\n\n## 5. Source ingestion\n\n### 5.1 Source units are explicit\n\nSource is read via `dao.stream`. Use a versioned source vocabulary with\nevents such as:\n\n```clojure\n{:yang.source/event :yang.source/chunk\n :yang.source/unit [\"session-token\" 7]\n :yang.source/revision 3\n :yang.source/ordinal 0\n :yang.source/text \"def f(x):\\n\"}\n\n(ns yang.antlr.conformance\n  \"The per-target, language-free exporter oracle (docs/design/yang.antlr.md\n   §5.5): a language's fixtures are run against the exporter of the running\n   host, JVM, Node or Dart, and every one must come out the same. A fixture is\n   a source string and either its expected `shape` or the error it must\n   produce. The goldens are the JVM's; they are the cross-target oracle.\"\n  (:require\n    [clojure.test :refer [is testing]]\n    [yang.antlr.packet :as packet]))\n\n\n(defn shape\n  \"A packet's nodes as [rule span] and [type text span] entries in preorder.\"\n  [pk]\n  (mapv (fn [n]\n          (if (= :rule (:kind n))\n            [(:rule n) (:span n)]\n            [(:type n) (:text n) (:span n)]))\n        (:yang.cst/nodes pk)))\n\n\n(defn check-ok\n  \"`source` parses to an ok packet that validates and conforms (invariants\n   1-5); with `expected` the packet's shape equals it. Returns the packet.\"\n  ([parse source] (check-ok parse source nil))\n  ([parse source expected]\n   (let [pk (parse source)]\n     (is (= :yang.cst/ok (:yang.cst/outcome pk)) source)\n     (is (some? (packet/validate! pk)) source)\n     (is (= [] (packet/conform pk source)) source)\n     (when expected\n       (is (= expected (shape pk)) source))\n     pk)))\n\n\n(defn check-error\n  \"`source` yields a syntax-error packet with no nodes whose first error has\n   the given `line` and `span` (invariant 6). Returns the packet.\"\n  [parse source {:keys [line span]}]\n  (let [pk (parse source)\n        e (first (:yang.cst/errors pk))]\n    (testing source\n      (is (= :yang.cst/syntax-error (:yang.cst/outcome pk)))\n      (is (not (contains? pk :yang.cst/nodes)) \"never a partial program\")\n      (is (not (contains? pk :yang.cst/root)))\n      (is (true? (:yang.cst/complete pk)))\n      (is (= :syntax-error (:kind e)))\n      (is (string? (:message e)))\n      (when line (is (= line (:line e))))\n      (when span (is (= span (:span e)))))\n    pk))\n\n\n(defn check-fixtures\n  \"Run each fixture {:source s :shape [...]} or {:source s :error {...}}.\"\n  [parse fixtures]\n  (doseq [{:keys [source shape error]} fixtures]\n    (if error\n      (check-error parse source error)\n      (check-ok parse source shape))))\n(ns yang.python.antlr.cst-export-test\n  \"The parser interpreter on every host: CST packet goldens (rule names, byte\n   spans, synthetic tokens) through the language-free conformance oracle,\n   syntax errors as records with no nodes, the source protocol, and chunk\n   invariance.\"\n  (:require\n    [clojure.test :refer [deftest is testing]]\n    [dao.stream :as stream]\n    [yang.antlr.conformance :as conformance :refer [shape]]\n    [yang.antlr.cst :as cst]\n    [yang.antlr.packet :as packet]\n    [yang.python.antlr.parser :as parser]\n    [yin.vm.test-utils :as tu]))\n\n\n(deftest golden-assignment-test\n  (let [pk (parser/parse-source \"x = 1\\n\")]\n    (conformance/check-ok parser/parse-source \"x = 1\\n\")\n    (is (= :yang.cst/ok (:yang.cst/outcome pk)))\n    (is (= parser/grammar-id (:yang.cst/grammar pk)))\n    (is (true? (:yang.cst/complete pk)))\n    (is (= 0 (:yang.cst/root pk)))\n    (is (= [[\"file_input\" [0 6]]\n            [\"stmt\" [0 6]]\n            [\"simple_stmts\" [0 6]]\n            [\"simple_stmt\" [0 5]]\n            [\"expr_stmt\" [0 5]]\n            [\"testlist_star_expr\" [0 1]]\n            [\"test\" [0 1]]\n            [\"or_test\" [0 1]]\n            [\"and_test\" [0 1]]\n            [\"not_test\" [0 1]]\n            [\"comparison\" [0 1]]\n            [\"expr\" [0 1]]\n            [\"atom_expr\" [0 1]]\n            [\"atom\" [0 1]]\n            [\"name\" [0 1]]\n            [\"NAME\" \"x\" [0 1]]\n            [\"ASSIGN\" \"=\" [2 3]]\n            [\"testlist_star_expr\" [4 5]]\n            [\"test\" [4 5]]\n            [\"or_test\" [4 5]]\n            [\"and_test\" [4 5]]\n            [\"not_test\" [4 5]]\n            [\"comparison\" [4 5]]\n            [\"expr\" [4 5]]\n            [\"atom_expr\" [4 5]]\n            [\"atom\" [4 5]]\n            [\"NUMBER\" \"1\" [4 5]]\n            [\"NEWLINE\" \"\\n\" [5 6]]\n            [\"EOF\" \"<EOF>\" [6 6]]]\n           (shape pk)))\n    (testing \"ids are preorder indexes and children are ordered edges\"\n      (is (= (range (count (:yang.cst/nodes pk)))\n             (map :id (:yang.cst/nodes pk))))\n      (is (= [5 16 17] (:children (packet/node pk 4))))\n      (is (some? (packet/validate! pk))))\n    (testing \"EOF is synthetic and zero-width\"\n      (is (:synthetic (peek (:yang.cst/nodes pk)))))))\n\n\n(deftest spans-are-utf8-bytes-test\n  (testing \"a two-byte and a four-byte code point before a token shift its\n            span by bytes, not characters\"\n    (let [src \"s = 'é𝄞'\\nt = 2\\n\"\n          pk (parser/parse-source src)\n          tok (fn [text] (first (filter #(= text (:text %)) (:yang.cst/nodes pk))))]\n      (conformance/check-ok parser/parse-source src)\n      (is (= [4 12] (:span (tok \"'é𝄞'\"))))\n      (is (= [13 14] (:span (tok \"t\"))))\n      (is (= (cst/utf8-bytes src) (second (:span (packet/root pk))))))))\n\n\n(deftest indentation-tokens-test\n  (let [pk (parser/parse-source \"if x:\\n    y = 1\\nz = 2\\n\")\n        toks (filterv #(= :token (:kind %)) (:yang.cst/nodes pk))\n        by-type (fn [t] (filterv #(= t (:type %)) toks))]\n    (testing \"INDENT covers the indentation it stands for\"\n      (is (= [[\"    \" [6 10] nil]]\n             (mapv (juxt :text :span :synthetic) (by-type \"INDENT\")))))\n    (testing \"DEDENT is synthetic and zero-width where the dedented line\n              starts (patched helper)\"\n      (let [[d] (by-type \"DEDENT\")]\n        (is (:synthetic d))\n        (is (= [16 16] (:span d)))))\n    (testing \"every NEWLINE sits on its newline, including the one before an\n              INDENT (patched helper)\"\n      (is (= [[nil [5 6]] [nil [15 16]] [nil [21 22]]]\n             (mapv (juxt :synthetic :span) (by-type \"NEWLINE\")))))\n    (testing \"a block's span covers its real text only\"\n      (let [block (first (filter #(= \"block\" (:rule %)) (:yang.cst/nodes pk)))]\n        (is (= [5 16] (:span block)))))))\n\n\n(deftest missing-final-newline-test\n  (testing \"known limitation of the pinned grammar's Java helper: it adds an\n            end-of-input NEWLINE only while indentation is open, so a\n            top-level statement without a final newline is a syntax error\n            record; the source is not silently normalized\"\n    (let [pk (parser/parse-source \"x = 1\")]\n      (is (= :yang.cst/syntax-error (:yang.cst/outcome pk))))\n    (let [pk (parser/parse-source \"if x:\\n    y = 1\")\n          nl (last (filter #(= \"NEWLINE\" (:type %)) (:yang.cst/nodes pk)))]\n      (is (= :yang.cst/ok (:yang.cst/outcome pk)))\n      (is (:synthetic nl))\n      (is (= [15 15] (:span nl))))))\n\n\n(deftest syntax-errors-are-records-test\n  (let [pk (parser/parse-source \"def f(:\\n    return 1\\n\")]\n    (is (= :yang.cst/syntax-error (:yang.cst/outcome pk)))\n    (is (not (contains? pk :yang.cst/nodes)) \"never a partial program\")\n    (is (not (contains? pk :yang.cst/root)))\n    (is (true? (:yang.cst/complete pk)))\n    (let [[e :as errors] (:yang.cst/errors pk)]\n      (is (seq errors))\n      (is (= :syntax-error (:kind e)))\n      (is (= 1 (:line e)))\n      (is (= [6 7] (:span e)))\n      (is (string? (:message e))))))\n\n\n(deftest lexer-errors-are-records-test\n  (let [pk (parser/parse-source \"x = $\\n\")]\n    (is (= :yang.cst/syntax-error (:yang.cst/outcome pk)))\n    (is (= [4 5] (:span (first (:yang.cst/errors pk)))))))\n\n\n(deftest exporter-is-deterministic-test\n  (let [src \"def f(a):\\n    return [a, {1: 'x'}]\\n\"]\n    (is (= (parser/parse-source src)\n           (parser/parse-source (parser/make-worker) [:unit 0] src)))))\n\n\n(deftest every-grammar-rule-name-is-exported-by-name-test\n  (testing \"rule records use the grammar's rule names\"\n    (let [names (set parser/rule-names)\n          pk (parser/parse-source\n               \"class A(B):\\n    def m(self, *a):\\n        while x: pass\\n\")]\n      (is (every? #(contains? names (:rule %))\n                  (filter #(= :rule (:kind %)) (:yang.cst/nodes pk)))))))\n\n\n;; =============================================================================\n;; The stage: source events in, packets out\n;; =============================================================================\n\n(defn- chunks\n  \"Split `src` at the given character offsets.\"\n  [src cuts]\n  (let [bounds (concat [0] cuts [(count src)])]\n    (mapv (fn [[a b]] (subs src a b)) (partition 2 1 bounds))))\n\n\n(defn- source-events\n  [unit texts]\n  (conj (vec (map-indexed (fn [i t]\n                            {:yang.source/event :yang.source/chunk,\n                             :yang.source/unit unit,\n                             :yang.source/ordinal i,\n                             :yang.source/text t})\n                          texts))\n        {:yang.source/event :yang.source/seal,\n         :yang.source/unit unit,\n         :yang.source/chunk-count (count texts)}))\n\n\n(defn- run-parser\n  [events]\n  (let [src (tu/new-memory-log)\n        out (tu/new-memory-log)]\n    (doseq [e events] (stream/append! src e))\n    (let [s (parser/step-stage (parser/open-stage src out))]\n      {:stage s, :packets (tu/drain out)})))\n\n\n(deftest stage-emits-one-packet-per-sealed-unit-test\n  (let [{:keys [stage packets]}\n        (run-parser (concat (source-events [:u 1] [\"x = 1\\n\"])\n                            (source-events [:u 2] [\"def f(:\\n\"])))]\n    (is (= :blocked (:status stage)))\n    (is (= [[:u 1] [:u 2]] (mapv :yang.cst/unit packets)))\n    (is (= [:yang.cst/ok :yang.cst/syntax-error]\n           (mapv :yang.cst/outcome packets)))\n    (is (= {} (:state stage)) \"sealed units leave no state behind\")))\n\n\n(deftest stage-waits-for-the-seal-test\n  (let [{:keys [stage packets]}\n        (run-parser (butlast (source-events [:u 1] [\"x = 1\\n\"])))]\n    (is (empty? packets))\n    (is (= {[:u 1] {0 \"x = 1\\n\"}} (:state stage)))))\n\n\n(deftest source-protocol-errors-test\n  (testing \"a seal with a missing chunk\"\n    (let [[chunk0 _chunk1 seal] (source-events [:u 1] [\"x = \" \"1\\n\"])\n          {:keys [packets]} (run-parser [chunk0 seal])]\n      (is (= :yang.cst/source-error (:yang.cst/outcome (first packets))))\n      (is (not (contains? (first packets) :yang.cst/nodes)))))\n  (testing \"a conflicting duplicate chunk\"\n    (let [[chunk0 _ seal] (source-events [:u 1] [\"x = \" \"1\\n\"])\n          {:keys [packets]}\n          (run-parser [chunk0 (assoc chunk0 :yang.source/text \"y = \") seal])]\n      (is (= :yang.cst/source-error (:yang.cst/outcome (first packets)))))))\n\n\n(deftest chunk-invariance-test\n  (let [src \"def f(a):\\n    s = 'é'\\n    return a\\nprint(f(1))\\n\"\n        splits [[] [1] [5 6 7] [10 11 12 13] (vec (range 1 (count src)))]\n        packets (mapv (fn [cuts]\n                        (first (:packets (run-parser\n                                           (source-events [:u 1]\n                                                          (chunks src cuts))))))\n                      splits)]\n    (is (= :yang.cst/ok (:yang.cst/outcome (first packets))))\n    (is (apply = packets))\n    (is (= (first packets) (parser/parse-source (parser/make-worker) [:u 1] src)))))\n{:grammar {:repo \"antlr/grammars-v4\",\n           :path \"python/python3\",\n           :revision \"8af0d4c26c796ea27c15c3d85418f2d0f77c3adb\",\n           ;; The two MIT grammars are vendored verbatim beside this manifest\n           ;; (owner decision \"Vendor .g4 only\"); the Java, JavaScript and Dart\n           ;; helpers, whose licence is unresolved, are still fetched at the pinned revision.\n           ;; Every file is digest-checked either way.\n           :files {\"Python3Lexer.g4\"\n                   {:blake3 \"407a5312b637ebe386eabaceca758a5714f1d3e26b1f058b96e43dca3ec02662\",\n                    :vendored \"antlr/python3/Python3Lexer.g4\"},\n                   \"Python3Parser.g4\"\n                   {:blake3 \"e82099eb8fda51ea8b49c266cba8eb2af47eb400fe657d8d8867b1eaf62fe00d\",\n                    :vendored \"antlr/python3/Python3Parser.g4\"},\n                   \"Java/Python3LexerBase.java\"\n                   {:blake3 \"5212b67286df5ec7f8818876cbb2bb178e80fcdc5b3daae69e225edd5f68d385\"},\n                   \"Java/Python3ParserBase.java\"\n                   {:blake3 \"f29fa8fc257027885afdd9c778add55a1128c83b0f888035904d952be0e5222d\"},\n                   \"JavaScript/Python3LexerBase.js\" {:blake3 \"25f008c2ee815b3c21af0b037e6dd99aa4b91d54f9f92720f218d542e731262f\"},\n                   \"JavaScript/Python3ParserBase.js\" {:blake3 \"e106d38dbd2dff1cc036b70ddc2829b733aa207f1adb2d987e358d3edd316e84\"},\n                   \"Dart/Python3LexerBase.dart\" {:blake3 \"45022cf97972b104313464d80e923ff2fca50b9d5a3d00502067bc569bc218f4\"},\n                   \"Dart/Python3ParserBase.dart\" {:blake3 \"e4c4693a640e53b971d37088809c74539cc0f1dda7d9c6a3cdd9beb7ce40a87d\"}},\n           :generate [\"Python3Lexer.g4\" \"Python3Parser.g4\"]},\n :tool {:antlr \"4.13.2\"},\n ;; One entry per host target; all runtimes are the pinned tool release\n ;; (a bump regenerates and re-pins every target together). Each target\n ;; lists its helper files, flags, output directory, exact-text patches and\n ;; the BLAKE3 of every generated/patched source file (generation fails on\n ;; drift).\n :targets\n {:java\n  {:runtime \"org.antlr/antlr4-runtime 4.13.2\",\n   :package \"yang.python.antlr.gen\",\n   :flags [\"-Dlanguage=Java\" \"-package\" \"yang.python.antlr.gen\" \"-no-listener\"\n           \"-no-visitor\"],\n   :helpers [\"Java/Python3LexerBase.java\" \"Java/Python3ParserBase.java\"],\n   :out \"build/antlr/python3/java\",\n   ;; Every Java helper gets `package yang.python.antlr.gen;` prepended.\n   ;; Exact-text replacements, applied in order after that. Upstream builds\n   ;; NEWLINE and DEDENT with CommonToken(start, stop) at the end of the\n   ;; newline-plus-indentation lexeme and never sets their text, so ANTLR reads\n   ;; their text back from whatever source sits there: a NEWLINE before an\n   ;; INDENT reads a space, and a DEDENT reads the newline it follows. The patch\n   ;; puts NEWLINE on its newline characters and makes DEDENT zero-width\n   ;; (stop = start - 1), so every token's span is the source it came from.\n   :patches\n   {\"Java/Python3LexerBase.java\"\n    [[\"            emit(commonToken(Python3Lexer.NEWLINE, newLine));\"\n      \"            emit(positionedToken(Python3Lexer.NEWLINE, this._tokenStartCharIndex, this._tokenStartCharIndex + newLine.length() - 1));\"]\n     [\"        CommonToken dedent = commonToken(Python3Lexer.DEDENT, \\\"\\\");\"\n      \"        CommonToken dedent = positionedToken(Python3Lexer.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);\"]\n     [\"            this.emit(commonToken(Python3Lexer.NEWLINE, \\\"\\\\n\\\"));\"\n      \"            this.emit(positionedToken(Python3Lexer.NEWLINE, this.getCharIndex(), this.getCharIndex() - 1));\"]\n     [\"    private CommonToken commonToken(int type, String text) {\"\n      \"    private CommonToken positionedToken(int type, int start, int stop) {\\n        return new CommonToken(this._tokenFactorySourcePair, type, DEFAULT_TOKEN_CHANNEL, start, stop);\\n    }\\n\\n    private CommonToken commonToken(int type, String text) {\"]]},\n   :generated {\"Python3Lexer.java\"\n               \"bb61a463af3d2c5d3f58778c0b10e082f1b3c88fd793102646e632087a540848\",\n               \"Python3LexerBase.java\"\n               \"1c8ac0a2bd1cc1499b842e251eea74a13cf7b6e984ece6cb5b55ff69403b354e\",\n               \"Python3Parser.java\"\n               \"8ba1f2398e52994e8ead1d68768c723bed6dbd4b5eccd48d57d585d1684f13d7\",\n               \"Python3ParserBase.java\"\n               \"332745797ab6423d234c796e80103823d718bc9da0a73643682a43d0c42c45be\"}},\n\n  ;; The JavaScript and Dart helpers build NEWLINE and DEDENT the same way as\n  ;; the Java one (commonToken at the end of the lexeme), so the same\n  ;; positioned-token patch is ported to each runtime's token API.\n  :javascript\n  {:runtime \"antlr4 4.13.2 (npm)\",\n   :flags [\"-Dlanguage=JavaScript\" \"-no-listener\" \"-no-visitor\"],\n   :helpers [\"JavaScript/Python3LexerBase.js\" \"JavaScript/Python3ParserBase.js\"],\n   :out \"build/antlr/python3/js/yang/antlr/gen/python3\",\n   :patches\n   {\"JavaScript/Python3ParserBase.js\" [[\"import antlr4 from 'antlr4';\"\n      \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]],\n    \"JavaScript/Python3LexerBase.js\"\n    [[\"import antlr4 from 'antlr4';\"\n      \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]\n     [\"            this.emitToken(this.commonToken(Python3Parser.NEWLINE, newLine));\"\n      \"            this.emitToken(this.positionedToken(Python3Parser.NEWLINE, this._tokenStartCharIndex, this._tokenStartCharIndex + newLine.length - 1));\"]\n     [\"        return this.commonToken(Python3Parser.DEDENT, \\\"\\\");\"\n      \"        return this.positionedToken(Python3Parser.DEDENT, this.getCharIndex(), this.getCharIndex() - 1);\"]\n     [\"            this.emitToken(this.commonToken(Python3Parser.NEWLINE, \\\"\\\\n\\\"));\"\n      \"            this.emitToken(this.positionedToken(Python3Parser.NEWLINE, this.getCharIndex(), this.getCharIndex() - 1));\"]\n     [\"    commonToken(type, text) {\"\n      \"    positionedToken(type, start, stop) {\\n        return new antlr4.CommonToken(this._tokenFactorySourcePair, type, antlr4.Lexer.DEFAULT_TOKEN_CHANNEL, start, stop);\\n    }\\n\\n    commonToken(type, text) {\"]\n     ;; Upstream declares getIndentationCount twice, identically; Closure\n     ;; (the shadow-cljs release/test compile) rejects the duplicate member.\n     [\"    getIndentationCount(whitespace) {\\n        let count = 0;\\n        for (let i = 0; i < whitespace.length; i++) {\\n            if (whitespace[i] === '\\\\t') {\\n                count += 8 - count % 8;\\n            } else {\\n                count++;\\n            }\\n        }\\n        return count;\\n    }\\n\\n    getIndentationCount(whitespace) {\"\n      \"    getIndentationCount(whitespace) {\"]]},\n   ;; Output patches: the tool's own import line, same reason as above.\n   :output-patches {\"Python3Lexer.js\" [[\"import antlr4 from 'antlr4';\"\n      \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]],\n                    \"Python3Parser.js\" [[\"import antlr4 from 'antlr4';\"\n      \"import antlr4Module from 'antlr4';\\nconst antlr4 = antlr4Module.default || antlr4Module;\"]]},\n   :generated {\"Python3Lexer.js\"\n               \"855f47de669d2f042839efded7e2468e102091b55097f3e403a24a0e3485b860\",\n               \"Python3LexerBase.js\"\n               \"47