           (export/offset-at offsets (.. recognizer -_input -index))]\n\n                   :else nil)]\n        (vswap! errors conj (export/syntax-error msg line column span))))))\n\n\n(defn- ops\n  [parser]\n  (let [rule-names (.-ruleNames parser)\n        symbolic (.-symbolicNames parser)\n        literal (.-literalNames parser)]\n    {:token? (fn [t] (instance? (.. antlr4-default -tree -TerminalNode) t)),\n     :token (fn [t]\n              (let [tok (.-symbol t)\n                    type (.-type tok)]\n                {:type-name (if (= type -1)\n                              \"EOF\"\n                              (or (aget symbolic type)\n                                  (aget literal type)\n                                  (str type))),\n                 :start (.-start tok),\n                 :stop (.-stop tok),\n                 :text (.-text tok)})),\n     :rule-name (fn [ctx] (aget rule-names (.-ruleIndex ctx))),\n     :children (fn [ctx] (vec (.-children ctx))),\n     :start (fn [ctx] (some-> (.-start ctx) (.-start)))}))\n\n\n(defn parse-unit\n  \"Parse one sealed unit's `source` with `worker`; return its CST packet.\"\n  [worker unit source]\n  (let [{:keys [profile]} worker\n        cps (packet/code-points source)\n        offsets (export/byte-offsets cps)\n        errors (volatile! [])\n        l (error-listener errors offsets)\n        lexer ((:make-lexer profile) (char-stream source))\n        _ (own-lexer! lexer worker)\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer l)\n        parser ((:make-parser profile) (new (.-CommonTokenStream antlr4) lexer))\n        _ (own-parser! parser worker)\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser l)\n        tree ((:start profile) parser)]\n    (export/result profile unit @errors\n                   #(export/export-nodes (ops parser) cps offsets tree))))\n\n\n(defn parse-transform\n  \"The parser stage's transform over source events (`packet/transform`).\"\n  [worker]\n  (packet/transform parse-unit worker))\n\n\n(defn utf8-bytes\n  \"The UTF-8 byte count of a string: span ends are checked against it.\"\n  [s]\n  (packet/utf8-bytes s))\n\n\n(defn first-failure\n  \"Where the grammar first refuses `source` with `worker`: nil when it\n   parses, `:end` when the first error failed on an end-of-input token, else\n   `:early` (`export/failure-kind` decides). See the JVM namespace.\"\n  [worker source]\n  (let [{:keys [profile]} worker\n        failure (volatile! nil)\n        lexer ((:make-lexer profile) (char-stream source))\n        tokens (new (.-CommonTokenStream antlr4) lexer)\n        l (listener\n            (fn [_recognizer offending _line _column _msg e]\n              (when-not @failure\n                (vreset! failure\n                         (cond\n                           (not (token? offending)) :lexical\n                           (instance? (.. antlr4-default -error -NoViableAltException) e)\n                           (dec (.-length (.-tokens tokens)))\n                           :else (.-tokenIndex offending))))))\n        _ (own-lexer! lexer worker)\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer l)\n        parser ((:make-parser profile) tokens)\n        _ (own-parser! parser worker)\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser l)]\n    ((:start profile) parser)\n    (export/failure-kind\n      @failure\n      (keep (fn [t]\n              (when (not= -1 (.-type t))\n                {:index (.-tokenIndex t), :start (.-start t), :stop (.-stop t)}))\n            (.-tokens tokens)))))\n(ns yang.antlr.cst\n  \"The Dart host's parser interpreter (docs/design/yang.antlr.md §4.3, §5.5):\n   the same public names as the JVM's `yang.antlr.cst` over the pub antlr4\n   runtime. A grammar profile supplies the host constructors:\n\n     {:grammar-id  string naming grammar revision and tool\n      :make-lexer  (fn [CharStream] Lexer)\n      :make-parser (fn [TokenStream] Parser)\n      :start       (fn [Parser] ParserRuleContext)}\n\n   No ANTLR object leaves this namespace: a packet is plain data, in the\n   target-neutral shape `yang.antlr.packet` owns (the IR). The host-free half\n   of the export lives in `yang.antlr.export`; this file holds the Dart walk.\n   `InputStream.fromString` indexes runes, the code points the JVM indexes.\"\n  (:require\n    [\"package:antlr4/antlr4.dart\" :as a]\n    [yang.antlr.export :as export]\n    [yang.antlr.packet :as packet]))\n\n\n(defn- char-stream\n  [source]\n  (a/InputStream.fromString source))\n\n\n;; =============================================================================\n;; Worker: exclusively owned recognizer caches (§4.3)\n;; =============================================================================\n\n(defn- fresh-dfa\n  \"A new DFA list for `atn`: a copy of the simulator's own list (so the\n   element type is preserved) with every entry replaced.\"\n  [atn simulator-dfa]\n  (let [out (.toList simulator-dfa)\n        states (.-decisionToState atn)]\n    (dotimes [i (count states)]\n      (aset out i (a/DFA (nth states i) i)))\n    out))\n\n\n(defn make-worker\n  \"A host worker for `profile` owning its own DFA and prediction-context\n   caches, so no parse shares mutable recognizer state with another worker.\n   The worker is host state owned by one parser stage; it is not data and\n   never crosses a stream.\"\n  [profile]\n  (let [^a/Lexer lexer ((:make-lexer profile) (char-stream \"\"))\n        ^a/Parser parser ((:make-parser profile) (a/CommonTokenStream lexer))\n        ^a/LexerATNSimulator lexer-sim (.-interpreter lexer)\n        ^a/ParserATNSimulator parser-sim (.-interpreter parser)\n        lexer-atn (.-atn lexer-sim)\n        parser-atn (.-atn parser-sim)]\n    {:profile profile,\n     :lexer-atn lexer-atn,\n     :lexer-dfa (fresh-dfa lexer-atn (.-decisionToDFA lexer-sim)),\n     :lexer-cache (a/PredictionContextCache),\n     :parser-atn parser-atn,\n     :parser-dfa (fresh-dfa parser-atn (.-decisionToDFA parser-sim)),\n     :parser-cache (a/PredictionContextCache)}))\n\n\n(defn- own-lexer!\n  [lexer {:keys [lexer-atn lexer-dfa lexer-cache]}]\n  (set! (.-interpreter lexer)\n        (a/LexerATNSimulator lexer-atn lexer-dfa lexer-cache .recog lexer)))\n\n\n(defn- own-parser!\n  [parser {:keys [parser-atn parser-dfa parser-cache]}]\n  (set! (.-interpreter parser)\n        (a/ParserATNSimulator parser parser-atn parser-dfa parser-cache)))\n\n\n;; =============================================================================\n;; Export\n;; =============================================================================\n\n(defn- listener\n  \"An error listener whose `syntaxError` is `f`.\"\n  [f]\n  (reify :extends\n    (a/BaseErrorListener)\n\n    (syntaxError\n      [_ recognizer offending line column msg e]\n      (f recognizer offending line column msg e))))\n\n\n(defn- error-listener\n  \"Collects syntax errors as data into `errors` (a volatile).\"\n  [errors offsets]\n  (listener\n    (fn [recognizer offending line column msg _e]\n      (let [span (cond\n                   (instance? a/Token offending)\n                   (export/token-span offsets (.-startIndex ^a/Token offending)\n                                      (.-stopIndex ^a/Token offending))\n\n                   (instance? a/Lexer recognizer)\n                   (let [^a/Lexer lx recognizer]\n                     [(export/offset-at offsets (.-tokenStartCharIndex lx))\n                      (export/offset-at offsets (.-index (.-inputStream lx)))])\n\n                   :else nil)]\n        (vswap! errors conj (export/syntax-error msg line column span))))))\n\n\n(defn- ops\n  [^a/Parser parser]\n  (let [rule-names (.-ruleNames parser)\n        vocab (.-vocabulary parser)]\n    {:token? (fn [t] (instance? a/TerminalNode t)),\n     :token (fn [t]\n              (let [^a/Token tok (.-symbol ^a/TerminalNode t)\n                    type (.-type tok)]\n                {:type-name (if (= type -1)\n                              \"EOF\"\n                              (or (.getSymbolicName vocab type)\n                                  (.getLiteralName vocab type)\n                                  (str type))),\n                 :start (.-startIndex tok),\n                 :stop (.-stopIndex tok),\n                 :text (.-text tok)})),\n     :rule-name (fn [ctx]\n                  (nth rule-names (.-ruleIndex ^a/ParserRuleContext ctx))),\n     :children (fn [ctx]\n                 (let [kids (.-children ^a/ParserRuleContext ctx)]\n                   (if (nil? kids) [] (mapv identity kids)))),\n     :start (fn [ctx]\n              (when-some [^a/Token st (.-start ^a/ParserRuleContext ctx)]\n                (.-startIndex st)))}))\n\n\n(defn parse-unit\n  \"Parse one sealed unit's `source` with `worker`; return its CST packet.\"\n  [worker unit source]\n  (let [{:keys [profile]} worker\n        cps (packet/code-points source)\n        offsets (export/byte-offsets cps)\n        errors (volatile! [])\n        l (error-listener errors offsets)\n        ^a/Lexer lexer ((:make-lexer profile) (char-stream source))\n        _ (own-lexer! lexer worker)\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer l)\n        ^a/Parser parser ((:make-parser profile) (a/CommonTokenStream lexer))\n        _ (own-parser! parser worker)\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser l)\n        tree ((:start profile) parser)]\n    (export/result profile unit @errors\n                   #(export/export-nodes (ops parser) cps offsets tree))))\n\n\n(defn parse-transform\n  \"The parser stage's transform over source events (`packet/transform`).\"\n  [worker]\n  (packet/transform parse-unit worker))\n\n\n(defn utf8-bytes\n  \"The UTF-8 byte count of a string: span ends are checked against it.\"\n  [s]\n  (packet/utf8-bytes s))\n\n\n(defn first-failure\n  \"Where the grammar first refuses `source` with `worker`: nil when it\n   parses, `:end` when the first error failed on an end-of-input token, else\n   `:early` (`export/failure-kind` decides). See the JVM namespace.\"\n  [worker source]\n  (let [{:keys [profile]} worker\n        failure (volatile! nil)\n        ^a/Lexer lexer ((:make-lexer profile) (char-stream source))\n        ^a/CommonTokenStream tokens (a/CommonTokenStream lexer)\n        l (listener\n            (fn [_recognizer offending _line _column _msg e]\n              (when-not @failure\n                (vreset! failure\n                         (cond\n                           (not (instance? a/Token offending)) :lexical\n                           (instance? a/NoViableAltException e)\n                           (dec (count (.-tokens tokens)))\n                           :else (.-tokenIndex ^a/Token offending))))))\n        _ (own-lexer! lexer worker)\n        _ (.removeErrorListeners lexer)\n        _ (.addErrorListener lexer l)\n        ^a/Parser parser ((:make-parser profile) tokens)\n        _ (own-parser! parser worker)\n        _ (.removeErrorListeners parser)\n        _ (.addErrorListener parser l)]\n    ((:start profile) parser)\n    (export/failure-kind\n      @failure\n      (keep (fn [^a/Token t]\n              (when (not= -1 (.-type t))\n                {:index (.-tokenIndex t),\n                 :start (.-startIndex t),\n                 :stop (.-stopIndex t)}))\n            (.-tokens tokens)))))\n","exit_code":0,"status":"completed"}}
