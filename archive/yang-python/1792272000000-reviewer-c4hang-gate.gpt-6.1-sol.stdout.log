t up\n  1187\t   to `ms` for exit. Returns {:exited bool, :lines [output lines],\n  1188\t   :exit-code}. The child's stdout is block-buffered on a pipe, so output\n  1189\t   lines appear in bulk at exit; under the regression the process never\n  1190\t   exits and is destroyed at the deadline.\"\n  1191\t  [s submissions ms]\n  1192\t  (doseq [line submissions] (type! s line))\n  1193\t  (.close ^java.io.Writer (:stdin s))\n  1194\t  (let [process ^java.lang.Process (:process s)\n  1195\t        done   (.waitFor process ms java.util.concurrent.TimeUnit/MILLISECONDS)]\n  1196\t    (when-not done (.destroy process))\n  1197\t    {:exited done\n  1198\t     :lines @(:lines s)\n  1199\t     :exit-code (when done (.exitValue process))}))\n  1200\t\n  1201\t\n  1202\t(deftest ^:slow prompt-returns-after-filtered-comprehension-assignment-test\n  1203\t  \"Regression for the owner's live-session hang: at the JVM prompt, after\n  1204\t   `(lang :yang.python/antlr)`, a filtered comprehension assignment\n  1205\t   never came back. With stdin closed after the lines, `-main` halted\n  1206\t   the process `stop-join-millis` after end-of-input, while the lines\n  1207\t   were still evaluating, so nothing they printed ever appeared.\n  1208\t\n  1209\t   Both sessions must evaluate every line before their end-of-input\n  1210\t   `(quit)` and exit: the control (a lang switch plus a trivial print)\n  1211\t   and the owner's filtered comprehension, read back by a print.\"\n  1212\t  (let [control (run-submissions\n  1213\t                  (spawn! \"prompt-hang-control\"\n  1214\t                          [\"--name\" \"prompt-hang-control\"\n  1215\t                           \"--dir\" \"target/prompt-hang-control\"])\n  1216\t                  [\"(lang :yang.python/antlr)\" \"print(1+2)\"] 90000)\n  1217\t        bug     (run-submissions\n  1218\t                  (spawn! \"prompt-hang-bug\"\n  1219\t                          [\"--name\" \"prompt-hang-bug\"\n  1220\t         