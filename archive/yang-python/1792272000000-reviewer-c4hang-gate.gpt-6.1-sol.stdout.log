y state line)\n   440\t        (:connection state)\n   441\t        (publish :yin.repl.driver/result\n   442\t                 (repl/format-value (connect/summary (:connection state)))))\n   443\t\n   444\t      (and (remote-routed? state) (not command))\n   445\t      (cond\n   446\t        ;; A dropped or ended remote evaluates nothing.  The line was never\n   447\t        ;; sent, so it waits for an explicit reattachment decision.\n   448\t        (remote-terminal state)\n   449\t        (-> state\n   450\t            (update :queued conj line)\n   451\t            (publish :yin.repl.driver/notice\n   452\t                     \";; not connected: queued until (connect …) reattaches\"))\n   453\t\n   454\t        ;; `:unsent` is the RPC client's own retained envelope, and the\n   455\t        ;; authority on whether the request path is free: submitting here would\n   456\t        ;; resend it and discard this line.  `:retrying` is only the driver's\n   457\t        ;; record of which line that envelope carries.\n   458\t        (or (:outstanding state) (:retrying state) (remote-unsent? state))\n   459\t        (queue-line state line)\n   460\t\n   461\t        :else (submit-remote state line queue-line))\n   462\t\n   463\t      :else (evaluate-locally state line))))\n   464\t\n   465\t\n   466\t;; =============================================================================\n   467\t;; Remote completions\n   468\t;; =============================================================================\n   469\t\n   470\t(defn- completion-text\n   471\t  [event]\n   472\t  (case (:yin.repl.adapter/event event)\n   473\t    :yin.repl.adapter/response\n   474\t    (if (contains? event :yin.repl.adapter/error)\n   475\t      (str \"Error: \" (repl/format-value (:yin.repl.adapter/error event)))\n   476\t      (let [value (:yin.repl.adapter/value event)]\n   477\t        (if (string? value) value (repl/format-value value))))\n   478\t\n   479\t    :yin.repl.adapter/lost\n   480\t    (str \";; remote request \" (:yin.repl.adapter/id event) \" lost: \"\n   481\t         (pr-str (data/summarize (:yin.repl.adapter/reason event) diagnostic-bounds)))\n   482\t\n   483\t    (str \";; \" (pr-str (data/summarize event diagnostic-bounds)))))\n   484\t\n   485\t\n   486\t(defn- completion-event-kind\n   487\t  [event]\n   488\t  (if (= :yin.repl.adapter/response (:yin.repl.adapter/event event))\n   489\t    :yin.repl.driver/response\n   490\t    :yin.repl.driver/notice))\n   491\t\n   492\t\n   493\t(defn- clears-outstanding?\n   494\t  [state event]\n   495\t  (and (:outstanding state)\n   496\t       (contains? #{:yin.repl.adapter/response :yin.repl.adapter/lost}\n   497\t                  (:yin.repl.adapter/event event))\n   498\t       (= (:outstanding state) (:yin.repl.adapter/id event))))\n   499\t\n   500\t\n   501\t(defn- publish-adapter-events\n   502\t  \"Move the adapter's event outbox into the driver's, exactly once.\"\n   503\t  [state]\n   504\t  (let [[events adapter] (adapter/take-events (:adapter state))]\n   505\t    (reduce (fn [state event]\n   506\t              (-> state\n   507\t                  (cond-> (clears-outstanding? state event)\n   508\t                    (assoc :outstanding nil))\n   509\t                  (publish (completion-event-kind event) (completion-text event))))\n   510\t            (assoc state :adapter adapter)\n   511\t            events)))\n   512\t\n   513\t\n   514\t(defn- poll-remote\n   515\t  [state now]\n   516\t  (let [state (cond-> state\n   517\t                (:connection state) (update :connection connect/step! now))]\n   518\t    (if-not (:adapter state)\n   519\t      state\n   520\t      (let [result (adapter/poll-responses (:adapter state) response-budget)]\n   521\t        (publish-adapter-events (assoc state :adapter\n   522\t                                       (:yin.repl.adapter/state result)))))))\n   523\t\n   524\t\n   525\t(defn- observe-connection\n   526\t  \"Publish the con