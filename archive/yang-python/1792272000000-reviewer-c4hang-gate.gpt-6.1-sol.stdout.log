=====================================\n   571\t\n   572\t(defn repl-step\n   573\t  \"Advance the REPL once.  Called by exactly one ticker per host; never loops on\n   574\t   `:dao.stream/blocked`.  `now` is the host's clock reading, recorded but not\n   575\t   waited on: this layer has no deadline of its own.\"\n   576\t  [state now]\n   577\t  (let [state (assoc state :last-tick now)\n   578\t        state (retry-unsent state)\n   579\t        ;; Completions and lifecycle are observed before this tick's lines are\n   580\t        ;; handled, so a `(connect …)` typed in the same tick as the drop that\n   581\t        ;; makes it legal sees the terminal fact rather than being told the\n   582\t        ;; shell is already connected.\n   583\t        state (poll-remote state now)\n   584\t        state (observe-connection state)\n   585\t        [state lines] (drain-input state)\n   586\t        state (reduce handle-line state lines)]\n   587\t    (release-queue state)))\n   865\t               :clj Throwable\n   866\t               :cljs :default)\n   867\t            e\n   868\t       (if (ex-data e)\n   869\t         {:refusal (or (ex-message e) (str e))}\n   870\t         (throw e))))))\n   871\t\n   872\t\n   873\t(defn- refuse!\n   874\t  \"Print why the composition refused to start and end the process with a\n   875\t   failing status, so a refused startup never looks like a working shell.\"\n   876\t  [refusal]\n   877\t  (println refusal)\n   878\t  #?(:cljd (io/exit 1)\n   879\t     :clj (.halt (Runtime/getRuntime) 1)\n   880\t     :cljs (.exit js/process 1)))\n   881\t\n   882\t\n   883\t(defn- custody-of\n   884\t  [state]\n   885\t  (get-in state [:repl :custody]))\n   886\t\n   887\t\n   888\t(defn close-index-store!\n   889\t  \"Release the composition's lifecycle resources before the host exits:\n   890\t   the custody composition's journals first (compose/close! -- the\n   891\t   authority and every journal backend the composition opened; it never\n   892\t   throws, so a failed close never blocks the exit), then the index\n   893\t   store's own resources (in durable mode, the exclusive directory\n   894\t   lock).  The shell has already stopped when a host calls this; the\n   895\t   memory store has nothing to release.  A DHT store's head board and\n   896\t   dials have been asked to stop and drained by then (`stop-tick`);\n   897\t   `yin.repl.dht/close!` is the last resort for whatever the budget\n   898\t   left.\"\n   899\t  [state]\n   900\t  (when-some [c (custody-of state)]\n   901\t    (compose/close! c))\n   902\t  (repl.dht/close! (:repl state))\n   903\t  (store/close! (get-in state [:repl :index-store])))\n   904\t\n   905\t\n   906\t(defn- entry-text\n   907\t  [entry]\n   908\t  (or (get entry driver/text-key) (get entry serve/text-key)))\n   909\t\n   910\t\n   911\t(defn banner\n   912\t  \"Text the composition prints before the first prompt, given parsed\n   913\t   options.  A DHT store states here (before its node steps once, so\n   914\t   before anything is shared) what it will share: the whole store when\n   915\t   `--dht-publish` is given, nothing otherwise (yin.repl.dht/banner).\"\n31:   socket that cannot bind, refuses the shell (`refusal`); it never\n128:   `{:records {:version 1 :heads {principal trace}}}`, or `{:refusal\n139:      {:refusal (str \"heads file \" path \": it is not readable EDN\")}\n143:      {:refusal (str \"heads file \" path \": it is not a version-1 heads file\")}\n172:   `{:refusal text}`: a file that cannot be read, holds more than\n189:      (map? bs) {:refusal (str \"heads file \" path \": it cannot be read (\"\n191:      (nil? text) {:refusal (str \"heads file \" path \": it holds more than \"\n193:      (= ::invalid text) {:refusal (str \"heads file \" path\n199:      {:refusal (str \"heads file \" path \": it is not valid: a byte order \"\n218:   refusal is appended to `notes` for the step to print.\"\n257:   p}` with a loopback literal host, one per 