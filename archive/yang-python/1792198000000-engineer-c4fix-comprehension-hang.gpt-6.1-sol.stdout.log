pl.dht-process-test spawns it as the JVM-to-Node reader of\n   ;; DHT epic S5, a required leg: a missing build fails that test.\n   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl\")}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; Process B of the R5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.  The R5 cross-host tests spawn this one exe from the JVM\n   ;; and Node lanes, so `bb test` builds it first; a bare `bb test:clj` or\n   ;; `bb test:cljs` without it skips those tests with a printed notice\n   ;; rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:clojuredart:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  ;; Fast default lanes: no ^:slow test, no dao.test-slow/guard body.\n  test:clj {:doc \"JVM tests, fast: skips ^:slow ones; the DHT process test needs the Node REPL build\"\n            :depends [build:yin-repl-node gen:python-antlr]\n            :task (shell \"clojure -M:test -e :slow\")}\n\n  test:cljs {:doc \"Node tests, fast: dao.test-slow guarded bodies print SKIP; needs the Node REPL build\"\n             :depends [build:yin-repl-node]\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:cljd {:doc \"Dart tests, fast: aggregated shards via src/dev/cljd_agg.clj; guarded bodies print SKIP\"\n             :depends [build:yin-repl-peer]\n             :task (shell \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Every test, slow ones included (about 20+ minutes on the JVM).\n  test:all:clj {:doc \"Every JVM test, ^:slow included (20+ minutes); for unattended runs\"\n                :depends [build:yin-repl-node gen:python-antlr]\n                :task (shell \"clojure -M:test\")}\n\n  test:all:cljs {:doc \"Every Node test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-node]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n\n  test:all:cljd {:doc \"Every Dart test, guarded slow bodies included (sets DATOM_SLOW_TESTS=1)\"\n                 :depends [build:yin-repl-peer]\n                 :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                              \"bb src/dev/cljd_agg.clj\")}\n\n  ;; Only the slow tests. Node and Dart select by namespace, so the other\n  ;; tests inside the nine namespaces that use dao.test-slow/guard also run.\n  test:slow:clj {:doc \"Only the ^:slow JVM tests (about 14 minutes for long-loops-test); for unattended runs\"\n                 :depends [build:yin-repl-node gen:python-antlr]\n                 :task (shell \"clojure -M:test -i :slow\")}\n\n  test:slow:cljs {:doc \"Node: only namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-node]\n                  :task (let [re (-> (shell {:out :string}\n                                            \"bb src/dev/cljd_agg.clj --slow-regex\")\n                                     :out\n                                     clojure.string/trim)]\n                          (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                                 \"clj\" \"-M:cljs\" \"-m\" \"shadow.cljs.devtools.cli\"\n                                 \"compile\" \"test\" \"--config-merge\"\n                                 (str \"{:ns-regexp \\\"\" re \"\\\"}\")))}\n\n  test:slow:cljd {:doc \"Dart: only generated tests of namespaces with dao.test-slow/guard, bodies enabled (DATOM_SLOW_TESTS=1)\"\n                  :depends [build:yin-repl-peer]\n                  :task (shell {:extra-env {\"DATOM_SLOW_TESTS\" \"1\"}}\n                               \"bb src/dev/cljd_agg.clj --slow-only\")}\n\n  test:slow {:doc \"Only the slow tests on every lane: JVM by tag, Node and Dart by namespace\"\n             :depends [test:slow:clj test:slow:cljs test:slow:cljd]}\n\n  test:all {:doc \"Every test on every lane, slow ones included (JVM, Node, Dart)\"\n            :depends [test:all:clj test:all:cljs test:all:cljd]}\n\n  test {:doc \"All three lanes in their fast default form (JVM, Node, Dart)\"\n        :depends [build:yin-repl-peer build:yin-repl-node test:clj test:cljs test:cljd]}\n\n  ;; Only the tests a change can affect (src/dev/affected.clj): the\n  ;; reverse require closure of the changed files since the merge-base\n  ;; with master. Extra args pass through (--base REF, --changed FILE...).\n  ;; Exit 2 on a wide change (deps.edn, bb.edn, src/dev/, ...): run bb test.\n  test:changed {:doc \"Fast tests a change can affect, three lanes in parallel\"\n                :task (System/exit\n                        (:exit (apply shell {:continue true}\n                                      \"bb\" \"src/dev/affected.clj\"\n                                      *command-line-args*)))}\n\n  test:changed:clj {:doc \"JVM lane of test:changed\"\n                    :task (System/exit\n                            (:exit (apply shell {:continue true}\n                                          \"bb\" \"src/dev/affected.clj\"\n                                          \"--lane\" \"clj\" *command-line-args*)))}\n\n  test:changed:cljs {:doc \"Node lane of test:changed\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--lane\" \"cljs\"\n                                           *command-line-args*)))}\n\n  test:changed:cljd {:doc \"Dart lane of test:changed\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--lane\" \"cljd\"\n                                           *command-line-args*)))}\n\n  test:changed:list {:doc \"What test:changed would run and why; runs nothing\"\n                     :task (System/exit\n                             (:exit (apply shell {:continue true}\n                                           \"bb\" \"src/dev/affected.clj\"\n                                           \"--list\" *command-line-args*)))}\n\n  ;; Subsystem tests (src/dev/affected.clj): canonical subsystems defined\n  ;; in src/dev/subsystems.edn. Positional arguments name subsystems; flags\n  ;; pass through (--lane L, --list, --slow).\n  test:sub {:doc \"Subsystem tests, three lanes in parallel: bb test:sub <subsystem>... [--slow]\"\n            :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                 *command-line-args*)\n                        sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                    (System/exit\n                      (:exit (apply shell {:continue true}\n                                    \"bb\" \"src/dev/affected.clj\"\n                                    (concat sub-args flags)))))}\n\n  test:sub:clj {:doc \"JVM lane of test:sub: bb test:sub:clj <subsystem>... [--slow]\"\n                :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                     *command-line-args*)\n                            sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                        (System/exit\n                          (:exit (apply shell {:continue true}\n                                        \"bb\" \"src/dev/affected.clj\"\n                                        \"--lane\" \"clj\"\n                                        (concat sub-args flags)))))}\n\n  test:sub:cljs {:doc \"Node lane of test:sub: bb test:sub:cljs <subsystem>... [--slow]\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljs\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:cljd {:doc \"Dart lane of test:sub: bb test:sub:cljd <subsystem>... [--slow]\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--lane\" \"cljd\"\n                                         (concat sub-args flags)))))}\n\n  test:sub:list {:doc \"What test:sub would run, prerequisites and seams: bb test:sub:list <subsystem>...\"\n                 :task (let [[subs flags] (split-with (fn [arg] (not (clojure.string/starts-with? arg \"--\")))\n                                                      *command-line-args*)\n                             sub-args (mapcat (fn [s] [\"--subsystem\" s]) subs)]\n                         (System/exit\n                           (:exit (apply shell {:continue true}\n                                         \"bb\" \"src/dev/affected.clj\"\n                                         \"--list\"\n                                         (concat sub-args flags)))))}\n  }}\n","exit_code":0,"status":"completed"}}
