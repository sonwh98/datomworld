xpected (get results k)) (str k)))))\n    37\t\n    38\t\n    39\t(defn- lines\n    40\t  [& ls]\n    41\t  (apply str (map #(str % \"\\n\") ls)))\n    42\t\n    43\t\n    44\t;; =============================================================================\n    45\t;; S1 acceptance\n    46\t;; =============================================================================\n    47\t\n    48\t(deftest generator-while-loop-test\n   152\t;; S2 acceptance: send, throw, close and the dynamic context\n   153\t;; =============================================================================\n   154\t\n   155\t(deftest send-and-iterator-methods-test\n   156\t  (testing \"send of a non-None value to a just-started generator is a\n   157\t            TypeError before any switch; send(None) starts it; completion\n   158\t            through send is StopIteration; __iter__ is the generator itself\n   159\t            and __next__ advances it\"\n   160\t    (every-vm= (prints \"(\\\"can't send non-None value to a just-started generator\\\",)\"\n   161\t                       \"1\" \"got v\" \"2\" \"stop None\" \"True 1\")\n   162\t               (lines \"def g():\"\n   163\t                      \"    x = yield 1\"\n   164\t                      \"    print('got', x)\"\n   165\t                      \"    yield 2\"\n   166\t                      \"it = g()\"\n   167\t                      \"try:\"\n   168\t                      \"    it.send(5)\"\n   169\t                      \"except TypeError as e:\"\n   170\t                      \"    print(e.args)\"\n   171\t                      \"print(it.send(None))\"\n   172\t                      \"print(it.send('v'))\"\n   173\t                      \"try:\"\n   174\t                      \"    it.send('w')\"\n   175\t                      \"except StopIteration as e:\"\n   176\t                      \"    print('stop', e.value)\"\n   177\t                      \"it = g()\"\n   178\t                      \"print(it.__iter__() is it, it.__next__())\"))))\n   179\t\n   180\t\n   181\t(deftest throw-caught-at-yield-site-test\n   182\t  (testing \"throw raises at the yield on the generator's own stack, so its\n   183\t            try catches it and the next yield is throw's value; the class\n   184\t            is called with the value, a tuple spread, an instance of it\n   185\t            used as is; an instance with a value, a traceback, or a\n   186\t            non-exception is a TypeError in the caller\"\n   187\t    (every-vm= (prints \"1\" \"caught ('boom',)\" \"recovered\"\n   188\t                       \"1\" \"caught ('again',)\" \"recovered\"\n   189\t                       \"1\" \"caught ('a', 'b')\" \"recovered\"\n   190\t                       \"1\" \"caught ('z',)\" \"recovered\"\n   191\t                       \"('instance exception may not have a separate value',)\"\n   192\t                       \"('throw() third argument must be a traceback object',)\"\n   193\t                       \"not exc\" \"1\")\n   194\t               (lines \"def g():\"\n   195\t                      \"    while True:\"\n   196\t                      \"        try:\"\n   197\t                      \"            yield 1\"\n   198\t                      \"        except ValueError as e:\"\n   199\t                      \"            print('caught', e.args)\"\n   200\t                      \"            yield 'recovered'\"\n   201\t                      \"it = g()\"\n   202\t                      \"print(next(it))\"\n   203\t                      \"print(it.throw(ValueError, 'boom'))\"\n   204\t                      \"print(next(it))\"\n   205\t                      \"print(it.throw(ValueError('again')))\"\n   206\t                      \"print(next(it))\"\n   207\t                      \"print(it.throw(ValueError, ('a', 'b')))\"\n   208\t                      \"print(next(it))\"\n   209\t                      \"print(it.throw(ValueError, ValueError('z')))\"\n   210\t                      \"try:\"\n   211\t                      \"    it.throw(ValueError('x'), 'y')\"\n   212\t                      \"except TypeError as e:\"\n   213\t                      \"    print(e.args)\"\n   214\t                      \"try:\"\n   215\t                      \"    it.throw(ValueError, None, 5)\"\n   216\t                      \"except TypeError as e:\"\n   217\t                      \"    print(e.args)\"\n   218\t                      \"try:\"\n   219\t                      \"    it.throw(5)\"\n   220\t                      \"except TypeError as e:\"\n   221\t                      \"    print('not exc')\"\n   222\t                      \"print(next(it))\"))))\n   223\t\n   224\t\n   225\t(deftest throw-uncaught-and-unstarted-test\n   226\t  (testing \"an uncaught throw runs the generator's finally, closes it and\n   227\t            raises in the caller; a closed generator raises what is thrown;\n   228\t            a just-started one closes without running its body\"\n   229\t    (every-vm= (prints \"caller ('k',) ['ran', 'fin']\" \"done\" \"closed ('again',)\"\n   230\t                       \"fresh ('x',) ['ran', 'fin']\" \"closed\")\n   231\t               (lines \"log = []\"\n   232\t                      \"def g():\"\n   233\t                      \"    log.append('ran')\"\n   234\t                      \"    try:\"\n   235\t                      \"        yield 1\"\n   236\t                      \"        yield 2\"\n   237\t                      \"    finally:\"\n   238\t                      \"        log.append('fin')\"\n   239\t                      \"it = g()\"\n   240\t                      \"next(it)\"\n   241\t                      \"try:\"\n   242\t                      \"    it.throw(KeyError, 'k')\"\n   243\t                      \"except KeyError as e:\"\n   244\t                      \"    print('caller', e.args, log)\"\n   245\t                      \"print(next(it, 'done'))\"\n   246\t                      \"try:\"\n   247\t                      \"    it.throw(KeyError('again'))\"\n   248\t                      \"except KeyError as e:\"\n   249\t                      \"    print('closed', e.args)\"\n   250\t                      \"it = g()\"\n   251\t                      \"try:\"\n   252\t                      \"    it.throw(ValueError('x'))\"\n   253\t                      \"except ValueError as e:\"\n   254\t                      \"    print('fresh', e.args, log)\"\n   255\t                      \"print(next(it, 'closed'))\"))))\n   256\t\n   257\t\n   258\t(deftest close-runs-finally-test\n   259\t  (testing \"close runs the finally around the yield and answers None; it is\n   260\t            idempotent; closing a just-started generator runs nothing;\n   261\t            except Exception does not catch GeneratorExit\"\n   262\t    (every-vm= (prints \"1\" \"None ['fin']\" \"None ['fin']\" \"closed\"\n   263\t                       \"None ['fin']\" \"closed\" \"d fin\" \"None\")\n   264\t               (lines \"log = []\"\n   265\t                      \"def g():\"\n   266\t                      \"    try:\"\n   267\t                      \"        yield 1\"\n   268\t                      \"        yield 2\"\n   269\t                      \"    finally:\"\n   270\t                      \"        log.append('fin')\"\n   271\t                      \"it = g()\"\n   272\t                      \"print(next(it))\"\n   273\t                      \"print(it.close(), log)\"\n   274\t                      \"print(it.close(), log)\"\n   275\t                      \"print(next(it, 'closed'))\"\n   276\t                      \"it2 = g()\"\n   277\t                      \"print(it2.close(), log)\"\n   278\t                      \"print(next(it2, 'closed'))\"\n   279\t                      \"def d():\"\n   280\t                      \"    try:\"\n   281\t                      \"        yield 1\"\n   282\t                      \"    except Exception:\"\n   283\t                      \"        print('wrong')\"\n   284\t                      \"    finally:\"\n   285\t                      \"        print('d fin')\"\n   286\t                      \"x = d()\"\n   287\t                      \"next(x)\"\n   288\t                      \"print(x.close())\"))))\n   289\t\n   290\t\n   291\t(deftest close-outcomes-test\n   292\t  (testing \"a return after GeneratorExit is None; another exception\n   293\t            propagates; a yield is RuntimeError and the generator stays\n   294\t            suspended, so it advances and closes later; GeneratorExit is a\n   295\t            BaseException but not an Exception\"\n   296\t    (every-vm= (prints \"a exit\" \"None\" \"propagated ('from close',)\" \"closed\"\n   297\t                       \"0\" \"c ignores 1\" \"('generator ignored GeneratorExit',)\"\n   298\t                       \"1\" \"c ignores 2\" \"None\" \"closed\" \"True False\")\n   299\t               (lines \"def a():\"\n   300\t                      \"    try:\"\n   301\t                      \"        yield 1\"\n   302\t                      \"    except GeneratorExit:\"\n   303\t                      \"        print('a exit')\"\n   304\t                      \"        return 5\"\n   305\t                      \"def b():\"\n   306\t                      \"    try:\"\n   307\t                      \"        yield 1\"\n   308\t                      \"    except GeneratorExit:\"\n   309\t                      \"        raise ValueError('from close')\"\n   310\t                      \"def c():\"\n   311\t                      \"    n = 0\"\n   312\t                      \"    while True:\"\n   313\t                      \"        try:\"\n   314\t                      \"            yield n\"\n   315\t                      \"        except GeneratorExit:\"\n   316\t                      \"            n += 1\"\n   317\t                      \"            print('c ignores', n)\"\n   318\t                      \"            if n == 2:\"\n   319\t                      \"                return\"\n   320\t                      \"x = a()\"\n   321\t                      \"next(x)\"\n   322\t                      \"print(x.close())\"\n   323\t                      \"y = b()\"\n   324\t                      \"next(y)\"\n   325\t                      \"try:\"\n   326\t                      \"    y.close()\"\n   327\t                      \"except ValueError as e:\"\n   328\t                      \"    print('propagated', e.args)\"\n   329\t                      \"print(next(y, 'closed'))\"\n   330\t                      \"z = c()\"\n   331\t                      \"print(next(z))\"\n   332\t                      \"try:\"\n   333\t                      \"    z.close()\"\n   334\t                      \"except RuntimeError as e:\"\n   335\t                      \"    print(e.args)\"\n   336\t                      \"print(next(z))\"\n   337\t                      \"print(z.close())\"\n   338\t                      \"print(next(z, 'closed'))\"\n   339\t                      \"print(isinstance(GeneratorExit(), BaseException),\"\n   340\t                      \"      isinstance(GeneratorExit(), Exception))\"))))\n   341\t\n   342\t\n   343\t(deftest generator-already-executing-test\n   344\t  (testing \"next, send, throw and close on a running generator are a\n   345\t            ValueError in its own body before any switch; uncaught, it\n   346\t            leaves the generator for the caller and closes it\"\n   347\t    (every-vm= (prints \"('generator already executing',)\"\n   348\t                       \"('generator already executing',)\"\n   349\t                       \"('generator already executing',)\"\n   350\t                       \"('generator already executing',)\"\n   351\t                       \"1\" \"caller ('generator already executing',)\" \"closed\")\n   352\t               (lines \"def g():\"\n   353\t                      \"    for f in [lambda: next(me), lambda: me.send(1),\"\n   354\t                      \"              lambda: me.throw(KeyError), lambda: me.close()]:\"\n   355\t                      \"        try:\"\n   356\t                      \"            f()\"\n   357\t                      \"        except ValueError as e:\"\n   358\t                      \"            print(e.args)\"\n   359\t                      \"    yield 1\"\n   360\t                      \"    me.send(None)\"\n   361\t                      \"me = g()\"\n   362\t                      \"print(next(me))\"\n   363\t                      \"try:\"\n   364\t                      \"    next(me)\"\n   365\t                      \"except ValueError as e:\"\n   366\t                      \"    print('caller', e.args)\"\n   367\t                      \"print(next(me, 'closed'))\"))))\n   368\t\n   369\t\n   370\t(deftest pep-479-test\n   371\t  (testing \"a StopIteration escaping the body, raised, from an inner next,\n   372\t            or thrown in, is RuntimeError; one caught inside is not\"\n   373\t    (every-vm= (prints \"1\" \"('generator raised StopIteration',)\" \"closed\"\n   374\t                       \"list ('generator raised StopIteration',)\" \"['ok']\"\n   375\t                       \"thrown ('generator raised StopIteration',)\")\n   376\t               (lines \"def g():\"\n   377\t                      \"    yield 1\"\n   378\t                      \"    raise StopIteration(9)\"\n   379\t                      \"it = g()\"\n   380\t                      \"print(next(it))\"\n   381\t                      \"try:\"\n   382\t                      \"    next(it)\"\n   383\t                      \"except RuntimeError as e:\"\n   384\t                      \"    print(e.args)\"\n   385\t                      \"print(next(it, 'closed'))\"\n   386\t                      \"def empty():\"\n   387\t                      \"    return\"\n   388\t                      \"    yield\"\n   389\t                      \"def h():\"\n   390\t                      \"    yield next(empty())\"\n   391\t                      \"try:\"\n   392\t                      \"    print(list(h()))\"\n   393\t                      \"except RuntimeError as e:\"\n   394\t                      \"    print('list', e.args)\"\n   395\t                      \"def k():\"\n   396\t                      \"    try:\"\n   397\t                      \"        next(empty())\"\n   398\t                      \"    except StopIteration:\"\n   399\t                      \"        yield 'ok'\"\n   400\t                      \"print(list(k()))\"\n   401\t                      \"def t():\"\n   402\t                      \"    yield 1\"\n   403\t                      \"it = t()\"\n   404\t                      \"next(it)\"\n   405\t                      \"try:\"\n   406\t                      \"    it.throw(StopIteration)\"\n   407\t                      \"except RuntimeError as e:\"\n   408\t                      \"    print('thrown', e.args)\"))))\n   409\t\n   410\t\n   411\t(deftest with-around-yield-test\n   412\t  (testing \"a with around a yield exits on close, on a thrown exception\n   413\t            and on completion; an __exit__ that suppresses a thrown\n   414\t            exception lets the generator run on to its next yield\"\n   415\t    (every-vm= (prints \"enter a\" \"1\" \"exit a False\" \"None\"\n   416\t                       \"enter a\" \"1\" \"exit a False\" \"caller ('k',)\"\n   417\t                       \"enter a\" \"exit a True\" \"[1, 2]\"\n   418\t                       \"quiet ('v',)\" \"after\")\n   419\t               (lines \"class CM:\"\n   420\t                      \"    def __init__(self, name):\"\n   421\t                      \"        self.name = name\"\n   422\t                      \"    def __enter__(self):\"\n   423\t                      \"        print('enter', self.name)\"\n   424\t                      \"        return self\"\n   425\t                      \"    def __exit__(self, t, v, tb):\"\n   426\t                      \"        print('exit', self.name, t is None)\"\n   427\t                      \"        return False\"\n   428\t                      \"class Quiet:\"\n   429\t                      \"    def __enter__(self):\"\n   430\t                      \"        return self\"\n   431\t                      \"    def __exit__(self, t, v, tb):\"\n   432\t                      \"        print('quiet', v.args)\"\n   433\t                      \"        return True\"\n   434\t                      \"def g():\"\n   435\t                      \"    with CM('a'):\"\n   436\t                      \"        yield 1\"\n   437\t                      \"        yield 2\"\n   438\t                      \"it = g()\"\n   439\t                      \"print(next(it))\"\n   440\t                      \"print(it.close())\"\n   441\t                      \"it = g()\"\n   442\t                      \"print(next(it))\"\n   443\t                      \"try:\"\n   444\t                      \"    it.throw(KeyError('k'))\"\n   445\t                      \"except KeyError as e:\"\n   446\t                      \"    print('caller', e.args)\"\n   447\t                      \"print(list(g()))\"\n   448\t                      \"def q():\"\n   449\t                      \"    with Quiet():\"\n   450\t                      \"        yield 1\"\n   451\t                      \"    yield 'after'\"\n   452\t                      \"it = q()\"\n   453\t                      \"next(it)\"\n   454\t                      \"print(it.throw(ValueError('v')))\"))))\n   455\t\n   456\t\n   457\t(deftest suspension-during-unwinding-test\n   458\t  (testing \"a nested generator closed from an outer one's handler, the throw\n   459\t            driven from a different caller depth; a yield inside a finally\n   460\t            that a throw or close is unwinding suspends the unwinding, and\n   461\t            the next resume finishes it and re-raises in the caller\"\n   462\t    (every-vm= (prints \"i1\" \"outer caught\" \"inner fin\" \"o3\" \"end\"\n   463\t                       \"cleanup\" \"after cleanup\" \"rethrown ('v',)\"\n   464\t                       \"('generator ignored GeneratorExit',)\" \"after cleanup\"\n   465\t                       \"exit escaped\" \"closed\")\n   466\t               (lines \"def inner():\"\n   467\t                      \"    try:\"\n   468\t                      \"        yield 'i1'\"\n   469\t                      \"    finally:\"\n   470\t                      \"        print('inner fin')\"\n   471\t                      \"def outer():\"\n   472\t                      \"    i = inner()\"\n   473\t                      \"    try:\"\n   474\t                      \"        yield next(i)\"\n   475\t                      \"        yield 'o2'\"\n   476\t                      \"    except KeyError:\"\n   477\t                      \"        print('outer caught')\"\n   478\t                      \"        i.close()\"\n   479\t                      \"        yield 'o3'\"\n   480\t                      \"def drive(it):\"\n   481\t                      \"    return it.throw(KeyError)\"\n   482\t                      \"o = outer()\"\n   483\t                      \"print(next(o))\"\n   484\t                      \"print(drive(o))\"\n   485\t                      \"print(next(o, 'end'))\"\n   486\t                      \"def u():\"\n   487\t                      \"    try:\"\n   488\t                      \"        yield 1\"\n   489\t                      \"    finally:\"\n   490\t                      \"        yield 'cleanup'\"\n   491\t                      \"        print('after cleanup')\"\n   492\t                      \"it = u()\"\n   493\t                      \"next(it)\"\n   494\t                      \"print(it.throw(ValueError('v')))\"\n   495\t                      \"try:\"\n   496\t                      \"    next(it)\"\n   497\t                      \"except ValueError as e:\"\n   498\t                      \"    print('rethrown', e.args)\"\n   499\t                      \"it = u()\"\n   500\t                      \"