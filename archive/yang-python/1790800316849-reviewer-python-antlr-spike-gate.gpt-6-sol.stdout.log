println (re-find #\"\\\"sha\\\":\\s*\\\"[0-9a-f]{40}\\\"\" body))\n235:      (let [url (str \"https://api.github.com/repos/\" (:repo grammar)\n12:        ;; yang.python.antlr: the runtime the generated Python3 parser runs\n13:        ;; on; pinned to the tool version in :antlr-gen (they are one release)\n14:        org.antlr/antlr4-runtime {:mvn/version \"4.13.2\"}\n20: ;; build/antlr/python3/classes: the generated Python3 parser, produced by\n21: ;; `clj -M:antlr-gen` (antlr/python3/manifest.edn); absent until generated\n23:         \"build/antlr/python3/classes\"]\n73:           ;; The tool version must equal the antlr4-runtime above.\n74:           :antlr-gen {:extra-paths [\"src/dev\"]\n75:                       :extra-deps {org.antlr/antlr4 {:mvn/version \"4.13.2\"}}\n76:                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n109:;; clj -M:test -n yang.python-test\n","exit_code":0,"status":"completed"}}
