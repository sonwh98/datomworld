s u]\n    [yin.vm :as vm]\n    [yin.vm.data :as data]\n    [yin.vm.module :as module]\n    [yin.vm.linker.interpreter :as link]))\n\n\n;; =============================================================================\n;; The fast tests: the lowering, before anything links\n;; =============================================================================\n\n(defn- nodes\n  \"Every node of map AST `ast`.\"\n  [ast]\n  (tree-seq map?\n            (fn [n] (filter map? (mapcat #(if (vector? %) % [%]) (vals n))))\n            ast))\n\n\n(defn- in-order\n  \"The nodes of map AST `ast` in evaluation order: an application after\n   its operands and its operator, a lambda operator's body (run once the\n   operands are bound) after the operands. `nodes` has no order.\"\n  [ast]\n  (letfn [(walk\n            [n]\n            (when (map? n)\n              (case (:type n)\n                :application (concat (mapcat walk (:operands n))\n                                     (walk (:operator n))\n                                     [n])\n                :lambda (cons n (walk (:body n)))\n                (cons n (mapcat walk\n                                (filter map?\n                                        (mapcat #(if (vector? %) % [%])\n                                                (vals n))))))))]\n    (walk ast)))\n\n\n(defn- requires-of\n  \"The literal module names the linked program's hoisted `(require 'm)`\n   applications name, in evaluation order.\"\n  [ast]\n  (vec (keep (fn [n]\n               (when (and (= :application (:type n))\n                          (= 'require (get-in n [:operator :name])))\n                 (get-in n [:operands 0 :value])))\n             (in-order ast))))\n\n\n(defn- call-sites\n  \"The applications of `op` in map AST `ast`.\"\n  [ast op]\n  (filter #(and (= :application (:type %))\n                (= op (get-in % [:operator :name])))\n          (nodes ast)))\n\n\n(defn- def-key\n  \"The literal key of a `(yin/def k v)` application node, else nil.\"\n  [node]\n  (when (and (map? node)\n             (= :application (:type node))\n             (= 'yin/def (get-in node [:operator :name])))\n    (get-in node [:operands 0 :value])))\n\n\n(ns yang.python.antlr.uast\n  \"Universal AST constructors for the Python lowering and its prelude. Every\n   function returns a canonical map node (`:literal`, `:variable`, `:lambda`,\n   `:application`, `:if`, `:vm/current-continuation`); nothing here adds a\n   node type.\n\n   `sexp->uast` reads a small s-expression notation into those same nodes so\n   the prelude can be written legibly:\n\n     symbol            -> :variable\n     (fn [params] b)   -> :lambda\n     (if t c a)        -> :if\n     (do a b ... z)    -> sequencing through one-parameter lambdas\n     (let [x v ...] b) -> nested immediately applied lambdas\n     (quote x)         -> :literal x\n     (%capture)        -> :vm/current-continuation\n     (yin/def k v)     -> the definition application\n     (f a ...)         -> :application\n     any other value   -> :literal\"\n  (:require\n    [yang.tails :as tails]))\n\n\n(defn lit\n  [x]\n  {:type :literal, :value x})\n\n\n(defn v\n  [sym]\n  {:type :variable, :name sym})\n\n\n(defn lam\n  [params body]\n  {:type :lambda, :params (vec params), :body body})\n\n\n(defn app\n  [op & args]\n  {:type :application, :operator op, :operands (vec args)})\n\n\n(defn if-node\n  [t c a]\n  {:type :if, :test t, :consequent c, :alternate a})\n\n\n(def capture {:type :vm/current-continuation})\n\n\n(defn def!\n  \"`(yin/def key value)`: key is a literal symbol.\"\n  [key value]\n  (app (v 'yin/def) (lit key) value))\n\n\n(def discard\n  \"The parameter a sequencing lambda binds and ignores. `%` cannot begin a\n   Python identifier, so it never shadows a guest name.\"\n  '%_)\n\n\n(defn then\n  \"Evaluate `a` for effect, then `b`.\"\n  [a b]\n  (app (lam [discard] b) a))\n\n\n(defn seq-nodes\n  \"Evaluate every node in order; the value is the last one's.\"\n  [nodes]\n  (reduce (fn [acc node] (then acc node)) (first nodes) (rest nodes)))\n\n\n(defn let1\n  [sym value body]\n  (app (lam [sym] body) value))\n\n\n(defn sexp->uast\n  [form]\n  (cond\n    (symbol? form) (v form)\n    (seq? form)\ndiff --git a/src/cljc/yang/python/antlr/lower.cljc b/src/cljc/yang/python/antlr/lower.cljc\nindex d6e61273..e0089b53 100644\n--- a/src/cljc/yang/python/antlr/lower.cljc\n+++ b/src/cljc/yang/python/antlr/lower.cljc\n@@ -1973,6 +1973,19 @@\n   '#{spec body})\n \n \n+(defn- validate-module-name!\n+  [name]\n+  (when (or (empty? name)\n+            (str/starts-with? name \".\")\n+            (str/ends-with? name \".\")\n+            (str/includes? name \"..\")\n+            (str/includes? name \"$\"))\n+    (throw (ex-info \"a module name is dotted identifiers\"\n+                    {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n+                     :construct \"malformed module name\",\n+                     :name name}))))\n+\n+\n (defn module-packet\n   \"One ok packet as the linker module `pym.<mangled>`: one wide\n    application whose operands are `(require 'py)`, then the spec and\n@@ -1985,15 +1998,7 @@\n    body is the same form `lower-packet` runs as `__main__`: one code\n    image, two roles.\"\n   [packet {:keys [name package?]}]\n-  (when (or (empty? name)\n-            (str/starts-with? name \".\")\n-            (str/ends-with? name \".\")\n-            (str/includes? name \"..\")\n-            (str/includes? name \"$\"))\n-    (throw (ex-info \"a module name is dotted identifiers\"\n-                    {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n-                     :construct \"malformed module name\",\n-                     :name name})))\n+  (validate-module-name! name)\n   (let [unit {:name name, :package? (boolean package?)}\n         defs [(u/def! 'spec (u/lit unit))\n               (u/def! 'body (u/lam [globals-sym globals-fn-sym]\n@@ -2102,6 +2107,8 @@\n    requiring aliases. Only py and outgoing imports are pinned by the bundle.\n    Alias :requires is filled with the bundle address after publication.\"\n   [registry units py-address deps]\n+  (doseq [{:keys [name]} units]\n+    (validate-module-name! name))\n   (let [units (vec (sort-by :name units))\n         deps (apply dissoc deps (map :name units))\n         bundle-name (symbol (str \"pyscc.\" (str/join \"$$\" (map #(str/replace (:name %) \".\" \"$\") units))))\n@@ -2109,9 +2116,6 @@\n                             (fn [i unit]\n                               [(:name unit) [(symbol (str \"m\" i \"-spec\"))\n                                              (symbol (str \"m\" i \"-body\"))]]) units))\n-        cell-syms (into {} (map-indexed\n-                             (fn [i unit]\n-                               [(:name unit) (symbol (str \"%cell-m\" i))]) units))\n         units-by-name (into {} (map (fn [u] [(:name u) u]) units))\n         internal (set (map module-symbol (keys keys-for)))\n         rewrite (fn [node]\n@@ -2130,8 +2134,8 @@\n                          (contains? internal (symbol (namespace (:name node))))\n                          (= \"body\" (name (:name node))))\n                     (let [nm (subs (namespace (:name node)) 4)\n-                          cs (get cell-syms nm)]\n-                      (app* 'cell/get (u/v cs)))\n+                          [_ body-key] (get keys-for nm)]\n+                      (u/v body-key))\n                     (and (= :application (:type node))\n                          (= 'try-require (get-in node [:operator :name]))\n                          (contains? internal (get-in node [:operands 0 :value])))\n@@ -2160,28 +2164,14 @@\n                         unit {:name name, :package? (boolean package?)}]\n                     [(u/def! spec-key (u/lit unit))]))\n                 units)\n-        cell-inits\n-        (map (fn [_] (app* 'cell/new none)) units)\n-        cell-sets\n-        (mapv (fn [{:keys [name]} body]\n-                (let [cs (get cell-syms name)]\n-                  (app* 'cell/set! (u/v cs) body)))\n-              units wrapped-bodies)\n         body-defs\n-        (mapcat (fn [{:keys [name]}]\n-                  (let [[_ body-key] (get keys-for name)\n-                        cs (get cell-syms name)]\n-                    [(u/def! body-key (app* 'cell/get (u/v cs)))]))\n-                units)\n-        defs-expr\n-        (apply u/app\n-               (u/lam (mapv #(get cell-syms (:name %)) units)\n-                      (u/seq-nodes\n-                        (concat cell-sets\n-                                spec-defs\n-                                body-defs)))\n-               cell-inits)\n-        ast (module-tree [(require-node prelude/module-name) defs-expr])\n+        (map (fn [{:keys [name]} body]\n+               (let [[_ body-key] (get keys-for name)]\n+                 (u/def! body-key body)))\n+             units wrapped-bodies)\n+        ast (module-tree (concat [(require-node prelude/module-name)]\n+                                 spec-defs\n+                                 body-defs))\n         exports (set (mapcat val keys-for))\n         requires (into {prelude/module-name py-address}\n                        (map (fn [[n a]] [(module-symbol n) a])) deps)\n","exit_code":0,"status":"completed"}}
