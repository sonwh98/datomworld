913\t     (fn [xs x i]\n   914\t       (let [y (get xs i :py/stop)]\n   915\t         (if (= y :py/stop) false (if (py/eq y x) true (py/seq-contains? xs x (+ i 1))))))]\n   916\t    [py/contains\n   917\t     ;; `x in c`\n   918\t     (fn [c x]\n   919\t       (if (py/str? c)\n   920\t         (if (py/str? x)\n   921\t           (not (nil? (data/str-index-of (get c :py/str) (get x :py/str))))\n   922\t           (py/type-error {:py/str \"'in <string>' requires string as left operand\"}))\n   923\t         (let [k (py/kind c)]\n   924\t           (if (if (= k :dict) true (= k :set))\n   925\t             (py/dict-has? c x)\n   926\t             (if (if (= k :range) (py/int? x) false)\n   927\t               (py/range-has? c (py/num x))\n  1250\t           (+ (py/range-elem start step (- i 1)) step)\n  1251\t           (py/range-elem start (+ step step) (py/int-floordiv i 2)))))]\n  1252\t    [py/range-at\n  1253\t     ;; a valid element is exact (range-elem); the one-past element may\n  1254\t     ;; exceed 2^53 on JS, but its true value is beyond stop and rounding is\n  1255\t     ;; monotone, so the bound test still ends the range exactly there\n  1256\t     (fn [r i]\n  1257\t       (let [x (py/range-elem (get r :start) (get r :step) i)]\n  1258\t         (if (if (< 0 (get r :step)) (< x (get r :stop)) (> x (get r :stop)))\n  1259\t           x\n  1260\t           :py/stop)))]\n  1261\t    [py/range-len\n  1262\t     ;; O(1); a length beyond 2^53 is an OverflowError, as len() of such a\n  1263\t     ;; range is in CPython\n  1264\t     (fn [r _i] (py/range-count (get r :start) (get r :stop) (get r :step)))]\n  1265\t    [py/iter-at\n  1266\t     (fn [it i]\n  1267\t       (if (py/cell? it)\n  1268\t         (let [c (cell/get it)\n  1269\t               t (get c :py/type)]\n  1270\t           (if (= t :list)\n  1271\t             (get (get c :items) i :py/stop)\n  1272\t             (if (if (= t :dict) true (= t :set))\n  1273\t               (get (get c :keys) i :