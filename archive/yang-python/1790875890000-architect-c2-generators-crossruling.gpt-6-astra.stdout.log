text.\"\n  1001\t  [ctx scope-node fname {:keys [params defaults star? kwonly kwdefaults kwstar?]}\n  1002\t   body-fn]\n  1003\t  (let [s (get-in (:analysis ctx) [:scopes (:id scope-node)])\n  1004\t        all-params (:params s)\n  1005\t        _ (when-not (= (count all-params) (count (distinct all-params)))\n  1006\t            (syntax! scope-node \"duplicate argument in function definition\"))\n  1007\t        args (gen \"args\" scope-node)\n  1008\t        others (drop (count all-params) (:locals s))\n  1009\t        body (body-fn (assoc ctx\n  1010\t                             :scope (:id scope-node)\n  1011\t                             :loop nil\n  1012\t                             :exc nil\n  1013\t                             :class nil))\n  1014\t        cells (concat (map-indexed (fn [i _]\n  1015\t                                     (app* 'cell/new\n  1016\t                                           (app* 'py/arg (u/v args) (u/lit i))))\n  1017\t                                   all-params)\n  1018\t                      (map (fn [_] (app* 'cell/new (u/lit :py/unbound)))\n  1019\t                           others))]\n  1020\t    (app* 'py/make-function\n  1021\t          (u/lit fname)\n  1022\t          (u/lit (cond-> {:params params}\n  1023\t                   star? (assoc :star? true)\n  1024\t                   (seq kwonly) (assoc :kwonly kwonly)\n  1025\t                   kwstar? (assoc :kwstar? true)))\n  1026\t          (build-vector (map #((:lower ctx) ctx %) defaults))\n  1027\t          (build-vector (map (fn [[nm d]]\n  1028\t                               (build-vector [(u/lit nm) ((:lower ctx) ctx d)]))\n  1029\t                             kwdefaults))\n  1030\t          (u/lam [args]\n  1031\t                 (if (seq (:locals s))\n  1032\t                   (apply u/app (u/lam (map symbol (:locals s)) body) cells)\n  1033\t                   body)))))\n  1034\t\n  1035\t\n  1036\t(defn- lower-funcdef\n  1037\t  [ctx n]\n  1038\t  (let [ks (kids ctx n)\n  1039\t        nm (name-of ctx (first (rules ctx n \"name\")))\n  1040\t        params (first (rules ctx n \"parameters\"))]\n  1937\t              work (pop work)]\n  1938\t          (if (or (scalar? x) (contains? seen entry))\n  1939\t            (recur work seen found)\n  1940\t            (let [id (when (map? x) (heap-ref-id heap x))\n  1941\t                  new-id? (and (some? id) (not (contains? found id)))\n  1942\t                  children (when (and (= :kernel mode)\n  1943\t                                      (not (values/host-typed? x)))\n  1944\t                             (children-of x))\n  1945\t                  work (cond-> work\n  1946\t                         (and new-id? follow?)\n  1947\t                         (conj [:data (:value (get heap id))])\n  1948\t                         (values/host-typed? x)\n  1949\t                         (conj [:kernel (values/payload x)])\n  1950\t                         (some? children)\n  1951\t                         (-> (moded :kernel (:kernel children))\n  1952\t                             (moded :data (:values children)))\n  1953\t                         (and (nil? children) (map? x))\n  1954\t                         (-> (moded :data (keys x))\n  1955\t                             (moded :data (vals x)))\n  1956\t                         (and (nil? children) (not (map? x)) (coll? x))\n  1957\t                         (moded :data x))]\n  1982\t\n  1983\t(defn- mark\n  1984\t  \"The ids of `heap` live from `roots` and from the `pinned` ids: a pinned\n  1985\t   cell is a root, so its content is traced too, as data.\"\n  1986\t  [vm heap roots pinned]\n  1987\t  (let [pins (filterv #(contains? heap %) pinned)]\n  1988\t    (trace vm\n  1989\t           heap\n  1990\t           (update roots :data into (map #(:value (get heap %))) pins)\n  1991\t           (set pins)\n  1992\t           true)))\n  1993\t\n  1994\t\n  2037\t\n  2038\t\n  2039\t(defn pin-refs\n  2040\t  \"`s