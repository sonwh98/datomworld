    74	(defn- ok-packet!
    75	  [packet]
    76	  (if (= :yang.cst/ok (:yang.cst/outcome packet))
    77	    packet
    78	    (throw (ex-info
    79	             (let [e (first (:yang.cst/errors packet))]
    80	               (str "SyntaxError: " (:message e)
    81	                    (when (:line e) (str " (line " (:line e) ")"))))
    82	             {:yang.python.antlr/diagnostic :yang.python.antlr/syntax
    83	              :errors (:yang.cst/errors packet)}))))
