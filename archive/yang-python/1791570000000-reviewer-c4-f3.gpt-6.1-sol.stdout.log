  1822	(defn- fold-queued
  1823	  "Evaluate the lines retained while a require was pending, in the order
  1824	   they were typed, each exactly once, and join their texts.  A line that
  1825	   parks the shell on a require of its own stops the fold: the lines
  1826	   after it stay retained, in order, on the new `:pending-run`."
  1827	  [[state text] queued]
  1828	  (loop [state state
  1829	         text text
  1830	         [in & more :as queued] (seq queued)]
  1831	    (cond
  1832	      (empty? queued) [state text]
  1833	      (:pending-run state) [(update-in state [:pending-run :pending-lines]
  1834	                                       (fnil into []) queued)
  1835	                            text]
  1836	      :else (let [[state' text'] (eval-parsed* state
  1837	                                               (:trimmed in)
  1838	                                               (:parsed in))]
  1839	              (recur state' (str text "\n" text') more)))))
