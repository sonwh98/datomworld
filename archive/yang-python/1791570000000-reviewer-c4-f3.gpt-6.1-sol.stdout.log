  1803	(defn- eval-parsed*
  1804	  "The parse dispatch of one line, against a shell with no require to
  1805	   re-check."
  1806	  [state trimmed parsed]
  1807	  (try
  1808	    (let [forms (:forms parsed)
  1809	          form (when (= 1 (count forms)) (first forms))]
  1810	      (cond
  1811	        (and form (command-form? form)) (handle-command state form)
  1812	        (and form (datom-stream? form)) (eval-program state (vec form))
  1813	        (and form (ast-map? form)) (eval-program state form)
  1814	        forms (eval-compiled state (compile-input state trimmed forms))
  1815	        (forms-input? state) [state (format-error (:error parsed))]
  1816	        :else (eval-compiled state (compile-source state trimmed))))
  1817	    (catch #?(:cljd Object :clj Exception :cljs js/Error) error
  1818	      (let [[state' output-text] (drain-output state)]
  1819	        [state' (str output-text (format-error error))]))))
