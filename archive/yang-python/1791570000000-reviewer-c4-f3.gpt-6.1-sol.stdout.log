    86	(defn lower-session
    87	  "`[ast session']` for one ok CST `packet` under `session` (nil on a fresh
    88	   session, `:primed` once the prelude has run)."
    89	  [packet session]
    90	  (let [packet (ok-packet! packet)
    91	        packet (cond-> packet
    92	                 (not (contains? packet :yang.python.antlr/max-digits))
    93	                 (assoc :yang.python.antlr/max-digits 4300))
    94	        _ (p/validate! packet)
    95	        body (lower/lower-module-body packet)
    96	        main (u/let1 '%repl-body
    97	                     (u/lam [lower/globals-sym lower/globals-fn-sym] body)
    98	                     (u/sexp->uast run-form))
    99	        ast (u/mark-tails (if (= :primed session)
   100	                            main
   101	                            (u/then prelude/uast main)))]
   102	    [ast :primed]))
