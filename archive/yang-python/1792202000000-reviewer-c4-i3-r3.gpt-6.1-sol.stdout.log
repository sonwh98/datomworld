   248	(defn- guest-installs
   249	  "The guest modules `task` has started an install child for: the
   250	   `pym.*` names it has linked or is installing, as strings (a name
   251	   compares by its text whatever symbol value a kernel's registry
   252	   holds)."
   253	  [task]
   254	  (into (sorted-set)
   255	        (comp (map str)
   256	              (filter #(= "pym." (subs % 0 (min 4 (count %))))))
   257	        (concat (map first (module/module-entries (:modules task)))
   258	                (keys (:installs task)))))
