   165	
   166	(defn- step-world
   167	  "One reading: the publisher, the reader when there is one, then every
   168	   plain peer."
   169	  [w]
   170	  (let [now (:now w)
   171	        [pub pub-events] (dht/step (:pub w) now)
   172	        [reader] (when (:reader w) (dht/step (:reader w) now))]
   173	    (-> w
   174	        (assoc :pub pub
   175	               :reader reader
   176	               :peers (into {}
   177	                            (map (fn [[port {:keys [composition state]}]]
   178	                                   (mesh/tick! composition now)
   179	                                   [port {:composition composition,
   180	                                          :state (jing.dht/step state 256)}]))
   181	                            (:peers w))
   182	               :now (+ now 10))
   183	        (update :events into pub-events))))
   184	
   185	
   186	(defn- run-world
   187	  "Step `w` until `(done? w)`; `:failure` names `cause` when `span` more
   188	   readings pass first."
   189	  [w span cause done?]
   190	  (let [limit (+ (:now w) span)]
   191	    (loop [w w]
   192	      (cond
   193	        (done? w) w
   194	        (> (:now w) limit) (assoc w :failure cause)
   195	        :else (recur (step-world w))))))
   196	
