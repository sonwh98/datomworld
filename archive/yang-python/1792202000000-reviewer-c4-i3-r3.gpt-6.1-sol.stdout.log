   271	(defn- run-over-dht
   272	  "The linked program of packet `pk` on `backend`, its link pair served
   273	   by the DHT source `src` from the world's reader, the world stepped
   274	   between rounds: `[w outcome last-response observation]`, the outcome
   275	   `[halted? blocked? output]` or `[:thrown message]`. The observation
   276	   is `observed` of the task the program ended as -- for a thrown run,
   277	   of the task the throwing run resumed, which holds every step before
   278	   the raise: a refused link raises at its resume, before anything
   279	   else runs."
   280	  [w backend pk src]
   281	  (let [pair (link/make-pair)
   282	        task ((get h/backends backend)
   283	              (lower/lower-packet pk {:prelude :linked})
   284	              (h/composition (h/registry) pair))
   285	        limit (+ (:now w) 1200000)
   286	        run (fn [task]
   287	              (try (vm/run task)
   288	                   (catch #?(:cljd Object :clj Exception :cljs :default) e
   289	                     {::thrown (ex-message e), ::resumed task})))]
   290	    (loop [w w
   291	           task (run task)
   292	           pair pair]
   293	      (let [response (dissoc (peek (mesh/values (:responses pair)))
   294	                             :yin.link/id :image)]
   295	        (cond
   296	          (::thrown task)
   297	          [w [:thrown (::thrown task)] response (observed (::resumed task))]
   298	
   299	          (and (vm/blocked? task) (< (:now w) limit))
   300	          (let [{:keys [pair dht]} (link/serve {:pair pair,
   301	                                                :source src,
   302	                                                :dht (:reader w)})
   303	                w (step-world (assoc w :reader dht))]
   304	            (recur w (run task) pair))
   305	
   306	          :else
   307	          [w
   308	           [(vm/halted? task) (vm/blocked? task)
   309	            (render/output (vm/value task))]
   310	           response
   311	           (observed task)])))))
   312	
