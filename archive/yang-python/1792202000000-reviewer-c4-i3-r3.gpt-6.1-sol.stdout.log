   183	   :importers :indexes {kind [signed ...]} :blobs {address hex}}`: what
   184	   two artifacts are compared by, since a host prints a map's entries in
   185	   its own order."
   186	  [lines]
   187	  (let [[m & forms] lines]
   188	    (when-not (= magic m)
   189	      (throw (ex-info "not a dht-import-v1 artifact" {:path path})))
   190	    (reduce (fn [acc line]
   191	              (let [form (edn/read-string line)]
   192	                (cond
   193	                  (vector? form) (assoc-in acc [:blobs (first form)]
   194	                                           (second form))
   195	                  (:index form) (assoc-in acc [:indexes (:index form)]
   196	                                          (:signed form))
   197	                  :else (merge acc form))))
   198	            {:blobs {}, :indexes {}}
   199	            forms)))
   200	
   201	
   202	(defn read-file
   203	  "The checked-in artifact, `parse`'s data with each blob as host
   204	   bytes."
   205	  []
   206	  (update (parse (read-lines))
   207	          :blobs
   208	          (fn [blobs]
   209	            (into {} (map (fn [[a hex]] [a (jing.dht/hex->bytes hex)]))
   210	                  blobs))))

