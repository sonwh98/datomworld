   338	(defn- first-difference
   339	  "The first key of the artifacts `a` and `b` (`fixture/parse`'s data)
   340	   whose values differ, with the blob addresses only one holds or holds
   341	   other bytes at; nil when they are equal."
   342	  [a b]
   343	  (when (not= a b)
   344	    (let [blobs (fn [x y]
   345	                  (sort (map str (remove #(= (get x %) (get y %))
   346	                                         (keys x)))))]
   347	      {:keys (vec (sort (map str (filter #(not= (get a %) (get b %))
   348	                                         (distinct (concat (keys a)
   349	                                                           (keys b))))))),
   350	       :blobs-differ (vec (take 4 (blobs (:blobs a) (:blobs b)))),
   351	       :blobs-only-here (vec (take 4 (blobs (:blobs b) (:blobs a))))})))
