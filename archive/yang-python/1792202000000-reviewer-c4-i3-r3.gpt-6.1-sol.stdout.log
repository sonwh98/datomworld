   239	(defn- py-output
   240	  "The lines the Python runtime of `task` has printed, read off its
   241	   `py.rt/out` cell in py's module store: none when py has not run
   242	   `py/init!`, so no Python statement can have printed."
   243	  [task]
   244	  (let [ref (some #(get % 'py.rt/out) (vals (:module-stores task)))]
   245	    (mapv render/line (when ref (get-in task [:heap (:id ref) :value])))))
