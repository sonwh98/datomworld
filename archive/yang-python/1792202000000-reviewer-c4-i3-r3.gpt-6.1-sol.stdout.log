   428	(defn- republished-dependency-is-refused
   429	  [w artifact src]
   430	  (let [k1 (get-in artifact [:units "k"])
   431	        k2 (get-in artifact [:republished "k"])
   432	        [w _] (publish-index w (get-in artifact [:indexes :republish]))]
   433	    (testing "a republished dependency: t pinned k's first address, k now
   434	              names another, so t is refused as a dependency binding with
   435	              no install child and no output -- nothing of t or k runs"
   436	      (is (not= k1 k2))
   437	      (let [[w results] (on-every-vm w (get-in artifact [:importers :tt])
   438	                                     src)]
   439	        (doseq [[k [outcome response seen]] results]
   440	          (is (= :thrown (first outcome)) (str k " " (pr-str outcome)))
   441	          (is (= {:status :refused,
   442	                  :reason :yin.link.dht/dependency-binding,
   443	                  :name 'pym.k,
   444	                  :pinned k1,
   445	                  :binding :mismatch,
   446	                  :resolved k2}
   447	                 (select-keys response [:status :reason :name :pinned
   448	                                        :binding :resolved]))
   449	              (str k " " (pr-str response)))
