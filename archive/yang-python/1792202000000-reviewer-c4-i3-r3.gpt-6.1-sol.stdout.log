   314	(defn- source
   315	  "The reader's DHT link source declaring the public keys `publics`, its
   316	   Python admission naming `own`."
   317	  [publics own]
   318	  (link/composition {:dht? true,
   319	                     :principals publics,
   320	                     :admit (publication/principal-admission own)}))
