   261	(defn- observed
   262	  "What `task` shows independently of its value: the lines it printed,
   263	   the guest modules it installed, and how many install children it ever
   264	   started (its origin counter, `py`'s included)."
   265	  [task]
   266	  {:output (py-output task),
   267	   :guests (guest-installs task),
   268	   :children (or (:origins task) 0)})
