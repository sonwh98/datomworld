   323	(defn- on-every-vm
   324	  "Thread `w` through `run-over-dht` on every vector backend: `[w {backend
   325	   [outcome last-response observation]}]`."
   326	  [w pk src]
   327	  (reduce (fn [[w acc] k]
   328	            (let [[w outcome response seen] (run-over-dht w k pk src)]
   329	              [w (assoc acc k [outcome response seen])]))
   330	          [w {}]
   331	          (keys h/backends)))
