tic (fn [ast]\n    42\t               (vm/value (vm/run (load-semantic-ast (semantic/create-vm opts)\n    43\t                                                    (vm/ast->datoms ast))))),\n    44\t   :stack (fn [ast]\n    45\t            (vm/value\n    46\t              (vm/run (dvm/create-vm (:image (dl/adapt (vm/ast->datoms ast)))\n    47\t                                     (assoc opts\n    48\t                                            :contract vm/stack-contract))))),\n    49\t   :register (fn [ast]\n    50\t               (vm/value\n    51\t                 (vm/run\n    52\t                   (rvm/create-vm\n    53\t                     (:image (rc/adapt (vm/ast->datoms ast)))\n    54\t                     (assoc opts :contract vm/register-contract)))))})\n    55\t\n    56\t\n    57\t(defn- run-with-prelude\n    58\t  \"The value of `form` (prelude notation) after `prelude-ast`.\"\n    59\t  [prelude-ast form]\n    60\t  (let [ast (u/mark-tails (u/then prelude-ast (u/sexp->uast form)))]\n    61\t    (into {}\n    62\t          (map (fn [[k run]]\n    63\t                 [k (try (run ast)\n    64\t                         (catch #?(:cljd Object :clj Exception :cljs :default) e\n    65\t                           [:thrown (ex-message e)]))]))\n    66\t          runners)))\n    67\t\n    68\t\n    69\t(defn- with-float64\n    70\t  \"`form` with every `{:py/float x}` payload as float64 content, as the\n    71\t   lowering and the prelude build it (on JS, Jing's carrier: a bare 1.0\n    72\t   there is the integer 1).\"\n    73\t  [form]\n    74\t  (walk/postwalk (fn [x]\n    75\t                   (if (and (map? x) (contains? x :py/float))\n    76\t                     (update x :py/float data/float64)\n    77\t                     x))\n    78\t                 form))\n    79\t\n    80\t\n    81\t(def ^:private cases\n    82\t  \"[form expected], evaluated as one vector on each VM.\"\n    83\t  '[[(py/add 1 {:py/float 2.5}) {:py/float 3.5}]\n    84\t    [(py/a