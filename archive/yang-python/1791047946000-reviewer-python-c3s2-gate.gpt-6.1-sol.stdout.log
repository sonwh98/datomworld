two-53) '(py/key (py/float (* (data/float-value 2) 4503599627370496)))) true]\n414:   [(list '= (list 'py/key two-80) '(py/key (py/float (* (data/float-value 1) 4503599627370496 268435456))))\n416:   ['(py/key {:py/float ##Inf}) [:py.numeric/infinite \"+\"]]\n417:   ['(py/key {:py/float ##-Inf}) [:py.numeric/infinite \"-\"]]\n419:   ['(py/key (py/float (- (data/float-value ##Inf) (data/float-value ##Inf)))) [:py.numeric/nan]]\n420:   ['(= (py/key (py/float (- (data/float-value ##Inf) (data/float-value ##Inf)))) (py/key (py/float (* (data/float-value 0) (data/float-value ##Inf))))) true]\n421:   ['(= (py/key (py/float (- (data/float-value ##Inf) (data/float-value ##Inf)))) (py/key {:py/float ##Inf})) false]\n422:   [(list '= (list 'py/key (list 'py/tuple [1 two-53+1]))\n423:          (list 'py/key (list 'py/tuple [{:py/float 1.0} two-53+1])))\n425:   ['(py/key {:py/str \"k\"}) {:py/str \"k\"}]\n426:   ['(= (py/key -1) (py/key -2)) false]\n485:                             (cons 'do (map (fn [[k v]] (list 'py/dict-set 'd k {:py/str v}))\n531:(deftest unhashable-on-every-host-test\n536:                      (do (py/try (fn [] (cell/set! r (thunk)))\n538:                                    (cell/set! r (get (cell/get (get (cell/get e) :class))\n9:   `register-integer-module`, and Yin source reaches the exports as\n27:     `floor-div-mod` answers Python's `[a // b, a % b]`: the quotient\n31:     two's complement, so `(bit-not a)` is `-a - 1`. `shift-left` is\n42:     kernel's. `format` writes exact lowercase text, a `-` only when\n48:   `format` writes in a radix that is not a power of two. A result that\n50:   size is known in advance (`mul`, `shift-left`, `pow`).\n68:  \"The module `register-integer-module` installs.\"\n186:(defn- int-floor-div-mod\n188:  (let [x (big! 'floor-div-mod 0 a)\n189:        y (divisor! 'floor-div-mod b)\n193:    [(out limits 'floor-div-mod (if adjust? (host/sub q one) q))\n194:     (out limits 'floor-div-mod (if adjust? (host/add r y) r))]))\