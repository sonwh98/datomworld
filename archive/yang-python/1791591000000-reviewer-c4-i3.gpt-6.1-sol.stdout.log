;; =============================================================================
;; The acceptance
;; =============================================================================

(defn- publish-world
  "Publisher `A` at mesh port 1, plain peers at 2 and 3, a reader at 4,
   `A` and the reader with `py` installed: `A` publishes m, k, t and e,
   names py, m, k and t (e's content is `A`'s, its name is not), and the
   reader loads that index.
   `{:w w :addresses {python-name address} :own [assertion ...]}`."
  [a]
  (let [net (mesh/mesh)
        installed (installed-py)
        pub (node-at net 1 [2 3] true installed)
        py (:address @h/published)
        units (publication/publish-units!
                (dht/store pub) (h/registry) py
                [(unit "m" programs/m-packet) (unit "k" programs/k-packet)
                 (unit "t" programs/t-packet) (unit "e" programs/e-packet)])
        addresses (:addresses units)
        own (assert-names a 1 [['py py]
                               ['pym.m (get addresses "m")]
                               ['pym.k (get addresses "k")]
                               ['pym.t (get addresses "t")]])
        w {:net net,
           :pub pub,
           :reader (node-at net 4 [2 3 1] false installed),
           :peers (into {} (map (fn [p] [p (peer-node net p)])) [2 3]),
           :now 0,
           :events []}]
    (is (= :ok (:status units)) (pr-str units))
    {:w (first (publish-index w own)), :addresses addresses, :own own}))


(defn- imports-over-the-dht
  [w src]
  (testing "a JVM-published pym.m imports over the DHT, parserless, with
            the in-store linked run's output and CPython's"
    (let [[w results] (on-every-vm w programs/d-packet src)]
      (doseq [[k [outcome response]] results]
        (is (= [true false {:py/out ["m-body" "7"], :py/exception nil}]
               outcome)
            (str k " " (pr-str response))))
      (testing "and t delivers k, its pinned import, by name"
        (let [[w results] (on-every-vm w programs/tt-packet src)]
          (doseq [[k [outcome response]] results]
            (is (= [true false
                    {:py/out ["k-body" "t-sees 3" "t-done"],
                     :py/exception nil}]
                   outcome)
                (str k " " (pr-str response))))
          w)))))


(defn- republished-dependency-is-refused
  [w a own addresses src]
  (let [k1 (get addresses "k")
        k2 (get-in (publication/publish-units!
                     (dht/store (:pub w)) (h/registry) (:address @h/published)
                     [(unit "k" programs/k2-packet)])
                   [:addresses "k"])
        standing (:envelope (nth own 2))
        [w _] (publish-index
                w [(publish/retraction a {:of (jing/segment-key standing),
                                          :seq 5})
                   (publish/assertion a {:name 'pym.k, :manifest k2, :seq 6})])]
    (testing "a republished dependency: t pinned k's first address, k now
              names another, so t is refused as a dependency binding with
              no install child -- nothing of t or k runs"
      (is (not= k1 k2))
      (let [[w results] (on-every-vm w programs/tt-packet src)]
        (doseq [[k [outcome response]] results]
          (is (= :thrown (first outcome)) (str k " " (pr-str outcome)))
          (is (= {:status :refused,
                  :reason :yin.link.dht/dependency-binding,
                  :name 'pym.k,
                  :pinned k1,
                  :binding :mismatch,
                  :resolved k2}
                 (select-keys response [:status :reason :name :pinned
                                        :binding :resolved]))
              (str k " " (pr-str response))))
        w))))


(defn- foreign-principal-is-refused
  [w a b addresses]
  (let [e (get addresses "e")
        [w _] (publish-index w (assert-names b 1 [['pym.e e]]))
        both (source [(:public a) (:public b)] [(:public a)])]
    (testing "a module only B vouches for, B declared: the Python admission
              refuses it by name until L-e"
      (let [[w results] (on-every-vm w programs/x-packet both)]
        (doseq [[k [outcome response]] results]
          (is (= :thrown (first outcome)) (str k " " (pr-str outcome)))
          (is (= {:status :refused,
                  :reason :yang.python.antlr/foreign-principal,
                  :name 'pym.e,
                  :asserters [(sign/principal (:public b))],
                  :requires :L-e}
                 response)
              (str k " " (pr-str response))))
        w))))


(defn- dht-import-test
  []
  (let [a (sign/generate)
        b (sign/generate)
        {:keys [w addresses own]} (publish-world a)
        src (source [(:public a)] [(:public a)])
        w (imports-over-the-dht w src)
        w (republished-dependency-is-refused w a own addresses src)
        w (foreign-principal-is-refused w a b addresses)]
    (dht/close! (:pub w))
    (dht/close! (:reader w))))


(deftest ^:slow dht-import-test-test
  (slow/guard "dht-import-test" dht-import-test))

