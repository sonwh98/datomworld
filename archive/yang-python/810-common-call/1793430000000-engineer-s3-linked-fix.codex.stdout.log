{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '35,110p' test/yang/python/antlr/linked_harness.cljc; sed -n '1125,1200p' test/yang/python/antlr/import_test.cljc; sed -n '80,145p' src/cljc/yang/core/publication.cljc\"","aggregated_output":"\n(def integer-limits\n  \"The ordinary Python composition's `integer` limits.\"\n  {::integer/max-bits 100000, ::integer/max-digits 4300})\n\n\n(defn registry\n  \"The full host registry a linked Python composition registers: the\n   `require` handler, then `cell`, `data`, `integer` under `limits`, and\n   `stream` — the hook module `pysp` polls a signal stream, so the\n   safepointed composition needs it even though `py` does not.\"\n  ([] (registry integer-limits))\n  ([limits]\n   (-> (module/default-registry)\n       module/register-cell-module\n       (data/register-data-module {::data/max-items 1048576})\n       (prelude/register-integer-module limits)\n       module/register-stream-module)))\n\n\n(def published\n  \"`yang.call` and `py` published once into their own content store.\"\n  (delay\n    (let [store (mem/create-content-mem)\n          call-result (publish/publish-module! store (call/module-spec (registry)))\n          result (publish/publish-module! store\n                                          (prelude/module-spec (registry)\n                                                               (:address call-result)))]\n      {:store store, :result result, :address (:address result),\n       :call-result call-result, :call-address (:address call-result)})))\n\n\n(def published-pysp\n  \"`pysp` published once into `py`'s own content store, which its pinned\n   requirement already lives in: the same shape as `published`.\"\n  (delay\n    (let [{:keys [store address]} @published\n          result (publish/publish-module!\n                   store (safepoint/module-spec (registry) address))]\n      {:store store, :result result, :address (:address result)})))\n\n\n(defn source\n  \"The serving composition over the published store: `name-env` defaults\n   to `{py <address> yang.call <address>}`, derivation `:trusted`, the test being the\n   publisher. `pysp`-serving sources pass their own `name-env`, the\n   safepointed runs' `{'py a :pysp b}` both.\"\n  ([] (source {'py (:address @published),\n               'yang.call (:call-address @published)}))\n  ([name-env]\n   (link/composition {:content-store (:store @published),\n                      :name-env name-env,\n                      :derivation :trusted})))\n\n\n(defn safepoint-source\n  \"The serving composition for `pysp`, `py`, and the `yang.call` module\n   required by `py`.\"\n  []\n  (source {'py (:address @published), 'pysp (:address @published-pysp),\n           'yang.call (:call-address @published)}))\n\n\n(defn publish-guest-module!\n  \"One guest module's `spec` (lower/module-spec's) published into `py`'s\n   own content store, where its pinned requirements already live:\n   `publish-module!`'s answer. Guest modules are tiny beside `py`, so a\n   test may publish its own; publish imports bottom-up, the `deps` map\n   naming each import's address.\"\n  [spec]\n  (publish/publish-module! (:store @published) spec))\n\n\n(def backends\n  \"Each vector backend's root task over a program AST and composition.\"\n  {:semantic (fn [ast opts]\n              (on-every-vm pk src)))))\n\n\n(deftest ^:slow optional-dependency-does-not-abort-install-test-test\n  (slow/guard \"optional-dependency-does-not-abort-install-test\"\n              optional-dependency-does-not-abort-install-test))\n\n\n;; I5 fixtures use the same portable CST constructors as the earlier tests.\n(defn- i5-assignment\n  [n value]\n  (statement [:expr_stmt (chain expr-chain [:name [\"NAME\" n]])\n              [\"ASSIGN\" \"=\"] (chain expr-chain [\"NUMBER\" (str value)])]))\n\n\n(defn- i5-print-attributes\n  [pairs]\n  (statement\n    [:expr_stmt\n     (chain (take 7 expr-chain)\n            [:atom_expr [:atom [:name [\"NAME\" \"print\"]]]\n             [:trailer [\"OPEN_PAREN\" \"(\"]\n              (into [:arglist]\n                    (interpose [\"COMMA\" \",\"]\n                               (map (fn [[m n]]\n                                      [:argument\n                                       (chain (take 6 (rest expr-chain))\n                                              (into [:atom_expr [:atom [:name [\"NAME\" m]]]]\n                                                    (map (fn [attr] [:trailer [\"DOT\" \".\"] [:name [\"NAME\" attr]]])\n                                                         (str/split n #\"\\.\"))))]) pairs)))\n              [\"CLOSE_PAREN\" \")\"]]])]))\n\n\n(defn- i5-packet\n  [statements]\n  (portable/packet (into [:file_input] (conj (vec statements) [\"EOF\" \"<EOF>\"]))))\n\n\n(defn- i5-unit\n  [n statements]\n  {:name n, :packet (i5-packet statements)})\n\n\n(defn- i5-source\n  [units]\n  (let [result (publication/publish-units! (:store @h/published) (h/registry)\n                                           (:address @h/published) units)]\n    (is (= :ok (:status result)) (pr-str result))\n    (h/source (merge {'py (:address @h/published)}\n                     (into {} (map (fn [[n a]] [(lower/module-symbol n) a])) (:addresses result))\n                     (:bundles result)))))\n\n\n(deftest ^:slow mutually-importing-modules-test\n  (slow/guard \"mutually-importing-modules\"\n              (fn []\n                (let [units [(i5-unit \"a\" [(i5-assignment \"x\" 1)\n                                           (statement (import-simple-stmt \"b\"))])\n                             (i5-unit \"b\" [(i5-assignment \"x\" 2)\n                                           (statement (import-simple-stmt \"a\"))])]\n                      source (i5-source units)]\n                  (doseq [order [[\"a\" \"b\"] [\"b\" \"a\"]]]\n                    (every= [true false {:py/out [\"1 2 2 1\"], :py/exception nil}]\n                            (on-every-vm\n                              (i5-packet (concat (map #(statement (import-simple-stmt %)) order)\n                                                 [(i5-print-attributes [[\"a\" \"x\"] [\"b\" \"x\"]\n                                                                        [\"a\" \"b.x\"] [\"b\" \"a.x\"]])]))\n                              source)))))))\n\n\n(deftest ^:slow cyclic-partial-initialization-test\n  (slow/guard \"cyclic-partial-initialization\"\n              (fn []\n                (let [source (i5-source\n                               [(i5-unit \"a\" [(statement (relative-from-stmt 0 \"b\" \"x\"))])\n                                (i5-unit \"b\" [(statement (import-simple-stmt \"a\"))\n                                (when-not (or (contains? by-name m)\n                                              (contains? published m))\n                                  {:module m, :imported-by (:name u)}))\n                              (get imports (:name u))))\n                      units)]\n    (if missing\n      (refused (keyword refusal-ns \"unpublished-import\") missing)\n      {:status :ok,\n       :order (mapv #(if (= 1 (count %)) (first %) %)\n                    (components (mapv :name units) imports))})))\n\n\n(defn publish-units!\n  \"Publish `units` into the content store `handle` over the host registry\n   `registry`, the runtime module pinned at `runtime-address` and each\n   import outside the set at its address in `published`, in\n   `publication-order`, per the config `cfg` (see the namespace doc). Answers\n   `{:status :ok :addresses {name address} :bundles {bundle-symbol address}\n     :sites {name-or-bundle-symbol publication}\n     :binders {name-or-bundle-symbol publication}}`, or the first refusal:\n   `publication-order`'s before anything is written, else the publisher's\n   with a string `:unit`. An SCC member alias carries no marks and no\n   binder table: its bundle does.\"\n  [cfg handle registry runtime-address units published]\n  (let [{:keys [imported-names module-spec scc-module-specs site-set\n                binder-table refusal-ns publish-fn]\n         :or {publish-fn publish/publish-module!}}\n        cfg\n        plan (publication-order cfg units published)\n        by-name (into {} (map (juxt :name identity)) units)]\n    (if (= :refused (:status plan))\n      plan\n      (reduce\n        (fn [acc step]\n          (let [members (if (vector? step) step [step])\n                known (merge published (:addresses acc))\n                deps (select-keys known\n                                  (mapcat #(imported-names (get by-name %)) members))\n                specs (if (vector? step)\n                        (scc-module-specs registry (mapv by-name members)\n                                          runtime-address deps)\n                        [(module-spec registry (get by-name step)\n                                      runtime-address deps)])\n                bundle (first specs)\n                result (publish-fn handle bundle)\n                emit (fn [acc k r]\n                       ;; a handle with no byte store (a stub publisher)\n                       ;; has nowhere to put a set; a backend failure is\n                       ;; a refusal, not a throw\n                       (if-not (:put-bytes-fn handle)\n                         acc\n                         (try (let [emit1 (fn [acc slot f]\n                                            (if-let [pub (when f\n                                                           (f handle (:address r)\n                                                              (:ast bundle)))]\n                                              (assoc-in acc [slot k] pub)\n                                              acc))]\n                                (-> acc\n                                    (emit1 :sites site-set)\n                                    (emit1 :binders binder-table)))\n                              (catch #?(:cljd Object :clj Exception :cljs :default) e\n                                (reduced\n                                  (refused (keyword refusal-ns \"site-set-unpublished\")\n                                           {:unit k,\n                                            :message (ex-message e)}))))))]\n            (if (= :refused (:status result))\n","exit_code":0,"status":"completed"}}
