{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '960,1010p' test/dao/host/gate_test.clj; sed -n '1,120p' src/cljc/yang/core/publication.cljc; sed -n '160,215p' src/cljc/yang/core/call.cljc; sed -n '150,230p' src/dev/host_boundary/closure.clj; git show HEAD\"'^:test/dao/host/gate_test.clj | sed -n '\"'980,1005p'\"","aggregated_output":"                                                    (filter (comp names first))\n                                                    vec)})\n                                      (catch Exception e {:error (or (ex-message e) (str e))}))]))\n                       sources)\n         errors (vec (keep (fn [[f r]] (when (:error r) [f (:error r)])) scanned))\n         hits (vec (for [[f r] scanned\n                         :when (seq (:refs r))\n                         [n refs] (group-by first (:refs r))]\n                     {:file f :name n :lines (vec (sort (distinct (keep second refs))))}))]\n     {:verdict (cond (or (empty? scanned) (seq errors)) :scan-failure\n                     (seq hits) :fail\n                     :else :pass)\n      :scanned (- (count scanned) (count errors))\n      :errors errors\n      :hits hits})))\n\n\n(def library-current\n  (delay (library-gate (read-sources (library-scope (gate-files) list-1)))))\n\n\n;; ---------------------------------------------------------------------------\n;; Tests\n;; ---------------------------------------------------------------------------\n\n(deftest closure-totals-are-the-design-totals\n  (testing \"§3.1 after H4, the yang.core L2 regeneration, J6b's ws parser/upgrade and yang.core.call joining the closure: 156 / 154 / 155 files, 148 shared\"\n    (let [files (into {} (map (fn [l] [l (set (map :file (:files (committed-closure l))))]) lanes))]\n      (is (= 156 (count (files :clj))))\n      (is (= 154 (count (files :cljs))))\n      (is (= 155 (count (files :cljd))))\n      (is (= 148 (count (apply set/intersection (vals files)))))\n      (doseq [l lanes]\n        (is (= (count (files l)) (:total (committed-closure l))))\n        (is (every? #(seq (:classes %)) (:files (committed-closure l))))))))\n\n\n(deftest independent-traversal-agrees-with-the-committed-closure\n  (doseq [l lanes]\n    (testing (str \"lane \" l)\n      (let [committed (set (map :file (:files (committed-closure l))))\n            walked (traverse l)]\n        (is (= #{} (set/difference committed walked)) \"committed, not walked\")\n        (is (= #{} (set/difference walked committed)) \"walked, not committed\")))))\n\n\n(deftest gate-passes-on-the-current-tree\n  (let [r @current]\n    (is (= 168 (count (closure-files))) \"the union of the three lanes\")\n    (is (= 168 (count (gate-files))) \"no profile addition outside the closure after H3\")\n    (is (= (count (gate-files)) (:scanned r)))\n(ns yang.core.publication\n  \"Language-neutral publication of a set of compiled units as linker modules\n   (docs/design/yang.typescript.md §17, lift L3; the Python instance is\n   docs/design/yang.antlr.md 8.5.6). A unit set publishes bottom-up: each\n   unit's static imports order it after the units it imports, and each is\n   published pinning the manifest address of every import. Cyclic components\n   are bundled into one unit with lazy member bodies and thin member aliases,\n   eliminating circular content pins. Name assertions stay the linker's: this\n   namespace publishes content, it signs nothing.\n\n   A frontend supplies a config map:\n   `:imported-names`    `(fn [unit])` -> the module names `unit` imports\n   `:module-spec`       `(fn [registry unit runtime-address deps])`\n   `:scc-module-specs`  `(fn [registry units runtime-address deps])`\n   `:site-set`          `(fn [handle address ast])` -> site publication, or nil\n                        (Python's I7 mark set; none for a frontend without)\n   `:binder-table`      `(fn [handle address ast])` -> table publication, or\n                        nil (frontend-supplied; Python passes none)\n   `:refusal-ns`        the namespace string of the refusal keywords\n   `:publish-fn`        `[handle spec]`, default `publish/publish-module!`.\"\n  (:require\n    [yin.vm.linker.publish :as publish]))\n\n\n(defn- refused\n  [reason data]\n  (merge {:status :refused, :reason reason} data))\n\n\n(defn- components\n  \"Kosaraju's two passes, with immutable search state. Members are sorted;\n   singleton components keep the old depth-first publication order.\"\n  [names imports]\n  (let [names-set (set names)\n        edges (into {} (map (fn [n] [n (filterv names-set (get imports n))])) names)\n        reverse-edges (reduce (fn [acc [n deps]]\n                                (reduce #(update %1 %2 (fnil conj []) n) acc deps))\n                              {} edges)]\n    (letfn [(finish\n              [acc n]\n              (if (contains? (:seen acc) n)\n                acc\n                (update (reduce finish (update acc :seen conj n) (get edges n))\n                        :order conj n)))\n            (collect\n              [acc n]\n              (if (contains? (:seen acc) n)\n                acc\n                (reduce collect (-> acc (update :seen conj n) (update :members conj n))\n                        (get reverse-edges n))))]\n      (let [finished (:order (reduce finish {:seen #{}, :order []} names))\n            partition (reduce (fn [acc n]\n                                (if (contains? (:seen acc) n)\n                                  acc\n                                  (let [r (collect {:seen (:seen acc), :members []} n)]\n                                    {:seen (:seen r),\n                                     :groups (conj (:groups acc) (vec (sort (:members r))))})))\n                              {:seen #{}, :groups []} (reverse finished))\n            group-of (into {} (mapcat (fn [g] (map #(vector % g) g))) (:groups partition))]\n        (letfn [(order-group\n                  [acc g]\n                  (if (contains? (:done acc) g)\n                    acc\n                    (let [deps (distinct (map group-of (mapcat edges g)))\n                          next (reduce order-group (update acc :done conj g)\n                                       (remove #{g} deps))]\n                      (update next :order conj g))))]\n          (:order (reduce order-group {:done #{}, :order []} (map group-of names))))))))\n\n\n(defn publication-order\n  \"Dependency-first names, retaining the input order for acyclic units.\n   Cyclic components appear as sorted member vectors in :order, one\n   publication step per SCC. External imports must be in `published`.\"\n  [{:keys [imported-names refusal-ns]} units published]\n  (let [by-name (into {} (map (juxt :name identity)) units)\n        imports (into {} (map (juxt :name imported-names)) units)\n        missing (some (fn [u]\n                        (some (fn [m]\n                                (when-not (or (contains? by-name m)\n                                              (contains? published m))\n                                  {:module m, :imported-by (:name u)}))\n                              (get imports (:name u))))\n                      units)]\n    (if missing\n      (refused (keyword refusal-ns \"unpublished-import\") missing)\n      {:status :ok,\n       :order (mapv #(if (= 1 (count %)) (first %) %)\n                    (components (mapv :name units) imports))})))\n\n\n(defn publish-units!\n  \"Publish `units` into the content store `handle` over the host registry\n   `registry`, the runtime module pinned at `runtime-address` and each\n   import outside the set at its address in `published`, in\n   `publication-order`, per the config `cfg` (see the namespace doc). Answers\n   `{:status :ok :addresses {name address} :bundles {bundle-symbol address}\n     :sites {name-or-bundle-symbol publication}\n     :binders {name-or-bundle-symbol publication}}`, or the first refusal:\n   `publication-order`'s before anything is written, else the publisher's\n   with a string `:unit`. An SCC member alias carries no marks and no\n   binder table: its bundle does.\"\n  [cfg handle registry runtime-address units published]\n  (let [{:keys [imported-names module-spec scc-module-specs site-set\n                binder-table refusal-ns publish-fn]\n         :or {publish-fn publish/publish-module!}}\n        cfg\n        plan (publication-order cfg units published)\n        by-name (into {} (map (juxt :name identity)) units)]\n    (if (= :refused (:status plan))\n      plan\n      (reduce\n        (fn [acc step]\n          (let [members (if (vector? step) step [step])\n                known (merge published (:addresses acc))\n                deps (select-keys known\n                                  (mapcat #(imported-names (get by-name %)) members))\n                specs (if (vector? step)\n                        (scc-module-specs registry (mapv by-name members)\n                                          runtime-address deps)\n\n(def module-uast\n  \"The linked module tree built from the same `definitions`.\"\n  (let [stripped (core/module-definitions \"yang.call\" :yang.call/uninit\n                                          [] definitions)]\n    (core/module-tree stripped [])))\n\n\n(def module-exports\n  \"Public module exports (private helper definitions stay internal).\"\n  public-exports)\n\n\n(def ^:private module-free-names\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"The linker module spec for `yang.call` over `registry`.\"\n  [registry]\n  (core/module-spec {:module-name module-name\n                     :ast module-uast\n                     :exports module-exports\n                     :requires {}\n                     :free-names module-free-names\n                     :registry registry\n                     :message \"the yang.call module reads an undeclared name\"\n                     :refusal-ns \"yang.call\"}))\n   [:deferred-stage \"deferred §9.3\"\n    '[yang.antlr.cst yang.frontend yang.stage yin.repl.frontends]]\n   [:deferred-gensym \"deferred §9.1\"\n    '[yang.clojure yang.php dao.space.transact]]\n   [:runtime-prereq \"table C, no slice\"\n    '[dao.data.btree dao.jing.file dao.stream.journal dao.space.transactor\n      yin.vm.ucf.authority]]\n   ;; r7: the two rows for H0's 16 findings (rpc is in :deferred-entropy)\n   [:profile-consumer \"H2 (H0 finding: consumers of table A entries)\"\n    '[yin.repl.query yin.vm.linker.closure yin.vm.ucf.rows yin.vm yang.php\n      yin.vm.debruijn-register-code yin.vm.debruijn-register-effects\n      dao.space.index yang.antlr.packet]]\n   [:dialect-arm \"none (H0 finding: retained dialect arms)\"\n    '[dao.space.query yang.clojure yin.vm.engine yin.repl.adapter\n      yin.repl.dht]]\n   ;; §3.1 names transit, cbor and codec; the rest are the codec track's\n   ;; files by §8.3 (and ws-project by §8.1's codec row) and the lane twins.\n   [:codec-track \"codec track, untouched (§8.3)\"\n    '[dao.stream.transit dao.stream.cbor dao.stream.codec\n      dao.stream.cbor.boring dao.stream.cbor.cljd dao.stream.transit.cljd\n      dao.stream.ws dao.stream.remote-channel dao.stream.ws-project\n      dao.jing.stream dao.data dao.stream.ws.jvm dao.stream.ws.node\n      dao.stream.ws.dart dao.stream.ws.browser yin.repl.serve\n      yin.repl.connect]]\n   [:internal-pure-display \"none (list 1, display only)\" '[dao.pretty]]])\n\n\n(def prefix-rows\n  \"Rows the §3.1 table names by prefix (`yang.python.antlr.*`).\"\n  [[:deferred-stage \"yang.python.antlr.\"]])\n\n\n(defn classes-of\n  [ns-sym]\n  (let [s (name ns-sym)\n        cs (into (set (keep (fn [[c _ nss]] (when (some #{ns-sym} nss) c))\n                            class-rows))\n                 (keep (fn [[c pre]] (when (str/starts-with? s pre) c))\n                       prefix-rows))]\n    (if (seq cs) cs #{:none})))\n\n\n(def class-legend\n  (into (sorted-map) (map (fn [[c slice _]] [c slice]) class-rows)))\n\n\n(defn lane-report\n  [lane files shared]\n  {:lane lane\n   :root root\n   :features (lane-features lane)\n   :total (count files)\n   :shared (count shared)\n   :lane-specific (count (remove shared (keys files)))\n   :class-legend (assoc class-legend :none \"no host contact beyond §3.3\")\n   :files (vec (for [[f n] (sort-by key files)]\n                 {:file f\n                  :ns n\n                  :shared (contains? shared f)\n                  :classes (into (sorted-set) (classes-of n))}))})\n\n\n(defn compute\n  []\n  (let [closures (into {} (map (fn [l] [l (lane-closure l)]) lanes))\n        shared (apply set/intersection (map (comp set keys) (vals closures)))]\n    {:shared shared\n     :reports (into {} (map (fn [[l fs]] [l (lane-report l fs shared)])\n                            closures))}))\n\n\n(defn render\n  [report]\n  (str \";; Generated by src/dev/host_boundary/closure.clj (host-boundary H0).\\n\"\n       \";; Do not edit by hand; regenerate with the command in that file's ns doc.\\n\"\n       (with-out-str\n         (binding [*print-namespace-maps* false]\n           (pp/pprint report)))))\n\n\n(defn out-file\n\n;; ---------------------------------------------------------------------------\n;; Tests\n;; ---------------------------------------------------------------------------\n\n(deftest closure-totals-are-the-design-totals\n  (testing \"§3.1 after H4, the yang.core L2 regeneration and J6b's ws parser/upgrade: 155 / 153 / 154 files, 147 shared\"\n    (let [files (into {} (map (fn [l] [l (set (map :file (:files (committed-closure l))))]) lanes))]\n      (is (= 155 (count (files :clj))))\n      (is (= 153 (count (files :cljs))))\n      (is (= 154 (count (files :cljd))))\n      (is (= 147 (count (apply set/intersection (vals files)))))\n      (doseq [l lanes]\n        (is (= (count (files l)) (:total (committed-closure l))))\n        (is (every? #(seq (:classes %)) (:files (committed-closure l))))))))\n\n\n(deftest independent-traversal-agrees-with-the-committed-closure\n  (doseq [l lanes]\n    (testing (str \"lane \" l)\n      (let [committed (set (map :file (:files (committed-closure l))))\n            walked (traverse l)]\n        (is (= #{} (set/difference committed walked)) \"committed, not walked\")\n        (is (= #{} (set/difference walked committed)) \"walked, not committed\")))))\n\n\n","exit_code":0,"status":"completed"}}
