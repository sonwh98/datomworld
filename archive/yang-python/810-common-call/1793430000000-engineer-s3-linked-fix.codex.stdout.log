\nsrc/cljc/yang/python/antlr/prelude.cljc:925:           (do (cell/set! f (assoc (cell/get f) :yang.call/entry\nsrc/cljc/yang/python/antlr/prelude.cljc:1040:           (if (yang.call/eligible? f)\nsrc/cljc/yang/python/antlr/prelude.cljc:1041:             (yang.call/invoke\nsrc/cljc/yang/python/antlr/prelude.cljc:1044:                 (if (= (get condition :yang.call/reason) :yang.call/thrown)\nsrc/cljc/yang/python/antlr/prelude.cljc:1045:                   (py/raise (get condition :yang.call/value))\nsrc/cljc/yang/python/antlr/prelude.cljc:3737:  [registry call-address]\nsrc/cljc/yang/python/antlr/prelude.cljc:3741:                     :requires {'yang.call call-address},\nsrc/cljc/yang/python/antlr/prelude.cljc:3743:                     :skip? #(= \"yang.call\" (namespace %)),\nsrc/cljc/yang/python/antlr/publication.cljc:27:   :module-spec (fn [registry {:keys [name package? packet]} py-address deps]\nsrc/cljc/yang/python/antlr/publication.cljc:30:                                      :py-address py-address, :deps deps})),\nsrc/cljc/yang/python/antlr/publication.cljc:49:   `py-address` and each import outside the set at its address in\nsrc/cljc/yang/python/antlr/publication.cljc:66:  ([handle registry py-address units]\nsrc/cljc/yang/python/antlr/publication.cljc:67:   (publish-units! handle registry py-address units {}))\nsrc/cljc/yang/python/antlr/publication.cljc:68:  ([handle registry py-address units published]\nsrc/cljc/yang/python/antlr/publication.cljc:69:   (publish-units! handle registry py-address units published publish/publish-module!))\nsrc/cljc/yang/python/antlr/publication.cljc:70:  ([handle registry py-address units published publish-fn]\nsrc/cljc/yang/python/antlr/publication.cljc:71:   (core/publish-units! (config publish-fn) handle registry py-address units published)))\n(ns yang.python.antlr.publication\n  \"C4 slices I3 and I5 (docs/design/yang.antlr.md 8.5.6): a set of compiled Python\n   units published as linker modules. The ordering, SCC bundling and publish\n   loop are `yang.core.publication`'s; this namespace supplies the Python\n   hooks: the imports `lower/imported-module-names` hoists, the\n   `lower/module-spec` and `lower/scc-module-specs` emitters, the I7 site\n   set, and no binder table.\n   Name assertions stay the linker's (`yin.vm.linker.publish/assertion`\n   and `name-envelopes`): this namespace publishes content, it signs\n   nothing.\"\n  (:require [yang.core.publication :as core]\n            [yang.python.antlr.lower :as lower]\n            [yang.python.antlr.siteset :as siteset]\n            [yin.vm.linker.publish :as publish]))\n\n\n(defn- unit-imports\n  \"The Python modules unit `u` statically imports.\"\n  [{:keys [name package? packet]}]\n  (lower/imported-module-names packet\n                               {:name name, :package? (boolean package?)}))\n\n\n(defn- config\n  [publish-fn]\n  {:imported-names unit-imports,\n   :module-spec (fn [registry {:keys [name package? packet]} py-address deps]\n                  (lower/module-spec registry packet\n                                     {:name name, :package? package?,\n                                      :py-address py-address, :deps deps})),\n   :scc-module-specs lower/scc-module-specs,\n   :site-set siteset/publish!,\n   :binder-table nil,\n   :refusal-ns \"yang.python.antlr\",\n   :publish-fn publish-fn})\n\n\n(defn publication-order\n  \"Dependency-first names, retaining the I3 order for acyclic units.\n   Cyclic components appear as sorted member vectors in :order, one\n   publication step per SCC. External imports must be in `published`.\"\n  [units published]\n  (core/publication-order (config publish/publish-module!) units published))\n\n\n(defn publish-units!\n  \"Publish `units` (`[{:name :package? :packet}]`) into the content store\n   `handle` over the host registry `registry`, `py` pinned at\n   `py-address` and each import outside the set at its address in\n   `published` ({python-name address}), in `publication-order`. Answers\n   `{:status :ok :addresses {python-name address}\n     :bundles {bundle-symbol address}\n     :sites {python-name-or-bundle-symbol site-publication}}` for the units\n   of the set (`siteset/publish!`'s answer for each module published beside\n   its code image, I7; an SCC member alias carries no marks and so no\n   entry, its bundle does). The publisher that asserts these names\n   indexes `siteset/signed-entries` of `:sites` in the same index\n   transaction; a module whose entry is missing is refused by every\n   hook-profile reader. Or the\n   first refusal: `publication-order`'s before anything is written, else\n   `publish-module!`'s with a string `:unit`: the Python name for a member,\n   or the bundle module name for an SCC bundle. Every bundle name must be\n   asserted/bound alongside the member names for aliases to deliver.\n   Optional `publish-fn` takes `[handle spec]`, defaulting to\n   `publish/publish-module!`, for both bundles and members.\"\n  ([handle registry py-address units]\n   (publish-units! handle registry py-address units {}))\n  ([handle registry py-address units published]\n   (publish-units! handle registry py-address units published publish/publish-module!))\n  ([handle registry py-address units published publish-fn]\n   (core/publish-units! (config publish-fn) handle registry py-address units published)))\n   stripped. The runtime keys and the state slot are internal.\"\n  (core/exports \"py\" definitions))\n\n\n(def free-names\n  \"Every variable name some occurrence of the map AST reads unbound by an\n   enclosing lambda.\"\n  core/free-names)\n\n\n(def defined-keys\n  \"Every literal key the map AST defines with `yin/def`, at any depth.\"\n  core/defined-keys)\n\n\n(def ^:private module-free-names\n  \"The names the module tree reads and does not define, sorted: the\n   primitives and the host exports its manifest must declare.\"\n  (core/free-name-vec module-uast))\n\n\n(defn module-spec\n  \"`yin.vm.linker.publish/publish-module!`'s spec for the module `py`\n   over the host registry `registry`. Every free name of the module tree\n   is declared under `:primitives`; a free name nothing supplies is\n   refused before anything is published. This namespace emits; it never\n   publishes.\"\n  [registry call-address]\n  (core/module-spec {:module-name module-name,\n                     :ast module-uast,\n                     :exports module-exports,\n                     :requires {'yang.call call-address},\n                     :free-names module-free-names,\n                     :skip? #(= \"yang.call\" (namespace %)),\n                     :registry registry,\n                     :message \"the py module reads an undeclared name\",\n                     :refusal-ns \"yang.python.antlr\"}))\n\n\n(def min-integer-bits\n  \"The smallest `::integer/max-bits` this profile admits: every inline\n   literal (up to 2^53 - 1) must fit (C3 S2).\"\n  53)\n\n\n(defn register-integer-module\n  \"Return `registry` with the `integer` module installed under `limits`\n   for this profile: refused when `::integer/max-bits` is under\n   `min-integer-bits`, otherwise `integer/register-integer-module`.\"\n  [registry limits]\n  (let [b (::integer/max-bits limits)]\n    (when-not (and (int? b) (<= min-integer-bits b))\n      (throw (ex-info \"the Python profile needs integer max-bits >= 53\"\n                      {:yang.python.antlr/refusal :yang.python.antlr/max-bits,\n                       ::integer/max-bits b}))))\n  (integer/register-integer-module registry limits))\n","exit_code":0,"status":"completed"}}
