{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '96,115p' test/yang/python/antlr/dht_import_test.cljc; sed -n '120,145p' test/yang/python/antlr/dht_import_fixture.cljc; sed -n '120,280p' test/yang/python/antlr/publication_test.cljc; sed -n '225,390p' test/yang/python/antlr/siteset_test.cljc; sed -n '525,540p' test/yang/python/antlr/siteset_test.cljc\"","aggregated_output":"                 [(unit \"cb\" programs/cb-packet) (unit \"ca\" programs/ca-packet)]]]\n    (is (= {:status :ok, :order [[\"ca\" \"cb\"]]}\n           (publication/publication-order units {})))))\n\n\n(deftest an-unsupplied-import-is-refused-at-publication-test\n  (let [store (mem/create-content-mem)]\n    (is (= {:status :refused,\n            :reason :yang.python.antlr/unpublished-import,\n            :module \"k\",\n            :imported-by \"t\"}\n           (publication/publish-units! store (h/registry) stand-in-address\n                                       [(unit \"t\" programs/t-packet)])))\n    (is (empty? ((:entries-fn store))))))\n\n\n;; the artifact's modules as [name manifest]: the units, then k's republication\n(defn- artifact-modules\n  [artifact]\n  (into (vec (sort-by key (:units artifact)))\n(defn generate\n  \"This host's artifact: the units published from the committed packets\n   into a store holding `py` as this host published it, `A`'s and `B`'s\n   envelopes signed over the addresses. Answers `{:lines [...]}`, or the\n   first publication refusal as `{:refused r}`.\"\n  []\n  (let [py (:address @h/published)\n        installed (installed-py)\n        store (mem/create-content-mem installed)\n        units (publication/publish-units!\n                store (h/registry) py\n                [(unit \"m\" programs/m-packet) (unit \"k\" programs/k-packet)\n                 (unit \"t\" programs/t-packet) (unit \"e\" programs/e-packet)])\n        k2 (publication/publish-units! store (h/registry) py\n                                       [(unit \"k\" programs/k2-packet)])]\n    (if-let [refused (some #(when (not= :ok (:status %)) %) [units k2])]\n      {:refused refused}\n      (let [addresses (:addresses units)\n            own (assert-names key-a 1 [['py py]\n                                       ['pym.m (get addresses \"m\")]\n                                       ['pym.k (get addresses \"k\")]\n                                       ['pym.t (get addresses \"t\")]])\n            republish [(publish/retraction\n                         key-a\n                         {:of (jing/segment-key (:envelope (nth own 2))),\n                          :seq 5})\n           (mapv :root code)))\n    (is (= [103 13 13] (mapv #(count (:rows %)) code)))))\n\n\n(deftest ^:slow deterministic-published-scc-addresses-test\n  (slow/guard \"deterministic-published-scc-addresses\"\n              (fn []\n                (let [units [{:name \"ca\", :packet programs/ca-packet}\n                             {:name \"cb\", :packet programs/cb-packet}]\n                      store (:store @h/published)\n                      py (:address @h/published)\n                      publish (fn [us] (publication/publish-units! store (h/registry) py us))\n                      first-result (publish units)\n                      second-result (publish (reverse units))]\n                  (is (= :ok (:status first-result)) (pr-str first-result))\n                  (is (= first-result second-result))\n                  (is (= #{\"ca\" \"cb\"} (set (keys (:addresses first-result)))))\n                  (let [aliases (mapv #(jing/get store % nil) (vals (:addresses first-result)))\n                        requirements (mapv :yin.module/requires aliases)\n                        bundle-address (get (first requirements) 'pyscc.ca$$cb)\n                        bundle (jing/get store bundle-address nil)]\n                    (is (= 2 (count aliases)))\n                    (is (every? #(= {'pyscc.ca$$cb bundle-address} %) requirements))\n                    (is (= {'py py} (:yin.module/requires bundle)))\n                    (is (= '#{m0-spec m0-body m1-spec m1-body} (:yin.module/exports bundle))))))))\n\n\n(deftest publication-bundles-before-aliases-test\n  (let [seen (atom [])\n        units [(unit \"a\" [\"b\" \"out\"]) (unit \"b\" [\"a\"]) (unit \"out\" [])]\n        publish-fn (fn [_ spec]\n                     (swap! seen conj (select-keys spec [:name :requires]))\n                     {:status :ok, :address (keyword \"test\" (str (:name spec)))})]\n    (is (= {:status :ok, :addresses {\"out\" :test/pym.out, \"a\" :test/pym.a, \"b\" :test/pym.b},\n            :bundles {'pyscc.a$$b :test/pyscc.a$$b}}\n           (publication/publish-units! nil (h/registry) :test/py units {} publish-fn)))\n    (is (= [{:name 'pym.out, :requires {'py :test/py}}\n            {:name 'pyscc.a$$b, :requires {'py :test/py, 'pym.out :test/pym.out}}\n            {:name 'pym.a, :requires {'pyscc.a$$b :test/pyscc.a$$b}}\n            {:name 'pym.b, :requires {'pyscc.a$$b :test/pyscc.a$$b}}]\n           @seen))))\n\n\n(deftest alias-refusal-stops-publication-test\n  (let [seen (atom [])\n        publish-fn (fn [_ spec]\n                     (swap! seen conj (:name spec))\n                     (if (= 'pym.a (:name spec))\n                       {:status :refused, :reason :test/refused}\n                       {:status :ok, :address :test/address}))]\n    (is (= {:status :refused, :reason :test/refused, :unit \"a\"}\n           (publication/publish-units! nil (h/registry) :test/py\n                                       [(unit \"a\" [\"b\"]) (unit \"b\" [\"a\"])\n                                        (unit \"later\" [])] {} publish-fn)))\n    (is (= '[pyscc.a$$b pym.a] @seen))))\n\n\n(deftest malformed-scc-member-names-test\n  (doseq [n [\"\" \".a\" \"a.\" \"a..b\" \"a$b\"]]\n    (let [diagnostic (fn [f]\n                       (try\n                         (f)\n                         nil\n                         (catch #?(:cljd Object :clj clojure.lang.ExceptionInfo :cljs ExceptionInfo) e\n                           (ex-data e))))\n          expected {:yang.python.antlr/diagnostic :yang.python.antlr/unsupported,\n                    :construct \"malformed module name\", :name n}]\n      (is (= expected (diagnostic #(lower/module-packet (:packet (unit n [])) {:name n}))))\n      ;; No packet is supplied: name validation must precede body lowering.\n      (doseq [units [[{:name n} {:name \"valid\"}]\n                     [{:name \"valid\"} {:name n}]]]\n        (is (= expected (diagnostic #(lower/scc-module-specs (h/registry) units :test/py {}))))))))\n\n\n(deftest bundle-refusal-stops-publication-test\n  (let [seen (atom [])\n        publish-fn (fn [_ spec]\n                     (swap! seen conj (:name spec))\n                     {:status :refused, :reason :test/refused})]\n    (is (= {:status :refused, :reason :test/refused, :unit \"pyscc.a$$b\"}\n           (publication/publish-units! nil (h/registry) :test/py\n                                       [(unit \"a\" [\"b\"]) (unit \"b\" [\"a\"])\n                                        (unit \"later\" [])] {} publish-fn)))\n    (is (= '[pyscc.a$$b] @seen))))\n\n\n(deftest dotted-sibling-delivery-test\n  (let [[bundle] (lower/scc-module-specs (h/registry)\n                                         [(unit \"pkg.a\" [\"pkg.b\"]) (unit \"pkg.b\" [\"pkg.a\"])]\n                                         :test/py {\"pkg\" :test/pkg})\n        ast-nodes (nodes (:ast bundle))\n        names (set (keep #(when (= :variable (:type %)) (:name %)) ast-nodes))]\n    (is (= 'pyscc.pkg$a$$pkg$b (:name bundle)))\n    (is (= '#{m0-body m1-body} (set (filter '#{m0-body m1-body} names))))\n    (is (every? #(symbol? (:name %)) (filter #(= :variable (:type %)) ast-nodes)))\n    (is (every? #(contains? names %) '[pym.pkg/spec pym.pkg/body]))\n    (is (every? #(some (fn [node] (= % (:value node))) ast-nodes)\n                [{:name \"pkg.a\", :package? false} {:name \"pkg.b\", :package? false}]))))\n\n\n(defn- scc-source\n  [store py result]\n  (link/composition\n    {:content-store store,\n     :derivation :trusted,\n     :name-env (merge {'py py} (:bundles result)\n                      (into {} (map (fn [[n a]] [(lower/module-symbol n) a])) (:addresses result)))}))\n\n\n(defn- bundle-entry\n  [task bundle-name]\n  (module/module-entry (:modules (:modules task)) bundle-name))\n\n\n(deftest bundle-closures-lift-without-cells-test\n  (let [store (mem/create-content-mem)\n        ;; Installation never calls py. A tiny pure dependency keeps this\n        ;; test fast while retaining the real require, admission, and lift.\n        py (publish/publish-module! store {:name 'py, :ast (u/lit nil), :exports #{},\n                                           :requires {}, :primitives {}})\n        result (publication/publish-units! store (h/registry) (:address py)\n                                           [(unit \"a\" [\"b\"]) (unit \"b\" [\"a\"])])\n        source (scc-source store (:address py) result)]\n    (is (keyword? (:address py)) (pr-str (select-keys py [:status :reason :address])))\n    (is (= :ok (:status result)) (pr-str result))\n    (doseq [backend (keys h/backends)]\n      (let [task (h/run-linked backend (u/app (u/v 'try-require) (u/lit 'pym.a))\n                               {:link-source source})\n            entry (bundle-entry task 'pyscc.a$$b)]\n        (is (vm/halted? task) (str backend))\n        (is (= :ok (:status (vm/value task))) (str backend \" \" (pr-str (vm/value task))))\n        (is (= '#{m0-spec m1-spec m0-body m1-body} (set (keys (:slice entry)))) (str backend))\n        (doseq [body-key '[m0-body m1-body]]\n          (let [marker (get-in entry [:slice body-key])\n                env-key (if (= :semantic backend) :yin.k/env :yin.k/frames)]\n            (is (contains? marker env-key) (str backend \" \" body-key))\n            (is (empty? (get marker env-key)) (str backend \" \" body-key))))\n        (is (not-any? #(= :cell-ref (:type %)) (tree-seq coll? seq entry)) (str backend))))))\n\n\n(deftest ^:slow bundle-alias-delivery-and-lift-test\n  (slow/guard \"bundle-alias-delivery-and-lift\"\n              (fn []\n                (let [units [{:name \"ca\", :packet programs/ca-packet}\n                             {:name \"cb\", :packet programs/cb-packet}]\n                      {:keys [store address]} @h/published\n                      result (publication/publish-units! store (h/registry) address units)\n                      source (scc-source store address result)]\n                  (is (= :ok (:status result)) (pr-str result))\n                  (doseq [backend (keys h/backends)]\n                    ;; The real prelude and both aliases traverse the linker,\n                    ;; so inspect the bundle slice it actually lifted.\n                    (doseq [alias '[pym.ca pym.cb]]\n                      (let [task (h/run-linked backend\n                                               (u/app (u/v 'try-require) (u/lit alias))\n                                               {:link-source source})\n                            answer (vm/value task)\n                            entry (bundle-entry task 'pyscc.ca$$cb)]\n                        (is (= :ok (:status answer)) (str backend \" \" alias \" \" (pr-str answer)))\n                        (is (= '#{m0-spec m1-spec m0-body m1-body} (set (keys (:slice entry)))) (str backend))\n                        (is (not-any? #(= :cell-ref (:type %)) (tree-seq coll? seq entry)) (str backend)))))))))\n\n(defn- records-of\n  \"`{manifest [record-address]}` for the publication `result`.\"\n  [result]\n  (into {}\n        (map (fn [[n s]]\n               [(get (:addresses result) n) [(:record-address s)]]))\n        (:sites result)))\n\n\n(def ^:private no-datoms\n  {:datoms [], :principals []})\n\n\n(deftest an-scc-member-alias-carries-no-set-test\n  (let [[store py pysp] (stub-store)\n        result (publication/publish-units!\n                 store (h/registry) py\n                 [{:name \"ca\", :packet programs/ca-packet}\n                  {:name \"cb\", :packet programs/cb-packet}])\n        bundle (get (:bundles result) 'pyscc.ca$$cb)\n        alias-a (get (:addresses result) \"ca\")\n        bundle-site (get (:sites result) 'pyscc.ca$$cb)\n        ctx (assoc no-datoms :store store)]\n    (is (= :ok (:status result)) (pr-str result))\n    (testing \"the marks are in the bundle, which carries the set\"\n      (is (seq (:set bundle-site)))\n      (is (nil? (siteset/verify store bundle (:record-address bundle-site))))\n      (is (= :ok (:status (siteset/admit store bundle\n                                         [(:record-address bundle-site)]\n                                         requirement)))))\n    (testing \"an alias has no marks and no set\"\n      (is (not (contains? (:sites result) \"ca\")))\n      (is (not (contains? (:sites result) \"cb\"))))\n    (testing \"a member import under a hook profile is refused by the stage,\n              not run uninstrumented under the lie of an empty set\"\n      (let [out ((siteset/stage (h/registry) (hook-requirement pysp) {})\n                 ctx 'pym.ca alias-a)]\n        (is (= :refused (:status out)))\n        (is (= :yang.python.antlr/missing-site-set (:reason out)))\n        (is (contains? siteset/reasons (:reason out)))\n        (is (= 'pym.ca (:name out)))\n        (is (= :py/hooks (:profile out)))))\n    (testing \"a noninterruptible profile imports the alias as published\"\n      (is (= {:status :ok, :address alias-a}\n             (select-keys ((siteset/stage (h/registry)\n                                          {:profile :py/plain,\n                                           :noninterruptible true}\n                                          {})\n                           ctx 'pym.ca alias-a)\n                          [:status :address]))))\n    (is (some? bundle))))\n\n\n(deftest the-stage-answers-the-derive-record-test\n  (let [[store py pysp] (stub-store)\n        result (publication/publish-units!\n                 store (h/registry) py\n                 [{:name \"w\", :packet loops/while-true-pass}])\n        manifest (get (:addresses result) \"w\")\n        ctx (assoc no-datoms :store store)\n        out ((siteset/stage (h/registry) (hook-requirement pysp)\n                            (records-of result))\n             ctx 'pym.w manifest)\n        record (jing/get store (:derivation out) nil)\n        selected (filter (fn [[_ mark]]\n                           (#{:loop :call} (if (vector? mark) (first mark) mark)))\n                         (:set (get (:sites result) \"w\")))\n        sites-address (jing/segment-key (safepoint/site-set selected))]\n    (is (= :ok (:status out)) (pr-str out))\n    (is (not= manifest (:address out)))\n    (testing \"the :derive record is materialized and answered\"\n      (is (= :derive (:yin.ledger/op record)))\n      (is (= :yang.safepoint/insert (:yin.ledger/function record)))\n      (is (= (:yin.module/tree (jing/get store manifest nil))\n             (:yin.ledger/input record)))\n      (is (= (:yin.module/tree (jing/get store (:address out) nil))\n             (:yin.ledger/output record)))\n      (is (= {:yang.safepoint/hooks hooks/linked-profile,\n              :yang.safepoint/sites sites-address}\n             (:yin.ledger/profile record))))))\n\n\n(deftest a-dependency-with-no-set-refuses-the-chain-test\n  (let [[store py pysp] (stub-store)\n        result (publication/publish-units!\n                 store (h/registry) py\n                 [{:name \"k\", :packet programs/k-packet}\n                  {:name \"t\", :packet programs/t-packet}])\n        records (records-of result)\n        t (get (:addresses result) \"t\")\n        k (get (:addresses result) \"k\")\n        stage (siteset/stage (h/registry) (hook-requirement pysp)\n                             (dissoc records k))\n        out (stage (assoc no-datoms