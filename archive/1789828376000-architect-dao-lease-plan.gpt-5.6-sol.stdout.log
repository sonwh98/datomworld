am.cljc-159-  (cursor\nsrc/cljc/dao/stream.cljc-160-    [handle anchor]\nsrc/cljc/dao/stream.cljc-161-    \"Mint an immutable cursor from anchor (:dao.stream/oldest, :dao.stream/newest,\nsrc/cljc/dao/stream.cljc-162-     or transport-specific anchor).\nsrc/cljc/dao/stream.cljc-163-     Returns outcome map with :dao.stream/cursor on :dao.stream/ok.\")\nsrc/cljc/dao/stream.cljc-164-\nsrc/cljc/dao/stream.cljc-165-  (next\nsrc/cljc/dao/stream.cljc-166-    [handle cursor]\nsrc/cljc/dao/stream.cljc-167-    \"Read the value at cursor position. Total and non-blocking.\nsrc/cljc/dao/stream.cljc-168-     Returns read outcome map.\"))\nsrc/cljc/dao/stream.cljc-169-\nsrc/cljc/dao/stream.cljc-170-\nsrc/cljc/dao/stream.cljc:171:(defprotocol IDaoStreamWriter\nsrc/cljc/dao/stream.cljc-172-  \"Writer surface: append values to the sequence this handle's writer surface is on.\"\nsrc/cljc/dao/stream.cljc-173-\nsrc/cljc/dao/stream.cljc:174:  (append!\nsrc/cljc/dao/stream.cljc-175-    [handle val]\nsrc/cljc/dao/stream.cljc-176-    \"Append val to the sequence. Total and non-blocking.\nsrc/cljc/dao/stream.cljc-177-     Returns write outcome map.\"))\nsrc/cljc/dao/stream.cljc-178-\nsrc/cljc/dao/stream.cljc-179-\nsrc/cljc/dao/stream.cljc:180:(defprotocol IDaoStreamClosable\nsrc/cljc/dao/stream.cljc-181-  \"Closable surface: close what this handle is on (logical stream or attachment).\nsrc/cljc/dao/stream.cljc-182-   Idempotent.\"\nsrc/cljc/dao/stream.cljc-183-\nsrc/cljc/dao/stream.cljc-184-  (close!\nsrc/cljc/dao/stream.cljc-185-    [handle]\nsrc/cljc/dao/stream.cljc-186-    \"Closes what this handle is on. Irrevocable.\nsrc/cljc/dao/stream.cljc-187-     Returns outcome map {:dao.stream/outcome :dao.stream/ok}.\"))\nsrc/cljc/dao/stream.cljc-188-\nsrc/cljc/dao/stream.cljc-189-\nsrc/cljc/dao/stream.cljc-190-;; =============================================================================\nsrc/cljc/dao/stream.cljc-191-;; Surface Inspection & Gating\nsrc/cljc/dao/stream.cljc-192-;; =============================================================================\nsrc/cljc/dao/stream.cljc-193-\nsrc/cljc/dao/stream.cljc-194-(defn reader?\nsrc/cljc/dao/stream.cljc:195:  \"True if handle implements the reader surface (IDaoStreamReader).\"\nsrc/cljc/dao/stream.cljc-196-  [handle]\nsrc/cljc/dao/stream.cljc:197:  (satisfies? IDaoStreamReader handle))\nsrc/cljc/dao/stream.cljc-198-\nsrc/cljc/dao/stream.cljc-199-\nsrc/cljc/dao/stream.cljc-200-(defn writer?\nsrc/cljc/dao/stream.cljc:201:  \"True if handle implements the writer surface (IDaoStreamWriter).\"\nsrc/cljc/dao/stream.cljc-202-  [handle]\nsrc/cljc/dao/stream.cljc:203:  (satisfies? IDaoStreamWriter handle))\nsrc/cljc/dao/stream.cljc-204-\nsrc/cljc/dao/stream.cljc-205-\nsrc/cljc/dao/stream.cljc-206-(defn closable?\nsrc/cljc/dao/stream.cljc:207:  \"True if handle implements the closable surface (IDaoStreamClosable).\"\nsrc/cljc/dao/stream.cljc-208-  [handle]\nsrc/cljc/dao/stream.cljc:209:  (satisfies? IDaoStreamClosable handle))\nsrc/cljc/dao/stream.cljc-210-\nsrc/cljc/dao/stream.cljc-211-\nsrc/cljc/dao/stream.cljc-212-(defn descriptor?\nsrc/cljc/dao/stream.cljc:213:  \"True if handle implements IDaoStreamDescriptor.\"\nsrc/cljc/dao/stream.cljc-214-  [handle]\nsrc/cljc/dao/stream.cljc:215:  (satisfies? IDaoStreamDescriptor handle))\nsrc/cljc/dao/stream.cljc-216-\nsrc/cljc/dao/stream.cljc-217-\nsrc/cljc/dao/stream.cljc-218-(defn declared-surfaces\nsrc/cljc/dao/stream.cljc-219-  \"Returns set of public surfaces implemented by handle:\nsrc/cljc/dao/stream.cljc-220-   subset of #{:reader :writer :closable}.\"\nsrc/cljc/dao/stream.cljc-221-  [handle]\nsrc/cljc/dao/stream.cljc-222-  (cond-> #{}\nsrc/cljc/dao/stream.cljc-223-    (reader? handle) (conj :reader)\n--\nsrc/cljc/dao/stream.cljc-346-;; Transport Entry Functions & Host Dispatch\nsrc/cljc/dao/stream.cljc-347-;; =============================================================================\nsrc/cljc/dao/stream.cljc-348-;;\nsrc/cljc/dao/stream.cljc-349-;; Two transport entry functions: create! and attach!\nsrc/cljc/dao/stream.cljc-350-;; These take no handle because none exists yet. These are per-transport functions,\nsrc/cljc/dao/stream.cljc-351-;; host-composed, taking whatever composition state the transport needs.\nsrc/cljc/dao/stream.cljc-352-;;\nsrc/cljc/dao/stream.cljc-353-;; Putting create! or attach! on a protocol is how the retired registry grows back;\nsrc/cljc/dao/stream.cljc:354:;; DaoStream v2 ships no dispatch machinery (no multimethod, no registry,\nsrc/cljc/dao/stream.cljc-355-;; no load-time side effect).\nsrc/cljc/dao/stream.cljc-356-;;\nsrc/cljc/dao/stream.cljc-357-;; Dynamic dispatch on :dao.stream/type is performed by the host using an ordinary\nsrc/cljc/dao/stream.cljc-358-;; host-owned lookup table:\nsrc/cljc/dao/stream.cljc-359-;;\nsrc/cljc/dao/stream.cljc-360-;;   {:dao.stream/ringbuffer {:dao.stream/create ringbuffer/create!\nsrc/cljc/dao/stream.cljc-361-;;                            :dao.stream/attach ringbuffer/attach!}\nsrc/cljc/dao/stream.cljc-362-;;    :dao.stream/ws         {:dao.stream/attach ws/attach!}}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"pause has to be a lease|whose facts are datoms|dao\\\\.space|lease\\\" docs/design/dao.stream.md && nl -ba src/cljc/dao/stream/observe.cljc | sed -n '1,150p' && nl -ba src/cljc/dao/stream/ringbuffer.cljc | sed -n '1,215p' && nl -ba src/cljc/dao/stream/serving.cljc | sed -n '78,205p' && nl -ba src/cljc/dao/stream/ws.cljc | sed -n '350,430p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"pause has to be a lease|whose facts are datoms|dao\\\\.space|lease\\\" docs/design/dao.stream.md && nl -ba src/cljc/dao/stream/observe.cljc | sed -n '1,150p' && nl -ba src/cljc/dao/stream/ringbuffer.cljc | sed -n '1,215p' && nl -ba src/cljc/dao/stream/serving.cljc | sed -n '78,205p' && nl -ba src/cljc/dao/stream/ws.cljc | sed -n '350,430p'\"","aggregated_output":"585:A transport whose close must also flush or release something that can fail\n753:has to be a lease and not a switch to avoid permanently stuck states. Those\n754:semantics live in `dao.lease.md`, whose facts are datoms on a medium\n755:(`dao.space`). DaoStream provides the honest baseline: a cursor that falls\n772:  an assertion that it no longer holds, which `dao.space` already expresses as\n775:  *exclusion* of competing takers, which is a lease over datoms\n776:  (`dao.lease.md`), not something a stream can promise. v1's `drain-one!`\n1005:  shape: three in `dao.space.index` (index walks and manifest reads), four in\n1023:`dao.space` index; a VM loading code by address from another node\n1032:answers a question (a lookup, a query against a remote peer, a lease grant, a\n1058:`dao.space.index` and `dao.data.btree.storage` become steppable: fetch, receive\n1082:  `dao.space` practices and this document should say once in *Concurrency*.\n     1\t(ns dao.stream.observe\n     2\t  \"One observation step over a DaoStream reader: read a value, act on it, and\n     3\t   advance the cursor only if the act succeeded.\n     4\t\n     5\t   `step` owns no scheduler, loop, state, callback or policy.  It classifies\n     6\t   every outcome the contract declares as data and hands the caller what it\n     7\t   needs to decide: the successor cursor on progress, the recovery cursor on a\n     8\t   gap, the raw answer on a defect.  What to do about a gap, whether a defect\n     9\t   is fatal, how many values to take per turn, and what state to carry between\n    10\t   turns all belong to the caller.\n    11\t\n    12\t   The cursor advances in exactly one place -- after the effect has answered\n    13\t   `ok` -- so effect-before-commit is a property of this seam rather than a\n    14\t   rule each caller keeps.  An effect that throws propagates before any\n    15\t   successor exists, which gives a throwing effect the same guarantee for\n    16\t   free.\n    17\t\n    18\t   Callers are `dao.stream.forward` (effect: append to another stream),\n    19\t   `dao.stream.observer` (effect: load a program into a VM) and\n    20\t   `dao.jing` (effect: materialize content).  Each adds its own loop and its\n    21\t   own policy above this step.\n    22\t\n    23\t   The law every interpreter here obeys is that an element's cursor advances\n    24\t   exactly when its disposition has been durably recorded.  This step serves\n    25\t   the interpreters whose disposition is an external, refusable effect -- an\n    26\t   append, a load, a materialization -- where that means advancing only after\n    27\t   the effect answered ok.  Interpreters whose disposition is a local, total\n    28\t   state transition keep their own read loops: `dao.stream.rpc/poll!`,\n    29\t   `dao.stream.apply/serve-once!` and `yin.vm.engine`'s wait set thread\n    30\t   whole caller state under a budget with terminal short-circuits, and for\n    31\t   them advancing first and advancing after the commit are the same fact,\n    32\t   because no window exists in which one happened and the other did not.\n    33\t   `serve-once!` is the proof that this is one law and not two families: it\n    34\t   advances after delivery for a correlatable request, on the diagnostic for\n    35\t   an uncorrelatable one, and on terminal loss for an undeliverable response.\n    36\t\n    37\t   There is no ordering parameter here and none is needed.  A consumer that\n    38\t   wants an element consumed even when its interpretation is defective writes\n    39\t   a *total* effect -- one that classifies every element as data and so always\n    40\t   answers ok -- and gets consume-exactly-once through this same step.\"\n    41\t  (:require [dao.stream :as stream]))\n    42\t\n    43\t\n    44\t(defn- valid-or-transport-error\n    45\t  \"Fold a defective host answer into the contract's outcome algebra.\n    46\t\n    47\t   A conforming operation already returns one of the contract outcomes; this\n    48\t   keeps the step's branch total when a composition supplies a bad handle or\n    49\t   an effect answers with something that is not an outcome map.\"\n    50\t  [operation result]\n    51\t  (if (stream/valid-outcome? operation result)\n    52\t    result\n    53\t    {:dao.stream/outcome :dao.stream/transport-error\n    54\t     :dao.stream/error :dao.stream/invalid-operation-result\n    55\t     :dao.stream/answer result}))\n    56\t\n    57\t\n    58\t(defn step\n    59\t  \"Read one value from `source` at `cursor` and run `effect` on it.\n    60\t\n    61\t   `effect` is `(fn [value] -> outcome-map)` answering with the writer outcome\n    62\t   set: `ok`, `full` (\\\"not yet\\\"), `invalid-value`, `closed`, or\n    63\t   `transport-error`.  Any other answer is classified as `transport-error`\n    64\t   with the raw answer retained.  An effect that throws propagates.\n    65\t\n    66\t   Returns a map carrying `:cursor` and `:read` (the raw read answer) in every\n    67\t   case:\n    68\t\n    69\t   | status     | when                                    | cursor    | also         |\n    70\t   | ---------- | --------------------------------------- | --------- | ------------ |\n    71\t   | `:advance` | read ok, effect ok                      | successor | `:effect`    |\n    72\t   | `:retry`   | read blocked, or effect full            | unchanged | `:outcome`   |\n    73\t   | `:ended`   | read end                                | unchanged | `:outcome`   |\n    74\t   | `:gap`     | read gap                                | unchanged | `:recovery`  |\n    75\t   | `:defect`  | read cursor-mismatch, invalid-cursor,\n    76\t                  transport-error, or malformed                | unchanged | `:outcome`   |\n    77\t   | `:failed`  | effect invalid-value, closed,\n    78\t                  transport-error, or malformed                | unchanged | `:outcome`, `:effect` |\n    79\t\n    80\t   A `:retry` from the effect also carries `:effect`.  The cursor is the\n    81\t   successor on `:advance` and unchanged on every other status.\"\n    82\t  [source cursor effect]\n    83\t  (let [read-result (valid-or-transport-error :next (stream/next source cursor))\n    84\t        read-outcome (:dao.stream/outcome read-result)]\n    85\t    (case read-outcome\n    86\t      :dao.stream/ok\n    87\t      (let [effect-result (valid-or-transport-error\n    88\t                            :append!\n    89\t                            (effect (:dao.stream/value read-result)))\n    90\t            effect-outcome (:dao.stream/outcome effect-result)]\n    91\t        (case effect-outcome\n    92\t          :dao.stream/ok {:status :advance\n    93\t                          :cursor (:dao.stream/cursor read-result)\n    94\t                          :read read-result\n    95\t                          :effect effect-result}\n    96\t          :dao.stream/full {:status :retry\n    97\t                            :cursor cursor\n    98\t                            :outcome effect-outcome\n    99\t                            :read read-result\n   100\t                            :effect effect-result}\n   101\t          {:status :failed\n   102\t           :cursor cursor\n   103\t           :outcome effect-outcome\n   104\t           :read read-result\n   105\t           :effect effect-result}))\n   106\t\n   107\t      :dao.stream/blocked {:status :retry\n   108\t                           :cursor cursor\n   109\t                           :outcome read-outcome\n   110\t                           :read read-result}\n   111\t\n   112\t      :dao.stream/end {:status :ended\n   113\t                       :cursor cursor\n   114\t                       :outcome read-outcome\n   115\t                       :read read-result}\n   116\t\n   117\t      :dao.stream/gap {:status :gap\n   118\t                       :cursor cursor\n   119\t                       :outcome read-outcome\n   120\t                       :recovery (:dao.stream/cursor read-result)\n   121\t                       :read read-result}\n   122\t\n   123\t      {:status :defect\n   124\t       :cursor cursor\n   125\t       :outcome read-outcome\n   126\t       :read read-result})))\n     1\t(ns dao.stream.ringbuffer\n     2\t  \"Fixed-capacity, evict-oldest DaoStream v2 reference transport.\"\n     3\t  (:require [dao.stream :as stream]))\n     4\t\n     5\t\n     6\t(def transport-type :dao.stream/ringbuffer)\n     7\t(def capacity-key :dao.stream.ringbuffer/capacity)\n     8\t\n     9\t\n    10\t(defn- result\n    11\t  [outcome]\n    12\t  {:dao.stream/outcome outcome})\n    13\t\n    14\t\n    15\t(defn- valid-spec?\n    16\t  [spec]\n    17\t  (and (map? spec)\n    18\t       (= transport-type (:dao.stream/type spec))\n    19\t       (integer? (get spec capacity-key))\n    20\t       (pos? (get spec capacity-key))))\n    21\t\n    22\t\n    23\t(defn- fresh-state\n    24\t  [capacity]\n    25\t  ;; The logical identity is carried in descriptors and cursors.  It therefore\n    26\t  ;; belongs to DaoStream's portable data domain, unlike a host UUID object.\n    27\t  (atom {:identity (str (random-uuid))\n    28\t         :capacity capacity\n    29\t         :first 0\n    30\t         :tail 0\n    31\t         :values {}\n    32\t         :closed? false\n    33\t         :attachments {}}))\n    34\t\n    35\t\n    36\t(declare attach!)\n    37\t\n    38\t\n    39\t(deftype RingHandle\n    40\t  [state attachment-id owner?]\n    41\t\n    42\t  stream/IDaoStreamDescriptor\n    43\t\n    44\t  (descriptor\n    45\t    [_]\n    46\t    (let [s @state]\n    47\t      {:dao.stream/outcome :dao.stream/ok\n    48\t       :dao.stream/descriptor {:dao.stream/type transport-type\n    49\t                               :dao.stream/identity (:identity s)}\n    50\t       :dao.stream/identity (:identity s)}))\n    51\t\n    52\t\n    53\t  stream/IDaoStreamReader\n    54\t\n    55\t  (cursor\n    56\t    [_ anchor]\n    57\t    (let [s @state]\n    58\t      (if (and (not owner?) (not (get-in s [:attachments attachment-id :open?])))\n    59\t        (result :dao.stream/closed)\n    60\t        (case anchor\n    61\t          :dao.stream/oldest (assoc (result :dao.stream/ok)\n    62\t                                    :dao.stream/cursor\n    63\t                                    {:dao.stream.ringbuffer/identity (:identity s)\n    64\t                                     :dao.stream.ringbuffer/position (:first s)})\n    65\t          :dao.stream/newest (assoc (result :dao.stream/ok)\n    66\t                                    :dao.stream/cursor\n    67\t                                    {:dao.stream.ringbuffer/identity (:identity s)\n    68\t                                     :dao.stream.ringbuffer/position (:tail s)})\n    69\t          (result :dao.stream/invalid-anchor)))))\n    70\t\n    71\t\n    72\t  (next\n    73\t    [_ cursor-value]\n    74\t    (let [s @state]\n    75\t      (cond\n    76\t        (not (map? cursor-value)) (result :dao.stream/invalid-cursor)\n    77\t        (not (contains? cursor-value :dao.stream.ringbuffer/identity))\n    78\t        (result :dao.stream/invalid-cursor)\n    79\t        (not= (:identity s) (:dao.stream.ringbuffer/identity cursor-value))\n    80\t        (result :dao.stream/cursor-mismatch)\n    81\t        (not (integer? (:dao.stream.ringbuffer/position cursor-value)))\n    82\t        (result :dao.stream/invalid-cursor)\n    83\t        :else\n    84\t        (let [pos (:dao.stream.ringbuffer/position cursor-value)\n    85\t              frozen (when-not owner? (get-in s [:attachments attachment-id :tail]))\n    86\t              visible-tail (if (some? frozen) frozen (:tail s))]\n    87\t          (cond\n    88\t            (< pos (:first s))\n    89\t            (assoc (result :dao.stream/gap)\n    90\t                   :dao.stream/cursor\n    91\t                   {:dao.stream.ringbuffer/identity (:identity s)\n    92\t                    ;; The contract's recovery position is the earliest retained\n    93\t                    ;; position, which equals the tail when nothing is retained.\n    94\t                    ;; It must never be an evicted position: a frozen attachment\n    95\t                    ;; whose visible history is fully evicted would otherwise be\n    96\t                    ;; handed its own tail back and re-gap forever.  Recovering\n    97\t                    ;; past that tail is correct; the next read answers `end`.\n    98\t                    :dao.stream.ringbuffer/position (:first s)})\n    99\t            (< pos visible-tail)\n   100\t            ;; `:first`, `:tail`, and `:values` are updated as one state value;\n   101\t            ;; positions in this interval are always retained by the transport.\n   102\t            {:dao.stream/outcome :dao.stream/ok\n   103\t             :dao.stream/value (get (:values s) pos)\n   104\t             :dao.stream/cursor {:dao.stream.ringbuffer/identity (:identity s)\n   105\t                                 :dao.stream.ringbuffer/position (inc pos)}}\n   106\t            (or (:closed? s) (some? frozen)) (result :dao.stream/end)\n   107\t            :else (result :dao.stream/blocked))))))\n   108\t\n   109\t\n   110\t  stream/IDaoStreamWriter\n   111\t\n   112\t  (append!\n   113\t    [_ value]\n   114\t    ;; Check attachment liveness *inside* the one state transition.  A deref\n   115\t    ;; before swap! permits an append that began before an attachment close to\n   116\t    ;; land after it; this form gives append!/close! a single linearization point.\n   117\t    (let [out (volatile! nil)]\n   118\t      (swap! state\n   119\t             (fn [s]\n   120\t               (if (or (:closed? s)\n   121\t                       (and (not owner?)\n   122\t                            (not (get-in s [:attachments attachment-id :open?]))))\n   123\t                 (do (vreset! out (result :dao.stream/closed)) s)\n   124\t                 (let [p (:tail s) n (inc p)\n   125\t                       first' (max (:first s) (- n (:capacity s)))]\n   126\t                   (vreset! out (result :dao.stream/ok))\n   127\t                   (-> s (assoc :tail n :first first')\n   128\t                       (assoc :values\n   129\t                              (assoc (if (> first' (:first s))\n   130\t                                       (dissoc (:values s) (:first s))\n   131\t                                       (:values s)) p value)))))))\n   132\t      @out))\n   133\t\n   134\t\n   135\t  stream/IDaoStreamClosable\n   136\t\n   137\t  (close!\n   138\t    [_]\n   139\t    (swap! state\n   140\t           (fn [s]\n   141\t             (if owner?\n   142\t               (assoc s :closed? true)\n   143\t               ;; Preserve the first frozen tail.  Later idempotent closes must\n   144\t               ;; not make post-close values visible through this attachment.\n   145\t               (if (get-in s [:attachments attachment-id :open?])\n   146\t                 (assoc-in s [:attachments attachment-id]\n   147\t                           {:open? false :tail (:tail s)})\n   148\t                 s))))\n   149\t    (result :dao.stream/ok)))\n   150\t\n   151\t\n   152\t(defn create!\n   153\t  \"Create a ring buffer from a creation specification.\"\n   154\t  [spec]\n   155\t  (if-not (valid-spec? spec)\n   156\t    (result :dao.stream/invalid-spec)\n   157\t    (let [state (fresh-state (get spec capacity-key))]\n   158\t      {:dao.stream/outcome :dao.stream/ok\n   159\t       :dao.stream/handle (RingHandle. state nil true)\n   160\t       :dao.stream/identity (:identity @state)})))\n   161\t\n   162\t\n   163\t(defn- resolve-state\n   164\t  [resolver identity]\n   165\t  (let [x (if (fn? resolver) (resolver identity) (get resolver identity))]\n   166\t    (cond (instance? RingHandle x) (.-state ^RingHandle x)\n   167\t          #?(:cljd false\n   168\t             :clj (instance? clojure.lang.IAtom x)\n   169\t             :cljs (instance? cljs.core/Atom x)) x\n   170\t          :else nil)))\n   171\t\n   172\t\n   173\t(defn attach!\n   174\t  \"Attach using a host-owned resolver (identity -> handle/state).\"\n   175\t  [resolver descriptor]\n   176\t  (if-not (and (map? descriptor)\n   177\t               (= transport-type (:dao.stream/type descriptor))\n   178\t               (contains? descriptor :dao.stream/identity))\n   179\t    (result :dao.stream/invalid-descriptor)\n   180\t    (if-let [state (resolve-state resolver (:dao.stream/identity descriptor))]\n   181\t      ;; A resolver is host composition, not a trusted decoder.  Confirm that\n   182\t      ;; its result actually denotes the descriptor's identity before minting a\n   183\t      ;; handle; otherwise a mis-keyed directory silently attaches elsewhere.\n   184\t      (if (= (:dao.stream/identity descriptor) (:identity @state))\n   185\t        (let [id (str (random-uuid))]\n   186\t          (swap! state assoc-in [:attachments id] {:open? true})\n   187\t          {:dao.stream/outcome :dao.stream/ok\n   188\t           :dao.stream/handle (RingHandle. state id false)\n   189\t           :dao.stream/attachment id})\n   190\t        (result :dao.stream/not-found))\n   191\t      (result :dao.stream/not-found))))\n   192\t\n   193\t\n   194\t(defn make-attacher\n   195\t  \"Return a unary attach! closure over host-owned resolver state.\n   196\t   This small directory is composition/test infrastructure, never a registry\n   197\t   owned by DaoStream or this namespace.\"\n   198\t  [resolver]\n   199\t  (fn [descriptor] (attach! resolver descriptor)))\n    78\t(defn make-serving\n    79\t  \"Construct an inert serving composition.  It starts only when `start!` is\n    80\t   called, and advances only when the host calls `step!` with an explicit time.\n    81\t\n    82\t   Required config is deliberately concrete composition data:\n    83\t\n    84\t   * `:endpoint` is a `dao.stream.ws/make-endpoint` value.\n    85\t   * `:served` maps canonical `:ws/path` strings to\n    86\t     `{:descriptor <ws descriptor> :stream <reader handle>}`.  It is the\n    87\t     host's resolution table, not a DaoStream registry.\n    88\t   * `:control-reader` and `:control-cursor` observe the endpoint's pre-accept\n    89\t     control medium.\n    90\t   * `:slots` are in the endpoint's handoff order and contain `:offer-reader`,\n    91\t     an already-minted `:offer-cursor`, and an `:ack-writer` target.\n    92\t   * `:make-traffic` receives an accepted offer and returns a newly-created\n    93\t     per-attachment traffic medium, its declaration, reader, and minted cursor.\n    94\t   * `:start-endpoint!`, `:stop-endpoint!`, and `:close-ended!` are host policy\n    95\t     functions.  `:close-ended!` must perform the WebSocket 4000 close; generic\n    96\t     DaoStream `close!` means only detachment.\n    97\t\n    98\t   `:inbound-step`, when supplied, is an explicit application interpreter run\n    99\t   by this driver for non-terminal per-attachment traffic events.  Omitting it\n   100\t   means inbound payload is deliberately not appended to the served stream.\"\n   101\t  [{:keys [endpoint served control-reader control-cursor slots make-traffic\n   102\t           start-endpoint! stop-endpoint!]\n   103\t    :as config}]\n   104\t  (when-not endpoint\n   105\t    (throw (ex-info \"serving composition needs an endpoint\" {:config config})))\n   106\t  (when-not (and (map? served) (seq served)\n   107\t                 (every? (fn [[path entry]] (supplied-stream? entry path)) served))\n   108\t    (throw (ex-info \"serving composition needs canonical paths and reader streams\"\n   109\t                    {:served served})))\n   110\t  ;; `ws/make-endpoint` intentionally receives only descriptors while this\n   111\t  ;; composition additionally owns the source handles.  When given that\n   112\t  ;; concrete endpoint, reject two subtly different host path tables rather\n   113\t  ;; than acknowledging an offer for a stream this driver would forward from\n   114\t  ;; somewhere else.\n   115\t  (when-let [endpoint-served (get-in endpoint [:config :served])]\n   116\t    (let [descriptors (into {} (map (fn [[path entry]] [path (:descriptor entry)])) served)]\n   117\t      (when-not (= endpoint-served descriptors)\n   118\t        (throw (ex-info \"endpoint and serving resolution tables disagree\"\n   119\t                        {:endpoint-served endpoint-served :served descriptors})))))\n   120\t  (when-not (and (reader? control-reader) (some? control-cursor))\n   121\t    (throw (ex-info \"serving composition needs a control reader and cursor\"\n   122\t                    {:control-reader control-reader :control-cursor control-cursor})))\n   123\t  (when-not (and (seq slots) (every? valid-slot? slots))\n   124\t    (throw (ex-info \"serving composition needs valid handoff readers and writers\"\n   125\t                    {:slots slots})))\n   126\t  (when-not (fn? make-traffic)\n   127\t    (throw (ex-info \"serving composition needs a traffic-medium factory\" {})))\n   128\t  (when-not (every? fn? [start-endpoint! stop-endpoint!])\n   129\t    (throw (ex-info \"serving lifecycle policies are required\" {})))\n   130\t  {:config (merge {:endpoint-step ws/endpoint-step\n   131\t                   :forward-options forward/default-options\n   132\t                   :close-ended! ws/close-ended!\n   133\t                   :close-attachment! stream/close!}\n   134\t                  config)\n   135\t   ;; This atom is explicit host composition state, not namespace state.  It is\n   136\t   ;; retained by the returned value and is owned by the host's one driver.\n   137\t   :state (atom {:lifecycle :new\n   138\t                 :endpoint endpoint\n   139\t                 :control-cursor control-cursor\n   140\t                 :offer-cursors (mapv :offer-cursor slots)\n   141\t                 :sessions {}})})\n   142\t\n   143\t\n   144\t(defn state\n   145\t  \"Return the composition's explicit driver state as data.\"\n   146\t  [serving]\n   147\t  @(:state serving))\n   148\t\n   149\t\n   150\t(defn start!\n   151\t  \"Start the host endpoint once.  The host start function is the only place a\n   152\t   listener may be bound; no listener or cadence is installed by this namespace.\"\n   153\t  [serving]\n   154\t  (let [run? (volatile! false)]\n   155\t    (swap! (:state serving)\n   156\t           (fn [s]\n   157\t             (if (= :new (:lifecycle s))\n   158\t               (do (vreset! run? true) (assoc s :lifecycle :starting))\n   159\t               s)))\n   160\t    (if-not @run?\n   161\t      (:start-result (state serving))\n   162\t      (let [result (try\n   163\t                     ((:start-endpoint! (:config serving)) (:endpoint (state serving)))\n   164\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   165\t                       {:dao.stream/outcome :dao.stream/transport-error}))]\n   166\t        (swap! (:state serving) assoc\n   167\t               :lifecycle (if (= :dao.stream/transport-error (:dao.stream/outcome result))\n   168\t                            :failed\n   169\t                            :running)\n   170\t               :start-result result)\n   171\t        result))))\n   172\t\n   173\t\n   174\t(defn- remove-session!\n   175\t  [serving attachment]\n   176\t  (swap! (:state serving) update :sessions dissoc attachment))\n   177\t\n   178\t\n   179\t(defn- close-session!\n   180\t  [serving attachment]\n   181\t  (when-let [session (get-in (state serving) [:sessions attachment])]\n   182\t    (call-close! (:close-attachment! (:config serving)) (:socket-handle session))\n   183\t    (remove-session! serving attachment)))\n   184\t\n   185\t\n   186\t(defn stop!\n   187\t  \"Stop the endpoint through the host-owned lifecycle policy.  Established\n   188\t   attachments are detached, not reported as logical-stream endings; ending a\n   189\t   served stream is instead handled by the forwarder's `:source-ended` branch.\"\n   190\t  [serving]\n   191\t  (let [stop? (volatile! false)]\n   192\t    (swap! (:state serving)\n   193\t           (fn [s]\n   194\t             (if (contains? #{:new :starting :running :failed} (:lifecycle s))\n   195\t               (do (vreset! stop? true) (assoc s :lifecycle :stopping))\n   196\t               s)))\n   197\t    (if-not @stop?\n   198\t      (:stop-result (state serving))\n   199\t      (do\n   200\t        (doseq [attachment (keys (:sessions (state serving)))]\n   201\t          (close-session! serving attachment))\n   202\t        (let [result (try\n   203\t                       ((:stop-endpoint! (:config serving)) (:endpoint (state serving)))\n   204\t                       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   205\t                         {:dao.stream/outcome :dao.stream/transport-error}))]\n   350\t        attachment (.-attachment ^WsHandle handle)]\n   351\t    (when-not (:resolution? @state)\n   352\t      (swap! state assoc :resolution? true)\n   353\t      (emit! state attachment :ws/transport-error))\n   354\t    (terminal! state attachment (if (= ended-close-code code) :ws/ended :ws/closed))))\n   355\t\n   356\t\n   357\t(defn adapter\n   358\t  \"The only callback-shaped value, for a host socket adapter while wiring its\n   359\t   private listener.  It is not a DaoStream API and never reaches consumers.\n   360\t   `:message!` receives text frames and `:binary!` binary frames — the two\n   361\t   typed facts a host reports without inspecting content — and `:ws/codec`\n   362\t   is the connection's profile, so a host `:connect!` seam can negotiate the\n   363\t   selected subprotocol without any second channel.\"\n   364\t  [handle]\n   365\t  {:opened! #(opened! handle)\n   366\t   :disclaimed! #(disclaimed! handle)\n   367\t   :message! #(receive! handle %)\n   368\t   :binary! #(receive-binary! handle %)\n   369\t   :closed! #(closed! handle %1 %2)\n   370\t   :ws/codec (.-codec ^WsHandle handle)\n   371\t   :error! #(emit-reason! (.-state ^WsHandle handle) (.-attachment ^WsHandle handle)\n   372\t                          :ws/error :ws/socket-error)})\n   373\t\n   374\t\n   375\t(defn make-attacher\n   376\t  \"Construct the host-composed unary `attach!` entry point.\n   377\t\n   378\t   `:connect!` receives the descriptor and the private adapter map, starts\n   379\t   connection establishment, and synchronously returns a raw-socket adapter\n   380\t   containing `:send!` and `:close!`.  It must not wait for the peer.\n   381\t\n   382\t   `:codec` selects the wire profile explicitly (default: Transit).  The\n   383\t   offer is exactly the selected subprotocol, so a peer that does not speak\n   384\t   it fails the handshake rather than being downgraded.\"\n   385\t  [{:keys [traffic admission connect! codec] :as config}]\n   386\t  (let [target (checked-target traffic admission)\n   387\t        codec (checked-codec codec)]\n   388\t    (when-not (fn? connect!)\n   389\t      (throw (ex-info \"WebSocket host composition requires :connect!\" {:config config})))\n   390\t    (fn attach!\n   391\t      [descriptor]\n   392\t      (if-not (descriptor? descriptor codec)\n   393\t        (outcome :dao.stream/invalid-descriptor)\n   394\t        (let [id (attachment-id)\n   395\t              [handle state] (new-handle descriptor id target :connecting nil codec)]\n   396\t          (try\n   397\t            (let [socket (connect! descriptor (adapter handle))]\n   398\t              (if (and (map? socket) (fn? (:send! socket)) (fn? (:close! socket)))\n   399\t                (do (swap! state assoc :socket socket)\n   400\t                    {:dao.stream/outcome :dao.stream/ok\n   401\t                     :dao.stream/handle handle\n   402\t                     :dao.stream/attachment id})\n   403\t                (outcome :dao.stream/transport-error)))\n   404\t            (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   405\t              (outcome :dao.stream/transport-error))))))))\n   406\t\n   407\t\n   408\t;; Server acceptance is intentionally an endpoint composition object, not a\n   409\t;; global transport directory.  Its slots are supplied and owned by the host.\n   410\t(defn make-endpoint\n   411\t  [{:keys [served control control-admission slots codecs] :as config}]\n   412\t  (let [control-target (checked-target control control-admission)\n   413\t        codecs (or codecs [transit/profile])]\n   414\t    (when-not (and (map? served) (seq slots))\n   415\t      (throw (ex-info \"WebSocket endpoint needs served paths and handoff slots\" {:config config})))\n   416\t    (when-not (and (seq codecs) (every? codec-profile? codecs))\n   417\t      (throw (ex-info \"WebSocket endpoint needs at least one codec profile\" {:codecs codecs})))\n   418\t    (when-not (apply distinct? (map :ws/subprotocol codecs))\n   419\t      (throw (ex-info \"WebSocket endpoint codec subprotocols must be distinct\" {:codecs codecs})))\n   420\t    (when-not (= :portable-values (:value-domain control-admission))\n   421\t      (throw (ex-info \"endpoint control medium must carry portable values\" {:admission control-admission})))\n   422\t    (doseq [[path descriptor] served]\n   423\t      ;; A served descriptor crosses under every profile the endpoint speaks,\n   424\t      ;; or the profile that cannot carry it must not be offered.\n   425\t      (when-not (and (= path (:ws/path descriptor))\n   426\t                     (every? #(descriptor? descriptor %) codecs))\n   427\t        (throw (ex-info \"invalid served descriptor\" {:path path :descriptor descriptor}))))\n   428\t    (doseq [slot slots]\n   429\t      (checked-target (:offer slot) (:offer-admission slot))\n   430\t      (checked-target (:ack slot) (:ack-admission slot))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/dao.stream.md | sed -n '720,790p' && nl -ba docs/design/dao.lease.md | sed -n '1,290p' && nl -ba docs/design/dao.lease.rationale.md | sed -n '200,270p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/dao.stream.md | sed -n '720,790p' && nl -ba docs/design/dao.lease.md | sed -n '1,290p' && nl -ba docs/design/dao.lease.rationale.md | sed -n '200,270p'\"","aggregated_output":"   720\t`gap` is impossible and is excluded for that reason.\n   721\t\n   722\tWhat it owes on the writing side depends on what it is. A complete-history\n   723\ttransport need not be writable at all — a finite immutable history is a valid\n   724\tone, and owes no writer outcome. A writable one that declares a finite capacity\n   725\treturns `full` on reaching it, without appending and without evicting: refusing\n   726\tand evicting are the two answers to the same condition, and a transport that has\n   727\tgiven up one owes the other. A writable one with no declared capacity — a\n   728\tlogically unbounded log, however it grows or spills beneath — may exclude\n   729\t`full`. Logically unbounded is not physically infinite, and the line runs\n   730\tbetween failures an operation can observe and return from and those it cannot:\n   731\tunexpected exhaustion the transport can observe and return from is\n   732\t`transport-error`, while fatal host or runtime exhaustion, from which the\n   733\toperation produces no result at all, lies outside the outcome algebra\n   734\taltogether. Neither is ever converted into the eviction of acknowledged\n   735\thistory. A transport whose every operation either completes its state\n   736\ttransition or does not return therefore has no firing condition for\n   737\t`transport-error` and excludes it like any other outcome.\n   738\t\n   739\t## Composition\n   740\t\n   741\tDaoStream defines only streams, cursors, and the operations above. Anything\n   742\tthat transforms one stream into another is an interpreter — it reads via its\n   743\town cursor and appends to an ordinary output stream — and that lives entirely\n   744\toutside this contract, needing no support from it. As in a Unix pipeline, the\n   745\tpipe is dumb; the transforming happens in the processes on either end.\n   746\t\n   747\tA forwarder between streams is a single step (not a callback loop) over the\n   748\ttransport-agnostic stream algebra. Because the stream never blocks, cadence is\n   749\towned by the composition-supplied driver that repeatedly calls the step,\n   750\tyielding execution as needed by the host runtime.\n   751\t\n   752\tFlow control (a reader pausing a sender) is an interpreter's concern. A pause\n   753\thas to be a lease and not a switch to avoid permanently stuck states. Those\n   754\tsemantics live in `dao.lease.md`, whose facts are datoms on a medium\n   755\t(`dao.space`). DaoStream provides the honest baseline: a cursor that falls\n   756\tbehind is evicted past and told so with a `gap`, and the reader holding it\n   757\tdecides what that means.\n   758\t\n   759\t## Explicitly Absent\n   760\t\n   761\tAbsent from the public surface, by derivation from the invariants:\n   762\t\n   763\t- **an ambient registry** — a namespace-global dispatch table, or registration\n   764\t  as a load-time side effect. Host dispatch is ordinary data the host owns.\n   765\t- **a `closed?` predicate** — a predicate answer is stale the moment it\n   766\t  returns; operation results are authoritative.\n   767\t- **destructive reads** — a read that removes what it observes makes one\n   768\t  reader's progress every other reader's data loss. It is coherent only while\n   769\t  exactly one observer exists; a forwarder, an indexer, or a DHT replica makes\n   770\t  it theft. Where the capability went, so no later plan reinvents it: **taking\n   771\t  is a write.** Removing a tuple from an append-only log is not a mutation but\n   772\t  an assertion that it no longer holds, which `dao.space` already expresses as\n   773\t  a retraction datom — Linda's `in` is observe-then-retract, not a stream\n   774\t  operation. And the hard part of a take was never the removal but the\n   775\t  *exclusion* of competing takers, which is a lease over datoms\n   776\t  (`dao.lease.md`), not something a stream can promise. v1's `drain-one!`\n   777\t  appeared to solve exclusion only because it ran in one process against a\n   778\t  local ring buffer.\n   779\t- **`seek`** — every valid cursor comes from the stream; anchored minting and\n   780\t  kept cursors cover repositioning.\n   781\t- **a blocking take** — no operation waits.\n   782\t- **waiter registration** — there is no readiness extension.\n   783\t- **throwing conveniences** — operational outcomes are data.\n   784\t- **a retention or completeness predicate** — retention is declared, through\n   785\t  the transport's nature and the creation specification. Asking a handle would\n   786\t  be the same defect as asking whether it is closed: the answer is\n   787\t  configuration the composition already holds, and reading it back at runtime\n   788\t  invites code that branches on what it should have been wired with.\n   789\t\n   790\t## Open Decisions\n     1\t# DaoLease\n     2\t\n     3\tStatus: proposed design target, derived from and subordinate to\n     4\t[`datom.world.md`](./datom.world.md). This document is the operative contract:\n     5\tevery sentence below is a rule. Why the design is this shape is in\n     6\t[`dao.lease.rationale.md`](./dao.lease.rationale.md), which binds nothing.\n     7\t\n     8\tA lease is a grant that lapses unless renewed. It adds no operation to any\n     9\tcontract and no key to any DaoStream result map, leaving\n    10\t[`dao.stream.md`](./dao.stream.md) unchanged by its existence.\n    11\t\n    12\t## Vocabulary\n    13\t\n    14\tFacts are plain data on ordinary streams, classified by two dispatch keys:\n    15\t`:dao.lease/status` for the negotiation, `:dao.lease/event` for evidence. A\n    16\treader switches on both. A fact carrying neither is not a lease fact and is\n    17\tignored; a fact carrying both is defective.\n    18\t\n    19\t| Fact     | `:dao.lease/status`   | Author  | Identity carried                                                | Also required                                                                               |\n    20\t|----------|-----------------------|---------|------------------------------------------------------------------|----------------------------------------------------------------------------------------------|\n    21\t| Proposal | `:dao.lease/proposed` | holder  | `:dao.lease/proposal`                                            | `:dao.lease/subject`; `:dao.lease/duration` optional, an ask                                  |\n    22\t| Grant    | `:dao.lease/accepted` | grantor | `:dao.lease/lease`, plus `:dao.lease/proposal` if answering one   | `:dao.lease/subject`, `:dao.lease/holder`, `:dao.lease/duration`; `:dao.lease/max` optional    |\n    23\t| Refusal  | `:dao.lease/rejected` | grantor | `:dao.lease/proposal`                                            | —                                                                                             |\n    24\t| Release  | `:dao.lease/released` | holder  | `:dao.lease/lease`                                               | —                                                                                             |\n    25\t| Reclaim  | `:dao.lease/lapsed`   | grantor | `:dao.lease/lease`                                               | `:dao.lease/cause` — `:silence`, `:release`, `:cap`, or `:policy`                              |\n    26\t\n    27\t| Evidence | `:dao.lease/event`  | Author  | Identity carried     | Also required           |\n    28\t|----------|---------------------|---------|----------------------|-------------------------|\n    29\t| Renewal  | `:dao.lease/renewal`| holder  | `:dao.lease/lease`   | —                       |\n    30\t| Tick     | `:dao.lease/tick`   | adapter | —                    | `:dao.lease/reading`    |\n    31\t\n    32\t**Keys.**\n    33\t\n    34\t- `:dao.lease/lease` — the lease's identity, minted by the grantor, carried by\n    35\t  every fact about it, never reused within that grantor.\n    36\t- `:dao.lease/proposal` — a proposal's identity, minted by the holder, echoed\n    37\t  by the grant or refusal answering it.\n    38\t- `:dao.lease/subject` — what is leased, in whatever plain data the domain uses.\n    39\t- `:dao.lease/holder` — the party whose renewals count, in whatever form the\n    40\t  medium's attribution takes.\n    41\t- `:dao.lease/duration` — a single-entry map from a unit keyword to a positive\n    42\t  integer magnitude. `:dao.lease/max`, `:dao.lease/reading` and a judge's\n    43\t  tolerance use the same representation; tolerance may be zero.\n    44\t- `:dao.lease/cause` — why a reclaim happened.\n    45\t\n    46\t**Units.** The unit keywords and their ratios are a composition's\n    47\tinteroperability decision, fixed once and shared by its grantor, holders and\n    48\tjudge. Comparison normalizes to the finer of two units, and is strict: an\n    49\tinterval exactly equal to its bound has not yet passed it.\n    50\t\n    51\t**Validity.** A fact is defective, and establishes nothing, when it omits a key\n    52\tits status or event requires; carries a status or event outside the tables\n    53\tabove; carries a duration, cap or reading that is not a single-entry map of a\n    54\tfixed unit to a positive integer; carries a lease id on a proposal; answers one\n    55\tproposal with both `:accepted` and `:rejected`, or repeats `:accepted`,\n    56\t`:released` or `:lapsed` for one lease; or carries a reading older than one\n    57\talready observed. A judge reading a defective fact has read no lease fact.\n    58\t\n    59\t## Authority\n    60\t\n    61\t- **Only grantor-authored facts establish terms.** A holder cannot grant itself\n    62\t  tenure. A holder fact establishes no term; a delayed holder renewal is still\n    63\t  evidence and counts as such.\n    64\t- **A renewal counts only when its attributed author is the lease's holder.**\n    65\t  A renewal from any other author is a fact about that author, and silence is\n    66\t  measured as though it had not arrived.\n    67\t- **At most one of `:accepted` or `:rejected` answers a proposal.**\n    68\t  Renegotiating is a new proposal with a new proposal identity.\n    69\t- **A proposal creates no state.** Nothing exists until `:accepted`. A grantor\n    70\t  owes no answer, and a holder's wait on an unanswered proposal is bounded by\n    71\t  nothing in this vocabulary.\n    72\t- **A grantor may grant unsolicited**, with no proposal, in which case the\n    73\t  holder is the party the grant is delivered to.\n    74\t- **A `:policy` cause may not consist of declining to count evidence\n    75\t  received.** Eligible renewals are counted whether or not another condition\n    76\t  ends the lease.\n    77\t\n    78\t## Prohibitions\n    79\t\n    80\t- A lease may not extend retention, defer eviction, or gate history, and no\n    81\t  DaoStream operation may consult a lease.\n    82\t- No timer holds a callback and no notification marks a lapse.\n    83\t- No absolute time appears in any fact.\n    84\t- A reclaim frees the resource, never the record.\n    85\t- A holder renews from its own control flow. No machinery renews on its behalf.\n    86\t\n    87\t## Time\n    88\t\n    89\tTime reaches lease code only as data; neither judge nor holder reads a host\n    90\tclock. Both read a tick stream their composition wires. Readings on one stream\n    91\tnever decrease, and a composition persisting a ledger across a restart keeps\n    92\tits readings comparable across it.\n    93\t\n    94\tA tick-stream gap makes a pass late, not wrong; a lease-fact gap is governed\n    95\tunder *Judging with incomplete evidence*.\n    96\t\n    97\t## The judge\n    98\t\n    99\tThe judge is composed **inside the boundary that possesses the resource** and\n   100\treclaims by acting on what it itself holds; one that does not possess the\n   101\tresource is outside this contract. It concludes and reclaims in one\n   102\tinterpreter, which is not the forbidden collapse: it is the possessing host\n   103\tinterpreter performing its own act.\n   104\t\n   105\t**Ledger.** The judge keeps, privately, for each live lease:\n   106\t\n   107\t- its **terms** — subject, holder, duration, cap;\n   108\t- its **tenure start**, the reading the grant was seeded at, which no renewal\n   109\t  changes;\n   110\t- its **last relevant observation**, the reading of the grant or newest\n   111\t  eligible renewal, whichever is later;\n   112\t- its **evidence state** — `known`, or `unknown` with its resumed reading;\n   113\t- its **reclaim state** — `live`, or `pending` carrying the classified cause\n   114\t  and whether the reclaim succeeded.\n   115\t\n   116\tA lease **enters** the ledger when the grantor grants it, seeded from that act,\n   117\tand **leaves** once its reclaim has succeeded and its `:lapsed` record has been\n   118\tappended with `:dao.stream/ok`. Until both, it remains.\n   119\t\n   120\tThe ledger is not rebuildable from any stream: a composition either persists it,\n   121\tas a stream its owner writes and reads, or recovers by the rule under *Restart*.\n   122\t\n   123\t### The pass\n   124\t\n   125\tA pass classifies nothing until a first tick has been observed. At each pass,\n   126\tin this order:\n   127\t\n   128\t1. **Drain every wired tick cursor** to `:dao.stream/blocked`. The newest\n   129\t   reading drained, or the newest previously observed if none were drained, is\n   130\t   **now** for the whole pass.\n   131\t2. **Drain every wired lease-fact cursor** to `:dao.stream/blocked`, stamping\n   132\t   each fact with that same *now*, and apply it: an eligible renewal advances\n   133\t   the lease's last relevant observation to *now* and returns it to `known`; a\n   134\t   valid `:released` from the holder marks it released; a `:dao.stream/gap`\n   135\t   marks every lease on that medium `unknown` with *now* as its resumed\n   136\t   reading.\n   137\t3. **Answer and grant.** Proposals drained this pass may be answered, and\n   138\t   unsolicited grants authored, both seeded and stamped with this pass's *now*.\n   139\t   A grant authored between passes is seeded with the next pass's *now*.\n   140\t4. **Classify.** A lease is due for reclaim when any of these holds, and the\n   141\t   first that holds in this order is its cause: it is already `pending`, and\n   142\t   keeps the cause it carries; a valid `:released` from its holder has been\n   143\t   observed, `:release`; its tenure start is further back than\n   144\t   `:dao.lease/max`, `:cap`; the grantor's own policy ends it, `:policy`; its\n   145\t   interval since the last relevant observation exceeds duration plus\n   146\t   tolerance, `:silence`. A lease whose evidence state is `unknown` is due for\n   147\t   `:silence` only once a full duration has passed since its resumed reading.\n   148\t5. **Reclaim** each due lease by its composition-supplied procedure, marking it\n   149\t   `pending` with its cause first. The procedure is idempotent and reports\n   150\t   whether it succeeded; a reclaim that fails or does not report leaves the\n   151\t   lease `pending` and unrecorded.\n   152\t6. **Record** `:lapsed`, carrying the cause the ledger holds, for each lease\n   153\t   whose reclaim succeeded. On `:dao.stream/ok` the lease leaves the ledger;\n   154\t   otherwise it stays `pending` and the next pass reaches it again through the\n   155\t   first clause of step 4.\n   156\t\n   157\tThe record follows the act and never precedes it. **The absence of a `:lapsed`\n   158\tfact is never evidence of tenure.**\n   159\t\n   160\tA drain that ends in `:dao.stream/end` retires that cursor for subsequent\n   161\tpasses. A drain that ends in `:dao.stream/transport-error` ends the pass before\n   162\tstep 4.\n   163\t\n   164\t### Judging with incomplete evidence\n   165\t\n   166\tAbsence is evidence only over a window the judge observed. After a\n   167\t`:dao.stream/gap`, a lease with no renewal in the retained tail is `unknown`,\n   168\tand a surviving older renewal is not inferred to be the newest. A lease\n   169\trecovered from a persisted ledger is `unknown`. Conditions other than\n   170\t`:silence` apply to an `unknown` lease unchanged.\n   171\t\n   172\t### Restart\n   173\t\n   174\tA grantor that has lost its ledger **reclaims and re-grants**: for each\n   175\tresource it still possesses it performs the reclaim first, then grants afresh.\n   176\tThe reclaim ends the prior tenure; a new grant alone does not.\n   177\t\n   178\tThis requires an inventory of possessed resources and a recoverable holder for\n   179\teach, both of which belong to the resource rather than to this vocabulary.\n   180\tA grantor with neither persists its ledger instead.\n   181\t\n   182\t## The holder\n   183\t\n   184\t- **Observe the grant before acting**, and establish that the grantor authored\n   185\t  it by the same attribution its composition supplies to the judge. A holder\n   186\t  that has not observed its grant holds nothing.\n   187\t- **Renew at less than half the duration**, measured against ticks on its own\n   188\t  tick stream. A renewal is an append returning `:dao.stream/ok`; any other\n   189\t  outcome does not advance the holder's bound.\n   190\t- **Stop acting at the bound** — the earlier of the duration since the later of\n   191\t  its last renewal and its observed grant, and the cap the grant carries —\n   192\t  whether or not anything has been heard.\n   193\t- **Release when done.** The grantor still performs the reclaim and records it.\n   194\t\n   195\tThe bound bounds attention, not access; a holder needing exclusion obtains it\n   196\tfrom the resource.\n   197\t\n   198\t## Composition duties\n   199\t\n   200\tA composition that grants leases owes all of the following.\n   201\t\n   202\t- **A judging interpreter, and a runtime driving it at a declared cadence** —\n   203\t  the maximum interval between *completed* passes.\n   204\t- **A tick stream** for the judge, and one for every holder.\n   205\t- **A tolerance** supplied to the judge, possibly zero.\n   206\t- **An attribution resolver** for the judge and for every holder observing a\n   207\t  grant — its own answer to who authored a fact, by per-author media, an\n   208\t  envelope key, or a transport's attachment identity, since DaoStream supplies\n   209\t  none. One handed no resolver, or one incompatible with its medium, is refused\n   210\t  at assembly.\n   211\t- **A reclaim procedure per subject**, idempotent, reporting success.\n   212\t- **A stream the grantor writes grants and `:lapsed` to**, and the medium each\n   213\t  recipient reads its carried facts from.\n   214\t- **Media that either retain without eviction or declare evict-oldest**,\n   215\t  refused at assembly otherwise.\n   216\t- **For durable resources, three things this vocabulary does not supply**: a\n   217\t  judge whose durability matches the resource, a rule for which incarnation may\n   218\t  reclaim, and fencing from the resource. A composition that has not settled\n   219\t  all three keeps its leases process-scoped.\n   220\t\n   221\t## Sizing\n   222\t\n   223\tStated as relations; the values belong to compositions.\n   224\t\n   225\t- The granted duration exceeds twice the holder's renewal interval.\n   226\t- The judge's tolerance covers expected flight time and the rate skew between\n   227\t  its tick stream and the holder's.\n   228\t- A medium's retention window exceeds the judge's lag — cadence plus drain time.\n   229\t- A cap below the duration is permitted, and tenure then ends at the cap.\n   230\t\n   231\t## Limits\n   232\t\n   233\t- **A false lapse is possible.** Delay errs against the holder while a renewal\n   234\t  is unobserved and for it once observed, so a late-observed renewal from a\n   235\t  dead holder buys a fresh duration, and continuity is lost when none is\n   236\t  observed before a completed pass finds the interval past duration plus\n   237\t  tolerance. Partition length alone decides neither.\n   238\t- **`:dao.lease/max` binds within one ledger lifetime.**\n   239\t- **A medium that gaps more often than one duration** never completes an\n   240\t  observation window and leaks continuously while every component reports\n   241\t  healthy; per-attachment media are the isolation.\n   242\t- **Reclamation is bounded by** duration plus tolerance plus cadence plus the\n   243\t  reclaim's own cost, given an uninterrupted observation window.\n   244\t\n   245\t## Carriage\n   246\t\n   247\tProposals, grants, refusals, releases and renewals cross a boundary as ordinary\n   248\tpayload, carried by the composition to the medium the recipient reads. Carriage\n   249\tis delivery, not a second authoring.\n   250\t\n   251\t`:lapsed` does not cross; it is the grantor's record on the grantor's stream. A\n   252\tremote holder learns of a reclaim by observing it — for a served connection, an\n   253\tordinary `:ws/closed`. No close code is assigned here; distinguishing reclaim on\n   254\tthe wire belongs to `dao.stream.ws.md`'s deferred close-code design.\n   255\t\n   256\t## Out of scope\n   257\t\n   258\t- **Delegated renewal.** A renewal is evidence about its author.\n   259\t- **Transfer of a lease between holders.**\n   260\t- **Who may be granted anything at all**, and **what is leasable** — this\n   261\t  contract gates nothing, and the domain decides.\n   200\tat the bound — are the holder's own discipline rather than anything the grantor\n   201\tenforces.\n   202\t\n   203\t**A renewal obliges the grantor to honour the time already granted**, not to\n   204\tgrant more. What the grantor retains is the right to end a lease for reasons of\n   205\tits own — shutdown, the cap, a policy change — which it does by reclaiming and\n   206\trecording the cause, never by silently declining to count evidence it received.\n   207\tThat distinction is what makes a duration mean anything; without it the\n   208\tholder's own bound would be advice about a number nobody respects.\n   209\t\n   210\t**Why a release is evidence rather than an act.** The grantor still performs\n   211\tthe reclaim on its own schedule, exactly as on a lapse. What release buys is\n   212\tpromptness: the grantor need not wait out a duration of silence whose\n   213\treason it already knows. Where release and lapse race, whichever the grantor\n   214\tacts on first terminates the lease, since both lead to the same idempotent\n   215\treclaim.\n   216\t\n   217\t**There is no `:rolled-back`.** The precedent's word is renamed rather than\n   218\tomitted, and the reason is connotation: rollback suggests undoing an\n   219\tapplication and restoring the world as if it had not happened, while a lapse\n   220\tends a tenure whose entire past remains valid and undoes nothing. `:released`\n   221\thas no patch analogue at all, because an unapplied patch costs nothing while a\n   222\tholder done early saves the grantor up to one duration of waiting.\n   223\t\n   224\t## Why attribution is a composition duty\n   225\t\n   226\tA renewal is evidence about its author, and a grant establishes terms only\n   227\tbecause the grantor authored it. Both depend on the judge being able to tell\n   228\twho wrote a fact — and **DaoStream does not supply that.** Its Concurrency\n   229\tsection contemplates multiple writers and leaves one-log-per-writer to\n   230\tinterpretation; a descriptor carries no authorization; and the attribution a\n   231\tWebSocket boundary provides is composed envelope data, not a property of the\n   232\tmedium.\n   233\t\n   234\tUnlike the obligation to judge, this one *is* refusable at assembly — but not\n   235\tby inspecting DaoStream, which declares surfaces, outcomes and retention and\n   236\tsays nothing about authorship. What can be inspected is the composition's own\n   237\tsupplied evidence, exactly as the WebSocket boundary inspects a destination's\n   238\tdeclared nature, rather than a property DaoStream was asked to have.\n   239\t\n   240\tAbsent attribution, \"only grantor-authored facts establish terms\" is\n   241\tunenforceable: any writer can append an `:accepted` naming itself and take\n   242\ttenure. This is not a theoretical corner. Of the three uses that justify this\n   243\tvocabulary, only the served connection has attribution by construction; the\n   244\tforwarder pause and the shared-work claim run over in-process media where\n   245\tnothing distinguishes writers unless a composition arranges it.\n   246\t\n   247\t## Why judging is a pass, and in that order\n   248\t\n   249\tNothing fires when a lease lapses. Anyone may reach the conclusion; only the\n   250\tpossessor's conclusion has effect. Two judges with different tolerances may\n   251\tdisagree and neither is wrong; what settles it is **possession, not truth**, and\n   252\tthat is what reclaiming without consensus means. A judge that does not possess\n   253\tthe resource would have to append the effect and observe its outcome as data,\n   254\tand then the record could not follow the act inside a single pass — a different\n   255\tdesign, not described.\n   256\t\n   257\t**Ticks supply time as data, not a wake-up.** DaoStream invokes nothing and has\n   258\tno readiness extension, so a deposited tick rouses nobody; a driver still has\n   259\tto call `next`, and that driver is where cadence comes from. The distinction\n   260\tmatters twice: it keeps the host clock out of lease code, since observation\n   261\ttime is the most recent tick observed rather than a clock call; and it adds the\n   262\tdriver's own polling lag to the bound, which is why cadence is declared between\n   263\t*completed passes* rather than between timer deposits.\n   264\t\n   265\t**Two cursors carry no ordering between them**, so the pass is specified rather\n   266\tthan left to the scheduler: a tick judged while an already-deposited renewal\n   267\tsits unread is a false lapse manufactured by scheduling. Stamping is what makes\n   268\tthe two cursors comparable at all, and it can only overstate a fact's recency —\n   269\terring toward retention, the direction the contract already chooses.\n   270\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"## Verdict\n\nThe plan is unsound as an implementation specification. Its core lease model is plausible, but it cannot support its §7 completeness claim, leaves an operative-contract contradiction unresolved, directly violates the timer prohibition, and specifies several mechanics that do not fit the cited `dao.stream` surface.\n\n1. **Blocking — §0 correction 1 / D1: the two operative contracts still contradict each other.**\n\n   `dao.stream.md:752-755` requires lease facts to be “datoms on a medium (`dao.space`)”; `dao.lease.md:14-17` specifies plain data on ordinary streams using two map dispatch keys. Datoms are plain data, so the latter does not logically repeal the former, and `dao.lease.md:8-10` explicitly says it leaves `dao.stream.md` unchanged.\n\n   The plan simply declares the stream wording stale. A subordinate implementation plan has no authority to do that. Either `dao.stream.md` must be amended, or the lease contract must explicitly supersede that sentence. Until then, building plain maps directly on `dao.stream` chooses one side of an unresolved operative contradiction.\n\n2. **Blocking — §4.4 / C5: the reference tick source violates the contract and the plan’s own invariant.**\n\n   `dao.lease.md:82` says, without qualification, “No timer holds a callback.” C5 says no lease code “holds a callback [or] installs a timer.” Yet Phase 4 builds `js/setInterval` and `async/Timer.periodic` inside `src/cljc/dao/lease.cljc` (`plan:378-381`). Both install timers holding callbacks.\n\n   Calling that subsection “host policy” does not move it outside the namespace or repeal the prohibition. The §7 grep is artificially scoped to exclude the knowingly violating section. A compliant reference source needs a host-driven step/deposit function, not a timer installed by `dao.lease`.\n\n3. **Blocking — D2 / Phase 2: `judge-step` is not pure as specified.**\n\n   The plan repeatedly calls it a “pure step” over immutable state (`plan:185-197,309-310`), but the same call must:\n\n   - invoke `stream/next` on mutable transport handles;\n   - invoke the resource-reclaim effect;\n   - append `:lapsed` to a writer.\n\n   The actual ring buffer uses an atom and mutating `append!` (`ringbuffer.cljc:23-33,112-132`). `forward-step` is host-neutral and explicitly state-threaded, but not pure; it calls `observe/step`, which reads and appends (`forward.cljc:107-116`). The implementation can be a single effectful interpreter step, but not the pure function the plan promises.\n\n4. **Blocking — D5 / J8: `observe/step` does not provide the claimed reclaim→record transaction.**\n\n   `observe/step` performs one source read and one writer-shaped effect. Its effect must return a valid `append!` outcome (`observe.cljc:58-105`). It has no operation for:\n\n   - iterating ledger entries;\n   - storing `pending` before reclaim;\n   - retaining the classified cause and reclaim-success bit;\n   - sequencing one arbitrary reclaim effect followed by a separate append;\n   - removing a ledger entry only after that append succeeds.\n\n   The plan says Phase 2 first reclaims in step 5 and then uses `observe/step` for step 6, while D5 calls it a “per-lease reclaim/record pair.” No source stream or cursor for such a pair is identified. A boolean-returning `(reclaim subject)` is not even a valid `append!` outcome for `observe/step`.\n\n   Record-after-act is realizable with explicit ledger state and direct append outcome handling, but not via the cited primitive in the manner specified.\n\n5. **Blocking — §7 accounting: several operative rules are neither invariant-pinned nor deferred in §6.**\n\n   The completeness claim at `plan:442-445` is false. Uncovered contract rules include:\n\n   - lease IDs are minted by the grantor and never reused; proposal IDs are minted by the holder and echoed by an answer (`dao.lease.md:34-37`);\n   - a grantor owes no proposal answer and an unanswered wait has no vocabulary bound (`69-71`);\n   - unsolicited grants are permitted and delivery identifies the holder (`72-73`);\n   - `:policy` may not be implemented by declining eligible evidence (`74-76`);\n   - no notification marks a lapse (`82`);\n   - no absolute time appears in a fact (`83`);\n   - reclaim frees the resource, never its record (`84`);\n   - persisted-ledger readings remain comparable across restart (`89-92`);\n   - a tick-stream gap makes a pass late, not wrong (`94-95`);\n   - the holder’s bound limits attention, not access (`195-196`);\n   - all three sizing relations for renewal interval, tolerance, and retention window (`225-228`);\n   - `:dao.lease/max` binds only within one ledger lifetime (`238`);\n   - repeated gaps can cause a healthy continuous leak and per-attachment media provide isolation (`239-241`);\n   - the stated reclamation bound (`242-243`);\n   - carriage is delivery, not second authoring (`247-249`);\n   - `:lapsed` remains grantor-local and a remote holder observes the resource event instead (`251-254`, apart from the close-code deferral);\n   - transfer and delegated renewal remain out of scope (`256-260`).\n\n   §6 defers persistence machinery, durable-resource prerequisites, a close-code design, finished use cases, and a generic unit table. It does not defer the rules above.\n\n6. **Should-fix — J7: the policy rule is weakened.**\n\n   J7 preserves cause ordering, but it does not preserve `dao.lease.md:74-76`: policy may end a lease, yet may not do so by refusing to count eligible evidence. An implementation could pass every listed policy test while making its policy predicate suppress renewals.\n\n   Eligibility must be applied before policy classification, and tests must prove a renewal is recorded even when `:policy` wins the same pass.\n\n7. **Should-fix — J9: incomplete-evidence semantics are incomplete.**\n\n   J9 covers gap→unknown, restart→unknown, delayed silence, and non-silence conditions. It omits:\n\n   - absence is evidence only over an observed window;\n   - a surviving older renewal is not inferred to be the newest (`dao.lease.md:166-170`);\n   - a tick-cursor gap is not a lease-evidence gap (`94-95`).\n\n   The implementation could therefore treat a tick gap like a fact gap, infer retained evidence as complete, or apply tolerance to the unknown recovery window and still satisfy the written invariant/tests.\n\n8. **Should-fix — J6/J10: draining every cursor to `blocked` is not guaranteed to terminate.**\n\n   `stream/next` is non-blocking, but a concurrently written stream may keep returning `ok`; DaoStream exposes no snapshot tail or batch boundary. `forward-step` avoids this with a batch budget (`forward.cljc:67-89,102-121`). The proposed judge has no budget and insists that one step drain every cursor to `blocked`.\n\n   Thus a continuously active tick or fact stream can prevent a pass from completing, invalidating the declared-cadence duty. The contract itself demands the drain, so the composition needs a quiescent/snapshot medium guarantee or an explicit design resolution—not an unbounded loop hidden in `judge-step`.\n\n9. **Should-fix — D4: the resolver signature cannot support all claimed attribution modes.**\n\n   D4 defines `(resolver fact) -> author`, then claims it supports per-author media identity and transport attachment identity. `stream/next` returns only value and successor cursor; attachment identity is returned at attach time, not embedded in each value. A plain fact alone cannot reveal which reader or attachment supplied it.\n\n   Attribution must be bound per cursor/medium, or receive explicit source context such as `(resolver source fact)`. The current signature only reliably supports authorship embedded in an envelope.\n\n10. **Should-fix — C2/C3: assembly compatibility is underspecified and partly uninspectable.**\n\n    DaoStream handles expose surfaces, not retention policy or authorship. `dao.stream.md:784-788` explicitly says retention is composition configuration, not a runtime handle predicate. Ringbuffer descriptors expose type and identity, not an “evict-oldest” declaration (`ringbuffer.cljc:44-50`).\n\n    `make-judge` therefore cannot reject an evict-arbitrary medium from the listed handles alone. It needs an explicit, validated medium declaration in its config. Likewise, `fn?` can establish that a resolver exists, but cannot establish semantic compatibility with a medium. The plan never defines the evidence or validation protocol.\n\n11. **Should-fix — Phase 1 tests do not prove V1–V5.**\n\n    The malformed corpus omits several required cases:\n\n    - neither dispatch key is ignored by a reader;\n    - both dispatch keys are defective;\n    - invalid or non-positive cap and reading;\n    - invalid tolerance, including permitted zero;\n    - repeat `:released` and repeat `:lapsed`;\n    - use of a unit not in the composition’s fixed table;\n    - composition-wide agreement on one unit table.\n\n    V5’s absence of ambient state is not established by example inputs. The proposed tests could pass with a validator that reads a clock, stream, or global atom.\n\n12. **Should-fix — Phase 2 leaves major J invariants untested.**\n\n    No scripted test proves:\n\n    - J1: a non-grantor `:accepted` establishes nothing;\n    - J1: a delayed eligible renewal still counts;\n    - J3: proposals create no ledger state, unanswered proposals remain unbounded, and renegotiation requires a new ID;\n    - J5: every required ledger field is present and tenure start is immutable;\n    - J6: no classification before the first tick;\n    - J6: all cursors drain before classification and every fact receives the same pass `now`;\n    - J6: authored-between-passes grants seed at the next pass’s `now`;\n    - J7: cause precedence when release, cap, policy, and silence coincide;\n    - J7: a pending lease keeps its original cause;\n    - J9: recovery from a persisted ledger begins unknown;\n    - J9: release and policy apply unchanged while unknown;\n    - J10: `end` retires only that cursor;\n    - J10: `transport-error` aborts the whole pass before classification.\n\n    Ringbuffer cannot naturally produce `transport-error`, so J10 needs a scripted fake reader, not only the stated test medium.\n\n13. **Should-fix — Phase 2’s seed-from-grant test is too weak.**\n\n    The test begins with “grant seeded at reading 0.” If it constructs or pre-seeds the ledger directly, it can pass without proving that a drained or authored grant is stamped with the current pass’s `now`. It must enter through the real grant path and assert both tenure start and last relevant observation equal that pass-wide stamp.\n\n14. **Should-fix — Phase 3 appears to invert the renewal rule.**\n\n    The contract requires renewal intervals to be strictly less than half the duration (`dao.lease.md:187-189,225`). The proposed test says `should-renew?` is true below half and false at or above half (`plan:361-362`). That permits arbitrary immediate renewal, then disables renewal once the deadline has been missed.\n\n    A schedule predicate needs a defined trigger that guarantees a successful next renewal before half-duration, and must treat equality as already violating the strict sizing relation. Merely testing whether renewal is “allowed below half” does not prove H2.\n\n15. **Should-fix — Phase 3 does not prove H1 or H4.**\n\n    “False until the grant is observed” does not test grantor attribution. There is no test that a forged/non-grantor grant establishes nothing. There is also no scripted release test proving the holder emits `:released`, stops its own activity, and does not itself reclaim or author `:lapsed`.\n\n16. **Should-fix — Phase 4 tests cover only a fraction of C1–C5.**\n\n    The constructor tests omit refusal for:\n\n    - missing runtime/cadence declaration;\n    - missing judge or holder tick stream;\n    - missing or invalid tolerance;\n    - missing holder-side resolver;\n    - missing grant/`lapsed` writer;\n    - missing recipient fact medium;\n    - incompatible resolver rather than merely absent resolver;\n    - durable mode without all three C4 prerequisites.\n\n    The end-to-end cycle also does not establish media carriage, attribution by attachment, grantor-local `:lapsed`, process scoping, or declared maximum interval between completed passes.\n\n17. **Should-fix — C4 is declared but neither built nor proved.**\n\n    §6 defers the durable mechanisms to resource owners, which is legitimate, but C4 additionally requires an unsettled composition to keep leases process-scoped. Nothing in `make-judge`, the phases, or the tests specifies or enforces that fallback. A configuration could claim durable use without fencing and still pass all proposed tests.\n\n18. **Should-fix — repeated-fact validity is stateful but Phase 1 presents it as a fact validator.**\n\n    “Both answers,” repeated `:accepted`, repeated `:released`, repeated `:lapsed`, and stale readings cannot be decided from “given a fact” alone. Phase 1 acknowledges prior reading but does not define the required history for answers and repeats. V5’s signature description and the `valid?` build item are therefore incomplete.\n\n    The plan must separate structural per-fact validity from ledger/history-dependent admissibility and state exactly where each check runs.\n\n19. **Note — the plan does not classify all reader outcomes.**\n\n    The actual reader surface also returns `gap`, `cursor-mismatch`, and `invalid-cursor`, besides `blocked`, `end`, and `transport-error` (`stream.cljc:78-85`). Gap has lease semantics, but the plan does not say what happens on cursor mismatch or invalid cursor. They should at least abort classification as defects; silently treating either as a completed drain would manufacture absence evidence.\n\n20. **Note — several tests can pass while their named invariant is false.**\n\n    Concrete examples:\n\n    - individual cause tests pass even if cause precedence is wrong;\n    - a single-gap test passes if the judge marks leases on every medium unknown;\n    - reclaim retry passes even if the cause is reclassified on retry;\n    - grant→renew→lapse passes with different timestamps per fact instead of one pass-wide `now`;\n    - an `end` result test can pass even if the cursor is retried next pass unless later calls are asserted;\n    - a transport-error result test can pass even if earlier leases were already reclaimed during the aborted pass;\n    - non-`ok` renewal testing only final expiry can pass if the holder incorrectly advances some other internal renewal timestamp;\n    - “records exactly once” on ringbuffer does not prove behavior after `full`, `closed`, `invalid-value`, or `transport-error`.\n\nVERDICT: unsound"}}
