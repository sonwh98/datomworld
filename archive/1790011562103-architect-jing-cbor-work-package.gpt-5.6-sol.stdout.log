          :nREPL {:extra-paths [\"test\"]\n                   :extra-deps {nrepl/nrepl {:mvn/version \"1.0.0\"}\n                                cider/cider-nrepl {:mvn/version \"0.58.0\"}}\n                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n           :cljs {:extra-paths [\"test\" \"src/dev\"]\n                  :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                               reagent/reagent {:mvn/version \"2.0.1\"}\n                               com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}}\n           :dev {:extra-paths [\"src/dev\"]\n                 :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                              cider/cider-nrepl {:mvn/version \"0.58.0\"}\n                              reagent/reagent {:mvn/version \"2.0.1\"}\n                              com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}\n                              ;; benchmark baseline + psset-fixtures\n                              ;; generator only; production uses\n                              ;; dao.data.btree\n                              persistent-sorted-set/persistent-sorted-set\n                              {:mvn/version \"0.3.0\"}}\n                 :jvm-opts [\"-Dconfig=config.clj\"]}\n           :cljd {:extra-paths [\"test\"]\n                  :extra-deps {tensegritics/clojuredart\n                               {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                                :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n                  :main-opts [\"-m\" \"cljd.build\"]\n                  :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :server {:extra-deps {http-kit/http-kit {:mvn/version \"2.8.0\"}}\n                    :jvm-opts [\"-Dconfig=config.clj\"]\n                    :main-opts [\"-m\" \"world.server\"]}\n           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl\"]}\n           :cljs-yin-repl\n           {:extra-paths [\"test\" \"src/dev\"]\n            :extra-deps {thheller/shadow-cljs {:mvn/version \"3.3.5\"}\n                         reagent/reagent {:mvn/version \"2.0.1\"}\n                         com.cognitect/transit-cljs {:mvn/version \"0.8.280\"}}\n            :main-opts [\"-m\" \"shadow.cljs.devtools.cli\" \"run\" \"yin.repl/-main\"]}\n           :fmt {:extra-paths [\"src/dev\"]\n                 :exec-fn tasks/fix-all}\n           :kondo {:extra-deps {clj-kondo/clj-kondo {:mvn/version \"2026.01.19\"}}\n                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n           :dbg {:extra-paths [\"test\"]\n                 :main-opts [\"-m\" \"debug-cljd\"]\n                 :cljd/opts {:kind :flutter :main datomworld.demo.main}}\n           :cljd-yin-repl\n           {:extra-deps {tensegritics/clojuredart\n                         {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                          :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n            :main-opts [\"-m\" \"yin.repl.runner\"]}\n           :cljd-yin-repl-build\n           {:extra-deps {tensegritics/clojuredart\n                         {:git/url \"https://github.com/tensegritics/ClojureDart.git\"\n                          :sha \"81b5c03a55cf52b21dc0be8ccfa4827b9889f488\"}}\n            :main-opts  [\"-m\" \"cljd.build\"]\n            :cljd/opts  {:kind       :dart\n                         :main       yin.repl\n                         :output-dir \"build/yin-repl\"\n                         :output-to  \"build/yin-repl/yin_repl.dart\"}}\n           :dep-graph {:extra-paths [\"src/dev\"]\n                       :extra-deps {org.clojure/tools.namespace {:mvn/version \"1.5.0\"}}\n                       :main-opts [\"-m\" \"dep-graph\"]}}}\n\n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yang.python-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine\nname: datomworld_cljd\ndescription: ClojureDart experiment for Datomworld\npublish_to: 'none'\nenvironment:\n  # cbor 6.5.1 (the dao.stream.cbor Dart codec) requires >=3.7.0.\n  sdk: \">=3.7.0 <4.0.0\"\n\ndependencies:\n  flutter:\n    sdk: flutter\n  flutter_gpu:\n    sdk: flutter\n  http: ^1.2.0\n  cbor: 6.5.1\n  # The :cljd NFC seam (yin.vm.debruijn's normalize-nfc). Pinned to the\n  # Unicode 16.0 release the de Bruijn projection design settled on\n  # 2026-09-21; 0.3.2 moved to Unicode 17.0.\n  unorm_dart: 0.3.1+1\n\ndev_dependencies:\n  flutter_test:\n    sdk: flutter\n  test: ^1.29.0\n\nflutter:\n  assets:\n    - assets/shaders/simple_mesh.shaderbundle\n    - assets/images/earth_land_ocean_ice_2048.jpg\n    - assets/images/moon_texture_1024.jpg\n    - assets/images/earth_land_ocean_ice_1024.jpg\n    - assets/images/moon_texture_512.jpg\n{:tasks\n {test:clj {:doc \"Run JVM tests (via clj)\"\n            :task (shell \"clojure -M:test\")}\n\n  test:cljs {:doc \"Run Node tests (via shadow-cljs with :cljs alias)\"\n             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile slice-peer test\")}\n\n  build:slice-peer\n  {:doc \"Compile the DaoStream v2 Phase 5 peer as a Dart exe\"\n   ;; Process B of the Phase 5 slice is a whole program rather than a test\n   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n   ;; It is compiled alone and first: the test build rewrites the same\n   ;; cljd-out tree, so a peer built after it would import a tree it does\n   ;; not match.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:cljd compile dao.stream.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/dao/stream/slice-peer.dart -o build/slice-peer\"))}\n\n  build:yin-repl-peer\n  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n   ;; Same ahead-of-time constraint as build:slice-peer.  The R5 cross-host\n   ;; tests spawn this one exe from the JVM and Node lanes, so `bb test`\n   ;; builds it first; a bare `bb test:clj` or `bb test:cljs` without it\n   ;; skips those tests with a printed notice rather than failing.\n   :task (do (shell \"mkdir -p build\")\n             (shell \"clojure -M:cljd compile yin.repl.slice-peer\")\n             (shell \"dart compile exe lib/cljd-out/yin/repl/slice-peer.dart -o build/yin-repl-peer\"))}\n\n  test:cljd {:doc \"Run Dart tests (via clojure -M:cljd)\"\n             :depends [build:slice-peer build:yin-repl-peer]\n             :task (shell \"clojure -M:cljd test\")}\n\n  test {:doc \"Run all tests (cross-host R5 pairs need the Dart peer, so build it first)\"\n        :depends [build:yin-repl-peer test:clj test:cljs test:cljd]}}}\n;; shadow-cljs configuration\n;; Source paths come from deps.edn (:paths plus the :cljs alias's\n;; :extra-paths); shadow ignores any :source-paths set here when :deps\n;; is used.\n{:deps {:aliases [:cljs]}\n\n :dev-http {9000 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :slice-peer {:target :node-script\n                       :main dao.stream.slice-peer/-main\n                       :output-to \"target/slice-peer.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl/-main\n                        :output-to \"target/yin-repl.js\"}}}\n./src/dev/psset_fixtures.clj:9:  content-addressed by jing/segment-key), for the fixture matrix\n./src/dev/psset_fixtures.clj:51:  jing/segment-key over the identical blob shapes kv-storage writes.\"\n./src/dev/psset_fixtures.clj:62:            k (jing/segment-key v)]\n./docs/orchestrator-log.md:88:  `rpc.cljc` control flow, `log.cljc` framing, `materialize!` semantics,\n./docs/orchestrator-log.md:115:  `:inserted`'s \"durably stored now\". The cost lands on `materialize!`'s\n./docs/orchestrator-log.md:355:  `materialize!` in the loader slot. Revision 8 proposed a new namespace\n./docs/orchestrator-log.md:536:  backend through `materialize!`/`get` as `dao.space` will. `clj -M:kondo`\n./docs/orchestrator-log.md:574:  with `materialize!` as the effect, `dao.space`'s two writer seams\n./docs/orchestrator-log.md:2935:Decisions: reviewer independence maintained throughout (Claude author → G