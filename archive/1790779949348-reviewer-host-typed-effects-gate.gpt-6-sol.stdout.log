====================================================================\n;; 2. Continuation payload construction (design section 5.2.2)\n;; =============================================================================\n\n(defn image-row\n  \"The row of offset table `images` (`[[identity offset length] ...]`,\n   yin.vm.linker.md section 7.3) whose range holds instruction `pc`; a pc\n   one past the end of the last row falls in that row.\"\nsrc/cljc/yin/vm/debruijn_register_effects.cljc:28:(defn effect-descriptor\ntest/yin/vm/debruijn_register_effects_test.cljc:75:(deftest effect-descriptor-table-test\ntest/yin/vm/debruijn_register_effects_test.cljc:108:      (testing (str \"effect-descriptor for \" (first inst))\ntest/yin/vm/debruijn_register_effects_test.cljc:109:        (is (= expected (effects/effect-descriptor inst regs)))))))\ntest/yin/vm/debruijn_register_effects_test.cljc:115:        desc (effects/effect-descriptor inst regs)]\ntest/yin/vm/debruijn_register_effects_test.cljc:493:        desc (effects/effect-descriptor put-inst regs)]\ntest/yin/vm/debruijn_register_effects_test.cljc:501:        desc (effects/effect-descriptor put-inst [])\ntest/yin/vm/debruijn/stack_effects_test.cljc:415:(deftest primitive-effect-descriptors-are-dispatched-test\n","exit_code":0,"status":"completed"}}
