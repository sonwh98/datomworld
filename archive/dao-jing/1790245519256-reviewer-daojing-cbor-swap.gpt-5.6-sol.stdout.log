t.cljc:360:    (is (not= #'jing/content-hash #'jing-cbor/content-hash))))\ntest/dao/jing/mem_test.cljc:175:            mutate content\"\ntest/dao/jing_test.cljc:499:    \"observer-state returns immutable data with one member per pool entry,\n","exit_code":0,"status":"completed"}}
