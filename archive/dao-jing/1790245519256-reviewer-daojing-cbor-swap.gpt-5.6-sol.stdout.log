          (nth k-table i)\n   140\t                                       (nth w i)))\n   141\t                         t2 (mask32 (+ (sigma0 a) (maj a b c)))\n   142\t                         new-a (mask32 (+ t1 t2))\n   143\t                         new-e (mask32 (+ d t1))]\n   144\t                     (recur (inc i) [new-a a b c new-e e f g]))\n   145\t                   (mapv (fn [orig curr] (mask32 (+ orig curr)))\n   146\t                         h\n   147\t                         [a b c d e f g h-val])))))\n   148\t           (defn- word->hex8\n   149\t             [word]\n   150\t             (let [d7 (nth hex-digits (bit-and (bit-shift-right word 28) 0xf))\n   151\t                   d6 (nth hex-digits (bit-and (bit-shift-right word 24) 0xf))\n   152\t                   d5 (nth hex-digits (bit-and (bit-shift-right word 20) 0xf))\n   153\t                   d4 (nth hex-digits (bit-and (bit-shift-right word 16) 0xf))\n   154\t                   d3 (nth hex-digits (bit-and (bit-shift-right word 12) 0xf))\n   155\t                   d2 (nth hex-digits (bit-and (bit-shift-right word 8) 0xf))\n   156\t                   d1 (nth hex-digits (bit-and (bit-shift-right word 4) 0xf))\n   157\t                   d0 (nth hex-digits (bit-and word 0xf))]\n   158\t               (str d7 d6 d5 d4 d3 d2 d1 d0)))\n   159\t           (defn- bytes->hex\n   160\t             [words]\n   161\t             (apply str (for [word words] (word->hex8 (mask32 word)))))))\n   162\t\n   163\t\n   164\t(defn sha256\n   165\t  \"SHA-256 hex digest of the UTF-8 bytes of string s. Every host digests\n   166\t   the same bytes: handing goog.crypt.Sha256 the string itself hashes\n   167\t   char codes, which diverges from the JVM and Dart on any non-ASCII\n   168\t   payload and mints host-specific addresses.\"\n   169\t  [s]\n   170\t  #?(:clj (let [digest (java.security.MessageDigest/getInstance \"SHA-256\")\n   171\t                bytes (.digest digest (.getBytes s \"UTF-8\"))]\n   172\t            (apply str (map (partial format \"%02x\") bytes)))\n   173\t     :cljs (let [hasher (new goog.crypt.Sha256)]\n   174\t             (.update hasher (crypt/stringToUtf8ByteArray s))\n   175\t             (crypt/byteArrayToHex (.digest hasher)))\n   176\t     :cljd (let [padded (pad-message (utf8-bytes s))\n   177\t                 chunks (partition 64 padded)\n   178\t                 final-h (reduce process-chunk initial-h chunks)]\n   179\t             (bytes->hex final-h))))\n   180\t\n   181\t\n   182\t(defn sha256-bytes\n   183\t  \"SHA-256 hex digest of host bytes bs (byte[] on the JVM, Uint8Array on\n   184\t   ClojureScript, Uint8List on Dart). `(sha256-bytes (canonical-bytes v))`\n   185\t   is the digest for `(content-hash v {:algorithm :sha256})`.\"\n   186\t  [bs]\n   187\t  #?(:clj (let [digest (java.security.MessageDigest/getInstance \"SHA-256\")\n   188\t                bytes (.digest digest ^bytes bs)]\n   189\t            (apply str (map (partial format \"%02x\") bytes)))\n   190\t     :cljs (let [hasher (new goog.crypt.Sha256)]\n   191\t             (.update hasher bs)\n   192\t             (crypt/byteArrayToHex (.digest hasher)))\n   193\t     :cljd (let [padded (pad-message bs)\n   194\t                 chunks (partition 64 padded)\n   195\t                 final-h (reduce process-chunk initial-h chunks)]\n   196\t             (bytes->hex final-h))))\n   197\t\n   198\t\n   199\t(def default-hash-algorithm\n   200\t  \"The default algorithm used for implicit minting (content-hash, segment-key,\n   201\t   materialize!). Never consulted when verifying an existing address.\"\n   202\t  :blake3)\n   203\t\n   204\t\n   205\t(def registry\n   206\t  \"The closed, immutable algorithm registry. Both initial entries produce\n   207\t   32-byte (64 lowercase hex character) digests.\"\n   208\t  {:blake3 {:address-id \"blake3\", :digest-bytes 32}\n   209\t   :sha256 {:address-id \"sha256\", :digest-bytes 32}})\n   210\t\n   211\t\n   212\t(def ^:private registry-by-address-id\n   213\t  (into {} (map (fn [[k v]] [(:address-id v) k])) registry))\n   214\t\n   215\t\n   216\t(def ^:private algorithm-id-pattern\n   217\t  \"Algorithm address identifiers are lowercase ASCII alphanumeric strings.\"\n   218\t  #\"[a-z0-9]+\")\n   219\t\n   220\t\n   221\t(def ^:private hex-digit-pattern\n   222\t  #\"[0-9a-f]+\")\n   223\t\n   224\t\n   225\t(defn blake3-bytes\n   226\t  \"BLAKE3 lowercase hex digest of host bytes bs (byte[] on the JVM,\n   227\t   Uint8Array on ClojureScript, Uint8List on Dart).\"\n   228\t  [bs]\n   229\t  #?(:clj (let [b (io.github.rctcwyvrn.blake3.Blake3/newInstance)]\n   230\t            (.update b ^bytes bs)\n   231\t            (.hexdigest b))\n   232\t     :cljs (noble-utils/bytesToHex (noble-blake3/blake3 bs))\n   233\t     :cljd (let [^Uint8List u8 (if (instance? Uint8List bs)\n   234\t                                 bs\n   235\t                                 (Uint8List.fromList bs))]\n   236\t             (blake3-dart/blake3Hex u8))))\n   237\t\n   238\t\n   239\t(defn blake3\n   240\t  \"BLAKE3 lowercase hex digest of the UTF-8 bytes of string s.\"\n   241\t  [s]\n   242\t  #?(:clj (let [b (io.github.rctcwyvrn.blake3.Blake3/newInstance)]\n   243\t            (.update b (.getBytes ^String s \"UTF-8\"))\n   244\t            (.hexdigest b))\n   245\t     :cljs (blake3-bytes (noble-utils/utf8ToBytes s))\n   246\t     :cljd (blake3-bytes (convert/utf8.encode s))))\n   247\t\n   248\t\n   249\t(defn digest-bytes\n   250\t  \"Digest host bytes bs with the specified algorithm keyword (:blake3, :sha256).\n   251\t   Returns lowercase hexadecimal string. Unknown algorithms throw.\"\n   252\t  [algorithm bs]\n   253\t  (case algorithm\n   254\t    :blake3 (blake3-bytes bs)\n   255\t    :sha256 (sha256-bytes bs)\n   256\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   257\t                    {:algorithm algorithm}))))\n   258\t\n   259\t\n   260\t(defn digest-string\n   261\t  \"Digest string s as UTF-8 bytes with the specified algorithm keyword.\n   262\t   Returns lowercase hexadecimal string. Unknown algorithms throw.\"\n   263\t  [algorithm s]\n   264\t  (case algorithm\n   265\t    :blake3 (blake3 s)\n   266\t    :sha256 (sha256 s)\n   267\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   268\t                    {:algorithm algorithm}))))\n   269\t\n   270\t\n   271\t(defn canonical-bytes\n   272\t  \"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\n   273\t   of v -- the exact bytes content hashing digests, so\n   274\t   `(digest-bytes algo (canonical-bytes v))` is\n   275\t   `(content-hash v {:algorithm algo})`.\n   276\t   This is the byte form Jing content travels in across a `dao.stream`\n   277\t   boundary.\"\n   278\t  [v]\n   279\t  (cbor/encode v))\n   280\t\n   281\t\n   282\t(defn content-hash\n   283\t  \"Hash the canonical-bytes of v using the specified algorithm (defaulting to\n   284\t   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\n   285\t   Arities: [v] and [v {:keys [algorithm]}].\"\n   286\t  ([v]\n   287\t   (content-hash v {:algorithm default-hash-algorithm}))\n   288\t  ([v opts]\n   289\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\n   290\t     (digest-bytes algo (canonical-bytes v)))))\n   291\t\n   292\t\n   293\t(defn segment-key\n   294\t  \"Mint the content-addressed key for an opaque payload, derived solely from\n   295\t   the payload: :segment/<algorithm-id>-<digest>.\n   296\t   The 1-arg form defaults to default-hash-algorithm (:blake3).\n   297\t   The 2-arg form accepts {:algorithm :sha256} (or any registered algorithm).\"\n   298\t  ([v]\n   299\t   (segment-key v {:algorithm default-hash-algorithm}))\n   300\t  ([v opts]\n   301\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n   302\t         reg (clojure.core/get registry algo)]\n   303\t     (when-not reg\n   304\t       (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n   305\t                       {:algorithm algo})))\n   306\t     (let [algo-id (:address-id reg)\n   307\t           digest (content-hash v {:algorithm algo})]\n   308\t       (keyword \"segment\" (str algo-id \"-\" digest))))))\n   309\t\n   310\t\n   311\t(defn parse-segment-address\n   312\t  \"The authoritative address parser: requires a `segment` namespace keyword,\n   313\t   splits the name on the first `-` into algorithm identifier and digest,\n   314\t   looks the identifier up by exact match (no prefix matching), validates\n   315\t   digest length from the registry entry and lowercase-hex text, and\n   316\t   reconstructs the canonical address to reject alternative spellings.\n   317\t   Returns {:algorithm :<algo>, :digest \\\"<hex>\\\", :canonical :segment/...}\n   318\t   or nil on any rejection (never throws).\"\n   319\t  [address]\n   320\t  (when (keyword? address)\n   321\t    (when (= \"segment\" (namespace address))\n   322\t      (let [n (name address)\n   323\t            i (str/index-of n \"-\")]\n   324\t        (when (and i (pos? i))\n   325\t          (let [algo-id (subs n 0 i)\n   326\t                digest (subs n (inc i))]\n   327\t            (when (re-matches algorithm-id-pattern algo-id)\n   328\t              (when-let [algo (clojure.core/get registry-by-address-id algo-id)]\n   329\t                (let [{:keys [digest-bytes]}\n   330\t                      (clojure.core/get registry algo)]\n   331\t                  (when (and (= (* 2 digest-bytes) (count digest))\n   332\t                             (re-matches hex-digit-pattern digest))\n   333\t                    (let [canonical (keyword \"segment\"\n   334\t                                             (str algo-id \"-\" digest))]\n   335\t                      (when (= canonical address)\n   336\t                        {:algorithm algo,\n   337\t                         :digest digest,\n   338\t                         :canonical canonical}))))))))))))\n   339\t\n   340\t\n   341\t(defn segment-address?\n   342\t  \"True when x is a valid content address in the closed registry:\n   343\t   :segment/<algorithm>-<digest-hex>.\"\n   344\t  [x]\n   345\t  (boolean (parse-segment-address x)))\n   346\t\n   347\t\n   348\t(defn segment-algorithm\n   349\t  \"The algorithm keyword (:blake3, :sha256) carried by a segment address.\n   350\t   Throws on invalid input.\"\n   351\t  [address]\n   352\t  (if-let [parsed (parse-segment-address address)]\n   353\t    (:algorithm parsed)\n   354\t    (throw (ex-info \"not a segment content address\" {:address address}))))\n   355\t\n   356\t\n   357\t(defn segment-digest\n   358\t  \"The lowercase hex digest carried by a segment address.\n   359\t   Throws on invalid input.\"\n   360\t  [address]\n   361\t  (if-let [parsed (parse-segment-address address)]\n   362\t    (:digest parsed)\n   363\t    (throw (ex-info \"not a segment content address\" {:address address}))))\n   364\t\n   365\t\n   366\t(defn segment-hash\n   367\t  \"The content hash carried by a segment address. Equivalent to segment-digest.\n   368\t   Total only over valid segment addresses; throws on invalid input.\"\n   369\t  [k]\n   370\t  (segment-digest k))\n   371\t\n   372\t\n   373\t(defn segment-matches?\n   374\t  \"Total verification predicate: true when address is a valid segment address\n   375\t   and its digest matches the hash of canonical-bytes of payload under the\n   376\t   address-carried algorithm.\n   377\t   Never throws: malformed addresses, unknown algorithms, digest mismatches,\n   378\t   and canonical-encoder refusal all return false.\"\n   379\t  [address payload]\n   380\t  (if-let [{:keys [algorithm digest]} (parse-segment-address address)]\n   381\t    (try\n   382\t      (let [bs (canonical-bytes payload)\n   383\t            actual (digest-bytes algorithm bs)]\n   384\t        (= digest actual))\n   385\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   386\t        false))\n   387\t    false))\n   388\t\n   389\t\n   390\t(defn segment-bytes\n   391\t  \"The canonical payload bytes of payload, which must hash to address\n   392\t   under the address-carried algorithm; the byte-level twin of\n   393\t   segment-matches? for a backend that stores bytes and needs them.\n   394\t   Throws on a malformed address, an unencodable payload, or a digest\n   395\t   mismatch.\"\n   396\t  [address payload]\n   397\t  (let [{:keys [algorithm digest]}\n   398\t        (or (parse-segment-address address)\n   399\t            (throw (ex-info \"not a segment content address\"\n   400\t                            {:address address})))\n   401\t        bs (canonical-bytes payload)]\n   402\t    (when-not (= digest (digest-bytes algorithm bs))\n   403\t      (throw (ex-info \"content address does not match the payload\"\n   404\t                      {:address address, :payload payload})))\n   405\t    bs))\n   406\t\n   407\t\n   408\t(defn segment-value\n   409\t  \"The value of payload bytes stored at address: verifies the bytes hash to\n   410\t   the address under its carried algorithm, then decodes exactly one\n   411\t   canonical payload. Throws on a malformed address, a digest mismatch, or\n   412\t   a non-canonical payload.\"\n   413\t  [address bs]\n   414\t  (let [{:keys [algorithm digest]}\n   415\t        (or (parse-segment-address address)\n   416\t            (throw (ex-info \"not a segment content address\"\n   417\t                            {:address address})))]\n   418\t    (when-not (= digest (digest-bytes algorithm bs))\n   419\t      (throw (ex-info \"stored bytes do not hash to their content address\"\n   420\t                      {:address address})))\n   421\t    (cbor/decode bs)))\n   422\t\n   423\t\n   424\t(defn materialize!\n   425\t  \"Content-address payload and store it through the handle's backend.\n   426\t\n   427\t   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\n   428\t   and [handle payload {:keys [algorithm]}].\n   429\t\n   430\t   The address is derived solely from the payload via segment-key, and the\n   431\t   backend effect :put-content-fn is invoked as (put-content-fn address\n   432\t   payload). The backend must answer with one of:\n   433\t\n   434\t     :inserted — the value is durably stored now;\n   435\t     :present  — an equal value is already stored under that address.\n   436\t\n   437\t   Any other answer is an invalid backend result and throws: DaoJing does\n   438\t   not accept ambiguous truthiness. The address is returned only after the\n   439\t   backend reports success.\n   440\t\n   441\t   On :present the stored value is read back through :get-content-fn and\n   442\t   verified to hash to the address with segment-matches?. Equal content is\n   443\t   idempotent and returns the same address. Content that does not hash to its\n   444\t   own address is an integrity failure and throws loudly. Nothing is ever\n   445\t   overwritten.\"\n   446\t  ([handle payload]\n   447\t   (materialize! handle payload {:algorithm default-hash-algorithm}))\n   448\t  ([handle payload opts]\n   449\t   (let [put (:put-content-fn handle)\n   450\t         get-fn (:get-content-fn handle)]\n   451\t     (when-not (fn? put)\n   452\t       (throw (ex-info \"dao.jing handle requires :put-content-fn\"\n   453\t                       {:handle handle})))\n   454\t     (when-not (fn? get-fn)\n   455\t       (throw (ex-info \"dao.jing handle requires :get-content-fn\"\n   456\t                       {:handle handle})))\n   457\t     (let [address (segment-key payload opts)\n   458\t           result (put address payload)]\n   459\t       (case result\n   460\t         :inserted address\n   461\t         :present\n   462\t         (let [stored (get-fn address content-missing)]\n   463\t           (cond\n   464\t             (identical? stored content-missing)\n   465\t             (throw\n   466\t               (ex-info\n   467\t                 \"backend reported :present but the content address is absent\"\n   468\t                 {:address address, :payload payload}))\n   469\t             ;; the read-back must hash to the address it sits at\n   470\t             (segment-matches? address stored) address\n   471\t             :else\n   472\t             (throw\n   473\t               (ex-info\n   474\t                 (str \"content collision: the stored value does not hash to \"\n   475\t                      \"its content address\")\n   476\t                 {:address address, :stored stored, :payload payload}))))\n   477\t         (throw (ex-info\n   478\t                  \"invalid backend put result\"\n   479\t                  {:result result, :address address, :payload payload})))))))\n   480\t\n   481\t\n   482\t(defn get\n   483\t  \"Retrieve the opaque value stored at a content address.\n   484\t\n   485\t   Only valid registered content addresses are valid DaoJing reads;\n   486\t   arbitrary keys and mutable roots are outside DaoJing and throw before the\n   487\t   backend is consulted. Returns not-found when the address is absent.\"\n   488\t  [handle address not-found]\n   489\t  (when-not (segment-address? address)\n   490\t    (throw (ex-info \"dao.jing reads only valid segment content addresses\"\n   491\t                    {:address address})))\n   492\t  (let [get-fn (:get-content-fn handle)]\n   493\t    (when-not (fn? get-fn)\n   494\t      (throw (ex-info \"dao.jing handle requires :get-content-fn\"\n   495\t                      {:handle handle})))\n   496\t    (get-fn address not-found)))\n   497\t\n   498\t\n   499\t(defn close!\n   500\t  \"Close the backend through its optional :close-fn. Idempotency is the\n   501\t   backend's contract: close! simply delegates, so a backend that tolerates\n   502\t   repeated closes may be closed repeatedly. Returns nil. Handles without\n   503\t   :close-fn have nothing to release.\"\n   504\t  [handle]\n   505\t  (when-let [close-fn (:close-fn handle)] (close-fn))\n   506\t  nil)\n   507\t\n   508\t\n   509\t;; =============================================================================\n   510\t;; Intake-pool observer (docs/design/dao.jing.md, The intake pool and\n   511\t;; Cursor tracking and recovery)\n   512\t;; =============================================================================\n   513\t\n   514\t(defn observer-state\n   515\t  \"Construct the observer state for an explicit intake pool.\n   516\t\n   517\t   members is a sequence of {:stream <dao.stream reader handle> :cursor\n   518\t   <opaque>} entries. The composition mints each cursor itself, from an\n   519\t   anchor of its choosing, and hands it in; DaoJing never fabricates one.\n   520\t   Returns plain data, no atoms or registration:\n","exit_code":0,"status":"completed"}}
