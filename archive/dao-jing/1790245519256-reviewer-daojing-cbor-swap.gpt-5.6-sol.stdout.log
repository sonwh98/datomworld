ymbol x d]\n  1064\t  (deep! (+ d 3) :unsupported-value)\n  1065\t  (wire/frame tag-symbol\n  1066\t              (wire/array-node [(if-some [ns (namespace x)]\n  1067\t                                  (wire/text (check-text ns))\n  1068\t                                  (wire/null))\n  1069\t                                (wire/text (check-text (name x)))])))\n  1070\t\n  1071\t\n  1072\t(defn- list-wire\n  1073\t  \"Tag 27 at depth d over [\\\"dao.jing/list\\\" items]: items at d+3.\"\n  1074\t  [x d]\n  1075\t  (deep! (+ d 2) :unsupported-value)\n  1076\t  (wire/frame 'dao.jing/list (mapv #(wire-of % (+ d 3)) x)))\n  1077\t\n  1078\t\n  1079\t(defn- wire-of\n  1080\t  \"The wire tree of one value whose outermost item sits at depth d, or a\n  1081\t   refusal.\"\n  1082\t  [x d]\n  1083\t  (cond\n  1084\t    (nil? x) (do (deep! d :unsupported-value) (wire/null))\n  1085\t    (boolean? x) (do (deep! d :unsupported-value) (wire/bool x))\n  1086\t    (string? x) (do (deep! d :unsupported-value) (wire/text (check-text x)))\n  1087\t    ;; Keywords cannot carry metadata on any host (not IObj / IWithMeta;\n  1088\t    ;; pinned by a test), so there is none to wrap.\n  1089\t    (keyword? x) (identifier-wire 'dao.jing/keyword x d)\n  1090\t    (symbol? x) (meta-wire x d #(identifier-wire 'dao.jing/symbol x %))\n  1091\t    (wire/byte-payload? x) (do (deep! d :unsupported-value)\n  1092\t                               (wire/byte-string (copy-range x 0 (blen x))))\n  1093\t    (numeric? x) (number-wire x d)\n  1094\t    (record? x) (refuse :unsupported-value \"record\")\n  1095\t    (map? x) (meta-wire x d #(map-wire x %))\n  1096\t    (vector? x) (meta-wire x d (fn [d]\n  1097\t                                 (deep! d :unsupported-value)\n  1098\t                                 (wire/array-node (mapv #(wire-of % (inc d)) x))))\n  1099\t    (set? x) (meta-wire x d #(set-wire x %))\n  1100\t    (or (list? x) (seq? x)) (meta-wire x d #(list-wire x %))\n  1101\t    :else (refuse :unsupported-value (type-name x))))\n  1102\t\n  1103\t\n  1104\t(defn encode\n  1105\t  \"The canonical CBOR payload bytes of one supported value (byte[] on the\n  1106\t   JVM, Uint8Array on JavaScript, Uint8List on Dart). Refuses unsupported values, unpaired\n  1107\t   surrogates, nesting deeper than max-depth, and collections whose\n  1108\t   members collide after normalization.\"\n  1109\t  [value]\n  1110\t  (wire/encode (wire-of value 1)))\n  1111\t\n  1112\t\n  1113\t(defn byte-payload?\n  1114\t  \"True for the host byte array `encode` returns and `decode` accepts:\n  1115\t   byte[] on the JVM, Uint8Array on JavaScript, Uint8List on Dart.\"\n  1116\t  [x]\n  1117\t  (wire/byte-payload? x))\n  1118\t\n  1119\t\n  1120\t(defn encoded-compare\n  1121\t  \"Order two supported values by their canonical encodings: the shorter\n  1122\t   encoding first, then unsigned bytewise (the order this profile already\n  1123\t   uses for map keys and set elements). Returns -1, 0 or 1. It encodes both\n  1124\t   values, so callers reserve it for the rare case that needs it (the\n  1125\t   min/max tie-break after numeric order has already tied).\"\n  1126\t  [a b]\n  1127\t  (let [ea (encode a)\n  1128\t        eb (encode b)\n  1129\t        la (blen ea)\n  1130\t        lb (blen eb)]\n  1131\t    (cond\n  1132\t      (< la lb) -1\n  1133\t      (> la lb) 1\n  1134\t      :else (let [c (compare (bytes-hex ea) (bytes-hex eb))]\n  1135\t              (cond (neg? c) -1 (pos? c) 1 :else 0)))))\n  1136\t\n  1137\t\n  1138\t;; ==========================================================================\n  1139\t;; Decode, part 1: a generic structural reader (RFC 8949 data items)\n  1140\t;; ==========================================================================\n  1141\t\n  1142\t(defn- need\n  1143\t  [bs pos n]\n  1144\t  (when (> (+ pos n) (blen bs))\n  1145\t    (refuse :malformed-cbor (str \"truncated at byte \" pos))))\n  1146\t\n  1147\t\n  1148\t(def ^:private max-length (big 9007199254740991))\n  1149\t\n  1150\t\n  1151\t(defn- read-head\n  1152\t  \"[major additional-info argument next-pos]; argument is a host number,\n  1153\t   a host big integer for eight-byte arguments, or nil for indefinite.\"\n  1154\t  [bs pos]\n  1155\t  (need bs pos 1)\n  1156\t  (let [ib (byte-at bs pos)\n  1157\t        major (bit-shift-right ib 5)\n  1158\t        ai (bit-and ib 31)\n  1159\t        pos (inc pos)]\n  1160\t    (cond\n  1161\t      (< ai 24) [major ai ai pos]\n  1162\t      (<= ai 26) (let [size (case ai 24 1 25 2 26 4)]\n  1163\t                   (need bs pos size)\n  1164\t                   [major ai\n  1165\t                    (reduce (fn [acc i] (+ (* acc 256) (byte-at bs (+ pos i))))\n     1\t(ns dao.jing.file\n     2\t  \"Content-addressed segment store backed by a private framed append-only\n     3\t   file (docs/design/dao.jing.md; docs/design/dao.jing.cbor.md, Memory and\n     4\t   files; dao.jing.implementation-plan.md, Decision 2 and invariants\n     5\t   F1-F6).\n     6\t\n     7\t   Framing: each record is one frame of [4-byte big-endian signed length]\n     8\t   [CBOR array of two byte strings: the raw digest the address carries,\n     9\t   then the exact canonical payload bytes]. The length prefix is the\n    10\t   mechanism F3 needs -- it is what makes an incomplete tail detectable: a\n    11\t   tail shorter than the prefix, a negative length, or a length reaching\n    12\t   past end of file is torn. The two-element array is this backend's own\n    13\t   frame, written and parsed with Jing's shared codec (the one exception\n    14\t   docs/design/dao.jing.cbor.md names, because this is the only backend\n    15\t   that re-ingests its own output across process death). The algorithm is\n    16\t   not carried: at replay the payload is hashed under each registered\n    17\t   algorithm and the one whose digest the frame carries names the address.\n    18\t   The outer frame never contributes to a content hash; the payload bytes\n    19\t   are stored and served exactly as written, never replaced by a decoded\n    20\t   and re-encoded value.\n    21\t\n    22\t   Opening validates before it mutates: every complete frame must parse,\n    23\t   carry a digest of its payload, and hold a canonical payload, and a\n    24\t   nonempty file must yield at least one such frame, or the open fails\n    25\t   with the file untouched. Only then is an incomplete tail truncated. No\n    26\t   magic, no header: a file that is not a content log fails loudly, and\n    27\t   an interrupted first write (never acknowledged) is recreated, not\n    28\t   recovered.\n    29\t\n    30\t   The durable log is not a stream (Decision 2): one reader -- this backend,\n    31\t   once, at open -- and one writer -- its own put. No cursor is handed out,\n    32\t   no descriptor projected, nothing attaches, and no dao.stream namespace is\n    33\t   required.\n    34\t\n    35\t   The handle is plain data (D1): {:put-content-fn f :get-content-fn g\n    36\t   :close-fn c} and nothing else. records (F5) is the test's view of a path:\n    37\t   every decoded frame in order, equal duplicates included.\"\n    38\t  (:require #?@(:cljd [[\"dart:convert\" :as convert] [\"dart:io\" :as dart-io]\n    39\t                       [\"dart:typed_data\" :as typed]])\n    40\t            [clojure.string :as str]\n    41\t            [dao.jing :as jing]\n    42\t            [dao.jing.cbor :as cbor]))\n    43\t\n    44\t\n    45\t;; =============================================================================\n    46\t;; Host bytes\n    47\t;; =============================================================================\n    48\t\n    49\t(defn ->bytes\n    50\t  \"Convert a string into UTF-8 bytes on the current host.\"\n    51\t  [payload]\n    52\t  #?(:clj (.getBytes ^String payload \"UTF-8\")\n    53\t     :cljs (js/Buffer.from payload \"utf8\")\n    54\t     :cljd (typed/Uint8List.fromList (convert/utf8.encode payload))))\n    55\t\n    56\t\n    57\t(defn- byte-count\n    58\t  [bs]\n    59\t  #?(:clj (alength ^bytes bs)\n    60\t     :cljs (.-length bs)\n    61\t     :cljd (.-length ^typed/Uint8List bs)))\n    62\t\n    63\t\n    64\t(def ^:private hex-digits \"0123456789abcdef\")\n    65\t\n    66\t\n    67\t(defn- bytes->hex\n    68\t  [bs]\n    69\t  (apply str (map (fn [b]\n    70\t                    (str (nth hex-digits (quot b 16))\n    71\t                         (nth hex-digits (rem b 16))))\n    72\t                  #?(:clj (map #(bit-and (int %) 0xff) bs)\n    73\t                     :cljs (js/Array.from bs)\n    74\t                     :cljd bs))))\n    75\t\n    76\t\n    77\t(defn- hex->bytes\n    78\t  [hex]\n    79\t  (let [ints (mapv (fn [i]\n    80\t                     (+ (* 16 (str/index-of hex-digits (subs hex i (inc i))))\n    81\t                        (str/index-of hex-digits\n    82\t                                      (subs hex (inc i) (+ i 2)))))\n    83\t                   (range 0 (count hex) 2))]\n    84\t    #?(:clj (byte-array (map unchecked-byte ints))\n    85\t       :cljs (js/Uint8Array.from (clj->js ints))\n    86\t       :cljd (typed/Uint8List.fromList ints))))\n    87\t\n    88\t\n    89\t;; =============================================================================\n    90\t;; Frame codec: [digest payload-bytes] as one canonical CBOR array\n    91\t;; =============================================================================\n    92\t\n    93\t(def ^:private max-frame-length\n    94\t  \"The largest frame the signed 32-bit length prefix can describe.\"\n    95\t  2147483647)\n    96\t\n    97\t\n    98\t(defn- frame-bytes\n    99\t  \"The frame (without its length prefix) carrying payload bytes at address.\"\n   100\t  [address payload-bytes]\n   101\t  (let [frame (cbor/encode [(hex->bytes (jing/segment-digest address))\n   102\t                            payload-bytes])]\n   103\t    (when (> (byte-count frame) max-frame-length)\n   104\t      (throw (ex-info \"Frame exceeds the length prefix's positive range\"\n   105\t                      {:address address, :length (byte-count frame)})))\n   106\t    frame))\n   107\t\n   108\t\n   109\t(defn encode-record\n   110\t  \"Encode an [address payload] pair into frame bytes (the length prefix is\n   111\t   written by the frame layer). The payload must hash to the address.\"\n   112\t  [address payload]\n   113\t  (frame-bytes address (jing/segment-bytes address payload)))\n   114\t\n   115\t\n   116\t(defn- decode-frame\n   117\t  \"[address payload-bytes] of one frame: the frame must be exactly one\n   118\t   canonical two-element CBOR array of byte strings, the digest must be\n   119\t   the payload's under some registered algorithm (which then names the\n   120\t   address), and the payload must itself be a canonical Jing payload.\"\n   121\t  [frame]\n   122\t  (let [v (try (cbor/decode frame)\n   123\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   124\t                 (throw (ex-info \"Frame is not a canonical CBOR record\"\n   125\t                                 {:frame frame} e))))]\n   126\t    (when-not (and (vector? v) (= 2 (count v))\n   127\t                   (every? cbor/byte-payload? v))\n   128\t      (throw (ex-info \"Frame is not a [digest payload] array of byte strings\"\n   129\t                      {:record v})))\n   130\t    (let [[digest payload] v\n   131\t          hex (bytes->hex digest)\n   132\t          address-id\n   133\t          (some (fn [[algorithm {:keys [address-id digest-bytes]}]]\n   134\t                  (when (and (= digest-bytes (byte-count digest))\n   135\t                             (= hex (jing/digest-bytes algorithm payload)))\n   136\t                    address-id))\n   137\t                (sort-by key jing/registry))]\n   138\t      (when-not address-id\n   139\t        (throw (ex-info\n   140\t                 (str \"Frame digest is not the payload's under any \"\n   141\t                      \"registered algorithm\")\n   142\t                 {:digest hex})))\n   143\t      (try (cbor/decode payload)\n   144\t           (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   145\t             (throw (ex-info \"Frame payload is not a canonical Jing payload\"\n   146\t                             {:digest hex} e))))\n   147\t      [(keyword \"segment\" (str address-id \"-\" hex)) payload])))\n   148\t\n   149\t\n   150\t;; =============================================================================\n   151\t;; Host file primitives -- the only host-aware code below\n   152\t;; =============================================================================\n   153\t\n   154\t(def ^:private prefix-size 4)\n   155\t\n   156\t\n   157\t(defn- open-file!\n   158\t  \"Open or create the file at path for reading and appending, creating\n   159\t   parent directories. Returns the host file object.\"\n   160\t  [path]\n   161\t  #?(:clj (let [f (java.io.File. path)]\n   162\t            (when-let [parent (.getParentFile f)] (.mkdirs parent))\n   163\t            (java.io.RandomAccessFile. f \"rw\"))\n   164\t     :cljs (if-not (exists? js/require)\n   165\t             (throw (ex-info \"dao.jing.file requires the Node.js fs module.\"\n   166\t                             {:path path}))\n   167\t             (let [fs (js/require \"fs\")\n   168\t                   path-module (js/require \"path\")\n   169\t                   dir (.dirname path-module path)]\n   170\t               (when-not (.existsSync fs dir)\n   171\t                 (.mkdirSync fs dir #js {:recursive true}))\n   172\t               {:fs fs, :fd (.openSync fs path \"a+\")}))\n   173\t     :cljd (let [f (dart-io/File. path)\n   174\t                 dir (.-parent f)]\n   175\t             (when-not (.existsSync dir) (.createSync dir .recursive true))\n   176\t             (.openSync f .mode dart-io/FileMode.append))))\n   177\t\n   178\t\n   179\t(defn- file-length!\n   180\t  [f]\n   181\t  #?(:clj (.length ^java.io.RandomAccessFile f)\n   182\t     :cljs (.-size (.fstatSync ^js (:fs f) (:fd f)))\n   183\t     :cljd (.lengthSync ^dart-io/RandomAccessFile f)))\n   184\t\n   185\t\n   186\t(defn- read-int!\n   187\t  \"The 4-byte big-endian signed frame length at offset.\"\n   188\t  [f offset]\n   189\t  #?(:clj (do (.seek ^java.io.RandomAccessFile f offset)\n   190\t              (.readInt ^java.io.RandomAccessFile f))\n   191\t     :cljs (let [head (js/Buffer.alloc prefix-size)]\n   192\t             (.readSync ^js (:fs f) (:fd f) head 0 prefix-size offset)\n   193\t             (.readInt32BE head 0))\n   194\t     :cljd (do (.setPositionSync ^dart-io/RandomAccessFile f offset)\n   195\t               (let [^typed/Uint8List bs (.readSync ^dart-io/RandomAccessFile f\n   196\t                                                    prefix-size)]\n   197\t                 (.getInt32 (typed/ByteData.view (.-buffer bs)) 0)))))\n   198\t\n   199\t\n   200\t(defn- read-bytes!\n   201\t  \"The len bytes at offset as the host byte array the codec accepts.\"\n   202\t  [f offset len]\n   203\t  #?(:clj (do (.seek ^java.io.RandomAccessFile f offset)\n   204\t              (let [b (byte-array len)]\n   205\t                (.readFully ^java.io.RandomAccessFile f b)\n   206\t                b))\n   207\t     :cljs (let [buf (js/Buffer.alloc len)]\n   208\t             (.readSync ^js (:fs f) (:fd f) buf 0 len offset)\n   209\t             (js/Uint8Array. buf))\n   210\t     :cljd (do (.setPositionSync ^dart-io/RandomAccessFile f offset)\n   211\t               (.readSync ^dart-io/RandomAccessFile f len))))\n   212\t\n   213\t\n   214\t(defn- truncate-file!\n   215\t  [f offset]\n   216\t  #?(:clj (.setLength ^java.io.RandomAccessFile f offset)\n   217\t     :cljs (.ftruncateSync ^js (:fs f) (:fd f) offset)\n   218\t     :cljd (.truncateSync ^dart-io/RandomAccessFile f offset)))\n   219\t\n   220\t\n   221\t(defn- append-frame!\n   222\t  \"Write the length-prefixed frame at the current end of the file.\"\n   223\t  [f frame]\n   224\t  #?(:clj (let [raf ^java.io.RandomAccessFile f\n   225\t                len (alength ^bytes frame)]\n   226\t            (.seek raf (.length raf))\n   227\t            (.writeInt raf len)\n   228\t            (.write raf ^bytes frame))\n   229\t     :cljs (let [{:keys [fs fd]} f\n   230\t                 len (.-length ^js frame)\n   231\t                 head (js/Buffer.alloc prefix-size)]\n   232\t             (.writeInt32BE head len 0)\n   233\t             (.writeSync ^js fs fd head)\n   234\t             (.writeSync ^js fs fd frame))\n   235\t     :cljd (let [raf ^dart-io/RandomAccessFile f\n   236\t                 len (.-length ^typed/Uint8List frame)\n   237\t                 head (typed/ByteData. prefix-size)]\n   238\t             (.setInt32 head 0 len)\n   239\t             (.setPositionSync raf (.lengthSync raf))\n   240\t             (.writeFromSync raf (.asUint8List (.-buffer head)))\n   241\t             (.writeFromSync raf frame))))\n   242\t\n   243\t\n   244\t(defn- sync-file!\n   245\t  \"Flush the frame just written to durable storage (F1: a put is\n   246\t   acknowledged only after this).\"\n   247\t  [f]\n   248\t  #?(:clj (.sync (.getFD ^java.io.RandomAccessFile f))\n   249\t     :cljs (.fsyncSync ^js (:fs f) (:fd f))\n   250\t     :cljd (.flushSync ^dart-io/RandomAccessFile f)))\n   251\t\n   252\t\n   253\t(defn- close-file!\n   254\t  [f]\n   255\t  #?(:clj (.close ^java.io.RandomAccessFile f)\n   256\t     :cljs (.closeSync ^js (:fs f) (:fd f))\n   257\t     :cljd (.closeSync ^dart-io/RandomAccessFile f)))\n   258\t\n   259\t\n   260\t;; =============================================================================\n   261\t;; Validate-then-truncate replay (F3, F2, F4)\n   262\t;; =============================================================================\n   263\t\n   264\t(defn- torn-tail-offset\n   265\t  \"The offset of the first incomplete frame, scanning from 0: a tail shorter\n   266\t   than the length prefix, a negative length, or a length reaching past\n   267\t   `end` is torn. Returns `end` when every frame is complete.\"\n   268\t  [f end]\n   269\t  (loop [offset 0]\n   270\t    (cond\n   271\t      (>= offset end) end\n   272\t      (< (- end offset) prefix-size) offset\n   273\t      :else (let [len (read-int! f offset)]\n   274\t              (if (or (neg? len) (> (+ offset prefix-size len) end))\n   275\t                offset\n   276\t                (recur (+ offset prefix-size len)))))))\n   277\t\n   278\t\n   279\t(defn- recover!\n   280\t  \"Every complete frame of the file, decoded and validated in order as\n   281\t   [address payload-bytes], with the incomplete tail truncated afterwards.\n   282\t   Validation precedes mutation: a corrupt complete frame, or a nonempty\n   283\t   file with no valid first frame, throws with the file untouched.\"\n   284\t  [f]\n   285\t  (let [end (file-length! f)\n   286\t        cut (torn-tail-offset f end)\n   287\t        records (loop [offset 0, acc []]\n   288\t                  (if (>= offset cut)\n   289\t                    acc\n   290\t                    (let [len (read-int! f offset)]\n   291\t                      (recur (+ offset prefix-size len)\n   292\t                             (conj acc\n   293\t                                   (decode-frame\n   294\t                                     (read-bytes! f (+ offset prefix-size)\n   295\t                                                  len)))))))]\n   296\t    (when (and (pos? end) (empty? records))\n   297\t      (throw (ex-info \"Not a content log: no valid first frame\"\n   298\t                      {:length end})))\n   299\t    (when (< cut end) (truncate-file! f cut))\n   300\t    records))\n   301\t\n   302\t\n   303\t(defn- replay-records\n   304\t  \"Accumulate validated records into the content map. An equal duplicate\n   305\t   record is tolerated (F2), which requires comparing the incoming bytes\n   306\t   with the stored ones; the unequal arm of that comparison fails the open.\n   307\t\n   308\t   That arm is unreachable twice over: decode-frame has already enforced\n   309\t   that a frame's digest hashes its payload, so two validated frames at one\n   310\t   address carry equal bytes; and reaching it otherwise would take a hash\n   311\t   collision, which is not a case to design for. It is retained not as\n   312\t   defence but because F2's tolerate-equal rule forces the comparison, and\n   313\t   the only alternatives to throwing here are to overwrite silently or to\n   314\t   ignore silently -- both of which break `materialize!`'s promise that\n   315\t   nothing is ever overwritten.\"\n   316\t  [records]\n   317\t  (reduce (fn [content [address payload]]\n   318\t            (if (contains? content address)\n   319\t              (if (cbor/bytes= (clojure.core/get content address) payload)\n   320\t                content\n   321\t                (throw (ex-info\n   322\t                         \"Collision: address already holds a different payload\"\n   323\t                         {:address address})))\n   324\t              (assoc content address payload)))\n   325\t          {}\n   326\t          records))\n   327\t\n   328\t\n   329\t;; =============================================================================\n   330\t;; Handle functions (D1, D3, F1)\n   331\t;; =============================================================================\n   332\t\n   333\t(defn- with-lock\n   334\t  #_{:clj-kondo/ignore [:unused-binding]}\n   335\t  [lock f]\n   336\t  #?(:clj (locking lock (f))\n   337\t     :default (f)))\n   338\t\n   339\t\n   340\t(defn- make-put\n   341\t  [state f lock]\n   342\t  (fn content-put!\n   343\t    [address payload]\n   344\t    (let [bs (jing/segment-bytes address payload)\n   345\t          frame (frame-bytes address bs)]\n   346\t      (with-lock\n   347\t        lock\n   348\t        (fn []\n   349\t          (let [{:keys [closed? content]} @state]\n   350\t            (when closed?\n   351\t              (throw (ex-info \"Content file is closed\" {:address address})))\n   352\t            (if (contains? content address)\n   353\t              (if (cbor/bytes= (clojure.core/get content address) bs)\n   354\t                :present\n   355\t                (throw (ex-info\n   356\t                         \"Collision: address already holds a different payload\"\n   357\t                         {:address address})))\n   358\t              (do\n   359\t                (append-frame! f frame)\n   360\t                (sync-file! f)\n   361\t                (swap! state assoc-in [:content address] bs)\n   362\t                :inserted))))))))\n   363\t\n   364\t\n   365\t(defn- make-get\n   366\t  [state]\n   367\t  (fn content-get\n   368\t    [address not-found]\n   369\t    (let [{:keys [closed? content]} @state]\n   370\t      (when closed?\n   371\t        (throw (ex-info \"Content file is closed\" {:address address})))\n   372\t      (if (contains? content address)\n   373\t        (jing/segment-value address (clojure.core/get content address))\n   374\t        not-found))))\n   375\t\n   376\t\n   377\t(defn- make-close\n   378\t  [state f lock]\n   379\t  (fn content-close!\n   380\t    []\n   381\t    (with-lock\n   382\t      lock\n   383\t      (fn []\n   384\t        (when-not (:closed? @state)\n   385\t          (swap! state assoc :closed? true)\n   386\t          (close-file! f))\n   387\t        nil))))\n   388\t\n   389\t\n   390\t;; =============================================================================\n   391\t;; Constructor\n   392\t;; =============================================================================\n   393\t\n   394\t(defn create-content-file\n   395\t  \"Open or create a content file at path: validate every complete frame,\n   396\t   truncate any incomplete tail (F3