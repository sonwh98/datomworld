{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/jing/file_test.cljc | sed -n '1,430p' && nl -ba test/dao/jing/mem_test.cljc | sed -n '1,230p'\"","aggregated_output":"     1\t(ns dao.jing.file-test\n     2\t  \"The file backend, written from the plan's invariants F1-F6 and D1-D5\n     3\t   (docs/design/dao.jing.implementation-plan.md, P1) — not ported from the\n     4\t   v1 tests. records is the file-side view (D4/F5); the handle view is\n     5\t   materialize!/get through :put-content-fn/:get-content-fn (D1). No\n     6\t   observer or pool appears here: the pool drains in file_test are P2's.\"\n     7\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io] [\"dart:typed_data\" :as typed]])\n     8\t            [clojure.test :refer [deftest is testing]]\n     9\t            [dao.jing :as jing]\n    10\t            [dao.jing.file :as jing-file]))\n    11\t\n    12\t\n    13\t;; =============================================================================\n    14\t;; Host helpers — raw bytes into the file, per host, for torn tails and\n    15\t;; hand-written frames. These are the only host-aware lines in the suite.\n    16\t;; =============================================================================\n    17\t\n    18\t(defn- temp-path\n    19\t  [prefix]\n    20\t  (str \"target/test-jing-content-\" prefix \"-\" (random-uuid) \".log\"))\n    21\t\n    22\t\n    23\t(defn- cleanup-file\n    24\t  [path]\n    25\t  #?(:clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n    26\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))\n    27\t     :cljd (try (let [f (dart-io/File. path)]\n    28\t                  (when (.existsSync f) (.deleteSync f)))\n    29\t                (catch #?(:cljd Object\n    30\t                          :default Exception)\n    31\t                       _\n    32\t                  nil))))\n    33\t\n    34\t\n    35\t(defn- host-bytes\n    36\t  \"A host byte object from a seq of ints 0-255.\"\n    37\t  [ints]\n    38\t  #?(:clj (byte-array (mapv unchecked-byte ints))\n    39\t     :cljs (js/Buffer.from (clj->js (vec ints)))\n    40\t     :cljd (typed/Uint8List.fromList ints)))\n    41\t\n    42\t\n    43\t(defn- int32-be\n    44\t  \"The four bytes of n as a big-endian signed int32.\"\n    45\t  [n]\n    46\t  (mapv #(bit-and (bit-shift-right n %) 0xFF) [24 16 8 0]))\n    47\t\n    48\t\n    49\t(defn- byte-count\n    50\t  [bs]\n    51\t  #?(:clj (alength bs) :cljs (.-length bs) :cljd (.-length bs)))\n    52\t\n    53\t\n    54\t(defn- bytes->ints\n    55\t  [bs]\n    56\t  #?(:clj (mapv #(bit-and (int %) 0xFF) bs)\n    57\t     :cljs (vec (js/Array.from bs))\n    58\t     :cljd (vec bs)))\n    59\t\n    60\t\n    61\t(defn- frame-of\n    62\t  \"A complete frame around record bytes: the big-endian length prefix the\n    63\t   backend writes, then the bytes. encode-record produces record bytes only\n    64\t   — the prefix is the frame layer's, so a raw append must go through here\n    65\t   to produce what the scanner treats as a frame rather than a torn tail.\"\n    66\t  [record-bytes]\n    67\t  (host-bytes (concat (int32-be (byte-count record-bytes))\n    68\t                      (bytes->ints record-bytes))))\n    69\t\n    70\t\n    71\t(defn- append-raw-bytes!\n    72\t  \"Append raw host bytes at the end of the file at path, bypassing the\n    73\t   backend — the torn-tail and fail-closed cases must reach the framing\n    74\t   layer from outside it. Takes a byte object: encode-record output, or\n    75\t   (host-bytes (int32-be n)) composed with payload ints.\"\n    76\t  [path bs]\n    77\t  #?(:clj (with-open [raf (java.io.RandomAccessFile.\n    78\t                            (java.io.File. path) \"rw\")]\n    79\t            (.seek raf (.length raf))\n    80\t            (.write raf bs))\n    81\t     :cljs (let [fs (js/require \"fs\")\n    82\t                 fd (.openSync fs path \"a\")]\n    83\t             (try (.writeSync fs fd bs)\n    84\t                  (finally (.closeSync fs fd))))\n    85\t     :cljd (let [raf (.openSync (dart-io/File. path)\n    86\t                                .mode dart-io/FileMode.append)]\n    87\t             (try (.writeFromSync raf bs)\n    88\t                  (finally (.closeSync raf))))))\n    89\t\n    90\t\n    91\t;; =============================================================================\n    92\t;; F1, F2, B5, B7 — storage and retrieval\n    93\t;; =============================================================================\n    94\t\n    95\t(deftest round-trip-of-every-payload-kind\n    96\t  (testing\n    97\t    \"F1/F2/B5: materialize! derives the address, the backend stores exactly\n    98\t            the payload, and every payload kind round-trips — including nil,\n    99\t            distinct from absence, and the keyword that was once a sentinel\"\n   100\t    (let [path (temp-path \"roundtrip\")\n   101\t          ;; B7: keyword payloads, the former sentinel value among them, so\n   102\t          ;; a regression to a keyword not-found sentinel is caught here.\n   103\t          payloads [nil\n   104\t                    \"plain text\"\n   105\t                    :dao.jing/content-missing\n   106\t                    42\n   107\t                    -7\n   108\t                    true\n   109\t                    [1 2 3]\n   110\t                    {:a 1, :b {:nested [true nil \"s\"]}}\n   111\t                    #{:x :y}]\n   112\t          handle (jing-file/create-content-file path)]\n   113\t      (try\n   114\t        (doseq [payload payloads]\n   115\t          (let [address (jing/materialize! handle payload)]\n   116\t            (is (jing/segment-address? address))\n   117\t            (is (= payload (jing/get handle address ::absent))\n   118\t                (str \"round trip of \" (pr-str payload)))\n   119\t            ;; B5: a stored nil is nil, not the not-found sentinel.\n   120\t            (when (nil? payload)\n   121\t              (is (nil? (jing/get handle address ::absent))))))\n   122\t        (is (= ::absent\n   123\t               (jing/get handle (jing/segment-key {:never \"written\"})\n   124\t                         ::absent))\n   125\t            \"an absent address returns only the caller's sentinel\")\n   126\t        (finally (jing/close! handle) (cleanup-file path))))))\n   127\t\n   128\t\n   129\t(deftest put-verdicts-and-records-are-the-file\n   130\t  (testing\n   131\t    \"F1/F5: the first put is acknowledged :inserted after its flush, an\n   132\t            equal put is :present and writes no record, and records is the\n   133\t            file itself — every frame, in order\"\n   134\t    (let [path (temp-path \"verdicts\")\n   135\t          a1 (jing/segment-key \"one\")\n   136\t          a2 (jing/segment-key {:two 2})\n   137\t          handle (jing-file/create-content-file path)]\n   138\t      (try\n   139\t        (is (= :inserted ((:put-content-fn handle) a1 \"one\")))\n   140\t        (is (= :present ((:put-content-fn handle) a1 \"one\")))\n   141\t        (is (= 1 (count (jing-file/records path)))\n   142\t            \"an equal put writes no record\")\n   143\t        (is (= :inserted ((:put-content-fn handle) a2 {:two 2})))\n   144\t        (is (= [[a1 \"one\"] [a2 {:two 2}]] (jing-file/records path))\n   145\t            \"records preserves frame order, duplicates included\")\n   146\t        (finally (jing/close! handle) (cleanup-file path))))))\n   147\t\n   148\t\n   149\t(deftest invalid-put-writes-nothing\n   150\t  (testing\n   151\t    \"B6: the backend validates at its own door — a non-segment address or an\n   152\t            address that does not hash to the payload throws and stores\n   153\t            nothing\"\n   154\t    (let [path (temp-path \"invalid-put\")\n   155\t          handle (jing-file/create-content-file path)]\n   156\t      (try\n   157\t        (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   158\t              ((:put-content-fn handle) :root/not-content \"x\")))\n   159\t        (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   160\t              ((:put-content-fn handle) (jing/segment-key \"y\") \"x\")))\n   161\t        (is (= [] (jing-file/records path)) \"nothing was written\")\n   162\t        (finally (jing/close! handle) (cleanup-file path))))))\n   163\t\n   164\t\n   165\t;; =============================================================================\n   166\t;; F2, F4 — replay, duplicates, and failing the open\n   167\t;; =============================================================================\n   168\t\n   169\t(deftest durability-across-close-and-reopen\n   170\t  (testing\n   171\t    \"F2/F5: every record replays into the content map on the next open\"\n   172\t    (let [path (temp-path \"durability\")\n   173\t          a1 (jing/segment-key \"alpha\")\n   174\t          a2 (jing/segment-key {:n 2})\n   175\t          handle (jing-file/create-content-file path)]\n   176\t      (jing/materialize! handle \"alpha\")\n   177\t      (jing/materialize! handle {:n 2})\n   178\t      (jing/close! handle)\n   179\t      (let [h2 (jing-file/create-content-file path)]\n   180\t        (try (is (= \"alpha\" (jing/get h2 a1 ::absent)))\n   181\t             (is (= {:n 2} (jing/get h2 a2 ::absent)))\n   182\t             (finally (jing/close! h2) (cleanup-file path)))))))\n   183\t\n   184\t\n   185\t(deftest acknowledged-insert-survives-immediate-close\n   186\t  (testing\n   187\t    \"F1/F5: the :inserted verdict is returned only after the flush, so an\n   188\t            immediate close cannot lose the record\"\n   189\t    (let [path (temp-path \"ack\")\n   190\t          payload {:ack 1}\n   191\t          address (jing/segment-key payload)\n   192\t          handle (jing-file/create-content-file path)]\n   193\t      (jing/materialize! handle payload)\n   194\t      (jing/close! handle)\n   195\t      (let [h2 (jing-file/create-content-file path)]\n   196\t        (try (is (= payload (jing/get h2 address ::absent)))\n   197\t             (finally (jing/close! h2) (cleanup-file path)))))))\n   198\t\n   199\t\n   200\t(deftest equal-duplicate-frames-recover\n   201\t  (testing\n   202\t    \"F2: an equal duplicate record is tolerated on replay; the duplicate\n   203\t            frame is visible to records and writes nothing new\"\n   204\t    (let [path (temp-path \"dup\")\n   205\t          address (jing/segment-key {:k 1})\n   206\t          payload {:k 1}\n   207\t          handle (jing-file/create-content-file path)]\n   208\t      (jing/materialize! handle payload)\n   209\t      (jing/close! handle)\n   210\t      ;; Hand-write the identical frame again, bypassing the backend.\n   211\t      (append-raw-bytes! path (frame-of (jing-file/encode-record address payload)))\n   212\t      (is (= 2 (count (jing-file/records path)))\n   213\t          \"records sees both frames, equal duplicates included\")\n   214\t      (let [h2 (jing-file/create-content-file path)]\n   215\t        (try (is (= payload (jing/get h2 address ::absent)))\n   216\t             (is (= :present ((:put-content-fn h2) address payload)))\n   217\t             (is (= 2 (count (jing-file/records path)))\n   218\t                 \"a :present put writes no record\")\n   219\t             (finally (jing/close! h2) (cleanup-file path)))))))\n   220\t\n   221\t\n   222\t(deftest fail-closed-categories-fail-the-open\n   223\t  (testing\n   224\t    \"F4: a complete frame that cannot be decoded, is not a two-element\n   225\t            vector, carries a non-segment address, or does not hash to its\n   226\t            payload fails the open, loudly\"\n   227\t    (let [good (jing/segment-key \"ok\")]\n   228\t      (doseq [[name frame-bytes]\n   229\t              [[\"malformed EDN\" (frame-of (jing-file/->bytes \"[[[not edn\"))]\n   230\t               [\"wrong shape\"\n   231\t                (frame-of (jing-file/->bytes (pr-str [good \"ok\" :extra])))]\n   232\t               [\"invalid address\"\n   233\t                (frame-of (jing-file/->bytes (pr-str [:root/not-content \"ok\"])))]\n   234\t               [\"hash mismatch\"\n   235\t                (frame-of (jing-file/->bytes (pr-str [good \"different\"])))]]]\n   236\t        (let [path (temp-path \"corrupt\")]\n   237\t          (append-raw-bytes! path frame-bytes)\n   238\t          (try (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   239\t                     (jing-file/create-content-file path))\n   240\t                   name)\n   241\t               (finally (cleanup-file path))))))))\n   242\t\n   243\t\n   244\t(deftest unequal-duplicate-at-one-address-fails-the-open\n   245\t  (testing\n   246\t    \"F2's collision case. Two individually valid frames at one address must\n   247\t            be equal (B6: the address hashes the payload), so an unequal\n   248\t            duplicate necessarily fails the second frame's own hash check —\n   249\t            the open fails on F4's ground before the accumulation's\n   250\t            defensive collision branch, which is unreachable by\n   251\t            construction, is ever reached\"\n   252\t    (let [path (temp-path \"collision\")\n   253\t          good (jing/segment-key \"ok\")]\n   254\t      (append-raw-bytes! path (frame-of (jing-file/encode-record good \"ok\")))\n   255\t      (append-raw-bytes!\n   256\t        path (frame-of (jing-file/->bytes (pr-str [good \"other\"]))))\n   257\t      (try (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   258\t                 (jing-file/create-content-file path)))\n   259\t           (finally (cleanup-file path))))))\n   260\t\n   261\t\n   262\t;; =============================================================================\n   263\t;; F3 — torn-tail truncation, each category hand-written per host\n   264\t;; =============================================================================\n   265\t\n   266\t(defn- torn-tail-recovers\n   267\t  \"The F3 proof shape: one valid record, a torn tail of raw bytes, and the\n   268\t   open must truncate, replay the survivor, accept a clean put, and reopen\n   269\t   with both records.\"\n   270\t  [prefix torn-bytes]\n   271\t  (let [path (temp-path prefix)\n   272\t        a1 (jing/segment-key \"survivor\")\n   273\t        a2 (jing/segment-key {:after :truncation})\n   274\t        handle (jing-file/create-content-file path)]\n   275\t    (jing/materialize! handle \"survivor\")\n   276\t    (jing/close! handle)\n   277\t    (append-raw-bytes! path torn-bytes)\n   278\t    (try\n   279\t      (let [h2 (jing-file/create-content-file path)]\n   280\t        ;; close is idempotent, so the outer finally may re-close h2.\n   281\t        (try\n   282\t          (is (= [[a1 \"survivor\"]] (jing-file/records path))\n   283\t              \"the torn tail is truncated; only the survivor replays\")\n   284\t          (is (= \"survivor\" (jing/get h2 a1 ::absent)))\n   285\t          (jing/materialize! h2 {:after :truncation})\n   286\t          (jing/close! h2)\n   287\t          (let [h3 (jing-file/create-content-file path)]\n   288\t            (try\n   289\t              (is (= [[a1 \"survivor\"] [a2 {:after :truncation}]]\n   290\t                     (jing-file/records path))\n   291\t                  \"a put after truncation lands clean and survives\")\n   292\t              (is (= {:after :truncation} (jing/get h3 a2 ::absent)))\n   293\t              (finally (jing/close! h3))))\n   294\t          (finally (jing/close! h2))))\n   295\t      (finally (cleanup-file path)))))\n   296\t\n   297\t\n   298\t(deftest torn-tail-overlong-length-is-truncated\n   299\t  (testing\n   300\t    \"F3: a length reaching past end of file is torn — int32 999 with only\n   301\t            two payload bytes (hand-written, not the v1 fixture: the torn\n   302\t            bytes must follow a valid record)\"\n   303\t    (torn-tail-recovers \"torn-overlong\"\n   304\t                        (host-bytes (into (int32-be 999) [1 2])))))\n   305\t\n   306\t\n   307\t(deftest torn-tail-shorter-than-prefix-is-truncated\n   308\t  (testing \"F3: a tail shorter than the 4-byte length prefix is torn\"\n   309\t    (torn-tail-recovers \"torn-subprefix\" (host-bytes [7 7]))))\n   310\t\n   311\t\n   312\t(deftest torn-tail-negative-length-is-truncated\n   313\t  (testing \"F3: a negative frame length is torn\"\n   314\t    (torn-tail-recovers \"torn-negative\" (host-bytes (int32-be -1)))))\n   315\t\n   316\t\n   317\t;; =============================================================================\n   318\t;; D2, D3, F6 — handle lifecycle\n   319\t;; =============================================================================\n   320\t\n   321\t(deftest close-semantics\n   322\t  (testing\n   323\t    \"D2/D3/F6: close! returns nil and is idempotent; after close every\n   324\t            entry point throws; stored content is neither cleared nor\n   325\t            rewritten\"\n   326\t    (let [path (temp-path \"close\")\n   327\t          payload {:v 1}\n   328\t          address (jing/segment-key payload)\n   329\t          handle (jing-file/create-content-file path)]\n   330\t      (jing/materialize! handle payload)\n   331\t      (is (nil? (jing/close! handle)))\n   332\t      (is (nil? (jing/close! handle)) \"close is idempotent\")\n   333\t      (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   334\t            (jing/materialize! handle {:x 1})))\n   335\t      (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   336\t            (jing/get handle address ::absent)))\n   337\t      (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n   338\t            ((:put-content-fn handle) address payload)))\n   339\t      (is (= [[address payload]] (jing-file/records path))\n   340\t          \"closing does not clear or rewrite the file\")\n   341\t      (cleanup-file path))))\n   342\t\n   343\t\n   344\t(deftest contention-writes-exactly-one-record\n   345\t  (testing\n   346\t    \"D5/F6: under JVM contention, N concurrent puts of one payload yield\n   347\t            exactly one :inserted, N-1 :present, and one record\"\n   348\t    #?(:clj (let [path (temp-path \"contention\")\n   349\t                  payload {:contended true}\n   350\t                  address (jing/segment-key payload)\n   351\t                  handle (jing-file/create-content-file path)]\n   352\t              (try (let [results (mapv #(deref % 5000 ::timeout)\n   353\t                                       (doall (repeatedly\n   354\t                                                16\n   355\t                                                (fn []\n   356\t                                                  (future\n   357\t                                                    ((:put-content-fn handle)\n   358\t                                                     address payload))))))]\n   359\t                     (is (not-any? #{::timeout} results))\n   360\t                     (is (= 1 (count (filter #{:inserted} results))))\n   361\t                     (is (= 15 (count (filter #{:present} results))))\n   362\t                     (is (= [[address payload]] (jing-file/records path))))\n   363\t                   (finally (jing/close! handle) (cleanup-file path))))\n   364\t       :cljs (is true \"JVM contention is a clj-only property\")\n   365\t       :cljd (is true \"JVM contention is a clj-only property\"))))\n   366\t\n   367\t\n   368\t(deftest multi-algorithm-file-store-and-replay-test\n   369\t  (testing \"file backend stores both algorithms and replays cleanly\"\n   370\t    (let [path         (temp-path \"multi-algo\")\n   371\t          h1           (jing-file/create-content-file path)\n   372\t          p1           {:msg \"first payload\", :n 1}\n   373\t          p2           {:msg \"second payload\", :n 2}\n   374\t          addr-b3      (jing/materialize! h1 p1)\n   375\t          addr-s256    (jing/materialize! h1 p2 {:algorithm :sha256})\n   376\t          addr-p1-s256 (jing/materialize! h1 p1 {:algorithm :sha256})]\n   377\t      (is (= :blake3 (jing/segment-algorithm addr-b3)))\n   378\t      (is (= :sha256 (jing/segment-algorithm addr-s256)))\n   379\t      (is (= :sha256 (jing/segment-algorithm addr-p1-s256)))\n   380\t      (is (not= addr-b3 addr-p1-s256))\n   381\t      (is (= p1 (jing/get h1 addr-b3 ::absent)))\n   382\t      (is (= p2 (jing/get h1 addr-s256 ::absent)))\n   383\t      (is (= p1 (jing/get h1 addr-p1-s256 ::absent)))\n   384\t      (jing/close! h1)\n   385\t      (let [h2 (jing-file/create-content-file path)]\n   386\t        (try\n   387\t          (is (= p1 (jing/get h2 addr-b3 ::absent)))\n   388\t          (is (= p2 (jing/get h2 addr-s256 ::absent)))\n   389\t          (is (= p1 (jing/get h2 addr-p1-s256 ::absent)))\n   390\t          (is (= 3 (count (jing-file/records path))))\n   391\t          (finally\n   392\t            (jing/close! h2)\n   393\t            (cleanup-file path)))))))\n     1\t(ns dao.jing.mem-test\n     2\t  \"Contract tests for dao.jing.mem/create-content-mem: the ephemeral\n     3\t   content-addressed in-memory DaoJing content store\n     4\t   (docs/design/dao.jing.md, Materialization rule and Reads).\n     5\t\n     6\t   The handle is plain data carrying explicit private state plus\n     7\t   :put-content-fn, :get-content-fn, and :close-fn, and is consumed by\n     8\t   dao.jing/materialize!, dao.jing/get, and dao.jing/close!. It embeds no\n     9\t   intake stream and no source identity: addresses are derived solely from\n    10\t   payloads, equal payloads from a pool of dao.stream intake streams\n    11\t   converge on exactly one entry, and an unequal payload at an existing\n    12\t   address is an integrity failure, never an overwrite. The store's content\n    13\t   is observed through mem/entries, the backend's test-facing view — the\n    14\t   private state's shape is pinned nowhere.\"\n    15\t  (:require [clojure.test :refer [deftest is testing]]\n    16\t            [dao.jing :as jing]\n    17\t            [dao.jing.mem :as mem]\n    18\t            [dao.stream :as stream]\n    19\t            [dao.stream.ringbuffer :as ringbuffer]))\n    20\t\n    21\t\n    22\t(defn throws?\n    23\t  \"True when (f) throws on every supported host.\"\n    24\t  [f]\n    25\t  (try (f)\n    26\t       false\n    27\t       (catch #?(:clj Exception\n    28\t                 :cljs :default\n    29\t                 :cljd Object)\n    30\t              _\n    31\t         true)))\n    32\t\n    33\t\n    34\t(defn open-stream\n    35\t  \"A dao.stream ringbuffer reader handle pre-loaded with vals.\"\n    36\t  [& vals]\n    37\t  (let [{:dao.stream/keys [handle]}\n    38\t        (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    39\t                             :dao.stream.ringbuffer/capacity 8})]\n    40\t    (doseq [v vals] (stream/append! handle v))\n    41\t    handle))\n    42\t\n    43\t\n    44\t;; ---------------------------------------------------------------------------\n    45\t;; Handle shape\n    46\t;; ---------------------------------------------------------------------------\n    47\t\n    48\t(deftest create-content-mem-returns-a-stream-free-content-handle\n    49\t  (testing\n    50\t    \"the handle is plain data carrying the three backend effects\"\n    51\t    (let [h (mem/create-content-mem)]\n    52\t      (is (map? h))\n    53\t      (is (fn? (:put-content-fn h)))\n    54\t      (is (fn? (:get-content-fn h)))\n    55\t      (is (fn? (:close-fn h)))))\n    56\t  (testing \"a fresh store holds nothing and identifies no source\"\n    57\t    (let [h (mem/create-content-mem)]\n    58\t      (is (empty? (mem/entries h))\n    59\t          \"a content store starts with no entries and no provenance\"))))\n    60\t\n    61\t\n    62\t;; ---------------------------------------------------------------------------\n    63\t;; Opaque-payload contract\n    64\t;; ---------------------------------------------------------------------------\n    65\t\n    66\t(deftest materialize-mints-the-address-automatically\n    67\t  (testing\n    68\t    \"jing/materialize! derives the address from the payload alone and\n    69\t            the value round-trips unchanged\"\n    70\t    (let [h (mem/create-content-mem)\n    71\t          payload {:a 1, :b [1 2 3]}\n    72\t          address (jing/materialize! h payload)]\n    73\t      (is (= (jing/segment-key payload) address))\n    74\t      (is (= \"segment\" (namespace address)))\n    75\t      (is (= payload (jing/get h address ::missing)))\n    76\t      (is\n    77\t        (= {address payload} (mem/entries h))\n    78\t        \"exactly the payload is stored: no provenance stamp, no source identity\"))))\n    79\t\n    80\t\n    81\t(deftest opaque-payloads-round-trip-including-nil\n    82\t  (testing\n    83\t    \"any payload value is stored and retrieved unchanged; nil is a\n    84\t            legal opaque payload\"\n    85\t    (doseq [p [nil 42 \"hello\" :kw [1 2 3] {:a 1} #{:x :y} [:a [:b]]]]\n    86\t      (let [h (mem/create-content-mem)\n    87\t            address (jing/materialize! h p)]\n    88\t        (is (= (jing/segment-key p) address) (str \"address of \" (pr-str p)))\n    89\t        (is (= p (jing/get h address ::missing))\n    90\t            (str \"round trip of \" (pr-str p)))))))\n    91\t\n    92\t\n    93\t(deftest insert-is-idempotent\n    94\t  (testing\n    95\t    \"the first put reports :inserted; an equal payload reports\n    96\t            :present and is never overwritten\"\n    97\t    (let [h (mem/create-content-mem)\n    98\t          payload {:x 42}\n    99\t          address (jing/segment-key payload)]\n   100\t      (is (= :inserted ((:put-content-fn h) address payload)))\n   101\t      (is (= :present ((:put-content-fn h) address payload)))\n   102\t      (is (= payload (jing/get h address ::missing)))\n   103\t      (is (= {address payload} (mem/entries h)))))\n   104\t  (testing \"materialize! is idempotent end to end\"\n   105\t    (let [h (mem/create-content-mem)\n   106\t          payload {:x 42}]\n   107\t      (is (= (jing/materialize! h payload) (jing/materialize! h payload)))\n   108\t      (is (= 1 (count (mem/entries h)))))))\n   109\t\n   110\t\n   111\t(deftest put-rejects-invalid-content-addresses\n   112\t  (testing\n   113\t    \"only :segment/sha256-... content addresses are insertable;\n   114\t            arbitrary keys, roots, and malformed hashes throw before any\n   115\t            write\"\n   116\t    (let [h (mem/create-content-mem)]\n   117\t      (doseq [bad [:root/pointer :plain :segment/not-a-hash :segment/sha256-xyz\n   118\t                   42 \"abc\" nil [1 2] {:k :v}]]\n   119\t        (is (throws? #((:put-content-fn h) bad {:x 1}))\n   120\t            (str \"must reject \" (pr-str bad))))\n   121\t      (is (empty? (mem/entries h))))))\n   122\t\n   123\t\n   124\t(deftest put-rejects-address-payload-hash-mismatch\n   125\t  (testing\n   126\t    \"a well-formed address whose hash does not match the payload is\n   127\t            rejected before any write\"\n   128\t    (let [h (mem/create-content-mem)\n   129\t          address (jing/segment-key {:a 1})]\n   130\t      (is (throws? #((:put-content-fn h) address {:a 2})))\n   131\t      (is (empty? (mem/entries h)))))\n   132\t  (testing \"an address that does hash to the payload is accepted\"\n   133\t    (let [h (mem/create-content-mem)]\n   134\t      (is (= :inserted\n   135\t             ((:put-content-fn h) (jing/segment-key {:a 1}) {:a 1}))))))\n   136\t\n   137\t\n   138\t(deftest collision-preserves-the-existing-value\n   139\t  (testing\n   140\t    \"an unequal payload already seated at an address is never\n   141\t            overwritten and the mismatch is reported loudly\"\n   142\t    (let [h (mem/create-content-mem)\n   143\t          payload {:b 1}\n   144\t          address (jing/segment-key payload)]\n   145\t      (swap! (:state h) assoc-in [:content address]\n   146\t             (jing/canonical-bytes {:a 1}))\n   147\t      (is (throws? #((:put-content-fn h) address payload)))\n   148\t      (is (= {:a 1} (get (mem/entries h) address))\n   149\t          \"the existing value is untouched\")))\n   150\t  (testing\n   151\t    \"the collision is visible through materialize! as an integrity\n   152\t            failure\"\n   153\t    (let [h (mem/create-content-mem)\n   154\t          payload {:b 1}\n   155\t          address (jing/segment-key payload)]\n   156\t      (swap! (:state h) assoc-in [:content address]\n   157\t             (jing/canonical-bytes {:a 1}))\n   158\t      (is (throws? #(jing/materialize! h payload)))\n   159\t      (is (= {:a 1} (get (mem/entries h) address))\n   160\t          \"materialize! never overwrites\"))))\n   161\t\n   162\t\n   163\t(deftest close-is-idempotent-and-throws-after\n   164\t  (testing \"close! and :close-fn are idempotent and return nil\"\n   165\t    (let [h (mem/create-content-mem)]\n   166\t      (is (nil? (jing/close! h)))\n   167\t      (is (nil? (jing/close! h)))\n   168\t      (is (nil? ((:close-fn h))))\n   169\t      (is (throws? #((:put-content-fn h)\n   170\t                     (jing/segment-key {:probe 1})\n   171\t                     {:probe 1}))\n   172\t          \"a closed store accepts no puts\")))\n   173\t  (testing\n   174\t    \"get/put through every entry point throw after close and never\n   175\t            mutate content\"\n   176\t    (let [h (mem/create-content-mem)\n   177\t          payload {:a 1}\n   178\t          address (jing/materialize! h payload)\n   179\t          content-before (mem/entries h)]\n   180\t      (jing/close! h)\n   181\t      (is (throws? #(jing/materialize! h payload)))\n   182\t      (is (throws? #(jing/get h address ::missing)))\n   183\t      (is (throws? #((:put-content-fn h) address payload)))\n   184\t      (is (throws? #((:get-content-fn h) address ::missing)))\n   185\t      (is (= content-before (mem/entries h))\n   186\t          \"close neither clears nor rewrites stored content\"))))\n   187\t\n   188\t\n   189\t(deftest get-distinguishes-absence-from-stored-nil\n   190\t  (testing\n   191\t    \"the caller-supplied not-found is returned only for absent\n   192\t            addresses; stored nil is returned as nil, never conflated with\n   193\t            absence\"\n   194\t    (let [h (mem/create-content-mem)\n   195\t          nil-address (jing/materialize! h nil)\n   196\t          absent-address (jing/segment-key {:never 1})]\n   197\t      (is (nil? (jing/get h nil-address ::missing))\n   198\t          \"stored nil round-trips as nil\")\n   199\t      (is (= ::missing (jing/get h absent-address ::missing))\n   200\t          \"absence returns the caller-supplied not-found\")\n   201\t      (is (nil? ((:get-content-fn h) nil-address ::missing)))\n   202\t      (is (= ::missing ((:get-content-fn h) absent-address ::missing))))))\n   203\t\n   204\t\n   205\t;; ---------------------------------------------------------------------------\n   206\t;; Observer pool integration\n   207\t;; ---------------------------------------------------------------------------\n   208\t\n   209\t(deftest observer-pool-equal-payloads-converge-to-one-entry\n   210\t  (testing\n   211\t    \"equal payloads arriving through two dao.stream intake streams\n   212\t            land on exactly one stored entry carrying no source identity\"\n   213\t    (let [h (mem/create-content-mem)\n   214\t          payload {:nested {:v [1 2 3]}}\n   215\t          address (jing/segment-key payload)\n   216\t          a (open-stream payload)\n   217\t          b (open-stream payload)\n   218\t          enter (fn [s]\n   219\t                  {:stream s\n   220\t                   :cursor (:dao.stream/cursor\n   221\t                             (stream/cursor s :dao.stream/oldest))})\n   222\t          state (jing/observer-state (mapv enter [a b]))\n   223\t          r1 (jing/observe-step! h state)\n   224\t          r2 (jing/observe-step! h (:state r1))]\n   225\t      (is (= :dao.stream/ok (:signal r1)))\n   226\t      (is (= :dao.stream/ok (:signal r2)))\n   227\t      (is (= address (:address r1)))\n   228\t      (is (= address (:address r2))\n   229\t          \"both intake streams converge on the same content address\")\n   230\t      (is\n","exit_code":0,"status":"completed"}}
