    24\t   Boring 0.1.30 locks those two fields under `:canonical` and throws on a\n    25\t   conflicting override, which the tests pin.\n    26\t\n    27\t   Decoding does not go through Boring: see `dao.jing.cbor`.\n    28\t\n    29\t   ClojureDart compiles every namespace on the source path and Boring has no\n    30\t   Dart half, so every form is `:cljd nil`-gated; J2 supplies Dart.\"\n    31\t  (:require\n    32\t    #?@(:cljd []\n    33\t        :default [[boring.core :as boring]\n    34\t                  [boring.data :as boring-data]])))\n    35\t\n    36\t\n    37\t#?(:cljd nil\n    38\t   :default\n    39\t   (def opts\n    40\t     \"The one encode option map every call in this namespace uses.\"\n    41\t     {:profile :canonical :stringref false :shapes false}))\n    42\t\n    43\t\n    44\t#?(:cljd nil\n    45\t   :default\n    46\t   (defn byte-payload?\n    47\t     \"True for a host byte array: byte[] on the JVM, Uint8Array on JS.\"\n    48\t     [x]\n    49\t     #?(:clj (bytes? x)\n    50\t        :cljs (instance? js/Uint8Array x))))\n    51\t\n    52\t\n    53\t;; Scalar and container nodes. Boring writes these host values with their\n    54\t;; one CBOR meaning, so each constructor is the identity (or builds the plain\n    55\t;; host collection); `dao.jing.cbor.cljd` implements the same vocabulary as\n    56\t;; `cbor` package objects.\n    57\t\n    58\t#?(:cljd nil\n    59\t   :default\n    60\t   (defn null\n    61\t     []\n    62\t     nil))\n    63\t\n    64\t\n    65\t#?(:cljd nil\n    66\t   :default\n    67\t   (defn bool\n    68\t     [b]\n    69\t     b))\n    70\t\n    71\t\n    72\t#?(:cljd nil\n    73\t   :default\n    74\t   (defn text\n    75\t     [s]\n    76\t     s))\n    77\t\n    78\t\n    79\t#?(:cljd nil\n    80\t   :default\n    81\t   (defn byte-string\n    82\t     [bs]\n    83\t     bs))\n    84\t\n    85\t\n    86\t#?(:cljd nil\n    87\t   :default\n    88\t   (defn integer\n    89\t     \"A host integer inside [-2^6