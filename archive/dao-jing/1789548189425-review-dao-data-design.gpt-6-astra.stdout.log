at-primitive\n    50\t       [value]\n    51\t       (cond\n    52\t         (nil? value) \"nil\"\n    53\t         (boolean? value) (str value)\n    54\t         (number? value) (str value)\n    55\t         (string? value) (format-string value)\n    56\t         (keyword? value) (str value)\n    57\t         (symbol? value) (str value)\n    58\t         :else (pr-str value)))\n    59\t\n    60\t     (declare pp-str)\n    61\t\n    62\t     (defn- fits-on-line?\n    63\t       [items open close depth]\n    64\t       \"Check if items fit on one line within budget\"\n    65\t       (let [formatted (map #(pp-str % (inc depth)) items)\n    66\t             inline (str open (str/join \" \" formatted) close)\n    67\t             available-width (+ line-length-budget (* depth indent-width))]\n    68\t         (<= (count inline) available-width)))\n    69\t\n    70\t     (defn- pp-seq\n    71\t       [items depth open close]\n    72\t       \"Pretty-print a sequence with given open/close brackets\"\n    73\t       (if (empty? items)\n    74\t         (str open close)\n    75\t         (if (fits-on-line? items open close depth)\n    76\t           (str open (str/join \" \" (map #(pp-str % (inc depth)) items)) close)\n    77\t           (let [items-str (str/join (str \" \")\n    78\t                                     (map #(pp-str % (inc depth)) items))]\n    79\t             (str open \" \" items-str \" \" close)))))\n    80\t\n    81\t     (defn- pp-map\n    82\t       [m depth]\n    83\t       \"Pretty-print a map\"\n    84\t       (if (empty? m)\n    85\t         \"{}\"\n    86\t         (let [entries (map (fn [[k v]]\n    87\t                              (str (pp-str k (inc depth)) \" \" (pp-str v (inc depth))))\n    88\t                            m)\n    89\t               inline-form (str \"{\" (str/join \", \" entries) \"}\")\n    90\t               available-width (+ line-length-budget (* depth indent-width))]\n    91\t           (if (<= (count inline-form) available-width)\n    92\t             inline-form\n    93\t             (str \"{\" (first entries)\n    94\t                  (if (seq (rest entries))\n    95\t                    (str \"\\n\" (indent-str (inc depth))\n    96\t                         (str/join (str \"\\n\" (indent-str (inc depth))) (rest entries)))\n    97\t                    \"\")\n    98\t                  \"}\")))))\n    99\t\n   100\t     (defn pp-str\n   101\t       \"Pretty-print a value to a string\"\n   102\t       ([value] (pp-str value 0))\n   103\t       ([value depth]\n   104\t        (cond\n   105\t          (or (nil? value)\n   106\t              (boolean? value)\n   107\t              (number? value)\n   108\t              (keyword? value)\n   109\t              (symbol? value)\n   110\t              (string? value))\n   111\t          (format-primitive value)\n   112\t\n   113\t          (vector? value)\n   114\t          (pp-seq value depth \"[\" \"]\")\n   115\t\n   116\t          (list? value)\n   117\t          (pp-seq value depth \"(\" \")\")\n   118\t\n   119\t          (seq? value)\n   120\t          (pp-seq value depth \"(\" \")\")\n   121\t\n   122\t          (set? value)\n   123\t          (pp-seq (seq value) depth \"#{\" \"}\")\n   124\t\n   125\t          (map? value)\n   126\t          (pp-map value depth)\n   127\t\n   128\t          :else (pr-str value))))))\nsrc/cljc/dao/stream.cljc:6:       descriptor (universal reachability and identity projection)\nsrc/cljc/dao/stream.cljc:13:       attach!    (attaches to an existing stream via portable descriptor)\nsrc/cljc/dao/stream.cljc:28:  #{:create! :attach! :descriptor :cursor :next :append! :close!})\nsrc/cljc/dao/stream.cljc:62:    :dao.stream/invalid-descriptor\nsrc/cljc/dao/stream.cljc:67:(def outcomes-descriptor\nsrc/cljc/dao/stream.cljc:104:   :descriptor outcomes-descriptor\nsrc/cljc/dao/stream.cljc:115:   [:descriptor :dao.stream/ok] #{:dao.stream/descriptor :dao.stream/identity}\nsrc/cljc/dao/stream.cljc:126:  \"