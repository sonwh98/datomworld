                      (into {} (keep (fn [[name _]]\n                                                  (when-let [profile\ndiff --git a/src/cljc/yin/vm/linearize.cljc b/src/cljc/yin/vm/linearize.cljc\nindex 62cf5b53..21d74942 100644\n--- a/src/cljc/yin/vm/linearize.cljc\n+++ b/src/cljc/yin/vm/linearize.cljc\n@@ -76,28 +76,50 @@\n                   (swap! code conj\n                          {:op op, :source source, :operands operands})))]\n     (letfn\n-      [(lower-node\n+      [(definition-operator?\n+         [e]\n+         (and (= :variable (get-attr e :yin/type))\n+              (= vm/definition-operator (get-attr e :yin/name))))\n+       (lower-node\n          [e]\n          (let [type (get-attr e :yin/type)]\n            (reject-unsupported! type e)\n            (case type\n              :literal (emit! e :const :yin.code/value (get-attr e :yin/value))\n-             :variable (emit! e :var :yin.code/name (get-attr e :yin/name))\n+             :variable (let [n (get-attr e :yin/name)]\n+                         (when (vm/reserved-name? n)\n+                           (vm/refuse-reserved! :variable n {:node e}))\n+                         (emit! e :var :yin.code/name n))\n              :lambda (let [l (fresh!)]\n+                       (when-let [p (some #(when (vm/reserved-name? %) %)\n+                                          (get-attr e :yin/params))]\n+                         (vm/refuse-reserved! :binder p {:node e}))\n                        (swap! bodies conj [l e (get-attr e :yin/body)])\n                        (emit! e :closure\n                               :yin.code/params (get-attr e :yin/params)\n                               :yin.code/body l))\n-             :application (let [operands (get-attr e :yin/operands)]\n-                            (lower-node (get-attr e :yin/operator))\n-                            (emit! e :push)\n-                            (doseq [o operands]\n-                              (lower-node o)\n-                              (emit! e :push))\n-                            (emit! e :call\n-                                   :yin.code/argc (count operands)\n-                                   :yin.code/tail? (boolean\n-                                                     (get-attr e :yin/tail?))))\n+             :application\n+             (if (definition-operator? (get-attr e :yin/operator))\n+               ;; Rule R: the value operand, then `:define` with the literal\n+               ;; key; the operator is never lowered to a `:var`.\n+               (let [operands (get-attr e :yin/operands)\n+                     nodes (mapv (fn [o]\n+                                   {:type (get-attr o :yin/type),\n+                                    :value (get-attr o :yin/value)})\n+                                 operands)\n+                     n (vm/definition-name {:operands nodes})]\n+                 (lower-node (second operands))\n+                 (emit! e :define :yin.code/name n))\n+               (let [operands (get-attr e :yin/operands)]\n+                 (lower-node (get-attr e :yin/operator))\n+                 (emit! e :push)\n+                 (doseq [o operands]\n+                   (lower-node o)\n+                   (emit! e :push))\n+                 (emit! e :call\n+                        :yin.code/argc (count operands)\n+                        :yin.code/tail? (boolean\n+                                          (get-attr e :yin/tail?)))))\n              :if (let [else (fresh!)\n                        end (fresh!)]\n                    (lower-node (get-attr e :yin/test))\n@@ -127,10 +149,16 @@\n              :stream/close (do (lower-node (get-attr e :yin/source))\n                                (emit! e :stream-close))\n              :vm/gensym (emit! e :gensym :yin.code/prefix (get-attr e :yin/prefix))\n-             :vm/store-get (emit! e :store-get :yin.code/key (get-attr e :yin/key))\n-             :vm/store-put (emit! e :store-put\n-                                  :yin.code/key (get-attr e :yin/key)\n-                                  :yin.code/value (get-attr e :yin/value))\n+             :vm/store-get (let [k (get-attr e :yin/key)]\n+                             (when (vm/reserved-name? k)\n+                               (vm/refuse-reserved! :store-key k {:node e}))\n+                             (emit! e :store-get :yin.code/key k))\n+             :vm/store-put (let [k (get-attr e :yin/key)]\n+                             (when (vm/reserved-name? k)\n+                               (vm/refuse-reserved! :store-key k {:node e}))\n+                             (emit! e :store-put\n+                                    :yin.code/key k\n+                                    :yin.code/value (get-attr e :yin/value)))\n              :vm/park (emit! e :park)\n              :vm/current-continuation (emit! e :current-continuation)\n              :vm/resume (do (lower-node (get-attr e :yin/val-node))\n@@ -265,13 +293,20 @@\n              :lambda (let [l (fresh!)]\n                        (swap! bodies conj [l (nth slots 1) path])\n                        (emit! path [:closure (nth slots 0) l]))\n-             :application (let [operands (nth slots 1)]\n-                            (lower-node (nth slots 0) (conj path 2))\n-                            (emit! path [:push])\n-                            (dotimes [j (count operands)]\n-                              (lower-node (nth operands j) (conj path [3 j]))\n-                              (emit! path [:push]))\n-                            (emit! path [:call (count operands) (nth slots 2)]))\n+             :application\n+             (if (= [:variable vm/definition-operator]\n+                    (subvec (get rows (nth slots 0)) 1))\n+               ;; validated (Rule R): two operands, a literal symbol key\n+               (let [operands (nth slots 1)]\n+                 (lower-node (nth operands 1) (conj path [3 1]))\n+                 (emit! path [:define (nth (get rows (nth operands 0)) 2)]))\n+               (let [operands (nth slots 1)]\n+                 (lower-node (nth slots 0) (conj path 2))\n+                 (emit! path [:push])\n+                 (dotimes [j (count operands)]\n+                   (lower-node (nth operands j) (conj path [3 j]))\n+                   (emit! path [:push]))\n+                 (emit! path [:call (count operands) (nth slots 2)])))\n              :if (let [else (fresh!)\n                        end (fresh!)]\n                    (lower-node (nth slots 0) (conj path 2))\n@@ -410,10 +445,18 @@\n \n \n (defn ast-loader\n-  \"Adapt a code loader `(fn [vm code-datoms])` into one for a program stream\n-   carrying AST datoms: §3.1's `(comp vm-load-program lower)` for a binary\n-   loader. The composition makes this choice; no evaluator learns which form\n-   travels.\n+  \"Adapt a stamped code loader `(fn [vm code-datoms contract])` into one\n+   for a program stream carrying AST datoms: S3.1's\n+   `(comp vm-load-program lower)` for a binary loader. The composition\n+   makes this choice; no evaluator learns which form travels.\n+\n+   The returned loader is `(fn [vm datoms contract])`. `contract` is the\n+   incoming AST's own stamp, required and compared with `vm/ast-contract`\n+   before anything is lowered (`:contract-missing`, `:contract-mismatch`),\n+   so an old or unstamped image is never relabelled. Only the lowered\n+   segment, this linearizer's own fresh output from verified input, is\n+   loaded under `vm/semantic-contract`. A medium whose only producer is\n+   trusted fresh code composes `vm/fresh-code-loader` around this.\n \n    Successive batches on one medium are independent AST programs whose\n    tempids restart, so the default `:id-start` would hand two programs of\n@@ -422,26 +465,39 @@\n    already holds under `:code`; closures and continuations naming earlier\n    segments keep resolving.\"\n   [load-program]\n-  (fn [vm datoms]\n+  (fn [vm datoms contract]\n+    (vm/check-contract! vm/ast-contract contract)\n     (let [floor (reduce min\n                         (min (- datom/first-user-id) (vm/loaded-code-floor (:code vm)))\n                         (map first datoms))]\n-      (load-program vm (lower datoms {:id-start (dec floor)})))))\n+      (load-program vm\n+                    (lower datoms {:id-start (dec floor)})\n+                    vm/semantic-contract))))\n \n \n (defn rows-loader\n-  \"Adapt a vector loader (`semantic/load-vector`) into the row lane's loader\n-   for a row medium (§7.1): each observed batch is one tree's canonical row\n-   set `{:root id, :rows {id row}}`, already projected by whatever producer\n-   owns the medium — the encoder observer, for the composition that\n-   attaches the semantic VM behind one (`yin.vm.encoder`). The set is\n-   validated (§7.4), lowered to the canonical instruction vector (§5.1),\n-   and loaded; a batch of any other shape fails validation and throws.\n+  \"Adapt a stamped vector loader (`semantic/load-vector`) into the row\n+   lane's loader for a row medium (S7.1): each observed batch is one\n+   tree's canonical row set `{:root id, :rows {id row}}`, already projected\n+   by whatever producer owns the medium, the encoder observer for the\n+   composition that attaches the semantic VM behind one\n+   (`yin.vm.encoder`). The set is validated (S7.4), lowered to the\n+   canonical instruction vector (S5.1), and loaded; a batch of any other\n+   shape fails validation and throws.\n+\n+   The returned loader is `(fn [vm bc contract])`: `contract` is the row\n+   set's own AST stamp, required and compared with `vm/ast-contract` before\n+   lowering, exactly as `ast-loader` requires; only the lowered vector is\n+   loaded under `vm/semantic-contract`. A medium whose only producer is\n+   trusted fresh code composes `vm/fresh-code-loader` around this.\n \n    The composition makes this choice; no evaluator learns which form\n    travels.\"\n   [load-vector]\n-  (fn [vm bc]\n-    (load-vector vm (:vector (if (and (map? bc) (contains? bc :yin/batch))\n-                               (lower-envelope bc)\n-                               (lower-rows bc))))))\n+  (fn [vm bc contract]\n+    (vm/check-contract! vm/ast-contract contract)\n+    (load-vector vm\n+                 (:vector (if (and (map? bc) (contains? bc :yin/batch))\n+                            (lower-envelope bc)\n+                            (lower-rows bc)))\n+                 vm/semantic-contract)))\ndiff --git a/src/cljc/yin/vm/ucf.cljc b/src/cljc/yin/vm/ucf.cljc\nindex 06fe4de3..220d9a8d 100644\n--- a/src/cljc/yin/vm/ucf.cljc\n+++ b/src/cljc/yin/vm/ucf.cljc\n@@ -43,7 +43,7 @@\n    (`yin.vm.semantic.md` S2.4); `:yin.k/version` is this envelope's own\n    version. A resumer on another revision answers `:yin.k/profile-mismatch`\n    before lowering; a code index is keyed per stamp.\"\n-  {:yin.code/contract \"v2\",\n+  {:yin.code/contract vm/semantic-contract,\n    :yin.k/version 0})\n \n \n@@ -211,8 +211,15 @@\n   \"Code identity as one S7.9 outcome. On success\n    `{:yin.k/status :yin.k/ok, :yin.code/vector v, :yin.code/hash address,\n    :yin.k/contract contract-stamp}`; otherwise the `refusal` map the\n-   vector function would have thrown.\"\n-  [datoms]\n+   vector function would have thrown.\n+\n+   `contract` is the batch's own semantic stamp, required and compared\n+   with `vm/semantic-contract` first (`:contract-missing`,\n+   `:contract-mismatch`, thrown): the outcome's stamp is the one verified,\n+   never one assigned on the caller's behalf, so canonicalizing cannot\n+   relabel an old or unstamped batch.\"\n+  [datoms contract]\n+  (vm/check-contract! vm/semantic-contract contract)\n   (try\n     (let [v (batch->canonical-instruction-vector datoms)]\n       {:yin.k/status :yin.k/ok,\n@@ -250,6 +257,7 @@\n    :stream-cursor :step,\n    :stream-close :step,\n    :current-continuation :step,\n+   :define :step,\n    :jump :jump,\n    :branch-false :branch,\n    :resume :transfer,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/store_write_audit_test.clj | sed -n '1,360p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/store_write_audit_test.clj | sed -n '1,360p'\"","aggregated_output":"     1\t(ns yin.vm.store-write-audit-test\n     2\t  \"The store-write audit (Rule R, the store-key invariant): every program\n     3\t   store write goes through `yin.vm.engine/store-put`, which refuses a\n     4\t   reserved key; every other store mutation is state construction on an\n     5\t   exact allowlist. This gate reads every source file under `src` as\n     6\t   forms (tools.reader, reader conditionals preserved, so every host's\n     7\t   branch is read) and fails on any store mutation outside the allowlist,\n     8\t   on any allowlisted site that no longer exists, and on any source file\n     9\t   it cannot read.\n    10\t\n    11\t   A store mutation is a call whose head is one of `mutation-heads` and\n    12\t   that touches a store: a `:store` argument (`(assoc vm :store x)`,\n    13\t   `(update vm :store ...)`), a key path containing `:store`\n    14\t   (`(assoc-in vm [:store k] v)`), or a store as its target (a symbol named\n    15\t   `store`, `new-store`, `store0`, ..., or `(:store x)` / `(get x :store)`).\n    16\t   A map literal with a `:store` key, a map rebuilt around the store, is a\n    17\t   site too, and so is every `store-put` call. A site is identified by its\n    18\t   file, the name of its top-level form, and its head, with a count, so the\n    19\t   allowlist does not move with line numbers.\n    20\t\n    21\t   JVM only: it reads source files. The residual is a mutation that\n    22\t   touches a store only through an alias the patterns cannot see (a local\n    23\t   bound to `(:store vm)` under another name); `negative-fixtures` below\n    24\t   pins the common forms this gate must catch.\"\n    25\t  (:require [clojure.java.io :as io]\n    26\t            [clojure.test :refer [deftest is testing]]\n    27\t            [clojure.tools.reader :as reader]\n    28\t            [clojure.tools.reader.reader-types :as rt]))\n    29\t\n    30\t\n    31\t(def ^:private mutation-heads\n    32\t  #{\"assoc\" \"assoc-in\" \"update\" \"update-in\" \"merge\" \"merge-with\" \"into\"\n    33\t    \"dissoc\" \"select-keys\" \"conj\" \"swap!\" \"reset!\" \"vswap!\" \"vreset!\"\n    34\t    \"store-put\"})\n    35\t\n    36\t\n    37\t(defn- store-symbol?\n    38\t  [x]\n    39\t  (and (symbol? x)\n    40\t       (boolean (re-find #\"(^|-)store\\d*'?$\" (name x)))))\n    41\t\n    42\t\n    43\t(defn- store-read?\n    44\t  \"`(:store x)` or `(get x :store)`.\"\n    45\t  [x]\n    46\t  (and (seq? x)\n    47\t       (or (= :store (first x))\n    48\t           (and (= 'get (first x)) (= :store (nth x 2 nil))))))\n    49\t\n    50\t\n    51\t(defn- touches-store?\n    52\t  [[head & args]]\n    53\t  (or (= \"store-put\" (name head))\n    54\t      (some #(= :store %) args)\n    55\t      (some #(and (vector? %) (some #{:store} %)) args)\n    56\t      (let [target (first args)]\n    57\t        (or (store-symbol? target) (store-read? target)))))\n    58\t\n    59\t\n    60\t(defn- mutation?\n    61\t  [form]\n    62\t  (and (seq? form)\n    63\t       (symbol? (first form))\n    64\t       (contains? mutation-heads (name (first form)))\n    65\t       (touches-store? form)))\n    66\t\n    67\t\n    68\t(defn- children\n    69\t  [form]\n    70\t  (cond (reader-conditional? form) (:form form)\n    71\t        (map? form) (concat (keys form) (vals form))\n    72\t        (coll? form) (seq form)\n    73\t        :else nil))\n    74\t\n    75\t\n    76\t(defn- form-sites\n    77\t  \"`[head-string]` for every store mutation inside `form`, and `[:map]` for\n    78\t   every map literal with a `:store` key.\"\n    79\t  [form]\n    80\t  (->> (tree-seq #(some? (children %)) children form)\n    81\t       (keep (fn [f]\n    82\t               (cond (mutation? f) (str (first f))\n    83\t                     (and (map? f) (contains? f :store)) :map)))))\n    84\t\n    85\t\n    86\t(defn- top-level-name\n    87\t  [form]\n    88\t  (if (and (seq? form) (symbol? (second form)))\n    89\t    (str (second form))\n    90\t    (pr-str (if (seq? form) (first form) form))))\n    91\t\n    92\t\n    93\t(defn- alias-map\n    94\t  \"Every `:as alias` in the source, resolved to itself: enough for\n    95\t   tools.reader to read `::alias/kw` without loading the namespace.\"\n    96\t  [text]\n    97\t  (into {}\n    98\t        (map (fn [[_ a]] [(symbol a) (symbol a)]))\n    99\t        (re-seq #\":as\\s+([A-Za-z0-9.*+!_?<>=-]+)\" text)))\n   100\t\n   101\t\n   102\t(defn sites-in-source\n   103\t  \"`{[top-level-name head] count}` of the store mutations in `text`, or\n   104\t   `{[:unreadable] 1}` when the text cannot be read as forms.\"\n   105\t  [text]\n   106\t  (try\n   107\t    (binding [reader/*alias-map* (alias-map text)\n   108\t              reader/*default-data-reader-fn* (fn [_ v] v)\n   109\t              *ns* (create-ns 'yin.vm.store-write-audit-reader)]\n   110\t      (let [rdr (rt/indexing-push-back-reader text)\n   111\t            opts {:read-cond :preserve, :eof ::eof}]\n   112\t        (loop [acc {}]\n   113\t          (let [form (reader/read opts rdr)]\n   114\t            (if (= ::eof form)\n   115\t              acc\n   116\t              (recur (reduce (fn [acc head]\n   117\t                               (update acc [(top-level-name form) head]\n   118\t                                       (fnil inc 0)))\n   119\t                             acc\n   120\t                             (form-sites form))))))))\n   121\t    (catch Exception e\n   122\t      {[:unreadable (ex-message e)] 1})))\n   123\t\n   124\t\n   125\t(defn- source-files\n   126\t  []\n   127\t  (->> (file-seq (io/file \"src\"))\n   128\t       (filter #(.isFile ^java.io.File %))\n   129\t       (map #(.getPath ^java.io.File %))\n   130\t       (filter #(re-find #\"\\.clj[csd]?$\" %))\n   131\t       sort))\n   132\t\n   133\t\n   134\t(defn source-sites\n   135\t  \"file -> `{[top-level-name head] count}` for every file with a site.\"\n   136\t  []\n   137\t  (into {}\n   138\t        (keep (fn [f]\n   139\t                (let [sites (sites-in-source (slurp f))]\n   140\t                  (when (seq sites) [f sites]))))\n   141\t        (source-files)))\n   142\t\n   143\t\n   144\t(def allowlist\n   145\t  \"file -> {[top-level-name head] count}, with the reason each may write.\"\n   146\t  {\"src/cljc/yin/vm/engine.cljc\"\n   147\t   {;; the one program write, and the :vm/store-put effect dispatcher\n   148\t    [\"store-put\" \"assoc\"] 1\n   149\t    [\"handle-effect\" \"store-put\"] 1\n   150\t    [\"handle-effect\" \"assoc\"] 1\n   151\t    ;; engine-minted keyword keys: stream ids, cursor ids, cursor advance\n   152\t    [\"handle-make\" \"assoc\"] 2\n   153\t    [\"handle-cursor\" \"assoc\"] 2\n   154\t    [\"handle-next\" \"assoc\"] 2\n   155\t    [\"waitset-resolver\" \"assoc\"] 1\n   156\t    [\"check-wait-set\" \"assoc\"] 1\n   157\t    ;; the ready-queue merge, asserted to carry only keyword keys\n   158\t    [\"resume-from-run-queue\" \"assoc\"] 1\n   159\t    [\"resume-from-run-queue\" \"merge\"] 1}\n   160\t   ;; program writes through engine/store-put: the definition transition,\n   161\t   ;; :vm/store-put, and :vm/store-update\n   162\t   \"src/cljc/yin/vm/ast_walker.cljc\"\n   163\t   {[\"cesk-transition\" \"assoc\"] 3\n   164\t    [\"cesk-transition\" \"engine/store-put\"] 3}\n   165\t   ;; opcodes 11 (store-put) and 24 (define), through engine/store-put\n   166\t   \"src/cljc/yin/vm/semantic.cljc\"\n   167\t   {[\"vm-hot\" \"assoc\"] 2\n   168\t    [\"vm-hot\" \"engine/store-put\"] 2}\n   169\t   ;; the constructor merge (checked) and :store-put/:define through\n   170\t   ;; engine/store-put\n   171\t   \"src/cljc/yin/vm/debruijn/stack.cljc\"\n   172\t   {[\"create-vm\" :map] 1\n   173\t    [\"create-vm\" \"merge\"] 1\n   174\t    [\"step1\" \"assoc\"] 2\n   175\t    [\"step1\" \"engine/store-put\"] 2}\n   176\t   \"src/cljc/yin/vm/debruijn/register.cljc\"\n   177\t   {[\"create-vm\" :map] 1\n   178\t    [\"create-vm\" \"merge\"] 1\n   179\t    [\"step1\" \"assoc\"] 2\n   180\t    [\"step1\" \"engine/store-put\"] 2}\n   181\t   ;; construction: the FFI pair under minted keyword keys\n   182\t   \"src/cljc/yin/vm.cljc\"\n   183\t   {[\"empty-state\" :map] 1}\n   184\t   ;; dao.await: minted keyword keys, checked\n   185\t   \"src/cljc/dao/await.cljc\"\n   186\t   {[\"run\" \"update\"] 1}\n   187\t   ;; the waitset library's result carries the store its :advance wrote\n   188\t   \"src/cljc/dao/stream/waitset.cljc\"\n   189\t   {[\"check\" :map] 1}\n   190\t   ;; a dao.space published-index handle, not a VM store\n   191\t   \"src/cljc/dao/space/query.cljc\"\n   192\t   {[\"open-published!\" :map] 1}\n   193\t   ;; the REPL history keys *1 *2 *3 (fixed symbols, none reserved), and\n   194\t   ;; the expander consumer's macro store\n   195\t   \"src/cljc/yin/repl.cljc\"\n   196\t   {[\"inject-last-value\" \"update\"] 1\n   197\t    [\"make-expander\" :map] 1}\n   198\t   ;; the handoff demo: shipped definitions, checked\n   199\t   \"src/cljc/datomworld/demo/continuation_handoff.cljc\"\n   200\t   {[\"datoms->semantic-vm\" \"update\"] 1}\n   201\t   ;; a JVM demo moving one VM's whole store to another\n   202\t   \"src/clj/yin/demo.clj\"\n   203\t   {[\"run-demo\" \"assoc\"] 1}\n   204\t   ;; display projections of a VM's store in the browser demos\n   205\t   \"src/cljs/datomworld/demo/compilation_pipeline.cljs\"\n   206\t   {[\"walker-cesk\" :map] 1}\n   207\t   \"src/cljs/datomworld/demo/continuation_stream.cljs\"\n   208\t   {[\"vm->cesk\" :map] 1}\n   209\t   ;; the expander's macro store: harvest refuses the reserved key,\n   210\t   ;; post-harvest installs only harvested names, make-ctx refuses a\n   211\t   ;; seeded store binding it, expand-batch threads the checked store\n   212\t   \"src/cljc/yin/vm/macro.cljc\"\n   213\t   {[\"harvest\" \"assoc\"] 1\n   214\t    [\"harvest\" \"dissoc\"] 1\n   215\t    [\"post-harvest\" \"assoc\"] 1\n   216\t    [\"post-harvest\" \"dissoc\"] 1\n   217\t    [\"make-ctx\" :map] 1\n   218\t    [\"expand-batch\" \"assoc\"] 2}})\n   219\t\n   220\t\n   221\t(deftest every-store-mutation-is-on-the-allowlist\n   222\t  (is (= allowlist (source-sites))\n   223\t      \"a new store mutation must go through engine/store-put or join the\n   224\t       allowlist with its reason; an unreadable file fails too\"))\n   225\t\n   226\t\n   227\t(def negative-fixtures\n   228\t  \"Common store-mutation forms outside the allowlist; each must be caught.\"\n   229\t  [\"(defn f [state v] (assoc-in state [:store 'yin/def] v))\"\n   230\t   \"(defn f [vm v] (update vm :store assoc 'x v))\"\n   231\t   \"(defn f [vm v] (update-in vm [:store 'x] (constantly v)))\"\n   232\t   \"(defn f [vm v] (assoc vm :store (conj (:store vm) ['x v])))\"\n   233\t   \"(defn f [vm] (dissoc (:store vm) 'x))\"\n   234\t   \"(defn f [vm ks] (select-keys (get vm :store) ks))\"\n   235\t   \"(defn f [store v] (into store {'x v}))\"\n   236\t   \"(defn f [new-store v]\\n  (merge\\n    new-store\\n    {'x v}))\"\n   237\t   \"(defn f [a v] (swap! a assoc-in [:store 'x] v))\"\n   238\t   \"(defn f [a v] (reset! a {:store v}))\"\n   239\t   \"(defn f [vm m] (merge-with merge vm {:store m}))\"\n   240\t   \"(defn f [vm v] (engine/store-put (:store vm) 'x v))\"\n   241\t   \"(defn f [vm v] #?(:clj (assoc-in vm [:store 'x] v) :cljs vm))\"])\n   242\t\n   243\t\n   244\t(deftest negative-fixtures-fail-the-audit\n   245\t  (doseq [src negative-fixtures]\n   246\t    (testing src\n   247\t      (let [sites (sites-in-source src)]\n   248\t        (is (seq sites) \"the mutation is detected\")\n   249\t        (is (not-any? #(= :unreadable (first %)) (keys sites)))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '255,304p;1690,1765p'; nl -ba src/cljc/yin/vm/ucf.cljc | sed -n '204,240p'; nl -ba src/cljc/yin/vm/linearize.cljc | sed -n '445,510p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '255,304p;1690,1765p'; nl -ba src/cljc/yin/vm/ucf.cljc | sed -n '204,240p'; nl -ba src/cljc/yin/vm/linearize.cljc | sed -n '445,510p'\"","aggregated_output":"   255\t\n   256\t\n   257\t(defn check-contract!\n   258\t  \"Refuse a persistent-code admission whose supplied stamp is absent\n   259\t   (`:contract-missing`) or names another revision (`:contract-mismatch`).\n   260\t   Runs before validation, so an old-stamped image fails by stamp.\"\n   261\t  [expected supplied]\n   262\t  (cond (nil? supplied)\n   263\t        (throw (ex-info \"Persistent code carries no contract stamp\"\n   264\t                        {:rule :contract-missing, :expected expected}))\n   265\t        (not= expected supplied)\n   266\t        (throw (ex-info (str \"Persistent code is stamped \" supplied\n   267\t                             \", this loader executes \" expected)\n   268\t                        {:rule :contract-mismatch,\n   269\t                         :expected expected,\n   270\t                         :actual supplied}))))\n   271\t\n   272\t\n   273\t(defn fresh-code-loader\n   274\t  \"The one explicitly trusted path that supplies a stamp: adapt a stamped\n   275\t   loader `(fn [vm code contract])` into an observer loader\n   276\t   `(fn [vm code])` for a medium whose only producer, in this\n   277\t   composition, is trusted fresh code (a frontend, the expander, the\n   278\t   encoder observer, the linearizer) emitting the current `contract`.\n   279\t   Never wrap a medium that carries externally supplied or persisted\n   280\t   code: such code carries its own stamp, and its loader verifies it.\"\n   281\t  [load contract]\n   282\t  (fn [vm code] (load vm code contract)))\n   283\t\n   284\t\n   285\t;; Primitive operations\n   286\t;; Arithmetic and comparison ops are direct clojure.core references.\n   287\t;; Wrapped only where VM semantics require it:\n   288\t;; - rest: clojure.core/rest returns a lazy seq; wrapped to return a vector\n   289\t;;   so that conj appends rather than prepends.\n   290\t;; - /: only the JVM throws on an integral zero divisor; JS and Dart divide\n   291\t;;   IEEE-754 and yield Infinity, so checked-divide makes the error\n   292\t;;   host-uniform.\n   293\t;; - require: returns an effect descriptor consumed by the engine.\n   294\t;; There is no `yin/def` primitive: a definition is syntax (Rule R).\n   295\t(defn- checked-divide\n   296\t  \"clojure.core `/` except a zero divisor throws on every host.\n   297\t\n   298\t   JVM `/` throws `Divide by zero` for integral division only; JS and Dart\n   299\t   yield Infinity, so `(/ 1 0)` through the VM silently evaluated to `##Inf`\n   300\t   on those hosts. The REPL corpus pins divide-by-zero as an error with this\n   301\t   text on both evaluators (docs/design/yin.vm.divergence-register.md).\n   302\t   JS and Dart cannot distinguish `0` from `0.0`, so no rule reproduces the\n   303\t   JVM's double-division `##Inf` cross-host; the uniform error is the\n   304\t   contract.\"\n  1690\t                :store-get #{},\n  1691\t                :store-put #{},\n  1692\t                :current-continuation #{},\n  1693\t                ;; a definition writes the store, machine state, like\n  1694\t                ;; :store-put; its AST side is an :application\n  1695\t                :define #{},\n  1696\t                :const #{}, :var #{}, :closure #{}, :push #{}, :call #{},\n  1697\t                :return #{}, :jump #{}, :branch-false #{}, :halt #{}}}})\n  1698\t\n  1699\t\n  1700\t(def ^:private extraction-fns\n  1701\t  \"The `:fns` the §7.7 queries need (§6.3: quoted-symbol keys): the\n  1702\t   effect-raising tag/mnemonic sets are judged by `contains?`, and a\n  1703\t   definition's key operand is the `first` of its operands.\"\n  1704\t  {'contains? contains?,\n  1705\t   'first first,\n  1706\t   'reserved-name? reserved-name?})\n  1707\t\n  1708\t\n  1709\t(defn- extract\n  1710\t  \"One §7.7 extraction query over `db`, its single find column as a set.\"\n  1711\t  [q db]\n  1712\t  (set (map first (query/collect (query/q q db {:fns extraction-fns})))))\n  1713\t\n  1714\t\n  1715\t(def ^:private ast-extraction-queries\n  1716\t  \"§7.7 over `$ast`, the union of the flat rows of the reachable trees,\n  1717\t   verbatim from the design.\"\n  1718\t  ;; Rule R: a definition's key is always a literal, so it is a\n  1719\t  ;; store-slice requirement exactly as a :vm/store-put key is\n  1720\t  {:store-keys '[:find ?key :in $ast\n  1721\t                 :where (or-join [?key]\n  1722\t                                 [$ast _ :vm/store-get ?key]\n  1723\t                                 [$ast _ :vm/store-put ?key _]\n  1724\t                                 (and [$ast _ :application ?op ?operands _]\n  1725\t                                      [$ast ?op :variable ?name]\n  1726\t                                      [(reserved-name? ?name)]\n  1727\t                                      [(first ?operands) ?kid]\n  1728\t                                      [$ast ?kid :literal ?key]))],\n  1729\t   :ffi-ops '[:find ?op :in $ast\n  1730\t              :where [$ast _ :dao.stream.apply/call ?op _]],\n  1731\t   :parked-ids '[:find ?pid :in $ast\n  1732\t                 :where [$ast _ :vm/resume ?pid _]],\n  1733\t   ;; syntax that raises an effect: the tag, to be normalized by the\n  1734\t   ;; footprint table\n  1735\t   :effect-raisers '[:find ?tag :in $ast\n  1736\t                     :where [$ast _ ?tag & _]\n  1737\t                     [(contains? #{:stream/make :stream/put :stream/cursor\n  1738\t                                   :stream/next :stream/close\n  1739\t                                   :dao.stream.apply/call}\n  1740\t                                 ?tag)]]})\n  1741\t\n  1742\t\n  1743\t(def ^:private segment-extraction-queries\n  1744\t  \"§7.7 over `$code`, the union of the segment-qualified rows\n  1745\t   (`yin.vm.code/project-segment-qualified`) of the reachable segments,\n  1746\t   verbatim from the design. The segment-side free-name query (derive free\n  1747\t   names from the vector's own scoping) is §7.7's to name but stays\n  1748\t   unverified there; `free-names` over `$ast`/`$occ` is the shipped\n  1749\t   extraction.\"\n  1750\t  {:store-keys '[:find ?key :in $code\n  1751\t                 :where (or [$code _ _ :store-get ?key]\n  1752\t                            [$code _ _ :store-put ?key _]\n  1753\t                            [$code _ _ :define ?key])],\n  1754\t   :ffi-ops '[:find ?op :in $code\n  1755\t              :where [$code _ _ :ffi-call ?op _]],\n  1756\t   :parked-ids '[:find ?pid :in $code\n  1757\t                 :where [$code _ _ :resume ?pid]],\n  1758\t   :effect-raisers '[:find ?mn :in $code\n  1759\t                     :where [$code _ _ ?mn & _]\n  1760\t                     [(contains? #{:stream-make :stream-put :stream-cursor\n  1761\t                                   :stream-next :stream-close :ffi-call}\n  1762\t                                 ?mn)]]})\n  1763\t\n  1764\t\n  1765\t(defn- requirements\n   204\t  \"`:yin.code/hash` of a canonical vector: its `dao.jing` segment address.\n   205\t   UCF mints no second addressing scheme.\"\n   206\t  [v]\n   207\t  (jing/segment-key v))\n   208\t\n   209\t\n   210\t(defn canonicalize\n   211\t  \"Code identity as one S7.9 outcome. On success\n   212\t   `{:yin.k/status :yin.k/ok, :yin.code/vector v, :yin.code/hash address,\n   213\t   :yin.k/contract contract-stamp}`; otherwise the `refusal` map the\n   214\t   vector function would have thrown.\n   215\t\n   216\t   `contract` is the batch's own semantic stamp, required and compared\n   217\t   with `vm/semantic-contract` first (`:contract-missing`,\n   218\t   `:contract-mismatch`, thrown): the outcome's stamp is the one verified,\n   219\t   never one assigned on the caller's behalf, so canonicalizing cannot\n   220\t   relabel an old or unstamped batch.\"\n   221\t  [datoms contract]\n   222\t  (vm/check-contract! vm/semantic-contract contract)\n   223\t  (try\n   224\t    (let [v (batch->canonical-instruction-vector datoms)]\n   225\t      {:yin.k/status :yin.k/ok,\n   226\t       :yin.code/vector v,\n   227\t       :yin.code/hash (code-address v),\n   228\t       :yin.k/contract contract-stamp})\n   229\t    (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   230\t      (let [data (ex-data e)]\n   231\t        (if (= :yin.k/non-portable (:yin.k/status data))\n   232\t          data\n   233\t          (throw e))))))\n   234\t\n   235\t\n   236\t;; =============================================================================\n   237\t;; Safepoints (S7.4)\n   238\t;; =============================================================================\n   239\t\n   240\t(def transitions\n   445\t\n   446\t\n   447\t(defn ast-loader\n   448\t  \"Adapt a stamped code loader `(fn [vm code-datoms contract])` into one\n   449\t   for a program stream carrying AST datoms: S3.1's\n   450\t   `(comp vm-load-program lower)` for a binary loader. The composition\n   451\t   makes this choice; no evaluator learns which form travels.\n   452\t\n   453\t   The returned loader is `(fn [vm datoms contract])`. `contract` is the\n   454\t   incoming AST's own stamp, required and compared with `vm/ast-contract`\n   455\t   before anything is lowered (`:contract-missing`, `:contract-mismatch`),\n   456\t   so an old or unstamped image is never relabelled. Only the lowered\n   457\t   segment, this linearizer's own fresh output from verified input, is\n   458\t   loaded under `vm/semantic-contract`. A medium whose only producer is\n   459\t   trusted fresh code composes `vm/fresh-code-loader` around this.\n   460\t\n   461\t   Successive batches on one medium are independent AST programs whose\n   462\t   tempids restart, so the default `:id-start` would hand two programs of\n   463\t   the same size one segment id, which the loader rejects as a conflict. Each\n   464\t   batch is therefore lowered below the input and below every segment the VM\n   465\t   already holds under `:code`; closures and continuations naming earlier\n   466\t   segments keep resolving.\"\n   467\t  [load-program]\n   468\t  (fn [vm datoms contract]\n   469\t    (vm/check-contract! vm/ast-contract contract)\n   470\t    (let [floor (reduce min\n   471\t                        (min (- datom/first-user-id) (vm/loaded-code-floor (:code vm)))\n   472\t                        (map first datoms))]\n   473\t      (load-program vm\n   474\t                    (lower datoms {:id-start (dec floor)})\n   475\t                    vm/semantic-contract))))\n   476\t\n   477\t\n   478\t(defn rows-loader\n   479\t  \"Adapt a stamped vector loader (`semantic/load-vector`) into the row\n   480\t   lane's loader for a row medium (S7.1): each observed batch is one\n   481\t   tree's canonical row set `{:root id, :rows {id row}}`, already projected\n   482\t   by whatever producer owns the medium, the encoder observer for the\n   483\t   composition that attaches the semantic VM behind one\n   484\t   (`yin.vm.encoder`). The set is validated (S7.4), lowered to the\n   485\t   canonical instruction vector (S5.1), and loaded; a batch of any other\n   486\t   shape fails validation and throws.\n   487\t\n   488\t   The returned loader is `(fn [vm bc contract])`: `contract` is the row\n   489\t   set's own AST stamp, required and compared with `vm/ast-contract` before\n   490\t   lowering, exactly as `ast-loader` requires; only the lowered vector is\n   491\t   loaded under `vm/semantic-contract`. A medium whose only producer is\n   492\t   trusted fresh code composes `vm/fresh-code-loader` around this.\n   493\t\n   494\t   The composition makes this choice; no evaluator learns which form\n   495\t   travels.\"\n   496\t  [load-vector]\n   497\t  (fn [vm bc contract]\n   498\t    (vm/check-contract! vm/ast-contract contract)\n   499\t    (load-vector vm\n   500\t                 (:vector (if (and (map? bc) (contains? bc :yin/batch))\n   501\t                            (lower-envelope bc)\n   502\t                            (lower-rows bc)))\n   503\t                 vm/semantic-contract)))\n","exit_code":0,"status":"completed"}}
