 conj [a entry ctx])))\n   331\t    :stream (update facts :streams conj (nth av 1))\n   332\t    :cursor (update facts :cursors conj (nth av 1))\n   333\t    :parked (update facts :parked conj (nth av 1))\n   334\t    :k (let [[_ a _pc ctx frames stack] av]\n   335\t         (reduce abstract-facts\n   336\t                 (update facts :items conj [a ctx])\n   337\t                 (concat frames stack)))\n   338\t    :frame (let [[_ a _pc ctx] av] (update facts :items conj [a ctx]))\n   339\t    :primitive (update facts :primitives conj (nth av 1))\n   340\t    :unaddressed (update facts :refusals conj\n   341\t                         {:kind :unaddressed-segment, :segment (nth av 1)})\n   342\t    :unnamed-function (update facts :refusals conj {:kind :unnamed-function})\n   343\t    :ambiguous-primitive (update facts :refusals conj\n   344\t                                 {:kind :ambiguous-primitive})))\n   345\t\n   346\t\n   347\t(defn value-facts\n   348\t  \"§5.2: what one context — any set of abstract values — contributes\n   349\t   regardless of address. Pure data; `apply-value-facts` folds it into the\n   350\t   walk state.\"\n   351\t  [context]\n   352\t  (reduce abstract-facts empty-value-facts context))\n   353\t\n   354\t\n   355\t;; =============================================================================\n   356\t;; §6–§7 Discharge and the slices\n   357\t;; =============================================================================\n   358\t\n   359\t(declare apply-value-facts)\n   360\t\n   361\t\n   362\t(defn- push-item\n   363\t  \"An item enters the frontier only if it is in neither `:items` nor the\n   364\t   frontier (§3).\"\n   365\t  [state item]\n   366\t  (if (or (contains? (:items state) item)\n   367\t          (contains? (:queued state) item))\n   368\t    state\n   369\t    (-> state\n   370\t        (update :frontier conj item)\n   371\t        (update :queued conj item))))\n   372\t\n   373\t\n   374\t(defn- pull-store\n   375\t  \"§7.1: pull store key `k` when the store holds it; the pulled value is\n   376\t   abstracted and folded at once. The `:store-slice` key set is the memo\n   377\t   that closes cycles through the store. An FFI pair key is never pulled.\"\n   378\t  [state env k]\n   379\t  (let [store (:store (:vm env))]\n   380\t    (if (or (contains? (:store-slice state) k)\n   381\t            (contains? ffi-pair-keys k)\n   382\t            (not (contains? store k)))\n   383\t      state\n   384\t      (let [v (get store k)\n   385\t            state (assoc-in state [:store-slice k] v)\n   386\t            ;; a cursor-entry `{:stream-id id :cursor <opaque>}` pulls its\n   387\t            ;; stream and names its transport profile (§7.1 rule 4, §9)\n   388\t            state (if (and (map? v) (contains? v :stream-id)\n   389\t                           (contains? v :cursor))\n   390\t                    (-> state\n   391\t                        (update-in [:requires :yin.k/streams] conj\n   392\t                                   (:stream-id v))\n   393\t                        (update-in [:requires :yin.k/cursor-profiles] conj\n   394\t                                   ((:cursor-profile env) (:cursor v)))\n   395\t                        (pull-store env (:stream-id v)))\n   396\t                    state)]\n   397\t        (apply-value-facts state env (value-facts (abstract-value env v)))))))\n   398\t\n   399\t\n   400\t(defn- pull-record\n   401\t  \"Fold one `{segment pc env stack k}` register map — a parked record, a\n   402\t   wait entry, the machine's own frame — as roots (§7.2, §8 step 2).\"\n   403\t  [state env {:keys [segment k stack] E :env}]\n   404\t  (let [vm (:vm env)\n   405\t        frames (cond-> (vec k) segment (conj {:segment segment, :env E}))\n   406\t        state (reduce (fn [state f]\n   407\t                        (if-let [a (address-of vm (:segment f))]\n   408\t                          (push-item state [a (context-of env (:env f))])\n   409\t                          (refuse state {:kind :unaddressed-segment,\n   410\t                                         :segment (:segment f)})))\n   411\t                      state\n   412\t                      frames)]\n   413\t    (apply-value-facts\n   414\t      state env\n   415\t      (value-facts (into #{} (mapcat #(abstract-value env %)) stack)))))\n   416\t\n   417\t\n   418\t(defn- pull-parked\n   419\t  \"§7.2 with the §12.1 split: a pid absent from `(:parked vm)` is\n   420\t   `:missing :parked` (→ `:incomplete`) when code names it — a requirement\n   421\t   the emitter cannot supply — and a `:foreign-parked-ref` refusal when a\n   422\t   value names it — corrupted state, halting the lift before encoding.\"\n   423\t  [state env pid origin]\n   424\t  (let [parked (:parked (:vm env))]\n   425\t    (cond\n   426\t      (contains? (:parked-slice state) pid) state\n   427\t      (contains? parked pid) (-> state\n   428\t                                 (assoc-in [:parked-slice pid] (get parked pid))\n   429\t                                 (pull-record env (get parked pid)))\n   430\t      (= :code origin) (update-in state [:missing :parked] conj pid)\n   431\t      :else (refuse state {:kind :foreign-parked-ref, :parked-id pid}))))\n   432\t\n   433\t\n   434\t(defn- module-of\n   435\t  \"§6 / §12.4: the module a namespaced free name resolves through, in\n","exit_code":0,"status":"completed"}}
