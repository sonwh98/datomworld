/vm/semantic_ffi_test.cljc:32:  (vm/fresh-code-loader\ntest/yin/vm/debruijn/register_test.cljc:74:  (vm/fresh-code-loader (linearize/ast-loader semantic/vm-load-program)\ntest/yin/vm/debruijn/stack_effects_test.cljc:78:  (vm/fresh-code-loader\ntest/yin/vm/test_utils.cljc:155:                        (vm/fresh-code-loader\ntest/yin/vm/test_utils.cljc:171:  (vm/fresh-code-loader ast-walker/vm-load-program vm/ast-contract))\ntest/yin/vm/debruijn/stack_parity_test.cljc:114:  (vm/fresh-code-loader\ntest/yin/vm/semantic_engine_test.cljc:22:  (vm/fresh-code-loader\ntest/yin/vm/semantic_stream_observer_test.cljc:94:  (vm/fresh-code-loader (linearize/rows-loader semantic/load-vector)\ntest/yin/vm/semantic_stream_observer_test.cljc:99:  (vm/fresh-code-loader\nsrc/cljc/yin/vm/linearize.cljc:459:   trusted fresh code composes `vm/fresh-code-loader` around this.\nsrc/cljc/yin/vm/linearize.cljc:492:   trusted fresh code composes `vm/fresh-code-loader` around this.\nsrc/cljc/yin/vm.cljc:273:(defn fresh-code-loader\n","exit_code":0,"status":"completed"}}
