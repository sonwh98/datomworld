before lowering\")\n   510\t          (let [d (refusal #(load \"v2\"))]\n   511\t            (is (= :contract-mismatch (:rule d))\n   512\t                \"an old-stamped input is refused before lowering\")\n   513\t            (is (= \"v2\" (:actual d))))\n   514\t          (is (= 3 (vm/value (vm/run (load vm/ast-contract))))\n   515\t              \"a current-stamped input lowers, loads, and runs\")))))\n   516\t  (testing \"the explicitly trusted fresh-producer path supplies the stamp\"\n   517\t    (let [load (vm/fresh-code-loader\n   518\t                 (linearize/ast-loader semantic/vm-load-program)\n   519\t                 vm/ast-contract)]\n   520\t      (is (= 3 (vm/value (vm/run (load (semantic/create-vm)\n   521\t                                       (vm/ast->datoms\n   522\t                                         (app (v '+) (lit 1) (lit 2)))))))))))\n   523\t\n   524\t\n   525\t(deftest canonicalize-verifies-the-batch-stamp\n   526\t  (let [batch (segment-batch [[:const 1] [:halt]])]\n   527\t    (is (= :contract-missing (rule-of #(ucf/canonicalize batch nil))))\n   528\t    (is (= :contract-mismatch (rule-of #(ucf/canonicalize batch \"v2\"))))\n   529\t    (is (= {:yin.code/contract \"v3\", :yin.k/version 0}\n   530\t           (:yin.k/contract (ucf/canonicalize batch vm/semantic-contract)))\n   531\t        \"the stamp on the outcome is the one verified, never assigned\")))\n   532\t\n   533\t\n   534\t;; =============================================================================\n   535\t;; Free names\n   536\t;; =============================================================================\n   537\t\n   538\t(deftest free-names-exclude-the-definition-operator\n   539\t  (let [ast (then (def! 'x (lit 1)) (app (v 'f) (v 'x)))\n   540\t        bc (vm/ast->semantic-bytecode ast)\n   541\t        db (query/relation (vals (:rows bc)))\n   542\t        occ (query/relation (vm/occurrences bc))]\n   543\t    (is (= #{'f 'x} (vm/free-names db occ (:root bc))))))\n   330\t        (is (= {:type type, :node -20} (ex-data e))))))\n   331\t  (testing \"an unknown or missing node type\"\n   332\t    (let [e (try (linearize/lower [[-20 :yin/root true 0 :db/add]\n   333\t                                   [-20 :yin/type :no/such 0 :db/add]])\n   334\t                 nil\n   335\t                 (catch #?(:cljd Object :clj Exception :cljs :default) e e))]\n   336\t      (is (= {:type :no/such, :node -20} (ex-data e))))))\n   337\t\n   338\t\n   339\t(deftest ast-loader-lowers-before-loading\n   340\t  (let [ast-datoms (vm/ast->datoms worked-example)\n   341\t        load (linearize/ast-loader (fn [vm code-datoms contract]\n   342\t                                     (assoc vm\n   343\t                                            :code code-datoms\n   344\t                                            :contract contract)))]\n   345\t    (is (= (linearize/lower ast-datoms)\n   346\t           (:code (load {} ast-datoms vm/ast-contract))))\n   347\t    (is (= vm/semantic-contract\n   348\t           (:contract (load {} ast-datoms vm/ast-contract)))\n   349\t        \"the input's AST stamp is verified; only the linearizer's own\n   350\t         lowered output is stamped, with the semantic contract\")\n   351\t    (is (= :contract-missing\n   352\t           (:rule (throws-ex-data #(load {} ast-datoms nil))))\n   353\t        \"an unstamped input never reaches the lowerer\")))\n   354\t\n   355\t\n   356\t;; =============================================================================\n   357\t;; Evaluation order against the walker\n   358\t;; =============================================================================\n   359\t\n   360\t(defn- run-image\n   361\t  \"A reference reading of the §4.2 core transitions over an image:\n   362\t   instruction maps in pc order with `:yin.code/target`/`:yin.code/body`\n   363\t   already pc integers. It exists to check the lowering's evaluation\n   364\t   order, not to stand in for the semantic VM.\"\n   365\t  [image primitives]\n   366\t  (loop [pc 0\n   367\t         val nil\n   368\t         st []\n   369\t         env {}\n   370\t         store {}\n   371\t         k []]\n   372\t    (let [i (nth image pc)]\n   128\t(deftest canonical-vector-of-the-worked-segment-test\n   129\t  (let [v (ucf/batch->canonical-instruction-vector (worked-segment))]\n   130\t    (testing \"pc is the index; tuples are mnemonic plus S2.4 operands\"\n   131\t      (is (= worked-vector v))\n   132\t      (is (= 14 (count v))))\n   133\t    (testing \"No entity id, attribute keyword or provenance survives\"\n   134\t      (is (not-any? (fn [t] (some keyword? (rest t))) v))\n   135\t      (is (every? vector? v)))\n   136\t    (testing \"Refs are the loader's resolved pcs\"\n   137\t      (is (= 6 (nth (nth v 0) 2))))\n   138\t    (testing \"The direct path accepts and runs what canonicalization mints\"\n   139\t      (let [loaded (semantic/load-vector (make-vm) v vm/semantic-contract)]\n   140\t        (is (= 11 (vm/value (vm/run loaded))))\n   141\t        (is (= (:code (semantic/load-image (worked-segment)))\n   142\t               (:code (get-in loaded [:code (:program loaded)])))\n   143\t            \"projection and direct paths yield one image (S7.3.4)\")))))\n   144\t\n   145\t\n   146\t(deftest code-identity-and-contract-stamp-test\n   147\t  (let [outcome (ucf/canonicalize (worked-segment) vm/semantic-contract)]\n   148\t    (testing \"The address is dao.jing's segment key of the vector\"\n   149\t      (is (= :yin.k/ok (:yin.k/status outcome)))\n   150\t      (is (= worked-vector (:yin.code/vector outcome)))\n   151\t      (is (= (jing/segment-key worked-vector) (:yin.code/hash outcome)))\n   152\t      (is (= (ucf/code-address worked-vector) (:yin.code/hash outcome)))\n   153\t      (is (jing/segment-address? (:yin.code/hash outcome))))\n   154\t    (testing \"The stamp names the v3 contract and the envelope version\"\n   155\t      (is (= {:yin.code/contract \"v3\", :yin.k/version 0}\n   156\t             (:yin.k/contract outcome)))\n   157\t      (is (= ucf/contract-stamp (:yin.k/contract outcome))))))\n   158\t\n   159\t\n   160\t(deftest loader-verifies-the-address-canonicalization-mints-test\n   161\t  (let [address (:yin.code/hash (ucf/canonicalize (effects-segment)\n   162\t                                                  vm/semantic-contract))\n   163\t        claimed (fn [batch]\n   164\t                  (into (segment 8 [[:yin.code/hash address]])\n   165\t                        (remove (fn [[e]] (= seg e)) batch)))]\n   166\t    (testing \"A batch stating its defaults earns the claim\"\n   167\t      (is (= address (:address (semantic/load-image\n   168\t                                 (claimed (effects-segment)))))))\n   169\t    (testing \"A batch omitting them earns the same claim: one canonicalizer\"\n   170\t      (is (= address\n   171\t             (:address (semantic/load-image\n   172\t                         (claimed (without-attrs\n   173\t                                    (effects-segment)\n   174\t                                    #{:yin.code/prefix :yin.code/buffer\n   175\t                                      :yin.code/tail?})))))))\n   176\t    (testing \"A different segment does not\"\n   177\t      (is (= {:rule :hash-mismatch, :entity seg}\n","exit_code":0,"status":"completed"}}
