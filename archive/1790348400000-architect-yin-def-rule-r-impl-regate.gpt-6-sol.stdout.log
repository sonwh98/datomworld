{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/datomworld/demo/continuation_handoff.cljc | sed -n '130,190p'; nl -ba src/cljc/yin/repl.cljc | sed -n '140,171p'; nl -ba src/cljc/yin/vm/macro.cljc | sed -n '707,738p'; nl -ba src/cljc/yin/vm/completion.cljc | sed -n '670,705p'\"","aggregated_output":"   130\t             k))\n   131\t\n   132\t\n   133\t(defn resource-keys\n   134\t  \"Store keys holding live resources the registers cannot carry: anything\n   135\t   that is neither a definition (a symbol) nor the composition's FFI pair.\n   136\t   These are stream handles made by `:stream-make`; a `{:type :stream-ref}`\n   137\t   in the registers names one, and on the receiver it would name nothing.\"\n   138\t  [vm-state]\n   139\t  (into []\n   140\t        (remove #(or (symbol? %) (composition-key? %)))\n   141\t        (keys (:store vm-state))))\n   142\t\n   143\t\n   144\t(defn shippable?\n   145\t  \"True when a semantic VM is between instructions with nothing outside its\n   146\t   registers: no wait set, ready queue, or parked continuation, and no stream\n   147\t   handle in its store.\"\n   148\t  [vm-state]\n   149\t  (boolean (and vm-state\n   150\t                (:control vm-state)\n   151\t                (not (:halted? vm-state))\n   152\t                (not (:blocked? vm-state))\n   153\t                (empty? (:wait-set vm-state))\n   154\t                (empty? (:ready-queue vm-state))\n   155\t                (empty? (:parked vm-state))\n   156\t                (empty? (resource-keys vm-state)))))\n   157\t\n   158\t\n   159\t(defn semantic-registers\n   160\t  \"The plain-data registers of a shippable semantic VM, stamped with the\n   161\t   semantic contract its segment was admitted under. A primitive the\n   162\t   program resolved (a `+` pushed before its call) travels by name; any other\n   163\t   host function throws, as does a VM holding stream handles, which would\n   164\t   arrive as references to nothing.\"\n   165\t  [vm-state]\n   166\t  (when-let [ks (seq (resource-keys vm-state))]\n   167\t    (throw (ex-info \"Cannot ship a continuation holding live stream resources\"\n   168\t                    {:resource-keys (vec ks)})))\n   169\t  (encode-primitives\n   170\t    (:primitives vm-state)\n   171\t    {:contract vm/semantic-contract,\n   172\t     :segment (get-in vm-state [:control :segment]),\n   173\t     :pc (get-in vm-state [:control :pc]),\n   174\t     :value (:value vm-state),\n   175\t     :stack (:stack vm-state),\n   176\t     :env (:env vm-state),\n   177\t     :k (:k vm-state),\n   178\t     :id-counter (:id-counter vm-state),\n   179\t     :defs (into {} (filter (comp symbol? key)) (:store vm-state))}))\n   180\t\n   181\t\n   182\t(defn continuation-datoms\n   183\t  \"The handoff batch for a shippable semantic VM running `code-datoms`: the\n   184\t   segment, then one registers datom carrying EDN text.\"\n   185\t  [code-datoms vm-state]\n   186\t  (let [registers (semantic-registers vm-state)\n   187\t        k-eid (dec (reduce min 0 (map first code-datoms)))]\n   188\t    (conj (vec code-datoms)\n   189\t          [k-eid registers-attr (pr-str registers) 0 0])))\n   190\t\n   140\t           :hash (rcode/register-hash combined)\n   141\t           :pc offset)))\n   142\t\n   143\t\n   144\t(def program-loaders\n   145\t  \"The loader the evaluator observer hands each `program-out` value, per\n   146\t   evaluator.  Every value there is one expanded canonical tree packet\n   147\t   `[root rows]` (yin.vm.macro.md §2.4); each loader takes its row set — the\n   148\t   ast-walker through `vm-load-rows`, the semantic VM through\n   149\t   `linearize/rows-loader` over `semantic/load-vector`, and the de Bruijn\n   150\t   kernels through their lowerings to a stack image (H) or a register\n   151\t   image (R).  No evaluator learns that an expander ran.\"\n   152\t  {:ast-walker (fn [vm packet]\n   153\t                 (ast-walker/vm-load-rows vm\n   154\t                                          (macro/packet->row-set packet)\n   155\t                                          vm/ast-contract))\n   156\t   ;; every loader here is the trusted fresh-producer path: the only\n   157\t   ;; producer of `program-out` is the expander, so each supplies the\n   158\t   ;; current stamp itself\n   159\t   :semantic (let [load-rows (linearize/rows-loader semantic/load-vector)]\n   160\t               (fn [vm packet]\n   161\t                 (load-rows vm\n   162\t                            (macro/packet->row-set packet)\n   163\t                            vm/ast-contract)))\n   164\t   :stack (fn [vm packet]\n   165\t            (append-stack-image\n   166\t              vm\n   167\t              (:image (debruijn-linearize/adapt\n   168\t                        (packet->named-datoms packet)))))\n   169\t   :register (fn [vm packet]\n   170\t               (append-register-image\n   171\t                 vm\n   707\t(defn- catch-message\n   708\t  [e]\n   709\t  (or (ex-message e) (str e)))\n   710\t\n   711\t\n   712\t(defn bounded-row-evaluator\n   713\t  \"The default body runner (§5.2): a fresh throwaway ast-walker loaded from\n   714\t   the lambda body's rows, its parameters bound in `env`, the closed\n   715\t   `prelude` as its only primitives, no store, no module resolver, no stream\n   716\t   constructor, and no FFI bridge. It counts VM transitions.\n   717\t\n   718\t   Returns `{:value v}`, or `{:error e}` with `e` one of\n   719\t   `{:kind :fuel-guard :steps n}`, `{:kind :suspended}` (a park, resume,\n   720\t   bridge call, blocked read, or work scheduled outside the body\n   721\t   continuation), `{:kind :effect-guard :tag t}` (a stream constructor), or\n   722\t   `{:kind :body-error :message s}` (the body threw).\"\n   723\t  [{:keys [macro-tree env prelude max-steps]}]\n   724\t  (let [index (packet-index macro-tree)\n   725\t        body (nth (get 