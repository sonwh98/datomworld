9\t      (let [result (stream/next handle (:cursor cursor-data))\n   260\t            o (outcome result)\n   261\t            advance (fn [state* value]\n   262\t                      {:value value,\n   263\t                       :state (assoc state*\n   264\t                                     :store\n   265\t                                     (assoc store\n   266\t                                            cursor-id\n   267\t                                            (assoc cursor-data\n   268\t                                                   :cursor\n   269\t                                                   (:dao.stream/cursor\n   270\t                                                     result))))})]\n   271\t        (case o\n   272\t          :dao.stream/ok (advance state (:dao.stream/value result))\n   273\t          :dao.stream/blocked {:park true,\n   274\t                               :cursor-ref cursor-ref,\n   275\t                               :stream-id stream-id,\n   276\t                               :state state}\n   277\t          :dao.stream/end {:value nil, :state state}\n   278\t          :dao.stream/gap (advance state :dao.stream/gap)\n   279\t          (fail \"Stream read failed\"\n   280\t                {:outcome o, :stream-id stream-id, :cursor-id cursor-id}))))))\n   281\t\n   282\t\n   283\t(defn handle-close\n   342\t   instead of every waiter reading the value at the shared pre-poll\n   343\t   cursor. An entry that stays waiting is retained in its stored,\n   344\t   resource-id form.\n   345\t\n   346\t   Each woken result's `:status` is stamped onto its ready entry, where\n   347\t   `terminal-resume-outcome` reads it: an outcome the immediate operation\n   348\t   raises as an error fails the same way when the resume pops it — and a\n   349\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n   350\t   there too, before any continuation is restored.\"\n   351\t  [state]\n   352\t  (let [wait-set (:wait-set state)]\n   353\t    (if (empty? wait-set)\n   354\t      state\n   355\t      (let [{:keys [woken store], :as result}\n   356\t            (waitset/check {:waiting wait-set} waitset-resolver (:store state))\n   357\t            v (assoc state\n   358\t                     :store store\n   359\t                     :wait-set (:waiting (:waitset result)))]\n   360\t        (update v\n   361\t                :ready-queue (fnil into [])\n   362\t                (make-woken-run-queue-entries v woken))))))\n   363\t\n   364\t\n   365\t(declare handle-effect resume-continuation)\n   366\t\n   367\t\n   368\t(defn run-loop\n   369\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n   370\t   `resume-fn` pops and restores them.\"\n   371\t  [state active? step-fn resume-fn]\n   372\t  (loop [v state]\n   373\t    (let [q (or (:ready-queue v) [])]\n   374\t      (cond (active? v) (recur (step-fn v))\n   375\t            (:blocked? v) (let [v' (check-wait-set v)]\n   376\t                            (if-let [resumed (resume-fn v')]\n   377\t                              (recur resumed)\n   378\t                              (telemetry/emit-snapshot v' :blocked)))\n   379\t            (seq q) (if-let [resumed (resume-fn v)]\n   380\t                      (recur resumed)\n   445\t  (let [run-queue (or (:ready-queue state) [])]\n   446\t    (when (seq run-queue)\n   447\t      (let [entry (first run-queue)\n   448\t            rest-queue (subvec run-queue 1)\n   449\t            updates (:store-updates entry)\n   450\t            ;; allowlisted state construction: a woken entry only ever\n   451\t            ;; carries engine-minted keyword keys (cursor ids)\n   452\t            _ (when-let [k (some #(when-not (keyword? %) %) (keys updates))]\n   453\t                (fail \"Ready entry store update carries a non-minted key\"\n   454\t                      {:rule :store-update-key, :key k}))\n   455\t            base (assoc state\n   456\t                        :ready-queue rest-queue\n   457\t                        :store (merge (:store state) updates)\n   458\t                        :blocked? false\n   459\t                        :halted? false)]\n   460\t        (if-let [terminal (terminal-resume-outcome entry)]\n   461\t          (throw-terminal-resume! entry terminal)\n   462\t          (restore-fn base entry (:value entry)))))))\n   605\t              :else (recur tail depth false))))))\n   606\t\n   607\t\n   608\t;; =============================================================================\n   609\t;; Evaluation\n   610\t;; =============================================================================\n   611\t\n   612\t(defn- inject-last-value\n   613\t  [state]\n   614\t  (update state :vm update :store assoc\n   615\t          '*1 (:last-value state)\n   616\t          '*2 (:last-value-2 state)\n   617\t          '*3 (:last-value-3 state)))\n   618\t\n   619\t\n   620\t(defn- record-last-value\n   621\t  [state state-after value]\n   622\t  (assoc state-after\n   623\t         :last-value value\n   624\t         :last-value-2 (:last-value state)\n   625\t         :last-value-3 (:last-value-2 state)))\n","exit_code":0,"status":"completed"}}
