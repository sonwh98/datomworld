k/streams])))\n   234\t    (is (= (get-in a [:yin.k/requires :yin.k/streams])\n   235\t           (get-in both [:yin.k/requires :yin.k/streams])))\n   236\t    (testing \"the slice is pulled, never copied\"\n   237\t      (let [stream-id (first (get-in a [:yin.k/requires :yin.k/streams]))]\n   238\t        (is (= #{'a 'mk 'fact stream-id} (set (keys (:yin.k/store a)))))\n   239\t        (is (= #{'b 'mk 'fact} (set (keys (:yin.k/store b)))))))\n   240\t    (is (= :complete (get-in both [:yin.k/requires :yin.k/discovery])))))\n   241\t\n   242\t\n   243\t(deftest stored-closure-is-a-work-item-and-its-names-are-discharged\n   244\t  (let [result (complete-getting 'b)\n   245\t        requires (:yin.k/requires result)]\n   246\t    (is (= [[maker-address #{}]] (maker-items result))\n   247\t        \"reachable only through the :store-get operand\")\n   248\t    (is (contains? (:yin.k/segments requires) maker-address))\n   249\t    (is (= (vm/profile-of vm/primitives '*)\n   250\t           (get-in requires [:yin.k/primitives '*])))\n   251\t    (is (not (contains? (:yin.k/primitives requires) 'yin/def))\n   252\t        \"Rule R: a definition is syntax, never a free name to discharge\")\n   253\t    (is (not (contains? (:yin.k/effects requires) :vm/store-put))\n   254\t        \"a definition's store write is machine state, as :store-put's is\")\n   255\t    (is (contains? (:yin.k/store result) 'fact)\n   256\t        \"fact is a free name of the segment, discharged by the store\")\n   257\t    (is (= :complete (:yin.k/discovery requires)))\n   258\t    (is (empty? (:yin.k/refusals result)))))\n   259\t\n   260\t\n   261\t(deftest def-recursion-terminates\n   262\t  (let [result (complete-getting 'fact)]\n   263\t    (is (= [[maker-address #{}]] (maker-items result))\n   264\t        \"one work item per [address context]\")\n   265\t    (is (= 2 (count (::completion/work-items result))))\n   266\t    (is (= :complete (get-in result [:yin.k/requires :yin.k/discovery])))))\n   267\t\n   268\t\n   269\t;; =============================================================================\n   270\t;; 5. Missing parked ids — the §12.1 split\n   271\t;; =============================================================================\n   272\t\n   273\t(deftest code-side-missing-pid-is-incomplete\n   274\t  (let [machine (load-ast (new-vm)\n   275\t                          {:type :vm/resume, :parked-id :parked-99,\n   276\t                           :val (lit 1)})\n   277\t        result (completion/complete {:vm machine})]\n   278\t    (is (= :incomplete (get-in result [:yin.k/requires :yin.k/discovery])))\n   279\t    (is (= #{:parked-99} (get-in result [:yin.k/missing :parked])))\n   280\t    (is (empty? (:yin.k/refusals result))\n   281\t        \"an unsatisfied requirement, not an encoding failure\")))\n   282\t\n   283\t\n   284\t(deftest value-side-missing-pid-is-refused\n   285\t  (let [machine (load-ast (new-vm {:env {'p {:type :parked-continuation,\n   286\t                                             :id :parked-99}}})\n   287\t                          (lit 1))\n   288\t        result (completion/complete {:vm machine})]\n   289\t    (is (= [{:kind :foreign-parked-ref, :parked-id :parked-99}]\n   290\t           (:yin.k/refusals result)))\n   291\t    (is (empty? (get-in result [:yin.k/missing :parked])))))\n   292\t\n   293\t\n   294\t(deftest present-parked-record-is-pulled\n   295\t  (let [parked (vm/run (load-ast (new-vm) {:type :vm/park}))\n   296\t        pid (first (keys (:parked parked)))\n   297\t        machine (load-ast parked {:type :vm/resume, :parked-id pid,\n   298\t                                  :val (lit 1)})\n   299\t        result (completion/complete {:vm machine})]\n   300\t    (is (= #{pid} (set (keys (get-in result [:yin.k/scheduler :yin.k/parked])))))\n   301\t    (is (= (:id-counter machine)\n   302\t           (get-in result [:yin.k/scheduler :yin.k/id-counter])))\n   303\t    (is (= 2 (count (::completion