{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/dao/lease_composition_test.cljc'","aggregated_output":"     1\t(ns dao.lease-composition-test\n     2\t  \"Composition deftests for dao.lease Phase 4 (C1-C8), per the revised\n     3\t  implementation plan's §4.4 prove list: the refusal matrix, the\n     4\t  process-scoped fallback, the end-to-end grant->renew->lapse cycle\n     5\t  through make-judge with a hand-turned tick stream, the non-ok :lapsed\n     6\t  append leaving the lease pending, and the three use-case sketches as\n     7\t  commented compositions -- runnable wirings, not products.\n     8\t\n     9\t  Everything is scripted as in lease_test: hand-appended ticks and facts\n    10\t  over ring buffers, per-author-media attribution, no host clock anywhere\n    11\t  in this file (the reference tick driver and its host clock live in\n    12\t  lease_test, the test tree's host policy). The real serving session in\n    13\t  the served-connection sketch is JVM-only, gated #?(:cljd nil :clj ...).\"\n    14\t  (:require [clojure.test :refer [deftest is testing]]\n    15\t            [dao.lease :as lease]\n    16\t            [dao.stream :as ds]\n    17\t            [dao.stream.ringbuffer :as ringbuffer]\n    18\t            [dao.stream.serving :as serving]\n    19\t            [dao.stream.ws :as ws]))\n    20\t\n    21\t\n    22\t;; =============================================================================\n    23\t;; Harness\n    24\t;; =============================================================================\n    25\t\n    26\t(defn- new-buffer\n    27\t  [capacity]\n    28\t  (let [result (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    29\t                                    ringbuffer/capacity-key capacity})]\n    30\t    (if (= :dao.stream/ok (:dao.stream/outcome result))\n    31\t      (:dao.stream/handle result)\n    32\t      (throw (ex-info \"test buffer creation failed\" {:result result})))))\n    33\t\n    34\t\n    35\t(defn- oldest-cursor\n    36\t  [handle]\n    37\t  (let [minted (ds/cursor handle ds/anchor-oldest)]\n    38\t    (if (= :dao.stream/ok (:dao.stream/outcome minted))\n    39\t      (:dao.stream/cursor minted)\n    40\t      (throw (ex-info \"test cursor mint failed\" {:result minted})))))\n    41\t\n    42\t\n    43\t(defn- drain-values\n    44\t  \"Every value currently retained on handle, oldest first.\"\n    45\t  [handle]\n    46\t  (loop [cursor (oldest-cursor handle)\n    47\t         out []]\n    48\t    (let [read (ds/next handle cursor)]\n    49\t      (if (= :dao.stream/ok (:dao.stream/outcome read))\n    50\t        (recur (:dao.stream/cursor read) (conj out (:dao.stream/value read)))\n    51\t        out))))\n    52\t\n    53\t\n    54\t(defn- append-ok!\n    55\t  [handle value]\n    56\t  (let [result (ds/append! handle value)]\n    57\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n    58\t      (throw (ex-info \"test append failed\" {:result result :value value})))\n    59\t    handle))\n    60\t\n    61\t\n    62\t(defn- resolver\n    63\t  \"The composition's attribution: per-author media identity by default\n    64\t  (see the attachment-identity sketch for the :ws/attachment binding).\"\n    65\t  [source _fact]\n    66\t  source)\n    67\t\n    68\t\n    69\t(defn- fake-writer\n    70\t  \"A writer whose every append answers one outcome -- the ring buffer\n    71\t  evicts instead of answering :full, so the non-ok :lapsed append cases\n    72\t  need a scripted writer.\"\n    73\t  [outcome]\n    74\t  (reify\n    75\t    ds/IDaoStreamWriter\n    76\t    (append!\n    77\t      [_ _val]\n    78\t      {:dao.stream/outcome outcome})))\n    79\t\n    80\t\n    81\t(def standard-medium\n    82\t  \"The reference declaration for a per-author fact medium, with an honest\n    83\t  capacity matching its test handle (r4-r3/F1: no capacity is derived\n    84\t  against the drain budget -- a larger budget is the safe case).\"\n    85\t  {:retention :evict-oldest\n    86\t   :capacity 8\n    87\t   :value-domain :portable-values\n    88\t   :attribution :per-author-media})\n    89\t\n    90\t\n    91\t(defn- judge-config\n    92\t  \"A valid make-judge config over fresh ring buffers, then overrides.\"\n    93\t  [overrides]\n    94\t  (let [ticks (new-buffer 8)\n    95\t        facts (new-buffer 8)\n    96\t        writer (new-buffer 8)\n    97\t        base {:cadence {:ms 5}\n    98\t              :units {:ms 1}\n    99\t              :tolerance {:ms 0}\n   100\t              :resolver resolver\n   101\t              :resolver-bindings #{:per-author-media}\n   102\t              :reclaim (fn [_] true)\n   103\t              :writer writer\n   104\t              :self :grantor\n   105\t              :ticks [{:handle ticks :cursor (oldest-cursor ticks)}]\n   106\t              :media [{:handle facts\n   107\t                       :cursor (oldest-cursor facts)\n   108\t                       :source :holder-a\n   109\t                       :medium standard-medium}]}]\n   110\t    (merge base overrides)))\n   111\t\n   112\t\n   113\t(defn- holder-config\n   114\t  \"A valid make-holder config over a fresh fact medium, then overrides.\"\n   115\t  [overrides]\n   116\t  (let [facts (new-buffer 8)\n   117\t        ticks (new-buffer 8)\n   118\t        outbound (new-buffer 8)\n   119\t        base {:self :holder-a\n   120\t              :grantor :grantor\n   121\t              :units {:ms 1}\n   122\t              :resolver resolver\n   123\t              :resolver-bindings #{:per-author-media}\n   124\t              :renewal-interval {:ms 4}\n   125\t              :tick {:handle ticks :cursor (oldest-cursor ticks)}\n   126\t              :fact {:handle facts\n   127\t                     :cursor (oldest-cursor facts)\n   128\t                     :source :grantor\n   129\t                     :medium standard-medium}\n   130\t              :writer {:handle outbound\n   131\t                       :medium standard-medium}}]\n   132\t    (merge base overrides)))\n   133\t\n   134\t\n   135\t(defn- refusal-key\n   136\t  \"The :refused key of the assembly refusal's ex-data, or :assembled when\n   137\t  the constructor succeeded. Every composition refusal names the seam it\n   138\t  refused under an explicit :refused key -- no map key-order dependence\n   139\t  (r4-P3).\"\n   140\t  [config]\n   141\t  (try (lease/make-judge config) :assembled\n   142\t    (catch #?(:cljd Object :clj Exception :cljs :default) e\n   143\t      (:refused (ex-data e)))))\n   144\t\n   145\t\n   146\t(defn- holder-refusal-key\n   147\t  [config]\n   148\t  (try (lease/make-holder config) :assembled\n   149\t    (catch #?(:cljd Object :clj Exception :cljs :default) e\n   150\t      (:refused (ex-data e)))))\n   151\t\n   152\t\n   153\t(defn- composed\n   154\t  \"A make-judge system over ring buffers, driven by hand: fresh\n   155\t  ticks/facts/writer, the composed judge's :step/:judge on the map, and\n   156\t  the Phase 2 driving helpers re-keyed to it.\"\n   157\t  [options]\n   158\t  (let [ticks (new-buffer 16)\n   159\t        facts (new-buffer 16)\n   160\t        writer (new-buffer 16)\n   161\t        composed (lease/make-judge\n   162\t                   {:cadence {:ms 5}\n   163\t                    :units {:ms 1}\n   164\t                    :tolerance (get options :tolerance {:ms 0})\n   165\t                    :resolver (get options :resolver resolver)\n   166\t                    :resolver-bindings\n   167\t                    (get options :resolver-bindings #{:per-author-media})\n   168\t                    :reclaim (get options :reclaim (fn [_] true))\n   169\t                    :writer writer\n   170\t                    :self :grantor\n   171\t                    :ticks [{:handle ticks :cursor (oldest-cursor ticks)}]\n   172\t                    :media [{:handle facts\n   173\t                             :cursor (oldest-cursor facts)\n   174\t                             :source :holder-a\n   175\t                             :medium (get options :medium standard-medium)}]})]\n   176\t    {:ticks ticks\n   177\t     :facts facts\n   178\t     :writer writer\n   179\t     :composed composed\n   180\t     :judge (:judge composed)}))\n   181\t\n   182\t\n   183\t(defn- tick!\n   184\t  [system ms]\n   185\t  (append-ok! (:ticks system) (lease/tick {:ms ms}))\n   186\t  system)\n   187\t\n   188\t\n   189\t(defn- fact!\n   190\t  [system fact]\n   191\t  (append-ok! (:facts system) fact)\n   192\t  system)\n   193\t\n   194\t\n   195\t(defn- step!\n   196\t  \"One pass through the composed judge's own :step -- the same fn the\n   197\t  composition's runtime would drive at :cadence.\"\n   198\t  [system]\n   199\t  (assoc system :judge ((get-in system [:composed :step]) (:judge system))))\n   200\t\n   201\t\n   202\t(defn- records\n   203\t  \"The writer's records after the grant.\"\n   204\t  [system]\n   205\t  (rest (drain-values (:writer system))))\n   206\t\n   207\t\n   208\t;; =============================================================================\n   209\t;; 4.4#1: the refusal matrix (C2, C3, C4, D4)\n   210\t;; =============================================================================\n   211\t\n   212\t(deftest refusal-matrix-test\n   213\t  (testing \"C2/C3/C4/D4: every missing or incompatible seam throws at\n   214\t            assembly, before any stream is wired\"\n   215\t    (let [cases [[:cadence (fn [c] (dissoc c :cadence))]\n   216\t                 [:cadence (fn [c] (assoc c :cadence {:ms 0}))]\n   217\t                 [:cadence (fn [c] (assoc c :cadence {:hr 3}))]\n   218\t                 [:ticks (fn [c] (assoc c :ticks []))]\n   219\t                 [:ticks (fn [c] (assoc c :ticks [{:handle 1}]))]\n   220\t                 [:media (fn [c] (assoc c :media []))]\n   221\t                 [:medium-entry\n   222\t                  (fn [c] (assoc-in c [:media 0] {:handle 1 :cursor 2}))]\n   223\t                 [:medium (fn [c] (assoc-in c [:media 0 :medium] nil))]\n   224\t                 [:medium (fn [c] (update-in c [:media 0 :medium]\n   225\t                                             dissoc :retention))]\n   226\t                 [:medium (fn [c] (assoc-in c [:media 0 :medium :retention]\n   227\t                                            :neither))]\n   228\t                 [:medium (fn [c] (assoc-in c [:media 0 :medium :capacity] 0))]\n   229\t                 [:medium (fn [c] (assoc-in c [:media 0 :medium :value-domain]\n   230\t                                            :anything))]\n   231\t                 [:medium (fn [c] (assoc-in c [:media 0 :medium :attribution]\n   232\t                                            :wire))]\n   233\t                 [:tolerance (fn [c] (assoc c :tolerance {:hr 3}))]\n   234\t                 [:tolerance (fn [c] (dissoc c :tolerance))]\n   235\t                 [:self (fn [c] (dissoc c :self))]\n   236\t                 [:resolver (fn [c] (dissoc c :resolver))]\n   237\t                 [:resolver-bindings (fn [c] (dissoc c :resolver-bindings))]\n   238\t                 [:attribution\n   239\t                  (fn [c] (assoc c :resolver-bindings #{:envelope-key}))]\n   240\t                 [:writer (fn [c] (dissoc c :writer))]\n   241\t                 [:reclaim (fn [c] (dissoc c :reclaim))]\n   242\t                 [:host-values\n   243\t                  (fn [c]\n   244\t                    (let [b (new-buffer 8)]\n   245\t                      (assoc c :durable? true\n   246\t                             :durable-judge :dj :incarnation-rule :ir\n   247\t                             :fencing :f\n   248\t                             :media [{:handle b\n   249\t                                      :cursor (oldest-cursor b)\n   250\t                                      :source :holder-a\n   251\t                                      :medium (assoc standard-medium\n   252\t                                                     :value-domain\n   253\t                                                     :host-values)}])))]\n   254\t                 [:durable-judge (fn [c] (assoc c :durable? true))]\n   255\t                 [:incarnation-rule\n   256\t                  (fn [c] (assoc c :durable? true :durable-judge :dj))]\n   257\t                 [:fencing\n   258\t                  (fn [c] (assoc c :durable? true :durable-judge :dj\n   259\t                                 :incarnation-rule :ir))]]]\n   260\t      (doseq [[expected modify] cases]\n   261\t        (is (= expected (refusal-key (modify (judge-config {}))))\n   262\t            (str \"the config refusing with \" expected))))\n   263\t    (is (some? (lease/make-judge (judge-config {})))\n   264\t        \"the unmodified config assembles\")\n   265\t    (let [complete (new-buffer 8)]\n   266\t      (is (some? (lease/make-judge\n   267\t                   (judge-config\n   268\t                     {:media [{:handle complete\n   269\t                               :cursor (oldest-cursor complete)\n   270\t                               :source :holder-a\n   271\t                               :medium (-> standard-medium\n   272\t                                           (assoc :retention :complete)\n   273\t                                           (dissoc :capacity))}]})))\n   274\t          \"r4-P3: a :complete medium needs no :capacity -- retention is\n   275\t           complete, nothing evicts\"))))\n   276\t\n   277\t\n   278\t(deftest holder-refusal-matrix-test\n   279\t  (testing \"C2/C3/C4: the holder half refuses the same way\"\n   280\t    (let [cases [[:tick (fn [c] (dissoc c :tick))]\n   281\t                 [:tick (fn [c] (assoc c :tick {:handle 1}))]\n   282\t                 [:fact (fn [c] (dissoc c :fact))]\n   283\t                 [:fact (fn [c] (assoc c :fact {:handle 1 :cursor 2}))]\n   284\t                 [:medium (fn [c] (assoc-in c [:fact :medium :retention] :neither))]\n   285\t                 [:medium (fn [c] (assoc-in c [:fact :medium :capacity] 0))]\n   286\t                 [:writer (fn [c] (dissoc c :writer))]\n   287\t                 [:medium (fn [c] (assoc c :writer {:handle 1}))]\n   288\t                 [:medium (fn [c] (assoc-in c [:writer :medium :capacity] 0))]\n   289\t                 [:resolver (fn [c] (dissoc c :resolver))]\n   290\t                 [:resolver-bindings (fn [c] (dissoc c :resolver-bindings))]\n   291\t                 [:attribution\n   292\t                  (fn [c] (assoc c :resolver-bindings #{:attachment-identity}))]\n   293\t                 [:renewal-interval (fn [c] (dissoc c :renewal-interval))]\n   294\t                 [:host-values\n   295\t                  (fn [c] (assoc-in (assoc c :durable? true\n   296\t                                           :durable-judge :dj\n   297\t                                           :incarnation-rule :ir\n   298\t                                           :fencing :f)\n   299\t                                     [:fact :medium :value-domain]\n   300\t                                     :host-values))]\n   301\t                 [:durable-judge (fn [c] (assoc c :durable? true))]]]\n   302\t      (doseq [[expected modify] cases]\n   303\t        (is (= expected (holder-refusal-key (modify (holder-config {}))))\n   304\t            (str \"the holder config refusing with \" expected))))\n   305\t    (is (some? (lease/make-holder (holder-config {})))\n   306\t        \"the unmodified holder config assembles\")))\n   307\t\n   308\t\n   309\t;; =============================================================================\n   310\t;; 4.4#2: the process-scoped fallback (C4)\n   311\t;; =============================================================================\n   312\t\n   313\t(deftest process-scoped-fallback-test\n   314\t  (testing \"C4: a non-durable config is declared process-scoped on the value\"\n   315\t    (is (= :process-scoped (:scope (lease/make-judge (judge-config {})))))\n   316\t    (is (= :process-scoped (:scope (lease/make-holder (holder-config {})))))\n   317\t    (is (= {:ms 5} (:cadence (lease/make-judge (judge-config {}))))\n   318\t        \"the declared cadence rides the value for the runtime to keep\"))\n   319\t  (testing \"C4: durable with all three prerequisites constructs durable\"\n   320\t    (let [prereqs {:durable? true\n   321\t                   :durable-judge :the-durable-judge\n   322\t                   :incarnation-rule (fn [_incarnation] true)\n   323\t                   :fencing :the-fence}]\n   324\t      (is (= :durable (:scope (lease/make-judge (judge-config prereqs)))))\n   325\t      (is (= :durable (:scope (lease/make-holder (holder-config prereqs)))))))\n   326\t  (testing \"C4: a :durable? config without all three does not construct at all\"\n   327\t    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n   328\t                 (lease/make-judge (judge-config {:durable? true}))))\n   329\t    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n   330\t                 (lease/make-holder (holder-config\n   331\t                                      {:durable? true\n   332\t                                       :durable-judge :only-one}))))))\n   333\t\n   334\t\n   335\t;; =============================================================================\n   336\t;; 4.4#3: end-to-end through make-judge (C1, J8)\n   337\t;; =============================================================================\n   338\t\n   339\t(deftest end-to-end-grant-renew-lapse-test\n   340\t  (testing \"C1: a composed judge drives grant -> renew -> lapse, exactly once\"\n   341\t    (let [log (atom [])\n   342\t          system (-> (composed {:reclaim (fn [subject]\n   343\t                                           (swap! log conj subject)\n   344\t                                           true)})\n   345\t                     (update :judge lease/author-grant\n   346\t                             (lease/grant :l1 :db :holder-a {:ms 10}))\n   347\t                     (tick! 1)\n   348\t                     step!)]\n   349\t      (is (= [(lease/grant :l1 :db :holder-a {:ms 10})]\n   350\t             (drain-values (:writer system)))\n   351\t          \"the grant was delivered on the writer and seeded\")\n   352\t      (is (= {:ms 1} (get-in system [:judge :ledger :l1 :tenure-start])))\n   353\t      (let [system (-> system\n   354\t                       (tick! 7)\n   355\t                       (fact! (lease/renewal :l1))\n   356\t                       step!)]\n   357\t        (is (= {:ms 7} (get-in system\n   358\t                               [:judge :ledger :l1 :last-observation]))\n   359\t            \"the holder's renewal counted through the wired medium\")\n   360\t        (let [system (-> system (tick! 18) step!)]\n   361\t          (is (= [:db] @log) \"the reclaim was performed exactly once\")\n   362\t          (is (= [(lease/lapsed :l1 :silence)] (records system))\n   363\t              \"and recorded once: the record survives the reclaimed\n   364\t               resource -- a reclaim frees the resource, never the record\")\n   365\t          (is (empty? (get-in system [:judge :ledger]))\n   366\t              \"on ok the lease left the ledger\")\n   367\t          (let [system (-> system (tick! 19) step!)\n   368\t                system (-> system (tick! 20) step!)]\n   369\t            (is (= [:db] @log)\n   370\t                \"no later pass reclaims or re-records a completed lapse\")\n   371\t            (is (= [(lease/lapsed :l1 :silence)] (records system)))))))))\n   372\t\n   373\t(deftest non-ok-lapsed-append-leaves-lease-pending-test\n   374\t  (testing \"J8: a :lapsed append answering a non-ok outcome leaves the lease\n   375\t            pending for the next pass\"\n   376\t    (doseq [outcome [:dao.stream/full\n   377\t                     :dao.stream/closed\n   378\t                     :dao.stream/transport-error]]\n   379\t      (testing (str \"outcome \" outcome)\n   380\t        (let [log (atom [])\n   381\t              system (-> (composed {:reclaim (fn [subject]\n   382\t                                               (swap! log conj subject)\n   383\t                                               true)})\n   384\t                         (update :judge lease/author-grant\n   385\t                                 (lease/grant :l1 :db :holder-a {:ms 10}))\n   386\t                         (tick! 1)\n   387\t                         step!)]\n   388\t          (is (= 1 (count (drain-values (:writer system)))))\n   389\t          ;; the writer fails before the record: the transport's failure,\n   390\t          ;; swapped in as a composition would on failover\n   391\t          (let [system (-> system\n   392\t                           (update :judge assoc :writer (fake-writer outcome))\n   393\t                           (tick! 12)\n   394\t                           step!)]\n   395\t            (is (= [:db] @log) \"the reclaim itself succeeded\")\n   396\t            (is (= {:state :pending :cause :silence :success true}\n   397\t                   (get-in system [:judge :ledger :l1 :reclaim]))\n   398\t                \"the lease stays pending: the record never landed\")\n   399\t            (let [system (-> system (tick! 13) step!)]\n   400\t              (is (= [:db :db] @log)\n   401\t                  \"the retry re-attempted the idempotent reclaim\")\n   402\t              (is (= :silence\n   403\t                     (get-in system [:judge :ledger :l1 :reclaim :cause]))\n   404\t                  \"a pending lease keeps its cause, not reclassified\")\n   405\t              (is (= 1 (count (drain-values (:writer system))))\n   406\t                  \"the healthy writer still holds only the grant: the\n   407\t                   :lapsed never landed on it\"))))))))\n   408\t\n   409\t\n   410\t(deftest nil-resolver-answer-never-counts-as-grantor-test\n   411\t  (testing \"P1/r4: a resolver answering nil for an unknown source authors\n   412\t            nothing -- only a non-nil :self makes that certain\"\n   413\t    ;; With :self required and non-nil at assembly, the nil answer of a\n   414\t    ;; resolver meeting an unknown source or a missing envelope key can\n   415\t    ;; never equal the grantor: a forged :accepted on a stranger's medium\n   416\t    ;; establishes no tenure.\n   417\t    (let [known-only (fn [source _fact]\n   418\t                       (get {:holder-a :holder-a} source))\n   419\t          stranger (new-buffer 8)\n   420\t          system (-> (composed {:resolver known-only})\n   421\t                     (update :judge assoc :self :grantor)\n   422\t                     (update :judge lease/wire-facts\n   423\t                             stranger (oldest-cursor stranger) :a-stranger))\n   424\t          system (-> system\n   425\t                     (update :judge lease/author-grant\n   426\t                             (lease/grant :l1 :db :holder-a {:ms 10}))\n   427\t                     (tick! 1)\n   428\t                     step!)]\n   429\t      (is (= [(lease/grant :l1 :db :holder-a {:ms 10})]\n   430\t             (drain-values (:writer system)))\n   431\t          \"the composed grantor's own grant was delivered\")\n   432\t      ;; the forged :accepted arrives on a medium the resolver does not\n   433\t      ;; know: its author answers nil\n   434\t      (append-ok! stranger (lease/grant :l9 :db :holder-a {:ms 10}))\n   435\t      (let [system (-> system\n   436\t                       (tick! 2)\n   437\t                       step!)]\n   438\t        (is (= #{:l1} (set (keys (get-in system [:judge :ledger]))))\n   439\t            \"only the composed grantor's own :l1 holds tenure\")\n   440\t        (is (false? (contains? (get-in system [:judge :ledger]) :l9))\n   441\t            \"a nil attribution authored no term: the forged :accepted\n   442\t             established nothing\")\n   443\t        (is (= 0 (get-in system [:judge :dropped]))\n   444\t            \"it is valid data about no one, not a defect\")))))\n   445\t\n   446\t\n   447\t(deftest composed-both-halves-cycle-test\n   448\t  (testing \"C1/H1-H4: a composed holder observes, renews and releases\n   449\t            through its own wiring\"\n   450\t    (let [log (atom [])\n   451\t          judge-ticks (new-buffer 16)\n   452\t          facts (new-buffer 16)         ;; the holder's outbound medium:\n   453\t                                        ;; what the judge reads\n   454\t          writer (new-buffer 16)        ;; the grantor's record stream\n   455\t          holder-facts (new-buffer 16)  ;; where the holder observes grants\n   456\t          holder-ticks (new-buffer 16)  ;; the holder's OWN tick stream\n   457\t          composed-judge\n   458\t          (lease/make-judge\n   459\t            {:cadence {:ms 5}\n   460\t             :units {:ms 1}\n   461\t             :tolerance {:ms 0}\n   462\t             :resolver resolver\n   463\t             :resolver-bindings #{:per-author-media}\n   464\t             :reclaim (fn [subject] (swap! log conj subject) true)\n   465\t             :writer writer\n   466\t             :self :grantor\n   467\t             :ticks [{:handle judge-ticks\n   468\t                      :cursor (oldest-cursor judge-ticks)}]\n   469\t             :media [{:handle facts\n   470\t                      :cursor (oldest-cursor facts)\n   471\t                      :source :holder-a\n   472\t                      :medium standard-medium}]})\n   473\t          composed-holder\n   474\t          (lease/make-holder\n   475\t            {:self :holder-a\n   476\t             :grantor :grantor\n   477\t             :units {:ms 1}\n   478\t             :resolver resolver\n   479\t             :resolver-bindings #{:per-author-media}\n   480\t             :renewal-interval {:ms 4}\n   481\t             :tick {:handle holder-ticks\n   482\t                    :cursor (oldest-cursor holder-ticks)}\n   483\t             :fact {:handle holder-facts\n   484\t                    :cursor (oldest-cursor holder-facts)\n   485\t                    :source :grantor\n   486\t                    :medium standard-medium}\n   487\t             :writer {:handle facts\n   488\t                      :medium standard-medium}})\n   489\t          grant (lease/grant :l1 :db :holder-a {:ms 10})\n   490\t          judge (atom (lease/author-grant (:judge composed-judge) grant))\n   491\t          judge-tick! (fn [ms]\n   492\t                        (append-ok! judge-ticks (lease/tick {:ms ms})))\n   493\t          step-judge! (fn []\n   494\t                        (reset! judge\n   495\t                                ((:step composed-judge) @judge)))\n   496\t          _ (do (judge-tick! 1)\n   497\t                (step-judge!)\n   498\t                ;; the composition's carriage delivers the grant to the\n   499\t                ;; holder's inbound medium\n   500\t                (append-ok! holder-facts grant)\n   501\t                (append-ok! holder-ticks (lease/tick {:ms 1})))\n   502\t          holder (lease/observe-grant (:holder composed-holder)\n   503\t                                      :grantor grant {:ms 1})]\n   504\t      (is (= grant (:grant holder))\n   505\t          \"H1: the holder observed the grantor-authored grant\")\n   506\t      (is (true? (lease/holding? holder {:ms 2})))\n   507\t      (is (false? (lease/due-to-renew? holder {:ms 4})))\n   508\t      (append-ok! holder-ticks (lease/tick {:ms 5}))\n   509\t      ;; the holder's control flow DRAINS its own tick medium for the\n   510\t      ;; reading (r4-r3/F3: the wiring is exercised as a medium, not\n   511\t      ;; only appended to)\n   512\t      (let [newest (get (last (drain-values holder-ticks))\n   513\t                        :dao.lease/reading)]\n   514\t        (is (= {:ms 5} newest)\n   515\t            \"the drained reading is the tick the driver deposited\")\n   516\t        (is (true? (lease/due-to-renew? holder newest))\n   517\t            \"due at the interval on its own tick stream\"))\n   518\t      (let [;; the renewal is appended to the holder's outbound writer --\n   519\t            ;; the judge's medium -- and recorded at the reading drained\n   520\t            ;; BEFORE the append\n   521\t            append (ds/append! (get-in composed-holder [:writer :handle])\n   522\t                               (lease/renewal :l1))\n   523\t            holder (lease/observe-renewal holder {:ms 5} append)]\n   524\t        (is (= :dao.stream/ok (:dao.stream/outcome append)))\n   525\t        (is (= {:ms 5} (:last-renewal-at holder)))\n   526\t        (judge-tick! 7)\n   527\t        (step-judge!)\n   528\t        (is (= {:ms 7} (get-in @judge [:ledger :l1 :last-observation]))\n   529\t            \"the judge's pass counted the composed holder's renewal\")\n   530\t        ;; done: stop, carry the release, and the judge reclaims :release\n   531\t        (let [{:keys [holder release]} (lease/stop holder)]\n   532\t          (is (false? (lease/holding? holder {:ms 8})))\n   533\t          (is (= :dao.lease/released\n   534\t                 (get release :dao.lease/status)))\n   535\t          (append-ok! facts release)\n   536\t          (judge-tick! 8)\n   537\t          (step-judge!)\n   538\t          (is (= [:db] @log) \"the grantor performed the reclaim\")\n   539\t          (is (= [(lease/lapsed :l1 :release)]\n   540\t                 (rest (drain-values writer)))\n   541\t              \"and recorded it: a :release lapse, authored by the holder's\n   542\t               :released, never a :lapsed from the holder\")\n   543\t          (is (empty? (get-in @judge [:ledger]))\n   544\t              \"the :release lapse left the ledger\"))))))\n   545\t\n   546\t\n   547\t;; =============================================================================\n   548\t;; 4.4: the three use-case sketches -- commented compositions,\n   549\t;; lightly exercised, not products\n   550\t;; =============================================================================\n   551\t\n   552\t(deftest forwarder-pause-sketch-test\n   553\t  (testing \"sketch: the forwarder pause -- reclaim = cease driving the\n   554\t            forward step, then close-session!\"\n   555\t    ;; A forwarder holds a lease while it advances a serving session's\n   556\t    ;; forward step (the driving shape of dao/jing/remote.cljc:981-988 and\n   557\t    ;; serving/step!). The driver loop below stands in for that daemon\n   558\t    ;; thread: it keeps stepping the session while :stepping? holds, and\n   559\t    ;; the lease's reclaim procedure is exactly the release discipline --\n   560\t    ;; cease stepping, then close-session! (serving.cljc:179-183's shape).\n   561\t    (let [session (atom {:stepping? true :closed? false})\n   562\t          system (composed {:reclaim (fn [_subject]\n   563\t                                       (swap! session assoc\n   564\t                                              :stepping? false\n   565\t                                              :closed? true)\n   566\t                                       true)})\n   567\t          system (-> system\n   568\t                     (update :judge lease/author-grant\n   569\t                             (lease/grant :l1 :forwarder :holder-a {:ms 10}))\n   570\t                     (tick! 1)\n   571\t                     step!)\n   572\t          system (-> system (tick! 12) step!)]\n   573\t      (is (true? (:closed? @session))\n   574\t          \"the reclaim closed the session\")\n   575\t      (is (false? (:stepping? @session))\n   576\t          \"and ceased the driving: the driver loop's condition is gone\")\n   577\t      (is (= [(lease/lapsed :l1 :silence)] (records system))))))\n   578\t\n   579\t\n   580\t(defn- buffer\n   581\t  \"A plain ring-buffer handle (the serving fixture's transport).\"\n   582\t  [capacity]\n   583\t  (:dao.stream/handle\n   584\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n   585\t                         ringbuffer/capacity-key capacity})))\n   586\t\n   587\t\n   588\t(def ^:private ws-admission\n   589\t  {:retention :evict-oldest :capacity 16 :value-domain :portable-values})\n   590\t\n   591\t\n   592\t(def ^:private handoff-admission\n   593\t  {:retention :evict-oldest :capacity 1 :value-domain :host-values})\n   594\t\n   595\t\n   596\t(def ^:private served-descriptor\n   597\t  {:dao.stream/type :dao.stream/ws\n   598\t   :dao.stream/identity \"lease-composition-sketch\"\n   599\t   :ws/host \"127.0.0.1\"\n   600\t   :ws/port 9183\n   601\t   :ws/path \"/lease/sketch\"})\n   602\t\n   603\t\n   604\t(defn- serving-fixture\n   605\t  \"One real serving composition over in-memory buffers -- the serving\n   606\t  test's fixture shape, pared to what the sketch drives. The endpoint\n   607\t  never binds a listener (:start-endpoint! is a stub); the connection is\n   608\t  accepted in-process.\"\n   609\t  [{:keys [service traffic]}]\n   610\t  (let [offer (buffer 1)\n   611\t        ack (buffer 1)\n   612\t        control (buffer 16)\n   613\t        newest (fn [handle]\n   614\t                 (:dao.stream/cursor (ds/cursor handle ds/anchor-newest)))\n   615\t        endpoint (ws/make-endpoint\n   616\t                   {:served {\"/lease/sketch\" served-descriptor}\n   617\t                    :control {:dao.stream/handle control\n   618\t                              :dao.stream/surface #{:writer}}\n   619\t                    :control-admission ws-admission\n   620\t                    :slots [{:offer {:dao.stream/handle offer\n   621\t                                     :dao.stream/surface #{:writer}}\n   622\t                             :offer-admission handoff-admission\n   623\t                             :ack {:dao.stream/handle ack\n   624\t                                   :dao.stream/surface #{:writer}}\n   625\t                             :ack-admission handoff-admission\n   626\t                             :ack-cursor (newest ack)}]\n   627\t                    :expiry-ms nil})\n   628\t        ended (atom [])\n   629\t        composition (serving/make-serving\n   630\t                      {:endpoint endpoint\n   631\t                       :served {\"/lease/sketch\"\n   632\t                                {:descriptor served-descriptor\n   633\t                                 :stream service}}\n   634\t                       :control-reader control\n   635\t                       :control-cursor (newest control)\n   636\t                       :slots [{:offer-reader offer\n   637\t                                :offer-cursor (newest offer)\n   638\t                                :ack-writer {:dao.stream/handle ack\n   639\t                                             :dao.stream/surface #{:writer}}}]\n   640\t                       :make-traffic (fn [_]\n   641\t                                       {:traffic {:dao.stream/handle traffic\n   642\t                                                  :dao.stream/surface\n   643\t                                                  #{:writer}}\n   644\t                                        :admission ws-admission\n   645\t                                        :reader traffic\n   646\t                                        :cursor (newest traffic)})\n   647\t                       :forward-options {:batch-budget 8 :gap-policy :terminate}\n   648\t                       :start-endpoint! (fn [_ep] {:host :started})\n   649\t                       :stop-endpoint! (fn [_ep] {:host :stopped})\n   650\t                       :close-ended! (fn [handle]\n   651\t                                       (swap! ended conj handle)\n   652\t                                       {:dao.stream/outcome :dao.stream/ok})})]\n   653\t    {:endpoint endpoint\n   654\t     :composition composition\n   655\t     :ended ended}))\n   656\t\n   657\t\n   658\t(defn- carriage\n   659\t  \"A composition's carry step from a grantor's stream to a recipient's\n   660\t  inbound medium: copies every fact EXCEPT :lapsed -- :lapsed does not\n   661\t  cross a boundary (C8); the remote holder observes the reclaim as the\n   662\t  resource event, not as the grantor's record. Cursor-threaded, so each\n   663\t  step carries only what is new.\"\n   664\t  [source destination]\n   665\t  (let [cursor (atom (oldest-cursor source))]\n   666\t    (fn []\n   667\t      (loop []\n   668\t        (let [read (ds/next source @cursor)]\n   669\t          (when (= :dao.stream/ok (:dao.stream/outcome read))\n   670\t            (reset! cursor (:dao.stream/cursor read))\n   671\t            (when (not= :dao.lease/lapsed\n   672\t                        (get (:dao.stream/value read) :dao.lease/status))\n   673\t              (append-ok! destination (:dao.stream/value read)))\n   674\t            (recur)))))))\n   675\t\n   676\t\n   677\t(deftest served-connection-lifetime-sketch-test\n   678\t  (testing \"sketch: the served connection lifetime -- envelope-key\n   679\t            attribution and :lapsed carriage (C8)\"\n   680\t    ;; Attribution by ENVELOPE KEY (D4; the :ws/attachment envelope key of\n   681\t    ;; ws.cljc:167-174): each fact carries its attachment id in the\n   682\t    ;; envelope, and the resolver reads it FROM THE FACT -- the wired\n   683\t    ;; source is never consulted, which is exactly what declaring\n   684\t    ;; :attribution :envelope-key means (r4-P2: the earlier sketch\n   685\t    ;; declared :attachment-identity while resolving like per-author\n   686\t    ;; media, and nothing noticed).\n   687\t    ;;\n   688\t    ;; OWED (r4-r3/F2, recorded by the orchestrator in the plan's §6):\n   689\t    ;; the flattened shape modelled here -- :ws/attachment sitting\n   690\t    ;; directly on the lease fact -- is NOT the transport's. ws.cljc\n   691\t    ;; deposits {:ws/attachment <id> :ws/event ... :ws/value <payload>};\n   692\t    ;; a real composition unwraps :ws/value before the judge sees a\n   693\t    ;; lease fact, and the envelope key, as modelled here, is\n   694\t    ;; SELF-ASSERTED: whoever appends to the medium chooses it. The\n   695\t    ;; transport's authoritativeness comes from the connection, not the\n   696\t    ;; key -- an unwrap seam and a trusted binding are owed work.\n   697\t    (let [connection (atom {:open? true})\n   698\t          traffic (new-buffer 16)\n   699\t          holder-reads (new-buffer 16)\n   700\t          envelope-resolver (fn [_source fact] (get fact :ws/attachment))\n   701\t          medium (assoc standard-medium :attribution :envelope-key)\n   702\t          system (composed\n   703\t                   {:resolver envelope-resolver\n   704\t                    :resolver-bindings #{:envelope-key}\n   705\t                    :medium medium\n   706\t                    :reclaim (fn [_subject]\n   707\t                               (swap! connection assoc :open? false)\n   708\t                               true)})\n   709\t          grant (lease/grant :l1 :socket-handle :holder-a {:ms 10})\n   710\t          system (-> system\n   711\t                     (update :judge lease/author-grant grant)\n   712\t                     (tick! 1)\n   713\t                     step!)\n   714\t          ;; the holder's renewal rides its envelope: :ws/attachment\n   715\t          system (-> system\n   716\t                     (fact! (assoc (lease/renewal :l1)\n   717\t                                   :ws/attachment :holder-a))\n   718\t                     (tick! 7)\n   719\t                     step!)]\n   720\t      (is (= {:ms 7} (get-in system [:judge :ledger :l1 :last-observation]))\n   721\t          \"the envelope-keyed renewal counted as :holder-a's evidence -- the\n   722\t           resolver read the author from the envelope, not the source\")\n   723\t      (let [system (-> system (tick! 18) step!)]\n   724\t        (is (false? (:open? @connection))\n   725\t            \"reclaim closed the served connection\")\n   726\t        (is (= [(lease/lapsed :l1 :silence)] (records system))\n   727\t            \"the :lapsed record is on the grantor's writer\")\n   728\t        ;; CARRIAGE: the composition's step copying grantor facts to the\n   729\t        ;; holder's inbound medium, with :lapsed filtered out. The writer\n   730\t        ;; HELD a :lapsed; the holder's medium must not receive it.\n   731\t        (let [carry! (carriage (:writer system) holder-reads)]\n   732\t          (carry!)\n   733\t          (is (= [grant] (drain-values holder-reads))\n   734\t              \"the grant was carried across; the :lapsed was filtered: the\n   735\t               holder observes the reclaim as the connection's closing --\n   736\t               the resource event -- never as the grantor's record\"))))))\n   737\t\n   738\t#?(:cljd nil\n   739\t   :clj\n   740\t   (deftest served-connection-real-close-path-sketch-test\n   741\t     (testing \"sketch (JVM): one real serving session, reclaimed through the\n   742\t               real close path\"\n   743\t       ;; The served-connection sketch against the real transport: one\n   744\t       ;; ws endpoint, one accepted connection, the serving driver\n   745\t       ;; stepping it. The lease's subject is the served stream; the\n   746\t       ;; reclaim is the real close -- close the served stream, then one\n   747\t       ;; serving step retires the session and runs the WebSocket close\n   748\t       ;; (:close-ended!).\n   749\t       ;;\n   750\t       ;; OWED (r4-r3/F2, recorded by the orchestrator in the plan's\n   751\t       ;; §6): the envelope shape flattened onto the renewal below is\n   752\t       ;; not the transport's -- ws.cljc deposits {:ws/attachment <id>\n   753\t       ;; :ws/event ... :ws/value <payload>}, so a real composition\n   754\t       ;; unwraps :ws/value before the judge sees a lease fact, and the\n   755\t       ;; :ws/attachment key, as modelled here, is SELF-ASSERTED:\n   756\t       ;; whoever appends to the traffic medium chooses it. The\n   757\t       ;; transport's authoritativeness is the connection's, not the\n   758\t       ;; key's -- an unwrap seam and a trusted binding are owed work.\n   759\t       (let [service (buffer 16)\n   760\t             traffic (buffer 16)\n   761\t             {:keys [endpoint composition ended]}\n   762\t             (serving-fixture {:service service :traffic traffic})\n   763\t             accepted (ws/accept-connection! endpoint \"/lease/sketch\"\n   764\t                                             {:send! (fn [_])\n   765\t                                              :close! (fn [& _] nil)}\n   766\t                                             10)\n   767\t             attachment (:ws/attachment accepted)\n   768\t             writer (new-buffer 16)\n   769\t             ticks (buffer 8)\n   770\t             envelope-resolver (fn [_source fact]\n   771\t                                 (get fact :ws/attachment))\n   772\t             composed-judge\n   773\t             (lease/make-judge\n   774\t               {:cadence {:ms 5}\n   775\t                :units {:ms 1}\n   776\t                :tolerance {:ms 0}\n   777\t                :resolver envelope-resolver\n   778\t                :resolver-bindings #{:envelope-key}\n   779\t                :reclaim (fn [_subject]\n   780\t                           (= :dao.stream/ok\n   781\t                              (:dao.stream/outcome (ds/close! service))))\n   782\t                :writer writer\n   783\t                :self :grantor\n   784\t                :ticks [{:handle ticks :cursor (oldest-cursor ticks)}]\n   785\t                :media [{:handle traffic\n   786\t                         :cursor (oldest-cursor traffic)\n   787\t                         :source :traffic\n   788\t                         :medium (assoc standard-medium\n   789\t                                        :attribution :envelope-key)}]})\n   790\t             judge (atom (lease/author-grant\n   791\t                          (:judge composed-judge)\n   792\t                          (lease/grant :l1 :served-session attachment {:ms 10})))\n   793\t             judge-tick! (fn [ms]\n   794\t                           (append-ok! ticks (lease/tick {:ms ms})))\n   795\t             step-judge! (fn [] (reset! judge ((:step composed-judge) @judge)))]\n   796\t         (serving/start! composition)\n   797\t         (serving/step! composition 10)\n   798\t         (is (contains? (:sessions (serving/state composition)) attachment)\n   799\t             \"the session was accepted and is being served\")\n   800\t         (judge-tick! 1) (step-judge!)\n   801\t         ;; the holder's renewal rides its attachment envelope\n   802\t         (append-ok! traffic (assoc (lease/renewal :l1)\n   803\t                                    :ws/attachment attachment))\n   804\t         (judge-tick! 7) (step-judge!)\n   805\t         (is (= {:ms 7} (get-in @judge [:ledger :l1 :last-observation]))\n   806\t             \"the renewal counted through the real traffic medium\")\n   807\t         ;; silence past duration: the reclaim closes the served stream\n   808\t         (judge-tick! 18) (step-judge!)\n   809\t         (is (= [(lease/lapsed :l1 :silence)]\n   810\t                (rest (drain-values writer)))\n   811\t             \"the lease lapsed and was recorded\")\n   812\t         ;; one serving step drives the real close: the session retires\n   813\t         ;; and the WebSocket close runs\n   814\t         (serving/step! composition 19)\n   815\t         (is (empty? (:sessions (serving/state composition)))\n   816\t             \"the session was retired by the real close path\")\n   817\t         (is (= 1 (count @ended))\n   818\t             \"and the WebSocket close (:close-ended!) ran\")))))\n   819\t\n   820\t\n   821\t(deftest shared-work-claim-sketch-test\n   822\t  (testing \"sketch: the shared-work claim -- a composition-supplied\n   823\t            reclaim following call-close!'s idempotency\"\n   824\t    ;; A shared-work claim's reclaim is a composition-supplied procedure\n   825\t    ;; in call-close!'s idempotency shape (serving.cljc:38-43): the first\n   826\t    ;; invocation performs the release and reports success; later\n   827\t    ;; invocations see the work already released and report success again\n   828\t    ;; without acting twice -- which is what the judge's pending-retry\n   829\t    ;; path demands of every reclaim it may invoke more than once.\n   830\t    (let [work (atom {:released? false})\n   831\t          releases (atom 0)\n   832\t          reclaim (fn [_subject]\n   833\t                    (when-not (:released? @work)\n   834\t                      (swap! work assoc :released? true)\n   835\t                      (swap! releases inc))\n   836\t                    true)\n   837\t          system (composed {:reclaim reclaim})\n   838\t          system (-> system\n   839\t                     (update :judge lease/author-grant\n   840\t                             (lease/grant :l1 :shared-work :holder-a {:ms 10}))\n   841\t                     (tick! 1)\n   842\t                     step!)\n   843\t          ;; the writer fails before the record, so the lease sits\n   844\t          ;; pending and the next pass invokes the procedure AGAIN\n   845\t          system (-> system\n   846\t                     (update :judge assoc :writer\n   847\t                             (fake-writer :dao.stream/full))\n   848\t                     (tick! 12)\n   849\t                     step!)\n   850\t          system (-> system\n   851\t                     (update :judge assoc :writer (:writer system))\n   852\t                     (tick! 13)\n   853\t                     step!)]\n   854\t      (is (= 1 @releases)\n   855\t          \"two reclaim invocations, one release: the procedure is idempotent\")\n   856\t      (is (true? (:released? @work)))\n   857\t      (is (= [(lease/lapsed :l1 :silence)] (records system))\n   858\t          \"the retry recorded after the writer recovered\"))))\n   859\t\n   860\t\n   861\t;; C5/C6/C7 are pinned outside the runtime tests, as the plan's §7 states:\n   862\t;; no timer or clock call exists in src/cljc/dao/lease.cljc (the grep),\n   863\t;; dao.lease requires dao.stream and never the reverse (by construction),\n   864\t;; and no machinery renews on a holder's behalf (the holder section has no\n   865\t;; renewal-appending function at all -- appending is the control flow's\n   866\t;; own act, recorded through observe-renewal).\n","exit_code":0,"status":"completed"}}
