n_test.cljc:559:    ;; the lease's reclaim procedure is exactly the release discipline --\ntest/dao/lease_composition_test.cljc:562:          system (composed {:reclaim (fn [_subject]\ntest/dao/lease_composition_test.cljc:568:                     (update :judge lease/author-grant\ntest/dao/lease_composition_test.cljc:569:                             (lease/grant :l1 :forwarder :holder-a {:ms 10}))\ntest/dao/lease_composition_test.cljc:574:          \"the reclaim closed the session\")\ntest/dao/lease_composition_test.cljc:576:          \"and ceased the driving: the driver loop's condition is gone\")\ntest/dao/lease_composition_test.cljc:577:      (is (= [(lease/lapsed :l1 :silence)] (records system))))))\ntest/dao/lease_composition_test.cljc:598:   :dao.stream/identity \"lease-composition-sketch\"\ntest/dao/lease_composition_test.cljc:601:   :ws/path \"/lease/sketch\"})\ntest/dao/lease_composition_test.cljc:616:                   {:served {\"/lease/sketch\" served-descriptor}\ntest/dao/lease_composition_test.cljc:629:        composition (serving/make-serving\ntest/dao/lease_composition_test.cljc:631:                       :served {\"/lease/sketch\"\ntest/dao/lease_composition_test.cljc:661:  cross a boundary (C8); the remote holder observes the reclaim as the\ntest/dao/lease_composition_test.cljc:671:            (when (not= :dao.lease/lapsed\ntest/dao/lease_composition_test.cljc:672:                        (get (:dao.stream/value read) :dao.lease/status))\ntest/dao/lease_composition_test.cljc:690:    ;; directly on the lease fact -- is NOT the transport's. ws.cljc\ntest/dao/lease_composition_test.cljc:693:    ;; lease fact, and the envelope key, as modelled here, is\ntest/dao/lease_composition_test.cljc:706:                    :reclaim (fn [_subject]\ntest/dao/lease_composition_test.cljc:709:          grant (lease/grant :l1 :socket-handle :holder-a {:ms 10})\ntest/dao/lease_composition_test.cljc:711:                     (update :judge lease/author-grant grant)\ntest/dao/lease_composition_test.cljc:716:                     (fact! (assoc (lease/renewal :l1)\ntest/dao/lease_composition_test.cljc:725:            \"reclaim closed the served connection\")\ntest/dao/lease_composition_test.cljc:726:        (is (= [(lease/lapsed :l1 :silence)] (records system))\ntest/dao/lease_composition_test.cljc:735:               holder observes the reclaim as the connection's closing --\ntest/dao/lease_composition_test.cljc:740:   (deftest served-connection-real-close-path-sketch-test\ntest/dao/lease_composition_test.cljc:741:     (testing \"sketch (JVM): one real serving session, reclaimed through the\ntest/dao/lease_composition_test.cljc:745:       ;; stepping it. The lease's subject is the served stream; the\ntest/dao/lease_composition_test.cljc:746:       ;; reclaim is the real close -- close the served stream, then one\ntest/dao/lease_composition_test.cljc:754:       ;; unwraps :ws/value before the judge sees a lease fact, and the\ntest/dao/lease_composition_test.cljc:763:             accepted (ws/accept-connection! endpoint \"/lease/sketch\"\ntest/dao/lease_composition_test.cljc:773:             (lease/make-judge\ntest/dao/lease_composition_test.cljc:779:                :reclaim (fn [_subject]\ntest/dao/lease_composition_test.cljc:790:             judge (atom (lease/author-grant\ntest/dao/lease_composition_test.cljc:792:                          (lease/grant :l1 :served-session attachment {:ms 10})))\ntest/dao/lease_composition_test.cljc:794:                           (append-ok! ticks (lease/tick {:ms ms})))\ntest/dao/lease_composition_test.cljc:796:         (serving/start! composition)\ntest/dao/lease_composition_test.cljc:797:         (serving/step! composition 10)\ntest/dao/lease_composition_test.cljc:798:         (is (contains? (:sessions (serving/state composition)) attachment)\ntest/dao/lease_composition_test.cljc:802:         (append-ok! traffic (assoc (lease/renewal :l1)\ntest/dao/lease_composition_test.cljc:807:         ;; silence past duration: the reclaim closes the served stream\ntest/dao/lease_composition_test.cljc:809:         (is (= [(lease/lapsed :l1 :silence)]\ntest/dao/lease_composition_test.cljc:811:             \"the lease lapsed and was recorded\")\ntest/dao/lease_composition_test.cljc:814:         (serving/step! composition 19)\ntest/dao/lease_composition_test.cljc:815:         (is (empty? (:sessions (serving/state composition)))\ntest/dao/lease_composition_test.cljc:823:            reclaim following call-close!'s idempotency\"\ntest/dao/lease_composition_test.cljc:824:    ;; A shared-work claim's reclaim is a composition-supplied procedure\ntest/dao/lease_composition_test.cljc:826:    ;; invocation performs the release and reports success; later\ntest/dao/lease_composition_test.cljc:827:    ;; invocations see the work already released and report success again\ntest/dao/lease_composition_test.cljc:829:    ;; path demands of every reclaim it may invoke more than once.\ntest/dao/lease_composition_test.cljc:830:    (let [work (atom {:released? false})\ntest/dao/lease_composition_test.cljc:831:          releases (atom 0)\ntest/dao/lease_composition_test.cljc:832:          reclaim (fn [_subject]\ntest/dao/lease_composition_test.cljc:833:                    (when-not (:released? @work)\ntest/dao/lease_composition_test.cljc:834:                      (swap! work assoc :released? true)\ntest/dao/lease_composition_test.cljc:835:                      (swap! releases inc))\ntest/dao/lease_composition_test.cljc:837:          system (composed {:reclaim reclaim})\ntest/dao/lease_composition_test.cljc:839:                     (update :judge lease/author-grant\ntest/dao/lease_composition_test.cljc:840:                             (lease/grant :l1 :shared-work :holder-a {:ms 10}))\ntest/dao/lease_composition_test.cljc:843:          ;; the writer fails before the record, so the lease sits\ntest/dao/lease_composition_test.cljc:854:      (is (= 1 @releases)\ntest/dao/lease_composition_test.cljc:855:          \"two reclaim invocations, one release: the procedure is idempotent\")\ntest/dao/lease_composition_test.cljc:856:      (is (true? (:released? @work)))\ntest/dao/lease_composition_test.cljc:857:      (is (= [(lease/lapsed :l1 :silence)] (records system))\ntest/dao/lease_composition_test.cljc:862:;; no timer or clock call exists in src/cljc/dao/lease.cljc (the grep),\ntest/dao/lease_composition_test.cljc:863:;; dao.lease requires dao.stream and never the reverse (by construction),\n","exit_code":0,"status":"completed"}}
