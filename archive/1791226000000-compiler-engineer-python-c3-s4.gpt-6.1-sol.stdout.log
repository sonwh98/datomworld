    [py/all-in?
     (fn [c xs i]
       (let [x (get xs i :py/stop)]
         (if (= x :py/stop) true (if (py/contains c x) (py/all-in? c xs (+ i 1)) false))))]
    [py/seq-contains?
     (fn [xs x i]
       (let [y (get xs i :py/stop)]
         (if (= y :py/stop) false (if (py/eq y x) true (py/seq-contains? xs x (+ i 1))))))]
    [py/contains
     ;; `x in c`
     (fn [c x]
