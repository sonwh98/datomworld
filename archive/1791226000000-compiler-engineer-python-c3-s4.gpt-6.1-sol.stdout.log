                     (py/float (py/fpow (py/as-float a) e))
                     (py/int-result (integer/pow x e))))))))
         (py/type-error {:py/str "unsupported operand type for **"})))]
    [py/int-op
     (fn [op a b]
    [py/le (fn [a b] (py/compare <= a b))]
    [py/ge (fn [a b] (py/compare >= a b))]

    ;; ---------------------------------------------------------- equality
    [py/eq
     (fn [a b]
