                      (conj (cell/get py.rt/out) (py/snapshot-all items 0 [])))
           :py/None))]

    ;; ---------------------------------------------------------- module
    [py/run-module
     ;; the body receives the module namespace dict and the module's
     ;; `globals` builtin, a function object returning that dict
     (fn [body]
       (do (cell/set! py.rt/out [])
