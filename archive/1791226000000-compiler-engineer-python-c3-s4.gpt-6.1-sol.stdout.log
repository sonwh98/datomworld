(defn- data-contains?
  [coll k]
  (cond
    (or (nil? coll) (map? coll) (set? coll)) (contains? coll k)
    (vector? coll) (let [i (integral k)]
                     (boolean (and i (< -1 i (count coll)))))
    :else (wrong-type! 'contains? 0 :map-set-or-vector)))

