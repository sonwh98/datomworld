               (py/int-lit "10000000000000000")) 1]
     ['(integer/format (py/mul (py/int-lit "8000000000000000") true))
      "9223372036854775808"]
     ['(integer/format (py/neg (py/int-lit "10000000000000000")))
      "-18446744073709551616"]
