             (if (= (py/kind b) :tuple)
               (py/eq-items (get a :items) (get b :items) 0)
               false)
             (= a b)))))]
    [py/eq-objects
     (fn [a b]
       (if (= a b)
         true
         (let [ca (cell/get a)
               cb (cell/get b)]
           (if (= (get ca :py/type) :list)
             (if (= (get cb :py/type) :list)
               (py/eq-items (get ca :items) (get cb :items) 0)
               false)
             (if (= (get ca :py/type) :set)
               (if (= (get cb :py/type) :set)
