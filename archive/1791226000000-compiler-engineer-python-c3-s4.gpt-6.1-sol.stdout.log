  (e2e/every-vm=
    {:py/out ["3 [36893488147419103232]" "True True False"
              "IndexError" "IndexError" "[1, 2, 3] [3]"]
     :py/exception nil}
    (str "calls = 0\n"
         "a = [18446744073709551616]\n"
         "def index():\n"
