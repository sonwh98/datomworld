        measure(op, n)
bits = [0, 1, 0x000fffffffffffff, 0x0010000000000000,
        0x3fe0000000000000, 0x3ff0000000000000,
        0x4004000000000000, 0x400c000000000000,
        0x4340000000000000, 0x7fefffffffffffff,
        0x7ff0000000000000, 0x7ff8000000000000]
for raw in bits:
    for sign in (0, 1 << 63):
