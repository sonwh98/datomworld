{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '38,65p' src/cljc/yin/vm/ucf/custody.cljc; sed -n '66,90p' src/cljc/yin/vm/linker/sign.cljc; sed -n '245,282p' src/cljc/dao/space/dht.cljc; rg -n 'yin.vm.integer.host' src test; rg -n 'deftype|defrecord|:import' src/cljc/dao/data/btree.cljc src/cljc/dao/data/btree/storage.cljc src/cljc/dao/jing/cbor.cljc; sed -n '750,783p' docs/design/dao.stream.codec.md; rg -n 'J0a|J0b|J0c|J1' docs/design/*jolt*; sed -n '866,892p' docs/design/dao.stream.host-boundary.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '38,65p' src/cljc/yin/vm/ucf/custody.cljc; sed -n '66,90p' src/cljc/yin/vm/linker/sign.cljc; sed -n '245,282p' src/cljc/dao/space/dht.cljc; rg -n 'yin.vm.integer.host' src test; rg -n 'deftype|defrecord|:import' src/cljc/dao/data/btree.cljc src/cljc/dao/data/btree/storage.cljc src/cljc/dao/jing/cbor.cljc; sed -n '750,783p' docs/design/dao.stream.codec.md; rg -n 'J0a|J0b|J0c|J1' docs/design/*jolt*; sed -n '866,892p' docs/design/dao.stream.host-boundary.md\"","aggregated_output":"\n;; =============================================================================\n;; Occurrence\n;; =============================================================================\n\n(defn mint-occurrence\n  \"A fresh occurrence id, minted once at park.\"\n  []\n  (str (random-uuid)))\n\n\n(defn occurrence?\n  \"True for an occurrence id: a UUID string in lowercase hex.\"\n  [x]\n  (and (string? x)\n       (some? (re-matches\n                #\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\"\n                x))))\n\n\n;; =============================================================================\n;; Facts\n;; =============================================================================\n\n(defn offer\n  \"The authority's record of an admitted offer: snapshot variant\n   `address` of occurrence `o`, carried on `medium`, with the operation\n   `baseline` checkpoint/inspect derived from its bytes.\"\n     :cljs (crypt/stringToUtf8ByteArray s)))\n\n\n(defn- message\n  ([canonical] (message domain canonical))\n  ([prefix canonical]\n   (host-bytes (concat (utf8 prefix) canonical))))\n\n\n#?(:cljd nil :clj\n   (defn- jvm-pair\n     [seed]\n     (let [bytes (host-bytes (from-hex seed))\n           random (proxy [SecureRandom] []\n                    (nextBytes\n                      [dst]\n                      (System/arraycopy bytes 0 dst 0 (alength dst))))\n           ;; SunEC's generator draws the 32 seed bytes from this random.\n           ;; The RFC vectors guard that provider-specific dependency.\n           generator (KeyPairGenerator/getInstance \"Ed25519\" \"SunEC\")]\n       (.initialize generator (NamedParameterSpec. \"Ed25519\") random)\n       (.generateKeyPair generator))))\n\n\n(defn public-of\n   :sent 0\n   :retryable 0\n   :min-peers nil})\n\n\n(defn- node-over\n  \"The node composed from checked `opts` over the opened `local` store.\"\n  [opts local]\n  (let [{:keys [peers publish? bind-host bind-port max-inbound-bytes bind!]}\n        opts\n        [requests answers facts ticks traffic ledger] (repeatedly 6 ring)\n        socket? (boolean (seq peers))\n        composition (cond-> {:local local\n                             :requests requests\n                             :answers answers\n                             :facts facts\n                             :ticks ticks\n                             ::dht/id (dht/bytes->hex\n                                        (secure-random-bytes dht/id-length))\n                             ::dht/publish? publish?\n                             ::dht/bootstrap (vec peers)\n                             ::dht/bind-host bind-host}\n                      socket? (assoc :traffic traffic\n                                     ::dht/secret (secure-random-bytes\n                                                    secret-length)\n                                     ::dht/max-inbound-bytes max-inbound-bytes))\n        seam (when socket?\n               (bind! {:identity (str \"dao.space.dht:\"\n                                      (subs (::dht/id composition) 0 16))\n                       :deposit traffic\n                       :bind-host bind-host\n                       :bind-port bind-port\n                       :max-bytes (::dht/max-datagram dht/defaults)}))\n        ;; the DHT handle's put checks (address, oversize) over :local; its\n        ;; own replicate request goes to a sink, since the node's step\n        ;; owns every request (yin.vm.linker.dht.md 5.5)\n        front (dht/store-handle\n                {:local local\ntest/yang/python/antlr/int_literal_test.cljc:33:            [yin.vm.integer.host :as host]\ntest/yang/python/antlr/int_heap_test.cljc:20:            [yin.vm.integer.host :as integer-host]\ntest/yang/python/antlr/int_ops_test.cljc:18:            [yin.vm.integer.host :as integer-host]\nsrc/cljc/yin/vm/data.cljc:41:    [yin.vm.integer.host :as integer-host]\nsrc/cljc/yin/vm/integer/host.cljc:1:(ns yin.vm.integer.host\nsrc/cljc/yin/vm.cljc:32:            [yin.vm.integer.host :as integer-host]\nsrc/cljc/yin/vm/engine.cljc:38:            [yin.vm.integer.host :as integer-host]\nsrc/cljc/yin/vm/integer.cljc:14:   (`yin.vm.integer.host`); every integer result is in its one canonical\nsrc/cljc/yin/vm/integer.cljc:101:    [yin.vm.integer.host :as host]\nsrc/cljc/yin/vm/values.cljc:30:            [yin.vm.integer.host :as integer-host]))\nsrc/cljc/dao/jing/cbor.cljc:61:  #?@(:cljd [(:import\nsrc/cljc/dao/jing/cbor.cljc:64:      :clj [(:import\nsrc/cljc/dao/jing/cbor.cljc:342:   (deftype Float64\nsrc/cljc/dao/jing/cbor.cljc:382:(deftype Rational\nsrc/cljc/dao/jing/cbor.cljc:414:   (deftype Decimal\nsrc/cljc/dao/jing/cbor.cljc:430:   (deftype Decimal\nsrc/cljc/dao/data/btree/storage.cljc:43:(deftype KVStorage\nsrc/cljc/dao/data/btree/storage.cljc:105:(deftype HydrationStorage\nsrc/cljc/dao/data/btree.cljc:47:(deftype Settings\nsrc/cljc/dao/data/btree.cljc:93:#?(:cljd (deftype EditBox\nsrc/cljc/dao/data/btree.cljc:96:   :cljs (deftype EditBox\nsrc/cljc/dao/data/btree.cljc:191:(deftype TestRef\nsrc/cljc/dao/data/btree.cljc:321:;; in this namespace (`Leaf`'s deftype fails with \"Unable to resolve\nsrc/cljc/dao/data/btree.cljc:332:;; fresh instance per step, since deftype CONSTRUCTORS aren't arity-capped\nsrc/cljc/dao/data/btree.cljc:363:(deftype StitchAt\nsrc/cljc/dao/data/btree.cljc:484:(deftype Leaf\nsrc/cljc/dao/data/btree.cljc:642: