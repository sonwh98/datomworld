t` holds, or ::unreadable: a trailing form, a\n\nyin/repl/query.cljc\n452:                                                  (:stage failure)))\n453:                                        \")\"))\n454:                       \"; (reset) rebuilds them\")\n455:                  nil)))))\n456: \n457: \n458: (defn- byte-length\n459:   [bs]\n460:   #?(:cljd (.-length ^Uint8List bs)\n461:      :default (alength bs)))\n462: \n463: \n464: (defn- encoded-size\n465:   \"The canonical CBOR size of `x`, or nil when `x` is not portable data.\"\n466:   [x]\n467:   (try\n\nyin/vm.cljc\n390:            (pure '< < [1 2 :variadic])\n391:            (pure '> > [1 2 :variadic])\n392:            (pure '<= <= [1 2 :variadic])\n393:            (pure '>= >= [1 2 :variadic])\n394:            (pure 'not not [1])\n395:            (pure 'nil? nil? [1])\n396:            (pure 'empty? empty? [1])\n397:            (pure 'first first [1])\n398:            (pure 'rest (fn [a] (vec (rest a))) [1])\n399:            (pure 'conj conj [1 2 :variadic])\n400:            (pure 'assoc assoc [3 :variadic])\n401:            (pure 'get get [2 3])\n402:            (pure 'vec vec [1])\n403:            (pure 'bytes->str\n404:                  #?(:clj (fn\n405:                            ([b] (String. ^bytes b \"UTF-8\"))\n406:                            ([b enc] (String. ^bytes b ^String enc)))\n407:                     :cljs (fn [b] (.apply js/String.fromCharCode nil b))\n408:                     :cljd (fn [b] (dart:core/String.fromCharCodes b)))\n409:                  [1 2])\n410:            ['require (primitive-entry\n411:                        'require\n412:                        (fn [spec]\n413:                          (let [ns-sym (if (vector? spec) (first spec) spec)]\n414:                            (effect/make :module/require {:module ns-sym})))\n415:                        :effectful [1] #{:module/require})]\n416:            ['try-require (primitive-entry\n417:                            'try-require\n418:                            (fn [spec]\n419:                              (let [ns-sym (if (vector? spec) (first spec) spec)]\n420:                                (effect/make :module/try-require\n\nyin/vm/debruijn_register_code.cljc\n430:             (when-not (= (inc (count (get opcode-table (mnemonic-of t))))\n431:                          (count t))\n432:               (tuple-defect :arity pc))))\n433:         (range (count instructions))))\n434: \n435: \n436: (defn- nonneg-int?\n437:   [x]\n438:   (and (integer? x) (not (neg? x))\n439:        #?(:cljs (js/Number.isSafeInteger x) :default true)))\n440: \n441: \n442: (def ^:private operand-kind-checks\n443:   {:reg nonneg-int?,\n444:    :uint nonneg-int?,\n445:    :regs (fn [x] (and (vector? x) (every? nonneg-int? x))),\n446:    :str string?,\n447:    :kw keyword?,\n448:    :sym symbol?,\n449:    :data vm/plain-data?,\n\nyin/vm/debruijn_register_effects.cljc\n122: \n123: ;; =============================================================================\n124: ;; 3. Continuation payload defect validation (design section 5.2.2)\n125: ;; =============================================================================\n126: \n127: (defn- nonneg-int?\n128:   [x]\n129:   (and (integer? x) (not (neg? x))\n130:        #?(:cljs (js/Number.isSafeInteger x) :default true)))\n131: \n132: \n133: (defn- ascending-distinct?\n134:   [xs]\n135:   (every? (fn [[a b]] (< a b)) (partition 2 1 xs)))\n136: \n137: \n138: (defn- body-of-pc\n139:   [{:keys [bodies]} pc]\n140:   (some (fn [[i {:keys [start end]}]]\n\nyin/vm/engine.cljc\n923:               (vector? x) (mapv encode x)\n924:               (set? x) (into #{} (map encode) x)\n925:               (seq? x) (apply list (map encode x))\n926:               (fn? x) (encode-primitive vm x)\n927:               :else (non-portable! :host-object\n928:                                    {:yin.k/hint\n929:                                     #?(:cljd (str (.-runtimeType x))\n930:                                        :default (str (type x)))})))]\n931:     encode))\n932: \n933: \n934: (defn- decoder\n935:   \"UCF 7.5.1's `decode` into `vm`'s coordinates: every map is a marker, a\n\nyin/vm/linker/closure.cljc\n23:   \"The derivation formats a manifest names, in walk order, each with its\n24:    format record (for the image's identity check).\"\n25:   [[:yin.semantic/code linker/semantic-format]\n26:    [:yin.debruijn.code linker/stack-format]\n27:    [:yin.debruijn.register linker/register-format]])\n28: \n29: \n30: (defn- byte-count\n31:   [bs]\n32:   #?(:cljd (.-length ^typed/Uint8List bs)\n33:      :clj (alength ^bytes bs)\n34:      :cljs (.-length bs)))\n35: \n36: \n37: (defn- stop\n38:   \"`st` ended by the terminal `outcome`.\"\n39:   [st outcome]\n40:   (assoc st :stop outcome))\n41: \n42: \n\nyin/vm/ucf/rows.cljc\n275:             (work! ctx total))\n276:         (let [s (first stack) stack (rest stack)]\n277:           (if (empty? s)\n278:             (recur stack total steps)\n279:             (let [x (first s)\n280:                   stack (cons (rest s) stack)\n281:                   total (+ total (cond\n282:                                    (cbor/byte-payload? x) (+ 16 #?(:cljd (.-length x) :default (alength x)))\n283:                                    (string? x) (+ 128 (* 4 (count x)))\n284:                                    (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n285:                                    :else 128))]\n286:               (if (> total remaining)\n287:                 (do (swap! counter update :estimator-steps (fnil + 0) (inc steps))\n288:                     (work! ctx total))\n289:                 (recur (cond->> stack\n290:                          (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n291:                          (meta x) (cons (list (meta x))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '550,690p' docs/design/dao.stream.host-boundary.md; sed -n '755,792p' docs/design/dao.stream.host-boundary.md; sed -n '250,295p' .claude/worktrees/host-h0/test/dao/host/gate_test.clj; sed -n '440,560p' .claude/worktrees/host-h0/test/dao/host/gate_test.clj; sed -n '106,174p' .claude/worktrees/host-h0/src/dev/host_boundary/closure.clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '550,690p' docs/design/dao.stream.host-boundary.md; sed -n '755,792p' docs/design/dao.stream.host-boundary.md; sed -n '250,295p' .claude/worktrees/host-h0/test/dao/host/gate_test.clj; sed -n '440,560p' .claude/worktrees/host-h0/test/dao/host/gate_test.clj; sed -n '106,174p' .claude/worktrees/host-h0/src/dev/host_boundary/closure.clj\"","aggregated_output":"\n`dao.host.*` (OQ2 adopted) is a namespace family whose files contain only\nreader-conditional entries and docstrings stating each entry's law, kind (P\npure, M mutating per §2.4) and oracle. Table A is the profile (76 entries);\ntable B the portable code replacing host libraries; table C the runtime\nprerequisites.\n\n**Table A: profile entries.**\n\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| Namespace          | Entries (consolidated from, V)                                                                       | N   | Slice |\n+====================+======================================================================================================+=====+=======+\n| `dao.host.integer` | From `yin.vm.integer.host` (all 25, P): `big-carrier?`, `exact-integer?`, `safe-native?`,            | 28  | H1    |\n|                    | `host-float?`, `nan-float?`, `infinite-float?`, `promote`, `from-native`, `demote`, `to-native`,     |     |       |\n|                    | `native->double`, `trunc-native`, `add`, `sub`, `mul`, `quot-trunc`, `rem-trunc`, `compare-big`,     |     |       |\n|                    | `bit-and-big`, `bit-or-big`, `bit-xor-big`, `shift-left-big`, `shift-right-big`,                     |     |       |\n|                    | `magnitude-bit-length`, `to-radix-string`; from `cbor.cljc:112-254` (P): `parse-decimal` (digit      |     |       |\n|                    | string to big, refuses otherwise), `gcd`, `magnitude-bytes` (fresh bytes). `debruijn_code.cljc:315`  |     |       |\n|                    | reads `big-carrier?` (H2).                                                                           |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.host.float`   | P: `float64->bits` (16 hex, big-endian), `bits->float64`, `finite?`, `integral?`, `fields` (sign,    | 5   | H1    |\n|                    | biased exponent, fraction big) from `cbor.cljc:525-560`, `debruijn.cljc:855-885`,                    |     |       |\n|                    | `debruijn_code.cljc:232-242` (little-endian hex becomes a portable byte reversal over                |     |       |\n|                    | `float64->bits`, H2), `data.cljc:77-92`.                                                             |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.host.number`  | The Jing numeric carriers and their host construction and access, from `cbor.cljc:342-460,483-632`   | 10  | H1    |\n|                    | (P): `float64-of`, `float-value`, `decimal?`, `decimal-of` (exponent, mantissa; refuses outside the  |     |       |\n|                    | JVM scale window, `:552-574`), `decimal-exponent`, `decimal-mantissa`, `ratio?`, `ratio-of`          |     |       |\n|                    | (reduced, sign on numerator, zero denominator refused), `ratio-numerator`, `ratio-denominator`; the  |     |       |\n|                    | `Float64`, `Rational`, `Decimal` deftypes move with them (table C laws).                             |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.host.bytes`   | P: `bytes?`, `alloc` (fresh, zeroed), `length`, `get`, `slice` (fresh), `equal?`, `from-vector`      | 10  | H1    |\n|                    | (fresh), `to-vector`; M: `set!`, `copy!` (memmove). From `chunks.cljc:6-32`,                         |     |       |\n|                    | `jing/dht.cljc:100-121`, `linker.cljc:1232`, `sign.cljc:55-59`, `boring.cljc:46-51`,                 |     |       |\n|                    | `datagram.cljc:63-66`, `debruijn.cljc:167`. (`codec.cljc:45` reads it after the codec track's C4,    |     |       |\n|                    | §8.3.)                                                                                               |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.host.text`    | P: `unit-count`, `code-unit`, `units->string`, `utf8-encode` (fresh bytes; refuses an unpaired       | 6   | H1    |\n|                    | surrogate), `utf8-decode` (refuses invalid sequences; never substitutes U+FFFD), `nfc` (Unicode      |     |       |\n|                    | 16.0) from `data.cljc:119-173`, `debruijn.cljc:241,310-321`, `jing.cljc:65-71,131-135`,              |     |       |\n|                    | `sign.cljc:62-66`.                                                                                   |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.host.hash`    | P: `blake3-bytes`, `sha256-bytes` (`jing.cljc:59-135`; the string forms become portable over         | 2   | H3    |\n|                    | `text`).                                                                                             |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.host.sign`    | P: `keypair-from-seed` (`sign.cljc:75-104`, seed replay), `sign`, `verify`. `generate` (fresh        | 3   | H3    |\n|                    | entropy, `:114-124`) stays in `yin.vm.linker.sign` until the deferred design moves it.               |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n| `dao.data.arrays`  | In place (OQ2). P: `anew` (fresh), `aget`, `alength`, `aclone` (fresh), `asub` (fresh), `aconcat`    | 12  | H2    |\n| (member by         | (fresh), `ainsert-at` (fresh), `aremove-at` (fresh), `from-coll` (fresh); M: `aset`, `acopy`         |     |       |\n| reference)         | (memmove), `asort` (stable; `parallelSort` replaced). `arrays.cljc:28-182`.                          |     |       |\n+--------------------+------------------------------------------------------------------------------------------------------+-----+-------+\n\n**Table B: portable over the profile, no host arm (P).** Base64 (replaces\n`goog.crypt.base64`, `dart:convert`, the JVM codec; **a replacement, not code\nmotion**; oracle V `test/dao/stream/base64_test.cljc`, 3 deftests:\n`rfc-4648-round-trips`, `decode-is-total-and-strict`, `every-length-round-trips`);\nthe Jing CBOR writer (replaces Boring and the Dart `cbor` package on the\ncontent path only, OQ4; a replacement; oracle table D); hex; `chunks/split`,\n`chunks/absorb`.\n\n**Table C: runtime prerequisites (documented and verified by existing\nsuites; not profile entries; not a boundary).**\n\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n| Prerequisite                     | Where, and the law a port must meet (V)                                                        | Slice   |\n+==================================+================================================================================================+=========+\n| `deftype` with per-host          | `values.cljc:39-119`: `Closure`/`Continuation` equal iff owner and payload equal; hash of      | H1 docs |\n| equality, hashing and printing   | `[:tag owner payload]`; print the marker text. `cbor.cljc:342-460`: `Float64` equal by bits    |         |\n|                                  | with NaN equal to NaN (`:365-367`); `Rational`, `Decimal` equal by fields; hashes at           |         |\n|                                  | `:372-444`.                                                                                    |         |\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n| Atomic flag                      | `btree.cljc:87-119`: transient ownership token readable across threads.                        | none    |\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n| Weak and soft references         | `btree.cljc:182-245`; default `:soft` on the JVM, `:strong` on JS and Dart (`:39-44`). A host  | none    |\n|                                  | without them declares `:strong`; correctness is unchanged, retention differs.                  |         |\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n| `locking`, atoms, volatiles      | Five `locking` sites (§3.1); single-owner discipline elsewhere.                                | none    |\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n| Host promise type                | `btree/storage.cljc:218-227`: deferred (§9.1).                                                 | defer   |\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n| Dialect syntax                   | §3.3.                                                                                          | H0      |\n+----------------------------------+------------------------------------------------------------------------------------------------+---------+\n\nLayering: `dao.host.*` requires nothing in the repo; `dao` never requires\n`yin`. Consumers after H2: `dao.jing`, `dao.jing.cbor`, `yin.vm.integer`,\n`yin.vm.data`, `yin.vm.values`, `yin.vm.engine`, `yin.vm`, `yin.vm.debruijn`,\n`yin.vm.debruijn-code`, `dao.stream.chunks`, `dao.jing.dht`, `yin.vm.linker`,\n`yin.vm.linker.sign`, `dao.stream.datagram`, `dao.stream.base64`, and the\nthree Python integer tests.\n\n### 4.3 Oracle coverage matrix (table D)\n\nEntry to exact file and case. V = the case exists today and exercises the\nbehaviour through its present namespace; P = proposed, written in the slice\nnamed. After H1 every V case is additionally run against `dao.host.*`\ndirectly by `dao.host.conformance-test` (P), which requires the new\nnamespaces and re-asserts each row below through them (review A6).\n\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| Entries                         | File and case                                                                                           | V/P |\n+=================================+=========================================================================================================+=====+\n| integer: carriers, promote,     | `test/yin/vm/integer_test.cljc` (25 deftests): `carrier-boundary-test`, `compare-test`,                 | V   |\n| demote, add, sub, mul, quot,    | `division-test`, `bits-test`, `pow-test`, `parse-format-test`, `digit-limit-test`, `bit-limit-test`,    |     |\n| rem, compare, bit ops, shifts,  | `fast-path-edge- test`, `fast-path-respects-the-bit-limit-test`, `integer?-test`,                       |     |\n| bit length, radix               | `kind-of-and-number?-test`; `integer_v3_fixtures.cljc` (data).                                          |     |\n|                                 | `test/yang/python/antlr/int_contract_test.cljc`: `integer-rows- recompute-on-this-host`,                |     |\n|                                 | `canonical-widths-at-the-boundaries`, `text-round-trips-through-the-module` against                     |     |\n|                                 | `test/resources/yang/python/int-contract-v1.txt` (CPython-generated).                                   |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| integer: `parse-decimal`,       | `test/dao/jing/cbor_conformance_test.cljc`: `the-resource-bytes-are-the-frozen-bytes`, `produced-bytes- | V   |\n| `gcd`, `magnitude-bytes`        | pass-the-raw-cbor-inspection`, `injectivity-and-groups-hold-on-the-bytes-this-host-produced` (the       |     |\n|                                 | corpus's tag 2/3, ratio and decimal cases); `cbor_fixtures_test.cljc`: `recorded-blake3-is-the-digest-  |     |\n|                                 | of-the-bytes`, `retained-distinctions-differ-in-bytes-and-address`.                                     |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| float: bits, fields, finite,    | `integer_test.cljc`: `float-fixture-test`, `float-named-cases-test`, `float-text-named-cases-test`,     | V   |\n| integral                        | `float-refusals-test`; `int_contract_test.cljc`: `float-rows-recompute-on-this-host`; `data_test.cljc`: |     |\n|                                 | `float-seam-test`; the corpus float cases (NaN `7ff8...`, `-0.0`) through the conformance test;         |     |\n|                                 | `debruijn_code_test.cljc` (26 deftests) scalar cases for the little-endian hex.                         |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| number: decimal and ratio       | The corpus decimal and ratio cases through `cbor_conformance_test.cljc`; `cbor_test.cljc` (21 deftests) | V   |\n| construction, access, carriers  | decimal window and zero-denominator refusals; `cbor_fixtures_test.cljc`: `equivalence-                  |     |\n|                                 | groups-share-bytes`, `every-required-refusal-class-occurs`.                                             |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| bytes: all ten                  | `dao.host.bytes-test`: round trip, slice freshness, `copy!` overlap (memmove) both directions, out-of-  | P   |\n|                                 | range refusal with **no partial write** (target byte-identical after a refused `set!`/`copy!`),         |     |\n|                                 | `equal?` on equal and unequal content, and the P-entry argument-immutability property (§2.4); H1.       |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| text: code units,               | `data_test.cljc`: `non-bmp-code-points-test`, `substring-char-at-test`, `code-points-str-compare-test`; | V   |\n| `units->string`                 | the corpus `unpaired-surrogate` refusals through the conformance test.                                  |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| text: `utf8-encode`,            | `dao.host.text-test`: RFC 3629 valid and invalid sequences (overlong, surrogate code points,            | P   |\n| `utf8-decode`                   | truncated), each asserted as a **direct refusal** (never a substituted character); unpaired-surrogate   |     |\n|                                 | encode refusal; the decode cases cross-checked against the corpus `invalid-utf8` class; H1. In H3,      |     |\n|                                 | direct refusal tests on `dao.jing/digest-string` and `sign`'s message assembly (the consumers).         |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| text: `nfc`                     | `test/yin/vm/debruijn_test.cljc` (80 deftests) example cases (V, examples only); `dao.host.text-test`:  | V+P |\n|                                 | a pinned subset of Unicode 16.0 `NormalizationTest.txt` (every part-1 line plus the Hangul and          |     |\n|                                 | composition exclusion rows); written in H1.                                                             |     |\n+---------------------------------+---------------------------------------------------------------------------------------------------------+-----+\n| hash: `blake3-bytes`,           | `test/dao/jing/hash_registry_contract_test.cljc` (15 deftests): `blake3-official-and-utf8-vector-       | V+P |\nExpand, migrate, contract. Each slice lands alone under the quick tier on\nthree lanes with recorded test and assertion counts; \"unchanged\" means equal\ncounts plus any added test named. The slow tier runs once after H4.\n\n+-------+--------+--------------------------------------------------------------------------------+-------------------------------------------------------------------+\n| Slice | Phase  | Change                                                                         | Falsifiable acceptance                                            |\n+=======+========+================================================================================+===================================================================+\n| H0    | freeze | No `src/` change. (a) `src/dev/host_boundary/closure.clj` (over                | Gate passes on the current tree; the committed closure output     |\n|       |        | `clojure.tools.namespace` parsing) and its output                              | lists exactly 142/140/141 files (§3.1) and the slice report       |\n|       |        | `docs/design/host-boundary/closure-{clj,cljs,cljd}.edn`, each file tagged with | records agreement with an independent traversal; the gate fails   |\n|       |        | its §3.1 class; (b) the gate test `dao.host.gate-test` over the closure with   | on one injected `#?(:clj` in a file outside list 1 and on one     |\n|       |        | **list 1** (files permitted non-exempt host arms, §8.1) and **list 2**         | injected `(random-uuid)` outside list 2 (two negative tests), and |\n|       |        | (resolved effect calls permitted: the §3.2 sites, plus the callers of M        | fails distinctly when it reads zero files (scan failure is not    |\n|       |        | entries named in §2.4), exempting §3.3 patterns; the gate scans files          | zero matches). Counts recorded.                                   |\n|       |        | recursively and fails if it read none; (c) per-lane counts; (d) the corpus     |                                                                   |\n|       |        | hash set.                                                                      |                                                                   |\n+-------+--------+--------------------------------------------------------------------------------+-------------------------------------------------------------------+\n| H1    | expand | Create `dao.host.integer`, `.float`, `.number`, `.bytes`, `.text` with today's | Green; counts unchanged plus the named new tests; the new tests   |\n|       |        | arms moved verbatim where the law is today's behaviour, and **with the new     | require and call `dao.host.*` directly; corpus bytes identical;   |\n|       |        | laws where it is not**: `utf8-encode` refuses an unpaired surrogate (today's   | the P-entry argument-immutability property test and the M-entry   |\n|       |        | helpers substitute: JVM `getBytes` emits `?`, `goog.crypt` and `dart:convert`  | prevalidation test pass on three lanes; `utf8-encode` direct      |\n|       |        | emit U+FFFD, `jing.cljc:66,69,71,132-135`, `sign.cljc:62-66`, R for the        | refusal test and `utf8-decode` strict tests pass. List 1 grows by |\n|       |        | library behaviour); `utf8-decode` is extracted from the already strict         | five files.                                                       |\n|       |        | `cbor.cljc:1240-1271` (V). The `Float64`/`Rational`/`Decimal` deftypes move    |                                                                   |\n|       |        | with their protocol blocks. Tests: `dao.host.conformance-test`,                |                                                                   |\n|       |        | `dao.host.bytes-test`, `dao.host.text-test` (table D). Table C laws written    |                                                                   |\n|       |        | into the docstrings of `values.cljc` and the moved carriers. No consumer       |                                                                   |\n|       |        | changes, so no behaviour change is observable yet.                             |                                                                   |\n+-------+--------+--------------------------------------------------------------------------------+-------------------------------------------------------------------+\n| H2    | migr.  | Every consumer moves: `yin/vm.cljc:32`, `yin/vm/engine.cljc:38`,               | Green; counts unchanged plus the `asort` stability, `acopy`       |\n|       |        | `yin/vm/values.cljc:30`, `yin/vm/data.cljc:41`, `yin/vm/integer.cljc:101`,     | overlap and `acopy`/`aset` **no-partial-write** tests; corpus     |\n|       |        | `test/yang/python/antlr/{int_heap,int_literal,int_ops}_test.cljc` (V);         | identical. **Pre-deletion gate**: the H0 closure tool, reading    |\n|       |        | `dao.jing.cbor` drops `:106-254`, `:342-460`, `:483-632` for `dao.host.*`;     | `ns` forms (not text), reports `yin.vm.integer.host` required by  |\n|       |        | `debruijn_code.cljc:232-242,315`, `debruijn.cljc:167,241,310-321,855-885`,     | no file in `src` or `test`; the only textual mention left is its  |\n|       |        | `chunks`, `jing.dht`, `linker:1232`, `sign:55-66`, `datagram:63-66` read       | own file (the docstring at `integer.cljc:14` is updated in H2).   |\n|       |        | `bytes`/`text`/`float`; `dao.data.arrays` gains the stable sort and            | **Post-deletion gate**: the file is absent and the tool reports   |\n|       |        | **prevalidation before any write** in `acopy` on JS and Dart (a behaviour      | no require of it; a tool failure is distinct from \"none found\".   |\n|       |        | change, §2.4); the M-entry callers of §2.4 are audited for the freeze rule.    | **Host-library gate (§8.2), built in this slice** as the library  |\n;; ---------------------------------------------------------------------------\n;; Resolved effect calls (§3.2 kinds, §2.4 M entries)\n;; ---------------------------------------------------------------------------\n\n(def core-ns #{nil \"clojure.core\" \"cljs.core\" \"cljd.core\"})\n\n\n(defn effect-kind\n  \"The §3.2 kind of a symbol that names a host effect, or nil. core? is\n   false when an unqualified name is shadowed in its file.\"\n  [sym core?]\n  (let [n (name sym)\n        q (namespace sym)\n        core (and (contains? core-ns q) (or q core?))]\n    (cond\n      (and core (= n \"random-uuid\")) :random-uuid\n      (and core (#{\"rand\" \"rand-int\" \"rand-nth\" \"shuffle\" \"random-sample\"} n)) :rand\n      (or (str/includes? n \"SecureRandom\")\n          (= n \"Random.secure\")\n          (= n \"randomUUID\")\n          (and (= q \"js\") (str/starts-with? n \"crypto\"))\n          (#{\"getRandomValues\" \"randomBytes\" \"generateKey\"} n)) :secure-random\n      (and core (= n \"gensym\")) :gensym\n      (or (and (#{\"System\" \"java.lang.System\"} q) (#{\"currentTimeMillis\" \"nanoTime\"} n))\n          (and (= q \"js\") (or (str/starts-with? n \"Date\") (str/starts-with? n \"performance\")))\n          (str/starts-with? n \"DateTime.now\")\n          (and q (str/ends-with? q \"Instant\") (= n \"now\"))) :clock\n      (or (and (#{\"System\" \"java.lang.System\"} q) (#{\"getenv\" \"getProperty\" \"getProperties\"} n))\n          (and (= q \"js\") (str/starts-with? n \"process\"))\n          (str/starts-with? n \"Platform.\")) :ambient\n      (or (and core (#{\"println\" \"print\" \"prn\" \"pr\" \"printf\" \"newline\"} n))\n          (and (= q \"js\") (str/starts-with? n \"console\"))) :print\n      (or (and (= q \"js\") (#{\"setTimeout\" \"setInterval\" \"setImmediate\" \"queueMicrotask\"} n))\n          (str/starts-with? n \"Timer\")\n          (and (#{\"Thread\" \"java.lang.Thread\"} q) (= n \"sleep\"))\n          (str/starts-with? n \"Future.delayed\")) :timer\n      :else nil)))\n\n\n(def m-entry-nss\n  \"The namespaces holding §2.4's M entries, now and after H1.\"\n  '#{dao.data.arrays dao.host.bytes})\n\n\n(def m-entry-names #{\"aset\" \"acopy\" \"asort\" \"set!\" \"copy!\"})\n\n;; ---------------------------------------------------------------------------\n;; List 1 and list 2\n;; ---------------------------------------------------------------------------\n\n(def list-1-categories\n  \"The §8.1 rows (r7), each with what the row means and the slice that\n   clears its files from list 1 (:stays: the arms are retained by design).\"\n  {:migration-source {:row \"H1-H4 migration sources (incl. H0's profile consumers)\"\n                      :clears #{\"H2\" \"H3\" \"H4\" :stays}}\n   :profile {:row \"Profile: the arms belong here by design\" :clears #{:stays}}\n   :runtime-prereq {:row \"Retained runtime prerequisites (table C) and display\"\n                    :clears #{:stays}}\n   :codec-track {:row \"Codec-track files, untouched by this track\" :clears #{:stays}}\n   :dialect-arm {:row \"Dialect arms (H0 finding, retained): display text or the dialect's EDN reader\"\n                 :clears #{:stays}}\n   :seam-driver {:row \"Seams and driver: lane-specific files, the selector, the driver\"\n                 :clears #{:stays}}\n   :deferred-scope {:row \"Deferred-scope files (§9)\" :clears #{:stays}}})\n\n\n(defn- entry\n  ([category clears] {:category category :clears clears})\n  ([category clears reason] {:category category :clears clears :reason reason}))\n\n\n(def list-1\n  \"The closure files permitted non-exempt host arms (§8.1 r7), each with\n   its row, the slice that clears it, and for H0's 16 findings the site\n   and reason. Generated from the H0 tree by the gate; r7 categorised the\n   16 files H0 first found unlisted (no file is uncategorised).\"\n  {;; H1-H4 migration sources\n   \"src/cljc/yin/vm/integer/host.cljc\" (entry :migration-source \"H2\" \"deleted in H2\")\n   \"src/cljc/dao/jing/cbor.cljc\" (entry :migration-source \"H2\" \"helpers H2, writer H4\")\n   \"src/cljc/dao/jing/cbor/boring.cljc\" (entry :migration-source \"H4\" \"deleted in H4\")\n   \"src/cljd/dao/jing/cbor/cljd.cljd\" (entry :migration-source \"H4\" \"Dart Jing writer, deleted in H4\")\n   \"src/cljc/dao/jing.cljc\" (entry :migration-source \"H3\" \"hashes\")\n   \"src/cljc/yin/vm/linker/sign.cljc\" (entry :migration-source :stays \"H3 migrates; generate stays (deferred entropy)\")\n   \"src/cljc/yin/vm/debruijn.cljc\" (entry :migration-source \"H2\")\n   \"src/cljc/yin/vm/debruijn_code.cljc\" (entry :migration-source \"H2\")\n   \"src/cljc/yin/vm/data.cljc\" (entry :migration-source \"H2\")\n   \"src/cljc/yin/vm/values.cljc\" (entry :migration-source \"H2\" \"table C blocks stay as exempt protocol syntax\")\n   \"src/cljc/dao/stream/chunks.cljc\" (entry :migration-source \"H2\")\n   \"src/cljc/dao/stream/base64.cljc\" (entry :migration-source \"H3\" \"base64 made portable\")\n   \"src/cljc/dao/jing/dht.cljc\" (entry :migration-source \"H2\")\n   \"src/cljc/yin/vm/linker.cljc\" (entry :migration-source \"H2\" \":1232\")\n   \"src/cljc/dao/stream/datagram.cljc\" (entry :migration-source \"H2\" \"bytes arms :63-66 only\")\n   ;; H0 finding, profile consumers (r7 §3.1, §8.1 first row): H2 migrates\n   \"src/cljc/yin/vm.cljc\" (entry :migration-source \"H2\" \":404 bytes->str; named behaviour change: strict UTF-8 on all hosts (JS/Dart decode byte-as-char-code today)\")\n   \"src/cljc/yang/php.cljc\" (entry :migration-source \"H2\" \":95,98 number parsing; named behaviour change: js/parseInt loses precision above 2^53, becomes exact\")\n   \"src/cljc/dao/space/index.cljc\" (entry :migration-source \"H2\" \":78 number fast path\")\n   \"src/cljc/yin/repl/query.cljc\" (entry :migration-source \"H2\" \":460 byte length\")\n   \"src/cljc/yin/vm/linker/closure.cljc\" (entry :migration-source \"H2\" \":32 byte length\")\n   \"src/cljc/yin/vm/ucf/rows.cljc\" (entry :migration-source \"H2\" \":282 byte length\")\n   \"src/cljc/yin/vm/debruijn_register_code.cljc\" (entry :migration-source \"H2\" \":439 safe-integer check\")\n   \"src/cljc/yin/vm/debruijn_register_effects.cljc\" (entry :migration-source \"H2\" \":130 safe-integer check\")\n   \"src/cljc/yang/antlr/packet.cljc\" (entry :migration-source \"H2\" \":67 code points (portable code-points moves to table B)\")\n   ;; Profile\n   \"src/cljc/dao/data/arrays.cljc\" (entry :profile :stays)\n   ;; Retained runtime prerequisites (table C) and display\n   \"src/cljc/dao/data/btree.cljc\" (entry :runtime-prereq :stays \"atomic flag, weak/soft references\")\n   \"src/cljc/dao/data/btree/storage.cljc\" (entry :runtime-prereq :stays \"promise facade, deferred §9.1\")\n   \"src/cljc/dao/pretty.cljc\" (entry :runtime-prereq :stays \"display only\")\n   ;; Codec-track files\n   \"src/cljc/dao/stream/ws.cljc\" (entry :codec-track :stays)\n   \"src/cljc/dao/stream/transit.cljc\" (entry :codec-track :stays)\n   \"src/cljc/dao/stream/cbor.cljc\" (entry :codec-track :stays)\n   \"src/cljc/dao/stream/cbor/boring.cljc\" (entry :codec-track :stays)\n   \"src/cljc/dao/stream/codec.cljc\" (entry :codec-track :stays \":45 after C4\")\n   ;; H0 finding, retained dialect arms (r7 §8.1 \"dialect arms\" row)\n   \"src/cljc/dao/space/query.cljc\" (entry :dialect-arm :stays \":808 runtime type name in diagnostic text\")\n   \"src/cljc/yang/clojure.cljc\" (entry :dialect-arm :stays \":375 runtime type name in diagnostic text\")\n   \"src/cljc/yin/vm/engine.cljc\" (entry :dialect-arm :stays \":929 runtime type name in diagnostic text\")\n   \"src/cljc/yin/repl/adapter.cljc\" (entry :dialect-arm :stays \":58 the dialect's EDN reader\")\n   \"src/cljc/yin/repl/dht.cljc\" (entry :dialect-arm :stays \":104 the dialect's EDN reader\")\n   \"src/cljc/dao/stream/ringbuffer.cljc\" (entry :dialect-arm :stays \":168 the in-memory stream's own host atom test (§4.1)\")\n   ;; Seams and driver: every lane-specific file, the selector, the driver\n   \"src/clj/dao/jing/content/driver.clj\" (entry :seam-driver :stays)\n   \"src/clj/dao/stream/datagram/jvm.clj\" (entry :seam-driver :stays)\n   \"src/clj/dao/stream/waitset/driver.clj\" (entry :seam-driver :stays)\n   \"src/clj/dao/stream/ws/jvm.clj\" (entry :seam-driver :stays)\n   \"src/clj/yang/antlr/cst.clj\" (entry :seam-driver :stays)\n   \"src/clj/yin/repl/host/jvm.clj\" (entry :seam-driver :stays)\n   \"src/cljs/dao/stream/datagram/node.cljs\" (entry :seam-driver :stays)\n   \"src/cljs/dao/stream/waitset/driver.cljs\" (entry :seam-driver :stays)\n   \"src/cljs/dao/stream/ws/node.cljs\" (entry :seam-driver :stays)\n   \"src/cljs/yang/antlr/cst.cljs\" (entry :seam-driver :stays)\n   \"src/cljs/yin/repl/host.cljs\" (entry :seam-driver :stays)\n   \"src/cljd/dao/stream/cbor/cljd.cljd\" (entry :seam-driver :stays)\n   \"src/cljd/dao/stream/transit/cljd.cljd\" (entry :seam-driver :stays)\n   \"src/cljd/dao/stream/datagram/dart.cljd\" (entry :seam-driver :stays)\n   \"src/cljd/dao/stream/waitset/driver.cljd\" (entry :seam-driver :stays)\n   \"src/cljd/dao/stream/ws/dart.cljd\" (entry :seam-driver :stays)\n   \"src/cljd/yang/antlr/cst.cljd\" (entry :seam-driver :stays)\n   \"src/cljd/yin/repl/host.cljd\" (entry :seam-driver :stays)\n   \"src/cljc/yin/repl/main.cljc\" (entry :seam-driver :stays)\n   \"src/cljc/yin/repl/host.cljc\" (entry :seam-driver :stays)\n   \"src/cljc/yin/repl/state.cljc\" (entry :seam-driver :stays)\n   ;; Deferred-scope files (§9)\n   \"src/cljc/dao/jing/file.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/space/store/fs.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/space/store.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/stream/journal/file.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/jing/coordinate.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/space/dht.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/stream/rpc.cljc\" (entry :deferred-scope :stays \":114 rand, deferred entropy (§9.1); H0 finding\")\n   \"src/cljc/yin/repl.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/yang/python/antlr/parser.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/yang/python/antlr/lower.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/yang/python/antlr/prelude.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/yang/python/antlr/render.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/yang/python/antlr/repl_probe.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/dao/stream/journal.cljc\" (entry :deferred-scope :stays \"locking\")\n   \"src/cljc/dao/space/transactor.cljc\" (entry :deferred-scope :stays)\n   \"src/cljc/yin/vm/ucf/authority.cljc\" (entry :deferred-scope :stays \"locking\")})\n\n\n(def list-2\n  \"The resolved effect calls permitted, {file {kind count}}: the §3.2\n   sites inside the adopted closure and the callers of §2.4's M entries.\n   A count is a ceiling: one more call of that kind in that file fails.\"\n  {;; §3.2 random-uuid: 21 inside the closure (dao.await and\n;; §3.1 classes. Keys are namespaces; a row's namespaces are named exactly as\n;; the §3.1 table names them, expanded where the table abbreviates (\".datagram\"\n;; = dao.stream.datagram, \"the seams\" = the lane-specific ws/datagram files).\n;; Files of the §3.2 random-uuid/rand list carry :deferred-entropy.\n;; ---------------------------------------------------------------------------\n\n(def class-rows\n  [[:profile-internal-pure \"H1-H2 (writer H4)\"\n    '[yin.vm.integer.host dao.jing.cbor dao.jing.cbor.boring dao.jing.cbor.cljd\n      yin.vm.debruijn yin.vm.debruijn-code yin.vm.data yin.vm.values\n      dao.stream.chunks dao.stream.base64 dao.jing.dht yin.vm.linker\n      dao.stream.datagram dao.data.arrays]]\n   [:profile-hash-sign \"H3\" '[dao.jing yin.vm.linker.sign]]\n   [:consumer \"H2 (require change only)\"\n    '[yin.vm yin.vm.engine yin.vm.values yin.vm.data yin.vm.integer]]\n   [:external-stream-seam \"none (existing streams)\"\n    '[dao.stream.ws dao.stream.datagram dao.stream.ws.jvm dao.stream.ws.node\n      dao.stream.ws.dart dao.stream.datagram.jvm dao.stream.datagram.node\n      dao.stream.datagram.dart dao.stream.waitset.driver yin.repl.host\n      yin.repl.host.jvm yin.repl.host.common dao.stream.ringbuffer]]\n   [:deferred-storage \"deferred §9.2\"\n    '[dao.jing.file dao.space.store.fs dao.space.store\n      dao.stream.journal.file dao.data.btree.storage]]\n   [:deferred-entropy \"deferred §9.1\"\n    '[dao.stream.ringbuffer dao.stream.memory-log dao.stream.ws\n      dao.stream.remote dao.stream.remote-pair dao.stream.remote-route\n      dao.stream.journal dao.jing.content.step dao.lease dao.space.store.fs\n      yin.vm.linker yin.vm.ucf.custody yin.vm.ucf.holder.driver yin.vm.telemetry\n      yin.repl yin.repl.dht dao.stream.rpc dao.jing.dht dao.space.dht\n      yin.vm.linker.sign]]\n   [:deferred-timers \"deferred §9.1\"\n    '[dao.jing.coordinate dao.jing.content.driver dao.data.btree.storage]]\n   [:driver \"driver (ambient reads deferred §9.1)\"\n    '[yin.repl.main yin.repl yin.repl.state]]\n   [:deferred-stage \"deferred §9.3\"\n    '[yang.antlr.cst yang.frontend yang.stage yin.repl.frontends]]\n   [:deferred-gensym \"deferred §9.1\"\n    '[yang.clojure yang.php dao.space.transact]]\n   [:runtime-prereq \"table C, no slice\"\n    '[dao.data.btree dao.jing.file dao.stream.journal dao.space.transactor\n      yin.vm.ucf.authority]]\n   ;; r7: the two rows for H0's 16 findings (rpc is in :deferred-entropy)\n   [:profile-consumer \"H2 (H0 finding: consumers of table A entries)\"\n    '[yin.repl.query yin.vm.linker.closure yin.vm.ucf.rows yin.vm yang.php\n      yin.vm.debruijn-register-code yin.vm.debruijn-register-effects\n      dao.space.index yang.antlr.packet]]\n   [:dialect-arm \"none (H0 finding: retained dialect arms)\"\n    '[dao.space.query yang.clojure yin.vm.engine yin.repl.adapter\n      yin.repl.dht]]\n   ;; §3.1 names transit, cbor and codec; the rest are the codec track's\n   ;; files by §8.3 (and ws-project by §8.1's codec row) and the lane twins.\n   [:codec-track \"codec track, untouched (§8.3)\"\n    '[dao.stream.transit dao.stream.cbor dao.stream.codec\n      dao.stream.cbor.boring dao.stream.cbor.cljd dao.stream.transit.cljd\n      dao.stream.ws dao.stream.remote-channel dao.stream.ws-project\n      dao.jing.stream dao.data dao.stream.ws.jvm dao.stream.ws.node\n      dao.stream.ws.dart dao.stream.ws.browser yin.repl.serve\n      yin.repl.connect]]\n   [:internal-pure-display \"none (list 1, display only)\" '[dao.pretty]]])\n\n\n(def prefix-rows\n  \"Rows the §3.1 table names by prefix (`yang.python.antlr.*`).\"\n  [[:deferred-stage \"yang.python.antlr.\"]])\n\n\n(defn classes-of\n  [ns-sym]\n  (let [s (name ns-sym)\n","exit_code":0,"status":"completed"}}
