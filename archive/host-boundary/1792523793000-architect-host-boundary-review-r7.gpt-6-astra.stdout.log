t-version 1)\n58: \n59: \n60: ;; =============================================================================\n61: ;; Source text\n62: ;; =============================================================================\n63: \n64: (defn code-points\n65:   \"The code points of `s` as a vector of integers.\"\n66:   [s]\n67:   #?(:cljd (vec (.-runes ^String s))\n68:      :clj (mapv long (.toArray (.codePoints ^String s)))\n69:      :cljs (mapv #(.codePointAt % 0) (js/Array.from s))))\n70: \n71: \n72: (defn utf8-length\n73:   \"The UTF-8 byte count of one code point.\"\n74:   [cp]\n75:   (cond (< cp 0x80) 1\n76:         (< cp 0x800) 2\n77:         (< cp 0x10000) 3\n78:         :else 4))\n79: \n80: \n81: (defn utf8-bytes\n82:   \"The UTF-8 byte count of a string: span ends are checked against it.\"\n83:   [s]\n84:   (reduce + 0 (map utf8-length (code-points s))))\n85: \n86: \n\nyang/clojure.cljc\n368:           defmacro (let [[name-form params & body-forms] operands]\n369:                      (compile-defmacro name-form params body-forms env tail? macro-env))\n370:           ;; Function application: (f arg1 arg2 ...)\n371:           (compile-application operator operands env tail? macro-env))))\n372:     ;; Unknown form type\n373:     :else (throw (ex-info \"Cannot compile unknown form type\"\n374:                           {:form form,\n375:                            :type #?(:cljd (clojure.core/str (.-runtimeType form))\n376:                                     :default (clojure.core/type form))}))))\n377: \n378: \n379: (defn compile-form\n380:   \"Compile one Clojure form and retain the reader's plain metadata on the\n\nyang/php.cljc\n83:   [tokens type & [val]]\n84:   (if (match? (first tokens) type val)\n85:     (rest tokens)\n86:     (throw (ex-info (str \"Expected \" type \" \" (or val \"\"))\n87:                     {:token (first tokens), :all (take 5 tokens)}))))\n88: \n89: \n90: (defn parse-php-literal\n91:   [[type val]]\n92:   (case type\n93:     :number {:ph