(defn lane-specific?
  [file]
  (not (str/ends-with? file ".cljc")))


(def list-1-categories
  "The §8.1 rows (r8): what the row means, the slices that may clear its
   files from list 1 (\"H2\" \"H3\" \"H4\": removed by that slice; :stays:
   retained by design; :conditional-retention-oq11: H2 migrates the file
   but a JVM arm survives until the owner decides OQ11, §13), and the §3.1
   closure classes a file in the row may carry (:classes). A file must
   carry at least one of them on every lane whose closure holds it; a
   lane-specific file (.clj .cljs .cljd) may instead carry one of
   :lane-specific-classes (the §8.1 seams row takes every lane file
   whatever its §3.1 row)."
  {:migration-source {:row "H1-H4 migration sources (incl. H0's profile consumers)"
                      :clears #{"H2" "H3" "H4" :stays :conditional-retention-oq11}
                      :classes #{:profile-internal-pure :profile-hash-sign :profile-consumer}}
   :profile {:row "Profile: the arms belong here by design"
             :clears #{:stays}
             :classes #{:profile-internal-pure}}
   :runtime-prereq {:row "Retained runtime prerequisites (table C) and display"
                    :clears #{:stays}
                    :classes #{:runtime-prereq :deferred-storage :deferred-timers
                               :internal-pure-display}}
   :codec-track {:row "Codec-track files, untouched by this track"
                 :clears #{:stays}
                 :classes #{:codec-track}}
   :dialect-arm {:row "Dialect arms (H0 finding, retained): diagnostic type names, the dialect's EDN reader"
                 :clears #{:stays}
                 :classes #{:dialect-arm}}
   :seam-driver {:row "Seams, stream implementations and driver"
                 :clears #{:stays}
                 :classes #{:external-stream-seam :driver}
                 :lane-specific-classes #{:deferred-stage :deferred-timers :codec-track}}
   :deferred-scope {:row "Deferred-scope files (§9)"
                    :clears #{:stays}
                    :classes #{:deferred-storage :deferred-entropy :deferred-timers
                               :deferred-stage :deferred-gensym :runtime-prereq}}})


(defn list-1-problems
  "Every way list-1 disagrees with list-1-categories and the per-lane
   closure classes {lane {file classes}}: [kind file detail]. Lanes are
   checked one at a time; a lane's tags are never merged with another's."
  [list-1 lane-classes]
  (vec
    (concat
      (for [[f {:keys [category clears]}] list-1
            problem (cond
                      (not (contains? list-1-categories category))
                      [[:unknown-category f category]]
                      (not (contains? (get-in list-1-categories [category :clears]) clears))
                      [[:slice-not-allowed f [category clears]]]
                      :else [])]
        problem)
      (for [[f {:keys [category]}] list-1
            :when (contains? list-1-categories category)
            :let [{:keys [classes lane-specific-classes]} (list-1-categories category)
                  allowed (if (lane-specific? f) (into classes lane-specific-classes) classes)
                  on-lanes (keep (fn [[l m]] (when (contains? m f) [l (get m f)])) lane-classes)]
            problem (if (empty? on-lanes)
                      [[:in-no-lane f nil]]
