stays}}\n   450\t   :runtime-prereq {:row \"Retained runtime prerequisites (table C) and display\"\n   451\t                    :clears #{:stays}}\n   452\t   :codec-track {:row \"Codec-track files, untouched by this track\" :clears #{:stays}}\n   453\t   :dialect-arm {:row \"Dialect arms (H0 finding, retained): display text or the dialect's EDN reader\"\n   454\t                 :clears #{:stays}}\n   455\t   :seam-driver {:row \"Seams and driver: lane-specific files, the selector, the driver\"\n   456\t                 :clears #{:stays}}\n   457\t   :deferred-scope {:row \"Deferred-scope files (§9)\" :clears #{:stays}}})\n   458\t\n   459\t\n   460\t(defn- entry\n   461\t  ([category clears] {:category category :clears clears})\n   462\t  ([category clears reason] {:category category :clears clears :reason reason}))\n   463\t\n   464\t\n   465\t(def list-1\n   466\t  \"The closure files permitted non-exempt host arms (§8.1 r7), each with\n   467\t   its row, the slice that clears it, and for H0's 16 findings the site\n   468\t   and reason. Generated from the H0 tree by the gate; r7 categorised the\n   469\t   16 files H0 first found unlisted (no file is uncategorised).\"\n   470\t  {;; H1-H4 migration sources\n   471\t   \"src/cljc/yin/vm/integer/host.cljc\" (entry :migration-source \"H2\" \"deleted in H2\")\n   472\t   \"src/cljc/dao/jing/cbor.cljc\" (entry :migration-source \"H2\" \"helpers H2, writer H4\")\n   473\t   \"src/cljc/dao/jing/cbor/boring.cljc\" (entry :migration-source \"H4\" \"deleted in H4\")\n   474\t   \"src/cljd/dao/jing/cbor/cljd.cljd\" (entry :migration-source \"H4\" \"Dart Jing writer, deleted in H4\")\n   475\t   \"src/cljc/dao/jing.cljc\" (entry :migration-source \"H3\" \"hashes\")\n   476\t   \"src/cljc/yin/vm/linker/sign.cljc\" (entry :migration-source :stays \"H3 migrates; generate stays (deferred entropy)\")\n   477\t   \"src/cljc/yin/vm/debruijn.cljc\" (entry :migration-source \"H2\")\n   478\t   \"src/cljc/yin/vm/debruijn_code.cljc\" (entry :migration-source \"H2\")\n   479\t   \"src/cljc/yin/vm/data.cljc\" (entry :migration-source \"H2\")\n   480\t   \"src/cljc/yin/vm/values.cljc\" (entry :migration-source \"H2\" \"table C blocks stay as exempt protocol syntax\")\n   481\t   \"src/cljc/dao/stream/chunks.cljc\" (entry :migration-source \"H2\")\n   482\t   \"src/cljc/dao/stream/base64.cljc\" (entry :migration-source \"H3\" \"base64 made portable\")\n   483\t   \"src/cljc/dao/jing/dht.cljc\" (entry :migration-source \"H2\")\n   484\t   \"src/cljc/yin/vm/linker.cljc\" (entry :migration-source \"H2\" \":1232\")\n   485\t   \"src/cljc/dao/stream/datagram.cljc\" (entry :migration-source \"H2\" \"bytes arms :63-66 only\")\n   680\t        (is (every? #(seq (:classes %)) (:files (committed-closure l))))))))\n   681\t\n   682\t\n   683\t(deftest independent-traversal-agrees-with-the-committed-closure\n   684\t  (doseq [l lanes]\n   685\t    (testing (str \"lane \" l)\n   686\t      (let [committed (set (map :file (:files (committed-closure l))))\n   687\t            walked (traverse l)]\n   688\t        (is (= #{} (set/difference committed walked)) \"committed, not walked\")\n   689\t        (is (= #{} (set/difference walked committed)) \"walked, not committed\")))))\n   690\t\n   691\t\n   692\t(deftest gate-passes-on-the-current-tree\n   693\t  (let [r @current]\n   694\t    (is (= 155 (count (closure-files))) \"the union of the three lanes\")\n   695\t    (is (= (count (closure-files)) (:scanned r)))\n   696\t    (is (= [] (:errors r)))\n   697\t    (is (= [] (:arm-violations r)))\n   698\t    (is (= [] (:effect-violations r)))\n   699\t    (is (= :pass (:verdict r)))))\n   700\t\n   701\t\n   702\t(deftest list-1-equals-the-observed-arms\n   703\t  (testing \"every list-1 file is in the closure and still holds a host arm\"\n   704\t    (let [observed (set (keep (fn [[f r]] (when (seq (:arms r)) f)) (:observed @current)))]\n   705\t      (is (= (set (keys list-1)) observed))))\n   706\t  (testing \"every list-1 file has an explained §8.1 category and a clearing slice\"\n   707\t    (doseq [[f {:keys [category clears]}] list-1]\n   708\t      (is (contains? list-1-categories category) (str f \" \" category))\n   709\t      (is (contains? (get-in list-1-categories [category :clears]) clears)\n   710\t          (str f \" \" category \" \" clears)))\n   711\t    (let [tags (into {} (mapcat (fn [l] (map (juxt :file :classes) (:files (committed-closure l))))\n   712\t                                lanes))]\n   713\t      (doseq [f (keys list-1)]\n   714\t        (is (not= #{:none} (tags f)) (str f \" is on list 1 but its closure class is :none\"))))))\n   715\t\n   716\t\n   717\t(deftest list-2-equals-the-observed-calls\n   718\t  (testing \"every permitted count is the observed count (no slack)\"\n   719\t    (let [observed (into {} (keep (fn [[f r]]\n   720\t                                    (when (seq (:effects r))\n   721\t                                      [f (update-vals (:effects r) count)]))\n   722\t                                  (:observed @current)))]\n   723\t      (is (= list-2 observed)))))\n   724\t\n   725\t\n   726\t(defn- outside\n   727\t  \"The first closure .cljc file outside m with no arms and no effect calls.\"\n   728\t  [m]\n   729\t  (first (for [[f r] (:observed @current)\n   730\t               :when (and (not (lane-specific? f)) (not (contains? m f))\n   731\t                          (empty? (:arms r)) (empty? (:effects r)))]\n   732\t           f)))\n   733\t\n   734\t\n   735\t(deftest an-injected-host-arm-outside-list-1-fails-the-gate\n   736\t  (let [target (outside list-1)\n   737\t        sources (update (read-sources (closure-files)) target str\n   738\t                        \"\\n(def injected #?(:clj (java.lang.Math/abs -1) :cljs 1))\\n\")\n   739\t        r (gate sources list-1 list-2)]\n   740\t    (is (some? target))\n   741\t    (is (= :fail (:verdict r)))\n   742\t    (is (= [target] (map :file (:arm-violations r))))\n   743\t    (is (= [] (:effect-violations r)))))\n   744\t\n   745\t\n   746\t(deftest an-injected-random-uuid-outside-list-2-fails-the-gate\n   747\t  (let [target (outside list-2)\n   748\t        sources (update (read-sources (closure-files)) target str\n   749\t                        \"\\n(def injected (random-uuid))\\n\")\n   750\t        r (gate sources list-1 list-2)]\n   751\t    (is (some? target))\n   752\t    (is (= :fail (:verdict r)))\n   753\t    (is (= [{:file target :kind :random-uuid :count 1 :allowed 0}]\n   754\t           (map #(dissoc % :lines) (:effect-violations r))))\n   755\t    (is (= [] (:arm-violations r)))))\n   756\t\n   757\t\n   758\t(deftest a-scan-failure-is-not-a-pass\n   759\t  (testing \"zero files read\"\n   760\t    (let [r (gate {} list-1 list-2)]\n   761\t      (is (= :scan-failure (:verdict r)))\n   762\t      (is (= 0 (:scanned r)))))\n   763\t  (testing \"a closure file that cannot be read\"\n   764\t    (let [r (gate (assoc (read-sources (closure-files)) \"src/cljc/no/such.cljc\" nil)\n   765\t                  list-1 list-2)]\n   766\t      (is (= :scan-failure (:verdict r)))\n   767\t      (is (= [\"src/cljc/no/such.cljc\"] (map first (:errors r)))))))\n   768\t\n   769\t\n   770\t(defn- sha-256\n   771\t  [file]\n   772\t  (let [d (java.security.MessageDigest/getInstance \"SHA-256\")]\n   773\t    (apply str (map #(format \"%02x\" (bit-and % 0xff))\n   774\t                    (.digest d (java.nio.file.Files/readAllBytes (.toPath (io/file file))))))))\n   775\t\n   776\t\n   777\t(deftest corpus-bytes-match-the-frozen-hash-set\n   778\t  (testing \"H0 (d): the Jing corpus and codec wire fixtures, byte-identical\"\n   779\t    (let [{:keys [roots files]} (edn/read-string (slurp \"docs/design/host-boundary/corpus-sha256.edn\"))\n   780\t          on-disk (into (sorted-set)\n   781\t                        (for [r roots\n   782\t                              f (file-seq (io/file r))\n   783\t                              :when (.isFile ^java.io.File f)]\n   784\t                          (str/replace (.getPath ^java.io.File f) \"\\\\\" \"/\")))]\n   785\t      (is (= 18 (count files)))\n   786\t      (is (= (set (keys files)) on-disk))\n   787\t      (doseq [[f h] files]\n   788\t        (is (= h (sha-256 f)) f)))))\n   789\t\n   790\t\n   791\t(deftest exemptions-and-resolution\n   792\t  (testing \"§3.3 patterns are exempt; a value arm is not\"\n   793\t    (is (= [] (non-exempt-arms (read-forms \"(try 1 (catch #?(:clj Exception :cljs :default) e e))\"))))\n   794\t    (is (= [] (non-exempt-arms (read-forms \"(ns a (:require #?(:clj [x :as y] :cljs [z :as y])))\"))))\n   795\t    (is (= [] (non-exempt-arms (read-forms \"(def s #?(:clj (Object.) :cljs (js-obj)))\"))))\n   796\t    (is (= 1 (count (non-exempt-arms (read-forms \"(def n #?(:clj 1 :cljs 2))\"))))))\n   797\t  (testing \"locals, file defs and quoted forms are not core calls\"\n   798\t    (is (= [] (effect-calls (read-forms \"(defn f [pr] (pr 1))\"))))\n   799\t    (is (= [] (effect-calls (read-forms \"(let [gensym inc] (gensym 1))\"))))\n   800\t    (is (= [] (effect-calls (read-forms \"(declare gensym) (gensym)\"))))\n   801\t    (is (= [] (effect-calls (read-forms \"(def code '(println 1))\"))))\n   802\t    (is (= [:random-uuid :print] (map first (effect-calls (read-forms \"(random-uuid) (println 1)\")))))))\n(ns host-boundary.closure\n  \"The adopted closure of dao.stream.host-boundary.md §3.1, per lane.\n\n   A require-form traversal from yin.repl.main over the ns declarations,\n   parsed by clojure.tools.namespace.parse (read-ns-decl with the lane's\n   reader features, deps-from-ns-decl for :require, :use and\n   :require-macros; :as-alias and string (npm, dart:) libspecs are not\n   dependencies). Lane features: :clj #{:clj}, :cljs #{:cljs},\n   :cljd #{:cljd :clj} (the cljd build also reads :clj arms; the first\n   matching arm wins, as in tools.reader). A namespace resolves to\n   src/<lane>/<path>.<lane> first (the shadow: yin.repl.host is\n   host.cljc on the JVM, host.cljs and host.cljd elsewhere), then\n   src/cljc/<path>.cljc; a namespace with neither (clojure.core, a\n   library) is outside the closure.\n\n   It is not a compiler-resolved call graph: it over-includes a namespace\n   required but unused, and does not see dynamic loading.\n\n   Each file is tagged with its §3.1 classes (a set: a file can sit in\n   several rows of the §3.1 table; :none means no host contact beyond the\n   §3.3 exempt syntax).\n\n   Run from the repo root:\n     clojure -Sdeps '{:aliases {:hb {:extra-paths [\\\"src/dev\\\"]\n                      :extra-deps {org.clojure/tools.namespace\n                                   {:mvn/version \\\"1.5.0\\\"}}}}}' \\\\\n       -M:hb -m host-boundary.closure [--check]\n   writes docs/design/host-boundary/closure-{clj,cljs,cljd}.edn and\n   prints the totals; --check writes nothing and exits 1 when a committed\n   file differs from the computed closure.\"\n  (:require\n    [clojure.java.io :as io]\n    [clojure.pprint :as pp]\n    [clojure.set :as set]\n    [clojure.string :as str]\n    [clojure.tools.namespace.parse :as parse]\n    [clojure.walk :as walk]))\n\n\n(def root 'yin.repl.main)\n(def lanes [:clj :cljs :cljd])\n(def out-dir \"docs/design/host-boundary\")\n\n\n(def lane-features\n  {:clj #{:clj}, :cljs #{:cljs}, :cljd #{:cljd :clj}})\n\n\n(defn ns->path\n  [ns-sym]\n  (-> (name ns-sym) (str/replace \"-\" \"_\") (str/replace \".\" \"/\")))\n\n\n(defn resolve-file\n  \"The repo-relative file for ns-sym on lane, or nil.\"\n  [lane ns-sym]\n  (let [p (ns->path ns-sym)\n        lane-dir (name lane)]\n    (some (fn [f] (when (.isFile (io/file f)) f))\n          [(str \"src/\" lane-dir \"/\" p \".\" lane-dir)\n           (str \"src/cljc/\" p \".cljc\")])))\n\n\n(defn strip-nils\n  \"Drops the nil a lane's arm leaves in a libspec position\n   (`#?(:cljd nil :clj [x])` reads as nil on :cljd); deps-from-ns-decl\n   refuses nil as unparsable, the compilers ignore it.\"\n  [form]\n  (walk/postwalk (fn [x]\n                   (cond (vector? x) (vec (remove nil? x))\n                         (seq? x) (apply list (remove nil? x))\n                         :else x))\n                 form))\n\n\n(defn ns-decl\n  [lane file]\n  (with-open [r (java.io.PushbackReader. (io/reader file))]\n    (strip-nils (parse/read-ns-decl r {:read-cond :allow\n                                       :features (lane-features lane)}))))\n\n\n(defn lane-closure\n  \"{file ns-sym} for every file reachable from root on lane.\"\n  [lane]\n  (loop [todo [root]\n         seen #{}\n         files {}]\n    (if-let [n (first todo)]\n      (if (seen n)\n        (recur (rest todo) seen files)\n        (let [seen (conj seen n)]\n          (if-let [f (resolve-file lane n)]\n            (let [decl (ns-decl lane f)\n                  deps (sort (parse/deps-from-ns-decl decl))]\n              (when-not (= n (parse/name-from-ns-decl decl))\n                (throw (ex-info \"ns name does not match its file\"\n                                {:lane lane :ns n :file f\n                                 :declared (parse/name-from-ns-decl decl)})))\n              (recur (concat (rest todo) deps) seen (assoc files f n)))\n            (recur (rest todo) seen files))))\n      files)))\n\n\n;; ---------------------------------------------------------------------------\n;; §3.1 classes. Keys are namespaces; a row's namespaces are named exactly as\n;; the §3.1 table names them, expanded where the table abbreviates (\".datagram\"\n;; = dao.stream.datagram, \"the seams\" = the lane-specific ws/datagram files).\n;; Files of the §3.2 random-uuid/rand list carry :deferred-entropy.\n;; ---------------------------------------------------------------------------\n\n(def class-rows\n  [[:profile-internal-pure \"H1-H2 (writer H4)\"\n    '[yin.vm.integer.host dao.jing.cbor dao.jing.cbor.boring dao.jing.cbor.cljd\n      yin.vm.debruijn yin.vm.debruijn-code yin.vm.data yin.vm.values\n      dao.stream.chunks dao.stream.base64 dao.jing.dht yin.vm.linker\n      dao.stream.datagram dao.data.arrays]]\n   [:profile-hash-sign \"H3\" '[dao.jing yin.vm.linker.sign]]\n   [:consumer \"H2 (require change only)\"\n    '[yin.vm yin.vm.engine yin.vm.values yin.vm.data yin.vm.integer]]\n   [:external-stream-seam \"none (existing streams)\"\n    '[dao.stream.ws dao.stream.datagram dao.stream.ws.jvm dao.stream.ws.node\n      dao.stream.ws.dart dao.stream.datagram.jvm dao.stream.datagram.node\n      dao.stream.datagram.dart dao.stream.waitset.driver yin.repl.host\n      yin.repl.host.jvm yin.repl.host.common dao.stream.ringbuffer]]\n   [:deferred-storage \"deferred §9.2\"\n    '[dao.jing.file dao.space.store.fs dao.space.store\n      dao.stream.journal.file dao.data.btree.storage]]\n   [:deferred-entropy \"deferred §9.1\"\n    '[dao.stream.ringbuffer dao.stream.memory-log dao.stream.ws\n      dao.stream.remote dao.stream.remote-pair dao.stream.remote-route\n      dao.stream.journal dao.jing.content.step dao.lease dao.space.store.fs\n      yin.vm.linker yin.vm.ucf.custody yin.vm.ucf.holder.driver yin.vm.telemetry\n      yin.repl yin.repl.dht dao.stream.rpc dao.jing.dht dao.space.dht\n      yin.vm.linker.sign]]\n   [:deferred-timers \"deferred §9.1\"\n    '[dao.jing.coordinate dao.jing.content.driver dao.data.btree.storage]]\n   [:driver \"driver (ambient reads deferred §9.1)\"\n    '[yin.repl.main yin.repl yin.repl.state]]\n   [:deferred-stage \"deferred §9.3\"\n    '[yang.antlr.cst yang.frontend yang.stage yin.repl.frontends]]\n   [:deferred-gensym \"deferred §9.1\"\n    '[yang.clojure yang.php dao.space.transact]]\n   [:runtime-prereq \"table C, no slice\"\n    '[dao.data.btree dao.jing.file dao.stream.journal dao.space.transactor\n      yin.vm.ucf.authority]]\n   ;; r7: the two rows for H0's 16 findings (rpc is in :deferred-entropy)\n   [:profile-consumer \"H2 (H0 finding: consumers of table A entries)\"\n    '[yin.repl.query yin.vm.linker.closure yin.vm.ucf.rows yin.vm yang.php\n      yin.vm.debruijn-register-code yin.vm.debruijn-register-effects\n      dao.space.index yang.antlr.packet]]\n   [:dialect-arm \"none (H0 finding: retained dialect arms)\"\n    '[dao.space.query yang.clojure yin.vm.engine yin.repl.adapter\n      yin.repl.dht]]\n   ;; §3.1 names transit, cbor and codec; the rest are the codec track's\n   ;; files by §8.3 (and ws-project by §8.1's codec row) and the lane twins.\n   [:codec-track \"codec track, untouched (§8.3)\"\n    '[dao.stream.transit dao.stream.cbor dao.stream.codec\n      dao.stream.cbor.boring dao.stream.cbor.cljd dao.stream.transit.cljd\n      dao.stream.ws dao.stream.remote-channel dao.stream.ws-project\n      dao.jing.stream dao.data dao.stream.ws.jvm dao.stream.ws.node\n      dao.stream.ws.dart dao.stream.ws.browser yin.repl.serve\n      yin.repl.connect]]\n   [:internal-pure-display \"none (list 1, display only)\" '[dao.pretty]]])\n\n\n(def prefix-rows\n  \"Rows the §3.1 table names by prefix (`yang.python.antlr.*`).\"\n  [[:deferred-stage \"yang.python.antlr.\"]])\n\n\n(defn classes-of\n  [ns-sym]\n  (let [s (name ns-sym)\n        cs (into (set (keep (fn [[c _ nss]] (when (some #{ns-sym} nss) c))\n                            class-rows))\n                 (keep (fn [[c pre]] (when (str/starts-with? s pre) c))\n                       prefix-rows))]\n    (if (seq cs) cs #{:none})))\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"The decimal conversion algorithm exists, but it is exported through the VM’s module map, not as a callable `yin.vm.integer/decimal->float` var. I’m checking the dependency implications. The H0 retag also still assigns ringbuffer to `:dialect-arm`, while r8 moved it to the seams row.\n"}}
