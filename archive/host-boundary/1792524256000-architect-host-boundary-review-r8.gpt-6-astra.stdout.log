dling, TestCoverage\n    file_path: str\n    line_number: Optional[int]\n    message: str\n    snippet: str\n\n\n@dataclass\nclass FileStat:\n    path: str\n    additions: int\n    deletions: int\n    category: str\n    risk_level: str  # High, Medium, Low\n\n\n@dataclass\nclass ReviewSummary:\n    target: str\n    total_files: int\n    total_additions: int\n    total_deletions: int\n    test_additions: int\n    source_additions: int\n    test_to_source_ratio: float\n    file_stats: List[FileStat] = field(default_factory=list)\n    findings: List[Finding] = field(default_factory=list)\n    commits: List[str] = field(default_factory=list)\n\n\ndef run_git_command(args: List[str], cwd: Optional[str] = None) -> str:\n    \"\"\"Helper to run git commands cleanly.\"\"\"\n    cmd = [\"git\"] + args\n    try:\n        res = subprocess.run(\n            cmd,\n            cwd=cwd,\n            stdout=subprocess.PIPE,\n            stderr=subprocess.PIPE,\n            text=True,\n            check=True,\n        )\n        return res.stdout.strip()\n    except subprocess.CalledProcessError as e:\n        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n        raise RuntimeError(f\"Git execution failed: {e.stderr.strip()}\")\n\n\ndef categorize_file(file_path: str) -> Tuple[str, str]:\n    \"\"\"Categorizes file type and assigns risk level.\"\"\"\n    path_lower = file_path.lower()\n\n    # Security & Auth\n    if any(k in path_lower for k in [\"auth\", \"secret\", \"crypto\", \"token\", \"permission\", \"jwt\", \"oauth\", \"password\"]):\n        return \"Security/Auth\", \"High\"\n\n    # Database & Schema\n    if any(k in path_lower for k in [\"migration\", \"schema\", \".sql\", \"entity\", \"db/\"]):\n        return \"Database/Schema\", \"High\"\n\n    # Infrastructure & Config\n    if any(k in path_lower for k in [\"docker\", \"terraform\", \".tf\", \".env\", \"k8s\", \"helm\", \"ci/cd\", \".github/workflows\"]):\n        return \"Infra/Config\", \"High\"\n    if any(file_path.endswith(ext) for ext in [\"package.json\", \"deps.edn\", \"Cargo.toml\", \"go.mod\", \"requirements.txt\", \"pom.xml\", \"build.gradle\"]):\n        return \"Dependencies\", \"Medium\"\n\n    # API / Interfaces\n    if any(k in path_lower for k in [\"proto\", \"openapi\", \"swagger\", \"graphql\", \"router\", \"controller\", \"api/\"]):\n        return \"API/Contract\", \"Medium\"\n\n    # Tests\n    if any(k in path_lower for k in [\"test\", \"spec\", \"mock\", \"fixture\", \"e2e\"]):\n        return \"Tests\", \"Low\"\n\n    # Documentation\n    if any(file_path.endswith(ext) for ext in [\".md\", \".rst\", \".txt\", \"LICENSE\"]):\n        return \"Documentation\", \"Low\"\n\n    # Core source\n   485\t   \"src/cljc/dao/stream/datagram.cljc\" (entry :migration-source \"H2\" \"bytes arms :63-66 only\")\n   486\t   ;; H0 finding, profile consumers (r7 §3.1, §8.1 first row): H2 migrates\n   487\t   \"src/cljc/yin/vm.cljc\" (entry :migration-source \"H2\" \":404 bytes->str; named behaviour change: strict UTF-8 on all hosts (JS/Dart decode byte-as-char-code today)\")\n   488\t   \"src/cljc/yang/php.cljc\" (entry :migration-source \"H2\" \":95,98 number parsing; named behaviour change: js/parseInt loses precision above 2^53, becomes exact\")\n   489\t   \"src/cljc/dao/space/index.cljc\" (entry :migration-source \"H2\" \":78 number fast path\")\n   490\t   \"src/cljc/yin/repl/query.cljc\" (entry :migration-source \"H2\" \":460 byte length\")\n   491\t   \"src/cljc/yin/vm/linker/closure.cljc\" (entry :migration-source \"H2\" \":32 byte length\")\n   492\t   \"src/cljc/yin/vm/ucf/rows.cljc\" (entry :migration-source \"H2\" \":282 byte length\")\n   493\t   \"src/cljc/yin/vm/debruijn_register_code.cljc\" (entry :migration-source \"H2\" \":439 safe-integer check\")\n   494\t   \"src/cljc/yin/vm/debruijn_register_effects.cljc\" (entry :migration-source \"H2\" \":130 safe-integer check\")\n   495\t   \"src/cljc/yang/antlr/packet.cljc\" (entry :migration-source \"H2\" \":67 code points (portable code-points moves to table B)\")\n   496\t   ;; Profile\n   497\t   \"src/cljc/dao/data/arrays.cljc\" (entry :profile :stays)\n   498\t   ;; Retained runtime prerequisites (table C) and display\n   499\t   \"src/cljc/dao/data/btree.cljc\" (entry :runtime-prereq :stays \"atomic flag, weak/soft references\")\n   500\t   \"src/cljc/dao/data/btree/storage.cljc\" (entry :runtime-prereq :stays \"promise facade, deferred §9.1\")\n   501\t   \"src/cljc/dao/pretty.cljc\" (entry :runtime-prereq :stays \"display only\")\n   502\t   ;; Codec-track files\n   503\t   \"src/cljc/dao/stream/ws.cljc\" (entry :codec-track :stays)\n   504\t   \"src/cljc/dao/stream/transit.cljc\" (entry :codec-track :stays)\n   505\t   \"src/cljc/dao/stream/cbor.cljc\" (entry :codec-track :stays)\n   506\t   \"src/cljc/dao/stream/cbor/boring.cljc\" (entry :codec-track :stays)\n   507\t   \"src/cljc/dao/stream/codec.cljc\" (entry :codec-track :stays \":45 after C4\")\n   508\t   ;; H0 finding, retained dialect arms (r7 §8.1 \"dialect arms\" row)\n   509\t   \"src/cljc/dao/space/query.cljc\" (entry :dialect-arm :stays \":808 runtime type name in diagnostic text\")\n   510\t   \"src/cljc/yang/clojure.cljc\" (entry :dialect-arm :stays \":375 runtime type name in diagnostic text\")\n   511\t   \"src/cljc/yin/vm/engine.cljc\" (entry :dialect-arm :stays \":929 runtime type name in diagnostic text\")\n   512\t   \"src/cljc/yin/repl/adapter.cljc\" (entry :dialect-arm :stays \":58 the dialect's EDN reader\")\n   513\t   \"src/cljc/yin/repl/dht.cljc\" (entry :dialect-arm :stays \":104 the dialect's EDN reader\")\n   514\t   \"src/cljc/dao/stream/ringbuffer.cljc\" (entry :dialect-arm :stays \":168 the in-memory stream's own host atom test (§4.1)\")\n   515\t   ;; Seams and driver: every lane-specific file, the selector, the driver\n   516\t   \"src/clj/dao/jing/content/driver.clj\" (entry :seam-driver :stays)\n   517\t   \"src/clj/dao/stream/datagram/jvm.clj\" (entry :seam-driver :stays)\n   518\t   \"src/clj/dao/stream/waitset/driver.clj\" (entry :seam-driver :stays)\n   519\t   \"src/clj/dao/stream/ws/jvm.clj\" (entry :seam-driver :stays)\n   520\t   \"src/clj/yang/antlr/cst.clj\" (entry :seam-driver :stays)\n","exit_code":0,"status":"completed"}}
