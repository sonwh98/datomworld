c/yin/vm/docs/yin.repl.md   |  52 +++++++++\n test/yin/repl/dht_process_test.clj |   5 +-\n test/yin/repl/main_test.cljc       |  10 +-\n test/yin/repl/state_test.cljc      | 164 ++++++++++++++++++++++++++++\n 6 files changed, 603 insertions(+), 44 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-VDQuptIy' (errno=Operation not permitted)\n2026-10-05 00:53:07.450 xcodebuild[65362:42785121]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-05 00:53:07.659 xcodebuild[65362:42785120] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-zHgIgcLI' (errno=Operation not permitted)\n2026-10-05 00:53:08.276 xcodebuild[65367:42785150]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-05 00:53:08.490 xcodebuild[65367:42785149] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ncommit cfab3932f34848675256979b7fa524d220438522\nAuthor: Sonny To <son.c.to@gmail.com>\nDate:   Mon Oct 5 00:52:13 2026 +0700\n\n    feat(yin.repl): save the node's flags in state.edn and resume them on a bare start\n    \n    Flags are saved to <node dir>/state.edn (~/.yin/<name>), a bare yin-repl resumes them, and the command line overrides and re-saves them. --reset forgets, --no-state skips, --vm picks the evaluator at startup. dht serve/join clear a saved --dht-publish. The 1-arity startup stays stateless so tests never touch the user's home.\n\ndiff --git a/src/cljc/yin/repl/main.cljc b/src/cljc/yin/repl/main.cljc\nindex 1a31795e..59af984b 100644\n--- a/src/cljc/yin/repl/main.cljc\n+++ b/src/cljc/yin/repl/main.cljc\n@@ -22,6 +22,7 @@\n             [yin.repl.driver :as driver]\n             [yin.repl.host :as host]\n             [yin.repl.serve :as serve]\n+            [yin.repl.state :as state]\n             [yin.repl.store :as store]\n             [yin.vm.linker.sign :as sign]))\n \n@@ -266,11 +267,17 @@\n ;; The subcommands: `keygen` and `dht init|serve|join`\n ;; =============================================================================\n \n+(defn- home-dir*\n+  \"The user's home directory, or nil where the host has none (ClojureDart).\"\n+  []\n+  #?(:cljd nil\n+     :clj (System/getProperty \"user.home\")\n+     :cljs (some-> js/process .-env .-HOME)))\n+\n+\n (defn- home-dir\n   []\n-  (or #?(:cljd nil\n-         :clj (System/getProperty \"user.home\")\n-         :cljs (some-> js/process .-env .-HOME))\n+  (or (home-dir*)\n       (throw (ex-info (str \"no home directory on this host: give --dir and \"\n                            \"--key explicitly\")\n                       {}))))\n@@ -352,18 +359,56 @@\n            manifest (into [\"--dht-manifest\" manifest])\n            true (into (mapcat #(vector \"--dht-peer\" %)) peers)\n            true (into rest))\n-         (when (= \"init\" verb) {:new-key key})]))))\n+         {:new-key (when (= \"init\" verb) key)\n+          :name name\n+          :dir (or dir (state-path name \"\"))\n+          ;; only `init` publishes: a saved --dht-publish must not survive\n+          ;; `serve` or `join`\n+          :unset (when-not (= \"init\" verb) #{\"--dht-publish\"})}]))))\n+\n+\n+(defn- plain-args\n+  \"The plain form's `--name n` and `--dir d`, which name the node directory\n+   its state file lives in (default `~/.yin/node`), removed from `args`.\n+   Answers `[args extra]`.\"\n+  [args]\n+  (loop [args (seq args) rest [] node-name \"node\" dir nil]\n+    (if-let [arg (first args)]\n+      (case arg\n+        \"--name\" (if (next args)\n+                   (recur (nnext args) rest (second args) dir)\n+                   (recur (next args) (conj rest arg) node-name dir))\n+        \"--dir\" (if (next args)\n+                  (recur (nnext args) rest node-name (second args))\n+                  (recur (next args) (conj rest arg) node-name dir))\n+        (recur (next args) (conj rest arg) node-name dir))\n+      [rest {:name node-name :dir dir}])))\n \n \n (defn expand-args\n   \"Turn the subcommand surface into the flags `parse-args` reads:\n    `keygen [--name n | file]` and `dht init|serve|join`.  Anything else\n-   passes through unchanged.  Answers `[args extra]`.\"\n+   passes through unchanged.  Answers `[args extra]`, `extra` carrying what\n+   the arguments say beyond flags: `:new-key` (a key file `init` makes),\n+   `:name` and `:dir` (the node directory), and `:unset` (saved flags the\n+   subcommand clears).\"\n   [args]\n   (case (first args)\n     \"keygen\" [(keygen-args (rest args)) nil]\n     \"dht\" (dht-args (rest args))\n-    [args nil]))\n+    (plain-args args)))\n+\n+\n+(defn- parse-vm\n+  \"A `--vm` value as the evaluator keyword the shell takes.\"\n+  [text]\n+  (let [vm-type (some-> text keyword)]\n+    (if (contains? shell/vm-labels vm-type)\n+      vm-type\n+      (throw (ex-info (str \"--vm takes one of \"\n+                           (str/join \", \" (map name (sort (keys shell/vm-labels))))\n+                           \", not \" (pr-str text))\n+                      {:value text})))))\n \n \n (defn parse-args\n@@ -406,6 +451,9 @@\n                                         \"localhost and on this machine's IP\")\n                                    {}))\n           \"--headless\" (recur (next args) (assoc opts :headless? true) dht)\n+          \"--vm\" (recur (nnext args)\n+                        (assoc opts :vm-type (parse-vm (second args)))\n+                        dht)\n           \"--index-store\" (recur (nnext args)\n                                  (assoc opts\n                                         :index-store-spec\n@@ -456,10 +504,11 @@\n   ([] (boot {}))\n   ([opts] (driver/create-state\n             {:host (or (:adapter opts) (host/websocket))\n-             :repl (shell/create-state {:index-store-spec\n-                                        (:index-store-spec opts)\n-                                        :dht-key (:dht-key opts)\n-                                        :principals (:principals opts)})})))\n+             :repl (shell/create-state\n+                     (cond-> {:index-store-spec (:index-store-spec opts)\n+                              :dht-key (:dht-key opts)\n+                              :principals (:principals opts)}\n+                       (:vm-type opts) (assoc :vm-type (:vm-type opts))))})))\n \n \n (def bind-all-host\n@@ -548,8 +597,18 @@\n    \"                    all interfaces: localhost and this machine's IP\"\n    \"  --headless        no prompt, endpoint only; needs --port\"\n    \"  --index-store s   mem (default), file:<dir> or dht:<dir>\"\n+   \"  --vm type         ast-walker, semantic (default), stack or register\"\n+   \"  --name n, --dir d the node directory holding the saved state\"\n+   \"                    (default ~/.yin/node)\"\n+   \"  --reset           forget the saved state; start from the command line\"\n+   \"  --no-state        neither read nor write the saved state\"\n    \"  --help, -h        print this and exit\"\n    \"\"\n+   \"saved state: the flags a node starts with are kept in <node dir>/state.edn,\"\n+   \"and a bare `yin-repl` starts that node again. Flags change it: a repeated\"\n+   \"flag (--dht-peer, --dht-principal) replaces its saved values, and the\"\n+   \"result is saved. --dht-manifest and --dht-keygen are never saved.\"\n+   \"\"\n    \"dht flags (need --index-store dht:<dir>, except --dht-keygen):\"\n    \"  --dht-peer host:port        bootstrap contact (IP literal); repeatable\"\n    \"  --dht-publish               share the store's content with peers\"\n@@ -566,6 +625,40 @@\n    \"See src/cljc/yin/vm/docs/yin.repl.md for the walk-through.\"])\n \n \n+(defn- save-state!\n+  \"Save the flags this run resolved to the node directory's state file when\n+   they differ from what was saved (nothing is written for a bare run with\n+   nothing saved), and answer the banner's lines about it.  A file that\n+   cannot be written is a warning, never a refusal: the node still starts.\"\n+  [dir saved resolved reset?]\n+  (let [path (state/path dir)\n+        changed (state/changed (or saved {}) resolved)]\n+    (try\n+      (cond\n+        (and (nil? saved) (empty? resolved) (not reset?))\n+        []\n+\n+        (nil? saved)\n+        (do (state/save! dir resolved)\n+            [(str \"state: \" (if reset? \"reset, \" \"\") \"saved to \" path\n+                  \"; a bare yin-repl starts this node again\")])\n+\n+        (seq changed)\n+        (do (state/save! dir resolved)\n+            [(str \"state: resumed from \" path \" (\" (state/describe saved)\n+                  \"); the command line changed \" (str/join \", \" changed)\n+                  \"; saved\")])\n+\n+        :else\n+        [(str \"state: resumed from \" path \" (\" (state/describe resolved) \")\")])\n+      (catch #?(:cljd Object\n+                :clj Throwable\n+                :cljs :default)\n+             e\n+        [(str \"state: WARNING: could not save \" path \": \"\n+              (or (ex-message e) (str e)))]))))\n+\n+\n (defn startup\n   \"Parse the arguments and compose the whole shell (the store the parsed\n    `:index-store-spec` names included), or answer the refusal text.  This\n@@ -581,32 +674,62 @@\n    `{:lines [...] :exit 0}` for the host to print and exit with.  A\n    `--dht-key` file is loaded here (`load-key`); the key reaches the\n    shell, and only its principal reaches the options the banner reads.\"\n-  [args]\n-  (try\n-    (if (some #{\"--help\" \"-h\"} args)\n-      {:lines help-lines :exit 0}\n-      (let [[args {:keys [new-key]}] (expand-args args)\n-            made (when (and new-key (nil? (fs/read-file-text\n-                                            (first (split-path new-key))\n-                                            (second (split-path new-key)))))\n-                   (:lines (keygen! new-key)))\n-            opts (cond-> (parse-args args)\n-                   made (assoc :startup-lines made))]\n-        (if-some [path (:dht-keygen opts)]\n-          (keygen! path)\n-          (let [key (some-> (:dht-key-file opts) load-key)\n-                opts (cond-> opts\n-                       key (assoc :publisher (sign/principal (:public key))))]\n-            {:opts opts\n-             :state (boot (assoc opts :dht-key key))\n-             :server (boot-server opts)}))))\n-    (catch #?(:cljd Object\n-              :clj Throwable\n-              :cljs :default)\n-           e\n-      (if (ex-data e)\n-        {:refusal (or (ex-message e) (str e))}\n-        (throw e)))))\n+  ([args] (startup args nil))\n+  ([args {:keys [persist? home]}]\n+   (try\n+     (if (some #{\"--help\" \"-h\"} args)\n+       {:lines help-lines :exit 0}\n+       (let [reset? (boolean (some #{\"--reset\"} args))\n+             no-state? (boolean (some #{\"--no-state\"} args))\n+             [args {:keys [new-key unset] node-name :name dir :dir}]\n+             (expand-args (remove #{\"--reset\" \"--no-state\"} args))\n+             node-dir (when (and persist? (not no-state?)\n+                                 (not (some #{\"--dht-keygen\"} args)))\n+                        (or dir\n+                            (some-> (or home (home-dir*))\n+                                    (str \"/.yin/\" node-name))))\n+             saved (when (and node-dir (not reset?)) (state/load-flags node-dir))\n+             {:keys [flags rest]} (state/split-args args)\n+             resolved (state/resolve-flags saved flags unset)\n+             args (into (state/flags->args resolved) rest)\n+             made (when (and new-key (nil? (fs/read-file-text\n+                                             (first (split-path new-key))\n+                                             (second (split-path new-key)))))\n+                    (:lines (keygen! new-key)))\n+             opts (cond-> (try (parse-args args)\n+                               (catch #?(:cljd Object\n+                                         :clj Throwable\n+                                         :cljs :default)\n+                                      e\n+                                 (throw (if (and saved (ex-data e))\n+                                          (ex-info (str (ex-message e)\n+                                                        \" (with the saved state in \"\n+                                                        (state/path node-dir)\n+                                                        \"; --reset forgets it)\")\n+                                                   (ex-data e))\n+                                          e))))\n+                    made (assoc :startup-lines made))]\n+         (if-some [path (:dht-keygen opts)]\n+           (keygen! path)\n+           (let [key (some-> (:dht-key-file opts) load-key)\n+                 opts (cond-> opts\n+                        key (assoc :publisher (sign/principal (:public key))))\n+                 state' (boot (assoc opts :dht-key key))\n+                 server (boot-server opts)\n+                 lines (when node-dir\n+                         (save-state! node-dir saved resolved reset?))]\n+             {:opts (cond-> opts\n+                      (seq lines) (update :startup-lines\n+                                          #(into (vec %) lines)))\n+              :state state'\n+              :server server}))))\n+     (catch #?(:cljd Object\n+               :clj Throwable\n+               :cljs :default)\n+            e\n+       (if (ex-data e)\n+         {:refusal (or (ex-message e) (str e))}\n+         (throw e))))))\n \n \n (defn- refuse!\n@@ -890,7 +1013,7 @@\n      (defn -main\n        [& args]\n        (let\n-         [started (startup args)]\n+         [started (startup args {:persist? true})]\n          (when (contains? started :exit) (exit-with! started))\n          (if-some\n            [refusal (:refusal started)]\n@@ -1018,7 +1141,7 @@\n \n      (defn -main\n        [& args]\n-       (let [started (startup args)]\n+       (let [started (startup args {:persist? true})]\n          (when (contains? started :exit) (exit-with! started))\n          (if-some [refusal (:refusal started)]\n            (refuse! refusal)\n@@ -1146,7 +1269,7 @@\n \n      (defn -main\n        [& args]\n-       (let [started (startup args)]\n+       (let [started (startup args {:persist? true})]\n          (when (contains? started :exit) (exit-with! started))\n          (if-some [refusal (:refusal started)]\n            (refuse! refusal)\ndiff --git a/src/cljc/yin/repl/state.cljc b/src/cljc/yin/repl/state.cljc\nnew file mode 100644\nindex 00000000..0f1acfee\n--- /dev/null\n+++ b/src/cljc/yin/repl/state.cljc\n@@ -0,0 +1,215 @@\n+(ns yin.repl.state\n+  \"The node's saved configuration: the command line a node was last started\n+   with, kept as EDN in `<node dir>/state.edn` so a bare `yin-repl` starts\n+   the same node again.\n+\n+   The file holds flags, not evaluation state: the index store's durable\n+   directory already recovers what was evaluated.  A run resolves\n+   `saved flags < command-line flags` (a repeated flag's values replace the\n+   saved ones whole), starts from the result, and saves it.  One-shot flags\n+   (`--dht-manifest`, `--dht-keygen`) are never saved.\"\n+  (:require #?(:cljd [clojure.edn :as edn]\n+               :clj [clojure.edn :as edn]\n+               :cljs [cljs.reader :as reader])\n+            #?@(:cljd [[\"dart:io\" :as dart-io]])\n+            [clojure.string :as str]\n+            [dao.space.store.fs :as fs]))\n+\n+\n+(def file-name \"state.edn\")\n+\n+\n+(def version 1)\n+\n+\n+(def ^:private saved-flags\n+  \"The flags a state file keeps, in the order they are re-emitted, and how\n+   each takes its value: one value, a repeated value, or a bare switch.\"\n+  [[\"--index-store\" :value]\n+   [\"--vm\" :value]\n+   [\"--port\" :value]\n+   [\"--headless\" :switch]\n+   [\"--dht-peer\" :many]\n+   [\"--dht-publish\" :switch]\n+   [\"--dht-bind\" :value]\n+   [\"--dht-port\" :value]\n+   [\"--dht-max-inbound-bytes\" :value]\n+   [\"--dht-key\" :value]\n+   [\"--dht-principal\" :many]])\n+\n+\n+(def ^:private kinds (into {} saved-flags))\n+\n+\n+(def ^:private one-shot-flags\n+  \"Flags that take a value but are never saved.\"\n+  #{\"--dht-manifest\" \"--dht-keygen\"})\n+\n+\n+(defn split-args\n+  \"Split `args` into `{:flags {flag value} :rest [arg ...]}`: the flags a\n+   state file keeps (a switch is `true`, a repeated flag a vector) and\n+   everything else, in order, for the arguments parser.  A valued flag with\n+   no value stays in `:rest` so the parser refuses it as it always has.\"\n+  [args]\n+  (loop [args (seq args) flags {} rest []]\n+    (if-let [arg (first args)]\n+      (let [kind (kinds arg)\n+            more (next args)]\n+        (cond\n+          (= :switch kind) (recur more (assoc flags arg true) rest)\n+\n+          (and (#{:value :many} kind) (seq more))\n+          (let [value (first more)]\n+            (recur (next more)\n+                   (if (= :many kind)\n+                     (update flags arg (fnil conj []) value)\n+                     (assoc flags arg value))\n+                   rest))\n+\n+          (and (one-shot-flags arg) (seq more))\n+          (recur (next more) flags (conj rest arg (first more)))\n+\n+          :else (recur more flags (conj rest arg))))\n+      {:flags flags :rest rest})))\n+\n+\n+(defn flags->args\n+  \"The argument vector that says `flags`, in a fixed order.\"\n+  [flags]\n+  (into []\n+        (mapcat (fn [[flag kind]]\n+                  (when-some [v (get flags flag)]\n+                    (case kind\n+                      :switch (when (true? v) [flag])\n+                      :value [flag v]\n+                      :many (mapcat (fn [x] [flag x]) v)))))\n+        saved-flags))\n+\n+\n+(defn resolve-flags\n+  \"The flags this run starts with: `saved` overridden by `explicit`, minus\n+   the `unset` flags a subcommand clears (`dht serve` is never publishing,\n+   whatever was saved).\"\n+  [saved explicit unset]\n+  (apply dissoc (merge saved explicit) unset))\n+\n+\n+(defn changed\n+  \"The flags, sorted, whose value in `resolved` differs from `saved`.\"\n+  [saved resolved]\n+  (->> (concat (keys saved) (keys resolved))\n+       distinct\n+       (remove #(= (get saved %) (get resolved %)))\n+       sort\n+       vec))\n+\n+\n+(defn describe\n+  \"`flags` as one line of `--flag value` text.\"\n+  [flags]\n+  (str/join \", \"\n+            (for [[flag _] saved-flags\n+                  :let [v (get flags flag)]\n+                  :when (some? v)]\n+              (cond\n+                (true? v) flag\n+                (vector? v) (str/join \", \" (map #(str flag \" \" %) v))\n+                :else (str flag \" \" v)))))\n+\n+\n+(defn- config-key\n+  [flag]\n+  (keyword (subs flag 2)))\n+\n+\n+(defn- refuse\n+  [path why]\n+  (ex-info (str \"state file \" path \": \" why \"; --reset replaces it\")\n+           {:path path}))\n+\n+\n+(defn- text->config\n+  \"The flags a state file's text holds, or a refusal naming `path`.\"\n+  [path text]\n+  (let [data (try #?(:cljd (edn/read-string text)\n+                     :clj (edn/read-string text)\n+                     :cljs (reader/read-string text))\n+                  (catch #?(:cljd Object\n+                            :clj Throwable\n+                            :cljs :default)\n+                         _\n+                    (throw (refuse path \"it is not readable EDN\"))))\n+        config (when (map? data) (:config data))]\n+    (cond\n+      (not (and (map? data) (= version (:version data))))\n+      (throw (refuse path (str \"it is not a version-\" version \" state file\")))\n+\n+      (not (map? config))\n+      (throw (refuse path \"it has no :config map\"))\n+\n+      :else\n+      (reduce (fn [flags [k v]]\n+                (let [flag (str \"--\" (name k))\n+                      kind (kinds flag)]\n+                  (cond\n+                    (nil? kind)\n+                    (throw (refuse path (str \"unknown setting \" (pr-str k))))\n+\n+                    (and (= :switch kind) (not (true? v)))\n+                    (throw (refuse path (str (pr-str k) \" must be true\")))\n+\n+                    (and (= :value kind) (not (string? v)))\n+                    (throw (refuse path (str (pr-str k) \" must be a string\")))\n+\n+                    (and (= :many kind)\n+                         (not (and (vector? v) (every? string? v))))\n+                    (throw (refuse path (str (pr-str k) \" must be a vector of\"\n+                                             \" strings\")))\n+\n+                    :else (assoc flags flag v))))\n+              {}\n+              config))))\n+\n+\n+(defn path\n+  \"The state file's path in the node directory `dir`.\"\n+  [dir]\n+  (str dir \"/\" file-name))\n+\n+\n+(defn load-flags\n+  \"The saved flags in the node directory `dir`, or nil when there is no\n+   state file.  A file that cannot be understood is refused, never\n+   skipped.\"\n+  [dir]\n+  (when-some [text (fs/read-file-text dir file-name)]\n+    (text->config (path dir) text)))\n+\n+\n+(defn- mkdirs!\n+  [dir]\n+  #?(:cljd (.createSync (dart-io/Directory. dir) .recursive true)\n+     :clj (.mkdirs (java.io.File. ^String dir))\n+     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n+\n+\n+(defn- render\n+  \"The state file's text, one setting to a line, with no space before a\n+   closing bracket (ClojureDart's EDN reader refuses one).\"\n+  [flags]\n+  (let [entries (for [[flag _] saved-flags\n+                      :let [v (get flags flag)]\n+                      :when (some? v)]\n+                  (str (config-key flag) \" \" (pr-str v)))]\n+    (str \"{:version \" version \"\\n :config {\"\n+         (str/join \"\\n          \" entries)\n+         \"}}\\n\")))\n+\n+\n+(defn save!\n+  \"Write `flags` as the state file of the node directory `dir`, creating the\n+   directory and replacing any earlier file atomically.\"\n+  [dir flags]\n+  (mkdirs! dir)\n+  (fs/atomic-replace! dir file-name (render flags)))\ndiff --git a/src/cljc/yin/vm/docs/yin.repl.md b/src/cljc/yin/vm/docs/yin.repl.md\nindex da1757fd..1e9e18f9 100644\n--- a/src/cljc/yin/vm/docs/yin.repl.md\n+++ b/src/cljc/yin/vm/docs/yin.repl.md\n@@ -44,6 +44,58 @@ Connected to daostream:ws://localhost:8080/repl\n \n An absent URL path means `/repl`; an explicit `/` remains `/`.\n \n+## Saved state\n+\n+A node remembers how it was started. The flags it starts with are saved to\n+`state.edn` in its node directory, `~/.yin/<name>` (`--name`, default `node`;\n+`--dir` names the directory instead), and a bare `yin-repl` starts that node\n+again:\n+\n+```bash\n+yin-repl dht serve --name b --listen 4002 --peer localhost:4001   # saved\n+yin-repl --name b                                                  # resumes it\n+yin-repl --name b --dht-peer 127.0.0.1:4003                        # changes the peer\n+```\n+\n+The banner says what happened: `state: saved to ...` on a first run,\n+`state: resumed from ... (--index-store dht:..., ...)` on a restart, and\n+`; the command line changed --dht-peer; saved` when flags overrode it. The\n+file is plain EDN and may be edited by hand:\n+\n+```clojure\n+{:version 1\n+ :config {:index-store \"dht:/home/me/.yin/b\"\n+          :dht-peer [\"127.0.0.1:4003\"]\n+          :dht-port \"4002\"}}\n+```\n+\n+- **What is saved:** `--index-store`, `--vm`, `--port`, `--headless`,\n+  `--dht-peer`, `--dht-publish`, `--dht-bind`, `--dht-port`,\n+  `--dht-max-inbound-bytes`, `--dht-key` and `--dht-principal`, which is\n+  what the `dht` subcommands expand to. The one-shot `--dht-manifest` and\n+  `--dht-keygen` are never saved. Definitions are not saved here: a durable\n+  index store (`file:` or `dht:`) already keeps what was evaluated. The\n+  evaluator chosen at the prompt with `(vm :type)` is not saved; start with\n+  `--vm` to save one.\n+- **Changing it:** a flag overrides the saved value for that setting, and the\n+  result is saved. A repeated flag (`--dht-peer`, `--dht-principal`)\n+  replaces all of its saved values rather than adding to them. `dht init`\n+  saves publishing; `dht serve` and `dht join` clear it. A bare switch\n+  (`--headless`, `--dht-publish`) cannot be turned off by a flag, so use\n+  `--reset`.\n+- **`--reset`** forgets the saved state and starts from the command line\n+  alone; the result is saved. **`--no-state`** neither reads nor writes it,\n+  for a one-off run.\n+- **Refusals:** a state file that cannot be read, or saved flags that clash\n+  with the command line (saved `--dht-*` flags with `--index-store mem`), refuse\n+  startup, naming the file and `--reset`. A state file that cannot be written\n+  is a warning, and the node still starts.\n+- **Hosts:** ClojureDart has no home directory, so a bare `yin-repl` there\n+  saves nothing unless `--dir` names the node directory.\n+- **One node per directory:** a `file:` or `dht:` store's lock already keeps\n+  one process per directory. A node on the in-memory store has no lock, so\n+  two such processes with the same name would overwrite each other's file.\n+\n ## Protocol and Architecture\n \n **`connect` returns immediately and reports its outcome when known.**\ndiff --git a/test/yin/repl/dht_process_test.clj b/test/yin/repl/dht_process_test.clj\nindex 2ccc821b..1ebbe117 100644\n--- a/test/yin/repl/dht_process_test.clj\n+++ b/test/yin/repl/dht_process_test.clj\n@@ -234,10 +234,11 @@\n \n (defn- spawn!\n   \"Start one REPL process (`command`, a `yin.repl.main` JVM by default),\n-   then `args`.\"\n+   then `args`.  `--no-state` keeps it from reading or writing the user's\n+   saved node state.\"\n   ([label args] (spawn! label (jvm-command) args))\n   ([label command args]\n-   (spawn-command! label (into (vec command) args))))\n+   (spawn-command! label (into (conj (vec command) \"--no-state\") args))))\n \n \n (defn- type!\ndiff --git a/test/yin/repl/main_test.cljc b/test/yin/repl/main_test.cljc\nindex fb45de28..2d8d8cef 100644\n--- a/test/yin/repl/main_test.cljc\n+++ b/test/yin/repl/main_test.cljc\n@@ -1336,7 +1336,8 @@\n                                         \"--peer\" \"localhost:4002\"\n                                         \"--listen\" \"4001\"])\n         opts (repl/parse-args args)]\n-    (is (= {:new-key \"k\"} extra))\n+    (is (= \"k\" (:new-key extra)))\n+    (is (nil? (:unset extra)) \"init publishes, so it unsets nothing\")\n     (is (= \"k\" (:dht-key-file opts)))\n     (is (true? (get-in opts [:index-store-spec :publish?])))\n     (is (= [{:host \"127.0.0.1\" :port 4002}]\n@@ -1347,7 +1348,9 @@\n   (let [[args extra] (repl/expand-args [\"dht\" \"serve\" \"--dir\" \"d\" \"--peer\"\n                                         \"127.0.0.1:4001\" \"--listen\" \"4002\"])\n         spec (:index-store-spec (repl/parse-args args))]\n-    (is (nil? extra))\n+    (is (nil? (:new-key extra)))\n+    (is (= #{\"--dht-publish\"} (:unset extra))\n+        \"serve clears a saved --dht-publish\")\n     (is (false? (:publish? spec)))\n     (is (= 4002 (:bind-port spec)))))\n \n@@ -1376,7 +1379,8 @@\n \n (deftest help-documents-every-flag-and-subcommand\n   (let [text (str/join \"\\n\" repl/help-lines)]\n-    (doseq [word [\"--port\" \"--headless\" \"--index-store\" \"--help\"\n+    (doseq [word [\"--vm\" \"--reset\" \"--no-state\" \"state.edn\" \"--port\"\n+                  \"--headless\" \"--index-store\" \"--help\"\n                   \"--dht-peer\" \"--dht-publish\" \"--dht-bind\" \"--dht-port\"\n                   \"--dht-max-inbound-bytes\" \"--dht-manifest\" \"--dht-key\"\n                   \"--dht-principal\" \"--dht-keygen\" \"--name\" \"--dir\" \"--key\"\ndiff --git a/test/yin/repl/state_test.cljc b/test/yin/repl/state_test.cljc\nnew file mode 100644\nindex 00000000..475dbc74\n--- /dev/null\n+++ b/test/yin/repl/state_test.cljc\n@@ -0,0 +1,164 @@\n+(ns yin.repl.state-test\n+  \"The node's saved configuration (yin.repl.state): the flags a node was last\n+   started with, kept in `<node dir>/state.edn` and resumed by a bare\n+   `yin-repl`, changed by the command line.\"\n+  (:require [clojure.string :as str]\n+            [clojure.test :refer [deftest is testing]]\n+            [dao.space.store.fs :as fs]\n+            [yin.repl.main :as repl]\n+            [yin.repl.state :as state]))\n+\n+\n+(defn- temp-dir\n+  []\n+  (str \"target/test-state-\" (random-uuid)))\n+\n+\n+(defn- refusal-of\n+  [thunk]\n+  (try (thunk) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e e)))\n+\n+\n+(deftest args-split-into-saved-flags-and-the-rest\n+  (let [{:keys [flags rest]}\n+        (state/split-args [\"--port\" \"8080\" \"--headless\" \"--dht-peer\" \"a:1\"\n+                           \"--dht-peer\" \"b:2\" \"--dht-manifest\" \":segment/x\"\n+                           \"--telemetry\" \"--vm\"])]\n+    (is (= {\"--port\" \"8080\" \"--headless\" true \"--dht-peer\" [\"a:1\" \"b:2\"]}\n+           flags))\n+    (testing \"one-shot flags and unknown arguments pass through, in order\"\n+      (is (= [\"--dht-manifest\" \":segment/x\" \"--telemetry\" \"--vm\"] rest)))\n+    (is (= [\"--port\" \"8080\" \"--headless\" \"--dht-peer\" \"a:1\" \"--dht-peer\" \"b:2\"]\n+           (state/flags->args flags))\n+        \"a fixed order, a repeated flag once per value\")))\n+\n+\n+(deftest the-command-line-replaces-saved-values-whole\n+  (let [saved {\"--dht-peer\" [\"a:1\"] \"--dht-publish\" true \"--port\" \"1\"}]\n+    (is (= {\"--dht-peer\" [\"b:2\" \"c:3\"] \"--dht-publish\" true \"--port\" \"1\"}\n+           (state/resolve-flags saved {\"--dht-peer\" [\"b:2\" \"c:3\"]} nil))\n+        \"a repeated flag's values replace the saved ones, not extend them\")\n+    (is (= {\"--dht-peer\" [\"a:1\"] \"--port\" \"1\"}\n+           (state/resolve-flags saved {} #{\"--dht-publish\"}))\n+        \"a subcommand clears a saved switch\")\n+    (is (= [\"--dht-peer\" \"--dht-publish\"]\n+           (state/changed saved {\"--dht-peer\" [\"b:2\"] \"--port\" \"1\"})))))\n+\n+\n+(deftest state-round-trips-through-its-file\n+  (let [dir (temp-dir)\n+        flags {\"--index-store\" \"dht:/tmp/x\" \"--headless\" true\n+               \"--dht-peer\" [\"127.0.0.1:4001\" \"127.0.0.1:4002\"]\n+               \"--dht-publish\" true \"--port\" \"8080\"}]\n+    (is (nil? (state/load-flags dir)) \"no file, no state\")\n+    (state/save! dir flags)\n+    (is (= flags (state/load-flags dir)))\n+    (let [text (fs/read-file-text dir state/file-name)]\n+      (is (str/starts-with? text \"{:version 1\"))\n+      (is (not (re-find #\"\\s[\\]\\}]\" text))\n+          \"no space before a closer: ClojureDart's EDN reader refuses one\"))\n+    (state/save! dir {\"--vm\" \"stack\"})\n+    (is (= {\"--vm\" \"stack\"} (state/load-flags dir)) \"a save replaces the file\")))\n+\n+\n+(deftest an-unreadable-state-file-is-refused-not-skipped\n+  (doseq [[text why] [[\"{:version 1 :config\" \"not readable EDN\"]\n+                      [\"{:version 2 :config {}}\" \"version-1\"]\n+                      [\"{:version 1}\" \":config\"]\n+                      [\"{:version 1 :config {:nonsense \\\"x\\\"}}\" \"unknown setting\"]\n+                      [\"{:version 1 :config {:port 8080}}\" \"must be a string\"]\n+                      [\"{:version 1 :config {:dht-peer \\\"a:1\\\"}}\"\n+                       \"vector of strings\"]\n+                      [\"{:version 1 :config {:headless false}}\" \"must be true\"]]]\n+    (let [dir (temp-dir)]\n+      (state/save! dir {})\n+      (fs/atomic-replace! dir state/file-name text)\n+      (let [e (refusal-of #(state/load-flags dir))]\n+        (is (some? (ex-data e)) text)\n+        (is (str/includes? (ex-message e) why) text)\n+        (is (str/includes? (ex-message e) \"--reset\") text)))))\n+\n+\n+(defn- vm-of\n+  [started]\n+  (get-in started [:state :repl :vm-type]))\n+\n+\n+(defn- banner-of\n+  [started]\n+  (str/join \"\\n\" (repl/banner (:opts started))))\n+\n+\n+(deftest a-bare-start-resumes-the-last-state-and-the-command-line-changes-it\n+  (let [dir (temp-dir)\n+        start (fn [& args]\n+                (repl/startup (into [\"--dir\" dir] args) {:persist? true}))]\n+    (testing \"the first run saves what it started with\"\n+      (let [started (start \"--vm\" \"stack\")]\n+        (is (= :stack (vm-of started)))\n+        (is (str/includes? (banner-of started) \"state: saved to\"))\n+        (is (= {\"--vm\" \"stack\"} (state/load-flags dir)))))\n+    (testing \"a bare start resumes it\"\n+      (let [started (start)]\n+        (is (= :stack (vm-of started)))\n+        (is (str/includes? (banner-of started) \"state: resumed from\"))))\n+    (testing \"the command line changes it, and the change is saved\"\n+      (let [started (start \"--vm\" \"register\")]\n+        (is (= :register (vm-of started)))\n+        (is (str/includes? (banner-of started) \"the command line changed --vm\"))\n+        (is (= :register (vm-of (start))))))\n+    (testing \"--no-state neither reads nor writes\"\n+      (let [started (start \"--no-state\" \"--vm\" \"ast-walker\")]\n+        (is (= :ast-walker (vm-of started)))\n+        (is (not (str/includes? (banner-of started) \"state:\")))\n+        (is (= {\"--vm\" \"register\"} (state/load-flags dir)))))\n+    (testing \"--reset starts from the command line alone and saves that\"\n+      (let [started (start \"--reset\")]\n+        (is (= :semantic (vm-of started)))\n+        (is (= {} (state/load-flags dir)))))))\n+\n+\n+(deftest persistence-is-off-unless-the-host-entry-point-asks\n+  (let [dir (temp-dir)\n+        started (repl/startup [\"--dir\" dir \"--vm\" \"stack\"])]\n+    (is (= :stack (vm-of started)))\n+    (is (nil? (state/load-flags dir)) \"the one-argument startup saves nothing\")))\n+\n+\n+(deftest a-bad-saved-state-or-a-clashing-flag-refuses-startup\n+  (testing \"an unreadable file refuses, naming the file and --reset\"\n+    (let [dir (temp-dir)]\n+      (state/save! dir {})\n+      (fs/atomic-replace! dir state/file-name \"{:version 9}\")\n+      (let [started (repl/startup [\"--dir\" dir] {:persist? true})]\n+        (is (str/includes? (:refusal started) \"state file\"))\n+        (is (str/includes? (:refusal started) \"--reset\")))))\n+  (testing \"saved --dht flags with a store that is not a DHT's refuse, with the\n+            saved state named so --reset is the obvious way out\"\n+    (let [dir (temp-dir)]\n+      (state/save! dir {\"--dht-peer\" [\"127.0.0.1:4001\"]})\n+      (let [started (repl/startup [\"--dir\" dir] {:persist? true})]\n+        (is (str/includes? (:refusal started) \"--index-store dht:<dir>\"))\n+        (is (str/includes? (:refusal started) \"with the saved state in\"))\n+        (is (str/includes? (:refusal started) \"--reset forgets it\")))\n+      (is (some? (:state (repl/startup [\"--dir\" dir \"--reset\"]\n+                                       {:persist? true})))\n+          \"--reset clears the clash\"))))\n+\n+\n+(deftest a-dht-subcommand-resumes-and-serve-stops-publishing\n+  (let [dir (temp-dir)\n+        start (fn [& args] (repl/expand-args args))]\n+    (testing \"init saves publishing; serve unsets it\"\n+      (let [[args extra] (start \"dht\" \"init\" \"--dir\" dir \"--key\" \"k\"\n+                                \"--peer\" \"localhost:4002\")\n+            {:keys [flags]} (state/split-args args)]\n+        (is (true? (get flags \"--dht-publish\")))\n+        (is (= dir (:dir extra))))\n+      (let [[args extra] (start \"dht\" \"serve\" \"--dir\" dir \"--peer\"\n+                                \"localhost:4002\")\n+            saved {\"--dht-publish\" true \"--dht-peer\" [\"127.0.0.1:4002\"]}\n+            resolved (state/resolve-flags saved (:flags (state/split-args args))\n+                                          (:unset extra))]\n+        (is (not (contains? resolved \"--dht-publish\")))\n+        (is (= [\"127.0.0.1:4002\"] (get resolved \"--dht-peer\")))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/state.cljc; nl -ba src/cljc/yin/repl/main.cljc | sed -n '270,510p;650,890p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/state.cljc; nl -ba src/cljc/yin/repl/main.cljc | sed -n '270,510p;650,890p'\"","aggregated_output":"     1\t(ns yin.repl.state\n     2\t  \"The node's saved configuration: the command line a node was last started\n     3\t   with, kept as EDN in `<node dir>/state.edn` so a bare `yin-repl` starts\n     4\t   the same node again.\n     5\t\n     6\t   The file holds flags, not evaluation state: the index store's durable\n     7\t   directory already recovers what was evaluated.  A run resolves\n     8\t   `saved flags < command-line flags` (a repeated flag's values replace the\n     9\t   saved ones whole), starts from the result, and saves it.  One-shot flags\n    10\t   (`--dht-manifest`, `--dht-keygen`) are never saved.\"\n    11\t  (:require #?(:cljd [clojure.edn :as edn]\n    12\t               :clj [clojure.edn :as edn]\n    13\t               :cljs [cljs.reader :as reader])\n    14\t            #?@(:cljd [[\"dart:io\" :as dart-io]])\n    15\t            [clojure.string :as str]\n    16\t            [dao.space.store.fs :as fs]))\n    17\t\n    18\t\n    19\t(def file-name \"state.edn\")\n    20\t\n    21\t\n    22\t(def version 1)\n    23\t\n    24\t\n    25\t(def ^:private saved-flags\n    26\t  \"The flags a state file keeps, in the order they are re-emitted, and how\n    27\t   each takes its value: one value, a repeated value, or a bare switch.\"\n    28\t  [[\"--index-store\" :value]\n    29\t   [\"--vm\" :value]\n    30\t   [\"--port\" :value]\n    31\t   [\"--headless\" :switch]\n    32\t   [\"--dht-peer\" :many]\n    33\t   [\"--dht-publish\" :switch]\n    34\t   [\"--dht-bind\" :value]\n    35\t   [\"--dht-port\" :value]\n    36\t   [\"--dht-max-inbound-bytes\" :value]\n    37\t   [\"--dht-key\" :value]\n    38\t   [\"--dht-principal\" :many]])\n    39\t\n    40\t\n    41\t(def ^:private kinds (into {} saved-flags))\n    42\t\n    43\t\n    44\t(def ^:private one-shot-flags\n    45\t  \"Flags that take a value but are never saved.\"\n    46\t  #{\"--dht-manifest\" \"--dht-keygen\"})\n    47\t\n    48\t\n    49\t(defn split-args\n    50\t  \"Split `args` into `{:flags {flag value} :rest [arg ...]}`: the flags a\n    51\t   state file keeps (a switch is `true`, a repeated flag a vector) and\n    52\t   everything else, in order, for the arguments parser.  A valued flag with\n    53\t   no value stays in `:rest` so the parser refuses it as it always has.\"\n    54\t  [args]\n    55\t  (loop [args (seq args) flags {} rest []]\n    56\t    (if-let [arg (first args)]\n    57\t      (let [kind (kinds arg)\n    58\t            more (next args)]\n    59\t        (cond\n    60\t          (= :switch kind) (recur more (assoc flags arg true) rest)\n    61\t\n    62\t          (and (#{:value :many} kind) (seq more))\n    63\t          (let [value (first more)]\n    64\t            (recur (next more)\n    65\t                   (if (= :many kind)\n    66\t                     (update flags arg (fnil conj []) value)\n    67\t                     (assoc flags arg value))\n    68\t                   rest))\n    69\t\n    70\t          (and (one-shot-flags arg) (seq more))\n    71\t          (recur (next more) flags (conj rest arg (first more)))\n    72\t\n    73\t          :else (recur more flags (conj rest arg))))\n    74\t      {:flags flags :rest rest})))\n    75\t\n    76\t\n    77\t(defn flags->args\n    78\t  \"The argument vector that says `flags`, in a fixed order.\"\n    79\t  [flags]\n    80\t  (into []\n    81\t        (mapcat (fn [[flag kind]]\n    82\t                  (when-some [v (get flags flag)]\n    83\t                    (case kind\n    84\t                      :switch (when (true? v) [flag])\n    85\t                      :value [flag v]\n    86\t                      :many (mapcat (fn [x] [flag x]) v)))))\n    87\t        saved-flags))\n    88\t\n    89\t\n    90\t(defn resolve-flags\n    91\t  \"The flags this run starts with: `saved` overridden by `explicit`, minus\n    92\t   the `unset` flags a subcommand clears (`dht serve` is never publishing,\n    93\t   whatever was saved).\"\n    94\t  [saved explicit unset]\n    95\t  (apply dissoc (merge saved explicit) unset))\n    96\t\n    97\t\n    98\t(defn changed\n    99\t  \"The flags, sorted, whose value in `resolved` differs from `saved`.\"\n   100\t  [saved resolved]\n   101\t  (->> (concat (keys saved) (keys resolved))\n   102\t       distinct\n   103\t       (remove #(= (get saved %) (get resolved %)))\n   104\t       sort\n   105\t       vec))\n   106\t\n   107\t\n   108\t(defn describe\n   109\t  \"`flags` as one line of `--flag value` text.\"\n   110\t  [flags]\n   111\t  (str/join \", \"\n   112\t            (for [[flag _] saved-flags\n   113\t                  :let [v (get flags flag)]\n   114\t                  :when (some? v)]\n   115\t              (cond\n   116\t                (true? v) flag\n   117\t                (vector? v) (str/join \", \" (map #(str flag \" \" %) v))\n   118\t                :else (str flag \" \" v)))))\n   119\t\n   120\t\n   121\t(defn- config-key\n   122\t  [flag]\n   123\t  (keyword (subs flag 2)))\n   124\t\n   125\t\n   126\t(defn- refuse\n   127\t  [path why]\n   128\t  (ex-info (str \"state file \" path \": \" why \"; --reset replaces it\")\n   129\t           {:path path}))\n   130\t\n   131\t\n   132\t(defn- text->config\n   133\t  \"The flags a state file's text holds, or a refusal naming `path`.\"\n   134\t  [path text]\n   135\t  (let [data (try #?(:cljd (edn/read-string text)\n   136\t                     :clj (edn/read-string text)\n   137\t                     :cljs (reader/read-string text))\n   138\t                  (catch #?(:cljd Object\n   139\t                            :clj Throwable\n   140\t                            :cljs :default)\n   141\t                         _\n   142\t                    (throw (refuse path \"it is not readable EDN\"))))\n   143\t        config (when (map? data) (:config data))]\n   144\t    (cond\n   145\t      (not (and (map? data) (= version (:version data))))\n   146\t      (throw (refuse path (str \"it is not a version-\" version \" state file\")))\n   147\t\n   148\t      (not (map? config))\n   149\t      (throw (refuse path \"it has no :config map\"))\n   150\t\n   151\t      :else\n   152\t      (reduce (fn [flags [k v]]\n   153\t                (let [flag (str \"--\" (name k))\n   154\t                      kind (kinds flag)]\n   155\t                  (cond\n   156\t                    (nil? kind)\n   157\t                    (throw (refuse path (str \"unknown setting \" (pr-str k))))\n   158\t\n   159\t                    (and (= :switch kind) (not (true? v)))\n   160\t                    (throw (refuse path (str (pr-str k) \" must be true\")))\n   161\t\n   162\t                    (and (= :value kind) (not (string? v)))\n   163\t                    (throw (refuse path (str (pr-str k) \" must be a string\")))\n   164\t\n   165\t                    (and (= :many kind)\n   166\t                         (not (and (vector? v) (every? string? v))))\n   167\t                    (throw (refuse path (str (pr-str k) \" must be a vector of\"\n   168\t                                             \" strings\")))\n   169\t\n   170\t                    :else (assoc flags flag v))))\n   171\t              {}\n   172\t              config))))\n   173\t\n   174\t\n   175\t(defn path\n   176\t  \"The state file's path in the node directory `dir`.\"\n   177\t  [dir]\n   178\t  (str dir \"/\" file-name))\n   179\t\n   180\t\n   181\t(defn load-flags\n   182\t  \"The saved flags in the node directory `dir`, or nil when there is no\n   183\t   state file.  A file that cannot be understood is refused, never\n   184\t   skipped.\"\n   185\t  [dir]\n   186\t  (when-some [text (fs/read-file-text dir file-name)]\n   187\t    (text->config (path dir) text)))\n   188\t\n   189\t\n   190\t(defn- mkdirs!\n   191\t  [dir]\n   192\t  #?(:cljd (.createSync (dart-io/Directory. dir) .recursive true)\n   193\t     :clj (.mkdirs (java.io.File. ^String dir))\n   194\t     :cljs (.mkdirSync (js/require \"fs\") dir #js {:recursive true})))\n   195\t\n   196\t\n   197\t(defn- render\n   198\t  \"The state file's text, one setting to a line, with no space before a\n   199\t   closing bracket (ClojureDart's EDN reader refuses one).\"\n   200\t  [flags]\n   201\t  (let [entries (for [[flag _] saved-flags\n   202\t                      :let [v (get flags flag)]\n   203\t                      :when (some? v)]\n   204\t                  (str (config-key flag) \" \" (pr-str v)))]\n   205\t    (str \"{:version \" version \"\\n :config {\"\n   206\t         (str/join \"\\n          \" entries)\n   207\t         \"}}\\n\")))\n   208\t\n   209\t\n   210\t(defn save!\n   211\t  \"Write `flags` as the state file of the node directory `dir`, creating the\n   212\t   directory and replacing any earlier file atomically.\"\n   213\t  [dir flags]\n   214\t  (mkdirs! dir)\n   215\t  (fs/atomic-replace! dir file-name (render flags)))\n   270\t(defn- home-dir*\n   271\t  \"The user's home directory, or nil where the host has none (ClojureDart).\"\n   272\t  []\n   273\t  #?(:cljd nil\n   274\t     :clj (System/getProperty \"user.home\")\n   275\t     :cljs (some-> js/process .-env .-HOME)))\n   276\t\n   277\t\n   278\t(defn- home-dir\n   279\t  []\n   280\t  (or (home-dir*)\n   281\t      (throw (ex-info (str \"no home directory on this host: give --dir and \"\n   282\t                           \"--key explicitly\")\n   283\t                      {}))))\n   284\t\n   285\t\n   286\t(defn- state-path\n   287\t  \"`~/.yin/<name><suffix>`.\"\n   288\t  [name suffix]\n   289\t  (str (home-dir) \"/.yin/\" name suffix))\n   290\t\n   291\t\n   292\t(defn- peer-text\n   293\t  \"A peer as the DHT takes it: `localhost` is the loopback IP literal.\"\n   294\t  [text]\n   295\t  (str/replace-first (str text) #\"^localhost:\" \"127.0.0.1:\"))\n   296\t\n   297\t\n   298\t(defn parse-token\n   299\t  \"A join token `yin:host:port/principal/segment/...` as `[peer principal\n   300\t   manifest]` flag values; the principal accepts an `ed25519:` prefix.\"\n   301\t  [text]\n   302\t  (let [[_ peer principal manifest]\n   303\t        (re-matches #\"yin:([^/]+)/(?:ed25519:)?([^/]+)/(.+)\" (str text))]\n   304\t    (when-not peer\n   305\t      (throw (ex-info (str \"a join token looks like yin:host:port/principal/\"\n   306\t                           \"segment/..., as `dht: join token:` prints it, \"\n   307\t                           \"not \" (pr-str text))\n   308\t                      {:value text})))\n   309\t    [peer principal manifest]))\n   310\t\n   311\t\n   312\t(defn- keygen-args\n   313\t  [args]\n   314\t  (loop [args (seq args) name nil file nil]\n   315\t    (if-let [arg (first args)]\n   316\t      (if (= \"--name\" arg)\n   317\t        (recur (nnext args) (second args) file)\n   318\t        (recur (next args) name arg))\n   319\t      [\"--dht-keygen\" (or file (state-path (or name \"publisher\") \".key\"))])))\n   320\t\n   321\t\n   322\t(defn- dht-args\n   323\t  \"The legacy flags of `dht init|serve|join`.  `init` publishes (its key is\n   324\t   made on first use); `serve` stores for others; `join <token>` reads.\n   325\t   Every node needs a `--peer` to open a socket (the two-node start in\n   326\t   yin.repl.md); `--listen [ip:]port` is the node's own address.  Returns\n   327\t   `[args {:new-key path}]`.\"\n   328\t  [[verb & args]]\n   329\t  (when-not (#{\"init\" \"serve\" \"join\"} verb)\n   330\t    (throw (ex-info \"usage: yin-repl dht init|serve|join [token] [options]\"\n   331\t                    {})))\n   332\t  (loop [args (seq args)\n   333\t         o {:name \"node\" :peers [] :rest []}]\n   334\t    (if-let [arg (first args)]\n   335\t      (let [v (second args)]\n   336\t        (case arg\n   337\t          \"--name\" (recur (nnext args) (assoc o :name v))\n   338\t          \"--dir\" (recur (nnext args) (assoc o :dir v))\n   339\t          \"--key\" (recur (nnext args) (assoc o :key v))\n   340\t          \"--peer\" (recur (nnext args) (update o :peers conj (peer-text v)))\n   341\t          \"--listen\" (recur (nnext args) (assoc o :listen v))\n   342\t          (if (and (= \"join\" verb) (not (:token o))\n   343\t                   (not (str/starts-with? arg \"-\")))\n   344\t            (recur (next args) (assoc o :token arg))\n   345\t            (recur (next args) (update o :rest conj arg)))))\n   346\t      (let [{:keys [name dir key peers listen token rest]} o\n   347\t            [tpeer principal manifest] (when (= \"join\" verb)\n   348\t                                         (parse-token token))\n   349\t            peers (cond-> peers tpeer (conj tpeer))\n   350\t            [_ lhost lport] (when listen\n   351\t                              (re-matches #\"(?:(.+):)?(\\d+)\" listen))\n   352\t            key (or key (when (= \"init\" verb) (state-path name \".key\")))]\n   353\t        [(cond-> [\"--index-store\" (str \"dht:\" (or dir (state-path name \"\")))]\n   354\t           (= \"init\" verb) (conj \"--dht-publish\")\n   355\t           key (into [\"--dht-key\" key])\n   356\t           lhost (into [\"--dht-bind\" lhost])\n   357\t           lport (into [\"--dht-port\" lport])\n   358\t           principal (into [\"--dht-principal\" principal])\n   359\t           manifest (into [\"--dht-manifest\" manifest])\n   360\t           true (into (mapcat #(vector \"--dht-peer\" %)) peers)\n   361\t           true (into rest))\n   362\t         {:new-key (when (= \"init\" verb) key)\n   363\t          :name name\n   364\t          :dir (or dir (state-path name \"\"))\n   365\t          ;; only `init` publishes: a saved --dht-publish must not survive\n   366\t          ;; `serve` or `join`\n   367\t          :unset (when-not (= \"init\" verb) #{\"--dht-publish\"})}]))))\n   368\t\n   369\t\n   370\t(defn- plain-args\n   371\t  \"The plain form's `--name n` and `--dir d`, which name the node directory\n   372\t   its state file lives in (default `~/.yin/node`), removed from `args`.\n   373\t   Answers `[args extra]`.\"\n   374\t  [args]\n   375\t  (loop [args (seq args) rest [] node-name \"node\" dir nil]\n   376\t    (if-let [arg (first args)]\n   377\t      (case arg\n   378\t        \"--name\" (if (next args)\n   379\t                   (recur (nnext args) rest (second args) dir)\n   380\t                   (recur (next args) (conj rest arg) node-name dir))\n   381\t        \"--dir\" (if (next args)\n   382\t                  (recur (nnext args) rest node-name (second args))\n   383\t                  (recur (next args) (conj rest arg) node-name dir))\n   384\t        (recur (next args) (conj rest arg) node-name dir))\n   385\t      [rest {:name node-name :dir dir}])))\n   386\t\n   387\t\n   388\t(defn expand-args\n   389\t  \"Turn the subcommand surface into the flags `parse-args` reads:\n   390\t   `keygen [--name n | file]` and `dht init|serve|join`.  Anything else\n   391\t   passes through unchanged.  Answers `[args extra]`, `extra` carrying what\n   392\t   the arguments say beyond flags: `:new-key` (a key file `init` makes),\n   393\t   `:name` and `:dir` (the node directory), and `:unset` (saved flags the\n   394\t   subcommand clears).\"\n   395\t  [args]\n   396\t  (case (first args)\n   397\t    \"keygen\" [(keygen-args (rest args)) nil]\n   398\t    \"dht\" (dht-args (rest args))\n   399\t    (plain-args args)))\n   400\t\n   401\t\n   402\t(defn- parse-vm\n   403\t  \"A `--vm` value as the evaluator keyword the shell takes.\"\n   404\t  [text]\n   405\t  (let [vm-type (some-> text keyword)]\n   406\t    (if (contains? shell/vm-labels vm-type)\n   407\t      vm-type\n   408\t      (throw (ex-info (str \"--vm takes one of \"\n   409\t                           (str/join \", \" (map name (sort (keys shell/vm-labels))))\n   410\t                           \", not \" (pr-str text))\n   411\t                      {:value text})))))\n   412\t\n   413\t\n   414\t(defn parse-args\n   415\t  \"Parse the host arguments.  `--telemetry` and `--telemetry-stream` are\n   416\t   rejected rather than ignored.  `--index-store` is parsed into\n   417\t   `:index-store-spec`: `:mem` (also what omission means),\n   418\t   `{:type :file :dir dir}`, or the DHT store `{:type :dht :dir dir ...}`;\n   419\t   and a missing value, an unknown scheme, or an empty directory is\n   420\t   refused here, by `yin.repl.store/parse-arg`, before any host composes.\n   421\t\n   422\t   The DHT store's options are their own flags (yin.repl.dht):\n   423\t   `--dht-peer host:port`, repeatable, the bootstrap contacts; none\n   424\t   means solo, with no socket; `--dht-publish`, the separate declaration\n   425\t   that shares the store; `--dht-bind ip` and `--dht-port p`, the\n   426\t   socket's address, loopback and ephemeral unless given;\n   427\t   `--dht-max-inbound-bytes n`, the inbound storage bound; and\n   428\t   `--dht-manifest address`, a remote index to hydrate before the first\n   429\t   evaluation; `--dht-key file`, the publisher's stable key file\n   430\t   (yin.vm.linker.dht.md 6.5); and `--dht-principal hex`, repeatable, a\n   431\t   publisher whose signed names this node honors (7.1).  Any of them\n   432\t   without `dht:<dir>` is refused.  `--dht-keygen file` writes a new key\n   433\t   file and exits.\"\n   434\t  [args]\n   435\t  (loop [args (seq args)\n   436\t         opts {:headless? false :host nil :port nil :rejected []\n   437\t               :index-store-spec :mem}\n   438\t         dht {:flags #{} :peers []}]\n   439\t    (if-let [arg (first args)]\n   440\t      (let [dht (cond-> dht (dht-flags arg) (update :flags conj arg))\n   441\t            value (second args)]\n   442\t        (case arg\n   443\t          \"--port\" (recur (nnext args)\n   444\t                          (assoc opts :port (when-let [p (second args)]\n   445\t                                              #?(:cljd (int/parse p)\n   446\t                                                 :cljs (js/parseInt p 10)\n   447\t                                                 :clj (Long/parseLong p))))\n   448\t                          dht)\n   449\t          \"--host\" (throw (ex-info (str \"--host is gone: --port serves on all \"\n   450\t                                        \"interfaces, so it answers on \"\n   451\t                                        \"localhost and on this machine's IP\")\n   452\t                                   {}))\n   453\t          \"--headless\" (recur (next args) (assoc opts :headless? true) dht)\n   454\t          \"--vm\" (recur (nnext args)\n   455\t                        (assoc opts :vm-type (parse-vm (second args)))\n   456\t                        dht)\n   457\t          \"--index-store\" (recur (nnext args)\n   458\t                                 (assoc opts\n   459\t                                        :index-store-spec\n   460\t                                        (store/parse-arg (second args)))\n   461\t                                 dht)\n   462\t          \"--dht-peer\" (recur (nnext args) opts\n   463\t                              (update dht :peers conj (parse-peer value)))\n   464\t          \"--dht-publish\" (recur (next args) opts (assoc dht :publish? true))\n   465\t          \"--dht-bind\" (recur (nnext args) opts\n   466\t                              (assoc dht :bind-host (str value)))\n   467\t          \"--dht-port\" (recur (nnext args) opts\n   468\t                              (assoc dht :bind-port (dht-number arg value)))\n   469\t          \"--dht-max-inbound-bytes\" (recur (nnext args) opts\n   470\t                                           (assoc dht :max-inbound-bytes\n   471\t                                                  (dht-number arg value)))\n   472\t          \"--dht-manifest\" (recur (nnext args) opts\n   473\t                                  (assoc dht :manifest (parse-manifest value)))\n   474\t          \"--dht-key\" (recur (nnext args)\n   475\t                             (assoc opts :dht-key-file\n   476\t                                    (or value\n   477\t                                        (throw (ex-info\n   478\t                                                 \"--dht-key needs a key file\"\n   479\t                                                 {}))))\n   480\t                             dht)\n   481\t          \"--dht-principal\" (recur (nnext args)\n   482\t                                   (update opts :principals (fnil conj [])\n   483\t                                           (parse-principal value))\n   484\t                                   dht)\n   485\t          \"--dht-keygen\" (recur (nnext args)\n   486\t                                (assoc opts :dht-keygen\n   487\t                                       (or value\n   488\t                                           (throw (ex-info\n   489\t                                                    \"--dht-keygen needs a file\"\n   490\t                                                    {}))))\n   491\t                                dht)\n   492\t          \"--telemetry\" (recur (next args) (update opts :rejected conj arg) dht)\n   493\t          \"--telemetry-stream\" (recur (nnext args)\n   494\t                                      (update opts :rejected conj arg) dht)\n   495\t          (recur (next args) (update opts :extra (fnil conj []) arg) dht)))\n   496\t      (update opts :index-store-spec dht-spec dht))))\n   497\t\n   498\t\n   499\t(defn boot\n   500\t  \"Create the composition: one shell, one input medium, one cursor held only by\n   501\t   the step owner, and the host WebSocket adapter `(connect ...)` attaches\n   502\t   through.  The parsed `:index-store-spec` reaches the shell's store\n   503\t   selection, which resolves and opens it once at construction.\"\n   504\t  ([] (boot {}))\n   505\t  ([opts] (driver/create-state\n   506\t            {:host (or (:adapter opts) (host/websocket))\n   507\t             :repl (shell/create-state\n   508\t                     (cond-> {:index-store-spec (:index-store-spec opts)\n   509\t                              :dht-key (:dht-key opts)\n   510\t                              :principals (:principals opts)}\n   650\t                  \"; saved\")])\n   651\t\n   652\t        :else\n   653\t        [(str \"state: resumed from \" path \" (\" (state/describe resolved) \")\")])\n   654\t      (catch #?(:cljd Object\n   655\t                :clj Throwable\n   656\t                :cljs :default)\n   657\t             e\n   658\t        [(str \"state: WARNING: could not save \" path \": \"\n   659\t              (or (ex-message e) (str e)))]))))\n   660\t\n   661\t\n   662\t(defn startup\n   663\t  \"Parse the arguments and compose the whole shell (the store the parsed\n   664\t   `:index-store-spec` names included), or answer the refusal text.  This\n   665\t   is the one gate every host's `-main` passes through before it prints a\n   666\t   banner or starts a loop, so an invalid `--index-store`, an unsupported\n   667\t   host for it, or a directory that cannot be opened refuses startup with\n   668\t   its reason rather than composing a shell around a fallback store.\n   669\t\n   670\t   Only a designed refusal is answered: an error carrying no ex-info\n   671\t   keeps its stack trace, because it is a defect, not an operator error.\n   672\t\n   673\t   `--dht-keygen` composes nothing: it writes the key file and answers\n   674\t   `{:lines [...] :exit 0}` for the host to print and exit with.  A\n   675\t   `--dht-key` file is loaded here (`load-key`); the key reaches the\n   676\t   shell, and only its principal reaches the options the banner reads.\"\n   677\t  ([args] (startup args nil))\n   678\t  ([args {:keys [persist? home]}]\n   679\t   (try\n   680\t     (if (some #{\"--help\" \"-h\"} args)\n   681\t       {:lines help-lines :exit 0}\n   682\t       (let [reset? (boolean (some #{\"--reset\"} args))\n   683\t             no-state? (boolean (some #{\"--no-state\"} args))\n   684\t             [args {:keys [new-key unset] node-name :name dir :dir}]\n   685\t             (expand-args (remove #{\"--reset\" \"--no-state\"} args))\n   686\t             node-dir (when (and persist? (not no-state?)\n   687\t                                 (not (some #{\"--dht-keygen\"} args)))\n   688\t                        (or dir\n   689\t                            (some-> (or home (home-dir*))\n   690\t                                    (str \"/.yin/\" node-name))))\n   691\t             saved (when (and node-dir (not reset?)) (state/load-flags node-dir))\n   692\t             {:keys [flags rest]} (state/split-args args)\n   693\t             resolved (state/resolve-flags saved flags unset)\n   694\t             args (into (state/flags->args resolved) rest)\n   695\t             made (when (and new-key (nil? (fs/read-file-text\n   696\t                                             (first (split-path new-key))\n   697\t                                             (second (split-path new-key)))))\n   698\t                    (:lines (keygen! new-key)))\n   699\t             opts (cond-> (try (parse-args args)\n   700\t                               (catch #?(:cljd Object\n   701\t                                         :clj Throwable\n   702\t                                         :cljs :default)\n   703\t                                      e\n   704\t                                 (throw (if (and saved (ex-data e))\n   705\t                                          (ex-info (str (ex-message e)\n   706\t                                                        \" (with the saved state in \"\n   707\t                                                        (state/path node-dir)\n   708\t                                                        \"; --reset forgets it)\")\n   709\t                                                   (ex-data e))\n   710\t                                          e))))\n   711\t                    made (assoc :startup-lines made))]\n   712\t         (if-some [path (:dht-keygen opts)]\n   713\t           (keygen! path)\n   714\t           (let [key (some-> (:dht-key-file opts) load-key)\n   715\t                 opts (cond-> opts\n   716\t                        key (assoc :publisher (sign/principal (:public key))))\n   717\t                 state' (boot (assoc opts :dht-key key))\n   718\t                 server (boot-server opts)\n   719\t                 lines (when node-dir\n   720\t                         (save-state! node-dir saved resolved reset?))]\n   721\t             {:opts (cond-> opts\n   722\t                      (seq lines) (update :startup-lines\n   723\t                                          #(into (vec %) lines)))\n   724\t              :state state'\n   725\t              :server server}))))\n   726\t     (catch #?(:cljd Object\n   727\t               :clj Throwable\n   728\t               :cljs :default)\n   729\t            e\n   730\t       (if (ex-data e)\n   731\t         {:refusal (or (ex-message e) (str e))}\n   732\t         (throw e))))))\n   733\t\n   734\t\n   735\t(defn- refuse!\n   736\t  \"Print why the composition refused to start and end the process with a\n   737\t   failing status, so a refused startup never looks like a working shell.\"\n   738\t  [refusal]\n   739\t  (println refusal)\n   740\t  #?(:cljd (io/exit 1)\n   741\t     :clj (.halt (Runtime/getRuntime) 1)\n   742\t     :cljs (.exit js/process 1)))\n   743\t\n   744\t\n   745\t(defn close-index-store!\n   746\t  \"Release the index store's lifecycle resources before the host exits\n   747\t   (in durable mode, the exclusive directory lock).  The shell has already\n   748\t   stopped when a host calls this; the memory store has nothing to\n   749\t   release.\"\n   750\t  [state]\n   751\t  (store/close! (get-in state [:repl :index-store])))\n   752\t\n   753\t\n   754\t(defn- entry-text\n   755\t  [entry]\n   756\t  (or (get entry driver/text-key) (get entry serve/text-key)))\n   757\t\n   758\t\n   759\t(defn banner\n   760\t  \"Text the composition prints before the first prompt, given parsed\n   761\t   options.  A DHT store states here (before its node steps once, so\n   762\t   before anything is shared) what it will share: the whole store when\n   763\t   `--dht-publish` is given, nothing otherwise (yin.repl.dht/banner).\"\n   764\t  [opts]\n   765\t  (let [spec (:index-store-spec opts)\n   766\t        dht? (= :dht (:type spec))]\n   767\t    (cond-> (vec (:startup-lines opts))\n   768\t      (seq (:rejected opts)) (conj telemetry-text)\n   769\t      (:port opts)\n   770\t      (conj (str \"serving on all interfaces: ws://127.0.0.1:\" (:port opts)\n   771\t                 (let [ip (local-ip)]\n   772\t                   (if (= \"127.0.0.1\" ip)\n   773\t                     \" and ws://<this machine's IP>:\"\n   774\t                     (str \" and ws://\" ip \":\")))\n   775\t                 (:port opts)\n   776\t                 \". Anyone who can reach this port can evaluate code in this\"\n   777\t                 \" shell; there is no authentication.\"))\n   778\t      (and (:headless? opts) (not (:port opts)))\n   779\t      (conj \"--headless has nothing to attend without a served endpoint\")\n   780\t      dht? (into (repl.dht/banner spec))\n   781\t      (and dht? (:publish? spec))\n   782\t      (conj (str \"dht: the code index and the code itself are shared: every\"\n   783\t                 \" evaluated program's rows are written to the index store\"\n   784\t                 \" each round\"))\n   785\t      (and dht? (:publisher opts))\n   786\t      (conj (str \"dht: names published here are signed by principal \"\n   787\t                 (:publisher opts) \" (key from \" (:dht-key-file opts) \")\"))\n   788\t      (and dht? (not (:publisher opts)))\n   789\t      (conj (str \"dht: no --dht-key: (yin.link/publish ...) is refused; names\"\n   790\t                 \" are still read, resolved, loaded and linked\")))))\n   791\t\n   792\t\n   793\t(defn- exit-with!\n   794\t  \"Print a composition that ends at startup -- `--dht-keygen` -- and end\n   795\t   the process with its status.\"\n   796\t  [{:keys [lines exit]}]\n   797\t  (doseq [line lines]\n   798\t    (println line))\n   799\t  #?(:cljd (io/exit exit)\n   800\t     :clj (.halt (Runtime/getRuntime) (int exit))\n   801\t     :cljs (.exit js/process exit)))\n   802\t\n   803\t\n   804\t(defn step-all\n   805\t  \"One tick of the single step owner: the local shell first, then the served\n   806\t   endpoint, against the same shell value.  A DHT index store's node is stepped\n   807\t   first (yin.repl.dht/step): its lines print before the shell's, a\n   808\t   hydration still outstanding leaves every typed line waiting in the\n   809\t   input medium, and a refused one stops the shell.  A `--port` process\n   810\t   serves one shared shell, as v1's atom made it: the driver evaluates this\n   811\t   tick's local\n   812\t   lines first, so a definition typed at the local prompt is already in the\n   813\t   shell the endpoint evaluates remote requests against in the same tick, and\n   814\t   the endpoint's shell (remote definitions included) is threaded back\n   815\t   before the next tick.  A require parked on a closure load the node ended this\n   816\t   tick is re-checked once, before any typed line, with no line of its\n   817\t   own (yin.repl/recheck-on-load-events, yin.vm.linker.dht.md 8.2): its\n   818\t   text prints after the node's lines.  Returns `[state server lines]`;\n   819\t   the caller only prints.\"\n   820\t  [state server now]\n   821\t  (let [[repl dht-lines events] (repl.dht/step (:repl state) now)\n   822\t        state (assoc state :repl repl)]\n   823\t    (cond\n   824\t      (repl.dht/refusal repl)\n   825\t      [(assoc state :running? false) server dht-lines]\n   826\t\n   827\t      (not (repl.dht/admitting? repl))\n   828\t      [state server dht-lines]\n   829\t\n   830\t      :else\n   831\t      (let [[repl rechecked] (shell/recheck-on-load-events repl events)\n   832\t            dht-lines (cond-> dht-lines\n   833\t                        (seq rechecked) (conj rechecked))\n   834\t            state (assoc state :repl repl)\n   835\t            stepped (driver/repl-step state now)\n   836\t            [entries state'] (driver/take-outbox stepped)\n   837\t            server' (when server\n   838\t                      (serve/step (assoc-in server [:repl] (:repl state'))\n   839\t                                  now))\n   840\t            [server-entries server''] (if server'\n   841\t                                        (serve/take-outbox server')\n   842\t                                        [[] nil])\n   843\t            state'' (if server'' (assoc state' :repl (:repl server'')) state')]\n   844\t        [state'' server'' (into dht-lines\n   845\t                                (map entry-text)\n   846\t                                (into (vec entries) server-entries))]))))\n   847\t\n   848\t\n   849\t(defn moved?\n   850\t  \"The tick owner's cadence bit, computed from this tick's own results: true\n   851\t   when there are lines to print, when the endpoint reports movement (a\n   852\t   woken probe, a published notice), or when either composition still owes a\n   853\t   write.  A pending write keeps cadence at the base interval; it must never\n   854\t   wait out a backoff ceiling.\"\n   855\t  [state server lines]\n   856\t  (boolean (or (seq lines)\n   857\t               (driver/pending-write? state)\n   858\t               (repl.dht/busy? (:repl state))\n   859\t               (and server (serve/moved? server)))))\n   860\t\n   861\t\n   862\t(defn exit-status\n   863\t  \"The process status a host exits with once the shell stops: 1 when the\n   864\t   DHT store refused after startup (a failed bind, a hydration that could\n   865\t   not complete), else 0.\"\n   866\t  [state]\n   867\t  (if (repl.dht/refusal (:repl state)) 1 0))\n   868\t\n   869\t\n   870\t;; =============================================================================\n   871\t;; Shutdown\n   872\t;; =============================================================================\n   873\t\n   874\t(def stop-ticks\n   875\t  \"How many ticks a host steps a stopping endpoint before exiting anyway.  The\n   876\t   endpoint's `:stopped` fact comes from the host's own close completion, which\n   877\t   a wedged listener may never deposit; the shell says so and exits rather than\n   878\t   hanging on it.\"\n   879\t  200)\n   880\t\n   881\t\n   882\t(def stop-timeout-text\n   883\t  \";; the endpoint did not report :stopped; exiting anyway\")\n   884\t\n   885\t\n   886\t(def stop-join-millis\n   887\t  \"How long a host thread may wait for the step owner to finish shutdown.\n   888\t\n   889\t   The drain performs `stop-ticks + 1` steps with a sleep between them, so it\n   890\t   needs strictly more than `tick-millis x stop-ticks`; a join of exactly that\n","exit_code":0,"status":"completed"}}
