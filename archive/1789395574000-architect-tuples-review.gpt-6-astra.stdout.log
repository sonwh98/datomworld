   117	(defn- derive-next-t
   118	  "Derive the next transaction time from a flattened retained history: 0 for
   119	   an empty history, else 1 + the maximum datom t. A datom t that is not a
   120	   non-negative integer is a malformed history and throws — this scan is the
   121	   causality boundary of the value."
   122	  [datoms]
   123	  (if (empty? datoms)
   124	    0
   125	    (let [ts (mapv index/datom-t datoms)]
   126	      (when-not (every? #(and (integer? %) (<= 0 %)) ts)
   127	        (throw
   128	          (ex-info
   129	            "malformed retained history: datom t must be a non-negative integer"
   130	            {:history datoms})))
   131	      (inc (reduce max ts)))))
