    76	(defn current-state-seq
    77	  "Takes a sequence of canonical d5 datoms and returns the sequence of
    78	   currently-asserted datoms. Facts are keyed by local [e a v]: the greatest
    79	   t wins within each key, and two rows sharing [e a v t] but differing in m
    80	   are conflicting transaction history and are rejected (metadata is not an
    81	   implicit tie-break). Retractions are removed; the result is EAVT-ordered."
    82	  [s]
    83	  (->> (reduce
    84	         (fn [acc d]
    85	           (let [key [(index/datom-e d) (index/datom-a d) (index/datom-v d)]]
    86	             (update
    87	               acc
    88	               key
    89	               (fn [winner]
    90	                 (cond (nil? winner) d
    91	                       (< (index/datom-t winner) (index/datom-t d)) d
    92	                       (> (index/datom-t winner) (index/datom-t d)) winner
    93	                       (not= (index/datom-m winner) (index/datom-m d))
    94	                       (throw
    95	                         (ex-info
    96	                           "conflicting d5 rows: same [e a v t], different m"
    97	                           {:a winner, :b d}))
    98	                       :else winner)))))
    99	         {}
   100	         s)
   101	       (vals)
   102	       (remove datom/retracted?)
   103	       (sort index/eavt-cmp)))
