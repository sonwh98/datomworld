    74	(defn- pad-datom
    75	  "Pad [e a v] / [e a v t m] to the canonical 5-tuple. The transactor owns
    76	   transaction time: a non-nil explicit t is rejected, a nil t is stamped
    77	   with the allocated `t`. A nil m takes the default assertion op; an
    78	   explicit m (0, a retraction) is preserved."
    79	  [d t]
    80	  (let [[e a v dt dm] d]
    81	    (when-not (nil? dt)
    82	      (throw
    83	        (ex-info
    84	          "the transactor owns transaction time: explicit datom t is rejected"
    85	          {:datom d})))
    86	    (let [padded [e a v t (if (nil? dm) datom/default-op dm)]]
    87	      (when-not (datom/local-datom? padded)
    88	        (throw (ex-info "invalid persistent local datom"
    89	                        {:datom padded, :input d})))
    90	      padded)))
