    61	  "The m (metadata/op) slot of a datom (a [e a v t m] vector or a Datom record)."
    62	  [datom]
    63	  (if (map? datom) (:m datom) (nth datom 4)))
    64	
    65	
    66	(defn asserted?
    67	  [datom]
    68	  (= (op datom) (:db/assert reserved)))
    69	
    70	
    71	(defn retracted?
    72	  [datom]
    73	  (= (op datom) (:db/retract reserved)))
    74	
    75	
    76	(defn derived?
    77	  [datom]
    78	  (= (op datom) (:db/derived reserved)))
    79	
    80	
    81	(def markers
    82	  "The reserved op/derived marker ids. These are validity/derivation flags, not
    83	   references to real metadata entities."
    84	  (set (vals reserved)))
    85	
