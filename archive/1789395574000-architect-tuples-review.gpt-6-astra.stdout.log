   419	(defn- parse-tuple-pattern
   420	  "Parse exact positional syntax plus an optional final `& tail`."
   421	  [pattern]
   422	  (let [pattern (vec pattern)
   423	        amps (vec (keep-indexed #(when (= '& %2) %1) pattern))]
   424	    (cond
   425	      (empty? amps) {:fixed pattern, :rest nil}
   426	      (or (not= 1 (count amps)) (not= (first amps) (- (count pattern) 2)))
   427	      (throw
   428	        (ex-info
   429	          "Malformed tuple rest pattern: & must precede one final tail form"
   430	          {:pattern pattern}))
   431	      :else (let [tail (peek pattern)]
   432	              (when-not (or (= tail '_) (query-var-symbol? tail))
   433	                (throw (ex-info
   434	                         "Tuple rest pattern tail must be _ or a query variable"
   435	                         {:pattern pattern, :tail tail})))
   436	              {:fixed (subvec pattern 0 (first amps)), :rest tail}))))
