{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/remote_meet_test.cljc | sed -n '90,390p'\"","aggregated_output":"    90\t  ([t] (attacher-for t {}))\n    91\t  ([t opts]\n    92\t   (remote/attacher\n    93\t     (merge opts {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))))\n    94\t\n    95\t\n    96\t(defn- attach\n    97\t  [attach! t identity]\n    98\t  (:dao.stream/handle\n    99\t    (attach! {:dao.stream/type :dao.stream/remote\n   100\t              :dao.stream/identity identity\n   101\t              :dao.stream/channel (:channel t)})))\n   102\t\n   103\t\n   104\t(defn- values\n   105\t  [h]\n   106\t  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n   107\t         acc []]\n   108\t    (let [r (stream/next h c)]\n   109\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n   110\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n   111\t        acc))))\n   112\t\n   113\t\n   114\t(defn- oldest-cursor!\n   115\t  \"The reflection's :oldest cursor, resolved: sent, served, then\n   116\t   re-asked so the filed answer is returned, exactly the two-call\n   117\t   idiom every reflection read needs.\"\n   118\t  [r peer]\n   119\t  (serve! peer)\n   120\t  (stream/cursor r :dao.stream/oldest)\n   121\t  (serve! peer)\n   122\t  (:dao.stream/cursor (stream/cursor r :dao.stream/oldest)))\n   123\t\n   124\t\n   125\t(defn- read-all!\n   126\t  \"Drain reflection `r`'s served stream fully to `:dao.stream/blocked`,\n   127\t   serving `peer` between reads as needed, returning every value seen.\n   128\t   A blocked read is retried, served, once more before treating the\n   129\t   stream as caught up -- the same send-then-ask idiom `next` needs\n   130\t   throughout dao.stream.remote-test.\"\n   131\t  [r peer]\n   132\t  (loop [c (oldest-cursor! r peer) acc [] stalled 0]\n   133\t    (if (>= stalled 3)\n   134\t      acc\n   135\t      (let [n (stream/next r c)]\n   136\t        (case (:dao.stream/outcome n)\n   137\t          :dao.stream/ok (recur (:dao.stream/cursor n)\n   138\t                                (conj acc (:dao.stream/value n)) 0)\n   139\t          :dao.stream/blocked (do (serve! peer) (recur c acc (inc stalled)))\n   140\t          acc)))))\n   141\t\n   142\t\n   143\t;; =============================================================================\n   144\t;; The meeting and its lease judge, wired together\n   145\t;; =============================================================================\n   146\t\n   147\t(defn- resolver\n   148\t  [source _fact]\n   149\t  source)\n   150\t\n   151\t\n   152\t(defn- meeting-system\n   153\t  \"M's meeting state plus a composed lease judge over fresh ring\n   154\t   buffers, `reclaim-fn` closing over the meeting: `m`'s own reclaim\n   155\t   dissoc's a pair's two identities from `table` and decrements\n   156\t   `active-pairs`, both this namespace's own bookkeeping.\"\n   157\t  [{:keys [max-pairs duration tolerance holder fanout]}]\n   158\t  (let [table (atom {})\n   159\t        board (ring 32)\n   160\t        requests (ring 32)\n   161\t        decision (ring 1)\n   162\t        judge-atom (atom nil)\n   163\t        m (meet/meeting {:requests requests :board board :table table\n   164\t                         :capacity 8 :max-pairs max-pairs\n   165\t                         :decision decision :judge-atom judge-atom\n   166\t                         :duration duration :ring! ring :self :M\n   167\t                         :fanout fanout})\n   168\t        ticks (ring 16)\n   169\t        facts (ring 16)\n   170\t        writer (ring 16)\n   171\t        judge-config (lease/make-judge\n   172\t                       {:cadence {:ms 1} :units {:ms 1}\n   173\t                        :tolerance tolerance\n   174\t                        :resolver resolver\n   175\t                        :resolver-bindings #{:per-author-media}\n   176\t                        :reclaim (meet/reclaim-fn m)\n   177\t                        :writer writer\n   178\t                        :self :M\n   179\t                        :ticks [{:handle ticks\n   180\t                                 :cursor (:dao.stream/cursor\n   181\t                                           (stream/cursor\n   182\t                                             ticks :dao.stream/oldest))}]\n   183\t                        :media [{:handle facts\n   184\t                                 :cursor (:dao.stream/cursor\n   185\t                                           (stream/cursor\n   186\t                                             facts :dao.stream/oldest))\n   187\t                                 :source holder\n   188\t                                 :medium {:retention :evict-oldest\n   189\t                                          :capacity 8\n   190\t                                          :value-domain :portable-values\n   191\t                                          :attribution :per-author-media}}]})]\n   192\t    (reset! judge-atom (:judge judge-config))\n   193\t    {:m m :table table :board board :requests requests :decision decision\n   194\t     :ticks ticks :facts facts :judge-step (:step judge-config)\n   195\t     :judge-atom judge-atom}))\n   196\t\n   197\t\n   198\t(defn- meet-table\n   199\t  [sys]\n   200\t  (merge (meet/entries {:requests (:requests sys) :board (:board sys)\n   201\t                        :decision (:decision sys)})\n   202\t         @(:table sys)))\n   203\t\n   204\t\n   205\t(defn- tick!\n   206\t  [sys ms]\n   207\t  (stream/append! (:ticks sys) (lease/tick {:ms ms}))\n   208\t  (swap! (:judge-atom sys) (:judge-step sys)))\n   209\t\n   210\t\n   211\t;; =============================================================================\n   212\t;; A meet/here posting carries the observed address, not a claim\n   213\t;; =============================================================================\n   214\t\n   215\t(deftest meet-here-tags-the-observed-address-test\n   216\t  (let [toy-a (toy \"addr-a\")\n   217\t        toy-b (toy \"addr-b\")\n   218\t        sys (meeting-system {:max-pairs 10 :duration {:ms 100}\n   219\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   220\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   221\t        peer-b (served-peer (atom (meet-table sys)) toy-b)\n   222\t        ra-req (attach (attacher-for toy-a) toy-a :meet-requests)\n   223\t        rb-req (attach (attacher-for toy-b) toy-b :meet-requests)]\n   224\t    (stream/append! ra-req {:meet/here \"peer-a\"})\n   225\t    (serve! peer-a)\n   226\t    (stream/append! rb-req {:meet/here \"peer-b\"})\n   227\t    (serve! peer-b)\n   228\t    (meet/step! (:m sys))\n   229\t    (let [postings (values (:board sys))]\n   230\t      (is (= #{(address toy-a) (address toy-b)}\n   231\t             (into #{} (map :meet/reflexive postings)))\n   232\t          \"the board carries the channel identity M itself observed\n   233\t           for each peer -- neither payload named an address at all\")\n   234\t      (is (= #{\"peer-a\" \"peer-b\"} (into #{} (map :meet/seen postings))))\n   235\t      (is (not-any? #(contains? % :dao.lease/lease) postings)\n   236\t          \"a registration is a board record, not a lease: no lease id\n   237\t           is minted for it, nothing granted, nothing judged\"))))\n   238\t\n   239\t\n   240\t;; =============================================================================\n   241\t;; Bounded meeting work: the gate refuses past the bound, present\n   242\t;; =============================================================================\n   243\t\n   244\t(deftest bound-gate-refuses-past-the-bound-test\n   245\t  (let [toy-a (toy \"addr-a\")\n   246\t        sys (meeting-system {:max-pairs 1 :duration {:ms 1000}\n   247\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   248\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   249\t        events (ring 16)\n   250\t        ra-req (attach (attacher-for toy-a\n   251\t                                     {:dao.stream.remote/events events})\n   252\t                       toy-a :meet-requests)]\n   253\t    (meet/step! (:m sys))\n   254\t    (testing \"within the bound, the first ask's append! is honored\"\n   255\t      (stream/append! ra-req {:meet/pair \"peer-b\"})\n   256\t      (serve! peer-a)\n   257\t      (stream/descriptor ra-req)\n   258\t      (is (= :dao.stream/ok (:dao.stream/outcome (last (values events))))\n   259\t          \"the server's own answer to the append!, seen on the event\n   260\t           writer -- the reflection's own append! return is only the\n   261\t           local send's acceptance, never the server's answer\")\n   262\t      (meet/step! (:m sys))\n   263\t      (is (= 1 (meet/active-pairs (:m sys)))))\n   264\t    (testing \"past the bound, the gate refuses the append! itself,\n   265\t              present, not silent -- observed on the event writer,\n   266\t              never as a filed answer a later op returns\"\n   267\t      ;; one further step! publishes the decision reflecting the\n   268\t      ;; grant just above -- the gate reads only what was already\n   269\t      ;; published, never the meeting's own live state directly\n   270\t      (meet/step! (:m sys))\n   271\t      (stream/append! ra-req {:meet/pair \"peer-c\"})\n   272\t      (serve! peer-a)\n   273\t      (stream/descriptor ra-req)\n   274\t      (is (= :dao.stream/refused (:dao.stream/outcome (last (values events))))\n   275\t          \"the append! itself was refused, not merely its request\n   276\t           unhonored\"))))\n   277\t\n   278\t\n   279\t;; =============================================================================\n   280\t;; Bounded meeting work: capacity holds at grant time\n   281\t;; =============================================================================\n   282\t\n   283\t(deftest grant-time-capacity-refuses-excess-test\n   284\t  (let [toy-a (toy \"addr-a\")\n   285\t        toy-b (toy \"addr-b\")\n   286\t        sys (meeting-system {:max-pairs 1 :duration {:ms 1000}\n   287\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   288\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   289\t        peer-b (served-peer (atom (meet-table sys)) toy-b)\n   290\t        events-a (ring 16)\n   291\t        events-b (ring 16)\n   292\t        attach-a! (attacher-for toy-a\n   293\t                                {:dao.stream.remote/events events-a})\n   294\t        attach-b! (attacher-for toy-b\n   295\t                                {:dao.stream.remote/events events-b})\n   296\t        ra-req (attach attach-a! toy-a :meet-requests)\n   297\t        rb-req (attach attach-b! toy-b :meet-requests)\n   298\t        ra-board (attach attach-a! toy-a :meet-board)\n   299\t        rb-board (attach attach-b! toy-b :meet-board)]\n   300\t    ;; one step! publishes the count that still has room: both asks\n   301\t    ;; are accepted against that one publication, both queued\n   302\t    (meet/step! (:m sys))\n   303\t    (stream/append! ra-req {:meet/pair \"peer-b\"})\n   304\t    (serve! peer-a)\n   305\t    (stream/descriptor ra-req)\n   306\t    (stream/append! rb-req {:meet/pair \"peer-c\"})\n   307\t    (serve! peer-b)\n   308\t    (stream/descriptor rb-req)\n   309\t    (testing \"both asks were accepted: the gate had one published\n   310\t              count with room, and it is never asked retroactively\"\n   311\t      (is (= :dao.stream/ok (:dao.stream/outcome (last (values events-a)))))\n   312\t      (is (= :dao.stream/ok (:dao.stream/outcome (last (values events-b))))))\n   313\t    (meet/step! (:m sys))\n   314\t    (testing \"capacity enforced at grant time: the first ask is\n   315\t              granted, every excess one refused, a present answer the\n   316\t              asker reads through its own reflection\"\n   317\t      (is (= 1 (meet/active-pairs (:m sys)))\n   318\t          \"one grant, not two: the second could not exceed max-pairs\")\n   319\t      (let [seen-a (read-all! ra-board peer-a)\n   320\t            seen-b (read-all! rb-board peer-b)\n   321\t            grant-a (first (filter #(and (contains? % :dao.lease/grant)\n   322\t                                         (= (address toy-a)\n   323\t                                            (:meet/asker %)))\n   324\t                                   seen-a))\n   325\t            refusal-b (first (filter #(and (contains? % :meet/refused)\n   326\t                                           (= (address toy-b)\n   327\t                                              (:meet/asker %)))\n   328\t                                     seen-b))]\n   329\t        (is (= \"peer-b\" (:meet/pair-for grant-a))\n   330\t            \"the ask that arrived first was granted, its posting\n   331\t             naming A the asker M itself observed\")\n   332\t        (is (= 1 (count (filter #(contains? % :meet/refused) seen-b)))\n   333\t            \"the queued excess ask was refused, not silently dropped\")\n   334\t        (is (= \"peer-c\" (:meet/pair-for refusal-b))\n   335\t            \"the refusal names the ask it refuses\")\n   336\t        (is (= :dao.stream.remote-meet/past-bound\n   337\t               (:meet/refused refusal-b))\n   338\t            \"and why, present on the board the asker's own reflection\n   339\t             reads\")\n   340\t        (is (some #(contains? % :dao.lease/grant) seen-b)\n   341\t            \"the board is one shared stream: B reads A's grant too --\n   342\t             the refusal is what answers B's own ask\")))))\n   343\t\n   344\t\n   345\t;; =============================================================================\n   346\t;; Bounded meeting work: the fanout of one driver step\n   347\t;; =============================================================================\n   348\t\n   349\t(deftest fanout-bounds-one-step-test\n   350\t  (let [toy-a (toy \"addr-a\")\n   351\t        sys (meeting-system {:max-pairs 10 :duration {:ms 1000}\n   352\t                             :tolerance {:ms 0} :holder (address toy-a)\n   353\t                             :fanout 2})\n   354\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   355\t        attach-a! (attacher-for toy-a)\n   356\t        ra-req (attach attach-a! toy-a :meet-requests)\n   357\t        ra-board (attach attach-a! toy-a :meet-board)]\n   358\t    (stream/append! ra-req {:meet/here \"a\"})\n   359\t    (stream/append! ra-req {:meet/here \"b\"})\n   360\t    (stream/append! ra-req {:meet/here \"c\"})\n   361\t    (stream/append! ra-req {:meet/here \"d\"})\n   362\t    (serve! peer-a)\n   363\t    (meet/step! (:m sys))\n   364\t    (is (= [\"a\" \"b\"] (mapv :meet/seen (read-all! ra-board peer-a)))\n   365\t        \"one pass handles exactly its fanout: two of the four queued\n   366\t         asks answered, the drain stopped there, not run to blocked\")\n   367\t    (meet/step! (:m sys))\n   368\t    (is (= [\"a\" \"b\" \"c\" \"d\"]\n   369\t           (mapv :meet/seen (read-all! ra-board peer-a)))\n   370\t        \"the remainder is handled on the next pass, in order -- the\n   371\t         cursor was preserved where the fanout spent itself\")))\n   372\t\n   373\t\n   374\t;; =============================================================================\n   375\t;; The simulated network: two peers behind NATs, M the meeting peer\n   376\t;; =============================================================================\n   377\t\n   378\t(defn- nat-net\n   379\t  \"The simulated public internet between two peers, each behind its\n   380\t   own NAT, with `kind` the filtering behavior under simulation.\n   381\t   `:restricted` is outbound-only: a datagram is delivered only when\n   382\t   the receiving socket has itself sent to the sender's address\n   383\t   before, so each peer's requests reach M over the channel it\n   384\t   dialed while direct peer-to-peer is refused until both sides have\n   385\t   punched. `:symmetric` is endpoint-dependent mapping and filtering\n   386\t   on both sides: the address a peer is reachable on is a mapping\n   387\t   per destination, so the reflexive address the meeting peer\n   388\t   observed matches no mapping peer to peer and no direct datagram\n   389\t   is ever delivered -- relay is forced. Sends ride :flight until a\n   390\t   `nat-step!` filters them; a refused datagram is recorded in\n","exit_code":0,"status":"completed"}}
