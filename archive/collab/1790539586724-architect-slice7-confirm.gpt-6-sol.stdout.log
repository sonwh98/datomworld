{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/remote_meet_test.cljc | sed -n '450,760p'\"","aggregated_output":"   450\t    {:delivered (count yes) :dropped (count no)}))\n   451\t\n   452\t\n   453\t(defn- direct-peer\n   454\t  \"One peer's end of the simulated direct wire: `inbound` the ring\n   455\t   its mirror reads datagrams from, its answers leaving through the\n   456\t   NAT writer toward the other peer's address, over an empty table\n   457\t   of its own -- a peer serving nothing under the punched identity\n   458\t   answers not-found, an answer like any other (section 4: a path\n   459\t   exists when an answer, even a not-found error, carrying one of\n   460\t   this peer's outstanding ids arrives). Served with `serve!` like\n   461\t   any peer.\"\n   462\t  [net who inbound]\n   463\t  (let [other (get {:a :b :b :a} who)]\n   464\t    {:table (atom {})\n   465\t     :reader inbound\n   466\t     :writer (nat-writer net who (get-in @net [:addr other]))\n   467\t     :mirror (atom (:dao.stream/cursor\n   468\t                     (stream/cursor inbound :dao.stream/oldest)))}))\n   469\t\n   470\t\n   471\t(defn- punch-request\n   472\t  \"The descriptor request the punch sends, one fresh id per send\n   473\t   (section 4: each side sends a descriptor request with a fresh id\n   474\t   to the other's reflexive address): the identity named is the\n   475\t   asker's own, one the answering peer serves nothing under, whose\n   476\t   not-found is still the answer that confirms the path.\"\n   477\t  [who id]\n   478\t  {:dao.stream/identity (str \"punch-\" (name who))\n   479\t   :dao.stream.remote/op :dao.stream/descriptor\n   480\t   :dao.stream.remote/args []\n   481\t   :dao.stream.remote/id id})\n   482\t\n   483\t\n   484\t(defn- relay-outer\n   485\t  \"The outer descriptor one peer attaches for the relay: a pair\n   486\t   channel descriptor over `channel`, this peer's own channel to M,\n   487\t   reading `read-id` and writing `write-id` -- the same two table\n   488\t   identities the board posted, named through this peer's channel\n   489\t   (2.2: two remote descriptors naming one identity through different\n   490\t   channels reach one stream). The outer identity is the service the\n   491\t   pair reaches, because the attach probe must name an identity the\n   492\t   far side serves.\"\n   493\t  [channel identity read-id write-id]\n   494\t  {:dao.stream/type :dao.stream/remote\n   495\t   :dao.stream/identity identity\n   496\t   :dao.stream/channel\n   497\t   {:dao.stream/type :dao.stream/pair\n   498\t    :dao.stream/identity (str identity \"-pair\")\n   499\t    :dao.stream.remote/in\n   500\t    {:dao.stream/type :dao.stream/remote\n   501\t     :dao.stream/identity read-id\n   502\t     :dao.stream/channel channel}\n   503\t    :dao.stream.remote/out\n   504\t    {:dao.stream/type :dao.stream/remote\n   505\t     :dao.stream/identity write-id\n   506\t     :dao.stream/channel channel}}})\n   507\t\n   508\t\n   509\t;; =============================================================================\n   510\t;; restricted NAT, outbound-only: the punch is direct, after the meet\n   511\t;; =============================================================================\n   512\t\n   513\t(deftest restricted-nat-punch-test\n   514\t  (let [toy-a (toy \"addr-a\")\n   515\t        toy-b (toy \"addr-b\")\n   516\t        sys (meeting-system {:max-pairs 10 :duration {:ms 1000}\n   517\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   518\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   519\t        peer-b (served-peer (atom (meet-table sys)) toy-b)\n   520\t        attach-a! (attacher-for toy-a)\n   521\t        attach-b! (attacher-for toy-b)\n   522\t        ra-req (attach attach-a! toy-a :meet-requests)\n   523\t        rb-req (attach attach-b! toy-b :meet-requests)\n   524\t        ra-board (attach attach-a! toy-a :meet-board)\n   525\t        rb-board (attach attach-b! toy-b :meet-board)\n   526\t        net (nat-net :restricted (address toy-a) (address toy-b))\n   527\t        in-a (ring 16)\n   528\t        in-b (ring 16)\n   529\t        direct-a (direct-peer net :a in-a)\n   530\t        direct-b (direct-peer net :b in-b)]\n   531\t    (stream/append! ra-req {:meet/here \"peer-a\"})\n   532\t    (serve! peer-a)\n   533\t    (stream/append! rb-req {:meet/here \"peer-b\"})\n   534\t    (serve! peer-b)\n   535\t    (meet/step! (:m sys))\n   536\t    (let [postings-a (read-all! ra-board peer-a)\n   537\t          postings-b (read-all! rb-board peer-b)\n   538\t          addr-of-a (:meet/reflexive\n   539\t                      (first (filter #(= \"peer-a\" (:meet/seen %))\n   540\t                                     postings-b)))\n   541\t          addr-of-b (:meet/reflexive\n   542\t                      (first (filter #(= \"peer-b\" (:meet/seen %))\n   543\t                                     postings-a)))]\n   544\t      (testing \"each peer learned the other's address only from the\n   545\t                board, and it is the address M itself observed\"\n   546\t        (is (= (address toy-a) addr-of-a))\n   547\t        (is (= (address toy-b) addr-of-b)))\n   548\t      (testing \"outbound-only is real: a lone direct send before any\n   549\t                punch is refused by B's NAT -- nothing lands, the\n   550\t                drop a recorded fact\"\n   551\t        (stream/append! (nat-writer net :a addr-of-b)\n   552\t                        (punch-request :a 101))\n   553\t        (let [r (nat-step! net {:a in-a :b in-b})]\n   554\t          (is (= 0 (:delivered r)))\n   555\t          (is (= 1 (:dropped r)))\n   556\t          (is (empty? (values in-b))\n   557\t              \"B observed nothing: the request never crossed\")))\n   558\t      (testing \"the punch, a coordinated simultaneous send: each\n   559\t                peer sends its descriptor request to the address the\n   560\t                board carried; both mappings now exist, both deliver\"\n   561\t        (stream/append! (nat-writer net :a addr-of-b)\n   562\t                        (punch-request :a 102))\n   563\t        (stream/append! (nat-writer net :b addr-of-a)\n   564\t                        (punch-request :b 201))\n   565\t        (let [r (nat-step! net {:a in-a :b in-b})]\n   566\t          (is (= 2 (:delivered r)))\n   567\t          (is (= 0 (:dropped r))))\n   568\t        (serve! direct-b)\n   569\t        (serve! direct-a)\n   570\t        (nat-step! net {:a in-a :b in-b})\n   571\t        (testing \"the direct request-answer sequences: each peer\n   572\t                  holds an answer carrying its own outstanding id\n   573\t                  from the other's address -- a path exists, the\n   574\t                  whole of STUN as facts on a stream\"\n   575\t          (let [from-b (values in-a)\n   576\t                from-a (values in-b)\n   577\t                ;; each ring carries the other side's punch request\n   578\t                ;; as well -- the datagrams both ways -- the answers\n   579\t                ;; being the values that carry an error\n   580\t                answers (fn [vs]\n   581\t                          (filter #(contains? % :dao.stream.remote/error)\n   582\t                                  vs))]\n   583\t            (is (= [102] (mapv :dao.stream.remote/id (answers from-b)))\n   584\t                \"A holds B's answer to its punch, correlated by the\n   585\t                 id A minted\")\n   586\t            (is (every? #(= :dao.stream.remote/not-found\n   587\t                            (:dao.stream.remote/error %))\n   588\t                        (answers from-b))\n   589\t                \"B serves nothing under the punched identity: the\n   590\t                 not-found error is still the confirming answer\")\n   591\t            (is (= [201] (mapv :dao.stream.remote/id (answers from-a)))\n   592\t                \"and B holds A's answer to its punch the same way\")\n   593\t            (is (every? #(= :dao.stream.remote/not-found\n   594\t                            (:dao.stream.remote/error %))\n   595\t                        (answers from-a)))\n   596\t            (is (= 1 (count (:drops @net)))\n   597\t                \"exactly the lone pre-punch send was ever refused;\n   598\t                 nothing of the punch or its answers was\")))))))\n   599\t\n   600\t\n   601\t;; =============================================================================\n   602\t;; symmetric NAT: the direct path is refused, the relay carries\n   603\t;; =============================================================================\n   604\t\n   605\t(deftest symmetric-nat-forced-relay-test\n   606\t  (let [toy-a (toy \"addr-a\")\n   607\t        toy-b (toy \"addr-b\")\n   608\t        sys (meeting-system {:max-pairs 10 :duration {:ms 1000}\n   609\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   610\t        table-atom (atom (meet-table sys))\n   611\t        peer-a (served-peer table-atom toy-a)\n   612\t        peer-b (served-peer table-atom toy-b)\n   613\t        attach-a! (attacher-for toy-a)\n   614\t        attach-b! (attacher-for toy-b)\n   615\t        ra-req (attach attach-a! toy-a :meet-requests)\n   616\t        rb-req (attach attach-b! toy-b :meet-requests)\n   617\t        ra-board (attach attach-a! toy-a :meet-board)\n   618\t        rb-board (attach attach-b! toy-b :meet-board)\n   619\t        net (nat-net :symmetric (address toy-a) (address toy-b))\n   620\t        in-a (ring 16)\n   621\t        in-b (ring 16)]\n   622\t    (stream/append! ra-req {:meet/here \"peer-a\"})\n   623\t    (serve! peer-a)\n   624\t    (stream/append! rb-req {:meet/here \"peer-b\"})\n   625\t    (serve! peer-b)\n   626\t    (meet/step! (:m sys))\n   627\t    (let [postings-a (read-all! ra-board peer-a)\n   628\t          postings-b (read-all! rb-board peer-b)\n   629\t          addr-of-a (:meet/reflexive\n   630\t                      (first (filter #(= \"peer-a\" (:meet/seen %))\n   631\t                                     postings-b)))\n   632\t          addr-of-b (:meet/reflexive\n   633\t                      (first (filter #(= \"peer-b\" (:meet/seen %))\n   634\t                                     postings-a)))]\n   635\t      (testing \"symmetric NAT refuses the direct path both ways,\n   636\t                even with both mappings punched -- the reflexive\n   637\t                address M observed is a mapping for M, for neither\n   638\t                peer; punching is unreliable and relay is forced\"\n   639\t        (stream/append! (nat-writer net :a addr-of-b)\n   640\t                        (punch-request :a 301))\n   641\t        (stream/append! (nat-writer net :b addr-of-a)\n   642\t                        (punch-request :b 401))\n   643\t        (let [r (nat-step! net {:a in-a :b in-b})]\n   644\t          (is (= 0 (:delivered r)))\n   645\t          (is (= 2 (:dropped r)))\n   646\t          (is (empty? (values in-a)))\n   647\t          (is (empty? (values in-b)))))\n   648\t      ;; A asks for the pair; M grants, posts, and the board carries\n   649\t      (stream/append! ra-req {:meet/pair \"peer-b\"})\n   650\t      (serve! peer-a)\n   651\t      (meet/step! (:m sys))\n   652\t      (reset! table-atom (meet-table sys))\n   653\t      (let [post-a (first (filter #(contains? % :meet/pair-for)\n   654\t                                  (read-all! ra-board peer-a)))\n   655\t            post-b (first (filter #(contains? % :meet/pair-for)\n   656\t                                  (read-all! rb-board peer-b)))\n   657\t            pair-id (:dao.lease/lease post-b)\n   658\t            in-id (get-in post-a [:dao.stream.remote/in\n   659\t                                  :dao.stream/identity])\n   660\t            out-id (get-in post-a [:dao.stream.remote/out\n   661\t                                   :dao.stream/identity])\n   662\t            ;; B, the asked-for peer, mirrors in and out into its own\n   663\t            ;; pair end: reading out, writing in, over the same two\n   664\t            ;; buffers, and serves one stream of its own behind its\n   665\t            ;; NAT -- the service the relay exists to reach\n   666\t            scratch (ring 8)\n   667\t            b-table (atom {\"b-svc\" {:handle scratch\n   668\t                                    :surface #{:reader :writer}}})\n   669\t            b-read (attach attach-b! toy-b out-id)\n   670\t            b-write (attach attach-b! toy-b in-id)\n   671\t            relay-mirror (atom (oldest-cursor! b-read peer-b))\n   672\t            serve-relay! (fn []\n   673\t                           (swap! relay-mirror\n   674\t                                  #(remote/mirror-step @b-table\n   675\t                                                       b-read %\n   676\t                                                       b-write)))\n   677\t            churn! (fn []\n   678\t                     (serve! peer-a)\n   679\t                     (serve! peer-b)\n   680\t                     (serve-relay!))\n   681\t            relay-read-all!\n   682\t            (fn [r]\n   683\t              (let [ask!\n   684\t                    (fn []\n   685\t                      (loop [n 0]\n   686\t                        (stream/cursor r :dao.stream/oldest)\n   687\t                        (dotimes [_ 4] (churn!))\n   688\t                        (or (:dao.stream/cursor\n   689\t                              (stream/cursor r :dao.stream/oldest))\n   690\t                            (when (< n 6) (recur (inc n))))))]\n   691\t                (loop [c (ask!) acc [] stalled 0]\n   692\t                  (if (or (nil? c) (>= stalled 6))\n   693\t                    acc\n   694\t                    (let [n (stream/next r c)]\n   695\t                      (if (= :dao.stream/ok (:dao.stream/outcome n))\n   696\t                        (recur (:dao.stream/cursor n)\n   697\t                               (conj acc (:dao.stream/value n))\n   698\t                               0)\n   699\t                        (do (dotimes [_ 4] (churn!))\n   700\t                            (recur c acc (inc stalled)))))))))\n   701\t            attach-pair-a! (pair/attacher\n   702\t                             {:dao.stream.remote.pair/attach! attach-a!})\n   703\t            ra-svc (:dao.stream/handle\n   704\t                     (attach-pair-a!\n   705\t                       (relay-outer (:channel toy-a) \"b-svc\"\n   706\t                                    in-id out-id)))]\n   707\t        (is (some? post-a) \"the relay grant was posted on the board\")\n   708\t        (is (= pair-id (:dao.lease/lease post-a))\n   709\t            \"both peers read the one grant, each through its own\n   710\t             reflection\")\n   711\t        (testing \"A attaches a pair channel over the posted\n   712\t                  descriptors, riding dao.stream.remote-pair's own\n   713\t                  convention\"\n   714\t          (is (= :dao.stream/ok\n   715\t                 (:dao.stream/outcome (stream/descriptor ra-svc)))\n   716\t              \"attached ok at once, the deferred confirmation\"))\n   717\t        (testing \"the relay exchange through the granted pair\"\n   718\t          (stream/append! scratch\n   719\t                          {:relay/from \"peer-b\" :relay/text \"hello\"})\n   720\t          (is (= [{:relay/from \"peer-b\" :relay/text \"hello\"}]\n   721\t                 (relay-read-all! ra-svc))\n   722\t              \"A reads B's own stream through the granted pair: the\n   723\t               request rode A's channel to M's out ring, B's mirrored\n   724\t               pair end fetched and answered it, M interpreting\n   725\t               nothing it relayed\")\n   726\t          (stream/append! ra-svc\n   727\t                          {:relay/from \"peer-a\" :relay/text \"ping\"})\n   728\t          (dotimes [_ 6] (churn!))\n   729\t          (is (= [{:relay/from \"peer-a\" :relay/text \"ping\"}]\n   730\t                 (rest (values scratch)))\n   731\t              \"and B's own stream carries A's request: the exchange\n   732\t               is two-way, both ends writing through the pair\")\n   733\t          (stream/append! scratch\n   734\t                          {:relay/from \"peer-b\" :relay/text \"pong\"})\n   735\t          (is (= [{:relay/from \"peer-b\" :relay/text \"hello\"}\n   736\t                  {:relay/from \"peer-a\" :relay/text \"ping\"}\n   737\t                  {:relay/from \"peer-b\" :relay/text \"pong\"}]\n   738\t                 (relay-read-all! ra-svc))\n   739\t              \"the full request-answer sequence through the granted\n   740\t               pair, read from the start: B's hello, A's ping -- A's\n   741\t               own write comes back through the pair, it rode B's\n   742\t               stream -- and B's pong, with the direct path refused\n   743\t               by the simulation above; the relay carried every\n   744\t               value, the board only introduced the peers\"))))))\n   745\t\n   746\t\n   747\t;; =============================================================================\n   748\t;; A pair whose holder stops renewing answers not-found\n   749\t;; =============================================================================\n   750\t\n   751\t(deftest lease-reclaim-as-not-found-test\n   752\t  (let [toy-a (toy \"addr-a\")\n   753\t        sys (meeting-system {:max-pairs 10 :duration {:ms 10}\n   754\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   755\t        table-atom (atom (meet-table sys))\n   756\t        peer-a (served-peer table-atom toy-a)\n   757\t        attach-a! (attacher-for toy-a)\n   758\t        ra-req (attach attach-a! toy-a :meet-requests)]\n   759\t    (stream/append! ra-req {:meet/pair \"peer-b\"})\n   760\t    (serve! peer-a)\n","exit_code":0,"status":"completed"}}
