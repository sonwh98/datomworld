{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '674,745p'; nl -ba test/yin/vm/ucf/remote_test.cljc | sed -n '509,620p;753,835p'\"","aggregated_output":"   674\t(defn lower-frame\n   675\t  \"A whole frame set of S7.4.3 pendings, lowered together as one\n   676\t   batch: `{:entries [e ...], :resources table}` -- one private\n   677\t   resource key allocated per distinct served identity and one per\n   678\t   distinct UCF cell, two waiters on one cell lowering back into one\n   679\t   shared entry and independent cells staying independent (S7.5.3);\n   680\t   equal cell ids across separately lowered frames get different\n   681\t   keys. `occupied` is the receiver's existing resource keys: every\n   682\t   allocated key is checked against it, against the VM's fixed\n   683\t   resource keys, and against keys already allocated in the batch,\n   684\t   regenerating on collision. With the same `:yin.k/unsatisfied` and\n   685\t   `:yin.k/undecodable` outcomes `lift-frame` gives. Where the engine\n   686\t   resolves a wait at one of its own fixed resource keys, the lower\n   687\t   parks the wait there: a link wait's pair under\n   688\t   `module/link-request-resource` and `module/link-response-resource`.\n   689\t   A retained request's retry writes through its carried request\n   690\t   reflection's allocated key and stamps the carried response route\n   691\t   (`:response-cursor`, `:response-stream`) for its restore.\n   692\t   `contexts`, parallel to `pendings`, is each entry's register\n   693\t   context, merged verbatim.\"\n   694\t  ([attach! pendings cells contexts]\n   695\t   (lower-frame attach! pendings cells contexts nil))\n   696\t  ([attach! pendings cells contexts occupied]\n   697\t   (let [ms (distinct (remove nil?\n   698\t                              (concat (map :yin.k/stream (vals cells))\n   699\t                                      (mapcat pending-markers pendings))))\n   700\t         a (attach-all attach! ms)]\n   701\t     (if (contains? a :yin.k/status)\n   702\t       a\n   703\t       (let [used (atom (into fixed-resource-keys occupied))\n   704\t             handles (:handles a)\n   705\t             streams (into {}\n   706\t                           (map (fn [identity]\n   707\t                                  [identity (fresh-key used)]))\n   708\t                           (sort-by str (keys handles)))\n   709\t             resources (into {}\n   710\t                             (map (fn [[identity sid]]\n   711\t                                    [sid (handles identity)]))\n   712\t                             streams)\n   713\t             cell-keys (into {}\n   714\t                             (map (fn [cid] [cid (fresh-key used)]))\n   715\t                             (sort-by str (keys cells)))\n   716\t             lowered (mapv #(lower-one %1 %2 streams cells cell-keys)\n   717\t                           pendings contexts)]\n   718\t         (if-let [refusal (some #(when (contains? % :yin.k/status) %)\n   719\t                                lowered)]\n   720\t           refusal\n   721\t           {:entries (mapv :entry lowered),\n   722\t            :resources (merge resources\n   723\t                              (cell-resources streams cells cell-keys)\n   724\t                              (link-pair-resources streams resources\n   725\t                                                   pendings))}))))))\n   726\t\n   727\t\n   728\t(defn lower-pending\n   729\t  \"One pending entry of S7.4.3, lowered: `{:entry e, :resources\n   730\t   table}` -- the wait-set entry `ctx`'s registers ride on, and the\n   731\t   fresh resource entries it polls through -- with the same\n   732\t   `:yin.k/unsatisfied` and `:yin.k/undecodable` outcomes\n   733\t   `lower-frame` gives. `occupied` is the receiver's existing\n   734\t   resource keys, as `lower-frame`'s. Frame assembly that shares\n   735\t   cursor entries across entries is `lower-frame`'s.\"\n   736\t  ([attach! pending cells ctx]\n   737\t   (lower-pending attach! pending cells ctx nil))\n   738\t  ([attach! pending cells ctx occupied]\n   739\t   (let [r (lower-frame attach! [pending] cells [ctx] occupied)]\n   740\t     (if (contains? r :yin.k/status)\n   741\t       r\n   742\t       (-> r\n   743\t           (assoc :entry (first (:entries r)))\n   744\t           (dissoc :entries))))))\n   509\t(deftest a-retained-ffi-request-migrates-and-the-retry-resumes\n   510\t  (let [t (toy)\n   511\t        peer (served-peer t)\n   512\t        serve! (server peer (:channel t) #{:reader :writer})\n   513\t        attach! (attacher t)\n   514\t        program (then (call-node :op/echo \"hello\")\n   515\t                      (call-node :op/echo \"world\"))\n   516\t        [datoms parked entry call-in-src call-out-src]\n   517\t        (parked-caller program)\n   518\t        kept (get-in parked [:resources vm/call-out-cursor-key :cursor])\n   519\t        lifted (ucf.remote/lift-pending serve! (:resources parked) entry)\n   520\t        pending (:yin.k/pending lifted)\n   521\t        ;; the resumer's own pair and its own handler, under the fixed\n   522\t        ;; keys: they serve the program's subsequent calls and can\n   523\t        ;; never answer the migrated one\n   524\t        own-call-in (ring 8)\n   525\t        own-call-out (ring 8)\n   526\t        own (calling-machine own-call-in own-call-out\n   527\t                             {:op/echo (constantly \"local!\")})\n   528\t        own-pair (select-keys (:resources own)\n   529\t                              [vm/call-in-stream-key\n   530\t                               vm/call-out-stream-key\n   531\t                               vm/call-out-cursor-key])\n   532\t        lowered (ucf.remote/lower-pending attach! pending\n   533\t                                          (:yin.k/cells lifted)\n   534\t             