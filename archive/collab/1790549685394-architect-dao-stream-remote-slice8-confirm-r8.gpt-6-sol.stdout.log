program's subsequent calls and can\n   523\t        ;; never answer the migrated one\n   524\t        own-call-in (ring 8)\n   525\t        own-call-out (ring 8)\n   526\t        own (calling-machine own-call-in own-call-out\n   527\t                             {:op/echo (constantly \"local!\")})\n   528\t        own-pair (select-keys (:resources own)\n   529\t                              [vm/call-in-stream-key\n   530\t                               vm/call-out-stream-key\n   531\t                               vm/call-out-cursor-key])\n   532\t        lowered (ucf.remote/lower-pending attach! pending\n   533\t                                          (:yin.k/cells lifted)\n   534\t                                          (registers-of entry)\n   535\t                                          (keys own-pair))\n   536\t        e (:entry lowered)\n   537\t        rs (:resources lowered)\n   538\t        receiver (-> (quiesced-receiver datoms lowered own)\n   539\t                     (update :resources #(merge own-pair %)))\n   540\t        oldest (fn [h]\n   541\t                 (:dao.stream/cursor (stream/cursor h :dao.stream/oldest)))\n   542\t        ;; the emitter's bridge answered the migrated call before the\n   543\t        ;; migration: the response sits on the emitter's call-out,\n   544\t        ;; past the kept cursor\n   545\t        _ (stream/append! call-out-src\n   546\t                          (apply2/success-response\n   547\t                            (:call-id entry) \"echo!\"))\n   548\t        ;; phase 1: the sweep retries the retained request through the\n   549\t        ;; carried request reflection, and the restored response wait\n   550\t        ;; polls the carried response route\n   551\t        r1 (vm/run receiver)\n   552\t        wait-a (first (:wait-set r1))\n   553\t        warm-up (stream/next call-in-src (oldest call-in-src))\n   554\t        _ (serve-mirror! peer)\n   555\t        landed (stream/next call-in-src (oldest call-