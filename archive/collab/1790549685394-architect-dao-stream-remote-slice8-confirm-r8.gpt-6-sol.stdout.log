20\t  \"The emitter-side table of a retained call over `call-in` and\n  1121\t   `call-out`, the call-out cursor kept at `position`.\"\n  1122\t  [call-in call-out position]\n  1123\t  {vm/call-in-stream-key call-in,\n  1124\t   vm/call-out-stream-key call-out,\n  1125\t   vm/call-out-cursor-key {:stream-id vm/call-out-stream-key,\n  1126\t                           :cursor position}})\n  1127\t\n  1128\t\n  1129\t(def ^:private retained-entry\n  1130\t  {:reason :put, :request-sent true, :call-id :call-7,\n  1131\t   :op :op/add, :stream-id vm/call-in-stream-key,\n  1132\t   :datom (apply2/request :call-7 :op/add [1 2])})\n  1133\t\n  1134\t\n  1135\t(deftest retained-lift-refuses-when-an-endpoint-cannot-be-served\n  1136\t  (let [call-in (one-slot-stream \"call-in\")\n  1137\t        call-out (one-slot-stream \"call-out\")\n  1138\t        resources (retained-resources call-in call-out 2)]\n  1139\t    (testing \"an unservable request endpoint names it\"\n  1140\t      (let [refusal (ucf.remote/lift-pending\n  1141\t                      (refusing-serve! call-in) resources retained-entry)]\n  1142\t        (is (= :yin.k/unsatisfied (:yin.k/status refusal)))\n  1143\t        (is (= \"call-in\" (:dao.stream/identity refusal))\n  1144\t            \"naming that endpoint's identity\")\n  1145\t        (is (empty? (:yin.k/cells refusal))\n  1146\t            \"no cell is published\")))\n  1147\t    (testing \"an unservable response endpoint names it\"\n  1148\t      (let [refusal (ucf.remote/lift-pending\n  1149\t                      (refusing-serve! call-out) resources retained-entry)]\n  1150\t        (is (= :yin.k/unsatisfied (:yin.k/status refusal)))\n  1151\t        (is (= \"call-out\" (:dao.stream/identity refusal))\n  1152\t            \"naming that endpoint's identity\")\n  1153\t        (is (empty? (:yin.k/cells refusal))\n  1154\t            \"no cell is published\")))))\n  1155\t\n  1156\t\n  1157\t(deftest retained-lower-refuses-when-an-endpoint-cannot-attach\n  1158\t  (let [serve! (stub-serve! chan)\n  1159\t        resources (retained-resources (one-slot-stream \"call-in\")\n  1160\t                                      (one-slot-stream \"call-out\") 2)\n  1161\t        lifted (ucf.remote/lift-pending serve! resources retained-entry)\n  1162\t        pending (:yin.k/pending lifted)\n  1163\t        resp-id (get-in pending [:yin.k/response :dao.stream/identity])\n  1164\t        attach! (fn [d]\n  1165\t                  (when (not= resp-id (:dao.stream/identity d))\n  1166\t                    {:dao.stream/outcome :dao.stream/ok,\n  1167\t                     :dao.stream/handle\n  1168\t                     [:reflection-of (:dao.stream/identity d)]}))\n  1169\t        lowered (ucf.remote/lower-pending attach! pending\n  1170\t                                          (:yin.k/cells lifted)\n  1171\t                                          {:segment 0, :pc 5})]\n  1172\t    (is (= :yin.k/unsatisfied (:yin.k/status lowered))\n  1173\t        \"an endpoint the receiver cannot attach refuses the lower\")\n  1174\t    (is (= resp-id (:dao.stream/identity lowered))\n  1175\t        \"naming that endpoint's identity\")\n  1176\t    (is (contains? pending :yin.k/request)\n  1177\t        \"both route markers and the cell survive in the UCF entry\")\n  1178\t    (is (contains? pending :yin.k/response))\n  1179\t    (is (contains? pending :yin.k/response-cell))))\n  1180\t\n  1181\t\n  1182\t(deftest two-separately-lowered-frames-get-distinct-fresh-keys\n  1183\t  (let [serve! (stub-serve! chan)\n  1184\t        attach! (stub-attach!)\n  1185\t        s (ring 8)\n  1186\t        _ (stream/append! s \"v\")\n  1187\t        c0 (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n  1188\t        resources {:yin/s s, :yin/c {:stream-id :yin/s, :cursor c0}}\n  1189\t        entry {:reason :next,\n  1190\t               :cursor-ref {:type :cursor-ref, :id :yin/c},\n  1191\t               :stream-id :yin/s}\n  1192\t        ctx {:segment 0, :pc 1, :env {}, :stack [], :k []}\n  1193\t        lifted (ucf.remote/lift-pending serve! resources entry)\n  1194\t        pending (:yin.k/pending lifted)\n  1195\t        cells (:yin.k/cells lifted)\n  1196\t        one (ucf.remote/lower-frame attach! [pending] cells [ctx])\n  1197\t        one-keys (set (keys (:resources one)))\n  1198\t        two (ucf.remote/lower-frame attach! [pending] cells [ctx]\n  1199\t                                    one-keys)\n  1200\t        ;; a receiver that already holds the keys this batch would\n  1201\t        ;; propose first: the allocator regenerates past them\n  1202\t        three (ucf.remote/lower-frame attach! [pending] cells [ctx]\n  1203\t                                      (into one-keys\n  1204\t                                            #{:yin.k/k-10 :yin.k/k-11\n  1205\t                                              :yin.k/k-12}))\n  1206\t        cursor-key (fn [frame]\n  1207\t                     (get-in (first (:entries frame))\n  1208\t                             [:cursor-ref :id]))]\n  1209\t    (testing \"equal cell ids in separate batches get different keys\"\n  1210\t      (is (= :yin.k/c-0 (:yin.k/cell pending))\n  1211\t          \"each lift restarts its cell ids\")\n  1212\t      (is (not= (cursor-key one) (cursor-key two)))\n  1213\t      (is (every? #(not (contains? one-keys %)) (set (keys (:resources two))))\n  1214\t          \"no key is shared between the two lowerings\"))\n  1215\t    (testing \"collisions against pre-existing resources regenerate\"\n  1216\t      (is (every? #(not (contains? (set (keys (:resources three))) %))\n  1217\t                  #{:yin.k/k-10 :yin.k/k-11 :yin.k/k-12})\n  1218\t          \"the pre-held keys were regenerated away\")\n  1219\t      (is (not= (cursor-key three) (cursor-key one))))\n  1220\t    (testing \"every lowered frame keeps a working cursor entry\"\n  1221\t      (doseq [frame [one two three]]\n  1222\t        (let [cursor (get (:resources frame) (cursor-key frame))]\n  1223\t          (is (= c0 (:cursor cursor))\n  1224\t              \"at the kept position, on its own reflection\")\n  1225\t          (is (contains? (:resources frame) (:stream-id cursor))\n  1226\t              \"naming an attached reflection\"))))))\n","exit_code":0,"status":"completed"}}
