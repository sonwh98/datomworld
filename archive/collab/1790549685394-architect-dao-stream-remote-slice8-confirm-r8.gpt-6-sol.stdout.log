==================================================\n   881\t\n   882\t(deftest semantic-restore-retained-response-route-test\n   883\t  (let [base {:parked {:parked-0 {:continuation true}}}\n   884\t        entry (fn [extra]\n   885\t                (merge {:segment 0, :pc 3, :env {}, :stack [], :k [],\n   886\t                        :request-sent true, :call-id :parked-0,\n   887\t                        :reason :put, :stream-id :yin/call-in,\n   888\t                        :datom {:request true}}\n   889\t                       extra))]\n   890\t    (testing \"an ordinary retained writer waits on the fixed call-out keys\"\n   891\t      (let [restored (semantic/semantic-restore base (entry nil))\n   892\t            [wait] (:wait-set restored)]\n   893\t        (is (true? (:blocked? restored)))\n   894\t        (is (false? (:halted? restored)))\n   895\t        (is (= :next (:reason wait)))\n   896\t        (is (= :parked-0 (:call-id wait)))\n   897\t        (is (= 3 (:pc wait)))\n   898\t        (is (= vm/call-out-cursor-key (get-in wait [:cursor-ref :id])))\n   899\t        (is (= vm/call-out-stream-key (:stream-id wait)))))\n   900\t    (testing \"a lowered retained writer waits on its carried route\"\n   901\t      (let [restored (semantic/semantic-restore\n   902\t                       base\n   903\t                       (entry {:stream-id :yin.k/k-7,\n   904\t                               :response-cursor :yin.k/k-9,\n   905\t                               :response-stream :yin.k/k-8}))\n   906\t            [wait] (:wait-set restored)]\n   907\t        (is (true? (:blocked? restored)))\n   908\t        (is (= :next (:reason wait)))\n   909\t        (is (= :parked-0 (:call-id wait)))\n   910\t        (is (= :yin.k/k-9 (get-in wait [:cursor-ref :id]))\n   911\t            \"the carried response cell's allocated key\")\n   912\t        (is (= :yin.k/k-8 (:stream-id wait))\n   913\t            \"the carried response reflection's allocated key\")\n   914\t        (is (= 3 (:pc wait)))\n   915\t        (is (contains? (:parked restored) :parked-0)\n   916\t            \"the parked call is untouched until its response lands\")))))\n","exit_code":0,"status":"completed"}}
