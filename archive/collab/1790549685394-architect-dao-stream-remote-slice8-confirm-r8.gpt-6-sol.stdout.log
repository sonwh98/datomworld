yin/vm/ucf/remote.cljc:481:    vm/call-out-cursor-key module/link-request-resource\nsrc/cljc/yin/vm/ucf/remote.cljc:485:(defn- fresh-key\nsrc/cljc/yin/vm/ucf/remote.cljc:517:   {:handles {identity handle}}; `lower-frame` allocates each\nsrc/cljc/yin/vm/ucf/remote.cljc:674:(defn lower-frame\nsrc/cljc/yin/vm/ucf/remote.cljc:695:   (lower-frame attach! pendings cells contexts nil))\nsrc/cljc/yin/vm/ucf/remote.cljc:703:       (let [used (atom (into fixed-resource-keys occupied))\nsrc/cljc/yin/vm/ucf/remote.cljc:707:                                  [identity (fresh-key used)]))\nsrc/cljc/yin/vm/ucf/remote.cljc:714:                             (map (fn [cid] [cid (fresh-key used)]))\nsrc/cljc/yin/vm/ucf/remote.cljc:728:(defn lower-pending\nsrc/cljc/yin/vm/ucf/remote.cljc:733:   `lower-frame` gives. `occupied` is the receiver's existing\nsrc/cljc/yin/vm/ucf/remote.cljc:734:   resource keys, as `lower-frame`'s. Frame assembly that shares\nsrc/cljc/yin/vm/ucf/remote.cljc:735:   cursor entries across entries is `lower-frame`'s.\"\nsrc/cljc/yin/vm/ucf/remote.cljc:737:   (lower-pending attach! pending cells ctx nil))\nsrc/cljc/yin/vm/ucf/remote.cljc:739:   (let [r (lower-frame attach! [pending] cells [ctx] occupied)]\n","exit_code":0,"status":"completed"}}
