f :id]))\n   587\t          \"the restored response wait polls the carried cell's key\")\n   588\t      (is (= (:response-stream e) (:stream-id wait-a))\n   589\t          \"reading the carried response reflection\")\n   590\t      (let [route (get rs (:response-cursor e))]\n   591\t        (is (= kept (:cursor route))\n   592\t            \"at the kept response position\")\n   593\t        (is (= (:response-stream e) (:stream-id route))\n   594\t            \"naming the carried response reflection\")\n   595\t        (is (contains? rs (:response-stream e)))))\n   596\t    (testing \"the retried call is answered on the emitter's pair\"\n   597\t      (is (vm/blocked? r1)\n   598\t          \"first round: the request is retried, the response not yet\n   599\t           read\")\n   600\t      (is (= :warmed (:dao.stream/value warm-up))\n   601\t          \"reading the warm-up freed the slot the retry needed\")\n   602\t      (is (= :dao.stream/ok (:dao.stream/outcome landed)))\n   603\t      (is (= (:datom entry) (:dao.stream/value landed))\n   604\t          \"the retained request verbatim, through the carried request\n   605\t           reflection\")\n   606\t      (is (= \"echo!\"\n   607\t             (apply2/response-ok\n   608\t               (:dao.stream/value\n   609\t                 (stream/next call-out-src (oldest call-out-src)))))\n   610\t          \"the emitter's bridge answered it on the emitter's pair\"))\n   611\t    (testing \"the carried route delivers, and later calls are local\"\n   612\t      (is (vm/halted? r2))\n   613\t      (is (= \"local!\" (vm/value r2))\n   614\t          \"the migrated result came from the emitter's bridge; the\n   615\t           receiver's own handler answered only the program's own next\n   616\t           call\")\n   617\t      (is (not= kept (:cursor (get-in r2 [:resources\n   618\t                                          (:response-cursor e)])))\n   619\t          \"the carried route's cursor advanced: the response was read\n   620\t           through it\")\n   621\t      (is (= [\"world\"]\n   622\t             (apply2/request-args\n   623\t               (:dao.stream/value\n   624\t                 (stream/next own-call-in (oldest own-call-in)))))\n   625\t          \"the subsequent call's request is on the receiver's own\n   626\t           call-in\")\n   627\t      (is (= \"local!\"\n   628\t             (apply2/response-ok\n   629\t               (:dao.stream/value\n   630\t                 (stream/next own-call-out (oldest own-call-out)))))\n   631\t          \"and its answer is on the receiver's own call-out\"))))\n   632\t\n   633\t\n   634\t;; =============================================================================\n   635\t;; Unsatisfied: an unpublishable cursor, a source that cannot be\n   636\t;; served, a gone reflection\n   637\t;; =============================================================================\n   638\t\n   639\t(defn- host-cursor-stream\n   640\t  \"A handle whose cursors hold a host object -- the case\n  1060\t    (let [ctx {:segment 0, :pc 2, :env {}, :stack [], :k []}\n  1061\t          lowered (ucf.remote/lower-pending attach! pending\n  1062\t                                            (:yin.k/cells lifted) ctx)\n  1063\t          e (:entry lowered)\n  1064\t          rs (:resources lowered)]\n  1065\t      (is (= :link-response (:reason e)))\n  1066\t      (is (= 3 (:cursor e)))\n  1067\t      (is (= module/link-request-resource (:request e))\n  1068\t          \"the pair fields name the engine's fixed keys\")\n  1069\t      (is (= module/link-response-resource (:response e)))\n  1070\t      (is (contains? rs (:response e))\n  1071\t          \"the poll finds its reader at the fixed response key\")\n  1072\t      (is (contains? e :request) \"the pair fields the poll keeps\")\n  1073\t      (is (contains? e :response))\n  1074\t      (is (not (contains? e :envelope))\n  1075\t          \"an appended request carries its envelope no more