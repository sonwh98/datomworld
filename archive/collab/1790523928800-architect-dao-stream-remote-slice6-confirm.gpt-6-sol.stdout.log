{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/clj/dao/stream/udp/jvm.clj | sed -n '1,230p'\"","aggregated_output":"     1\t(ns dao.stream.udp.jvm\n     2\t  \"The JVM host edge for dao.stream.udp: one DatagramSocket, bound once,\n     3\t   with a daemon receiver thread that feeds every datagram's source\n     4\t   address and raw bytes to a composed `receive-fn`\n     5\t   (dao.stream.udp/receive!, partially applied over the port), and the\n     6\t   :send! seam dao.stream.udp/make-port composes over. All protocol\n     7\t   logic -- fragmentation, reassembly, the deposit shape -- stays in\n     8\t   dao.stream.udp; this adapter only owns the socket and its thread.\"\n     9\t  (:import (java.net DatagramPacket DatagramSocket InetAddress)))\n    10\t\n    11\t\n    12\t(defn bind!\n    13\t  \"Bind a DatagramSocket at `port` (0 for an ephemeral port) and start\n    14\t   its daemon receiver thread. Returns {:socket s :local-port p :send!\n    15\t   f :close! f}; `:send!` is `(send! host dest-port bytes) -> nil`,\n    16\t   the port composition's host seam.\"\n    17\t  ([receive-fn] (bind! receive-fn 0))\n    18\t  ([receive-fn port]\n    19\t   (let [socket (DatagramSocket. (int port))\n    20\t         running (atom true)\n    21\t         thread\n    22\t         (Thread.\n    23\t           (fn []\n    24\t             (let [buf (byte-array 65536)\n    25\t                   packet (DatagramPacket. buf (alength buf))]\n    26\t               (while @running\n    27\t                 ;; .receive leaves the packet's length at what the last\n    28\t                 ;; datagram filled; reset it to the buffer's own length\n    29\t                 ;; so a datagram after a short one is not truncated.\n    30\t                 (.setLength packet (alength buf))\n    31\t                 (when (try (.receive socket packet)\n    32\t                            true\n    33\t                            (catch Exception _\n    34\t                              (when @running (Thread/sleep 10))\n    35\t                              false))\n    36\t                   (let [n (.getLength packet)\n    37\t                         bytes (java.util.Arrays/copyOfRange\n    38\t                                 (.getData packet) 0 n)\n    39\t                         host (.getHostAddress (.getAddress packet))\n    40\t                         src-port (.getPort packet)]\n    41\t                     (try (receive-fn host src-port bytes)\n    42\t                          (catch Exception _ nil))))))))]\n    43\t     (.setDaemon thread true)\n    44\t     (.start thread)\n    45\t     {:socket socket\n    46\t      :local-port (.getLocalPort socket)\n    47\t      :send! (fn [host dest-port bytes]\n    48\t               (.send socket\n    49\t                      (DatagramPacket. bytes (alength bytes)\n    50\t                                       (InetAddress/getByName host)\n    51\t                                       (int dest-port)))\n    52\t               nil)\n    53\t      :close! (fn []\n    54\t                (reset! running false)\n    55\t                (.close socket)\n    56\t                nil)})))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/udp_test.cljc | sed -n '1,350p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/udp_test.cljc | sed -n '1,350p'\"","aggregated_output":"     1\t(ns dao.stream.udp-test\n     2\t  \"Portable, host-free protocol tests for dao.stream.udp\n     3\t   (docs/design/dao.stream.remote.md 3.2): fragmentation and\n     4\t   reassembly round trip; loss of any part loses the message,\n     5\t   recovered by resend; oversize refuses transport-error naming\n     6\t   oversize, unsent; reassembly eviction, oldest partial message\n     7\t   first; the 48 KiB toy inside the default 64 KiB maximum, and a\n     8\t   near-limit message delivered on its actual accumulated length;\n     9\t   malformed fragment envelopes dropped before any partial state\n    10\t   changes; the deposited event carries the datagram's own source\n    11\t   address; and keying by [attachment, direction, id] -- two\n    12\t   attachments, equal ids, no cross-delivery -- including the\n    13\t   projection that routes the shared traffic medium onto each\n    14\t   attachment's own channel ring.\"\n    15\t  (:require [clojure.test :refer [deftest is testing]]\n    16\t            [dao.stream :as stream]\n    17\t            [dao.stream.cbor :as cbor]\n    18\t            [dao.stream.ringbuffer :as ringbuffer]\n    19\t            [dao.stream.udp :as udp]))\n    20\t\n    21\t\n    22\t(defn- ring\n    23\t  [capacity]\n    24\t  (:dao.stream/handle\n    25\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    26\t                         ringbuffer/capacity-key capacity})))\n    27\t\n    28\t\n    29\t(defn- spy\n    30\t  \"A :send! seam recording every send as [host port bytes], touching\n    31\t   no real socket.\"\n    32\t  []\n    33\t  (let [log (atom [])]\n    34\t    {:log log\n    35\t     :send! (fn [host port bytes] (swap! log conj [host port bytes]))}))\n    36\t\n    37\t\n    38\t(defn- values\n    39\t  \"Every retained value of `h`, oldest first.\"\n    40\t  [h]\n    41\t  (loop [c (:dao.stream/cursor (stream/cursor h stream/anchor-oldest))\n    42\t         acc []]\n    43\t    (let [r (stream/next h c)]\n    44\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    45\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    46\t        acc))))\n    47\t\n    48\t\n    49\t(defn- deposited\n    50\t  \"Every deposit event's own carried :dao.stream.udp/value, oldest\n    51\t   first -- what a projection would forward onto a channel ring.\"\n    52\t  [traffic]\n    53\t  (mapv :dao.stream.udp/value (values traffic)))\n    54\t\n    55\t\n    56\t(defn- big-string\n    57\t  [n]\n    58\t  (apply str (repeat n \\a)))\n    59\t\n    60\t\n    61\t(defn- request\n    62\t  [identity id v]\n    63\t  {:dao.stream/identity identity\n    64\t   :dao.stream.remote/op :dao.stream/append!\n    65\t   :dao.stream.remote/args [v]\n    66\t   :dao.stream.remote/id id})\n    67\t\n    68\t\n    69\t;; =============================================================================\n    70\t;; descriptor? and address-key\n    71\t;; =============================================================================\n    72\t\n    73\t(deftest descriptor-gate\n    74\t  (is (udp/descriptor? {:dao.stream/type :dao.stream/udp\n    75\t                        :dao.stream/identity \"peer-a\"\n    76\t                        :dao.stream.udp/host \"127.0.0.1\"\n    77\t                        :dao.stream.udp/port 9000}))\n    78\t  (is (not (udp/descriptor? {:dao.stream/type :dao.stream/udp\n    79\t                             :dao.stream/identity \"peer-a\"\n    80\t                             :dao.stream.udp/host \"127.0.0.1\"\n    81\t                             :dao.stream.udp/port 0})))\n    82\t  (is (not (udp/descriptor? {:dao.stream/type :dao.stream/ws\n    83\t                             :dao.stream/identity \"peer-a\"\n    84\t                             :dao.stream.udp/host \"h\"\n    85\t                             :dao.stream.udp/port 1}))))\n    86\t\n    87\t\n    88\t(deftest address-key-format\n    89\t  (is (= \"127.0.0.1:9000\" (udp/address-key \"127.0.0.1\" 9000))))\n    90\t\n    91\t\n    92\t;; =============================================================================\n    93\t;; Fragmentation and reassembly round trip\n    94\t;; =============================================================================\n    95\t\n    96\t(deftest fragmentation-round-trip\n    97\t  (testing \"a value over the datagram budget arrives whole\"\n    98\t    (let [traffic (ring 64)\n    99\t          {:keys [send! log]} (spy)\n   100\t          port (udp/make-port {:send! send! :traffic traffic})\n   101\t          v (request \"s\" 1 (big-string 4000))\n   102\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   103\t                   @log)\n   104\t          receiver (udp/make-port\n   105\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   106\t      (is (> (count sent) 1) \"the value did not fit one datagram\")\n   107\t      (doseq [[_ _ bytes] sent]\n   108\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   109\t      (is (= [v] (deposited traffic))))))\n   110\t\n   111\t\n   112\t(deftest fragmentation-round-trip-48kib\n   113\t  (testing \"the 48 KiB toy, inside the default 64 KiB maximum\"\n   114\t    (let [traffic (ring 64)\n   115\t          {:keys [send! log]} (spy)\n   116\t          port (udp/make-port {:send! send! :traffic traffic})\n   117\t          v (request \"s\" 2 (big-string (* 48 1024)))\n   118\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   119\t                   @log)\n   120\t          receiver (udp/make-port\n   121\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   122\t      (doseq [[_ _ bytes] sent]\n   123\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   124\t      (is (= [v] (deposited traffic))))))\n   125\t\n   126\t\n   127\t(deftest fragmentation-round-trip-near-limit\n   128\t  (testing \"a message near the default maximum delivers on its actual\n   129\t            accumulated length\"\n   130\t    (let [traffic (ring 64)\n   131\t          {:keys [send! log]} (spy)\n   132\t          port (udp/make-port {:send! send! :traffic traffic})\n   133\t          v (request \"s\" 22 (big-string 64500))\n   134\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   135\t                   @log)\n   136\t          receiver (udp/make-port\n   137\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   138\t      (is (> (count sent) 54)\n   139\t          \"declared parts times the datagram budget crosses 64 KiB, so\n   140\t           a bound on the claim, not the bytes, would have dropped it\")\n   141\t      (doseq [[_ _ bytes] sent]\n   142\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   143\t      (is (= [v] (deposited traffic))))))\n   144\t\n   145\t\n   146\t;; =============================================================================\n   147\t;; Malformed fragment envelopes drop, before any partial state changes\n   148\t;; =============================================================================\n   149\t\n   150\t(defn- raw-fragment\n   151\t  \"One raw fragment envelope, `overrides` merged over a well-formed\n   152\t   two-part shape -- whatever a peer might put on the wire.\"\n   153\t  [overrides]\n   154\t  (merge {:dao.stream.remote/id 7\n   155\t          :dao.stream.udp/part 0\n   156\t          :dao.stream.udp/parts 2\n   157\t          :dao.stream.udp/direction :dao.stream.udp/request\n   158\t          :dao.stream.udp/bytes (cbor/encode \"x\")}\n   159\t         overrides))\n   160\t\n   161\t\n   162\t(deftest malformed-fragments-drop-before-partial-state\n   163\t  (testing \"a fragment failing its own field checks is dropped: no\n   164\t            throw, no deposit, no partial state\"\n   165\t    (let [traffic (ring 64)\n   166\t          {:keys [send! log]} (spy)\n   167\t          sender (udp/make-port {:send! send! :traffic traffic})\n   168\t          receiver (udp/make-port\n   169\t                     {:send! (fn [& _] nil) :traffic traffic})\n   170\t          malformed [(raw-fragment {:dao.stream.udp/parts 0})\n   171\t                     (raw-fragment {:dao.stream.udp/part -1})\n   172\t                     (raw-fragment {:dao.stream.udp/part 2})\n   173\t                     (raw-fragment {:dao.stream.udp/part \"0\"})\n   174\t                     (raw-fragment {:dao.stream.udp/parts nil})\n   175\t                     (raw-fragment {:dao.stream.udp/direction\n   176\t                                    :dao.stream.udp/sideways})\n   177\t                     (raw-fragment {:dao.stream.udp/bytes \"not bytes\"})]\n   178\t          v (request \"s\" 7 (big-string 4000))\n   179\t          sent (do (udp/send-value! sender \"peer\" 9000 v)\n   180\t                   @log)]\n   181\t      (doseq [frag malformed]\n   182\t        (is (nil? (udp/receive! receiver \"peer\" 9000 (cbor/encode frag)))\n   183\t            \"the malformed datagram is dropped, not thrown\"))\n   184\t      (is (= {} (:partial @receiver))\n   185\t          \"not one malformed fragment grew partial state\")\n   186\t      (is (= [] (deposited traffic)) \"and none deposited\")\n   187\t      (testing \"a real message interleaved with the malformed set\n   188\t                completes untouched by its neighbors\"\n   189\t        (doseq [[_ _ bytes] (butlast sent)]\n   190\t          (udp/receive! receiver \"peer\" 9000 bytes))\n   191\t        (doseq [frag malformed]\n   192\t          (udp/receive! receiver \"peer\" 9000 (cbor/encode frag)))\n   193\t        (udp/receive! receiver \"peer\" 9000 (last (last sent)))\n   194\t        (is (= [v] (deposited traffic)))))))\n   195\t\n   196\t\n   197\t;; =============================================================================\n   198\t;; Loss of any part loses the message, recovered by resend\n   199\t;; =============================================================================\n   200\t\n   201\t(deftest loss-of-any-part-loses-the-message\n   202\t  (testing \"dropping one datagram loses the whole message\"\n   203\t    (let [traffic (ring 64)\n   204\t          {:keys [send! log]} (spy)\n   205\t          port (udp/make-port {:send! send! :traffic traffic})\n   206\t          v (request \"s\" 3 (big-string 4000))\n   207\t          sent (do (udp/send-value! port \"peer\" 9000 v)\n   208\t                   @log)\n   209\t          receiver (udp/make-port\n   210\t                     {:send! (fn [& _] nil) :traffic traffic})\n   211\t          dropped (rest sent)]\n   212\t      (is (> (count sent) 1))\n   213\t      (doseq [[_ _ bytes] dropped]\n   214\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   215\t      (is (= [] (deposited traffic))\n   216\t          \"the message never completes without every part\")\n   217\t      (testing \"the link's resend rule recovers it: re-send every part\"\n   218\t        (doseq [[_ _ bytes] sent]\n   219\t          (udp/receive! receiver \"peer\" 9000 bytes))\n   220\t        (is (= [v] (deposited traffic)))))))\n   221\t\n   222\t\n   223\t;; =============================================================================\n   224\t;; Oversize refuses, unsent\n   225\t;; =============================================================================\n   226\t\n   227\t(deftest oversize-refuses-unsent\n   228\t  (testing \"a message beyond max-message-bytes is never sent\"\n   229\t    (let [traffic (ring 64)\n   230\t          {:keys [send! log]} (spy)\n   231\t          port (udp/make-port {:send! send! :traffic traffic\n   232\t                               :max-message-bytes 1000})\n   233\t          v (request \"s\" 4 (big-string 4000))\n   234\t          result (udp/send-value! port \"peer\" 9000 v)]\n   235\t      (is (= {:dao.stream/outcome :dao.stream/transport-error\n   236\t              :dao.stream.remote/reason :dao.stream.remote/oversize}\n   237\t             result))\n   238\t      (is (= [] @log) \"nothing was sent, torn or partially sent\"))))\n   239\t\n   240\t\n   241\t;; =============================================================================\n   242\t;; Reassembly eviction: max-partial-messages, oldest evicted\n   243\t;; =============================================================================\n   244\t\n   245\t(deftest reassembly-eviction-evicts-oldest\n   246\t  (testing \"the oldest partial message is evicted over the bound\"\n   247\t    (let [traffic (ring 64)\n   248\t          {:keys [send! log]} (spy)\n   249\t          port (udp/make-port {:send! send! :traffic traffic\n   250\t                               :max-partial-messages 2})\n   251\t          v1 (request \"s\" 10 (big-string 4000))\n   252\t          v2 (request \"s\" 11 (big-string 4000))\n   253\t          v3 (request \"s\" 12 (big-string 4000))\n   254\t          sent! (fn [v]\n   255\t                  (reset! log [])\n   256\t                  (udp/send-value! port \"peer\" 9000 v)\n   257\t                  @log)\n   258\t          s1 (sent! v1)\n   259\t          s2 (sent! v2)\n   260\t          s3 (sent! v3)\n   261\t          receiver (udp/make-port\n   262\t                     {:send! (fn [& _] nil) :traffic traffic\n   263\t                      :max-partial-messages 2})]\n   264\t      (is (every? #(> (count %) 1) [s1 s2 s3]))\n   265\t      ;; withhold the last part of each, so none completes yet, and the\n   266\t      ;; oldest (v1's) partial is evicted once the third begins\n   267\t      (doseq [sent [s1 s2 s3]\n   268\t              [_ _ bytes] (butlast sent)]\n   269\t        (udp/receive! receiver \"peer\" 9000 bytes))\n   270\t      ;; complete v1: evicted, so it never arrives\n   271\t      (udp/receive! receiver \"peer\" 9000 (last (last s1)))\n   272\t      (is (= [] (deposited traffic)) \"v1's partial was evicted\")\n   273\t      ;; complete v3: kept, so it arrives\n   274\t      (udp/receive! receiver \"peer\" 9000 (last (last s3)))\n   275\t      (is (= [v3] (deposited traffic))))))\n   276\t\n   277\t\n   278\t;; =============================================================================\n   279\t;; The deposited event carries the datagram's own source address\n   280\t;; =============================================================================\n   281\t\n   282\t(deftest deposit-carries-source-address\n   283\t  (testing \"the event names the source the socket saw, for replies\"\n   284\t    (let [traffic (ring 64)\n   285\t          port (udp/make-port\n   286\t                 {:send! (fn [& _] nil) :traffic traffic})\n   287\t          v (request \"s\" 21 \"hello\")]\n   288\t      (udp/receive! port \"203.0.113.7\" 4242 (cbor/encode v))\n   289\t      (let [r (stream/next traffic\n   290\t                           (:dao.stream/cursor\n   291\t                             (stream/cursor traffic\n   292\t                                            stream/anchor-oldest)))\n   293\t            event (:dao.stream/value r)]\n   294\t        (is (= (udp/address-key \"203.0.113.7\" 4242)\n   295\t               (:dao.stream.udp/attachment event)))\n   296\t        (is (= {:dao.stream.udp/host \"203.0.113.7\"\n   297\t                :dao.stream.udp/port 4242}\n   298\t               (:dao.stream.udp/source event)))\n   299\t        (is (= v (:dao.stream.udp/value event)))))))\n   300\t\n   301\t\n   302\t;; =============================================================================\n   303\t;; Keying by [attachment, direction, id]: two attachments, equal ids,\n   304\t;; no cross-delivery\n   305\t;; =============================================================================\n   306\t\n   307\t(deftest keying-prevents-cross-delivery\n   308\t  (testing \"two attachments fragmenting the same id, interleaved\"\n   309\t    (let [traffic (ring 64)\n   310\t          {:keys [send! log]} (spy)\n   311\t          port-a (udp/make-port {:send! send! :traffic traffic})\n   312\t          port-b (udp/make-port {:send! send! :traffic traffic})\n   313\t          va (request \"s\" 99 (big-string 4000))\n   314\t          vb (request \"s\" 99 (big-string 3000))\n   315\t          sent-a (do (reset! log [])\n   316\t                     (udp/send-value! port-a \"peer-a\" 9001 va)\n   317\t                     @log)\n   318\t          sent-b (do (reset! log [])\n   319\t                     (udp/send-value! port-b \"peer-b\" 9002 vb)\n   320\t                     @log)\n   321\t          receiver (udp/make-port\n   322\t                     {:send! (fn [& _] nil) :traffic traffic})]\n   323\t      (is (> (count sent-a) 1))\n   324\t      (is (> (count sent-b) 1))\n   325\t      ;; interleave: alternate a and b datagrams\n   326\t      (loop [as sent-a bs sent-b]\n   327\t        (when (seq as)\n   328\t          (udp/receive! receiver \"peer-a\" 9001 (last (first as))))\n   329\t        (when (seq bs)\n   330\t          (udp/receive! receiver \"peer-b\" 9002 (last (first bs))))\n   331\t        (when (or (seq as) (seq bs))\n   332\t          (recur (rest as) (rest bs))))\n   333\t      (is (= #{va vb} (set (deposited traffic)))))))\n   334\t\n   335\t\n   336\t;; =============================================================================\n   337\t;; The projection: one channel ring per attachment\n   338\t;; =============================================================================\n   339\t\n   340\t(deftest projection-routes-by-attachment\n   341\t  (testing \"step! forwards only the projected attachment's own events\"\n   342\t    (let [traffic (ring 64)\n   343\t          port (udp/make-port\n   344\t                 {:send! (fn [& _] nil) :traffic traffic})\n   345\t          channel-a (ring 64)\n   346\t          channel-b (ring 64)\n   347\t          cursor (:dao.stream/cursor\n   348\t                   (stream/cursor traffic stream/anchor-oldest))\n   349\t          att-a (udp/address-key \"peer-a\" 9001)\n   350\t          att-b (udp/address-key \"peer-b\" 9002)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/udp/jvm_test.clj | sed -n '1,240p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/udp/jvm_test.clj | sed -n '1,240p'\"","aggregated_output":"     1\t(ns dao.stream.udp.jvm-test\n     2\t  \"The JVM host edge over a real loopback socket: the receiver thread\n     3\t   hands each datagram's own bytes to the composed receive-fn, whole.\n     4\t   The thread reuses one DatagramPacket across receives, so it resets\n     5\t   the packet's length to the buffer's before every receive -- a\n     6\t   datagram arriving after a shorter one is not truncated by it.\"\n     7\t  (:require [clojure.test :refer [deftest is]]\n     8\t            [dao.stream.udp.jvm :as udp-jvm])\n     9\t  (:import (java.net DatagramPacket DatagramSocket InetAddress)))\n    10\t\n    11\t\n    12\t(defn- eventually\n    13\t  \"Poll `pred` every 10ms until truthy or `ms` have passed; nil on\n    14\t   timeout.\"\n    15\t  [pred ms]\n    16\t  (let [deadline (+ (System/currentTimeMillis) ms)]\n    17\t    (loop []\n    18\t      (or (pred)\n    19\t          (when (> deadline (System/currentTimeMillis))\n    20\t            (Thread/sleep 10)\n    21\t            (recur))))))\n    22\t\n    23\t\n    24\t(deftest short-datagram-then-long-datagram-arrive-whole\n    25\t  (let [received (atom [])\n    26\t        receiver (udp-jvm/bind! (fn [host port bytes]\n    27\t                                  (swap! received conj [host port bytes]))\n    28\t                                0)\n    29\t        port (:local-port receiver)\n    30\t        sender (DatagramSocket.)\n    31\t        short-bytes (byte-array [1 2 3])\n    32\t        long-bytes (byte-array (range 1 256))]\n    33\t    (try\n    34\t      (doseq [bytes [short-bytes long-bytes]]\n    35\t        (.send sender\n    36\t               (DatagramPacket. bytes (alength bytes)\n    37\t                                (InetAddress/getByName \"127.0.0.1\")\n    38\t                                (int port))))\n    39\t      (is (= 2 (count (eventually #(when (= 2 (count @received))\n    40\t                                     @received)\n    41\t                                  5000)))\n    42\t          \"both datagrams arrived\")\n    43\t      (let [[[_ _ got-short] [_ _ got-long]] @received]\n    44\t        (is (= (seq short-bytes) (seq got-short))\n    45\t            \"the short datagram arrived whole\")\n    46\t        (is (= (seq long-bytes) (seq got-long))\n    47\t            \"the long datagram after the short one arrived whole too,\n    48\t             not truncated to its predecessor's length\"))\n    49\t      (finally\n    50\t        ((:close! receiver))\n    51\t        (.close sender)))))\n","exit_code":0,"status":"completed"}}
