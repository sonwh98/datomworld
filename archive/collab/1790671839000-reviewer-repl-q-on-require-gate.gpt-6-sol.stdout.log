n   325\t                          acc))))\n   326\t        _ (apply2/put-request! (:call-in pair)\n   327\t                               (apply2/request [:c 0] query/op [names-query]))\n   328\t        _ (apply2/put-request! (:call-in pair)\n   329\t                               (apply2/request [:c 1] :some/other-op []))\n   330\t        served (query/serve {:pair pair, :indexer indexer, :limits limits,\n   331\t                             :budget 8})\n   332\t        again (query/serve {:pair (:pair served), :indexer indexer,\n   333\t                            :limits limits, :budget 8})]\n   334\t    (is (true? (:progress? served)))\n   335\t    (is (false? (:progress? again)) \"a consumed request is not answered twice\")\n   336\t    (is (= [[:c 0] [:c 1]] (mapv apply2/response-id (responses pair))))\n   337\t    (is (= #{} (apply2/response-ok (first (responses pair)))))\n   338\t    (is (= :dao.stream.apply/unknown-operation\n   339\t           (:dao.stream.apply/code\n   340\t             (apply2/response-error (second (responses pair))))))))\n","exit_code":0,"status":"completed"}}
