 {:row-limit query-row-limit\n+                                                :byte-limit query-byte-limit}\n+                                       :budget query-serve-budget}))\n+              state (cond-> state\n+                      served (assoc :link-pair (:pair served))\n+                      answered (assoc :query-pair (:pair answered)))\n+              pending (if (seq (:pending served)) (:pending served) pending)]\n+          (if (or (:progress? served) (:progress? answered))\n+            (let [vm' (try (vm/run vm)\n+                           (catch #?(:cljd Object :clj Exception :cljs js/Error)\n+                                  error\n+                             (throw (link-raise error vm state))))]\n+              (recur (if link? (inc i) i) vm' state pending true))\n+            [state vm pending progress?]))))))\n \n \n (defn- tokenize\n@@ -1112,7 +1187,7 @@ Hint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n         (finalize-eval state evaluated\n                        (engine/restore-initial-env (:env (:vm expanded)) vm))\n \n-        (link-waiting? vm)\n+        (or (link-waiting? vm) (query/waiting? vm))\n         (let [[state' vm' pending] (drive-links evaluated vm)]\n           (cond\n             (vm/halted? vm')\n@@ -1139,7 +1214,10 @@ Hint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n                      {:id-counter (::link-counter d)\n                       :origins (::link-origins d)})\n                    (:vm state))]\n-        (consume-failed-round (assoc expanded :vm base) error)))))\n+        (consume-failed-round (cond-> (assoc expanded :vm base)\n+                                (::query-pair d) (assoc :query-pair\n+                                                        (::query-pair d)))\n+                              error)))))\n \n \n (defn- eval-program\n@@ -1377,12 +1455,13 @@ Hint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n         (let [[st text] (drain-output state)\n               d (ex-data error)]\n           (fold-queued\n-            [(assoc st\n-                    :vm (carry-link-identity\n-                          (:base parked)\n-                          {:id-counter (::link-counter d)\n-                           :origins (::link-origins d)})\n-                    :pending-run nil)\n+            [(cond-> (assoc st\n+                            :vm (carry-link-identity\n+                                  (:base parked)\n+                                  {:id-counter (::link-counter d)\n+                                   :origins (::link-origins d)})\n+                            :pending-run nil)\n+               (::query-pair d) (assoc :query-pair (::query-pair d)))\n              (str text\n                   (format-error error)\n                   (dropped-lines-text (count (:pending-lines parked))))]\n     1\t(ns yin.repl.query\n     2\t  \"The shell's query bridge: `(require 'dao.space.query)` activates\n     3\t   `dao.space.query/q` over the session's code index\n     4\t   (docs/design/yin.repl.dao.space-index.md, \\\"Query surface\\\").\n     5\t\n     6\t   `dao.space.query` is a session-scoped host module that is absent from\n     7\t   the VM's registry until the user requires it.  The session's registry\n     8\t   answers `:module/require` for that one name by installing the module\n     9\t   into the requiring VM's own registry value, and hands every other name\n    10\t   to `yin.vm.module/require-handler` unchanged.  Before the require, the\n    11\t   qualified export fails name resolution like any unknown name.  A session\n    12\t   rebuild (`(reset)`, `(vm ...)`) builds a fresh registry, which drops the\n    13\t   module.\n    14\t\n    15\t   The export `q` is a data constructor: it returns a `::call` effect\n    16\t   carrying its arguments, and the session registry's handler for that\n    17\t   effect parks the calling continuation as an ordinary FFI call on the\n    18\t   VM's `dao.stream.apply` call pair.  The call uses the VM's own park id,\n    19\t   caller-scoped call id and response reader (`yin.vm.ffi`), so the engine's\n    20\t   FFI response router wakes the call and `ffi/call-result` unwraps the\n    21\t   answer or raises its error, exactly as for a `dao.stream.apply/call`\n    22\t   node.  The request carries only data: the query, its `:in` inputs, and\n    23\t   an optional final options map.\n    24\t\n    25\t   The shell owns the other end of the pair.  `serve` reads each request\n    26\t   and answers it from the indexer the shell holds when it serves, never\n    27\t   from state captured when the session was built: the snapshot is the\n    28\t   latest manifest the indexer published and read back.  A lost indexer,\n    29\t   a recorded failure, or committed code not yet published refuses the\n    30\t   call, because an older manifest must not be presented as complete.  A\n    31\t   session that has committed nothing is a valid empty database.\n    32\t\n    33\t   Answers and refusals are portable data.  Refusals use the FFI error\n    34\t   envelope under a stable code: `::index-unavailable`, `::invalid-input`,\n    35\t   `::result-limit`, or `::query-failed` for a query the engine rejects.\n    36\t   Limits are the caller's: `serve` takes the row and encoded-byte bound\n    37\t   and checks both before it appends a response.\"\n    38\t  (:require #?@(:cljd [[\"dart:typed_data\" :refer [Uint8List]]]\n    39\t                :default [])\n    40\t            [dao.jing.cbor :as cbor]\n    41\t            [dao.space.index :as index]\n    42\t            [dao.space.query :as query]\n    43\t            [dao.stream :as stream]\n    44\t            [dao.stream.apply :as apply2]\n    45\t            [dao.stream.ringbuffer :as ring]\n    46\t            [yin.repl.index :as repl.index]\n    47\t            [yin.vm :as vm]\n    48\t            [yin.vm.engine :as engine]\n    49\t            [yin.vm.ffi :as ffi]\n    50\t            [yin.vm.module :as module]))\n    51\t\n    52\t\n    53\t(def module-name\n    54\t  \"The module `(require 'dao.space.query)` activates.\"\n    55\t  'dao.space.query)\n    56\t\n    57\t\n    58\t(def op\n    59\t  \"The `dao.stream.apply` operation a `q` call requests.\"\n    60\t  ::q)\n    61\t\n    62\t\n    63\t(def views\n    64\t  \"The options map's `:view` values and the `dao.space.query` interpreter\n    65\t   each names.  `:current` is the default.\"\n    66\t  {:current query/current\n    67\t   :history query/history})\n    68\t\n    69\t\n    70\t;; =============================================================================\n    71\t;; The module and its call\n    72\t;; =============================================================================\n    73\t\n    74\t(defn- q\n    75\t  \"The export: a data constructor.  The effect it returns is answered by\n    76\t   `call-handler`, which parks the caller on the call pair.\"\n    77\t  [& args]\n    78\t  {:effect ::call, :args (vec args)})\n    79\t\n    80\t\n    81\t(def ^:private exports\n    82\t  {'q q})\n    83\t\n    84\t\n    85\t(def ^:private profiles\n    86\t  {'q (vm/primitive-profile 'q :effectful [1 2 :variadic] #{::call} :none)})\n    87\t\n    88\t\n    89\t(defn activate\n    90\t  \"`registry` with the `dao.space.query` host module installed.\"\n    91\t  [registry]\n    92\t  (module/register-host-module registry module-name exports profiles))\n    93\t\n    94\t\n    95\t(defn- require-handler\n    96\t  \"`:module/require` for a session with the query bridge: the first\n    97\t   require of `dao.space.query` installs the module into the requiring\n    98\t   VM's registry value and answers at once; every other require, and a\n    99\t   repeated one, is `module/require-handler`'s.\"\n   100\t  [state effect opts]\n   101\t  (if (and (= module-name (:module effect))\n   102\t           (nil? (module/resolve-module (:modules state) module-name)))\n   103\t    {:value module-name,\n   104\t     :state (update state :modules activate),\n   105\t     :blocked? false}\n   106\t    (module/require-handler state effect opts)))\n   107\t\n   108\t\n   109\t(defn- blocked\n   110\t  [state entry]\n   111\t  {:state (-> state\n   112\t              (update :wait-set (fnil conj []) entry)\n   113\t              (assoc :value :yin/blocked\n   114\t                     :blocked? true\n   115\t                     :halted? false)),\n   116\t   :value :yin/blocked,\n   117\t   :blocked? true})\n   118\t\n   119\t\n   120\t(defn- call-handler\n   121\t  \"Park the continuation of a `q` call as an FFI call and append its\n   122\t   request.  The continuation's registers come from the VM's own\n   123\t   `:module/require` park builder, the parking point every kernel supplies\n   124\t   for an effectful primitive.  The walker's response reader nests its\n   125\t   continuation in an `eval-call` frame (`ffi/call-response-wait-entry`);\n   126\t   the positional kernels wait on their register payload\n   127\t   (`ffi/response-wait-entry`).  The pair's call-in is a ring buffer, which\n   128\t   never answers `full`, so any outcome but `ok` fails the call.\"\n   129\t  [state effect {:keys [park-entry-fns]}]\n   130\t  (let [build (get park-entry-fns :module/require)\n   131\t        _ (when-not build\n   132\t            (throw (ex-info \"dao.space.query/q cannot park at this call site\"\n   133\t                            {:op op})))\n   134\t        {:keys [call-in]} (ffi/require-call-pair! (:resources state) op)\n   135\t        regs (build state effect nil)\n   136\t        call-id (ffi/call-id state (engine/park-id state))\n   137\t        walker? (= :ast-walker (:vm-model state))\n   138\t        parked (engine/park-continuation\n   139\t                 state\n   140\t                 (if walker?\n   141\t                   {:k {:type :dao.stream.apply/eval-call,\n   142\t                        :next (:k regs),\n   143\t                        :env (:env regs)},\n   144\t                    :env (:env regs)}\n   145\t                   regs)\n   146\t                 call-id)\n   147\t        outcome (:dao.stream/outcome\n   148\t                  (apply2/put-request! call-in\n   149\t                                       (apply2/request call-id op\n   150\t                                                       (vec (:args effect)))))]\n   151\t    (when-not (= :dao.stream/ok outcome)\n   152\t      (throw (ex-info \"dao.space.query/q request could not be appended\"\n   153\t                      {:op op, :outcome outcome})))\n   154\t    (blocked parked\n   155\t             (if walker?\n   156\t               (ffi/call-response-wait-entry call-id (:k regs) (:env regs))\n   157\t               (ffi/response-wait-entry regs call-id)))))\n   158\t\n   159\t\n   160\t(defn register\n   161\t  \"`registry` with the bridge's effect handlers: the session's\n   162\t   `:module/require`, and the `q` call.  The module itself is not\n   163\t   installed.\"\n   164\t  [registry]\n   165\t  (-> registry\n   166\t      (module/register-effect-handler :module/require require-handler)\n   167\t      (module/register-effect-handler ::call call-handler)))\n   168\t\n   169\t\n   170\t(defn waiting?\n   171\t  \"True while `vm` waits on a query call: a response reader or a retained\n   172\t   request writer of the call pair.\"\n   173\t  [vm]\n   174\t  (boolean (some #(or (some? (ffi/response-call-id %))\n   175\t                      (some? (ffi/request-call-id %)))\n   176\t                 (:wait-set vm))))\n   177\t\n   178\t\n   179\t;; =============================================================================\n   180\t;; The call pair\n   181\t;; =============================================================================\n   182\t\n   183\t(defn- medium\n   184\t  [capacity]\n   185\t  (:dao.stream/handle\n   186\t    (ring/create! {:dao.stream/type ring/transport-type\n   187\t                   ring/capacity-key capacity})))\n   188\t\n   189\t\n   190\t(defn make-pair\n   191\t  \"The session's query call pair: `:call-in` and `:call-out` media of\n   192\t   `capacity` elements, `:out-cursor` the call-out cursor the VM is\n   193\t   constructed with (the pair is supplied, so its cursor is too), and\n   194\t   `:cursor` the interpreter's own call-in cursor, both minted before any\n   195\t   request exists.\"\n   196\t  [capacity]\n   197\t  (let [call-in (medium capacity)\n   198\t        call-out (medium capacity)]\n   199\t    {:call-in call-in\n   200\t     :call-out call-out\n   201\t     :out-cursor (vm/mint-oldest call-out :yin.repl/query)\n   202\t     :cursor (vm/mint-oldest call-in :yin.repl/query)}))\n   203\t\n   204\t\n   205\t;; =============================================================================\n   206\t;; Answering one request\n   207\t;; =============================================================================\n   208\t\n   209\t(defn- refusal\n   210\t  [code message data]\n   211\t  (merge (apply2/error code (str message \" (\" code \")\")) data))\n   212\t\n   213\t\n   214\t(defn- refused?\n   215\t  [x]\n   216\t  (and (map? x) (contains? x apply2/code-key)))\n   217\t\n   218\t\n   219\t(defn- unavailable\n   220\t  [reason]\n   221\t  (refusal ::index-unavailable\n   222\t           (str \"the code index is unavailable: \" reason\n   223\t                \"; (reset) rebuilds it\")\n   224\t           nil))\n   225\t\n   226\t\n   227\t(defn- invalid\n   228\t  [message]\n   229\t  (refusal ::invalid-input message nil))\n   230\t\n   231\t\n   232\t(defn- snapshot\n   233\t  \"The database a call reads, or a refusal: the latest manifest the\n   234\t   indexer published, read back from its store.  Committed code must all\n   235\t   be published, so no older manifest stands in for the current one.\"\n   236\t  [indexer]\n   237\t  (let [{:keys [lost? failure published? transactions]}\n   238\t        (repl.index/status indexer)]\n   239\t    (cond\n   240\t      lost?\n   241\t      (unavailable \"a program batch was lost before it was indexed\")\n   242\t\n   243\t      failure\n   244\t      (unavailable (str \"round \" (:round failure) \" was not indexed (\"\n   245\t                        (name (:stage failure)) \" failed)\"))\n   246\t\n   247\t      (zero? transactions)\n   248\t      (query/relation [])\n   249\t\n   250\t      (not published?)\n   251\t      (unavailable \"committed code is not published\")\n   252\t\n   253\t      :else\n   254\t      (try\n   255\t        (query/relation (index/read-datoms (:content-store indexer)\n   256\t                                           (:manifest-address indexer)))\n   257\t        (catch #?(:cljd Object :clj Exception :cljs :default) e\n   258\t          (unavailable (str \"the published index could not be read: \"\n   259\t                            (or (ex-message e) (str e)))))))))\n   260\t\n   261\t\n   262\t(defn- byte-length\n   263\t  [bs]\n   264\t  #?(:cljd (.-length ^Uint8List bs)\n   265\t     :default (alength bs)))\n   266\t\n   267\t\n   268\t(defn- encoded-size\n   269\t  \"The canonical CBOR size of `x`, or nil when `x` is not portable data.\"\n   270\t  [x]\n   271\t  (try\n   272\t    (byte-length (cbor/encode x))\n   273\t    (catch #?(:cljd Object :clj Exception :cljs :default) _ nil)))\n   274\t\n   275\t\n   276\t(defn- split-args\n   277\t  \"`[inputs options]` of the arguments after the query: a final map is\n   278\t   the options map, and every argument before it an `:in` input.\"\n   279\t  [args]\n   280\t  (if (map? (last args))\n   281\t    [(vec (butlast args)) (last args)]\n   282\t    [(vec args) nil]))\n   283\t\n   284\t\n   285\t(defn- view-of\n   286\t  \"The view the options name, or a refusal.\"\n   287\t  [options]\n   288\t  (cond\n   289\t    (nil? options) (:current views)\n   290\t\n   291\t    (not= #{:view} (set (keys options)))\n   292\t    (invalid (str \"q options must be {:view :current} or {:view :history}, got \"\n   293\t                  (pr-str options)))\n   294\t\n   295\t    (contains? views (:view options)) (get views (:view options))\n   296\t\n   297\t    :else (invalid (str \"q :view must be :current or :history, got \"\n   298\t                        (pr-str (:view options))))))\n   299\t\n   300\t\n   301\t(defn- row-count\n   302\t  \"Rows of a collected result: a relation or collection counts its\n   303\t   members, a scalar or tuple is one.\"\n   304\t  [result]\n   305\t  (if (or (set? result) (sequential? result) (nil? result))\n   306\t    (count result)\n   307\t    1))\n   308\t\n   309\t\n   310\t(defn- evaluate\n   311\t  [db view query inputs {:keys [row-limit byte-limit]}]\n   312\t  (let [result (try\n   313\t                 {:value (query/collect\n   314\t                           (apply query/q query (view db) inputs))}\n   315\t                 (catch #?(:cljd Object :clj Exception :cljs :default) e\n   316\t                   {:refusal (refusal ::query-failed\n   317\t                                      (str \"query failed: \"\n   318\t                                           (or (ex-message e) (str e)))\n   319\t                                      nil)}))]\n   320\t    (if-let [r (:refusal result)]\n   321\t      r\n   322\t      (let [value (:value result)\n   323\t            rows (row-count value)\n   324\t            size (when (<= rows row-limit) (encoded-size value))]\n   325\t        (cond\n   326\t          (> rows row-limit)\n   327\t          (refusal ::result-limit\n   328\t                   (str \"the query result has \" rows\n   329\t                        \" rows, over the limit of \" row-limit)\n   330\t                   {::limit {:rows row-limit}})\n   331\t\n   332\t          (nil? size)\n   333\t          (refusal ::query-failed\n   334\t                   \"the query result is not portable Yin data\"\n   335\t                   nil)\n   336\t\n   337\t          (> size byte-limit)\n   338\t          (refusal ::result-limit\n   339\t                   (str \"the query result encodes to \" size\n   340\t                        \" bytes, over the limit of \" byte-limit)\n   341\t                   {::limit {:bytes byte-limit}})\n   342\t\n   343\t          :else {:ok value})))))\n   344\t\n   345\t\n   346\t(defn answer\n   347\t  \"The response to one call-pair `request`, answered from `indexer`\n   348\t   under `limits` (`{:row-limit n :byte-limit n}`).\"\n   349\t  [indexer limits request]\n   350\t  (let [id (apply2/request-id request)\n   351\t        [query & more] (apply2/request-args request)\n   352\t        answer (cond\n   353\t                 (not= op (apply2/request-op request))\n   354\t                 (refusal :dao.stream.apply/unknown-operation\n   355\t                          \"No handler for operation\"\n   356\t                          nil)\n   357\t\n   358\t                 (nil? (encoded-size (apply2/request-args request)))\n   359\t                 (invalid (str \"q takes portable Yin data only: nil, booleans,\"\n   360\t                               \" numbers, strings, keywords, symbols, and\"\n   361\t                               \" vectors, lists, sets and maps of them\"))\n   362\t\n   363\t                 (not (or (vector? query) (map? query)))\n   364\t                 (invalid (str \"q expects a query vector or map, got \"\n   365\t                               (pr-str query)))\n   366\t\n   367\t                 :else\n   368\t                 (let [[inputs options] (split-args more)\n   369\t                       view (view-of options)\n   370\t                       db (when-not (refused? view) (snapshot indexer))]\n   371\t                   (cond\n   372\t                     (refused? view) view\n   373\t                     (refused? db) db\n   374\t                     :else (evaluate db view query inputs limits))))]\n   375\t    (if (refused? answer)\n   376\t      {apply2/id-key id, apply2/error-key answer}\n   377\t      (apply2/success-response id (:ok answer)))))\n   378\t\n   379\t\n   380\t;; =============================================================================\n   381\t;; The interpreter\n   382\t;; =============================================================================\n   383\t\n   384\t(defn serve\n   385\t  \"One serve round of the query interpreter over `pair`: answer every\n   386\t   request its cursor has not consumed, from `indexer` as it stands now,\n   387\t   at most `budget` of them.  A response is appended before the cursor\n   388\t   moves past its request; one the call-out refuses leaves the request to\n   389\t   be re-read.  A value that is not a request envelope is consumed\n   390\t   unanswered: no call made it.  Returns `{:pair pair :progress? bool}`.\"\n   391\t  [{:keys [pair indexer limits budget]}]\n   392\t  (loop [pair pair\n   393\t         remaining budget\n   394\t         progress? false]\n   395\t    (let [r (when (pos? remaining)\n   396\t              (stream/next (:call-in pair) (:cursor pair)))]\n   397\t      (if-not (= :dao.stream/ok (:dao.stream/outcome r))\n   398\t        {:pair pair, :progress? progress?}\n   399\t        (let [request (:dao.stream/value r)\n   400\t              response (when (apply2/request? request)\n   401\t                         (answer indexer limits request))\n   402\t              landed? (or (nil? response)\n   403\t                          (= :dao.stream/ok\n   404\t                             (:dao.stream/outcome\n   405\t                               (apply2/put-response! (:call-out pair)\n   406\t                                                     response))))]\n   407\t          (if landed?\n   408\t            (recur (assoc pair :cursor (:dao.stream/cursor r))\n   409\t                   (dec remaining)\n   410\t                   true)\n   411\t            {:pair pair, :progress? progress?}))))))\n     1\t(ns yin.repl.query-test\n     2\t  \"`(require 'dao.space.query)` activates `dao.space.query/q` over the\n     3\t   session's code index (docs/design/yin.repl.dao.space-index.md, \\\"Query\n     4\t   surface\\\"; yin.repl.query).  Every shell-level case runs on every VM the\n     5\t   shell supports.  Input lines stay readable by every host's\n     6\t   non-evaluating reader, so quoted forms are spelled `(quote ...)`.\"\n     7\t  (:require [clojure.string :as str]\n     8\t            [clojure.test :refer [deftest is testing]]\n     9\t            [dao.stream :as stream]\n    10\t            [dao.stream.apply :as apply2]\n    11\t            [dao.stream.observer :as observer]\n    12\t            [dao.stream.ringbuffer :as ring]\n    13\t            [yin.repl :as repl]\n    14\t            [yin.repl.index :as repl.index]\n    15\t            [yin.repl.query :as query]\n    16\t            [yin.vm.macro :as macro]))\n    17\t\n    18\t\n    19\t(def ^:private vm-types\n    20\t  (keys repl/vm-constructors))\n    21\t\n    22\t\n    23\t(defn- evaluate\n    24\t  [state lines]\n    25\t  (reduce (fn [[state texts] line]\n    26\t            (let [[state' text] (repl/eval-input state line)]\n    27\t              [state' (conj texts text)]))\n    28\t          [state []]\n    29\t          lines))\n    30\t\n    31\t\n    32\t(defn- q-line\n    33\t  \"A `dao.space.query/q` call on `query`, with `more` argument source\n    34\t   appended.\"\n    35\t  [query & more]\n    36\t  (str \"(dao.space.query/q (quote \" (pr-str query) \")\"\n    37\t       (apply str (map #(str \" \" %) more))\n    38\t       \")\"))\n    39\t\n    40\t\n    41\t(def ^:private require-line\n    42\t  \"(require (quote dao.space.query))\")\n    43\t\n    44\t\n    45\t(def ^:private unresolved\n    46\t  \"Error: Unable to resolve symbol: dao.space.query/q in this context\")\n    47\t\n    48\t\n    49\t(def ^:private names-query\n    50\t  '[:find ?n :where [?e :yin/type :variable] [?e :yin/name ?n]])\n    51\t\n    52\t\n    53\t;; =============================================================================\n    54\t;; Activation\n    55\t;; =============================================================================\n    56\t\n    57\t(deftest q-is-unresolved-until-required-and-bare-q-is-never-bound\n    58\t  (doseq [vm-type vm-types]\n    59\t    (testing (str vm-type)\n    60\t      (let [[_ [before required after bare]]\n    61\t            (evaluate (repl/create-state {:vm-type vm-type})\n    62\t                      [(q-line names-query)\n    63\t                       require-line\n    64\t                       (q-line '[:find ?e :where [?e :no/such 1]])\n    65\t                       \"(q (quote [:find ?e :where [?e :no/such 1]]))\"])]\n    66\t        (is (= unresolved before))\n    67\t        (is (= \"'dao.space.query\" required))\n    68\t        (is (= \"#{}\" after) \"the require activated the qualified export\")\n    69\t        (is (= \"Error: Unable to resolve symbol: q in this context\" bare)\n    70\t            \"no import rule binds the bare name\")))))\n    71\t\n    72\t\n    73\t(deftest reset-removes-the-binding-and-a-new-require-restores-it\n    74\t  (doseq [vm-type vm-types]\n    75\t    (testing (str vm-type)\n    76\t      (let [[_ [_ active _ removed _ again]]\n    77\t            (evaluate (repl/create-state {:vm-type vm-type})\n    78\t                      [require-line\n    79\t                       (q-line '[:find ?e :where [?e :no/such 1]])\n    80\t                       \"(reset)\"\n    81\t                       (q-line '[:find ?e :where [?e :no/such 1]])\n    82\t                       require-line\n    83\t                       (q-line '[:find ?e :where [?e :no/such 1]])])]\n    84\t        (is (= \"#{}\" active))\n    85\t        (is (= unresolved removed))\n    86\t        (is (= \"#{}\" again))))))\n    87\t\n    88\t\n    89\t(deftest vm-selection-removes-the-binding\n    90\t  (let [[_ [_ switched removed]]\n    91\t        (evaluate (repl/create-state)\n    92\t                  [require-line \"(vm :stack)\"\n    93\t                   (q-line '[:find ?e :where [?e :no/such 1]])])]\n    94\t    (is (str/starts-with? switched \"Switched to\"))\n    95\t    (is (= unresolved removed))))\n    96\t\n    97\t\n    98\t;; =============================================================================\n    99\t;; Answers\n   100\t;; =============================================================================\n   101\t\n   102\t(deftest a-def-is-queryable-by-its-name-and-facts\n   103\t  (doseq [vm-type vm-types]\n   104\t    (testing (str vm-type)\n   105\t      (let [[_ [_ _ named names kind absent]]\n   106\t            (evaluate (repl/create-state {:vm-type vm-type})\n   107\t                      [require-line\n   108\t                       \"(def answer (fn [x] (+ x 42)))\"\n   109\t                       (q-line '[:find ?e . :in $ ?n :where [?e :yin/value ?n]]\n   110\t                               \"(quote answer)\")\n   111\t                       (q-line names-query)\n   112\t                       (q-line '[:find ?t . :in $ ?n\n   113\t                                 :where [?e :yin/value ?n] [?e :yin/type ?t]]\n   114\t                               \"(quote answer)\")\n   115\t                       (q-line '[:find ?e :where [?e :no/such 1]])])]\n   116\t        (is (re-matches #\"\\d+\" named)\n   117\t            \"the defined name is an indexed literal, by default in the current view\")\n   118\t        (is (every? #(str/includes? names %) [\"[x]\" \"[+]\" \"[yin/def]\"])\n   119\t            \"the definition's body facts are indexed\")\n   120\t        (is (= \":literal\" kind))\n   121\t        (is (= \"#{}\" absent) \"a query with no match is an empty relation\")))))\n   122\t\n   123\t\n   124\t(deftest the-history-view-reaches-session-and-round-through-m\n   125\t  (doseq [vm-type vm-types]\n   126\t    (testing (str vm-type)\n   127\t      (let [[state [_ _ provenance current]]\n   128\t            (evaluate (repl/create-state {:vm-type vm-type})\n   129\t                      [require-line\n   130\t                       \"(def answer 42)\"\n   131\t                       (q-line '[:find ?s ?r\n   132\t                                 :where [?e :yin/root true ?t ?m]\n   133\t                                 [?m :yin.repl/session ?s ?t1 ?m1]\n   134\t                                 [?m :yin.repl/round ?r ?t2 ?m2]]\n   135\t                               \"{:view :history}\")\n   136\t                       (q-line '[:find ?s ?r\n   137\t                                 :where [?e :yin/root true ?t ?m]\n   138\t                                 [?m :yin.repl/session ?s ?t1 ?m1]\n   139\t                                 [?m :yin.repl/round ?r ?t2 ?m2]])])\n   140\t            token (:shell-token state)]\n   141\t        (is (= 3 (count (re-seq #\"\\[\\\"[^\\\"]+\\\" \\d+\\]\" provenance))))\n   142\t        (is (every? #(str/includes? provenance (pr-str [token %])) [1 2 3])\n   143\t            \"every program, the calling one included, reaches its provenance\")\n   144\t        (is (= \"#{}\" current)\n   145\t            \"the current view binds [e a v]; its extra slots match nothing\")))))\n   146\t\n   147\t\n   148\t(defn- stream-values\n   149\t  \"Every value currently on a stream, read from its oldest cursor.\"\n   150\t  [s]\n   151\t  (loop [cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n   152\t         acc []]\n   153\t    (let [r (stream/next s cursor)]\n   154\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n   155\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n   156\t        acc))))\n   157\t\n   158\t\n   159\t(deftest a-failed-round-keeps-its-answers-answered\n   160\t  (doseq [vm-type vm-types]\n   161\t    (testing (str vm-type)\n   162\t      (let [[state [_ _ failed answered]]\n   163\t            (evaluate (repl/create-state {:vm-type vm-type})\n   164\t                      [require-line\n   165\t                       \"(def answer 42)\"\n   166\t                       (str \"((fn [a] (nope a)) \"\n   167\t                            (q-line '[:find ?v :where [?e :yin/value ?v]])\n   168\t                            \")\")\n   169\t                       (q-line '[:find ?v . :where [?e :yin/value 42]\n   170\t                                 [?e :yin/value ?v]])])]\n   171\t        (is (str/starts-with? failed \"Error: Unable to resolve symbol: nope\"))\n   172\t        (is (= \"42\" answered)\n   173\t            \"the rolled-back VM's first call does not take the failed round's response\")\n   174\t        (is (= (mapv apply2/request-id\n   175\t                     (stream-values (get-in state [:query-pair :call-in])))\n   176\t               (mapv apply2/response-id\n   177\t                     (stream-values (get-in state [:query-pair :call-out]))))\n   178\t            \"the interpreter answered each request exactly once\")))))\n   179\t\n   180\t\n   181\t;; =============================================================================\n   182\t;; Refusals\n   183\t;; =============================================================================\n   184\t\n   185\t(deftest an-unavailable-index-refuses-the-call\n   186\t  (testing \"a lost indexer\"\n   187\t    (doseq [vm-type vm-types]\n   188\t      (testing (str vm-type)\n   189\t        (let [writer (:dao.stream/handle\n   190\t                       (ring/create! {:dao.stream/type ring/transport-type\n   191\t                                      ring/capacity-key 1}))\n   192\t              descriptor (:dao.stream/descriptor (stream/descriptor writer))\n   193\t              lossy (observer/attach\n   194\t                      (ring/make-attacher {(:dao.stream/identity descriptor)\n   195\t                                           writer})\n   196\t                      descriptor)\n   197\t              _ (doseq [v [1 2]]\n   198\t                  (stream/append! writer\n   199\t                                  (macro/ast->packet {:type :literal\n   200\t                                                      :value v})))\n   201\t              [state _] (repl/eval-input (repl/create-state {:vm-type vm-type})\n   202\t                                         require-line)\n   203\t              [_ text] (repl/eval-input (assoc-in state [:indexer :observer]\n   204\t                                                  lossy)\n   205\t                                        (q-line names-query))]\n   206\t          (is (str/starts-with? text \"Error: FFI call failed: the code index is unavailable\"))\n   207\t          (is (str/includes? text \"(:yin.repl.query/index-unavailable)\"))))))\n   208\t  (testing \"a failed publication\"\n   209\t    (doseq [vm-type vm-types]\n   210\t      (testing (str vm-type)\n   211\t        (let [broken {:put-bytes-fn (fn [_address _bytes]\n   212\t                                      (throw (ex-info \"store refused\" {})))\n   213\t                      :get-bytes-fn (fn [_address not-found] not-found)}\n   214\t              [_ [_ text]]\n   215\t              (evaluate (repl/create-state {:vm-type vm-type\n   216\t                                            :index-store broken})\n   217\t                        [require-line (q-line names-query)])]\n   218\t          (is (str/includes? text \"(:yin.repl.query/index-unavailable)\"))\n   219\t          (is (str/includes? text \"publish failed\"))))))\n   220\t  (testing \"committed code that is not published\"\n   221\t    (let [[state _] (evaluate (repl/create-state) [\"(+ 1 2)\"])\n   222\t          unpublished (assoc (:indexer state) :published 0)\n   223\t          response (query/answer unpublished\n   224\t                                 {:row-limit 10, :byte-limit 1000}\n   225\t                                 (apply2/request 7 query/op [names-query]))]\n   226\t      (is (false? (:published? (repl.index/status unpublished))))\n   227\t      (is (nil? (:failure (repl.index/status unpublished))))\n   228\t      (is (= :yin.repl.query/index-unavailable\n   229\t             (:dao.stream.apply/code (apply2/response-error response))))))\n   230\t  (testing \"a published index its store can no longer answer\"\n   231\t    (let [[state _] (evaluate (repl/create-state) [\"(+ 1 2)\"])\n   232\t          unreadable (assoc (:indexer state) :content-store\n   233\t                            {:put-bytes-fn (fn [_address _bytes] nil)\n   234\t                             :get-bytes-fn (fn [_address not-found]\n   235\t                                             not-found)})\n   236\t          error (apply2/response-error\n   237\t                  (query/answer unreadable\n   238\t                                {:row-limit 10, :byte-limit 1000}\n   239\t                                (apply2/request 7 query/op [names-query])))]\n   240\t      (is (true? (:published? (repl.index/status unreadable))))\n   241\t      (is (= :yin.repl.query/index-unavailable (:dao.stream.apply/code error)))\n   242\t      (is (str/includes? (:dao.stream.apply/message error)\n   243\t                         \"could not be read\")))))\n   244\t\n   245\t\n   246\t(deftest an-empty-session-is-an-empty-database\n   247\t  (let [indexer (:indexer (repl/create-state))\n   248\t        response (query/answer indexer\n   249\t                               {:row-limit 10, :byte-limit 1000}\n   250\t                               (apply2/request 1 query/op\n   251\t                                               ['[:find ?e ?a ?v\n   252\t                                                  :where [?e ?a ?v]]]))]\n   253\t    (is (zero? (:transactions (repl.index/status indexer))))\n   254\t    (is (= #{} (apply2/response-ok response)))))\n   255\t\n   256\t\n   257\t(deftest results-over-a-limit-refuse-naming-it\n   258\t  (testing \"the shell's row limit, on every VM\"\n   259\t    (doseq [vm-type vm-types]\n   260\t      (testing (str vm-type)\n   261\t        (let [[_ [_ _ text]]\n   262\t              (evaluate (repl/create-state {:vm-type vm-type})\n   263\t                        [require-line\n   264\t                         (str \"(+ \" (str/join \" \" (range 1100)) \")\")\n   265\t                         (q-line '[:find ?v :where [?e :yin/value ?v]])])]\n   266\t          (is (str/includes? text \"(:yin.repl.query/result-limit)\"))\n   267\t          (is (str/includes? text (str \"over the limit of \" repl/query-row-limit)))))))\n   268\t  (let [[state _] (evaluate (repl/create-state)\n   269\t                            [\"(def answer \\\"a long string literal\\\")\"])\n   270\t        ask (fn [limits query & inputs]\n   271\t              (apply2/response-error\n   272\t                (query/answer (:indexer state) limits\n   273\t                              (apply2/request 1 query/op\n   274\t                                              (into [query] inputs)))))\n   275\t        by-value '[:find ?v . :in $ ?v :where [?e :yin/value ?v]]]\n   276\t    (testing \"the row limit is checked on the collected rows\"\n   277\t      (let [error (ask {:row-limit 2, :byte-limit 100000}\n   278\t                       '[:find ?e ?a ?v :where [?e ?a ?v]])]\n   279\t        (is (= :yin.repl.query/result-limit (:dao.stream.apply/code error)))\n   280\t        (is (= {:rows 2} (:yin.repl.query/limit error)))))\n   281\t    (testing \"the byte limit is checked on the encoded answer\"\n   282\t      (let [error (ask {:row-limit 1000, :byte-limit 8}\n   283\t                       by-value \"a long string literal\")]\n   284\t        (is (= :yin.repl.query/result-limit (:dao.stream.apply/code error)))\n   285\t        (is (= {:bytes 8} (:yin.repl.query/limit error)))\n   286\t        (is (str/includes? (:dao.stream.apply/message error)\n   287\t                           \"over the limit of 8\"))))\n   288\t    (testing \"an answer within