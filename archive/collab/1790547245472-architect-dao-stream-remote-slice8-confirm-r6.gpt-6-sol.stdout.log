{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '95,150p'; nl -ba test/yin/vm/ucf/remote_test.cljc | sed -n '1,155p'\"","aggregated_output":"    95\t   between evaluations.\"\n    96\t  [vm seg pc val St E K]\n    97\t  (assoc vm\n    98\t         :control (when seg {:segment seg, :pc pc})\n    99\t         :value val\n   100\t         :stack (or St [])\n   101\t         :env E\n   102\t         :k (if (seq K) K nil)\n   103\t         :halted? (and (not (:blocked? vm)) (nil? seg))))\n   104\t\n   105\t\n   106\t(defn- response-wait-entry\n   107\t  \"The polling wait entry for a sent call awaiting its correlated response:\n   108\t   the machine registers {segment pc env stack k} plus the call-out reader\n   109\t   fields, in the shape `ffi/call-response-wait-entry` gives the walker.\"\n   110\t  [seg pc env stack k call-id]\n   111\t  {:segment seg, :pc pc, :env env, :stack stack, :k k,\n   112\t   :call-id call-id,\n   113\t   :reason :next,\n   114\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   115\t   :stream-id vm/call-out-stream-key})\n   116\t\n   117\t\n   118\t(defn semantic-restore\n   119\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   120\t\n   121\t   Two entry shapes carry more than registers:\n   122\t\n   123\t   - A `:request-sent` entry is a writer whose retained FFI request has now\n   124\t     been appended. The call starts waiting for its correlated response,\n   125\t     exactly as an immediately-sent one does, so the entry is replaced by its\n   126\t     response reader and the machine stays blocked.\n   127\t   - A `:call-id` entry is a response reader. The woken value is a response\n   128\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\n   129\t     parked call leaves `:parked` rather than accumulating.\"\n   130\t  ([base entry] (semantic-restore base entry (:value entry)))\n   131\t  ([base entry val]\n   132\t   (if (:request-sent entry)\n   133\t     (assoc base\n   134\t            :wait-set (conj (vec (or (:wait-set base) []))\n   135\t                            (response-wait-entry (:segment entry)\n   136\t                                                 (:pc entry)\n   137\t                                                 (:env entry)\n   138\t                                                 (:stack entry)\n   139\t                                                 (:k entry)\n   140\t                                                 (:call-id entry)))\n   141\t            :control nil\n   142\t            :k nil\n   143\t            :value :yin/blocked\n   144\t            :blocked? true\n   145\t            :halted? false)\n   146\t     (let [call-id (:call-id entry)\n   147\t           base (if call-id (update base :parked dissoc call-id) base)\n   148\t           val (if call-id (ffi/call-result val call-id) val)]\n   149\t       (put-registers base\n   150\t                      (:segment entry)\n     1\t(ns yin.vm.ucf.remote-test\n     2\t  \"The slice 8 acceptance row\n     3\t   (`docs/design/dao.stream.remote.implementation-plan.md` slice 8;\n     4\t   `yin.vm.universal-continuation-format.md` S7.4.3, S7.5.3, S7.11.1\n     5\t   'Reflection acceptance'): a REAL machine parked through the engine\n     6\t   on a `:stream-next` wait migrates with a kept cursor and resumes\n     7\t   equivalently in a fresh engine state through a reflection; forced\n     8\t   eviction yields `gap` with the source's own recovery cursor; a\n     9\t   kept cursor that cannot survive the channel codec refuses the lift\n    10\t   before any cell is published; a source `serve!` refuses is\n    11\t   `:yin.k/unsatisfied`; an `attach!` that answers gone is\n    12\t   `:yin.k/unsatisfied` naming the stream at lower. Cursor cells are\n    13\t   minted and remapped across a whole frame set: two waiters on one\n    14\t   engine cell lift to one UCF cell and lower back shared, and\n    15\t   independent cells at one position stay independent (S7.5.3). The\n    16\t   remaining S7.4.3 variants -- `:put`, `:ffi`, `:ffi-request`,\n    17\t   `:link-request`, `:link-response`, `:install` -- round-trip\n    18\t   through stub `serve!`/`attach!` callbacks over the engine's own\n    19\t   wait-set shapes, since their proof is the shape of the bridge, not\n    20\t   the transport. The lowered waits the engine resolves at its own\n    21\t   fixed resource keys resume there for real: a retained\n    22\t   `:link-request` migrates and the engine's own poll retries it and\n    23\t   resumes on the response read at the fixed link keys; a retained\n    24\t   FFI request migrates, its retry appends at the fixed call-in key,\n    25\t   and the restored response wait -- `semantic-restore` parks it on\n    26\t   the receiver's fixed local call-out keys -- receives the retried\n    27\t   response the route cell carried.\"\n    28\t  (:require [clojure.test :refer [deftest is testing]]\n    29\t            [dao.stream :as stream]\n    30\t            [dao.stream.apply :as apply2]\n    31\t            [dao.stream.remote :as remote]\n    32\t            [dao.stream.ringbuffer :as ringbuffer]\n    33\t            [yin.vm :as vm]\n    34\t            [yin.vm.linearize :as linearize]\n    35\t            [yin.vm.module :as module]\n    36\t            [yin.vm.semantic :as semantic]\n    37\t            [yin.vm.ucf.remote :as ucf.remote]))\n    38\t\n    39\t\n    40\t;; =============================================================================\n    41\t;; The toy: two in-process ring buffers as the channel (as\n    42\t;; dao.stream.remote-test), with a served-table `serve!` on top\n    43\t;; =============================================================================\n    44\t\n    45\t(defn- ring\n    46\t  [capacity]\n    47\t  (:dao.stream/handle\n    48\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    49\t                         :dao.stream.ringbuffer/capacity capacity})))\n    50\t\n    51\t\n    52\t(defn- toy\n    53\t  []\n    54\t  (let [ab (ring 64)\n    55\t        ba (ring 64)\n    56\t        cd {:dao.stream/type :dao.stream.test/channel\n    57\t            :dao.stream/identity \"ucf-remote-toy\"}]\n    58\t    {:channel cd, :ab ab, :ba ba,\n    59\t     :a-end {:reader ba, :writer ab},\n    60\t     :b-end {:reader ab, :writer ba}}))\n    61\t\n    62\t\n    63\t(defn- served-peer\n    64\t  [t]\n    65\t  {:table (atom {})\n    66\t   :b-reader (:reader (:b-end t))\n    67\t   :b-writer (:writer (:b-end t))\n    68\t   :mirror (atom (:dao.stream/cursor\n    69\t                   (stream/cursor (:reader (:b-end t)) :dao.stream/oldest)))})\n    70\t\n    71\t\n    72\t(defn- serve-mirror!\n    73\t  \"One mirror step over everything pending on the toy's request\n    74\t   buffer.\"\n    75\t  [peer]\n    76\t  (swap! (:mirror peer)\n    77\t         #(remote/mirror-step @(:table peer) (:b-reader peer) %\n    78\t                              (:b-writer peer))))\n    79\t\n    80\t\n    81\t(defn- server\n    82\t  \"The exporter's `serve!` (dao.stream.remote.md S2.3): assigns a\n    83\t   stable identity to `h`, entering it in the peer's table under\n    84\t   `chan`, if it is not already served. The served surface defaults\n    85\t   to reader only; a stream the remote writes through -- a link\n    86\t   request stream the lowered retry appends to, a call-in stream the\n    87\t   retried FFI request lands on -- is served with the writer surface\n    88\t   too.\"\n    89\t  ([peer chan] (server peer chan #{:reader}))\n    90\t  ([peer chan surfaces]\n    91\t   (fn [h]\n    92\t     (if-let [existing (some (fn [[id e]] (when (= h (:handle e)) id))\n    93\t                             @(:table peer))]\n    94\t       {:dao.stream/identity existing, :dao.stream/channel chan}\n    95\t       (let [id (str (gensym \"seg\"))]\n    96\t         (swap! (:table peer) assoc id {:handle h, :surface surfaces})\n    97\t         {:dao.stream/identity id, :dao.stream/channel chan})))))\n    98\t\n    99\t\n   100\t(defn- attacher\n   101\t  [t]\n   102\t  (remote/attacher\n   103\t    {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))\n   104\t\n   105\t\n   106\t;; =============================================================================\n   107\t;; The emitter side: a real machine parked through the engine\n   108\t;; =============================================================================\n   109\t\n   110\t(def ^:private secret\n   111\t  \"The capability secret the test composition gives its machines.\"\n   112\t  \"yin.vm.ucf.remote-test/capability-secret\")\n   113\t\n   114\t\n   115\t(defn- make-ring-stream\n   116\t  \"The ring-buffer `:make-stream` this composition gives its\n   117\t   machines -- `yin.vm.test-utils`'s choice, at test scale.\"\n   118\t  [capacity]\n   119\t  (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n   120\t                       :dao.stream.ringbuffer/capacity capacity}))\n   121\t\n   122\t\n   123\t(defn- new-machine\n   124\t  \"A fresh semantic machine over that composition.\"\n   125\t  []\n   126\t  (semantic/create-vm {:make-stream make-ring-stream\n   127\t                       :capability-secret secret}))\n   128\t\n   129\t\n   130\t(def ^:private load-ast\n   131\t  \"The trusted fresh path: the AST linearizer behind the code loader.\"\n   132\t  (vm/fresh-code-loader (linearize/ast-loader semantic/vm-load-program)\n   133\t                        vm/ast-contract))\n   134\t\n   135\t\n   136\t(defn- var-ref\n   137\t  [n]\n   138\t  {:type :variable, :name n})\n   139\t\n   140\t\n   141\t(defn- let1\n   142\t  \"`((fn [param] body) init)`.\"\n   143\t  [param init body]\n   144\t  {:type :application,\n   145\t   :operator {:type :lambda, :params [param], :body body},\n   146\t   :operands [init]})\n   147\t\n   148\t\n   149\t(defn- reader-datoms\n   150\t  \"Make a stream of `capacity`, mint a cursor on it, read one value.\"\n   151\t  [capacity]\n   152\t  (vm/ast->datoms\n   153\t    (let1 's {:type :stream/make, :buffer capacity}\n   154\t          {:type :stream/next,\n   155\t           :source {:type :stream/cursor, :source (var-ref 's)}})))\n","exit_code":0,"status":"completed"}}
