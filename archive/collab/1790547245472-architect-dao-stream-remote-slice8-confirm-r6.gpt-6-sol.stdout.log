y keeps its envelope -- a retained\n   261\t   `:link-request`, the engine's own fields, registers and pair.\"\n   262\t  [name]\n   263\t  (let [request (one-slot-stream \"link-request\")\n   264\t        response (ring 64)\n   265\t        _ (stream/append! request :warmed)\n   266\t        datoms (requirer-datoms name)\n   267\t        parked (vm/run (load-ast (linking-machine request response)\n   268\t                                 datoms))\n   269\t        entry (first (:wait-set parked))]\n   270\t    [datoms parked entry request response]))\n   271\t\n   272\t\n   273\t(defn- call-node\n   274\t  \"A `:dao.stream.apply/call` of `op` with one literal argument.\"\n   275\t  [op arg]\n   276\t  {:type :dao.stream.apply/call, :op op,\n   277\t   :operands [(lit arg)]})\n   278\t\n   279\t\n   280\t(defn- then\n   281\t  \"`((fn [_] second) first)`: first for its effect, then second.\"\n   282\t  [first-ast second-ast]\n   283\t  {:type :application,\n   284\t   :operator {:type :lambda, :params ['_], :body second-ast},\n   285\t   :operands [first-ast]})\n   286\t\n   287\t\n   288\t(defn- calling-machine\n   289\t  \"A fresh semantic machine composed over an FFI call pair, under the\n   290\t   engine's own fixed pair keys (`vm.cljc`'s `:call-in`/`:call-out`\n   291\t   composition keys).\"\n   292\t  [call-in call-out]\n   293\t  (semantic/create-vm\n   294\t    {:make-stream make-ring-stream,\n   295\t     :capability-secret secret,\n   296\t     :call-in call-in,\n   297\t     :call-out call-out}))\n   298\t\n   299\t\n   300\t(defn- parked-caller\n   301\t  \"A real machine parked on a retained FFI request: the call-in\n   302\t   stream holds one warm-up value, so the first call's put refuses\n   303\t   with full and the entry keeps the request -- the engine's own\n   304\t   `:request-sent` shape, the pair under its fixed resource keys.\n   305\t   `ast` may call again after the first call, so a resume can watch\n   306\t   where a future call routes.\"\n   307\t  [ast]\n   308\t  (let [call-in (one-slot-stream \"call-in\")\n   309\t        call-out (ring 8)\n   310\t        _ (stream/append! call-in :warmed)\n   311\t        datoms (vm/ast->datoms ast)\n   312\t        parked (vm/run (load-ast (calling-machine call-in call-out)\n   313\t                                 datoms))\n   314\t        entry (first (:wait-set parked))]\n   315\t    [datoms parked entry call-in call-out]))\n   316\t\n   317\t\n   318\t(defn- registers-of\n   319\t  \"The register payload a parked entry carries.\"\n   320\t  [entry]\n   321\t  (select-keys entry [:segment :pc :env :stack :k]))\n   322\t\n   323\t\n   324\t(defn- quiesced-receiver\n   325\t  \"The fresh engine state a lower installs into: a real machine over\n   326\t   the same code image, quiesced, holding the lowered resource table\n   327\t   and the lowered wait-set entry -- nothing of the emitter's state\n   328\t   but the code image and the registers the entry carries.\"\n   329\t  ([datoms lowered] (quiesced-receiver datoms lowered (new-machine)))\n   330\t  ([datoms lowered machine]\n   331\t   (assoc (load-ast machine datoms)\n   332\t          :control nil, :k nil,\n   333\t          :value :yin/blocked, :blocked? true, :halted? false,\n   334\t          :wait-set [(:entry lowered)],\n   335\t          :resources (:resources lowered))))\n   336\t\n   337\t\n   338\t(defn- cursor-entries\n   339\t  \"The cursor entries of a lowered resource table: maps keyed by the\n   340\t   UCF cell ids, each carrying its stream id and kept cursor.\"\n   341\t  [table]\n   342\t  (into {} (filter (fn [[_ v]] (and (map? v) (contains? v :stream-id))))\n   343\t        table))\n   344\t\n   345\t\n","exit_code":0,"status":"completed"}}
