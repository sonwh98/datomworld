     (if-let [resp (streams resp-id)]\n   644\t            {:entry (merge ctx\n   645\t                           {:reason :put,\n   646\t                            :request-sent true,\n   647\t                            :call-id (:yin.k/call-id pending),\n   648\t                            :op (:yin.k/request-op pending),\n   649\t                            :stream-id req,\n   650\t                            :datom envelope,\n   651\t                            :response-cursor\n   652\t                            (cell-keys (:yin.k/response-cell pending)),\n   653\t                            :response-stream resp})}\n   654\t            (unsatisfied resp-id))\n   655\t          (unsatisfied req-id))\n   250\t  [resource]\n   251\t  (and (map? resource) (contains? resource :stream-id)))\n   252\t\n   253\t\n   254\t(defn issue-ref\n   255\t  \"A reference of `kind` (`:stream-ref` or `:cursor-ref`) to resource\n   256\t   `id`, sealed under the task's capability secret. A task composed\n   257\t   without a secret cannot issue one: it fails closed rather than issue a\n   258\t   reference anyone could forge.\"\n   259\t  [state kind id]\n   260\t  (let [secret (:capability-secret state)]\n   261\t    (when (nil? secret)\n   262\t      (fail (str \"This task has no capability secret, so it cannot issue\"\n   263\t                 \" a resource reference\")\n   264\t            {:reason :no-capability-secret, :kind kind, :id id}))\n   265\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\n   266\t\n   267\t\n   268\t(defn authentic-ref?\n   269\t  \"True when `ref` is a `kind` reference this task issued: its seal\n   270\t   verifies under the task's secret, and it names a live resource of that\n   271\t   kind.\"\n   272\t  [state kind ref]\n   273\t  (let [secret (:capability-secret state)\n   274\t        id (when (map? ref) (:id ref))\n   275\t        resource (get (:resources state) id)]\n   276\t    (boolean (and (some? secret)\n   277\t                  (= kind (:type ref))\n   278\t                  (some? resource)\n   279\t                  (= (:seal ref) (seal-of secret kind id))\n   280\t                  (= (= :cursor-ref kind) (cursor-cell? resource))))))\n   281\t\n   282\t\n   283\t(defn check-ref!\n   284\t  \"The resource id a program-supplied `kind` reference names, once its\n   285\t   seal verifies (r10). Anything else fails closed with\n   286\t   `:forged-resource-reference`, naming the effect and the id it named.\"\n   287\t  [state effect-kind kind ref]\n   288\t  (if (authentic-ref? state kind ref)\n   289\t    (:id ref)\n   290\t    (fail \"Forged resource reference\"\n   291\t          {:reason :forged-resource-reference,\n   292\t           :effect effect-kind,\n   293\t           :kind kind,\n   294\t           :id (when (map? ref) (:id ref))})))\n   295\t\n  1210\t   keeping the cursor at the first unconsumed position, and act only on\n  1211\t   exact correlation. `blocked` keeps waiting; `gap` and the terminal\n  1212\t   outcomes are raised as the effect's error. Returns `[state waiting\n  1213\t   woken]`.\"\n  1214\t  [state entry]\n  1215\t  (let [reader (get (:resources state) module/link-response-resource)]\n  1216\t    (loop [state state\n  1217\t           cursor (:cursor entry)]\n  1218\t      (let [r (stream/next reader cursor)\n  1219\t            o (outcome r)]\n  1220\t        (case o\n  1221\t          :dao.stream/ok\n  1222\t          (let [v (:dao.stream/value r)\n  1223\t                id (when (map? v) (:yin.link/id v))\n  1224\t                entry (assoc entry :cursor (:dao.stream/cursor r))]\n  1225\t            (if (= id (:link-id entry))\n  1226\t              (settle state entry v)\n  1227\t              (recur (skip state entry id) (:cursor entry))))\n  1228\t          :dao.stream/blocked [state (assoc entry :cursor cursor) nil]\n  1229\t          [(retire state (:link-id entry) :restored)\n  1230\t           nil\n  1231\t           (refused-entry entry\n  1232\t                          {:status :refused,\n  1233\t                           :reason :link-stream,\n  1234\t                           :outcome o,\n  1235\t                           :link-id (:link-id entry)})])))))\n  1236\t\n  1237\t\n  1238\t(defn- poll-link-entry\n  1239\t  \"One poll of a link wait entry: a `:link-request` retries its retained\n  1240\t   envelope and, appended, polls on as a `:link-response`; an `:install`\n  1241\t   waits for its install. Returns `[state waiting woken]`.\"\n  1242\t  [state entry]\n  1243\t  (case (:reason entry)\n  1244\t    :link-request\n  1245\t    (let [entry' (module/append-link-request (:resources state) entry)]\n  1246\t      (if (= :link-response (:reason entry'))\n  1247\t        (poll-link-response state entry')\n  1248\t        [state entry' nil]))\n  1249\t    :link-response (poll-link-response state entry)\n  1250\t    :install [state entry nil]))\n  1251\t\n  1252\t\n  1253\t(defn- poll-links\n  1254\t  \"Poll every link wait entry once, in wait-set order, and then step the\n  1255\t   install children. Returns the state with the still-waiting link\n  1256\t   entries appended to `others` and the woken ones queued.\"\n  1257\t  [state links others]\n  1258\t  (let [[state waiting woken]\n  1259\t        (reduce (fn [[state waiting woken] entry]\n  1260\t                  (let [[state w k] (poll-link-entry state entry)]\n  1261\t                    [state\n  1262\t                     (cond-> waiting w (conj w))\n  1263\t                     (cond-> woken k (conj k))]))\n  1264\t                [state [] []]\n  1265\t                links)]\n  1266\t    (-> state\n  1267\t        (assoc :wait-set (into (vec others) waiting))\n  1268\t        (update :ready-queue (fnil into []) woken)\n  1269\t        advance-installs)))\n  1270\t\n  1271\t\n  1272\t(defn abandon-link\n  1273\t  \"A composition gives up on link `link-id` (section 7.2, step 7): the\n  1274\t   entry leaves the wait set and is restored with `reason` raised as the\n  1275\t   effect's error; the id is retired, so a response arriving later is\n  1930\t   Options:\n  1931\t     :primitives   primitive operations map (defaults to `primitives`)\n  1932\t     :primitive-profiles published profile registry (defaults to `primitive-profiles`)\n  1933\t     :primitive-canonical-names name -> canonical name for intentional aliases\n  1934\t     :modules      module registry value (see `yin.vm.module`)\n  1935\t     :make-stream  (fn [capacity] -> create outcome); no default\n  1936\t     :call-in      explicit inbound request handle\n  1937\t     :call-out     explicit outbound response handle\n  1938\t     :call-capacity capacity for a constructed FFI pair\n  1939\t     :vm-model     telemetry model keyword\n  1940\t     :telemetry    telemetry config {:stream <dao.stream writer> :vm-id <id>};\n  1941\t                   validated by telemetry/install, which both create-vms call\n  1942\t                   after this\n  1943\t     :link-request  the link request writer (yin.vm.linker.md section 6.1)\n  1944\t     :link-response the link response reader; with the writer, the link\n  1945\t                    pair `require` lowers to. Both are held in the private\n  1946\t                    `:resources` table no store instruction reads.\n  1947\t     :origin       this task's origin tag for link ids (default `:t0`)\n  1948\t     :ancestry     the modules being installed on this task's install\n  1949\t                   chain (section 7.4), empty for a root task\n  1950\t     :capability-secret this task's capability secret (yin.vm.linker.md\n  1951\t                   section 7.3, r10), minted by the composition from its\n  1952\t                   own random source. Every resource reference the engine\n  1953\t                   issues is sealed under it; a task composed without one\n  1954\t                   issues none, and every stream effect over a supplied\n  1955\t                   reference fails closed.\n  1956\t     :secret-source (fn [origin] -> secret): the composition's minting of\n  1957\t                   an install child's secret; without it a child has none\n  1958\t     :attach-stream (fn [descriptor] -> attach outcome): how a lowered\n  1959\t                   stream reference (r9) attaches to its stream\n  1960\t\n  1961\t   The FFI pair comes from explicitly supplied `:call-in`/`:call-out` first --\n  1962\t   matching v1's precedence, so a composition handing over streams directly is\n  1963\t   never silently overridden -- else from `:make-stream`, else the VM holds\n  1964\t   no pair at all. The pair lives in the private `:resources` table, never in\n  1965\t   the store (r8). A VM with no pair is coherent: it still operates streams\n  1966\t   the composition handed it. What it cannot do is make a\n  1967\t   `:dao.stream.apply/call`.\n  1968\t\n  1969\t   A registry binding a reserved name (Rule R) is refused.\n  1970\t\n  1971\t   This state holds no program-observation fields. The program stream handle,\n  1972\t   cursor, and gap count belong to `dao.stream.observer`, which a host\n  1973\t   composes beside the VM rather than inside it.\"\n  1974\t  ([] (empty-state {}))\n  1975\t  ([opts]\n  1976\t   (let [installed-primitives (check-bindings! :primitive\n  1977\t                                               (or (:primitives opts)\n  1978\t                                                   primitives))\n  1979\t         _ (check-bindings! :primitive (:primitive-profiles opts))\n  1980\t         _ (when-let [n (registry-reserved-name (:modules opts))]\n   197\t  [state op args k env]\n   198\t  (let [{:keys [call-in]} (ffi/require-call-pair! (:resources state) op)\n   199\t        response-cont {:type :dao.stream.apply/eval-call, :next k, :env env}\n   200\t        parked (engine/park-continuation state {:k response-cont, :env env})\n   201\t        parked-id (get-in parked [:value :id])\n   202\t        request (apply2/request parked-id op (vec args))\n   203\t        result (apply2/put-request! call-in request)]\n   204\t    (case (:dao.stream/outcome result)\n   205\t      :dao.stream/ok\n   206\t      (-> parked\n   207\t          (update :wait-set\n   208\t                  (fnil conj [])\n   209\t                  (ffi/call-response-wait-entry parked-id k env))\n   210\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   211\t          (assoc :control nil\n   212\t                 :k nil\n   213\t                 :value :yin/blocked\n   214\t                 :blocked? true\n   215\t                 :halted? false))\n   216\t      :dao.stream/full\n   217\t      (-> parked\n   218\t          (update :wait-set\n   219\t                  (fnil conj [])\n   220\t                  {:k {:type :dao.stream.apply/request-sent,\n   221\t                       :parked-id parked-id,\n   222\t                       :next k,\n   223\t                       :env env,\n   224\t                       :op op},\n   225\t                   :env env,\n   226\t                   :reason :put,\n   227\t                   :stream-id vm/call-in-stream-key,\n   228\t                   :datom request})\n   229\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   230\t          (assoc :control nil\n   231\t                 :k nil\n   232\t                 :value :yin/blocked\n   233\t                 :blocked? true\n   234\t                 :halted? false))\n   235\t      (throw (ex-info \"FFI request could not be appended\"\n   335\t                     :k nil\n   336\t                     :value :yin/blocked\n   337\t                     :blocked? true\n   338\t                     :halted? false))\n   339\t          :dao.stream.apply/eval-call\n   340\t          ;; The response consumed here completes the call that\n   341\t          ;; `park-and-call` recorded, so its continuation leaves `:parked`\n   342\t          ;; rather than accumulating for the lifetime of the VM.\n   343\t          (let [state (update state :parked dissoc (:call-id k))]\n   344\t            (cesk-return state\n   345\t                         nil\n   346\t                         env\n   347\t                         (:next k)\n   348\t                         (ffi/call-result (:value state) (:call-id k))))\n   349\t          :eval-stream-put-target (let [frame (:frame k)\n   350\t                                        stream-ref (:value state)\nsrc/cljc/yin/vm/ast_walker.cljc:209:                  (ffi/call-response-wait-entry parked-id k env))\nsrc/cljc/yin/vm/ast_walker.cljc:330:                      (ffi/call-response-wait-entry (:parked-id k)\nsrc/cljc/yin/vm/ast_walker.cljc:348:                         (ffi/call-result (:value state) (:call-id k))))\nsrc/cljc/yin/vm/debruijn_register_code.cljc:47:;; R0 (test/yin/vm/debruijn_register_contract_test.cljc) freezes its own\nsrc/cljc/yin/vm/ffi/remote_serve/responder.cljc:34:     `yin.vm.ffi/call-result` instead of parking forever.\nsrc/cljc/yin/vm/ffi.cljc:53:(defn call-response-wait-entry\nsrc/cljc/yin/vm/ffi.cljc:76:   know this layout. `call-response-wait-entry` (the walker's frame-typed\nsrc/cljc/yin/vm/semantic.cljc:109:   fields, in the shape `ffi/call-response-wait-entry` gives the walker.\"\nsrc/cljc/yin/vm/semantic.cljc:144:     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\nsrc/cljc/yin/vm/semantic.cljc:170:           val (if call-id (ffi/call-result val call-id) val)]\nsrc/cljc/yin/vm/debruijn/register.cljc:379:          val (if call-id (ffi/call-result val call-id) val)\nsrc/cljc/yin/vm/debruijn/stack.cljc:382:     envelope, so `ffi/call-result` unwraps it and checks correlation, and\nsrc/cljc/yin/vm/debruijn/stack.cljc:404:          val (if call-id (ffi/call-result val call-id) val)]\n","exit_code":0,"status":"completed"}}
