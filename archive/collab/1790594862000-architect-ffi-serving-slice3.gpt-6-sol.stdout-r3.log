 554\t(defn- encode-primitive\n   555\t  \"A host function as UCF 7.5.2's primitive marker: its one name in\n   556\t   `vm`'s primitives, with that name's profile address.\"\n   557\t  [vm f]\n   558\t  (let [n (vm/name-of (:primitives vm)\n   559\t                      (or (:primitive-canonical-names vm) {})\n   560\t                      f)\n   561\t        profile (when (symbol? n) (vm/profile-of (:primitives vm) n))]\n   562\t    (cond\n   563\t      (nil? n) (non-portable! :unnamed-function {})\n   564\t      (not (symbol? n)) (non-portable! :ambiguous-primitive {})\n   565\t      (= :host (:yin.k/class profile))\n   566\t      (non-portable! :host-state-primitive {:yin.k/name n})\n   567\t      :else {:yin.k/tag :yin.k/primitive,\n   568\t             :yin.k/name n,\n   569\t             :yin.k/profile (:yin.k/profile profile)})))\n   570\t\n   571\t\n   572\t(defn- stream-marker\n   573\t  \"UCF 7.5.1's stream marker for the stream resource `id` of `vm`: the\n   574\t   handle's descriptor and logical identity, never the handle. A handle\n   575\t   with no descriptor surface cannot be attached elsewhere and refuses as\n   576\t   `:in-memory-handle`.\"\n   577\t  [vm id]\n   578\t  (let [handle (get (:resources vm) id)\n   579\t        d (when (stream/descriptor? handle) (stream/descriptor handle))]\n   580\t    (if (= :dao.stream/ok (outcome d))\n   581\t      {:yin.k/tag :yin.k/stream,\n   582\t       :dao.stream/identity (:dao.stream/identity d),\n   583\t       :dao.stream/descriptor (:dao.stream/descriptor d)}\n   584\t      (non-portable! :in-memory-handle {:yin.k/hint id}))))\n   585\t\n   586\t\n   587\t(defn- cell-for!\n   588\t  \"The logical cursor cell (UCF 7.5.3) the cursor resource `id` of `vm`\n   589\t   lifts to, minted once per lift: two references to one cell share it.\"\n   590\t  [vm found id]\n   591\t  (or (get-in @found [:cell-of id])\n   592\t      (let [cid (keyword \"yin.k\" (str \"c-\" (count (:cells @found))))\n   593\t            cell (get (:resources vm) id)\n   594\t            lifted {:yin.k/stream (stream-marker vm (:stream-id cell)),\n   595\t                    :yin.k/position (:cursor cell)}]\n   596\t        (swap! found #(-> %\n   597\t                          (assoc-in [:cell-of id] cid)\n   598\t                          (assoc-in [:cells cid] lifted)))\n   599\t        cid)))\n   600\t\n   601\t\n   602\t(defn- encoder\n   603\t  \"UCF 7.5.1's `encode` over values of `vm`, recording into `found` every\n   604\t   closure origin segment, module store, and cursor cell the encoding\n   605\t   reaches. A closure lifts through the kernel and names the module store\n   606\t   its body resolves against: its own `:store-of`, or `own` when it has\n   607\t   none -- a closure the child's own body made. Every literal map is\n   608\t   wrapped, so a program's data can never forge a marker. A stream or\n   609\t   cursor reference is authenticated before it is encoded (r11): its seal\n   610\t   and resource kind must verify under the emitter's own secret, or it\n   611\t   refuses as `:forged-resource-reference`; only then is it encoded,\n   612\t   without its seal, as a stream marker or a cell reference. A\n   613\t   continuation, a host object, and an unnamed host function refuse as\n   614\t   UCF 7.5.4 kinds.\"\n   615\t  [vm own found]\n   616\t  (letfn [(encode\n   617\t            [x]\n   618\t            (cond\n   619\t              (scalar? x) x\n   620\t              (map? x)\n   621\t              (case (:type x)\n   622\t                :closure\n   623\t                (let [marker (module/lift-closure vm x encode)\n   624\t                      m (or (get marker store-of-key) own)]\n   625\t                  (swap! found (fn [acc]\n   626\t                                 (-> acc\n   627\t                                     (update :origins conj\n   628\t                                             (:yin.k/segment marker))\n   629\t                                     (update :stores conj m))))\n   630\t                  (assoc marker store-of-key m))\n   631\t                (:stream-ref :cursor-ref)\n   632\t                (cond\n   633\t                  (not (authentic-ref? vm (:type x) x))\n   634\t                  (non-portable! :forged-resource-reference\n   635\t                                 {:yin.k/hint (:type x)})\n   636\t                  (= :stream-ref (:type x)) (stream-marker vm (:id x))\n   637\t                  :else {:yin.k/tag :yin.k/cursor-ref,\n   638\t                         :yin.k/cell (cell-for! vm found (:id x))})\n   639\t                (:reified-continuation :parked-continuation)\n   640\t                (non-portable! :non-canonicalizable {:yin.k/hint (:type x)})\n   641\t                {:yin.k/tag :yin.k/literal,\n   642\t                 :yin.k/entries (into []\n   643\t                                      (mapcat (fn [[k v]]\n   644\t                                                [(encode k) (encode v)]))\n   645\t                                      x)})\n   646\t              (vector? x) (mapv encode x)\n   647\t              (set? x) (into #{} (map encode) x)\n   648\t              (seq? x) (apply list (map encode x))\n   649\t              (fn? x) (encode-primitive vm x)\n   650\t              :else (non-portable! :host-object\n   850\t\n   851\t(def ^:private link-reasons\n   852\t  \"The wait reasons `require` adds: the two link states and the install.\"\n   853\t  #{:link-request :link-response :install})\n   854\t\n   855\t\n   856\t(defn- link-entry?\n   857\t  [entry]\n   858\t  (contains? link-reasons (:reason entry)))\n   859\t\n   860\t\n   861\t(defn- ready\n   862\t  \"A woken ready entry: the registers, resumed with `value`.\"\n   863\t  [entry value]\n   864\t  (-> entry\n   865\t      (dissoc :envelope :request :response :cursor)\n   866\t      (assoc :value value)))\n   867\t\n   868\t\n   869\t(defn- refused-entry\n   870\t  \"A woken ready entry that raises `refusal` as the effect's error at its\n   871\t   resume, the way an FFI `error` raises.\"\n   872\t  [entry refusal]\n   873\t  (assoc (ready entry nil) :status :link-refused :refusal refusal))\n   874\t\n   875\t\n   876\t(defn- retire\n   877\t  \"Record link `id` as retired: a response for it is afterwards a\n   878\t   duplicate (`:restored`) or late (`:abandoned`).\"\n   879\t  [state id how]\n   880\t  (assoc-in state [:link-retired id] how))\n   881\t\n   882\t\n   883\t(defn- skip\n   884\t  \"Record one skipped response (section 7.2, step 7): a telemetry\n   885\t   diagnostic, and one entry under `:link-diagnostics`. A response another\n   886\t   live entry of this task awaits is not a skip kind and is passed over\n   887\t   silently.\"\n   888\t  [state entry id]\n   889\t  (let [retired (get-in state [:link-retired id])\n   890\t        kind (cond (= :restored retired) :duplicate\n   891\t                   (= :abandoned retired) :late\n   892\t                   (some #(= id (:link-id %)) (:wait-set state)) nil\n   893\t                   :else :unknown)]\n   894\t    (if (nil? kind)\n   895\t      state\n   896\t      (let [d {:kind kind, :id id, :entry (:link-id entry)}]\n   897\t        (-> state\n   898\t            (update :link-diagnostics (fnil conj []) d)\n   899\t            (telemetry/emit-snapshot :link-skip d))))))\n   900\t\n   901\t\n   902\t(defn take-link-diagnostics\n   903\t  \"Every skip diagnostic recorded since the last take, and the state\n   904\t   without them: each is handed out exactly once.\"\n   905\t  [state]\n   906\t  [(vec (:link-diagnostics state)) (dissoc state :link-diagnostics)])\n   907\t\n   908\t\n   909\t(defn- obligation-name\n   910\t  [obligation]\n   911\t  (if (map? obligation) (:name obligation) obligation))\n   912\t\n   913\t\n   914\t(defn- discharge-defect\n   915\t  \"Step 5b against the live state of the receiving task (section 7.2,\n   916\t   step 7): `yin.vm.linker/discharge` over the response's obligations,\n   917\t   then profile equality for every obligation the manifest names under\n   918\t   `:yin.module/primitives` -- a same-named primitive of a different\n   919\t   profile is `:unresolved-free`. A namespaced obligation of a module the\n   920\t   manifest requires is the install's to satisfy: the child requires it,\n   921\t   and the receiving task receives it at `linked`.\"\n   922\t  [state response]\n   923\t  (let [manifest (:manifest response)\n   924\t        requires (set (keys (:yin.module/requires manifest)))\n   925\t        deferred? (fn [o]\n   926\t                    (let [n (obligation-name o)]\n   927\t                      (and (symbol? n)\n   928\t                           (some? (namespace n))\n   929\t                           (contains? requires (symbol (namespace n))))))\n   930\t        obligations (remove deferred? (:obligations response))\n   931\t        receiver {:free-env (or (:free-env state) {}),\n   932\t                  :store (:store state),\n   933\t                  :primitives (:primitives state),\n   934\t                  :modules (:modules state)}]\n   935\t    (or (linker/discharge receiver obligations)\n   936\t        (some (fn [o]\n   937\t                (let [n (obligation-name o)\n   938\t                      expected (get-in manifest [:yin.module/primitives n])\n   939\t                      actual (:yin.k/profile\n   940\t                               (or (vm/profile-of (:primitives state) n)\n   941\t                                   (get (:primitive-profiles state) n)))]\n   942\t                  (when (and (some? expected) (not= expected actual))\n   943\t                    (linker/refused :unresolved-free\n   944\t                                    {:name n,\n   945\t                                     :expected expected,\n   946\t                                     :actual actual}))))\n   947\t              obligations))))\n   948\t\n   949\t\n   950\t(defn- error-refusal\n   951\t  \"The refusal an install raises for a thrown error: the error's own\n   952\t   `:reason` when it carries one (`:require-cycle`), its non-portable\n   953\t   status when a lift refused, and `:install-error` otherwise.\"\n   954\t  [module-name e]\n   955\t  (let [d (or (ex-data e) {})]\n   956\t    (merge d\n   957\t           {:status :refused,\n   958\t            :reason (or (:reason d)\n   959\t                        (when (= :yin.k/non-portable (:yin.k/status d))\n   960\t                          :yin.k/non-portable)\n   961\t                        :install-error),\n   962\t            :module module-name,\n   963\t            :message (ex-message e)})))\n   964\t\n   965\t\n   966\t(defn- linked-entries\n   967\t  \"The `[name entry]` pairs of a registry that were linked, not\n   968\t   host-registered: they carry a manifest address.\"\n   969\t  [registry]\n   970\t  (filterv (fn [[_ entry]] (some? (:address entry)))\n   971\t           (module/module-entries registry)))\n   972\t\n   973\t\n   974\t(defn- manifest-address\n   975\t  \"The manifest's address: a manifest is content named by its address.\"\n   976\t  [response]\n   977\t  (jing/segment-key (:manifest response)))\n   978\t\n   979\t\n   980\t(defn- spawn-child\n   125\t  [entry]\n   126\t  (when (and (contains? entry :response-cursor)\n   127\t             (contains? entry :response-stream))\n   128\t    [(:response-cursor entry) (:response-stream entry)]))\n   129\t\n   130\t\n   131\t(defn semantic-restore\n   132\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   133\t\n   134\t   Two entry shapes carry more than registers:\n   135\t\n   136\t   - A `:request-sent` entry is a writer whose retained FFI request has now\n   137\t     been appended. The call starts waiting for its correlated response,\n   138\t     exactly as an immediately-sent one does, so the entry is replaced by its\n   139\t     response reader and the machine stays blocked. A writer carrying a\n   140\t     lowered call's response route (`:response-cursor`, `:response-stream`)\n   141\t     waits on that carried route; an ordinary one waits on the fixed local\n   142\t     call-out keys.\n   143\t   - A `:call-id` entry is a response reader. The woken value is a response\n   144\t     envelope, so `ffi/call-result` unwraps it, checks correlation, and the\n   145\t     parked call leaves `:parked` rather than accumulating.\"\n   146\t  ([base entry] (semantic-restore base entry (:value entry)))\n   147\t  ([base entry val]\n   148\t   (if (:request-sent entry)\n   149\t     (let [wait (response-wait-entry (:segment entry)\n   150\t                                     (:pc entry)\n   151\t                                     (:env entry)\n   152\t                                     (:stack entry)\n   153\t                                     (:k entry)\n   154\t                                     (:call-id entry))\n   155\t           wait (if-let [[cursor-key stream-key]\n   156\t                         (carried-response-route entry)]\n   157\t                  (assoc wait\n   158\t                         :cursor-ref {:type :cursor-ref, :id cursor-key}\n   159\t                         :stream-id stream-key)\n   160\t                  wait)]\n   161\t       (assoc base\n   162\t              :wait-set (conj (vec (or (:wait-set base) [])) wait)\n   163\t              :control nil\n   164\t              :k nil\n   165\t              :value :yin/blocked\n   166\t              :blocked? true\n   167\t              :halted? false))\n   168\t     (let [call-id (:call-id entry)\n   169\t           base (if call-id (update base :parked dissoc call-id) base)\n   170\t           val (if call-id (ffi/call-result val call-id) val)]\n   171\t       (put-registers base\n   172\t                      (:segment entry)\n   173\t                      (:pc entry)\n   174\t                      val\n   175\t                      (:stack entry)\n   176\t                      (:env entry)\n   177\t                      (:k entry))))))\n   178\t\n   179\t\n   180\t(defn- call-park-entries\n   205\t      :dao.stream/ok\n   206\t      (-> parked\n   207\t          (update :wait-set\n   208\t                  (fnil conj [])\n   209\t                  (ffi/call-response-wait-entry parked-id k env))\n   210\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   211\t          (assoc :control nil\n   212\t                 :k nil\n   213\t                 :value :yin/blocked\n   214\t                 :blocked? true\n   215\t                 :halted? false))\n   216\t      :dao.stream/full\n   217\t      (-> parked\n   218\t          (update :wait-set\n   219\t                  (fnil conj [])\n   220\t                  {:k {:type :dao.stream.apply/request-sent,\n   221\t                       :parked-id parked-id,\n   222\t                       :next k,\n   223\t                       :env env,\n   224\t                       :op op},\n   225\t                   :env env,\n   226\t                   :reason :put,\n   227\t                   :stream-id vm/call-in-stream-key,\n   228\t                   :datom request})\n   229\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   230\t          (assoc :control nil\n   231\t                 :k nil\n   232\t                 :value :yin/blocked\n   233\t                 :blocked? true\n   234\t                 :halted? false))\n   235\t      (throw (ex-info \"FFI request could not be appended\"\n   305\t                branch (if test-value (:consequent frame) (:alternate frame))]\n   306\t            (cesk-return state branch saved-env (:next k) test-value))\n   307\t          :dao.stream.apply/eval-operand\n   308\t          (let [frame (:frame k)\n   309\t                operand-value (:value state)\n   310\t                evaluated (conj (or (:evaluated frame) []) operand-value)\n   311\t                operands (:operands frame)\n   312\t                saved-env (or (:env k) env)]\n   313\t            (if (= (count evaluated) (count operands))\n   314\t              (park-and-call state (:op frame) evaluated (:next k) saved-env)\n   315\t              (let [next-idx (count evaluated)\n   316\t                    next-node (nth operands next-idx)\n   317\t                    updated-frame (assoc frame :evaluated evaluated)]\n   318\t                (cesk-return state\n   319\t                             next-node\n   320\t                             saved-env\n   321\t                             (assoc k :frame updated-frame)\n   322\t                             nil))))\n   323\t          :dao.stream.apply/request-sent\n   324\t          ;; A request retained on `full` has now been appended by the polling\n   325\t          ;; wait set. The call starts waiting for its correlated response,\n   326\t          ;; exactly as an immediately-sent one does.\n   327\t          (-> state\n   328\t              (update :wait-set\n   329\t                      (fnil conj [])\n   330\t                      (ffi/call-response-wait-entry (:parked-id k)\n   331\t                                                    (:next k)\n   332\t                                                    (:env k)))\n   333\t              (telemetry/emit-snapshot :bridge {:bridge-op (:op k)})\n   334\t              (assoc :control nil\n   335\t                     :k nil\n   336\t                     :value :yin/blocked\n   337\t                     :blocked? true\n   338\t                     :halted? false))\n   339\t          :dao.stream.apply/eval-call\n   340\t          ;; The response consumed here completes the call that\n   341\t          ;; `park-and-call` recorded, so its continuation leaves `:parked`\n   342\t          ;; rather than accumulating for the lifetime of the VM.\n   343\t          (let [state (update state :parked dissoc (:call-id k))]\n   344\t            (cesk-return state\n   345\t                         nil\n   346\t                         env\n   347\t                         (:next k)\n   348\t                         (ffi/call-result (:value state) (:call-id k))))\n   349\t          :eval-stream-put-target (let [frame (:frame k)\n   350\t                                        stream-ref (:value state)\n   351\t                                        val-node (:val frame)]\n   352\t                                    (cesk-return state\n   353\t                                                 val-node\n   354\t                                                 env\n   355\t                                                 (assoc k\n","exit_code":0,"status":"completed"}}
