tity a `:yin.k/cells` entry names, for a refusal\n   254\t   that names it even when the cell itself never lowered.\"\n   255\t  [cells cell-id]\n   256\t  (get-in cells [cell-id :yin.k/stream :dao.stream/identity]))\n   257\t\n   258\t\n   259\t;; =============================================================================\n   260\t;; Lift: one variant each\n   261\t;; =============================================================================\n   262\t\n   263\t(defn- lift-read\n   264\t  \"S7.4.3's blocked read: the cell `mint` gives for the entry's\n   265\t   cursor cell, at its kept position.\"\n   266\t  [resources mint codec entry]\n   267\t  (if-let [cell (cursor-cell resources entry)]\n   268\t    (if-let [cid (mint codec (:id cell)\n   269\t                       (get resources (:stream-id cell))\n   270\t                       (:cursor cell))]\n   271\t      {:pending {:yin.k/reason :next, :yin.k/cell cid}, :cell? true}\n   272\t      (unsatisfied (local-identity (get resources (:stream-id cell)))))\n   273\t    (unsatisfied)))\n   274\t\n   275\t\n   276\t(defn- lift-response-wait\n   277\t  \"S7.4.3's sent call: a `:next` entry carrying `:call-id`, the\n   278\t   response wait `semantic-restore` rebuilds -- the call's\n   279\t   correlation beside the response cell at its kept position, so\n   280\t   round-order on the cell is preserved on the resumer (S7.4.3).\n   281\t   The call's `:op` rides when the entry carries it (the engine's\n   282\t   own response wait does not; a caller assembling the frame takes\n   283\t   it from the call's parked record).\"\n   284\t  [resources mint codec entry]\n   285\t  (if-let [cell (cursor-cell resources entry)]\n   286\t    (if-let [cid (mint codec (:id cell)\n   287\t                       (get resources (:stream-id cell))\n   288\t                       (:cursor cell))]\n   289\t      {:pending (cond-> {:yin.k/reason :ffi,\n   290\t                         :yin.k/call-id (:call-id entry),\n   291\t                         :yin.k/cell cid}\n   292\t                  (contains? entry :op) (assoc :yin.k/op (:op entry))),\n   293\t       :cell? true}\n   294\t      (unsatisfied (local-identity (get resources (:stream-id cell)))))\n   295\t    (unsatisfied)))\n   296\t\n   297\t\n   298\t(defn- lift-write\n   299\t  \"S7.4.3's blocked write: the target stream's marker and the\n   300\t   retained `:datom` -- the value a retry appends, without which the\n   301\t   wait is not re-establishable. A put names a stream, never a\n   302\t   cursor cell.\"\n   303\t  [serve! resources entry]\n   304\t  (let [h (get resources (:stream-id entry))]\n   305\t    (if-let [marker (lift-marker serve! h)]\n   306\t      {:pending {:yin.k/reason :put,\n   307\t                 :yin.k/stream marker,\n   308\t                 :yin.k/value (:datom entry)}}\n   309\t      (unsatisfied (local-identity h)))))\n   310\t\n   311\t\n   312\t(defn- call-out-cell\n   313\t  \"The emitter's call-out cursor cell -- the response route the\n   314\t   retained call had on the emitter: the cursor entry under\n   315\t   `vm/call-out-cursor-key`, reading the call-out stream under\n   316\t   `vm/call-out-stream-key` at its kept position. nil when the\n   317\t   composition holds no call pair, which no real retained request\n   318\t   does -- the pair is checked before the call parked.\"\n   319\t  [resources]\n   320\t  (let [cursor (get resources vm/call-out-cursor-key)\n   321\t        handle (get resources vm/call-out-stream-key)]\n   322\t    (when (and (map? cursor) (contains? cursor :stream-id) handle)\n   323\t      {:id vm/call-out-cursor-key,\n   324\t       :stream-id vm/call-out-stream-key,\n   325\t       :cursor (:cursor cursor)})))\n   326\t\n   327\t\n   328\t(defn- lift-retained-request\n   329\t  \"S7.4.3's retained call: a `:put` entry carrying `:request-sent`,\n   330\t   the request the engine holds unsent. Both endpoints are served --\n   331\t   the request stream's marker and the response stream's marker,\n   332\t   `call-out-cell`'s -- and the retained envelope rides VERBATIM\n   333\t   (`:yin.k/request-envelope`) beside the kept response cell\n   334\t   (`:yin.k/response-cell`), its op and args carried only as\n   335\t   derived views (`:request-op`, `:request-args`; the op is the\n   336\t   source of the lowered entry's `:op`), so a resumer re-establishes\n   337\t   the carried pair exactly as the sender held it: retry through the\n   338\t   request reflection, wait for the response through the response\n   339\t   reflection at the kept position. The envelope is the whole truth:\n   340\t   the request protocol is open to keys beyond op and args\n   341\t   (`dao.stream.apply`'s `request?`), so the lower must never\n   342\t   rebuild it from the views. Either endpoint unservable refuses as\n   343\t   `:yin.k/unsatisfied` naming that endpoint's identity, before any\n   344\t   value is minted.\"\n   345\t  [serve! resources mint codec entry]\n   346\t  (let [h (get resources (:stream-id entry))\n   347\t        envelope (:datom entry)\n   348\t        route (call-out-cell resources)\n   349\t        resp-h (and route (get resources (:stream-id route)))]\n   350\t    (if-let [marker (lift-marker serve! h)]\n   351\t      (if-let [resp-marker (and resp-h (lift-marker serve! resp-h))]\n   352\t        (if-let [cid (mint codec (:id route) resp-h (:cursor route))]\n   353\t          {:pending {:yin.k/reason :ffi-request,\n   354\t                     :yin.k/call-id (:call-id entry),\n   355\t                     :yin.k/request-envelope envelope,\n   356\t                     :yin.k/request-op (or (apply2/request-op envelope)\n   357\t                                           (:op entry)),\n   358\t                     :yin.k/request-args (apply2/request-args envelope),\n   359\t                     :yin.k/request marker,\n   360\t                     :yin.k/response resp-marker,\n   361\t                     :yin.k/response-cell cid},\n   362\t           :cell? true}\n   363\t          (unsatisfied (local-identity resp-h)))\n   364\t        (unsatisfied (local-identity resp-h)))\n   365\t      (unsatisfied (local-identity h)))))\n   366\t\n   367\t\n   368\t(defn- lift-link\n   369\t  \"S7.4.3's link variants: the link pair name the engine's own fixed\n   370\t   link keys on a real entry (`module/link-request-resource` and\n   371\t   `module/link-response-resource`), resolved into `:resources`, and\n   372\t   the kept `:cursor` on the response stream\n   373\t   (`module/require-handler` mints it before the envelope is appended)\n   374\t   is the response cell -- a cell like any other, at its kept\n   375\t   position. Both pair markers travel, the engine's `:link-response`\n   376\t   entry retaining its `:request` beside the response side; the\n   377\t   envelope rides verbatim on the request-in-hand variant.\"\n   378\t  [serve! resources mint codec entry]\n   379\t  (let [reason (:reason entry)\n   380\t        resp-h (get resources (:response entry))\n   550\t               [(cell-keys cid)\n   551\t                {:stream-id (streams (cell-identity cells cid)),\n   552\t                 :cursor (:yin.k/position cell)}]))\n   553\t        cells))\n   554\t\n   555\t\n   556\t(defn- link-pair-resources\n   557\t  \"The engine's fixed link keys (`module/link-request-resource`,\n   558\t   `module/link-response-resource`) mapped onto the reflections a\n   559\t   lowered link wait uses: the engine's sweep retries a\n   560\t   `:link-request` by appending at the fixed request key\n   561\t   (`module/append-link-request`) and polls a `:link-response` at the\n   562\t   fixed response key (`poll-link-response`), so a lowered link wait\n   563\t   parks where the engine looks. One pair per task: the identity of\n   564\t   each side rides the pending's own markers.\"\n   565\t  [streams resources pendings]\n   566\t  (reduce (fn [acc pending]\n   567\t            (if (contains? #{:link-request :link-response}\n   568\t                           (:yin.k/reason pending))\n   569\t              (let [req-id (get-in pending [:yin.k/request\n   570\t                                            :dao.stream/identity])\n   571\t                    resp-id (get-in pending [:yin.k/response\n   572\t                                             :dao.stream/identity])\n   573\t                    req (get resources (streams req-id))\n   574\t                    resp (get resources (streams resp-id))]\n   575\t                (if (and req resp)\n   576\t                  (assoc acc\n   577\t                         module/link-request-resource req,\n   578\t                         module/link-response-resource resp)\n   579\t                  acc))\n   580\t              acc))\n   581\t          {}\n   582\t          pendings))\n   583\t\n   584\t\n   585\t(defn- lower-one\n   586\t  \"One pending of S7.4.3, lowered: `{:entry e}` -- the wait-set\n   587\t   entry the receiver parks, the caller's register context `ctx`\n   588\t   merged verbatim under the stream and cell fields the data\n   589\t   rebuilds -- or an outcome carrying `:yin.k/status`, naming the\n   590\t   stream identity where one is known. Every wait polls the key\n   591\t   `cell-keys` allocated for its cell, reading the stream key\n   592\t   `streams` allocated for the cell's reflection: migrated waits\n   593\t   poll routes no new call shares. A retained request's retry\n   594\t   writes through the request reflection's allocated key and stamps\n   595\t   the carried response route (`:response-cursor`,\n   596\t   `:response-stream`) for its restore; its `:datom` is the carried\n   597\t   envelope itself, never a rebuild from the op/args views (the\n   598\t   request protocol is open to further keys) -- a `:ffi-request`\n   599\t   pend without `:yin.k/request-envelope` is malformed and refuses\n   600\t   as `:yin.k/unsatisfied` naming the request identity.\"\n   601\t  [pending ctx streams cells cell-keys]\n   602\t  (case (:yin.k/reason pending)\n   603\t    :next\n   604\t    (let [cid (:yin.k/cell pending)]\n   605\t      (if-let [sid (streams (cell-identity cells cid))]\n   606\t        {:entry (merge ctx\n   607\t                       {:reason :next,\n   608\t                        :stream-id sid,\n   609\t                        :cursor-ref {:type :cursor-ref,\n   610\t                                     :id (cell-keys cid)}})}\n   611\t        (unsatisfied (cell-identity cells cid))))\n   612\t\n   613\t    :put\n   614\t    (if-let [sid (streams (get-in pending [:yin.k/stream\n   615\t                                           :dao.stream/identity]))]\n   616\t      {:entry (merge ctx\n   617\t                     {:reason :put,\n   618\t                      :stream-id sid,\n   619\t                      :datom (:yin.k/value pending)})}\n   620\t      (unsatisfied (get-in pending [:yin.k/stream :dao.stream/identity])))\n   621\t\n   622\t    :ffi\n   623\t    (let [cid (:yin.k/cell pending)]\n   624\t      (if-let [sid (streams (cell-identity cells cid))]\n   625\t        {:entry (merge ctx\n   626\t                       (cond-> {:reason :next,\n   627\t                                :call-id (:yin.k/call-id pending),\n   628\t                                :stream-id sid,\n   629\t                                :cursor-ref {:type :cursor-ref,\n   630\t                                             :id (cell-keys cid)}}\n   631\t                         (contains? pending :yin.k/op)\n   632\t                         (assoc :op (:yin.k/op pending))))}\n   633\t        (unsatisfied (cell-identity cells cid))))\n   634\t\n   635\t    :ffi-request\n   636\t    (let [req-id (get-in pending [:yin.k/request\n   637\t                                  :dao.stream/identity])\n   638\t          resp-id (get-in pending [:yin.k/response\n   639\t                                   :dao.stream/identity])\n   640\t          envelope (:yin.k/request-envelope pending)]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/waitset.cljc | sed -n '1,245p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '185,210p'; nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '635,665p'; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '335,380p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/waitset.cljc | sed -n '1,245p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '185,210p'; nl -ba src/cljc/yin/vm/ucf/remote.cljc | sed -n '635,665p'; nl -ba src/cljc/yin/vm/engine.cljc | sed -n '335,380p'\"","aggregated_output":"     1\t(ns dao.stream.waitset\n     2\t  \"The multiplexed wait-set for DaoStream: one complete ordered sweep over\n     3\t  every parked waiter, as a host-agnostic library.\n     4\t\n     5\t  The waitset is a value, `{:waiting []}`, and it holds only what waits.\n     6\t  `check` takes it beside a host-composed resolver and the host's store,\n     7\t  performs one synchronous interpreter step — polling live media, appending\n     8\t  for a parked writer — and returns the successor waitset beside that\n     9\t  call's results. The sweep has explicit stream effects, so it is never\n    10\t  described as pure; what is immutable is the threading of the store and\n    11\t  the waitset.\n    12\t\n    13\t  Entries are the host's data. The library interprets only `:reason` —\n    14\t  `:next` reads, `:put` appends — and every other field is opaque, stored\n    15\t  and returned exactly as the host gave it. A resolver maps each whole\n    16\t  entry to a live handle and the cursor to read from or the value to\n    17\t  append, and moves a reader's cursor in the store; both functions run\n    18\t  immediately inside `check` and are never retained, and the library never\n    19\t  adds a resolved handle or polling cursor to any entry.\n    20\t\n    21\t  Woken entries are returned, never dispatched: no callbacks, no queues,\n    22\t  no disposition functions. This namespace multiplexes readiness; it does\n    23\t  not schedule work — the host loop owns everything between calls.\"\n    24\t  (:require [dao.stream :as stream]))\n    25\t\n    26\t\n    27\t(def ^:private wait-reasons\n    28\t  \"The reasons the library interprets. Only two outcomes can change on\n    29\t   their own: `blocked` for a reader, `full` for a writer.\"\n    30\t  #{:next :put})\n    31\t\n    32\t\n    33\t(defn empty-waitset\n    34\t  \"The waitset that parks nothing. This value is the whole threaded state.\"\n    35\t  []\n    36\t  {:waiting []})\n    37\t\n    38\t\n    39\t(defn park\n    40\t  \"Append `entry` to `waitset`'s `:waiting` and return the successor\n    41\t   waitset. Total: it rejects nothing, because `check` classifies\n    42\t   everything — a malformed entry is woken by the sweep as a diagnostic,\n    43\t   never a park-time error. Total over the waitset it is handed too: a\n    44\t   missing or nil `:waiting` parks onto a fresh vector, so park order —\n    45\t   wake order among co-waiters — is preserved whatever the host threaded.\"\n    46\t  [waitset entry]\n    47\t  (update waitset :waiting (fnil conj []) entry))\n    48\t\n    49\t\n    50\t(defn- woken-result\n    51\t  \"The result map for one woken entry: the stored entry verbatim beside\n    52\t   the status its poll resolved with. `cursor` is present only when the\n    53\t   poll produced one — a reader's successor or a gap's recovery position;\n    54\t   a writer resolves with no cursor.\"\n    55\t  [entry status value cursor]\n    56\t  (cond-> {:entry entry :status status :value value}\n    57\t    cursor (assoc :cursor cursor)))\n    58\t\n    59\t\n    60\t(defn- diagnostic-result\n    61\t  \"The result map for an entry the library cannot poll at all: the stored\n    62\t   entry verbatim and its qualified status. No stream operation was\n    63\t   performed, so there is no value.\"\n    64\t  [entry status]\n    65\t  {:entry entry :status status})\n    66\t\n    67\t\n    68\t(defn- answer-defect\n    69\t  \"Why `answer` cannot be interpreted as an outcome of `op`, or nil when it\n    70\t   can, using the contract's own validation. `:invalid` marks an answer\n    71\t   that is not an outcome map the contract can vouch for — a non-map, a\n    72\t   missing or unqualified `:dao.stream/outcome`, or a declared outcome\n    73\t   missing its required keys — which folds into the waitset's own\n    74\t   diagnostic. `:unauthorized` marks a well-formed outcome outside the\n    75\t   operation's declared set, which stays terminal under its own keyword\n    76\t   (the plan's rule for undeclared outcomes) and is distinguished here so\n    77\t   it does not collide with the fold.\"\n    78\t  [op answer]\n    79\t  (let [defect (stream/validate-outcome op answer)]\n    80\t    (cond\n    81\t      (nil? defect) nil\n    82\t      (= :unauthorized-outcome (:error defect)) :unauthorized\n    83\t      :else :invalid)))\n    84\t\n    85\t\n    86\t(defn- poll-next\n    87\t  \"Poll one resolved `:next` entry with a synchronous read. Returns nil\n    88\t   while the entry must keep waiting — `blocked` is the only reader\n    89\t   outcome that can change on its own — and otherwise the woken result\n    90\t   plus `:advance-cursor`, the position the store must move to before\n    91\t   later entries resolve: the successor on `ok`, the recovery position on\n    92\t   `gap`. `end` resolves as the immediate path yields it, and every other\n    93\t   outcome — cursor-mismatch, invalid-cursor, transport-error, and\n    94\t   anything undeclared — is terminal under its own keyword.\n    95\t\n    96\t   An answer that is not an outcome map the contract can vouch for — a\n    97\t   non-map, a missing or unqualified outcome, a declared outcome missing\n    98\t   its required keys — folds into the qualified terminal status\n    99\t   `:dao.stream.waitset/invalid-answer` instead of waking as an\n   100\t   unnameable `:status nil`. A poll that throws — a `:stream` that fails\n   101\t   its protocol, a defective transport — folds into the same diagnostic:\n   102\t   the entry cannot be trusted to poll again, and an uninterpretable\n   103\t   answer is terminal data, never an exception and never a wait.\"\n   104\t  [entry resolved]\n   105\t  (try\n   106\t    (let [result (stream/next (:stream resolved) (:cursor resolved))\n   107\t          o (:dao.stream/outcome result)]\n   108\t      (if (= :invalid (answer-defect :next result))\n   109\t        {:wake (diagnostic-result entry :dao.stream.waitset/invalid-answer)}\n   110\t        (case o\n   111\t          :dao.stream/ok\n   112\t          (let [cursor (:dao.stream/cursor result)]\n   113\t            {:wake (woken-result entry :ok (:dao.stream/value result) cursor)\n   114\t             :advance-cursor cursor})\n   115\t\n   116\t          :dao.stream/blocked nil\n   117\t\n   118\t          :dao.stream/end\n   119\t          {:wake (woken-result entry :end nil nil)}\n   120\t\n   121\t          :dao.stream/gap\n   122\t          (let [cursor (:dao.stream/cursor result)]\n   123\t            {:wake (woken-result entry :dao.stream/gap :dao.stream/gap cursor)\n   124\t             :advance-cursor cursor})\n   125\t\n   126\t          ;; Terminal under its own keyword, never a wait: waiting on an\n   127\t          ;; answer the library cannot interpret would spin.\n   128\t          {:wake (woken-result entry o o nil)})))\n   129\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   130\t      {:wake (diagnostic-result entry :dao.stream.waitset/invalid-answer)})))\n   131\t\n   132\t\n   133\t(defn- poll-put\n   134\t  \"Poll one resolved `:put` entry by appending — the append is an effect\n   135\t   of this poll, and `check` returns the state that records it. Returns\n   136\t   nil while the entry must keep waiting — `full` is the only writer\n   137\t   outcome that can change on its own — and otherwise the woken result.\n   138\t   `ok` resolves with the appended value and no cursor; `closed` is a\n   139\t   terminal append failure under its own keyword, never a reader's `end`;\n   140\t   every other outcome, declared or not, is terminal under its own\n   141\t   keyword.\n   142\t\n   143\t   A resolution with no `:value` appends nil: the transport is the one\n   144\t   that answers `invalid-value`, and the engine reads its `:datom` the\n   145\t   same loose way. An answer that is not an outcome map, and a poll that\n   146\t   throws — a `:stream` failing its writer protocol, a defective\n   147\t   transport — fold into `:dao.stream.waitset/invalid-answer`, exactly as\n   148\t   the reader's poll does: the entry cannot be trusted to poll again.\"\n   149\t  [entry resolved]\n   150\t  (try\n   151\t    (let [value (:value resolved)\n   152\t          result (stream/append! (:stream resolved) value)\n   153\t          o (:dao.stream/outcome result)]\n   154\t      (if (= :invalid (answer-defect :append! result))\n   155\t        {:wake (diagnostic-result entry :dao.stream.waitset/invalid-answer)}\n   156\t        (case o\n   157\t          :dao.stream/ok {:wake (woken-result entry :ok value nil)}\n   158\t          :dao.stream/full nil\n   159\t          {:wake (woken-result entry o o nil)})))\n   160\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   161\t      {:wake (diagnostic-result entry :dao.stream.waitset/invalid-answer)})))\n   162\t\n   163\t\n   164\t(defn check\n   165\t  \"Run one complete ordered sweep over `waitset`'s entries: a synchronous,\n   166\t  state-threaded interpreter step with explicit stream effects — it calls\n   167\t  `next` on live media and a parked writer's `append!` — so it is never\n   168\t  described as pure.\n   169\t\n   170\t  `resolver` is host composition, two synchronous functions over whole\n   171\t  entries:\n   172\t\n   173\t    {:resolve (fn [store entry] ...)          ; => {:stream h :cursor c :value v} or nil\n   174\t     :advance (fn [store entry cursor] ...)}  ; => store'\n   175\t\n   176\t  `:resolve` maps an entry to its live handle plus the cursor to read from\n   177\t  (`:next`) or the value to append (`:put`), or answers nil when it\n   178\t  cannot. `:advance` returns the store with that entry's reader cursor\n   179\t  moved to `cursor`. Both are invoked immediately, per entry, and never\n   180\t  retained — the shape of `reduce`'s `f`, not an event callback. The store\n   181\t  is opaque to this library: it is never dereferenced here, only passed\n   182\t  through.\n   183\t\n   184\t  Returns\n   185\t\n   186\t    {:waitset {:waiting [...]}   ; thread this into the next check\n   187\t     :woken   [...]              ; this call's results only; host-owned\n   188\t     :store   store'}            ; the host commits this\n   189\t\n   190\t  Every entry is polled every call, one at a time in wait-set order — no\n   191\t  budget, no scan position. A still-waiting entry (`blocked` for a reader,\n   192\t  `full` for a writer) is retained exactly as stored. A resolved entry\n   193\t  leaves `:waiting` and appears in `:woken` as\n   194\t\n   195\t    {:entry <the stored entry> :status ... :value ... :cursor ...}\n   196\t\n   197\t  where `:cursor` is present only for a reader whose poll returned one.\n   198\t  The library never adds a resolved handle or polling cursor to any entry\n   199\t  it retains or returns, and `:woken` never accumulates: check the\n   200\t  returned `:waitset` again and it answers only what moved since.\n   201\t\n   202\t  Two laws are preserved from the engine this sweep generalizes.\n   203\t  Shared-cursor write-back: a woken reader's successor — or recovery\n   204\t  cursor, on gap — is advanced in the store before later entries resolve,\n   205\t  so co-waiters on one cursor read distinct values and a co-waiter behind\n   206\t  a gap reads from the recovery position; wait-set order is therefore wake\n   207\t  order, and nothing reorders `:waiting`. A parked writer retries by\n   208\t  appending: the append is an effect of the poll, so no caller may drop a\n   209\t  returned `:waitset` or `:store`.\n   210\t\n   211\t  Classification is total, per operation. For a `:next` entry only\n   212\t  `blocked` waits: `ok` resolves with the value and its successor, `end`\n   213\t  as `{:value nil :status :end}`, `gap` with its recovery cursor, and\n   214\t  cursor-mismatch, invalid-cursor and transport-error under their own\n   215\t  qualified keywords. For a `:put` entry only `full` waits: `ok` resolves\n   216\t  with the appended value and no cursor; closed, invalid-value and\n   217\t  transport-error are terminal append failures under their own keywords —\n   218\t  writer `closed` is never a reader's `end`. Any outcome outside the\n   219\t  operation's declared set is terminal under its own keyword, never a\n   220\t  wait.\n   221\t\n   222\t  Three diagnostics are the library's own, and they also never wait: an\n   223\t  entry whose `:resolve` answers nil or without a `:stream` wakes with\n   224\t  `:status :dao.stream.waitset/unresolved`; an entry whose `:reason` is\n   225\t  neither `:next` nor `:put` wakes with\n   226\t  `:status :dao.stream.waitset/unsupported-reason`; and a poll that\n   227\t  answers something other than an outcome map — or throws, because its\n   228\t  handle fails the protocol it was resolved to — wakes with\n   229\t  `:status :dao.stream.waitset/invalid-answer`, the entry no longer\n   230\t  being one that can be trusted to poll. In every case no `:advance` is\n   231\t  called, the store is unchanged, the original entry is returned intact,\n   232\t  and the entry leaves `:waiting`.\n   233\t\n   234\t  Resolvers must not throw. A resolver throw voids the sweep: `check`\n   235\t  does not return, and a caller that re-threads its previous waitset\n   236\t  into a later call re-polls every entry — re-appending writers that\n   237\t  already appended. The engine's sweep behaves identically, and this is\n   238\t  stated as the contract on resolvers rather than caught: host\n   239\t  composition failing is a host defect the library cannot name, and\n   240\t  wrapping it would hide it inside a diagnostic.\"\n   241\t  [waitset resolver store]\n   242\t  (let [{resolve-fn :resolve, advance-fn :advance} resolver]\n   243\t    (loop [remaining (:waiting waitset)\n   244\t           store store\n   245\t           waiting []\n   185\t(defn- park-and-call\n   186\t  \"Park the continuation, emit the request, and wait for its response.\n   187\t\n   188\t   The pair is checked before `park-continuation` deliberately: the park runs\n   189\t   before the first stream touch, so an error raised later would strand a\n   190\t   continuation in `:parked` and consume an id counter.\n   191\t\n   192\t   The request is retained, never dropped. A `full` call-in leaves the\n   193\t   identical encoded request in the polling wait set, which retries it, and\n   194\t   the call starts waiting for its response only once the append has\n   195\t   succeeded. `closed`, `invalid-value` and `transport-error` fail the call\n   196\t   here and name their outcome.\"\n   197\t  [state op args k env]\n   198\t  (let [{:keys [call-in]} (ffi/require-call-pair! (:resources state) op)\n   199\t        response-cont {:type :dao.stream.apply/eval-call, :next k, :env env}\n   200\t        parked (engine/park-continuation state {:k response-cont, :env env})\n   201\t        parked-id (get-in parked [:value :id])\n   202\t        request (apply2/request parked-id op (vec args))\n   203\t        result (apply2/put-request! call-in request)]\n   204\t    (case (:dao.stream/outcome result)\n   205\t      :dao.stream/ok\n   206\t      (-> parked\n   207\t          (update :wait-set\n   208\t                  (fnil conj [])\n   209\t                  (ffi/call-response-wait-entry parked-id k env))\n   210\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   635\t    :ffi-request\n   636\t    (let [req-id (get-in pending [:yin.k/request\n   637\t                                  :dao.stream/identity])\n   638\t          resp-id (get-in pending [:yin.k/response\n   639\t                                   :dao.stream/identity])\n   640\t          envelope (:yin.k/request-envelope pending)]\n   641\t      (if (some? envelope)\n   642\t        (if-let [req (streams req-id)]\n   643\t          (if-let [resp (streams resp-id)]\n   644\t            {:entry (merge ctx\n   645\t                           {:reason :put,\n   646\t                            :request-sent true,\n   647\t                            :call-id (:yin.k/call-id pending),\n   648\t                            :op (:yin.k/request-op pending),\n   649\t                            :stream-id req,\n   650\t                            :datom envelope,\n   651\t                            :response-cursor\n   652\t                            (cell-keys (:yin.k/response-cell pending)),\n   653\t                            :response-stream resp})}\n   654\t            (unsatisfied resp-id))\n   655\t          (unsatisfied req-id))\n   656\t        (unsatisfied req-id)))\n   657\t\n   658\t    (:link-request :link-response)\n   659\t    (let [reason (:yin.k/reason pending)\n   660\t          cid (:yin.k/cell pending)\n   661\t          sid (streams (cell-identity cells cid))\n   662\t          req (streams (get-in pending [:yin.k/request\n   663\t                                        :dao.stream/identity]))]\n   664\t      (if (and sid req)\n   665\t        {:entry (merge ctx\n   335\t(defn- wake-refusal?\n   336\t  \"True when a woken `:next`/`:put` entry's `status` is one the immediate\n   337\t   path answers as the shaped refusal: `:dao.stream/refused`, or a\n   338\t   well-formed outcome outside this contract version -- a newer contract,\n   339\t   not a defect. The declared error outcomes are terminal instead, and\n   340\t   the value statuses carry their poll's own value.\"\n   341\t  [reason status]\n   342\t  (and (contains? #{:next :put} reason)\n   343\t       (not (contains? (get wake-value-statuses reason) status))\n   344\t       (not (contains? (get wake-error-outcomes reason) status))))\n   345\t\n   346\t\n   347\t(defn make-woken-run-queue-entries\n   348\t  \"Transform woken wait-set entries into ready-queue entries.\n   349\t   Readers (with :cursor-ref) record the successor cursor the transport\n   350\t   returned as a resource update. Writers (no :cursor-ref) just stamp\n   351\t   :value. Each woken result's :status rides onto the ready entry, where\n   352\t   terminal-resume-outcome reads it.\n   353\t\n   354\t   A woken status the immediate `handle-put`/`handle-next` answers as the\n   355\t   shaped refusal -- `:dao.stream/refused`, or an outcome outside this\n   356\t   contract version -- is shaped into that same refusal value, so whether\n   357\t   the first attempt blocked does not change what the program sees. The\n   358\t   declared error outcomes stay raw, for terminal-resume-outcome to raise.\n   359\t\n   360\t   The ready entry stays pure data: any `:stream` handle a poll resolved\n   361\t   is dropped -- the resource updates carry the successor cursor, and\n   362\t   handles are re-resolved from ids when needed again -- so an entry\n   363\t   neither waits nor runs holding a host object.\"\n   364\t  [state woken]\n   365\t  (mapv (fn [{:keys [entry value cursor status], :as woken-entry}]\n   366\t          (let [cursor-ref (:cursor-ref entry)\n   367\t                value (if (wake-refusal? (:reason entry) status)\n   368\t                        (cond-> {:status :refused\n   369\t                                 :outcome status\n   370\t                                 :stream-id (:stream-id entry)}\n   371\t                          cursor-ref (assoc :cursor-id (:id cursor-ref)))\n   372\t                        value)\n   373\t                updates\n   374\t                (or (:resource-updates woken-entry)\n   375\t                    (when (and cursor-ref cursor)\n   376\t                      (let [cursor-id (:id cursor-ref)\n   377\t                            cursor-data (get (:resources state) cursor-id)]\n   378\t                        {cursor-id (assoc cursor-data :cursor cursor)})))]\n   379\t            (dissoc (assoc entry\n   380\t                           :value value\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '295,335p'; nl -ba src/cljc/yin/vm/ffi/remote_serve/holder.cljc | sed -n '225,255p'; nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '885,935p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '1020,1065p'; rg -n \\\"id-counter|parked-|ffi.*id|:yin.k/call-id|:call-id\\\" docs/design/yin.vm.universal-continuation-format.md | head -60\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '295,335p'; nl -ba src/cljc/yin/vm/ffi/remote_serve/holder.cljc | sed -n '225,255p'; nl -ba src/cljc/yin/vm/semantic.cljc | sed -n '885,935p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '1020,1065p'; rg -n \\\"id-counter|parked-|ffi.*id|:yin.k/call-id|:call-id\\\" docs/design/yin.vm.universal-continuation-format.md | head -60\"","aggregated_output":"   295\t\n   296\t\n   297\t(declare gensym)\n   298\t\n   299\t\n   300\t(defn attach-resource\n   301\t  \"Install the host stream `handle` a composition hands a task under a\n   302\t   fresh resource id, and return `[stream-ref state]` with the reference\n   303\t   sealed under the task's secret. This is how a stream reaches a program:\n   304\t   never through the store.\"\n   305\t  [state handle]\n   306\t  (let [[id state] (gensym state \"stream\")\n   307\t        ref (issue-ref state :stream-ref id)]\n   308\t    [ref (assoc-in state [:resources id] handle)]))\n   309\t\n   310\t\n   311\t(def ^:private wake-error-outcomes\n   312\t  \"The declared outcomes `handle-next` and `handle-put` raise as errors,\n   313\t   by wait reason: the read defects for a parked reader, the write defects\n   314\t   for a parked writer. A wake raises these exactly as the immediate\n   315\t   operation would. Every other status is either a value answer or an\n   316\t   outcome outside this contract version, and both of those the immediate\n   317\t   path answers as data -- so the wake answers them as data too.\"\n   318\t  {:next #{:dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n   319\t           :dao.stream/transport-error}\n   320\t   :put #{:dao.stream/closed :dao.stream/invalid-value\n   321\t          :dao.stream/transport-error}})\n   322\t\n   323\t\n   324\t(def ^:private wake-value-statuses\n   325\t  \"The statuses a woken entry resumes with its poll's own value, by wait\n   326\t   reason: ok, end and gap for a parked reader, ok alone for a parked\n   327\t   writer -- the write outcome set has no end and no gap, so those\n   328\t   keywords on an append are outcomes outside this contract version and\n   329\t   refuse. An entry that was never polled carries no status and resumes\n   330\t   with the value it already holds.\"\n   331\t  {:next #{nil :ok :end :dao.stream/gap}\n   332\t   :put #{nil :ok}})\n   333\t\n   334\t\n   335\t(defn- wake-refusal?\n   225\t        (if (zero? n)\n   226\t          h\n   227\t          (let [r (stream/next (::grants h) (::grants-cursor h))]\n   228\t            (cond\n   229\t              (= :dao.stream/ok (:dao.stream/outcome r))\n   230\t              (let [v (:dao.stream/value r)\n   231\t                    c' (:dao.stream/cursor r)]\n   232\t                (if (my-grant? h v)\n   233\t                  (if-some [h' (assemble h v)]\n   234\t                    (assoc h' ::grants-cursor c')\n   235\t                    h)\n   236\t                  (recur (assoc h ::grants-cursor c') (dec n))))\n   237\t              ;; facts were evicted past the cursor before this holder\n   238\t              ;; read them; its grant may be among them, and which were\n   239\t              ;; lost cannot be said -- terminal, never retried\n   240\t              (= :dao.stream/gap (:dao.stream/outcome r))\n   241\t              (assoc h ::lost :dao.stream/gap)\n   242\t              (gone? r) (assoc h ::reclaimed? true)\n   243\t              :else h)))))))\n   244\t\n   245\t\n   246\t(defn- settle\n   247\t  \"Settle pending renewals from the event writer: an outcome naming the\n   248\t   renewal identity settles the oldest pending one; append-unknown\n   249\t   settles all as unknown.\"\n   250\t  [h]\n   251\t  (let [rid (get-in h [::holder :self])\n   252\t        {eh :handle} (::events h)]\n   253\t    (loop [h h\n   254\t           c (:cursor (::events h))]\n   255\t      (let [r (stream/next eh c)]\n   885\t     :primitives    primitive operations map\n   886\t     :primitive-profiles published primitive profile registry\n   887\t     :primitive-canonical-names name -> canonical name for intentional aliases\n   888\t     :modules       module registry value (see `yin.vm.module`)\n   889\t     :make-stream   (fn [capacity] -> create outcome); no default\n   890\t     :call-in       explicit inbound request handle\n   891\t     :call-out      explicit outbound response handle\n   892\t     :call-capacity capacity for a constructed FFI pair\n   893\t     :bridge        host FFI handlers\n   894\t\n   895\t   As for the walker: there is no `:in-stream` (program observation belongs\n   896\t   to `dao.stream.observer`), and construction is all-or-nothing — the FFI\n   897\t   pair and its call-out cursor are stream operations whose failure fails\n   898\t   here.\"\n   899\t  ([] (create-vm {}))\n   900\t  ([opts]\n   901\t   (when (contains? opts :in-stream)\n   902\t     (throw (ex-info\n   903\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n   904\t              {:in-stream (:in-stream opts)})))\n   905\t   (let [env (vm/check-bindings! :env (or (:env opts) {}))\n   906\t         base (vm/empty-state\n   907\t                (assoc (select-keys opts\n   908\t                                    [:primitives :primitive-profiles\n   909\t                                     :primitive-canonical-names :modules\n   910\t                                     :make-stream :call-in :call-out\n   911\t                                     :call-capacity :link-request\n   912\t                                     :link-response :origin :ancestry\n   913\t                                     :capability-secret :secret-source\n   914\t                                     :attach-stream])\n   915\t                       :telemetry (:telemetry opts)\n   916\t                       :vm-model :semantic))]\n   917\t     (-> (map->SemanticVM (merge base\n   918\t                                 {:bridge nil,\n   919\t                                  :program nil,\n   920\t                                  :control nil,\n   921\t                                  :env env,\n   922\t                                  :stack [],\n   923\t                                  :k nil,\n   924\t                                  :value nil,\n   925\t                                  :code {},\n   926\t                                  :code-aliases {},\n   927\t                                  :halted? true,\n   928\t                                  :blocked? false}))\n   929\t         (telemetry/install :semantic)\n   930\t         (ffi/attach (:bridge opts))\n   931\t         (telemetry/emit-snapshot :init)))))\n   932\t\n   933\t\n   934\t;; =============================================================================\n   935\t;; Module kernel (yin.vm.linker.md section 7.3)\n  1020\t     :primitive-profiles published primitive profile registry\n  1021\t     :primitive-canonical-names name -> canonical name for intentional aliases\n  1022\t     :modules       module registry value (see `yin.vm.module`)\n  1023\t     :make-stream   (fn [capacity] -> create outcome); no default\n  1024\t     :call-in       explicit inbound request handle\n  1025\t     :call-out      explicit outbound response handle\n  1026\t     :call-capacity capacity for a constructed FFI pair\n  1027\t     :bridge        host FFI handlers\n  1028\t\n  1029\t   There is no `:in-stream`: program observation belongs to\n  1030\t   `dao.stream.observer`, and an obsolete `:in-stream` option is\n  1031\t   rejected here, before any FFI resource is allocated.\n  1032\t\n  1033\t   Construction is all-or-nothing: creating the FFI pair and minting the\n  1034\t   call-out cursor are stream operations, and any non-`ok` outcome fails here\n  1035\t   rather than leaving a half-built VM. The bridge cursor is minted by\n  1036\t   `ffi/attach` below; the program cursor belongs to observer attachment.\"\n  1037\t  ([] (create-vm {}))\n  1038\t  ([opts]\n  1039\t   (when (contains? opts :in-stream)\n  1040\t     (throw (ex-info\n  1041\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n  1042\t              {:in-stream (:in-stream opts)})))\n  1043\t   (let [env (vm/check-bindings! :env (or (:env opts) {}))\n  1044\t         base (vm/empty-state\n  1045\t                (assoc (select-keys opts\n  1046\t                                    [:primitives :primitive-profiles\n  1047\t                                     :primitive-canonical-names :modules\n  1048\t                                     :make-stream :call-in :call-out\n  1049\t                                     :call-capacity :link-request\n  1050\t                                     :link-response :origin :ancestry\n  1051\t                                     :capability-secret :secret-source\n  1052\t                                     :attach-stream])\n  1053\t                       :telemetry (:telemetry opts)\n  1054\t                       :vm-model :ast-walker))]\n  1055\t     (-> (map->ASTWalkerVM (merge base\n  1056\t                                  {:bridge nil,\n  1057\t                                   :program nil,\n  1058\t                                   :control nil,\n  1059\t                                   :env env,\n  1060\t                                   :k nil,\n  1061\t                                   :value nil,\n  1062\t                                   :halted? true,\n  1063\t                                   :blocked? false}))\n  1064\t         (telemetry/install :ast-walker)\n  1065\t         (ffi/attach (:bridge opts))\n53:wait entry or a `:parked-continuation` record is `{segment pc env stack k}`\n444:                    :yin.k/segment :segment/sha256-…             ; which also carry :yin.k/call-id\n568: :yin.k/call-id    :call-7             ; the :dao.stream.apply/id correlation\n576: :yin.k/call-id    :call-7\n721:| parked continuation | `:yin.k/frame` | a nested frame plus `:yin.k/parked-id` | `{:type :parked-continuation …}` |\n981:| :cyclic | :in-memory-handle | :non-canonicalizable | :foreign-parked-ref\n983:(`:non-canonicalizable` and `:foreign-parked-ref` from §7.3.2 and §7.6.3;\n1144:machine's fresh identifiers come from `:id-counter`, and `:resume` resolves\n1156:- **Fresh-name state travels.** `:yin.k/scheduler {:yin.k/id-counter n\n1168:  refuses the lift (`:yin.k/non-portable`, kind `:foreign-parked-ref`),\n1521:   in the local wait set; seed `:id-counter` per §7.6.3; run — through a\n1723:  Insufficient pending evidence refuses before publication, as does a\n1821:  closure, and a parked-id reference. Give the receiver a conflicting\n1833:  `:yin.k/kind :foreign-parked-ref`. No partial lower occurs.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,42p' src/cljc/yin/vm/engine.cljc; sed -n '1,38p' src/cljc/yin/vm.cljc; rg -n \\\"ffi/|yin.vm.ffi\\\" src/cljc/yin/vm/engine.cljc src/cljc/yin/vm.cljc; rg -n \\\"defn .*create-vm|empty-state\\\" src/cljc/yin/vm/debruijn*.cljc src/cljc/yin/vm/semantic.cljc src/cljc/yin/vm/ast_walker.cljc | head -70\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,42p' src/cljc/yin/vm/engine.cljc; sed -n '1,38p' src/cljc/yin/vm.cljc; rg -n \\\"ffi/|yin.vm.ffi\\\" src/cljc/yin/vm/engine.cljc src/cljc/yin/vm.cljc; rg -n \\\"defn .*create-vm|empty-state\\\" src/cljc/yin/vm/debruijn*.cljc src/cljc/yin/vm/semantic.cljc src/cljc/yin/vm/ast_walker.cljc | head -70\"","aggregated_output":"(ns yin.vm.engine\n  \"Shared evaluation machinery for Yin VMs on DaoStream v2.\n\n   What the port changed, and why:\n\n   - **The host supplies streams.** `:stream/make` calls the composition's\n     `:make-stream`; there is no transport identity in this namespace. Every\n     other stream handler is a protocol call on a handle already in the\n     private `:resources` table, which no store instruction reads, reached\n     through a reference whose seal is verified first.\n   - **Cursors are opaque.** A cursor cell in `:resources` is\n     `{:stream-id id :cursor <opaque>}`. Nothing increments one.\n   - **Outcomes are maps, and every handler is total over its closed set.**\n     `blocked` and `full` park; `end` and `gap` are values the program sees;\n     the rest are errors that name their outcome.\n   - **Waiters are gone.** No v2 transport is waitable, so the polling wait\n     set is the mechanism rather than a fallback. A poll is a synchronous\n     `next` or `append!` on the handle in `:resources`; no scheduler runtime\n     sits between the VM and its streams. Cadence comes from the driver\n     above the VM.\n   - **`:stream/take` is gone.** Destructive read needs a reader position in\n     the medium, which the contract retired.\n   - **The module registry is a value** carried in VM state, so effect\n     dispatch and `resolve-var` read a supplied registry rather than a global.\n   - **Program observation is not engine work.** `ready-for-ingress?` lives\n     here because it speaks the scheduler's own vocabulary, but the program\n     handle, cursor, and gap count belong to `dao.stream.observer`;\n     nothing in this namespace polls a program stream.\"\n  (:refer-clojure :exclude [gensym])\n  (:require [clojure.set]\n            [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.waitset :as waitset]\n            [yin.vm :as vm]\n            [yin.vm.linker :as linker]\n            [yin.vm.module :as module]\n            [yin.vm.telemetry :as telemetry]))\n\n\n(defn- outcome\n  [result]\n  (:dao.stream/outcome result))\n(ns yin.vm\n  \"Canonical data model (Datoms), schema, and primitives for the Yin Abstract\n   Machine on DaoStream v2.\n\n   The shared kernel of `yin.vm` carries over unchanged. What changes is the\n   stream wiring:\n\n   - **The host supplies streams.** v1 hardcoded a ring buffer descriptor and\n     called `ds/open!`. Here a composition hands the interpreter a\n     `:make-stream` constructor exactly as it hands it `:primitives`. There is\n     no default, because a default would smuggle the hardcoded transport back\n     in: absent a supplied constructor, `:stream/make` is unsupported and says\n     so.\n   - **Program observation lives outside the VM.** The program stream handle,\n     cursor, and gap count belong to `dao.stream.observer`; the VM never\n     polls a program stream and no longer accepts `:in-stream` at\n     construction. Language-level stream effects and FFI still operate their\n     own streams and cursors inside the VM.\n   - **Cursors are opaque.** The VM's internal cursor representation is\n     `{:stream-id id :cursor <opaque>}`. There is no position and no seek.\n   - **Construction is all-or-nothing.** Creating the FFI pair and minting its\n     cursors are stream operations with their own outcomes. Any non-`ok`\n     outcome fails construction; a VM cannot be half-built.\n   - **`call-in-cursor-key` is dropped.** v1 wrote it and nothing read it.\"\n  (:refer-clojure :exclude [eval])\n  (:require [dao.datom :as datom]\n            [dao.jing :as jing]\n            [dao.space.query :as query]\n            [dao.stream :as stream]))\n\n\n;; =============================================================================\n;; Protocols\n;; =============================================================================\n;; Common VM interfaces implemented by all execution engines.\n\n(defprotocol IVM\n  \"Unified VM protocol for execution, evaluation, and observable state.\"\nsrc/cljc/yin/vm/semantic.cljc:880:(defn create-vm\nsrc/cljc/yin/vm/semantic.cljc:906:         base (vm/empty-state\nsrc/cljc/yin/vm/ast_walker.cljc:1014:(defn create-vm\nsrc/cljc/yin/vm/ast_walker.cljc:1044:         base (vm/empty-state\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"agent_message","text":"The minimal safe path is a caller-scoped apply ID plus routing responses to the matching FFI wait before resuming it. A unique ID alone is insufficient because the generic wait sweep can consume a different caller’s response. I’m checking the migration fields and construction options so the ruling can name the exact touch points."}}
