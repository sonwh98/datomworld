      pending\n  1477\t                                        ffi-response-budget)]\n  1478\t                      [state (into waiting w) (into woken k)]))\n  1479\t                  [state [] []]\n  1480\t                  cells)]\n  1481\t      (-> state\n  1482\t          (assoc :wait-set (into (vec others) waiting))\n  1483\t          (update :ready-queue (fnil into [])\n  1484\t                  (make-woken-run-queue-entries state woken))))))\n  1485\t\n  1486\t\n  1487\t(defn check-wait-set\n  1488\t  \"Check wait-set entries against their transports.\n  1489\t\n  1490\t   The sweep is `dao.stream.waitset/check` — this engine was that library's\n  1491\t   seed and is now its first consumer. Every entry is resolved to a live\n  1492\t   handle and an opaque cursor out of the store by `waitset-resolver` and\n  1493\t   polled with a synchronous `next` or `append!` — resolution happens per\n  1494\t   poll, so the stored entry itself never carries a handle. There is no\n  1495\t   transport-local waking to fall back from: this is the only mechanism.\n  1496\t\n  1497\t   Entries are polled one at a time in wait-set order, and a woken reader's\n  1498\t   successor cursor is written back to the store before the next entry is\n  1499\t   resolved. Waiters sharing a cursor-ref therefore read distinct values —\n  1500\t   the value at the cursor wakes the first, its successor wakes the next —\n  1501\t   instead of every waiter reading the value at the shared pre-poll\n  1502\t   cursor. An entry that stays waiting is retained in its stored,\n  1503\t   resource-id form.\n  1504\t\n  1505\t   Each woken result's `:status` is stamped onto its ready entry, where\n  1506\t   `terminal-resume-outcome` reads it: an outcome the immediate operation\n  1507\t   raises as an error fails the same way when the resume pops it — and a\n  1508\t   waitset diagnostic, an entry the sweep could not poll at all, raises\n  1509\t   there too, before any continuation is restored.\n  1510\t\n  1511\t   The link wait entries `require` adds (yin.vm.linker.md section 7.2) are\n  1512\t   polled first, by the engine rather than the stream sweep: a\n  1513\t   `:link-request` retries its envelope, a `:link-response` advances its\n  1514\t   own kept cursor to the response carrying its id, and an `:install`\n  1515\t   waits on its install child. The install children are then stepped in\n  1516\t   this same round (section 7.3), so a child that halts restores its\n  1517\t   waiters here; nothing about a child runs inside a restore.\n  1518\t\n  1519\t   The FFI response readers are routed next, also outside the stream\n  1520\t   sweep (`poll-ffi-responses`): a response wakes the reader whose call\n  1521\t   id it names, never whichever reader its cell reached first.\"\n  1522\t  [state]\n  1523\t  (let [wait-set (:wait-set state)]\n  1524\t    (if (and (empty? wait-set) (empty? (:installs state)))\n  1525\t      state\n  1526\t      (let [state (poll-links state\n  1527\t                              (filterv link-entry? wait-set)\n  1528\t                              (remove link-entry? wait-set))\n  1529\t            wait-set (:wait-set state)\n  1530\t            state (poll-ffi-responses state\n  1531\t                                      (filterv ffi-response-entry? wait-set)\n  1532\t                                      (remove ffi-response-entry? wait-set))\n  1533\t            wait-set (:wait-set state)\n  1534\t            engine-polled? (some-fn link-entry? ffi-response-entry?)\n  1535\t            streams (filterv (complement engine-polled?) wait-set)\n  1536\t            {:keys [woken store], :as result}\n  1537\t            (waitset/check {:waiting streams}\n  1538\t                           waitset-resolver\n  1539\t                           (:resources state))\n  1540\t            v (assoc state\n  1541\t                     :resources store\n  1542\t                     :wait-set (into (:waiting (:waitset result))\n  1543\t                                     (filter engine-polled?)\n  1544\t                                     wait-set))]\n  1545\t        (update v\n  1546\t                :ready-queue (fnil into [])\n  1547\t                (make-woken-run-queue-entries v woken))))))\n  1548\t\n  1549\t\n  1550\t(declare handle-effect resume-continuation)\n  1551\t\n  1552\t\n  1553\t(defn run-loop\n  1554\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n  1555\t   `resume-fn` pops and restores them.\"\n  1556\t  [state active? step-fn resume-fn]\n  1557\t  (loop [v state]\n  1558\t    (let [q (or (:ready-queue v) [])]\n  1559\t      (cond (active? v) (recur (step-fn v))\n  1560\t            (:blocked? v) (let [v' (check-wait-set v)]\n  1561\t                            (if-let [resumed (resume-fn v')]\n  1562\t                              (recur resumed)\n  1563\t                              (telemetry/emit-snapshot v' :blocked)))\n  1564\t            (seq q) (if-let [resumed (resume-fn v)]\n  1565\t                      (recur resumed)\n  1566\t                      v)\n  1567\t            :else (if (:halted? v) (telemetry/emit-snapshot v :halt) v)))))\n  1568\t\n  1569\t\n  1570\t(def ^:private waitset-diagnostics\n  1590\t   so it is named here rather than falling through to the restore. An\n  1591\t   entry that was never polled carries no status.\"\n  1592\t  [entry]\n  1593\t  (let [status (:status entry)]\n  1594\t    (cond\n  1595\t      (contains? waitset-diagnostics status) status\n  1596\t      (= :link-refused status) status\n  1597\t      (contains? ffi/response-loss-statuses status) status\n  1598\t      (contains? #{:next :put} (:reason entry))\n  1599\t      (when (contains? (get wake-error-outcomes (:reason entry)) status)\n  1600\t        status))))\n  1601\t\n  1602\t\n  1603\t(defn- throw-terminal-resume!\n  1604\t  \"Fail a resumed entry exactly as the immediate operation would have. A\n  1605\t   waitset diagnostic names its status and the entry that earned it: there\n  1606\t   is no stream operation whose error vocabulary it belongs to.\"\n  1607\t  [entry o]\n  1608\t  (cond\n  1609\t    (contains? waitset-diagnostics o)\n  1610\t    (fail \"Wait-set entry woke with a diagnostic\" {:status o, :entry entry})\n  1611\t    ;; a refused or lost link, or a refused install: the effect's error\n  1612\t    (= :link-refused o)\n  1613\t    (fail (str \"Module link refused: \"\n  1614\t               (clojure.core/name (or (:reason (:refusal entry)) :refused)))\n  1615\t          (assoc (:refusal entry) :link-module (:name entry)))\n  1616\t    ;; an FFI response stream that can no longer answer this call\n  1617\t    (contains? ffi/response-loss-statuses o)\n  1618\t    (ffi/throw-response-lost! (ffi/response-call-id entry) o)\n  1619\t    (= :next (:reason entry))\n  1620\t    (fail \"Stream read failed\"\n  1621\t          {:outcome o,\n  1622\t           :stream-id (:stream-id entry),\n  1623\t           :cursor-id (:id (:cursor-ref entry))})\n  1624\t    :else (fail \"Stream append failed\"\n  1625\t                {:outcome o, :stream-id (:stream-id entry)})))\n  1626\t\n  1627\t\n  1628\t(defn resume-from-run-queue\n  1629\t  \"Pop first entry from the ready-queue, merge its resource updates into\n  1630\t   the private `:resources` table, and restore VM-specific context.\n  1631\t\n  1632\t   Restoration is dispatched here rather than carried on the entry, so a\n  1633\t   ready entry holds registers, ids, and values — never a closure. The\n  1634\t   terminal-outcome check runs before the restore: a woken retry that ended\n  1635\t   in an outcome the immediate operation raises as an error must fail the\n  1636\t   same way here, not reach Yin code as a value.\n  1637\t\n  1638\t   `restore-fn` is called with three arguments, `base entry val`, where\n  1639\t   `val` is the woken `:value` — the same signature `resume-continuation`\n  1640\t   uses, so one restore serves both engine call sites