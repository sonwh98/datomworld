{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/driver.cljc | sed -n '1,650p'\"","aggregated_output":"     1\t(ns yin.repl.driver\n     2\t  \"The one owner of Yin REPL state.\n     3\t\n     4\t   A line producer appends `{:yin.repl.input/line \\\"…\\\"}` to the\n     5\t   composition-owned input medium and returns.  It does not evaluate, request,\n     6\t   poll, print, prompt, or touch the state held here.  `repl-step` is called\n     7\t   once per externally driven tick by exactly one ticker per host: it drains\n     8\t   the input medium, evaluates local input, forwards ordinary source through\n     9\t   the RPC client, publishes completions exactly once, and returns the next\n    10\t   state.\n    11\t\n    12\t   It never loops on `blocked`, and it owns no promise, future, callback, atom,\n    13\t   or clock.\"\n    14\t  (:require [clojure.string :as str]\n    15\t            [dao.data :as data]\n    16\t            [dao.stream :as stream]\n    17\t            [dao.stream.ringbuffer :as ring]\n    18\t            [dao.stream.rpc :as rpc]\n    19\t            [yin.repl.adapter :as adapter]\n    20\t            [yin.repl.connect :as connect]\n    21\t            [yin.repl :as repl]\n    22\t            [yin.repl.host :as host]))\n    23\t\n    24\t\n    25\t(def line-key :yin.repl.input/line)\n    26\t\n    27\t\n    28\t(def input-capacity\n    29\t  \"Declared capacity of the composition-owned input medium, in elements.\"\n    30\t  1024)\n    31\t\n    32\t\n    33\t(def input-budget\n    34\t  \"Maximum input elements one step reads, so a flooded medium cannot make a\n    35\t   single step unbounded.\"\n    36\t  64)\n    37\t\n    38\t\n    39\t(def response-budget\n    40\t  \"Maximum response-medium elements one step reads.\"\n    41\t  32)\n    42\t\n    43\t\n    44\t(def event-key :yin.repl.driver/event)\n    45\t(def text-key :yin.repl.driver/text)\n    46\t\n    47\t\n    48\t(def ^:private diagnostic-bounds\n    49\t  \"Bound on operator-facing diagnostic text built from unbounded internal\n    50\t   state (raw input, event/result maps).\"\n    51\t  {:depth 3 :items 8 :chars 200})\n    52\t\n    53\t\n    54\t(def connect-usage\n    55\t  \"(connect \\\"daostream:ws://host:port/repl\\\") — an absent path means /repl\")\n    56\t\n    57\t\n    58\t(defn create-input-medium!\n    59\t  \"Create the composition-owned input ring buffer.  The handoff between a line\n    60\t   producer and the step owner is a stream, which is what makes it explicit and\n    61\t   thread-safe.\"\n    62\t  []\n    63\t  (:dao.stream/handle\n    64\t    (ring/create! {:dao.stream/type ring/transport-type\n    65\t                   ring/capacity-key input-capacity})))\n    66\t\n    67\t\n    68\t(defn- mint-cursor\n    69\t  [handle]\n    70\t  (let [result (stream/cursor handle :dao.stream/oldest)]\n    71\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n    72\t      (:dao.stream/cursor result))))\n    73\t\n    74\t\n    75\t(defn create-state\n    76\t  ([] (create-state {}))\n    77\t  ([{:keys [input input-cursor repl host]}]\n    78\t   (let [input (or input (create-input-medium!))]\n    79\t     {:repl (or repl (repl/create-state))\n    80\t      :input input\n    81\t      :input-cursor (or input-cursor (mint-cursor input))\n    82\t      :input-ledger :untried\n    83\t      ;; The host WebSocket adapter is composition data, injected once.  Nil is\n    84\t      ;; the honest answer in a build with no host socket package.\n    85\t      :host (or host (host/websocket))\n    86\t      :connection nil\n    87\t      :adapter nil\n    88\t      :queued []\n    89\t      :outstanding nil\n    90\t      :retrying nil\n    91\t      :outbox []\n    92\t      :last-tick nil\n    93\t      :running? true})))\n    94\t\n    95\t\n    96\t(defn submit-line!\n    97\t  \"Append one typed line to the input medium and return the append outcome.\n    98\t   This is the whole of a line producer's work.\"\n    99\t  [input line]\n   100\t  (stream/append! input {line-key line}))\n   101\t\n   102\t\n   103\t(defn take-outbox\n   104\t  \"Return `[entries next-state]`, clearing the publication outbox exactly once.\"\n   105\t  [state]\n   106\t  [(:outbox state) (assoc state :outbox [])])\n   107\t\n   108\t\n   109\t(defn attach-remote\n   110\t  [state adapter-state]\n   111\t  (assoc state :adapter adapter-state :queued [] :outstanding nil :retrying nil))\n   112\t\n   113\t\n   114\t(defn detach-remote\n   115\t  [state]\n   116\t  (assoc state :adapter nil :queued [] :outstanding nil :retrying nil))\n   117\t\n   118\t\n   119\t(defn- publish\n   120\t  [state event text]\n   121\t  (if (str/blank? (str text))\n   122\t    state\n   123\t    (update state :outbox conj {event-key event text-key text})))\n   124\t\n   125\t\n   126\t;; =============================================================================\n   127\t;; Input\n   128\t;; =============================================================================\n   129\t\n   130\t(defn- drain-input\n   131\t  \"Read up to `input-budget` input elements, total over every `next` outcome.\n   132\t   A gap means typed lines were evicted: the loss is published, the recovery\n   133\t   cursor is taken, and none of the missing input is evaluated.\"\n   134\t  [state]\n   135\t  (loop [remaining input-budget\n   136\t         state state\n   137\t         lines []]\n   138\t    (if (or (zero? remaining) (nil? (:input-cursor state)))\n   139\t      [state lines]\n   140\t      (let [result (stream/next (:input state) (:input-cursor state))\n   141\t            outcome (:dao.stream/outcome result)]\n   142\t        (case outcome\n   143\t          :dao.stream/ok\n   144\t          (recur (dec remaining)\n   145\t                 (assoc state :input-cursor (:dao.stream/cursor result))\n   146\t                 (conj lines (get (:dao.stream/value result) line-key)))\n   147\t\n   148\t          :dao.stream/gap\n   149\t          (recur (dec remaining)\n   150\t                 (-> state\n   151\t                     (assoc :input-cursor (:dao.stream/cursor result))\n   152\t                     (publish :yin.repl.driver/notice\n   153\t                              \";; input lost: typed lines were evicted before this step\"))\n   154\t                 lines)\n   155\t\n   156\t          :dao.stream/blocked\n   157\t          [(assoc state :input-ledger outcome) lines]\n   158\t\n   159\t          [(-> state\n   160\t               (assoc :input-ledger outcome)\n   161\t               (publish :yin.repl.driver/notice\n   162\t                        (str \";; input \" (name outcome))))\n   163\t           lines])))))\n   164\t\n   165\t\n   166\t;; =============================================================================\n   167\t;; Local and remote input\n   168\t;; =============================================================================\n   169\t\n   170\t(defn- evaluate-locally\n   171\t  [state line]\n   172\t  (let [[repl text] (repl/eval-input (:repl state) line)]\n   173\t    (-> state\n   174\t        (assoc :repl repl)\n   175\t        (assoc :running? (boolean (:running? repl)))\n   176\t        (publish :yin.repl.driver/result text))))\n   177\t\n   178\t\n   179\t(defn- rpc-client\n   180\t  [state]\n   181\t  (get-in state [:adapter :yin.repl.adapter/rpc]))\n   182\t\n   183\t\n   184\t(defn- remote-terminal\n   185\t  [state]\n   186\t  (:terminal (rpc-client state)))\n   187\t\n   188\t\n   189\t(defn- remote-unsent?\n   190\t  \"True while the RPC client holds an allocated request it has not managed to\n   191\t   append.  That request, not the driver's own record of the line, is what owns\n   192\t   the request path: `rpc/request!` retries it and ignores any new operation.\"\n   193\t  [state]\n   194\t  (rpc/unsent? (rpc-client state)))\n   195\t\n   196\t\n   197\t(defn- response-cursor-unminted?\n   198\t  \"True while the RPC client's response cursor is still the `newest` anchor\n   199\t   `connect/open` composed it with.  Over a remote reflection the anchor is\n   200\t   resolved by the server when the mint request reaches it, so a request that\n   201\t   crosses first can be answered at a position the resolved cursor already\n   202\t   lies past: that answer is never read.  A request must not be sent until\n   203\t   this is false.\"\n   204\t  [state]\n   205\t  (contains? stream/standard-anchors (:cursor (rpc-client state))))\n   206\t\n   207\t\n   208\t(defn pending-write?\n   209\t  \"True while a remote write the operator is owed remains in flight: a\n   210\t   request awaiting its response, a line held for a full writer, or an\n   211\t   envelope the RPC client still retains. This is one half of the tick\n   212\t   owner's `moved?` — a pending write must never wait out a backoff ceiling,\n   213\t   so cadence stays at the base interval until it clears.\"\n   214\t  [state]\n   215\t  (boolean (or (:outstanding state)\n   216\t               (:retrying state)\n   217\t               (remote-unsent? state)\n   218\t               (and (seq (:queued state)) (response-cursor-unminted? state)))))\n   219\t\n   220\t\n   221\t(def queueable-terminals\n   222\t  \"Terminal reasons after which an ordinary line still has a reattachment\n   223\t   decision to wait for.  Only `/detached` reattaches.  A reachability failure\n   224\t   may succeed through a *fresh* connection, but that connection cannot inherit\n   225\t   this binding's queued lines, so promising to deliver them would be false.\n   226\t   Every other terminal returns input to the local shell.\"\n   227\t  #{:dao.stream.apply/detached})\n   228\t\n   229\t\n   230\t(defn- remote-routed?\n   231\t  \"True while ordinary input belongs to the remote shell.  An operator\n   232\t   `(disconnect)` ends that immediately — the shell is local again from the next\n   233\t   line, without waiting for the terminal event the boundary will deposit — while\n   234\t   an uninvited drop keeps routing so the input can queue for a reattachment.  A\n   235\t   terminal with no reattachment behind it ends it too.\"\n   236\t  [state]\n   237\t  (and (:adapter state)\n   238\t       (not (connect/operator-detached? (:connection state)))\n   239\t       (let [terminal (remote-terminal state)]\n   240\t         (or (nil? terminal) (contains? queueable-terminals terminal)))))\n   241\t\n   242\t\n   243\t(defn- abandon-unsent\n   244\t  \"Give up any allocated-but-unsent request, with the reason the driver owns.\n   245\t\n   246\t   The RPC client would otherwise retry that exact envelope on the next binding,\n   247\t   in place of the line the operator types after reattaching.  Abandoning it\n   248\t   publishes the loss as an ordinary completion, so the line is reported rather\n   249\t   than silently replayed or dropped.\"\n   250\t  [state reason]\n   251\t  (if (rpc-client state)\n   252\t    (update-in state [:adapter :yin.repl.adapter/rpc] rpc/abandon-unsent reason)\n   253\t    state))\n   254\t\n   255\t\n   256\t(declare publish-adapter-events)\n   257\t\n   258\t\n   259\t(defn- abandon-unsent-now\n   260\t  \"Finish and publish the old request path before replacing an adapter wholesale.\n   261\t\n   262\t   The ordinary disconnect/reattach paths retain their adapter until the next\n   263\t   poll can publish its completion.  A fresh connection does not: it installs a\n   264\t   new adapter immediately, so every already-unpublished completion must cross\n   265\t   into the driver's outbox first or it is discarded with the old adapter.  An\n   266\t   unsent envelope is abandoned before that unconditional publication step.\"\n   267\t  [state reason]\n   268\t  (if-not (:adapter state)\n   269\t    state\n   270\t    (let [state (cond-> state\n   271\t                  (remote-unsent? state) (abandon-unsent reason))\n   272\t          published (adapter/publish-completions (:adapter state))]\n   273\t      (publish-adapter-events\n   274\t        (assoc state :adapter (:yin.repl.adapter/state published))))))\n   275\t\n   276\t\n   277\t(defn- disconnect\n   278\t  \"`disconnect` is `close!`.  The connection value, its traffic medium, and its\n   279\t   cursors are kept: the terminal fact arrives as a deposited event, and that is\n   280\t   what makes a later `(connect …)` a `rebind` rather than a new client.\n   281\t\n   282\t   Input queued for the remote shell is dropped rather than carried across the\n   283\t   disconnection: the operator asked to stop talking to it.  A request already\n   284\t   allocated but never appended is abandoned on the same grounds, and says so.\"\n   285\t  [state]\n   286\t  (cond\n   287\t    (:connection state)\n   288\t    (-> state\n   289\t        (assoc :connection (connect/close! (:connection state) :operator))\n   290\t        (abandon-unsent :yin.repl.driver/operator-disconnect)\n   291\t        (assoc :queued [] :retrying nil)\n   292\t        (publish :yin.repl.driver/notice\n   293\t                 (str \"Disconnecting from \" (:url (:connection state)))))\n   294\t\n   295\t    (:adapter state)\n   296\t    (-> state\n   297\t        detach-remote\n   298\t        (publish :yin.repl.driver/notice \"Disconnected from remote shell\"))\n   299\t\n   300\t    :else\n   301\t    (publish state :yin.repl.driver/notice \"Not connected to a remote shell\")))\n   302\t\n   303\t\n   304\t(defn- connect-failure\n   305\t  [state result]\n   306\t  (publish state :yin.repl.driver/notice\n   307\t           (str (get result connect/message-key)\n   308\t                \" [\" (name (get result connect/outcome-key)) \"]\")))\n   309\t\n   310\t\n   311\t(defn- reattach\n   312\t  [state url]\n   313\t  (let [result (connect/reattach (:connection state) (rpc-client state))]\n   314\t    (if-not (= :yin.repl.connect/reattached (get result connect/outcome-key))\n   315\t      (connect-failure state result)\n   316\t      (-> state\n   317\t          (assoc :connection (get result connect/connection-key))\n   318\t          (assoc-in [:adapter :yin.repl.adapter/rpc] (get result connect/client-key))\n   319\t          ;; The retained envelope was encoded for the attachment that died, so\n   320\t          ;; it is reported lost rather than resent as the first thing the new\n   321\t          ;; binding says, ahead of whatever the operator types next.  Over the\n   322\t          ;; WebSocket boundary the retry meets a closed writer first and RPC\n   323\t          ;; completes it there; this holds for a host whose writer keeps\n   324\t          ;; answering `full` after its peer is gone.\n   325\t          (abandon-unsent :yin.repl.driver/abandoned-on-reattach)\n   326\t          (assoc :outstanding nil :retrying nil)\n   327\t          (publish :yin.repl.driver/notice (str \"Reattaching to \" url))\n   328\t          (publish :yin.repl.connect/connected (str \"Connected to \" url))))))\n   329\t\n   330\t\n   331\t(defn- open-connection\n   332\t  [state url]\n   333\t  (let [result (connect/open {:url url :host (:host state)})\n   334\t        dropped (count (:queued state))]\n   335\t    (if-not (= :yin.repl.connect/attached (get result connect/outcome-key))\n   336\t      (connect-failure state result)\n   337\t      (-> state\n   338\t          (abandon-unsent-now :yin.repl.driver/abandoned-on-fresh-connection)\n   339\t          (cond-> (pos? dropped)\n   340\t            (publish :yin.repl.driver/notice\n   341\t                     (str \"Discarded \" dropped \" queued remote \"\n   342\t                          (if (= 1 dropped) \"line\" \"lines\")\n   343\t                          \" before opening a fresh connection\")))\n   344\t          (assoc :connection (get result connect/connection-key))\n   345\t          (attach-remote (adapter/state (get result connect/client-key)))\n   346\t          (assoc :outstanding nil :retrying nil)\n   347\t          (publish :yin.repl.driver/notice (str \"Attaching to \" url))\n   348\t          (publish :yin.repl.connect/connected (str \"Connected to \" url))))))\n   349\t\n   350\t\n   351\t(defn- connect-command\n   352\t  \"`(connect \\\"url\\\")`.  Reattaching a dropped connection keeps its medium,\n   353\t   cursor, and id allocator; connecting a fresh URL composes a new boundary.\"\n   354\t  [state line]\n   355\t  (let [url (second (adapter/command-form line))]\n   356\t    (cond\n   357\t      (not (string? url))\n   358\t      (publish state :yin.repl.driver/notice connect-usage)\n   359\t\n   360\t      (and (:connection state)\n   361\t           (= url (:url (:connection state)))\n   362\t           (connect/reattachable? (rpc-client state)))\n   363\t      (reattach state url)\n   364\t\n   365\t      ;; The operator's own disconnection is in flight: the terminal fact has\n   366\t      ;; not landed yet, so there is nothing to reattach to and nothing to\n   367\t      ;; refuse.  Composing a second boundary here would abandon the first.\n   368\t      ;; Once a terminal has landed the boundary has said everything it will\n   369\t      ;; ever say, so this must not answer for a non-reattachable one — that\n   370\t      ;; would trap the operator on a connection nothing can revive.\n   371\t      (and (:connection state)\n   372\t           (connect/operator-detached? (:connection state))\n   373\t           (nil? (remote-terminal state)))\n   374\t      (publish state :yin.repl.driver/notice\n   375\t               (str \"Still disconnecting from \" (:url (:connection state))\n   376\t                    \"; (connect …) reattaches once the boundary reports it\"))\n   377\t\n   378\t      (and (remote-routed? state) (not (remote-terminal state)))\n   379\t      (publish state :yin.repl.driver/notice\n   380\t               (str \"Already connected to \"\n   381\t                    (or (:url (:connection state)) \"the remote shell\")\n   382\t                    \"; (disconnect) first\"))\n   383\t\n   384\t      :else (open-connection state url))))\n   385\t\n   386\t\n   387\t(defn- submit-remote\n   388\t  [state line]\n   389\t  (let [result (adapter/submit-input (:adapter state) line)\n   390\t        state (assoc state :adapter (:yin.repl.adapter/state result))]\n   391\t    (case (:yin.repl.adapter/outcome result)\n   392\t      :yin.repl.adapter/requested\n   393\t      (assoc state\n   394\t             :outstanding (get-in result [:yin.repl.adapter/rpc-result\n   395\t                                          :dao.stream.rpc/id])\n   396\t             :retrying nil)\n   397\t\n   398\t      ;; The request was allocated but the writer answered `full`.  The same\n   399\t      ;; encoded request, with the same id, is retried on a later step.\n   400\t      :yin.repl.adapter/pending-request\n   401\t      (assoc state :retrying line)\n   402\t\n   403\t      (-> state\n   404\t          (assoc :retrying nil)\n   405\t          (publish :yin.repl.driver/notice\n   406\t                   (str \";; request not sent: \"\n   407\t                        (name (:yin.repl.adapter/outcome result))))))))\n   408\t\n   409\t\n   410\t(defn- handle-line\n   411\t  [state line]\n   412\t  (let [command (adapter/local-command line)]\n   413\t    (cond\n   414\t      ;; A shell that has quit evaluates nothing more.  Hosts append an\n   415\t      ;; end-of-input `(quit)` that a typed `(quit)` has already answered.\n   416\t      (not (:running? state)) state\n   417\t\n   418\t      (not (string? line))\n   419\t      (publish state :yin.repl.driver/diagnostic\n   420\t               (str \";; ignored non-string input: \"\n   421\t                    (pr-str (data/summarize line diagnostic-bounds))))\n   422\t\n   423\t      (str/blank? line) state\n   424\t\n   425\t      ;; Local control commands bypass the remote queue, so a stuck or slow\n   426\t      ;; remote request cannot trap the operator.\n   427\t      (= 'connect command) (connect-command state line)\n   428\t\n   429\t      (= 'disconnect command) (disconnect state)\n   430\t\n   431\t      (= 'repl-state command)\n   432\t      (cond-> (evaluate-locally state line)\n   433\t        (:connection state)\n   434\t        (publish :yin.repl.driver/result\n   435\t                 (repl/format-value (connect/summary (:connection state)))))\n   436\t\n   437\t      (and (remote-routed? state) (not command))\n   438\t      (cond\n   439\t        ;; A dropped or ended remote evaluates nothing.  The line was never\n   440\t        ;; sent, so it waits for an explicit reattachment decision.\n   441\t        (remote-terminal state)\n   442\t        (-> state\n   443\t            (update :queued conj line)\n   444\t            (publish :yin.repl.driver/notice\n   445\t                     \";; not connected: queued until (connect …) reattaches\"))\n   446\t\n   447\t        ;; `:unsent` is the RPC client's own retained envelope, and the\n   448\t        ;; authority on whether the request path is free: submitting here would\n   449\t        ;; resend it and discard this line.  `:retrying` is only the driver's\n   450\t        ;; record of which line that envelope carries.  An unminted response\n   451\t        ;; cursor holds the line too: its answer could land before the cursor.\n   452\t        (or (:outstanding state) (:retrying state) (remote-unsent? state)\n   453\t            (response-cursor-unminted? state))\n   454\t        (update state :queued conj line)\n   455\t\n   456\t        :else (submit-remote state line))\n   457\t\n   458\t      :else (evaluate-locally state line))))\n   459\t\n   460\t\n   461\t;; =============================================================================\n   462\t;; Remote completions\n   463\t;; =============================================================================\n   464\t\n   465\t(defn- completion-text\n   466\t  [event]\n   467\t  (case (:yin.repl.adapter/event event)\n   468\t    :yin.repl.adapter/response\n   469\t    (if (contains? event :yin.repl.adapter/error)\n   470\t      (str \"Error: \" (repl/format-value (:yin.repl.adapter/error event)))\n   471\t      (let [value (:yin.repl.adapter/value event)]\n   472\t        (if (string? value) value (repl/format-value value))))\n   473\t\n   474\t    :yin.repl.adapter/lost\n   475\t    (str \";; remote request \" (:yin.repl.adapter/id event) \" lost: \"\n   476\t         (pr-str (data/summarize (:yin.repl.adapter/reason event) diagnostic-bounds)))\n   477\t\n   478\t    (str \";; \" (pr-str (data/summarize event diagnostic-bounds)))))\n   479\t\n   480\t\n   481\t(defn- completion-event-kind\n   482\t  [event]\n   483\t  (if (= :yin.repl.adapter/response (:yin.repl.adapter/event event))\n   484\t    :yin.repl.driver/response\n   485\t    :yin.repl.driver/notice))\n   486\t\n   487\t\n   488\t(defn- clears-outstanding?\n   489\t  [state event]\n   490\t  (and (:outstanding state)\n   491\t       (contains? #{:yin.repl.adapter/response :yin.repl.adapter/lost}\n   492\t                  (:yin.repl.adapter/event event))\n   493\t       (= (:outstanding state) (:yin.repl.adapter/id event))))\n   494\t\n   495\t\n   496\t(defn- publish-adapter-events\n   497\t  \"Move the adapter's event outbox into the driver's, exactly once.\"\n   498\t  [state]\n   499\t  (let [[events adapter] (adapter/take-events (:adapter state))]\n   500\t    (reduce (fn [state event]\n   501\t              (-> state\n   502\t                  (cond-> (clears-outstanding? state event)\n   503\t                    (assoc :outstanding nil))\n   504\t                  (publish (completion-event-kind event) (completion-text event))))\n   505\t            (assoc state :adapter adapter)\n   506\t            events)))\n   507\t\n   508\t\n   509\t(defn- poll-remote\n   510\t  [state]\n   511\t  (when-let [connection (:connection state)]\n   512\t    (connect/step! connection))\n   513\t  (if-not (:adapter state)\n   514\t    state\n   515\t    (let [result (adapter/poll-responses (:adapter state) response-budget)]\n   516\t      (publish-adapter-events (assoc state :adapter\n   517\t                                     (:yin.repl.adapter/state result))))))\n   518\t\n   519\t\n   520\t(defn- observe-connection\n   521\t  \"Publish the connection's terminal fact, observed from the RPC client's\n   522\t   own `:terminal` rather than a separate lifecycle stream: `attach!` over\n   523\t   `dao.stream.remote` answers ok at once, so `Connected to …` is published\n   524\t   by `open-connection`/`reattach` directly, not observed here.\"\n   525\t  [state]\n   526\t  (if-not (:connection state)\n   527\t    state\n   528\t    (let [[connection event] (connect/observe-terminal\n   529\t                               (:connection state) (remote-terminal state))]\n   530\t      (cond-> (assoc state :connection connection)\n   531\t        event (publish (get event connect/event-key)\n   532\t                       (get event connect/text-key))))))\n   533\t\n   534\t\n   535\t(defn- retry-unsent\n   536\t  \"The one path that resends a retained envelope.  It is owed only while RPC\n   537\t   still holds it: an abandoned request leaves nothing to retry, whatever the\n   538\t   driver last recorded.\"\n   539\t  [state]\n   540\t  (if (and (remote-routed? state)\n   541\t           (remote-unsent? state)\n   542\t           (:retrying state)\n   543\t           (not (remote-terminal state)))\n   544\t    (submit-remote state (:retrying state))\n   545\t    state))\n   546\t\n   547\t\n   548\t(defn- release-queue\n   549\t  [state]\n   550\t  (if (and (remote-routed? state)\n   551\t           (not (remote-terminal state))\n   552\t           (seq (:queued state))\n   553\t           (not (:outstanding state))\n   554\t           (not (:retrying state))\n   555\t           (not (remote-unsent? state))\n   556\t           (not (response-cursor-unminted? state)))\n   557\t    (let [[line & rest-lines] (:queued state)]\n   558\t      (-> state\n   559\t          (assoc :queued (vec rest-lines))\n   560\t          (submit-remote line)))\n   561\t    state))\n   562\t\n   563\t\n   564\t;; =============================================================================\n   565\t;; The step\n   566\t;; =============================================================================\n   567\t\n   568\t(defn repl-step\n   569\t  \"Advance the REPL once.  Called by exactly one ticker per host; never loops on\n   570\t   `:dao.stream/blocked`.  `now` is the host's clock reading, recorded but not\n   571\t   waited on: this layer has no deadline of its own.\"\n   572\t  [state now]\n   573\t  (let [state (assoc state :last-tick now)\n   574\t        state (retry-unsent state)\n   575\t        ;; Completions and lifecycle are observed before this tick's lines are\n   576\t        ;; handled, so a `(connect …)` typed in the same tick as the drop that\n   577\t        ;; makes it legal sees the terminal fact rather than being told the\n   578\t        ;; shell is already connected.\n   579\t        state (poll-remote state)\n   580\t        state (observe-connection state)\n   581\t        [state lines] (drain-input state)\n   582\t        state (reduce handle-line state lines)]\n   583\t    (release-queue state)))\n","exit_code":0,"status":"completed"}}
