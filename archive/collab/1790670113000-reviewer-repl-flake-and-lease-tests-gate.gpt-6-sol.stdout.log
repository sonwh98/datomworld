percent hex pair.  An encoded slash is not unreserved, so it stays encoded.\"\n   136\t  [s]\n   137\t  (let [n (count s)]\n   138\t    (loop [i 0\n   139\t           out []]\n   140\t      (if (>= i n)\n   141\t        (str/join out)\n   142\t        (let [c (at s i)\n   143\t              hi (when (< (+ i 2) n) (get hex-values (at s (+ i 1))))\n   144\t              lo (when (< (+ i 2) n) (get hex-values (at s (+ i 2))))]\n   145\t          (if (and (= \"%\" c) hi lo)\n   146\t            (let [decoded (octet->char (+ (* 16 hi) lo))]\n   147\t              (if (contains? unreserved decoded)\n   148\t                (recur (+ i 3) (conj out decoded))\n   149\t                (recur (+ i 3) (conj out (str \"%\" (str/upper-case (subs s (inc i) (+ i 3))))))))\n   150\t            (recur (inc i) (conj out c))))))))\n   151\t\n   152\t\n   153\t(defn- drop-last-segment\n   154\t  [out]\n   155\t  (if-let [i (str/last-index-of out \"/\")]\n   156\t    (subs out 0 i)\n   157\t    \"\"))\n   158\t\n   159\t\n   160\t(defn- next-segment-end\n   161\t  [s]\n   162\t  (or (str/index-of s \"/\" 1) (count s)))\n   163\t\n   164\t\n   165\t(defn- remove-dot-segments\n   166\t  \"RFC 3986's remove_dot_segments, so repeated slashes and a trailing slash stay\n   167\t   significant while `.` and `..` do not reach the exact served-path lookup.\"\n   168\t  [path]\n   169\t  (loop [in path\n   170\t         out \"\"]\n   171\t    (cond\n   172\t      (= \"\" in) out\n   173\t      (str/starts-with? in \"../\") (recur (subs in 3) out)\n   174\t      (str/starts-with? in \"./\") (recur (subs in 2) out)\n   175\t      (str/starts-with? in \"/./\") (recur (str \"/\" (subs in 3)) out)\n   176\t      (= \"/.\" in) (recur \"/\" out)\n   177\t      (str/starts-with? in \"/../\") (recur (str \"/\" (subs in 4)) (drop-last-segment out))\n   178\t      (= \"/..\" in) (recur \"/\" (drop-last-segment out))\n   179\t      (= \".\" in) (recur \"\" out)\n   180\t      (= \"..\" in) (recur \"\" out)\n