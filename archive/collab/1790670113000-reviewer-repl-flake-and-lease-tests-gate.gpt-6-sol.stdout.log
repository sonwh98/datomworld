=========\n   305\t\n   306\t(defn- mint\n   307\t  [handle anchor]\n   308\t  (let [result (stream/cursor handle anchor)]\n   309\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   310\t      (:dao.stream/cursor result))))\n   311\t\n   312\t\n   313\t(defn- remote-descriptor\n   314\t  [channel identity]\n   315\t  {:dao.stream/type :dao.stream/remote\n   316\t   :dao.stream/identity identity\n   317\t   :dao.stream/channel channel})\n   318\t\n   319\t\n   320\t(defn- attacher\n   321\t  [traffic connect!]\n   322\t  (ws/make-attacher {:traffic {:dao.stream/handle traffic\n   323\t                               :dao.stream/surface #{:writer}}\n   324\t                     :admission traffic-admission\n   325\t                     :connect! connect!}))\n   326\t\n   327\t\n   328\t(defn- attach-outcome-message\n   329\t  [url result]\n   330\t  (case (:dao.stream/outcome result)\n   331\t    :dao.stream/invalid-descriptor\n   332\t    (str \"The boundary refused the descriptor for \" url)\n   333\t\n   334\t    :dao.stream/transport-error\n   335\t    (str \"Could not start connecting to \" url\n   336\t         \"; this is a local reachability failure and may succeed on retry\")\n   337\t\n   338\t    (str \"Attaching to \" url \" answered \" (pr-str (:dao.stream/outcome result)))))\n   339\t\n   340\t\n   341\t(defn- fresh-dial\n   342\t  \"Compose one dial over a fresh traffic medium, its own fresh `attach!`\n   343\t   bound to that medium, and a fresh channel ring, before any attach.  A\n   344\t   reattachment composes a fresh dial with a fresh cursor, per\n   345\t   `dao.stream.ws-project/dial`'s own contract, and `attach!` is scoped to\n   346\t   the traffic medium it deposits into, so it must be rebuilt alongside\n   347\t   it -- reusing an old `attach!` over a new traffic medium would deposit\n   348\t   into the wrong buffer.\"\n   349\t  [host]\n   350\t  (let [traffic (:dao.stream/handle\n   351\t                  (ring/create! {:dao.stream/type ring/transport-type\n   352\t                                 ring/capacity-key traffic-capacity}))\n   353\t        attach! (try (attacher traffic (:connect! host))\n   354\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) _ nil))\n   355\t        cursor (mint traffic stream/anchor-newest)\n   356\t        ring (:dao.stream/handle\n   357\t               (ring/create! {:dao.stream/type ring/transport-type\n   358\t                              ring/capacity-key traffic-capacity}))]\n   359\t    (when (and (some? attach!) (some? cursor))\n   360\t      (ws-project/dial {:attach! attach!\n   361\t                        :traffic {:dao.stream/handle traffic}\n   362\t                        :cursor cursor\n   363\t                        :ring ring\n   364\t                        :table {}}))))\n   365\t\n   366\t\n   367\t(defn- attach-pair\n   368\t  \"Attach both `requests`/`answers` reflections through `dial`'s one link,\n   369\t   sharing it exactly as `dao.stream.remote.cljc`'s attacher requires.\n   370\t   Returns `[requests-result answers-result]`, the second nil once the\n   371\t   first fails.\"\n   372\t  [dial channel]\n   373\t  (let [requests-result\n   374\t        (ws-project/dial-attach! dial (remote-descriptor channel\n   375\t                                                         requests-identity))]\n   376\t    (if-not (= :dao.stream/ok (:dao.stream/outcome requests-result))\n   377\t      [requests-result nil]\n   378\t      [requests-result\n   379\t       (ws-project/dial-reflect! dial (remote-descriptor channel\n   380\t                                                         answers-identity))])))\n   381\t\n   382\t\n   383\t(defn open\n   384\t  \"Dial one WebSocket channel and attach both reflections, returning\n   385\t   immediately.  `attach!` over `dao.stream.remote` answers ok at once --\n   386\t   the contract's deferred remote confirmation -- so a successful result\n   387\t   is reported `:established` without waiting on any further transport\n   388\t   event.  The RPC client's response cursor is the `:dao.stream/newest`\n   389\t   anchor; `rpc/poll!` resolves it, retrying while the answers reflection\n   390\t   answers a retryable mint.\"\n   391\t  [{:keys [url identity host]}]\n   392\t  (let [parsed (parse-url url {:identity identity})]\n   393\t    (if-not (= :yin.repl.connect/parsed (get parsed outcome-key))\n   394\t      parsed\n   395\t      (let [channel (get parsed descriptor-key)]\n   396\t        (if-not (host-common/adapter? host)\n   397\t          (failure :yin.repl.connect/no-host-adapter\n   398\t                   (host-common/missing-message \"(connect …) is not wired\"))\n   399\t          (let [dial (fresh-dial host)]\n   400\t            (if-not dial\n   401\t              (failure :yin.repl.connect/invalid-composition\n   402\t                       \"The client boundary composition was refused\")\n   403\t              (let [[requests-result answers-result]\n   404\t                    (attach-pair dial channel)]\n   405\t                (cond\n   406\t                  (not= :dao.stream/ok (:dao.stream/outcome requests-result))\n   407\t                  (failure :yin.repl.connect/attach-failed\n   408\t                           (attach-outcome-message url requests-result))\n   409\t\n   410\t                  (not= :dao.stream/ok (:dao.stream/outcome answers-result))\n   411\t                  (failure :yin.repl.connect/attach-failed\n   412\t                           (attach-outcome-message url answers-result))\n   413\t\n   414\t                  :else\n   415\t                  {outcome-key :yin.repl.connect/attached\n   416\t                   connection-key {:url url\n   417\t                                   :channel channel\n   418\t                                   :host host\n   419\t                                   :dial dial\n   420\t                                   :status :established\n   421\t                                   :detached-by nil}\n   422\t                   client-key (rpc/client-state\n   423\t                                (:dao.stream/handle requests-result)\n   424\t                                (:dao.stream/handle answers-result)\n   425\t                                stream/anchor-newest)})))))))))\n   426\t\n   427\t\n   428\t(defn step!\n   429\t  \"Drive this connection's dial one tick: its projection, so wire bytes the\n   430\t   host deposited onto the traffic medium reach the reflections' local\n   431\t   channel ring, then this end's own mirror step (a REPL client serves\n   432\t   nothing through it, but the composition is symmetric).  A caller's own\n   433\t   cadence must call this every tick it also polls the RPC client, or the\n   434\t   channel ring never receives anything the server sent -- reading a\n   435\t   reflection drains only the ring, never the traffic medium directly.\"\n   436\t  [connection]\n   437\t  (when-let [dial (:dial connection)]\n   438\t    (ws-project/dial-step! dial))\n   439\t  connection)\n   440\t\n   441\t\n   442\t(def terminal-statuses\n   443\t  \"Statuses observed from the RPC client's own `:terminal`.  They are\n   444\t   conclusions, so a later local action cannot overwrite them with an\n   445\t   intention.\"\n   446\t  #{:detached :ended :not-found :transport-error})\n   447\t\n   448\t\n   449\t(defn close!\n   450\t  \"Disconnect.  `close!` on the dialed channel's handle ends the connection;\n   451\t   the RPC client observes the loss on its next poll as `/detached`, which\n   452\t   is what keeps the connection reattachable.\n   453\t\n   454\t   Who asked is recorded, because the two detachments mean different things to\n   455\t   the shell: an operator `(disconnect)` returns ordinary input to local\n   456\t   evaluation, while an uninvited drop queues it until a reattachment decision\n   457\t   is made.  The terminal fact alone cannot tell them apart.\n   458\t\n   459\t   A status already observed is kept: `:closing` describes an intention, and\n   460\t   replacing an observed ending with it would lose the only record of how the\n   461\t   connection actually ended.\"\n   462\t  ([connection] (close! connection :operator))\n   463\t  ([connection by]\n   464\t   (when-let [ch (some-> (:dial connection) ws-project/channel)]\n   465\t     (stream/close! (:handle ch)))\n   466\t   (cond-> (assoc connection :detached-by by)\n   467\t     (not (contains? terminal-statuses (:status connection)))\n   468\t     (assoc :status :closing))))\n   469\t\n   470\t\n   471\t(defn operator-detached?\n   472\t  \"True while this connection is detached, or detaching, at the operator's own\n   473\t   request.\"\n   474\t  [connection]\n   475\t  (= :operator (:detached-by connection)))\n    45\t  [handle]\n    46\t  (loop [cursor (oldest-cursor handle)\n    47\t         out []]\n    48\t    (let [read (ds/next handle cursor)]\n    49\t      (if (= :dao.stream/ok (:dao.stream/outcome read))\n    50\t        (recur (:dao.stream/cursor read) (conj out (:dao.stream/value read)))\n    51\t        out))))\n    52\t\n    53\t\n    54\t(defn- append-ok!\n    55\t  [handle value]\n    56\t  (let [result (ds/append! handle value)]\n    57\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n    58\t      (throw (ex-info \"test append failed\" {:result result :value value})))\n    59\t    handle))\n    60\t\n    61\t\n    62\t(defn- resolver\n    63\t  \"The composition's attribution: per-author media identity by default\n    64\t  (see the attachment-identity sketch for the :ws/attachment binding).\"\n    65\t  [source _fact]\n    66\t  source)\n    67\t\n    68\t\n    69\t(defn- fake-writer\n    70\t  \"A writer whose every append answers one outcome -- the ring buffer\n    71\t  evicts instead of answering :full, so the non-ok :lapsed append cases\n    72\t  need a scripted writer.\"\n    73\t  [outcome]\n    74\t  (reify\n    75\t    ds/IDaoStreamWriter\n    76\t    (append!\n    77\t      [_ _val]\n    78\t      {:dao.stream/outcome outcome})))\n    79\t\n    80\t\n    81\t(def standard-medium\n    82\t  \"The reference declaration for a per-author fact medium, with an honest\n    83\t  capacity matching its test handle (r4-r3/F1: no capacity is derived\n    84\t  against the drain budget -- a larger budget is the safe case).\"\n    85\t  {:retention :evict-oldest\n    86\t   :capacity 8\n    87\t   :value-domain :portable-values\n    88\t   :attribution :per-author-media})\n    89\t\n    90\t\n    91\t(defn- judge-config\n    92\t  \"A valid make-judge config over fresh ring buffers, then overrides.\"\n    93\t  [overrides]\n    94\t  (let [ticks (new-buffer 8)\n    95\t        facts (new-buffer 8)\n    96\t        writer (new-buffer 8)\n    97\t        base {:cadence {:ms 5}\n    98\t              :units {:ms 1}\n    99\t              :tolerance {:ms 0}\n   100\t              :resolver resolver\n   101\t              :resolver-bindings #{:per-author-media}\n   102\t              :reclaim (fn [_] true)\n   103\t              :writer writer\n   104\t              :self :grantor\n   105\t              :ticks [{:handle ticks :cursor (oldest-cursor ticks)}]\n   106\t              :media [{:handle facts\n   107\t                       :cursor (oldest-cursor facts)\n   108\t                       :source :holder-a\n   109\t                       :medium standard-medium}]}]\n   110\t    (merge base overrides)))\n   111\t\n   112\t\n   113\t(defn- holder-config\n   114\t  \"A valid make-holder config over a fresh fact medium, then overrides.\"\n   115\t  [overrides]\n   116\t  (let [facts (new-buffer 8)\n   117\t        ticks (new-buffer 8)\n   118\t        outbound (new-buffer 8)\n   119\t        base {:self :holder-a\n   120\t              :grantor :grantor\n   121\t              :units {:ms 1}\n   122\t              :resolver resolver\n   123\t              :resolver-bindings #{:per-author-media}\n   124\t              :renewal-interval {:ms 4}\n   125\t              :tick {:handle ticks :cursor (oldest-cursor ticks)}\n","exit_code":0,"status":"completed"}}
