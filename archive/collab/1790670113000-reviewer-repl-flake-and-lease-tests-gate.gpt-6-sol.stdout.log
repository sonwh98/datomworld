own retained envelope, and the\nsrc/cljc/yin/repl/driver.cljc:452:        (or (:outstanding state) (:retrying state) (remote-unsent? state)\nsrc/cljc/yin/repl/driver.cljc:535:(defn- retry-unsent\nsrc/cljc/yin/repl/driver.cljc:541:           (remote-unsent? state)\nsrc/cljc/yin/repl/driver.cljc:555:           (not (remote-unsent? state))\nsrc/cljc/yin/repl/driver.cljc:574:        state (retry-unsent state)\nsrc/cljc/yin/repl/serve.cljc:184:     :cursor (mint traffic stream/anchor-newest)\nsrc/cljc/yin/repl/serve.cljc:732:     :lifecycle {:cursor (:lifecycle-cursor endpoint)\nsrc/cljc/yin/repl/link.cljc:102:     :cursor (:dao.stream/cursor\nsrc/cljc/yin/repl/link.cljc:112:   `{:requests w :answers r :cursor c}` on a connection whose far end\nsrc/cljc/yin/repl/link.cljc:187:                             :cursor (newest responses)}\nsrc/cljc/yin/repl/link.cljc:281:       (let [r (stream/next (:requests pair) (:cursor pair))]\nsrc/cljc/yin/repl/link.cljc:290:               (recur (assoc pair :cursor (:dao.stream/cursor r))\nsrc/cljc/yin/repl/connect.cljc:362:                        :cursor cursor\nsrc/cljc/yin/repl/connect.cljc:383:(defn open\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/lease_composition_test.cljc | sed -n '1,180p;780,900p'; rg -n 'defn (make-judge|wire-declared-facts)|:self|:source' src/cljc/dao/lease.cljc\"","aggregated_output":"     1\t(ns dao.lease-composition-test\n     2\t  \"Composition deftests for dao.lease Phase 4 (C1-C8), per the revised\n     3\t  implementation plan's §4.4 prove list: the refusal matrix, the\n     4\t  process-scoped fallback, the end-to-end grant->renew->lapse cycle\n     5\t  through make-judge with a hand-turned tick stream, the non-ok :lapsed\n     6\t  append leaving the lease pending, and the use-case sketches as\n     7\t  commented compositions -- runnable wirings, not products.\n     8\t\n     9\t  Everything is scripted as in lease_test: hand-appended ticks and facts\n    10\t  over ring buffers, per-author-media attribution, no host clock anywhere\n    11\t  in this file (the reference tick driver and its host clock live in\n    12\t  lease_test, the test tree's host policy). The served-entry sketch\n    13\t  drives a real dao.stream.remote reflection over two in-process ring\n    14\t  buffers as the channel (docs/design/dao.stream.remote.md section 5).\"\n    15\t  (:require [clojure.test :refer [deftest is testing]]\n    16\t            [dao.lease :as lease]\n    17\t            [dao.stream :as ds]\n    18\t            [dao.stream.remote :as remote]\n    19\t            [dao.stream.ringbuffer :as ringbuffer]))\n    20\t\n    21\t\n    22\t;; =============================================================================\n    23\t;; Harness\n    24\t;; =============================================================================\n    25\t\n    26\t(defn- new-buffer\n    27\t  [capacity]\n    28\t  (let [result (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n    29\t                                    ringbuffer/capacity-key capacity})]\n    30\t    (if (= :dao.stream/ok (:dao.stream/outcome result))\n    31\t      (:dao.stream/handle result)\n    32\t      (throw (ex-info \"test buffer creation failed\" {:result result})))))\n    33\t\n    34\t\n    35\t(defn- oldest-cursor\n    36\t  [handle]\n    37\t  (let [minted (ds/cursor handle ds/anchor-oldest)]\n    38\t    (if (= :dao.stream/ok (:dao.stream/outcome minted))\n    39\t      (:dao.stream/cursor minted)\n    40\t      (throw (ex-info \"test cursor mint failed\" {:result minted})))))\n    41\t\n    42\t\n    43\t(defn- drain-values\n    44\t  \"Every value currently retained on handle, oldest first.\"\n    45\t  [handle]\n    46\t  (loop [cursor (oldest-cursor handle)\n    47\t         out []]\n    48\t    (let [read (ds/next handle cursor)]\n    49\t      (if (= :dao.stream/ok (:dao.stream/outcome read))\n    50\t        (recur (:dao.stream/cursor read) (conj out (:dao.stream/value read)))\n    51\t        out))))\n    52\t\n    53\t\n    54\t(defn- append-ok!\n    55\t  [handle value]\n    56\t  (let [result (ds/append! handle value)]\n    57\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n    58\t      (throw (ex-info \"test append failed\" {:result result :value value})))\n    59\t    handle))\n    60\t\n    61\t\n    62\t(defn- resolver\n    63\t  \"The composition's attribution: per-author media identity by default\n    64\t  (see the attachment-identity sketch for the :ws/attachment binding).\"\n    65\t  [source _fact]\n    66\t  source)\n    67\t\n    68\t\n    69\t(defn- fake-writer\n    70\t  \"A writer whose every append answers one outcome -- the ring buffer\n    71\t  evicts instead of answering :full, so the non-ok :lapsed append cases\n    72\t  need a scripted writer.\"\n    73\t  [outcome]\n    74\t  (reify\n    75\t    ds/IDaoStreamWriter\n    76\t    (append!\n    77\t      [_ _val]\n    78\t      {:dao.stream/outcome outcome})))\n    79\t\n    80\t\n    81\t(def standard-medium\n    82\t  \"The reference declaration for a per-author fact medium, with an honest\n    83\t  capacity matching its test handle (r4-r3/F1: no capacity is derived\n    84\t  against the drain budget -- a larger budget is the safe case).\"\n    85\t  {:retention :evict-oldest\n    86\t   :capacity 8\n    87\t   :value-domain :portable-values\n    88\t   :attribution :per-author-media})\n    89\t\n    90\t\n    91\t(defn- judge-config\n    92\t  \"A valid make-judge config over fresh ring buffers, then overrides.\"\n    93\t  [overrides]\n    94\t  (let [ticks (new-buffer 8)\n    95\t        facts (new-buffer 8)\n    96\t        writer (new-buffer 8)\n    97\t        base {:cadence {:ms 5}\n    98\t              :units {:ms 1}\n    99\t              :tolerance {:ms 0}\n   100\t              :resolver resolver\n   101\t              :resolver-bindings #{:per-author-media}\n   102\t              :reclaim (fn [_] true)\n   103\t              :writer writer\n   104\t              :self :grantor\n   105\t              :ticks [{:handle ticks :cursor (oldest-cursor ticks)}]\n   106\t              :media [{:handle facts\n   107\t                       :cursor (oldest-cursor facts)\n   108\t                       :source :holder-a\n   109\t                       :medium standard-medium}]}]\n   110\t    (merge base overrides)))\n   111\t\n   112\t\n   113\t(defn- holder-config\n   114\t  \"A valid make-holder config over a fresh fact medium, then overrides.\"\n   115\t  [overrides]\n   116\t  (let [facts (new-buffer 8)\n   117\t        ticks (new-buffer 8)\n   118\t        outbound (new-buffer 8)\n   119\t        base {:self :holder-a\n   120\t              :grantor :grantor\n   121\t              :units {:ms 1}\n   122\t              :resolver resolver\n   123\t              :resolver-bindings #{:per-author-media}\n   124\t              :renewal-interval {:ms 4}\n   125\t              :tick {:handle ticks :cursor (oldest-cursor ticks)}\n   126\t              :fact {:handle facts\n   127\t                     :cursor (oldest-cursor facts)\n   128\t                     :source :grantor\n   129\t                     :medium standard-medium}\n   130\t              :writer {:handle outbound\n   131\t                       :medium standard-medium}}]\n   132\t    (merge base overrides)))\n   133\t\n   134\t\n   135\t(defn- refusal-key\n   136\t  \"The :refused key of the assembly refusal's ex-data, or :assembled when\n   137\t  the constructor succeeded. Every composition refusal names the seam it\n   138\t  refused under an explicit :refused key -- no map key-order dependence\n   139\t  (r4-P3).\"\n   140\t  [config]\n   141\t  (try (lease/make-judge config) :assembled\n   142\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   143\t         (:refused (ex-data e)))))\n   144\t\n   145\t\n   146\t(defn- holder-refusal-key\n   147\t  [config]\n   148\t  (try (lease/make-holder config) :assembled\n   149\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   150\t         (:refused (ex-data e)))))\n   151\t\n   152\t\n   153\t(defn- composed\n   154\t  \"A make-judge system over ring buffers, driven by hand: fresh\n   155\t  ticks/facts/writer, the composed judge's :step/:judge on the map, and\n   156\t  the Phase 2 driving helpers re-keyed to it.\"\n   157\t  [options]\n   158\t  (let [ticks (new-buffer 16)\n   159\t        facts (new-buffer 16)\n   160\t        writer (new-buffer 16)\n   161\t        composed (lease/make-judge\n   162\t                   {:cadence {:ms 5}\n   163\t                    :units {:ms 1}\n   164\t                    :tolerance (get options :tolerance {:ms 0})\n   165\t                    :resolver (get options :resolver resolver)\n   166\t                    :resolver-bindings\n   167\t                    (get options :resolver-bindings #{:per-author-media})\n   168\t                    :reclaim (get options :reclaim (fn [_] true))\n   169\t                    :writer writer\n   170\t                    :self :grantor\n   171\t                    :ticks [{:handle ticks :cursor (oldest-cursor ticks)}]\n   172\t                    :media [{:handle facts\n   173\t                             :cursor (oldest-cursor facts)\n   174\t                             :source :holder-a\n   175\t                             :medium (get options :medium standard-medium)}]})]\n   176\t    {:ticks ticks\n   177\t     :facts facts\n   178\t     :writer writer\n   179\t     :composed composed\n   180\t     :judge (:judge composed)}))\n   780\t(defn- wiring-refusal-key\n   781\t  [judge entry]\n   782\t  (try (lease/wire-declared-facts judge entry) :wired\n   783\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   784\t         (:refused (ex-data e)))))\n   785\t\n   786\t\n   787\t(deftest wire-declared-facts-test\n   788\t  (testing \"a medium wired after assembly is validated as make-judge\n   789\t            validates, keeps its declaration, and its facts count\"\n   790\t    (let [renewals (new-buffer 8)\n   791\t          entry {:handle renewals\n   792\t                 :cursor (oldest-cursor renewals)\n   793\t                 :source :holder-b\n   794\t                 :medium standard-medium}\n   795\t          system (-> (composed {})\n   796\t                     (update :judge lease/wire-declared-facts entry)\n   797\t                     (update :judge lease/author-grant\n   798\t                             (lease/grant :l2 :db :holder-b {:ms 10}))\n   799\t                     (tick! 1)\n   800\t                     step!)]\n   801\t      (is (= [:holder-a :holder-b] (mapv :source (get-in system [:judge :facts]))))\n   802\t      (is (= standard-medium (:medium (peek (get-in system [:judge :facts]))))\n   803\t          \"the declaration rides the wired entry\")\n   804\t      (append-ok! renewals (lease/renewal :l2))\n   805\t      (let [system (-> system (tick! 6) step!)]\n   806\t        (is (= {:ms 6} (get-in system [:judge :ledger :l2 :last-observation]))\n   807\t            \"a renewal on the medium wired later counts for its holder\"))))\n   808\t  (testing \"each invalid wiring is refused under the seam it names, wiring\n   809\t            nothing\"\n   810\t    (let [judge (:judge (composed {}))\n   811\t          b (new-buffer 8)\n   812\t          good {:handle b :cursor (oldest-cursor b) :source :holder-b\n   813\t                :medium standard-medium}]\n   814\t      (doseq [[expected entry]\n   815\t              [[:medium-entry (dissoc good :cursor)]\n   816\t               [:medium-entry (dissoc good :source)]\n   817\t               [:medium (dissoc good :medium)]\n   818\t               [:medium (update good :medium dissoc :retention)]\n   819\t               [:medium (assoc-in good [:medium :capacity] 0)]\n   820\t               [:medium (assoc-in good [:medium :value-domain] :anything)]\n   821\t               [:attribution (assoc-in good [:medium :attribution] :envelope-key)]]]\n   822\t        (is (= expected (wiring-refusal-key judge entry))\n   823\t            (str \"refused under \" expected)))\n   824\t      (is (= :wired (wiring-refusal-key judge good)))\n   825\t      (is (= :host-values\n   826\t             (wiring-refusal-key\n   827\t               (:judge (lease/make-judge\n   828\t                         (judge-config {:durable? true\n   829\t                                        :durable-judge :dj\n   830\t                                        :incarnation-rule :ir\n   831\t                                        :fencing :f})))\n   832\t               (assoc-in good [:medium :value-domain] :host-values)))\n   833\t          \"a durable judge refuses a host-values medium, as at assembly\")\n   834\t      (is (= :resolver-bindings\n   835\t             (wiring-refusal-key\n   836\t               (lease/initial-judge {:resolver resolver :self :grantor})\n   837\t               good))\n   838\t          \"a judge not assembled by make-judge has no bindings to check against\"))))\n   839\t\n   840\t\n   841\t(deftest a-judge-wires-and-reads-its-own-grantor-authored-medium-test\n   842\t  (testing \"source authority lives at the composition boundary, not in\n   843\t            dao.lease: a medium attributed to the judge's own :self is its\n   844\t            own ledger, wired at assembly or after, and its grants count\"\n   845\t    (let [ledger (new-buffer 8)\n   846\t          own {:handle ledger\n   847\t               :cursor (oldest-cursor ledger)\n   848\t               :source :grantor\n   849\t               :medium standard-medium}\n   850\t          config (judge-config {})\n   851\t          assembled (lease/make-judge\n   852\t                      (update config :media conj own))\n   853\t          wired (lease/wire-declared-facts\n   854\t                  (:judge (lease/make-judge config)) own)]\n   855\t      (is (= [:holder-a :grantor] (mapv :source (get-in assembled [:judge :facts])))\n   856\t          \"make-judge wires a medium sourced as its own :self\")\n   857\t      (is (= [:holder-a :grantor] (mapv :source (:facts wired)))\n   858\t          \"wire-declared-facts wires one after assembly\")\n   859\t      (append-ok! ledger (lease/grant :l1 :db :holder-a {:ms 10}))\n   860\t      (append-ok! (get-in config [:ticks 0 :handle]) (lease/tick {:ms 1}))\n   861\t      (doseq [[how judge] [[:assembled (:judge assembled)] [:wired wired]]]\n   862\t        (testing (str how \": the grant it reads there seeds tenure\")\n   863\t          (let [judge ((:step assembled) judge)]\n   864\t            (is (= {:ms 1} (get-in judge [:ledger :l1 :tenure-start])))\n   865\t            (is (= :holder-a (get-in judge [:ledger :l1 :holder]))\n   866\t                \"the lease's holder is the one the grant names\")))))))\n   867\t\n   868\t\n   869\t(deftest unwire-facts-test\n   870\t  (testing \"unwiring removes exactly that medium, idempotently, and its\n   871\t            facts no longer reach the pass\"\n   872\t    (let [renewals (new-buffer 8)\n   873\t          other (new-buffer 8)\n   874\t          system (-> (composed {})\n   875\t                     (update :judge lease/wire-declared-facts\n   876\t                             {:handle renewals :cursor (oldest-cursor renewals)\n   877\t                              :source :holder-b :medium standard-medium})\n   878\t                     (update :judge lease/wire-declared-facts\n   879\t                             {:handle other :cursor (oldest-cursor other)\n   880\t                              :source :holder-c :medium standard-medium})\n   881\t                     (update :judge lease/author-grant\n   882\t                             (lease/grant :l2 :db :holder-b {:ms 10}))\n   883\t                     (tick! 1)\n   884\t                     step!)\n   885\t          unwired (lease/unwire-facts (:judge system) renewals)]\n   886\t      (is (= [:holder-a :holder-c] (mapv :source (:facts unwired)))\n   887\t          \"exactly that medium, the others in order\")\n   888\t      (is (= unwired (lease/unwire-facts unwired renewals)) \"idempotent\")\n   889\t      (is (= (:ledger (:judge system)) (:ledger unwired))\n   890\t          \"the ledger is untouched\")\n   891\t      (append-ok! renewals (lease/renewal :l2))\n   892\t      (let [system (-> (assoc system :judge unwired) (tick! 6) step!)]\n   893\t        (is (= {:ms 1} (get-in system [:judge :ledger :l2 :last-observation]))\n   894\t            \"the unwired medium's renewal never reached the pass\")))))\n   895\t\n   896\t\n   897\t;; C5/C6/C7 are pinned outside the runtime tests, as the plan's §7 states:\n   898\t;; no timer or clock call exists in src/cljc/dao/lease.cljc (the grep),\n   899\t;; dao.lease requires dao.stream and never the reverse (by construction),\n   900\t;; and no machinery renews on a holder's behalf (the holder section has no\n642:  :self          the author value the resolver returns for this grantor\n674:    ;; A nil :self would make the resolver's nil answer -- the natural\n678:    (check-assembly! (some? (get config :self))\n679:                     \"the judge needs its own author identity: the :self its attribution returns for it, never nil\"\n680:                     {:self (get config :self) :refused :self})\n706:     :self (get config :self)\n729:                             :source source}))\n745:                             :source source}))\n987:      (if (= author (:self judge))\n996:      (if (= author (:self judge))\n1017:      (if (= author (:self judge))\n1078:                 (resolve-author judge (:source entry) value))\n1566:  :self              this holder's identity -- the :dao.lease/holder value\n1598:                     {:self self})\n1623:    {:self self\n1742:  (`:dao.lease/holder` = `:self`) whose author, by the composition's\n1779:           (= (:self holder) (get fact :dao.lease/holder))\n1905:                         {:self (:self holder)})\n2102:  assembly: the entry is `{:handle :cursor :source :medium}` and its\n2108:                        (some? (:source entry)))\n2109:                   \"each fact medium is wired {:handle :cursor :source :medium}\"\n2120:      (wire-facts (:handle entry) (:cursor entry) (:source entry))\n2128:(defn make-judge\n2131:  :drain-budget :resolver :reclaim :policy :writer :self :answer -- of\n2132:  which :self and the tolerance are as required here as there):\n2147:  :media             required, non-empty: `[{:handle :cursor :source\n2218:          judge (reduce (fn [j t] (wire-tick j (:handle t) (:cursor t) (get t :source)))\n2227:(defn wire-declared-facts\n2231:  `entry` is `{:handle :cursor :source :medium declaration}`, validated\n2266:  Config, beyond `initial-holder`'s own seams (:self :grantor :resolver\n2271:  :fact              required: `{:handle :cursor :source :medium\n2304:                          (some? (:source fact)))\n2305:                     \"the holder is wired the medium it reads its facts from: {:handle :cursor :source :medium}\"\n","exit_code":0,"status":"completed"}}
