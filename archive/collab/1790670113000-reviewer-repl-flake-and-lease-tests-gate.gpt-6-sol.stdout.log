{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/driver.cljc | sed -n '425,620p'\"","aggregated_output":"   425\t      ;; Local control commands bypass the remote queue, so a stuck or slow\n   426\t      ;; remote request cannot trap the operator.\n   427\t      (= 'connect command) (connect-command state line)\n   428\t\n   429\t      (= 'disconnect command) (disconnect state)\n   430\t\n   431\t      (= 'repl-state command)\n   432\t      (cond-> (evaluate-locally state line)\n   433\t        (:connection state)\n   434\t        (publish :yin.repl.driver/result\n   435\t                 (repl/format-value (connect/summary (:connection state)))))\n   436\t\n   437\t      (and (remote-routed? state) (not command))\n   438\t      (cond\n   439\t        ;; A dropped or ended remote evaluates nothing.  The line was never\n   440\t        ;; sent, so it waits for an explicit reattachment decision.\n   441\t        (remote-terminal state)\n   442\t        (-> state\n   443\t            (update :queued conj line)\n   444\t            (publish :yin.repl.driver/notice\n   445\t                     \";; not connected: queued until (connect …) reattaches\"))\n   446\t\n   447\t        ;; `:unsent` is the RPC client's own retained envelope, and the\n   448\t        ;; authority on whether the request path is free: submitting here would\n   449\t        ;; resend it and discard this line.  `:retrying` is only the driver's\n   450\t        ;; record of which line that envelope carries.  An unminted response\n   451\t        ;; cursor holds the line too: its answer could land before the cursor.\n   452\t        (or (:outstanding state) (:retrying state) (remote-unsent? state)\n   453\t            (response-cursor-unminted? state))\n   454\t        (update state :queued conj line)\n   455\t\n   456\t        :else (submit-remote state line))\n   457\t\n   458\t      :else (evaluate-locally state line))))\n   459\t\n   460\t\n   461\t;; =============================================================================\n   462\t;; Remote completions\n   463\t;; =============================================================================\n   464\t\n   465\t(defn- completion-text\n   466\t  [event]\n   467\t  (case (:yin.repl.adapter/event event)\n   468\t    :yin.repl.adapter/response\n   469\t    (if (contains? event :yin.repl.adapter/error)\n   470\t      (str \"Error: \" (repl/format-value (:yin.repl.adapter/error event)))\n   471\t      (let [value (:yin.repl.adapter/value event)]\n   472\t        (if (string? value) value (repl/format-value value))))\n   473\t\n   474\t    :yin.repl.adapter/lost\n   475\t    (str \";; remote request \" (:yin.repl.adapter/id event) \" lost: \"\n   476\t         (pr-str (data/summarize (:yin.repl.adapter/reason event) diagnostic-bounds)))\n   477\t\n   478\t    (str \";; \" (pr-str (data/summarize event diagnostic-bounds)))))\n   479\t\n   480\t\n   481\t(defn- completion-event-kind\n   482\t  [event]\n   483\t  (if (= :yin.repl.adapter/response (:yin.repl.adapter/event event))\n   484\t    :yin.repl.driver/response\n   485\t    :yin.repl.driver/notice))\n   486\t\n   487\t\n   488\t(defn- clears-outstanding?\n   489\t  [state event]\n   490\t  (and (:outstanding state)\n   491\t       (contains? #{:yin.repl.adapter/response :yin.repl.adapter/lost}\n   492\t                  (:yin.repl.adapter/event event))\n   493\t       (= (:outstanding state) (:yin.repl.adapter/id event))))\n   494\t\n   495\t\n   496\t(defn- publish-adapter-events\n   497\t  \"Move the adapter's event outbox into the driver's, exactly once.\"\n   498\t  [state]\n   499\t  (let [[events adapter] (adapter/take-events (:adapter state))]\n   500\t    (reduce (fn [state event]\n   501\t              (-> state\n   502\t                  (cond-> (clears-outstanding? state event)\n   503\t                    (assoc :outstanding nil))\n   504\t                  (publish (completion-event-kind event) (completion-text event))))\n   505\t            (assoc state :adapter adapter)\n   506\t            events)))\n   507\t\n   508\t\n   509\t(defn- poll-remote\n   510\t  [state]\n   511\t  (when-let [connection (:connection state)]\n   512\t    (connect/step! connection))\n   513\t  (if-not (:adapter state)\n   514\t    state\n   515\t    (let [result (adapter/poll-responses (:adapter state) response-budget)]\n   516\t      (publish-adapter-events (assoc state :adapter\n   517\t                                     (:yin.repl.adapter/state result))))))\n   518\t\n   519\t\n   520\t(defn- observe-connection\n   521\t  \"Publish the connection's terminal fact, observed from the RPC client's\n   522\t   own `:terminal` rather than a separate lifecycle stream: `attach!` over\n   523\t   `dao.stream.remote` answers ok at once, so `Connected to …` is published\n   524\t   by `open-connection`/`reattach` directly, not observed here.\"\n   525\t  [state]\n   526\t  (if-not (:connection state)\n   527\t    state\n   528\t    (let [[connection event] (connect/observe-terminal\n   529\t                               (:connection state) (remote-terminal state))]\n   530\t      (cond-> (assoc state :connection connection)\n   531\t        event (publish (get event connect/event-key)\n   532\t                       (get event connect/text-key))))))\n   533\t\n   534\t\n   535\t(defn- retry-unsent\n   536\t  \"The one path that resends a retained envelope.  It is owed only while RPC\n   537\t   still holds it: an abandoned request leaves nothing to retry, whatever the\n   538\t   driver last recorded.\"\n   539\t  [state]\n   540\t  (if (and (remote-routed? state)\n   541\t           (remote-unsent? state)\n   542\t           (:retrying state)\n   543\t           (not (remote-terminal state)))\n   544\t    (submit-remote state (:retrying state))\n   545\t    state))\n   546\t\n   547\t\n   548\t(defn- release-queue\n   549\t  [state]\n   550\t  (if (and (remote-routed? state)\n   551\t           (not (remote-terminal state))\n   552\t           (seq (:queued state))\n   553\t           (not (:outstanding state))\n   554\t           (not (:retrying state))\n   555\t           (not (remote-unsent? state))\n   556\t           (not (response-cursor-unminted? state)))\n   557\t    (let [[line & rest-lines] (:queued state)]\n   558\t      (-> state\n   559\t          (assoc :queued (vec rest-lines))\n   560\t          (submit-remote line)))\n   561\t    state))\n   562\t\n   563\t\n   564\t;; =============================================================================\n   565\t;; The step\n   566\t;; =============================================================================\n   567\t\n   568\t(defn repl-step\n   569\t  \"Advance the REPL once.  Called by exactly one ticker per host; never loops on\n   570\t   `:dao.stream/blocked`.  `now` is the host's clock reading, recorded but not\n   571\t   waited on: this layer has no deadline of its own.\"\n   572\t  [state now]\n   573\t  (let [state (assoc state :last-tick now)\n   574\t        state (retry-unsent state)\n   575\t        ;; Completions and lifecycle are observed before this tick's lines are\n   576\t        ;; handled, so a `(connect …)` typed in the same tick as the drop that\n   577\t        ;; makes it legal sees the terminal fact rather than being told the\n   578\t        ;; shell is already connected.\n   579\t        state (poll-remote state)\n   580\t        state (observe-connection state)\n   581\t        [state lines] (drain-input state)\n   582\t        state (reduce handle-line state lines)]\n   583\t    (release-queue state)))\n","exit_code":0,"status":"completed"}}
