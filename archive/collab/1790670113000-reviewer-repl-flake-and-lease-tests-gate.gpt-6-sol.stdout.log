{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/lease.cljc | sed -n '970,1030p;1060,1100p;2090,2250p'; nl -ba test/dao/lease_composition_test.cljc | sed -n '690,780p'\"","aggregated_output":"   970\t  medium: the grant rides the grantor's stream, not the holder's, and\n   971\t  registration is the holder-medium relation the gap and truncation\n   972\t  fallbacks depend on. Everything else establishes nothing and registers\n   973\t  nothing: a holder fact establishes no term (a delayed holder renewal is\n   974\t  still evidence and counts), a renewal or release from any other author\n   975\t  is a fact about that author, a proposal creates no state, a tick on a\n   976\t  fact cursor is noise. An answer is recorded under the PROPOSER it\n   977\t  answers -- for a grant, the holder it carries -- so one holder's answered\n   978\t  proposal id never blocks another's; a drained refusal echo names no\n   979\t  proposer and records no answer.\"\n   980\t  [judge author fact]\n   981\t  (if-some [status (get fact status-key)]\n   982\t    (case status\n   983\t      :dao.lease/proposed\n   984\t      [(update judge :drained-proposals conj {:fact fact :author author}) nil]\n   985\t\n   986\t      :dao.lease/accepted\n   987\t      (if (= author (:self judge))\n   988\t        [(-> judge\n   989\t             (mark-seen (get fact :dao.lease/lease) status)\n   990\t             (mark-answered-maybe (get fact :dao.lease/holder) fact status)\n   991\t             (seed-lease fact))\n   992\t         nil]\n   993\t        [judge nil])\n   994\t\n   995\t      :dao.lease/rejected\n   996\t      (if (= author (:self judge))\n   997\t        ;; An echoed refusal names no proposer: it records no answer key,\n   998\t        ;; and repeat protection for refusals is the hook's delivery gate.\n   999\t        [judge nil]\n  1000\t        [judge nil])\n  1001\t\n  1002\t      :dao.lease/released\n  1003\t      (let [lid (get fact :dao.lease/lease)]\n  1004\t        (if (and (some? (get (:ledger judge) lid))\n  1005\t                 (= author (get-in judge [:ledger lid :holder])))\n  1006\t          [(-> judge\n  1007\t               (mark-seen lid status)\n  1008\t               (assoc-in [:ledger lid :released?] true))\n  1009\t           lid]\n  1010\t          ;; A release from any other author -- or for a lease not in the\n  1011\t          ;; ledger -- establishes nothing, registers nothing, and above all\n  1012\t          ;; does not enter :seen: a forged release must not make the\n  1013\t          ;; holder's own later release read as a repeat.\n  1014\t          [judge nil]))\n  1015\t\n  1016\t      :dao.lease/lapsed\n  1017\t      (if (= author (:self judge))\n  1018\t        [(mark-seen judge (get fact :dao.lease/lease) status) nil]\n  1019\t        [judge nil])\n  1020\t\n  1021\t      [judge nil])\n  1022\t    (case (get fact event-key)\n  1023\t      :dao.lease/renewal\n  1024\t      (let [lid (get fact :dao.lease/lease)]\n  1025\t        (if (and (some? (get (:ledger judge) lid))\n  1026\t                 (= author (get-in judge [:ledger lid :holder])))\n  1027\t          [(-> judge\n  1028\t               (assoc-in [:ledger lid :last-observation] (:now judge))\n  1029\t               (assoc-in [:ledger lid :evidence] :known))\n  1030\t           lid]\n  1060\t                          (assoc (get-in judge [:ledger lid])\n  1061\t                                 :evidence :unknown\n  1062\t                                 :resumed (:now judge)))\n  1063\t                judge))\n  1064\t            judge\n  1065\t            (concat gapped unregistered))))\n  1066\t\n  1067\t\n  1068\t(defn- process-fact-value\n  1069\t  \"Gate and apply one drained value: resolve the author from the wired\n  1070\t  source, drop the structurally defective and the inadmissible, apply the\n  1071\t  rest, and register the lease on this medium only when the fact was\n  1072\t  holder-authoritative for it. Returns [judge' entry']. May throw -- the\n  1073\t  resolver is composition code, and a hostile envelope is exactly the\n  1074\t  thrower -- which the drain treats as a dropped element.\"\n  1075\t  [judge entry value]\n  1076\t  (let [lease-fact (lease-fact? value)\n  1077\t        author (when lease-fact\n  1078\t                 (resolve-author judge (:source entry) value))\n  1079\t        ;; the answered-key is the PROPOSER: for a grant, the holder it\n  1080\t        ;; carries; nothing else names one\n  1081\t        proposer (when (and lease-fact\n  1082\t                            (= :dao.lease/accepted (get value status-key)))\n  1083\t                   (get value :dao.lease/holder))\n  1084\t        ok (and lease-fact\n  1085\t                (not (defective? value (:units judge)))\n  1086\t                (not (admissible? value (assoc (observed-of judge)\n  1087\t                                               :proposer proposer))))\n  1088\t        [judge' counted] (if ok\n  1089\t                           (apply-valid-fact judge author value)\n  1090\t                           [judge nil])\n  1091\t        judge' (if (or ok (not lease-fact))\n  1092\t                 judge'\n  1093\t                 (update judge' :dropped inc))\n  1094\t        ;; Registration on the medium is part of application, and only a\n  1095\t        ;; holder-authoritative fact registers: a defective, inadmissible or\n  1096\t        ;; non-counting fact establishes nothing, not even presence -- so no\n  1097\t        ;; non-holder can keep another holder's lease alive by gap-flooding\n  1098\t        ;; its own medium, and a grant read from a cursor does not claim the\n  1099\t        ;; holder's medium for the lease.\n  1100\t        entry' (if (some? counted)\n  2090\t  S3 relates retention to facts-per-cadence, not to the budget.\"\n  2091\t  [media durable?]\n  2092\t  (doseq [entry media\n  2093\t          :let [decl (get entry :medium)]]\n  2094\t    (when durable?\n  2095\t      (check-assembly! (not= :host-values (get decl :value-domain))\n  2096\t                       \"a :durable? composition cannot ride a :host-values medium: host values are process-local by construction\"\n  2097\t                       {:medium decl :refused :host-values}))))\n  2098\t\n  2099\t\n  2100\t(defn- check-medium-entry!\n  2101\t  \"One fact-medium wiring's own checks, as `make-judge` runs them at\n  2102\t  assembly: the entry is `{:handle :cursor :source :medium}` and its\n  2103\t  medium declaration is valid (C2/C3).\"\n  2104\t  [entry]\n  2105\t  (check-assembly! (and (map? entry)\n  2106\t                        (some? (:handle entry))\n  2107\t                        (some? (:cursor entry))\n  2108\t                        (some? (:source entry)))\n  2109\t                   \"each fact medium is wired {:handle :cursor :source :medium}\"\n  2110\t                   {:medium-entry entry :refused :medium-entry})\n  2111\t  (check-medium-declaration! \"each fact medium\" (get entry :medium)))\n  2112\t\n  2113\t\n  2114\t(defn- wire-declared-medium\n  2115\t  \"Wire one fact medium, KEEPING its explicit declaration on the wired\n  2116\t  entry: the declaration is wiring data a consumer can still read, not a\n  2117\t  validation scratchpad.\"\n  2118\t  [judge entry]\n  2119\t  (-> judge\n  2120\t      (wire-facts (:handle entry) (:cursor entry) (:source entry))\n  2121\t      (update :facts (fn [entries]\n  2122\t                       (assoc entries\n  2123\t                              (dec (count entries))\n  2124\t                              (assoc (peek entries)\n  2125\t                                     :medium (:medium entry)))))))\n  2126\t\n  2127\t\n  2128\t(defn make-judge\n  2129\t  \"Assemble the judge half of a composition that grants leases (C1-C4).\n  2130\t  Config, beyond `initial-judge`'s own seams (:units :tolerance\n  2131\t  :drain-budget :resolver :reclaim :policy :writer :self :answer -- of\n  2132\t  which :self and the tolerance are as required here as there):\n  2133\t\n  2134\t  :cadence           required: the maximum interval between COMPLETED\n  2135\t                     passes -- a strictly positive duration in the unit\n  2136\t                     table. The runtime that drives the returned step at\n  2137\t                     it is host code outside this namespace (C1)\n  2138\t  :tolerance         required EXPLICITLY: the contract's \\\"a tolerance\n  2139\t                     supplied to the judge, possibly zero\\\" is an owed\n  2140\t                     value, and `{:ms 0}` is the zero -- an omitted\n  2141\t                     tolerance is not a supplied one (`initial-judge`\n  2142\t                     alone still treats nil as zero for state-threaded\n  2143\t                     recovery use)\n  2144\t  :ticks             required, non-empty: `[{:handle :cursor} ...]`, the\n  2145\t                     judge's tick streams (C1: a tick stream for the\n  2146\t                     judge)\n  2147\t  :media             required, non-empty: `[{:handle :cursor :source\n  2148\t                     :medium declaration} ...]`, each recipient fact\n  2149\t                     medium with its explicit declaration (C2: the\n  2150\t                     declaration, never handle introspection, establishes\n  2151\t                     the medium). The declarations are DERIVED against\n  2152\t                     each other where they can contradict: a `:durable?`\n  2153\t                     composition cannot ride a `:host-values` medium. The\n  2154\t                     declaration rides the wired entry.\n  2155\t  :resolver-bindings required: the set of attribution kinds the resolver\n  2156\t                     resolves; a wired medium whose declared\n  2157\t                     `:attribution` is not among them is an incompatible\n  2158\t                     resolver, refused like a missing one (C2)\n  2159\t  :durable?          default false; true additionally requires\n  2160\t                     :durable-judge, :incarnation-rule and :fencing (C4)\n  2161\t\n  2162\t  Returns `{:judge state :step judge-step :scope :process-scoped|:durable\n  2163\t  :cadence c}`: the driver calls `(:step v)` threading `(:judge v)` at\n  2164\t  the declared cadence. A non-durable config's value is labeled\n  2165\t  process-scoped -- a declaration for the composition's consumers, not\n  2166\t  an enforcement. Every missing or incompatible seam throws ex-info\n  2167\t  here, naming it under `:refused`, before any wiring: nothing is wired\n  2168\t  into a refused composition.\"\n  2169\t  [config]\n  2170\t  (let [units (get config :units default-units)\n  2171\t        ticks (get config :ticks)\n  2172\t        media (get config :media)\n  2173\t        budget (or (get config :drain-budget) default-drain-budget)]\n  2174\t    (check-units! units)\n  2175\t    (check-cadence! config units)\n  2176\t    (check-assembly! (and (vector? ticks)\n  2177\t                          (seq ticks)\n  2178\t                          (every? (fn [t]\n  2179\t                                    (and (map? t)\n  2180\t                                         (some? (:handle t))\n  2181\t                                         (some? (:cursor t))))\n  2182\t                                  ticks))\n  2183\t                     \"the judge is wired at least one tick stream: {:handle :cursor} each\"\n  2184\t                     {:ticks ticks :refused :ticks})\n  2185\t    (check-assembly! (and (vector? media) (seq media))\n  2186\t                     \"the judge is wired the medium each recipient reads its facts from\"\n  2187\t                     {:media media :refused :media})\n  2188\t    (doseq [entry media]\n  2189\t      (check-medium-entry! entry))\n  2190\t    ;; The budget is validated as an integer HERE, before anything could\n  2191\t    ;; derive from it -- an assembly ex-info, never a raw host error --\n  2192\t    ;; and again, with the rest of the state's seams, in initial-judge.\n  2193\t    (check-assembly! (and (integer? budget) (pos? budget))\n  2194\t                     \"the drain budget is a positive integer\"\n  2195\t                     {:drain-budget budget :refused :drain-budget})\n  2196\t    (check-derived-medium-refusals! media (get config :durable?))\n  2197\t    (check-resolver-compatibility! \"the judge\"\n  2198\t                                   (get config :resolver)\n  2199\t                                   (get config :resolver-bindings)\n  2200\t                                   media)\n  2201\t    (check-assembly! (some? (get config :tolerance))\n  2202\t                     \"the judge is supplied an explicit tolerance, possibly zero: {:ms 0} is the zero\"\n  2203\t                     {:tolerance (get config :tolerance) :refused :tolerance})\n  2204\t    (check-assembly! (fn? (get config :reclaim))\n  2205\t                     \"the judge needs a reclaim procedure per subject: (fn [subject] -> success?), idempotent, reporting\"\n  2206\t                     {:reclaim (get config :reclaim) :refused :reclaim})\n  2207\t    (check-assembly! (some? (get config :writer))\n  2208\t                     \"the judge needs the stream it writes grants and :lapsed to\"\n  2209\t                     {:writer (get config :writer) :refused :writer})\n  2210\t    (check-durable-prerequisites! config)\n  2211\t    ;; Every check passed: build the state, then wire. Nothing is wired\n  2212\t    ;; before the whole config has been refused or accepted.\n  2213\t    (let [judge (assoc (initial-judge config)\n  2214\t                       ;; the assembly's declarations, kept so a medium\n  2215\t                       ;; wired later is validated against the same ones\n  2216\t                       :resolver-bindings (get config :resolver-bindings)\n  2217\t                       :durable? (boolean (get config :durable?)))\n  2218\t          judge (reduce (fn [j t] (wire-tick j (:handle t) (:cursor t) (get t :source)))\n  2219\t                        judge ticks)\n  2220\t          judge (reduce wire-declared-medium judge media)]\n  2221\t      {:judge judge\n  2222\t       :step judge-step\n  2223\t       :scope (if (get config :durable?) :durable :process-scoped)\n  2224\t       :cadence (get config :cadence)})))\n  2225\t\n  2226\t\n  2227\t(defn wire-declared-facts\n  2228\t  \"Wire one more fact medium into a composed judge -- the judge state\n  2229\t  `make-judge` returned under `:judge` -- after assembly: a medium that\n  2230\t  comes to exist with a grant, such as a per-lease renewal medium.\n  2231\t  `entry` is `{:handle :cursor :source :medium declaration}`, validated\n  2232\t  exactly as `make-judge` validates each wired medium at assembly -- the\n  2233\t  entry's shape and its explicit declaration (C2/C3), the `:durable?`\n  2234\t  host-values refusal (C4), and resolver compatibility against the\n  2235\t  `:resolver-bindings` the judge was assembled with (D4) -- and the\n  2236\t  declaration rides the wired entry as it does there. A refusal throws\n  2237\t  ex-info naming the seam under `:refused` and wires nothing; a judge\n  2238\t  not assembled by `make-judge` carries no bindings to validate against\n  2239\t  and is refused under `:resolver-bindings`. Returns the judge.\"\n  2240\t  [judge entry]\n  2241\t  (check-medium-entry! entry)\n  2242\t  (check-derived-medium-refusals! [entry] (get judge :durable?))\n  2243\t  (check-resolver-compatibility! \"the judge\"\n  2244\t                                 (get judge :resolver)\n  2245\t                                 (get judge :resolver-bindings)\n  2246\t                                 [entry])\n  2247\t  (wire-declared-medium judge entry))\n  2248\t\n  2249\t\n  2250\t(defn unwire-facts\n   690\t                           :dao.stream/identity \"served-1\"\n   691\t                           :dao.stream/channel channel}))\n   692\t          system (composed {:reclaim (fn [subject]\n   693\t                                       (swap! table dissoc subject)\n   694\t                                       true)})\n   695\t          system (-> system\n   696\t                     (update :judge lease/author-grant\n   697\t                             (lease/grant :l1 \"served-1\" :holder-a {:ms 10}))\n   698\t                     (tick! 1)\n   699\t                     step!)]\n   700\t      ;; after the initial tick: the holder's reflection resolves and\n   701\t      ;; reads the served entry\n   702\t      (serve!)\n   703\t      (ds/cursor refl :dao.stream/oldest)\n   704\t      (serve!)\n   705\t      (let [c0 (:dao.stream/cursor (ds/cursor refl :dao.stream/oldest))]\n   706\t        (is (= :dao.stream/blocked (:dao.stream/outcome (ds/next refl c0))))\n   707\t        (serve!)\n   708\t        (is (= :v1 (:dao.stream/value (ds/next refl c0)))\n   709\t            \"the reflection resolved and reads the served entry\")\n   710\t        (let [system (-> system (fact! (lease/renewal :l1)) (tick! 7) step!)]\n   711\t          (is (= {:ms 7} (get-in system [:judge :ledger :l1 :last-observation]))\n   712\t              \"the renewal on the per-author medium counted as evidence\")\n   713\t          (let [system (-> system (tick! 18) step!)]\n   714\t            (is (not (contains? @table \"served-1\"))\n   715\t                \"the idempotent reclaim removed the entry\")\n   716\t            (is (= [(lease/lapsed :l1 :silence)] (records system))\n   717\t                \"the :lapsed record is on the grantor's writer\")\n   718\t            (is (not (contains? (get-in system [:judge :ledger]) :l1))\n   719\t                \"the ledger no longer holds the lease\")\n   720\t            ;; one more reflection request and mirror step: the mirror\n   721\t            ;; answers not-found, the reflection becomes gone\n   722\t            (is (= :dao.stream/blocked (:dao.stream/outcome (ds/next refl c0))))\n   723\t            (serve!)\n   724\t            (let [ans (ds/next refl c0)]\n   725\t              (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   726\t              (is (= :dao.stream.remote/not-found\n   727\t                     (:dao.stream.remote/reason ans))))\n   728\t            (let [ans (ds/append! refl :x)]\n   729\t              (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   730\t              (is (= :dao.stream.remote/not-found\n   731\t                     (:dao.stream.remote/reason ans))\n   732\t                  \"a subsequent handle operation observes the same\n   733\t                   transport error\"))))))))\n   734\t\n   735\t\n   736\t(deftest shared-work-claim-sketch-test\n   737\t  (testing \"sketch: the shared-work claim -- a composition-supplied\n   738\t            reclaim following call-close!'s idempotency\"\n   739\t    ;; A shared-work claim's reclaim is a composition-supplied procedure\n   740\t    ;; in call-close!'s idempotency shape (serving.cljc:38-43): the first\n   741\t    ;; invocation performs the release and reports success; later\n   742\t    ;; invocations see the work already released and report success again\n   743\t    ;; without acting twice -- which is what the judge's pending-retry\n   744\t    ;; path demands of every reclaim it may invoke more than once.\n   745\t    (let [work (atom {:released? false})\n   746\t          releases (atom 0)\n   747\t          reclaim (fn [_subject]\n   748\t                    (when-not (:released? @work)\n   749\t                      (swap! work assoc :released? true)\n   750\t                      (swap! releases inc))\n   751\t                    true)\n   752\t          system (composed {:reclaim reclaim})\n   753\t          system (-> system\n   754\t                     (update :judge lease/author-grant\n   755\t                             (lease/grant :l1 :shared-work :holder-a {:ms 10}))\n   756\t                     (tick! 1)\n   757\t                     step!)\n   758\t          ;; the writer fails before the record, so the lease sits\n   759\t          ;; pending and the next pass invokes the procedure AGAIN\n   760\t          system (-> system\n   761\t                     (update :judge assoc :writer\n   762\t                             (fake-writer :dao.stream/full))\n   763\t                     (tick! 12)\n   764\t                     step!)\n   765\t          system (-> system\n   766\t                     (update :judge assoc :writer (:writer system))\n   767\t                     (tick! 13)\n   768\t                     step!)]\n   769\t      (is (= 1 @releases)\n   770\t          \"two reclaim invocations, one release: the procedure is idempotent\")\n   771\t      (is (true? (:released? @work)))\n   772\t      (is (= [(lease/lapsed :l1 :silence)] (records system))\n   773\t          \"the retry recorded after the writer recovered\"))))\n   774\t\n   775\t\n   776\t;; =============================================================================\n   777\t;; Wiring after assembly: wire-declared-facts / unwire-facts\n   778\t;; =============================================================================\n   779\t\n   780\t(defn- wiring-refusal-key\n","exit_code":0,"status":"completed"}}
