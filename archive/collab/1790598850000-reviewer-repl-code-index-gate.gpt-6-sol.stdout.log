ta (-> [(untimed meta-e :db/op :db/assert datom/default-op)\n   102\t                   (untimed meta-e :yin.repl/session session-token\n   103\t                            datom/default-op)\n   104\t                   (untimed meta-e :yin.repl/root root datom/default-op)\n   105\t                   (untimed meta-e :yin.repl/round round datom/default-op)]\n   106\t                  (into (map (fn [[e a v _t m]] (untimed e a v m))) facts)\n   107\t                  (into (map (fn [[e addr]]\n   108\t                               (untimed e :yin/address addr meta-e)))\n   109\t                        (sort-by key addresses))),\n   110\t     :next-e next-e',\n   111\t     :meta-e meta-e,\n   112\t     :root root}))\n   113\t\n   114\t\n   115\t;; =============================================================================\n   116\t;; The indexer value\n   117\t;; =============================================================================\n   118\t\n   119\t(defn make-indexer\n   120\t  \"The indexer for one session: `observer`, attached to `program-out`\n   121\t   beside the evaluator's; a complete-retention local log with its\n   122\t   transactor (dao.space.transactor requires memory-log retention); an\n   123\t   intake with a `dao.jing` pool observer over it; and `content-store`, the\n   124\t   `dao.jing` byte store publications materialize into.  `session-token` is\n   125\t   the shell's stable token, recorded as provenance.\"\n   126\t  [{:keys [observer session-token content-store]}]\n   127\t  (let [local (:dao.stream/handle\n   128\t                (memory-log/create! {:dao.stream/type\n   129\t                                     memory-log/transport-type}))\n   130\t        intake (:dao.stream/handle\n   131\t                 (ring/create! {:dao.stream/type ring/transport-type\n   132\t                                ring/capacity-key intake-capacity}))]\n   133\t    {:observer observer\n   134\t     :transactor (transactor/create! {:local-stream local\n   135\t                                      :intake-pool [intake]\n   136\t                                      :name \"yin.repl.index\"})\n   137\t     :pool (jing/observer-state\n   138\t             [{:stream intake\n   139\t               :cursor (:dao.stream/cursor\n   140\t                         (stream/cursor intake :dao.stream/oldest))}])\n   141\t     :content-store content-store\n   142\t     :session-token session-token\n   143\t     :next-e datom/first-user-id\n   144\t     :transactions 0\n   145\t     :manifest-address nil\n   146\t     :failure nil}))\n   147\t\n   148\t\n   149\t(defn- commit\n   150\t  \"Commit one packet as one transaction.  A packet that could not be\n   151\t   projected or committed is consumed and recorded as the failure, never\n   152\t   counted.\"\n   153\t  [ix packet round]\n   154\t  (try\n   155\t    (let [{:keys [tx-data next-e root]}\n   156\t          (packet->tx-data packet\n   157\t                           (:next-e ix)\n   158\t                           {:session-token (:session-token ix), :round round})\n   159\t          answer (transactor/transact! (:transactor ix) tx-data)]\n   160\t      (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   161\t        [(-> ix\n   162\t             (assoc :next-e next-e)\n   163\t             (update :transactions inc))\n   164\t         true]\n   165\t        [(assoc ix\n   166\t                :failure {:round round\n   167\t                          :root root\n   168\t                          :stage :transact\n   169\t                          :outcome (:dao.stream/outcome answer)})\n   170\t         false]))\n   171\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   172\t      [(assoc ix\n   173\t              :failure {:round round\n   174\t                        :stage :project\n   175\t                        :message (ex-message e)})\n   176\t       false])))\n   177\t\n   178\t\n   179\t(defn- materialize\n   180\t  \"Drain the intake into the store until it blocks.  Answers the pool state\n   181\t   and, when the drain met a gap or a defect, what it met.\"\n   182\t  [content-store pool]\n   183\t  (loop [pool pool]\n   184\t    (let [{:keys [signal], :as r} (jing/observe-step! content-store pool)]\n   185\t      (case signal\n   186\t        :dao.stream/ok (recur (:state r))\n   187\t        :dao.stream/blocked [(:state r) nil]\n   188\t        [(cond-> (:state r)\n   189\t           (= :dao.stream/gap signal)\n   190\t           (jing/adopt-cursor (:member r) (:cursor r)))\n   191\t         signal]))))\n   192\t\n   193\t\n   194\t(defn- publish\n   195\t  \"Publish the covered indexes over every committed transaction and\n   196\t   materialize them into the store.  Only a fully materialized publication\n   197\t   becomes the reported manifest.\"\n   198\t  [ix round]\n   199\t  (try\n   200\t    (let [{:keys [manifest-address]} (transactor/publish! (:transactor ix))\n   201\t          [pool defect] (materialize (:content-store ix) (:pool ix))]\n   202\t      (if defect\n   203\t        (assoc ix\n   204\t               :pool pool\n   205\t               :failure {:round round :stage :materialize :outcome defect})\n   206\t        (assoc ix :pool pool :manifest-address manifest-address)))\n   207\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   208\t      (assoc ix\n   209\t             :failure {:round round :stage :publish :message (ex-message e)}))))\n   210\t\n   211\t\n   212\t(defn step\n   213\t  \"The round's index step: observe every packet `program-out` still holds\n   214\t   for this observer, commit each, and publish when any was committed.  A\n   215\t   gap is recovered across and counted on the observer's `:ingress-gaps`,\n   216\t   which the shell reads; the missing packet is never called indexed.\"\n   217\t  [indexer round]\n   218\t  (loop [ix indexer\n   219\t         committed? false]\n   220\t    (let [{:keys [status batch] observer' :observer}\n   221\t          (observer/observe-next (:observer ix))\n   222\t          ix (assoc ix :observer observer')]\n   223\t      (case status\n   224\t        :ok (let [[ix' ok?] (commit ix batch round)]\n   225\t              (recur ix' (or committed? ok?)))\n   226\t        :gap (recur ix committed?)\n   227\t        (if committed? (publish ix round) ix)))))\n   228\t\n   229\t\n   230\t(defn skip\n   231\t  \"Advance the observer past every packet still on the medium without\n   232\t   indexing it: a round that threw before its program ran executes nothing,\n   233\t   so nothing is indexed.  Gaps are still counted.\"\n   234\t  [indexer]\n   235\t  (loop [ix indexer]\n   236\t    (let [{:keys [status] observer' :observer}\n   237\t          (observer/observe-next (:observer ix))\n   238\t          ix (assoc ix :observer observer')]\n   239\t      (if (#{:ok :gap} status) (recur ix) ix))))\n   240\t\n   241\t\n   242\t(defn summary\n   243\t  \"A serializable summary of the indexer's progress.\"\n   244\t  [indexer]\n   245\t  {:transactions (:transactions indexer)\n   246\t   :manifest (:manifest-address indexer)\n   247\t   :gaps (:ingress-gaps (:observer indexer) 0)\n   248\t   :failure (:failure indexer)})\n","exit_code":0,"status":"completed"}}
