29\t      (is (true? (:ingress-loss? lost)))\n   230\t      (is (= 1 (:gaps (repl.index/summary (:indexer lost)))))\n   231\t      (is (= 1 (get-in (repl/repl-state lost) [:vm :in-stream :gaps]))))\n   232\t    (testing \"reset rebuilds the observer with the session\"\n   233\t      (let [[fresh message] (repl/eval-input lost \"(reset)\")\n   234\t            [indexed result] (repl/eval-input fresh \"(+ 1 2)\")]\n   235\t        (is (= \"SemanticVM reset\" message))\n   236\t        (is (not (identical? (:indexer lost) (:indexer fresh))))\n   237\t        (is (= {:transactions 0 :manifest nil :gaps 0 :failure nil}\n   238\t               (repl.index/summary (:indexer fresh))))\n   239\t        (is (identical? (:index-store lost) (:index-store fresh))\n   240\t            \"the dao.jing store outlives the session\")\n   241\t        (is (= \"3\" result))\n   242\t        (is (= 1 (count (transactions indexed))))))))\n   243\t\n   244\t\n   245\t(deftest vm-selection-rebuilds-the-indexer\n   246\t  (let [[state _] (evaluate (repl/create-state) [\"(+ 1 2)\"])\n   247\t        [switched _] (repl/eval-input state \"(vm :ast-walker)\")]\n   248\t    (is (= 1 (count (transactions state))))\n   249\t    (is (empty? (transactions switched)))\n   250\t    (is (not (identical? (get-in state [:indexer :observer :stream])\n   251\t                         (get-in switched [:indexer :observer :stream]))))))\n","exit_code":0,"status":"completed"}}
