{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/remote_pair_test.cljc | sed -n '1,320p'\"","aggregated_output":"     1\t(ns dao.stream.remote-pair-test\n     2\t  \"The pair channel of dao.stream.remote.md (3.3): a gap on `in` ends\n     3\t   the channel with the source's frames lost, not relayed as a\n     4\t   source's own gap; the abandoned append! is reported append-\n     5\t   unknown; attach! on the same pair descriptor resumes with a fresh\n     6\t   cursor on `in`; two identities riding one pair descriptor share\n     7\t   its link, one lower attach! each; and a pair descriptor as a\n     8\t   channel reads a served stream verbatim through a third peer's two\n     9\t   ring buffers, the relay convention of section 4, proved here at\n    10\t   the channel layer, independent of the meeting board.\"\n    11\t  (:require [clojure.test :refer [deftest is testing]]\n    12\t            [dao.stream :as stream]\n    13\t            [dao.stream.remote :as remote]\n    14\t            [dao.stream.remote-pair :as pair]\n    15\t            [dao.stream.ringbuffer :as ringbuffer]))\n    16\t\n    17\t\n    18\t;; =============================================================================\n    19\t;; The toy: a pair over two raw ring buffers, no real lower channel\n    20\t;; =============================================================================\n    21\t\n    22\t(defn- ring\n    23\t  [capacity]\n    24\t  (:dao.stream/handle\n    25\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    26\t                         :dao.stream.ringbuffer/capacity capacity})))\n    27\t\n    28\t\n    29\t(defn- lower-attach!\n    30\t  \"A stub :dao.stream/remote attach entry: identity -> a raw handle\n    31\t   already given, no reflection semantics of its own. This\n    32\t   namespace's own contract with `pair/attacher` needs only a\n    33\t   conforming attach! result, and the raw ring buffer stands in\n    34\t   honestly for what a real one, over ws or another pair, would\n    35\t   eventually resolve to: something that gaps when its retention is\n    36\t   outrun.\"\n    37\t  [handles]\n    38\t  (fn [descriptor]\n    39\t    (if-some [h (get handles (:dao.stream/identity descriptor))]\n    40\t      {:dao.stream/outcome :dao.stream/ok :dao.stream/handle h}\n    41\t      {:dao.stream/outcome :dao.stream/not-found})))\n    42\t\n    43\t\n    44\t(defn- counting-lower-attach!\n    45\t  \"As `lower-attach!`, also counting every call per identity in\n    46\t   `counts`, an atom of {identity -> n}.\"\n    47\t  [handles counts]\n    48\t  (fn [descriptor]\n    49\t    (swap! counts update (:dao.stream/identity descriptor) (fnil inc 0))\n    50\t    ((lower-attach! handles) descriptor)))\n    51\t\n    52\t\n    53\t(defn- remote-descriptor\n    54\t  [id]\n    55\t  {:dao.stream/type :dao.stream/remote\n    56\t   :dao.stream/identity id\n    57\t   :dao.stream/channel {:dao.stream/type :dao.stream.test/lower\n    58\t                        :dao.stream/identity id}})\n    59\t\n    60\t\n    61\t(defn- pair-descriptor\n    62\t  [pair-id in-id out-id]\n    63\t  {:dao.stream/type :dao.stream/pair\n    64\t   :dao.stream/identity pair-id\n    65\t   :dao.stream.remote/in (remote-descriptor in-id)\n    66\t   :dao.stream.remote/out (remote-descriptor out-id)})\n    67\t\n    68\t\n    69\t(defn- outer-descriptor\n    70\t  [identity pair-cd]\n    71\t  {:dao.stream/type :dao.stream/remote\n    72\t   :dao.stream/identity identity\n    73\t   :dao.stream/channel pair-cd})\n    74\t\n    75\t\n    76\t(defn- entry\n    77\t  [h surface]\n    78\t  {:handle h :surface surface})\n    79\t\n    80\t\n    81\t(defn- values\n    82\t  [h]\n    83\t  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n    84\t         acc []]\n    85\t    (let [r (stream/next h c)]\n    86\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    87\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    88\t        acc))))\n    89\t\n    90\t\n    91\t;; =============================================================================\n    92\t;; 3.3's own rule: an in gap ends the channel\n    93\t;; =============================================================================\n    94\t\n    95\t(deftest pair-gap-ends-the-channel-test\n    96\t  (let [ab (ring 8)\n    97\t        ba (ring 2)\n    98\t        events (ring 16)\n    99\t        pcd (pair-descriptor \"pair-1\" \"ba-id\" \"ab-id\")\n   100\t        attach! (pair/attacher\n   101\t                  {:dao.stream.remote.pair/attach!\n   102\t                   (lower-attach! {\"ba-id\" ba \"ab-id\" ab})\n   103\t                   :dao.stream.remote/events events})\n   104\t        r (:dao.stream/handle (attach! (outer-descriptor \"svc-1\" pcd)))]\n   105\t    (testing \"attach answers ok at once, in's cursor minted at :newest\"\n   106\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/descriptor r)))))\n   107\t    (let [sent (stream/append! r :v)]\n   108\t      (is (= :dao.stream/ok (:dao.stream/outcome sent))\n   109\t          \"the append! request crossed on ab, unanswered -- it is what\n   110\t           the channel loss below abandons\")\n   111\t      (testing \"flooding ba past its retention outruns the cursor\n   112\t                minted at attach, before any op has read it\"\n   113\t        (dotimes [_ 4] (stream/append! ba :noise))\n   114\t        (let [ans (stream/next r 0)]\n   115\t          (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   116\t          (is (= :dao.stream.remote/channel-gone\n   117\t                 (:dao.stream.remote/reason ans))\n   118\t              \"the gap on in is never relayed as a source's own gap:\n   119\t               the reader answered end, and the link ran its\n   120\t               channel-loss path\")))\n   121\t      (testing \"the abandoned append! is reported append-unknown\"\n   122\t        (is (some #(= :dao.stream.remote/append-unknown\n   123\t                      (:dao.stream.remote/event %))\n   124\t                  (values events))))\n   125\t      (testing \"reads answer channel-gone, not retryable, from here on\"\n   126\t        (let [ans (stream/cursor r :dao.stream/oldest)]\n   127\t          (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   128\t          (is (= :dao.stream.remote/channel-gone\n   129\t                 (:dao.stream.remote/reason ans))))))))\n   130\t\n   131\t\n   132\t;; =============================================================================\n   133\t;; attach! on the same pair descriptor resumes\n   134\t;; =============================================================================\n   135\t\n   136\t(deftest reattachment-resumes-test\n   137\t  (let [ab (ring 8)\n   138\t        ba (ring 2)\n   139\t        pcd (pair-descriptor \"pair-1\" \"ba-id\" \"ab-id\")\n   140\t        handles {\"ba-id\" ba \"ab-id\" ab}\n   141\t        attach! (pair/attacher\n   142\t                  {:dao.stream.remote.pair/attach! (lower-attach! handles)})\n   143\t        r1 (:dao.stream/handle (attach! (outer-descriptor \"svc-1\" pcd)))]\n   144\t    (stream/descriptor r1)\n   145\t    (dotimes [_ 4] (stream/append! ba :noise))\n   146\t    (let [gone (stream/next r1 0)]\n   147\t      (is (= :dao.stream.remote/channel-gone\n   148\t             (:dao.stream.remote/reason gone))\n   149\t          \"the first attachment is gone: forced past ba's retention\"))\n   150\t    (testing \"a fresh attach! on the same pair descriptor value builds\n   151\t              a fresh channel, minted at ba's :newest\"\n   152\t      (let [r2 (:dao.stream/handle\n   153\t                 (attach! (outer-descriptor \"svc-1\" pcd)))]\n   154\t        (is (not (identical? r1 r2)))\n   155\t        (let [ans (stream/next r2 0)]\n   156\t          (is (not= :dao.stream.remote/channel-gone\n   157\t                    (:dao.stream.remote/reason ans)))\n   158\t          (is (= :dao.stream/blocked (:dao.stream/outcome ans))\n   159\t              \"the fresh link is alive: nothing filed yet, no gap\"))))))\n   160\t\n   161\t\n   162\t;; =============================================================================\n   163\t;; Two identities riding one pair descriptor share its link\n   164\t;; =============================================================================\n   165\t\n   166\t(deftest two-identities-share-one-pair-link-test\n   167\t  (let [ab (ring 8)\n   168\t        ba (ring 8)\n   169\t        pcd (pair-descriptor \"pair-1\" \"ba-id\" \"ab-id\")\n   170\t        handles {\"ba-id\" ba \"ab-id\" ab}\n   171\t        counts (atom {})\n   172\t        attach! (pair/attacher\n   173\t                  {:dao.stream.remote.pair/attach!\n   174\t                   (counting-lower-attach! handles counts)})]\n   175\t    (attach! (outer-descriptor \"p\" pcd))\n   176\t    (attach! (outer-descriptor \"q\" pcd))\n   177\t    (is (= {\"ba-id\" 1 \"ab-id\" 1} @counts)\n   178\t        \"one lower attach! each, for the one pair channel end built\n   179\t         and shared by both identities -- a second attach! would\n   180\t         double each count\")))\n   181\t\n   182\t\n   183\t;; =============================================================================\n   184\t;; The relay convention's channel: a pair over a third peer's buffers\n   185\t;; =============================================================================\n   186\t\n   187\t(deftest relay-round-trip-test\n   188\t  (testing \"a peer with no channel of its own reaches another peer's\n   189\t            served stream through a third peer's two ring buffers:\n   190\t            requests flow one way, answers the other -- exactly\n   191\t            dao.stream.remote's own toy, with a pair descriptor as\n   192\t            the channel instead of one the composition wires\n   193\t            directly (section 4's relay)\"\n   194\t    (let [requests (ring 8)\n   195\t          answers (ring 8)\n   196\t          pcd (pair-descriptor \"pair-1\" \"answers-id\" \"requests-id\")\n   197\t          handles {\"answers-id\" answers \"requests-id\" requests}\n   198\t          attach! (pair/attacher\n   199\t                    {:dao.stream.remote.pair/attach!\n   200\t                     (lower-attach! handles)})\n   201\t          served (ring 8)\n   202\t          _ (stream/append! served :hello)\n   203\t          table (atom {\"svc\" (entry served #{:reader})})\n   204\t          mirror (atom (:dao.stream/cursor\n   205\t                         (stream/cursor requests :dao.stream/oldest)))\n   206\t          serve! (fn []\n   207\t                   (swap! mirror\n   208\t                          #(remote/mirror-step @table requests %\n   209\t                                               answers)))\n   210\t          r (:dao.stream/handle (attach! (outer-descriptor \"svc\" pcd)))]\n   211\t      (serve!)\n   212\t      (stream/cursor r :dao.stream/oldest)\n   213\t      (serve!)\n   214\t      (let [c0 (:dao.stream/cursor (stream/cursor r :dao.stream/oldest))]\n   215\t        (is (= :dao.stream/blocked\n   216\t               (:dao.stream/outcome (stream/next r c0))))\n   217\t        (serve!)\n   218\t        (is (= :hello (:dao.stream/value (stream/next r c0)))\n   219\t            \"the reflection, attached only through the pair, reads\n   220\t             the served stream verbatim -- the relaying peer's mirror\n   221\t             never interprets what crossed\")))))\n","exit_code":0,"status":"completed"}}
