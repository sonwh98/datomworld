{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/remote_meet_test.cljc | sed -n '1,400p'\"","aggregated_output":"     1\t(ns dao.stream.remote-meet-test\n     2\t  \"The meeting board convention of dao.stream.remote.md (section 4):\n     3\t   a `:meet/here` posting carries the channel attachment identity M\n     4\t   itself observed, never a claim the payload sent -- the whole basis\n     5\t   of punching through a restricted NAT; a meeting request past the\n     6\t   bound is refused, present, never silent; `:meet/pair` grants a\n     7\t   lease-governed relay pair, its two ring buffers a working channel\n     8\t   the moment they are posted -- the symmetric-NAT relay; a pair\n     9\t   whose holder stops renewing answers not-found after duration plus\n    10\t   tolerance, and a reconnect within it finds the pair intact\n    11\t   (docs/design/dao.lease.md).\"\n    12\t  (:require [clojure.test :refer [deftest is testing]]\n    13\t            [dao.lease :as lease]\n    14\t            [dao.stream :as stream]\n    15\t            [dao.stream.remote :as remote]\n    16\t            [dao.stream.remote-meet :as meet]\n    17\t            [dao.stream.ringbuffer :as ringbuffer]))\n    18\t\n    19\t\n    20\t;; =============================================================================\n    21\t;; The toy: one channel per simulated peer, to M's one table\n    22\t;; =============================================================================\n    23\t\n    24\t(defn- ring\n    25\t  [capacity]\n    26\t  (:dao.stream/handle\n    27\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    28\t                         :dao.stream.ringbuffer/capacity capacity})))\n    29\t\n    30\t\n    31\t(defn- toy\n    32\t  \"One simulated peer's own channel to M, `channel-id` naming the wire\n    33\t   channel descriptor -- not the reflexive address: M's own\n    34\t   mirror-step observes the address as the identity of `ab`, the ring\n    35\t   buffer it reads this peer's requests from (`address` below), a\n    36\t   value this namespace never chooses and the peer's own payload\n    37\t   never carries -- distinct per peer, exactly as two different UDP\n    38\t   sockets would be.\"\n    39\t  [channel-id]\n    40\t  (let [ab (ring 64)\n    41\t        ba (ring 64)]\n    42\t    {:channel {:dao.stream/type :dao.stream.test/channel\n    43\t               :dao.stream/identity channel-id}\n    44\t     :ab ab\n    45\t     :ba ba\n    46\t     :a-end {:reader ba :writer ab}\n    47\t     :b-end {:reader ab :writer ba}}))\n    48\t\n    49\t\n    50\t(defn- address\n    51\t  \"The reflexive address M's mirror-step observes for peer `t`: the\n    52\t   identity of the ring buffer it reads `t`'s requests from.\"\n    53\t  [t]\n    54\t  (:dao.stream/identity (stream/descriptor (:ab t))))\n    55\t\n    56\t\n    57\t(defn- served-peer\n    58\t  \"M's own mirror side of one peer's toy, over the shared `table`.\"\n    59\t  [table t]\n    60\t  {:table table\n    61\t   :reader (:reader (:b-end t))\n    62\t   :writer (:writer (:b-end t))\n    63\t   :mirror (atom (:dao.stream/cursor\n    64\t                   (stream/cursor (:reader (:b-end t)) :dao.stream/oldest)))})\n    65\t\n    66\t\n    67\t(defn- serve!\n    68\t  [peer]\n    69\t  (swap! (:mirror peer)\n    70\t         #(remote/mirror-step @(:table peer) (:reader peer) %\n    71\t                              (:writer peer))))\n    72\t\n    73\t\n    74\t(defn- attacher-for\n    75\t  \"One remote/attacher over `t`'s channel, its one link shared by\n    76\t   every identity attached through it from here -- callers that need\n    77\t   more than one identity on one toy must reuse this, never build a\n    78\t   second attacher over the same physical buffers: two attachers each\n    79\t   mint their own ids from zero, and a shared wire risks one's\n    80\t   answer being absorbed by the other's outstanding id of the same\n    81\t   number.\"\n    82\t  ([t] (attacher-for t {}))\n    83\t  ([t opts]\n    84\t   (remote/attacher\n    85\t     (merge opts {:dao.stream.remote/channels {(:channel t) (:a-end t)}}))))\n    86\t\n    87\t\n    88\t(defn- attach\n    89\t  [attach! t identity]\n    90\t  (:dao.stream/handle\n    91\t    (attach! {:dao.stream/type :dao.stream/remote\n    92\t              :dao.stream/identity identity\n    93\t              :dao.stream/channel (:channel t)})))\n    94\t\n    95\t\n    96\t(defn- values\n    97\t  [h]\n    98\t  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n    99\t         acc []]\n   100\t    (let [r (stream/next h c)]\n   101\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n   102\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n   103\t        acc))))\n   104\t\n   105\t\n   106\t(defn- oldest-cursor!\n   107\t  \"The reflection's :oldest cursor, resolved: sent, served, then\n   108\t   re-asked so the filed answer is returned, exactly the two-call\n   109\t   idiom every reflection read needs.\"\n   110\t  [r peer]\n   111\t  (serve! peer)\n   112\t  (stream/cursor r :dao.stream/oldest)\n   113\t  (serve! peer)\n   114\t  (:dao.stream/cursor (stream/cursor r :dao.stream/oldest)))\n   115\t\n   116\t\n   117\t(defn- read-all!\n   118\t  \"Drain reflection `r`'s served stream fully to `:dao.stream/blocked`,\n   119\t   serving `peer` between reads as needed, returning every value seen.\n   120\t   A blocked read is retried, served, once more before treating the\n   121\t   stream as caught up -- the same send-then-ask idiom `next` needs\n   122\t   throughout dao.stream.remote-test.\"\n   123\t  [r peer]\n   124\t  (loop [c (oldest-cursor! r peer) acc [] stalled 0]\n   125\t    (if (>= stalled 3)\n   126\t      acc\n   127\t      (let [n (stream/next r c)]\n   128\t        (case (:dao.stream/outcome n)\n   129\t          :dao.stream/ok (recur (:dao.stream/cursor n)\n   130\t                                (conj acc (:dao.stream/value n)) 0)\n   131\t          :dao.stream/blocked (do (serve! peer) (recur c acc (inc stalled)))\n   132\t          acc)))))\n   133\t\n   134\t\n   135\t;; =============================================================================\n   136\t;; The meeting and its lease judge, wired together\n   137\t;; =============================================================================\n   138\t\n   139\t(defn- resolver\n   140\t  [source _fact]\n   141\t  source)\n   142\t\n   143\t\n   144\t(defn- meeting-system\n   145\t  \"M's meeting state plus a composed lease judge over fresh ring\n   146\t   buffers, `reclaim-fn` closing over the meeting: `m`'s own reclaim\n   147\t   dissoc's a pair's two identities from `table` and decrements\n   148\t   `active-pairs`, both this namespace's own bookkeeping.\"\n   149\t  [{:keys [max-pairs duration tolerance holder]}]\n   150\t  (let [table (atom {})\n   151\t        board (ring 32)\n   152\t        requests (ring 32)\n   153\t        decision (ring 1)\n   154\t        judge-atom (atom nil)\n   155\t        m (meet/meeting {:requests requests :board board :table table\n   156\t                         :capacity 8 :max-pairs max-pairs\n   157\t                         :decision decision :judge-atom judge-atom\n   158\t                         :duration duration :ring! ring :self :M})\n   159\t        ticks (ring 16)\n   160\t        facts (ring 16)\n   161\t        writer (ring 16)\n   162\t        judge-config (lease/make-judge\n   163\t                       {:cadence {:ms 1} :units {:ms 1}\n   164\t                        :tolerance tolerance\n   165\t                        :resolver resolver\n   166\t                        :resolver-bindings #{:per-author-media}\n   167\t                        :reclaim (meet/reclaim-fn m)\n   168\t                        :writer writer\n   169\t                        :self :M\n   170\t                        :ticks [{:handle ticks\n   171\t                                 :cursor (:dao.stream/cursor\n   172\t                                           (stream/cursor\n   173\t                                             ticks :dao.stream/oldest))}]\n   174\t                        :media [{:handle facts\n   175\t                                 :cursor (:dao.stream/cursor\n   176\t                                           (stream/cursor\n   177\t                                             facts :dao.stream/oldest))\n   178\t                                 :source holder\n   179\t                                 :medium {:retention :evict-oldest\n   180\t                                          :capacity 8\n   181\t                                          :value-domain :portable-values\n   182\t                                          :attribution :per-author-media}}]})]\n   183\t    (reset! judge-atom (:judge judge-config))\n   184\t    {:m m :table table :board board :requests requests :decision decision\n   185\t     :ticks ticks :facts facts :judge-step (:step judge-config)\n   186\t     :judge-atom judge-atom}))\n   187\t\n   188\t\n   189\t(defn- meet-table\n   190\t  [sys]\n   191\t  (merge (meet/entries {:requests (:requests sys) :board (:board sys)\n   192\t                        :decision (:decision sys)})\n   193\t         @(:table sys)))\n   194\t\n   195\t\n   196\t(defn- tick!\n   197\t  [sys ms]\n   198\t  (stream/append! (:ticks sys) (lease/tick {:ms ms}))\n   199\t  (swap! (:judge-atom sys) (:judge-step sys)))\n   200\t\n   201\t\n   202\t;; =============================================================================\n   203\t;; A meet/here posting carries the observed address, not a claim\n   204\t;; =============================================================================\n   205\t\n   206\t(deftest meet-here-tags-the-observed-address-test\n   207\t  (let [toy-a (toy \"addr-a\")\n   208\t        toy-b (toy \"addr-b\")\n   209\t        sys (meeting-system {:max-pairs 10 :duration {:ms 100}\n   210\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   211\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   212\t        peer-b (served-peer (atom (meet-table sys)) toy-b)\n   213\t        ra-req (attach (attacher-for toy-a) toy-a :meet-requests)\n   214\t        rb-req (attach (attacher-for toy-b) toy-b :meet-requests)]\n   215\t    (stream/append! ra-req {:meet/here \"peer-a\"})\n   216\t    (serve! peer-a)\n   217\t    (stream/append! rb-req {:meet/here \"peer-b\"})\n   218\t    (serve! peer-b)\n   219\t    (meet/step! (:m sys))\n   220\t    (let [postings (values (:board sys))]\n   221\t      (is (= #{(address toy-a) (address toy-b)}\n   222\t             (into #{} (map :meet/reflexive postings)))\n   223\t          \"the board carries the channel identity M itself observed\n   224\t           for each peer -- neither payload named an address at all\")\n   225\t      (is (= #{\"peer-a\" \"peer-b\"} (into #{} (map :meet/seen postings))))\n   226\t      (is (every? #(contains? % :dao.lease/lease) postings)))))\n   227\t\n   228\t\n   229\t;; =============================================================================\n   230\t;; Bounded meeting work: the gate refuses past the bound, present\n   231\t;; =============================================================================\n   232\t\n   233\t(deftest bound-gate-refuses-past-the-bound-test\n   234\t  (let [toy-a (toy \"addr-a\")\n   235\t        sys (meeting-system {:max-pairs 1 :duration {:ms 1000}\n   236\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   237\t        peer-a (served-peer (atom (meet-table sys)) toy-a)\n   238\t        events (ring 16)\n   239\t        ra-req (attach (attacher-for toy-a\n   240\t                                     {:dao.stream.remote/events events})\n   241\t                       toy-a :meet-requests)]\n   242\t    (meet/step! (:m sys))\n   243\t    (testing \"within the bound, the first ask's append! is honored\"\n   244\t      (stream/append! ra-req {:meet/pair \"peer-b\"})\n   245\t      (serve! peer-a)\n   246\t      (stream/descriptor ra-req)\n   247\t      (is (= :dao.stream/ok (:dao.stream/outcome (last (values events))))\n   248\t          \"the server's own answer to the append!, seen on the event\n   249\t           writer -- the reflection's own append! return is only the\n   250\t           local send's acceptance, never the server's answer\")\n   251\t      (meet/step! (:m sys))\n   252\t      (is (= 1 (meet/active-pairs (:m sys)))))\n   253\t    (testing \"past the bound, the gate refuses the append! itself,\n   254\t              present, not silent -- observed on the event writer,\n   255\t              never as a filed answer a later op returns\"\n   256\t      ;; one further step! publishes the decision reflecting the\n   257\t      ;; grant just above -- the gate reads only what was already\n   258\t      ;; published, never the meeting's own live state directly\n   259\t      (meet/step! (:m sys))\n   260\t      (stream/append! ra-req {:meet/pair \"peer-c\"})\n   261\t      (serve! peer-a)\n   262\t      (stream/descriptor ra-req)\n   263\t      (is (= :dao.stream/refused (:dao.stream/outcome (last (values events))))\n   264\t          \"the append! itself was refused, not merely its request\n   265\t           unhonored\"))))\n   266\t\n   267\t\n   268\t;; =============================================================================\n   269\t;; symmetric-NAT relay: a granted pair is a working channel at once\n   270\t;; =============================================================================\n   271\t\n   272\t(deftest symmetric-nat-relay-grant-test\n   273\t  (let [toy-a (toy \"addr-a\")\n   274\t        sys (meeting-system {:max-pairs 10 :duration {:ms 1000}\n   275\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   276\t        table-atom (atom (meet-table sys))\n   277\t        peer-a (served-peer table-atom toy-a)\n   278\t        attach-a! (attacher-for toy-a)\n   279\t        ra-req (attach attach-a! toy-a :meet-requests)\n   280\t        ra-board (attach attach-a! toy-a :meet-board)]\n   281\t    (stream/append! ra-req {:meet/pair \"peer-b\"})\n   282\t    (serve! peer-a)\n   283\t    (meet/step! (:m sys))\n   284\t    (reset! table-atom (meet-table sys))\n   285\t    (let [postings (read-all! ra-board peer-a)\n   286\t          posting (first (filter #(contains? % :meet/pair-for) postings))\n   287\t          in-id (get-in posting [:dao.stream.remote/in :dao.stream/identity])\n   288\t          out-id (get-in posting\n   289\t                         [:dao.stream.remote/out :dao.stream/identity])]\n   290\t      (is (some? posting) \"the relay grant was posted on the board\")\n   291\t      (is (= \"peer-b\" (:meet/pair-for posting)))\n   292\t      (is (= 1 (meet/active-pairs (:m sys))))\n   293\t      (testing \"M's table now serves both identities, ordinary remote\n   294\t                descriptors reachable over its own mirror -- exactly\n   295\t                what dao.stream.remote-pair's own attacher resolves\n   296\t                :dao.stream.remote/in and :dao.stream.remote/out\n   297\t                through (proved there, over these same two entries)\"\n   298\t        (is (some? (:handle (get @(:table sys) in-id))))\n   299\t        (is (some? (:handle (get @(:table sys) out-id))))\n   300\t        (let [in-refl (attach attach-a! toy-a in-id)\n   301\t              out-refl (attach attach-a! toy-a out-id)]\n   302\t          (is (some? (oldest-cursor! in-refl peer-a))\n   303\t              \"in-id resolves a real cursor: reachable, not not-found\")\n   304\t          (is (some? (oldest-cursor! out-refl peer-a))\n   305\t              \"out-id resolves a real cursor: reachable, not not-found\"))))))\n   306\t\n   307\t\n   308\t;; =============================================================================\n   309\t;; A pair whose holder stops renewing answers not-found\n   310\t;; =============================================================================\n   311\t\n   312\t(deftest lease-reclaim-as-not-found-test\n   313\t  (let [toy-a (toy \"addr-a\")\n   314\t        sys (meeting-system {:max-pairs 10 :duration {:ms 10}\n   315\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   316\t        table-atom (atom (meet-table sys))\n   317\t        peer-a (served-peer table-atom toy-a)\n   318\t        attach-a! (attacher-for toy-a)\n   319\t        ra-req (attach attach-a! toy-a :meet-requests)]\n   320\t    (stream/append! ra-req {:meet/pair \"peer-b\"})\n   321\t    (serve! peer-a)\n   322\t    ;; step! drains the ask and queues the grant; only the NEXT judge\n   323\t    ;; pass seeds it (dao.lease.md, author-grant), so the tick that\n   324\t    ;; establishes tenure-start must come after, never before\n   325\t    (meet/step! (:m sys))\n   326\t    (tick! sys 1)\n   327\t    (reset! table-atom (meet-table sys))\n   328\t    (let [postings (values (:board sys))\n   329\t          posting (first (filter #(contains? % :meet/pair-for) postings))\n   330\t          in-id (get-in posting [:dao.stream.remote/in :dao.stream/identity])]\n   331\t      (is (contains? @(:table sys) in-id) \"granted, intact at once\")\n   332\t      (testing \"no renewal is ever appended: the holder has stopped;\n   333\t                past duration + tolerance the judge reclaims\"\n   334\t        (tick! sys 20)\n   335\t        (is (not (contains? @(:table sys) in-id))\n   336\t            \"the idempotent reclaim removed the table entry\")\n   337\t        (is (= 0 (meet/active-pairs (:m sys))))\n   338\t        (let [in-refl (attach attach-a! toy-a in-id)]\n   339\t          (reset! table-atom (meet-table sys))\n   340\t          (serve! peer-a)\n   341\t          (let [ans (stream/next in-refl 0)]\n   342\t            (is (= :dao.stream/transport-error (:dao.stream/outcome ans)))\n   343\t            (is (= :dao.stream.remote/not-found\n   344\t                   (:dao.stream.remote/reason ans)))))))))\n   345\t\n   346\t\n   347\t;; =============================================================================\n   348\t;; A reconnect within tolerance finds the pair intact\n   349\t;; =============================================================================\n   350\t\n   351\t(deftest reconnect-within-tolerance-finds-pair-intact-test\n   352\t  (let [toy-a (toy \"addr-a\")\n   353\t        sys (meeting-system {:max-pairs 10 :duration {:ms 10}\n   354\t                             :tolerance {:ms 0} :holder (address toy-a)})\n   355\t        table-atom (atom (meet-table sys))\n   356\t        peer-a (served-peer table-atom toy-a)\n   357\t        attach-a! (attacher-for toy-a)\n   358\t        ra-req (attach attach-a! toy-a :meet-requests)]\n   359\t    (stream/append! ra-req {:meet/pair \"peer-b\"})\n   360\t    (serve! peer-a)\n   361\t    (meet/step! (:m sys))\n   362\t    (tick! sys 1)\n   363\t    (reset! table-atom (meet-table sys))\n   364\t    (let [postings (values (:board sys))\n   365\t          posting (first (filter #(contains? % :meet/pair-for) postings))\n   366\t          in-id (get-in posting [:dao.stream.remote/in :dao.stream/identity])]\n   367\t      (testing \"a renewal lands before duration + tolerance: the pair\n   368\t                stays intact, never reclaimed\"\n   369\t        (tick! sys 6)\n   370\t        (stream/append! (:facts sys)\n   371\t                        (lease/renewal (:dao.lease/lease posting)))\n   372\t        (is (contains? @(:table sys) in-id))\n   373\t        (tick! sys 9)\n   374\t        (is (contains? @(:table sys) in-id)\n   375\t            \"9 - 6 = 3, well within the duration the renewal bought\")\n   376\t        (let [in-refl (attach attach-a! toy-a in-id)]\n   377\t          (reset! table-atom (meet-table sys))\n   378\t          (serve! peer-a)\n   379\t          (is (not= :dao.stream.remote/not-found\n   380\t                    (:dao.stream.remote/reason (stream/next in-refl 0)))\n   381\t              \"the reconnect finds the pair intact, not gone\"))))))\n","exit_code":0,"status":"completed"}}
