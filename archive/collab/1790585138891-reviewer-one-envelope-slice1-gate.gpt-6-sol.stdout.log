{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/rpc.cljc | sed -n '427,511p'; nl -ba src/cljc/yin/repl/adapter.cljc | sed -n '100,235p'; nl -ba src/cljc/yin/repl/driver.cljc | sed -n '365,405p'\"","aggregated_output":"   427\t(defn- transport-error-reason\n   428\t  \"Translate a reflection's `:dao.stream/transport-error` into the client\n   429\t   terminal vocabulary, inspecting `:dao.stream.remote/reason` when the\n   430\t   reflection supplied one (dao.stream.remote.cljc reasons a reflection's\n   431\t   read failure this way).  A reason this translation does not recognize\n   432\t   still becomes the generic transport-error terminal, never left raw.\n   433\t\n   434\t   Each remote reason keeps its own word: `no-surface` and `oversize` are not\n   435\t   collapsed into `transport-error`.  Only `detached` is rebindable (`rebind`);\n   436\t   every other reason is terminal for the binding.\"\n   437\t  [read-result]\n   438\t  (case (:dao.stream.remote/reason read-result)\n   439\t    :dao.stream.remote/not-found :dao.stream.apply/not-found\n   440\t    :dao.stream.remote/channel-gone :dao.stream.apply/detached\n   441\t    :dao.stream.remote/no-surface :dao.stream.apply/no-surface\n   442\t    :dao.stream.remote/oversize :dao.stream.apply/oversize\n   443\t    :dao.stream.apply/transport-error))\n   444\t\n   445\t\n   446\t(defn- terminal-lost\n   447\t  \"Translate a non-ok, non-blocked, non-gap read or mint result into the\n   448\t   client's terminal vocabulary and complete every outstanding request\n   449\t   with it.  Shared by `poll-read`'s `next` failures and `mint-cursor`'s\n   450\t   terminal mint failures, so a reasoned not-found or channel-gone\n   451\t   reaches the terminal the same way regardless of which operation\n   452\t   the reflection answered it to.\"\n   453\t  [state result]\n   454\t  (let [reason (case (:dao.stream/outcome result)\n   455\t                 :dao.stream/end :dao.stream.apply/ended\n   456\t                 :dao.stream/transport-error (transport-error-reason result)\n   457\t                 :dao.stream.apply/transport-error)\n   458\t        state (lose-outstanding state reason true)]\n   459\t    (rpc-result :dao.stream.rpc/lost state\n   460\t                :dao.stream.rpc/reason reason\n   461\t                :dao.stream.rpc/read result)))\n   462\t\n   463\t\n   464\t(defn- mint-cursor\n   465\t  \"Resolve an anchor-keyword cursor through the reader.  A retryable\n   466\t   answer -- `:dao.stream/transport-error` carrying `:dao.stream/retry?\n   467\t   true` -- leaves the anchor in place for a later poll (dao.jing.content.\n   468\t   step/mint-cursor is the precedent this mirrors).  Any other non-ok\n   469\t   outcome is a reasoned terminal failure: a reflection can answer\n   470\t   `not-found` or `channel-gone` while minting a cursor\n   471\t   (dao.stream.remote.cljc's `refl-cursor`), and that must not be\n   472\t   mistaken for still-pending.  Returns `[status cursor result]`, status\n   473\t   one of `:ok`, `:retry`, `:terminal`; `result` is retained for\n   474\t   diagnostics either way.\"\n   475\t  [reader anchor]\n   476\t  (let [r (stream/cursor reader anchor)\n   477\t        outcome (:dao.stream/outcome r)]\n   478\t    (cond\n   479\t      (= :dao.stream/ok outcome) [:ok (:dao.stream/cursor r) r]\n   480\t\n   481\t      (and (= :dao.stream/transport-error outcome) (:dao.stream/retry? r))\n   482\t      [:retry anchor r]\n   483\t\n   484\t      :else [:terminal anchor r])))\n   485\t\n   486\t\n   487\t(defn- poll-read\n   488\t  [state]\n   489\t  (let [read-result (valid-operation-result :next (stream/next (:reader state) (:cursor state)))\n   490\t        outcome (:dao.stream/outcome read-result)]\n   491\t    (case outcome\n   492\t      :dao.stream/ok\n   493\t      ;; Advance before decoding. A malformed or unsolicited element is thereby\n   494\t      ;; consumed exactly once and cannot poison polling.\n   495\t      (handle-event (assoc state :cursor (:dao.stream/cursor read-result))\n   496\t                    (decode-value state (:dao.stream/value read-result)))\n   497\t\n   498\t      :dao.stream/blocked\n   499\t      (rpc-result :dao.stream.rpc/idle state :dao.stream.rpc/read read-result)\n   500\t\n   501\t      :dao.stream/gap\n   502\t      (let [state (-> state\n   503\t                      (assoc :cursor (:dao.stream/cursor read-result))\n   504\t                      (lose-outstanding :dao.stream/gap false))]\n   505\t        (rpc-result :dao.stream.rpc/lost state\n   506\t                    :dao.stream.rpc/reason :dao.stream/gap\n   507\t                    :dao.stream.rpc/read read-result))\n   508\t\n   509\t      (terminal-lost state read-result))))\n   510\t\n   511\t\n   100\t  (merge {:yin.repl.adapter/outcome outcome\n   101\t          :yin.repl.adapter/state state}\n   102\t         extra))\n   103\t\n   104\t\n   105\t(defn- append-event\n   106\t  [state event]\n   107\t  (update state :yin.repl.adapter/events conj event))\n   108\t\n   109\t\n   110\t(defn- request-outcome\n   111\t  [rpc-outcome]\n   112\t  (case rpc-outcome\n   113\t    :dao.stream.rpc/requested :yin.repl.adapter/requested\n   114\t    :dao.stream.rpc/pending-request :yin.repl.adapter/pending-request\n   115\t    :dao.stream.rpc/request-undeliverable :yin.repl.adapter/request-undeliverable\n   116\t    :dao.stream.rpc/invalid-request :yin.repl.adapter/invalid-input\n   117\t    :dao.stream.rpc/backpressure :yin.repl.adapter/backpressure\n   118\t    :dao.stream.rpc/allocator-error :yin.repl.adapter/terminal\n   119\t    :dao.stream.rpc/terminal :yin.repl.adapter/terminal\n   120\t    :yin.repl.adapter/transport-result))\n   121\t\n   122\t\n   123\t(defn submit-input\n   124\t  \"Advance one input transition.\n   125\t\n   126\t   A local command becomes an explicit event and leaves RPC state untouched, as\n   127\t   does a command this slice rejects.  Other strings are submitted as a\n   128\t   `:op/eval` request.  This function makes at\n   129\t   most one append attempt through `rpc/request!`; it never waits or retries.\"\n   130\t  [state input]\n   131\t  (cond\n   132\t    (not (string? input))\n   133\t    (let [event {:yin.repl.adapter/event :yin.repl.adapter/invalid-input\n   134\t                 :yin.repl.adapter/input input}\n   135\t          state (append-event state event)]\n   136\t      (adapter-result :yin.repl.adapter/invalid-input state\n   137\t                      :yin.repl.adapter/event event))\n   138\t\n   139\t    (rejected-command input)\n   140\t    (let [command (rejected-command input)\n   141\t          event {:yin.repl.adapter/event :yin.repl.adapter/rejected-command\n   142\t                 :yin.repl.adapter/command command\n   143\t                 :yin.repl.adapter/input input}\n   144\t          state (append-event state event)]\n   145\t      (adapter-result :yin.repl.adapter/rejected-command state\n   146\t                      :yin.repl.adapter/event event))\n   147\t\n   148\t    (local-command input)\n   149\t    (let [command (local-command input)\n   150\t          event {:yin.repl.adapter/event :yin.repl.adapter/local-command\n   151\t                 :yin.repl.adapter/command command\n   152\t                 :yin.repl.adapter/input input}\n   153\t          state (append-event state event)]\n   154\t      (adapter-result :yin.repl.adapter/local-command state\n   155\t                      :yin.repl.adapter/event event))\n   156\t\n   157\t    :else\n   158\t    (let [rpc-result (rpc/request! (:yin.repl.adapter/rpc state)\n   159\t                                   eval-operation\n   160\t                                   [input])\n   161\t          state (assoc state :yin.repl.adapter/rpc\n   162\t                       (:dao.stream.rpc/state rpc-result))]\n   163\t      (adapter-result (request-outcome (:dao.stream.rpc/outcome rpc-result))\n   164\t                      state\n   165\t                      :yin.repl.adapter/rpc-result rpc-result))))\n   166\t\n   167\t\n   168\t(defn- completion-event\n   169\t  [completion]\n   170\t  (let [base {:yin.repl.adapter/id (:dao.stream.rpc/id completion)\n   171\t              :yin.repl.adapter/op (:dao.stream.rpc/op completion)\n   172\t              :yin.repl.adapter/args (:dao.stream.rpc/args completion)}]\n   173\t    (if-let [response (:dao.stream.rpc/response completion)]\n   174\t      (if (rpc/answer-ok? response)\n   175\t        (assoc base\n   176\t               :yin.repl.adapter/event :yin.repl.adapter/response\n   177\t               :yin.repl.adapter/value (rpc/answer-ok response))\n   178\t        (assoc base\n   179\t               :yin.repl.adapter/event :yin.repl.adapter/response\n   180\t               :yin.repl.adapter/error (rpc/answer-error response)))\n   181\t      (assoc base\n   182\t             :yin.repl.adapter/event :yin.repl.adapter/lost\n   183\t             :yin.repl.adapter/reason (:dao.stream.rpc/reason completion)))))\n   184\t\n   185\t\n   186\t(defn publish-completions\n   187\t  \"Move RPC's completion outbox into the REPL event outbox exactly once.\n   188\t   The returned RPC state has an empty completion vector, so a later driver tick\n   189\t   cannot publish the same correlated response or loss again.\"\n   190\t  [state]\n   191\t  (let [[completions rpc-state] (rpc/take-completed (:yin.repl.adapter/rpc state))\n   192\t        events (mapv completion-event completions)\n   193\t        state (-> state\n   194\t                  (assoc :yin.repl.adapter/rpc rpc-state)\n   195\t                  (update :yin.repl.adapter/events into events))]\n   196\t    (adapter-result (if (seq events)\n   197\t                      :yin.repl.adapter/published\n   198\t                      :yin.repl.adapter/idle)\n   199\t                    state\n   200\t                    :yin.repl.adapter/events events)))\n   201\t\n   202\t\n   203\t(defn poll-responses\n   204\t  \"Poll up to `budget` response values, then publish any correlated completion\n   205\t   values as REPL events.  `:blocked` returns immediately through `rpc/poll!`.\n   206\t   No host asynchronous value, callback, or scheduler is introduced.\"\n   207\t  ([state] (poll-responses state 1))\n   208\t  ([state budget]\n   209\t   (let [rpc-result (rpc/poll! (:yin.repl.adapter/rpc state) budget)\n   210\t         state (assoc state :yin.repl.adapter/rpc\n   211\t                      (:dao.stream.rpc/state rpc-result))\n   212\t         published (publish-completions state)\n   213\t         state (:yin.repl.adapter/state published)\n   214\t         rpc-outcome (:dao.stream.rpc/outcome rpc-result)\n   215\t         outcome (cond\n   216\t                   (seq (:yin.repl.adapter/events published))\n   217\t                   :yin.repl.adapter/responded\n   218\t\n   219\t                   (= rpc-outcome :dao.stream.rpc/idle)\n   220\t                   :yin.repl.adapter/idle\n   221\t\n   222\t                   (= rpc-outcome :dao.stream.rpc/terminal)\n   223\t                   :yin.repl.adapter/terminal\n   224\t\n   225\t                   :else :yin.repl.adapter/transport-result)]\n   226\t     (adapter-result outcome state\n   227\t                     :yin.repl.adapter/rpc-result rpc-result\n   228\t                     :yin.repl.adapter/events\n   229\t                     (:yin.repl.adapter/events published)))))\n   230\t\n   231\t\n   232\t(defn take-events\n   233\t  \"Return `[events next-state]`, clearing the adapter event outbox exactly once.\n   234\t   Drivers interpret local-command events locally and render response/loss events\n   235\t   in their own host loop.\"\n   365\t\n   366\t      (and (remote-routed? state) (not (remote-terminal state)))\n   367\t      (publish state :yin.repl.driver/notice\n   368\t               (str \"Already connected to \"\n   369\t                    (or (:url (:connection state)) \"the remote shell\")\n   370\t                    \"; (disconnect) first\"))\n   371\t\n   372\t      :else (open-connection state url))))\n   373\t\n   374\t\n   375\t(defn- submit-remote\n   376\t  [state line]\n   377\t  (let [result (adapter/submit-input (:adapter state) line)\n   378\t        state (assoc state :adapter (:yin.repl.adapter/state result))]\n   379\t    (case (:yin.repl.adapter/outcome result)\n   380\t      :yin.repl.adapter/requested\n   381\t      (assoc state\n   382\t             :outstanding (get-in result [:yin.repl.adapter/rpc-result\n   383\t                                          :dao.stream.rpc/id])\n   384\t             :retrying nil)\n   385\t\n   386\t      ;; The request was allocated but the writer answered `full`.  The same\n   387\t      ;; encoded request, with the same id, is retried on a later step.\n   388\t      :yin.repl.adapter/pending-request\n   389\t      (assoc state :retrying line)\n   390\t\n   391\t      (-> state\n   392\t          (assoc :retrying nil)\n   393\t          (publish :yin.repl.driver/notice\n   394\t                   (str \";; request not sent: \"\n   395\t                        (name (:yin.repl.adapter/outcome result))))))))\n   396\t\n   397\t\n   398\t(defn- handle-line\n   399\t  [state line]\n   400\t  (let [command (adapter/local-command line)]\n   401\t    (cond\n   402\t      ;; A shell that has quit evaluates nothing more.  Hosts append an\n   403\t      ;; end-of-input `(quit)` that a typed `(quit)` has already answered.\n   404\t      (not (:running? state)) state\n   405\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/serve.cljc | sed -n '490,535p'; nl -ba src/cljc/dao/stream/remote.cljc | sed -n '35,75p;585,660p'; rg -n 'dao.stream.rpc/(id|op|args|ok|error|code|message)' src test | head -100\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/serve.cljc | sed -n '490,535p'; nl -ba src/cljc/dao/stream/remote.cljc | sed -n '35,75p;585,660p'; rg -n 'dao.stream.rpc/(id|op|args|ok|error|code|message)' src test | head -100\"","aggregated_output":"   490\t  [endpoint]\n   491\t  (loop [remaining request-budget\n   492\t         endpoint endpoint]\n   493\t    (cond\n   494\t      (zero? remaining) endpoint\n   495\t\n   496\t      (:pending-answer endpoint)\n   497\t      (let [endpoint (deliver-answer endpoint)]\n   498\t        (if (:pending-answer endpoint)\n   499\t          endpoint\n   500\t          (recur (dec remaining) endpoint)))\n   501\t\n   502\t      :else\n   503\t      (let [result (stream/next (:requests endpoint) (:requests-cursor endpoint))\n   504\t            outcome (:dao.stream/outcome result)]\n   505\t        (case outcome\n   506\t          :dao.stream/ok\n   507\t          (let [request (:dao.stream/value result)\n   508\t                successor (:dao.stream/cursor result)]\n   509\t            (cond\n   510\t              (rpc/request-value? request)\n   511\t              (let [[repl' answer] (evaluate (:repl endpoint) request)]\n   512\t                (recur remaining\n   513\t                       (assoc endpoint\n   514\t                              :repl repl'\n   515\t                              :pending-answer answer\n   516\t                              :pending-successor successor)))\n   517\t\n   518\t              ;; Correlatable but malformed: an error answer at least tells\n   519\t              ;; the caller their own request failed, distinct from silence.\n   520\t              (and (map? request) (rpc/safe-id? (rpc/request-id request)))\n   521\t              (recur remaining\n   522\t                     (assoc endpoint\n   523\t                            :pending-answer\n   524\t                            (rpc/error-answer (rpc/request-id request)\n   525\t                                              :yin.repl.serve/malformed-request\n   526\t                                              \"Malformed request envelope\")\n   527\t                            :pending-successor successor))\n   528\t\n   529\t              :else\n   530\t              (recur (dec remaining)\n   531\t                     (-> endpoint\n   532\t                         (assoc :requests-cursor successor)\n   533\t                         (publish :yin.repl.serve/diagnostic\n   534\t                                  \";; malformed request dropped\")))))\n   535\t\n    35\t  #{:dao.stream/descriptor :dao.stream/cursor :dao.stream/next\n    36\t    :dao.stream/append!})\n    37\t\n    38\t\n    39\t(def ^:private protocol-errors\n    40\t  \"The three protocol errors, one answer shape for every operation,\n    41\t   a key instead of an outcome map because no operation's outcome set\n    42\t   can carry them.\"\n    43\t  #{:dao.stream.remote/not-found\n    44\t    :dao.stream.remote/no-surface\n    45\t    :dao.stream.remote/oversize})\n    46\t\n    47\t\n    48\t(defn- well-formed-request?\n    49\t  \"True when `v` is a well-formed request: a map naming its identity\n    50\t   and one of the four wire ops, carrying an args vector and the\n    51\t   asker-minted id. Anything else is dropped as malformed wire input.\"\n    52\t  [v]\n    53\t  (and (map? v)\n    54\t       (contains? v :dao.stream/identity)\n    55\t       (contains? wire-ops (:dao.stream.remote/op v))\n    56\t       (vector? (:dao.stream.remote/args v))\n    57\t       (contains? v :dao.stream.remote/id)))\n    58\t\n    59\t\n    60\t(defn- well-formed-answer?\n    61\t  \"True when `v` is a well-formed answer: a map carrying the id and\n    62\t   the identity and either a protocol error or an outcome map.\"\n    63\t  [v]\n    64\t  (and (map? v)\n    65\t       (contains? v :dao.stream.remote/id)\n    66\t       (contains? v :dao.stream/identity)\n    67\t       (or (contains? protocol-errors (:dao.stream.remote/error v))\n    68\t           (stream/outcome-map? v))))\n    69\t\n    70\t\n    71\t(defn- required-surface\n    72\t  \"The declared surface `op` needs, under the fixed mapping: cursor\n    73\t   and next need :reader, append! needs :writer, descriptor needs no\n    74\t   surface and is always answerable.\"\n    75\t  [op]\n   585\t(defn- refl-cursor\n   586\t  \"The cursor operation: a filed answer for the anchor is returned,\n   587\t   and a filed protocol error translated; otherwise a cursor request\n   588\t   is sent if none is outstanding, and the answer is transport-error\n   589\t   with :dao.stream/retry? true. Once closed, cursor answers closed;\n   590\t   once gone, transport-error naming not-found.\"\n   591\t  [refl a]\n   592\t  (let [link (:link @refl)]\n   593\t    (drain! link)\n   594\t    (cond\n   595\t      (:closed? @refl) (result :dao.stream/closed)\n   596\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   597\t      (surface-lacks? refl :dao.stream/cursor)\n   598\t      (translated :dao.stream.remote/no-surface)\n   599\t      :else\n   600\t      (or (filed-cursor link refl a)\n   601\t          (when-not (:channel-gone? @link)\n   602\t            (send-or-count! link refl :dao.stream/cursor a)\n   603\t            (retry-read))\n   604\t          (translated :dao.stream.remote/channel-gone)))))\n   605\t\n   606\t\n   607\t(defn- refl-next\n   608\t  \"The next operation: a filed answer for the cursor is returned and\n   609\t   forgotten; otherwise a next request is sent if none is outstanding,\n   610\t   and the answer is blocked -- nothing is observable at this position\n   611\t   through this handle yet. After close, filed outcomes then end. The\n   612\t   reflection never judges a cursor: cursor-mismatch and\n   613\t   invalid-cursor are only ever relayed from the source.\"\n   614\t  [refl c]\n   615\t  (let [link (:link @refl)]\n   616\t    (drain! link)\n   617\t    (cond\n   618\t      (:closed? @refl)\n   619\t      (or (filed-next! link refl c) (result :dao.stream/end))\n   620\t\n   621\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   622\t\n   623\t      (surface-lacks? refl :dao.stream/next)\n   624\t      (translated :dao.stream.remote/no-surface)\n   625\t\n   626\t      :else\n   627\t      (or (filed-next! link refl c)\n   628\t          (when-not (:channel-gone? @link)\n   629\t            (send-or-count! link refl :dao.stream/next c)\n   630\t            (result :dao.stream/blocked))\n   631\t          (translated :dao.stream.remote/channel-gone)))))\n   632\t\n   633\t\n   634\t(defn- refl-append\n   635\t  \"The append! operation: send the request and return the channel\n   636\t   writer's outcome -- ok is acceptance on the outbound path, exactly\n   637\t   the contract's Writing rule for a transport that carries values\n   638\t   toward a stream elsewhere. The source's outcome is emitted on the\n   639\t   event writer when it is filed, correlated by id; append! never\n   640\t   answers the source's full. Only an accepted send is in flight: a\n   641\t   refused append! never crossed, so its effect is not unknown.\"\n   642\t  [refl v]\n   643\t  (let [link (:link @refl)]\n   644\t    (drain! link)\n   645\t    (cond\n   646\t      (:closed? @refl) (result :dao.stream/closed)\n   647\t      (:gone? @refl) (translated :dao.stream.remote/not-found)\n   648\t      (surface-lacks? refl :dao.stream/append!)\n   649\t      (translated :dao.stream.remote/no-surface)\n   650\t      :else\n   651\t      (let [req (wire-request link refl :dao.stream/append! [v])\n   652\t            r (stream/append! (:writer @link) req)]\n   653\t        (when (= :dao.stream/ok (:dao.stream/outcome r))\n   654\t          (register! link refl req))\n   655\t        r))))\n   656\t\n   657\t\n   658\t(defn- refl-close\n   659\t  \"The close! operation, local: the reflection forgets 