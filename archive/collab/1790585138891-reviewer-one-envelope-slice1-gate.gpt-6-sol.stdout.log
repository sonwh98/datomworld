op args-key args})\n    36\t\n    37\t\n    38\t(defn request?\n    39\t  \"True when value is a valid request envelope.  Unknown keys are intentionally\n    40\t   ignored so the envelope remains open.\"\n    41\t  [value]\n    42\t  (and (map? value)\n    43\t       (correlation-id? (get value id-key))\n    44\t       (keyword? (get value op-key))\n    45\t       (vector? (get value args-key))))\n    46\t\n    47\t\n    48\t(defn request-id\n    49\t  [value]\n    50\t  (get value id-key))\n    51\t\n    52\t\n    53\t(defn request-op\n    54\t  [value]\n    55\t  (get value op-key))\n    56\t\n    57\t\n    58\t(defn request-args\n    59\t  [value]\n    60\t  (get value args-key))\n    61\t\n    62\t\n    63\t(defn error\n    64\t  \"Construct portable error data.  Codes are qualified keywords and messages\n    65\t   are ordinary strings, never host exception values.\"\n    66\t  [code message]\n    67\t  {code-key code message-key message})\n    68\t\n    69\t\n    70\t(defn error?\n    71\t  [value]\n    72\t  (and (map? value)\n    73\t       (stream/qualified-keyword?* (get value code-key))\n    74\t       (string? (get value message-key))))\n    75\t\n    76\t\n    77\t(defn success-response\n    78\t  \"Construct a successful response preserving the request id.\"\n    79\t  [id value]\n    80\t  {id-key id ok-key value})\n    81\t\n    82\t\n    83\t(defn error-response\n    84\t  \"Construct an error response preserving the request id.\"\n    85\t  [id code message]\n    86\t  {id-key id error-key (error code message)})\n    87\t\n    88\t\n    89\t(defn response?\n    90\t  \"True when value is a valid response envelope.  A response contains exactly\n    91\t   one of `:dao.stream.apply/ok` or `/error`; nil is a valid success value.\"\n    92\t  [value]\n    93\t  (and (map? value)\n    94\t       (correlation-id? (get value id-key))\n    95\t       (not= (contains? value ok-key) (contains? value error-key))\n    96\t       (or (contains? value ok-key)\n    97\t           (error? (get value error-key)))))\n    98\t\n    99\t\n   100\t(defn response-id\n   101\t  [value]\n   102\t  (get value id-key))\n   103\t\n   104\t\n   105\t(defn response-ok\n   106\t  [value]\n   107\t  (get value ok-key))\n   108\t\n   109\t\n   110\t(defn response-error\n   111\t  [value]\n   112\t  (get value error-key))\n   113\t\n   114\t\n   115\t;; =============================================================================\n   116\t;; Endpoint descriptors and explicit stream helpers\n   117\t;; =============================================================================\n   118\t\n   119\t(def request-key :dao.stream.apply/request)\n   120\t(def response-key :dao.stream.apply/response)\nsrc/cljc/dao/stream/remote.cljc:43:  #{:dao.stream.remote/not-found\nsrc/cljc/dao/stream/remote.cljc:44:    :dao.stream.remote/no-surface\nsrc/cljc/dao/stream/remote.cljc:45:    :dao.stream.remote/oversize})\nsrc/cljc/dao/stream/remote.cljc:60:(defn- well-formed-answer?\nsrc/cljc/dao/stream/remote.cljc:135:                                    :dao.stream.remote/oversize)))))\nsrc/cljc/dao/stream/remote.cljc:155:                                   :dao.stream.remote/not-found))\nsrc/cljc/dao/stream/remote.cljc:168:                                         :dao.stream.remote/no-surface))\nsrc/cljc/dao/stream/remote.cljc:208:          :dao.stream/end cursor\nsrc/cljc/dao/stream/remote.cljc:414:  (when (well-formed-answer? v)\nsrc/cljc/dao/stream/remote.cljc:425:              (= :dao.stream.remote/not-found e)\nsrc/cljc/dao/stream/remote.cljc:494:          :dao.stream/end (channel-loss! link)\nsrc/cljc/dao/stream/remote.cljc:596:      (:gone? @refl) (translated :dao.stream.remote/not-found)\nsrc/cljc/dao/stream/remote.cljc:598:      (translated :dao.stream.remote/no-surface)\nsrc/cljc/dao/stream/remote.cljc:604:          (translated :dao.stream.remote/channel-gone)))))\nsrc/cljc/dao/stream/remote.cljc:619:      (or (filed-next! link refl c) (result :dao.str