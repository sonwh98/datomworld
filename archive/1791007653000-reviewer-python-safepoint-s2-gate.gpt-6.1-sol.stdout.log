 tail call pushes no frame on the VMs that honour the\n   mark, so a mark is only sound for the tree it was computed over: a stage\n   that wraps a body must strip every mark and recompute them over the whole\n   derived tree, or a wrapped body's old tail calls would skip the wrapper.\"\n  (:require\n    [yin.vm :as vm]))\n\n\n(defn mark-tails\n  \"Set `:tail? true` on every application in tail position of a lambda body,\n   through `if` branches. Definitions are never marked. Lowering relies on\n   this for loops, which are self-applied lambdas: the recursive call and the\n   sequencing lambda around it are both tail calls, so an iteration grows no\n   continuation on the VMs that honour the mark.\"\n  [node]\n  (letfn [(walk\n            [node tail?]\n            (case (:type node)\n              :lambda (assoc node :body (walk (:body node) true))\n              :if (assoc node\n                         :test (walk (:test node) false)\n                         :consequent (walk (:consequent node) tail?)\n                         :alternate (walk (:alternate node) tail?))\n              :application\n              (let [definition? (= 'yin/def (:name (:operator node)))\n                    node (assoc node\n                                :operator (walk (:operator node) false)\n                                :operands (mapv #(walk % false)\n                                                (:operands node)))]\n                (if (and tail? (not definition?))\n                  (assoc node :tail? true)\n                  node))\n              node))]\n    (walk node false)))\n\n\n(defn strip-tails\n  \"`node` with every `:tail?` mark removed, at every depth and under every\n   node type the row grammar knows, so `mark-tails` starts from nothing.\"\n  [node]\n  (let [slots (get vm/semantic-bytecode-grammar (:type node))]\n    (reduce (fn [n [field kind]]\n              (case kind\n                :node (update n field strip-tails)\n                :nodes (update n field #(mapv strip-tails %))\n                n))\n            (dissoc node :tail?)\n            slots)))\n\n\n(defn remark-tails\n  \"Strip every tail mark and recompute them over the whole of `node`.\"\n  [node]\n  (mark-tails (strip-tails node)))\n   550\t            frame's depth: while a RecursionError unwinds, the finally of\n   551\t            each of frames 1..99 calls h() within the limit; only frame\n   552\t            100's call exceeds it\"\n   553\t    (every= [true false {:py/out [\"unwound\" \"100\" \"89\" \"100\" \"99\" \"100\"],\n   554\t                         :py/exception nil}]\n   555\t            (hooked (limited programs/unwind 100)))))\n   556\t\n   557\t\n   558\t(deftest generator-depth-test\n   559\t  (testing \"under limit 100, depth measures the current continuation. A\n   560\t            generator resumed 20 frames down runs on top of its resumer\n   561\t            (its own frame is the 21st), so probe inside finds 79; resumed\n   562\t            again from the top it is rebased to its new resumer, so probe\n   563\t            finds 99. Every crossing back restores the caller's record, so\n   564\t            probe at the top finds 100. gen2 is rebased from 21 to 1 between\n   565\t            its yields and then raises and catches within one activation:\n   566\t            the escape restores its snapshot relative to the current base,\n   567\t            so probe finds 99, not 79\"\n   568\t    (every= [true false {:py/out [\"79\" \"99\" \"100\" \"79\" \"100\" \"79\" \"99\" \"100\"],\n   569\t                         :py/exception nil}]\n   570\t            (hooked (limited programs/generators 100)))))\n   571\t\n   572\t\n   573\t(defn- run-module-form\n   574\t  \"`(py/run-module (fn [g gf] body))`.\"\n   575\t  [body]\n   576\t  (list 'py/run-module (list 'fn '[g gf] body)))\n   577\t\n   578\t\n   579\t(deftest set-recursion-limit-test\n   580\t  (testing \"a lower limit takes effect\"\n   581\t    (every= [true false {:py/out [\"50\"], :py/exception nil}]\n   582\t            (hooked (limited programs/probe 50))))\n   583\t  (testing \"the limit reads back: the default, then the one set\"\n   584\t    (every= [true false {:py/out [\"1000\" \"50\"], :py/exception nil}]\n   585\t            (hooked (with-run (derived-ast programs/probe)\n   586\t                      (fn [_]\n   587\t                        (u/sexp->uast\n   588\t                          (run-module-form\n   589\t                            '(do (py/print (py/conj [] (py.sp/recursion-limit)))\n   590\t                                 (py.sp/set-recursion-limit! 50)\n   591\t                                 (py/print (py/conj [] (py.sp/recursion-limit)))))))))))\n   592\t  (testing \"an invalid argument raises the Python error and keeps the limit\"\n   593\t    (doseq [[arg error message] [[0 \"ValueError\" \"recursion limit must be greater or equal than 1\"]\n   594\t                                 [-3 \"ValueError\" \"recursion limit must be greater or equal than 1\"]\n   595\t                                 [{:py/str \"50\"} \"TypeError\" \"an integer is required\"]\n   596\t                                 [:py/None \"TypeError\" \"an integer is required\"]]]\n   597\t      (every= [true false {:py/out [\"1000\"], :py/exception {:type error, :args [message]}}]\n   598\t              (hooked (with-run (derived-ast programs/probe)\n   599\t                        (fn [_]\n   600\t                          (u/sexp->uast\n   601\t                            (run-module-form\n   602\t                              (list 'py/try\n   603\t                                    (list 'fn [] (list 'py.sp/set-recursion-limit! arg))\n   604\t                                    '(fn [e]\n   605\t                                       (do (py/print (py/conj [] (py.sp/recursion-limit)))\n   606\t                                           (py/raise e)))\n   607\t                                    '(fn [] :py/None))))))))))\n   608\t  (testing \"a valid change persists across an escape: the limit is outside\n   609\t            the escape-restored record\"\n   610\t    (every= [true false {:py/out [\"50\"], :py/exception nil}]\n   611\t            (hooked (with-run (derived-ast programs/probe)\n   612\t                      (fn [_]\n   613\t                        (u/sexp->uast\n   614\t                          (run-module-form\n   615\t                            '(py/try (fn []\n   616\t                                       (do (py.sp/set-recursion-limit! 50)\n   617\t                                           (py/raise-new py.b/ValueError {:py/str \"x\"})))\n   618\t                                     (fn [e] (py/print (py/conj [] (py.sp/recursion-limit))))\n   619\t                                     (fn [] :py/None)))))))))\n   620\t  (testing \"at depth 5, a limit of 5 or below raises RecursionError and keeps\n   621\t            the old limit; 6 is accepted\"\n   622\t    (doseq [[n expected]\n   623\t            [[5 {:py/out [\"1000\"],\n   624\t                 :py/exception {:type \"RecursionError\",\n   625\t                                :args [\"cannot set the recursion limit: the limit is too low\"]}}]\n   626\t             [3 {:py/out [\"1000\"],\n   627\t                 :py/exception {:type \"RecursionError\",\n   628\t                                :args [\"cannot set the recursion limit: the limit is too low\"]}}]\n   629\t             [6 {:py/out [\"6\"], :py/exception nil}]]]\n   630\t      (every= [true false expected]\n   631\t              (hooked (with-run (derived-ast programs/probe)\n   632\t                        (fn [_]\n   633\t                          (u/sexp->uast\n   634\t                            (run-module-form\n   635\t                              (list 'do\n   636\t                                    '(py.sp/call) '(py.sp/call) '(py.sp/call) '(py.sp/call)\n   637\t                                    '(py.sp/call)\n   638\t                                    (list 'py/try\n   639\t                                          (list 'fn [] (list 'py.sp/set-recursion-limit! n))\n   640\t                                          '(fn [e]\n   641\t                                             (do (py/print (py/conj [] (py.sp/recursion-limit)))\n   642\t                                                 (py/raise e)))\n   643\t                                          '(fn [] (py/print (py/conj [] (py.sp/recursion-limit)))))))))))))))\n5:   prelude delivers signals. Programs come from hand-built CST packets (the\n78:  \"try:\\n    while True:\\n        pass\\nexcept KeyboardInterrupt:\\n\n94:        [:except_clause [\"EXCEPT\" \"except\"] (test-chain (atom-of (nm \"KeyboardInterrupt\")))]\n196:  \"`{vm-key (f halted-or-blocked-vm)}`; a throw becomes `[:thrown message]`.\"\n202:                         [:thrown (ex-message e)]))]))\n206:(defn- with-signals\n207:  \"A `prep` handing the task a signal stream holding `signals`.\"\n208:  [signals]\n211:      (doseq [s signals] (stream/append! handle s))\n213:        (assoc-in vm [:store hooks/signals-key] ref)))))\n389:  (testing \"while True: pass with one pre-appended signal ends with\n390:            KeyboardInterrupt\"\n391:    (every= [true false {:py/out [], :py/exception {:type \"KeyboardInterrupt\",\n393:            (derived while-true-pass hooks/uast (with-signals [2]))))\n394:  (testing \"wrapped in try/except KeyboardInterrupt, the handler prints\"\n396:            (derived caught hooks/uast (with-signals [2])))))\n400:  (testing \"with an empty signal stream the derived program finishes without\n403:            (derived def-and-while hooks/uast (with-signals [])))))\n407:  (testing \"a registered Python handler is called with the signal and None,\n424:                           (with-signals [7])\n428:(deftest fail-closed-test\n430:    (every= [:thrown \"Unable to resolve symbol: py.sp/loop in this context\"]\n435:  (testing \"the naive program reads KeyboardInterrupt as a builtin its own\n438:      (is (contains? (names-in ast) 'py.b/KeyboardInterrupt))\n439:      (is (some #(= 'py.b/KeyboardInterrupt (:value (first (:operands %))))\n452:  (testing \"with only the signal stream and no base prelude, the hook prelude\n454:    (doseq [[k result] (on-every-vm hooks/uast (with-signals [])\n478:             [py.sp/cursor (stream/cursor py.sp/signals)]]))))\n499:                              (assoc-in ((with-signals []) vm) [:store 'py.sp/park-at] n))\n527:  (on-every-vm (hooks/program hooks/uast ast) (with-signals []) outcome))\n","exit_code":0,"status":"completed"}}
