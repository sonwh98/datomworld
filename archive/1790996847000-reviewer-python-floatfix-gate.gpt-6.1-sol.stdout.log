 327\t      (doseq [[k run] runners]\n   328\t        (let [r (try (run ast)\n   329\t                     (catch #?(:cljd Object :clj Exception :cljs :default) e\n   330\t                       [:thrown (ex-message e) (ex-data e)]))]\n   331\t          #?(:cljs (is (and (vector? r)\n   332\t                            (= :thrown (first r))\n   333\t                            (re-find #\"float64 carrier\" (str (second r) (pr-str (nth r 2)))))\n   334\t                       (str k \" \" (pr-str r)))\n   335\t             :default (is (== 3.0 r) (str k))))))))\n   336\t\n   337\t\n   338\t(deftest dict-keys-test\n   339\t  (testing \"1, 1.0 and True key one entry, -0.0 keys as 0, and a float key\n   340\t            is float64 content: the same bytes on every host\"\n   341\t    (let [run (fn [form]\n   342\t                (into {}\n   343\t                      (map (fn [[k r]]\n   344\t                             [k (try (r (u/mark-tails\n   345\t                                          (u/then prelude/functions-uast\n   346\t                                                  (u/sexp->uast form))))\n   347\t                                     (catch #?(:cljd Object :clj Exception\n   348\t                                               :cljs :default) e\n   349\t                                       [:thrown (ex-message e)]))]))\n   350\t                      runners))\n   351\t          form (list 'py/conj\n   352\t                     (list 'py/conj\n   353\t                           (list 'py/conj\n   354\t                                 (list 'py/conj [] '(py/key true))\n   355\t                                 (list 'py/key {:py/float (cbor/float64 1)}))\n   356\t                           (list 'py/key {:py/float (cbor/float64 (neg-zero))}))\n   357\t                     (list 'py/key {:py/float (cbor/float64 0.5)}))]\n   358\t      (doseq [[k result] (run form)]\n   359\t        (is (= [1 1 0 (cbor/float64 0.5)] result) (str k))\n   360\t        (is (=