nd-> peers tpeer (conj tpeer))\n   350\t            [_ lhost lport] (when listen\n   351\t                              (re-matches #\"(?:(.+):)?(\\d+)\" listen))\n   352\t            key (or key (when (= \"init\" verb) (state-path name \".key\")))]\n   353\t        [(cond-> [\"--index-store\" (str \"dht:\" (or dir (state-path name \"\")))]\n   354\t           (= \"init\" verb) (conj \"--dht-publish\")\n   355\t           key (into [\"--dht-key\" key])\n   356\t           lhost (into [\"--dht-bind\" lhost])\n   357\t           lport (into [\"--dht-port\" lport])\n   358\t           principal (into [\"--dht-principal\" principal])\n   359\t           manifest (into [\"--dht-manifest\" manifest])\n   360\t           true (into (mapcat #(vector \"--dht-peer\" %)) peers)\n   361\t           true (into rest))\n   362\t         {:new-key (when (= \"init\" verb) key)\n   363\t          :name name\n   364\t          :dir (or dir (state-path name \"\"))\n   365\t          ;; only `init` publishes: a saved --dht-publish must not survive\n   366\t          ;; `serve` or `join`\n   367\t          :unset (when-not (= \"init\" verb) #{\"--dht-publish\"})}]))))\n   628\t(defn- save-state!\n   629\t  \"Save the flags this run resolved to the node directory's state file when\n   630\t   they differ from what was saved (nothing is written for a bare run with\n   631\t   nothing saved), and answer the banner's lines about it.  A file that\n   632\t   cannot be written is a warning, never a refusal: the node still starts.\"\n   633\t  [dir saved resolved reset?]\n   634\t  (let [path (state/path dir)\n   635\t        changed (state/changed (or saved {}) resolved)]\n   636\t    (try\n   637\t      (cond\n   638\t        (and (nil? saved) (empty? resolved) (not reset?))\n   639\t        []\n   640\t\n   641\t        (nil? saved)\n   642\t        (do (state/save! dir resolved)\n   643\t            [(str \"state: \" (if reset? \"reset, \" \"\") \"saved to \" path\n   644\t                 