ing))\n   783\t            (undecodable! {:yin.k/path (conj path :yin.k/request)}))\n   784\t          (when-not (marker? (:yin.k/response pending))\n   785\t            (undecodable! {:yin.k/path (conj path :yin.k/response)})))\n   786\t\n   787\t      (:link-request :link-response)\n   788\t      (do (require-keys pending [:yin.k/link-id :yin.k/name\n   789\t                                 :yin.k/request :yin.k/response\n   790\t                                 :yin.k/cell]\n   791\t                        path)\n   792\t          (check-cell cells (:yin.k/cell pending)\n   793\t                      (conj path :yin.k/cell))\n   794\t          (when-not (marker? (:yin.k/request pending))\n   795\t            (undecodable! {:yin.k/path (conj path :yin.k/request)}))\n   796\t          (when-not (marker? (:yin.k/response pending))\n   797\t            (undecodable! {:yin.k/path (conj path :yin.k/response)}))\n   798\t          (when (= :link-request reason)\n   799\t            (require-keys pending [:yin.k/envelope] path)))\n   800\t\n   801\t      :install\n   802\t      (require-keys pending [:yin.k/name] path)\n   803\t\n   804\t      (undecodable! {:yin.k/reason reason :yin.k/path path}))))\n   805\t\n   806\t\n   807\t(defn- validate-registers\n   808\t  [code r path]\n   809\t  (doseq [k [:yin.k/pc :yin.k/env :yin.k/stack :yin.k/k]]\n   810\t    (when-not (contains? r k)\n   811\t      (undecodable! {:yin.k/path (conj path k)})))\n   812\t  (when-some [a (:yin.k/segment r)]\n   813\t    (when-not (contains? code a)\n   814\t      (undecodable! {:yin.k/segment a :yin.k/path path}))))\n   815\t\n   816\t\n   817\t(defn- validate-frames\n   818\t  [body code cells]\n   819\t  (let [frames (:yin.k/frames body)]\n   820\t    (when (some? frames)\n   821\t      (when-not (vector? frames)\n   822\t        (undecodable! {:yin.k/path [:yin.k/frames]}))\n   823\t      (mapv (fn [i frame]\n   824\t              (let [path [:yin.k/frames i]]\n   825\t                (when-not (and (map? frame)\n   826\t                               (map? (:yin.k/registers frame)))\n   827\t                  (undecodable! {:yin.k/path path}))\n   828\t                (validate-registers code (:yin.k/registers frame)\n   829\t                                    (conj path :yin.k/registers))\n   830\t                (when-not (map? (:yin.k/pending frame))\n   831\t                  (undecodable! {:yin.k/path\n   832\t                                 (conj path :yin.k/pending)}))\n   833\t                (validate-pending cells (:yin.k/pending frame)\n   834\t                                  (conj path :yin.k/pending))))\n   835\t            (range)\n   836\t            frames))))\n   837\t\n   838\t\n   839\t(defn- referenced-cells\n   840\t  \"Every cell id the body names: through the pendings' own cell\n   841\t   fields, and through the cursor-ref markers of every encoded value\n   842\t   it carries.  Exactly these, and the body's cells, must agree.\"\n   843\t  [body]\n   844\t  (let [frames (or (:yin.k/frames body) [])\n   845\t        direct (mapcat (fn [p]\n   846\t                         (remove nil? [(:yin.k/cell p)\n   847\t                                       (:yin.k/response-cell p)]))\n   848\t                       (map :yin.k/pending frames))\n   849\t        values (concat (map :yin.k/value (map :yin.k/pending frames))\n   850\t                       (vals (:yin.k/store body))\n   851\t                       (mapcat vals (vals (:yin.k/module-stores body)))\n   852\t                       (vals (:yin.k/parked body))\n   853\t                       (when (contains? body :yin.k/result)\n   854\t                         [(:yin.k/result body)]))]\n   855\t    (into (set direct)\n   856\t          (mapcat (fn [v] (when (some? v) (cell-ids-of v))))\n   857\t          values)))\n   858\t\n   859\t\n   860\t(defn validate-body\n   861\t  \"The body grammar both ends run (S7.5.4): the tag, the version, the\n   862\t   kind's own shape, every cell reference resolved to exactly the\n   863\t   cells the body carries -- none missing, none extra -- every pending\n   864\t   a known variant with the keys that variant requires, every frame's\n   865\t   segment among the code the body names, and each code vector still\n   866\t   hashing to its own address and admissible as a vector.  A malformed\n   867\t   body is refused whole, before any attachment or restoration.\"\n   868\t  [body]\n   869\t  (when-not (and (map? body) (true? (get body handoff-tag)))\n   870\t    (undecodable! {:yin.k/kind :body}))\n   871\t  (when-not (= handoff-version (:yin.k/version body))\n   872\t    (refuse! :yin.k/profile-mismatch\n   873\t             {:yin.k/version (:yin.k/version body)}))\n   874\t  (let [kind (:yin.k/kind body)\n   875\t        cells (or (:yin.k/cells body) {})\n   876\t        code (or (:yin.k/code body) {})]\n   877\t    (when-not (contains? #{:blocked :parked :halted} kind)\n   878\t      (undecodable! {:yin.k/kind kind :yin.k/path [:yin.k/kind]}))\n   879\t    (when-not (and (map? cells) (map? code))\n   880\t      (undecodable! {:yin.k/path [:yin.k/cells]}))\n   881\t    (doseq [[cid cell] cells]\n   882\t      (when-not (and (map? cell) (marker? (:yin.k/stream cell))\n   883\t                     (contains? cell :yin.k/position))\n   884\t        (undecodable! {:yin.k/cell cid :yin.k/path [:yin.k/cells cid]})))\n   885\t    (doseq [[a v] code]\n   886\t      (when-not (= a (ucf/code-address v))\n   887\t        (refuse! :yin.k/hash-mismatch {:yin.k/segment a}))\n   888\t      (when-some [defect (code/well-formed-vector? v)]\n   889\t        (undecodable! {:yin.k/segment a :yin.k/pc (:pc defect)\n   890\t                       :yin.k/defect defect})))\n   891\t    (validate-frames body code cells)\n   892\t    (when (contains? body :yin.k/frames)\n   893\t      (when (= :halted kind)\n   894\t        (undecodable! {:yin.k/path [:yin.k/frames]})))\n   895\t    (when (contains? body :yin.k/result)\n   896\t      (when-not (= :halted kind)\n   897\t        (undecodable! {:yin.k/path [:yin.k/result]})))\n   898\t    (when (= :halted kind)\n   899\t      (when-not (contains? body :yin.k/result)\n   900\t        (undecodable! {:yin.k/path [:yin.k/result]})))\n   901\t    (when (= :parked kind)\n   902\t      (when-not (contains? (:yin.k/parked body)\n   903\t                           (:yin.k/parked-id body))\n   904\t        (undecodable! {:yin.k/parked-id (:yin.k/parked-id body)\n   905\t                       :yin.k/path [:yin.k/parked-id]})))\n   906\t    (doseq [[pid r] (:yin.k/parked body)]\n   907\t      (validate-registers code r [:yin.k/parked pid]))\n   908\t    (doseq [[m inst] (:yin.k/installs body)]\n   909\t      (when-not (and (contains? inst :yin.k/response)\n   910\t                     (map? (:yin.k/child inst))\n   911\t                     (true? (get (:yin.k/child inst) handoff-tag)))\n   912\t        (undecodable! {:yin.k/name m\n   913\t                       :yin.k/path [:yin.k/installs m]})))\n   914\t    (let [referenced (referenced-cells body)\n   915\t          missing (remove #(contains? cells %) referenced)\n   916\t          extra (remove #(contains? referenced %) (keys cells))]\n   917\t      (when-some [cid (first missing)]\n   918\t        (undecodable! {:yin.k/cell cid :yin.k/path [:yin.k/cells]}))\n   919\t      (when-some [cid (first (sort-by str extra))]\n   920\t        (undecodable! {:yin.k/cell cid :yin.k/kind :extra-cell\n   921\t                       :yin.k/path [:yin.k/cells cid]})))\n   922\t    (when (and (seq cells)\n   923\t               (not (contains?\n   924\t                      (get-in (or (:yin.k/requires body) {})\n   925\t                              [:yin.k/cursor-profiles])\n   926\t                      :dao.stream.remote/v1)))\n   927\t      (unsatisfied! nil))\n   928\t    body))\n   929\t\n   930\t\n   931\t;; =============================================================================\n   932\t;; Lower (14.1.2): a fresh task over the receiver's own coordinates\n   933\t;; =============================================================================\n   934\t\n   935\t(def ^:private fixed-resource-keys\n   936\t  \"The VM's fixed private resource keys, never allocated by the lower\n   937\t   (`yin.vm.ucf.remote`'s discipline).\"\n   938\t  #{vm/call-in-stream-key vm/call-out-stream-key\n   939\t    vm/call-out-cursor-key module/link-request-resource\n   940\t    module/link-response-resource})\n   941\t\n   942\t\n   943\t(defn- fresh-key\n   944\t  [used]\n   945\t  (loop [n (inc (count @used))]\n   946\t    (let [k (keyword \"yin.k\" (str \"k-\" n))]\n   947\t      (if (contains? @used k)\n   948\t        (recur (inc n))\n   949\t        (do (swap! used conj k) k)))))\n   950\t\n   951\t\n   952\t(defn- pending-markers\n   953\t  [pending]\n   954\t  (case (:yin.k/reason pending)\n   955\t    :put [(:yin.k/stream pending)]\n   956\t    :ffi-request [(:yin.k/request pending)\n   957\t                  (:yin.k/response pending)]\n   958\t    (:link-request :link-response)\n   959\t    [(:yin.k/request pending)\n   960\t     (:yin.k/response pending)]\n   961\t    []))\n   962\t\n   963\t\n   964\t(defn- attach-all!\n   965\t  \"One attach per distinct stream identity, through `attach!`; the\n   966\t   first refusal -- a reflection marked gone included -- is\n   967\t   :yin.k/unsatisfied naming that identity.\"\n   968\t  [attach! markers]\n   969\t  (reduce (fn [acc mkr]\n   970\t            (let [identity (:dao.stream/identity mkr)]\n   971\t              (if (contains? acc identity)\n   972\t                acc\n   973\t                (if-some [h (ucf.remote/lower-marker attach! mkr)]\n   974\t                  (assoc acc identity h)\n   975\t                  (unsatisfied! identity)))))\n   976\t          {}\n   977\t          markers))\n   978\t\n   979\t\n   980\t(defn- value-decoder\n   981\t  \"The decode half, over the receiver's coordinates: literals back to\n   982\t   maps, closures through the kernel against the attached code,\n   983\t   primitives from the receiver's own registry under an equal profile,\n   984\t   and stream and cursor markers as fresh references sealed under the\n   985\t   receiving task's own secret.\"\n   986\t  [recv streams cells]\n   987\t  (letfn [(decode\n   988\t            [x]\n   989\t            (cond\n   990\t              (scalar? x) x\n   991\t              (map? x)\n   992\t              (case (:yin.k/tag x)\n   993\t                :yin.k/literal\n   994\t                (let [e (:yin.k/entries x)]\n   995\t                  (if (even? (count e))\n   996\t                    (into {}\n   997\t                          (map (fn [[k v]] [(decode k) (decode v)]))\n   998\t                          (partition 2 e))\n   999\t                    (undecodable! {:yin.k/tag :yin.k/literal})))\n  1000\t                :yin.k/closure (module/lower-closure recv x decode)\n  1001\t                :yin.k/primitive\n  1002\t                (let [n (:yin.k/name x)\n  1003\t                      entry (get (:primitives recv) n)]\n  1004\t                  (if (and (some? entry)\n  1005\t                           (= (:yin.k/profile x)\n  1006\t                              (:yin.k/profile\n  1007\t                                (vm/profile-of (:primitives recv) n))))\n  1008\t                    (vm/primitive-function entry)\n  1009\t                    (refuse! :yin.k/unsatisfied {:yin.k/name n})))\n  1010\t                :yin.k/stream\n  1011\t                (if-some [k (get streams (:dao.stream/identity x))]\n  1012\t                  (engine/issue-ref recv :stream-ref k)\n  1013\t                  (undecodable! {:dao.stream/identity\n  1014\t                                 (:dao.stream/identity x)}))\n  1015\t                :yin.k/cursor-ref\n  1016\t                (if-some [k (get cells (:yin.k/cell x))]\n  1017\t                  (engine/issue-ref recv :cursor-ref k)\n  1018\t                  (undecodable! {:yin.k/cell (:yin.k/cell x)}))\n  1019\t                (undecodable! {:yin.k/tag (:yin.k/tag x)}))\n  1020\t              (vector? x) (mapv decode x)\n  1021\t              (set? x) (into #{} (map decode) x)\n  1022\t              (seq? x) (apply list (map decode x))\n  1023\t              :else (undecodable! {:yin.k/kind :host-object})))]\n  1024\t    decode))\n  1025\t\n  1026\t\n  1027\t(defn- spawn-child-template\n  1028\t  \"A fresh child VM of the receiver's composition for one install\n  1029\t   response -- the engine's own spawn discipline (yin.vm.linker.md\n  1030\t   7.3): nothing of the receiver's state but its composition values,\n  1031\t   a fresh origin tag, and the secret the composition's source mints\n  1032\t   for it.\"\n  1033\t  [recv response module-name]\n  1034\t  (let [n (or (:origins recv) 0)\n  1035\t        origin (keyword (str (name (or (:origin recv) :t0)) \".\" n))\n  1036\t        registry (reduce (fn [r [m e]]\n  1037\t                           (module/assoc-module r m (dissoc e :bindings)))\n  1038\t                         (:modules recv)\n  1039\t                         (module/module-entries (:modules recv)))\n  1040\t        source (:secret-source recv)\n  1041\t        child (module/spawn-module\n  1042\t                recv\n  1043\t                (:value (:image response))\n  1044\t                {:modules registry\n  1045\t                 :origin origin\n  1046\t                 :ancestry (conj (vec (:ancestry recv)) module-name)\n  1047\t                 :capability-secret (when (fn? source) (source origin))})]\n  1048\t    (assoc child :origins (inc n))))\n  1049\t\n  1050\t\n  1051\t(defn- resume-installs\n  1052\t  \"Each install child resumed into a fresh child of the receiver's\n  1053\t   composition, its phase and response carried: the receiver's own\n  1054\t   scheduler steps it exactly as the source's did.\"\n  1055\t  [recv body attach! opts]\n  1056\t  (into {}\n  1057\t        (map (fn [[m inst]]\n  1058\t               (let [response (:yin.k/response inst)\n  1059\t                     child-body (:yin.k/child inst)]\n  1060\t                 [m {:phase (or (:yin.k/phase inst) :running)\n  1061\t                     :parent (:yin.k/parent inst)\n  1062\t                     :response response\n  1063\t                     :vm (:vm (resume-task\n  1064\t                                (if-some [spawn (:child-of opts)]\n  1065\t                                  (spawn recv response m)\n  1066\t                                  (spawn-child-template recv response m))\n  1067\t                                (cbor/encode child-body)\n  1068\t                                attach!\n  1069\t                                opts))}])))\n  1070\t        (:yin.k/installs body)))\n  1071\t\n  1072\t\n  1073\t(defn- link-pair-resources\n  1074\t  \"The engine's fixed link keys mapped onto the reflections a lowered\n  1075\t   link wait uses, so a migrated link wait parks where the engine's\n  1076\t   own sweep polls it.\"\n  1077\t  [streams resources pendings]\n  1078\t  (reduce (fn [acc pending]\n  1079\t            (if (contains? #{:link-request :link-response}\n  1080\t                           (:yin.k/reason pending))\n  1081\t              (let [req (get resources\n  1082\t                             (streams (get-in pending\n  1083\t                                              [:yin.k/request\n  1084\t                                               :dao.stream/identity])))\n  1085\t                    resp (get resources\n  1086\t                              (streams (get-in pending\n  1087\t                                               [:yin.k/response\n  1088\t                                                :dao.stream/identity])))]\n  1089\t                (if (and req resp)\n  1090\t                  (assoc acc\n  1091\t                         module/link-request-resource req\n  1092\t                         module/link-response-resource resp)\n  1093\t                  acc))\n  1094\t              acc))\n  1095\t          {}\n  1096\t          pendings))\n  1097\t\n  1098\t\n  1099\t(defn- lower-frame!\n  1100\t  \"One pending lowered back into the engine's own wait-set entry\n  1101\t   shape, the receiver's register context riding verbatim under the\n  1102\t   fields the variant rebuilds (`yin.vm.ucf.remote`'s shapes, through\n  1103\t   this lower's own fresh keys).\"\n  1104\t  [decode streams cells cell-keys pending ctx]\n  1105\t  (let [stream-of (fn [marker]\n  1106\t                    (streams (:dao.stream/identity marker)))\n  1107\t        cell-stream (fn [cid]\n  1108\t                      (stream-of (get-in cells [cid :yin.k/stream])))\n  1109\t        cell-key (fn [cid] (get cell-keys cid))]\n  1110\t    (case (:yin.k/reason pending)\n  1111\t      :next\n  1112\t      (merge ctx\n  1113\t             {:reason :next\n  1114\t              :stream-id (cell-stream (:yin.k/cell pending))\n  1115\t              :cursor-ref {:type :cursor-ref\n  1116\t                           :id (cell-key (:yin.k/cell pending))}})\n  1117\t\n  1118\t      :ffi\n  1119\t      (merge ctx\n  1120\t             (cond-> {:reason :next\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1770,1970p' docs/design/yin.vm.linker.md; rg -n 'parking-kinds|safepoint' src/cljc/yin/vm/ucf.cljc; sed -n '965,1065p' test/yin/vm/ucf/handoff_test.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1770,1970p' docs/design/yin.vm.linker.md; rg -n 'parking-kinds|safepoint' src/cljc/yin/vm/ucf.cljc; sed -n '965,1065p' test/yin/vm/ucf/handoff_test.cljc\"","aggregated_output":"  with `:kind :no-proof` or `:bad-proof` and is discarded before\n  counting. A retraction whose `:yin.module/of` names no assertion at\n  the snapshot, or an assertion by a different principal, is discarded\n  with `:kind :dangling-retraction`; a retraction retracts exactly the\n  assertion it names and nothing by name alone.\n- **Replay is prevented by the per-principal sequence.** Every envelope\n  a principal issues carries `:yin.module/seq`, strictly increasing\n  over that principal's lifetime; the composition declares each\n  principal's floor in `:authority` (`0` for a new principal, the\n  highest sequence already honored for a re-declared one). The\n  declaration carries that floor as `:seq-floor`. At the snapshot the\n  linker processes one principal's proven envelopes in three passes,\n  in this order:\n  1. *Deduplicate by content id.* Every envelope is content; two\n     appearances of one envelope have one `segment-key` and are one\n     event. All but the first appearance are dropped silently, as\n     `dao.jing` drops a re-materialization: an exact duplicate is a\n     harmless carrier replay (a forwarder, a retry after `full`, a\n     mirrored log) and is neither a defect nor evidence against the\n     principal. This pass runs first so that repeating a valid envelope\n     can never suppress it.\n  2. *Detect equivocation.* After deduplication, two *distinct*\n     envelopes from one principal with equal sequence are equivocation:\n     the principal signed two different claims under one sequence\n     number. Both are discarded with `:kind :equivocation`, and the\n     principal's later envelopes at the snapshot are discarded too. A\n     duplicate can no longer reach this pass, so equivocation is\n     attributable to the signer alone. The pair and every later\n     envelope of that principal are discarded with\n     `:kind :equivocation`.\n  3. *Order and honor.* The remaining envelopes are ordered by sequence\n     and each is honored only if its sequence exceeds the floor and\n     every sequence honored before it; an envelope at or below either\n     is a replay of an old claim under a fresh carrier and is discarded\n     with `:kind :replay`.\n  A monotone sequence is chosen over nonces because it makes the check\n  stateless over the snapshot: no nonce store is needed and no window\n  is guessed.\n  A wall-clock timestamp is admitted as an optional\n  `:yin.module/issued-at` in the envelope for audit, and is never used\n  to order or to accept.\n- Two proof kinds are admitted, and the composition's `:authority`\n  declares, per principal, which one it expects:\n  - *Signature.* `proof` is `{:yin.module/signature sig}`, where `sig`\n    signs the canonical bytes (`dao.jing/canonical-bytes`) of the whole\n    envelope under the principal's public key, so operation type, name,\n    manifest, principal, and sequence are all covered and none can be\n    altered or recombined. `:authority` holds, per principal, the key\n    and a composition-supplied verify function; the linker calls the\n    function and implements no cryptographic primitive itself (a host\n    library sits behind the function, as `dao.jing` does for hashing).\n    The signature is over content, so it survives every carrier and\n    can be checked by any host that holds the key.\n  - *Attested log.* The assertion stream is a one-writer log\n    (`dao.stream.md`, *Concurrency*) whose writer the composition\n    authenticated at attachment and bound to one principal; `:authority`\n    names the stream's `:dao.stream/identity` beside that principal, and\n    every envelope read from that identity, at the snapshot, counts as\n    proven by it; `proof` is `{:yin.module/attested identity}` and the\n    linker checks that the envelope was in fact read from that stream.\n    The sequence rule applies unchanged, so a log that repeats an\n    envelope repeats a replay. The proof holds only within the reach of\n    the attachment discipline: an envelope copied off that log onto\n    another medium carries no proof and is `:unauthenticated` there. A\n    composition that needs envelopes to travel uses signatures.\n  A principal declared with neither kind cannot assert anything.\n- The linker's `:authority` names the accepted principals with their\n  proof kind and material, and the **snapshot**: either a published\n  index manifest address (`dao.space.index`) or a cursor position on\n  the assertion stream. The linker reads exactly that snapshot;\n  assertions appended afterwards do not exist for it until the\n  composition advances the snapshot, which is an ordinary `link-state`\n  rebuild, never an ambient re-read. The snapshot result carries\n  `:honored-seq` per principal, the highest sequence honored in this\n  snapshot, which the composition declares back as the next\n  `:seq-floor`.\n- At the snapshot, for one name: unauthenticated envelopes, exact\n  duplicates beyond the first, replays, equivocations, and envelopes by\n  undeclared principals are discarded or collapsed as the passes above\n  say;\n  each honored retraction removes exactly the assertion its\n  `:yin.module/of` names; the distinct manifest addresses remaining are\n  counted. Exactly one resolves the name. Zero is `:absent`. More than\n  one is `:ambiguous-name` naming every remaining address and asserter,\n  and no address is chosen by recency, sequence, order, or any other\n  rule. Three shape and declaration diagnostics sit beside the four\n  discard kinds: `:malformed-envelope` (an envelope that fails the\n  shape gate), `:undeclared-principal` (an author the authority map\n  does not declare), and `:no-proof-kind` (a principal declared with\n  neither proof kind).\n- Provenance is data the outcome carries: a successful resolution names\n  the asserter, the proof kind, and the snapshot under\n  `:yin.link/provenance` so a receiver can record which claim it acted\n  on.\n\nAn entry is a claim. The manifest it names is verified, and its name is\nverified against the entry (section 8.1). Which principals a composition\ndeclares, and how it obtains and rotates their keys, is the composition's\n(section 12); what the linker does with a declared principal's assertion\nis fixed above.\n\n### 8.3 What `yin.vm.module` becomes\n\nThe namespace keeps its shape and changes its contents.\n\n| Today                        | After                                       |\n|------------------------------|---------------------------------------------|\n| `register-module r name fns` | `register-host-module r name fns profiles`  |\n|                              | (rules below); no code fetched, because the |\n|                              | host is the boundary                        |\n| `resolve-module r sym`       | unchanged signature; reads the task-local   |\n|                              | lowered `:bindings`                         |\n| `require-handler`            | registry hit answers; installing joins the  |\n|                              | waiter set; miss mints, parks, and emits    |\n|                              | (section 7.2); never throws for absence     |\n| `register-effect-handler`    | unchanged                                   |\n| `stream-module`              | a host module; `register-stream-module`     |\n|                              | calls `register-host-module`                |\n| `default-registry`           | unchanged                                   |\n| (new) `link-module r m d s`  | the `linked` transition of section 7.3      |\n\n**`register-host-module` enforces UCF profile classes.** Every binding\nmust carry a profile in the shape of `yin.vm/primitive-profiles`, and\nregistration refuses (throws, as a host assembly defect detected before\nany operation runs) unless the profile's class is `:pure`, or\n`:effectful` with a declared, non-empty `:yin.k/effects` set, and\n`:yin.k/host-state` is `:none`. A `:host`-class function, a function\nwith undeclared host state, or a binding with no profile is refused. An\n`:effectful` export must return plain effect data for the engine to\ninterpret; it may not perform IO. `stream/make` is exactly such a pure\neffect constructor, and the engine's `:make-stream` capability remains\nthe explicit boundary that performs the creation. A host module is\nentered as an already-linked manifest with `:yin.module/tree` absent,\n`:yin.module/derivations {}`, and its exports listed under\n`:yin.module/primitives` by profile address.\n\n**The host module is the trusted composition boundary, and the check\nabove is a declaration check, not a proof.** A host function is opaque\nhost code: nothing the linker or the engine can inspect proves that a\nfunction declared `:pure` performs no IO or holds no state. The profile\nis a warranty the composition gives, in the same sense UCF section 7.5.2\ncalls a `:host-state :none` claim \"a publication's warranty\". The\nobligations therefore fall where they can be met:\n\n- *The composition* is responsible for every host module it registers:\n  the function behaves as its profile declares, is reviewed and tested\n  as trusted code, and is published with its profile record so a\n  receiver can check equality. Registering a host module extends the\n  trusted computing base of every VM that composition wires, and a\n  composition should register the fewest it can.\n- *The linker* verifies what is verifiable: profile shape and class at\n  registration, profile-address equality at discharge (step 5b), and\n  that no host function ever arrives by linking. It makes no claim\n  beyond those.\n- *Runtime confinement*, where a composition needs it, is not a linker\n  mechanism. It is the capability discipline of\n  `docs/agents/advanced-concepts.md`: an effectful host function\n  receives the resources it may touch as explicit capability tokens in\n  its effect's interpretation, and a token it was not handed it cannot\n  use. That discipline belongs to the engine's effect handlers and the\n  composition's wiring, and it is the only way a `:pure` or\n  `:effectful` declaration becomes enforceable at run time. Until a\n  composition wires it, a host module's declaration is trusted, and this\n  document says so rather than implying a sandbox it does not provide.\n\nThe scheduler registry's `:modules` map changes from `{name {sym fn}}`\nto `{name {:manifest m :address a :derivation d :slice {sym encoded}\n:stores {addr encoded}}}` -- the portable act-1 encoding, never\nlowered values (section 7.3, act 4). Each task's own `:modules`\nentry gains\nthat task's lowered `:bindings` and `:module-stores` instance when\nits require completes; `resolve-var` reads task state, so no task\nresolves through another task's coordinates or store. No shim keeps\nthe old entry shape: this is a dev-only repository with no deployed\nregistries, and a clean break is the default here.\n\n## 9. Migration from `yin.vm.debruijn-linker`\n\nFive steps, each landing green on all three hosts before the next. The\npredecessor namespace is renamed, not aliased.\n\n```mermaid\nflowchart TD\n  M1[\"M1 rename\\nyin.vm.debruijn-linker -> yin.vm.linker\"]\n  M2[\"M2 four format records\\nidentity-directed match, bounded parts\"]\n  M3[\"M3 stepped core + link runtime\\nfetch = host policy; DHT behind server\"]\n  M4[\"M4 require lowers to the linker\\nmanifests, authority, child install\"]\n  M5[\"M5 yin.repl wires the four streams\\nper backend\"]\n  M1 --> M2 --> M3 --> M4 --> M5\n```\n\n**M1. Rename.** Move `src/cljc/yin/vm/debruijn_linker.cljc` to\n`src/cljc/yin/vm/linker.cljc` with namespace `yin.vm.linker`; move the\ntest likewise. Update the five design documents that name the old\nnamespace (`yin.vm.debruijn.stack.md`, `yin.vm.debruijn.register.md`,\n`dao.agent.md`, `dao.agent.harness.md`, `dao.agent.mcp.server.md`) and\nthe orchestrator log. The predecessor document\n`yin.vm.debruijn.linker.md` was first marked superseded by this\ndocument in its status line (2026-09-25); when the completion audit\n(collab/1790871424000-qa-yin-vm-linker-spec-completion-audit.md)\nconfirmed all five milestones landed, its remaining load-bearing\n2:  \"Universal Continuation Format, Phase 1: code identity and safepoints\n18:   - S7.4 safepoints. `safepoints` derives, from the canonical vector\n19:     alone, the static half of the safepoint map a foreign engine\n246:   safepoints of S7.4.1. `:call` is parking because the operator may be a\n248:   is a step, not a safepoint (it reifies and continues).\"\n273:(def parking-kinds\n274:  \"S7.4.1's safepoint kinds, by parking mnemonic -- the static\n275:   possibilities of `:yin.safepoint/kinds`, per the owner ruling in\n349:(defn safepoints\n350:  \"The static safepoint map of one canonical vector (S7.4.2): one entry per\n363:              {:yin.safepoint/at pc,\n364:               :yin.safepoint/pc (inc pc),\n365:               :yin.safepoint/kinds (get parking-kinds (nth t 0)),\n366:               :yin.safepoint/stack-effect (stack-effect t),\n367:               :yin.safepoint/lexically-required\n372:(defn safepoint-table\n373:  \"`safepoints` published per segment, keyed by the code's address and the\n375:  ([v] (safepoint-table v :yin.vm.semantic/reference))\n377:   {:yin.safepoint/segment (code-address v),\n378:    :yin.safepoint/engine engine,\n379:    :yin.safepoint/safepoints (safepoints v)}))\n382:(defn safepoint-at\n383:  \"The static safepoint entry whose canonical resume pc is `pc`, or the\n384:   S7.9 `:yin.k/not-at-safepoint` outcome naming the pc.\"\n386:  (or (some #(when (= pc (:yin.safepoint/pc %)) %) (safepoints v))\n387:      {:yin.k/status :yin.k/not-at-safepoint, :yin.k/pc pc}))\n402:  \"The lexically required names of a static safepoint that the frame's\n406:  [safepoint frame resolvable]\n409:               (:yin.safepoint/lexically-required safepoint))))\n(deftest malformed-bodies-refuse-undecodable-whole\n  (let [t (toy)\n        serve! (server (served-peer t) (:channel t))\n        [parked _src] (parked-reader 1 true)\n        parked (assoc-in parked [:store 'held]\n                         (engine/issue-ref\n                           parked :cursor-ref\n                           (get-in (first (:wait-set parked))\n                                   [:cursor-ref :id])))\n        export (handoff/export-task parked serve!)\n        attach! (attacher t)\n        resume (fn [bytes]\n                 (handoff/resume-task (new-machine) bytes attach!))]\n    (is (= :ok (:status export)))\n    (testing \"a missing cell reference\"\n      (is (= :yin.k/undecodable\n             (:yin.k/status\n               (resume (tamper export\n                               #(update % :yin.k/cells\n                                        dissoc :yin.k/c-0)))))))\n    (testing \"an extra cell nobody references\"\n      (is (= :extra-cell\n             (:yin.k/kind\n               (resume (tamper\n                         export\n                         #(assoc-in %\n                                    [:yin.k/cells :yin.k/c-9]\n                                    {:yin.k/stream\n                                     (get-in %\n                                             [:yin.k/cells :yin.k/c-0\n                                              :yin.k/stream]),\n                                     :yin.k/position 0})))))))\n    (testing \"a malformed cell\"\n      (is (= :yin.k/undecodable\n             (:yin.k/status\n               (resume (tamper\n                         export\n                         #(assoc-in % [:yin.k/cells :yin.k/c-0\n                                       :yin.k/stream]\n                                    :not-a-marker)))))))\n    (testing \"frames that are not a vector\"\n      (is (= :yin.k/undecodable\n             (:yin.k/status\n               (resume (tamper export\n                               #(assoc % :yin.k/frames\n                                       {:not :a-vector})))))))\n    (testing \"code that no longer hashes to its address\"\n      (is (= :yin.k/hash-mismatch\n             (:yin.k/status\n               (resume (tamper\n                         export\n                         #(update % :yin.k/code\n                                  (fn [code]\n                                    (into {}\n                                          (map (fn [[a _v]]\n                                                 [a [[:halt]]]))\n                                          code)))))))))\n    (testing \"a wrong wire version\"\n      (is (= :yin.k/profile-mismatch\n             (:yin.k/status\n               (resume (tamper export\n                               #(assoc % :yin.k/version 1)))))))\n    (testing \"bytes that are no body at all\"\n      (is (= :yin.k/undecodable\n             (:yin.k/status\n               (resume (cbor/encode \"not a body\"))))))))\n\n\n(deftest an-install-name-alone-refuses-export\n  (let [t (toy)\n        serve! (server (served-peer t) (:channel t))\n        [parked _child] (parked-installer true)\n        stripped (-> parked\n                     (update :installs dissoc 'host.mod)\n                     (update :wait-set\n                             (fn [ws]\n                               (mapv #(assoc % :reason :install\n                                             :name 'host.mod)\n                                     ws))))\n        refused (handoff/export-task stripped serve!)]\n    (is (= :incomplete-install (:yin.k/kind refused))\n        (pr-str refused))\n    (is (not (contains? refused :bytes))\n        \"an install name alone reconstructs nothing, so nothing is\n         published\")))\n","exit_code":0,"status":"completed"}}
