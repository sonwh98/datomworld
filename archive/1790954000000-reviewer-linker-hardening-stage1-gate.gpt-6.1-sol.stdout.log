{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf/handoff.cljc | sed -n '370,760p'\"","aggregated_output":"   370\t  \"The wire variants each static safepoint kind admits.  The static map\n   371\t   says where an instruction may park; the observed entry says why this\n   372\t   activation did.  An explicit park admits no waiter at all, and an\n   373\t   `:effectful-call` admits whatever effect the activation actually\n   374\t   produced -- a read, a write, an FFI state or a link state -- because\n   375\t   the instruction's kind selects none of them.\"\n   376\t  {:explicit-park #{}\n   377\t   :blocked-read #{:next}\n   378\t   :blocked-write #{:put}\n   379\t   :ffi-sent #{:ffi}\n   380\t   :ffi-retained #{:ffi-request}\n   381\t   :effectful-call #{:next :put :ffi :ffi-request\n   382\t                     :link-request :link-response :install}})\n   383\t\n   384\t\n   385\t(defn- observed-wire\n   386\t  \"The wire variant the observed entry itself carries, from its shape\n   387\t   alone: a `:next` wait with a call id is a sent FFI response reader;\n   388\t   a `:put` wait holding its request is a retained call.  nil when the\n   389\t   entry is no variant at all.\"\n   390\t  [entry]\n   391\t  (case (:reason entry)\n   392\t    :next (if (:call-id entry) :ffi :next)\n   393\t    :put (if (:request-sent entry) :ffi-request :put)\n   394\t    :link-request :link-request\n   395\t    :link-response :link-response\n   396\t    :install :install\n   397\t    nil))\n   398\t\n   399\t\n   400\t(defn- safepoint-kinds-at\n   401\t  \"The static `:yin.safepoint/kinds` at the resume pc of `seg`, from\n   402\t   the loaded image's own canonical vector; an undeclared pc refuses\n   403\t   with the existing :yin.k/not-at-safepoint outcome.\"\n   404\t  [vm seg pc]\n   405\t  (let [image (get (:code vm) seg)\n   406\t        v (when image (completion/image->vector image))]\n   407\t    (cond\n   408\t      (nil? image) (non-portable! :unaddressed-segment {:yin.k/hint seg})\n   409\t      (nil? v) (non-portable! :address-mismatch {:yin.k/hint seg})\n   410\t      :else\n   411\t      (let [at (ucf/safepoint-at v pc)]\n   412\t        (if (contains? at :yin.k/status)\n   413\t          (not-at-safepoint! pc)\n   414\t          (:yin.safepoint/kinds at))))))\n   415\t\n   416\t\n   417\t;; =============================================================================\n   418\t;; Lift: one pending variant each, from the observed entry\n   419\t;; =============================================================================\n   420\t\n   421\t(defn- call-out-cell\n   422\t  \"The emitter's call-out cursor cell -- the response route a retained\n   423\t   call held.  nil when the composition holds no call pair, which no\n   424\t   real retained request does.\"\n   425\t  [resources]\n   426\t  (let [cursor (get resources vm/call-out-cursor-key)\n   427\t        handle (get resources vm/call-out-stream-key)]\n   428\t    (when (and (map? cursor) (contains? cursor :stream-id) handle)\n   429\t      {:id vm/call-out-cursor-key\n   430\t       :stream-id vm/call-out-stream-key\n   431\t       :cursor (:cursor cursor)})))\n   432\t\n   433\t\n   434\t(defn- lift-pending!\n   435\t  \"The S7.4.3 pending of one observed entry, in `yin.vm.ucf.remote`'s\n   436\t   wire shapes, minted through THIS export's one cell and marker maps:\n   437\t   the cell a waiter names is the same cell a closure or the store\n   438\t   reaches, and the response route a retained call held is a cell like\n   439\t   any other, at its kept position.\"\n   440\t  [vm serve! found encode entry]\n   441\t  (case (observed-wire entry)\n   442\t    :next\n   443\t    {:yin.k/reason :next\n   444\t     :yin.k/cell (cell-for! vm serve! found\n   445\t                            (get-in entry [:cursor-ref :id]))}\n   446\t\n   447\t    :ffi\n   448\t    (cond-> {:yin.k/reason :ffi\n   449\t             :yin.k/call-id (:call-id entry)\n   450\t             :yin.k/cell (cell-for! vm serve! found\n   451\t                                    (get-in entry [:cursor-ref :id]))}\n   452\t      (contains? entry :op) (assoc :yin.k/op (:op entry)))\n   453\t\n   454\t    :put\n   455\t    (do (when-not (contains? entry :datom)\n   456\t          (non-portable! :incomplete-write\n   457\t                         {:yin.k/pc (:pc entry)}))\n   458\t        {:yin.k/reason :put\n   459\t         :yin.k/stream (marker-for! vm serve! found (:stream-id entry))\n   460\t         :yin.k/value (encode (:datom entry))})\n   461\t\n   462\t    :ffi-request\n   463\t    (let [route (call-out-cell (:resources vm))]\n   464\t      (if (nil? route)\n   465\t        (unsatisfied!)\n   466\t        (let [envelope (:datom entry)]\n   467\t          {:yin.k/reason :ffi-request\n   468\t           :yin.k/call-id (:call-id entry)\n   469\t           :yin.k/request-envelope (encode envelope)\n   470\t           :yin.k/request-op (or (apply2/request-op envelope)\n   471\t                                 (:op entry))\n   472\t           :yin.k/request-args (apply2/request-args envelope)\n   473\t           :yin.k/request (marker-for! vm serve! found\n   474\t                                       (:stream-id entry))\n   475\t           :yin.k/response (marker-for! vm serve! found\n   476\t                                        (:stream-id route))\n   477\t           :yin.k/response-cell (cell-for! vm serve! found\n   478\t                                           (:id route))})))\n   479\t\n   480\t    (:link-request :link-response)\n   481\t    (let [reason (:reason entry)\n   482\t          kept (:cursor entry)]\n   483\t      (cond-> {:yin.k/reason reason\n   484\t               :yin.k/link-id (:link-id entry)\n   485\t               :yin.k/name (:name entry)\n   486\t               :yin.k/request (marker-for! vm serve! found\n   487\t                                           (:request entry))\n   488\t               :yin.k/response (marker-for! vm serve! found\n   489\t                                            (:response entry))\n   490\t               :yin.k/cell (cell-at! vm serve! found\n   491\t                                     [(:response entry) kept]\n   492\t                                     (:response entry) kept)}\n   493\t        (= :link-request reason)\n   494\t        (assoc :yin.k/envelope (encode (:envelope entry)))))\n   495\t\n   496\t    :install\n   497\t    (do (when-not (contains? (:installs vm) (:name entry))\n   498\t          (non-portable! :incomplete-install {:yin.k/name (:name entry)}))\n   499\t        {:yin.k/reason :install\n   500\t         :yin.k/name (:name entry)})\n   501\t\n   502\t    (undecodable! {:yin.k/reason (:reason entry)\n   503\t                   :yin.k/path [:yin.k/wait (:pc entry)]})))\n   504\t\n   505\t\n   506\t(defn- lift-frame!\n   507\t  \"One wait entry lifted: its registers and its pending, the dynamic\n   508\t   reason checked against the static kinds at its pc -- the kinds gate\n   509\t   eligibility only, and a variant they do not admit is evidence the\n   510\t   frame is not exportable here, never a wire reason to invent.\"\n   511\t  [vm serve! found encode entry]\n   512\t  (let [kinds (safepoint-kinds-at vm (:segment entry) (:pc entry))\n   513\t        wire (observed-wire entry)]\n   514\t    (when (nil? wire)\n   515\t      (undecodable! {:yin.k/reason (:reason entry)\n   516\t                     :yin.k/path [:yin.k/wait (:pc entry)]}))\n   517\t    (when-not (some #(contains? (get wire-of-kind %) wire) kinds)\n   518\t      (non-portable! :reason-mismatch\n   519\t                     {:yin.k/pc (:pc entry)\n   520\t                      :yin.k/reason wire\n   521\t                      :yin.safepoint/kinds (vec kinds)}))\n   522\t    {:yin.k/registers (encode-registers found encode vm entry)\n   523\t     :yin.k/pending (lift-pending! vm serve! found encode entry)}))\n   524\t\n   525\t\n   526\t;; =============================================================================\n   527\t;; The install children: a whole child travels, or nothing does\n   528\t;; =============================================================================\n   529\t\n   530\t(declare export-task validate-body resume-task)\n   531\t\n   532\t\n   533\t(defn- export-installs\n   534\t  \"Each live install child of `vm` as its own handoff body beside the\n   535\t   response that spawned it, preserving the child's phase and waits\n   536\t   (14.1.1's :install row).  A child that cannot export itself refuses\n   537\t   the parent's export -- a refusal is thrown, never embedded -- and a\n   538\t   response outside the canonical bytes domain refuses it too.\"\n   539\t  [vm serve!]\n   540\t  (into {}\n   541\t        (map (fn [[m {:keys [vm phase parent response]}]]\n   542\t               (when-not (cbor/portable-value? response)\n   543\t                 (non-portable! :install-response {:yin.k/name m}))\n   544\t               (let [r (export-task vm serve!)]\n   545\t                 (when (not= :ok (:status r))\n   546\t                   (refuse! (:yin.k/status r) (dissoc r :status)))\n   547\t                 [m {:yin.k/phase phase\n   548\t                     :yin.k/parent parent\n   549\t                     :yin.k/response response\n   550\t                     :yin.k/child (:body r)}])))\n   551\t        (:installs vm)))\n   552\t\n   553\t\n   554\t;; =============================================================================\n   555\t;; Export (14.1.2 lift): the whole blocked task as canonical bytes\n   556\t;; =============================================================================\n   557\t\n   558\t(defn- module-decls\n   559\t  \"The module declarations the completion walk asks for: each linked\n   560\t   module of the registry under its manifest address.\"\n   561\t  [vm]\n   562\t  (into {}\n   563\t        (map (fn [[m entry]]\n   564\t               [m {:yin.k/manifest (:address entry)}]))\n   565\t        (module/module-entries (:modules vm))))\n   566\t\n   567\t\n   568\t(defn- export-refusals\n   569\t  \"The completion walk's refusals as one data outcome.\"\n   570\t  [refusals]\n   571\t  (when-some [r (first refusals)]\n   572\t    (refuse! (if (= :yin.k/not-quiescent (:kind r))\n   573\t               :yin.k/not-quiescent\n   574\t               :yin.k/non-portable)\n   575\t             (assoc (dissoc r :kind) :yin.k/kind (:kind r)))))\n   576\t\n   577\t\n   578\t(defn- snapshot-module-stores\n   579\t  \"The encoded store snapshot of every module the encoding reached,\n   580\t   exactly as it stands in the task at export, mutations included.\"\n   581\t  [vm encode found]\n   582\t  (when-some [m (first (remove #(contains? (:module-stores vm) %)\n   583\t                               (sort-by str (:stores @found))))]\n   584\t    (non-portable! :missing-module-store {engine/store-of-key m}))\n   585\t  (into {}\n   586\t        (map (fn [m]\n   587\t               [m (into {}\n   588\t                        (map (fn [[k v]] [(encode k) (encode v)]))\n   589\t                        (get (:module-stores vm) m))]))\n   590\t        (sort-by str (:stores @found))))\n   591\t\n   592\t\n   593\t(defn export-task\n   594\t  \"The lift of 14.1.2: `vm`, a blocked or halted task at a safepoint,\n   595\t   as canonical bytes under their content address.  Answers\n   596\t   `{:status :ok :kind k :body b :bytes encoded :address a}` with `k`\n   597\t   `:blocked`, `:parked` or `:halted`, or the S7.9 data outcome of the\n   598\t   first refusal -- `:yin.k/not-quiescent` for queued work,\n   599\t   `:yin.k/not-at-safepoint` for an undeclared pc, `:yin.k/non-portable`\n   600\t   for a value or reference that cannot cross, `:yin.k/unsatisfied`\n   601\t   for a stream that cannot be served, a cursor that cannot survive\n   602\t   the canonical codec, or -- when `opts` names cursor profiles that\n   603\t   do not cover the cells -- a claim the body cannot make.\n   604\t   `serve!` is the exporter's remote-table entry, exactly\n   605\t   `yin.vm.ucf.remote`'s.\"\n   606\t  ([vm serve!]\n   607\t   (export-task vm serve! nil))\n   608\t  ([vm serve! opts]\n   609\t   (call!\n   610\t     (fn []\n   611\t       (when (seq (:ready-queue vm))\n   612\t         (refuse! :yin.k/not-quiescent\n   613\t                  {:yin.k/ready (count (:ready-queue vm))}))\n   614\t       (let [walked (completion/complete\n   615\t                      {:vm vm\n   616\t                       :cursor-profile (constantly :dao.stream.remote/v1)\n   617\t                       :modules (module-decls vm)})\n   618\t             _ (export-refusals (:yin.k/refusals walked))\n   619\t             ;; the pending-child gap the walk cannot close itself: an\n   620\t             ;; obligation a live install child will bind when it\n   621\t             ;; completes is discharged by the child this body carries\n   622\t             ;; beside the waiter, not by a store the emitter holds\n   623\t             installing (into #{}\n   624\t                              (mapcat (fn [[m inst]]\n   625\t                                        (map (fn [x]\n   626\t                                               (symbol (str (name m) \"/\"\n   627\t                                                            (name x))))\n   628\t                                             (get-in inst\n   629\t                                                     [:response :manifest\n   630\t                                                      :yin.module/exports])))\n   631\t                                      (:installs vm)))\n   632\t             missing (update (:yin.k/missing walked) :obligations\n   633\t                             #(set/difference (set %) installing))\n   634\t             discovery (cond\n   635\t                         (seq (:segments missing)) :blocked\n   636\t                         (some seq (vals (dissoc missing :segments)))\n   637\t                         :incomplete\n   638\t                         :else :complete)]\n   639\t         (when-not (= :complete discovery)\n   640\t           (refuse! :yin.k/unsatisfied\n   641\t                    {:yin.k/discovery discovery\n   642\t                     :yin.k/missing missing}))\n   643\t         (let [value (:value vm)\n   644\t               active (and (map? value)\n   645\t                           (= :parked-continuation (:type value))\n   646\t                           (contains? (:parked vm) (:id value)))\n   647\t               active-rec (when active (get (:parked vm) (:id value)))\n   648\t               kind (cond\n   649\t                      active :parked\n   650\t                      (engine/halted-with-empty-queue? vm) :halted\n   651\t                      (seq (:wait-set vm)) :blocked\n   652\t                      :else (not-at-safepoint!\n   653\t                              (get-in vm [:control :pc])))\n   654\t               _ (when (and (= :halted kind) (seq (:wait-set vm)))\n   655\t                   (non-portable! :inconsistent-halt {}))\n   656\t               _ (when (and active\n   657\t                            (not (some #(= :explicit-park %)\n   658\t                                       (safepoint-kinds-at\n   659\t                                         vm (:segment active-rec)\n   660\t                                         (:pc active-rec)))))\n   661\t                   (non-portable! :reason-mismatch\n   662\t                                  {:yin.k/pc (:pc active-rec)}))\n   663\t               found (atom {:cells {} :cell-of {} :markers {}\n   664\t                            :stores #{} :segments #{}})\n   665\t               encode (value-encoder vm serve! found)\n   666\t               frames (mapv (partial lift-frame! vm serve! found encode)\n   667\t                            (:wait-set vm))\n   668\t               parked (into {}\n   669\t                            (map (fn [[pid rec]]\n   670\t                                   (safepoint-kinds-at vm (:segment rec)\n   671\t                                                       (:pc rec))\n   672\t                                   [pid (encode-registers found encode\n   673\t                                                          vm rec)]))\n   674\t                            (:yin.k/parked (:yin.k/scheduler walked)))\n   675\t               store (into {}\n   676\t                           (map (fn [[k v]] [(encode k) (encode v)]))\n   677\t                           (:yin.k/store walked))\n   678\t               module-stores (snapshot-module-stores vm encode found)\n   679\t               installs (export-installs vm serve!)\n   680\t               cells (:cells @found)\n   681\t               profiles (or (:cursor-profiles opts)\n   682\t                            (if (seq cells)\n   683\t                              ucf.remote/cursor-profiles\n   684\t                              #{}))\n   685\t               _ (when (and (seq cells)\n   686\t                            (not (contains? profiles\n   687\t                                            :dao.stream.remote/v1)))\n   688\t                   (unsatisfied!))\n   689\t               segments (:segments @found)\n   690\t               fetch (completion/vm-fetch vm nil)\n   691\t               code (into {}\n   692\t                          (map (fn [a]\n   693\t                                 (if-some [v (fetch a)]\n   694\t                                   [a v]\n   695\t                                   (refuse! :yin.k/unsatisfied\n   696\t                                            {:yin.k/segment a}))))\n   697\t                          (sort-by str segments))\n   698\t               body (cond-> {handoff-tag true\n   699\t                             :yin.k/version handoff-version\n   700\t                             :yin.k/kind kind\n   701\t                             :yin.k/contract ucf/contract-stamp\n   702\t                             :yin.k/id-counter (or (:id-counter vm) 0)\n   703\t                             :yin.k/store store\n   704\t                             :yin.k/module-stores module-stores\n   705\t                             :yin.k/parked parked\n   706\t                             :yin.k/cells cells\n   707\t                             :yin.k/requires\n   708\t                             {:yin.k/cursor-profiles profiles\n   709\t                              :yin.k/segments (set segments)}\n   710\t                             :yin.k/code code}\n   711\t                      (seq installs)\n   712\t                      (assoc :yin.k/installs installs)\n   713\t                      (seq frames)\n   714\t                      (assoc :yin.k/frames frames)\n   715\t                      (= :parked kind)\n   716\t                      (assoc :yin.k/parked-id (:id value))\n   717\t                      (= :halted kind)\n   718\t                      (assoc :yin.k/result (encode (:value vm))))\n   719\t               bytes (cbor/encode body)\n   720\t               _ (validate-body (cbor/decode bytes))]\n   721\t           {:status :ok\n   722\t            :kind kind\n   723\t            :body body\n   724\t            :bytes bytes\n   725\t            :address (jing/content-hash body)}))))))\n   726\t\n   727\t\n   728\t;; =============================================================================\n   729\t;; Grammar (S7.5.4): total, before anything is attached or restored\n   730\t;; =============================================================================\n   731\t\n   732\t(defn- marker?\n   733\t  [x]\n   734\t  (and (map? x) (= :yin.k/stream (:yin.k/tag x))\n   735\t       (string? (:dao.stream/identity x))\n   736\t       (map? (:dao.stream/descriptor x))))\n   737\t\n   738\t\n   739\t(defn- cell-ids-of\n   740\t  \"Every cell id the value's cursor-ref markers name.\"\n   741\t  [x]\n   742\t  (into #{}\n   743\t        (comp (filter #(and (map? %) (= :yin.k/cursor-ref (:yin.k/tag %))))\n   744\t              (map :yin.k/cell))\n   745\t        (tree-seq coll? (fn [n] (if (map? n) (vals n) (seq n))) x)))\n   746\t\n   747\t\n   748\t(defn- check-cell\n   749\t  [cells cid path]\n   750\t  (when-not (map? (get cells cid))\n   751\t    (undecodable! {:yin.k/cell cid :yin.k/path path})))\n   752\t\n   753\t\n   754\t(defn- require-keys\n   755\t  [pending keys path]\n   756\t  (doseq [k keys]\n   757\t    (when-not (contains? pending k)\n   758\t      (undecodable! {:yin.k/path (conj path k)}))))\n   759\t\n   760\t\n","exit_code":0,"status":"completed"}}
