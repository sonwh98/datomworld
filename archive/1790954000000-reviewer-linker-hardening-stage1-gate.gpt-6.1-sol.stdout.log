c/yin/vm/ucf/handoff.cljc:369:(def ^:private wire-of-kind\nsrc/cljc/yin/vm/ucf/handoff.cljc:385:(defn- observed-wire\nsrc/cljc/yin/vm/ucf/handoff.cljc:400:(defn- safepoint-kinds-at\nsrc/cljc/yin/vm/ucf/handoff.cljc:421:(defn- call-out-cell\nsrc/cljc/yin/vm/ucf/handoff.cljc:434:(defn- lift-pending!\nsrc/cljc/yin/vm/ucf/handoff.cljc:506:(defn- lift-frame!\nsrc/cljc/yin/vm/ucf/handoff.cljc:533:(defn- export-installs\nsrc/cljc/yin/vm/ucf/handoff.cljc:536:   (14.1.1's :install row).  A child that cannot export itself refuses\nsrc/cljc/yin/vm/ucf/handoff.cljc:555:;; Export (14.1.2 lift): the whole blocked task as canonical bytes\nsrc/cljc/yin/vm/ucf/handoff.cljc:558:(defn- module-decls\nsrc/cljc/yin/vm/ucf/handoff.cljc:568:(defn- export-refusals\nsrc/cljc/yin/vm/ucf/handoff.cljc:578:(defn- snapshot-module-stores\nsrc/cljc/yin/vm/ucf/handoff.cljc:593:(defn export-task\nsrc/cljc/yin/vm/ucf/handoff.cljc:594:  \"The lift of 14.1.2: `vm`, a blocked or halted task at a safepoint,\nsrc/cljc/yin/vm/ucf/handoff.cljc:732:(defn- marker?\nsrc/cljc/yin/vm/ucf/handoff.cljc:739:(defn- cell-ids-of\nsrc/cljc/yin/vm/ucf/handoff.cljc:748:(defn- check-cell\nsrc/cljc/yin/vm/ucf/handoff.cljc:754:(defn- require-keys\nsrc/cljc/yin/vm/ucf/handoff.cljc:761:(defn- validate-pending\nsrc/cljc/yin/vm/ucf/handoff.cljc:807:(defn- validate-registers\nsrc/cljc/yin/vm/ucf/handoff.cljc:817:(defn- validate-frames\nsrc/cljc/yin/vm/ucf/handoff.cljc:839:(defn- referenced-cells\nsrc/cljc/yin/vm/ucf/handoff.cljc:860:(defn validate-body\nsrc/cljc/yin/vm/ucf/handoff.cljc:932:;; Lower (14.1.2): a fresh task over the receiver's own coordinates\nsrc/cljc/yin/vm/ucf/handoff.cljc:935:(def ^:private fixed-resource-keys\nsrc/cljc/yin/vm/ucf/handoff.cljc:943:(defn- fresh-key\nsrc/cljc/yin/vm/ucf/handoff.cljc:952:(defn- pending-markers\nsrc/cljc/yin/vm/ucf/handoff.cljc:964:(defn- attach-all!\nsrc/cljc/yin/vm/ucf/handoff.cljc:980:(defn- value-decoder\nsrc/cljc/yin/vm/ucf/handoff.cljc:1027:(defn- spawn-child-template\nsrc/cljc/yin/vm/ucf/handoff.cljc:1051:(defn- resume-installs\nsrc/cljc/yin/vm/ucf/handoff.cljc:1073:(defn- link-pair-resources\nsrc/cljc/yin/vm/ucf/handoff.cljc:1099:(defn- lower-frame!\nsrc/cljc/yin/vm/ucf/handoff.cljc:1163:(defn resume-task\nsrc/cljc/yin/vm/ucf/handoff.cljc:1164:  \"The lower of 14.1.2: `bytes`, a handoff body this namespace minted,\ntest/yin/vm/ucf/handoff_test.cljc:3:   14.1.3): the kept-cursor rows over ACTUAL canonical bytes.\ntest/yin/vm/ucf/handoff_test.cljc:7:   the same composition: the three same-host pairs of 14.1.1's matrix\ntest/yin/vm/ucf/handoff_test.cljc:15:   bytes (14.1.3: process transport is recorded separately).\ntest/yin/vm/ucf/handoff_test.cljc:19:   runs every safepoint kind of 14.1.1's table -- a blocked read at\ntest/yin/vm/ucf/handoff_test.cljc:48:(defn- ring\ntest/yin/vm/ucf/handoff_test.cljc:55:(defn- make-ring-stream\ntest/yin/vm/ucf/handoff_test.cljc:61:(defn- new-machine\ntest/yin/vm/ucf/handoff_test.cljc:71:(def ^:private semantic-vector\ntest/yin/vm/ucf/handoff_test.cljc:79:(defn- load-ast\ntest/yin/vm/ucf/handoff_test.cljc:85:(defn- toy\ntest/yin/vm/ucf/handoff_test.cljc:96:(defn- served-peer\ntest/yin/vm/ucf/handoff_test.cljc:106:(defn- serve-mirror!\ntest/yin/vm/ucf/handoff_test.cljc:113:(defn- server\ntest/yin/vm/ucf/handoff_test.cljc:127:(defn- attacher\ntest/yin/vm/ucf/handoff_test.cljc:133:(defn- one-slot-stream\ntest/yin/vm/ucf/handoff_test.cljc:179:(defn- lit\ntest/yin/vm/ucf/handoff_test.cljc:184:(defn- v\ntest/yin/vm/ucf/handoff_test.cljc:189:(defn- lam\ntest/yin/vm/ucf/handoff_test.cljc:194:(defn- app\ntest/yin/vm/ucf/handoff_test.cljc:199:(defn- def!\ntest/yin/vm/ucf/handoff_test.cljc:204:(defn- then\ntest/yin/vm/ucf/handoff_test.cljc:209:(defn- cursor-of\ntest/yin/vm/ucf/handoff_test.cljc:214:(defn- next-of\ntest/yin/vm/ucf/handoff_test.cljc:219:(defn- let1\ntest/yin/vm/ucf/handoff_test.cljc:224:(defn- nested-reads\ntest/yin/vm/ucf/handoff_test.cljc:236:(defn- reader-at-depth\ntest/yin/vm/ucf/handoff_test.cl