d)))\n579: \n580: \n581: (defn ratio\n582:   \"Rational content numerator/denominator, reduced with the sign on the\n583:    numerator. Denominator 1 keeps rational kind (a Rational carrier);\n584:    on the JVM other ratios are clojure.lang.Ratio. A zero denominator is\n585:    refused.\"\n586:   [numerator denominator]\n587:   (let [n (big numerator)\n588:         d (big denominator)]\n589:     (when (zero? (bsign d))\n590:       (refuse :malformed-number \"zero denominator\"))\n591:     (let [[n d] (if (neg? (bsign d)) [(b- zero n) (b- zero d)] [n d])\n592:           g (bgcd n d)\n593:           n (bquot n g)\n594:           d (bquot d g)]\n595:       #?(:cljd (Rational. n d)\n596:          :clj (if (= one d)\n597:                 (Rational. n d)\n598:                 (clojure.lang.Ratio. ^BigInteger n ^BigInteger d))\n599:          :cljs (Rational. n d)))))\n600: \n601: \n602: (defn ratio-numerator\n603:   [r]\n604:   #?(:cljd (.-numerator ^Rational r)\n605:      :clj (if (instance? Rational r)\n606:             (.-numerator ^Rational r)\n607:             (.numerator ^clojure.lang.Ratio r))\n608:      :cljs (.-numerator ^Rational r)))\n609: \n610: \n611: (defn ratio-denominator\n612:   [r]\n613:   #?(:cljd (.-denominator ^Rational r)\n614:      :clj (if (instance? Rational r)\n615:             (.-denominator ^Rational r)\n616:             (.denominator ^clojure.lang.Ratio r))\n617:      :cljs (.-denominator ^Rational r)))\n618: \n619: \n620: ;; ==========================================================================\n621: ;; Portable numeric operations\n622: ;; ==========================================================================\n623: \n624: (defn- float-fields\n625:   \"[negative? biased-exponent fraction-big] of a host double.\"\n626:   [d]\n627:   #?(:cljd (let [bd (ByteData. 8)]\n628:              (.setFloat64 bd 0 d)\n629:              (let [hi (.getUint32 bd 0)\n630:                    lo (.getUint32 bd 4)]\n631:                [(>= hi 0x80000000)\