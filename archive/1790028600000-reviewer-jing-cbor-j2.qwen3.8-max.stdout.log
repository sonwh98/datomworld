two p)) one]\n672:                                (reduced-fraction m (bpow two (- p)))))))\n673:     (decimal? x) (let [e (decimal-exponent x)\n674:                        m (big (decimal-mantissa x))]\n675:                    (if (>= e 0)\n676:                      [:finite (b* m (bpow ten e)) one]\n677:                      (reduced-fraction m (bpow ten (- e)))))\n678:     ;; Reduced here too, so a hand-built unreduced carrier such as\n679:     ;; (->Rational 2 4) still keys, hashes and compares as 1/2.\n680:     (ratio? x) (let [n (big (ratio-numerator x))\n681:                      d (big (ratio-denominator x))]\n682:                  (when (zero? (bsign d))\n683:                    (refuse :malformed-number \"zero denominator\"))\n684:                  (if (neg? (bsign d))\n685:                    (reduced-fraction (b- zero n) (b- zero d))\n686:                    (reduced-fraction n d)))\n687:     :else (refuse :unsupported-value (str \"not a portable number: \" (type-name x)))))\n688: \n689: \n690: (defn- exact-key\n691:   \"A host-independent value key of an exact triple: strings, so equal\n692:    values give equal keys on every host. Its `hash`, and so num-hash\n693:    and equiv-hash, is host-specific (Murmur3 on the JVM, another scheme\n694:    on JavaScript): hash values are for use within one host and must\n695:    never cross hosts.\"\n696:   [[kind a b]]\n697:   (case kind\n698:     :finite [:finite (str a) (str b)]\n699:     :inf [:inf a]\n700:     :nan [:nan]))\n701: \n702: \n703: (defn num=\n704:   \"Portable numeric equality: exact mathematical value, independent of\n705:    kind, decimal scale and zero sign; canonical NaNs are equal. Symmetric\n706:    across native numbers and carriers.\"\n707:   [a b]\n708:   (= (exact-key (exact a)) (exact-key (exact b))))\n709: \n710: \n711: (defn num-hash\n712:   \"A hash consistent with num=.\"\n713:   [x]\n714:   (hash (exact-key (exact x))))\n715: \n716: \n717: (defn- rank\n718:   [[kind a]]\n719:   (case kind\n720:     :inf (if (neg? a) 0 2)\n721:     :finite 1\n722:     :nan 3))\n723: \n724: \n725: (defn num-compare\n726:   \"Portable numeric order: -infinity < finite values (by exact value,\n727:    never rounded through double) < +infinity < NaN. Returns -1, 0 or 1.\"\n728:   [a b]\n729:   (let [x (exact a)\n730:         y (exact b)\n731:         rx (rank x)\n732:         ry (rank y)]\n733:     (cond\n734:       (< rx ry) -1\n735:       (> rx ry) 1\n736:       (= :finite (first x)) (let [[_ n1 d1] x\n737:                                   [_ n2 d2] y]\n738:                               (bcmp (b* n1 d2) (b* n2 d1)))\n739:       :else 0)))\n740: \n741: \n742: (defn- identifier-key\n743:   [x]\n744:   [(if (keyword? x) :keyword :symbol) (namespace x) (name x)])\n745: \n746: \n747: (defn- sequential-value?\n748:   [x]\n749:   (or (vector? x) (list? x) (seq? x)))\n750: \n751: \n752: (declare equiv)\n753: \n754: \n755: (defn equiv-hash\n756:   \"A hash consistent with equiv.\"\n757:   [x]\n758:   (cond\n759:     (numeric? x) (num-hash x)\n760:     (wire/byte-payload? x) (hash (bytes-hex x))\n761:     (or (keyword? x) (symbol? x)) (hash (identifier-key x))\n762:     (sequential-value? x) (hash (mapv equiv-hash x))\n763:     (map? x) (hash (set (map (fn [[k v]] [(equiv-hash k) (equiv-hash v)]) x)))\n764:     (set? x) (hash (set (map equiv-hash x)))\n765:     :else (hash x)))\n766: \n767: \n768: (defn- member?\n769:   \"True when some element of coll is equiv to x.\"\n770:   [coll x]\n771:   (boolean (some #(equiv x %) coll)))\n772: \n773: \n774: (defn equiv\n775:   \"Portable decoded equality: numbers by num=, byte strings by content,\n776:    identifiers by their namespace and name fields, lists equal to vectors\n777:    with equal items (README ruling A6), maps and sets by members;\n778:    metadata ignored. This is the equality whose collapses encode and\n779:    decode refuse.\"\n780:   [a b]\n781:   (cond\n782:     (or (numeric? a) (numeric? b)) (and (numeric? a) (numeric? b) (num= a b))\n783:     (or (wire/byte-payload? a) (wire/byte-payload? b))\n784:     (and (wire/byte-payload? a) (wire/byte-payload? b) (bytes= a b))\n785:     (or (keyword? a) (symbol? a)) (and (or (keyword? b) (symbol? b))\n786:                                        (= (identifier-key a) (identifier-key b)))\n787:     (sequential-value? a) (and (sequential-value? b)\n788:                                (loop [xs (seq a) ys (seq b)]\n789:                                  (cond (and (nil? xs) (nil? ys)) true\n790:                                        (or (nil? xs) (nil? ys)) false\n791:                                        (equiv (first xs) (first ys))\n792:                                        (recur (next xs) (next ys))\n793:                                        :else false)))\n794:     (map? a) (and (map? b)\n795:                   (= (count a) (count b))\n796:                   (every? (fn [[k v]]\n797:                             (some (fn [[k2 v2]] (and (equiv k k2) (equiv v v2))) b))\n798:                           a))\n799:     (set? a) (and (set? b)\n800:                   (= (count a) (count b))\n801:                   (every? #(member? b %) a))\n802:     :else (= a b)))\n803: \n804: \n805: (defn- collapse?\n806:   \"True when two of xs are equiv.\"\n807:   [xs]\n808:   (boolean\n809:     (some (fn [[_ group]]\n810:             (when (< 1 (count group))\n811:               (some (fn [[i x]]\n812:                       (some (fn [y] (equiv x y)) (drop (inc i) group)))\n813:                     (map-indexed vector group))))\n814:           (group-by equiv-hash xs))))\n815: \n816: \n817: ;; ==========================================================================\n818: ;; Encode: normalize a value into a wire tree, then Boring writes it\n819: ;; ==========================================================================\n820: \n821: (def ^:private reader-position-keys\n822:   [:line :column :end-line :end-column])\n823: \n824: \n825: (defn- char-code\n826:   [s i]\n827:   #?(:cljd (.codeUnitAt ^String s i)\n828:      :clj (int (.charAt ^String s (int i)))\n829:      :cljs (.charCodeAt s i)))\n830: \n831: \n832: (defn- check-text\n833:   \"s itself, after refusing any unpaired UTF-16 surrogate.\"\n834:   [s]\n835:   (let [n (count s)]\n836:     (loop [i 0]\n837:       (when (< i n)\n838:         (let [c (char-code s i)]\n839:           (cond\n840:             (<= 0xD800 c 0xDBFF)\n841:             (if (and (< (inc i) n) (<= 0xDC00 (char-code s (inc i)) 0xDFFF))\n842:               (recur (+ i 2))\n843:               (refuse :unpaired-surrogate (str \"unpaired high surrogate at \" i)))\n844:             (<= 0xDC00 c 0xDFFF)\n845:             (refuse :unpaired-surrogate (str \"unpaired low surrogate at \" i))\n846:             :else (recur (inc i)))))))\n847:   s)\n848: \n849: \n850: (def max-depth\n851:   \"The deepest CBOR item nesting encode emits and decode accepts. The\n852:    top-level item is at depth 1 and every array, map and tag puts its\n853:    contents one level deeper, so a list frame (tag, [name items]) costs\n854:    three levels. A J1 policy pending architect ratification (RFC 8949\n855:    section 10 recommends a nesting limit); no corpus payload nests\n856:    beyond a handful of levels. It bounds recursion on both paths, so a\n857:    hostile payload is refused instead of overflowing the host stack.\"\n858:   128)\n859: \n860: \n861: (defn- deep!\n862:   \"Refuse with cls when an item would sit deeper than max-depth.\"\n863:   [d cls]\n864:   (when (> d max-depth)\n865:     (refuse cls (str \"nesting deeper than \" max-depth))))\n866: \n867: \n868: (declare wire-of)\n869: \n870: \n871: (defn- int-wire\n872:   \"The wire node, at depth d, of exact integer b (a host big integer).\"\n873:   [b d]\n874:   (cond\n875:     (and (<= 0 (bcmp b neg-two-64)) (neg? (bcmp b two-64)))\n876:     (do (deep! d :unsupported-value) (wire/integer (b->int b)))\n877:     (pos? (bsign b)) (do (deep! (inc d) :unsupported-value)\n878:                          (wire/tagged 2 (magnitude-bytes b)))\n879:     :else (do (deep! (inc d) :unsupported-value)\n880:               (wire/tagged 3 (magnitude-bytes (b- (b- zero b) one))))))\n881: \n882: \n883: (defn- float-wire\n884:   [x d]\n885:   (deep! (+ d 2) :unsupported-value)\n886:   (let [f (float-value x)\n887:         bs #?(:cljd (let [bd (ByteData. 8)]\n888:                       (if (.-isNaN ^double f)\n889:                         (do (.setUint32 bd 0 0x7ff80000) (.setUint32 bd 4 0))\n890:                         (.setFloat64 bd 0 f))\n891:                       (.asUint8List (.-buffer bd)))\n892:               :clj (let [buf (ByteBuffer/allocate 8)]\n893:                      (.putLong buf (if (Double/isNaN f)\n894:                                      0x7ff8000000000000\n895:                                      (Double/doubleToRawLongBits f)))\n896:                      (.array buf))\n897:               :cljs (let [out (js/Uint8Array. 8)\n898:                           view (js/DataView. (.-buffer out))]\n899:                       (if (js/isNaN f)\n900:                         (do (.setUint32 view 0 0x7ff80000) (.setUint32 view 4 0))\n901:                         (.setFloat64 view 0 f))\n902:                       out))]\n903:     (wire/frame 'dao.jing/float64 bs)))\n904: \n905: \n906: (defn- number-wire\n907:   [x d]\n908:   (cond\n909:     (host-integer? x)\n910:     (do #?(:cljs (when (and (number? x) (not (js/Number.isSafeInteger x)))\n911:                    (refuse :unsupported-value\n912:                            \"unsafe integral JavaScript number; pass a BigInt or float64\")))\n913:         (int-wire (big x) d))\n914:     (float64? x) (float-wire x d)\n915:     (decimal? x) (do (deep! (inc d) :unsupported-value)\n916:                      (wire/tagged 4 [(int-wire (big (decimal-exponent x)) (+ d 2))\n917:                                      (int-wire (big (decimal-mantissa x)) (+ d 2))]))\n918:     :else (let [[_ n den] (exact x)]\n919:             (deep! (inc d) :unsupported-value)\n920:             (wire/tagged 30 [(int-wire n (+ d 2)) (int-wire den (+ d 2))]))))\n921: \n922: \n923: (defn- members-wire\n924:   \"Wire the [key value] pairs (value nil for set elements) of one\n925:    collection, members at depth d, refusing duplicate canonical encodings\n926:    (dup-class) and portable-equality collapses before the collection is\n927:    built. Returns [[key-bytes-hex key-wire value-wire] ...].\"\n928:   [pairs set? dup-class d]\n929:   (let [wired (mapv (fn [[k v]]\n930:                       (let [kw (wire-of k d)\n931:                             vw (when-not set? (wire-of v d))]\n932:                         [(bytes-hex (wire/encode kw)) kw vw]))\n933:                     pairs)]\n934:     (when (< (count (set (map first wired))) (count wired))\n935:       (refuse dup-class))\n936:     (when (collapse? (map first pairs))\n937:       (refuse :equality-collapse))\n938:     wired))\n939: \n940: \n941: (defn- map-wire\n942:   \"A map at depth d; keys and values one level deeper.\"\n943:   [m d]\n944:   (deep! d :unsupported-value)\n945:   (let [wired (members-wire (seq m) false :duplicate-key (inc d))]\n946:     (wire/map-node wired)))\n947: \n948: \n949: (defn- set-wire\n950:   \"Tag 258 at depth d over an array at d+1; elements at d+2.\"\n951:   [s d]\n952:   (deep! (inc d) :unsupported-value)\n953:   (let [wired (members-wire (map (fn [x] [x nil]) s) true :duplicate-element (+ d 2))]\n954:     (wire/tagged 258 (mapv second (sort-by first wired)))))\n955: \n956: \n957: (defn- meta-wire\n958:   \"The wire node of x at depth d, where (build depth) wires x's own\n959:    content starting at that depth. If x carries metadata that survives\n960:    stripping, a with-meta frame sits at d and x's content moves two\n961:    levels deeper (tag, [meta value]). Stripped values are validated\n962:    first (ruling A9); a metadata map carrying its own metadata is\n963:    refused (ruling A3).\"\n964:   [x d build]\n965:   (let [m (meta x)]\n966:     (if (nil? m)\n967:       (build d)\n968:       (do (when (some? (meta m))\n969:             (refuse :malformed-frame \"metadata map carries metadata\"))\n970:           (doseq [k reader-position-keys\n971:                   :when (contains? m k)]\n972:             (wire-of (get m k) (+ d 3)))\n973:           (let [kept (apply dissoc m reader-position-keys)]\n974:             (if (empty? kept)\n975:               (build d)\n976:               (wire/frame 'clojure/with-meta\n977:                           [(map-wire kept (+ d 2)) (build (+ d 2))])))))))\n978: \n979: \n980: (defn- identifier-wire\n981:   \"Tag 27 at depth d over [name [ns name]]: the components at d+3.\"\n982:   [tag-symbol x d]\n983:   (deep! (+ d 3) :unsupported-value)\n984:   (wire/frame tag-symbol\n985:               (wire/array-node [(if-some [ns (namespace x)]\n986:                                   (wire/text (check-text ns))\n987:                                   (wire/null))\n988:                                 (wire/text (check-text (name x)))])))\n989: \n990: \n991: (defn- list-wire\n992:   \"Tag 27 at depth d over [\\\"dao.jing/list\\\" items]: items at d+3.\"\n993:   [x d]\n994:   (deep! (+ d 2) :unsupported-value)\n995:   (wire/frame 'dao.jing/list (mapv #(wire-of % (+ d 3)) x)))\n996: \n997: \n998: (defn- wire-of\n999:   \"The wire tree of one value whose outermost item sits at depth d, or a\n1000:    refusal.\"\n1001:   [x d]\n1002:   (cond\n1003:     (nil? x) (do (deep! d :unsupported-value) (wire/null))\n1004:     (boolean? x) (do (deep! d :unsupported-value) (wire/bool x))\n1005:     (string? x) (do (deep! d :unsupported-value) (wire/text (check-text x)))\n1006:     ;; Keywords cannot carry metadata on any host (not IObj / IWithMeta;\n1007:     ;; pinned by a test), so there is none to wrap.\n1008:     (keyword? x) (identifier-wire 'dao.jing/keyword x d)\n1009:     (symbol? x) (meta-wire x d #(identif