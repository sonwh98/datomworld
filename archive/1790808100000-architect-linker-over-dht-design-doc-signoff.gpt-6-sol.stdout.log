{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '60,310p' src/cljc/yin/vm/linker/authority.cljc | nl -ba -v60\"","aggregated_output":"    60\t;; Datom ingestion (section 8.2)\n    61\t;; =============================================================================\n    62\t\n    63\t(defn events-from-datoms\n    64\t  \"The section 8.2 authority event sequence, assembled from the\n    65\t   assertion datoms a composition read at its snapshot: every\n    66\t   `[ev :yin.module/envelope env]` datom yields one event whose proof is\n    67\t   the one `[ev :yin.module/proof proof]` value of the same entity. An\n    68\t   entity carrying two distinct proof values has no proof: none is\n    69\t   picked, so the event is the no-proof case, whatever the datom order.\n    70\t   An envelope datom with no proof datom is the no-proof case the policy\n    71\t   discards as :unauthenticated; a proof datom with no envelope datom\n    72\t   names no event and is ignored -- section 8.2's diagnostic kinds are a\n    73\t   closed set, and an orphan proof is no envelope at all. `carrier` is\n    74\t   the :dao.stream/identity of the one stream the composition read at\n    75\t   the snapshot, marked on every event for the attested check; nil means\n    76\t   the read names no stream, and an attested proof fails :bad-proof\n    77\t   there. Events keep the handed datoms' order, and the datoms are\n    78\t   already snapshot-bounded by the reader: nothing here reads or\n    79\t   advances a snapshot itself.\"\n    80\t  ([datoms] (events-from-datoms datoms nil))\n    81\t  ([datoms carrier]\n    82\t   (let [proof-of (reduce-kv\n    83\t                    (fn [acc e vs]\n    84\t                      (cond-> acc\n    85\t                        (= 1 (count vs)) (assoc e (first vs))))\n    86\t                    {}\n    87\t                    (reduce (fn [acc [e a v]]\n    88\t                              (cond-> acc\n    89\t                                (= a :yin.module/proof)\n    90\t                                (update e (fnil conj #{}) v)))\n    91\t                            {}\n    92\t                            datoms))]\n    93\t     (into []\n    94\t           (keep (fn [[e a v]]\n    95\t                   (when (= a :yin.module/envelope)\n    96\t                     (cond-> {:yin.module/envelope v}\n    97\t                       (contains? proof-of e)\n    98\t                       (assoc :yin.module/proof (get proof-of e))\n    99\t                       (some? carrier)\n   100\t                       (assoc :dao.stream/identity carrier)))))\n   101\t           datoms))))\n   102\t\n   103\t\n   104\t;; =============================================================================\n   105\t;; Authentication: the two proof kinds (section 8.2)\n   106\t;; =============================================================================\n   107\t\n   108\t(defn- proof-state\n   109\t  \"nil when the event's proof is valid for the principal's declaration,\n   110\t   else the authentication failure: :no-proof, :bad-proof, or\n   111\t   :no-proof-kind when the declaration admits neither proof kind and\n   112\t   the principal cannot assert anything. The verify function's answer\n   113\t   is taken as given; it is composition-supplied host code and is\n   114\t   expected not to throw.\"\n   115\t  [decl event]\n   116\t  (let [proof (get event :yin.module/proof)]\n   117\t    (case (get decl :proof)\n   118\t      :yin.module/signature\n   119\t      (if (map? proof)\n   120\t        (let [sig (get proof :yin.module/signature)]\n   121\t          (if (nil? sig)\n   122\t            :no-proof\n   123\t            (let [verify (get decl :verify)]\n   124\t              (when-not (and verify\n   125\t                             (verify (get decl :key)\n   126\t                                     (jing/canonical-bytes\n   127\t                                       (get event :yin.module/envelope))\n   128\t                                     sig))\n   129\t                :bad-proof))))\n   130\t        :no-proof)\n   131\t      :yin.module/attested\n   132\t      (if (map? proof)\n   133\t        (let [declared (get decl :dao.stream/identity)]\n   134\t          (if (nil? (get proof :yin.module/attested))\n   135\t            :no-proof\n   136\t            ;; the envelope must have been read from the declared log:\n   137\t            ;; copied onto another stream it carries no proof\n   138\t            (if (or (not= declared (get proof :yin.module/attested))\n   139\t                    (not= declared (get event :dao.stream/identity)))\n   140\t              :bad-proof\n   141\t              nil)))\n   142\t        :no-proof)\n   143\t      :no-proof-kind)))\n   144\t\n   145\t\n   146\t(defn- discard-reason\n   147\t  \"The section 8.2 discard reason of an authentication failure kind.\"\n   148\t  [kind]\n   149\t  (case kind\n   150\t    :no-proof :unauthenticated\n   151\t    :bad-proof :unauthenticated\n   152\t    :no-proof-kind :undeclared-principal\n   153\t    kind))\n   154\t\n   155\t\n   156\t(defn- env-diagnostic\n   157\t  \"The diagnostic entry for one discarded envelope.\"\n   158\t  [kind reason env extra]\n   159\t  (merge {:kind kind\n   160\t          :reason reason\n   161\t          :id (when (some? env) (assertion-id env))\n   162\t          :op (when (map? env) (get env :yin.module/op))\n   163\t          :principal (when (map? env) (get env :yin.module/asserted-by))\n   164\t          :seq (when (map? env) (get env :yin.module/seq))}\n   165\t         extra))\n   166\t\n   167\t\n   168\t;; =============================================================================\n   169\t;; The three per-principal passes (section 8.2)\n   170\t;; =============================================================================\n   171\t\n   172\t(defn- honor-passes\n   173\t  \"The three passes over one principal's proven envelopes: deduplicate\n   174\t   by content id (duplicate appearances beyond the first drop\n   175\t   silently), detect equivocation on equal sequence (every envelope of\n   176\t   the principal from the first equivocating sequence on is discarded\n   177\t   as equivocation), then order by sequence and honor each envelope\n   178\t   only past the floor and every sequence honored before it. Returns\n   179\t   {:honored [...] :diagnostics [...]}.\"\n   180\t  [decl proven]\n   181\t  (let [deduped (::kept\n   182\t                  (reduce (fn [acc cand]\n   183\t                            (if (contains? (::seen acc) (:id cand))\n   184\t                              acc\n   185\t                              (-> acc\n   186\t                                  (update ::kept conj cand)\n   187\t                                  (update ::seen conj (:id cand)))))\n   188\t                          {::kept [] ::seen #{}}\n   189\t                          proven))\n   190\t        by-seq (group-by :seq deduped)\n   191\t        eq-min (when-let [eqs (seq (keep (fn [[s cands]]\n   192\t                                           (when (> (count cands) 1) s))\n   193\t                                         by-seq))]\n   194\t                 (reduce min eqs))\n   195\t        {kept :kept equated :equated}\n   196\t        (if eq-min\n   197\t          (group-by (fn [cand]\n   198\t                      (if (>= (:seq cand) eq-min)\n   199\t                        :equated :kept))\n   200\t                    deduped)\n   201\t          {:kept deduped})\n   202\t        floor (or (get decl :seq-floor) 0)\n   203\t        done (reduce (fn [acc cand]\n   204\t                       (if (> (:seq cand) (::last-honored acc))\n   205\t                         (-> acc\n   206\t                             (assoc ::last-honored (:seq cand))\n   207\t                             (update ::honored conj cand))\n   208\t                         (update acc ::replayed conj cand)))\n   209\t                     {::last-honored floor ::honored [] ::replayed []}\n   210\t                     (sort-by :seq (or kept [])))]\n   211\t    {:honored (::honored done)\n   212\t     :diagnostics\n   213\t     (into (mapv (fn [cand]\n   214\t                   (env-diagnostic :equivocation :equivocation\n   215\t                                   (:env cand) nil))\n   216\t                 (or equated []))\n   217\t           (mapv (fn [cand]\n   218\t                   (env-diagnostic :replay :replay (:env cand) nil))\n   219\t                 (::replayed done)))}))\n   220\t\n   221\t\n   222\t;; =============================================================================\n   223\t;; The per-name fold (section 8.2)\n   224\t;; =============================================================================\n   225\t\n   226\t(defn- name-entry\n   227\t  \"The outcome for one name: :absent for zero remaining assertions, a\n   228\t   successful resolution with provenance for exactly one distinct\n   229\t   manifest address, :ambiguous-name naming every remaining address\n   230\t   and asserter for more than one. Entries are ordered by address, so\n   231\t   the outcome never depends on carrier order, recency, or sequence.\"\n   232\t  [decls snapshot cands]\n   233\t  (let [entries (sort-by (fn [e] (str (:address e) \" \" (:asserter e)))\n   234\t                         (distinct\n   235\t                           (map (fn [cand]\n   236\t                                  {:address (get (:env cand)\n   237\t                                                 :yin.module/manifest)\n   238\t                                   :asserter (:principal cand)})\n   239\t                                cands)))\n   240\t        addresses (distinct (map :address entries))\n   241\t        asserters (distinct (map :asserter entries))]\n   242\t    (case (count addresses)\n   243\t      0 {:status :refused :reason :absent}\n   244\t      1 {:status :ok\n   245\t         :address (first addresses)\n   246\t         :yin.link/provenance\n   247\t         {:yin.module/asserted-by (vec asserters)\n   248\t          :yin.link/proof-kind\n   249\t          (vec (distinct (map (fn [p] (get (get decls p) :proof))\n   250\t                              asserters)))\n   251\t          :yin.link/snapshot snapshot}}\n   252\t      {:status :refused\n   253\t       :reason :ambiguous-name\n   254\t       :addresses (vec addresses)\n   255\t       :asserters (vec asserters)})))\n   256\t\n   257\t\n   258\t(defn name-environment\n   259\t  \"Fold `events` under `authority` into the name-environment snapshot\n   260\t   of section 8.2.\n   261\t\n   262\t   `authority` is a map with the snapshot under :snapshot (an index\n   263\t   manifest address or a stream cursor; it is echoed and never\n   264\t   dereferenced here) and the accepted principals under :principals.\n   265\t   A signature principal declares {:proof :yin.module/signature\n   266\t   :key k :verify f}; f is composition-supplied and is called as\n   267\t   (f key canonical-bytes sig). An attested principal declares\n   268\t   {:proof :yin.module/attested :dao.stream/identity id} and every\n   269\t   envelope must have been read from that stream. Either may carry\n   270\t   :seq-floor, the highest sequence already honored for a re-declared\n   271\t   principal (0 for a new one).\n   272\t\n   273\t   Each event is a map: :yin.module/envelope, :yin.module/proof, and,\n   274\t   for the attested check, the :dao.stream/identity the envelope was\n   275\t   read from. An envelope whose proof is absent or fails is\n   276\t   :unauthenticated and is discarded before counting.\n   277\t\n   278\t   Returns {:names {name entry} :diagnostics [...] :honored-seq\n   279\t   {principal highest-honored-sequence} :snapshot s}. Advancing the\n   280\t   snapshot is a fresh call with the advanced authority and events\n   281\t   (the next floor is :honored-seq), never an ambient re-read.\"\n   282\t  [authority events]\n   283\t  (let [decls (:principals authority)\n   284\t        {stage1 :diagnostics proven :proven name-set :names}\n   285\t        (reduce\n   286\t          (fn [acc event]\n   287\t            (let [env (when (map? event)\n   288\t                        (get event :yin.module/envelope))]\n   289\t              (if-some [defect (envelope-defect env)]\n   290\t                (update acc :diagnostics conj\n   291\t                        (env-diagnostic :malformed-envelope\n   292\t                                        :malformed-envelope\n   293\t                                        env {:defect defect}))\n   294\t                (let [principal (get env :yin.module/asserted-by)\n   295\t                      acc (if (= :assert (get env :yin.module/op))\n   296\t                            (update acc :names conj\n   297\t                                    (get env :yin.module/name))\n   298\t                            acc)]\n   299\t                  (if-not (contains? decls principal)\n   300\t                    (update acc :diagnostics conj\n   301\t                            (env-diagnostic :undeclared-principal\n   302\t                                            :undeclared-principal\n   303\t                                            env nil))\n   304\t                    (if-some [failed (proof-state (get decls principal)\n   305\t                                                  event)]\n   306\t                      (update acc :diagnostics conj\n   307\t                              (env-diagnostic failed\n   308\t                                              (discard-reason failed)\n   309\t                                              env nil))\n   310\t                      (update acc :proven conj\n","exit_code":0,"status":"completed"}}
