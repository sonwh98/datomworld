yin.module/of))\n   343\t                                (or retracted [])))\n   344\t        surviving (remove (fn [cand]\n   345\t                            (contains? retracted-ids (:id cand)))\n   346\t                          (or assertions []))\n   347\t        by-name (group-by (fn [cand]\n   348\t                            (get (:env cand) :yin.module/name))\n   349\t                          surviving)]\n   350\t    {:names (into {}\n   351\t                  (map (fn [nm]\n   352\t                         [nm (name-entry decls (:snapshot authority)\n   353\t                                         (get by-name nm))]))\n   354\t                  name-set)\n   355\t     :diagnostics (vec (concat stage1\n   356\t                               (mapcat :diagnostics per-principal)\n   357\t                               (map (fn [cand]\n   358\t                                      (env-diagnostic\n   359\t                                        :dangling-retraction\n   360\t                                        :dangling-retraction\n   361\t                                        (:env cand)\n   362\t                                        {:of (get (:env cand)\n   363\t                                                  :yin.module/of)}))\n   364\t                                    (or dangling []))))\n   365\t     :honored-seq (into {}\n   366\t                        (keep (fn [pr]\n   367\t                                (when (seq (:honored pr))\n   368\t                                  [(:principal pr)\n   369\t                                   (reduce max (map :seq (:honored pr)))])))\n   370\t                        per-principal)\n   371\t     :snapshot (:snapshot authority)}))\n","exit_code":0,"status":"completed"}}
