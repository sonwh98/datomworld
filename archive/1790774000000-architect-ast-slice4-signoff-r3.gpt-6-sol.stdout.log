at i))) i (recur (inc i))))]\n   867\t       (loop [i 0, start 0, parts [], tokens {}, frames ()]\n   868\t         (if (>= i n)\n   869\t           [(apply str (conj parts (subs input start)))\n   870\t            (mapv key (sort-by val tokens))]\n   871\t           (let [c (at i)\n   872\t                 d (when (< (inc i) n) (at (inc i)))\n   873\t                 [i' frames' token]\n   874\t                 (cond\n   875\t                   (#{\" \" \"\\t\" \"\\n\" \"\\r\" \"\\f\" \",\"} c) [(inc i) frames]\n   876\t                   (= \"\\\"\" c) [(string-end (inc i)) frames]\n   877\t                   (= \";\" c) [(line-end i) frames]\n   878\t                   (= \"\\\\\" c) [(token-end (min n (+ i 2))) frames]\n   879\t                   (#{\"'\" \"@\" \"^\" \"`\" \"~\"} c) [(inc i) frames]\n   880\t                   (#{\"(\" \"[\" \"{\"} c) [(inc i) (conj frames :coll)]\n   881\t                   (#{\")\" \"]\" \"}\"} c) [(inc i) (rest frames)]\n   882\t                   (= \"#\" c)\n   883\t                   (case d\n   884\t                     \"(\" [(+ i 2) (conj frames :anon)]\n   885\t                     \"{\" [(+ i 2) (conj frames :coll)]\n   886\t                     \"\\\"\" [(string-end (+ i 2)) frames]\n   887\t                     (\"_\" \"'\" \"=\" \"^\") [(+ i 2) frames]\n   888\t                     \"?\" [(if (and (< (+ i 2) n) (= \"@\" (at (+ i 2)))) (+ i 3) (+ i 2))\n   889\t                          frames]\n   890\t                     \"!\" [(line-end i) frames]\n   891\t                     (\"#\" \":\") [(token-end (+ i 2)) frames]\n   892\t                     [(token-end (inc i)) frames])\n   893\t                   (and (= \"%\" c) (not-any? #{:anon} frames))\n   894\t                   (let [end (token-end (inc i))] [end frames (subs input i end)])\n   895\t                   :else [(token-end i) frames])]\n   896\t             (if token\n   897\t               (let [index (get tokens token (count tokens))]\n   898\t                 (recur i' i'\n   899\t                        (conj parts (subs input start i) (str prefix index))\n   900\t                        (assoc tokens token index)\n   901\t                        frames'))\n   902\t               (recur i' start parts tokens frames'))))))))\n   903\t\n   904\t\n   905\t#?(:cljd\n   906\t   (defn- restore-percent-tokens\n   907\t     \"`form` with each placeholder symbol of `smap` (`{placeholder token}`)\n   908\t      replaced by its token, in values and in metadata alike. A qualified\n   909\t      token (`%/foo`) is restored whole; an unqualified one keeps the\n   910\t      namespace its placeholder gained from the reader (syntax quote,\n   911\t      `#:ns{}`), as the JVM reader qualifies `%` itself. Only a branch that\n   912\t      holds a placeholder is rebuilt; everything else is returned\n   913\t      identical. A rebuilt branch keeps its collection type and order, and\n   914\t      takes exactly `form`'s own metadata (restored), nil included: on\n   915\t      ClojureDart a list built by `(apply list ...)` carries\n   916\t      `{:line ... :tag <Type>}` metadata that dao.jing.cbor refuses.\"\n   917\t     [smap form]\n   918\t     (let [again #(restore-percent-tokens smap %)\n   919\t           same? #(every? true? (map identical? %1 %2))\n   920\t           m (meta form)\n   921\t           m' (when m (again m))\n   922\t           v (cond\n   923\t               (symbol? form) (if-let [token (get smap (symbol (name form)))]\n   924\t                                (if (namespace token)\n   925\t                                  token\n   926\t                                  (symbol (namespace form) (name token)))\n   927\t                                form)\n   928\t               (seq? form) (let [xs (map again form)]\n   929\t                             (if (same? xs form) form (apply list xs)))\n   930\t               (vector? form) (let [xs (mapv again form)]\n   931\t                                (if (same? xs form) form xs))\n   932\t               (map? form) (let [kvs (mapv (fn [[k x]] [(again k) (again x)]) form)]\n   933\t                             (if (same? (mapcat identity kvs) (mapcat identity form))\n   934\t                               form\n   935\t                               (into (empty form) kvs)))\n   936\t               (set? form) (let [xs (mapv again form)]\n   937\t                             (if (same? xs form) form (into (empty form) xs)))\n   938\t               :else form)]\n   939\t       (if (and (identical? v form) (identical? m m'))\n   940\t         form\n   941\t         (with-meta v m')))))\n   942\t\n   943\t\n   944\t#?(:cljd\n   945\t   (defn- read-percent-forms\n   946\t     \"`input`'s forms read as the JVM and JavaScript readers read a bare `%`\n   947\t      token (see `escape-percent-tokens`). A reader refusal that names a\n   948\t      placeholder is rethrown naming the token instead.\"\n   949\t     [input]\n   950\t     (let [read #(edn/read-string (str \"[\" % \"]\"))\n   951\t           prefix (loop [p \"yin_repl_percent_\"]\n   952\t                    (if (str/includes? input p) (recur (str p \"_\")) p))\n   953\t           [text tokens] (escape-percent-tokens input prefix)]\n   954\t       (if (empty? tokens)\n   955\t         (read input)\n   956\t         (let [forms (try (read text)\n   957\t                          (catch Object error\n   958\t                            (let [message (or (ex-message error) (str error))]\n   959\t                              (if (str/includes? message prefix)\n   960\t                                (throw (ex-info\n   961\t                                         (reduce (fn [m i]\n   962\t                                                   (str/replace m (str prefix i)\n   963\t                                                                (nth tokens i)))\n   964\t                                                 message\n   965\t                                                 (reverse (range (count tokens))))\n   966\t                                         {}))\n   967\t                                (throw error)))))]\n   968\t           (restore-percent-tokens\n   969\t             (zipmap (map #(symbol (str prefix %)) (range (count tokens)))\n   970\t                     (map symbol tokens))\n   971\t             forms))))))\n   972\t\n   973\t\n   974\t(defn read-forms\n   975\t  \"The forms of one input line, as a vector, read by the host reader.\n   976\t   Public so the cross-host reader tests can compare the forms, metadata\n   977\t   included, that each host reads.\"\n   978\t  [input]\n   979\t  #?(:cljd (if (str/includes? input \"%\")\n   980\t             (read-percent-forms input)\n   981\t             (edn/read-string (str \"[\" input \"]\")))\n   982\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n   983\t     :clj (clojure.core/read-string (str \"[\" input \"]\"))))\n   984\t\n   985\t\n   986\t(defn- command-form?\n   987\t  [form]\n   988\t  (and (seq? form)\n   989\t       (symbol? (first form))\n   990\t       (contains? command-heads (first form))))\n   305\t(deftest the-reader-keeps-datalog-symbols-on-every-host\n   306\t  ;; A Datalog query or rule set typed at the prompt names its rules input\n   307\t  ;; `%`, a collection binding `...` and a blank `_`: the input reader must\n   308\t  ;; read each as the plain symbol on every host.\n   309\t  (doseq [[line expected]\n   310\t          [[\"(quote [:in $ast $occ % ?root])\" \"[:in '$ast '$occ '% '?root]\"]\n   311\t           [\"(quote [% ?root])\" \"['% '?root]\"]\n   312\t           [\"(quote [?root %])\" \"['?root '%]\"]\n   313\t           [\"(quote [?name ...])\" \"['?name '...]\"]\n   314\t           [\"(quote [:in % :where (r ?x)])\" \"[:in '% :where ('r '?x)]\"]\n   315\t           [\"(quote [$ast ?lam :lambda ?params _])\"\n   316\t            \"['$ast '?lam :lambda '?params '_]\"]]]\n   317\t    (is (= expected (second (repl/eval-input (repl/create-state) line)))\n   318\t        line)))\n   319\t\n   320\t\n   321\t(defn- answer\n   322\t  [line]\n   323\t  (second (repl/eval-input (repl/create-state) line)))\n   324\t\n   325\t\n   326\t(deftest the-reader-reads-percent-forms-alike-on-every-host\n   327\t  ;; Cross-host parity: each line reads to the same form, printed as the\n   328\t  ;; same text, on the JVM, Node and Dart readers, including a `%` right\n   329\t  ;; after a discard, a string and a discarded character literal.\n   330\t  (doseq [[line expected]\n   331\t          [[\"(quote [#_% %])\" \"['%]\"]\n   332\t           [\"(quote [#_#_% % %1])\" \"['%1]\"]\n   333\t           [\"(quote [#_ % %&])\" \"['%&]\"]\n   334\t           [\"(quote [\\\"%\\\" #_\\\\% %])\" \"[\\\"%\\\" '%]\"]\n   335\t           [\"(quote {% [%]})\" \"{'% ['%]}\"]]]\n   336\t    (is (= expected (answer line)) line)))\n   337\t\n   338\t\n   339\t(deftest a-percent-reads-as-any-other-symbol-does\n   340\t  ;; On each host, a line with `%` answers exactly what the same line with\n   341\t  ;; an ordinary symbol answers: the Dart workaround changes nothing but\n   342\t  ;; the `%` itself (map type and order, metadata, duplicate handling and\n   343\t  ;; tag refusals stay the host reader's own).\n   344\t  (doseq [[line plain]\n   345\t          [[\"(quote [% {:z %, :y 2, :x 3}])\" \"(quote [zz9 {:z zz9, :y 2, :x 3}])\"]\n   346\t           [\"(quote [% {:c 1, :b 2, :a 3} #{%}])\"\n   347\t            \"(quote [zz9 {:c 1, :b 2, :a 3} #{zz9}])\"]\n   348\t           [\"(quote [% ^{:m 1} [1 {:b 2, :a 1}] (f (g %))])\"\n   349\t            \"(quote [zz9 ^{:m 1} [1 {:b 2, :a 1}] (f (g zz9))])\"]\n   350\t           [\"(quote #{% %})\" \"(quote #{zz9 zz9})\"]\n   351\t           [\"(quote {% 1 % 2})\" \"(quote {zz9 1 zz9 2})\"]\n   352\t           [\"(quote [#foo %])\" \"(quote [#foo zz9])\"]]]\n   353\t    (is (= (str/replace (answer plain) \"zz9\" \"%\") (answer line)) line)))\n   354\t\n   355\t\n   356\t(defn- shape\n   357\t  \"`form` as plain data that prints alike on every host and shows its\n   358\t   metadata: a map becomes `[:map [k v] ...]` and a set `[:set x ...]`,\n   359\t   entries sorted by printed text, and a form carrying metadata becomes\n   360\t   `[:meta <shape of the metadata> <shape of the form>]`, at every depth.\"\n   361\t  [form]\n   362\t  (let [v (cond (seq? form) (apply list (map shape form))\n   363\t                (vector? form) (mapv shape form)\n   364\t                (map? form) (into [:map]\n   365\t                                  (sort-by pr-str\n   366\t                                           (map (fn [[k x]] [(shape k) (shape x)]) form)))\n   367\t                (set? form) (into [:set] (sort-by pr-str (map shape form)))\n   368\t                :else form)\n   369\t        m (meta form)]\n   370\t    (if (seq m) [:meta (shape m) v] v)))\n   371\t\n   372\t\n   373\t(defn- read-shape\n   374\t  \"The shape of `line`'s forms, or the refusal's message.\"\n   375\t  [line]\n   376\t  (try (pr-str (shape (repl/read-forms line)))\n   377\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   378\t         (str \"refused: \" (or (ex-message e) (str e))))))\n   379\t\n   380\t\n   381\t(deftest a-percent-reads-alike-in-every-symbol-position\n   382\t  ;; Every reader position where a symbol can appear, read to the same\n   383\t  ;; forms, metadata included, on the JVM, Node and Dart.\n   384\t  (let [cases\n   385\t          [[:value \"[% %1 %& (f %) {:k %}]\" \"[[% %1 %& (f %) [:map [:k %]]]]\"]\n   386\t           [:qualified-value \"[%/foo %x/y]\" \"[[%/foo %x/y]]\"]\n   387\t           [:meta-tag \"^% x\" \"[[:meta [:map [:tag %]] x]]\"]\n   388\t           [:meta-map-value \"^{:tag %} x\" \"[[:meta [:map [:tag %]] x]]\"]\n   389\t           [:meta-map-key \"^{% 1} [x]\" \"[[:meta [:map [% 1]] [x]]]\"]\n   390\t           [:meta-nested \"^{:k [%/foo]} (f)\" \"[[:meta [:map [:k [%/foo]]] (f)]]\"]\n   391\t           [:meta-on-coll \"[^% [1] ^% {:a 1} ^% #{1}]\"\n   392\t            \"[[[:meta [:map [:tag %]] [1]] [:meta [:map [:tag %]] [:map [:a 1]]] [:meta [:map [:tag %]] [:set 1]]]]\"]\n   393\t           [:map-key \"{% 1}\" \"[[:map [% 1]]]\"]\n   394\t           [:map-key-qualified \"{%/foo [%]}\" \"[[:map [%/foo [%]]]]\"]\n   395\t           [:set-element \"#{% [%]}\" \"[[:set % [%]]]\"]\n   396\t           [:set-element-qualified \"#{%/foo}\" \"[[:set %/foo]]\"]\n   397\t           [:namespaced-map-key \"#:a{% 1}\" \"[[:map [a/% 1]]]\"]\n   398\t           [:namespaced-map-qualified-key \"#:a{%/foo 1, _/% 2}\" \"[[:map [% 2] [%/foo 1]]]\"]\n   399\t           [:namespaced-map-value \"#:a{:b %}\" \"[[:map [:a/b %]]]\"]]]\n   400\t    ;; one assertion naming every position that differs: a host test\n   401\t    ;; runner that stops at the first failure still reports them all\n   402\t    (is (= [] (into []\n   403\t                    (keep (fn [[position line expected]]\n   404\t                            (let [actual (read-shape line)]\n   405\t                              (when (not= expected actual)\n   406\t                                [position line actual]))))\n   407\t                    cases)))))\n   408\t\n   409\t\n   410\t(deftest a-percent-reads-as-a-symbol-reads-under-syntax-quote\n   411\t  ;; Syntax quote qualifies an unqualified symbol with the reading\n   412\t  ;; namespace and leaves a qualified one alone; its expansion, like the\n   413\t  ;; `'`, `#'` and `@` expansions, is each host's own (Node's EDN reader\n   414\t  ;; has none of them and refuses), so the `%` line is compared with a\n   415\t  ;; plain-symbol line on the same host.\n   416\t  (is (= [] (into []\n   417\t                  (keep (fn [[line plain]]\n   418\t                          (let [actual (read-shape line)\n   419\t                                expected (str/replace (read-shape plain) \"zz9\" \"%\")]\n   420\t                            (when (not= expected actual) [line actual expected]))))\n   421\t                  [[\"['% #'% @% '%/foo]\" \"['zz9 #'zz9 @zz9 'zz9/foo]\"]\n   422\t                   [\"`%\" \"`zz9\"]\n   423\t                   [\"`%/foo\" \"`zz9/foo\"]\n   424\t                   [\"`[% ~% ~@%]\" \"`[zz9 ~zz9 ~@zz9]\"]\n   425\t                   [\"`(f %/foo ^% x)\" \"`(f zz9/foo ^zz9 x)\"]]))))\n   426\t\n   427\t\n   428\t(deftest tagged-literals-and-reader-conditionals-refuse-alike\n   429\t  ;; An unknown tag refuses on every host; the input reader enables no\n   430\t  ;; reader conditionals on any host.\n   431\t  (doseq [line [\"[#foo %]\" \"[#?(:clj %)]\" \"[#?@(:clj [%])]\"]]\n   432\t    (is (str/starts-with? (read-shape line) \"refused: \") line)))\n   433\t\n   434\t\n   435\t(deftest regex-and-anonymous-fn-forms-read-as-on-the-jvm\n   436\t  ;; A `%` after a regex or an anonymous fn literal. Node reads input as\n   437\t  ;; EDN, which has neither form and refuses both; Dart must read them as\n   438\t  ;; the JVM does. (ClojureDart reads only `%1`, `%2`, ... inside `#(...)`.)\n   439\t  (doseq [line [\"(quote [#_#\\\"%\\\" %])\" \"(quote [#_#(+ %1 1) %])\"]]\n   440\t    (let [result (answer line)]\n   441\t      #?(:cljd (is (= \"['%]\" result) line)\n   442\t         :cljs (is (str/starts-with? result \"Error: \") line)\n   443\t         :clj (is (= \"['%]\" result) line)))))\n   444\t\n   445\t\n   446\t(deftest duplicate-percent-keys-are-refused-where-the-reader-refuses-them\n   447\t  ;; The JVM and Node readers refuse duplicate set elements and map keys,\n   448\t  ;; `%` included. ClojureDart's reader refuses no duplicates at all; there\n   449\t  ;; `a-percent-reads-as-any-other-symbol-does` pins that `%` collapses as\n   450\t  ;; any symbol does.\n","exit_code":0,"status":"completed"}}
