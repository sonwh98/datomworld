{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/linker_test.cljc | sed -n '118,155p;900,1055p;1110,1190p'\nrg -n 'local-storage-corruption|tree-with-one-corrupt|a-hostile|zero-parts|constant-key|definition-dominating' test/yin/vm/linker_test.cljc\nnl -ba src/cljc/yin/vm/linker.cljc | sed -n '246,287p'\"","aggregated_output":"   118\t  (app (lam '[a b] (lit 0)) (lam '[] (store-put 'x 1)) (v 'x)))\n   119\t\n   120\t\n   121\t(def ^:private define-then-apply\n   122\t  \"`((fn [_ _] 0) (vm/store-put x 1) ((fn [] x)))`: the binding executes\n   123\t   before the application site that may apply the closure reading x.\"\n   124\t  (app (lam '[a b] (lit 0)) (store-put 'x 1) (app (lam '[] (v 'x)))))\n   125\t\n   126\t\n   127\t(def ^:private apply-then-define\n   128\t  \"`((fn [_ _] 0) ((fn [] x)) (vm/store-put x 1))`: the closure reading\n   129\t   x is applied before the binding executes.\"\n   130\t  (app (lam '[a b] (lit 0)) (app (lam '[] (v 'x))) (store-put 'x 1)))\n   131\t\n   132\t\n   133\t(def ^:private yin-def-then-read\n   134\t  \"`((fn [_ _] 0) (yin/def x 1) x)`: the constant-key `yin/def`\n   135\t   application the macro expander produces (section 4.1) binds `x`; the\n   136\t   second operand reads it after the binding executes.\"\n   137\t  (app (lam '[a b] (lit 0))\n   138\t       (app (v 'yin/def) (lit 'x) (lit 1))\n   139\t       (v 'x)))\n   140\t\n   141\t\n   142\t(def ^:private scan-vector\n   143\t  \"A hand-built canonical vector: an unconditional binding, one inside a\n   144\t   jump's target range, a call site, and a closure body reading `w`.\"\n   145\t  [[:store-put 'y 1]     ; 0 unconditional\n   146\t   [:jump 4]             ; 1 skips 2 and 3\n   147\t   [:store-put 'z 1]     ; 2 inside the jump's target range\n   148\t   [:call 0 false]       ; 3 also inside it\n   149\t   [:halt]               ; 4\n   150\t   [:closure [] 6]       ; 5\n   151\t   [:var 'w]             ; 6 free, inside the closure body\n   152\t   [:return]])           ; 7\n   153\t\n   154\t\n   155\t(def ^:private scan-stack-vector\n   900\t  (let [store (mem/create-content-mem)\n   901\t        leaf-body [:literal 5]\n   902\t        leaf-id (jing/segment-key leaf-body)\n   903\t        mid-body (app-body leaf-id)\n   904\t        mid-id (jing/segment-key mid-body)\n   905\t        root-body (app-body mid-id)\n   906\t        root (jing/segment-key root-body)]\n   907\t    (doseq [body [root-body mid-body leaf-body]]\n   908\t      (jing/materialize! store body))\n   909\t    (testing \"the :max-parts bound\"\n   910\t      (let [res (linker/fetch store {root root} linker/ast-format root\n   911\t                              receiver {:max-parts 1})]\n   912\t        (is (= :parts-limit (:reason res)))\n   913\t        (is (= {:bound :max-parts, :address mid-id}\n   914\t               (select-keys res [:bound :address]))\n   915\t            \"naming the bound and the address it was hit at\")))\n   916\t    (testing \"the :max-depth bound\"\n   917\t      (let [res (linker/fetch store {root root} linker/ast-format root\n   918\t                              receiver {:max-depth 1})]\n   919\t        (is (= :parts-limit (:reason res)))\n   920\t        (is (= {:bound :max-depth, :address leaf-id}\n   921\t               (select-keys res [:bound :address])))))\n   922\t    (testing \"the :max-bytes bound\"\n   923\t      (let [res (linker/fetch store {root root} linker/ast-format root\n   924\t                              receiver {:max-bytes 1})]\n   925\t        (is (= :parts-limit (:reason res)))\n   926\t        (is (= {:bound :max-bytes, :address root}\n   927\t               (select-keys res [:bound :address]))\n   928\t            \"the first payload alone exceeds it\")))\n   929\t    (jing/close! store)))\n   930\t\n   931\t\n   932\t(deftest max-bytes-is-checked-before-decode\n   933\t  (let [store (mem/create-content-mem)\n   934\t        ;; one row that is both oversized and malformed: the budget, not\n   935\t        ;; the row, must be what refuses it under a tight bound\n   936\t        big (into [:literal] (concat (range 512) [:extra]))\n   937\t        root (jing/materialize! store big)]\n   938\t    (is (= {:status :refused, :reason :parts-limit, :bound :max-bytes,\n   939\t            :address root}\n   940\t           (select-keys (linker/fetch store {root root} linker/ast-format\n   941\t                                      root receiver {:max-bytes 64})\n   942\t                        [:status :reason :bound :address]))\n   943\t        \"the oversized row is refused before its slots are decoded and\n   944\t         judged\")\n   945\t    (is (= :descriptor-defect\n   946\t           (:reason (linker/fetch store {root root} linker/ast-format\n   947\t                                  root receiver)))\n   948\t        \"under the finite defaults the same row is judged: the refusal\n   949\t         above is the budget's, not the row's\")\n   950\t    (jing/close! store)))\n   951\t\n   952\t\n   953\t(deftest a-hostile-byte-store-cannot-bypass-the-byte-cap\n   954\t  (let [store (mem/create-content-mem\n   955\t                {(jing/segment-key [:literal 1])\n   956\t                 (jing/canonical-bytes (into [:literal] (range 1000)))})\n   957\t        address (jing/segment-key [:literal 1])\n   958\t        res (linker/fetch store {address address} linker/ast-format\n   959\t                          address receiver {:max-bytes 64})]\n   960\t    (is (= {:status :refused, :reason :parts-limit, :bound :max-bytes,\n   961\t            :address address}\n   962\t           (select-keys res [:status :reason :bound :address]))\n   963\t        \"the byte cap is checked before hashing or decoding, so the\n   964\t         oversized payload is refused even though its address mismatches\")\n   965\t    (let [res (linker/fetch store {address address} linker/ast-format\n   966\t                            address receiver)]\n   967\t      (is (= :address-mismatch (:reason res)))\n   968\t      (is (not (contains? res :value))\n   969\t          \"under the defaults the mismatch is named, and its bytes are\n   970\t           not decoded for refusal evidence\"))\n   971\t    (jing/close! store)))\n   972\t\n   973\t\n   974\t(deftest the-parts-budget-is-enforced-at-enqueue-time\n   975\t  (let [store (mem/create-content-mem)\n   976\t        leaf-id (jing/segment-key [:literal 5])\n   977\t        other-leaf (jing/segment-key [:literal 6])\n   978\t        mid-body (app-body leaf-id)\n   979\t        mid-id (jing/segment-key mid-body)\n   980\t        root-body [:application mid-id [other-leaf] false]\n   981\t        root (jing/segment-key root-body)]\n   982\t    (doseq [body [root-body mid-body]]\n   983\t      (jing/materialize! store body))\n   984\t    (let [counts (atom {})\n   985\t          res (linker/fetch (counting-store store counts)\n   986\t                            {root root} linker/ast-format root\n   987\t                            receiver {:max-parts 2})]\n   988\t      (is (= {:bound :max-parts, :address other-leaf}\n   989\t             (select-keys res [:bound :address]))\n   990\t          \"the child beyond the budget is refused while its sibling is\n   991\t           enqueued, before either is fetched\")\n   992\t      (is (zero? (get @counts mid-id 0))\n   993\t          \"no child beyond the budget is ever read\")\n   994\t      (is (= 1 (get @counts root 0))))\n   995\t    (jing/close! store)))\n   996\t\n   997\t\n   998\t(deftest a-zero-parts-budget-refuses-the-root-unread\n   999\t  (let [store (mem/create-content-mem)\n  1000\t        root (jing/materialize! store [:literal 5])\n  1001\t        counts (atom {})\n  1002\t        res (linker/fetch (counting-store store counts) {root root}\n  1003\t                          linker/ast-format root receiver\n  1004\t                          {:max-parts 0})]\n  1005\t    (is (= {:status :refused, :reason :parts-limit, :bound :max-parts,\n  1006\t            :address root}\n  1007\t           (select-keys res [:status :reason :bound :address]))\n  1008\t        \"a non-positive parts quota refuses even a single-part root as\n  1009\t         :parts-limit naming the bound and the root\")\n  1010\t    (is (zero? (get @counts root 0)) \"the root is not read\")\n  1011\t    (jing/close! store)))\n  1012\t\n  1013\t\n  1014\t(deftest a-fetch-without-explicit-bounds-is-finite\n  1015\t  (let [store (mem/create-content-mem)\n  1016\t        root (loop [child (jing/segment-key [:literal 1]), i 0]\n  1017\t               (if (= i 300)\n  1018\t                 child\n  1019\t                 (let [body (app-body child)]\n  1020\t                   (jing/materialize! store body)\n  1021\t                   (recur (jing/segment-key body) (inc i)))))\n  1022\t        res (linker/fetch store {root root} linker/ast-format root\n  1023\t                          receiver)]\n  1024\t    (is (= {:reason :parts-limit, :bound :max-depth}\n  1025\t           (select-keys res [:reason :bound]))\n  1026\t        \"the linker's own finite `default-bounds` end the walk\")\n  1027\t    (jing/close! store)))\n  1028\t\n  1029\t\n  1030\t;; =============================================================================\n  1031\t;; Section 4.2 step 5a: the occurrence/definition join\n  1032\t;; =============================================================================\n  1033\t\n  1034\t(deftest a-definition-discharges-a-use-after-it\n  1035\t  (doseq [[label format mint] formats]\n  1036\t    (testing label\n  1037\t      (let [store (mem/create-content-mem)\n  1038\t            {:keys [identity index]} (publish store format\n  1039\t                                              (mint def-then-use))\n  1040\t            res (linker/fetch store index format identity)]\n  1041\t        (is (linker/ok? res))\n  1042\t        (is (= [] (:obligations res))\n  1043\t            \"the unconditional definition dominating the read discharges\n  1044\t             it: the image is closed\")\n  1045\t        (jing/close! store)))))\n  1046\t\n  1047\t\n  1048\t(deftest a-constant-key-yin-def-application-is-a-definition\n  1049\t  (let [store (mem/create-content-mem)\n  1050\t        tree (vm/ast->semantic-bytecode yin-def-then-read)\n  1051\t        root (:root tree)\n  1052\t        {:keys [identity index]} (publish store linker/ast-format tree)]\n  1053\t    (is (= [{:name 'x, :at [root [[3 0]]], :conditional? false}]\n  1054\t           ((:definitions-fn linker/ast-format) tree))\n  1055\t        \"the constant-key yin/def application is a definition at its own\n  1110\t    (let [store (mem/create-content-mem)\n  1111\t          {:keys [identity index]}\n  1112\t          (publish store linker/ast-format\n  1113\t                   (vm/ast->semantic-bytecode body-def))]\n  1114\t      ;; the tree's slot order puts the operand before the read: the\n  1115\t      ;; only definition is conditional and earlier\n  1116\t      (is (= {:status :refused, :reason :unresolved-free, :name 'x}\n  1117\t             (select-keys (linker/fetch store index linker/ast-format\n  1118\t                                        identity)\n  1119\t                          [:status :reason :name])))\n  1120\t      (jing/close! store))))\n  1121\t\n  1122\t\n  1123\t(deftest a-definition-dominating-every-application-discharges-a-body-occurrence\n  1124\t  (doseq [[label format mint] vector-formats]\n  1125\t    (testing label\n  1126\t      (let [store (mem/create-content-mem)\n  1127\t            {:keys [identity index]} (publish store format\n  1128\t                                              (mint define-then-apply))\n  1129\t            res (linker/fetch store index format identity)]\n  1130\t        (is (linker/ok? res))\n  1131\t        (is (= [] (:obligations res))\n  1132\t            \"the binding executes before every application site, so the\n  1133\t             body occurrence is discharged\")\n  1134\t        (jing/close! store))))\n  1135\t  (testing \"AST\"\n  1136\t    (let [store (mem/create-content-mem)\n  1137\t          {:keys [identity index]}\n  1138\t          (publish store linker/ast-format\n  1139\t                   (vm/ast->semantic-bytecode define-then-apply))\n  1140\t          res (linker/fetch store index linker/ast-format identity)]\n  1141\t      (is (linker/ok? res))\n  1142\t      (is (= [] (:obligations res))\n  1143\t          \"the binding in the operand executes before the enclosing\n  1144\t           application's invocation, so the body occurrence is\n  1145\t           discharged\")\n  1146\t      (jing/close! store))))\n  1147\t\n  1148\t\n  1149\t(deftest an-application-before-the-definition-retains-the-obligation\n  1150\t  (doseq [[label format mint] formats]\n  1151\t    (testing label\n  1152\t      (let [store (mem/create-content-mem)\n  1153\t            {:keys [identity index]} (publish store format\n  1154\t                                              (mint apply-then-define))]\n  1155\t        (is (= {:status :refused, :reason :unresolved-free, :name 'x}\n  1156\t               (select-keys (linker/fetch store index format identity)\n  1157\t                            [:status :reason :name]))\n  1158\t            \"the site the definition does not dominate keeps the\n  1159\t             obligation; for the tree the inner application's invocation\n  1160\t             precedes the definition\")\n  1161\t        (jing/close! store)))))\n  1162\t\n  1163\t\n  1164\t(deftest a-body-occurrence-with-no-application-site-is-discharged\n  1165\t  (let [store (mem/create-content-mem)\n  1166\t        address (content/materialize-vector! store no-site-vector)]\n  1167\t    (is (linker/ok? (linker/fetch store {address address}\n  1168\t                                  linker/semantic-format address))\n  1169\t        \"nothing applies the closure before halt, so the body occurrence\n  1170\t         runs against every unconditional definition of its name\")\n  1171\t    (jing/close! store)))\n  1172\t\n  1173\t\n  1174\t(deftest an-unreadable-vector-layout-degrades-conservatively\n  1175\t  (let [store (mem/create-content-mem)\n  1176\t        address (content/materialize-vector! store unreadable-vector)\n  1177\t        format linker/semantic-format]\n  1178\t    (is (= [{:name 'q, :at nil, :in-body? true}]\n  1179\t           ((:obligations-fn format) unreadable-vector))\n  1180\t        \"every occurrence is retained, at no position\")\n  1181\t    (is (= [{:name 'x, :at nil, :conditional? true}]\n  1182\t           ((:definitions-fn format) unreadable-vector))\n  1183\t        \"no definition discharges anything\")\n  1184\t    (is (= [{:at nil}] ((:applications-fn format) unreadable-vector))\n  1185\t        \"no application position is usable\")\n  1186\t    (is (= {:status :refused, :reason :unresolved-free, :name 'q}\n  1187\t           (select-keys (linker/fetch store {address address} format\n  1188\t                                      address)\n  1189\t                        [:status :reason :name])))\n  1190\t    (jing/close! store)))\n134:  \"`((fn [_ _] 0) (yin/def x 1) x)`: the constant-key `yin/def`\n564:(deftest local-storage-corruption-is-an-address-mismatch\n859:(deftest tree-with-one-corrupt-child-row-is-an-address-mismatch\n953:(deftest a-hostile-byte-store-cannot-bypass-the-byte-cap\n998:(deftest a-zero-parts-budget-refuses-the-root-unread\n1048:(deftest a-constant-key-yin-def-application-is-a-definition\n1055:        \"the constant-key yin/def application is a definition at its own\n1123:(deftest a-definition-dominating-every-application-discharges-a-body-occurrence\n   246\t  \"Every `:var` name free at some pc of canonical vector `v` (UCF\n   247\t   section 7.3.2): the names of `semantic-free-occurrences`' records,\n   248\t   which carry the scope walk and the degradation.\"\n   249\t  [v]\n   250\t  (into #{} (map :name) (semantic-free-occurrences v)))\n   251\t\n   252\t\n   253\t(defn- step-order\n   254\t  \"The execution order of two occurrence-path steps of one row (section\n   255\t   6.1): a `:node` slot's step is its row position, a `:nodes` slot's\n   256\t   the pair `[position i]`. A bare position evaluates before the\n   257\t   operands of the `:nodes` slot that follows it.\"\n   258\t  [a b]\n   259\t  (cond\n   260\t    (and (integer? a) (integer? b)) (compare a b)\n   261\t    (integer? a) -1\n   262\t    (integer? b) 1\n   263\t    :else (let [n (min (count a) (count b))]\n   264\t            (loop [i 0]\n   265\t              (if (= i n)\n   266\t                (compare (count a) (count b))\n   267\t                (let [c (compare (nth a i) (nth b i))]\n   268\t                  (if (zero? c) (recur (inc i)) c)))))))\n   269\t\n   270\t\n   271\t(defn- path-order\n   272\t  \"The execution order of two occurrence paths from one root (section\n   273\t   4.1's tree order): slot order at the first step where they diverge.\"\n   274\t  [a b]\n   275\t  (let [n (min (count a) (count b))]\n   276\t    (loop [i 0]\n   277\t      (if (= i n)\n   278\t        (compare (count a) (count b))\n   279\t        (let [c (step-order (nth a i) (nth b i))]\n   280\t          (if (zero? c) (recur (inc i)) c))))))\n   281\t\n   282\t\n   283\t(defn- path-before?\n   284\t  \"True when occurrence path `d` executes before occurrence path `u`.\"\n   285\t  [d u]\n   286\t  (neg? (path-order d u)))\n   287\t\n","exit_code":0,"status":"completed"}}
