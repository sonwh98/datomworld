te.cljc hash-verify + strict decode on every found reply), so\n   581\t;; read-address's documented fail-closed catch classifies the handle\n   582\t;; failure :absent; store-level corruption (above) still reaches the\n   583\t;; linker's own step-2 check and remains :address-mismatch.\n   584\t(deftest corrupt-rpc-response-is-classified-absent\n   585\t  (doseq [[label format mint] formats]\n   850\t        root (jing/segment-key root-body)]\n   851\t    (jing/materialize! store root-body)\n   852\t    (is (= {:status :refused, :reason :absent, :address child-id}\n   853\t           (linker/fetch store {root root} linker/ast-format root\n   854\t                         receiver))\n   855\t        \"a tree with one absent child row is :absent naming that row\")\n   856\t    (jing/close! store)))\n   857\t\n   858\t\n   859\t(deftest tree-with-one-corrupt-child-row-is-an-address-mismatch\n   860\t  (let [store (mem/create-content-mem)\n   861\t        child-body [:literal 1]\n   862\t        child-id (jing/segment-key child-body)\n   863\t        root-body (app-body child-id)\n   864\t        root (jing/segment-key root-body)]\n   865\t    (jing/materialize! store root-body)\n   866\t    (jing/materialize! store child-body)\n   867\t    (let [res (linker/fetch (corrupt-at store child-id)\n   868\t                            {root root} linker/ast-format root receiver)]\n   869\t      (is (= :address-mismatch (:reason res)))\n   870\t      (is (= child-id (:address res)) \"the corrupt row is named\")\n   871\t      (is (not (contains? res :value))\n   872\t          \"mismatched bytes are refused undecoded\"))\n   873\t    (jing/close! store)))\n   874\t\n   875\t\n   876\t(deftest tree-with-a-bad-tag-child-fetches-none-of-its-slots\n   877\t  (let [store (mem/create-content-mem)\n   878\t        grandchild-id (jing/segment-key [:literal 1])\n   879\t        child-body [:bogus grandchild-id]\n   880\t        child-id (jing/segment-key child-body)\n   881\t        root-body (app-body child-id)\n   882\t        root (jing/segment-key root-body)\n   883\t        counts (atom {})]\n   884\t    (jing/materialize! store root-body)\n   885\t    (jing/materialize! store child-body)\n  1048\t(deftest a-constant-key-yin-def-application-is-a-definition\n  1049\t  (let [store (mem/create-content-mem)\n  1050\t        tree (vm/ast->semantic-bytecode yin-def-then-read)\n  1051\t        root (:root tree)\n  1052\t        {:keys [identity index]} (publish store linker/ast-format tree)]\n  1053\t    (is (= [{:name 'x, :at [root [[3 0]]], :conditional? false}]\n  1054\t           ((:definitions-fn linker/ast-format) tree))\n  1055\t        \"the constant-key yin/def application is a definition at its own\n  1056\t         position\")\n  1057\t    (let [res (linker/fetch store index linker/ast-format identity\n  1058\t                            receiver)]\n  1059\t      (is (linker/ok? res))\n  1060\t      (is (= '[yin/def] (mapv :name (:obligations res)))\n  1061\t          \"the read after the binding is discharged, not a false free\n  1062\t           obligation; the yin/def operator stays an obligation the\n  1063\t           receiver resolves through its primitives\"))\n  1064\t    (jing/close! store)))\n  1065\t\n  1066\t\n  1067\t(deftest a-use-before-every-definition-is-use-before-definition\n  1068\t  (doseq [[label format mint] formats]\n  1069\t    (testing label\n  1070\t      (let [store (mem/create-content-mem)\n  1071\t            image (mint use-then-def)\n  1072\t            {:keys [identity index]} (publish store format image)\n  1073\t            res (linker/fetch store index format identity)]\n  1074\t        (is (= {:status :refused, :reason :use-before-definition,\n  1075\t                :name 'x}\n419:(defn- query-var-symbol?\n1094:(defn- query-var?\n1159:(defn- eval-or-join\n1167:                (throw (ex-info (str \"or-join branch did not bind join var(s): \"\n1283:      (let [f (get-in ctx [:fns fsym])]\n1285:          (throw (ex-info \"Unknown query fn — pass it via the :fns option\"\n1383:        (and (seq? clause) (= 'or-join (first clause)))\n1384:        (eval-or-join clause bindings ctx)\n1437:(defn- normalize-query\n1634:              (or (:fns opts) {})\n1635:              (merge builtins (:fns opts)))\n1636:        ctx {:fns fns}\n  1330\t   (`path-pop`), not row edges, so it is generic over every §2.3 tag. `$`\n  1331\t   must be the row relation and `$occ` the occurrence relation; the rules\n  1332\t   need `member?` and `path-pop` under `:fns` — see `occurrence-fns`.\n  1333\t   `?root` must be bound at every call: the bodies never bind it, and an\n  1334\t   unscoped invocation fails loudly rather than enumerate.\"\n  1335\t  '[[(p-up ?root ?child ?parent) [(path-pop ?child) ?parent]]\n  1336\t    [(occ-anc ?root ?a ?d) (p-up ?root ?d ?a)]\n  1337\t    [(occ-anc ?root ?a ?d) (p-up ?root ?d ?m) (occ-anc ?root ?a ?m)]\n  1338\t    [(occ-bound? ?root ?path ?name)\n  1339\t     (occ-anc ?root ?lam-path ?path)\n  1340\t     [$occ ?root ?lam-path ?lam]\n  1341\t     [?lam :lambda ?params _]\n  1342\t     [(member? ?params ?name)]]])\n  1343\t\n  1344\t\n  1345\t(def occurrence-fns\n  1346\t  \"The `:fns` map `occurrence-rules` requires (§6.3: quoted-symbol keys):\n  1347\t   membership over a `:syms`/`:nodes` vector, and one step up a §2.5 path\n  1348\t   (nil at the root, where no occurrence tuple carries the answer anyway).\"\n  1349\t  {'member? (fn [coll x] (boolean (some #(= % x) coll))),\n  1350\t   'path-pop (fn [p] (when (pos? (count p)) (subvec p 0 (dec (count p)))))})\n  1351\t\n  1352\t\n  1353\t(defn free-names\n  1354\t  \"§7.7 free-name extraction as a function: every `:variable` name free at\n  1355\t   some occurrence of `root`'s tree. `db` is the row relation\n  1356\t   (`query/relation` over the rows) and `occ` the occurrence relation\n  1357\t   (`occurrences`); both may hold several trees unioned (§6.1) — the rules\n  1358\t   are root-scoped, so only `root`'s binder classifies `root`'s\n  1359\t   occurrences. Conservative by construction: a name whose row is bound at\n  1360\t   one occurrence and free at another is included, never silently dropped\n  1361\t   (§7.6.1).\"\n  1362\t  [db occ root]\n  1363\t  (set (map first\n  1364\t            (query/collect\n  1365\t              (query/q '[:find ?name :in $ $occ % ?root\n  1366\t                         :where\n  1367\t                         [$occ ?root ?path ?v]\n  1368\t                         [?v :variable ?name]\n  1369\t                         (not (occ-bound? ?root ?path ?name))]\n  1370\t                       db occ occurrence-rules root\n  1371\t                       {:fns occurrence-fns})))))\n  1372\t\n  1373\t\n  1374\t;; =============================================================================\n  1375\t;; The footprint table and the §7.7 syntactic extraction queries\n  1376\t;; =============================================================================\n  1377\t;; §7.7: the code part of UCF §7.6.1's conservative fixed point is the\n  1378\t;; queries below, run over the flat rows of every reachable tree ($ast) and\n  1379\t;; the segment-qualified rows of every reachable segment ($code). They\n  1380\t;; supply the fixed point's inputs; the value, name-satisfaction, and\n  1381\t;; module parts remain the walk UCF §7.6.1 specifies. Free names are\n  1382\t;; `free-names` above; everything else the syntactic queries fill is here.\n  1383\t\n  1384\t(def footprint-table\n  1385\t  \"§7.7.1's effect normalization as a data value, keyed by the execution\n  1386\t   contract stamp (UCF §7.3.3) — the effect a syntax tag or mnemonic raises\n  1387\t   is part of that contract, lifted out of the reference machine's hot loop\n  1388\t   (`semantic.cljc`). Two directions: `:tags` over every §2.3 syntax tag\n  1389\t   and `:mnemonics` over every §2.4 mnemonic, each to the set of effect\n  1390\t   identifiers it contributes. Every tag and every mnemonic has a row, so\n  1391\t   \\\"no external effect\\\" is an explicit `#{}`, never an absence; a tag or\n  1392\t   mnemonic outside the table is `:yin.k/undecodable`, the outcome the\n  1393\t   validators give it — and the extraction queries' tag/mnemonic sets are\n  1394\t   table subsets, so over validated rows the lookup is total. The design\n  1395\t   table's tag↔mnemonic correspondence is 1:1 for the effect rows and\n   439\t     - An occurrence in the main sequence (outside every lambda body)\n   440\t       is discharged only by an unconditional definition of that name\n   441\t       that dominates it: for a tree, an earlier sibling in the same\n   442\t       or an enclosing top-level `:do`; for a vector, an earlier pc in\n   443\t       the main sequence with no conditional target range between the\n   444\t       two. A main-sequence occurrence whose only definitions are all\n   445\t       later or all conditional and later is `:use-before-definition`:\n   446\t       in the isolated store it would read nothing, and no manifest\n   447\t       declaration may stand in for a name the module itself defines\n   448\t       unconditionally later. An occurrence whose only definitions are\n   449\t       conditional and earlier retains its obligation, per the rule\n   450\t       above.\n   451\t     - An occurrence inside a lambda body is discharged only by an\n   452\t       unconditional definition of that name that is **proven to\n   453\t       execute before every application of the enclosing closure**.\n   454\t       The body runs at application time, and the applications the\n   455\t       image performs are exactly its application sites\n   456\t       (`:applications-fn`, section 4.1). No value-flow analysis\n   457\t       bounds which closures a site can apply, so every site is\n   458\t       treated as a possible application of every closure the image\n   459\t       creates: a definition discharges a body occurrence only when\n   460\t       it dominates every application site in the main sequence,\n   461\t       under the same order rules as a main-sequence occurrence. A\n   462\t       site inside another body needs no separate case: it executes\n   463\t       only after some main-sequence site has executed, which the\n   464\t       definition dominates, or after halt, by which an unconditional\n   465\t       definition has executed. An image with no application site\n   466\t       discharges a body occurrence against every unconditional\n   467\t       definition of the name: nothing applies the closure before\n   468\t       halt, and after halt the read runs against the module store\n   469\t       the relocation carries (section 7.3), never the receiver's\n   470\t       ambient bindings. Where any site is not dominated, the\n   471\t       obligation is **retained** and must be declared by the\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The four reported fixes are visible. I found one important interaction to verify: the new `yin/def` scanner records the binding at the application row’s entry path, while its value operand is evaluated before the `yin/def` call. That could incorrectly discharge a read inside the value expression."}}
