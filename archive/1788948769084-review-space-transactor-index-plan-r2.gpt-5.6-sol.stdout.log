{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream.cljc | sed -n '80,145p'; nl -ba src/cljc/dao/space/schema.cljc | sed -n '235,380p'; nl -ba test/dao/space/schema_test.cljc | sed -n '1430,1550p'\"","aggregated_output":"    80\t    [this entry]\n    81\t    \"Register a writer waiter. Called when ds/append! returns :full to avoid polling.\n    82\t     The entry contains the datom to write; drain-one! will write it and wake the waiter.\"))\n    83\t\n    84\t\n    85\t(defprotocol IDaoStreamDrainable\n    86\t  \"Optional protocol for destructive consumption.\"\n    87\t\n    88\t  (-drain-one!\n    89\t    [this]\n    90\t    \"Destructively consume one value from stream.\n    91\t     Returns {:ok val, :woke [...]} if a value exists (including any woken writers),\n    92\t     :empty if stream is open and no values available, or :end if stream is closed and drained.\"))\n    93\t\n    94\t\n    95\t(defmulti open!\n    96\t  \"Realize a descriptor into an operational IStream transport.\"\n    97\t  (fn [descriptor] (:dao.stream/type descriptor)))\n    98\t\n    99\t\n   100\t#?(:clj\n   101\t   (defmacro defopen\n   102\t     \"Register an `open!` implementation for descriptors of `{:dao.stream/type dispatch-val}`.\n   103\t\n   104\t      Reads like `defmethod`:\n   105\t\n   106\t        (defopen :http [descriptor] ...body...)\n   107\t\n   108\t      On clj/cljs this expands to `(defmethod open! dispatch-val ...)`.\n   109\t      On ClojureDart, where `defmethod` cannot extend a multimethod defined in\n   110\t      another namespace (the generated type name is munged from the multifn\n   111\t      symbol and fails to resolve), it expands to the equivalent :type-only\n   112\t      deftype + `contribute*` registration.\"\n   113\t     [dispatch-val argv & body]\n   114\t     ;; This body is selected at macro-load time: the ClojureDart host\n   115\t     ;; pass reads with :cljd active, every other host reads :default.\n   116\t     ;; The when-not guard is load-bearing, not dead code: during a\n   117\t     ;; ClojureDart host-eval pass the compiler evaluates macro bodies\n   118\t     ;; that are not compile-time constants (e.g. defopen forms whose\n   119\t     ;; bodies close over runtime values, as test fixtures do) and\n   120\t     ;; rejects them with \"^{:const :required} but expression is not\n   121\t     ;; const\". Returning nil under *host-eval* skips emission for that\n   122\t     ;; pass only; the real Dart compilation pass re-expands and emits.\n   123\t     #?(:cljd (when-not (some-> (resolve 'cljd.compiler/*host-eval*)\n   124\t                                deref)\n   125\t                (let [s (name dispatch-val)\n   126\t                      ;; PascalCase each hyphen-separated segment so\n   127\t                      ;; dispatch keywords like :file-input-stream yield\n   128\t                      ;; a valid Dart id.\n   129\t                      cap (fn [w]\n   130\t                            (str (.toUpperCase (subs w 0 1)) (subs w 1)))\n   131\t                      tname (symbol (str (apply str (map cap (.split s \"-\")))\n   132\t                                         \"OpenMethod\"))\n   133\t                      ;; contribute* needs a fully-qualified contributing\n   134\t                      ;; type; the compiling namespace is exposed on &env\n   135\t                      ;; by ClojureDart.\n   136\t                      qname (symbol (name (get-in &env [:nses :current-ns]))\n   137\t                                    (name tname))]\n   138\t                  `(do (deftype ~tname\n   139\t                         []\n   140\t                         :type-only\n   141\t                         true\n   142\t\n   143\t                         cljd.core/IFn\n   144\t\n   145\t                         (~'-invoke\n   235\t    (when (or (#{:current :history} v)\n   236\t              (= t :dao.space.schema/current))\n   237\t      (throw (ex-info\n   238\t               (str \"schema/current source must be an open!-dispatchable d5 \"\n   239\t                    \"descriptor, not a nested view: \" (pr-str (or v t)))\n   240\t               {:dao.space.query/view v, :dao.stream/type t})))))\n   241\t\n   242\t\n   243\t#_{:clj-kondo/ignore [:unresolved-var]}\n   244\t\n   245\t\n   246\t;; kondo cannot resolve dao.stream vars defined behind :clj reader\n   247\t;; conditionals; query.cljc/transactor.cljc carry these unsuppressed.\n   248\t(defn- interpret-view\n   249\t  \"Shared interpretation core for the schema/current view. Given an\n   250\t   already-opened (and closed) source realization plus as-of /\n   251\t   schema-as-of bounds, returns a fact relation of d3 facts with\n   252\t   card-one collapse applied. Composition of public interpretations:\n   253\t   history view for data, history view for schema, extract-schema,\n   254\t   current-state-seq, then card-one collapse per [e a].\"\n   255\t  [source as-of schema-as-of]\n   256\t  ;; A v1 realization is drained here, where dao.stream already lives: the\n   257\t  ;; query read side takes values only, and the published defopen pre-forces\n   258\t  ;; its rows so the drain never touches the closed store.\n   259\t  (let [source (if (ds/realization? source)\n   260\t                 (query/relation (ds/strict-vec source))\n   261\t                 source)\n   262\t        data-rows   (query/rows (query/history source as-of))\n   263\t        schema-rows (query/rows (query/history source\n   264\t                                               (or schema-as-of as-of)))\n   265\t        schema (extract-schema schema-rows)\n   266\t        ;; Seed with axiom idents: the five :db/* attrs are card-one by\n   267\t        ;; axiom, with or without bootstrap/ident rows present.\n   268\t        card-one-es (into (set (keys axioms))\n   269\t                          (keep (fn [[ident _pm]]\n   270\t                                  (when (= :db.cardinality/one\n   271\t                                           (get (resolve-props schema ident)\n   272\t                                                :db/cardinality))\n   273\t                                    ident)))\n   274\t                          schema)\n   275\t        surviving (query/current-state-seq data-rows)\n   276\t        {card-one-rows true,\n   277\t         pass-through  false}\n   278\t        (group-by #(contains? card-one-es (index/datom-a %)) surviving)\n   279\t        collapsed\n   280\t        (vals\n   281\t          (reduce\n   282\t            (fn [m row]\n   283\t              (let [k [(index/datom-e row) (index/datom-a row)]]\n   284\t                (assoc m k\n   285\t                       (let [prev (get m k)]\n   286\t                         (cond (nil? prev) row\n   287\t                               (< (index/datom-t prev)\n   288\t                                  (index/datom-t row)) row\n   289\t                               (> (index/datom-t prev)\n   290\t                                  (index/datom-t row)) prev\n   291\t                               :else\n   292\t                               (let [c (index/compare-vals\n   293\t                                         (index/datom-v prev)\n   294\t                                         (index/datom-v row))]\n   295\t                                 (if (neg? c) prev row)))))))\n   296\t            {}\n   297\t            (or card-one-rows [])))\n   298\t        all-rows (sort index/eavt-cmp\n   299\t                       (into (vec collapsed) pass-through))\n   300\t        d3-rows (mapv #(subvec (vec %) 0 3) all-rows)]\n   301\t    (query/fact-relation d3-rows)))\n   302\t\n   303\t\n   304\t#_{:clj-kondo/ignore [:unresolved-var]}\n   305\t\n   306\t\n   307\t(defn current\n   308\t  \"The schema-aware current view: d3 facts with card-one collapse applied,\n   309\t   as a query fact-relation value q accepts directly. A query value source\n   310\t   (relation value, opened published index) and an already-opened closed\n   311\t   realization interpret immediately; a v1 open!-dispatchable descriptor\n   312\t   is opened, closed, and interpreted through the defopen route.\n   313\t   Opts map: {:as-of n :schema-as-of n}, both optional.\"\n   314\t  ([source] (current source nil))\n   315\t  ([source opts]\n   316\t   (let [as-of       (when (map? opts) (:as-of opts))\n   317\t         schema-as-of (when (map? opts) (:schema-as-of opts))]\n   318\t     (if (ds/realization? source)\n   319\t       (do (when-not (satisfies? ds/IDaoStreamBound source)\n   320\t             (throw (ex-info\n   321\t                      \"borrowed input must satisfy IDaoStreamBound\"\n   322\t                      {:source source})))\n   323\t           (when-not (ds/closed? source)\n   324\t             (throw (ex-info\n   325\t                      \"borrowed input must be closed\"\n   326\t                      {:source source})))\n   327\t           (interpret-view source as-of schema-as-of))\n   328\t       (let [d (when (map? source) source)]\n   329\t         (when-not d\n   330\t           (throw (ex-info\n   331\t                    \"source must be a descriptor or a closed realization\"\n   332\t                    {:source source})))\n   333\t         ;; Either a query value (relation value, opened published index,\n   334\t         ;; not a nested view) or a legacy descriptor carrying a keyword\n   335\t         ;; :dao.stream/type.\n   336\t         (when-not (or (query/value? d) (keyword? (:dao.stream/type d)))\n   337\t           (throw (ex-info\n   338\t                    \"descriptor must carry :dao.stream/type\"\n   339\t                    {:source source})))\n   340\t         (validate-not-nested-view! d)\n   341\t         ;; query/q opens nothing, so the schema view is interpreted here,\n   342\t         ;; not by its consumer: a query value interprets directly; a v1\n   343\t         ;; open!-dispatchable descriptor keeps the defopen route.\n   344\t         (if (query/value? d)\n   345\t           (interpret-view d as-of schema-as-of)\n   346\t           (let [view (cond-> {:dao.stream/type :dao.space.schema/current\n   347\t                               :source d\n   348\t                               :dao.stream/bound (:dao.stream/bound d)}\n   349\t                        (some? as-of)        (assoc :as-of as-of)\n   350\t                        (some? schema-as-of) (assoc :schema-as-of schema-as-of))]\n   351\t             (ds/open! view))))))))\n   352\t\n   353\t\n   354\t#_{:clj-kondo/ignore [:unresolved-symbol :unresolved-var]}\n   355\t\n   356\t\n   357\t(ds/defopen :dao.space.schema/current\n   358\t            [desc]\n   359\t            (let [src (:source desc)]\n   360\t              (when-not (map? src)\n   361\t                (throw (ex-info \"schema/current descriptor must carry :source\"\n   362\t                                {:descriptor desc})))\n   363\t              (let [r (ds/open! src)]\n   364\t                (try (when-not (satisfies? ds/IDaoStreamReader r)\n   365\t                       (throw (ex-info \"open! did not produce a reader realization\"\n   366\t                                       {:descriptor desc})))\n   367\t                     (ds/close! r)\n   368\t                     (interpret-view r (:as-of desc) (:schema-as-of desc))\n   369\t                     (catch #?(:clj Throwable\n   370\t                               :cljs :default\n   371\t                               :cljd Object)\n   372\t                            error\n   373\t                       (ds/close! r)\n   374\t                       (throw error))))))\n   375\t\n   376\t\n   377\t;; =============================================================================\n   378\t;; The write boundary: validating wrapper (wave 3a)\n   379\t;; =============================================================================\n   380\t\n  1430\t          live-result (qq q-form (schema/current rel))]\n  1431\t      ;; (2) Publish, materialize, query over published via schema/current\n  1432\t      (let [{:keys [manifest-address]} (schema/publish! w)\n  1433\t            path (temp-content-path \"parity\")]\n  1434\t        (try\n  1435\t          (materialize-to-file-store intake path)\n  1436\t          (let [store-coord {:dao.jing/type :dao.jing/file :path path}\n  1437\t                pub-desc (schema/published store-coord manifest-address)]\n  1438\t            (is (= live-result (qq q-form (schema/current pub-desc)))\n  1439\t                \"q answers identically before and after publish\"))\n  1440\t          (finally\n  1441\t            (cleanup-file path))))\n  1442\t      (ds/close! w))))\n  1443\t\n  1444\t\n  1445\t;; ---------------------------------------------------------------------------\n  1446\t;; W39: published-descriptor-as-raw-db-input (§9 publisher parity)\n  1447\t;; ---------------------------------------------------------------------------\n  1448\t\n  1449\t(deftest published-descriptor-as-raw-db-input\n  1450\t  (let [{:keys [local intake]} (fresh-streams)\n  1451\t        w (schema/transactor local intake)]\n  1452\t    (schema/transact! w (bootstrap-tx))\n  1453\t    (schema/transact! w [[7 :person/name \"Alice\"]\n  1454\t                         [8 :person/name \"Bob\"]])\n  1455\t    ;; Drain local to get raw relation for comparison\n  1456\t    (let [all (datoms-of local)\n  1457\t          rel (query/relation all)\n  1458\t          raw-q '[:find ?e ?n :where [?e :person/name ?n]]\n  1459\t          raw-result (qq raw-q (query/current rel))]\n  1460\t      ;; Publish and query over published via schema/current —\n  1461\t      ;; the published descriptor is open!-dispatchable and carries\n  1462\t      ;; covered indexes; schema/current interprets it as a source.\n  1463\t      (let [{:keys [manifest-address]} (schema/publish! w)\n  1464\t            path (temp-content-path \"raw-input\")]\n  1465\t        (try\n  1466\t          (materialize-to-file-store intake path)\n  1467\t          (let [store-coord {:dao.jing/type :dao.jing/file :path path}\n  1468\t                pub-desc (schema/published store-coord manifest-address)\n  1469\t                schema-result (qq raw-q (schema/current pub-desc))]\n  1470\t            (is (= raw-result schema-result)\n  1471\t                \"published descriptor answers same raw query as drained relation\"))\n  1472\t          (finally\n  1473\t            (cleanup-file path))))\n  1474\t      (ds/close! w))))\n  1475\t\n  1476\t\n  1477\t;; ---------------------------------------------------------------------------\n  1478\t;; W40: published-descriptor-validation (§5)\n  1479\t;; ---------------------------------------------------------------------------\n  1480\t\n  1481\t(deftest published-descriptor-validation\n  1482\t  (testing \"non-map content-store throws\"\n  1483\t    (is (thrown-with-msg?\n  1484\t          #?(:cljs js/Error :cljd Object :default Exception)\n  1485\t          #\"DaoJing store coordinate\"\n  1486\t          (schema/published \"not-a-map\" :segment/sha256-abc))))\n  1487\t  (testing \"content-store without :dao.jing/type throws\"\n  1488\t    (is (thrown-with-msg?\n  1489\t          #?(:cljs js/Error :cljd Object :default Exception)\n  1490\t          #\"DaoJing store coordinate\"\n  1491\t          (schema/published {:path \"/tmp/x\"} :segment/sha256-abc))))\n  1492\t  (testing \"non-segment manifest-address throws\"\n  1493\t    (is (thrown-with-msg?\n  1494\t          #?(:cljs js/Error :cljd Object :default Exception)\n  1495\t          #\"manifest content address\"\n  1496\t          (schema/published {:dao.jing/type :dao.jing/file :path \"/tmp/x\"}\n  1497\t                            :not-an-address))))\n  1498\t  (testing \"extra keys in published descriptor rejected at open\"\n  1499\t    (let [{:keys [local intake]} (fresh-streams)\n  1500\t          w (schema/transactor local intake)]\n  1501\t      (schema/transact! w (bootstrap-tx))\n  1502\t      (let [{:keys [manifest-address]} (schema/publish! w)\n  1503\t            path (temp-content-path \"validation\")]\n  1504\t        (try\n  1505\t          (materialize-to-file-store intake path)\n  1506\t          (let [store-coord {:dao.jing/type :dao.jing/file :path path}\n  1507\t                good-desc (schema/published store-coord manifest-address)\n  1508\t                bad-desc (assoc good-desc :extra-key true)]\n  1509\t            (is (thrown-with-msg?\n  1510\t                  #?(:cljs js/Error :cljd Object :default Exception)\n  1511\t                  #\"invalid schema/published descriptor\"\n  1512\t                  (ds/open! bad-desc))))\n  1513\t          (finally\n  1514\t            (cleanup-file path))))\n  1515\t      (ds/close! w))))\n  1516\t\n  1517\t\n  1518\t;; ---------------------------------------------------------------------------\n  1519\t;; W41: published accepted as current source (§7)\n  1520\t;; ---------------------------------------------------------------------------\n  1521\t\n  1522\t(deftest published-accepted-as-current-source\n  1523\t  (let [{:keys [local intake]} (fresh-streams)\n  1524\t        w (schema/transactor local intake)]\n  1525\t    (schema/transact! w (bootstrap-tx))\n  1526\t    (schema/transact! w [[7 :person/name \"Alice\"]])\n  1527\t    (let [{:keys [manifest-address]} (schema/publish! w)\n  1528\t          path (temp-content-path \"current-source\")]\n  1529\t      (try\n  1530\t        (materialize-to-file-store intake path)\n  1531\t        (let [store-coord {:dao.jing/type :dao.jing/file :path path}\n  1532\t              pub-desc (schema/published store-coord manifest-address)]\n  1533\t          ;; schema/current must NOT reject :dao.space.schema/published\n  1534\t          (is (= #{[\"Alice\"]}\n  1535\t                 (qq '[:find ?n :where [7 :person/name ?n]]\n  1536\t                     (schema/current pub-desc)))\n  1537\t              \"published descriptor is accepted as :source by schema/current\"))\n  1538\t        (finally\n  1539\t          (cleanup-file path))))\n  1540\t    (ds/close! w)))\n  1541\t\n  1542\t\n  1543\t;; ---------------------------------------------------------------------------\n  1544\t;; W42: schema-in-source (§9: install-by-transact then read; the view AND\n  1545\t;; the wrapper find schema rows in the same source; raw q sees them as\n  1546\t;; ordinary tuples)\n  1547\t;; ---------------------------------------------------------------------------\n  1548\t\n  1549\t(deftest schema-in-source\n  1550\t  (let [{:keys [local intake]} (fresh-streams)\n","exit_code":0,"status":"completed"}}
