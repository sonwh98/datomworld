{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/space/index_test.cljc | sed -n '1,180p'; nl -ba test/dao/space/index_test.cljc | sed -n '330,420p'; rg -n \\\"increment|flatten|malformed stream|malformed local|transaction record|before emission|snapshot\\\" test/dao/space/index_test.cljc\"","aggregated_output":"     1\t(ns dao.space.index-test\n     2\t  \"Contract tests for dao.space.index: the agent-side covered-index publisher\n     3\t   (docs/design/dao.jing.md, Publication from an agent).\n     4\t\n     5\t   publish-index! snapshots an agent-local dao.stream, builds the four\n     6\t   covered indexes as immutable content-addressed dao.data.btree node blobs,\n     7\t   and appends them to one intake stream selected from an explicit pool. A\n     8\t   DaoJing observer over the pool materializes the blobs; read-manifest /\n     9\t   read-datoms / restored-indexes consume them. Everything runs on JVM,\n    10\t   ClojureScript, and ClojureDart.\"\n    11\t  (:require [clojure.test :refer [deftest is testing]]\n    12\t            [clojure.edn :as edn]\n    13\t            [dao.data.btree :as bt]\n    14\t            [dao.jing :as jing]\n    15\t            [dao.jing.coordinate :as jing-coordinate]\n    16\t            [dao.jing.file :as jing-file]\n    17\t            #?@(:clj [[dao.jing.remote :as jing-remote]])\n    18\t            [dao.space.index :as index]\n    19\t            [dao.stream :as ds]\n    20\t            [dao.stream :as stream]\n    21\t            [dao.stream.ringbuffer :as ringbuffer]\n    22\t            #?@(:cljd [[\"dart:io\" :as dart-io]])))\n    23\t\n    24\t\n    25\t(defrecord MalformedResultStream\n    26\t  [result]\n    27\t  ;; Test double: a reader whose every ds/next answer is the configured\n    28\t  ;; result, used to feed malformed responses into publish-index!'s\n    29\t  ;; snapshot reading.\n    30\t  ds/IDaoStreamReader\n    31\t\n    32\t  (next [_this _cursor] result))\n    33\t\n    34\t\n    35\t(defn- content-handle\n    36\t  \"In-memory content store for tests: a map keyed by content address. The\n    37\t   store atom is exposed as :store so tests can assert on the exact contents\n    38\t   of the backend.\"\n    39\t  ([]\n    40\t   (let [store (atom {})]\n    41\t     {:store store,\n    42\t      :put-content-fn (fn [address payload]\n    43\t                        (if (contains? @store address)\n    44\t                          :present\n    45\t                          (do (swap! store assoc address payload) :inserted))),\n    46\t      :get-content-fn (fn [address not-found]\n    47\t                        (get @store address not-found))})))\n    48\t\n    49\t\n    50\t(defn- counting-content-store\n    51\t  \"Wrap a content-store handle so every :get-content-fn invocation is counted.\n    52\t   Returns {:store wrapped-handle, :gets (fn [] count)} — a minimal counting\n    53\t   harness for observing that the published open path fetches only the\n    54\t   manifest (one get) and faults no tree nodes.\"\n    55\t  [store]\n    56\t  (let [gets (atom 0)\n    57\t        get-fn (:get-content-fn store)]\n    58\t    {:store (assoc store\n    59\t                   :get-content-fn (fn [address not-found]\n    60\t                                     (swap! gets inc)\n    61\t                                     (get-fn address not-found))),\n    62\t     :gets (fn [] @gets)}))\n    63\t\n    64\t\n    65\t(defn- open-local\n    66\t  \"Open a ringbuffer local (agent) stream pre-loaded with datoms.\"\n    67\t  [datoms]\n    68\t  (let [s (ds/open! {:dao.stream/type :ringbuffer})]\n    69\t    (doseq [d datoms] (ds/append! s d))\n    70\t    s))\n    71\t\n    72\t\n    73\t(defn- open-intake\n    74\t  \"A dao.stream ringbuffer intake writer with capacity large enough for\n    75\t   the multi-node tests.\"\n    76\t  ([] (open-intake 4096))\n    77\t  ([capacity]\n    78\t   (:dao.stream/handle\n    79\t     (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    80\t                          :dao.stream.ringbuffer/capacity capacity}))))\n    81\t\n    82\t\n    83\t(defn- intake-values\n    84\t  \"Every value currently on a v2 intake stream, read from its oldest\n    85\t   cursor — the test's view of what publication enqueued.\"\n    86\t  [s]\n    87\t  (loop [cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))\n    88\t         acc []]\n    89\t    (let [r (stream/next s cursor)]\n    90\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    91\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    92\t        acc))))\n    93\t\n    94\t\n    95\t(defn- pool-state\n    96\t  \"Observer state over v2 intake handles, each entered at its oldest\n    97\t   cursor.\"\n    98\t  [intakes]\n    99\t  (jing/observer-state\n   100\t    (mapv (fn [s]\n   101\t            {:stream s\n   102\t             :cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))})\n   103\t          intakes)))\n   104\t\n   105\t\n   106\t(defn- temp-content-path\n   107\t  [prefix]\n   108\t  (str \"target/test-index-stream-\" prefix \"-\" (random-uuid) \".log\"))\n   109\t\n   110\t\n   111\t(defn- cleanup-file\n   112\t  [path]\n   113\t  #?(:clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n   114\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))\n   115\t     :cljd (try (let [f (dart-io/File path)]\n   116\t                  (when (.existsSync f) (.deleteSync f)))\n   117\t                (catch Object _ nil))))\n   118\t\n   119\t\n   120\t(defn- stream-values\n   121\t  [stream]\n   122\t  (ds/strict-vec stream))\n   123\t\n   124\t\n   125\t(defn- materialize-through-observer\n   126\t  \"Drain v2 intake streams through a dao.jing observer into a fresh content\n   127\t   store; returns the store. Draining runs until blocked or end; a gap or\n   128\t   defect is fatal to this composition (E11).\"\n   129\t  [intakes]\n   130\t  (let [h (content-handle)]\n   131\t    (loop [st (pool-state intakes)]\n   132\t      (let [r (jing/observe-step! h st)]\n   133\t        (case (:signal r)\n   134\t          :dao.stream/ok (recur (:state r))\n   135\t          :dao.stream/blocked h\n   136\t          :dao.stream/end h\n   137\t          (throw (ex-info \"test observer hit a gap or defect\"\n   138\t                          {:result r})))))))\n   139\t\n   140\t\n   141\t(defn- datoms\n   142\t  \"n distinct datoms whose four covered orders all differ.\"\n   143\t  [n]\n   144\t  (mapv (fn [i] [i (keyword \"work\" (str \"a\" (mod i 7))) (str \"task-\" i) 0 1])\n   145\t        (range n)))\n   146\t\n   147\t\n   148\t(defn- node-blob?\n   149\t  \"A persisted node blob is a plain EDN map carrying :keys (leaf and branch\n   150\t   blobs both carry it; only branches add :level/:addresses).\"\n   151\t  [x]\n   152\t  (and (map? x) (contains? x :keys)))\n   153\t\n   154\t\n   155\t;; ---------------------------------------------------------------------------\n   156\t;; Snapshot reading and read-back\n   157\t;; ---------------------------------------------------------------------------\n   158\t\n   159\t(deftest publish-index-snapshot-reads-local-stream-and-reads-back\n   160\t  (testing\n   161\t    \"publish-index! walks the agent's local stream from {:position 0}, and\n   162\t          the published manifest reads back the exact datoms through\n   163\t          read-manifest / read-datoms after observer materialization\"\n   164\t    (let [datoms (datoms 300)\n   165\t          local (open-local datoms)\n   166\t          intake (open-intake)\n   167\t          {:keys [manifest-address manifest]} (index/publish-index! local\n   168\t                                                                    [intake])\n   169\t          store (materialize-through-observer [intake])]\n   170\t      (is (= (count datoms) (:count manifest)))\n   171\t      (is (= 512 (:branching-factor manifest)))\n   172\t      (is (= manifest (index/read-manifest store manifest-address)))\n   173\t      (is (= (set datoms) (set (index/read-datoms store manifest-address)))\n   174\t          \"the EAVT walk returns exactly the snapshot datoms\"))))\n   175\t\n   176\t\n   177\t(deftest publish-index-flattens-atomic-transaction-records\n   178\t  (testing\n   179\t    \"one local-stream element may carry an atomic transaction whose\n   180\t            datoms are flattened before the covered indexes are built\"\n   330\t      (is (seq emitted))\n   331\t      (is (= manifest (last emitted)) \"the manifest is appended last\")\n   332\t      (is (every? node-blob? blobs))\n   333\t      (is (= (count blobs) (count (into #{} (map jing/segment-key) blobs)))\n   334\t          \"equal blobs are emitted once, in first-insertion order\")\n   335\t      (doseq [b blobs]\n   336\t        (doseq [child (:addresses b)]\n   337\t          (let [parent-idx (by-address (jing/segment-key b))\n   338\t                child-idx (by-address child)]\n   339\t            (is (and child-idx (< child-idx parent-idx))\n   340\t                (str \"children before parents: child \"\n   341\t                     child\n   342\t                     \" must be emitted \"\n   343\t                     \"before its parent \"\n   344\t                     (jing/segment-key b)))))))))\n   345\t\n   346\t\n   347\t;; ---------------------------------------------------------------------------\n   348\t;; Empty input\n   349\t;; ---------------------------------------------------------------------------\n   350\t\n   351\t(deftest publish-index-of-empty-input-is-readable\n   352\t  (testing\n   353\t    \"publishing an empty local stream yields nil index roots that read back\n   354\t          as no datoms, not an error\"\n   355\t    (let [local (open-local [])\n   356\t          intake (open-intake)\n   357\t          {:keys [manifest-address manifest]} (index/publish-index! local\n   358\t                                                                    [intake])\n   359\t          emitted (vec (intake-values intake))\n   360\t          store (materialize-through-observer [intake])]\n   361\t      (is (= [manifest] emitted) \"only the manifest is appended\")\n   362\t      (is (every? nil? (vals (:indexes manifest))))\n   363\t      (is (zero? (:count manifest)))\n   364\t      (is (= [] (index/read-datoms store manifest-address)))\n   365\t      (let [restored (index/restored-indexes store manifest)]\n   366\t        (is (zero? (bt/count (:eavt restored))))\n   367\t        (is (nil? (bt/seq (:eavt restored))))\n   368\t        (is (nil? (bt/seq (:vaet restored))))))))\n   369\t\n   370\t\n   371\t;; ---------------------------------------------------------------------------\n   372\t;; Failure before emission\n   373\t;; ---------------------------------------------------------------------------\n   374\t\n   375\t(deftest publish-index-gap-local-stream-throws-before-emission\n   376\t  (testing\n   377\t    \"a local stream whose position 0 has been evicted reports :daostream/gap:\n   378\t          publish-index! throws and nothing reaches the intake stream\"\n   379\t    (let [gap (ds/open! {:dao.stream/type :ringbuffer,\n   380\t                         :capacity 2,\n   381\t                         :eviction-policy :evict-oldest})\n   382\t          _ (doseq [i (range 3)] (ds/append! gap [i :test/a i 0 1]))\n   383\t          intake (open-intake)]\n   384\t      (is (thrown-with-msg? #?(:cljs js/Error\n   385\t                               :cljd Object\n   386\t                               :default Exception)\n   387\t                            #\"gap\"\n   388\t            (index/publish-index! gap [intake])))\n   389\t      (is (empty? (intake-values intake))\n   390\t          \"nothing reaches the intake stream before the snapshot completes\"))))\n   391\t\n   392\t\n   393\t(deftest publish-index-malformed-local-stream-throws-before-emission\n   394\t  (testing \"a map without :cursor is malformed\"\n   395\t    (let [bad (->MalformedResultStream {:ok [1 :test/a \"x\" 0 1]})\n   396\t          intake (open-intake)]\n   397\t      (is (thrown-with-msg? #?(:cljs js/Error\n   398\t                               :cljd Object\n   399\t                               :default Exception)\n   400\t                            #\"malformed\"\n   401\t            (index/publish-index! bad [intake])))\n   402\t      (is (empty? (intake-values intake)))))\n   403\t  (testing \"an unknown signal is malformed\"\n   404\t    (let [bad (->MalformedResultStream :bogus)\n   405\t          intake (open-intake)]\n   406\t      (is (thrown-with-msg? #?(:cljs js/Error\n   407\t                               :cljd Object\n   408\t                               :default Exception)\n   409\t                            #\"malformed\"\n   410\t            (index/publish-index! bad [intake])))\n   411\t      (is (empty? (intake-values intake))))))\n   412\t\n   413\t\n   414\t(deftest publish-index-full-intake-stream-throws\n   415\t  (testing\n   416\t    \"an intake append answering :dao.stream/full throws with the result;\n   417\t          only a partial immutable prefix of node blobs lands, never the\n   418\t          manifest\"\n   419\t    (let [local (open-local (datoms 64))\n   420\t          ;; the v2 ringbuffer always evicts rather than answering full, so\n5:   publish-index! snapshots an agent-local dao.stream, builds the four\n29:  ;; snapshot reading.\n159:(deftest publish-index-snapshot-reads-local-stream-and-reads-back\n174:          \"the EAVT walk returns exactly the snapshot datoms\"))))\n177:(deftest publish-index-flattens-atomic-transaction-records\n180:            datoms are flattened before the covered indexes are built\"\n188:      (is (= tx-datoms (index/snapshot-datoms local)))\n372:;; Failure before emission\n390:          \"nothing reaches the intake stream before the snapshot completes\"))))\n718:                       (str order \" covers the snapshot\")))))\n798:          each other and with the source snapshot, on every covered order\"\n814:              (str order \" lazy restore covers the snapshot\"))\n997:          ;; snapshot counter baseline before the seek-path observation\n","exit_code":0,"status":"completed"}}
