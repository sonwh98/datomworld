(:branching-factor manifest))\n   265\t       (<= 2 (:branching-factor manifest))\n   266\t       (if (zero? (:count manifest))\n   267\t         (every? nil? (vals (:indexes manifest)))\n   268\t         (every? jing/segment-address? (vals (:indexes manifest))))))\n   269\t\n   270\t\n   271\t(defn read-manifest\n   272\t  \"Retrieve the manifest stored at a content address. Throws on a missing\n   273\t   address and on a stored value that is not a conforming manifest.\"\n   274\t  [content-store manifest-address]\n   275\t  (let [manifest (jing/get content-store manifest-address content-missing)]\n   276\t    (when (identical? manifest content-missing)\n   277\t      (throw (ex-info \"missing index manifest\" {:address manifest-address})))\n   278\t    (when-not (valid-manifest? manifest)\n   279\t      (throw (ex-info \"invalid index manifest\"\n   280\t                      {:address manifest-address, :manifest manifest})))\n   281\t    (let [actual-address (jing/segment-key manifest)]\n   282\t      (when-not (= manifest-address actual-address)\n   283\t        (throw (ex-info \"index manifest content address mismatch\"\n   284\t                        {:expected manifest-address,\n   285\t                         :actual actual-address,\n   286\t                         :manifest manifest}))))\n   287\t    manifest))\n   288\t\n   289\t\n   290\t(defn read-datoms\n   291\t  \"Eagerly read every datom in the EAVT index of a published manifest, in\n   292\t   index order, by walking the node graph with plain `jing/get`. Takes the\n   293\t   manifest's content address; an empty index reads as ().\"\n   294\t  [content-store manifest-address]\n   295\t  (let [manifest (read-manifest content-store manifest-address)]\n   296\t    (vec (walk-index-datoms content-store (:eavt (:indexes manifest))))))\n   297\t\n   298\t\n   299\t(defn restored-indexes\n   300\t  \"Lazily-loaded {:eavt :aevt :avet :vaet} dao.data.btree sets over a\n   301\t   published manifest (`{:indexes {...} :count n :branching-factor n}`).\n   302\t   Nothing is fetched until a query traverses; slice (subseq-from) then\n   303\t   loads only the seek path plus the matching range. Works on every\n   304\t   platform.\n   305\t\n   306\t   The manifest's :count and :branching-factor are threaded through\n   307\t   restore-tree deliberately: count keeps O(1) `count` on restored trees\n   308\t   without faulting the graph, and the branching factor reaches every\n   309\t   restored node so mutation splits at the published thresholds. A manifest\n   310\t   without :count or :branching-factor is foreign or hand-built and belongs\n   311\t   to the eager path (walk-index-datoms), not here.\"\n   312\t  [content-store manifest]\n   313\t  (let [{:keys [indexes count branching-factor]} manifest\n   314\t        storage (bts/kv-storage content-store\n   315\t                                {:branching-factor (or branching-factor 512)})]\n   316\t    {:eavt (bt/restore-tree eavt-cmp (:eavt indexes) storage count),\n   317\t     :aevt (bt/restore-tree aevt-cmp (:aevt indexes) storage count),\n   318\t     :avet (bt/restore-tree avet-cmp (:avet indexes) storage count),\n   319\t     :vaet (bt/restore-tree vaet-cmp (:vaet indexes) storage count)}))\n   320\t\n   321\t\n   322\t;; =============================================================================\n   323\t;; Published covered index as a bounded logical d5 stream\n   324\t;; =============================================================================\n   325\t\n   326\t(defn published-index\n   327\t  \"Construct a transportable descriptor for one immutable covered-index\n   328\t   manifest. `content-store` is a serializable DaoJing coordinate, not a live\n   329\t   handle. The manifest address is the exact stream bound.\"\n   330\t  [content-store manifest-address]\n   331\t  (when-not (and (map? content-store) (keyword? (:dao.jing/type content-store)))\n   332\t    (throw (ex-info \"published index requires a DaoJing store coordinate\"\n   333\t                    {:content-store content-store})))\n   334\t  (when-not (jing/segment-address? manifest-address)\n   335\t    (throw (ex-info \"published index requires a manifest content address\"\n   336\t                    {:manifest-address manifest-address})))\n   337\t  {:dao.stream/type :dao.space.index/published,\n   338\t   :dao.stream/bound {:manifest-address manifest-address},\n   339\t   :dao.stream/comparator :dao.space.index/eavt,\n   340\t   :content-store content-store,\n   341\t   :manifest-address manifest-address})\n   342\t\n   343\t\n   344\t(defrecord PublishedIndexStream\n   345\t  [descriptor datoms indexes store]\n   346\t\n   347\t  ds/IDaoStreamReader\n   348\t\n   349\t  (next\n   350\t    [_ cursor]\n   351\t    (let [rows (force datoms)\n   352\t          position (or (:position cursor) 0)]\n   353\t      (if (< position (count rows))\n   354\t        {:ok (nth rows position), :cursor {:position (inc position)}}\n   355\t        :end)))\n   356\t\n   357\t\n   358\t  ds/IDaoStreamBound\n   359\t\n   360\t  (close! [_] (jing/close! store) {:woke []})\n   361\t\n   362\t\n   363\t  (closed? [_] true))\n   364\t\n   365\t\n   366\t(defn covered-indexes\n   367\t  \"Return the {:eavt :aevt :avet :vaet} covered d5 sets carried in a\n   368\t   realization's :indexes field, or nil when the realization carries none.\n   369\t   Structural check only: the realization must be a map whose :indexes field\n   370\t   is a map with exactly those four keys, so it is clj/cljs/cljd-portable and\n   371\t   never an instance/type check. It means the realization carries covered d5\n   372\t   sets, not that it is lazy: an in-memory index-datoms map is structurally\n   373\t   indistinguishable, and that is fine (resolution happens the same way\n   374\t   either way).\"\n   375\t  [realization]\n   376\t  (when (map? realization)\n   377\t    (let [indexes (:indexes realization)]\n   378\t      (when (and (map? indexes)\n   379\t                 (= #{:eavt :aevt :avet :vaet} (set (keys indexes))))\n   380\t        indexes))))\n   381\t\n   382\t\n   383\t(ds/defopen :dao.space.index/published\n   384\t            [descriptor]\n   385\t            (let [{:keys [content-store manifest-address]} descriptor\n   386\t                  expected (published-index content-store manifest-address)]\n   387\t              (when-not (= expected descriptor)\n   388\t                (throw (ex-info \"invalid published-index descriptor\"\n   389\t                                {:descriptor descriptor, :expected expected})))\n   390\t              (let [store (jing-coordinate/open! content-store)]\n   391\t                (try (let [manifest (read-manifest store manifest-address)\n   392\t                           indexes (restored-indexes store manifest)]\n   393\t                       (with-meta (->PublishedIndexStream\n   394\t                                    descriptor\n   395\t                                    (delay (vec (bt/seq (:eavt indexes))))\n   396\t                                    indexes\n   397\t                                    store)\n   398\t                         {:dao.stream/descriptor descriptor}))\n   399\t                     (catch #?(:clj Throwable\n   400\t                               :cljs :default\n   401\t                               :cljd Object)\n   402\t                            error\n   403\t                       (jing/close! store)\n   404\t                       (throw error))))))\n   405\t\n   406\t\n   407\t;; =============================================================================\n   408\t;; publish-index! — build, record, append\n   409\t;; =============================================================================\n   410\t\n   411\t(defn- stream-payload-datoms\n   412\t  [payload]\n   413\t  (if (and (map? payload) (contains? payload :dao.space/transaction))\n   414\t    (let [tx (:dao.space/transaction payload)\n   415\t          t (:t tx)\n   416\t          datoms (:datoms tx)]\n   417\t      (when-not (and (map? tx)\n   418\t                     (= #{:t :datoms} (set (keys tx)))\n   419\t                     (integer? t)\n   420\t                     (not (neg? t))\n   421\t                     (vector? datoms)\n   422\t                     (seq datoms)\n   423\t                     (every? datom/local-datom? datoms)\n   424\t                     (every? #(= t (datom-t %)) datoms))\n   425\t        (throw (ex-info \"malformed dao.space transaction record\"\n   426\t                        {:payload payload})))\n   427\t      datoms)\n   428\t    (cond\n   429\t      (datom/local-datom? payload) [payload]\n   430\t      (and (vector? payload) (= 5 (count payload)))\n   431\t      (throw\n   432\t        (ex-info\n   433\t          \"malformed local datom: e and t must be non-negative integers, m an integer, and a a namespaced keyword\"\n   434\t          {:datom payload}))\n   435\t      :else\n   436\t      (throw\n   437\t        (ex-info\n   438\t          \"local stream payload must be a datom or dao.space transaction record\"\n   439\t          {:payload payload})))))\n   440\t\n   441\t\n   442\t(defn snapshot-datoms\n   443\t  \"Eagerly snapshot an agent-local stream by walking `{:position 0}` with\n   444\t   ds/next. A stream element is either one canonical datom vector or one\n   445\t   atomic `{:dao.space/transaction {:t n :datoms [...]}}` record; transaction\n   446\t   records are flattened into their datoms. :blocked and :end finish the\n   447\t   snapshot at the current tail; :daostream/gap and malformed stream results,\n   448\t   datoms, or transaction records throw. publish-index! calls this to\n   449\t   completion before appending anything to an intake stream.\"\n   450\t  [local-stream]\n   451\t  (loop [cursor {:position 0}\n   452\t         datoms []]\n   453\t    (let [result (ds/next local-stream cursor)]\n   454\t      (cond\n   455\t        (map? result)\n   456\t        (if (and (contains? result :ok) (contains? result :cursor))\n   457\t          (recur (:cursor result)\n   458\t                 (into datoms (stream-payload-datoms (:ok result))))\n   459\t          (throw\n   460\t            (ex-info\n   461\t              \"malformed stream result: a successful read must carry both :ok and :cursor\"\n   462\t              {:result result})))\n   463\t        (= result :blocked) datoms\n   464\t        (= result :end) datoms\n   465\t        (= result :daostream/gap)\n   466\t        (throw (ex-info \"stream snapshot gap: position evicted before read\"\n   467\t                        {:cursor cursor}))\n   468\t        :else (throw (ex-info \"malformed stream signal\" {:signal result}))))))\n   469\t\n   470\t\n   471\t(defn- recording-content-handle\n   472\t  \"Temporary in-memory content store for the publish build. :put-content-fn\n   473\t   records each unique node blob on first insertion (answering :present for\n   474\t   duplicates, so the recorded order is first-insertion order, deduplicated);\n   475\t   :get-content-fn reads recorded blobs back. Addresses are minted by\n   220\t   (view-value :history (db-source source) as-of)))\n   221\t\n   222\t\n   223\t;; =============================================================================\n   224\t;; Published indexes: open-published! / close-published! (Decision 1)\n   225\t;; =============================================================================\n   226\t\n   227\t(defn open-published!\n   228\t  \"Open a published covered-index coordinate — the serializable map\n   229\t   `index/published-index` builds — as a query value the caller owns: the\n   230\t   content-store handle it opens is closed by `close-published!`, never by\n   231\t   a query. Nothing is fetched beyond the manifest; the row vector stays\n   232\t   deferred behind :rows and the covered sets behind restored B-trees, so a\n   233\t   `current` view with no as-of can answer selective clauses without a\n   234\t   full drain.\"\n   235\t  [coordinate]\n   236\t  (when-not (and (map? coordinate)\n   237\t                 (= :dao.space.index/published (:dao.stream/type coordinate)))\n   238\t    (throw (ex-info \"open-published! takes a published-index coordinate\"\n   239\t                    {:coordinate coordinate})))\n   240\t  (let [{:keys [content-store manifest-address]} coordinate\n   241\t        expected (index/published-index content-store manifest-address)]\n   242\t    (when-not (= expected coordinate)\n   243\t      (throw (ex-info \"invalid published-index coordinate\"\n   244\t                      {:coordinate coordinate, :expected expected})))\n   245\t    (let [store (jing-coordinate/open! content-store)]\n   246\t      (try\n   247\t        (let [manifest (index/read-manifest store manifest-address)]\n   248\t          {:dao.space.query/published coordinate\n   249\t           :indexes (index/restored-indexes store manifest)\n   250\t           :rows (delay (index/read-datoms store manifest-address))\n   251\t           :store store\n   252\t           :close-guard (atom false)})\n   253\t        (catch #?(:cljd Object\n   254\t                  :clj Throwable\n   255\t                  :cljs :default)\n   256\t               error\n   257\t          (jing/close! store)\n   258\t          (throw error))))))\n   259\t\n   260\t\n   261\t(defn close-published!\n   262\t  \"Close the content-store handle an opened published index owns. A second\n   263\t   close is a no-op here, before the backend is even asked.\"\n   264\t  [opened]\n   265\t  (when-let [guard (:close-guard opened)]\n   266\t    (when (compare-and-set! guard false true)\n   267\t      (jing/close! (:store opened))))\n   268\t  nil)\n   269\t\n   270\t\n   271\t;; =============================================================================\n   272\t;; snapshot: the one dao.stream interpreter (Decision 3)\n   273\t;; =============================================================================\n   274\t\n   275\t(defn snapshot\n   276\t  \"Turn a dao.stream reader handle into a relation value:\n   277\t\n   278\t     {:relation <relation value>\n   279\t      :status   :ended | :blocked | :gap | :defect\n   280\t      :cursor   c            ; the cursor reached; :gap keeps the last retained\n   281\t      :recovery c'}          ; :gap only\n   282\t      :read     raw}         ; :defect only\n   283\t\n   284\t   Mints at :dao.stream/oldest and loops observe/step with a total effect\n   285\t   (conj onto the accumulator, answering ok) until the step stops. Every\n   286\t   stopping outcome is data: :blocked is an open stream caught up (a\n   287\t   snapshot at call time), :gap carries the values read before the hole and\n   288\t   the recovery cursor, :defect the raw answer. The caller decides whether a\n   289\t   partial snapshot is a usable relation. The handle is never closed, and a\n   290\t   cursor never advances past a value the accumulator did not retain (the\n   291\t   step's effect-before-commit).\"\n   292\t  [handle]\n   293\t  (let [mint (stream/cursor handle :dao.stream/oldest)]\n   294\t    (if-not (= :dao.stream/ok (:dao.stream/outcome mint))\n   295\t      {:relation (relation [])\n   296\t       :status :defect\n   297\t       :cursor nil\n   298\t       :read mint}\n   299\t      (loop [cursor (:dao.stream/cursor mint), values []]\n   300\t        (let [acc (volatile! values)\n   301\t              step (observe/step handle cursor\n   302\t                                 (fn [value]\n   303\t                                   (vswap! acc conj value)\n   304\t                                   {:dao.stream/outcome :dao.stream/ok}))]\n   305\t          (case (:status step)\n   306\t            :advance (recur (:cursor step) @acc)\n   307\t            :retry {:relation (relation @acc)\n   308\t                    :status :blocked\n   309\t                    :cursor cursor}\n   310\t            :ended {:relation (relation @acc)\n   311\t                    :status :ended\n   312\t                    :cursor cursor}\n   313\t            :gap {:relation (relation @acc)\n   314\t                  :status :gap\n   315\t                  :cursor cursor\n   316\t                  :recovery (:recovery step)}\n   317\t            ;; :defect, and :failed (impossible for this total effect,\n   318\t            ;; classified the same way if a composition ever produces it)\n   319\t            {:relation (relation @acc)\n   320\t             :status :defect\n   321\t             :cursor cursor\n   322\t             :read (:read step)}))))))\n   323\t\n   324\t\n   325\t;; =============================================================================\n   326\t;; Realize a db-value: value tag -> {::relation ::fact-index ::indexes}\n   327\t;; =============================================================================\n   328\t\n   329\t(defn- relation->fact-index\n   330\t  [relation]\n   331\t  (index/index-datoms (mapv (fn [tuple]\n   332\t                              [(nth tuple 0) (nth tuple 1)\n   333\t                               (nth tuple 2) 0 datom/default-op])\n   334\t                            relation)))\n   335\t\n   336\t\n   337\t(defn- force-relation\n   338\t  \"Force a relation if it is delayed (e.g. from a lazy covered-index\n   339\t   realization) or return it directly. Memoization belongs to the delay:\n   340\t   forcing is therefore at most one walk, but this function itself neither\n   341\t   creates nor guarantees non-nilness.\"\n   342\t  [relation]\n   343\t  (if (delay? relation) @relation relation))\n   344\t\n   345\t\n   346\t(declare realize-db-value!)\n   347\t\n   348\t\n   349\t(defn- realize-datom-view\n   350\t  \"Interpret a current/history view inside the query layer. The nested\n   351\t   source is another query value; a current view with no as-of over an\n   352\t   opened published index routes through the restored covered sets, every\n   353\t   other combination resolves the source's rows.\"\n   354\t  [d]\n   355\t  (let [kind (:dao.space.query/view d)\n8:   publisher (publish!, published descriptor, parity tests).\"\n1431:      ;; (2) Publish, materialize, query over published via schema/current\n1437:                pub-desc (schema/published store-coord manifest-address)]\n1446:;; W39: published-descriptor-as-raw-db-input (§9 publisher parity)\n1449:(deftest published-descriptor-as-raw-db-input\n1460:      ;; Publish and query over published via schema/current —\n1461:      ;; the published descriptor is open!-dispatchable and carries\n1468:                pub-desc (schema/published store-coord manifest-address)\n1471:                \"published descriptor answers same raw query as drained relation\"))\n1478:;; W40: published-descriptor-validation (§5)\n1481:(deftest published-descriptor-validation\n1486:          (schema/published \"not-a-map\" :segment/sha256-abc))))\n1491:          (schema/published {:path \"/tmp/x\"} :segment/sha256-abc))))\n1496:          (schema/published {:dao.jing/type :dao.jing/file :path \"/tmp/x\"}\n1498:  (testing \"extra keys in published descriptor rejected at open\"\n1507:                good-desc (schema/published store-coord manifest-address)\n1511:                  #\"invalid schema/published descriptor\"\n1519:;; W41: published accepted as current source (§7)\n1522:(deftest published-accepted-as-current-source\n1532:              pub-desc (schema/published store-coord manifest-address)]\n1533:          ;; schema/current must NOT reject :dao.space.schema/published\n1537:              \"published descriptor is accepted as :source by schema/current\"))\ntest/dao/space/index_test.cljc:586:(deftest open-published-rejects-unresolvable-and-malformed-descriptors\ntest/dao/space/index_test.cljc:624:(deftest open-published-rejects-missing-and-invalid-manifests\ntest/dao/space/index_test.cljc:681:(deftest published-empty-index-drains-to-end\ntest/dao/space/index_test.cljc:690:(deftest published-open-fetches-only-the-manifest\ntest/dao/space/index_test.cljc:708:(deftest covered-indexes-returns-the-four-covered-sets\ntest/dao/space/index_test.cljc:713:               (let [idx (index/covered-indexes published)]\ntest/dao/space/index_test.cljc:720:               (is (nil? (index/covered-indexes nil)))\ntest/dao/space/index_test.cljc:721:               (is (nil? (index/covered-indexes {})))\ntest/dao/space/index_test.cljc:722:               (is (nil? (index/covered-indexes :not-a-realization)))\ntest/dao/space/index_test.cljc:723:               (is (nil? (index/covered-indexes {:indexes :not-a-map})))\ntest/dao/space/index_test.cljc:724:               (is (nil? (index/covered-indexes {:indexes {:eavt 1, :aevt 2}})))\ntest/dao/space/index_test.cljc:725:               (is (nil? (index/covered-indexes\ntest/dao/space/index_test.cljc:729:                      (index/covered-indexes\ntest/dao/space/index_test.cljc:736:(deftest published-next-yields-the-same-eavt-rows-as-the-eager-walk\ntest/dao/space/index_test.cljc:759:(deftest published-index-is-a-transportable-bounded-stream\ntest/dao/space/query_test.cljc:7:   maps are rejected. `q` opens nothing and closes nothing; it returns a\ntest/dao/space/query_test.cljc:402:(deftest snapshot-never-closes-the-handle\ntest/dao/space/query_test.cljc:594:   closes :opened through query/close-published!, :store through\ntest/dao/space/query_test.cljc:698:         (let [closes (atom 0)\ntest/dao/space/query_test.cljc:701:                                       (swap! closes inc)\ntest/dao/space/query_test.cljc:705:             (is (zero? @closes)\ntest/dao/space/query_test.cljc:715:(deftest close-published-closes-once-and-is-idempotent\ntest/dao/space/query_test.cljc:722:         (let [closes (atom 0)\ntest/dao/space/query_test.cljc:725:                                       (swap! closes inc)\ntest/dao/space/query_test.cljc:728:             (is (= 1 @closes)\ntest/dao/space/query_test.cljc:729:                 \"close-published! closes the store it opened, exactly once\")\ntest/dao/space/query_test.cljc:731:             (is (= 1 @closes)\n","exit_code":0,"status":"completed"}}
