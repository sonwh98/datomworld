{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/transactor.cljc | sed -n '84,246p'; rg -n \\\"ds/open\"'!'\"\\\\s*\\\\{?:dao.stream/type\\\\s+:ringbuffer|:dao.stream/type :ringbuffer\\\" test/dao/space -g '*.clj*'; printf '%s\\\\n' \\\"counts\\\"; rg -o \\\"ds/\\\" test/dao/space/transactor_test.cljc | wc -l; rg -o \\\"ds/\\\" test/dao/space/query_test.cljc | wc -l; rg -o \\\"ds/\\\" test/dao/space/index_test.cljc | wc -l; rg -n \\\"ds/open\"'!\" test/dao/space -g '\"'*.clj*' | wc -l; rg -n \\\"ds/open\"'!.*ringbuffer|:dao.stream/type :ringbuffer\" test/dao/space -g '\"'*.clj*' | wc -l\"","aggregated_output":"    84\t\n    85\t\n    86\t(defn- val->datoms\n    87\t  [val t]\n    88\t  (cond\n    89\t    (map? val) (entity->datoms val t)\n    90\t    (and (vector? val) (<= 3 (count val) 5)) [(pad-datom val t)]\n    91\t    :else\n    92\t    (throw\n    93\t      (ex-info\n    94\t        \"a value must be an entity map or datom vector [e a v] / [e a v nil m]\"\n    95\t        {:val val}))))\n    96\t\n    97\t\n    98\t#_{:clj-kondo/ignore [:unused-binding]}\n    99\t\n   100\t\n   101\t(defn- with-write-lock\n   102\t  \"Serialize timestamp allocation and append on hosts with shared-memory\n   103\t   threads. ClojureScript and ClojureDart calls are synchronous within one\n   104\t   isolate, so the direct call has the same single-writer semantics.\"\n   105\t  [lock f]\n   106\t  #?(:clj (locking lock (f))\n   107\t     :default (f)))\n   108\t\n   109\t\n   110\t(defn- append-packet!\n   111\t  \"Append one atomic transaction record to the local stream. The watermark\n   112\t   advances only after the underlying ds/append! answers {:result :ok}; on\n   113\t   any other result or on a thrown error the wrapper keeps the same t and\n   114\t   the call can be retried. Returns {:result :ok, :t t, :datoms datoms}.\"\n   115\t  [local-stream next-t t datoms context]\n   116\t  (let [record {:dao.space/transaction {:t t, :datoms datoms}}\n   117\t        result (ds/append! local-stream record)]\n   118\t    (when-not (and (map? result) (= :ok (:result result)))\n   119\t      (throw (ex-info (str context \" stream append failed: \" (pr-str result))\n   120\t                      {:result result, :t t, :datoms datoms})))\n   121\t    (swap! next-t inc)\n   122\t    {:result :ok, :t t, :datoms datoms}))\n   123\t\n   124\t\n   125\t(defn- derive-next-t\n   126\t  \"Derive the next transaction time from a flattened retained history: 0 for\n   127\t   an empty history, else 1 + the maximum datom t. A datom t that is not a\n   128\t   non-negative integer is a malformed history and throws — this scan is the\n   129\t   causality boundary of the wrapper.\"\n   130\t  [datoms]\n   131\t  (if (empty? datoms)\n   132\t    0\n   133\t    (let [ts (mapv index/datom-t datoms)]\n   134\t      (when-not (every? #(and (integer? %) (<= 0 %)) ts)\n   135\t        (throw\n   136\t          (ex-info\n   137\t            \"malformed retained history: datom t must be a non-negative integer\"\n   138\t            {:history datoms})))\n   139\t      (inc (reduce max ts)))))\n   140\t\n   141\t\n   142\t(deftype DaoStreamLog\n   143\t  [local-stream intake-pool stream-name next-t state]\n   144\t\n   145\t  ds/IDaoStreamWriter\n   146\t\n   147\t  (append!\n   148\t    [_this val]\n   149\t    (with-write-lock\n   150\t      next-t\n   151\t      (fn []\n   152\t        (when (:closed @state)\n   153\t          (throw (ex-info \"Cannot append to closed stream\"\n   154\t                          {:name stream-name})))\n   155\t        (let [t @next-t\n   156\t              datoms (val->datoms val t)]\n   157\t          (when (empty? datoms)\n   158\t            (throw (ex-info \"append! produced no datoms\" {:val val})))\n   159\t          (append-packet! local-stream next-t t datoms \"append!\")))))\n   160\t\n   161\t\n   162\t  ds/IDaoStreamReader\n   163\t\n   164\t  (next [_this cursor] (ds/next local-stream cursor))\n   165\t\n   166\t\n   167\t  ds/IDaoStreamBound\n   168\t\n   169\t  (close!\n   170\t    [_this]\n   171\t    (with-write-lock next-t\n   172\t      (fn [] (swap! state assoc :closed true) {:woke []})))\n   173\t\n   174\t\n   175\t  (closed? [_this] (:closed @state)))\n   176\t\n   177\t\n   178\t(ds/defopen\n   179\t  :transactor\n   180\t  [descriptor]\n   181\t  (let [{:keys [local-stream intake-pool name]} descriptor\n   182\t        stream-name (or name \"transactor\")]\n   183\t    (when (contains? descriptor :next-t)\n   184\t      (throw\n   185\t        (ex-info\n   186\t          \":transactor derives transaction time from retained history; :next-t is not accepted\"\n   187\t          {:descriptor descriptor})))\n   188\t    (when-not (and (satisfies? ds/IDaoStreamReader local-stream)\n   189\t                   (satisfies? ds/IDaoStreamWriter local-stream))\n   190\t      (throw\n   191\t        (ex-info\n   192\t          \":transactor descriptor requires a :local-stream satisfying IDaoStreamReader and IDaoStreamWriter\"\n   193\t          {:descriptor descriptor})))\n   194\t    (when-not (and (coll? intake-pool) (seq intake-pool))\n   195\t      (throw\n   196\t        (ex-info\n   197\t          \":transactor descriptor requires a non-empty :intake-pool of streams satisfying the dao.stream writer surface\"\n   198\t          {:descriptor descriptor})))\n   199\t    (doseq [intake intake-pool]\n   200\t      (when-not (stream/writer? intake)\n   201\t        (throw\n   202\t          (ex-info\n   203\t            \":transactor :intake-pool members must satisfy IDaoStreamWriter\"\n   204\t            {:intake-pool intake-pool}))))\n   205\t    (let [next-t (derive-next-t (index/snapshot-datoms local-stream))]\n   206\t      (->DaoStreamLog local-stream\n   207\t                      intake-pool\n   208\t                      stream-name\n   209\t                      (atom next-t)\n   210\t                      (atom {:closed false})))))\n   211\t\n   212\t\n   213\t(defn publish!\n   214\t  \"Build and enqueue the covered indexes over the local stream into the\n   215\t   intake pool (dao.space.index/publish-index!), returning its\n   216\t   {:manifest-address ... :manifest ...}. opts are passed through to\n   217\t   publish-index! (e.g. :branching-factor, :select-stream). Publication is\n   218\t   explicit and acknowledges enqueuing only, never observer\n   219\t   materialization.\"\n   220\t  ([log] (publish! log nil))\n   221\t  ([^DaoStreamLog log opts]\n   222\t   (index/publish-index! (.-local-stream log) (.-intake-pool log) opts)))\n   223\t\n   224\t\n   225\t(defn transact!\n   226\t  \"Commits a non-empty collection of entity maps or datom vectors as a\n   227\t  single atomic transaction: every datom shares one allocated t and lands\n   228\t   in one transaction record through exactly one ds/append!, so no partial\n   229\t   prefix is possible. Throws when the stream is closed, the collection is\n   230\t   empty, any item is invalid, or the expansion yields no datoms.\"\n   231\t  [^DaoStreamLog log tx-data]\n   232\t  (when (empty? tx-data)\n   233\t    (throw (ex-info \"transact! requires at least one transaction item\"\n   234\t                    {:tx-data tx-data})))\n   235\t  (let [next-t (.-next-t log)]\n   236\t    (with-write-lock\n   237\t      next-t\n   238\t      (fn []\n   239\t        (when (ds/closed? log)\n   240\t          (throw (ex-info \"Cannot transact! to closed stream\"\n   241\t                          {:name (.-stream-name log)})))\n   242\t        (let [t @next-t\n   243\t              datoms (into [] (mapcat #(val->datoms % t)) tx-data)]\n   244\t          (when (empty? datoms)\n   245\t            (throw (ex-info \"transact! produced no datoms\" {:tx-data tx-data})))\n   246\t          (append-packet! (.-local-stream log) next-t t datoms \"transact!\"))))))\ntest/dao/space/schema_test.cljc:304:  (let [s (ds/open!