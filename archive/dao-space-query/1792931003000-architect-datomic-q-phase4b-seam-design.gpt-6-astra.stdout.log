exes manifest))))))\n341:(defn restored-indexes\n343:   published manifest (`{:indexes {...} :count n :branching-factor n}`).\n348:   The manifest's :count and :branching-factor are threaded through\n351:   restored node so mutation splits at the published thresholds. A manifest\n354:  [content-store manifest]\n355:  (let [{:keys [indexes count branching-factor]} manifest\n365:;; The published read coordinate\n368:(defn published-index\n370:   manifest. `content-store` is a serializable DaoJing coordinate, not a live\n371:   handle. The manifest address is the exact bound; opening the coordinate is\n372:   the reader's move — dao.space.query's open-published! re-attaches the\n375:  [content-store manifest-address]\n377:    (throw (ex-info \"published index requires a DaoJing store coordinate\"\n379:  (when-not (jing/segment-address? manifest-address)\n380:    (throw (ex-info \"published index requires a manifest content address\"\n381:                    {:manifest-address manifest-address})))\n382:  {:dao.stream/type :dao.space.index/published,\n383:   :dao.stream/bound {:manifest-address manifest-address},\n386:   :manifest-address manifest-address})\n389:(defn covered-indexes\n575:      manifest, all to exactly the intake stream selected from the pool.\n576:   4. Returns {:manifest-address (jing/segment-key manifest) :manifest\n577:      manifest}.\n579:   The manifest address is derived from the manifest alone and never depends\n581:   intake stream is acceptable and retry-safe: the manifest is always\n619:         manifest {:indexes {:eavt (root-addr (:eavt trees)),\n630:     (append-ok! intake manifest)\n631:     {:manifest-address (jing/segment-key manifest), :manifest manifest})))\n648:;;                                                          manifest\n662:;;               :manifest nil | m}                   ; the last publication's manifest\n837:     :publish {:intake intake, :staged nil, :manifest nil},\n1089:   (manifest-last still holds, so a partial prefix is never a publication),\n1104:  \"Append staged payloads from :next until the intake accepts the manifest,\n1116:        ;; :next reached the end: the manifest has been accepted, which is\n1148:   payloads are those recorded blobs in store order with the manifest last.\n1172:        manifest {:indexes {:eavt (root-addr (:eavt trees)),\n1183:                       manifest)]\n1187:          (assoc-in [:publish :manifest] manifest)))))\n1217:   open-published! builds — four covered trees plus the EAVT rows deferred\n1219:   restored manifest, and recognized by dao.space.query through the same\n1226:  {:dao.space.query/published {:dao.space.index/live true},\n1284:   pr-str/read-string; a live session does not), carrying the manifest\n1295:        manifest (get-in consumer [:publish :manifest])]\n1296:    (when-not manifest\n1299:    {:manifest-address (jing/segment-key manifest),\n1313:   nothing about durability), that the candidate's manifest reads back valid\n1318:   manifest, a missing leaf, or a read failure all answer nil, the check may\n1323:    (let [manifest (read-manifest content-store (:manifest-address candidate))\n1326:                                                       manifest)})\n1334:      (doseq [root (vals (:indexes manifest))]\n1347:   manifest from the durable store and throws on absence). Refuses — throws\n1354:   never the query read path (restored-indexes), whose storage takes the\n1364:     {:content-store h   durable jing handle the manifest and blobs read from\n1373:  (when-not (and (map? candidate) (jing/segment-address? (:manifest-address candidate)))\n1374:    (throw (ex-info \"restore takes a checkpoint candidate carrying a manifest address\"\n1390:  (let [manifest (read-manifest content-store (:manifest-address candidate))\n1391:        branching (:branching-factor manifest)\n1397:                       (bt/restore-tree cmp address durable (:count manifest)))\n1399:    {:indexes {:eavt (restore-tree eavt-cmp (get-in manifest [:indexes :eavt])),\n1400:               :aevt (restore-tree aevt-cmp (get-in manifest [:indexes :aevt])),\n1401:               :avet (restore-tree avet-cmp (get-in manifest [:indexes :avet])),\n1402:               :vaet (restore-tree vaet-cmp (get-in manifest [:indexes :vaet]))},\n1413:     :publish {:intake intake, :staged nil, :manifest nil},\n;; Published indexes: open-published! / close-published! (Decision 1)\n;; =============================================================================\n\n(defn published-db\n  \"A query value over the manifest at `manifest-address` in `store`, a\n   live `dao.jing` handle the caller owns: the covered sets restored\n   lazily (`index/restored-indexes`), the EAVT rows deferred.  The value\n   owns nothing, so `close-published!` closes nothing; `open-published!`\n   is this over a store it opens from a coordinate.\"\n  [store manifest-address]\n  (let [manifest (index/read-manifest store manifest-address)]\n    {:dao.space.query/published {:manifest-address manifest-address}\n     :indexes (index/restored-indexes store manifest)\n     :rows (delay (index/read-datoms store manifest-address))}))\n\n\n(defn open-published!\n  \"Open a published covered-index coordinate — the serializable map\n   `index/published-index` builds — as a query value the caller owns: the\n   content-store handle it opens is closed by `close-published!`, never by\n   a query. `opts` reaches `dao.jing.coordinate/open!` as-is: a remote\n   content-store coordinate opens through the composition's\n   :dao.jing/attach entry, which a coordinate never carries, being data.\n   Nothing is fetched beyond the manifest; the row vector stays\n   deferred behind :rows and the covered sets behind restored B-trees, so a\n   `current` view with no as-of can answer selective clauses without a\n   full drain.\"\n  ([coordinate] (open-published! coordinate nil))\n  ([coordinate opts]\n   (when-not (and (map? coordinate)\n                  (= :dao.space.index/published\n                     (:dao.stream/type coordinate)))\n     (throw (ex-info \"open-published! takes a published-index coordinate\"\n                     {:coordinate coordinate})))\n   (let [{:keys [content-store manifest-address]} coordinate\n         expected (index/published-index content-store manifest-address)]\n     (when-not (= expected coordinate)\n       (throw (ex-info \"invalid published-index coordinate\"\n                       {:coordinate coordinate, :expected expected})))\n     (let [store (jing-coordinate/open! content-store opts)]\n       (try\n         (let [{:keys [indexes rows]} (published-db store manifest-address)]\n           {:dao.space.query/published coordinate\n            :indexes indexes\n            :rows rows\n            :store store\n            :close-guard (atom false)})\n         (catch #?(:cljd Object\n                   :clj Throwable\n                   :cljs :default)\n                error\n           (jing/close! store)\n           (throw error)))))))\n\n\n(defn close-published!\n  \"Close the content-store handle an opened published index owns. A second\n\n\n(defn- same-slot?\n  \"True while a range scan is still inside the slot value's index range:\n   compare-vals ties, not host =. The index orders by value, so 1 and 1.0\n   (or 1.0M and 1.00M) tie and interleave by the later slots; a scan that\n   stopped at the first kind-distinct row would miss the rows after it.\n   Kind-strict matching is the caller's filter, applied after the scan.\"\n  [expected actual]\n  (zero? (index/compare-vals expected actual)))\n\n\n(defn- range-scannable?\n  \"True for a bound slot value whose index range is exactly its kind-loose\n   equals: the scalar buckets of dao.space.index/compare-vals. A collection\n   or other value orders by host compare with a string fallback, which need\n   not agree with content= (a vector holding 1 and one holding the big\n   integer 1 are content= but print differently), so its matches are found\n   by scanning the other slots' range instead.\"\n  [x]\n  (or (nil? x) (boolean? x) (cbor/numeric? x) (string? x) (keyword? x) (symbol? x)))\n\n\n(defn- slot-pred\n  \"The kind-strict filter of a datom against the bound slots of a pattern.\"\n  [e a v]\n  (fn [d]\n    (and (or (wildcard? e) (cbor/content= e (index/datom-e d)))\n         (or (wildcard? a) (cbor/content= a (index/datom-a d)))\n         (or (wildcard? v) (cbor/content= v (index/datom-v d))))))\n\n\n(defn- index-candidates\n  \"The raw candidate datoms of an index range for the bound scalar slots,\n   unfiltered and lazy: the index range of the bound slots is scanned by\n   index order (numerically equal values of different kinds included); the\n   kind-strict filter is the caller's, applied per candidate.\"\n  [idx e a v]\n  (let [e? (and (not (wildcard? e)) (range-scannable? e))\n        a? (and (not (wildcard? a)) (range-scannable? a))\n        v? (and (not (wildcard? v)) (range-scannable? v))]\n    (cond e?\n          (take-while #(same-slot? e (index/datom-e %))\n                      (index/subseq-from (:eavt idx)\n                                         index/eavt-cmp\n                                         [e nil nil nil nil]))\n          (and a? v?)\n          (take-while #(and (same-slot? a (index/datom-a %))\n                            (same-slot? v (index/datom-v %)))\n                      (index/subseq-from (:avet idx)\n                                         index/avet-cmp\n                                         [nil a v nil nil]))\n          v?\n          (take-while #(same-slot? v (index/datom-v %))\n                      (index/subseq-from (:vaet idx)\n                                         index/vaet-cmp\n                                         [nil nil v nil nil]))\n          a?\n          (take-while #(same-slot? a (index/datom-a %))\n                      (index/subseq-from (:aevt idx)\n                                         index/aevt-cmp\n                                         [nil a nil nil nil]))\n          :else (seq (:eavt idx)))))\n\n\n(defn- select-by-index\n  \"The current-state datoms whose bound slots are content= the pattern's.\n   The index range of the bound scalar slots is scanned by index order\n   (numerically equal values of different kinds included), then every bound\n   slot is matched kind-strictly.\"\n  [idx e a v]\n  (current-state-seq (filter (slot-pred e a v) (index-candidates idx e a v))))\n\n\n(defn- datoms-st\n  \"The checked select: [state datoms]. Each candidate the range scan\n   yields is one accountable unit of op, charged before it is examined and\n   pulled one at a time; the state is observed again before the collected\n   candidates are interpreted. The current-state resolution over the\n   charged candidates is one indivisible host operation. Query-controlled\n   traversal of a lazy published tree is NOT checkpointed per node fetch\n   here; bounded calls never reach it (Phase 4b).\"\n  [st ctx idx e a v op]\n  (let [pred (slot-pred e a v)]\n    (loop [st st\n           xs (seq (index-candidates idx e a v))\n           kept []]\n      (cond\n        (exec/terminal? st) [st nil]\n        (nil? xs) (let [st (observe-st st ctx)]\n                    (if (exec/terminal? st)\n                      [st nil]\n                      [st (vec (current-state-seq kept))]))\n        :else (let [st (spend st ctx op)]\n                (if (exec/terminal? st)\n                  [st nil]\n                  (let [d (first xs)]\n                    (recur st (next xs) (if (pred d) (conj kept d) kept)))))))))\n\n\n(defn datoms\n","exit_code":0,"status":"completed"}}
