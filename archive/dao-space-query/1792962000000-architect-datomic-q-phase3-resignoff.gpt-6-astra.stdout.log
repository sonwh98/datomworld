fn ^:private c-make-parents \"jolt_file_make_parents\"\n  [:pointer :int64] :int64 :blocking)\n(ffi/defcfn ^:private c-open \"jolt_file_open\" [:pointer :int64] :int64 :blocking)\n(ffi/defcfn ^:private c-length \"jolt_file_length\" [:int64] :int64 :blocking)\n(ffi/defcfn ^:private c-pread \"jolt_file_pread\"\n  [:int64 :int64 :pointer :int64 :int64] :int64 :blocking)\n(ffi/defcfn ^:private c-pwrite \"jolt_file_pwrite\"\n  [:int64 :int64 :pointer :int64 :int64] :int64 :blocking)\n(ffi/defcfn ^:private c-truncate \"jolt_file_truncate\" [:int64 :int64] :int64 :blocking)\n(ffi/defcfn ^:private c-sync \"jolt_file_sync\" [:int64] :int64 :blocking)\n(ffi/defcfn ^:private c-close \"jolt_file_close\" [:int64] :int64 :blocking)\n(ffi/defcfn ^:private c-s32be-get \"jolt_file_s32be_get\" [:pointer :int64] :int32)\n(ffi/defcfn ^:private c-s32be-put \"jolt_file_s32be_put\" [:pointer :int64 :int32] :void)\n(ffi/defcfn ^:private c-strerror \"jolt_file_strerror\" [:int64 :pointer :int64] :int64)\n;; J4b (layout 2)\n(ffi/defcfn ^:private c-classify \"jolt_file_classify\"\n  [:pointer :int64 :int32] :int64 :blocking)\n(ffi/defcfn ^:private c-fclassify \"jolt_file_fclassify\" [:int64] :int64 :blocking)\n(ffi/defcfn ^:private c-fidentity \"jolt_file_fidentity\" [:int64 :pointer] :int64 :blocking)\nantlr4-runtime\nantlr4-runtime-build\nblake3\nblake3-build\nbuild-record.edn\njolt-crypto\njolt-crypto-build\njolt-parser\njolt-parser-build\njolt-parser-release\njolt-parser-release-build\ncollab/1792962000000-architect-datomic-q-phase3-signoff.gemini-4-argon.findings.md:66:2. **P2 (Gate Blocker) | [jolt_j2_lane.clj:253-274](file:///Users/sto/workspace/datomworld/src/dev/jolt_j2_lane.clj#L253-L274) | `dao.space.query-rules-test` is unlisted in the Jolt J2 manifest (D2)**\ncollab/1792962000000-architect-datomic-q-phase3-signoff.gemini-4-argon.findings.md:67:   - **Evidence**: Branch `datomic-q-p3-ci` adds portable [query_rules_test.cljc](file:///Users/sto/workspace/datomworld/.claude/worktrees