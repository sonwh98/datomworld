{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '560,592p' src/cljc/dao/space/query/datomic.cljc; rg -n ':jolt|:test|extra-paths|main-opts' deps.edn | head -40; ls build/tools/jolt-env.sh /Users/sto/workspace/datomworld/build/tools/jolt-env.sh; git rev-parse HEAD; sed -n '1,75p' src/dev/jolt_test_runner.clj\"","aggregated_output":"   fault or source failure keeps its cause.\"\n  [e]\n  (let [data (ex-data e)\n        category (:cognitect.anomalies/category data)]\n    (cond\n      (::error data) (throw e)\n      category (fail :source-failed \"source read failed\"\n                     {:cognitect.anomalies/category category} e)\n      (:dao.space.query/source-failure data)\n      ;; a traversal or read failure of a checked published source: the\n      ;; original (cursor validation error, missing or corrupt segment) is\n      ;; the cause; no address, descriptor or handle is copied\n      (fail :source-failed \"source read failed\" {} (or (ex-cause e) e))\n      (= :recursion-through-negation (:reason data))\n      (fail :unsupported \"recursion through negation is not supported\"\n            {:reason :recursion-through-negation})\n      (= :checked-source-fallback (:reason data))\n      (fail :unsupported \"this clause needs an eager fallback a checked source does not offer\"\n            {:reason :checked-source-fallback})\n      (some? data)\n      (let [msg (or (ex-message e) \"query refused\")]\n        (if (str/includes? msg \"not implemented\")\n          (fail :unsupported msg {})\n          (fail :invalid-request msg {})))\n      :else (fail :evaluation-failed \"query evaluation failed\" {} e))))\n\n\n(defn- exhausted!\n  \"Translate a terminal execution outcome into the structured exception. A\n   partial relation is never returned.\"\n  [st]\n  (let [{:keys [kind phase steps]} (exec/outcome st)]\n    (if (= :timeout kind)\n25: :aliases {:clean {:extra-paths [\"src/dev\"]\n27:           :profile-btree {:extra-paths [\"src/dev\"]\n30:                           :main-opts [\"-m\" \"btree-bench\"]}\n31:           :test {:extra-paths [\"test\"]\n34:                  :main-opts [\"-m\" \"cognitect.test-runner\"]\n36:           :nREPL {:extra-paths [\"test\"]\n39:                   :main-opts [\"-m\" \"nrepl.cmdline\" \"--middleware\" \"[cider.nrepl/cider-middleware]\"]}\n40:           :cljs {:extra-paths [\"test\" \"src/dev\" \"build/antlr/python3/js\"]\n44:           :dev {:extra-paths [\"src/dev\"]\n61:           :cljd {:extra-paths [\"test\"]\n62:                  :main-opts [\"-m\" \"cljd.build\"]\n66:                    :main-opts [\"-m\" \"world.server\"]}\n67:           :clj-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n69:           ;; §4.2-4.3), run through build/tools/jolt/bin/jolt -Srepro -M:jolt.\n72:           ;; are selected away by :jolt reader branches, never loaded). No\n76:           :jolt {:replace-paths [\"src/jolt\" \"src/cljc\" \"src/clj\"]\n78:           :jolt-yin-repl {:main-opts [\"-m\" \"yin.repl.main\"]}\n79:           ;; composed after :jolt (-M:jolt:jolt-test): the oracle tests and\n81:           :jolt-test {:extra-paths [\"test\" \"src/dev\"]}\n82:           ;; DIAGNOSTIC only (-M:jolt:jolt-diag:jolt-test): a jolt stand-in\n85:           ;; jolt puts :extra-paths roots first, in alias order (-Spath)\n86:           :jolt-diag {:extra-paths [\"src/dev/jolt_diag\"]}\n88:           {:extra-paths [\"test\" \"src/dev\"]\n92:            :main-opts [\"-m\" \"yin.repl.node-runner\"]}\n93:           :fmt {:extra-paths [\"src/dev\"]\n97:           :antlr-gen {:extra-paths [\"src/dev\"]\n99:                       :main-opts [\"-m\" \"yang-antlr-gen\"]}\n101:                   :main-opts [\"-m\" \"clj-kondo.main\"]}\n105:           :oracle {:extra-paths [\"src/dev\" \"test\"]\n107:           :dbg {:extra-paths [\"test\"]\n108:                 :main-opts [\"-m\" \"debug-cljd\"]\n110:           :cljd-yin-repl {:main-opts [\"-m\" \"yin.repl.runner\"]}\n112:           {:main-opts  [\"-m\" \"cljd.build\"]\n117:           :dep-graph {:extra-paths [\"src/dev\"]\n119:                       :main-opts [\"-m\" \"dep-graph\"]}}}\n127:;; clj -M:test\n128:;; clj -M:test -n yin.vm-literal-test\n129:;; clj -M:test -n yin.vm-continuation-test\n130:;; clj -M:test -n yin.repl.python-antlr-test\n131:;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\nls: build/tools/jolt-env.sh: No such file or directory\n/Users/sto/workspace/datomworld/build/tools/jolt-env.sh\n5dbe4c5f0b9b50aba0e4eafbd984a2d8eeedf337\n;; The jolt test runner (yin.repl-jolt-implementation.md §11; J1), run UNDER\n;; jolt:\n;;\n;;   . build/tools/jolt-env.sh\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj NS...\n;;   \"$JOLT_HOME/bin/jolt\" -Srepro -M:jolt:jolt-test src/dev/jolt_test_runner.clj --self-test\n;;\n;; How it finds the tests: it does not scan. The namespaces are the explicit\n;; command-line list (bb test:jolt-host passes the four dao.host oracle\n;; namespaces), and each is loaded by `require` through jolt's own source-root\n;; search, which the aliases set: :jolt replaces the paths with src/jolt,\n;; src/cljc, src/clj (src/jolt first, so a host override there wins) and\n;; :jolt-test adds test (the oracle) and src/dev (this runner and its\n;; sentinel). jolt resolves :extra-paths roots BEFORE the :replace-paths\n;; ones (`jolt -Srepro -Spath -A:jolt:jolt-test`: test, src/dev, src/jolt,\n;; src/cljc, src/clj); neither test nor src/dev holds a dao/host source, so\n;; the override order is unaffected. Fixture files the tests read\n;; (test/resources/...) are relative to the working directory, the\n;; repository root.\n;;\n;; Per namespace: a load failure is counted and reported, and the run goes on.\n;; Per test var, in source order: each runs through clojure.test/test-var,\n;; which reports an escaping throw as an :error, inside a second guard of this\n;; runner's own, so a throwing test never aborts the batch. Totals are tests,\n;; assertions (pass + fail + error), failures, errors and load failures; the\n;; exit status is nonzero when any of the last three is.\n;;\n;; --self-test runs the sentinel namespace jolt-runner-sentinel (a passing\n;; test, a test that throws, then a passing test) and exits 0 only when the\n;; runner counted exactly that: 3 tests, 1 error, and the test after the\n;; throwing one ran.\n(ns jolt-test-runner\n  (:require\n    [clojure.test :as t]))\n\n\n(defn- tally\n  []\n  (select-keys @t/counters [:test :pass :fail :error]))\n\n\n(defn- delta\n  [before after]\n  (merge-with - after before))\n\n\n(defn- test-vars-of\n  \"The test vars of namespace `ns-sym` in source order.\"\n  [ns-sym]\n  (->> (vals (ns-interns ns-sym))\n       (filter #(:test (meta %)))\n       (sort-by #(or (:line (meta %)) 0))))\n\n\n(defn- run-ns\n  \"Run namespace `ns-sym`; answers {:ns :load-error :counts :tests}.\"\n  [ns-sym]\n  (let [loaded (try\n                 (require ns-sym)\n                 nil\n                 (catch Throwable e e))]\n    (if loaded\n      {:ns ns-sym :load-error (str (ex-message loaded)) :counts {} :tests []}\n      (let [before (tally)\n            per-test (mapv (fn [v]\n                             (let [b (tally)]\n                               (try\n                                 (t/test-vars [v])\n                                 (catch Throwable e\n                                   ;; test-var already guards; this is the\n                                   ;; runner's own floor\n                                   (t/do-report {:type :error\n                                                 :message \"escaped test-vars\"\n                                                 :expected nil :actual e})))\n                               [(:name (meta v)) (delta b (tally))]))\n","exit_code":0,"status":"completed"}}
