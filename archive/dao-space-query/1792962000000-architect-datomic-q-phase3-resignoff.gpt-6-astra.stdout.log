{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/query.cljc | sed -n '1930,2135p;2530,2605p;2690,2735p'; sed -n '1,190p' test/dao/space/query_rules_test.cljc\"","aggregated_output":"  1930\t  [st ctx clause binding acc k]\n  1931\t  (let [join-vars (nth clause 1)\n  1932\t        branches (drop 2 clause)\n  1933\t        seed (into (select-keys binding [::dbs '%])\n  1934\t                   (keep (fn [v]\n  1935\t                           (let [v' (get binding v FREE)]\n  1936\t                             (when (not= v' FREE) [v v']))))\n  1937\t                   join-vars)\n  1938\t        augment (fn [branch-result]\n  1939\t                  (reduce (fn [acc k] (unify acc k (get branch-result k FREE)))\n  1940\t                          binding\n  1941\t                          join-vars))]\n  1942\t    (run-dedup st acc k\n  1943\t               (fn [st sa dk]\n  1944\t                 (each-st st sa branches\n  1945\t                          (fn [st sa branch]\n  1946\t                            (eval-where* st ctx (branch-clauses branch) [seed] sa\n  1947\t                                         (fn [st sa res]\n  1948\t                                           (if-let [b' (augment res)]\n  1949\t                                             (dk st sa b')\n  1950\t                                             [st sa])))))))))\n  1951\t\n  1952\t\n  1953\t(defn- rule-head\n  1954\t  \"Parse a rule head `(name args...)`. Datomic's required-bound form\n  1955\t   `(name [?a ?b] ?c)` declares in ONE leading vector the variables a call\n  1956\t   must already have bound; the call itself is flat: `(name 1 2 ?c)`.\n  1957\t   Returns {:vars (all head variables, required first) :required n}.\"\n  1958\t  [head]\n  1959\t  (let [args (vec (rest head))\n  1960\t        req (when (and (seq args) (vector? (first args))) (first args))\n  1961\t        others (if req (subvec args 1) args)]\n  1962\t    (when (or (some vector? others)\n  1963\t              (not (every? symbol? req)))\n  1964\t      (throw (ex-info \"malformed rule head: required-bound variables are one leading vector of symbols\"\n  1965\t                      {:head head})))\n  1966\t    {:vars (vec (concat req others)), :required (count req)}))\n  1967\t\n  1968\t\n  1969\t(defn- note-hit\n  1970\t  \"Record, in the threaded state, that a repeated call read the table of\n  1971\t   call-key (the recursion signal the leader's fixed point waits on).\"\n  1972\t  [st call-key]\n  1973\t  (if (exec/terminal? st) st (update st ::hits (fnil conj #{}) call-key)))\n  1974\t\n  1975\t\n  1976\t(defn- clear-hit\n  1977\t  [st call-key]\n  1978\t  (if (exec/terminal? st) st (update st ::hits (fnil disj #{}) call-key)))\n  1979\t\n  1980\t\n  1981\t(defn- hit?\n  1982\t  [st call-key]\n  1983\t  (contains? (::hits st #{}) call-key))\n  1984\t\n  1985\t\n  1986\t(defn- unify-call\n  1987\t  \"The caller's binding extended by unifying each call argument with the\n  1988\t   matching value of a head tuple, or nil.\"\n  1989\t  [binding call-args tuple]\n  1990\t  (reduce (fn [b [arg v]] (and-then b #(unify % arg v)))\n  1991\t          binding\n  1992\t          (map vector call-args tuple)))\n  1993\t\n  1994\t\n  1995\t(defn- read-table\n  1996\t  \"A repeated call (its key is being evaluated further up this path) reads\n  1997\t   the tuples tabled so far, one accounted candidate each, and records the\n  1998\t   hit. Complete answers arrive because the leader re-runs until nothing new\n  1999\t   appears.\"\n  2000\t  [st ctx table binding call-args call-key acc k]\n  2001\t  (each-st (note-hit st call-key) acc (:tuples table)\n  2002\t           (fn [st acc tuple]\n  2003\t             (let [st (spend st ctx :candidate)]\n  2004\t               (if (exec/terminal? st)\n  2005\t                 [st acc]\n  2006\t                 (if-let [b' (unify-call binding call-args tuple)]\n  2007\t                   (k st acc b')\n  2008\t                   [st acc]))))))\n  2009\t\n  2010\t\n  2011\t(defn- rule-iteration\n  2012\t  \"One pass over every definition of the rule, with the tuples tabled so far\n  2013\t   visible to repeated calls. Each NEW head tuple (content-distinct across\n  2014\t   all passes) is handed to k at once; a2 is {:seen :new :acc}.\"\n  2015\t  [st ctx table defs rule-name call-args arg-vals binding call-key a2 k]\n  2016\t  (let [body-ctx (assoc ctx ::tables (assoc (::tables ctx {}) call-key table))]\n  2017\t    (each-st\n  2018\t      st a2 defs\n  2019\t      (fn [st a2 [head & body]]\n  2020\t        (let [{:keys [vars required]} (rule-head head)]\n  2021\t          (when (not= (count vars) (count arg-vals))\n  2022\t            (throw (ex-info \"Rule invoked with wrong arity\"\n  2023\t                            {:rule rule-name, :head head, :args (vec call-args)})))\n  2024\t          (doseq [i (range required)]\n  2025\t            (when (= FREE (nth arg-vals i))\n  2026\t              (throw (ex-info \"Rule required-bound variable is not bound at the call\"\n  2027\t                              {:rule rule-name, :var (nth vars i)}))))\n  2028\t          (let [seed (reduce (fn [b [hv av]]\n  2029\t                               (if (= FREE av) b (and-then b #(unify % hv av))))\n  2030\t                             (select-keys binding [::dbs '%])\n  2031\t                             (map vector vars arg-vals))]\n  2032\t            (if-not seed\n  2033\t              [st a2]\n  2034\t              (eval-where*\n  2035\t                st body-ctx (vec body) [seed] a2\n  2036\t                (fn [st a2 res]\n  2037\t                  (let [tuple (mapv (fn [hv]\n  2038\t                                      (let [v (get res hv FREE)]\n  2039\t                                        (when (= FREE v)\n  2040\t                                          (throw (ex-info \"Rule head var not bound by rule body\"\n  2041\t                                                          {:rule rule-name, :var hv})))\n  2042\t                                        v))\n  2043\t                                    vars)\n  2044\t                        tk (binding-key tuple)]\n  2045\t                    (if (contains? (:seen a2) tk)\n  2046\t                      [st a2]\n  2047\t                      (let [a2' (-> a2 (update :seen conj tk) (update :new conj tuple))]\n  2048\t                        (if-let [b' (unify-call binding call-args tuple)]\n  2049\t                          (bind (bounce (fn [] (k st (:acc a2') b')))\n  2050\t                                (fn [[st acc']]\n  2051\t                                  (if (reduced? acc')\n  2052\t                                    [st (reduced (assoc a2' :acc @acc'))]\n  2053\t                                    [st (assoc a2' :acc acc')])))\n  2054\t                          [st a2'])))))))))))))\n  2055\t\n  2056\t\n  2057\t(defn- rule-fixpoint\n  2058\t  \"Evaluate a call whose key is not being evaluated above it: the LEADER of\n  2059\t   its own (possibly recursive) call. Naive fixed point over immutable\n  2060\t   tables: pass i sees the tuples of passes < i; another pass runs only when\n  2061\t   this pass both found new tuples AND a repeated call actually read this\n  2062\t   key's table (so non-recursive and right-recursive-over-new-keys rules cost\n  2063\t   one pass, exactly as before). The least fixed point is reached when a\n  2064\t   pass finds nothing new; the work budget is the backstop when fresh values\n  2065\t   keep generating new tuples. A pass's progress is the state it returns.\"\n  2066\t  [st ctx binding rule-name call-args arg-vals call-key defs acc k]\n  2067\t  (let [;; a nested leader of the SAME key (k runs mid-pass) must hand the\n  2068\t        ;; outer leader's marker back on exit, not erase or leak its own\n  2069\t        was-hit? (hit? st call-key)\n  2070\t        restore (fn [st]\n  2071\t                  (if was-hit? (note-hit st call-key) (clear-hit st call-key)))\n  2072\t        run (fn run [st table acc]\n  2073\t              (let [st (clear-hit st call-key)\n  2074\t                    a2 {:seen (:seen table), :new [], :acc acc}]\n  2075\t                (bind (bounce (fn []\n  2076\t                                (rule-iteration st ctx table defs rule-name call-args\n  2077\t                                                arg-vals binding call-key a2 k)))\n  2078\t                      (fn [[st a2]]\n  2079\t                        (let [stopped? (reduced? a2)\n  2080\t                              a2 (unreduced a2)\n  2081\t                              acc' (:acc a2)]\n  2082\t                          (cond\n  2083\t                            stopped? [(restore st) (reduced acc')]\n  2084\t                            (exec/terminal? st) [st acc']\n  2085\t                            (and (seq (:new a2)) (hit? st call-key))\n  2086\t                            (run st {:tuples (into (:tuples table) (:new a2)), :seen (:seen a2)} acc')\n  2087\t                            :else [(restore st) acc']))))))]\n  2088\t    (run st {:tuples [], :seen #{}} acc)))\n  2089\t\n  2090\t\n  2091\t(defn- emit-rule\n  2092\t  [st ctx clause binding acc k]\n  2093\t  (let [[rule-name & call-args] clause\n  2094\t        rules (get binding '%)]\n  2095\t    (when-not rules\n  2096\t      (throw (ex-info \"No rules bound; pass a rule set via :in $ %\"\n  2097\t                      {:clause clause})))\n  2098\t    (let [defs (filter #(= rule-name (first (first %))) rules)]\n  2099\t      (when (empty? defs)\n  2100\t        (throw (ex-info \"Unknown rule\"\n  2101\t                        {:rule rule-name,\n  2102\t                         :known (vec (distinct (map ffirst rules)))})))\n  2103\t      (let [st (spend st ctx :rule-entry)]\n  2104\t        (if (exec/terminal? st)\n  2105\t          [st acc]\n  2106\t          (let [arg-vals (mapv #(resolve-binding binding %) call-args)\n  2107\t                ;; keyed by content, so a call on 1.00M is not taken for a\n  2108\t                ;; repeat of the call on 1.0M\n  2109\t                call-key [rule-name (binding-key arg-vals)]\n  2110\t                table (get (::tables ctx) call-key)]\n  2111\t            (if table\n  2112\t              (read-table st ctx table binding call-args call-key acc k)\n  2113\t              (rule-fixpoint st ctx binding rule-name call-args arg-vals call-key\n  2114\t                             defs acc k))))))))\n  2115\t\n  2116\t\n  2117\t(defn- emit-clause\n  2118\t  [st ctx clause binding acc k]\n  2119\t  (cond (and (seq? clause) (= 'or (first clause))) (emit-or st ctx clause binding acc k)\n  2120\t        (and (seq? clause) (= 'or-join (first clause)))\n  2121\t        (emit-or-join st ctx clause binding acc k)\n  2122\t        (and (seq? clause) (= 'and (first clause)))\n  2123\t        (eval-where* st ctx (rest clause) [binding] acc k)\n  2124\t        (and (seq? clause) (= 'not (first clause)))\n  2125\t        (emit-not st ctx clause binding acc k)\n  2126\t        (and (seq? clause) (= 'not-join (first clause)))\n  2127\t        (emit-not-join st ctx clause binding acc k)\n  2128\t        (seq? clause) (emit-rule st ctx clause binding acc k)\n  2129\t        (and (vector? clause) (seq? (first clause)))\n  2130\t        (emit-fn st ctx clause binding acc k)\n  2131\t        :else (emit-pattern st ctx clause binding acc k)))\n  2132\t\n  2133\t\n  2134\t(defn- estimate-clause-cost\n  2135\t  [clause binding]\n  2530\t  \"[name negated?] pairs of the rule calls inside clauses; negated? is true\n  2531\t   inside not / not-join at any depth.\"\n  2532\t  [clauses negated?]\n  2533\t  (mapcat\n  2534\t    (fn [clause]\n  2535\t      (if-not (seq? clause)\n  2536\t        nil\n  2537\t        (let [h (first clause)]\n  2538\t          (cond\n  2539\t            (= 'not h) (collect-rule-calls (rest clause) true)\n  2540\t            (= 'not-join h) (collect-rule-calls (drop 2 clause) true)\n  2541\t            (= 'and h) (collect-rule-calls (rest clause) negated?)\n  2542\t            (= 'or h) (mapcat #(collect-rule-calls (branch-clauses %) negated?) (rest clause))\n  2543\t            (= 'or-join h) (mapcat #(collect-rule-calls (branch-clauses %) negated?)\n  2544\t                                   (drop 2 clause))\n  2545\t            (symbol? h) [[h negated?]]\n  2546\t            :else nil))))\n  2547\t    clauses))\n  2548\t\n  2549\t\n  2550\t(defn- check-rules-stratified!\n  2551\t  \"Refuse, before any evaluation, recursion THROUGH negation: a rule that\n  2552\t   calls (inside not / not-join) a rule from which it is reachable, itself\n  2553\t   included. Positive recursion is evaluated to its least fixed point;\n  2554\t   negation inside a cycle has no such meaning here and is refused.\"\n  2555\t  [rules]\n  2556\t  (when (sequential? rules)\n  2557\t    (doseq [rule rules]\n  2558\t      (when-not (and (sequential? rule)\n  2559\t                     (sequential? (first rule))\n  2560\t                     (symbol? (ffirst rule)))\n  2561\t        (throw (ex-info \"malformed rule head: a rule is [(name args...) body...]\"\n  2562\t                        {:head (when (sequential? rule) (first rule))\n  2563\t                         :rule rule}))))\n  2564\t    (let [named rules\n  2565\t          calls (reduce (fn [m rule]\n  2566\t                          (update m (first (first rule)) (fnil into [])\n  2567\t                                  (collect-rule-calls (rest rule) false)))\n  2568\t                        {}\n  2569\t                        named)\n  2570\t          reach (fn [start]\n  2571\t                  (loop [seen #{start}\n  2572\t                         frontier [start]]\n  2573\t                    (if (empty? frontier)\n  2574\t                      seen\n  2575\t                      (let [nxt (->> frontier\n  2576\t                                     (mapcat #(map first (get calls %)))\n  2577\t                                     (remove seen)\n  2578\t                                     distinct)]\n  2579\t                        (recur (into seen nxt) (vec nxt))))))]\n  2580\t      (doseq [[rule-name edges] calls\n  2581\t              [callee negated?] edges\n  2582\t              :when negated?]\n  2583\t        (when (contains? (reach callee) rule-name)\n  2584\t          (throw (ex-info (str \"recursion through negation is not supported: rule \"\n  2585\t                               rule-name \" reaches itself through a negated call to \"\n  2586\t                               callee)\n  2587\t                          {:reason :recursion-through-negation\n  2588\t                           :rule rule-name\n  2589\t                           :through callee})))))))\n  2590\t\n  2591\t\n  2592\t(defn- project-element-st\n  2593\t  [st ctx element b]\n  2594\t  (if (:pull-var element)\n  2595\t    (let [eid (get b (:pull-var element))\n  2596\t          idx (resolve-fact-index b '$)]\n  2597\t      (when-not idx\n  2598\t        (throw (ex-info \"pull find element requires a bound $ source\"\n  2599\t                        {:element element})))\n  2600\t      (pull-idx st ctx idx eid (:pull-pattern element)))\n  2601\t    [st (get b (:var element))]))\n  2602\t\n  2603\t\n  2604\t(defn- project-row-st\n  2605\t  [st ctx elements b]\n  2690\t   and returns [state result]. The result is the same local result value `q`\n  2691\t   returns; it is meaningful only while the returned state is live, and is\n  2692\t   nil once the state is terminal (a terminal return exposes no partial\n  2693\t   result). Names no Client option. Opens nothing, closes nothing.\"\n  2694\t  [st driver query & inputs]\n  2695\t  (let [ctx {::driver driver}\n  2696\t        st (enter-st st ctx :parse)\n  2697\t        {:keys [find in with where keys syms strs]} (normalize-query query)\n  2698\t        in-patterns (or in '[$])\n  2699\t        _ (check-declared-symbols in-patterns find)\n  2700\t        _ (check-find-vars-bound! in-patterns find with where)\n  2701\t        extra-count (- (count inputs) (count in-patterns))\n  2702\t        _ (when (> extra-count 1)\n  2703\t            (throw (ex-info \"query input arity permits at most one options map\"\n  2704\t                            {:expected (count in-patterns),\n  2705\t                             :actual (count inputs)})))\n  2706\t        [bind-inputs opts] (if (= extra-count 1)\n  2707\t                             [(take (count in-patterns) inputs) (last inputs)]\n  2708\t                             [inputs nil])\n  2709\t        _ (when (and opts (not (map? opts)))\n  2710\t            (throw (ex-info \"query options must be a map\" {:options opts})))\n  2711\t        _ (when (not= (count in-patterns) (count bind-inputs))\n  2712\t            (throw (ex-info \"query input arity must match :in\"\n  2713\t                            {:expected (count in-patterns),\n  2714\t                             :actual (count bind-inputs)})))\n  2715\t        _ (doseq [[p v] (map vector in-patterns bind-inputs)]\n  2716\t            (when (= '% p) (check-rules-stratified! v)))\n  2717\t        ctx (assoc ctx\n  2718\t                   :fns (if (false? (:builtins opts))\n  2719\t                          (or (:fns opts) {})\n  2720\t                          (merge builtins (:fns opts))))\n  2721\t        st (spend-n st ctx :parse-step\n  2722\t                    (+ 1 (count find) (count in-patterns) (count with) (count where)))]\n  2723\t    (if (exec/terminal? st)\n  2724\t      [st nil]\n  2725\t      (let [st (enter-st st ctx :realize)\n  2726\t            [st dbs] (if (exec/terminal? st)\n  2727\t                       [st nil]\n  2728\t                       (reduce\n  2729\t                         (fn [[st dbs] [pat val]]\n  2730\t                           (if (or (exec/terminal? st)\n  2731\t                                   (not= :db (classify-in-pattern pat)))\n  2732\t                             [st dbs]\n  2733\t                             (let [[st realized] (realize-st st ctx val)]\n  2734\t                               [st (assoc dbs pat\n  2735\t                                          (select-keys realized [::relation ::fact-index]))])))\n(ns dao.space.query-rules-test\n  \"Phase 3 rules and semantic conformance for dao.space.query\n   (docs/design/dao.space.query.datomic-compat.md, supported domain: required-\n   bound rule heads and finite positive recursive rules).\n\n   Semantics under test:\n   - Positive recursion is evaluated to its LEAST FIXED POINT. A call whose\n     key (rule + argument content) is being evaluated further up the path\n     reads the tuples tabled so far and records the hit; its leader re-runs\n     the pass until a pass finds nothing new. Left, right and mutual\n     recursion, cycles, several definitions and a fully unbound entry call\n     are complete. The active-call guard of earlier phases was not a\n     completeness proof (left recursion lost answers).\n   - Required-bound heads `(r [?x] ?y)`: the leading vector names variables\n     the call must already have bound; the call is flat `(r 2 ?y)`. An unbound\n     required argument is an error naming the variable.\n   - Recursion THROUGH negation is refused before any evaluation.\n   - The Phase 4 work budget is the termination backstop for fresh-value\n     recursion: a bounded call exhausts structurally, never hangs.\n   - Kernel contract: [state result] threading, first-witness demand for\n     negation, no dynamic vars. Every expectation is derived from an\n     independent oracle (a plain breadth-first closure), not from the\n     evaluator under test.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.space.query :as query]\n            [dao.space.query.datomic :as dq]\n            [dao.space.query.execution :as exec]))\n\n\n(def ^:private edges\n  \"A graph with a cycle (1 -> 2 -> 3 -> 1), a branch (3 -> 4) and a separate\n   component (5 -> 6).\"\n  [[1 2] [2 3] [3 1] [3 4] [5 6]])\n\n\n(defn- graph [] (query/fact-relation (mapv (fn [[a b]] [a :e b]) edges)))\n\n\n(defn- qq\n  [form & inputs]\n  (query/collect (apply query/q form inputs)))\n\n\n(defn- refusal\n  [f]\n  (try (f)\n       nil\n       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n         (or (ex-message e) (str e)))))\n\n\n(defn- refused-with?\n  \"True when f throws and its message matches pattern (a boolean helper: see\n   dao.space.query-aggregates-test on why no call sits inside an assertion\n   form wrapped in `str`).\"\n  [f pattern]\n  (let [m (refusal f)]\n    (boolean (and m (re-find pattern m)))))\n\n\n;; ---------------------------------------------------------------------------\n;; The independent oracle\n;; ---------------------------------------------------------------------------\n\n(defn- successors [n] (map second (filter #(= n (first %)) edges)))\n\n\n(defn- closure\n  \"Set of [a b]: b reachable from a by one or more edges.\"\n  []\n  (set (for [a (distinct (map first edges))\n             b (loop [seen #{} frontier (successors a)]\n                 (let [fresh (remove seen frontier)]\n                   (if (empty? fresh)\n                     seen\n                     (recur (into seen fresh) (mapcat successors fresh)))))]\n         [a b])))\n\n\n(defn- parity-closure\n  \"Set of [a b]: b reachable from a by a path whose length has `parity`\n   (:odd / :even), length >= 1.\"\n  [parity]\n  (let [want (if (= parity :odd) 1 0)]\n    (set (for [a (distinct (map first edges))\n               [b p] (loop [seen #{} frontier (map (fn [n] [n 1]) (successors a))]\n                       (let [fresh (remove seen frontier)]\n                         (if (empty? fresh)\n                           seen\n                           (recur (into seen fresh)\n                                  (mapcat (fn [[n p]] (map (fn [m] [m (- 1 p)]) (successors n)))\n                                          fresh)))))\n               :when (= p want)]\n           [a b]))))\n\n\n;; ---------------------------------------------------------------------------\n;; Rule sets\n;; ---------------------------------------------------------------------------\n\n(def ^:private right-rules\n  '[[(path ?a ?b) [?a :e ?b]]\n    [(path ?a ?b) [?a :e ?m] (path ?m ?b)]])\n\n\n(def ^:private left-rules\n  '[[(path ?a ?b) [?a :e ?b]]\n    [(path ?a ?b) (path ?a ?m) [?m :e ?b]]])\n\n\n(def ^:private both-rules\n  '[[(path ?a ?b) [?a :e ?b]]\n    [(path ?a ?b) (path ?a ?m) (path ?m ?b)]])\n\n\n(def ^:private mutual-rules\n  '[[(odd ?a ?b) [?a :e ?b]]\n    [(odd ?a ?b) [?a :e ?m] (even ?m ?b)]\n    [(even ?a ?b) [?a :e ?m] (odd ?m ?b)]])\n\n\n;; ---------------------------------------------------------------------------\n;; Completeness: left, right, both-sided and mutual recursion, cycles\n;; ---------------------------------------------------------------------------\n\n(deftest every-recursion-shape-reaches-the-least-fixed-point\n  (let [from-1 (set (map (fn [[_ b]] [b]) (filter #(= 1 (first %)) (closure))))]\n    (is (= #{[2] [3] [1] [4]} from-1) \"the oracle: the cycle makes 1 reach itself\")\n    (doseq [[label rules] {\"right\" right-rules \"left\" left-rules \"both-sided\" both-rules}]\n      (testing label\n        (is (= from-1 (qq '[:find ?x :in $ % :where (path 1 ?x)] (graph) rules)))))))\n\n\n(deftest an-unbound-entry-call-enumerates-the-whole-relation\n  (doseq [[label rules] {\"right\" right-rules \"left\" left-rules \"both-sided\" both-rules}]\n    (is (= (closure) (qq '[:find ?a ?b :in $ % :where (path ?a ?b)] (graph) rules)) label)))\n\n\n(deftest a-bound-second-argument-and-both-bound-calls\n  (let [rules left-rules]\n    (is (= (set (map (fn [[a _]] [a]) (filter #(= 4 (second %)) (closure))))\n           (qq '[:find ?a :in $ % :where (path ?a 4)] (graph) rules)))\n    (is (= #{[true]} (qq '[:find ?ok :in $ % :where (path 1 4) [(ground true) ?ok]]\n                         (graph) rules)))\n    (is (= #{} (qq '[:find ?ok :in $ % :where (path 4 1) [(ground true) ?ok]]\n                   (graph) rules)))))\n\n\n(deftest mutual-recursion\n  (doseq [[name parity] [['odd :odd] ['even :even]]]\n    (is (= (parity-closure parity)\n           (qq [:find '?a '?b :in '$ '% :where (list name '?a '?b)] (graph) mutual-rules))\n        (str name))))\n\n\n(deftest multiple-definitions-union-their-answers\n  (let [rules '[[(near ?a ?b) [?a :e ?b]]\n                [(near ?a ?b) [?b :e ?a]]]]\n    (is (= (set (concat (map (fn [[a b]] [a b]) edges) (map (fn [[a b]] [b a]) edges)))\n           (qq '[:find ?a ?b :in $ % :where (near ?a ?b)] (graph) rules)))))\n\n\n(deftest a-rule-used-twice-in-one-query-is-independent-per-call\n  (let [q '[:find ?x ?y :in $ % :where (path 1 ?x) (path 5 ?y)]\n        expect (set (for [[x] #{[2] [3] [1] [4]} [y] #{[6]}] [x y]))]\n    (is (= expect (qq q (graph) left-rules)))))\n\n\n(deftest recursion-through-the-clauses-of-a-larger-body\n  (let [rules '[[(reaches-leaf ?a ?l) [?a :e ?l] (not-join [?l] [?l :e _])]\n                [(reaches-leaf ?a ?l) [?a :e ?m] (reaches-leaf ?m ?l)]]]\n    ;; leaves (no out-edge): 4 and 6\n    (is (= #{[1 4] [2 4] [3 4] [5 6]}\n           (qq '[:find ?a ?l :in $ % :where (reaches-leaf ?a ?l)] (graph) rules)))))\n\n\n;; ---------------------------------------------------------------------------\n;; Required-bound heads\n;; ---------------------------------------------------------------------------\n\n(def ^:private friend-facts\n  [[1 :f 2] [3 :f 2] [4 :f 5] [1 :g 9] [3 :g 8]])\n\n\n(defn- friends [] (query/fact-relation friend-facts))\n\n\n(deftest required-bound-heads-take-their-arguments-from-the-call\n  (let [rules '[[(fan [?x] ?e) [?e :f ?x]]]]\n    (testing \"a constant argument\"\n","exit_code":0,"status":"completed"}}
