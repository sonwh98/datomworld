{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl.cljc | sed -n '550,635p;915,1045p;1280,1340p;1430,1460p'\"","aggregated_output":"   550\t     :observer (:observer program-in)\n   551\t     :expander (make-expander (:identity program-in) (:stream program-out))\n   552\t     :row-stream (:stream program-out)\n   553\t     :row-observer (:observer program-out)\n   554\t     :link-pair pair}))\n   555\t\n   556\t\n   557\t(defn- checked-link-policy\n   558\t  \"Validate the `:link-policy` creation option, failing closed at\n   559\t   assembly (yin.repl.link-policy.md section 3): `:manual` is the\n   560\t   default and today's behavior, a function `(fn [view])` is the\n   561\t   embedder's rule, and `:lease` is reserved for the phase-2 deadline --\n   562\t   refused, not implemented yet.  Anything else is refused with the\n   563\t   supported values named.\"\n   564\t  [policy]\n   565\t  (cond\n   566\t    (or (nil? policy) (= :manual policy)) :manual\n   567\t    (fn? policy) policy\n   568\t    :else\n   569\t    (throw\n   570\t      (ex-info\n   571\t        (if (= :lease policy)\n   572\t          \"Yin REPL :link-policy :lease is not implemented yet\"\n   573\t          \"Unknown Yin REPL :link-policy\")\n   574\t        {:link-policy policy\n   575\t         :supported [:manual :fn]}))))\n   576\t\n   577\t\n   578\t(defn create-state\n   579\t  \"Create the shell value.  `:primitives` is a host-supplied map merged over\n   580\t   the REPL primitives; it is kept as `:extra-primitives` so every session\n   581\t   rebuild — `(reset)`, `(vm …)` — installs it again.\n   582\t\n   583\t   `content-store` (a `dao.jing` byte-store handle), `content-client` (a\n   584\t   `dao.stream.rpc` client state on a connection whose far end serves\n   585\t   content) and `name-env` (module name -> manifest address) compose the\n   586\t   content pair and the name environment the linker interpreter serves\n   587\t   `(require ...)` from (yin.repl.link/composition); with neither content\n   588\t   source, a require stays `:pending` and says so.\n   589\t\n   590\t   `:link-policy` is the session's pending-link rule\n   591\t   (yin.repl.link-policy.md), kept beside `:link-source` so `(reset)` and\n   592\t   `(vm ...)` preserve it: `:manual`, the default, ends a pending run\n   593\t   only at `(abandon)`; a function `(fn [view])` is consulted when a\n   594\t   require parks and after each re-check that leaves the run pending,\n   595\t   answering `:keep`, `:abandon` or `{:abandon reason}`; `:lease` is\n   596\t   reserved for phase 2 and refused, as is anything else, at assembly.\"\n   597\t  ([] (create-state {}))\n   598\t  ([{:keys [lang output-cursor output-stream vm-type primitives\n   599\t            content-store content-client name-env link-policy]\n   600\t     :or {lang :clojure vm-type :semantic}}]\n   601\t   (let [output-stream (or output-stream (make-output-medium!))\n   602\t         output-cursor (or output-cursor (mint-cursor output-stream))\n   603\t         link-source (link/composition\n   604\t                       {:name-env name-env\n   605\t                        :content-store content-store\n   606\t                        :content-client content-client})]\n   607\t     (merge\n   608\t       (make-session vm-type output-stream primitives)\n   609\t       {:lang lang\n   610\t        :vm-type vm-type\n   611\t        :extra-primitives primitives\n   612\t        :output-stream output-stream\n   613\t        :output-cursor output-cursor\n   614\t        :ledger {:output :untried}\n   615\t        :shell-token (str (random-uuid))\n   616\t        :round 0\n   617\t        :ingress-loss? false\n   618\t        :last-value nil\n   619\t        :last-value-2 nil\n   620\t        :last-value-3 nil\n   621\t        :pending-input nil\n   622\t        :link-source link-source\n   623\t        :link-policy (checked-link-policy link-policy)\n   624\t        :pending-run nil\n   625\t        :running? true}))))\n   626\t\n   627\t\n   628\t;; =============================================================================\n   629\t;; Reading and classifying input\n   630\t;; =============================================================================\n   631\t\n   632\t(defn- read-forms\n   633\t  [input]\n   634\t  #?(:cljd (edn/read-string (str \"[\" input \"]\"))\n   635\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n   915\t(defn- dropped-lines-text\n   916\t  [n]\n   917\t  (when (pos? n)\n   918\t    (str \";; dropped \" n \" line\" (when (> n 1) \"s\")\n   919\t         \" typed while the require was pending\\n\")))\n   920\t\n   921\t\n   922\t(def ^:private policy-abandon-text\n   923\t  \"The message a policy-driven abandon prints, in the shape of the\n   924\t   `(abandon)` notice, so a policy abandon is never mistaken for a\n   925\t   user's (yin.repl.link-policy.md section 3.3).\"\n   926\t  \";; the session link policy ended the require\\n\")\n   927\t\n   928\t\n   929\t(defn- abandon-pending\n   930\t  \"Give up the shell's `:pending-run` (section 7.2, step 7, the abandoned\n   931\t   case): every install in flight is dropped through the engine's own\n   932\t   `refused`, every link wait entry is retired with the reason raised as\n   933\t   the require's error, and the shell returns to the round the require\n   934\t   began in, whose store and value history the parked evaluation never\n   935\t   wrote.  Lines typed while the require was pending are dropped with\n   936\t   it, and said so.  The linker side learns nothing: no response was\n   937\t   ever promised, and one that still arrives is skipped as late.  The\n   938\t   identity the parked evaluation minted -- link ids and child origins\n   939\t   -- is carried onto the base, so nothing is minted twice on the\n   940\t   surviving pair.  The `(abandon)` command retires with\n   941\t   `:yin.repl/abandoned` and no message of its own; the session link\n   942\t   policy retires with the reason it answered and prints\n   943\t   `policy-abandon-text`, so a policy abandon is never mistaken for a\n   944\t   user's.\"\n   945\t  ([state] (abandon-pending state :yin.repl/abandoned nil))\n   946\t  ([state reason ended-text]\n   947\t   (if-let [parked (:pending-run state)]\n   948\t     (let [[state' text] (drain-output state)\n   949\t           ;; installs first: their waiters leave the wait set with the\n   950\t           ;; refusal queued, then every remaining link entry retires\n   951\t           vm (engine/abandon-installs (:vm parked) reason)\n   952\t           error (try\n   953\t                   (vm/run (reduce (fn [vm e]\n   954\t                                     (engine/abandon-link vm (:link-id e)\n   955\t                                                          reason))\n   956\t                                   vm\n   957\t                                   (:wait-set vm)))\n   958\t                   nil\n   959\t                   (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   960\t                     e))]\n   961\t       [(assoc state'\n   962\t               :vm (carry-link-identity (:base parked) vm)\n   963\t               :pending-run nil)\n   964\t        (str text\n   965\t             ended-text\n   966\t             (if error (format-error error) \"\")\n   967\t             (dropped-lines-text (count (:pending-lines parked))))])\n   968\t     [state \"Nothing is pending\"])))\n   969\t\n   970\t\n   971\t(defn- consult-link-policy\n   972\t  \"Consult the shell's `:link-policy` over a run that is still pending --\n   973\t   when the require parks, and after each re-check that leaves it so;\n   974\t   never on a re-check that completes it (yin.repl.link-policy.md\n   975\t   section 3.2).  `text` is what the round printed so far and\n   976\t   `kept-text` what a kept run reports.  `:manual` is never consulted\n   977\t   and keeps the run; a function's `:keep` keeps it; `:abandon` or\n   978\t   `{:abandon reason}` runs the same abandon path as `(abandon)`, the\n   979\t   reason defaulting to `:yin.repl/link-policy`; a throw or a return\n   980\t   outside the contract is a `:keep` for this consult plus one shell\n   981\t   error line -- never a silent abandon, never session death (section\n   982\t   3.4).  The view the function receives is plain data, no clock, no\n   983\t   handle, no secret (section 3.1).  Returns `[state text]`.\"\n   984\t  [state text kept-text]\n   985\t  (if-not (fn? (:link-policy state))\n   986\t    [state (str text kept-text)]\n   987\t    (let [parked (:pending-run state)\n   988\t          answer (try\n   989\t                   {:answer ((:link-policy state)\n   990\t                             {:links (mapv (fn [p]\n   991\t                                             {:name (:name p)\n   992\t                                              :link-id (:yin.link/id p)})\n   993\t                                           (:links parked))\n   994\t                              :checks (or (:checks parked) 0)\n   995\t                              :lines-retained\n   996\t                              (count (:pending-lines parked))})}\n   997\t                   (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   998\t                     {:thrown e}))]\n   999\t      (cond\n  1000\t        (:thrown answer)\n  1001\t        [state (str text kept-text (format-error (:thrown answer)) \"\\n\")]\n  1002\t\n  1003\t        (= :keep (:answer answer))\n  1004\t        [state (str text kept-text)]\n  1005\t\n  1006\t        (= :abandon (:answer answer))\n  1007\t        (let [[state' text'] (abandon-pending state :yin.repl/link-policy\n  1008\t                                              policy-abandon-text)]\n  1009\t          [state' (str text text')])\n  1010\t\n  1011\t        (and (map? (:answer answer))\n  1012\t             (= #{:abandon} (set (keys (:answer answer)))))\n  1013\t        (let [reason (or (:abandon (:answer answer)) :yin.repl/link-policy)\n  1014\t              [state' text'] (abandon-pending state reason\n  1015\t                                              policy-abandon-text)]\n  1016\t          [state' (str text text')])\n  1017\t\n  1018\t        :else\n  1019\t        [state\n  1020\t         (str text\n  1021\t              kept-text\n  1022\t              (format-error\n  1023\t                (ex-info\n  1024\t                  \"Link policy returned a value outside its contract\"\n  1025\t                  {:answer (:answer answer)\n  1026\t                   :contract [:keep :abandon {:abandon :reason}]}))\n  1027\t              \"\\n\")]))))\n  1028\t\n  1029\t\n  1030\t(defn- pending-eval\n  1031\t  \"Answer a round whose require did not complete: the parked VM, its\n  1032\t   round-start base, and the pending links are the shell's\n  1033\t   `:pending-run`, and the prompt returns.  Nothing is wedged: another\n  1034\t   line re-checks the link, the host may step one itself with\n  1035\t   `recheck-pending`, the link policy is consulted as the run parks, and\n  1036\t   `(reset)` or `(vm ...)` drops it with the session.\"\n  1037\t  [state state' vm' pending]\n  1038\t  (let [[state'' text] (drain-output state')]\n  1039\t    (consult-link-policy\n  1040\t      (assoc state''\n  1041\t             :vm vm'\n  1042\t             :pending-run {:vm vm'\n  1043\t                           :base (:vm state)\n  1044\t                           :links pending\n  1045\t                           :checks 0})\n  1280\t   parks the shell on a require of its own stops the fold: the lines\n  1281\t   after it stay retained, in order, on the new `:pending-run`.\"\n  1282\t  [[state text] queued]\n  1283\t  (loop [state state\n  1284\t         text text\n  1285\t         [in & more :as queued] (seq queued)]\n  1286\t    (cond\n  1287\t      (empty? queued) [state text]\n  1288\t      (:pending-run state) [(update-in state [:pending-run :pending-lines]\n  1289\t                                       (fnil into []) queued)\n  1290\t                            text]\n  1291\t      :else (let [[state' text'] (eval-parsed* state\n  1292\t                                               (:trimmed in)\n  1293\t                                               (:parsed in))]\n  1294\t              (recur state' (str text \"\\n\" text') more)))))\n  1295\t\n  1296\t\n  1297\t(defn- recheck-pending*\n  1298\t  \"One bounded re-check of the shell's `:pending-run`: serve the\n  1299\t   interpreter, run the parked VM, and either answer its value -- the\n  1300\t   round the require began in finally completes, and the lines retained\n  1301\t   while it was pending, then `input`, evaluate against it -- consult\n  1302\t   the link policy when the re-check leaves the run pending, `:checks`\n  1303\t   counting this pending run's re-checks that made no progress and\n  1304\t   resetting on one that did, or, when the re-check raised the link's\n  1305\t   refusal, return the shell to the round's base with the error as text\n  1306\t   and evaluate `input` there.  `input` is nil for the host's\n  1307\t   `recheck-pending`, which evaluates no line of its own.\"\n  1308\t  [state input]\n  1309\t  (let [parked (:pending-run state)]\n  1310\t    (try\n  1311\t      (let [[state' vm' pending progress?] (drive-links state (:vm parked))]\n  1312\t        (if (vm/halted? vm')\n  1313\t          (let [vm'' (engine/restore-initial-env (:env (:base parked)) vm')\n  1314\t                [st text] (finalize-eval state\n  1315\t                                         (assoc state' :vm vm'')\n  1316\t                                         (tokenize state' vm''))]\n  1317\t            (fold-queued [(assoc st :vm vm'' :pending-run nil) text]\n  1318\t                         (cond-> (vec (:pending-lines parked))\n  1319\t                           input (conj input))))\n  1320\t          (let [checks (if progress? 0 (inc (or (:checks parked) 0)))\n  1321\t                parked' (cond-> (assoc parked\n  1322\t                                       :vm vm'\n  1323\t                                       :links pending\n  1324\t                                       :checks checks)\n  1325\t                          input (update :pending-lines\n  1326\t                                        (fnil conj []) input))\n  1327\t                [st text] (drain-output (assoc state'\n  1328\t                                               :vm vm'\n  1329\t                                               :pending-run parked'))]\n  1330\t            (consult-link-policy st text (pending-text pending)))))\n  1331\t      (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  1332\t        (let [[st text] (drain-output state)\n  1333\t              d (ex-data error)]\n  1334\t          (fold-queued\n  1335\t            [(assoc st\n  1336\t                    :vm (carry-link-identity\n  1337\t                          (:base parked)\n  1338\t                          {:id-counter (::link-counter d)\n  1339\t                           :origins (::link-origins d)})\n  1340\t                    :pending-run nil)\n  1430\t                 (get-in state [:expander :ctx :store]))\n  1431\t   :vm {:type (:vm-type state)\n  1432\t        :halted? (vm/halted? (:vm state))\n  1433\t        :blocked? (vm/blocked? (:vm state))\n  1434\t        :in-stream {:capacity ingress-capacity\n  1435\t                    :gaps (ingress-gaps state)\n  1436\t                    :lost? (boolean (:ingress-loss? state))}}\n  1437\t   :running? (:running? state)\n  1438\t   :output {:cursor (:output-cursor state)\n  1439\t            :last-outcome (get-in state [:ledger :output] :untried)}\n  1440\t   :pending (when-let [parked (:pending-run state)]\n  1441\t              (let [policy (:link-policy state)]\n  1442\t                (mapv (fn [p]\n  1443\t                        {:name (:name p)\n  1444\t                         :link-id (:yin.link/id p)\n  1445\t                         :policy (if (fn? policy) :fn policy)\n  1446\t                         :checks (or (:checks parked) 0)})\n  1447\t                      (:links parked))))\n  1448\t   :telemetry {:supported? false :note telemetry-text}\n  1449\t   :remote {:connected? false}})\n","exit_code":0,"status":"completed"}}
