{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/repl/require_test.cljc | sed -n '536,665p;680,820p'\"","aggregated_output":"   536\t;; The session link policy (docs/design/yin.repl.link-policy.md, phase 1)\n   537\t;; =============================================================================\n   538\t\n   539\t(defn- refusal-of\n   540\t  \"What `create-state` answers to the `:link-policy` `policy`: the\n   541\t   thrown error when it refuses it (the assembly fails closed), or\n   542\t   `:accepted` when it does not.\"\n   543\t  [policy]\n   544\t  (try\n   545\t    (repl/create-state {:vm-type :stack :link-policy policy})\n   546\t    :accepted\n   547\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   548\t      e)))\n   549\t\n   550\t\n   551\t(deftest link-policy-defaults-to-manual-test\n   552\t  (testing \":manual is the default, and nil passes through to it\"\n   553\t    (is (= :manual (:link-policy (repl/create-state {:vm-type :stack}))))\n   554\t    (is (= :manual (:link-policy\n   555\t                     (repl/create-state {:vm-type :stack\n   556\t                                         :link-policy nil})))))\n   557\t  (let [state (repl/create-state {:vm-type :stack})\n   558\t        [pending text] (repl/eval-input state \"(require (quote mod))\")\n   559\t        [held _] (repl/eval-input pending \"(+ 1 2)\")\n   560\t        [held2 _] (repl/eval-input held \"(+ 3 4)\")\n   561\t        [held3 _] (repl/eval-input held2 \"(+ 5 6)\")]\n   562\t    (testing \"the run parks as today and survives every re-check\"\n   563\t      (is (str/includes? text \"pending\"))\n   564\t      (is (some? (:pending-run held3)))\n   565\t      (is (vm/blocked? (:vm held3))))\n   566\t    (testing \"repl-state names the policy and the no-progress checks\"\n   567\t      (is (= [{:name 'mod :policy :manual :checks 3}]\n   568\t             (mapv #(select-keys % [:name :policy :checks])\n   569\t                   (:pending (repl/repl-state held3))))))))\n   570\t\n   571\t\n   572\t(deftest a-function-policy-abandons-after-n-no-progress-checks-test\n   573\t  (let [views (atom [])\n   574\t        policy (fn [view]\n   575\t                 (swap! views conj view)\n   576\t                 (if (>= (:checks view) 2)\n   577\t                   {:abandon :host-gave-up}\n   578\t                   :keep))\n   579\t        state (repl/create-state {:vm-type :stack :link-policy policy})\n   580\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   581\t        [held _] (repl/eval-input pending \"(+ 1 2)\")\n   582\t        [freed text] (repl/eval-input held \"(+ 3 4)\")]\n   583\t    (testing \"the policy saw the section 3.1 view, plain data only\"\n   584\t      (is (= [0 1 2] (mapv :checks @views)))\n   585\t      (is (= [0 1 2] (mapv :lines-retained @views)))\n   586\t      (is (= ['mod] (mapv :name (:links (first @views)))))\n   587\t      (is (vector? (:link-id (first (:links (first @views)))))))\n   588\t    (testing \"the second no-progress check ended the require\"\n   589\t      (is (nil? (:pending-run freed)))\n   590\t      (is (str/includes? text \"the session link policy ended the require\"))\n   591\t      (is (str/includes? text \"Module link refused: host-gave-up\"))\n   592\t      (is (not (str/includes? text \"require pending\"))\n   593\t          \"a policy abandon is never mistaken for a run still waiting\"))\n   594\t    (testing \"the retained lines dropped once, reported once\"\n   595\t      (is (str/includes? text \"dropped 2 lines\"))\n   596\t      (is (= 1 (count (re-seq #\"dropped\" text)))))\n   597\t    (testing \"the shell returned to the round the require began in\"\n   598\t      (is (>= (or (:id-counter (:vm freed)) 0) 1)\n   599\t          \"the carried id keeps the next require off the retired one\")\n   600\t      (is (= \"3\" (second (repl/eval-input freed \"(+ 1 2)\")))))))\n   601\t\n   602\t\n   603\t(deftest a-keep-policy-never-ends-a-pending-run-test\n   604\t  (let [state (repl/create-state {:vm-type :stack\n   605\t                                  :link-policy (constantly :keep)})\n   606\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   607\t        [held _] (repl/eval-input pending \"(+ 1 2)\")]\n   608\t    (is (some? (:pending-run held)))\n   609\t    (is (= 1 (:checks (:pending-run held))))\n   610\t    (is (= :fn (:policy\n   611\t                 (first (:pending (repl/repl-state held))))))))\n   612\t\n   613\t\n   614\t(deftest a-bare-abandon-uses-the-policy-reason-test\n   615\t  (let [state (repl/create-state {:vm-type :stack\n   616\t                                  :link-policy (constantly :abandon)})\n   617\t        [_ text] (repl/eval-input state \"(require (quote mod))\")]\n   618\t    (is (str/includes? text \"the session link policy ended the require\"))\n   619\t    (is (str/includes? text \"Module link refused: link-policy\"))\n   620\t    (is (not (str/includes? text \"require pending\")))))\n   621\t\n   622\t\n   623\t(deftest a-misbehaving-policy-is-kept-and-reported-test\n   624\t  (let [boom (fn [_] (throw (ex-info \"host policy boom\" {})))\n   625\t        state (repl/create-state {:vm-type :stack :link-policy boom})\n   626\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   627\t    (testing \"a throw is one error line, and the run stands\"\n   628\t      (is (str/includes? text \"Error: host policy boom\"))\n   629\t      (is (str/includes? text \"pending\"))\n   630\t      (is (some? (:pending-run pending)))))\n   631\t  (let [state (repl/create-state {:vm-type :stack\n   632\t                                  :link-policy (constantly :bogus)})\n   633\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   634\t    (testing \"an out-of-contract return is kept and reported too\"\n   635\t      (is (str/includes? text \"outside its contract\"))\n   636\t      (is (some? (:pending-run pending)))))\n   637\t  (let [state (repl/create-state\n   638\t                {:vm-type :stack\n   639\t                 :link-policy (fn [_] {::x :not-part-of-the-contract})})\n   640\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   641\t    (testing \"a map with no :abandon is out of contract, not an abandon\"\n   642\t      (is (str/includes? text \"outside its contract\"))\n   643\t      (is (some? (:pending-run pending)))))\n   644\t  (let [state (repl/create-state\n   645\t                {:vm-type :stack\n   646\t                 :link-policy (fn [_] {:abandon :reason :extra true})})\n   647\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   648\t    (testing \"a map with extra keys beside :abandon is out of contract\"\n   649\t      (is (str/includes? text \"outside its contract\"))\n   650\t      (is (str/includes? text \"outside its contract\"))\n   651\t      (is (some? (:pending-run pending))))))\n   652\t\n   653\t\n   654\t(deftest unknown-and-lease-link-policies-are-refused-at-create-state-test\n   655\t  (doseq [policy [:lease :whenever \"manual\" 42]]\n   656\t    (testing (pr-str policy)\n   657\t      (let [e (refusal-of policy)]\n   658\t        (is (not= :accepted e))\n   659\t        (is (= [:manual :fn] (:supported (ex-data e)))))))\n   660\t  (testing \":lease is refused as not implemented yet\"\n   661\t    (is (str/includes? (ex-message (refusal-of :lease))\n   662\t                       \"not implemented yet\"))))\n   663\t\n   664\t\n   665\t(deftest reset-and-vm-preserve-the-link-policy-test\n   680\t      (is (= 0 (:checks (:pending-run pending'))))\n   681\t      (is (= 1 (:checks (:pending-run held')))))))\n   682\t\n   683\t\n   684\t(deftest a-policy-abandon-matches-abandon-s-retained-line-semantics-test\n   685\t  (let [by-command (let [state (repl/create-state {:vm-type :stack})\n   686\t                         [parked _] (repl/eval-input\n   687\t                                      state \"(require (quote mod))\")\n   688\t                         [held _] (repl/eval-input parked \"(+ 1 2)\")]\n   689\t                     (repl/eval-input held \"(abandon)\"))\n   690\t        by-policy (let [state (repl/create-state\n   691\t                                {:vm-type :stack\n   692\t                                 :link-policy (fn [v]\n   693\t                                                (if (= 1 (:checks v))\n   694\t                                                  :abandon\n   695\t                                                  :keep))})\n   696\t                        [parked _] (repl/eval-input\n   697\t                                     state \"(require (quote mod))\")]\n   698\t                    (repl/eval-input parked \"(+ 1 2)\"))\n   699\t        [command-state command-text] by-command\n   700\t        [policy-state policy-text] by-policy]\n   701\t    (testing \"both drop the retained line once and report it once\"\n   702\t      (is (str/includes? command-text \"dropped 1 line\"))\n   703\t      (is (str/includes? policy-text \"dropped 1 line\"))\n   704\t      (is (= 1 (count (re-seq #\"dropped\" command-text))))\n   705\t      (is (= 1 (count (re-seq #\"dropped\" policy-text)))))\n   706\t    (testing \"only the policy abandon says the session policy ended it\"\n   707\t      (is (not (str/includes? command-text \"session link policy\")))\n   708\t      (is (= 1 (count (re-seq #\"session link policy\" policy-text)))))\n   709\t    (testing \"both carry the minted identity and free the shell\"\n   710\t      (is (nil? (:pending-run command-state)))\n   711\t      (is (nil? (:pending-run policy-state)))\n   712\t      (is (>= (or (:id-counter (:vm command-state)) 0) 1))\n   713\t      (is (>= (or (:id-counter (:vm policy-state)) 0) 1))\n   714\t      (is (= \"3\" (second (repl/eval-input command-state \"(+ 1 2)\"))))\n   715\t      (is (= \"3\" (second (repl/eval-input policy-state \"(+ 1 2)\")))))))\n   716\t\n   717\t\n   718\t(deftest a-late-response-after-a-policy-abandon-is-skipped-test\n   719\t  \"The pair survives the policy abandon as it survives `(abandon)`: the\n   720\t   abandoned round's request, answered late over the same pair by the\n   721\t   source that finally works, is skipped as unknown, and the next\n   722\t   require mints an id of its own (yin.vm.linker.md section 7.2, step\n   723\t   7).\"\n   724\t  (let [store (mem/create-content-mem)\n   725\t        {:keys [address]} (publish-module store closed-module 'mod\n   726\t                                          closed-exports)\n   727\t        as-other (:address (publish-module store closed-module 'other\n   728\t                                           closed-exports))\n   729\t        state (repl/create-state\n   730\t                {:vm-type :stack\n   731\t                 :content-client (silent-client)\n   732\t                 :name-env {'other as-other 'mod address}\n   733\t                 :link-policy (fn [v]\n   734\t                                (if (= 1 (:checks v))\n   735\t                                  :abandon\n   736\t                                  :keep))})\n   737\t        [pending _] (repl/eval-input state \"(require (quote other))\")\n   738\t        [held text] (repl/eval-input pending \"(+ 1 2)\")\n   739\t        working (assoc held\n   740\t                       :link-source\n   741\t                       (link/composition\n   742\t                         {:content-store store\n   743\t                          :name-env {'other as-other 'mod address}}))\n   744\t        [linked _] (repl/eval-input working \"(require (quote mod))\")\n   745\t        [done _] (repl/eval-input linked \"(mod/f)\")]\n   746\t    (testing \"the policy ended the require with the retained line dropped\"\n   747\t      (is (str/includes? text \"the session link policy ended the require\"))\n   748\t      (is (str/includes? text \"dropped 1 line\"))\n   749\t      (is (nil? (:pending-run held))))\n   750\t    (testing \"the late answer was skipped; the later require linked for real\"\n   751\t      (let [ids (mapv :yin.link/id (pair-requests (:link-pair linked)))]\n   752\t        (is (= [{:kind :unknown, :id (first ids), :entry (second ids)}]\n   753\t               (first (engine/take-link-diagnostics (:vm linked)))))\n   754\t        (is (not= (first ids) (second ids))\n   755\t            \"the carried identity kept the later require off the retired id\"))\n   756\t      (is (= 'mod (:last-value linked)))\n   757\t      (is (= 42 (:last-value done))))))\n   758\t\n   759\t\n   760\t(deftest a-completing-re-check-never-consults-the-policy-test\n   761\t  (let [consults (atom 0)\n   762\t        store (mem/create-content-mem)\n   763\t        {:keys [address]} (publish-module store closed-module 'mod\n   764\t                                          closed-exports)\n   765\t        state (repl/create-state\n   766\t                {:vm-type :stack\n   767\t                 :content-client (silent-client)\n   768\t                 :name-env {'mod address}\n   769\t                 :link-policy (fn [_] (swap! consults inc) :keep)})\n   770\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   771\t        [held _] (repl/eval-input pending \"(+ 1 2)\")\n   772\t        working (assoc held\n   773\t                       :link-source\n   774\t                       (link/composition\n   775\t                         {:content-store store\n   776\t                          :name-env {'mod address}}))\n   777\t        [done _] (repl/eval-input working \"(+ 3 4)\")]\n   778\t    (testing \"the run completed and ran the retained line, then the new one\"\n   779\t      (is (= 7 (:last-value done)))\n   780\t      (is (= 3 (:last-value-2 done)))\n   781\t      (is (nil? (:pending-run done))))\n   782\t    (testing \"the park and pending re-check consulted; completion did not\"\n   783\t      (is (= 2 @consults)))))\n   784\t\n   785\t\n   786\t(deftest recheck-pending-steps-a-run-without-an-input-line-test\n   787\t  \"Section 4: the host drivers can only trigger a re-check with a typed\n   788\t   line -- `driver/repl-step` evaluates drained input and nothing else\n   789\t   -- so the shell carries the public step an unattended host drives at\n   790\t   its own cadence.\"\n   791\t  (let [state (repl/create-state {:vm-type :stack\n   792\t                                  :link-policy (constantly :keep)})\n   793\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   794\t        [step1 _] (repl/recheck-pending pending)\n   795\t        [step2 text] (repl/recheck-pending step1)]\n   796\t    (testing \"each step is one no-progress re-check\"\n   797\t      (is (some? (:pending-run step2)))\n   798\t      (is (= 2 (:checks (:pending-run step2))))\n   799\t      (is (str/includes? text \"pending\")))\n   800\t    (let [empty (repl/create-state {:vm-type :stack})\n   801\t          [st text] (repl/recheck-pending empty)]\n   802\t      (testing \"nothing pending: nothing printed, nothing changed\"\n   803\t        (is (nil? text))\n   804\t        (is (nil? (:pending-run st))))))\n   805\t  (let [state (repl/create-state\n   806\t                {:vm-type :stack\n   807\t                 :link-policy (fn [v]\n   808\t                                (if (= 2 (:checks v))\n   809\t                                  :abandon\n   810\t                                  :keep))})\n   811\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   812\t        [step1 _] (repl/recheck-pending pending)\n   813\t        [step2 text] (repl/recheck-pending step1)]\n   814\t    (testing \"an unattended policy abandon ends the run with the message\"\n   815\t      (is (nil? (:pending-run step2)))\n   816\t      (is (str/includes? text \"the session link policy ended the require\"))\n   817\t      (is (str/includes? text \"Module link refused: link-policy\")))))\n","exit_code":0,"status":"completed"}}
