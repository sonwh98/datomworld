                      :link-policy (constantly :bogus)})\n   633\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   634\t    (testing \"an out-of-contract return is kept and reported too\"\n   635\t      (is (str/includes? text \"outside its contract\"))\n   636\t      (is (some? (:pending-run pending)))))\n   637\t  (let [state (repl/create-state\n   638\t                {:vm-type :stack\n   639\t                 :link-policy (fn [_] {::x :not-part-of-the-contract})})\n   640\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   641\t    (testing \"a map with no :abandon is out of contract, not an abandon\"\n   642\t      (is (str/includes? text \"outside its contract\"))\n   643\t      (is (some? (:pending-run pending)))))\n   644\t  (let [state (repl/create-state\n   645\t                {:vm-type :stack\n   646\t                 :link-policy (fn [_] {:abandon :reason :extra true})})\n   647\t        [pending text] (repl/eval-input state \"(require (quote mod))\")]\n   648\t    (testing \"a map with extra keys beside :abandon is out of contract\"\n   649\t      (is (str/includes? text \"outside its contract\"))\n   650\t      (is (str/includes? text \"outside its contract\"))\n   651\t      (is (some? (:pending-run pending))))))\n   652\t\n   653\t\n   654\t(deftest unknown-and-lease-link-policies-are-refused-at-create-state-test\n   655\t  (doseq [policy [:lease :whenever \"manual\" 42]]\n   656\t    (testing (pr-str policy)\n   657\t      (let [e (refusal-of policy)]\n   658\t        (is (not= :accepted e))\n   659\t        (is (= [:manual :fn] (:supported (ex-data e)))))))\n   660\t  (testing \":lease is refused as not implemented yet\"\n   661\t    (is (str/includes? (ex-message (refusal-of :lease))\n   662\t                       \"not implemented yet\"))))\n   663\t\n   664\t\n   665\t(deftest reset-and-vm-preserve-the-link-policy-test\n   666\t  (let [policy (constantly :keep)\n   667\t        state (repl/create-state {:vm-type :stack :link-policy policy})\n   668\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   669\t        [held _] (repl/eval-input pending \"(+ 1 2)\")\n   670\t        [held2 _] (repl/eval-input held \"(+ 3 4)\")\n   671\t        [reset-state _] (repl/eval-input held2 \"(reset)\")\n   672\t        [vm-state _] (repl/eval-input reset-state \"(vm :register)\")\n   673\t        [pending' _] (repl/eval-input vm-state \"(require (quote mod))\")\n   674\t        [held' _] (repl/eval-input pending' \"(+ 1 2)\")]\n   675\t    (testing \"the policy survives (reset) and (vm ...)\"\n   676\t      (is (identical? policy (:link-policy reset-state)))\n   677\t      (is (identical? policy (:link-policy vm-state))))\n   678\t    (testing \"the dropped run's checks went with it; a new park starts at 0\"\n   679\t      (is (nil? (:pending-run reset-state)))\n   680\t      (is (= 0 (:checks (:pending-run pending'))))\n   681\t      (is (= 1 (:checks (:pending-run held')))))))\n   682\t\n   683\t\n   684\t(deftest a-policy-abandon-matches-abandon-s-retained-line-semantics-test\n","exit_code":0,"status":"completed"}}
