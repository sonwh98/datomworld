^:private domain \"yin.module/envelope:v1\\n\")\n+;; A published head trace's prefix (yin.vm.linker.dht.head.md 5.2): domain\n+;; separation, so a name envelope's signature is never a head proof and a\n+;; head proof never a name envelope's.\n+(def ^:private head-domain \"yin.head/trace:v1\\n\")\n (def ^:private private-prefix \"302e020100300506032b657004220420\")\n (def ^:private public-prefix \"302a300506032b6570032100\")\n (def ^:private digits \"0123456789abcdef\")\n@@ -60,8 +65,9 @@\n \n \n (defn- message\n-  [canonical]\n-  (host-bytes (concat (utf8 domain) canonical)))\n+  ([canonical] (message domain canonical))\n+  ([prefix canonical]\n+   (host-bytes (concat (utf8 prefix) canonical))))\n \n \n #?(:cljd nil :clj\n@@ -160,6 +166,32 @@\n    (to-hex (sign-bytes seed (message (jing/canonical-bytes envelope))))})\n \n \n+(defn- verify-message\n+  \"True when `signature` (128 hex) is `public`'s Ed25519 signature of the\n+   host bytes `msg`.\"\n+  [public msg signature]\n+  (let [sig (host-bytes (from-hex signature))]\n+    #?(:cljd (ed/verify (ed/PublicKey. (host-bytes (from-hex public)))\n+                        msg sig)\n+       :clj (let [factory (KeyFactory/getInstance \"Ed25519\" \"SunEC\")\n+                  encoded (host-bytes\n+                            (from-hex (str public-prefix public)))\n+                  pub (.generatePublic factory\n+                                       (X509EncodedKeySpec. encoded))\n+                  verifier (Signature/getInstance \"Ed25519\" \"SunEC\")]\n+              (.initVerify verifier pub)\n+              (.update verifier msg)\n+              (.verify verifier sig))\n+       :cljs (let [crypto (js/require \"crypto\")\n+                   pub (.createPublicKey\n+                         crypto #js {:key (js/Buffer.from\n+                                            (str public-prefix public)\n+                                            \"hex\")\n+                                     :format \"der\" :type \"spki\"})]\n+               (.verify crypto nil (js/Buffer.from msg) pub\n+                        (js/Buffer.from sig))))))\n+\n+\n (defn verify-envelope\n   [public canonical signature]\n   (try\n@@ -167,27 +199,40 @@\n                  (= (principal public)\n                     (:yin.module/asserted-by (cbor/decode canonical))))\n       false\n-      (let [msg (message canonical)\n-            sig (host-bytes (from-hex signature))]\n-        #?(:cljd (ed/verify (ed/PublicKey. (host-bytes (from-hex public)))\n-                            msg sig)\n-           :clj (let [factory (KeyFactory/getInstance \"Ed25519\" \"SunEC\")\n-                      encoded (host-bytes\n-                                (from-hex (str public-prefix public)))\n-                      pub (.generatePublic factory\n-                                           (X509EncodedKeySpec. encoded))\n-                      verifier (Signature/getInstance \"Ed25519\" \"SunEC\")]\n-                  (.initVerify verifier pub)\n-                  (.update verifier msg)\n-                  (.verify verifier sig))\n-           :cljs (let [crypto (js/require \"crypto\")\n-                       pub (.createPublicKey\n-                             crypto #js {:key (js/Buffer.from\n-                                                (str public-prefix public)\n-                                                \"hex\")\n-                                         :format \"der\" :type \"spki\"})]\n-                   (.verify crypto nil (js/Buffer.from msg) pub\n-                            (js/Buffer.from sig))))))\n+      (verify-message public (message canonical) signature))\n+    (catch #?(:cljd Object :clj Exception :cljs :default) _ false)))\n+\n+\n+(defn sign-trace\n+  \"Sign a head trace envelope (yin.vm.linker.dht.head.md 5.2): the\n+   message is `yin.head/trace:v1\\\\n` as UTF-8 followed by the envelope's\n+   canonical bytes.  Answers the proof map.  The key must be the\n+   envelope's own principal.\"\n+  [seed envelope]\n+  #?(:cljs (when-not (exists? js/require)\n+             (throw (ex-info \"Ed25519 signing primitive unavailable\"\n+                             {:reason :yin.link.sign/no-primitive}))))\n+  (when-not (hex? 64 seed)\n+    (throw (ex-info \"Invalid Ed25519 seed\" {:reason :invalid-seed})))\n+  (when-not (= (principal (public-of seed)) (:yin.head/principal envelope))\n+    (throw (ex-info \"Trace principal differs from key\"\n+                    {:reason :principal-mismatch})))\n+  {:yin.head/signature\n+   (to-hex (sign-bytes seed (message head-domain\n+                                     (jing/canonical-bytes envelope))))})\n+\n+\n+(defn verify-trace\n+  \"True when `signature` is `public`'s head proof over the envelope whose\n+   canonical bytes are `canonical`, and that envelope's principal is\n+   `public`'s.  False otherwise; never throws.\"\n+  [public canonical signature]\n+  (try\n+    (if-not (and (hex? 64 public) (hex? 128 signature)\n+                 (= (principal public)\n+                    (:yin.head/principal (cbor/decode canonical))))\n+      false\n+      (verify-message public (message head-domain canonical) signature))\n     (catch #?(:cljd Object :clj Exception :cljs :default) _ false)))\n \n \n     1\t(ns yin.vm.linker.head\n     2\t  \"The published head trace and its rule (docs/design/\n     3\t   yin.vm.linker.dht.head.md, slice H0): a publisher's index HEAD as a\n     4\t   signed trace, and the pure judgement a reader makes of one.\n     5\t\n     6\t   A trace is exactly the closed shape of 5.2:\n     7\t\n     8\t     {:yin.head/envelope {:yin.head/principal \\\"ed25519:<64 hex>\\\"\n     9\t                          :yin.head/manifest  :segment/...\n    10\t                          :yin.head/seq       n}\n    11\t      :yin.head/proof    {:yin.head/signature \\\"<128 hex>\\\"}}\n    12\t\n    13\t   signed over `yin.head/trace:v1\\\\n` and the envelope's canonical bytes\n    14\t   (`yin.vm.linker.sign/sign-trace`).  The sequence is derived, never\n    15\t   stored: the greatest transaction `t` among the datoms of the index the\n    16\t   manifest names (`seq-of`).\n    17\t\n    18\t   Return shapes this namespace chose where the design leaves them open:\n    19\t   - `judge` answers one keyword, the outcome of the 5.5 table:\n    20\t     `:yin.head/malformed`, `:yin.head/wrong-principal`,\n    21\t     `:yin.head/bad-proof`, `:yin.head/stale`, `:yin.head/equivocation`,\n    22\t     `:duplicate` or `:candidate`.  Its `principal` is the followed\n    23\t     principal id, `\\\"ed25519:\\\"` and 64 lowercase hex; `floor` is a\n    24\t     sequence or nil; `installed` is the installed head's manifest\n    25\t     address, or nil.\n    26\t   - A sequence is a nonnegative integer no greater than 2^53 - 1, the\n    27\t     greatest integer every host holds exactly (5.10: the sequence stays\n    28\t     within 2^53); beyond it a trace is `:yin.head/malformed`.\n    29\t   - `trace` throws `ex-info` when the key or the trace it would build is\n    30\t     not well formed; it never answers a malformed trace.\"\n    31\t  (:require [clojure.string :as str]\n    32\t            [dao.jing :as jing]\n    33\t            [dao.space.index :as index]\n    34\t            [yin.vm.linker.sign :as sign]))\n    35\t\n    36\t\n    37\t(def ^:private max-seq\n    38\t  \"2^53 - 1: the greatest integer exact on every host.\"\n    39\t  9007199254740991)\n    40\t\n    41\t\n    42\t(def ^:private hex-digits \"0123456789abcdef\")\n    43\t\n    44\t\n    45\t(defn- hex?\n    46\t  [n s]\n    47\t  (and (string? s)\n    48\t       (= n (count s))\n    49\t       (every? #(some? (str/index-of hex-digits (str %))) s)))\n    50\t\n    51\t\n    52\t(defn- valid-seq?\n    53\t  [n]\n    54\t  (and (integer? n) (<= 0 n max-seq)))\n    55\t\n    56\t\n    57\t(defn- public-of-principal\n    58\t  \"The 64 hex digits of an `ed25519:` principal id, or nil.\"\n    59\t  [principal]\n    60\t  (when (and (string? principal) (str/starts-with? principal \"ed25519:\"))\n    61\t    (let [public (subs principal (count \"ed25519:\"))]\n    62\t      (when (hex? 64 public) public))))\n    63\t\n    64\t\n    65\t(defn- well-formed?\n    66\t  \"The closed shape of 5.2, with a sequence that is a nonnegative\n    67\t   integer.\"\n    68\t  [trace]\n    69\t  (try\n    70\t    (let [envelope (:yin.head/envelope trace)\n    71\t          proof (:yin.head/proof trace)]\n    72\t      (boolean\n    73\t        (and (map? trace)\n    74\t             (= #{:yin.head/envelope :yin.head/proof} (set (keys trace)))\n    75\t             (map? envelope)\n    76\t             (= #{:yin.head/principal :yin.head/manifest :yin.head/seq}\n    77\t                (set (keys envelope)))\n    78\t             (map? proof)\n    79\t             (= #{:yin.head/signature} (set (keys proof)))\n    80\t             (public-of-principal (:yin.head/principal envelope))\n    81\t             (jing/segment-address? (:yin.head/manifest envelope))\n    82\t             (valid-seq? (:yin.head/seq envelope))\n    83\t             (hex? 128 (:yin.head/signature proof)))))\n    84\t    (catch #?(:cljd Object :clj Exception :cljs :default) _ false)))\n    85\t\n    86\t\n    87\t(defn trace\n    88\t  \"Build and sign the trace of `manifest` at sequence `n` under `key`,\n    89\t   `{:seed hex :public hex}`.  The principal is the key's own.\"\n    90\t  [key manifest n]\n    91\t  (let [principal (sign/principal (sign/public-of (:seed key)))\n    92\t        envelope {:yin.head/principal principal\n    93\t                  :yin.head/manifest manifest\n    94\t                  :yin.head/seq n}\n    95\t        built {:yin.head/envelope envelope\n    96\t               :yin.head/proof (sign/sign-trace (:seed key) envelope)}]\n    97\t    (when-not (well-formed? built)\n    98\t      (throw (ex-info \"Malformed head trace\"\n    99\t                      {:reason :yin.head/malformed :envelope envelope})))\n   100\t    built))\n   101\t\n   102\t\n   103\t(defn- proven?\n   104\t  [trace]\n   105\t  (sign/verify-trace (public-of-principal\n   106\t                       (get-in trace [:yin.head/envelope :yin.head/principal]))\n   107\t                     (jing/canonical-bytes (:yin.head/envelope trace))\n   108\t                     (get-in trace [:yin.head/proof :yin.head/signature])))\n   109\t\n   110\t\n   111\t(defn verify\n   112\t  \"True when `trace` has the closed shape of 5.2 and its signature is its\n   113\t   principal's head proof over its envelope; false otherwise.  Never\n   114\t   throws.\"\n   115\t  [trace]\n   116\t  (try\n   117\t    (boolean (and (well-formed? trace) (proven? trace)))\n   118\t    (catch #?(:cljd Object :clj Exception :cljs :default) _ false)))\n   119\t\n   120\t\n   121\t(defn seq-of\n   122\t  \"The greatest transaction `t` among `datoms`; nil for no datoms.\"\n   123\t  [datoms]\n   124\t  (when (seq datoms)\n   125\t    (reduce max (map index/datom-t datoms))))\n   126\t\n   127\t\n   128\t(defn judge\n   129\t  \"The rule of 5.5 for one observed trace: a pure function of the\n   130\t   followed `principal`, the `floor` (the installed head's sequence, or\n   131\t   nil), the `installed` manifest and the `trace`.  It takes no source\n   132\t   and no candidate: its answer is the same whoever carried the trace,\n   133\t   in whatever order, and whatever is loading.\"\n   134\t  [principal floor installed trace]\n   135\t  (let [{:yin.head/keys [manifest] n :yin.head/seq} (:yin.head/envelope trace)]\n   136\t    (cond\n   137\t      (not (well-formed? trace)) :yin.head/malformed\n   138\t      (not= principal (get-in trace [:yin.head/envelope :yin.head/principal]))\n   139\t      :yin.head/wrong-principal\n   140\t      (not (verify trace)) :yin.head/bad-proof\n   141\t      (nil? floor) :candidate\n   142\t      (< n floor) :yin.head/stale\n   143\t      (and (= n floor) (= manifest installed)) :duplicate\n   144\t      (= n floor) :yin.head/equivocation\n   145\t      :else :candidate)))\n     1\t(ns yin.vm.linker.head-test\n     2\t  \"The published head trace and its rule (docs/design/\n     3\t   yin.vm.linker.dht.head.md, slice H0).\"\n     4\t  (:require #?@(:cljd [[\"dart:io\" :as dart-io]])\n     5\t            [clojure.edn :as edn]\n     6\t            [clojure.string :as str]\n     7\t            [clojure.test :refer [deftest is testing]]\n     8\t            [dao.jing :as jing]\n     9\t            [dao.jing.mem :as mem]\n    10\t            [dao.space.index :as index]\n    11\t            [dao.space.transactor :as transactor]\n    12\t            [dao.stream.cbor :as cbor]\n    13\t            [dao.stream.memory-log :as memory-log]\n    14\t            [yin.repl :as repl]\n    15\t            [yin.repl.index :as repl.index]\n    16\t            [yin.repl.store :as store]\n    17\t            [yin.vm.linker.head :as head]\n    18\t            [yin.vm.linker.publish :as publish]\n    19\t            [yin.vm.linker.sign :as sign]))\n    20\t\n    21\t\n    22\t(defn- vectors\n    23\t  []\n    24\t  (edn/read-string\n    25\t    #?(:cljd (.readAsStringSync\n    26\t               (dart-io/File. \"test/yin/vm/linker/sign_vectors.edn\"))\n    27\t       :clj (slurp \"test/yin/vm/linker/sign_vectors.edn\")\n    28\t       :cljs (.readFileSync (js/require \"fs\")\n    29\t                            \"test/yin/vm/linker/sign_vectors.edn\" \"utf8\"))))\n    30\t\n    31\t\n    32\t(defn- hex\n    33\t  [bytes]\n    34\t  (apply str (mapcat (fn [b]\n    35\t                       (let [n (bit-and b 255)\n    36\t                             digits \"0123456789abcdef\"]\n    37\t                         [(nth digits (quot n 16))\n    38\t                          (nth digits (mod n 16))])) bytes)))\n    39\t\n    40\t\n    41\t;; UTF-8 of \"yin.head/trace:v1\\n\" and of \"yin.module/envelope:v1\\n\".\n    42\t(def ^:private head-prefix \"79696e2e686561642f74726163653a76310a\")\n    43\t(def ^:private name-prefix \"79696e2e6d6f64756c652f656e76656c6f70653a76310a\")\n    44\t\n    45\t\n    46\t(defn- key-of\n    47\t  [v i]\n    48\t  (select-keys (get-in v [:rfc i]) [:seed :public]))\n    49\t\n    50\t\n    51\t(defn- vector-trace\n    52\t  [v case-key]\n    53\t  {:yin.head/envelope (get-in v [case-key :envelope])\n    54\t   :yin.head/proof {:yin.head/signature (get-in v [case-key :signature])}})\n    55\t\n    56\t\n    57\t(defn- flip-first-bit\n    58\t  [signature]\n    59\t  (let [digits \"0123456789abcdef\"\n    60\t        n (str/index-of digits (subs signature 0 1))]\n    61\t    (str (nth digits (bit-xor n 1)) (subs signature 1))))\n    62\t\n    63\t\n    64\t;; =============================================================================\n    65\t;; The vectors: RFC 8032 TEST 1's key, byte for byte on every host\n    66\t;; =============================================================================\n    67\t\n    68\t(deftest head-trace-vectors\n    69\t  (let [v (vectors)\n    70\t        key (key-of v 0)]\n    71\t    (doseq [case-key [:head :head-wide]]\n    72\t      (let [{:keys [envelope canonical message signature]} (get v case-key)\n    73\t            {:yin.head/keys [principal manifest] n :yin.head/seq} envelope\n    74\t            built (head/trace key manifest n)]\n    75\t        (testing (str case-key)\n    76\t          (is (= (sign/principal (:public key)) principal))\n    77\t          (is (= canonical (hex (jing/canonical-bytes envelope))))\n    78\t          (is (= message (str head-prefix canonical))\n    79\t              \"the signed message is the head prefix, then the canonical bytes\")\n    80\t          (is (= signature (sign/sign-message (:seed key) message))\n    81\t              \"the primitive is the RFC 8032 Ed25519, unchanged\")\n    82\t          (is (= (vector-trace v case-key) built)\n    83\t              \"trace builds exactly the closed shape of 5.2\")\n    84\t          (is (true? (head/verify built))))))\n    85\t    (is (< 4294967296 (get-in v [:head-wide :envelope :yin.head/seq]))\n    86\t        \"one vector's sequence is above 2^32\")\n    87\t    (is (zero? (get-in v [:head :envelope :yin.head/seq])))))\n    88\t\n    89\t\n    90\t(deftest tampering-fails\n    91\t  (let [v (vectors)\n    92\t        good (vector-trace v :head)\n    93\t        env (:yin.head/envelope good)\n    94\t        sig (get-in good [:yin.head/proof :yin.head/signature])\n    95\t        other-key (key-of v 1)\n    96\t        other-principal (sign/principal (:public other-key))\n    97\t        t (:tamper v)\n    98\t        with-env (fn [e] (assoc good :yin.head/envelope e))\n    99\t        with-sig (fn [s] (assoc good :yin.head/proof {:yin.head/signature s}))]\n   100\t    (is (true? (head/verify good)))\n   101\t    (doseq [[label bad]\n   102\t            [[\"principal\" (with-env (assoc env :yin.head/principal\n   103\t                                           other-principal))]\n   104\t             [\"manifest\" (with-env (assoc env :yin.head/manifest (:manifest t)))]\n   105\t             [\"sequence\" (with-env (assoc env :yin.head/seq 1))]\n   106\t             [\"a flipped signature bit\" (with-sig (flip-first-bit sig))]\n   107\t             [\"another key's signature\"\n   108\t              (with-sig (sign/sign-message (:seed other-key)\n   109\t                                           (get-in v [:head :message])))]\n   110\t             [\"another key's trace under this principal\"\n   111\t              (with-sig (get-in (head/trace other-key\n   112\t                                            (:yin.head/manifest env) 0)\n   113\t                                [:yin.head/proof :yin.head/signature]))]\n   114\t             [\"an extra envelope key\" (with-env (assoc env :yin.head/time 1))]\n   115\t             [\"an extra proof key\"\n   116\t              (assoc-in good [:yin.head/proof :yin.head/key] (:public\n   117\t                                                               (key-of v 0)))]\n   118\t             [\"an extra trace key\" (assoc good :yin.head/via \"x\")]\n   119\t             [\"a name-envelope signature over the same bytes\"\n   120\t              (with-sig (get-in v [:head-tamper :name-domain-signature]))]\n   121\t             [\"a name envelope's own signature\"\n   122\t              (with-sig (get-in v [:assertion :signature]))]\n   123\t             [\"a name envelope and its proof as a trace\"\n   124\t              {:yin.head/envelope (get-in v [:assertion :envelope])\n   125\t               :yin.head/proof {:yin.head/signature\n   126\t                                (get-in v [:assertion :signature])}}]]]\n   127\t      (is (false? (head/verify bad)) label))\n   128\t    (testing \"the name-domain signature is the real one, under the other prefix\"\n   129\t      (is (= (get-in v [:head-tamper :name-domain-signature])\n   130\t             (sign/sign-message (:seed (key-of v 0))\n   131\t                                (str name-prefix\n   132\t                                     (get-in v [:head :canonical]))))))\n   133\t    (testing \"neither proof verifies as the other\"\n   134\t      (is (false? (sign/verify-envelope (:public (key-of v 0))\n   135\t                                        (jing/canonical-bytes env) sig)))\n   136\t      (is (false? (sign/verify-trace\n   137\t                    (:public (key-of v 0))\n   138\t                    (jing/canonical-bytes (get-in v [:assertion :envelope]))\n   139\t                    (get-in v [:assertion :signature]))))\n   140\t      (is (true? (sign/verify-envelope\n   141\t                   (:public (key-of v 0))\n   142\t                   (jing/canonical-bytes (get-in v [:assertion :envelope]))\n   143\t                   (get-in v [:assertion :signature])))\n   144\t          \"name-envelope signing is unchanged\"))\n   145\t    (testing \"verify never throws\"\n   146\t      (doseq [x [nil 42 \"trace\" [] {} {:yin.head/envelope nil}\n   147\t                 (with-sig \"zz\")\n   148\t                 (with-env (assoc env :yin.head/principal \"ed25519:zz\"))]]\n   149\t        (is (false? (head/verify x)))))))\n   150\t\n   151\t\n   152\t(deftest a-trace-through-the-stream-cbor-codec-verifies\n   153\t  (let [v (vectors)]\n   154\t    (doseq [case-key [:head :head-wide]]\n   155\t      (let [trace (vector-trace v case-key)\n   156\t            decoded (cbor/decode (cbor/encode trace))]\n   157\t        (is (= trace decoded) (str case-key))\n   158\t        (is (= (get-in v [case-key :canonical])\n   159\t               (hex (jing/canonical-bytes (:yin.head/envelope decoded)))))\n   160\t        (is (true? (head/verify decoded)) (str case-key))))))\n   161\t\n   162\t\n   163\t;; =============================================================================\n   164\t;; judge: every row of 5.5\n   165\t;; =============================================================================\n   166\t\n   167\t(deftest judge-produces-every-row\n   168\t  (let [v (vectors)\n   169\t        key (key-of v 0)\n   170\t        p (sign/principal (:public key))\n   171\t        m1 (get-in v [:head :envelope :yin.head/manifest])\n   172\t        m2 (get-in v [:tamper :manifest])\n   173\t        at (fn [n m] (head/trace key m n))\n   174\t        five (at 5 m1)]\n   175\t    (testing \"malformed: not the closed shape, or a bad sequence\"\n   176\t      (doseq [bad [nil \"trace\" {}\n   177\t                   (dissoc five :yin.head/proof)\n   178\t                   (assoc five :yin.head/via \"x\")\n   179\t                   (assoc-in five [:yin.head/envelope :yin.head/time] 1)\n   180\t                   (assoc-in five [:yin.head/proof :yin.head/extra] 1)\n   181\t                   (assoc-in five [:yin.head/envelope :yin.head/seq] -1)\n   182\t                   (assoc-in five [:yin.head/envelope :yin.head/seq] 0.5)\n   183\t                   (assoc-in five [:yin.head/envelope :yin.head/seq] \"5\")\n   184\t                   (assoc-in five [:yin.head/envelope :yin.head/seq] nil)\n   185\t                   (assoc-in five [:yin.head/envelope :yin.head/manifest] \"m\")\n   186\t                   (assoc-in five [:yin.head/envelope :yin.head/principal]\n   187\t                             (:public key))\n   188\t                   (assoc-in five [:yin.head/proof :yin.head/signature] \"ab\")]]\n   189\t        (is (= :yin.head/malformed (head/judge p nil nil bad)) (pr-str bad))\n   190\t        (is (= :yin.head/malformed (head/judge p 5 m1 bad)))))\n   191\t    (testing \"a negative or non-integer sequence is malformed even when signed\"\n   192\t      (is (thrown? #?(:cljd Object :clj Exception :cljs :default)\n   193\t                   (head/trace key m1 -1)))\n   194\t      (is (thrown? #?(:cljd Object :clj Exception :cljs :default)\n   195\t                   (head/trace key m1 0.5))))\n   196\t    (is (= :yin.head/wrong-principal\n   197\t           (head/judge (sign/principal (:public (key-of v 1))) nil nil five)))\n   198\t    (is (= :yin.head/bad-proof\n   199\t           (head/judge p nil nil\n   200\t                       (update-in five [:yin.head/proof :yin.head/signature]\n   201\t                                  flip-first-bit))))\n   202\t    (is (= :yin.head/bad-proof\n   203\t           (head/judge p 5 m1\n   204\t                       (assoc-in five [:yin.head/envelope :yin.head/seq] 6)))\n   205\t        \"a sequence raised past the signature is a bad proof, not a candidate\")\n   206\t    (testing \"a nil floor: candidate, whatever the sequence\"\n   207\t      (doseq [n [0 1 5 (get-in v [:head-wide :envelope :yin.head/seq])]]\n   208\t        (is (= :candidate (head/judge p nil nil (at n m1))))))\n   209\t    (is (= :yin.head/stale (head/judge p 5 m1 (at 4 m1))))\n   210\t    (is (= :yin.head/stale (head/judge p 5 m1 (at 4 m2))))\n   211\t    (is (= :duplicate (head/judge p 5 m1 five)))\n   212\t    (is (= :yin.head/equivocation (head/judge p 5 m1 (at 5 m2))))\n   213\t    (is (= :candidate (head/judge p 5 m1 (at 6 m1))))\n   214\t    (is (= :candidate (head/judge p 5 m1 (at 6 m2))))\n   215\t    (testing \"the vector traces, the wide one above 2^32\"\n   216\t      (is (= :candidate (head/judge p 0 m1 (vector-trace v :head-wide))))\n   217\t      (is (= :yin.head/stale\n   218\t             (head/judge p 4294967298 m1 (vector-trace v :head-wide)))))))\n   219\t\n   220\t\n   221\t(deftest sequence-zero\n   222\t  (let [v (vectors)\n   223\t        key (key-of v 0)\n   224\t        p (sign/principal (:public key))\n   225\t        m1 (get-in v [:head :envelope :yin.head/manifest])\n   226\t        m2 (get-in v [:tamper :manifest])]\n   227\t    (is (= :candidate (head/judge p nil nil (head/trace key m1 0)))\n   228\t        \"with a nil floor a trace of sequence 0 is a candidate\")\n   229\t    (is (= :candidate (head/judge p 0 m1 (head/trace key m1 1))))\n   230\t    (is (= :duplicate (head/judge p 0 m1 (head/trace key m1 0))))\n   231\t    (is (= :yin.head/equivocation (head/judge p 0 m1 (head/trace key m2 0))))\n   232\t    (doseq [n [-1 0.5]]\n   233\t      (is (= :yin.head/malformed\n   234\t             (head/judge p 0 m1 (assoc-in (head/trace key m1 0)\n   235\t                                          [:yin.head/envelope :yin.head/seq]\n   236\t                                          n)))))\n   237\t    (testing \"seq-of one transaction is 0, the transactor's first t\"\n   238\t      (let [log (:dao.stream/handle\n   239\t                  (memory-log/create! {:dao.stream/type\n   240\t                                       memory-log/transport-type}))\n   241\t            tx (transactor/create! {:local-stream log\n   242\t                                    :intake-pool [(:dao.stream/handle\n   243\t                                                    (memory-log/create!\n   244\t                                                      {:dao.stream/type\n   245\t      