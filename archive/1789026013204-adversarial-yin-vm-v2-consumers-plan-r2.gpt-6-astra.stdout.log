w]\n232:       :plotter [plotter-demo/main-view]\n234:       :continuation [cont-demo/main-view]\n280:            {:on-click #(pipeline/show-explainer-video!),\n288:           [pipeline/layout-controls pipeline/app-state]])])]))\n   346\t(defn ast->datoms-with-root\n   347\t  \"Convert AST map into a vector of datoms. A datom is [e a v t m].\n   348\t   Returns [root-id datoms].\n   349\t\n   350\t   Entity IDs are tempids (negative integers: -16, -17, -18...) that get resolved\n   351\t   to actual entity IDs when transacted. The transactor assigns real positive IDs.\n   352\t\n   353\t   Options:\n   354\t     :t - transaction ID (default 0)\n   355\t     :m - metadata entity reference (default assert; see dao.datom/reserved)\n   356\t     :id-start - starting entity ID for tempids (default (- datom/first-user-id))\"\n   357\t  ([ast] (ast->datoms-with-root ast {}))\n   358\t  ([ast opts]\n   359\t   (let [id-counter (atom (or (:id-start opts) (- datom/first-user-id)))\n   360\t         t (or (:t opts) 0)\n   361\t         m (or (:m opts) datom/default-op)\n   362\t         gen-id #(swap! id-counter dec)\n   363\t         datoms (atom [])\n   364\t         emit! (fn [e attr val] (swap! datoms conj [e attr val t m]))\n   365\t         ;; Track pre-assigned EIDs already emitted so that a shared\n   366\t         ;; lambda-ast\n   367\t         ;; (same :eid in definition operand and call-site operator) is\n   368\t         ;; processed exactly once; every reference resolves to the same\n   369\t         ;; EID.\n   370\t         seen-eids (atom #{})]\n   371\t     (letfn\n   372\t       [(convert\n   373\t          [node]\n   374\t          (let [pre-eid (:eid node)\n   375\t                e (or pre-eid (gen-id))\n   376\t                {:keys [type tail?]} node]\n   377\t            (if (and pre-eid (contains? @seen-eids pre-eid))\n   378\t              ;; Shared reference already emitted — return EID without\n   379\t              ;; re-emitting.\n   380\t              e\n   402\t                                     (emit! e :yin/operator op-id)\n   403\t                                     (emit! e :yin/operands operand-ids)))\n   404\t                  :dao.stream.apply/call\n   405\t                  (do (emit! e :yin/type :dao.stream.apply/call)\n   406\t                      (emit! e :yin/op (:op node))\n   407\t                      (let [operand-ids (mapv convert (:operands node))]\n   408\t                        (emit! e :yin/operands operand-ids)))\n   409\t                  :if (do (emit! e :yin/type :if)\n   410\t                          (let [test-id (convert (:test node))\n   411\t                                cons-id (convert (:consequent node))\n   412\t                                alt-id (convert (:alternate node))]\n   413\t                            (emit! e :yin/test test-id)\n   414\t                            (emit! e :yin/consequent cons-id)\n   415\t                            (emit! e :yin/alternate alt-id)))\n   416\t                  ;; VM primitives\n   417\t                  :vm/gensym (do (emit! e :yin/type :vm/gensym)\n   418\t                                 (emit! e :yin/prefix (or (:prefix node) \"id\")))\n   419\t                  :vm/store-get (do (emit! e :yin/type :vm/store-get)\n   420\t                                    (emit! e :yin/key (:key node)))\n   421\t                  :vm/store-put (do (emit! e :yin/type :vm/store-put)\n   422\t                                    (emit! e :yin/key (:key node))\n   423\t                                    (emit! e :yin/value (:val node)))\n   424\t                  ;; Stream operations\n    76\t    (is (str/includes? rejected \"Unknown Yin REPL VM type\"))\n    77\t    (is (str/includes? rejected \":ast-walker\"))))\n    78\t\n    79\t\n    80\t(deftest language-and-compile-commands-behave-as-they-do-in-v1\n    81\t  (let [[state result] (core/eval-input (core/create-state) \"(lang :python)\")\n    82\t        [_ compiled] (core/eval-input state \"(compile \\\"1 + 2\\\")\")]\n    83\t    (is (= \"Switched to Python\" result))\n    84\t    (is (str/includes? compiled \"AST:\"))\n    85\t    (is (str/includes? compiled \"Datoms:\"))))\n    86\t\n    87\t\n    88\t(deftest reset-rebuilds-the-vm-and-its-attachment\n    89\t  (let [[state _] (evaluate (core/create-state) [\"(+ 1 2)\"])\n    90\t        [state' message] (core/eval-input state \"(reset)\")]\n    91\t    (is (= \"ASTWalkerVM reset\" message))\n    92\t    (is (not (identical? (:vm state) (:vm state'))))\n    93\t    (is (not (identical? (:program-stream state) (:program-stream state')))\n    94\t        \"the program medium is rebuilt with the VM\")\n    95\t    (is (not (identical? (:observer state) (:observer state')))\n    31\t\n    32\t\n    33\t(def ^:private vm-constructors\n    34\t  {:ast-walker ast-walker/create-vm,\n    35\t   :semantic semantic/create-vm,\n    36\t   :register register/create-vm,\n    37\t   :stack stack/create-vm})\n    38\t\n    39\t\n    40\t(def ^:private vm-labels\n    41\t  {:ast-walker \"ASTWalkerVM\",\n    42\t   :semantic \"SemanticVM\",\n    43\t   :register \"RegisterVM\",\n    44\t   :stack \"StackVM\"})\n    45\t\n   160\t(defn- make-vm\n   161\t  ([vm-type] (make-vm vm-type nil nil))\n   162\t  ([vm-type telemetry-stream] (make-vm vm-type telemetry-stream nil))\n   163\t  ([vm-type telemetry-stream output-stream]\n   164\t   (when-not (contains? vm-constructors vm-type)\n   165\t     (throw (ex-info \"Unknown Yin REPL VM type\"\n   166\t                     {:vm-type vm-type,\n   167\t                      :supported (vec (keys vm-constructors))})))\n   168\t   (let [constructor (get vm-constructors vm-type)\n   169\t         in-stream (make-local-stream)]\n   170\t     (cond-> (constructor {:primitives (make-repl-primitives output-stream),\n","exit_code":0,"status":"completed"}}
