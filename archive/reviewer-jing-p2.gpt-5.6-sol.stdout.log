tep` core runs the materialization effect before\n   253\tadvancing the cursor. If materialization throws, the exception propagates\n   254\tbefore the cursor is advanced, so the caller's state is untouched and the\n   255\tsame payload is reprocessed from the same cursor once the backend succeeds.\n   256\t\n   257\tThe pool's signals and cursor disciplines are:\n   258\t\n   259\t| signal                                                    | when                                                       | extra keys                                      | member cursor            |\n   260\t| --------------------------------------------------------- | ---------------------------------------------------------- | ----------------------------------------------- | ------------------------ |\n   261\t| `:dao.stream/ok`                                          | a payload was materialized                                 | `:address`                                      | successor, from the step |\n   262\t| `:dao.stream/blocked`                                     | empty pool, or every non-ended member blocked              | —                                               | unchanged                |\n   263\t| `:dao.stream/end`                                         | every member has ended                                     | —                                               | unchanged                |\n   264\t| `:dao.stream/gap`                                         | member `i`'s position was evicted                          | `:member i`, `:cursor` (the step's `:recovery`) | unchanged                |\n   265\t| `/cursor-mismatch`, `/invalid-cursor`, `/transport-error` | member `i`'s read failed, or answered outside the contract | `:member i`, `:result` (the step's `:read`)     | unchanged                |\n   266\t\n   267\tAn unrecognized transport answer is reported as a defect signal under\n   268\t`:dao.stream/transport-error`, carrying the classified read under `:result`\n   269\twith the raw answer retained inside it, and no action is taken\n   270\tbeyond declining to advance. Recovery is the caller's decision, made by\n   271\t`adopt-cursor` with the reported `:cursor`.\n   272\t\n   273\tThe `:next` scheduling index keeps a continuously ready member from\n   274\tstarving another. Scheduling does not affect the resulting content set,\n   275\tbecause materialization is content-addressed, commutative, and idempotent.\n   276\t\n   277\t## Resource lifecycle\n   278\t\n   279\tThe observer itself is a value: `observe-step!` owns no resources and has\n   280\tnothing to close — streams and storage handles retain responsibility for\n   630\t     :cljd (try (let [f (dart-io/File path)]\n   631\t                  (when (.existsSync f) (.deleteSync f)))\n   632\t                (catch Object _ nil))))\n   633\t\n   634\t\n   635\t(defn- open-local\n   636\t  [datoms]\n   637\t  (let [s (ds/open! {:dao.stream/type :ringbuffer})]\n   638\t    (doseq [d datoms] (ds/append! s d))\n   639\t    s))\n   640\t\n   641\t\n   642\t(defn- open-intake\n   643\t  \"A dao.stream ringbuffer intake writer.\"\n   644\t  []\n   645\t  (:dao.stream/handle\n   646\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n   647\t                         :dao.stream.ringbuffer/capacity 4096})))\n   648\t\n   649\t\n   650\t(defn- pool-state\n   651\t  \"Observer state over one v2 intake handle, entered at its oldest cursor.\"\n   652\t  [s]\n   653\t  (jing/observer-state\n   654\t    [{:stream s\n   655\t      :cursor (:dao.stream/cursor (stream/cursor s :dao.stream/oldest))}]))\n   656\t\n   657\t\n   658\t(defn- publish-into-file\n   659\t  ([datoms] (publish-into-file datoms \"pub\"))\n   660\t  ([datoms prefix] (publish-into-file datoms prefix nil))\n   661\t  ([datoms prefix opts]\n   662\t   (let [path (temp-content-path prefix)\n   663\t         store (jing-file/create-content-file path)]\n   664\t     (try (let [local (open-local datoms)\n   665\t                intake (open-intake)\n   666\t                {:keys [manifest-address]}\n   667\t                (index/publish-index! local [intake] opts)\n   668\t                drain (fn drain\n   669\t                        [state]\n   670\t                        (let [r (jing/observe-step! store state)]\n   671\t                          (when (= :dao.stream/ok (:signal r))\n   672\t                            (drain (:state r)))))]\n   673\t            (drain (pool-state intake))\n   674\t            {:store store,\n   675\t             :path path,\n   676\t             :manifest-address manifest-address,\n   677\t             :descriptor (index/published-index {:dao.jing/type :dao.jing/file,\n   678\t                                                 :path path}\n   679\t                                                manifest-address)})\n   680\t          (catch #?(:clj Throwable\n   681\t                    :cljs :default\n   682\t                    :cljd Object)\n   683\t                 e\n   684\t            (jing/close! store)\n   685\t            (cleanup-file path)\n  1365\t;; ---------------------------------------------------------------------------\n  1366\t\n  1367\t(defn- temp-content-path\n  1368\t  [prefix]\n  1369\t  (str \"target/test-schema-\" prefix \"-\" (random-uuid) \".log\"))\n  1370\t\n  1371\t\n  1372\t(defn- cleanup-file\n  1373\t  [path]\n  1374\t  #?(:clj (let [f (java.io.File. path)] (when (.exists f) (.delete f)))\n  1375\t     :cljs (try (.unlinkSync (js/require \"fs\") path) (catch :default _))\n  1376\t     :cljd (try (let [f (dart-io/File path)]\n  1377\t                  (when (.existsSync f) (.deleteSync f)))\n  1378\t                (catch Object _ nil))))\n  1379\t\n  1380\t\n  1381\t(defn- materialize-to-file-store\n  1382\t  \"Drain v2 intake streams through a dao.jing observer into a file-backed\n  1383\t   content store; returns the store handle. Draining runs until blocked or\n  1384\t   end; a gap or defect is fatal to this composition (E11).\"\n  1385\t  [intakes path]\n  1386\t  (let [h (jing-file/create-content-file path)]\n  1387\t    (loop [st (jing/observer-state\n  1388\t                (mapv (fn [s]\n  1389\t                        {:stream s\n  1390\t                         :cursor (:dao.stream/cursor\n  1391\t                                  (stream/cursor s :dao.stream/oldest))})\n  1392\t                      intakes))]\n  1393\t      (let [r (jing/observe-step! h st)]\n  1394\t        (case (:signal r)\n  1395\t          :dao.stream/ok (recur (:state r))\n  1396\t          :dao.stream/blocked h\n  1397\t          :dao.stream/end h\n  1398\t          (throw (ex-info \"test observer hit a gap or defect\"\n  1399\t                          {:result r})))))))\n  1400\t\n  1401\t\n  1402\t;; ---------------------------------------------------------------------------\n  1403\t;; W38: publish-then-schema-view-parity (§9 publisher parity)\n  1404\t;; ---------------------------------------------------------------------------\n  1405\t\n  1406\t(deftest publish-then-schema-view-parity\n  1407\t  (let [{:keys [local intake]} (fresh-streams)\n  1408\t        w (schema/transactor local intake)]\n  1409\t    (schema/transact! w (bootstrap-tx))\n  1410\t    (schema/transact! w [[7 :person/name \"Alice\"]\n","exit_code":0,"status":"completed"}}
