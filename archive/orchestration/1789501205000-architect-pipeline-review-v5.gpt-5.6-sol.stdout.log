t                       (:env next)\n   597\t                       (:k next)\n   598\t                       (:value next)\n   599\t                       next)))))\n   600\t        node (case type\n   601\t               :literal (recur nil env k (:value node) vm)\n   602\t               :variable (let [v (engine/resolve-var env\n   603\t                                                     (:store vm)\n   604\t                                                     (:primitives vm)\n   605\t                                                     (:modules vm)\n   606\t                                                     (:name node))]\n   607\t                           (recur nil env k v vm))\n   608\t               :lambda (recur nil\n   609\t                              env\n   610\t                              k\n   611\t                              {:type :closure,\n   612\t                               :params (:params node),\n   613\t                               :body (:body node),\n   614\t                               :env env}\n   615\t                              vm)\n    40\t\n    41\t(defn- fail\n    42\t  [message data]\n    43\t  (throw (ex-info message data)))\n    44\t\n    45\t\n    46\t(defn resolve-var\n    47\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n    48\t\n    49\t   The registry is a value supplied by the composition, not a global.\"\n    50\t  [env store primitives registry name]\n    51\t  (if-let [pair (find env name)]\n    52\t    (val pair)\n    53\t    (if-let [pair (find store name)]\n    54\t      (val pair)\n    55\t      (if-let [pair (find primitives name)]\n    56\t        (val pair)\n    57\t        (if-let [resolved (when (namespace name)\n    58\t                            (module/resolve-module\n    59\t                              registry\n    60\t                              (symbol (str (namespace name)\n    61\t                                           \".\"\n    62\t                                           (clojure.core/name name)))))]\n    63\t          resolved\n    64\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n    65\t                {:symbol name}))))))\n   540\t+-----------------------------------------------+------------------------------------------------------------------------------------------------------------------------+\n   541\t| module manifests pinning AST content          | a manifest names the tree addresses it exports; equal content is equal address across hosts                            |\n   542\t+-----------------------------------------------+------------------------------------------------------------------------------------------------------------------------+\n   543\t| lowering as an address-to-address function    | `lower : tree → instruction vector`, and each application of it is one derivation record (§5.2)                        |\n   544\t+-----------------------------------------------+------------------------------------------------------------------------------------------------------------------------+\n   545\t\n   546\tThe address is deterministic and operand-order-sensitive: `(add 1 2)` and\n   547\t`(add 2 1)` address differently, because `order-normalize` sorts maps and\n   548\tsets but leaves vectors in place (`jing.cljc:45-64`). Literal maps and sets\n   549\tinside a `data` slot hash order-insensitively, which is correct: they are\n   550\tvalues.\n   551\t\n   552\t### 4.2 The transitional encoder is inherited, and every identity use is blocked on it\n   553\t\n   554\t`segment-key` hashes an order-normalized `pr-str` (`jing.cljc:67-71`,\n   555\t`:203-214`). `order-normalize` coerces **every** sequential value to a\n   556\tvector (`jing.cljc:63`), and `pr-str` prints no metadata. The encoder is\n   557\ttherefore not injective over the `data` domain, and the collisions are not\n   558\tconfined to one collection type:\n   559\t\n   560\t+--------------------------------------------------------+------------------------------------+--------------------------------------------------------------------------+\n   561\t| Two different values                                   | One address today                  | Why it matters                                                           |\n   562\t+========================================================+====================================+==========================================================================+\n   563\t| `[:literal [1 2]]` and `[:literal (1 2)]`              | lists become vectors               | `conj` appends to one and prepends to the other                          |\n   564\t+--------------------------------------------------------+------------------------------------+--------------------------------------------------------------------------+\n   565\t| `[:literal [1 2]]` and `[:literal (seq [1 2])]`        | a seq is sequential but not a list | the same, and a list reject-rule does not see it                         |\n   566\t+--------------------------------------------------------+------------------------------------+--------------------------------------------------------------------------+\n   567\t| `[:literal ^{:a 1} [1 2]]` and `[:literal ^{:a 2} [1   | metadata is dropped by `pr-str`    | `data` admits plain metadata (`linearize.cljc:58`) and programs may read |\n   568\t| 2]]`                                                   |                                    | it                                                                       |\n   569\t+--------------------------------------------------------+------------------------------------+--------------------------------------------------------------------------+\n   570\t\n   760\t### 6.1 The row relation and the two directions around it\n   761\t\n   762\tThe flat rows are the canonical stored form (§2.1), and `q` runs over\n   763\tthem directly — ruling 3 of 2026-09-14 was verified live over exactly\n   764\tthis shape. A stored set holds one row per distinct subtree: identical\n   765\tsubtrees project to the identical row, so the set is the tree's DAG\n   766\t(§4.4). Because a tag has one arity in the tree, it has one arity in the\n   767\trelation (tag arity plus one for the id). Rows of one tag are\n   768\thomogeneous, so a where-pattern for a tag has exactly that tag's arity\n   769\tand no padding. Rows from many trees union into one relation without\n   770\tcollision, because ids are addresses. An occurrence count is a count\n   771\tover parent slots or over the occurrence relation below, never over\n   772\trows.\n   773\t\n   774\t**The Dedicated AST Indexer:** This row relation (called `$ast` in queries) is maintained by the dedicated AST indexer (§1). The indexer is a `dao.stream` observer peer to the evaluators (§7.1); its input is the row batches of §7.1; its output is this row relation plus the occurrence relation below; it is distinct from `dao.space.index`, which indexes datoms only (§6.5); it is a projection keeper per §1's Query layer, so discarding it loses nothing.\n   775\t\n   776\t`map → rows` is the **codec boundary projection** (`yin.vm/ast->semantic-bytecode`): strip the §2.5\n   777\texclusions, saturate per §2.4, positionalize per the §2.3 dictionary,\n   778\tmerkle per §4.1. It is the standing contract of the Encoder Observer, not a\n   779\tmigration device (§9.1).\n   780\t\n   781\t`rows → map` is **load-time reconstruction** (§7.1): validate the rows\n   782\t(§7.4), then rebuild the map AST through the ids. The precedent is\n   783\t`datoms->ast` (`src/cljc/yin/vm.cljc:494-559`), which already\n   784\trebuilds map ASTs from flat rows through entity ids — a `get-attr` per\n   785\tfield over an entity index, recursion through child ids; the loader is\n  1770\taccept datom batches; the REPL's own eval path still converts a\n  1771\tsemantic-VM AST through `ast->datoms` before it travels\n  1772\t(`repl/v2/core.cljc:444-449`). Two things about the row lane are\n  1773\t**unverified**:\n  1774\t\n  1775\t- **The batch shape.** Whether one batch is one tree's row set, one\n  1776\t  `{:yin/code :yin/declarations}` value (§8.5), one vector, or a\n  1777\t  collection of them is\n  1778\t  a medium contract this design has not exercised end to end; §7.1 assumes\n  1779\t  one canonical value per batch. The shape must be fixed with the REPL\n  1780\t  shell and the `yin.vm.stream-observer` tests before the loaders are\n  1781\t  switched.\n  1782\t- **The program-input predicate.** `engine/executable-program-datom?`\n  1783\t  (`engine.cljc:511-513`) decides what counts as program input by testing\n  1784\t  the attribute namespace of an `[e a v t m]` row, and\n  1785\t  `append-program-datoms` (`engine.cljc:590-612`) builds on it. A row\n  1786\t  batch has no attribute slot. A repository search on 2026-09-14 found no\n  1787\t  caller of the v2 `append-program-datoms` beyond its own overload, so a\n  1788\t  row counterpart is not presumed necessary; whether any live\n  1789\t  composition reaches the predicate is what the implementation phase\n  1790\t  establishes before deciding.\n  1791\t\n  1792\tBoth are integration items to scope in the implementation phase.\n  1793\t\n  1794\t### 9.3 What stays on datoms, and why\n  1795\t\n  1796\tThis is §1's datom-layer jobs\n  1797\tseen from the migration side:\n  1798\t\n  1799\t- **The ledger, every ref, and every ledger event** (§8): mutability,\n  1800\t  history, provenance, and custody are datom properties, and the\n  1801\t  transactor is what possesses them.\n  1802\t- **`dao.space.index` and published covered indexes**: they index datoms,\n  1803\t  and the scale path of §6.5 goes through them.\n  1804\t- **The macro expander's event log** (§8.4): events are entities with\n  1805\t  attributes, one per attempt; only their values changed kind.\n  1806\t- **The datom projection of code** (§6.5): kept for the three query classes\n  1807\t  it alone serves, regenerable from the content at any time.\n  1808\t- **Execution traces** (`yin.vm.semantic.md` §3.6): state over time is a\n  1809\t  datom stream by design and is untouched.\n  1810\t\n  1811\t---\n  1812\t\n  1813\t## §10 Acceptance blockers and open items\n  1814\t\n  1815\t1. **Type-preserving canonical encoding in `dao.jing`** — declared,\n","exit_code":0,"status":"completed"}}
