41\t                              vm)\n   642\t               :application\n   643\t               (recur (:operator node)\n   644\t                      env\n   645\t                      {:frame node, :next k, :env env, :type :eval-operator}\n   646\t                      val\n   647\t                      vm)\n   648\t               :if (recur (:test node)\n   649\t                          env\n   650\t                          {:frame node, :next k, :env env, :type :eval-test}\n   705\t  [^ASTWalkerVM vm]\n   706\t  (engine/vm-value vm))\n   707\t\n   708\t\n   709\t(defn vm-load-program\n   710\t  \"Load one datom batch into the VM: the existing datom-to-AST conversion\n   711\t   plus the execution-field updates. This is the loader host composition\n   712\t   hands to `dao.stream.observer/run-on-stream` alongside\n   713\t   `engine/ready-for-ingress?` and the VM's runner.\"\n   714\t  [^ASTWalkerVM vm datoms]\n   715\t  (let [ast (vm/datoms->ast datoms)]\n   716\t    (assoc vm\n   717\t           :program ast\n   718\t           :control ast\n   719\t           :halted? false\n   720\t           :blocked? false\n   721\t           :value nil)))\n   722\t\n   723\t\n   724\t(defn vm-load-rows\n   725\t  \"Load one semantic-bytecode row set `{:root id, :rows {id row}}` into the\n   726\t   VM: `vm/semantic-bytecode->ast` runs the §7.4 validator first and throws\n   727\t   `ex-info` carrying the defect's `:rule` and `:path` (or `:id`), then\n   728\t   reconstructs the map AST, and this applies the same execution-field\n   729\t   updates as `vm-load-program`. This is §9.1's loader, the successor of\n   730\t   the datom decode; the datom loader stays alongside it — both are legal\n   731\t   per-composition choices, and a composition wires whichever loader(s) it\n   732\t   wants.\"\n   733\t  [^ASTWalkerVM vm bc]\n   734\t  (let [ast (vm/semantic-bytecode->ast bc)]\n   735\t    (assoc vm\n   736\t           :program ast\n   737\t           :control ast\n   738\t           :halted? false\n   739\t           :blocked? false\n   740\t           :value nil)))\n   741\t\n   742\t\n   743\t(defn- vm-reset\n   744\t  \"Reset execution state, preserving the loaded AST program.\"\n   745\t  [^ASTWalkerVM vm]\n   804\t(defn create-vm\n   805\t  \"Create a new ASTWalkerVM.\n   806\t\n   807\t   Options:\n   808\t     :env           initial lexical environment\n   809\t     :primitives    primitive operations map\n   810\t     :primitive-profiles published primitive profile registry\n   811\t     :primitive-canonical-names name -> canonical name for intentional aliases\n   812\t     :modules       module registry value (see `yin.vm.module`)\n   813\t     :make-stream   (fn [capacity] -> create outcome); no default\n   814\t     :call-in       explicit inbound request handle\n   815\t     :call-out      explicit outbound response handle\n   816\t     :call-capacity capacity for a constructed FFI pair\n   817\t     :bridge        host FFI handlers\n   818\t\n   819\t   There is no `:in-stream`: program observation belongs to\n   820\t   `dao.stream.observer`, and an obsolete `:in-stream` option is\n   821\t   rejected here, before any FFI resource is allocated.\n   822\t\n   823\t   Construction is all-or-nothing: creating the FFI pair and minting the\n   824\t   call-out cursor are stream operations, and any non-`ok` outcome fails here\n   825\t   rather than leaving a half-built VM. The bridge cursor is minted by\n   826\t   `ffi/attach` below; the program cursor belongs to observer attachment.\"\n   827\t  ([] (create-vm {}))\n   828\t  ([opts]\n   829\t   (when (contains? opts :in-stream)\n   830\t     (throw (ex-info\n   831\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n   832\t              {:in-stream (:in-stream opts)})))\n   833\t   (let [env (or (:env opts) {})\n   834\t         base (vm/empty-state\n   835\t                (assoc (select-keys opts\n   836\t       