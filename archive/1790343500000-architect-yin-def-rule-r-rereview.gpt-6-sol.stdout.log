   339\t(declare handle-effect resume-continuation)\n   340\t\n   341\t\n   342\t(defn run-loop\n   343\t  \"Generic eval loop with scheduler support. Ready entries are pure data;\n   344\t   `resume-fn` pops and restores them.\"\n   345\t  [state active? step-fn resume-fn]\n   346\t  (loop [v state]\n   347\t    (let [q (or (:ready-queue v) [])]\n   348\t      (cond (active? v) (recur (step-fn v))\n   349\t            (:blocked? v) (let [v' (check-wait-set v)]\n   447\t                            :k nil))\n   448\t        :vm/resume (cesk-return state\n   449\t                                (:val node)\n   450\t                                env\n   451\t                                {:type :eval-resume-val,\n   452\t                                 :parked-id (:parked-id node),\n   453\t                                 :next k,\n   454\t                                 :env env}\n   455\t                                (:value state))\n   456\t        :stream/make (let [capacity (or (:buffer node)\n   457\t                                        vm/default-stream-capacity)\n   458\t                           effect {:effect :stream/make, :capacity capacity}\n   459\t                           {:keys [state value]} (engine/handle-effect\n   460\t                                                   state\n   461\t                                                   effect\n   462\t                                                   {:restore-fn\n   463\t                                                    ast-walker-restore})]\n   464\t                       (cesk-return state nil env k value))\n   465\t        :stream/put\n   466\t        (cesk-return\n   467\t          state\n   468\t          (:target node)\n   469\t          env\n   470\t          {:frame node, :next k, :env env, :type :eval-stream-put-target}\n   471\t          (:value state))\n   472\t        :stream/cursor\n   473\t        (cesk-return\n   474\t          state\n   475\t          (:source node)\