d (rest places))\n   922\t                        [(nth (get index (nth row 2)) 3)])\n   923\t                (map second places))))\n   924\t          (walk\n   925\t            [store a]\n   926\t            (let [row (get index a)\n   927\t                  store (cond\n   928\t                          (= standin-tag (row-tag row))\n   929\t                          (let [[_ _ nm k] row\n   930\t                                entry (get catalogue k)]\n   931\t                            (if (and entry (= nm (:name entry)))\n   932\t                              (assoc store nm (:macro-tree entry))\n   933\t                              store))\n   934\t\n   935\t                          :else\n   936\t                          (if-let [{:keys [name]} (definition-at index a)]\n   937\t                            (dissoc store name)\n   938\t                            store))]\n   939\t              (reduce walk store (children row))))]\n   940\t    (walk store root)))\n   941\t\n   942\t\n   943\t;; =============================================================================\n   944\t;; Events (§8)\n   945\t;; =============================================================================\n   230\t;; Safepoints (S7.4)\n   231\t;; =============================================================================\n   232\t\n   233\t(def transitions\n   234\t  \"Every S2.4 mnemonic classified by what its S4.2 transition does to\n   235\t   control. `:step` continues at pc+1; `:jump`, `:branch` and `:transfer`\n   236\t   move control (a `:resume` restores a parked configuration, so its\n   237\t   successor is not pc+1); `:terminal` leaves no successor; `:parking` may\n   238\t   leave the machine parked with a canonical configuration at pc+1 -- the\n   239\t   safepoints of S7.4.1. `:call` is parking because the operator may be a\n   240\t   primitive whose result is a blocking effect; `:current-continuation`\n   241\t   is a step, not a safepoint (it reifies and cont