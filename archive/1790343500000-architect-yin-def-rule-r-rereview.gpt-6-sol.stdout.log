  1684\t                                      h))]\n  1685\t                   {call-in-stream-key call-in,\n  1686\t                    call-out-stream-key call-out,\n  1687\t                    call-out-cursor-key (cursor-entry call-out-stream-key\n  1688\t                                                      (mint-oldest call-out\n  1689\t                                                                   :call-out))})\n  1690\t                 (catch #?(:cljd Object :clj Throwable :cljs :default) e\n  1691\t                   (doseq [h @created] (close-quietly h))\n  1692\t                   (throw e)))))]\n  1693\t       {:store (or pair-store {}),\n  1694\t        :parked {},\n  1695\t        :id-counter 0,\n  1696\t        :ready-queue [],\n  1697\t        :wait-set [],\n  1698\t        :primitives installed-primitives,\n  1699\t        :primitive-profiles installed-profiles,\n  1700\t        :primitive-canonical-names canonical-names,\n  1701\t        :modules (:modules opts),\n  1702\t        :make-stream make-stream,\n  1703\t        :call-capacity capacity,\n  1704\t        :telemetry (:telemetry opts),\n  1705\t        :telemetry-step 0,\n  1706\t        :telemetry-t 0,\n  1707\t        :telemetry-eid datom/first-user-id,\n","exit_code":0,"status":"completed"}}
