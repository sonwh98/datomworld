s tree) value),\n  1178\t                                          :source [tree path]})))\n  1179\t                            definitions)\n  1180\t            ;; only the run tree is expanded, so only its declarations are\n  1181\t            ;; replaced; every catalogue entry still resolves by index\n  1182\t            [index standins]\n  1183\t            (reduce (fn [[index acc] [k {:keys [name source]}]]\n  1184\t                      (if (= run-index (first source))\n  1185\t                        (let [[index s] (intern-body index [standin-tag name k])]\n  1186\t                          [index (assoc acc (second source) s)])\n  1187\t                        [index acc]))\n  1188\t                    [index {}]\n  1189\t                    (map-indexed vector catalogue))\n  1190\t            [index root] (rebuild-paths index (first (nth trees run-index)) standins)\n  1191\t            st (assoc base :index index :store store)]\n  1192\t        (if-let [e (guard-batch-rows st)]\n  1193\t          (finish (fail st e))\n  1194\t          (let [[st root'] (expand-node st root\n  1195\t                                        {:path [], :rel [],\n  1196\t                                         :frame {:parent nil, :root root,\n  1197\t                                                 :tree-index run-index},\n  1198\t                                         :shadow #{}, :depth 0})]\n  1199\t            (if (:error st)\n  1200\t              (finish st)\n  1201\t              (let [next-store (post-harvest store0 (:index st) root' catalogue)\n  1202\t                    [index root'] (retail (:index st) root')\n  1203\t                    [index root'] (lower-standins index root')\n  1204\t                    tree (packet-of index root')]\n  1205\t                (if-let [e (valid-tree? tree)]\n  1206\t                  (throw (ex-info \"Expander produced a non-canonical tree\" e))\n  1207\t                  (finish (assoc st :tree tree :next-store next-store)))))))))))\n  1208\t\n  1209\t\n  1210\t(defn expand\n  1211\t  \"`expand-batch` returning the tree packet, or throwing `ex-info` carrying\n  1212\t   the error data.\"\n  1213\t  [batch ctx]\n  1214\t  (let [{:keys [status tree error]} (expand-batch batch ctx)]\n  1215\t    (if (= :ok status)\n  1215\t    (if (= :ok status)\n  1216\t      tree\n  1217\t      (throw (ex-info \"Macro expansion failed\" error)))))\n  1218\t\n  1219\t\n  1220\t(defn make-ctx\n  1221\t  \"An expander context. The composition supplies the incarnation `token`\n  1222\t   and the opaque `source-medium` identity (§3.1); the store may be seeded.\"\n  1223\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n  1224\t  (cond-> {:store (or store {}),\n  1225\t           :incarnation {:yin.expander/token token},\n  1226\t           :attempt 0,\n  1227\t           :source-medium source-medium,\n  1228\t           :t 0,\n  1229\t           :guards (merge default-guards guards)}\n  1230\t    eval-fn (assoc :eval eval-fn)))\n  1231\t\n  1232\t\n  1233\t;; =============================================================================\n  1234\t;; Standard forms (§5.4)\n  1235\t;; =============================================================================\n  1236\t\n  1237\t(def ^:private defn-lambda-ast\n  1238\t  \"`(fn [fn-name fn-params & body]\n  1239\t      (let [b (yin/sequence-body body)\n  1240\t            l (yin/make-lambda fn-params b)]\n  1241\t        (yin/make-def fn-name l)))`, lowered as `let` lowers.\"\n  1242\t  (let [v (fn [s] {:type :variable, :name s})\n  1243\t        app (fn [op & args] {:type :application, :operator op, :operands (vec args)})]\n  1244\t    {:type :lambda,\n  1245\t     :params '[fn-name fn-params & body],\n  1246\t     :body (app {:type :lambda,\n  1247\t                 :params '[b],\n  1248\t                 :body (app {:type :lambda,\n  1249\t                             :params '[l],\n  1250\t                             :body (app (v 'yin/make-def) (v 'fn-name) (v 'l))}\n  1251\t                            (app (v 'yin/make-lambda) (v 'fn-params) (v 'b)))}\n  1252\t                (app (v 'yin/sequence-body) (v 'body)))}))\n  1253\t\n  1254\t\n  1255\t(def stdlib-forms\n  1256\t  \"The standard forms as a row-native batch: one tree defining `defn`,\n  1257\t   declared and harvested. Seed a store by expanding it (`seed-store`).\"\n  1258\t  (let [def-ast {:type :application,\n  1259\t                 :operator {:type :variable, :name 'yin/def},\n  1260\t                 :operands [{:type :literal, :value 'defn} defn-lambda-ast]}]\n  1261\t    [:yin.program/batch\n  1262\t     [(ast->packet def-ast)]\n  1263\t     0\n  1264\t     [[:yin.macro/definition 0 []]]\n  1265\t     [[:yin.macro/harvest 0 0 []]]]))\n  1266\t\n  1267\t\n  1268\t(defn seed-store\n  1269\t  \"Fold validated input batches in order through `expand-batch`, returning\n  1270\t   the resulting store. Throws on a batch that fails.\"\n  1271\t  [ctx batches]\n  1272\t  (:store (reduce (fn [ctx batch]\n  1273\t                    (let [{:keys [status error] :as r} (expand-batch batch ctx)]\n  1274\t                      (when-not (= :ok status)\n  1275\t                        (throw (ex-info \"Store seeding batch failed\" error)))\n  1276\t                      (:ctx r)))\n  1277\t                  ctx\n  1278\t                  batches)))\n  1279\t\n  1280\t\n  1281\t;; =============================================================================\n  1282\t;; Expander observer (§9)\n  1283\t;; =============================================================================\n  1284\t\n  1285\t(defn make-expander\n","exit_code":0,"status":"completed"}}
