230\t(defn stack-restore\n   231\t  \"This machine's one restore function, `base entry val -> state`\n   232\t   (`yin.vm.engine.md` section 2.1; design section 4.1, item 4). `base` is\n   233\t   the state after the engine has done its part; `entry` is the wait, ready,\n   234\t   or parked record; `val` is the value the parked instruction receives.\n   235\t\n   236\t   It first refuses with a qualified `:continuation-format` outcome unless\n   237\t   the entry's `:format` is `:yin.debruijn.code` and its `:hash` equals the\n   238\t   loaded image's H: a continuation from the named VM, from the register\n   239\t   kernel, or from another image is never interpreted here.\n   240\t\n   241\t   Then the FFI two-step, on the entry keys the `yin.vm.ffi` convention\n   242\t   owns, in the semantic VM's placement:\n   243\t\n   244\t   - A `:request-sent` entry is a writer whose retained request has now been\n   245\t     appended. It must not resume: its registers are re-parked as the\n   246\t     call-out reader (`ffi/response-wait-entry`) and the machine stays\n   247\t     blocked.\n   248\t   - A `:call-id` entry is a response reader. The woken value is a response\n   249\t     envelope, so `ffi/call-result` unwraps it and checks correlation, and\n   250\t     the parked call leaves `:parked` rather than accumulating.\n   251\t\n   252\t   Otherwise the registers are written from the entry and `val` is conjed\n   253\t   onto the restored `:stack` -- the B3 obligation that every\n   254\t   value-producing opcode lands on the stack, since there is no\n   255\t   accumulator.\"\n   256\t  [base entry val]\n   257\t  (when-not (and (= format-tag (:format entry))\n   258\t                 (= (:hash base) (:hash entry)))\n   259\t    (refuse-continuation! base entry))\n   220\t                   :expected-format format-tag,\n   221\t                   :expected-hash (:hash base)})))\n   222\t\n   223\t\n   224\t(defn register-restore\n   225\t  \"The register VM's restore function, `base entry val -> state`\n   226\t   (design section 5.2.3). Validates format identity and image hash R,\n   227\t   checks that the payload is defect-free via effects/continuation-defect,\n   228\t   checks that `val` is plain data, handles the FFI two-step, and delivers\n   229\t   `val` via `:write-result` or `:return-result`.\"\n   230\t  [base entry val]\n   231\t  (when-not (and (= format-tag (:format entry))\n   232\t                 (= (:hash base) (:hash entry)))\n   233\t    (refuse-continuation! base entry))\n   234\t  (when-let [defect (effects/continuation-defect entry)]\n   235\t    (throw (ex-info \"Corrupt or tampered continuation payload\"\n   236\t                    defect)))\n   237\t  (when-not (vm/plain-data? val)\n   238\t    (throw (ex-info \"Resume value must be plain data\"\n   239\t                    {:rule :resume-value, :val val})))\n   240\t  (if (:request-sent entry)\n   241\t    (-> base\n   242\t        (update :wait-set (fnil conj [])\n   243\t                (ffi/response-wait-entry entry (:call-id entry)))\n   244\t        (assoc :value :yin/blocked\n   245\t               :blocked? true\n   246\t               :halted? false))\n   247\t    (let [call-id (:call-id entry)\n   248\t          base (if call-id (update base :parked dissoc call-id) base)\n   249\t          val (if call-id (ffi/call-result val call-id) val)\n   250\t          resume-mode (:resume-mode entry)]\n   110\t  [seg pc env stack k call-id]\n   111\t  {:segment seg, :pc pc, :env env, :stack stack, :k k,\n   112\t   :call-id call-id,\n   113\t   :reason :next,\n   114\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   115\t   :stream-id vm/call-out-stream-key})\n   116\t\n   117\t\n   118\t(defn semantic-restore\n   119\t  \"Restore a wait-set or ready-queue entry into machine registers.\n   120\t\n   121\t   Two entry shapes carry more than registers:\n   122\t\n   123\t   - A `:request-sent` entry is a writer whose retained F