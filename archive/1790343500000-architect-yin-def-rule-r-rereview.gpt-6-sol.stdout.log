le]}]\n   689\t  (let [env {:vm vm,\n   690\t             :fetch (vm-fetch vm fetch),\n   691\t             :registry (or registry (:primitives vm)),\n   692\t             :canonical-names (or (:primitive-canonical-names vm) {}),\n   693\t             :modules (or modules {}),\n   694\t             :cursor-profile (or cursor-profile (constantly nil)),\n   695\t             :tree-of (or tree-of (constantly nil)),\n   696\t             :segment-profile (or segment-profile (constantly layout-profile))}]\n   697\t    (-> (initial-state (or contract \"v2\"))\n   698\t        (seed env)\n   699\t        (drain env)\n   700\t        (verify env))))\n   701\t\n   702\t\n   703\t(defn complete\n   704\t  \"`{:vm :fetch :registry :modules :contract …} → result` (§8–§9).\n   705\t\n   706\t     :vm              a quiescent SemanticVM\n   707\t     :fetch           address → canonical vector | {:root :rows} | nil, asked\n  1175\t         it; the rest are retained\n  1176\t     5b. every retained obligation binds in the      :unresolved-free,\n  1177\t         receiver                                    :shadowed-free\n  1178\t     6. the verified image\n  1179\t\n  1180\t   For a multi-part format the whole of steps 4 to 6 is the tree\n  1181\t   assembled by prepending each fetched part's address, the shape\n  1182\t   `validate-rows` takes (section 5.1), and the outcome carries\n  1183\t   `:parts {address body}`.\"\n  1184\t  ([handle index format identity]\n  1185\t   (fetch handle index format identity {}))\n  1186\t  ([handle index format identity receiver]\n  1187\t   (fetch handle index format identity receiver nil))\n  1188\t  ([handle index format identity receiver opts]\n  1189\t   (let [{:keys [contract]} opts]\n  1190\t     (if (and (some? contract) (not= contract (:contract format)))\n  1191\t       (refused :contract-mismatch\n  1192\t                {:expected contract, :actual (:contract format)})\n  1193\t       (if-let [address (index identity)]\n  1194\t    