] [[[i j] cid]]) v)\n64:+                nil))\n65:+            (range 1 (inc (count slots))) slots (rest body))))\n66:+\n67:+\n68:+(defn validate-rows\n69:+  \"§7.4: validate a projected row set before reconstruction. `rows` is\n70:+   `{id [id tag & slots]}`; `root` is the root row's id.\n71:+\n72:+   Returns nil when every row is well-formed, else the first defect as\n73:+   `{:rule r :path p}`, or `{:rule :root-reachable :id id}` for a row of the\n74:+   loaded set nothing reaches. Rules run in §7.4's order -- `:tag`,\n75:+   `:arity`, `:slot-kind`, `:saturation`, `:id-resolves`, `:acyclic`,\n76:+   `:root-reachable` -- discovered by descending from the root row, so a\n77:+   path is always available except for `:root-reachable`'s unreached rows.\n78:+   Each rule assumes the earlier ones held.\"\n79:+  [{:keys [root rows]}]\n80:+  (let [safe-tag (fn [row] (when (and (vector? row) (<= 2 (count row))) (nth row 1)))\n81:+        safe-slots (fn [tag] (get semantic-bytecode-grammar tag))\n82:+        safe-children (fn [id]\n83:+                        (let [row (get rows id)]\n84:+                          (if row\n85:+                            (let [tag (safe-tag row)\n86:+                                  slots (safe-slots tag)]\n87:+                              (if (and slots (= (count slots) (dec (count (subvec row 1)))))\n88:+                                (mapcat (fn [i [_ kind] v]\n89:+                                          (case kind\n90:+                                            :node (if (semantic-bytecode-slot-kind-ok? kind v) [[[i] v]] [])\n91:+                                            :nodes (if (semantic-bytecode-slot-kind-ok? kind v)\n92:+                                                     (map-indexed (fn [j cid] [[i j] cid]) v)\n93:+                                                     [])\n94:+                                            nil))\n95:+                                        (range 1 (inc (count slots))) slots (rest (subvec r