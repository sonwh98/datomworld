+(defn- settle-append
+  "Append `v` through `h` until it answers anything but full, ticking
+   the world at `now` between attempts."
+  [w now h v]
+  (loop [left 50]
+    (let [r (stream/append! h v)]
+      (if (and (pos? left) (= :dao.stream/full (:dao.stream/outcome r)))
+        (do (tick! w now) (recur (dec left)))
+        r))))
