+    (is (stream/reader? ro))
+    (is (not (stream/writer? ro)))
+    (let [s (serve-table {"ro" {:handle ro :surface #{:writer}}})]
+      (is (= :refused (:status s)))
+      (is (= ::rc/invalid-table (:reason s)))
