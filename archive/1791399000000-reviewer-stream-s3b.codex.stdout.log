   676	(defn- attach-identities
   677	  "Establish the channel and attach every identity at once, in order:
   678	   the first attaches (establishing the channel), each further one
   679	   reflects through it.  Confirmation is deferred (dao.stream.remote.md
   680	   2.4): the probes are sent now, and a reflection whose identity the
   681	   table lacks turns gone when its probe is answered.  An attach that is
   682	   not ok is `:lost` with its outcome, the partial handles and the
   683	   connection closed."
   684	  [d identities]
   685	  (loop [[id & more] identities
   686	         handles {}]
   687	    (if (nil? id)
   688	      (assoc d :status :attached :handles handles)
   689	      (let [rd (remote-descriptor (:spec d) id)
   690	            r (if (empty? handles)
   691	                (ws-project/dial-attach! (:dial d) rd)
   692	                (ws-project/dial-reflect! (:dial d) rd))]
   693	        (if (= :dao.stream/ok (:dao.stream/outcome r))
   694	          (recur more (assoc handles id (:dao.stream/handle r)))
   695	          (do (close-handles! (vals handles))
   696	              (when-some [h (some-> (:dial d) ws-project/channel :handle)]
   697	                (stream/close! h))
   698	              (assoc d :status :lost :outcome r :handles handles)))))))
