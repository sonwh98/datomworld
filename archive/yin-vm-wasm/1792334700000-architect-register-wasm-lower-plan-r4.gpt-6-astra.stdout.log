                       (to-hex (bit-and (unsigned-bit-shift-right x (* i 8))\n   216\t                                            0xff)\n   217\t                                   2))]\n   218\t             (apply str (map #(byte-at (if (< % 4) lo hi) (mod % 4)) (range 8))))\n   219\t     :default (let [n (long v)]\n   220\t                (apply str (map #(to-hex (bit-and (unsigned-bit-shift-right n (* % 8)) 0xff) 2)\n   221\t                                (range 8))))))\n   222\t\n   223\t\n   224\t(defn- double-le-hex\n   225\t  \"IEEE-754 bits, little-endian, one quiet NaN encoding regardless of a\n   226\t   host's NaN payload. :clj reads the bits through doubleToLongBits,\n   227\t   :cljs through a DataView with littleEndian explicitly true, :cljd\n   228\t   through a big-endian ByteData store read in reverse. On :cljs the\n   229\t   float64 carrier is unwrapped first: a DataView coerces an object\n   230\t   through its text, which loses -0.0's sign.\"\n   231\t  [x]\n   232\t  (let [v #?(:cljs (if (number? x) x (.-v ^not-native x)) :default x)]\n   233\t    (if (not= v v)\n   234\t      \"000000000000f87f\"\n   235\t      ;; ClojureDart reads both :cljd and :clj, so its branch comes first\n   236\t      #?(:cljd (let [bd (ByteData. 8)]\n   237\t                 (.setFloat64 bd 0 v)\n   238\t                 (apply str (map #(to-hex (.getUint8 bd %) 2) (range 7 -1 -1))))\n   239\t         :clj (int64-le-hex (Double/doubleToLongBits (double v)))\n   240\t         :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\n   241\t                 (.setFloat64 view 0 v true)\n   242\t                 (apply str (map #(to-hex (.getUint8 view %) 2) (range 8))))))))\n   243\t\n   244\t\n   245\t;; =============================================================================\n   246\t;; Host scalar classification (S2 item 4)\n   247\t;; =============================================================================\n   248\t\n   249\t(defn- well-formed-utf16?\n   250\t  \"True when every surrogate in `s` is paired: the precondition every\n   330\t\n   331\t(defn- host-double?\n   332\t  \"On the JVM, exactly `java.lang.Double` -- not 'every remaining number':\n   333\t   a JVM BigDecimal or Float is a distinct type this dimension's 14-class\n   334\t   domain does not declare, and folding either into :double would hash\n   335\t   its value at whatever precision `(double v)` happens to produce\n   336\t   instead of refusing it, exactly the silent canonicalization S2\n   337\t   forbids. On CLJS and CLJD, every remaining number: not a ratio, not a\n   338\t   bigint, not a long by this host's own rule -- CLJS has no BigDecimal/\n   339\t   Float distinction from a plain number to lose, so the complement rule\n   340\t   stays correct there. Jing's float64 carrier, how JS keeps an integral\n   341\t   float's kind, is :double too.\"\n   342\t  [v]\n   343\t  #?(:cljd (and (number? v) (not (host-long? v)))\n   344\t     :clj (instance? Double v)\n   345\t     :cljs (or (and (cbor/float64? v) (not (number? v)))\n   346\t               (and (number? v) (not (host-long? v)) (not (host-ratio? v))\n   347\t                    (not (host-bigint? v))))))\n   348\t\n   349\t\n   350\t(defn scalar-class\n   351\t  \"Classify `v` under this dimension's own S2 scalar domain: the class\n   352\t   keyword when `v` is representable, nil when it is not. Recursive over\n   353\t   vectors, lists, maps, and sets -- a collection classifies only when\n   354\t   every element does. No normalization and no folding of any kind\n   355\t   happen here; classification is the identity question, not the byte\n   356\t   rule (`encode-scalar` owns the bytes).\"\n   357\t  [v]\n   358\t  (cond\n   359\t    (nil? v) :nil\n   360\t    (boolean? v) :bool\n   361\t    (host-char? v) :char\n   362\t    (host-ratio? v) :ratio\n   363\t    (host-bigint? v) :bigint\n   364\t    (host-long? v) :long\n   365\t    (host-double? v) :double\n   366\t    (string? v) (when (well-formed-utf16? v) :string)\n   367\t    (keyword? v) (when (ident-parts-ok? v) :keyword)\n   368\t    (symbol? v) (when (ident-parts-ok? v) :symbol)\n   369\t    (vector? v) (when (every? #(some? (scalar-class %)) v) :vector)\n   370\t    (map? v) (when (and (not (record? v))\n   371\t                        (every? (fn [[k x]]\n   372\t                                  (and (some? (scalar-class k))\n   373\t                                       (some? (scalar-class x))))\n   374\t                                v))\n   375\t               :map)\n   376\t    (set? v) (when (every? #(some? (scalar-class %)) v) :set)\n   377\t    (sequential? v) (when (every? #(some? (scalar-class %)) v) :list)\n   378\t    :else nil))\n   379\t\n   380\t\n   381\t(defn scalar-value?\n   382\t  [v]\n   383\t  (some? (scalar-class v)))\n   384\t\n   385\t\n   386\t(def host-supported-scalar-classes\n   387\t  \"The scalar classes this host's encoder can represent (S2 item 4/5):\n   388\t   every declared class except the ones this host's own predicates above\n   389\t   never return. CLJS and CLJD both exclude :char, :ratio, and :bigint\n   390\t   (see `host-char?`, `host-ratio?`, `host-bigint?`); the JVM excludes\n   391\t   none.\"\n   392\t  (into #{}\n   393\t        (remove #?(:cljs #{:char :ratio :bigint} :cljd #{:char :ratio :bigint} :clj #{}))\n   394\t        scalar-classes))\n   395\t\n   396\t\n   397\t;; =============================================================================\n   398\t;; The exact executable scalar encoder (S2 item 3)\n   399\t;; =============================================================================\n   400\t\n   401\t(defn- ident-content\n   402\t  \"Namespace and name framed separately, exactly as supplied: no NFC.\n   403\t   An absent namespace frames as :nil rather than an empty string, so\n   404\t   `sym` and `ns/sym` never collide.\"\n   405\t  [x]\n   406\t  (str (if-let [ns (namespace x)] (framed :string ns) (framed :nil \"\"))\n   407\t       (framed :string (name x))))\n   408\t\n   409\t\n   410\t(defn encode-scalar\n   411\t  \"This dimension's own scalar encoder (S2 item 3), deliberately distinct\n   412\t   from `yin.vm.debruijn/encode-value`: exact numeric bits and exact\n   413\t   UTF-8 bytes, no NFC, no integral-double-to-long folding, :ratio and\n   414\t   :bigint as their own classes, map and set entries ordered by their own\n   415\t   encoded bytes. A value outside `scalar-class`'s domain -- including an\n   416\t   unpaired UTF-16 surrogate, which `well-formed-utf16?` already refuses\n   417\t   at classification -- throws a qualified :unsupported-value diagnostic\n   418\t   naming the value; nothing is silently canonicalized.\"\n   419\t  [v]\n   420\t  (case (scalar-class v)\n   421\t    :nil (framed :nil \"\")\n   422\t    :bool (framed :bool (if v \"01\" \"00\"))\n   423\t    :long (framed :long (int64-le-hex v))\n   424\t    :double (framed :double (double-le-hex v))\n   425\t    ;; :ratio never arises on :cljs or :cljd (`host-ratio?` is always\n   426\t    ;; false on both), but `case` still compiles every branch, and neither\n   427\t    ;; host resolves a bare `numerator`/`denominator` var (ClojureDart has\n   428\t    ;; no ratio type at all; dao.jing.cbor's own Rational carrier needs\n   429\t    ;; its own host-specific accessor wrapper for exactly this reason) --\n   430\t    ;; guarded out here rather than left as an unresolved-symbol error on\n   431\t    ;; a branch that can't run.\n   432\t    :ratio #?(:cljs (framed :ratio \"\")\n   433\t              :cljd (framed :ratio \"\")\n   434\t              ;; JVM Ratio numerator/denominator are BigIntegers and can\n   435\t              ;; exceed int64 range (e.g. (/ 10000000000000000000N 3)); a\n   436\t              ;; component outside that range is refused with the same\n   437\t              ;; qualified diagnostic every other out-of-domain value\n   438\t              ;; gets, rather than an unqualified IllegalArgumentException\n   439\t              ;; from int64-le-hex's own (long v) cast.\n   440\t              :default (let [num (numerator v), den (denominator v)]\n   441\t                         (when-not (and (<= Long/MIN_VALUE num Long/MAX_VALUE)\n   442\t                                        (<= Long/MIN_VALUE den Long/MAX_VALUE))\n   443\t                           (throw (ex-info \"Ratio component outside int64 range in executable scalar encoding\"\n   444\t                                           {:rule :unsupported-value, :value v})))\n   445\t                         (framed :ratio (str (framed :long (int64-le-hex num))\n   446\t                                             (framed :long (int64-le-hex den))))))\n   447\t    :bigint (framed :bigint (str v))\n   448\t    :char (framed :char (str v))\n   449\t    :string (framed :string v)\n   450\t    :keyword (framed :keyword (ident-content v))\n   451\t    :symbol (framed :symbol (ident-content v))\n   452\t    :vector (framed :vector (apply str (map encode-scalar v)))\n   453\t    :list (framed :list (apply str (map encode-scalar v)))\n   454\t    :map (let [entries (sort (map (fn [[k x]] [(encode-scalar k) (encode-scalar x)]) v))]\n   455\t           (when (some (fn [[a b]] (= (first a) (first b))) (partition 2 1 entries))\n   456\t             (throw (ex-info \"Map keys collide in canonical executable encoding\"\n   457\t                             {:rule :unsupported-value, :value v})))\n   458\t           (framed :map (apply str (mapcat identity entries))))\n   459\t    :set (let [elements (sort (map encode-scalar v))]\n   460\t           (when (some (fn [[a b]] (= a b)) (partition 2 1 elements))\n   461\t             (throw (ex-info \"Set elements collide in canonical executable encoding\"\n   462\t                             {:rule :unsupported-value, :value v})))\n   463\t           (framed :set (apply str elements)))\n   464\t    (throw (ex-info \"Unsupported value in executable scalar encoding\"\n   465\t                    {:rule :unsupported-value, :value v}))))\n   220\t\n   221\t\n   222\t(defn- encode-tuple\n   223\t  \"One tuple's bytes: the mnemonic (a `:keyword` scalar) then every\n   224\t   operand under its declared kind, every one of them routed through\n   225\t   `debruijn-code/encode-scalar` -- a `:reg`/`:uint`/`:pc` operand as a\n   226\t   `:long`, `:regs` as a `:vector` of them, `:bool`/`:sym`/`:data`\n   227\t   directly. This reuses B1's encoder for the whole dimension; there is no\n   228\t   operand kind here it does not already cover.\"\n   229\t  [t]\n   230\t  (let [kinds (tuple-kinds t)]\n   231\t    (apply str\n   232\t           (debruijn-code/encode-scalar (mnemonic-of t))\n   233\t           (map-indexed\n   234\t             (fn [i _kind]\n   235\t               (debruijn-code/encode-scalar (nth t (inc i))))\n   236\t             kinds))))\n   237\t\n   238\t\n   239\t(defn encode-instructions\n   240\t  [instructions]\n   241\t  (apply str (map encode-tuple instructions)))\n   242\t\n   243\t\n   244\t(defn- encode-body\n   245\t  [{:keys [locals registers start end]}]\n   246\t  (debruijn-code/encode-scalar [locals registers start end]))\n   247\t\n   248\t\n   249\t(defn encode-register-image\n   250\t  \"The canonical register image's own bytes (design section 3): every\n   251\t   declared body's `[locals registers start end]` in body order, then\n   252\t   every pc-indexed tuple's bytes in pc order -- the two parts design\n   253\t   section 3's table names ('body ranges plus positional instructions').\"\n   254\t  [{:keys [bodies instructions]}]\n   255\t  (str (apply str (map encode-body bodies)) (encode-instructions instructions)))\n   256\t\n   257\t\n   258\t(def descriptor-hash\n   259\t  (jing/blake3 (debruijn-code/encode-scalar descriptor)))\n   260\t\n   261\t\n   262\t(defn register-hash\n   263\t  \"The ONE function that computes R (design section 3): `R = blake3\n   264\t   (register-descriptor-hash || canonical-register-vector)`. Received\n   265\t   register bytes must be hashed before decoding, as B1's wire rule\n   266\t   requires -- no receive path exists in this phase, but this function's\n   267\t   own shape (bytes in, hash out, no host-value peeking) already supports\n   268\t   that later use. R is a derived backend checksum; A is the sole code\n   269\t   identity.\"\n   270\t  [register-image]\n   271\t  (jing/blake3 (str descriptor-hash (encode-register-image register-image))))\n   272\t\n   100\t\n   101\t(def ^:private registry-by-address-id\n   102\t  (into {} (map (fn [[k v]] [(:address-id v) k])) registry))\n   103\t\n   104\t\n   105\t(def ^:private algorithm-id-pattern\n   106\t  \"Algorithm address identifiers are lowercase ASCII alphanumeric strings.\"\n   107\t  #\"[a-z0-9]+\")\n   108\t\n   109\t\n   110\t(def ^:private hex-digit-pattern\n   111\t  #\"[0-9a-f]+\")\n   112\t\n   113\t\n   114\t(defn blake3-bytes\n   115\t  \"BLAKE3 lowercase hex digest of host bytes bs (byte[] on the JVM,\n   116\t   Uint8Array on ClojureScript, Uint8List on Dart).\"\n   117\t  [bs]\n   118\t  #?(:clj (let [b (io.github.rctcwyvrn.blake3.Blake3/newInstance)]\n   119\t            (.update b ^bytes bs)\n   120\t            (.hexdigest b))\n   121\t     :cljs (noble-utils/bytesToHex (noble-blake3/blake3 bs))\n   122\t     :cljd (let [^Uint8List u8 (if (instance? Uint8List bs)\n   123\t                                 bs\n   124\t                                 (Uint8List.fromList bs))]\n   125\t             (blake3-dart/blake3Hex u8))))\n   126\t\n   127\t\n   128\t(defn blake3\n   129\t  \"BLAKE3 lowercase hex digest of the UTF-8 bytes of string s.\"\n   130\t  [s]\n   131\t  #?(:clj (let [b (io.github.rctcwyvrn.blake3.Blake3/newInstance)]\n   132\t            (.update b (.getBytes ^String s \"UTF-8\"))\n   133\t            (.hexdigest b))\n   134\t     :cljs (blake3-bytes (noble-utils/utf8ToBytes s))\n   135\t     :cljd (blake3-bytes (convert/utf8.encode s))))\n   136\t\n   137\t\n   138\t(defn digest-bytes\n   139\t  \"Digest host bytes bs with the specified algorithm keyword (:blake3, :sha256).\n   140\t   Returns lowercase hexadecimal string. Unknown algorithms throw.\"\n   141\t  [algorithm bs]\n   142\t  (case algorithm\n   143\t    :blake3 (blake3-bytes bs)\n   144\t    :sha256 (sha256-bytes bs)\n   145\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   146\t                    {:algorithm algorithm}))))\n   147\t\n   148\t\n   149\t(defn digest-string\n   150\t  \"Digest string s as UTF-8 bytes with the specified algorithm keyword.\n   151\t   Returns lowercase hexadecimal string. Unknown algorithms throw.\"\n   152\t  [algorithm s]\n   153\t  (case algorithm\n   154\t    :blake3 (blake3 s)\n   155\t    :sha256 (sha256 s)\n   156\t    (throw (ex-info (str \"unsupported hash algorithm: \" algorithm)\n   157\t                    {:algorithm algorithm}))))\n   158\t\n   159\t\n   160\t(defn canonical-bytes\n   161\t  \"Return the deterministic CBOR bytes (byte[] / Uint8Array / Uint8List)\n   162\t   of v -- the exact bytes content hashing digests, so\n   163\t   `(digest-bytes algo (canonical-bytes v))` is\n   164\t   `(content-hash v {:algorithm algo})`.\n   165\t   This is the byte form Jing content travels in across a `dao.stream`\n   166\t   boundary.\"\n   167\t  [v]\n   168\t  (cbor/encode v))\n   169\t\n   170\t\n   171\t(defn content-hash\n   172\t  \"Hash the canonical-bytes of v using the specified algorithm (defaulting to\n   173\t   default-hash-algorithm, i.e. :blake3). Returns lowercase hexadecimal string.\n   174\t   Arities: [v] and [v {:keys [algorithm]}].\"\n   175\t  ([v]\n   176\t   (content-hash v {:algorithm default-hash-algorithm}))\n   177\t  ([v opts]\n   178\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)]\n   179\t     (digest-bytes algo (canonical-bytes v)))))\n   180\t\n   181\t\n   182\t(defn segment-key\n   183\t  \"Mint the content-addressed key for an opaque payload, derived solely from\n   184\t   the payload: :segment/<algorithm-id>-<digest>.\n   185\t   The 1-arg form defaults to default-hash-algorithm (:blake3).\n   186\t   The 2-arg form accepts {:algorithm :sha256} (or any registered algorithm).\"\n   187\t  ([v]\n   188\t   (segment-key v {:algorithm default-hash-algorithm}))\n   189\t  ([v opts]\n   190\t   (let [algo (clojure.core/get opts :algorithm default-hash-algorithm)\n   191\t         reg (clojure.core/get registry algo)]\n   192\t     (when-not reg\n   193\t       (throw (ex-info (str \"unsupported hash algorithm: \" algo)\n   194\t                       {:algorithm algo})))\n   195\t     (let [algo-id (:address-id reg)\n   196\t           digest (content-hash v {:algorithm algo})]\n   197\t       (keyword \"segment\" (str algo-id \"-\" digest))))))\n   198\t\n   199\t\n   200\t(defn parse-segment-address\n   201\t  \"The authoritative address parser: requires a `segment` namespace keyword,\n   202\t   splits the name on the first `-` into algorithm identifier and digest,\n   203\t   looks the identifier up by exact match (no prefix matching), validates\n   204\t   digest length from the registry entry and lowercase-hex text, and\n   205\t   reconstructs the canonical address to reject alternative spellings.\n   206\t   Returns {:algorithm :<algo>, :digest \\\"<hex>\\\", :canonical :segment/...}\n   207\t   or nil on any rejection (never throws).\"\n   208\t  [address]\n   209\t  (when (keyword? address)\n   210\t    (when (= \"segment\" (namespace address))\n     1\t(ns dao.jing.cbor\n     2\t  \"DaoJing's canonical CBOR value codec and portable numeric operations\n     3\t   (docs/design/dao.jing.cbor.md, phases J1 and J2: JVM, ClojureScript\n     4\t   and Dart).\n     5\t\n     6\t   `encode` turns one supported value into its canonical payload bytes;\n     7\t   `decode` accepts exactly one canonical payload and returns its value.\n     8\t   The byte contract is the frozen corpus test/resources/dao/jing/cbor-v1.json\n     9\t   and the rulings in its README; this namespace implements it, it does not\n    10\t   define it.\n    11\t\n    12\t   Encoding normalizes a value into a wire tree (see `dao.jing.cbor.boring`)\n    13\t   and lets Boring write the bytes:\n    14\t\n    15\t   * keywords and symbols: tag 27 `dao.jing/keyword` / `dao.jing/symbol`\n    16\t     over `[namespace name]`, read from the identifier's fields;\n    17\t   * lists and finite seqs: tag 27 `dao.jing/list` over the item array;\n    18\t     vectors are plain arrays;\n    19\t   * floating point: tag 27 `dao.jing/float64` over eight big-endian bytes,\n    20\t     float32 widened exactly, every NaN made 7ff8000000000000;\n    21\t   * integers: CBOR integers, tags 2/3 beyond 64 bits;\n    22\t   * decimals: tag 4 `[exponent mantissa]`; ratios: tag 30, reduced;\n    23\t   * sets: tag 258 over elements sorted by their canonical bytes;\n    24\t   * metadata on collections and symbols: tag 27 `clojure/with-meta` over\n    25\t     `[meta value]`, outermost, after stripping unqualified :line :column\n    26\t     :end-line :end-column (validated before stripping) and omitting empty\n    27\t     metadata.\n    28\t\n    29\t   Decoding reads the bytes with Jing's own structural reader, which checks\n    30\t   every tag, frame name and payload shape before any host conversion (the\n    31\t   plan's \\\"validate before any lossy host conversion\\\"), then requires the\n    32\t   decoded value to re-encode to the identical bytes. Boring's decoder is not\n    33\t   used: its native mappings (tag-30 ratios collapsing denominator 1,\n    34\t   stringref and date tags, with-meta, a dropped trailing index frame, and\n    35\t   JavaScript numbers that cannot tell 1.0 from 1) would decide Jing bytes.\n    36\t\n    37\t   Every refusal is an ex-info whose data carries `::refusal`, one of the\n    38\t   corpus refusal classes as a keyword (`:non-canonical`,\n    39\t   `:unpaired-surrogate`, ...); `refusal` reads it.\n    40\t\n    41\t   Numbers: the JVM keeps its native exact kinds (long, BigInt, Double,\n    42\t   BigDecimal, Ratio) and adds a `Rational` carrier for denominator-1\n    43\t   ratios. ClojureScript uses safe-integer numbers and BigInt for integers,\n    44\t   and carriers for float64, decimal and rational content. Host `=` cannot\n    45\t   compare carriers with native numbers symmetrically, so the portable\n    46\t   operations are explicit functions: `num=`, `num-hash`, `num-compare`, and\n    47\t   the recursive `equiv` / `equiv-hash`.\n    48\t\n    49\t   Dart (J2): the same reader, profile and portable operations run on\n    50\t   ClojureDart. The byte writer there is the pinned `cbor` 6.5.1 package\n    51\t   behind `dao.jing.cbor.cljd`, which implements the same wire vocabulary as\n    52\t   `dao.jing.cbor.boring`. Dart integers are 64-bit ints and BigInt, floats\n    53\t   are native doubles (a distinct type from int on the Dart VM), and decimals\n    54\t   and ratios use the Decimal and Rational carriers. Every host reader\n    55\t   conditional names `:cljd` first.\"\n    56\t  (:refer-clojure :exclude [decimal? ratio?])\n    57\t  (:require\n    58\t    #?@(:cljd [[\"dart:convert\" :as convert]\n    59\t               [dao.jing.cbor.cljd :as wire]]\n    60\t        :default [[dao.jing.cbor.boring :as wire]]))\n    61\t  #?@(:cljd [(:import\n    62\t               [\"dart:core\" BigInt FormatException String]\n    63\t               [\"dart:typed_data\" ByteData Uint8List])]\n    64\t      :clj [(:import\n    65\t              (java.math\n    66\t                BigDecimal\n    67\t                BigInteger)\n    68\t              (java.nio\n    69\t                ByteBuffer)\n    70\t              (java.nio.charset\n    71\t                CharacterCodingException\n    72\t                CodingErrorAction\n    73\t                StandardCharsets))]))\n    74\t\n    75\t\n    76\t;; ==========================================================================\n    77\t;; Refusals\n    78\t;; ==========================================================================\n    79\t\n    80\t(defn- refuse\n    81\t  \"Throw the refusal `cls` (a corpus refusal class keyword).\"\n    82\t  ([cls] (refuse cls nil))\n    83\t  ([cls detail]\n    84\t   (throw (ex-info (str \"dao.jing.cbor refused: \" (name cls)\n    85\t                        (when detail (str \" (\" detail \")\")))\n    86\t                   {::refusal cls :detail detail}))))\n    87\t\n    88\t\n    89\t(defn- type-name\n    90\t  \"The host type of x, for refusal details.\"\n    91\t  [x]\n    92\t  #?(:cljd (str (.-runtimeType x))\n    93\t     :default (str (type x))))\n    94\t\n    95\t\n    96\t(defn refusal\n    97\t  \"The refusal class keyword of a thrown codec refusal, or nil.\"\n    98\t  [ex]\n    99\t  (::refusal (ex-data ex)))\n   100\t\n   101\t\n   102\t;; ==========================================================================\n   103\t;; Exact host big integers: BigInteger on the JVM, BigInt on JavaScript\n   104\t;; ==========================================================================\n   105\t\n   106\t#?(:cljs\n   107\t   (defn- bigint?\n   108\t     [x]\n   109\t     (identical? \"bigint\" (js* \"typeof ~{}\" x))))\n   110\t\n   111\t\n   112\t(defn- big\n   113\t  \"An exact host big integer from a host integer or a decimal string.\n   114\t   Anything else (a float, a non-integral number) is refused loudly\n   115\t   rather than truncated.\"\n   116\t  [x]\n   117\t  #?(:cljd (cond (dart/is? x BigInt) x\n   118\t                 (dart/is? x int) (BigInt.from x)\n   119\t                 (string? x) (BigInt.parse x)\n   120\t                 :else (refuse :unsupported-value\n   121\t                               (str \"not an exact integer: \" x)))\n   122\t     :clj (cond (instance? BigInteger x) x\n   123\t                (instance? clojure.lang.BigInt x)\n   124\t                (.toBigInteger ^clojure.lang.BigInt x)\n   125\t                (string? x) (BigInteger. ^String x)\n   126\t                (or (instance? Long x) (instance? Integer x)\n   127\t                    (instance? Short x) (instance? Byte x))\n   128\t                (BigInteger/valueOf (long x))\n   129\t                :else (refuse :unsupported-value\n   130\t                              (str \"not an exact integer: \" (type x))))\n   131\t     :cljs (if (and (number? x) (not (js/Number.isInteger x)))\n   132\t             (refuse :unsupported-value (str \"not an exact integer: \" x))\n   133\t             (js/BigInt x))))\n   134\t\n   135\t\n   136\t(def ^:private zero (big 0))\n   137\t(def ^:private one (big 1))\n   138\t(def ^:private two (big 2))\n   139\t(def ^:private ten (big 10))\n   140\t\n   141\t\n   142\t(defn- b+\n   143\t  [a b]\n   144\t  #?(:cljd (. ^BigInt a \"+\" b)\n   145\t     :clj (.add ^BigInteger a ^BigInteger b)\n   146\t     :cljs (js* \"(~{} + ~{})\" a b)))\n   147\t\n   148\t\n   149\t(defn- b-\n   150\t  [a b]\n   151\t  #?(:cljd (. ^BigInt a \"-\" b)\n   152\t     :clj (.subtract ^BigInteger a ^BigInteger b)\n   153\t     :cljs (js* \"(~{} - ~{})\" a b)))\n   154\t\n   155\t\n    40\t\n    41\t(defn big-carrier?\n    42\t  \"True when `x` is a host big-integer carrier: `clojure.lang.BigInt` or\n    43\t   `BigInteger` on the JVM, a `BigInt` on JS and Dart. On JS and Dart\n    44\t   such a value answers false to `number?`.\"\n    45\t  [x]\n    46\t  #?(:cljd (dart/is? x BigInt)\n    47\t     :clj (or (instance? clojure.lang.BigInt x) (instance? BigInteger x))\n    48\t     :cljs (js-bigint? x)))\n    49\t\n    50\t\n    51\t(defn exact-integer?\n    52\t  \"True when `x` is an exact integer in any carrier the host has: a JVM\n    53\t   `long`, `int`, `short`, `byte`, `BigInt` or `BigInteger`; a JS\n    54\t   safe-integer `Number` other than `-0`, or a `BigInt`; a Dart `int` or\n    55\t   `BigInt`. A float with an integral value is not, except on JS, which\n    56\t   cannot tell `1.0` from `1`.\"\n    57\t  [x]\n    58\t  #?(:cljd (or (dart/is? x int) (dart/is? x BigInt))\n    59\t     :clj (or (instance? Long x) (instance? Integer x) (instance? Short x)\n    60\t              (instance? Byte x) (instance? clojure.lang.BigInt x)\n    61\t              (instance? BigInteger x))\n    62\t     :cljs (or (js-bigint? x)\n    63\t               (and (number? x)\n    64\t                    (js/Number.isSafeInteger x)\n    65\t                    ;; -0 is the one zero whose reciprocal is negative\n    66\t                    (not (and (zero? x) (neg? (/ 1 x))))))))\n    67\t\n    68\t\n    69\t(defn safe-native?\n    70\t  \"True when `x` is a native carrier within +/-(2^53 - 1): a JVM `long`,\n    71\t   a Dart `int`, or exactly the `Number` arm of `exact-integer?` on JS.\n    72\t   Two such values add, subtract and compare natively without rounding\n    73\t   or wrapping on every host.\"\n    74\t  [x]\n    75\t  #?(:cljd (and (dart/is? x int)\n    76\t                (<= -9007199254740991 x)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '295,330p;837,929p;975,1125p;2298,2314p'; nl -ba src/cljc/yin/vm/module.cljc | sed -n '77,112p;160,172p'; nl -ba src/cljc/yin/vm.cljc | sed -n '333,359p'; nl -ba src/cljc/yin/vm/values.cljc | sed -n '123,132p'; rg -n '\"'^'\"\\\\(defn (float64|encode|decode)|sort|duplicate|collision' src/cljc/dao/jing/cbor.cljc | tail -25; rg --files test | rg '(cbor-v1|debruijn.*(code|contract)|jing.*test)' | head -25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/engine.cljc | sed -n '295,330p;837,929p;975,1125p;2298,2314p'; nl -ba src/cljc/yin/vm/module.cljc | sed -n '77,112p;160,172p'; nl -ba src/cljc/yin/vm.cljc | sed -n '333,359p'; nl -ba src/cljc/yin/vm/values.cljc | sed -n '123,132p'; rg -n '\"'^'\"\\\\(defn (float64|encode|decode)|sort|duplicate|collision' src/cljc/dao/jing/cbor.cljc | tail -25; rg --files test | rg '(cbor-v1|debruijn.*(code|contract)|jing.*test)' | head -25\"","aggregated_output":"   295\t;; state alone. Every effect that resolves a program-supplied reference\n   296\t;; verifies the seal first: a literal with a wrong or missing seal fails\n   297\t;; closed with `:forged-resource-reference`.\n   298\t\n   299\t(defn- seal-of\n   300\t  \"The seal of a `kind` reference to resource `id` under `secret`.\"\n   301\t  [secret kind id]\n   302\t  (jing/content-hash [:yin.k/seal secret kind id] {:algorithm :blake3}))\n   303\t\n   304\t\n   305\t(defn- cursor-cell?\n   306\t  \"True when a resource is a cursor cell, `{:stream-id id :cursor c}`.\n   307\t   A cursor cell is the VM's mutable box (with identity) holding one\n   308\t   immutable `dao.stream` cursor; `:stream/next` overwrites its `:cursor`\n   309\t   with the successor. A guest program holds a sealed `:cursor-ref` naming\n   310\t   it, never the cell itself. Not to be confused with `yin.vm.cell`, the\n   311\t   general heap box. Vocabulary: UCF §7.5.3, \\\"Terminology\\\".\"\n   312\t  [resource]\n   313\t  (and (map? resource) (contains? resource :stream-id)))\n   314\t\n   315\t\n   316\t(defn issue-ref\n   317\t  \"A reference of `kind` (`:stream-ref`, `:cursor-ref`, or `:cell-ref`) to\n   318\t   resource or heap cell `id`, sealed under the task's capability secret.\n   319\t   A task composed\n   320\t   without a secret cannot issue one: it fails closed rather than issue a\n   321\t   reference anyone could forge.\"\n   322\t  [state kind id]\n   323\t  (let [secret (:capability-secret state)]\n   324\t    (when (nil? secret)\n   325\t      (fail (str \"This task has no capability secret, so it cannot issue\"\n   326\t                 \" a resource reference\")\n   327\t            {:reason :no-capability-secret, :kind kind, :id id}))\n   328\t    {:type kind, :id id, :seal (seal-of secret kind id)}))\n   329\t\n   330\t\n   837\t  [vm id]\n   838\t  (let [handle (get (:resources vm) id)\n   839\t        d (when (stream/descriptor? handle) (stream/descriptor handle))]\n   840\t    (if (= :dao.stream/ok (outcome d))\n   841\t      {:yin.k/tag :yin.k/stream,\n   842\t       :dao.stream/identity (:dao.stream/identity d),\n   843\t       :dao.stream/descriptor (:dao.stream/descriptor d)}\n   844\t      (non-portable! :in-memory-handle {:yin.k/hint id}))))\n   845\t\n   846\t\n   847\t(defn- cell-for!\n   848\t  \"The logical cursor cell (UCF 7.5.3) the cursor resource `id` of `vm`\n   849\t   lifts to, minted once per lift: two references to one cell share it.\"\n   850\t  [vm found id]\n   851\t  (or (get-in @found [:cell-of id])\n   852\t      (let [cid (keyword \"yin.k\" (str \"c-\" (count (:cells @found))))\n   853\t            cell (get (:resources vm) id)\n   854\t            lifted {:yin.k/stream (stream-marker vm (:stream-id cell)),\n   855\t                    :yin.k/position (:cursor cell)}]\n   856\t        (swap! found #(-> %\n   857\t                          (assoc-in [:cell-of id] cid)\n   858\t                          (assoc-in [:cells cid] lifted)))\n   859\t        cid)))\n   860\t\n   861\t\n   862\t(defn- encoder\n   863\t  \"UCF 7.5.1's `encode` over values of `vm`, recording into `found` every\n   864\t   closure origin segment, module store, and cursor cell the encoding\n   865\t   reaches. A closure lifts through the kernel and names the module store\n   866\t   its body resolves against: its own `:store-of`, or `own` when it has\n   867\t   none -- a closure the child's own body made. A closure or\n   868\t   continuation another task minted refuses as `:foreign-value`: lift is\n   869\t   the only crossing, and only for the owner. Every literal map is\n   870\t   wrapped, a `:type :closure` map included, so a program's data can\n   871\t   never forge a marker. A stream or\n   872\t   cursor reference is authenticated before it is encoded (r11): its seal\n   873\t   and resource kind must verify under the emitter's own secret, or it\n   874\t   refuses as `:forged-resource-reference`; only then is it encoded,\n   875\t   without its seal, as a stream marker or a cell reference. A\n   876\t   continuation, a host object, and an unnamed host function refuse as\n   877\t   UCF 7.5.4 kinds; a heap `:cell-ref` refuses as `:cell` until the heap\n   878\t   slice lifts.\"\n   879\t  [vm own found]\n   880\t  (letfn [(encode\n   881\t            [x]\n   882\t            (cond\n   883\t              (scalar? x) x\n   884\t              ;; Host types before the map arm: a plain map carrying\n   885\t              ;; `:type :closure` is a literal and is wrapped as one.\n   886\t              (values/host-typed? x)\n   887\t              (cond\n   888\t                (not (values/owned-by? x (:owner vm)))\n   889\t                (non-portable! :foreign-value {:yin.k/hint (values/kind-of x)})\n   890\t                (values/closure? x)\n   891\t                (let [marker (module/lift-closure vm (values/payload x) encode)\n   892\t                      m (or (get marker store-of-key) own)]\n   893\t                  (swap! found (fn [acc]\n   894\t                                 (-> acc\n   895\t                                     (update :origins conj\n   896\t                                             (:yin.k/segment marker))\n   897\t                                     (update :stores conj m))))\n   898\t                  (assoc marker store-of-key m))\n   899\t                :else\n   900\t                (non-portable! :non-canonicalizable\n   901\t                               {:yin.k/hint :reified-continuation}))\n   902\t              (map? x)\n   903\t              (case (:type x)\n   904\t                (:stream-ref :cursor-ref)\n   905\t                (cond\n   906\t                  (not (authentic-ref? vm (:type x) x))\n   907\t                  (non-portable! :forged-resource-reference\n   908\t                                 {:yin.k/hint (:type x)})\n   909\t                  (= :stream-ref (:type x)) (stream-marker vm (:id x))\n   910\t                  :else {:yin.k/tag :yin.k/cursor-ref,\n   911\t                         :yin.k/cell (cell-for! vm found (:id x))})\n   912\t                :parked-continuation\n   913\t                (non-portable! :non-canonicalizable {:yin.k/hint (:type x)})\n   914\t                ;; slice 1 refuses every cell-bearing lift; copy-on-lift\n   915\t                ;; of the heap slice is slice 2\n   916\t                :cell-ref\n   917\t                (non-portable! :cell {:yin.k/hint (:id x)})\n   918\t                {:yin.k/tag :yin.k/literal,\n   919\t                 :yin.k/entries (into []\n   920\t                                      (mapcat (fn [[k v]]\n   921\t                                                [(encode k) (encode v)]))\n   922\t                                      x)})\n   923\t              (vector? x) (mapv encode x)\n   924\t              (set? x) (into #{} (map encode) x)\n   925\t              (seq? x) (apply list (map encode x))\n   926\t              (fn? x) (encode-primitive vm x)\n   927\t              :else (non-portable! :host-object\n   928\t                                   {:yin.k/hint\n   929\t                                    #?(:cljd (str (.-runtimeType x))\n   975\t    decode))\n   976\t\n   977\t\n   978\t(defn- markers\n   979\t  \"Every marker tagged `tag` inside the encoded value `x`.\"\n   980\t  [tag x]\n   981\t  (filter #(and (map? %) (= tag (:yin.k/tag %)))\n   982\t          (tree-seq coll? (fn [n] (if (map? n) (vals n) (seq n))) x)))\n   983\t\n   984\t\n   985\t(defn- attach-stream!\n   986\t  \"The handle the composition's `:attach-stream` gives for a stream\n   987\t   marker's descriptor, or `:yin.k/unsatisfied` when it has none or the\n   988\t   attach does not answer `ok`.\"\n   989\t  [state marker]\n   990\t  (let [attach (:attach-stream state)\n   991\t        result (when (fn? attach) (attach (:dao.stream/descriptor marker)))]\n   992\t    (if (= :dao.stream/ok (outcome result))\n   993\t      (:dao.stream/handle result)\n   994\t      (fail \"Stream reference cannot be attached at the receiver\"\n   995\t            {:yin.k/status :yin.k/unsatisfied,\n   996\t             :dao.stream/identity (:dao.stream/identity marker),\n   997\t             :outcome (outcome result)}))))\n   998\t\n   999\t\n  1000\t(defn- lower-resources\n  1001\t  \"Resource lowering (r9): install, in the receiver's private\n  1002\t   `:resources`, an attached handle under a fresh resource id for every\n  1003\t   stream the encoded `values` name -- directly or through a cursor cell\n  1004\t   -- and a cursor cell seeded with its carried position for every cell\n  1005\t   they reference, two references to one cell sharing one entry. No store\n  1006\t   key is ever created. Returns `[state streams cells]`, the id maps the\n  1007\t   decoder remaps references by.\"\n  1008\t  [state values cells]\n  1009\t  (let [used (sort-by str (distinct (map :yin.k/cell\n  1010\t                                         (markers :yin.k/cursor-ref values))))\n  1011\t        lifted (mapv (fn [cid]\n  1012\t                       (or (get cells cid)\n  1013\t                           (fail \"Undecodable value\"\n  1014\t                                 {:yin.k/status :yin.k/undecodable,\n  1015\t                                  :yin.k/cell cid})))\n  1016\t                     used)\n  1017\t        [state streams]\n  1018\t        (reduce (fn [[s acc] marker]\n  1019\t                  (let [ident (:dao.stream/identity marker)]\n  1020\t                    (if (contains? acc ident)\n  1021\t                      [s acc]\n  1022\t                      (let [handle (attach-stream! s marker)\n  1023\t                            [id s] (gensym s \"stream\")]\n  1024\t                        [(assoc-in s [:resources id] handle)\n  1025\t                         (assoc acc ident id)]))))\n  1026\t                [state {}]\n  1027\t                (concat (markers :yin.k/stream values)\n  1028\t                        (map :yin.k/stream lifted)))\n  1029\t        [state cell-ids]\n  1030\t        (reduce (fn [[s acc] [cid cell]]\n  1031\t                  (let [[id s] (gensym s \"cursor\")\n  1032\t                        stream-id (get streams\n  1033\t                                       (get-in cell [:yin.k/stream\n  1034\t                                                     :dao.stream/identity]))]\n  1035\t                    [(assoc-in s [:resources id]\n  1036\t                               (vm/cursor-entry stream-id\n  1037\t                                                (:yin.k/position cell)))\n  1038\t                     (assoc acc cid id)]))\n  1039\t                [state {}]\n  1040\t                (map vector used lifted))]\n  1041\t    [state streams cell-ids]))\n  1042\t\n  1043\t\n  1044\t(defn- encode-store\n  1045\t  [encode store]\n  1046\t  (into {} (map (fn [[k v]] [(encode k) (encode v)])) store))\n  1047\t\n  1048\t\n  1049\t(defn- decode-store\n  1050\t  [decode snapshot]\n  1051\t  (into {} (map (fn [[k v]] [(decode k) (decode v)])) snapshot))\n  1052\t\n  1053\t\n  1054\t(defn lift-slice\n  1055\t  \"Act 1 of `linked` (yin.vm.linker.md section 7.3): the halted child's\n  1056\t   exports and module stores in the portable encoding. `own` is the\n  1057\t   module's manifest address. Returns `{:slice {sym encoded} :stores\n  1058\t   {address snapshot} :cells {cell-id cell} :origins #{segment}}`: one\n  1059\t   snapshot per module -- the child's own store under `own`, and every\n  1060\t   dependency store the encoding reaches as it stands in the child at\n  1061\t   halt, mutations included -- and the logical cursor cells the encoded\n  1062\t   references name. A `:store-of` with no snapshot is\n  1063\t   `:yin.k/non-portable` of kind `:missing-module-store`; any refused leaf\n  1064\t   refuses the lift.\"\n  1065\t  [child own exports]\n  1066\t  (let [found (atom {:origins #{}, :stores #{}, :cells {}, :cell-of {}})\n  1067\t        encode (encoder child own found)\n  1068\t        store (:store child)\n  1069\t        slice (into {} (map (fn [k] [k (encode (get store k))])) exports)\n  1070\t        stores (loop [stores {own (encode-store encode store)}]\n  1071\t                 (let [pending (remove #(contains? stores %)\n  1072\t                                       (sort-by str (:stores @found)))]\n  1073\t                   (if (empty? pending)\n  1074\t                     stores\n  1075\t                     (recur\n  1076\t                       (reduce\n  1077\t                         (fn [acc m]\n  1078\t                           (if-let [s (get-in child [:module-stores m])]\n  1079\t                             (assoc acc m (encode-store encode s))\n  1080\t                             (non-portable! :missing-module-store\n  1081\t                                            {store-of-key m})))\n  1082\t                         stores\n  1083\t                         pending)))))]\n  1084\t    {:slice slice,\n  1085\t     :stores stores,\n  1086\t     :cells (:cells @found),\n  1087\t     :origins (:origins @found)}))\n  1088\t\n  1089\t\n  1090\t(defn receive-module\n  1091\t  \"Acts 3 and 4 of `linked` for one receiving task (yin.vm.linker.md\n  1092\t   section 7.3): attach every origin image of `entry` the kernel does not\n  1093\t   yet hold, non-destructively; lower the resources the slice and the\n  1094\t   snapshots it instantiates reference into the task's private\n  1095\t   `:resources` (r9); lower the slice against this task's own\n  1096\t   coordinates into the entry's `:bindings`, every reference re-sealed\n  1097\t   under this task's secret (r10); and instantiate each store snapshot\n  1098\t   into `:module-stores` unless the task already holds that module's\n  1099\t   store -- first link wins, a live instance is never overwritten.\n  1100\t   Nothing is written into the task's own `:store`. A registry pin\n  1101\t   conflict throws its refusal data before any attachment or lowering.\"\n  1102\t  [state module-name entry]\n  1103\t  (when-let [refusal (module/pin-conflict (:modules state) module-name entry)]\n  1104\t    (throw (ex-info \"Module dependency pin mismatch\" refusal)))\n  1105\t  (let [attached (reduce module/attach-module state\n  1106\t                         (map val (sort-by key (:images entry))))\n  1107\t        held (or (:module-stores attached) {})\n  1108\t        fresh (into {} (remove #(contains? held (key %))) (:stores entry))\n  1109\t        [attached streams cells]\n  1110\t        (lower-resources attached\n  1111\t                         (concat (vals (:slice entry)) (vals fresh))\n  1112\t                         (:cells entry))\n  1113\t        decode (decoder attached streams cells)\n  1114\t        bindings (into {}\n  1115\t                       (map (fn [[k v]] [k (decode v)]))\n  1116\t                       (:slice entry))\n  1117\t        stores (into held\n  1118\t                     (map (fn [[m snapshot]]\n  1119\t                            [m (decode-store decode snapshot)]))\n  1120\t                     fresh)]\n  1121\t    (-> attached\n  1122\t        (assoc :module-stores stores)\n  1123\t        (update :modules module/assoc-module module-name\n  1124\t                (assoc entry :bindings bindings)))))\n  1125\t\n  2298\t    (when (seq run-queue)\n  2299\t      (let [entry (first run-queue)\n  2300\t            rest-queue (subvec run-queue 1)\n  2301\t            updates (:resource-updates entry)\n  2302\t            ;; a woken entry only ever carries engine-minted keyword keys\n  2303\t            ;; (cursor ids)\n  2304\t            _ (when-let [k (some #(when-not (keyword? %) %) (keys updates))]\n  2305\t                (fail \"Ready entry resource update carries a non-minted key\"\n  2306\t                      {:rule :resource-update-key, :key k}))\n  2307\t            base (assoc state\n  2308\t                        :ready-queue rest-queue\n  2309\t                        :resources (merge (:resources state) updates)\n  2310\t                        :blocked? false\n  2311\t                        :halted? false)]\n  2312\t        (if-let [terminal (terminal-resume-outcome entry)]\n  2313\t          (throw-terminal-resume! entry terminal)\n  2314\t          (restore-fn base entry (:value entry)))))))\n    77\t(defn link-module\n    78\t  \"The `linked` transition's registry update (yin.vm.linker.md sections\n    79\t   7.3 and 8.3): `registry` gains the module `manifest` names as the\n    80\t   portable encoding of acts 1 to 3 -- `{:manifest m :address a\n    81\t   :derivation d :slice {sym encoded} :stores {address snapshot} :cells\n    82\t   {cell-id cell} :images {identity image}}` -- never lowered values. `a`\n    83\t   is the manifest's own address; `lifted` is the act-1 lift, `{:slice\n    84\t   :stores :cells :images}`, the cells being the logical cursor cells its\n    85\t   references name (r9) and the images the verified origin images a\n    86\t   receiving task attaches.\n    87\t   Each receiving task lowers the entry into its own `:bindings`.\"\n    88\t  [registry manifest derivation lifted]\n    89\t  (assoc-module registry\n    90\t                (:yin.module/name manifest)\n    91\t                {:manifest manifest,\n    92\t                 :address (jing/segment-key manifest),\n    93\t                 :derivation derivation,\n    94\t                 :slice (:slice lifted),\n    95\t                 :stores (:stores lifted),\n    96\t                 :cells (:cells lifted),\n    97\t                 :images (:images lifted)}))\n    98\t\n    99\t\n   100\t(defn module-entries\n   101\t  \"Every `[name entry]` a registry value holds, the module name read back\n   102\t   from each entry's manifest.\"\n   103\t  [registry]\n   104\t  (letfn [(walk\n   105\t            [node]\n   106\t            (when (map? node)\n   107\t              (if (contains? node :manifest)\n   108\t                [[(:yin.module/name (:manifest node)) node]]\n   109\t                (mapcat walk (vals node)))))]\n   110\t    (vec (walk (:modules registry)))))\n   111\t\n   112\t\n   160\t(defn get-effect-handler\n   161\t  \"Get the handler function for an effect keyword.\"\n   162\t  [registry kw]\n   163\t  (get (:effect-handlers registry) kw))\n   164\t\n   165\t\n   166\t(defn list-modules\n   167\t  \"List the top-level module names in a registry value.\"\n   168\t  [registry]\n   169\t  (keys (:modules registry)))\n   170\t\n   171\t\n   172\t;; =============================================================================\n   333\t     (throw (ex-info \"Divide by zero\" {:divisor y})))\n   334\t   (/ x y))\n   335\t  ([x y & more] (reduce checked-divide (checked-divide x y) more)))\n   336\t\n   337\t\n   338\t(defn primitive-profile\n   339\t  \"Build UCF §7.5.2's published profile record for `name`.\n   340\t\n   341\t   The address covers the name and all four semantic declarations. The name\n   342\t   remains the registry key rather than being duplicated in the returned\n   343\t   record. Profile values contain no host function objects and are therefore\n   344\t   ordinary portable data.\"\n   345\t  [name class arities effects host-state]\n   346\t  (let [description {:yin.k/name name,\n   347\t                     :yin.k/class class,\n   348\t                     :yin.k/arities (vec arities),\n   349\t                     :yin.k/effects (set effects),\n   350\t                     :yin.k/host-state host-state}\n   351\t        digest (jing/content-hash description {:algorithm :blake3})]\n   352\t    {:yin.k/profile (keyword \"yin.k.pp\" (str \"blake3-\" digest)),\n   353\t     :yin.k/class class,\n   354\t     :yin.k/arities (vec arities),\n   355\t     :yin.k/effects (set effects),\n   356\t     :yin.k/host-state host-state}))\n   357\t\n   358\t\n   359\t(defn primitive-function\n   123\t(defn owner-tag\n   124\t  \"The owner tag of the task whose capability secret is `secret`: derived\n   125\t   once, held in VM state, and carried by every closure and continuation\n   126\t   the task mints. It reveals nothing of the secret. A task without a\n   127\t   secret has owner nil.\"\n   128\t  [secret]\n   129\t  (when (some? secret)\n   130\t    (jing/content-hash [:yin.k/owner secret] {:algorithm :blake3})))\n   131\t\n   132\t\n23:   * sets: tag 258 over elements sorted by their canonical bytes;\n294:  \"A string naming the exact bytes bs[start, end), for duplicate checks.\"\n472:(defn float64?\n506:(defn float64\n530:(defn float64-from-bits\n1038:   collection, members at depth d, refusing duplicate canonical encodings\n1058:  (let [wired (members-wire (seq m) false :duplicate-key (inc d))]\n1068:                            :duplicate-element\n1070:    (wire/tagged 258 (mapv second (sort-by first wired)))))\n1140:(defn encode\n1163:(defn encoded-compare\n1395:  \"Refuse duplicate raw encodings among items (dup-class), then\n1490:             (check-members bs (map first v) (map first pairs) :duplicate-key)\n1524:                  (check-members bs items values :duplicate-element)\n1536:(defn decode-snapshot\n1553:(defn decode\ntest/dao/jing_test.cljc\ntest/dao/jing/cbor_conformance_test.cljc\ntest/dao/jing/content_test.cljc\ntest/dao/jing/hash_registry_contract_test.cljc\ntest/dao/jing/file_test.cljc\ntest/dao/jing/mem_test.cljc\ntest/dao/jing/cbor_fixtures_test.cl