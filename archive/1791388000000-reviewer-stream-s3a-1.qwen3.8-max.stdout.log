{"type":"event","event":{"type":"tool_completed","toolCallId":"call_00a466d4d3c5490e8b784efb","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 568 lines\n1: (ns dao.stream.remote-channel-test\n2:   \"The stepped channel composition (dao.stream.remote.md 3.0, 3.1) over\n3:    the in-process loopback net: the descriptor formatted below the\n4:    boundary, resolve and attach, the production profile reaching every\n5:    layer, stream-side liveness (an idle healthy channel against a\n6:    blackholed request, a flood that cannot defer expiry, a lost close\n7:    event recovered by the deadline), explicit stop, lifecycle gaps,\n8:    and the session bounds.\"\n9:   (:require [clojure.test :refer [deftest is testing]]\n10:             [dao.stream :as stream]\n11:             [dao.stream.loopback-net :as net]\n12:             [dao.stream.remote-channel :as rc]\n13:             [dao.stream.ringbuffer :as ringbuffer]\n14:             [dao.stream.ws :as ws]\n15:             [dao.stream.ws-project :as ws-project]))\n16: \n17: \n18: (def ^:private spec {:host \"127.0.0.1\" :port 9 :path \"/x\"})\n19: \n20: \n21: (def ^:private n \"toy\")\n22: \n23: \n24: (defn- ring\n25:   [capacity]\n26:   (:dao.stream/handle\n27:     (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n28:                          ringbuffer/capacity-key capacity})))\n29: \n30: \n31: (defn- values\n32:   [h]\n33:   (loop [c (:dao.stream/cursor (stream/cursor h stream/anchor-oldest))\n34:          acc []]\n35:     (let [r (stream/next h c)]\n36:       (if (= :dao.stream/ok (:dao.stream/outcome r))\n37:         (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n38:         acc))))\n39: \n40: \n41: (defn- identity-of\n42:   [h]\n43:   (:dao.stream/identity (stream/descriptor h)))\n44: \n45: \n46: (defn- toy\n47:   \"The section-5 toy: a one-value ring.\"\n48:   []\n49:   (let [r (ring 16)]\n50:     (stream/append! r :v)\n51:     r))\n52: \n53: \n54: (defn- host-of\n55:   [lnet]\n56:   {:connect! (net/connect-on lnet)\n57:    :bind! (net/listen-on lnet)\n58:    :unbind! (net/unbind-on lnet)})\n59: \n60: \n61: (defn- serve\n62:   ([lnet source] (serve lnet source {} (host-of lnet)))\n63:   ([lnet source bounds] (serve lnet source bounds (host-of lnet)))\n64:   ([_lnet source bounds host]\n65:    (rc/serve {:spec spec :host host\n66:               :table {(identity-of source) {:handle source :surface #{:reader}}}\n67:               :names {n (identity-of source)}\n68:               :bounds bounds})))\n69: \n70: \n71: (defn- dial\n72:   ([lnet] (dial lnet {} nil))\n73:   ([lnet bounds events]\n74:    (rc/dial {:spec spec :host (host-of lnet) :name n :bounds bounds\n75:              :events events})))\n76: \n77: \n78: (defn- world\n79:   \"A served toy and one dial, as atoms the driver steps.\"\n80:   ([] (world {}))\n81:   ([bounds]\n82:    (let [lnet (net/loopback-net)\n83:          source (toy)\n84:          events (ring 64)]\n85:      {:net lnet :source source :events events\n86:       :server (atom (serve lnet source bounds))\n87:       :dials [(atom (dial lnet bounds events))]})))\n88: \n89: \n90: (defn- tick!\n91:   \"One driver turn at `now`: the net, the server, every dial, the net.\"\n92:   [{:keys [net server dials]} now]\n93:   (net/pump! net)\n94:   (swap! server rc/serve-step now)\n95:   (doseq [d dials] (swap! d rc/dial-step now))\n96:   (net/pump! net))\n97: \n98: \n99: (defn- run-until\n100:   \"Tick from `now` by `dt` until `done?` or `limit` ticks; answers the\n101:    last `now` ticked.\"\n102:   [w now dt limit done?]\n103:   (loop [now now left limit]\n104:     (tick! w now)\n105:     (if (or (done?) (zero? left))\n106:       now\n107:       (recur (+ now dt) (dec left)))))\n108: \n109: \n110: (defn- settle\n111:   \"Ask `op` until it answers neither blocked nor a retryable error,\n112:    ticking the world at `now` between asks.\"\n113:   [w now op]\n114:   (loop [left 50]\n115:     (let [r (op)]\n116:       (if (and (pos? left)\n117:                (or (= :dao.stream/blocked (:dao.stream/outcome r))\n118:                    (true? (:dao.stream/retry? r))))\n119:         (do (tick! w now) (recur (dec left)))\n120:         r))))\n121: \n122: \n123: (defn- first-dial\n124:   [w]\n125:   (first (:dials w)))\n126: \n127: \n128: (defn- attach!\n129:   \"Drive `w` at `now` until its first dial is attached; answers the\n130:    handle.\"\n131:   [w now]\n132:   (let [d (first-dial w)]\n133:     (run-until w now 0 50 #(not= :resolving (:status @d)))\n134:     (rc/handle @d)))\n135: \n136: \n137: (defn- read-past-value\n138:   \"Read the toy's one value through `h`; answers the cursor after it.\"\n139:   [w now h]\n140:   (let [c (settle w now #(stream/cursor h stream/anchor-oldest))\n141:         r (settle w now #(stream/next h (:dao.stream/cursor c)))]\n142:     (is (= :v (:dao.stream/value r)) (pr-str r))\n143:     (:dao.stream/cursor r)))\n144: \n145: \n146: (defn- ws-handle\n147:   [d]\n148:   (:handle (ws-project/channel (:dial d))))\n149: \n150: \n151: (defn- expired-events\n152:   [events]\n153:   (filterv #(= :dao.stream.remote/channel-expired (:dao.stream.remote/event %))\n154:            (values events)))\n155: \n156: \n157: (def ^:private channel-gone\n158:   {:dao.stream/outcome :dao.stream/transport-error\n159:    :dao.stream.remote/reason :dao.stream.remote/channel-gone})\n160: \n161: \n162: ;; =============================================================================\n163: ;; Address data and attachment\n164: ;; =============================================================================\n165: \n166: (deftest serve-formats-the-descriptor-below-the-boundary\n167:   (let [lnet (net/loopback-net)\n168:         expected {:dao.stream/type :dao.stream/ws\n169:                   :dao.stream/identity \"ws://127.0.0.1:9/x\"\n170:                   :ws/host \"127.0.0.1\"\n171:                   :ws/port 9\n172:                   :ws/path \"/x\"}]\n173:     (is (= expected (rc/descriptor-of spec)))\n174:     (is (ws/descriptor? (rc/descriptor-of spec)))\n175:     (is (= expected (:descriptor (serve lnet (toy)))))\n176:     (is (not-any? #(= \"ws\" (namespace %)) (keys spec)) \"no :ws/ key in the spec\")\n177:     (testing \"loopback literals\"\n178:       (is (every? rc/loopback-literal? [\"127.0.0.1\" \"127.1.2.3\" \"::1\" \"[::1]\"]))\n179:       (is (not-any? rc/loopback-literal?\n180:                     [\"0.0.0.0\" \"localhost\" \"127.0.0.1.\" \"128.0.0.1\" \"\" nil])))))\n181: \n182: \n183: (deftest a-reader-resolves-and-attaches-over-the-stepped-composition\n184:   (let [w (world)\n185:         d (first-dial w)]\n186:     (is (= :starting (:status @(:server w))))\n187:     (is (= :resolving (:status @d)))\n188:     (let [h (attach! w 0)]\n189:       (is (= :serving (:status @(:server w))))\n190:       (is (= :attached (:status @d)) (pr-str (:outcome @d)))\n191:       (is (= (identity-of (:source w)) (:identity @d)))\n192:       (is (= (identity-of (:source w)) (identity-of h)))\n193:       (read-past-value w 0 h))))\n194: \n195: \n196: (deftest production-bounds-reach-every-layer\n197:   (let [lnet (net/loopback-net)\n198:         server (rc/serve {:spec spec :host (host-of lnet)\n199:                           :table {\"s\" {:handle (toy) :surface #{:reader}}}})\n200:         endpoint (:endpoint server)\n201:         d (rc/dial {:spec spec :host (host-of lnet) :name n})\n202:         p rc/production-bounds]\n203:     (is (= 20 (count p)))\n204:     (is (= {:max-sessions 64 :idle-timeout 60000 :step-budget 64\n205:             :mirror-budget 64 :chase-budget 32}\n206:            (select-keys @(:acceptor server)\n207:                         [:max-sessions :idle-timeout :step-budget\n208:                          :mirror-budget :chase-budget])))\n209:     (is (= {:ws/max-frame-bytes 4194304 :ws/max-pending-frames 64\n210:             :ws/max-pending-bytes 1048576 :ws/outbound-high-water 4194304\n211:             :ws/max-outbound-bytes 16777216}\n212:            (:bounds endpoint)))\n213:     (is (= 15000 (:expiry-ms (:config endpoint))))\n214:     (is (= 8 (count (:slots (ws/endpoint-state endpoint)))))\n215:     (is (= {:dao.stream.remote/budget 8\n216:             :dao.stream.remote/resend-after nil\n217:             :dao.stream.remote/drain-budget 256\n218:             :dao.stream.remote/max-outstanding 256\n219:             :dao.stream.remote/max-filed 1024\n220:             :dao.stream.remote/give-up-after 15000}\n221:            (:policy @(:dial d))))\n222:     (is (= {:step-budget 64 :mirror-budget 64 :chase-budget 32}\n223:            (select-keys @(:dial d) [:step-budget :mirror-budget :chase-budget])))\n224:     (testing \"an invalid bound is the validating layer's composition error\"\n225:       (let [lnet (net/loopback-net)]\n226:         (doseq [b [{:max-sessions 0} {:ws/max-frame-bytes -1}\n227:                    {:dao.stream.remote/give-up-after 0}]]\n228:           (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n229:                        (serve lnet (toy) b))\n230:               (pr-str b)))\n231:         (is (empty? (:listeners @lnet)) \"nothing listened\")))))\n232: \n233: \n234: ;; =============================================================================\n235: ;; Stream-side liveness\n236: ;; =============================================================================\n237: \n238: (def ^:private liveness {:dao.stream.remote/give-up-after 150})\n239: \n240: \n241: (defn- poll!\n242:   \"The reader's poll: one next from `c`.\"\n243:   [h c]\n244:   (stream/next h c))\n245: \n246: \n247: (defn- ask!\n248:   \"Poll past the prefetched blocked the read of the value installed, so\n249:    a next request is on the wire; answers the last poll's outcome.\"\n250:   [h c]\n251:   (poll! h c)\n252:   (poll! h c))\n253: \n254: \n255: (deftest idle-healthy-board-versus-blackholed-request\n256:   (testing \"healthy: every poll is answered, nothing expires\"\n257:     (let [w (world liveness)\n258:           d (first-dial w)\n259:           h (attach! w 0)\n260:           c (read-past-value w 0 h)]\n261:       (doseq [i (range 20)]\n262:         (poll! h c)\n263:         (tick! w (* 50 (inc i))))\n264:       (is (= :attached (:status @d)))\n265:       (is (empty? (expired-events (:events w))))))\n266:   (testing \"blackholed: the request expires at give-up-after\"\n267:     (let [w (world liveness)\n268:           d (first-dial w)\n269:           h (attach! w 0)\n270:           c (read-past-value w 0 h)]\n271:       (net/blackhole! (:net w) :client)\n272:       (tick! w 1000)\n273:       (ask! h c)\n274:       (tick! w 1100)\n275:       (is (= :attached (:status @d)) \"not before the deadline\")\n276:       (tick! w 1150)\n277:       (tick! w 1160)\n278:       (is (= :lost (:status @d)))\n279:       (is (= channel-gone (:outcome @d)))\n280:       (let [es (expired-events (:events w))]\n281:         (is (= 1 (count es)))\n282:         (is (= :dao.stream/next (:dao.stream.remote/op (first es)))))\n283:       (is (= :dao.stream/closed\n284:              (:dao.stream/outcome (stream/append! (ws-handle @d) :x)))\n285:           \"the ws handle is closed\"))))\n286: \n287: \n288: (deftest unrelated-traffic-flood-cannot-defer-expiry\n289:   (let [w (world (assoc liveness :dao.stream.remote/drain-budget 4))\n290:         d (first-dial w)\n291:         h (attach! w 0)\n292:         c (read-past-value w 0 h)]\n293:     (net/blackhole! (:net w) :client)\n294:     (tick! w 1000)\n295:     (ask! h c)\n296:     (doseq [now [1050 1100 1149]]\n297:       (net/flood! (:net w) 500)\n298:       (tick! w now))\n299:     (is (= :attached (:status @d)) \"not before the deadline\")\n300:     (net/flood! (:net w) 500)\n301:     (tick! w 1150)\n302:     (is (= 1 (count (expired-events (:events w)))) \"expired at the deadline tick\")\n303:     (tick! w 1160)\n304:     (is (= :lost (:status @d)))\n305:     (is (= channel-gone (:outcome @d)))))\n306: \n307: \n308: (deftest a-lost-close-event-is-recovered-by-the-deadline\n309:   (let [w (world (assoc liveness :capacity 8))\n310:         d (first-dial w)\n311:         h (attach! w 0)\n312:         c (read-past-value w 0 h)\n313:         traffic (:dao.stream/handle (:traffic @(:dial @d)))]\n314:     (tick! w 1000)\n315:     (ask! h c)\n316:     ;; The connection closes before the request is delivered, and the\n317:     ;; client's traffic medium is full of unread events, so :ws/closed is\n318:     ;; evicted before the projection reads it.\n319:     (doseq [conn (:conns @(:net w))] (net/close-conn! conn 1006 \"gone\"))\n320:     (dotimes [i 8]\n321:       (stream/append! traffic {:ws/attachment \"other\" :ws/event :ws/payload\n322:                                :ws/value i}))\n323:     (tick! w 1050)\n324:     (is (not (ws-project/closed? (:project (ws-project/channel (:dial @d)))))\n325:         \"the ring stays open: the close event was lost\")\n326:     (is (= :attached (:status @d)))\n327:     (tick! w 1150)\n328:     (tick! w 1160)\n329:     (is (= :lost (:status @d)) \"the deadline recovers the lost close\")\n330:     (is (= channel-gone (:outcome @d)))\n331:     (is (= :dao.stream.remote/channel-gone\n332:            (:dao.stream.remote/reason (ask! h c))))))\n333: \n334: \n335: ;; =============================================================================\n336: ;; Explicit stop\n337: ;; =============================================================================\n338: \n339: (defn- counting-unbind\n340:   [lnet calls]\n341:   (let [f (net/unbind-on lnet)]\n342:     (fn [listener deposit!]\n343:       (swap! calls inc)\n344:       (f listener deposit!))))\n345: \n346: \n347: (deftest stop-is-explicit-and-driver-paced\n348:   (let [lnet (net/loopback-net)\n349:         source (ring 16)\n350:         calls (atom 0)\n351:         host (assoc (host-of lnet) :unbind! (counting-unbind lnet calls))\n352:         w {:net lnet :server (atom (serve lnet source {} host))\n353:            :dials [(atom (dial lnet))]}\n354:         d (first-dial w)\n355:         h (attach! w 0)\n356:         c (:dao.stream/cursor (settle w 0 #(stream/cursor h stream/anchor-oldest)))\n357:         reader-ws (ws-handle @d)\n358:         late (atom (dial lnet))]\n359:     (is (= 1 (count (rc/sessions @(:server w)))))\n360:     ;; A second connection reaches the endpoint, unacknowledged.\n361:     (swap! late rc/dial-step 0)\n362:     (net/pump! lnet)\n363:     (is (= 1 (count (filter #(= :pending (:status %))\n364:                             (:slots (ws/endpoint-state (:endpoint @(:server w))))))))\n365:     ;; The reader asks; the request reaches the server before stop.\n366:     (stream/append! source :value)\n367:     (poll! h c)\n368:     (net/pump! lnet)\n369:     (swap! (:server w) rc/stop!)\n370:     (is (= :stopping (:status @(:server w))))\n371:     (is (= {:since nil :outcome nil} (:stop @(:server w))))\n372:     (is (= 0 @calls) \"stop! performs no I/O\")\n373:     (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! reader-ws :still-open)))\n374:         \"the reader's connection is still open\")\n375:     (swap! (:server w) rc/serve-step 10)\n376:     (is (= 10 (get-in @(:server w) [:stop :since])))\n377:     (is (= 1 @calls) \"unbind! called once\")\n378:     (is (every? #(= :free (:status %))\n379:                 (:slots (ws/endpoint-state (:endpoint @(:server w)))))\n380:         \"slots free\")\n381:     (is (every? :closed? (vals (rc/sessions @(:server w)))) \"sessions closed\")\n382:     (net/pump! lnet)\n383:     (swap! d rc/dial-step 10)\n384:     (is (= :value (:dao.stream/value (poll! h c)))\n385:         \"the outstanding next was answered in the last pass\")\n386:     (is (= :lost (:status @d)) \"the reader saw its connection close\")\n387:     (is (every? (comp deref :closed?) (:conns @lnet))\n388:         \"the session and the pending connection are closed\")\n389:     (is (some #(= :ws/closed (:ws/event %))\n390:               (values (:dao.stream/handle\n391:                         (:control (ws/endpoint-state (:endpoint @(:server w)))))))\n392:         \"the pending connection's :ws/closed reached the control medium\")\n393:     (swap! (:server w) rc/serve-step 20)\n394:     (is (= :stopped (:status @(:server w))))\n395:     (is (= {:since 10 :outcome :confirmed} (:stop @(:server w))))\n396:     (is (empty? (rc/sessions @(:server w))))\n397:     (is (= 1 @calls))))\n398: \n399: \n400: (deftest stop-completes-without-a-close-callback\n401:   (let [lnet (net/loopback-net)\n402:         host (assoc (host-of lnet) :unbind! (fn [_ _] {:dao.stream/outcome :dao.stream/ok}))\n403:         server (-> (serve lnet (toy) {:stop-grace-ms 100} host)\n404:                    (rc/serve-step 0)\n405:                    rc/stop!\n406:                    (rc/serve-step 1000))]\n407:     (is (= :stopping (:status server)))\n408:     (is (= :stopping (:status (rc/serve-step server 1099))) \"never earlier\")\n409:     (let [s (rc/serve-step server 1100)]\n410:       (is (= :stopped (:status s)))\n411:       (is (= {:since 1000 :outcome ::rc/unconfirmed} (:stop s)))))\n412:   (testing \"an unbind! that fails is stopped at once\"\n413:     (let [lnet (net/loopback-net)\n414:           host (assoc (host-of lnet) :unbind! (fn [_ _] (throw (ex-info \"no\" {}))))\n415:           s (-> (serve lnet (toy) {} host) (rc/serve-step 0) rc/stop! (rc/serve-step 5))]\n416:       (is (= :stopped (:status s)))\n417:       (is (= ::rc/unbind-failed (get-in s [:stop :outcome]))))))\n418: \n419: \n420: (deftest stop-while-starting-and-stop-twice-are-idempotent\n421:   (let [lnet (net/loopback-net)\n422:         quiet (fn [opts] {:dao.stream/outcome :dao.stream/ok :port (:bind-port opts)})\n423:         host (assoc (host-of lnet) :bind! quiet)\n424:         server (serve lnet (toy) {} host)\n425:         _ (is (= :starting (:status server)))\n426:         stopping (rc/stop! server)]\n427:     (is (= :stopping