(fn [tag]\n530:                  {:send! #(do (swap! sent conj %) nil)\n531:                   :close! (fn [code reason] (swap! closes conj [tag code reason]))})\n532:         a (ws/accept-connection! endpoint \"/yin/repl\" (socket :a))\n533:         b (ws/accept-connection! endpoint \"/yin/repl\" (socket :b))]\n534:     (is (= [:ws/pending :ws/pending] (mapv :ws/status [a b])))\n535:     (is (= endpoint (ws/endpoint-stop! endpoint)))\n536:     (is (= #{[:a 1001 \"dao.stream/endpoint-stopped\"]\n537:              [:b 1001 \"dao.stream/endpoint-stopped\"]}\n538:            (set @closes))\n539:         \"both seams saw 1001 endpoint-stopped\")\n540:     (is (= #{[(:ws/attachment a) :ws/closed] [(:ws/attachment b) :ws/closed]}\n541:            (set (map (juxt :ws/attachment :ws/event) (values control))))\n542:         \"both terminal events on the control medium\")\n543:     (is (= [:free :free] (mapv :status (:slots (ws/endpoint-state endpoint)))))\n544:     (is (empty? (:connections (ws/endpoint-state endpoint))))\n545:     ;; A late acknowledgement for a stopped connection is stale.\n546:     (let [traffic (buffer)]\n547:       (stream/append! (get-in slots [0 :ack :dao.stream/handle])\n548:                       {:ws/attachment (:ws/attachment a) :ws/command :ws/accept\n549:                        :ws/deposit {:dao.stream/handle traffic :dao.stream/surface #{:writer}}\n550:                        :ws/admission admission})\n551:       (ws/endpoint-step endpoint 1)\n552:       (is (empty? (values traffic)))\n553:       (is (= :dao.stream/closed\n554:              (:dao.stream/outcome (stream/append! (:ws/handle a) :late))))\n555:       (is (empty? @sent)))\n556:     ;; A second endpoint-stop! is a no-op.\n557:     (ws/endpoint-stop! endpoint)\n558:     (is (= 2 (count @closes)))\n559:     (is (= 2 (count (values control))))))"}]},{"type":"tool_result","tool_use_id":"call_0aca8a2928934aa582d78aea","content":[{"type":"text","text":"Read 1/1 file, 74 lines\n880:        