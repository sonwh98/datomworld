rc/dial-step 0)\n472:     (net/pump! lnet)\n473:     (is (= 1 (count (filter #(= :pending (:status %))\n474:                             (:slots (ws/endpoint-state (:endpoint server)))))))\n475:     (dotimes [i 70] ((:deposit! server) :listener-error {:i i}))\n476:     (let [s (rc/serve-step server 1)]\n477:       (is (= :refused (:status s)))\n478:       (is (= ::rc/lifecycle-lost (:reason s)))\n479:       (is (= 1 @calls) \"unbind! called\")\n480:       (is (every? #(= :free (:status %))\n481:                   (:slots (ws/endpoint-state (:endpoint s))))\n482:           \"the endpoint has no pending slot\"))))\n483: \n484: \n485: (deftest a-host-that-stops-under-us-is-stopped-host-stopped\n486:   (let [w (world)\n487:         d (first-dial w)\n488:         _ (attach! w 0)\n489:         sessions (rc/sessions @(:server w))]\n490:     (is (= 1 (count sessions)))\n491:     (net/unlisten! (:net w) (:port spec))\n492:     (swap! (:server w) rc/serve-step 1)\n493:     (is (= :stopped (:status @(:server w))))\n494:     (is (= ::rc/host-stopped (get-in @(:server w) [:stop :outcome])))\n495:     (is (every? :closed? (vals (rc/sessions @(:server w)))) \"sessions closed\")\n496:     (doseq [[_ s] sessions]\n497:       (is (= :dao.stream/closed\n498:              (:dao.stream/outcome (stream/append! (:ring s) :x)))))\n499:     (net/pump! (:net w))\n500:     (swap! d rc/dial-step 1)\n501:     (is (= :lost (:status @d)))))\n502: \n503: \n504: ;; =============================================================================\n505: ;; Session bounds under the profile\n506: ;; =============================================================================\n507: \n508: (deftest session-cap-and-idle-expiry-hold-under-the-profile\n509:   (let [lnet (net/loopback-net)\n510:         source (toy)\n511:         bounds {:max-sessions 2 :idle-timeout 100}\n512:         w {:net lnet :server (atom (serve lnet source bounds))\n513:            :dials (vec (repeatedly 3 #(atom (dial lnet bounds nil)