{"type":"event","event":{"type":"tool_completed","toolCallId":"call_93f2d631fb9c4f57b032e3bf","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 147 lines\n1: (ns dao.stream.loopback-net\n2:   \"An in-process loopback net: a stand-in for the host listener and\n3:    connect seams of the `yin.repl.host` shape -- `listen-on` is a\n4:    `:bind!`, `unbind-on` an `:unbind!`, `connect-on` a `:connect!` of the\n5:    `dao.stream.ws/make-attacher` shape -- carrying each encoded frame\n6:    between the two ends' `dao.stream.ws/adapter`s through a queue the\n7:    test pumps, so every host runs the same composition\n8:    deterministically.  `blackhole!` drops the frames toward one side;\n9:    `flood!` delivers unrelated value frames to the clients.\"\n10:   (:require [dao.stream.transit :as transit]\n11:             [dao.stream.ws :as ws]))\n12: \n13: \n14: (defn loopback-net\n15:   \"Listeners by port, live connections, the queue of frames and\n16:    lifecycle calls in flight, and the blackholed sides.\"\n17:   []\n18:   (atom {:listeners {} :queue [] :conns [] :blackholed #{}}))\n19: \n20: \n21: (defn enqueue!\n22:   \"Put `f` in flight; nil, as a host send! that accepted the frame\n23:    answers.\"\n24:   [net f]\n25:   (swap! net update :queue conj f)\n26:   nil)\n27: \n28: \n29: (defn pump!\n30:   \"Run everything in flight, including what running it puts in flight.\"\n31:   [net]\n32:   (loop []\n33:     (let [q (:queue @net)]\n34:       (when (seq q)\n35:         (swap! net assoc :queue [])\n36:         (doseq [f q] (f))\n37:         (recur)))))\n38: \n39: \n40: (defn- deliver!\n41:   [adapter payload]\n42:   (if (string? payload)\n43:     ((:message! adapter) payload)\n44:     ((:binary! adapter) payload)))\n45: \n46: \n47: (defn- blackholed?\n48:   [net side]\n49:   (contains? (:blackholed @net) side))\n50: \n51: \n52: (defn blackhole!\n53:   \"From now on, frames toward `side` (:client or :server) are accepted\n54:    by the sender's send! and dropped.\"\n55:   [net side]\n56:   (swap! net update :blackholed conj side)\n57:   nil)\n58: \n59: \n60: (defn listen-on\n61:   \"The `:bind!` seam over `net`: a port already listened on throws, as\n62:    a host bind does.\"\n63:   [net]\n64:   (fn [{:keys [bind-host bind-port accept! deposit!]}]\n65:     (when (contains? (:listeners @net) bind-port)\n66:       (throw (ex-info \"address in use\" {:port bind-port})))\n67:     (swap! net assoc-in [:listeners bind-port]\n68:            {:accept! accept! :deposit! deposit!})\n69:     (deposit! :bind-succeeded {:host bind-host :port bind-port})\n70:     {:dao.stream/outcome :dao.stream/ok :port bind-port}))\n71: \n72: \n73: (defn unbind-on\n74:   \"The `:unbind!` seam over `net`: the listener is released at once and\n75:    its close completion deposits `:stopped` once the net is pumped.\n76:    Connections it accepted are the composition's to close.\"\n77:   [net]\n78:   (fn [listener deposit!]\n79:     (swap! net update :listeners dissoc (:port listener))\n80:     (enqueue! net #(deposit! :stopped {:port (:port listener)}))\n81:     {:dao.stream/outcome :dao.stream/ok}))\n82: \n83: \n84: (defn close-conn!\n85:   [conn code reason]\n86:   (when-not @(:closed? conn)\n87:     (reset! (:closed? conn) true)\n88:     (when-some [s @(:server conn)] ((:closed! s) code reason))\n89:     ((:closed! (:client conn)) code reason)))\n90: \n91: \n92: (defn unlisten!\n93:   \"The host listener at `port` goes away under the composition: every\n94:    connection it accepted closes and the listener deposits `:stopped`.\"\n95:   [net port]\n96:   (let [conns (filterv #(= port (:port %)) (:conns @net))\n97:         l (get-in @net [:listeners port])]\n98:     (swap! net update :listeners dissoc port)\n99:     (doseq [c conns] (close-conn! c 1001 \"going away\"))\n100:     (when l\n101:       ((:deposit! l) :stopped {:port port}))))\n102: \n103: \n104: (defn connect-on\n105:   \"The `:connect!` seam over `net`.\"\n106:   [net]\n107:   (fn [descriptor client]\n108:     (let [conn {:port (:ws/port descriptor)\n109:                 :client client\n110:                 :server (atom nil)\n111:                 :closed? (atom false)}]\n112:       (swap! net update :conns conj conn)\n113:       (enqueue! net\n114:                 (fn []\n115:                   (if-some [l (get-in @net [:listeners (:ws/port descriptor)])]\n116:                     (let [socket {:send! (fn [p]\n117:                                            (enqueue! net\n118:                                                      #(when-not (or @(:closed? conn)\n119:                                                                     (blackholed? net :client))\n120:                                                         (deliver! client p))))\n121:                                   :close! (fn [code reason]\n122:                                             (enqueue! net\n123:                                                       #(close-conn!\n124:                                                          conn code reason)))}\n125:                           r ((:accept! l) (:ws/path descriptor) socket 0)]\n126:                       (when-some [h (:ws/handle r)]\n127:                         (reset! (:server conn) (ws/adapter h))\n128:                         ((:opened! client))))\n129:                     (close-conn! conn 1006 \"connection refused\"))))\n130:       {:send! (fn [p]\n131:                 (enqueue! net #(when-not (or @(:closed? conn)\n132:                                              (blackholed? net :server))\n133:                                  (when-some [s @(:server conn)]\n134:                                    (deliver! s p)))))\n135:        :close! (fn [code reason]\n136:                  (enqueue! net #(close-conn! conn code reason)))})))\n137: \n138: \n139: (defn flood!\n140:   \"Deliver `n` unrelated value frames to the client of every live\n141:    connection, at once, past any blackhole.\"\n142:   [net n]\n143:   (doseq [conn (:conns @net)\n144:           :when (not @(:closed? conn))\n145:           i (range n)]\n146:     (deliver! (:client conn)\n147:               (transit/encode {:ws/frame :ws/value :ws/value {:junk i}}))))"}],"deferred":false}}
