====\n467: \n468: (defn dial\n469:   \"Compose the dialing end of one WebSocket channel (3.1). `:attach!`\n470:    is the dao.stream.ws/make-attacher product whose :traffic deposit\n471:    medium is the same medium named by `:traffic` (its target), with\n472:    `:cursor` already minted on it before any attach!; `:ring` is the\n473:    channel ring buffer this end projects onto. `:table` names the\n474:    identities this peer serves over the dialed channel, so\n475:    `dial-step!` runs the projection and then this end's own mirror\n476:    step: the dialing end serves the other direction on the same\n477:    connection. `dial-attach!` takes a remote descriptor whose\n478:    :dao.stream/channel is this channel's ws descriptor: it attaches,\n479:    projects the attachment onto the ring, and answers through\n480:    dao.stream.remote/attacher with the channel end {:reader ring\n481:    :writer handle} -- the link's drain then runs inside every\n482:    reflection operation. One dial value carries one active\n483:    attachment; a reattachment composes a fresh dial with a fresh\n484:    cursor, as dao.stream.ws.md composes one medium per active client\n485:    attachment. `:names`, optional, is the name map beside `:table`\n486:    that this end's mirror answers named requests from. `dial-resolve!`\n487:    resolves a name through the dialed channel before any reflection\n488:    exists. :dao.stream.remote/events, :dao.stream.remote/resend-after,\n489:    :dao.stream.remote/budget, :dao.stream.remote/drain-budget,\n490:    :dao.stream.remote/max-outstanding, :dao.stream.remote/max-filed and\n491:    :dao.stream.remote/give-up-after pass to the attacher as its policy.\n492:    `:step-budget`, `:mirror-budget` and `:chase-budget`, optional\n493:    positive integers or nil, bound `dial-step!`'s projection and\n494:    mirror per tick, as for make-acceptor.\"\n495:   [{:keys [attach! traffic cursor ring table names step-budget\n496:            mirror-budget chase-budget] :as opts}]\n497:   (when-not (and (fn? attach!)\n498:                  (map? traffic)\n499:                  (stream/writer? (:dao.stream/handle traffic))\n500:                  (stream/reader? (:dao.stream/handle traffic))\n501:                  (some? cursor)\n502:                  (stream/reader? ring)\n503:                  (stream/writer? ring)\n504:                  (stream/closable? ring)\n505:                  (map? table)\n506:                  (or (nil? names) (map? names))\n507:                  (pos-int-or-nil? step-budget)\n508:                  (pos-int-or-nil? mirror-budget)\n509:                  (pos-int-or-nil? chase-budget))\n510:     (throw (ex-info \"invalid DaoStream ws dial composition\"\n511:                     {:opts opts})))\n512:   (let [channel (atom nil)\n513:         mirror-cursor (atom (:dao.stream/cursor\n514:                               (stream/cursor ring stream/anchor-oldest)))\n515:         policy (select-keys opts [:dao.stream.remote/events\n516:                                   :dao.stream.remote/resend-after\n517:                                   :dao.stream.remote/budget\n518:                                   :dao.stream.remote/drain-budget\n519:                                   :dao.stream.remote/max-outstanding\n520:                                   :dao.stream.remote/max-filed\n521:                                   :dao.stream.remote/give-up-after])]\n522:     (atom {:attach! attach! :traffic traffic :cursor cursor :ring ring\n523:            :table table :names names :channel channel\n524:            :mirror-cursor mirror-cursor :policy policy\n525:            :step-budget step-budget :mirror-budget mirror-budget\n526:            :chase-budget chase-budget})))\n527: \n528: \n529: (defn- establish!\n530:   \"The ws attach of the channel descriptor `cd`, the attachment's\n531:    projection onto the ring, and the remote links over the channel end\n532:    {:reader ring :writer handle}, recorded as the dial's one channel.\n533:    Nil once established; a channel attach that fails answers the ws\n534:    attacher's own outcome and records nothing. A dial already stepped\n535:    at a `now` steps the new link at it first, so the requests the\n536:    attachment sends at once carry deadlines.\"\n537:   [dial cd]\n538:   (let [{:keys [attach! traffic cursor ring channel policy now]} @dial\n539:         r (attach! cd)]\n540:     (if-not (= :dao.stream/ok (:dao.stream/outcome r))\n541:       r\n542:       (let [handle (:dao.stream/handle r)\n543:             ls (remote/links\n544:                  (merge policy\n545:                         {:dao.stream.remote/channels\n546:                          {cd {:reader ring :writer handle}}}))]\n547:         (when (some? now)\n548:           ((:step ls) cd now))\n549:         (reset! channel {:cd cd\n550:                          :attachment (:dao.stream/attachment r)\n551:                          :handle handle\n552:                          :project (projection\n553:                                     {:attachment (:dao.stream/attachment r)\n554:                                      :traffic (:dao.stream/handle traffic)\n555:                                      :cursor cursor\n556:                                      :ring ring})\n557:                          :reflect! (:attach ls)\n558:                          :resolve! (:resolve ls)\n559:                          :step! (:step ls)})\n560:         nil))))\n561: \n562: \n563: (defn dial-attach!\n564:   \"Attach one reflection of `descriptor` (a :dao.stream/remote\n565:    descriptor) through the dialed channel: the ws attach runs first,\n566:    the attachment's projection is composed, and the remote attacher\n567:    answers with the reflection -- its confirmation deferred, per\n568:    dao.stream.remote.md 2.4, to the descriptor probe the link sends\n569:    now. A channel attach that fails answers the ws attacher's own\n570:    outcome. One dial value carries one active attachment: a dial that\n571:    has already attached rejects a further dial-attach! -- its ring\n572:    and traffic cursor already belong to the first attachment, and a\n573:    second projection on them would mix two attachments' state -- with\n574:    a composition error; a reattachment composes a fresh dial with a\n575:    fresh cursor, as `dial` documents. Returns the remote attach!\n576:    result.\"\n577:   [dial descriptor]\n578:   (let [{:keys [channel]} @dial]\n579:     (when-some [attached @channel]\n580:       (throw (ex-info\n581:                \"this dial already attached its one active attachment\"\n582:                {:attachment (:attachment attached)\n583:                 :reattachment \"compose a fresh dial with a fresh cursor\"})))\n584:     (or (establish! dial (:dao.stream/channel descriptor))\n585:         ((:reflect! @channel) descriptor))))\n586: \n587: \n588: (defn dial-resolve!\n589:   \"Resolve the name `n` through the dial's channel, the ws descriptor\n590:    `cd`: dao.stream.remote's link resolve (dao.stream.remote.md 2.4).\n591:    A dial with no channel yet attaches `cd` first, as `dial-attach!`\n592:    does, so a name is resolved before any reflection exists; the\n593:    descriptor a resolve answers is then attached through the same\n594:    channel by `dial-reflect!`. A channel attach that fails answers the\n595:    ws attacher's own outcome. Answers the resolve's outcome: retry\n596:    until the answer is filed, then ok with the remote descriptor and\n597:    surface, or transport-error naming not-found or channel-gone.\"\n598:   [dial cd n]\n599:   (let [{:keys [channel]} @dial]\n600:     (or (when (nil? @channel) (establish! dial cd))\n601:         ((:resolve! @channel) cd n))))\n602: \n603: \n604: (defn dial-reflect!\n605:   \"Attach a further reflection of `descriptor` through a dial's already\n606:    established channel, sharing the one link `dial-attach!` created for\n607:    it: dao.stream.remote.cljc keeps one link per channel descriptor,\n608:    shared by every reflection through that channel, and `attacher`'s\n609:    returned function is exactly that per-channel sharing boundary.  A\n610:    dial with no established channel yet answers `:dao.stream/invalid-\n611:    descriptor`, since there is no attacher to share.\"\n612:   [dial descriptor]\n613:   (let [{:keys [channel]} @dial]\n614:     (if-some [reflect! (:reflect! @channel)]\n615:       (reflect! descriptor)\n616:       {:dao.stream/outcome :dao.stream/invalid-descriptor})))\n617: \n618: \n619: (defn dial-step!\n620:   \"Drive the dialing composition one tick, at the composition's\n621:    cadence: the attachment's projection first, so what the wire\n622:    deposited reaches the ring, then this end's own mirror step over\n623:    the projected reader and the socket handle, answering the other\n624:    direction's requests against this end's table, each bounded by the\n625:    dial's :step-budget, :mirror-budget and :chase-budget. Given the\n626:    driver's `now`, the link is stepped at it between the two\n627:    (dao.stream.remote.md 2.4, Expiry); when a request is past its\n628:    deadline the channel is lost and the dial, which owns the\n629:    connection, closes the ws handle -- the host then deposits\n630:    :ws/closed and the projection closes the ring. Without `now`\n631:    nothing expires. Returns the mirror's advanced reading cursor.\"\n632:   ([dial]\n633:    (dial-step! dial nil))\n634:   ([dial now]\n635:    (when (some? now)\n636:      (swap! dial assoc :now now))\n637:    (let [{:keys [ring table names channel mirror-cursor step-budget]\n638:           :as d} @dial\n639:          ch @channel]\n640:      (when-some [project (:project ch)]\n641:        (step! project step-budget))\n642:      (let [stepped (when (and (some? now) (:step! ch))\n643:                      ((:step! ch) (:cd ch) now))]\n644:        (when-some [handle (:handle ch)]\n645:          ;; The mirror's effects run once, outside any atom update: the\n646:          ;; driver alone steps the dial, as accept-step! does.\n647:          (reset! mirror-cursor\n648:                  (remote/mirror-step table names ring @mirror-cursor handle\n649:                                      (mirror-bounds d)))\n650:          (when (:dao.stream.remote/channel-gone? stepped)\n651:            (swap! channel assoc :gone? true)\n652:            (when (stream/closable? handle)\n653:              (stream/close! handle)))))\n654:      @mirror-cursor)))\n655: \n656: \n657: (defn channel\n658:   \"The dialed channel as data: {:attachment id :handle h :project p\n659:    :gone? g} -- the ws attachment identity, the ws handle (the channel\n660:    writer), the attachment's projection, and whether a stepped link\n661:    found the channel gone. Nil before the first dial-attach!. A\n662:    composition that owns the connection's lifetime closes the handle\n663:    here.\"\n664:   [dial]\n665:   @(:channel @dial))"}]}],"meta":{"source":"tool","messageId":"8142be7f-67bb-4b55-8455-cf65f152956b"}},{"role":"assistant","content":[{"type":"thinking","thinking":"Alright, let me look at the diffs of the modified files to confirm what specifically changed relative to master. Since shell access is restricted, maybe I can use `git diff` via read... actually the shell is being blocked. Hmm, but read-only git commands are allowed? The message said \"read-only commands (ls, grep, git log/diff/status, ...) can be executed even in plan mode.\" But both of my attempts were rejected. Maybe the rejection was because of `-C` or `&&`? The first command was `git -C ... status && git -C ... diff --stat`, and the second attempt was `git diff --stat` with cwd specified, which gave a different error: \"requires permissions... use --yolo\". So it seems all shell commands are being blocked. I'll proceed with read_file only.\n\nNext, let me read the tests. remote_channel_test.cljc, loopback_net.cljc, and the test cases added to ws_test/ws_project_test. Let me check the sizes.","signature":""},{"type":"text","text":"Source looks coherent so far. Now the tests — the loopback net fixture and the remote-channel test.\n\n"},{"type":"tool_use","id":"call_93f2d631fb9c4f57b032e3bf","name":"read_file","input":{"file_path":"/Users/sto/workspace/datomworld-stream-s3a/test/dao/stream/loopback_net.cljc"}}],"meta":{"source":"model","createdAt":1791393001500,"messageId":"4a9b549b-c8b6-48f2-aef6-5584546935fa"}},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_93f2d631fb9c4f57b032e3bf","content":[{"type":"text","text":"Read 1/1 file, 147 lines\n1: (ns dao.stream.loopback-net\n2:   \"An in-process loopback net: a stand-in for the host listener and\n3:    connect seams of the `yin.repl.host` shape -- `listen-on` is a\n4:    `:bind!`, `unbind-on` an `:unbind!`, `connect-on` a `:connect!` of the\n5:    `dao.stream.ws/make-attacher` shape -- carrying each encoded frame\n6:    between the two ends' `dao.stream.ws/adapter`s through a queue the\n7:    test pumps, so every host runs the same composition\n8:    deterministically.  `blackhole!` drops the frames toward one side;\n9:    `flood!` delivers unrelated value frames to the clients.\"\n10:   (:require [dao.stream.transit :as transit]\n11:             [dao.stream.ws :as ws]))\n12: \n13: \n14: (defn loopback-net\n15:   \"Listeners by port, live connections, the queue of frames and\n16:    lifecycle calls in flight, and the blackholed sides.\"\n17:   []\n18:   (atom {:listeners {} :queue [] :conns [] :blackholed #{}}))\n19: \n20: \n21: (defn enqueue!\n22:   \"Put `f` in flight; nil, as a host send! that accepted the frame\n23:    answers.\"\n24:   [net f]\n25:   (swap! net update :queue conj f)\n26:   nil)\n27: \n28: \n29: (defn pump!\n30:   \"Run everything in flight, including what running it puts in flight.\"\n31:   [net]\n32:   (loop []\n33:     (let [q (:queue @net)]\n34:       (when (seq q)\n35:         (swap! net assoc :queue [])\n36:         (doseq [f q] (f))\n37:         (recur)))))\n38: \n39: \n40: (defn- deliver!\n41:   [adapter payload]\n42:   (if (string? payload)\n43:     ((:message! adapter) payload)\n44:     ((:binary! adapter) payload)))\n45: \n46: \n47: (defn- blackholed?\n48:   [net side]\n49:   (contains? (:blackholed @net) side))\n50: \n51: \n52: (defn blackhole!\n53:   \"From now on, frames toward `side` (:client or :server) are accepted\n54:    by the sender's send! and dropped.\"\n55:   [net side]\n56:   (swap! net update :blackholed conj side)\n57:   nil)\n58: \n59: \n60: (defn listen-on\n61:   \"The `:bind!` seam over `net`: a port already listened on throws, as\n62:    a host bind does.\"\n63:   [net]\n64:   (fn [{:keys [bind-host bind-port accept! deposit!]}]\n65:     (when (contains? (:listeners @net) bind-port)\n66:       (throw (ex-info \"address in use\" {:port bind-port})))\n67:     (swap! net assoc-in [:listeners bind-port]\n68:            {:accept! accept! :deposit! deposit!})\n69:     (deposit! :bind-succeeded {:host bind-host :port bind-port})\n70:     {:dao.stream/outcome :dao.stream/ok :port bind-port}))\n71: \n72: \n73: (defn unbind-on\n74:   \"The `:unbind!` seam over `net`: the listener is released at once and\n75:    its close completion deposits `:stopped` once the net is pumped.\n76:    Connections it accepted are the composition's to close.\"\n77:   [net]\n78:   (fn [listener deposit!]\n79:     (swap! net update :listeners dissoc (:port listener))\n80:     (enqueue! net #(deposit! :stopped {:port (:port listener)}))\n81:     {:dao.stream/outcome :dao.stream/ok}))\n82: \n83: \n84: (defn close-conn!\n85:   [conn code reason]\n86:   (when-not @(:closed? conn)\n87:     (reset! (:closed? conn) true)\n88:     (when-some [s @(:server conn)] ((:closed! s) code reason))\n89:     ((:closed! (:client conn)) code reason)))\n90: \n91: \n92: (defn unlisten!\n93:   \"The host listener at `port` goes away under the composition: every\n94:    connection it accepted closes and the listener deposits `:stopped`.\"\n95:   [net port]\n96:   (let [conns (filterv #(= port (:port %)) (:conns @net))\n97:         l (get-in @net [:listeners port])]\n98:     (swap! net update :listeners dissoc port)\n99:     (doseq [c conns] (close-conn! c 1001 \"going away\"))\n100:     (when l\n101:       ((:deposit! l) :stopped {:port port}))))\n102: \n103: \n104: (defn connect-on\n105:   \"The `:connect!` seam over `net`.\"\n106:   [net]\n107:   (fn [descriptor client]\n108:     (let [conn {:port (:ws/port descriptor)\n109:                 :client client\n110:                 :server (atom nil)\n111:                 :closed? (atom false)}]\n112:       (swap! net update :conns conj conn)\n113:       (enqueue! net\n114:                 (fn []\n115:                   (if-some [l (get-in @net [:listeners (:ws/port descriptor)])]\n116:                     (let [socket {:send! (fn [p]\n117:                                            (enqueue! net\n118:                                                      #(when-not (or @(:closed? conn)\n119:                                                                     (blackholed? net :client))\n120:                                                         (deliver! client p))))\n121:                                   :close! (fn [code reason]\n122:                                             (enqueue! net\n123:                                                       #(close-conn!\n124:                                                          conn code reason)))}\n125:                           r ((:accept! l) (:ws/path descriptor) socket 0)]\n126:                       (when-some [h (:ws/handle r)]\n127:                         (reset! (:server conn) (ws/adapter h))\n128:                         ((:opened! client))))\n129:                     (close-conn! conn 1006 \"connection refused\"))))\n130:       {:send! (fn [p]\n131:                 (enqueue! net #(when-not (or @(:closed? conn)\n132:                                              (blackholed? net :server))\n133:                                  (when-some [s @(:server conn)]\n134:                                    (deliver! s p)))))\n135:        :close! (fn [code reason]\n136:                  (enqueue! net #(close-conn! conn code reason)))})))\n137: \n138: \n139: (defn flood!\n140:   \"Deliver `n` unrelated value frames to the client of every live\n141:    connection, at once, past any blackhole.\"\n142:   [net n]\n143:   (doseq [conn (:conns @net)\n144:           :when (not @(:closed? conn))\n145:           i (range n)]\n146:     (deliver! (:client conn)\n147:               (transit/encode {:ws/frame :ws/value :ws/value {:junk i}}))))"}]}],"meta":{"source":"tool","messageId":"27522e1e-1ee8-4ead-ac8e-dc93bcfd81aa"}},{"role":"assistant","content":[{"type":"thinking","thinking":"Note: `close-conn!` closes the server side first and then closes the client. If the server is nil (not accepted), it only closes the client. Also, flood! delivers directly to the client's adapter — bypassing the black hole (\"past any black hole\").\n\nNext up is remote_channel_test.cljc. Probably long. Let's read it.\n","signature":""},{"type":"tool_use","id":"call_00a466d4d3c5490e8b784efb","name":"read_file","input":{"file_path":"/Users/sto/workspace/datomworld-stream-s3a/test/dao/stream/remote_channel_test.cljc"}}],"meta":{"source":"model","createdAt":1791393010130,"messageId":"06d05a2a-4cae-4e38-8ed2-d90a2105a6d7"}},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_00a466d4d3c5490e8b784efb","content":[{"type":"text","text":"Read 1/1 file, 568 lines\n1: (ns dao.stream.remote-channel-test\n2:   \"The stepped channel composition (dao.stream.remote.md 3.0, 3.1) over\n3:    the in-process loopback net: the descriptor formatted below the\n4:    boundary, resolve and attach, the production profile reaching every\n5:    layer, stream-side liveness (an idle healthy channel against a\n6:    blackholed request, a flood that cannot defer expiry, a lost close\n7:    event recovered by the deadline), explicit stop, lifecycle gaps,\n8:    and the session bounds.\"\n9:   (:require [clojure.test :refer [deftest is testing]]\n10:             [dao.stream :as stream]\n11:             [dao.stream.loopback-net :as net]\n12:             [dao.stream.remote-channel :as rc]\n13:             [dao.stream.ringbuffer :as ringbuffer]\n14:             [dao.stream.ws :as ws]\n15:             [dao.stream.ws-project :as ws-project]))\n16: \n17: \n18: (def ^:private spec {:host \"127.0.0.1\" :port 9 :path \"/x\"})\n19: \n20: \n21: (def ^:private n \"toy\")\n22: \n23: \n24: (defn- ring\n25:   [capacity]\n26:   (:dao.stream/handle\n27:     (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n28:                          ringbuffer/capacity-key capacity})))\n29: \n30: \n31: (defn- values\n32:   [h]\n33:   (loop [c (:dao.stream/cursor (stream/cursor h stream/anchor-oldest))\n34:          acc []]\n35:     (let [r (stream/next h c)]\n36:       (if (= :dao.stream/ok (:dao.stream/outcome r))\n37:         (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n38:         acc))))\n39: \n40: \n41: (defn- identity-of\n42:   [h]\n43:   (:dao.stream/identity (stream/descriptor h)))\n44: \n45: \n46: (defn- toy\n47:   \"The section-5 toy: a one-value ring.\"\n48:   []\n49:   (let [r (ring 16)]\n50:     (stream/append! r :v)\n51:     r))\n52: \n53: \n54: (defn- host-of\n55:   [lnet]\n56:   {:connect! (net/connect-on lnet)\n57:    :bind! (net/listen-on lnet)\n58:    :unbind! (net/unbind-on lnet)})\n59: \n60: \n61: (defn- serve\n62:   ([lnet source] (serve lnet source {} (host-of lnet)))\n63:   ([lnet source bounds] (serve lnet source bounds (host-of lnet)))\n64:   ([_lnet source bounds host]\n65:    (rc/serve {:spec spec :host host\n66:               :table {(identity-of source) {:handle source :surface #{:reader}}}\n67:               :names {n (identity-of source)}\n68:               :bounds bounds})))\n69: \n70: \n71: (defn- dial\n72:   ([lnet] (dial lnet {} nil))\n73:   ([lnet bounds events]\n74:    (rc/dial {:spec spec :host (host-of lnet) :name n :bounds bounds\n75:              :events events})))\n76: \n77: \n78: (defn- world\n79:   \"A served toy and one dial, as atoms the driver steps.\"\n80:   ([] (world {}))\n81:   ([bounds]\n82:    (let [lnet (net/loopback-net)\n83:          source (toy)\n84:          events (ring 64)]\n85:      {:net lnet :source source :events events\n86:       :server (atom (serve lnet source bounds))\n87:       :dials [(atom (dial lnet bounds events))]})))\n88: \n89: \n90: (defn- tick!\n91:   \"One driver turn at `now`: the net, the server, every dial, the net.\"\n92:   [{:keys [net server dials]} now]\n93:   (net/pump! net)\n94:   (swap! server rc/serve-step now)\n95:   (doseq [d dials] (swap! d rc/dial-step now))\n96:   (net/pump! net))\n97: \n98: \n99: (defn- run-until\n100:   \"Tick from `now` by `dt` until `done?` or `limit` ticks; answers the\n101:    last `now` ticked.\"\n102:   [w now dt limit done?]\n103:   (loop [now now left limit]\n104:     (tick! w now)\n105:     (if (or (done?) (zero? left))\n106:       now\n107:       (recur (+ now dt) (dec left)))))\n108: \n109: \n110: (defn- settle\n111:   \"Ask `op` until it answers neither blocked nor a retryable error,\n112:    ticking the world at `now` between asks.\"\n113:   [w now op]\n114:   (loop [left 50]\n115:     (let [r (op)]\n116:       (if (and (pos? left)\n117:                (or (= :dao.stream/blocked (:dao.stream/outcome r))\n118:                    (true? (:dao.stream/retry? r))))\n119:         (do (tick! w now) (recur (dec left)))\n120:         r))))\n121: \n122: \n123: (defn- first-dial\n124:   [w]\n125:   (first (:dials w)))\n126: \n127: \n128: (defn- attach!\n129:   \"Drive `w` at `now` until its first dial is attached; answers the\n130:    handle.\"\n131:   [w now]\n132:   (let [d (first-dial w)]\n133:     (run-until w now 0 50 #(not= :resolving (:status @d)))\n134:     (rc/handle @d)))\n135: \n136: \n137: (defn- read-past-value\n138:   \"Read the toy's one value through `h`; answers the cursor after it.\"\n139:   [w now h]\n140:   (let [c (settle w now #(stream/cursor h stream/anchor-oldest))\n141:         r (settle w now #(stream/next h (:dao.stream/cursor c)))]\n142:     (is (= :v (:dao.stream/value r)) (pr-str r))\n143:     (:dao.stream/cursor r)))\n144: \n145: \n146: (defn- ws-handle\n147:   [d]\n148:   (:handle (ws-project/channel (:dial d))))\n149: \n150: \n151: (defn- expired-events\n152:   [events]\n153:   (filterv #(= :dao.stream.remote/channel-expired (:dao.stream.remote/event %))\n154:            (values events)))\n155: \n156: \n157: (def ^:private channel-gone\n158:   {:dao.stream/outcome :dao.stream/transport-error\n159:    :dao.stream.remote/reason :dao.stream.remote/channel-gone})\n160: \n161: \n162: ;; =============================================================================\n163: ;; Address data and attachment\n164: ;; =============================================================================\n165: \n166: (deftest serve-formats-the-descriptor-below-the-boundary\n167:   (let [lnet (net/loopback-net)\n168:         expected {:dao.stream/type :dao.stream/ws\n169:                   :dao.stream/identity \"ws://127.0.0.1:9/x\"\n170:                   :ws/host \"127.0.0.1\"\n171:                   :ws/port 9\n172:                   :ws/path \"/x\"}]\n173:     (is (= expected (rc/descriptor-of spec)))\n174:     (is (ws/descriptor? (rc/descriptor-of spec)))\n175:     (is (= expected (:descriptor (serve lnet (toy)))))\n176:     (is (not-any? #(= \"ws\" (namespace %)) (keys spec)) \"no :ws/ key in the spec\")\n177:     (testing \"loopback literals\"\n178:       (is (every? rc/loopback-literal? [\"127.0.0.1\" \"127.1.2.3\" \"::1\" \"[::1]\"]))\n179:       (is (not-any? rc/loopback-literal?\n180:                     [\"0.0.0.0\" \"localhost\" \"127.0.0.1.\" \"128.0.0.1\" \"\" nil])))))\n181: \n182: \n183: (deftest a-reader-resolves-and-attaches-over-the-stepped-composition\n184:   (let [w (world)\n185:         d (first-dial w)]\n186:     (is (= :starting (:status @(:server w))))\n187:     (is (= :resolving (:status @d)))\n188:     (let [h (attach! w 0)]\n189:       (is (= :serving (:status @(:server w))))\n190:       (is (= :attached (:status @d)) (pr-str (:outcome @d)))\n191:       (is (= (identity-of (:source w)) (:identity @d)))\n192:       (is (= (identity-of (:source w)) (identity-of h)))\n193:       (read-past-value w 0 h))))\n194: \n195: \n196: (deftest production-bounds-reach-every-layer\n197:   (let [lnet (net/loopback-net)\n198:         server (rc/serve {:spec spec :host (host-of lnet)\n199:                           :table {\"s\" {:handle (toy) :surface #{:reader}}}})\n200:         endpoint (:endpoint server)\n201:         d (rc/dial {:spec spec :host (host-of lnet) :name n})\n202:         p rc/production-bounds]\n203:     (is (= 20 (count p)))\n204:     (is (= {:max-sessions 64 :idle-timeout 60000 :step-budget 64\n205:             :mirror-budget 64 :chase-budget 32}\n206:            (select-keys @(:acceptor server)\n207:                         [:max-sessions :idle-timeout :step-budget\n208:                          :mirror-budget :chase-budget])))\n209:     (is (= {:ws/max-frame-bytes 4194304 :ws/max-pending-frames 64\n210:             :ws/max-pending-bytes 1048576 :ws/outbound-high-water 4194304\n211:             :ws/max-outbound-bytes 16777216}\n212:            (:bounds endpoint)))\n213:     (is (= 15000 (:expiry-ms (:config endpoint))))\n214:     (is (= 8 (count (:slots (ws/endpoint-state endpoint)))))\n215:     (is (= {:dao.stream.remote/budget 8\n216:             :dao.stream.remote/resend-after nil\n217:             :dao.stream.remote/drain-budget 256\n218:             :dao.stream.remote/max-outstanding 256\n219:             :dao.stream.remote/max-filed 1024\n220:             :dao.stream.remote/give-up-after 15000}\n221:            (:policy @(:dial d))))\n222:     (is (= {:step-budget 64 :mirror-budget 64 :chase-budget 32}\n223:            (select-keys @(:dial d) [:step-budget :mirror-budget :chase-budget])))\n224:     (testing \"an invalid bound is the validating layer's composition error\"\n225:       (let [lnet (net/loopback-net)]\n226:         (doseq [b [{:max-sessions 0} {:ws/max-frame-bytes -1}\n227:                    {:dao.stream.remote/give-up-after 0}]]\n228:           (is (thrown? #?(:clj Exception :cljs :default :cljd Object)\n229:                        (serve lnet (toy) b))\n230:               (pr-str b)))\n231:         (is (empty? (:listeners @lnet)) \"nothing listened\")))))\n232: \n233: \n234: ;; =============================================================================\n235: ;; Stream-side liveness\n236: ;; =============================================================================\n237: \n238: (def ^:private liveness {:dao.stream.remote/give-up-after 150})\n239: \n240: \n241: (defn- poll!\n242:   \"The reader's poll: one next from `c`.\"\n243:   [h c]\n244:   (stream/next h c))\n245: \n246: \n247: (defn- ask!\n248:   \"Poll past the prefetched blocked the read of the value installed, so\n249:    a next request is on the wire; answers the last poll's outcome.\"\n250:   [h c]\n251:   (poll! h c)\n252:   (poll! h c))\n253: \n254: \n255: (deftest idle-healthy-board-versus-blackholed-request\n256:   (testing \"healthy: every poll is answered, nothing expires\"\n257:     (let [w (world liveness)\n258:           d (first-dial w)\n259:           h (attach! w 0)\n260:           c (read-past-value w 0 h)]\n261:       (doseq [i (range 20)]\n262:         (poll! h c)\n263:         (tick! w (* 50 (inc i))))\n264:       (is (= :attached (:status @d)))\n265:       (is (empty? (expired-events (:events w))))))\n266:   (testing \"blackholed: the request expires at give-up-after\"\n267:     (let [w (world liveness)\n268:           d (first-dial w)\n269:           h (attach! w 0)\n270:           c (read-past-value w 0 h)]\n271:       (net/blackhole! (:net w) :client)\n272:       (tick! w 1000)\n273:       (ask! h c)\n274:       (tick! w 1100)\n275:       (is (= :attached (:status @d)) \"not before the deadline\")\n276:       (tick! w 1150)\n277:       (tick! w 1160)\n278:       (is (= :lost (:status @d)))\n279:       (is (= channel-gone (:outcome @d)))\n280:       (let [es (expired-events (:events w))]\n281:         (is (= 1 (count es)))\n282:         (is (= :dao.stream/next (:dao.stream.remote/op (first es)))))\n283:       (is (= :dao.stream/closed\n284:              (:dao.stream/outcome (stream/append! (ws-handle @d) :x)))\n285:           \"the ws handle is closed\"))))\n286: \n287: \n288: (deftest unrelated-traffic-flood-cannot-defer-expiry\n289:   (let [w (world (assoc liveness :dao.stream.remote/drain-budget 4))\n290:         d (first-dial w)\n291:         h (attach! w 0)\n292:         c (read-past-value w 0 h)]\n293:     (net/blackhole! (:net w) :client)\n294:     (tick! w 1000)\n295:     (ask! h c)\n296:     (doseq [now [1050 1100 1149]]\n297:       (net/flood! (:net w) 500)\n298:       (tick! w now))\n299:     (is (= :attached (:status @d)) \"not before the deadline\")\n300:     (net/flood! (:net w) 500)\n301:     (tick! w 1150)\n302:     (is (= 1 (count (expired-events (:events w)))) \"expired at the deadline tick\")\n303:     (tick! w 1160)\n304:     (is (= :lost (:status @d)))\n305:     (is (= channel-gone (:outcome @d)))))\n306: \n307: \n308: (deftest a-lost-close-event-is-recovered-by-the-deadline\n309:   (let [w (world (assoc liveness :capacity 8))\n310:         d (first-dial w)\n311:         h (attach! w 0)\n312:         c (read-past-value w 0 h)\n313:         traffic (:dao.stream/handle (:traffic @(:dial @d)))]\n314:     (tick! w 1000)\n315:     (ask! h c)\n316:     ;; The connection closes before the request is delivered, and the\n317:     ;; client's traffic medium is full of unread events, so :ws/closed is\n318:     ;; evicted before the projection reads it.\n319:     (doseq [conn (:conns @(:net w))] (net/close-conn! conn 1006 \"gone\"))\n320:     (dotimes [i 8]\n321:       (stream/append! traffic {:ws/attachment \"other\" :ws/event :ws/payload\n322:                                :ws/value i}))\n323:     (tick! w 1050)\n324:     (is (not (ws-project/closed? (:project (ws-project/channel (:dial @d)))))\n325:         \"the ring stays open: the close event was lost\")\n326:     (is (= :attached (:status @d)))\n327:     (tick! w 1150)\n328:     (tick! w 1160)\n329:     (is (= :lost (:status @d)) \"the deadline recovers the lost close\")\n330:     (is (= channel-gone (:outcome @d)))\n331:     (is (= :dao.stream.remote/channel-gone\n332:            (:dao.stream.remote/reason (ask! h c))))))\n333: \n334: \n335: ;; =============================================================================\n336: ;; Explicit stop\n337: ;; =============================================================================\n338: \n339: (defn- counting-unbind\n340:   [lnet calls]\n341:   (let [f (net/unbind-on lnet)]\n342:     (fn [listener deposit!]\n343:       (swap! calls inc)\n344:       (f listener deposit!))))\n345: \n346: \n347: (deftest stop-is-explicit-and-driver-paced\n348:   (let [lnet (net/loopback-net)\n349:         source (ring 16)\n350:         calls (atom 0)\n351:         host (assoc (host-of lnet) :unbind! (counting-unbind lnet calls))\n352:         w {:net lnet :server (atom (serve lnet source {} host))\n353:            :dials [(atom (dial lnet))]}\n354:         d (first-dial w)\n355:         h (attach! w 0)\n356:         c (:dao.stream/cursor (settle w 0 #(stream/cursor h stream/anchor-oldest)))\n357:         reader-ws (ws-handle @d)\n358:         late (atom (dial lnet))]\n359:     (is (= 1 (count (rc/sessions @(:server w)))))\n360:     ;; A second connection reaches the endpoint, unacknowledged.\n361:     (swap! late rc/dial-step 0)\n362:     (net/pump! lnet)\n363:     (is (= 1 (count (filter #(= :pending (:status %))\n364:                             (:slots (ws/endpoint-state (:endpoint @(:server w))))))))\n365:     ;; The reader asks; the request reaches the server before stop.\n366:     (stream/append! source :value)\n367:     (poll! h c)\n368:     (net/pump! lnet)\n369:     (swap! (:server w) rc/stop!)\n370:     (is (= :stopping (:status @(:server w))))\n371:     (is (= {:since nil :outcome nil} (:stop @(:server w))))\n372:     (is (= 0 @calls) \"stop! performs no I/O\")\n373:     (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! reader-ws :still-open)))\n374:         \"the reader's connection is still open\")\n375:     (swap! (:server w) rc/serve-step 10)\n376:     (is (= 10 (get-in @(:server w) [:stop :since])))\n377:     (is (= 1 @calls) \"unbind! called once\")\n378:     (is (every? #(= :free (:status %))\n379:                 (:slots (ws/endpoint-state (:endpoint @(:server w)))))\n380:         \"slots free\")\n381:     (is (every? :closed? (vals (rc/sessions @(:server w)))) \"sessions closed\")\n382:     (net/pump! lnet)\n383:     (swap! d rc/dial-step 10)\n384:     (is (= :value (:dao.stream/value (poll! h c)))\n385:         \"the outstanding next was answered in the last pass\")\n386:     (is (= :lost (:status @d)) \"the reader saw its connection close\")\n387:     (is (every? (comp deref :closed?) (:conns @lnet))\n388:         \"the session and the pending connection are closed\")\n389:     (is (some #(= :ws/closed (:ws/event %))\n390:               (values (:dao.stream/handle\n391:                         (:control (ws/endpoint-state (:endpoint @(:server w)))))))\n392:         \"the pending connection's :ws/closed reached the control medium\")\n393:     (swap! (:server w) rc/serve-step 20)\n394:     (is (= :stopped (:status @(:server w))))\n395:     (is (= {:since 10 :outcome :confirmed} (:stop @(:server w))))\n396:     (is (empty? (rc/sessions @(:server w))))\n397:     (is (= 1 @calls))))\n398: \n399: \n400: (deftest stop-completes-without-a-close-callback\n401:   (let [lnet (net/loopback-net)\n402:         host (assoc (host-of lnet) :unbind! (fn [_ _] {:dao.stream/outcome :dao.stream/ok}))\n403:         server (-> (serve lnet (toy) {:stop-grace-ms 100} host)\n404:                    (rc/serve-step 0)\n405:                    rc/stop!\n406:                    (rc/serve-step 1000))]\n407:     (is (= :stopping (:status server)))\n408:     (is (= :stopping (:status (rc/serve-step server 1099))) \"never earlier\")\n409:     (let [s (rc/serve-step server 1100)]\n410:       (is (= :stopped (:status s)))\n411:       (is (= {:since 1000 :outcome ::rc/unconfirmed} (:stop s)))))\n412:   (testing \"an unbind! that fails is stopped at once\"\n413:     (let [lnet (net/loopback-net)\n414:           host (assoc (host-of lnet) :unbind! (fn [_ _] (throw (ex-info \"no\" {}))))\n415:           s (-> (serve lnet (toy) {} host) (rc/serve-step 0) rc/stop! (rc/serve-step 5))]\n416:       (is (= :stopped (:status s)))\n417:       (is (= ::rc/unbind-failed (get-in s [:stop :outcome]))))))\n418: \n419: \n420: (deftest stop-while-starting-and-stop-twice-are-idempotent\n421:   (let [lnet (net/loopback-net)\n422:         quiet (fn [opts] {:dao.stream/outcome :dao.stream/ok :port (:bind-port opts)})\n423:         host (assoc (host-of lnet) :bind! quiet)\n424:         server (serve lnet (toy) {} host)\n425:         _ (is (= :starting (:status server)))\n426:         stopping (rc/stop! server)]\n427:     (is (= :stopping (:status stopping)))\n428:     (is (= stopping (rc/stop! stopping)) \"stop! twice\")\n429:     (let [s (rc/serve-step stopping 0)]\n430:       (is (= s (rc/stop! s)))\n431:       (net/pump! lnet)\n432:       (let [s (rc/serve-step s 1)]\n433:         (is (= :stopped (:status s)))\n434:         (is (= s (rc/stop! s)))\n435:         (is (= s (rc/serve-step s 2)))))\n436:     (let [refused (rc/serve {:spec spec :host {} :table {}})]\n437:       (is (= refused (rc/stop! refused))))))\n438: \n439: \n440: ;; =============================================================================\n441: ;; Lifecycle observation\n442: ;; =============================================================================\n443: \n444: (deftest a-lifecycle-gap-while-serving-is-counted-and-serving-continues\n445:   (let [w (world)\n446:         _ (tick! w 0)\n447:         _ (is (= :serving (:status @(:server w))))\n448:         deposit! (:deposit! @(:server w))]\n449:     (dotimes [i 70] (deposit! :listener-error {:i i}))\n450:     (tick! w 1)\n451:     (is (= :serving (:status @(:server w))))\n452:     (is (= 1 (:lifecycle-gaps @(:server w))))\n453:     (is (= 8 (count (:diagnostics @(:server w)))) \"the last 8 diagnostics\")\n454:     (attach! w 2)\n455:     (is (= :attached (:status @(first-dial w))) \"a reader still attaches\")))\n456: \n457: \n458: (deftest a-lifecycle-gap-while-starting-is-terminal\n459:   (let [lnet (net/loopback-net)\n460:         calls (atom 0)\n461:         quiet (fn [opts]\n462:                 ((net/listen-on lnet)\n463:                  (assoc opts :deposit! (fn [k v]\n464:                                          (when-not (= :bind-succeeded k)\n465:                                            ((:deposit! opts) k v))))))\n466:         host (assoc (host-of lnet)\n467:                     :bind! quiet\n468:                     :unbind! (counting-unbind lnet calls))\n469:         server (serve lnet (toy) {} host)\n470:         d (atom (dial lnet))]\n471:     (swap! d rc/dial-step 0)\n472:     (net/pump! lnet)\n473:     (is (= 1 (count (filter #(= :pending (:status %))\n474:                             (:slots (ws/endpoint-state (:endpoint server)))))))\n475:     (dotimes [i 70] ((:deposit! server) :listener-error {:i i}))\n476:     (let [s (rc/serve-step server 1)]\n477:       (is (= :refused (:status s)))\n478:       (is (= ::rc/lifecycle-lost (:reason s)))\n479:       (is (= 1 @calls) \"unbind! called\")\n480:       (is (every? #(= :free (:status %))\n481:                   (:slots (ws/endpoint-state (:endpoint s))))\n482:           \"the endpoint has no pending slot\"))))\n483: \n484: \n485: (deftest a-host-that-stops-under-us-is-stopped-host-stopped\n486:   (let [w (world)\n487:         d (first-dial w)\n488:         _ (attach! w 0)\n489:         sessions (rc/sessions @(:server w))]\n490:     (is (= 1 (count sessions)))\n491:     (net/unlisten! (:net w) (:port spec))\n492:     (swap! (:server w) rc/serve-step 1)\n493:     (is (= :stopped (:status @(:server w))))\n494:     (is (= ::rc/host-stopped (get-in @(:server w) [:stop :outcome])))\n495:     (is (every? :closed? (vals (rc/sessions @(:server w)))) \"sessions closed\")\n496:     (doseq [[_ s] sessions]\n497:       (is (= :dao.stream/closed\n498:              (:dao.stream/outcome (stream/append! (:ring s) :x)))))\n499:     (net/pump! (:net w))\n500:     (swap! d rc/dial-step 1)\n501:     (is (= :lost (:status @d)))))\n502: \n503: \n504: ;; =============================================================================\n505: ;; Session bounds under the profile\n506: ;; =============================================================================\n507: \n508: (deftest session-cap-and-idle-expiry-hold-under-the-profile\n509:   (let [lnet (net/loopback-net)\n510:         source (toy)\n511:         bounds {:max-sessions 2 :idle-timeout 100}\n512:         w {:net lnet :server (atom (serve lnet source bounds))\n513:            :dials (vec (repeatedly 3 #(atom (dial lnet bounds nil))))}]\n514:     (run-until w 0 0 20 (fn [] (not-any? #(= :resolving (:status @%)) (:dials w))))\n515:     (let [by-status (group-by (comp :status deref) (:dials w))]\n516:       (is (= 2 (count (:attached by-status))))\n517:       (is (= 1 (count (:lost by-status))))\n518:       (is (= :dao.stream/transport-error\n519:              (:dao.stream/outcome (:outcome @(first (:lost by-status))))))\n520:       (is (= 2 (count (rc/sessions @(:server w)))))\n521:       (let [[busy idle] (:attached by-status)\n522:             hb (rc/handle @busy)\n523:             hi (rc/handle @idle)\n524:             cb (read-past-value w 0 hb)\n525:             ci (read-past-value w 0 hi)]\n526:         (loop [now 10]\n527:           (when (<= now 200)\n528:             (poll! hb cb)\n529:             (tick! w now)\n530:             (recur (+ now 10))))\n531:         (is (= :attached (:status @busy)) \"a reader that polls is kept\")\n532:         (is (= :lost (:status @idle)) \"a reader that stopped asking is reaped\")\n533:         (is (= 1 (count (rc/sessions @(:server w)))))\n534:         (is (= :dao.stream.remote/channel-gone\n535:                (:dao.stream.remote/reason (ask! hi ci))))))))\n536: \n537: \n538: (deftest a-newcomer-during-stop-is-rejected\n539:   (let [w (world)\n540:         d (first-dial w)]\n541:     (tick! w 0)\n542:     (swap! (:server w) rc/stop!)\n543:     (run-until w 1 1 10 #(not= :resolving (:status @d)))\n544:     (is (= :lost (:status @d)))\n545:     (is (= :dao.stream/transport-error (:dao.stream/outcome (:outcome @d))))\n546:     (is (empty? (rc/sessions @(:server w))) \"no session\")))\n547: \n548: \n549: (deftest no-transport-and-no-port-are-refusals-as-data\n550:   (let [lnet (net/loopback-net)\n551:         host (host-of lnet)\n552:         table {\"s\" {:handle (toy) :surface #{:reader}}}]\n553:     (is (= ::rc/no-transport\n554:            (:reason (rc/serve {:spec (assoc spec :transport :udp) :host host :table table}))))\n555:     (is (= ::rc/no-transport\n556:            (:reason (rc/serve {:spec spec :host (dissoc host :bind!) :table table}))))\n557:     (doseq [p [0 -1 nil \"9\"]]\n558:       (is (= {:status :refused :reason ::rc/no-port :spec (assoc spec :port p)}\n559:              (rc/serve {:spec (assoc spec :port p) :host host :table table}))\n560:           (pr-str p)))\n561:     (is (= ::rc/invalid-table\n562:            (:reason (rc/serve {:spec spec :host host :table {\"s\" {}}}))))\n563:     (is (empty? (:listeners @lnet)) \"nothing listened\")\n564:     (let [d (rc/dial {:spec spec :host (dissoc host :connect!) :name n