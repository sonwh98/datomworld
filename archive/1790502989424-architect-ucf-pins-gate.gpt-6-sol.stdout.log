{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ucf.cljc | sed -n '35,205p'\"","aggregated_output":"    35\t;; The execution contract (S7.3.3)\n    36\t;; =============================================================================\n    37\t\n    38\t(def contract-stamp\n    39\t  \"The complete execution contract a canonical vector is interpreted under:\n    40\t   `:yin.code/contract` names the published revision of the tuple grammar,\n    41\t   S2.6 rules, last-value-wins resolution, opcode table, transitions,\n    42\t   resolution precedence, effect outcomes and scheduler\n    43\t   (`yin.vm.semantic.md` S2.4); `:yin.k/version` is this envelope's own\n    44\t   version. A resumer on another revision answers `:yin.k/profile-mismatch`\n    45\t   before lowering; a code index is keyed per stamp.\"\n    46\t  {:yin.code/contract vm/semantic-contract,\n    47\t   :yin.k/version 0})\n    48\t\n    49\t\n    50\t;; =============================================================================\n    51\t;; The canonical instruction vector (S7.3.2)\n    52\t;; =============================================================================\n    53\t\n    54\t(def ^:private segment-attrs\n    55\t  \"Segment-entity attributes the canonical form folds away or excludes:\n    56\t   the type and length are implied by the vector, provenance and the hash\n    57\t   itself are excluded. Anything else on the segment entity is a fact the\n    58\t   vector has no slot for.\"\n    59\t  #{:yin.code/type :yin.code/length :yin.code/derived-from :yin.code/hash})\n    60\t\n    61\t\n    62\t(def ^:private structural-attrs\n    63\t  \"Instruction attributes that position and the mnemonic replace.\"\n    64\t  #{:yin.code/segment :yin.code/pc :yin.code/op})\n    65\t\n    66\t\n    67\t(def ^:private excluded-instruction-attrs\n    68\t  \"Instruction attributes excluded from identity: provenance.\"\n    69\t  #{:yin.code/source})\n    70\t\n    71\t\n    72\t(def ^:private saturation-defaults\n    73\t  \"The loader's defaults, materialized so an omitted operand and a stated\n    74\t   one canonicalize identically (S7.3.2, `yin.vm.semantic.md` S2.4).\"\n    75\t  {[:gensym :yin.code/prefix] \"id\",\n    76\t   [:stream-make :yin.code/buffer] vm/default-stream-capacity,\n    77\t   [:ffi-call :yin.code/argc] 0,\n    78\t   [:call :yin.code/tail?] false})\n    79\t\n    80\t\n    81\t(defn- index-batch\n    82\t  \"Entity ids in order of first appearance, and each entity's attribute\n    83\t   map. A repeated single-valued attribute keeps its last value in datom\n    84\t   order -- the resolved interpretation the loader executes (S7.3.2).\"\n    85\t  [datoms]\n    86\t  (reduce (fn [[order attrs] [e a v]]\n    87\t            [(if (contains? attrs e) order (conj order e))\n    88\t             (assoc-in attrs [e a] v)])\n    89\t          [[] {}]\n    90\t          datoms))\n    91\t\n    92\t\n    93\t(defn refusal\n    94\t  \"The S7.9 `:yin.k/non-portable` outcome for a batch that has no canonical\n    95\t   vector, naming the offending place (`:yin.k/path`) and the defect.\"\n    96\t  [path defect hint]\n    97\t  {:yin.k/status :yin.k/non-portable,\n    98\t   :yin.k/kind :non-canonicalizable,\n    99\t   :yin.k/path path,\n   100\t   :yin.k/defect defect,\n   101\t   :yin.k/hint hint})\n   102\t\n   103\t\n   104\t(defn- refuse\n   105\t  [path defect hint]\n   106\t  (throw (ex-info (str \"Cannot canonicalize segment: \" hint)\n   107\t                  (refusal path defect hint))))\n   108\t\n   109\t\n   110\t(defn- resolved-batch\n   111\t  \"The loader's reading of a batch: `{:seg :attrs :instructions}` with\n   112\t   instructions in pc order. A batch that is not well formed (S2.6) is not\n   113\t   a segment, and is refused with the loader's own defect.\"\n   114\t  [datoms]\n   115\t  (when-let [defect (code/well-formed? datoms)]\n   116\t    (refuse [:entity (:entity defect)]\n   117\t            defect\n   118\t            (str \"the batch is not well formed: \" (name (:rule defect)))))\n   119\t  (let [[order attrs] (index-batch datoms)\n   120\t        seg (some #(when (= :segment (get-in attrs [% :yin.code/type])) %)\n   121\t                  order)\n   122\t        instructions (filterv (fn [e]\n   123\t                                (and (not= seg e)\n   124\t                                     (some #(contains? (get attrs e) %)\n   125\t                                           structural-attrs)))\n   126\t                              order)]\n   127\t    {:seg seg, :attrs attrs, :instructions instructions}))\n   128\t\n   129\t\n   130\t(defn- check-segment-entity\n   131\t  [seg attrs]\n   132\t  (let [extra (remove segment-attrs (keys (get attrs seg)))]\n   133\t    (when (seq extra)\n   134\t      (refuse [:entity seg]\n   135\t              {:rule :segment-attribute, :entity seg, :attrs (vec extra)}\n   136\t              \"the segment entity carries an attribute with no slot\"))))\n   137\t\n   138\t\n   139\t(defn- canonical-tuple\n   140\t  \"One instruction's tuple: the mnemonic, then its S2.4 operands in table\n   141\t   order, refs resolved to pcs and defaults materialized. Refused when the\n   142\t   mnemonic has no tuple or the instruction carries an operand its tuple\n   143\t   has no slot for.\"\n   144\t  [pc-of pc e ia]\n   145\t  (let [mnem (:yin.code/op ia)\n   146\t        operands (get code/vector-operand-table mnem)]\n   147\t    (when-not operands\n   148\t      (refuse [:pc pc]\n   149\t              {:rule :mnemonic, :pc pc, :entity e, :op mnem}\n   150\t              \"the mnemonic is outside the S2.4 table\"))\n   151\t    (let [slots (into #{} (map first) operands)\n   152\t          extra (remove (fn [a]\n   153\t                          (or (structural-attrs a)\n   154\t                              (excluded-instruction-attrs a)\n   155\t                              (slots a)))\n   156\t                        (keys ia))]\n   157\t      (when (seq extra)\n   158\t        (refuse [:pc pc]\n   159\t                {:rule :operand-slot, :pc pc, :entity e, :attrs (vec extra)}\n   160\t                \"the instruction carries an operand its tuple has no slot for\"))\n   161\t      (into [mnem]\n   162\t            (map (fn [[a kind]]\n   163\t                   (let [v (get ia a)]\n   164\t                     (cond\n   165\t                       (= :pc kind)\n   166\t                       (or (get pc-of v)\n   167\t                           (refuse [:pc pc]\n   168\t                                   {:rule :dangling-target, :pc pc,\n   169\t                                    :entity e, :ref v}\n   170\t                                   \"a ref resolves to no instruction\"))\n   171\t                       (nil? v) (get saturation-defaults [mnem a])\n   172\t                       :else v))))\n   173\t            operands))))\n   174\t\n   175\t\n   176\t(defn batch->canonical-instruction-vector\n   177\t  \"The canonical instruction vector (S7.3.2) of one `:yin.code/*` segment\n   178\t   batch, or a thrown `:yin.k/non-portable` refusal (`refusal`, kind\n   179\t   `:non-canonicalizable`) when the batch has none.\n   180\t\n   181\t   The batch is read through the loader's resolved interpretation, so two\n   182\t   batches that execute alike canonicalize alike: entity ids, datom order\n   183\t   within an entity, provenance, and omitted defaulted operands leave the\n   184\t   vector unchanged; a repeated attribute keeps its last value. The result\n   185\t   is checked against the S7.5 tuple grammar before it is returned, so a\n   186\t   vector this function yields is always one `load-vector` accepts.\"\n   187\t  [datoms]\n   188\t  (let [{:keys [seg attrs instructions]} (resolved-batch datoms)\n   189\t        pc-of (zipmap instructions (range))]\n   190\t    (check-segment-entity seg attrs)\n   191\t    (let [v (into []\n   192\t                  (map-indexed (fn [pc e]\n   193\t                                 (canonical-tuple pc-of pc e (get attrs e))))\n   194\t                  instructions)]\n   195\t      (when-let [defect (code/well-formed-vector? v)]\n   196\t        (refuse [:pc (:pc defect)]\n   197\t                defect\n   198\t                (str \"the resolved tuple is not admissible: \"\n   199\t                     (name (:rule defect)))))\n   200\t      v)))\n   201\t\n   202\t\n   203\t(defn code-address\n   204\t  \"`:yin.code/hash` of a canonical vector: its `dao.jing` segment address.\n   205\t   UCF mints no second addressing scheme.\"\n","exit_code":0,"status":"completed"}}
