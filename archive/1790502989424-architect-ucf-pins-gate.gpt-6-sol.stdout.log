213\t                          (instruction 0 :const :yin.code/value 1)\n   214\t                          (instruction 1 :halt))\n   215\t          r (ex-data-of #(semantic/load-image batch))]\n   216\t      (is (= :yin.k/non-portable (:yin.k/status r)))\n   217\t      (is (= :non-canonicalizable (:yin.k/kind r)))\n   218\t      (is (= :segment-attribute (get-in r [:yin.k/defect :rule])))\n   219\t      (is (not= :hash-mismatch (get-in r [:yin.k/defect :rule]))))))\n   220\t\n   221\t\n   222\t;; =============================================================================\n   223\t;; Equivalence laws\n   224\t;; =============================================================================\n   225\t\n   385\t    (is (vector? (ucf/batch->canonical-instruction-vector\n   386\t                   (assemble (segment 2 [[:yin.code/derived-from -50]\n   387\t                                         [:yin.code/hash :segment/x]])\n   388\t                             (instruction 0 :const :yin.code/value 1)\n   389\t                             (instruction 1 :halt)))))))\n   390\t\n   391\t\n   392\t(deftest canonicalize-rethrows-non-ucf-exceptions-test\n   393\t  (testing \"An exception canonicalize's catch does not recognize as a\n   394\t            :yin.k/non-portable refusal propagates uncaught rather than\n   395\t            being swallowed as one\"\n   396\t    (let [bad (conj (worked-segment) :not-a-datom)\n   397\t          caught (try (ucf/canonicalize bad vm/semantic-contract)\n   398\t                      ::not-thrown\n   399\t                      (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   400\t                        e))]\n   401\t      (is (not= ::not-thrown caught))\n   402\t      (is (nil? (:yin.k/status (ex-data caught)))))))\n   403\t\n   404\t\n   405\t;; =============================================================================\n   406\t;; S7.4 safepoints: the static half\n   407\t;; =============================================================================\n   408\t\n   409\t(deftest transitions-cover-the-vocabulary-test\n   410\t  (testing \"Every S2.4 mnemonic is classified exactly once\"\n   430\t             (mapv :yin.safepoint/reasons sps))))\n   431\t    (testing \"Stack effect pops operator and arguments\"\n   432\t      (is (= [-2 -3] (mapv :yin.safepoint/stack-effect sps))))\n   433\t    (testing \"Nothing is read from E after either call\"\n   434\t      (is (= [[] []] (mapv :yin.safepoint/lexically-required sps))))))\n   435\t\n   436\t\n   437\t(deftest safepoint-reasons-for-park-and-ffi-call-test\n   438\t  (testing \"A :park safepoint's reason is :park alone\"\n   439\t    (is (= [[:park]]\n   440\t           (mapv :yin.safepoint/reasons (ucf/safepoints [[:park] [:halt]])))))\n   441\t  (testing \"An :ffi-call safepoint carries both its reasons at one point:\n   442\t            sent, or retained while the request is in hand\"\n   443\t    (is (= [[:ffi :ffi-request]]\n   444\t           (mapv :yin.safepoint/reasons\n   445\t                 (ucf/safepoints [[:ffi-call :op/add 0] [:halt]]))))))\n   446\t\n   447\t\n   448\t(deftest stack-effect-per-parking-kind-test\n   449\t  (is (= 0 (ucf/stack-effect [:park])))\n   450\t  (is (= 0 (ucf/stack-effect [:stream-next])))\n   451\t  (is (= -1 (ucf/stack-effect [:stream-put])))\n   452\t  (is (= -2 (ucf/stack-effect [:ffi-call :op/add 2])))\n   453\t  (is (= -1 (ucf/stack-effect [:call 0 false])))\n   454\t  (is (= -3 (ucf/stack-effect [:call 2 true])))\n   455\t  (is (nil? (ucf/stack-effect [:const 1]))))\n   510\t             [:halt]]]\n   511\t      (is (= '[a b] (ucf/lexically-required v 0)))\n   512\t      (is (= '[b] (ucf/lexically-required v 4)))))\n   513\t  (testing \"A loop terminates and reads each name once\"\n   514\t    (let [v [[:var 'n] [:push] [:jump 0]]]\n   515\t      (is (= '[n] (ucf/lexically-required v 0)))))\n   516\t  (testing \"A resume transfers control: nothing after it is reachable\"\n   517\t    (is (= '[] (ucf/lexically-required [[:resume :parked-0] [:var 'x]\n   518\t                                        [:halt]]\n   519\t                                       0)))))\n   520\t\n   521\t\n   522\t;; =============================================================================\n   523\t;; S7.4 safepoints: conformance against the reference machine\n   524\t;; =============================================================================\n   525\t\n   526\t(defn- step-to\n   527\t  \"Step the loaded machine until control sits at `pc`.\"\n   528\t  [vm pc]\n   529\t  (loop [vm vm\n   530\t         n 0]\n   531\t    (cond\n   532\t      (= pc (:pc (vm/control vm))) vm\n   533\t      (< 64 n) (throw (ex-info \"pc never reached\" {:pc pc}))\n   534\t      :else (recur (vm/step vm) (inc n)))))\n   535\t\n   536\t\n   537\t(defn- observe-park\n   538\t  \"Run the batch to the parking instruction at `at`, take the transition,\n   539\t   and return the operand depth before it with the frame the machine left:\n   540\t   a wait entry, or the parked record for an explicit park.\"\n   541\t  [vm batch at]\n   542\t  (let [before (step-to (semantic/vm-load-program vm batch\n   543\t                                                  vm/semantic-contract) at)\n   544\t        after (vm/step before)\n   545\t        frame (or (first (:wait-set after))\n   546\t                  (first (vals (:parked after))))]\n   547\t    {:depth (count (:stack before)), :frame frame, :vm after}))\n   548\t\n   549\t\n   550\t(defn- conforms?\n   551\t  \"The static safepoint entry agrees with the observed frame: the frame's\n   552\t   pc is the canonical resume pc and its stack depth is the depth before\n   553\t   the instruction plus the static stack effect.\"\n   554\t  [batch at {:keys [depth frame]}]\n   555\t  (let [sp (ucf/safepoint-at (ucf/batch->canonical-instruction-vector batch)\n   556\t                             (inc at))]\n   557\t    (and (= at (:yin.safepoint/at sp))\n   558\t         (= (:yin.safepoint/pc sp) (:pc frame))\n   559\t         (= (+ depth (:yin.safepoint/stack-effect sp))\n   560\t            (count (:stack frame))))))\n   561\t\n   562\t\n   710\t    (testing \"Static: what the code will read\"\n   711\t      (is (= '[+ q] (:yin.safepoint/lexically-required sp))))\n   712\t    (testing \"Dynamic: depth, bound names and bases come from the frame\"\n   713\t      (is (= {:yin.k/depth 2, :yin.k/bound '[q r], :yin.k/stack-bases [1]}\n   714\t             (ucf/activation-state frame))))\n   715\t    (testing \"A requirement is met by E or by the rest of resolution\"\n   716\t      (is (= '[+] (ucf/unsatisfied-names sp frame (constantly false))))\n   717\t      (is (= '[] (ucf/unsatisfied-names sp frame #{'+})))\n   718\t      (is (= '[+ q]\n   719\t             (ucf/unsatisfied-names sp {:env {}} (constantly false)))))))\n   720\t\n   721\t\n   722\t(deftest activation-state-multi-frame-stack-bases-test\n   723\t  (testing \"Stack bases follow :k in order -- the outermost return frame\n   724\t            first, the innermost last: mapv over :k, nothing reordered\"\n   725\t    (let [frame {:segment seg, :pc 3, :env {}, :stack [],\n   726\t                 :k [{:type :return, :stack-base 0}\n   727\t                     {:type :return, :stack-base 2}\n   728\t                     {:type :return, :stack-base 5}]}]\n   729\t      (is (= [0 2 5] (:yin.k/stack-bases (ucf/activation-state frame)))))))\n","exit_code":0,"status":"completed"}}
