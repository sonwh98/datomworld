{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/ucf_test.cljc | sed -n '1,145p;560,610p;640,685p'\"","aggregated_output":"     1\t(ns yin.vm.ucf-test\n     2\t  \"UCF Phase 1 (`docs/design/yin.vm.universal-continuation-format.md` S7.3,\n     3\t   S7.4): the canonical instruction vector, its address and contract stamp,\n     4\t   and the static safepoint map -- checked against the reference machine.\n     5\t\n     6\t   Fixtures are S2.7-shaped batches assembled by hand, as in\n     7\t   `yin.vm.semantic-test`, so the resolved interpretation under test is the\n     8\t   loader's own.\"\n     9\t  (:require [clojure.test :refer [deftest is testing]]\n    10\t            [dao.datom :as datom]\n    11\t            [dao.jing :as jing]\n    12\t            [dao.stream :as stream]\n    13\t            [yin.vm :as vm]\n    14\t            [yin.vm.semantic :as semantic]\n    15\t            [yin.vm.test-utils :as tu]\n    16\t            [yin.vm.ucf :as ucf]))\n    17\t\n    18\t\n    19\t;; =============================================================================\n    20\t;; Hand assembly\n    21\t;; =============================================================================\n    22\t\n    23\t(def ^:private seg -1)\n    24\t\n    25\t\n    26\t(defn- eid\n    27\t  [pc]\n    28\t  (- -10 pc))\n    29\t\n    30\t\n    31\t(defn- entity-datoms\n    32\t  [e attr-values]\n    33\t  (mapv (fn [[a v]] [e a v 0 datom/default-op]) attr-values))\n    34\t\n    35\t\n    36\t(defn- segment\n    37\t  ([length] (segment length []))\n    38\t  ([length extra]\n    39\t   (entity-datoms seg (into [[:yin.code/type :segment]\n    40\t                             [:yin.code/length length]]\n    41\t                            extra))))\n    42\t\n    43\t\n    44\t(defn- instruction*\n    45\t  [e pc op operands]\n    46\t  (entity-datoms e (into [[:yin.code/segment seg] [:yin.code/pc pc]\n    47\t                          [:yin.code/op op]]\n    48\t                         (partition 2 operands))))\n    49\t\n    50\t\n    51\t(defn- instruction\n    52\t  [pc op & operands]\n    53\t  (instruction* (eid pc) pc op operands))\n    54\t\n    55\t\n    56\t(defn- assemble\n    57\t  [& parts]\n    58\t  (vec (apply concat parts)))\n    59\t\n    60\t\n    61\t(defn- make-vm\n    62\t  ([] (make-vm {}))\n    63\t  ([opts] (semantic/create-vm (merge {:make-stream tu/make-stream,\n    64\t                                      :capability-secret tu/secret} opts))))\n    65\t\n    66\t\n    67\t(defn- ex-data-of\n    68\t  [thunk]\n    69\t  (try (thunk) nil\n    70\t       (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n    71\t         (ex-data e))))\n    72\t\n    73\t\n    74\t(defn- worked-segment\n    75\t  \"`((fn [x] (+ x 1)) 10)` as lowered in yin.vm.semantic.md S2.7.\"\n    76\t  []\n    77\t  (assemble (segment 14)\n    78\t            (instruction 0 :closure :yin.code/params '[x]\n    79\t                         :yin.code/body (eid 6))\n    80\t            (instruction 1 :push)\n    81\t            (instruction 2 :const :yin.code/value 10)\n    82\t            (instruction 3 :push)\n    83\t            (instruction 4 :call :yin.code/argc 1 :yin.code/tail? false)\n    84\t            (instruction 5 :halt)\n    85\t            (instruction 6 :var :yin.code/name '+)\n    86\t            (instruction 7 :push)\n    87\t            (instruction 8 :var :yin.code/name 'x)\n    88\t            (instruction 9 :push)\n    89\t            (instruction 10 :const :yin.code/value 1)\n    90\t            (instruction 11 :push)\n    91\t            (instruction 12 :call :yin.code/argc 2 :yin.code/tail? true)\n    92\t            (instruction 13 :return)))\n    93\t\n    94\t\n    95\t(def ^:private worked-vector\n    96\t  [[:closure '[x] 6] [:push] [:const 10] [:push] [:call 1 false] [:halt]\n    97\t   [:var '+] [:push] [:var 'x] [:push] [:const 1] [:push] [:call 2 true]\n    98\t   [:return]])\n    99\t\n   100\t\n   101\t(defn- effects-segment\n   102\t  \"Every defaulted operand stated: a gensym, a stream-make, an ffi-call\n   103\t   and a non-tail call, then halt.\"\n   104\t  [& {:keys [prefix buffer argc tail?]\n   105\t      :or {prefix \"id\", buffer vm/default-stream-capacity, argc 0,\n   106\t           tail? false}}]\n   107\t  (assemble (segment 8)\n   108\t            (instruction 0 :gensym :yin.code/prefix prefix)\n   109\t            (instruction 1 :push)\n   110\t            (instruction 2 :stream-make :yin.code/buffer buffer)\n   111\t            (instruction 3 :push)\n   112\t            (instruction 4 :ffi-call :yin.code/ffi-op :op/add\n   113\t                         :yin.code/argc argc)\n   114\t            (instruction 5 :push)\n   115\t            (instruction 6 :call :yin.code/argc 2 :yin.code/tail? tail?)\n   116\t            (instruction 7 :halt)))\n   117\t\n   118\t\n   119\t(defn- without-attrs\n   120\t  \"The batch with every datom on one of `attrs` removed.\"\n   121\t  [batch attrs]\n   122\t  (vec (remove (fn [[_ a]] (contains? attrs a)) batch)))\n   123\t\n   124\t\n   125\t;; A second, unrelated segment: two segments' entity ids never mix, so an\n   126\t;; independent id and eid range keeps this batch's datoms out of the other's.\n   127\t(def ^:private seg-b -2)\n   128\t\n   129\t\n   130\t(defn- eid-b\n   131\t  [pc]\n   132\t  (- -20 pc))\n   133\t\n   134\t\n   135\t(defn- segment-b\n   136\t  [length]\n   137\t  (entity-datoms seg-b [[:yin.code/type :segment] [:yin.code/length length]]))\n   138\t\n   139\t\n   140\t(defn- instruction-b\n   141\t  [pc op & operands]\n   142\t  (entity-datoms (eid-b pc)\n   143\t                 (into [[:yin.code/segment seg-b] [:yin.code/pc pc]\n   144\t                        [:yin.code/op op]]\n   145\t                       (partition 2 operands))))\n   560\t            (count (:stack frame))))))\n   561\t\n   562\t\n   563\t(defn- one-slot-writer\n   564\t  \"A `:make-stream` whose handle answers `full` once one value sits in it,\n   565\t   so a second put parks. The reader surface is the minimum the FFI pair's\n   566\t   construction needs: a cursor that never advances.\"\n   567\t  [_capacity]\n   568\t  (let [slot (atom ::empty)]\n   569\t    {:dao.stream/outcome :dao.stream/ok,\n   570\t     :dao.stream/handle\n   571\t     (reify\n   572\t       stream/IDaoStreamReader\n   573\t       (cursor\n   574\t         [_ _anchor]\n   575\t         {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor 0})\n   576\t\n   577\t       (next\n   578\t         [_ _cursor]\n   579\t         {:dao.stream/outcome :dao.stream/blocked})\n   580\t\n   581\t\n   582\t       stream/IDaoStreamWriter\n   583\t\n   584\t       (append!\n   585\t         [_ v]\n   586\t         (if (= ::empty @slot)\n   587\t           (do (reset! slot v) {:dao.stream/outcome :dao.stream/ok})\n   588\t           {:dao.stream/outcome :dao.stream/full})))}))\n   589\t\n   590\t\n   591\t(deftest explicit-park-conformance-test\n   592\t  (let [batch (assemble (segment 4)\n   593\t                        (instruction 0 :const :yin.code/value 5)\n   594\t                        (instruction 1 :push)\n   595\t                        (instruction 2 :park)\n   596\t                        (instruction 3 :halt))\n   597\t        obs (observe-park (make-vm) batch 2)]\n   598\t    (is (= 1 (:depth obs)))\n   599\t    (is (= 3 (:pc (:frame obs))))\n   600\t    (is (conforms? batch 2 obs))))\n   601\t\n   602\t\n   603\t(deftest blocked-read-conformance-test\n   604\t  (let [batch (assemble (segment 6)\n   605\t                        (instruction 0 :const :yin.code/value :below)\n   606\t                        (instruction 1 :push)\n   607\t                        (instruction 2 :stream-make :yin.code/buffer 8)\n   608\t                        (instruction 3 :stream-cursor)\n   609\t                        (instruction 4 :stream-next)\n   610\t                        (instruction 5 :halt))\n   640\t                        (instruction 3 :push)\n   641\t                        (instruction 4 :ffi-call :yin.code/ffi-op :op/add\n   642\t                                     :yin.code/argc 1)\n   643\t                        (instruction 5 :halt))\n   644\t        obs (observe-park (make-vm) batch 4)]\n   645\t    (is (vm/blocked? (:vm obs)))\n   646\t    (is (= 2 (:depth obs)))\n   647\t    (is (= [1] (:stack (:frame obs))) \"the argument is popped, not the 1\")\n   648\t    (is (conforms? batch 4 obs))))\n   649\t\n   650\t\n   651\t(deftest ffi-call-retained-conformance-test\n   652\t  (let [batch-a (assemble (segment 6)\n   653\t                          (instruction 0 :const :yin.code/value 1)\n   654\t                          (instruction 1 :push)\n   655\t                          (instruction 2 :const :yin.code/value 2)\n   656\t                          (instruction 3 :push)\n   657\t                          (instruction 4 :ffi-call :yin.code/ffi-op :op/add\n   658\t                                       :yin.code/argc 1)\n   659\t                          (instruction 5 :halt))\n   660\t        batch-b (assemble (segment-b 2)\n   661\t                          (instruction-b 0 :ffi-call :yin.code/ffi-op :op/add\n   662\t                                         :yin.code/argc 0)\n   663\t                          (instruction-b 1 :halt))\n   664\t        vm-a (semantic/vm-load-program (make-vm {:make-stream one-slot-writer})\n   665\t                                       batch-a vm/semantic-contract)\n   666\t        after-a (vm/step (step-to vm-a 4))\n   667\t        vm-b (semantic/vm-load-program after-a batch-b vm/semantic-contract)\n   668\t        after-b (vm/step (step-to vm-b 0))\n   669\t        entry (peek (:wait-set after-b))]\n   670\t    (testing \"The one-slot call-in stream is already held by the sent\n   671\t              request from batch-a: a second :ffi-call is retained, not\n   672\t              sent, at the same safepoint\"\n   673\t      (is (vm/blocked? after-b))\n   674\t      (is (= 2 (count (:wait-set after-b))) \"the sent entry is still waiting\")\n   675\t      (is (true? (:request-sent entry)))\n   676\t      (is (= :put (:reason entry)))\n   677\t      (is (= :op/add (:op entry))))))\n   678\t\n   679\t\n   680\t(deftest effectful-call-conformance-test\n   681\t  (let [blocking-next (fn [cursor] {:effect :stream/next, :cursor cursor})\n   682\t        batch (assemble (segment 7)\n   683\t                        (instruction 0 :var :yin.code/name 'blocking-next)\n   684\t                        (instruction 1 :push)\n   685\t                        (instruction 2 :stream-make :yin.code/buffer 8)\n","exit_code":0,"status":"completed"}}
