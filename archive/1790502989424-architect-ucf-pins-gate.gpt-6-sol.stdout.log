) val' St E K vm' image\n   418\t                            (and fuel (dec fuel)))\n   419\t                     (:stop r)))\n   420\t              ;; :stream-close — source ref in val (16)\n   421\t              16 (let [r (run-effect vm seg pc val St E K\n   422\t                                     {:effect :stream/close, :stream val}\n   423\t                                     nil)]\n   424\t                   (if-let [[vm' val'] (:continue r)]\n   425\t                     (recur seg (inc pc) val' St E K vm' image\n   426\t                            (and fuel (dec fuel)))\n   427\t                     (:stop r)))\n   428\t              ;; :ffi-call — park-and-call over the FFI pair (21)\n   429\t              21 (let [ffi-op (nth inst 1)\n   430\t                       argc (nth inst 2)\n   431\t                       total (count St)\n   432\t                       args (subvec St (- total argc))\n   433\t                       St' (subvec St 0 (- total argc))\n   434\t                       ;; The pair is checked before parking: an error raised\n   435\t                       ;; after park-continuation would strand a continuation\n   465\t                                  :op ffi-op,\n   466\t                                  :reason :put,\n   467\t                                  :stream-id vm/call-in-stream-key,\n   468\t                                  :datom request})\n   469\t                         (assoc :control nil\n   470\t                                :k nil\n   471\t                                :value :yin/blocked\n   472\t                                :blocked? true\n   473\t                                :halted? false))\n   474\t                     (throw (ex-info \"FFI request could not be appended\"\n   475\t                                     {:op ffi-op,\n   476\t                                      :outcome (or (:dao.stream/outcome result)\n   477\t                                                   (:dao.stream.apply/outcome\n   478\t                                                     result))}))))\n   595\t                               [opcode (:yin.code/argc ia)])\n   596\t                       :return [opcode]\n   597\t                       :jump [opcode (resolve-ref e (:yin.code/target ia))]\n   598\t                       :branch-false [opcode\n   599\t                                      (resolve-ref e (:yin.code/target ia))]\n   600\t                       :halt [opcode]\n   601\t                       :gensym [opcode (or (:yin.code/prefix ia) \"id\")]\n   602\t                       :store-get [opcode (:yin.code/key ia)]\n   603\t                       :store-put [opcode (:yin.code/key ia)\n   604\t                                   (:yin.code/value ia)]\n   605\t                       :define [opcode (:yin.code/name ia)]\n   606\t                       :stream-make [opcode (or (:yin.code/buffer ia)\n   607\t                                                vm/default-stream-capacity)]\n   608\t                       :stream-put [opcode]\n   609\t                       :stream-cursor [opcode]\n   610\t                       :stream-next [opcode]\n   611\t                       :stream-close [opcode]\n   612\t                       :park [opcode]\n   613\t                       :resume [opcode (:yin.code/parked-id ia)]\n   614\t                       :current-continuation [opcode]\n   615\t                       :ffi-call [opcode (:yin.code/ffi-op ia)\n   616\t                                  (or (:yin.code/argc ia) 0)]\n   617\t                       :push [opcode]\n   618\t                       (throw (ex-info \"Unknown mnemonic\"\n   619\t                                       {:op mnem, :entity e})))))\n   620\t          claimed (get-in attrs [seg :yin.code/hash])\n   621\t          ;; A claimed address is earned, never trusted: the batch must\n   622\t          ;; reconstruct to the canonical vector that hashes to it.\n   623\t          ;; UCF §7.3.4 checks an address whenever one is claimed, so a\n   624\t          ;; false claim fails the load here and never reaches the alias\n   625\t          ;; column. The vector is the one `yin.vm.ucf` mints, saturated,\n   650\t\n   651\t\n   652\t(defn- store-image\n   653\t  \"Register one decoded image under its segment id, returning the code map.\n   654\t\n   655\t   Segment identity is stable: continuations, frames, and closures name\n   656\t   segments by id, so an id must never come to mean different code. An\n   657\t   identical reload — a batch re-sent, a batch run twice — decodes to the\n   658\t   same image and is accepted. A different image under a live id is a\n   659\t   conflict, and loading it fails rather than silently redirecting every\n   660\t   continuation that names the id.\"\n   661\t  [code image]\n   662\t  (let [seg (:segment image)]\n   663\t    (if-let [existing (find code seg)]\n   664\t      (if (= (val existing) image)\n   665\t        code\n   666\t        (throw (ex-info \"Cannot load segment: the id already holds different code\"\n   667\t                        {:segment seg})))\n   668\t      (assoc code seg image))))\n   669\t\n   670\t\n   671\t(defn- store-alias\n   672\t  \"Record one loaded image's address in the `address → local-id` alias\n   673\t   column (UCF §7.3.4). The column is checked: an address may never land\n   674\t   under a second live local id. An image claiming no address — every batch\n   675\t   the datom lane's `lower` produces — leaves the column unchanged.\"\n   676\t  [aliases image]\n   677\t  (if-let [address (:address image)]\n   678\t    (if-let [prior (find aliases address)]\n   679\t      (if (= (val prior) (:segment image))\n   680\t        aliases\n   681\t        (throw (ex-info \"Cannot load segment: the address is already aliased to another id\"\n   682\t                        {:address address, :aliased-to (val prior)})))\n   683\t      (assoc aliases address (:segment image)))\n   684\t    aliases))\n   685\t\n   686\t\n   687\t(defn vm-load-program\n   688\t  \"Load one `:yin.code/*` batch: validate it, decode it, store the image under\n   689\t   `:code {segment-id image}`, record the segment's claimed address — verified\n   690\t   against the batch's own content by `load-image` — in the alias column when\n   691\t   it carries one, and set control to `{:segment id :pc 0}`.\n   692\t\n   693\t   This is the loader a composition hands to `dao.stream.observer/\n   694\t   run-on-stream` beside `engine/ready-for-ingress?` and the VM's runner; a\n   695\t   composition whose program stream carries `:yin/*` AST datoms composes the\n   696\t   Phase 2 linearizer in front of it. Parked continuations survive a load, so\n   697\t   one segment can resume another's. A segment id already holding different\n   698\t   code is a load error; loading the same image again is accepted.\n   699\t\n   700\t   `contract` is required and compared with `vm/semantic-contract` before\n","exit_code":0,"status":"completed"}}
