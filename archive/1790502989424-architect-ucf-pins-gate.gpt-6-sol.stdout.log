              :request-sent true,\n   464\t                                  :call-id call-id,\n   465\t                                  :op ffi-op,\n   466\t                                  :reason :put,\n   467\t                                  :stream-id vm/call-in-stream-key,\n   468\t                                  :datom request})\n   469\t                         (assoc :control nil\n   470\t                                :k nil\n   620\t          claimed (get-in attrs [seg :yin.code/hash])\n   621\t          ;; A claimed address is earned, never trusted: the batch must\n   622\t          ;; reconstruct to the canonical vector that hashes to it.\n   623\t          ;; UCF §7.3.4 checks an address whenever one is claimed, so a\n   624\t          ;; false claim fails the load here and never reaches the alias\n   625\t          ;; column. The vector is the one `yin.vm.ucf` mints, saturated,\n   626\t          ;; so a batch omitting a defaulted operand earns the same\n   627\t          ;; address as one stating it.\n   628\t          canonical-vec (when claimed\n   629\t                          (ucf/batch->canonical-instruction-vector datoms))]\n   630\t      (if (and claimed (not (jing/segment-matches? claimed canonical-vec)))\n   631\t        (throw (ex-info (str \"Cannot load segment: hash-mismatch (entity \"\n   632\t                             seg \")\")\n   633\t                        {:defect {:rule :hash-mismatch, :entity seg},\n   634\t                         :claimed claimed,\n   635\t                         :actual (let [algo (try\n   636\t                                              (jing/segment-algorithm claimed)\n   637\t                                              (catch #?(:cljd Object\n   638\t                                                        :clj Throwable\n   639\t                                                        :cljs :default)\n   640\t                                                     _\n   641\t                                                jing/default-hash-algorithm))]\n   642\t                                   (jing/segment-key canonical-vec\n   643\t                                                     {:algorithm algo}))}))\n   644\t        (cond-> {:segment seg,\n   645\t                 :length (get-in attrs [seg :yin.code/length]),\n   646\t                 :code (mapv decode instructions)}\n   647\t          ;; A batch carrying no hash — every `lower` output — records no\n   648\t          ;; alias.\n   649\t          claimed (assoc :address claimed))))))\n   650\t\n","exit_code":0,"status":"completed"}}
