{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/ffi_test.cljc | sed -n '1,220p'; nl -ba test/yin/vm/ffi_test.cljc | sed -n '270,350p'; nl -ba test/dao/stream/ws_test.cljc | sed -n '1,230p'; nl -ba test/dao/stream/ringbuffer_test.cljc | sed -n '140,215p'\"","aggregated_output":"     1\t(ns yin.vm.ffi-test\n     2\t  (:require [clojure.test :refer [deftest is testing]]\n     3\t            [dao.stream :as stream]\n     4\t            [dao.stream.apply :as apply2]\n     5\t            [yin.vm :as vm]\n     6\t            [yin.vm.ast-walker :as ast-walker]\n     7\t            [yin.vm.ffi :as ffi]\n     8\t            [yin.vm.test-utils :as tu]))\n     9\t\n    10\t\n    11\t(defn- throws?\n    12\t  [thunk]\n    13\t  (try (thunk) false\n    14\t       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n    15\t\n    16\t\n    17\t(defn- call-ast\n    18\t  ([op] (call-ast op []))\n    19\t  ([op values]\n    20\t   {:type :dao.stream.apply/call,\n    21\t    :op op,\n    22\t    :operands (mapv (fn [v] {:type :literal, :value v}) values)}))\n    23\t\n    24\t\n    25\t;; =============================================================================\n    26\t;; The round trip\n    27\t;; =============================================================================\n    28\t\n    29\t(deftest installed-handlers-round-trip-test\n    30\t  (testing \"A host call is dispatched and its parked continuation resumes\"\n    31\t    (let [result (vm/eval (tu/create-vm {:bridge {:op/echo identity}})\n    32\t                          (call-ast :op/echo [42]))]\n    33\t      (is (vm/halted? result))\n    34\t      (is (= 42 (vm/value result)))))\n    35\t  (testing \"Arguments are evaluated left to right before the call\"\n    36\t    (let [result (vm/eval (tu/create-vm {:bridge {:op/list vector}})\n    37\t                          (call-ast :op/list [1 2 3]))]\n    38\t      (is (= [1 2 3] (vm/value result))))))\n    39\t\n    40\t\n    41\t(deftest manual-bridge-step-test\n    42\t  (testing \"Without installed handlers the VM parks and a driver steps it\"\n    43\t    (let [parked (vm/eval (tu/create-vm) (call-ast :op/echo [7]))]\n    44\t      (is (vm/blocked? parked))\n    45\t      (is (= :yin/blocked (vm/value parked)))\n    46\t      (is (= 1 (count (:wait-set parked)))\n    47\t          \"The continuation waits in the polling wait set, not on a waiter\")\n    48\t      (let [attached (ffi/attach parked {:op/echo identity})\n    49\t            {:keys [handled? vm]} (ffi/bridge-step attached)]\n    50\t        (is (true? handled?))\n    51\t        (let [done (vm/eval vm nil)]\n    52\t          (is (vm/halted? done))\n    53\t          (is (= 7 (vm/value done))))))))\n    54\t\n    55\t\n    56\t(deftest error-responses-surface-as-errors-test\n    57\t  (testing \"An unknown op is a portable error response, not an escaping throw\"\n    58\t    (let [parked (vm/eval (tu/create-vm) (call-ast :op/missing [1]))\n    59\t          {:keys [vm handled?]} (ffi/bridge-step (ffi/attach parked\n    60\t                                                             {:op/other\n    61\t                                                              identity}))]\n    62\t      (is (true? handled?) \"The response was delivered\")\n    63\t      (is (throws? (fn [] (vm/eval vm nil))))))\n    64\t  (testing \"A failing handler is an error response too\"\n    65\t    (let [parked (vm/eval (tu/create-vm) (call-ast :op/boom []))\n    66\t          bang (fn [] (throw (ex-info \"boom\" {})))\n    67\t          {:keys [vm]} (ffi/bridge-step (ffi/attach parked {:op/boom bang}))]\n    68\t      (is (throws? (fn [] (vm/eval vm nil)))))))\n    69\t\n    70\t\n    71\t;; =============================================================================\n    72\t;; The step is once-only\n    73\t;; =============================================================================\n    74\t\n    75\t(defn- scripted-writer\n    76\t  \"A call-out handle whose append outcomes are scripted.\"\n    77\t  [outcomes]\n    78\t  (reify\n    79\t    stream/IDaoStreamReader\n    80\t    (cursor\n    81\t      [_ _]\n    82\t      {:dao.stream/outcome :dao.stream/ok,\n    83\t       :dao.stream/cursor :out-0})\n    84\t\n    85\t    (next [_ _] {:dao.stream/outcome :dao.stream/blocked})\n    86\t\n    87\t\n    88\t    stream/IDaoStreamWriter\n    89\t\n    90\t    (append!\n    91\t      [_ _]\n    92\t      (let [o (first @outcomes)]\n    93\t        (swap! outcomes rest)\n    94\t        {:dao.stream/outcome o}))))\n    95\t\n    96\t\n    97\t(deftest full-retains-the-response-and-runs-the-handler-once-test\n    98\t  (let [calls (atom 0)\n    99\t        outcomes (atom [:dao.stream/full :dao.stream/ok])\n   100\t        call-in (tu/new-stream 8)\n   101\t        call-out (scripted-writer outcomes)\n   102\t        vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   103\t                                   :call-in call-in,\n   104\t                                   :call-out call-out})\n   105\t        ;; Handlers are attached after the call parks, so the scripted\n   106\t        ;; outcomes are consumed by the explicit steps below and not by\n   107\t        ;; `maybe-run` inside `eval`.\n   108\t        parked (ffi/attach (vm/eval vm0 (call-ast :op/count []))\n   109\t                           {:op/count (fn [] (swap! calls inc))})\n   110\t        cursor-before (get-in parked [:bridge :cursor])\n   111\t        step1 (ffi/bridge-step parked)]\n   112\t    (testing \"A full response stream retains the response and the successor\"\n   113\t      (is (false? (:handled? step1)))\n   114\t      (is (true? (:retained? step1)))\n   115\t      (is (= 1 @calls))\n   116\t      (is (= cursor-before (get-in (:vm step1) [:bridge :cursor]))\n   117\t          \"The bridge cursor does not advance until the append succeeds\")\n   118\t      (is (some? (get-in (:vm step1) [:bridge :pending-response]))))\n   119\t    (testing \"The retry appends the retained response without re-running\"\n   120\t      (let [step2 (ffi/bridge-step (:vm step1))]\n   121\t        (is (true? (:handled? step2)))\n   122\t        (is (= 1 @calls) \"The handler executed exactly once\")\n   123\t        (is (not= cursor-before (get-in (:vm step2) [:bridge :cursor])))\n   124\t        (is (nil? (get-in (:vm step2) [:bridge :pending-response])))))))\n   125\t\n   126\t\n   127\t(deftest terminal-append-outcome-ends-the-bridge-test\n   128\t  (let [call-in (tu/new-stream 8)\n   129\t        call-out (scripted-writer (atom [:dao.stream/closed]))\n   130\t        vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   131\t                                   :call-in call-in,\n   132\t                                   :call-out call-out})\n   133\t        parked (ffi/attach (vm/eval vm0 (call-ast :op/echo [1]))\n   134\t                           {:op/echo identity})\n   135\t        {:keys [handled? terminal vm]} (ffi/bridge-step parked)]\n   136\t    (testing \"The response is reported undeliverable and the bridge ends\"\n   137\t      (is (false? handled?))\n   138\t      (is (= :dao.stream/closed terminal))\n   139\t      (is (= :dao.stream/closed (get-in vm [:bridge :terminal]))))\n   140\t    (testing \"A terminated bridge does not read again\"\n   141\t      (is (= :dao.stream/closed (:terminal (ffi/bridge-step vm)))))))\n   142\t\n   143\t\n   144\t;; =============================================================================\n   145\t;; Reading the request side\n   146\t;; =============================================================================\n   147\t\n   148\t(deftest gap-at-the-bridge-cursor-is-fatal-test\n   149\t  (testing \"An evicted request can never be answered, so it is reported\"\n   150\t    (let [call-in (tu/new-stream 2)\n   151\t          vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   152\t                                     :call-in call-in,\n   153\t                                     :call-out (tu/new-stream 8),\n   154\t                                     :bridge {:op/echo identity}})]\n   155\t      (dotimes [n 5] (stream/append! call-in (apply2/request n :op/echo [n])))\n   156\t      (is (throws? (fn [] (ffi/bridge-step vm0)))))))\n   157\t\n   158\t\n   159\t(deftest end-on-the-request-stream-terminates-test\n   160\t  (let [call-in (tu/new-stream 4)\n   161\t        vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   162\t                                   :call-in call-in,\n   163\t                                   :call-out (tu/new-stream 4),\n   164\t                                   :bridge {:op/echo identity}})]\n   165\t    (stream/close! call-in)\n   166\t    (is (= :dao.stream/end (:terminal (ffi/bridge-step vm0))))))\n   167\t\n   168\t\n   169\t(deftest malformed-request-without-an-id-is-a-diagnostic-test\n   170\t  (let [call-in (tu/new-stream 4)\n   171\t        call-out (tu/new-stream 4)\n   172\t        vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   173\t                                   :call-in call-in,\n   174\t                                   :call-out call-out,\n   175\t                                   :bridge {:op/echo identity}})]\n   176\t    (stream/append! call-in {:not :a-request})\n   177\t    (stream/append! call-in (apply2/request 1 :op/echo [:ok]))\n   178\t    (let [step1 (ffi/bridge-step vm0)]\n   179\t      (testing \"It never reaches a handler and advances exactly once\"\n   180\t        (is (false? (:handled? step1)))\n   181\t        (is (= :dao.stream.apply/malformed-request (:diagnostic step1))))\n   182\t      (testing \"The request behind it is served normally\"\n   183\t        (let [step2 (ffi/bridge-step (:vm step1))]\n   184\t          (is (true? (:handled? step2)))\n   185\t          (is (= 1 (:request-id step2))))))))\n   186\t\n   187\t\n   188\t;; =============================================================================\n   189\t;; A VM with no pair\n   190\t;; =============================================================================\n   191\t\n   192\t(deftest no-call-pair-test\n   193\t  (let [bare (ast-walker/create-vm {})]\n   194\t    (testing \"A VM without :make-stream or explicit streams holds no pair\"\n   195\t      (is (nil? (get (vm/store bare) vm/call-in-stream-key)))\n   196\t      (is (nil? (ffi/call-pair (vm/store bare)))))\n   197\t    (testing \"A non-nil bridge on such a VM is a construction error\"\n   198\t      (is (throws? (fn []\n   199\t                     (ast-walker/create-vm {:bridge {:op/echo\n   200\t                                                     identity}})))))\n   201\t    (testing \"A call fails before park-continuation, stranding nothing\"\n   202\t      (is (throws? (fn [] (vm/eval bare (call-ast :op/echo [1])))))\n   203\t      (is (empty? (:parked bare)))\n   204\t      (is (zero? (:id-counter bare))))))\n   205\t\n   206\t\n   207\t(deftest bridge-cursor-is-minted-not-fabricated-test\n   208\t  (testing \"attach mints against call-in, where the store is visible\"\n   209\t    (let [vm0 (tu/create-vm)\n   210\t          attached (ffi/attach vm0 {:op/echo identity})]\n   211\t      (is (= (:dao.stream/cursor (stream/cursor (get (vm/store vm0)\n   212\t                                                     vm/call-in-stream-key)\n   213\t                                                stream/anchor-oldest))\n   214\t             (get-in attached [:bridge :cursor]))\n   215\t          \"Minted at :dao.stream/oldest, whatever shape the transport gives\")\n   216\t      (is (nil? (:position (get-in attached [:bridge :cursor])))\n   217\t          \"The VM stores no position of its own\")))\n   218\t  (testing \"normalize alone mints nothing\"\n   219\t    (is (= {:handlers {:op/echo identity}}\n   220\t           (ffi/normalize {:op/echo identity})))\n   270\t                    {:dao.stream/outcome :dao.stream/ok,\n   271\t                     :dao.stream/cursor :in-0})\n   272\t\n   273\t                  (next [_ _] {:dao.stream/outcome :dao.stream/blocked})\n   274\t\n   275\t\n   276\t                  stream/IDaoStreamWriter\n   277\t\n   278\t                  (append!\n   279\t                    [_ v]\n   280\t                    (swap! attempts conj v)\n   281\t                    {:dao.stream/outcome :dao.stream/full}))\n   282\t        call-out (tu/new-stream 8)\n   283\t        vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   284\t                                   :call-in call-in,\n   285\t                                   :call-out call-out})\n   286\t        parked (vm/eval vm0 (call-ast :op/echo [3]))]\n   287\t    (testing \"A full call-in parks the call with its request retained\"\n   288\t      (is (vm/blocked? parked))\n   289\t      (is (= 1 (count (:wait-set parked))))\n   290\t      (let [waiter (first (:wait-set parked))\n   291\t            request (:datom waiter)\n   292\t            [parked-id] (keys (:parked parked))]\n   293\t        (is (= :put (:reason waiter)))\n   294\t        (is (= :dao.stream.apply/request-sent\n   295\t               (get-in waiter [:k :type])))\n   296\t        (is (apply2/request? request))\n   297\t        (is (= parked-id (apply2/request-id request))\n   298\t            \"The retained request keeps the allocated id for the retry\")\n   299\t        (is (= :op/echo (apply2/request-op request)))\n   300\t        (is (= [3] (apply2/request-args request)))))\n   301\t    (testing \"The polling wait set retries the identical encoded request\"\n   302\t      (is (vm/blocked? (vm/eval parked nil)))\n   303\t      (is (> (count @attempts) 1) \"The wait set retried the append\")\n   304\t      (is (apply = @attempts)\n   305\t          \"Every retry appends the identical encoded request\"))))\n   306\t\n   307\t\n   308\t(deftest full-request-is-sent-on-retry-and-answered-test\n   309\t  (let [delegate (tu/new-stream 8)\n   310\t        call-in (gated-call-in delegate 1)\n   311\t        call-out (tu/new-stream 8)\n   312\t        vm0 (ast-walker/create-vm {:make-stream tu/make-stream,\n   313\t                                   :call-in call-in,\n   314\t                                   :call-out call-out})\n   315\t        parked (vm/eval vm0 (call-ast :op/echo [5]))]\n   316\t    (testing \"The retry sent the request; the call waits for its response\"\n   317\t      (is (vm/blocked? parked))\n   318\t      (is (= 1 (count (:wait-set parked))))\n   319\t      (is (= :next (:reason (first (:wait-set parked))))\n   320\t          \"The waiter moved to the response side once the append succeeded\"))\n   321\t    (let [attached (ffi/attach parked {:op/echo identity})\n   322\t          {:keys [handled? request-id vm]} (ffi/bridge-step attached)\n   323\t          done (vm/eval vm nil)]\n   324\t      (is (true? handled?))\n   325\t      (is (= (first (keys (:parked parked))) request-id)\n   326\t          \"The answered request is the one the retry sent\")\n   327\t      (is (vm/halted? done))\n   328\t      (is (= 5 (vm/value done)))\n   329\t      (is (empty? (:parked done))))))\n   330\t\n   331\t\n   332\t(deftest completed-calls-leave-no-parked-entries-test\n   333\t  (testing \"A completed host call removes the continuation it parked\"\n   334\t    (let [vm0 (tu/create-vm {:bridge {:op/echo identity}})\n   335\t          first-done (vm/eval vm0 (call-ast :op/echo [1]))]\n   336\t      (is (vm/halted? first-done))\n   337\t      (is (empty? (:parked first-done)))\n   338\t      (let [second-done (vm/eval first-done (call-ast :op/echo [2]))]\n   339\t        (is (vm/halted? second-done))\n   340\t        (is (= 2 (vm/value second-done)))\n   341\t        (is (empty? (:parked second-done))\n   342\t            \"Repeated host calls do not accumulate in :parked\")))))\n     1\t(ns dao.stream.ws-test\n     2\t  (:require [clojure.test :refer [deftest is]]\n     3\t            [dao.stream :as stream]\n     4\t            [dao.stream.ringbuffer :as ring]\n     5\t            [dao.stream.transit :as transit]\n     6\t            [dao.stream.ws :as ws]))\n     7\t\n     8\t\n     9\t(defn- buffer\n    10\t  []\n    11\t  (:dao.stream/handle (ring/create! {:dao.stream/type :dao.stream/ringbuffer\n    12\t                                     :dao.stream.ringbuffer/capacity 16})))\n    13\t\n    14\t\n    15\t(def admission\n    16\t  {:retention :evict-oldest :capacity 16 :value-domain :portable-values})\n    17\t\n    18\t\n    19\t(def descriptor\n    20\t  {:dao.stream/type :dao.stream/ws\n    21\t   :dao.stream/identity \"logical-1\"\n    22\t   :ws/host \"127.0.0.1\"\n    23\t   :ws/port 9182\n    24\t   :ws/path \"/yin/repl\"})\n    25\t\n    26\t\n    27\t(defn- values\n    28\t  [handle]\n    29\t  (loop [cursor (:dao.stream/cursor (stream/cursor handle stream/anchor-oldest))\n    30\t         seen []]\n    31\t    (let [next (stream/next handle cursor)]\n    32\t      (if (= :dao.stream/ok (:dao.stream/outcome next))\n    33\t        (recur (:dao.stream/cursor next) (conj seen (:dao.stream/value next)))\n    34\t        seen))))\n    35\t\n    36\t\n    37\t(deftest client-attachment-is-a-writer-only-nonwaiting-handle\n    38\t  (let [traffic (buffer)\n    39\t        adapter (atom nil)\n    40\t        sent (atom [])\n    41\t        attacher (ws/make-attacher\n    42\t                   {:traffic {:dao.stream/handle traffic\n    43\t                              :dao.stream/surface #{:writer}}\n    44\t                    :admission admission\n    45\t                    :connect! (fn [_ adapter-map]\n    46\t                                (reset! adapter adapter-map)\n    47\t                                {:send! #(do (swap! sent conj %) nil) :close! (fn [& _] nil)})})\n    48\t        result (attacher descriptor)\n    49\t        handle (:dao.stream/handle result)]\n    50\t    (is (= :dao.stream/ok 