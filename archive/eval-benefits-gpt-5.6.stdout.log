\t\n   503\t;; =============================================================================\n   504\t;; Scheduler\n   505\t;; =============================================================================\n   506\t\n   507\t(defn- ast-walker-restore\n   508\t  ([base entry] (ast-walker-restore base entry (:value entry)))\n   509\t  ([base entry val] (cesk-return base nil (:env entry) (:k entry) val)))\n   510\t\n   511\t\n   512\t(defn- resume-from-run-queue\n   513\t  \"Pop first entry from the ready-queue and resume it as the active\n   514\t   computation. Returns updated state or nil if the queue is empty.\"\n   515\t  [state]\n   516\t  (engine/resume-from-run-queue state ast-walker-restore))\n   517\t\n   518\t\n   519\t(defn- ast-walker-run-active-continuation\n   520\t  \"Hot loop that keeps CESK state in host locals instead of an immutable\n   521\t   record. Inlines common transitions to reduce allocation overhead.\"\n   522\t  [^ASTWalkerVM vm-init control-init env-init k-init val-init]\n   523\t  (loop [control control-init\n   524\t         env env-init\n   525\t         k k-init\n   526\t         val val-init\n   527\t         vm vm-init]\n   528\t    (let [node control\n   529\t          type (:type node)]\n   530\t      (cond\n   531\t        (and (nil? node) k)\n   532\t        (let [cont-type (:type k)]\n   533\t          (case cont-type\n   534\t            :eval-operator\n   535\t            (let [frame (:frame k)\n   536\t                  fn-value val\n   537\t                  operands (:operands frame)\n   538\t                  saved-env (or (:env k) env)]\n   539\t              (if (empty? operands)\n   540\t                (cond (= :closure (:type fn-value))\n   541\t                      (let [{:keys [params body], closure-env :env} fn-value\n   542\t                            extended-env (merge closure-env (zipmap params []))]\n   543\t                        (recur body extended-env (:next k) val vm))\n   544\t                      (fn? fn-value)\n   545\t                      (let [result (apply fn-value [])]\n   546\t                        (if (module/effect? result)\n   547\t                          (let [state (cesk-return vm control env k val)\n   548\t                                res (handle-primitive-result state\n   549\t                                                             result\n   550\t                                                             (:next k)\n   551\t                                                             saved-env)]\n   552\t                            (if (or (:blocked? res)\n   553\t                                    (and (nil? (:control res)) (nil? (:k res))))\n   554\t                              res\n   555\t                              (recur (:control res)\n   556\t                                     (:env res)\n   557\t                                     (:k res)\n   558\t                                     (:value res)\n   559\t                                     res)))\n   560\t                          (recur nil saved-env (:next k) result vm)))\n   561\t                      :else (throw (ex-info \"Cannot apply non-function\"\n   562\t                                            {:fn fn-value})))\n   563\t                (let [updated-frame (assoc frame\n   564\t                                           :operator-evaluated? true\n   565\t                                           :fn fn-value)]\n   566\t                  (recur (first operands)\n   567\t                         saved-env\n   568\t                         (assoc k\n   569\t                                :type :eval-operand\n   570\t                                :frame updated-frame)\n   571\t                         nil\n   572\t                         vm))))\n   573\t            :eval-operand\n   574\t            (let [frame (:frame k)\n   575\t                  operand-value val\n   576\t                  evaluated (conj (or (:evaluated frame) []) operand-value)\n   577\t                  operands (:operands frame)\n   578\t                  saved-env (or (:env k) env)]\n   579\t              (if (= (count evaluated) (count operands))\n   580\t                (let [fn-value (:fn frame)]\n   581\t                  (cond (= :closure (:type fn-value))\n   582\t                        (let [{:keys [params body], closure-env :env} fn-value\n   583\t                              extended-env (merge closure-env\n   584\t                                                  (zipmap params evaluated))]\n   585\t                          (recur body extended-env (:next k) val vm))\n   586\t                        (fn? fn-value)\n   587\t                        (let [result (apply fn-value evaluated)]\n   588\t                          (if (module/effect? result)\n   589\t                            (let [state (cesk-return vm control env k val)\n   590\t                                  res (handle-primitive-result state\n   591\t                                                               result\n   592\t                                                               (:next k)\n   593\t                                                               saved-env)]\n   594\t                              (if (or (:blocked? res)\n   595\t                                      (and (nil? (:control res))\n   596\t                                           (nil? (:k res))))\n   597\t                                res\n   598\t                                (recur (:control res)\n   599\t                                       (:env res)\n   600\t                                       (:k res)\n   601\t                                       (:value res)\n   602\t                                       res)))\n   603\t                            (recur nil saved-env (:next k) result vm)))\n   604\t                        :else (throw (ex-info \"Cannot apply non-function\"\n   605\t                                              {:fn fn-value}))))\n   606\t                (let [next-idx (count evaluated)\n   607\t                      next-node (nth operands next-idx)\n   608\t                      updated-frame (assoc frame :evaluated evaluated)]\n   609\t                  (recur next-node\n   610\t                         saved-env\n   611\t                         (assoc k :frame updated-frame)\n   612\t                         nil\n   613\t                         vm))))\n   614\t            :eval-test (let [frame (:frame k)\n   615\t                             test-value val\n   616\t                             saved-env (or (:env k) env)\n   617\t                             branch (if test-value\n   618\t                                      (:consequent frame)\n   619\t                                      (:alternate frame))]\n   620\t                         (recur branch saved-env (:next k) test-value vm))\n   621\t            (let [state (cesk-return vm control env k val)\n   622\t                  next (cesk-transition state nil)]\n   623\t              (if (or (:blocked? next)\n   624\t                      (and (nil? (:control next)) (nil? (:k next))))\n   625\t                next\n   626\t                (recur (:control next)\n   627\t                       (:env next)\n   628\t                       (:k next)\n   629\t                       (:value next)\n   630\t                       next)))))\n   631\t        node (case type\n   632\t               :literal (recur nil env k (:value node) vm)\n   633\t               :variable (let [v (engine/resolve-var env\n   634\t                                                     (:store vm)\n   635\t                                                     (:primitives vm)\n   636\t                                                     (:modules vm)\n   637\t                                                     (:name node))]\n   638\t                           (recur nil env k v vm))\n   639\t               :lambda (recur nil\n   640\t                              env\n   641\t                              k\n   642\t                              {:type :closure,\n   643\t                               :params (:params node),\n   644\t                               :body (:body node),\n   645\t                               :env env}\n   646\t                              vm)\n   647\t               :application\n   648\t               (recur (:operator node)\n   649\t                      env\n   650\t                      {:frame node, :next k, :env env, :type :eval-operator}\n   651\t                      val\n   652\t                      vm)\n   653\t               :if (recur (:test node)\n   654\t                          env\n   655\t                          {:frame node, :next k, :env env, :type :eval-test}\n   656\t                          val\n   657\t                          vm)\n   658\t               (let [state (cesk-return vm node env k val)\n   659\t                     next (cesk-transition state nil)]\n   660\t                 (if (or (:blocked? next)\n   661\t                         (and (nil? (:control next)) (nil? (:k next))))\n   662\t                   next\n   663\t                   (recur (:control next)\n   664\t                          (:env next)\n   665\t                          (:k next)\n   666\t                          (:value next)\n   667\t                          next))))\n   668\t        :else (let [result (cesk-return vm control env k val)]\n   669\t                (cond (:blocked? result)\n   670\t                      (let [v' (engine/check-wait-set result)]\n   671\t                        (if-let [resumed (resume-from-run-queue v')]\n   672\t                          (recur (:control resumed)\n   673\t                                 (:env resumed)\n   674\t                                 (:k resumed)\n   675\t                                 (:value resumed)\n   676\t                                 resumed)\n   677\t                          v'))\n   678\t                      (seq (or (:ready-queue result) []))\n   679\t                      (if-let [resumed (resume-from-run-queue result)]\n   680\t                        (recur (:control resumed)\n   681\t                               (:env resumed)\n   682\t                               (:k resumed)\n   683\t                               (:value resumed)\n   684\t                               resumed)\n   685\t                        result)\n   686\t                      :else result))))))\n   687\t\n   688\t\n   689\t;; =============================================================================\n   690\t;; ASTWalkerVM Protocol Implementation\n   691\t;; =============================================================================\n   692\t\n   693\t(defn- vm-step\n   694\t  \"Execute one step of ASTWalkerVM. Returns updated VM.\"\n   695\t  [^ASTWalkerVM vm]\n   696\t  (cesk-transition vm nil))\n   697\t\n   698\t\n   699\t(defn- vm-halted?\n   700\t  [^ASTWalkerVM vm]\n   701\t  (engine/halted-with-empty-queue? vm))\n   702\t\n   703\t\n   704\t(defn- vm-blocked?\n   705\t  [^ASTWalkerVM vm]\n   706\t  (engine/vm-blocked? vm))\n   707\t\n   708\t\n   709\t(defn- vm-value\n   710\t  [^ASTWalkerVM vm]\n   711\t  (engine/vm-value vm))\n   712\t\n   713\t\n   714\t(defn- vm-load-program\n   715\t  \"Load one datom transaction into the VM.\"\n   716\t  [^ASTWalkerVM vm datoms]\n   717\t  (let [ast (vm/datoms->ast datoms)]\n   718\t    (assoc vm\n   719\t           :program ast\n   720\t           :control ast\n   721\t           :halted? false\n   722\t           :blocked? false\n   723\t           :value nil)))\n   724\t\n   725\t\n   726\t(defn- vm-reset\n   727\t  \"Reset execution state, preserving the loaded AST program.\"\n   728\t  [^ASTWalkerVM vm]\n   729\t  (assoc vm\n   730\t         :control (:program vm)\n   731\t         :k nil\n   732\t         :halted? (nil? (:program vm))\n   733\t         :value nil\n   734\t         :blocked? false))\n   735\t\n   736\t\n   737\t(defn- ast-walker-run-scheduler\n   738\t  \"Thin wrapper over engine/run-loop with vm-step (slow path).\"\n   739\t  [vm]\n   740\t  (engine/run-loop vm\n   741\t                   engine/active-continuation?\n   742\t                   vm-step\n   743\t                   resume-from-run-queue\n   744\t                   ast-walker-restore))\n   745\t\n   746\t\n   747\t(defn- vm-eval\n   748\t  \"Evaluate an AST. Owns the step loop with scheduler.\n   749\t   When ast is non-nil, loads it first. When nil, resumes from current state.\"\n   750\t  [^ASTWalkerVM vm ast]\n   751\t  (let [initial-env (:env vm)\n   752\t        res (if ast\n   753\t              (-> vm\n   754\t                  (vm-load-program (vm/ast->datoms ast))\n   755\t                  (vm/run))\n   756\t              (vm/run vm))]\n   757\t    (engine/restore-initial-env initial-env res)))\n   758\t\n   759\t\n   760\t(defn- ast-walker-run-on-stream\n   761\t  [vm]\n   762\t  (engine/run-on-stream vm\n   763\t                        (:in-stream vm)\n   764\t                        vm-load-program\n   765\t                        vm-step\n   766\t                        resume-from-run-queue\n   767\t                        ast-walker-restore))\n   768\t\n   769\t\n   770\t(extend-type ASTWalkerVM\n   771\t  vm/IVM\n   772\t  (step [vm]\n   773\t    (telemetry/emit-snapshot\n   774\t      (engine/step-on-stream vm (:in-stream vm) vm-load-program vm-step)\n   775\t      :step))\n   776\t  (run [vm] (ffi/maybe-run vm ast-walker-run-on-stream))\n   777\t  (eval [vm ast] (vm-eval vm ast))\n   778\t  (reset [vm] (vm-reset vm))\n   779\t  (halted? [vm] (vm-halted? vm))\n   780\t  (blocked? [vm] (vm-blocked? vm))\n   781\t  (value [vm] (vm-value vm))\n   782\t  vm/IVMState\n   783\t  (control [vm] (:control vm))\n   784\t  (environment [vm] (:env vm))\n   785\t  (store [vm] (:store vm))\n   786\t  (continuation [vm]\n   787\t    (when-let [k-head (:k vm)]\n   788\t      (loop [k k-head\n   789\t             acc []]\n   790\t        (if (nil? k) acc (recur (:next k) (conj acc k)))))))\n     1\t(ns yin.vm.module\n     2\t  \"Module system for Yin VM v2.\n     3\t\n     4\t   The v1 module system kept two `defonce` atoms and mutated them at load\n     5\t   time. A registry is a value here: an ordinary map carried in VM state and\n     6\t   supplied by the composition that wires the VM.\n     7\t\n     8\t     (-> (empty-registry)\n     9\t         (register-module 'my.lib {'foo (fn [x] x)})\n    10\t         (register-stream-module))\n    11\t\n    12\t   Nothing in this namespace runs at load time, and nothing registers itself.\n    13\t   A composition that wants Yin source to reach `(stream/...)` registers the\n    14\t   stream module explicitly and supplies `:make-stream` beside it.\"\n    15\t  (:require\n    16\t    [clojure.string :as str]))\n    17\t\n    18\t\n    19\t;; =============================================================================\n    20\t;; Registry values\n    21\t;; =============================================================================\n    22\t\n    23\t(defn empty-registry\n    24\t  \"An empty module registry value.\"\n    25\t  []\n    26\t  {:modules {}, :effect-handlers {}})\n    27\t\n    28\t\n    29\t(defn- symbol->path\n    30\t  \"Split a dotted symbol into a get-in path of symbols.\n    31\t   'yin.io.file-input-stream → ['yin 'io 'file-input-stream]\"\n    32\t  [sym]\n    33\t  (mapv symbol (str/split (str sym) #\"\\.\")))\n    34\t\n    35\t\n    36\t(defn register-module\n    37\t  \"Return registry with bindings merged into module-name.\n    38\t   module-name is a dotted symbol; bindings is a map of symbol -> function.\"\n    39\t  [registry module-name bindings]\n    40\t  (update-in (or registry (empty-registry))\n    41\t             (into [:modules] (symbol->path module-name))\n    42\t             merge\n    43\t             bindings))\n    44\t\n    45\t\n    46\t(defn resolve-module\n    47\t  \"Get a value from a registry value by dotted symbol path.\n    48\t   (resolve-module r 'io)                    → full 'io bindings map\n    49\t   (resolve-module r 'io.file-output-stream) → the specific binding\"\n    50\t  [registry sym]\n    51\t  (get-in (:modules registry) (symbol->path sym)))\n    52\t\n    53\t\n    54\t(defn register-effect-handler\n    55\t  \"Return registry with handler-fn installed for effect keyword kw.\n    56\t   Handler: (fn [state effect opts] -> {:state s :value v :blocked? bool})\"\n    57\t  [registry kw handler-fn]\n    58\t  (assoc-in (or registry (empty-registry)) [:effect-handlers kw] handler-fn))\n    59\t\n    60\t\n    61\t(defn get-effect-handler\n    62\t  \"Get the handler function for an effect keyword.\"\n    63\t  [registry kw]\n    64\t  (get (:effect-handlers registry) kw))\n    65\t\n    66\t\n    67\t(defn list-modules\n    68\t  \"List the top-level module names in a registry value.\"\n    69\t  [registry]\n    70\t  (keys (:modules registry)))\n    71\t\n    72\t\n    73\t;; =============================================================================\n    74\t;; Effect descriptors\n    75\t;; =============================================================================\n    76\t\n    77\t(defn effect?\n    78\t  \"Check if a value is an effect descriptor.\"\n    79\t  [x]\n    80\t  (and (map? x) (contains? x :effect)))\n    81\t\n    82\t\n    83\t(defn make-effect\n    84\t  \"Create an effect descriptor.\"\n    85\t  [effect-type & {:as params}]\n    86\t  (assoc params :effect effect-type))\n    87\t\n    88\t\n    89\t;; =============================================================================\n    90\t;; The `stream` module\n    91\t;; =============================================================================\n    92\t;;\n    93\t;; These are pure data constructors. They touch no stream: Yin source calls\n    94\t;; them through the module system, they return effect maps, and the engine\n    95\t;; interprets those. `take!` is deliberately absent — destructive read is one\n    96\t;; reader's progress and every other reader's data loss, and a v2 `take!` would\n    97\t;; need the reader-position-in-the-medium the contract retired.\n    98\t\n    99\t(defn make\n   100\t  ([] (make nil))\n   101\t  ([cap] {:effect :stream/make, :capacity cap}))\n   102\t\n   103\t\n   104\t(defn put!\n   105\t  [s v]\n   106\t  {:effect :stream/put, :stream s, :val v})\n   107\t\n   108\t\n   109\t(defn cursor\n   110\t  [s]\n   111\t  {:effect :stream/cursor, :stream s})\n   112\t\n   113\t\n   114\t(defn next!\n   115\t  [c]\n   116\t  {:effect :stream/next, :cursor c})\n   117\t\n   118\t\n   119\t(defn close!\n   120\t  [s]\n   121\t  {:effect :stream/close, :stream s})\n   122\t\n   123\t\n   124\t(def stream-module\n   125\t  \"The v2 `stream` module definition. Registering it is a composition step.\"\n   126\t  {'make make, 'put! put!, 'cursor cursor, 'next! next!, 'close! close!})\n   127\t\n   128\t\n   129\t(defn register-stream-module\n   130\t  \"Return registry with the v2 `stream` module registered.\n   131\t   A composition that calls this must also supply `:make-stream`, or\n   132\t   `(stream/make)` is unsupported and says so.\"\n   133\t  [registry]\n   134\t  (register-module registry 'stream stream-module))\n   135\t\n   136\t\n   137\t;; =============================================================================\n   138\t;; Built-in effect handlers\n   139\t;; =============================================================================\n   140\t\n   141\t(defn require-handler\n   142\t  \"Resolve `:module/require` against the registry value only.\n   143\t\n   144\t   v1's clj branch called `clojure.core/require` from inside effect dispatch —\n   145\t   a host call in the middle of interpretation. It does not survive: a module\n   146\t   is either in the registry the composition supplied or it is not.\"\n   147\t  [state effect _opts]\n   148\t  (let [module-name (:module effect)]\n   149\t    (if (some? (resolve-module (:modules state) module-name))\n   150\t      {:value module-name, :state state, :blocked? false}\n   151\t      (throw (ex-info \"Module is not in this VM's registry\"\n   152\t                      {:module module-name,\n   153\t                       :available (vec (list-modules (:modules state)))})))))\n   154\t\n   155\t\n   156\t(defn default-registry\n   157\t  \"A registry with the built-in effect handlers and no modules.\"\n   158\t  []\n   159\t  (-> (empty-registry)\n   160\t      (register-effect-handler :module/require require-handler)))\n     1\t(ns yin.vm.telemetry\n     2\t  \"Telemetry stub for the v2 VM slice.\n     3\t\n     4\t   v1's `emit-snapshot` short-circuits on `(if-not (enabled? state) state ...)`,\n     5\t   and `enabled?` asks whether a telemetry stream is installed. With none\n     6\t   installed, every call site in the engine, the FFI and the evaluator is\n     7\t   already a no-op returning state unchanged. This namespace makes that the\n     8\t   whole implementation: nothing appends, nothing is created, no capacity is\n     9\t   chosen.\n    10\t\n    11\t   `type-tag` is real, because `ffi` evaluates `(mapv type-tag request-args)`\n    12\t   as an *argument* to `emit-snapshot`, so it runs before the no-op check.\n    13\t\n    14\t   A supplied `:telemetry` option is rejected rather than ignored. A stub that\n    15\t   merely recorded the model would accept a stream and then write nothing to it\n    16\t   forever; silent acceptance is the one way this stub could mislead.\n    17\t\n    18\t   What is deferred with the real emit path: reading `append!` outcomes,\n    19\t   ordering the three surface protocols before the `map?` branch, summarising a\n    20\t   cursor-ref without descent, and the cursor recognition problem — v2 cursors\n    21\t   are opaque and the contract offers no predicate for one.\"\n    22\t  (:require [dao.stream :as stream]))\n    23\t\n    24\t\n    25\t(def deferral-message\n    26\t  \"Telemetry is deferred in the yin.vm slice; a :telemetry option would name a stream that is never written\")\n    27\t\n    28\t\n    29\t(defn reject-telemetry-opt!\n    30\t  \"Throw when a non-nil telemetry configuration is supplied.\"\n    31\t  [telemetry]\n    32\t  (when (some? telemetry)\n    33\t    (throw (ex-info deferral-message {:telemetry telemetry})))\n    34\t  nil)\n    35\t\n    36\t\n    37\t(defn enabled?\n    38\t  \"Always false in this slice.\"\n    39\t  [_state]\n    40\t  false)\n    41\t\n    42\t\n    43\t(defn install\n    44\t  \"Record the VM model. Rejects a supplied `:telemetry` option.\"\n    45\t  [state model]\n    46\t  (reject-telemetry-opt! (:telemetry state))\n    47\t  (assoc state\n    48\t         :vm-model model\n    49\t         :telemetry-step (or (:telemetry-step state) 0)\n    50\t         :telemetry-t (or (:telemetry-t state) 0)))\n    51\t\n    52\t\n    53\t(defn next-telemetry-state\n    54\t  [state]\n    55\t  state)\n    56\t\n    57\t\n    58\t(defn type-tag\n    59\t  \"Classify a value for the deferred emit path.\n    60\t\n    61\t   Any handle is `:opaque`: distinguishing surfaces means ordering all three\n    62\t   surface protocols before the `map?` branch, which belongs to the real emit\n    63\t   path and not to a stub.\"\n    64\t  [value]\n    65\t  (cond (nil? value) :nil\n    66\t        (boolean? value) :boolean\n    67\t        (number? value) :number\n    68\t        (string? value) :string\n    69\t        (keyword? value) :keyword\n    70\t        (symbol? value) :symbol\n    71\t        (fn? value) :host-fn\n    72\t        (stream/descriptor? value) :opaque\n    73\t        (vector? value) :vector\n    74\t        (map? value) :map\n    75\t        (sequential? value) :sequence\n    76\t        :else :opaque))\n    77\t\n    78\t\n    79\t(defn emit-snapshot\n    80\t  \"Identity on state. Both arities survive: the FFI and the evaluator use\n    81\t   different ones.\"\n    82\t  ([state _phase] state)\n    83\t  ([state _phase _opts] state))\n     1\t(ns dao.runtime\n     2\t  \"Cooperative scheduler over DaoStream v2.\n     3\t\n     4\t   Three things v1 had are gone here, and their absence is the point:\n     5\t\n     6\t   - **Waiters.** No v2 transport is waitable, so `register-reader-waiter!`\n     7\t     and the `:woke` entries an append returned have no v2 counterpart. The\n     8\t     polling wait set is not a fallback any more; it is the mechanism.\n     9\t   - **Destructive take.** `:take` entries cannot exist without a reader\n    10\t     position held in the medium.\n    11\t   - **`closed?`.** Nothing asks a stream whether it is closed. Operations\n    12\t     report `:dao.stream/closed` and callers read the answer.\n    13\t\n    14\t   Cursors are opaque values obtained from the transport. Nothing here does\n    15\t   arithmetic on one.\"\n    16\t  (:require [dao.stream :as stream]))\n    17\t\n    18\t\n    19\t;; =============================================================================\n    20\t;; Core Runtime State\n    21\t;; =============================================================================\n    22\t\n    23\t(defn initial-state\n    24\t  \"Returns a new empty runtime state.\"\n    25\t  []\n    26\t  {:ready-queue [], :wait-set [], :blocked? false})\n    27\t\n    28\t\n    29\t;; =============================================================================\n    30\t;; Task Management\n    31\t;; =============================================================================\n    32\t\n    33\t(defn park-task\n    34\t  \"Record a blocked task in the wait-set.\"\n    35\t  [rt entry]\n    36\t  (update rt :wait-set (fnil conj []) entry))\n    37\t\n    38\t\n    39\t(defn enqueue-ready\n    40\t  \"Add runnable task entries to the end of the ready-queue.\"\n    41\t  [rt entries]\n    42\t  (if (seq entries) (update rt :ready-queue (fnil into []) entries) rt))\n    43\t\n    44\t\n    45\t(defn pop-ready\n    46\t  \"Fetch and remove the next runnable task from the ready-queue.\n    47\t   Returns [entry updated-rt] or nil.\"\n    48\t  [rt]\n    49\t  (let [queue (:ready-queue rt)]\n    50\t    (when (seq queue)\n    51\t      [(first queue) (assoc rt :ready-queue (subvec queue 1))])))\n    52\t\n    53\t\n    54\t;; =============================================================================\n    55\t;; Outcome classification\n    56\t;; =============================================================================\n    57\t;;\n    58\t;; Both read and write are total over their closed outcome sets. A task waits\n    59\t;; only for the two outcomes that can change on their own — `blocked` and\n    60\t;; `full`. Every other outcome resolves the task, because retrying it would\n    61\t;; either spin forever or conceal a loss the task has to see.\n    62\t\n    63\t(defn read-outcome->task\n    64\t  \"Classify a `next` outcome for a waiting reader.\n    65\t   Returns [:wait] or [:ready entry-updates].\"\n    66\t  [result]\n    67\t  (case (:dao.stream/outcome result)\n    68\t    :dao.stream/ok [:ready {:value (:dao.stream/value result),\n    69\t                            :status :ok,\n    70\t                            :cursor (:dao.stream/cursor result)}]\n    71\t    :dao.stream/blocked [:wait]\n    72\t    :dao.stream/end [:ready {:value nil, :status :end}]\n    73\t    ;; A gap advances to the transport's recovery cursor. The reader is told\n    74\t    ;; what happened: values it had not read are gone and no retry recovers\n    75\t    ;; them.\n    76\t    :dao.stream/gap [:ready {:value :dao.stream/gap,\n    77\t                             :status :dao.stream/gap,\n    78\t                             :cursor (:dao.stream/cursor result)}]\n    79\t    (:dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n    80\t                                 :dao.stream/transport-error)\n    81\t    [:ready {:value (:dao.stream/outcome result),\n    82\t             :status (:dao.stream/outcome result)}]\n    83\t    ;; A transport that answers outside the closed set is terminal here;\n    84\t    ;; waiting on an answer this namespace cannot interpret would spin.\n    85\t    [:ready {:value (:dao.stream/outcome result),\n    86\t             :status (:dao.stream/outcome result)}]))\n    87\t\n    88\t\n    89\t(defn write-outcome->task\n    90\t  \"Classify an `append!` outcome for a waiting writer.\n    91\t   Returns [:wait] or [:ready entry-updates].\n    92\t\n    93\t   `full` parks: the composition may have supplied a transport that frees\n    94\t   capacity. A ring buffer never returns it.\"\n    95\t  [result val]\n    96\t  (case (:dao.stream/outcome result)\n    97\t    :dao.stream/ok [:ready {:value val, :status :ok}]\n    98\t    :dao.stream/full [:wait]\n    99\t    :dao.stream/closed [:ready {:value nil, :status :end}]\n   100\t    (:dao.stream/invalid-value :dao.stream/transport-error)\n   101\t    [:ready {:value (:dao.stream/outcome result),\n   102\t             :status (:dao.stream/outcome result)}]\n   103\t    [:ready {:value (:dao.stream/outcome result),\n   104\t             :status (:dao.stream/outcome result)}]))\n   105\t\n   106\t\n   107\t;; =============================================================================\n   108\t;; Wait set\n   109\t;; =============================================================================\n   110\t\n   111\t(defn check-wait-set\n   112\t  \"Check wait-set entries against their transports.\n   113\t   Returns updated state with newly runnable entries moved to ready-queue.\"\n   114\t  [rt]\n   115\t  (let [wait-set (:wait-set rt)]\n   116\t    (if (empty? wait-set)\n   117\t      rt\n   118\t      (loop [remaining wait-set\n   119\t             new-wait []\n   120\t             new-ready (or (:ready-queue rt) [])]\n   121\t        (if (empty? remaining)\n   122\t          (assoc rt\n   123\t                 :wait-set new-wait\n   124\t                 :ready-queue new-ready)\n   125\t          (let [entry (first remaining)\n   126\t                rest-entries (rest remaining)\n   127\t                [disposition updates]\n   128\t                (case (:reason entry)\n   129\t                  :next (read-outcome->task\n   130\t                          (stream/next (:stream entry) (:cursor entry)))\n   131\t                  :put (write-outcome->task\n   132\t                         (stream/append! (:stream entry) (:datom entry))\n   133\t                         (:datom entry))\n   134\t                  ;; Unknown reason, keep waiting.\n   135\t                  [:wait])]\n   136\t            (if (= :wait disposition)\n   137\t              (recur rest-entries (conj new-wait entry) new-ready)\n   138\t              (recur rest-entries\n   139\t                     new-wait\n   140\t                     (conj new-ready (merge entry updates))))))))))\n   141\t\n   142\t\n   143\t;; =============================================================================\n   144\t;; Public Operation Handlers\n   145\t;; =============================================================================\n   146\t\n   147\t(defn handle-read\n   148\t  \"Attempt a read. If blocked, park the task.\n   149\t   Returns {:state updated-rt :result result-tag :value v :cursor c}.\"\n   150\t  [rt handle cursor task]\n   151\t  (let [result (stream/next handle cursor)\n   152\t        [disposition updates] (read-outcome->task result)]\n   153\t    (if (= :wait disposition)\n   154\t      (if task\n   155\t        {:state (-> rt\n   156\t                    (park-task (assoc task\n   157\t                                      :reason :next\n   158\t                                      :stream handle\n   159\t                                      :cursor cursor))\n   160\t                    (assoc :blocked? true)),\n   161\t         :result :blocked}\n   162\t        {:state (assoc rt :blocked? true), :result :blocked})\n   163\t      {:state rt,\n   164\t       :result (:status updates),\n   165\t       :value (:value updates),\n   166\t       :cursor (:cursor updates)})))\n   167\t\n   168\t\n   169\t(defn handle-write\n   170\t  \"Attempt an append. If full, park the task.\n   171\t   Returns {:state updated-rt :result result-tag :value v}.\"\n   172\t  ([rt handle val] (handle-write rt handle val nil))\n   173\t  ([rt handle val task]\n   174\t   (let [result (stream/append! handle val)\n   175\t         [disposition updates] (write-outcome->task result val)]\n   176\t     (if (= :wait disposition)\n   177\t       (if task\n   178\t         {:state (-> rt\n   179\t                     (park-task (assoc task\n   180\t                                       :reason :put\n   181\t                                       :stream handle\n   182\t                                       :datom val))\n   183\t                     (assoc :blocked? true)),\n   184\t          :result :full}\n   185\t         {:state (assoc rt :blocked? true), :result :full})\n   186\t       {:state rt, :result (:status updates), :value (:value updates)}))))\n   187\t\n   188\t\n   189\t(defn handle-close\n   190\t  \"Close a stream. `close!` is total over {ok} and wakes nothing: a reader\n   191\t   parked on this stream learns of the close from its own next `next`.\n   192\t   Returns {:state rt :result :ok}.\"\n   193\t  [rt handle]\n   194\t  (stream/close! handle)\n   195\t  {:state rt, :result :ok})\n   196\t\n   197\t\n   198\t;; =============================================================================\n   199\t;; Runtime Loop\n   200\t;; =============================================================================\n   201\t\n   202\t(defn run-once\n   203\t  \"Fetch one ready task and resume it.\n   204\t   Returns updated state or nil if no work.\n   205\t   If the next entry has no :resume function, it is not runnable by\n   206\t   run-once; returns nil so the host can handle the entry itself.\"\n   207\t  [rt]\n   208\t  (let [take-one (fn [state]\n   209\t                   (let [queue (or (:ready-queue state) [])]\n   210\t                     (when (seq queue)\n   211\t                       (let [entry (first queue)]\n   212\t                         (when (:resume entry)\n   213\t                           (let [[entry state'] (pop-ready state)]\n   214\t                             ((:resume entry) state' entry (:value entry))))))))]\n   215\t    (or (take-one rt) (take-one (check-wait-set rt)))))\n   216\t\n   217\t\n   218\t(defn run-loop\n   219\t  \"Drain ready tasks, then check wait-set, until quiescent.\"\n   220\t  [rt]\n   221\t  (loop [curr-rt rt]\n   222\t    (if-let [next-rt (run-once curr-rt)]\n   223\t      (recur next-rt)\n   224\t      curr-rt)))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The implementation does fix the happy-path FFI accumulation: a successful correlated response removes its parked entry. But the guarantee is not general—reset preserves parked/waiting state, and bridge terminal/failure paths can return a blocked VM with the parked continuation still retained. I’m checking tests now to see whether those adversarial paths are covered or merely documented as fatal."}}
