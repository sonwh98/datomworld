c:376:        (update :parked assoc park-id parked)\nsrc/cljc/yin/vm/engine.cljc:377:        (assoc :value parked\nsrc/cljc/yin/vm/engine.cljc:380:        (telemetry/emit-snapshot :park {:parked-id park-id}))))\nsrc/cljc/yin/vm/engine.cljc:383:(defn resume-continuation\nsrc/cljc/yin/vm/engine.cljc:386:  (if-let [parked (get-in state [:parked parked-id])]\nsrc/cljc/yin/vm/engine.cljc:387:    (let [new-state (update state :parked dissoc parked-id)]\nsrc/cljc/yin/vm/engine.cljc:389:          (telemetry/emit-snapshot :resume {:parked-id parked-id})))\nsrc/cljc/yin/vm/engine.cljc:391:          {:parked-id parked-id})))\nsrc/cljc/yin/vm/engine.cljc:403:(defn handle-stream-block\nsrc/cljc/yin/vm/engine.cljc:418:(defn handle-effect\nsrc/cljc/yin/vm/engine.cljc:531:        k-versions (frame-versions (:k vm))\nsrc/cljc/yin/vm/engine.cljc:532:        parked-versions (collect-frame-versions (vals (:parked vm)))\nsrc/cljc/yin/vm/engine.cljc:533:        ready-versions (collect-frame-versions (:ready-queue vm))\nsrc/cljc/yin/vm/engine.cljc:534:        wait-versions (collect-frame-versions (:wait-set vm))]\n     1\t(ns yin.vm.engine\n     2\t  \"Shared evaluation machinery for Yin VMs on DaoStream v2.\n     3\t\n     4\t   What the port changed, and why:\n     5\t\n     6\t   - **The host supplies streams.** `:stream/make` calls the composition's\n     7\t     `:make-stream`; there is no transport identity in this namespace. Every\n     8\t     other stream handler is a protocol call on a handle already in the store.\n     9\t   - **Cursors are opaque.** A store cursor entry is\n    10\t     `{:stream-id id :cursor <opaque>}`. Nothing increments one.\n    11\t   - **Outcomes are maps, and every handler is total over its closed set.**\n    12\t     `blocked` and `full` park; `end` and `gap` are values the program sees;\n    13\t     the rest are errors that name their outcome.\n    14\t   - **Waiters are gone.** No v2 transport is waitable, so the polling wait\n    15\t     set is the mechanism rather than a fallback. Cadence comes from the\n    16\t     driver above the VM.\n    17\t   - **`:stream/take` is gone.** Destructive read needs a reader position in\n    18\t     the medium, which the contract retired.\n    19\t   - **The module registry is a value** carried in VM state, so effect\n    20\t     dispatch and `resolve-var` read a supplied registry rather than a global.\"\n    21\t  (:refer-clojure :exclude [gensym])\n    22\t  (:require [clojure.set]\n    23\t            [dao.datom :as datom]\n    24\t            [dao.runtime :as rt]\n    25\t            [dao.stream :as stream]\n    26\t            [yin.vm :as vm]\n    27\t            [yin.vm.module :as module]\n    28\t            [yin.vm.runtime-adapter :as adapter]\n    29\t            [yin.vm.stream-driver :as stream-driver]\n    30\t            [yin.vm.telemetry :as telemetry]))\n    31\t\n    32\t\n    33\t(defn- outcome\n    34\t  [result]\n    35\t  (:dao.stream/outcome result))\n    36\t\n    37\t\n    38\t(defn- fail\n    39\t  [message data]\n    40\t  (throw (ex-info message data)))\n    41\t\n    42\t\n    43\t(defn resolve-var\n    44\t  \"Look up a variable name: env -> store -> primitives -> module registry.\n    45\t\n    46\t   The registry is a value supplied by the composition, not a global.\"\n    47\t  [env store primitives registry name]\n    48\t  (if-let [pair (find env name)]\n    49\t    (val pair)\n    50\t    (if-let [pair (find store name)]\n    51\t      (val pair)\n    52\t      (if-let [pair (find primitives name)]\n    53\t        (val pair)\n    54\t        (if-let [resolved (when (namespace name)\n    55\t                            (module/resolve-module\n    56\t                              registry\n    57\t                              (symbol (str (namespace name)\n    58\t                                           \".\"\n    59\t                                           (clojure.core/name name)))))]\n    60\t          resolved\n    61\t          (fail (str \"Unable to resolve symbol: \" name \" in this context\")\n    62\t                {:symbol name}))))))\n    63\t\n    64\t\n    65\t(defn- gen-id\n    66\t  \"Generate a unique keyword ID from a prefix and counter value.\"\n    67\t  [prefix id-counter]\n    68\t  (keyword (str prefix \"-\" id-counter)))\n    69\t\n    70\t\n    71\t(defn vm-blocked?\n    72\t  \"Returns true if the VM is blocked.\"\n    73\t  [vm]\n    74\t  (boolean (:blocked? vm)))\n    75\t\n    76\t\n    77\t(defn vm-value\n    78\t  \"Returns the current value of the VM.\"\n    79\t  [vm]\n    80\t  (:value vm))\n    81\t\n    82\t\n    83\t(defn halted-with-empty-queue?\n    84\t  \"Returns true if the VM has halted and its ready-queue is empty.\"\n    85\t  [vm]\n    86\t  (and (boolean (:halted? vm)) (empty? (or (:ready-queue vm) []))))\n    87\t\n    88\t\n    89\t(defn restore-initial-env\n    90\t  \"After eval, restore :env to initial-env when the computation halted.\n    91\t   Blocked and parked states keep the active lexical env for resumption.\"\n    92\t  [initial-env result]\n    93\t  (if (halted-with-empty-queue? result) (assoc result :env initial-env) result))\n    94\t\n    95\t\n    96\t(defn active-continuation?\n    97\t  \"Returns true when the currently active continuation should keep stepping.\"\n    98\t  [vm]\n    99\t  (and (not (:blocked? vm)) (not (:halted? vm))))\n   100\t\n   101\t\n   102\t(def ready-for-ingress? stream-driver/ready-for-ingress?)\n   103\t\n   104\t\n   105\t(def ingest-next-program stream-driver/ingest-next-program)\n   106\t\n   107\t\n   108\t(def step-on-stream stream-driver/step-on-stream)\n   109\t\n   110\t\n   111\t(defn make-woken-run-queue-entries\n   112\t  \"Transform woken wait-set entries into ready-queue entries.\n   113\t   Readers (with :cursor-ref) store the successor cursor the transport\n   114\t   returned. Writers (no :cursor-ref) just stamp :value.\"\n   115\t  ([state woken] (make-woken-run-queue-entries state woken nil))\n   116\t  ([state woken restore-fn]\n   117\t   (mapv (fn [{:keys [entry value cursor], :as woken-entry}]\n   118\t           (let [cursor-ref (:cursor-ref entry)\n   119\t                 store-updates\n   120\t                 (or (:store-updates woken-entry)\n   121\t                     (when (and cursor-ref cursor)\n   122\t                       (let [cursor-id (:id cursor-ref)\n   123\t                             cursor-data (get (:store state) cursor-id)]\n   124\t                         {cursor-id (assoc cursor-data :cursor cursor)})))\n   125\t                 base-entry (assoc entry\n   126\t                                   :value value\n   127\t                                   :store-updates store-updates\n   128\t                                   :cursor cursor)]\n   129\t             (if restore-fn\n   130\t               (let [task (adapter/vm-task base-entry restore-fn)]\n   131\t                 (assoc task\n   132\t                        :value value\n   133\t                        :cursor cursor))\n   134\t               base-entry)))\n   135\t         woken)))\n   136\t\n   137\t\n   138\t(defn handle-make\n   139\t  \"Handle :stream/make. Creates a stream through the composition's\n   140\t   `:make-stream` and stores the handle.\n   141\t\n   142\t   A nil capacity has no v2 meaning, so the module path defaults exactly as\n   143\t   the AST path does. Absent a supplied constructor this fails and says so;\n   144\t   silently falling back to a private transport is the failure mode the rule\n   145\t   exists to prevent.\n   146\t   Returns [stream-ref updated-state].\"\n   147\t  [state effect id]\n   148\t  (let [capacity (or (:capacity effect) vm/default-stream-capacity)\n   149\t        handle (vm/create-stream! (:make-stream state) capacity :stream/make)\n   150\t        new-store (assoc (:store state) id handle)\n   151\t        stream-ref {:type :stream-ref, :id id}]\n   152\t    [stream-ref (assoc state :store new-store)]))\n   153\t\n   154\t\n   155\t(defn handle-put\n   156\t  \"Handle :stream/put. Total over the five append outcomes.\n   157\t   Returns {:value v :state s} on success, {:park true :stream-id id :state s}\n   158\t   on `full`. `closed`, `invalid-value` and `transport-error` are errors that\n   159\t   name their outcome, as v1's throw on a closed stream did.\"\n   160\t  [state effect]\n   161\t  (let [stream-ref (:stream effect)\n   162\t        val (:val effect)\n   163\t        stream-id (:id stream-ref)\n   164\t        handle (get (:store state) stream-id)]\n   165\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   166\t    (let [result (stream/append! handle val)\n   167\t          o (outcome result)]\n   168\t      (case o\n   169\t        :dao.stream/ok {:value val, :state state}\n   170\t        :dao.stream/full {:park true, :stream-id stream-id, :state state}\n   171\t        (fail \"Stream append failed\" {:outcome o, :stream-id stream-id})))))\n   172\t\n   173\t\n   174\t(defn handle-cursor\n   175\t  \"Handle :stream/cursor. Mints an opaque cursor at `:dao.stream/oldest`.\n   176\t\n   177\t   v1 fabricated `{:position 0}` and touched no stream. Minting is a stream\n   178\t   operation, so `closed` and `transport-error` arrive here.\n   179\t   Returns [cursor-ref updated-state].\"\n   180\t  [state effect id]\n   181\t  (let [stream-ref (:stream effect)\n   182\t        stream-id (:id stream-ref)\n   183\t        handle (get (:store state) stream-id)]\n   184\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   185\t    (let [cursor (vm/mint-oldest handle :stream/cursor)\n   186\t          cursor-data (vm/cursor-entry stream-id cursor)\n   187\t          new-store (assoc (:store state) id cursor-data)\n   188\t          cursor-ref {:type :cursor-ref, :id id}]\n   189\t      [cursor-ref (assoc state :store new-store)])))\n   190\t\n   191\t\n   192\t(defn handle-next\n   193\t  \"Handle :stream/next. Total over the seven read outcomes.\n   194\t\n   195\t   `ok` advances the store cursor to the exact returned successor. `blocked`\n   196\t   parks. `end` yields nil, as v1 did. `gap` advances to the recovery cursor\n   197\t   and yields `:dao.stream/gap`, so a program that reads it learns values were\n   198\t   lost. The three terminal outcomes are errors.\"\n   199\t  [state effect]\n   200\t  (let [cursor-ref (:cursor effect)\n   201\t        cursor-id (:id cursor-ref)\n   202\t        store (:store state)\n   203\t        cursor-data (get store cursor-id)]\n   204\t    (when (nil? cursor-data) (fail \"Invalid cursor reference\" {:ref cursor-ref}))\n   205\t    (let [stream-id (:stream-id cursor-data)\n   206\t          handle (get store stream-id)]\n   207\t      (when (nil? handle)\n   208\t        (fail \"Stream not found for cursor\" {:stream-id stream-id}))\n   209\t      (let [result (stream/next handle (:cursor cursor-data))\n   210\t            o (outcome result)\n   211\t            advance (fn [state* value]\n   212\t                      {:value value,\n   213\t                       :state (assoc state*\n   214\t                                     :store\n   215\t                                     (assoc store\n   216\t                                            cursor-id\n   217\t                                            (assoc cursor-data\n   218\t                                                   :cursor\n   219\t                                                   (:dao.stream/cursor\n   220\t                                                     result))))})]\n   221\t        (case o\n   222\t          :dao.stream/ok (advance state (:dao.stream/value result))\n   223\t          :dao.stream/blocked {:park true,\n   224\t                               :cursor-ref cursor-ref,\n   225\t                               :stream-id stream-id,\n   226\t                               :state state}\n   227\t          :dao.stream/end {:value nil, :state state}\n   228\t          :dao.stream/gap (advance state :dao.stream/gap)\n   229\t          (fail \"Stream read failed\"\n   230\t                {:outcome o, :stream-id stream-id, :cursor-id cursor-id}))))))\n   231\t\n   232\t\n   233\t(defn handle-close\n   234\t  \"Handle :stream/close. `close!` is total over {ok} and wakes nothing: a\n   235\t   reader parked on this stream learns of the close from its own next `next`.\n   236\t   Returns {:state s'}.\"\n   237\t  [state effect]\n   238\t  (let [stream-ref (:stream effect)\n   239\t        stream-id (:id stream-ref)\n   240\t        handle (get (:store state) stream-id)]\n   240\t        handle (get (:store state) stream-id)]\n   241\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   242\t    (stream/close! handle)\n   243\t    {:state state}))\n   244\t\n   245\t\n   246\t(defn- augment-wait-entry\n   247\t  \"Resolve one wait entry to a live handle and an opaque cursor out of the\n   248\t   store. The cursor is re-resolved on every round even when an earlier round\n   249\t   baked a value into the entry: another waiter on the same cursor-ref may\n   250\t   have advanced the stored cursor since.\"\n   251\t  [store entry]\n   252\t  (if-let [cursor-ref (:cursor-ref entry)]\n   253\t    (let [cursor-data (get store (:id cursor-ref))]\n   254\t      (assoc entry\n   255\t             :stream (or (:stream entry)\n   256\t                         (get store (:stream-id cursor-data)))\n   257\t             :cursor (:cursor cursor-data)))\n   258\t    (if (and (not (:stream entry)) (:stream-id entry))\n   259\t      (assoc entry :stream (get store (:stream-id entry)))\n   260\t      entry)))\n   261\t\n   262\t\n   263\t(defn check-wait-set\n   264\t  \"Check wait-set entries against their transports.\n   265\t\n   266\t   Every entry is resolved to a live handle and an opaque cursor out of the\n   267\t   store before `dao.runtime` polls it. There is no transport-local waking\n   268\t   to fall back from: this is the only mechanism.\n   269\t\n   270\t   Entries are polled one at a time in wait-set order, and a woken reader's\n   271\t   successor cursor is written back to the store before the next entry is\n   272\t   resolved. Waiters sharing a cursor-ref therefore read distinct values — the\n   273\t   value at the cursor wakes the first, its successor wakes the next — instead\n   274\t   of every waiter reading the value at the shared pre-poll cursor.\"\n   275\t  ([state] (check-wait-set state nil))\n   276\t  ([state restore-fn]\n   277\t   (let [wait-set (:wait-set state)]\n   278\t     (if (empty? wait-set)\n   279\t       state\n   280\t       (loop [remaining wait-set\n   281\t              v (assoc state :wait-set [])\n   282\t              woken []]\n   283\t         (if (empty? remaining)\n   284\t           (let [new-tasks (make-woken-run-queue-entries v woken restore-fn)]\n   285\t             (update v :ready-queue (fnil into []) new-tasks))\n   286\t           (let [augmented (augment-wait-entry (:store v) (first remaining))\n   287\t                 ;; A singleton wait set makes the outcome below belong to\n   288\t                 ;; this entry alone.\n   289\t                 polled (rt/check-wait-set (assoc v\n   290\t                                                  :wait-set [augmented]\n   291\t                                                  :ready-queue []))\n   292\t                 raw (first (:ready-queue polled))\n   293\t                 ;; A woken reader's successor is stored before later entries\n   294\t                 ;; resolve, so a shared cursor-ref advances within the round.\n   295\t                 advance (when (and raw (:cursor-ref raw) (:cursor raw))\n   296\t                           {(:id (:cursor-ref raw))\n   297\t                            (assoc (get (:store polled) (:id (:cursor-ref raw)))\n   298\t                                   :cursor (:cursor raw))})]\n   299\t             (recur (rest remaining)\n   300\t                    (assoc polled\n   301\t                           :store (merge (:store polled) advance)\n   302\t                           :wait-set (into (:wait-set v) (:wait-set polled))\n   303\t                           :ready-queue (:ready-queue v))\n   304\t                    (if raw\n   305\t                      (conj woken {:entry raw,\n   306\t                                   :value (:value raw),\n   307\t                                   :cursor (:cursor raw),\n   308\t                                   :store-updates (:store-updates raw)})\n   309\t                      woken)))))))))\n   310\t\n   311\t\n   312\t(declare handle-effect resume-continuation)\n   313\t\n   314\t\n   315\t(defn run-loop\n   316\t  \"Generic eval loop with scheduler support.\"\n   317\t  [state active? step-fn resume-fn restore-fn]\n   318\t  (loop [v state]\n   319\t    (let [q (or (:ready-queue v) [])]\n   320\t      (cond (active? v) (recur (step-fn v))\n   321\t            (:blocked? v) (let [v' (check-wait-set v restore-fn)]\n   322\t                            (if-let [resumed (or (rt/run-once v')\n   323\t                                                 (resume-fn v'))]\n   324\t                              (recur resumed)\n   325\t                              (telemetry/emit-snapshot v' :blocked)))\n   326\t            (seq q) (if-let [resumed (or (rt/run-once v) (resume-fn v))]\n   327\t                      (recur resumed)\n   328\t                      v)\n   329\t            :else (if (:halted? v) (telemetry/emit-snapshot v :halt) v)))))\n   330\t\n   331\t\n   332\t(defn run-on-stream\n   333\t  \"Run a VM while polling its ingress DaoStream between evaluations.\n   334\t   Internal VM blocking still returns immediately; ingress polling only\n   335\t   happens when the VM is idle between program batches.\"\n   336\t  [vm in-stream load-fn step-fn resume-fn restore-fn]\n   337\t  (loop [v vm]\n   338\t    (if (and in-stream (ready-for-ingress? v))\n   339\t      (let [{:keys [status state]} (ingest-next-program v in-stream load-fn)]\n   340\t        (case status\n   341\t          :ok (recur state)\n   342\t          ;; A gap loses a batch but not the stream: keep ingesting.\n   343\t          :gap (recur state)\n   344\t          state))\n   345\t      (if (ready-for-ingress? v)\n   346\t        v\n   347\t        (let [v' (run-loop v active-continuation? step-fn resume-fn restore-fn)]\n   348\t          (if (and in-stream (not (:blocked? v')) (ready-for-ingress? v'))\n   349\t            (recur v')\n   350\t            v'))))))\n   351\t\n   352\t\n   353\t(defn resume-from-run-queue\n   354\t  \"Pop first entry from the ready-queue, merge store-updates, and restore\n   355\t   VM-specific context.\"\n   356\t  [state restore-fn]\n   357\t  (let [run-queue (or (:ready-queue state) [])]\n   358\t    (when (seq run-queue)\n   359\t      (let [entry (first run-queue)\n   360\t            rest-queue (subvec run-queue 1)\n   361\t            base (assoc state\n   362\t                        :ready-queue rest-queue\n   363\t                        :store (merge (:store state) (:store-updates entry))\n   364\t                        :blocked? false\n   365\t                        :halted? false)]\n   366\t        (restore-fn base entry)))))\n   367\t\n   368\t\n   369\t(defn park-continuation\n   370\t  \"Add a parked continuation entry and halt the VM.\"\n   371\t  [state cont-fields]\n   372\t  (let [id-counter (or (:id-counter state) 0)\n   373\t        park-id (keyword (str \"parked-\" id-counter))\n   374\t        parked (merge {:type :parked-continuation, :id park-id} cont-fields)]\n   375\t    (-> state\n   376\t        (update :parked assoc park-id parked)\n   377\t        (assoc :value parked\n   378\t               :halted? true\n   379\t               :id-counter (inc id-counter))\n   380\t        (telemetry/emit-snapshot :park {:parked-id park-id}))))\n   381\t\n   382\t\n   383\t(defn resume-continuation\n   384\t  \"Restore state from a parked continuation.\"\n   385\t  [state parked-id resume-val restore-fn]\n   386\t  (if-let [parked (get-in state [:parked parked-id])]\n   387\t    (let [new-state (update state :parked dissoc parked-id)]\n   388\t      (-> (restore-fn new-state parked resume-val)\n   389\t          (telemetry/emit-snapshot :resume {:parked-id parked-id})))\n   390\t    (fail \"Cannot resume: parked continuation not found\"\n   391\t          {:parked-id parked-id})))\n   392\t\n   393\t\n   394\t(defn gensym\n   395\t  \"Generate a unique ID and return [id updated-state].\"\n   396\t  ([state] (gensym state \"id\"))\n   397\t  ([state prefix]\n   398\t   (let [id-counter (or (:id-counter state) 0)\n   399\t         id (gen-id prefix id-counter)]\n   400\t     [id (assoc state :id-counter (inc id-counter))])))\n   401\t\n   402\t\n   403\t(defn handle-stream-block\n   404\t  [result entry]\n   405\t  (if (:park result)\n   406\t    (let [entry (or entry\n   407\t                    (fail \"Parked entry required for blocking stream\"\n   408\t                          {:result result}))\n   409\t          new-state (-> (:state result)\n   410\t                        (rt/park-task entry)\n   411\t                        (assoc :value :yin/blocked\n   412\t                               :blocked? true\n   413\t                               :halted? false))]\n   414\t      {:state new-state, :value :yin/blocked, :blocked? true})\n   415\t    {:state (:state result), :value (:value result), :blocked? false}))\n   416\t\n   417\t\n   418\t(defn handle-effect\n   419\t  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n   420\t   park-entry-fns maps :stream/put and :stream/next to functions that build\n   421\t   wait entries.\"\n   422\t  [state effect {:keys [park-entry-fns restore-fn], :as opts}]\n   423\t  (let [park-entry (get park-entry-fns (:effect effect))\n   424\t        result\n   425\t        (case (:effect effect)\n   426\t          :vm/store-put {:state (assoc state\n   427\t                                       :store (assoc (:store state)\n   428\t                                                     (:key effect)\n   429\t                                                     (:val effect))),\n   430\t                         :value (:val effect),\n   431\t                         :blocked? false}\n   432\t          :stream/make\n   433\t          (let [[id s'] (gensym state \"stream\")\n   434\t                [stream-ref new-state] (handle-make s' effect id)]\n   435\t            {:state new-state, :value stream-ref, :blocked? false})\n   436\t          :stream/cursor\n   437\t          (let [[id s'] (gensym state \"cursor\")\n   438\t                [cursor-ref new-state] (handle-cursor s' effect id)]\n   439\t            {:state new-state, :value cursor-ref, :blocked? false})\n   440\t          :stream/put\n   441\t          (let [result (handle-put state effect)]\n   442\t            (if (:park result)\n   443\t              (let [built-entry (when park-entry\n   444\t                                  (park-entry state effect result))\n   445\t                    handle (get (:store state) (:stream-id result))\n   446\t                    built-entry (cond-> built-entry\n   447\t                                  (and built-entry (not (:stream built-entry)))\n   448\t                                  (assoc :stream handle)\n   449\t                                  (and built-entry (not (:datom built-entry)))\n   450\t                                  (assoc :datom (:val effect)))\n   451\t                    task (when (and built-entry restore-fn)\n   452\t                           (adapter/vm-task built-entry restore-fn))]\n   453\t                (handle-stream-block result (or task built-entry)))\n   454\t              {:state (:state result),\n   455\t               :value (:value result),\n   456\t               :blocked? false}))\n   457\t          :stream/next\n   458\t          (let [result (handle-next state effect)]\n   459\t            (if (:park result)\n   460\t              (let [built-entry (when park-entry\n   461\t                                  (park-entry state effect result))\n   462\t                    stream-id (:stream-id result)\n   463\t                    handle (get (:store state) stream-id)\n   464\t                    cursor-id (:id (:cursor-ref result))\n   465\t                    cursor (:cursor (get (:store state) cursor-id))\n   466\t                    built-entry (cond-> built-entry\n   467\t                                  (and built-entry (not (:stream built-entry)))\n   468\t                                  (assoc :stream handle)\n   469\t                                  (and built-entry (not (:cursor built-entry)))\n   470\t                                  (assoc :cursor cursor))\n   471\t                    task (when (and built-entry restore-fn)\n   472\t                           (adapter/vm-task built-entry restore-fn))]\n   473\t                (handle-stream-block result (or task built-entry)))\n   474\t              {:state (:state result),\n   475\t               :value (:value result),\n   476\t               :blocked? false}))\n   477\t          :stream/close\n   478\t          (let [close-result (handle-close state effect)]\n   479\t            {:state (:state close-result), :value nil, :blocked? false})\n   480\t          (let [[id s'] (gensym state \"effect\")\n   481\t                handler (module/get-effect-handler (:modules state)\n   482\t                                                   (:effect effect))]\n   483\t            (if handler\n   484\t              (handler s' effect (assoc opts :id id))\n   485\t              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n   486\t    (update result\n   487\t            :state\n   488\t            (fn [result-state]\n   489\t              (telemetry/emit-snapshot (assoc result-state\n   490\t                                              :value (:value result))\n   491\t                                       :effect\n   492\t                                       {:effect-type (:effect effect)})))))\n   493\t\n   494\t\n   495\t;; =============================================================================\n   496\t;; Program Cache Machinery\n   497\t;; =============================================================================\n   498\t\n   499\t(def default-compiled-cache-limit 8)\n   500\t(def ^:private derived-metadata-eid (:db/derived datom/reserved))\n   501\t\n   502\t\n   503\t(defn build-program-index\n   504\t  [datoms]\n   505\t  (group-by first (vec datoms)))\n   506\t\n   507\t\n   508\t(defn executable-program-datom?\n   509\t  [[_e a _v _t m]]\n   510\t  (and (keyword? a) (= \"yin\" (namespace a)) (not= m derived-metadata-eid)))\n   511\t\n   512\t\n   513\t(defn frame-versions\n   514\t  [frame]\n   515\t  (loop [f frame\n   516\t         acc #{}]\n   517\t    (if (map? f)\n   518\t      (let [acc (cond-> acc (:compiled-version f) (conj (:compiled-version f)))]\n   519\t        (recur (:next f) acc))\n   520\t      acc)))\n   520\t      acc)))\n   521\t\n   522\t\n   523\t(defn collect-frame-versions\n   524\t  [frames]\n   525\t  (reduce (fn [acc f] (into acc (frame-versions f))) #{} (or frames [])))\n   526\t\n   527\t\n   528\t(defn pinned-compiled-versions\n   529\t  [vm]\n   530\t  (let [active (:active-compiled-version vm)\n   531\t        k-versions (frame-versions (:k vm))\n   532\t        parked-versions (collect-frame-versions (vals (:parked vm)))\n   533\t        ready-versions (collect-frame-versions (:ready-queue vm))\n   534\t        wait-versions (collect-frame-versions (:wait-set vm))]\n   535\t    (cond-> (clojure.set/union k-versions\n   536\t                               parked-versions\n   537\t                               ready-versions\n   538\t                               wait-versions)\n   539\t      active (conj active))))\n   540\t\n   541\t\n   542\t(defn trim-compiled-cache\n   543\t  [vm]\n   544\t  (let [cache (:compiled-by-version vm)\n   545\t        limit\n   546\t        (max 1 (or (:compiled-cache-limit vm) default-compiled-cache-limit))]\n   547\t    (if (> (count cache) limit)\n   548\t      (let [pinned (pinned-compiled-versions vm)\n   549\t            sorted-versions (reverse (sort (keys cache)))\n   550\t            to-keep (into pinned (take limit sorted-versions))]\n   551\t        (assoc vm :compiled-by-version (select-keys cache to-keep)))\n   552\t      vm)))\n   553\t\n   554\t\n   555\t(defn cache-compiled-artifact\n   556\t  [vm version artifact program-index]\n   557\t  (-> vm\n   558\t      (assoc :compile-dirty? false\n   559\t             :datom-index program-index\n   560\t             :active-compiled-version version)\n   561\t      (update :compiled-by-version (fnil assoc {}) version artifact)\n   562\t      trim-compiled-cache))\n   563\t\n   564\t\n   565\t(defn ensure-compiled-version\n   566\t  [vm version compile-fn]\n   567\t  (if-let [artifact (get-in vm [:compiled-by-version version])]\n   568\t    [vm artifact]\n   569\t    (let [program-datoms (vec (or (:datoms vm) []))\n   570\t          program-root-eid (:program-root-eid vm)]\n   571\t      (when (or (empty? program-datoms) (nil? program-root-eid))\n   572\t        (fail \"Canonical program is not loaded\" {:program-version version}))\n   573\t      (let [program-index (or (:datom-index vm)\n   574\t                              (build-program-index program-datoms))\n   575\t            artifact (compile-fn program-root-eid program-datoms program-index)\n   576\t            vm' (cache-compiled-artifact vm version artifact program-index)]\n   577\t        [vm' artifact]))))\n   578\t\n   579\t\n   580\t(defn maybe-recompile-at-boundary\n   581\t  [vm compile-fn]\n   582\t  (if (and (:compile-dirty? vm)\n   583\t           (seq (:datoms vm))\n   584\t           (some? (:program-root-eid vm)))\n   585\t    (ensure-compiled-version vm (:program-version vm) compile-fn)\n   586\t    [vm nil]))\n   587\t\n   588\t\n   589\t(defn append-program-datoms\n   590\t  ([vm new-datoms] (append-program-datoms vm new-datoms nil))\n   591\t  ([vm new-datoms new-root-eid]\n   592\t   (when-not (some? (:program-root-eid vm))\n   593\t     (fail \"append-program-datoms requires a canonical program\" {}))\n   594\t   (let [appended (vec new-datoms)]\n   595\t     (if (and (empty? appended) (nil? new-root-eid))\n   596\t       vm\n   597\t       (let [version (inc (or (:program-version vm) 0))\n   598\t             dirty? (or (some executable-program-datom? appended)\n   599\t                        (some? new-root-eid))]\n   600\t         (assoc vm\n   601\t                :program-version version\n   602\t                :program-root-eid (or new-root-eid (:program-root-eid vm))\n   603\t                :compile-dirty? (or (:compile-dirty? vm) dirty?)\n   604\t                :datoms (into (vec (or (:datoms vm) [])) appended)\n   605\t                :datom-index (if dirty? nil (:datom-index vm))))))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '1,230p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '227,490p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '500,835p'; nl -ba src/cljc/yin/vm/ffi.cljc; nl -ba src/cljc/yin/vm/runtime_adapter.cljc; nl -ba src/cljc/yin/vm/stream_driver.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '1,230p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '227,490p'; nl -ba src/cljc/yin/vm/ast_walker.cljc | sed -n '500,835p'; nl -ba src/cljc/yin/vm/ffi.cljc; nl -ba src/cljc/yin/vm/runtime_adapter.cljc; nl -ba src/cljc/yin/vm/stream_driver.cljc\"","aggregated_output":"     1\t(ns yin.vm.ast-walker\n     2\t  \"Direct AST interpreter for the Yin Abstract Machine on DaoStream v2.\n     3\t\n     4\t   The evaluator itself is v1's, unchanged: a CESK machine over raw AST maps\n     5\t   with a linked continuation, a ready queue and a wait set. What the port\n     6\t   changed lives below it — opaque cursors, outcome maps, a supplied stream\n     7\t   constructor, a registry value, and no waiters.\n     8\t\n     9\t   The one deletion inside this namespace is v1's transport-local waiter\n    10\t   registration in `park-and-call`. An FFI call now places its continuation in\n    11\t   the polling wait set like every other blocked read, and the ordinary\n    12\t   scheduler wakes it when the response arrives on the call-out stream.\n    13\t\n    14\t   There is no `macro-expand` branch here, exactly as in v1: this evaluator\n    15\t   runs macro-free programs.\"\n    16\t  (:require [dao.stream.apply :as apply2]\n    17\t            [yin.vm :as vm]\n    18\t            [yin.vm.engine :as engine]\n    19\t            [yin.vm.ffi :as ffi]\n    20\t            [yin.vm.module :as module]\n    21\t            [yin.vm.telemetry :as telemetry]))\n    22\t\n    23\t\n    24\t(declare ast-walker-restore)\n    25\t\n    26\t\n    27\t;; =============================================================================\n    28\t;; ASTWalkerVM Record\n    29\t;; =============================================================================\n    30\t\n    31\t(defrecord ASTWalkerVM\n    32\t  [blocked?       ; boolean, true if blocked\n    33\t   bridge         ; explicit host-side FFI bridge state\n    34\t   in-stream      ; ingress DaoStream carrying AST programs\n    35\t   in-cursor      ; opaque ingress cursor\n    36\t   ingress-gaps   ; count of program batches lost to eviction\n    37\t   halted?        ; boolean, true when active continuation has completed\n    38\t   k              ; reified continuation or nil\n    39\t   program        ; last ingested AST program\n    40\t   control        ; current AST node or nil\n    41\t   env            ; persistent lexical scope map\n    42\t   id-counter     ; integer counter for unique IDs\n    43\t   parked         ; parked continuations map\n    44\t   primitives     ; primitive operations map\n    45\t   modules        ; module registry value\n    46\t   make-stream    ; host-supplied stream constructor, or nil\n    47\t   call-capacity  ; declared capacity of the FFI pair\n    48\t   ready-queue    ; vector of runnable continuations\n    49\t   store          ; heap memory map\n    50\t   value          ; last computed value\n    51\t   wait-set       ; vector of continuations waiting on a transport\n    52\t   telemetry      ; optional telemetry config (always nil in this slice)\n    53\t   telemetry-step ; telemetry snapshot counter\n    54\t   telemetry-t    ; telemetry transaction counter\n    55\t   vm-model       ; telemetry model keyword\n    56\t   ])\n    57\t\n    58\t\n    59\t(defn- cesk-return\n    60\t  \"Create a new ASTWalkerVM with updated CESK fields in a single allocation.\n    61\t   Preserves blocked, store, and scheduler fields from vm.\n    62\t   Derives :halted? from the new CESK state.\"\n    63\t  [^ASTWalkerVM vm control env k val]\n    64\t  (let [blocked (:blocked? vm)]\n    65\t    (->ASTWalkerVM blocked\n    66\t                   (:bridge vm)\n    67\t                   (:in-stream vm)\n    68\t                   (:in-cursor vm)\n    69\t                   (:ingress-gaps vm)\n    70\t                   (and (not blocked) (nil? control) (nil? k))\n    71\t                   k\n    72\t                   (:program vm)\n    73\t                   control\n    74\t                   env\n    75\t                   (:id-counter vm)\n    76\t                   (:parked vm)\n    77\t                   (:primitives vm)\n    78\t                   (:modules vm)\n    79\t                   (:make-stream vm)\n    80\t                   (:call-capacity vm)\n    81\t                   (:ready-queue vm)\n    82\t                   (:store vm)\n    83\t                   val\n    84\t                   (:wait-set vm)\n    85\t                   (:telemetry vm)\n    86\t                   (:telemetry-step vm)\n    87\t                   (:telemetry-t vm)\n    88\t                   (:vm-model vm))))\n    89\t\n    90\t\n    91\t(defn- handle-primitive-result\n    92\t  \"Shared logic for handling the result of a primitive function application.\n    93\t   Handles effect dispatch and blocking via engine/handle-effect.\"\n    94\t  [state result k env]\n    95\t  (if (module/effect? result)\n    96\t    (let [{:keys [state value blocked?]}\n    97\t          (engine/handle-effect\n    98\t            state\n    99\t            result\n   100\t            {:restore-fn ast-walker-restore,\n   101\t             :park-entry-fns {:stream/put (fn [_s _e r]\n   102\t                                            {:k k,\n   103\t                                             :env env,\n   104\t                                             :reason :put,\n   105\t                                             :stream-id (:stream-id r),\n   106\t                                             :datom (:val result)}),\n   107\t                              :stream/next (fn [_s _e r]\n   108\t                                             {:k k,\n   109\t                                              :env env,\n   110\t                                              :reason :next,\n   111\t                                              :cursor-ref (:cursor-ref r),\n   112\t                                              :stream-id (:stream-id r)})}})]\n   113\t      (if blocked?\n   114\t        (assoc state\n   115\t               :control nil\n   116\t               :k nil\n   117\t               :halted? false)\n   118\t        (cesk-return state nil env k value)))\n   119\t    (cesk-return state nil env k result)))\n   120\t\n   121\t\n   122\t(defn- call-response-wait-entry\n   123\t  \"The polling wait entry for a sent call awaiting its correlated response.\"\n   124\t  [call-id next-k env]\n   125\t  {:k {:type :dao.stream.apply/eval-call,\n   126\t       :next next-k,\n   127\t       :env env,\n   128\t       :call-id call-id},\n   129\t   :env env,\n   130\t   :cursor-ref {:type :cursor-ref, :id vm/call-out-cursor-key},\n   131\t   :reason :next,\n   132\t   :stream-id vm/call-out-stream-key})\n   133\t\n   134\t\n   135\t(defn- park-and-call\n   136\t  \"Park the continuation, emit the request, and wait for its response.\n   137\t\n   138\t   The pair is checked before `park-continuation` deliberately: the park runs\n   139\t   before the first stream touch, so an error raised later would strand a\n   140\t   continuation in `:parked` and consume an id counter.\n   141\t\n   142\t   The request is retained, never dropped. A `full` call-in leaves the\n   143\t   identical encoded request in the polling wait set, which retries it, and\n   144\t   the call starts waiting for its response only once the append has\n   145\t   succeeded. `closed`, `invalid-value` and `transport-error` fail the call\n   146\t   here and name their outcome.\"\n   147\t  [state op args k env]\n   148\t  (let [{:keys [call-in]} (ffi/require-call-pair! (:store state) op)\n   149\t        response-cont {:type :dao.stream.apply/eval-call, :next k, :env env}\n   150\t        parked (engine/park-continuation state {:k response-cont, :env env})\n   151\t        parked-id (get-in parked [:value :id])\n   152\t        request (apply2/request parked-id op (vec args))\n   153\t        result (apply2/put-request! call-in request)]\n   154\t    (case (:dao.stream/outcome result)\n   155\t      :dao.stream/ok\n   156\t      (-> parked\n   157\t          (update :wait-set\n   158\t                  (fnil conj [])\n   159\t                  (call-response-wait-entry parked-id k env))\n   160\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   161\t          (assoc :control nil\n   162\t                 :k nil\n   163\t                 :value :yin/blocked\n   164\t                 :blocked? true\n   165\t                 :halted? false))\n   166\t      :dao.stream/full\n   167\t      (-> parked\n   168\t          (update :wait-set\n   169\t                  (fnil conj [])\n   170\t                  {:k {:type :dao.stream.apply/request-sent,\n   171\t                       :parked-id parked-id,\n   172\t                       :next k,\n   173\t                       :env env,\n   174\t                       :op op},\n   175\t                   :env env,\n   176\t                   :reason :put,\n   177\t                   :stream-id vm/call-in-stream-key,\n   178\t                   :datom request})\n   179\t          (telemetry/emit-snapshot :bridge {:bridge-op op})\n   180\t          (assoc :control nil\n   181\t                 :k nil\n   182\t                 :value :yin/blocked\n   183\t                 :blocked? true\n   184\t                 :halted? false))\n   185\t      (throw (ex-info \"FFI request could not be appended\"\n   186\t                      {:op op,\n   187\t                       :outcome (or (:dao.stream/outcome result)\n   188\t                                    (:dao.stream.apply/outcome result))})))))\n   189\t\n   190\t\n   191\t(defn- call-result\n   192\t  \"Unwrap a response envelope for the continuation that made the call.\n   193\t\n   194\t   v1 read `:dao.stream.apply/value` off a response that could only succeed.\n   195\t   A v2 response carries exactly one of `ok` or `error`, and correlation is\n   196\t   checked here rather than assumed from stream order.\"\n   197\t  [response call-id]\n   198\t  (when-not (apply2/response? response)\n   199\t    (throw (ex-info \"FFI response envelope is malformed\" {:response response})))\n   200\t  (when (and call-id (not= call-id (apply2/response-id response)))\n   201\t    (throw (ex-info \"FFI response does not correlate with this parked call\"\n   202\t                    {:call-id call-id,\n   203\t                     :response-id (apply2/response-id response)})))\n   204\t  (if-let [err (apply2/response-error response)]\n   205\t    (throw (ex-info (str \"FFI call failed: \"\n   206\t                         (:dao.stream.apply/message err))\n   207\t                    {:call-id call-id, :error err}))\n   208\t    (apply2/response-ok response)))\n   209\t\n   210\t\n   211\t(defn- apply-function\n   212\t  \"Shared logic for applying a function (primitive or closure) to arguments.\n   213\t   env is the active environment at the call site.\"\n   214\t  [state fn-value evaluated-operands k env]\n   215\t  (cond (fn? fn-value)\n   216\t        (handle-primitive-result state\n   217\t                                 (apply fn-value evaluated-operands)\n   218\t                                 k\n   219\t                                 env)\n   220\t        (= :closure (:type fn-value))\n   221\t        (let [{:keys [params body], closure-env :env} fn-value\n   222\t              extended-env (merge closure-env (zipmap params evaluated-operands))]\n   223\t          (cesk-return state body extended-env k (:value state)))\n   224\t        :else (throw (ex-info \"Cannot apply non-function\" {:fn fn-value}))))\n   225\t\n   226\t\n   227\t(defn- cesk-transition\n   228\t  \"Steps the CESK machine to evaluate an AST node.\n   229\t   Each return path produces exactly one ASTWalkerVM allocation via\n   230\t   cesk-return.\"\n   227\t(defn- cesk-transition\n   228\t  \"Steps the CESK machine to evaluate an AST node.\n   229\t   Each return path produces exactly one ASTWalkerVM allocation via\n   230\t   cesk-return.\"\n   231\t  [state ast]\n   232\t  (let [{:keys [control env k store primitives modules]} state\n   233\t        {:keys [type], :as node} (or ast control)]\n   234\t    (if (and (nil? node) k)\n   235\t      (let [cont-type (:type k)]\n   236\t        (case cont-type\n   237\t          :eval-operator\n   238\t          (let [frame (:frame k)\n   239\t                fn-value (:value state)\n   240\t                operands (:operands frame)\n   241\t                saved-env (or (:env k) env)]\n   242\t            (if (empty? operands)\n   243\t              (apply-function state fn-value [] (:next k) saved-env)\n   244\t              (let [updated-frame (assoc frame\n   245\t                                         :operator-evaluated? true\n   246\t                                         :fn fn-value)]\n   247\t                (cesk-return state\n   248\t                             (first operands)\n   249\t                             saved-env\n   250\t                             (assoc k\n   251\t                                    :type :eval-operand\n   252\t                                    :frame updated-frame)\n   253\t                             nil))))\n   254\t          :eval-operand\n   255\t          (let [frame (:frame k)\n   256\t                operand-value (:value state)\n   257\t                evaluated (conj (or (:evaluated frame) []) operand-value)\n   258\t                operands (:operands frame)\n   259\t                saved-env (or (:env k) env)]\n   260\t            (if (= (count evaluated) (count operands))\n   261\t              (apply-function state (:fn frame) evaluated (:next k) saved-env)\n   262\t              (let [next-idx (count evaluated)\n   263\t                    next-node (nth operands next-idx)\n   264\t                    updated-frame (assoc frame :evaluated evaluated)]\n   265\t                (cesk-return state\n   266\t                             next-node\n   267\t                             saved-env\n   268\t                             (assoc k :frame updated-frame)\n   269\t                             nil))))\n   270\t          :eval-test\n   271\t          (let [frame (:frame k)\n   272\t                test-value (:value state)\n   273\t                saved-env (or (:env k) env)\n   274\t                branch (if test-value (:consequent frame) (:alternate frame))]\n   275\t            (cesk-return state branch saved-env (:next k) test-value))\n   276\t          :dao.stream.apply/eval-operand\n   277\t          (let [frame (:frame k)\n   278\t                operand-value (:value state)\n   279\t                evaluated (conj (or (:evaluated frame) []) operand-value)\n   280\t                operands (:operands frame)\n   281\t                saved-env (or (:env k) env)]\n   282\t            (if (= (count evaluated) (count operands))\n   283\t              (park-and-call state (:op frame) evaluated (:next k) saved-env)\n   284\t              (let [next-idx (count evaluated)\n   285\t                    next-node (nth operands next-idx)\n   286\t                    updated-frame (assoc frame :evaluated evaluated)]\n   287\t                (cesk-return state\n   288\t                             next-node\n   289\t                             saved-env\n   290\t                             (assoc k :frame updated-frame)\n   291\t                             nil))))\n   292\t          :dao.stream.apply/request-sent\n   293\t          ;; A request retained on `full` has now been appended by the polling\n   294\t          ;; wait set. The call starts waiting for its correlated response,\n   295\t          ;; exactly as an immediately-sent one does.\n   296\t          (-> state\n   297\t              (update :wait-set\n   298\t                      (fnil conj [])\n   299\t                      (call-response-wait-entry (:parked-id k)\n   300\t                                                (:next k)\n   301\t                                                (:env k)))\n   302\t              (telemetry/emit-snapshot :bridge {:bridge-op (:op k)})\n   303\t              (assoc :control nil\n   304\t                     :k nil\n   305\t                     :value :yin/blocked\n   306\t                     :blocked? true\n   307\t                     :halted? false))\n   308\t          :dao.stream.apply/eval-call\n   309\t          ;; The response consumed here completes the call that\n   310\t          ;; `park-and-call` recorded, so its continuation leaves `:parked`\n   311\t          ;; rather than accumulating for the lifetime of the VM.\n   312\t          (let [state (update state :parked dissoc (:call-id k))]\n   313\t            (cesk-return state\n   314\t                         nil\n   315\t                         env\n   316\t                         (:next k)\n   317\t                         (call-result (:value state) (:call-id k))))\n   318\t          :eval-stream-put-target (let [frame (:frame k)\n   319\t                                        stream-ref (:value state)\n   320\t                                        val-node (:val frame)]\n   321\t                                    (cesk-return state\n   322\t                                                 val-node\n   323\t                                                 env\n   324\t                                                 (assoc k\n   325\t                                                        :type :eval-stream-put-val\n   326\t                                                        :stream-ref stream-ref)\n   327\t                                                 stream-ref))\n   328\t          :eval-stream-put-val\n   329\t          (let [val (:value state)\n   330\t                stream-ref (:stream-ref k)\n   331\t                effect {:effect :stream/put, :stream stream-ref, :val val}\n   332\t                {:keys [state value blocked?]}\n   333\t                (engine/handle-effect state\n   334\t                                      effect\n   335\t                                      {:restore-fn ast-walker-restore,\n   336\t                                       :park-entry-fns\n   337\t                                       {:stream/put (fn [_s _e r]\n   338\t                                                      {:k (:next k),\n   339\t                                                       :env env,\n   340\t                                                       :reason :put,\n   341\t                                                       :stream-id\n   342\t                                                       (:stream-id r),\n   343\t                                                       :datom val})}})]\n   344\t            (if blocked?\n   345\t              (assoc state\n   346\t                     :control nil\n   347\t                     :k nil\n   348\t                     :halted? false)\n   349\t              (cesk-return state nil env (:next k) value)))\n   350\t          :eval-stream-cursor-source\n   351\t          (let [stream-ref (:value state)\n   352\t                effect {:effect :stream/cursor, :stream stream-ref}\n   353\t                {:keys [state value]} (engine/handle-effect\n   354\t                                        state\n   355\t                                        effect\n   356\t                                        {:restore-fn ast-walker-restore})]\n   357\t            (cesk-return state nil env (:next k) value))\n   358\t          :eval-stream-next-cursor\n   359\t          (let [cursor-ref (:value state)\n   360\t                effect {:effect :stream/next, :cursor cursor-ref}\n   361\t                {:keys [state value blocked?]}\n   362\t                (engine/handle-effect\n   363\t                  state\n   364\t                  effect\n   365\t                  {:restore-fn ast-walker-restore,\n   366\t                   :park-entry-fns {:stream/next\n   367\t                                    (fn [_s _e r]\n   368\t                                      {:k (:next k),\n   369\t                                       :env env,\n   370\t                                       :reason :next,\n   371\t                                       :cursor-ref (:cursor-ref r),\n   372\t                                       :stream-id (:stream-id r)})}})]\n   373\t            (if blocked?\n   374\t              (assoc state\n   375\t                     :control nil\n   376\t                     :k nil\n   377\t                     :halted? false)\n   378\t              (cesk-return state nil env (:next k) value)))\n   379\t          :eval-resume-val\n   380\t          (let [resume-val (:value state)\n   381\t                parked-id (:parked-id k)]\n   382\t            (engine/resume-continuation\n   383\t              state\n   384\t              parked-id\n   385\t              resume-val\n   386\t              (fn [new-state parked rv]\n   387\t                (cesk-return new-state nil (:env parked) (:k parked) rv))))\n   388\t          (throw (ex-info \"Unknown continuation type\"\n   389\t                          {:continuation-type cont-type, :continuation k}))))\n   390\t      (case type\n   391\t        :literal (cesk-return state nil env k (:value node))\n   392\t        :variable\n   393\t        (let [value (engine/resolve-var env store primitives modules (:name node))]\n   394\t          (cesk-return state nil env k value))\n   395\t        :lambda (let [{:keys [params body]} node]\n   396\t                  (cesk-return\n   397\t                    state\n   398\t                    nil\n   399\t                    env\n   400\t                    k\n   401\t                    {:type :closure, :params params, :body body, :env env}))\n   402\t        :application (cesk-return\n   403\t                       state\n   404\t                       (:operator node)\n   405\t                       env\n   406\t                       {:frame node, :next k, :env env, :type :eval-operator}\n   407\t                       (:value state))\n   408\t        :if (cesk-return state\n   409\t                         (:test node)\n   410\t                         env\n   411\t                         {:frame node, :next k, :env env, :type :eval-test}\n   412\t                         (:value state))\n   413\t        :dao.stream.apply/call\n   414\t        (let [operands (or (:operands node) [])\n   415\t              op (:op node)]\n   416\t          (if (empty? operands)\n   417\t            (park-and-call state op [] k env)\n   418\t            (cesk-return state\n   419\t                         (first operands)\n   420\t                         env\n   421\t                         {:frame {:op op, :operands operands, :evaluated []},\n   422\t                          :next k,\n   423\t                          :env env,\n   424\t                          :type :dao.stream.apply/eval-operand}\n   425\t                         (:value state))))\n   426\t        :vm/gensym (let [prefix (or (:prefix node) \"id\")\n   427\t                         [id s'] (engine/gensym state prefix)]\n   428\t                     (assoc s'\n   429\t                            :value id\n   430\t                            :control nil\n   431\t                            :halted? (nil? k)))\n   432\t        :vm/store-get (cesk-return state nil env k (get store (:key node)))\n   433\t        :vm/store-put (let [key (:key node)\n   434\t                            value (:val node)\n   435\t                            new-store (assoc store key value)]\n   436\t                        (assoc state\n   437\t                               :store new-store\n   438\t                               :value value\n   439\t                               :control nil\n   440\t                               :halted? (and (not (:blocked? state)) (nil? k))))\n   441\t        :vm/store-update (let [key (:key node)\n   442\t                               f (:fn node)\n   443\t                               args (:args node)\n   444\t                               current (get store key)\n   445\t                               new-value (apply f current args)\n   446\t                               new-store (assoc store key new-value)]\n   447\t                           (assoc state\n   448\t                                  :store new-store\n   449\t                                  :value new-value\n   450\t                                  :control nil\n   451\t                                  :halted? (and (not (:blocked? state))\n   452\t                                                (nil? k))))\n   453\t        :vm/current-continuation\n   454\t        (cesk-return state\n   455\t                     nil\n   456\t                     env\n   457\t                     k\n   458\t                     {:type :reified-continuation, :k k, :env env})\n   459\t        :vm/park (-> (engine/park-continuation state {:k k, :env env})\n   460\t                     (assoc :control nil\n   461\t                            :k nil))\n   462\t        :vm/resume (cesk-return state\n   463\t                                (:val node)\n   464\t                                env\n   465\t                                {:type :eval-resume-val,\n   466\t                                 :parked-id (:parked-id node),\n   467\t                                 :next k,\n   468\t                                 :env env}\n   469\t                                (:value state))\n   470\t        :stream/make (let [capacity (or (:buffer node)\n   471\t                                        vm/default-stream-capacity)\n   472\t                           effect {:effect :stream/make, :capacity capacity}\n   473\t                           {:keys [state value]} (engine/handle-effect\n   474\t                                                   state\n   475\t                                                   effect\n   476\t                                                   {:restore-fn\n   477\t                                                    ast-walker-restore})]\n   478\t                       (cesk-return state nil env k value))\n   479\t        :stream/put\n   480\t        (cesk-return\n   481\t          state\n   482\t          (:target node)\n   483\t          env\n   484\t          {:frame node, :next k, :env env, :type :eval-stream-put-target}\n   485\t          (:value state))\n   486\t        :stream/cursor\n   487\t        (cesk-return\n   488\t          state\n   489\t          (:source node)\n   490\t          env\n   500\t        (throw (ex-info \"Unknown AST node type\" {:type type, :node node}))))))\n   501\t\n   502\t\n   503\t;; =============================================================================\n   504\t;; Scheduler\n   505\t;; =============================================================================\n   506\t\n   507\t(defn- ast-walker-restore\n   508\t  ([base entry] (ast-walker-restore base entry (:value entry)))\n   509\t  ([base entry val] (cesk-return base nil (:env entry) (:k entry) val)))\n   510\t\n   511\t\n   512\t(defn- resume-from-run-queue\n   513\t  \"Pop first entry from the ready-queue and resume it as the active\n   514\t   computation. Returns updated state or nil if the queue is empty.\"\n   515\t  [state]\n   516\t  (engine/resume-from-run-queue state ast-walker-restore))\n   517\t\n   518\t\n   519\t(defn- ast-walker-run-active-continuation\n   520\t  \"Hot loop that keeps CESK state in host locals instead of an immutable\n   521\t   record. Inlines common transitions to reduce allocation overhead.\"\n   522\t  [^ASTWalkerVM vm-init control-init env-init k-init val-init]\n   523\t  (loop [control control-init\n   524\t         env env-init\n   525\t         k k-init\n   526\t         val val-init\n   527\t         vm vm-init]\n   528\t    (let [node control\n   529\t          type (:type node)]\n   530\t      (cond\n   531\t        (and (nil? node) k)\n   532\t        (let [cont-type (:type k)]\n   533\t          (case cont-type\n   534\t            :eval-operator\n   535\t            (let [frame (:frame k)\n   536\t                  fn-value val\n   537\t                  operands (:operands frame)\n   538\t                  saved-env (or (:env k) env)]\n   539\t              (if (empty? operands)\n   540\t                (cond (= :closure (:type fn-value))\n   541\t                      (let [{:keys [params body], closure-env :env} fn-value\n   542\t                            extended-env (merge closure-env (zipmap params []))]\n   543\t                        (recur body extended-env (:next k) val vm))\n   544\t                      (fn? fn-value)\n   545\t                      (let [result (apply fn-value [])]\n   546\t                        (if (module/effect? result)\n   547\t                          (let [state (cesk-return vm control env k val)\n   548\t                                res (handle-primitive-result state\n   549\t                                                             result\n   550\t                                                             (:next k)\n   551\t                                                             saved-env)]\n   552\t                            (if (or (:blocked? res)\n   553\t                                    (and (nil? (:control res)) (nil? (:k res))))\n   554\t                              res\n   555\t                              (recur (:control res)\n   556\t                                     (:env res)\n   557\t                                     (:k res)\n   558\t                                     (:value res)\n   559\t                                     res)))\n   560\t                          (recur nil saved-env (:next k) result vm)))\n   561\t                      :else (throw (ex-info \"Cannot apply non-function\"\n   562\t                                            {:fn fn-value})))\n   563\t                (let [updated-frame (assoc frame\n   564\t                                           :operator-evaluated? true\n   565\t                                           :fn fn-value)]\n   566\t                  (recur (first operands)\n   567\t                         saved-env\n   568\t                         (assoc k\n   569\t                                :type :eval-operand\n   570\t                                :frame updated-frame)\n   571\t                         nil\n   572\t                         vm))))\n   573\t            :eval-operand\n   574\t            (let [frame (:frame k)\n   575\t                  operand-value val\n   576\t                  evaluated (conj (or (:evaluated frame) []) operand-value)\n   577\t                  operands (:operands frame)\n   578\t                  saved-env (or (:env k) env)]\n   579\t              (if (= (count evaluated) (count operands))\n   580\t                (let [fn-value (:fn frame)]\n   581\t                  (cond (= :closure (:type fn-value))\n   582\t                        (let [{:keys [params body], closure-env :env} fn-value\n   583\t                              extended-env (merge closure-env\n   584\t                                                  (zipmap params evaluated))]\n   585\t                          (recur body extended-env (:next k) val vm))\n   586\t                        (fn? fn-value)\n   587\t                        (let [result (apply fn-value evaluated)]\n   588\t                          (if (module/effect? result)\n   589\t                            (let [state (cesk-return vm control env k val)\n   590\t                                  res (handle-primitive-result state\n   591\t                                                               result\n   592\t                                                               (:next k)\n   593\t                                                               saved-env)]\n   594\t                              (if (or (:blocked? res)\n   595\t                                      (and (nil? (:control res))\n   596\t                                           (nil? (:k res))))\n   597\t                                res\n   598\t                                (recur (:control res)\n   599\t                                       (:env res)\n   600\t                                       (:k res)\n   601\t                                       (:value res)\n   602\t                                       res)))\n   603\t                            (recur nil saved-env (:next k) result vm)))\n   604\t                        :else (throw (ex-info \"Cannot apply non-function\"\n   605\t                                              {:fn fn-value}))))\n   606\t                (let [next-idx (count evaluated)\n   607\t                      next-node (nth operands next-idx)\n   608\t                      updated-frame (assoc frame :evaluated evaluated)]\n   609\t                  (recur next-node\n   610\t                         saved-env\n   611\t                         (assoc k :frame updated-frame)\n   612\t                         nil\n   613\t                         vm))))\n   614\t            :eval-test (let [frame (:frame k)\n   615\t                             test-value val\n   616\t                             saved-env (or (:env k) env)\n   617\t                             branch (if test-value\n   618\t                                      (:consequent frame)\n   619\t                                      (:alternate frame))]\n   620\t                         (recur branch saved-env (:next k) test-value vm))\n   621\t            (let [state (cesk-return vm control env k val)\n   622\t                  next (cesk-transition state nil)]\n   623\t              (if (or (:blocked? next)\n   624\t                      (and (nil? (:control next)) (nil? (:k next))))\n   625\t                next\n   626\t                (recur (:control next)\n   627\t                       (:env next)\n   628\t                       (:k next)\n   629\t                       (:value next)\n   630\t                       next)))))\n   631\t        node (case type\n   632\t               :literal (recur nil env k (:value node) vm)\n   633\t               :variable (let [v (engine/resolve-var env\n   634\t                                                     (:store vm)\n   635\t                                                     (:primitives vm)\n   636\t                                                     (:modules vm)\n   637\t                                                     (:name node))]\n   638\t                           (recur nil env k v vm))\n   639\t               :lambda (recur nil\n   640\t                              env\n   641\t                              k\n   642\t                              {:type :closure,\n   643\t                               :params (:params node),\n   644\t                               :body (:body node),\n   645\t                               :env env}\n   646\t                              vm)\n   647\t               :application\n   648\t               (recur (:operator node)\n   649\t                      env\n   650\t                      {:frame node, :next k, :env env, :type :eval-operator}\n   651\t                      val\n   652\t                      vm)\n   653\t               :if (recur (:test node)\n   654\t                          env\n   655\t                          {:frame node, :next k, :env env, :type :eval-test}\n   656\t                          val\n   657\t                          vm)\n   658\t               (let [state (cesk-return vm node env k val)\n   659\t                     next (cesk-transition state nil)]\n   660\t                 (if (or (:blocked? next)\n   661\t                         (and (nil? (:control next)) (nil? (:k next))))\n   662\t                   next\n   663\t                   (recur (:control next)\n   664\t                          (:env next)\n   665\t                          (:k next)\n   666\t                          (:value next)\n   667\t                          next))))\n   668\t        :else (let [result (cesk-return vm control env k val)]\n   669\t                (cond (:blocked? result)\n   670\t                      (let [v' (engine/check-wait-set result)]\n   671\t                        (if-let [resumed (resume-from-run-queue v')]\n   672\t                          (recur (:control resumed)\n   673\t                                 (:env resumed)\n   674\t                                 (:k resumed)\n   675\t                                 (:value resumed)\n   676\t                                 resumed)\n   677\t                          v'))\n   678\t                      (seq (or (:ready-queue result) []))\n   679\t                      (if-let [resumed (resume-from-run-queue result)]\n   680\t                        (recur (:control resumed)\n   681\t                               (:env resumed)\n   682\t                               (:k resumed)\n   683\t                               (:value resumed)\n   684\t                               resumed)\n   685\t                        result)\n   686\t                      :else result))))))\n   687\t\n   688\t\n   689\t;; =============================================================================\n   690\t;; ASTWalkerVM Protocol Implementation\n   691\t;; =============================================================================\n   692\t\n   693\t(defn- vm-step\n   694\t  \"Execute one step of ASTWalkerVM. Returns updated VM.\"\n   695\t  [^ASTWalkerVM vm]\n   696\t  (cesk-transition vm nil))\n   697\t\n   698\t\n   699\t(defn- vm-halted?\n   700\t  [^ASTWalkerVM vm]\n   701\t  (engine/halted-with-empty-queue? vm))\n   702\t\n   703\t\n   704\t(defn- vm-blocked?\n   705\t  [^ASTWalkerVM vm]\n   706\t  (engine/vm-blocked? vm))\n   707\t\n   708\t\n   709\t(defn- vm-value\n   710\t  [^ASTWalkerVM vm]\n   711\t  (engine/vm-value vm))\n   712\t\n   713\t\n   714\t(defn- vm-load-program\n   715\t  \"Load one datom transaction into the VM.\"\n   716\t  [^ASTWalkerVM vm datoms]\n   717\t  (let [ast (vm/datoms->ast datoms)]\n   718\t    (assoc vm\n   719\t           :program ast\n   720\t           :control ast\n   721\t           :halted? false\n   722\t           :blocked? false\n   723\t           :value nil)))\n   724\t\n   725\t\n   726\t(defn- vm-reset\n   727\t  \"Reset execution state, preserving the loaded AST program.\"\n   728\t  [^ASTWalkerVM vm]\n   729\t  (assoc vm\n   730\t         :control (:program vm)\n   731\t         :k nil\n   732\t         :halted? (nil? (:program vm))\n   733\t         :value nil\n   734\t         :blocked? false))\n   735\t\n   736\t\n   737\t(defn- ast-walker-run-scheduler\n   738\t  \"Thin wrapper over engine/run-loop with vm-step (slow path).\"\n   739\t  [vm]\n   740\t  (engine/run-loop vm\n   741\t                   engine/active-continuation?\n   742\t                   vm-step\n   743\t                   resume-from-run-queue\n   744\t                   ast-walker-restore))\n   745\t\n   746\t\n   747\t(defn- vm-eval\n   748\t  \"Evaluate an AST. Owns the step loop with scheduler.\n   749\t   When ast is non-nil, loads it first. When nil, resumes from current state.\"\n   750\t  [^ASTWalkerVM vm ast]\n   751\t  (let [initial-env (:env vm)\n   752\t        res (if ast\n   753\t              (-> vm\n   754\t                  (vm-load-program (vm/ast->datoms ast))\n   755\t                  (vm/run))\n   756\t              (vm/run vm))]\n   757\t    (engine/restore-initial-env initial-env res)))\n   758\t\n   759\t\n   760\t(defn- ast-walker-run-on-stream\n   761\t  [vm]\n   762\t  (engine/run-on-stream vm\n   763\t                        (:in-stream vm)\n   764\t                        vm-load-program\n   765\t                        vm-step\n   766\t                        resume-from-run-queue\n   767\t                        ast-walker-restore))\n   768\t\n   769\t\n   770\t(extend-type ASTWalkerVM\n   771\t  vm/IVM\n   772\t  (step [vm]\n   773\t    (telemetry/emit-snapshot\n   774\t      (engine/step-on-stream vm (:in-stream vm) vm-load-program vm-step)\n   775\t      :step))\n   776\t  (run [vm] (ffi/maybe-run vm ast-walker-run-on-stream))\n   777\t  (eval [vm ast] (vm-eval vm ast))\n   778\t  (reset [vm] (vm-reset vm))\n   779\t  (halted? [vm] (vm-halted? vm))\n   780\t  (blocked? [vm] (vm-blocked? vm))\n   781\t  (value [vm] (vm-value vm))\n   782\t  vm/IVMState\n   783\t  (control [vm] (:control vm))\n   784\t  (environment [vm] (:env vm))\n   785\t  (store [vm] (:store vm))\n   786\t  (continuation [vm]\n   787\t    (when-let [k-head (:k vm)]\n   788\t      (loop [k k-head\n   789\t             acc []]\n   790\t        (if (nil? k) acc (recur (:next k) (conj acc k)))))))\n   791\t\n   792\t\n   793\t(defn create-vm\n   794\t  \"Create a new ASTWalkerVM.\n   795\t\n   796\t   Options:\n   797\t     :env           initial lexical environment\n   798\t     :primitives    primitive operations map\n   799\t     :modules       module registry value (see `yin.vm.module`)\n   800\t     :make-stream   (fn [capacity] -> create outcome); no default\n   801\t     :call-in       explicit inbound request handle\n   802\t     :call-out      explicit outbound response handle\n   803\t     :call-capacity capacity for a constructed FFI pair\n   804\t     :bridge        host FFI handlers\n   805\t     :in-stream     ingress stream carrying program batches\n   806\t\n   807\t   Construction is all-or-nothing: creating the FFI pair and minting the three\n   808\t   cursors are stream operations, and any non-`ok` outcome fails here rather\n   809\t   than leaving a half-built VM.\"\n   810\t  ([] (create-vm {}))\n   811\t  ([opts]\n   812\t   (let [env (or (:env opts) {})\n   813\t         base (vm/empty-state\n   814\t                (assoc (select-keys opts\n   815\t                                    [:primitives :modules :make-stream :call-in\n   816\t                                     :call-out :call-capacity])\n   817\t                       :telemetry (:telemetry opts)\n   818\t                       :vm-model :ast-walker))\n   819\t         in-stream (:in-stream opts)\n   820\t         in-cursor (when in-stream (vm/mint-oldest in-stream :in-stream))]\n   821\t     (-> (map->ASTWalkerVM (merge base\n   822\t                                  {:bridge nil,\n   823\t                                   :in-stream in-stream,\n   824\t                                   :in-cursor in-cursor,\n   825\t                                   :ingress-gaps 0,\n   826\t                                   :program nil,\n   827\t                                   :control nil,\n   828\t                                   :env env,\n   829\t                                   :k nil,\n   830\t                                   :value nil,\n   831\t                                   :halted? true,\n   832\t                                   :blocked? false}))\n   833\t         (telemetry/install :ast-walker)\n   834\t         (ffi/attach (:bridge opts))\n   835\t         (telemetry/emit-snapshot :init)))))\n     1\t(ns yin.vm.ffi\n     2\t  \"Explicit host-side `dao.stream.apply` bridge state for Yin VMs.\n     3\t\n     4\t   The bridge is data carried by the VM itself:\n     5\t\n     6\t     {:handlers {:op/name (fn [& args] ...)}\n     7\t      :cursor   <opaque cursor on the call-in stream>}\n     8\t\n     9\t   Three things the port had to settle:\n    10\t\n    11\t   - **Minting moved.** v1's `normalize` fabricated `{:position 0}` from a\n    12\t     bare handler map and never saw a handle. An opaque cursor has nothing to\n    13\t     mint against there, so `attach` mints it, where the store is visible.\n    14\t     `attach` runs on a built VM, so with no call pair it errors exactly as\n    15\t     construction does.\n    16\t   - **The step is once-only.** A computed response and the successor cursor\n    17\t     it belongs to are retained until the append succeeds, so a handler runs\n    18\t     at most once per request and a `full` response stream never drops one.\n    19\t   - **A gap at the bridge cursor is fatal.** The FFI pair is sized for the\n    20\t     outstanding calls plus one, so a gap there means a request or a response\n    21\t     was evicted; the parked call it belonged to would wait forever. Reporting\n    22\t     it beats hanging.\n    23\t\n    24\t   Waiters are gone: `park-and-call` places its continuation in the polling\n    25\t   wait set and the ordinary scheduler wakes it when the response lands.\"\n    26\t  (:require [dao.stream :as stream]\n    27\t            [dao.stream.apply :as apply2]\n    28\t            [yin.vm :as vm]\n    29\t            [yin.vm.telemetry :as telemetry]))\n    30\t\n    31\t\n    32\t(defn call-pair\n    33\t  \"Return {:call-in h :call-out h} from a VM store, or nil when the VM was\n    34\t   built without a pair.\"\n    35\t  [store]\n    36\t  (let [in (get store vm/call-in-stream-key)\n    37\t        out (get store vm/call-out-stream-key)]\n    38\t    (when (and in out) {:call-in in, :call-out out})))\n    39\t\n    40\t\n    41\t(defn require-call-pair!\n    42\t  \"Fail when the VM holds no FFI pair. Callers must run this before parking:\n    43\t   an error raised after `park-continuation` strands a continuation in\n    44\t   `:parked` and consumes an id counter.\"\n    45\t  [store what]\n    46\t  (or (call-pair store)\n    47\t      (throw (ex-info \"This VM was constructed without an FFI call pair, so it cannot make a dao.stream.apply call\"\n    48\t                      {:what what}))))\n    49\t\n    50\t\n    51\t(defn normalize\n    52\t  \"Normalize bridge input to explicit bridge state, without minting.\n    53\t\n    54\t   Accepted forms: nil, a handler map, or an explicit\n    55\t   {:handlers ... :cursor ...} map.\"\n    56\t  [bridge]\n    57\t  (cond (nil? bridge) nil\n    58\t        (and (map? bridge) (contains? bridge :handlers))\n    59\t        (update bridge :handlers #(or % {}))\n    60\t        (map? bridge) {:handlers bridge}\n    61\t        :else (throw (ex-info\n    62\t                       \"Bridge must be nil, a handler map, or {:handlers ... :cursor ...}\"\n    63\t                       {:bridge bridge}))))\n    64\t\n    65\t\n    66\t(defn attach\n    67\t  \"Attach explicit bridge state to a built VM, minting the bridge cursor on\n    68\t   the call-in stream when the bridge does not carry one.\"\n    69\t  [vm bridge]\n    70\t  (if-let [bridge* (normalize bridge)]\n    71\t    (let [{:keys [call-in]} (require-call-pair! (:store vm) :bridge)\n    72\t          cursor (or (:cursor bridge*) (vm/mint-oldest call-in :bridge))]\n    73\t      (assoc vm :bridge (assoc bridge* :cursor cursor)))\n    74\t    vm))\n    75\t\n    76\t\n    77\t(defn bridge-from-opts\n    78\t  \"Read bridge configuration from create-vm opts. `:bridge` is the canonical\n    79\t   key. Minting happens in `attach`, which runs after the pair exists.\"\n    80\t  [opts]\n    81\t  (normalize (:bridge opts)))\n    82\t\n    83\t\n    84\t(defn installed?\n    85\t  \"True when the VM carries explicit bridge handlers.\"\n    86\t  [vm]\n    87\t  (boolean (seq (get-in vm [:bridge :handlers]))))\n    88\t\n    89\t\n    90\t(defn- retain\n    91\t  [vm response successor request-id]\n    92\t  (update vm\n    93\t          :bridge\n    94\t          assoc\n    95\t          :pending-response response\n    96\t          :pending-successor successor\n    97\t          :pending-request-id request-id))\n    98\t\n    99\t\n   100\t(defn- clear-pending\n   101\t  [vm]\n   102\t  (update vm\n   103\t          :bridge\n   104\t          (fn [b]\n   105\t            (dissoc b :pending-response :pending-successor :pending-request-id))))\n   106\t\n   107\t\n   108\t(defn- deliver-response\n   109\t  \"Append one computed response, total over the five append outcomes.\n   110\t\n   111\t   `ok` advances the bridge cursor to the retained successor exactly once.\n   112\t   `full` retains both response and successor without advancing, so the\n   113\t   handler is not re-run. The three terminal outcomes advance once, report the\n   114\t   response undeliverable, and terminate the bridge.\"\n   115\t  [vm response successor request-id]\n   116\t  (let [call-out (get (:store vm) vm/call-out-stream-key)\n   117\t        result (apply2/put-response! call-out response)\n   118\t        o (:dao.stream/outcome result)]\n   119\t    (case o\n   120\t      :dao.stream/ok {:handled? true,\n   121\t                      :vm (-> vm\n   122\t                              (clear-pending)\n   123\t                              (assoc-in [:bridge :cursor] successor)),\n   124\t                      :request-id request-id}\n   125\t      :dao.stream/full {:handled? false,\n   126\t                        :retained? true,\n   127\t                        :vm (retain vm response successor request-id)}\n   128\t      ;; Includes :dao.stream.apply/invalid-response, which put-response!\n   129\t      ;; reports rather than appending.\n   130\t      {:handled? false,\n   131\t       :terminal o,\n   132\t       :undeliverable response,\n   133\t       :vm (-> vm\n   134\t               (clear-pending)\n   135\t               (assoc-in [:bridge :cursor] successor)\n   136\t               (assoc-in [:bridge :terminal] o))})))\n   137\t\n   138\t\n   139\t(defn bridge-step\n   140\t  \"Handle one pending `dao.stream.apply` request from the VM's call-in\n   141\t   stream.\n   142\t\n   143\t   Returns {:handled? true :vm vm' :request-id id} when a response was\n   144\t   appended, or {:handled? false :vm vm ...} otherwise. A `:terminal` key\n   145\t   names the outcome that ended the bridge.\"\n   146\t  [vm]\n   147\t  (let [bridge (:bridge vm)\n   148\t        handlers (:handlers bridge)\n   149\t        cursor (:cursor bridge)]\n   150\t    (cond\n   151\t      (:terminal bridge) {:handled? false, :vm vm, :terminal (:terminal bridge)}\n   152\t      (:pending-response bridge)\n   153\t      (deliver-response vm\n   154\t                        (:pending-response bridge)\n   155\t                        (:pending-successor bridge)\n   156\t                        (:pending-request-id bridge))\n   157\t      :else\n   158\t      (let [call-in (get (:store vm) vm/call-in-stream-key)\n   159\t            _ (when (nil? call-in)\n   160\t                (throw (ex-info \"This VM has no call-in stream to bridge\"\n   161\t                                {:bridge? (some? bridge)})))\n   162\t            result (stream/next call-in cursor)\n   163\t            o (:dao.stream/outcome result)]\n   164\t        (case o\n   165\t          :dao.stream/ok\n   166\t          (let [request (:dao.stream/value result)\n   167\t                successor (:dao.stream/cursor result)\n   168\t                response (apply2/dispatch-request handlers request)]\n   169\t            (if (nil? response)\n   170\t              ;; A malformed request without a usable id is a local diagnostic\n   171\t              ;; and advances once; no handler ever saw it.\n   172\t              {:handled? false,\n   173\t               :diagnostic :dao.stream.apply/malformed-request,\n   174\t               :vm (assoc-in vm [:bridge :cursor] successor)}\n   175\t              (deliver-response\n   176\t                (telemetry/emit-snapshot\n   177\t                  vm\n   178\t                  :bridge\n   179\t                  {:bridge-op (apply2/request-op request),\n   180\t                   :arg-shape (mapv telemetry/type-tag\n   181\t                                    (or (apply2/request-args request) []))})\n   182\t                response\n   183\t                successor\n   184\t                (apply2/request-id request))))\n   185\t          :dao.stream/blocked {:handled? false, :vm vm, :outcome o}\n   186\t          :dao.stream/gap\n   187\t          (throw (ex-info \"Gap at the FFI bridge cursor: a request was evicted and the call that made it can never be answered\"\n   188\t                          {:vm-model (:vm-model vm)}))\n   189\t          ;; :end, :cursor-mismatch, :invalid-cursor, :transport-error\n   190\t          {:handled? false,\n   191\t           :terminal o,\n   192\t           :vm (assoc-in vm [:bridge :terminal] o)})))))\n   193\t\n   194\t\n   195\t(defn maybe-run\n   196\t  \"Run a VM with bridge dispatch if explicit bridge handlers are installed.\n   197\t\n   198\t   run-fn must be the VM-specific raw runner that advances the VM until halt\n   199\t   or block without recursively calling vm/run again.\"\n   200\t  [vm run-fn]\n   201\t  (if-not (installed? vm)\n   202\t    (run-fn vm)\n   203\t    (loop [v (run-fn vm)]\n   204\t      (if (:blocked? v)\n   205\t        (let [{:keys [handled? diagnostic vm]} (bridge-step v)]\n   206\t          (cond handled? (recur (run-fn vm))\n   207\t                ;; A malformed request consumed as a diagnostic advanced the\n   208\t                ;; cursor, so there may be a real request behind it.\n   209\t                diagnostic (recur vm)\n   210\t                :else vm))\n   211\t        v))))\n     1\t(ns yin.vm.runtime-adapter\n     2\t  \"Wrap VM wait-set entries as dao.runtime tasks.\n     3\t\n     4\t   The only v1 idiom here was cursor arithmetic: a woken reader advanced its\n     5\t   stored cursor by `(inc position)`. A v2 cursor is opaque, so the successor\n     6\t   comes from the transport in the `next` outcome and is stored as it was\n     7\t   given.\"\n     8\t  (:require [dao.runtime :as rt]))\n     9\t\n    10\t\n    11\t(defn- terminal-resume-outcome\n    12\t  \"The outcome a parked retry terminated with, when it is one the immediate\n    13\t   path raises as an error.\n    14\t\n    15\t   `dao.runtime` wakes a task for every outcome except the two that can\n    16\t   change on their own, so a retry that ends in a terminal outcome would\n    17\t   otherwise reach Yin code as an ordinary value. `handle-put` and\n    18\t   `handle-next` throw for these same outcomes, and whether the first attempt\n    19\t   blocked must not change that. A writer's `:end` is `closed` wearing its\n    20\t   task classification and is reported under the outcome the transport gave.\"\n    21\t  [vm-entry status]\n    22\t  (case (:reason vm-entry)\n    23\t    :next (case status\n    24\t            (:dao.stream/cursor-mismatch\n    25\t              :dao.stream/invalid-cursor\n    26\t              :dao.stream/transport-error)\n    27\t            status\n    28\t            nil)\n    29\t    :put (case status\n    30\t           :end :dao.stream/closed\n    31\t           (:dao.stream/invalid-value :dao.stream/transport-error) status\n    32\t           nil)\n    33\t    nil))\n    34\t\n    35\t\n    36\t(defn- throw-terminal-resume!\n    37\t  \"Fail a resumed task exactly as the immediate operation would have.\"\n    38\t  [vm-entry outcome]\n    39\t  (if (= :next (:reason vm-entry))\n    40\t    (throw (ex-info \"Stream read failed\"\n    41\t                    {:outcome outcome,\n    42\t                     :stream-id (:stream-id vm-entry),\n    43\t                     :cursor-id (:id (:cursor-ref vm-entry))}))\n    44\t    (throw (ex-info \"Stream append failed\"\n    45\t                    {:outcome outcome, :stream-id (:stream-id vm-entry)}))))\n    46\t\n    47\t\n    48\t(defn- calculate-store-updates\n    49\t  \"Store updates for a woken entry.\n    50\t\n    51\t   A reader carries a `:cursor-ref` into the VM store; waking it replaces that\n    52\t   entry's opaque cursor with the successor the transport returned. A writer\n    53\t   carries whatever updates it was built with.\"\n    54\t  [rt vm-entry _value cursor]\n    55\t  (if-let [cursor-ref (:cursor-ref vm-entry)]\n    56\t    (let [cursor-id (:id cursor-ref)\n    57\t          cursor-data (get (:store rt) cursor-id)]\n    58\t      (when cursor {cursor-id (assoc cursor-data :cursor cursor)}))\n    59\t    (:store-updates vm-entry)))\n    60\t\n    61\t\n    62\t(defn vm-task\n    63\t  \"Wrap a VM entry as a dao.runtime task.\"\n    64\t  [vm-entry restore-fn]\n    65\t  (let [vm-entry (or (:task vm-entry) vm-entry)]\n    66\t    (merge vm-entry\n    67\t           {:task vm-entry,\n    68\t            :resume\n    69\t            (fn [rt task-entry value]\n    70\t              (let [vm-entry (:task task-entry)\n    71\t                    value (or value (:value task-entry))\n    72\t                    cursor (or (:cursor task-entry) (:cursor vm-entry))\n    73\t                    terminal (terminal-resume-outcome vm-entry\n    74\t                                                      (:status task-entry))]\n    75\t                (when terminal (throw-terminal-resume! vm-entry terminal))\n    76\t                (let [store-updates\n    77\t                      (calculate-store-updates rt vm-entry value cursor)\n    78\t                      base (assoc rt\n    79\t                                  :store (merge (:store rt) store-updates)\n    80\t                                  :blocked? false\n    81\t                                  :halted? false\n    82\t                                  :ready-queue (:ready-queue rt)\n    83\t                                  :wait-set (:wait-set rt))]\n    84\t                  (restore-fn base vm-entry value))))})))\n    85\t\n    86\t\n    87\t(defn enqueue-woken-vm-entries\n    88\t  \"Translate raw woken entries into dao.runtime ready-queue entries using\n    89\t   the VM-specific resume wrapper.\"\n    90\t  [rt woken restore-fn]\n    91\t  (let [tasks (mapv (fn [{:keys [entry value cursor]}]\n    92\t                      (let [task (vm-task entry restore-fn)]\n    93\t                        (assoc task\n    94\t                               :value value\n    95\t                               :cursor cursor)))\n    96\t                    woken)]\n    97\t    (rt/enqueue-ready rt tasks)))\n     1\t(ns yin.vm.stream-driver\n     2\t  \"Ingress: poll one program batch from the VM's `:in-stream` between\n     3\t   evaluations.\n     4\t\n     5\t   Two things change from v1. The ingress cursor is never fabricated — it is\n     6\t   minted `:dao.stream/oldest` when the VM first holds the handle and is\n     7\t   thereafter whatever the transport last returned. And `next` answers with an\n     8\t   outcome map over a closed set, so every outcome has a branch here.\n     9\t\n    10\t   A `gap` is recoverable at ingress and only here. v1 threw, because its\n    11\t   transport could not evict; a v2 composition may hand the VM an\n    12\t   evict-oldest transport, and a batch the VM never saw is a program it never\n    13\t   ran. Losing it is reported by advancing to the recovery cursor and counting\n    14\t   the gap, and ingestion continues with the next batch. Silently pretending\n    15\t   the stream was contiguous is the failure this avoids.\"\n    16\t  (:require [dao.stream :as stream]))\n    17\t\n    18\t\n    19\t(defn ready-for-ingress?\n    20\t  \"Returns true when the VM is between evaluations and can poll :in-stream.\"\n    21\t  [vm]\n    22\t  (let [has-bytecode? (contains? vm :bytecode)\n    23\t        bytecode (:bytecode vm)\n    24\t        no-bytecode? (and has-bytecode?\n    25\t                          (or (nil? bytecode)\n    26\t                              (and (sequential? bytecode) (empty? bytecode))))]\n    27\t    (and (not (:blocked? vm))\n    28\t         (empty? (or (:ready-queue vm) []))\n    29\t         (empty? (or (:wait-set vm) []))\n    30\t         (nil? (:k vm))\n    31\t         (or (:halted? vm) (nil? (:control vm)) no-bytecode?))))\n    32\t\n    33\t\n    34\t(defn- idle\n    35\t  [vm]\n    36\t  (assoc vm :halted? true :blocked? false))\n    37\t\n    38\t\n    39\t(defn ingest-next-program\n    40\t  \"Poll one program batch from in-stream and hand it to load-fn.\n    41\t   Returns {:status :ok|:blocked|:end|:gap :state vm'}.\"\n    42\t  [vm in-stream load-fn]\n    43\t  (let [cursor (:in-cursor vm)\n    44\t        result (stream/next in-stream cursor)\n    45\t        outcome (:dao.stream/outcome result)]\n    46\t    (case outcome\n    47\t      :dao.stream/ok\n    48\t      (let [cursor' (:dao.stream/cursor result)\n    49\t            vm' (-> (assoc vm :in-cursor cursor')\n    50\t                    (load-fn (:dao.stream/value result))\n    51\t                    (assoc :in-cursor cursor'))]\n    52\t        {:status :ok, :state vm'})\n    53\t      :dao.stream/blocked {:status :blocked, :state (idle vm)}\n    54\t      :dao.stream/end {:status :end, :state (idle vm)}\n    55\t      :dao.stream/gap {:status :gap,\n    56\t                       :state (-> vm\n    57\t                                  (assoc :in-cursor (:dao.stream/cursor result))\n    58\t                                  (update :ingress-gaps (fnil inc 0)))}\n    59\t      (:dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n    60\t                                   :dao.stream/transport-error)\n    61\t      (throw (ex-info \"VM ingress cannot continue from this cursor\"\n    62\t                      {:outcome outcome, :vm-model (:vm-model vm)}))\n    63\t      (throw (ex-info \"Unexpected DaoStream outcome while ingesting VM program\"\n    64\t                      {:outcome outcome, :vm-model (:vm-model vm)})))))\n    65\t\n    66\t\n    67\t(defn step-on-stream\n    68\t  \"If the VM is idle, ingest one pending program batch before executing a\n    69\t   single step. A gap consumes the step: the loss is recorded and the caller\n    70\t   sees an idle VM whose cursor has moved to the recovery point.\"\n    71\t  [vm in-stream load-fn step-fn]\n    72\t  (cond (and in-stream (ready-for-ingress? vm))\n    73\t        (let [{:keys [status state]}\n    74\t              (ingest-next-program vm in-stream load-fn)]\n    75\t          (case status\n    76\t            :ok (step-fn state)\n    77\t            state))\n    78\t        (ready-for-ingress? vm) vm\n    79\t        :else (step-fn vm)))\n","exit_code":0,"status":"completed"}}
