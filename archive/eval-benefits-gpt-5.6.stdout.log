{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/dao/stream/ringbuffer.cljc; nl -ba src/cljc/dao/stream/ws.cljc; nl -ba src/cljc/dao/stream/serving.cljc; nl -ba src/cljc/dao/stream/forward.cljc; nl -ba src/cljs/dao/stream/ws/node.cljs; nl -ba src/clj/dao/stream/ws/jvm.clj'","aggregated_output":"     1\t(ns dao.stream.ringbuffer\n     2\t  \"Fixed-capacity, evict-oldest DaoStream v2 reference transport.\"\n     3\t  (:require [dao.stream :as stream]))\n     4\t\n     5\t\n     6\t(def transport-type :dao.stream/ringbuffer)\n     7\t(def capacity-key :dao.stream.ringbuffer/capacity)\n     8\t\n     9\t\n    10\t(defn- result\n    11\t  [outcome]\n    12\t  {:dao.stream/outcome outcome})\n    13\t\n    14\t\n    15\t(defn- valid-spec?\n    16\t  [spec]\n    17\t  (and (map? spec)\n    18\t       (= transport-type (:dao.stream/type spec))\n    19\t       (integer? (get spec capacity-key))\n    20\t       (pos? (get spec capacity-key))))\n    21\t\n    22\t\n    23\t(defn- fresh-state\n    24\t  [capacity]\n    25\t  ;; The logical identity is carried in descriptors and cursors.  It therefore\n    26\t  ;; belongs to DaoStream's portable data domain, unlike a host UUID object.\n    27\t  (atom {:identity (str (random-uuid))\n    28\t         :capacity capacity\n    29\t         :first 0\n    30\t         :tail 0\n    31\t         :values {}\n    32\t         :closed? false\n    33\t         :attachments {}}))\n    34\t\n    35\t\n    36\t(declare attach!)\n    37\t\n    38\t\n    39\t(deftype RingHandle\n    40\t  [state attachment-id owner?]\n    41\t\n    42\t  stream/IDaoStreamDescriptor\n    43\t\n    44\t  (descriptor\n    45\t    [_]\n    46\t    (let [s @state]\n    47\t      {:dao.stream/outcome :dao.stream/ok\n    48\t       :dao.stream/descriptor {:dao.stream/type transport-type\n    49\t                               :dao.stream/identity (:identity s)}\n    50\t       :dao.stream/identity (:identity s)}))\n    51\t\n    52\t\n    53\t  stream/IDaoStreamReader\n    54\t\n    55\t  (cursor\n    56\t    [_ anchor]\n    57\t    (let [s @state]\n    58\t      (if (and (not owner?) (not (get-in s [:attachments attachment-id :open?])))\n    59\t        (result :dao.stream/closed)\n    60\t        (case anchor\n    61\t          :dao.stream/oldest (assoc (result :dao.stream/ok)\n    62\t                                    :dao.stream/cursor\n    63\t                                    {:dao.stream.ringbuffer/identity (:identity s)\n    64\t                                     :dao.stream.ringbuffer/position (:first s)})\n    65\t          :dao.stream/newest (assoc (result :dao.stream/ok)\n    66\t                                    :dao.stream/cursor\n    67\t                                    {:dao.stream.ringbuffer/identity (:identity s)\n    68\t                                     :dao.stream.ringbuffer/position (:tail s)})\n    69\t          (result :dao.stream/invalid-anchor)))))\n    70\t\n    71\t\n    72\t  (next\n    73\t    [_ cursor-value]\n    74\t    (let [s @state]\n    75\t      (cond\n    76\t        (not (map? cursor-value)) (result :dao.stream/invalid-cursor)\n    77\t        (not (contains? cursor-value :dao.stream.ringbuffer/identity))\n    78\t        (result :dao.stream/invalid-cursor)\n    79\t        (not= (:identity s) (:dao.stream.ringbuffer/identity cursor-value))\n    80\t        (result :dao.stream/cursor-mismatch)\n    81\t        (not (integer? (:dao.stream.ringbuffer/position cursor-value)))\n    82\t        (result :dao.stream/invalid-cursor)\n    83\t        :else\n    84\t        (let [pos (:dao.stream.ringbuffer/position cursor-value)\n    85\t              frozen (when-not owner? (get-in s [:attachments attachment-id :tail]))\n    86\t              visible-tail (if (some? frozen) frozen (:tail s))]\n    87\t          (cond\n    88\t            (< pos (:first s))\n    89\t            (assoc (result :dao.stream/gap)\n    90\t                   :dao.stream/cursor\n    91\t                   {:dao.stream.ringbuffer/identity (:identity s)\n    92\t                    ;; The contract's recovery position is the earliest retained\n    93\t                    ;; position, which equals the tail when nothing is retained.\n    94\t                    ;; It must never be an evicted position: a frozen attachment\n    95\t                    ;; whose visible history is fully evicted would otherwise be\n    96\t                    ;; handed its own tail back and re-gap forever.  Recovering\n    97\t                    ;; past that tail is correct; the next read answers `end`.\n    98\t                    :dao.stream.ringbuffer/position (:first s)})\n    99\t            (< pos visible-tail)\n   100\t            ;; `:first`, `:tail`, and `:values` are updated as one state value;\n   101\t            ;; positions in this interval are always retained by the transport.\n   102\t            {:dao.stream/outcome :dao.stream/ok\n   103\t             :dao.stream/value (get (:values s) pos)\n   104\t             :dao.stream/cursor {:dao.stream.ringbuffer/identity (:identity s)\n   105\t                                 :dao.stream.ringbuffer/position (inc pos)}}\n   106\t            (or (:closed? s) (some? frozen)) (result :dao.stream/end)\n   107\t            :else (result :dao.stream/blocked))))))\n   108\t\n   109\t\n   110\t  stream/IDaoStreamWriter\n   111\t\n   112\t  (append!\n   113\t    [_ value]\n   114\t    ;; Check attachment liveness *inside* the one state transition.  A deref\n   115\t    ;; before swap! permits an append that began before an attachment close to\n   116\t    ;; land after it; this form gives append!/close! a single linearization point.\n   117\t    (let [out (volatile! nil)]\n   118\t      (swap! state\n   119\t             (fn [s]\n   120\t               (if (or (:closed? s)\n   121\t                       (and (not owner?)\n   122\t                            (not (get-in s [:attachments attachment-id :open?]))))\n   123\t                 (do (vreset! out (result :dao.stream/closed)) s)\n   124\t                 (let [p (:tail s) n (inc p)\n   125\t                       first' (max (:first s) (- n (:capacity s)))]\n   126\t                   (vreset! out (result :dao.stream/ok))\n   127\t                   (-> s (assoc :tail n :first first')\n   128\t                       (assoc :values\n   129\t                              (assoc (if (> first' (:first s))\n   130\t                                       (dissoc (:values s) (:first s))\n   131\t                                       (:values s)) p value)))))))\n   132\t      @out))\n   133\t\n   134\t\n   135\t  stream/IDaoStreamClosable\n   136\t\n   137\t  (close!\n   138\t    [_]\n   139\t    (swap! state\n   140\t           (fn [s]\n   141\t             (if owner?\n   142\t               (assoc s :closed? true)\n   143\t               ;; Preserve the first frozen tail.  Later idempotent closes must\n   144\t               ;; not make post-close values visible through this attachment.\n   145\t               (if (get-in s [:attachments attachment-id :open?])\n   146\t                 (assoc-in s [:attachments attachment-id]\n   147\t                           {:open? false :tail (:tail s)})\n   148\t                 s))))\n   149\t    (result :dao.stream/ok)))\n   150\t\n   151\t\n   152\t(defn create!\n   153\t  \"Create a ring buffer from a creation specification.\"\n   154\t  [spec]\n   155\t  (if-not (valid-spec? spec)\n   156\t    (result :dao.stream/invalid-spec)\n   157\t    (let [state (fresh-state (get spec capacity-key))]\n   158\t      {:dao.stream/outcome :dao.stream/ok\n   159\t       :dao.stream/handle (RingHandle. state nil true)\n   160\t       :dao.stream/identity (:identity @state)})))\n   161\t\n   162\t\n   163\t(defn- resolve-state\n   164\t  [resolver identity]\n   165\t  (let [x (if (fn? resolver) (resolver identity) (get resolver identity))]\n   166\t    (cond (instance? RingHandle x) (.-state ^RingHandle x)\n   167\t          #?(:cljd false\n   168\t             :clj (instance? clojure.lang.IAtom x)\n   169\t             :cljs (instance? cljs.core/Atom x)) x\n   170\t          :else nil)))\n   171\t\n   172\t\n   173\t(defn attach!\n   174\t  \"Attach using a host-owned resolver (identity -> handle/state).\"\n   175\t  [resolver descriptor]\n   176\t  (if-not (and (map? descriptor)\n   177\t               (= transport-type (:dao.stream/type descriptor))\n   178\t               (contains? descriptor :dao.stream/identity))\n   179\t    (result :dao.stream/invalid-descriptor)\n   180\t    (if-let [state (resolve-state resolver (:dao.stream/identity descriptor))]\n   181\t      ;; A resolver is host composition, not a trusted decoder.  Confirm that\n   182\t      ;; its result actually denotes the descriptor's identity before minting a\n   183\t      ;; handle; otherwise a mis-keyed directory silently attaches elsewhere.\n   184\t      (if (= (:dao.stream/identity descriptor) (:identity @state))\n   185\t        (let [id (str (random-uuid))]\n   186\t          (swap! state assoc-in [:attachments id] {:open? true})\n   187\t          {:dao.stream/outcome :dao.stream/ok\n   188\t           :dao.stream/handle (RingHandle. state id false)\n   189\t           :dao.stream/attachment id})\n   190\t        (result :dao.stream/not-found))\n   191\t      (result :dao.stream/not-found))))\n   192\t\n   193\t\n   194\t(defn make-attacher\n   195\t  \"Return a unary attach! closure over host-owned resolver state.\n   196\t   This small directory is composition/test infrastructure, never a registry\n   197\t   owned by DaoStream or this namespace.\"\n   198\t  [resolver]\n   199\t  (fn [descriptor] (attach! resolver descriptor)))\n     1\t(ns dao.stream.ws\n     2\t  \"The DaoStream v2 WebSocket protocol boundary.\n     3\t\n     4\t   This namespace deliberately knows no WebSocket library.  A host adapter owns\n     5\t   its raw socket and supplies the small synchronous `:connect!`, `:send!`, and\n     6\t   `:close!` functions below.  The public DaoStream surface is consequently\n     7\t   callback-free, non-waiting, and portable; socket callbacks enter only through\n     8\t   the adapter map returned to the host while it constructs a connection.\"\n     9\t  (:require [dao.stream :as stream]\n    10\t            [dao.stream.transit :as transit]\n    11\t            [clojure.string :as str]))\n    12\t\n    13\t\n    14\t(def transport-type :dao.stream/ws)\n    15\t(def subprotocol \"dao.stream.transit-json\")\n    16\t(def ended-close-code 4000)\n    17\t(def protocol-close-code 4002)\n    18\t(def disclaim-close-code 4004)\n    19\t\n    20\t\n    21\t(defn- outcome\n    22\t  [x]\n    23\t  {:dao.stream/outcome x})\n    24\t\n    25\t\n    26\t(defn canonical-path?\n    27\t  \"True for the already-canonical request-target form carried on a descriptor.\n    28\t   URI parsing and bind policy belong to the host adapter; this gate prevents a\n    29\t   query, fragment, relative path, or unresolved dot segment from reaching the\n    30\t   exact served-path lookup.\"\n    31\t  [path]\n    32\t  (and (string? path)\n    33\t       (not (empty? path))\n    34\t       (str/starts-with? path \"/\")\n    35\t       (not (str/includes? path \"?\"))\n    36\t       (not (str/includes? path \"#\"))\n    37\t       (not (some #{\".\" \"..\"} (str/split path #\"/\")))))\n    38\t\n    39\t\n    40\t(defn descriptor?\n    41\t  \"The settled WebSocket descriptor gate.  It names a served stream, not a\n    42\t   particular connection, and contains only portable reachability data.\"\n    43\t  [x]\n    44\t  (and (map? x)\n    45\t       (= transport-type (:dao.stream/type x))\n    46\t       (string? (:dao.stream/identity x))\n    47\t       (string? (:ws/host x))\n    48\t       (integer? (:ws/port x))\n    49\t       (pos? (:ws/port x))\n    50\t       (canonical-path? (:ws/path x))\n    51\t       (transit/portable-value? x)))\n    52\t\n    53\t\n    54\t(defn admission?\n    55\t  \"Assembly-time declaration required for every transport deposit medium.\"\n    56\t  [x]\n    57\t  (and (map? x)\n    58\t       (= :evict-oldest (:retention x))\n    59\t       (integer? (:capacity x))\n    60\t       (pos? (:capacity x))\n    61\t       (contains? #{:host-values :portable-values} (:value-domain x))))\n    62\t\n    63\t\n    64\t(defn- writer-target?\n    65\t  [x]\n    66\t  (and (map? x)\n    67\t       (stream/writer? (:dao.stream/handle x))\n    68\t       (contains? (:dao.stream/surface x) :writer)))\n    69\t\n    70\t\n    71\t(defn- checked-target\n    72\t  [target declaration]\n    73\t  (when-not (and (writer-target? target) (admission? declaration))\n    74\t    (throw (ex-info \"invalid DaoStream WebSocket deposit composition\"\n    75\t                    {:target target :admission declaration})))\n    76\t  target)\n    77\t\n    78\t\n    79\t(defn- attachment-id\n    80\t  []\n    81\t  (str (random-uuid)))\n    82\t\n    83\t\n    84\t(defn- invoke-close!\n    85\t  [socket code reason]\n    86\t  (when-let [f (:close! socket)]\n    87\t    (try\n    88\t      (f code reason)\n    89\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n    90\t        ;; The connection has already transitioned locally.  The caller adds a\n    91\t        ;; diagnostic where it still has a functioning composed medium.\n    92\t        :failed))))\n    93\t\n    94\t\n    95\t(defn- send-result\n    96\t  [socket text]\n    97\t  (try\n    98\t    (let [x ((:send! socket) text)]\n    99\t      (cond\n   100\t        (or (nil? x) (= true x) (= :ok x)) (outcome :dao.stream/ok)\n   101\t        (= false x) (outcome :dao.stream/full)\n   102\t        (and (map? x) (:dao.stream/outcome x)) x\n   103\t        :else (outcome :dao.stream/transport-error)))\n   104\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   105\t      (outcome :dao.stream/transport-error))))\n   106\t\n   107\t\n   108\t(declare receive! closed! opened! disclaimed!)\n   109\t\n   110\t\n   111\t(defn- deposit!\n   112\t  [state event]\n   113\t  (let [target (:deposit @state)\n   114\t        result (stream/append! (:dao.stream/handle target) event)]\n   115\t    ;; A host promised this medium admits all boundary events.  A failed\n   116\t    ;; deposit is therefore terminal, rather than a reason to retain a hidden\n   117\t    ;; inbox or silently discard the event.\n   118\t    (when-not (= :dao.stream/ok (:dao.stream/outcome result))\n   119\t      (let [socket (:socket @state)]\n   120\t        (swap! state assoc :phase :closed)\n   121\t        (invoke-close! socket 1000 \"dao.stream/deposit-failed\")))\n   122\t    result))\n   123\t\n   124\t\n   125\t(defn- emit!\n   126\t  \"Deposit one boundary event.  The four-argument form carries a payload and\n   127\t   always keys it, because nil is an ordinary portable value: a consumer must be\n   128\t   able to tell `value nil` from `no value` with `contains?`.\"\n   129\t  ([state attachment event]\n   130\t   (deposit! state {:ws/attachment attachment :ws/event event}))\n   131\t  ([state attachment event value]\n   132\t   (deposit! state {:ws/attachment attachment :ws/event event :ws/value value})))\n   133\t\n   134\t\n   135\t(defn- emit-reason!\n   136\t  [state attachment event reason]\n   137\t  (deposit! state {:ws/attachment attachment :ws/event event :ws/reason reason}))\n   138\t\n   139\t\n   140\t(defn- terminal!\n   141\t  [state attachment event]\n   142\t  (let [emit? (volatile! false)]\n   143\t    (swap! state\n   144\t           (fn [s]\n   145\t             (if (:terminal? s)\n   146\t               s\n   147\t               (do (vreset! emit? true)\n   148\t                   (assoc s :terminal? true :phase :closed)))))\n   149\t    (when @emit? (emit! state attachment event))))\n   150\t\n   151\t\n   152\t(deftype WsHandle\n   153\t  [state descriptor attachment]\n   154\t\n   155\t  stream/IDaoStreamDescriptor\n   156\t\n   157\t  (descriptor\n   158\t    [_]\n   159\t    {:dao.stream/outcome :dao.stream/ok\n   160\t     :dao.stream/descriptor descriptor\n   161\t     :dao.stream/identity (:dao.stream/identity descriptor)})\n   162\t\n   163\t\n   164\t  stream/IDaoStreamWriter\n   165\t\n   166\t  (append!\n   167\t    [_ value]\n   168\t    (let [{:keys [phase socket]} @state]\n   169\t      (cond\n   170\t        (= :closed phase) (outcome :dao.stream/closed)\n   171\t        (not= :open phase) (outcome :dao.stream/full)\n   172\t        (not (transit/portable-value? value)) (outcome :dao.stream/invalid-value)\n   173\t        :else (try\n   174\t                (send-result socket (transit/encode {:ws/frame :ws/value\n   175\t                                                     :ws/value value}))\n   176\t                (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   177\t                  (outcome :dao.stream/invalid-value))))))\n   178\t\n   179\t\n   180\t  stream/IDaoStreamClosable\n   181\t\n   182\t  (close!\n   183\t    [_]\n   184\t    (let [socket (volatile! nil)]\n   185\t      (swap! state\n   186\t             (fn [s]\n   187\t               (if (= :closed (:phase s))\n   188\t                 s\n   189\t                 (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   190\t      (when (= :failed (invoke-close! @socket 1000 \"dao.stream/detached\"))\n   191\t        (emit-reason! state attachment :ws/error :ws/close-failure))\n   192\t      (outcome :dao.stream/ok))))\n   193\t\n   194\t\n   195\t(defn close-ended!\n   196\t  \"Transport-specific close for a serving composition whose source ended.\n   197\t\n   198\t   Generic `stream/close!` is a reattachable detachment.  This helper sends the\n   199\t   WebSocket ended signal (4000 / `dao.stream/ended`) so the peer can deposit\n   200\t   `:ws/ended`.  The host close callback still owns exactly-once terminal event\n   201\t   delivery, just as it does for generic close.\"\n   202\t  [handle]\n   203\t  (let [state (.-state ^WsHandle handle)\n   204\t        attachment (.-attachment ^WsHandle handle)\n   205\t        socket (volatile! nil)]\n   206\t    (swap! state\n   207\t           (fn [s]\n   208\t             (if (= :closed (:phase s))\n   209\t               s\n   210\t               (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   211\t    (when (= :failed (invoke-close! @socket ended-close-code \"dao.stream/ended\"))\n   212\t      (emit-reason! state attachment :ws/error :ws/close-failure))\n   213\t    (outcome :dao.stream/ok)))\n   214\t\n   215\t\n   216\t(defn- new-handle\n   217\t  [descriptor attachment target phase socket]\n   218\t  (let [state (atom {:phase phase :socket socket :deposit target\n   219\t                     :resolution? false :terminal? false})]\n   220\t    [(WsHandle. state descriptor attachment) state]))\n   221\t\n   222\t\n   223\t(defn- protocol-failure!\n   224\t  [state attachment]\n   225\t  (emit-reason! state attachment :ws/error :ws/decode-failure)\n   226\t  (swap! state assoc :phase :closed)\n   227\t  (invoke-close! (:socket @state) protocol-close-code \"dao.stream/protocol-error\"))\n   228\t\n   229\t\n   230\t(defn opened!\n   231\t  \"Adapter entry: the peer's accept control was received (client), or the\n   232\t   endpoint accepted a matching handoff acknowledgement (server).\"\n   233\t  [handle]\n   234\t  (let [state (.-state ^WsHandle handle)\n   235\t        attachment (.-attachment ^WsHandle handle)\n   236\t        emit? (volatile! false)]\n   237\t    (swap! state (fn [s]\n   238\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   239\t                     (do (vreset! emit? true) (assoc s :phase :open :resolution? true))\n   240\t                     s)))\n   241\t    (when @emit? (emit! state attachment :ws/opened))))\n   242\t\n   243\t\n   244\t(defn disclaimed!\n   245\t  \"Adapter entry for the authoritative first `:ws/disclaim` control frame.\"\n   246\t  [handle]\n   247\t  (let [state (.-state ^WsHandle handle)\n   248\t        attachment (.-attachment ^WsHandle handle)\n   249\t        emit? (volatile! false)]\n   250\t    (swap! state (fn [s]\n   251\t                   (if (and (= :connecting (:phase s)) (not (:resolution? s)))\n   252\t                     (do (vreset! emit? true) (assoc s :resolution? true :phase :closed))\n   253\t                     s)))\n   254\t    (when @emit?\n   255\t      (emit! state attachment :ws/not-found)\n   256\t      (invoke-close! (:socket @state) disclaim-close-code \"dao.stream/not-found\"))))\n   257\t\n   258\t\n   259\t(defn receive!\n   260\t  \"Adapter entry for one text WebSocket message.  It performs only wire\n   261\t   validation and envelope translation; application values are never judged.\"\n   262\t  [handle text]\n   263\t  (let [state (.-state ^WsHandle handle)\n   264\t        attachment (.-attachment ^WsHandle handle)]\n   265\t    (try\n   266\t      (let [frame (transit/decode text)]\n   267\t        (cond\n   268\t          (and (= :ws/accept (:ws/frame frame)) (= :connecting (:phase @state)))\n   269\t          (opened! handle)\n   270\t\n   271\t          (and (= :ws/disclaim (:ws/frame frame)) (= :connecting (:phase @state)))\n   272\t          (disclaimed! handle)\n   273\t\n   274\t          (and (= :ws/value (:ws/frame frame))\n   275\t               (contains? frame :ws/value)\n   276\t               (= :open (:phase @state))\n   277\t               (transit/portable-value? (:ws/value frame)))\n   278\t          (emit! state attachment :ws/payload (:ws/value frame))\n   279\t\n   280\t          :else (protocol-failure! state attachment)))\n   281\t      (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   282\t        (protocol-failure! state attachment)))))\n   283\t\n   284\t\n   285\t(defn closed!\n   286\t  \"Adapter entry for host close completion.  The terminal event is guarded so\n   287\t   close/error races cannot duplicate it.\"\n   288\t  [handle code _reason]\n   289\t  (let [state (.-state ^WsHandle handle)\n   290\t        attachment (.-attachment ^WsHandle handle)]\n   291\t    (when-not (:resolution? @state)\n   292\t      (swap! state assoc :resolution? true)\n   293\t      (emit! state attachment :ws/transport-error))\n   294\t    (terminal! state attachment (if (= ended-close-code code) :ws/ended :ws/closed))))\n   295\t\n   296\t\n   297\t(defn adapter\n   298\t  \"The only callback-shaped value, for a host socket adapter while wiring its\n   299\t   private listener.  It is not a DaoStream API and never reaches consumers.\"\n   300\t  [handle]\n   301\t  {:opened! #(opened! handle)\n   302\t   :disclaimed! #(disclaimed! handle)\n   303\t   :message! #(receive! handle %)\n   304\t   :closed! #(closed! handle %1 %2)\n   305\t   :error! #(emit-reason! (.-state ^WsHandle handle) (.-attachment ^WsHandle handle)\n   306\t                          :ws/error :ws/socket-error)})\n   307\t\n   308\t\n   309\t(defn make-attacher\n   310\t  \"Construct the host-composed unary `attach!` entry point.\n   311\t\n   312\t   `:connect!` receives the descriptor and the private adapter map, starts\n   313\t   connection establishment, and synchronously returns a raw-socket adapter\n   314\t   containing `:send!` and `:close!`.  It must not wait for the peer.\"\n   315\t  [{:keys [traffic admission connect!] :as config}]\n   316\t  (let [target (checked-target traffic admission)]\n   317\t    (when-not (fn? connect!)\n   318\t      (throw (ex-info \"WebSocket host composition requires :connect!\" {:config config})))\n   319\t    (fn attach!\n   320\t      [descriptor]\n   321\t      (if-not (descriptor? descriptor)\n   322\t        (outcome :dao.stream/invalid-descriptor)\n   323\t        (let [id (attachment-id)\n   324\t              [handle state] (new-handle descriptor id target :connecting nil)]\n   325\t          (try\n   326\t            (let [socket (connect! descriptor (adapter handle))]\n   327\t              (if (and (map? socket) (fn? (:send! socket)) (fn? (:close! socket)))\n   328\t                (do (swap! state assoc :socket socket)\n   329\t                    {:dao.stream/outcome :dao.stream/ok\n   330\t                     :dao.stream/handle handle\n   331\t                     :dao.stream/attachment id})\n   332\t                (outcome :dao.stream/transport-error)))\n   333\t            (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   334\t              (outcome :dao.stream/transport-error))))))))\n   335\t\n   336\t\n   337\t;; Server acceptance is intentionally an endpoint composition object, not a\n   338\t;; global transport directory.  Its slots are supplied and owned by the host.\n   339\t(defn make-endpoint\n   340\t  [{:keys [served control control-admission slots] :as config}]\n   341\t  (let [control-target (checked-target control control-admission)]\n   342\t    (when-not (and (map? served) (seq slots))\n   343\t      (throw (ex-info \"WebSocket endpoint needs served paths and handoff slots\" {:config config})))\n   344\t    (when-not (= :portable-values (:value-domain control-admission))\n   345\t      (throw (ex-info \"endpoint control medium must carry portable values\" {:admission control-admission})))\n   346\t    (doseq [[path descriptor] served]\n   347\t      (when-not (and (= path (:ws/path descriptor)) (descriptor? descriptor))\n   348\t        (throw (ex-info \"invalid served descriptor\" {:path path :descriptor descriptor}))))\n   349\t    (doseq [slot slots]\n   350\t      (checked-target (:offer slot) (:offer-admission slot))\n   351\t      (checked-target (:ack slot) (:ack-admission slot))\n   352\t      (when-not (and (= 1 (get-in slot [:offer-admission :capacity]))\n   353\t                     (= :host-values (get-in slot [:offer-admission :value-domain]))\n   354\t                     (= 1 (get-in slot [:ack-admission :capacity]))\n   355\t                     (= :host-values (get-in slot [:ack-admission :value-domain]))\n   356\t                     (some? (:ack-cursor slot)))\n   357\t        (throw (ex-info \"invalid capacity-one WebSocket handoff slot\" {:slot slot}))))\n   358\t    {:config config\n   359\t     :state (atom {:control control-target\n   360\t                   :slots (mapv (fn [slot]\n   361\t                                  (assoc slot :status :free)) slots)\n   362\t                   :connections {}})}))\n   363\t\n   364\t\n   365\t(defn endpoint-state\n   366\t  [endpoint]\n   367\t  @(:state endpoint))\n   368\t\n   369\t\n   370\t(defn- endpoint-target\n   371\t  [endpoint]\n   372\t  (:control (endpoint-state endpoint)))\n   373\t\n   374\t\n   375\t(defn- release-slot!\n   376\t  \"Return one handoff slot to the bounded free pool and forget the connection it\n   377\t   held.  Releasing drops the retained handle: a released slot's acknowledgement\n   378\t   is stale by construction, so nothing may resolve through it afterwards.\"\n   379\t  [endpoint index attachment]\n   380\t  (swap! (:state endpoint)\n   381\t         (fn [s]\n   382\t           (-> s\n   383\t               (update-in [:slots index] dissoc\n   384\t                          :attachment :handle :handle-state :opened-at)\n   385\t               (assoc-in [:slots index :status] :free)\n   386\t               (update :connections dissoc attachment)))))\n   387\t\n   388\t\n   389\t(defn accept-connection!\n   390\t  \"Bounded upgrade callback entry.  A bad path or exhausted slots is closed\n   391\t   immediately; a valid path deposits precisely one host-local offer and waits\n   392\t   for `endpoint-step` to consume a matching acknowledgement.\"\n   393\t  ([endpoint path socket] (accept-connection! endpoint path socket nil))\n   394\t  ([endpoint path socket now]\n   395\t   (let [{:keys [served]} (:config endpoint)\n   396\t         descriptor (get served path)]\n   397\t     (cond\n   398\t       (nil? descriptor)\n   399\t       (do (send-result socket (transit/encode {:ws/frame :ws/disclaim}))\n   400\t           (invoke-close! socket disclaim-close-code \"dao.stream/not-found\")\n   401\t           {:ws/status :ws/disclaimed})\n   402\t\n   403\t       :else\n   404\t       (let [state (:state endpoint)\n   405\t             chosen (volatile! nil)]\n   406\t         ;; Claim before depositing.  The offer append may synchronously invoke\n   407\t         ;; host code, so leaving the slot `:free` until after it returns would\n   408\t         ;; permit a second upgrade callback to overwrite the sole offer.\n   409\t         (swap! state (fn [s]\n   410\t                        (if-let [[index slot] (first (keep-indexed (fn [i x]\n   411\t                                                                     (when (= :free (:status x)) [i x]))\n   412\t                                                                   (:slots s)))]\n   413\t                          (do (vreset! chosen [index slot])\n   414\t                              (assoc-in s [:slots index :status] :reserving))\n   415\t                          s)))\n   416\t         (if-not @chosen\n   417\t           (do (invoke-close! socket 1013 \"dao.stream/acceptance-full\")\n   418\t               {:ws/status :ws/full})\n   419\t           (let [[index slot] @chosen\n   420\t                 id (attachment-id)\n   421\t                 [handle hstate] (new-handle descriptor id (endpoint-target endpoint) :pending socket)\n   422\t                 offer {:ws/attachment id :ws/event :ws/accepted\n   423\t                        :ws/handle {:dao.stream/handle handle\n   424\t                                    :dao.stream/surface #{:writer :closable}}}\n   425\t                 result (stream/append! (:dao.stream/handle (:offer slot)) offer)]\n   426\t             (if (= :dao.stream/ok (:dao.stream/outcome result))\n   427\t               (do (swap! state (fn [s]\n   428\t                                  (-> s\n   429\t                                      (assoc-in [:slots index :status] :pending)\n   430\t                                      (assoc-in [:slots index :attachment] id)\n   431\t                                      (assoc-in [:slots index :handle] handle)\n   432\t                                      (assoc-in [:slots index :handle-state] hstate)\n   433\t                                      (assoc-in [:slots index :opened-at] now)\n   434\t                                      (assoc-in [:connections id] handle))))\n   435\t                   {:ws/status :ws/pending :ws/attachment id :ws/handle handle})\n   436\t               (do (swap! hstate assoc :phase :closed)\n   437\t                   (invoke-close! socket 1011 \"dao.stream/offer-failed\")\n   438\t                   (release-slot! endpoint index id)\n   439\t                   {:ws/status :ws/offer-failed})))))))))\n   440\t\n   441\t\n   442\t(defn- valid-ack?\n   443\t  [ack attachment]\n   444\t  (and (map? ack)\n   445\t       (= attachment (:ws/attachment ack))\n   446\t       (= :ws/accept (:ws/command ack))\n   447\t       (writer-target? (:ws/deposit ack))\n   448\t       (admission? (:ws/admission ack))))\n   449\t\n   450\t\n   451\t(defn- accept-slot!\n   452\t  [endpoint index slot ack]\n   453\t  (let [hstate (:handle-state slot)\n   454\t        socket (:socket @hstate)\n   455\t        target (:ws/deposit ack)]\n   456\t    (swap! hstate assoc :deposit target :phase :open :resolution? true)\n   457\t    (let [sent (send-result socket (transit/encode {:ws/frame :ws/accept}))]\n   458\t      (when-not (= :dao.stream/ok (:dao.stream/outcome sent))\n   459\t        (swap! hstate assoc :phase :closed)\n   460\t        (invoke-close! socket 1011 \"dao.stream/accept-failed\")\n   461\t        (terminal! hstate (:attachment slot) :ws/closed))\n   462\t      ;; Either way the endpoint is done with this connection: the composition\n   463\t      ;; owns an accepted session, and a failed acceptance is already torn down.\n   464\t      (release-slot! endpoint index (:attachment slot)))))\n   465\t\n   466\t\n   467\t(defn endpoint-step\n   468\t  \"Poll each configured acknowledgement slot once, without waiting or\n   469\t   self-scheduling.  Returns the endpoint after retaining its next cursors.\"\n   470\t  [endpoint now]\n   471\t  ;; A pending connection can be lost before any acknowledgement: the peer\n   472\t  ;; closes, the wire protocol fails, or its own handle is closed.  Each of\n   473\t  ;; those paths closes the handle's state and deposits its terminal event;\n   474\t  ;; this is where the endpoint observes that and returns the slot, so bounded\n   475\t  ;; admission is a live bound rather than a monotonically shrinking one.\n   476\t  (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   477\t          :when (and (= :pending (:status slot))\n   478\t                     (= :closed (:phase @(:handle-state slot))))]\n   479\t    (release-slot! endpoint index (:attachment slot)))\n   480\t  (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   481\t          :when (= :pending (:status slot))]\n   482\t    (let [next (stream/next (:dao.stream/handle (:ack slot)) (:ack-cursor slot))]\n   483\t      (when (= :dao.stream/ok (:dao.stream/outcome next))\n   484\t        (swap! (:state endpoint) assoc-in [:slots index :ack-cursor] (:dao.stream/cursor next))\n   485\t        (let [ack (:dao.stream/value next)]\n   486\t          (cond\n   487\t            (not= (:attachment slot) (:ws/attachment ack)) nil\n   488\t            (valid-ack? ack (:attachment slot)) (accept-slot! endpoint index slot ack)\n   489\t            :else (let [hstate (:handle-state slot)]\n   490\t                    (swap! hstate assoc :phase :closed)\n   491\t                    (invoke-close! (:socket @hstate) protocol-close-code \"dao.stream/invalid-ack\")\n   492\t                    (terminal! hstate (:attachment slot) :ws/closed)\n   493\t                    (release-slot! endpoint index (:attachment slot))))))))\n   494\t  ;; Expiry is deliberately clock-domain explicit.  An endpoint composition\n   495\t  ;; may set `:opened-at` when it accepts an offer; this transport does not\n   496\t  ;; invent wall-clock time or a scheduler.\n   497\t  (when-let [expiry (:expiry-ms (:config endpoint))]\n   498\t    (doseq [[index slot] (map-indexed vector (:slots (endpoint-state endpoint)))\n   499\t            :when (and (= :pending (:status slot)) (:opened-at slot)\n   500\t                       (<= (+ (:opened-at slot) expiry) now))]\n   501\t      (let [hstate (:handle-state slot)]\n   502\t        (swap! hstate assoc :phase :closed)\n   503\t        (invoke-close! (:socket @hstate) 1000 \"dao.stream/acceptance-expired\")\n   504\t        (terminal! hstate (:attachment slot) :ws/closed)\n   505\t        (release-slot! endpoint index (:attachment slot)))))\n   506\t  endpoint)\n     1\t(ns dao.stream.serving\n     2\t  \"Host-owned WebSocket serving composition for DaoStream v2.\n     3\t\n     4\t   This namespace deliberately has no listener, scheduler, transport directory,\n     5\t   or application protocol.  It wires an already-composed endpoint, its bounded\n     6\t   handoff media, and a host-owned path table into one explicit driver.  The host\n     7\t   decides when to call `step!`, supplies its clock, and owns the endpoint start\n     8\t   and stop effects.\"\n     9\t  (:require [dao.stream :as stream]\n    10\t            [dao.stream.forward :as forward]\n    11\t            [dao.stream.ws :as ws]))\n    12\t\n    13\t\n    14\t(defn- target-handle\n    15\t  [x]\n    16\t  (if (and (map? x) (contains? x :dao.stream/handle))\n    17\t    (:dao.stream/handle x)\n    18\t    x))\n    19\t\n    20\t\n    21\t(defn- reader?\n    22\t  [x]\n    23\t  (stream/reader? (target-handle x)))\n    24\t\n    25\t\n    26\t(defn- writer-target?\n    27\t  [x]\n    28\t  (and (map? x)\n    29\t       (stream/writer? (:dao.stream/handle x))\n    30\t       (contains? (:dao.stream/surface x) :writer)))\n    31\t\n    32\t\n    33\t(defn- terminal-event?\n    34\t  [event]\n    35\t  (contains? #{:ws/closed :ws/ended} (:ws/event event)))\n    36\t\n    37\t\n    38\t(defn- call-close!\n    39\t  [f handle]\n    40\t  (try\n    41\t    (f handle)\n    42\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n    43\t      {:dao.stream/outcome :dao.stream/transport-error})))\n    44\t\n    45\t\n    46\t(defn- supplied-stream?\n    47\t  [{:keys [descriptor stream]} path]\n    48\t  (and (ws/descriptor? descriptor)\n    49\t       (= path (:ws/path descriptor))\n    50\t       (stream/reader? stream)))\n    51\t\n    52\t\n    53\t(defn- valid-slot?\n    54\t  [slot]\n    55\t  (and (reader? (:offer-reader slot))\n    56\t       (some? (:offer-cursor slot))\n    57\t       (writer-target? (:ack-writer slot))))\n    58\t\n    59\t\n    60\t(defn- traffic-session\n    61\t  \"Validate the composition-created medium.  The factory must have minted the\n    62\t   reader cursor before acknowledgement; accepting first would permit an open\n    63\t   or payload event to outrun the reader position.\"\n    64\t  [offer made]\n    65\t  (let [{:keys [traffic admission reader cursor]} made\n    66\t        socket-handle (get-in offer [:ws/handle :dao.stream/handle])]\n    67\t    (when (and (writer-target? traffic)\n    68\t               (ws/admission? admission)\n    69\t               (reader? reader)\n    70\t               (some? cursor))\n    71\t      {:socket-handle socket-handle\n    72\t       :traffic traffic\n    73\t       :admission admission\n    74\t       :traffic-reader (target-handle reader)\n    75\t       :traffic-cursor cursor})))\n    76\t\n    77\t\n    78\t(defn make-serving\n    79\t  \"Construct an inert serving composition.  It starts only when `start!` is\n    80\t   called, and advances only when the host calls `step!` with an explicit time.\n    81\t\n    82\t   Required config is deliberately concrete composition data:\n    83\t\n    84\t   * `:endpoint` is a `dao.stream.ws/make-endpoint` value.\n    85\t   * `:served` maps canonical `:ws/path` strings to\n    86\t     `{:descriptor <ws descriptor> :stream <reader handle>}`.  It is the\n    87\t     host's resolution table, not a DaoStream registry.\n    88\t   * `:control-reader` and `:control-cursor` observe the endpoint's pre-accept\n    89\t     control medium.\n    90\t   * `:slots` are in the endpoint's handoff order and contain `:offer-reader`,\n    91\t     an already-minted `:offer-cursor`, and an `:ack-writer` target.\n    92\t   * `:make-traffic` receives an accepted offer and returns a newly-created\n    93\t     per-attachment traffic medium, its declaration, reader, and minted cursor.\n    94\t   * `:start-endpoint!`, `:stop-endpoint!`, and `:close-ended!` are host policy\n    95\t     functions.  `:close-ended!` must perform the WebSocket 4000 close; generic\n    96\t     DaoStream `close!` means only detachment.\n    97\t\n    98\t   `:inbound-step`, when supplied, is an explicit application interpreter run\n    99\t   by this driver for non-terminal per-attachment traffic events.  Omitting it\n   100\t   means inbound payload is deliberately not appended to the served stream.\"\n   101\t  [{:keys [endpoint served control-reader control-cursor slots make-traffic\n   102\t           start-endpoint! stop-endpoint!]\n   103\t    :as config}]\n   104\t  (when-not endpoint\n   105\t    (throw (ex-info \"serving composition needs an endpoint\" {:config config})))\n   106\t  (when-not (and (map? served) (seq served)\n   107\t                 (every? (fn [[path entry]] (supplied-stream? entry path)) served))\n   108\t    (throw (ex-info \"serving composition needs canonical paths and reader streams\"\n   109\t                    {:served served})))\n   110\t  ;; `ws/make-endpoint` intentionally receives only descriptors while this\n   111\t  ;; composition additionally owns the source handles.  When given that\n   112\t  ;; concrete endpoint, reject two subtly different host path tables rather\n   113\t  ;; than acknowledging an offer for a stream this driver would forward from\n   114\t  ;; somewhere else.\n   115\t  (when-let [endpoint-served (get-in endpoint [:config :served])]\n   116\t    (let [descriptors (into {} (map (fn [[path entry]] [path (:descriptor entry)])) served)]\n   117\t      (when-not (= endpoint-served descriptors)\n   118\t        (throw (ex-info \"endpoint and serving resolution tables disagree\"\n   119\t                        {:endpoint-served endpoint-served :served descriptors})))))\n   120\t  (when-not (and (reader? control-reader) (some? control-cursor))\n   121\t    (throw (ex-info \"serving composition needs a control reader and cursor\"\n   122\t                    {:control-reader control-reader :control-cursor control-cursor})))\n   123\t  (when-not (and (seq slots) (every? valid-slot? slots))\n   124\t    (throw (ex-info \"serving composition needs valid handoff readers and writers\"\n   125\t                    {:slots slots})))\n   126\t  (when-not (fn? make-traffic)\n   127\t    (throw (ex-info \"serving composition needs a traffic-medium factory\" {})))\n   128\t  (when-not (every? fn? [start-endpoint! stop-endpoint!])\n   129\t    (throw (ex-info \"serving lifecycle policies are required\" {})))\n   130\t  {:config (merge {:endpoint-step ws/endpoint-step\n   131\t                   :forward-options forward/default-options\n   132\t                   :close-ended! ws/close-ended!\n   133\t                   :close-attachment! stream/close!}\n   134\t                  config)\n   135\t   ;; This atom is explicit host composition state, not namespace state.  It is\n   136\t   ;; retained by the returned value and is owned by the host's one driver.\n   137\t   :state (atom {:lifecycle :new\n   138\t                 :endpoint endpoint\n   139\t                 :control-cursor control-cursor\n   140\t                 :offer-cursors (mapv :offer-cursor slots)\n   141\t                 :sessions {}})})\n   142\t\n   143\t\n   144\t(defn state\n   145\t  \"Return the composition's explicit driver state as data.\"\n   146\t  [serving]\n   147\t  @(:state serving))\n   148\t\n   149\t\n   150\t(defn start!\n   151\t  \"Start the host endpoint once.  The host start function is the only place a\n   152\t   listener may be bound; no listener or cadence is installed by this namespace.\"\n   153\t  [serving]\n   154\t  (let [run? (volatile! false)]\n   155\t    (swap! (:state serving)\n   156\t           (fn [s]\n   157\t             (if (= :new (:lifecycle s))\n   158\t               (do (vreset! run? true) (assoc s :lifecycle :starting))\n   159\t               s)))\n   160\t    (if-not @run?\n   161\t      (:start-result (state serving))\n   162\t      (let [result (try\n   163\t                     ((:start-endpoint! (:config serving)) (:endpoint (state serving)))\n   164\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   165\t                       {:dao.stream/outcome :dao.stream/transport-error}))]\n   166\t        (swap! (:state serving) assoc\n   167\t               :lifecycle (if (= :dao.stream/transport-error (:dao.stream/outcome result))\n   168\t                            :failed\n   169\t                            :running)\n   170\t               :start-result result)\n   171\t        result))))\n   172\t\n   173\t\n   174\t(defn- remove-session!\n   175\t  [serving attachment]\n   176\t  (swap! (:state serving) update :sessions dissoc attachment))\n   177\t\n   178\t\n   179\t(defn- close-session!\n   180\t  [serving attachment]\n   181\t  (when-let [session (get-in (state serving) [:sessions attachment])]\n   182\t    (call-close! (:close-attachment! (:config serving)) (:socket-handle session))\n   183\t    (remove-session! serving attachment)))\n   184\t\n   185\t\n   186\t(defn stop!\n   187\t  \"Stop the endpoint through the host-owned lifecycle policy.  Established\n   188\t   attachments are detached, not reported as logical-stream endings; ending a\n   189\t   served stream is instead handled by the forwarder's `:source-ended` branch.\"\n   190\t  [serving]\n   191\t  (let [stop? (volatile! false)]\n   192\t    (swap! (:state serving)\n   193\t           (fn [s]\n   194\t             (if (contains? #{:new :starting :running :failed} (:lifecycle s))\n   195\t               (do (vreset! stop? true) (assoc s :lifecycle :stopping))\n   196\t               s)))\n   197\t    (if-not @stop?\n   198\t      (:stop-result (state serving))\n   199\t      (do\n   200\t        (doseq [attachment (keys (:sessions (state serving)))]\n   201\t          (close-session! serving attachment))\n   202\t        (let [result (try\n   203\t                       ((:stop-endpoint! (:config serving)) (:endpoint (state serving)))\n   204\t                       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   205\t                         {:dao.stream/outcome :dao.stream/transport-error}))]\n   206\t          (swap! (:state serving) assoc :lifecycle :stopped :stop-result result)\n   207\t          result)))))\n   208\t\n   209\t\n   210\t(defn- offer-descriptor\n   211\t  [offer]\n   212\t  (let [handle (get-in offer [:ws/handle :dao.stream/handle])]\n   213\t    (when (stream/descriptor? handle)\n   214\t      (let [result (stream/descriptor handle)]\n   215\t        (when (= :dao.stream/ok (:dao.stream/outcome result))\n   216\t          (:dao.stream/descriptor result))))))\n   217\t\n   218\t\n   219\t(defn- acknowledge-offer!\n   220\t  [serving slot-index offer]\n   221\t  (let [{:keys [served make-traffic close-attachment!]} (:config serving)\n   222\t        attachment (:ws/attachment offer)\n   223\t        socket-handle (get-in offer [:ws/handle :dao.stream/handle])\n   224\t        descriptor (offer-descriptor offer)\n   225\t        entry (get served (:ws/path descriptor))\n   226\t        source (:stream entry)]\n   227\t    (if-not (and (= :ws/accepted (:ws/event offer))\n   228\t                 (string? attachment)\n   229\t                 (stream/writer? socket-handle)\n   230\t                 (stream/closable? socket-handle)\n   231\t                 (= (:dao.stream/identity descriptor)\n   232\t                    (:dao.stream/identity (:descriptor entry))))\n   233\t      (call-close! close-attachment! socket-handle)\n   234\t      (let [source-cursor (when source\n   235\t                            (stream/cursor source\n   236\t                                           (or (:forward-anchor (:config serving))\n   237\t                                               stream/anchor-oldest)))\n   238\t            session (when (= :dao.stream/ok (:dao.stream/outcome source-cursor))\n   239\t                      (traffic-session offer (make-traffic offer)))]\n   240\t        (if-not session\n   241\t          (call-close! close-attachment! socket-handle)\n   242\t          (let [ack {:ws/attachment attachment\n   243\t                     :ws/command :ws/accept\n   244\t                     :ws/deposit (:traffic session)\n   245\t                     :ws/admission (:admission session)}\n   246\t                ack-writer (get-in (:config serving) [:slots slot-index :ack-writer])\n   247\t                appended (stream/append! (:dao.stream/handle ack-writer) ack)]\n   248\t            (if (= :dao.stream/ok (:dao.stream/outcome appended))\n   249\t              (swap! (:state serving) assoc-in\n   250\t                     [:sessions attachment]\n   251\t                     (assoc session\n   252\t                            :path (:ws/path descriptor)\n   253\t                            :identity (:dao.stream/identity descriptor)\n   254\t                            :source source\n   255\t                            :forward-state (forward/initial-state\n   256\t                                             (:dao.stream/cursor source-cursor))))\n   257\t              (call-close! close-attachment! socket-handle))))))))\n   258\t\n   259\t\n   260\t(defn- poll-offers!\n   261\t  [serving]\n   262\t  (doseq [[index slot] (map-indexed vector (:slots (:config serving)))]\n   263\t    (let [cursor (get-in (state serving) [:offer-cursors index])\n   264\t          reader (target-handle (:offer-reader slot))\n   265\t          result (stream/next reader cursor)]\n   266\t      (when (= :dao.stream/ok (:dao.stream/outcome result))\n   267\t        (swap! (:state serving) assoc-in [:offer-cursors index]\n   268\t               (:dao.stream/cursor result))\n   269\t        (acknowledge-offer! serving index (:dao.stream/value result))))))\n   270\t\n   271\t\n   272\t(defn- poll-control!\n   273\t  [serving]\n   274\t  (let [{:keys [control-reader]} (:config serving)\n   275\t        result (stream/next (target-handle control-reader)\n   276\t                            (:control-cursor (state serving)))]\n   277\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   278\t      (swap! (:state serving) assoc :control-cursor (:dao.stream/cursor result))\n   279\t      (let [event (:dao.stream/value result)]\n   280\t        ;; Only pre-accept lifecycle belongs in control.  An established\n   281\t        ;; attachment's lifecycle is observed through its own traffic medium.\n   282\t        (when (terminal-event? event)\n   283\t          (remove-session! serving (:ws/attachment event)))))))\n   284\t\n   285\t\n   286\t(defn- poll-traffic!\n   287\t  [serving attachment session]\n   288\t  (let [result (stream/next (:traffic-reader session) (:traffic-cursor session))]\n   289\t    (case (:dao.stream/outcome result)\n   290\t      :dao.stream/ok\n   291\t      (let [event (:dao.stream/value result)]\n   292\t        (if (terminal-event? event)\n   293\t          (remove-session! serving attachment)\n   294\t          (do\n   295\t            (swap! (:state serving) assoc-in [:sessions attachment :traffic-cursor]\n   296\t                   (:dao.stream/cursor result))\n   297\t            ;; This is an interpreter call made by the driver, never a host\n   298\t            ;; callback.  With no interpreter, requests stay ordinary traffic\n   299\t            ;; data and are intentionally not appended to the served stream.\n   300\t            (when-let [interpret (:inbound-step (:config serving))]\n   301\t              (interpret session event)))))\n   302\t\n   303\t      :dao.stream/blocked nil\n   304\t\n   305\t      ;; A traffic gap or terminal reader failure means this composition can no\n   306\t      ;; longer faithfully associate inbound events with the attachment.\n   307\t      (close-session! serving attachment))))\n   308\t\n   309\t\n   310\t(defn- advance-forwarder!\n   311\t  [serving attachment session]\n   312\t  (let [result (forward/forward-step (:source session)\n   313\t                                     (:socket-handle session)\n   314\t                                     (:forward-state session)\n   315\t                                     (:forward-options (:config serving)))]\n   316\t    (case (:status result)\n   317\t      (:continue :retry)\n   318\t      (swap! (:state serving) assoc-in [:sessions attachment :forward-state] result)\n   319\t\n   320\t      :source-ended\n   321\t      (do\n   322\t        ;; Generic close! is only detachment.  This injected policy is the\n   323\t        ;; transport-specific 4000 ended-stream close required by ws protocol.\n   324\t        (call-close! (:close-ended! (:config serving)) (:socket-handle session))\n   325\t        (remove-session! serving attachment))\n   326\t\n   327\t      (close-session! serving attachment))))\n   328\t\n   329\t\n   330\t(defn step!\n   331\t  \"Advance exactly one host-owned driver tick at `now`.\n   332\t\n   333\t   Ordering is intentional: transport acceptance/expiry first, then offer and\n   334\t   control observation, then each established attachment's traffic interpreter\n   335\t   and forwarder.  This function never waits, schedules itself, or installs a\n   336\t   callback; cadence is entirely the caller's policy.\"\n   337\t  [serving now]\n   338\t  (when (= :running (:lifecycle (state serving)))\n   339\t    (let [endpoint (:endpoint (state serving))\n   340\t          next-endpoint ((:endpoint-step (:config serving)) endpoint now)]\n   341\t      (when next-endpoint\n   342\t        (swap! (:state serving) assoc :endpoint next-endpoint)))\n   343\t    (poll-offers! serving)\n   344\t    (poll-control! serving)\n   345\t    ;; Snapshot keys: traffic/lifecycle handling can remove a session during\n   346\t    ;; this tick without changing which already-admitted sessions are advanced.\n   347\t    (doseq [attachment (keys (:sessions (state serving)))]\n   348\t      (when-let [session (get-in (state serving) [:sessions attachment])]\n   349\t        (poll-traffic! serving attachment session))\n   350\t      (when-let [session (get-in (state serving) [:sessions attachment])]\n   351\t        (advance-forwarder! serving attachment session))))\n   352\t  serving)\n     1\t(ns dao.stream.forward\n     2\t  \"A single, host-agnostic interpreter step for copying one DaoStream to another.\n     3\t\n     4\t  `forward-step` owns no scheduler, callback, registry, or mutable state.  A\n     5\t  caller supplies the source cursor and calls the step again with the returned\n     6\t  state when its driver chooses.\"\n     7\t  (:require [dao.stream :as stream]))\n     8\t\n     9\t\n    10\t(def default-options\n    11\t  \"Defaults for `forward-step`: one value per call and terminal gap policy.\"\n    12\t  {:batch-budget 1\n    13\t   :gap-policy :terminate})\n    14\t\n    15\t\n    16\t(defn initial-state\n    17\t  \"Create the state consumed by `forward-step` from a source cursor.\"\n    18\t  [cursor]\n    19\t  {:cursor cursor})\n    20\t\n    21\t\n    22\t(defn- result-state\n    23\t  [cursor status forwarded outcome]\n    24\t  (cond-> {:cursor cursor\n    25\t           :status status\n    26\t           :forwarded forwarded}\n    27\t    outcome (assoc :outcome outcome)))\n    28\t\n    29\t\n    30\t(defn- malformed-result\n    31\t  \"Turn a defective host implementation answer into the total outcome algebra.\n    32\t  A conforming operation already returns one of the contract outcomes; this\n    33\t  guard keeps the interpreter's branch total if a composition supplies a bad\n    34\t  handle.\"\n    35\t  [operation result]\n    36\t  (if (stream/valid-outcome? operation result)\n    37\t    result\n    38\t    {:dao.stream/outcome :dao.stream/transport-error\n    39\t     :dao.stream/error :dao.stream/invalid-operation-result}))\n    40\t\n    41\t\n    42\t(defn- terminal-status\n    43\t  [side outcome]\n    44\t  ;; Keep dispatch scalar: ClojureDart cannot compile hashed vector constants\n    45\t  ;; in `case` expressions.\n    46\t  (if (= side :source)\n    47\t    (case outcome\n    48\t      :dao.stream/end :source-ended\n    49\t      :dao.stream/gap :source-gap\n    50\t      :dao.stream/cursor-mismatch :source-cursor-mismatch\n    51\t      :dao.stream/invalid-cursor :source-invalid-cursor\n    52\t      :dao.stream/transport-error :source-transport-error\n    53\t      :transport-error)\n    54\t    (case outcome\n    55\t      :dao.stream/closed :destination-closed\n    56\t      :dao.stream/invalid-value :destination-invalid-value\n    57\t      :dao.stream/transport-error :destination-transport-error\n    58\t      :transport-error)))\n    59\t\n    60\t\n    61\t(defn- gap-action\n    62\t  [policy gap-result]\n    63\t  (let [action (if (fn? policy) (policy gap-result) policy)]\n    64\t    (case action\n    65\t      :resume :resume\n    66\t      :terminate :terminate\n    67\t      :terminate)))\n    68\t\n    69\t\n    70\t(defn- positive-budget\n    71\t  [options]\n    72\t  (let [budget (:batch-budget options)]\n    73\t    (if (and (integer? budget) (not (neg? budget)))\n    74\t      budget\n    75\t      0)))\n    76\t\n    77\t\n    78\t(defn forward-step\n    79\t  \"Copy at most `:batch-budget` values from source to destination.\n    80\t\n    81\t  `source` must provide the DaoStream reader surface and `destination` the\n    82\t  writer surface. `state` is normally produced by `initial-state` or an earlier\n    83\t  call and contains `:cursor`. Options are ordinary data:\n    84\t\n    85\t  * `:batch-budget` is a non-negative integer. A zero budget performs no read.\n    86\t  * `:gap-policy` is `:resume` (continue from the gap result's recovery\n    87\t    cursor), `:terminate`, or a function receiving the gap result and returning\n    88\t    one of those keywords. A resume forwards no value, so it is bounded\n    89\t    separately: at most `:batch-budget` resumes happen in one call, after which\n    90\t    the step returns `:continue` at the last recovery cursor. A recovery cursor\n    91\t    equal to the cursor just read is a transport fixed point rather than\n    92\t    progress, and terminates the step as `:source-gap`.\n    93\t\n    94\t  The returned map always has `:cursor`, `:status`, and `:forwarded`.  It also\n    95\t  has `:outcome` whenever the last source/destination operation produced one.\n    96\t  `:continue` and `:retry` are non-terminal statuses. `:retry` is returned for\n    97\t  source `blocked` and destination `full`, and neither advances the cursor.\n    98\t  All other operation outcomes are terminal and are preserved as `:outcome`.\n    99\t  In particular, `end` only stops this interpreter; it never closes either\n   100\t  handle.\"\n   101\t  ([source destination state]\n   102\t   (forward-step source destination state default-options))\n   103\t  ([source destination state options]\n   104\t   (let [state (if (map? state) state {})\n   105\t         options (merge default-options (or options {}))\n   106\t         cursor (:cursor state)\n   107\t         status (:status state)]\n   108\t     ;; Terminal state is data owned by the driver. Re-stepping it is a no-op,\n   109\t     ;; which makes accidental extra driver ticks harmless and idempotent.\n   110\t     (if (and status (not (contains? #{:continue :retry} status)))\n   111\t       state\n   112\t       (loop [cursor cursor\n   113\t              remaining (positive-budget options)\n   114\t              resumes (positive-budget options)\n   115\t              forwarded 0]\n   116\t         (if (zero? remaining)\n   117\t           (result-state cursor :continue forwarded nil)\n   118\t           (let [read-result (malformed-result :next (stream/next source cursor))\n   119\t                 read-outcome (:dao.stream/outcome read-result)]\n   120\t             (case read-outcome\n   121\t               :dao.stream/ok\n   122\t               (let [next-cursor (:dao.stream/cursor read-result)\n   123\t                     write-result (malformed-result\n   124\t                                    :append!\n   125\t                                    (stream/append! destination\n   126\t                                                    (:dao.stream/value read-result)))\n   127\t                     write-outcome (:dao.stream/outcome write-result)]\n   128\t                 (case write-outcome\n   129\t                   :dao.stream/ok\n   130\t                   (recur next-cursor (dec remaining) resumes (inc forwarded))\n   131\t\n   132\t                   :dao.stream/full\n   133\t                   (result-state cursor :retry forwarded write-outcome)\n   134\t\n   135\t                   (result-state cursor\n   136\t                                 (terminal-status :destination write-outcome)\n   137\t                                 forwarded\n   138\t                                 write-outcome)))\n   139\t\n   140\t               :dao.stream/blocked\n   141\t               (result-state cursor :retry forwarded read-outcome)\n   142\t\n   143\t               :dao.stream/gap\n   144\t               (let [recovery (:dao.stream/cursor read-result)]\n   145\t                 (cond\n   146\t                   ;; A recovery cursor that does not move cannot be observed\n   147\t                   ;; from, whatever the policy asks for.  Terminating keeps the\n   148\t                   ;; step total against a defective transport.\n   149\t                   (or (not= :resume (gap-action (:gap-policy options) read-result))\n   150\t                       (= recovery cursor))\n   151\t                   (result-state cursor :source-gap forwarded read-outcome)\n   152\t\n   153\t                   (pos? resumes)\n   154\t                   (recur recovery remaining (dec resumes) forwarded)\n   155\t\n   156\t                   ;; The resume allowance is spent.  Yield the recovered cursor\n   157\t                   ;; so the driver keeps this step's progress and decides when\n   158\t                   ;; to step again.\n   159\t                   :else (result-state recovery :continue forwarded nil)))\n   160\t\n   161\t               ;; end and every source-side failure are terminal. No close is\n   162\t               ;; implied: the composition decides transport-specific teardown.\n   163\t               (result-state cursor\n   164\t                             (terminal-status :source read-outcome)\n   165\t                             forwarded\n   166\t                             read-outcome)))))))))\n     1\t(ns dao.stream.ws.node\n     2\t  \"The Node host adapter for the DaoStream v2 WebSocket transport.\n     3\t\n     4\t   This namespace is the host edge and nothing else.  It requires the `ws` npm\n     5\t   package (see package.json), owns raw host sockets for exactly the distance\n     6\t   between a Node event and a `dao.stream.ws` adapter entry point, and\n     7\t   exposes:\n     8\t\n     9\t   * `connect!` -- the `:connect!` seam of `dao.stream.ws/make-attacher`;\n    10\t   * `listen!` / `stop-listening!` -- bind a `ws` server hosting one composed\n    11\t     endpoint, feeding `accept-connection!` on every conforming upgrade; and\n    12\t   * `canonical-path`, `socket-url`, `wire!`, and `raw-socket` -- the pieces a\n    13\t     host composition or its tests reuse directly.\n    14\t\n    15\t   Everything else stays explicit caller state: deposit media and their\n    16\t   cursors (mint the `:dao.stream/newest` cursor before calling the composed\n    17\t   `attach!`), readers, endpoint state, RPC state, cadence, and retry policy.\n    18\t   This adapter creates no atom, cursor, registry, promise, future, or timer,\n    19\t   and never schedules `endpoint-step` -- the composition driver owns every\n    20\t   tick.\n    21\t\n    22\t   Host matrix declaration (per `dao.stream.ws.md`): Node's `ws` `send`\n    23\t   accepts into an opaque host buffer and exposes no outbound high-water\n    24\t   signal, so transient `:dao.stream/full` is excluded by nature on this host.\n    25\t   A send returns nil, which the transport classifies as ok; while the\n    26\t   attachment is establishing, the transport's own phase gate answers `full`\n    27\t   without touching the socket.\"\n    28\t  (:require [\"ws\" :as ws-package]\n    29\t            [clojure.string :as str]\n    30\t            [dao.stream.ws :as ws]))\n    31\t\n    32\t\n    33\t(def subprotocol-refusal-code 1002)\n    34\t\n    35\t\n    36\t(def binary-message-text\n    37\t  \"Routed through `:message!` in place of a binary frame's bytes.  A NUL byte\n    38\t   is not valid Transit JSON in any position, so the transport performs its\n    39\t   own decode-failure teardown (deposit plus close 4002) without this adapter\n    40\t   inspecting frame content: binary is a wire-level fact of the text codec,\n    41\t   and the only honest signal the callback boundary accepts is a message the\n    42\t   codec must reject.\"\n    43\t  (.fromCharCode js/String 0))\n    44\t\n    45\t\n    46\t(def ^:private unreserved\n    47\t  \"The URI unreserved characters whose percent-escapes decode.\"\n    48\t  (set (concat (map js/String.fromCharCode (concat (range 48 58)\n    49\t                                                   (range 65 91)\n    50\t                                                   (range 97 123)))\n    51\t               [\"-\" \".\" \"_\" \"~\"])))\n    52\t\n    53\t\n    54\t(defn- normalize-percent-escapes\n    55\t  \"Decode percent-escapes of unreserved octets and upper-case the hex digits\n    56\t   of every remaining escape.  Returns nil for a malformed escape sequence.\"\n    57\t  [s]\n    58\t  (let [n (count s)\n    59\t        hex-pair? (fn [pair] (boolean (and pair (re-matches #\"[0-9A-Fa-f]{2}\" pair))))]\n    60\t    (loop [i 0\n    61\t           out []]\n    62\t      (if (>= i n)\n    63\t        (apply str out)\n    64\t        (if-not (= \\% (nth s i))\n    65\t          (recur (inc i) (conj out (nth s i)))\n    66\t          (let [pair (when (<= (+ i 3) n) (subs s (inc i) (+ i 3)))]\n    67\t            (if-not (hex-pair? pair)\n    68\t              nil\n    69\t              (let [decoded (js/String.fromCharCode (js/parseInt pair 16))]\n    70\t                (if (contains? unreserved decoded)\n    71\t                  (recur (+ i 3) (conj out decoded))\n    72\t                  (recur (+ i 3) (conj out \"%\" (str/upper-case pair))))))))))))\n    73\t\n    74\t\n    75\t(defn- remove-dot-segments\n    76\t  \"RFC 3986's remove_dot_segments over already-split segments.  A final `.` or\n    77\t   `..` leaves the trailing slash RFC 3986 keeps — `/a/b/..` is `/a/`, not `/a`\n    78\t   — which matters because a trailing slash is significant in the served-path\n    79\t   lookup this feeds.\"\n    80\t  [segments]\n    81\t  (let [kept (reduce (fn [kept segment]\n    82\t                       (cond\n    83\t                         (= \".\" segment) kept\n    84\t                         (= \"..\" segment) (if (seq kept) (pop kept) kept)\n    85\t                         :else (conj kept segment)))\n    86\t                     []\n    87\t                     segments)]\n    88\t    (if (contains? #{\".\" \"..\"} (last segments))\n    89\t      (conj kept \"\")\n    90\t      kept)))\n    91\t\n    92\t\n    93\t(defn canonical-path\n    94\t  \"The canonical request-target form of `dao.stream.ws.md`: query and fragment\n    95\t   components are ignored, dot segments are removed, percent-encoded\n    96\t   unreserved octets decode, remaining escapes upper-case their hex digits, an\n    97\t   empty path becomes the root, encoded slashes stay encoded, and repeated or\n    98\t   trailing slashes are significant.  Returns nil for anything that cannot\n    99\t   reach that form: not a string, not absolute, or a malformed escape.\"\n   100\t  [target]\n   101\t  (when (string? target)\n   102\t    (let [without-fragment (first (str/split target #\"#\"))\n   103\t          without-query (first (str/split without-fragment #\"\\?\"))\n   104\t          decoded (normalize-percent-escapes without-query)]\n   105\t      (when (some? decoded)\n   106\t        (cond\n   107\t          ;; An empty URI path is presented as the root.\n   108\t          (= \"\" decoded) \"/\"\n   109\t          (str/starts-with? decoded \"/\")\n   110\t          (str \"/\" (str/join \"/\" (remove-dot-segments\n   111\t                                   ;; A trailing empty segment is a\n   112\t                                   ;; significant trailing slash.\n   113\t                                   (str/split (subs decoded 1) #\"/\" -1))))\n   114\t          :else nil)))))\n   115\t\n   116\t\n   117\t(defn socket-url\n   118\t  \"The reachability URL for one WebSocket descriptor.  A descriptor carries\n   119\t   only reachability and identity; where inbound traffic lands is the host\n   120\t   boundary's composition and appears in neither the URL nor this function.\"\n   121\t  [descriptor]\n   122\t  (str \"ws://\" (:ws/host descriptor) \":\" (:ws/port descriptor) (:ws/path descriptor)))\n   123\t\n   124\t\n   125\t(defn wire!\n   126\t  \"Register the adapter callbacks as the sole subscriber of one host socket.\n   127\t\n   128\t   The socket's 'message', 'close', and 'error' events become adapter entries;\n   129\t   the 'open' event is deliberately not subscribed because an HTTP upgrade is\n   130\t   never a resolution -- the first `:ws/accept` or `:ws/disclaim` frame is.\n   131\t   Text arrives as the frame's UTF-8 string; a binary frame is routed as\n   132\t   `binary-message-text`, which the transport's decode must reject.  The host\n   133\t   error object never crosses: the adapter deposits nothing itself, the\n   134\t   transport's diagnostic entry does.\"\n   135\t  [socket adapter]\n   136\t  (.on ^js socket \"message\"\n   137\t       (fn [data is-binary]\n   138\t         ((:message! adapter)\n   139\t          (if is-binary binary-message-text (.toString ^js data \"utf8\")))))\n   140\t  (.on ^js socket \"close\"\n   141\t       (fn [code _reason] ((:closed! adapter) code _reason)))\n   142\t  (.on ^js socket \"error\"\n   143\t       (fn [_error] ((:error! adapter))))\n   144\t  socket)\n   145\t\n   146\t\n   147\t(defn raw-socket\n   148\t  \"The `{:send! :close!}` view of one host socket, which is the only shape\n   149\t   `dao.stream.ws` accepts from a host.  `send!` returns the host library's\n   150\t   answer (nil on Node, classified as ok); `close!` asks the host for a\n   151\t   closing handshake and never waits for its completion.\"\n   152\t  [socket]\n   153\t  {:send! (fn [text] (.send ^js socket text))\n   154\t   :close! (fn [code reason] (.close ^js socket code reason))})\n   155\t\n   156\t\n   157\t(defn connect!\n   158\t  \"The `:connect!` host seam for `dao.stream.ws/make-attacher` on Node.\n   159\t\n   160\t   Starts connection establishment to the descriptor's URL with the v2\n   161\t   subprotocol and synchronously returns the raw socket view; the connection\n   162\t   resolves asynchronously and every socket event reaches the adapter map the\n   163\t   transport built.  The deposit medium and its already-minted cursor are the\n   164\t   caller's composition, not arguments here: attach! deposits nothing before\n   165\t   resolution and no event can outrun a cursor minted first.\"\n   166\t  [descriptor adapter]\n   167\t  (let [socket (new (.-WebSocket ws-package) (socket-url descriptor) ws/subprotocol)]\n   168\t    (wire! socket adapter)\n   169\t    (raw-socket socket)))\n   170\t\n   171\t\n   172\t(defn- offers-subprotocol?\n   173\t  \"True when the upgrade request offers the v2 subprotocol.  `ws` hands\n   174\t   `verifyClient` the raw request, so the offer is read from its header rather\n   175\t   than from the negotiated socket, which does not exist yet.\"\n   176\t  [request]\n   177\t  (let [header (some-> ^js request .-headers (aget \"sec-websocket-protocol\"))]\n   178\t    (boolean (some #(= ws/subprotocol (str/trim %))\n   179\t                   (str/split (str header) #\",\")))))\n   180\t\n   181\t\n   182\t(defn listen!\n   183\t  \"Bind a Node `ws` server hosting one composed endpoint.\n   184\t\n   185\t   `options` are `:host` (default a loopback bind), `:port` (default 0 for an\n   186\t   assigned port), `:clock` (a no-argument host clock reading, default\n   187\t   `js/Date.now`), `:accept!` (`(fn [path socket now] …)`, default this\n   188\t   endpoint's `ws/accept-connection!`, so a serving composition can inject the\n   189\t   same seam it owns), `:on-listening` (called with the bound address map once\n   190\t   the server reports listening) and `:on-error` (the sole observer of the\n   191\t   server's 'error' event; the default no-op only prevents the host process\n   192\t   from dying on an unhandled EventEmitter error).\n   193\t\n   194\t   Every upgrade that offers the v2 subprotocol is presented to `accept!` with\n   195\t   the canonical request-target path and a host clock reading, which is what\n   196\t   makes the endpoint's configured pending-slot expiry effective.  An upgrade\n   197\t   without the subprotocol is refused before the upgrade completes (HTTP 400)\n   198\t   and never reaches the endpoint, its handoff slots, or the disclaimer.\n   199\t\n   200\t   Binding is asynchronous on Node: `:on-listening` reports it, and\n   201\t   `listener-address`/`listener-port` stay nil until then; the R4 lifecycle\n   202\t   medium is the durable home for bind and listener failures.  The listener\n   203\t   never schedules the endpoint and retains no connection state: the driver owns\n   204\t   `endpoint-step` cadence, and the returned listener is plain host data.\"\n   205\t  ([endpoint] (listen! endpoint {}))\n   206\t  ([endpoint {:keys [host port clock accept! on-listening on-error]\n   207\t              :or {host \"127.0.0.1\" port 0}}]\n   208\t   (let [clock (or clock #(js/Date.now))\n   209\t         accept! (or accept!\n   210\t                     (fn [path socket now]\n   211\t                       (ws/accept-connection! endpoint path socket now)))\n   212\t         server (new (.-WebSocketServer ws-package)\n   213\t                     #js {:host host\n   214\t                          :port port\n   215\t                          ;; The v2 subprotocol is wire protocol, so its\n   216\t                          ;; selection belongs to the endpoint's host edge:\n   217\t                          ;; absent means the upgrade is not a v2 stream, and\n   218\t                          ;; the spec refuses the upgrade rather than\n   219\t                          ;; completing it and closing.\n   220\t                          ;; `ws` selects the asynchronous form of this hook by\n   221\t                          ;; `Function.length === 2`, so this must compile to a\n   222\t                          ;; generated function of exactly two declared\n   223\t                          ;; arguments: a variadic or multi-arity one reports\n   224\t                          ;; length 0 and silently selects the synchronous form,\n   225\t                          ;; whose refusal is a hardcoded 401 and whose return\n   226\t                          ;; value here would be ignored.  `verifyClient` is\n   227\t                          ;; deprecated in `ws` 8; the replacement is an\n   228\t                          ;; explicit `upgrade` handler, at the next major.\n   229\t                          :verifyClient (fn [info cb]\n   230\t                                          (if (offers-subprotocol? (.-req ^js info))\n   231\t                                            (cb true)\n   232\t                                            (cb false 400\n   233\t                                                \"dao.stream/subprotocol-required\")))\n   234\t                          :handleProtocols (fn [protocols _request]\n   235\t                                             (when (.has ^js protocols ws/subprotocol)\n   236\t                                               ws/subprotocol))})]\n   237\t     (.on ^js server \"error\" (fn [_error] (when (fn? on-error) (on-error))))\n   238\t     (.on ^js server \"listening\"\n   239\t          (fn [] (when (fn? on-listening) (on-listening (.address ^js server)))))\n   240\t     (.on ^js server \"connection\"\n   241\t          (fn [socket request]\n   242\t            ;; Defence in depth behind `verifyClient`: a socket that reached\n   243\t            ;; this event without the negotiated subprotocol is not a v2 stream.\n   244\t            (if (not= ws/subprotocol (.-protocol ^js socket))\n   245\t              (.close ^js socket subprotocol-refusal-code\n   246\t                      \"dao.stream/subprotocol-required\")\n   247\t              (let [raw (raw-socket socket)\n   248\t                    ;; Lookup is exact on the canonical form; an\n   249\t                    ;; uncanonicalizable target can match no canonical table\n   250\t                    ;; entry, so the raw target reaches the same disclaimer.\n   251\t                    path (or (canonical-path (.-url ^js request))\n   252\t                             (.-url ^js request))\n   253\t                    accepted (accept! path raw (clock))]\n   254\t                ;; Only a pending acceptance owns a handle to wire; a\n   255\t                ;; disclaimer, exhausted pool, or failed offer has already\n   256\t                ;; been answered by the transport itself.\n   257\t                (when-let [handle (:ws/handle accepted)]\n   258\t                  (wire! socket (ws/adapter handle)))))))\n   259\t     {:dao.stream/outcome :dao.stream/ok\n   260\t      :ws.node/server server})))\n   261\t\n   262\t\n   263\t(defn listener-address\n   264\t  \"The Node address map once the server reports listening, else nil.\"\n   265\t  [listener]\n   266\t  (try\n   267\t    (.address ^js (:ws.node/server listener))\n   268\t    (catch :default _ nil)))\n   269\t\n   270\t\n   271\t(defn listener-port\n   272\t  \"The bound port once listening (including the assigned port after a bind to\n   273\t   zero), else nil.\"\n   274\t  [listener]\n   275\t  (some-> (listener-address listener) (.-port)))\n   276\t\n   277\t\n   278\t(defn stop-listening!\n   279\t  \"Close the host server.  This initiates the close and reports no completion\n   280\t   itself: established attachments close through their own handles and owners,\n   281\t   and the Node server waits for them per its own semantics.  `on-closed`, when\n   282\t   given, is the host's close completion — the only honest source of the R4\n   283\t   `:stopped` fact — and is called with no arguments.\"\n   284\t  ([listener] (stop-listening! listener nil))\n   285\t  ([listener on-closed]\n   286\t   (try\n   287\t     (if (fn? on-closed)\n   288\t       (.close ^js (:ws.node/server listener) (fn [] (on-closed)))\n   289\t       (.close ^js (:ws.node/server listener)))\n   290\t     {:dao.stream/outcome :dao.stream/ok}\n   291\t     (catch :default _\n   292\t       {:dao.stream/outcome :dao.stream/transport-error}))))\n     1\t(ns dao.stream.ws.jvm\n     2\t  \"The JVM host edge for the DaoStream v2 WebSocket transport.\n     3\t\n     4\t   The Java HTTP client and http-kit own their callbacks only until those\n     5\t   callbacks invoke the plain adapter entries supplied by `dao.stream.ws`.\n     6\t   This namespace retains no application state and never drives an endpoint.\n     7\t\n     8\t   The JVM WebSocket APIs expose no useful outbound high-water signal.  A send\n     9\t   accepted by the host is therefore `:dao.stream/ok`; transient\n    10\t   `:dao.stream/full` is excluded by nature on this host.\"\n    11\t  (:require [clojure.string :as str]\n    12\t            [dao.stream.ws :as ws]\n    13\t            [org.httpkit.server :as http]\n    14\t            [ring.websocket.protocols :as wsp])\n    15\t  (:import [java.net URI]\n    16\t           [java.net.http HttpClient WebSocket WebSocket$Listener]\n    17\t           [java.nio ByteBuffer]\n    18\t           [java.util.concurrent CompletableFuture]))\n    19\t\n    20\t\n    21\t(def binary-message-text\n    22\t  \"A text value guaranteed to fail Transit JSON decoding.\"\n    23\t  \"\\u0000\")\n    24\t\n    25\t\n    26\t(def ^:private unreserved?\n    27\t  (set (concat (map char (range (int \\0) (inc (int \\9))))\n    28\t               (map char (range (int \\A) (inc (int \\Z))))\n    29\t               (map char (range (int \\a) (inc (int \\z))))\n    30\t               [\\- \\. \\_ \\~])))\n    31\t\n    32\t\n    33\t(defn- normalize-percent-escapes\n    34\t  [s]\n    35\t  (let [n (count s)]\n    36\t    (loop [i 0, out (StringBuilder.)]\n    37\t      (if (>= i n)\n    38\t        (str out)\n    39\t        (if-not (= \\% (.charAt ^String s i))\n    40\t          (recur (inc i) (.append out (.charAt ^String s i)))\n    41\t          (if (> (+ i 3) n)\n    42\t            nil\n    43\t            (let [pair (subs s (inc i) (+ i 3))]\n    44\t              (if-not (re-matches #\"[0-9A-Fa-f]{2}\" pair)\n    45\t                nil\n    46\t                (let [decoded (char (Integer/parseInt pair 16))]\n    47\t                  (recur (+ i 3)\n    48\t                         (.append out\n    49\t                                  (if (contains? unreserved? decoded)\n    50\t                                    (str decoded)\n    51\t                                    (str \"%\" (str/upper-case pair))))))))))))))\n    52\t\n    53\t\n    54\t(defn- remove-dot-segments\n    55\t  [segments]\n    56\t  (let [kept (reduce (fn [xs segment]\n    57\t                       (cond\n    58\t                         (= \".\" segment) xs\n    59\t                         (= \"..\" segment) (if (seq xs) (pop xs) xs)\n    60\t                         :else (conj xs segment)))\n    61\t                     [] segments)]\n    62\t    (if (contains? #{\".\" \"..\"} (last segments))\n    63\t      (conj kept \"\")\n    64\t      kept)))\n    65\t\n    66\t\n    67\t(defn canonical-path\n    68\t  \"Canonicalize an HTTP request target for exact served-path lookup.\"\n    69\t  [target]\n    70\t  (when (string? target)\n    71\t    (let [without-fragment (first (str/split target #\"#\" 2))\n    72\t          without-query (first (str/split without-fragment #\"\\?\" 2))\n    73\t          decoded (normalize-percent-escapes without-query)]\n    74\t      (when (some? decoded)\n    75\t        (cond\n    76\t          (empty? decoded) \"/\"\n    77\t          (str/starts-with? decoded \"/\")\n    78\t          (str \"/\" (str/join \"/\" (remove-dot-segments\n    79\t                                      (str/split (subs decoded 1) #\"/\" -1))))\n    80\t          :else nil)))))\n    81\t\n    82\t\n    83\t(defn socket-url\n    84\t  [descriptor]\n    85\t  (str \"ws://\" (:ws/host descriptor) \":\" (:ws/port descriptor)\n    86\t       (:ws/path descriptor)))\n    87\t\n    88\t\n    89\t(defn- completed\n    90\t  []\n    91\t  (CompletableFuture/completedFuture nil))\n    92\t\n    93\t\n    94\t(defn connect!\n    95\t  \"Start an asynchronous JVM client attachment and return its raw socket seam.\"\n    96\t  [descriptor adapter]\n    97\t  (let [connection (atom {:socket nil :future nil :close-request nil})\n    98\t        text (StringBuilder.)\n    99\t        listener\n   100\t        (reify WebSocket$Listener\n   101\t          (onOpen [_ socket]\n   102\t            (swap! connection assoc :socket socket)\n   103\t            (when-let [[code reason] (:close-request @connection)]\n   104\t              (.sendClose ^WebSocket socket code reason))\n   105\t            (.request ^WebSocket socket 1))\n   106\t\n   107\t          (onText [_ socket data last?]\n   108\t            (.append text ^CharSequence data)\n   109\t            (when last?\n   110\t              (let [message (str text)]\n   111\t                (.setLength text 0)\n   112\t                ((:message! adapter) message)))\n   113\t            (.request ^WebSocket socket 1)\n   114\t            (completed))\n   115\t\n   116\t          (onBinary [_ socket _data last?]\n   117\t            ;; Java may fragment one binary message across callbacks.  The\n   118\t            ;; transport must see one rejected message, not one per fragment.\n   119\t            (when last?\n   120\t              ((:message! adapter) binary-message-text))\n   121\t            (.request ^WebSocket socket 1)\n   122\t            (completed))\n   123\t\n   124\t          (onPing [_ socket data]\n   125\t            (.request ^WebSocket socket 1)\n   126\t            (.sendPong ^WebSocket socket ^ByteBuffer data))\n   127\t\n   128\t          (onPong [_ socket _data]\n   129\t            (.request ^WebSocket soc