24\t\n   325\t;; =============================================================================\n   326\t;; Open Result Map Constructors\n   327\t;; =============================================================================\n   328\t\n   329\t(defn ok-result\n   330\t  \"Convenience constructor for an open :dao.stream/ok outcome map.\"\n   331\t  ([]\n   332\t   {:dao.stream/outcome :dao.stream/ok})\n   333\t  ([extra-map]\n   334\t   (assoc extra-map :dao.stream/outcome :dao.stream/ok)))\n   335\t\n   336\t\n   337\t(defn outcome-result\n   338\t  \"Convenience constructor for an open outcome map.\"\n   339\t  ([outcome]\n   340\t   {:dao.stream/outcome outcome})\n   341\t  ([outcome extra-map]\n   342\t   (assoc extra-map :dao.stream/outcome outcome)))\n   343\t\n   344\t\n   345\t;; =============================================================================\n   346\t;; Transport Entry Functions & Host Dispatch\n   347\t;; =============================================================================\n   348\t;;\n   349\t;; Two transport entry functions: create! and attach!\n   350\t;; These take no handle because none exists yet. These are per-transport functions,\n   351\t;; host-composed, taking whatever composition state the transport needs.\n   352\t;;\n   353\t;; Putting create! or attach! on a protocol is how the retired registry grows back;\n   354\t;; DaoStream v2 ships no dispatch machinery (no multimethod, no registry,\n   355\t;; no load-time side effect).\n   356\t;;\n   357\t;; Dynamic dispatch on :dao.stream/type is performed by the host using an ordinary\n   358\t;; host-owned lookup table:\n   359\t;;\n   360\t;;   {:dao.stream/ringbuffer {:dao.stream/create ringbuffer/create!\n   361\t;;                            :dao.stream/attach ringbuffer/attach!}\n   362\t;;    :dao.stream/ws         {:dao.stream/attach ws/attach!}}\n   363\t;;\n   364\t;; The helper functions below provide transparent, purely functional host dispatch.\n   365\t\n   366\t(defn host-dispatch-create!\n   367\t  \"Host dispatch helper: looks up :dao.stream/create in dispatch-table\n   368\t   for (:dao.stream/type creation-spec).\n   369\t   Returns :dao.stream/invalid-spec if spec is not a valid envelope.\n   370\t   Returns :dao.stream/not-found if transport or :dao.stream/create is absent.\n   371\t   Otherwise invokes the transport's create function.\"\n   372\t  [dispatch-table creation-spec]\n   373\t  (if-not (valid-creation-spec? creation-spec)\n   374\t    {:dao.stream/outcome :dao.stream/invalid-spec}\n   375\t    (if-let [create-fn (get-in dispatch-table [(:dao.stream/type creation-spec) :dao.stream/create])]\n   376\t      (create-fn creation-spec)\n   377\t      {:dao.stream/outcome :dao.stream/not-found})))\n   378\t\n   379\t\n   380\t(defn host-dispatch-attach!\n   381\t  \"Host dispatch helper: looks up :dao.stream/attach in dispatch-table\n   382\t   for (:dao.stream/type descriptor).\n   383\t   Returns :dao.stream/invalid-descriptor if descriptor is not a valid descriptor envelope.\n   384\t   Returns :dao.stream/not-found if transport or :dao.stream/attach is absent.\n   385\t   Otherwise invokes the transport's attach function.\"\n   386\t  [dispatch-table descriptor]\n   387\t  (if-not (valid-descriptor? descriptor)\n   388\t    {:dao.stream/outcome :dao.stream/invalid-descriptor}\n   389\t    (if-let [attach-fn (get-in dispatch-table [(:dao.stream/type descriptor) :dao.stream/attach])]\n   390\t      (attach-fn descriptor)\n   391\t      {:dao.stream/outcome :dao.stream/not-found})))\n     1\t# yin.vm — the divergence register\n     2\t\n     3\tStatus: deliverable of phase V6 of\n     4\t[`yin.vm.implementation-plan.md`](./yin.vm.implementation-plan.md).\n     5\tSubordinate to [`dao.stream.md`](./dao.stream.md) and\n     6\t[`datom.world.md`](./datom.world.md).\n     7\t\n     8\tEvery place `yin.vm` deliberately differs from `yin.vm`, with the reason.\n     9\tSaying which v1 behaviours are deliberately not mirrored *is* the register: a\n    10\tv2 suite that \"covers the same programs\" proves nothing unless the places it\n    11\tcannot cover are named.\n    12\t\n    13\tScope is the ast-walker slice. `semantic`, `register`, `stack`, `space`,\n    14\t`macro` and `wasm` are not ported, so nothing here speaks for them.\n    15\t\n    16\t## The five user-visible changes\n    17\t\n    18\t1. **The evaluator set shrinks and its default changes.** v2 ships one\n    19\t   evaluator, `yin.vm.ast-walker`. v1's REPL defaults to `:semantic`\n    20\t   (`repl.cljc:183`); there is no `:semantic` here to default to.\n    21\t2. **User-defined macros stop evaluating.** `yang.clojure` emits\n    22\t   `:yin/macro-expand` for every macro call site. `ast-walker` has no\n    23\t   `macro-expand` branch — in v1 or in v2 — and `yin.vm.macro` was required\n    24\t   only by `semantic`. So `defmacro` and every macro call throw \"Unknown AST\n    25\t   node type\". The v2 corpus is macro-free by construction.\n    26\t3. **`stream/take!` is removed.** Destructive read is one reader's progress\n    27\t   and every other reader's data loss, and v1's `take!` took a stream ref\n    28\t   rather than a cursor, so a v2 `take!` would need the\n    29\t   reader-position-in-the-medium the contract retired. Programs use `cursor`\n    30\t   and `next!`. `yin.vm.module/stream-module` has five bindings, not six;\n    31\t   `yin.vm.engine` has no `:stream/take` branch and no `handle-take`.\n    32\t   An above-the-stream queue interpreter with explicit consume accounting is\n    33\t   the deferred way back.\n    34\t4. **Park-on-full behaves differently under a ring-buffer composition.** See\n    35\t   *The retention divergence* below.\n    36\t5. **Telemetry is absent.** `yin.vm.telemetry` is a stub: `enabled?` is\n    37\t   false, `emit-snapshot` is identity, `type-tag` is real. A non-nil\n    38\t   `:telemetry` option is **rejected**, not ignored, because a stub that\n    39\t   merely recorded the model would accept a stream and then write nothing to\n    40\t   it forever.\n    41\t\n    42\t## The retention divergence\n    43\t\n    44\t**v1 VM streams are reject-mode with destructive take.**\n    45\t`ringbuffer.cljc:21` sets `:reject`; `engine.cljc:137` passes no policy;\n    46\t`engine.cljc:22,157` parks the continuation on `:full`. Capacity is freed in\n    47\texactly one way — `drain-one-state` advances `:head` — and the writer wake\n    48\tlives inside that drain.\n    49\t\n    50\t**v2 accepts evict-oldest.** This plan deletes destructive take, so a v2\n    51\treject-mode ring buffer, once full, would be full forever: no operation frees\n    52\ta slot, and the contract forbids eviction waiting on a reader. A `:stream/put`\n    53\tparked on `full` would never wake. A silent hang is worse than a reported gap.\n    54\t\n    55\tConsequences:\n    56\t\n    57\t- Under a ring-buffer composition, `append!` never returns `full`, so puts\n    58\t  never park and loss surfaces as a `gap` at the *reader's* cursor instead.\n    59\t- The VM is still total over `full`, and `full` still parks in the polling\n    60\t  wait set (`dao.runtime/write-outcome->task`). What a given composition\n    61\t  observes follows from the transport it chose, not from the VM.\n    62\t- No \"same results as v1\" claim covers a program that relies on backpressure.\n    63\t  Backpressure semantics, if wanted later, come from the deferred queue\n    64\t  interpreter or from flow control above the stream.\n    65\t\n    66\t**v1-only behaviours no v2 test can mirror.** `engine_test.cljc:263,365` assert\n    67\tpark-on-full; `:386` asserts close-wakes-writer; `:419` asserts\n    68\ttake-wakes-reader. All three depend on reject-mode plus destructive take plus\n    69\ttransport-local waiters. They are deliberately not mirrored.\n    70\t\n    71\t## Cursors\n    72\t\n    73\t| v1 | v2 |\n    74\t|---|---|\n    75\t| store cursor entry `{:stream-id id :position n}` | `{:stream-id id :cursor <opaque>}` |\n    76\t| fabricated `{:position 0}` at four sites | minted `:dao.stream/oldest` the moment the VM first holds the handle |\n    77\t| `(inc position)` on wake | the exact successor the transport returned |\n    78\t| `:vm.summary/position` in telemetry | cannot exist |\n    79\t| `seek` | none |\n    80\t\n    81\t**Minting is a stream operation, and this is observable.** Every fabricated v1\n    82\tcursor meant absolute position zero, which equals `:dao.stream/oldest` on a\n    83\tfresh stream but diverges from `:dao.stream/newest` the moment a stream has\n    84\thistory before the cursor exists. Tests pre-fill streams before constructing a\n    85\tVM, so v2 chooses `oldest` deliberately and\n    86\t`yin.vm.ffi-test/history-before-the-cursor-is-not-skipped-test` pins it.\n    87\t\n    88\t**Three mints, not four.** `call-in-cursor-key` (`vm.cljc:542`) is dropped:\n    89\tnothing in `src` read it, and the bridge cursor already covers reading\n    90\t`call-in`. Four v1 tests asserted only its presence. The three mints are the\n   215\tcontinues** with the next retained batch. The alternative — pretending the\n   216\tstream was contiguous — hides a missing program. Terminal read outcomes\n   217\t(`cursor-mismatch`, `invalid-cursor`, `transport-error`) are still errors.\n   218\t\n   219\tCapacity on the ingress stream is a correctness parameter, not a tuning knob:\n   220\tan evicted batch is a program that never ran.\n   221\t\n   222\t## Telemetry, precisely\n   223\t\n   224\t`enabled?` returns false, `emit-snapshot` is identity in both arities\n   225\t(`ffi.cljc:118` and `ast_walker.cljc:795` use different ones), `install`\n   226\trecords the model, and `type-tag` is real — `ffi` evaluates\n   227\t`(mapv type-tag request-args)` as an *argument* to `emit-snapshot`, so it runs\n   228\tbefore the no-op check. The stub's `type-tag` returns `:opaque` for any\n   229\thandle rather than distinguishing surfaces.\n   230\t\n   231\tWhat the real emit path defers: reading `append!` outcomes; ordering all three\n   232\tsurface protocols before the `map?` branch so a writer-only record is not\n   233\twalked field by field; summarising a cursor-ref without descent so an opaque\n   234\tcursor cannot re-emit a position field; the `cursor-map?` recognition problem\n   235\t(`telemetry.cljc:131-133,168-172` — v2 cursors are opaque and the contract\n   236\toffers no predicate); one stream and its capacity; and the telemetry test\n   237\tsuite. None of it changes an evaluation result.\n   238\t\n   239\t## What is unchanged\n   240\t\n   241\tThe CESK machine itself. Control is the AST node, the environment is a\n   242\tpersistent map, the store is a map, the continuation is a linked list of\n   243\tframes, and every transition allocates exactly one VM value through\n   244\t`cesk-return`. The scheduler is still a ready queue plus a wait set, and\n   245\t`resume-from-run-queue` still merges `:store-updates` before restoring.\n   246\t`dao.datom` is reused, not forked: it has no `:require` at all, so a copy\n   247\twould only add drift risk.\n   248\t\n   249\tParity over the macro-free corpus is asserted directly, in one process, by\n   250\t`yin.vm.parity-test`, against values produced by v1 in the same run rather\n   251\tthan against values chosen freshly.\n     1\t(ns yin.vm.parity-test\n     2\t  \"One macro-free corpus, run through the v1 and v2 ast-walkers in the same\n     3\t   process, compared as normalized values.\n     4\t\n     5\t   Co-loading both is deliberate and costs nothing: the end condition governs\n     6\t   namespaces under `yin.vm` and `dao.*.v2`, not test namespaces, and the\n     7\t   repo already co-loads five VMs in `yin.vm.parity-test`.\n     8\t\n     9\t   The corpus is macro-free because neither evaluator has a `macro-expand`\n    10\t   branch. Where v2 diverges on purpose, the case lives in\n    11\t   `yin.vm.ast-walker-test` and in the divergence register, not here.\"\n    12\t  (:require [clojure.test :refer [deftest is testing]]\n    13\t            [dao.stream :as ds]\n    14\t            [dao.stream.ringbuffer]\n    15\t            [yin.vm :as v1]\n    16\t            [yin.vm.ast-walker :as v1-ast-walker]\n    17\t            [yin.vm :as v2]\n    18\t            [yin.vm.test-utils :as tu]))\n    19\t\n    20\t\n    21\t;; =============================================================================\n    22\t;; The corpus\n    23\t;; =============================================================================\n    24\t\n    25\t(defn- binop\n    26\t  [op a b]\n    27\t  {:type :application,\n    28\t   :operator {:type :variable, :name op},\n    29\t   :operands [{:type :literal, :value a} {:type :literal, :value b}]})\n    30\t\n    31\t\n    32\t(defn- lit\n    33\t  [v]\n    34\t  {:type :literal, :value v})\n    35\t\n    36\t\n    37\t(def corpus\n    38\t  \"Programs both evaluators must agree on. Each is [name ast].\"\n    39\t  [[\"literal int\" (lit 42)]\n    40\t   [\"literal string\" (lit \"hello world\")]\n    41\t   [\"literal nil\" (lit nil)]\n    42\t   [\"literal vector\" (lit [1 2 3])]\n    43\t   [\"literal map\" (lit {:x 10, :y 20})]\n    44\t   [\"literal set\" (lit #{1 2})]\n    45\t   [\"addition\" (binop '+ 10 20)]\n    46\t   [\"subtraction\" (binop '- 15 10)]\n    47\t   [\"multiplication\" (binop '* 5 10)]\n    48\t   [\"division\" (binop '/ 20 5)]\n    49\t   [\"equality true\" (binop '= 5 5)]\n    50\t   [\"equality false\" (binop '= 5 6)]\n    51\t   [\"less than\" (binop '< 3 5)]\n    52\t   [\"greater than\" (binop '> 10 5)]\n    53\t   [\"nested application\"\n    54\t    {:type :application,\n    55\t     :operator {:type :variable, :name '+},\n    56\t     :operands [(lit 1) (binop '+ 2 3)]}]\n    57\t   [\"if true branch\"\n    58\t    {:type :if, :test (binop '< 1 2), :consequent (lit 100), :alternate (lit 200)}]\n    59\t   [\"if false branch\"\n    60\t    {:type :if, :test (binop '< 5 2), :consequent (lit 100), :alternate (lit 200)}]\n    61\t   [\"lambda application\"\n    62\t    {:type :application,\n    63\t     :operator {:type :lambda,\n    64\t                :params ['x],\n    65\t                :body {:type :application,\n    66\t                       :operator {:type :variable, :name '+},\n    67\t                       :operands [{:type :variable, :name 'x} (lit 1)]}},\n    68\t     :operands [(lit 10)]}]\n    69\t   [\"closure value\"\n    70\t    {:type :lambda, :params ['x], :body {:type :variable, :name 'x}}]\n    71\t   [\"arity-0 lambda\"\n    72\t    {:type :application,\n    73\t     :operator {:type :lambda, :params [], :body (lit 7)},\n    74\t     :operands []}]\n    75\t   [\"higher order\"\n    76\t    {:type :application,\n    77\t     :operator {:type :lambda,\n    78\t                :params ['f],\n    79\t                :body {:type :application,\n    80\t                       :operator {:type :variable, :name 'f},\n    81\t                       :operands [(lit 5)]}},\n    82\t     :operands [{:type :lambda,\n    83\t                 :params ['n],\n    84\t                 :body {:type :application,\n    85\t                        :operator {:type :variable, :name '*},\n    86\t                        :operands [{:type :variable, :name 'n} (lit 3)]}}]}]\n    87\t   [\"collection primitives\"\n    88\t    {:type :application,\n    89\t     :operator {:type :variable, :name 'first},\n    90\t     :operands [(lit [9 8 7])]}]\n    91\t   [\"conj onto rest\"\n    92\t    {:type :application,\n    93\t     :operator {:type :variable, :name 'conj},\n    94\t     :operands [{:type :application,\n    95\t                 :operator {:type :variable, :name 'rest},\n    96\t                 :operands [(lit [1 2 3])]}\n    97\t                (lit 4)]}]\n    98\t   [\"store put then get\"\n    99\t    {:type :vm/store-put, :key :parity/k, :val 11}]\n   100\t   [\"gensym\" {:type :vm/gensym, :prefix \"p\"}]\n   101\t   [\"stream make\" {:type :stream/make, :buffer 8}]])\n   102\t\n   103\t\n   104\t;; =============================================================================\n   105\t;; Normalization\n   106\t;; =============================================================================\n   107\t\n   108\t(defn normalize\n   109\t  \"Strip what is legitimately VM-internal before comparison.\n   110\t\n   111\t   A closure carries its defining environment, which holds host functions; a\n   112\t   stream reference carries a store key. Both are compared by shape.\"\n   113\t  [value]\n   114\t  (cond (and (map? value) (= :closure (:type value)))\n   115\t        {:type :closure, :params (:params value), :body (:body value)}\n   116\t        (and (map? value) (= :stream-ref (:type value)))\n   117\t        {:type :stream-ref, :id (:id value)}\n   118\t        (fn? value) :host-fn\n   119\t        :else value))\n   120\t\n   121\t\n   122\t;; =============================================================================\n   123\t;; Runners\n   124\t;; =============================================================================\n   125\t\n   126\t(defn- run-v1\n   127\t  [ast]\n   128\t  (let [in-stream (ds/open! {:dao.stream/type :ringbuffer, :capacity nil})\n   129\t        vm (assoc (v1-ast-walker/create-vm)\n   130\t                  :in-stream in-stream\n   131\t                  :in-cursor {:position 0}\n   132\t                  :halted? false)]\n   133\t    (ds/append! in-stream (vec (v1/ast->datoms ast)))\n   134\t    (normalize (v1/value (v1/run vm)))))\n   135\t\n   136\t\n   137\t(defn- run-v2\n   138\t  [ast]\n   139\t  (normalize (tu/compile-and-run ast)))\n   140\t\n   141\t\n   142\t(deftest ast-walker-parity-test\n   143\t  (doseq [[name ast] corpus]\n   144\t    (testing name\n   145\t      (let [expected (run-v1 ast)]\n   146\t        (is (= expected (run-v2 ast)))))))\n   147\t\n   148\t\n   149\t(deftest ffi-round-trip-parity-test\n   150\t  (testing \"A host call returns the same value on both evaluators\"\n   151\t    (let [ast {:type :dao.stream.apply/call, :op :op/echo, :operands [(lit 42)]}\n   152\t          v1-result (v1/value (v1/eval (v1-ast-walker/create-vm\n   153\t                                         {:bridge {:op/echo identity}})\n   154\t                                       ast))\n   155\t          v2-result (v2/value (v2/eval (tu/create-vm {:bridge {:op/echo\n   156\t                                                               identity}})\n   157\t                                       ast))]\n   158\t      (is (= 42 v1-result))\n   159\t      (is (= v1-result v2-result)))))\n   160\t\n   161\t\n   162\t(deftest blocked-read-parity-test\n   163\t  (testing \"Reading an empty stream blocks on both evaluators\"\n   164\t    (let [ast (fn [stream-ref]\n   165\t                {:type :application,\n   166\t                 :operator {:type :lambda,\n   167\t                            :params ['c],\n   168\t                            :body {:type :stream/next,\n   169\t                                   :source {:type :variable, :name 'c}}},\n   170\t                 :operands [{:type :stream/cursor,\n   171\t                             :source (lit stream-ref)}]})\n   172\t          v1-vm (v1/eval (v1-ast-walker/create-vm) {:type :stream/make,\n   173\t                                                    :buffer 4})\n   174\t          v2-vm (v2/eval (tu/create-vm) {:type :stream/make, :buffer 4})]\n   175\t      (is (= :yin/blocked (v1/value (v1/eval v1-vm (ast (v1/value v1-vm))))))\n   176\t      (is (= :yin/blocked (v2/value (v2/eval v2-vm (ast (v2/value v2-vm)))))))))\n   177\t\n   178\t\n   179\t(deftest stream-round-trip-parity-test\n   180\t  (testing \"put then cursor+next yields the same value on both evaluators\"\n   181\t    (let [read-ast (fn [stream-ref]\n   182\t                     {:type :application,\n   183\t                      :operator {:type :lambda,\n   184\t                                 :params ['c],\n   185\t                                 :body {:type :stream/next,\n   186\t                                        :source {:type :variable, :name 'c}}},\n   187\t                      :operands [{:type :stream/cursor,\n   188\t                                  :source (lit stream-ref)}]})\n   189\t          v1-result (let [vm0 (v1/eval (v1-ast-walker/create-vm)\n   190\t                                       {:type :stream/make, :buffer 4})\n   191\t                          sref (v1/value vm0)\n   192\t                          vm1 (v1/eval vm0\n   193\t                                       {:type :stream/put,\n   194\t                                        :target (lit sref),\n   195\t                                        :val (lit 99)})]\n   196\t                      [(v1/value vm1) (v1/value (v1/eval vm1 (read-ast sref)))])\n   197\t          v2-result (let [vm0 (v2/eval (tu/create-vm) {:type :stream/make,\n   198\t                                                       :buffer 4})\n   199\t                          sref (v2/value vm0)\n   200\t                          vm1 (v2/eval vm0\n   201\t                                       {:type :stream/put,\n   202\t                                        :target (lit sref),\n   203\t                                        :val (lit 99)})]\n   204\t                      [(v2/value vm1) (v2/value (v2/eval vm1 (read-ast sref)))])]\n   205\t      (is (= [99 99] v1-result))\n   206\t      (is (= v1-result v2-result)))))\n","exit_code":0,"status":"completed"}}
