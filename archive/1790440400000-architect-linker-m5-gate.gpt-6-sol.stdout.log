              (recur (skip state entry id) (:cursor entry))))\n  1158\t          :dao.stream/blocked [state (assoc entry :cursor cursor) nil]\n  1159\t          [(retire state (:link-id entry) :restored)\n  1160\t           nil\n  1161\t           (refused-entry entry\n  1162\t                          {:status :refused,\n  1163\t                           :reason :link-stream,\n  1164\t                           :outcome o,\n  1165\t                           :link-id (:link-id entry)})])))))\n  1166\t\n  1167\t\n  1168\t(defn- poll-link-entry\n  1169\t  \"One poll of a link wait entry: a `:link-request` retries its retained\n  1170\t   envelope and, appended, polls on as a `:link-response`; an `:install`\n  1171\t   waits for its install. Returns `[state waiting woken]`.\"\n  1172\t  [state entry]\n  1173\t  (case (:reason entry)\n  1174\t    :link-request\n  1175\t    (let [entry' (module/append-link-request (:resources state) entry)]\n  1176\t      (if (= :link-response (:reason entry'))\n  1177\t        (poll-link-response state entry')\n  1178\t        [state entry' nil]))\n  1179\t    :link-response (poll-link-response state entry)\n  1180\t    :install [state entry nil]))\n  1181\t\n  1182\t\n  1183\t(defn- poll-links\n  1184\t  \"Poll every link wait entry once, in wait-set order, and then step the\n  1185\t   install children. Returns the state with the still-waiting link\n  1186\t   entries appended to `others` and the woken ones queued.\"\n  1187\t  [state links others]\n  1188\t  (let [[state waiting woken]\n  1189\t        (reduce (fn [[state waiting woken] entry]\n  1190\t                  (let [[state w k] (poll-link-entry state entry)]\n  1191\t                    [state\n  1192\t                     (cond-> waiting w (conj w))\n  1193\t                     (cond-> woken k (conj k))]))\n  1194\t                [state [] []]\n  1195\t                links)]\n  1196\t    (-> state\n  1197\t        (assoc :wait-set (into (vec others) waiting))\n  1198\t        (update :ready-queue (fnil into []) woken)\n  1199\t        advance-installs)))\n  1200\t\n  1201\t\n  1202\t(defn abandon-link\n  1203\t  \"A composition gives up on link `link-id` (section 7.2, step 7): the\n  1204\t   entry leaves the wait set and is restored with `reason` raised as the\n  1205\t   effect's error; the id is retired, so a response arriving later is\n  1206\t   `:late`. The linker side's `abandon` is the composition's call. An id\n  1207\t   no entry holds leaves the state unchanged.\"\n  1208\t  [state link-id reason]\n  1209\t  (let [held? (fn [e]\n  1210\t                (and (contains? #{:link-request :link-response} (:reason e))\n  1211\t                     (= link-id (:link-id e))))]\n  1212\t    (if-let [entry (first (filter held? (:wait-set state)))]\n  1213\t      (-> state\n  1214\t          (update :wait-set (fn [ws] (filterv (complement held?) ws)))\n  1215\t          (retire link-id :abandoned)\n  1216\t          (update :ready-queue (fnil conj [])\n  1217\t                  (refused-entry entry\n  1218\t                                 {:status :lost,\n  1219\t                                  :reason reason,\n  1220\t                                  :link-id link-id})))\n  1221\t      state)))\n  1222\t\n  1223\t\n  1224\t(defn check-wait-set\n  1225\t  \"Check wait-set entries against their transports.\n  1226\t\n  1227\t   The sweep is `dao.stream.waitset/check` — this engine was that library's\n  1228\t   seed and is now its first consumer. Every entry is resolved to a live\n  1229\t   handle and an opaque cursor out of the store by `waitset-resolver` and\n  1230\t   polled with a synchronous `next` or `append!` — resolution happens per\n324:  (spawn-module\n360:(def link-request-resource\n366:(def link-response-resource\n403:  (let [writer (get resources link-request-resource)\n439:        resources (:resources state)\n440:        response (get resources link-response-resource)]\n454:      (not (and response (get resou