{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/sto/workspace/datomworld-m5/test/yin/repl/require_test.cljc | sed -n '165,252p'; nl -ba /Users/sto/workspace/datomworld-m5/src/cljc/yin/repl.cljc | sed -n '600,735p'\"","aggregated_output":"   165\t                  :yin.module/exports (set exports)\n   166\t                  :yin.module/requires {}\n   167\t                  :yin.module/primitives {'+ plus-profile}\n   168\t                  :yin.module/footprint {:store-keys #{} :effects #{}}}]\n   169\t    {:address (jing/materialize! store manifest)\n   170\t     :h h, :r r}))\n   171\t\n   172\t\n   173\t(defn- shell\n   174\t  \"A shell of `vm-type` whose content source is the in-process `store`\n   175\t   and whose name environment resolves `env`.\"\n   176\t  [vm-type store env]\n   177\t  (repl/create-state {:vm-type vm-type\n   178\t                      :content-store store\n   179\t                      :name-env env}))\n   180\t\n   181\t\n   182\t(defn- require-and-apply\n   183\t  \"One prompt session over `store`: require the module, then apply its\n   184\t   export.  Returns `[answered result]` -- the require's own answer, read\n   185\t   as the round's value rather than its rendered text (the shell renders\n   186\t   a quoted symbol `'mod` on JVM and Node and `(quote mod)` on Dart), and\n   187\t   `{:value v :state s}` for the export's round.\"\n   188\t  [vm-type store address]\n   189\t  (let [state (shell vm-type store {'mod address})\n   190\t        [state' _] (repl/eval-input state \"(require (quote mod))\")\n   191\t        [state'' _] (repl/eval-input state' \"(mod/f)\")]\n   192\t    [(:last-value state')\n   193\t     {:value (:last-value state''), :state state''}]))\n   194\t\n   195\t\n   196\t(defn- answers-42?\n   197\t  [result]\n   198\t  (and (= 42 (:value result))\n   199\t       (= (b0/normalize 42)\n   200\t          (b0/normalize (:value result)))))\n   201\t\n   202\t\n   203\t;; =============================================================================\n   204\t;; The whole path from the prompt (completion criterion 10)\n   205\t;; =============================================================================\n   206\t\n   207\t(deftest a-require-at-the-prompt-links-installs-and-resumes-test\n   208\t  (doseq [vm-type [:ast-walker :semantic :stack :register]]\n   209\t    (testing (name vm-type)\n   210\t      (let [store (mem/create-content-mem)\n   211\t            {:keys [address]} (publish-module store closed-module 'mod\n   212\t                                              closed-exports)\n   213\t            [answered result] (require-and-apply vm-type store address)]\n   214\t        (testing \"the require answers with the module name\"\n   215\t          (is (= 'mod answered)))\n   216\t        (testing \"the export, lowered from the linked image, applies\"\n   217\t          (is (= (b0/normalize (vm/value (vm/eval (tu/create-vm)\n   218\t                                                  closed-value)))\n   219\t                 (b0/normalize (:value result))))\n   220\t          (is (= 42 (:value result))))\n   221\t        (testing \"nothing stayed pending or blocked\"\n   222\t          (is (nil? (:pending-run (:state result))))\n   223\t          (is (not (vm/blocked? (:vm (:state result))))))))))\n   224\t\n   225\t\n   226\t(deftest the-h-and-r-backends-link-one-manifest-b0-equal-test\n   227\t  \"The criterion's own clause: the same manifest linked by `(vm :stack)`\n   228\t   and `(vm :register)` -- by H and by R, through each one's derivation\n   229\t   record -- produces B0-equal results.\"\n   230\t  (let [store (mem/create-content-mem)\n   231\t        {:keys [address h r]} (publish-module store store-module 'mod\n   232\t                                              store-exports)\n   233\t        [stack-answered stack] (require-and-apply :stack store address)\n   234\t        [register-answered register] (require-and-apply :register store\n   235\t                                                        address)]\n   236\t    (testing \"one manifest, two distinct lowered identities\"\n   237\t      (is (not= h r)))\n   238\t    (testing \"both prompt sessions answer the same value\"\n   239\t      (is (= (b0/normalize (:value stack))\n   240\t             (b0/normalize (:value register))))\n   241\t      (is (answers-42? stack))\n   242\t      (is (answers-42? register))\n   243\t      (is (= 'mod stack-answered))\n   244\t      (is (= 'mod register-answered))\n   245\t      (testing \"the store crossed with the export, not into the task's own\"\n   246\t        (is (not (contains? (vm/store (:vm (:state stack))) 'n)))\n   247\t        (is (some? (seq (get-in (:state stack)\n   248\t                                [:vm :module-stores]))))))))\n   249\t\n   250\t\n   251\t;; =============================================================================\n   252\t;; Refusal and pending at the prompt\n   600\t;; =============================================================================\n   601\t\n   602\t(defn- read-forms\n   603\t  [input]\n   604\t  #?(:cljd (edn/read-string (str \"[\" input \"]\"))\n   605\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n   606\t     :clj (clojure.core/read-string (str \"[\" input \"]\"))))\n   607\t\n   608\t\n   609\t(defn- command-form?\n   610\t  [form]\n   611\t  (and (seq? form)\n   612\t       (symbol? (first form))\n   613\t       (contains? command-heads (first form))))\n   614\t\n   615\t\n   616\t(defn- datom?\n   617\t  [value]\n   618\t  (and (vector? value) (= 5 (count value))))\n   619\t\n   620\t\n   621\t(defn- datom-stream?\n   622\t  [value]\n   623\t  (and (vector? value) (seq value) (every? datom? value)))\n   624\t\n   625\t\n   626\t(defn- ast-map?\n   627\t  [value]\n   628\t  (and (map? value) (keyword? (:type value))))\n   629\t\n   630\t\n   631\t(defn- bracket-balance\n   632\t  \"Open minus close brackets, ignoring string literals and `;` comments.\n   633\t   Positive means the input is incomplete.\"\n   634\t  [s]\n   635\t  (loop [chars (seq s)\n   636\t         depth 0\n   637\t         in-str? false]\n   638\t    (if (empty? chars)\n   639\t      depth\n   640\t      (let [ch (first chars)\n   641\t            tail (rest chars)]\n   642\t        (cond in-str? (cond (= ch \\\\) (recur (rest tail) depth true)\n   643\t                            (= ch \\\") (recur tail depth false)\n   644\t                            :else (recur tail depth true))\n   645\t              (= ch \\\") (recur tail depth true)\n   646\t              (= ch \\;) (recur (drop-while #(not= % \\newline) tail) depth false)\n   647\t              (#{\\( \\[ \\{} ch) (recur tail (inc depth) false)\n   648\t              (#{\\) \\] \\}} ch) (recur tail (dec depth) false)\n   649\t              :else (recur tail depth false))))))\n   650\t\n   651\t\n   652\t;; =============================================================================\n   653\t;; Evaluation\n   654\t;; =============================================================================\n   655\t\n   656\t(defn- inject-last-value\n   657\t  [state]\n   658\t  (update state :vm update :store assoc\n   659\t          '*1 (:last-value state)\n   660\t          '*2 (:last-value-2 state)\n   661\t          '*3 (:last-value-3 state)))\n   662\t\n   663\t\n   664\t(defn- record-last-value\n   665\t  [state state-after value]\n   666\t  (assoc state-after\n   667\t         :last-value value\n   668\t         :last-value-2 (:last-value state)\n   669\t         :last-value-3 (:last-value-2 state)))\n   670\t\n   671\t\n   672\t(defn- round-id\n   673\t  \"The identity of the state's current round: the shell's token, minted\n   674\t   once per shell value, with its round count.  A medium the caller\n   675\t   supplies may already hold results from another shell or an earlier\n   676\t   round; none of them carries this