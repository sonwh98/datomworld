{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba /Users/sto/workspace/datomworld-m5/src/cljc/yin/repl.cljc | sed -n '745,1028p;1060,1130p'; rg -n 'deftest|:stack|:register|last-value|abandon|reset|pending|name-env' /Users/sto/workspace/datomworld-m5/test/yin/repl/require_test.cljc\"","aggregated_output":"   745\t    [state' (str output-text (format-error error))]))\n   746\t\n   747\t\n   748\t(defn- ingress-gaps\n   749\t  [state]\n   750\t  (+ (:ingress-gaps (:observer state) 0)\n   751\t     (:ingress-gaps (:row-observer state) 0)))\n   752\t\n   753\t\n   754\t(defn- run-expander-stage\n   755\t  \"Drive the expander over `program-in` and drain its summary.  It expands\n   756\t   each observed batch and appends the tree packet to `program-out`; a\n   757\t   failed expansion forwards nothing, yet its cursor advances (yin.vm.macro.md\n   758\t   decision 12).  Returns the state with the expander's progress and the\n   759\t   drained `{:errors :forwarded}` summary.\"\n   760\t  [state]\n   761\t  (let [{:keys [observer consumer]}\n   762\t        (macro/step {:observer (:observer state), :consumer (:expander state)})\n   763\t        [expander summary] (macro/drain-errors consumer)]\n   764\t    [(assoc state :observer observer :expander expander) summary]))\n   765\t\n   766\t\n   767\t(defn- run-evaluator-stage\n   768\t  \"Drive the evaluator's observer over `program-out`: it loads each\n   769\t   expanded tree packet into the VM, runs it, and answers its value on the\n   770\t   output medium.  The two stages meet only at `program-out`; neither calls\n   771\t   the other.\"\n   772\t  [{:keys [load-program output-stream] :as state}]\n   773\t  (let [{:keys [observer] vm :consumer}\n   774\t        (observer/run-on-stream {:observer (:row-observer state),\n   775\t                                 :consumer (:vm state)}\n   776\t                                engine/ready-for-ingress?\n   777\t                                load-program\n   778\t                                (make-runner output-stream (round-id state)))]\n   779\t    (assoc state :row-observer observer :vm vm)))\n   780\t\n   781\t\n   782\t(defn- format-expansion-errors\n   783\t  [errors]\n   784\t  (str/join \"\\n\" (map #(str \"Error: Macro expansion failed: \" (format-value %))\n   785\t                      errors)))\n   786\t\n   787\t\n   788\t(defn- link-waiting?\n   789\t  \"True while `vm` parks on a link wait: the two link states `require`\n   790\t   parks in, or the install it waits on (yin.vm.linker.md section 7.2).\n   791\t   These are the reasons the shell's interpreter can move, so they are\n   792\t   the ones a round drives before reporting the VM wedged.\"\n   793\t  [vm]\n   794\t  (boolean (some #(contains? #{:link-request :link-response :install}\n   795\t                             (:reason %))\n   796\t                 (:wait-set vm))))\n   797\t\n   798\t\n   799\t(defn- carry-link-counter\n   800\t  \"The round's base VM with `parked`'s link-id counter carried forward.\n   801\t   Link ids are `[origin counter]` pairs minted once and never reused on\n   802\t   a pair (yin.vm.linker.md section 7.2); the shell's rollback to the\n   803\t   round's base -- whose counter never advanced -- must not let the next\n   804\t   require mint an id the pair has already answered.\"\n   805\t  [base parked]\n   806\t  (let [n (max (or (:id-counter base) 0) (or (:id-counter parked) 0))]\n   807\t    (cond-> base\n   808\t      (pos? n) (assoc :id-counter n))))\n   809\t\n   810\t\n   811\t(defn- drive-links\n   812\t  \"Serve the linker interpreter and run the parked VM alternately, at most\n   813\t   `link-round-budget` rounds, while `vm` waits on a link.  A round that\n   814\t   moves nothing ends the drive: a link whose content source cannot\n   815\t   answer will not answer by waiting longer.  Returns\n   816\t   `[state vm pending]`, `pending` the links the interpreter reported\n   817\t   `:pending`, and never throws for a refused or lost link -- the raise\n   818\t   is the VM's own, on its next run.\"\n   819\t  [state vm]\n   820\t  (loop [i 0\n   821\t         vm vm\n   822\t         state state\n   823\t         pending []]\n   824\t    (cond\n   825\t      (or (vm/halted? vm) (not (link-waiting? vm)) (>= i link-round-budget))\n   826\t      [state vm pending]\n   827\t\n   828\t      :else\n   829\t      (let [served (link/serve {:pair (:link-pair state)\n   830\t                                :source (:link-source state)})\n   831\t            state (assoc state :link-pair (:pair served))\n   832\t            pending (if (seq (:pending served)) (:pending served) pending)]\n   833\t        (if (:progress? served)\n   834\t          (recur (inc i) (vm/run vm) state pending)\n   835\t          [state vm pending])))))\n   836\t\n   837\t\n   838\t(defn- tokenize\n   839\t  \"Answer the halted VM's value on the output medium under `state`'s\n   840\t   round, as the evaluator runner does for a program it runs itself.  A\n   841\t   resumed require halts outside the observer loop, so the shell emits\n   842\t   its token here.\"\n   843\t  [state vm]\n   844\t  ((make-runner (:output-stream state) (round-id state)) vm))\n   845\t\n   846\t\n   847\t(defn- pending-text\n   848\t  [pending]\n   849\t  (if (seq pending)\n   850\t    (str \";; require pending: \"\n   851\t         (str/join \", \" (map (fn [p]\n   852\t                               (str (pr-str (:name p))\n   853\t                                    \" (link \" (pr-str (:yin.link/id p)) \")\"))\n   854\t                             pending))\n   855\t         \"); another line re-checks it, (abandon) gives up\\n\")\n   856\t    (str \";; require still pending; another line re-checks it, (abandon)\"\n   857\t         \" gives up\\n\")))\n   858\t\n   859\t\n   860\t(defn- pending-eval\n   861\t  \"Answer a round whose require did not complete: the parked VM, its\n   862\t   round-start base, and the pending links are the shell's\n   863\t   `:pending-run`, and the prompt returns.  Nothing is wedged: another\n   864\t   line re-checks the link, `(abandon)` gives it up, and `(reset)` or\n   865\t   `(vm ...)` drops it with the session.\"\n   866\t  [state state' vm' pending]\n   867\t  (let [[state'' text] (drain-output state')]\n   868\t    [(-> state''\n   869\t         (assoc :vm vm'\n   870\t                :pending-run {:vm vm', :base (:vm state), :links pending}))\n   871\t     (str text (pending-text pending))]))\n   872\t\n   873\t\n   874\t(defn- wedged-program\n   875\t  [state]\n   876\t  (ex-info\n   877\t    \"Program stream did not form a complete, runnable Yin VM program.\n   878\tHint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n   879\t    {:vm-type (:vm-type state)}))\n   880\t\n   881\t\n   882\t(defn- run-evaluation\n   883\t  \"The evaluator half of a round whose expander forwarded a program: run\n   884\t   it, then either finalize the value, drive its require to a conclusion,\n   885\t   or park it as `:pending-run`.  `state` is the round's starting state;\n   886\t   `expanded` already carries the expander's progress, which a failing\n   887\t   evaluation keeps.\"\n   888\t  [state expanded]\n   889\t  (try\n   890\t    (let [gaps-before (ingress-gaps expanded)\n   891\t          evaluated (run-evaluator-stage expanded)\n   892\t          vm (:vm evaluated)]\n   893\t      (cond\n   894\t        (> (ingress-gaps evaluated) gaps-before)\n   895\t        [(assoc evaluated :ingress-loss? true)\n   896\t         (str \"Error: \" ingress-loss-text)]\n   897\t\n   898\t        (vm/halted? vm)\n   899\t        (finalize-eval state evaluated\n   900\t                       (engine/restore-initial-env (:env (:vm expanded)) vm))\n   901\t\n   902\t        (link-waiting? vm)\n   903\t        (let [floor (:id-counter vm)]\n   904\t          (try\n   905\t            (let [[state' vm' pending] (drive-links evaluated vm)]\n   906\t              (cond\n   907\t                (vm/halted? vm')\n   908\t                (finalize-eval state\n   909\t                               (assoc state' :vm vm')\n   910\t                               (tokenize state'\n   911\t                                         (engine/restore-initial-env\n   912\t                                           (:env (:vm expanded)) vm')))\n   913\t\n   914\t                (link-waiting? vm')\n   915\t                (pending-eval state state' vm' pending)\n   916\t\n   917\t                :else (throw (wedged-program state))))\n   918\t            (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n   919\t              ;; the raise rolls the shell back to the round's base; the\n   920\t              ;; parked counter rides with it so no link id is reused\n   921\t              (throw (ex-info (or (ex-message error) \"Link failed\")\n   922\t                              (assoc (or (ex-data error) {})\n   923\t                                     ::link-counter floor))))))\n   924\t\n   925\t        :else (throw (wedged-program state))))\n   926\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n   927\t      (let [base (if-some [floor (::link-counter (ex-data error))]\n   928\t                   (assoc (:vm state) :id-counter floor)\n   929\t                   (:vm state))]\n   930\t        (consume-failed-round (assoc expanded :vm base) error)))))\n   931\t\n   932\t\n   933\t(defn- eval-program\n   934\t  \"Evaluate one frontend program — the map AST the compilers emit or a\n   935\t   datom-literal program — through the §10.1 composition.  The encoder\n   936\t   projects it to an input batch of canonical rows with its harvest and\n   937\t   declaration rows; the shell appends that batch to `program-in`, drives\n   938\t   the expander, drains its summary, and drives the evaluator only when a\n   939\t   program was forwarded.  An expansion failure is reported as data: its\n   940\t   batch is consumed, the store keeps its previous macros, and the next\n   941\t   input evaluates normally.  An encoding failure throws before anything\n   942\t   is appended.\n   943\t\n   944\t   The observers recover across a gap on their own, but the shell reads the\n   945\t   gap counts around the round: an increase on any medium means one or more\n   946\t   batches were never run, so resuming as though execution were complete\n   947\t   would report a result built on programs the VM never saw.  The loss is\n   948\t   reported and the shell refuses further evaluation until `(reset)`.\n   949\t\n   950\t   A completed program's lexical environment does not outlive it: the VM's\n   951\t   environment is restored to the one the round began with, as `vm/eval`\n   952\t   does.  A round that throws is consumed by `consume-failed-round`.\"\n   953\t  [state program]\n   954\t  (if (:ingress-loss? state)\n   955\t    [state (str \"Error: \" ingress-loss-text)]\n   956\t    (let [state' (update (inject-last-value state) :round inc)\n   957\t          batch (encoder/program-batch program)\n   958\t          append (stream/append! (:program-stream state') batch)]\n   959\t      (if-not (= :dao.stream/ok (:dao.stream/outcome append))\n   960\t        [state (str \"Error: program batch not ingested: \"\n   961\t                    (name (:dao.stream/outcome append)))]\n   962\t        (let [expanded (try\n   963\t                         (run-expander-stage state')\n   964\t                         (catch #?(:cljd Object\n   965\t                                   :clj Exception\n   966\t                                   :cljs js/Error) error\n   967\t                           {:failed (consume-failed-round state error)}))]\n   968\t          (if-let [failed (:failed expanded)]\n   969\t            failed\n   970\t            (let [[expanded {:keys [errors forwarded]}] expanded]\n   971\t              (cond\n   972\t                (> (ingress-gaps expanded) (ingress-gaps state'))\n   973\t                [(assoc expanded :ingress-loss? true)\n   974\t                 (str \"Error: \" ingress-loss-text)]\n   975\t\n   976\t                (pos? forwarded) (run-evaluation state expanded)\n   977\t\n   978\t                :else [(assoc expanded :vm (:vm state))\n   979\t                       (format-expansion-errors errors)]))))))))\n   980\t\n   981\t\n   982\t(defn- compile-clojure-forms\n   983\t  [forms]\n   984\t  (if (= 1 (count forms))\n   985\t    (yang.clojure/compile (first forms))\n   986\t    (yang.clojure/compile-program forms)))\n   987\t\n   988\t\n   989\t(defn- compile-source\n   990\t  [lang input]\n   991\t  (case lang\n   992\t    :clojure (compile-clojure-forms (read-forms input))\n   993\t    :python (yang.python/compile input)\n   994\t    :php (yang.php/compile input)\n   995\t    (throw (ex-info \"Unsupported Yin REPL language\" {:lang lang}))))\n   996\t\n   997\t\n   998\t(defn- compile-command-ast\n   999\t  [state arg]\n  1000\t  (case (:lang state)\n  1001\t    :clojure (if (string? arg)\n  1002\t               (compile-source :clojure arg)\n  1003\t               (yang.clojure/compile arg))\n  1004\t    (if (string? arg)\n  1005\t      (compile-source (:lang state) arg)\n  1006\t      (throw (ex-info \"This compile command expects a source string\"\n  1007\t                      {:lang (:lang state) :arg arg})))))\n  1008\t\n  1009\t\n  1010\t(defn- render-compile-output\n  1011\t  \"Render the frontend syntax, the input row batch, and what the session's\n  1012\t   expander would make of it against its current store: the expanded tree\n  1013\t   packet (or the expansion error) and the event rows.  The expansion is a\n  1014\t   preview; its context is discarded, so nothing is committed.\"\n  1015\t  [state ast]\n  1016\t  (let [batch (encoder/program-batch ast)\n  1017\t        {:keys [tree error log]}\n  1018\t        (macro/expand-batch batch (get-in state [:expander :ctx]))]\n  1019\t    (str \"AST:\\n\" (format-value ast)\n  1020\t         \"\\n\\nInput rows:\\n\" (format-value batch)\n  1021\t         (if tree\n  1022\t           (str \"\\n\\nExpanded rows:\\n\" (format-value tree))\n  1023\t           (str \"\\n\\nExpansion error:\\n\" (format-value error)))\n  1024\t         \"\\n\\nEvents:\\n\" (format-value (second log)))))\n  1025\t\n  1026\t\n  1027\t(defn- rebuild-session\n  1028\t  \"Replace the VM, the expander, and their media, attachments, and\n  1060\t                  (vm/run (reduce (fn [vm p]\n  1061\t                                    (engine/abandon-link vm (:yin.link/id p)\n  1062\t                                                         :yin.repl/abandoned))\n  1063\t                                  (:vm parked)\n  1064\t                                  (:links parked)))\n  1065\t                  nil\n  1066\t                  (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n  1067\t                    e))]\n  1068\t      [(assoc state'\n  1069\t              :vm (carry-link-counter (:base parked) (:vm parked))\n  1070\t              :pending-run nil)\n  1071\t       (str text (if error (format-error error) \"\"))])\n  1072\t    [state \"Nothing is pending\"]))\n  1073\t\n  1074\t\n  1075\t(defn handle-command\n  1076\t  \"Answer one shell command.  Unsupported arguments are answered as text, not\n  1077\t   thrown, so a mistyped command cannot end a step.\"\n  1078\t  [state form]\n  1079\t  (let [[command & args] form]\n  1080\t    (case command\n  1081\t      vm (let [vm-type (first args)]\n  1082\t           (if (contains? vm-constructors vm-type)\n  1083\t             [(rebuild-session state vm-type)\n  1084\t              (str \"Switched to \" (get vm-labels vm-type) \" (store cleared)\")]\n  1085\t             [state (str \"Error: Unknown Yin REPL VM type \" (pr-str vm-type)\n  1086\t                         \"; supported: \"\n  1087\t                         (pr-str (vec (keys vm-constructors))))]))\n  1088\t      lang (let [lang (first args)]\n  1089\t             (if (contains? lang-labels lang)\n  1090\t               [(assoc state :lang lang)\n  1091\t                (str \"Switched to \" (get lang-labels lang))]\n  1092\t               [state (str \"Error: Unknown Yin REPL language \" (pr-str lang)\n  1093\t                           \"; supported: \" (pr-str (vec (keys lang-labels))))]))\n  1094\t      compile [state (render-compile-output\n  1095\t                       state\n  1096\t                       (compile-command-ast state (first args)))]\n  1097\t      reset [(rebuild-session state (:vm-type state))\n  1098\t             (str (get vm-labels (:vm-type state)) \" reset\")]\n  1099\t      abandon (abandon-pending state)\n  1100\t      help [state help-text]\n  1101\t      repl-state [state (format-value (repl-state state))]\n  1102\t      quit [(assoc state :running? false) \"Bye\"]\n  1103\t      telemetry [state telemetry-text]\n  1104\t      [state (str \"Error: Unknown Yin REPL command \" (pr-str command))])))\n  1105\t\n  1106\t\n  1107\t(defn- eval-parsed*\n  1108\t  \"The parse dispatch of one line, against a shell with no require to\n  1109\t   re-check.\"\n  1110\t  [state trimmed parsed]\n  1111\t  (try\n  1112\t    (let [forms (:forms parsed)\n  1113\t          form (when (= 1 (count forms)) (first forms))]\n  1114\t      (cond\n  1115\t        (and form (command-form? form)) (handle-command state form)\n  1116\t        (and form (datom-stream? form)) (eval-program state (vec form))\n  1117\t        (and form (ast-map? form)) (eval-program state form)\n  1118\t        forms (if (= :clojure (:lang state))\n  1119\t                (eval-program state (compile-clojure-forms forms))\n  1120\t                (eval-program state (compile-source (:lang state) trimmed)))\n  1121\t        (= :clojure (:lang state)) [state (format-error (:error parsed))]\n  1122\t        :else (eval-program state (compile-source (:lang state) trimmed))))\n  1123\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n  1124\t      (let [[state' output-text] (drain-output state)]\n  1125\t        [state' (str output-text (format-error error))]))))\n  1126\t\n  1127\t\n  1128\t(defn- resume-pending\n  1129\t  \"One bounded re-check of the shell's `:pending-run`: serve the\n  1130\t   interpreter, run the parked VM, and either answer its value -- the\n9:   cannot answer surfaces as the shell's own `:pending` state, and\n10:   `(abandon)` gives it up.\n22:            [clojure.test :refer [deftest is testing]]\n179:                      :name-env env}))\n192:    [(:last-value state')\n193:     {:value (:last-value state''), :state state''}]))\n207:(deftest a-require-at-the-prompt-links-installs-and-resumes-test\n208:  (doseq [vm-type [:ast-walker :semantic :stack :register]]\n221:        (testing \"nothing stayed pending or blocked\"\n222:          (is (nil? (:pending-run (:state result))))\n226:(deftest the-h-and-r-backends-link-one-manifest-b0-equal-test\n227:  \"The criterion's own clause: the same manifest linked by `(vm :stack)`\n228:   and `(vm :register)` -- by H and by R, through each one's derivation\n233:        [stack-answered stack] (require-and-apply :stack store address)\n234:        [register-answered register] (require-and-apply :register store\n252:;; Refusal and pending at the prompt\n255:(deftest a-name-the-environment-lacks-is-refused-test\n259:        state (shell :stack store {'mod address})\n265:      (is (nil? (:pending-run state'))))\n267:      (is (= 'mod (:last-value state'')))\n268:      (is (nil? (:pending-run state''))))\n270:      (is (= 42 (:last-value state'''))))\n275:(deftest a-link-that-stays-pending-does-not-wedge-the-shell-test\n276:  (let [state (repl/create-state {:vm-type :stack})\n277:        [pending text] (repl/eval-input state \"(require (quote mod))\")\n278:        [held text2] (repl/eval-input pending \"(+ 1 2)\")\n279:        [freed text3] (repl/eval-input held \"(abandon)\")]\n281:      (is (str/includes? text \"pending\"))\n282:      (is (str/includes? text \"(abandon)\"))\n283:      (is (some? (:pending-run pending)))\n284:      (is (vm/blocked? (:vm pending))))\n285:    (testing \"repl-state reports the pending link\"\n286:      (is (= ['mod] (mapv :name (:pending (repl/repl-state pending))))))\n288:      (is (str/includes? text2 \"pending\"))\n289:      (is (nil? (:last-value held))))\n290:    (testing \"(abandon) raises the require's error and frees the shell\"\n291:      (is (str/includes? text3 \"abandoned\"))\n292:      (is (nil? (:pending-run freed)))\n","exit_code":0,"status":"completed"}}
