rmat-kw})\n@@ -2167,7 +2175,7 @@\n                              (linked-image\n                                state drive record\n                                (:yin.module/tree manifest)\n-                               manifest nil receiver)]\n+                               manifest nil receiver defer?)]\n                          outcome)\n                        (let [[_ derivation]\n                              (checked-derivation state drive format-kw\n@@ -2178,7 +2186,7 @@\n                                  (linked-image\n                                    state drive record\n                                    (:output derivation)\n-                                   manifest derivation receiver)]\n+                                   manifest derivation receiver defer?)]\n                              outcome)))))))))))))))\n \n \ndiff --git a/test/yin/vm/store_write_audit_test.clj b/test/yin/vm/store_write_audit_test.clj\nindex 88aefd74..78d9a620 100644\n--- a/test/yin/vm/store_write_audit_test.clj\n+++ b/test/yin/vm/store_write_audit_test.clj\n@@ -326,6 +326,10 @@\n    \"src/cljc/yin/repl.cljc\"\n    {[\"inject-last-value\" \"update\"] 1\n     [\"make-expander\" :map] 1}\n+   ;; the content source descriptor: `:store` names a dao.jing byte-store\n+   ;; handle the linker interpreter serves content from, never a VM store\n+   \"src/cljc/yin/repl/link.cljc\"\n+   {[\"composition\" :map] 1}\n    ;; the handoff demo: shipped definitions, checked\n    \"src/cljc/datomworld/demo/continuation_handoff.cljc\"\n    {[\"datoms->semantic-vm\" \"update\"] 1}\n","exit_code":0,"status":"completed"}}
