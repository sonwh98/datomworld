{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"sed -n '95,165p;175,285p;420,455p;555,580p' src/cljc/yin/vm/debruijn/register.cljc | nl -ba -v95\"","aggregated_output":"    95\t(defn- bind-positional\n    96\t  \"Positional parameter binding: missing arguments are nil-filled,\n    97\t   extra arguments dropped.\"\n    98\t  [arity args]\n    99\t  (vec (take arity (concat args (repeat nil)))))\n   100\t\n   101\t\n   102\t;; =============================================================================\n   103\t;; Image loading & VM construction\n   104\t;; =============================================================================\n   105\t\n   106\t(defn load-image\n   107\t  \"Load `segment` (a register image `{:bodies [...], :instructions [...]}`)\n   108\t   into `vm` as its one image: R is computed, the registers are reset to\n   109\t   pc 0 with empty frames and continuation, and the machine is running\n   110\t   unless the segment is empty. A non-empty image must pass the register\n   111\t   validator. A continuation parked under an earlier image cannot be\n   112\t   restored against this one: `register-restore` refuses it by R.\"\n   113\t  [vm segment]\n   114\t  (let [empty-seg? (or (nil? segment)\n   115\t                       (empty? segment)\n   116\t                       (and (map? segment)\n   117\t                            (empty? (:instructions segment))))]\n   118\t    (if empty-seg?\n   119\t      (assoc vm\n   120\t             :segment {:bodies [], :instructions []}\n   121\t             :hash nil\n   122\t             :pc 0\n   123\t             :frames []\n   124\t             :registers []\n   125\t             :continuation []\n   126\t             :halted? true\n   127\t             :blocked? false\n   128\t             :value nil)\n   129\t      (if-let [defect (rcode/register-image-defect segment)]\n   130\t        (throw (ex-info (str \"Invalid register image: \" (:rule defect))\n   131\t                        defect))\n   132\t        (let [body0 (first (:bodies segment))\n   133\t              reg-count (or (:registers body0) 0)]\n   134\t          (assoc vm\n   135\t                 :segment segment\n   136\t                 :hash (rcode/register-hash segment)\n   137\t                 :pc 0\n   138\t                 :frames []\n   139\t                 :registers (vec (repeat reg-count nil))\n   140\t                 :continuation []\n   141\t                 :halted? false\n   142\t                 :blocked? false\n   143\t                 :value nil))))))\n   144\t\n   145\t\n   146\t(defn create-vm\n   147\t  \"Build a fresh `DebruijnRegisterVM` over `segment`.\n   148\t   Options: `:free-env`, `:store`, `:primitives`, `:modules`, `:make-stream`,\n   149\t   `:call-in`/`:call-out`/`:call-capacity`, and `:bridge`.\"\n   150\t  ([segment] (create-vm segment {}))\n   151\t  ([segment opts]\n   152\t   (let [base (vm/empty-state\n   153\t                (assoc (select-keys opts [:modules :make-stream :call-in\n   154\t                                          :call-out :call-capacity])\n   155\t                       :primitives (or (:primitives opts) {})))]\n   156\t     (-> (map->DebruijnRegisterVM\n   157\t           {:segment {:bodies [], :instructions []},\n   158\t            :hash nil,\n   159\t            :pc 0,\n   160\t            :frames [],\n   161\t            :free-env (or (:free-env opts) {}),\n   162\t            :registers [],\n   163\t            :continuation [],\n   164\t            :store (merge (:store base) (:store opts)),\n   165\t            :blocked? false,\n   166\t            :modules (or (:modules opts) {})})\n   167\t         (load-image segment)\n   168\t         (ffi/attach (:bridge opts))))))\n   169\t\n   170\t\n   171\t;; =============================================================================\n   172\t;; Return transitions & restore\n   173\t;; =============================================================================\n   174\t\n   175\t(defn- return-transition\n   176\t  \"Unified return transition: restores caller frame from continuation if\n   177\t   pending, otherwise halts the VM with `val`.\"\n   178\t  [vm val]\n   179\t  (let [continuation (:continuation vm)]\n   180\t    (if (seq continuation)\n   181\t      (let [frame (peek continuation)\n   182\t            seg (:segment frame)\n   183\t            return-pc (:return-pc frame)\n   184\t            body (body-of-pc seg return-pc)\n   185\t            reg-count (:registers body)\n   186\t            dest (:dest frame)\n   187\t            restored-regs (reduce (fn [acc [r v]] (assoc acc r v))\n   188\t                                  (vec (repeat reg-count nil))\n   189\t                                  (:regs frame))\n   190\t            final-regs (if (some? dest)\n   191\t                         (assoc restored-regs dest val)\n   192\t                         restored-regs)]\n   193\t        (assoc vm\n   194\t               :segment seg\n   195\t               :hash (:hash frame)\n   196\t               :pc return-pc\n   197\t               :frames (:frames frame)\n   198\t               :registers final-regs\n   199\t               :continuation (pop continuation)\n   200\t               :value val\n   201\t               :halted? false))\n   202\t      (assoc vm :halted? true, :value val))))\n   203\t\n   204\t\n   205\t(defn- refuse-continuation!\n   206\t  [base entry]\n   207\t  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n   208\t                  {:rule :continuation-format,\n   209\t                   :format (:format entry),\n   210\t                   :hash (:hash entry),\n   211\t                   :expected-format format-tag,\n   212\t                   :expected-hash (:hash base)})))\n   213\t\n   214\t\n   215\t(defn register-restore\n   216\t  \"The register VM's restore function, `base entry val -> state`\n   217\t   (design section 5.2.3). Validates format identity and image hash R,\n   218\t   checks that the payload is defect-free via effects/continuation-defect,\n   219\t   checks that `val` is plain data, handles the FFI two-step, and delivers\n   220\t   `val` via `:write-result` or `:return-result`.\"\n   221\t  [base entry val]\n   222\t  (when-not (and (= format-tag (:format entry))\n   223\t                 (= (:hash base) (:hash entry)))\n   224\t    (refuse-continuation! base entry))\n   225\t  (when-let [defect (effects/continuation-defect entry)]\n   226\t    (throw (ex-info \"Corrupt or tampered continuation payload\"\n   227\t                    defect)))\n   228\t  (when-not (vm/plain-data? val)\n   229\t    (throw (ex-info \"Resume value must be plain data\"\n   230\t                    {:rule :resume-value, :val val})))\n   231\t  (if (:request-sent entry)\n   232\t    (-> base\n   233\t        (update :wait-set (fnil conj [])\n   234\t                (ffi/response-wait-entry entry (:call-id entry)))\n   235\t        (assoc :value :yin/blocked\n   236\t               :blocked? true\n   237\t               :halted? false))\n   238\t    (let [call-id (:call-id entry)\n   239\t          base (if call-id (update base :parked dissoc call-id) base)\n   240\t          val (if call-id (ffi/call-result val call-id) val)\n   241\t          resume-mode (:resume-mode entry)]\n   242\t      (if (= :return-result resume-mode)\n   243\t        (return-transition (assoc base\n   244\t                                  :segment (:segment entry)\n   245\t                                  :pc (:pc entry)\n   246\t                                  :frames (:frames entry)\n   247\t                                  :continuation (:continuation entry)\n   248\t                                  :halted? false)\n   249\t                           val)\n   250\t        (let [segment (:segment entry)\n   251\t              pc (:pc entry)\n   252\t              body (body-of-pc segment pc)\n   253\t              reg-count (:registers body)\n   254\t              dest (:dest entry)\n   255\t              restored-regs\n   256\t              (reduce (fn [acc [r v]] (assoc acc r v))\n   257\t                      (vec (repeat reg-count nil))\n   258\t                      (:regs entry))\n   259\t              final-regs (if (some? dest)\n   260\t                           (assoc restored-regs dest val)\n   261\t                           restored-regs)]\n   262\t          (assoc base\n   263\t                 :segment segment\n   264\t                 :pc pc\n   265\t                 :frames (:frames entry)\n   266\t                 :registers final-regs\n   267\t                 :continuation (:continuation entry)\n   268\t                 :value val\n   269\t                 :halted? false))))))\n   270\t\n   271\t\n   272\t;; =============================================================================\n   273\t;; Effects & FFI dispatch\n   274\t;; =============================================================================\n   275\t\n   276\t(defn- park-entry-fns\n   277\t        (cond\n   278\t          (and (map? f) (= :closure (:type f)))\n   279\t          (let [callee-pc (:body-pc f)\n   280\t                callee-body (body-of-pc segment callee-pc)\n   281\t                callee-arity (:arity f)\n   282\t                callee-reg-count (:registers callee-body)\n   283\t                locals (bind-positional callee-arity args)\n   284\t                body-frames (conj (:frames f) locals)\n   285\t                callee-regs (into locals\n   286\t                                  (repeat (- callee-reg-count callee-arity)\n   287\t                                          nil))\n   288\t                continuation'\n   289\t                (if tail?\n   290\t                  continuation\n   291\t                  (conj continuation\n   292\t                        {:segment segment,\n   293\t                         :hash hash,\n   294\t                         :site-pc pc,\n   295\t                         :return-pc (inc pc),\n   296\t                         :frames frames,\n   297\t                         :regs (mapv (fn [r] [r (nth registers r)]) live),\n   298\t                         :live live,\n   299\t                         :dest rd}))]\n   300\t            (assoc vm\n   301\t                   :pc callee-pc\n   302\t                   :frames body-frames\n   303\t                   :registers callee-regs\n   304\t                   :continuation continuation'))\n   305\t\n   306\t          (fn? f)\n   307\t          (let [result (apply f args)]\n   308\t            (if (module/effect? result)\n   309\t              (run-call-effect vm result inst)\n   310\t              (if tail?\n   311\t                (return-transition vm result)\n   312\t                (assoc vm\n   313\t  (step [this]\n   314\t    (cond (engine/active-continuation? this) (step1 this)\n   315\t          (or (:blocked? this) (seq (:ready-queue this)))\n   316\t          (engine/scheduler-round this register-restore)\n   317\t          :else this))\n   318\t  (run [this] (ffi/maybe-run this run-scheduler))\n   319\t  (eval [_ ast]\n   320\t    (throw\n   321\t      (ex-info\n   322\t        (str \"The de Bruijn register kernel executes raw instruction vectors, \"\n   323\t             \"not AST: lower and adapt it first \"\n   324\t             \"(yin.vm.debruijn-register-compile/adapt), then load and run the \"\n   325\t             \"resulting image\")\n   326\t        {:ast ast})))\n   327\t  (reset [this]\n   328\t    (load-image this (:segment this)))\n   329\t  (halted? [this] (engine/halted-with-empty-queue? this))\n   330\t  (blocked? [this] (engine/vm-blocked? this))\n   331\t  (value [this] (engine/vm-value this))\n   332\t\n   333\t  vm/IVMState\n   334\t  (control [this] {:pc (:pc this)})\n   335\t  (environment [_this]\n   336\t    (throw\n   337\t      (ex-info\n   338\t        (str \"environment is not implemented: the design defers it until a \"\n","exit_code":0,"status":"completed"}}
