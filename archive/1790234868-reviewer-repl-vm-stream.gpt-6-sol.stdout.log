{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/repl/core.cljc'","aggregated_output":"     1\t(ns yin.repl.core\n     2\t  \"The local Yin shell for DaoStream v2: explicit state, synchronous steps.\n     3\t\n     4\t   This namespace owns no socket, atom, promise, callback, clock, or namespace\n     5\t   global.  It holds the one shell value a driver threads: the evaluator beside\n     6\t   its separately-owned program media — `program-in`, which the macro\n     7\t   expander observes, and `program-out`, which the evaluator's own observer\n     8\t   watches (`docs/design/yin.vm.macro.md` §10.1) — the language, the value\n     9\t   history, the v2 output medium with its cursor, and a per-medium ledger\n    10\t   recording the last outcome that medium answered.  Every function takes a\n    11\t   state and returns the next one.\n    12\t\n    13\t   `yin.repl` is untouched and keeps running; this is a second implementation\n    14\t   beside it.\"\n    15\t  (:require #?(:cljd [clojure.edn :as edn]\n    16\t               :cljs [cljs.reader :as reader])\n    17\t            [clojure.string :as str]\n    18\t            [dao.pretty :as pretty]\n    19\t            [dao.stream :as stream]\n    20\t            [dao.stream.ringbuffer :as ring]\n    21\t            [yang.clojure :as yang.clojure]\n    22\t            [yang.php :as yang.php]\n    23\t            [yang.python :as yang.python]\n    24\t            [yin.vm :as vm]\n    25\t            [yin.vm.ast-walker :as ast-walker]\n    26\t            [yin.vm.debruijn-code :as dcode]\n    27\t            [yin.vm.debruijn-linearize :as debruijn-linearize]\n    28\t            [yin.vm.debruijn-register-code :as rcode]\n    29\t            [yin.vm.debruijn-register-compile :as register-compile]\n    30\t            [yin.vm.debruijn.register :as register]\n    31\t            [yin.vm.debruijn.stack :as stack]\n    32\t            [yin.vm.encoder :as encoder]\n    33\t            [yin.vm.engine :as engine]\n    34\t            [yin.vm.linearize :as linearize]\n    35\t            [yin.vm.macro :as macro]\n    36\t            [yin.vm.module :as module]\n    37\t            [yin.vm.semantic :as semantic]\n    38\t            [dao.stream.observer :as observer]))\n    39\t\n    40\t\n    41\t(def output-capacity\n    42\t  \"Declared capacity of the composition-owned output medium, in elements.\"\n    43\t  4096)\n    44\t\n    45\t\n    46\t(def ingress-capacity\n    47\t  \"Declared capacity of the composition-owned program medium, in elements.  The\n    48\t   shell is the only appender and its one step owner serializes evaluation, so\n    49\t   eviction can only follow a producer the composition does not make; a gap is\n    50\t   therefore fatal to the current evaluation rather than a normal operating\n    51\t   condition.\"\n    52\t  4096)\n    53\t\n    54\t\n    55\t(def drain-budget\n    56\t  \"Maximum reads one output drain performs, so the drain is total even against\n    57\t   a transport that could answer `gap` repeatedly.\"\n    58\t  4096)\n    59\t\n    60\t\n    61\t(def vm-constructors\n    62\t  \"The evaluators on `yin.vm`: the ast-walker, the linear semantic VM\n    63\t   (`docs/design/yin.vm.semantic.md`), and the nameless de Bruijn stack\n    64\t   and register kernels, each starting with an empty image.\"\n    65\t  {:ast-walker ast-walker/create-vm\n    66\t   :semantic semantic/create-vm\n    67\t   :stack #(stack/create-vm [] %)\n    68\t   :register #(register/create-vm nil %)})\n    69\t\n    70\t\n    71\t(def vm-labels\n    72\t  {:ast-walker \"ASTWalkerVM\"\n    73\t   :semantic \"SemanticVM\"\n    74\t   :stack \"DebruijnStackVM\"\n    75\t   :register \"DebruijnRegisterVM\"})\n    76\t\n    77\t\n    78\t(defn- packet->named-datoms\n    79\t  \"The named `:yin/*` datoms of one expanded tree packet, the input the de\n    80\t   Bruijn resolver reads.\"\n    81\t  [packet]\n    82\t  (vm/ast->datoms\n    83\t    (vm/semantic-bytecode->ast (macro/packet->row-set packet))))\n    84\t\n    85\t\n    86\t(defn- relocate\n    87\t  \"Shift every `:pc`-kind operand of `inst`, per `opcode-table`, by\n    88\t   `offset`.\"\n    89\t  [opcode-table offset inst]\n    90\t  (reduce (fn [inst [i [_ kind]]]\n    91\t            (if (= :pc kind) (update inst (inc i) + offset) inst))\n    92\t          inst\n    93\t          (map-indexed vector (get opcode-table (nth inst 0)))))\n    94\t\n    95\t\n    96\t(defn- append-stack-image\n    97\t  \"Load `image` after the stack image `vm` already holds and start at its\n    98\t   first instruction.  A closure a previous input stored (a `def`) names a\n    99\t   body pc in the earlier image, so that image is kept, not replaced.\"\n   100\t  [vm image]\n   101\t  (let [held (:segment vm)\n   102\t        offset (count held)\n   103\t        shift #(relocate dcode/opcode-table offset %)]\n   104\t    (assoc (stack/load-image vm (into held (map shift) image))\n   105\t           :pc offset)))\n   106\t\n   107\t\n   108\t(defn- append-register-image\n   109\t  \"The register image counterpart of `append-stack-image`.  The incoming\n   110\t   image is validated alone by `load-image`, which also sizes the register\n   111\t   file for its main body; the image it runs in is the concatenation, whose\n   112\t   later main bodies end in `:halt` as the first does.\"\n   113\t  [vm {:keys [bodies instructions] :as image}]\n   114\t  (let [held (:segment vm)\n   115\t        offset (count (:instructions held))\n   116\t        shift-body #(-> % (update :start + offset) (update :end + offset))\n   117\t        shift #(relocate rcode/opcode-table offset %)\n   118\t        combined {:bodies (into (:bodies held) (map shift-body) bodies)\n   119\t                  :instructions (into (:instructions held)\n   120\t                                      (map shift)\n   121\t                                      instructions)}]\n   122\t    (assoc (register/load-image vm image)\n   123\t           :segment combined\n   124\t           :hash (rcode/register-hash combined)\n   125\t           :pc offset)))\n   126\t\n   127\t\n   128\t(def program-loaders\n   129\t  \"The loader the evaluator observer hands each `program-out` value, per\n   130\t   evaluator.  Every value there is one expanded canonical tree packet\n   131\t   `[root rows]` (yin.vm.macro.md §2.4); each loader takes its row set — the\n   132\t   ast-walker through `vm-load-rows`, the semantic VM through\n   133\t   `linearize/rows-loader` over `semantic/load-vector`, and the de Bruijn\n   134\t   kernels through their lowerings to a stack image (H) or a register\n   135\t   image (R).  No evaluator learns that an expander ran.\"\n   136\t  {:ast-walker (fn [vm packet]\n   137\t                 (ast-walker/vm-load-rows vm (macro/packet->row-set packet)))\n   138\t   :semantic (let [load-rows (linearize/rows-loader semantic/load-vector)]\n   139\t               (fn [vm packet]\n   140\t                 (load-rows vm (macro/packet->row-set packet))))\n   141\t   :stack (fn [vm packet]\n   142\t            (append-stack-image\n   143\t              vm\n   144\t              (:image (debruijn-linearize/adapt\n   145\t                        (packet->named-datoms packet)))))\n   146\t   :register (fn [vm packet]\n   147\t               (append-register-image\n   148\t                 vm\n   149\t                 (:image (register-compile/adapt\n   150\t                           (packet->named-datoms packet)))))})\n   151\t\n   152\t\n   153\t(def lang-labels {:clojure \"Clojure\" :python \"Python\" :php \"PHP\"})\n   154\t\n   155\t\n   156\t(def command-heads\n   157\t  \"Commands this shell answers.  `connect` and `disconnect` belong to the\n   158\t   driver, which owns the RPC client; `telemetry` is answered only to say that\n   159\t   the v2 slice does not have it.\"\n   160\t  #{'vm 'lang 'compile 'reset 'help 'repl-state 'quit 'telemetry})\n   161\t\n   162\t\n   163\t(def help-text\n   164\t  (str \"Commands:\\n\"\n   165\t       \"  (vm :ast-walker | :semantic | :stack | :register)\\n\"\n   166\t       \"  (lang :clojure | :python | :php)\\n\"\n   167\t       \"  (compile expr)\\n\"\n   168\t       \"  (reset)\\n\"\n   169\t       \"  (connect \\\"daostream:ws://host:port\\\")\\n\"\n   170\t       \"  (disconnect)\\n\"\n   171\t       \"  (repl-state)\\n\"\n   172\t       \"  (help)\\n\"\n   173\t       \"  (quit)\\n\"\n   174\t       \"  *1, *2, *3  - last, second-to-last, and third-to-last evaluated\"\n   175\t       \" values\"))\n   176\t\n   177\t\n   178\t(def telemetry-text\n   179\t  (str \"(telemetry) is not wired into this shell: the v2 emit path is built \"\n   180\t       \"(yin.vm.telemetry, opt-in via the :telemetry {:stream ...} \"\n   181\t       \"construction option — yin.vm.telemetry.implementation-plan.md), but \"\n   182\t       \"composing a sink into this shell is not, so the command reports \"\n   183\t       \"rather than evaluates\"))\n   184\t\n   185\t\n   186\t(def ingress-loss-text\n   187\t  (str \"One or more program batches were never observed from the program \"\n   188\t       \"medium; (reset) is required before more evaluation\"))\n   189\t\n   190\t\n   191\t(def result-loss-text\n   192\t  \"the evaluation halted but its result never reached the output medium\")\n   193\t\n   194\t\n   195\t;; =============================================================================\n   196\t;; Rendering\n   197\t;; =============================================================================\n   198\t\n   199\t(defn- quote-symbols\n   200\t  [x]\n   201\t  (cond (symbol? x) (list 'quote x)\n   202\t        (vector? x) (mapv quote-symbols x)\n   203\t        (map? x)\n   204\t        (into {} (map (fn [[k v]] [(quote-symbols k) (quote-symbols v)]) x))\n   205\t        (or (list? x) (seq? x))\n   206\t        (if (= 'quote (first x)) x (map quote-symbols x))\n   207\t        :else x))\n   208\t\n   209\t\n   210\t(defn format-value\n   211\t  [value]\n   212\t  (str/trimr (pretty/pp-str (quote-symbols value))))\n   213\t\n   214\t\n   215\t(defn format-error\n   216\t  [error]\n   217\t  (str \"Error: \"\n   218\t       #?(:cljd (or (ex-message error) (str error))\n   219\t          :cljs (or (ex-message error) (.-message error) (str error))\n   220\t          :clj (or (ex-message error) (str error)))))\n   221\t\n   222\t\n   223\t(defn- print-arg\n   224\t  [value]\n   225\t  (if (string? value) value (format-value value)))\n   226\t\n   227\t\n   228\t(defn- print-text\n   229\t  [args]\n   230\t  (str/join \" \" (map print-arg args)))\n   231\t\n   232\t\n   233\t(defn- prn-text\n   234\t  [args]\n   235\t  (str (str/join \" \" (map format-value args)) \"\\n\"))\n   236\t\n   237\t\n   238\t;; =============================================================================\n   239\t;; The output medium\n   240\t;; =============================================================================\n   241\t\n   242\t(defn- emit-output!\n   243\t  [output-stream op text]\n   244\t  ;; A primitive holds no state, so it cannot record an append outcome.  The\n   245\t  ;; medium is an evict-oldest ring buffer, which never answers `full`; a closed\n   246\t  ;; medium drops the chunk and the drain reports the closure.\n   247\t  (when output-stream\n   248\t    (stream/append! output-stream {:type :repl/output :op op :text text}))\n   249\t  nil)\n   250\t\n   251\t\n   252\t(defn- emit-result!\n   253\t  \"Answer a halted evaluation's value on the output medium, after the\n   254\t   output it printed, so the shell reads results from the stream exactly as\n   255\t   it reads prints.\"\n   256\t  [output-stream value]\n   257\t  (when output-stream\n   258\t    (stream/append! output-stream {:type :repl/result :value value}))\n   259\t  nil)\n   260\t\n   261\t\n   262\t(defn- make-repl-primitives\n   263\t  [output-stream]\n   264\t  (merge vm/primitives\n   265\t         {'print (fn [& args]\n   266\t                   (emit-output! output-stream :print (print-text args)))\n   267\t          'println (fn [& args]\n   268\t                     (emit-output! output-stream :println\n   269\t                                   (str (print-text args) \"\\n\")))\n   270\t          'prn (fn [& args] (emit-output! output-stream :prn (prn-text args)))\n   271\t          'ast->datoms vm/ast->datoms\n   272\t          'datoms->ast vm/datoms->ast}))\n   273\t\n   274\t\n   275\t(defn- chunk-text\n   276\t  [value]\n   277\t  (if (map? value) (str (:text value)) (str value)))\n   278\t\n   279\t\n   280\t(defn- result-chunk?\n   281\t  [value]\n   282\t  (and (map? value) (= :repl/result (:type value))))\n   283\t\n   284\t\n   285\t(defn- ledger\n   286\t  [state medium outcome]\n   287\t  (assoc-in state [:ledger medium] outcome))\n   288\t\n   289\t\n   290\t(defn drain-output\n   291\t  \"Drain the output medium into `[state text results]`, total over every\n   292\t   `next` outcome.  `results` holds, in order, the value of every\n   293\t   `:repl/result` element read; every other element is printed text.\n   294\t\n   295\t   `ok` advances to the exact successor the handle returned.  `gap` prints a\n   296\t   loss notice and resumes at the recovery cursor.  `end`, `cursor-mismatch`,\n   297\t   `invalid-cursor`, and `transport-error` print a notice, leave the cursor\n   298\t   unchanged, and end the drain.  Whatever ended the drain is recorded in the\n   299\t   ledger, so `repl-state` never has to ask a stream how it is.\"\n   300\t  [state]\n   301\t  (let [output (:output-stream state)\n   302\t        cursor (:output-cursor state)]\n   303\t    (cond\n   304\t      (nil? output) [(ledger state :output :untried) \"\" []]\n   305\t      (nil? cursor) [(ledger state :output :dao.stream/invalid-cursor)\n   306\t                     \";; output unreadable: no cursor was minted\\n\"\n   307\t                     []]\n   308\t      :else\n   309\t      (loop [remaining drain-budget\n   310\t             cursor cursor\n   311\t             chunks []\n   312\t             results []]\n   313\t        (if (zero? remaining)\n   314\t          [(-> state\n   315\t               (assoc :output-cursor cursor)\n   316\t               (ledger :output :dao.stream/blocked))\n   317\t           (apply str chunks)\n   318\t           results]\n   319\t          (let [result (stream/next output cursor)\n   320\t                outcome (:dao.stream/outcome result)\n   321\t                value (:dao.stream/value result)]\n   322\t            (case outcome\n   323\t              :dao.stream/ok\n   324\t              (if (result-chunk? value)\n   325\t                (recur (dec remaining)\n   326\t                       (:dao.stream/cursor result)\n   327\t                       chunks\n   328\t                       (conj results (:value value)))\n   329\t                (recur (dec remaining)\n   330\t                       (:dao.stream/cursor result)\n   331\t                       (conj chunks (chunk-text value))\n   332\t                       results))\n   333\t\n   334\t              :dao.stream/gap\n   335\t              (recur (dec remaining)\n   336\t                     (:dao.stream/cursor result)\n   337\t                     (conj chunks\n   338\t                           (str \";; output lost: resumed at the recovery\"\n   339\t                                \" cursor\\n\"))\n   340\t                     results)\n   341\t\n   342\t              :dao.stream/blocked\n   343\t              [(-> state\n   344\t                   (assoc :output-cursor cursor)\n   345\t                   (ledger :output outcome))\n   346\t               (apply str chunks)\n   347\t               results]\n   348\t\n   349\t              [(-> state\n   350\t                   (assoc :output-cursor cursor)\n   351\t                   (ledger :output outcome))\n   352\t               (apply str (conj chunks (str \";; output \" (name outcome) \"\\n\")))\n   353\t               results])))))))\n   354\t\n   355\t\n   356\t(defn- make-output-medium!\n   357\t  []\n   358\t  (:dao.stream/handle\n   359\t    (ring/create! {:dao.stream/type ring/transport-type\n   360\t                   ring/capacity-key output-capacity})))\n   361\t\n   362\t\n   363\t(defn- mint-cursor\n   364\t  [handle]\n   365\t  (let [result (stream/cursor handle :dao.stream/oldest)]\n   366\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   367\t      (:dao.stream/cursor result))))\n   368\t\n   369\t\n   370\t;; =============================================================================\n   371\t;; The VM and its program medium\n   372\t;; =============================================================================\n   373\t\n   374\t(defn- make-ring-stream\n   375\t  \"The `:make-stream` the shell hands the VM: one v2 ring buffer per call.  A\n   376\t   nil capacity is the VM's default, not an unbounded stream; v2 has no\n   377\t   unbounded mode.\"\n   378\t  [capacity]\n   379\t  (ring/create! {:dao.stream/type ring/transport-type\n   380\t                 ring/capacity-key (or capacity vm/default-stream-capacity)}))\n   381\t\n   382\t\n   383\t(defn make-vm\n   384\t  \"Construct the shell's evaluator on `yin.vm`.\n   385\t\n   386\t   The shell is the composition that chooses the VM's transport: the\n   387\t   ast-walker is handed `:make-stream` bound to the v2 ring buffer and the v2\n   388\t   `stream` module registered in its registry.  No telemetry stream is\n   389\t   installed, and the VM owns no program medium: `make-session` builds the\n   390\t   medium, its attachment, the observer, and the VM together.\n   391\t\n   392\t   `extra-primitives` is the host-supplied map merged over the REPL's own\n   393\t   primitives, so an embedding host's functions win a name collision.\"\n   394\t  ([vm-type output-stream] (make-vm vm-type output-stream nil))\n   395\t  ([vm-type output-stream extra-primitives]\n   396\t   (when-not (contains? vm-constructors vm-type)\n   397\t     (throw (ex-info \"Unknown Yin REPL VM type\"\n   398\t                     {:vm-type vm-type\n   399\t                      :supported (vec (keys vm-constructors))})))\n   400\t   ((get vm-constructors vm-type)\n   401\t    {:primitives (merge (make-repl-primitives output-stream) extra-primitives)\n   402\t     :modules (module/register-stream-module (module/default-registry))\n   403\t     :make-stream make-ring-stream})))\n   404\t\n   405\t\n   406\t(defn- make-runner\n   407\t  \"The run step the evaluator observer hands each loaded program: run the\n   408\t   VM through its protocol entry point, as a plain function so it can be\n   409\t   handed to observer coordination on every host, and answer a halted\n   410\t   run's value on `output-stream`.  The shell reads the value from that\n   411\t   stream, never from the VM record.\"\n   412\t  [output-stream]\n   413\t  (fn [vm]\n   414\t    (let [vm' (vm/run vm)]\n   415\t      (when (vm/halted? vm')\n   416\t        (emit-result! output-stream (vm/value vm')))\n   417\t      vm')))\n   418\t\n   419\t\n   420\t(defn- make-attachment\n   421\t  \"Create one composition-owned medium of `capacity` elements, the unary\n   422\t   attachment entry bound to it for this medium's lifetime, and an observer\n   423\t   attached through that entry.\n   424\t\n   425\t   The resolver maps the descriptor's identity to the owner handle this\n   426\t   composition created, which is host composition around the ring buffer's own\n   427\t   attach mechanism: the observer itself sees only a descriptor and a unary\n   428\t   capability, so no transport detail crosses into it.\"\n   429\t  [capacity]\n   430\t  (let [writer (:dao.stream/handle\n   431\t                 (ring/create! {:dao.stream/type ring/transport-type\n   432\t                                ring/capacity-key capacity}))\n   433\t        described (stream/descriptor writer)\n   434\t        descriptor (:dao.stream/descriptor described)\n   435\t        identity (:dao.stream/identity described)\n   436\t        attach! (ring/make-attacher {(:dao.stream/identity descriptor) writer})]\n   437\t    {:stream writer\n   438\t     :identity identity\n   439\t     :observer (observer/attach attach! descriptor)}))\n   440\t\n   441\t\n   442\t(defn- standard-store\n   443\t  \"The expander store seeded with the standard forms, folded through the\n   444\t   same row-native batch contract as any input (yin.vm.macro.md §5.4).\"\n   445\t  []\n   446\t  (macro/seed-store (macro/make-ctx {:token :yin.repl/standard-forms\n   447\t                                     :source-medium :yin.repl/standard-forms})\n   448\t                    [macro/stdlib-forms]))\n   449\t\n   450\t\n   451\t(defn- make-expander\n   452\t  \"The expander consumer for one session: a fresh incarnation token, the\n   453\t   `program-in` identity as its source medium, the standard store, and the\n   454\t   `program-out` writer.  No log writer: `(compile ...)` renders events.\"\n   455\t  [program-identity program-out]\n   456\t  (macro/make-expander\n   457\t    (macro/make-ctx {:token (str (random-uuid))\n   458\t                     :source-medium program-identity\n   459\t                     :store (standard-store)})\n   460\t    program-out))\n   461\t\n   462\t\n   463\t(defn- make-session\n   464\t  \"Build the evaluator, its media, their attachments and observers, the\n   465\t   expander, and the loader the evaluator observer feeds the VM, together.\n   466\t   Reset and VM selection call this, so the whole composition is rebuilt as\n   467\t   one and each attachment capability is bound exactly once per medium\n   468\t   lifetime.\n   469\t\n   470\t   Both evaluators sit behind the same two stages (yin.vm.macro.md §10.1):\n   471\t   the expander observes `program-in` — `:program-stream`, watched by\n   472\t   `:observer` — and appends each expanded tree packet to `program-out` —\n   473\t   `:row-stream`, watched independently by the evaluator's `:row-observer`,\n   474\t   which loads each packet and runs it.\"\n   475\t  [vm-type output-stream extra-primitives]\n   476\t  (let [vm (make-vm vm-type output-stream extra-primitives)\n   477\t        program-in (make-attachment ingress-capacity)\n   478\t        program-out (make-attachment ingress-capacity)]\n   479\t    {:vm vm\n   480\t     :load-program (get program-loaders vm-type)\n   481\t     :run-program (make-runner output-stream)\n   482\t     :program-stream (:stream program-in)\n   483\t     :program-identity (:identity program-in)\n   484\t     :observer (:observer program-in)\n   485\t     :expander (make-expander (:identity program-in) (:stream program-out))\n   486\t     :row-stream (:stream program-out)\n   487\t     :row-observer (:observer program-out)}))\n   488\t\n   489\t\n   490\t(defn create-state\n   491\t  \"Create the shell value.  `:primitives` is a host-supplied map merged over\n   492\t   the REPL primitives; it is kept as `:extra-primitives` so every session\n   493\t   rebuild — `(reset)`, `(vm …)` — installs it again.\"\n   494\t  ([] (create-state {}))\n   495\t  ([{:keys [lang output-cursor output-stream vm-type primitives]\n   496\t     :or {lang :clojure vm-type :semantic}}]\n   497\t   (let [output-stream (or output-stream (make-output-medium!))\n   498\t         output-cursor (or output-cursor (mint-cursor output-stream))]\n   499\t     (merge\n   500\t       (make-session vm-type output-stream primitives)\n   501\t       {:lang lang\n   502\t        :vm-type vm-type\n   503\t        :extra-primitives primitives\n   504\t        :output-stream output-stream\n   505\t        :output-cursor output-cursor\n   506\t        :ledger {:output :untried}\n   507\t        :ingress-loss? false\n   508\t        :last-value nil\n   509\t        :last-value-2 nil\n   510\t        :last-value-3 nil\n   511\t        :pending-input nil\n   512\t        :running? true}))))\n   513\t\n   514\t\n   515\t;; =============================================================================\n   516\t;; Reading and classifying input\n   517\t;; =============================================================================\n   518\t\n   519\t(defn- read-forms\n   520\t  [input]\n   521\t  #?(:cljd (edn/read-string (str \"[\" input \"]\"))\n   522\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n   523\t     :clj (clojure.core/read-string (str \"[\" input \"]\"))))\n   524\t\n   525\t\n   526\t(defn- command-form?\n   527\t  [form]\n   528\t  (and (seq? form)\n   529\t       (symbol? (first form))\n   530\t       (contains? command-heads (first form))))\n   531\t\n   532\t\n   533\t(defn- datom?\n   534\t  [value]\n   535\t  (and (vector? value) (= 5 (count value))))\n   536\t\n   537\t\n   538\t(defn- datom-stream?\n   539\t  [value]\n   540\t  (and (vector? value) (seq value) (every? datom? value)))\n   541\t\n   542\t\n   543\t(defn- ast-map?\n   544\t  [value]\n   545\t  (and (map? value) (keyword? (:type value))))\n   546\t\n   547\t\n   548\t(defn- bracket-balance\n   549\t  \"Open minus close brackets, ignoring string literals and `;` comments.\n   550\t   Positive means the input is incomplete.\"\n   551\t  [s]\n   552\t  (loop [chars (seq s)\n   553\t         depth 0\n   554\t         in-str? false]\n   555\t    (if (empty? chars)\n   556\t      depth\n   557\t      (let [ch (first chars)\n   558\t            tail (rest chars)]\n   559\t        (cond in-str? (cond (= ch \\\\) (recur (rest tail) depth true)\n   560\t                            (= ch \\\") (recur tail depth false)\n   561\t                            :else (recur tail depth true))\n   562\t              (= ch \\\") (recur tail depth true)\n   563\t              (= ch \\;) (recur (drop-while #(not= % \\newline) tail) depth false)\n   564\t              (#{\\( \\[ \\{} ch) (recur tail (inc depth) false)\n   565\t              (#{\\) \\] \\}} ch) (recur tail (dec depth) false)\n   566\t              :else (recur tail depth false))))))\n   567\t\n   568\t\n   569\t;; =============================================================================\n   570\t;; Evaluation\n   571\t;; =============================================================================\n   572\t\n   573\t(defn- inject-last-value\n   574\t  [state]\n   575\t  (update state :vm update :store assoc\n   576\t          '*1 (:last-value state)\n   577\t          '*2 (:last-value-2 state)\n   578\t          '*3 (:last-value-3 state)))\n   579\t\n   580\t\n   581\t(defn- record-last-value\n   582\t  [state state-after value]\n   583\t  (assoc state-after\n   584\t         :last-value value\n   585\t         :last-value-2 (:last-value state)\n   586\t         :last-value-3 (:last-value-2 state)))\n   587\t\n   588\t\n   589\t(defn- finalize-eval\n   590\t  \"Drain the round's output and its result from the output medium.  The\n   591\t   newest result is this round's: the evaluator answers once per halted\n   592\t   program, after its prints.\"\n   593\t  [state state' vm']\n   594\t  (let [[state'' output-text results] (drain-output (assoc state' :vm vm'))]\n   595\t    (if (seq results)\n   596\t      (let [value (peek results)]\n   597\t        [(record-last-value state state'' value)\n   598\t         (str output-text (format-value value))])\n   599\t      [state''\n   600\t       (str output-text \"Error: \" result-loss-text)])))\n   601\t\n   602\t\n   603\t(defn- drain-observer\n   604\t  \"Advance one observer past every batch still on its medium, keeping any\n   605\t   gap it recovers across.  A nil observer — a session without that medium —\n   606\t   stays nil.\"\n   607\t  [observer]\n   608\t  (when observer\n   609\t    (loop [observer observer]\n   610\t      (let [{:keys [status] observer' :observer}\n   611\t            (observer/observe-next observer)]\n   612\t        (if (#{:ok :gap} status) (recur observer') observer')))))\n   613\t\n   614\t\n   615\t(defn- consume-failed-round\n   616\t  \"Answer a round that threw with a recoverable shell state.\n   617\t\n   618\t   The failed input is consumed exactly once: each of the session's\n   619\t   observers resumes from the session the throw carried — the failing\n   620\t   stage's, matched by the medium it holds — or from where the round began\n   621\t   when it carried none, and reads past every batch still on its medium.\n   622\t   The shell is the only appender and appends one batch per round, so what\n   623\t   remains is the failed batch alone.  The VM is the one the round began\n   624\t   with, so a half-run continuation cannot be resumed — and its error\n   625\t   replayed — by the next input.  Output the round already emitted is\n   626\t   drained here, once.\"\n   627\t  [state error]\n   628\t  (let [carried (get-in (ex-data error) [:session :observer])\n   629\t        resume (fn [observer]\n   630\t                 (if (and observer\n   631\t                          carried\n   632\t                          (= (:stream carried) (:stream observer)))\n   633\t                   carried\n   634\t                   observer))\n   635\t        program (drain-observer (resume (:observer state)))\n   636\t        rows (drain-observer (resume (:row-observer state)))\n   637\t        gaps-before (+ (:ingress-gaps (:observer state) 0)\n   638\t                       (:ingress-gaps (:row-observer state) 0))\n   639\t        gaps-after (+ (:ingress-gaps program 0) (:ingress-gaps rows 0))\n   640\t        [state' output-text]\n   641\t        (drain-output\n   642\t          (cond-> (assoc state :observer program :row-observer rows)\n   643\t            (> gaps-after gaps-before)\n   644\t            (assoc :ingress-loss? true)))]\n   645\t    [state' (str output-text (format-error error))]))\n   646\t\n   647\t\n   648\t(defn- ingress-gaps\n   649\t  [state]\n   650\t  (+ (:ingress-gaps (:observer state) 0)\n   651\t     (:ingress-gaps (:row-observer state) 0)))\n   652\t\n   653\t\n   654\t(defn- run-expander-stage\n   655\t  \"Drive the expander over `program-in` and drain its summary.  It expands\n   656\t   each observed batch and appends the tree packet to `program-out`; a\n   657\t   failed expansion forwards nothing, yet its cursor advances (yin.vm.macro.md\n   658\t   decision 12).  Returns the state with the expander's progress and the\n   659\t   drained `{:errors :forwarded}` summary.\"\n   660\t  [state]\n   661\t  (let [{:keys [observer consumer]}\n   662\t        (macro/step {:observer (:observer state), :consumer (:expander state)})\n   663\t        [expander summary] (macro/drain-errors consumer)]\n   664\t    [(assoc state :observer observer :expander expander) summary]))\n   665\t\n   666\t\n   667\t(defn- run-evaluator-stage\n   668\t  \"Drive the evaluator's observer over `program-out`: it loads each\n   669\t   expanded tree packet into the VM, runs it, and answers its value on the\n   670\t   output medium.  The two stages meet only at `program-out`; neither calls\n   671\t   the other.\"\n   672\t  [{:keys [load-program run-program] :as state}]\n   673\t  (let [{:keys [observer] vm :consumer}\n   674\t        (observer/run-on-stream {:observer (:row-observer state),\n   675\t                                 :consumer (:vm state)}\n   676\t                                engine/ready-for-ingress?\n   677\t                                load-program\n   678\t                                run-program)]\n   679\t    (assoc state :row-observer observer :vm vm)))\n   680\t\n   681\t\n   682\t(defn- format-expansion-errors\n   683\t  [errors]\n   684\t  (str/join \"\\n\" (map #(str \"Error: Macro expansion failed: \" (format-value %))\n   685\t                      errors)))\n   686\t\n   687\t\n   688\t(defn- run-evaluation\n   689\t  \"The evaluator half of a round whose expander forwarded a program: run\n   690\t   it, then either finalize the value or consume the failure.  `state` is\n   691\t   the round's starting state; `expanded` already carries the expander's\n   692\t   progress, which a failing evaluation keeps.\"\n   693\t  [state expanded]\n   694\t  (try\n   695\t    (let [gaps-before (ingress-gaps expanded)\n   696\t          evaluated (run-evaluator-stage expanded)]\n   697\t      (cond\n   698\t        (> (ingress-gaps evaluated) gaps-before)\n   699\t        [(assoc evaluated :ingress-loss? true)\n   700\t         (str \"Error: \" ingress-loss-text)]\n   701\t\n   702\t        (vm/halted? (:vm evaluated))\n   703\t        (finalize-eval state evaluated\n   704\t                       (engine/restore-initial-env (:env (:vm expanded))\n   705\t                                                   (:vm evaluated)))\n   706\t\n   707\t        :else\n   708\t        (throw\n   709\t          (ex-info\n   710\t            \"Program stream did not form a complete, runnable Yin VM program.\n   711\tHint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n   712\t            {:vm-type (:vm-type state)}))))\n   713\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n   714\t      (consume-failed-round (assoc expanded :vm (:vm state)) error))))\n   715\t\n   716\t\n   717\t(defn- eval-program\n   718\t  \"Evaluate one frontend program — the map AST the compilers emit or a\n   719\t   datom-literal program — through the §10.1 composition.  The encoder\n   720\t   projects it to an input batch of canonical rows with its harvest and\n   721\t   declaration rows; the shell appends that batch to `program-in`, drives\n   722\t   the expander, drains its summary, and drives the evaluator only when a\n   723\t   program was forwarded.  An expansion failure is reported as data: its\n   724\t   batch is consumed, the store keeps its previous macros, and the next\n   725\t   input evaluates normally.  An encoding failure throws before anything\n   726\t   is appended.\n   727\t\n   728\t   The observers recover across a gap on their own, but the shell reads the\n   729\t   gap counts around the round: an increase on any medium means one or more\n   730\t   batches were never run, so resuming as though execution were complete\n   731\t   would report a result built on programs the VM never saw.  The loss is\n   732\t   reported and the shell refuses further evaluation until `(reset)`.\n   733\t\n   734\t   A completed program's lexical environment does not outlive it: the VM's\n   735\t   environment is restored to the one the round began with, as `vm/eval`\n   736\t   does.  A round that throws is consumed by `consume-failed-round`.\"\n   737\t  [state program]\n   738\t  (if (:ingress-loss? state)\n   739\t    [state (str \"Error: \" ingress-loss-text)]\n   740\t    (let [state' (inject-last-value state)\n   741\t          batch (encoder/program-batch program)\n   742\t          append (stream/append! (:program-stream state') batch)]\n   743\t      (if-not (= :dao.stream/ok (:dao.stream/outcome append))\n   744\t        [state (str \"Error: program batch not ingested: \"\n   745\t                    (name (:dao.stream/outcome append)))]\n   746\t        (let [expanded (try\n   747\t                         (run-expander-stage state')\n   748\t                         (catch #?(:cljd Object\n   749\t                                   :clj Exception\n   750\t                                   :cljs js/Error) error\n   751\t                           {:failed (consume-failed-round state error)}))]\n   752\t          (if-let [failed (:failed expanded)]\n   753\t            failed\n   754\t            (let [[expanded {:keys [errors forwarded]}] expanded]\n   755\t              (cond\n   756\t                (> (ingress-gaps expanded) (ingress-gaps state'))\n   757\t                [(assoc expanded :ingress-loss? true)\n   758\t                 (str \"Error: \" ingress-loss-text)]\n   759\t\n   760\t                (pos? forwarded) (run-evaluation state expanded)\n   761\t\n   762\t                :else [(assoc expanded :vm (:vm state))\n   763\t                       (format-expansion-errors errors)]))))))))\n   764\t\n   765\t\n   766\t(defn- compile-clojure-forms\n   767\t  [forms]\n   768\t  (if (= 1 (count forms))\n   769\t    (yang.clojure/compile (first forms))\n   770\t    (yang.clojure/compile-program forms)))\n   771\t\n   772\t\n   773\t(defn- compile-source\n   774\t  [lang input]\n   775\t  (case lang\n   776\t    :clojure (compile-clojure-forms (read-forms input))\n   777\t    :python (yang.python/compile input)\n   778\t    :php (yang.php/compile input)\n   779\t    (throw (ex-info \"Unsupported Yin REPL language\" {:lang lang}))))\n   780\t\n   781\t\n   782\t(defn- compile-command-ast\n   783\t  [state arg]\n   784\t  (case (:lang state)\n   785\t    :clojure (if (string? arg)\n   786\t               (compile-source :clojure arg)\n   787\t               (yang.clojure/compile arg))\n   788\t    (if (string? arg)\n   789\t      (compile-source (:lang state) arg)\n   790\t      (throw (ex-info \"This compile command expects a source string\"\n   791\t                      {:lang (:lang state) :arg arg})))))\n   792\t\n   793\t\n   794\t(defn- render-compile-output\n   795\t  \"Render the frontend syntax, the input row batch, and what the session's\n   796\t   expander would make of it against its current store: the expanded tree\n   797\t   packet (or the expansion error) and the event rows.  The expansion is a\n   798\t   preview; its context is discarded, so nothing is committed.\"\n   799\t  [state ast]\n   800\t  (let [batch (encoder/program-batch ast)\n   801\t        {:keys [tree error log]}\n   802\t        (macro/expand-batch batch (get-in state [:expander :ctx]))]\n   803\t    (str \"AST:\\n\" (format-value ast)\n   804\t         \"\\n\\nInput rows:\\n\" (format-value batch)\n   805\t         (if tree\n   806\t           (str \"\\n\\nExpanded rows:\\n\" (format-value tree))\n   807\t           (str \"\\n\\nExpansion error:\\n\" (format-value error)))\n   808\t         \"\\n\\nEvents:\\n\" (format-value (second log)))))\n   809\t\n   810\t\n   811\t(defn- rebuild-session\n   812\t  \"Replace the VM, the expander, and their media, attachments, and\n   813\t   observers.  The value history is cleared with them: a closure in `*1`\n   814\t   names a code segment the old VM held, which the new one does not.  The\n   815\t   new expander holds only the standard forms.\"\n   816\t  [state vm-type]\n   817\t  (merge state\n   818\t         (make-session vm-type (:output-stream state) (:extra-primitives state))\n   819\t         {:vm-type vm-type\n   820\t          :ingress-loss? false\n   821\t          :last-value nil\n   822\t          :last-value-2 nil\n   823\t          :last-value-3 nil}))\n   824\t\n   825\t\n   826\t(declare repl-state)\n   827\t\n   828\t\n   829\t(defn handle-command\n   830\t  \"Answer one shell command.  Unsupported arguments are answered as text, not\n   831\t   thrown, so a mistyped command cannot end a step.\"\n   832\t  [state form]\n   833\t  (let [[command & args] form]\n   834\t    (case command\n   835\t      vm (let [vm-type (first args)]\n   836\t           (if (contains? vm-constructors vm-type)\n   837\t             [(rebuild-session state vm-type)\n   838\t              (str \"Switched to \" (get vm-labels vm-type) \" (store cleared)\")]\n   839\t             [state (str \"Error: Unknown Yin REPL VM type \" (pr-str vm-type)\n   840\t                         \"; supported: \"\n   841\t                         (pr-str (vec (keys vm-constructors))))]))\n   842\t      lang (let [lang (first args)]\n   843\t             (if (contains? lang-labels lang)\n   844\t               [(assoc state :lang lang)\n   845\t                (str \"Switched to \" (get lang-labels lang))]\n   846\t               [state (str \"Error: Unknown Yin REPL language \" (pr-str lang)\n   847\t                           \"; supported: \" (pr-str (vec (keys lang-labels))))]))\n   848\t      compile [state (render-compile-output\n   849\t                       state\n   850\t                       (compile-command-ast state (first args)))]\n   851\t      reset [(rebuild-session state (:vm-type state))\n   852\t             (str (get vm-labels (:vm-type state)) \" reset\")]\n   853\t      help [state help-text]\n   854\t      repl-state [state (format-value (repl-state state))]\n   855\t      quit [(assoc state :running? false) \"Bye\"]\n   856\t      telemetry [state telemetry-text]\n   857\t      [state (str \"Error: Unknown Yin REPL command \" (pr-str command))])))\n   858\t\n   859\t\n   860\t(defn- eval-parsed\n   861\t  [state trimmed parsed]\n   862\t  (try\n   863\t    (let [forms (:forms parsed)\n   864\t          form (when (= 1 (count forms)) (first forms))]\n   865\t      (cond\n   866\t        (and form (command-form? form)) (handle-command state form)\n   867\t        (and form (datom-stream? form)) (eval-program state (vec form))\n   868\t        (and form (ast-map? form)) (eval-program state form)\n   869\t        forms (if (= :clojure (:lang state))\n   870\t                (eval-program state (compile-clojure-forms forms))\n   871\t                (eval-program state (compile-source (:lang state) trimmed)))\n   872\t        (= :clojure (:lang state)) [state (format-error (:error parsed))]\n   873\t        :else (eval-program state (compile-source (:lang state) trimmed))))\n   874\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n   875\t      (let [[state' output-text] (drain-output state)]\n   876\t        [state' (str output-text (format-error error))]))))\n   877\t\n   878\t\n   879\t(defn eval-input\n   880\t  \"Evaluate one input line locally, returning `[state text]`.\n   881\t\n   882\t   Input whose brackets do not balance is retained as `:pending-input` and\n   883\t   produces no text.  Nothing here is asynchronous: the driver, not this\n   884\t   namespace, decides when the next step happens.\"\n   885\t  [state line]\n   886\t  (let [pending (or (:pending-input state) \"\")\n   887\t        combined (if (str/blank? pending)\n   888\t                   (str/trim line)\n   889\t                   (str pending \"\\n\" (str/trim line)))]\n   890\t    (if (pos? (bracket-balance combined))\n   891\t      [(assoc state :pending-input combined) \"\"]\n   892\t      (let [state' (assoc state :pending-input nil)\n   893\t            parsed (try {:forms (read-forms combined)}\n   894\t                        (catch #?(:cljd Object\n   895\t                                  :clj Exception\n   896\t                                  :cljs js/Error) error\n   897\t                          {:error error}))]\n   898\t        (eval-parsed state' combined parsed)))))\n   899\t\n   900\t\n   901\t(defn repl-state\n   902\t  \"A serializable summary of shell state.\n   903\t\n   904\t   The stream summaries read the ledger rather than asking a handle whether it\n   905\t   is closed: v2 has no `closed?`, and an idle medium has no last operation.\n   906\t   The program media are the composition's own, observed beside the VM, so\n   907\t   the shell reports what it knows of them — the declared capacity, the gaps\n   908\t   the session's observers counted, and whether a loss has already refused\n   909\t   further evaluation.  `:macros` maps each macro the expander's store holds\n   910\t   to its lambda's root address (yin.vm.macro.md §10.1).\"\n   911\t  [state]\n   912\t  {:lang (:lang state)\n   913\t   :macros (into (sorted-map-by #(compare (str %1) (str %2)))\n   914\t                 (map (fn [[sym [root _]]] [sym root]))\n   915\t                 (get-in state [:expander :ctx :store]))\n   916\t   :vm {:type (:vm-type state)\n   917\t        :halted? (vm/halted? (:vm state))\n   918\t        :blocked? (vm/blocked? (:vm state))\n   919\t        :in-stream {:capacity ingress-capacity\n   920\t                    :gaps (ingress-gaps state)\n   921\t                    :lost? (boolean (:ingress-loss? state))}}\n   922\t   :running? (:running? state)\n   923\t   :output {:cursor (:output-cursor state)\n   924\t            :last-outcome (get-in state [:ledger :output] :untried)}\n   925\t   :telemetry {:supported? false :note telemetry-text}\n   926\t   :remote {:connected? false}})\n","exit_code":0,"status":"completed"}}
