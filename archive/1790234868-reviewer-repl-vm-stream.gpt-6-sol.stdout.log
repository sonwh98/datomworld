 rd}))]\n            (assoc vm\n                   :pc callee-pc\n                   :frames body-frames\n                   :registers callee-regs\n                   :continuation continuation'))\n\n          (fn? f)\n          (let [result (apply f args)]\n            (if (module/effect? result)\n              (run-call-effect vm result inst)\n              (if tail?\n                (return-transition vm result)\n                (assoc vm\n","exit_code":0,"status":"completed"}}
