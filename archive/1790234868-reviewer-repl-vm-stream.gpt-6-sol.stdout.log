{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '85,160p;200,285p;550,610p' src/cljc/yin/vm/debruijn/stack.cljc | nl -ba -v85\"","aggregated_output":"    85\t   bridge       ; explicit host-side FFI bridge state, or nil\n    86\t   primitives   ; primitive registry, for :load-free\n    87\t   modules])    ; module registry, for :load-free and effect dispatch\n    88\t\n    89\t\n    90\t(def format-tag\n    91\t  \"The model tag every register payload carries as `:format`.\"\n    92\t  :yin.debruijn.code)\n    93\t\n    94\t\n    95\t(defn load-image\n    96\t  \"Load `segment` (a vector of instructions) into `vm` as its one image:\n    97\t   H is recomputed, the registers are reset to pc 0 with empty frames,\n    98\t   stack, and continuation, and the machine is running unless the segment\n    99\t   is empty. The store, the parked map, the wait set, the ready queue,\n   100\t   the id counter, and the composition values survive, exactly as they\n   101\t   survive a `yin.vm.semantic/load-vector`. A continuation parked under an\n   102\t   earlier image cannot be restored against this one: `stack-restore`\n   103\t   refuses it by H.\"\n   104\t  [vm segment]\n   105\t  (assoc vm\n   106\t         :segment segment\n   107\t         :hash (dcode/image-hash segment)\n   108\t         :pc 0\n   109\t         :frames []\n   110\t         :stack []\n   111\t         :continuation []\n   112\t         :halted? (empty? segment)\n   113\t         :blocked? false\n   114\t         :value nil))\n   115\t\n   116\t\n   117\t(defn create-vm\n   118\t  \"Build a fresh `DebruijnVM` over `segment` (a vector of instructions).\n   119\t\n   120\t   Options: `:free-env`, `:store`, `:primitives`, `:modules` (all default to\n   121\t   `{}`, matching the named VM's empty defaults except that `:primitives`\n   122\t   defaults to `{}` here whereas `yin.vm/empty-state` populates the full\n   123\t   primitive table; callers pass `yin.vm/primitives` when they want the\n   124\t   standard registry), `:make-stream` (the host's stream constructor; no\n   125\t   for every v2 VM), `:call-in`/`:call-out`/`:call-capacity` (the FFI pair,\n   126\t   built by `yin.vm/empty-state` exactly as the semantic VM's is), and\n   127\t   `:bridge` (host FFI handlers, attached by `yin.vm.ffi/attach`).\n   128\t\n   129\t   An empty segment starts halted with an empty program, as the semantic\n   130\t   VM's `create-vm` does; `load-image` loads work into it.\n   131\t\n   132\t   Always fresh: never resume or mutate a VM that has already run, per the\n   133\t   design's D4 fixture restriction (the named VM's environment-leak defect\n   134\t   is out of scope here and must not be reproduced by accident).\"\n   135\t  ([segment] (create-vm segment {}))\n   136\t  ([segment opts]\n   137\t   (let [base (vm/empty-state\n   138\t                (assoc (select-keys opts [:modules :make-stream :call-in\n   139\t                                          :call-out :call-capacity])\n   140\t                       :primitives (or (:primitives opts) {})))]\n   141\t     (-> (map->DebruijnVM\n   142\t           {:segment [],\n   143\t            :hash nil,\n   144\t            :pc 0,\n   145\t            :frames [],\n   146\t            :free-env (or (:free-env opts) {}),\n   147\t            :stack [],\n   148\t            :continuation [],\n   149\t            :store (merge (:store base) (:store opts)),\n   150\t            :blocked? false,\n   151\t            :halted? true,\n   152\t            :wait-set [],\n   153\t            :ready-queue [],\n   154\t            :parked {},\n   155\t            :id-counter 0,\n   156\t            :value nil,\n   157\t            :make-stream (:make-stream base),\n   158\t            :bridge nil,\n   159\t            :primitives (:primitives base),\n   160\t            :modules (or (:modules opts) {})})\n   161\t;; The engine seam: register payload, restore, builders\n   162\t;; =============================================================================\n   163\t\n   164\t(defn- registers\n   165\t  \"The register payload of the continuation after the current instruction\n   166\t   (design section 4.1, item 3): `pc'` is the advanced pc and `stack'` the\n   167\t   operand stack with the instruction's operands popped. Frames and the\n   168\t   return-frame continuation are the running ones. `:format` and `:hash`\n   169\t   stamp the model and image identity that produced it. Free environment,\n   170\t   store, primitives, and modules are not registers and stay on the state.\"\n   171\t  [vm pc' stack']\n   172\t  {:segment (:segment vm),\n   173\t   :pc pc',\n   174\t   :frames (:frames vm),\n   175\t   :stack stack',\n   176\t   :continuation (:continuation vm),\n   177\t   :format format-tag,\n   178\t   :hash (:hash vm)})\n   179\t\n   180\t\n   181\t(defn- refuse-continuation!\n   182\t  [base entry]\n   183\t  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n   184\t                  {:rule :continuation-format,\n   185\t                   :format (:format entry),\n   186\t                   :hash (:hash entry),\n   187\t                   :expected-format format-tag,\n   188\t                   :expected-hash (:hash base)})))\n   189\t\n   190\t\n   191\t(defn stack-restore\n   192\t  \"This machine's one restore function, `base entry val -> state`\n   193\t   (`yin.vm.engine.md` section 2.1; design section 4.1, item 4). `base` is\n   194\t   the state after the engine has done its part; `entry` is the wait, ready,\n   195\t   or parked record; `val` is the value the parked instruction receives.\n   196\t\n   197\t   It first refuses with a qualified `:continuation-format` outcome unless\n   198\t   the entry's `:format` is `:yin.debruijn.code` and its `:hash` equals the\n   199\t   loaded image's H: a continuation from the named VM, from the register\n   200\t   kernel, or from another image is never interpreted here.\n   201\t\n   202\t   Then the FFI two-step, on the entry keys the `yin.vm.ffi` convention\n   203\t   owns, in the semantic VM's placement:\n   204\t\n   205\t   - A `:request-sent` entry is a writer whose retained request has now been\n   206\t     appended. It must not resume: its registers are re-parked as the\n   207\t     call-out reader (`ffi/response-wait-entry`) and the machine stays\n   208\t     blocked.\n   209\t   - A `:call-id` entry is a response reader. The woken value is a response\n   210\t     envelope, so `ffi/call-result` unwraps it and checks correlation, and\n   211\t     the parked call leaves `:parked` rather than accumulating.\n   212\t\n   213\t   Otherwise the registers are written from the entry and `val` is conjed\n   214\t   onto the restored `:stack` -- the B3 obligation that every\n   215\t   value-producing opcode lands on the stack, since there is no\n   216\t   accumulator.\"\n   217\t  [base entry val]\n   218\t  (when-not (and (= format-tag (:format entry))\n   219\t                 (= (:hash base) (:hash entry)))\n   220\t    (refuse-continuation! base entry))\n   221\t  (if (:request-sent entry)\n   222\t    (-> base\n   223\t        (update :wait-set (fnil conj [])\n   224\t                (ffi/response-wait-entry entry (:call-id entry)))\n   225\t        (assoc :value :yin/blocked\n   226\t               :blocked? true\n   227\t               :halted? false))\n   228\t    (let [call-id (:call-id entry)\n   229\t          base (if call-id (update base :parked dissoc call-id) base)\n   230\t          val (if call-id (ffi/call-result val call-id) val)]\n   231\t      (assoc base\n   232\t             :segment (:segment entry)\n   233\t             :pc (:pc entry)\n   234\t             :frames (:frames entry)\n   235\t             :continuation (:continuation entry)\n   236\t             :stack (conj (vec (:stack entry)) val)\n   237\t             :value val\n   238\t             ;; Restored registers are active work: a driver resuming a\n   239\t             ;; halted machine directly through `engine/resume-continuation`\n   240\t             ;; gets a running one back, as the semantic VM's restore gives.\n   241\t             :halted? false))))\n   242\t\n   243\t\n   244\t(defn- park-entry-fns\n   245\t  \"Wait-entry builders for an instruction whose effect may block (design\n   246\t   section 4.1, item 5): each closes over the post-instruction registers\n   247\t\n   248\t\n   249\t;; =============================================================================\n   250\t;; Scheduling\n   251\t;; =============================================================================\n   252\t\n   253\t(defn- run-scheduler\n   254\t  \"The raw runner: already-loaded work only, through the shared scheduler\n   255\t   loop with this machine's step function and its restore bound into the\n   256\t   engine's run-queue resumption. `ffi/maybe-run` wraps this for bridge\n   257\t   dispatch.\"\n   258\t  [vm]\n   259\t  (engine/run-loop vm\n   260\t                   engine/active-continuation?\n   261\t                   step1\n   262\t                   #(engine/resume-from-run-queue % stack-restore)))\n   263\t\n   264\t\n   265\t;; =============================================================================\n   266\t;; IVM / IVMState\n   267\t;; =============================================================================\n   268\t;; No new protocol methods (section 4, point 7). `environment` is not\n   269\t;; implemented at all (point 8): the design defers it until a\n   270\t;; frame-to-named lift exists, and returning the raw positional frame\n   271\t;; vector from it would be wrong once the method does exist.\n   272\t\n   273\t(extend-type DebruijnVM\n   274\t  vm/IVM\n   275\t  (step [this]\n   276\t    (cond (engine/active-continuation? this) (step1 this)\n   277\t          ;; Between continuations: one scheduler round, as the semantic\n   278\t          ;; VM's `step` runs when it has no control left.\n   279\t          (or (:blocked? this) (seq (:ready-queue this)))\n   280\t          (engine/scheduler-round this stack-restore)\n   281\t          :else this))\n   282\t  (run [this] (ffi/maybe-run this run-scheduler))\n   283\t  (eval [_ ast]\n   284\t    (throw (ex-info\n   285\t             \"The de Bruijn kernel executes raw instruction vectors, not AST: lower and adapt it first (yin.vm.debruijn-linearize/adapt), then load and run the resulting image\"\n   286\t             {:ast ast})))\n   287\t  (reset [this]\n   288\t    (assoc this\n   289\t           :pc 0, :frames [], :stack [], :continuation []\n   290\t           :halted? (empty? (:segment this)), :blocked? false, :value nil))\n   291\t  (halted? [this] (engine/halted-with-empty-queue? this))\n   292\t  (blocked? [this] (engine/vm-blocked? this))\n   293\t  (value [this] (engine/vm-value this))\n   294\t\n   295\t  vm/IVMState\n   296\t  (control [this] {:pc (:pc this)})\n   297\t  (environment [_this]\n   298\t    (throw (ex-info\n   299\t             \"environment is not implemented: the design defers it until a frame-to-named lift exists\"\n   300\t             {:rule :not-yet-supported})))\n   301\t  (store [this] (:store this))\n   302\t  (continuation [this] (:continuation this)))\n","exit_code":0,"status":"completed"}}
