nding from the root row, so a\n   807\t   path is always available except for `:root-reachable`'s unreached rows.\n   808\t   Each rule assumes the earlier ones held.\"\n   809\t  [{:keys [root rows]}]\n   810\t  (let [reached (atom #{})]\n   811\t    (letfn\n   812\t      [(slot-defect\n   813\t         [tag slots body path]\n   814\t         (some identity\n   815\t               (map (fn [[field kind] v]\n   816\t                      (cond\n   817\t                        (and (nil? v)\n   818\t                             (contains? semantic-bytecode-defaults [tag field]))\n   819\t                        {:rule :saturation, :path path}\n   820\t                        (not (semantic-bytecode-slot-kind-ok? kind v))\n   821\t                        {:rule :slot-kind, :path path}))\n   822\t                    slots (rest body))))\n   823\t       (visit\n   824\t         [id path on-path]\n   825\t         (cond\n   826\t           (contains? on-path id) {:rule :acyclic, :path path}\n   827\t           (contains? @reached id) nil\n   828\t           :else\n   829\t           (let [row (get rows id)]\n   830\t             (if (nil? row)\n   831\t               {:rule :id-resolves, :path path}\n   832\t               (let [tag (semantic-bytecode-row-tag row)\n   833\t                     slots (get semantic-bytecode-grammar tag)]\n   834\t                 (if (nil? slots)\n   835\t                   {:rule :tag, :path path}\n   836\t                   (let [body (subvec row 1)]\n   837\t                     (if (not= (count slots) (dec (count body)))\n   838\t                       {:rule :arity, :path path}\n   839\t                       (or (slot-defect tag slots body path)\n   840\t                           (let [on-path' (conj on-path id)]\n   841\t                             (some (fn [[suffix cid]]\n   842\t                                     (visit cid (conj path suffix) on-path'))\n   843\t                                   (semantic-bytecode-child-refs tag body)))\n   844\t                           (do (swap! reached conj id) nil))))))))))]\n   845\t      (or (visit root [] #{})\n   846\t          (some (fn [id]\n   847\t                  (when-not (contains? @reached id)\n   848\t                    {:rule :root-reachable, :id id}))\n   849\t                (keys rows))))))\n   850\t\n   851\t\n   852\t(defn semantic-bytecode->ast\n   853\t  \"Reconstruct the canonical map AST from `{:root row-id, :rows {row-id row}}`\n   854\t   (§7.1 load-time reconstruction), the inverse of `ast->semantic-bytecode`.\n   855\t\n   195\t                                        :target (lit sref),\n   196\t                                        :val (lit 99)})]\n   197\t                      [(v2/value vm1) (v2/value (v2/eval vm1 (read-ast sref)))])]\n   198\t      (is (= 99 (first v2-result)) \"put returns the value\")\n   199\t      (is (= [99 99] v2-result)))))\n   200\t\n   201\t\n   202\t(deftest stream-close-parity-test\n   203\t  (testing \"closing a stream (v1 returned nil, captured 2026-09-18)\"\n   204\t    (let [v2-result (let [vm0 (v2/eval (tu/create-vm) {:type :stream/make, :buffer 4})\n   205\t                          sref (v2/value vm0)\n   206\t                          vm1 (v2/eval vm0\n   207\t                                       {:type :stream/close,\n   208\t                                        :source (lit sref)})]\n   209\t                      (v2/value vm1))]\n   210\t      (is (= nil v2-result) \"close returns nil\"))))\n   365\t  (is (= {:type :vm/gensym, :prefix \"id\"}\n   366\t         (vm/semantic-bytecode->ast (vm/ast->semantic-bytecode\n   367\t                                      {:type :vm/gensym}))))\n   368\t  (is (= {:type :stream/make, :buffer vm/default-stream-capacity}\n   369\t         (vm/semantic-bytecode->ast (vm/ast->semantic-bytecode\n   370\t                                      {:type :stream/make})))))\n   371\t\n   372\t\n   373\t(deftest malformed-row-sets-each-name-exactly-their-own-rule\n   374\t  (doseq [[rule bc] malformed/malformed-row-sets]\n   375\t    (testing rule\n   376\t      (is (= {:rule rule} (select-keys (vm/validate-rows bc) [:rule])))\n   377\t      (is (= rule (error-rule #(vm/semantic-bytecode->ast bc)))))))\n   378\t\n   379\t\n   380\t(deftest semantic-bytecode-reconstruction-validates\n   381\t  (let [{:keys [root rows], :as bc}\n   382\t        (vm/ast->semantic-bytecode (app (local 'f) [(lit 1)] true))\n   383\t        [_ _ op-id _ _] (get rows root)\n   384\t        reroot (fn [row]\n   385\t                 (let [id (jing/segment-key (subvec row 1))]\n     1\t(ns yin.vm.malformed-rows\n     2\t  \"The §7.4/§7.2 part 3 published set of malformed row sets: one\n     3\t   `{:root row-id, :rows {row-id row}}` per row rule, each refused for\n     4\t   exactly the rule it is named after and no earlier one.\"\n     5\t  (:require [dao.jing :as jing]))\n     6\t\n     7\t\n     8\t(defn- valid-row\n     9\t  \"A correctly hashed row `[id tag & slots]` for `body`.\"\n    10\t  [body]\n    11\t  (let [id (jing/segment-key body)]\n    12\t    [id (into [id] body)]))\n    13\t\n    14\t\n    15\t(defn- one-row-bc\n    16\t  \"`{:root :rows}` holding a single, correctly hashed row.\"\n    17\t  [body]\n    18\t  (let [[id row] (valid-row body)]\n    19\t    {:root id, :rows {id row}}))\n    20\t\n    21\t\n    22\t(def ^:private fake-address-a\n    23\t  (keyword \"segment\" (str \"sha256-\" (apply str (repeat 64 \"a\")))))\n    24\t\n    25\t\n    26\t(def ^:private fake-address-b\n    27\t  (keyword \"segment\" (str \"sha256-\" (apply str (repeat 64 \"b\")))))\n    28\t\n    29\t\n    30\t(def malformed-row-sets\n    31\t  \"`{rule bc}`, one `{:root :rows}` value per §7.4 rule.\"\n    32\t  (let [[missing-id] (valid-row [:literal 999])\n    33\t        [lit1-id lit1-row] (valid-row [:literal 1])\n    34\t        [lit2-id lit2-row] (valid-row [:literal 2])]\n    35\t    {:tag (one-row-bc [:not-a-tag])\n    36\t     :arity (one-row-bc [:literal 1 2])\n    37\t     :slot-kind (one-row-bc [:vm/gensym :not-a-string])\n    38\t     :saturation (one-row-bc [:vm/gensym nil])\n    39\t     :id-resolves (one-row-bc [:application missing-id [] false])\n    40\t     :acyclic {:root fake-address-a,\n    41\t               :rows {fake-address-a [fake-address-a :stream/cursor fake-address-b],\n    42\t                      fake-address-b [fake-address-b :stream/cursor fake-address-a]}}\n    43\t     :root-reachable {:root lit1-id, :rows {lit1-id lit1-row, lit2-id lit2-row}}}))\n","exit_code":0,"status":"completed"}}
