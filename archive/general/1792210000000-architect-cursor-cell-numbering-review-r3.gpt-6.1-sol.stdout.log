{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'defn encode|byte-string|byte-payload|compare|sort' src/cljc/dao/jing/cbor.cljc; sed -n '80,114p' collab/numbering-probe/src/yin/vm/ucf/rows.cljc; sed -n '16,38p' collab/numbering-probe/src/yin/vm/ucf/rows_test.cljc; sed -n '810,870p' collab/numbering-probe/src/probe/discovery.clj\"","aggregated_output":"23:   * sets: tag 258 over elements sorted by their canonical bytes;\n45:   compare carriers with native numbers symmetrically, so the portable\n46:   operations are explicit functions: `num=`, `num-hash`, `num-compare`, and\n173:  ;; Dart's BigInt.compareTo returns any negative or positive int, not\n175:  #?(:cljd (let [c (.compareTo ^BigInt a b)]\n177:     :clj (.compareTo ^BigInteger a ^BigInteger b)\n696:    ;; (->Rational 2 4) still keys, hashes and compares as 1/2.\n743:(defn num-compare\n778:    (wire/byte-payload? x) (hash (bytes-hex x))\n801:    (or (wire/byte-payload? a) (wire/byte-payload? b))\n802:    (and (wire/byte-payload? a) (wire/byte-payload? b) (bytes= a b))\n895:    (wire/byte-payload? x) [::bytes (bytes-hex x)]\n918:   compare hash values across hosts.\"\n1069:    (wire/tagged 258 (mapv second (sort-by first wired)))))\n1125:    (wire/byte-payload? x) (do (deep! d :unsupported-value)\n1126:                               (wire/byte-string (copy-range x 0 (blen x))))\n1139:(defn encode\n1148:(defn byte-payload?\n1152:  (wire/byte-payload? x))\n1162:(defn encoded-compare\n1176:      :else (let [c (compare (bytes-hex ea) (bytes-hex eb))]\n1406:   apart (host identifier equality on ClojureScript compares the joined\n  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n\n\n(defn- check-literal-markers!\n  [x]\n  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n  (when (coll? x)\n    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n  (when (meta x) (check-literal-markers! (meta x))))\n\n\n(defn- bytes-key\n  [bs]\n  ;; Unsigned bytewise order, without a length-first comparison.\n  (mapv #(bit-and (int %) 255) (seq bs)))\n\n\n(defn- compare-bytes\n  [a b]\n  (loop [i 0]\n    (cond\n      (= i (count a)) (if (= i (count b)) 0 -1)\n      (= i (count b)) 1\n      (= (nth a i) (nth b i)) (recur (inc i))\n      :else (compare (nth a i) (nth b i)))))\n\n\n(defn- byte-compare\n  [a b]\n  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n\n\n(defn- sorted-bytes\n  [xs]\n  (vec (sort byte-compare xs)))\n(defn task-node\n  [cursor-cells result]\n  (rows/node :task [3 rows/profile :halted :root 0 (rows/node :bindings [])\n                    (rows/node :store []) [] (rows/node :parked-table [])\n                    (rows/node :cursor-cells (mapcat identity cursor-cells)) {} {} [] [] nil result nil]))\n\n\n(defn cursor-cell-body\n  [stream position]\n  (rows/node :cursor-cell-body [(rows/node :stream [stream {:peer stream}]) position]))\n\n\n(defn fixture\n  [a b x y]\n  (let [payload [:row (rows/node :map\n                                 [[:lit 'both] [:row (rows/node :set [[:cursor-cell x] [:cursor-cell y]])]\n                                  [:lit 'one] [:cursor-cell x]\n                                  [:lit 'streams] [:row (rows/node :set [[:row (rows/node :stream [a {:peer a}])]\n                                                                         [:row (rows/node :stream [b {:peer b}])]])]\n                                  [:lit 'cursors] [:row (rows/node :map [[:cursor-cell x] [:lit :x] [:cursor-cell y] [:lit :y]])]])]\n        task (task-node [[x (cursor-cell-body a 0)] [y (cursor-cell-body b 0)]] [:lit nil])]\n    (rows/node :task (assoc (:slots task) 6 (rows/node :store ['payload payload])))))\n\n        c (fn [x] [:cursor-cell x])\n        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))\n        two-cycle (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))\n        thre