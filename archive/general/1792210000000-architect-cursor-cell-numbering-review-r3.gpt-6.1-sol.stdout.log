---------------------------------------------- runs\n   128\t\n   129\t(def ^:dynamic *trace* false)\n   184\t\n   185\t(defn- unordered!\n   186\t  \"D1 for an unordered container: key every element by a speculative local\n   187\t   run under the numbering at this moment; enter singletons in key order;\n   188\t   defer equal runs as one tie group (deferral order = canonical order). A D6\n   189\t   trial run enters its forced element first, when its container is keyed.\"\n   190\t  [run kind elems path]\n   191\t  (let [f @(:first run)\n   192\t        forced (when f (first (keep-indexed (fn [i e] (when (= f (elem-item kind e)) i)) elems)))]\n   193\t    (when forced\n   194\t      (reset! (:first run) nil)\n   195\t      (enter-slot! run :V (elem-item kind (nth elems forced)) (conj path forced)))\n   196\t    (let [keyed (vec (keep-indexed (fn [i e] (when (not= i forced) [(local-key run (elem-item kind e)) e i])) elems))\n   197\t          groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n   198\t      (when (and *trace* (= :n (:tag run)))\n   199\t        (println \"  [sort]\" path \"num\" @(:num run))\n   200\t        (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n   201\t      (doseq [g groups]\n   202\t        (if (= 1 (count g))\n   203\t          (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n   204\t          (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n   205\t                                     :key (second (first (first g))) :elems (mapv second g)}))))))\n   278\t             :refused {:kind :unresolved-cursor-cells :path (:path comp) :cursor-cells (:cells comp)}})))\n   279\t\n   280\t(defn- adopt!\n   281\t  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n   282\t   receive the enclosing run's next numbers in local-index order.\"