{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'nl -ba test/yin/vm/linearize_test.cljc'","aggregated_output":"     1\t(ns yin.vm.linearize-test\n     2\t  (:require [clojure.test :refer [deftest is testing]]\n     3\t            [yin.vm :as vm]\n     4\t            [yin.vm.code :as code]\n     5\t            [yin.vm.linearize :as linearize]\n     6\t            [yin.vm.test-utils :as test-utils]))\n     7\t\n     8\t\n     9\t;; =============================================================================\n    10\t;; AST fixtures\n    11\t;; =============================================================================\n    12\t\n    13\t(defn- lit [v] {:type :literal, :value v})\n    14\t(defn- v [s] {:type :variable, :name s})\n    15\t(defn- lam [params body] {:type :lambda, :params params, :body body})\n    16\t(defn- app [op & args] {:type :application, :operator op, :operands (vec args)})\n    17\t(defn- tail [node] (assoc node :tail? true))\n    18\t(defn- if-node [t c a] {:type :if, :test t, :consequent c, :alternate a})\n    19\t(defn- def! [k val] (app (v 'yin/def) (lit k) (if (map? val) val (lit val))))\n    20\t\n    21\t\n    22\t(def ^:private worked-example\n    23\t  \"`((fn [x] (+ x 1)) 10)`, yin.vm.semantic.md §2.7.\"\n    24\t  (app (lam '[x] (tail (app (v '+) (v 'x) (lit 1)))) (lit 10)))\n    25\t\n    26\t\n    27\t(def ^:private corpus\n    28\t  {:worked-example worked-example,\n    29\t   :literal (lit 42),\n    30\t   :nil-literal (lit nil),\n    31\t   :zero-arity-call (app (lam [] (lit 1))),\n    32\t   :nested-lambdas (app (app (lam '[a] (tail (lam '[b] (tail (app (v '+) (v 'a) (v 'b))))))\n    33\t                             (lit 1))\n    34\t                        (lit 2)),\n    35\t   :if-in-tail (app (lam '[n] (if-node (app (v '<) (v 'n) (lit 1))\n    36\t                                       (lit :done)\n    37\t                                       (tail (app (v '-) (v 'n) (lit 1)))))\n    38\t                    (lit 3)),\n    39\t   :nested-if (if-node (if-node (lit true) (lit false) (lit true))\n    40\t                       (lit :a)\n    41\t                       (if-node (lit nil) (lit :b) (lit :c))),\n    42\t   :streams {:type :stream/put,\n    43\t             :target {:type :stream/make, :buffer 4},\n    44\t             :val {:type :stream/next,\n    45\t                   :source {:type :stream/cursor,\n    46\t                            :source {:type :stream/close,\n    47\t                                     :source (lit nil)}}}},\n    48\t   :ffi {:type :dao.stream.apply/call, :op :op/echo, :operands [(lit 1) (lit 2)]},\n    49\t   :ffi-no-args {:type :dao.stream.apply/call, :op :op/ping, :operands []},\n    50\t   :store-and-control (app (lam '[a b c d]\n    51\t                                (tail (app (v 'vector) (v 'a) (v 'b) (v 'c) (v 'd))))\n    52\t                           {:type :vm/store-put, :key 'k, :val 5}\n    53\t                           {:type :vm/store-get, :key 'k}\n    54\t                           {:type :vm/gensym, :prefix \"g\"}\n    55\t                           {:type :vm/current-continuation}),\n    56\t   :park-resume (if-node (lit false)\n    57\t                         {:type :vm/park}\n    58\t                         {:type :vm/resume, :parked-id :p1, :val (lit 7)})})\n    59\t\n    60\t\n    61\t;; =============================================================================\n    62\t;; Reading lowered output\n    63\t;; =============================================================================\n    64\t\n    65\t(defn- entities\n    66\t  [datoms]\n    67\t  (reduce (fn [acc [e a val]] (assoc-in acc [e a] val)) {} datoms))\n    68\t\n    69\t\n    70\t(defn- instructions\n    71\t  \"Instruction entities in pc order, each with its eid under :e.\"\n    72\t  [code-datoms]\n    73\t  (->> (entities code-datoms)\n    74\t       (keep (fn [[e attrs]] (when (:yin.code/op attrs) (assoc attrs :e e))))\n    75\t       (sort-by :yin.code/pc)\n    76\t       vec))\n    77\t\n    78\t\n    79\t(defn- segment\n    80\t  [code-datoms]\n    81\t  (let [[[e attrs]] (filter #(= :segment (:yin.code/type (val %)))\n    82\t                            (entities code-datoms))]\n    83\t    (assoc attrs :e e)))\n    84\t\n    85\t\n    86\t(defn- lowered\n    87\t  \"An AST, its datoms and root, and the code lowered from those datoms.\"\n    88\t  [ast]\n    89\t  (let [[root ast-datoms] (vm/ast->datoms-with-root ast)]\n    90\t    {:root root, :ast-datoms ast-datoms, :code (linearize/lower ast-datoms)}))\n    91\t\n    92\t\n    93\t;; =============================================================================\n    94\t;; Structural contract\n    95\t;; =============================================================================\n    96\t\n    97\t(deftest lowered-segments-are-well-formed\n    98\t  (doseq [[label ast] corpus]\n    99\t    (testing label\n   100\t      (is (nil? (code/well-formed? (:code (lowered ast))))))))\n   101\t\n   102\t\n   103\t(deftest pcs-are-dense\n   104\t  (doseq [[label ast] corpus]\n   105\t    (testing label\n   106\t      (let [code (:code (lowered ast))\n   107\t            insts (instructions code)\n   108\t            seg (segment code)]\n   109\t        (is (= 1 (count (filter #(= :yin.code/type (second %)) code))))\n   110\t        (is (= (count insts) (:yin.code/length seg)))\n   111\t        (is (= (range (:yin.code/length seg)) (map :yin.code/pc insts)))\n   112\t        (is (= (map :yin.code/pc insts)\n   113\t               (keep #(when (= :yin.code/pc (second %)) (nth % 2)) code))\n   114\t            \"the batch is emitted in pc order\")))))\n   115\t\n   116\t\n   117\t(deftest every-ref-resolves\n   118\t  (doseq [[label ast] corpus]\n   119\t    (testing label\n   120\t      (let [{:keys [root ast-datoms code]} (lowered ast)\n   121\t            ast-nodes (set (keep #(when (= :yin/type (second %)) (first %))\n   122\t                                 ast-datoms))\n   123\t            insts (instructions code)\n   124\t            inst-eids (set (map :e insts))\n   125\t            seg (segment code)]\n   126\t        (is (= root (:yin.code/derived-from seg)))\n   127\t        (doseq [inst insts]\n   128\t          (is (= (:e seg) (:yin.code/segment inst)))\n   129\t          (doseq [attr [:yin.code/target :yin.code/body]\n   130\t                  :when (contains? inst attr)]\n   131\t            (is (contains? inst-eids (get inst attr))\n   132\t                (str attr \" at pc \" (:yin.code/pc inst))))\n   133\t          (is (contains? ast-nodes (:yin.code/source inst))\n   134\t              (str \"source at pc \" (:yin.code/pc inst))))\n   135\t        (is (empty? (filter (set (map first ast-datoms))\n   136\t                            (conj inst-eids (:e seg))))\n   137\t            \"code tempids do not collide with AST entities\")))))\n   138\t\n   139\t\n   140\t(deftest every-instruction-has-a-source\n   141\t  (doseq [[label ast] corpus]\n   142\t    (testing label\n   143\t      (let [code (:code (lowered ast))]\n   144\t        (is (every? #(contains? % :yin.code/source) (instructions code)))))))\n   145\t\n   146\t\n   147\t(deftest worked-example-matches-the-design\n   148\t  (let [{:keys [ast-datoms code]} (lowered worked-example)\n   149\t        insts (instructions code)\n   150\t        pc-of (into {} (map (juxt :e :yin.code/pc) insts))\n   151\t        types (into {} (keep #(when (= :yin/type (second %)) [(first %) (nth % 2)])\n   152\t                             ast-datoms))]\n   153\t    (is (= [:closure :push :const :push :call :halt\n   154\t            :var :push :var :push :const :push :call :return]\n   155\t           (map :yin.code/op insts)))\n   156\t    (is (= 6 (pc-of (:yin.code/body (nth insts 0)))))\n   157\t    (is (= '[x] (:yin.code/params (nth insts 0))))\n   158\t    (is (= [10 1] [(:yin.code/value (nth insts 2)) (:yin.code/value (nth insts 10))]))\n   159\t    (is (= ['+ 'x] [(:yin.code/name (nth insts 6)) (:yin.code/name (nth insts 8))]))\n   160\t    (is (= [1 false] ((juxt :yin.code/argc :yin.code/tail?) (nth insts 4))))\n   161\t    (is (= [2 true] ((juxt :yin.code/argc :yin.code/tail?) (nth insts 12))))\n   162\t    (is (= :application (types (:yin.code/source (nth insts 4)))))\n   163\t    (is (= :lambda (types (:yin.code/source (nth insts 13)))))))\n   164\t\n   165\t\n   166\t(deftest if-lowers-to-branch-and-jump\n   167\t  (let [insts (instructions (linearize/lower-ast\n   168\t                              (if-node (lit true) (lit :yes) (lit :no))))\n   169\t        pc-of (into {} (map (juxt :e :yin.code/pc) insts))]\n   170\t    (is (= [:const :branch-false :const :jump :const :halt]\n   171\t           (map :yin.code/op insts)))\n   172\t    (is (= 4 (pc-of (:yin.code/target (nth insts 1)))) \"else label\")\n   173\t    (is (= 5 (pc-of (:yin.code/target (nth insts 3)))) \"end label\")))\n   174\t\n   175\t\n   176\t(deftest options-set-t-and-segment-id\n   177\t  (let [code (linearize/lower-ast (lit 1) {:t 7, :id-start -500})]\n   178\t    (is (every? #(= 7 (nth % 3)) code))\n   179\t    (is (= -500 (:e (segment code))))\n   180\t    (is (= [-501 -502] (map :e (instructions code))))))\n   181\t\n   182\t\n   183\t(deftest unsupported-nodes-are-rejected-naming-the-node\n   184\t  (testing \"from an AST map, nested anywhere\"\n   185\t    (doseq [type [:vm/store-update :yin/macro-expand]]\n   186\t      (let [bad {:type type, :key 'k}\n   187\t            e (try (linearize/lower-ast (app (lam '[x] (v 'x)) bad))\n   188\t                   nil\n   189\t                   (catch #?(:cljd Object :clj Exception :cljs :default) e e))]\n   190\t        (is (some? e))\n   191\t        (is (= type (:type (ex-data e))))\n   192\t        (is (= bad (:node (ex-data e)))))))\n   193\t  (testing \"from AST datoms, naming the entity\"\n   194\t    (doseq [type [:vm/store-update :yin/macro-expand]]\n   195\t      (let [datoms [[-20 :yin/type type 0 :db/add]\n   196\t                    [-21 :yin/type :application 0 :db/add]\n   197\t                    [-21 :yin/operator -20 0 :db/add]\n   198\t                    [-21 :yin/operands [] 0 :db/add]\n   199\t                    [-21 :yin/root true 0 :db/add]]\n   200\t            e (try (linearize/lower datoms)\n   201\t                   nil\n   202\t                   (catch #?(:cljd Object :clj Exception :cljs :default) e e))]\n   203\t        (is (= {:type type, :node -20} (ex-data e))))))\n   204\t  (testing \"an unknown or missing node type\"\n   205\t    (let [e (try (linearize/lower [[-20 :yin/root true 0 :db/add]\n   206\t                                   [-20 :yin/type :no/such 0 :db/add]])\n   207\t                 nil\n   208\t                 (catch #?(:cljd Object :clj Exception :cljs :default) e e))]\n   209\t      (is (= {:type :no/such, :node -20} (ex-data e))))))\n   210\t\n   211\t\n   212\t(deftest ast-loader-lowers-before-loading\n   213\t  (let [ast-datoms (vm/ast->datoms worked-example)\n   214\t        load (linearize/ast-loader (fn [vm code-datoms] (assoc vm :code code-datoms)))]\n   215\t    (is (= (linearize/lower ast-datoms) (:code (load {} ast-datoms))))))\n   216\t\n   217\t\n   218\t;; =============================================================================\n   219\t;; Evaluation order against the walker\n   220\t;; =============================================================================\n   221\t\n   222\t(defn- run-lowered\n   223\t  \"A reference reading of the §4.2 core transitions over a lowered segment:\n   224\t   const var closure push call return jump branch-false halt, with\n   225\t   `:vm/store-put` effects applied to the store. It exists to check the\n   226\t   lowering's evaluation order, not to stand in for the semantic VM.\"\n   227\t  [code-datoms primitives]\n   228\t  (let [insts (instructions code-datoms)\n   229\t        pc-of (into {} (map (juxt :e :yin.code/pc) insts))\n   230\t        image (mapv #(cond-> %\n   231\t                       (:yin.code/target %) (update :yin.code/target pc-of)\n   232\t                       (:yin.code/body %) (update :yin.code/body pc-of))\n   233\t                    insts)]\n   234\t    (loop [pc 0\n   235\t           val nil\n   236\t           st []\n   237\t           env {}\n   238\t           store {}\n   239\t           k []]\n   240\t      (let [i (nth image pc)]\n   241\t        (case (:yin.code/op i)\n   242\t          :const (recur (inc pc) (:yin.code/value i) st env store k)\n   243\t          :var (let [s (:yin.code/name i)\n   244\t                     x (cond (contains? env s) (get env s)\n   245\t                             (contains? store s) (get store s)\n   246\t                             :else (get primitives s))]\n   247\t                 (recur (inc pc) x st env store k))\n   248\t          :closure (recur (inc pc)\n   249\t                          {:type :closure,\n   250\t                           :params (:yin.code/params i),\n   251\t                           :entry (:yin.code/body i),\n   252\t                           :env env}\n   253\t                          st env store k)\n   254\t          :push (recur (inc pc) val (conj st val) env store k)\n   255\t          :jump (recur (:yin.code/target i) val st env store k)\n   256\t          :branch-false (recur (if val (inc pc) (:yin.code/target i)) val st env store k)\n   257\t          :call (let [base (- (count st) (:yin.code/argc i) 1)\n   258\t                      f (nth st base)\n   259\t                      args (subvec st (inc base))\n   260\t                      st' (subvec st 0 base)]\n   261\t                  (if (and (map? f) (= :closure (:type f)))\n   262\t                    (recur (:entry f)\n   263\t                           val\n   264\t                           st'\n   265\t                           (merge (:env f) (zipmap (:params f) args))\n   266\t                           store\n   267\t                           (if (:yin.code/tail? i)\n   268\t                             k\n   269\t                             (conj k {:pc (inc pc), :env env, :base base})))\n   270\t                    (let [r (apply f args)]\n   271\t                      (if (and (map? r) (= :vm/store-put (:effect r)))\n   272\t                        (recur (inc pc) (:val r) st' env (assoc store (:key r) (:val r)) k)\n   273\t                        (recur (inc pc) r st' env store k)))))\n   274\t          :return (if-let [frame (peek k)]\n   275\t                    (recur (:pc frame) val (subvec st 0 (:base frame)) (:env frame)\n   276\t                           store (pop k))\n   277\t                    val)\n   278\t          :halt val)))))\n   279\t\n   280\t\n   281\t(defn- recording-primitives\n   282\t  [log]\n   283\t  (assoc vm/primitives\n   284\t         'yin/def (fn [key val]\n   285\t                    (swap! log conj [key val])\n   286\t                    {:effect :vm/store-put, :key key, :val val})))\n   287\t\n   288\t\n   289\t(def ^:private def-program\n   290\t  \"`yin/def` side effects in operator position, in operands, in an `if` test\n   291\t   and both arms, in a closure body run later, in a tail call, and read back\n   292\t   through the store.\"\n   293\t  (app (if-node (def! 'pick true)\n   294\t                (lam '[f x]\n   295\t                     (tail (app (v 'f)\n   296\t                                (def! 'c (v 'x))\n   297\t                                (def! 'd (app (v '+) (v 'b) (lit 1))))))\n   298\t                (lam '[f x] (def! 'never 0)))\n   299\t       (lam '[p q]\n   300\t            (if-node (def! 'e false)\n   301\t                     (def! 'never (v 'q))\n   302\t                     (tail (app (v '+)\n   303\t                                (def! 'f (v 'p))\n   304\t                                (def! 'g (app (v '*) (v 'q) (lit 2)))))))\n   305\t       (def! 'b (app (v '+) (def! 'a 1) (def! 'a 2)))))\n   306\t\n   307\t\n   308\t(deftest evaluation-order-matches-the-walker\n   309\t  (let [walker-log (atom [])\n   310\t        walker (vm/eval (test-utils/create-vm {:primitives (recording-primitives\n   311\t                                                             walker-log)})\n   312\t                        def-program)\n   313\t        lowered-log (atom [])\n   314\t        result (run-lowered (linearize/lower-ast def-program)\n   315\t                            (recording-primitives lowered-log))]\n   316\t    (is (= '[[pick true] [a 1] [a 2] [b 3] [c 3] [d 4] [e false] [f 3] [g 8]]\n   317\t           @walker-log)\n   318\t        \"the walker's order is the reference\")\n   319\t    (is (= @walker-log @lowered-log))\n   320\t    (is (= (vm/value walker) result 11))))\n","exit_code":0,"status":"completed"}}
