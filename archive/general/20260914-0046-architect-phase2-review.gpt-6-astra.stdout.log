{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/vm/linearize.cljc'","aggregated_output":"     1\t(ns yin.vm.linearize\n     2\t  \"Lowering: Universal AST datoms (`:yin/*`) → linear executable datoms\n     3\t   (`:yin.code/*`), per `docs/design/yin.vm.semantic.md` §5.\n     4\t\n     5\t   Lowering is VM lineage and knows no surface syntax. It is a recursive\n     6\t   descent in the walker's evaluation order (operator, then operands left to\n     7\t   right), emitting the main sequence first and lambda bodies out of line\n     8\t   after it. Labels are symbolic while emitting and are resolved to\n     9\t   instruction refs in a second pass: the output carries refs, never pc\n    10\t   integers.\n    11\t\n    12\t   Lowering reads the AST datom index directly rather than reconstructing\n    13\t   maps, because every instruction names the AST entity it came from in\n    14\t   `:yin.code/source` and reconstructed maps have no entities.\"\n    15\t  (:require [dao.datom :as datom]\n    16\t            [yin.vm :as vm]))\n    17\t\n    18\t\n    19\t(def unsupported\n    20\t  \"Node types outside both evaluators' supported corpus (§2.4), rejected at\n    21\t   lowering with an error naming the node.\"\n    22\t  #{:yin/macro-expand :vm/store-update})\n    23\t\n    24\t\n    25\t(def ^:private label-attrs\n    26\t  \"Operand attributes whose emitted value is a label, resolved to the\n    27\t   instruction entity at that label's pc.\"\n    28\t  #{:yin.code/target :yin.code/body})\n    29\t\n    30\t\n    31\t(defn- reject-unsupported!\n    32\t  [type node]\n    33\t  (when (contains? unsupported type)\n    34\t    (throw (ex-info (str \"Cannot lower unsupported node \" type)\n    35\t                    {:type type, :node node}))))\n    36\t\n    37\t\n    38\t(defn- flatten-program\n    39\t  \"The §5.3 flattening from `root`. Returns `[code labels]`: `code` is a\n    40\t   vector of `{:op :source :operands [[attr v] ..]}` in pc order, and `labels`\n    41\t   maps each label to the pc it marks.\"\n    42\t  [get-attr root]\n    43\t  (let [code (atom [])\n    44\t        labels (atom {})\n    45\t        bodies (atom [])\n    46\t        label-count (atom 0)\n    47\t        fresh! #(swap! label-count inc)\n    48\t        mark! (fn [l] (swap! labels assoc l (count @code)))\n    49\t        emit! (fn [source op & operands]\n    50\t                (swap! code conj\n    51\t                       {:op op, :source source, :operands (partition 2 operands)}))]\n    52\t    (letfn\n    53\t      [(lower-node\n    54\t         [e]\n    55\t         (let [type (get-attr e :yin/type)]\n    56\t           (reject-unsupported! type e)\n    57\t           (case type\n    58\t             :literal (emit! e :const :yin.code/value (get-attr e :yin/value))\n    59\t             :variable (emit! e :var :yin.code/name (get-attr e :yin/name))\n    60\t             :lambda (let [l (fresh!)]\n    61\t                       (swap! bodies conj [l e (get-attr e :yin/body)])\n    62\t                       (emit! e :closure\n    63\t                              :yin.code/params (get-attr e :yin/params)\n    64\t                              :yin.code/body l))\n    65\t             :application (let [operands (get-attr e :yin/operands)]\n    66\t                            (lower-node (get-attr e :yin/operator))\n    67\t                            (emit! e :push)\n    68\t                            (doseq [o operands]\n    69\t                              (lower-node o)\n    70\t                              (emit! e :push))\n    71\t                            (emit! e :call\n    72\t                                   :yin.code/argc (count operands)\n    73\t                                   :yin.code/tail? (boolean\n    74\t                                                     (get-attr e :yin/tail?))))\n    75\t             :if (let [else (fresh!)\n    76\t                       end (fresh!)]\n    77\t                   (lower-node (get-attr e :yin/test))\n    78\t                   (emit! e :branch-false :yin.code/target else)\n    79\t                   (lower-node (get-attr e :yin/consequent))\n    80\t                   (emit! e :jump :yin.code/target end)\n    81\t                   (mark! else)\n    82\t                   (lower-node (get-attr e :yin/alternate))\n    83\t                   (mark! end))\n    84\t             :dao.stream.apply/call (let [operands (get-attr e :yin/operands)]\n    85\t                                      (doseq [o operands]\n    86\t                                        (lower-node o)\n    87\t                                        (emit! e :push))\n    88\t                                      (emit! e :ffi-call\n    89\t                                             :yin.code/ffi-op (get-attr e :yin/op)\n    90\t                                             :yin.code/argc (count operands)))\n    91\t             :stream/make (emit! e :stream-make\n    92\t                                 :yin.code/buffer (get-attr e :yin/buffer))\n    93\t             :stream/put (do (lower-node (get-attr e :yin/target))\n    94\t                             (emit! e :push)\n    95\t                             (lower-node (get-attr e :yin/val-node))\n    96\t                             (emit! e :stream-put))\n    97\t             :stream/cursor (do (lower-node (get-attr e :yin/source))\n    98\t                                (emit! e :stream-cursor))\n    99\t             :stream/next (do (lower-node (get-attr e :yin/source))\n   100\t                              (emit! e :stream-next))\n   101\t             :stream/close (do (lower-node (get-attr e :yin/source))\n   102\t                               (emit! e :stream-close))\n   103\t             :vm/gensym (emit! e :gensym :yin.code/prefix (get-attr e :yin/prefix))\n   104\t             :vm/store-get (emit! e :store-get :yin.code/key (get-attr e :yin/key))\n   105\t             :vm/store-put (emit! e :store-put\n   106\t                                  :yin.code/key (get-attr e :yin/key)\n   107\t                                  :yin.code/value (get-attr e :yin/value))\n   108\t             :vm/park (emit! e :park)\n   109\t             :vm/current-continuation (emit! e :current-continuation)\n   110\t             :vm/resume (do (lower-node (get-attr e :yin/val-node))\n   111\t                            (emit! e :resume\n   112\t                                   :yin.code/parked-id (get-attr e :yin/parked-id)))\n   113\t             (throw (ex-info (str \"Cannot lower node of type \" type)\n   114\t                             {:type type, :node e})))))]\n   115\t      (lower-node root)\n   116\t      (emit! root :halt)\n   117\t      ;; A body may hold lambdas of its own, which append to `bodies` while\n   118\t      ;; this loop runs.\n   119\t      (loop [i 0]\n   120\t        (when-let [[l lambda body] (get @bodies i)]\n   121\t          (mark! l)\n   122\t          (lower-node body)\n   123\t          (emit! lambda :return)\n   124\t          (recur (inc i))))\n   125\t      [@code @labels])))\n   126\t\n   127\t\n   128\t(defn lower\n   129\t  \"Lower one AST program, as `[e a v t m]` datoms, to one code segment.\n   130\t\n   131\t   Options:\n   132\t     :t        transaction id (default 0)\n   133\t     :id-start the segment tempid; instruction pc n is `id-start - 1 - n`.\n   134\t               Defaults to below every entity id in the input, so the code\n   135\t               and its AST can travel in one batch without colliding.\n   136\t\n   137\t   Throws naming the node on an unsupported, unknown, or missing node type.\"\n   138\t  ([datoms] (lower datoms {}))\n   139\t  ([datoms opts]\n   140\t   (let [datoms (vec datoms)\n   141\t         {:keys [get-attr root-id error]} (vm/index-datoms datoms)\n   142\t         _ (when error\n   143\t             (throw (ex-info \"Cannot lower a program with a dangling root\" error)))\n   144\t         _ (when (nil? root-id)\n   145\t             (throw (ex-info \"Cannot lower a program with no root\" {})))\n   146\t         [code labels] (flatten-program get-attr root-id)\n   147\t         seg (or (:id-start opts)\n   148\t                 (dec (reduce min (- datom/first-user-id) (map first datoms))))\n   149\t         pc->eid #(- seg 1 %)\n   150\t         t (or (:t opts) 0)\n   151\t         m datom/default-op]\n   152\t     (into [[seg :yin.code/type :segment t m]\n   153\t            [seg :yin.code/length (count code) t m]\n   154\t            [seg :yin.code/derived-from root-id t m]]\n   155\t           (mapcat (fn [pc {:keys [op source operands]}]\n   156\t                     (let [e (pc->eid pc)]\n   157\t                       (concat [[e :yin.code/segment seg t m]\n   158\t                                [e :yin.code/pc pc t m]\n   159\t                                [e :yin.code/op op t m]]\n   160\t                               (map (fn [[a v]]\n   161\t                                      [e a\n   162\t                                       (if (contains? label-attrs a)\n   163\t                                         (pc->eid (get labels v))\n   164\t                                         v)\n   165\t                                       t m])\n   166\t                                    operands)\n   167\t                               [[e :yin.code/source source t m]])))\n   168\t                   (range)\n   169\t                   code)))))\n   170\t\n   171\t\n   172\t(defn lower-ast\n   173\t  \"`lower` ∘ `yin.vm/ast->datoms`. Unsupported nodes are rejected here\n   174\t   first, because `ast->datoms` cannot represent them.\"\n   175\t  ([ast] (lower-ast ast {}))\n   176\t  ([ast opts]\n   177\t   (when-let [node (some #(when (and (map? %) (contains? unsupported (:type %)))\n   178\t                            %)\n   179\t                         (tree-seq coll? seq ast))]\n   180\t     (reject-unsupported! (:type node) node))\n   181\t   (lower (vm/ast->datoms ast (select-keys opts [:t])) opts)))\n   182\t\n   183\t\n   184\t(defn ast-loader\n   185\t  \"Adapt a code loader `(fn [vm code-datoms])` into one for a program stream\n   186\t   carrying AST datoms: §3.1's `(comp vm-load-program lower)` for a binary\n   187\t   loader. The composition makes this choice; no evaluator learns which form\n   188\t   travels.\"\n   189\t  [load-program]\n   190\t  (fn [vm datoms] (load-program vm (lower datoms))))\n","exit_code":0,"status":"completed"}}
