world-srvm-p5c                                 290c4476 [srvm-phase5c]\n/Users/sto/workspace/datomworld-srvm-p6-design                           9494e995 [srvm-phase6-design]\n/Users/sto/workspace/datomworld-srvm-p6a                                 d77da9f0 [srvm-phase6a]\n/Users/sto/workspace/datomworld-srvm-p6cpre                              7e1f1e89 [srvm-phase6cpre]\n/Users/sto/workspace/datomworld-srvm-tiers                               a7f16ee3 [tiers-slow-tags]\n/Users/sto/workspace/datomworld/.claude/worktrees/dao-star-orch          73b213a9 [worktree-dao-star-orch]\n/Users/sto/workspace/datomworld/.claude/worktrees/docs-lane-rule         5504e5f6 [worktree-docs-lane-rule]\n/Users/sto/workspace/datomworld/.claude/worktrees/docs-shiva-tests       3486efdb [worktree-docs-shiva-tests]\n/Users/sto/workspace/datomworld/.claude/worktrees/glossary-cursor-cell   f3cd0a58 [worktree-glossary-cursor-cell]\n/Users/sto/workspace/datomworld/.claude/worktrees/invariant-unitarity    398e5fe1 [worktree-invariant-unitarity]\n/Users/sto/workspace/datomworld/.claude/worktrees/orchestrator-log-2     cb87dc52 [worktree-orchestrator-log-2]\n/Users/sto/workspace/datomworld/.claude/worktrees/orchestrator-log-srvm  6b6db987 [worktree-orchestrator-log-srvm]\n/Users/sto/workspace/datomworld/.claude/worktrees/ucf-blog-cross-vm      d21ee43f [semantic-register-vm]\n","exit_code":0,"status":"completed"}}
