{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'nl -ba collab/numbering-probe/src/probe/discovery.clj | head -460'","aggregated_output":"     1\t(ns probe.discovery\n     2\t  \"Prototype of discovery-order cursor-cell numbering, the BASE design of the\n     3\t   note of 2026-10-12 (round 4), over the 6a abstract task representation\n     4\t   (yin.vm.ucf.rows). Not repo code; a scratch project under collab/. The\n     5\t   round-3 variants (components, residue search) live in probe.discovery-r3.\n     6\t\n     7\t   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n     8\t   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n     9\t\n    10\t   The rule. A cursor cell gets the next number the first time the walk meets\n    11\t   it. The walk is pre-order over the task in table order. A guest :set or\n    12\t   :map is turned into a vector of its members (a map entry as [:entry k v])\n    13\t   sorted by KEY: the spelling of a local walk over the member under the\n    14\t   current numbering, with numbered cells spelled by number and unnumbered\n    15\t   ones by local first-occurrence index, body rank and occurrence count.\n    16\t   Members whose keys tie are POSTPONED to the run's queue and re-keyed after\n    17\t   the rest of the walk, until a pass numbers nothing. A remaining tie group\n    18\t   is entered in listed order when the TIE TEST holds (common key complete;\n    19\t   the members' unnumbered cells pairwise disjoint and occurring in no member\n    20\t   of another remaining group); otherwise the root walk refuses\n    21\t   :yin.k/non-portable :unresolved-cursor-cells and a key walk spells the\n    22\t   group as [:tie K ... K] in its key.\n    23\t\n    24\t   Budgets: :cursor-cells (census size, first), :depth (nesting of the walk),\n    25\t   :work (one unit per position visited or spelled, plus 6a's representation\n    26\t   bound of every value before it is CBOR-encoded for a comparison). Exceeding\n    27\t   one is :yin.k/unsupported :resource-limit, never a canonicality verdict.\n    28\t\n    29\t   Diagnostic switches (*numbering-opts*): :permissive enters a failing group\n    30\t   in listed order instead of refusing (used to test interchangeability by\n    31\t   exhaustion or sampling); :count-spelling false drops the occurrence count\n    32\t   from the key (the owner's literal direction, for measurement).\"\n    33\t  (:require [clojure.set :as set]\n    34\t            [dao.jing :as jing]\n    35\t            [dao.jing.cbor :as cbor]\n    36\t            [yin.vm.ucf.rows :as rows]\n    37\t            [yin.vm.ucf.rows-test :as rt]\n    38\t            [yin.vm.semantic-register.frame-test :as ft]))\n    39\t\n    40\t;; ---------------------------------------------------------------- schema\n    41\t\n    42\t(def synthetic-table\n    43\t  \"The one row that exists only inside the procedure: a :map entry as an\n    44\t   ordered pair, so the alias pattern across key and value is in its key.\"\n    45\t  {:entry [:V :V]})\n    46\t\n    47\t(defn descriptors [kind slots]\n    48\t  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n    49\t    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n    50\t          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n    51\t          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n    52\t          :else schema)))\n    53\t\n    54\t(defn ref? [d] (and (vector? d) (= :ref (first d))))\n    55\t(defn refs? [d] (and (vector? d) (= :refs (first d))))\n    56\t(defn v? [d] (contains? #{:V :optional-V} d))\n    57\t\n    58\t(defn bytes-key\n    59\t  \"Uncharged encoding; generators and diagnostics only.\"\n    60\t  [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n    61\t\n    62\t(defn compare-bytes [a b]\n    63\t  (loop [i 0]\n    64\t    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n    65\t          (= i (count b)) 1\n    66\t          (= (nth a i) (nth b i)) (recur (inc i))\n    67\t          :else (compare (nth a i) (nth b i)))))\n    68\t\n    69\t(def keyed-structural #{:bindings :store :parked-table})\n    70\t\n    71\t(defn elem-item\n    72\t  \"The item a member is keyed and entered as: a :set member is its V; a :map\n    73\t   entry [k v] is the synthetic ordered row [:entry k v].\"\n    74\t  [kind e]\n    75\t  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n    76\t\n    77\t(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n    78\t\n    79\t;; --------------------------------------------------------------- budgets\n    80\t\n    81\t(def default-budget\n    82\t  \"6a's budget without :label-bytes and :search; :work now also counts\n    83\t   representation bytes, so its default takes over :label-bytes' scale.\"\n    84\t  (assoc (dissoc rows/default-budget :label-bytes :search) :work 4194304))\n    85\t\n    86\t(defn- limit! [category]\n    87\t  (throw (ex-info \"resource limit\"\n    88\t                  {:yin.k/status :yin.k/unsupported :yin.k/kind :resource-limit :yin.k/path [category]})))\n    89\t\n    90\t(defn- spend! [ctx category amount]\n    91\t  (let [n (get (swap! (:counter ctx) update category (fnil + 0) amount) category)]\n    92\t    (when (> n (get (:budget ctx) category)) (limit! category))))\n    93\t\n    94\t(defn- rep-bound\n    95\t  \"6a's conservative representation bound (check-label-bytes!): an upper\n    96\t   bound of the CBOR bytes of x, computed by reading x and allocating nothing.\"\n    97\t  [x]\n    98\t  (let [n (cond (cbor/byte-payload? x) (+ 16 (alength ^bytes x))\n    99\t                (string? x) (+ 128 (* 4 (count x)))\n   100\t                (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n   101\t                (coll? x) (reduce (fn [t v] (+ t (rep-bound v))) 128 (if (map? x) (mapcat identity x) x))\n   102\t                :else 128)]\n   103\t    (if (meta x) (+ n (rep-bound (meta x))) n)))\n   104\t\n   105\t(defn- key-bytes!\n   106\t  \"Charge the representation bound of x to :work, then encode x for comparison.\n   107\t   Every encoding the procedure makes goes through here.\"\n   108\t  [ctx x]\n   109\t  (spend! ctx :work (rep-bound x))\n   110\t  (let [bs (bytes-key x)]\n   111\t    (swap! (:counter ctx) update :encoded-bytes (fnil + 0) (count bs))\n   112\t    bs))\n   113\t\n   114\t(defn- sort-by-key!\n   115\t  \"xs in the bytewise order of (f x), each encoded once (stable).\"\n   116\t  [ctx f xs]\n   117\t  (mapv second (sort #(compare-bytes (first %1) (first %2)) (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n   118\t\n   119\t;; ------------------------------------------------------------ cell scans\n   120\t\n   121\t(defn- walk-cells\n   122\t  \"Call f on every cursor cell at a position under slot (d x); census and\n   123\t   install children excluded; one :work unit per position.\"\n   124\t  [ctx d x f]\n   125\t  (letfn [(slot [d x]\n   126\t            (spend! ctx :work 1)\n   127\t            (cond (ref? d) (node x)\n   128\t                  (refs? d) (run! node x)\n   129\t                  (= :C d) (f x)\n   130\t                  (v? d) (when x (case (first x) :cursor-cell (f (second x)) :row (node (second x)) nil))\n   131\t                  :else nil))\n   132\t          (node [n]\n   133\t            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n   134\t              (dorun (map slot (descriptors (:kind n) (:slots n)) (:slots n)))))]\n   135\t    (slot d x)))\n   136\t\n   137\t(defn item-cells\n   138\t  \"The cursor cells under slot (d x), memoized per procedure on the slot value.\"\n   139\t  [ctx d x]\n   140\t  (or (get @(:cells-memo ctx) [d x])\n   141\t      (let [acc (atom #{})]\n   142\t        (walk-cells ctx d x #(swap! acc conj %))\n   143\t        (swap! (:cells-memo ctx) assoc [d x] @acc)\n   144\t        @acc)))\n   145\t\n   146\t(defn- occurrence-counts\n   147\t  \"Cursor cell -> number of positions of the task holding it.\"\n   148\t  [ctx task]\n   149\t  (let [acc (atom {})]\n   150\t    (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n   151\t    @acc))\n   152\t\n   153\t(defn body-label [body]\n   154\t  (let [[stream position] (:slots body)]\n   155\t    [:body (into [:stream] (:slots stream)) position]))\n   156\t\n   157\t(defn- body-ranks\n   158\t  \"Cursor cell -> rank of its body label among the census's distinct body\n   159\t   labels in bytewise order (rank order = label order, so keys stay\n   160\t   independent of the descriptor's size).\"\n   161\t  [ctx bodies]\n   162\t  (let [labels (into {} (map (fn [[c b]] [c (body-label b)])) bodies)\n   163\t        ranks (into {} (map-indexed (fn [i l] [l i])) (sort-by-key! ctx identity (distinct (vals labels))))]\n   164\t    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n   165\t\n   166\t;; ------------------------------------------------------------------ runs\n   167\t\n   168\t(def ^:dynamic *trace* false)\n   169\t\n   170\t(defn- new-run [ctx num tag next]\n   171\t  {:ctx ctx :num (atom num) :tag tag :next (atom next) :groups (atom []) :gid (atom 0) :refused (atom nil)})\n   172\t\n   173\t(defn- meet!\n   174\t  \"W2. A cursor cell met for the first time receives the run's next number.\"\n   175\t  [run c]\n   176\t  (when-not (contains? @(:num run) c)\n   177\t    (let [k @(:next run)]\n   178\t      (swap! (:num run) assoc c [(:tag run) k])\n   179\t      (swap! (:next run) inc)\n   180\t      true)))\n   181\t\n   182\t(declare enter-node! unordered! local-run spell-slot spell-node)\n   183\t\n   184\t(defn- enter-slot! [run d x path]\n   185\t  (let [ctx (:ctx run)]\n   186\t    (spend! ctx :work 1)\n   187\t    (when (> (count path) (get (:budget ctx) :depth)) (limit! :depth))\n   188\t    (cond (ref? d) (enter-node! run x path)\n   189\t          (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n   190\t          (= :C d) (meet! run x)\n   191\t          (v? d) (when x (case (first x)\n   192\t                           :cursor-cell (meet! run (second x))\n   193\t                           :row (enter-node! run (second x) path)\n   194\t                           nil))\n   195\t          :else nil)))\n   196\t\n   197\t(defn- enter-node!\n   198\t  \"W1. Pre-order: table order for slots; ordered repeated slots in order;\n   199\t   keyed structural rows in the byte order of the key; :window in register\n   200\t   order; installs and module stores by name; :set and :map by keys with\n   201\t   ties postponed; census and children not entered.\"\n   202\t  [run n path]\n   203\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n   204\t    (cond\n   205\t      (= :cursor-cells kind) nil\n   206\t      (child-task? ctx n) nil\n   207\t      (= :task kind)\n   208\t      (doseq [[i d x] (map vector (range) ds slots)]\n   209\t        (if (contains? #{7 12} i)\n   210\t          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n   211\t            (enter-node! run child (conj path i (first (:slots child)))))\n   212\t          (enter-slot! run d x (conj path i))))\n   213\t      (contains? keyed-structural kind)\n   214\t      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n   215\t        (enter-slot! run (second ds) v (conj path k)))\n   216\t      (= :window kind)\n   217\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n   218\t      (= :set kind) (unordered! run n :set (vec slots) path)\n   219\t      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n   220\t      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n   221\t\n   222\t(defn- unordered!\n   223\t  \"The transformation: key every member by a local walk under the numbering\n   224\t   at this moment; members with a unique key are entered in key order; a run\n   225\t   of equal keys is one tie group, postponed to the run's queue (postponement\n   226\t   order: containers in walk order, groups within a container in key order).\n   227\t   A member's path is the container's path plus :member (there is no\n   228\t   canonical index into an unordered container); a group remembers its\n   229\t   container by identity.\"\n   230\t  [run container kind elems path]\n   231\t  (let [keyed (mapv (fn [e] [(local-run run (elem-item kind e) (conj path :member)) e]) elems)\n   232\t        groups (partition-by (comp :bytes first) (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n   233\t    (when (and *trace* (= :n (:tag run)))\n   234\t      (println \"  [sort]\" path \"num\" @(:num run))\n   235\t      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"POSTPONE\") (mapv (fn [[r e]] [e (:spell r)]) g))))\n   236\t    (doseq [g groups]\n   237\t      (if (= 1 (count g))\n   238\t        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n   239\t        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n   240\t                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n   241\t                                   :elems (mapv second g)})))))\n   242\t\n   243\t(defn- fixpoint!\n   244\t  \"W3. Re-examine every postponed group in order under the current numbering;\n   245\t   repeat while a pass numbers a cursor cell and groups remain.\"\n   246\t  [run]\n   247\t  (loop []\n   248\t    (let [before (count @(:num run)) groups @(:groups run)]\n   249\t      (reset! (:groups run) [])\n   250\t      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n   251\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n   252\t\n   253\t(defn- unnumbered-cells [run kind e]\n   254\t  (let [num @(:num run)]\n   255\t    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n   256\t\n   257\t(defn- group-failure\n   258\t  \"T, the tie test. nil when the group's members are interchangeable: the\n   259\t   common key is complete, and the members' unnumbered cursor cells are\n   260\t   pairwise disjoint and occur in no member of another remaining group.\n   261\t   Otherwise the reason.\"\n   262\t  [run groups g]\n   263\t  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n   264\t        others (reduce into #{} (for [h groups :when (not= (:id h) (:id g)) e (:elems h)]\n   265\t                                  (unnumbered-cells run (:kind h) e)))]\n   266\t    (cond (not (:complete? g)) :incomplete-key\n   267\t          (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n   268\t          (some #(seq (set/intersection % others)) own) :shared-across-groups\n   269\t          :else nil)))\n   270\t\n   271\t(defn- resolve!\n   272\t  \"Postponed groups to completion: fixpoint, then the tie test on every\n   273\t   remaining group; all pass: enter them in listed order and repeat; any\n   274\t   fails: the root run refuses, a key run leaves them as residue.\"\n   275\t  [run]\n   276\t  (loop []\n   277\t    (fixpoint! run)\n   278\t    (let [groups @(:groups run) ctx (:ctx run)]\n   279\t      (when (seq groups)\n   280\t        (let [failing (vec (keep (fn [g] (when-let [why (group-failure run groups g)] (assoc g :why why))) groups))]\n   281\t          (when (and *trace* (= :n (:tag run)))\n   282\t            (println \"  [ties]\" (mapv (fn [g] [(:id g) (:path g) (:elems g) (:why g)]) (map #(assoc % :why (group-failure run groups %)) groups))))\n   283\t          (cond\n   284\t            (empty? failing)\n   285\t            ;; Interchangeable groups are independent of each other (their\n   286\t            ;; cells are confined), so all are entered before the next pass.\n   287\t            (do (reset! (:groups run) [])\n   288\t                (doseq [g groups e (:elems g)] (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n   289\t                (recur))\n   290\t            (:permissive ctx)\n   291\t            ;; Diagnostic only: enter the first group in listed order, then\n   292\t            ;; re-key the rest (what an unsound \"equal keys, host order\" rule does).\n   293\t            (do (reset! (:groups run) (vec (rest groups)))\n   294\t                (doseq [e (:elems (first groups))] (enter-slot! run :V (elem-item (:kind (first groups)) e) (conj (:path (first groups)) :member)))\n   295\t                (recur))\n   296\t            (= :n (:tag run))\n   297\t            (reset! (:refused run)\n   298\t                    {:kind :unresolved-cursor-cells\n   299\t                     :path (:path (first failing))\n   300\t                     :why (mapv :why failing)\n   301\t                     :cursor-cells (vec (sort (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g))) failing))))})\n   302\t            :else nil))))))\n   303\t\n   304\t(defn- local-run\n   305\t  \"A key walk: the same procedure on one member from the enclosing run's\n   306\t   numbering, tag :u; its result is the member's key (spelling under its\n   307\t   final numbering, residue spelled [:tie K ...]) and whether it is complete.\n   308\t   Memoized on (item, numbering restricted to the item's cells, counter).\"\n   309\t  [run item path]\n   310\t  (let [ctx (:ctx run)\n   311\t        cells (item-cells ctx :V item)\n   312\t        num @(:num run)\n   313\t        start (if (= :u (:tag run)) @(:next run) 0)\n   314\t        mk [item (select-keys num cells) start]]\n   315\t    (or (get @(:memo ctx) mk)\n   316\t        (let [sub (new-run ctx num :u start)]\n   317\t          (spend! ctx :work (count cells))\n   318\t          (enter-slot! sub :V item path)\n   319\t          (resolve! sub)\n   320\t          (let [spell (spell-slot sub :V item path)\n   321\t                r {:spell spell :bytes (key-bytes! ctx spell) :complete? (empty? @(:groups sub))}]\n   322\t            (swap! (:counter ctx) update :local-runs (fnil + 0) 1)\n   323\t            (swap! (:memo ctx) assoc mk r)\n   324\t            r)))))\n   325\t\n   326\t;; -------------------------------------------------------------- spelling\n   327\t\n   328\t(defn- spell-cell [run c]\n   329\t  (let [[t k] (get @(:num run) c) ctx (:ctx run)]\n   330\t    (case t\n   331\t      :n [:cursor-cell [:n k]]\n   332\t      :u [:cursor-cell (if (:count-spelling ctx)\n   333\t                         [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]\n   334\t                         [:u k (get (:ranks ctx) c)])]\n   335\t      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n   336\t\n   337\t(defn- spell-slot [run d x path]\n   338\t  (spend! (:ctx run) :work 1)\n   339\t  (cond (ref? d) (spell-node run x path)\n   340\t        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n   341\t        (= :C d) (spell-cell run x)\n   342\t        (v? d) (if (nil? x) x\n   343\t                   (case (first x)\n   344\t                     :cursor-cell (spell-cell run (second x))\n   345\t                     :row [:row (spell-node run (second x) path)]\n   346\t                     x))\n   347\t        :else x))\n   348\t\n   349\t(defn- spell-node\n   350\t  \"The spelling of a row under the run's final numbering: literals and\n   351\t   structural data as themselves (by reference), rows expanded in place,\n   352\t   keyed rows in key order, a :set or :map as the sorted vector of its\n   353\t   members' spellings with each surviving tie group as [:tie K ...].\"\n   354\t  [run n path]\n   355\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n   356\t    (cond\n   357\t      (= :cursor-cells kind) [:cursor-cells]\n   358\t      (child-task? ctx n) [:child]\n   359\t      (= :task kind)\n   360\t      (into [kind]\n   361\t            (map-indexed (fn [i [d x]]\n   362\t                           (if (contains? #{7 12} i)\n   363\t                             (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n   364\t                             (spell-slot run d x (conj path i))))\n   365\t                         (map vector ds slots)))\n   366\t      (contains? keyed-structural kind)\n   367\t      (into [kind] (mapcat identity (sort-by-key! ctx first\n   368\t                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n   369\t                                                        (partition 2 slots)))))\n   370\t      (= :window kind)\n   371\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n   372\t      (contains? #{:set :map} kind)\n   373\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n   374\t            tied (filter #(identical? n (:container %)) @(:groups run))\n   375\t            tied-elems (set (mapcat :elems tied))\n   376\t            plain (keep (fn [e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path :member)))) elems)\n   377\t            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n   378\t        (into [kind] (sort-by-key! ctx identity (concat plain ties))))\n   379\t      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n   380\t\n   381\t;; ------------------------------------------------------------- procedure\n   382\t\n   383\t(def ^:dynamic *numbering-opts*\n   384\t  \"Options for every run of the procedure in scope (root and install\n   385\t   children): :permissive, :count-spelling, :budget.\"\n   386\t  {})\n   387\t\n   388\t(defn discovery-numbering\n   389\t  \"Returns {:numbering {src -> :yin.k/cc-n} :used {...}} or {:refused {...}}.\n   390\t   Throws :resource-limit when a budget is exceeded, and a defect (never a\n   391\t   refusal) when the numbering is not total.\"\n   392\t  ([task] (discovery-numbering task *numbering-opts*))\n   393\t  ([task opts]\n   394\t   (let [census (nth (:slots task) 9)\n   395\t         bodies (into {} (map vec) (partition 2 (:slots census)))\n   396\t         ctx {:task task :bodies bodies\n   397\t              :memo (atom {}) :cells-memo (atom {})\n   398\t              :budget (merge default-budget (:budget opts))\n   399\t              :counter (atom {})\n   400\t              :permissive (:permissive opts)\n   401\t              :count-spelling (not= false (:count-spelling opts))}\n   402\t         _ (spend! ctx :cursor-cells (count bodies))\n   403\t         ctx (assoc ctx :ranks (body-ranks ctx bodies) :counts (occurrence-counts ctx task))\n   404\t         run (new-run ctx {} :n 1)]\n   405\t     (enter-node! run task [])\n   406\t     (resolve! run)\n   407\t     (if-let [r @(:refused run)]\n   408\t       {:refused r :used @(:counter ctx)}\n   409\t       (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n   410\t         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n   411\t         (when (not= numbered declared)\n   412\t           (throw (ex-info \"numbering is not total\" {:missing (vec (sort (remove numbered declared)))\n   413\t                                                      :extra (vec (sort (remove declared numbered)))})))\n   414\t         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))\n   415\t          :used @(:counter ctx)})))))\n   416\t\n   417\t;; --------------------------------------------------------------- emission\n   418\t;; 6a's emit-node with install children numbered by discovery order and a\n   419\t;; row path threaded for the child refusal.\n   420\t\n   421\t(def ^:private ordered-slots @#'rows/ordered-slots)\n   422\t(def ^:private check-literal-markers! @#'rows/check-literal-markers!)\n   423\t(def ^:private byte-compare @#'rows/byte-compare)\n   424\t\n   425\t(declare emit-node*)\n   426\t\n   427\t(defn- refuse-unresolved! [r path]\n   428\t  (throw (ex-info \"unresolved cursor cells\"\n   429\t                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n   430\t                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)\n   431\t                   ;; probe-only diagnostic, not part of the refusal's contract\n   432\t                   :probe/why (:why r)})))\n   433\t\n   434\t(defn- emit-slot* [d x numbering rows path]\n   435\t  (when-not (or (ref? d) (refs? d) (= :C d))\n   436\t    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n   437\t  (cond\n   438\t    (ref? d) (emit-node* x numbering rows path)\n   439\t    (refs? d) (reduce (fn [[out rs] [j n]]\n   440\t                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n   441\t                              [id rs'] (emit-node* n numbering rs p)]\n   442\t                          [(conj out id) rs']))\n   443\t                      [[] rows] (map-indexed vector x))\n   444\t    (= d :C) [(get numbering x x) rows]\n   445\t    (v? d) (case (first x)\n   446\t             :row (let [[id rs] (emit-node* (second x) numbering rows path)] [[:row id] rs])\n   447\t             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n   448\t             [x rows])\n   449\t    :else [x rows]))\n   450\t\n   451\t(defn- emit-node* [n numbering rows path]\n   452\t  (let [{:keys [kind slots]} n\n   453\t        [slots rows] (reduce (fn [[out rs] [i d x]]\n   454\t                               (if (and (ref? d) (= :task (:kind x)))\n   455\t                                 (let [r (discovery-numbering x)\n   456\t                                       _ (when (:refused r) (refuse-unresolved! (:refused r) path))\n   457\t                                       [id child-rows] (emit-node* x (:numbering r) {} [])]\n   458\t                                   [(conj out id) (merge rs child-rows)])\n   459\t                                 (let [[x' rs'] (emit-slot* d x numbering rs (conj path i))] [(conj out x') rs'])))\n   460\t                             [[] rows] (map vector (range) (descriptors kind slots) slots))\n","exit_code":0,"status":"completed"}}
