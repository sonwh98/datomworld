{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'java -cp \"$(cat .cpcache/4107430544.cp):test\" clojure.main -e '\"'(require (quote [yin.vm :as vm]) (quote [yin.vm.semantic :as s]) (quote [yin.vm.linearize :as l]) (quote [yin.vm.test-utils :as tu]) (quote [datomworld.demo.continuation-handoff-v2 :as h])) (defn fresh [] (s/create-vm {:make-stream tu/make-stream})) (let [code (l/lower-ast {:type :stream/cursor :source {:type :stream/make :buffer 4}}) mid (vm/step (s/vm-load-program (fresh) code))] (prn :stream-case :shippable (h/shippable? mid) :value (:value mid) :store-keys (keys (:store mid))) (try (let [received (h/datoms->semantic-vm (h/continuation-datoms code mid) fresh)] (prn :resumed (vm/value (vm/run received)))) (catch Exception e (prn :stream-handoff-error (ex-message e))))) (let [code (l/lower-ast {:type :literal :value 1}) mid (assoc (s/vm-load-program (fresh) code) :env {(quote x) {:yin.continuation/primitive (quote +)}}) received (h/datoms->semantic-vm (h/continuation-datoms code mid) fresh)] (prn :literal-map-before (get-in mid [:env (quote x)]) :literal-map-after-is-function (fn? (get-in received [:env (quote x)]))))'\"","aggregated_output":"Loading initial Timbre config from: :default\n#'user/fresh\n:stream-case :shippable true :value {:type :stream-ref, :id :stream-0} :store-keys (:yin/call-in :yin/call-out :yin/call-out-cursor :stream-0)\n:stream-handoff-error \"Invalid stream reference\"\n:literal-map-before #:yin.continuation{:primitive +} :literal-map-after-is-function true\n","exit_code":0,"status":"completed"}}
