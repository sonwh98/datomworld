{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"sed -n '75,100p' src/cljc/yin/vm/engine.cljc; sed -n '260,310p' src/cljc/yin/vm/linearize.cljc; head -c 350 .cpcache/4107430544.cp; rg -n 'test-runner' .cpcache/*.cp\"","aggregated_output":"  \"Returns true if the VM is blocked.\"\n  [vm]\n  (boolean (:blocked? vm)))\n\n\n(defn vm-value\n  \"Returns the current value of the VM.\"\n  [vm]\n  (:value vm))\n\n\n(defn halted-with-empty-queue?\n  \"Returns true if the VM has halted and its ready-queue is empty.\"\n  [vm]\n  (and (boolean (:halted? vm)) (empty? (or (:ready-queue vm) []))))\n\n\n(defn restore-initial-env\n  \"After eval, restore :env to initial-env when the computation halted.\n   Blocked and parked states keep the active lexical env for resumption.\"\n  [initial-env result]\n  (if (halted-with-empty-queue? result) (assoc result :env initial-env) result))\n\n\n(defn active-continuation?\n  \"Returns true when the currently active continuation should keep stepping.\"\n    (reduce-kv (fn [floor seg image]\n                 (if (and (integer? seg) (map? image))\n                   (min floor (- seg (or (:length image) 0)))\n                   floor))\n               0\n               code)\n    0))\n\n\n(defn ast-loader\n  \"Adapt a code loader `(fn [vm code-datoms])` into one for a program stream\n   carrying AST datoms: §3.1's `(comp vm-load-program lower)` for a binary\n   loader. The composition makes this choice; no evaluator learns which form\n   travels.\n\n   Successive batches on one medium are independent AST programs whose\n   tempids restart, so the default `:id-start` would hand two programs of\n   the same size one segment id, which the loader rejects as a conflict. Each\n   batch is therefore lowered below the input and below every segment the VM\n   already holds under `:code`; closures and continuations naming earlier\n   segments keep resolving.\"\n  [load-program]\n  (fn [vm datoms]\n    (let [floor (reduce min\n                        (min (- datom/first-user-id) (loaded-code-floor (:code vm)))\n                        (map first datoms))]\n      (load-program vm (lower datoms {:id-start (dec floor)})))))\ntest:src/clj:src/cljc:src/cljs:src/cljd:/Users/sto/.m2/repository/com/cognitect/transit-clj/1.0.333/transit-clj-1.0.333.jar:/Users/sto/.m2/repository/com/datomic/peer/1.0.7364/peer-1.0.7364.jar:/Users/sto/.m2/repository/criterium/criterium/0.4.6/criterium-0.4.6.jar:/Users/sto/.m2/repository/http-kit/http-kit/2.8.0/http-kit-2.8.0.jar:/Users/sto/.m2/.cpcache/3644903311.cp:1:test:src/clj:src/cljc:src/cljs:src/cljd:/Users/sto/.m2/repository/com/cognitect/transit-clj/1.0.333/transit-clj-1.0.333.jar:/Users/sto/.m2/repository/com/datomic/peer/1.0.7364/peer-1.0.7364.jar:/Users/sto/.m2/repository/criterium/criterium/0.4.6/criterium-0.4.6.jar:/Users/sto/.m2/repository/http-kit/http-kit/2.8.0/http-kit-2.8.0.jar:/Users/sto/.m2/repository/instaparse/instaparse/1.5.0/instaparse-1.5.0.jar:/Users/sto/.gitlibs/libs/io.github.cognitect-labs/test-runner/dfb30dd6605cb6c0efc275e1df1736f6e90d4d73/src:/Users/sto/.m2/repository/org/clojure/clojure/1.12.4/clojure-1.12.4.jar:/Users/sto/.m2/repository/org/clojure/core.async/1.8.741/core.async-1.8.741.jar:/Users/sto/.m2/repository/org/clojure/data.json/2.5.0/data.json-2.5.0.jar:/Users/sto/.m2/repository/org/jsoup/jsoup/1.18.3/jsoup-1.18.3.jar:/Users/sto/.m2/repository/org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar:/Users/sto/.m2/repository/ring/ring/1.14.1/ring-1.14.1.jar:/Users/sto/.m2/repository/stigmergy/chp/0.1.0-SNAPSHOT/chp-0.1.0-SNAPSHOT.jar:/Users/sto/.m2/repository/com/cognitect/transit-java/1.0.371/transit-java-1.0.371.jar:/Users/sto/.m2/repository/com/cognitect/anomalies/0.1.12/anomalies-0.1.12.jar:/Users/sto/.m2/repository/com/cognitect/caster/1.0.45/caster-1.0.45.jar:/Users/sto/.m2/repository/com/datomic/datomic-lucene-core/3.3.0/datomic-lucene-core-3.3.0.jar:/Users/sto/.m2/repository/com/datomic/io-stats/