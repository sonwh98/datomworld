am-ref, :blocked? false})\n455:          :stream/cursor\n456-          (let [[id s'] (gensym state \"cursor\")\n457-                [cursor-ref new-state] (handle-cursor s' effect id)]\n458-            {:state new-state, :value cursor-ref, :blocked? false})\n459-          :stream/put\n460-          (let [result (handle-put state effect)]\n461-            (if (:park result)\n462-              (let [built-entry (when park-entry\n463-                                  (park-entry state effect result))\n464-                    built-entry (if (and built-entry (not (:datom built-entry)))\n465-                                  (assoc built-entry :datom (:val effect))\n466-                                  built-entry)]\n467-                (handle-stream-block result built-entry))\n468-              {:state (:state result),\n469-               :value (:value result),\n470-               :blocked? false}))\n471-          :stream/next\n472-          (let [result (handle-next state effect)]\n473-            (if (:park result)\n474-              (let [built-entry (when park-entry\n475-                                  (park-entry state effect result))]\n476-                (handle-stream-block result built-entry))\n477-              {:state (:state result),\n478-               :value (:value result),\n479-               :blocked? false}))\n480-          :stream/close\n481-          (let [close-result (handle-close state effect)]\n482-            {:state (:state close-result), :value nil, :blocked? false})\n483-          (let [[id s'] (gensym state \"effect\")\n484-                handler (module/get-effect-handler (:modules state)\n485-                                                   (:effect effect))]\n486-            (if handler\n487-              (handler s' effect (assoc opts :id id))\n488-              (fail \"Unknown effect\" {:effect (:effect effect)}))))]\n489-    (update result\n490-            :state\n491-            (fn [result-state]\n492-              (telemetry