{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljs/datomworld/demo/continuation_stream_v2.cljs'","aggregated_output":"     1\t(ns datomworld.demo.continuation-stream-v2\n     2\t  \"Two semantic VMs cooperatively run one program, shipping the continuation\n     3\t   between them through a DaoStream v2 medium.\n     4\t\n     5\t   Source compiles through yang to a Universal AST, which\n     6\t   `yin.vm.linearize` lowers to one `:yin.code/*` segment. VM-A loads it\n     7\t   and steps; every handoff interval the owner's registers — segment, pc,\n     8\t   accumulator, operand stack, environment, continuation frames — are\n     9\t   appended to the medium as one batch together with the segment's datoms\n    10\t   (`datomworld.demo.continuation-handoff-v2`, §7 of yin.vm.semantic.md).\n    11\t\n    12\t   Nothing is handed over off-stream. The registers travel as EDN text, and\n    13\t   the receiver is a fresh VM that loads the shipped segment through the\n    14\t   ordinary loader and installs the registers it read back, so the only\n    15\t   thing the two machines share is the medium. Primitives, modules, and the\n    16\t   FFI pair are each receiving composition's own.\n    17\t\n    18\t   The demo loads explicitly instead of through the observer composition\n    19\t   because it animates one `vm/step` at a time. A handoff happens only at an\n    20\t   instruction boundary with no wait set, ready queue, or parked\n    21\t   continuation, whose resources would be stream handles in the sender's\n    22\t   store.\"\n    23\t  (:require [\"@codemirror/state\" :refer [EditorState]]\n    24\t            [\"@codemirror/theme-one-dark\" :refer [oneDark]]\n    25\t            [\"@codemirror/view\" :refer [EditorView]]\n    26\t            [\"@nextjournal/lang-clojure\" :refer [clojure]]\n    27\t            [\"codemirror\" :refer [basicSetup]]\n    28\t            [cljs.reader :as reader]\n    29\t            [clojure.string :as str]\n    30\t            [dao.stream.ringbuffer :as ringbuffer]\n    31\t            [datomworld.demo.continuation-handoff-v2 :as handoff]\n    32\t            [datomworld.demo.continuation-transport-v2 :as ct]\n    33\t            [datomworld.demo.responsive :as responsive]\n    34\t            [reagent.core :as r]\n    35\t            [yang.clojure :as yang]\n    36\t            [yin.demo.utils :as demo.utils]\n    37\t            [yin.vm :as vm]\n    38\t            [yin.vm.linearize :as linearize]\n    39\t            [yin.vm.module :as module]\n    40\t            [yin.vm.semantic :as semantic]))\n    41\t\n    42\t\n    43\t(def source-example\n    44\t  \"(defn sum-to\n    45\t  [n]\n    46\t  (if (= n 0)\n    47\t    0\n    48\t    (+ n (sum-to (- n 1)))))\n    49\t\n    50\t;; Example: (sum-to 3) => 6 (1 + 2 + 3)\n    51\t(sum-to 100)\")\n    52\t\n    53\t\n    54\t(def ^:private pretty-print demo.utils/pretty-print)\n    55\t\n    56\t\n    57\t;; =============================================================================\n    58\t;; The composition\n    59\t;; =============================================================================\n    60\t\n    61\t(defn- make-stream\n    62\t  \"The `:make-stream` each VM is handed: one DaoStream v2 ring buffer per\n    63\t   call. A nil capacity is the VM's default, not an unbounded stream.\"\n    64\t  [capacity]\n    65\t  (ringbuffer/create!\n    66\t    {:dao.stream/type ringbuffer/transport-type,\n    67\t     ringbuffer/capacity-key (or capacity vm/default-stream-capacity)}))\n    68\t\n    69\t\n    70\t(defn make-vm\n    71\t  \"Construct one v2 evaluator for this demo. The composition supplies the\n    72\t   transport, the primitives and the module registry; there is no default for\n    73\t   the transport, and a VM built without one cannot create streams.\"\n    74\t  [_vm-key]\n    75\t  (semantic/create-vm\n    76\t    {:primitives vm/primitives,\n    77\t     :modules (module/register-stream-module (module/default-registry)),\n    78\t     :make-stream make-stream}))\n    79\t\n    80\t\n    81\t(defn create-loaded-vm\n    82\t  \"Load one code segment onto a fresh VM. This is the loader host\n    83\t   composition hands to observer coordination; the demo calls it directly\n    84\t   because it animates single steps rather than running to halt.\"\n    85\t  [code-datoms]\n    86\t  (semantic/vm-load-program (make-vm :vm-a) (vec code-datoms)))\n    87\t\n    88\t\n    89\t(defn codemirror-editor\n    90\t  [{:keys [value on-change read-only auto-scroll-bottom]}]\n    91\t  (let [view-ref (r/atom nil)\n    92\t        el-ref (atom nil)]\n    93\t    (r/create-class\n    94\t      {:display-name \"continuation-codemirror-editor\",\n    95\t       :component-did-mount\n    96\t       (fn [_]\n    97\t         (when-let [node @el-ref]\n    98\t           (let [theme (.theme EditorView\n    99\t                               #js {\"&\" #js {:height \"100%\"},\n   100\t                                    \".cm-scroller\" #js {:overflow \"auto\"}})\n   101\t                 extensions\n   102\t                 (cond-> #js [basicSetup (clojure) oneDark theme]\n   103\t                   read-only (.concat #js [(.of (.-editable EditorView)\n   104\t                                                false)])\n   105\t                   on-change\n   106\t                   (.concat\n   107\t                     #js [(.of\n   108\t                            (.-updateListener EditorView)\n   109\t                            (fn [^js update]\n   110\t                              (when (and (.-docChanged update) on-change)\n   111\t                                (on-change\n   112\t                                  (.. update -state -doc toString)))))]))\n   113\t                 state (.create EditorState\n   114\t                                #js {:doc (or value \"\"),\n   115\t                                     :extensions extensions})\n   116\t                 view (new EditorView #js {:state state, :parent node})]\n   117\t             (reset! view-ref view)\n   118\t             (when auto-scroll-bottom\n   119\t               (js/requestAnimationFrame\n   120\t                 (fn []\n   121\t                   (let [scroll-dom (.-scrollDOM view)]\n   122\t                     (set! (.-scrollTop scroll-dom)\n   123\t                           (.-scrollHeight scroll-dom))))))))),\n   124\t       :component-did-update\n   125\t       (fn [this _]\n   126\t         (let [{:keys [value auto-scroll-bottom]} (r/props this)]\n   127\t           (when-let [^js view @view-ref]\n   128\t             (let [next-value (or value \"\")\n   129\t                   current-value (.. view -state -doc toString)]\n   130\t               (when (not= next-value current-value)\n   131\t                 (.dispatch view\n   132\t                            #js {:changes #js\n   133\t                                          {:from 0,\n   134\t                                           :to (.. view -state -doc -length),\n   135\t                                           :insert next-value}})\n   136\t                 (when auto-scroll-bottom\n   137\t                   (js/requestAnimationFrame\n   138\t                     (fn []\n   139\t                       (let [scroll-dom (.-scrollDOM view)]\n   140\t                         (set! (.-scrollTop scroll-dom)\n   141\t                               (.-scrollHeight scroll-dom))))))))))),\n   142\t       :component-will-unmount (fn [_]\n   143\t                                 (when-let [^js view @view-ref]\n   144\t                                   (.destroy view)\n   145\t                                   (reset! view-ref nil))),\n   146\t       :reagent-render\n   147\t       (fn [{:keys [style]}]\n   148\t         [:div\n   149\t          {:ref #(reset! el-ref %),\n   150\t           :style (merge {:height \"100%\",\n   151\t                          :width \"100%\",\n   152\t                          :border \"1px solid #2d3b55\",\n   153\t                          :overflow \"hidden\"}\n   154\t                         style)}])})))\n   155\t\n   156\t\n   157\t(defonce app-state\n   158\t  (let [{:keys [k-stream cursors pending-ks]} (ct/init-state [:vm-a :vm-b])]\n   159\t    (r/atom\n   160\t      {:source-code source-example,\n   161\t       :ast nil,\n   162\t       :datoms nil,\n   163\t       :vm-a nil,\n   164\t       :vm-b nil,\n   165\t       :owner :vm-a,\n   166\t       :steps 0,\n   167\t       :handoffs 0,\n   168\t       :steps-since-handoff 0,\n   169\t       :handoff-interval 50,\n   170\t       :running false,\n   171\t       :completed? false,\n   172\t       :result nil,\n   173\t       :k-stream k-stream,\n   174\t       :cursors cursors,\n   175\t       :pending-ks pending-ks,\n   176\t       :error nil})))\n   177\t\n   178\t\n   179\t(defonce run-raf-id (atom nil))\n   180\t\n   181\t\n   182\t;; =============================================================================\n   183\t;; Observing VM state\n   184\t;; =============================================================================\n   185\t\n   186\t(defn vm-control-counter\n   187\t  \"The semantic VM's control is `{:segment id :pc n}`; the pc is the counter.\"\n   188\t  [_vm-key vm-state]\n   189\t  (when vm-state (get-in vm-state [:control :pc])))\n   190\t\n   191\t\n   192\t(defn vm-k-depth\n   193\t  [_ vm-state]\n   194\t  (when vm-state (count (or (vm/continuation vm-state) []))))\n   195\t\n   196\t\n   197\t(defn v2-k-frames\n   198\t  \"Summarize the continuation's frames, innermost last. A semantic frame is\n   199\t   {:type :return :segment id :pc n :env E :stack-base n}.\"\n   200\t  [frames]\n   201\t  (->> (or frames [])\n   202\t       (take-last 12)\n   203\t       (mapv (fn [frame]\n   204\t               {:type (:type frame),\n   205\t                :return-pc (:pc frame),\n   206\t                :bound (count (or (:env frame) {}))}))))\n   207\t\n   208\t\n   209\t(defn other-vm\n   210\t  [vm-key]\n   211\t  (if (= vm-key :vm-a) :vm-b :vm-a))\n   212\t\n   213\t\n   214\t(defn enqueue-k\n   215\t  \"Ship the sender's continuation: the segment datoms and its registers, as\n   216\t   one batch on the medium.\"\n   217\t  [state from to from-vm-state]\n   218\t  (let [summary {:kind :k,\n   219\t                 :from from,\n   220\t                 :to to,\n   221\t                 :control (vm-control-counter from from-vm-state),\n   222\t                 :k-depth (vm-k-depth from from-vm-state)}]\n   223\t    (ct/enqueue-batch state\n   224\t                      summary\n   225\t                      (handoff/continuation-datoms (:datoms state)\n   226\t                                                   from-vm-state))))\n   227\t\n   228\t\n   229\t(defn activate-owner-from-stream\n   230\t  \"Rebuild the owner from the next batch addressed to it, if one has\n   231\t   arrived.\"\n   232\t  [state]\n   233\t  (let [owner (:owner state)]\n   234\t    (if (get state owner)\n   235\t      [state false]\n   236\t      (let [[state* message] (ct/consume-k-for state owner)]\n   237\t        (if message\n   238\t          [(assoc state*\n   239\t                  owner\n   240\t                  (handoff/datoms->semantic-vm (:batch message)\n   241\t                                               #(make-vm owner)))\n   242\t           true]\n   243\t          [state* false])))))\n   244\t\n   245\t\n   246\t(defn stop-run-loop!\n   247\t  []\n   248\t  (when @run-raf-id\n   249\t    (js/cancelAnimationFrame @run-raf-id)\n   250\t    (reset! run-raf-id nil))\n   251\t  (swap! app-state assoc :running false))\n   252\t\n   253\t\n   254\t(defn invalidate-compiled-state!\n   255\t  []\n   256\t  (stop-run-loop!)\n   257\t  (let [{:keys [k-stream cursors pending-ks]} (ct/init-state [:vm-a :vm-b])]\n   258\t    (swap! app-state assoc\n   259\t           :ast nil\n   260\t           :datoms nil\n   261\t           :vm-a nil\n   262\t           :vm-b nil\n   263\t           :owner :vm-a\n   264\t           :steps 0\n   265\t           :handoffs 0\n   266\t           :steps-since-handoff 0\n   267\t           :k-stream k-stream\n   268\t           :cursors cursors\n   269\t           :pending-ks pending-ks\n   270\t           :completed? false\n   271\t           :result nil\n   272\t           :error nil)))\n   273\t\n   274\t\n   275\t(defn set-source-code!\n   276\t  [next-source]\n   277\t  (let [current-source (:source-code @app-state)]\n   278\t    (when (not= next-source current-source)\n   279\t      (invalidate-compiled-state!)\n   280\t      (swap! app-state assoc :source-code next-source))))\n   281\t\n   282\t\n   283\t(defn reset-execution!\n   284\t  []\n   285\t  (let [{:keys [datoms]} @app-state]\n   286\t    (when datoms\n   287\t      (stop-run-loop!)\n   288\t      (let [{:keys [k-stream cursors pending-ks]} (ct/init-state [:vm-a :vm-b])\n   289\t            initial-vm (create-loaded-vm datoms)]\n   290\t        (swap! app-state assoc\n   291\t               :vm-a initial-vm\n   292\t               :vm-b nil\n   293\t               :owner :vm-a\n   294\t               :steps 0\n   295\t               :handoffs 0\n   296\t               :steps-since-handoff 0\n   297\t               :k-stream k-stream\n   298\t               :cursors cursors\n   299\t               :pending-ks pending-ks\n   300\t               :completed? false\n   301\t               :result nil\n   302\t               :error nil)))))\n   303\t\n   304\t\n   305\t(defn compile-source!\n   306\t  []\n   307\t  (stop-run-loop!)\n   308\t  (let [source (:source-code @app-state)]\n   309\t    (try\n   310\t      (let [forms (reader/read-string (str \"[\" source \"]\"))\n   311\t            ast (yang/compile-program forms)\n   312\t            datoms (linearize/lower-ast ast)\n   313\t            {:keys [k-stream cursors pending-ks]} (ct/init-state [:vm-a :vm-b])\n   314\t            initial-vm (create-loaded-vm datoms)]\n   315\t        (swap! app-state assoc\n   316\t               :ast ast\n   317\t               :datoms datoms\n   318\t               :vm-a initial-vm\n   319\t               :vm-b nil\n   320\t               :owner :vm-a\n   321\t               :steps 0\n   322\t               :handoffs 0\n   323\t               :steps-since-handoff 0\n   324\t               :k-stream k-stream\n   325\t               :cursors cursors\n   326\t               :pending-ks pending-ks\n   327\t               :running false\n   328\t               :completed? false\n   329\t               :result nil\n   330\t               :error nil))\n   331\t      (catch :default e\n   332\t        (swap! app-state assoc\n   333\t               :error (str \"Compile error: \" (.-message e))\n   334\t               :running false\n   335\t               :completed? false\n   336\t               :result nil)))))\n   337\t\n   338\t\n   339\t(defn emit-handoff\n   340\t  [state from stepped-vm]\n   341\t  (let [to (other-vm from)]\n   342\t    (-> state\n   343\t        (enqueue-k from to stepped-vm)\n   344\t        (assoc :owner to)\n   345\t        (assoc to nil)\n   346\t        (update :handoffs inc)\n   347\t        (assoc :steps-since-handoff 0))))\n   348\t\n   349\t\n   350\t(defn step-state\n   351\t  [state]\n   352\t  (if (or (nil? (:datoms state))\n   353\t          (:completed? state))\n   354\t    (assoc state :running false)\n   355\t    (let [owner (:owner state)\n   356\t          [state* just-activated?] (activate-owner-from-stream state)\n   357\t          active-vm (get state* owner)]\n   358\t      (cond just-activated? state*\n   359\t            (nil? active-vm) (-> state*\n   360\t                                 (assoc :running false)\n   361\t                                 (assoc :error\n   362\t                                        (str \"No continuation available for \"\n   363\t                                             (name owner)\n   364\t                                             \".\")))\n   365\t            :else (try (let [stepped (vm/step active-vm)\n   366\t                             stepped-state (-> state*\n   367\t                                               (assoc owner stepped)\n   368\t                                               (update :steps inc)\n   369\t                                               (update :steps-since-handoff inc)\n   370\t                                               (assoc :error nil))]\n   371\t                         (cond (vm/halted? stepped)\n   372\t                               (-> stepped-state\n   373\t                                   (assoc :completed? true)\n   374\t                                   (assoc :running false)\n   375\t                                   (assoc :result (vm/value stepped)))\n   376\t                               (and (>= (:steps-since-handoff stepped-state)\n   377\t                                        (:handoff-interval stepped-state))\n   378\t                                    (handoff/shippable? stepped))\n   379\t                               (emit-handoff stepped-state owner stepped)\n   380\t                               :else stepped-state))\n   381\t                       (catch :default e\n   382\t                         (-> state*\n   383\t                             (assoc :running false)\n   384\t                             (assoc :error (str \"VM step error: \"\n   385\t                                                (.-message e))))))))))\n   386\t\n   387\t\n   388\t(def steps-per-frame 80)\n   389\t\n   390\t\n   391\t(declare run-frame!)\n   392\t\n   393\t\n   394\t(defn step-once!\n   395\t  []\n   396\t  (stop-run-loop!) (swap! app-state step-state))\n   397\t\n   398\t\n   399\t(defn run-frame!\n   400\t  []\n   401\t  (swap! app-state (fn [state]\n   402\t                     (loop [i 0\n   403\t                            s state]\n   404\t                       (if (or (>= i steps-per-frame)\n   405\t                               (not (:running s))\n   406\t                               (:completed? s))\n   407\t                         s\n   408\t                         (recur (inc i) (step-state s))))))\n   409\t  (if (:running @app-state)\n   410\t    (reset! run-raf-id (js/requestAnimationFrame run-frame!))\n   411\t    (reset! run-raf-id nil)))\n   412\t\n   413\t\n   414\t(defn toggle-run!\n   415\t  []\n   416\t  (if (:running @app-state)\n   417\t    (stop-run-loop!)\n   418\t    (when (:datoms @app-state)\n   419\t      (swap! app-state assoc :running true :error nil)\n   420\t      (when @run-raf-id (js/cancelAnimationFrame @run-raf-id))\n   421\t      (reset! run-raf-id (js/requestAnimationFrame run-frame!)))))\n   422\t\n   423\t\n   424\t(defn vm->cesk\n   425\t  [vm-key vm-state]\n   426\t  (when vm-state\n   427\t    (let [continuation (vm/continuation vm-state)]\n   428\t      {:control {:segment (get-in vm-state [:control :segment]),\n   429\t                 :pc (vm-control-counter vm-key vm-state),\n   430\t                 :stack (:stack vm-state),\n   431\t                 :halted? (:halted? vm-state),\n   432\t                 :blocked? (:blocked? vm-state)},\n   433\t       :environment (:env vm-state),\n   434\t       :store (:store vm-state),\n   435\t       :continuation {:depth (count (or continuation [])),\n   436\t                      :frames (v2-k-frames continuation)},\n   437\t       :parked (count (or (:parked vm-state) {})),\n   438\t       :ready-queue-count (count (or (:ready-queue vm-state) [])),\n   439\t       :wait-set-count (count (or (:wait-set vm-state) [])),\n   440\t       :value (:value vm-state)})))\n   441\t\n   442\t\n   443\t(defn datom-listing\n   444\t  [datoms]\n   445\t  (if (seq datoms)\n   446\t    (str/join \"\\n\" (map-indexed (fn [i d] (str i \"  \" (pr-str d))) datoms))\n   447\t    \"Compile source to view the code datoms.\"))\n   448\t\n   449\t\n   450\t(defn card\n   451\t  [title subtitle body]\n   452\t  [:div\n   453\t   {:style {:background \"#0e1328\",\n   454\t            :border \"1px solid #2d3b55\",\n   455\t            :box-shadow \"0 10px 25px rgba(0,0,0,0.5)\",\n   456\t            :display \"flex\",\n   457\t            :flex-direction \"column\",\n   458\t            :min-height \"0\"}}\n   459\t   [:div\n   460\t    {:style {:background \"#151b33\",\n   461\t             :padding \"8px 10px\",\n   462\t             :border-bottom \"1px solid #2d3b55\",\n   463\t             :display \"flex\",\n   464\t             :flex-direction \"column\",\n   465\t             :gap \"2px\"}}\n   466\t    [:strong {:style {:color \"#f1f5ff\", :font-size \"13px\"}} title]\n   467\t    [:span {:style {:color \"#8b949e\", :font-size \"11px\"}} subtitle]]\n   468\t   [:div\n   469\t    {:style {:padding \"10px\",\n   470\t             :display \"flex\",\n   471\t             :flex-direction \"column\",\n   472\t             :gap \"8px\",\n   473\t             :flex \"1\",\n   474\t             :min-height \"0\"}} body]])\n   475\t\n   476\t\n   477\t(defn vm-window\n   478\t  [vm-key title border-color]\n   479\t  (let [{:keys [owner]} @app-state\n   480\t        vm-state (get @app-state vm-key)\n   481\t        active? (= owner vm-key)\n   482\t        cesk (or (vm->cesk vm-key vm-state)\n   483\t                 {:state :waiting-for-continuation})\n   484\t        status (cond (nil? vm-state) \"Waiting\"\n   485\t                     (:halted? vm-state) (if (seq (:parked vm-state))\n   486\t                                           \"Parked\"\n   487\t                                           \"Halted\")\n   488\t                     active? \"Running\"\n   489\t                     :else \"Parked snapshot\")]\n   490\t    [:div\n   491\t     {:style {:border (str \"1px solid \" border-color),\n   492\t              :background \"#0d1117\",\n   493\t              :display \"flex\",\n   494\t              :flex-direction \"column\",\n   495\t              :min-height \"0\"}}\n   496\t     [:div\n   497\t      {:style {:display \"flex\",\n   498\t               :justify-content \"space-between\",\n   499\t               :align-items \"center\",\n   500\t               :padding \"8px 10px\",\n   501\t               :border-bottom \"1px solid #30363d\",\n   502\t               :background \"#111827\"}}\n   503\t      [:strong {:style {:color \"#f1f5ff\", :font-size \"12px\"}} title]\n   504\t      [:span\n   505\t       {:style {:color (if active? \"#58a6ff\" \"#8b949e\"), :font-size \"11px\"}}\n   506\t       status]]\n   507\t     [:div\n   508\t      {:style {:display \"grid\",\n   509\t               :grid-template-rows \"1fr\",\n   510\t               :gap \"8px\",\n   511\t               :padding \"8px\",\n   512\t               :flex \"1\",\n   513\t               :min-height \"0\"}}\n   514\t      [codemirror-editor\n   515\t       {:value (pretty-print cesk),\n   516\t        :read-only true,\n   517\t        :style {:height \"100%\"}}]]]))\n   518\t\n   519\t\n   520\t(defn controls-panel\n   521\t  []\n   522\t  (let [{:keys [running handoff-interval]} @app-state\n   523\t        compiled? (boolean (:datoms @app-state))]\n   524\t    [:div\n   525\t     {:style\n   526\t      {:display \"flex\", :flex-wrap \"wrap\", :align-items \"center\", :gap \"8px\"}}\n   527\t     [:button\n   528\t      {:on-click compile-source!,\n   529\t       :style {:background \"#1f6feb\",\n   530\t               :color \"#fff\",\n   531\t               :border \"none\",\n   532\t               :padding \"8px 12px\",\n   533\t               :border-radius \"5px\",\n   534\t               :cursor \"pointer\",\n   535\t               :font-size \"12px\"}} \"Compile -> Datoms\"]\n   536\t     [:button\n   537\t      {:on-click reset-execution!,\n   538\t       :disabled (not compiled?),\n   539\t       :style {:background (if compiled? \"#6e7681\" \"#333\"),\n   540\t               :color \"#fff\",\n   541\t               :border \"none\",\n   542\t               :padding \"8px 12px\",\n   543\t               :border-radius \"5px\",\n   544\t               :cursor (if compiled? \"pointer\" \"not-allowed\"),\n   545\t               :font-size \"12px\"}} \"Reset\"]\n   546\t     [:button\n   547\t      {:on-click step-once!,\n   548\t       :disabled (not compiled?),\n   549\t       :style {:background (if compiled? \"#238636\" \"#333\"),\n   550\t               :color \"#fff\",\n   551\t               :border \"none\",\n   552\t               :padding \"8px 12px\",\n   553\t               :border-radius \"5px\",\n   554\t               :cursor (if compiled? \"pointer\" \"not-allowed\"),\n   555\t               :font-size \"12px\"}} \"Step\"]\n   556\t     [:button\n   557\t      {:on-click toggle-run!,\n   558\t       :disabled (not compiled?),\n   559\t       :style {:background (cond (not compiled?) \"#333\"\n   560\t                                 running \"#da3633\"\n   561\t                                 :else \"#238636\"),\n   562\t               :color \"#fff\",\n   563\t               :border \"none\",\n   564\t               :padding \"8px 12px\",\n   565\t               :border-radius \"5px\",\n   566\t               :cursor (if compiled? \"pointer\" \"not-allowed\"),\n   567\t               :font-size \"12px\"}} (if running \"Pause\" \"Run\")]\n   568\t     [:label\n   569\t      {:style {:display \"flex\",\n   570\t               :align-items \"center\",\n   571\t               :gap \"6px\",\n   572\t               :font-size \"12px\",\n   573\t               :color \"#8b949e\"}} \"Handoff every\"\n   574\t      [:input\n   575\t       {:type \"number\",\n   576\t        :min 1,\n   577\t        :value handoff-interval,\n   578\t        :on-change (fn [e]\n   579\t                     (let [raw (.. e -target -value)\n   580\t                           parsed (js/parseInt raw 10)\n   581\t                           interval (if (js/isNaN parsed) 1 (max 1 parsed))]\n   582\t                       (swap! app-state assoc :handoff-interval interval))),\n   583\t        :style {:width \"60px\",\n   584\t                :background \"#0a0f1e\",\n   585\t                :border \"1px solid #2d3b55\",\n   586\t                :border-radius \"4px\",\n   587\t                :color \"#c5c6c7\",\n   588\t                :padding \"4px 6px\"}}] \"steps\"]]))\n   589\t\n   590\t\n   591\t(defn main-view\n   592\t  []\n   593\t  (r/create-class\n   594\t    {:display-name \"continuation-stream-v2-main\",\n   595\t     :component-did-mount (fn []\n   596\t                            (when-not (:datoms @app-state)\n   597\t                              (compile-source!))),\n   598\t     :component-will-unmount (fn [] (stop-run-loop!)),\n   599\t     :reagent-render\n   600\t     (fn []\n   601\t       (let [{:keys [source-code datoms k-stream cursors steps handoffs owner\n   602\t                     completed? result error]}\n   603\t             @app-state\n   604\t             vm-a (:vm-a @app-state)\n   605\t             vm-b (:vm-b @app-state)\n   606\t             program-view\n   607\t             (if datoms\n   608\t               (pretty-print {:code-datoms (count datoms),\n   609\t                              :datoms (take 40 datoms)})\n   610\t               \"Compile source to generate code datoms.\")\n   611\t             queue-view (pretty-print (ct/in-flight-summary k-stream cursors))\n   612\t             stream-view\n   613\t             (pretty-print\n   614\t               (let [[events _] (ct/read-events-from k-stream\n   615\t                                                     (ct/oldest-cursor!\n   616\t                                                       k-stream))]\n   617\t                 (take-last 200 events)))\n   618\t             run-summary\n   619\t             {:owner owner,\n   620\t              :steps steps,\n   621\t              :handoffs handoffs,\n   622\t              :vm-a-control (vm-control-counter :vm-a vm-a),\n   623\t              :vm-b-control (vm-control-counter :vm-b vm-b),\n   624\t              :vm-a-k-depth (vm-k-depth :vm-a vm-a),\n   625\t              :vm-b-k-depth (vm-k-depth :vm-b vm-b),\n   626\t              :pending-ks (count (:pending-ks @app-state)),\n   627\t              :transport-capacity ct/transport-capacity,\n   628\t              :completed? completed?,\n   629\t              :result result}]\n   630\t         [:div\n   631\t          {:style {:min-height \"100vh\",\n   632\t                   :background \"#060817\",\n   633\t                   :color \"#c5c6c7\",\n   634\t                   :padding \"96px 16px 24px\",\n   635\t                   :display \"flex\",\n   636\t                   :flex-direction \"column\",\n   637\t                   :gap \"12px\",\n   638\t                   :box-sizing \"border-box\"}}\n   639\t          [:div\n   640\t           {:style {:display \"flex\",\n   641\t                    :justify-content \"space-between\",\n   642\t                    :align-items \"center\",\n   643\t                    :gap \"12px\",\n   644\t                    :flex-wrap \"wrap\"}}\n   645\t           [:h1 {:style {:margin 0, :font-size \"1.4rem\", :color \"#f1f5ff\"}}\n   646\t            \"Semantic VM Continuation Stream\"]] [controls-panel]\n   647\t          [:div\n   648\t           {:style {:display \"grid\",\n   649\t                    :grid-template-columns (responsive/auto-fit-grid 320),\n   650\t                    :gap \"12px\",\n   651\t                    :flex \"1\",\n   652\t                    :min-height \"0\"}}\n   653\t           [:div {:style {:min-height (responsive/fluid-height 280 42 380)}}\n   654\t            [card \"Source\" \"CodeMirror editor: Clojure code\"\n   655\t             [codemirror-editor\n   656\t              {:value source-code,\n   657\t               :on-change set-source-code!,\n   658\t               :style {:height \"100%\"}}]]]\n   659\t           [:div {:style {:min-height (responsive/fluid-height 280 42 380)}}\n   660\t            [card \"Code Segment\"\n   661\t             \"yang -> AST -> linearize: the :yin.code/* datoms shipped with every handoff.\"\n   662\t             [codemirror-editor\n   663\t              {:value program-view,\n   664\t               :read-only true,\n   665\t               :style {:height \"100%\"}}]]]\n   666\t           [:div {:style {:min-height (responsive/fluid-height 320 50 460)}}\n   667\t            [card \"VM-A (semantic)\"\n   668\t             \"CESK state while ownership changes.\"\n   669\t             [vm-window :vm-a \"VM-A\" \"#3b82f6\"]]]\n   670\t           [:div {:style {:min-height (responsive/fluid-height 320 50 460)}}\n   671\t            [card \"VM-B (semantic)\"\n   672\t             \"CESK state while ownership changes.\"\n   673\t             [vm-window :vm-b \"VM-B\" \"#22c55e\"]]]\n   674\t           [:div {:style {:min-height (responsive/fluid-height 240 34 320)}}\n   675\t            [card \"In-Flight\"\n   676\t             \"Continuations between each VM cursor and stream head.\"\n   677\t             [codemirror-editor\n   678\t              {:value queue-view, :read-only true, :style {:height \"100%\"}}]]]\n   679\t           [:div {:style {:min-height (responsive/fluid-height 240 34 320)}}\n   680\t            [card \"Stream Events\"\n   681\t             \"Handoff batches on the medium: segment datoms, EDN registers, summary.\"\n   682\t             [codemirror-editor\n   683\t              {:value stream-view,\n   684\t               :read-only true,\n   685\t               :auto-scroll-bottom true,\n   686\t               :style {:height \"100%\"}}]]]\n   687\t           [:div {:style {:min-height (responsive/fluid-height 240 34 320)}}\n   688\t            [card \"Run Summary\" \"Execution totals and final value.\"\n   689\t             [codemirror-editor\n   690\t              {:value (pretty-print run-summary),\n   691\t               :read-only true,\n   692\t               :style {:height \"100%\"}}]]]]\n   693\t          (when error\n   694\t            [:div\n   695\t             {:style {:background \"rgba(255,0,0,0.2)\",\n   696\t                      :border \"1px solid #da3633\",\n   697\t                      :padding \"8px\",\n   698\t                      :font-size \"12px\",\n   699\t                      :color \"#f85149\"}} error])]))}))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat test/yin/vm/semantic_ffi_test.cljc test/yin/vm/semantic_engine_test.cljc'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc 'cat test/yin/vm/semantic_ffi_test.cljc test/yin/vm/semantic_engine_test.cljc'","aggregated_output":"(ns yin.vm.semantic-ffi-test\n  \"`ffi_test.cljc` on the semantic VM: `:ffi-call` parks with the pure-data\n   registers after the call and waits for its correlated response in the\n   polling wait set. Programs are lowered ASTs, so the call sites exercised are\n   the ones `yin.vm.linearize` emits.\"\n  (:require [clojure.edn :as edn]\n            [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.stream.apply :as apply2]\n            [yin.vm :as vm]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.linearize :as linearize]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n\n\n(defn- throws-ex-data\n  [thunk]\n  (try (thunk) nil\n       (catch #?(:clj Exception :cljs js/Error :cljd Object) e\n         (or (ex-data e) {}))))\n\n\n(def ^:private load-ast (linearize/ast-loader semantic/vm-load-program))\n\n\n(defn- make-vm\n  ([] (make-vm {}))\n  ([opts] (semantic/create-vm (merge {:make-stream tu/make-stream} opts))))\n\n\n(defn- run-ast\n  [vm ast]\n  (vm/run (load-ast vm (vm/ast->datoms ast))))\n\n\n(defn- resume\n  [vm]\n  (vm/eval vm nil))\n\n\n(defn- call-ast\n  ([op] (call-ast op []))\n  ([op values]\n   {:type :dao.stream.apply/call,\n    :op op,\n    :operands (mapv (fn [v] {:type :literal, :value v}) values)}))\n\n\n;; =============================================================================\n;; The round trip\n;; =============================================================================\n\n(deftest installed-handlers-round-trip-test\n  (testing \"A host call is dispatched and its parked continuation resumes\"\n    (let [result (run-ast (make-vm {:bridge {:op/echo identity}})\n                          (call-ast :op/echo [42]))]\n      (is (vm/halted? result))\n      (is (= 42 (vm/value result)))))\n  (testing \"Arguments are evaluated left to right before the call\"\n    (let [result (run-ast (make-vm {:bridge {:op/list vector}})\n                          (call-ast :op/list [1 2 3]))]\n      (is (= [1 2 3] (vm/value result)))))\n  (testing \"The result feeds the instructions after the call site\"\n    (let [result (run-ast (make-vm {:bridge {:op/echo identity}})\n                          {:type :application,\n                           :operator {:type :variable, :name '+},\n                           :operands [{:type :literal, :value 1}\n                                      (call-ast :op/echo [41])]})]\n      (is (= 42 (vm/value result))))))\n\n\n(deftest manual-bridge-step-test\n  (testing \"Without installed handlers the VM parks and a driver steps it\"\n    (let [parked (run-ast (make-vm) (call-ast :op/echo [7]))\n          entry (first (:wait-set parked))]\n      (is (vm/blocked? parked))\n      (is (= :yin/blocked (vm/value parked)))\n      (is (= 1 (count (:wait-set parked)))\n          \"The continuation waits in the polling wait set, not on a waiter\")\n      (is (= :next (:reason entry)))\n      (is (contains? (:parked parked) (:call-id entry)))\n      (is (= (:wait-set parked) (edn/read-string (pr-str (:wait-set parked))))\n          \"The response reader is registers and ids, never a closure\")\n      (let [attached (ffi/attach parked {:op/echo identity})\n            {:keys [handled? vm]} (ffi/bridge-step attached)]\n        (is (true? handled?))\n        (let [done (resume vm)]\n          (is (vm/halted? done))\n          (is (= 7 (vm/value done)))\n          (is (empty? (:parked done))))))))\n\n\n(deftest error-responses-surface-as-errors-test\n  (testing \"An unknown op is a portable error response, not an escaping throw\"\n    (let [parked (run-ast (make-vm) (call-ast :op/missing [1]))\n          {:keys [vm handled?]} (ffi/bridge-step (ffi/attach parked\n                                                             {:op/other\n                                                              identity}))]\n      (is (true? handled?) \"The response was delivered\")\n      (is (throws? (fn [] (resume vm))))))\n  (testing \"A failing handler is an error response too\"\n    (let [parked (run-ast (make-vm) (call-ast :op/boom []))\n          bang (fn [] (throw (ex-info \"boom\" {})))\n          {:keys [vm]} (ffi/bridge-step (ffi/attach parked {:op/boom bang}))]\n      (is (throws? (fn [] (resume vm)))))))\n\n\n(deftest a-response-for-another-call-does-not-resume-this-one-test\n  (let [parked (run-ast (make-vm) (call-ast :op/echo [1]))\n        call-id (:call-id (first (:wait-set parked)))\n        call-out (get (vm/store parked) vm/call-out-stream-key)]\n    (apply2/put-response! call-out (apply2/success-response [:other call-id] 1))\n    (let [data (throws-ex-data (fn [] (resume parked)))]\n      (is (some? data) \"A mis-correlated response is an error, not a value\")\n      (is (= call-id (:call-id data)))\n      (is (= [:other call-id] (:response-id data))))))\n\n\n;; =============================================================================\n;; The step is once-only\n;; =============================================================================\n\n(defn- scripted-writer\n  \"A call-out handle whose append outcomes are scripted.\"\n  [outcomes]\n  (reify\n    stream/IDaoStreamReader\n    (cursor\n      [_ _]\n      {:dao.stream/outcome :dao.stream/ok,\n       :dao.stream/cursor :out-0})\n\n    (next [_ _] {:dao.stream/outcome :dao.stream/blocked})\n\n\n    stream/IDaoStreamWriter\n\n    (append!\n      [_ _]\n      (let [o (first @outcomes)]\n        (swap! outcomes rest)\n        {:dao.stream/outcome o}))))\n\n\n(deftest full-retains-the-response-and-runs-the-handler-once-test\n  (let [calls (atom 0)\n        outcomes (atom [:dao.stream/full :dao.stream/ok])\n        vm0 (make-vm {:call-in (tu/new-stream 8),\n                      :call-out (scripted-writer outcomes)})\n        parked (ffi/attach (run-ast vm0 (call-ast :op/count []))\n                           {:op/count (fn [] (swap! calls inc))})\n        cursor-before (get-in parked [:bridge :cursor])\n        step1 (ffi/bridge-step parked)]\n    (testing \"A full response stream retains the response and the successor\"\n      (is (false? (:handled? step1)))\n      (is (true? (:retained? step1)))\n      (is (= 1 @calls))\n      (is (= cursor-before (get-in (:vm step1) [:bridge :cursor])))\n      (is (some? (get-in (:vm step1) [:bridge :pending-response]))))\n    (testing \"The retry appends the retained response without re-running\"\n      (let [step2 (ffi/bridge-step (:vm step1))]\n        (is (true? (:handled? step2)))\n        (is (= 1 @calls) \"The handler executed exactly once\")\n        (is (not= cursor-before (get-in (:vm step2) [:bridge :cursor])))\n        (is (nil? (get-in (:vm step2) [:bridge :pending-response])))))))\n\n\n(defn- gated-call-in\n  \"A call-in handle delegating to a real stream, whose first `gate-count`\n   appends return `full` without reaching the delegate.\"\n  [delegate gate-count]\n  (let [gate (atom gate-count)]\n    (reify\n      stream/IDaoStreamReader\n      (cursor [_ anchor] (stream/cursor delegate anchor))\n\n      (next [_ cursor] (stream/next delegate cursor))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ v]\n        (if (pos? @gate)\n          (do (swap! gate dec)\n              {:dao.stream/outcome :dao.stream/full})\n          (stream/append! delegate v))))))\n\n\n(deftest full-retains-the-unsent-request-test\n  (let [attempts (atom [])\n        call-in (reify\n                  stream/IDaoStreamReader\n                  (cursor\n                    [_ _]\n                    {:dao.stream/outcome :dao.stream/ok,\n                     :dao.stream/cursor :in-0})\n\n                  (next [_ _] {:dao.stream/outcome :dao.stream/blocked})\n\n\n                  stream/IDaoStreamWriter\n\n                  (append!\n                    [_ v]\n                    (swap! attempts conj v)\n                    {:dao.stream/outcome :dao.stream/full}))\n        parked (run-ast (make-vm {:call-in call-in, :call-out (tu/new-stream 8)})\n                        (call-ast :op/echo [3]))]\n    (testing \"A full call-in parks the call with its request retained\"\n      (is (vm/blocked? parked))\n      (is (= 1 (count (:wait-set parked))))\n      (let [waiter (first (:wait-set parked))\n            request (:datom waiter)\n            [parked-id] (keys (:parked parked))]\n        (is (= :put (:reason waiter)))\n        (is (true? (:request-sent waiter)))\n        (is (apply2/request? request))\n        (is (= parked-id (apply2/request-id request) (:call-id waiter))\n            \"The retained request keeps the allocated id for the retry\")\n        (is (= :op/echo (apply2/request-op request)))\n        (is (= [3] (apply2/request-args request)))))\n    (testing \"The polling wait set retries the identical encoded request\"\n      (is (vm/blocked? (resume parked)))\n      (is (> (count @attempts) 1) \"The wait set retried the append\")\n      (is (apply = @attempts)))))\n\n\n(deftest full-request-is-sent-on-retry-and-answered-test\n  (let [parked (run-ast (make-vm {:call-in (gated-call-in (tu/new-stream 8) 1),\n                                  :call-out (tu/new-stream 8)})\n                        (call-ast :op/echo [5]))]\n    (testing \"The retry sent the request; the call waits for its response\"\n      (is (vm/blocked? parked))\n      (is (= 1 (count (:wait-set parked))))\n      (is (= :next (:reason (first (:wait-set parked))))))\n    (let [{:keys [handled? request-id vm]}\n          (ffi/bridge-step (ffi/attach parked {:op/echo identity}))\n          done (resume vm)]\n      (is (true? handled?))\n      (is (= (first (keys (:parked parked))) request-id))\n      (is (vm/halted? done))\n      (is (= 5 (vm/value done)))\n      (is (empty? (:parked done))))))\n\n\n(deftest terminal-append-outcome-ends-the-bridge-test\n  (let [vm0 (make-vm {:call-in (tu/new-stream 8),\n                      :call-out (scripted-writer (atom [:dao.stream/closed]))})\n        parked (ffi/attach (run-ast vm0 (call-ast :op/echo [1]))\n                           {:op/echo identity})\n        {:keys [handled? terminal vm]} (ffi/bridge-step parked)]\n    (is (false? handled?))\n    (is (= :dao.stream/closed terminal))\n    (is (= :dao.stream/closed (:terminal (ffi/bridge-step vm))))))\n\n\n;; =============================================================================\n;; Reading the request side\n;; =============================================================================\n\n(deftest gap-at-the-bridge-cursor-is-fatal-test\n  (testing \"An evicted request can never be answered, so it is reported\"\n    (let [call-in (tu/new-stream 2)\n          vm0 (make-vm {:call-in call-in,\n                        :call-out (tu/new-stream 8),\n                        :bridge {:op/echo identity}})]\n      (dotimes [n 5] (stream/append! call-in (apply2/request n :op/echo [n])))\n      (is (throws? (fn [] (ffi/bridge-step vm0)))))))\n\n\n(deftest history-before-the-cursor-is-not-skipped-test\n  (testing \"A pre-filled call-in is read from oldest, not from newest\"\n    (let [call-in (tu/new-stream 8)\n          _ (stream/append! call-in (apply2/request :pre :op/echo [:early]))\n          vm0 (make-vm {:call-in call-in,\n                        :call-out (tu/new-stream 8),\n                        :bridge {:op/echo identity}})\n          {:keys [handled? request-id]} (ffi/bridge-step vm0)]\n      (is (true? handled?))\n      (is (= :pre request-id)))))\n\n\n;; =============================================================================\n;; A VM with no pair, and repeated calls\n;; =============================================================================\n\n(deftest no-call-pair-test\n  (let [bare (semantic/create-vm {})]\n    (testing \"A VM without :make-stream or explicit streams holds no pair\"\n      (is (nil? (ffi/call-pair (vm/store bare)))))\n    (testing \"A non-nil bridge on such a VM is a construction error\"\n      (is (throws? (fn [] (semantic/create-vm {:bridge {:op/echo identity}})))))\n    (testing \"A call fails before park-continuation\"\n      (is (throws? (fn [] (run-ast bare (call-ast :op/echo [1]))))))))\n\n\n(deftest completed-calls-leave-no-parked-entries-test\n  (let [vm0 (make-vm {:bridge {:op/echo identity}})\n        first-done (run-ast vm0 (call-ast :op/echo [1]))]\n    (is (empty? (:parked first-done)))\n    (let [second-done (run-ast first-done (call-ast :op/echo [2]))]\n      (is (vm/halted? second-done))\n      (is (= 2 (vm/value second-done)))\n      (is (empty? (:parked second-done))\n          \"Repeated host calls do not accumulate in :parked\"))))\n(ns yin.vm.semantic-engine-test\n  \"The blocked-read and put cases of `engine_test.cljc`, reached through the\n   semantic VM: lowered `:stream-*` instructions dispatch the engine's effects,\n   and a read that cannot proceed parks into a pure-data wait set.\"\n  (:require [clojure.edn :as edn]\n            [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.linearize :as linearize]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n\n\n(def ^:private load-ast (linearize/ast-loader semantic/vm-load-program))\n\n\n(defn- make-vm\n  []\n  (semantic/create-vm {:make-stream tu/make-stream}))\n\n\n(defn- run-ast\n  ([ast] (run-ast (make-vm) ast))\n  ([vm ast] (vm/run (load-ast vm (vm/ast->datoms ast)))))\n\n\n(defn- lit [v] {:type :literal, :value v})\n(defn- var-ref [n] {:type :variable, :name n})\n\n\n(defn- let1\n  \"`((fn [param] body) init)`.\"\n  [param init body]\n  {:type :application,\n   :operator {:type :lambda, :params [param], :body body},\n   :operands [init]})\n\n\n(defn- read-first\n  \"Make a stream of `capacity`, mint a cursor on it, and read one value.\"\n  [capacity]\n  (let1 's\n        {:type :stream/make, :buffer capacity}\n        {:type :stream/next,\n         :source {:type :stream/cursor, :source (var-ref 's)}}))\n\n\n(defn- blocked-reader\n  \"Run `read-first` on an empty stream: the parked VM and the stream handle.\"\n  [capacity]\n  (let [parked (run-ast (read-first capacity))\n        entry (first (:wait-set parked))]\n    [parked (get (vm/store parked) (:stream-id entry))]))\n\n\n(defn- host-value?\n  [x]\n  (some fn? (tree-seq coll? seq x)))\n\n\n;; =============================================================================\n;; Blocked reads\n;; =============================================================================\n\n(deftest an-empty-stream-parks-the-reader-test\n  (let [[parked handle] (blocked-reader 4)\n        entry (first (:wait-set parked))]\n    (testing \"The reader parks with one polling wait entry\"\n      (is (vm/blocked? parked))\n      (is (stream/writer? handle))\n      (is (= 1 (count (:wait-set parked))))\n      (is (= :next (:reason entry)))\n      (is (= :cursor-ref (get-in entry [:cursor-ref :type]))))\n    (testing \"The entry is machine registers, not a resume closure\"\n      (is (integer? (:pc entry)))\n      (is (contains? (:code parked) (:segment entry)))\n      (is (not (contains? entry :resume)))\n      (is (not (host-value? (:wait-set parked))))\n      (is (= (:wait-set parked)\n             (edn/read-string (pr-str (:wait-set parked))))\n          \"The wait set survives an EDN round-trip\"))))\n\n\n(deftest a-value-wakes-the-parked-reader-test\n  (let [[parked handle] (blocked-reader 4)\n        cursor-id (get-in (first (:wait-set parked)) [:cursor-ref :id])\n        before (get-in parked [:store cursor-id :cursor])]\n    (testing \"Polling without a value leaves the reader parked\"\n      (is (vm/blocked? (vm/run parked))))\n    (stream/append! handle :a)\n    (let [done (vm/run parked)]\n      (testing \"An appended value resumes the continuation after :stream-next\"\n        (is (vm/halted? done))\n        (is (= :a (vm/value done)))\n        (is (empty? (:wait-set done))))\n      (testing \"The stored cursor advances to the returned successor\"\n        (is (not= before (get-in done [:store cursor-id :cursor])))))))\n\n\n(deftest a-wait-set-read-back-from-edn-resumes-test\n  (testing \"The scheduler restores an entry that was never a live object\"\n    (let [[parked handle] (blocked-reader 4)\n          revived (assoc parked\n                         :wait-set\n                         (edn/read-string (pr-str (:wait-set parked))))]\n      (stream/append! handle :from-edn)\n      (is (= :from-edn (vm/value (vm/run revived)))))))\n\n\n(deftest a-closed-and-drained-stream-ends-with-nil-test\n  (let [[parked handle] (blocked-reader 4)]\n    (stream/close! handle)\n    (let [done (vm/run parked)]\n      (is (vm/halted? done))\n      (is (nil? (vm/value done))))))\n\n\n(deftest gap-is-a-value-the-program-sees-test\n  (testing \"Eviction under the reader's cursor surfaces as :dao.stream/gap\"\n    (let [[parked handle] (blocked-reader 2)]\n      (dotimes [n 5] (stream/append! handle n))\n      (is (= :dao.stream/gap (vm/value (vm/run parked)))))))\n\n\n;; =============================================================================\n;; Puts\n;; =============================================================================\n\n(deftest put-returns-the-appended-value-test\n  (let [ref-vm (run-ast (let1 's\n                              {:type :stream/make, :buffer 4}\n                              (let1 '_\n                                    {:type :stream/put,\n                                     :target (var-ref 's),\n                                     :val (lit 7)}\n                                    (var-ref 's))))\n        handle (get (vm/store ref-vm) (:id (vm/value ref-vm)))\n        cursor (:dao.stream/cursor (stream/cursor handle stream/anchor-oldest))]\n    (testing \"The put's value is in the accumulator and on the stream\"\n      (is (= 7 (vm/value (run-ast (let1 's\n                                        {:type :stream/make, :buffer 4}\n                                        {:type :stream/put,\n                                         :target (var-ref 's),\n                                         :val (lit 7)})))))\n      (is (= 7 (:dao.stream/value (stream/next handle cursor)))))))\n\n\n(deftest put-on-a-closed-stream-is-an-error-test\n  (is (throws? (fn []\n                 (run-ast (let1 's\n                                {:type :stream/make, :buffer 4}\n                                (let1 '_\n                                      {:type :stream/close, :source (var-ref 's)}\n                                      {:type :stream/put,\n                                       :target (var-ref 's),\n                                       :val (lit 1)})))))))\n\n\n(deftest put-on-an-unknown-stream-reference-is-an-error-test\n  (is (throws? (fn []\n                 (run-ast {:type :stream/put,\n                           :target (lit {:type :stream-ref, :id :nope}),\n                           :val (lit 1)})))))\n","exit_code":0,"status":"completed"}}
