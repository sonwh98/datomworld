{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'nl -ba src/cljc/yin/repl/core.cljc; nl -ba test/bench/yin_vm_bench.cljc'","aggregated_output":"     1\t(ns yin.repl.core\n     2\t  \"The local Yin shell for DaoStream v2: explicit state, synchronous steps.\n     3\t\n     4\t   This namespace owns no socket, atom, promise, callback, clock, or namespace\n     5\t   global.  It holds the one shell value a driver threads: the evaluator beside\n     6\t   its separately-owned program medium — writer, descriptor, unary attacher,\n     7\t   and attached stream observer — the language, the value history, the v2\n     8\t   output medium with its cursor, and a per-medium ledger recording the last\n     9\t   outcome that medium answered.  Every function takes a state and returns the\n    10\t   next one.\n    11\t\n    12\t   `yin.repl` is untouched and keeps running; this is a second implementation\n    13\t   beside it.\"\n    14\t  (:require #?(:cljd [clojure.edn :as edn]\n    15\t               :cljs [cljs.reader :as reader])\n    16\t            [clojure.string :as str]\n    17\t            [dao.pretty :as pretty]\n    18\t            [dao.stream :as stream]\n    19\t            [dao.stream.ringbuffer :as ring]\n    20\t            [yang.clojure :as yang.clojure]\n    21\t            [yang.php :as yang.php]\n    22\t            [yang.python :as yang.python]\n    23\t            [yin.vm :as vm]\n    24\t            [yin.vm.ast-walker :as ast-walker]\n    25\t            [yin.vm.engine :as engine]\n    26\t            [yin.vm.linearize :as linearize]\n    27\t            [yin.vm.module :as module]\n    28\t            [yin.vm.semantic :as semantic]\n    29\t            [dao.stream.observer :as observer]))\n    30\t\n    31\t\n    32\t(def output-capacity\n    33\t  \"Declared capacity of the composition-owned output medium, in elements.\"\n    34\t  4096)\n    35\t\n    36\t\n    37\t(def ingress-capacity\n    38\t  \"Declared capacity of the composition-owned program medium, in elements.  The\n    39\t   shell is the only appender and its one step owner serializes evaluation, so\n    40\t   eviction can only follow a producer the composition does not make; a gap is\n    41\t   therefore fatal to the current evaluation rather than a normal operating\n    42\t   condition.\"\n    43\t  4096)\n    44\t\n    45\t\n    46\t(def drain-budget\n    47\t  \"Maximum reads one output drain performs, so the drain is total even against\n    48\t   a transport that could answer `gap` repeatedly.\"\n    49\t  4096)\n    50\t\n    51\t\n    52\t(def vm-constructors\n    53\t  \"The evaluators on `yin.vm`: the ast-walker and the linear semantic VM\n    54\t   (`docs/design/yin.vm.semantic.md`).\"\n    55\t  {:ast-walker ast-walker/create-vm\n    56\t   :semantic semantic/create-vm})\n    57\t\n    58\t\n    59\t(def vm-labels {:ast-walker \"ASTWalkerVM\" :semantic \"SemanticVM\"})\n    60\t\n    61\t\n    62\t(def program-loaders\n    63\t  \"The loader the observer hands each program batch, per evaluator.  The\n    64\t   shell's program medium carries `:yin/*` AST datoms, so the semantic VM's\n    65\t   code loader is composed behind the lowering; neither evaluator learns\n    66\t   which form travels.\"\n    67\t  {:ast-walker ast-walker/vm-load-program\n    68\t   :semantic (linearize/ast-loader semantic/vm-load-program)})\n    69\t\n    70\t\n    71\t(def lang-labels {:clojure \"Clojure\" :python \"Python\" :php \"PHP\"})\n    72\t\n    73\t\n    74\t(def command-heads\n    75\t  \"Commands this shell answers.  `connect` and `disconnect` belong to the\n    76\t   driver, which owns the RPC client; `telemetry` is answered only to say that\n    77\t   the v2 slice does not have it.\"\n    78\t  #{'vm 'lang 'compile 'reset 'help 'repl-state 'quit 'telemetry})\n    79\t\n    80\t\n    81\t(def help-text\n    82\t  (str \"Commands:\\n\"\n    83\t       \"  (vm :ast-walker | :semantic)\\n\"\n    84\t       \"  (lang :clojure | :python | :php)\\n\"\n    85\t       \"  (compile expr)\\n\"\n    86\t       \"  (reset)\\n\"\n    87\t       \"  (connect \\\"daostream:ws://host:port\\\")\\n\"\n    88\t       \"  (disconnect)\\n\"\n    89\t       \"  (repl-state)\\n\"\n    90\t       \"  (help)\\n\"\n    91\t       \"  (quit)\\n\"\n    92\t       \"  *1, *2, *3  - last, second-to-last, and third-to-last evaluated values\"))\n    93\t\n    94\t\n    95\t(def telemetry-text\n    96\t  \"Telemetry is not part of the DaoStream v2 REPL slice; run yin.repl for it\")\n    97\t\n    98\t\n    99\t(def ingress-loss-text\n   100\t  \"One or more program batches were never observed from the program medium; (reset) is required before more evaluation\")\n   101\t\n   102\t\n   103\t;; =============================================================================\n   104\t;; Rendering\n   105\t;; =============================================================================\n   106\t\n   107\t(defn- quote-symbols\n   108\t  [x]\n   109\t  (cond (symbol? x) (list 'quote x)\n   110\t        (vector? x) (mapv quote-symbols x)\n   111\t        (map? x)\n   112\t        (into {} (map (fn [[k v]] [(quote-symbols k) (quote-symbols v)]) x))\n   113\t        (or (list? x) (seq? x))\n   114\t        (if (= 'quote (first x)) x (map quote-symbols x))\n   115\t        :else x))\n   116\t\n   117\t\n   118\t(defn format-value\n   119\t  [value]\n   120\t  (str/trimr (pretty/pp-str (quote-symbols value))))\n   121\t\n   122\t\n   123\t(defn format-error\n   124\t  [error]\n   125\t  (str \"Error: \"\n   126\t       #?(:cljd (or (ex-message error) (str error))\n   127\t          :cljs (or (ex-message error) (.-message error) (str error))\n   128\t          :clj (or (ex-message error) (str error)))))\n   129\t\n   130\t\n   131\t(defn- print-arg\n   132\t  [value]\n   133\t  (if (string? value) value (format-value value)))\n   134\t\n   135\t\n   136\t(defn- print-text\n   137\t  [args]\n   138\t  (str/join \" \" (map print-arg args)))\n   139\t\n   140\t\n   141\t(defn- prn-text\n   142\t  [args]\n   143\t  (str (str/join \" \" (map format-value args)) \"\\n\"))\n   144\t\n   145\t\n   146\t;; =============================================================================\n   147\t;; The output medium\n   148\t;; =============================================================================\n   149\t\n   150\t(defn- emit-output!\n   151\t  [output-stream op text]\n   152\t  ;; A primitive holds no state, so it cannot record an append outcome.  The\n   153\t  ;; medium is an evict-oldest ring buffer, which never answers `full`; a closed\n   154\t  ;; medium drops the chunk and the drain reports the closure.\n   155\t  (when output-stream\n   156\t    (stream/append! output-stream {:type :repl/output :op op :text text}))\n   157\t  nil)\n   158\t\n   159\t\n   160\t(defn- make-repl-primitives\n   161\t  [output-stream]\n   162\t  (merge vm/primitives\n   163\t         {'print (fn [& args] (emit-output! output-stream :print (print-text args)))\n   164\t          'println (fn [& args]\n   165\t                     (emit-output! output-stream :println\n   166\t                                   (str (print-text args) \"\\n\")))\n   167\t          'prn (fn [& args] (emit-output! output-stream :prn (prn-text args)))\n   168\t          'ast->datoms vm/ast->datoms\n   169\t          'datoms->ast vm/datoms->ast}))\n   170\t\n   171\t\n   172\t(defn- chunk-text\n   173\t  [value]\n   174\t  (if (map? value) (str (:text value)) (str value)))\n   175\t\n   176\t\n   177\t(defn- ledger\n   178\t  [state medium outcome]\n   179\t  (assoc-in state [:ledger medium] outcome))\n   180\t\n   181\t\n   182\t(defn drain-output\n   183\t  \"Drain the output medium into text, total over every `next` outcome.\n   184\t\n   185\t   `ok` advances to the exact successor the handle returned.  `gap` prints a\n   186\t   loss notice and resumes at the recovery cursor.  `end`, `cursor-mismatch`,\n   187\t   `invalid-cursor`, and `transport-error` print a notice, leave the cursor\n   188\t   unchanged, and end the drain.  Whatever ended the drain is recorded in the\n   189\t   ledger, so `repl-state` never has to ask a stream how it is.\"\n   190\t  [state]\n   191\t  (let [output (:output-stream state)\n   192\t        cursor (:output-cursor state)]\n   193\t    (cond\n   194\t      (nil? output) [(ledger state :output :untried) \"\"]\n   195\t      (nil? cursor) [(ledger state :output :dao.stream/invalid-cursor)\n   196\t                     \";; output unreadable: no cursor was minted\\n\"]\n   197\t      :else\n   198\t      (loop [remaining drain-budget\n   199\t             cursor cursor\n   200\t             chunks []]\n   201\t        (if (zero? remaining)\n   202\t          [(-> state\n   203\t               (assoc :output-cursor cursor)\n   204\t               (ledger :output :dao.stream/blocked))\n   205\t           (apply str chunks)]\n   206\t          (let [result (stream/next output cursor)\n   207\t                outcome (:dao.stream/outcome result)]\n   208\t            (case outcome\n   209\t              :dao.stream/ok\n   210\t              (recur (dec remaining)\n   211\t                     (:dao.stream/cursor result)\n   212\t                     (conj chunks (chunk-text (:dao.stream/value result))))\n   213\t\n   214\t              :dao.stream/gap\n   215\t              (recur (dec remaining)\n   216\t                     (:dao.stream/cursor result)\n   217\t                     (conj chunks \";; output lost: resumed at the recovery cursor\\n\"))\n   218\t\n   219\t              :dao.stream/blocked\n   220\t              [(-> state\n   221\t                   (assoc :output-cursor cursor)\n   222\t                   (ledger :output outcome))\n   223\t               (apply str chunks)]\n   224\t\n   225\t              [(-> state\n   226\t                   (assoc :output-cursor cursor)\n   227\t                   (ledger :output outcome))\n   228\t               (apply str (conj chunks (str \";; output \" (name outcome) \"\\n\")))])))))))\n   229\t\n   230\t\n   231\t(defn- make-output-medium!\n   232\t  []\n   233\t  (:dao.stream/handle\n   234\t    (ring/create! {:dao.stream/type ring/transport-type\n   235\t                   ring/capacity-key output-capacity})))\n   236\t\n   237\t\n   238\t(defn- mint-cursor\n   239\t  [handle]\n   240\t  (let [result (stream/cursor handle :dao.stream/oldest)]\n   241\t    (when (= :dao.stream/ok (:dao.stream/outcome result))\n   242\t      (:dao.stream/cursor result))))\n   243\t\n   244\t\n   245\t;; =============================================================================\n   246\t;; The VM and its program medium\n   247\t;; =============================================================================\n   248\t\n   249\t(defn- make-ring-stream\n   250\t  \"The `:make-stream` the shell hands the VM: one v2 ring buffer per call.  A\n   251\t   nil capacity is the VM's default, not an unbounded stream; v2 has no\n   252\t   unbounded mode.\"\n   253\t  [capacity]\n   254\t  (ring/create! {:dao.stream/type ring/transport-type\n   255\t                 ring/capacity-key (or capacity vm/default-stream-capacity)}))\n   256\t\n   257\t\n   258\t(defn make-vm\n   259\t  \"Construct the shell's evaluator on `yin.vm`.\n   260\t\n   261\t   The shell is the composition that chooses the VM's transport: the\n   262\t   ast-walker is handed `:make-stream` bound to the v2 ring buffer and the v2\n   263\t   `stream` module registered in its registry.  No telemetry stream is\n   264\t   installed, and the VM owns no program medium: `make-session` builds the\n   265\t   medium, its attachment, the observer, and the VM together.\"\n   266\t  [vm-type output-stream]\n   267\t  (when-not (contains? vm-constructors vm-type)\n   268\t    (throw (ex-info \"Unknown Yin REPL VM type\"\n   269\t                    {:vm-type vm-type\n   270\t                     :supported (vec (keys vm-constructors))})))\n   271\t  ((get vm-constructors vm-type)\n   272\t   {:primitives (make-repl-primitives output-stream)\n   273\t    :modules (module/register-stream-module (module/default-registry))\n   274\t    :make-stream make-ring-stream}))\n   275\t\n   276\t\n   277\t(defn- make-program-attachment\n   278\t  \"Create the composition-owned program medium, the unary attachment entry\n   279\t   bound to it for this medium's lifetime, and an observer attached through\n   280\t   that entry.\n   281\t\n   282\t   The resolver maps the descriptor's identity to the owner handle this\n   283\t   composition created, which is host composition around the ring buffer's own\n   284\t   attach mechanism: the observer itself sees only a descriptor and a unary\n   285\t   capability, so no transport detail crosses into it.\"\n   286\t  []\n   287\t  (let [writer (:dao.stream/handle\n   288\t                 (ring/create! {:dao.stream/type ring/transport-type\n   289\t                                ring/capacity-key ingress-capacity}))\n   290\t        descriptor (:dao.stream/descriptor (stream/descriptor writer))\n   291\t        attach! (ring/make-attacher {(:dao.stream/identity descriptor) writer})]\n   292\t    {:program-stream writer\n   293\t     :observer (observer/attach attach! descriptor)}))\n   294\t\n   295\t\n   296\t(defn- make-session\n   297\t  \"Build the program medium, its attachment, the observer, the VM, and the\n   298\t   program loader the observer feeds it together.  Reset and VM selection\n   299\t   call this, so the whole composition is rebuilt as one and the attachment\n   300\t   capability is bound exactly once per medium lifetime.\"\n   301\t  [vm-type output-stream]\n   302\t  (merge {:vm (make-vm vm-type output-stream)\n   303\t          :load-program (get program-loaders vm-type)}\n   304\t         (make-program-attachment)))\n   305\t\n   306\t\n   307\t(defn- run-vm\n   308\t  \"Run the VM through its protocol entry point, as a plain function so it can\n   309\t   be handed to observer coordination on every host.\"\n   310\t  [vm]\n   311\t  (vm/run vm))\n   312\t\n   313\t\n   314\t(defn create-state\n   315\t  ([] (create-state {}))\n   316\t  ([{:keys [lang output-cursor output-stream vm-type]\n   317\t     :or {lang :clojure vm-type :semantic}}]\n   318\t   (let [output-stream (or output-stream (make-output-medium!))\n   319\t         output-cursor (or output-cursor (mint-cursor output-stream))\n   320\t         {:keys [program-stream observer vm load-program]} (make-session vm-type output-stream)]\n   321\t     {:lang lang\n   322\t      :vm-type vm-type\n   323\t      :vm vm\n   324\t      :load-program load-program\n   325\t      :program-stream program-stream\n   326\t      :observer observer\n   327\t      :output-stream output-stream\n   328\t      :output-cursor output-cursor\n   329\t      :ledger {:output :untried}\n   330\t      :ingress-loss? false\n   331\t      :last-value nil\n   332\t      :last-value-2 nil\n   333\t      :last-value-3 nil\n   334\t      :pending-input nil\n   335\t      :running? true})))\n   336\t\n   337\t\n   338\t;; =============================================================================\n   339\t;; Reading and classifying input\n   340\t;; =============================================================================\n   341\t\n   342\t(defn- read-forms\n   343\t  [input]\n   344\t  #?(:cljd (edn/read-string (str \"[\" input \"]\"))\n   345\t     :cljs (reader/read-string (str \"[\" input \"]\"))\n   346\t     :clj (clojure.core/read-string (str \"[\" input \"]\"))))\n   347\t\n   348\t\n   349\t(defn- command-form?\n   350\t  [form]\n   351\t  (and (seq? form)\n   352\t       (symbol? (first form))\n   353\t       (contains? command-heads (first form))))\n   354\t\n   355\t\n   356\t(defn- datom?\n   357\t  [value]\n   358\t  (and (vector? value) (= 5 (count value))))\n   359\t\n   360\t\n   361\t(defn- datom-stream?\n   362\t  [value]\n   363\t  (and (vector? value) (seq value) (every? datom? value)))\n   364\t\n   365\t\n   366\t(defn- ast-map?\n   367\t  [value]\n   368\t  (and (map? value) (keyword? (:type value))))\n   369\t\n   370\t\n   371\t(defn- bracket-balance\n   372\t  \"Open minus close brackets, ignoring string literals and `;` comments.\n   373\t   Positive means the input is incomplete.\"\n   374\t  [s]\n   375\t  (loop [chars (seq s)\n   376\t         depth 0\n   377\t         in-str? false]\n   378\t    (if (empty? chars)\n   379\t      depth\n   380\t      (let [ch (first chars)\n   381\t            tail (rest chars)]\n   382\t        (cond in-str? (cond (= ch \\\\) (recur (rest tail) depth true)\n   383\t                            (= ch \\\") (recur tail depth false)\n   384\t                            :else (recur tail depth true))\n   385\t              (= ch \\\") (recur tail depth true)\n   386\t              (= ch \\;) (recur (drop-while #(not= % \\newline) tail) depth false)\n   387\t              (#{\\( \\[ \\{} ch) (recur tail (inc depth) false)\n   388\t              (#{\\) \\] \\}} ch) (recur tail (dec depth) false)\n   389\t              :else (recur tail depth false))))))\n   390\t\n   391\t\n   392\t;; =============================================================================\n   393\t;; Evaluation\n   394\t;; =============================================================================\n   395\t\n   396\t(defn- inject-last-value\n   397\t  [state]\n   398\t  (update state :vm update :store assoc\n   399\t          '*1 (:last-value state)\n   400\t          '*2 (:last-value-2 state)\n   401\t          '*3 (:last-value-3 state)))\n   402\t\n   403\t\n   404\t(defn- record-last-value\n   405\t  [state state-after value]\n   406\t  (assoc state-after\n   407\t         :last-value value\n   408\t         :last-value-2 (:last-value state)\n   409\t         :last-value-3 (:last-value-2 state)))\n   410\t\n   411\t\n   412\t(defn- finalize-eval\n   413\t  [state state' vm']\n   414\t  (let [value (vm/value vm')\n   415\t        [state'' output-text] (drain-output (assoc state' :vm vm'))]\n   416\t    [(record-last-value state state'' value)\n   417\t     (str output-text (format-value value))]))\n   418\t\n   419\t\n   420\t(declare eval-datoms)\n   421\t\n   422\t\n   423\t(defn- eval-ast\n   424\t  \"Evaluate a compiled AST.  The ast-walker evaluates it directly; the\n   425\t   semantic VM executes only code segments, so its AST travels the program\n   426\t   medium as datoms and is lowered by the session's loader.\"\n   427\t  [state ast]\n   428\t  (cond\n   429\t    (:ingress-loss? state) [state (str \"Error: \" ingress-loss-text)]\n   430\t    (= :semantic (:vm-type state)) (eval-datoms state (vm/ast->datoms ast))\n   431\t    :else (let [state' (inject-last-value state)]\n   432\t            (finalize-eval state state' (vm/eval (:vm state') ast)))))\n   433\t\n   434\t\n   435\t(defn- eval-datoms\n   436\t  \"Evaluate one datom-literal program by appending it through the program\n   437\t   medium's writer and then driving observer coordination, which loads and\n   438\t   runs every observed batch.\n   439\t\n   440\t   The observer recovers across a gap on its own, but the shell reads the gap\n   441\t   count around the round: an increase means one or more batches were never\n   442\t   run, so resuming as though execution were complete would report a result\n   443\t   built on programs the VM never saw.  The loss is reported and the shell\n   444\t   refuses further evaluation until `(reset)`.\"\n   445\t  [state datoms]\n   446\t  (if (:ingress-loss? state)\n   447\t    [state (str \"Error: \" ingress-loss-text)]\n   448\t    (let [state' (inject-last-value state)\n   449\t          append (stream/append! (:program-stream state') (vec datoms))]\n   450\t      (if-not (= :dao.stream/ok (:dao.stream/outcome append))\n   451\t        [state (str \"Error: datom batch not ingested: \"\n   452\t                    (name (:dao.stream/outcome append)))]\n   453\t        (let [observer0 (:observer state')\n   454\t              gaps-before (:ingress-gaps observer0 0)\n   455\t              {:keys [observer] vm :consumer}\n   456\t              (observer/run-on-stream {:observer observer0,\n   457\t                                       :consumer (:vm state')}\n   458\t                                      engine/ready-for-ingress?\n   459\t                                      (:load-program state')\n   460\t                                      run-vm)\n   461\t              state'' (assoc state' :observer observer :vm vm)]\n   462\t          (cond\n   463\t            (> (:ingress-gaps observer 0) gaps-before)\n   464\t            [(assoc state'' :ingress-loss? true)\n   465\t             (str \"Error: \" ingress-loss-text)]\n   466\t\n   467\t            (vm/halted? vm)\n   468\t            (finalize-eval state state'' vm)\n   469\t\n   470\t            :else\n   471\t            (throw\n   472\t              (ex-info\n   473\t                \"Datom stream did not form a complete, runnable Yin VM program.\n   474\tHint: If you wanted to evaluate these datoms as data, use a quote: '[[...]]\"\n   475\t                {:root-id (:root-id (vm/index-datoms datoms))\n   476\t                 :datom-count (count datoms)}))))))))\n   477\t\n   478\t\n   479\t(defn- compile-clojure-forms\n   480\t  [forms]\n   481\t  (if (= 1 (count forms))\n   482\t    (yang.clojure/compile (first forms))\n   483\t    (yang.clojure/compile-program forms)))\n   484\t\n   485\t\n   486\t(defn- compile-source\n   487\t  [lang input]\n   488\t  (case lang\n   489\t    :clojure (compile-clojure-forms (read-forms input))\n   490\t    :python (yang.python/compile input)\n   491\t    :php (yang.php/compile input)\n   492\t    (throw (ex-info \"Unsupported Yin REPL language\" {:lang lang}))))\n   493\t\n   494\t\n   495\t(defn- compile-command-ast\n   496\t  [state arg]\n   497\t  (case (:lang state)\n   498\t    :clojure (if (string? arg)\n   499\t               (compile-source :clojure arg)\n   500\t               (yang.clojure/compile arg))\n   501\t    (if (string? arg)\n   502\t      (compile-source (:lang state) arg)\n   503\t      (throw (ex-info \"This compile command expects a source string\"\n   504\t                      {:lang (:lang state) :arg arg})))))\n   505\t\n   506\t\n   507\t(defn- render-compile-output\n   508\t  [ast]\n   509\t  (str \"AST:\\n\" (format-value ast)\n   510\t       \"\\n\\nDatoms:\\n\" (format-value (vec (vm/ast->datoms ast)))))\n   511\t\n   512\t\n   513\t(declare repl-state)\n   514\t\n   515\t\n   516\t(defn handle-command\n   517\t  \"Answer one shell command.  Unsupported arguments are answered as text, not\n   518\t   thrown, so a mistyped command cannot end a step.\"\n   519\t  [state form]\n   520\t  (let [[command & args] form]\n   521\t    (case command\n   522\t      vm (let [vm-type (first args)]\n   523\t           (if (contains? vm-constructors vm-type)\n   524\t             (let [{:keys [program-stream observer vm load-program]}\n   525\t                   (make-session vm-type (:output-stream state))]\n   526\t               [(assoc state\n   527\t                       :vm-type vm-type\n   528\t                       :vm vm\n   529\t                       :load-program load-program\n   530\t                       :program-stream program-stream\n   531\t                       :observer observer\n   532\t                       :ingress-loss? false)\n   533\t                (str \"Switched to \" (get vm-labels vm-type) \" (store cleared)\")])\n   534\t             [state (str \"Error: Unknown Yin REPL VM type \" (pr-str vm-type)\n   535\t                         \"; supported: \" (pr-str (vec (keys vm-constructors))))]))\n   536\t      lang (let [lang (first args)]\n   537\t             (if (contains? lang-labels lang)\n   538\t               [(assoc state :lang lang) (str \"Switched to \" (get lang-labels lang))]\n   539\t               [state (str \"Error: Unknown Yin REPL language \" (pr-str lang)\n   540\t                           \"; supported: \" (pr-str (vec (keys lang-labels))))]))\n   541\t      compile [state (render-compile-output (compile-command-ast state (first args)))]\n   542\t      reset (let [{:keys [program-stream observer vm load-program]}\n   543\t                  (make-session (:vm-type state) (:output-stream state))]\n   544\t              [(assoc state\n   545\t                      :vm vm\n   546\t                      :load-program load-program\n   547\t                      :program-stream program-stream\n   548\t                      :observer observer\n   549\t                      :ingress-loss? false)\n   550\t               (str (get vm-labels (:vm-type state)) \" reset\")])\n   551\t      help [state help-text]\n   552\t      repl-state [state (format-value (repl-state state))]\n   553\t      quit [(assoc state :running? false) \"Bye\"]\n   554\t      telemetry [state telemetry-text]\n   555\t      [state (str \"Error: Unknown Yin REPL command \" (pr-str command))])))\n   556\t\n   557\t\n   558\t(defn- eval-parsed\n   559\t  [state trimmed parsed]\n   560\t  (try\n   561\t    (let [forms (:forms parsed)\n   562\t          form (when (= 1 (count forms)) (first forms))]\n   563\t      (cond\n   564\t        (and form (command-form? form)) (handle-command state form)\n   565\t        (and form (datom-stream? form)) (eval-datoms state form)\n   566\t        (and form (ast-map? form)) (eval-ast state form)\n   567\t        forms (if (= :clojure (:lang state))\n   568\t                (eval-ast state (compile-clojure-forms forms))\n   569\t                (eval-ast state (compile-source (:lang state) trimmed)))\n   570\t        (= :clojure (:lang state)) [state (format-error (:error parsed))]\n   571\t        :else (eval-ast state (compile-source (:lang state) trimmed))))\n   572\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n   573\t      (let [[state' output-text] (drain-output state)]\n   574\t        [state' (str output-text (format-error error))]))))\n   575\t\n   576\t\n   577\t(defn eval-input\n   578\t  \"Evaluate one input line locally, returning `[state text]`.\n   579\t\n   580\t   Input whose brackets do not balance is retained as `:pending-input` and\n   581\t   produces no text.  Nothing here is asynchronous: the driver, not this\n   582\t   namespace, decides when the next step happens.\"\n   583\t  [state line]\n   584\t  (let [pending (or (:pending-input state) \"\")\n   585\t        combined (if (str/blank? pending)\n   586\t                   (str/trim line)\n   587\t                   (str pending \"\\n\" (str/trim line)))]\n   588\t    (if (pos? (bracket-balance combined))\n   589\t      [(assoc state :pending-input combined) \"\"]\n   590\t      (let [state' (assoc state :pending-input nil)\n   591\t            parsed (try {:forms (read-forms combined)}\n   592\t                        (catch #?(:cljd Object :clj Exception :cljs js/Error) error\n   593\t                          {:error error}))]\n   594\t        (eval-parsed state' combined parsed)))))\n   595\t\n   596\t\n   597\t(defn repl-state\n   598\t  \"A serializable summary of shell state.\n   599\t\n   600\t   The stream summaries read the ledger rather than asking a handle whether it\n   601\t   is closed: v2 has no `closed?`, and an idle medium has no last operation.\n   602\t   The program medium is the composition's own, observed beside the VM, so the\n   603\t   shell reports what it knows of it — the declared capacity, the gaps the\n   604\t   observer counted, and whether a loss has already refused further\n   605\t   evaluation.\"\n   606\t  [state]\n   607\t  {:lang (:lang state)\n   608\t   :vm {:type (:vm-type state)\n   609\t        :halted? (vm/halted? (:vm state))\n   610\t        :blocked? (vm/blocked? (:vm state))\n   611\t        :in-stream {:capacity ingress-capacity\n   612\t                    :gaps (:ingress-gaps (:observer state) 0)\n   613\t                    :lost? (boolean (:ingress-loss? state))}}\n   614\t   :running? (:running? state)\n   615\t   :output {:cursor (:output-cursor state)\n   616\t            :last-outcome (get-in state [:ledger :output] :untried)}\n   617\t   :telemetry {:supported? false :note telemetry-text}\n   618\t   :remote {:connected? false}})\n     1\t(ns bench.yin-vm-bench\n     2\t  \"Semantic VM Phase 4: the ast-walker against the linear semantic VM on\n     3\t   `yin.vm` (`docs/design/yin.vm.semantic.md` §8).\n     4\t\n     5\t   The workload is the historic tail-recursive countdown from the deleted\n     6\t   `yin.vm.bytecode-bench`, so the ratios read against the 1.32x walker and\n     7\t   1.0–1.1x register/stack line in `docs/cesk-space-optimization.md`.\n     8\t\n     9\t   The timed region is `vm/run` alone. VM construction, AST → datoms, the\n    10\t   lowering, and the program load stay outside it. Each timed call runs the\n    11\t   same loaded VM value: both machines are persistent values and the\n    12\t   countdown touches no stream, so no reset is needed between runs.\n    13\t\n    14\t   JVM (Criterium quick-bench):\n    15\t     clj -Sdeps '{:aliases {:bench {:extra-paths [\\\"test\\\"]}}}' \\\\\n    16\t       -M:bench -m bench.yin-vm-bench 500 5000\n    17\t   Node:\n    18\t     clj -M:cljs -m shadow.cljs.devtools.cli compile vm-bench\n    19\t     node target/vm-bench.js 500 5000\"\n    20\t  (:require #?(:cljd [] :clj [criterium.core :as criterium])\n    21\t            [yin.vm :as vm]\n    22\t            [yin.vm.ast-walker :as ast-walker]\n    23\t            [yin.vm.linearize :as linearize]\n    24\t            [yin.vm.semantic :as semantic])\n    25\t  #?(:cljd (:import [\"dart:core\" DateTime])))\n    26\t\n    27\t\n    28\t(defn tail-countdown-ast\n    29\t  [n]\n    30\t  (let [self-fn {:type :lambda,\n    31\t                 :params ['self 'n],\n    32\t                 :body {:type :if,\n    33\t                        :test {:type :application,\n    34\t                               :operator {:type :variable, :name '<},\n    35\t                               :operands [{:type :variable, :name 'n}\n    36\t                                          {:type :literal, :value 1}]},\n    37\t                        :consequent {:type :literal, :value 0},\n    38\t                        :alternate\n    39\t                        {:type :application,\n    40\t                         :operator {:type :variable, :name 'self},\n    41\t                         :operands [{:type :variable, :name 'self}\n    42\t                                    {:type :application,\n    43\t                                     :operator {:type :variable, :name '-},\n    44\t                                     :operands [{:type :variable, :name 'n}\n    45\t                                                {:type :literal, :value 1}]}],\n    46\t                         :tail? true},\n    47\t                        :tail? true}}]\n    48\t    {:type :application,\n    49\t     :operator self-fn,\n    50\t     :operands [self-fn {:type :literal, :value n}],\n    51\t     :tail? true}))\n    52\t\n    53\t\n    54\t(defn load-walker\n    55\t  [ast]\n    56\t  (ast-walker/vm-load-program (ast-walker/create-vm) (vm/ast->datoms ast)))\n    57\t\n    58\t\n    59\t(defn load-semantic\n    60\t  [ast]\n    61\t  (semantic/vm-load-program (semantic/create-vm) (linearize/lower-ast ast)))\n    62\t\n    63\t\n    64\t(def evaluators\n    65\t  [[\"AST Walker\" load-walker] [\"Semantic\" load-semantic]])\n    66\t\n    67\t\n    68\t(defn- check!\n    69\t  [label loaded]\n    70\t  (let [v (vm/value (vm/run loaded))]\n    71\t    (when-not (= 0 v)\n    72\t      (throw (ex-info \"Benchmark workload returned the wrong value\"\n    73\t                      {:evaluator label, :value v})))))\n    74\t\n    75\t\n    76\t#?(:cljd nil\n    77\t   :clj\n    78\t   (defn- measure-ms\n    79\t     \"Criterium quick-bench mean, in milliseconds.\"\n    80\t     [loaded]\n    81\t     (let [result (criterium/quick-benchmark (vm/run loaded) {})]\n    82\t       (criterium/report-result result)\n    83\t       (* 1e3 (first (:mean result))))))\n    84\t\n    85\t\n    86\t#?(:cljd nil\n    87\t   :clj nil\n    88\t   :cljs\n    89\t   (defn- measure-ms\n    90\t     \"Mean of 9 samples after 4 warmups, each sample 20 runs, in milliseconds\n    91\t      per run — the sampling discipline of `yin.register-bench-cljd-v2`.\"\n    92\t     [loaded]\n    93\t     (let [now #(.now js/performance)\n    94\t           sample (fn []\n    95\t                    (let [start (now)]\n    96\t                      (dotimes [_ 20] (vm/run loaded))\n    97\t                      (/ (- (now) start) 20)))]\n    98\t       (dotimes [_ 4] (sample))\n    99\t       (let [samples (vec (repeatedly 9 sample))]\n   100\t         (println \"  samples ms/run:\" samples)\n   101\t         (/ (reduce + samples) (count samples))))))\n   102\t\n   103\t\n   104\t(defn run-bench\n   105\t  [ns-list]\n   106\t  (doseq [n ns-list]\n   107\t    (let [ast (tail-countdown-ast n)\n   108\t          means (into {}\n   109\t                      (for [[label load] evaluators]\n   110\t                        (let [loaded (load ast)]\n   111\t                          (check! label loaded)\n   112\t                          (println (str \"\\n\" label \" n=\" n))\n   113\t                          [label (measure-ms loaded)])))\n   114\t          walker (get means \"AST Walker\")]\n   115\t      (println (str \"\\nRESULT n=\" n))\n   116\t      (doseq [[label _] evaluators]\n   117\t        (let [ms (get means label)]\n   118\t          (println (str \"  \" label \": \" ms \" ms/run, \"\n   119\t                        (/ ms walker) \"x walker\")))))))\n   120\t\n   121\t\n   122\t#?(:cljd nil\n   123\t   :clj\n   124\t   (defn -main\n   125\t     [& args]\n   126\t     (run-bench (if (seq args) (map #(Long/parseLong %) args) [500 5000]))\n   127\t     (shutdown-agents)))\n   128\t\n   129\t\n   130\t#?(:cljd nil\n   131\t   :clj nil\n   132\t   :cljs\n   133\t   (defn -main\n   134\t     [& args]\n   135\t     (run-bench (if (seq args) (map #(js/parseInt %) args) [500 5000]))))\n","exit_code":0,"status":"completed"}}
