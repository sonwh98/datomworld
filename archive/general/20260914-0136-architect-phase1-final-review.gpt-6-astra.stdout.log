{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/semantic_test.cljc | sed -n '1,260p'\"","aggregated_output":"     1\t(ns yin.vm.semantic-test\n     2\t  \"Hand-assembled segments on the linear machine (Phase 1, no compiler).\n     3\t\n     4\t   Every fixture is a §2.7-shaped batch: one segment entity, dense pcs,\n     5\t   branch and closure targets as refs to instruction entities. The programs\n     6\t   are the §5.3 lowering shapes written by hand, so the transitions being\n     7\t   exercised are exactly the ones the Phase 2 linearizer will emit.\"\n     8\t  (:require [clojure.edn :as edn]\n     9\t            [clojure.test :refer [deftest is testing]]\n    10\t            [dao.datom :as datom]\n    11\t            [dao.stream :as stream]\n    12\t            [yin.vm :as vm]\n    13\t            [yin.vm.semantic :as semantic]\n    14\t            [yin.vm.test-utils :as tu]))\n    15\t\n    16\t\n    17\t;; =============================================================================\n    18\t;; Hand assembly\n    19\t;; =============================================================================\n    20\t\n    21\t(def ^:private seg -1)\n    22\t\n    23\t\n    24\t(defn- eid\n    25\t  \"The instruction entity at pc in the fixtures below.\"\n    26\t  [pc]\n    27\t  (- -10 pc))\n    28\t\n    29\t\n    30\t(defn- entity-datoms\n    31\t  [e attr-values]\n    32\t  (mapv (fn [[a v]] [e a v 0 datom/default-op]) attr-values))\n    33\t\n    34\t\n    35\t(defn- segment\n    36\t  [length]\n    37\t  (entity-datoms seg [[:yin.code/type :segment] [:yin.code/length length]]))\n    38\t\n    39\t\n    40\t(defn- instruction\n    41\t  [pc op & operands]\n    42\t  (entity-datoms (eid pc)\n    43\t                 (into [[:yin.code/segment seg] [:yin.code/pc pc]\n    44\t                        [:yin.code/op op]]\n    45\t                       (partition 2 operands))))\n    46\t\n    47\t\n    48\t(defn- assemble\n    49\t  [& parts]\n    50\t  (vec (apply concat parts)))\n    51\t\n    52\t\n    53\t(defn- make-vm\n    54\t  ([] (make-vm {}))\n    55\t  ([opts] (semantic/create-vm (merge {:make-stream tu/make-stream} opts))))\n    56\t\n    57\t\n    58\t(defn- run-segment\n    59\t  \"Load one batch into a fresh VM and run it to its stop point.\"\n    60\t  ([datoms] (run-segment (make-vm) datoms))\n    61\t  ([vm datoms]\n    62\t   (-> vm (semantic/vm-load-program datoms) vm/run)))\n    63\t\n    64\t\n    65\t(defn- worked-segment\n    66\t  \"`((fn [x] (+ x 1)) 10)` as lowered in yin.vm.semantic.md §2.7.\"\n    67\t  []\n    68\t  (assemble (segment 14)\n    69\t            (instruction 0 :closure :yin.code/params '[x] :yin.code/body (eid 6))\n    70\t            (instruction 1 :push)\n    71\t            (instruction 2 :const :yin.code/value 10)\n    72\t            (instruction 3 :push)\n    73\t            (instruction 4 :call :yin.code/argc 1 :yin.code/tail? false)\n    74\t            (instruction 5 :halt)\n    75\t            (instruction 6 :var :yin.code/name '+)\n    76\t            (instruction 7 :push)\n    77\t            (instruction 8 :var :yin.code/name 'x)\n    78\t            (instruction 9 :push)\n    79\t            (instruction 10 :const :yin.code/value 1)\n    80\t            (instruction 11 :push)\n    81\t            (instruction 12 :call :yin.code/argc 2 :yin.code/tail? true)\n    82\t            (instruction 13 :return)))\n    83\t\n    84\t\n    85\t;; =============================================================================\n    86\t;; Construction and loading\n    87\t;; =============================================================================\n    88\t\n    89\t(deftest create-vm-test\n    90\t  (let [vm (make-vm)]\n    91\t    (testing \"Initial state carries the FFI pair and no code\"\n    92\t      (is (contains? (vm/store vm) vm/call-in-stream-key))\n    93\t      (is (contains? (vm/store vm) vm/call-out-stream-key))\n    94\t      (is (contains? (vm/store vm) vm/call-out-cursor-key))\n    95\t      (is (= {} (:code vm)))\n    96\t      (is (nil? (vm/control vm)))\n    97\t      (is (nil? (vm/continuation vm)))\n    98\t      (is (vm/halted? vm))\n    99\t      (is (= {} (vm/environment vm)))))\n   100\t  (testing \"An obsolete :in-stream option is rejected before allocation\"\n   101\t    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n   102\t                 (make-vm {:in-stream :anything})))))\n   103\t\n   104\t\n   105\t(deftest load-image-decodes-refs-and-opcodes-test\n   106\t  (let [image (semantic/load-image (worked-segment))\n   107\t        inst (fn [pc] (nth (:code image) pc))]\n   108\t    (testing \"The image is indexed by pc with the §2.4 length\"\n   109\t      (is (= seg (:segment image)))\n   110\t      (is (= 14 (:length image)))\n   111\t      (is (= 14 (count (:code image)))))\n   112\t    (testing \"Mnemonics decode to mechanical opcodes; refs resolve to pcs\"\n   113\t      (is (= [(:literal vm/opcode-table) 10] (inst 2)))\n   114\t      (is (= [(:load-var vm/opcode-table) 'x] (inst 8)))\n   115\t      (is (= [(:call vm/opcode-table) 1] (inst 4)))\n   116\t      (is (= [(:tailcall vm/opcode-table) 2] (inst 12))\n   117\t          \"a :call carrying :yin.code/tail? decodes to :tailcall\")\n   118\t      (is (= [(:lambda vm/opcode-table) '[x] 6] (inst 0))\n   119\t          \"the :yin.code/body ref resolves to the body pc\")\n   120\t      (is (= [(:halt vm/opcode-table)] (inst 5))))))\n   121\t\n   122\t\n   123\t(deftest load-image-rejects-ill-formed-batches-test\n   124\t  (testing \"A load error names the rule and the entity (§2.6)\"\n   125\t    (let [bad (assemble (segment 2)\n   126\t                        (instruction 0 :const :yin.code/value 1)\n   127\t                        (instruction 1 :push))]\n   128\t      (is (thrown-with-msg?\n   129\t            #?(:clj Exception :cljs js/Error :cljd Object)\n   130\t            #\"missing-terminator\"\n   131\t            (semantic/load-image bad)))\n   132\t      (is (thrown-with-msg?\n   133\t            #?(:clj Exception :cljs js/Error :cljd Object)\n   134\t            #\"missing-terminator\"\n   135\t            (semantic/vm-load-program (make-vm) bad))))))\n   136\t\n   137\t\n   138\t;; =============================================================================\n   139\t;; Arithmetic and closures\n   140\t;; =============================================================================\n   141\t\n   142\t(deftest arithmetic-test\n   143\t  (testing \"(+ 1 2)\"\n   144\t    (is (= 3 (vm/value (run-segment\n   145\t                         (assemble (segment 8)\n   146\t                                   (instruction 0 :var :yin.code/name '+)\n   147\t                                   (instruction 1 :push)\n   148\t                                   (instruction 2 :const :yin.code/value 1)\n   149\t                                   (instruction 3 :push)\n   150\t                                   (instruction 4 :const :yin.code/value 2)\n   151\t                                   (instruction 5 :push)\n   152\t                                   (instruction 6 :call :yin.code/argc 2\n   153\t                                                :yin.code/tail? false)\n   154\t                                   (instruction 7 :halt)))))))\n   155\t  (testing \"(* (+ 1 2) 4) nests calls\"\n   156\t    (is (= 12 (vm/value (run-segment\n   157\t                          (assemble (segment 14)\n   158\t                                    (instruction 0 :var :yin.code/name '*)\n   159\t                                    (instruction 1 :push)\n   160\t                                    (instruction 2 :var :yin.code/name '+)\n   161\t                                    (instruction 3 :push)\n   162\t                                    (instruction 4 :const :yin.code/value 1)\n   163\t                                    (instruction 5 :push)\n   164\t                                    (instruction 6 :const :yin.code/value 2)\n   165\t                                    (instruction 7 :push)\n   166\t                                    (instruction 8 :call :yin.code/argc 2\n   167\t                                                 :yin.code/tail? false)\n   168\t                                    (instruction 9 :push)\n   169\t                                    (instruction 10 :const :yin.code/value 4)\n   170\t                                    (instruction 11 :push)\n   171\t                                    (instruction 12 :call :yin.code/argc 2\n   172\t                                                 :yin.code/tail? false)\n   173\t                                    (instruction 13 :halt))))))))\n   174\t\n   175\t\n   176\t(deftest closure-call-test\n   177\t  (testing \"The worked segment of §2.7 evaluates to 11\"\n   178\t    (let [vm (run-segment (worked-segment))]\n   179\t      (is (= 11 (vm/value vm)))\n   180\t      (is (vm/halted? vm))\n   181\t      (is (nil? (vm/continuation vm)))))\n   182\t  (testing \"A closure body out of line captures the defining environment\"\n   183\t    ;; ((fn [y] ((fn [x] (+ x y)) 5)) 10) — the inner body reads y from the\n   184\t    ;; outer closure's env, through a tail call and a return.\n   185\t    (is (= 15 (vm/value (run-segment\n   186\t                          (assemble (segment 20)\n   187\t                                    (instruction 0 :closure\n   188\t                                                 :yin.code/params '[y]\n   189\t                                                 :yin.code/body (eid 6))\n   190\t                                    (instruction 1 :push)\n   191\t                                    (instruction 2 :const :yin.code/value 10)\n   192\t                                    (instruction 3 :push)\n   193\t                                    (instruction 4 :call :yin.code/argc 1\n   194\t                                                 :yin.code/tail? false)\n   195\t                                    (instruction 5 :halt)\n   196\t                                    (instruction 6 :closure\n   197\t                                                 :yin.code/params '[x]\n   198\t                                                 :yin.code/body (eid 12))\n   199\t                                    (instruction 7 :push)\n   200\t                                    (instruction 8 :const :yin.code/value 5)\n   201\t                                    (instruction 9 :push)\n   202\t                                    (instruction 10 :call :yin.code/argc 1\n   203\t                                                 :yin.code/tail? true)\n   204\t                                    (instruction 11 :return)\n   205\t                                    (instruction 12 :var :yin.code/name '+)\n   206\t                                    (instruction 13 :push)\n   207\t                                    (instruction 14 :var :yin.code/name 'x)\n   208\t                                    (instruction 15 :push)\n   209\t                                    (instruction 16 :var :yin.code/name 'y)\n   210\t                                    (instruction 17 :push)\n   211\t                                    (instruction 18 :call :yin.code/argc 2\n   212\t                                                 :yin.code/tail? false)\n   213\t                                    (instruction 19 :return))))))))\n   214\t\n   215\t\n   216\t;; =============================================================================\n   217\t;; Branches\n   218\t;; =============================================================================\n   219\t\n   220\t(defn- if-segment\n   221\t  \"`(if TEST 1 2)` in the §5.3 shape: pc 4 falls into the labelled pc 5.\"\n   222\t  [test]\n   223\t  (assemble (segment 6)\n   224\t            (instruction 0 :const :yin.code/value test)\n   225\t            (instruction 1 :branch-false :yin.code/target (eid 4))\n   226\t            (instruction 2 :const :yin.code/value 1)\n   227\t            (instruction 3 :jump :yin.code/target (eid 5))\n   228\t            (instruction 4 :const :yin.code/value 2)\n   229\t            (instruction 5 :halt)))\n   230\t\n   231\t\n   232\t(deftest branch-false-test\n   233\t  (testing \"A truthy test takes the fall-through\"\n   234\t    (is (= 1 (vm/value (run-segment (if-segment true))))))\n   235\t  (testing \"false and nil both take the branch target\"\n   236\t    (is (= 2 (vm/value (run-segment (if-segment false)))))\n   237\t    (is (= 2 (vm/value (run-segment (if-segment nil)))))))\n   238\t\n   239\t\n   240\t;; =============================================================================\n   241\t;; Store and gensym\n   242\t;; =============================================================================\n   243\t\n   244\t(deftest store-and-gensym-test\n   245\t  (testing \"store-put writes the store and yields the value; store-get reads it\"\n   246\t    (let [vm (run-segment\n   247\t               (assemble (segment 4)\n   248\t                         (instruction 0 :store-put :yin.code/key 'a\n   249\t                                      :yin.code/value 5)\n   250\t                         (instruction 1 :push)\n   251\t                         (instruction 2 :store-get :yin.code/key 'a)\n   252\t                         (instruction 3 :halt)))]\n   253\t      (is (= 5 (vm/value vm)))\n   254\t      (is (= 5 (get (vm/store vm) 'a)))))\n   255\t  (testing \"gensym mints fresh ids as the counter advances\"\n   256\t    (is (= :id-0 (vm/value (run-segment\n   257\t                             (assemble (segment 2)\n   258\t                                       (instruction 0 :gensym\n   259\t                                                    :yin.code/prefix \"id\")\n   260\t                                       (instruction 1 :halt))))))\n","exit_code":0,"status":"completed"}}
