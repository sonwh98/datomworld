al reload is accepted and keeps the parked continuation\"\ntest/yin/vm/semantic_test.cljc:441:            \"the reload ran to its own park without touching the first\")\ntest/yin/vm/semantic_test.cljc:548:;; Blocked continuations are pure data\ntest/yin/vm/semantic_test.cljc:551:(defn- blocked-reader-program\ntest/yin/vm/semantic_test.cljc:561:(defn- one-slot-stream\ntest/yin/vm/semantic_test.cljc:602:(defn- blocked-writer-program\ntest/yin/vm/semantic_test.cljc:617:(defn- run-blocked-writer\ntest/yin/vm/semantic_test.cljc:624:(defn- pure-entry?\ntest/yin/vm/semantic_test.cljc:632:(deftest blocked-entries-are-pure-data-test\ntest/yin/vm/semantic_test.cljc:646:      (is (pure-entry? entry))\ntest/yin/vm/semantic_test.cljc:663:      (is (pure-entry? entry))\nsrc/cljc/yin/vm/engine.cljc:36:(defn- outcome\nsrc/cljc/yin/vm/engine.cljc:41:(defn- fail\nsrc/cljc/yin/vm/engine.cljc:46:(defn resolve-var\nsrc/cljc/yin/vm/engine.cljc:68:(defn- gen-id\nsrc/cljc/yin/vm/engine.cljc:74:(defn vm-blocked?\nsrc/cljc/yin/vm/engine.cljc:80:(defn vm-value\nsrc/cljc/yin/vm/engine.cljc:86:(defn halted-with-empty-queue?\nsrc/cljc/yin/vm/engine.cljc:92:(defn restore-initial-env\nsrc/cljc/yin/vm/engine.cljc:99:(defn active-continuation?\nsrc/cljc/yin/vm/engine.cljc:105:(defn ready-for-ingress?\nsrc/cljc/yin/vm/engine.cljc:125:(defn make-woken-run-queue-entries\nsrc/cljc/yin/vm/engine.cljc:130:   Without restore-fn the ready entry stays pure data: the `:stream` handle\nsrc/cljc/yin/vm/engine.cljc:135:  ([state woken restore-fn]\nsrc/cljc/yin/vm/engine.cljc:148:             (if restore-fn\nsrc/cljc/yin/vm/engine.cljc:149:               (let [task (adapter/vm-task base-entry restore-fn)]\nsrc/cljc/yin/vm/engine.cljc:157:(defn handle-make\nsrc/cljc/yin/vm/engine.cljc:174:(defn handle-put\nsrc/cljc/yin/vm/engine.cljc:180:  (let [stream-ref (:stream effect)\nsrc/cljc/yin/vm/engine.cljc:193:(defn handle-cursor\nsrc/cljc/yin/vm/engine.cljc:200:  (let [stream-ref (:stream effect)\nsrc/cljc/yin/vm/engine.cljc:211:(defn handle-next\nsrc/cljc/yin/vm/engine.cljc:252:(defn handle-close\nsrc/cljc/yin/vm/engine.cljc:257:  (let [stream-ref (:stream effect)\nsrc/cljc/yin/vm/engine.cljc:265:(defn- augment-wait-entry\nsrc/cljc/yin/vm/engine.cljc:274:             :stream (or (:stream entry)\nsrc/cljc/yin/vm/engine.cljc:277:    (if (and (not (:stream entry)) (:stream-id entry))\nsrc/cljc/yin/vm/engine.cljc:278:      (assoc entry :stream (get store (:stream-id entry)))\nsrc/cljc/yin/vm/engine.cljc:282:(defn check-wait-set\nsrc/cljc/yin/vm/engine.cljc:298:  ([state restore-fn]\nsrc/cljc/yin/vm/engine.cljc:306:           (let [new-tasks (make-woken-run-queue-entries v woken restore-fn)]\nsrc/cljc/yin/vm/engine.cljc:339:(defn run-loop\nsrc/cljc/yin/vm/engine.cljc:341:  [state active? step-fn resume-fn restore-fn]\nsrc/cljc/yin/vm/engine.cljc:345:            (:blocked? v) (let [v' (check-wait-set v restore-fn)]\nsrc/cljc/yin/vm/engine.cljc:356:(defn resume-from-run-queue\nsrc/cljc/yin/vm/engine.cljc:365:  [state restore-fn]\nsrc/cljc/yin/vm/engine.cljc:378:          (restore-fn base entry))))))\nsrc/cljc/yin/vm/engine.cljc:381:(defn park-continuation\nsrc/cljc/yin/vm/engine.cljc:395:(defn resume-continuation\nsrc/cljc/yin/vm/engine.cljc:397:  [state parked-id resume-val restore-fn]\nsrc/cljc/yin/vm/engine.cljc:400:      (-> (restore-fn new-state parked resume-val)\nsrc/cljc/yin/vm/engine.cljc:406:(defn gensym\nsrc/cljc/yin/vm/engine.cljc:415:(defn handle-stream-block\nsrc/cljc/yin/vm/engine.cljc:430:(defn handle-effect\nsrc/cljc/yin/vm/engine.cljc:439:   a woken entry dispatches restoration itself — so a blocked entry is pure\nsrc/cljc/yin/vm/engine.cljc:506:(defn build-program-index\nsrc/cljc/yin/vm/engine.cljc:511:(defn executable-program-datom?\nsrc/cljc/yin/vm/engine.cljc:516:(defn frame-versions\nsrc/cljc/yin/vm/engine.cljc:526:(defn collect-frame-versions\nsrc/cljc/yin/vm/engine.cljc:531:(defn pinned-compiled-versions\nsrc/cljc/yin/vm/engine.cljc:545:(defn trim-compiled-cac