============================================================================\n   462\t;; Scheduler\n   463\t;; =============================================================================\n   464\t\n   465\t(defn- scheduler-round\n   466\t  \"One round between continuations: poll the wait set, then run whatever\n   467\t   woke. Entries here carry no :resume, so `engine/resume-from-run-queue`\n   468\t   with this machine's restore function is what resumes them.\"\n   469\t  [vm]\n   470\t  (let [v' (engine/check-wait-set vm)]\n   471\t    (or (engine/resume-from-run-queue v' semantic-restore) v')))\n   472\t\n   473\t\n   474\t(defn- resume-from-run-queue\n   475\t  \"Pop first entry from the ready-queue, merge store-updates, and restore\n   476\t   machine registers.\"\n   477\t  [state]\n   478\t  (engine/resume-from-run-queue state semantic-restore))\n   479\t\n   480\t\n   481\t(defn- semantic-run-scheduler\n   482\t  \"The raw runner: already-loaded work only, through the shared scheduler\n   483\t   loop. `ffi/maybe-run` wraps this for bridge dispatch, and `vm/run` stops\n   484\t   here — no program stream is polled.\n   485\t\n   486\t   No restore function is handed down: woken entries stay pure data and are\n   487\t   resumed explicitly through `resume-from-run-queue`, which dispatches the\n   488\t   terminal-outcome check and the machine's restore itself.\"\n   489\t  [vm]\n   490\t  (engine/run-loop vm\n   491\t                   engine/active-continuation?\n   492\t                   (fn [v] (vm-hot v nil))\n   493\t                   resume-from-run-queue\n   494\t                   nil))\n   495\t\n   496\t\n   497\t;; =============================================================================\n   498\t;; Loading\n   499\t;; =============================================================================\n   500\t\n   501\t(def ^:private mnemonic-aliases\n   502\t  \"The §2.4 mnemonic → `vm/opcode-table` key mapping. Everything not here\n   503\t   decodes under its own name.\"\n   504\t  {:const :literal,\n   505\t   :var :load-var,\n   506\t   :closure :lambda,\n   507\t   :branch-false :branch,\n   508\t   :current-continuation :current-cont,\n   509\t   :ffi-call :dao.stream.apply/call})\n   510\t\n   511\t\n   512\t(defn- index-batch\n   513\t  \"Entity ids in order of first appearance, and each entity's attribute map.\n   514\t   A repeated single-valued attribute keeps its last value, as\n   515\t   `yin.vm.code` reads one.\"\n   516\t  [datoms]\n   517\t  (reduce (fn [[order attrs] [e a v]]\n   518\t            [(if (contains? attrs e) order (conj order e))\n   519\t             (assoc-in attrs [e a] v)])\n   520\t          [[] {}]\n   521\t          datoms))\n   522\t\n   523\t\n   524\t(defn load-image\n   525\t  \"Decode one `:yin.code/*` batch into an executable image.\n   526\t\n   527\t   Returns `{:segment id, :length n, :code instructions}` where `instructions`\n   528\t   is a vector indexed by pc of decoded `[opcode & operands]` vectors with\n   529\t   every `:yin.code/target` and `:yin.code/body` ref resolved to a pc integer\n   530\t   of the same segment. Throws a load error naming the entity and rule when\n   531\t   the batch is not well formed (§2.6); the loader is total over the outcomes\n   532\t   of its inputs and does not guess.\"\n   533\t  [datoms]\n   534\t  (let [defect (code/well-formed? datoms)]\n   535\t    (when defect\n   536\t      (throw (ex-info (str \"Cannot load segment: \" (name (:rule defect))\n   537\t                           \" (entity \" (:entity defect) \")\")\n   538\t                      {:defect defect})))\n   539\t    (let [[order attrs] (index-batch datoms)\n   540\t          segments (filterv #(= :segment (get-in attrs [% :yin.code/type]))\n   541\t                            order)\n   542\t          seg (first segments)\n   543\t          structural [:yin.code/segment :yin.code/pc :yin.code/op]\n   544\t          instructions (filterv (fn [e]\n   545\t                                  (and (not= seg e)\n   546\t                                       (some #(contains? (get attrs e) %)\n   547\t                                             structural)))\n   548\t                                order)\n   549\t          ;; Rule 3 sorts by pc, so an instruction's position is its pc.\n   550\t          pc-of (zipmap instructions (range))\n   551\t          resolve-ref (fn [e ref]\n   552\t                        (or (get pc-of ref)\n   553\t                            (throw (ex-info\n   554\t                                     \"Ref resolves to no instruction of this segment\"\n   555\t                                     {:entity e, :ref ref}))))\n   556\t          decode (fn [e]\n   557\t                   (let [ia (get attrs e)\n   558\t                         mnem (:yin.code/op ia)\n   559\t                         opcode (or (get vm/opcode-table\n   560\t                                        (get mnemonic-aliases mnem mnem))\n   561\t                                    (throw (ex-info \"Mnemonic has no opcode\"\n   562\t                                                    {:op mnem, :entity e})))]\n   563\t                     (case mnem\n   564\t                       :const [opcode (:yin.code/value ia)]\n   565\t                       :var [opcode (:yin.code/name ia)]\n   566\t                       :closure [opcode (:yin.code/params ia)\n   567\t                                 (resolve-ref e (:yin.code/body ia))]\n   568\t                       :call (if (:yin.code/tail? ia)\n   569\t                               [(:tailcall vm/opcode-table) (:yin.code/argc ia)]\n   570\t                               [opcode (:yin.code/argc ia)])\n   571\t                       :return [opcode]\n   572\t                       :jump [opcode (resolve-ref e (:yin.code/target ia))]\n   573\t                       :branch-false [opcode\n   574\t                                      (resolve-ref e (:yin.code/target ia))]\n   575\t                       :halt [opcode]\n   576\t                       :gensym [opcode (or (:yin.code/prefix ia) \"id\")]\n   577\t                       :store-get [opcode (:yin.code/key ia)]\n   578\t                       :store-put [opcode (:yin.code/key ia)\n   579\t                                   (:yin.code/value ia)]\n   580\t                       :stream-make [opcode (or (:yin.code/buffer ia)\n   581\t                                                vm/default-stream-capacity)]\n   582\t                       :stream-put [opcode]\n   583\t                       :stream-cursor [opcode]\n   584\t                       :stream-next [opcode]\n   585\t                       :stream-close [opcode]\n   586\t                       :park [opcode]\n   587\t                       :resume [opcode (:yin.code/parked-id ia)]\n   588\t                       :current-continuation [opcode]\n   589\t                       :ffi-call [opcode (:yin.code/ffi-op ia)\n   590\t                                  (or (:yin.code/argc ia) 0)]\n   591\t                       :push [opcode]\n   592\t                       (throw (ex-info \"Unknown mnemonic\"\n   593\t                                       {:op mnem, :entity e})))))]\n   594\t      {:segment seg,\n   595\t       :length (get-in attrs [seg :yin.code/length]),\n   596\t       :code (mapv decode instructions)})))\n   597\t\n   598\t\n   599\t(defn- store-image\n   600\t  \"Register one decoded image under its segment id, returning the code map.\n   601\t\n   602\t   Segment identity is stable: continuations, frames, and closures name\n   603\t   segments by id, so an id must never come to mean different code. An\n   604\t   identical reload — a batch re-sent, a batch run twice — decodes to the\n   605\t   same image and is accepted. A different image under a live id is a\n   606\t   conflict, and loading it fails rather than silently redirecting every\n   607\t   continuation that names the id.\"\n   608\t  [code image]\n   609\t  (let [seg (:segment image)]\n   610\t    (if-let [existing (find code seg)]\n   611\t      (if (= (val existing) image)\n   612\t        code\n   613\t        (throw (ex-info \"Cannot load segment: the id already holds different code\"\n   614\t                        {:segment seg})))\n   615\t      (assoc code seg image))))\n   616\t\n   617\t\n   618\t(defn vm-load-program\n   619\t  \"Load one `:yin.code/*` batch: validate it, decode it, store the image under\n   620\t   `:code {segment-id image}`, and set control to `{:segment id :pc 0}`.\n   621\t\n   622\t   This is the loader a composition hands to `dao.stream.observer/\n   623\t   run-on-stream` beside `engine/ready-for-ingress?` and the VM's runner; a\n   624\t   composition whose program stream carries `:yin/*` AST datoms composes the\n   625\t   Phase 2 linearizer in front of it. Parked continuations survive a load, so\n   626\t   one segment can resume another's. A segment id already holding different\n   627\t   code is a load error; loading the same image again is accepted.\"\n   628\t  [vm datoms]\n   629\t  (let [image (load-image datoms)]\n   630\t    (assoc vm\n   631\t           :program (:segment image)\n   632\t           :code (store-image (:code vm) image)\n   633\t           :control {:segment (:segment image), :pc 0}\n   634\t           :stack []\n   635\t           :k nil\n   636\t           :halted? false\n   637\t           :blocked? false\n   638\t           :value nil)))\n   639\t\n   640\t\n   641\t;; =============================================================================\n   642\t;; SemanticVM Protocol Implementation\n   643\t;; =============================================================================\n   644\t\n   645\t(defn- vm-reset\n   646\t  \"Reset execution state, preserving loaded code.\"\n   647\t  [vm]\n   648\t  (assoc vm\n   649\t         :control (when-let [seg (:program vm)] {:segment seg, :pc 0})\n   650\t         :k nil\n   651\t         :stack []\n   652\t         :value nil\n   653\t         :halted? (nil? (:program vm))\n   654\t         :blocked? false))\n   655\t\n   656\t\n   657\t(defn- vm-eval\n   658\t  \"Resume loaded work. An AST is refused: lowering belongs to\n   659\t   `yin.vm.linearize` (Phase 2) and is composed in at the observer\n   660\t   boundary, so this evaluator never learns which form travels.\"\n   661\t  [vm ast]\n   662\t  (when ast\n   663\t    (throw (ex-info\n   664\t             \"The semantic VM executes :yin.code/* segments: lower :yin/* ASTs with yin.vm.linearize (Phase 2) or call vm-load-program with a code batch\"\n   665\t             {:ast ast})))\n   666\t  (let [initial-env (:env vm)\n   667\t        res (vm/run vm)]\n   668\t    (engine/restore-initial-env initial-env res)))\n   669\t\n   670\t\n   671\t(extend-type SemanticVM\n   672\t  vm/IVM\n   673\t  (step [vm]\n   674\t    (telemetry/emit-snapshot\n   675\t      (if (engine/ready-for-ingress? vm) vm (vm-hot vm 1))\n   676\t      :step))\n   677\t  (run [vm] (ffi/maybe-run vm semantic-run-scheduler))\n   678\t  (eval [vm ast] (vm-eval vm ast))\n   679\t  (reset [vm] (vm-reset vm))\n   680\t  (halted? [vm] (engine/halted-with-empty-queue? vm))\n   681\t  (blocked? [vm] (engine/vm-blocked? vm))\n   682\t  (value [vm] (engine/vm-value vm))\n   683\t  vm/IVMState\n   684\t  (control [vm] (:control vm))\n   685\t  (environment [vm] (:env vm))\n   686\t  (store [vm] (:store vm))\n   687\t  (continuation [vm] (:k vm)))\n   688\t\n   689\t\n   690\t(defn create-vm\n   691\t  \"Create a new SemanticVM.\n   692\t\n   693\t   Options:\n   694\t     :env           initial lexical environment\n   695\t     :primitives    primitive operations map\n   696\t     :modules       module registry value (see `yin.vm.module`)\n   697\t     :make-stream   (fn [capacity] -> create outcome); no default\n   698\t     :call-in       explicit inbound request handle\n   699\t     :call-out      explicit outbound response handle\n   700\t     :call-capacity capacity for a constructed FFI pair\n   701\t     :bridge        host FFI handlers\n   702\t\n   703\t   As for the walker: there is no `:in-stream` (program observation belongs\n   704\t   to `dao.stream.observer`), and construction is all-or-nothing — the FFI\n   705\t   pair and its call-out cursor are stream operations whose failure fails\n   706\t   here.\"\n   707\t  ([] (create-vm {}))\n   708\t  ([opts]\n   709\t   (when (contains? opts :in-stream)\n   710\t     (throw (ex-info\n   711\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n   712\t              {:in-stream (:in-stream opts)})))\n   713\t   (let [env (or (:env opts) {})\n   714\t         base (vm/empty-state\n   715\t                (assoc (select-keys opts\n   716\t                                    [:primitives :modules :make-stream :call-in\n   717\t                                     :call-out :call-capacity])\n   718\t                       :telemetry (:telemetry opts)\n   719\t                       :vm-model :semantic))]\n   720\t     (-> (map->SemanticVM (merge base\n   721\t                                 {:bridge nil,\n   722\t                                  :program nil,\n   723\t                                  :control nil,\n   724\t                                  :env env,\n   725\t                                  :stack [],\n   726\t                                  :k nil,\n   727\t                                  :value nil,\n   728\t                                  :code {},\n   729\t                                  :halted? true,\n   730\t                                  :blocked? false}))\n   731\t         (telemetry/install :semantic)\n   732\t         (ffi/attach (:bridge opts))\n   733\t         (telemetry/emit-snapshot :init)))))\n","exit_code":0,"status":"completed"}}
