                          true))]\\n   347\\t      (is (= \\\"done\\\" (vm/value vm)))\\n   348\\t      (is (vm/halted? vm))\\n   349\\t      (is (nil? (vm/continuation vm)))))\\n   350\\t  (testing \\\"At depth 10⁵ a park point sees one frame and an empty stack\\\"\\n   351\\t    (let [vm (run-segment (countdown 100000 :park [] true))\\n   352\\t          parked (vm/value vm)]\\n   353\\t      (is (= :parked-continuation (:type parked)))\\n   354\\t      (is (= 1 (count (:k parked)))\\n   355\\t          \\\"the tail call grew neither K nor St: only the main frame remains\\\")\\n   356\\t      (is (= [] (:stack parked)))\\n   357\\t      (is (= 0 (get (:env parked) 'n))\\n   358\\t          \\\"the parked env is the body's, not the caller's\\\")\\n   359\\t      (is (= 17 (:pc parked)))\\n   360\\t      (is (vm/halted? vm))\\n   361\\t      (testing \\\"and resuming it completes the countdown\\\"\\n   362\\t        (let [vm' (run-segment vm (resume-segment :parked-0 :resumed))]\\n   363\\t          (is (= :resumed (vm/value vm')))\\n   364\\t          (is (vm/halted? vm'))\\n   365\\t          (is (empty? (:parked vm')))))))\\n   366\\t  (testing \\\"Without the tail flag the same program grows a frame per call\\\"\\n   367\\t    (let [vm (run-segment (countdown 1000 :park [] false))\\n   368\\t          parked (vm/value vm)]\\n   369\\t      (is (= 1001 (count (:k parked)))\\n   370\\t          \\\"the main frame plus one per non-tail recursive call\\\")\\n   371\\t      (testing \\\"and resuming it unwinds every frame\\\"\\n   372\\t        (let [vm' (run-segment vm (resume-segment :parked-0 :unwound))]\\n   373\\t          (is (= :unwound (vm/value vm')))\\n   374\\t          (is (vm/halted? vm')))))))\\n   375\\t\\n   376\\t\\n   377\\t;; =============================================================================\\n   378\\t;; Park and resume\\n   379\\t;; =============================================================================\\n   380\\t\\n   381\\t(de