g \"~#link\") (link\n                         (parse-node cache rep :value handlers default-handler))\n      (= tag \"~#with-meta\")\n      (let [items (parse-node cache rep :value handlers default-handler)]\n        (with-meta (first items) (second items)))\n      :else\n      (let [tag-name (subs tag 2)\n            handler (get handlers tag-name)]\n        (cond handler\n              (handler\n                (parse-node cache rep :value handlers default-handler))\n              default-handler\n              (default-handler\n                (parse-node cache rep :value handlers default-handler))\n              :else\n              (tagged-value\n                tag-name\n                (parse-node cache rep :value handlers default-handler)))))))\n\n\n(defn- tagged-list-head?\n  [x]\n  (and (string? x)\n       (or (= x \"^ \")\n           (and (>= (count x) 2)\n                (= (code-unit x 0) 126)\n                (= (code-unit x 1) 35)))))\n\n\n(defn- parse-node\n  [cache x position handlers default-handler]\n  (cond\n    (nil? x) nil\n    (string? x) (parse-string-token cache x position handlers default-handler)\n(ns dao.stream.transit-test\n  (:require\n    #?@(:cljd [[\"dart:core\" StringBuffer]])\n    [clojure.test :refer [deftest is testing]]\n    [dao.stream.apply :as dao-apply]\n    [dao.stream.transit :as transit]))\n\n\n(defrecord Point\n  [x y])\n\n\n(defn- write-str\n  ([v] (write-str v nil))\n  ([v opts]\n   #?(:clj (let [out (java.io.ByteArrayOutputStream.)]\n             (transit/write (transit/writer out :json opts) v)\n             (.toString out \"UTF-8\"))\n      :cljs (transit/write (transit/writer nil :json opts) v)\n      :cljd (let [out (StringBuffer.)]\n              (transit/write (transit/writer out :json opts) v)\n              (.toString out)))))\n\n\n(defn- read-str\n  ([s] (read-str s nil))\n  ([s opts]\n   #?(:clj (let [in (java.io.ByteArrayInputStream. (.getBytes s \"UTF-8\"))]\n             (transit/read (transit/reader in :