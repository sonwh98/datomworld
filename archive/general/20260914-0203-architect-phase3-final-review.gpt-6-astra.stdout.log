55-   Returns {:state s'}.\\\"\\n256-  [state effect]\\n257-  (let [stream-ref (:stream effect)\\n258-        stream-id (:id stream-ref)\\n259-        handle (get (:store state) stream-id)]\\n--\\n451:          :stream/make\\n452-          (let [[id s'] (gensym state \\\"stream\\\")\\n453-                [stream-ref new-state] (handle-make s' effect id)]\\n454-            {:state new-state, :value stream-ref, :blocked? false})\\n455:          :stream/cursor\\n456-          (let [[id s'] (gensym state \\\"cursor\\\")\\n457-                [cursor-ref new-state] (handle-cursor s' effect id)]\\n458-            {:state new-state, :value cursor-ref, :blocked? false})\\n459-          :stream/put\\n460-          (let [result (handle-put state effect)]\\n461-            (if (:park result)\\n462-              (let [built-entry (when park-entry\\n463-                                  (park-entry state effect result))\\n464-                    built-entry (if (and built-entry (not (:datom built-entry)))\\n465-                                  (assoc built-entry :datom (:val effect))\\n466-                                  built-entry)]\\n467-                (handle-stream-block result built-entry))\\n468-              {:state (:state result),\\n469-               :value (:value result),\\n470-               :blocked? false}))\\n471-          :stream/next\\n472-          (let [result (handle-next state effect)]\\n473-            (if (:park result)\\n474-              (let [built-entry (when park-entry\\n475-                                  (park-entry state effect result))]\\n476-                (handle-stream-block result built-entry))\\n477-              {:state (:state result),\\n478-               :value (:value result),\\n479-               :blocked? false}))\\n480-          :stream/close\\n481-          (let [close-result (handle-close state effect)]\\n482-            {:state (:state close-result), :value nil, :blocked? false})\\n483-          (let [[id s'] (gensym state \\\"effect\\\")\\n484-                handler (module/get-effect-handler (:modules state)\\n485-                                                   (:effect effect))]\\n486-            (if handler\\n487-              (handler s' effect (assoc opts :id id))\\n488-              (fail \\\"Unknown effect\\\" {:effect (:effect effect)}))))]\\n489-    (update result\\n490-            :state\\n491-            (fn [result-state]\\n492-              (telemetry/emit-snapshot (assoc result-state\\n493-                                              :value (:value result))\\n494-                                       :effect\\n495-                                       {:effect-type (:effect effect)})))))\\n496-\\n497-\\n498-;; =============================================================================\\n499-;; Program Cache Machinery\\n500-;; =============================================================================\\n501-\\n502-(def default-compiled-cache-limit 8)\\n503-(def ^:private derived-metadata-eid (:db/derived datom/reserved))\\n504-\\n505-\\n506-(defn build-program-index\\n507-  [datoms]\\n508-  (group-by first (vec datoms)))\\n509-\\n510-\\nsrc/cljc/yin/vm/linearize.cljc:3:   (`:yin.code/*`), per `docs/design/yin.vm.semantic.md` §5.\\nsrc/cljc/yin/vm/linearize.cljc:269:(defn ast-loader\\ntest/yin/repl_core_test.cljc:72:(deftest the-vm-command-offers-the-ast-walker-and-the-semantic-vm\\ntest/yin/repl_core_test.cljc:74:        [state' semantic] (core/eval-input state \\\"(vm :semantic)\\\")\\ntest/yin/repl_core_test.cljc:77:    (is (= \\\"Switched to SemanticVM (store cleared)\\\" semantic))\\ntest/yin/repl_core_test.cljc:78:    (is (= :semantic (:vm-type state')))\\ntest/yin/repl_core_test.cljc:80:    (is (str/includes? rejected \\\":semantic\\\"))))\\ntest/yin/repl_core_test.cljc:83:(deftest the-semantic-vm-evaluates-through-the-lowering-loader\\ntest/yin/repl_core_test.cljc:86:  (let [semantic-state #(first (core/eval-input (core/create-state) \\\"(vm :semantic)