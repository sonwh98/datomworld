t/yin/vm/attach_image_test.cljc\n M test/yin/vm/completion_test.cljc\n M test/yin/vm/data_test.cljc\n M test/yin/vm/debruijn/register_test.cljc\n M test/yin/vm/debruijn/stack_effects_test.cljc\n M test/yin/vm/debruijn_vm_contract_test.cljc\n M test/yin/vm/heap_reclamation_test.cljc\n M test/yin/vm/linker_require_test.cljc\n M test/yin/vm/parity_test.cljc\n M test/yin/vm/semantic_test.cljc\n?? collab/1790800251738-architect-heap-reclamation.claude-fable-5-1.findings.md\n?? collab/1790836430996-reviewer-heap-reclamation-gate.gemini-3.1-pro-high.findings.md\n?? collab/1790849347441-architect-d7-host-typed-closures-continuations.claude-fable-5-1.findings.md\n?? collab/1790851062697-vm-engineer-d7-host-typed-closures.claude-opus-5-5.report.md\n?? collab/1790851062697-vm-engineer-d7-host-typed-closures.prompt.md\n?? src/cljc/yin/vm/values.cljc\n?? test/yin/vm/host_typed_values_test.cljc\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-wdwKGnO2' (errno=Operation not permitted)\n2026-10-01 18:21:54.355 xcodebuild[403:36806144]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-01 18:21:54.574 xcodebuild[403:36806143] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-msuVhXV7' (errno=Operation not permitted)\n2026-10-01 18:21:55.223 xcodebuild[407:36806218]  DVTFilePathFSEvents: Failed to start fs event stream.\n2026-10-01 18:21:55.438 xcodebuild[407:36806217] [MT] DVTDeveloperPaths: Failed to get length of DARWIN_USER_CACHE_DIR from confstr(3), error = Error Domain=NSPOSIXErrorDomain Code=5 \"Input/output error\". Using NSCachesDirectory instead.\n src/cljc/datomworld/demo/continuation_handoff.cljc |  44 ++--\n src/cljc/yang/python/antlr/prelude.cljc            |  12 +-\n src/cljc/yin/repl.cljc                             |   4 +\n src/cljc/yin/vm.cljc                               |  46 +++-\n src/cljc/yin/vm/ast_walker.cljc                    | 270 ++++++++++++---------\n src/cljc/yin/vm/completion.cljc                    |  25 +-\n src/cljc/yin/vm/data.cljc                          |  25 +-\n src/cljc/yin/vm/debruijn/register.cljc             |  71 +++---\n src/cljc/yin/vm/debruijn/stack.cljc                |  65 ++---\n src/cljc/yin/vm/debruijn_register_effects.cljc     |  12 +-\n src/cljc/yin/vm/debruijn_resolve.cljc              |   3 +-\n src/cljc/yin/vm/docs/ast.md                        |  88 ++++---\n src/cljc/yin/vm/docs/co-routines.md                |   4 +-\n src/cljc/yin/vm/docs/state.md                      |  12 +-\n src/cljc/yin/vm/engine.cljc                        | 170 +++++++++----\n src/cljc/yin/vm/linearize.cljc                     |   5 +-\n src/cljc/yin/vm/module.cljc                        |  20 +-\n src/cljc/yin/vm/semantic.cljc                      |  78 +++---\n test/yang/clojure_test.clj                         |   5 +-\n test/yin/vm/ast_walker_test.cljc                   |   8 +-\n test/yin/vm/attach_image_test.cljc                 |  47 ++--\n test/yin/vm/completion_test.cljc                   |  15 +-\n test/yin/vm/data_test.cljc                         |  30 ++-\n test/yin/vm/debruijn/register_test.cljc            |   7 +-\n test/yin/vm/debruijn/stack_effects_test.cljc       |   9 +-\n test/yin/vm/debruijn_vm_contract_test.cljc         |   7 +-\n test/yin/vm/heap_reclamation_test.cljc             |   5 +-\n test/yin/vm/linker_require_test.cljc               |  10 +-\n test/yin/vm/parity_test.cljc                       |   6 +-\n test/yin/vm/semantic_test.cljc                     |  11 +-\n 30 files changed, 714 insertions(+), 400 deletions(-)\n","exit_code":0,"status":"completed"}