{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/jing/content.cljc | sed -n '1,240p'; nl -ba src/cljc/dao/jing.cljc | sed -n '475,520p'; nl -ba src/cljc/dao/jing/coordinate.cljc | sed -n '1,230p'\"","aggregated_output":"     1\t(ns dao.jing.content\n     2\t  \"Content lookup as a request and response service over remote streams\n     3\t   (docs/design/dao.stream.remote.md, section 5; the successor of the\n     4\t   deleted dao.jing.remote). One payload convention, spoken by every half\n     5\t   of the service and by the linker's own client:\n     6\t\n     7\t     {:jing/request r :jing/get address}\n     8\t       answered by {:jing/request r :jing/found? b :jing/bytes b64};\n     9\t     {:jing/request r :jing/put address :jing/bytes b64}\n    10\t       answered by {:jing/request r :jing/result :inserted | :present}.\n    11\t\n    12\t   r is a self-minted random value, so callers sharing one answers stream\n    13\t   do not collide. Bytes travel as padded standard Base64 text in the\n    14\t   application value; message boundaries are the channel codec's, one\n    15\t   application value per message, so the vocabulary rides Transit-JSON\n    16\t   text or canonical CBOR alike.\n    17\t\n    18\t   This namespace is the serving half: serve-step, the interpreter over a\n    19\t   local requests reader and answers writer against a dao.jing handle --\n    20\t   the Linda shape, one peer's table entry pair and its policy. The\n    21\t   client half is dao.jing.content.step; the JVM blocking driver is\n    22\t   dao.jing.content.driver; the callback facade is\n    23\t   dao.jing.content.async. Every put passes through the one ingress\n    24\t   canonicality check, dao.jing/accept-bytes!.\"\n    25\t  (:require [dao.jing :as jing]\n    26\t            [dao.stream :as stream]))\n    27\t\n    28\t\n    29\t(def get-op\n    30\t  \"The request key of a content read.\"\n    31\t  :jing/get)\n    32\t\n    33\t\n    34\t(def put-op\n    35\t  \"The request key of a content write.\"\n    36\t  :jing/put)\n    37\t\n    38\t\n    39\t(defn- valid-handle!\n    40\t  \"Throw unless `handle` exposes the byte-store effects the interpreter\n    41\t   calls; the error is a composition defect, not a wire event.\"\n    42\t  [handle]\n    43\t  (when-not (ifn? (:put-bytes-fn handle))\n    44\t    (throw (ex-info \"a content handle must expose a :put-bytes-fn\"\n    45\t                    {:handle handle})))\n    46\t  (when-not (ifn? (:get-bytes-fn handle))\n    47\t    (throw (ex-info \"a content handle must expose a :get-bytes-fn\"\n    48\t                    {:handle handle})))\n    49\t  handle)\n    50\t\n    51\t\n    52\t(defn- get-request?\n    53\t  \"True only for the exact read request {:jing/request r :jing/get a}.\"\n    54\t  [v]\n    55\t  (and (map? v) (= #{:jing/request :jing/get} (set (keys v)))))\n    56\t\n    57\t\n    58\t(defn- put-request?\n    59\t  \"True only for the exact write request {:jing/request r :jing/put a\n    60\t   :jing/bytes b64}.\"\n    61\t  [v]\n    62\t  (and (map? v)\n    63\t       (= #{:jing/request :jing/put :jing/bytes} (set (keys v)))))\n    64\t\n    65\t\n    66\t(defn- append-answer!\n    67\t  \"Deliver one answer value; the writer's refusal loses that one answer,\n    68\t   exactly as any transport loses a message -- the caller's own retry or\n    69\t   timeout policy owns the loss, never the interpreter.\"\n    70\t  [answers value]\n    71\t  (stream/append! answers value)\n    72\t  nil)\n    73\t\n    74\t\n    75\t(defn- serve-one!\n    76\t  \"Answer one well-formed request, or drop it as malformed wire input:\n    77\t   a value that is neither an exact read nor an exact write, a read of a\n    78\t   non-address, and a write whose bytes fail the ingress check are all\n    79\t   dropped -- no answer, the cursor advances past them, and the caller's\n    80\t   outstanding request owns the silence. A backend verdict outside\n    81\t   #{:inserted :present} is a composition defect and throws here, before\n    82\t   the cursor moves, so the same request is re-read once the backend is\n    83\t   fixed (the observer's effect rule, docs/design/dao.jing.md).\"\n    84\t  [handle answers v]\n    85\t  (let [r (get v :jing/request)\n    86\t        missing #?(:clj (Object.) :cljs (js-obj) :cljd (Object.))]\n    87\t    (cond\n    88\t      (and (get-request? v) (jing/segment-address? (get v get-op)))\n    89\t      (let [address (get v get-op)\n    90\t            result ((:get-bytes-fn handle) address missing)]\n    91\t        (if (identical? result missing)\n    92\t          (append-answer! answers {:jing/request r, :jing/found? false,\n    93\t                                   :jing/bytes nil})\n    94\t          (append-answer! answers {:jing/request r, :jing/found? true,\n    95\t                                   :jing/bytes (jing/bytes->base64\n    96\t                                                 result)})))\n    97\t\n    98\t      (and (put-request? v) (jing/segment-address? (get v put-op)))\n    99\t      (let [address (get v put-op)\n   100\t            verdict (if-some [bs (try (jing/accept-bytes!\n   101\t                                        address (get v :jing/bytes))\n   102\t                                      (catch #?(:cljd Object\n   103\t                                                :clj Throwable\n   104\t                                                :cljs :default)\n   105\t                                             _\n   106\t                                        nil))]\n   107\t                      ((:put-bytes-fn handle) address bs)\n   108\t                      ::refused)]\n   109\t        (when-not (= ::refused verdict)\n   110\t          (when-not (#{:inserted :present} verdict)\n   111\t            (throw (ex-info \"backend returned an invalid put result\"\n   112\t                            {:address address, :result verdict})))\n   113\t          (append-answer! answers {:jing/request r, :jing/result verdict})))\n   114\t\n   115\t      ;; anything else is malformed wire input, dropped below the step\n   116\t      :else nil)))\n   117\t\n   118\t\n   119\t(defn serve-step\n   120\t  \"One non-waiting advance of the content interpreter: answer at most\n   121\t   `budget` requests read from `requests` at `cursor`, appending each\n   122\t   answer to `answers`, and return the successor cursor. Like its\n   123\t   sibling the mirror step, this holds no state between calls beyond the\n   124\t   reader's cursor, and a blocked read stops the step. This is an\n   125\t   interpreter step -- it performs stream operations -- under a\n   126\t   single-owner precondition: one caller, one cursor thread.\"\n   127\t  [handle requests cursor answers budget]\n   128\t  (valid-handle! handle)\n   129\t  (loop [cursor cursor\n   130\t         left budget]\n   131\t    (if (pos? left)\n   132\t      (let [r (stream/next requests cursor)]\n   133\t        (if (= :dao.stream/ok (:dao.stream/outcome r))\n   134\t          (do (serve-one! handle answers (:dao.stream/value r))\n   135\t              (recur (:dao.stream/cursor r) (dec left)))\n   136\t          cursor))\n   137\t      cursor)))\n   475\t  \"The canonical payload bytes carried by the Base64 text b64 at address,\n   476\t   or a throw: this is the one ingress canonicality check for bytes Jing\n   477\t   did not encode itself (docs/design/dao.jing.cbor.md, Layering and\n   478\t   interfaces). The text must be strict padded standard-alphabet Base64,\n   479\t   the bytes must hash to the address under its carried algorithm, and\n   480\t   they must decode as exactly one canonical payload. Every entry of\n   481\t   remote content runs this one check: the dao.jing.content interpreter\n   482\t   on every put, the stepped client on every get answer and :present\n   483\t   verify, and the linker on every answer it admits. A refusal is an\n   484\t   ex-info whose data carries {:address address :reason k} with k one of\n   485\t   :segment-address, :base64, :hash-mismatch, :non-canonical.\"\n   486\t  [address b64]\n   487\t  (when-not (segment-address? address)\n   488\t    (throw (ex-info \"content address must be a segment address\"\n   489\t                    {:address address, :reason :segment-address})))\n   490\t  (let [bs (try (base64->bytes b64)\n   491\t                (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   492\t                  (throw (ex-info \"content bytes are not strict Base64\"\n   493\t                                  {:address address\n   494\t                                   :reason :base64}))))]\n   495\t    (when-not (segment-bytes-match? address bs)\n   496\t      (throw (ex-info \"content address does not match payload hash\"\n   497\t                      {:address address, :reason :hash-mismatch})))\n   498\t    (try (cbor/decode bs)\n   499\t         (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   500\t           (throw (ex-info \"content payload is not one canonical payload\"\n   501\t                           {:address address, :reason :non-canonical}))))\n   502\t    bs))\n   503\t\n   504\t\n   505\t(defn materialize!\n   506\t  \"Content-address payload and store it through the handle's byte store.\n   507\t\n   508\t   Supports [handle payload] (defaulting to default-hash-algorithm, :blake3)\n   509\t   and [handle payload {:keys [algorithm]}].\n   510\t\n   511\t   The payload is encoded exactly once. The address is derived solely from\n   512\t   those canonical bytes, and the same bytes go to the backend effect\n   513\t   :put-bytes-fn as (put-bytes-fn address bytes). The backend must answer\n   514\t   with one of:\n   515\t\n   516\t     :inserted -- the bytes are durably stored now;\n   517\t     :present  -- bytes are already stored under that address.\n   518\t\n   519\t   Any other answer is an invalid backend result and throws: DaoJing does\n   520\t   not accept ambiguous truthiness. The address is returned only after the\n     1\t(ns dao.jing.coordinate\n     2\t  \"Explicit interpreter from serializable DaoJing coordinates to local live\n     3\t   content-store handles. Coordinates are data; this namespace owns the\n     4\t   closed-world interpretation of the backends implemented in this release.\"\n     5\t  (:require [dao.jing.content.step :as step]\n     6\t            [dao.jing.file :as file]\n     7\t            [dao.stream :as stream]\n     8\t            #?@(:cljd []\n     9\t                :clj [[dao.jing.content.driver :as driver]])))\n    10\t\n    11\t\n    12\t(defn- validate-file!\n    13\t  [{:keys [path], :as coordinate}]\n    14\t  (when-not (and (= #{:dao.jing/type :path} (set (keys coordinate)))\n    15\t                 (string? path)\n    16\t                 (not (empty? path)))\n    17\t    (throw (ex-info \"invalid file-backed DaoJing coordinate\"\n    18\t                    {:coordinate coordinate})))\n    19\t  coordinate)\n    20\t\n    21\t\n    22\t(defn- validate-remote!\n    23\t  \"The two-descriptor coordinate (docs/design/dao.stream.remote.md,\n    24\t   section 5): a requests descriptor the client writes and an answers\n    25\t   descriptor the client reads, both plain data -- the :url form and its\n    26\t   options are gone with the module that spoke them.\"\n    27\t  [{:dao.jing/keys [requests answers], :as coordinate}]\n    28\t  (when-not (and (= #{:dao.jing/type :dao.jing/requests :dao.jing/answers}\n    29\t                    (set (keys coordinate)))\n    30\t                 (map? requests)\n    31\t                 (map? answers))\n    32\t    (throw (ex-info \"invalid remote DaoJing coordinate\"\n    33\t                    {:coordinate coordinate})))\n    34\t  coordinate)\n    35\t\n    36\t\n    37\t(defn- attach-open!\n    38\t  \"Attach one descriptor through the composition's attach entry and\n    39\t   return its handle; any other outcome throws, so nothing half-attached\n    40\t   escapes to the caller.\"\n    41\t  [attach! descriptor role]\n    42\t  (let [result (attach! descriptor)]\n    43\t    (if-not (= :dao.stream/ok (:dao.stream/outcome result))\n    44\t      (throw (ex-info \"the remote DaoJing coordinate refused an attachment\"\n    45\t                      {:role role\n    46\t                       :descriptor descriptor\n    47\t                       :result (dissoc result :dao.stream/handle)}))\n    48\t      (:dao.stream/handle result))))\n    49\t\n    50\t\n    51\t(defn- newest\n    52\t  \"The cursor `handle` mints at :newest -- or the anchor itself when the\n    53\t   mint must wait for the far end (a reflection's cursor ask is answered\n    54\t   across the channel), which the stepped client resolves on its first\n    55\t   polls.\"\n    56\t  [handle]\n    57\t  (let [r (stream/cursor handle stream/anchor-newest)]\n    58\t    (if (= :dao.stream/ok (:dao.stream/outcome r))\n    59\t      (:dao.stream/cursor r)\n    60\t      stream/anchor-newest)))\n    61\t\n    62\t\n    63\t(defn- open-remote\n    64\t  \"Attach both descriptors through the composition's :dao.jing/attach\n    65\t   entry (host composition data: the transport's own attach function or\n    66\t   dispatch closure -- a coordinate never carries one, being data), and\n    67\t   resolve to the blocking driver on the JVM and to the stepped client\n    68\t   elsewhere. :dao.jing/options carries the driver's timing options.\"\n    69\t  [{:dao.jing/keys [requests answers]} opts]\n    70\t  (let [attach! (get opts :dao.jing/attach)]\n    71\t    (when-not (ifn? attach!)\n    72\t      (throw (ex-info\n    73\t               \"a remote DaoJing coordinate needs a :dao.jing/attach entry\n    74\t                in the open options\"\n    75\t               {:opts opts})))\n    76\t    (let [requests-handle (attach-open! attach! requests :requests)\n    77\t          answers-handle (attach-open! attach! answers :answers)\n    78\t          client-state (step/client-state requests-handle answers-handle\n    79\t                                          (newest answers-handle))]\n    80\t      #?(:clj (driver/driver client-state\n    81\t                             (or (get opts :dao.jing/options) {}))\n    82\t         :default client-state))))\n    83\t\n    84\t\n    85\t(defn open!\n    86\t  \"Open a serializable content-store coordinate as a live DaoJing handle,\n    87\t   with the composition's open `opts`. Unsupported coordinate types fail\n    88\t   closed; no runtime registry is consulted. A :dao.jing/remote\n    89\t   coordinate opens through opts: {:dao.jing/attach f} attaches its two\n    90\t   descriptors, and {:dao.jing/options o} carries the JVM driver's\n    91\t   timing options; on the JVM the resolution is the blocking driver,\n    92\t   elsewhere the stepped client state the caller owns and steps.\"\n    93\t  [{coordinate-type :dao.jing/type, :as coordinate} opts]\n    94\t  (case coordinate-type\n    95\t    :dao.jing/file (file/create-content-file (:path (validate-file!\n    96\t                                                      coordinate)))\n    97\t    :dao.jing/remote (open-remote (validate-remote! coordinate) opts)\n    98\t    (throw (ex-info \"unsupported DaoJing content-store coordinate\"\n    99\t                    {:coordinate coordinate}))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/clj/dao/jing/content/driver.clj | sed -n '1,260p'; nl -ba src/cljc/dao/jing/content/async.cljc | sed -n '1,260p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/clj/dao/jing/content/driver.clj | sed -n '1,260p'; nl -ba src/cljc/dao/jing/content/async.cljc | sed -n '1,260p'\"","aggregated_output":"     1\t(ns dao.jing.content.driver\n     2\t  \"The JVM blocking driver over the stepped content client\n     3\t   (dao.jing.content.step): host policy that steps the client and\n     4\t   sleeps, returning a synchronous dao.jing content handle. It replaces\n     5\t   the deleted dao.jing.remote blocking constructor; its consumers are\n     6\t   the coordinate opener (dao.jing.coordinate/open!) and, through it,\n     7\t   dao.space and yin.repl.link on the JVM. yin.vm.content has no remote\n     8\t   path of its own: it gains one only by being handed a\n     9\t   coordinate-built handle.\n    10\t\n    11\t   The returned handle is the plain-data map dao.jing/materialize!,\n    12\t   dao.jing/get, and dao.jing/close! dispatch through:\n    13\t   {:client c :closed-atom a :put-bytes-fn f :get-bytes-fn g\n    14\t    :close-fn h}. A put sends the bytes as Base64 text and answers the\n    15\t   remote verdict; a get decodes the answer the server answers and\n    16\t   admits it as ingress -- the dao.jing/accept-bytes! check, which the\n    17\t   stepped client runs on every found reply -- before its bytes leave\n    18\t   this handle. JVM-only, so the whole namespace is plain Clojure.\"\n    19\t\n    20\t  (:require [dao.jing :as jing]\n    21\t            [dao.jing.content.step :as step]\n    22\t            [dao.stream :as stream]))\n    23\t\n    24\t\n    25\t(def default-request-timeout-ms\n    26\t  \"How long one call may wait for its completion, in milliseconds.\"\n    27\t  5000)\n    28\t\n    29\t\n    30\t(def default-poll-interval-ms\n    31\t  \"How long the driver sleeps between advances, in milliseconds.\"\n    32\t  10)\n    33\t\n    34\t\n    35\t(def ^:private poll-budget\n    36\t  \"How many answers one blocking-driver advance may consume. A poll\n    37\t   stops at the first blocked read, so this bounds a burst, not a\n    38\t   wait.\"\n    39\t  32)\n    40\t\n    41\t\n    42\t(def max-timing-ms\n    43\t  \"The largest supported timing-option value, in milliseconds: one\n    44\t   day. A timing option bounds how long one call may wait, and a day\n    45\t   is a chosen policy limit on that; the upper bound is what keeps the\n    46\t   deadline arithmetic inside long range after submission.\"\n    47\t  86400000)\n    48\t\n    49\t\n    50\t(defn- valid-handle!\n    51\t  \"Throw unless the step state's pair is present: the driver drives\n    52\t   what client-state built, and a composition defect must throw here\n    53\t   rather than surface as a stuck call.\"\n    54\t  [step-state]\n    55\t  (when-not (and (stream/writer? (:requests step-state))\n    56\t                 (stream/reader? (:answers step-state)))\n    57\t    (throw (ex-info\n    58\t             \"the driver's step state needs a requests writer and an\n    59\t              answers reader\"\n    60\t             {:step-state step-state})))\n    61\t  step-state)\n    62\t\n    63\t\n    64\t(defn- validate-timing-options!\n    65\t  \"Timing options are client data a caller can assoc onto, so the\n    66\t   driver validates them before submitting anything: an argument\n    67\t   defect throws here, before the wire, leaving the stored state\n    68\t   untouched. The supported domain is int-shaped milliseconds from 1\n    69\t   to max-timing-ms inclusive; the upper bound is what keeps the\n    70\t   deadline arithmetic safe over every value that passes the gate.\"\n    71\t  [options]\n    72\t  (doseq [[option value] options]\n    73\t    (when-not (and (int? value) (<= 1 value max-timing-ms))\n    74\t      (throw (ex-info (str \"timing option \" (name option)\n    75\t                           \" must be an integer of milliseconds from 1 to \"\n    76\t                           max-timing-ms \" (one day)\")\n    77\t                      {:option option\n    78\t                       :value value\n    79\t                       :maximum-ms max-timing-ms\n    80\t                       :options options})))))\n    81\t\n    82\t\n    83\t(defn driver\n    84\t  \"Compose a synchronous dao.jing content handle over one stepped\n    85\t   client state (dao.jing.content.step/client-state) on an attached\n    86\t   content pair. The driver thread is the caller's: each call locks\n    87\t   the handle, submits its request, and steps the client -- every\n    88\t   stream operation underneath returns without parking -- sleeping\n    89\t   :poll-interval-ms between advances until the request's completion\n    90\t   arrives.\n    91\t\n    92\t   Options: :request-timeout-ms (default 5000) and\n    93\t   :poll-interval-ms (default 10), each an integer of milliseconds\n    94\t   from 1 to max-timing-ms inclusive, validated at entry. A timed-out\n    95\t   call retires its bookkeeping through step/retire -- the id leaves\n    96\t   :outstanding, its late answer is dropped as unsolicited, and a\n    97\t   materialization record it claimed completes :lost -- and throws\n    98\t   {:request-id id :timeout-ms ms} without cancelling the remote\n    99\t   execution, which the server may still be serving. An interruption\n   100\t   of the driver's sleep retires the call the same way, re-asserts\n   101\t   the thread's flag, and throws {:request-id id :reason\n   102\t   :dao.jing.content/interrupted}.\n   103\t\n   104\t   Calls on one handle serialize under its lock -- one locally\n   105\t   awaited call per handle. The lock covers call-versus-call only:\n   106\t   close! runs outside it and is safe during an in-flight call, which\n   107\t   then fails with the pair's refusal or its loss. A found reply that\n   108\t   fails the ingress check surfaces as an :error completion and\n   109\t   throws; a lost completion throws with its reason.\"\n   110\t  ([step-state] (driver step-state {}))\n   111\t  ([step-state {:keys [request-timeout-ms poll-interval-ms]\n   112\t                :or {request-timeout-ms default-request-timeout-ms\n   113\t                     poll-interval-ms default-poll-interval-ms}}]\n   114\t   (valid-handle! step-state)\n   115\t   (validate-timing-options! {:request-timeout-ms request-timeout-ms\n   116\t                              :poll-interval-ms poll-interval-ms})\n   117\t   (let [client (atom step-state)\n   118\t         closed-atom (atom false)\n   119\t         lock (Object.)\n   120\t         ensure-open\n   121\t         (fn []\n   122\t           (when @closed-atom\n   123\t             (throw (ex-info \"content client is closed\" {}))))\n   124\t         settle!\n   125\t         (fn [state]\n   126\t           (reset! client state)\n   127\t           state)\n   128\t         resolve-get\n   129\t         (fn [completion]\n   130\t           (cond\n   131\t             (contains? completion :lost)\n   132\t             (throw (ex-info \"remote request lost\"\n   133\t                             {:reason (:lost completion)}))\n   134\t             (contains? completion :error)\n   135\t             (throw (ex-info \"remote error answer\"\n   136\t                             {:error (:error completion)}))\n   137\t             ;; a stored nil decodes to the value nil, whose canonical\n   138\t             ;; bytes are present: only the not-found half is absent\n   139\t             (:found? completion)\n   140\t             (jing/canonical-bytes (:value completion))\n   141\t             :else ::absent))\n   142\t         resolve-put\n   143\t         (fn [completion]\n   144\t           (cond\n   145\t             (contains? completion :lost)\n   146\t             (throw (ex-info \"remote request lost\"\n   147\t                             {:reason (:lost completion)}))\n   148\t             (contains? completion :error)\n   149\t             (throw (ex-info \"remote error answer\"\n   150\t                             {:error (:error completion)}))\n   151\t             :else (get completion :result)))\n   152\t         await!\n   153\t         (fn [state id deadline]\n   154\t           (loop [state state]\n   155\t             (let [r (step/step state poll-budget)\n   156\t                   mine (some #(when (= id (:id %)) %)\n   157\t                              (:completions r))\n   158\t                   s (:state r)]\n   159\t               (cond\n   160\t                 mine (do (settle! s) mine)\n   161\t\n   162\t                 (:terminal s)\n   163\t                 (do (settle! s)\n   164\t                     (throw (ex-info \"remote request lost\"\n   165\t                                     {:request-id id\n   166\t                                      :reason (:terminal s)})))\n   167\t\n   168\t                 (< (System/currentTimeMillis) deadline)\n   169\t                 (do\n   170\t                   (settle! s)\n   171\t                   (try\n   172\t                     (Thread/sleep ^long poll-interval-ms)\n   173\t                     (catch InterruptedException _\n   174\t                       ;; The request is already on the wire; retire\n   175\t                       ;; it from the latest state, store through\n   176\t                       ;; settle!, re-assert the flag, and throw --\n   177\t                       ;; so the next call cannot reuse this id.\n   178\t                       (settle! (step/retire s id\n   179\t                                             :dao.jing.content/interrupted))\n   180\t                       (.interrupt (Thread/currentThread))\n   181\t                       (throw (ex-info \"remote call interrupted\"\n   182\t                                       {:request-id id\n   183\t                                        :reason\n   184\t                                        :dao.jing.content/interrupted}))))\n   185\t                   (recur @client))\n   186\t\n   187\t                 :else\n   188\t                 (do (settle! (step/retire s id\n   189\t                                           :dao.jing.content/timeout))\n   190\t                     (throw (ex-info \"remote request timed out\"\n   191\t                                     {:request-id id\n   192\t                                      :timeout-ms\n   193\t                                      request-timeout-ms})))))))\n   194\t         call!\n   195\t         (fn [submit! raise!]\n   196\t           (locking lock\n   197\t             (ensure-open)\n   198\t             (let [submitted (submit! @client)\n   199\t                   outcome (:outcome submitted)\n   200\t                   id (:id submitted)]\n   201\t               (if (and (contains? #{:requested :pending-request}\n   202\t                                   outcome)\n   203\t                        (some? id))\n   204\t                 (raise! (await! (:state submitted) id\n   205\t                                 (+ (System/currentTimeMillis)\n   206\t                                    request-timeout-ms)))\n   207\t                 (throw (ex-info \"remote request refused\"\n   208\t                                 {:outcome outcome\n   209\t                                  :reason (:reason submitted)}))))))]\n   210\t     {:client client\n   211\t      :closed-atom closed-atom\n   212\t      :put-bytes-fn\n   213\t      (fn [address bs]\n   214\t        (call! #(step/request-put-bytes % address bs) resolve-put))\n   215\t      :get-bytes-fn\n   216\t      (fn [address not-found]\n   217\t        (let [result (call! #(step/request-get % address) resolve-get)]\n   218\t          (if (= ::absent result) not-found result)))\n   219\t      :close-fn\n   220\t      (fn []\n   221\t        (when-not @closed-atom\n   222\t          (doseq [handle [(:requests @client) (:answers @client)]]\n   223\t            (when (stream/closable? handle)\n   224\t              (stream/close! handle)))\n   225\t          (reset! closed-atom true)))})))\n     1\t(ns dao.jing.content.async\n     2\t  \"The async content backend over the stepped client\n     3\t   (dao.jing.content.step): the consumer-facing callback facade\n     4\t   dao.data.btree.md section 5.4 hydrates through.\n     5\t\n     6\t   dao.jing.content.step is pure: the caller owns the state and chooses\n     7\t   every cadence. This namespace is that caller, once, for consumers\n     8\t   that want a callback per request instead of a state machine --\n     9\t   chiefly dao.data.btree.storage/hydrate-async and store-tree-async.\n    10\t   It owns the stepped state as the single step owner (step's\n    11\t   precondition) and drives it with the non-blocking reschedule\n    12\t   pattern: a pump runs, then reschedules itself through `schedule`\n    13\t   while any request is queued or outstanding, and goes idle otherwise.\n    14\t   Nothing ever blocks or waits.\n    15\t\n    16\t   The handle is plain data, like a dao.jing content handle:\n    17\t\n    18\t     {:get-content-async-fn (fn [address callback])\n    19\t      :materialize-async-fn (fn [payload callback])\n    20\t      :put-content-async-fn (fn [address payload callback])}\n    21\t\n    22\t   Each callback is invoked exactly once, on the pump, with the stepped\n    23\t   client's published completion for that request -- {:found? b :value\n    24\t   v} for a get, {:materialized? true :address a :result r} for a\n    25\t   materialization -- or its :error / :lost tail. A request the writer\n    26\t   refuses outright completes :lost with the writer's outcome at once,\n    27\t   so no callback is ever left owed.\n    28\t\n    29\t   Requests are only queued by the fns above; every stream operation\n    30\t   happens inside the pump, so the stepped state has one owner even when\n    31\t   requests arrive from other threads (JVM).\"\n    32\t  (:require #?@(:cljd [[\"dart:async\" :as async]])\n    33\t            [dao.jing :as jing]\n    34\t            [dao.jing.content.step :as step]))\n    35\t\n    36\t\n    37\t(def default-budget\n    38\t  \"Answers each pump polls at most (step's budget).\"\n    39\t  64)\n    40\t\n    41\t\n    42\t(def default-delay-ms\n    43\t  \"Reschedule delay between pumps while work is owed.\"\n    44\t  1)\n    45\t\n    46\t\n    47\t(defn default-schedule\n    48\t  \"The host's non-blocking reschedule: run the thunk `f` after `delay-ms`\n    49\t   on a timer (cljs setTimeout, cljd Timer, JVM delayed executor).\"\n    50\t  [delay-ms]\n    51\t  (fn [f]\n    52\t    #?(:cljd (async/Timer (Duration .milliseconds delay-ms) f)\n    53\t       :clj (.execute (java.util.concurrent.CompletableFuture/delayedExecutor\n    54\t                        (long delay-ms)\n    55\t                        java.util.concurrent.TimeUnit/MILLISECONDS)\n    56\t                      ^Runnable f)\n    57\t       :cljs (js/setTimeout f delay-ms))\n    58\t    nil))\n    59\t\n    60\t\n    61\t(defn- submit\n    62\t  \"Submit one queued request to the stepped state. Returns\n    63\t   [:busy] when an unsent request is owed (nothing submitted),\n    64\t   [:registered state' id], or [:refused state' completion] for an\n    65\t   outcome that carries no id.\"\n    66\t  [state [kind arg opts]]\n    67\t  (let [r (case kind\n    68\t            :get (step/request-get state arg)\n    69\t            :materialize (step/request-materialize state arg (or opts {}))\n    70\t            :put (step/request-put state (first arg) (second arg)))]\n    71\t    (cond\n    72\t      (= :busy (:outcome r)) [:busy]\n    73\t      (some? (:id r)) [:registered (:state r) (:id r)]\n    74\t      :else [:refused (:state r)\n    75\t             {:lost (or (:reason r) (:outcome r))}])))\n    76\t\n    77\t\n    78\t(defn async-content\n    79\t  \"An async content handle over one stepped-client state (see the\n    80\t   namespace docstring). The caller attaches the state's pair first\n    81\t   (reflections of remote streams, ring buffers in a test) and hands\n    82\t   ownership of it to this handle. opts:\n    83\t   {:schedule (fn [thunk]) -- reschedule hook (default `default-schedule`\n    84\t                             over :delay-ms); tests pass a manual queue\n    85\t    :delay-ms n            -- default `default-delay-ms`\n    86\t    :budget n              -- default `default-budget`\n    87\t    :on-diagnostics f      -- receives each step's non-empty diagnostics}\"\n    88\t  ([step-state] (async-content step-state nil))\n    89\t  ([step-state opts]\n    90\t   (let [budget (or (:budget opts) default-budget)\n    91\t         schedule (or (:schedule opts)\n    92\t                      (default-schedule (or (:delay-ms opts) default-delay-ms)))\n    93\t         on-diagnostics (:on-diagnostics opts)\n    94\t         ;; pump-owned\n    95\t         client (volatile! step-state)\n    96\t         callbacks (volatile! {})\n    97\t         ;; shared with enqueuers\n    98\t         ctl (atom {:inbox [], :scheduled? false})\n    99\t         pump!\n   100\t         (fn pump!\n   101\t           []\n   102\t           (let [inbox (:inbox (first (swap-vals! ctl assoc :inbox [])))\n   103\t                 fire (volatile! [])]\n   104\t             (try\n   105\t               (loop [requests (seq inbox)]\n   106\t                 (when requests\n   107\t                   (let [request (first requests)\n   108\t                         callback (peek request)\n   109\t                         [tag state' x] (submit @client request)]\n   110\t                     (case tag\n   111\t                       :busy (swap! ctl update :inbox #(into (vec requests) %))\n   112\t                       :registered (do (vreset! client state')\n   113\t                                       (vswap! callbacks assoc x callback)\n   114\t                                       (recur (next requests)))\n   115\t                       :refused (do (vreset! client state')\n   116\t                                    (vswap! fire conj [callback x])\n   117\t                                    (recur (next requests)))))))\n   118\t               (let [{:keys [state completions diagnostics]}\n   119\t                     (step/step @client budget)]\n   120\t                 (vreset! client state)\n   121\t                 (when (and on-diagnostics (seq diagnostics))\n   122\t                   (on-diagnostics diagnostics))\n   123\t                 (doseq [c completions]\n   124\t                   (when-some [callback (get @callbacks (:id c))]\n   125\t                     (vswap! callbacks dissoc (:id c))\n   126\t                     (vswap! fire conj [callback c]))))\n   127\t               ;; every owed callback runs even if an earlier one throws;\n   128\t               ;; the first throw surfaces after the batch\n   129\t               (when-some [e (reduce (fn [e [callback c]]\n   130\t                                       (try (callback c)\n   131\t                                            e\n   132\t                                            (catch #?(:cljd Object\n   133\t                                                      :clj Throwable\n   134\t                                                      :cljs :default)\n   135\t                                                   t\n   136\t                                              (or e t))))\n   137\t                                     nil\n   138\t                                     @fire)]\n   139\t                 (throw e))\n   140\t               (finally\n   141\t                 ;; callbacks above may have queued more work; decide\n   142\t                 ;; idleness only after they ran\n   143\t                 (let [idle? (empty? @callbacks)\n   144\t                       c (swap! ctl\n   145\t                                (fn [c]\n   146\t                                  (if (and idle? (empty? (:inbox c)))\n   147\t                                    (assoc c :scheduled? false)\n   148\t                                    c)))]\n   149\t                   (when (:scheduled? c) (schedule pump!)))))))\n   150\t         enqueue!\n   151\t         (fn [request]\n   152\t           (let [[old _] (swap-vals! ctl\n   153\t                                     #(-> %\n   154\t                                          (update :inbox conj request)\n   155\t                                          (assoc :scheduled? true)))]\n   156\t             (when-not (:scheduled? old) (schedule pump!)))\n   157\t           nil)]\n   158\t     {:get-content-async-fn\n   159\t      (fn [address callback]\n   160\t        ;; before the queue, so a bad address throws at the caller\n   161\t        ;; rather than inside the pump\n   162\t        (when-not (jing/segment-address? address)\n   163\t          (throw (ex-info\n   164\t                   \"an async content request names a non-segment address\"\n   165\t                   {:address address})))\n   166\t        (enqueue! [:get address callback]))\n   167\t      :materialize-async-fn\n   168\t      (fn\n   169\t        ([payload callback]\n   170\t         (enqueue! [:materialize payload {} callback]))\n   171\t        ([payload opts callback]\n   172\t         (enqueue! [:materialize payload opts callback])))\n   173\t      :put-content-async-fn\n   174\t      (fn [address payload callback]\n   175\t        (when-not (jing/segment-address? address)\n   176\t          (throw (ex-info\n   177\t                   \"an async content request names a non-segment address\"\n   178\t                   {:address address})))\n   179\t        (enqueue! [:put [address payload] nil callback]))})))\n","exit_code":0,"status":"completed"}}
