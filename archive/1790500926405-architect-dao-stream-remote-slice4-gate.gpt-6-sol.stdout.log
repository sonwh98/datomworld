885\t          (update :routes dissoc rid)\n  1886\t          (finish link-id {:status :lost, :reason reason})))\n  1887\t    state))\n  1888\t\n  1889\t\n  1890\t;; =============================================================================\n  1891\t;; fetch: host policy over a link runtime (section 6.4)\n  1892\t;; =============================================================================\n  1893\t\n  1894\t(def ^:private fetch-budget\n  1895\t  \"How many response-medium elements one `fetch` advance may consume.\"\n  1896\t  32)\n  1897\t\n  1898\t\n  1899\t(defn- fetched\n  1900\t  \"The host-policy outcome of one completion: step 5b against `receiver`\n  1901\t   over a verified image, flattened to the step-6 shape of section 4.2;\n  1902\t   a refusal or loss as it completed, without its link id.\"\n  1903\t  [c receiver]\n  1904\t  (if (= :ok (:status c))\n  1905\t    (or (discharge receiver (:obligations c))\n  1360\t   possibly empty -- for a multi-part format); a multi-part whole is the\n  1361\t   tree assembled by prepending each part's address, the shape\n  1362\t   `validate-rows` takes (section 5.1).\"\n  1363\t  [format identity address parts]\n  1364\t  (let [root-value (get parts address)\n  1365\t        multi? (some? ((:parts-fn format) root-value))\n  1366\t        whole (if multi?\n  1367\t                {:root identity,\n  1368\t                 :rows (into {}\n  1369\t                             (map (fn [[a v]] [a (into [a] v)]))\n  1370\t                             parts)}\n  1371\t                root-value)]\n  1372\t    (if-not (matches-identity? format identity root-value)\n  1373\t      (refused :hash-mismatch\n  1374\t               {:expected identity, :actual (identity-of format root-value)})\n  1375\t      (if-let [defect (validation-defect format whole)]\n  1376\t        (refused :descriptor-defect {:identity identity, :defect defect})\n  1377\t        (let [joined (undischarged\n  1378\t                       ((:obligatio