  since been folded, which is the O(suffix) relief the transactor's\nsrc/cljc/dao/space/index.cljc:1246:(defn- require-session\nsrc/cljc/dao/space/index.cljc:1264:(defn coverage\nsrc/cljc/dao/space/index.cljc:1279:(defn checkpoint\nsrc/cljc/dao/space/index.cljc:1310:(defn verify-candidate\nsrc/cljc/dao/space/index.cljc:1332:                        (do (vreset! missing true) false)\nsrc/cljc/dao/space/index.cljc:1344:(defn restore\nsrc/cljc/dao/space/index.cljc:1370:                         btree :test seam pins the F2 hazard deterministically)\n    80\t\n    81\t\n    82\t(defn- error-answer\n    83\t  \"The protocol-error answer shape, with the id and identity the\n    84\t   request carried.\"\n    85\t  [identity id e]\n    86\t  {:dao.stream/identity identity\n    87\t   :dao.stream.remote/id id\n    88\t   :dao.stream.remote/error e})\n    89\t\n    90\t\n    91\t;; =============================================================================\n    92\t;; The mirror step (2.3)\n    93\t;; =============================================================================\n    94\t\n    95\t(defn- valid-budget?\n    96\t  \"True when the request carries the optional next-only budget as a\n    97\t   positive integer. Anything else ignores the budget, which is always\n    98\t   correct for a mirror.\"\n    99\t  [req]\n   100\t  (let [k (:dao.stream.remote/budget req)]\n   101\t    (and (integer? k) (pos? k))))\n   102\t\n   103\t\n   104\t(defn- chase\n   105\t  \"The budget chase: `outcome` is an ok from next; follow the successor\n   106\t   cursor through the same apply-request path at most k - 1 further\n   107\t   times, collecting the further outcome maps in order. The vector ends\n   108\t   at and includes the first non-ok outcome, so blocked, end and gap\n   109\t   reach the reader with the source's own recovery cursor.\"\n   110\t  [h ctx k outcome]\n   111\t  (loop [more [] cur (:dao.stream/cursor outcome) n 1]\n   112\t    (if (or (>= n k) (nil? cur))\n   113\t      more\n   114\t      (let [r (middleware/apply-request h ctx\n   115\t                                        {:dao.stream.remote/op\n   116\t                                         :dao.stream/next\n   117\t                                         :dao.stream.remote/args [cur]})]\n   118\t        (if (= :dao.stream/ok (:dao.stream/outcome r))\n   119\t          (recur (conj more r) (:dao.stream/cursor r) (inc n))\n   120\t          (conj more r))))))\n   121\t\n   122\t\n   123\t(defn- write-answer!\n   124\t  \"Append one answer value toward the asker. A value the channel cannot\n   125\t   carry (invalid-value) is answered with the oversize protocol error\n   126\t   in place of that element, the read not skipped and no cursor\n   127\t   advanced past it; any other refused write leaves the request\n   128\t   unanswered.\"\n   129\t  [chan-writer answer]\n   130\t  (let [r (stream/append! chan-writer answer)]\n   131\t    (when (= :dao.stream/invalid-value (:dao.stream/outcome r))\n   132\t      (stream/append! chan-writer\n   133\t                      (error-answer (:dao.stream/identity answer)\n   134\t                                    (:dao.stream.remote/id answer)\n   135\t                                    :dao.stream.remote/oversize)))))\n   136\t\n   137\t\n   138\t(defn- answer!\n   139\t  \"The mirror's steps 1 to 4 for one well-formed request: look the\n   140\t   identity up in the table (not-found); check the op against the\n   141\t   entry's declared surface under the fixed mapping (no-surface);\n   142\t   answer descriptor from the entry's handle directly, adding the\n   143\t   declared surface, and apply cursor, next and append! through\n   144\t   apply-request with the channel context; append the answer with the\n   145\t   id and identity. For next with a budget k, and an ok first outcome,\n   146\t   the chase places the further outcomes under more.\"\n   147\t  [table chan-writer channel req]\n   148\t  (let [identity (:dao.stream/identity req)\n   149\t        id (:dao.stream.remote/id req)\n   150\t        op (:dao.stream.remote/op req)\n   151\t        entry (get table identity)]\n   152\t    (if-not entry\n   153\t      (write-answer! chan-writer\n   154\t                     (error-answer identity id\n   155\t                                   :dao.stream.remote/not-found))\n   156\t      (let [h (:handle entry)]\n   157\t        (if (= :dao.stream/descriptor op)\n   158\t          (write-answer!\n   159\t            chan-writer\n   160\t            (-> (stream/descriptor h)\n   161\t                (assoc :dao.stream.remote/id id\n   162\t                       :dao.stream/identity identity\n   163\t                       :dao.stream.remote/surface (:surface entry))))\n   164\t          (if-not (contains? (into #{} (:surface entry))\n   165\t                             (required-surface op))\n   166\t            (write-answer! chan-writer\n   167\t                           (error-answer identity id\n   168\t                                         :dao.stream.remote/no-surface))\n   169\t            (let [ctx {:dao.stream.remote/channel channel}\n   170\t                  outcome (middleware/apply-request h ctx req)\n   171\t                  more (when (and (= :dao.stream/next op)\n   172\t                                  (valid-budget? req)\n   173\t                                  (= :dao.stream/ok\n   174\t                                     (:dao.stream/outcome outcome)))\n   175\t                         (chase h ctx (:dao.stream.remote/budget req)\n   176\t                                outcome))\n   177\t                  answer (cond-> (assoc outcome\n   178\t                                        :dao.stream.remote/id id\n   179\t                                        :dao.stream/identity identity)\n   180\t                           (seq more) (assoc :dao.stream.remote/more\n   181\t                                             more))]\n   182\t              (write-answer! chan-writer answer))))))))\n   183\t\n   184\t\n   185\t(defn mirror-step\n   186\t  \"The pure step a peer runs over a channel to answer requests against\n   187\t   its table: `(mirror-step table chan-reader cursor chan-writer) ->\n   188\t   cursor'`. For each request read from chan-reader at `cursor`, in\n   189\t   order, the four steps of 2.3 run; the mirror holds no state between\n   190\t   calls beyond the returned cursor. A value that is neither a\n   191\t   well-formed request nor a well-formed answer is dropped as malformed\n   192\t   wire input. The step stops when the channel reader answers blocked\n   193\t   or end; a gap adopts the reader's own recovery cursor, the lost wire\n   194\t   values being lost. The mirror never constructs, parses or rewrites\n   195\t   a cursor, an anchor or an outcome: the served stream is the\n   196\t   original, its cursors, its positions, its gap, its end.\"\n   197\t  [table chan-reader cursor chan-writer]\n   198\t  (let [channel (:dao.stream/identity (stream/descriptor chan-reader))]\n   199\t    (loop [cursor cursor]\n   200\t      (let [r (stream/next chan-reader cursor)]\n   201\t        (case (:dao.stream/outcome r)\n   202\t          :dao.stream/ok\n   203\t          (do (when (well-formed-request? (:dao.stream/value r))\n   204\t                (answer! table chan-writer channel\n   205\t                         (:dao.stream/value r)))\n   206\t              (recur (:dao.stream/cursor r)))\n   207\t          :dao.stream/blocked cursor\n   208\t          :dao.stream/end cursor\n   209\t          :dao.stream/gap (recur (:dao.stream/cursor r))\n   210\t          cursor)))))\n   211\t\n   212\t\n   213\t;; =============================================================================\n   214\t;; The link (2.4, 2.5)\n   215\t;; =============================================================================\nrg: src/cljc/dao/stream/ring.cljc: IO error for operation on src/cljc/dao/stream/ring.cljc: No