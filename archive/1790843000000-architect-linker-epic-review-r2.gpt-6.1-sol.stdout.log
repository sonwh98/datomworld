ion of \" manifest-address \" is repairing\")\n1014:                 (if (repairing? pub)\n1015:                   (cond-> (assoc pub :delay (limit node :repair-ticks))\n1021:(defn- cancel-entry\n1029:(defn cancel!\n1030:  \"End the live publication `manifest-address` now: every entry not sent\n1032:   publication needs are dropped, and the next step reports it with\n1034:   for a manifest with no live publication.  Answers the node.\"\n1040:                      (str \"no publication of \" manifest-address \" is live\")\n1061:(defn- probing\n1075:(defn- missing-in\n1083:(defn index-datoms\n1102:(defn index-walk\n1117:(defn load\n1118:  \"Start loading `address` with `{:kind k :walk f}`: `f` is `(fn [handle]\n1122:   fetches each missing address and walks again, and reports `:loaded`\n1123:   or `:load-failed` once.  A load already started, loaded or failed is\n1127:    (throw (ex-info \"dao.space.dht/load takes a segment address\"\n1130:    (throw (ex-info \"dao.space.dht/load takes a :walk function\" {:kind kind})))\n1131:  (if (contains? (:loads node) address)\n1133:    (assoc-in node [:loads address]\n1134:              {:status :loading :kind kind :walk walk :fetching nil :fetched 0})))\n1137:(def index-kind\n1138:  \"The `:kind` of a covered-index load.\"\n1142:(defn load-index\n1143:  \"`load` of the published index `manifest-address` names, with the\n1144:   covered-index walk: its `:loaded` value is the index's EAVT datoms.\"\n1147:    (throw (ex-info \"dao.space.dht/load-index takes a manifest address\"\n1149:  (load node manifest-address {:kind index-kind\n1153:(defn load-status\n1154:  \"`address`'s load, or nil when none was started:\n1155:   `{:status :loading :kind k :fetched n :fetching address-or-nil}`,\n1156:   `{:status :loaded :kind k :fetched n :value v}` or\n1160:             (get-in node [:loads address])]\n1162:      :loading {:status status :kind kind :fetched fetched\n1164:      :loaded {:status status :kind kind :fetched fetched :value value}\n1168:(defn forget\n1169:  \"`node` without `address`'s terminal load record, so a new `load`\n1170:   starts over.  Refused (`:dao.space.dht/loading`) while it loads.\"\n1172:  (when (= :loading (get-in node [:loads address :status]))\n1173:    (throw (refused ::loading (str address \" is still loading\")\n1175:  (update node :loads dissoc address))\n1178:(defn loaded-datoms\n1179:  \"The EAVT datoms of a loaded index, or nil.\"\n1181:  (let [record (get-in node [:loads manifest-address])]\n1182:    (when (and (= :loaded (:status record)) (= index-kind (:kind record)))\n1186:(defn loaded-indexes\n1187:  \"The covered-index manifests whose load is `:loaded` on `node`, as a\n1188:   vector sorted by address text: a load of another kind, one still\n1189:   loading and a failed one are not listed.\"\n1191:  (vec (sort-by str (filter #(loaded-datoms node %) (keys (:loads node))))))\n1194:(defn- walk-outcome\n1214:(defn- fail-load\n1216:  (let [{:keys [kind]} (get-in node [:loads m])]\n1217:    [(update-in node [:loads m] #(-> % (assoc :status :failed :reason reason\n1220:     [{::event :load-failed :manifest m :kind kind :reason reason}]]))\n1223:(defn- advance-load\n1225:  (let [{:keys [fetching kind walk], :as record} (get-in node [:loads m])\n1233:        (fail-load (update node :misses dissoc a) m\n1238:            node (cond-> (update-in node [:loads m] assoc :fetching nil :fetched fetched)\n1243:          [(update-in node [:loads m] #(-> % (assoc :status :loaded :value (:value walked))\n1245:           [(cond-> {::event :loaded :manifest m :kind kind :fetched fetched}\n1249:          (fail-load node m {::failure :invalid :address (:address walked)\n1259:                   (assoc-in [:loads m :fetching] {:id id :address a}))\n1265:              (fail-load (assoc node :client (:state asked)) m\n1269:(defn- advance-loads\n1271:  (let [loading (sort-by str (keep (fn [[m r]] (when (= :loading (:status r)) m))\n1272:                                   (:loads node)))