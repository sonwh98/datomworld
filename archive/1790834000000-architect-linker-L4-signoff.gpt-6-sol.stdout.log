{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/dht.cljc | sed -n '115,270p'\"","aggregated_output":"   115\t      (:value status))))\n   116\t\n   117\t\n   118\t;; =============================================================================\n   119\t;; Names: the snapshot set and the fold (7.2, 7.3)\n   120\t;; =============================================================================\n   121\t\n   122\t(defn head\n   123\t  \"The manifest the HEAD of the node's directory names, or nil: a node\n   124\t   over a durable directory store (`dao.space.store`) has one once its\n   125\t   publisher has written it; any other node has none.\"\n   126\t  [node]\n   127\t  (when-some [dir (:durable-dir (dht/local node))]\n   128\t    (some-> (fs/read-file-text dir durable/head-name)\n   129\t            str/trim\n   130\t            edn/read-string\n   131\t            :manifest)))\n   132\t\n   133\t\n   134\t(defn snapshots\n   135\t  \"The node's snapshot set (7.2) as the sorted vector of its addresses:\n   136\t   the manifest its directory's HEAD names, when there is one, and every\n   137\t   index manifest whose load is `:loaded`.  Nothing else in the local\n   138\t   store is considered.\"\n   139\t  [node]\n   140\t  (vec (sort-by str (distinct (cond-> (vec (dht/loaded-indexes node))\n   141\t                                (head node) (conj (head node)))))))\n   142\t\n   143\t\n   144\t(defn- snapshot-datoms\n   145\t  \"The datoms of the snapshot `s`: a loaded index's, or HEAD's read from\n   146\t   the node's own store.\"\n   147\t  [node s]\n   148\t  (or (dht/loaded-datoms node s)\n   149\t      (index/read-datoms (dht/local node) s)))\n   150\t\n   151\t\n   152\t(defn- snapshot-events\n   153\t  \"The authority events of every snapshot, assembled per snapshot (an\n   154\t   entity id is local to its index) and concatenated in snapshot order,\n   155\t   each envelope with its proof once.\"\n   156\t  [node snapshot]\n   157\t  (into []\n   158\t        (comp (mapcat (fn [s]\n   159\t                        (authority/events-from-datoms\n   160\t                          (filter (fn [[_ a]]\n   161\t                                    (contains? #{:yin.module/envelope\n   162\t                                                 :yin.module/proof}\n   163\t                                               a))\n   164\t                                  (snapshot-datoms node s)))))\n   165\t              (distinct))\n   166\t        snapshot))\n   167\t\n   168\t\n   169\t(defn authority\n   170\t  \"The reader's authority from its composition (7.1): each declared\n   171\t   public key (64 lowercase hex) a principal whose proof is an Ed25519\n   172\t   signature (6.3), at `:seq-floor` 0, and `name-env`'s direct entries.\"\n   173\t  [{:keys [principals name-env]}]\n   174\t  {:principals (into {}\n   175\t                     (map (fn [public]\n   176\t                            [(sign/principal public)\n   177\t                             {:proof :yin.module/signature\n   178\t                              :key public\n   179\t                              :verify sign/verify-envelope\n   180\t                              :seq-floor 0}]))\n   181\t                     principals)\n   182\t   :name-env (or name-env {})})\n   183\t\n   184\t\n   185\t(defn- fold\n   186\t  \"The fold of the reader's snapshot set under `authority`\n   187\t   `{:principals {principal declaration} :name-env {name address}}`, and\n   188\t   every envelope it saw by id.\"\n   189\t  [node authority]\n   190\t  (let [snapshot (snapshots node)\n   191\t        events (snapshot-events node snapshot)\n   192\t        env (authority/name-environment\n   193\t              {:snapshot snapshot :principals (or (:principals authority) {})}\n   194\t              events)]\n   195\t    {:env (update env :names into\n   196\t                  (map (fn [[n address]]\n   197\t                         [n {:status :ok :address address\n   198\t                             :yin.link/provenance :composition}]))\n   199\t                  (:name-env authority))\n   200\t     :envelopes (into {}\n   201\t                      (map (fn [e]\n   202\t                             (let [env (:yin.module/envelope e)]\n   203\t                               [(authority/assertion-id env) env])))\n   204\t                      events)}))\n   205\t\n   206\t\n   207\t(defn names\n   208\t  \"The reader's name environment: `authority/name-environment` over the\n   209\t   envelopes of the loaded index snapshots, under the principals\n   210\t   `authority` declares, with its direct `:name-env` entries winning,\n   211\t   their provenance `:composition`.\"\n   212\t  [node authority]\n   213\t  (:env (fold node authority)))\n   214\t\n   215\t\n   216\t(defn- diagnostics-for\n   217\t  \"The fold's diagnostics whose envelope binds or retracts `n`.\"\n   218\t  [{:keys [env envelopes]} n]\n   219\t  (let [name-of (fn [e]\n   220\t                  (if (= :retract (:yin.module/op e))\n   221\t                    (:yin.module/name (get envelopes (:yin.module/of e)))\n   222\t                    (:yin.module/name e)))]\n   223\t    (filterv (fn [d] (= n (name-of (get envelopes (:id d)))))\n   224\t             (:diagnostics env))))\n   225\t\n   226\t\n   227\t(defn resolve-name\n   228\t  \"The name `n` in the reader's name environment: its `names` entry when\n   229\t   it resolves, else its section 9 refusal -- `:absent` with the fold's\n   230\t   `:diagnostics` for that name, or `:ambiguous-name` with every\n   231\t   `:addresses` and `:asserters`.\"\n   232\t  [node authority n]\n   233\t  (let [folded (fold node authority)\n   234\t        entry (get-in folded [:env :names n])]\n   235\t    (cond\n   236\t      (= :ok (:status entry)) entry\n   237\t\n   238\t      (= :ambiguous-name (:reason entry))\n   239\t      (refused :ambiguous-name (merge {:name n}\n   240\t                                      (select-keys entry [:addresses :asserters])))\n   241\t\n   242\t      :else\n   243\t      (refused :absent {:name n :diagnostics (diagnostics-for folded n)}))))\n   244\t\n   245\t\n   246\t;; =============================================================================\n   247\t;; Dependency bindings (7.4)\n   248\t;; =============================================================================\n   249\t\n   250\t\n   251\t(defn dependency-bindings\n   252\t  \"One entry per requirement of the loaded closure of `manifest-address`,\n   253\t   in walk order: whether the dependency's name resolves, in the reader's\n   254\t   own name environment, to the address its publisher pinned.  `:binding`\n   255\t   is `:ok`, `:absent` (with the fold's `:diagnostics` for that name),\n   256\t   `:ambiguous` (`:addresses`, `:asserters`) or `:mismatch` (`:resolved`,\n   257\t   `:asserters`).  Refused `:yin.link.dht/not-loaded` unless the closure\n   258\t   is `:loaded`.\"\n   259\t  [node authority manifest-address]\n   260\t  (if-some [w (loaded-closure node manifest-address)]\n   261\t    (let [folded (fold node authority)]\n   262\t      (mapv (fn [{:keys [module name manifest]}]\n   263\t              (let [entry (get-in folded [:env :names name])\n   264\t                    base {:module module :name name :pinned manifest}\n   265\t                    asserters (get-in entry [:yin.link/provenance\n   266\t                                             :yin.module/asserted-by])]\n   267\t                (cond\n   268\t                  (= :ambiguous-name (:reason entry))\n   269\t                  (assoc base :binding :ambiguous\n   270\t                         :addresses (:addresses entry)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/query.cljc | sed -n '1,310p'\"","aggregated_output":"     1\t(ns yin.repl.query\n     2\t  \"The shell's query bridge: `(require 'dao.space.query)` activates\n     3\t   `dao.space.query/q` over the session's code index\n     4\t   (docs/design/yin.repl.dao.space-index.md, \\\"Query surface\\\").\n     5\t\n     6\t   `dao.space.query` is a session-scoped host module that is absent from\n     7\t   the VM's registry until the user requires it.  The session's registry\n     8\t   answers `:module/require` for that one name by installing the module\n     9\t   into the requiring VM's own registry value, and hands every other name\n    10\t   to `yin.vm.module/require-handler` unchanged.  Before the require, the\n    11\t   qualified export fails name resolution like any unknown name.  A session\n    12\t   rebuild (`(reset)`, `(vm ...)`) builds a fresh registry, which drops the\n    13\t   module.\n    14\t\n    15\t   The export `q` is a data constructor: it returns a `::call` effect\n    16\t   carrying its arguments, and the session registry's handler for that\n    17\t   effect parks the calling continuation as an ordinary FFI call on the\n    18\t   VM's `dao.stream.apply` call pair.  The call uses the VM's own park id,\n    19\t   caller-scoped call id and response reader (`yin.vm.ffi`), so the engine's\n    20\t   FFI response router wakes the call and `ffi/call-result` unwraps the\n    21\t   answer or raises its error, exactly as for a `dao.stream.apply/call`\n    22\t   node.  The request carries only data: the query, its `:in` inputs, and\n    23\t   an optional final options map.\n    24\t\n    25\t   The shell owns the other end of the pair.  `serve` reads each request\n    26\t   and answers it from the indexer the shell holds when it serves, never\n    27\t   from state captured when the session was built: the snapshot is the\n    28\t   latest manifest the indexer published and read back.  A lost indexer,\n    29\t   a recorded failure, or committed code not yet published refuses the\n    30\t   call, because an older manifest must not be presented as complete.  A\n    31\t   session that has committed nothing is a valid empty database.\n    32\t\n    33\t   A query that names `$ast` or `$occ` under `:in` is also given the AST\n    34\t   indexer's relations (`yin.repl.ast-index`), after `$` and in declared\n    35\t   order: `$ast` rows match `[id tag & slots]` at their exact arity, `$occ`\n    36\t   tuples `[root path node]`.  They are the same session-to-date relations\n    37\t   under either view; `:view` selects only the `$` datom view.  They are\n    38\t   read from the AST indexer the shell holds when it serves, and a lost or\n    39\t   failed one refuses such a query while datom-only queries still answer.\n    40\t\n    41\t   Free variables are a query over these two relations: pass\n    42\t   `yin.vm/occurrence-rules`, the portable data rule set, as the opt-in `%`\n    43\t   input.  The shell ships no binding for it; the user defines or pastes\n    44\t   the literal.  The answer is the raw free set, so it includes `yin/def`\n    45\t   where a definition is present (`yin.vm/free-names` removes it).\n    46\t\n    47\t   Answers and refusals are portable data.  Refusals use the FFI error\n    48\t   envelope under a stable code: `::index-unavailable`, `::invalid-input`,\n    49\t   `::result-limit`, or `::query-failed` for a query the engine rejects.\n    50\t   Limits are the caller's: `serve` takes the row and encoded-byte bound\n    51\t   and checks both before it appends a response.\n    52\t\n    53\t   `(require 'dao.space.dht)` and `(require 'yin.link)` activate two more\n    54\t   host modules the same way, answered over the shell's DHT node through\n    55\t   the plain functions of `dao.space.dht` and `yin.vm.linker.dht`\n    56\t   (yin.vm.linker.dht.md 10): each answer checks its arguments, makes one\n    57\t   call into the plain API, and responds; a `yin.link/publish` then\n    58\t   commits the envelopes it signed through the session's indexer.\"\n    59\t  (:require #?@(:cljd [[\"dart:typed_data\" :refer [Uint8List]]]\n    60\t                :default [])\n    61\t            [dao.jing :as jing]\n    62\t            [dao.jing.cbor :as cbor]\n    63\t            [dao.space.dht :as dht]\n    64\t            [dao.space.index :as index]\n    65\t            [dao.space.query :as query]\n    66\t            [dao.stream :as stream]\n    67\t            [dao.stream.apply :as apply2]\n    68\t            [dao.stream.ringbuffer :as ring]\n    69\t            [yin.repl.ast-index :as ast-index]\n    70\t            [yin.repl.index :as repl.index]\n    71\t            [yin.vm :as vm]\n    72\t            [yin.vm.engine :as engine]\n    73\t            [yin.vm.ffi :as ffi]\n    74\t            [yin.vm.linker.dht :as linker.dht]\n    75\t            [yin.vm.module :as module]))\n    76\t\n    77\t\n    78\t(def module-name\n    79\t  \"The module `(require 'dao.space.query)` activates.\"\n    80\t  'dao.space.query)\n    81\t\n    82\t\n    83\t(def op\n    84\t  \"The `dao.stream.apply` operation a `q` call requests.\"\n    85\t  ::q)\n    86\t\n    87\t\n    88\t(def dht-module-name\n    89\t  \"The module `(require 'dao.space.dht)` activates: the plain Clojure DHT\n    90\t   path (`dao.space.dht`) as host functions over the shell's own DHT node.\"\n    91\t  'dao.space.dht)\n    92\t\n    93\t\n    94\t(def dht-ops\n    95\t  \"The `dao.stream.apply` operations the `dao.space.dht` module requests:\n    96\t   `load-index`, `load-status` and `q`, each answered by the\n    97\t   `dao.space.dht` function of that name, `retry` and `cancel`,\n    98\t   answered by `retry!` and `cancel!`, and `load-module` and\n    99\t   `module-status`, answered by the `yin.vm.linker.dht` function of that\n   100\t   name (yin.vm.linker.dht.md 10).\"\n   101\t  {'load-index ::dht-load-index\n   102\t   'load-status ::dht-load-status\n   103\t   'q ::dht-q\n   104\t   'retry ::dht-retry\n   105\t   'cancel ::dht-cancel\n   106\t   'load-module ::dht-load-module\n   107\t   'module-status ::dht-module-status})\n   108\t\n   109\t\n   110\t(def link-module-name\n   111\t  \"The module `(require 'yin.link)` activates: publishing a module from\n   112\t   the session's indexed code and reading the reader's name environment\n   113\t   (yin.vm.linker.dht.md 10), over the shell's own DHT node.\"\n   114\t  'yin.link)\n   115\t\n   116\t\n   117\t(def link-ops\n   118\t  \"The `dao.stream.apply` operations the `yin.link` module requests:\n   119\t   `publish`, answered by `yin.vm.linker.dht/publish-name!`, and `names`,\n   120\t   answered by `yin.vm.linker.dht/names`.\"\n   121\t  {'publish ::link-publish\n   122\t   'names ::link-names})\n   123\t\n   124\t\n   125\t(def views\n   126\t  \"The options map's `:view` values and the `dao.space.query` interpreter\n   127\t   each names.  `:current` is the default.\"\n   128\t  {:current query/current\n   129\t   :history query/history})\n   130\t\n   131\t\n   132\t;; =============================================================================\n   133\t;; The module and its call\n   134\t;; =============================================================================\n   135\t\n   136\t(defn- q\n   137\t  \"The export: a data constructor.  The effect it returns is answered by\n   138\t   `call-handler`, which parks the caller on the call pair.\"\n   139\t  [& args]\n   140\t  (module/make-effect ::call {:args (vec args)}))\n   141\t\n   142\t\n   143\t(def ^:private exports\n   144\t  {'q q})\n   145\t\n   146\t\n   147\t(def ^:private profiles\n   148\t  {'q (vm/primitive-profile 'q :effectful [1 2 :variadic] #{::call} :none)})\n   149\t\n   150\t\n   151\t(defn activate\n   152\t  \"`registry` with the `dao.space.query` host module installed.\"\n   153\t  [registry]\n   154\t  (module/register-host-module registry module-name exports profiles))\n   155\t\n   156\t\n   157\t(defn- dht-export\n   158\t  \"A `dao.space.dht` export: a data constructor whose effect parks the\n   159\t   caller on the call pair under the operation `dht-ops` names.\"\n   160\t  [sym]\n   161\t  (fn [& args]\n   162\t    (module/make-effect ::call {:op (get dht-ops sym), :args (vec args)})))\n   163\t\n   164\t\n   165\t(def ^:private dht-arities\n   166\t  {'load-index [1] 'load-status [1] 'q [2 :variadic] 'retry [1] 'cancel [1]\n   167\t   'load-module [1] 'module-status [1]})\n   168\t\n   169\t\n   170\t(defn activate-dht\n   171\t  \"`registry` with the `dao.space.dht` host module installed.\"\n   172\t  [registry]\n   173\t  (module/register-host-module\n   174\t    registry dht-module-name\n   175\t    (into {} (map (fn [sym] [sym (dht-export sym)])) (keys dht-ops))\n   176\t    (into {} (map (fn [[sym arity]]\n   177\t                    [sym (vm/primitive-profile sym :effectful arity #{::call}\n   178\t                                               :none)]))\n   179\t          dht-arities)))\n   180\t\n   181\t\n   182\t(defn activate-link\n   183\t  \"`registry` with the `yin.link` host module installed.\"\n   184\t  [registry]\n   185\t  (module/register-host-module\n   186\t    registry link-module-name\n   187\t    (into {} (map (fn [[sym op]]\n   188\t                    [sym (fn [& args]\n   189\t                           (module/make-effect ::call {:op op, :args (vec args)}))]))\n   190\t          link-ops)\n   191\t    {'publish (vm/primitive-profile 'publish :effectful [2] #{::call} :none)\n   192\t     'names (vm/primitive-profile 'names :effectful [0] #{::call} :none)}))\n   193\t\n   194\t\n   195\t(def ^:private host-modules\n   196\t  {module-name activate\n   197\t   dht-module-name activate-dht\n   198\t   link-module-name activate-link})\n   199\t\n   200\t\n   201\t(defn- require-handler\n   202\t  \"`:module/require` for a session with the query bridge: the first\n   203\t   require of `dao.space.query` or `dao.space.dht` installs that module\n   204\t   into the requiring VM's registry value and answers at once; every\n   205\t   other require, and a repeated one, is `module/require-handler`'s.\"\n   206\t  [state effect opts]\n   207\t  (let [activate (get host-modules (:module effect))]\n   208\t    (if (and activate\n   209\t             (nil? (module/resolve-module (:modules state) (:module effect))))\n   210\t      {:value (:module effect),\n   211\t       :state (update state :modules activate),\n   212\t       :blocked? false}\n   213\t      (module/require-handler state effect opts))))\n   214\t\n   215\t\n   216\t(defn- blocked\n   217\t  [state entry]\n   218\t  {:state (-> state\n   219\t              (update :wait-set (fnil conj []) entry)\n   220\t              (assoc :value :yin/blocked\n   221\t                     :blocked? true\n   222\t                     :halted? false)),\n   223\t   :value :yin/blocked,\n   224\t   :blocked? true})\n   225\t\n   226\t\n   227\t(defn- call-handler\n   228\t  \"Park the continuation of a `q` call as an FFI call and append its\n   229\t   request.  The continuation's registers come from the VM's own\n   230\t   `:module/require` park builder, the parking point every kernel supplies\n   231\t   for an effectful primitive.  The walker's response reader nests its\n   232\t   continuation in an `eval-call` frame (`ffi/call-response-wait-entry`);\n   233\t   the positional kernels wait on their register payload\n   234\t   (`ffi/response-wait-entry`).  The pair's call-in is a ring buffer, which\n   235\t   never answers `full`, so any outcome but `ok` fails the call.\"\n   236\t  [state effect {:keys [park-entry-fns]}]\n   237\t  (let [build (get park-entry-fns :module/require)\n   238\t        _ (when-not build\n   239\t            (throw (ex-info \"dao.space.query/q cannot park at this call site\"\n   240\t                            {:op op})))\n   241\t        {:keys [call-in]} (ffi/require-call-pair! (:resources state) op)\n   242\t        regs (build state effect nil)\n   243\t        call-id (ffi/call-id state (engine/park-id state))\n   244\t        walker? (= :ast-walker (:vm-model state))\n   245\t        parked (engine/park-continuation\n   246\t                 state\n   247\t                 (if walker?\n   248\t                   {:k {:type :dao.stream.apply/eval-call,\n   249\t                        :next (:k regs),\n   250\t                        :env (:env regs)},\n   251\t                    :env (:env regs)}\n   252\t                   regs)\n   253\t                 call-id)\n   254\t        outcome (:dao.stream/outcome\n   255\t                  (apply2/put-request! call-in\n   256\t                                       (apply2/request call-id\n   257\t                                                       (:op effect op)\n   258\t                                                       (vec (:args effect)))))]\n   259\t    (when-not (= :dao.stream/ok outcome)\n   260\t      (throw (ex-info \"dao.space.query/q request could not be appended\"\n   261\t                      {:op op, :outcome outcome})))\n   262\t    (blocked parked\n   263\t             (if walker?\n   264\t               (ffi/call-response-wait-entry call-id (:k regs) (:env regs))\n   265\t               (ffi/response-wait-entry regs call-id)))))\n   266\t\n   267\t\n   268\t(defn register\n   269\t  \"`registry` with the bridge's effect handlers: the session's\n   270\t   `:module/require`, and the `q` call.  The module itself is not\n   271\t   installed.\"\n   272\t  [registry]\n   273\t  (-> registry\n   274\t      (module/register-effect-handler :module/require require-handler)\n   275\t      (module/register-effect-handler ::call call-handler)))\n   276\t\n   277\t\n   278\t(defn waiting?\n   279\t  \"True while `vm` waits on a query call: a response reader or a retained\n   280\t   request writer of the call pair.\"\n   281\t  [vm]\n   282\t  (boolean (some #(or (some? (ffi/response-call-id %))\n   283\t                      (some? (ffi/request-call-id %)))\n   284\t                 (:wait-set vm))))\n   285\t\n   286\t\n   287\t;; =============================================================================\n   288\t;; The call pair\n   289\t;; =============================================================================\n   290\t\n   291\t(defn- medium\n   292\t  [capacity]\n   293\t  (:dao.stream/handle\n   294\t    (ring/create! {:dao.stream/type ring/transport-type\n   295\t                   ring/capacity-key capacity})))\n   296\t\n   297\t\n   298\t(defn- newest\n   299\t  [handle]\n   300\t  (:dao.stream/cursor (stream/cursor handle stream/anchor-newest)))\n   301\t\n   302\t\n   303\t(defn discard-answers\n   304\t  \"`vm`, rolled back to a base that has no call outstanding, reading its\n   305\t   call-out from the newest position of `pair`'s call-out.  The base's\n   306\t   own cursor stopped where its round began; every response since\n   307\t   answers a call of the abandoned run, which no call of the base can\n   308\t   claim, and a failed round that made more calls than the medium holds\n   309\t   would otherwise leave that cursor behind evicted responses, so the\n   310\t   next call would read a gap.  The call ids stay unique: the rollback\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/main.cljc | sed -n '90,330p'\"","aggregated_output":"    90\t  \"A `--dht-manifest` value — the address as printed, with or without its\n    91\t   leading colon — as the segment address keyword.\"\n    92\t  [text]\n    93\t  (when (string? text)\n    94\t    (keyword (if (str/starts-with? text \":\") (subs text 1) text))))\n    95\t\n    96\t\n    97\t(def ^:private dht-flags\n    98\t  #{\"--dht-peer\" \"--dht-publish\" \"--dht-bind\" \"--dht-port\"\n    99\t    \"--dht-max-inbound-bytes\" \"--dht-manifest\" \"--dht-key\" \"--dht-principal\"})\n   100\t\n   101\t\n   102\t(defn parse-principal\n   103\t  \"A `--dht-principal` value: a declared publisher's public key, exactly\n   104\t   64 lowercase hexadecimal characters (yin.vm.linker.dht.md 6.2).\"\n   105\t  [text]\n   106\t  (if (and (string? text) (re-matches #\"^[0-9a-f]{64}$\" text))\n   107\t    text\n   108\t    (throw (ex-info (str \"--dht-principal takes a public key of 64 lowercase \"\n   109\t                         \"hexadecimal characters, not \" (pr-str text))\n   110\t                    {:value text}))))\n   111\t\n   112\t\n   113\t;; =============================================================================\n   114\t;; The publisher's key file (yin.vm.linker.dht.md 6.5)\n   115\t;; =============================================================================\n   116\t\n   117\t(defn- split-path\n   118\t  \"`[dir name]` of a file path.\"\n   119\t  [path]\n   120\t  (if-let [i (str/last-index-of path \"/\")]\n   121\t    [(subs path 0 i) (subs path (inc i))]\n   122\t    [\".\" path]))\n   123\t\n   124\t\n   125\t(defn load-key\n   126\t  \"The publisher key `{:seed :public}` the key file at `path` holds, or a\n   127\t   refusal of startup with the reason: a file that does not exist, or one\n   128\t   `yin.vm.linker.sign/key-from-text` refuses.  Nothing falls back to a\n   129\t   fresh key, and no refusal carries the file's content.\"\n   130\t  [path]\n   131\t  (let [[dir name] (split-path path)\n   132\t        text (fs/read-file-text dir name)\n   133\t        key (when text (sign/key-from-text text))]\n   134\t    (cond\n   135\t      (nil? text)\n   136\t      (throw (ex-info (str \"--dht-key \" path \": the key file does not exist; \"\n   137\t                           \"nothing falls back to a fresh key (create one with \"\n   138\t                           \"--dht-keygen \" path \")\")\n   139\t                      {:path path}))\n   140\t\n   141\t      (= :refused (:status key))\n   142\t      (throw (ex-info (str \"--dht-key \" path \": the key file is refused (\"\n   143\t                           (:reason key) \")\")\n   144\t                      {:path path :reason (:reason key)}))\n   145\t\n   146\t      :else key)))\n   147\t\n   148\t\n   149\t(defn- write-new-file!\n   150\t  \"Create `path` holding `text`, readable by its owner only where the host\n   151\t   can set that, refusing an existing file: a key file is never\n   152\t   overwritten.\"\n   153\t  [path text]\n   154\t  (let [exists (fn [] (ex-info (str \"--dht-keygen \" path \": the file exists; \"\n   155\t                                    \"a key file is never overwritten\")\n   156\t                               {:path path}))]\n   157\t    #?(:cljd (let [f (io/File. path)]\n   158\t               (when (.existsSync f) (throw (exists)))\n   159\t               (try (.createSync f .exclusive true)\n   160\t                    (catch Object _ (throw (exists))))\n   161\t               (.writeAsStringSync f text))\n   162\t       :clj (let [p (.toPath (java.io.File. ^String path))\n   163\t                  owner-only (java.nio.file.attribute.PosixFilePermissions/asFileAttribute\n   164\t                               (java.nio.file.attribute.PosixFilePermissions/fromString\n   165\t                                 \"rw-------\"))]\n   166\t              (try\n   167\t                (try (java.nio.file.Files/createFile\n   168\t                       p (into-array java.nio.file.attribute.FileAttribute\n   169\t                                     [owner-only]))\n   170\t                     (catch UnsupportedOperationException _\n   171\t                       (java.nio.file.Files/createFile\n   172\t                         p (make-array java.nio.file.attribute.FileAttribute 0))))\n   173\t                (catch java.nio.file.FileAlreadyExistsException _\n   174\t                  (throw (exists))))\n   175\t              (spit path text))\n   176\t       :cljs (let [fs-module (js/require \"fs\")]\n   177\t               (try (.writeFileSync fs-module path text #js {:flag \"wx\" :mode 384})\n   178\t                    (catch :default e\n   179\t                      (if (= \"EEXIST\" (.-code e))\n   180\t                        (throw (exists))\n   181\t                        (throw (ex-info (str \"--dht-keygen \" path \": \" (.-message e))\n   182\t                                        {:path path})))))))))\n   183\t\n   184\t\n   185\t(defn keygen!\n   186\t  \"Write a new key, from the host CSPRNG, to a new key file at `path`\n   187\t   (`--dht-keygen`), and answer the lines to print and the exit status.\n   188\t   The seed is never printed.\"\n   189\t  [path]\n   190\t  (let [key (sign/generate)]\n   191\t    (write-new-file! path (str (sign/key-text key) \"\\n\"))\n   192\t    {:lines [(str \"dht: wrote a new Ed25519 key to \" path \"; its principal is \"\n   193\t                  (sign/principal (:public key)) \". Keep the file: a lost key \"\n   194\t                  \"can never sign again, and a new key is a new principal.\")]\n   195\t     :exit 0}))\n   196\t\n   197\t\n   198\t(defn- dht-spec\n   199\t  \"Fold the `--dht-*` flags into the `dht:<dir>` spec, checked by\n   200\t   `yin.repl.store/checked-spec`.  They mean nothing to any other store,\n   201\t   and a bind address means nothing to a solo node, so each such use is\n   202\t   refused rather than ignored.\"\n   203\t  [spec {:keys [flags peers publish? bind-host bind-port max-inbound-bytes\n   204\t                manifest]}]\n   205\t  (cond\n   206\t    (and (seq flags) (not= :dht (:type spec)))\n   207\t    (throw (ex-info (str (str/join \", \" (sort flags))\n   208\t                         \" need --index-store dht:<dir>\")\n   209\t                    {:flags (vec (sort flags))}))\n   210\t\n   211\t    (not= :dht (:type spec)) spec\n   212\t\n   213\t    (and (empty? peers) (or bind-host bind-port))\n   214\t    (throw (ex-info (str \"--dht-bind and --dht-port need a --dht-peer: \"\n   215\t                         \"with no peers the DHT store is solo and opens \"\n   216\t                         \"no socket\")\n   217\t                    {}))\n   218\t\n   219\t    (and bind-host (not (datagram/ip-literal? bind-host)))\n   220\t    (throw (ex-info (str \"--dht-bind must be an IP literal, not \"\n   221\t                         (pr-str bind-host))\n   222\t                    {:value bind-host}))\n   223\t\n   224\t    :else\n   225\t    (store/checked-spec\n   226\t      (cond-> (assoc spec :peers (vec peers) :publish? (boolean publish?))\n   227\t        bind-host (assoc :bind-host bind-host)\n   228\t        bind-port (assoc :bind-port bind-port)\n   229\t        max-inbound-bytes (assoc :max-inbound-bytes max-inbound-bytes)\n   230\t        manifest (assoc :manifest manifest)))))\n   231\t\n   232\t\n   233\t(defn- dht-number\n   234\t  [flag text]\n   235\t  (or (parse-int text)\n   236\t      (throw (ex-info (str flag \" takes an integer, not \" (pr-str text))\n   237\t                      {:value text}))))\n   238\t\n   239\t\n   240\t(defn parse-args\n   241\t  \"Parse the host arguments.  `--telemetry` and `--telemetry-stream` are\n   242\t   rejected rather than ignored.  `--index-store` is parsed into\n   243\t   `:index-store-spec` — `:mem` (also what omission means),\n   244\t   `{:type :file :dir dir}`, or the DHT store `{:type :dht :dir dir ...}`\n   245\t   — and a missing value, an unknown scheme, or an empty directory is\n   246\t   refused here, by `yin.repl.store/parse-arg`, before any host composes.\n   247\t\n   248\t   The DHT store's options are their own flags (yin.repl.dht):\n   249\t   `--dht-peer host:port`, repeatable, the bootstrap contacts — none\n   250\t   means solo, with no socket; `--dht-publish`, the separate declaration\n   251\t   that shares the store; `--dht-bind ip` and `--dht-port p`, the\n   252\t   socket's address, loopback and ephemeral unless given;\n   253\t   `--dht-max-inbound-bytes n`, the inbound storage bound; and\n   254\t   `--dht-manifest address`, a remote index to hydrate before the first\n   255\t   evaluation; `--dht-key file`, the publisher's stable key file\n   256\t   (yin.vm.linker.dht.md 6.5); and `--dht-principal hex`, repeatable, a\n   257\t   publisher whose signed names this node honors (7.1).  Any of them\n   258\t   without `dht:<dir>` is refused.  `--dht-keygen file` writes a new key\n   259\t   file and exits.\"\n   260\t  [args]\n   261\t  (loop [args (seq args)\n   262\t         opts {:headless? false :host nil :port nil :rejected []\n   263\t               :index-store-spec :mem}\n   264\t         dht {:flags #{} :peers []}]\n   265\t    (if-let [arg (first args)]\n   266\t      (let [dht (cond-> dht (dht-flags arg) (update :flags conj arg))\n   267\t            value (second args)]\n   268\t        (case arg\n   269\t          \"--port\" (recur (nnext args)\n   270\t                          (assoc opts :port (when-let [p (second args)]\n   271\t                                              #?(:cljd (int/parse p)\n   272\t                                                 :cljs (js/parseInt p 10)\n   273\t                                                 :clj (Long/parseLong p))))\n   274\t                          dht)\n   275\t          \"--host\" (recur (nnext args) (assoc opts :host (second args)) dht)\n   276\t          \"--headless\" (recur (next args) (assoc opts :headless? true) dht)\n   277\t          \"--index-store\" (recur (nnext args)\n   278\t                                 (assoc opts\n   279\t                                        :index-store-spec\n   280\t                                        (store/parse-arg (second args)))\n   281\t                                 dht)\n   282\t          \"--dht-peer\" (recur (nnext args) opts\n   283\t                              (update dht :peers conj (parse-peer value)))\n   284\t          \"--dht-publish\" (recur (next args) opts (assoc dht :publish? true))\n   285\t          \"--dht-bind\" (recur (nnext args) opts\n   286\t                              (assoc dht :bind-host (str value)))\n   287\t          \"--dht-port\" (recur (nnext args) opts\n   288\t                              (assoc dht :bind-port (dht-number arg value)))\n   289\t          \"--dht-max-inbound-bytes\" (recur (nnext args) opts\n   290\t                                           (assoc dht :max-inbound-bytes\n   291\t                                                  (dht-number arg value)))\n   292\t          \"--dht-manifest\" (recur (nnext args) opts\n   293\t                                  (assoc dht :manifest (parse-manifest value)))\n   294\t          \"--dht-key\" (recur (nnext args)\n   295\t                             (assoc opts :dht-key-file\n   296\t                                    (or value\n   297\t                                        (throw (ex-info \"--dht-key needs a key file\"\n   298\t                                                        {}))))\n   299\t                             dht)\n   300\t          \"--dht-principal\" (recur (nnext args)\n   301\t                                   (update opts :principals (fnil conj [])\n   302\t                                           (parse-principal value))\n   303\t                                   dht)\n   304\t          \"--dht-keygen\" (recur (nnext args)\n   305\t                                (assoc opts :dht-keygen\n   306\t                                       (or value\n   307\t                                           (throw (ex-info \"--dht-keygen needs a file\"\n   308\t                                                           {}))))\n   309\t                                dht)\n   310\t          \"--telemetry\" (recur (next args) (update opts :rejected conj arg) dht)\n   311\t          \"--telemetry-stream\" (recur (nnext args)\n   312\t                                      (update opts :rejected conj arg) dht)\n   313\t          (recur (next args) (update opts :extra (fnil conj []) arg) dht)))\n   314\t      (update opts :index-store-spec dht-spec dht))))\n   315\t\n   316\t\n   317\t(defn boot\n   318\t  \"Create the composition: one shell, one input medium, one cursor held only by\n   319\t   the step owner, and the host WebSocket adapter `(connect …)` attaches\n   320\t   through.  The parsed `:index-store-spec` reaches the shell's store\n   321\t   selection, which resolves and opens it once at construction.\"\n   322\t  ([] (boot {}))\n   323\t  ([opts] (driver/create-state\n   324\t            {:host (or (:adapter opts) (host/websocket))\n   325\t             :repl (shell/create-state {:index-store-spec\n   326\t                                        (:index-store-spec opts)\n   327\t                                        :dht-key (:dht-key opts)\n   328\t                                        :principals (:principals opts)})})))\n   329\t\n   330\t\n","exit_code":0,"status":"completed"}}
