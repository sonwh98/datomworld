\t  [flag text]\n   235\t  (or (parse-int text)\n   236\t      (throw (ex-info (str flag \" takes an integer, not \" (pr-str text))\n   237\t                      {:value text}))))\n   238\t\n   239\t\n   240\t(defn parse-args\n   241\t  \"Parse the host arguments.  `--telemetry` and `--telemetry-stream` are\n   242\t   rejected rather than ignored.  `--index-store` is parsed into\n   243\t   `:index-store-spec` — `:mem` (also what omission means),\n   244\t   `{:type :file :dir dir}`, or the DHT store `{:type :dht :dir dir ...}`\n   245\t   — and a missing value, an unknown scheme, or an empty directory is\n   246\t   refused here, by `yin.repl.store/parse-arg`, before any host composes.\n   247\t\n   248\t   The DHT store's options are their own flags (yin.repl.dht):\n   249\t   `--dht-peer host:port`, repeatable, the bootstrap contacts — none\n   250\t   means solo, with no socket; `--dht-publish`, the separate declaration\n   251\t   that shares the store; `--dht-bind ip` and `--dht-port p`, the\n   252\t   socket's address, loopback and ephemeral unless given;\n   253\t   `--dht-max-inbound-bytes n`, the inbound storage bound; and\n   254\t   `--dht-manifest address`, a remote index to hydrate before the first\n   255\t   evaluation; `--dht-key file`, the publisher's stable key file\n   256\t   (yin.vm.linker.dht.md 6.5); and `--dht-principal hex`, repeatable, a\n   257\t   publisher whose signed names this node honors (7.1).  Any of them\n   258\t   without `dht:<dir>` is refused.  `--dht-keygen file` writes a new key\n   259\t   file and exits.\"\n   260\t  [args]\n   261\t  (loop [args (seq args)\n   262\t         opts {:headless? false :host nil :port nil :rejected []\n   263\t               :index-store-spec :mem}\n   264\t         dht {:flags #{} :peers []}]\n   265\t    (if-let [arg (first args)]\n   266\t      (let [dht (cond-> dht (dht-flags arg) (update :flags conj arg))\n   267\t            value (second args)]\n   268\t        (case arg\n   269\t          \"--port\" (recur (nnext args)\n   270\t                          (assoc opts :port (when-let [p (second args)]\n   271\t                                              #?(:cljd (int/parse p)\n   272\t                                                 :cljs (js/parseInt p 10)\n   273\t                                                 :clj (Long/parseLong p))))\n   274\t                          dht)\n   275\t          \"--host\" (recur (nnext args) (assoc opts :host (second args)) dht)\n   276\t          \"--headless\" (recur (next args) (assoc opts :headless? true) dht)\n   277\t          \"--index-store\" (recur (nnext args)\n   278\t                                 (assoc opts\n   279\t                                        :index-store-spec\n   280\t                                        (store/parse-arg (second args)))\n   281\t                                 dht)\n   282\t          \"--dht-peer\" (recur (nnext args) opts\n   283\t                              (update dht :peers conj (parse-peer value)))\n   284\t          \"--dht-publish\" (recur (next args) opts (assoc dht :publish? true))\n   285\t          \"--dht-bind\" (recur (nnext args) opts\n   286\t                              (assoc dht :bind-host (str value)))\n   287\t          \"--dht-port\" (recur (nnext args) opts\n   288\t                              (assoc dht :bind-port (dht-number arg value)))\n   289\t          \"--dht-max-inbound-bytes\" (recur (nnext args) opts\n   290\t                                           (assoc dht :max-inbound-bytes\n   291\t                                                  (dht-number arg value)))\n   292\t          \"--dht-manifest\" (recur (nnext args) opts\n   293\t                                  (assoc dht :manifest (parse-manifest value)))\n   294\t          \"--dht-key\" (recur (nnext args)\n   295\t                             (assoc opts :dht-key-file\n   296\t                                    (or value\n   297\t                                        (throw (ex-info \"--dht-key needs a key file\"\n   298\t                                                        {}))))\n   299\t                             dht)\n   300\t          \"--dht-principal\" (recur (nnext args)\n   301\t                                   (update opts :principals (fnil conj [])\n   302\t                                           (parse-principal value))\n   303\t                                   dht)\n   304\t          \"--dht-keygen\" (recur (nnext args)\n   305\t                                (assoc opts :dht-keygen\n   306\t                                       (or value\n   307\t                                           (throw (ex-info \"--dht-keygen needs a file\"\n   308\t                                                           {}))))\n   309\t                                dht)\n   310\t          \"--telemetry\" (recur (next args) (update opts :rejected conj arg) dht)\n   311\t          \"--telemetry-stream\" (recur (nnext args)\n   312\t                                      (update opts :rejected conj arg) dht)\n   313\t          (recur (next args) (update opts :extra (fnil conj []) arg) dht)))\n   314\t      (update opts :index-store-spec dht-spec dht))))\n   315\t\n   316\t\n   317\t(defn boot\n   318\t  \"Create the composition: one shell, one input medium, one cursor held only by\n   319\t   the step owner, and the host WebSocket adapter `(connect …)` attaches\n   320\t   through.  The parsed `:index-store-spec` reaches the shell's store\n   321\t   selection, which resolves and opens it once at construction.\"\n   322\t  ([] (boot {}))\n   323\t  ([opts] (driver/create-state\n   324\t            {:host (or (:adapter opts) (host/websocket))\n   325\t             :repl (shell/create-state {:index-store-spec\n   326\t                                        (:index-store-spec opts)\n   327\t                                        :dht-key (:dht-key opts)\n   328\t                                        :principals (:principals opts)})})))\n   329\t\n   330\t\n   331\t(defn boot-server\n   332\t  \"Compose the served endpoint for `--port`, or nil when no port was asked for.\n   333\t\n   334\t   `serve!` returns immediately.  Whether a listener bound is a fact the\n   335\t   endpoint's lifecycle medium reports, and the ticker prints it.\"\n   336\t  [opts]\n   337\t  (when (:port opts)\n   338\t    (serve/serve! {:bind-port (:port opts)\n   339\t                   :bind-host (or (:host opts) serve/default-bind-host)\n   340\t                   :host (or (:adapter opts) (host/websocket))})))\n   341\t\n   342\t\n   343\t(defn startup\n   344\t  \"Parse the arguments and compose the whole shell — the store the parsed\n   345\t   `:index-store-spec` names included — or answer the refusal text.  This\n   346\t   is the one gate every host's `-main` passes through before it prints a\n   347\t   banner or starts a loop, so an invalid `--index-store`, an unsupported\n   348\t   host for it, or a directory that cannot be opened refuses startup with\n   349\t   its reason rather than composing a shell around a fallback store.\n   350\t\n   351\t   Only a designed refusal is answered: an error carrying no ex-info\n   352\t   keeps its stack trace, because it is a defect, not an operator error.\n   353\t\n   354\t   `--dht-keygen` composes nothing: it writes the key file and answers\n   355\t   `{:lines [...] :exit 0}` for the host to print and exit with.  A\n   356\t   `--dht-key` file is loaded here (`load-key`); the key reaches the\n   357\t   shell, and only its principal reaches the options the banner reads.\"\n   358\t  [args]\n   359\t  (try\n   360\t    (let [opts (parse-args args)]\n   361\t      (if-some [path (:dht-keygen opts)]\n   362\t        (keygen! path)\n   363\t        (let [key (some-> (:dht-key-file opts) load-key)\n   364\t              opts (cond-> opts\n   365\t                     key (assoc :publisher (sign/principal (:public key))))]\n   366\t          {:opts opts\n   367\t           :state (boot (assoc opts :dht-key key))\n   368\t           :server (boot-server opts)})))\n   369\t    (catch #?(:cljd Object\n   370\t              :clj Throwable\n   371\t              :cljs :default)\n   372\t           e\n   373\t      (if (ex-data e)\n   374\t        {:refusal (or (ex-message e) (str e))}\n   375\t        (throw e)))))\n   376\t\n   377\t\n   378\t(defn- refuse!\n   379\t  \"Print why the composition refused to start and end the process with a\n   380\t   failing status, so a refused startup never looks like a working shell.\"\n   381\t  [refusal]\n   382\t  (println refusal)\n   383\t  #?(:cljd (io/exit 1)\n   384\t     :clj (.halt (Runtime/getRuntime) 1)\n   385\t     :cljs (.exit js/process 1)))\n   386\t\n   387\t\n   388\t(defn close-index-store!\n   389\t  \"Release the index store's lifecycle resources before the host exits —\n   390\t   in durable mode, the exclusive directory lock.  The shell has already\n   391\t   stopped when a host calls this; the memory store has nothing to\n   392\t   release.\"\n   393\t  [state]\n   394\t  (store/close! (get-in state [:repl :index-store])))\n   395\t\n   396\t\n   397\t(defn- entry-text\n   398\t  [entry]\n   399\t  (or (get entry driver/text-key) (get entry serve/text-key)))\n   400\t\n   401\t\n   402\t(defn banner\n   403\t  \"Text the composition prints before the first prompt, given parsed\n   404\t   options.  A DHT store states here — before its node steps once, so\n   405\t   before anything is shared — what it will share: the whole store when\n   406\t   `--dht-publish` is given, nothing otherwise (yin.repl.dht/banner).\"\n   407\t  [opts]\n   408\t  (let [spec (:index-store-spec opts)\n   409\t        dht? (= :dht (:type spec))]\n   410\t    (cond-> []\n","exit_code":0,"status":"completed"}}
