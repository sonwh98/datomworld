(deftest one-tick-hands-external-and-snapshot-progress-to-the-vm-test
  (doseq [external? [true false]]
    (testing (if external? "external allow" "late decision snapshot")
      (let [w (world)
            medium (capacity-1)
            opts (if external? :external {:decision-medium medium})
            [state text] (require! (preload (shell w :semantic
                                                   {:admission opts})
                                            w 'own.m)
                                   'own.m)
            id (pending-admission state)
            _ (is (some? id) text)
            _ (is (some? (:pending-run state)))
            _ (is (empty? (shell-responses state)))
            _ (is (= 1 (count (questions-of
                                (get-in state [:linker :admission])))))
            _ (if external?
                (answer-at! state (allow id))
                (stream/append! medium #{pa}))
            {:keys [result trace]} (traced-tick state)
            [done text] result]
        (assert-handoff trace)
        (is (some? text))
        (is (nil? (:pending-run done)))
        (is (= 'own.m (:last-value done)))
        (is (= 1 (count (questions-of
                          (get-in done [:linker :admission])))))
        (is (= 1 (count (shell-responses done))))
        (is (= 1 (count (mesh/values
                          (get-in done [:linker :admission :pair :answers])))))
        (is (= (settled-successor state medium #{pa}) (:linker done)))))))


(deftest tick-rollbacks-carry-the-entire-linker-successor-test
  (doseq [mode [:external-refuse :snapshot-refuse :install-error
                :snapshot-install-error]]
    (testing (str mode)
      (let [w (world)
            selected (into (array-map)
                           (map (juxt identity #(lane-tests index tests %)))
                           (:lanes opts))
            seams (when list? (subsystem-seams index sub-cfg subsystems))]
        (print-subsystem-selection index subsystems tests selected seams)
        (when-not list?
          (let [run (into (array-map) (filter (comp seq val)) selected)
                skipped (for [[lane nses] selected :when (empty? nses)]
                          {:lane lane :namespaces 0 :status "skipped"})
                prereqs (prerequisites index run)
                serial (serialized-pairs index run)]
            (doseq [task [:build:yin-repl-peer :build:yin-repl-node
                          :gen:python-antlr]]
              (if (prereqs task)
                (do (println "Prerequisite" (name task)
                             "(a selected test or its requires name its output)")
                    (let [{:keys [exit]} (p/shell {:continue true} "bb"
                                                  (name task))]
                      (when-not (zero? exit)
                        (println (name task) "failed, exit" exit)
                        (System/exit 1))))
                (println "Skipping" (name task)
                         "(no selected test reaches its output)")))
            (doseq [[a b] serial]
              (println "Serializing" (name a) "then" (name b)
                       "(a JVM test runs the cljd compiler)"))

