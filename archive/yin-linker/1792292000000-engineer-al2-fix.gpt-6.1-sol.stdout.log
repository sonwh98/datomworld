(defn- drive-links
  "Serve the linker interpreter and run the parked VM alternately, at most
   `link-round-budget` rounds, while `vm` waits on a link.  A round that
   moves nothing ends the drive: a link whose content source cannot
   answer will not answer by waiting longer.  Returns
   `[state vm pending progress?]`, `pending` the links the interpreter
   reported `:pending`, and `progress?` true when a round moved
   something -- advanced a serve cursor, delivered a response or
   completed an install -- the fact the pending run's `:checks` resets
   on (yin.repl.link-policy.md section 3.1).  A refused or lost link
   raises as the VM's own, carrying the interrupted VM's minted
   identity.

   A VM waiting on a `dao.space.query/q` call is driven the same way: the
   query interpreter (`yin.repl.query/serve`) answers from the session's
   indexer and the VM runs on.  Only a round the VM spends waiting on a
   link counts against `link-round-budget`; a query is answered in the
   round it is asked, so its rounds are bounded by `query-drive-budget`
   calls instead: a VM still waiting on a call once the drive has
   answered that many raises `query-call-limit-text` as its own error,
   the unanswered request abandoned with it."
  [state vm initial-progress]
  (loop [i 0
         calls 0
         vm vm
         state state
         pending []
         progress? initial-progress
         initial? initial-progress]
    (let [link? (link-waiting? vm)
          query? (query/waiting? vm)]
      (cond
        (or (vm/halted? vm) (not (or link? query?)) (>= i link-round-budget))
        [state vm pending progress?]

        (and query? (>= calls query-drive-budget))
        (throw (link-raise (ex-info query-call-limit-text
                                    {:reason :yin.repl.query/call-limit
                                     :limit query-drive-budget})
                           vm
                           (update state :query-pair query/abandon-requests)))

        :else
        (let [served (when (and link? (not initial?))
                       (link/round (assoc (:linker state)
                                          :source (:link-source state))
                                   (:dht state)))
              state (cond-> state
                      served (assoc :linker (:linker served)
                                    :dht (:dht served)))
              answered (when query?
                         (query/serve {:pair (:query-pair state)
                                       :indexer (:indexer state)
                                       :ast-indexer (:ast-indexer state)
                                       :dht (:dht state)
                                       :link (link-context state vm)
                                       :limits {:row-limit query-row-limit
                                                :byte-limit query-byte-limit}
                                       :budget (min query-serve-budget
                                                    (- query-drive-budget
                                                       calls))}))
              state (cond-> state
                      answered (assoc :query-pair (:pair answered)
                                      :dht (:dht answered)
                                      :indexer (:indexer answered)))
              pending (if (seq (:pending served)) (:pending served) pending)]
          (if (or initial? (:progress? served)
                  (:progress? answered))
            (let [vm' (try (vm/run vm)
                           (catch #?(:cljd Object :clj Exception :cljs js/Error)
                                  error
                             (throw (link-raise error vm state))))]
              (recur (if link? (inc i) i)
                     (+ calls (:answered answered 0))
                     vm'
                     state
                     pending
                     true
                     false))
            [state vm pending progress?]))))))


(defn- tokenize
  "Answer the halted VM's value on the output medium under `state`'s
   round, as the evaluator runner does for a program it runs itself.  A
   resumed require halts outside the observer loop, so the shell emits
   its token here."
  [state vm]
  ((make-runner (:output-stream state) (round-id state)) vm))


(defn- pending-text
  [pending]
  (if (seq pending)
    (str ";; require pending: "
         (str/join ", " (map (fn [p]
                               (str (pr-str (:name p))
                                    " (link " (pr-str (:yin.link/id p))
                                    (when (:admission p)
                                      ", awaiting admission")
                                    ")"))
                             pending))
         "); lines typed meanwhile run when it completes, (abandon) gives"
         " up\n")
    (str ";; require still pending; lines typed meanwhile run when it"
         " completes, (abandon) gives up\n")))


(defn- dropped-lines-text
  [n]
  (when (pos? n)
    (str ";; dropped " n " line" (when (> n 1) "s")
         " typed while the require was pending\n")))


(def ^:private policy-abandon-text
  "The message a policy-driven abandon prints, in the shape of the
   `(abandon)` notice, so a policy abandon is never mistaken for a
   user's (yin.repl.link-policy.md section 3.3)."
  ";; the session link policy ended the require\n")


(defn- abandon-pending
  "Give up the shell's `:pending-run` (section 7.2, step 7, the abandoned
(defn recheck-on-tick
  "Advance one linker round, carrying its successor before any VM run.
   Progress resumes the pending driver before another round; otherwise
   only a relevant load or installed head event rechecks the run."
  [state events]
  (let [served (link/round (assoc (:linker state)
                                  :source (:link-source state))
                           (:dht state))
        successor (assoc state :linker (:linker served)
                         :dht (:dht served))
        state (if (= state successor) state successor)
        links (get-in state [:pending-run :links])
        waits (set (keep :manifest links))
        heads (set (mapcat :principals links))]
    (cond
      (and (:progress? served) (:pending-run state))
      (recheck-pending* state nil true)

      (some (fn [e]
              (or (and (contains? #{:loaded :load-failed}
                                  (:dao.space.dht/event e))
                       (contains? waits (:manifest e)))
                  (and (= :installed (:yin.head/event e))
                       (contains? heads (:principal e)))))
            events)
      (recheck-pending state)

      :else [state nil])))


(defn- resume-pending
  "One bounded re-check of the shell's `:pending-run` behind a typed
   line: while the run stays pending the line is retained -- the parked
   VM owns the store a new evaluation would fork -- and it evaluates,
   in typing order and exactly once, when the link completes."
  [state trimmed parsed]
  (recheck-pending* state {:trimmed trimmed, :parsed parsed} false))


(defn- command-line?
  [parsed]
  (let [forms (:forms parsed)
        form (when (= 1 (count forms)) (first forms))]
    (and form (command-form? form))))


(defn- eval-parsed
  [state trimmed parsed]
  (if (and (:pending-run state) (not (command-line? parsed)))
    ;; A require is still pending: re-check it first.  While it stays
    ;; pending the line is retained -- the parked VM owns the store a new
    ;; evaluation would fork -- and it evaluates, in typing order and
    ;; exactly once, when the link completes.
    (resume-pending state trimmed parsed)
    (eval-parsed* state trimmed parsed)))


(defn- input-probe
  "The completeness probe of the session's frontend, or nil when it has
   none or none is installed (the compile then reports it)."
  [state]
  (:probe (usable-binding (select-frontend (:frontends state) (:lang state)))))


(defn eval-input
  "Evaluate one input line locally, returning `[state text]`.
                                  waits (assoc :manifest waits)
                                  heads (assoc :principals heads)
                                  asking (assoc :admission asking)))
                 :progress? (or progress? (true? asked?))
                 :dht node
                 :admission admission}))))))))


(defn serve
  "Serve requests over the legacy composition, draining answers once."
  ([comp] (serve comp serve-budget))
  ([comp budget]
   (serve-requests
     (update comp :admission #(some-> % (admission/drain budget)))
     budget)))


(defn make
  "Mint one linker value over `source`, with optional holder `context`.
   Only signed-name sources mint an admission pair. A configured policy
   attaches its in-process interpreter; external policy attaches none."
  ([source] (make source nil))
  ([source context]
   (let [signed? (= :dht (get-in source [:content :kind]))
         adm (when signed? (admission/make-state pair-capacity))
         policy (:admission source)]
     (cond-> {:pair (make-pair) :source source}
       adm (assoc :admission adm)
       (and adm policy)
       (assoc :interpreter (admission/interpreter adm policy)
              :context (admission/context context))))))


(defn round
  "Drain once, serve requests to the first pending, then answer in process.
   Always return the successor, even when nothing reports progress."
  ([linker node] (round linker node serve-budget))
  ([linker node budget]
   (let [before (:admission linker)
         drained (some-> before (admission/drain budget))
         matched? (not= (:answers before) (:answers drained))
         served (serve-requests (assoc linker :dht node :admission drained)
                                budget)
         successor (cond-> (assoc linker :pair (:pair served))
                     before (assoc :admission (:admission served)))
         answered (when (:interpreter successor)
                    (admission/serve
                      {:interpreter (:interpreter successor)
                       :policy (get-in successor [:source :admission])
                       :context (:context successor)}
                      budget))
         successor (cond-> successor
                     answered (assoc :interpreter (:interpreter answered)))]
     {:linker successor
      :dht (:dht served)
      :pending (:pending served)
      :answered (:answered answered 0)
      :progress? (boolean (or matched? (:progress? served)
                              (:progress? answered)))})))


;; =============================================================================
;; Retirement of an abandoned run (yin.vm.linker.dht.md 7.5)
;; =============================================================================

(defn run-descriptor
  "The run an abandon retires: link ids `[origin k]` with `from <= k <
   until` of `:ids`, and every install child origin `origin.m` with
   `from <= m < until` of `:children`, with its descendants.  `base` is
   the VM the run began from, `parked` the VM it was given up as; an
   absent counter is zero.  Both counters mint the current value then
   increment, so each interval is half-open."
  [base parked]
  {:origin (or (:origin parked) :t0)
   :ids [(or (:id-counter base) 0) (or (:id-counter parked) 0)]
   :children [(or (:origins base) 0) (or (:origins parked) 0)]})


(defn- run-owned?
  "Whether link id `id` belongs to `run`: its own origin within `:ids`,
   or an install child origin within `:children` exactly, or one of its
   descendants -- matched on the child's name followed by \".\", never
   a raw prefix, so `:t0.10` is not a descendant of `:t0.1`."
  [id {:keys [origin ids children]}]
  (when (and (vector? id) (= 2 (count id)) (keyword? (first id))
             (integer? (second id)))
    (let [[o k] id
          [from until] ids
          [cfrom cuntil] children
          on (name o)]
      (or (and (= o origin) (<= from k) (< k until))
          (some (fn [m]
                  (let [child (str (name origin) "." m)]
                    (or (= on child)
                        (str/starts-with? on (str child ".")))))
                (range cfrom cuntil))))))


(defn retire
  "Retire the requests of an abandoned `run` (`run-descriptor`) still
   unread on `pair`: walking from the request cursor, each request the
   run owns is passed over with no response -- the engine has already
   retired its id, so a response would be late -- and the first request
   it does not own stops the walk, keeping request order.  Every
   admission question and answer of a retired request is dropped.
   Returns the successor value with `:retired [link-id ...]`."
  [{:keys [pair admission] :as linker} run]
  (loop [pair pair
         retired []]
    (let [r (stream/next (:requests pair) (:cursor pair))
          id (:yin.link/id (:dao.stream/value r))]
      (if (and (= :dao.stream/ok (:dao.stream/outcome r))
               (run-owned? id run))
        (recur (assoc pair :cursor (:dao.stream/cursor r)) (conj retired id))
        (cond-> (assoc linker :pair pair :retired retired)
          admission (assoc :admission (admission/forget admission retired)))))))
(ns yin.vm.linker.admission-test
  "The admission seam, slice AD-1 (yin.vm.linker.dht.md section 7.5;
   collab design r3): the trust question a DHT link source asks before
   it loads a name, the interpreter that answers it, and the shell
   composition around both.

   Every world here is one solo `dao.space.dht` node whose local store
   holds the modules and an index of their signed names, loaded: own
   principal A asserts most names, B asserts `their.m`.  The seam tests
   drive `yin.vm.linker.interpreter/round` over link requests; the
   shell tests drive a REPL whose link source is that node.  Nothing
   waits on a clock: a node step is handed its reading."
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [dao.datom :as datom]
            [dao.jing :as jing]
            [dao.jing.dht.mesh :as mesh]
            [dao.jing.mem :as mem]
            [dao.space.dht :as dht]
            [dao.space.dht-test :as dht-test]
            [dao.stream :as stream]
            [dao.stream.ringbuffer :as ring]
            [yin.repl :as repl]
            [yin.repl.frontends :as repl.frontends]
            [yin.repl.main :as main]
            [yin.vm :as vm]
            [yin.vm.ffi :as ffi]
            [yin.vm.linker.admission :as admission]
            [yin.vm.linker.closure-test :as ct]
            [yin.vm.linker.dht :as ld]
            [yin.vm.linker.interpreter :as link]
            [yin.vm.linker.publish :as publish]
            [yin.vm.linker.sign :as sign]
            [yin.vm.module :as module]))


;; =============================================================================
;; The world: one solo node, signed names, an index loaded
;; =============================================================================

(def ^:private a (sign/generate))
(def ^:private b (sign/generate))
(def ^:private pa (sign/principal (:public a)))
(def ^:private pb (sign/principal (:public b)))


(defn- variable
  [n]
  {:type :variable :name n})


(defn- call
  [f & xs]
  {:type :application :operator f :operands (vec xs)})


(def ^:private forty-two
  (call (variable '+) (ct/lit 40) (ct/lit 2)))


(defn- publish!
  "Publish module `n` into `store`, `(yin/def f body)`, after `(require
   'dep)` when `dep` is given, pinned to `dep-address`: its manifest
   address."
  ([store n body] (publish! store n body nil nil))
  ([store n body dep dep-address]
   (:address
     (publish/publish-module!
       store
       (if dep
         {:name n
          :ast (call {:type :lambda :params '[_] :body (ct/def! 'f body)}
                     (call (variable 'require) (ct/lit dep)))
          :exports #{'f}
          :requires {dep dep-address}
          :primitives (assoc ct/plus 'require
                             (vm/profile-of vm/primitives 'require))}
         {:name n :ast (ct/def! 'f body) :exports #{'f} :requires {}
          :primitives ct/plus})))))


(defn- assertion
  [key n address s]
  (let [env {:yin.module/op :assert
             :yin.module/name n
             :yin.module/manifest address
             :yin.module/asserted-by (sign/principal (:public key))
             :yin.module/seq s}]
    {:env env :proof (sign/sign-envelope (:seed key) env)}))


(defn- retraction
  [key of s]
  (let [env {:yin.module/op :retract
             :yin.module/of (jing/segment-key (:env of))
             :yin.module/asserted-by (sign/principal (:public key))
             :yin.module/seq s}]
    {:env env :proof (sign/sign-envelope (:seed key) env)}))


(defn- index!
  "Publish the signed envelopes `signed` as one index through `node`,
   load it, and step the node until it is loaded: the node."
  [node signed]
  (let [m (dht-test/publish-datoms!
            node
            (vec (map-indexed (fn [i {:keys [env proof]}]
                                {:db/id (+ datom/first-user-id i)
                                 :yin.module/envelope env
                                 :yin.module/proof proof})
                              signed)))
        [node _] (dht/step (dht/load-index node m) 0)]
    (is (= :loaded (:status (dht/load-status node m))))
    node))


(defn- world
  "The solo node and its modules: `own.m`, `own2.m`, `own3.m`, `app.m`
   (requires `own.m`), `bad.m` (its body raises), `mid.m` (requires
   `inner.m`) and `inner.m` (requires `their.m`) asserted by A,
   `their.m` asserted by B, and `direct.m` asserted by nobody."
  []
  (let [node (dht/join {:local (mem/create-content-mem)})
        store (dht/local node)
        own (publish! store 'own.m forty-two)
        their (publish! store 'their.m forty-two)
        inner (publish! store 'inner.m
                        (call (variable '+) (variable 'their.m/f) (ct/lit 1))
                        'their.m their)
        addresses {'own.m own
                   'own2.m (publish! store 'own2.m forty-two)
                   'own3.m (publish! store 'own3.m forty-two)
                   'app.m (publish! store 'app.m
                                    (call (variable '+) (variable 'own.m/f)
                                          (ct/lit 1))
                                    'own.m own)
                   'bad.m (publish! store 'bad.m
                                    (call (variable '+) (ct/lit 1)
                                          (call (ct/lit 1))))
                   'inner.m inner
                   'mid.m (publish! store 'mid.m
                                    (call (variable '+) (variable 'inner.m/f)
                                          (ct/lit 1))
                                    'inner.m inner)
                   'their.m their
                   'direct.m (publish! store 'direct.m forty-two)}
        by-a (map-indexed (fn [i n] (assertion a n (get addresses n) (inc i)))
                          '[own.m own2.m own3.m app.m bad.m inner.m mid.m])]
    {:node (index! node (conj (vec by-a)
                              (assertion b 'their.m their 1)))
     :store store
     :addresses addresses
     :by-a (vec by-a)}))


(defn- address
  [w n]
  (get-in w [:addresses n]))


(defn- status
  "The node's module record of `n`'s manifest, or nil: nil means no load
   was ever started."
  [node w n]
  (ld/module-status node (address w n)))


