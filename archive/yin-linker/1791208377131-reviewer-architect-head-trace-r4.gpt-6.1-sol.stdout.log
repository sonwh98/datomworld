 543\t      (some #(and (not= except (:id %))\n   544\t                  (not (:cancelled? %))\n   545\t                  (open-entry? (get-in % [:entries address])))\n   546\t            (:pubs node))))\n   547\t\n   548\t\n   549\t(defn- dequeue\n   550\t  \"`node` without `address`'s queue entry.\"\n   551\t  [node address]\n   552\t  (case (get-in node [:queued address])\n   553\t    :fresh (-> node\n   554\t               (update :queued dissoc address)\n   555\t               (update :fresh (fn [q] (filterv #(not= address %) q))))\n   556\t    :repair (-> node\n   557\t                (update :queued dissoc address)\n   558\t                (update :repair-owner dissoc address)\n   559\t                (update :repair (fn [q] (filterv #(not= address %) q))))\n   560\t    node))\n   561\t\n   562\t\n   563\t(defn- release-entries\n   564\t  \"Remove every queue entry of `addresses` no other live holder needs.\"\n   565\t  [node addresses except]\n   566\t  (reduce (fn [node a]\n   567\t            (if (and (contains? (:queued node) a) (not (needed? node a except)))\n   568\t              (dequeue node a)\n   569\t              node))\n   570\t          node\n   571\t          addresses))\n   572\t\n   573\t\n   574\t(defn- write-outcome\n   575\t  \"Write one request's outcome, `entry`, to the window and to every live\n   576\t   publication holding `address` waiting or failed (5.5.1).\"\n   577\t  [node address entry]\n   578\t  (-> node\n   579\t      (update :window (fn [w]\n   580\t                        (if (open-entry? (get-in w [:entries address]))\n   581\t                          (put-entry w address entry)\n   582\t                          w)))\n   583\t      (update :pubs (fn [pubs]\n   584\t                      (mapv (fn [p]\n   585\t                              (if (and (not (:cancelled? p))\n   586\t                                       (open-entry? (get-in p [:entries\n   587\t                                                               address])))\n   588\t                                (put-entry p address entry)\n   589\t                                p))\n   590\t                            pubs)))))\n   591\t\n   592\t\n   593\t;; =============================================================================\n   594\t;; Admission (5.5.2)\n   595\t;; =============================================================================\n   596\t\n   597\t(defn- limit\n   598\t  [node k]\n   599\t  (get-in node [:limits k]))\n   600\t\n   601\t\n   602\t(defn- admit\n6:   request-put / request-get / request-materialize / step / abandon\n38:   5. route every completion: a found get answer and a :present verify\n77:   wire vocabulary -- a get not answering the exact found?/bytes shape,\n84:   a found read-back that does not hash to the address it was read from,\n91:   that then found nothing at the address.\"\n203:  [state request materialize?]\n221:                    (cond-> materialize? (register id address)))\n227:                    (cond-> materialize? (register id address)))\n236:                    (cond-> materialize? (register id address)))\n251:   completion arrives through step as {:id s :found? b :value v} (or an\n272:(defn request-put-bytes\n284:(defn request-materialize\n289:  ([state payload] (request-materialize state payload {}))\n321:  \"The value a found get answer carries, admitted through the one\n337:  \"True only for the exact read answer {:jing/request r :jing/found? b\n341:       (= #{:jing/request :jing/found? :jing/bytes} (set (keys v)))\n342:       (let [f (get v :jing/found?)] (or (true? f) (false? f)))))\n379:        (not (get answer :jing/found?))\n380:        {:id id, :found? false, :value nil}\n386:            {:id id, :found? true, :value value})))\n409:   :materialized? true\n413:(defn- materialize-on-completion\n433:        (not (get answer :jing/found?)) (finish {:error present-but-absent})\n466:                      (materialize-on-completion\n   401\t(defn- absorb!\n   402\t  \"Consume one value read off the channel. A well-formed answer whose\n   403\t   id is outstanding and whose identity is the outstanding entry's\n   404\t   reflection's own identity is taken: a not-found error marks the\n   405\t   reflection gone; the attach probe's ok records the source's\n   406\t   descriptor and declared surface; an append!'s source outcome is\n   407\t   emitted on the event writer, correlated by id; any other answer is\n   408\t   filed under its id and its more outcomes installed. Answers whose\n   409\t   id is not outstanding, answers whose identity is not the\n   410\t   reflection's own -- a mismatch never completes a request, which\n   411\t   stays outstanding -- and values that are not well-formed answers,\n   412\t   are dropped as diagnostics.\"\n   413\t  [link v]\n   414\t  (when (well-formed-answer? v)\n   415\t    (let [id (:dao.stream.remote/id v)]\n   416\t      (when-some [entry (get (:outstanding @link) id)]\n   417\t        (let [refl (:reflection entry)\n   418\t              req (:req entry)\n   419\t              op (:dao.stream.remote/op req)\n   420\t              e (:dao.stream.remote/error v)]\n   421\t          (when (= (:dao.stream/identity v) (:identity @refl))\n   422\t            (swap! link update :outstanding dissoc id)\n   423\t            (swap! refl update :ids disj id)\n   424\t            (cond\n   425\t              (= :dao.stream.remote/not-found e)\n   426\t              (do (swap! refl assoc :gone? true)\n   427\t                  (when (or (= :dao.stream/descriptor op)\n   428\t                            (= :dao.stream/append! op))\n   429\t                    (emit! link v)))\n   430\t\n   431\t              (= :dao.stream/descriptor op)\n   432\t              ;; The attach probe's confirmation. ok records; a\n   433\t              ;; no-surface or oversize error marks nothing.\n   434\t              (when (nil? e)\n   435\t                (learn! refl v)\n   436\t                (emit! link v))\n   437\t\n","exit_code":0,"status":"completed"}}
