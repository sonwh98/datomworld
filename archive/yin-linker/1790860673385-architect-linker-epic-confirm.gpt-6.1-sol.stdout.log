e)\n   854\t\n   855\t    node))\n   856\t\n   857\t\n   858\t(defn- read-facts\n   859\t  \"Apply every fact the DHT appended.  A lost fact reports every live\n   860\t   publication unknown, never acknowledged, and ends it.\"\n   861\t  [node]\n   862\t  (let [[facts cursor gap?] (read-all (get-in node [:composition :facts])\n   863\t                                      (:facts node))\n   864\t        wanted (fetching node)\n   865\t        node (reduce #(apply-fact %1 %2 wanted) (assoc node :facts cursor) facts)]\n   866\t    (if gap?\n   867\t      [(assoc node :pubs [] :fresh [] :repair [] :queued {} :repair-owner {}\n   868\t              :inflight {})\n   869\t       (mapv #(hash-map ::event :publication-unknown :manifest (:manifest %))\n   870\t             (:pubs node))]\n  1200\t                 {::walk :invalid :address nil\n  1201\t                  :defect {:code ::walk-threw :text (or (ex-message e) (str e))}}))\n  1202\t        defect (when (map? v) (:defect v))]\n  1203\t    (if (and (map? v)\n  1204\t             (case (::walk v)\n  1205\t               :missing (jing/segment-address? (:address v))\n  1206\t               :complete (contains? v :value)\n  1207\t               :invalid (and (map? defect) (keyword? (:code defect))\n  1208\t                             (or (nil? (:address v)) (jing/segment-address? (:address v))))\n  1209\t               false))\n  1210\t      v\n  1211\t      {::walk :invalid :address nil :defect {:code ::walk-shape}})))\n  1212\t\n  1213\t\n  1214\t(defn- fail-load\n  1215\t  [node m reason]\n  1216\t  (let [{:keys [kind]} (get-in node [:loads m])]\n  1217\t    [(update-in node [:loads m] #(-> % (assoc :status :failed :reason reason\n  1218\t                                              :fetching nil)\n  1219\t                                     (dissoc :walk)))\n  1220\t     [{::event :load-failed :manifest m :kind kind :reason reason}]]))\n  1221\t\n  1222\t\n  1223\t(defn- advance-load\n  1224\t  [node m done-by