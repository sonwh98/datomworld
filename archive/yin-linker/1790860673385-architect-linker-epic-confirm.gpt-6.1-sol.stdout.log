uijn.code :yin.debruijn.register}\n   106\t           (set (keys (:links result)))))\n   107\t    (is (every? #(= :ok (:status %)) (vals (:links result))))\n   617\t(defn- plain-clojure-leg\n   618\t  \"join -> load-index -> names -> load-module -> link over real UDP, the\n   619\t   functions the REPL's host functions call, then each failure result of\n   620\t   section 9 as the plain functions answer it.\"\n   621\t  [peers manifest public]\n   622\t  (let [hidden (atom #{})\n   623\t        node (dht/join {:local (hiding (mem/create-content-mem) hidden)\n   624\t                        :peers (mapv (fn [p] {:host \"127.0.0.1\" :port p}) peers)})\n   625\t        m (keyword manifest)\n   626\t        authority (ld/authority {:principals [public]})\n   627\t        principal (sign/principal public)]\n   628\t    (try\n   629\t      (let [[node cause] (step-until (dht/load-index node m) exchange-ms\n   630\t                                     \"the index did not load\" (settled? m))\n   631\t            _ (is (nil? cause) cause)\n   632\t            _ (is (= :loaded (:status (dht/load-status node m))))\n   633\t            names (ld/names node authority)\n   634\t            lib (get-in names [:names 'my.lib :address])\n   635\t            store-module (get-in names [:names 'my.store :address])]\n   636\t        (testing \"names: the publisher's signed names resolve under its principal\"\n   637\t          (is (= [m] (ld/snapshots node)))\n   638\t          (is (jing/segment-address? lib) (pr-str names))\n   639\t          (is (= [principal] (get-in names [:names 'my.lib :yin.link/provenance\n   640\t                                            :yin.module/asserted-by])))\n   641\t          (is (= (get-in names [:names 'my.lib]) (ld/resolve-name node authority 'my.lib))))\n   642\t        (testing \"link before the load is :yin.link.dht/not-loaded\"\n   643\t          (is (= {:status :refused :reason :yin.link.dht/not-loaded :address lib :load nil}\n   644\t                 (ld/link node lib :yin.semantic/code))))\n   645\t        (let [[node cause] (step-until (ld/load-module node lib) exchange-ms\n   646\t                                       \"my.lib did not load\" (settled? lib))\n   647\t              [node cause'] (step-until (ld/load-module node store-module) exchange-ms\n   648\t                                        \"my.store did not load\" (settled? store-module))]\n   649\t          (is (nil? cause) cause)\n   650\t          (is (nil? cause') cause')\n   651\t          (testing \"load-module fetched the closure from peers\"\n   652\t            (is (= :loaded (:status (ld/module-status node lib)))\n   653\t                (pr-str (ld/module-status node lib)))\n   654\t            (is (pos? (:fetched (ld/module-status node lib)))))\n   655\t          (testing \"link on all four formats, and run each image\"\n   656\t            (doseq [f [:yin.ast/code :yin.semantic/code :yin.debruijn.code\n   657\t                       :yin.debruijn.register]]\n   658\t              (let [res (ld/link node lib f)]\n   659\t                (is (linker/ok? res) (str f \" \" (pr-str res)))\n   660\t                (when (linker/ok? res)\n   661\t                  (is (some? (get (vm/store (vm/run (loaded-vm f res))) 'f))\n   662\t                      (str f \": the image defines the export\"))))))\n   663\t          (testing \"and the export evaluates\"\n   664\t            (let [image (vm/run (loaded-vm :yin.ast/code (ld/link node lib :yin.ast/code)))\n   665\t                  answer (vm/eval (tu/create-vm {:env {'f (get (vm/store image) 'f)}})\n   666\t                                  call-f)]\n   667\t              (is (= 4201 (vm/value answer)))))\n   668\t          (testing \"the store corpus links on semantic, stack and register\"\n   669\t            (doseq [f [:yin.semantic/code :yin.debruijn.code :yin.debruijn.register]]\n   670\t              (is (linker/ok? (ld/link node store-module f)) (str f))))\n   671\t          (testing \"failure results of section 9, as data\"\n   672\t            (testing \":absent (name): the principal is not declared\"\n   673\t              (let [r (ld/resolve-name node (ld/authority {}) 'my.lib)]\n   674\t                (is (= {:status :refused :reason :absent :name 'my.lib}\n   675\t                       (dissoc r :diagnostics)))\n   676\t                (is (= [[:undeclared-principal principal]]\n   677\t                       (mapv (juxt :reason :principal) (:diagnostics r))))))\n   678\t            (testing \":ambiguous-name: a second declared principal names another address\"\n   679\t              (let [other (sign/generate)\n   680\t                    own (dht-test/publish-datoms!\n   681\t                          node\n   682\t                          (mapv (fn [{:keys [envelope proof]}]\n   683\t                                  {:db/id datom/first-user-id\n   684\t                                   :yin.module/envelope envelope\n   685\t                                   :yin.module/proof proof})\n   686\t                                [(publish/assertion other {:name 'my.lib\n   687\t                                                           :manifest store-module\n   688\t                                                           :seq 1})]))\n   689\t                    [node' _] (dht/step (dht/load-index node own) (System/currentTimeMillis))\n   690\t                    r (ld/resolve-name node' (ld/authority {:principals [public (:public other)]})\n   691\t                                       'my.lib)]\n   692\t                (is (= {:status :refused :reason :ambiguous-name :name 'my.lib}\n   693\t                       (select-keys r [:status :reason :name])))\n   694\t                (is (= #{lib store-module} (set (:addresses r))))\n   695\t                (is (= #{principal (sign/principal (:public other))} (set (:asserters r))))))\n   696\t            (testing \":absent (content): a manifest no peer holds misses, exhausted\"\n   697\t              (let [nowhere (jing/segment-key \"a module no node holds\")\n   698\t                    [node cause] (step-until (ld/load-module node nowhere) exchange-ms\n   699\t                                             \"the miss was not reported\" (settled? nowhere))]\n   700\t                (is (nil? cause) cause)\n   701\t                (is (= {:status :refused :reason :absent :address nowhere\n   702\t                        :cause ::jing.dht/exhausted}\n   703\t                       (ld/load-refusal (ld/module-status node nowhere))))))\n   704\t            (testing \":descriptor-defect: a defective manifest fails :invalid with its code\"\n   705\t              (let [bad (jing/materialize! (dht/store node)\n   706\t                                           (assoc (jing/get (dht/local node) lib nil)\n   707\t                                                  :yin.module/schema 2))\n   708\t                    [node _] (dht/step (ld/load-module node bad) (System/currentTimeMillis))\n   709\t                    row (ld/load-refusal (ld/module-status node bad))]\n   710\t                (is (= {:status :refused :reason :descriptor-defect :address bad\n   711\t                        :code :manifest-defect}\n   712\t                       (dissoc row :detail :text))\n   713\t                    (pr-str row))))\n   714\t            (testing \":yin.link.dht/dependency-binding: app pins my.lib\"\n   715\t              (let [app (:address (requiring-app! (dht/store node) lib))\n   716\t                    [node _] (dht/step (ld/load-module node app) (System/currentTimeMillis))]\n   717\t                (is (= :loaded (:status (ld/module-status node app))))\n   718\t                (is (= [{:module app :name 'my.lib :pinned lib :binding :absent\n   719\t                         :diagnostics [{:reason :undeclared-principal}]}]\n   720\t                       (mapv #(update % :diagnostics (partial mapv (fn [d] (select-keys d [:reason]))))\n   721\t                             (ld/dependency-bindings node (ld/authority {}) app))))\n   722\t                (is (= [{:module app :name 'my.lib :pinned lib :binding :ok}]\n   723\t                       (ld/dependency-bindings node authority app)))))\n   724\t            (testing \"the linker's own refusal: the store corpus on the walker\"\n   725\t              (is (= {:status :refused :reason :undeclared-free :name 'base}\n   726\t                     (select-keys (ld/link node store-module :yin.ast/code)\n   727\t                                  [:status :reason :name]))))\n   728\t            (testing \":yin.link.dht/closure-incomplete: a blob lost after :loaded\"\n   729\t              (let [image (get-in (jing/get (dht/local node) lib nil)\n   730\t                                  [:yin.module/derivations :yin.semantic/code])]\n   731\t                (swap! hidden conj image)\n   732\t                (is (= {:status :refused :reason :yin.link.dht/closure-incomplete\n   733\t                        :address image}\n   734\t                       (ld/link node lib :yin.semantic/code)))\n   735\t                (reset! hidden #{})))\n   736\t            (testing \":yin.link.dht/unaskable: a client that cannot submit\"\n   737\t              (let [elsewhere (jing/segment-key \"another module no node holds\")\n   738\t                    [node _] (dht/step (-> node\n   739\t                                           (update :client assoc :requests (undeliverable))\n   740\t                                           (ld/load-module elsewhere))\n   741\t                                       (System/currentTimeMillis))]\n   742\t                (is (= {:status :refused :reason :yin.link.dht/unaskable\n   743\t                        :address elsewhere :outcome :request-undeliverable}\n   744\t                       (ld/load-refusal (ld/module-status node elsewhere))))))))\n   745\t        (dht/close! node))\n   746\t      (catch Throwable t\n   747\t        (dht/close! node)\n   748\t        (throw t)))))\n   749\t\n   750\t\n   751\t(deftest a-module-published-by-name-is-required-by-name-across-processes\n   752\t  (let [storing {::jing.dht/publish? true\n   753\t                 ::jing.dht/max-inbound-bytes (* 64 1024 1024)}\n   754\t        anchors [(start-anchor! storing) (start-anchor! storing)]\n   755\t        dirs (vec (repeatedly 4 temp-dir))\n   756\t        key-file (str (temp-dir) \".key\")\n   757\t        peer #(str \"127.0.0.1:\" %)\n   758\t        procs (atom [])]\n   759\t    (doseq [x anchors] (is (nil? (:failure x)) (:failure x)))\n   760\t    (when-not (some :failure anchors)\n   761\t      (try\n   762\t        (main/keygen! key-file)\n   763\t        (let [[x y] (map :port anchors)\n   764\t              a (spawn! \"publisher-a\" [\"--index-store\" (str \"dht:\" (dirs 0))\n   765\t                                       \"--dht-peer\" (peer x) \"--dht-peer\" (peer y)\n   766\t                                       \"--dht-publish\" \"--dht-key\" key-file])\n   767\t              _ (swap! procs conj a)\n   768\t              pa (bound-port a)\n   769\t              _ (is (some? pa) (transcript a))\n   770\t              public (some->> (await-line a #\"signed by principal ed25519:([0-9a-f]{64})\"\n   771\t                                          1000)\n   772\t                              (re-find #\"ed25519:([0-9a-f]{64})\")\n   773\t                              second)\n   774\t              _ (testing \"A states the principal it signs names with\"\n   775\t                  (is (some? public) (transcript a)))\n   776\t              _ (doseq [line publisher-lines] (type! a line))\n   777\t              published (await-line a #\":module 'my\\.store\" exchange-ms)\n   778\t              _ (testing \"A publishes both modules by name\"\n   779\t                  (is (some? published) (transcript a))\n   780\t                  (is (await-line a #\":module 'my\\.lib\" 1000) (transcript a)))\n   781\t              manifest (await-head-published a (dirs 0) exchange-ms)\n   782\t              _ (testing \"A's output reports the index naming them acknowledged\"\n   783\t                  (is (some? manifest) (transcript a)))\n   784\t              reader (fn [label command dir principals]\n   785\t                       (let [p (spawn! label command\n   786\t                                       (into [\"--index-store\" (str \"dht:\" dir)\n   787\t                                              \"--dht-peer\" (peer x) \"--dht-peer\" (peer pa)\n   788\t                                              \"--dht-manifest\" (str \":\" manifest)]\n   789\t                                             (mapcat (fn [k] [\"--dht-principal\" k]))\n   790\t                                             principals))]\n   791\t                         (swap! procs conj p)\n   792\t                         p))]\n   793\t          (when (and public manifest)\n   794\t            (is (.exists (io/file node-script))\n   795\t                (str \"the Node reader is required: \" node-script\n   796\t                     \" is absent; build it with `bb build:yin-repl-node`\"))\n   797\t            (let [b (reader \"reader-b-jvm\" (jvm-command) (dirs 1) [public])\n   798\t                  e (when (.exists (io/file node-script))\n   799\t                      (reader \"reader-b-node\" [\"node\" node-script] (dirs 2) [public]))\n   800\t                  c (reader \"reader-c-undeclared\" (jvm-command) (dirs 3) [])]\n   801\t              (doseq [p (remove nil? [b e])]\n   802\t                (testing (str (:label p) \" hydrates A's index\")\n   803\t                  (is (await-line p (re-pattern (str \"dht: hydrated :\" manifest))\n   804\t                                  startup-ms)\n   805\t                      (transcript p)))\n   806\t                (testing (str (:label p) \" requires each module by name on all four\"\n   807\t                              \" VMs: my.lib evaluates; the store corpus evaluates on\"\n   808\t                              \" semantic, stack and register and the walker refuses it\")\n   809\t                  (let [failures (require-on-each-vm p)]\n   810\t                    (is (empty? failures) (str failures \"\\n\" (transcript p))))\n   811\t                  (is (await-line p #\";; require pending: my\\.lib\" 1000)\n   812\t                      \"the first require waited through pending\")\n   813\t                  (is (= 1 (count (filter #(re-find #\"Module link refused\" %) @(:lines p))))\n   814\t                      (transcript p))))\n   815\t              (testing \"without --dht-principal, the require is :absent, undeclared\"\n   816\t                (is (await-line c (re-pattern (str \"dht: hydrated :\" manifest)) startup-ms)\n   817\t                    (transcript c))\n   818\t                (type! c \"(require (quote my.lib))\")\n   819\t                (is (await-line c #\"Module link refused: absent\" exchange-ms) (transcript c))\n   820\t                (type! c \"(require (quote yin.link))\")\n   821\t                (type! c \"(yin.link/names)\")\n   822\t                (is (await-line c (re-pattern (str \":reason :undeclared-principal|\"\n   823\t                                                   \":undeclared-principal\"))\n   824\t                                exchange-ms)\n   825\t                    (transcript c))\n   826\t                (is (await-line c (re-pattern (str \"ed25519:\" public)) 1000)\n   827\t                    (transcript c)))\n   828\t              (testing \"plain Clojure takes the same path, and answers each failure as data\"\n   829\t                (plain-clojure-leg [x pa] manifest public)))))\n   830\t        (finally\n   831\t          (doseq [p @procs] (stop! p))\n   832\t          (doseq [x anchors] ((:stop! x)))\n   833\t          (io/delete-file key-file true)\n   834\t          (run! delete-dir! dirs))))))\n97:   :repair-slots 16\n167:           bind! max-backlo