n\n;; clj -X:fmt\n\n;; clj -M:nREPL\n\n;; clj -M:nREPL:server\n;; clj -M:test\n;; clj -M:test -n yin.vm-literal-test\n;; clj -M:test -n yin.vm-continuation-test\n;; clj -M:test -n yang.python-test\n;; clj -X:test :nses '[yin.vm-literal-test yin.vm-test]'\n;; clj -M:test -v yin.vm-addition-test/test-lambda-with-multiple-operations\n\n;; clj -X:clean\n\n;; npx shadow-cljs compile test && node target/node-tests.js\n;; npx shadow-cljs release demo\n;; clj -M:dev -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli watch demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli compile demo\n;; clj -M:cljs -m shadow.cljs.devtools.cli release demo\n\n\n;; mise exec -- clj -M:cljd watch \n;; mise exec -- flutter run \n\n;; To start the emulator:                                                                                              ;; emulator -avd Pixel_3_API_34\n;; flutter emulators --launch Pixel_3_API_34\n;; emulator -avd Pixel_3_API_34 -no-snapshot-load  \n;; emulator -list-avds\n\n;;  clj -M:dep-graph                    # full report + dep-graph.dot + dep-graph.svg\n;;  clj -M:dep-graph --filter \"yin.*\"   # only yin namespaces\n;;  clj -M:dep-graph --layout circo     # choose graphviz layout engine\n;; shadow-cljs configuration\n;; Source paths come from deps.edn (:paths plus the :cljs alias's\n;; :extra-paths); shadow ignores any :source-paths set here when :deps\n;; is used.\n{:deps {:aliases [:cljs]}\n\n :dev-http {9000 \"public\"}\n\n :builds {:demo {:target :browser\n                 :devtools {:use-document-protocol true}\n                 :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :local {:target :browser\n                  :devtools {:use-document-protocol true}\n                  :closure-defines {datomworld.demo/WEBSOCKET_PORT 8090}\n                  :modules {:main {:init-fn datomworld.demo/init}}}\n\n          :test {:target :node-test\n                 :output-to \"target/node-tests.js\"\n                 :autorun true}\n\n          :vm-bench {:target :node-script\n                     :main bench.yin-vm-bench/-main\n                     :output-to \"target/vm-bench.js\"}\n\n          :yin-repl {:target :node-script\n                        :main yin.repl.main/-main\n                        :output-to \"target/yin-repl.js\"}}}\n   125\t(defn load-key\n   126\t  \"The publisher key `{:seed :public}` the key file at `path` holds, or a\n   127\t   refusal of startup with the reason: a file that does not exist, or one\n   128\t   `yin.vm.linker.sign/key-from-text` refuses.  Nothing falls back to a\n   129\t   fresh key, and no refusal carries the file's content.\"\n   130\t  [path]\n   131\t  (let [[dir name] (split-path path)\n   132\t        text (fs/read-file-text dir name)\n   133\t        key (when text (sign/key-from-text text))]\n   134\t    (cond\n   135\t      (nil? text)\n   136\t      (throw (ex-info (str \"--dht-key \" path \": the key file does not exist; \"\n   137\t                           \"nothing falls back to a fresh key (create one with \"\n   138\t                           \"--dht-keygen \" path \")\")\n   139\t                      {:path path}))\n   140\t\n   141\t      (= :refused (:status key))\n   142\t      (throw (ex-info (str \"--dht-key \" path \": the key file is refused (\"\n   143\t                           (:reason key) \")\")\n   144\t                      {:path path :reason (:reason key)}))\n   145\t\n   146\t      :else key)))\n   147\t\n   148\t\n   149\t(defn- write-new-file!\n   150\t  \"Create `path` holding `text`, readable by its owner only where the host\n   151\t   can set that, refusing an existing file: a key file is never\n   152\t   overwritten.\"\n   153\t  [path text]\n   154\t  (let [exists (fn []\n   155\t                 (ex-info (str \"--dht-keygen \" path \": the file exists; \"\n   156\t                               \"a key file is never overwritten\")\n   157\t                          {:path path}))]\n   158\t    #?(:cljd (let [f (io/File. path)]\n   159\t               (when (.existsSync f) (throw (exists)))\n   160\t               (try (.createSync f .exclusive true)\n   161\t                    (catch Object _ (throw (exists))))\n   162\t               (.writeAsStringSync f text))\n   163\t       :clj (let [p (.toPath (java.io.File. ^String path))\n   164\t                  owner-only (java.nio.file.attribute.PosixFilePermissions/asFileAttribute\n   165\t                               (java.nio.file.attribute.PosixFilePermissions/fromString\n   166\t                                 \"rw-------\"))]\n   167\t              (try\n   168\t                (try (java.nio.file.Files/createFile\n   169\t                       p (into-array java.nio.file.attribute.FileAttribute\n   170\t                                     [owner-only]))\n   171\t                     (catch UnsupportedOperationException _\n   172\t                       (java.nio.file.Files/createFile\n   173\t                         p (make-array java.nio.file.attribute.FileAttribute 0))))\n   174\t                (catch java.nio.file.FileAlreadyExistsException _\n   175\t                  (throw (exists))))\n   176\t              (spit path text))\n   177\t       :cljs (let [fs-module (js/require \"fs\")]\n   178\t               (try (.writeFileSync fs-module path text #js {:flag \"wx\" :mode 384})\n   179\t                    (catch :default e\n   180\t                      (if (= \"EEXIST\" (.-code e))\n   181\t                        (throw (exists))\n   182\t                        (throw (ex-info (str \"--dht-keygen \" path \": \" (.-message e))\n   183\t                                        {:path path})))))))))\n   184\t\n   185\t\n   186\t(defn keygen!\n   187\t  \"Write a new key, from the host CSPRNG, to a new key file at `path`\n   188\t   (`--dht-keygen`), and answer the lines to print and the exit status.\n   189\t   The seed is never printed.\"\n   190\t  [path]\n   191\t  (let [key (sign/generate)]\n   192\t    (write-new-file! path (str (sign/key-text key) \"\\n\"))\n   193\t    {:lines (cond-> [(str \"dht: wrote a new Ed25519 key to \" path \"; its principal is \"\n   194\t                          (sign/principal (:public key)) \". Keep the file: a lost key \"\n   195\t                          \"can never sign again, and a new key is a new principal.\")]\n   196\t              ;; dart:io sets no file permissions (yin.vm.linker.dht.md 6.5)\n   197\t              #?(:cljd true :default false)\n   198\t              (conj (str \"dht: WARNING: this host cannot restrict the key file's \"\n   199\t                         \"permissions; it is readable as the process umask allows. \"\n   200\t                         \"Restrict it now: chmod 600 \" path)))\n   201\t     :exit 0}))\n   202\t\n  1918\t(defn recheck-on-load-events\n  1919\t  \"The host ticker's re-check of a pending run over a DHT link source\n  1920\t   (yin.vm.linker.dht.md 8.2): `recheck-pending`, once, if and only if\n  1921\t   `events` -- one tick's `dao.space.dht/step` events -- hold a `:loaded`\n  1922\t   or `:load-failed` event for a manifest a pending link waits on.  Any\n  1923\t   other event, and any event while nothing waits on its manifest,\n  1924\t   answers `[state nil]` with `state` itself: no re-check, no `:checks`.\"\n  1925\t  [state events]\n  1926\t  (let [waits (set (keep :manifest (get-in state [:pending-run :links])))]\n  1927\t    (if (some (fn [e]\n  1928\t                (and (contains? #{:loaded :load-failed} (:dao.space.dht/event e))\n  1929\t                     (contains? waits (:manifest e))))\n  1930\t              events)\n  1931\t      (recheck-pending state)\n  1932\t      [state nil])))\n  1933\t\n  1934\t\n  1935\t(defn- resume-pending\n   629\t                                forged (assertion p1 'base base2 1)]\n   630\t                            [[(assoc good :proof (:proof forged))]]))\n   631\t                        (declare-keys p1))]\n   632\t      (is (= :absent (get-in env [:names 'base :reason])))\n   633\t      (is (= [[:unauthenticated :bad-proof]]\n   634\t             (mapv (juxt :reason :kind) (:diagnostics env))))))\n   635\t  (testing \"two declared principals on different addresses: ambiguous, naming both\"\n   636\t    (let [env (names-of (fn [{:keys [base base2]}]\n   637\t                          [[(assertion p1 'base base 1)]\n   638\t                           [(assertion p2 'base base2 1)]])\n   639\t                        (declare-keys p1 p2))\n   640\t          entry (get-in env [:names 'base])\n   641\t          r (:r env)]\n   642\t      (is (= :ambiguous-name (:reason entry)))\n   643\t      (is (= (set [(:base r) (:base2 r)]) (set (:addresses entry))))\n   644\t      (is (= #{(sign/principal (:public p1)) (sign/principal (:public p2))}\n   645\t             (set (:asserters entry))))))\n   646\t  (testing \"two on the same address resolve, both in provenance\"\n   647\t    (let [env (names-of (fn [{:keys [base]}]\n   648\t                          [[(assertion p1 'base base 1)]\n   649\t                           [(assertion p2 'base base 1)]])\n   650\t                        (declare-keys p1 p2))]\n   651\t      (is (= (get-in env [:r :base]) (get-in env [:names 'base :address])))\n   652\t      (is (= #{(sign/principal (:public p1)) (sign/principal (:public p2))}\n   653\t             (set (get-in env [:names 'base :yin.link/provenance\n   654\t                               :yin.module/asserted-by]))))))\n   655\t  (testing \"a retraction removes exactly its assertion\"\n   656\t    (let [env (names-of (fn [{:keys [base base2]}]\n   657\t                          (let [a (assertion p1 'base base 1)]\n   658\t                            [[a (assertion p1 'other base2 2) (retraction p1 a 3)]]))\n   659\t                        (declare-keys p1))]\n   660\t      (is (= :absent (get-in env [:names 'base :reason])))\n   661\t      (is (= (get-in env [:r :base2]) (get-in env [:names 'other :address])))\n   662\t      (is (empty? (:diagnostics env))))))\n   663\t\n   664\t\n   665\t;; =============================================================================\n   666\t;; A dangling retraction is one global diagnostic (owner decision 6)\n   667\t;; =============================================================================\n   668\t\n   615\t(deftest loads-sharing-a-missing-blob-each-keep-its-cause\n   616\t  (let [a (jing/segment-key \"the shared blob\")\n   617\t        [m1 m2 m3] (mapv #(jing/segment-key (str \"load \" %)) [1 2 3])\n   618\t        reason (fn [node m] (:reason (dht/load-status node m)))]\n   619\t    (testing \"/solo: two loads asking in the same step\"\n   620\t      (let [[node _] (step-until-failed (-> (solo-node) (load-missing m1 a) (load-missing m2 a))\n   621\t                                        [m1 m2] 0 1000)]\n   622\t        (doseq [m [m1 m2]]\n   623\t          (is (= {::dht/failure :miss :address a :cause ::jing.dht/solo} (reason node m))\n   624\t              (str m)))\n   625\t        (dht/close! node)))\n   626\t    (testing \"/exhausted: later loads join the first one's request steps later\"\n   627\t      (let [net (mesh/mesh)\n   628\t            _silent (mesh/join! net 6)\n   629\t            node (load-missing (node-at net 7 [6] {}) m1 a)\n   630\t            [node _] (dht/step node 0)\n   631\t            [node _] (dht/step node 10)\n   632\t            node (load-missing node m2 a)\n   633\t            [node _] (dht/step node 20)\n   634\t            [node _] (dht/step node 30)\n   635\t            node (load-missing node m3 a)\n   636\t            [node _] (step-until-failed node [m1 m2 m3] 40 30000)]\n   637\t        (doseq [m [m1 m2 m3]]\n   638\t          (is (= {::dht/failure :miss :address a :cause ::jing.dht/exhausted} (reason node m))\n   639\t              (str m)))\n   640\t        (testing \"and the cause is not kept once no load waits on it\"\n   641\t          (is (empty? (:misses node))))\n   642\t        (dht/close! node)))\n   643\t    (testing \"a load started after the first one failed asks again and keeps its own cause\"\n   644\t      (let [[node now] (step-until-failed (load-missing (solo-node) m1 a) [m1] 0 1000)\n   645\t            [node _] (step-until-failed (load-missing node m2 a) [m2] now 2000)]\n   646\t        (is (= ::jing.dht/solo (:cause (reason node m1))))\n   647\t        (is (= ::jing.dht/solo (:cause (reason node m2))))\n   648\t        (dht/close! node)))))\n   649\t\n   650\t\n   651\t(defn- lying-store\n   652\t  \"A content store that answers `address` with bytes that are not its.\"\n   653\t  [address]\n   654\t  (let [inner (mem/create-content-mem)]\n   655\t    (assoc inner :get-bytes-fn (fn [a not-found]\n   656\t                                 (if (= a address)\n   657\t                                   (jing/canonical-bytes \"not the content\")\n   658\t                                   ((:get-bytes-fn inner) a not-found))))))\n   659\t\n   660\t\n   805\t(deftest repair-acknowledges-a-partial-publication-once-healed\n   806\t  (let [w (world [21 22] {:repair-ticks 3000})\n   807\t        {:keys [manifest rows]} (round! (:node w) 1 5)\n   808\t        refused (nth rows 1)\n   809\t        _ (reset! (:refuse w) #{refused})\n   810\t        w (run-world w 50 20000 #(event (:events %) :published manifest))\n   811\t        _ (is (= :partial (:result (event (:events w) :published manifest))))\n   812\t        _ (reset! (:refuse w) #{})\n   813\t        w (run-world w 50 60000 #(event (:events %) :republished manifest))\n   814\t        w (run-world w 50 (+ (:now w) 40000) (constantly false))\n   815\t        republished (events-of (:events w) :republished manifest)]\n   816\t    (is (= 1 (count republished)) (pr-str republished))\n   817\t    (is (= {:result :acknowledged :sent 6 :blobs 6 :repairing? false}\n   818\t           (select-keys (first republished) [:result :sent :blobs :repairing?])))\n   819\t    (is (= 1 (replicates (:node w) manifest)) \"the manifest was asked once\")\n   820\t    (is (= 2 (replicates (:node w) refused)))\n   821\t    (doseq [row (remove #{refused} rows)]\n   822\t      (is (= 1 (replicates (:node w) row)) \"a sent blob is never asked again\"))\n   823\t    (close-world! w)))\n   824\t\n   825\t\n   826\t(deftest repair-takes-an-unacknowledged-publication-through-partial\n  1288\t;; =============================================================================\n  1289\t;; The public step and reads\n  1290\t;; =============================================================================\n  1291\t\n  1292\t(defn step\n  1293\t  \"Advance the node once at the owner's millisecond reading `now`:\n  1294\t   append it as a tick; finish binding; admit repairs, then the puts and\n  1295\t   announcements on the ledger ring; release replicate requests; step\n  1296\t   the DHT; apply its facts; advance loads; and report publications.\n  1297\t   Answers `[node' events]`.  A refused node (its socket could not bind)\n  1298\t   is answered unchanged.\"\n  1299\t  [node now]\n  1300\t  (if (:refusal node)\n  1301\t    [node []]\n  1302\t    (let [node (tick node now)\n  1303\t          [node bound] (bind-step node)\n  1304\t          node (admit-repairs node)\n  1305\t          [node unknown] (admit-ledger node)\n  1306\t          node (release node)\n  1307\t          node (cond-> node (:dht node) (update :dht dht/step step-budget))\n  1308\t          [node lost] (read-facts node)\n  1309\t          [node loaded] (advance-loads node)\n  1310\t          [node reported] (settle-publications node)]\n  1311\t      [node (-> bound (into unknown) (into lost) (into loaded) (into reported))])))\n  1312\t\n  1313\t\n  1314\t(defn refusal\n  1315\t  \"Why the node stopped — its socket could not bind — or nil.\"\n  1316\t  [node]\n  1317\t  (:refusal node))\n  1318\t\n  1319\t\n  1320\t(defn backlog\n  1321\t  \"What the node retains now: queue entries (`:fresh`, `:repair`),\n  1322\t   requests outstanding (`:outstanding`, split `:outstanding-fresh` and\n  1323\t   `:outstanding-repair`), live publications (`:live`), those awaiting a\n  1324\t   first report (`:open`) and repairing (`:repairing`), and the ledger\n  1325\t   entries they hold (`:ledger-entries`).\"\n  1326\t  [node]\n  1327\t  {:fresh (count (:fresh node))\n  1328\t   :repair (count (:repair node))\n  1329\t   :outstanding (count (:inflight node))\n  1330\t   :outstanding-fresh (in-flight node :fresh)\n  1331\t   :outstanding-repair (in-flight node :repair)\n  1332\t   :live (count (:pubs node))\n  1333\t   :open (open-count node)\n  1334\t   :repairing (count (filter repairing? (:pubs node)))\n  1335\t   :ledger-entries (reduce + 0 (map :blobs (:pubs node)))})\n  1336\t\n  1337\t\n  1338\t(defn- summary\n  1339\t  [node pub]\n  1340\t  {:manifest (:manifest pub)\n  1341\t   :blobs (:blobs pub)\n  1342\t   :sent (:sent pub)\n  1343\t   :result (result pub)\n  1344\t   :reported? (:reported? pub)\n  1345\t   :repairing? (repairing? pub)\n  1346\t   :delay (:delay pub)\n  1347\t   :due (:due pub)\n  1348\t   :cycles (:cycles pub)\n  1349\t   :cycle-open? (some? (:cycle pub))\n  1350\t   :repair-queued (held-in-repair node (:id pub))\n   473\t(def ^:private vm-types\n   474\t  [:ast-walker :semantic :stack :register])\n   475\t\n   476\t\n   477\t(def ^:private vm-names\n   478\t  {:ast-walker \"ASTWalkerVM\" :semantic \"SemanticVM\"\n   479\t   :stack \"DebruijnStackVM\" :register \"DebruijnRegisterVM\"})\n   480\t\n   481\t\n   482\t(defn- require-on-each-vm\n   483\t  \"At reader `p`, on each VM in turn: switch to it, require `my.lib` by\n   484\t   name and evaluate its export, then require the store corpus `my.store`\n   485\t   and evaluate its export.  Each step waits for the line it answers\n   486\t   (`(vm ...)` is answered at once even while a require is pending, so\n   487\t   nothing is typed ahead).  Answers the failures, each naming the VM and\n   488\t   the line it did not see.\"\n   489\t  [p]\n   490\t  (reduce\n   491\t    (fn [failures [i vm-type]]\n   492\t      (let [n (inc i)\n   493\t            step (fn [failures line re k]\n   494\t                   (if (seq failures)\n   495\t                     failures\n   496\t                     (do (type! p line)\n   497\t                         (if (await-count p re k exchange-ms)\n   498\t                           failures\n   499\t                           (conj failures (str vm-type \": \" line \" never answered \"\n   500\t                                               re \" (\" k \")\"))))))\n   501\t            walker? (= :ast-walker vm-type)]\n   502\t        (-> failures\n   503\t            (step (str \"(vm \" vm-type \")\")\n   504\t                  (re-pattern (str \"Switched to \" (vm-names vm-type))) 1)\n   505\t            (step \"(require (quote my.lib))\" #\"^(yin> )*'my\\.lib$\" n)\n   506\t            (step \"(my.lib/f 1)\" #\"^(yin> )*4201$\" n)\n   507\t            (step \"(require (quote my.store))\"\n   508\t                  (if walker?\n   509\t                    #\"Module link refused: undeclared-free\"\n   510\t                    #\"^(yin> )*'my\\.store$\")\n   511\t                  (if walker? 1 (dec n)))\n   512\t            (cond-> (not walker?)\n   513\t              (step \"(my.store/g)\" #\"^(yin> )*8$\" (dec n))))))\n   514\t    []\n   515\t    (map-indexed vector vm-types)))\n   516\t\n   517\t\n   518\t(def ^:private published-line\n   519\t  #\"dht: published :(segment/\\S+) .*— acknowledged\")\n   520\t\n   521\t\n   522\t(defn- head-of-dir\n   523\t  [dir]\n   524\t  (some->> (io/file dir \"HEAD\") (#(when (.exists ^java.io.File %) (slurp %)))\n   525\t           (re-find #\":manifest :(segment/\\S+?)\\}\")\n181:(deftest every-evaluator-is-indexed-the-same-way\n218:(deftest a-gap-on-the-index-reader-loses-the-indexer-until-rebuilt\n244:(deftest no-earlier-publication-is-retained-between-rounds\n272:(deftest a-publication-beyond-the-old-intake-bound-completes\n303:(deftest a-publication-failure-is-reported-in-the-round-and-repl-state\n311:    (is (str/includes? text \"materialize failed: store refused the write\")\n312:        \"the program's rows are the round's first write (yin.vm.linker.dht.md 5.1)\")\n317:    (is (= :materialize (get-in status [:failure :stage])))\n322:;; L4: rows every round, and the name transaction\n326:(deftest every-row-of-each-evaluated-program-is-in-the-index-store\n337:            [id row] (:rows (macro/packet->row-set packet))]\n342:(deftest rows-a-round-could-not-write-are-written-before-any-later-head-moves\n356:    (testing \"while rows cannot be written, no round publishes and HEAD stays\"\n357:      (is (str/includes? first-text \"materialize failed\"))\n358:      (is (str/includes? second-text \"materialize failed\"))\n364:          rows (mapcat (comp vals :rows macro/packet->row-set)\n366:      (testing \"the next round writes the earlier rows first, then publishes\"\n368:        (is (every? (fn [[id & body]] (= (vec body) (jing/get store id nil))) rows)\n369:            \"every committed program's rows are held\")\n374:        (is (nil? (:failure status)) \"the materialize failure is recovered\")\n376:        (is (str/includes? text \"rows of earlier rounds are now written\"))))\n380:(deftest the-name-envelopes-are-one-transaction-under-the-session-s-metadata\n405:(deftest an-index-gap-is-reported-evaluation-continues-and-reset-recovers\n439:(deftest vm-selection-rebuilds-the-indexer\n484:(deftest a-durable-round-writes-head-only-after-the-manifest-read-back\n","exit_code":0,"status":"completed"}}
