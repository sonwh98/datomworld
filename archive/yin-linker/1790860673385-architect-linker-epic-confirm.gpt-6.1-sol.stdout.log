     (let [e (+ meta-e 1 i)]\n   419\t                                  [(untimed e :yin.module/envelope envelope meta-e)\n   420\t                                   (untimed e :yin.module/proof proof meta-e)])))\n   421\t                            cat)\n   422\t                      signed)\n   423\t        answer (transactor/transact! (get-in ix [:publication :transactor])\n   424\t                                     tx-data)]\n   425\t    (dissoc (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   426\t              (let [ix (-> ix\n   427\t                           (assoc :next-e (+ meta-e 1 (count signed)))\n   428\t                           (update :transactions inc)\n   429\t                           (write-rows round))]\n   430\t                (cond-> ix (empty? (:unwritten ix)) (publish round)))\n   431\t              (assoc ix\n13:   locally and appends one replicate request, and the manifest reads back\n26:   A reader handed a manifest address (`:manifest`) loads it through\n29:   rehydrates the indexer from the loaded datoms, so `q` answers the\n47:  \"Why a reader cannot hydrate `manifest` into a directory whose own HEAD\n50:  [dir manifest recovered]\n51:  (when (and manifest recovered (not= manifest recovered))\n53:         manifest \" into an empty directory\")))\n65:                manifest bind!]} (store/checked-spec spec)\n68:      (when-some [why (refused-head dir manifest\n69:                                    (get-in base [:recovery :manifest]))]\n70:        (throw (ex-info why {:dir dir :manifest manifest})))\n79:                   (and manifest (not= manifest (get-in base [:recovery :manifest])))\n80:                   (-> (dht/load-index manifest)\n81:                       (assoc ::hydrating manifest)))]\n83:               :head-fn (fn [manifest-address]\n84:                          ((:head-fn base) manifest-address)\n85:                          (dht/announce! node manifest-address))\n146:           \"PARTIAL: the manifest was sent; \"\n170:  [node {:keys [manifest blobs host port id reason datoms fetched], :as event}]\n179:    (str \"dht: \" (name (::dht/event event)) \" \" manifest \" (\" blobs \" blobs) — \"\n181:    :publication-unknown (str \"dht: published \" manifest\n183:    :loaded (str (if (= manifest (::hydrating node)) \"dht: hydrated \" \"dht: loaded \")\n184:                 manifest \" — \"\n187:                 (when (= manifest (::hydrating node)) \"; evaluation admitted\"))\n188:    :load-failed (str \"dht: \" (if (= manifest (::hydrating node)) \"refused: \" \"\")\n189:                      \"loading \" manifest \" failed: \" (failure-text reason)\n190:                      (when (= manifest (::hydrating node))\n200:  \"Install the loaded remote index as this directory's: HEAD first, then\n203:  (let [manifest (::hydrating node)\n204:        recovery {:manifest manifest :datoms (dht/loaded-datoms node manifest)}]\n205:    ((:head-fn (dht/local node)) manifest)\n215:   lines, and as the data the ticker reads to re-check a pending require\n232:      [(if (= :loaded status) (hydrated shell node) shell) lines events])\n2: {test:clj {:doc \"Run JVM tests (via clj); the DHT process test needs the Node REPL build\"\n7:  {:doc \"Compile the Node yin.repl (shadow-cljs build :yin-repl) to target/yin-repl.js\"\n10:   :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile yin-repl\")}\n12:  test:cljs {:doc \"Run Node tests (via shadow-cljs with :cljs alias)\"\n13:             :task (shell \"clj -M:cljs -m shadow.cljs.devtools.cli compile test\")}\n15:  build:yin-repl-peer\n16:  {:doc \"Compile the yin.repl R5 cross-host peer (client role and --serve server role) as a Dart exe\"\n18:   ;; namespace, and this project's cljd.core carries the Flutter extensions,\n19:   ;; so only an ahead-of-time build is a peer the plain Dart VM can start.\n21:   ;; cljd-out tree, so a peer built after it would import a tree it does\n23:   ;; and Node lanes, so `bb test` builds it first; a bar