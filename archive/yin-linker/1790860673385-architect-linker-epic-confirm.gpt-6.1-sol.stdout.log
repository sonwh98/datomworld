e :composition}]))\n+                      (:name-env authority)))\n+     :envelopes envelopes}))\n \n \n (defn names\n   \"The reader's name environment: `authority/name-environment` over the\n    envelopes of the loaded index snapshots, under the principals\n    `authority` declares, with its direct `:name-env` entries winning,\n-   their provenance `:composition`.\"\n+   their provenance `:composition`.  A retraction whose target is not an\n+   assertion in the snapshot set (an assertion outside it, or a\n+   retraction) is under `:global-diagnostics`, once, with\n+   its `:principal` and the assertion id it names under `:of`; it is in\n+   no per-name diagnostic.\"\n   [node authority]\n   (:env (fold node authority)))\n \ndiff --git a/src/cljc/yin/vm/linker/publish.cljc b/src/cljc/yin/vm/linker/publish.cljc\nindex 03c1433a..3651df81 100644\n--- a/src/cljc/yin/vm/linker/publish.cljc\n+++ b/src/cljc/yin/vm/linker/publish.cljc\n@@ -259,18 +259,27 @@\n                    (:root tree))))\n \n \n+(def no-op-tree\n+  \"The tree of a module that collects no program, which is the module of\n+   an empty export list: one `nil` literal, defining nothing.\"\n+  {:type :literal :value nil})\n+\n+\n (defn- sequenced\n   \"One tree running `asts` in order: `((fn [_] second) first)`, nested.\n-   A program root in operand position is not a tail call.\"\n+   A program root in operand position is not a tail call.  No programs\n+   is `no-op-tree`.\"\n   [asts]\n-  (reduce (fn [body ast]\n-            {:type :application\n-             :tail? true\n-             :operator {:type :lambda :params '[_] :body body}\n-             :operands [(cond-> ast\n-                          (= :application (:type ast)) (assoc :tail? false))]})\n-          (peek asts)\n-          (rseq (pop asts))))\n+  (if (empty? asts)\n+    no-op-tree\n+    (reduce (fn [body ast]\n+              {:type :application\n+               :tail? true\n+               :operator {:type :lambda :params '[_] :body body}\n+               :operands [(cond-> ast\n+                            (= :application (:type ast)) (assoc :tail? false))]})\n+            (peek asts)\n+            (rseq (pop asts)))))\n \n \n (defn- free-declaration\n   760\t\n   761\t\n   762\t(defn manifest-defect\n   763\t  \"The schema-1 manifest validator (section 8.1): one schema version, the\n   764\t   closed key set, and each key's own shape -- the name is a symbol, the\n   765\t   contracts map formats to revision strings, the tree and every record\n   766\t   and declaration address is a Jing address, the declarations are\n   767\t   symbol-keyed, and every format named under `:yin.module/derivations`\n   768\t   is named under `:yin.module/contracts`. A declared name may never be\n   769\t   the definition operator (Rule R). Returns the defect map or nil.\"\n   770\t  [manifest]\n   771\t  (let [address? jing/segment-address?\n   772\t        shape (fn [k] {:rule :manifest-shape, :key k})\n   773\t        name-map? (fn [m k p]\n   774\t                    (let [v (get m k)]\n   775\t                      (and (map? v)\n   776\t                           (every? (fn [entry]\n   777\t                                     (and (symbol? (key entry))\n   778\t                                          (p (val entry))))\n   779\t                                   v))))\n   780\t        declared-names (fn [manifest]\n   781\t                         (concat (keys (:yin.module/requires manifest))\n   782\t                                 (keys (:yin.module/primitives manifest))\n   783\t                                 (:yin.module/exports manifest)))]\n   784\t    (if-not (map? manifest)\n   785\t      {:rule :manifest-shape}\n   786\t      (or (when (not= manifest-schema (:yin.module/schema manifest))\n   787\t            {:rule :schema})\n   788\t          (some (fn [k]\n   789\t                  (when-not (contains? manifest-keys k)\n   790\t                    (shape k)))\n   791\t                (keys manifest))\n   792\t          (some (fn [k]\n   793\t                  (when (or (not (contains? manifest k))\n   794\t                            (nil? (get manifest k)))\n   795\t                    (assoc (shape k) :missing true)))\n   796\t                (disj manifest-keys :yin.module/index))\n   797\t          (when-not (symbol? (:yin.module/name manifest))\n   798\t            (shape :yin.module/name))\n   799\t          (when (vm/reserved-name? (:yin.module/name manifest))\n   800\t            {:rule :reserved-name, :name (:yin.module/name manifest),\n   801\t             :role :declaration})\n   802\t          (when-not (and (map? (:yin.module/contracts manifest))\n   803\t                         (every? (fn [e]\n   804\t                                   (and (keyword? (key e))\n   805\t                                        (string? (val e))))\n   806\t                                 (:yin.module/contracts manifest)))\n   807\t            (shape :yin.module/contracts))\n   808\t          (when-not (address? (:yin.module/tree manifest))\n   809\t            (shape :yin.module/tree))\n   810\t          (when-not (and (map? (:yin.module/derivations manifest))\n   811\t                         (every? (fn [e]\n   812\t                                   (and (contains? derivation-formats (key e))\n   813\t                                        (address? (val e))))\n   814\t                                 (:yin.module/derivations manifest)))\n   815\t            (shape :yin.module/derivations))\n   816\t          (some (fn [f]\n   817\t                  (when-not (contains? (:yin.module/contracts manifest) f)\n   818\t                    {:rule :contract-missing, :format f}))\n   819\t                (keys (:yin.module/derivations manifest)))\n   820\t          ;; optional, but when present a map: vals of anything else throws\n   821\t          (let [index (:yin.module/index manifest)]\n   822\t            (when (or (and (some? index) (not (map? index)))\n   823\t                      (some (fn [v] (not (address? v))) (vals index)))\n   824\t              (shape :yin.module/index)))\n   825\t          (when-not (and (set? (:yin.module/exports manifest))\n   826\t                         (every? (fn [n] (symbol? n))\n   827\t                                 (:yin.module/exports manifest)))\n   828\t            (shape :yin.module/exports))\n   829\t          (when-not (name-map? manifest :yin.module/requires address?)\n   830\t            (shape :yin.module/requires))\n   831\t          (when-not (name-map? manifest :yin.module/primitives keyword?)\n   832\t            (shape :yin.module/primitives))\n   833\t          (when-not (and (map? (:yin.module/footprint manifest))\n   834\t                         (set? (get-in manifest\n   835\t                                       [:yin.module/footprint :store-keys]))\n   836\t                         (set? (get-in manifest\n   837\t                                       [:yin.module/footprint :effects])))\n   838\t            (shape :yin.module/footprint))\n   839\t          (some (fn [n]\n   840\t                  (when (vm/reserved-name? n)\n   841\t                    {:rule :reserved-name, :name n,\n   842\t                     :role :declaration}))\n   843\t                (declared-names manifest))))))\n   844\t\n   845\t\n   846\t(def ^:private record-keys\n   847\t  \"The closed key set of a derivation record: exactly the keys\n   848\t   `yin.vm.ledger/derive-record` mints.\"\n   849\t  #{:yin.ledger/op :yin.ledger/input :yin.ledger/output\n   850\t    :yin.ledger/function :yin.ledger/profile})\n   851\t\n   852\t\n   853\t(defn record-defect\n   854\t  \"The derivation-record validator (section 8.1): a record is exactly\n   855\t   `yin.vm.ledger/derive-record`'s shape -- one `:derive` op, the tree's\n   856\t   Jing address as input, the lowered image's identity as output (a\n   857\t   segment address for the vector format, a contract-pinned hash for\n   858\t   the two de Bruijn formats), a function name, and the structured\n   859\t   profile map, no more and no less. Returns the defect map or nil.\"\n   860\t  [record]\n   861\t  (let [address? jing/segment-address?\n   862\t        shape (fn [k] {:rule :record-shape, :key k})\n   863\t        output? (fn [o] (or (string? o) (keyword? o)))]\n   864\t    (cond\n   865\t      (not (map? record)) {:rule :record-shape}\n   866\t      (not= record-keys (set (keys record))) {:rule :record-shape}\n   867\t      (not= :derive (:yin.ledger/op record))\n   868\t      {:rule :op, :op (:yin.ledger/op record)}\n   869\t      (not (address? (:yin.ledger/input record)))\n   870\t      (shape :yin.ledger/input)\n   308\t              d (defect-or-throw bad)\n   309\t              m (jing/materialize! store bad)\n   310\t              w (try (closure/walk store m)\n   311\t                     (catch #?(:cljd Object :clj Throwable :cljs :default) e\n   312\t                       {::threw (str e)}))]\n   313\t          (is (map? d) (pr-str d))\n   314\t          (is (not (contains? d ::threw)) (pr-str d))\n   315\t          (is (= [:invalid m :manifest-defect]\n   316\t                 [(:yin.link.closure/outcome w) (:address w) (get-in w [:defect :code])])\n   317\t              (str \"the walk is total: \" (pr-str w))))))))\n   318\t\n   319\t\n   320\t(deftest a-malformed-optional-index-is-a-manifest-defect-naming-the-manifest\n   321\t  (doseq [bad [42 [1] \"bad\"]]\n   322\t    (testing (pr-str bad)\n   323\t      (let [store (mem/create-content-mem)\n   324\t            res (publish-base! store)\n   325\t            m (with-manifest store (assoc (:manifest res) :yin.module/index bad))]\n   326\t        (is (= {:rule :manifest-shape :key :yin.module/index}\n   327\t               (defect-or-throw (jing/get store m nil))))\n   328\t        (is (= {:yin.link.closure/outcome :invalid :address m :role :manifest :path [m]\n   329\t                :defect {:code :manifest-defect\n   330\t                         :detail {:rule :manifest-shape :key :yin.module/index}}}\n   331\t               (select-keys (closure/walk store m)\n   332\t                            [:yin.link.closure/outcome :address :role :path :defect])))))))\n   333\t\n   334\t\n   335\t(deftest each-bound-is-a-parts-limit\n   336\t  (let [{:keys [store app]} (world)]\n   337\t    (doseq [[bounds bound] [[{:max-parts 2} :max-parts]\n   338\t                            [{:max-depth 1} :max-depth]\n   339\t                            [{:max-bytes 64} :max-bytes]]]\n   340\t      (testing (name bound)\n   341\t        (is (= {:code :parts-limit :detail {:bound bound}}\n   342\t               (:defect (closure/walk store (:address app) {:bounds bounds}))))))))\n   343\t\n   344\t\n   345\t(deftest a-forged-row-is-an-address-mismatch-never-a-throw\n   346\t  (let [[_ forged address] (first (invalid-fixtures))\n   347\t        w (closure/walk forged address)]\n   348\t    (is (= :address-mismatch (get-in w [:defect :code])))\n   349\t    (is (= :row (:role w)))))\n   350\t\n   351\t\n   352\t;; =============================================================================\n   353\t;; The publisher walks what it minted (5.2)\n   354\t;; =============================================================================\n   355\t\n   356\t(defn- dropping\n   357\t  \"A handle over `store` whose put of `address` answers `:inserted` and\n   358\t   stores nothing: a backend that loses a write.\"\n   359\t  [store address]\n   360\t  (assoc store :put-bytes-fn\n   361\t         (fn [a bs]\n   362\t           (if (= a address) :inserted ((:put-bytes-fn store) a bs)))))\n   363\t\n   364\t\n   365\t(deftest publish-refuses-unless-the-minted-closure-is-complete\n   366\t  (let [probe (publish-base! (mem/create-content-mem))\n   367\t        {:keys [leaf]} (leaf-and-interior\n   368\t                         (let [s (mem/create-content-mem)] (publish-base! s) s)\n   369\t                         (get-in probe [:manifest :yin.module/tree]))\n   370\t        store (mem/create-content-mem)\n   371\t        res (publish-base! (dropping store leaf))]\n   372\t    (is (= :refused (:status res)) (pr-str res))\n   373\t    (is (= :yin.link.publish/incomplete-closure (:reason res)))\n   374\t    (is (= {:yin.link.closure/outcome :missing :address leaf :role :row\n   375\t            :path [(:address probe)]}\n   376\t           (:walk res)))))\n   377\t\n   378\t\n   379\t(deftest a-requirement-holding-no-valid-manifest-is-refused-by-the-walk\n   380\t  (let [source (mem/create-content-mem)\n   381\t        base (publish-base! source)\n   382\t        forged-manifest (mem/create-content-mem\n   383\t                          (assoc (entries source) (:address base)\n   384\t                                 (jing/canonical-bytes\n   385\t                                   (assoc (:manifest base) :yin.module/name 'other))))\n   386\t        root (:yin.module/tree (:manifest (publish-app! (mem/create-content-mem\n   387\t                                                          (entries source))\n   388\t                                                        (:address base))))]\n   389\t    (testing \"bytes that do not hash to the pinned address\"\n   390\t      (let [before (addresses forged-manifest)\n   391\t            res (publish-app! forged-manifest (:address base))]\n   392\t        (is (= {:status :refused :reason :yin.link.publish/invalid-requirement\n   393\t                :name 'base}\n   394\t               res))\n   395\t        (is (= before (addresses forged-manifest)) \"nothing was written\")\n   396\t        (is (nil? (jing/get forged-manifest root nil)))))\n   397\t    (testing \"a pinned closure with a blob absent\"\n   398\t      (let [tree (get-in base [:manifest :yin.module/tree])\n   399\t            partial (without source tree)\n   400\t            before (addresses partial)\n   401\t            res (publish-app! partial (:address base))]\n   402\t        (is (= :yin.link.publish/incomplete-requirement (:reason res)) (pr-str res))\n   403\t        (is (= 'base (:name res)))\n   404\t        (is (= {:yin.link.closure/outcome :missing :address tree :role :row\n   405\t                :path [(:address base)]}\n   406\t               (:walk res)))\n   407\t        (is (= before (addresses partial)) \"nothing was written\")))))\n   668\t\n   669\t(deftest a-retraction-of-an-assertion-outside-the-snapshot-set-is-global\n   670\t  (let [gone (fn [{:keys [base]}] (assertion p1 'base base 1))\n   671\t        gone-id (fn [r] (jing/segment-key (:env (gone r))))]\n   672\t    (testing \"reported once, globally, with the retraction's principal and the id it names\"\n   673\t      (let [r (reader (fn [a] [[(retraction p1 (gone a) 2)]\n   674\t                               [(retraction p1 (gone a) 2) (assertion p1 'app (:app a) 3)]]))\n   675\t            authority (declare-keys p1)\n   676\t            env (ld/names (:node r) authority)]\n   677\t        (is (= [[:dangling-retraction (sign/principal (:public p1)) (gone-id r)]]\n   678\t               (mapv (juxt :reason :principal :of) (:global-diagnostics env)))\n   679\t            (pr-str env))\n   680\t        (testing \"and in no per-name diagnostic\"\n   681\t          (is (not-any? #(= :dangling-retraction (:reason %)) (:diagnostics env))\n   682\t              (pr-str (:diagnostics env)))\n   683\t          (is (= {:status :refused :reason :absent :name 'base :diagnostics []}\n   684\t                 (ld/resolve-name (:node r) authority 'base)))\n   685\t          (is (= (:app r) (:address (ld/resolve-name (:node r) authority 'app)))\n   686\t              \"the other name still resolves\"))\n   687\t        (dht/close! (:node r))))\n   688\t    (testing \"a retraction whose target is a retraction names no name: global too\"\n   689\t      (let [r (reader (fn [a]\n   690\t                        (let [r1 (retraction p1 (gone a) 2)]\n   691\t                          [[r1 (retraction p1 r1 3) (assertion p1 'app (:app a) 4)]])))\n   692\t            authority (declare-keys p1)\n   693\t            env (ld/names (:node r) authority)\n   694\t            r1-id (jing/segment-key (:env (retraction p1 (gone r) 2)))]\n   695\t        (is (= #{[:dangling-retraction (gone-id r)] [:dangling-retraction r1-id]}\n   696\t               (set (mapv (juxt :reason :of) (:global-diagnostics env))))\n   697\t            (pr-str env))\n   698\t        (is (= 2 (count (:global-diagnostics env))) \"each once\")\n   699\t        (is (not-any? #(= :dangling-retraction (:reason %)) (:diagnostics env))\n   700\t            (pr-str (:diagnostics env)))\n   701\t        (dht/close! (:node r))))\n   702\t    (testing \"a retraction of an assertion inside the set stays with that name\"\n   703\t      (let [r (reader (fn [a] [[(gone a)] [(retraction p2 (gone a) 1)]]))\n   704\t            authority (declare-keys p1 p2)\n   705\t            env (ld/names (:node r) authority)]\n   706\t        (is (= [] (:global-diagnostics env)) (pr-str env))\n   707\t        (is (= [[:dangling-retraction (sign/principal (:public p2))]]\n   708\t               (mapv (juxt :reason :principal) (:diagnostics env))))\n   709\t        (is (= (:base r) (:address (ld/resolve-name (:node r) authority 'base)))\n   710\t            \"p2 cannot retract p1's assertion\")\n   711\t        (dht/close! (:node r))))))\n   712\t\n   713\t\n   714\t;; =============================================================================\n   715\t;; L4: publishing a name, and republishing it (5.3, 6.5, 6.6)\n   716\t;; =============================================================================\n   717\t\n   718\t(def ^:private lines\n   719\t  [\"(def k (fn [] 1))\" \"(def g (fn [] (+ (k) 41)))\"])\n   720\t\n   721\t\n   722\t(defn- signed-index!\n   723\t  \"Publish `envelopes` (`publish/assertion`'s answers) as one covered\n   724\t   index through `node`.\"\n   725\t  [node envelopes]\n   726\t  (envelope-index! node (mapv (fn [s] {:env (:envelope s) :proof (:proof s)})\n   727\t                              envelopes)))\n   728\t\n   729\t\n   730\t(deftest publish-name-derives-publishes-and-signs-and-refuses-writing-nothing\n   731\t  (let [node (dht/join {:local (mem/create-content-mem)})\n   732\t        db (publish-test/indexed lines)\n   733\t        entries #(count (ct/entries (dht/local node)))\n   734\t        opts {:name 'my.lib :exports '[g] :key p1 :primitives vm/primitives}]\n   735\t    (testing \"without a key: refused, nothing written\"\n   736\t      (is (= {:status :refused :reason :yin.link.publish/no-key :name 'my.lib}\n   737\t             (ld/publish-name! node db (dissoc opts :key))))\n   738\t      (is (zero? (entries))))\n   739\t    (testing \"an undefined export: refused, nothing written\"\n   740\t      (is (= :yin.link.publish/undefined-export\n   741\t             (:reason (ld/publish-name! node db (assoc opts :exports '[nope])))))\n   742\t      (is (zero? (entries))))\n   743\t    (let [res (ld/publish-name! node db opts)]\n   744\t      (is (= :ok (:status res)))\n   745\t      (is (jing/segment-address? (:address res)))\n   746\t      (is (= #{:yin.ast/code :yin.semantic/code :yin.debruijn.code\n   747\t               :yin.debruijn.register}\n   748\t             (set (keys (:links res)))))\n   749\t      (is (= [{:yin.module/op :assert :yin.module/name 'my.lib\n   750\t               :yin.module/manifest (:address res)\n   751\t               :yin.module/asserted-by (sign/principal (:public p1))\n   752\t               :yin.module/seq 1}]\n   753\t             (mapv :envelope (:envelopes res))))\n   754\t      (is (= :complete (:yin.link.closure/outcome\n   755\t                         (closure/walk (dht/local node) (:address res))))))\n   756\t    (dht/close! node)))\n   757\t\n   758\t\n   759\t(defn- reader-of\n   760\t  \"A solo reader over a copy of `publisher`'s store that has loaded the\n   761\t   index snapshots `manifests`, and nothing else.\"\n   762\t  [publisher manifests]\n   763\t  (let [node (reduce dht/load-index\n   764\t                     (dht/join {:local (mem/create-content-mem\n   765\t                                         (ct/entries (dht/local publisher)))})\n   766\t                     manifests)\n   767\t        [node _] (dht/step node 0)]\n   768\t    node))\n   769\t\n   770\t\n   771\t(deftest republishing-a-name-resolves-by-the-snapshot-a-reader-holds\n   772\t  (let [node (dht/join {:local (mem/create-content-mem)})\n   773\t        opts {:name 'my.lib :exports '[g] :key p1 :primitives vm/primitives}\n   774\t        first-run (ld/publish-name! node (publish-test/indexed lines) opts)\n   775\t        old (:address first-run)\n   776\t        m1 (signed-index! node (:envelopes first-run))\n   777\t        changed (ld/publish-name!\n   778\t                  node\n   779\t                  (query/relation\n   780\t                    (into (publish-test/indexed-datoms\n   781\t                            [\"(def k (fn [] 2))\" \"(def g (fn [] (+ (k) 41)))\"])\n   782\t                          (index/read-datoms (dht/local node) m1)))\n   783\t                  opts)\n   784\t        new (:address changed)\n   785\t        m2 (signed-index! node (into (:envelopes first-run) (:envelopes changed)))\n   786\t        authority (declare-keys p1)\n   787\t        resolve-in (fn [manifests]\n   788\t                     (let [reader (reader-of node manifests)\n   789\t                           env (ld/names reader authority)]\n   790\t                       (dht/close! reader)\n   791\t                       env))]\n   792\t    (is (not= old new))\n   793\t    (testing \"the new manifest writes the retraction, then the assertion\"\n   794\t      (is (= [[:retract 2] [:assert 3]]\n   795\t             (mapv (fn [s] [(:yin.module/op (:envelope s)) (:yin.module/seq (:envelope s))])\n   796\t                   (:envelopes changed))))\n   797\t      (is (= (jing/segment-key (:envelope (first (:envelopes first-run))))\n   798\t             (:yin.module/of (:envelope (first (:envelopes changed)))))))\n   799\t    (testing \"a reader of the new snapshot resolves the new address\"\n   800\t      (is (= new (get-in (resolve-in [m2]) [:names 'my.lib :address]))))\n   801\t    (testing \"a reader holding only the old snapshot resolves the old one\"\n   802\t      (is (= old (get-in (resolve-in [m1]) [:names 'my.lib :address]))))\n   803\t    (testing \"both snapshots: an envelope in two counts once\"\n   804\t      (let [env (resolve-in [m1 m2])]\n   805\t        (is (= new (get-in env [:names 'my.lib :address])))\n   806\t        (is (empty? (:diagnostics env)))))\n   807\t    (dht/close! node)))\n   347\t    (is (= {:status :refused :reason :yin.link.publish/host-module\n   348\t            :name 'dao.space.query/q :module 'dao.space.query}\n   349\t           (derive '[q2])))\n   350\t    (is (= :my.lib (keyword (:name (derive '[ok]))))\n   351\t        \"an export with no free name derives\")))\n   352\t\n   353\t\n   354\t;; =============================================================================\n   355\t;; L4: name envelopes and the derived sequence (6.1, 6.5, 6.6)\n   356\t;; =============================================================================\n   357\t\n   358\t(def ^:private k1 (sign/generate))\n   359\t(def ^:private k2 (sign/generate))\n   360\t\n   361\t\n   362\t(defn- envelope-db\n   363\t  \"An index of `signed` envelopes, one entity each, as 6.1 writes them.\"\n   364\t  [signed]\n   365\t  (query/relation\n   366\t    (into []\n   367\t          (comp (map-indexed (fn [i s]\n   368\t                               (map (fn [[_ a v]] [(+ 100 i) a v i 1])\n   369\t                                    (:datoms s))))\n   370\t                cat)\n   371\t          signed)))\n   372\t\n   373\t\n   374\t(deftest the-sequence-is-derived-from-the-publisher-s-own-envelopes\n   375\t  (let [a (jing/segment-key \"manifest a\")]\n   376\t    (is (= 1 (publish/next-seq (envelope-db []) k1)))\n   377\t    (is (= 4 (publish/next-seq\n   378\t               (envelope-db [(publish/assertion k1 {:name 'x :manifest a :seq 3})\n   379\t                             (publish/assertion k2 {:name 'y :manifest a :seq 9})])\n   380\t               k1))\n   381\t        \"another principal's sequences do not count\")))\n   382\t\n   383\t\n   384\t(deftest republishing-a-name-retracts-then-asserts-and-the-same-manifest-writes-nothing\n   385\t  (let [a (jing/segment-key \"manifest a\")\n   386\t        b (jing/segment-key \"manifest b\")\n   387\t        first-time (publish/name-envelopes (envelope-db []) k1 'lib a)\n   388\t        db1 (envelope-db first-time)\n   389\t        again (publish/name-envelopes db1 k1 'lib a)\n   390\t        moved (publish/name-envelopes db1 k1 'lib b)\n   391\t        principal (sign/principal (:public k1))\n   392\t        declared {:principals {principal {:proof :yin.module/signature\n   393\t                                          :key (:public k1)\n   394\t                                          :verify sign/verify-envelope}}}\n   395\t        fold (fn [signed]\n   396\t               (authority/name-environment\n   397\t                 declared (mapv (fn [s]\n   398\t                                  {:yin.module/envelope (:envelope s)\n   399\t                                   :yin.module/proof (:proof s)})\n   400\t                                signed)))]\n   401\t    (is (= [{:yin.module/op :assert :yin.module/name 'lib :yin.module/manifest a\n   402\t             :yin.module/asserted-by principal :yin.module/seq 1}]\n   403\t           (mapv :envelope first-time)))\n   404\t    (is (= [] again) \"the name already binds that manifest\")\n   405\t    (is (= [[:retract 2 (jing/segment-key (:envelope (first first-time)))]\n   406\t            [:assert 3 b]]\n   407\t           (mapv (fn [{e :envelope}]\n   408\t                   [(:yin.module/op e) (:yin.module/seq e)\n   409\t                    (or (:yin.module/of e) (:yin.module/manifest e))])\n   410\t                 moved)))\n   411\t    (testing \"every proof verifies, and the fold resolves the new address\"\n   412\t      (is (= a (get-in (fold first-time) [:names 'lib :address])))\n   413\t      (is (= b (get-in (fold (into first-time moved)) [:names 'lib :address])))\n   414\t      (is (empty? (:diagnostics (fold (into first-time moved))))))\n   415\t    (testing \"without the retraction the fold refuses as ambiguous\"\n   416\t      (is (= :ambiguous-name\n   417\t             (get-in (fold (conj first-time (last moved))) [:names 'lib :reason]))))\n   418\t    (testing \"a datom pair per envelope, one entity, as 6.1 indexes it\"\n   419\t      (is (= [[7 :yin.module/envelope (:envelope (first first-time))]\n   420\t              [7 :yin.module/proof (:proof (first first-time))]]\n   421\t             (:datoms (publish/assertion k1 {:name 'lib :manifest a :seq 1 :e 7})))))))\n","exit_code":0,"status":"completed"}}
