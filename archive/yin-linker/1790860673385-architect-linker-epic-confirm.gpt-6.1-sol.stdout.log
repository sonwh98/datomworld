               (env-diagnostic\n   359\t                                        :dangling-retraction\n   360\t                                        :dangling-retraction\n   361\t                                        (:env cand)\n   362\t                                        {:of (get (:env cand)\n   363\t                                                  :yin.module/of)}))\n   364\t                                    (or dangling []))))\n   365\t     :honored-seq (into {}\n   366\t                        (keep (fn [pr]\n   367\t                                (when (seq (:honored pr))\n   368\t                                  [(:principal pr)\n   369\t                                   (reduce max (map :seq (:honored pr)))])))\n   370\t                        per-principal)\n   371\t     :snapshot (:snapshot authority)}))\n    90\t   linker/stack-format linker/register-format])\n    91\t\n    92\t\n    93\t(defn link-local\n    94\t  \"Link `format`'s image through the manifest `address` over `handle`'s\n    95\t   own content, `:verifying` with discharge deferred, as a serving\n    96\t   composition does (yin.vm.linker.dht.md 4.1): a fresh local runtime per\n    97\t   call, so no request reaches any peer.  `opts` overrides the link\n    98\t   options.\"\n    99\t  ([handle address format] (link-local handle address format nil))\n   100\t  ([handle address format opts]\n   101\t   (linker/link-manifest\n   102\t     (linker/local-runtime\n   103\t       handle {:formats (into {} (map (fn [f] [(:format f) f]))\n   104\t                              (conj code-formats linker/manifest-format\n   105\t                                    linker/record-format))})\n   106\t     address (:format format) {:primitives vm/primitives}\n   107\t     (merge {:contract (:contract format)\n   108\t             :derivation :verifying\n   109\t             :defer-discharge true}\n   110\t            opts))))\n   111\t\n   112\t\n   113\t(defn publish-module!\n   114\t  \"Mint all four code formats, derivation records, and one schema-1 manifest.\"\n   115\t  [handle {:keys [name ast exports requires primitives] :as spec}]\n   116\t  (let [undefined (first (remove (definitions ast) exports))\n   117\t        tree (when-not undefined\n   118\t               (try (vm/ast->semantic-bytecode ast)\n   119\t                    (catch #?(:cljd Object :clj Exception :cljs :default) _\n   120\t                      (refusal :yin.link.publish/malformed-tree {}))))\n   121\t        defect (when (and tree (not= :refused (:status tree)))\n   122\t                 (vm/validate-rows tree))\n   123\t        ;; each pinned closure is walked before anything is written; an\n   124\t        ;; absent pinned manifest is the footprint's missing-requirement\n   125\t        requirement\n   126\t        (when (and tree (not defect) (not= :refused (:status tree)))\n   127\t          (some (fn [[n address]]\n   128\t                  (let [w (closure/walk handle address)]\n   129\t                    (case (:yin.link.closure/outcome w)\n   130\t                      :complete nil\n   131\t                      :invalid (refusal :yin.link.publish/invalid-requirement\n   132\t                                        {:name n})\n   133\t                      :missing (when (not= address (:address w))\n   134\t                                 (refusal :yin.link.publish/incomplete-requirement\n   135\t                                          {:name n :walk w})))))\n   136\t                (sort-by (fn [[n _]] (str n)) requires)))\n   137\t        fp (when (and tree (not defect) (not requirement)\n   138\t                      (not= :refused (:status tree)))\n   139\t             (footprint handle (assoc spec :tree tree)))]\n   140\t    (cond\n   141\t      undefined\n   142\t      (refusal :yin.link.publish/undefined-export {:export undefined})\n   143\t\n   144\t      (= :refused (:status tree)) tree\n   145\t\n   146\t      defect\n   147\t      (refusal :yin.link.publish/malformed-tree {:defect defect})\n   148\t\n   149\t      requirement requirement\n   150\t\n   151\t      (= :refused (:status fp)) fp\n   152\t\n   153\t      :else\n   154\t      (let [tree-address (vm/materialize-tree! handle tree)\n   155\t            sem-vector (:vector (linearize/lower-rows tree))\n   156\t            sem (code/materialize-vector! handle sem-vector)\n   157\t            h-image (:image (dl/adapt (vm/ast->datoms ast)))\n   158\t            r-image (:image (rc/adapt (second (vm/ast->datoms-with-root ast))))\n   159\t            h (dcode/image-hash h-image)\n   160\t            r (rcode/register-hash r-image)\n   161\t            h-address (jing/materialize! handle h-image)\n   162\t            r-address (jing/materialize! handle r-image)\n   163\t            mint (fn [output profile]\n   164\t                   (jing/materialize!\n   165\t                     handle\n   166\t                     (assoc (ledger/derive-record tree-address output)\n   167\t                            :yin.ledger/profile profile)))\n   168\t            manifest {:yin.module/name name\n   169\t                      :yin.module/schema linker/manifest-schema\n   170\t                      :yin.module/contracts\n   171\t                      {:yin.ast/code vm/ast-contract\n   172\t                       :yin.semantic/code vm/semantic-contract\n   173\t                       :yin.debruijn.code vm/stack-contract\n   174\t                       :yin.debruijn.register vm/register-contract}\n   175\t                      :yin.module/tree tree-address\n   176\t                      :yin.module/derivations\n   177\t                      {:yin.semantic/code (mint sem ledger/lowering-profile)\n   178\t                       :yin.debruijn.code\n   179\t                       (mint h linker/stack-lowering-profile)\n   180\t                       :yin.debruijn.register\n   181\t                       (mint r linker/register-lowering-profile)}\n   182\t                      :yin.module/index {h h-address r r-address}\n   183\t                      :yin.module/exports (set exports)\n   184\t                      :yin.module/requires (or requires {})\n   185\t                      :yin.module/primitives\n   186\t                      (into {} (map (fn [[n p]] [n (:yin.k/profile p)])\n   187\t                                    primitives))\n   188\t                      :yin.module/footprint fp}\n   189\t            address (jing/materialize! handle manifest)\n   190\t            walked (closure/walk handle address)]\n   191\t        (if (not= :complete (:yin.link.closure/outcome walked))\n   192\t          (refusal :yin.link.publish/incomplete-closure\n   193\t                   {:address address :walk walked})\n   194\t          (let [links (into {}\n   195\t                            (map (fn [f]\n   309\t(deftest a-malformed-optional-index-fails-the-load-as-a-manifest-defect\n   310\t  (doseq [bad [42 [1] \"bad\"]]\n   311\t    (testing (pr-str bad)\n   312\t      (let [store (mem/create-content-mem)\n   313\t            m (jing/materialize! store (assoc (:manifest (ct/publish-base! store))\n   314\t                                              :yin.module/index bad))\n   315\t            [node events] (dht/step (ld/load-module (dht/join {:local store}) m) 0)]\n   316\t        (is (= {:status :refused :reason :descriptor-defect :address m\n   317\t                :code :manifest-defect\n   318\t                :detail {:rule :manifest-shape :key :yin.module/index}}\n   319\t               (ld/load-refusal (ld/module-status node m))))\n   320\t        (is (= 1 (count (filter #(= :load-failed (::dht/event %)) events))))\n   321\t        (dht/close! node)))))\n   322\t\n   323\t\n   324\t(defn- hiding\n   325\t  \"`store` whose reads of any address `@hidden` holds answer not-found: a\n   326\t   local store that lost a blob after the load walked it.\"\n   327\t  [store hidden]\n   328\t  (assoc store :get-bytes-fn\n   329\t         (fn