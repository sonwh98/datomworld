{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/space/dht.cljc | sed -n '680,870p;1200,1288p'; nl -ba src/cljc/yin/repl/index.cljc | sed -n '378,431p'; rg -n 'load-failed|loaded|manifest|re-check|checks' src/cljc/yin/repl/dht.cljc | tail -35; rg -n 'cljd|cljs|test:clj|peer|find-test' bb.edn; nl -ba test/yin/vm/linker/sign_test.cljc | sed -n '1,107p'; nl -ba src/cljc/yin/vm/linker.cljc | sed -n '742,761p'; git diff -- docs\"","aggregated_output":"   680\t              (and (::manifest v) (:window-lost? node))\n   681\t              (recur (assoc node :window (new-ledger) :window-lost? false)\n   682\t                     cursor\n   683\t                     (conj events {::event :publication-unknown\n   684\t                                   :manifest (::manifest v)}))\n   685\t\n   686\t              (::manifest v) (recur (announce node (::manifest v)) cursor events)\n   687\t              (:window-lost? node) (recur node cursor events)\n   688\t              :else (recur (admit node (::put v)) cursor events)))\n   689\t\n   690\t          :dao.stream/gap\n   691\t          (let [lost (:order (:window node))]\n   692\t            (recur (-> node\n   693\t                       (assoc :window (new-ledger) :window-lost? true)\n   694\t                       (release-entries lost nil))\n   695\t                   (:dao.stream/cursor next)\n   696\t                   events))\n   697\t\n   698\t          [(assoc node :ledger-cursor cursor) events])))))\n   699\t\n   700\t\n   701\t;; =============================================================================\n   702\t;; Repair admission (5.5.4): before fresh admission, oldest first\n   703\t;; =============================================================================\n   704\t\n   705\t(defn- repairing?\n   706\t  [pub]\n   707\t  (and (:reported? pub) (not (:cancelled? pub)) (nil? (:ended pub))\n   708\t       (not= :acknowledged (result pub))))\n   709\t\n   710\t\n   711\t(defn- held-in-repair\n   712\t  [node id]\n   713\t  (count (filter #(= id %) (vals (:repair-owner node)))))\n   714\t\n   715\t\n   716\t(defn- open-cycle\n   717\t  [node pub]\n   718\t  (if (and (repairing? pub) (nil? (:cycle pub))\n   719\t           (>= (:reading node) (:due pub)))\n   720\t    (assoc pub\n   721\t           :cycle {:offered (vec (sort-by str (filter #(retryable? (get-in pub [:entries %]))\n   722\t                                                      (:order pub))))\n   723\t                   :next 0\n   724\t                   :sent? false}\n   725\t           :cycles (inc (:cycles pub)))\n   726\t    pub))\n   727\t\n   728\t\n   729\t(defn- fill-batch\n   730\t  \"Offer the publication's open cycle to the repair queue until it holds\n   731\t   `:repair-batch` addresses there.\"\n   732\t  [node i]\n   733\t  (let [{:keys [id cycle] :as pub} (get-in node [:pubs i])\n   734\t        offered (:offered cycle)\n   735\t        batch (limit node :repair-batch)]\n   736\t    (loop [node node\n   737\t           k (:next cycle)\n   738\t           held (held-in-repair node id)]\n   739\t      (if (or (nil? cycle) (>= k (count offered)) (>= held batch))\n   740\t        (cond-> node cycle (assoc-in [:pubs i :cycle :next] k))\n   741\t        (let [a (nth offered k)]\n   742\t          (cond\n   743\t            (= :sent (get-in pub [:entries a :state])) (recur node (inc k) held)\n   744\t            (attempting? node a) (recur node (inc k) held)\n   745\t            :else (recur (-> node\n   746\t                             (update :repair conj a)\n   747\t                             (assoc-in [:queued a] :repair)\n   748\t                             (assoc-in [:repair-owner a] id))\n   749\t                         (inc k)\n   750\t                         (inc held))))))))\n   751\t\n   752\t\n   753\t(defn- admit-repairs\n   754\t  [node]\n   755\t  (reduce (fn [node i]\n   756\t            (-> node\n   757\t                (update-in [:pubs i] #(open-cycle node %))\n   758\t                (fill-batch i)))\n   759\t          node\n   760\t          (range (count (:pubs node)))))\n   761\t\n   762\t\n   763\t;; =============================================================================\n   764\t;; Release (5.5.2): below the DHT's bound, repair slots reserved\n   765\t;; =============================================================================\n   766\t\n   767\t(defn- take-issuable\n   768\t  \"Up to `n` addresses of `queue`, in order, with no request in flight.\"\n   769\t  [node queue n]\n   770\t  (loop [q queue\n   771\t         acc []]\n   772\t    (if (or (empty? q) (>= (count acc) n))\n   773\t      acc\n   774\t      (let [a (first q)]\n   775\t        (recur (rest q)\n   776\t               (if (contains? (:inflight node) a) acc (conj acc a)))))))\n   777\t\n   778\t\n   779\t(defn- issue\n   780\t  [node kind addresses]\n   781\t  (if (empty? addresses)\n   782\t    node\n   783\t    (let [requests (get-in node [:composition :requests])\n   784\t          issued (set addresses)]\n   785\t      (doseq [a addresses]\n   786\t        (stream/append! requests {::dht/replicate a}))\n   787\t      (-> (reduce (fn [node a]\n   788\t                    (-> node\n   789\t                        (update :queued dissoc a)\n   790\t                        (update :repair-owner dissoc a)\n   791\t                        (assoc-in [:inflight a] {:kind kind :settled? false})))\n   792\t                  node\n   793\t                  addresses)\n   794\t          (update kind (fn [q] (filterv #(not (contains? issued %)) q)))))))\n   795\t\n   796\t\n   797\t(defn- in-flight\n   798\t  [node kind]\n   799\t  (count (filter #(= kind (:kind %)) (vals (:inflight node)))))\n   800\t\n   801\t\n   802\t(defn- release\n   803\t  [node]\n   804\t  (if (nil? (:dht node))\n   805\t    node\n   806\t    (let [slots (limit node :repair-slots)\n   807\t          room #(- max-pen