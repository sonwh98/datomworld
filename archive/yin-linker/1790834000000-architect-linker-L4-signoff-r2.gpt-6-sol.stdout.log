                 [\"(def a 4101)\" \"(def b 4102)\"])\n   355\t        packets (stream-values (:row-stream state))]\n   356\t    (testing \"while rows cannot be written, no round publishes and HEAD stays\"\n   357\t      (is (str/includes? first-text \"materialize failed\"))\n   358\t      (is (str/includes? second-text \"materialize failed\"))\n   359\t      (is (= [] @heads))\n   360\t      (is (= 2 (:transactions (repl.index/status (:indexer state))))))\n   361\t    (reset! broken? false)\n   362\t    (let [[state [text]] (evaluate state [\"(def c 4103)\"])\n   363\t          status (repl.index/status (:indexer state))\n   364\t          rows (mapcat (comp vals :rows macro/packet->row-set)\n   365\t                       (stream-values (:row-stream state)))]\n   366\t      (testing \"the next round writes the earlier rows first, then publishes\"\n   367\t        (is (= 3 (count (stream-values (:row-stream state)))))\n   368\t        (is (every? (fn [[id & body]] (= (vec body) (jing/get store id nil))) rows)\n   369\t            \"every committed program's rows are held\")\n   370\t        (is (= 1 (count @heads)) \"one HEAD move, covering all three\")\n   371\t        (is (= 3 (count (filter #(= :yin.repl/root (second %))\n   372\t                                (index/read-datoms store (first @heads))))))\n   373\t        (is (true? (:published? status)))\n   374\t        (is (nil? (:failure status)) \"the materialize failure is recovered\")\n   375\t        (is (str/starts-with? text \"4103\"))\n   376\t        (is (str/includes? text \"rows of earlier rounds are now written\"))))\n   377\t    (is (= 2 (count packets)))))\n   378\t\n   379\t\n   380\t(deftest the-name-envelopes-are-one-transaction-under-the-session-s-metadata\n   381\t  (let [[state _] (evaluate (repl/create-state) [\"(def f (fn [] 1))\"])\n   382\t        key (sign/generate)\n   383\t        signed [(publish/assertion key {:name 'lib :seq 1\n   384\t                                        :man