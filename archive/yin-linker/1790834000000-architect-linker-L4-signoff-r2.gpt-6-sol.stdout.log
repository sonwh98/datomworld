)\n   236\t                        (scan (get-in node [:operator :body]))))))]\n   237\t    (vec (scan ast))))\n   238\t\n   239\t\n   240\t(deftest module-from-index-collects-the-program-requiring-each-linked-module\n   241\t  (let [spec (publish/module-from-index\n   242\t               (indexed derived-lines)\n   243\t               {:name 'my.lib :exports '[f] :primitives vm/primitives\n   244\t                :modules {'base base-address}})]\n   245\t    (testing \"the separately typed require is collected, once, in t order\"\n   246\t      (is (= '[base] (module-requires (:ast spec))))\n   247\t      (is (= '[f h] (module-defs (:ast spec)))))\n   248\t    (testing \"no requiring program: refused, naming the module\"\n   249\t      (is (= {:status :refused :reason :yin.link.publish/missing-require-program\n   250\t              :module 'base}\n   251\t             (publish/module-from-index\n   252\t               (indexed (pop derived-lines))\n   253\t               {:name 'my.lib :exports '[f] :primitives vm/primitives\n   254\t                :modules {'base base-address}}))))))\n   255\t\n   256\t\n   257\t(deftest module-from-index-collects-defining-programs-in-t-order\n   258\t  (let [db (indexed derived-lines)\n   259\t        spec (publish/module-from-index\n   260\t               db {:name 'my.lib :exports '[f]\n   261\t                   :primitives vm/primitives\n   262\t                   :modules {'base base-address}})]\n   263\t    (is (= 'my.lib (:name spec)))\n   264\t    (is (= #{'f} (:exports spec)))\n   265\t    (testing \"f's program, then h's latest definition: greatest t, ascending\"\n   266\t      (is (= '[f h] (module-defs (:ast spec)))))\n   267\t    (testing \"the free primitives and the linked module are declared\"\n   268\t      ;; `require` is free in the collected requiring program\n   269\t      (is (= {'+ (vm/profile-of vm/primitives '+)\n   270\t              'require (vm/profile-of vm/primitives 'require)}\n   271\t             (:primitives spec)))\n   272\t      (is (= {'base base-address} (:requires spec))))\n   273\t    (testing \"a derived module publishes; :links is the linker's verdict (5.3)\"\n   274\t      (let [spec (publish/module-from-index\n   275\t                   (indexed [\"(def k (fn [] 1))\" \"(def g (fn [] (+ (k) 41)))\"])\n   276\t                   {:name 'closed :exports '[g] :primitives vm/primitives})\n   277\t            res (publish/publish-module! (mem/create-content-mem) spec)\n   278\t            statuses (into {} (map (fn [[f o]] [f (or (:reason o) (:status o))]))\n   279\t                           (:links res))]\n   280\t        (is (= '[k g] (module-defs (:ast spec))))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/repl/index.cljc | sed -n '200,260p;380,465p'; nl -ba test/yin/repl/index_test.cljc | sed -n '325,390p'\"","aggregated_output":"   200\t   they are the datoms as committed.  A recovery without a manifest is an\n   201\t   empty index and leaves the indexer as it is.\"\n   202\t  [indexer {:keys [manifest datoms]}]\n   203\t  (if (nil? manifest)\n   204\t    indexer\n   205\t    (let [log (memory-log)\n   206\t          by-t (group-by index/datom-t datoms)\n   207\t          ts (sort (keys by-t))]\n   208\t      (doseq [t ts]\n   209\t        (let [answer (stream/append! log {:dao.space/transaction\n   210\t                                          {:t t, :datoms (vec (get by-t t))}})]\n   211\t          (when-not (= :dao.stream/ok (:dao.stream/outcome answer))\n   212\t            (throw (ex-info \"the recovered snapshot could not be rehydrated\"\n   213\t                            {:t t, :outcome answer})))))\n   214\t      (assoc indexer\n   215\t             :local log\n   216\t             :next-e (next-entity-id datoms)\n   217\t             :transactions (count ts)\n   218\t             :published (count ts)\n   219\t             :manifest-address manifest))))\n   220\t\n   221\t\n   222\t(defn carry-over\n   223\t  \"A rebuilt session's fresh `indexer`, continuing `previous`'s index: its\n   224\t   transaction log, entity allocation, counts, and published manifest.\n   225\t   `(reset)` and VM selection over a durable store use it, so a rebuild\n   226\t   never resets `t` or entity allocation and `q` keeps answering the\n   227\t   published index; the observer is the new session's, and a lost or\n   228\t   failed indexer is recovered by the rebuild as it is today.\"\n   229\t  [indexer previous]\n   230\t  (merge indexer\n   231\t         (select-keys previous [:local :next-e :transactions :published\n   232\t                                :published-payloads :manifest-address\n   233\t                                :unwritten])))\n   234\t\n   235\t\n   236\t(defn- open-publication\n   237\t  \"The round's transactor and the `dao.jing` pool observer over its intake.\n   238\t   `transactor/create!` derives the next `t` from `:local`'s retained\n   239\t   history, so transaction time continues across rounds.  The intake is\n   240\t   complete-retention: `publish-index!` appends every node blob before the\n   241\t   manifest and the round drains only after it returns, so an evicting\n   242\t   intake would lose the head of any publication larger than its capacity\n   243\t   and that publication could never complete.\"\n   244\t  [ix]\n   245\t  (if (:publication ix)\n   246\t    ix\n   247\t    (let [intake (memory-log)]\n   248\t      (assoc ix\n   249\t             :publication\n   250\t             {:transactor (transactor/create! {:local-stream (:local ix)\n   251\t                                               :intake-pool [intake]\n   252\t                                               :name \"yin.repl.index\"})\n   253\t              :pool (jing/observer-state\n   254\t                      [{:stream intake\n   255\t                        :cursor (:dao.stream/cursor\n   256\t                                  (stream/cursor intake\n   257\t                                                 :dao.stream/oldest))}])}))))\n   258\t\n   259\t\n   260\t(defn- write-rows\n   380\t   for this observer, commit each through the round's publication, publish\n   381\t   when any was committed, then drop the publication — its transactor,\n   382\t   intake, and pool — so the indexer carries none of this round's payloads\n   383\t   into the next.  A gap is recovered across, counted on the observer's\n   384\t   `:ingress-gaps`, and marks the indexer lost: the missing packet and\n   385\t   every later one are never called indexed.\"\n   386\t  [indexer round]\n   387\t  (let [ix (consume indexer\n   388\t                    (fn [ix packet]\n   389\t                      (first (commit (open-publication ix) packet round))))\n   390\t        committed? (> (:transactions ix) (:transactions indexer))\n   391\t        ;; this round's rows and any an earlier round could not write,\n   392\t        ;; before any publication: no announcement names a missing row\n   393\t        ix (if committed? (write-rows ix round) ix)]\n   394\t    (dissoc (if (and committed? (empty? (:unwritten ix)))\n   395\t              (publish ix round)\n   396\t              ix)\n   397\t            :publication)))\n   398\t\n   399\t\n   400\t(defn commit-names\n   401\t  \"Commit the signed name envelopes `signed` -- each `{:envelope e :proof\n   402\t   p}` -- as ONE transaction, then publish the covered indexes at once,\n   403\t   the HEAD write included (docs/design/yin.vm.linker.dht.md 6.1): one\n   404\t   entity per envelope carrying `:yin.module/envelope` and\n   405\t   `:yin.module/proof`, with the session's metadata entity -- `:db/op`,\n   406\t   the session token and `round`, no program root -- in `m`.  A\n   407\t   transaction refused is recorded as the failure, like a packet's.\"\n   408\t  [indexer signed round]\n   409\t  (let [ix (open-publication indexer)\n   410\t        meta-e (:next-e ix)\n   411\t        untimed (fn [e a v m] [e a v nil m])\n   412\t        tx-data (into [(untimed meta-e :db/op :db/assert datom/default-op)\n   413\t                       (untimed meta-e :yin.repl/session (:session-token ix)\n   414\t                                datom/default-op)\n   415\t                       (untimed meta-e :yin.repl/round round datom/default-op)]\n   416\t                      (comp (map-indexed\n   417\t                              (fn [i {:keys [envelope proof]}]\n   418\t                                (let [e (+ meta-e 1 i)]\n   419\t                                  [(untimed e :yin.module/envelope envelope meta-e)\n   420\t                                   (untimed e :yin.module/proof proof meta-e)])))\n   421\t                            cat)\n   422\t                      signed)\n   423\t        answer (transactor/transact! (get-in ix [:publication :transactor])\n   424\t                                     tx-data)]\n   425\t    (dissoc (if (= :dao.stream/ok (:dao.stream/outcome answer))\n   426\t              (let [ix (-> ix\n   427\t                           (assoc :next-e (+ meta-e 1 (count signed)))\n   428\t                           (update :transactions inc)\n   429\t                           (write-rows round))]\n   430\t                (cond-> ix (empty? (:unwritten ix)) (publish round)))\n   431\t              (assoc ix\n   432\t                     :failure {:round round\n   433\t                               :stage :transact\n   434\t                               :outcome (:dao.stream/outcome answer)}))\n   435\t            :publication)))\n   436\t\n   437\t\n   438\t(defn skip\n   439\t  \"Advance the observer past every packet still on the medium without\n   440\t   indexing it: a round that threw before its program ran executes nothing,\n   441\t   so nothing is indexed.  A gap still marks the indexer lost.\"\n   442\t  [indexer]\n   443\t  (consume indexer (fn [ix _packet] ix)))\n   444\t\n   445\t\n   446\t(defn status\n   447\t  \"The indexer's state as the shell reports it.  It depends on the programs\n   448\t   evaluated, never on which evaluator ran them or on the shell's token,\n   449\t   so every VM reports the same status for the same inputs.\"\n   450\t  [indexer]\n   451\t  {:transactions (:transactions indexer)\n   452\t   :published? (and (some? (:manifest-address indexer))\n   453\t                    (= (:published indexer) (:transactions indexer)))\n   454\t   :lost? (:lost? indexer)\n   455\t   :gaps (:ingress-gaps (:observer indexer) 0)\n   456\t   :failure (:failure indexer)})\n   457\t\n   458\t\n   459\t(defn notice\n   460\t  \"What the round from `before` to `after`