its record's ids dies -- so any late answer is\n   712\t   dropped as unsolicited -- and a materialization record the id still\n   713\t   claims is completed :lost with it, so exactly one completion per\n   714\t   materialization survives the retirement.\"\n   715\t  ([state id] (retire state id abandoned-code))\n   716\t  ([state id reason]\n   717\t   (let [put-id (get (:routes state) id)\n   718\t         record (get (:materializations state) put-id)]\n   719\t     (if record\n   720\t       (let [claimed (remove nil? [put-id (get record :get-id)])]\n   721\t         (-> (reduce (fn [s i]\n   722\t                       (-> s\n   723\t                           (update :outstanding dissoc i)\n   724\t                           (update :routes dissoc i)))\n   725\t                     state\n   726\t                     claimed)\n   727\t             (update :completed\n   728\t                     conj (merge (materialization-entry record)\n   729\t                                 {:lost reason}))\n   730\t             (update :materializations dissoc put-id)))\n   731\t       (-> state\n   732\t           (update :outstanding dissoc id)\n   733\t           (update :routes dissoc id))))))\n   734\t\n   735\t\n   736\t(defn abandon\n   737\t  \"Give up on the retained unsent request with `reason` (or this\n   738\t   layer's abandoned-code): the composition that is about to change what\n   739\t   the writer is -- an operator disconnect, a rebind onto a fresh\n   740\t   attachment -- owns the decision that the retained request no longer\n   741\t   belongs to the new binding. The loss is appended as an ordinary\n   742\t   completion and surfaces at the next step's drain, routed by its id.\n   743\t   Records with nothing on the wire are untouched: abandon retires the\n   744\t   one delivery this binding still owes, not the medium's in-flight\n   745\t   answers.\"\n   746\t  ([state] (abandon state abandoned-code))\n   747\t  ([state reason]\n   748\t   (if-some [unsent (:unsent state)]\n   749\t     (-> state\n   750\t         (update :completed conj {:id (:id unsent),\n   751\t                                  :request (dissoc (:value unsent)\n   752\t                                                   :jing/request),\n   753\t                                  :lost reason})\n   754\t         (assoc :unsent nil))\n   755\t     state)))\n   620\t    (cond-> (dissoc status :value)\n   621\t      (and (= :loaded (:status status)) (= dht/index-kind (:kind status)))\n   622\t      (assoc :datoms (count (:value status))))))\n   623\t\n   624\t\n   625\t(defn- publication-call\n   626\t  \"`[node' answer]` of `retry!` or `cancel!` on `manifest`: `ok` answers\n   627\t   `ok`; the plain function's refusal is answered under its own code.\"\n   628\t  [node manifest f ok]\n   629\t  (try [(f node manifest) {:ok ok}]\n   630\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n   631\t         (if-let [code (:dao.space.dht/refused (ex-data e))]\n   632\t           [node (refusal code (ex-message e) nil)]\n   633\t           (throw e)))))\n   634\t\n   635\t\n   636\t(defn- dht-answer\n   637\t  \"The response to one `dao.space.dht` call, answered from `node` — the\n   638\t   shell's DHT node — by the `dao.space.dht` function the operation\n   639\t   names, and the node after it: `load-index` starts a load and answers\n   640\t   its status at once, never waiting; `load-status` answers the load's\n   641\t   status map; `q` answers `dao.space.dht/q` under `limits`, refused\n   642\t   until the index is loaded; `retry` and `cancel` answer `:retrying`\n   643\t   and `:cancelled`, or the plain function's refusal; `load-module`\n   644\t   starts a closure load and answers its status, and `module-status`\n   645\t   answers it without the loaded closure.  Answers\n   646\t   `[node response]`.\"\n   647\t  [node limits request]\n   648\t  (let [id (apply2/request-id request)\n   649\t        [manifest & more] (apply2/request-args request)\n   650\t        [node answer]\n   651\t        (cond\n   652\t          (nil? node)\n   653\t          [node (unavailable (str \"the shell has no DHT node; start it with \"\n   654\t                                  \"--index-store dht:<dir> and --dht-peer\"))]\n   655\t\n   656\t          (nil? (encoded-size (apply2/request-args request)))\n   657\t          [node (invalid \"dao.space.dht takes portable Yin data only\")]\n   658\t\n   659\t          (not (jing/segment-address? manifest))\n   660\t          [node (invalid (str \"dao.space.dht expects a manifest address, got \"\n   661\t                              (pr-str manifest)))]\n   662\t\n   663\t          :else\n   664\t          (case (apply2/request-op request)\n   665\t            ::dht-load-index\n   666\t            (let [node (dht/load-index node manifest)]\n   667\t              [node {:ok (:status (dht/load-status node manifest))}])\n   668\t\n   669\t            ::dht-load-status\n   670\t            [node {:ok (host-status (dht/load-status node manifest))}]\n   671\t\n   672\t            ::dht-load-module\n   673\t            (let [node (linker.dht/load-module node manifest)]\n   674\t              [node {:ok (:status (linker.dht/module-status node manifest))}])\n   675\t\n   676\t            ::dht-module-status\n   677\t            [node {:ok (host-status (linker.dht/module-status node manifest))}]\n   678\t\n   679\t            ::dht-retry\n   680\t            (publication-call node manifest dht/retry! :retrying)\n   681\t\n   682\t            ::dht-cancel\n   683\t            (publication-call node manifest dht/cancel! :cancelled)\n   305\t(defn dial\n   306\t  \"Compose the dialing end of one WebSocket channel (3.1). `:attach!`\n   307\t   is the dao.stream.ws/make-attacher product whose :traffic deposit\n   308\t   medium is the same medium named by `:traffic` (its target), with\n   309\t   `:cursor` already minted on it before any attach!; `:ring` is the\n   310\t   channel ring buffer this end projects onto. `:table` names the\n   311\t   identities this peer serves over the dialed channel, so\n   312\t   `dial-step!` runs the projection and then this end's own mirror\n   313\t   step: the dialing end serves the other direction on the same\n   314\t   connection. `dial-attach!` takes a remote descriptor whose\n   315\t   :dao.stream/channel is this channel's ws descriptor: it attaches,\n   316\t   projects the attachment onto the ring, and answers through\n   317\t   dao.stream.remote/attacher with the channel end {:reader ring\n   318\t   :writer handle} -- the link's drain then runs inside every\n   319\t   reflection operation. One dial value carries one active\n   320\t   attachment; a reattachment composes a fresh dial with a fresh\n   321\t   cursor, as dao.stream.ws.md composes one medium per active client\n   322\t   attachment. :dao.stream.remote/events, :dao.stream.remote/resend-\n   323\t   after and :dao.stream.remote/budget pass to the attacher as its\n   324\t   policy.\"\n   325\t  [{:keys [attach! traffic cursor ring table] :as opts}]\n   326\t  (when-not (and (fn? attach!)\n   327\t                 (map? traffic)\n   328\t                 (stream/writer? (:dao.stream/handle traffic))\n   329\t                 (stream/reader? (:dao.stream/handle traffic))\n   330\t                 (some? cursor)\n   331\t                 (stream/reader? ring)\n   332\t                 (stream/writer? ring)\n   333\t                 (stream/closable? ring)\n   334\t                 (map? table))\n   335\t    (throw (ex-info \"invalid DaoStream ws dial composition\"\n   163\t(defn- snapshot-datoms\n   164\t  \"The datoms of the snapshot `s`: a loaded index's, or HEAD's read from\n   165\t   the node's own store.\"\n   166\t  [node s]\n   167\t  (or (dht/loaded-datoms node s)\n   168\t      (index/read-datoms (dht/local node) s)))\n  1330\t        [(update node :misses select-keys (fetching node)) events]))))\n  1331\t\n  1332\t\n  1333\t;; =============================================================================\n  1334\t;; The public step and reads\n  1335\t;; =============================================================================\n  1336\t\n  1337\t(defn step\n  1338\t  \"Advance the node once at the owner's millisecond reading `now`:\n  1339\t   append it as a tick; finish binding; admit repairs, then the puts and\n  1340\t   announcements on the ledger ring; release replicate requests; step\n  1341\t   the DHT; apply its facts; advance loads; and report publications.\n  1342\t   Answers `[node' events]`.  A refused node (its socket could not bind)\n  1343\t   is answered unchanged.\"\n  1344\t  [node now]\n  1345\t  (if (:refusal node)\n  1346\t    [node []]\n  1347\t    (let [node (tick node now)\n  1348\t          [node bound] (bind-step node)\n  1349\t          node (admit-repairs node)\n  1350\t          [node unknown] (admit-ledger node)\n  1351\t          node (release node)\n  1352\t          node (cond-> node (:dht node) (update :dht dht/step step-budget))\n  1353\t          [node lost] (read-facts node)\n  1354\t          [node loaded] (advance-loads node)\n  1355\t          [node reported] (settle-publications node)]\n  1356\t      [node (-> bound (into unknown) (into lost) (into loaded) (into\n  1357\t                                                                 reported))])))\n  1358\t\n  1359\t\n  1360\t(defn refusal\n  1361\t  \"Why the node stopped (its socket could not bind), or nil.\"\n  1362\t  [node]\n  1363\t  (:refusal node))\n  1364\t\n496:          [node _] (settle (dht/load (solo-node) a {:kind ::test :walk walk}) a)\n497:          reason (:reason (dht/load-status node a))]\n513:        reader (dht/load (node-at net 42 [41] {}) blob {:kind ::test :walk\n517:    (is (= {:status :loaded :kind ::test :fetched 1 :value :got-it}\n518:           (dht/load-status reader blob)))\n553:                 (dht/load a {:kind ::test :walk (missing a)})\n554:          