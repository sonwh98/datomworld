)\n  1281\t          :complete\n  1282\t          [(update-in node [:loads m] #(-> % (assoc :status :loaded :value\n  1283\t                                                    (:value walked))\n  1284\t                                           (dissoc :walk)))\n  1285\t           [(cond-> {::event :loaded :manifest m :kind kind :fetched fetched}\n  1286\t              (= index-kind kind) (assoc :datoms (count (:value walked))))]]\n  1287\t\n  1288\t          :invalid\n  1289\t          (fail-load node m {::failure :invalid :address (:address walked)\n  1290\t                             :defect (:defect walked)})\n  1291\t\n  1292\t          :missing\n  1293\t          (let [a (:address walked)\n  1294\t                {:keys [outcome id], :as asked} (content.step/request-get\n  1295\t                                                  (:client node) a)]\n  1296\t            (case outcome\n  1297\t              (:requested :pending-request)\n  1298\t              [(-> node\n  1299\t                   (assoc :client (:state asked))\n  1300\t                   (assoc-in [:loads m :fetching] {:id id :address a}))\n  1301\t               []]\n  1302\t\n  1303\t              ;; the client still owes a request: ask again next step\n  1304\t              :busy [(assoc node :client (:state asked)) []]\n  1305\t\n  1306\t              (fail-load (assoc node :client (:state asked)) m\n  1307\t                         {::failure :unaskable :address a :outcome\n  1308\t                          outcome}))))))))\n  1309\t\n  1310\t\n  1311\t(defn- advance-loads\n  1312\t  [node]\n  1313\t  (let [loading (sort-by str (keep (fn [[m r]]\n  1314\t                                     (when (= :loading (:status r))\n  1315\t                                       m))\n  1316\t                                   (:loads node)))]\n  1317\t    (if (or (empty? loading) (nil? (:dht node)))\n  1318\t      [node []]\n  1319\t      (let [{:keys [state completions]} (content.step/step (:client node)\n  1320\t                                                           fetch-budget)\n  1321\t            done-by-id (into {} (map (juxt :id identity)) completions)\n  1322\t            [node events] (reduce (fn [[node events] m]\n  1323\t                                    (let [[node more] (advance-load node m\n  1324\t                                                                    done-by-id)]\n  1325\t                                      [node (into events more)]))\n  1326\t                                  [(assoc node :client state) []]\n  1327\t                                  loading)]\n  1328\t        ;; every load waiting on an address has read its miss cause: keep\n   200\t   materialization record at any id the writer's answer carries. A\n   201\t   writer refusal completes at once -- the record routes that loss at\n   202\t   the next drain.\"\n   203\t  [state request materialize?]\n   204\t  (cond\n   205\t    (:terminal state)\n   206\t    {:outcome :terminal, :state state}\n   207\t\n   208\t    (:unsent state)\n   209\t    {:outcome :busy, :state state}\n   210\t\n   211\t    :else\n   212\t    (let [id (mint-id state)\n   213\t          value (assoc request :jing/request id)\n   214\t          result (stream/append! (:requests state) value)\n   215\t          outcome (:dao.stream/outcome result)\n   216\t          address (get request put-op)]\n   217\t      (cond\n   218\t        (= :dao.stream/ok outcome)\n   219\t        {:outcome :requested\n   220\t         :state (-> (assoc-in state [:outstanding id] request)\n   221\t                    (cond-> materialize? (register id address)))\n   222\t         :id id}\n   223\t\n   224\t        (= :dao.stream/full outcome)\n   225\t        {:outcome :pending-request\n   226\t         :state (-> (assoc state :unsent {:id id, :value value})\n   227\t                    (cond-> materialize? (register id address)))\n   228\t         :id id}\n   229\t\n   230\t        :else\n   231\t        ;; closed, invalid-value, transport-error: the append never\n   232\t        ;; happened; the loss completes on the ordinary path\n   161\t(defn make-acceptor\n   162\t  \"Compose the accepting end of the spec's section-5 toy.\n   163\t   `:endpoint` is a dao.stream.ws/make-endpoint value whose handoff\n   164\t   `:slots` are given here, in endpoint order, as {:offer-reader r\n   165\t   :offer-cursor c :ack-writer target} -- readers, cursors and writers\n   166\t   the composition minted before the listener started. `:table` is the\n   167\t   mirror's table (dao.stream.remote.md 2.2). `:make-media` receives\n   168\t   one accepted offer and returns the attachment's composition:\n   169\t   :traffic (the deposit target the acknowledgement carries),\n   170\t   :admission (its declaration), :reader (the traffic reader the\n   171\t   projection reads), :cursor (its minted reading cursor) and :ring\n   172\t   (the fresh channel ring buffer). The listener is the host's: it\n   173\t   calls ws/accept-connection! on this endpoint, per dao.stream.ws.md\n   174\t   Serving.\"\n   175\t  [{:keys [endpoint slots table make-media] :as config}]\n   176\t  (when-not (and (map? config)\n   177\t                 (some? endpoint)\n   178\t                 (fn? make-media)\n   179\t                 (map? table)\n   180\t                 (seq slots)\n   181\t                 (every? valid-slot? slots))\n   182\t    (throw (ex-info \"invalid DaoStream ws acceptor composition\"\n   183\t                    {:config config})))\n   184\t  (atom {:endpoint endpoint\n   185\t         :slots (vec slots)\n   186\t         :table table\n   187\t         :make-media make-media\n   188\t         :offer-cursors (mapv :offer-cursor slots)\n   189\t         :sessions {}}))\n   190\t\n   191\t\n   192\t(defn- adopt!\n   193\t  \"Adopt one accepted offer as a session: create the attachment's\n   194\t   media through :make-media, acknowledge the offer per\n   195\t   dao.stream.ws.md Serving (:ws/command :ws/accept, the deposit\n   248\t(defn accept-step!\n   249\t  \"Advance the accepting composition one tick at `now`, in the order\n   250\t   serving compositions use: a transport step first (releasing dead\n   251\t   pendings, consuming standing acknowledgements), then one offer per\n   252\t   slot adopted with its fresh media and acknowledgement, then a\n   253\t   second transport step, so the fresh acknowledgement is consumed and\n   254\t   the accept frame is on the wire before this end answers anything,\n   255\t   then per session the projection and, over the projected reader and\n   256\t   the socket handle, the mirror step. A session whose projection has\n   257\t   closed is then removed: the mirror pass just run was its last, and\n   258\t   repeated connections must not accumulate. Returns the acceptor.\"\n   259\t  [acceptor now]\n   260\t  (let [{:keys [endpoint slots] :as s} @acceptor]\n   261\t    (ws/endpoint-step endpoint now)\n   262\t    (doseq [[index slot] (map-indexed vector slots)]\n   263\t      (let [r (stream/next (:offer-reader slot)\n   264\t                           (nth (:offer-cursors s) index))]\n   265\t        (when (= :dao.stream/ok (:dao.stream/outcome r))\n   266\t          (swap! acceptor assoc-in [:offer-cursors index]\n   267\t                 (:dao.stream/cursor r))\n   268\t          (adopt! acceptor slot (:dao.stream/value r)))))\n   269\t    (ws/endpoint-step endpoint now)\n   270\t    (doseq [[attachment session] (:sessions @acceptor)]\n   271\t      (step! (:project session))\n   272\t      (swap! acceptor assoc-in [:sessions attachment :cursor]\n   273\t             (remote/mirror-step (:table @acceptor)\n   274\t                                 (:ring session)\n   275\t                                 (:cursor session)\n   276\t                                 (:handle session))))\n   277\t    (swap! acceptor update :sessions reaped)\n   278\t    acceptor))\n   279\t\n   280\t\n    64\t(def service-identity\n    65\t  \"The logical identity of the WebSocket channel a REPL endpoint serves.  A\n    66\t   descriptor names a served stream, so a client that only typed a URL still\n    67\t   needs one; a stable service name keeps `attach!` honest across endpoint\n    68\t   restarts.\"\n    69\t  \"yin.repl/repl\")\n    70\t\n    71\t\n    72\t(def requests-identity\n    73\t  \"The mirror table identity the server enters with surface #{:writer}: a\n    74\t   client's reflection of it writes eval requests.\"\n    75\t  \"yin.repl/requests\")\n    76\t\n    77\t\n    78\t(def answers-identity\n    79\t  \"The mirror table identity the server enters with surface #{:reader}: a\n    80\t   client's reflection of it reads answers.\"\n    81\t  \"yin.repl/answers\")\n    82\t\n597:                        db (when-not (or (refused? split) (refused? view))\n599:                        sources (when-not (or (refused? split) (refused? view)\n600:                                              (refused? db))\n604:                      (refused? split) split\n605:                      (refused? view) view\n606:                      (refused? db) db\n607:                      (refused? sources) sources\n610:     (if (refused? answer)\n630:       (catch #?(:cljd Object :clj Exception :cljs :default) e\n631:         (if-let [code (:dao.space.dht/refused (ex-data e))]\n639:   names, and the node after it: `load-index` starts a load and answers\n641:   status map; `q` answers `dao.space.dht/q` under `limits`, refused\n643:   and `:cancelled`, or the plain function's refusal; `load-module`\n665:            ::dht-load-index\n666:            (let [node (dht/load-index node manifest)]\n672:            ::dht-load-module\n673:            (let [node (linker.dht/load-module node manifest)]\n693:                                    \"); (dao.space.dht/load-index \" manifest\n696:    [node (if (refused? answer)\n759:              (refused? db) [indexer db]\n775:                  (= :refused (:status re