rts are references re-sealed under the\n   881\t                  receiver's secret\"\n   882\t          (is (engine/authentic-ref? done :stream-ref s))\n   883\t          (is (engine/authentic-ref? done :cursor-ref c))\n   884\t          (is (= (:id s) (get-in done [:resources (:id c) :stream-id]))\n   885\t              \"the lowered cell names the lowered attachment\")\n   886\t          (is (every? symbol? (keys (vm/store done)))\n   887\t              \"no store key is created\"))))))\n   888\t\n   889\t\n   890\t(deftest a-reference-lowers-only-where-it-can-attach-test\n   891\t  (doseq [backend (keys backends)]\n   892\t    (testing (name backend)\n   893\t      (let [run-with (fn [opts]\n   894\t                       (let [pair (link-pair)\n   895\t                             root ((:vm (get backends backend))\n   896\t                                   use-chan\n   897\t                                   (merge (composition pair) opts))]\n   898\t                         (refusal-of\n   899\t                           #(drive root\n   900\t                                   (responder\n   901\t                                     pair\n   902\t                                     {'chan (module-response\n   903\t                                              backend 'chan chan-module\n   904\t                                              ['s 'c])})))))]\n   905\t        (testing \"a receiver with no attacher refuses the install\"\n   906\t          (is (= :yin.k/unsatisfied\n   907\t                 (:yin.k/status (run-with {:attach-stream nil})))))\n   908\t        (testing \"a child minted no secret can issue no reference\"\n   909\t          (is (= :no-capability-secret\n   910\t                 (:reason (run-with {:secret-source nil})))))))))\n   911\t\n   912\t\n   913\t(deftest input-after-a-tail-applied-module-closure-is-the-tasks-own-test\n   914\t  (doseq [backend (keys backends)]\n   915\t    (testing (name backend)\n   916\t      (let [{:keys [continue]} (get backends backend)\n   917\t            done (run-program backend\n   918\t                              (then (req 'ctr)\n   919\t                                    (app (lam [] (app (v 'ctr/setn)))))\n   920\t                              {'ctr [ctr-module ctr-exports]})\n   921\t            next-input (vm/run (continue done (def! 'z (lit 3))))]\n   922\t        (is (= 5 (vm/value done)))\n   923\t        (testing \"the halt left no module store context\"\n   924\t          (is (nil? (engine/store-context done))))\n   925\t        (testing \"the next input defines into the task's own store\"\n  1230\t  \"A module whose body makes a stream, writes 7 through it, and reads it\n  1231\t   back through a cursor: the child must issue two references.\"\n  1232\t  (def! 'n (app (lam '[s]\n  1233\t                     (then {:type :stream/put, :target (v 's), :val (lit 7)}\n  1234\t                           {:type :stream/next,\n  1235\t                            :source {:type :stream/cursor,\n  1236\t                                     :source (v 's)}}))\n  1237\t                {:type :stream/make, :buffer 4})))\n  1238\t\n  1239\t\n  1240\t(def ^:private use-n\n  1241\t  (then (req 'sm) (v 'sm/n)))\n  1242\t\n  1243\t\n  1244\t(defn- sm-responder\n  1245\t  [pair]\n  1246\t  (responder pair {'sm (module-response :walker 'sm stream-using-module\n  1247\t                                        ['n])}))\n  1248\t\n  1249\t\n  1250\t(deftest a-stream-using-module-installs-through-the-repl-composition-test\n  1251\t  (let [pair (link-pair)\n  1252\t        ;; the link pair is the composition's (M5 wires it into the shell);\n  1253\t        ;; everything else is the REPL's own constructor\n  1254\t        task (-> (repl/make-vm :ast-walker (tu/new-stream 64))\n  1255\t                 (update :resources assoc\n  1256\t                         :yin.link/request (:request pair)\n  1257\t                         :yin.link/response (:response pair))\n  1258\t                 (walker/vm-load-rows (vm/ast->semantic-bytecode use-n)\n  1259\t                                      vm/ast-contract))\n  1260\t        [done _] (drive task (sm-responder pair))]\n  1261\t    (testing \"the REPL supplies a secret source for its install children\"\n  1262\t      (is (fn? (:secret-source task))))\n  1263\t    (testing \"the child issued its references and the module linked\"\n  1264\t      (is (not (vm/blocked? done)))\n  1265\t      (is (= 7 (vm/value done))))))\n  1266\t\n  1267\t\n  1268\t(defn- drive-await\n  1269\t  \"Resume a dao.await result and run the responder alternately until it\n  1270\t   stops blocking, at most 40 rounds.\"\n  1271\t  [result r]\n  1272\t  (loop [result result\n  1273\t         r r\n  1274\t         i 0]\n  1275\t    (if (and (:blocked? result) (< i 40))\n  1276\t      (let [r (respond! r)]\n  1277\t        (recur (await/resume result) r (inc i)))\n  1278\t      result)))\n  1279\t\n  1280\t\n  1281\t(deftest a-stream-using-module-installs-through-dao-await-test\n  1282\t  (let [pair (link-pair)\n  1283\t        opts {:make-stream tu/make-stream,\n  1284\t              :primitives vm/primitives,\n  1285\t              :link-request (:request pair),\n  1286\t              :link-response (:response pair)}\n  1287\t        done (drive-await (await/run {:ast use-n, :env {}} opts)\n  1288\t                          (sm-responder pair))]\n  1289\t    (testing \"dao.await supplies a secret source for its install children\"\n  1290\t      (is (fn? (:secret-source (:vm done)))))\n  1291\t    (testing \"the child issued its references and the module linked\"\n  1292\t      (is (not (:blocked? done)))\n  1293\t      (is (= 7 (:value done)))))\n  1294\t  (testing \"a caller's own source is the one used\"\n  1295\t    (let [minted (atom [])\n  1296\t          pair (link-pair)\n  1297\t          source (fn [origin]\n  1298\t                   (swap! minted conj origin)\n  1299\t                   (str tu/secret \"/\" (name origin)))\n  1300\t          done (drive-await (await/run {:ast use-n, :env {}}\n  1301\t                                       {:make-stream tu/make-stream,\n  1302\t                                        :primitives vm/primitives,\n  1303\t                                        :secret-source source,\n  1304\t                                        :link-request (:request pair),\n  1305\t                                        :link-response (:response pair)})\n  1306\t                            (sm-responder pair))]\n  1307\t      (is (= 7 (:value done)))\n  1308\t      (is (= [:t0.0] @minted)))))\n","exit_code":0,"status":"completed"}}
