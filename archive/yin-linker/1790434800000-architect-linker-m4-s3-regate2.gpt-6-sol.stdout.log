rage|zero-length|missing-row|reorder' test/yin/vm/linker_require_test.cljc test/yin/vm/attach_image_test.cljc | tail -90\\\"\",\"aggregated_output\":\"\\n\\n;; =============================================================================\\n;; Private engine resources and sealed references (yin.vm.linker.md section\\n;; 7.3, r8 to r11)\\n;; =============================================================================\\n;;\\n;; Stream handles, cursor cells, the FFI pair, and the link pair live in the\\n;; private `:resources` table of VM state. The engine's own machinery reads\\n;; and writes only that table; no store instruction and no `resolve-var`\\n;; step consults it. A program holds only references, and every reference\\n;; the engine issues carries a seal over its kind and id under the task's\\n;; capability secret, which the composition minted and which lives in VM\\n;; state alone. Every effect that resolves a program-supplied reference\\n;; verifies the seal first: a literal with a wrong or missing seal fails\\n;; closed with `:forged-resource-reference`.\\n\\n(defn- seal-of\\n  \\\"The seal of a `kind` reference to resource `id` under `secret`.\\\"\\n  [secret kind id]\\n  (jing/content-hash [:yin.k/seal secret kind id] {:algorithm :sha256}))\\n\\n\\n(defn- cursor-cell?\\n  \\\"True when a resource is a cursor cell, `{:stream-id id :cursor c}`.\\\"\\n  [resource]\\n  (and (map? resource) (contains? resource :stream-id)))\\n\\n\\n(defn issue-ref\\n  \\\"A reference of `kind` (`:stream-ref` or `:cursor-ref`) to resource\\ntest/yin/vm/linker_require_test.cljc:212:     :capability-secret tu/secret,\\ntest/yin/vm/linker_require_test.cljc:213:     :secret-source (fn [origin] (str tu/secret \\\"/\\\" (name origin))),\\ntest/yin/vm/linker_require_test.cljc:792:                                           :capability-secret\\ntest/yin/vm/linker_require_test.cljc:907:          (is (= :no-capability-secret\\ntest/yin/vm/linker_require_test.cljc:908:                 (:reason (run-with {:secret-source nil})))))))))\\nsrc/clj/yin/demo.clj:193:                                        :capability-secret\\nsrc/clj/yin/demo.clj:194:                                        (str (random-uuid))})\\nsrc/clj/yin/demo.clj:198:                                        :capability-secret\\nsrc/clj/yin/demo.clj:199:                                        (str (random-uuid))})\\nsrc/cljd/yin/register_bench_cljd.cljd:116:              :capability-secret (str (random-uuid))}]\\nsrc/cljs/datomworld/demo/continuation_stream.cljs:85:     :capability-secret (str (random-uuid))}))\\nsrc/cljs/datomworld/demo/equation_plotter.cljs:308:                                     :capability-secret (str (random-uuid)),\\nsrc/cljs/datomworld/demo/compilation_pipeline.cljs:89:     :capability-secret (str (random-uuid))}))\\nsrc/cljs/datomworld/demo/yin_repl.cljs:92:  {:id (str (random-uuid))\\nsrc/cljc/yin/vm/engine.cljc:260:  (let [secret (:capability-secret state)]\\nsrc/cljc/yin/vm/engine.cljc:264:            {:reason :no-capability-secret, :kind kind, :id id}))\\nsrc/cljc/yin/vm/engine.cljc:273:  (let [secret (:capability-secret state)\\nsrc/cljc/yin/vm/engine.cljc:917:   `:secret-source`, a function of the child's origin tag; a composition\\nsrc/cljc/yin/vm/engine.cljc:927:        source (:secret-source state)\\nsrc/cljc/yin/vm/engine.cljc:937:                                    :capability-secret\\nsrc/cljc/yin/vm/ast_walker.cljc:76:   capability-secret ; this task's secret; every reference is sealed by it\\nsrc/cljc/yin/vm/ast_walker.cljc:77:   secret-source  ; the composition's minting of child task secrets\\nsrc/cljc/yin/vm/ast_walker.cljc:128:                   (:capability-secret vm)\\nsrc/cljc/yin/vm/ast_walker.cljc:129:                   (:secret-source vm)\\nsrc/cljc/yin/vm/ast_walker.cljc:1051:                                     :capability-secret :secret-source\\nsrc/cljc/yin/vm/ast_walker.cljc:1090:    [vm image {:keys [modules origin ancestry capabilit