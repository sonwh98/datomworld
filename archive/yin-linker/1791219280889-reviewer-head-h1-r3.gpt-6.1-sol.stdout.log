rsisted record of `principal`, verified again, against the\n   309\t   followed set, and walked in the local store; throws naming it.\"\n   310\t  [node followed principal trace]\n   311\t  (let [fail (fn [why reason]\n   312\t               (throw (startup-refused (str \"the head of \" principal \" \" why)\n   313\t                                       reason {:principal principal})))]\n   314\t    (when-not (contains? followed principal)\n   315\t      (fail \"is recorded but not followed\" :yin.head/unfollowed))\n   316\t    (when-not (verify trace)\n   317\t      (fail \"does not verify\" :yin.head/bad-record))\n   318\t    (when-not (= principal (get-in trace [:yin.head/envelope\n   319\t                                          :yin.head/principal]))\n   320\t      (fail \"is another principal's trace\" :yin.head/wrong-principal))\n   321\t    (let [{:keys [datoms failure]} (local-datoms node (manifest-of trace))\n   322\t          {:keys [invalid] n :seq} (when-not failure (index-seq datoms))]\n   323\t      (when failure\n   324\t        (fail \"is not in the local store\" :yin.head/unloadable))\n   325\t      (when invalid\n   326\t        (fail \"names a malformed index\" :yin.head/index-invalid))\n   327\t      (when-not (= (seq-of-trace trace) n)\n   328\t        (fail \"does not match its index's sequence\" :yin.head/seq-mismatch)))\n   329\t    trace))\n   330\t\n   590\t\n   591\t\n   592\t;; -----------------------------------------------------------------------------\n   593\t;; The candidate's load: confirmed, rejected or unloadable (5.5)\n   594\t;; -----------------------------------------------------------------------------\n   595\t\n   596\t(defn- foreign?\n   597\t  \"Whether a record of `kind` is neither a candidate nor an index load:\n   598\t   the follower never reads, forgets or restarts it.\"\n   599\t  [kind]\n   600\t  (not (contains? #{candidate-kind dht/index-kind} kind)))\n   601\t\n   602\t\n   603\t(defn- walk-of\n   604\t  \"The walk a failed record of `kind` at `m` is started again with: only\n   605\t   a candidate or an index load is.  nil for any other kind, whose failed\n   606\t   record stays its owner's until it is forgotten.\"\n   607\t  [kind m]\n   608\t  (when (contains? #{candidate-kind dht/index-kind} kind)\n   609\t    (dht/index-walk m)))\n   610\t\n   611\t\n   612\t(defn- reject\n   613\t  \"Drop `principal`'s candidate as `reason`, releasing its record and\n   614\t   remembering its envelope as the last rejected: `[follower node\n   615\t   events]`.\"\n   616\t  [follower node principal reason data]\n   617\t  (let [{:keys [trace manifest]} (get-in follower [:principals principal\n   618\t                                                   :candidate])\n   619\t        [follower node] (release follower node principal manifest)]\n   620\t    [(update-in follower [:principals principal] assoc\n   621\t                :candidate nil\n   622\t                :rejected (envelope-id trace)\n   623\t                :refusal (merge {:reason reason :trace trace} data))\n   624\t     node\n   625\t     [(merge (refused-event principal reason trace) data)]]))\n   626\t\n   627\t\n   628\t(defn- unloadable\n   629\t  [follower principal cand now failure]\n   630\t  [(assoc-in follower [:principals principal :candidate]\n   631\t             (assoc cand :state :failed :failure failure\n   632\t                    :due (+ now (:delay cand))))\n   633\t   [{:yin.head/event :unloadable :principal principal :trace (:trace cand)\n   634\t     :failure failure}]])\n   635\t\n   636\t\n   637\t(defn- settle\n   638\t  \"Advance `principal`'s candidate against its record: `[follower node\n   639\t   events]`.\"\n   640\t  [follower node principal now]\n   641\t  (let [{:keys [candidate]} (get-in follower [:principals principal])\n   642\t        m (:manifest candidate)\n   643\t        status (when candidate (dht/load-status node m))]\n   644\t    (cond\n   645\t      (or (nil? candidate) (= :confirmed (:state candidate)))\n   646\t      [follower node []]\n   647\t\n   648\t      ;; the record was removed under the follower: start it again\n   649\t      (nil? status)\n   650\t      (let [[follower node] (acquire follower node principal m)]\n   651\t        [(assoc-in follower [:principals principal :candidate :state] :loading)\n   652\t         node []])\n   653\t\n   654\t      ;; another kind's record, whatever its status: reported once, left\n   655\t      ;; untouched and unread; the address is acquired once it is removed\n   656\t      (foreign? (:kind status))\n   657\t      (if (= :failed (:state candidate))\n   658\t        [follower node []]\n   659\t        (let [[follower events]\n   660\t              (unloadable follower principal candidate now\n   661\t                          (if (= :failed (:status status))\n   662\t                            (:reason status)\n   663\t                            {:yin.head/foreign-kind (:kind status)\n   664\t                             :status (:status status)}))]\n   665\t          [follower node events]))\n   666\t\n   667\t      (= :loading (:status status))\n   668\t      [(assoc-in follower [:principals principal :candidate :state] :loading)\n   669\t       node []]\n   670\t\n   671\t      (= :loaded (:status status))\n   672\t      (let [{:keys [invalid] n :seq} (index-seq (:value status))]\n   673\t        (cond\n   674\t          invalid (reject follower node principal :yin.head/index-invalid {})\n   675\t\n   676\t          (= (:seq candidate) n)\n   677\t          [(assoc-in follower [:principals principal :candidate :state]\n   678\t                     :confirmed)\n   679\t           node\n   680\t           [{:yin.head/event :confirmed :principal principal\n   681\t             :trace (:trace candidate)}]]\n   682\t\n   683\t          :else\n   684\t          (reject follower node principal :yin.head/seq-mismatch\n   685\t                  {:index-seq n})))\n   686\t\n   687\t      ;; the load failed: report it once, then start it again after the\n   688\t      ;; delay, under the kind the record had\n   689\t      (not= :failed (:state candidate))\n   690\t      (let [[follower events] (unloadable follower principal candidate now\n   691\t                                          (:reason status))]\n   692\t        [follower node events])\n   693\t\n   694\t      (< now (:due candidate)) [follower node []]\n   695\t\n   696\t      :else\n   697\t      (if-some [walk (walk-of (:kind status) m)]\n   698\t        [(update-in follower [:principals principal :candidate] assoc\n   699\t                    :state :loading\n   700\t                    :due nil\n   701\t                    :delay (min (* 2 (:delay candidate))\n   702\t                                (:repair-max-ticks follower)))\n   703\t         (-> (dht/forget node m)\n   704\t             (dht/load m {:kind (:kind status) :walk walk}))\n   705\t         []]\n   706\t        [follower node []]))))\n   707\t\n   708\t\n   709\t(defn step\n   710\t  \"One pass after `dao.space.dht/step` at the owner's reading `now`: poll\n754:                                    ((:entries-fn (dht/local (:b w)))))})]\n790:  (let [node (dht/join {:local (mem/create-content-mem)})\n791:        m (index! (dht/local node) (alib-history p1 2))\n845:        bad (head/trace p1 (malformed-index! (dht/local (:a w))) 11)\n863:  (let [node (dht/join {:local (mem/create-content-mem)})\n864:        bad (head/trace p1 (malformed-index! (dht/local node)) 0)\n889:(def ^:private non-canonical-rows\n890:  \"Each case's one bad row, beside a good one: not a persisted local\n891:   datom (`dao.datom/local-datom?`).\"\n900:(deftest non-canonical-rows-are-refused-at-confirmation\n904:        a-store (dht/local (:a w))\n921:                  (map-indexed vector non-canonical-rows))]\n922:    (is (= (count non-canonical-rows) (count (events-of (:events w) :refused))))\n929:(deftest non-canonical-rows-refuse-follow-naming-the-principal\n930:  (doseq [[case-key row] non-canonical-rows]\n932:      (let [node (dht/join {:local (mem/create-content-mem)})\n933:            bad (head/trace p1 (rows-index! (dht/local node)\n993:(deftest a-loaded-record-of-another-kind-is-never-read\n997:        w (world {:local b-store})\n999:        ;; every blob of the index is already local to B, so a read of the\n1001:        _ (doseq [[address bs] ((:entries-fn (dht/local (:a w))))]\n1091:        ma (index! (dht/local a) (alib-history p1 3))\n1092:        mb (index! (dht/local b) (alib-history p2 2))\n1093:        _ (head/deposit! board-a p1 ma (index/read-datoms (dht/local a) ma))\n1094:        _ (head/deposit! board-b p2 mb (index/read-datoms (dht/local b) mb))\n;; =============================================================================\n;; A malformed index is refused as data (review finding P1)\n;; =============================================================================\n\n(defn- malformed-index!\n  \"A hash-valid covered index in `store` whose rows have a `t` that is not\n   an integer: the covered-index walk counts rows, so it completes.\"\n  [store]\n  (let [leaf (jing/materialize! store {:keys [[100 :x/y 1 0 0]\n                                              [101 :x/y 1 \"bad-t\" 0]]})]\n    (jing/materialize! store {:indexes {:eavt leaf :aevt leaf :avet leaf\n                                        :vaet leaf}\n                              :count 2\n                              :branching-factor 32})))\n\n\n(deftest a-malformed-index-is-refused-at-confirmation\n  (let [w (world)\n        h10 (head-of! w (alib-history p1 10))\n        w (run (show! w (:trace h10)) 300 (installed? (:manifest h10)))\n        bad (head/trace p1 (malformed-index! (dht/local (:a w))) 11)\n        w (run (show! w bad) 300 #(seq (events-of (:events %) :refused)))]\n    (is (= [{:yin.head/event :refused :principal (principal p1)\n             :reason :yin.head/index-invalid :trace bad}]\n           (events-of (:events w) :refused)))\n    (is (= 10 (:floor (status w))) \"the floor is unchanged\")\n    (is (= (:manifest h10) (installed-manifest w)) \"nothing installed\")\n    (is (= 1 (count (events-of (:events w) :installed))))\n    (is (nil? (get-in (status w) [:candidate])))\n    (is (= :yin.head/index-invalid (get-in (status w) [:refusal :reason])))\n    (testing \"shown again it is not loaded again\"\n      (let [w (run (show! w bad) 10 (fn [_] false))]\n        (is (= 1 (count (events-of (:events w) :refused))))\n        (is (= 10 (:floor (status w))))\n        (close! w)))))\n\n\n(deftest a-malformed-index-refuses-follow-naming-the-principal\n  (let [node (dht/join {:local (mem/create-content-mem)})\n        bad (head/trace p1 (malformed-index! (dht/local node)) 0)\n        data (try (head/follow node {:follow [(principal p1)]\n                                     :heads {:version 1\n                                             :heads {(principal p1) bad}}})\n                  nil\n                  (catch #?(:cljd Object :clj Exception :cljs :default) e\n                    (ex-data e)))]\n    (is (= {:yin.head/refused :yin.head/index-invalid\n            :principal (principal p1)}\n           data))\n    (is (= {} (ld/installed-heads node)) \"nothing installed\")\n    (dht/close! node)))\n\n\n(defn- rows-index!\n  \"A hash-valid covered index in `store` holding exactly `rows`: the\n   covered-index walk counts rows, so it completes whatever they are.\"\n  [store rows]\n  (let [leaf (jing/materialize! store {:keys rows})]\n    (jing/materialize! store {:indexes {:eavt leaf :aevt leaf :avet leaf\n                                        :vaet leaf}\n                              :count (count rows)\n                              :branching-factor 32})))\n\n\n(def ^:private non-canonical-rows\n  \"Each case's one bad row, beside a good one: not a persisted local\n   datom (`dao.datom/local-datom?`).\"\n  [[:four-slots [100 :x/y 1 0]]\n   [:six-slots [100 :x/y 1 0 0 :extra]]\n   [:negative-e [-1 :x/y 1 0 0]]\n   [:non-integer-e [\"e\" :x/y 1 0 0]]\n   [:unnamespaced-attribute [100 :y 1 0 0]]\n   [:non-integer-m [100 :x/y 1 0 \"m\"]]])\n\n\n(deftest non-canonical-rows-are-refused-at-confirmation\n  (let [w (world)\n        h10 (head-of! w (alib-history p1 10))\n        w (run (show! w (:trace h10)) 300 (installed? (:manifest h10)))\n        a-store (dht/local (:a w))\n        w (reduce (fn [w [i [case-key row]]]\n                    (let [bad (head/trace p1 (rows-index! a-store\n                                                          [[99 :x/y 1 0 0]\n                                                           row])\n                                          (+ 11 i))\n                          w (run (show! w bad) 300 (settled? bad))]\n                      (testing (str case-key)\n                        (is (= {:yin.head/event :refused\n                                :principal (principal p1)\n                                :reason :yin.head/index-invalid :trace bad}\n                               (peek (events-of (:events w) :refused))))\n                        (is (= 10 (:floor (status w))) \"the floor is unchanged\")\n                        (is (= (:manifest h10) (installed-manifest w))\n                            \"nothing installed\"))\n                      w))\n                  w\n                  (map-indexed vector non-canonical-rows))]\n    (is (= (count non-canonical-rows) (count (events-of (:events w) :refused))))\n    (is (= [(:trace h10)] (mapv :trace (events-of (:events w) :confirmed)))\n        \"only head 10 was ever confirmed\")\n    (is (= 1 (count (events-of (:events w) :installed))))\n    (close! w)))\n\n\n(deftest non-canonical-rows-refuse-follow-naming-the-principal\n  (doseq [[case-key row] non-canonical-rows]\n    (testing (str case-key)\n      (let [node (dht/join {:local (mem/create-content-mem)})\n            bad (head/trace p1 (rows-index! (dht/local node)\n                                            [[99 :x/y 1 0 0] row])\n                            0)\n            data (try (head/follow node {:follow [(principal p1)]\n                                         :heads {:version 1\n                                                 :heads {(principal p1) bad}}})\n                      nil\n                      (catch #?(:cljd Object :clj Exception :cljs :default) e\n                        (ex-data e)))]\n        (is (= {:yin.head/refused :yin.head/index-invalid\n                :principal (principal p1)}\n               data))\n        (is (= {} (ld/installed-heads node)) \"nothing installed\")\n        (dht/close! node)))))\n\n\n;; =============================================================================\n;; A failed record of another kind stays its owner's (Architect ruling 1)\n;; =============================================================================\n\n(deftest a-failed-module-record-is-left-until-its-owner-forgets-it\n  (let [w (world)\n        {:keys [manifest trace]} (head-of! w (alib-history p1 3))\n        ;; a module load of that address, made by someone else, fails\n        [b _] (dht/step (dht/load (:b w) manifest\n                                  {:kind ld/module-kind\n                                   :walk (fn [_]\n                                           {::dht/walk :invalid :address nil\n                                            :defect {:code :not-a-module}})})\n                        (:now w))\n        failure (:reason (dht/load-status b manifest))\n        w (assoc w :b b :now (+ 10 (:now w)))\n        _ (is (= :failed (:status (dht/load-status b manifest))))\n        ;; well past the retry delay (100)\n        w (run (show! w trace) 60 (fn [_] false))]\n    (testing \"the record is still there, of its kind, failed as it was\"\n      (is (= {:status :failed :kind ld/module-kind :fetched 0\n              :reason failure}\n             (dht/load-status (:b w) manifest))))\n    (testing \"the candidate was reported unloadable once, with its failure\"\n      (is (= [{:yin.head/event :unloadable :principal (principal p1)\n               :trace trace :failure failure}]\n             (events-of (:events w) :unloadable))))\n    (is (nil? (installed-manifest w)))\n    (testing \"once its owner forgets it, the candidate loads and installs\"\n      (let [w (run (update w :b dht/forget manifest) 300 (installed? manifest))]\n        (is (= manifest (installed-manifest w)))\n        (is (= 3 (:floor (status w))))\n        (close! w)))))\n\n\n(defn- counting-store\n  \"A memory store counting every read of an address `@watched?` holds.\"\n  [watched? reads]\n  (let [inner (mem/create-content-mem)]\n    (assoc inner :get-bytes-fn (fn [a not-found]\n                                 (when (@watched? a) (swap! reads inc))\n                                 ((:get-bytes-fn inner) a not-found)))))\n\n\n(deftest a-loaded-record-of-another-kind-is-never-read\n  (let [watched (atom #{})\n        reads (atom 0)\n        b-store (counting-store watched reads)\n        w (world {:local b-store})\n        {:keys [manifest trace]} (head-of! w (alib-history p1 3))\n        ;; every blob of the index is already local to B, so a read of the\n        ;; foreign record's address could confirm it\n        _ (doseq [[address bs] ((:entries-fn (dht/local (:a w))))]\n            ((:put-bytes-fn b-store) address bs))\n        _ (reset! watched #{manifest})\n        ;; someone else's module load at that address completes\n        [b _] (dht/step (dht/load (:b w) manifest\n                                  {:kind ld/module-kind\n                                   :walk (fn [_]\n                                           {::dht/walk :complete\n                                            :value ::someone-elses})})\n                        (:now w))\n        record (dht/load-status b manifest)\n        _ (is (= :loaded (:status record)))\n        w (run (show! (assoc w :b b :now (+ 10 (:now w))) trace)\n               60 (fn [_] false))]\n    (testing \"reported unloadable once, the record untouched and unread\"\n      (is (= [{:yin.head/event :unloadable :principal (principal p1)\n               :trace trace\n               :failure {:yin.head/foreign-kind ld/module-kind\n                         :status :loaded}}]\n             (events-of (:events w) :unloadable)))\n      (is (empty? (events-of (:events w) :confirmed)))\n      (is (= record (dht/load-status (:b w) manifest)))\n      (is (= 0 @reads) \"the follower never read the foreign record's datoms\")\n      (is (nil? (get-in w [:follower :owners manifest])) \"no owner entry\")\n      (is (nil? (installed-manifest w))))\n    (testing \"once its owner forgets it, the candidate loads and installs\"\n      (let [w (run (update w :b dht/forget manifest) 300 (installed? manifest))]\n        (is (= manifest (installed-manifest w)))\n        (is (pos? @reads) \"now walked, as a candidate\")\n        (close! w)))))\nCompleted-GMT: 2026-10-05 16:51:48 GMT\nCompleted-Local: 2026-10-05 23:51:48 +07\nCoding-Agent: claude\nSession-ID: 2e396723-5628-413b-b406-88d743d2aa93\n\n## Summary\n\nBoth P2 findings are fixed. The focused JVM run is green (139 tests, 38300 assertions, 0 failures) and lint is clean. The second fix leaves one design sentence that needs a small change. I ran no git, no formatter, and no Node or Dart.\n\n## 1. `index-seq` accepts non-canonical rows: fixed\n\n**Change** (`src/cljc/yin/vm/linker/head.cljc`): `index-seq` now accepts an index only if every row passes `dao.datom/local-datom?`. That means exactly `[e a v t m]`, with `e` and `t` nonnegative integers, `a` a namespaced keyword and `m` an integer. The check is still inside its `try`, so it stays total on every host. `head.cljc` now requires `dao.datom`. The existing malformed-`t` tests stay green.\n\n**Tests** (in `test/yin/vm/linker/head_follow_test.cljc`). Each covers six cases, one bad row beside a good one: 4 slots, 6 slots, negative `e`, a string `e`, an unnamespaced attribute, and a string `m`.\n- `non-canonical-rows-are-refused-at-confirmation`: with head 10 installed, each case's trace is refused as data with `:yin.head/index-invalid` and its trace. The floor stays at 10, nothing new is installed, and head 10 is the only head ever confirmed.\n- `non-canonical-rows-refuse-follow-naming-the-principal`: restoring each case through `follow` gives exactly `{:yin.head/refused :yin.head/index-invalid :principal p}`, and nothing is installed.\n\n## 2. A loaded foreign-kind record reached confirmation: fixed\n\n**Change** (`head.cljc`):\n- `settle` now checks the record's kind before looking at its status. A record that is neither candidate kind nor index kind, whether loading, loaded or failed, is reported `:unloadable` once and otherwise left alone: not read, not forgotten, not restarted, and with no owner-set entry.\n- Once the record's owner removes it, the existing branch for a missing record acquires the address as a candidate.\n- The `:failure` carried by that event is the record's own reason when it has failed. When it is loading or loaded it has no failure, so the event carries `{:yin.head/foreign-kind k :status s}` instead.\n- `loaded-datoms-of`, the local walk the reviewer reached, is gone. The confirmation branch now only ever sees candidate or index records and reads their `:value`.\n- `walk-of`'s `nil` path can no longer be reached from `settle`. I left it in place.\n\n**Tests:**\n- `a-loaded-record-of-another-kind-is-never-read`: every blob of the index is copied into B's store, so a read of that address could confirm it. A module-kind load at the candidate's address completes. Over 60 ticks:\n  - exactly one `:unloadable` event, carrying the foreign-kind marker, and no `:confirmed`;\n  - the record is unchanged and has no owner entry;\n  - a counting store shows **zero reads** of the manifest address.\n  - After the owner calls `forget`, the candidate loads and installs, and only then is the address read.\n- The test needed a small hook: the `world` helper now passes an optional `:local` store to B. Existing callers are unaffected.\n- `a-failed-module-record-is-left-until-its-owner-forgets-it` from round 2 is still green.\n\n## Commands and outcomes\n\n- `clj -M:test -n dao.space.dht-test -n yin.repl.dht-test -n yin.vm.linker.head-test -n yin.vm.linker.head-follow-test -n yin.vm.linker.dht-test -n yin.vm.linker.sign-test`: **139 tests, 38300 assertions, 0 failures, 0 errors.**\n  - The first run had one failure, and it was in my new test, not the code. It asserted \"no `:confirmed` event at all\", but head 10's own confirmation is expected. I corrected it to \"only head 10 was ever confirmed\".\n- `clj -M:kondo --lint src/cljc/yin/vm/linker/head.cljc test/yin/vm/linker/head_follow_test.cljc`: **0 errors, 0 warnings.** No touched line is over 80 columns.\n\n## Design sentence that needs to change\n\nSection 5.5 (amended) says a foreign record's candidate is reported unloadable \"with that record's failure\". A loading or loaded foreign record has no failure. I suggest: \"with that record's failure, or, for a record that has not failed, its kind and status\".\n\n## Unresolved\n\nNode and Dart are still unverified. `local-datom?` is the existing portable predicate, so I expect no host difference, but that is untested.\n","exit_code":0,"status":"completed"}}
