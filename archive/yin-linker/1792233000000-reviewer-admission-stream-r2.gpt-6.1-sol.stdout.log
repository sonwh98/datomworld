   167	   :content (cond
   168	              dht? {:kind :dht}
   169	
   170	              content-store
   171	              {:kind :local
   172	               :store content-store
   173	               :requests (medium content-capacity)
   174	               :responses (medium content-capacity)}
   175	
   176	              content-client
   177	              {:kind :remote, :client content-client}
   178	
   179	              :else nil)})
