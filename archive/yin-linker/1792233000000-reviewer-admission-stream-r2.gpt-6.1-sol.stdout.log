   182	(defn authority
   183	  "The reader's authority of a link source (yin.vm.linker.dht.md 7.1):
   184	   its declared principals and its direct name entries, as the plain
   185	   `yin.vm.linker.dht/authority` composes them."
   186	  [source]
   187	  (linker.dht/authority (select-keys source [:principals :name-env])))
   188	
   189	
   190	;; =============================================================================
   330	  [node authority request address]
   331	  (let [status (linker.dht/module-status node address)]
   332	    (cond
   333	      (nil? status) {:node (linker.dht/load-module node address)
   334	                     :body ::pending
   335	                     :waits address}
   336	
   337	      (not= linker.dht/module-kind (:kind status))
   338	      {:node node
   339	       :body {:status :refused
   340	              :reason :dao.space.dht/kind-conflict
   341	              :address address
   342	              :recorded (:kind status)}}
   343	
   344	      (= :loading (:status status)) {:node node, :body ::pending, :waits address}
   345	
   346	      (= :failed (:status status)) {:node (dht/forget node address)
   347	                                    :body (linker.dht/load-refusal status)}
   348	
   349	      :else
   350	      (let [bindings (linker.dht/dependency-bindings node authority address)
   351	            unbound (if (map? bindings)
   352	                      bindings
   353	                      (some (fn [b]
   354	                              (when-not (= :ok (:binding b))
   355	                                (merge {:status :refused
   356	                                        :reason :yin.link.dht/dependency-binding}
   357	                                       b)))
   358	                            bindings))]
   359	        {:node node
   360	         :body (or unbound (dht-link node request address))}))))
