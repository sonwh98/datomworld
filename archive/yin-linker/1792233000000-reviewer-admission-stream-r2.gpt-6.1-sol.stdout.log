  1206	(defn- link-waiting?
  1207	  "True while `vm` parks on a link wait: the two link states `require`
  1208	   parks in, or the install it waits on (yin.vm.linker.md section 7.2).
  1209	   These are the reasons the shell's interpreter can move, so they are
  1210	   the ones a round drives before reporting the VM wedged."
  1211	  [vm]
  1212	  (boolean (some #(contains? #{:link-request :link-response :install}
  1213	                             (:reason %))
  1214	                 (:wait-set vm))))
