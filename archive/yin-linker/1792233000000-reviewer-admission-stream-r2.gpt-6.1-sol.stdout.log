  1216	
  1217	(defn- carry-link-identity
  1218	  "The round's base VM with the link identity `used` has already minted
  1219	   carried forward: link ids `[origin counter]` and install-child origin
  1220	   tags are minted once and never reused on a pair (yin.vm.linker.md
  1221	   section 7.2), and the shell's rollback to the round's base -- whose
  1222	   counters never advanced -- must not let a later require or install
  1223	   mint an identity the pair has already answered."
  1224	  [base used]
  1225	  (let [n (max (or (:id-counter base) 0) (or (:id-counter used) 0))
  1226	        o (max (or (:origins base) 0) (or (:origins used) 0))]
  1227	    (cond-> base
  1228	      (pos? n) (assoc :id-counter n)
  1229	      (pos? o) (assoc :origins o))))
