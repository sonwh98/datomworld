  1391	(defn- abandon-pending
  1392	  "Give up the shell's `:pending-run` (section 7.2, step 7, the abandoned
  1393	   case): every install in flight is dropped through the engine's own
  1394	   `refused`, every link wait entry is retired with the reason raised as
  1395	   the require's error, and the shell returns to the round the require
  1396	   began in, whose store and value history the parked evaluation never
  1397	   wrote.  Lines typed while the require was pending are dropped with
  1398	   it, and said so.  The linker side learns nothing: no response was
  1399	   ever promised, and one that still arrives is skipped as late.  The
  1400	   identity the parked evaluation minted -- link ids and child origins
  1401	   -- is carried onto the base, so nothing is minted twice on the
  1402	   surviving pair.  The `(abandon)` command retires with
  1403	   `:yin.repl/abandoned` and no message of its own; the session link
  1404	   policy retires with the reason it answered and prints
  1405	   `policy-abandon-text`, so a policy abandon is never mistaken for a
  1406	   user's."
  1407	  ([state] (abandon-pending state :yin.repl/abandoned nil))
  1408	  ([state reason ended-text]
  1409	   (if-let [parked (:pending-run state)]
  1410	     (let [[state' text] (drain-output state)
  1411	           ;; installs first: their waiters leave the wait set with the
  1412	           ;; refusal queued, then every remaining link entry retires
  1413	           vm (engine/abandon-installs (:vm parked) reason)
  1414	           error (try
  1415	                   (vm/run (reduce (fn [vm e]
  1416	                                     (engine/abandon-link vm (:link-id e)
  1417	                                                          reason))
  1418	                                   vm
  1419	                                   (:wait-set vm)))
  1420	                   nil
  1421	                   (catch #?(:cljd Object :clj Exception :cljs js/Error) e
  1422	                     e))]
  1423	       [(assoc state'
  1424	               :vm (query/discard-answers
  1425	                     (carry-link-identity (:base parked) vm)
  1426	                     (:query-pair state'))
  1427	               :pending-run nil)
  1428	        (str text
  1429	             ended-text
  1430	             (if error (format-error error) "")
  1431	             (dropped-lines-text (count (:pending-lines parked))))])
  1432	     [state "Nothing is pending"])))
  1433	
  1434	
  1435	(defn- consult-link-policy
  1436	  "Consult the shell's `:link-policy` over a run that is still pending --
  1437	   when the require parks, and after each re-check that leaves it so;
  1438	   never on a re-check that completes it (yin.repl.link-policy.md
  1439	   section 3.2).  `text` is what the round printed so far and
  1440	   `kept-text` what a kept run reports.  `:manual` is never consulted
  1441	   and keeps the run; a function's `:keep` keeps it; `:abandon` or
  1442	   `{:abandon reason}` runs the same abandon path as `(abandon)`, the
  1443	   reason defaulting to `:yin.repl/link-policy`; a throw or a return
  1444	   outside the contract is a `:keep` for this consult plus one shell
  1445	   error line -- never a silent abandon, never session death (section
  1900	                                       :vm vm'
  1901	                                       :links pending
  1902	                                       :checks checks)
  1903	                          input (update :pending-lines
  1904	                                        (fnil conj []) input))
  1905	                [st text] (drain-output (assoc state'
  1906	                                               :vm vm'
  1907	                                               :pending-run parked'))]
  1908	            (consult-link-policy st text (pending-text pending)))))
  1909	      (catch #?(:cljd Object :clj Exception :cljs js/Error) error
  1910	        (let [[st text] (drain-output state)
  1911	              d (ex-data error)]
  1912	          (fold-queued
  1913	            [(carry-served (assoc st
  1914	                                  :vm (query/discard-answers
  1915	                                        (carry-link-identity
  1916	                                          (:base parked)
  1917	                                          {:id-counter (::link-counter d)
  1918	                                           :origins (::link-origins d)})
  1919	                                        (:query-pair st))
  1920	                                  :pending-run nil)
  1921	                           d)
  1922	             (str text
  1923	                  (format-error error)
  1924	                  (dropped-lines-text (count (:pending-lines parked))))]
  1925	            (cond-> [] input (conj input))))))))
