   370	
   371	(defn- answer
   372	  "The response body for one link request under `:body`, or `::pending`
   373	   when nothing this round can answer it: no content source, an attempt
   374	   that spent its budget, a DHT closure load not yet ended (its
   375	   manifest under `:waits`), or a name `:absent` while a followed
   376	   principal has no installed head (those principals under `:heads`,
   377	   yin.vm.linker.dht.head.md 5.6).  `:node` is the shell's DHT node after the
   378	   answer.  A request that is not by name is refused: the interpreter
   379	   serves what the shell's own VMs send, the by-name manifest requests
   380	   of section 7.2, and nothing else."
   381	  [source node request]
   382	  (let [name (:yin.link/name request)
   383	        dht? (= :dht (get-in source [:content :kind]))]
   384	    (cond
   385	      (nil? (:content source)) {:node node, :body ::pending}
   386	
   387	      (nil? name)
   388	      {:node node
   389	       :body {:status :refused, :reason :invalid-request,
   390	              :defect :yin.repl/name-required}}
   391	
   392	      dht?
   393	      (let [declared (authority source)
   394	            entry (linker.dht/resolve-name node declared name)]
   395	        (cond
   396	          (= :ok (:status entry))
   397	          (if-some [refusal (when-some [admit (:admit source)]
   398	                              (admit name entry))]
   399	            {:node node, :body refusal}
   400	            (dht-attempt node declared request (:address entry)))
   401	
   402	          (and (= :absent (:reason entry)) (seq (awaited-heads source node)))
   403	          {:node node, :body ::pending, :heads (awaited-heads source node)}
   404	
   405	          :else {:node node, :body entry}))
   406	
   407	      :else
   408	      {:node node
   409	       :body (if-let [address (get (:name-env source) name)]
   410	               (attempt source request address)
   411	               {:status :refused, :reason :absent, :name name})})))
   412	
   413	
   414	(defn- respond!
   415	  "Append `body` under the request's id on the response stream.  Returns
   416	   true when it landed, so the interpreter's cursor advances past the
   417	   request only then; a refused append leaves it to be re-read."
   418	  [pair request body]
   419	  (let [o (stream/append! (:responses pair)
   420	                          (assoc body :yin.link/id (:yin.link/id request)))]
   421	    (= :dao.stream/ok (:dao.stream/outcome o))))
   422	
   423	
   424	(defn serve
   425	  "One serve round of the interpreter over the link pair: read every
   426	   request `pair`'s cursor has not yet consumed and answer each in
   427	   request order, at most `budget` of them.  The first request nothing
   428	   can answer yet stops the round -- the requests behind it keep their
   429	   order -- and is reported under `:pending`; its cursor stays, so a
   430	   later round re-reads and re-attempts it.  A response the response
   431	   medium refuses reports its request pending the same way, and the
   432	   round reports no progress.  A content source links each manifest under
   433	   the composition's `:derivation` policy (`composition`'s option,
   434	   `:verifying` unless the composition asked for `:trusted`), and an
   435	   `:ok` response of a lowered format names its `:trust`.  `dht` is the
   436	   shell's DHT node, which a DHT source reads and advances.  Returns
   437	   `{:pair pair :pending pending :progress? bool :dht node}`,
   438	   `:progress?` true when at least one response was appended, so the
   439	   shell knows the round moved something; a pending entry a DHT load
   440	   holds names that load's manifest under `:manifest`, and one awaiting
   441	   a first head names those principals under `:principals`."
   442	  ([comp] (serve comp serve-budget))
   443	  ([{:keys [pair source dht]} budget]
   444	   (loop [pair pair
   445	          node dht
   446	          remaining budget
   447	          pending []
   448	          progress? false]
   449	     (if (zero? remaining)
   450	       {:pair pair, :pending pending, :progress? progress?, :dht node}
   451	       (let [r (stream/next (:requests pair) (:cursor pair))]
   452	         (if-not (= :dao.stream/ok (:dao.stream/outcome r))
   453	           ;; blocked, or a gap: nothing more is answerable this round
   454	           {:pair pair, :pending pending, :progress? progress?, :dht node}
   455	           (let [request (:dao.stream/value r)
   456	                 {:keys [node body waits heads]} (answer source node request)
   457	                 answered? (and (not= ::pending body)
   458	                                (respond! pair request body))]
   459	             (if answered?
   460	               (recur (assoc pair :cursor (:dao.stream/cursor r))
   461	                      node
   462	                      (dec remaining)
   463	                      pending
   464	                      true)
   465	               {:pair pair
   466	                :pending (conj pending
   467	                               (cond-> {:name (:yin.link/name request)
   468	                                        :yin.link/id (:yin.link/id request)}
   469	                                 waits (assoc :manifest waits)
   470	                                 heads (assoc :principals heads)))
   471	                :progress? progress?
   472	                :dht node}))))))))
  1190	  [{:keys [load-program output-stream] :as state}]
  1191	  (let [{:keys [observer] vm :consumer}
  1192	        (observer/run-on-stream {:observer (:row-observer state),
  1193	                                 :consumer (:vm state)}
  1194	                                engine/ready-for-ingress?
  1195	                                load-program
  1196	                                (make-runner output-stream (round-id state)))]
  1197	    (assoc state :row-observer observer :vm vm)))
