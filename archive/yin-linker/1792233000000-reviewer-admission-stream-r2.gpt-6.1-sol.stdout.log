  1928	(defn recheck-pending
  1929	  "One re-check of the shell's `:pending-run` without an input line --
  1930	   the step an unattended host drives at its own cadence
  1931	   (yin.repl.link-policy.md section 4): serve the interpreter, run the
  1932	   parked VM, and consult the link policy when the run is still
  1933	   pending.  A re-check that completes the run folds the retained lines
  1934	   exactly as a typed line's completion does.  Returns `[state text]`,
  1935	   `text` nil when nothing is pending.  It reads no clock and takes no
  1936	   callback; the host decides when to call it."
  1937	  [state]
  1938	  (if (:pending-run state)
  1939	    (recheck-pending* state nil)
  1940	    [state nil]))
  1941	
  1942	
  1943	(defn recheck-on-load-events
  1944	  "The host ticker's re-check of a pending run over a DHT link source
  1945	   (yin.vm.linker.dht.md 8.2): `recheck-pending`, once, if and only if
  1946	   `events` -- one tick's `dao.space.dht/step` events and head follower
  1947	   events -- hold a `:loaded` or `:load-failed` event for a manifest a
  1948	   pending link waits on, or an `:installed` head of a principal a
  1949	   pending link awaits (yin.vm.linker.dht.head.md 5.6, first contact).
  1950	   Any other event, and any event while nothing waits on it, answers
  1951	   `[state nil]` with `state` itself: no re-check, no `:checks`."
  1952	  [state events]
  1953	  (let [links (get-in state [:pending-run :links])
  1954	        waits (set (keep :manifest links))
  1955	        heads (set (mapcat :principals links))]
  1956	    (if (some (fn [e]
  1957	                (or (and (contains? #{:loaded :load-failed}
  1958	                                    (:dao.space.dht/event e))
  1959	                         (contains? waits (:manifest e)))
  1960	                    (and (= :installed (:yin.head/event e))
  1961	                         (contains? heads (:principal e)))))
  1962	              events)
  1963	      (recheck-pending state)
  1964	      [state nil])))
  1965	
