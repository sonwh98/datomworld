  1384	(def ^:private policy-abandon-text
  1385	  "The message a policy-driven abandon prints, in the shape of the
  1386	   `(abandon)` notice, so a policy abandon is never mistaken for a
  1387	   user's (yin.repl.link-policy.md section 3.3)."
  1388	  ";; the session link policy ended the require\n")
