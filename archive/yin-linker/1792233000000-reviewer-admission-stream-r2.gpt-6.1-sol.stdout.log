   363	(defn- awaited-heads
   364	  "The followed principals of `source` with no installed head on `node`:
   365	   a name absent now may be asserted by the first head of one of them."
   366	  [source node]
   367	  (let [installed (linker.dht/installed-heads node)]
   368	    (vec (remove #(contains? installed %) (:follow source)))))
