  1231	
  1232	(defn- link-raise
  1233	  "The raise of a resumed link wait, carrying the identity the parked
  1234	   evaluation has minted so far -- the counters of the VM the raise
  1235	   interrupted, whose every earlier run is in them -- so a rollback
  1236	   cannot reuse it.  It carries the query interpreter's pair too: the
  1237	   requests it has answered stay answered when the shell rolls back."
  1238	  [error vm state]
  1239	  (ex-info (or (ex-message error) "Link failed")
  1240	           (assoc (or (ex-data error) {})
  1241	                  ::link-counter (:id-counter vm)
  1242	                  ::link-origins (:origins vm)
  1243	                  ::query-pair (:query-pair state)
  1244	                  ::link-pair (:link-pair state)
  1245	                  ::dht (:dht state)
  1246	                  ::indexer (:indexer state))))
  1247	
  1248	
  1249	(defn- carry-served
  1250	  "`state` rolled back by a link raise, keeping what the interpreters
  1251	   already concluded: the query pair, the link pair past every request
  1252	   answered, the DHT node a load started or forgot on, and the indexer
  1253	   a `yin.link/publish` committed its name envelopes through."
  1254	  [state d]
  1255	  (cond-> state
  1256	    (::query-pair d) (assoc :query-pair (::query-pair d))
  1257	    (::link-pair d) (assoc :link-pair (::link-pair d))
  1258	    (contains? d ::dht) (assoc :dht (::dht d))
  1259	    (::indexer d) (assoc :indexer (::indexer d))))
  1260	
