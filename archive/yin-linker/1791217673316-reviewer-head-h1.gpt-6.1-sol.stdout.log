{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm/linker/head.cljc | sed -n '180,850p'\"","aggregated_output":"   180\t;; =============================================================================\n   181\t;; The board and the deposit (5.1, 5.2, 5.4)\n   182\t;; =============================================================================\n   183\t\n   184\t(defn board\n   185\t  \"A head board: a `dao.stream.ringbuffer` of capacity 1, the latest head\n   186\t   winning.  Answers the ring's handle, which a reader may be handed\n   187\t   directly.\"\n   188\t  []\n   189\t  (:dao.stream/handle\n   190\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n   191\t                         ringbuffer/capacity-key 1})))\n   192\t\n   193\t\n   194\t(defn- current\n   195\t  \"The trace on `board` now, or nil.\"\n   196\t  [board]\n   197\t  (let [c (stream/cursor board :dao.stream/oldest)]\n   198\t    (when (= :dao.stream/ok (:dao.stream/outcome c))\n   199\t      (let [r (stream/next board (:dao.stream/cursor c))]\n   200\t        (when (= :dao.stream/ok (:dao.stream/outcome r))\n   201\t          (:dao.stream/value r))))))\n   202\t\n   203\t\n   204\t(defn- refusal\n   205\t  [reason data]\n   206\t  (merge {:status :refused :reason reason} data))\n   207\t\n   208\t\n   209\t(defn deposit!\n   210\t  \"Sign the trace of `manifest` under `key` at the sequence `datoms`\n   211\t   derive (`seq-of`), and append it to `board`.  The board's current\n   212\t   trace is the last this process signed: a sequence equal to its with\n   213\t   another manifest is refused `:yin.head/seq-collision`, a lower one\n   214\t   `:yin.head/seq-regression`.  No datoms is `:yin.head/empty`, no key\n   215\t   `:yin.head/no-key`.  A refusal appends nothing.\"\n   216\t  [board key manifest datoms]\n   217\t  (let [n (seq-of datoms)\n   218\t        prior (current board)\n   219\t        {last-n :yin.head/seq last-m :yin.head/manifest}\n   220\t        (:yin.head/envelope prior)]\n   221\t    (cond\n   222\t      (not (and (map? key) (:seed key)))\n   223\t      (refusal :yin.head/no-key {:manifest manifest})\n   224\t\n   225\t      (nil? n) (refusal :yin.head/empty {:manifest manifest})\n   226\t\n   227\t      (and prior (= n last-n) (= manifest last-m)) {:status :ok :trace prior}\n   228\t\n   229\t      (and prior (= n last-n))\n   230\t      (refusal :yin.head/seq-collision {:manifest manifest :seq n\n   231\t                                        :signed last-m})\n   232\t\n   233\t      (and prior (< n last-n))\n   234\t      (refusal :yin.head/seq-regression {:manifest manifest :seq n\n   235\t                                         :signed-seq last-n})\n   236\t\n   237\t      :else\n   238\t      (let [t (trace key manifest n)\n   239\t            appended (stream/append! board t)]\n   240\t        (if (= :dao.stream/ok (:dao.stream/outcome appended))\n   241\t          {:status :ok :trace t}\n   242\t          (refusal :yin.head/unappended {:manifest manifest :seq n\n   243\t                                         :outcome (:dao.stream/outcome\n   244\t                                                    appended)}))))))\n   245\t\n   246\t\n   247\t;; =============================================================================\n   248\t;; The follower (5.3, 5.5, 5.7)\n   249\t;; =============================================================================\n   250\t\n   251\t(def candidate-kind\n   252\t  \"The `dao.space.dht` load kind of a candidate head: never an index\n   253\t   load, so `loaded-indexes` never lists it.\"\n   254\t  :yin.head/candidate)\n   255\t\n   256\t\n   257\t(def defaults\n   258\t  \"The follower's defaults (section 7).\"\n   259\t  {:poll-ticks 5000\n   260\t   :max-follow 64\n   261\t   :read-budget 64})\n   262\t\n   263\t\n   264\t(defn- startup-refused\n   265\t  [message reason data]\n   266\t  (ex-info (str \"yin.vm.linker.head/follow: \" message)\n   267\t           (assoc data :yin.head/refused reason)))\n   268\t\n   269\t\n   270\t(defn- manifest-of\n   271\t  [trace]\n   272\t  (get-in trace [:yin.head/envelope :yin.head/manifest]))\n   273\t\n   274\t\n   275\t(defn- seq-of-trace\n   276\t  [trace]\n   277\t  (get-in trace [:yin.head/envelope :yin.head/seq]))\n   278\t\n   279\t\n   280\t(defn- local-datoms\n   281\t  \"The datoms of the index `manifest` names, walked in the node's local\n   282\t   store: `{:datoms d}` or `{:failure f}`.\"\n   283\t  [node manifest]\n   284\t  (let [w ((dht/index-walk manifest) (dht/local node))]\n   285\t    (if (= :complete (::dht/walk w))\n   286\t      {:datoms (:value w)}\n   287\t      {:failure (dissoc w ::dht/walk)})))\n   288\t\n   289\t\n   290\t(defn- checked-record\n   291\t  \"The persisted record of `principal`, verified again, against the\n   292\t   followed set, and walked in the local store; throws naming it.\"\n   293\t  [node followed principal trace]\n   294\t  (let [fail (fn [why reason]\n   295\t               (throw (startup-refused (str \"the head of \" principal \" \" why)\n   296\t                                       reason {:principal principal})))]\n   297\t    (when-not (contains? followed principal)\n   298\t      (fail \"is recorded but not followed\" :yin.head/unfollowed))\n   299\t    (when-not (verify trace)\n   300\t      (fail \"does not verify\" :yin.head/bad-record))\n   301\t    (when-not (= principal (get-in trace [:yin.head/envelope\n   302\t                                          :yin.head/principal]))\n   303\t      (fail \"is another principal's trace\" :yin.head/wrong-principal))\n   304\t    (let [{:keys [datoms failure]} (local-datoms node (manifest-of trace))]\n   305\t      (when failure\n   306\t        (fail \"is not in the local store\" :yin.head/unloadable))\n   307\t      (when-not (= (seq-of-trace trace) (seq-of datoms))\n   308\t        (fail \"does not match its index's sequence\" :yin.head/seq-mismatch)))\n   309\t    trace))\n   310\t\n   311\t\n   312\t(defn- new-principal\n   313\t  [installed]\n   314\t  {:reader nil\n   315\t   :cursor nil\n   316\t   :due nil\n   317\t   :answered nil\n   318\t   :installed installed\n   319\t   :candidate nil\n   320\t   :rejected nil\n   321\t   :refusal nil\n   322\t   :observed nil})\n   323\t\n   324\t\n   325\t(defn follow\n   326\t  \"A follower on `node` from `opts`: `:follow` the followed principal ids\n   327\t   (`\\\"ed25519:\\\"` and 64 lowercase hex, at most 64), `:heads` the\n   328\t   persisted records (`records`' value, `{:version 1 :heads {principal\n   329\t   trace}}`) or `:volatile`.  Optional `:poll-ticks` (5000), and\n   330\t   `:repair-ticks` and `:repair-max-ticks` (the node's bounds by\n   331\t   default).  Each record is verified again, checked against the\n   332\t   followed set and its index walked in the local store; a record that\n   333\t   fails refuses startup naming it.  Answers `[follower node]`, the node\n   334\t   holding each record's head as installed.\"\n   335\t  [node {:keys [follow heads] :as opts}]\n   336\t  (let [followed (set follow)\n   337\t        limit #(or (get opts %) (get-in node [:limits %]) (get dht/defaults %))]\n   338\t    (when-not (and (coll? follow) (every? public-of-principal follow))\n   339\t      (throw (startup-refused \"followed principals must be ed25519 ids\"\n   340\t                              :yin.head/malformed {:follow follow})))\n   341\t    (when (> (count followed) (:max-follow defaults))\n   342\t      (throw (startup-refused (str \"at most \" (:max-follow defaults)\n   343\t                                   \" principals may be followed\")\n   344\t                              :yin.head/too-many {:count (count followed)})))\n   345\t    (when-not (or (= :volatile heads)\n   346\t                  (and (map? heads) (= 1 (:version heads))\n   347\t                       (map? (:heads heads))))\n   348\t      (throw (startup-refused \"heads must be :volatile or a version 1 record\"\n   349\t                              :yin.head/malformed {})))\n   350\t    (let [recorded (if (= :volatile heads) {} (:heads heads))\n   351\t          installed (into {}\n   352\t                          (map (fn [[p t]]\n   353\t                                 [p (checked-record node followed p t)]))\n   354\t                          recorded)]\n   355\t      [{:principals (into (sorted-map)\n   356\t                          (map (fn [p] [p (new-principal (get installed p))]))\n   357\t                          followed)\n   358\t        :owners {}\n   359\t        :volatile? (= :volatile heads)\n   360\t        :poll-ticks (or (:poll-ticks opts) (:poll-ticks defaults))\n   361\t        :repair-ticks (limit :repair-ticks)\n   362\t        :repair-max-ticks (limit :repair-max-ticks)}\n   363\t       (assoc node ld/installed-key\n   364\t              (into {} (map (fn [[p t]] [p (manifest-of t)])) installed))])))\n   365\t\n   366\t\n   367\t(defn- followed!\n   368\t  [follower principal]\n   369\t  (when-not (contains? (:principals follower) principal)\n   370\t    (throw (ex-info (str principal \" is not followed\")\n   371\t                    {:principal principal}))))\n   372\t\n   373\t\n   374\t(defn attach\n   375\t  \"Give the follower a `dao.stream` reader handle for `principal`'s board:\n   376\t   any handle.  Its next step mints `:dao.stream/oldest` on it.\"\n   377\t  [follower principal reader]\n   378\t  (followed! follower principal)\n   379\t  (update-in follower [:principals principal]\n   380\t             assoc :reader reader :cursor nil :due nil))\n   381\t\n   382\t\n   383\t;; -----------------------------------------------------------------------------\n   384\t;; Candidate records and their owners\n   385\t;; -----------------------------------------------------------------------------\n   386\t\n   387\t(defn- acquire\n   388\t  \"`principal` takes the candidate record at `m`: it joins the owners, and\n   389\t   the load starts when no record exists.  A record of another kind is\n   390\t   read, never owned.\"\n   391\t  [follower node principal m]\n   392\t  (let [status (dht/load-status node m)]\n   393\t    (cond\n   394\t      (nil? status)\n   395\t      [(update-in follower [:owners m] (fnil conj #{}) principal)\n   396\t       (dht/load node m {:kind candidate-kind :walk (dht/index-walk m)})]\n   397\t\n   398\t      (= candidate-kind (:kind status))\n   399\t      [(update-in follower [:owners m] (fnil conj #{}) principal) node]\n   400\t\n   401\t      :else [follower node])))\n   402\t\n   403\t\n   404\t(defn- release\n   405\t  \"`principal` releases `m`; the last release removes the record:\n   406\t   abandoned while loading, forgotten once terminal.\"\n   407\t  [follower node principal m]\n   408\t  (let [owners (get-in follower [:owners m])]\n   409\t    (cond\n   410\t      (not (contains? owners principal)) [follower node]\n   411\t\n   412\t      (< 1 (count owners))\n   413\t      [(update-in follower [:owners m] disj principal) node]\n   414\t\n   415\t      :else\n   416\t      (let [status (dht/load-status node m)\n   417\t            follower (update follower :owners dissoc m)]\n   418\t        [follower\n   419\t         (cond\n   420\t           (not= candidate-kind (:kind status)) node\n   421\t           (= :loading (:status status)) (dht/abandon node m)\n   422\t           :else (dht/forget node m))]))))\n   423\t\n   424\t\n   425\t;; -----------------------------------------------------------------------------\n   426\t;; Observing one trace (5.5)\n   427\t;; -----------------------------------------------------------------------------\n   428\t\n   429\t(defn- refused-event\n   430\t  [principal reason trace]\n   431\t  {:yin.head/event :refused :principal principal :reason reason :trace trace})\n   432\t\n   433\t\n   434\t(defn- envelope-id\n   435\t  [trace]\n   436\t  (jing/segment-key (:yin.head/envelope trace)))\n   437\t\n   438\t\n   439\t(defn- observe\n   440\t  \"Judge one observed `trace` of `principal`: `[follower node events]`.\"\n   441\t  [follower node principal trace]\n   442\t  (let [st (get-in follower [:principals principal])\n   443\t        installed (:installed st)\n   444\t        verdict (judge principal (seq-of-trace installed)\n   445\t                       (manifest-of installed) trace)\n   446\t        follower (assoc-in follower [:principals principal :observed]\n   447\t                           {:verdict verdict :trace trace})\n   448\t        cand (:candidate st)]\n   449\t    (case verdict\n   450\t      :duplicate [follower node []]\n   451\t\n   452\t      :candidate\n   453\t      (if (or (and cand (= trace (:trace cand)))\n   454\t              (= (:rejected st) (envelope-id trace)))\n   455\t        [follower node []]\n   456\t        (let [[follower node] (if cand\n   457\t                                (release follower node principal\n   458\t                                         (:manifest cand))\n   459\t                                [follower node])\n   460\t              m (manifest-of trace)\n   461\t              [follower node] (acquire follower node principal m)]\n   462\t          [(assoc-in follower [:principals principal :candidate]\n   463\t                     {:trace trace\n   464\t                      :manifest m\n   465\t                      :seq (seq-of-trace trace)\n   466\t                      :state :loading\n   467\t                      :delay (:repair-ticks follower)\n   468\t                      :due nil\n   469\t                      :failure nil})\n   470\t           node\n   471\t           []]))\n   472\t\n   473\t      [(assoc-in follower [:principals principal :refusal]\n   474\t                 {:reason verdict :trace trace})\n   475\t       node\n   476\t       [(refused-event principal verdict trace)]])))\n   477\t\n   478\t\n   479\t;; -----------------------------------------------------------------------------\n   480\t;; Polling the source (5.3)\n   481\t;; -----------------------------------------------------------------------------\n   482\t\n   483\t(defn- call\n   484\t  \"One stream operation on a handle that may be anything: a throw, or an\n   485\t   answer that is not a map, is a transport error that is not\n   486\t   retryable.\"\n   487\t  [f]\n   488\t  (try (let [r (f)]\n   489\t         (if (map? r) r {:dao.stream/outcome :dao.stream/transport-error}))\n   490\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   491\t         {:dao.stream/outcome :dao.stream/transport-error})))\n   492\t\n   493\t\n   494\t(defn- retry?\n   495\t  [r]\n   496\t  (and (= :dao.stream/transport-error (:dao.stream/outcome r))\n   497\t       (true? (:dao.stream/retry? r))))\n   498\t\n   499\t\n   500\t(defn- read-source\n   501\t  \"Read a source once from `cursor` (nil mints `:dao.stream/oldest`), at\n   502\t   most `budget` operations: `{:values [...] :cursor c :answered? b}`,\n   503\t   with `:lost outcome` for a lost source and `:more? true` when the\n   504\t   budget ran out.\"\n   505\t  [reader cursor budget]\n   506\t  (loop [cursor cursor\n   507\t         values []\n   508\t         answered? false\n   509\t         left budget]\n   510\t    (cond\n   511\t      (zero? left)\n   512\t      {:values values :cursor cursor :answered? answered? :more? true}\n   513\t\n   514\t      (nil? cursor)\n   515\t      (let [r (call #(stream/cursor reader :dao.stream/oldest))]\n   516\t        (cond\n   517\t          (= :dao.stream/ok (:dao.stream/outcome r))\n   518\t          (recur (:dao.stream/cursor r) values true (dec left))\n   519\t\n   520\t          (retry? r) {:values values :cursor nil :answered? answered?}\n   521\t          :else {:values values :lost (:dao.stream/outcome r)\n   522\t                 :answered? answered?}))\n   523\t\n   524\t      :else\n   525\t      (let [r (call #(stream/next reader cursor))]\n   526\t        (case (:dao.stream/outcome r)\n   527\t          :dao.stream/ok (recur (:dao.stream/cursor r)\n   528\t                                (conj values (:dao.stream/value r))\n   529\t                                true\n   530\t                                (dec left))\n   531\t          :dao.stream/gap (recur (:dao.stream/cursor r) values true (dec left))\n   532\t          :dao.stream/blocked {:values values :cursor cursor :answered? true}\n   533\t          (if (retry? r)\n   534\t            {:values values :cursor cursor :answered? answered?}\n   535\t            {:values values :lost (:dao.stream/outcome r)\n   536\t             :answered? answered?}))))))\n   537\t\n   538\t\n   539\t(defn- poll\n   540\t  \"Poll `principal`'s source when it is due, judging every value it\n   541\t   yields in order: `[follower node events]`.  A lost source is dropped\n   542\t   with its cursor and reported once.\"\n   543\t  [follower node principal now]\n   544\t  (let [{:keys [reader cursor due]} (get-in follower [:principals principal])]\n   545\t    (if (or (nil? reader) (and due (< now due)))\n   546\t      [follower node []]\n   547\t      (let [{:keys [values lost answered? more?] :as read}\n   548\t            (read-source reader cursor (:read-budget defaults))\n   549\t            follower (update-in follower [:principals principal]\n   550\t                                (fn [st]\n   551\t                                  (cond-> (assoc st\n   552\t                                                 :cursor (:cursor read)\n   553\t                                                 :due (if more?\n   554\t                                                        now\n   555\t                                                        (+ now (:poll-ticks\n   556\t                                                                 follower))))\n   557\t                                    answered? (assoc :answered now)\n   558\t                                    lost (assoc :reader nil :cursor nil\n   559\t                                                :due nil))))\n   560\t            [follower node events]\n   561\t            (reduce (fn [[f n es] v]\n   562\t                      (let [[f n more] (observe f n principal v)]\n   563\t                        [f n (into es more)]))\n   564\t                    [follower node []]\n   565\t                    values)]\n   566\t        [follower node\n   567\t         (cond-> events\n   568\t           lost (conj {:yin.head/event :source-lost :principal principal\n   569\t                       :outcome lost}))]))))\n   570\t\n   571\t\n   572\t;; -----------------------------------------------------------------------------\n   573\t;; The candidate's load: confirmed, rejected or unloadable (5.5)\n   574\t;; -----------------------------------------------------------------------------\n   575\t\n   576\t(defn- loaded-datoms-of\n   577\t  \"The datoms a loaded record at `m` holds: its value for an index or a\n   578\t   candidate load, the local walk for any other kind.\"\n   579\t  [node m status]\n   580\t  (if (contains? #{candidate-kind dht/index-kind} (:kind status))\n   581\t    {:datoms (:value status)}\n   582\t    (local-datoms node m)))\n   583\t\n   584\t\n   585\t(defn- walk-of\n   586\t  \"The walk a failed record of `kind` at `m` is started again with, or\n   587\t   nil for a kind the follower does not know.\"\n   588\t  [kind m]\n   589\t  (cond\n   590\t    (contains? #{candidate-kind dht/index-kind} kind) (dht/index-walk m)\n   591\t    (= ld/module-kind kind) (ld/closure-walk m)\n   592\t    :else nil))\n   593\t\n   594\t\n   595\t(defn- unloadable\n   596\t  [follower principal cand now failure]\n   597\t  [(assoc-in follower [:principals principal :candidate]\n   598\t             (assoc cand :state :failed :failure failure\n   599\t                    :due (+ now (:delay cand))))\n   600\t   [{:yin.head/event :unloadable :principal principal :trace (:trace cand)\n   601\t     :failure failure}]])\n   602\t\n   603\t\n   604\t(defn- settle\n   605\t  \"Advance `principal`'s candidate against its record: `[follower node\n   606\t   events]`.\"\n   607\t  [follower node principal now]\n   608\t  (let [{:keys [candidate]} (get-in follower [:principals principal])\n   609\t        m (:manifest candidate)\n   610\t        status (when candidate (dht/load-status node m))]\n   611\t    (cond\n   612\t      (or (nil? candidate) (= :confirmed (:state candidate)))\n   613\t      [follower node []]\n   614\t\n   615\t      ;; the record was removed under the follower: start it again\n   616\t      (nil? status)\n   617\t      (let [[follower node] (acquire follower node principal m)]\n   618\t        [(assoc-in follower [:principals principal :candidate :state] :loading)\n   619\t         node []])\n   620\t\n   621\t      (= :loading (:status status))\n   622\t      [(assoc-in follower [:principals principal :candidate :state] :loading)\n   623\t       node []]\n   624\t\n   625\t      (= :loaded (:status status))\n   626\t      (let [{:keys [datoms failure]} (loaded-datoms-of node m status)\n   627\t            n (:seq candidate)]\n   628\t        (cond\n   629\t          failure\n   630\t          (if (= :failed (:state candidate))\n   631\t            [follower node []]\n   632\t            (let [[follower events] (unloadable follower principal candidate\n   633\t                                                now failure)]\n   634\t              [follower node events]))\n   635\t\n   636\t          (= n (seq-of datoms))\n   637\t          [(assoc-in follower [:principals principal :candidate :state]\n   638\t                     :confirmed)\n   639\t           node\n   640\t           [{:yin.head/event :confirmed :principal principal\n   641\t             :trace (:trace candidate)}]]\n   642\t\n   643\t          :else\n   644\t          (let [[follower node] (release follower node principal m)\n   645\t                trace (:trace candidate)]\n   646\t            [(update-in follower [:principals principal] assoc\n   647\t                        :candidate nil\n   648\t                        :rejected (envelope-id trace)\n   649\t                        :refusal {:reason :yin.head/seq-mismatch :trace trace\n   650\t                                  :index-seq (seq-of datoms)})\n   651\t             node\n   652\t             [(assoc (refused-event principal :yin.head/seq-mismatch trace)\n   653\t                     :index-seq (seq-of datoms))]])))\n   654\t\n   655\t      ;; the load failed: report it once, then start it again after the\n   656\t      ;; delay, under the kind the record had\n   657\t      (not= :failed (:state candidate))\n   658\t      (let [[follower events] (unloadable follower principal candidate now\n   659\t                                          (:reason status))]\n   660\t        [follower node events])\n   661\t\n   662\t      (< now (:due candidate)) [follower node []]\n   663\t\n   664\t      :else\n   665\t      (if-some [walk (walk-of (:kind status) m)]\n   666\t        [(update-in follower [:principals principal :candidate] assoc\n   667\t                    :state :loading\n   668\t                    :due nil\n   669\t                    :delay (min (* 2 (:delay candidate))\n   670\t                                (:repair-max-ticks follower)))\n   671\t         (-> (dht/forget node m)\n   672\t             (dht/load m {:kind (:kind status) :walk walk}))\n   673\t         []]\n   674\t        [follower node []]))))\n   675\t\n   676\t\n   677\t(defn step\n   678\t  \"One pass after `dao.space.dht/step` at the owner's reading `now`: poll\n   679\t   each followed source that is due, judge what it shows, keep one\n   680\t   candidate per principal, and advance each candidate's load.  It\n   681\t   confirms; it never installs.  Answers `[follower node events]`.\"\n   682\t  [follower node now]\n   683\t  (reduce (fn [[f n es] p]\n   684\t            (let [[f n polled] (poll f n p now)\n   685\t                  [f n settled] (settle f n p now)]\n   686\t              [f n (-> es (into polled) (into settled))]))\n   687\t          [follower node []]\n   688\t          (keys (:principals follower))))\n   689\t\n   690\t\n   691\t(defn install\n   692\t  \"Install `principal`'s confirmed head `trace` (5.7 step 3): it enters\n   693\t   the snapshot set, the floor moves to its sequence, its candidate\n   694\t   record is released, and `:installed` is emitted.  Any other trace is\n   695\t   refused `:yin.head/not-confirmed`, follower and node unchanged.\n   696\t   Answers `[follower node events]`.\"\n   697\t  [follower node principal trace]\n   698\t  (followed! follower principal)\n   699\t  (let [cand (get-in follower [:principals principal :candidate])]\n   700\t    (if-not (and cand (= :confirmed (:state cand)) (= trace (:trace cand)))\n   701\t      [follower node [(refused-event principal :yin.head/not-confirmed trace)]]\n   702\t      (let [[follower node] (release follower node principal (:manifest cand))]\n   703\t        [(update-in follower [:principals principal] assoc\n   704\t                    :installed trace :candidate nil)\n   705\t         (assoc-in node [ld/installed-key principal] (:manifest cand))\n   706\t         [{:yin.head/event :installed :principal principal :trace trace}]]))))\n   707\t\n   708\t\n   709\t;; =============================================================================\n   710\t;; Status, records and moved names (5.6, 5.7)\n   711\t;; =============================================================================\n   712\t\n   713\t(defn heads\n   714\t  \"Per followed principal: what is installed (`:installed` the trace,\n   715\t   `:floor`, `:manifest`), the candidate and its state, the last\n   716\t   refusal, the last observation (`:observed`, with its verdict), and\n   717\t   whether a source is attached and the reading it last answered at.\"\n   718\t  [follower]\n   719\t  (into (sorted-map)\n   720\t        (map (fn [[p {:keys [installed candidate] :as st}]]\n   721\t               [p {:installed installed\n   722\t                   :floor (seq-of-trace installed)\n   723\t                   :manifest (manifest-of installed)\n   724\t                   :candidate (when candidate\n   725\t                                (select-keys candidate [:trace :manifest :seq\n   726\t                                                        :state :failure]))\n   727\t                   :refusal (:refusal st)\n   728\t                   :observed (:observed st)\n   729\t                   :source? (some? (:reader st))\n   730\t                   :answered (:answered st)}]))\n   731\t        (:principals follower)))\n   732\t\n   733\t\n   734\t(defn records\n   735\t  \"The value `heads.edn` holds once `trace` is written in `principal`'s\n   736\t   place: `{:version 1 :heads {principal trace}}`, every other installed\n   737\t   head kept.\"\n   738\t  [follower principal trace]\n   739\t  {:version 1\n   740\t   :heads (assoc (into {}\n   741\t                       (keep (fn [[p st]]\n   742\t                               (when (:installed st) [p (:installed st)])))\n   743\t                       (:principals follower))\n   744\t                 principal trace)})\n   745\t\n   746\t\n   747\t(defn moved\n   748\t  \"The linked names whose resolved address differs: `names` is\n   749\t   `yin.vm.linker.dht/names`' environment, `registry` `{name address}`\n   750\t   of what a session linked.  A name that no longer resolves has not\n   751\t   moved.\"\n   752\t  [names registry]\n   753\t  (vec (sort-by (comp str :name)\n   754\t                (keep (fn [[n linked]]\n   755\t                        (let [entry (get-in names [:names n])]\n   756\t                          (when (and (= :ok (:status entry))\n   757\t                                     (not= linked (:address entry)))\n   758\t                            {:name n :linked linked\n   759\t                             :resolved (:address entry)})))\n   760\t                      registry))))\n","exit_code":0,"status":"completed"}}
