ewer-head\n521:(deftest alternating-replay-keeps-safety-without-progress\n563:(deftest two-wrong-traces-alternating-are-walked-locally-and-never-resolve\n592:(deftest an-unloadable-candidate-keeps-the-head-and-retries-after-the-delay\n620:(deftest a-failed-load-made-by-hand-is-restarted-as-an-index-load\n642:(deftest a-load-index-by-hand-of-a-loading-candidate-is-a-kind-conflict\n673:(deftest shared-candidates-are-one-record-with-two-owners\n714:          w (run w 300 #(seq (events-of (:events %) :confirmed)))\n719:                                                          :confirmed)))))\n733:(deftest a-confirmed-head-is-used-only-after-install\n738:                                                          :confirmed)))\n744:                                                                 :confirmed))))\n746:    (testing \"after :confirmed and before install, nothing moved\"\n777:        (is (= [[:refused :yin.head/not-confirmed]]\n781:    (testing \"install of the confirmed trace moves the floor\"\n788:(deftest follow-refuses-a-record-that-fails\n843:(deftest a-lost-source-is-reported-once-and-a-fresh-handle-reads-again\n877:(deftest two-nodes-following-each-other-reach-quiescence\n893:                     [f node more] (install-confirmed f node events)]\n","exit_code":0,"status":"completed"}}
