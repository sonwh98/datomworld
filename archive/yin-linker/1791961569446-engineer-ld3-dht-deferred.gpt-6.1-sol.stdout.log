                          (assoc (entries source) (:address base)
                                 (jing/canonical-bytes
                                   (assoc (:manifest base) :yin.module/name 'other))))
        root (:yin.module/tree (:manifest (publish-app! (mem/create-content-mem
                                                          (entries source))
