(declare walk-module)


(defn- walk-requires
  "Step 5: list every pin with derived eagerness, then descend only into
   eager manifests not walked before. Deferred pins load at statement time."
  [st manifest-address manifest path depth]
  (let [eager-set (requirements/eager
                    (:yin.module/tree manifest)
                    (fn [address]
                      (let [[tag & slots] (get (:seen st) address)]
                        (into {:type tag}
                              (map (fn [[[field _] value]] [field value]))
                              (map vector (get vm/semantic-bytecode-grammar tag)
                                   slots)))))]
    (reduce (fn [st [n pinned]]
              (let [eager? (contains? eager-set n)
                    st (update st :requires conj
                               {:module manifest-address :name n :manifest pinned
                                :eager? eager?})]
                (cond
                  (not eager?) st

                  (contains? (:visited st) pinned) st

                  (> (inc depth) (get-in st [:bounds :max-depth]))
                  (reduced (stop st (invalid pinned :require (conj path pinned)
                                             :parts-limit {:bound :max-depth})))

                  :else
                  (let [st (walk-module st pinned :require path (inc depth))]
                    (if (:stop st) (reduced st) st)))))
            st
            (sort-by (fn [[n _]] (str n)) (:yin.module/requires manifest)))))


(defn- walk-module
  [st manifest-address role path depth]
  (let [path (conj path manifest-address)
        [st manifest] (read-blob st manifest-address role path)]
    (cond
      (:stop st) st

      (linker/manifest-defect manifest)
      (stop st (invalid manifest-address role path :manifest-defect
                        (linker/manifest-defect manifest)))

      :else
      (let [st (-> st
                   (update :visited conj manifest-address)
                   (update :modules conj manifest-address)
                   (walk-rows (:yin.module/tree manifest) path))
        base (ct/publish-base! store)
        optional (publish/publish-module!
                   store {:name 'optional :ast ct/deferred-ast :exports #{'g}
                          :requires {'base (:address base)}
                          :primitives {'try-require (vm/profile-of vm/primitives
                                                                   'try-require)}})
        node (dht/join {:local (ct/without store (:address base))})
        node (ld/load-module node (:address optional))
        [node _] (dht/step node 0)]
    (is (= :loaded (:status (ld/module-status node (:address optional)))))
    (is (= false (get-in (ld/module-status node (:address optional))
                         [:value :requires 0 :eager?])))
    (doseq [authority [{} {:name-env {'base (:address base)}}
                       {:name-env {'base (jing/segment-key "another manifest")}}]]
      (is (= [] (ld/dependency-bindings node authority (:address optional)))
          (pr-str authority)))
    (doseq [f formats]
      (is (linker/ok? (ld/link node (:address optional) f)) (name f)))
    (dht/close! node)))
