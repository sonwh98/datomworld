+
+(deftest tree-free-name-walk-equals-the-occurrence-rules
+  (let [scan (:obligations-fn linker/ast-format)]
+    (doseq [[label ast] (conj conformance-fixtures
+                              [:wide-module (:ast (wide-module 12))])
