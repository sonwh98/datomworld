- spans-conform?\n   130\t  \"Whether `spans` is the closed, off-pc-0, pairwise-disjoint body layout\n   131\t   the scope walk reads; anything else rules every `:var` free.\"\n   132\t  [spans]\n   133\t  (let [pairs (map (fn [[_ b r]] [b r]) spans)]\n   134\t    (and (every? (fn [[b r]] (and r (pos? b))) pairs)\n   135\t         (= (count pairs) (count (distinct pairs)))\n   136\t         (every? (fn [[[b1 r1] [b2 r2]]] (or (< r1 b2) (< r2 b1)))\n   137\t                 (for [x pairs, y pairs :when (neg? (compare x y))]\n   138\t                   [x y])))))\n   139\t\n   140\t\n   141\t(defn semantic-free-names\n   142\t  \"Every `:var` name free at some pc of canonical vector `v` (UCF\n   143\t   section 7.3.2): a `:var` at pc `p` is bound iff `p` lies in the body\n   144\t   of a `:closure` whose params hold the name, transitively through the\n   145\t   body holding that closure's own pc. Over a vector whose body spans\n   146\t   are not closed, off pc 0, and pairwise disjoint -- anything but the\n   147\t   ast-to-bytecode layout -- every `:var` name is ruled free:\n   148\t   over-approximating obligations is always admissible.\"\n   149\t  [v]\n   150\t  (try\n   151\t    (let [spans (closure-spans v)]\n   152\t      (if (spans-conform? spans)\n   153\t        (let [params (into {}\n   154\t                           (keep (fn [c]\n   155\t                                   (let [t (nth v c)]\n   156\t                                     (when (and (vector? t)\n   157\t                                                (= :closure (nth t 0)))\n   158\t                                       [c (nth t 1)]))))\n   159\t                           (range (count v)))\n   160\t              owner (fn [pc]\n   161\t                      (some (fn [[c b r]] (when (<= b pc r) c)) spans))\n   162\t              bound? (fn bound?\n   163\t                       [pc sym]\n   164\t                       (when-let [c (owner pc)]\n   165\t                         (or (some #(= % sym) (get params c))\n   166\t                             (bound? c sym))))]\n   167\t          (set (keep (fn [pc]\n   168\t                       (let [t (nth v pc)]\n   169\t                         (when (and (vector? t)\n   170\t                                    (= :var (nth t 0))\n   171\t                                    (< 1 (count t))\n   172\t                                    (not (bound? pc (nth t 1))))\n   173\t                           (nth t 1))))\n   174\t                     (range (count v)))))\n   175\t        (all-var-names v)))\n   176\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   177\t      (all-var-names v))))\n   178\t\n   179\t\n   180\t(defn- tree-free-names\n   181\t  \"Every `:variable` name free at some occurrence of the tree `{:root\n   182\t   root, :rows {id row}}`: the section 4.5 free-name query of\n   183\t   `yin.vm.code-as-tuples.md`, run over the row relation and the tree's\n   184\t   occurrence relation (`vm/free-names`).\"\n   185\t  [tree]\n   186\t  (vm/free-names (query/relation (vals (:rows tree)))\n   187\t                 (query/relation (vm/occurrences tree))\n   188\t                 (:root tree)))\n   189\t\n   190\t\n   191\t;; =============================================================================\n   192\t;; Row-local validation and the parts worklist (sections 5.1, 4.2 step 2)\n   193\t;; =============================================================================\n   194\t\n   195\t(defn row-local-defect\n   196\t  \"The section 7.4 row-local rules -- `:tag`, `:arity`, `:slot-kind`,\n   197\t   `:saturation` -- over one row body `[tag & slots]`, nil when the body\n   198\t   is locally well formed. The whole-tree rules (`:id-resolves`,\n   199\t   `:acyclic`, `:root-reachable`) cannot run over one body and are never\n   200\t   reported here: a locally well-formed body's child ids resolve in\n   201\t   step 2's worklist. A malformed row's slots are never followed\n   202\t   (section 5.1). A body that is not a vector is a `:tag` defect: only a\n   203\t   vector can be a row.\"\n   204\t  [body]\n   205\t  (let [row (if (vector? body) (into [::root] body) [::root body])\n   206\t        res (vm/validate-rows {:root ::root, :rows {::root row}})]\n   207\t    (when (contains? #{:tag :arity :slot-kind :saturation} (:rule res))\n   208\t      res)))\n   209\t\n   210\t\n   211\t(defn- body-child-ids\n   212\t  \"The child row ids of one fetched body's `node`/`nodes` slots, by the\n   213\t   grammar's own positions. Only valid segment addresses are followed: a\n   214\t   slot holding something else stays in the row for `validate-rows` to\n   215\t   name as its `:slot-kind` defect, exactly as it would in a\n   216\t   hand-supplied row set.\"\n   217\t  [body]\n   218\t  (let [slots (get vm/semantic-bytecode-grammar (first body))]\n   219\t    (when (and slots (= (count slots) (dec (count body))))\n   220\t      (mapcat (fn [[_field kind] v]\n   221\t                (case kind\n   222\t                  :node (when (jing/segment-address? v) [v])\n   223\t                  :nodes (filter jing/segment-address? v)\n   224\t                  nil))\n   225\t              slots (rest body)))))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; Format records (section 5)\n   230\t;; =============================================================================\n   231\t\n   232\t(def stack-format\n   233\t  \"The `:yin.debruijn.code` format record: stack images identified by H\n   234\t   under the \\\"b1\\\" contract, one canonical vector per image.\"\n   235\t  {:format              :yin.debruijn.code,\n   236\t   :contract            \"b1\",\n   237\t   :identity-fn         debruijn-code/image-hash,\n   238\t   :identity-matches-fn (fn [H v] (= H (debruijn-code/image-hash v))),\n   239\t   :row-defect-fn       debruijn-code/image-defect,\n   240\t   :validate-fn         debruijn-code/image-defect,\n   241\t   :obligations-fn      stack-free-names,\n   242\t   :parts-fn            (constantly nil)})\n   243\t\n   244\t\n   245\t(def register-format\n   246\t  \"The `:yin.debruijn.register` format record: register images identified\n   247\t   by R under the \\\"r1\\\" contract, one image map per image.\"\n   248\t  {:format              :yin.debruijn.register,\n   249\t   :contract            \"r1\",\n   250\t   :identity-fn         debruijn-register-code/register-hash,\n   251\t   :identity-matches-fn (fn [R v]\n   252\t                          (= R (debruijn-register-code/register-hash v))),\n   253\t   :row-defect-fn       debruijn-register-code/register-image-defect,\n   254\t   :validate-fn         debruijn-register-code/register-image-defect,\n   255\t   :obligations-fn      register-free-names,\n   256\t   :parts-fn            (constantly nil)})\n   257\t\n   258\t\n   259\t(def semantic-format\n   260\t  \"The `:yin.semantic/code` format record: the canonical positional\n   261\t   instruction vector stored as the exact payload at its own\n   262\t   `segment-key` (UCF section 7.3.4), under the \\\"v2\\\" contract. Identity\n   263\t   and address are one preimage; step 3 still runs, because it is the\n   264\t   only check that the index did not point the identity at a different,\n   265\t   correctly stored payload (section 4.2).\"\n   266\t  {:format              :yin.semantic/code,\n   267\t   :contract            \"v2\",\n   268\t   :identity-fn         jing/segment-key,\n   269\t   :identity-matches-fn jing/segment-matches?,\n   270\t   :row-defect-fn       code/well-formed-vector?,\n   271\t   :validate-fn         code/well-formed-vector?,\n   272\t   :obligations-fn      semantic-free-names,\n   273\t   :parts-fn            (constantly nil)})\n   274\t\n   275\t\n   276\t(def ast-format\n   277\t  \"The `:yin.ast/code` format record: one row body `[tag & slots]` per\n   278\t   address (D3), the root row's id the tree's identity, under the \\\"v2\\\"\n   279\t   contract. Step 2 is a bounded worklist over the grammar's\n   280\t   `node`/`nodes` slots; the whole tree is assembled for step 4 by\n   281\t   prepending each part's address, the shape `validate-rows` takes.\"\n   282\t  {:format              :yin.ast/code,\n   283\t   :contract            \"v2\",\n   284\t   :identity-fn         jing/segment-key,\n   285\t   :identity-matches-fn jing/segment-matches?,\n   286\t   :row-defect-fn       row-local-defect,\n   287\t   :validate-fn         vm/validate-rows,\n   288\t   :obligations-fn      tree-free-names,\n   289\t   :parts-fn            body-child-ids})\n   290\t\n   291\t\n   292\t;; =============================================================================\n   293\t;; The H and R indexes (section 6)\n   294\t;; =============================================================================\n   295\t\n   296\t(defn address-attribute\n   297\t  \"The index attribute a format's identities are published under:\n   298\t   `:yin.debruijn.code/address` or `:yin.debruijn.register/address`.\"\n   299\t  [format]\n   300\t  (keyword (name (:format format)) \"address\"))\n   301\t\n   302\t\n   303\t(defn index-from-datoms\n   304\t  \"A plain identity -> address map read from index datoms\n   305\t   `[identity attribute address]`, keeping only the attribute `format`\n   306\t   publishes under. The index is composition data; an entry is a claim,\n   307\t   not a proof (step 3 checks it).\"\n   308\t  [format datoms]\n   309\t  (let [attr (address-attribute format)]\n   310\t    (into {}\n   311\t          (keep (fn [[e a v]] (when (= attr a) [e v])))\n   312\t          datoms)))\n   313\t\n   314\t\n   315\t;; =============================================================================\n   316\t;; The receiver environment (step 5)\n   317\t;; =============================================================================\n   318\t;; The receiver binds a free name in the order\n   319\t;; `yin.vm.engine/resolve-var` uses: free env -> store -> primitives ->\n   320\t;; module registry. A name the image publisher meant as a primitive or a\n   321\t;; module binding must resolve there; a receiver whose free env or store\n   322\t;; also binds it would bind it differently, so that is refused as\n   323\t;; shadowed rather than executed (D11).\n   324\t\n   325\t(defn- shadowed?\n   326\t  [{:keys [free-env store]} sym]\n   327\t  (or (contains? free-env sym) (contains? store sym)))\n   328\t\n   329\t\n   330\t(defn- resolvable?\n","exit_code":0,"status":"completed"}}
