        (is (identical? state state'))
        (is (nil? text'))))
    (let [[state text] (repl/recheck-on-answers (answer-at! state (allow id)))]
      (is (some? text))
      (is (nil? (:pending-run state)))
      (is (= 'own.m (:last-value state))))))


