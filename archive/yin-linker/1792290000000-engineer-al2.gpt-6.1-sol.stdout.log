(def gap-budget
  "Maximum `gap` answers one output drain accepts.  A gap is not an element,
   so it is counted apart from `drain-budget`: a gap never costs the drain
   an element, and the drain stays total against a transport that could
   answer `gap` repeatedly."
  4096)


(def link-round-budget
  "How many serve-and-run rounds one evaluation drives while its VM waits
   on a link (yin.vm.linker.md sections 6.3 and 7.2).  A round serves the
   interpreter once and runs the VM once; a local content source answers
   within a few, so the budget is reached only by a link that stays
   `:pending`, which the shell then reports as its own non-blocking state
   instead of wedging on."
  40)


(def query-row-limit
  "A REPL of `vm-type` over `w`'s node, holding A's key and declaring B,
   composed with the creation options `opts`."
  ([w vm-type] (shell w vm-type {}))
  ([w vm-type opts]
   (-> (repl.frontends/create-state (merge {:vm-type vm-type
                                            :dht-key a
                                            :principals [(:public b)]}
                                           opts))
       (assoc :dht (:node w))
       (assoc-in [:link-source :content] {:kind :dht}))))


(defn- type!
  [state line]
  (repl/eval-input state line))


(defn- require!
  [state n]
  (type! state (str "(require (quote " n "))")))


(defn- pending-admission
  [state]
  (some :admission (get-in state [:pending-run :links])))


(defn- settle
  "Step the node and re-check the pending run until `done?` holds or 40
   re-checks pass: `[state text]`."
  ([state] (settle state #(nil? (:pending-run %))))
  ([state done?]
   (loop [state state
          text ""
          i 0]
     (if (or (done? state) (>= i 40))
       [state text]
       (let [[node _] (dht/step (:dht state) (* 10 i))
             [state t] (repl/recheck-pending (assoc state :dht node))]
         (recur state (str text t) (inc i)))))))


(defn- answer-at!
  "Append `answer` to the shell's answer medium, as an external
   interpreter."
