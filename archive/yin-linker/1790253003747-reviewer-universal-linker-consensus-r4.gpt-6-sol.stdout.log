fect\n   202\t   parks with the continuation after the call site.\"\n   203\t  [code seg pc val St E K vm tail? f args]\n   204\t  (cond\n   205\t    (= :closure (:type f))\n   206\t    (let [E' (merge (:env f) (engine/bind-params (:params f) args))\n   207\t          frame {:type :return, :segment seg, :pc (inc pc), :env E,\n   208\t                 :stack-base (count St)}\n   209\t          seg' (:segment f)]\n   210\t      {:goto [seg' (:entry f) val St E' (if tail? K (conj K frame))\n   211\t              vm (get code seg')]})\n   212\t    (fn? f)\n   213\t    (let [result (apply f args)]\n   214\t      (if (module/effect? result)\n   215\t        (let [{:keys [state value blocked?]}\n   216\t              (engine/handle-effect\n   217\t                (put-registers vm seg pc val St E K)\n   218\t                result\n   219\t                {:park-entry-fns (call-park-entries seg pc E St K)})]\n   220\t          (if blocked?\n   137\t(def program-loaders\n   138\t  \"The loader the evaluator observer hands each `program-out` value, per\n   139\t   evaluator.  Every value there is one expanded canonical tree packet\n   140\t   `[root rows]` (yin.vm.macro.md §2.4); each loader takes its row set — the\n   141\t   ast-walker through `vm-load-rows`, the semantic VM through\n   142\t   `linearize/rows-loader` over `semantic/load-vector`, and the de Bruijn\n   143\t   kernels through their lowerings to a stack image (H) or a register\n   144\t   image (R).  No evaluator learns that an expander ran.\"\n   145\t  {:ast-walker (fn [vm packet]\n   146\t                 (ast-walker/vm-load-rows vm (macro/packet->row-set packet)))\n   147\t   :semantic (let [load-rows (linearize/rows-loader semantic/load-vector)]\n   148\t               (fn [vm packet]\n   149\t                 (load-rows vm (macro/packet->row-set packet))))\n   150\t   :stack (fn [vm packet]\n   151\t            (append-stack-image\n   152\t              vm\n   153\t              (:image (debruijn-linearize/adapt\n   154\t                        (packet->named-datoms packet)))))\n   155\t   :register (fn [vm packet]\n   156\t               (append-register-image\n   157\t                 vm\n   158\t                 (:image (register-compile/adapt\n   159\t                           (packet->named-datoms packet)))))})\n   160\t\n   161\t\n   162\t(def lang-labels {:clojure \"Clojure\" :python \"Python\" :php \"PHP\"})\n   163\t\n   164\t\n   165\t(def command-heads\n   166\t  \"Commands this shell answers.  `connect` and `disconnect` belong to the\n   167\t   driver, which owns the RPC client; `telemetry` is answered only to say that\n   168\t   this REPL slice does not have it.\"\n","exit_code":0,"status":"completed"}}
