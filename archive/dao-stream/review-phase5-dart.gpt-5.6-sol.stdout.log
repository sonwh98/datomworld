diately but never completes the test's future — the runner then adds a `TimeoutException` 30s later. The real failure is the assertion output above that timeout. I documented this in the namespace docstring and deliberately did **not** add `--timeout` to `bb.edn`, since raising it only lengthens failing runs (passing facts take ~0.2s each).\n-rwxr-xr-x@ 1 sto  staff  7505648 Sep  5 00:35 build/slice-peer\n-rw-r--r--@ 1 sto  staff    20966 Sep  5 00:36 lib/cljd-out/dao/stream/slice-peer.dart\nsrc/cljd/dao/stream/ws/dart.cljd:225:(defn bind!\nsrc/cljd/dao/stream/ws/dart.cljd:257:(defn unbind!\nsrc/cljd/dao/stream/ws/dart.cljd:294:  {:connect! connect! :bind! bind! :unbind! unbind!})\n     1\t(ns dao.stream.ws.dart\n     2\t  \"The dart:io host edge for the portable DaoStream v2 WebSocket boundary.\n     3\t\n     4\t   Host objects live only in this namespace.  Socket callbacks immediately\n     5\t   become calls to the transport adapter, whose only observable effect is a\n     6\t   plain-data deposit.  The returned `websocket` value is the complete host\n     7\t   seam consumed by `yin.repl.connect` and `yin.repl.serve`.\"\n     8\t  (:require [\"dart:async\" :as async]\n     9\t            [\"dart:core\" :as core]\n    10\t            [\"dart:io\" :as io]\n    11\t            [clojure.string :as str]\n    12\t            [dao.stream.ws :as ws]))\n    13\t\n    14\t\n    15\t(def binary-message-text\n    16\t  \"An invalid Transit text value used to route a binary frame through the\n    17\t   transport's ordinary decode-failure teardown.\"\n    18\t  (core/String.fromCharCode 0))\n    19\t\n    20\t\n    21\t(def ^:private unreserved\n    22\t  (set (concat (map core/String.fromCharCode\n    23\t                    (concat (range 48 58) (range 65 91) (range 97 123)))\n    24\t               [\"-\" \".\" \"_\" \"~\"])))\n    25\t\n    26\t\n    27\t(defn- normalize-percent-escapes\n    28\t  [s]\n    29\t  (let [n (count s)]\n    30\t    (loop [i 0 out []]\n    31\t      (if (>= i n)\n    32\t        (apply str out)\n    33\t        (if-not (= \\% (nth s i))\n    34\t          (recur (inc i) (conj out (nth s i)))\n    35\t          (let [pair (when (<= (+ i 3) n) (subs s (inc i) (+ i 3)))]\n    36\t            (if-not (and pair (re-matches #\"[0-9A-Fa-f]{2}\" pair))\n    37\t              nil\n    38\t              (let [decoded (core/String.fromCharCode\n    39\t                              (core/int.parse pair .radix 16))]\n    40\t                (if (contains? unreserved decoded)\n    41\t                  (recur (+ i 3) (conj out decoded))\n    42\t                  (recur (+ i 3) (conj out \"%\" (str/upper-case pair))))))))))))\n    43\t\n    44\t\n    45\t(defn- remove-dot-segments\n    46\t  [segments]\n    47\t  (let [kept (reduce (fn [xs segment]\n    48\t                       (cond\n    49\t                         (= \".\" segment) xs\n    50\t                         (= \"..\" segment) (if (seq xs) (pop xs) xs)\n    51\t                         :else (conj xs segment)))\n    52\t                     [] segments)]\n    53\t    (if (contains? #{\".\" \"..\"} (last segments)) (conj kept \"\") kept)))\n    54\t\n    55\t\n    56\t(defn canonical-path\n    57\t  \"Canonicalize a request target according to dao.stream.ws.md.\"\n    58\t  [target]\n    59\t  (when (string? target)\n    60\t    (let [without-fragment (first (str/split target #\"#\"))\n    61\t          without-query (first (str/split without-fragment #\"\\?\"))\n    62\t          decoded (normalize-percent-escapes without-query)]\n    63\t      (when (some? decoded)\n    64\t        (cond\n    65\t          (= \"\" decoded) \"/\"\n    66\t          (str/starts-with? decoded \"/\")\n    67\t          (str \"/\" (str/join \"/\" (remove-dot-segments\n    68\t                                     (str/split (subs decoded 1) #\"/\" -1))))\n    69\t          :else nil)))))\n    70\t\n    71\t\n    72\t(defn socket-url\n    73\t  [descriptor]\n    74\t  (str \"ws://\" (:ws/host descriptor) \":\" (:ws/port descriptor)\n    75\t       (:ws/path descriptor)))\n    76\t\n    77\t\n    78\t(defn socket-view\n    79\t  \"Build the raw `{:send! :close!}` boundary from host operations.\n    80\t\n    81\t   Kept host-agnostic so focused CLJD tests can prove that accepted handles own\n    82\t   and invoke their socket close operation without manufacturing dart:io\n    83\t   objects.\"\n    84\t  [send! close!]\n    85\t  {:send! send! :close! close!})\n    86\t\n    87\t\n    88\t(defn- raw-socket\n    89\t  [socket]\n    90\t  (let [socket ^io/WebSocket socket]\n    91\t    (socket-view (fn [text] (.add socket text))\n    92\t                 (fn [code reason] (.close socket code reason)))))\n    93\t\n    94\t\n    95\t(defn- wire!\n    96\t  \"Install the sole subscription on one dart:io WebSocket.\"\n    97\t  ([socket adapter] (wire! socket adapter nil))\n    98\t  ([socket adapter on-done]\n    99\t  (let [socket ^io/WebSocket socket]\n   100\t    (.listen socket\n   101\t             (fn [value]\n   102\t               ((:message! adapter)\n   103\t                (if (string? value) value binary-message-text)))\n   104\t             .onError (fn [_error] ((:error! adapter)))\n   105\t             .onDone (fn []\n   106\t                       ((:closed! adapter)\n   107\t                        (or (.-closeCode socket) 1006)\n   108\t                        (or (.-closeReason socket) \"\"))\n   109\t                       (when on-done (on-done)))))\n   110\t   socket))\n   111\t\n   112\t\n   113\t(defn connect!\n   114\t  \"Begin a Dart WebSocket connection and synchronously return its raw view.\n   115\t\n   116\t   Dart creates the socket asynchronously, so the view closes over one private\n   117\t   boundary atom.  No message can be sent before the transport receives the\n   118\t   peer's accept frame; by then the socket has been installed.\"\n   119\t  [descriptor adapter]\n   120\t  (let [socket-ref (atom nil)