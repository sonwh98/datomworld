otocol-required\")\n   168\t    (.close response)))\n   169\t\n   170\t\n   171\t(defn- offered-subprotocol?\n   172\t  [request]\n   173\t  (let [header (.value (.-headers ^io/HttpRequest request)\n   174\t                       \"sec-websocket-protocol\")]\n   175\t    (boolean\n   176\t      (and header\n   177\t           (some #(= ws/subprotocol (str/trim %))\n   178\t                 (str/split header #\",\"))))))\n   179\t\n   180\t\n   181\t(defn- handle-request!\n   182\t  [{:keys [accept! deposit!] :as config} request]\n   183\t  (let [request ^io/HttpRequest request\n   184\t        summary (request-summary request)]\n   185\t    (if-not (and (io/WebSocketTransformer.isUpgradeRequest request)\n   186\t                 (offered-subprotocol? request))\n   187\t      (do\n   188\t        (reject-upgrade! request)\n   189\t        (deposit! :upgrade-failed\n   190\t                  (assoc summary\n   191\t                         :code :yin.repl.endpoint/subprotocol-required\n   192\t                         :message \"the WebSocket upgrade did not offer the v2 subprotocol\")))\n   193\t      (-> (io/WebSocketTransformer.upgrade\n   194\t            request .protocolSelector (fn [_protocols] ws/subprotocol))\n   195\t          (.then (fn [socket]\n   196\t                   (try\n   197\t                     (let [connections (:ws.dart/connections config)\n   198\t                           raw (raw-socket socket)\n   199\t                           path (or (canonical-path (str (.-uri request)))\n   200\t                                    (str (.-uri request)))\n   201\t                           accepted (accept! path raw (now-ms))]\n   202\t                       ;; A pending offer owns the accepted handle.  This is\n   203\t                       ;; the server-side socket-close wiring v1 omitted.\n   204\t                       (when-let [handle (:ws/handle accepted)]\n   205\t                         (swap! connections conj socket)\n   206\t                         (wire! socket (ws/adapter handle)\n   207\t                                #(swap! connections disj socket))))\n   208\t                     (catch Object _\n   209\t                       ;; If endpoint admission itself fails, no portable\n   210\t                       ;; handle exists to own teardown yet.\n   211\t                       (.close ^io/WebSocket socket 1011\n   212\t                               \"dao.stream/upgrade-failed\")\n   213\t                       (deposit! :upgrade-failed\n   214\t                                 (assoc summary\n   215\t                                        :code :yin.repl.endpoint/upgrade-failed\n   216\t                                        :message \"endpoint admission failed\"))))))\n   217\t          (.catchError\n   218\t            (fn [_error]\n   219\t              (deposit! :upgrade-failed\n   220\t                        (assoc summary\n   221\t                               :code :yin.repl.endpoint/upgrade-failed\n   222\t                               :message \"the WebSocket upgrade failed\"))))))))\n   223\t\n   224\t\n   225\t(defn bind!\n   226\t  \"Begin binding one dart:io listener and return its explicit resource value.\"\n   227\t  [{:keys [bind-host bind-port deposit!] :as config}]\n   228\t  (let [server-ref (atom nil)\n   229\t        connections (atom #{})\n   230\t        config (assoc config :ws.dart/connections connections)\n   231\t        bind-future ^async/Future (io/HttpServer.bind bind-host bind-port)]\n   232\t    (-> bind-future\n   233\t        (.then (fn [server]\n   234\t                 (let [server ^io/HttpServer server]\n   235\t                   (reset! server-ref server)\n   236\t                   (.listen server\n   237\t                            (fn [request] (handle-request! config request))\n   238\t                            .onError\n   239\t                            (fn [_error]\n   240\t                              (deposit! :listener-error\n   2