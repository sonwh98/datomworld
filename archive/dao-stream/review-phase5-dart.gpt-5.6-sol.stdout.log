isagrees with the served descriptors'\\\")\\n   646\\t                                (is (= :dao.stream/ok (:dao.stream/outcome\\n   647\\t                                                        (stream/append! source :slice/both))))\\n   648\\t                                (is (= :slice/both (:dao.stream/value\\n   649\\t                                                     (stream/next source (:dao.stream/cursor minted)))))))\\n   650\\t                            (await-event @one #(= :slice/both (:ws/value %))\\n\\n--- deps aliases ---\\n5-        org.postgresql/postgresql {:mvn/version \\\"42.7.3\\\"}\\n6-        org.clojure/data.json {:mvn/version \\\"2.5.0\\\"}\\n7-        http-kit/http-kit {:mvn/version \\\"2.8.0\\\"}\\n8-        org.jsoup/jsoup {:mvn/version \\\"1.18.3\\\"}\\n9-        instaparse/instaparse {:mvn/version \\\"1.5.0\\\"}\\n10-        criterium/criterium {:mvn/version \\\"0.4.6\\\"}\\n11-        stigmergy/chp {:mvn/version \\\"0.1.0-SNAPSHOT\\\"\\n12-                       :exclusions [refactor-nrepl/refactor-nrepl]}}\\n13: :cljd/opts {}\\n14- :paths [\\\"src/clj\\\" \\\"src/cljc\\\" \\\"src/cljs\\\" \\\"src/cljd\\\"]\\n15- :aliases {:clean {:extra-paths [\\\"src/dev\\\"]\\n16-                   :exec-fn clean/clean}\\n17-           :bench {:extra-paths [\\\"test\\\"]\\n18-                   :main-opts [\\\"-m\\\" \\\"yin.vm.bytecode-bench\\\"]}\\n19-           :profile {:extra-paths [\\\"test\\\"]\\n20-                     :jvm-opts [\\\"-XX:StartFlightRecording=filename=/tmp/datomworld-bytecode-bench.jfr,settings=profile,dumponexit=true\\\"]\\n21-                     :main-opts [\\\"-m\\\" \\\"yin.vm.bytecode-bench\\\"]}\\n--\\n51-                              reagent/reagent {:mvn/version \\\"2.0.1\\\"}\\n52-                              com.cognitect/transit-cljs {:mvn/version \\\"0.8.280\\\"}\\n53-                              ;; benchmark baseline + psset-fixtures\\n54-                              ;; generator only; production uses\\n