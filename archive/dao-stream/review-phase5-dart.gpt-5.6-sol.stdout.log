  463\t              ;; A appends to the surviving logical stream; the rejoined\n   464\t              ;; attachment receives it, which is what \"same logical stream\"\n   465\t              ;; means operationally.\n   466\t              (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source token))))\n   467\t              (is (some? (await (await-event peer #(= token (:ws/value %))\n   468\t                                             \"the rejoined attachment received nothing from the served stream\")))))))))))\n   469\t\n   470\t\n   471\t(deftest simultaneous-attachments-carry-distinct-attachment-identity\n   472\t  ;; Fact 3.  Two whole processes, so nothing but the wire could make their\n   473\t  ;; identities agree by accident.\n   474\t  (await\n   475\t    (run-slice\n   476\t      (fn [{:keys [source primary]} peers]\n   477\t        (let [descriptor (reachable primary)\n   478\t              peer-1 (await (attach-peer! peers descriptor))\n   479\t              peer-2 (await (attach-peer! peers descriptor))]\n   480\t          (is (string? (:attachment peer-1)))\n   481\t          (is (string? (:attachment peer-2)))\n   482\t          (is (not= (:attachment peer-1) (:attachment peer-2))\n   483\t              \"two simultaneous attachments shared one attachment identity\")\n   484\t\n   485\t          (let [token-1 [:slice/fact-3 (:attachment peer-1)]\n   486\t                token-2 [:slice/fact-3 (:attachment peer-2)]]\n   487\t            (await (ask! peer-1 {:cmd :append :value token-1} :append))\n   488\t            (await (ask! peer-2 {:cmd :append :value token-2} :append))\n   489\t            (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source :slice/fanout))))\n   490\t            (await (await-event peer-1 #(= :slice/fanout (:ws/value %))\n   491\t                                \"the first attachment received nothing\"))\n   492\t            (await (await-event peer-2 #(= :slice/fanout (:ws/value %))\n   493\t                                \"the second attachment received nothing\"))\n   494\t\n   495\t            (let [a-1 (await (server-attachment primary token-1))\n   496\t                  a-2 (await (server-attachment primary token-2))]\n   497\t              (is (some? a-1))\n   498\t              (is (some? a-2))\n   499\t              (is (not= a-1 a-2)\n   500\t                  \"two connections were folded into one server-side attachment\")\n   501\t\n   502\t              ;; Close both before asserting attribution.  Correlation checked\n   503\t              ;; while the attachments are live sees only resolution and\n   504\t              ;; payload events; the terminal ones would arrive later, during\n   505\t              ;; teardown, unobserved.  An implementation that emitted a wrong\n   506\t              ;; or missing `:ws/attachment` exactly on `:ws/closed` would pass\n   507\t              ;; such a check.\n   508\t              (doseq [peer [peer-1 peer-2]]\n   509\t                (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :close} :close))))))\n   510\t\n   511\t              (testing \"every event on a client medium carries that client's identity\"\n   512\t                (doseq [peer [peer-1 peer-2]]\n   513\t                  (await (await-event peer #(= :ws/closed (:ws/event %))\n   514\t                                      \"a client medium never received its terminal event\"))\n   515\t                  (let [events @(:seen peer)\n   516\t                        terminal (terminal-event events)]\n   517\t                    (is (seq events))\n   518\t                    ;; Resolution, payload, and lifecycle alike.\n   519\t                    (is (every? #(= (:attachment peer) (:ws/attachment %)) events)\n   520\t                        \"an event on B's medium was attributed to another attachment\")\n   521\t                    (is (some? terminal))\n   522\t                    (is (= (:attachment peer) (:ws/attachment terminal))\n   523\t                        \"B's terminal event was not attributed to its attachment\"))))\n   524\t\n   525\t              (testing \"every event on a server medium carries that session's identity\"\n   526\t                (doseq [attachment [a-1 a-2]]\n   527\t                  (let [events (await (await-terminal primary attachment))\n   528\t                        terminal (terminal-event events)]\n   529\t                    (is (seq events))\n   530\t                    (is (some? terminal)\n   531\t                        \"a server medium never deposited its terminal event\")\n   532\t                    ;; Payload and lifecycle alike.\n   533\t                    (is (every? #(= attachment (:ws/attachment %)) events))\n   534\t                    (is (= attachment (:ws/attachment terminal))\n   535\t                        \"A's terminal event was not attributed to its session\")))))))))))\n   536\t\n   537\t\n   538\t(deftest the-deposit-medium-outlives-the-socket\n   539\t  ;; Fact 4.  The cursor is B's, on B's medium; it is never handed to\n   540\t  ;; `attach!` and never used through the WebSocket handle.\n   541\t  (await\n   542\t    (run-slice\n   543\t      (fn [{:keys [source primary]} peers]\n   544\t        (let [peer (await (attach-peer! peers (reachable primary)))\n   545\t              token [:slice/fact-4 (:attachment peer)]]\n   546\t          (is (= #{:writer :closable} (:value (await (ask! peer {:cmd :surfaces} :surfaces))))\n   547\t              \"the ws handle must have no reader surface for this fact to mean anything\")\n   548\t\n   549\t          (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source token))))\n   550\t          (await (await-event peer #(= token (:ws/value %)) \"the payload never arrived\"))\n   551\t\n   552\t          ;; The socket dies.  B's medium and B's position on it do not.\n   553\t          (is (= :dao.stream/ok (:outcome (await (ask! peer {:cmd :close} :close)))))\n   554\t          (await (await-event peer #(= :ws/closed (:ws/event %))\n   555\t                              \"the kept cursor did not resume across the socket's death\"))\n   556\t\n   557\t          (testing \"the cursor resumed rather than restarted\"\n   558\t            ;; Every event B has reported came from one uninterrupted walk of\n   559\t            ;; one cursor: an opened, a payload, and exactly one terminal\n   560\t            ;; event, in order and without repetition.\n   561\t            (let [events @(:seen peer)]\n   562\t              (is (= [:ws/opened :ws/payload :ws/closed] (mapv :ws/event events)))\n   563\t              (is (apply distinct? events)))))))))\n   564\t\n   565\t\n   566\t(deftest two-endpoints-differ-in-reachability-and-agree-on-identity\n   567\t  ;; Fact 5.\n   568\t  (await\n   569\t    (run-slice\n   570\t      (fn [{:keys [source primary secondary]} peers]\n   571\t        (let [projection (stream/descriptor source)\n   572\t              identity (:dao.stream/identity projection)\n   573\t              d-1 (reachable primary)\n   574\t              d-2 (reachable secondary)]\n   575\t          (is (not= d-1 d-2) \"two endpoints produced the same descriptor\")\n   576\t          (is (not= (select-keys d-1 [:ws/host :ws/port :ws/path])\n   577\t                    (select-keys d-2 [:ws/host :ws/port :ws/path]))\n   578\t              \"the two endpoints are not separately reachable\")\n   579\t\n   580\t          (testing \"the served descriptors carry the ring buffer's own identity\"\n   581\t            ;; Not a constant this test chose: the value the served stream mints.\n   582\t            (is (= :dao.stream/ok (:dao.stream/outcome projection)))\n   583\t            (is (string? identity))\n   584\t            (is (= identity (:dao.stream/identity (:dao.stream/descriptor projection)))\n   585\t                \"the sibling identity disagrees with the one inside the envelope\")\n   586\t            (is (= identity (:dao.stream/identity d-1)))\n   587\t            (is (= identity (:dao.stream/identity d-2))\n   588\t                \"one logical stream served twice must carry one identity\"))\n   589\t\n   590\t          (let [peer-1 (await (attach-peer! peers d-1))\n   591\t                peer-2 (await (attach-peer! peers d-2))\n   592\t                h-1 (await (ask! peer-1 {:cmd :handle-descriptor} :handle-descriptor))\n   593\t                h-2 (await (ask! peer-2 {:cmd :handle-descriptor} :handle-descriptor))]\n   594\t            (testing \"each handle projects its own reachability and the shared identity\"\n   595\t              (is (not= (:descriptor h-1) (:descriptor h-2)))\n   596\t              (is (= identity (:identity h-1)))\n   597\t              (is (= identity (:identity h-2))\n   598\t                  \"an attached handle projected an identity the served stream never minted\"))\n   599\t\n   600\t            (testing \"cursors compare identity, never a descriptor\"\n   601\t              ;; One cursor on the served stream is valid for the logical\n   602\t              ;; stream both endpoints serve; neither descriptor participates.\n   603\t              ;; The cursor carries the same identity the descriptors do, which\n   604\t              ;; is what makes that comparison possible without either\n   605\t              ;; descriptor.\n   606\t              (let [minted (stream/cursor source stream/anchor-newest)]\n   607\t                (is (= :dao.stream/ok (:dao.stream/outcome minted)))\n   608\t                (is (= identity (:dao.stream.ringbuffer/identity (:dao.stream/cursor minted)))\n   609\t                    \"the cursor's identity disagrees with the served descriptors'\")\n   610\t                (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source :slice/both))))\n   611\t                (is (= :slice/both (:dao.stream/value\n   612\t                                     (stream/next source (:dao.stream/cursor minted)))))))\n   613\t\n   614\t            (testing \"both endpoints serve the same logical stream\"\n   615\t              (is (some? (await (await-event peer-1 #(= :slice/both (:ws/value %))\n   616\t                                             \"the first endpoint's attachment received nothing\"))))\n   617\t              (is (some? (await (await-event peer-2 #(= :slice/both (:ws/value %))\n   618\t                                             \"the second endpoint's attachment received nothing\")))))))))))\n\n--- JVM analogous helpers/tests ---\n   240\t;; =============================================================================\n   241\t\n   242\t\n   243\t\n   244\t(defn- pump!\n   245\t  [reader on-line]\n   246\t  (doto (Thread.\n   247\t          (fn []\n   248\t            (try\n   249\t              (loop []\n   250\t                (when-let [line (.readLine ^java.io.BufferedReader reader)]\n   251\t                  (on-line line)\n   252\t                  (recur)))\n   253\t              (catch Exception _ nil))))\n   254\t    (.setDaemon true)\n   255\t    (.start)))\n   256\t\n   257\t\n   258\t(defn- start-peer!\n   259\t  \"Spawn process B on this process's own classpath.\n   260\t\n   261\t   Reusing the live classpath rather than shelling out to a fresh `clojure`\n   262\t   invocation keeps the child's startup to a JVM boot instead of a dependency\n   263\t   resolution, and guarantees B runs the same tree A does.\"\n   264\t  [descriptor]\n   265\t  (let [command [\"java\" \"-cp\" (System/getProperty \"java.class.path\")\n   266\t                 \"clojure.main\" \"-m\" \"dao.stream.slice-peer\"\n   267\t                 (transit/encode-descriptor descriptor)]\n   268\t        process (.start (ProcessBuilder. ^java.util.List command))\n   269\t        replies (atom [])\n   270\t        errors (atom [])\n   271\t        peer {:process process\n   272\t              :in (io/writer (.getOutputStream process))\n   273\t              :replies replies\n   274\t              :errors errors\n   275\t              :seen (atom [])}]\n   276\t    ;; Loading B's namespaces prints to B's stdout before the peer protocol\n   277\t    ;; starts, so a line that is not a Transit reply is noise rather than a\n   278\t    ;; protocol failure: recording it and carrying on keeps one banner from\n   279\t    ;; silently killing the reader and making every fact look unmet.\n   280\t    (pump! (io/reader (.getInputStream process))\n   281\t           (fn [line]\n   282\t             (let [reply (try (transit/decode line) (catch Exception _ nil))]\n   283\t               (if (:reply reply)\n   284\t                 (swap! replies conj reply)\n   285\t                 (swap! errors conj line)))))\n   286\t    ;; stderr must be drained too: an unread pipe fills and would block the\n   287\t    ;; child mid-report, which would look exactly like a failed assertion.\n   288\t    (pump! (io/reader (.getErrorStream process))\n   289\t           (fn [line] (swap! errors conj line)))\n   290\t    peer))\n   291\t\n   292\t\n   293\t(defn- stop-peer!\n   294\t  [peer]\n   295\t  (try (.destroy ^Process (:process peer)) (catch Exception _ nil)))\n   296\t\n   297\t\n   298\t(defn- take-reply!\n   299\t  \"Consume the first reply of `kind`, or nil at the deadline.\"\n   300\t  [peer kind timeout-ms]\n   301\t  (let [deadline (+ (System/currentTimeMillis) timeout-ms)]\n   302\t    (loop []\n   303\t      (let [index (first (keep-indexed (fn [i r] (when (= kind (:reply r)) i))\n   304\t                                       @(:replies peer)))]\n   305\t        (cond\n   306\t          index (let [reply (nth @(:replies peer) index)]\n   307\t                  (swap! (:replies peer)\n   308\t                         (fn [rs] (vec (concat (subvec rs 0 index) (subvec rs (inc index))))))\n   309\t                  reply)\n   310\t          (< deadline (System/currentTimeMillis)) nil\n   311\t          :else (do (Thread/sleep 5) (recur)))))))\n   312\t\n   313\t\n   314\t(defn- ask!\n   315\t  [peer command kind timeout-ms]\n   316\t  (let [writer ^java.io.Writer (:in peer)]\n   317\t    (.write writer (str (transit/encode command) \"\\n\"))\n   318\t    (.flush writer))\n   319\t  (take-reply! peer kind timeout-ms))\n   320\t\n   321\t\n   322\t(defn- poll-events!\n   323\t  \"Ask B for whatever its medium has accumulated since B last reported, and\n   324\t   remember it.  B advances only its own kept cursor; A never touches it.\"\n   325\t  [peer]\n   326\t  (swap! (:seen peer) into (:events (ask! peer {:cmd :events} :events reply-ms)))\n   327\t  @(:seen peer))\n   328\t\n   329\t\n   330\t(defn- await-event\n   331\t  [peer pred timeout-ms]\n   332\t  (let [deadline (+ (System/currentTimeMillis) timeout-ms)]\n   333\t    (loop []\n   334\t      (if-let [hit (first (filter pred (poll-events! peer)))]\n   335\t        hit\n   336\t        (when-not (< deadline (System/currentTimeMillis))\n   337\t          (Thread/sleep 20)\n   338\t          (recur))))))\n   339\t\n   340\t\n   341\t(defn- attach-peer!\n   342\t  \"Spawn B, wait for its bootstrap, attach, and wait for the opened event.\"\n   343\t  [descriptor]\n   344\t  (let [peer (start-peer! descriptor)\n   345\t        ready (take-reply! peer :ready peer-ready-ms)]\n   346\t    (is (some? ready)\n   347\t        (str \"process B never reported its bootstrap; its other output was \"\n   348\t             (pr-str @(:errors peer))))\n   349\t    (is (= descriptor (:descriptor ready))\n   350\t        \"the descriptor B decoded from text differs from the one A encoded\")\n   351\t    (let [attach (ask! peer {:cmd :attach} :attach reply-ms)]\n   352\t      (is (= :dao.stream/ok (:outcome attach)))\n   353\t      (is (some? (await-event peer #(= :ws/opened (:ws/event %)) event-ms))\n   354\t          \"the attachment never opened\")\n   355\t      (assoc peer :attachment (:attachment attach)))))\n   356\t\n   357\t\n   358\t(defn- server-attachment\n   359\t  \"Correlate B to the server-side session it joined by the token it appended.\n   360\t   The two sides mint their own attachment identities, so nothing but a\n   361\t   payload can connect them — which is itself worth asserting.\"\n   362\t  [endpoint token]\n   363\t  (let [deadline (+ (System/currentTimeMillis) event-ms)]\n   364\t    (loop []\n   365\t      (let [hit (first (filter (fn [[_ medium]]\n   366\t                                 (some #(= token (:ws/value %)) (drain medium)))\n   367\t                               @(:media endpoint)))]\n   368\t        (cond\n   369\t          hit (first hit)\n   370\t          (< deadline (System/currentTimeMillis)) nil\n   371\t          :else (do (Thread/sleep 20) (recur)))))))\n   372\t\n   373\t\n   374\t;; =============================================================================\n   375\t;; Fixture\n   376\t;; =============================================================================\n   377\t\n   378\t(use-fixtures :once\n   379\t  (fn [run]\n   380\t    (reset! process-a (start-process-a!))\n   381\t    (try (run)\n   382\t         (finally\n   383\t           (stop-process-a! @process-a)\n   384\t           (reset! process-a nil)))))\n   385\t\n   386\t\n   387\t;; =============================================================================\n   388\t;; The five facts\n   389\t;; =============================================================================\n   390\t\n   391\t(deftest detachment-is-observable-on-both-sides\n   392\t  ;; Fact 1.\n   393\t  (let [{:keys [source primary]} @process-a\n   394\t        peer (attach-peer! (reachable primary))]\n   395\t    (try\n   396\t      (is (= :dao.stream/ok (:outcome (ask! peer {:cmd :append :value :slice/established}\n   397\t                                            :append reply-ms)))\n   398\t          \"an established attachment must accept an outbound append\")\n   399\t      (let [token [:slice/fact-1 (:attachment peer)]]\n   400\t        (is (= :dao.stream/ok (:outcome (ask! peer {:cmd :append :value token}\n   401\t                                              :append reply-ms))))\n   402\t        (let [attachment (server-attachment primary token)]\n   403\t          (is (some? attachment) \"A never received B's outbound payload\")\n   404\t\n   405\t          ;; Kill the connection from B's side.\n   406\t          (is (= :dao.stream/ok (:outcome (ask! peer {:cmd :close} :close reply-ms))))\n   407\t\n   408\t          (testing \"B's handle answers closed\"\n   409\t            (is (= :dao.stream/closed\n   410\t                   (:outcome (ask! peer {:cmd :append :value :after-close}\n   411\t                                   :append reply-ms))))\n   412\t            (let [departure (await-event peer #(= :ws/closed (:ws/event %)) event-ms)]\n   413\t              (is (some? departure)\n   414\t                  \"B's own medium never received the terminal event\")\n   415\t              (is (= (:attachment peer) (:ws/attachment departure))\n   416\t                  \"B's terminal event was not attributed to its attachment\")))\n   417\t\n   418\t          (testing \"A's boundary deposits the departure\"\n   419\t            (let [events (await-terminal primary attachment)\n   420\t                  departure (terminal-event events)]\n   421\t              (is (= :ws/closed (:ws/event (last events)))\n   422\t                  \"A's per-attachment medium never deposited the departure\")\n   423\t              (is (= attachment (:ws/attachment departure))\n   424\t                  \"A's terminal event was not attributed to its session\"))\n   425\t            (is (not (contains? (:sessions (serving/state (:composition primary)))\n   426\t                                attachment))\n   427\t                \"the driver kept a session for a departed attachment\"))\n   428\t\n   429\t          (testing \"the served stream is untouched by a connection's death\"\n   430\t            (is (= :dao.stream/ok (:dao.stream/outcome\n   431\t                                    (stream/append! source :slice/still-alive)))))))\n   432\t      (finally (stop-peer! peer)))))\n   433\t\n   434\t\n   435\t(deftest the-same-descriptor-rejoins-the-same-logical-stream\n   436\t  ;; Fact 2.  The peer from fact 1 is gone; this one attaches, is killed, and\n   437\t  ;; reattaches with the identical bootstrapped descriptor value.\n   438\t  (let [{:keys [source primary]} @process-a\n   439\t        peer (attach-peer! (reachable primary))]\n   440\t    (try\n   441\t      (is (= :dao.stream/ok (:outcome (ask! peer {:cmd :close} :close reply-ms))))\n   442\t      (is (some? (await-event peer #(= :ws/closed (:ws/event %)) event-ms)))\n   443\t      (let [again (ask! peer {:cmd :attach} :attach reply-ms)]\n   444\t        (is (= :dao.stream/ok (:outcome again))\n   445\t            \"reattachment with the same descriptor was refused\")\n   446\t        (is (not= (:attachment peer) (:attachment again))\n   447\t            \"a reattachment is a new attachment, not a resurrected one\")\n   448\t        (is (some? (await-event peer (fn [event]\n   449\t                                       (and (= :ws/opened (:ws/event event))\n   450\t                                            (= (:attachment again) (:ws/attachment event))))\n   451\t                                event-ms)))\n   452\t        (let [token [:slice/fact-2 (:attachment again)]]\n   453\t          ;; A appends to the surviving logical stream; the rejoined\n   454\t          ;; attachment receives it, which is what \"same logical stream\" means\n   455\t          ;; operationally.\n   456\t          (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source token))))\n   457\t          (is (some? (await-event peer #(= token (:ws/value %)) event-ms))\n   458\t              \"the rejoined attachment received nothing from the served stream\")))\n   459\t      (finally (stop-peer! peer)))))\n   460\t\n   461\t\n   462\t(deftest simultaneous-attachments-carry-distinct-attachment-identity\n   463\t  ;; Fact 3.  Two whole processes, so nothing but the wire could make their\n   464\t  ;; identities agree by accident.\n   465\t  (let [{:keys [source primary]} @process-a\n   466\t        descriptor (reachable primary)\n   467\t        peer-1 (attach-peer! descriptor)\n   468\t        peer-2 (attach-peer! descriptor)]\n   469\t    (try\n   470\t      (is (string? (:attachment peer-1)))\n   471\t      (is (string? (:attachment peer-2)))\n   472\t      (is (not= (:attachment peer-1) (:attachment peer-2))\n   473\t          \"two simultaneous attachments shared one attachment identity\")\n   474\t\n   475\t      (let [token-1 [:slice/fact-3 (:attachment peer-1)]\n   476\t            token-2 [:slice/fact-3 (:attachment peer-2)]]\n   477\t        (ask! peer-1 {:cmd :append :value token-1} :append reply-ms)\n   478\t        (ask! peer-2 {:cmd :append :value token-2} :append reply-ms)\n   479\t        (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source :slice/fanout))))\n   480\t        (await-event peer-1 #(= :slice/fanout (:ws/value %)) event-ms)\n   481\t        (await-event peer-2 #(= :slice/fanout (:ws/value %)) event-ms)\n   482\t\n   483\t        (let [a-1 (server-attachment primary token-1)\n   484\t              a-2 (server-attachment primary token-2)]\n   485\t          (is (some? a-1))\n   486\t          (is (some? a-2))\n   487\t          (is (not= a-1 a-2)\n   488\t              \"two connections were folded into one server-side attachment\")\n   489\t\n   490\t          ;; Close both before asserting attribution.  Correlation checked\n   491\t          ;; while the attachments are live sees only resolution and payload\n   492\t          ;; events; the terminal ones would arrive later, during teardown,\n   493\t          ;; unobserved.  An implementation that emitted a wrong or missing\n   494\t          ;; `:ws/attachment` exactly on `:ws/closed` would pass such a check.\n   495\t          (doseq [peer [peer-1 peer-2]]\n   496\t            (is (= :dao.stream/ok (:outcome (ask! peer {:cmd :close} :close reply-ms)))))\n   497\t\n   498\t          (testing \"every event on a client medium carries that client's identity\"\n   499\t            (doseq [peer [peer-1 peer-2]]\n   500\t              (is (some? (await-event peer #(= :ws/closed (:ws/event %)) event-ms))\n   501\t                  \"a client medium never received its terminal event\")\n   502\t              (let [events @(:seen peer)\n   503\t                    terminal (terminal-event events)]\n   504\t                (is (seq events))\n   505\t                ;; Resolution, payload, and lifecycle alike.\n   506\t                (is (every? #(= (:attachment peer) (:ws/attachment %)) events)\n   507\t                    \"an event on B's medium was attributed to another attachment\")\n   508\t                (is (some? terminal))\n   509\t                (is (= (:attachment peer) (:ws/attachment terminal))\n   510\t                    \"B's terminal event was not attributed to its attachment\"))))\n   511\t\n   512\t          (testing \"every event on a server medium carries that session's identity\"\n   513\t            (doseq [attachment [a-1 a-2]]\n   514\t              (let [events (await-terminal primary attachment)\n   515\t                    terminal (terminal-event events)]\n   516\t                (is (seq events))\n   517\t                (is (some? terminal)\n   518\t                    \"a server medium never deposited its terminal event\")\n   519\t                ;; Payload and lifecycle alike.\n   520\t                (is (every? #(= attachment (:ws/attachment %)) events))\n   521\t                (is (= attachment (:ws/attachment terminal))\n   522\t                    \"A's terminal event was not attributed to its session\"))))))\n   523\t      (finally\n   524\t        (stop-peer! peer-1)\n   525\t        (stop-peer! peer-2)))))\n   526\t\n   527\t\n   528\t(deftest the-deposit-medium-outlives-the-socket\n   529\t  ;; Fact 4.  The cursor is B's, on B's medium; it is never handed to\n   530\t  ;; `attach!` and never used through the WebSocket handle.\n   531\t  (let [{:keys [source primary]} @process-a\n   532\t        peer (attach-peer! (reachable primary))]\n   533\t    (try\n   534\t      (is (= #{:writer :closable} (:value (ask! peer {:cmd :surfaces} :surfaces reply-ms)))\n   535\t          \"the ws handle must have no reader surface for this fact to mean anything\")\n   536\t\n   537\t      (let [token [:slice/fact-4 (:attachment peer)]]\n   538\t        (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source token))))\n   539\t        (is (some? (await-event peer #(= token (:ws/value %)) event-ms))))\n   540\t\n   541\t      ;; The socket dies.  B's medium and B's position on it do not.\n   542\t      (is (= :dao.stream/ok (:outcome (ask! peer {:cmd :close} :close reply-ms))))\n   543\t      (is (some? (await-event peer #(= :ws/closed (:ws/event %)) event-ms))\n   544\t          \"the kept cursor did not resume across the socket's death\")\n   545\t\n   546\t      (testing \"the cursor resumed rather than restarted\"\n   547\t        ;; Every event B has reported came from one uninterrupted walk of one\n   548\t        ;; cursor: an opened, a payload, and exactly one terminal event, in\n   549\t        ;; order and without repetition.\n   550\t        (let [events @(:seen peer)]\n   551\t          (is (= [:ws/opened :ws/payload :ws/closed] (mapv :ws/event events)))\n   552\t          (is (apply distinct? events))))\n   553\t      (finally (stop-peer! peer)))))\n   554\t\n   555\t\n   556\t(deftest two-endpoints-differ-in-reachability-and-agree-on-identity\n   557\t  ;; Fact 5.\n   558\t  (let [{:keys [source primary secondary]} @process-a\n   559\t        projection (stream/descriptor source)\n   560\t        identity (:dao.stream/identity projection)\n   561\t        d-1 (reachable primary)\n   562\t        d-2 (reachable secondary)]\n   563\t    (is (not= d-1 d-2) \"two endpoints produced the same descriptor\")\n   564\t    (is (not= (select-keys d-1 [:ws/host :ws/port :ws/path])\n   565\t              (select-keys d-2 [:ws/host :ws/port :ws/path]))\n   566\t        \"the two endpoints are not separately reachable\")\n   567\t\n   568\t    (testing \"the served descriptors carry the ring buffer's own identity\"\n   569\t      ;; Not a constant this test chose: the value the served stream mints.\n   570\t      (is (= :dao.stream/ok (:dao.stream/outcome projection)))\n   571\t      (is (string? identity))\n   572\t      (is (= identity (:dao.stream/identity (:dao.stream/descriptor projection)))\n   573\t          \"the sibling identity disagrees with the one inside the envelope\")\n   574\t      (is (= identity (:dao.stream/identity d-1)))\n   575\t      (is (= identity (:dao.stream/identity d-2))\n   576\t          \"one logical stream served twice must carry one identity\"))\n   577\t\n   578\t    (let [peer-1 (attach-peer! d-1)\n   579\t          peer-2 (attach-peer! d-2)]\n   580\t      (try\n   581\t        (testing \"each handle projects its own reachability and the shared identity\"\n   582\t          (let [h-1 (ask! peer-1 {:cmd :handle-descriptor} :handle-descriptor reply-ms)\n   583\t                h-2 (ask! peer-2 {:cmd :handle-descriptor} :handle-descriptor reply-ms)]\n   584\t            (is (not= (:descriptor h-1) (:descriptor h-2)))\n   585\t            (is (= identity (:identity h-1)))\n   586\t            (is (= identity (:identity h-2))\n   587\t                \"an attached handle projected an identity the served stream never minted\")))\n   588\t\n   589\t        (testing \"cursors compare identity, never a descriptor\"\n   590\t          ;; One cursor on the served stream is valid for the logical stream\n   591\t          ;; both endpoints serve; neither descriptor participates.  The cursor\n   592\t          ;; carries the same identity the descriptors do, which is what makes\n   593\t          ;; that comparison possible without either descriptor.\n   594\t          (let [minted (stream/cursor source stream/anchor-newest)]\n   595\t            (is (= :dao.stream/ok (:dao.stream/outcome minted)))\n   596\t            (is (= identity (:dao.stream.ringbuffer/identity (:dao.stream/cursor minted)))\n   597\t                \"the cursor's identity disagrees with the served descriptors'\")\n   598\t            (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source :slice/both))))\n   599\t            (is (= :slice/both (:dao.stream/value\n   600\t                                 (stream/next source (:dao.stream/cursor minted)))))))\n   601\t\n   602\t        (testing \"both endpoints serve the same logical stream\"\n   603\t          (is (some? (await-event peer-1 #(= :slice/both (:ws/value %)) event-ms)))\n   604\t          (is (some? (await-event peer-2 #(= :slice/both (:ws/value %)) event-ms))))\n   605\t        (finally\n   606\t          (stop-peer! peer-1)\n   607\t          (stop-peer! peer-2))))))\n\n--- Node analogous helpers/tests ---\n   230\t    (.setEncoding ^js readable \"utf8\")\n   231\t    (.on ^js readable \"data\"\n   232\t         (fn [chunk]\n   233\t           (let [parts (str/split (str @pending chunk) #\"\\n\" -1)]\n   234\t             (reset! pending (last parts))\n   235\t             (doseq [line (butlast parts)\n   236\t                     :when (not (str/blank? line))]\n   237\t               (on-line line)))))))\n   238\t\n   239\t\n   240\t(defn- start-peer!\n   241\t  [descriptor]\n   242\t  (let [process (.spawn child-process \"node\"\n   243\t                        #js [peer-script (transit/encode-descriptor descriptor)]\n   244\t                        #js {:stdio #js [\"pipe\" \"pipe\" \"pipe\"]})\n   245\t        replies (atom [])\n   246\t        errors (atom [])]\n   247\t    ;; Loading B's namespaces may print to B's stdout before the peer protocol\n   248\t    ;; starts, so a line that is not a Transit reply is noise rather than a\n   249\t    ;; protocol failure: recording it and carrying on keeps one banner from\n   250\t    ;; silently stopping the reader.\n   251\t    (line-reader (.-stdout process)\n   252\t                 (fn [line]\n   253\t                   (let [reply (try (transit/decode line) (catch :default _ nil))]\n   254\t                     (if (:reply reply)\n   255\t                       (swap! replies conj reply)\n   256\t                       (swap! errors conj line)))))\n   257\t    (line-reader (.-stderr process) (fn [line] (swap! errors conj line)))\n   258\t    {:process process :replies replies :errors errors :seen (atom [])}))\n   259\t\n   260\t\n   261\t(defn- stop-peer!\n   262\t  [peer]\n   263\t  (try (.kill ^js (:process peer)) (catch :default _ nil)))\n   264\t\n   265\t\n   266\t(defn- take-reply!\n   267\t  \"Consume the first reply of `kind`.\"\n   268\t  [peer kind]\n   269\t  (poll-until\n   270\t    (fn []\n   271\t      (when-let [index (first (keep-indexed (fn [i r] (when (= kind (:reply r)) i))\n   272\t                                            @(:replies peer)))]\n   273\t        (let [reply (nth @(:replies peer) index)]\n   274\t          (swap! (:replies peer)\n   275\t                 (fn [rs] (vec (concat (subvec rs 0 index) (subvec rs (inc index))))))\n   276\t          reply)))\n   277\t    reply-ms\n   278\t    (str \"process B never replied \" kind \"; its other output was \"\n   279\t         (pr-str @(:errors peer)))))\n   280\t\n   281\t\n   282\t(defn- ask!\n   283\t  [peer command kind]\n   284\t  (.write ^js (.-stdin ^js (:process peer)) (str (transit/encode command) \"\\n\"))\n   285\t  (take-reply! peer kind))\n   286\t\n   287\t\n   288\t(defn- poll-events!\n   289\t  \"Ask B for whatever its medium has accumulated since B last reported, and\n   290\t   remember it.  B advances only its own kept cursor; A never touches it.\"\n   291\t  [peer]\n   292\t  (.then (ask! peer {:cmd :events} :events)\n   293\t         (fn [reply]\n   294\t           (swap! (:seen peer) into (:events reply))\n   295\t           @(:seen peer))))\n   296\t\n   297\t\n   298\t(defn- await-event\n   299\t  [peer pred message]\n   300\t  (let [deadline (+ (js/Date.now) event-ms)]\n   301\t    (js/Promise.\n   302\t      (fn [resolve reject]\n   303\t        (letfn [(tick\n   304\t                  []\n   305\t                  (.then (poll-events! peer)\n   306\t                         (fn [seen]\n   307\t                           (if-let [hit (first (filter pred seen))]\n   308\t                             (resolve hit)\n   309\t                             (if (< deadline (js/Date.now))\n   310\t                               (reject (js/Error. message))\n   311\t                               (js/setTimeout tick 20))))\n   312\t                         reject))]\n   313\t          (tick))))))\n   314\t\n   315\t\n   316\t(defn- attach-peer!\n   317\t  \"Spawn B, wait for its bootstrap, attach, and wait for the opened event.\"\n   318\t  [peers descriptor]\n   319\t  (let [peer (start-peer! descriptor)]\n   320\t    (swap! peers conj peer)\n   321\t    (-> (take-reply! peer :ready)\n   322\t        (.then (fn [ready]\n   323\t                 (is (= descriptor (:descriptor ready))\n   324\t                     \"the descriptor B decoded from text differs from the one A encoded\")\n   325\t                 (ask! peer {:cmd :attach} :attach)))\n   326\t        (.then (fn [attach]\n   327\t                 (is (= :dao.stream/ok (:outcome attach)))\n   328\t                 (.then (await-event peer #(= :ws/opened (:ws/event %))\n   329\t                                     \"the attachment never opened\")\n   330\t                        (fn [_] (assoc peer :attachment (:attachment attach)))))))))\n   331\t\n   332\t\n   333\t(defn- server-attachment\n   334\t  \"Correlate B to the server-side session it joined by the token it appended.\n   335\t   The two sides mint their own attachment identities, so nothing but a\n   336\t   payload can connect them — which is itself worth asserting.\"\n   337\t  [endpoint token]\n   338\t  (poll-until\n   339\t    (fn []\n   340\t      (first (first (filter (fn [[_ medium]]\n   341\t                              (some #(= token (:ws/value %)) (drain medium)))\n   342\t                            @(:media endpoint)))))\n   343\t    event-ms\n   344\t    \"A never received B's outbound payload\"))\n   345\t\n   346\t\n   347\t(defn- run-slice\n   348\t  \"Start process A, run one fact, then tear everything down exactly once.\"\n   349\t  [done body]\n   350\t  (let [fixture (server-fixture)\n   351\t        peers (atom [])]\n   352\t    (serving/start! (:composition (:primary fixture)))\n   353\t    (serving/start! (:composition (:secondary fixture)))\n   354\t    (let [ticker (js/setInterval\n   355\t                   (fn []\n   356\t                     (let [now (js/Date.now)]\n   357\t                       (serving/step! (:composition (:primary fixture)) now)\n   358\t                       (serving/step! (:composition (:secondary fixture)) now)))\n   359\t                   5)\n   360\t          teardown (fn []\n   361\t                     (js/clearInterval ticker)\n   362\t                     (doseq [peer @peers] (stop-peer! peer))\n   363\t                     (serving/stop! (:composition (:primary fixture)))\n   364\t                     (serving/stop! (:composition (:secondary fixture))))]\n   365\t      (-> (poll-until #(and (node/listener-port @(:listener (:primary fixture)))\n   366\t                            (node/listener-port @(:listener (:secondary fixture))))\n   367\t                      bind-ms\n   368\t                      \"the listeners never reported bound ports\")\n   369\t          (.then (fn [_] (body fixture peers)))\n   370\t          (.then (fn [_] nil)\n   371\t                 (fn [error] (is false (str \"slice failure: \" (.-message ^js error)))))\n   372\t          (.then (fn [_] (teardown) (done)))))))\n   373\t\n   374\t\n   375\t;; =============================================================================\n   376\t;; The five facts\n   377\t;; =============================================================================\n   378\t\n   379\t(deftest detachment-is-observable-on-both-sides\n   380\t  ;; Fact 1.\n   381\t  (async done\n   382\t         (run-slice\n   383\t           done\n   384\t           (fn [{:keys [source primary]} peers]\n   385\t             (let [me (atom nil)\n   386\t                   token (atom nil)\n   387\t                   attachment (atom nil)]\n   388\t               (-> (attach-peer! peers (reachable primary))\n   389\t                   (.then (fn [peer]\n   390\t                            (reset! me peer)\n   391\t                            (reset! token [:slice/fact-1 (:attachment peer)])\n   392\t                            (ask! peer {:cmd :append :value :slice/established} :append)))\n   393\t                   (.then (fn [reply]\n   394\t                            (is (= :dao.stream/ok (:outcome reply))\n   395\t                                \"an established attachment must accept an outbound append\")\n   396\t                            (ask! @me {:cmd :append :value @token} :append)))\n   397\t                   (.then (fn [reply]\n   398\t                            (is (= :dao.stream/ok (:outcome reply)))\n   399\t                            (server-attachment primary @token)))\n   400\t                   (.then (fn [server-side]\n   401\t                            (reset! attachment server-side)\n   402\t                            ;; Kill the connection from B's side.\n   403\t                            (ask! @me {:cmd :close} :close)))\n   404\t                   (.then (fn [reply]\n   405\t                            (is (= :dao.stream/ok (:outcome reply)))\n   406\t                            (ask! @me {:cmd :append :value :after-close} :append)))\n   407\t                   (.then (fn [reply]\n   408\t                            (testing \"B's handle answers closed\"\n   409\t                              (is (= :dao.stream/closed (:outcome reply))))\n   410\t                            (await-event @me #(= :ws/closed (:ws/event %))\n   411\t                                         \"B's own medium never received the terminal event\")))\n   412\t                   (.then (fn [departure]\n   413\t                            (is (= (:attachment @me) (:ws/attachment departure))\n   414\t                                \"B's terminal event was not attributed to its attachment\")\n   415\t                            (await-terminal primary @attachment)))\n   416\t                   (.then (fn [events]\n   417\t                            (testing \"A's boundary deposits the departure\"\n   418\t                              (is (= :ws/closed (:ws/event (last events)))\n   419\t                                  \"A's per-attachment medium never deposited the departure\")\n   420\t                              (is (= @attachment (:ws/attachment (terminal-event events)))\n   421\t                                  \"A's terminal event was not attributed to its session\")\n   422\t                              (is (not (contains? (:sessions (serving/state (:composition primary)))\n   423\t                                                  @attachment))\n   424\t                                  \"the driver kept a session for a departed attachment\"))\n   425\t                            (testing \"the served stream is untouched by a connection's death\"\n   426\t                              (is (= :dao.stream/ok (:dao.stream/outcome\n   427\t                                                      (stream/append! source :slice/still-alive)))))))))))))\n   428\t\n   429\t\n   430\t(deftest the-same-descriptor-rejoins-the-same-logical-stream\n   431\t  ;; Fact 2.\n   432\t  (async done\n   433\t         (run-slice\n   434\t           done\n   435\t           (fn [{:keys [source primary]} peers]\n   436\t             (let [me (atom nil)\n   437\t                   first-attachment (atom nil)\n   438\t                   again (atom nil)\n   439\t                   token (atom nil)]\n   440\t               (-> (attach-peer! peers (reachable primary))\n   441\t                   (.then (fn [peer]\n   442\t                            (reset! me peer)\n   443\t                            (reset! first-attachment (:attachment peer))\n   444\t                            (ask! peer {:cmd :close} :close)))\n   445\t                   (.then (fn [reply]\n   446\t                            (is (= :dao.stream/ok (:outcome reply)))\n   447\t                            (await-event @me #(= :ws/closed (:ws/event %))\n   448\t                                         \"the attachment never closed\")))\n   449\t                   ;; The identical bootstrapped descriptor value, reused verbatim.\n   450\t                   (.then (fn [_] (ask! @me {:cmd :attach} :attach)))\n   451\t                   (.then (fn [reply]\n   452\t                            (reset! again (:attachment reply))\n   453\t                            (is (= :dao.stream/ok (:outcome reply))\n   454\t                                \"reattachment with the same descriptor was refused\")\n   455\t                            (is (not= @first-attachment @again)\n   456\t                                \"a reattachment is a new attachment, not a resurrected one\")\n   457\t                            (await-event @me\n   458\t                                         (fn [event]\n   459\t                                           (and (= :ws/opened (:ws/event event))\n   460\t                                                (= @again (:ws/attachment event))))\n   461\t                                         \"the reattachment never opened\")))\n   462\t                   (.then (fn [_]\n   463\t                            (reset! token [:slice/fact-2 @again])\n   464\t                            ;; A appends to the surviving logical stream; the\n   465\t                            ;; rejoined attachment receives it, which is what \"same\n   466\t                            ;; logical stream\" means operationally.\n   467\t                            (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source @token))))\n   468\t                            (await-event @me #(= @token (:ws/value %))\n   469\t                                         \"the rejoined attachment received nothing from the served stream\")))\n   470\t                   (.then (fn [hit] (is (some? hit))))))))))\n   471\t\n   472\t\n   473\t(deftest simultaneous-attachments-carry-distinct-attachment-identity\n   474\t  ;; Fact 3.\n   475\t  (async done\n   476\t         (run-slice\n   477\t           done\n   478\t           (fn [{:keys [source primary]} peers]\n   479\t             (let [descriptor (reachable primary)\n   480\t                   one (atom nil)\n   481\t                   two (atom nil)\n   482\t                   server-sessions (atom nil)]\n   483\t               (-> (attach-peer! peers descriptor)\n   484\t                   (.then (fn [peer] (reset! one peer) (attach-peer! peers descriptor)))\n   485\t                   (.then (fn [peer]\n   486\t                            (reset! two peer)\n   487\t                            (is (string? (:attachment @one)))\n   488\t                            (is (string? (:attachment @two)))\n   489\t                            (is (not= (:attachment @one) (:attachment @two))\n   490\t                                \"two simultaneous attachments shared one attachment identity\")\n   491\t                            (ask! @one {:cmd :append :value [:slice/fact-3 (:attachment @one)]}\n   492\t                                  :append)))\n   493\t                   (.then (fn [_]\n   494\t                            (ask! @two {:cmd :append :value [:slice/fact-3 (:attachment @two)]}\n   495\t                                  :append)))\n   496\t                   (.then (fn [_]\n   497\t                            (is (= :dao.stream/ok (:dao.stream/outcome\n   498\t                                                    (stream/append! source :slice/fanout))))\n   499\t                            (await-event @one #(= :slice/fanout (:ws/value %))\n   500\t                                         \"the first attachment received nothing\")))\n   501\t                   (.then (fn [_]\n   502\t                            (await-event @two #(= :slice/fanout (:ws/value %))\n   503\t                                         \"the second attachment received nothing\")))\n   504\t                   (.then (fn [_]\n   505\t                            (js/Promise.all\n   506\t                              #js [(server-attachment primary [:slice/fact-3 (:attachment @one)])\n   507\t                                   (server-attachment primary [:slice/fact-3 (:attachment @two)])])))\n   508\t                   (.then (fn [sessions]\n   509\t                            (reset! server-sessions (vec sessions))\n   510\t                            (is (not= (first @server-sessions) (second @server-sessions))\n   511\t                                \"two connections were folded into one server-side attachment\")\n   512\t                            ;; Close both before asserting attribution.  Correlation\n   513\t                            ;; checked while the attachments are live sees only\n   514\t                            ;; resolution and payload events; the terminal ones would\n   515\t                            ;; arrive later, during teardown, unobserved.  An\n   516\t                            ;; implementation that emitted a wrong or missing\n   517\t                            ;; `:ws/attachment` exactly on `:ws/closed` would pass\n   518\t                            ;; such a check.\n   519\t                            (js/Promise.all\n   520\t                              #js [(ask! @one {:cmd :close} :close)\n   521\t                                   (ask! @two {:cmd :close} :close)])))\n   522\t                   (.then (fn [closes]\n   523\t                            (doseq [reply (vec closes)]\n   524\t                              (is (= :dao.stream/ok (:outcome reply))))\n   525\t                            (js/Promise.all\n   526\t                              #js [(await-event @one #(= :ws/closed (:ws/event %))\n   527\t                                                \"the first client medium never received its terminal event\")\n   528\t                                   (await-event @two #(= :ws/closed (:ws/event %))\n   529\t                                                \"the second client medium never received its terminal event\")])))\n   530\t                   (.then (fn [_]\n   531\t                            (testing \"every event on a client medium carries that client's identity\"\n   532\t                              (doseq [peer [@one @two]]\n   533\t                                (let [events @(:seen peer)\n   534\t                                      terminal (terminal-event events)]\n   535\t                                  (is (seq events))\n   536\t                                  ;; Resolution, payload, and lifecycle alike.\n   537\t                                  (is (every? #(= (:attachment peer) (:ws/attachment %)) events)\n   538\t                                      \"an event on B's medium was attributed to another attachment\")\n   539\t                                  (is (some? terminal))\n   540\t                                  (is (= (:attachment peer) (:ws/attachment terminal))\n   541\t                                      \"B's terminal event was not attributed to its attachment\"))))\n   542\t                            (js/Promise.all\n   543\t                              #js [(await-terminal primary (first @server-sessions))\n   544\t                                   (await-terminal primary (second @server-sessions))])))\n   545\t                   (.then (fn [histories]\n   546\t                            (testing \"every event on a server medium carries that session's identity\"\n   547\t                              (doseq [[attachment events] (map vector @server-sessions (vec histories))]\n   548\t                                (let [terminal (terminal-event events)]\n   549\t                                  (is (seq events))\n   550\t                                  (is (some? terminal)\n   551\t                                      \"a server medium never deposited its terminal event\")\n   552\t                                  ;; Payload and lifecycle alike.\n   553\t                                  (is (every? #(= attachment (:ws/attachment %)) events))\n   554\t                                  (is (= attachment (:ws/attachment terminal))\n   555\t                                      \"A's terminal event was not attributed to its session\"))))))))))))\n   556\t\n   557\t\n   558\t(deftest the-deposit-medium-outlives-the-socket\n   559\t  ;; Fact 4.  The cursor is B's, on B's medium; it is never handed to\n   560\t  ;; `attach!` and never used through the WebSocket handle.\n   561\t  (async done\n   562\t         (run-slice\n   563\t           done\n   564\t           (fn [{:keys [source primary]} peers]\n   565\t             (let [me (atom nil)\n   566\t                   token (atom nil)]\n   567\t               (-> (attach-peer! peers (reachable primary))\n   568\t                   (.then (fn [peer]\n   569\t                            (reset! me peer)\n   570\t                            (reset! token [:slice/fact-4 (:attachment peer)])\n   571\t                            (ask! peer {:cmd :surfaces} :surfaces)))\n   572\t                   (.then (fn [reply]\n   573\t                            (is (= #{:writer :closable} (:value reply))\n   574\t                                \"the ws handle must have no reader surface for this fact to mean anything\")\n   575\t                            (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source @token))))\n   576\t                            (await-event @me #(= @token (:ws/value %))\n   577\t                                         \"the payload never arrived\")))\n   578\t                   ;; The socket dies.  B's medium and B's position on it do not.\n   579\t                   (.then (fn [_] (ask! @me {:cmd :close} :close)))\n   580\t                   (.then (fn [reply]\n   581\t                            (is (= :dao.stream/ok (:outcome reply)))\n   582\t                            (await-event @me #(= :ws/closed (:ws/event %))\n   583\t                                         \"the kept cursor did not resume across the socket's death\")))\n   584\t                   (.then (fn [_]\n   585\t                            (testing \"the cursor resumed rather than restarted\"\n   586\t                              ;; Every event B has reported came from one\n   587\t                              ;; uninterrupted walk of one cursor: an opened, a\n   588\t                              ;; payload, and exactly one terminal event, in order\n   589\t                              ;; and without repetition.\n   590\t                              (let [events @(:seen @me)]\n   591\t                                (is (= [:ws/opened :ws/payload :ws/closed] (mapv :ws/event events)))\n   592\t                                (is (apply distinct? events))))))))))))\n   593\t\n   594\t\n   595\t(deftest two-endpoints-differ-in-reachability-and-agree-on-identity\n   596\t  ;; Fact 5.\n   597\t  (async done\n   598\t         (run-slice\n   599\t           done\n   600\t           (fn [{:keys [source primary secondary]} peers]\n   601\t             (let [projection (stream/descriptor source)\n   602\t                   identity (:dao.stream/identity projection)\n   603\t                   d-1 (reachable primary)\n   604\t                   d-2 (reachable secondary)\n   605\t                   one (atom nil)\n   606\t                   two (atom nil)]\n   607\t               (is (not= d-1 d-2) \"two endpoints produced the same descriptor\")\n   608\t               (is (not= (select-keys d-1 [:ws/host :ws/port :ws/path])\n   609\t                         (select-keys d-2 [:ws/host :ws/port :ws/path]))\n   610\t                   \"the two endpoints are not separately reachable\")\n   611\t               (testing \"the served descriptors carry the ring buffer's own identity\"\n   612\t                 ;; Not a constant this test chose: the value the served stream mints.\n   613\t                 (is (= :dao.stream/ok (:dao.stream/outcome projection)))\n   614\t                 (is (string? identity))\n   615\t                 (is (= identity (:dao.stream/identity (:dao.stream/descriptor projection)))\n   616\t                     \"the sibling identity disagrees with the one inside the envelope\")\n   617\t                 (is (= identity (:dao.stream/identity d-1)))\n   618\t                 (is (= identity (:dao.stream/identity d-2))\n   619\t                     \"one logical stream served twice must carry one identity\"))\n   620\t               (-> (attach-peer! peers d-1)\n   621\t                   (.then (fn [peer] (reset! one peer) (attach-peer! peers d-2)))\n   622\t                   (.then (fn [peer]\n   623\t                            (reset! two peer)\n   624\t                            (ask! @one {:cmd :handle-descriptor} :handle-descriptor)))\n   625\t                   (.then (fn [h-1]\n   626\t                            (.then (ask! @two {:cmd :handle-descriptor} :handle-descriptor)\n   627\t                                   (fn [h-2]\n   628\t                                     (testing \"each handle projects its own reachability and the shared identity\"\n   629\t                                       (is (not= (:descriptor h-1)