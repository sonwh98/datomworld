   301\\t    (js/Promise.\\n   302\\t      (fn [resolve reject]\\n   303\\t        (letfn [(tick\\n   304\\t                  []\\n   305\\t                  (.then (poll-events! peer)\\n   306\\t                         (fn [seen]\\n   307\\t                           (if-let [hit (first (filter pred seen))]\\n   308\\t                             (resolve hit)\\n   309\\t                             (if (< deadline (js/Date.now))\\n   310\\t                               (reject (js/Error. message))\\n   311\\t                               (js/setTimeout tick 20))))\\n   312\\t                         reject))]\\n   313\\t          (tick))))))\\n   314\\t\\n   315\\t\\n   316\\t(defn- attach-peer!\\n   317\\t  \\\"Spawn B, wait for its bootstrap, attach, and wait for the opened event.\\\"\\n   318\\t  [peers descriptor]\\n   319\\t  (let [peer (start-peer! descriptor)]\\n   320\\t    (swap! peers conj peer)\\n   321\\t    (-> (take-reply! peer :ready)\\n   322\\t        (.then (fn [ready]\\n   323\\t                 (is (= descriptor (:descriptor ready))\\n   324\\t                     \\\"the descriptor B decoded from text differs from the one A encoded\\\")\\n   325\\t                 (ask! peer {:cmd :attach} :attach)))\\n   326\\t        (.then (fn [attach]\\n   327\\t                 (is (= :dao.stream/ok (:outcome attach)))\\n   328\\t                 (.then (await-event peer #(= :ws/opened (:ws/event %))\\n   329\\t                                     \\\"the attachment never opened\\\")\\n   330\\t                        (fn [_] (assoc peer :attachment (:attachment attach)))))))))\\n   331\\t\\n   332\\t\\n   333\\t(defn- server-attachment\\n   334\\t  \\\"Correlate B to the server-side session it joined by the token it appended.\\n   335\\t   The two sides mint their own attachment identities, so nothing but a\\n   336\\t   payload can connect them — which is itself worth asserting.\\\"\\n   337\\t  [endpoint token]\\n   338\\t  (poll-until\\n   339\\t    (fn []\\n   340\\t      (first (first (filter (fn [[_ medium]]\\n   341\\t                              (some #(= token (:ws/value %)) (drain medium)))\\n   342\\t                            @(:media endpoint)))))\\n   343\\t    event-ms\\n   344\\t    \\\"A never received B's outbound payload\\\"))\\n   345\\t\\n   346\\t\\n   347\\t(defn- run-slice\\n   348\\t  \\\"Start process A, run one fact, then tear everything down exactly once.\\\"\\n   349\\t  [done body]\\n   350\\t  (let [fixture (server-fixture)\\n   351\\t        peers (atom [])]\\n   352\\t    (serving/start! (:composition (:primary fixture)))\\n   353\\t    (serving/start! (:composition (:secondary fixture)))\\n   354\\t    (let [ticker (js/setInterval\\n   355\\t                   (fn []\\n   356\\t                     (let [now (js/Date.now)]\\n   357\\t                       (serving/step! (:composition (:primary fixture)) now)\\n   358\\t                       (serving/step! (:composition (:secondary fixture)) now)))\\n   359\\t                   5)\\n   360\\t          teardown (fn []\\n   361\\t                     (js/clearInterval ticker)\\n   362\\t                     (doseq [peer @peers] (stop-peer! peer))\\n   363\\t                     (serving/stop! (:composition (:primary fixture)))\\n   364\\t                     (serving/stop! (:composition (:secondary fixture))))]\\n   365\\t      (-> (poll-until #(and (node/listener-port @(:listener (:primary fixture)))\\n   366\\t                            (node/listener-port @(:listener (:secondary fixture))))\\n   367\\t                      bind-ms\\n   368\\t                      \\\"the listeners never reported bound ports\\\")\\n   369\\t          (.then (fn [_] (body fixture peers)))\\n   370\\t          (.then (fn [_] nil)\\n   371\\t                 (fn [error] (is false (str \\\"slice failure: \\\" (.-message ^js error)))))\\n   372\\t          (.then (fn [_] (teardown) (done)))))))\\n   373\\t\\n   374\\t\\n   375\\t;; =============================================================================\\n   376\\t;; The five facts\\n   377\\t;; =============================================================================\\n   378\\t\\n   379\\t(deftest detachment-is-observable-on-both-sides\\n   380\\t  ;; Fact 1.\\n   381\\t  (async done\\n   382\\t         (run-slice\\n   383\\t           done\\n   384\\t           (fn [{:keys [source primary]} peers]\\n   385\\t             (let [me (atom nil)\\n   386\\t                   token (atom nil)\\n   387\\t                   attachment (atom nil)]\\n   388\\t               (-> (attach-peer! peers (reachable primary))\\n   389\\t                   (.then (fn [peer]\\n   390\\t                            (reset! me peer)\\n   391\\t                            (reset! token [:slice/fact-1 (:attachment peer)])\\n   392\\t                            (ask! peer {:cmd :append :value :slice/established} :append)))\\n   393\\t                   (.then (fn [reply]\\n   394\\t                            (is (= :dao.stream/ok (:outcome reply))\\n   395\\t                                \\\"an established attachment must accept an outbound append\\\")\\n   396\\t                            (ask! @me {:cmd :append :value @token} :append)))\\n   397\\t                   (.then (fn [reply]\\n   398\\t                            (is (= :dao.stream/ok (:outcome reply)))\\n   399\\t                            (server-attachment primary @token)))\\n   400\\t                   (.then (fn [server-side]\\n   401\\t                            (reset! attachment server-side)\\n   402\\t                            ;; Kill the connection from B's side.\\n   403\\t                            (ask! @me {:cmd :close} :close)))\\n   404\\t                   (.then (fn [reply]\\n   405\\t                            (is (= :dao.stream/ok (:outcome reply)))\\n   406\\t                            (ask! @me {:cmd :append :value :after-close} :append)))\\n   407\\t                   (.then (fn [reply]\\n   408\\t                            (testing \\\"B's handle answers closed\\\"\\n   409\\t                              (is (= :dao.stream/closed (:outcome reply))))\\n   410\\t                            (await-event @me #(= :ws/closed (:ws/event %))\\n   411\\t                                         \\\"B's own medium never received the terminal event\\\")))\\n   412\\t                   (.then (fn [departure]\\n   413\\t                            (is (= (:attachment @me) (:ws/attachment departure))\\n   414\\t                                \\\"B's terminal event was not attributed to its attachment\\\")\\n   415\\t                            (await-terminal primary @attachment)))\\n   416\\t                   (.then (fn [events]\\n   417\\t                            (testing \\\"A's boundary deposits the departure\\\"\\n   418\\t                              (is (= :ws/closed (:ws/event (last events)))\\n   419\\t                                  \\\"A's per-attachment medium never deposited the departure\\\")\\n   420\\t                              (is (= @attachment (:ws/attachment (terminal-event events)))\\n   421\\t                                  \\\"A's terminal event was not attributed to its session\\\")\\n   422\\t                              (is (not (contains? (:sessions (serving/state (:composition primary)))\\n   423\\t                                                  @attachment))\\n   424\\t                                  \\\"the driver kept a session for a departed attachment\\\"))\\n   425\\t                            (testing \\\"the served stream is untouched by a connection's death\\\"\\n   426\\t                              (is (= :dao.stream/ok (:dao.stream/outcome\\n   427\\t                                                      (stream/append! source :slice/still-alive)))))))))))))\\n   428\\t\\n   429\\t\\n   430\\t(deftest the-same-descriptor-rejoins-the-same-logical-stream\\n   431\\t  ;; Fact 2.\\n   432\\t  (async done\\n   433\\t         (run-slice\\n   434\\t           done\\n   435\\t           (fn [{:keys [source primary]} peers]\\n   436\\t             (let [me (atom nil)\\n   437\\t                   first-attachment (atom nil)\\n   438\\t                   again (atom nil)\\n   439\\t                   token (atom nil)]\\n   440\\t               (-> (attach-peer! peers (reachable primary))\\n   441\\t                   (.then (fn [peer]\\n   442\\t                            (reset! me peer)\\n   443\\t                            (reset! first-attachment (:attachment peer))\\n   444\\t                            (ask! peer {:cmd :close} :close)))\\n   445\\t                   (.then (fn [reply]\\n   446\\t                            (is (= :dao.stream/ok (:outcome reply)))\\n   447\\t                            (await-event @me #(= :ws/closed (:ws/event %))\\n   448\\t                                         \\\"the attachment never closed\\\")))\\n   449\\t                   ;; The identical bootstrapped descriptor value, reused verbatim.\\n   450\\t                   (.then (fn [_] (ask! @me {:cmd :attach} :attach)))\\n   451\\t                   (.then (fn [reply]\\n   452\\t                            (reset! again (:attachment reply))\\n   453\\t                            (is (= :dao.stream/ok (:outcome reply))\\n   454\\t                                \\\"reattachment with the same descriptor was refused\\\")\\n   455\\t                            (is (not= @first-attachment @again)\\n   456\\t                                \\\"a reattachment is a new attachment, not a resurrected one\\\")\\n   457\\t                            (await-event @me\\n   458\\t                                         (fn [event]\\n   459\\t                                           (and (= :ws/opened (:ws/event event))\\n   460\\t                                                (= @again (:ws/attachment event))))\\n   461\\t                                         \\\"the reattachment never opened\\\")))\\n   462\\t                   (.then (fn [_]\\n   463\\t                            (reset! token [:slice/fact-2 @again])\\n   464\\t                            ;; A appends to the surviving logical stream; the\\n   465\\t                            ;; rejoined attachment receives it, which is what \\\"same\\n   466\\t                            ;; logical stream\\\" means operationally.\\n   467\\t                            (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! source @token))))\\n   468\\t                            (await-event @me #(= @token (:ws/value %))\\n   469\\t                                         \\\"the rejoined attachment received nothing from the served stream\\\")))\\n   470\\t                   (.then (fn [hit] (is (some? hit))))))))))\\n   471\\t\\n   472\\t\\n   473\\t(deftest simultaneous-attachments-carry-distinct-attachment-identity\\n   474\\t  ;; Fact 3.\\n   475\\t  (async done\\n   476\\t         (run-slice\\n   477\\t           done\\n   478\\t           (fn [{:keys [source primary]} peers]\\n   479\\t             (let [descriptor (reachable primary)\\n   480\\t                   one (atom nil)\\n   481\\t                   two (atom nil)\\n   482\\t                   server-sessions (atom nil)]\\n   483\\t               (-> (attach-peer! peers descriptor)\\n   484\\t                   (.then (fn [peer] (reset! one peer) (attach-peer! peers descriptor)))\\n   485\\t                   (.then (fn [peer]\\n   486\\t                            (reset! two peer)\\n   487\\t                            (is (string? (:attachment @one)))\\n   488\\t                            (is (string? (:attachment @two)))\\n   489\\t                            (is (not= (:attachment @one) (:attachment @two))\\n   490\\t                                \\\"two simultaneous attachments shared one attachment identity\\\")\\n   491\\t                            (ask! @one {:cmd :append :value [:slice/fact-3 (:att