(apply distinct? events))))))))))))\\n   593\\t\\n   594\\t\\n   595\\t(deftest two-endpoints-differ-in-reachability-and-agree-on-identity\\n   596\\t  ;; Fact 5.\\n   597\\t  (async done\\n   598\\t         (run-slice\\n   599\\t           done\\n   600\\t           (fn [{:keys [source primary secondary]} peers]\\n   601\\t             (let [projection (stream/descriptor source)\\n   602\\t                   identity (:dao.stream/identity projection)\\n   603\\t                   d-1 (reachable primary)\\n   604\\t                   d-2 (reachable secondary)\\n   605\\t                   one (atom nil)\\n   606\\t                   two (atom nil)]\\n   607\\t               (is (not= d-1 d-2) \\\"two endpoints produced the same descriptor\\\")\\n   608\\t               (is (not= (select-keys d-1 [:ws/host :ws/port :ws/path])\\n   609\\t                         (select-keys d-2 [:ws/host :ws/port :ws/path]))\\n   610\\t                   \\\"the two endpoints are not separately reachable\\\")\\n   611\\t               (testing \\\"the served descriptors carry the ring buffer's own identity\\\"\\n   612\\t                 ;; Not a constant this test chose: the value the served stream mints.\\n   613\\t                 (is (= :dao.stream/ok (:dao.stream/outcome projection)))\\n   614\\t                 (is (string? identity))\\n   615\\t                 (is (= identity (:dao.stream/identity (:dao.stream/descriptor projection)))\\n   616\\t                     \\\"the sibling identity disagrees with the one inside the envelope\\\")\\n   617\\t                 (is (= identity (:dao.stream/identity d-1)))\\n   618\\t                 (is (= identity (:dao.stream/identity d-2))\\n   619\\t                     \\\"one logical stream served twice must carry one identity\\\"))\\n   620\\t               (-> (attach-peer! peers d-1)\\n   621\\t                   (.then (fn [peer] (reset! one peer) (attach-peer! peers d-2)))\\n   622\\t                   (.then (fn [peer]\\n   62