{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"defn qualified-keyword|qualified-keyword\\\\?\\\\*|open-map|unqualified\\\" src/cljc/dao/stream.cljc docs/design/dao.stream.md test/dao/stream/conformance.cljc; nl -ba src/cljc/dao/stream.cljc | sed -n '180,250p'; nl -ba test/dao/stream/conformance.cljc | sed -n '120,380p'\"","aggregated_output":"docs/design/dao.stream.md:194:example a wake token list on `append!`), which the open-map rule already\ndocs/design/dao.stream.md:287:  arrives as an addition, which the open-map rule and this section's own\nsrc/cljc/dao/stream.cljc:232:(defn qualified-keyword?*\nsrc/cljc/dao/stream.cljc:242:       (qualified-keyword?* (:dao.stream/outcome x))))\nsrc/cljc/dao/stream.cljc:289:       (qualified-keyword?* (:dao.stream/type envelope))))\ntest/dao/stream/conformance.cljc:61:    (when-not (v2/qualified-keyword?* ttype)\n   180\t(defprotocol IDaoStreamClosable\n   181\t  \"Closable surface: close what this handle is on (logical stream or attachment).\n   182\t   Idempotent.\"\n   183\t\n   184\t  (close!\n   185\t    [handle]\n   186\t    \"Closes what this handle is on. Irrevocable.\n   187\t     Returns outcome map {:dao.stream/outcome :dao.stream/ok}.\"))\n   188\t\n   189\t\n   190\t;; =============================================================================\n   191\t;; Surface Inspection & Gating\n   192\t;; =============================================================================\n   193\t\n   194\t(defn reader?\n   195\t  \"True if handle implements the reader surface (IDaoStreamReader).\"\n   196\t  [handle]\n   197\t  (satisfies? IDaoStreamReader handle))\n   198\t\n   199\t\n   200\t(defn writer?\n   201\t  \"True if handle implements the writer surface (IDaoStreamWriter).\"\n   202\t  [handle]\n   203\t  (satisfies? IDaoStreamWriter handle))\n   204\t\n   205\t\n   206\t(defn closable?\n   207\t  \"True if handle implements the closable surface (IDaoStreamClosable).\"\n   208\t  [handle]\n   209\t  (satisfies? IDaoStreamClosable handle))\n   210\t\n   211\t\n   212\t(defn descriptor?\n   213\t  \"True if handle implements IDaoStreamDescriptor.\"\n   214\t  [handle]\n   215\t  (satisfies? IDaoStreamDescriptor handle))\n   216\t\n   217\t\n   218\t(defn declared-surfaces\n   219\t  \"Returns set of public surfaces implemented by handle:\n   220\t   subset of #{:reader :writer :closable}.\"\n   221\t  [handle]\n   222\t  (cond-> #{}\n   223\t    (reader? handle) (conj :reader)\n   224\t    (writer? handle) (conj :writer)\n   225\t    (closable? handle) (conj :closable)))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; Result Convention & Envelope Validation\n   230\t;; =============================================================================\n   231\t\n   232\t(defn qualified-keyword?*\n   233\t  \"True if x is a qualified keyword. Portable across CLJ, CLJS, CLJD.\"\n   234\t  [x]\n   235\t  (boolean (and (keyword? x) (namespace x))))\n   236\t\n   237\t\n   238\t(defn outcome-map?\n   239\t  \"True if x is an open outcome map with a qualified keyword under :dao.stream/outcome.\"\n   240\t  [x]\n   241\t  (and (map? x)\n   242\t       (qualified-keyword?* (:dao.stream/outcome x))))\n   243\t\n   244\t\n   245\t(defn validate-outcome\n   246\t  \"Validates an operation outcome against contract requirements.\n   247\t   Returns nil if valid, or a failure map describing the defect if invalid.\"\n   248\t  [op result]\n   249\t  (if-let [canon-op (canonical-op op)]\n   250\t    (cond\n   120\t      {:valid? false :errors @errors})))\n   121\t\n   122\t\n   123\t;; =============================================================================\n   124\t;; Conformance Test Runner & Law Blocks\n   125\t;; =============================================================================\n   126\t\n   127\t(defn- run-induction-coverage\n   128\t  \"Asserts manifest induction:\n   129\t   1. For each declared outcome in :produces, the fixture induces it.\n   130\t   2. No observed outcome falls outside the declared :produces set.\n   131\t   3. Every produced result satisfies v2/valid-outcome?.\"\n   132\t  [manifest]\n   133\t  (let [violations (atom [])\n   134\t        fixtures (:fixtures manifest {})\n   135\t        ops-decl (:operations manifest {})]\n   136\t    (doseq [[op-key decl] ops-decl]\n   137\t      (let [canon-op (v2/canonical-op op-key)\n   138\t            produces (get decl :produces #{})\n   139\t            op-fixtures (get fixtures op-key {})]\n   140\t        (doseq [outcome produces]\n   141\t          (if-let [inducer (get op-fixtures outcome)]\n   142\t            (let [res (inducer)\n   143\t                  observed-outcome (:dao.stream/outcome res)]\n   144\t              ;; Check 1: Inducer actually produces the declared outcome\n   145\t              (when-not (= observed-outcome outcome)\n   146\t                (swap! violations conj {:check :induction-mismatch\n   147\t                                        :operation canon-op\n   148\t                                        :expected-outcome outcome\n   149\t                                        :observed-outcome observed-outcome\n   150\t                                        :result res}))\n   151\t              ;; Check 2: Result is not outside declared produces\n   152\t              (when-not (contains? produces observed-outcome)\n   153\t                (swap! violations conj {:check :undeclared-outcome-observed\n   154\t                                        :operation canon-op\n   155\t                                        :outcome observed-outcome\n   156\t                                        :allowed produces}))\n   157\t              ;; Check 3: Result map is valid (required keys present, open map)\n   158\t              (when-let [defect (v2/validate-outcome canon-op res)]\n   159\t                (swap! violations conj {:check :invalid-outcome-shape\n   160\t                                        :operation canon-op\n   161\t                                        :defect defect})))\n   162\t            (swap! violations conj {:check :missing-fixture-inducer\n   163\t                                    :operation canon-op\n   164\t                                    :outcome outcome})))))\n   165\t    @violations))\n   166\t\n   167\t\n   168\t(defn- run-descriptor-laws\n   169\t  \"Asserts descriptor projection laws on every handle:\n   170\t   - Handle satisfies IDaoStreamDescriptor regardless of surface.\n   171\t   - descriptor returns :dao.stream/ok.\n   172\t   - Sibling identity matches identity inside descriptor envelope.\n   173\t   - Descriptor envelope is valid.\"\n   174\t  [handle]\n   175\t  (let [violations (atom [])]\n   176\t    (if-not (v2/descriptor? handle)\n   177\t      (swap! violations conj {:check :handle-missing-descriptor-protocol})\n   178\t      (let [res (v2/descriptor handle)]\n   179\t        (when-not (= :dao.stream/ok (:dao.stream/outcome res))\n   180\t          (swap! violations conj {:check :descriptor-outcome-not-ok :result res}))\n   181\t        (when-not (v2/descriptor-identity-consistent? res)\n   182\t          (swap! violations conj {:check :descriptor-identity-inconsistent :result res}))))\n   183\t    @violations))\n   184\t\n   185\t\n   186\t(defn- run-reader-laws\n   187\t  \"Asserts reader laws on a handle with reader surface:\n   188\t   - Handle satisfies IDaoStreamReader.\n   189\t   - Anchors :dao.stream/oldest and :dao.stream/newest mint valid cursors.\n   190\t   - Non-destructive reading: two cursors reading same position observe same value.\n   191\t   - Next returns valid outcomes and successor cursors.\"\n   192\t  [handle]\n   193\t  (let [violations (atom [])]\n   194\t    (if-not (v2/reader? handle)\n   195\t      (swap! violations conj {:check :handle-missing-reader-protocol})\n   196\t      (do\n   197\t        ;; Mint oldest and newest\n   198\t        (let [r-oldest (v2/cursor handle :dao.stream/oldest)]\n   199\t          (when-not (and (= :dao.stream/ok (:dao.stream/outcome r-oldest))\n   200\t                         (contains? r-oldest :dao.stream/cursor))\n   201\t            (swap! violations conj {:check :cursor-oldest-failed :result r-oldest})))\n   202\t        (let [r-newest (v2/cursor handle :dao.stream/newest)]\n   203\t          (when-not (and (= :dao.stream/ok (:dao.stream/outcome r-newest))\n   204\t                         (contains? r-newest :dao.stream/cursor))\n   205\t            (swap! violations conj {:check :cursor-newest-failed :result r-newest})))\n   206\t        ;; Non-destructive read test if elements present\n   207\t        (let [invalid-anchor (v2/cursor handle ::invalid-anchor)\n   208\t              _ (when-not (= :dao.stream/invalid-anchor\n   209\t                             (:dao.stream/outcome invalid-anchor))\n   210\t                  (swap! violations conj {:check :invalid-anchor-not-rejected\n   211\t                                          :result invalid-anchor}))\n   212\t              c0 (:dao.stream/cursor (v2/cursor handle :dao.stream/oldest))\n   213\t              res1 (v2/next handle c0)\n   214\t              res2 (v2/next handle c0)]\n   215\t          (when-not (= res1 res2)\n   216\t            (swap! violations conj {:check :destructive-read-detected\n   217\t                                    :first-read res1\n   218\t                                    :second-read res2}))\n   219\t          ;; The only legal way for a contract consumer to advance is to feed\n   220\t          ;; a stream-minted successor (or gap recovery cursor) back to next.\n   221\t          ;; Do not inspect cursor shape: it belongs to the transport.\n   222\t          (when (contains? #{:dao.stream/ok :dao.stream/gap}\n   223\t                           (:dao.stream/outcome res1))\n   224\t            (let [successor (:dao.stream/cursor res1)\n   225\t                  follow-up (v2/next handle successor)]\n   226\t              (when-not (v2/valid-outcome? :next follow-up)\n   227\t                (swap! violations conj {:check :invalid-successor-or-recovery-cursor\n   228\t                                        :source res1 :follow-up follow-up})))))))\n   229\t    @violations))\n   230\t\n   231\t\n   232\t(defn- run-writer-laws\n   233\t  \"Asserts writer laws on a handle with writer surface:\n   234\t   - Handle satisfies IDaoStreamWriter.\n   235\t   - append! returns valid outcome.\"\n   236\t  [handle test-val]\n   237\t  (let [violations (atom [])]\n   238\t    (if-not (v2/writer? handle)\n   239\t      (swap! violations conj {:check :handle-missing-writer-protocol})\n   240\t      (let [res (v2/append! handle test-val)]\n   241\t        (when-not (v2/valid-outcome? :append! res)\n   242\t          (swap! violations conj {:check :invalid-append-outcome :result res}))))\n   243\t    @violations))\n   244\t\n   245\t\n   246\t(defn- run-close-laws\n   247\t  \"Asserts close laws on a handle with closable surface:\n   248\t   - Handle satisfies IDaoStreamClosable.\n   249\t   - close! returns :dao.stream/ok.\n   250\t   - close! is idempotent: subsequent close! returns :dao.stream/ok.\"\n   251\t  [handle]\n   252\t  (let [violations (atom [])]\n   253\t    (if-not (v2/closable? handle)\n   254\t      (swap! violations conj {:check :handle-missing-closable-protocol})\n   255\t      (let [res1 (v2/close! handle)\n   256\t            res2 (v2/close! handle)]\n   257\t        (when-not (= :dao.stream/ok (:dao.stream/outcome res1))\n   258\t          (swap! violations conj {:check :close-outcome-not-ok :result res1}))\n   259\t        (when-not (= :dao.stream/ok (:dao.stream/outcome res2))\n   260\t          (swap! violations conj {:check :close-idempotence-failed :result res2}))))\n   261\t    @violations))\n   262\t\n   263\t\n   264\t(defn run-conformance-suite\n   265\t  \"Executes the full declaration-driven conformance suite against manifest and optional handle.\n   266\t   Returns {:passed? true} or {:passed? false :failures [...]}.\"\n   267\t  ([manifest]\n   268\t   (run-conformance-suite manifest (when-let [hf (:handle-factory manifest)] (hf))))\n   269\t  ([manifest handle]\n   270\t   (let [failures (atom [])\n   271\t         manifest-res (validate-manifest manifest)\n   272\t         ;; Each destructive law block gets a fresh transport instance.  The\n   273\t         ;; manifest factory is the transport's responsibility; the supplied\n   274\t         ;; handle remains a compatibility fallback for older callers.\n   275\t         fresh-handle (fn []\n   276\t                        (if-let [factory (:handle-factory manifest)]\n   277\t                          (factory)\n   278\t                          handle))]\n   279\t     (if-not (:valid? manifest-res)\n   280\t       {:passed? false :failures (:errors manifest-res)}\n   281\t       (do\n   282\t         ;; 1. Induction & exhaustiveness check\n   283\t         (let [ind-v (run-induction-coverage manifest)]\n   284\t           (when (seq ind-v)\n   285\t             (swap! failures concat ind-v)))\n   286\t\n   287\t         ;; 2. Descriptor identity laws (always checked)\n   288\t         (when (fresh-handle)\n   289\t           (let [desc-v (run-descriptor-laws (fresh-handle))]\n   290\t             (when (seq desc-v)\n   291\t               (swap! failures concat desc-v)))\n   292\t\n   293\t           ;; 3. Reader laws (only if reader declared)\n   294\t           (when (contains? (:surfaces manifest) :reader)\n   295\t             (let [r-v (run-reader-laws (fresh-handle))]\n   296\t               (when (seq r-v)\n   297\t                 (swap! failures concat r-v))))\n   298\t\n   299\t           ;; 4. Writer laws (only if writer declared)\n   300\t           (when (contains? (:surfaces manifest) :writer)\n   301\t             (let [w-v (run-writer-laws (fresh-handle) ::conformance-token)]\n   302\t               (when (seq w-v)\n   303\t                 (swap! failures concat w-v))))\n   304\t\n   305\t           ;; 5. Close laws (only if closable declared)\n   306\t           (when (contains? (:surfaces manifest) :closable)\n   307\t             (let [c-v (run-close-laws (fresh-handle))]\n   308\t               (when (seq c-v)\n   309\t                 (swap! failures concat c-v)))))\n   310\t\n   311\t         (if (empty? @failures)\n   312\t           {:passed? true}\n   313\t           {:passed? false :failures @failures}))))))\n   314\t\n   315\t\n   316\t;; =============================================================================\n   317\t;; Concurrency Oracle (Bounded Offline Linearizability Checker)\n   318\t;; =============================================================================\n   319\t\n   320\t(defn record-op!\n   321\t  \"Helper to record an operation invocation interval into a history atom.\n   322\t   Returns the result of executing (f).\"\n   323\t  [history-atom clock-atom op args f]\n   324\t  (let [start (swap! clock-atom inc)\n   325\t        result (f)\n   326\t        finish (swap! clock-atom inc)]\n   327\t    (swap! history-atom conj {:id (count @history-atom)\n   328\t                              :op op\n   329\t                              :args args\n   330\t                              :result result\n   331\t                              :start start\n   332\t                              :end finish})\n   333\t    result))\n   334\t\n   335\t\n   336\t(defn- happens-before?\n   337\t  \"True if op A completed before op B was invoked (A ≺ B).\"\n   338\t  [op-a op-b]\n   339\t  (< (:end op-a) (:start op-b)))\n   340\t\n   341\t\n   342\t(defn- legal-next-ops\n   343\t  \"Given remaining operations to schedule and already scheduled operations,\n   344\t   returns operations from remaining that have no un-scheduled predecessors\n   345\t   in the happens-before partial order.\"\n   346\t  [remaining scheduled]\n   347\t  (filter (fn [candidate]\n   348\t            (not-any? (fn [other]\n   349\t                        (and (not (contains? scheduled other))\n   350\t                             (happens-before? other candidate)))\n   351\t                      remaining))\n   352\t          remaining))\n   353\t\n   354\t\n   355\t(defn check-linearizability\n   356\t  \"Offline bounded linearizability checker.\n   357\t   history: vector of {:id .. :op .. :args .. :result .. :start .. :end ..}\n   358\t   initial-model: abstract sequential state\n   359\t   step-fn: (fn [model-state op args result]) -> next-state or nil if invalid transition.\n   360\t\n   361\t   Returns {:linearizable? true :linearization [...]} if a valid sequential\n   362\t   interleaving respecting happens-before exists, or {:linearizable? false}.\"\n   363\t  [history initial-model step-fn]\n   364\t  (let [total (count history)]\n   365\t    (letfn [(search\n   366\t              [current-model remaining scheduled-set acc]\n   367\t              (if (empty? remaining)\n   368\t                {:linearizable? true :linearization acc}\n   369\t                (let [candidates (legal-next-ops remaining scheduled-set)]\n   370\t                  (loop [cands candidates]\n   371\t                    (if (empty? cands)\n   372\t                      nil\n   373\t                      (let [candidate (first cands)\n   374\t                            next-model (step-fn current-model\n   375\t                                                (:op candidate)\n   376\t                                                (:args candidate)\n   377\t                                                (:result candidate))]\n   378\t                        (if next-model\n   379\t                          (let [sub (search next-model\n   380\t                                            (disj remaining candidate)\n","exit_code":0,"status":"completed"}}
