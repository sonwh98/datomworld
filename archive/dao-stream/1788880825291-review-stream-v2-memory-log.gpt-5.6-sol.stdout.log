{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream.cljc | sed -n '280,390p'; nl -ba test//dao/stream_test.cljc | sed -n '305,440p'\"","aggregated_output":"   280\t  [op result]\n   281\t  (nil? (validate-outcome op result)))\n   282\t\n   283\t\n   284\t(defn valid-envelope?\n   285\t  \"Generic envelope validation: envelope must be a map with a qualified keyword\n   286\t   under :dao.stream/type. Everything else is transport-owned.\"\n   287\t  [envelope]\n   288\t  (and (map? envelope)\n   289\t       (qualified-keyword?* (:dao.stream/type envelope))))\n   290\t\n   291\t\n   292\t(defn valid-creation-spec?\n   293\t  \"True if spec is a generically valid creation specification envelope:\n   294\t   must be a map with a qualified keyword under :dao.stream/type.\"\n   295\t  [spec]\n   296\t  (valid-envelope? spec))\n   297\t\n   298\t\n   299\t(defn valid-descriptor?\n   300\t  \"True if descriptor is a generically valid portable descriptor envelope:\n   301\t   must be a valid envelope (:dao.stream/type present and qualified)\n   302\t   and carry :dao.stream/identity.\"\n   303\t  [descriptor]\n   304\t  (and (valid-envelope? descriptor)\n   305\t       (contains? descriptor :dao.stream/identity)))\n   306\t\n   307\t\n   308\t(defn descriptor-identity-consistent?\n   309\t  \"True if a descriptor operation result is {:dao.stream/outcome :dao.stream/ok ...}\n   310\t   where both :dao.stream/descriptor and :dao.stream/identity are present,\n   311\t   descriptor is a valid descriptor envelope, and the sibling :dao.stream/identity\n   312\t   projection structurally equals the identity inside the descriptor envelope.\"\n   313\t  [result]\n   314\t  (and (map? result)\n   315\t       (= :dao.stream/ok (:dao.stream/outcome result))\n   316\t       (contains? result :dao.stream/descriptor)\n   317\t       (contains? result :dao.stream/identity)\n   318\t       (let [sibling-id (:dao.stream/identity result)\n   319\t             desc (:dao.stream/descriptor result)]\n   320\t         (and (some? sibling-id)\n   321\t              (valid-descriptor? desc)\n   322\t              (= sibling-id (:dao.stream/identity desc))))))\n   323\t\n   324\t\n   325\t;; =============================================================================\n   326\t;; Open Result Map Constructors\n   327\t;; =============================================================================\n   328\t\n   329\t(defn ok-result\n   330\t  \"Convenience constructor for an open :dao.stream/ok outcome map.\"\n   331\t  ([]\n   332\t   {:dao.stream/outcome :dao.stream/ok})\n   333\t  ([extra-map]\n   334\t   (assoc extra-map :dao.stream/outcome :dao.stream/ok)))\n   335\t\n   336\t\n   337\t(defn outcome-result\n   338\t  \"Convenience constructor for an open outcome map.\"\n   339\t  ([outcome]\n   340\t   {:dao.stream/outcome outcome})\n   341\t  ([outcome extra-map]\n   342\t   (assoc extra-map :dao.stream/outcome outcome)))\n   343\t\n   344\t\n   345\t;; =============================================================================\n   346\t;; Transport Entry Functions & Host Dispatch\n   347\t;; =============================================================================\n   348\t;;\n   349\t;; Two transport entry functions: create! and attach!\n   350\t;; These take no handle because none exists yet. These are per-transport functions,\n   351\t;; host-composed, taking whatever composition state the transport needs.\n   352\t;;\n   353\t;; Putting create! or attach! on a protocol is how the retired registry grows back;\n   354\t;; DaoStream v2 ships no dispatch machinery (no multimethod, no registry,\n   355\t;; no load-time side effect).\n   356\t;;\n   357\t;; Dynamic dispatch on :dao.stream/type is performed by the host using an ordinary\n   358\t;; host-owned lookup table:\n   359\t;;\n   360\t;;   {:dao.stream/ringbuffer {:dao.stream/create ringbuffer/create!\n   361\t;;                            :dao.stream/attach ringbuffer/attach!}\n   362\t;;    :dao.stream/ws         {:dao.stream/attach ws/attach!}}\n   363\t;;\n   364\t;; The helper functions below provide transparent, purely functional host dispatch.\n   365\t\n   366\t(defn host-dispatch-create!\n   367\t  \"Host dispatch helper: looks up :dao.stream/create in dispatch-table\n   368\t   for (:dao.stream/type creation-spec).\n   369\t   Returns :dao.stream/invalid-spec if spec is not a valid envelope.\n   370\t   Returns :dao.stream/not-found if transport or :dao.stream/create is absent.\n   371\t   Otherwise invokes the transport's create function.\"\n   372\t  [dispatch-table creation-spec]\n   373\t  (if-not (valid-creation-spec? creation-spec)\n   374\t    {:dao.stream/outcome :dao.stream/invalid-spec}\n   375\t    (if-let [create-fn (get-in dispatch-table [(:dao.stream/type creation-spec) :dao.stream/create])]\n   376\t      (create-fn creation-spec)\n   377\t      {:dao.stream/outcome :dao.stream/not-found})))\n   378\t\n   379\t\n   380\t(defn host-dispatch-attach!\n   381\t  \"Host dispatch helper: looks up :dao.stream/attach in dispatch-table\n   382\t   for (:dao.stream/type descriptor).\n   383\t   Returns :dao.stream/invalid-descriptor if descriptor is not a valid descriptor envelope.\n   384\t   Returns :dao.stream/not-found if transport or :dao.stream/attach is absent.\n   385\t   Otherwise invokes the transport's attach function.\"\n   386\t  [dispatch-table descriptor]\n   387\t  (if-not (valid-descriptor? descriptor)\n   388\t    {:dao.stream/outcome :dao.stream/invalid-descriptor}\n   389\t    (if-let [attach-fn (get-in dispatch-table [(:dao.stream/type descriptor) :dao.stream/attach])]\n   390\t      (attach-fn descriptor)\n   305\t          \"identity projection is strictly equal across endpoints\"))))\n   306\t\n   307\t\n   308\t(deftest generic-envelope-validation-test\n   309\t  (testing \"generic envelope validation requires map with qualified keyword :dao.stream/type\"\n   310\t    (is (true? (v2/valid-envelope? {:dao.stream/type :ringbuffer/in-memory})))\n   311\t    (is (true? (v2/valid-envelope? {:dao.stream/type :dao.stream/ringbuffer\n   312\t                                    :ringbuffer/capacity 1024})))\n   313\t    (is (false? (v2/valid-envelope? {:dao.stream/type :unqualified})))\n   314\t    (is (false? (v2/valid-envelope? {:dao.stream/type \"string-type\"})))\n   315\t    (is (false? (v2/valid-envelope? {:type :ringbuffer/in-memory})))\n   316\t    (is (false? (v2/valid-envelope? nil)))\n   317\t    (is (false? (v2/valid-envelope? [:dao.stream/type :ringbuffer/in-memory]))))\n   318\t\n   319\t  (testing \"creation specification validation\"\n   320\t    (is (true? (v2/valid-creation-spec? {:dao.stream/type :stream/ref, :ref/bound 10})))\n   321\t    (is (false? (v2/valid-creation-spec? {:unqualified :kw}))))\n   322\t\n   323\t  (testing \"portable descriptor validation requires :dao.stream/identity\"\n   324\t    (is (true? (v2/valid-descriptor? {:dao.stream/type :ws/stream\n   325\t                                      :dao.stream/identity \"stream-123\"})))\n   326\t    (is (false? (v2/valid-descriptor? {:dao.stream/type :ws/stream}))\n   327\t        \"missing identity is not a valid descriptor\")\n   328\t    (is (false? (v2/valid-descriptor? {:dao.stream/identity \"stream-123\"}))\n   329\t        \"missing :dao.stream/type is not a valid descriptor\")))\n   330\t\n   331\t\n   332\t(deftest surface-gating-test\n   333\t  (let [stream-id \"gating-stream\"\n   334\t        data-atom (atom [])\n   335\t        closed-atom (atom false)\n   336\t        reader-handle (->MockReaderOnly stream-id data-atom)\n   337\t        writer-handle (->MockWriterOnly stream-id data-atom)\n   338\t        closable-handle (->MockClosableOnly stream-id closed-atom)\n   339\t        full-handle (->MockFullHandle stream-id data-atom closed-atom)]\n   340\t\n   341\t    (testing \"surface predicate inspection\"\n   342\t      (is (true? (v2/reader? reader-handle)))\n   343\t      (is (false? (v2/writer? reader-handle)))\n   344\t      (is (false? (v2/closable? reader-handle)))\n   345\t      (is (true? (v2/descriptor? reader-handle)))\n   346\t      (is (= #{:reader} (v2/declared-surfaces reader-handle)))\n   347\t\n   348\t      (is (false? (v2/reader? writer-handle)))\n   349\t      (is (true? (v2/writer? writer-handle)))\n   350\t      (is (false? (v2/closable? writer-handle)))\n   351\t      (is (true? (v2/descriptor? writer-handle)))\n   352\t      (is (= #{:writer} (v2/declared-surfaces writer-handle)))\n   353\t\n   354\t      (is (false? (v2/reader? closable-handle)))\n   355\t      (is (false? (v2/writer? closable-handle)))\n   356\t      (is (true? (v2/closable? closable-handle)))\n   357\t      (is (true? (v2/descriptor? closable-handle)))\n   358\t      (is (= #{:closable} (v2/declared-surfaces closable-handle)))\n   359\t\n   360\t      (is (true? (v2/reader? full-handle)))\n   361\t      (is (true? (v2/writer? full-handle)))\n   362\t      (is (true? (v2/closable? full-handle)))\n   363\t      (is (true? (v2/descriptor? full-handle)))\n   364\t      (is (= #{:reader :writer :closable} (v2/declared-surfaces full-handle))))\n   365\t\n   366\t    (testing \"descriptor is universal: callable on all handles regardless of surface\"\n   367\t      (is (= :dao.stream/ok (:dao.stream/outcome (v2/descriptor reader-handle))))\n   368\t      (is (= :dao.stream/ok (:dao.stream/outcome (v2/descriptor writer-handle))))\n   369\t      (is (= :dao.stream/ok (:dao.stream/outcome (v2/descriptor closable-handle))))\n   370\t      (is (= :dao.stream/ok (:dao.stream/outcome (v2/descriptor full-handle)))))\n   371\t\n   372\t    (testing \"invoking undeclared surface operations fails at protocol dispatch\"\n   373\t      ;; Calling writer operation on reader-only handle throws protocol exception\n   374\t      (is (thrown? #?(:clj IllegalArgumentException :cljs js/Error :cljd Object)\n   375\t            (v2/append! reader-handle :val)))\n   376\t\n   377\t      ;; Calling reader operation on writer-only handle throws protocol exception\n   378\t      (is (thrown? #?(:clj IllegalArgumentException :cljs js/Error :cljd Object)\n   379\t            (v2/next writer-handle {:position 0})))\n   380\t      (is (thrown? #?(:clj IllegalArgumentException :cljs js/Error :cljd Object)\n   381\t            (v2/cursor writer-handle :dao.stream/oldest)))\n   382\t\n   383\t      ;; Calling closable operation on reader-only handle throws protocol exception\n   384\t      (is (thrown? #?(:clj IllegalArgumentException :cljs js/Error :cljd Object)\n   385\t            (v2/close! reader-handle))))))\n   386\t\n   387\t\n   388\t(deftest host-dispatch-composition-test\n   389\t  (testing \"host dispatch is an ordinary host-composed map without ambient globals or registries\"\n   390\t    (let [created-handle :handle-created\n   391\t          attached-handle :handle-attached\n   392\t          dispatch-table {:test/ringbuffer\n   393\t                          {:dao.stream/create (fn [spec]\n   394\t                                                {:dao.stream/outcome :dao.stream/ok\n   395\t                                                 :dao.stream/handle created-handle\n   396\t                                                 :test/spec spec})\n   397\t                           :dao.stream/attach (fn [desc]\n   398\t                                                {:dao.stream/outcome :dao.stream/ok\n   399\t                                                 :dao.stream/handle attached-handle\n   400\t                                                 :test/desc desc})}\n   401\t                          :test/writer-only\n   402\t                          {:dao.stream/attach (fn [_desc]\n   403\t                                                {:dao.stream/outcome :dao.stream/ok\n   404\t                                                 :dao.stream/handle :writer-handle})}