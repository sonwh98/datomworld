{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/memory_log.cljc | sed -n '1,300p'; nl -ba test/dao/stream/memory_log_test.cljc | sed -n '1,255p'\"","aggregated_output":"     1\t(ns dao.stream.memory-log\n     2\t  \"In-memory, unbounded, append-only DaoStream v2 transport: the\n     3\t   complete-retention local log.  Process-lifetime, not durable across\n     4\t   restart — a restarted process sees a new, empty logical stream with a\n     5\t   new identity.  Durability is dao.jing's job, not this transport's.\n     6\t\n     7\t   Retention is complete, and the absence of eviction is structural:\n     8\t   state is one vector dense from position 0, and this namespace contains\n     9\t   no expression that removes an element.  `gap` is therefore excluded\n    10\t   (`:oldest` is position 0 for the life of the stream), as are `full`\n    11\t   (no capacity is declared; the transport is logically unbounded and\n    12\t   refuses nothing) and `transport-error` (each operation is one\n    13\t   in-memory state transition that either completes and returns or does\n    14\t   not return — the contract's line between observable exhaustion and\n    15\t   fatal host failure, which lies outside the outcome algebra).\n    16\t\n    17\t   There are no attachments: every handle is the logical stream's owner,\n    18\t   so `cursor` never answers `:dao.stream/closed` and keeps minting after\n    19\t   close, and `attach!` is absent rather than excluded.  Values are held\n    20\t   by reference and never encoded, so no value is uncarriable.\n    21\t\n    22\t   Creation specification: `{:dao.stream/type :dao.stream/memory-log}`.\n    23\t   The transport owns the `dao.stream.memory-log` namespace and declares\n    24\t   nothing in it, so any `:dao.stream.memory-log/…` key is rejected with\n    25\t   `:dao.stream/invalid-spec` — most importantly a capacity, which is the\n    26\t   knob this transport exists to make impossible.  Any other qualified\n    27\t   key is ignored per the open-map rule.\"\n    28\t  (:require [dao.stream :as stream]))\n    29\t\n    30\t\n    31\t(def transport-type :dao.stream/memory-log)\n    32\t\n    33\t(def ^:private own-namespace \"dao.stream.memory-log\")\n    34\t\n    35\t\n    36\t(defn- result\n    37\t  [outcome]\n    38\t  {:dao.stream/outcome outcome})\n    39\t\n    40\t\n    41\t(defn- own-namespace-key?\n    42\t  \"True if k is a keyword in this transport's own namespace.\"\n    43\t  [k]\n    44\t  (boolean (and (keyword? k) (= own-namespace (namespace k)))))\n    45\t\n    46\t\n    47\t(defn- valid-spec?\n    48\t  \"A map, typed as this transport, carrying no key of this transport's\n    49\t   own namespace: that namespace is owned and empty, so a key there names\n    50\t   a knob that does not exist.  Foreign qualified keys are ignored per\n    51\t   the open-map rule.\"\n    52\t  [spec]\n    53\t  (and (map? spec)\n    54\t       (= transport-type (:dao.stream/type spec))\n    55\t       (not-any? own-namespace-key? (keys spec))))\n    56\t\n    57\t\n    58\t(defn- fresh-state\n    59\t  []\n    60\t  ;; As in the ring buffer, the logical identity is plain data — it\n    61\t  ;; travels in descriptors and cursors — never a host UUID object.\n    62\t  ;; A vector, dense from 0: positions are never reused and never\n    63\t  ;; dropped, and the tail is (count values).\n    64\t  (atom {:identity (str (random-uuid))\n    65\t         :values []\n    66\t         :closed? false}))\n    67\t\n    68\t\n    69\t(deftype MemoryLogHandle\n    70\t  [state]\n    71\t\n    72\t  stream/IDaoStreamDescriptor\n    73\t\n    74\t  (descriptor\n    75\t    [_]\n    76\t    (let [s @state]\n    77\t      {:dao.stream/outcome :dao.stream/ok\n    78\t       :dao.stream/descriptor {:dao.stream/type transport-type\n    79\t                               :dao.stream/identity (:identity s)}\n    80\t       :dao.stream/identity (:identity s)}))\n    81\t\n    82\t\n    83\t  stream/IDaoStreamReader\n    84\t\n    85\t  (cursor\n    86\t    [_ anchor]\n    87\t    (let [s @state]\n    88\t      ;; Every handle is the logical stream's owner: there is no\n    89\t      ;; attachment to be closed, and an owner keeps minting cursors\n    90\t      ;; after close so retained history stays readable.\n    91\t      (case anchor\n    92\t        ;; Complete retention: :oldest is the origin, before the first\n    93\t        ;; append and after close alike.\n    94\t        :dao.stream/oldest\n    95\t        (assoc (result :dao.stream/ok)\n    96\t               :dao.stream/cursor\n    97\t               {:dao.stream.memory-log/identity (:identity s)\n    98\t                :dao.stream.memory-log/position 0})\n    99\t        :dao.stream/newest\n   100\t        (assoc (result :dao.stream/ok)\n   101\t               :dao.stream/cursor\n   102\t               {:dao.stream.memory-log/identity (:identity s)\n   103\t                :dao.stream.memory-log/position (count (:values s))})\n   104\t        (result :dao.stream/invalid-anchor))))\n   105\t\n   106\t\n   107\t  (next\n   108\t    [_ cursor-value]\n   109\t    ;; Total: the position is range-checked before any indexed read, so a\n   110\t    ;; fabricated negative position answers invalid-cursor instead of\n   111\t    ;; reaching nth and throwing on the JVM.  No cursor this stream can\n   112\t    ;; mint holds a position above the tail — positions never disappear\n   113\t    ;; and the tail never retreats — so an above-tail position is a\n   114\t    ;; fabrication, invalid like a negative one.\n   115\t    (let [s @state]\n   116\t      (cond\n   117\t        (not (map? cursor-value)) (result :dao.stream/invalid-cursor)\n   118\t        (not (contains? cursor-value :dao.stream.memory-log/identity))\n   119\t        (result :dao.stream/invalid-cursor)\n   120\t        (not= (:identity s) (:dao.stream.memory-log/identity cursor-value))\n   121\t        (result :dao.stream/cursor-mismatch)\n   122\t        (not (integer? (:dao.stream.memory-log/position cursor-value)))\n   123\t        (result :dao.stream/invalid-cursor)\n   124\t        :else\n   125\t        (let [pos (:dao.stream.memory-log/position cursor-value)\n   126\t              tail (count (:values s))]\n   127\t          (cond\n   128\t            (or (< pos 0) (> pos tail)) (result :dao.stream/invalid-cursor)\n   129\t            ;; Retention is complete: every position below the tail is\n   130\t            ;; retained for the life of the logical stream, so this read\n   131\t            ;; can never gap.\n   132\t            (< pos tail)\n   133\t            {:dao.stream/outcome :dao.stream/ok\n   134\t             :dao.stream/value (nth (:values s) pos)\n   135\t             :dao.stream/cursor {:dao.stream.memory-log/identity (:identity s)\n   136\t                                 :dao.stream.memory-log/position (inc pos)}}\n   137\t            (:closed? s) (result :dao.stream/end)\n   138\t            :else (result :dao.stream/blocked))))))\n   139\t\n   140\t\n   141\t  stream/IDaoStreamWriter\n   142\t\n   143\t  (append!\n   144\t    [_ value]\n   145\t    ;; The closed? check lives inside the one state transition: a deref\n   146\t    ;; before swap! would let an append that began before a close land\n   147\t    ;; after it.  Unbounded means conj is the whole write path — no\n   148\t    ;; capacity to consult, no refusal branch, nothing removed.\n   149\t    (let [out (volatile! nil)]\n   150\t      (swap! state\n   151\t             (fn [s]\n   152\t               (if (:closed? s)\n   153\t                 (do (vreset! out (result :dao.stream/closed)) s)\n   154\t                 (do (vreset! out (result :dao.stream/ok))\n   155\t                     (update s :values conj value)))))\n   156\t      @out))\n   157\t\n   158\t\n   159\t  stream/IDaoStreamClosable\n   160\t\n   161\t  (close!\n   162\t    [_]\n   163\t    ;; Owner close of the logical stream: future availability only.  The\n   164\t    ;; assoc erases nothing — retained history stays readable, :oldest\n   165\t    ;; stays at the origin, and reads at the tail answer end instead of\n   166\t    ;; blocked.\n   167\t    (swap! state assoc :closed? true)\n   168\t    (result :dao.stream/ok)))\n   169\t\n   170\t\n   171\t(defn create!\n   172\t  \"Create a memory log from a creation specification.\"\n   173\t  [spec]\n   174\t  (if-not (valid-spec? spec)\n   175\t    (result :dao.stream/invalid-spec)\n   176\t    (let [state (fresh-state)]\n   177\t      {:dao.stream/outcome :dao.stream/ok\n   178\t       :dao.stream/handle (MemoryLogHandle. state)\n   179\t       :dao.stream/identity (:identity @state)})))\n     1\t(ns dao.stream.memory-log-test\n     2\t  (:require [clojure.test :refer [deftest is testing]]\n     3\t            [dao.stream :as stream]\n     4\t            [dao.stream.conformance :as conformance]\n     5\t            [dao.stream.memory-log :as log]))\n     6\t\n     7\t\n     8\t(def spec\n     9\t  {:dao.stream/type log/transport-type})\n    10\t\n    11\t\n    12\t(defn handle\n    13\t  []\n    14\t  (:dao.stream/handle (log/create! spec)))\n    15\t\n    16\t\n    17\t(defn cur\n    18\t  [h a]\n    19\t  (:dao.stream/cursor (stream/cursor h a)))\n    20\t\n    21\t\n    22\t(def ^:private retained-values\n    23\t  \"Every other value is nil.  nil is a legitimate stream value here, and\n    24\t   a replay loop that treats it as end-of-input fails this suite's\n    25\t   exactness check at element zero.\"\n    26\t  (mapv #(when (odd? %) %) (range 1000)))\n    27\t\n    28\t\n    29\t(defn- replay\n    30\t  \"Follow a cursor to its terminus, bounded so a defect cannot hang the\n    31\t   suite.  Termination is the outcome, never the value: nil values are\n    32\t   conj'd like any other.\"\n    33\t  [h cursor limit]\n    34\t  (loop [c cursor n 0 vs [] seen #{}]\n    35\t    (if (> n limit)\n    36\t      {:values vs :terminal ::did-not-terminate :outcomes seen}\n    37\t      (let [r (stream/next h c)\n    38\t            o (:dao.stream/outcome r)]\n    39\t        (if (= o :dao.stream/ok)\n    40\t          (recur (:dao.stream/cursor r)\n    41\t                 (inc n)\n    42\t                 (conj vs (:dao.stream/value r))\n    43\t                 (conj seen o))\n    44\t          {:values vs :terminal o :outcomes (conj seen o)})))))\n    45\t\n    46\t\n    47\t(defn- replay-limit\n    48\t  []\n    49\t  (+ (count retained-values) 8))\n    50\t\n    51\t\n    52\t(deftest creation-spec-rule\n    53\t  (let [invalid-spec? #(= :dao.stream/invalid-spec\n    54\t                          (:dao.stream/outcome (log/create! %)))]\n    55\t    (testing \"rejections\"\n    56\t      (is (invalid-spec? nil) \"not a map\")\n    57\t      (is (invalid-spec? 42) \"not a map\")\n    58\t      (is (invalid-spec? {}) \"missing :dao.stream/type\")\n    59\t      (is (invalid-spec? {:dao.stream/type :dao.stream/ringbuffer})\n    60\t          \"wrong transport type\")\n    61\t      (is (invalid-spec? (assoc spec :dao.stream.memory-log/capacity 3))\n    62\t          \"a key in the transport's own namespace names a knob that does not exist\"))\n    63\t    (testing \"foreign qualified keys are ignored per the open-map rule\"\n    64\t      (is (= :dao.stream/ok\n    65\t             (:dao.stream/outcome\n    66\t               (log/create! (assoc spec :my.host/label \"x\"))))))))\n    67\t\n    68\t\n    69\t(deftest complete-retention\n    70\t  (let [h (handle)\n    71\t        ;; The origin cursor is minted BEFORE any append: on an evicting\n    72\t        ;; transport this is the only cursor that converts silent loss\n    73\t        ;; into a reported gap.  Here it must simply stay at the origin.\n    74\t        origin (cur h :dao.stream/oldest)\n    75\t        appends (mapv #(stream/append! h %) retained-values)]\n    76\t    (is (= #{:dao.stream/ok} (set (map :dao.stream/outcome appends)))\n    77\t        \"every append on the unbounded log is accepted\")\n    78\t    (is (= 1000 (count retained-values)))\n    79\t    (let [limit (replay-limit)\n    80\t          kept (replay h origin limit)\n    81\t          ;; A fresh :oldest is the origin on a complete-history\n    82\t          ;; transport, however late the consumer arrives.  The\n    83\t          ;; representation is ours, so structural equality is assertable\n    84\t          ;; here.\n    85\t          fresh-cursor (cur h :dao.stream/oldest)\n    86\t          fresh (replay h fresh-cursor limit)]\n    87\t      (is (= origin fresh-cursor)\n    88\t          \"a freshly minted :oldest is structurally the origin cursor\")\n    89\t      (is (= retained-values (:values kept))\n    90\t          \"the kept origin cursor replays the history exactly and in order\")\n    91\t      (is (= retained-values (:values fresh))\n    92\t          \"a fresh :oldest replays the whole history exactly and in order\")\n    93\t      (is (= :dao.stream/blocked (:terminal kept)) \"the open tail blocks\")\n    94\t      (is (= :dao.stream/blocked (:terminal fresh)))\n    95\t      (is (not (contains? (:outcomes kept) :dao.stream/gap)))\n    96\t      (is (not (contains? (:outcomes fresh) :dao.stream/gap))))\n    97\t    ;; Close changes future availability only: both replays still work,\n    98\t    ;; now terminating with end, and neither observes gap.\n    99\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/close! h))))\n   100\t    (let [limit (replay-limit)\n   101\t          kept (replay h origin limit)\n   102\t          fresh (replay h (cur h :dao.stream/oldest) limit)]\n   103\t      (is (= retained-values (:values kept)))\n   104\t      (is (= :dao.stream/end (:terminal kept)))\n   105\t      (is (not (contains? (:outcomes kept) :dao.stream/gap)))\n   106\t      (is (= retained-values (:values fresh)))\n   107\t      (is (= :dao.stream/end (:terminal fresh)))\n   108\t      (is (not (contains? (:outcomes fresh) :dao.stream/gap)))\n   109\t      (is (= :dao.stream/closed\n   110\t             (:dao.stream/outcome (stream/append! h :after)))))))\n   111\t\n   112\t\n   113\t(deftest next-is-total\n   114\t  ;; Every cursor below the fabricated ones is constructed by hand:\n   115\t  ;; consumers never fabricate cursor internals, but totality must hold\n   116\t  ;; anyway — a negative position reaching nth throws on the JVM rather\n   117\t  ;; than answering.  No host conditional: all three hosts run this.\n   118\t  (let [h (handle)\n   119\t        c (cur h :dao.stream/oldest)\n   120\t        id (:dao.stream.memory-log/identity c)\n   121\t        fabricate (fn [position]\n   122\t                    {:dao.stream.memory-log/identity id\n   123\t                     :dao.stream.memory-log/position position})\n   124\t        outcome (fn [cursor] (:dao.stream/outcome (stream/next h cursor)))\n   125\t        invalid-cursor? #(= :dao.stream/invalid-cursor %)]\n   126\t    (is (= :dao.stream/blocked (outcome c)) \"empty tail blocks before any append\")\n   127\t    (stream/append! h :only)\n   128\t    (testing \"not a cursor at all\"\n   129\t      (is (invalid-cursor? (outcome nil)))\n   130\t      (is (invalid-cursor? (outcome 42)))\n   131\t      (is (invalid-cursor? (outcome \"cursor\"))))\n   132\t    (testing \"map-shaped but malformed\"\n   133\t      (is (invalid-cursor? (outcome {})) \"no identity key\")\n   134\t      (is (invalid-cursor? (outcome {:dao.stream.memory-log/position 0}))\n   135\t          \"missing identity key\"))\n   136\t    (testing \"fabricated positions with the right identity\"\n   137\t      (is (invalid-cursor? (outcome (fabricate nil))) \"no position\")\n   138\t      (is (invalid-cursor? (outcome (fabricate -1))) \"negative\")\n   139\t      (is (invalid-cursor? (outcome (fabricate 1.5))) \"non-integer\")\n   140\t      (is (invalid-cursor? (outcome (fabricate :pos))) \"non-integer\")\n   141\t      (is (invalid-cursor? (outcome (fabricate \"1\"))) \"non-integer\")\n   142\t      (is (invalid-cursor? (outcome (fabricate 2))) \"beyond the tail\")\n   143\t      (is (invalid-cursor? (outcome (fabricate 1000000))) \"far beyond the tail\"))\n   144\t    (testing \"positions the stream itself can mint\"\n   145\t      (is (= :dao.stream/ok (outcome c)) \"position 0 holds the appended value\")\n   146\t      (is (= :dao.stream/blocked (outcome (fabricate 1)))\n   147\t          \"at the tail of an open stream\")\n   148\t      (is (= :dao.stream/blocked (outcome (cur h :dao.stream/newest)))))\n   149\t    (testing \"a foreign logical-stream identity\"\n   150\t      (is (= :dao.stream/cursor-mismatch\n   151\t             (outcome (cur (handle) :dao.stream/oldest)))))\n   152\t    (testing \"after close the tail answers end and mints still work\"\n   153\t      (stream/close! h)\n   154\t      (is (= :dao.stream/end (outcome (fabricate 1))))\n   155\t      (is (= :dao.stream/end (outcome (cur h :dao.stream/newest))))\n   156\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/cursor h :dao.stream/oldest)))\n   157\t          \"an owner handle keeps minting cursors after close\")\n   158\t      (is (invalid-cursor? (outcome (fabricate 2)))\n   159\t          \"beyond-tail is still invalid after close\"))))\n   160\t\n   161\t\n   162\t(def memory-log-manifest\n   163\t  \"The complete-retention transport's outcome declaration.  Every fixture\n   164\t   operates a fresh real handle; it never fabricates an outcome map.  The\n   165\t   exclusions are proof obligations discharged in this namespace: gap by\n   166\t   complete-retention (complete-retention and next-is-total never observe\n   167\t   one), full by unboundedness (every append answers ok), transport-error\n   168\t   by the completes-or-does-not-return shape of every operation, and the\n   169\t   rest by the transport's structure.\"\n   170\t  {:dao.stream/type log/transport-type\n   171\t   :surfaces #{:reader :writer :closable}\n   172\t   :handle-factory handle\n   173\t   :operations\n   174\t   {:create!\n   175\t    {:produces #{:dao.stream/ok :dao.stream/invalid-spec}\n   176\t     :exclusions\n   177\t     {:dao.stream/not-found\n   178\t      \"host dispatch selects the transport; a call reaching this handler has already matched it\"\n   179\t      :dao.stream/transport-error\n   180\t      \"creation allocates one in-memory state value: it either completes and returns, or does not return\"}}\n   181\t\n   182\t    :descriptor {:produces #{:dao.stream/ok} :exclusions {}}\n   183\t\n   184\t    :cursor\n   185\t    {:produces #{:dao.stream/ok :dao.stream/invalid-anchor}\n   186\t     :exclusions\n   187\t     {:dao.stream/closed\n   188\t      \"there are no attachments: every handle is the logical stream's owner, and an owner mints cursors after close so retained history stays readable\"\n   189\t      :dao.stream/transport-error\n   190\t      \"minting reads one in-memory state value and has no failure it could observe and return from\"}}\n   191\t\n   192\t    :next\n   193\t    {:produces #{:dao.stream/ok :dao.stream/blocked :dao.stream/end\n   194\t                 :dao.stream/cursor-mismatch :dao.stream/invalid-cursor}\n   195\t     :exclusions\n   196\t     {:dao.stream/gap\n   197\t      \"retention is complete: no position is ever dropped, so no cursor can point at one that was\"\n   198\t      :dao.stream/transport-error\n   199\t      \"a read is one indexed lookup into retained state; there is no failure it could observe and return from\"}}\n   200\t\n   201\t    :append!\n   202\t    {:produces #{:dao.stream/ok :dao.stream/closed}\n   203\t     :exclusions\n   204\t     {:dao.stream/full\n   205\t      \"no capacity is declared: the transport is logically unbounded and refuses nothing\"\n   206\t      :dao.stream/invalid-value\n   207\t      \"the log holds host values by reference and encodes nothing, so no value is uncarriable\"\n   208\t      :dao.stream/transport-error\n   209\t      \"the append either completes its one state transition and returns, or does not return\"}}\n   210\t\n   211\t    :close! {:produces #{:dao.stream/ok} :exclusions {}}}\n   212\t\n   213\t   :fixtures\n   214\t   {:create! {:dao.stream/ok #(log/create! spec)\n   215\t              :dao.stream/invalid-spec\n   216\t              ;; The transport-namespace-key case, which is the rule the\n   217\t              ;; manifest cannot state on its own; the other rejection\n   218\t              ;; cases are covered by creation-spec-rule.\n   219\t              #(log/create! (assoc spec :dao.stream.memory-log/capacity 1024))}\n   220\t    :descriptor {:dao.stream/ok #(stream/descriptor (handle))}\n   221\t    :cursor {:dao.stream/ok #(stream/cursor (handle) :dao.stream/oldest)\n   222\t             :dao.stream/invalid-anchor #(stream/cursor (handle) ::invalid-anchor)}\n   223\t    :next {:dao.stream/ok #(let [h (handle) c (cur h :dao.stream/oldest)]\n   224\t                             (stream/append! h :value)\n   225\t                             (stream/next h c))\n   226\t           :dao.stream/blocked #(let [h (handle)]\n   227\t                                  (stream/next h (cur h :dao.stream/newest)))\n   228\t           :dao.stream/end #(let [h (handle) c (cur h :dao.stream/newest)]\n   229\t                              (stream/close! h)\n   230\t                              (stream/next h c))\n   231\t           :dao.stream/cursor-mismatch #(let [l (handle) r (handle)]\n   232\t                                          (stream/next r (cur l :dao.stream/oldest)))\n   233\t           :dao.stream/invalid-cursor #(stream/next (handle) nil)}\n   234\t    :append! {:dao.stream/ok #(stream/append! (handle) :value)\n   235\t              :dao.stream/closed #(let [h (handle)]\n   236\t                                    (stream/close! h)\n   237\t                                    (stream/append! h :value))}\n   238\t    :close! {:dao.stream/ok #(stream/close! (handle))}}})\n   239\t\n   240\t\n   241\t(deftest memory-log-manifest-is-valid\n   242\t  (let [v (conformance/validate-manifest memory-log-manifest)]\n   243\t    (is (:valid? v) (str \"Manifest validation errors: \" (:errors v)))))\n   244\t\n   245\t\n   246\t(deftest memory-log-conformance-test\n   247\t  (let [result (conformance/run-conformance-suite memory-log-manifest)]\n   248\t    (is (:passed? result) (str \"Conformance failures: \" (:failures result)))))\n   249\t\n   250\t\n   251\t;; =============================================================================\n   252\t;; Bounded linearizability histories\n   253\t;; =============================================================================\n   254\t\n   255\t(def ^:private log-projector\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/dao.stream.md | sed -n '230,315p'; nl -ba docs/design/dao.stream.md | sed -n '420,455p'; rg -n \\\"valid-spec\\\\?|own-namespace|invalid-spec\\\" src/cljc/dao/stream test/dao/stream | head -100; nl -ba src/cljc/dao/stream/ringbuffer.cljc | sed -n '1,180p'; nl -ba test/dao/stream/ringbuffer_test.cljc | sed -n '1,180p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/dao.stream.md | sed -n '230,315p'; nl -ba docs/design/dao.stream.md | sed -n '420,455p'; rg -n \\\"valid-spec\\\\?|own-namespace|invalid-spec\\\" src/cljc/dao/stream test/dao/stream | head -100; nl -ba src/cljc/dao/stream/ringbuffer.cljc | sed -n '1,180p'; nl -ba test/dao/stream/ringbuffer_test.cljc | sed -n '1,180p'\"","aggregated_output":"   230\ttransport can carry is transport-owned: handing an encoding transport a\n   231\tvalue it cannot encode is reported as data like any other outcome.)\n   232\t`attach!` therefore consumes only descriptors, and\n   233\tresolves them against the transport's inherent operational state — the\n   234\tstreams a network endpoint serves because serving them is what it is, the\n   235\tfiles a filesystem holds. There is no stream table in this contract: no\n   236\tregistry maps descriptors to live handles, so a descriptor arriving\n   237\tsomewhere with nothing behind it — a ring buffer's descriptor on any other\n   238\thost, or on its own host absent a directory some composition chose to keep —\n   239\thonestly resolves to `:dao.stream/not-found`.\n   240\t\n   241\t### Envelopes\n   242\t\n   243\tA **creation specification** is a map with one required key:\n   244\t\n   245\t- `:dao.stream/type` — a qualified keyword naming the transport. This is the\n   246\t  dispatch key.\n   247\t\n   248\tEvery other key is transport-owned, qualified under the transport's namespace\n   249\t(for example a ring buffer's capacity), and validated by the selected handler\n   250\t— generic validation checks only the envelope, and a handler that rejects its\n   251\town keys returns `:dao.stream/invalid-spec`.\n   252\t\n   253\tThe **portable descriptor** is inspired by CORBA's interoperable object\n   254\treference. It is reachability data, not the logical-stream identity itself.\n   255\tIts properties are settled:\n   256\t\n   257\t- It carries `:dao.stream/type` — the transport, as above — as its dispatch\n   258\t  key.\n   259\t- It carries the logical-stream identity under the contract-owned\n   260\t  `:dao.stream/identity` key. Different descriptors may reach\n   261\t  the same logical stream through different endpoints; their reachability data\n   262\t  may differ, but their logical-stream identity is structurally equal. The same\n   263\t  descriptor attaches to the same stream every time.\n   264\t- It is self-contained. If the stream is remote, it contains whatever is\n   265\t  needed to connect — perhaps an IP address and port. The entry data is\n   266\t  transport-owned; a handler that cannot make sense of it returns\n   267\t  `:dao.stream/invalid-descriptor`.\n   268\t- A transport whose attachments are distinguishable assigns each attachment\n   269\t  an opaque, structurally serializable value, unique among the attachments\n   270\t  that transport can tell apart. Every attachment handle the transport mints\n   271\t  has such an identity, whether the handle is returned by `attach!` or\n   272\t  minted from a host connection accepted without an `attach!` call. An\n   273\t  `attach!` success map carries the value under `:dao.stream/attachment`.\n   274\t  When no `attach!` call produces the handle, the transport specification\n   275\t  names the deposited event or other stream-native mechanism by which the\n   276\t  composition receives the identity. Wherever an answer or event for that\n   277\t  attachment is displaced onto another channel, the same value correlates it\n   278\t  there. The key and correlation rule are the contract's; minting,\n   279\t  representation, and the server-side delivery mechanism are the\n   280\t  transport's. Transports that cannot distinguish attachments omit it.\n   281\t- It carries no authorization. Nothing in this contract gates who may attach:\n   282\t  a descriptor is a name, and a host that can reach what it names attaches.\n   283\t  Whether attachment should be gated at all, and by what, is a question this\n   284\t  contract does not answer and does not reserve room for — an outcome or key\n   285\t  held open for an undesigned mechanism constrains that mechanism's design\n   286\t  from a document with no business specifying it. Should gating arrive, it\n   287\t  arrives as an addition, which the open-map rule and this section's own\n   288\t  transport-owned keys already permit.\n   289\t\n   290\tFor the time being, the operative guarantee is the round trip: `descriptor`\n   291\ton a live handle returns `:dao.stream/ok` with `:dao.stream/descriptor`,\n   292\ta value that can be sent on a stream and reconstructed on the other end, and\n   293\t`:dao.stream/identity`, equal through every handle and descriptor for the\n   294\tlogical stream,\n   295\twhere `attach!` on the reconstructed value attaches to the stream it names —\n   296\tprovided the receiving host can reach what it names at all (see Creation and\n   297\tAttachment on reachability), and allowing that a transport which cannot know\n   298\tthat at call time reports it later as data.\n   299\t\n   300\tBoth envelopes are plain data through and through: every value must survive\n   301\tthe host serialization codec structurally unchanged, so equality is\n   302\tstructural, and no key holds a function, a host object, a live handle, or\n   303\tidentity smuggled in metadata. Like every DaoStream map, envelopes are open —\n   304\ta consumer ignores qualified keys it does not understand.\n   305\t\n   306\t`create!` outcomes:\n   307\t\n   308\t| Outcome                       | Meaning                                       | Required keys        |\n   309\t|-------------------------------|-----------------------------------------------|----------------------|\n   310\t| `:dao.stream/ok`              | A new logical stream exists, its identity settled at once. Implies not that every resource backing it has finished being acquired. | `:dao.stream/handle` |\n   311\t| `:dao.stream/invalid-spec`    | The creation specification is malformed.      | —                    |\n   312\t| `:dao.stream/not-found`       | No transport here matches `:dao.stream/type`. | —                    |\n   313\t| `:dao.stream/transport-error` | The handler failed.                           | —                    |\n   314\t\n   315\t`attach!` outcomes:\n   420\tpromise and has no reader surface: its inbound events are deposited by the\n   421\thost's adapter onto the stream the host composition wired for that boundary\n   422\t— where the reading model applies in full. The log lives beside such a\n   423\ttransport, composed explicitly by the host, never hidden inside the\n   424\ttransport. A deposit destination must admit every valid boundary event per\n   425\tits declared retention; wiring one that can refuse is a host assembly\n   426\tdefect. Deposit admission is declared, never interrogated: the contract's\n   427\tpublic surface has no way to ask a handle its retention policy. A constructor\n   428\ttakes the deposit destination and its admission declaration as data. This is\n   429\tconfiguration provenance, not runtime introspection. (`dao.stream.ws.md`\n   430\tspecifies one such transport and the admission rule in detail.)\n   431\t\n   432\tA boundary that can no longer deposit must make itself **observably gone**. Its\n   433\tone permitted action is closing the host resource it itself holds; it invokes\n   434\tnothing above itself, retries nothing, and interprets nothing. This is the sole\n   435\taction a boundary adapter takes beyond appending, and it is not a judgement\n   436\tabout any event — it is the same action for every cause. One corner is\n   437\tirreducible: when the deposit that failed was the boundary's only channel, the\n   438\trecord of its own departure has nowhere to land, and the failure is observable\n   439\tonly to whoever holds the deposit result and through subsequent operations on\n   440\tthe handle.\n   441\t\n   442\tA transport also declares **which outcomes it produces**, and for each one it\n   443\texcludes, why. There are three honest reasons: the outcome's precondition is\n   444\timpossible by the transport's nature (an unbounded log never evicts, so never\n   445\treports `gap`); another policy answers the same condition, named (a ring buffer\n   446\tevicts rather than refusing, so pressure surfaces as a `gap` to a cursor that\n   447\tspans the eviction, and never as `full`); or the answer is displaced to another channel, named (a transport\n   448\tthat cannot know a remote answer at call time reports it as data elsewhere). An\n   449\texclusion with no stated reason is an unimplemented outcome, not a declaration.\n   450\t\n   451\t### Where the asynchrony goes\n   452\t\n   453\tThe IO Model makes this contract non-blocking; hosts are asynchronous\n   454\twhether or not it is. A network message arrives when the runtime says so, in\n   455\ta callback, on a thread or event loop DaoStream does not own. DaoStream does\nsrc/cljc/dao/stream/memory_log.cljc:25:   `:dao.stream/invalid-spec` — most importantly a capacity, which is the\nsrc/cljc/dao/stream/memory_log.cljc:33:(def ^:private own-namespace \"dao.stream.memory-log\")\nsrc/cljc/dao/stream/memory_log.cljc:41:(defn- own-namespace-key?\nsrc/cljc/dao/stream/memory_log.cljc:44:  (boolean (and (keyword? k) (= own-namespace (namespace k)))))\nsrc/cljc/dao/stream/memory_log.cljc:47:(defn- valid-spec?\nsrc/cljc/dao/stream/memory_log.cljc:55:       (not-any? own-namespace-key? (keys spec))))\nsrc/cljc/dao/stream/memory_log.cljc:174:  (if-not (valid-spec? spec)\nsrc/cljc/dao/stream/memory_log.cljc:175:    (result :dao.stream/invalid-spec)\ntest/dao/stream/memory_log_test.cljc:53:  (let [invalid-spec? #(= :dao.stream/invalid-spec\ntest/dao/stream/memory_log_test.cljc:56:      (is (invalid-spec? nil) \"not a map\")\ntest/dao/stream/memory_log_test.cljc:57:      (is (invalid-spec? 42) \"not a map\")\ntest/dao/stream/memory_log_test.cljc:58:      (is (invalid-spec? {}) \"missing :dao.stream/type\")\ntest/dao/stream/memory_log_test.cljc:59:      (is (invalid-spec? {:dao.stream/type :dao.stream/ringbuffer})\ntest/dao/stream/memory_log_test.cljc:61:      (is (invalid-spec? (assoc spec :dao.stream.memory-log/capacity 3))\ntest/dao/stream/memory_log_test.cljc:175:    {:produces #{:dao.stream/ok :dao.stream/invalid-spec}\ntest/dao/stream/memory_log_test.cljc:215:              :dao.stream/invalid-spec\ntest/dao/stream/ringbuffer_test.cljc:93:   {:create! {:produces #{:dao.stream/ok :dao.stream/invalid-spec}\ntest/dao/stream/ringbuffer_test.cljc:111:              :dao.stream/invalid-spec #(ring/create! {:dao.stream/type ring/transport-type})}\nsrc/cljc/dao/stream/ringbuffer.cljc:15:(defn- valid-spec?\nsrc/cljc/dao/stream/ringbuffer.cljc:155:  (if-not (valid-spec? spec)\nsrc/cljc/dao/stream/ringbuffer.cljc:156:    (result :dao.stream/invalid-spec)\n     1\t(ns dao.stream.ringbuffer\n     2\t  \"Fixed-capacity, evict-oldest DaoStream v2 reference transport.\"\n     3\t  (:require [dao.stream :as stream]))\n     4\t\n     5\t\n     6\t(def transport-type :dao.stream/ringbuffer)\n     7\t(def capacity-key :dao.stream.ringbuffer/capacity)\n     8\t\n     9\t\n    10\t(defn- result\n    11\t  [outcome]\n    12\t  {:dao.stream/outcome outcome})\n    13\t\n    14\t\n    15\t(defn- valid-spec?\n    16\t  [spec]\n    17\t  (and (map? spec)\n    18\t       (= transport-type (:dao.stream/type spec))\n    19\t       (integer? (get spec capacity-key))\n    20\t       (pos? (get spec capacity-key))))\n    21\t\n    22\t\n    23\t(defn- fresh-state\n    24\t  [capacity]\n    25\t  ;; The logical identity is carried in descriptors and cursors.  It therefore\n    26\t  ;; belongs to DaoStream's portable data domain, unlike a host UUID object.\n    27\t  (atom {:identity (str (random-uuid))\n    28\t         :capacity capacity\n    29\t         :first 0\n    30\t         :tail 0\n    31\t         :values {}\n    32\t         :closed? false\n    33\t         :attachments {}}))\n    34\t\n    35\t\n    36\t(declare attach!)\n    37\t\n    38\t\n    39\t(deftype RingHandle\n    40\t  [state attachment-id owner?]\n    41\t\n    42\t  stream/IDaoStreamDescriptor\n    43\t\n    44\t  (descriptor\n    45\t    [_]\n    46\t    (let [s @state]\n    47\t      {:dao.stream/outcome :dao.stream/ok\n    48\t       :dao.stream/descriptor {:dao.stream/type transport-type\n    49\t                               :dao.stream/identity (:identity s)}\n    50\t       :dao.stream/identity (:identity s)}))\n    51\t\n    52\t\n    53\t  stream/IDaoStreamReader\n    54\t\n    55\t  (cursor\n    56\t    [_ anchor]\n    57\t    (let [s @state]\n    58\t      (if (and (not owner?) (not (get-in s [:attachments attachment-id :open?])))\n    59\t        (result :dao.stream/closed)\n    60\t        (case anchor\n    61\t          :dao.stream/oldest (assoc (result :dao.stream/ok)\n    62\t                                    :dao.stream/cursor\n    63\t                                    {:dao.stream.ringbuffer/identity (:identity s)\n    64\t                                     :dao.stream.ringbuffer/position (:first s)})\n    65\t          :dao.stream/newest (assoc (result :dao.stream/ok)\n    66\t                                    :dao.stream/cursor\n    67\t                                    {:dao.stream.ringbuffer/identity (:identity s)\n    68\t                                     :dao.stream.ringbuffer/position (:tail s)})\n    69\t          (result :dao.stream/invalid-anchor)))))\n    70\t\n    71\t\n    72\t  (next\n    73\t    [_ cursor-value]\n    74\t    (let [s @state]\n    75\t      (cond\n    76\t        (not (map? cursor-value)) (result :dao.stream/invalid-cursor)\n    77\t        (not (contains? cursor-value :dao.stream.ringbuffer/identity))\n    78\t        (result :dao.stream/invalid-cursor)\n    79\t        (not= (:identity s) (:dao.stream.ringbuffer/identity cursor-value))\n    80\t        (result :dao.stream/cursor-mismatch)\n    81\t        (not (integer? (:dao.stream.ringbuffer/position cursor-value)))\n    82\t        (result :dao.stream/invalid-cursor)\n    83\t        :else\n    84\t        (let [pos (:dao.stream.ringbuffer/position cursor-value)\n    85\t              frozen (when-not owner? (get-in s [:attachments attachment-id :tail]))\n    86\t              visible-tail (if (some? frozen) frozen (:tail s))]\n    87\t          (cond\n    88\t            (< pos (:first s))\n    89\t            (assoc (result :dao.stream/gap)\n    90\t                   :dao.stream/cursor\n    91\t                   {:dao.stream.ringbuffer/identity (:identity s)\n    92\t                    ;; The contract's recovery position is the earliest retained\n    93\t                    ;; position, which equals the tail when nothing is retained.\n    94\t                    ;; It must never be an evicted position: a frozen attachment\n    95\t                    ;; whose visible history is fully evicted would otherwise be\n    96\t                    ;; handed its own tail back and re-gap forever.  Recovering\n    97\t                    ;; past that tail is correct; the next read answers `end`.\n    98\t                    :dao.stream.ringbuffer/position (:first s)})\n    99\t            (< pos visible-tail)\n   100\t            ;; `:first`, `:tail`, and `:values` are updated as one state value;\n   101\t            ;; positions in this interval are always retained by the transport.\n   102\t            {:dao.stream/outcome :dao.stream/ok\n   103\t             :dao.stream/value (get (:values s) pos)\n   104\t             :dao.stream/cursor {:dao.stream.ringbuffer/identity (:identity s)\n   105\t                                 :dao.stream.ringbuffer/position (inc pos)}}\n   106\t            (or (:closed? s) (some? frozen)) (result :dao.stream/end)\n   107\t            :else (result :dao.stream/blocked))))))\n   108\t\n   109\t\n   110\t  stream/IDaoStreamWriter\n   111\t\n   112\t  (append!\n   113\t    [_ value]\n   114\t    ;; Check attachment liveness *inside* the one state transition.  A deref\n   115\t    ;; before swap! permits an append that began before an attachment close to\n   116\t    ;; land after it; this form gives append!/close! a single linearization point.\n   117\t    (let [out (volatile! nil)]\n   118\t      (swap! state\n   119\t             (fn [s]\n   120\t               (if (or (:closed? s)\n   121\t                       (and (not owner?)\n   122\t                            (not (get-in s [:attachments attachment-id :open?]))))\n   123\t                 (do (vreset! out (result :dao.stream/closed)) s)\n   124\t                 (let [p (:tail s) n (inc p)\n   125\t                       first' (max (:first s) (- n (:capacity s)))]\n   126\t                   (vreset! out (result :dao.stream/ok))\n   127\t                   (-> s (assoc :tail n :first first')\n   128\t                       (assoc :values\n   129\t                              (assoc (if (> first' (:first s))\n   130\t                                       (dissoc (:values s) (:first s))\n   131\t                                       (:values s)) p value)))))))\n   132\t      @out))\n   133\t\n   134\t\n   135\t  stream/IDaoStreamClosable\n   136\t\n   137\t  (close!\n   138\t    [_]\n   139\t    (swap! state\n   140\t           (fn [s]\n   141\t             (if owner?\n   142\t               (assoc s :closed? true)\n   143\t               ;; Preserve the first frozen tail.  Later idempotent closes must\n   144\t               ;; not make post-close values visible through this attachment.\n   145\t               (if (get-in s [:attachments attachment-id :open?])\n   146\t                 (assoc-in s [:attachments attachment-id]\n   147\t                           {:open? false :tail (:tail s)})\n   148\t                 s))))\n   149\t    (result :dao.stream/ok)))\n   150\t\n   151\t\n   152\t(defn create!\n   153\t  \"Create a ring buffer from a creation specification.\"\n   154\t  [spec]\n   155\t  (if-not (valid-spec? spec)\n   156\t    (result :dao.stream/invalid-spec)\n   157\t    (let [state (fresh-state (get spec capacity-key))]\n   158\t      {:dao.stream/outcome :dao.stream/ok\n   159\t       :dao.stream/handle (RingHandle. state nil true)\n   160\t       :dao.stream/identity (:identity @state)})))\n   161\t\n   162\t\n   163\t(defn- resolve-state\n   164\t  [resolver identity]\n   165\t  (let [x (if (fn? resolver) (resolver identity) (get resolver identity))]\n   166\t    (cond (instance? RingHandle x) (.-state ^RingHandle x)\n   167\t          #?(:cljd false\n   168\t             :clj (instance? clojure.lang.IAtom x)\n   169\t             :cljs (instance? cljs.core/Atom x)) x\n   170\t          :else nil)))\n   171\t\n   172\t\n   173\t(defn attach!\n   174\t  \"Attach using a host-owned resolver (identity -> handle/state).\"\n   175\t  [resolver descriptor]\n   176\t  (if-not (and (map? descriptor)\n   177\t               (= transport-type (:dao.stream/type descriptor))\n   178\t               (contains? descriptor :dao.stream/identity))\n   179\t    (result :dao.stream/invalid-descriptor)\n   180\t    (if-let [state (resolve-state resolver (:dao.stream/identity descriptor))]\n     1\t(ns dao.stream.ringbuffer-test\n     2\t  (:require [clojure.test :refer [deftest is testing]]\n     3\t            [dao.stream :as stream]\n     4\t            [dao.stream.conformance :as conformance]\n     5\t            [dao.stream.ringbuffer :as ring]))\n     6\t\n     7\t\n     8\t(def spec\n     9\t  {:dao.stream/type ring/transport-type\n    10\t   :dao.stream.ringbuffer/capacity 2})\n    11\t\n    12\t\n    13\t(defn handle\n    14\t  []\n    15\t  (:dao.stream/handle (ring/create! spec)))\n    16\t\n    17\t\n    18\t(defn cur\n    19\t  [h a]\n    20\t  (:dao.stream/cursor (stream/cursor h a)))\n    21\t\n    22\t\n    23\t(deftest retention-and-gaps\n    24\t  (let [h (handle) c (cur h :dao.stream/oldest)]\n    25\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! h :a))))\n    26\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! h :b))))\n    27\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! h :c))))\n    28\t    (is (= :dao.stream/gap (:dao.stream/outcome (stream/next h c))))\n    29\t    (let [r (stream/next h (:dao.stream/cursor (stream/next h c)))]\n    30\t      (is (= :dao.stream/ok (:dao.stream/outcome r)))\n    31\t      (is (= :b (:dao.stream/value r))))))\n    32\t\n    33\t\n    34\t(deftest anchors-and-identity\n    35\t  (let [h (handle) other (handle)\n    36\t        newest (cur h :dao.stream/newest)]\n    37\t    (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next h newest))))\n    38\t    (is (= :dao.stream/invalid-anchor\n    39\t           (:dao.stream/outcome (stream/cursor h :bad))))\n    40\t    (is (= :dao.stream/cursor-mismatch\n    41\t           (:dao.stream/outcome\n    42\t             (stream/next other newest))))))\n    43\t\n    44\t\n    45\t(deftest close-freezes-attachment\n    46\t  (let [owner (handle)\n    47\t        d (:dao.stream/descriptor (stream/descriptor owner))\n    48\t        attached (:dao.stream/handle\n    49\t                   ((ring/make-attacher {(:dao.stream/identity d) owner}) d))\n    50\t        c (cur attached :dao.stream/newest)]\n    51\t    (stream/append! owner :before)\n    52\t    (stream/close! attached)\n    53\t    (is (= :dao.stream/closed (:dao.stream/outcome (stream/append! attached :x))))\n    54\t    (stream/append! owner :after)\n    55\t    (let [before (stream/next attached c)]\n    56\t      (is (= :dao.stream/ok (:dao.stream/outcome before)))\n    57\t      (is (= :before (:dao.stream/value before)))\n    58\t      (is (= :dao.stream/end\n    59\t             (:dao.stream/outcome\n    60\t               (stream/next attached (:dao.stream/cursor before))))))\n    61\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! owner :ok))))))\n    62\t\n    63\t\n    64\t(deftest attachment-resolution\n    65\t  (let [h (handle) d (:dao.stream/descriptor (stream/descriptor h))\n    66\t        resolver {(:dao.stream/identity d) h}]\n    67\t    (is (= :dao.stream/ok (:dao.stream/outcome (ring/attach! resolver d))))\n    68\t    (is (= :dao.stream/not-found\n    69\t           (:dao.stream/outcome (ring/attach! {} d))))\n    70\t    (is (= :dao.stream/invalid-descriptor\n    71\t           (:dao.stream/outcome (ring/attach! resolver {:dao.stream/type :other}))))))\n    72\t\n    73\t\n    74\t(defn- attachment\n    75\t  ([] (attachment spec))\n    76\t  ([creation-spec]\n    77\t   (let [owner (:dao.stream/handle (ring/create! creation-spec))\n    78\t         descriptor (:dao.stream/descriptor (stream/descriptor owner))]\n    79\t     {:owner owner\n    80\t      :descriptor descriptor\n    81\t      :attached (:dao.stream/handle\n    82\t                  (ring/attach! {(:dao.stream/identity descriptor) owner}\n    83\t                                descriptor))})))\n    84\t\n    85\t\n    86\t(def ringbuffer-manifest\n    87\t  \"The reference transport's complete outcome declaration.  Every fixture\n    88\t   operates a fresh real handle; it never fabricates an outcome map.\"\n    89\t  {:dao.stream/type ring/transport-type\n    90\t   :surfaces #{:reader :writer :closable}\n    91\t   :handle-factory handle\n    92\t   :operations\n    93\t   {:create! {:produces #{:dao.stream/ok :dao.stream/invalid-spec}\n    94\t              :exclusions {:dao.stream/not-found \"host dispatch selects transport\"\n    95\t                           :dao.stream/transport-error \"in-memory allocation has no operational failure channel\"}}\n    96\t    :attach! {:produces #{:dao.stream/ok :dao.stream/invalid-descriptor :dao.stream/not-found}\n    97\t              :exclusions {:dao.stream/transport-error \"captured in-memory resolver has no failure channel\"}}\n    98\t    :descriptor {:produces #{:dao.stream/ok} :exclusions {}}\n    99\t    :cursor {:produces #{:dao.stream/ok :dao.stream/invalid-anchor :dao.stream/closed}\n   100\t             :exclusions {:dao.stream/transport-error \"one in-memory state deref cannot fail operationally\"}}\n   101\t    :next {:produces #{:dao.stream/ok :dao.stream/blocked :dao.stream/end\n   102\t                       :dao.stream/gap :dao.stream/cursor-mismatch :dao.stream/invalid-cursor}\n   103\t           :exclusions {:dao.stream/transport-error \"coherent in-memory state has no failure channel\"}}\n   104\t    :append! {:produces #{:dao.stream/ok :dao.stream/closed}\n   105\t              :exclusions {:dao.stream/full \"evict-oldest retention never refuses append\"\n   106\t                           :dao.stream/invalid-value \"reference transport accepts all host values\"\n   107\t                           :dao.stream/transport-error \"coherent in-memory state has no failure channel\"}}\n   108\t    :close! {:produces #{:dao.stream/ok} :exclusions {}}}\n   109\t   :fixtures\n   110\t   {:create! {:dao.stream/ok #(ring/create! spec)\n   111\t              :dao.stream/invalid-spec #(ring/create! {:dao.stream/type ring/transport-type})}\n   112\t    :attach! {:dao.stream/ok #(let [{:keys [owner descriptor]} (attachment)]\n   113\t                                (ring/attach! {(:dao.stream/identity descriptor) owner} descriptor))\n   114\t              :dao.stream/invalid-descriptor #(ring/attach! {} {:dao.stream/type :other})\n   115\t              :dao.stream/not-found #(let [h (handle)\n   116\t                                           d (:dao.stream/descriptor (stream/descriptor h))]\n   117\t                                       (ring/attach! {} d))}\n   118\t    :descriptor {:dao.stream/ok #(stream/descriptor (handle))}\n   119\t    :cursor {:dao.stream/ok #(stream/cursor (handle) :dao.stream/oldest)\n   120\t             :dao.stream/invalid-anchor #(stream/cursor (handle) ::invalid-anchor)\n   121\t             :dao.stream/closed #(let [{:keys [attached]} (attachment)]\n   122\t                                   (stream/close! attached)\n   123\t                                   (stream/cursor attached :dao.stream/oldest))}\n   124\t    :next {:dao.stream/ok #(let [h (handle)\n   125\t                                 c (cur h :dao.stream/oldest)]\n   126\t                             (stream/append! h :value)\n   127\t                             (stream/next h c))\n   128\t           :dao.stream/blocked #(let [h (handle)]\n   129\t                                  (stream/next h (cur h :dao.stream/newest)))\n   130\t           :dao.stream/end #(let [h (handle)\n   131\t                                  c (cur h :dao.stream/newest)]\n   132\t                              (stream/close! h)\n   133\t                              (stream/next h c))\n   134\t           :dao.stream/gap #(let [h (:dao.stream/handle (ring/create! (assoc spec ring/capacity-key 1)))\n   135\t                                  c (cur h :dao.stream/oldest)]\n   136\t                              (stream/append! h :old)\n   137\t                              (stream/append! h :new)\n   138\t                              (stream/next h c))\n   139\t           :dao.stream/cursor-mismatch #(let [left (handle) right (handle)]\n   140\t                                          (stream/next right (cur left :dao.stream/oldest)))\n   141\t           :dao.stream/invalid-cursor #(stream/next (handle) nil)}\n   142\t    :append! {:dao.stream/ok #(stream/append! (handle) :value)\n   143\t              :dao.stream/closed #(let [h (handle)]\n   144\t                                    (stream/close! h)\n   145\t                                    (stream/append! h :value))}\n   146\t    :close! {:dao.stream/ok #(stream/close! (handle))}}})\n   147\t\n   148\t\n   149\t(deftest ringbuffer-conformance-test\n   150\t  (let [result (conformance/run-conformance-suite ringbuffer-manifest)]\n   151\t    (is (:passed? result) (str \"Conformance failures: \" (:failures result)))))\n   152\t\n   153\t\n   154\t(deftest attachment-lifecycle-regressions\n   155\t  (testing \"attachment close is idempotent and freezes its original tail\"\n   156\t    (let [{:keys [owner attached]} (attachment (assoc spec ring/capacity-key 4))\n   157\t          cursor (cur attached :dao.stream/newest)]\n   158\t      (stream/append! owner :before)\n   159\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/close! attached))))\n   160\t      (stream/append! owner :after-first-close)\n   161\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/close! attached))))\n   162\t      (stream/append! owner :after-second-close)\n   163\t      (let [seen (stream/next attached cursor)]\n   164\t        (is (= :before (:dao.stream/value seen)))\n   165\t        (is (= :dao.stream/end\n   166\t               (:dao.stream/outcome (stream/next attached (:dao.stream/cursor seen))))))))\n   167\t\n   168\t  (testing \"gap recovery on a frozen attachment never points past its tail\"\n   169\t    (let [owner (:dao.stream/handle (ring/create! (assoc spec ring/capacity-key 1)))\n   170\t          descriptor (:dao.stream/descriptor (stream/descriptor owner))\n   171\t          attached (:dao.stream/handle (ring/attach! {(:dao.stream/identity descriptor) owner} descriptor))\n   172\t          cursor (cur attached :dao.stream/oldest)]\n   173\t      (stream/append! owner :before)\n   174\t      (stream/close! attached)\n   175\t      (stream/append! owner :after)\n   176\t      (let [gap (stream/next attached cursor)]\n   177\t        (is (= :dao.stream/gap (:dao.stream/outcome gap)))\n   178\t        (is (= :dao.stream/end\n   179\t               (:dao.stream/outcome (stream/next attached (:dao.stream/cursor gap))))))))\n   180\t\n","exit_code":0,"status":"completed"}}
