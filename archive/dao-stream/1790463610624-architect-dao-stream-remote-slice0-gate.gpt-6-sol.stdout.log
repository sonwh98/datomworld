{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/dao/stream/observe.cljc | sed -n '44,150p'; nl -ba src/cljc/dao/stream/waitset.cljc | sed -n '160,265p'; nl -ba test/dao/stream/observe_test.cljc | sed -n '45,120p'; nl -ba test/yin/vm/engine_test.cljc | sed -n '150,270p'\"","aggregated_output":"    44\t(defn- valid-or-transport-error\n    45\t  \"Fold a defective host answer into the contract's outcome algebra.\n    46\t\n    47\t   A conforming operation already returns one of the contract outcomes; this\n    48\t   keeps the step's branch total when a composition supplies a bad handle or\n    49\t   an effect answers with something that is not an outcome map.\"\n    50\t  [operation result]\n    51\t  (if (stream/valid-outcome? operation result)\n    52\t    result\n    53\t    {:dao.stream/outcome :dao.stream/transport-error\n    54\t     :dao.stream/error :dao.stream/invalid-operation-result\n    55\t     :dao.stream/answer result}))\n    56\t\n    57\t\n    58\t(defn step\n    59\t  \"Read one value from `source` at `cursor` and run `effect` on it.\n    60\t\n    61\t   `effect` is `(fn [value] -> outcome-map)` answering with the writer outcome\n    62\t   set: `ok`, `full` (\\\"not yet\\\"), `invalid-value`, `closed`, `refused`, or\n    63\t   `transport-error`.  Any other answer is classified as `transport-error`\n    64\t   with the raw answer retained.  An effect that throws propagates.\n    65\t\n    66\t   Returns a map carrying `:cursor` and `:read` (the raw read answer) in every\n    67\t   case:\n    68\t\n    69\t   | status     | when                                    | cursor    | also         |\n    70\t   | ---------- | --------------------------------------- | --------- | ------------ |\n    71\t   | `:advance` | read ok, effect ok                      | successor | `:effect`    |\n    72\t   | `:retry`   | read blocked, or effect full            | unchanged | `:outcome`   |\n    73\t   | `:ended`   | read end                                | unchanged | `:outcome`   |\n    74\t   | `:gap`     | read gap                                | unchanged | `:recovery`  |\n    75\t   | `:refused` | read refused, nothing observed\n    76\t   |            | unchanged | `:outcome`   |\n    77\t   | `:defect`  | read cursor-mismatch, invalid-cursor,\n    78\t                  transport-error, or malformed | unchanged | `:outcome` |\n    79\t   | `:failed`  | effect invalid-value, closed, refused,\n    80\t                  transport-error, or malformed | unchanged | `:outcome`,\n    81\t                  `:effect` |\n    82\t\n    83\t   A `:retry` from the effect also carries `:effect`.  The cursor is the\n    84\t   successor on `:advance` and unchanged on every other status.  `refused`\n    85\t   is a policy answer, not a defect: nothing was observed and nothing was\n    86\t   recorded, and the cursor stays where it was.\"\n    87\t  [source cursor effect]\n    88\t  (let [read-result (valid-or-transport-error :next (stream/next source cursor))\n    89\t        read-outcome (:dao.stream/outcome read-result)]\n    90\t    (case read-outcome\n    91\t      :dao.stream/ok\n    92\t      (let [effect-result (valid-or-transport-error\n    93\t                            :append!\n    94\t                            (effect (:dao.stream/value read-result)))\n    95\t            effect-outcome (:dao.stream/outcome effect-result)]\n    96\t        (case effect-outcome\n    97\t          :dao.stream/ok {:status :advance\n    98\t                          :cursor (:dao.stream/cursor read-result)\n    99\t                          :read read-result\n   100\t                          :effect effect-result}\n   101\t          :dao.stream/full {:status :retry\n   102\t                            :cursor cursor\n   103\t                            :outcome effect-outcome\n   104\t                            :read read-result\n   105\t                            :effect effect-result}\n   106\t          {:status :failed\n   107\t           :cursor cursor\n   108\t           :outcome effect-outcome\n   109\t           :read read-result\n   110\t           :effect effect-result}))\n   111\t\n   112\t      :dao.stream/blocked {:status :retry\n   113\t                           :cursor cursor\n   114\t                           :outcome read-outcome\n   115\t                           :read read-result}\n   116\t\n   117\t      :dao.stream/end {:status :ended\n   118\t                       :cursor cursor\n   119\t                       :outcome read-outcome\n   120\t                       :read read-result}\n   121\t\n   122\t      :dao.stream/gap {:status :gap\n   123\t                       :cursor cursor\n   124\t                       :outcome read-outcome\n   125\t                       :recovery (:dao.stream/cursor read-result)\n   126\t                       :read read-result}\n   127\t\n   128\t      :dao.stream/refused {:status :refused\n   129\t                           :cursor cursor\n   130\t                           :outcome read-outcome\n   131\t                           :read read-result}\n   132\t\n   133\t      (:dao.stream/cursor-mismatch\n   134\t        :dao.stream/invalid-cursor\n   135\t        :dao.stream/transport-error)\n   136\t      {:status :defect\n   137\t       :cursor cursor\n   138\t       :outcome read-outcome\n   139\t       :read read-result}\n   140\t\n   141\t      {:status :defect\n   142\t       :cursor cursor\n   143\t       :outcome read-outcome\n   144\t       :read read-result})))\n   160\t    (catch #?(:cljd Object :clj Throwable :cljs :default) _\n   161\t      {:wake (diagnostic-result entry :dao.stream.waitset/invalid-answer)})))\n   162\t\n   163\t\n   164\t(defn check\n   165\t  \"Run one complete ordered sweep over `waitset`'s entries: a synchronous,\n   166\t  state-threaded interpreter step with explicit stream effects — it calls\n   167\t  `next` on live media and a parked writer's `append!` — so it is never\n   168\t  described as pure.\n   169\t\n   170\t  `resolver` is host composition, two synchronous functions over whole\n   171\t  entries:\n   172\t\n   173\t    {:resolve (fn [store entry] ...)          ; => {:stream h :cursor c :value v} or nil\n   174\t     :advance (fn [store entry cursor] ...)}  ; => store'\n   175\t\n   176\t  `:resolve` maps an entry to its live handle plus the cursor to read from\n   177\t  (`:next`) or the value to append (`:put`), or answers nil when it\n   178\t  cannot. `:advance` returns the store with that entry's reader cursor\n   179\t  moved to `cursor`. Both are invoked immediately, per entry, and never\n   180\t  retained — the shape of `reduce`'s `f`, not an event callback. The store\n   181\t  is opaque to this library: it is never dereferenced here, only passed\n   182\t  through.\n   183\t\n   184\t  Returns\n   185\t\n   186\t    {:waitset {:waiting [...]}   ; thread this into the next check\n   187\t     :woken   [...]              ; this call's results only; host-owned\n   188\t     :store   store'}            ; the host commits this\n   189\t\n   190\t  Every entry is polled every call, one at a time in wait-set order — no\n   191\t  budget, no scan position. A still-waiting entry (`blocked` for a reader,\n   192\t  `full` for a writer) is retained exactly as stored. A resolved entry\n   193\t  leaves `:waiting` and appears in `:woken` as\n   194\t\n   195\t    {:entry <the stored entry> :status ... :value ... :cursor ...}\n   196\t\n   197\t  where `:cursor` is present only for a reader whose poll returned one.\n   198\t  The library never adds a resolved handle or polling cursor to any entry\n   199\t  it retains or returns, and `:woken` never accumulates: check the\n   200\t  returned `:waitset` again and it answers only what moved since.\n   201\t\n   202\t  Two laws are preserved from the engine this sweep generalizes.\n   203\t  Shared-cursor write-back: a woken reader's successor — or recovery\n   204\t  cursor, on gap — is advanced in the store before later entries resolve,\n   205\t  so co-waiters on one cursor read distinct values and a co-waiter behind\n   206\t  a gap reads from the recovery position; wait-set order is therefore wake\n   207\t  order, and nothing reorders `:waiting`. A parked writer retries by\n   208\t  appending: the append is an effect of the poll, so no caller may drop a\n   209\t  returned `:waitset` or `:store`.\n   210\t\n   211\t  Classification is total, per operation. For a `:next` entry only\n   212\t  `blocked` waits: `ok` resolves with the value and its successor, `end`\n   213\t  as `{:value nil :status :end}`, `gap` with its recovery cursor, and\n   214\t  cursor-mismatch, invalid-cursor and transport-error under their own\n   215\t  qualified keywords. For a `:put` entry only `full` waits: `ok` resolves\n   216\t  with the appended value and no cursor; closed, invalid-value and\n   217\t  transport-error are terminal append failures under their own keywords —\n   218\t  writer `closed` is never a reader's `end`. Any outcome outside the\n   219\t  operation's declared set is terminal under its own keyword, never a\n   220\t  wait.\n   221\t\n   222\t  Three diagnostics are the library's own, and they also never wait: an\n   223\t  entry whose `:resolve` answers nil or without a `:stream` wakes with\n   224\t  `:status :dao.stream.waitset/unresolved`; an entry whose `:reason` is\n   225\t  neither `:next` nor `:put` wakes with\n   226\t  `:status :dao.stream.waitset/unsupported-reason`; and a poll that\n   227\t  answers something other than an outcome map — or throws, because its\n   228\t  handle fails the protocol it was resolved to — wakes with\n   229\t  `:status :dao.stream.waitset/invalid-answer`, the entry no longer\n   230\t  being one that can be trusted to poll. In every case no `:advance` is\n   231\t  called, the store is unchanged, the original entry is returned intact,\n   232\t  and the entry leaves `:waiting`.\n   233\t\n   234\t  Resolvers must not throw. A resolver throw voids the sweep: `check`\n   235\t  does not return, and a caller that re-threads its previous waitset\n   236\t  into a later call re-polls every entry — re-appending writers that\n   237\t  already appended. The engine's sweep behaves identically, and this is\n   238\t  stated as the contract on resolvers rather than caught: host\n   239\t  composition failing is a host defect the library cannot name, and\n   240\t  wrapping it would hide it inside a diagnostic.\"\n   241\t  [waitset resolver store]\n   242\t  (let [{resolve-fn :resolve, advance-fn :advance} resolver]\n   243\t    (loop [remaining (:waiting waitset)\n   244\t           store store\n   245\t           waiting []\n   246\t           woken []]\n   247\t      (if (seq remaining)\n   248\t        (let [entry (first remaining)\n   249\t              reason (:reason entry)]\n   250\t          (if (contains? wait-reasons reason)\n   251\t            (let [resolved (resolve-fn store entry)]\n   252\t              (if (and (map? resolved) (:stream resolved))\n   253\t                (if-some [{:keys [wake advance-cursor]}\n   254\t                          (case reason\n   255\t                            :next (poll-next entry resolved)\n   256\t                            :put (poll-put entry resolved))]\n   257\t                  (recur (rest remaining)\n   258\t                         (cond-> store\n   259\t                           advance-cursor (advance-fn entry advance-cursor))\n   260\t                         waiting\n   261\t                         (conj woken wake))\n   262\t                  (recur (rest remaining)\n   263\t                         store\n   264\t                         (conj waiting entry)\n   265\t                         woken))\n    45\t  ([read-outcome] (step-on read-outcome ok-effect))\n    46\t  ([read-outcome effect]\n    47\t   (observe/step (reader (read-answer read-outcome) (atom [])) at effect)))\n    48\t\n    49\t\n    50\t(deftest the-source-is-read-once-at-the-given-cursor\n    51\t  (doseq [outcome stream/outcomes-next]\n    52\t    (let [calls (atom [])]\n    53\t      (observe/step (reader (read-answer outcome) calls) at ok-effect)\n    54\t      (is (= [at] @calls)\n    55\t          (str \"one read, at the cursor it was handed, on \" outcome)))))\n    56\t\n    57\t\n    58\t(deftest every-read-outcome-maps-to-exactly-one-status\n    59\t  (testing \"the eight declared read outcomes are total over the step's statuses\"\n    60\t    (let [expected {:dao.stream/ok :advance,\n    61\t                    :dao.stream/blocked :retry,\n    62\t                    :dao.stream/end :ended,\n    63\t                    :dao.stream/gap :gap,\n    64\t                    :dao.stream/refused :refused,\n    65\t                    :dao.stream/cursor-mismatch :defect,\n    66\t                    :dao.stream/invalid-cursor :defect,\n    67\t                    :dao.stream/transport-error :defect}]\n    68\t      (is (= stream/outcomes-next (set (keys expected)))\n    69\t          \"the table covers the declared set exactly, and fails if it grows\")\n    70\t      (doseq [[outcome status] expected]\n    71\t        (is (= status (:status (step-on outcome)))\n    72\t            (str outcome \" must classify as \" status))))))\n    73\t\n    74\t\n    75\t(deftest a-refused-read-is-its-own-refused-status\n    76\t  (testing \"the refusal is data, not a defect: nothing observed, cursor kept\"\n    77\t    (let [result (step-on :dao.stream/refused)]\n    78\t      (is (= :refused (:status result))\n    79\t          \"the refusal is not the :defect default, it is its own status\")\n    80\t      (is (= :dao.stream/refused (:outcome result)))\n    81\t      (is (= at (:cursor result)) \"a refused read never moves the cursor\")\n    82\t      (is (not (contains? result :recovery)) \"no recovery cursor exists\")\n    83\t      (is (= (read-answer :dao.stream/refused) (:read result))\n    84\t          \"the raw refusal answer is retained\"))))\n    85\t\n    86\t\n    87\t(deftest every-effect-outcome-maps-to-exactly-one-status\n    88\t  (testing \"the six declared append outcomes are total over the step's statuses\"\n    89\t    (let [expected {:dao.stream/ok :advance,\n    90\t                    :dao.stream/full :retry,\n    91\t                    :dao.stream/invalid-value :failed,\n    92\t                    :dao.stream/closed :failed,\n    93\t                    :dao.stream/refused :failed,\n    94\t                    :dao.stream/transport-error :failed}]\n    95\t      (is (= stream/outcomes-append (set (keys expected)))\n    96\t          \"the table covers the declared set exactly, and fails if it grows\")\n    97\t      (doseq [[outcome status] expected]\n    98\t        (is (= status\n    99\t               (:status (step-on :dao.stream/ok\n   100\t                                 (fn [_] {:dao.stream/outcome outcome}))))\n   101\t            (str \"an effect answering \" outcome \" must classify as \" status))))))\n   102\t\n   103\t\n   104\t(deftest the-cursor-advances-only-on-advance\n   105\t  (testing \"the successor is taken from the read, and only when the effect answered ok\"\n   106\t    (is (= successor (:cursor (step-on :dao.stream/ok))))\n   107\t    (doseq [outcome [:dao.stream/blocked :dao.stream/end :dao.stream/gap\n   108\t                     :dao.stream/refused\n   109\t                     :dao.stream/cursor-mismatch :dao.stream/invalid-cursor\n   110\t                     :dao.stream/transport-error]]\n   111\t      (is (= at (:cursor (step-on outcome)))\n   112\t          (str \"the cursor is unchanged on \" outcome)))\n   113\t    (doseq [outcome [:dao.stream/full :dao.stream/invalid-value\n   114\t                     :dao.stream/closed :dao.stream/refused\n   115\t                     :dao.stream/transport-error]]\n   116\t      (is (= at (:cursor (step-on :dao.stream/ok\n   117\t                                  (fn [_] {:dao.stream/outcome outcome}))))\n   118\t          (str \"a read ok whose effect answered \" outcome \" keeps the cursor\")))))\n   119\t\n   120\t\n   150\t      (is (throws? (fn [] (engine/handle-put s0 effect)))))\n   151\t    (testing \"An unknown stream reference is refused as forged\"\n   152\t      (let [forged (assoc effect :stream {:type :stream-ref, :id :nope})]\n   153\t        (is (= :forged-resource-reference\n   154\t               (:reason (throws-ex-data\n   155\t                          #(engine/handle-put s0 forged)))))))))\n   156\t\n   157\t\n   158\t(deftest refused-append-answers-are-shaped-refusals-test\n   159\t  (testing \"refused is the effect's shaped refusal value, not a throw\"\n   160\t    (let [refusing (reify stream/IDaoStreamWriter\n   161\t                     (append! [_ _] {:dao.stream/outcome :dao.stream/refused}))\n   162\t          [sref s0] (engine/attach-resource (state) refusing)\n   163\t          r (engine/handle-put s0 {:effect :stream/put, :stream sref, :val 1})]\n   164\t      (is (= {:status :refused\n   165\t              :outcome :dao.stream/refused\n   166\t              :stream-id :stream-0}\n   167\t             (:value r))\n   168\t          \"the program reads the refusal as data, poll-link-response's shape\")\n   169\t      (is (not (contains? r :park)) \"a refusal parks nothing\")))\n   170\t  (testing \"an outcome outside this contract version is treated as refused\"\n   171\t    (let [quantum (reify stream/IDaoStreamWriter\n   172\t                    (append!\n   173\t                      [_ _]\n   174\t                      {:dao.stream/outcome\n   175\t                       :dao.stream/quantum-flux}))\n   176\t          [sref s0] (engine/attach-resource (state) quantum)\n   177\t          r (engine/handle-put s0 {:effect :stream/put, :stream sref, :val 1})]\n   178\t      (is (= {:status :refused\n   179\t              :outcome :dao.stream/quantum-flux\n   180\t              :stream-id :stream-0}\n   181\t             (:value r))\n   182\t          \"an unrecognized outcome is a newer contract, not a defect\")))\n   183\t  (testing \"the declared append defects still throw, as v1 did\"\n   184\t    (let [defective (reify stream/IDaoStreamWriter\n   185\t                      (append!\n   186\t                        [_ _]\n   187\t                        {:dao.stream/outcome :dao.stream/invalid-value}))\n   188\t          [sref s0] (engine/attach-resource (state) defective)]\n   189\t      (is (throws?\n   190\t            (fn []\n   191\t              (engine/handle-put\n   192\t                s0 {:effect :stream/put, :stream sref, :val 1})))))))\n   193\t\n   194\t\n   195\t(defn- scripted-reader-handle\n   196\t  \"A reader that mints `::at` and answers every `next` with `result`.\"\n   197\t  [result]\n   198\t  (reify stream/IDaoStreamReader\n   199\t    (cursor\n   200\t      [_ _]\n   201\t      {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor ::at})\n   202\t\n   203\t    (next [_ _] result)))\n   204\t\n   205\t\n   206\t(deftest refused-read-answers-are-shaped-refusals-test\n   207\t  (testing \"refused is the effect's shaped refusal value, not a throw\"\n   208\t    (let [[sref s0] (engine/attach-resource\n   209\t                      (state)\n   210\t                      (scripted-reader-handle\n   211\t                        {:dao.stream/outcome :dao.stream/refused}))\n   212\t          [cursor-ref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)\n   213\t          r (engine/handle-next s1 {:cursor cursor-ref})]\n   214\t      (is (= {:status :refused\n   215\t              :outcome :dao.stream/refused\n   216\t              :stream-id :stream-0\n   217\t              :cursor-id :cursor-0}\n   218\t             (:value r))\n   219\t          \"the program reads the refusal as data\")\n   220\t      (is (= ::at (get-in (:state r) [:resources :cursor-0 :cursor]))\n   221\t          \"a refused read never moves the cursor cell\")))\n   222\t  (testing \"an outcome outside this contract version is treated as refused\"\n   223\t    (let [[sref s0] (engine/attach-resource\n   224\t                      (state)\n   225\t                      (scripted-reader-handle\n   226\t                        {:dao.stream/outcome :dao.stream/quantum-flux}))\n   227\t          [cursor-ref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)\n   228\t          r (engine/handle-next s1 {:cursor cursor-ref})]\n   229\t      (is (= {:status :refused\n   230\t              :outcome :dao.stream/quantum-flux\n   231\t              :stream-id :stream-0\n   232\t              :cursor-id :cursor-0}\n   233\t             (:value r))\n   234\t          \"an unrecognized outcome is a newer contract, not a defect\")))\n   235\t  (testing \"the declared read defects still throw, as v1 did\"\n   236\t    (let [[sref s0] (engine/attach-resource\n   237\t                      (state)\n   238\t                      (scripted-reader-handle\n   239\t                        {:dao.stream/outcome :dao.stream/cursor-mismatch}))\n   240\t          [cursor-ref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)]\n   241\t      (is (throws? (fn []\n   242\t                     (engine/handle-next s1 {:cursor cursor-ref})))))))\n   243\t\n   244\t\n   245\t;; =============================================================================\n   246\t;; :stream/take does not exist\n   247\t;; =============================================================================\n   248\t\n   249\t(deftest take-is-removed-test\n   250\t  (testing \"A :stream/take effect reaches no branch and no registered handler\"\n   251\t    (is (throws? (fn []\n   252\t                   (engine/handle-effect (state {:modules (module/default-registry)})\n   253\t                                         {:effect :stream/take,\n   254\t                                          :stream {:type :stream-ref,\n   255\t                                                   :id :stream-0}}\n   256\t                                         {}))))))\n   257\t\n   258\t\n   259\t;; =============================================================================\n   260\t;; Nil-fill parameter binding (§7.7.2)\n   261\t;; =============================================================================\n   262\t\n   263\t(deftest bind-params-nil-fills-missing-args-test\n   264\t  (testing \"Every param becomes a key; a param with no arg maps to nil\"\n   265\t    (is (= {'x 1, 'y nil} (engine/bind-params '[x y] [1])))\n   266\t    (is (= {'x nil, 'y nil} (engine/bind-params '[x y] []))))\n   267\t  (testing \"Extra args beyond params are dropped\"\n   268\t    (is (= {'x 1} (engine/bind-params '[x] [1 2 3]))))\n   269\t  (testing \"Exact-arity calls are unaffected\"\n   270\t    (is (= {'x 1, 'y 2} (engine/bind-params '[x y] [1 2])))))\n","exit_code":0,"status":"completed"}}
