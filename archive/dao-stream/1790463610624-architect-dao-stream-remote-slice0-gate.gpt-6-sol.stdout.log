          :cursor-id (:id (:cursor-ref entry))})\n  1398\t    :else (fail \"Stream append failed\"\n  1399\t                {:outcome o, :stream-id (:stream-id entry)})))\n  1400\t\n  1401\t\n  1402\t(defn resume-from-run-queue\n  1403\t  \"Pop first entry from the ready-queue, merge its resource updates into\n  1404\t   the private `:resources` table, and restore VM-specific context.\n  1405\t\n  1406\t   Restoration is dispatched here rather than carried on the entry, so a\n  1407\t   ready entry holds registers, ids, and values — never a closure. The\n  1408\t   terminal-outcome check runs before the restore: a woken retry that ended\n  1409\t   in an outcome the immediate operation raises as an error must fail the\n  1410\t   same way here, not reach Yin code as a value.\n  1411\t\n  1412\t   `restore-fn` is called with three arguments, `base entry val`, where\n  1413\t   `val` is the woken `:value` — the same signature `resume-continuation`\n  1414\t   uses, so one restore serves both engine call sites\n  1415\t   (`yin.vm.engine.md` §7, edit 2).\"\n  1416\t  [state restore-fn]\n  1417\t  (let [run-queue (or (:ready-queue state) [])]\n  1418\t    (when (seq run-queue)\n  1419\t      (let [entry (first run-queue)\n  1420\t            rest-queue (subvec run-queue 1)\n  1421\t            updates (:resource-updates entry)\n  1422\t            ;; a woken entry only ever carries engine-minted keyword keys\n  1423\t            ;; (cursor ids)\n  1424\t            _ (when-let [k (some #(when-not (keyword? %) %) (keys updates))]\n  1425\t                (fail \"Ready entry resource update carries a non-minted key\"\n  1426\t                      {:rule :resource-update-key, :key k}))\n  1427\t            base (assoc state\n  1428\t                        :ready-queue rest-queue\n  1429\t                        :resources (merge (:resources state) updates)\n  1430\t                        :blocked? false\n  1431\t                        :halted? false)]\n  1432\t        