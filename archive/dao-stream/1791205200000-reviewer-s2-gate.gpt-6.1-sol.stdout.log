   214	(defn- spellings
   215	  "Every Python spelling of non-negative integer `n` the tests use."
   216	  [n]
   217	  (let [d (text-in n 10)
   218	        x (text-in n 16)]
   219	    [d
   220	     (grouped d 3)
   221	     (str "0x" x)
   222	     (str "0X" (mixed-case x))
   223	     (str "0x_" (grouped x 4))
   224	     (str "0o" (text-in n 8))
   225	     (str "0O" (grouped (text-in n 8) 2))
   226	     (str "0b" (text-in n 2))
   227	     (str "0B" (grouped (text-in n 2) 8))]))
