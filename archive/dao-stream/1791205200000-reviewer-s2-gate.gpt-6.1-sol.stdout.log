   199	(defn- grouped
   200	  "`s` with an underscore between every `k` characters from the right."
   201	  [s k]
   202	  (let [n (count s)
   203	        head (let [r (rem n k)] (if (zero? r) k r))]
   204	    (str/join "_" (cons (subs s 0 head)
   205	                        (mapv #(subs s % (+ % k)) (range head n k))))))
