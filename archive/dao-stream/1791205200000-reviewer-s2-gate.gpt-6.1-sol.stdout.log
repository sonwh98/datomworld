   262	(deftest spelling-groups-test
   263	  (testing "every spelling of a value: one row set, one byte string, one
   264	            address, the JVM golden on every host"
   265	    (doseq [s groups]
   266	      (let [n (f/value s)
   267	            results (mapv (fn [t]
   268	                            (let [r (rows-of t)]
   269	                              [t r (cfx/bytes->hex (jing/canonical-bytes r))]))
   270	                          (spellings n))
   271	            [_ rows bytes-hex] (first results)]
   272	        (testing s
   273	          (doseq [[t r h] results]
   274	            (is (= rows r) t)
   275	            (is (= bytes-hex h) t))
   276	          (is (= (get group-goldens s) (:root rows))))))))
