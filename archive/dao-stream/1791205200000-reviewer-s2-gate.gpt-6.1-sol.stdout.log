(def ^:private digit-values
  "Each digit character, either letter case, to its value."
  (into {}
        (mapcat (fn [i]
                  (let [c (subs "0123456789abcdefghijklmnopqrstuvwxyz" i (inc i))]
                    [[c i] [(str/upper-case c) i]])))
        (range 36)))


(def ^:private chunk-digits
  "Digits accumulated natively per step: 36^10 < 2^53, so a chunk is
   287	   native-width parser): a native literal up to 2^53 - 1, else
   288	   `(py/int-lit hex)` over canonical lowercase hex, which the AST can
   289	   carry on every host. A decimal token obeys the packet's digit budget;
   290	   with none declared it must stay within 2^53 - 1. Hex, octal and binary
   291	   tokens have no digit budget."
   292	  [ctx n t]
   293	  (let [[radix digits] (int-digits n t)
   294	        c (count digits)
   295	        budget (:max-digits ctx)
   296	        decimal? (= 10 radix)]
   297	    (when (and decimal? budget (> c budget))
   298	      (syntax! n (str "Exceeds the limit (" budget " digits) for integer "
   299	                      "string conversion: value has " c " digits; consider "
   300	                      "hexadecimal for huge integer literals")))
   301	    (let [m (integer/integer-module
   302	              ;; a digit of radix 16 or less is at most 4 bits
   303	              {::integer/max-bits (* 4 c),
   304	               ::integer/max-digits (if decimal? (or budget 16) c)})
   305	          ;; a decimal token's only leading zeros are those of zero
   306	          v ((get m 'parse) (if (and decimal? (str/starts-with? digits "0"))
   307	                              "0"
   308	                              digits)
   309	                            radix)]
   310	      (cond
   311	        (and (not (keyword? v)) (<= ((get m 'compare) v max-safe-int) 0))
   312	        (u/lit v)
   313	        (and decimal? (nil? budget))
   314	        (unsupported! n (str "decimal integer literal beyond 2^53 - 1 "
   315	                             "with no digit budget declared"))
   316	        :else (app* 'py/int-lit (u/lit ((get m 'format) v 16)))))))
