   103	            (test-of
   104	              [:expr [:atom_expr [:atom [:name ["NAME" "print"]]]
   105	                      [:trailer ["OPEN_PAREN" "("]
   106	                       (into [:arglist]
   107	                             (interpose ["COMMA" ","]
   108	                                        (map (fn [e] [:argument (test-of e)])
   109	                                             exprs)))
   110	                       ["CLOSE_PAREN" ")"]]]])]]))
