rc] (mapv attach! [\"a\" \"b\" \"c\"])]\n1984:     {:t t :peer peer :ra ra :rb rb :rc rc :link (link-state ra)}))\n1985: \n1986: \n1987: (defn- confirmed?\n1988:   [r]\n1989:   (some? (:surface @(.-state r))))\n1990: \n1991: \n1992: (deftest attach-probes-share-a-capped-link\n1993:   (testing \"an accepting writer: probes wait on their reflections and\n1994:             are admitted as answers free room\"\n1995:     (let [{:keys [t peer ra rb rc link]} (capped-reflections 1 identity)\n1996:           probes #(count (op-requests (:ab t) :dao.stream/descriptor))]\n1997:       (is (= 1 (held link)) \"one probe sent, none kept past the cap\")\n1998:       (is (= 1 (probes)))\n1999:       (serve! peer)\n2000:       (stream/descriptor rb)\n2001:       (is (confirmed? ra) \"the first probe's answer was filed\")\n2002:       (is (= 2 (probes)) \"b's waiting probe was admitted\")\n2003:       (stream/descriptor rc)\n2004:       (is (= 2 (probes)) \"c's waits while b's is outstanding\")\n2005:       (is (= 1 (held link)))\n2006:       (serve! peer)\n2007:       (stream/descriptor rc)\n2008:       (is (= 3 (probes)))\n2009:       (serve! peer)\n2010:       (stream/descriptor rc)\n2011:       (is (every? confirmed? [ra rb rc]))\n2012:       (is (= 0 (held link)))))\n2013:   (testing \"a writer refusing full: kept probes stay within the cap and\n2014:             each retry makes progress\"\n2015:     (let [{:keys [peer ra rb rc link]}\n2016:           (capped-reflections 2 #(full-then-forward-writer % 3))]\n2017:       (is (= 2 (count (:pending @link))) \"two kept, at the cap\")\n2018:       (is (some? (:probe @(.-state rc))) \"the third waits on its reflection\")\n2019:       (stream/descriptor ra)\n2020:       (is (<= (held link) 2))\n2021:       (stream/descriptor rc)\n2022:       (is (= 2 (count (:outstanding @link)))\n2023:           \"both kept probes were sent, neither blocking the other\")\n2024:       (is (some? (:probe @(.-state rc))))\n2025:       (serve! peer)\n2026