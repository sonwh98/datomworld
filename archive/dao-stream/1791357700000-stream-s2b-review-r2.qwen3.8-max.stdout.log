am.remote/op probe)))\n224:           (is (= [] (:dao.stream.remote/args probe)))\n225:           (is (contains? probe :dao.stream.remote/id))))\n226:       (testing \"descriptor is local: the remote descriptor, the identity\"\n227:         (let [d (stream/descriptor r)]\n228:           (is (= :dao.stream/ok (:dao.stream/outcome d)))\n229:           (is (= \"str-1\" (:dao.stream/identity d)))\n230:           (is (= :dao.stream/remote\n231:                  (get-in d [:dao.stream/descriptor :dao.stream/type])))\n232:           (is (= \"str-1\"\n233:                  (get-in d [:dao.stream/descriptor\n234:                             :dao.stream/identity])))))\n235:       (serve! peer)\n236:       (testing \"cursor :oldest is transport-error, retry?, then ok c0\"\n237:         (is (= {:dao.stream/outcome :dao.stream/transport-error\n238:                 :dao.stream/retry? true}\n239:                (stream/cursor r :dao.stream/oldest))\n240:             \"no answer filed, so the link sends the request\")\n241:         (serve! peer)\n242:         (is (= (stream/cursor s :dao.stream/oldest)\n243:                (stream/cursor r :dao.stream/oldest))\n244:             \"on the next call the drain files the source's own ok\"))\n245:       (let [c0 (:dao.stream/cursor (stream/cursor r :dao.stream/oldest))]\n246:         (testing \"next c0 is blocked, then ok on re-ask\"\n247:           (is (= :dao.stream/blocked\n248:                  (:dao.stream/outcome (stream/next r c0))))\n249:           (serve! peer)\n250:           (is (= (stream/next s c0) (stream/next r c0))\n251:               \"the source's own outcome map, the string verbatim\"))\n252:         (testing \"next past the value is end\"\n253:           (let [c1 (:dao.stream/cursor (stream/next r c0))]\n254:             (is (= :dao.stream/blocked\n255:                    (:dao.stream/outcome (stream/next r c1))))\n256:             (serve! peer)\n257:             (is (= (stream/next s c1) (stream/next r c1)))))\n258:         (testing \"a kept cursor from the reflection is accepted by the\n259:                   source handle\"\n260:           (is (= \"hello\" (:dao.stream/value (stream/next s c0)))\n261:               \"the reflection's cursors are the source's own\"))))))\n262: \n263: \n264: (deftest gap-from-an-evicting-source-crosses-verbatim\n265:   (let [t (toy)\n266:         s (ring 2)\n267:         peer (served-peer {\"ev\" (entry s #{:reader})} t)\n268:         r (:dao.stream/handle (attach (:a-end t) \"ev\" {}))]"}],"deferred":false}}
