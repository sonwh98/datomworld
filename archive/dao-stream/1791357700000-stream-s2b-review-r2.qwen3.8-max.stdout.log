39:    `:ba` carries B's toward A. Each side's end is {:reader r :writer\n40:    w}: A reads ba and writes ab; B's mirror reads ab and writes ba.\"\n41:   []\n42:   (let [ab (ring 64)\n43:         ba (ring 64)\n44:         cd {:dao.stream/type :dao.stream.test/channel\n45:             :dao.stream/identity \"toy-channel\"}]\n46:     {:channel cd\n47:      :ab ab\n48:      :ba ba\n49:      :a-end {:reader ba :writer ab}\n50:      :b-end {:reader ab :writer ba}}))\n51: \n52: \n53: (defn- entry\n54:   \"One table entry: the handle and its declared surface.\"\n55:   [h surface]\n56:   {:handle h :surface surface})\n57: \n58: \n59: (defn- served-peer\n60:   \"Peer B: an atom of the table it serves plus its side of the toy,\n61:    with the mirror step's own cursor held in an atom.\"\n62:   [table t]\n63:   {:table (atom table)\n64:    :b-reader (:reader (:b-end t))\n65:    :b-writer (:writer (:b-end t))\n66:    :mirror (atom (:dao.stream/cursor\n67:                    (stream/cursor (:reader (:b-end t))\n68:                                   :dao.stream/oldest)))})\n69: \n70: \n71: (defn- serve!\n72:   \"One mirror step over everything pending on the toy's request\n73:    buffer.\"\n74:   [peer]\n75:   (swap! (:mirror peer)\n76:          #(remote/mirror-step @(:table peer) (:b-reader peer)\n77:                               % (:b-writer peer))))\n78: \n79: \n80: (defn- attach\n81:   \"Attach one reflection for `identity` through `end`, a channel end\n82:    {:reader r :writer w}, with the attacher's composition data `opts`.\n83:    One call builds one attacher, so one call per toy makes one link.\"\n84:   [end identity opts]\n85:   (let [cd {:dao.stream/type :dao.stream.test/channel\n86:             :dao.stream/identity \"toy-channel\"}\n87:         attach! (remote/attacher\n88:                   (merge {:dao.stream.remote/channels {cd end}} opts))]\n89:     (attach! {:dao.stream/type :dao.stream/remote\n90:               :dao.stream/identity identity\n91:               :dao.stream/channel cd})))\n92: \n93: \n94: (defn- values\n95:   \"Every retained value of `h`, oldest first, by a fresh cursor walk.\"\n96:   [h]\n97:   (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n98:          acc []]\n99:     (let [r (stream/next h c)]\n100:       (if (= :dao.stream/ok (:dao.stream/outcome r))\n101:         (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n102:         acc))))\n103: \n104: \n105: (defn- wire-requests\n106:   \"The request values currently retained on wire buffer `h`, oldest\n107:    first.\"\n108:   [h]\n109:   (filter #(and (map? %) (contains? % :dao.stream.remote/op))\n110:           (values h)))\n111: \n112: \n113: (defn- op-requests\n114:   \"The retained requests on wire buffer `h` whose op is `op`. Ring\n115:    buffers retain what they carried, so counts of the wire's traffic\n116:    are per op.\"\n117:   [h op]\n118:   (filter #(= op (:dao.stream.remote/op %)) (wire-requests h)))\n119: \n120: \n121: (defn- capped-writer\n122:   \"A channel writer that carries values to `h` but refuses, with\n123:    invalid-value, any carrying a more vector: the toy's frame budget\n124:    stops at one outcome per answer.\"\n125:   [h]\n126:   (reify stream/IDaoStreamWriter\n127:     (append!\n128:       [_ v]\n129:       (if (contains? v :dao.stream.remote/more)\n130:         {:dao.stream/outcome :dao.stream/invalid-value}\n131:         (stream/append! h v)))))\n132: \n133: \n134: (defn- dropping-writer\n135:   \"A channel writer that carries values to `h` but silently drops the\n136:    first `n` whose op is one of `ops`, answering ok either way: the\n137:    toy's unreliable channel.\"\n138:   [h n ops]\n139:   (let [left (atom n)]\n140:     (reify stream/IDaoStreamWriter\n141:       (append!\n142:         [_ v]\n143:         (let [drop? (and (pos? @left)\n144:                          (contains? ops (:dao.stream.remote/op v)))]\n145:           (when drop? (swap! left dec))\n146:           (if drop