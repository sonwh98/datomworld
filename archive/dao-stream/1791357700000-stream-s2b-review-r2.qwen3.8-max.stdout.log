 :link (link-state r)}))\n1836: \n1837: \n1838: (deftest drain-budget-bounds-reads-per-operation\n1839:   (let [{:keys [t peer r link]}\n1840:         (listed-reflection [:a :b :c :d :e :f]\n1841:                            {:dao.stream.remote/drain-budget 2})]\n1842:     (is (= {} (:outstanding @link)) \"the probe was drained\")\n1843:     (doseq [c (range 6)]\n1844:       (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next r c)))))\n1845:     (serve! peer)\n1846:     (testing \"one next files two of the six queued answers\"\n1847:       (is (= :a (:dao.stream/value (stream/next r 0))))\n1848:       (is (= 1 (count (:filed @link))) \"the answer for 1 is filed\")\n1849:       (is (= 4 (count (:outstanding @link)))))\n1850:     (testing \"three calls file all, the cursor kept between drains\"\n1851:       (is (= :b (:dao.stream/value (stream/next r 1))))\n1852:       (is (= :c (:dao.stream/value (stream/next r 2))))\n1853:       (is (= {} (:outstanding @link)))\n1854:       (is (= [:d :e :f]\n1855:              (mapv #(:dao.stream/value (stream/next r %)) [3 4 5]))))\n1856:     (is (= 6 (count (op-requests (:ab t) :dao.stream/next)))\n1857:         \"nothing was asked twice\")))\n1858: \n1859: \n1860: (deftest max-outstanding-refuses-a-send-as-full\n1861:   (let [t (toy)\n1862:         attempts (atom 0)\n1863:         ls (remote/links {:dao.stream.remote/channels\n1864:                           {(:channel t)\n1865:                            {:reader (:ba t)\n1866:                             :writer (counting-writer attempts\n1867:                                                      :dao.stream/ok)}}\n1868:                           :dao.stream.remote/max-outstanding 2})\n1869:         r (:dao.stream/handle\n1870:             ((:attach ls) {:dao.stream/type :dao.stream/remote\n1871:                            :dao.stream/identity \"n\"\n1872:                            :dao.stream/channel (:channel t)}))\n1873:         link (link-state r)]\n1874:     (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next r 0))))\n1875:     (is (= 2 @attempts) \"the probe and one next are outstanding\")\n1876:     (is (= 2 (count (:outstanding @link))))\n1877:     (testing \"at the bound nothing more is sent\"\n1878:       (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next r 1))))\n1879:       (is (= {:dao.stream/outcome :dao.stream/transport-error\n1880:               :dao.stream/retry? true}\n1881:              (stream/cursor r :dao.stream/oldest)))\n1882:       (is (= {:dao.stream/outcome :dao.stream/full} (stream/append! r :v))\n1883:           \"nothing crossed: the append's effect is known\")\n1884:       (is (= {:dao.stream/outcome :dao.stream/transport-error\n1885:               :dao.stream/retry? true}\n1886:              ((:resolve ls) (:channel t) \"nm\")))\n1887:       (is (= 2 @attempts))\n1888:       (is (= 2 (count (:outstanding @link)))))\n1889:     (testing \"an answer frees a place\"\n1890:       (stream/append! (:ba t) {:dao.stream.remote/id 1\n1891:                                :dao.stream/identity \"n\"\n1892:                                :dao.stream/outcome :dao.stream/blocked})\n1893:       (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next r 1))))\n1894:       (is (= 3 @attempts) \"the next for 1 was sent\"))))\n1895: \n1896: \n1897: (deftest max-filed-evicts-the-oldest-and-the-reflection-re-asks\n1898:   (let [{:keys [t peer r link]}\n1899:         (listed-reflection [:a :b :c] {:dao.stream.remote/max-filed 2})]\n1900:     (doseq [c (range 3)]\n1901:       (stream/next r c))\n1902:     (serve! peer)\n1903:     (stream/descriptor r)\n1904:     (is (= 2 (count (:filed @link))) \"three filed, the oldest evicted\")\n1905:     (is (= [:b :c] (mapv #(:dao.stream/value (stream/next r %)) [1 2]))\n1906:         \"the kept answers are returned\")\n1907:     (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next r 0)))\n1908:         \"the evicted answer is asked again\")\n1909:     (serve! peer)\n1910:     (is (= :a (:dao.stream/value (stream/next r 0))))\n1911:     (is (= {} (:filed @link)) \"each answer returned once\")\n1912:     (is (= 4 (count (op-requests (:ab t) :dao.stream/next)))\n1913:         \"only the evicted request was sent twice\")))\n1914: \n1915: \n1916: (deftest more-is-clamped-to-the-links-own-budget\n1917:   (doseq [[opts filed installed] [[{:dao.stream.remote/budget 2} 1 1]\n1918:                                   [{} 1 0]\n1919:                                   ;; prefetch only fills free retained\n1920:                                   ;; capacity: the answer itself stays\n1921:                                   [{:dao.stream.remote/budget 4\n1922:                                     :dao.stream.remote/max-filed 2} 1 1]]]\n1923:     (testing (pr-str opts)\n1924:       (let [t (toy)\n1925:             r (:dao.stream/handle (attach (:a-end t) \"n\" opts))\n1926:             link (link-state r)]\n1927:         (stream/next r 0)\n1928:         (stream/append! (:ba t)\n1929:                         {:dao.stream.remote/id 1\n1930:                          :dao.stream/identity \"n\"\n1931:                          :dao.stream/outcome :dao.stream/ok\n1932:                          :dao.stream/value :a\n1933:                          :dao.stream/cursor 1\n1934:                          :dao.stream.remote/more\n1935:                          (mapv (fn [i]\n1936:                                  {:dao.stream/outcome :dao.stream/ok\n1937:                                   :dao.stream/value i\n1938:                                   :dao.stream/cursor (inc i)})\n1939:                                (range 1 6))})\n1940:         (stream/descriptor r)\n1941:         (is (= filed (count (:filed @link))))\n1942:         (is (= installed (count (:filed-cursors @link)))\n1943:             \"the surplus a peer sends is dropped\")))))\n1944: \n1945: \n1946: (deftest an-invalid-link-policy-is-a-composition-error\n1947:   (let [t (toy)]\n1948:     (doseq [k [:dao.stream.remote/drain-budget\n1949:                :dao.stream.remote/max-outstanding"}],"deferred":false}}
