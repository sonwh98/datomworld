\n181:     stream/IDaoStreamReader\n182: \n183:     (cursor\n184:       [_ anchor]\n185:       (case anchor\n186:         :dao.stream/oldest {:dao.stream/outcome :dao.stream/ok\n187:                             :dao.stream/cursor 0}\n188:         :dao.stream/newest {:dao.stream/outcome :dao.stream/ok\n189:                             :dao.stream/cursor (count vs)}\n190:         {:dao.stream/outcome :dao.stream/invalid-anchor}))\n191: \n192:     (next\n193:       [_ c]\n194:       (cond\n195:         (not (integer? c))\n196:         {:dao.stream/outcome :dao.stream/invalid-cursor}\n197: \n198:         (some? (get vs c))\n199:         {:dao.stream/outcome :dao.stream/ok\n200:          :dao.stream/value (get vs c)\n201:          :dao.stream/cursor (inc c)}\n202: \n203:         :else\n204:         {:dao.stream/outcome :dao.stream/blocked}))))\n205: \n206: \n207: ;; =============================================================================\n208: ;; The proof row\n209: ;; =============================================================================\n210: \n211: (deftest the-toy-over-two-ring-buffers\n212:   (let [t (toy)\n213:         s (ring 8)]\n214:     (stream/append! s \"hello\")\n215:     (let [peer (served-peer {\"str-1\" (entry s #{:reader})} t)\n216:           res (attach (:a-end t) \"str-1\" {})\n217:           r (:dao.stream/handle res)]\n218:       (is (= :dao.stream/ok (:dao.stream/outcome res)))\n219:       (is (some? (:dao.stream/attachment res)))\n220:       (testing \"attach sends the descriptor probe, wire-shaped\"\n221:         (let [[probe] (wire-requests (:ab t))]\n222:           (is (= \"str-1\" (:dao.stream/identity probe)))\n223:           (is (= :dao.stream/descriptor (:dao.stream.remote/op probe)))\n224:           (is (= [] (:dao.stream.remote/args probe)))\n225:           (is (contains? probe :dao.stream.remote/id))))\n226:       (testing \"descriptor is local: the remote descriptor, the identity\"\n227:         (let [d (stream/descriptor r)]