 287\t          ci (:dao.stream/cursor (stream/cursor inner :dao.stream/oldest))]\n   288\t      (is (= ci cw) \"the wrapped handle mints the inner handle's cursors\")\n   289\t      (let [rw (stream/next wrapped cw)\n   290\t            ri (stream/next inner ci)]\n   291\t        (is (= :v1 (:dao.stream/value rw))\n   292\t            \"the wrapped handle presents the plaintext\")\n   293\t        (is (= {:cipher/of :v1} (:dao.stream/value ri)))\n   294\t        (is (= (:dao.stream/cursor ri) (:dao.stream/cursor rw))\n   295\t            \"the successor cursor is the inner handle's own\")\n   296\t        (is (= (:dao.stream/outcome ri) (:dao.stream/outcome rw))\n   297\t            \"the outcome kind is untouched\"))))\n   298\t  (testing \"a gap crosses with the source's own recovery cursor\"\n   299\t    (let [inner (ring 2)\n   300\t          wrapped (mw/wrap inner [(encryption)])\n   301\t          ci (:dao.stream/cursor (stream/cursor inner :dao.stream/oldest))\n   302\t          cw (:dao.stream/cursor\n   303\t               (stream/cursor wrapped :dao.stream/oldest))]\n   304\t      (is (= ci cw))\n   305\t      (doseq [v [:v1 :v2 :v3]]\n   306\t        (is (= :dao.stream/ok\n   307\t               (:dao.stream/outcome (stream/append! wrapped v)))))\n   308\t      (let [gi (stream/next inner ci)\n   309\t            gw (stream/next wrapped cw)]\n   310\t        (is (= :dao.stream/gap (:dao.stream/outcome gw)))\n   311\t        (is (= (:dao.stream/cursor gi) (:dao.stream/cursor gw))\n   312\t            \"the recovery cursor is the source's, unparsed and unrewritten\")\n   313\t        (let [rw (stream/next wrapped (:dao.stream/cursor gw))]\n   314\t          (is (= :dao.stream/ok (:dao.stream/outcome rw)))\n   315\t          (is (= :v2 (:dao.stream/value rw))\n   316\t              \"the recovery read presents the retained plaintext\")\n   317\t          (is (= :v3 (:dao.stream/value\n   318\t                       (stream/next wrapped (:dao.stream/cursor rw))))\n   319\t              \"and the walk continues to the newest plaintext\"))))))\n   320\t\n   321\t\n   322\t(deftest an-undecodable-value-is-presented-as-the-marker\n   323\t  (let [inner (ring 4)\n   324\t        wrapped (mw/wrap inner [(encryption)])]\n   325\t    (is (= :dao.stream/ok\n   326\t           (:dao.stream/outcome (stream/append! inner :raw))))\n   327\t    (let [c (:dao.stream/cursor\n   328\t              (stream/cursor wrapped :dao.stream/oldest))\n   329\t          plain (stream/next inner c)\n   330\t          r (stream/next wrapped c)]\n   331\t      (is (= :dao.stream/ok (:dao.stream/outcome r)))\n   332\t      (is (= {:dao.stream.middleware/undecodable true\n   333\t              :dao.stream.middleware/raw :raw}\n   334\t             (:dao.stream/value r)))\n   335\t      (is (= (:dao.stream/cursor plain) (:dao.stream/cursor r))\n   336\t          \"the cursor is untouched: the position is real\")\n   337\t      (is (= (:dao.stream/outcome plain) (:dao.stream/outcome r))\n   338\t          \"the outcome is untouched: the reader decides\"))))\n   339\t\n   340\t\n   341\t(deftest an-untransformable-value-answers-invalid-value-on-the-way-in\n   342\t  (let [inner (ring 4)\n   343\t        encipher (fn [v]\n   344\t                   (if (= v :poison)\n   345\t                     (throw (ex-info \"cannot encode\" {:value v}))\n   346\t                     {:cipher/of v}))\n   347\t        wrapped (mw/wrap inner\n   348\t                         [(mw/encryption\n   349\t                            {:dao.stream.middleware/encipher encipher\n   350\t                             :dao.stream.middleware/decipher decipher})])]\n   351\t    (is (= :dao.stream/invalid-value\n   352\t           (:dao.stream/outcome (stream/append! wrapped :poison))))\n   353\t    (is (empty? (drain-values inner))\n   354\t        \"nothing reached the inner handle and nothing was appended\")))\n   355\t\n   356\t\n   357\t;; =============================================================================\n   358\t;; A filter cannot be expressed\n   359\t;; =============================================================================\n   360\t\n   361\t(deftest a-filter-cannot-be-expressed\n   362\t  (testing \"an out may replace a value, never remove the position\"\n   363\t    (let [inner (ring 4)\n   364\t          tombstone\n   365\t          (spy :filter (atom []) pass-in\n   366\t               (fn [_ctx _req outcome]\n   367\t                 (if (and (= :dao.stream/ok (:dao.stream/outcome outcome))\n   368\t                          (= :drop (:dao.stream/value outcome)))\n   369\t                   (assoc outcome :dao.stream/value :dropped)\n   370\t                   outcome)))\n   371\t          wrapped (mw/wrap inner [tombstone])]\n   372\t      (doseq [v [:a :drop :c]]\n   373\t        (is (= :dao.stream/ok\n   374\t               (:dao.stream/outcome (stream/append! wrapped v)))))\n   375\t      (loop [cw (:dao.stream/cursor\n   376\t                  (stream/cursor wrapped :dao.stream/oldest))\n   377\t             ci (:dao.stream/cursor\n   378\t                  (stream/cursor inner :dao.stream/oldest))\n   379\t             seen []]\n   380\t        (let [rw (stream/next wrapped cw)\n   381\t              ri (stream/next inner ci)]\n   382\t          (if (= :dao.stream/ok (:dao.stream/outcome rw))\n   383\t            (do (is (= (:dao.stream/cursor ri) (:dao.stream/cursor rw))\n   384\t                    \"the chain keeps the inner handle's positions\")\n   385\t                (recur (:dao.stream/cursor rw) (:dao.stream/cursor ri)\n   386\t                       (conj seen (:dao.stream/value rw))))\n   387\t            (is (= [:a :dropped :c] seen)\n   388\t                \"every element is still presented: dropping is not a\n   389\t                 transform's to decide\"))))))\n   390\t  (testing \"declining one element declines the whole operation\"\n   391\t    (let [inner (ring 4)\n   392\t          wrapped (mw/wrap inner\n   393\t                           [(spy :gate (atom []) (refuse-in :filtered)\n   394\t                                 pass-out)])]\n   395\t      (is (= :dao.stream/refused\n   396\t             (:dao.stream/outcome (stream/append! wrapped :drop))))\n   397\t      (is (empty? (drain-values inner))\n   398\t          \"the stream holds nothing: a refusal is data, not a silent\n   399\t           skip\"))))\n   400\t\n   401\t\n   402\t;; =============================================================================\n   403\t;; gate\n   404\t;; =============================================================================\n   405\t\n   406\t(deftest a-gate-with-the-channel-allow-list-refuses\n   407\t  (let [inner (ring 4)\n   408\t        wrapped (mw/wrap inner\n   409\t                         [(mw/gate\n   410\t                            {:dao.stream.middleware/verify\n   411\t                             (mw/channel-allow-list #{\"a\"})\n   412\t                             :dao.stream.middleware/decision (ring 1)})])]\n   413\t    (testing \"a channel on the list passes and the operation lands\"\n   414\t      (is (= :dao.stream/ok\n   415\t             (:dao.stream/outcome\n   416\t               (mw/apply-request wrapped\n   417\t                                 {:dao.stream.remote/channel \"a\"}\n   418\t                                 {:dao.stream.remote/op :dao.stream/append!\n   419\t                                  :dao.stream.remote/args [:v]}))))\n   420\t      (is (= [:v] (drain-values inner))))\n   421\t    (testing \"a channel off the list is refused with its reason\"\n   422\t      (let [r (mw/apply-request wrapped\n   423\t                                {:dao.stream.remote/channel \"z\"}\n   424\t                                {:dao.stream.remote/op :dao.stream/append!\n   425\t                                 :dao.stream.remote/args [:w]})]\n   426\t        (is (= :dao.stream/refused (:dao.stream/outcome r)))\n   427\t        (is (= :dao.stream.middleware/channel-not-allowed\n   428\t               (:dao.stream.middleware/reason r))))\n   429\t      (is (= [:v] (drain-values inner)) \"nothing was appended\"))\n   430\t    (testing \"a local caller's {} context names no channel and refuses\"\n   431\t      (is (= :dao.stream/refused\n   432\t             (:dao.stream/outcome (stream/append! wrapped :x)))))))\n   433\t\n   434\t\n   435\t(deftest a-gate-reads-the-latest-decision-through-a-capacity-1-medium\n   436\t  (let [medium (ring 1)\n   437\t        seen (atom [])\n   438\t        gate-mw (mw/gate\n   439\t                  {:dao.stream.middleware/verify\n   440\t                   (fn [d _ctx _req] (swap! seen conj d) nil)\n   441\t                   :dao.stream.middleware/decision medium})\n   442\t        target (ring 4)\n   443\t        wrapped (mw/wrap target [gate-mw])\n   444\t        ;; One operation per gate pass: the cursor is the target's own,\n   445\t        ;; minted once, and every read! is one next through the gate.\n   446\t        c0 (:dao.stream/cursor (stream/cursor target :dao.stream/oldest))\n   447\t        read! (fn []\n   448\t                (mw/apply-request wrapped {}\n   449\t                                  {:dao.stream.remote/op :dao.stream/next\n   450\t                                   :dao.stream.remote/args [c0]}))]\n   451\t    (is (= :dao.stream/blocked (:dao.stream/outcome (read!))))\n   452\t    (is (= [{:dao.stream.middleware/none true}] @seen)\n   453\t        \"the medium has published nothing yet\")\n   454\t    (stream/append! medium :d1)\n   455\t    (read!)\n   456\t    (is (= [{:dao.stream.middleware/none true} :d1] @seen))\n   457\t    ;; Two further decisions evict :d1; the gate's cursor spans the\n   458\t    ;; eviction of :d2 as well.\n   459\t    (stream/append! medium :d2)\n   460\t    (stream/append! medium :d3)\n   461\t    (read!)\n   462\t    (is (= [{:dao.stream.middleware/none true} :d1 :d3] @seen)\n   463\t        \"the latest decision, recovered through the eviction\")))\n   464\t\n   465\t\n   466\t(deftest the-gate-decision-read-lifecycle\n   467\t  (testing \"the mint happens once, at gate construction\"\n   468\t    (let [calls (atom [])]\n   469\t      (mw/gate {:dao.stream.middleware/verify (fn [_ _ _] nil)\n   470\t                :dao.stream.middleware/decision\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '130,270p' src/cljc/dao/stream.cljc | nl -ba -v130\"","aggregated_output":"   130\t   :cursor, :next, :append!, :close!). Supports aliases without '!'.\"\n   131\t  [op]\n   132\t  (case op\n   133\t    (:create :create!) :create!\n   134\t    (:attach :attach!) :attach!\n   135\t    (:descriptor) :descriptor\n   136\t    (:cursor) :cursor\n   137\t    (:next) :next\n   138\t    (:append :append!) :append!\n   139\t    (:close :close!) :close!\n   140\t    nil))\n   141\t\n   142\t\n   143\t;; =============================================================================\n   144\t;; Handle Protocols (Five Handle Operations)\n   145\t;; =============================================================================\n   146\t\n   147\t(defprotocol IDaoStreamDescriptor\n   148\t  \"Universal reachability and identity projection. Belongs to no surface:\n   149\t   implemented by every handle regardless of declared reader/writer/closable surfaces.\"\n   150\t\n   151\t  (descriptor\n   152\t    [handle]\n   153\t    \"Returns descriptor outcome map:\n   154\t     {:dao.stream/outcome :dao.stream/ok\n   155\t      :dao.stream/descriptor <portable-descriptor>\n   156\t      :dao.stream/identity <logical-stream-identity>}\"))\n   157\t\n   158\t\n   159\t(defprotocol IDaoStreamReader\n   160\t  \"Reader surface: positioned, non-destructive observation via immutable cursors.\"\n   161\t\n   162\t  (cursor\n   163\t    [handle anchor]\n   164\t    \"Mint an immutable cursor from anchor (:dao.stream/oldest, :dao.stream/newest,\n   165\t     or transport-specific anchor).\n   166\t     Returns outcome map with :dao.stream/cursor on :dao.stream/ok.\")\n   167\t\n   168\t  (next\n   169\t    [handle cursor]\n   170\t    \"Read the value at cursor position. Total and non-blocking.\n   171\t     Returns read outcome map.\"))\n   172\t\n   173\t\n   174\t(defprotocol IDaoStreamWriter\n   175\t  \"Writer surface: append values to the sequence this handle's writer surface is on.\"\n   176\t\n   177\t  (append!\n   178\t    [handle val]\n   179\t    \"Append val to the sequence. Total and non-blocking.\n   180\t     Returns write outcome map.\"))\n   181\t\n   182\t\n   183\t(defprotocol IDaoStreamClosable\n   184\t  \"Closable surface: close what this handle is on (logical stream or attachment).\n   185\t   Idempotent.\"\n   186\t\n   187\t  (close!\n   188\t    [handle]\n   189\t    \"Closes what this handle is on. Irrevocable.\n   190\t     Returns outcome map {:dao.stream/outcome :dao.stream/ok}.\"))\n   191\t\n   192\t\n   193\t;; =============================================================================\n   194\t;; Surface Inspection & Gating\n   195\t;; =============================================================================\n   196\t\n   197\t(defn reader?\n   198\t  \"True if handle implements the reader surface (IDaoStreamReader).\"\n   199\t  [handle]\n   200\t  (satisfies? IDaoStreamReader handle))\n   201\t\n   202\t\n   203\t(defn writer?\n   204\t  \"True if handle implements the writer surface (IDaoStreamWriter).\"\n   205\t  [handle]\n   206\t  (satisfies? IDaoStreamWriter handle))\n   207\t\n   208\t\n   209\t(defn closable?\n   210\t  \"True if handle implements the closable surface (IDaoStreamClosable).\"\n   211\t  [handle]\n   212\t  (satisfies? IDaoStreamClosable handle))\n   213\t\n   214\t\n   215\t(defn descriptor?\n   216\t  \"True if handle implements IDaoStreamDescriptor.\"\n   217\t  [handle]\n   218\t  (satisfies? IDaoStreamDescriptor handle))\n   219\t\n   220\t\n   221\t(defn declared-surfaces\n   222\t  \"Returns set of public surfaces implemented by handle:\n   223\t   subset of #{:reader :writer :closable}.\"\n   224\t  [handle]\n   225\t  (cond-> #{}\n   226\t    (reader? handle) (conj :reader)\n   227\t    (writer? handle) (conj :writer)\n   228\t    (closable? handle) (conj :closable)))\n   229\t\n   230\t\n   231\t;; =============================================================================\n   232\t;; Result Convention & Envelope Validation\n   233\t;; =============================================================================\n   234\t\n   235\t(defn qualified-keyword?*\n   236\t  \"True if x is a qualified keyword. Portable across CLJ, CLJS, CLJD.\"\n   237\t  [x]\n   238\t  (boolean (and (keyword? x) (namespace x))))\n   239\t\n   240\t\n   241\t(defn outcome-map?\n   242\t  \"True if x is an open outcome map with a qualified keyword under :dao.stream/outcome.\"\n   243\t  [x]\n   244\t  (and (map? x)\n   245\t       (qualified-keyword?* (:dao.stream/outcome x))))\n   246\t\n   247\t\n   248\t(defn validate-outcome\n   249\t  \"Validates an operation outcome against contract requirements.\n   250\t   Returns nil if valid, or a failure map describing the defect if invalid.\"\n   251\t  [op result]\n   252\t  (if-let [canon-op (canonical-op op)]\n   253\t    (cond\n   254\t      (not (outcome-map? result))\n   255\t      {:valid? false :error :invalid-outcome-map :operation canon-op :result result}\n   256\t\n   257\t      :else\n   258\t      (let [outcome (:dao.stream/outcome result)\n   259\t            allowed (get operation-outcomes canon-op)]\n   260\t        (cond\n   261\t          (not (contains? allowed outcome))\n   262\t          {:valid? false\n   263\t           :error :unauthorized-outcome\n   264\t           :operation canon-op\n   265\t           :outcome outcome\n   266\t           :allowed allowed}\n   267\t\n   268\t          :else\n   269\t          (let [req-keys (get outcome-required-keys [canon-op outcome] #{})\n   270\t                missing (into #{} (remove #(contains? result %) req-keys))]\n","exit_code":0,"status":"completed"}}
