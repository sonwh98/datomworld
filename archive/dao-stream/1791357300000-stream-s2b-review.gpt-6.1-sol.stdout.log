\n   424\t          (swap! link update :pending dissoc id))\n   425\t\n   426\t      (and (= :dao.stream/full (:dao.stream/outcome r))\n   427\t           (= :dao.stream/descriptor (:dao.stream.remote/op req)))\n   428\t      (swap! link assoc-in [:pending id]\n   429\t             {:req req :reflection refl}))\n   430\t    r))\n   431\t\n   432\t\n   433\t(defn- count-ask!\n   434\t  \"Count one further ask of the outstanding request `id`; on reaching\n   435\t   the link's resend-after k, re-send it once -- the same id, a\n   436\t   duplicate of an idempotent operation, which recomputes the same or a\n   437\t   later, equally true answer -- and start counting afresh. append! is\n   438\t   never re-sent: it never stays outstanding beyond its send.\"\n   516\t   reflection of the same stream returns the source's own outcome\n   517\t   without a request. The identity is half of the key: two served\n   518\t   identities can carry equal cursor values, and an outcome belongs to\n   519\t   its own stream. At most the link's own budget k less one are\n   520\t   installed -- the answer itself is the first of k -- and none when\n   521\t   the link stamped no budget: the surplus a peer sends is dropped.\n   522\t   Each installed outcome is aged after its answer's id, in order.\"\n   523\t  [link answer]\n   524\t  (let [identity (:dao.stream/identity answer)\n   525\t        id (:dao.stream.remote/id answer)\n   526\t        k (:budget @link)\n   527\t        asked (if (and (integer? k) (pos? k)) (dec k) 0)]\n   528\t    (loop [cur (:dao.stream/cursor answer)\n   529\t           more (take asked (:dao.stream.remote/more answer))\n   530\t           i 1]\n   531\t      (when (and cur (seq more))\n   532\t        (let [[o & further] more]\n   533\t          (swap! link assoc-in [:filed-cursors [identity cur]]\n   534\t                 {:outcome o :age [id i]})\n   535\t          (recur (:dao.stream/cursor o) further (inc i)))))))\n   536\t\n   537\t\n   538\t(defn- ev