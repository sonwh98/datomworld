{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/dao/stream/middleware_test.cljc | sed -n '1,180p;270,403p;603,760p'\"","aggregated_output":"     1\t(ns dao.stream.middleware-test\n     2\t  \"The middleware slice: the position rule under a value cipher over a\n     3\t   ring buffer; the allow-list gate refusing with :dao.stream/refused; a\n     4\t   gate reading the latest decision through a capacity-1 medium after\n     5\t   eviction; a filter that cannot be expressed, a violating out\n     6\t   raising; and the operation rules of apply-request and wrap, the\n     7\t   short-circuit ordering, the failure markers, the gate's wrap-minted\n     8\t   decision-read lifecycle, metering and present.\"\n     9\t  (:require [clojure.test :refer [deftest is testing]]\n    10\t            [dao.stream :as stream]\n    11\t            [dao.stream.middleware :as mw]\n    12\t            [dao.stream.ringbuffer :as ringbuffer]))\n    13\t\n    14\t\n    15\t;; =============================================================================\n    16\t;; Test support\n    17\t;; =============================================================================\n    18\t\n    19\t(defn- ring\n    20\t  \"An open owner ring-buffer handle with the given capacity.\"\n    21\t  [capacity]\n    22\t  (:dao.stream/handle\n    23\t    (ringbuffer/create! {:dao.stream/type :dao.stream/ringbuffer\n    24\t                         :dao.stream.ringbuffer/capacity capacity})))\n    25\t\n    26\t\n    27\t(defn- drain-values\n    28\t  \"Every retained value of `h`, oldest first, by a fresh cursor walk.\"\n    29\t  [h]\n    30\t  (loop [c (:dao.stream/cursor (stream/cursor h :dao.stream/oldest))\n    31\t         acc []]\n    32\t    (let [r (stream/next h c)]\n    33\t      (if (= :dao.stream/ok (:dao.stream/outcome r))\n    34\t        (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r)))\n    35\t        acc))))\n    36\t\n    37\t\n    38\t(defn- encipher\n    39\t  \"The test cipher's encipher half: a tagged map, total and invertible.\"\n    40\t  [v]\n    41\t  {:cipher/of v})\n    42\t\n    43\t\n    44\t(defn- decipher\n    45\t  \"The test cipher's decipher half: it throws on anything that is not\n    46\t   its own ciphertext, as a library cipher fails on a corrupt value.\"\n    47\t  [v]\n    48\t  (if (and (map? v) (contains? v :cipher/of))\n    49\t    (:cipher/of v)\n    50\t    (throw (ex-info \"undecipherable\" {:value v}))))\n    51\t\n    52\t\n    53\t(defn- encryption\n    54\t  \"The spec's value-encryption exemplar over the test cipher.\"\n    55\t  []\n    56\t  (mw/encryption {:dao.stream.middleware/encipher encipher\n    57\t                  :dao.stream.middleware/decipher decipher}))\n    58\t\n    59\t\n    60\t(defn- recording-handle\n    61\t  \"A reader, writer and closable handle recording every protocol call in\n    62\t   `calls` and answering fixed contract-valid outcomes.\"\n    63\t  [calls]\n    64\t  (reify\n    65\t    stream/IDaoStreamDescriptor\n    66\t    (descriptor\n    67\t      [_]\n    68\t      (swap! calls conj :descriptor)\n    69\t      {:dao.stream/outcome :dao.stream/ok\n    70\t       :dao.stream/descriptor {:dao.stream/type :test/only\n    71\t                               :dao.stream/identity :inner}\n    72\t       :dao.stream/identity :inner})\n    73\t\n    74\t\n    75\t    stream/IDaoStreamReader\n    76\t\n    77\t    (cursor\n    78\t      [_ anchor]\n    79\t      (swap! calls conj [:cursor anchor])\n    80\t      {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor :minted})\n    81\t\n    82\t    (next\n    83\t      [_ c]\n    84\t      (swap! calls conj [:next c])\n    85\t      {:dao.stream/outcome :dao.stream/ok\n    86\t       :dao.stream/value :inner-value\n    87\t       :dao.stream/cursor :successor})\n    88\t\n    89\t\n    90\t    stream/IDaoStreamWriter\n    91\t\n    92\t    (append!\n    93\t      [_ v]\n    94\t      (swap! calls conj [:append! v])\n    95\t      {:dao.stream/outcome :dao.stream/ok})\n    96\t\n    97\t\n    98\t    stream/IDaoStreamClosable\n    99\t\n   100\t    (close!\n   101\t      [_]\n   102\t      (swap! calls conj :close!)\n   103\t      {:dao.stream/outcome :dao.stream/ok})))\n   104\t\n   105\t\n   106\t(defn- spy\n   107\t  \"A middleware recording [:in name] / [:out name] in `log` around the\n   108\t   given transform behavior.\"\n   109\t  [name log in-fn out-fn]\n   110\t  {:dao.stream.middleware/in\n   111\t   (fn [ctx req] (swap! log conj [:in name]) (in-fn ctx req))\n   112\t   :dao.stream.middleware/out\n   113\t   (fn [ctx req outcome]\n   114\t     (swap! log conj [:out name])\n   115\t     (out-fn ctx req outcome))})\n   116\t\n   117\t\n   118\t(defn- pass-in\n   119\t  [_ctx req]\n   120\t  req)\n   121\t\n   122\t\n   123\t(defn- pass-out\n   124\t  [_ctx _req outcome]\n   125\t  outcome)\n   126\t\n   127\t\n   128\t(defn- refuse-in\n   129\t  \"An `in` that short-circuits with a refused outcome naming `reason`.\"\n   130\t  [reason]\n   131\t  (fn [_ctx _req]\n   132\t    {:dao.stream/outcome :dao.stream/refused\n   133\t     :dao.stream.middleware/reason reason}))\n   134\t\n   135\t\n   136\t(defn- scripted-medium\n   137\t  \"A reader-only decision medium: each `cursor` and `next` call is\n   138\t   recorded in `calls` and answered by popping the head of the matching\n   139\t   queue atom.\"\n   140\t  [calls cursors reads]\n   141\t  (reify\n   142\t    stream/IDaoStreamReader\n   143\t    (cursor\n   144\t      [_ anchor]\n   145\t      (swap! calls conj [:cursor anchor])\n   146\t      (let [[r & more] @cursors]\n   147\t        (reset! cursors more)\n   148\t        r))\n   149\t\n   150\t    (next\n   151\t      [_ c]\n   152\t      (swap! calls conj [:next c])\n   153\t      (let [[r & more] @reads]\n   154\t        (reset! reads more)\n   155\t        r))))\n   156\t\n   157\t\n   158\t(defn- ok-cursor\n   159\t  \"A scripted :ok cursor answer for `c`.\"\n   160\t  [c]\n   161\t  {:dao.stream/outcome :dao.stream/ok :dao.stream/cursor c})\n   162\t\n   163\t\n   164\t(defn- ok-read\n   165\t  \"A scripted :ok read answer of `v` with successor cursor `c`.\"\n   166\t  [v c]\n   167\t  {:dao.stream/outcome :dao.stream/ok\n   168\t   :dao.stream/value v :dao.stream/cursor c})\n   169\t\n   170\t\n   171\t(defn- gap-read\n   172\t  \"A scripted :gap read answer with recovery cursor `c`.\"\n   173\t  [c]\n   174\t  {:dao.stream/outcome :dao.stream/gap :dao.stream/cursor c})\n   175\t\n   176\t\n   177\t;; =============================================================================\n   178\t;; apply-request\n   179\t;; =============================================================================\n   180\t\n   270\t      (is (stream/closable? w)))))\n   271\t\n   272\t\n   273\t;; =============================================================================\n   274\t;; The position rule under a value cipher over a ring buffer\n   275\t;; =============================================================================\n   276\t\n   277\t(deftest a-value-cipher-preserves-positions-cursors-and-outcomes\n   278\t  (let [inner (ring 4)\n   279\t        wrapped (mw/wrap inner [(encryption)])]\n   280\t    (is (= :dao.stream/ok\n   281\t           (:dao.stream/outcome (stream/append! wrapped :v1))))\n   282\t    (is (= :dao.stream/ok\n   283\t           (:dao.stream/outcome (stream/append! wrapped :v2))))\n   284\t    (is (= [{:cipher/of :v1} {:cipher/of :v2}] (drain-values inner))\n   285\t        \"the inner handle stores only ciphertext\")\n   286\t    (let [cw (:dao.stream/cursor\n   287\t               (stream/cursor wrapped :dao.stream/oldest))\n   288\t          ci (:dao.stream/cursor (stream/cursor inner :dao.stream/oldest))]\n   289\t      (is (= ci cw) \"the wrapped handle mints the inner handle's cursors\")\n   290\t      (let [rw (stream/next wrapped cw)\n   291\t            ri (stream/next inner ci)]\n   292\t        (is (= :v1 (:dao.stream/value rw))\n   293\t            \"the wrapped handle presents the plaintext\")\n   294\t        (is (= {:cipher/of :v1} (:dao.stream/value ri)))\n   295\t        (is (= (:dao.stream/cursor ri) (:dao.stream/cursor rw))\n   296\t            \"the successor cursor is the inner handle's own\")\n   297\t        (is (= (:dao.stream/outcome ri) (:dao.stream/outcome rw))\n   298\t            \"the outcome kind is untouched\"))))\n   299\t  (testing \"a gap crosses with the source's own recovery cursor\"\n   300\t    (let [inner (ring 2)\n   301\t          wrapped (mw/wrap inner [(encryption)])\n   302\t          ci (:dao.stream/cursor (stream/cursor inner :dao.stream/oldest))\n   303\t          cw (:dao.stream/cursor\n   304\t               (stream/cursor wrapped :dao.stream/oldest))]\n   305\t      (is (= ci cw))\n   306\t      (doseq [v [:v1 :v2 :v3]]\n   307\t        (is (= :dao.stream/ok\n   308\t               (:dao.stream/outcome (stream/append! wrapped v)))))\n   309\t      (let [gi (stream/next inner ci)\n   310\t            gw (stream/next wrapped cw)]\n   311\t        (is (= :dao.stream/gap (:dao.stream/outcome gw)))\n   312\t        (is (= (:dao.stream/cursor gi) (:dao.stream/cursor gw))\n   313\t            \"the recovery cursor is the source's, unparsed and unrewritten\")\n   314\t        (let [rw (stream/next wrapped (:dao.stream/cursor gw))]\n   315\t          (is (= :dao.stream/ok (:dao.stream/outcome rw)))\n   316\t          (is (= :v2 (:dao.stream/value rw))\n   317\t              \"the recovery read presents the retained plaintext\")\n   318\t          (is (= :v3 (:dao.stream/value\n   319\t                       (stream/next wrapped (:dao.stream/cursor rw))))\n   320\t              \"and the walk continues to the newest plaintext\"))))))\n   321\t\n   322\t\n   323\t(deftest an-undecodable-value-is-presented-as-the-marker\n   324\t  (let [inner (ring 4)\n   325\t        wrapped (mw/wrap inner [(encryption)])]\n   326\t    (is (= :dao.stream/ok\n   327\t           (:dao.stream/outcome (stream/append! inner :raw))))\n   328\t    (let [c (:dao.stream/cursor\n   329\t              (stream/cursor wrapped :dao.stream/oldest))\n   330\t          plain (stream/next inner c)\n   331\t          r (stream/next wrapped c)]\n   332\t      (is (= :dao.stream/ok (:dao.stream/outcome r)))\n   333\t      (is (= {:dao.stream.middleware/undecodable true\n   334\t              :dao.stream.middleware/raw :raw}\n   335\t             (:dao.stream/value r)))\n   336\t      (is (= (:dao.stream/cursor plain) (:dao.stream/cursor r))\n   337\t          \"the cursor is untouched: the position is real\")\n   338\t      (is (= (:dao.stream/outcome plain) (:dao.stream/outcome r))\n   339\t          \"the outcome is untouched: the reader decides\"))))\n   340\t\n   341\t\n   342\t(deftest an-untransformable-value-answers-invalid-value-on-the-way-in\n   343\t  (let [inner (ring 4)\n   344\t        encipher (fn [v]\n   345\t                   (if (= v :poison)\n   346\t                     (throw (ex-info \"cannot encode\" {:value v}))\n   347\t                     {:cipher/of v}))\n   348\t        wrapped (mw/wrap inner\n   349\t                         [(mw/encryption\n   350\t                            {:dao.stream.middleware/encipher encipher\n   351\t                             :dao.stream.middleware/decipher decipher})])]\n   352\t    (is (= :dao.stream/invalid-value\n   353\t           (:dao.stream/outcome (stream/append! wrapped :poison))))\n   354\t    (is (empty? (drain-values inner))\n   355\t        \"nothing reached the inner handle and nothing was appended\")))\n   356\t\n   357\t\n   358\t;; =============================================================================\n   359\t;; A filter cannot be expressed\n   360\t;; =============================================================================\n   361\t\n   362\t(deftest a-filter-cannot-be-expressed\n   363\t  (testing \"an out may replace a value, never remove the position\"\n   364\t    (let [inner (ring 4)\n   365\t          tombstone\n   366\t          (spy :filter (atom []) pass-in\n   367\t               (fn [_ctx _req outcome]\n   368\t                 (if (and (= :dao.stream/ok (:dao.stream/outcome outcome))\n   369\t                          (= :drop (:dao.stream/value outcome)))\n   370\t                   (assoc outcome :dao.stream/value :dropped)\n   371\t                   outcome)))\n   372\t          wrapped (mw/wrap inner [tombstone])]\n   373\t      (doseq [v [:a :drop :c]]\n   374\t        (is (= :dao.stream/ok\n   375\t               (:dao.stream/outcome (stream/append! wrapped v)))))\n   376\t      (loop [cw (:dao.stream/cursor\n   377\t                  (stream/cursor wrapped :dao.stream/oldest))\n   378\t             ci (:dao.stream/cursor\n   379\t                  (stream/cursor inner :dao.stream/oldest))\n   380\t             seen []]\n   381\t        (let [rw (stream/next wrapped cw)\n   382\t              ri (stream/next inner ci)]\n   383\t          (if (= :dao.stream/ok (:dao.stream/outcome rw))\n   384\t            (do (is (= (:dao.stream/cursor ri) (:dao.stream/cursor rw))\n   385\t                    \"the chain keeps the inner handle's positions\")\n   386\t                (recur (:dao.stream/cursor rw) (:dao.stream/cursor ri)\n   387\t                       (conj seen (:dao.stream/value rw))))\n   388\t            (is (= [:a :dropped :c] seen)\n   389\t                \"every element is still presented: dropping is not a\n   390\t                 transform's to decide\"))))))\n   391\t  (testing \"declining one element declines the whole operation\"\n   392\t    (let [inner (ring 4)\n   393\t          wrapped (mw/wrap inner\n   394\t                           [(spy :gate (atom []) (refuse-in :filtered)\n   395\t                                 pass-out)])]\n   396\t      (is (= :dao.stream/refused\n   397\t             (:dao.stream/outcome (stream/append! wrapped :drop))))\n   398\t      (is (empty? (drain-values inner))\n   399\t          \"the stream holds nothing: a refusal is data, not a silent\n   400\t           skip\"))))\n   401\t\n   402\t\n   403\t(deftest an-out-that-violates-the-position-rule-raises\n   603\t  (testing \"one recovery read after a gap, then the latest value\"\n   604\t    (let [calls (atom [])\n   605\t          medium (scripted-medium calls\n   606\t                                  (atom [(ok-cursor :c0)])\n   607\t                                  (atom [(gap-read :c9)\n   608\t                                         (ok-read :d2 :c10)\n   609\t                                         {:dao.stream/outcome\n   610\t                                          :dao.stream/blocked}]))\n   611\t          seen (atom [])\n   612\t          wrapped (mw/wrap (ring 4)\n   613\t                           [(mw/gate\n   614\t                              {:dao.stream.middleware/verify\n   615\t                               (fn [d _ctx _req] (swap! seen conj d) nil)\n   616\t                               :dao.stream.middleware/decision medium})])]\n   617\t      (stream/next wrapped :c)\n   618\t      (stream/next wrapped :c)\n   619\t      (is (= [:d2 :d2] @seen))\n   620\t      (is (= [[:cursor :dao.stream/oldest] [:next :c0] [:next :c9] [:next :c10]]\n   621\t             @calls)\n   622\t          \"the gap adopts the recovery cursor and reads it once\")))\n   623\t  (testing \"a gap recovered by a gap stays without a value, no third read\"\n   624\t    (let [calls (atom [])\n   625\t          medium (scripted-medium calls\n   626\t                                  (atom [(ok-cursor :c0)])\n   627\t                                  (atom [(gap-read :c9)\n   628\t                                         (gap-read :c11)\n   629\t                                         {:dao.stream/outcome\n   630\t                                          :dao.stream/blocked}]))\n   631\t          seen (atom [])\n   632\t          wrapped (mw/wrap (ring 4)\n   633\t                           [(mw/gate\n   634\t                              {:dao.stream.middleware/verify\n   635\t                               (fn [d _ctx _req] (swap! seen conj d) nil)\n   636\t                               :dao.stream.middleware/decision medium})])]\n   637\t      (stream/next wrapped :c)\n   638\t      (stream/next wrapped :c)\n   639\t      (is (= [{:dao.stream.middleware/none true}\n   640\t              {:dao.stream.middleware/none true}] @seen))\n   641\t      (is (= [[:cursor :dao.stream/oldest] [:next :c0] [:next :c9] [:next :c11]]\n   642\t             @calls)\n   643\t          \"the second recovery cursor is adopted, never read twice\")))\n   644\t  (testing \"a non-ok read clears cursor and value; the mint retries afresh\"\n   645\t    (let [calls (atom [])\n   646\t          medium (scripted-medium\n   647\t                   calls\n   648\t                   (atom [(ok-cursor :c0) (ok-cursor :c1)])\n   649\t                   (atom [{:dao.stream/outcome :dao.stream/cursor-mismatch}\n   650\t                          (ok-read :d3 :c2)]))\n   651\t          seen (atom [])\n   652\t          wrapped (mw/wrap (ring 4)\n   653\t                           [(mw/gate\n   654\t                              {:dao.stream.middleware/verify\n   655\t                               (fn [d _ctx _req] (swap! seen conj d) nil)\n   656\t                               :dao.stream.middleware/decision medium})])]\n   657\t      (stream/next wrapped :c)\n   658\t      (stream/next wrapped :c)\n   659\t      (is (= [{:dao.stream.middleware/none true} :d3] @seen))\n   660\t      (is (= [[:cursor :dao.stream/oldest] [:next :c0]\n   661\t              [:cursor :dao.stream/oldest] [:next :c1]]\n   662\t             @calls)\n   663\t          \"the next operation mints afresh\")))\n   664\t  (testing \"nil passes the request through; a reason short-circuits\"\n   665\t    (let [calls (atom [])\n   666\t          inner-calls (atom [])\n   667\t          medium (scripted-medium\n   668\t                   calls\n   669\t                   (atom [(ok-cursor :c0)])\n   670\t                   (atom [(ok-read :good :c1) (ok-read :bad :c2)]))\n   671\t          wrapped (mw/wrap\n   672\t                    (recording-handle inner-calls)\n   673\t                    [(mw/gate\n   674\t                       {:dao.stream.middleware/verify\n   675\t                        (fn [d _ctx _req] (when (= :bad d) :no))\n   676\t                        :dao.stream.middleware/decision medium})])\n   677\t          op (fn [] (stream/next wrapped :my-c))]\n   678\t      (is (= :dao.stream/ok (:dao.stream/outcome (op))))\n   679\t      (is (= [[:next :my-c]] @inner-calls)\n   680\t          \"a nil answer passes the request through unchanged\")\n   681\t      (is (= :dao.stream/refused (:dao.stream/outcome (op))))\n   682\t      (is (= [[:next :my-c]] @inner-calls)\n   683\t          \"a refusal is a short-circuit: the inner handle is not\n   684\t           consulted\")\n   685\t      (is (= [[:cursor :dao.stream/oldest] [:next :c0] [:next :c1]]\n   686\t             @calls)\n   687\t          \"one medium read per operation, the refusal consuming the last\"))))\n   688\t\n   689\t\n   690\t;; =============================================================================\n   691\t;; The exemplars\n   692\t;; =============================================================================\n   693\t\n   694\t(deftest metering-emits-per-operation-and-keeps-the-outcome\n   695\t  (let [target (ring 4)\n   696\t        meter (ring 8)\n   697\t        wrapped (mw/wrap target\n   698\t                         [(mw/metering {:meter/stream meter\n   699\t                                        :meter/identity \"peer-a\"})])\n   700\t        c (:dao.stream/cursor (stream/cursor wrapped :dao.stream/oldest))]\n   701\t    (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next wrapped c))))\n   702\t    (is (= :dao.stream/ok\n   703\t           (:dao.stream/outcome (stream/append! wrapped :v))))\n   704\t    (is (= [{:meter/identity \"peer-a\"\n   705\t             :meter/op :dao.stream/cursor\n   706\t             :meter/outcome :dao.stream/ok}\n   707\t            {:meter/identity \"peer-a\"\n   708\t             :meter/op :dao.stream/next\n   709\t             :meter/outcome :dao.stream/blocked}\n   710\t            {:meter/identity \"peer-a\"\n   711\t             :meter/op :dao.stream/append!\n   712\t             :meter/outcome :dao.stream/ok}]\n   713\t           (drain-values meter))\n   714\t        \"one emission per operation, outcome returned unchanged\")))\n   715\t\n   716\t\n   717\t(deftest present-associates-the-credential-inward\n   718\t  (let [inner-calls (atom [])\n   719\t        log (atom [])\n   720\t        seen-reqs (atom [])\n   721\t        wrapped (mw/wrap\n   722\t                  (recording-handle inner-calls)\n   723\t                  [(mw/present\n   724\t                     {:dao.stream.middleware/present\n   725\t                      (fn [ctx _req]\n   726\t                        {:token (:dao.stream.remote/channel ctx)})})\n   727\t                   (spy :inside log\n   728\t                        (fn [_ctx req] (swap! seen-reqs conj req) req)\n   729\t                        pass-out)])\n   730\t        outcome (mw/apply-request wrapped\n   731\t                                  {:dao.stream.remote/channel \"a\"}\n   732\t                                  {:dao.stream.remote/op :dao.stream/append!\n   733\t                                   :dao.stream.remote/args [:v]})]\n   734\t    (is (= :dao.stream/ok (:dao.stream/outcome outcome)))\n   735\t    (is (= [{:token \"a\"}]\n   736\t           (mapv :dao.stream.remote/credential @seen-reqs))\n   737\t        \"the credential rides the operation map inward\")\n   738\t    (is (= [[:append! :v]] @inner-calls)\n   739\t        \"the inner handle sees only the operation's own args\")\n   740\t    (is (= [[:in :inside] [:out :inside]] @log)\n   741\t        \"the out transform is identity\")))\n   742\t\n   743\t\n   744\t;; =============================================================================\n   745\t;; The index-interpreter exemplar publishing decisions\n   746\t;; =============================================================================\n   747\t\n   748\t(defn- index-fold\n   749\t  \"The slice's index-interpreter exemplar: folds the retained facts of\n   750\t   `facts` from `cursor`, deriving the running set of allowed channels\n   751\t   and appending each new state to `medium` as a decision. An\n   752\t   interpreter folds streams; only transforms are bound by the four\n   753\t   prohibitions. Returns the fold's final cursor.\"\n   754\t  [facts medium cursor]\n   755\t  (loop [cursor cursor, allowed #{}]\n   756\t    (let [r (stream/next facts cursor)]\n   757\t      (case (:dao.stream/outcome r)\n   758\t        :dao.stream/ok\n   759\t        (let [fact (:dao.stream/value r)\n   760\t              allowed (cond\n","exit_code":0,"status":"completed"}}
