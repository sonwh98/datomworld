{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/repl/require_test.cljc | sed -n '540,830p'\"","aggregated_output":"   540\t  \"What `create-state` answers to the `:link-policy` `policy`: the\n   541\t   thrown error when it refuses it (the assembly fails closed), or\n   542\t   `:accepted` when it does not.\"\n   543\t  [policy]\n   544\t  (try\n   545\t    (repl/create-state {:vm-type :stack :link-policy policy})\n   546\t    :accepted\n   547\t    (catch #?(:cljd Object :clj Exception :cljs js/Error) e\n   548\t      e)))\n   549\t\n   550\t\n   551\t(deftest link-policy-defaults-to-manual-test\n   552\t  (testing \":manual is the default, and nil passes through to it\"\n   553\t    (is (= :manual (:link-policy (repl/create-state {:vm-type :stack}))))\n   554\t    (is (= :manual (:link-policy\n   555\t                     (repl/create-state {:vm-type :stack\n   556\t                                         :link-policy nil})))))\n   557\t  (let [state (repl/create-state {:vm-type :stack})\n   558\t        [pending text] (repl/eval-input state \"(require (quote mod))\")\n   559\t        [held _] (repl/eval-input pending \"(+ 1 2)\")\n   560\t        [held2 _] (repl/eval-input held \"(+ 3 4)\")\n   561\t        [held3 _] (repl/eval-input held2 \"(+ 5 6)\")]\n   562\t    (testing \"the run parks as today and survives every re-check\"\n   563\t      (is (str/includes? text \"pending\"))\n   564\t      (is (some? (:pending-run held3)))\n   565\t      (is (vm/blocked? (:vm held3))))\n   566\t    (testing \"repl-state names the policy and the no-progress checks\"\n   567\t      (is (= [{:name 'mod :policy :manual :checks 3}]\n   568\t             (mapv #(select-keys % [:name :policy :checks])\n   569\t                   (:pending (repl/repl-state held3))))))))\n   570\t\n   571\t\n   572\t(deftest a-function-policy-abandons-after-n-no-progress-checks-test\n   573\t  (let [views (atom [])\n   574\t        policy (fn [view]\n   575\t                 (swap! views conj view)\n   576\t                 (if (>= (:checks view) 2)\n   577\t                   {:abandon :host-gave-up}\n   578\t                   :keep))\n   579\t        state (repl/create-state {:vm-type :stack :link-policy policy})\n   580\t        [pending _] (repl/eval-input state \"(require (quote mod))\")\n   581\t        [held _] (repl/eval-input pending \"(+ 1 2)\")\n   582\t        [freed text] (repl/eval-input held \"(+ 3 4)\")]\n   583\t    (testing \"the policy saw the section 3.1 view, plain data only\"\n   584\t      (is (= [0 1 2] (mapv :checks @views)))\n   585\t      (is (= [0 1 2] (mapv :lines-retained @views)))\n   586\t      (is (= ['mod] (mapv :name (:links (first @views)))))\n   587\t      (is (vector? (:link-id (first (:links (first @views)))))))\n   588\t    (testing \"the second no-progress check ended the require\"\n   589\t      (is (nil? (:pending-run freed)))\n   590\t      (is (str/includes? text \"the session link policy ended the require\"))\n   591\t      (is (str/includes? text \"Module link refused: host-gave-up\"))\n   592\t      (is (not (str/includes? text \"require pending\"))\n   593\t          \"a policy abandon is never mistaken for a run still waiting\"))\n   594\t    (testing \"the retained lines dropped once, reported once\"\n   595\t      (is (str/includes? text \"dropped 2 lines\"))\n   596\t      (is (= 1 (count (re-seq #\"dropped\" text)))))\n   597\t    (testing \"the shell returned to the round the require began in\"\n   598\t      (is (>= (or (:id-counter (:vm freed)) 0) 1)\n   599\t          \"the carried id keeps the next require off the retired one\")\n   600\t      (is (= \"3\" (second (repl/eval-input freed \"(+ 1 2)\")))))))\n   601\t\n   602\t\n   603\t(deftest a-keep-policy-never-ends-a-pending-run-test\n   604\t  (let [state (repl/create-state {:vm-type :stack\n   605\t                                  :link-policy (constantly :keep)})\n   606\t     