s\n   226\t                 (do (vreset! socket (:socket s)) (assoc s :phase :closed)))))\n   227\t      (when (= :failed (invoke-close! @socket 1000 \"dao.stream/detached\"))\n   228\t        (emit-reason! state attachment :ws/error :ws/close-failure))\n   229\t      (outcome :dao.stream/ok))))\n   230\t\n   231\t\n   232\t(defn close-ended!\n   233\t  \"Transport-specific close for a serving composition whose source ended.\n   234\t\n   235\t   Generic `stream/close!` is a reattachable detachment.  This helper sends the\n   236\t   WebSocket ended signal (4000 / `dao.stream/ended`) so the peer can deposit\n   237\t   `:ws/ended`.  The host close callback still owns exactly-once terminal event\n   238\t   delivery, just as it does for generic close.\"\n   239\t  [handle]\n   240\t  (let [state (.-state ^WsHandle handle)\n   450\t\n   451\t(defn- endpoint-target\n   452\t  [endpoint]\n   453\t  (:control (endpoint-state endpoint)))\n   454\t\n   455\t\n   456\t(defn- release-slot!\n   457\t  \"Return one handoff slot to the bounded free pool and forget the connection it\n   458\t   held.  Releasing drops the retained handle: a released slot's acknowledgement\n   459\t   is stale by construction, so nothing may resolve through it afterwards.\"\n   460\t  [endpoint index attachment]\n   461\t  (swap! (:state endpoint)\n   462\t         (fn [s]\n   463\t           (-> s\n   464\t               (update-in [:slots index] dissoc\n   465\t                          :attachment :handle :handle-state :codec :opened-at)\n   466\t               (assoc-in [:slots index :status] :free)\n   467\t               (update :connections dissoc attachment)))))\n   468\t\n   469\t\n   470\t(defn accept-connection!\n   471\t  \"Bounded upgrade callback entry.  A bad path or exhausted slots is closed\n   472\t   immediately; a valid path deposits precisely one host-local offer and waits\n   473\t   for `endpoint-step` to consume a matching acknowledgement.\n   474\t\n   475\t   The socket seam may carry `:ws/subprotocol`, the subprotocol the host\n   476\t   negotiated for this upgrade.  An endpoint serves every profile it was\n   477\t   composed with, concurrently and through the same served paths; a named\n   478\t   subprotocol it does not speak is a refused handshake, never a downgrade,\n   479\t   and an absent name is the Transit default for sockets that negotiated\n   480\t   nothing (direct composition and tests).\"\n   481\t  ([endpoint path socket] (accept-connection! endpoint path socket nil))\n   482\t  ([endpoint path socket now]\n   483\t   (let [{:keys [served]} (:config endpoint)\n   484\t         offered (:ws/subprotocol socket)\n   485\t         codec (if (nil? offered)\n   486\t                 transit/profile\n   487\t                 (get (:codec-index endpoint) offered))\n   488\t         descriptor (get served path)]\n   489\t     (cond\n   490\t       (nil? codec)\n   491\t       (do (invoke-close! socket protocol-close-code \"dao.stream/subprotocol-unsupported\")\n   492\t           {:ws/status :ws/unsupported-subprotocol})\n   493\t\n   494\t       (nil? descriptor)\n   495\t       (do (send-result socket ((:ws/encode codec) {:ws/frame :ws/disclaim}))\n   496\t           (invoke-close! socket disclaim-close-code \"dao.stream/not-found\")\n   497\t           {:ws/status :ws/disclaimed})\n   498\t\n   499\t       :else\n   500\t       (let [state (:state endpoint)\n   501\t             chosen (volatile! nil)]\n   502\t         ;; Claim before depositing.  The offer append may synchronously invoke\n   503\t         ;; host code, so leaving the slot `:free` until after it returns would\n   504\t         ;; permit a second upgrade callback to overwrite the sole offer.\n   505\t         (swap! state (fn [s]\n   506\t                        (if-let [[index slot] (first (keep-indexed (fn [i x]\n   507\t                                                                     (when (= :free (:status x)) [i x]))\n   508\t                                                                   (:slots s)))]\n   509\t                          (do (vreset! chosen [index slot])\n   510\t                              (assoc-in s [:slots index :status] :reserving))\n   511\t                          s)))\n   512\t         (if-not @chosen\n   513\t           (do (invoke-close! socket 1013 \"dao.stream/acceptance-full\")\n   514\t               {:ws/status :ws/full})\n   515\t           (let [[index slot] @chosen\n   516\t                 id (attachment-id)\n   517\t                 [handle hstate] (new-handle descriptor id (endpoint-target endpoint) :pending socket codec)\n   518\t                 offer {:ws/attachment id :ws/event :ws/accepted\n   519\t                        :ws/handle {:dao.stream/handle handle\n   520\t                                    :dao.stream/surface #{:writer :closable}}}\n   521\t                 result (stream/append! (:dao.stream/handle (:offer slot)) offer)]\n   522\t             (if (= :dao.stream/ok (:dao.stream/outcome result))\n   523\t               (do (swap! state (fn [s]\n   524\t                                  (-> s\n   525\t                                      (assoc-in [:slots index :status] :pending)\n   526\t                                      (assoc-in [:slots index :attachment] id)\n   527\t                                      (assoc-in [:slots index :handle] handle)\n   528\t                                      (assoc-in [:slots index :handle-state] hstate)\n   529\t                                      (assoc-in [:slots index :codec] codec)\n   530\t                                      (assoc-in [:slots index :opened-at] now)\n   531\t                                      (assoc-in [:connections id] handle))))\n   532\t                   {:ws/status :ws/pending :ws/attachment id :ws/handle handle})\n   533\t               (do (swap! hstate assoc :phase :closed)\n   534\t                   (invoke-close! socket 1011 \"dao.stream/offer-failed\")\n   535\t                   (release-slot! endpoint index id)\n   536\t                   {:ws/status :ws/offer-failed})))))))))\n   537\t\n   538\t\n   539\t(defn- valid-ack?\n   540\t  [ack attachment]\n   541\t  (and (map? ack)\n   542\t       (= attachment (:ws/attachment ack))\n   543\t       (= :ws/accept (:ws/command ack))\n   544\t       (writer-target? (:ws/deposit ack))\n   545\t       (admission? (:ws/admission ack))))\n   546\t\n   547\t\n   548\t(defn- accept-slot!\n   549\t  [endpoint index slot ack]\n   550\t  (let [hstate (:handle-state slot)\n   551\t        socket (:socket @hstate)\n   552\t        codec (:codec slot)\n   553\t        target (:ws/deposit ack)]\n   554\t    (swap! hstate assoc :deposit target :phase :open :resolution? true)\n   555\t    (let [sent (send-result socket ((:ws/encode codec) {:ws/frame :ws/accept}))]\n   556\t      (when-not (= :dao.stream/ok (:dao.stream/outcome sent))\n   557\t        (swap! hstate assoc :phase :closed)\n   558\t        (invoke-close! socket 1011 \"dao.stream/accept-failed\")\n   559\t        (terminal! hstate (:attachment slot) :ws/closed))\n   560\t      ;; Either way the endpoint is done with this connection: the composition\n   561\t      ;; owns an accepted session, and a failed acceptance is already torn down.\n   562\t      (release-slot! endpoint index (:attachment slot)))))\n   563\t\n   564\t\n   565\t(defn endpoint-step\n   566\t  \"Poll each configured acknowledgement slot once, without waiting or\n   567\t   self-scheduling.  Returns the endpoint after retaining its next cursors.\"\n   568\t  [endpoint now]\n   569\t  ;; A pending connection can be lost before any acknowledgement: the peer\n   570\t  ;; closes, the wire protocol fails, or its own handle is closed.  Each of\n   130\t :ws/event      :ws/payload  ; or :ws/accepted :ws/opened :ws/closed\n   131\t                             ;    :ws/ended :ws/error :ws/not-found\n   132\t                             ;    :ws/transport-error\n   133\t :ws/value      <decoded>    ; payload events only\n   134\t :ws/handle     {:dao.stream/handle <handle>\n   135\t                 :dao.stream/surface #{:writer :closable}}} ; accepted offers only; host-local\n   136\t```\n   137\t\n   138\tThe event kinds divide into four groups. **Acceptance offer** —\n   139\t`:ws/accepted` is deposited once into a serving handoff slot after the\n   140\trequested stream resolves and a server-side attachment handle is\n   141\tconstructed. It carries that writer+closable handle and its declared surface\n   142\tunder `:ws/handle`.\n   143\t**Resolution** — `:ws/opened`, `:ws/not-found`, or `:ws/transport-error` says\n   144\thow a client attachment turned out; exactly one resolution event is deposited\n   145\tper attachment, and it is what a retry policy reads. **Lifecycle** —\n   146\t`:ws/closed` when the connection went away and `:ws/ended` when the served\n   147\tstream itself ended (see Ending a served stream). **Traffic** —\n   148\t`:ws/payload`, carrying `:ws/value`, and `:ws/error`. `:ws/error` is a diagnostic and is never terminal by itself. A survivable socket error may be followed by no lifecycle event; a protocol failure is followed by the terminal event produced when its required teardown completes.\n   149\t\n   150\tOnce an attachment identity exists, **every connection end deposits exactly\n   151\tone terminal lifecycle event at each endpoint**, whether the close was local,\n   152\tremote, or caused by failed deposit, protocol teardown, admission expiry, or\n   153\tendpoint stop. `:ws/ended` is reserved for a served-stream close; every other\n   154\tend is `:ws/closed`. For a code-4000 served-stream close, both the initiating\n   155\tserver endpoint and the observing client endpoint deposit `:ws/ended`. A\n   156\tresolution event, if any, is deposited first. Thus a\n   157\tdisclaimer is observed as `:ws/not-found` followed by `:ws/closed`, while a\n   158\tpre-resolution connection failure is `:ws/transport-error` followed by\n   159\t`:ws/closed`. Only the host close-completion callback deposits the terminal\n   160\tevent, guarded by attachment state so racing close/error callbacks cannot\n   161\tduplicate it.\n   162\t\n   163\tAn accepted offer is host-local and never crosses a serialization boundary.\n   164\tIt does not share the traffic medium's retention window; Serving defines its\n   165\tbounded handoff medium and acknowledgement.\n   166\t\n   167\t**The adapter is the sole host-socket subscriber, and the raw socket never\n   168\tescapes the handle.** On hosts with additive registration it uses\n   169\t`addEventListener` or `.on`; on Dart it owns the socket's single subscription.\n   170\tIn every case it fans transformed events into the composed deposit stream.\n   171\t“Additive” describes adding interpreters and cursors to that stream, never\n   172\tadding another listener to the raw socket.\n   173\t\n   174\tWrapping is not judging — the adapter never looks inside `:ws/value`.\n   175\tDeposited-event envelopes do not cross the wire: attachment correlation is\n   176\tadded locally because each side already knows which socket delivered a frame.\n   177\tWire frames have their own minimal envelope, specified under The Handshake and\n   178\tElements and Serialization, so protocol control cannot be confused with an\n   179\tapplication value.\n   180\t\n   181\t**Traffic granularity is composition data.** A client boundary may reuse one\n   182\tmedium across reconnects because it has one active attachment at a time. A\n   183\tserving endpoint uses one application-traffic medium per accepted attachment,\n   184\tsupplied with the acknowledgement; only endpoint/pre-accept control facts may\n   185\tshare its boundary control medium. This does not alter acceptance handoff:\n   186\tserver writer capabilities travel through bounded handoff slots, never through\n   187\tevictable traffic history.\n   188\t\n   189\t```clojure\n   190\t(def result (ws/attach! {:dao.stream/type :dao.stream/ws\n   191\t                         :ws/host \"example.org\"\n   192\t                         :ws/port 9090\n   193\t                         :ws/path \"/streams/telemetry\"}))\n   194\t\n   195\t(def sock (:dao.stream/handle result))\n   196\t(def me   (:dao.stream/attachment result))   ; keep it — nothing else identifies\n   197\t                                             ; this attachment on the medium\n   198\t\n   199\t;; write: (append! sock msg)\n   200\t;; read:  interpreters observe the medium the host boundary deposits into,\n   201\t;;        keeping events whose :ws/attachment is `me`\n   202\t```\n   203\t\n   204\tNo inbound-event inbox accumulates inside the transport: a hidden per-socket\n   205\tinbox would be a retention window with an eviction policy nobody composed,\n   206\tsized by nobody. Before acceptance acknowledgement, the endpoint retains only\n   207\tthe bounded pending connection associated with each configured handoff slot.\n   208\tAfter acknowledgement, retention of traffic lives exclusively in the\n   209\thost-composed traffic medium, composed and sized by the host.\n   210\t\n   211\tThere are no callback hooks — no `on-open!` / `on-message!` / `on-close!`\n   212\tsurface of the kind the host's own socket API offers. Every socket event\n   213\tbecomes data on the deposit stream — payload and lifecycle (opened, closed by peer, error)\n   214\talike, distinguishable by shape. A boundary deposits everything; whether\n   215\tanyone reads it is not the boundary's concern.\n   216\t\n   217\t### Serving\n   218\t\n   219\tServing is the mirror of attaching, and the deposit model is the same on both\n   220\tends: each accepted connection's inbound messages are deposited — enveloped\n   221\twith that connection's attachment identity, exactly as on the client — onto a\n   222\tstream the host composition wired.\n   223\t\n   224\t**Acceptance is a bounded, acknowledged stream handoff.** At endpoint\n   225\tconstruction, the host composition supplies a fixed, non-empty collection of\n   226\thandoff slots. Each slot contains:\n   227\t\n   228\t- a host-local offer medium with evict-oldest retention and capacity one,\n   229\t  written by the transport and read by the composition; and\n   230\t- a host-local acknowledgement medium with evict-oldest retention and\n   231\t  capacity one, written by the composition and polled by the endpoint driver.\n   232\t\n   233\tThe composition mints the offer cursor it will retain and the acknowledgement\n   234\tcursor `endpoint-step` will retain for every slot before starting the listener.\n   235\tNo connection can therefore deposit an offer before its reader position exists.\n   236\t\n   237\tThe transport has at most one outstanding attachment in a slot. After\n   238\tresolving the requested stream, it assigns a free slot, mints the attachment\n   239\tidentity and handle, retains the connection in the endpoint's bounded\n   240\tpending-accept state, and deposits:\n   241\t\n   242\t```clojure\n   243\t{:ws/attachment <id>\n   244\t :ws/event      :ws/accepted\n   245\t :ws/handle     {:dao.stream/handle <server-side-writer-handle>\n   246\t                 :dao.stream/surface #{:writer :closable}}}\n   247\t```\n   248\t\n   249\tinto that slot's offer medium. It does not send the wire `:ws/accept` frame\n   250\tor enable value delivery yet.\n   251\t\n   252\tThe serving composition polls the known offer slots. After it reads an offer\n   253\tand retains the handle in its own session state, it appends:\n   254\t\n   255\t```clojure\n   256\t{:ws/attachment <id>\n   257\t :ws/command    :ws/accept\n   258\t :ws/deposit    {:dao.stream/handle <writer-handle>\n   259\t                 :dao.stream/surface #{:writer}}\n   260\t :ws/admission  {:retention :evict-oldest\n   567\tEvery existing network path, verified against the tree.\n   568\t\n   569\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   570\t| Existing                                           | Fate             | Why                                                                  |\n   571\t+====================================================+==================+======================================================================+\n   572\t| `dao.stream.ws` and the jvm, node, browser, dart   | subsumed         | Already a channel: writer plus deposit medium. Its accept and        |\n   573\t| adapters                                           |                  | disclaim frames and served-path table become unnecessary once        |\n   574\t|                                                    |                  | `not-found` is an answer per identity; retiring them is a slice.     |\n   575\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   576\t| `dao.stream.serving`                               | retired          | Forwards a source into every accepted socket and flattens a source    |\n   577\t|                                                    |                  | `gap` into a detach: the copy model. Its one consumer is             |\n   578\t|                                                    |                  | `yin.repl.serve`.                                                    |\n   579\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   580\t| `dao.stream.forward`                               | unrelated        | A local copy step; replication by convention, not exposure.          |\n   581\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   582\t| `dao.stream.rpc`                                   | convention-over  | Correlation by id over two streams is section 5's service; its       |\n   583\t|                                                    |                  | state machine may be kept as one such vocabulary over reflections.   |\n   584\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   585\t| `dao.stream.rpc.ws`                                | retired          | Its only job is translating `:ws/` envelopes for rpc; a reflection    |\n   586\t|                                                    |                  | is the channel binding now.                                          |\n   587\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   588\t| `dao.stream.apply` as a wire envelope              | retired          | Its ok-or-error wrapper duplicates the outcome map. The              |\n   589\t|                                                    |                  | `:dao.stream.apply/call` AST node and the VM's FFI bridge keep the    |\n   590\t|                                                    |                  | name and are unrelated to the network.                               |\n   591\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   592\t| `yin.repl.serve`, `connect`, `driver`, `adapter`,  | convention-over  | An eval service: `requests` and `answers` streams, `:op/eval` as     |\n   593\t| the `daostream:ws://` URL                          |                  | payload; the URL becomes a remote descriptor for that pair. The      |\n   594\t|                                                    |                  | shared-shell privilege is its interpreter's policy.                  |\n   595\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   596\t| `dao.jing.remote`, `remote.step`, `remote.async`,  | retired          | Deprecated whole; replaced below.                                    |\n   597\t| the `:dao.jing/remote` coordinate in               |                  |                                                                      |\n   598\t| `dao.jing.coordinate`                              |                  |                                                                      |\n   599\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   600\t| `yin.repl.link`, `yin.vm.linker` M3 and M4         | convention-over  | The content pair is a request and response service over reflections  |\n   601\t|                                                    |                  | or local ring buffers; the linker's stepped core is unchanged.       |\n   602\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   603\t| `dao.data.btree.storage/hydrate-async`,            | convention-over  | Consume the content client of this section; the callback facade is   |\n   604\t| `store-tree-async`                                 |                  | host policy, per `dao.stream.md` OD-5.                               |\n   605\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   606\t| `dao.jing.dht.node` UDP DHT                        | unrelated        | Raw JVM datagram RPC with its own Kademlia envelope; its socket       |\n   607\t|                                                    |                  | rules and 1200-byte budget are the UDP channel's template.           |\n   608\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   609\t| `dao.stream.transit`, `dao.stream.cbor`            | subsumed         | The channel codecs, unchanged.                                       |\n   610\t+----------------------------------------------------+------------------+----------------------------------------------------------------------+\n   611\t\n   612\t**What replaces `dao.jing.remote`.** Content lookup is a request and response\n   613\tservice over remote streams, in one new module `dao.jing.content`:\n   614\t\n   615\t- **Vocabulary**, a payload convention: `{:jing/request r :jing/get\n   616\t  address}` answered by `{:jing/request r :jing/found? b :jing/bytes b64}`;\n   617\t  `{:jing/request r :jing/put address :jing/bytes b64}` answered by\n   618\t  `{:jing/request r :jing/result :inserted | :present}`. `r` is a\n   619\t  self-minted random value. Bytes travel as padded standard Base64 text, as\n   620\t  today.\n   621\t- **The interpreter** (`dao.jing.content/serve-step`): a pure step over a\n   622\t  local `requests` reader and `answers` writer against a `dao.jing` handle.\n   623\t  It runs the one ingress canonicality check on every put.\n   624\t- **The ingress check**, one shared function `dao.jing/accept-bytes!`,\n   625\t  moved from `dao.jing.remote/accept-bytes!` and used by the interpreter,\n   626\t  by the stepped client on every `get` answer and `:present` verify, and\n   627\t  by `yin.vm.linker`. The three copies become one.\n   628\t- **The stepped client** (`dao.jing.content.step`): the `request-put`,\n   629\t  `request-get`, `request-materialize`, `step`, `abandon` shape of\n   630\t  `dao.jing.remote.step`, over a `requests` writer and an `answers` reader\n   631\t  that are reflections or local handles. This is the portable interface,\n   632\t  per `dao.stream.md` OD-5.\n   633\t- **The blocking driver** (`dao.jing.content.driver`, clj only): host\n   634\t  policy that steps the client and sleeps, returning a synchronous\n   635\t  `dao.jing` handle, for `dao.space.index`, `dao.data.btree.storage` and\n   636\t  `yin.vm.content` on the JVM. It replaces `connect-content!`.\n   637\t- **The async facade** (`dao.jing.content.async`): replaces\n   638\t  `dao.jing.remote.async` over the new stepped client, same consumer API.\n   639\t- **The coordinate**: `{:dao.jing/type :dao.jing/remote :dao.jing/requests\n   640\t  <remote descriptor> :dao.jing/answers <remote descriptor>}` on every\n   641\t  host, resolved by `dao.jing.coordinate/open!` to the driver on clj and to\n   642\t  the stepped client elsewhere. The `:url` form is gone.\n   643\t\n   644\t## 9. Completion criteria and implementation slices\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/dao.stream.md | sed -n '241,257p;390,410p;641,649p;1094,1100p'; nl -ba docs/design/dao.lease.md | sed -n '73,80p;111,117p;232,250p;280,289p'; nl -ba src/cljc/dao/jing/remote.cljc | sed -n '32,42p;728,736p;930,938p'; nl -ba src/cljc/dao/jing/coordinate.cljc | sed -n '20,38p'; nl -ba src/cljc/dao/jing/dht/node.cljc | sed -n '40,52p'; nl -ba docs/design/dao.stream.ws.md | sed -n '64,81p;96,120p'; nl -ba docs/design/dao.jing.cbor.md | sed -n '24,40p;427,440p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba docs/design/dao.stream.md | sed -n '241,257p;390,410p;641,649p;1094,1100p'; nl -ba docs/design/dao.lease.md | sed -n '73,80p;111,117p;232,250p;280,289p'; nl -ba src/cljc/dao/jing/remote.cljc | sed -n '32,42p;728,736p;930,938p'; nl -ba src/cljc/dao/jing/coordinate.cljc | sed -n '20,38p'; nl -ba src/cljc/dao/jing/dht/node.cljc | sed -n '40,52p'; nl -ba docs/design/dao.stream.ws.md | sed -n '64,81p;96,120p'; nl -ba docs/design/dao.jing.cbor.md | sed -n '24,40p;427,440p'\"","aggregated_output":"   241\tinterpreter uses only that declared surface, and attaching to what it already\n   242\tholds is meaningless. A composition may omit the wrapper only when the\n   243\treceiver's fixed contract already declares the surface. But a handle does not\n   244\tsurvive encoding, and any\n   245\ttransport that encodes its elements — a file as much as a network socket —\n   246\tis a serialization boundary. Descriptors exist for crossing those\n   247\tboundaries, where the live value cannot travel and a name must. (What a\n   248\ttransport can carry is transport-owned: handing an encoding transport a\n   249\tvalue it cannot encode is reported as data like any other outcome.)\n   250\t`attach!` therefore consumes only descriptors, and\n   251\tresolves them against the transport's inherent operational state — the\n   252\tstreams a network endpoint serves because serving them is what it is, the\n   253\tfiles a filesystem holds. There is no stream table in this contract: no\n   254\tregistry maps descriptors to live handles, so a descriptor arriving\n   255\tsomewhere with nothing behind it — a ring buffer's descriptor on any other\n   256\thost, or on its own host absent a directory some composition chose to keep —\n   257\thonestly resolves to `:dao.stream/not-found`.\n   390\ttransport constructor that already received whatever composition state the\n   391\ttransport needs — a boundary's deposit destination and its admission\n   392\tdeclaration, a directory some composition keeps. The bare vars above are\n   393\tschematic. A bare namespace var could reach that state only through namespace\n   394\tglobals, which is the hidden state this contract retires.\n   395\t\n   396\tThis table is ordinary data owned by the host, and the dispatch is an\n   397\tordinary map lookup done by the host — DaoStream neither performs nor\n   398\tstandardizes it. A host that cannot dispatch on `:dao.stream/type` returns\n   399\t`:dao.stream/not-found` — never creation or discovery.\n   400\t\n   401\tCode that knows its transport statically calls the transport's functions\n   402\tdirectly; no dispatch is involved. There is no ambient namespace-global\n   403\tregistry and no namespace-load registration side effect.\n   404\t\n   405\t## Surfaces\n   406\t\n   407\tA handle implements the subset of the public surface its transport can\n   408\thonor — **reader** (`cursor`, `next`), **writer** (`append!`), **closable**\n   409\t(`close!`) — and the transport declares which. The Cursors, Reading, and\n   410\tRetention and Gaps sections govern handles with a reader surface only.\n   641\tnature.\n   642\t\n   643\t`:dao.stream/closed` and `:dao.stream/end` are handle-relative: they speak of\n   644\twhat *this handle* is on. (Not every outcome is: `gap` is retention-relative\n   645\tand `cursor-mismatch` is logical-stream-relative.) After an attachment\n   646\tcloses, the handle's `append!` answers `closed`; `descriptor` still answers\n   647\t`ok` with reachability and identity — both outlive any attachment; a reader surface, where the\n   648\thandle has one, answers `end` from `next` once observation through this\n   649\thandle is exhausted, and `closed` from `cursor` — no new cursors are\n    73\t`:released` or `:lapsed` for one lease; or carries a reading older than one\n    74\talready observed. A judge reading a defective fact has read no lease fact.\n    75\t\n    76\t## Authority\n    77\t\n    78\t- **Only grantor-authored facts establish terms.** A holder cannot grant itself\n    79\t  tenure. A holder fact establishes no term; a delayed holder renewal is still\n    80\t  evidence and counts as such.\n   111\tA tick-stream gap makes a pass late, not wrong; a lease-fact gap is governed\n   112\tunder *Judging with incomplete evidence*.\n   113\t\n   114\t## The judge\n   115\t\n   116\tThe judge is composed **inside the boundary that possesses the resource** and\n   117\treclaims by acting on what it itself holds; one that does not possess the\n   232\t## Composition duties\n   233\t\n   234\tA composition that grants leases owes all of the following.\n   235\t\n   236\t- **A judging interpreter, and a runtime driving it at a declared cadence** —\n   237\t  the maximum interval between *completed* passes.\n   238\t- **A tick stream** for the judge, and one for every holder.\n   239\t- **A tolerance** supplied to the judge, possibly zero.\n   240\t- **An attribution resolver** for the judge and for every holder observing a\n   241\t  grant — its own answer to who authored a fact, by per-author media, an\n   242\t  envelope key, or a transport's attachment identity, since DaoStream supplies\n   243\t  none. One handed no resolver, or one incompatible with its medium, is refused\n   244\t  at assembly.\n   245\t- **A reclaim procedure per subject**, idempotent, reporting success.\n   246\t- **A stream the grantor writes grants and `:lapsed` to**, and the medium each\n   247\t  recipient reads its carried facts from.\n   248\t- **Media that either retain without eviction or declare evict-oldest**,\n   249\t  refused at assembly otherwise.\n   250\t- **For durable resources, three things this vocabulary does not supply**: a\n   280\t- **Reclamation is bounded by** duration plus tolerance plus cadence plus the\n   281\t  reclaim's own cost, given an uninterrupted observation window.\n   282\t\n   283\t## Carriage\n   284\t\n   285\tProposals, grants, refusals, releases and renewals cross a boundary as ordinary\n   286\tpayload, carried by the composition to the medium the recipient reads. Carriage\n   287\tis delivery, not a second authoring.\n   288\t\n   289\t`:lapsed` does not cross; it is the grantor's record on the grantor's stream. A\n    32\t  #?(:cljs (:require-macros [dao.jing])))\n    33\t\n    34\t\n    35\t(defn- accept-bytes!\n    36\t  \"The canonical payload bytes carried by the Base64 text b64 at address,\n    37\t   or a throw: this is the one ingress canonicality check for bytes Jing\n    38\t   did not encode itself (docs/design/dao.jing.cbor.md, Layering and\n    39\t   interfaces). The text must be strict Base64, the bytes must hash to the\n    40\t   address under its carried algorithm, and they must decode as exactly\n    41\t   one canonical payload.\"\n    42\t  [address b64]\n   728\t#?(:cljd nil\n   729\t   :clj\n   730\t   (defn connect-content!\n   731\t     \"Connect to a remote content endpoint over WebSocket and return a\n   732\t      content-client handle (see content-client) over a live DaoStream v2\n   733\t      attachment (N1).  JVM-only.\n   734\t\n   735\t      The URL is parsed by content-descriptor; a URL that names no servable\n   736\t      stream throws before any socket.  The return waits for the\n   930\t#?(:cljd nil\n   931\t   :clj\n   932\t   (defn serve-content!\n   933\t     \"Serve `handlers` — any {op fn} map, `default-handlers` for a content\n   934\t      store — over a DaoStream v2 WebSocket endpoint at content-path (S1).\n   935\t\n   936\t      Returns {:port p :stop! f :serving s :lifecycle l}: the port the host\n   937\t      reported bound, the idempotent stop, the serving composition, and the\n   938\t      medium carrying the host listener's deposits.  A bind failure throws\n    20\t          [{:keys [url options], :as coordinate}]\n    21\t          (when-not (and (string? url)\n    22\t                         (not (empty? url))\n    23\t                         (or (nil? options) (map? options))\n    24\t                         (= (set (keys coordinate))\n    25\t                            (cond-> #{:dao.jing/type :url}\n    26\t                              (contains? coordinate :options) (conj :options))))\n    27\t            (throw (ex-info \"invalid remote DaoJing coordinate\"\n    28\t                            {:coordinate coordinate})))\n    29\t          coordinate))\n    30\t\n    31\t\n    32\t(defn open!\n    33\t  \"Open a serializable content-store coordinate as a live DaoJing handle.\n    34\t   Unsupported coordinate types fail closed; no runtime registry is consulted.\"\n    35\t  [{coordinate-type :dao.jing/type, :as coordinate}]\n    36\t  (case coordinate-type\n    37\t    :dao.jing/file (file/create-content-file (:path (validate-file!\n    38\t                                                      coordinate)))\n    40\t                   (java.util.concurrent ConcurrentHashMap)\n    41\t                   (java.util.concurrent.atomic AtomicBoolean AtomicLong))))\n    42\t\n    43\t\n    44\t#?(:cljd nil\n    45\t   :clj\n    46\t   (def max-datagram\n    47\t     \"Conservative single-datagram payload budget. IPv6 guarantees only a\n    48\t     1280-byte path MTU; headers leave roughly this much (design doc,\n    49\t     Transport: 'MTU 1450 is optimistic').\"\n    50\t     1200))\n    51\t\n    52\t\n    64\t| `cursor`, `next` | —                                          | No reader surface, per above.                                                                 |\n    65\t\n    66\t## The Duplex Model\n    67\t\n    68\tA WebSocket is two independent directions sharing one connection, and the\n    69\tdesign keeps them separate:\n    70\t\n    71\t- **Outbound**: `append!` on the socket handle encodes the value and\n    72\t  sends it. Sending is appending; nothing is converted.\n    73\t- **Inbound**: wire framing and protocol validation first either produce a\n    74\t  valid transport event or perform protocol teardown. The host's adapter then\n    75\t  deposits every produced event — payloads and connection lifecycle events\n    76\t  alike, judging none semantically — onto the stream the **host composition** wired for this\n    77\t  boundary. The deposit medium is an ordinary DaoStream stream the host\n    78\t  composed; this transport defines no separate event mechanism and no bus of\n    79\t  its own. (In the v2 migration slice that stream is a ring buffer, under a\n    80\t  time-boxed exception recorded in ADR 0003; the adapter cannot tell what it\n    81\t  deposits into, so the later swap is composition-only.) From that moment the traffic has positions, retention, cursors,\n    96\tinterpreter's business, not the transport's configuration.\n    97\t\n    98\t**Attachment identity.** This transport distinguishes its attachments, so its\n    99\t`attach!` success map carries `:dao.stream/attachment` as the contract\n   100\trequires: a descriptor names the served stream and cannot tell two attachments\n   101\tto it apart, and a handle is a host-local object that cannot be compared\n   102\tagainst data that crossed a codec.\n   103\t\n   104\tEvery event deposited for that attachment carries the same value under\n   105\t`:ws/attachment`. The key differs because the scopes differ: result keywords\n   106\tare the contract's and live under `:dao.stream/…`, while a deposited event is\n   107\ta stream element, where transport-owned keys live under the transport's\n   108\tnamespace. Correlation is by the value carried, never by the key's name.\n   109\t\n   110\tWithout that identity a shared medium is a multiplexed sequence with no\n   111\tdemultiplexing key: every event present, in order, and unattributable.\n   112\t\n   113\t**Server-minted attachment identity.** Before offering a server-side\n   114\taccepted-connection handle to the serving composition, the transport mints\n   115\tits attachment identity under the contract's server-minted-handle rule. The\n   116\tvalue is unique among attachments the boundary can distinguish and is not\n   117\treused during that boundary's lifetime.\n   118\t\n   119\tThe acceptance-offer event carries the value under `:ws/attachment`, and\n   120\tevery later deposited event for the connection carries the same value. The\n    24\tClojure values, datoms, indexes, or manifests. **One exception, narrower\n    25\tthan \"backend\" vs. \"not a backend\":** `dao.jing.file` is the only backend\n    26\tthat re-ingests its own output across process death — it must persist an\n    27\tappend-only log and later replay it with no external message boundary to\n    28\tmark records, so it alone must invent a self-describing frame, which is\n    29\twhy that frame is itself a CBOR structure (a two-element\n    30\t`[digest payload-bytes]` array; see *Memory and files*). `dao.jing.mem`\n    31\tnever persists, so it has no framing at all; `dao.jing.content` (formerly\n    32\t`dao.jing.remote`)/`dao.jing.dht`\n    33\tget record boundaries for free from Transit's own message envelopes, so\n    34\tthey frame with Base64-inside-Transit, never a raw CBOR array. This is not\n    35\tabout `dao.jing.file` being more or less \"Jing's own\" than any other\n    36\tbackend in this source tree — all of `memory`/`file`/`remote`/`dht` are\n    37\tequally in-repo; only PostgreSQL and S3 are genuinely third-party and not\n    38\tyet built. What is third-party-implementable is the byte-store *contract*\n    39\titself, not any particular shipped implementation of it. The exception is\n    40\tthat `dao.jing.file` parses its own frame with Jing's shared codec, never a\n   427\tThe memory backend stores byte snapshots under content addresses. The file\n   428\tbackend retains its append-only length framing, durability rules, duplicate\n   429\tvalidation, and torn-tail recovery. Each frame contains a CBOR\n   430\t`[digest payload-bytes]` record: digest is the raw digest byte string for\n   431\tthe address's carried algorithm (both initial registry algorithms are 32\n   432\tbytes) and payload-bytes contains the exact canonical payload.\n   433\t**`dao.jing.file` itself owns parsing and constructing this two-element\n   434\tframe**, with Jing's own shared codec — the exception the Objective names\n   435\tabove, needed because `dao.jing.file`'s frame shape is itself a CBOR\n   436\tstructure, unlike `dao.jing.mem`'s unframed map or\n   437\t`dao.jing.content`/`dao.jing.dht`'s Base64-inside-Transit framing. The\n   438\twrapper owns keyword↔digest conversion, so file framing has no\n   439\tidentifier-codec dependency, and the algorithm identifier itself is not\n   440\tcarried in the frame — it round-trips through the address keyword the\n","exit_code":0,"status":"completed"}}
