{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'java -cp \"$(cat .cpcache/3644903311.cp)\" clojure.main -e '\"'(require '\\\\''[dao.stream :as s] '\\\\''[dao.stream.ringbuffer :as rb] '\\\\''[dao.stream.remote :as remote] '\\\\''[dao.stream.ws-project :as p])\n(defn ring [] (:dao.stream/handle (rb/create\"'! {:dao.stream/type rb/transport-type rb/capacity-key 16})))\n(defn values [h] (loop [c (:dao.stream/cursor (s/cursor h :dao.stream/oldest)) acc []] (let [r (s/next h c)] (if (= :dao.stream/ok (:dao.stream/outcome r)) (recur (:dao.stream/cursor r) (conj acc (:dao.stream/value r))) acc))))\n(let [source (ring) requests (ring) answers (ring) c (:dao.stream/cursor (s/cursor requests :dao.stream/oldest)) cursor-atom (atom c) dial (atom {:ring requests :table {\"w\" {:handle source :surface #{:writer}}} :channel (atom {:handle answers}) :mirror-cursor cursor-atom :mirror-budget 1}) step remote/mirror-step calls (atom 0)]\n(s/append! requests {:dao.stream/identity \"w\" :dao.stream.remote/op :dao.stream/append! :dao.stream.remote/args [:once] :dao.stream.remote/id 1})\n(with-redefs [remote/mirror-step (fn [& args] (let [result (apply step args)] (when (= 1 (swap! calls inc)) (reset! cursor-atom (with-meta @cursor-atom {:force-cas-retry true}))) result))] (p/dial-step! dial))\n(prn {:source-values (values source) :answer-count (count (values answers)) :mirror-invocations @calls}))'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
