{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba test/yin/vm/rule_r_test.cljc | sed -n '1,420p'\"","aggregated_output":"     1\t(ns yin.vm.rule-r-test\n     2\t  \"Rule R: `yin/def` is syntax, never a name. A variable naming it is\n     3\t   legal only as the operator of a two-operand definition whose first\n     4\t   operand is a literal symbol other than itself; it is never a binder, a\n     5\t   store key, a definition key, a macro name, or a primitive. Every\n     6\t   executing lookup refuses it (`engine/resolve-var`), every definition\n     7\t   transition writes its literal key without resolving its operator, and\n     8\t   every persistent-code loader requires and compares a contract stamp.\n     9\t\n    10\t   Each role is exercised on every loader (walker datoms and rows, semantic\n    11\t   datoms and vectors, stack, register), at transition time on raw walker\n    12\t   control, and at construction; the four backends agree on the stores a\n    13\t   definition program writes.\"\n    14\t  (:require [clojure.test :refer [deftest is testing]]\n    15\t            [dao.space.query :as query]\n    16\t            [dao.stream :as stream]\n    17\t            [yin.vm :as vm]\n    18\t            [yin.vm.ast-walker :as ast-walker]\n    19\t            [yin.vm.code :as code]\n    20\t            [yin.vm.debruijn-linearize :as dl]\n    21\t            [yin.vm.debruijn-register-compile :as rc]\n    22\t            [yin.vm.debruijn.register :as rvm]\n    23\t            [yin.vm.debruijn.stack :as dvm]\n    24\t            [yin.vm.engine :as engine]\n    25\t            [yin.vm.linearize :as linearize]\n    26\t            [yin.vm.macro :as m]\n    27\t            [yin.vm.semantic :as semantic]\n    28\t            [yin.vm.test-utils :as tu]))\n    29\t\n    30\t\n    31\t;; =============================================================================\n    32\t;; Helpers\n    33\t;; =============================================================================\n    34\t\n    35\t(defn- lit\n    36\t  [x]\n    37\t  {:type :literal, :value x})\n    38\t\n    39\t\n    40\t(defn- v\n    41\t  [s]\n    42\t  {:type :variable, :name s})\n    43\t\n    44\t\n    45\t(defn- app\n    46\t  [f & args]\n    47\t  {:type :application, :operator f, :operands (vec args)})\n    48\t\n    49\t\n    50\t(defn- lam\n    51\t  [params body]\n    52\t  {:type :lambda, :params params, :body body})\n    53\t\n    54\t\n    55\t(defn- def!\n    56\t  [k val]\n    57\t  (app (v 'yin/def) (lit k) val))\n    58\t\n    59\t\n    60\t(defn- then\n    61\t  \"`first` for its effect, then `second`: `((fn [_] second) first)`.\"\n    62\t  [first-ast second-ast]\n    63\t  (app (lam '[_] second-ast) first-ast))\n    64\t\n    65\t\n    66\t(defn- refusal\n    67\t  \"The ex-data of what `thunk` throws, unwrapping a loader's `:defect`, or\n    68\t   nil when it returns.\"\n    69\t  [thunk]\n    70\t  (try (thunk)\n    71\t       nil\n    72\t       (catch #?(:cljd Object :clj Exception :cljs :default) e\n    73\t         (let [d (ex-data e)]\n    74\t           (or (:defect d) d {})))))\n    75\t\n    76\t\n    77\t(defn- rule-of\n    78\t  [thunk]\n    79\t  (:rule (refusal thunk)))\n    80\t\n    81\t\n    82\t(defn- segment-batch\n    83\t  \"A `:yin.code/*` segment batch whose instructions are `tuples`, positional\n    84\t   operands named by `code/vector-operand-table` (no `:pc` operands).\"\n    85\t  [tuples]\n    86\t  (into [[-1 :yin.code/type :segment 0 0]\n    87\t         [-1 :yin.code/length (count tuples) 0 0]]\n    88\t        (mapcat (fn [pc t]\n    89\t                  (let [e (- -2 pc)]\n    90\t                    (into [[e :yin.code/segment -1 0 0]\n    91\t                           [e :yin.code/pc pc 0 0]\n    92\t                           [e :yin.code/op (nth t 0) 0 0]]\n    93\t                          (map (fn [[attr _] x] [e attr x 0 0])\n    94\t                               (get code/vector-operand-table (nth t 0))\n    95\t                               (rest t)))))\n    96\t                (range)\n    97\t                tuples)))\n    98\t\n    99\t\n   100\t(defn- register-image\n   101\t  [n instructions]\n   102\t  {:bodies [{:locals 0, :registers n, :start 0,\n   103\t             :end (dec (count instructions))}],\n   104\t   :instructions instructions})\n   105\t\n   106\t\n   107\t(defn- walker-run\n   108\t  [ast]\n   109\t  (vm/eval (tu/create-vm) ast))\n   110\t\n   111\t\n   112\t(defn- semantic-run\n   113\t  [ast]\n   114\t  (vm/run (semantic/vm-load-program\n   115\t            (semantic/create-vm {:make-stream tu/make-stream})\n   116\t            (linearize/lower-ast ast)\n   117\t            vm/semantic-contract)))\n   118\t\n   119\t\n   120\t(defn- stack-run\n   121\t  [ast]\n   122\t  (vm/run (dvm/create-vm (:image (dl/adapt (vm/ast->datoms ast)))\n   123\t                         {:primitives vm/primitives,\n   124\t                          :make-stream tu/make-stream,\n   125\t                          :contract vm/stack-contract})))\n   126\t\n   127\t\n   128\t(defn- register-run\n   129\t  [ast]\n   130\t  (vm/run (rvm/create-vm (:image (rc/adapt (vm/ast->datoms ast)))\n   131\t                         {:primitives vm/primitives,\n   132\t                          :make-stream tu/make-stream,\n   133\t                          :contract vm/register-contract})))\n   134\t\n   135\t\n   136\t(def ^:private backends\n   137\t  {:ast-walker walker-run,\n   138\t   :semantic semantic-run,\n   139\t   :stack stack-run,\n   140\t   :register register-run})\n   141\t\n   142\t\n   143\t;; =============================================================================\n   144\t;; The resolver refuses the name before env or store\n   145\t;; =============================================================================\n   146\t\n   147\t(deftest resolve-var-refuses-before-env-and-store\n   148\t  (let [d (refusal #(engine/resolve-var {'yin/def 1} {'yin/def 2}\n   149\t                                        vm/primitives nil 'yin/def))]\n   150\t    (is (= :reserved-name (:rule d)))\n   151\t    (is (= :variable (:role d)))\n   152\t    (is (= 'yin/def (:name d))))\n   153\t  (is (= 1 (engine/resolve-var {'require 1} {} vm/primitives nil 'require))\n   154\t      \"require stays an ordinary name: an env binding shadows it\"))\n   155\t\n   156\t\n   157\t(deftest yin-def-is-not-a-primitive\n   158\t  (is (not (contains? vm/primitives 'yin/def)))\n   159\t  (is (not (contains? vm/primitive-profiles 'yin/def)))\n   160\t  (is (contains? vm/primitives 'require)))\n   161\t\n   162\t\n   163\t;; =============================================================================\n   164\t;; Definitions: identical stores on all four backends\n   165\t;; =============================================================================\n   166\t\n   167\t(def ^:private definition-programs\n   168\t  \"label -> [ast value store-slice].\"\n   169\t  {\"define then read\" [(then (def! 'x (lit 1))\n   170\t                             (def! 'y (app (v '+) (v 'x) (lit 1))))\n   171\t                       2\n   172\t                       {'x 1, 'y 2}],\n   173\t   \"redefine x twice reads the second value\"\n   174\t   [(then (def! 'x (lit 1)) (then (def! 'x (lit 2)) (v 'x)))\n   175\t    2\n   176\t    {'x 2}],\n   177\t   \"a definition's value is its own value\" [(def! 'z (lit 9)) 9 {'z 9}],\n   178\t   \"a stored closure is called by name\"\n   179\t   [(then (def! 'f (lam '[n] (app (v '*) (v 'n) (lit 2))))\n   180\t          (then (def! 'r (app (v 'f) (lit 5))) (v 'r)))\n   181\t    10\n   182\t    {'r 10}],\n   183\t   \"the reserved symbol as a literal value is data\"\n   184\t   [(def! 'q (lit 'yin/def)) 'yin/def {'q 'yin/def}]})\n   185\t\n   186\t\n   187\t(deftest definitions-agree-across-the-four-backends\n   188\t  (doseq [[label [ast value slice]] definition-programs\n   189\t          [backend run] backends]\n   190\t    (testing (str label \" on \" (name backend))\n   191\t      (let [done (run ast)]\n   192\t        (is (= value (vm/value done)))\n   193\t        (is (= slice (select-keys (vm/store done) (keys slice))))))))\n   194\t\n   195\t\n   196\t(deftest a-definition-never-resolves-its-operator\n   197\t  (testing \"an env or store cannot redirect a definition: both are refused\n   198\t            at construction, and the operator is never looked up\"\n   199\t    (is (= :reserved-name\n   200\t           (rule-of #(ast-walker/create-vm {:env {'yin/def (fn [_ _] 0)}}))))\n   201\t    (is (= 1 (get (vm/store (walker-run (def! 'x (lit 1)))) 'x)))))\n   202\t\n   203\t\n   204\t;; =============================================================================\n   205\t;; A parked read inside a definition's value resumes and writes the store\n   206\t;; =============================================================================\n   207\t\n   208\t(def ^:private parked-definition\n   209\t  \"`((fn [s] (yin/def 'x (stream/next (stream/cursor s)))) (stream/make 4))`\n   210\t   -- the read blocks on the empty stream.\"\n   211\t  (app (lam '[s] (def! 'x {:type :stream/next,\n   212\t                           :source {:type :stream/cursor,\n   213\t                                    :source (v 's)}}))\n   214\t       {:type :stream/make, :buffer 4}))\n   215\t\n   216\t\n   217\t(deftest a-parked-read-in-a-definition-resumes-and-writes\n   218\t  (doseq [[backend run] (select-keys backends [:ast-walker :semantic])]\n   219\t    (testing (name backend)\n   220\t      (let [blocked (run parked-definition)\n   221\t            handle (get (vm/store blocked) :stream-0)]\n   222\t        (is (vm/blocked? blocked))\n   223\t        (is (not (contains? (vm/store blocked) 'x)))\n   224\t        (stream/append! handle 7)\n   225\t        (let [done (vm/run blocked)]\n   226\t          (is (= 7 (vm/value done)))\n   227\t          (is (= 7 (get (vm/store done) 'x))))))))\n   228\t\n   229\t\n   230\t;; =============================================================================\n   231\t;; Every reserved role, refused at load on every loader\n   232\t;; =============================================================================\n   233\t\n   234\t(def ^:private reserved-asts\n   235\t  \"label -> [ast role]: one tree per reserved role.\"\n   236\t  {\"a variable\" [(v 'yin/def) :variable],\n   237\t   \"an operand\" [(app (v 'f) (v 'yin/def)) :variable],\n   238\t   \"an operator of another arity\" [(app (v 'yin/def) (lit 'x))\n   239\t                                   :definition-shape],\n   240\t   \"a non-literal key\" [(app (v 'yin/def) (v 'k) (lit 1)) :definition-shape],\n   241\t   \"a definition key\" [(def! 'yin/def (lit 1)) :definition-key],\n   242\t   \"a binder\" [(lam '[yin/def] (lit 1)) :binder],\n   243\t   \"a store-get key\" [{:type :vm/store-get, :key 'yin/def} :store-key],\n   244\t   \"a store-put key\" [{:type :vm/store-put, :key 'yin/def, :val 1}\n   245\t                      :store-key]})\n   246\t\n   247\t\n   248\t(deftest reserved-roles-are-refused-by-the-walker-datom-and-row-loaders\n   249\t  (doseq [[label [ast role]] reserved-asts]\n   250\t    (testing label\n   251\t      (is (= role (:role (vm/ast-reserved-defect ast))))\n   252\t      (is (= :reserved-name\n   253\t             (rule-of #(ast-walker/vm-load-program\n   254\t                         (tu/create-vm) (vm/ast->datoms ast)\n   255\t                         vm/ast-contract)))\n   256\t          \"the walker's datom loader validates the whole tree\")\n   257\t      (is (= :reserved-name\n   258\t             (rule-of #(ast-walker/vm-load-rows\n   259\t                         (tu/create-vm) (vm/ast->semantic-bytecode ast)\n   260\t                         vm/ast-contract)))\n   261\t          \"the row loader's S7.4 validation includes Rule R\")\n   262\t      (is (= :reserved-name (rule-of #(linearize/lower-ast ast)))\n   263\t          \"the datom lane lowerer refuses\")\n   264\t      (is (= :reserved-name\n   265\t             (rule-of #(dl/adapt (vm/ast->datoms ast))))\n   266\t          \"the de Bruijn resolver refuses\"))))\n   267\t\n   268\t\n   269\t(deftest a-shared-row-is-judged-at-every-occurrence\n   270\t  (testing \"one `[:variable yin/def]` row, legal as an operator and\n   271\t            illegal as an operand of the same tree\"\n   272\t    (let [ast (then (def! 'x (lit 1)) (app (v 'f) (v 'yin/def)))\n   273\t          d (vm/validate-rows (vm/ast->semantic-bytecode ast))]\n   274\t      (is (= :reserved-name (:rule d)))\n   275\t      (is (some? (:path d))))))\n   276\t\n   277\t\n   278\t(deftest reserved-operands-are-refused-by-the-semantic-loaders\n   279\t  (doseq [[label v] {\"a :var\" [[:var 'yin/def] [:halt]],\n   280\t                     \"the old call shape\" [[:var 'yin/def] [:push]\n   281\t                                           [:const 'x] [:push]\n   282\t                                           [:const 1] [:push]\n   283\t                                           [:call 2 false] [:halt]],\n   284\t                     \"a :define key\" [[:const 1] [:define 'yin/def] [:halt]],\n   285\t                     \"a binder\" [[:closure '[yin/def] 2] [:halt]\n   286\t                                 [:const 1] [:return]],\n   287\t                     \"a store-get key\" [[:store-get 'yin/def] [:halt]],\n   288\t                     \"a store-put key\" [[:store-put 'yin/def 1] [:halt]]}]\n   289\t    (testing label\n   290\t      (is (= :reserved-name (:rule (code/well-formed-vector? v))))\n   291\t      (is (= :reserved-name\n   292\t             (rule-of #(semantic/load-vector (semantic/create-vm) v\n   293\t                                             vm/semantic-contract)))\n   294\t          \"the vector loader\")))\n   295\t  (doseq [[label tuples] {\"a :var\" [[:var 'yin/def] [:halt]],\n   296\t                          \"a :define key\" [[:const 1] [:define 'yin/def]\n   297\t                                           [:halt]],\n   298\t                          \"a store-put key\" [[:store-put 'yin/def 1]\n   299\t                                             [:halt]]}]\n   300\t    (testing (str label \" (datom loader)\")\n   301\t      (is (= :reserved-name\n   302\t             (rule-of #(semantic/vm-load-program\n   303\t                         (semantic/create-vm)\n   304\t                         (segment-batch tuples)\n   305\t                         vm/semantic-contract)))))))\n   306\t\n   307\t\n   308\t(deftest reserved-operands-are-refused-by-the-stack-loader\n   309\t  (doseq [[label image] {\"the old call shape\" [[:load-free 'yin/def] [:push]\n   310\t                                               [:const 'x] [:push]\n   311\t                                               [:const 1] [:push]\n   312\t                                               [:call 2 false] [:halt]],\n   313\t                         \"a :define key\" [[:const 1] [:define 'yin/def]\n   314\t                                          [:halt]],\n   315\t                         \"a store-get key\" [[:store-get 'yin/def] [:halt]]}]\n   316\t    (testing label\n   317\t      (is (= :reserved-name\n   318\t             (rule-of #(dvm/create-vm image {:contract vm/stack-contract}))))\n   319\t      (is (= :reserved-name\n   320\t             (rule-of #(dvm/load-image (dvm/create-vm []) image\n   321\t                                       vm/stack-contract)))))))\n   322\t\n   323\t\n   324\t(deftest reserved-operands-are-refused-by-the-register-loader\n   325\t  (doseq [[label image]\n   326\t          {\"the old call shape\" (register-image\n   327\t                                  3 [[:load-free 0 'yin/def] [:const 1 'x]\n   328\t                                     [:const 2 1] [:call 0 0 [1 2] false []]\n   329\t                                     [:halt 0]]),\n   330\t           \"a :define key\" (register-image 1 [[:const 0 1]\n   331\t                                              [:define 0 'yin/def 0]\n   332\t                                              [:halt 0]]),\n   333\t           \"a store-put key\" (register-image 1 [[:store-put 0 'yin/def 1]\n   334\t                                                [:halt 0]])}]\n   335\t    (testing label\n   336\t      (is (= :reserved-name\n   337\t             (rule-of #(rvm/create-vm image\n   338\t                                      {:contract vm/register-contract})))))))\n   339\t\n   340\t\n   341\t;; =============================================================================\n   342\t;; Raw control: refused at transition time\n   343\t;; =============================================================================\n   344\t\n   345\t(defn- run-raw\n   346\t  \"Step a walker through supplied control: no load event exists.\"\n   347\t  [control]\n   348\t  (vm/run (assoc (tu/create-vm) :control control :halted? false)))\n   349\t\n   350\t\n   351\t(deftest raw-walker-control-is-refused-at-transition\n   352\t  (doseq [[label [control role]]\n   353\t          {\"a variable\" [(v 'yin/def) :variable],\n   354\t           \"a binder\" [(lam '[yin/def] (lit 1)) :binder],\n   355\t           \"a store-get key\" [{:type :vm/store-get, :key 'yin/def} :store-key],\n   356\t           \"a store-put key\" [{:type :vm/store-put, :key 'yin/def, :val 1}\n   357\t                              :store-key],\n   358\t           \"a store-update key\" [{:type :vm/store-update, :key 'yin/def,\n   359\t                                  :fn (fn [x] x), :args []}\n   360\t                                 :store-key],\n   361\t           \"a definition key\" [(def! 'yin/def (lit 1)) :definition-key],\n   362\t           \"a malformed definition\" [(app (v 'yin/def) (lit 'x))\n   363\t                                     :definition-shape]}]\n   364\t    (testing label\n   365\t      (let [d (refusal #(run-raw control))]\n   366\t        (is (= :reserved-name (:rule d)))\n   367\t        (is (= role (:role d))))))\n   368\t  (testing \"a raw definition continuation cannot write the reserved key\"\n   369\t    (let [vm (assoc (tu/create-vm)\n   370\t                    :control nil\n   371\t                    :k {:type :eval-define, :name 'yin/def, :next nil}\n   372\t                    :value 1\n   373\t                    :halted? false)]\n   374\t      (is (= :store-key (:role (refusal #(vm/step vm))))))))\n   375\t\n   376\t\n   377\t;; =============================================================================\n   378\t;; Store writes: one engine/store-put\n   379\t;; =============================================================================\n   380\t\n   381\t(deftest store-put-refuses-the-reserved-key\n   382\t  (is (= :store-key (:role (refusal #(engine/store-put {} 'yin/def 1)))))\n   383\t  (is (= {'x 1} (engine/store-put {} 'x 1)))\n   384\t  (testing \"the :vm/store-put effect goes through it\"\n   385\t    (is (= :reserved-name\n   386\t           (rule-of #(engine/handle-effect\n   387\t                       (tu/create-vm)\n   388\t                       {:effect :vm/store-put, :key 'yin/def, :val 1}\n   389\t                       {}))))))\n   390\t\n   391\t\n   392\t(deftest a-ready-entry-carries-only-minted-keys\n   393\t  (is (= :store-update-key\n   394\t         (rule-of #(engine/resume-from-run-queue\n   395\t                     {:ready-queue [{:store-updates {'yin/def 1}}],\n   396\t                      :store {}}\n   397\t                     (fn [base _ _] base)))))\n   398\t  (is (= {:c 1}\n   399\t         (:store (engine/resume-from-run-queue\n   400\t                   {:ready-queue [{:store-updates {:c 1}}], :store {}}\n   401\t                   (fn [base _ _] base))))))\n   402\t\n   403\t\n   404\t;; =============================================================================\n   405\t;; Construction: no supplied env, store, or registry binds the name\n   406\t;; =============================================================================\n   407\t\n   408\t(deftest construction-refuses-a-binding-of-the-name\n   409\t  (let [bound {'yin/def 1}\n   410\t        registry (assoc vm/primitives 'yin/def (fn [_ _] nil))]\n   411\t    (doseq [[label thunk]\n   412\t            {\"walker env\" #(ast-walker/create-vm {:env bound}),\n   413\t             \"walker registry\" #(ast-walker/create-vm {:primitives registry}),\n   414\t             \"semantic env\" #(semantic/create-vm {:env bound}),\n   415\t             \"semantic registry\" #(semantic/create-vm {:primitives registry}),\n   416\t             \"stack env\" #(dvm/create-vm [] {:free-env bound}),\n   417\t             \"stack store\" #(dvm/create-vm [] {:store bound}),\n   418\t             \"stack registry\" #(dvm/create-vm [] {:primitives registry}),\n   419\t             \"register env\" #(rvm/create-vm nil {:free-env bound}),\n   420\t             \"register store\" #(rvm/create-vm nil {:store bound}),\n","exit_code":0,"status":"completed"}}
