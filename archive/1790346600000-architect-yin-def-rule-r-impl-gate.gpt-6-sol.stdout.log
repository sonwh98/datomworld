 743\t   S7.5 validation.\"\n   744\t  ([vm v contract] (load-vector vm v contract {}))\n   745\t  ([vm v contract opts]\n   746\t   (vm/check-contract! vm/semantic-contract contract)\n   747\t   (when-let [defect (code/well-formed-vector? v)]\n   748\t     (throw (ex-info (str \"Cannot load vector: \" (name (:rule defect))\n   749\t                          \" (pc \" (:pc defect) \")\")\n   750\t                     {:defect defect})))\n   751\t   (let [address (jing/segment-key v)\n   752\t         aliases (:code-aliases vm)\n   753\t         seg (or (get aliases address)\n   754\t                 (:id opts)\n   755\t                 (dec (vm/loaded-code-floor (:code vm))))\n   756\t         image {:segment seg,\n   757\t                :length (count v),\n","exit_code":0,"status":"completed"}}
