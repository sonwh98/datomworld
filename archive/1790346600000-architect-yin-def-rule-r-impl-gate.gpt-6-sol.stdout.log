\t  [state effect id]\n   198\t  (let [capacity (or (:capacity effect) vm/default-stream-capacity)\n   199\t        handle (vm/create-stream! (:make-stream state) capacity :stream/make)\n   200\t        new-store (assoc (:store state) id handle)\n   201\t        stream-ref {:type :stream-ref, :id id}]\n   202\t    [stream-ref (assoc state :store new-store)]))\n   203\t\n   204\t\n   205\t(defn handle-put\n   206\t  \"Handle :stream/put. Total over the five append outcomes.\n   207\t   Returns {:value v :state s} on success, {:park true :stream-id id :state s}\n   208\t   on `full`. `closed`, `invalid-value` and `transport-error` are errors that\n   209\t   name their outcome, as v1's throw on a closed stream did.\"\n   210\t  [state effect]\n   211\t  (let [stream-ref (:stream effect)\n   212\t        val (:val effect)\n   213\t        stream-id (:id stream-ref)\n   214\t        handle (get (:store state) stream-id)]\n   215\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   216\t    (let [result (stream/append! handle val)\n   217\t          o (outcome result)]\n   218\t      (case o\n   219\t        :dao.stream/ok {:value val, :state state}\n   220\t        :dao.stream/full {:park true, :stream-id stream-id, :state state}\n   221\t        (fail \"Stream append failed\" {:outcome o, :stream-id stream-id})))))\n   222\t\n   223\t\n   224\t(defn handle-cursor\n   225\t  \"Handle :stream/cursor. Mints an opaque cursor at `:dao.stream/oldest`.\n   226\t\n   227\t   v1 fabricated `{:position 0}` and touched no stream. Minting is a stream\n   228\t   operation, so `closed` and `transport-error` arrive here.\n   229\t   Returns [cursor-ref updated-state].\"\n   230\t  [state effect id]\n   231\t  (let [stream-ref (:stream effect)\n   232\t        stream-id (:id stream-ref)\n   233\t        handle (get (:store state) stream-id)]\n   234\t    (when (nil? handle) (fail \"Invalid stream reference\" {:ref stream-ref}))\n   235\t    (let [cursor