{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/cljc/yin/vm.cljc | sed -n '145,275p;1220,1355p;1690,1742p'\"","aggregated_output":"   145\t\n   146\t(defn definition-operator?\n   147\t  \"True when a map AST node is the variable naming the definition\n   148\t   operator.\"\n   149\t  [node]\n   150\t  (and (= :variable (:type node)) (= definition-operator (:name node))))\n   151\t\n   152\t\n   153\t(defn definition?\n   154\t  \"True when a map AST node is an application of the definition operator,\n   155\t   whatever its operands: its shape is judged by `definition-name`.\"\n   156\t  [node]\n   157\t  (and (= :application (:type node)) (definition-operator? (:operator node))))\n   158\t\n   159\t\n   160\t(defn definition-shape-defect\n   161\t  \"nil when `operands` (map AST nodes) are a definition's legal operands,\n   162\t   two of them with the first a literal non-reserved symbol; else the\n   163\t   Rule R defect.\"\n   164\t  [operands]\n   165\t  (let [key-node (first operands)\n   166\t        k (:value key-node)]\n   167\t    (cond (not (and (= 2 (count operands))\n   168\t                    (= :literal (:type key-node))\n   169\t                    (symbol? k)))\n   170\t          (reserved-name-defect :definition-shape definition-operator)\n   171\t          (reserved-name? k) (reserved-name-defect :definition-key k))))\n   172\t\n   173\t\n   174\t(defn definition-name\n   175\t  \"The literal key of a definition node, or a thrown Rule R refusal when\n   176\t   its operands are not a legal definition.\"\n   177\t  [node]\n   178\t  (let [operands (:operands node)]\n   179\t    (when-let [d (definition-shape-defect operands)]\n   180\t      (throw (ex-info \"Malformed definition\" d)))\n   181\t    (:value (first operands))))\n   182\t\n   183\t\n   184\t(defn- ast-child-nodes\n   185\t  \"Structural child nodes of a map AST node other than a definition's\n   186\t   operator. Literal values are data, never nodes.\"\n   187\t  [node]\n   188\t  (case (:type node)\n   189\t    :lambda [(:body node)]\n   190\t    :application (if (definition? node)\n   191\t                   (:operands node)\n   192\t                   (cons (:operator node) (:operands node)))\n   193\t    :dao.stream.apply/call (:operands node)\n   194\t    :if [(:test node) (:consequent node) (:alternate node)]\n   195\t    :stream/put [(:target node) (:val node)]\n   196\t    (:stream/cursor :stream/next :stream/close) [(:source node)]\n   197\t    :vm/resume [(:val node)]\n   198\t    nil))\n   199\t\n   200\t\n   201\t(defn ast-reserved-defect\n   202\t  \"Rule R over a whole map AST: nil when every occurrence of a reserved\n   203\t   name is a legal definition operator, else the first defect in preorder\n   204\t   (`reserved-name-defect`). A literal whose value is a reserved symbol is\n   205\t   data and always legal.\"\n   206\t  [ast]\n   207\t  (letfn [(own\n   208\t            [node]\n   209\t            (case (:type node)\n   210\t              :variable (when (reserved-name? (:name node))\n   211\t                          (reserved-name-defect :variable (:name node)))\n   212\t              :lambda (when-let [p (some #(when (reserved-name? %) %)\n   213\t                                         (:params node))]\n   214\t                        (reserved-name-defect :binder p))\n   215\t              (:vm/store-get :vm/store-put :vm/store-update)\n   216\t              (when (reserved-name? (:key node))\n   217\t                (reserved-name-defect :store-key (:key node)))\n   218\t              :application (when (definition? node)\n   219\t                             (definition-shape-defect (:operands node)))\n   220\t              nil))\n   221\t          (walk\n   222\t            [node]\n   223\t            (when (map? node)\n   224\t              (or (own node) (some walk (ast-child-nodes node)))))]\n   225\t    (walk ast)))\n   226\t\n   227\t\n   228\t;; =============================================================================\n   229\t;; Execution contracts (UCF S7.3.3)\n   230\t;; =============================================================================\n   231\t;; One published revision name per persistent code format. Rule R changed\n   232\t;; the resolution precedence and added the definition transition, so every\n   233\t;; format moved to a new revision. Persistent-code loaders require and\n   234\t;; compare a stamp; fresh-code producers supply these constants.\n   235\t\n   236\t(def ast-contract\n   237\t  \"The contract of the Universal AST: `:yin/*` datoms and projected rows.\"\n   238\t  \"v3\")\n   239\t\n   240\t\n   241\t(def semantic-contract\n   242\t  \"The contract of the linear `:yin.code/*` segment and its canonical\n   243\t   instruction vector.\"\n   244\t  \"v3\")\n   245\t\n   246\t\n   247\t(def stack-contract\n   248\t  \"The contract of the de Bruijn stack image (`:yin.debruijn.code`).\"\n   249\t  \"b2\")\n   250\t\n   251\t\n   252\t(def register-contract\n   253\t  \"The contract of the de Bruijn register image (`:yin.debruijn.register`).\"\n   254\t  \"r2\")\n   255\t\n   256\t\n   257\t(defn check-contract!\n   258\t  \"Refuse a persistent-code admission whose supplied stamp is absent\n   259\t   (`:contract-missing`) or names another revision (`:contract-mismatch`).\n   260\t   Runs before validation, so an old-stamped image fails by stamp.\"\n   261\t  [expected supplied]\n   262\t  (cond (nil? supplied)\n   263\t        (throw (ex-info \"Persistent code carries no contract stamp\"\n   264\t                        {:rule :contract-missing, :expected expected}))\n   265\t        (not= expected supplied)\n   266\t        (throw (ex-info (str \"Persistent code is stamped \" supplied\n   267\t                             \", this loader executes \" expected)\n   268\t                        {:rule :contract-mismatch,\n   269\t                         :expected expected,\n   270\t                         :actual supplied}))))\n   271\t\n   272\t\n   273\t;; Primitive operations\n   274\t;; Arithmetic and comparison ops are direct clojure.core references.\n   275\t;; Wrapped only where VM semantics require it:\n  1220\t\n  1221\t\n  1222\t(defn- semantic-bytecode-slot-kind-ok?\n  1223\t  \"§2.2/§7.4 `:slot-kind`: whether `v` conforms to slot `kind`.\"\n  1224\t  [kind v]\n  1225\t  (case kind\n  1226\t    :node (jing/segment-address? v)\n  1227\t    :nodes (and (vector? v) (nil? (meta v)) (every? jing/segment-address? v))\n  1228\t    (:data :key) (plain-data? v)\n  1229\t    :sym (symbol? v)\n  1230\t    :syms (and (vector? v) (nil? (meta v)) (every? symbol? v))\n  1231\t    :kw (keyword? v)\n  1232\t    :str (string? v)\n  1233\t    :int (and (integer? v) (not (neg? v)))\n  1234\t    :bool (or (true? v) (false? v))))\n  1235\t\n  1236\t\n  1237\t(defn- semantic-bytecode-row-tag\n  1238\t  [row]\n  1239\t  (when (and (vector? row) (<= 2 (count row)))\n  1240\t    (nth row 1)))\n  1241\t\n  1242\t\n  1243\t(defn- semantic-bytecode-child-refs\n  1244\t  \"`[[path-suffix child-id] ..]` for every `node`/`nodes` slot of a row\n  1245\t   whose `tag` and `body` already passed `:arity`, in slot order; a `node`\n  1246\t   slot's suffix is its slot index, a `nodes` slot's suffix is `[slot-index\n  1247\t   item-index]` (§2.5).\"\n  1248\t  [tag body]\n  1249\t  (let [slots (get semantic-bytecode-grammar tag)]\n  1250\t    (mapcat (fn [i [_ kind] v]\n  1251\t              (case kind\n  1252\t                :node [[[i] v]]\n  1253\t                :nodes (map-indexed (fn [j cid] [[[i j] cid]]) v)\n  1254\t                nil))\n  1255\t            (range 1 (inc (count slots))) slots (rest body))))\n  1256\t\n  1257\t\n  1258\t(defn- rows-reserved-defect\n  1259\t  \"Rule R over a row set that already passed every structural rule,\n  1260\t   occurrence-aware: a row is shared by content address, so a\n  1261\t   `[:variable yin/def]` row is judged at every parent slot that names\n  1262\t   it (and at the root). It is legal only as the operator slot of an\n  1263\t   `:application` whose two operands begin with a literal non-reserved\n  1264\t   symbol. A lambda binding the name and a store key naming it are\n  1265\t   refused wherever they occur. `defect-res` is `validate-rows`' own\n  1266\t   defect constructor, so the defect carries the row's path.\"\n  1267\t  [root rows defect-res]\n  1268\t  (let [reserved-var? (fn [id]\n  1269\t                        (let [row (get rows id)]\n  1270\t                          (and (= :variable (nth row 1))\n  1271\t                               (reserved-name? (nth row 2)))))\n  1272\t        shape (fn [operands]\n  1273\t                (let [key-row (get rows (first operands))]\n  1274\t                  (cond (not (and (= 2 (count operands))\n  1275\t                                  (= :literal (nth key-row 1))\n  1276\t                                  (symbol? (nth key-row 2))))\n  1277\t                        :definition-shape\n  1278\t                        (reserved-name? (nth key-row 2)) :definition-key)))\n  1279\t        own (fn [[id row]]\n  1280\t              (case (nth row 1)\n  1281\t                :lambda (when (some reserved-name? (nth row 2))\n  1282\t                          (merge (defect-res :reserved-name id)\n  1283\t                                 {:role :binder, :name definition-operator}))\n  1284\t                (:vm/store-get :vm/store-put)\n  1285\t                (when (reserved-name? (nth row 2))\n  1286\t                  (merge (defect-res :reserved-name id)\n  1287\t                         {:role :store-key, :name (nth row 2)}))\n  1288\t                :application\n  1289\t                (if (reserved-var? (nth row 2))\n  1290\t                  (when-let [role (shape (nth row 3))]\n  1291\t                    (merge (defect-res :reserved-name id)\n  1292\t                           {:role role, :name definition-operator}))\n  1293\t                  nil)\n  1294\t                nil))\n  1295\t        misplaced (fn [[id row]]\n  1296\t                    (let [tag (nth row 1)\n  1297\t                          slots (get semantic-bytecode-grammar tag)]\n  1298\t                      (some identity\n  1299\t                            (map (fn [i [_ kind] v]\n  1300\t                                   (case kind\n  1301\t                                     :node (when (and (reserved-var? v)\n  1302\t                                                      (not (and (= :application\n  1303\t                                                                   tag)\n  1304\t                                                                (= 1 i))))\n  1305\t                                             [id [i]])\n  1306\t                                     :nodes (some (fn [[j c]]\n  1307\t                                                    (when (reserved-var? c)\n  1308\t                                                      [id [i j]]))\n  1309\t                                                  (map-indexed vector v))\n  1310\t                                     nil))\n  1311\t                                 (range 1 (inc (count slots)))\n  1312\t                                 slots\n  1313\t                                 (drop 2 row)))))]\n  1314\t    (or (when (reserved-var? root)\n  1315\t          (merge (defect-res :reserved-name root)\n  1316\t                 {:role :variable, :name definition-operator}))\n  1317\t        (some own rows)\n  1318\t        (when-let [[id suffix] (some misplaced rows)]\n  1319\t          (merge (defect-res :reserved-name id suffix)\n  1320\t                 {:role :variable, :name definition-operator})))))\n  1321\t\n  1322\t\n  1323\t(defn validate-rows\n  1324\t  \"§7.4: validate a projected row set before reconstruction. `rows` is\n  1325\t   `{id [id tag & slots]}`; `root` is the root row's id.\n  1326\t\n  1327\t   Returns nil when every row is well-formed, else the first defect as\n  1328\t   `{:rule r :path p}`, or `{:rule :root-reachable :id id}` for a row of the\n  1329\t   loaded set nothing reaches. Rules run in §7.4's order -- `:tag`,\n  1330\t   `:arity`, `:slot-kind`, `:saturation`, `:id-resolves`, `:acyclic`,\n  1331\t   `:root-reachable`, then Rule R's `:reserved-name` -- discovered by\n  1332\t   descending from the root row, so a path is always available except for\n  1333\t   `:root-reachable`'s unreached rows. Each rule assumes the earlier ones\n  1334\t   held.\"\n  1335\t  [{:keys [root rows]}]\n  1336\t  (let [safe-tag (fn [row] (when (and (vector? row) (<= 2 (count row))) (nth row 1)))\n  1337\t        safe-slots (fn [tag] (get semantic-bytecode-grammar tag))\n  1338\t        safe-children (fn [id]\n  1339\t                        (let [row (get rows id)]\n  1340\t                          (if row\n  1341\t                            (let [tag (safe-tag row)\n  1342\t                                  slots (safe-slots tag)]\n  1343\t                              (if (and slots (= (count slots) (dec (count (subvec row 1)))))\n  1344\t                                (mapcat (fn [i [_ kind] v]\n  1345\t                                          (case kind\n  1346\t                                            :node (if (semantic-bytecode-slot-kind-ok? kind v) [[[i] v]] [])\n  1347\t                                            :nodes (if (semantic-bytecode-slot-kind-ok? kind v)\n  1348\t                                                     (map-indexed (fn [j cid] [[i j] cid]) v)\n  1349\t                                                     [])\n  1350\t                                            nil))\n  1351\t                                        (range 1 (inc (count slots))) slots (rest (subvec row 1)))\n  1352\t                                []))\n  1353\t                            [])))\n  1354\t        paths (loop [queue [[root []]]\n  1355\t                     q-idx 0\n  1690\t   effect-raising tag/mnemonic sets are judged by `contains?`.\"\n  1691\t  {'contains? contains?})\n  1692\t\n  1693\t\n  1694\t(defn- extract\n  1695\t  \"One §7.7 extraction query over `db`, its single find column as a set.\"\n  1696\t  [q db]\n  1697\t  (set (map first (query/collect (query/q q db {:fns extraction-fns})))))\n  1698\t\n  1699\t\n  1700\t(def ^:private ast-extraction-queries\n  1701\t  \"§7.7 over `$ast`, the union of the flat rows of the reachable trees,\n  1702\t   verbatim from the design.\"\n  1703\t  {:store-keys '[:find ?key :in $ast\n  1704\t                 :where (or [$ast _ :vm/store-get ?key]\n  1705\t                            [$ast _ :vm/store-put ?key _])],\n  1706\t   :ffi-ops '[:find ?op :in $ast\n  1707\t              :where [$ast _ :dao.stream.apply/call ?op _]],\n  1708\t   :parked-ids '[:find ?pid :in $ast\n  1709\t                 :where [$ast _ :vm/resume ?pid _]],\n  1710\t   ;; syntax that raises an effect: the tag, to be normalized by the\n  1711\t   ;; footprint table\n  1712\t   :effect-raisers '[:find ?tag :in $ast\n  1713\t                     :where [$ast _ ?tag & _]\n  1714\t                     [(contains? #{:stream/make :stream/put :stream/cursor\n  1715\t                                   :stream/next :stream/close\n  1716\t                                   :dao.stream.apply/call}\n  1717\t                                 ?tag)]]})\n  1718\t\n  1719\t\n  1720\t(def ^:private segment-extraction-queries\n  1721\t  \"§7.7 over `$code`, the union of the segment-qualified rows\n  1722\t   (`yin.vm.code/project-segment-qualified`) of the reachable segments,\n  1723\t   verbatim from the design. The segment-side free-name query (derive free\n  1724\t   names from the vector's own scoping) is §7.7's to name but stays\n  1725\t   unverified there; `free-names` over `$ast`/`$occ` is the shipped\n  1726\t   extraction.\"\n  1727\t  {:store-keys '[:find ?key :in $code\n  1728\t                 :where (or [$code _ _ :store-get ?key]\n  1729\t                            [$code _ _ :store-put ?key _])],\n  1730\t   :ffi-ops '[:find ?op :in $code\n  1731\t              :where [$code _ _ :ffi-call ?op _]],\n  1732\t   :parked-ids '[:find ?pid :in $code\n  1733\t                 :where [$code _ _ :resume ?pid]],\n  1734\t   :effect-raisers '[:find ?mn :in $code\n  1735\t                     :where [$code _ _ ?mn & _]\n  1736\t                     [(contains? #{:stream-make :stream-put :stream-cursor\n  1737\t                                   :stream-next :stream-close :ffi-call}\n  1738\t                                 ?mn)]]})\n  1739\t\n  1740\t\n  1741\t(defn- requirements\n  1742\t  \"The S7.7 syntactic requirement set of one relation under the\n","exit_code":0,"status":"completed"}}
