   (case o\n   272\t          :dao.stream/ok (advance state (:dao.stream/value result))\n   273\t          :dao.stream/blocked {:park true,\n   274\t                               :cursor-ref cursor-ref,\n   275\t                               :stream-id stream-id,\n   438\t   same way here, not reach Yin code as a value.\n   439\t\n   440\t   `restore-fn` is called with three arguments, `base entry val`, where\n   441\t   `val` is the woken `:value` — the same signature `resume-continuation`\n   442\t   uses, so one restore serves both engine call sites\n   443\t   (`yin.vm.engine.md` §7, edit 2).\"\n   444\t  [state restore-fn]\n   445\t  (let [run-queue (or (:ready-queue state) [])]\n   446\t    (when (seq run-queue)\n   447\t      (let [entry (first run-queue)\n   448\t            rest-queue (subvec run-queue 1)\n   449\t            updates (:store-updates entry)\n   450\t            ;; allowlisted state construction: a woken entry only ever\n   451\t            ;; carries engine-minted keyword keys (cursor ids)\n   452\t            _ (when-let [k (some #(when-not (keyword? %) %) (keys updates))]\n   453\t                (fail \"Ready entry store update carries a non-minted key\"\n   454\t                      {:rule :store-update-key, :key k}))\n   455\t            base (assoc state\n   456\t                        :ready-queue rest-queue\n   457\t                        :store (merge (:store state) updates)\n   458\t                        :blocked? false\n   459\t                        :halted? false)]\n   460\t        (if-let [terminal (terminal-resume-outcome entry)]\n   461\t          (throw-terminal-resume! entry terminal)\n   462\t          (restore-fn base entry (:value entry)))))))\n   463\t\n   464\t\n   465\t(defn scheduler-round\n   520\t                        (update :wait-set (fnil conj []) entry)\n   521\t                        (assoc :value :yin/blocked\n   522\t                               :blocked? true\n   523\t                               :halted? false))]\n   524\t      {:state new-state, :value :yin/blocked, :blocked? true})\n   525\t    {:state (:state result), :value (:value result), :blocked? false}))\n   526\t\n   527\t\n   528\t(defn handle-effect\n   529\t  \"Dispatch an effect and return {:state updated-state :value v :blocked? bool}.\n   530\t   park-entry-fns maps :stream/put and :stream/next to functions that build\n   531\t   wait entries.\n   532\t\n   533\t   A parked entry is stored as the builder left it plus, for a writer, the\n   534\t   `:datom` it retries: registers and resource ids only. Neither the live\n   535\t   stream handle nor a restore closure is attached — `check-wait-set`\n   536\t   resolves handles from the store at every poll, and the scheduler that pops\n   537\t   a woken entry dispatches restoration itself — so a blocked entry is pure\n   538\t   data and survives serialization.\"\n   539\t  [state effect {:keys [park-entry-fns], :as opts}]\n   540\t  (let [park-entry (get park-entry-fns (:effect effect))\n   541\t        result\n   542\t        (case (:effect effect)\n   543\t          :vm/store-put {:state (assoc state\n   544\t                                       :store (store-put (:store state)\n   545\t                                                         (:key effect)\n   546\t                                                         (:val effect))),\n   547\t                         :value (:val effect),\n   548\t                         :blocked? false}\n   549\t          :stream/make\n   550\t          (let [[id s'] (gensym state \"stream\")\n   551\t                [stream-ref new-state] (handle-make s' effect id)]\n   552\t            {:state new-state, :value stream-ref, :blocked? false})\n   553\t          :stream/cursor\n   554\t          (let [[id s'] (gensym state \"cursor\")\n   555\t                [cursor-ref new-state] (handle-cursor s' effect id)]\n","exit_code":0,"status":"completed"}}
