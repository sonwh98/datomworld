    66\t\n    67\t\n    68\t(def opcode-table\n    69\t  \"S2's operand table for `:yin.debruijn.code/*`, in `yin.vm.code/vector-\n    70\t   operand-table`'s own positional form: mnemonic -> ordered `[attribute\n    71\t   kind]` operands. `:var` becomes `:load-bound` (a depth and a position,\n    72\t   both `:uint`) or `:load-free` (a name, `:sym`); `:closure` carries an\n    73\t   arity (`:uint`) and a body reference (`:pc`) instead of a parameter\n    74\t   vector. Every other mnemonic is `renamespace-slots` applied to\n    75\t   `code/vector-operand-table`'s own entry, so a change to that table's\n    76\t   shape for a carried mnemonic is inherited here automatically rather\n    77\t   than silently drifting out of sync.\"\n    78\t  (into (into {}\n    79\t              (map (fn [mnemonic]\n    80\t                     [mnemonic (renamespace-slots (get code/vector-operand-table mnemonic))]))\n    81\t              carried-mnemonics)\n    82\t        {:load-bound [[:yin.debruijn.code/depth :uint] [:yin.debruijn.code/position :uint]],\n    83\t         :load-free [[:yin.debruijn.code/name :sym]],\n    84\t         :closure [[:yin.debruijn.code/arity :uint] [:yin.debruijn.code/body :pc]]}))\n    85\t\n    86\t\n    87\t(def mnemonics\n    88\t  (set (keys opcode-table)))\n    89\t\n    90\t\n    91\t;; =============================================================================\n    92\t;; The descriptor\n    93\t;; =============================================================================\n    94\t\n    95\t(def scalar-classes\n    96\t  \"This dimension's own executable scalar domain (S2), in the fixed order\n    97\t   that assigns each class its tag byte below. Deliberately distinct from\n    98\t   `yin.vm.debruijn/canonical-value-table`: :ratio and :bigint are their\n    99\t   own classes here, not excluded, and :int64 is named :long (S2's own\n   100\t   wording) with no NFC or integral-double folding anywhere in this\n   101\t   table's encoding.\"\n   102\t  [:nil :bool :long :double :ratio :bigint :char :string :keyword :symbol\n   103\t   :vector :list :map :set])\n   104\t\n   105\t\n   106\t(def lowering-contract-version\n   107\t  \"Bumped whenever this dimension's opcode table, scalar table, or byte\n   108\t   rules change shape -- the version the descriptor hash folds in, so an\n   109\t   incompatible lowering never collides with an old image's H. 2 (the\n   110\t   `\\\"b2\\\"` contract, `yin.vm/stack-contract`): Rule R's `:define`.\"\n   215\t   classification rule below -- decomposes through floor and mod by\n   216\t   2^32, whose low bytes survive the host's 32-bit bit ops.\"\n   217\t  [v]\n   218\t  #?(:cljs (let [lo (mod v 4294967296)\n   219\t                 hi (js/Math.floor (/ v 4294967296))\n   220\t                 byte-at (fn [x i]\n   221\t                           (to-hex (bit-and (unsigned-bit-shift-right x (* i 8))\n   222\t                                            0xff)\n   223\t                                   2))]\n   224\t             (apply str (map #(byte-at (if (< % 4) lo hi) (mod % 4)) (range 8))))\n   225\t     :default (let [n (long v)]\n   226\t                (apply str (map #(to-hex (bit-and (unsigned-bit-shift-right n (* % 8)) 0xff) 2)\n   227\t                                (range 8))))))\n   228\t\n   229\t\n   230\t(defn- double-le-hex\n   231\t  \"IEEE-754 bits, little-endian, one quiet NaN encoding regardless of a\n   232\t   host's NaN payload. :clj reads the bits through doubleToLongBits,\n   233\t   :cljs through a DataView with littleEndian explicitly true, :cljd\n   234\t   through a big-endian ByteData store read in reverse.\"\n   235\t  [v]\n   236\t  (if (not= v v)\n   237\t    \"000000000000f87f\"\n   238\t    #?(:clj (int64-le-hex (Double/doubleToLongBits (double v)))\n   239\t       :cljs (let [view (js/DataView. (js/ArrayBuffer. 8))]\n   240\t               (.setFloat64 view 0 v true)\n   241\t               (apply str (map #(to-hex (.getUint8 view %) 2) (range 8))))\n   242\t       :cljd (let [bd (ByteData. 8)]\n   243\t               (.setFloat64 bd 0 v)\n   244\t               (apply str (map #(to-hex (.getUint8 bd %) 2) (range 7 -1 -1)))))))\n   245\t\n   246\t\n   247\t;; =============================================================================\n   248\t;; Host scalar classification (S2 item 4)\n   249\t;; =============================================================================\n   250\t\n   251\t(defn- well-formed-utf16?\n   252\t  \"True when every surrogate in `s` is paired: the precondition every\n   253\t   host's UTF-8 encoder needs to agree. Matches the rule `yin.vm.debruijn/\n   254\t   well-formed-utf16?` enforces, independently written rather than\n   255\t   reused, per this phase's own instruction.\"\n   256\t  [s]\n   257\t  (let [n (count s)]\n   258\t    (loop [i 0]\n   259\t      (if (>= i n)\n   260\t        true\n   261\t        (let [c (code-unit-at s i)]\n   262\t          (cond\n   263\t            (<= 0xDC00 c 0xDFFF) false\n   264\t            (<= 0xD800 c 0xDBFF) (if (and (< (inc i) n)\n   265\t                                          (<= 0xDC00 (code-unit-at s (inc i)) 0xDFFF))\n   665\t                  (range 1 (count t)))))\n   666\t        (range (count v))))\n   667\t\n   668\t\n   669\t(def ^:private saturated-operands\n   670\t  \"The `[mnemonic index]` operands a canonical tuple must materialize\n   671\t   even though their :operand-kind check alone would tolerate nil -- the\n   672\t   same set `yin.vm.code`'s own :saturation rule judges\n   673\t   (`code/vector-operand-table`'s saturated pairs), over this\n   674\t   dimension's carried :gensym, :stream-make, :call, and :ffi-call.\n   675\t   :ffi-call's argc (index 2) is also already rejected as nil by the\n   676\t   stricter `:uint nonneg-int?` kind check above, so this entry is\n   677\t   redundant today; it is kept anyway so this set matches the source\n   678\t   table's own saturated pairs exactly, rather than silently drifting if\n   679\t   the :uint kind check is ever relaxed.\"\n   680\t  #{[:gensym 1] [:stream-make 1] [:call 2] [:ffi-call 2]})\n   681\t\n   682\t\n   683\t(defn- saturation-rule\n   684\t  [v]\n   685\t  (some (fn [pc]\n   686\t          (let [t (nth v pc)]\n   687\t            (when (some #(and (contains? saturated-operands [(mnemonic-of t) %])\n   688\t                              (nil? (nth t %)))\n   689\t                        (range 1 (count t)))\n   690\t              (tuple-defect :saturation pc))))\n   691\t        (range (count v))))\n   692\t\n   693\t\n   694\t(defn- target-bounds-rule\n   695\t  [v]\n   696\t  (let [length (count v)]\n   697\t    (some (fn [pc]\n   698\t            (let [t (nth v pc), kinds (tuple-kinds t)]\n   699\t              (some (fn [i]\n   700\t                      (when (= :pc (nth kinds (dec i)))\n   701\t                        (let [x (nth t i)]\n   702\t                          (when-not (and (nonneg-int? x) (<= x (dec length)))\n   703\t                            (tuple-defect :target-bounds pc)))))\n   704\t                    (range 1 (count t)))))\n   705\t          (range (count v)))))\n   706\t\n   707\t\n   708\t(defn- terminator-rule\n   709\t  [v]\n   710\t  (let [pc (dec (count v))]\n   711\t    (when-not (contains? code/terminators (mnemonic-of (nth v pc)))\n   712\t      (tuple-defect :terminator pc))))\n   713\t\n   714\t\n   715\t(def ^:private structural-rules\n   716\t  [nonempty mnemonic-rule arity-rule operand-kind-rule saturation-rule\n   717\t   target-bounds-rule terminator-rule])\n   718\t\n   719\t\n   720\t(defn well-formed-image?\n   721\t  \"Generic structural well-formedness of one canonical instruction vector\n   722\t   `v` against this dimension's own `opcode-table`: nil when `v` is well\n   723\t   formed, else the first defect as `{:rule r :pc p}` -- `:nonempty`,\n   724\t   `:mnemonic`, `:arity`, `:operand-kind`, `:saturation`, `:target-\n   725\t   boun