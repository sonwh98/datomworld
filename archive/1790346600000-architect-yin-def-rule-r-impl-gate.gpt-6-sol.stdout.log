erVM vm]\n   799\t  (assoc vm\n   800\t         :control (:program vm)\n   801\t         :k nil\n   802\t         :halted? (nil? (:program vm))\n   803\t         :value nil\n   804\t         :blocked? false))\n   805\t\n   853\t             acc []]\n   854\t        (if (nil? k) acc (recur (:next k) (conj acc k)))))))\n   855\t\n   856\t\n   857\t(defn create-vm\n   858\t  \"Create a new ASTWalkerVM.\n   859\t\n   860\t   Options:\n   861\t     :env           initial lexical environment\n   862\t     :primitives    primitive operations map\n   863\t     :primitive-profiles published primitive profile registry\n   864\t     :primitive-canonical-names name -> canonical name for intentional aliases\n   865\t     :modules       module registry value (see `yin.vm.module`)\n   866\t     :make-stream   (fn [capacity] -> create outcome); no default\n   867\t     :call-in       explicit inbound request handle\n   868\t     :call-out      explicit outbound response handle\n   869\t     :call-capacity capacity for a constructed FFI pair\n   870\t     :bridge        host FFI handlers\n   871\t\n   872\t   There is no `:in-stream`: program observation belongs to\n   873\t   `dao.stream.observer`, and an obsolete `:in-stream` option is\n   874\t   rejected here, before any FFI resource is allocated.\n   875\t\n   876\t   Construction is all-or-nothing: creating the FFI pair and minting the\n   877\t   call-out cursor are stream operations, and any non-`ok` outcome fails here\n   878\t   rather than leaving a half-built VM. The bridge cursor is minted by\n   879\t   `ffi/attach` below; the program cursor belongs to observer attachment.\"\n   880\t  ([] (create-vm {}))\n   881\t  ([opts]\n   882\t   (when (contains? opts :in-stream)\n   883\t     (throw (ex-info\n   884\t              \"Program observation moved to dao.stream.observer: a VM no longer accepts :in-stream\"\n   885\t              {:in-stream (:in-stream opts)})))\n   886\t   (let [env (vm/check-bindings! :env (or (:env opts) {}))\n   887\t         base (vm/empty-state\n   888\t                (assoc (select-keys opts\n   889\t                                    [:primitives :primitive-profiles\n   890\t                                     :primitive-canonical-names :modules\n   891\t                                     :make-stream :call-in :call-out\n   892\t                                     :call-capacity])\n   893\t                       :telemetry (:telemetry opts)\n   894\t                       :vm-model :ast-walker))]\n   895\t     (-> (map->ASTWalkerVM (merge base\n   896\t                                  {:bridge nil,\n   897\t                                   :program nil,\n   898\t                                   :control nil,\n   899\t                                   :env env,\n   900\t                                   :k nil,\n   901\t                                   :value nil,\n   902\t                                   :halted? true,\n   903\t                                   :blocked? false}))\n   904\t         (telemetry/install :ast-walker)\n   905\t         (ffi/attach (:bridge opts))\n   906\t         (telemetry/emit-snapshot :init)))))\n   690\t\n   691\t   `contract` is required and compared with `vm/semantic-contract` before\n   692\t   the batch is judged (`:contract-missing`, `:contract-mismatch`); S2.6\n   693\t   well-formedness then includes Rule R's reserved-operand rule.\"\n   694\t  [vm datoms contract]\n   695\t  (vm/check-contract! vm/semantic-contract contract)\n   696\t  (let [image (load-image datoms)]\n   697\t    (assoc vm\n   698\t           :program (:segment image)\n   699\t           :code (store-image (:code vm) image)\n   700\t           :code-aliases (store-alias (:code-aliases vm) image)\n   701\t           :control {:segment (:segment image), :pc 0}\n   702\t           :stack []\n   703\t           :k nil\n   704\t           :halted? false\n   705\t           :blocked? false\n   706\t           :value nil)))\n   707\t\n