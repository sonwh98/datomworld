         '[yang.python.antlr.int-ops-test :as ops]
         '[yang.python.antlr.prelude :as p]
         '[yang.python.antlr.uast :as u])
(def mutations
  [[\"bool result\" 'py/int-op '(= r 1) 'r]
   [\"invert sign\" 'py/invert '(integer/bit-not (py/num a))
    '(integer/bit-not (py/abs (py/num a)))]
   [\"negative and\" 'py/bitand '(py/int-op integer/bit-and a b)
    '(py/int-op integer/bit-and (py/abs (py/num a)) (py/num b))]
   [\"count precheck\" 'py/shift '(< (integer/compare (py/num n) 0) 0) false]
   [\"negative floor\" 'py/rshift '(py/shift integer/shift-right a n)
    '(if (< (integer/compare (py/num a) 0) 0)
       (py/neg (py/shift integer/shift-right (py/abs (py/num a)) n))
       (py/shift integer/shift-right a n))]
   [\"count zero\" 'py/shift '(op (py/num a) (py/num n))
    '(op (py/num a) (if (= (py/num n) 0) 1 (py/num n)))]])
(defn ast [defs]
  (u/then (u/seq-nodes
            (map (fn [[k f]] (u/def"'! k (u/sexp->uast f))) defs))
          (u/seq-nodes
            (map (fn [[k f]] (u/def! k (u/sexp->uast f)))
                 @(ns-resolve '"'yang.python.antlr.prelude
                              'state-definitions)))))
(doseq [[label key before after] mutations]
  (let [changed (atom 0)
        defs (mapv (fn [[k f]]
                     [k (if (= k key)
                          (w/postwalk
                            (fn [x] (if (= x before)
                                      (do (swap"'! changed inc) after) x)) f)
                          f)]) p/function-definitions)
        counters (ref t/*initial-report-counters*)]
    (assert (= 1 @changed))
    (println "MUTATION" label)
    (binding [t/*report-counters* counters]
      (with-redefs [p/uast (ast defs)]
        (t/test-vars [#'"'ops/exact-bitwise-shifts-test]))
      (println \"COUNTERS\" @counters)
      (assert (= 4 (:fail @counters))))))
