                               (number? a) -1\n   162\t                                     :else 1))\n   163\t                             tempids)]\n   164\t    (zipmap sorted-tempids\n   165\t            (range start-eid (+ start-eid (count sorted-tempids))))))\n   166\t\n   167\t\n   168\t(defn- apply-tempid-map\n   169\t  \"Replace tempids with permanent entity IDs in parsed ops.\"\n   170\t  [ops tempid-map effective-ref-attrs]\n   171\t  (mapv (fn [op]\n   172\t          (let [e' (if (tempid? (:e op))\n   173\t                     (get tempid-map (:e op) (:e op))\n   174\t                     (:e op))\n   175\t                v' (if (and (contains? effective-ref-attrs (:a op))\n   176\t                            (tempid? (:v op)))\n   177\t                     (get tempid-map (:v op) (:v op))\n   178\t                     (:v op))\n   179\t                m-raw' (if (tempid? (:m-raw op))\n   180\t                         (get tempid-map (:m-raw op) (:m-raw op))\n   181\t                         (:m-raw op))]\n   182\t            (assoc op\n   183\t                   :e e'\n   117\t(defn- derive-next-t\n   118\t  \"Derive the next transaction time from a flattened retained history: 0 for\n   119\t   an empty history, else 1 + the maximum datom t. A datom t that is not a\n   120\t   non-negative integer is a malformed history and throws — this scan is the\n   121\t   causality boundary of the value.\"\n   122\t  [datoms]\n   123\t  (if (empty? datoms)\n   124\t    0\n   125\t    (let [ts (mapv index/datom-t datoms)]\n   126\t      (when-not (every? #(and (integer? %) (<= 0 %)) ts)\n   127\t        (throw\n   128\t          (ex-info\n   129\t            \"malformed retained history: datom t must be a non-negative integer\"\n   130\t            {:history datoms})))\n   131\t      (inc (reduce max ts)))))\n   132\t\n20:   by reference and never encoded, so no value is uncarriable.\n70:  ;; dropped, and the tail is (count values).\n72:         :values []\n110:    