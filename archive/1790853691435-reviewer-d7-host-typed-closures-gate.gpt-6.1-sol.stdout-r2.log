{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"rg --files /Users/sto/workspace/datomworld/collab | rg '1790851062697.*orchestrator'; tail -8 /Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-clj-r2.log; sed -n '1,55p' src/cljc/yin/vm/telemetry.cljc; rg -n 'defn summarize|host-object|deftype|pr-str' src/cljc/dao/data.cljc; rg -n 'format-value|adapter/result|repl/result|summarize' src/cljc/yin/repl/serve.cljc src/cljc/yin/repl/adapter.cljc; sed -n '358,409p' test/yin/vm/host_typed_values_test.cljc; sed -n '90,101p' src/cljc/yin/vm/engine.cljc\"","aggregated_output":"/Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-antlr-gen-r2.log\n/Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-antlr-gen.log\n/Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-clj.log\n/Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-node-build-r2.log\n/Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-node-build.log\n/Users/sto/workspace/datomworld/collab/1790851062697-vm-engineer-d7-host-typed-closures.orchestrator-clj-r2.log\n\nTesting datomworld.demo.voxel-input-test\n\nTesting datomworld.demo.voxel-runner-test\n\nTesting datomworld.demo.voxel-scene-test\n\nTesting yang.clojure.stream-eval-test\n(ns yin.vm.telemetry\n  \"The v2 telemetry emit path: full VM state snapshots as datoms on an\n   explicit dao.stream sink.\n\n   Opt-in through the :telemetry construction option\n   ({:stream <writer> :vm-id <id>}, stored by yin.vm/empty-state and\n   validated by install). A VM built without it is behaviorally identical\n   to one with no telemetry at all: enabled? is false and emit-snapshot is\n   identity on state, so every emit site in the engine, the FFI, and the\n   two VMs stays a no-op.\n\n   emit-snapshot fires at the runtime boundaries vm-telemetry-design.md\n   names — construction :init, each successful step :step, each handled\n   effect :effect, park :park, resume :resume, bridge dispatch :bridge,\n   and the run loop's terminal :blocked and :halt. Each call emits one\n   full snapshot, not a delta: a root :vm/snapshot entity carrying the VM\n   facts and refs to component entities, every component and summary node\n   an entity of its own, all datoms sharing one t, and the counters\n   advancing once per snapshot (one snapshot = one transaction).\n\n   Summaries are dao.data/summarize trees projected one-to-one onto the\n   :vm.summary/* attribute vocabulary, so no datom ever carries a\n   function, stream handle, or host object. Store summaries preserve\n   stream identities and cursor positions; continuation summaries carry\n   the parked set, so parked continuation identities survive.\n\n   append! outcomes are read and discarded: :dao.stream/full drops that\n   datom with no retry — telemetry is lossy by design, an observability\n   side channel must not park or fail the VM it observes — and terminal\n   outcomes are ignored rather than raised.\"\n  (:require [dao.data :as data]\n            [dao.datom :as datom]\n            [dao.stream :as stream]))\n\n\n(def summary-bounds\n  \"The fixed bounds every telemetry summary runs under. Deep enough that a\n   store's stream identities and cursor positions — plain data two or\n   three levels under the store map — always survive; wide and long\n   enough that uuids and typical identifiers are never cut.\"\n  {:depth 6, :items 16, :chars 128})\n\n\n(defn summarize-control\n  \"Bounded plain-data summary of the control component (an AST node, a\n   segment pointer, ...). A thin wrapper over dao.data/summarize: the\n   wrapper fixes the bounds, dao.data does all the bounded traversal.\"\n  [control]\n  (data/summarize control summary-bounds))\n\n\n(defn summarize-environment\n  \"Bounded plain-data summary of the lexical environment. Bindings are map\n   entries, so names and values both survive as summarized nodes.\"\n  [environment]\n109:(defn summarize\nsrc/cljc/yin/repl/serve.cljc:272:             (str \"cannot serve \" (pr-str (data/summarize path diagnostic-bounds))\nsrc/cljc/yin/repl/serve.cljc:273:                  \" on port \" (pr-str (data/summarize bind-port diagnostic-bounds))))\nsrc/cljc/yin/repl/serve.cljc:351:                        (str \" (bound \" (pr-str (data/summarize value diagnostic-bounds)) \")\")))))\nsrc/cljc/yin/repl/serve.cljc:358:                      (pr-str (data/summarize value diagnostic-bounds)))))\nsrc/cljc/yin/repl/serve.cljc:362:             (str \";; upgrade refused: \" (pr-str (data/summarize value diagnostic-bounds))))\nsrc/cljc/yin/repl/serve.cljc:366:             (str \";; listener error: \" (pr-str (data/summarize value diagnostic-bounds))))\nsrc/cljc/yin/repl/serve.cljc:372:                 (str \"Endpoint stopped: \" (pr-str (data/summarize value diagnostic-bounds)))))\nsrc/cljc/yin/repl/serve.cljc:645:                          (pr-str (data/summarize (:dao.stream/diagnostic result)\n\n\n(deftest a-lower-takes-its-binders-from-the-attached-lambda-test\n  (testing \"named kernels: the wire's params are checked, then must be the\n            attached lambda's\"\n    (doseq [k [:ast-walker :semantic]]\n      (doseq [[binder kind] bad-binders]\n        (is (= {:reason :non-symbol-parameter, :kind kind}\n               (select-keys (lower-tampered k #(assoc % :yin.k/params [binder]))\n                            [:reason :kind]))\n            (str k \" \" (pr-str binder))))\n      (doseq [params ['[y] '[x y] '[]]]\n        (is (= :marker-mismatch\n               (:reason (lower-tampered k #(assoc % :yin.k/params params))))\n            (str k \" \" params)))))\n  (testing \"positional kernels bind by position: the wire's arity must be\n            the attached lambda's\"\n    (doseq [k [:stack :register]\n            arity [0 2]]\n      (is (= :marker-mismatch\n             (:reason (lower-tampered k #(assoc % :yin.k/arity arity))))\n          (str k \" arity \" arity))))\n  (testing \"an untampered marker lowers\"\n    (doseq [k (keys kernels)]\n      (is (vector? (lower-tampered k identity)) (str k)))))\n\n\n(deftest a-foreign-closure-refuses-to-lift-test\n  (doseq [k (keys kernels)]\n    (let [a (run-on k (define 'f inc-fn) task-a)\n          b (assoc-in (run-on k (lit 0) task-b) [:store 'f]\n                      (get (:store a) 'f))]\n      (is (= {:yin.k/status :yin.k/non-portable,\n              :yin.k/kind :foreign-value,\n              :yin.k/hint :closure}\n             (refusal-of #(engine/lift-slice b :segment/own ['f])))\n          (str k)))))\n\n\n;; =============================================================================\n;; Equality: structural over kind, owner and payload\n;; =============================================================================\n\n(def ^:private two-from-one-lambda\n  (let1 'mk (lam [] (lam ['x] (v 'x)))\n        (app (v 'conj) (app (v 'conj) (lit []) (app (v 'mk))) (app (v 'mk)))))\n\n\n(deftest closures-from-one-lambda-are-equal-test\n  (doseq [k (keys kernels)]\n    (let [[c1 c2] (vm/value (run-on k two-from-one-lambda))]\n      (testing (str k)\n\n(defn marker-mismatch!\n  \"Refuse to lower closure `marker` whose binders (a named kernel's\n   `:yin.k/params`, a positional kernel's `:yin.k/arity`) are not those of\n   the attached lambda it names: a lower mints an applicable closure, so\n   the wire never chooses what a closure binds.\"\n  [marker]\n  (fail \"Closure marker disagrees with its attached lambda\"\n        {:reason :marker-mismatch, :segment (:yin.k/segment marker)}))\n\n\n(defn continuation-argument\n","exit_code":0,"status":"completed"}}
