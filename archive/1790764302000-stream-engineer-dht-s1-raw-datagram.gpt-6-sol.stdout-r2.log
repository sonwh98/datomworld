datagram/dart_test.cljd:205:          (is (= :dao.stream/invalid-value\ntest/dao/stream/datagram/dart_test.cljd:206:                 (:dao.stream/outcome\ntest/dao/stream/datagram/dart_test.cljd:209:          (is (= :dao.stream/invalid-value\ntest/dao/stream/datagram/dart_test.cljd:210:                 (:dao.stream/outcome\ntest/dao/stream/datagram/dart_test.cljd:217:          (is (= :dao.stream/invalid-value\ntest/dao/stream/datagram/dart_test.cljd:218:                 (:dao.stream/outcome\ntest/dao/stream/datagram/dart_test.cljd:231:          (is (= {:dao.stream/outcome :dao.stream/ok}\ntest/dao/stream/datagram/dart_test.cljd:233:          (is (= {:dao.stream/outcome :dao.stream/closed}\ntest/dao/stream/datagram/dart_test.cljd:244:        (testing \"a send the seam itself fails is a send-failed event\"\ntest/dao/stream/datagram/dart_test.cljd:246:            (is (= :dao.stream/transport-error (:dao.stream/outcome r)))\ntest/dao/stream/datagram/dart_test.cljd:251:                                        (= :dao.stream.datagram/send-failed\ntest/dao/stream/datagram/dart_test.cljd:255:              (is (some? failed) \"no send-failed event deposited\"))))\ntest/dao/stream/datagram/dart_test.cljd:296:                 counted, never deposited\"))\ntest/dao/stream/datagram/dart_test.cljd:325:            (is (= :dao.stream/gap (:dao.stream/outcome gapped))\ntest/dao/stream/datagram/dart_test.cljd:331:                (if (= :dao.stream/ok (:dao.stream/outcome r))\n","exit_code":0,"status":"completed"}}
