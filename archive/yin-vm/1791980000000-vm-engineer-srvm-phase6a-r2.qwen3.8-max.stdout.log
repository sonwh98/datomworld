}\n104:         if n != 1:\n105:             rec[\"status\"] = f\"NEEDLE-COUNT-{n}\"\n106:             results.append(rec); print(json.dumps(rec)); continue\n107:         mutated = src.replace(needle, repl)\n108:         try:\n109:             with open(full, \"w\", encoding=\"utf-8\") as f:\n110:                 f.write(mutated)\n111:             argv = [\"clojure\", \"-M:test\", \"-n\", ns, \"-v\", f\"{ns}/{var}\"]\n112:             t0 = time.time()\n113:             code, out = sh(argv)\n114:             rec[\"argv\"] = argv\n115:             rec[\"exit\"] = code\n116:             rec[\"seconds\"] = round(time.time() - t0, 1)\n117:             m = re.search(r\"Ran (\\d+) tests containing (\\d+) assertions\\.\\n(\\d+) failures, (\\d+) errors\", out)\n118:             if m:\n119:                 rec[\"tests\"], rec[\"assertions\"], rec[\"failures\"], rec[\"errors\"] = map(int, m.groups())\n120:             else:\n121:                 rec[\"tail\"] = out[-1500:]\n122:             fails = [l for l in out.splitlines() if l.startswith(\"FAIL in\") or l.startswith(\"ERROR in\")]\n123:             rec[\"fail_lines\"] = fails[:6]\n124:             killed = code != 0\n125:             rec[\"status\"] = \"KILLED\" if killed else \"SURVIVED\"\n126:             with open(os.path.join(ROOT, \"collab\", f\"6a-reviewer-{mid}.log\"), \"w\") as lf:\n127:                 lf.write(\" \".join(argv) + \"\\n\" + out)\n128:         finally:\n129:             with open(os.path.join(ROOT, BACKUP[path]), encoding=\"utf-8\") as b:\n130:                 orig = b.read()\n131:             with open(full, \"w\", encoding=\"utf-8\") as f:\n132:                 f.write(orig)\n133:             c1, _ = sh([\"cmp\", path, BACKUP[path]])\n134:             c2, _ = sh([\"git\", \"diff\", \"--quiet\", \"HEAD\", \"--\", path])\n135:             rec[\"restore_cmp\"] = c1\n136:             rec[\"restore_git_diff\"] = c2\n137:         results.append(rec)\n138:         print(json.dumps(rec), flush=True)\n139