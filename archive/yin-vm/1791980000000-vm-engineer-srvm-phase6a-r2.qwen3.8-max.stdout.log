n\",\n54:   RT, \"numbering-precedes-frame-defect\", \"X1 judged after waits\"),\n55:  (\"R26\", ROWS, \"    (= kind :set) (sorted-bytes slots)\\n    :else slots))\", \"    :else slots))\", RT, \"canonical-under-is-renaming-invariant\", \"set slots not sorted on emit\"),\n56:  (\"R27\", ROWS, \"         (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\\n\", \"\", RT, \"window-sorted-and-unique\", \"row-order check removed\"),\n57:  (\"R28\", ROWS, \"(when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\", \"(when false\", RT, \"numbering-precedes-frame-defect\", \"noncanonical-cells comparison removed\"),\n58:  (\"R29\", ROWS, \"                 (when (contains? active id) (bad! :cyclic [id]))\\n                 (let [row (get index id) slots (when row (subvec row 2))]\", \"                 (let [row (get index id) slots (when row (subvec row 2))]\", RT, \"child-scope-and-shared-child-dag\", \"gate cycle check removed\"),\n59:  (\"R30\", ROWS, \"(when (code/well-formed? v) (bad! :code [id 11 address]))\", \"nil\", RT, \"task-root-checks-carried-code-and-frame\", \"carried code well-formedness unchecked\"),\n60:  (\"R31\", ROWS, \"  (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\", \"  (into {} (keep (fn [[k v]] (let [x (decode-value v)] (when (some? x) [k x])))) (partition 2 (:slots n))))\", RT, \"bijection\", \"[:lit nil] decoded as absence (key dropped)\"),\n61:  (\"R32\", ROWS, \"               (spend! counter budget :search 1)\\n\", \"\", RT, \"refinement-search-preserves-unordered-multiplicity\", \"search bound removed\"),\n62:  (\"R33\", ROWS, \"                        :lit (when-not (literal? (second x)) (bad! :literal p))\", \"                        :lit nil\", RT, \"schema-and-literal-canonicality\", \"non-portable literal accepted\"),\n63:  (\"R34\", ROWS, \"                         (not (some reference? slots))) (bad! :reference-free-row path))\", \"          