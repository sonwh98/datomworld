{"type":"event","event":{"type":"tool_completed","toolCallId":"call_d81a7f85395c4d5eaee7f536","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 677 lines\n1: (ns yin.vm.ucf.rows\n2:   \"Version-3 row codec. Pure row construction, graph decoding and canonical\n3:    cell numbering; no machine attachment, dependency scanner or transport.\n4:    An abstract row is {:kind keyword :slots vector}. Structural references\n5:    contain abstract rows; values use [:lit d], [:row abstract-row], [:cell id].\n6:    A task's :cells row holds alternating source identities and :cell-body\n7:    rows. Install children are separate tasks with separate cell scopes.\"\n8:   (:require [clojure.edn :as edn]\n9:             [dao.jing :as jing]\n10:             [dao.jing.cbor :as cbor]\n11:             [yin.vm.semantic-register.code :as code]\n12:             [yin.vm.semantic-register.frame :as frame]))\n13: \n14: \n15: (def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n16: \n17: \n18: (def pending-table\n19:   {:next [:C]\n20:    :put [[:ref :stream] :V :D]\n21:    :ffi [:C :D :D]\n22:    :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n23:    :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n24:    :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n25:    :install [:S]})\n26: \n27: \n28: (def row-table\n29:   \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n30:    :refs is an ordered vector of structural references. :pending is\n31:    discriminated by pending-table. Nothing in this table is executable.\"\n32:   {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n33:    :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n34:    :env [[:ref :bindings] :optional-D]\n35:    :closure [:A :N :syms [:ref :bindings] :optional-D]\n36:    :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n37:    :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n38:    :tail [:A :N [:ref :k]]\n39:    :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n40:    :kframe [:A :N [:ref :env] [:ref :window] :N]\n41:    :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n42:    :module-store [:D [:ref :store]]\n43:    :parked-table [:pairs :D [:ref :act :tail]]\n44:    :install [:S :D :D :D [:ref :task]]\n45:    :cells [:pairs :C [:ref :cell-body]] :cell-body [[:ref :stream] :D]\n46:    :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n47:           [:refs :module-store] [:ref :parked-table] [:ref :cells]\n48:           :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n49: \n50: \n51: (defn node\n52:   [kind slots]\n53:   {:kind kind :slots (if (= :window kind)\n54:                        (vec (mapcat identity (sort-by first (partition 2 slots))))\n55:                        (vec slots))})\n56: \n57: \n58: (defn- refuse!\n59:   [status kind path]\n60:   (throw (ex-info \"Row codec refused data\"\n61:                   {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n62: \n63: \n64: (defn- bad!\n65:   [kind path]\n66:   (refuse! :yin.k/undecodable kind path))\n67: \n68: \n69: (defn- bytes-key\n70:   [bs]\n71:   ;; Unsigned bytewise order, without a length-first comparison.\n72:   (mapv #(bit-and (int %) 255) (seq bs)))\n73: \n74: \n75: (defn- compare-bytes\n76:   [a b]\n77:   (loop [i 0]\n78:     (cond\n79:       (= i (count a)) (if (= i (count b)) 0 -1)\n80:       (= i (count b)) 1\n81:       (= (nth a i) (nth b i)) (recur (inc i))\n82:       :else (compare (nth a i) (nth b i)))))\n83: \n84: \n85: (defn- byte-compare\n86:   [a b]\n87:   (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n88: \n89: \n90: (defn- sorted-bytes\n91:   [xs]\n92:   (vec (sort byte-compare xs)))\n93: \n94: \n95: (defn- descriptors\n96:   [kind slots]\n97:   (let [schema (get row-table kind)]\n98:     (cond\n99:       (= schema :pending) (into [:D] (get pending-table (first slots)))\n100:       (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n101:       (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n102:       :else schema)))\n103: \n104: \n105: (defn- ref?\n106:   [d]\n107:   (and (vector? d) (= :ref (first d))))\n108: \n109: \n110: (defn- refs?\n111:   [d]\n112:   (and (vector? d) (= :refs (first d))))\n113: \n114: \n115: (defn- ordered-slots\n116:   [kind slots]\n117:   (cond\n118:     (= kind :window) (vec (mapcat identity (sort-by first (partition 2 slots))))\n119:     (= kind :cells) (vec (mapcat identity (sort-by #(edn/read-string (subs (name (first %)) 2)) (partition 2 slots))))\n120:     (contains? #{:map :bindings :store :parked-table} kind)\n121:     (vec (mapcat identity (sort #(byte-compare (first %1) (first %2)) (partition 2 slots))))\n122:     (= kind :set) (sorted-bytes slots)\n123:     :else slots))\n124: \n125: \n126: (declare emit-node canonical-numbering validate-frames)\n127: \n128: \n129: (defn- emit-slot\n130:   [d x numbering rows]\n131:   (cond\n132:     (ref? d) (emit-node x numbering rows)\n133:     (refs? d) (reduce (fn [[out rs] n]\n134:                         (let [[id rs'] (emit-node n numbering rs)] [(conj out id) rs']))\n135:                       [[] rows] x)\n136:     (= d :C) [(get numbering x x) rows]\n137:     (contains? #{:V :optional-V} d)\n138:     (case (first x)\n139:       :row (let [[id rs] (emit-node (second x) numbering rows)] [[:row id] rs])\n140:       :cell [[:cell (get numbering (second x) (second x))] rows]\n141:       [x rows])\n142:     :else [x rows]))\n143: \n144: \n145: (defn- emit-node\n146:   [n numbering rows]\n147:   (let [{:keys [kind slots]} n\n148:         ;; A child is canonicalized in its own identity scope.\n149:         [slots rows] (reduce (fn [[out rs] [d x]]\n150:                                (if (and (ref? d) (= :task (:kind x)))\n151:                                  (let [[id child-rows] (emit-node x (canonical-numbering x) {})]\n152:                                    [(conj out id) (merge rs child-rows)])\n153:                                  (let [[x' rs'] (emit-slot d x numbering rs)] [(conj out x') rs'])))\n154:                              [[] rows] (map vector (descriptors kind slots) slots))\n155:         slots (if (= kind :task)\n156:                 (-> slots\n157:                     (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n158:                     (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n159:                 (ordered-slots kind slots))\n160:         body (into [kind] slots) id (jing/segment-key body)]\n161:     [id (assoc rows id (into [id] body))]))\n162: \n163: \n164: (def default-budget\n165:   \"Local resource bounds, independent of canonical bytes.\"\n166:   {:rows 10000 :cells 64 :depth 256 :work 200000 :search 10000 :bytes 16777216})\n167: \n168: \n169: (defn- spend!\n170:   [counter budget category amount]\n171:   (let [n (get (swap! counter update category (fnil + 0) amount) category)]\n172:     (when (> n (get budget category))\n173:       (refuse! :yin.k/unsupported :resource-limit [category]))))\n174: \n175: \n176: (declare canonical-numbering)\n177: \n178: \n179: (defn canonical-numbering\n180:   \"Draft §6 refinement and exhaustive individualization search. Returns\n181:    source-cell -> :yin.k/c-N. No encounter-order tie break. A budget\n182:    exhaustion is a resource refusal, never a canonicality verdict.\"\n183:   ([task] (canonical-numbering task default-budget))\n184:   ([task budget]\n185:    (let [budget (merge default-budget budget) counter (atom {})\n186:          cells (into {} (map vec) (partition 2 (:slots (nth (:slots task) 9))))\n187:          ids (vec (keys cells))\n188:          labels (into {} (map (fn [[id body]]\n189:                                 (let [[stream position] (:slots body)]\n190:                                   [id (cbor/encode [:body (cbor/encode (into [:stream] (:slots stream)))\n191:                                                     (cbor/encode position)])])) cells))]\n192:      (spend! counter budget :cells (count ids))\n193:      (letfn [(ce-slot\n194:                [d x ls]\n195:                (spend! counter budget :work 1)\n196:                (cond\n197:                  (ref? d) (ce x ls)\n198:                  (refs? d) (mapv #(ce % ls) x)\n199:                  (= :C d) [:cell (get ls x)]\n200:                  (contains? #{:V :optional-V} d)\n201:                  (case (first x) :cell [:cell (get ls (second x))]\n202:                        :row [:row (ce (second x) ls)] x)\n203:                  :else x))\n204:              (ce\n205:                [n ls]\n206:                (let [{:keys [kind slots]} n]\n207:                  (cond\n208:                    (= :cells kind) [:cells]\n209:                    (and (= :task kind) (not (identical? n task)))\n210:                    (let [[id _rows] (emit-node n (canonical-numbering n budget) {})]\n211:                      [:child (cbor/encode id)])\n212:                    :else\n213:                    (let [ss (mapv #(ce-slot %1 %2 ls) (descriptors kind slots) slots)\n214:                          ss (cond\n215:                               (contains? #{:map :store :bindings :parked-table} kind)\n216:                               (sorted-bytes (mapv vec (partition 2 ss)))\n217:                               (= :set kind) (sorted-bytes ss)\n218:                               (= :task kind) (-> ss (update 7 sorted-bytes) (update 12 sorted-bytes))\n219:                               :else ss)]\n220:                      (into [kind] ss)))))\n221:              (positions\n222:                [ls]\n223:                (let [out (atom (zipmap ids (repeat [])))]\n224:                  (letfn [(visit-slot\n225:                            [d x path depth]\n226:                            (spend! counter budget :work 1)\n227:                            (when (> depth (:depth budget))\n228:                              (refuse! :yin.k/unsupported :resource-limit [:depth]))\n229:                            (cond\n230:                              (= :C d) (swap! out update x conj (cbor/encode path))\n231:                              (ref? d) (visit x path (inc depth))\n232:                              (contains? #{:V :optional-V} d)\n233:                              (case (first x)\n234:                                :cell (swap! out update (second x) conj (cbor/encode path))\n235:                                :row (visit (second x) path (inc depth)) nil)\n236:                              :else nil))\n237:                          (visit\n238:                            [n path depth]\n239:                            (let [{:keys [kind slots]} n ds (descriptors kind slots)]\n240:                              (when-not (or (= :cells kind)\n241:                                            (and (= :task kind) (not (identical? n task))))\n242:                                (cond\n243:                                  (contains? #{:map :store :bindings :parked-table} kind)\n244:                                  (doseq [[i [key value]] (map-indexed vector (partition 2 slots))]\n245:                                    (let [kd (nth ds (* 2 i)) vd (nth ds (inc (* 2 i)))\n246:                                          ck (ce-slot kd key ls)]\n247:                                      (visit-slot kd key (conj path [kind :key ck]) depth)\n248:                                      (visit-slot vd value (conj path [kind :val ck]) depth)))\n249:                                  (= :set kind)\n250:                                  (doseq [x slots] (visit-slot :V x (conj path [kind :elem (ce-slot :V x ls)]) depth))\n251:                                  :else\n252:                                  (doseq [[i d x] (map vector (range) ds slots)]\n253:                                    (if (refs? d)\n254:                                      (doseq [[j child] (map-indexed vector x)]\n255:                                        (visit child\n256:                                               (conj path (if (= i 13) [:task :frame j]\n257:                                                              [kind :val (first (:slots child))]))\n258:                                               (inc depth)))\n259:                                      (visit-slot d x (conj path [kind i]) depth)))))))]\n260:                    (visit task [] 0)\n261:                    @out)))\n262:              (classes\n263:                [ls]\n264:                (vec (sort #(compare-bytes (first %1) (first %2))\n265:                           (map (fn [[label members]] [label (vec members)])\n266:                                (reduce (fn [m id] (update m (bytes-key (get ls id)) (fnil conj []) id)) {} ids)))))\n267:              (refine\n268:                [ls]\n269:                (let [ps (positions ls)\n270:                      next-ls (into {} (map (fn [id]\n271:                                              [id (cbor/encode [:sig (get ls id)\n272:                                                                (vec (sort #(compare-bytes (bytes-key %1) (bytes-key %2)) (get ps id)))])]) ids))]\n273:                  (if (= (count (classes ls)) (count (classes next-ls))) next-ls (recur next-ls))))\n274:              (search\n275:                [ls depth]\n276:                (spend! counter budget :search 1)\n277:                (let [ls (refine ls) cs (classes ls)\n278:                      unresolved (first (filter #(> (count (second %)) 1) cs))]\n279:                  (if unresolved\n280:                    (reduce (fn [best id]\n281:                              (let [leaf (search (assoc ls id (cbor/encode [:ind depth (get ls id)])) (inc depth))]\n282:                                (if (or (nil? best) (neg? (compare-bytes (:key leaf) (:key best)))) leaf best)))\n283:                            nil (second unresolved))\n284:                    (let [numbering (into {} (map-indexed (fn [i [_ members]]\n285:                                                            [(first members) (keyword \"yin.k\" (str \"c-\" (inc i)))]) cs))\n286:                          [id rows] (emit-node task numbering {})]\n287:                      {:numbering numbering :key (bytes-key (cbor/encode (subvec (get rows id) 1)))}))))]\n288:        (if (empty? ids) {} (:numbering (search labels 0)))))))\n289: \n290: \n291: (defn emit-numbered\n292:   \"Emit under a supplied numbering. Useful for canonicality probes;\n293:    ordinary callers use emit, which computes the canonical numbering.\"\n294:   [task numbering]\n295:   (let [[id rows] (emit-node task numbering {})]\n296:     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))}))\n297: \n298: \n299: (defn emit\n300:   \"Emit an abstract task as a self-contained carrier. This is a codec,\n301:    not lift-task: the caller supplies the complete abstract row tree.\"\n302:   ([task] (emit task default-budget))\n303:   ([task budget]\n304:    (let [[id rows] (emit-node task (canonical-numbering task budget) {})]\n305:      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n306: \n307: \n308: (defn- structural?\n309:   [d x]\n310:   (cond\n311:     (or (ref? d) (= :C d)) (keyword? x)\n312:     (refs? d) (and (vector? x) (every? keyword? x))\n313:     (contains? #{:V :optional-V} d)\n314:     (or (and (= :optional-V d) (nil? x))\n315:         (and (vector? x) (= 2 (count x)) (contains? #{:lit :row :cell} (first x))\n316:              (or (= :lit (first x)) (keyword? (second x)))))\n317:     (= :N d) (and (code/reg? x) (<= x 4503599627370495))\n318:     (= :S d) (symbol? x)\n319:     (= :syms d) (and (vector? x) (every? symbol? x))\n320:     (= :A d) (some? (jing/parse-segment-address x))\n321:     :else true))\n322: \n323: \n324: (defn- literal?\n325:   [x]\n326:   (and (not (cbor/byte-payload? x))\n327:        (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n328:            (number? x)\n329:            (and (coll? x)\n330:                 (every? literal? (if (map? x) (mapcat identity x) x))\n331:                 (or (nil? (meta x)) (literal? (meta x))))\n332:            (try (some? (cbor/numeric-kind x))\n333:                 (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))))\n334: \n335: \n336: (def value-row-kinds #{:vec :list :set :map :closure :prim :stream :reified :parked-ref})\n337: \n338: \n339: (defn- check-abstract!\n340:   [root]\n341:   (letfn [(value\n342:             [v]\n343:             (case (first v)\n344:               :lit (second v)\n345:               :cell [:identity (second v)]\n346:               :row (let [n (second v) ss (:slots n)]\n347:                      (case (:kind n)\n348:                        :vec (mapv value ss)\n349:                        :list (apply list (map value ss))\n350:                        :set (set (map value ss))\n351:                        :map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))\n352:                        n))))\n353:           (reference?\n354:             [v]\n355:             (case (first v)\n356:               :cell true\n357:               :lit false\n358:               :row (let [n (second v)]\n359:                      (if (contains? #{:vec :list :set :map} (:kind n))\n360:                        (boolean (some reference? (:slots n))) true))\n361:               false))\n362:           (visit\n363:             [n path cells reached]\n364:             (let [{:keys [kind slots]} n ds (descriptors kind slots)]\n365:               (when (contains? #{:map :set} kind)\n366:                 (let [vs (if (= :set kind) slots (map first (partition 2 slots)))\n367:                       decoded (map value vs)]\n368:                   (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n369:               (when (and (contains? #{:vec :list :set :map} kind)\n370:                          (not (some reference? slots))) (bad! :reference-free-row path))\n371:               (doseq [[i d x] (map vector (range) ds slots)]\n372:                 (let [p (conj path i)]\n373:                   (cond\n374:                     (= :C d) (do (when-not (contains? cells x) (bad! :missing-cell p)) (swap! reached conj x))\n375:                     (and (ref? d) (= :task (:kind x))) (check-task x p)\n376:                     (and (ref? d) (not= :cells (:kind x))) (visit x p cells reached)\n377:                     (refs? d) (doseq [[j child] (map-indexed vector x)]\n378:                                 (visit child (conj p j) cells reached))\n379:                     (contains? #{:V :optional-V} d)\n380:                     (when x\n381:                       (case (first x)\n382:                         :lit (when-not (literal? (second x)) (bad! :literal p))\n383:                         :cell (do (when-not (contains? cells (second x)) (bad! :missing-cell p))\n384:                                   (swap! reached conj (second x)))\n385:                         :row (visit (second x) p cells reached)))\n386:                     :else nil)))))\n387:           (check-task\n388:             [task path]\n389:             (let [slots (:slots task) census (nth slots 9)\n390:                   cells (into {} (map vec) (partition 2 (:slots census))) reached (atom #{})]\n391:               (visit task path cells reached)\n392:               (when-not (= (set (keys cells)) @reached) (bad! :extra-cell (conj path 9)))))]\n393:     (when (= :task (:kind root)) (check-task root []))))\n394: \n395: \n396: (defn- decode*\n397:   \"Validate gate, local schema, finite reachable graph, hashes, canonical\n398:    form and cell numbering, then expand structural refs. No attachment.\n399:    Frame checks are available separately through validate-frames.\"\n400:   ([wire] (decode* wire default-budget))\n401:   ([wire budget]\n402:    (let [budget (merge default-budget budget) counter (atom {})\n403:          rs (:yin.k/rows wire)]\n404:      (when-not (and (= true (:yin.k/handoff wire)) (= 3 (:yin.k/version wire))\n405:                     (code/reg? (:yin.k/version wire)))\n406:        (refuse! :yin.k/profile-mismatch :version [:yin.k/version]))\n407:      (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n408:                     (vector? rs) (every? #(and (vector? %) (<= 2 (count %))) rs))\n409:        (bad! :row-shape [:yin.k/rows]))\n410:      (spend! counter budget :rows (count rs))\n411:      (spend! counter budget :bytes (count (seq (cbor/encode wire))))\n412:      (let [index (into {} (map (fn [r] [(first r) r])) rs)\n413:            root (:yin.k/root wire)]\n414:        (when-not (= (count rs) (count index)) (bad! :duplicate-row [:yin.k/rows]))\n415:        (when-not (contains? #{:task :act :tail :wait} (second (get index root))) (bad! :root [:yin.k/root]))\n416:        ;; Gate children before schema, with an active path (DAG sharing is legal).\n417:        (letfn [(gate\n418:                  [id active]\n419:                  (when (contains? active id) (bad! :cyclic [id]))\n420:                  (let [row (get index id) slots (when row (subvec row 2))]\n421:                    (when-not (and (= :task (second row)) (= 17 (count slots))) (bad! :task-shape [id]))\n422:                    (when-not (= 3 (nth slots 0)) (refuse! :yin.k/profile-mismatch :version [id 0]))\n423:                    (when-not (= profile (nth slots 1)) (refuse! :yin.k/profile-mismatch :profile [id 1]))\n424:                    (doseq [install (nth slots 12)]\n425:                      (let [r (get index install)]\n426:                        (when-not (and (= :install (second r)) (= 7 (count r))) (bad! :install-shape [install]))\n427:                        (gate (nth r 6) (conj active id))))))]\n428:          (when (= :task (second (get index root))) (gate root #{})))\n429:        (doseq [[id kind & slots] rs]\n430:          (let [schema (get row-table kind) ds (descriptors kind slots)]\n431:            (when-not (and schema\n432:                           (cond\n433:                             (= schema :pending) (contains? pending-table (first slots))\n434:                             (= :pairs (first schema)) (even? (count slots))\n435:                             :else true)\n436:                           (= (count ds) (count slots))) (bad! :row-shape [id]))\n437:            (doseq [[i d x] (map vector (range) ds slots)]\n438:              (when-not (structural? d x) (bad! :slot-kind [id i])))))\n439:        (let [seen (atom #{})]\n440:          (letfn [(walk\n441:                    [id active depth]\n442:                    (when (> depth (:depth budget)) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n443:                    (when (contains? active id) (bad! :cyclic [id]))\n444:                    (when-not (contains? @seen id)\n445:                      (let [r (get index id)]\n446:                        (when-not r (bad! :missing-row [id]))\n447:                        (let [kind (second r) slots (subvec r 2)]\n448:                          (doseq [[i d x] (map vector (range) (descriptors kind slots) slots)]\n449:                            (let [targets (cond (ref? d) [x] (refs? d) x\n450:                                                (and (contains? #{:V :optional-V} d) (= :row (first x))) [(second x)]\n451:                                                :else [])]\n452:                              (doseq [target targets]\n453:                                (when (and (contains? #{:V :optional-V} d)\n454:                                           (not (contains? value-row-kinds (second (get index target)))))\n455:                                  (bad! :value-reference-kind [id i]))\n456:                                (when (and (or (ref? d) (refs? d))\n457:                                           (not (contains? (set (rest d)) (second (get index target)))))\n458:                                  (bad! :reference-kind [id i]))\n459:                                (walk target (conj active id) (inc depth))))))\n460:                        (swap! seen conj id))))]\n461:            (walk root #{} 0)\n462:            (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n463:        (doseq [[id & body] rs]\n464:          (when-not (and (= :blake3 (:algorithm (jing/parse-segment-address id)))\n465:                         (= id (jing/segment-key (vec body))))\n466:            (refuse! :yin.k/hash-mismatch :row [id])))\n467:        (doseq [[id kind & slots] rs :when (= :task kind)]\n468:          (doseq [[address v] (nth slots 11)]\n469:            (when-not (= address (jing/segment-key v))\n470:              (refuse! :yin.k/hash-mismatch :code [id 11 address]))\n471:            (when (code/well-formed? v) (bad! :code [id 11 address]))))\n472:        (doseq [[id kind & slots] rs]\n473:          (when-not (= (vec slots) (ordered-slots kind (vec slots))) (bad! :row-order [id]))\n474:          (when (contains? #{:map :bindings :store :parked-table :window :cells :set} kind)\n475:            (let [keys (if (= kind :set) slots (map first (partition 2 slots)))]\n476:              (when-not (and (= (count keys) (count (distinct keys)))\n477:                             (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n478:                (bad! :duplicate-key [id])))))\n479:        (letfn [(expand-slot\n480:                  [d x]\n481:                  (cond (ref? d) (expand x) (refs? d) (mapv expand x)\n482:                        (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (expand (second x))]\n483:                        :else x))\n484:                (expand\n485:                  [id]\n486:                  (let [[_ kind & slots] (get index id)]\n487:                    (node kind (mapv expand-slot (descriptors kind slots) slots))))]\n488:          (let [task (expand root)\n489:                _ (check-abstract! task)\n490:                canonical (if (= :task (:kind task)) (emit task budget)\n491:                              (let [[id _] (emit-node task {} {})] {:yin.k/root id}))]\n492:            (when (and (not= false (:check-numbering budget)) (not= root (:yin.k/root canonical)))\n493:              (bad! :noncanonical-cells [root]))\n494:            (when (= :task (:kind task))\n495:              (when-let [d (validate-frames task)]\n496:                (throw (ex-info \"Frame validation failed\" (update d :yin.k/path #(into [root] %))))))\n497:            task))))))\n498: \n499: \n500: (defn decode\n501:   \"Validate and expand a row pack, including canonical cell numbering.\n502:    For task roots, run X1 and frame validation after numbering.\"\n503:   ([wire] (decode* wire default-budget))\n504:   ([wire budget] (decode* wire (dissoc budget :check-numbering))))\n505: \n506: \n507: (defn canonical-under\n508:   \"Test-only §5.5 re-emission under an explicit stream correspondence.\n509:    Missing marker coverage fails; neither traversal order nor original\n510:    cell numbering chooses a logical identity. Accepts a carrier.\"\n511:   [wire correspondence]\n512:   (let [task (decode* wire (assoc default-budget :check-numbering false))]\n513:     (letfn [(rewrite-slot\n514:               [d x]\n515:               (cond (ref? d) (rewrite x) (refs? d) (mapv rewrite x)\n516:                     (and (contains? #{:V :optional-V} d) (= :row (first x))) [:row (rewrite (second x))]\n517:                     :else x))\n518:             (rewrite\n519:               [n]\n520:               (let [{:keys [kind slots]} n]\n521:                 (if (= :stream kind)\n522:                   (let [id (first slots)]\n523:                     (when-not (contains? correspondence id) (bad! :missing-stream-correspondence [id]))\n524:                     (node :stream [(get correspondence id) (get correspondence id)]))\n525:                   (node kind (mapv rewrite-slot (descriptors kind slots) slots)))))]\n526:       (emit (rewrite task)))))\n527: \n528: \n529: (defn- value-node\n530:   [x]\n531:   ;; Explicit codec values allow 6b to supply already classified guest\n532:   ;; markers, without introducing native seals or resource lookup here.\n533:   (cond\n534:     (and (map? x) (= #{:yin.k/row} (set (keys x)))) [:row (:yin.k/row x)]\n535:     (and (map? x) (= #{:yin.k/cell} (set (keys x)))) [:cell (:yin.k/cell x)]\n536:     :else [:lit x]))\n537: \n538: \n539: (defn- decoded-value\n540:   [v]\n541:   (case (first v)\n542:     :row {:yin.k/row (second v)}\n543:     :cell {:yin.k/cell (second v)}\n544:     :lit (second v)))\n545: \n546: \n547: (defn- keyed-node\n548:   [kind m encode]\n549:   (node kind (mapcat (fn [[k v]] [k (encode v)]) m)))\n550: \n551: \n552: (defn- env-node\n553:   [e encode]\n554:   (node :env [(keyed-node :bindings (:yin.k/bindings e) encode) (:yin.k/store-of e)]))\n555: \n556: \n557: (defn- kframe-node\n558:   [f encode]\n559:   (node :kframe [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n560:                  (keyed-node :window (:yin.k/window f) encode) (:yin.k/rd f)]))\n561: \n562: \n563: (def pending-keys\n564:   {:next [:yin.k/cell]\n565:    :put [:yin.k/stream :yin.k/value :yin.k/op-id]\n566:    :ffi [:yin.k/cell :yin.k/call-id :yin.k/op]\n567:    :ffi-request [:yin.k/call-id :yin.k/envelope :yin.k/request-stream :yin.k/response-stream :yin.k/response-cell :yin.k/op-id]\n568:    :link-request [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cell :yin.k/envelope :yin.k/op-id]\n569:    :link-response [:yin.k/link-id :yin.k/name :yin.k/request-stream :yin.k/response-stream :yin.k/cell]\n570:    :install [:yin.k/name]})\n571: \n572: \n573: (defn frame->rows\n574:   \"Encode a keyed frame to a frame-rooted version-3 row pack. Values are\n575:    plain literals or explicit {:yin.k/row abstract-row}/{:yin.k/cell id}.\n576:    An optional value encoder may classify a composition's portable values.\n577:    This reshapes; frame/defect owns semantic validity.\"\n578:   ([f] (frame->rows f value-node))\n579:   ([f encode]\n580:    (let [k (node :k (mapv #(kframe-node % encode) (:yin.k/k f)))\n581:          state (if (= :act (:yin.k/state f))\n582:                  (node :act [(:yin.k/segment f) (:yin.k/pc f) (env-node (:yin.k/env f) encode)\n583:                              (keyed-node :window (:yin.k/window f) encode) k (get-in f [:yin.k/deliver :yin.k/rd])])\n584:                  (node :tail [(:yin.k/segment f) (:yin.k/site f) k]))\n585:          pending (:yin.k/pending f)\n586:          reason (:yin.k/reason pending)\n587:          root (if (contains? f :yin.k/pending)\n588:                 (node :wait [state (node :pending\n589:                                          (into [reason]\n590:                                                (map (fn [key d]\n591:                                                       (let [x (get pending key)]\n592:                                                         (if (= :V d) (encode x) x)))\n593:                                                     (get pending-keys reason) (get pending-table reason))))])\n594:                 state)\n595:          [id rows] (emit-node root {} {})]\n596:      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n597: \n598: \n599: (defn- decode-keyed\n600:   [n decode-value]\n601:   (into {} (map (fn [[k v]] [k (decode-value v)])) (partition 2 (:slots n))))\n602: \n603: \n604: (defn- decode-env\n605:   [n decode-value]\n606:   (let [[bindings store-of] (:slots n)]\n607:     (cond-> {:yin.k/bindings (decode-keyed bindings decode-value)}\n608:       (some? store-of) (assoc :yin.k/store-of store-of))))\n609: \n610: \n611: (defn- decode-kframe\n612:   [n decode