n390-\n391-(defn with-op-id\n392-  \"`machine` with `id` as the `:op-id` of its first wait entry whose\n393-   reason is `reason`, in the root or, with `path`, in the install child\n394-   at `path`.  D11 replaces this: its fenced writer assigns ids, and its\n395-   tests must show a real run's wait entries equal in shape to what this\n396-   sets.\"\n397-  ([machine reason id] (with-op-id machine [] reason id))\n398-  ([machine path reason id]\n399-   (let [at (into [] (mapcat (fn [m] [:installs m :vm])) path)\n400-         waits (get-in machine (conj at :wait-set))\n401-         i (first (keep-indexed #(when (= reason (:reason %2)) %1) waits))]\n402-     (assert (some? i) (str \"no wait entry of reason \" reason))\n403-     (assoc-in machine (into at [:wait-set i :op-id]) id))))\n404-\n405-\n406-;; =============================================================================\n407-;; The exporter and the lift\n408-;; =============================================================================\n409-\n410-(defn serve-table\n411-  \"A `serve!` answering one stable identity per handle, \\\"s0\\\", \\\"s1\\\"\n412-   ... in the order the handles are first asked about.\"\n413-  []\n414-  (let [table (atom {})]\n415-    (fn [h]\n416-      (or (get @table h)\n417-          (let [served {:dao.stream/identity (str \"s\" (count @table))\n418-                        :dao.stream/channel {:dao.stream/type\n419-                                             :dao.stream.test/channel}}]\n                         :modules stream-modules\n                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))}\n                        opts))))\n\n\n(defn load-ast\n  [machine ast]\n  (sr/load-vector machine (project ast) code/contract))\n\n\n;; =============================================================================\n;; Machines\n;; =============================================================================\n\n(defn parked-reader\n  \"Parked on the second read of the stream it makes, A consumed: one :next\n   wait over one cursor cell.\"\n  []\n  (let [m0 (vm/run (load-ast (new-machine)\n                             (let1 's {:type :stream/make :buffer 4}\n                                   (let1 'c (cursor-of (v 's))\n                                         (then (next-of (v 'c)) (next-of (v 'c)))))))\n        src (get (:resources m0) (:stream-id (first (:wait-set m0))))]\n    (stream/append! src \"A\")\n    (vm/run m0)))\n\n\n(defn parked-writer\n  \"Parked on a blocked write: the warm one-slot stream keeps the value\n   retained. One :put wait.\"\n  []\n  (let [w (one-slot-stream \"w\")]\n    (stream/append! w :warmed)\n    (let [m0 (load-ast (new-machine) {:type :stream/put :target (v 'w) :val (lit \"v\")})\n          [ref m1] (engine/attach-resource m0 w)]\n      (vm/run (assoc m1 :store {'w ref})))))\n\n\n(defn parked-explicit\n  \"At an explicit park, its record's environment holding a cursor.\"\n  []\n  (vm/run (load-ast (new-machine)\n                    (let1 's {:type :stream/make :buffer 4}\n                          (app (lam ['c] {:type :vm/park}) (cursor-of (v 's)))))))\n\n\n(defn parked-linker\n  \"Parked on a link request under the :running gate, so the entry carries\n   no :cursor: the lift refuses it (:link-cursor-not-installed).\"\n  []\n  (vm/run (-> (new-machine {:link-request (ring 8) :link-response (ring 8)})\n              (load-ast (app (v 'require) (lit 'host.mod)))\n              (assoc :yin.k/gate :running))))\n\n\n(defn linked-response\n","exit_code":0,"status":"completed"}}
