{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,45p' test/yin/vm/ucf/lift_v1_test.cljc; sed -n '215,365p' test/yin/vm/ucf/lift_v1_test.cljc; sed -n '1,35p' test/yin/vm/ucf/handoff_v2_holder_test.cljc; tail -55 test/yin/vm/ucf/rows_support.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,45p' test/yin/vm/ucf/lift_v1_test.cljc; sed -n '215,365p' test/yin/vm/ucf/lift_v1_test.cljc; sed -n '1,35p' test/yin/vm/ucf/handoff_v2_holder_test.cljc; tail -55 test/yin/vm/ucf/rows_support.cljc\"","aggregated_output":"(ns yin.vm.ucf.lift-v1-test\n  \"M-next D9: the version-1 lift as a pure encode (r3 1.8; the header\n   ruling).  Every machine is parked by the real engine and lifted\n   through enter / prepare / encode (`yin.vm.ucf.lift-support`); the\n   assertions are on the bytes, on the two grammars that must accept\n   them, and on the refusals the lift answers as data.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing.cbor :as jing.cbor]\n            [dao.stream.cbor :as cbor]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.checkpoint :as checkpoint]\n            [yin.vm.ucf.handoff :as handoff]\n            [yin.vm.ucf.lift-support :as s]\n            [yin.vm.values :as values]))\n\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n\n\n(defn- same-bytes?\n  [a b]\n  (= (vec a) (vec b)))\n\n\n(defn- ok!\n  [r]\n  (is (= :ok (:status r)) (pr-str (dissoc r :record)))\n  r)\n\n\n(defn- accepted-by-both!\n  \"The lift's own bytes pass the inspector and `validate-body` again,\n   run here from outside the lift.\"\n  [r]\n  (let [i (checkpoint/inspect (:address r) (:bytes r))]\n    (is (not (contains? i :yin.k/status)) (pr-str i))\n    (is (jing.cbor/equiv\n          (:body r)\n          (handoff/validate-body (jing.cbor/decode (:bytes r)))))))\n\n\n\n\n;; =============================================================================\n;; Prepare, then encode\n;; =============================================================================\n\n(deftest a-malformed-header-is-a-caller-defect-test\n  (let [{m :machine record :record} (s/enter (s/parked-reader))]\n    (doseq [h [:x {} (dissoc (s/header 0) :yin.k/arbitration)\n               (dissoc (s/header 0) :yin.k/next-op-seq)\n               (dissoc (s/header 0) :yin.k/enrolled)]]\n      (is (throws? #(s/prepare m record (s/serve-table) h))\n          (pr-str h)))))\n\n\n(deftest two-encodes-of-one-prepared-record-give-equal-bytes-test\n  (doseq [[n machine h] [[\"reader\" (s/parked-reader) (s/header 0 nil #{})]\n                         [\"installer\" (s/parked-installer) (s/header 6)]\n                         [\"explicit\" (s/parked-explicit) (s/header 1)]\n                         [\"version 0\" (s/parked-reader) nil]]]\n    (let [{m :machine p :prepared} (s/prepared machine h)\n          record (:record p)\n          a (s/encode m record)\n          b (s/encode m record)]\n      (ok! p)\n      (is (same-bytes? (:bytes a) (:bytes b)) n)\n      (is (= (:address a) (:address b)) n))))\n\n\n(deftest the-served-table-is-plain-data-keyed-by-path-and-resource-test\n  (let [{p :prepared} (s/prepared (s/parked-installer) (s/header 6))\n        served (:served (:record p))]\n    (is (seq served))\n    (is (every? (fn [[[path id] descriptor]]\n                  (and (vector? path) (some? id)\n                       (string? (:dao.stream/identity descriptor))))\n                served))\n    (is (some (fn [[[path _] _]] (= ['host.mod] path)) served)\n        \"the child's streams are keyed by its path\"))\n  (testing \"one handle under two resource ids: served once, keyed twice\"\n    (let [calls (atom 0)\n          serve! (fn [_]\n                   (swap! calls inc) {:dao.stream/identity \"s0\"\n                                      :dao.stream/channel\n                                      {:dao.stream/type\n                                       :dao.stream.test/channel}})\n          {m :machine record :record} (s/enter (s/parked-writer-shared))\n          p (s/prepare m record serve! (s/header 3 s/origin #{}))\n          e (s/encode m (:record p))]\n      (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n      (is (= 1 @calls) \"the one handle asked once\")\n      (is (= 2 (count (:served (:record p)))) \"both resource keys retained\")\n      (is (= :ok (:status e)) (pr-str e))\n      (is (throws? #(s/encode\n                      m (update (:record p) :served\n                                dissoc (ffirst (:served (:record p))))))\n          \"a key the record lacks is still a defect\"))))\n\n\n(deftest a-retry-serves-no-already-served-handle-test\n  (let [served {:dao.stream/identity \"s0\"\n                :dao.stream/channel {:dao.stream/type\n                                     :dao.stream.test/channel}}\n        seen (atom #{})\n        ;; answers the first distinct handle it is asked about, and that\n        ;; one whenever it is asked again; every other handle gets no\n        ;; answer, so the prepare refuses once the walk reaches the\n        ;; independent third stream, after the shared handle's aliases\n        first-only (fn [h]\n                     (when (or (contains? @seen h) (empty? @seen))\n                       (swap! seen conj h)\n                       served))\n        {m :machine record :record} (s/enter\n                                      (s/parked-writer-shared-late))\n        refused (s/prepare m record first-only (s/header 3 s/origin #{}))]\n    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n    (is (= 1 (count @seen)) \"exactly one handle ever answered\")\n    (is (every? #(= served %) (vals (:served (:record refused))))\n        \"what was served is retained\")\n    (testing \"the retry resolves the shared handle's every alias from the\n              retained table and the machine's bindings: the handle is\n              not served again\"\n      (let [calls (atom 0)\n            table (atom {})\n            counting (fn [h]\n                       (swap! calls inc)\n                       (if-some [d (get @table h)]\n                         d\n                         (let [d {:dao.stream/identity\n                                  (str \"s\" (count @table))}]\n                           (swap! table assoc h d)\n                           d)))\n            p (s/prepare m (:record refused) counting\n                              (s/header 3 s/origin #{}))\n            e (s/encode m (:record p))]\n        (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n        (is (= 1 @calls) \"only the never-served third stream is asked\")\n        (is (= 3 (count (:served (:record p)))) \"every resource key\")\n        (is (= 2 (count (distinct (vals (:served (:record p))))))\n            \"one identity for the shared handle's two keys\")\n        (is (= :ok (:status e)) (pr-str e))\n        (is (= 1 (count @seen)) \"the first attempt served once\")))\n    (testing \"a retry over a machine whose bindings moved -- a fresh\n              resource alias of the served handle reached first\"\n      (let [[path id :as retained] (first (keys (:served (:record refused))))\n            h (get-in m (into path [:resources id]))\n            _ (is (some? retained) \"one key is retained\")\n            _ (is (some? h) \"the retained key resolves to its handle\")\n            [alias m2] (engine/attach-resource m h)\n            ;; prepare reads the record's waits, so the fresh alias rides\n            ;; the record's first wait entry's environment\n            record' (assoc-in (:record refused) [:wait-set 0 :env 'aa]\n                              alias)\n            calls (atom 0)\n            counting (fn [_] (swap! calls inc) served)\n            p (s/prepare m2 record' counting (s/header 3 s/origin #{}))]\n        (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n        (is (= 1 @calls) \"only the never-served third stream is asked\")\n        (is (= 4 (count (:served (:record p))))\n            \"the fresh alias, the retained alias, the pending's and the\n             third stream's\")\n        (is (= :ok (:status (s/encode m2 (:record p))))\n            \"the record encodes with no serving\")))))\n\n\n(deftest the-record-round-trips-the-canonical-codec-test\n  (let [{m :machine p :prepared} (s/prepared (s/parked-explicit) (s/header 1))\n        record (:record p)\n        back (jing.cbor/decode (jing.cbor/encode record))]\n    (ok! p)\n    (is (same-bytes? (jing.cbor/encode record) (jing.cbor/encode back)))\n    (is (same-bytes? (:bytes (s/encode m record))\n                     (:bytes (s/encode m back)))\n        \"the stored record encodes to the same bytes\")))\n\n\n;; =============================================================================\n;; Determinism and what the program holds\n;; =============================================================================\n\n(def ^:private odd-values\n  {:f (jing.cbor/float64 1.5)\n   :zero (jing.cbor/float64 0.0)\n   :neg-zero (jing.cbor/float64 (* -1.0 0.0))\n   :nan (jing.cbor/float64 ##NaN)\n   :nested {:b {:d [1 2 {:e 3}] :a #{3 1 2}} :a 1 :c {:z 1 :y 2}}})\n\n\n(defn- literal-entries\n  \"The `[k v]` pairs of a wrapped literal map.\"\n  [lit]\n(ns yin.vm.ucf.handoff-v2-holder-test\n  \"UCF version 2, section 11 rows 9, 10, 11 and 12 over the holder's\n   exporting state: the D4-D9 holds in root and child refuse the lift and\n   leave the machine as it was; canonical bytes do not depend on map\n   insertion order; and a receiver poisoned with guest state behaves\n   exactly as a clean one. (The version-2 recovery snapshot row was\n   deleted at phase 7b: recovery is version 2 over the row carrier,\n   holder/export_test.)\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.jing.cbor :as cbor]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.debruijn.register :as register]\n            [yin.vm.debruijn.stack :as stack]\n            [yin.vm.ucf.handoff :as handoff]\n            [yin.vm.ucf.lift-support :as ls]\n            [yin.vm.ucf.v2-support :as s]))\n\n\n(defn- served-table\n  \"A `serve!` answering one stable identity per handle.\"\n  []\n  (let [table (atom {})]\n    {:table table\n     :serve! (fn [h]\n               (or (get @table h)\n                   (let [served {:dao.stream/identity\n                                 (str \"s\" (count @table))\n                                 :dao.stream/channel\n                                 {:dao.stream/type :test/channel}}]\n                     (swap! table assoc h served)\n                     served)))}))\n\n\n  (let [{:keys [c1 c2 machine]} (fresh-cursors (halted-machine))]\n    (assoc machine :value (f c1 c2))))\n\n\n(defn parked-module-store-cursors\n  \"At an explicit park whose host.mod module store holds two cursor\n   references, named by a module closure in the task store.\"\n  []\n  (let [ast (app (lam ['p] {:type :vm/park}) (lit 1))\n        vec* (project ast)\n        m (vm/run (load-ast (new-machine) ast))\n        {:keys [c1 c2 machine]} (fresh-cursors m)\n        closure (first (filter #(= :closure (first %)) vec*))\n        clo (values/closure (:owner machine)\n                            {:type :closure :params (nth closure 2) :entry (nth closure 3)\n                             :segment (get (:code-aliases machine) (jing/segment-key vec*))\n                             :env {engine/store-of-key 'host.mod}})]\n    (assoc machine :store {'mod clo} :module-stores {'host.mod {'c c1 'd c2}})))\n\n\n;; =============================================================================\n;; The lift, the lower's attacher\n;; =============================================================================\n\n(defn lift-opts\n  ([] (lift-opts nil))\n  ([header]\n   (cond-> {:source-index @source-index}\n     (some? header) (assoc :header header))))\n\n\n(defn lift\n  \"rows/lift-task of machine under header (nil: the fork) with a fresh\n   deterministic exporter: the pack, or the refusal's ex-data.\"\n  [machine header]\n  (try (rows/lift-task machine (serve-table) (lift-opts header))\n       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n         (or (ex-data e) (throw e)))))\n\n\n(defn attacher\n  \"A receiver's attach!: a fresh one-slot stream per descriptor, counting\n   attaches in the atom it answers beside.\"\n  []\n  (let [n (atom 0)]\n    {:count n\n     :attach! (fn [d]\n                (swap! n inc)\n                {:dao.stream/outcome :dao.stream/ok\n                 :dao.stream/handle (one-slot-stream (str \"attached-\" (:dao.stream/identity d)))})}))\n\n\n(defn receiver\n  ([] (receiver {}))\n  ([opts] (new-machine opts)))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,185p' test/yin/vm/ucf/holder/export_test.cljc; rg -n 's/prepared|ls/prepared|lift-support/prepared' test; rg -n 'parked-writer-shared' test/yin/vm/ucf/rows_support.cljc; sed -n '2250,2290p' src/cljc/yin/vm/ucf/rows.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,185p' test/yin/vm/ucf/holder/export_test.cljc; rg -n 's/prepared|ls/prepared|lift-support/prepared' test; rg -n 'parked-writer-shared' test/yin/vm/ucf/rows_support.cljc; sed -n '2250,2290p' src/cljc/yin/vm/ucf/rows.cljc\"","aggregated_output":"(ns yin.vm.ucf.holder.export-test\n  \"D8 over the row carrier (UCF 7.7.4; r3 1.8 and 1.9; phase 7b): the\n   exporting state, the prepare/encode split over rows/lift-task, the\n   export-recovery object version 2, its fenced rehydration and the abort\n   rule. Every machine is a semantic-register machine the real engine\n   parked (yin.vm.ucf.rows-support); counting handles show what the gate,\n   the encode and the rehydration touch.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.stream :as stream]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-support :as rs]))\n\n\n;; =============================================================================\n;; Machines, the exporter, the receiver's attach\n;; =============================================================================\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:cljd Object :clj Throwable :cljs :default) _ true)))\n\n\n(defn- ring\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn- index\n  \"The composition's source index, as the composition reads it.\"\n  []\n  @rs/source-index)\n\n\n(defn- two-streams\n  \"Parks on a read of the first stream; the store also holds the second\n   stream and a cursor on each, so the lift reaches two streams.\"\n  []\n  (rs/let1 'a {:type :stream/make :buffer 4}\n           (rs/let1 'b {:type :stream/make :buffer 4}\n                    (rs/then (rs/def! 'held-a (rs/cursor-of (rs/v 'a)))\n                             (rs/then (rs/def! 'held-b (rs/cursor-of (rs/v 'b)))\n                                      (rs/next-of (rs/v 'held-a)))))))\n\n\n(defn- parked-machine\n  []\n  (vm/run (rs/load-ast (rs/new-machine) (two-streams))))\n\n\n(defn- served-table\n  \"A `serve!` that counts its calls and answers one stable identity per\n   handle.\"\n  []\n  (let [calls (atom 0)\n        table (atom {})]\n    {:calls calls\n     :table table\n     :serve! (fn [h]\n               (swap! calls inc)\n               (or (get @table h)\n                   (let [served {:dao.stream/identity (str \"s\" (count @table))\n                                 :dao.stream/channel {:dao.stream/type :test/channel}}]\n                     (swap! table assoc h served)\n                     served)))}))\n\n\n(defn- counting-handle\n  [calls]\n  (reify\n    stream/IDaoStreamReader\n\n    (cursor\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor ::at})\n\n    (next\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/blocked})\n\n\n    stream/IDaoStreamWriter\n\n    (append!\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok})\n\n\n    stream/IDaoStreamClosable\n\n    (close!\n      [_]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok})))\n\n\n(defn- counting-attach\n  \"A receiver's attach!: a fresh counting handle per descriptor; every\n   attach and every handle operation counted.\"\n  []\n  (let [attaches (atom 0) calls (atom 0)]\n    {:attaches attaches\n     :calls calls\n     :attach (fn [_]\n               (swap! attaches inc)\n               {:dao.stream/outcome :dao.stream/ok\n                :dao.stream/handle (counting-handle calls)})}))\n\n\n(defn- frozen-of\n  \"Enter, prepare under header with the composition's index, freeze:\n   {:machine :record :prepared :frozen :table}.\"\n  ([source] (frozen-of source nil))\n  ([source header]\n   (let [{:keys [machine record]} (export/enter source)\n         {:keys [serve! table]} (served-table)\n         prepared (export/prepare machine record serve! header (index))]\n     {:machine machine :record record :prepared prepared :table table\n      :frozen (when (= :ok (:status prepared)) (export/freeze machine (:record prepared)))})))\n\n\n(defn- rehydrate\n  ([frozen] (rehydrate frozen (rs/new-machine) (:attach (counting-attach))))\n  ([frozen receiver attach]\n   (export/rehydrate-fenced receiver (:bytes frozen) {:address (:address frozen) :attach attach})))\n\n\n(defn- reproduces?\n  [frozen restored]\n  (= (vec (:pack-bytes frozen))\n     (vec (:bytes (export/encode (:machine restored) (:record restored))))))\n\n\n;; =============================================================================\n;; Gated machines over counting handles (machine-level, kernel-agnostic)\n;; =============================================================================\n\n(def ^:private park-entry-fns\n  {:stream/put (fn [_s _e r] {:reason :put, :stream-id (:stream-id r)}),\n   :stream/next (fn [_s _e r]\n                  {:reason :next,\n                   :cursor-ref (:cursor-ref r),\n                   :stream-id (:stream-id r)})})\n\n\n(def ^:private opts {:park-entry-fns park-entry-fns})\n\n\n(defn- gated\n  \"[state stream-ref cursor-ref calls] under the :running gate.\"\n  []\n  (let [calls (atom 0)\n        [sref s0] (engine/attach-resource\n                    (vm/empty-state {:make-stream tu/make-stream,\n                                     :capability-secret tu/secret})\n                    (counting-handle calls))\n        [cref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)]\n    (reset! calls 0)\n    [(assoc s1 :yin.k/gate :running) sref cref calls]))\n\n\n(defn- run-effect\n  [state kind m]\n  (:state (engine/handle-effect state (module/make-effect kind m) opts)))\n\n\n;; =============================================================================\n;; Entering exporting\n;; =============================================================================\n\n(deftest enter-moves-waits-and-fences-the-machine-test\ntest/yin/vm/ucf/lift_v1_test.cljc:235:    (let [{m :machine p :prepared} (s/prepared machine h)\ntest/yin/vm/ucf/lift_v1_test.cljc:245:  (let [{p :prepared} (s/prepared (s/parked-installer) (s/header 6))\ntest/yin/vm/ucf/lift_v1_test.cljc:341:  (let [{m :machine p :prepared} (s/prepared (s/parked-explicit) (s/header 1))\n   :yin.k/recovery-parked (none in the scheduler), its id counter the\n   carried one exactly and :yin.k/recovery-cell-ids mapping each cursor\n   cell's resource key to its carried cell id.\"\n  ([recv wire attach!] (lower-task recv wire attach! {}))\n  ([recv wire attach! opts]\n   (let [task (decode wire (merge default-budget (:budget opts)))]\n     (when-not (= :task (:kind task)) (outcome! :yin.k/undecodable :root {}))\n     ;; each step over the whole tree before the next (§3.3)\n     (doseq [step [check-stores! check-pendings! check-dependencies!]\n             [t role] (task-tree task :root)]\n       (step recv t role))\n     (let [custody (check-custody! task wire opts)]\n       (restore-task recv task (attach-streams! attach! task) custody true)))))\n","exit_code":0,"status":"completed"}}
