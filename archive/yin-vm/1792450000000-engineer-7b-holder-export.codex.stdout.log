  (when-some [h (hold-of m)]\n+                   (assoc h :yin.k/path path :yin.k/status :yin.k/non-portable\n+                          :yin.k/kind :reason-mismatch)))\n+               (task-machines [] machine))\n+         (let [r (handoff/reachable-parked machine)]\n+           (or (:refusal r)\n+               (let [ids (:ids r)\n+                     parked (:parked machine)]\n+                 {:status :ok\n+                  :machine (-> machine\n+                               (assoc :yin.k/gate :exporting :wait-set [])\n+                               (assoc :parked (apply dissoc parked ids)))\n+                  :record (cond-> {:wait-set (vec (:wait-set machine))\n+                                   :parked (select-keys parked ids)\n+                                   :gate (vm/gate-mode machine)\n+                                   :served {}}\n+                            (some? (:version opts)) (assoc :version (:version opts)))})))))))\n+\n+\n+(defn- reinstated\n+  [machine record]\n+  (-> machine\n+      (assoc :wait-set (:wait-set record))\n+      (update :parked merge (:parked record))))\n+\n+\n+(defn prepare\n+  \"holder.export/prepare before 7b: serve once per stream through the\n+   version-0/1/2 lift (its recovery census), retaining every answer\n+   under [path resource-id].\"\n+  [machine record serve! header]\n+  (when (some? header)\n+    (when-not (and (map? header) (contains? header :yin.k/arbitration)\n+                   (contains? header :yin.k/next-op-seq) (set? (:yin.k/enrolled header)))\n+      (throw (ex-info \"Prepare of a malformed header\" {:yin.k/hint :malformed-header}))))\n+  (let [table (atom (:served record))\n+        at (into {} (task-machines [] machine))\n+        by-handle (atom (into {} (keep (fn [[[path id] d]]\n+                                         (when-some [h (get-in (get at path) [:resources id])] [h d])))\n+                              (:served record)))\n+        once (fn [k h]\n+               (let [t @table]\n+                 (cond\n+                   (contains? t k) (let [served (get t k)] (swap! by-handle assoc h served) served)\n+                   (contains? @by-handle h) (let [served (get @by-handle h)] (swap! table assoc k served) served)\n+                   :else (let [served (serve! h)]\n+                           (when (some? served)\n+                             (swap! table assoc k served)\n+                             (swap! by-handle assoc h served))\n+                           served))))\n+        record (assoc record :header header)\n+        r (handoff/export-task (reinstated machine record) nil\n+                               (cond-> {:header header :serve-keyed once\n+                                        :yin.vm.ucf.handoff/recovery true}\n+                                 (:version record) (assoc :version (:version record))))]\n+    (if (= :ok (:status r))\n+      {:status :ok :record (assoc record :served @table)}\n+      (assoc r :record (assoc record :served @table)))))\n+\n+\n+(defn encode\n+  \"holder.export/encode before 7b: handoff/export-task from the record's\n+   retained answers, under its header.\"\n+  [machine record]\n+  (let [served (:served record)]\n+    (handoff/export-task\n+      (reinstated machine record) nil\n+      (cond-> {:header (:header record)\n+               :serve-keyed (fn [k _h]\n+                              (if (contains? served k)\n+                                (get served k)\n+                                (throw (ex-info \"Encode of an unprepared record\"\n+                                                {:yin.k/hint :unprepared-stream}))))}\n+        (:version record) (assoc :version (:version record))))))\n+\n+\n (defn prepared\n   \"Enter exporting from `machine` and prepare it under `header` with a\n    fresh deterministic exporter: `{:machine m :record r :prepared p}`.\n    A refusal of `enter` is `:prepared`.\"\n   [machine header]\n-  (let [e (export/enter machine)]\n+  (let [e (enter machine)]\n     (if (= :ok (:status e))\n       {:machine (:machine e)\n        :record (:record e)\n-       :prepared (export/prepare (:machine e) (:record e) (serve-table)\n-                                 header)}\n+       :prepared (prepare (:machine e) (:record e) (serve-table) header)}\n       {:prepared e})))\n \n \n@@ -468,5 +592,5 @@\n   [machine header]\n   (let [{m :machine p :prepared} (prepared machine header)]\n     (if (= :ok (:status p))\n-      (export/encode m (:record p))\n+      (encode m (:record p))\n       p)))\ndiff --git a/test/yin/vm/ucf/lift_v1_test.cljc b/test/yin/vm/ucf/lift_v1_test.cljc\nindex 448cce7a..b8d83555 100644\n--- a/test/yin/vm/ucf/lift_v1_test.cljc\n+++ b/test/yin/vm/ucf/lift_v1_test.cljc\n@@ -11,7 +11,6 @@\n             [yin.vm.engine :as engine]\n             [yin.vm.ucf.checkpoint :as checkpoint]\n             [yin.vm.ucf.handoff :as handoff]\n-            [yin.vm.ucf.holder.export :as export]\n             [yin.vm.ucf.lift-support :as s]\n             [yin.vm.values :as values]))\n \n@@ -220,11 +219,11 @@\n ;; =============================================================================\n \n (deftest a-malformed-header-is-a-caller-defect-test\n-  (let [{m :machine record :record} (export/enter (s/parked-reader))]\n+  (let [{m :machine record :record} (s/enter (s/parked-reader))]\n     (doseq [h [:x {} (dissoc (s/header 0) :yin.k/arbitration)\n                (dissoc (s/header 0) :yin.k/next-op-seq)\n                (dissoc (s/header 0) :yin.k/enrolled)]]\n-      (is (throws? #(export/prepare m record (s/serve-table) h))\n+      (is (throws? #(s/prepare m record (s/serve-table) h))\n           (pr-str h)))))\n \n \n@@ -235,8 +234,8 @@\n                          [\"version 0\" (s/parked-reader) nil]]]\n     (let [{m :machine p :prepared} (s/prepared machine h)\n           record (:record p)\n-          a (export/encode m record)\n-          b (export/encode m record)]\n+          a (s/encode m record)\n+          b (s/encode m record)]\n       (ok! p)\n       (is (same-bytes? (:bytes a) (:bytes b)) n)\n       (is (= (:address a) (:address b)) n))))\n@@ -259,14 +258,14 @@\n                                       :dao.stream/channel\n                                       {:dao.stream/type\n                                        :dao.stream.test/channel}})\n-          {m :machine record :record} (export/enter (s/parked-writer-shared))\n-          p (export/prepare m record serve! (s/header 3 s/origin #{}))\n-          e (export/encode m (:record p))]\n+          {m :machine record :record} (s/enter (s/parked-writer-shared))\n+          p (s/prepare m record serve! (s/header 3 s/origin #{}))\n+          e (s/encode m (:record p))]\n       (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n       (is (= 1 @calls) \"the one handle asked once\")\n       (is (= 2 (count (:served (:record p)))) \"both resource keys retained\")\n       (is (= :ok (:status e)) (pr-str e))\n-      (is (throws? #(export/encode\n+      (is (throws? #(s/encode\n                       m (update (:record p) :served\n                                 dissoc (ffirst (:served (:record p))))))\n           \"a key the record lacks is still a defect\"))))\n@@ -285,9 +284,9 @@\n                      (when (or (contains? @seen h) (empty? @seen))\n                        (swap! seen conj h)\n                        served))\n-        {m :machine record :record} (export/enter\n+        {m :machine record :record} (s/enter\n                                       (s/parked-writer-shared-late))\n-        refused (export/prepare m record first-only (s/header 3 s/origin #{}))]\n+        refused (s/prepare m record first-only (s/header 3 s/origin #{}))]\n     (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n     (is (= 1 (count @seen)) \"exactly one handle ever answered\")\n     (is (every? #(= served %) (vals (:served (:record refused))))\n@@ -305,9 +304,9 @@\n                                   (str \"s\" (count @table))}]\n                            (swap! table assoc h d)\n                            d)))\n-            p (export/prepare m (:record refused) counting\n+            p (s/prepare m (:record refused) counting\n                               (s/header 3 s/origin #{}))\n-            e (export/encode m (:record p))]\n+            e (s/encode m (:record p))]\n         (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n         (is (= 1 @calls) \"only the never-served third stream is asked\")\n         (is (= 3 (count (:served (:record p)))) \"every resource key\")\n@@ -328,13 +327,13 @@\n                               alias)\n             calls (atom 0)\n             counting (fn [_] (swap! calls inc) served)\n-            p (export/prepare m2 record' counting (s/header 3 s/origin #{}))]\n+            p (s/prepare m2 record' counting (s/header 3 s/origin #{}))]\n         (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n         (is (= 1 @calls) \"only the never-served third stream is asked\")\n         (is (= 4 (count (:served (:record p))))\n             \"the fresh alias, the retained alias, the pending's and the\n              third stream's\")\n-        (is (= :ok (:status (export/encode m2 (:record p))))\n+        (is (= :ok (:status (s/encode m2 (:record p))))\n             \"the record encodes with no serving\")))))\n \n \n@@ -344,8 +343,8 @@\n         back (jing.cbor/decode (jing.cbor/encode record))]\n     (ok! p)\n     (is (same-bytes? (jing.cbor/encode record) (jing.cbor/encode back)))\n-    (is (same-bytes? (:bytes (export/encode m record))\n-                     (:bytes (export/encode m back)))\n+    (is (same-bytes? (:bytes (s/encode m record))\n+                     (:bytes (s/encode m back)))\n         \"the stored record encodes to the same bytes\")))\n \n \ndiff --git a/test/yin/vm/ucf/rows_custody_test.cljc b/test/yin/vm/ucf/rows_custody_test.cljc\nindex 47c4fa9c..30256097 100644\n--- a/test/yin/vm/ucf/rows_custody_test.cljc\n+++ b/test/yin/vm/ucf/rows_custody_test.cljc\n@@ -264,6 +264,46 @@\n     (is (= [:put] (mapv :reason (:yin.k/recovery-waits m))))))\n \n \n+(deftest the-install-response-is-verified-before-any-attachment\n+  ;; continuation §11 Q3 (owner, 2026-10-13: lands in 7b): the response's\n+  ;; link id is the row's parent, and its image is the one the manifest\n+  ;; names, through the manifest's :yin.semantic/code derivation record\n+  (let [m (s/parked-installer)\n+        response (get-in m [:installs 'host.mod :response])\n+        other (s/linked-response (s/def! 'f (s/lam [] (s/lit 7))) 'host.mod #{'f})\n+        lift-with (fn [f] (s/lift (update-in m [:installs 'host.mod] f) nil))\n+        kind (fn [inst-f]\n+               (let [r (refused (lift-with inst-f) {})]\n+                 [(:yin.k/status r) (:yin.k/kind r) (:yin.k/name r)]))]\n+    (testing \"an honest response lowers\"\n+      (let [[r n] (lowered (s/lift m nil) {})]\n+        (is (pos? n))\n+        (is (vm/blocked? r))))\n+    (testing \"a response of another link\"\n+      (is (= [:yin.k/undecodable :install-link-id 'host.mod]\n+             (kind #(assoc-in % [:response :yin.link/id] [:other 9])))))\n+    (testing \"no parent\"\n+      (is (= [:yin.k/undecodable :install-link-id 'host.mod]\n+             (kind #(assoc % :parent nil)))))\n+    (testing \"no derivation record\"\n+      (is (= [:yin.k/undecodable :install-image 'host.mod]\n+             (kind #(update % :response dissoc :derivation)))))\n+    (testing \"a derivation record the manifest does not name\"\n+      (is (= [:yin.k/undecodable :install-image 'host.mod]\n+             (kind #(assoc-in % [:response :derivation] (:derivation other))))))\n+    (testing \"a manifest and record of another image than the one delivered\"\n+      (is (= [:yin.k/undecodable :install-image 'host.mod]\n+             (kind #(update % :response merge (select-keys other [:manifest :derivation]))))))\n+    (testing \"a record from another tree than the manifest's\"\n+      (is (= [:yin.k/undecodable :install-image 'host.mod]\n+             (kind #(assoc-in % [:response :manifest :yin.module/tree]\n+                              (get-in other [:manifest :yin.module/tree]))))))\n+    (testing \"the image the record names, delivered under another vector\"\n+      (is (= [:yin.k/undecodable :install-image 'host.mod]\n+             (kind #(assoc-in % [:response :image] (:image other))))))\n+    (is (= response (get-in m [:installs 'host.mod :response])))))\n+\n+\n (deftest install-children-lower-under-their-roots-custody\n   (let [wire (f/base \"installs\")\n         [m n] (lowered wire (exclusive-opts wire #{\"s0\"}))\ndiff --git a/test/yin/vm/ucf/rows_support.cljc b/test/yin/vm/ucf/rows_support.cljc\nindex deb99ee1..be974155 100644\n--- a/test/yin/vm/ucf/rows_support.cljc\n+++ b/test/yin/vm/ucf/rows_support.cljc\n@@ -17,6 +17,7 @@\n             [dao.stream.ringbuffer :as ringbuffer]\n             [yin.vm :as vm]\n             [yin.vm.engine :as engine]\n+            [yin.vm.ledger :as ledger]\n             [yin.vm.module :as module]\n             [yin.vm.semantic-register :as sr]\n             [yin.vm.semantic-register.code :as code]\n@@ -141,13 +142,29 @@\n               (assoc :yin.k/gate :running))))\n \n \n+(defn linked-response\n+  \"A link response as the linker answers one (yin.vm.linker/link-manifest):\n+   the image of ast, the manifest naming its tree and its :yin.semantic/code\n+   derivation record, and that record, from the tree to the image's A. The\n+   lower checks that chain (rows/check-install!, continuation §11 Q3).\"\n+  [ast module-name exports]\n+  (let [image (project ast)\n+        tree (jing/segment-key [:yin/tree ast])\n+        record (ledger/derive-record tree (jing/segment-key image))]\n+    {:status :ok\n+     :image {:value image}\n+     :manifest {:yin.module/name module-name :yin.module/exports exports\n+                :yin.module/tree tree\n+                :yin.module/derivations {:yin.semantic/code (jing/segment-key record)}}\n+     :derivation record\n+     :obligations []}))\n+\n+\n (defn module-response\n   []\n-  {:status :ok\n-   :image {:value (project (let1 's {:type :stream/make :buffer 4}\n-                                 (then (next-of (cursor-of (v 's))) (def! 'f (lam [] (lit 42))))))}\n-   :manifest {:yin.module/name 'host.mod :yin.module/exports #{'f}}\n-   :obligations []})\n+  (linked-response (let1 's {:type :stream/make :buffer 4}\n+                         (then (next-of (cursor-of (v 's))) (def! 'f (lam [] (lit 42)))))\n+                   'host.mod #{'f}))\n \n \n (defn parked-installer\n","exit_code":0,"status":"completed"}}
