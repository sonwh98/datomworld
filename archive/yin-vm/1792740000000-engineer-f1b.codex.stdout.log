{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2020,2060p' src/cljc/yin/vm/ucf/rows.cljc\nsed -n '1545,1585p' src/cljc/yin/vm/ucf/holder/driver.cljc\nsed -n '2070,2125p' src/cljc/yin/vm/ucf/holder/driver.cljc\nsed -n '430,485p' src/cljc/yin/vm/ucf/holder/export.cljc\nsed -n '590,635p' src/cljc/yin/vm/ucf/holder/export.cljc\nrg -n 'assoc-module|receiver.mod' test/yin/vm/ucf/rows* src/cljc/yin/vm/module.cljc\nrg --files test/yin/vm/ucf | sort\"","aggregated_output":"      {:exclusive? true :fenced? fenced?\n       :state (when-not (or fenced? (= :halted kind)) (accept-grant! task c (pack-address wire) opts))})))\n\n\n(defn- with-custody\n  \"Restore's custody for one task of the tree: an exclusive tree numbers\n   its retained :put waits (:yin.k/issue, :yin.k/issued, in carried\n   order) and gates :running, a halted exclusive root :ended, the root\n   holding the grant's custody state; a fenced tree gates :exporting with\n   its waits and every parked record outside the scheduler\n   (:yin.k/recovery-waits, :yin.k/recovery-parked), the shape\n   holder.export's exporting machine has.\"\n  [m {:keys [exclusive? fenced? state]} kind root?]\n  (let [m (if exclusive?\n            (let [[entries issued] (reduce (fn [[acc i] e]\n                                             (if (= :put (:reason e))\n                                               [(conj acc (assoc e :yin.k/issue i)) (inc i)]\n                                               [(conj acc e) i]))\n                                           [[] 0] (:wait-set m))]\n              (cond-> (assoc m :wait-set entries :yin.k/issued issued\n                             :yin.k/gate (if (and root? (= :halted kind)) :ended :running))\n                (and root? (some? state)) (assoc :yin.k/custody state)))\n            m)]\n    (if fenced?\n      (assoc m :yin.k/gate :exporting :yin.k/recovery-waits (:wait-set m) :wait-set []\n             :yin.k/recovery-parked (:parked m) :parked {})\n      m)))\n\n\n(defn- attach-streams!\n  \"Step 11: one attach per distinct stream identity of the whole tree.\"\n  [attach! task]\n  (reduce (fn [acc s]\n            (let [[identity descriptor] (:slots s)]\n              (if (contains? acc identity)\n                acc\n                (if-some [h (remote/lower-marker attach! {:dao.stream/descriptor descriptor})]\n                  (assoc acc identity h)\n                  (outcome! :yin.k/unsatisfied nil {:dao.stream/identity identity})))))\n          {} (rows-of task :stream false)))\n\n                 :proposals (if mint?\n                              (inc (or (:proposals state) 0))\n                              (or (:proposals state) 0)))\n          (with-status :yin.k/awaiting-grant\n            {:yin.k/occurrence (:occurrence state)\n             :dao.lease/proposal (:id proposal')})))))\n\n\n(defn- lowered\n  \"`rows/lower-task` of the state's checkpoint bytes into the receiver\n   under `opts`: `{:status :ok :kind k :vm m}`, or the lower's refusal as\n   data (undecodable bytes are `:yin.k/undecodable`).  Every refusal is\n   decided before the first attachment.\"\n  [state opts]\n  (let [attach! (get-in state [:seams :attach!])\n        wire (try (cbor/decode (:bytes state))\n                  (catch #?(:cljd Object :clj Throwable :cljs :default) _ ::undecodable))]\n    (if (or (= ::undecodable wire) (not (map? wire)))\n      {:yin.k/status :yin.k/undecodable}\n      (try\n        (let [m (rows/lower-task (assoc (:receiver state) :attach-stream attach!) wire attach! opts)]\n          {:status :ok :vm m})\n        (catch #?(:cljd Object :clj Throwable :cljs :default) e\n          (let [d (ex-data e)]\n            (if (and (map? d) (contains? d :yin.k/status)) d (throw e))))))))\n\n\n(defn- lower\n  \"D10's lower with the accepted grant's inputs, over the receiver:\n  the checkpoint address, the composition's protection declaration, and\n  the grant -- lease, holder, the evidence `E` and the current tenure\n  as numbers, `now` the clock's reading and `bound` the grant's\n  duration over the observation basis.\"\n  [state l holder E reading]\n  (let [units (:units state)\n        grant (:grant holder)\n        basis (:granted-at holder)\n        duration (:dao.lease/duration grant)\n        base (fn [d]\n               (let [entry (first d)]\n                 (* (val entry) (get units (key entry)))))]\n    (descriptor [_] (stream/descriptor handle))\n\n\n    stream/IDaoStreamWriter\n\n    (append!\n      [_ value]\n      (require-tenure! state)\n      (stream/append! handle value))\n\n\n    stream/IDaoStreamClosable\n\n    (close!\n      [_]\n      (require-tenure! state)\n      (stream/close! handle))))\n\n\n(defn- guard-writes\n  [state machine]\n  (reduce (fn [root [path task]]\n            (assoc-in root (conj path :resources)\n                      (into {} (map (fn [[resource handle]]\n                                      [resource\n                                       (if (satisfies? stream/IDaoStreamDescriptor handle)\n                                         (guarded-handle state handle) handle)]))\n                            (:resources task))))\n          machine (machines machine)))\n\n\n(defn- restore-handles\n  [machine original]\n  (reduce (fn [root [path task]]\n            (reduce (fn [root [resource handle]]\n                      (if (satisfies? stream/IDaoStreamDescriptor handle)\n                        (assoc-in root (into path [:resources resource]) handle)\n                        root)) root (:resources task)))\n          machine (machines original)))\n\n\n(defn- run-cycle\n  \"One program cycle of the run, after tenure: the machine's internal\n   computation, replay below the frontier, the writer's emit, the\n   reader's live step.  The unsatisfied answers of the writer and the\n   reader ride the state as :step-unsatisfied; a run end anywhere\n   rides it as :run-end.\"\n  [state]\n  (let [_ (require-tenure! state)\n        m0 (:machine state)\n        m1 (if (and (= :running (vm/gate-mode m0)) (not (:halted? m0)))\n             (vm/run m0)\n             m0)\n        _ (require-tenure! state)\n        replay (reader/replay m1 {:control-outstanding?\n                                  (control-outstanding? state)})\n(defn- carried-trees\n  \"{A #{tree}} every task of the decoded tree carries: the composition's\n   index as the prepare that published the pack saw it, restricted to the\n   carried segments, which is all a relift of the same tree reads.\"\n  [task]\n  (let [ss (:slots task)]\n    (reduce (fn [acc inst] (merge acc (carried-trees (nth (:slots inst) 4))))\n            (or (:yin.k/trees (nth ss 10)) {})\n            (nth ss 12))))\n\n\n(defn- extract-recovered\n  \"The fenced machine and its export record from the lower's fenced\n   restore of one task: the waits and parked records the lower kept out\n   of the scheduler move into the record, the waits restamped with the\n   recovered issues; the holder-local counters come from `state`.\"\n  [machine state]\n  (let [children (into {}\n                       (map (fn [[module-name install]]\n                              [module-name\n                               (extract-recovered (:vm install)\n                                                  (get-in state [:children module-name]))]))\n                       (:installs machine))\n        waits (mapv (fn [entry issue]\n                      (if (some? issue)\n                        (assoc entry :yin.k/issue issue)\n                        (dissoc entry :yin.k/issue)))\n                    (:yin.k/recovery-waits machine)\n                    (:issues state))\n        record {:wait-set waits\n                :parked (or (:yin.k/recovery-parked machine) {})\n                :recovered? true\n                :gate (:gate state)\n                :served {}\n                :children (into {} (map (fn [[module-name recovered]]\n                                          [module-name (:record recovered)]))\n                                children)}\n        fenced (reduce-kv (fn [parent module-name recovered]\n                            (assoc-in parent [:installs module-name :vm]\n                                      (:machine recovered)))\n                          (cond-> (-> machine\n                                      (dissoc :yin.k/recovery-waits :yin.k/recovery-parked\n                                              :yin.k/custody :yin.k/closes :yin.k/issued :origins)\n                                      (assoc :wait-set [] :parked {} :yin.k/gate :exporting))\n                            (some? (:origins state)) (assoc :origins (:origins state))\n                            (some? (:issued state)) (assoc :yin.k/issued (:issued state)))\n                          children)]\n    {:machine fenced :record record}))\n\n\n(defn rehydrate-fenced\n  \"Restore a version-2 export-recovery object into fresh receiver-owned\n   values (UCF 7.7.4).  Before any attachment: the object's tag and\n   version (`:yin.k/profile-mismatch`), its bytes against `address`\n   (`:yin.k/hash-mismatch`), the pack through the rows inspector (its\n   address against its bytes, the carrier, the custody grammar), the pack\n   true}`: `n` before `b` in one unit, and `:live` the ledger reader's\n   evidence that this lease is the occurrence's active lease at its\n   epoch.  A clock reading alone is not tenure.  After the lease has\n   ended its old local machine is never restored.\n\n   Answers `{:status :ok :machine m}` or `:yin.k/refused` data with\n   reason `:restarted`, `:not-exporting`, `:tenure-ended` (at or past\n   the bound), `:tenure-unconfirmed` (no ledger evidence) or\n   `:offer-possibly-accepted`.\"\n  [machine record attempts tenure]\n  (cond\n    (:recovered? record)\n    (refused :restarted)\n\n    (not= :exporting (vm/gate-mode machine))\n    (refused :not-exporting)\n\n    (and (contains? machine :yin.k/custody)\n         (some? (:now tenure))\n         (some? (:bound tenure))\n         (>= (:now tenure) (:bound tenure)))\n    (refused :tenure-ended)\n\n    (and (contains? machine :yin.k/custody)\n         (not (and (some? (:now tenure))\n                   (some? (:bound tenure))\n                   (true? (:live tenure)))))\n    (refused :tenure-unconfirmed)\n\n    (not (every? (comp not-appended? :append) attempts))\n    (refused :offer-possibly-accepted)\n\n    :else\n    (let [m (reinstated machine record)\n          prior (:gate record)]\n      {:status :ok\n       :machine (if (some? prior)\n                  (assoc m :yin.k/gate prior)\n                  (dissoc m :yin.k/gate))})))\ntest/yin/vm/ucf/rows_test.cljc:1121:                             :module-stores (assoc {} 'receiver.mod (assoc {} 'x :wrong))\ntest/yin/vm/ucf/rows_test.cljc:1123:                             :installs (assoc {} 'receiver.mod {:phase :running})\ntest/yin/vm/ucf/rows_test.cljc:1152:        (is (not (contains? (:module-stores restored) 'receiver.mod)))\ntest/yin/vm/ucf/rows_test.cljc:1154:        (is (not (contains? (:installs restored) 'receiver.mod)))\nsrc/cljc/yin/vm/module.cljc:69:(defn assoc-module\nsrc/cljc/yin/vm/module.cljc:89:  (assoc-module registry\ntest/yin/vm/ucf/authority/admission_test.cljc\ntest/yin/vm/ucf/authority/completion_fold_test.cljc\ntest/yin/vm/ucf/authority/completion_test.cljc\ntest/yin/vm/ucf/authority/front_test.cljc\ntest/yin/vm/ucf/authority/grant_test.cljc\ntest/yin/vm/ucf/authority/inherited_test.cljc\ntest/yin/vm/ucf/authority/input_test.cljc\ntest/yin/vm/ucf/authority/reclaim_test.cljc\ntest/yin/vm/ucf/authority_test.cljc\ntest/yin/vm/ucf/compose_rows_test.cljc\ntest/yin/vm/ucf/compose_test.cljc\ntest/yin/vm/ucf/crash_cut_test.cljc\ntest/yin/vm/ucf/custody_test.cljc\ntest/yin/vm/ucf/durability_test.cljc\ntest/yin/vm/ucf/fencing_rows_test.cljc\ntest/yin/vm/ucf/holder/driver_test.cljc\ntest/yin/vm/ucf/holder/evidence_test.cljc\ntest/yin/vm/ucf/holder/export_test.cljc\ntest/y