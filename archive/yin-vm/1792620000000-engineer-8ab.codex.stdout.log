lose! b))\n      (let [b (::file/backend (file/backend! dir))]\n        (try\n          (let [p (open-projection b)]\n            (is (= (:digest @pinned) (lf/digest p)) \"after close and reopen\")\n            (is (= (map lf/hex (:frames @pinned))\n","exit_code":0,"status":"completed"}}
