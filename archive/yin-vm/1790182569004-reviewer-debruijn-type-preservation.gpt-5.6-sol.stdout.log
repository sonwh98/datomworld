  157\t    (/ 0.0 0.0) :double\n   158\t    (/ 1.0 0.0) :double\n   159\t    (/ -1.0 0.0) :double\n   160\t    -0.0 :double\n   161\t    #?@(:cljs [0.0 :int64] :default [0.0 :double])\n   162\t    9.3e18 :double\n   163\t    [1 2.5] :vector\n   164\t    (list 1 2.5) :list\n   165\t    {:a 1} :map\n   166\t    #{1} :set\n   167\t    [nil \"x\" :k] :vector\n   168\t    {:a [1.0 #{2}]} :map\n   169\t    [(fn [x] x)] nil\n   170\t    {\"k\" (fn [x] x)} nil)\n   171\t  (is (d/canonical-value? [1 {:a #{2}}]))\n   172\t  (is (not (d/canonical-value? {:a (fn [x] x)}))))\n   173\t\n   174\t\n   175\t(deftest jvm-out-of-domain-values-diagnose\n   176\t  ;; §5's out-of-domain numerics, asserted where the host can express them\n   177\t  #?(:clj (are [x] (nil? (d/canonical-class x))\n   178\t            5N\n   179\t            (bigint 9223372036854775808)\n   180\t            1/2\n   181\t            (java.math.BigDecimal. \"1.1\")\n   182\t            \\a\n   183\t            [1 \\c])))\n   184\t\n   185\t\n   186\t(deftest a-javascript-number-is-int64-only-when-safe\n   187\t  ;; an unsafe integer's exact classification is not recoverable (§5)\n   188\t  #?(:cljs (do\n   189\t             (is (= :int64 (d/canonical-class 9007199254740991)))\n   190\t             (is (nil? (d/canonical-class 9007199254740992)))\n   191\t             (is (nil? (d/canonical-class -9007199254740992)))\n   192\t             (is (= :unsupported-value\n   193\t                    (:rule (throws-data #(d/encode-value 9007199254740992)))))\n   194\t             (is (= \"0200000010ffffffffffff1f00\" (d/encode-value 9007199254740991))))))\n   195\t\n   196\t\n   197\t(deftest the-nfc-seam-composes-on-every-host\n   198\t  (let [decomposed \"e\\u0301\", composed \"\\u00e9\"]\n    32\t                   [:p \"In Unison, the mapping of names to hashes is \\\"just metadata for humans, used to resolve names to hashes at parse time when slurping up code into the codebase, and used for the other direction when displaying code for the user\\\" (\" [:a {:href \"https://unison-lang.org/whats-new/writeup-of-our-first-unison-meetup\"} \"Unison meetup writeup\"] \"). The stored definition is identified by its hash, and its name is a separate mapping.\"]\n    33\t\n    34\t                   [:p \"In yin.vm, the names a developer wrote are part of the Named Universal AST itself, stored as datoms beside the structure they name. Every nameless form is derived from that named source, never the other way around.\"]\n    35\t\n    36\t                   [:h2 \"3. One Truth, Many Interpretations\"]\n    37\t                   [:p [:code \"yin.vm\"] \" is built on an architectural axiom: \" [:em \"Interpretation Creates Semantics (one truth, many perspectives).\"] \" Rather than one monolithic representation, it keeps one source of truth and derives other forms from it, each with its own identity or none:\"]\n    38\t                   [:ul\n    39\t                    [:li [:strong \"The Named Universal AST (implemented): \"] \"the canonical stored, queryable, and renderable form, with the exact names the developer wrote. It has no single hash. The AST walker evaluates it directly, and the semantic VM executes a separately linearized \" [:code \":yin.code/*\"] \" image lowered from it.\"]\n","exit_code":0,"status":"completed"}}
