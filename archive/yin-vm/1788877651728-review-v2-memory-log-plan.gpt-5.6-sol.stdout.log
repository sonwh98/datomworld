{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"ringbuffer-manifest|defn- handle|defn handle|def .*manifest|run-conformance-suite|make-abstract-stream-model\\\" test/dao/stream/ringbuffer_test.cljc test/dao/stream/conformance.cljc\nnl -ba test/dao/stream/ringbuffer_test.cljc | sed -n '1,165p'\nnl -ba test/dao/stream/conformance.cljc | sed -n '245,305p;375,535p'\"","aggregated_output":"test/dao/stream/conformance.cljc:249:(defn run-conformance-suite\ntest/dao/stream/conformance.cljc:253:   (run-conformance-suite manifest (when-let [hf (:handle-factory manifest)] (hf))))\ntest/dao/stream/conformance.cljc:382:(defn make-abstract-stream-model\ntest/dao/stream/conformance.cljc:388:   (make-abstract-stream-model stream-identity nil []))\ntest/dao/stream/conformance.cljc:390:   (make-abstract-stream-model stream-identity capacity []))\ntest/dao/stream/conformance.cljc:392:   (make-abstract-stream-model stream-identity capacity initial-elements {}))\ntest/dao/stream/ringbuffer_test.cljc:13:(defn handle\ntest/dao/stream/ringbuffer_test.cljc:86:(def ringbuffer-manifest\ntest/dao/stream/ringbuffer_test.cljc:150:  (let [result (conformance/run-conformance-suite ringbuffer-manifest)]\ntest/dao/stream/ringbuffer_test.cljc:218:        model (conformance/make-abstract-stream-model\ntest/dao/stream/ringbuffer_test.cljc:242:   (conformance/make-abstract-stream-model\n     1\t(ns dao.stream.ringbuffer-test\n     2\t  (:require [clojure.test :refer [deftest is testing]]\n     3\t            [dao.stream :as stream]\n     4\t            [dao.stream.conformance :as conformance]\n     5\t            [dao.stream.ringbuffer :as ring]))\n     6\t\n     7\t\n     8\t(def spec\n     9\t  {:dao.stream/type ring/transport-type\n    10\t   :dao.stream.ringbuffer/capacity 2})\n    11\t\n    12\t\n    13\t(defn handle\n    14\t  []\n    15\t  (:dao.stream/handle (ring/create! spec)))\n    16\t\n    17\t\n    18\t(defn cur\n    19\t  [h a]\n    20\t  (:dao.stream/cursor (stream/cursor h a)))\n    21\t\n    22\t\n    23\t(deftest retention-and-gaps\n    24\t  (let [h (handle) c (cur h :dao.stream/oldest)]\n    25\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! h :a))))\n    26\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! h :b))))\n    27\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! h :c))))\n    28\t    (is (= :dao.stream/gap (:dao.stream/outcome (stream/next h c))))\n    29\t    (let [r (stream/next h (:dao.stream/cursor (stream/next h c)))]\n    30\t      (is (= :dao.stream/ok (:dao.stream/outcome r)))\n    31\t      (is (= :b (:dao.stream/value r))))))\n    32\t\n    33\t\n    34\t(deftest anchors-and-identity\n    35\t  (let [h (handle) other (handle)\n    36\t        newest (cur h :dao.stream/newest)]\n    37\t    (is (= :dao.stream/blocked (:dao.stream/outcome (stream/next h newest))))\n    38\t    (is (= :dao.stream/invalid-anchor\n    39\t           (:dao.stream/outcome (stream/cursor h :bad))))\n    40\t    (is (= :dao.stream/cursor-mismatch\n    41\t           (:dao.stream/outcome\n    42\t             (stream/next other newest))))))\n    43\t\n    44\t\n    45\t(deftest close-freezes-attachment\n    46\t  (let [owner (handle)\n    47\t        d (:dao.stream/descriptor (stream/descriptor owner))\n    48\t        attached (:dao.stream/handle\n    49\t                   ((ring/make-attacher {(:dao.stream/identity d) owner}) d))\n    50\t        c (cur attached :dao.stream/newest)]\n    51\t    (stream/append! owner :before)\n    52\t    (stream/close! attached)\n    53\t    (is (= :dao.stream/closed (:dao.stream/outcome (stream/append! attached :x))))\n    54\t    (stream/append! owner :after)\n    55\t    (let [before (stream/next attached c)]\n    56\t      (is (= :dao.stream/ok (:dao.stream/outcome before)))\n    57\t      (is (= :before (:dao.stream/value before)))\n    58\t      (is (= :dao.stream/end\n    59\t             (:dao.stream/outcome\n    60\t               (stream/next attached (:dao.stream/cursor before))))))\n    61\t    (is (= :dao.stream/ok (:dao.stream/outcome (stream/append! owner :ok))))))\n    62\t\n    63\t\n    64\t(deftest attachment-resolution\n    65\t  (let [h (handle) d (:dao.stream/descriptor (stream/descriptor h))\n    66\t        resolver {(:dao.stream/identity d) h}]\n    67\t    (is (= :dao.stream/ok (:dao.stream/outcome (ring/attach! resolver d))))\n    68\t    (is (= :dao.stream/not-found\n    69\t           (:dao.stream/outcome (ring/attach! {} d))))\n    70\t    (is (= :dao.stream/invalid-descriptor\n    71\t           (:dao.stream/outcome (ring/attach! resolver {:dao.stream/type :other}))))))\n    72\t\n    73\t\n    74\t(defn- attachment\n    75\t  ([] (attachment spec))\n    76\t  ([creation-spec]\n    77\t   (let [owner (:dao.stream/handle (ring/create! creation-spec))\n    78\t         descriptor (:dao.stream/descriptor (stream/descriptor owner))]\n    79\t     {:owner owner\n    80\t      :descriptor descriptor\n    81\t      :attached (:dao.stream/handle\n    82\t                  (ring/attach! {(:dao.stream/identity descriptor) owner}\n    83\t                                descriptor))})))\n    84\t\n    85\t\n    86\t(def ringbuffer-manifest\n    87\t  \"The reference transport's complete outcome declaration.  Every fixture\n    88\t   operates a fresh real handle; it never fabricates an outcome map.\"\n    89\t  {:dao.stream/type ring/transport-type\n    90\t   :surfaces #{:reader :writer :closable}\n    91\t   :handle-factory handle\n    92\t   :operations\n    93\t   {:create! {:produces #{:dao.stream/ok :dao.stream/invalid-spec}\n    94\t              :exclusions {:dao.stream/not-found \"host dispatch selects transport\"\n    95\t                           :dao.stream/transport-error \"in-memory allocation has no operational failure channel\"}}\n    96\t    :attach! {:produces #{:dao.stream/ok :dao.stream/invalid-descriptor :dao.stream/not-found}\n    97\t              :exclusions {:dao.stream/transport-error \"captured in-memory resolver has no failure channel\"}}\n    98\t    :descriptor {:produces #{:dao.stream/ok} :exclusions {}}\n    99\t    :cursor {:produces #{:dao.stream/ok :dao.stream/invalid-anchor :dao.stream/closed}\n   100\t             :exclusions {:dao.stream/transport-error \"one in-memory state deref cannot fail operationally\"}}\n   101\t    :next {:produces #{:dao.stream/ok :dao.stream/blocked :dao.stream/end\n   102\t                       :dao.stream/gap :dao.stream/cursor-mismatch :dao.stream/invalid-cursor}\n   103\t           :exclusions {:dao.stream/transport-error \"coherent in-memory state has no failure channel\"}}\n   104\t    :append! {:produces #{:dao.stream/ok :dao.stream/closed}\n   105\t              :exclusions {:dao.stream/full \"evict-oldest retention never refuses append\"\n   106\t                           :dao.stream/invalid-value \"reference transport accepts all host values\"\n   107\t                           :dao.stream/transport-error \"coherent in-memory state has no failure channel\"}}\n   108\t    :close! {:produces #{:dao.stream/ok} :exclusions {}}}\n   109\t   :fixtures\n   110\t   {:create! {:dao.stream/ok #(ring/create! spec)\n   111\t              :dao.stream/invalid-spec #(ring/create! {:dao.stream/type ring/transport-type})}\n   112\t    :attach! {:dao.stream/ok #(let [{:keys [owner descriptor]} (attachment)]\n   113\t                                (ring/attach! {(:dao.stream/identity descriptor) owner} descriptor))\n   114\t              :dao.stream/invalid-descriptor #(ring/attach! {} {:dao.stream/type :other})\n   115\t              :dao.stream/not-found #(let [h (handle)\n   116\t                                           d (:dao.stream/descriptor (stream/descriptor h))]\n   117\t                                       (ring/attach! {} d))}\n   118\t    :descriptor {:dao.stream/ok #(stream/descriptor (handle))}\n   119\t    :cursor {:dao.stream/ok #(stream/cursor (handle) :dao.stream/oldest)\n   120\t             :dao.stream/invalid-anchor #(stream/cursor (handle) ::invalid-anchor)\n   121\t             :dao.stream/closed #(let [{:keys [attached]} (attachment)]\n   122\t                                   (stream/close! attached)\n   123\t                                   (stream/cursor attached :dao.stream/oldest))}\n   124\t    :next {:dao.stream/ok #(let [h (handle)\n   125\t                                 c (cur h :dao.stream/oldest)]\n   126\t                             (stream/append! h :value)\n   127\t                             (stream/next h c))\n   128\t           :dao.stream/blocked #(let [h (handle)]\n   129\t                                  (stream/next h (cur h :dao.stream/newest)))\n   130\t           :dao.stream/end #(let [h (handle)\n   131\t                                  c (cur h :dao.stream/newest)]\n   132\t                              (stream/close! h)\n   133\t                              (stream/next h c))\n   134\t           :dao.stream/gap #(let [h (:dao.stream/handle (ring/create! (assoc spec ring/capacity-key 1)))\n   135\t                                  c (cur h :dao.stream/oldest)]\n   136\t                              (stream/append! h :old)\n   137\t                              (stream/append! h :new)\n   138\t                              (stream/next h c))\n   139\t           :dao.stream/cursor-mismatch #(let [left (handle) right (handle)]\n   140\t                                          (stream/next right (cur left :dao.stream/oldest)))\n   141\t           :dao.stream/invalid-cursor #(stream/next (handle) nil)}\n   142\t    :append! {:dao.stream/ok #(stream/append! (handle) :value)\n   143\t              :dao.stream/closed #(let [h (handle)]\n   144\t                                    (stream/close! h)\n   145\t                                    (stream/append! h :value))}\n   146\t    :close! {:dao.stream/ok #(stream/close! (handle))}}})\n   147\t\n   148\t\n   149\t(deftest ringbuffer-conformance-test\n   150\t  (let [result (conformance/run-conformance-suite ringbuffer-manifest)]\n   151\t    (is (:passed? result) (str \"Conformance failures: \" (:failures result)))))\n   152\t\n   153\t\n   154\t(deftest attachment-lifecycle-regressions\n   155\t  (testing \"attachment close is idempotent and freezes its original tail\"\n   156\t    (let [{:keys [owner attached]} (attachment (assoc spec ring/capacity-key 4))\n   157\t          cursor (cur attached :dao.stream/newest)]\n   158\t      (stream/append! owner :before)\n   159\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/close! attached))))\n   160\t      (stream/append! owner :after-first-close)\n   161\t      (is (= :dao.stream/ok (:dao.stream/outcome (stream/close! attached))))\n   162\t      (stream/append! owner :after-second-close)\n   163\t      (let [seen (stream/next attached cursor)]\n   164\t        (is (= :before (:dao.stream/value seen)))\n   165\t        (is (= :dao.stream/end\n   245\t          (swap! violations conj {:check :close-idempotence-failed :result res2}))))\n   246\t    @violations))\n   247\t\n   248\t\n   249\t(defn run-conformance-suite\n   250\t  \"Executes the full declaration-driven conformance suite against manifest and optional handle.\n   251\t   Returns {:passed? true} or {:passed? false :failures [...]}.\"\n   252\t  ([manifest]\n   253\t   (run-conformance-suite manifest (when-let [hf (:handle-factory manifest)] (hf))))\n   254\t  ([manifest handle]\n   255\t   (let [failures (atom [])\n   256\t         manifest-res (validate-manifest manifest)\n   257\t         ;; Each destructive law block gets a fresh transport instance.  The\n   258\t         ;; manifest factory is the transport's responsibility; the supplied\n   259\t         ;; handle remains a compatibility fallback for older callers.\n   260\t         fresh-handle (fn []\n   261\t                        (if-let [factory (:handle-factory manifest)]\n   262\t                          (factory)\n   263\t                          handle))]\n   264\t     (if-not (:valid? manifest-res)\n   265\t       {:passed? false :failures (:errors manifest-res)}\n   266\t       (do\n   267\t         ;; 1. Induction & exhaustiveness check\n   268\t         (let [ind-v (run-induction-coverage manifest)]\n   269\t           (when (seq ind-v)\n   270\t             (swap! failures concat ind-v)))\n   271\t\n   272\t         ;; 2. Descriptor identity laws (always checked)\n   273\t         (when (fresh-handle)\n   274\t           (let [desc-v (run-descriptor-laws (fresh-handle))]\n   275\t             (when (seq desc-v)\n   276\t               (swap! failures concat desc-v)))\n   277\t\n   278\t           ;; 3. Reader laws (only if reader declared)\n   279\t           (when (contains? (:surfaces manifest) :reader)\n   280\t             (let [r-v (run-reader-laws (fresh-handle))]\n   281\t               (when (seq r-v)\n   282\t                 (swap! failures concat r-v))))\n   283\t\n   284\t           ;; 4. Writer laws (only if writer declared)\n   285\t           (when (contains? (:surfaces manifest) :writer)\n   286\t             (let [w-v (run-writer-laws (fresh-handle) ::conformance-token)]\n   287\t               (when (seq w-v)\n   288\t                 (swap! failures concat w-v))))\n   289\t\n   290\t           ;; 5. Close laws (only if closable declared)\n   291\t           (when (contains? (:surfaces manifest) :closable)\n   292\t             (let [c-v (run-close-laws (fresh-handle))]\n   293\t               (when (seq c-v)\n   294\t                 (swap! failures concat c-v)))))\n   295\t\n   296\t         (if (empty? @failures)\n   297\t           {:passed? true}\n   298\t           {:passed? false :failures @failures}))))))\n   299\t\n   300\t\n   301\t;; =============================================================================\n   302\t;; Concurrency Oracle (Bounded Offline Linearizability Checker)\n   303\t;; =============================================================================\n   304\t\n   305\t(defn record-op!\n   375\t           :reason :no-legal-linearization}))))\n   376\t\n   377\t\n   378\t;; =============================================================================\n   379\t;; Pure Abstract Model for Stream & Ring Buffer Linearizability\n   380\t;; =============================================================================\n   381\t\n   382\t(defn make-abstract-stream-model\n   383\t  \"Creates the pure abstract sequential model for a stream/ringbuffer:\n   384\t   - stream-identity: logical-stream identity\n   385\t   - capacity: nil (unbounded) or integer (evict-oldest bound)\n   386\t   - initial-elements: optional initial sequence of values\"\n   387\t  ([stream-identity]\n   388\t   (make-abstract-stream-model stream-identity nil []))\n   389\t  ([stream-identity capacity]\n   390\t   (make-abstract-stream-model stream-identity capacity []))\n   391\t  ([stream-identity capacity initial-elements]\n   392\t   (make-abstract-stream-model stream-identity capacity initial-elements {}))\n   393\t  ([stream-identity capacity initial-elements options]\n   394\t   {:stream-identity stream-identity\n   395\t    :capacity capacity\n   396\t    :elements (vec (map-indexed (fn [i v] {:pos i :val v}) initial-elements))\n   397\t    :next-pos (count initial-elements)\n   398\t    :closed? false\n   399\t    ;; Attachment entries are supplied by the test composition.  A close on an\n   400\t    ;; attachment freezes its own visible tail, not the logical stream.\n   401\t    :attachments (or (:attachments options) {})\n   402\t    ;; Cursor layout is transport-owned.  The model receives projection\n   403\t    ;; functions rather than depending on a particular map key convention.\n   404\t    :cursor-projector\n   405\t    (or (:cursor-projector options)\n   406\t        {:identity (fn [cursor] (:stream-identity cursor))\n   407\t         :position (fn [cursor] (:position cursor))})}))\n   408\t\n   409\t\n   410\t(defn- invocation\n   411\t  \"Normalizes legacy positional arguments and the extensible oracle argument\n   412\t   shape.  New histories may use\n   413\t   {:dao.stream/args [...] :dao.stream/handle {:attachment <id>}}; a missing\n   414\t   handle means the logical-stream owner.\"\n   415\t  [args]\n   416\t  (if (and (map? args) (contains? args :dao.stream/args))\n   417\t    args\n   418\t    {:dao.stream/args args :dao.stream/handle {:owner? true}}))\n   419\t\n   420\t\n   421\t(defn- attachment-id\n   422\t  [inv]\n   423\t  (get-in inv [:dao.stream/handle :attachment]))\n   424\t\n   425\t\n   426\t(defn- attachment-state\n   427\t  [state inv]\n   428\t  (when-let [id (attachment-id inv)]\n   429\t    (get-in state [:attachments id])))\n   430\t\n   431\t\n   432\t(defn- visible-tail\n   433\t  [state inv]\n   434\t  (or (:tail (attachment-state state inv)) (:next-pos state)))\n   435\t\n   436\t\n   437\t(defn- cursor-identity\n   438\t  [state cursor]\n   439\t  (when (map? cursor)\n   440\t    ((get-in state [:cursor-projector :identity]) cursor)))\n   441\t\n   442\t\n   443\t(defn- cursor-position\n   444\t  [state cursor]\n   445\t  (when (map? cursor)\n   446\t    ((get-in state [:cursor-projector :position]) cursor)))\n   447\t\n   448\t\n   449\t(defn- result-cursor-position\n   450\t  [state result]\n   451\t  (cursor-position state (:dao.stream/cursor result)))\n   452\t\n   453\t\n   454\t(defn- retained-first\n   455\t  [state]\n   456\t  (or (:pos (first (:elements state))) (:next-pos state)))\n   457\t\n   458\t\n   459\t(defn abstract-stream-step\n   460\t  \"Pure abstract transition function for stream operations:\n   461\t   state: abstract model state\n   462\t   op: :append!, :close!, :cursor, or :next\n   463\t   args: arguments passed to operation\n   464\t   result: observed outcome map from operation\n   465\t   Returns next state if the operation and outcome are legally accepted by\n   466\t   the abstract sequential model; returns nil if transition is invalid.\"\n   467\t  [state op args result]\n   468\t  (let [outcome (:dao.stream/outcome result)\n   469\t        inv (invocation args)\n   470\t        positional (:dao.stream/args inv)\n   471\t        attachment (attachment-state state inv)\n   472\t        handle-closed? (and attachment (not (:open? attachment)))]\n   473\t    (case op\n   474\t      :append!\n   475\t      (let [[_val] positional]\n   476\t        (if (or (:closed? state) handle-closed?)\n   477\t          (when (= outcome :dao.stream/closed) state)\n   478\t          (when (= outcome :dao.stream/ok)\n   479\t            (let [pos (:next-pos state)\n   480\t                  new-elem {:pos pos :val (first positional)}\n   481\t                  new-elements (conj (:elements state) new-elem)\n   482\t                  trimmed-elements (if (and (:capacity state)\n   483\t                                            (> (count new-elements) (:capacity state)))\n   484\t                                     (subvec new-elements (- (count new-elements) (:capacity state)))\n   485\t                                     new-elements)]\n   486\t              (assoc state\n   487\t                     :elements trimmed-elements\n   488\t                     :next-pos (inc pos))))))\n   489\t\n   490\t      :close!\n   491\t      (when (= outcome :dao.stream/ok)\n   492\t        (if-let [id (attachment-id inv)]\n   493\t          (if (get-in state [:attachments id])\n   494\t            (if (get-in state [:attachments id :open?])\n   495\t              (assoc-in state [:attachments id]\n   496\t                        {:open? false :tail (:next-pos state)})\n   497\t              state)\n   498\t            nil)\n   499\t          (assoc state :closed? true)))\n   500\t\n   501\t      :cursor\n   502\t      (let [[anchor] positional]\n   503\t        (if handle-closed?\n   504\t          (when (= outcome :dao.stream/closed) state)\n   505\t          (case anchor\n   506\t            :dao.stream/oldest\n   507\t            (when (and (= outcome :dao.stream/ok)\n   508\t                       (map? (:dao.stream/cursor result)))\n   509\t              (let [expected-pos (min (retained-first state) (visible-tail state inv))]\n   510\t                (when (= (result-cursor-position state result) expected-pos) state)))\n   511\t\n   512\t            :dao.stream/newest\n   513\t            (when (and (= outcome :dao.stream/ok)\n   514\t                       (map? (:dao.stream/cursor result)))\n   515\t              (when (= (result-cursor-position state result) (visible-tail state inv)) state))\n   516\t\n   517\t            ;; Invalid anchor\n   518\t            (when (= outcome :dao.stream/invalid-anchor)\n   519\t              state))))\n   520\t\n   521\t      :next\n   522\t      (let [[cur] positional]\n   523\t        (cond\n   524\t          (not (map? cur))\n   525\t          (when (= outcome :dao.stream/invalid-cursor) state)\n   526\t\n   527\t          (nil? (cursor-identity state cur))\n   528\t          (when (= outcome :dao.stream/invalid-cursor) state)\n   529\t\n   530\t          (not= (:stream-identity state) (cursor-identity state cur))\n   531\t          (when (= outcome :dao.stream/cursor-mismatch) state)\n   532\t\n   533\t          (not (integer? (cursor-position state cur)))\n   534\t          (when (= outcome :dao.stream/invalid-cursor) state)\n   535\t\n","exit_code":0,"status":"completed"}}
