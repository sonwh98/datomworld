               (or (ex-data e) (throw e))))]\n    [r @count]))\n\n\n(defn- exclusive-opts\n  [wire enrolled]\n  {:grant (grant-for wire enrolled) :protection (protection-for wire enrolled)})\n\n\n(defn- refused\n  \"The refusal of wire lowered under opts, asserting zero attachments.\"\n;; =============================================================================\n;; The lift, the lower's attacher\n;; =============================================================================\n\n(defn lift-opts\n  ([] (lift-opts nil))\n  ([header]\n   (cond-> {:source-index @source-index}\n     (some? header) (assoc :header header))))\n\n\n(defn lift\n  \"rows/lift-task of machine under header (nil: the fork) with a fresh\n   deterministic exporter: the pack, or the refusal's ex-data.\"\n  [machine header]\n  (try (rows/lift-task machine (serve-table) (lift-opts header))\n       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n         (or (ex-data e) (throw e)))))\n\n\n(defn attacher\n  \"A receiver's attach!: a fresh one-slot stream per descriptor, counting\n   attaches in the atom it answers beside.\"\n  []\n  (let [n (atom 0)]\n    {:count n\n     :attach! (fn [d]\n                (swap! n inc)\n                {:dao.stream/outcome :dao.stream/ok\n                 :dao.stream/handle (one-slot-stream (str \"attached-\" (:dao.stream/identity d)))})}))\n\n    clojure.lang.RestFn.applyTo (RestFn.java:140)\n    clojure.lang.Var.applyTo (Var.java:707)\n    clojure.main.main (main.java:40)\n\nRan 56 tests containing 3325 assertions.\n0 failures, 1 errors.\n10:ERROR in (sampled-returned-boundaries) (PersistentVector.java:162)\n13:  actual: java.lang.IndexOutOfBoundsException: null\n(ns yin.vm.semantic.vm-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values 