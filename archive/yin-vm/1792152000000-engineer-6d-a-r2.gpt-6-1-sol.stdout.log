{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '400,420p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '173,193p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '1,110p' test/yin/vm/ucf/ledger_fixtures.cljc; sed -n '1,80p' test/yin/vm/ucf/rows_support.cljc; head -25 test/yin/vm/semantic/layout_test.cljc\"","aggregated_output":"    {:machine m :kind :blocked :reason :install :trace trace\n     :steps [#(stream/append! child-stream :fed)]\n     :finish #(swap! trace into (tu/drain request))\n     :receiver (link-receiver trace)}))\n\n\n(defn module-context\n  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n  [wrap]\n  (let [request (s/ring 64) response (s/ring 64)\n        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-stream (with-cat (wrap (s/then (s/app (s/v 'require) (s/lit 'host.mod))\n                                                                      (s/app (s/v 'host.mod/f) (s/v 'c))))))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response body #{'f}) :yin.link/id id))\n        m (vm/run m0)\n        src (s/stream-of m)]\n    ;; The carrier holds module stores, not registry entries: the receiver's\n    ;; composition links host.mod itself, so its relift discharges host.mod/f.\n    {:machine m :kind :blocked :reason :next :steps [#(stream/append! src \"B\")] :trace (atom [])\n(defn load-program\n  [m ast]\n  (if (= :semantic (lane-of m))\n    (sr/load-vector m (project ast) code/contract)\n    (kernel-load m (project ast))))\n\n\n(defn lane-closure\n  \"Canonical closure payload c, its :segment an A, as machine m's value.\"\n  [m c]\n  (if (= :semantic (lane-of m))\n    (values/closure (:owner m) (update c :segment #(get (:code-aliases m) %)))\n    (layout/positional-value (layout/lower-context m (kernel-space m)) (values/closure (:owner m) c))))\n\n\n(defn lift-opts\n  []\n  {:source-index @source-index})\n\n\n(defn error\n(ns yin.vm.ucf.ledger-fixtures\n  \"The cross-host ledger fixture of M-next C slice C12: one arbitration\n   ledger holding every fact kind of yin.vm.ucf.ledger, built by a\n   portable script (`build`) and pinned as its journal frames.\n\n   The pins live in test/resources/yin/vm/ucf/ledger-v2.txt: a first\n   line `ledger-v2`, a second `projection <digest>`, the BLAKE3 hex of\n   the canonical bytes of the projection the frames fold to, then one\n   journal frame per line as lowercase hex, header first.  Regenerate\n   the file from a one-off JVM script with the string `render` returns,\n   saved to `path`; the test proves on every host that the file equals\n   `render`, so every host's rebuild has the pinned bytes.\n\n   Version 2 (phase 7a): the offered and reported checkpoints are\n   version-3 row packs (yin.vm.ucf.rows-checkpoint-fixtures), each stored\n   and recorded under its pack address, its root id inside the baseline.\n\n   Nothing here writes a file.\"\n  (:require [clojure.string :as str]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as cfx]\n            [dao.jing.mem :as mem]\n            [dao.lease :as lease]\n            [dao.stream :as stream]\n            [dao.stream.journal :as journal]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm.ucf.authority :as authority]\n            [yin.vm.ucf.authority.admission :as admission]\n            [yin.vm.ucf.authority.completion :as completion]\n            [yin.vm.ucf.authority.grant :as grant]\n            [yin.vm.ucf.authority.input :as input]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as fx]\n            [yin.vm.ucf.custody :as custody]))\n\n\n(def path\n  \"The fixture file, relative to the repository root.\"\n  \"test/resources/yin/vm/ucf/ledger-v2.txt\")\n\n\n(def arb \"arb-c12\")\n\n(def duration {:s 30})\n\n\n;; The root, its continuation successor and a stranger occurrence.\n(def r \"0c000000-0000-4000-8000-000000000001\")\n\n(def s1 \"0c000000-0000-4000-8000-000000000002\")\n\n(def x \"0c000000-0000-4000-8000-000000000004\")\n\n\n;; =============================================================================\n;; World: the requests a holder and the composition make\n;; =============================================================================\n\n(defn header-frame\n  \"The journal header frame naming identity `i`.\"\n  ([] (header-frame arb))\n  ([i]\n   (cbor/encode {:dao.stream.journal/header {:version 1 :identity i}})))\n\n\n(defn origin\n  [o l]\n  {:yin.k/occurrence o :dao.lease/lease l :yin.k/emitter \"holder-a\"})\n\n\n(defn park\n  \"A blocked root of occurrence `o` with counter `n` and origin `org`,\n   nil for a first park.\"\n  ([o n] (park o n nil))\n  ([o n org]\n   (fx/edit-custody (fx/base \"first-park\")\n                    #(cond-> (assoc %\n                                    :yin.k/occurrence o\n                                    :yin.k/next-op-seq n\n                                    :yin.k/arbitration {:dao.stream/identity arb\n                                                        :dao.stream/descriptor\n                                                        {:dao.stream/type :dao.stream/journal}})\n                       (some? org) (assoc :yin.k/origin org)))))\n\n\n(defn halted\n  \"A halted result of occurrence `o` under lease `l`.\"\n  [o l]\n  (fx/edit-custody (fx/base \"halted-root\") #(assoc % :yin.k/origin (origin o l))))\n\n\n(defn world\n  \"A fresh world: the authority's frames (an atom), its content store and\n   a diagnostic stream.\"\n  []\n  {:frames (atom [(header-frame)])\n   :store (mem/create-content-mem)\n   :diag (:dao.stream/handle\n           (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                                ringbuffer/capacity-key 64}))})\n\n\n(defn offer!\n  [{:keys [a store]} b]\n  (let [bs (cbor/encode b)]\n    (grant/offer! a store (fx/segment-address bs) bs \"carrier\")))\n\n\n(defn grant!\n  [{:keys [a]} o l h]\n(ns yin.vm.ucf.rows-support\n  \"Test support for the row carrier under custody (phase 7a): real\n   semantic machines the engine parks, the composition's source\n   index, a deterministic exporter, the custody header parts and `lift`,\n   rows/lift-task over one machine. It owns the shared AST helpers,\n   one-slot streams, exporter, header parts and remote stream test seams.\n\n   Every pack the 7a tests and the rows checkpoint fixtures check comes\n   out of `lift`, never from a hand-built map. The one thing set by hand\n   is an operation id on a wait entry (`with-op-id`), for custody fixtures.\n   The streams carry no random identity and `serve-table` answers s0, s1\n   ... in first-asked order, so a pack's bytes are the same on every run\n   and host.\"\n  (:require [dao.jing :as jing]\n            [dao.stream :as stream]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [dao.stream.remote :as remote]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ledger :as ledger]\n            [yin.vm.module :as module]\n            [yin.vm.semantic :as sr]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.values :as values]))\n\n\n;; =============================================================================\n;; The composition: code by A and the source index\n;; =============================================================================\n\n(def source-index\n  \"The composition's {A #{tree-address}} (continuation §6.1): every vector\n   `project` makes is recorded beside the address of its AST.\"\n  (atom {}))\n\n\n(defn project\n  [ast]\n  (let [v (:vector (linearize/project ast))]\n    (swap! source-index update (jing/segment-key v) (fnil conj #{}) (jing/segment-key [:yin/tree ast]))\n    v))\n\n\n(defn lit\n  [x]\n  {:type :literal, :value x})\n\n\n(defn v\n  [n]\n  {:type :variable, :name n})\n\n\n(defn lam\n  [params body]\n  {:type :lambda, :params params, :body body})\n\n\n(defn app\n  [f & args]\n  {:type :application, :operator f, :operands (vec args)})\n\n\n(defn then\n  [a b]\n  (app (lam ['_] b) a))\n\n\n(defn let1\n  [param init body]\n  (app (lam [param] body) init))\n\n\n(defn def!\n  [k val]\n  (app (v 'yin/def) (lit k) val))\n\n(ns yin.vm.semantic.layout-test\n  \"Phase 6c acceptance 1-9 (docs/design/yin.vm.semantic.continuation.md\n   §8.3): the register pairing and live sets, the register destination from\n   A, the stack correspondence, operand layout and K slices, E\n   reconstruction, closures both ways, and the unobservable fill of a\n   lowered tail. The static items run over C, the B0 corpus and the\n   phase-3 corpus (derive-test's wider C requires the Python ANTLR lane);\n   the dynamic items run the harness's worlds on the de Bruijn lanes.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [clojure.walk :as walk]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.debruijn-code :as dcode]\n            [yin.vm.debruijn-register-code :as rcode]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.engine :as engine]\n            [yin.vm.values :as values]\n            [yin.vm.semantic.analysis :as analysis]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.semantic.corpus :as corpus]\n            [yin.vm.semantic.derive :as derive]\n            [yin.vm.semantic.layout :as layout]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.semantic.safepoint-harness-test :as h]\n            [yin.vm.ucf.rows :as rows]\n","exit_code":0,"status":"completed"}}
