 node matching pred, anywhere under x, replaced by (f node).\"\n  [x pred f]\n  (cond\n    (and (map? x) (contains? x :kind) (contains? x :slots))\n    (if (pred x) (f x) (update x :slots (fn [ss] (mapv #(replace-nodes % pred f) ss))))\n         cursor\n         (let [r (stream/next chan-reader cursor)\n               remaining' (when remaining (dec remaining))]\n           (case (:dao.stream/outcome r)\n             :dao.stream/ok\n             (let [v (:dao.stream/value r)\n                   w (when (well-formed-request? v)\n                       (if (contains? v :dao.stream/identity)\n                         (answer! table chan-writer channel chase-max v)\n                         (answer-named! table names chan-writer v)))]\n               (if (and (= :dao.stream/full (:dao.stream/outcome w))\n                        (not= :dao.stream/append!\n                              (:dao.stream.remote/op v)))\n                 cursor\n                 (recur (:dao.stream/cursor r) remaining')))\n             :dao.stream/blocked cursor\n             :dao.stream/end cursor\n             :dao.stream/gap (recur (:dao.stream/cursor r) remaining')\n             cursor)))))))\n\n\n;; =============================================================================\n;; The link (2.4, 2.5)\n;; =============================================================================\n\n(defn- new-link\n  \"One link per channel descriptor, shared by every reflection through\n   that channel. A link holds the channel writer; the channel reader\n   and the link's own cursor on it; the outstanding request ids with\n   the request each was sent for; the attach descriptor probes the\n   writer has refused, kept unsent with the reflection each was sent\n   for; filed answers keyed by id; the more outcomes installed at\n   their served identity and the cursor that precedes each; an\n   optional event writer; and the policy data -- the resend-after k,\n   the budget k stamped on next requests, and the bounds on reads per\n   drain, on outstanding plus kept requests and on filed plus\n   installed answers, and the give-up-after liveness bound, all\n   composition data; and the last `now` a driver stepped it at.\"\n  [cd chan policy]\n  (let [initial (stream/cursor (:reader chan) :dao.stream/oldest)]\n    (atom {:channel cd\n    (when (= :blocked (:kind world))\n      (is (= (:reason world) (first (:slots (first-pending task)))) \"law 3: the observed wait's reason\"))\n    (is (nil? (rows/validate-frames task)) \"law 6: every lifted frame validates\")\n    (is (= (:yin.k/root (rows/canonical-under wire corr)) (:yin.k/root (rows/canonical-under relift corr2)))\n        \"law 2: lift(lower(S)) = S by root id\")\n    (is (:halted expected) \"the reference run completes\")\n    (is (= (select-keys expected [:halted :value :trace]) (select-keys got [:halted :value :trace]))\n        \"law 1: result and effect trace equal the reference\")\n    got))\n\n\n(defn matrix-cases\n  \"22 wrapped rows x 4 segments, plus row 20 once: [row segment expected build].\"\n  []\n  (conj (into [] (mapcat (fn [[n r build]]\n                           (mapv (fn [[label wrap expected-of]]\n                                   ;; nest's own parameter is x: under :depth-3,\n                                   ;; row 21's (fn [] x) closes over the wrapper's\n                                   ;; x = 1, not the free x = 99 (§5.2 assumes 99)\n                                   (let [r (if (and (= 21 n) (= :depth-3 label)) 1 r)]\n                                     [n label (when (some? r) (expected-of r)) #(build wrap)]))\n                                 segments)))\n              rows)\n        [20 :unwrapped \"B\" tail-effect-halt]))\n\n\n(defn bare\n  [n]\n  (let [[_ _ build] (first (filter #(= n (first %)) rows))]\n    (build identity)))\n\n{:old-projection\n \"419e3aa652d79cab6921cf7a6c02972bcfe2d3b88ba472bc03ac8f1a935f27d2\",\n :new-projection\n \"52f8127f5bcb1643664d665e9e0d3b38bca51039eb6