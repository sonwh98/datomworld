{"type":"item.started","item":{"id":"item_122","type":"command_execution","command":"/bin/zsh -lc \"cat > target/6da/r2-mutation-campaign.clj <<'CLJ'\n(require '[clojure.test :as t] '[clojure.pprint :as pp]\n         'yin.vm.semantic.frame-test 'yin.vm.semantic.vm-test\n         'yin.vm.ucf.rows-test 'yin.vm.ucf.rows-custody-test\n         'yin.vm.semantic.safepoint-harness-test)\n(defn test-counts [vars]\n  (binding [t/*report-counters* (ref t/*initial-report-counters*)\n            t/*test-out* (java.io.StringWriter.)]\n    (t/test-vars (map resolve vars))\n    @t/*report-counters*))\n(def frame-tests '[yin.vm.semantic.frame-test/run-state-rules\n                   yin.vm.semantic.frame-test/worked-example-running-inventory\n                   yin.vm.semantic.frame-test/delivery-and-running-windows-are-distinct])\n(def row-tests '[yin.vm.ucf.rows-test/run-row-slot-and-reference-kinds\n                 yin.vm.ucf.rows-test/running-task-round-trip-and-fencing\n                 yin.vm.semantic.safepoint-harness-test/illegal-task-product-matrix\n                 yin.vm.semantic.safepoint-harness-test/task-products-and-ready-validation\n                 yin.vm.semantic.safepoint-harness-test/completion-try-and-update-refusals\n                 yin.vm.semantic.safepoint-harness-test/completion-outcome-slot-matrix\n                 yin.vm.semantic.safepoint-harness-test/completed-put-history-and-shape-only-ids])\n(def problem (ns-resolve 'yin.vm.semantic.frame 'problem))\n(def bad (ns-resolve 'yin.vm.ucf.rows 'bad\"'!))\n(def outcome (ns-resolve '\"'yin.vm.ucf.rows 'outcome\"'!))\n(def custody (ns-resolve '\"'yin.vm.ucf.rows 'custody-refuse\"'!))\n(defn bypass [v index kind]\n  (let [original @v] (fn [& args] (when-not (= kind (nth args index)) (apply original args)))))\n(def mutants\n  (concat\n    (for [k [:frame-shape :pc-kind :pc-bounds :window-scope :window-extra :window-missing :pending-presence]]\n      {:rule [:frame k] :redefs {problem (bypass problem 0 k)} :tests frame-tests})\n    (for [k [:row-shape :reference-kind :slot-kind :duplicate-key :missing-cursor-cell]]\n      {:rule [:rows k] :redefs {bad (bypass bad 0 k)} :tests row-tests})\n    [{:rule [:completion :site] :redefs {problem (bypass problem 0 :reason-mismatch)} :tests row-tests}\n     {:rule [:completion :try-boolean] :redefs {problem (bypass problem 0 :pending-try)} :tests row-tests}\n     {:rule [:completion :status-refusal] :redefs {outcome (bypass outcome 1 :ready-outcome)} :tests row-tests}\n     {:rule [:completion :op-id-shape] :redefs {(ns-resolve '\"'yin.vm.ucf.rows 'check-op-id-shape\"'!) (fn [& _])} :tests row-tests}\n     {:rule [:task :kind-table] :redefs {custody (bypass custody 0 :kind) outcome (bypass outcome 1 :kind)} :tests row-tests}\n     {:rule [:semantic :closed-gate] :redefs {(ns-resolve '\"'yin.vm.semantic 'check-gate\"'!) (fn [& _])}\n      :tests '\"'[yin.vm.semantic.vm-test/fuel-and-closed-gates\n               yin.vm.semantic.safepoint-harness-test/running-plus-ready-fenced-recovery]}]))\n(def baseline (test-counts (distinct (concat frame-tests row-tests\n                                            '[yin.vm.semantic.vm-test/fuel-and-closed-gates\n                                              yin.vm.semantic.safepoint-harness-test/running-plus-ready-fenced-recovery]))))\n(println \\\"BASELINE\\\" baseline)\n(assert (zero? (+ (:fail baseline) (:error baseline))))\n(def results\n  (mapv (fn [{:keys [rule redefs tests]}]\n          (let [counts (with-redefs-fn redefs #(test-counts tests))\n                result {:rule rule :counts counts :killed? (pos? (+ (:fail counts) (:error counts)))}]\n            (println \\\"MUTANT\\\" (pr-str result)) (flush) result)) mutants))\n(spit \\\"target/6da/r2-mutation-results.edn\\\" (with-out-str (pp/pprint {:baseline baseline :mutants results})))\n(assert (every? :killed? results) \\\"A weakening mutant survived\\\")\nCLJ\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
