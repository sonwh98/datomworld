{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '110,145p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '520,575p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '120,160p' test/yin/vm/ucf/rows_support.cljc; sed -n '1,180p' test/yin/vm/semantic/frame_test.cljc; rg -n 'defn validate|defn run|window|lower-task' src/cljc/yin/vm/semantic/frame.cljc | tail -15\"","aggregated_output":"          :modules stream-modules}\n         opts))\n\n\n(defn- kernel-opts\n  \"A de Bruijn kernel's options for the same composition: the full\n   primitive table, and the initial environment as :free-env.\"\n  [opts]\n  (cond-> (assoc (dissoc (composition opts) :env) :primitives vm/primitives)\n    (contains? opts :env) (assoc :free-env (:env opts))))\n\n\n(defn machine\n  ([] (machine {}))\n  ([opts]\n   (case *lane*\n     :semantic (sr/create-vm (composition opts))\n     :stack (dvm/create-vm [] (kernel-opts opts))\n     :register (rvm/create-vm (assoc {} :bodies [] :instructions []) (kernel-opts opts)))))\n\n\n(defn lane-of\n  [m]\n  (let [f (:format (module/link-format m))]\n    (cond (= dvm/format-tag f) :stack\n          (= rvm/format-tag f) :register\n          :else :semantic)))\n\n\n(def segment-of\n  \"layout/segment, once per A.\"\n  (memoize layout/segment))\n\n\n(defn kernel-space\n  \"The layout space of the A vectors whose images de Bruijn kernel k\n\n(defn drive-peers\n  [m peers]\n  (loop [m (vm/run m) n 12]\n    (if (or (not (vm/blocked? m)) (zero? n))\n      m\n      (do (run! s/serve-mirror! peers) (recur (vm/run m) (dec n))))))\n\n\n(defn satisfy\n  [world m drive]\n  (if-let [resume (:resume world)]\n    (resume m)\n    (reduce (fn [m step] (step) (drive m)) m (:steps world))))\n\n\n(defn reference\n  [world]\n  (let [done (satisfy world (:machine world) drive-local)]\n    (when-let [f (:finish world)] (f))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/remote-attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach! install-lower-opts)\n        attaches @n\n        again (served surfaces)\n          {:dao.stream/outcome :dao.stream/blocked}))\n\n\n      stream/IDaoStreamWriter\n\n      (append!\n        [_ x]\n        (if (not= :empty @slot)\n          {:dao.stream/outcome :dao.stream/full}\n          (do (reset! slot x)\n              {:dao.stream/outcome :dao.stream/ok}))))))\n\n\n(defn serve-table\n  \"A `serve!` answering one stable identity per handle, \\\"s0\\\", \\\"s1\\\"\n   ... in the order the handles are first asked about.\"\n  []\n  (let [table (atom {})]\n    (fn [h]\n      (or (get @table h)\n          (let [served {:dao.stream/identity (str \"s\" (count @table))\n                        :dao.stream/channel {:dao.stream/type\n                                             :dao.stream.test/channel}}]\n            (swap! table assoc h served)\n            served)))))\n\n\n(defn with-op-id\n  \"`machine` with `id` as the `:op-id` of its first wait entry whose\n   reason is `reason`, in the root or, with `path`, in the install child\n   at `path`.  D11 replaces this: its fenced writer assigns ids, and its\n   tests must show a real run's wait entries equal in shape to what this\n   sets.\"\n  ([machine reason id] (with-op-id machine [] reason id))\n  ([machine path reason id]\n   (let [at (into [] (mapcat (fn [m] [:installs m :vm])) path)\n         waits (get-in machine (conj at :wait-set))\n         i (first (keep-indexed #(when (= reason (:reason %2)) %1) waits))]\n     (assert (some? i) (str \"no wait entry of reason \" reason))\n     (assoc-in machine (into at [:wait-set i :op-id]) id))))\n\n(ns yin.vm.semantic.frame-test\n  (:require [clojure.test :refer [deftest is testing]]\n            #?(:cljd nil :clj [clojure.java.io :as io])\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.semantic.analysis :as analysis]\n            [yin.vm.semantic.frame :as frame]\n            [yin.vm.semantic.corpus :as corpus]\n            [yin.vm.semantic.parity-test :as parity]\n            [yin.vm.ucf.rows-support :as s]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]))\n\n\n(def task {:free-env {} :ffi-call-ids #{}})\n\n\n(defn canonical\n  \"Reshape evaluator payload; values remain opaque to the pure validator.\"\n  [m f pending?]\n  (let [address (fn [seg] (get-in m [:code seg :address]))\n        env (fn [e]\n              (cond-> {:yin.k/bindings (engine/without-store-of e)}\n                (some? (engine/env-store-of e)) (assoc :yin.k/store-of (engine/env-store-of e))))\n        act? (contains? f :pc)]\n    (cond-> {:yin.k/state (if act? :act :tail) :yin.k/segment (address (:segment f))\n             :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd (get-in f [:deliver :rd])}\n                                {:yin.k/deliver :return})\n             :yin.k/k (mapv (fn [k]\n                              {:yin.k/frame-type :return :yin.k/segment (address (:segment k))\n                               :yin.k/pc (:pc k) :yin.k/env (env (:env k))\n                               :yin.k/window (:window k) :yin.k/rd (:rd k)}) (or (:k f) []))}\n      act? (assoc :yin.k/pc (:pc f) :yin.k/env (env (:env f)) :yin.k/window (:window f))\n      (not act?) (assoc :yin.k/site (:site f))\n      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n\n\n(defn machine-code\n  [m]\n  (into {} (map (fn [[_ image]] [(:address image) (:vector image)])) (:code m)))\n\n\n(defn- cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn- with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn- nest\n  [depth op]\n  (if (zero? depth) op\n      (cat-of (s/lit [depth]) (s/app (s/lam ['x] (nest (dec depth) op)) (s/lit depth)))))\n\n\n(def wrappers\n  (mapv (fn [[label wrap]] [label (comp with-cat wrap)])\n        [[:bare identity]\n         [:operand #(cat-of (s/lit [:operand]) %)]\n         [:depth-3 #(nest 3 %)]\n         [:captured #(s/let1 'k (s/lit :captured)\n                             (s/let1 'f (s/lam ['y] (cat-of (cat-of (cat-of (s/lit []) (s/v 'k)) (s/v 'y)) %))\n                                     (s/app (s/v 'f) (s/lit :arg))))]]))\n\n\n(defn- rows-program\n  [n]\n  (let [read (s/next-of (s/v 'c)) capture {:type :vm/current-continuation}]\n    (case n\n      1 (s/let1 'a read (cat-of (cat-of (s/lit []) (s/v 'a)) read))\n      2 {:type :stream/put :target (s/v 'w) :val (s/lit \"v\")}\n      5 (cat-of (s/lit [:ordinary]) (s/app (s/v 'stream/next!) (s/v 'c)))\n      6 (s/app (s/lam ['u] (assoc (s/app (s/v 'stream/next!) (s/v 'c)) :tail? true)) (s/lit 0))\n      13 {:type :vm/park}\n      14 (s/let1 'k capture (cat-of (cat-of (s/lit []) (s/v 'k)) read))\n      15 (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n                             :consequent (s/lit :done) :alternate (s/let1 'r read (s/app (s/v 'k) (s/lit :second)))})\n      16 (s/let1 'k1 capture (s/let1 'k2 capture\n                                     (cat-of (cat-of (cat-of (s/lit []) (s/v 'k1)) (s/v 'k2)) read)))\n      18 (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))\n      19 (s/lit 42)\n      21 (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) read)) (s/lit 1)))\n      22 (s/app (s/lam ['p 'q] (cat-of (cat-of (s/lit []) (s/v 'p)) (s/v 'q))) (s/lit nil) read))))\n\n\n(defn- attach-reader\n  [m ring]\n  (let [[ref m] (engine/attach-resource m ring)\n        [id m] (engine/gensym m \"cursor\")]\n    (engine/handle-cursor m {:stream ref} id)))\n\n\n(defn reference-machines\n  []\n  (into\n    (mapv (fn [[n [label wrap]]]\n            (let [ring (s/ring 4)\n                  w (s/one-slot-stream (str \"frame-\" n))\n                  _ (stream/append! w :warmed)\n                  env (if (= n 21) {'x 99 'y 7} {})\n                  m (parity/register-machine (wrap (rows-program n)) {:env env :modules (module/register-stream-module (module/default-registry))})\n                  [cr m] (attach-reader m ring)\n                  [wr m] (engine/attach-resource m w)\n                  m (assoc m :store {'c cr 'w wr})\n                  m (if (= n 18)\n                      (let [[second-cursor m] (attach-reader m ring)\n                            [seg image] (first (:code m))\n                            closure (first (filter #(= :closure (first %)) (:vector image)))\n                            clo (values/closure (:owner m) {:type :closure :params (nth closure 2)\n                                                            :entry (nth closure 3) :segment seg\n                                                            :env {engine/store-of-key 'host.mod}})]\n                        (assoc m :store (assoc (:store m) 'mod clo)\n                               :module-stores {'host.mod {'c cr 'd second-cursor}})) m)\n                  blocked (vm/run m)\n                  blocked (if (= n 1) (do (stream/append! ring \"A\") (vm/run blocked)) blocked)]\n              {:row n :wrapper label :machine blocked :task (assoc task :free-env env)}))\n          (mapcat (fn [n] (mapv #(vector n %) wrappers)) [1 2 5 6 13 14 15 16 18 19 21 22]))\n    (let [ring (s/ring 4)\n          m (parity/register-machine (assoc (s/app (s/v 'stream/next!) (s/v 'c)) :tail? true)\n                                     {:modules (module/register-stream-module (module/default-registry))})\n          [cr m] (attach-reader m ring)]\n      [{:row 20 :wrapper :unwrapped :machine (vm/run (assoc m :store {'c cr})) :task task}])))\n\n\n(defn reference-frames\n  \"Every wait, parked payload, and capture reachable through their values.\"\n  [{:keys [machine task] :as fixture}]\n  (let [out (atom []) code-map (machine-code machine)]\n    (letfn [(record\n              [f context t]\n              (let [cf (canonical machine f (= :wait context))]\n                (swap! out conj {:frame cf :code code-map :context context :task t :fixture (select-keys fixture [:row :wrapper])})\n                (walk (:env f)) (walk (:window f)) (walk (:k f))))\n            (walk\n              [x]\n              (cond\n                (values/continuation? x) (record (values/payload x) :captured task)\n                (values/closure? x) (walk (:env (values/payload x)))\n                (map? x) (doseq [[k v] x] (walk k) (walk v))\n                (coll? x) (doseq [v x] (walk v))\n                :else nil))]\n      (doseq [f (:wait-set machine)] (record f :wait task))\n      (doseq [[p f] (:parked machine)] (record f :parked (assoc task :p