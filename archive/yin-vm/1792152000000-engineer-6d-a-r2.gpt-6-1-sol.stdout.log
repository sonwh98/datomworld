{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p target/6da\ncat > /tmp/6da-ledger-r2.clj <<'CLJ'\n(require '[yin.vm.ucf.ledger-fixtures :as f] '[dao.jing.cbor :as cbor]\n         '[dao.jing :as jing] '[clojure.string :as str] '[clojure.pprint :as pp])\n(defn changes [p a b]\n  (cond (= a b) []\n        (and (map? a) (map? b) (= (set (keys a)) (set (keys b))))\n        (mapcat #(changes (conj p %) (get a %) (get b %)) (sort-by pr-str (keys a)))\n        (and (sequential? a) (sequential? b) (= (count a) (count b)))\n        (mapcat #(changes (conj p %) (nth a %) (nth b %)) (range (count a)))\n        :else [{:path p :old a :new b}]))\n(let [old-text (f/read-text) old (f/read-file) new-text (f/render)\n      lines (str/split-lines new-text)\n      new-frames (mapv dao.jing.cbor-fixtures/hex->bytes (drop 2 lines))\n      inventory (mapv (fn [i a b]\n                        {:frame i :changed? (not= (f/hex a) (f/hex b))\n                         :changes (vec (changes [] (cbor/decode a) (cbor/decode b)))})\n                      (range) (:frames old) new-frames)\n      changed (filterv :changed? inventory)\n      address? #(and (keyword? %) (str/starts-with? (str %) \\\":segment/blake3-\\\"))]\n  (assert (= (count (:frames old)) (count new-frames)))\n  (assert (= 6 (count changed)))\n  (doseq [frame changed]\n    (assert (seq (:changes frame)))\n    (doseq [{:keys [old new] :as c} (:changes frame)]\n      (assert (and (address? old) (address? new)) (pr-str c))))\n  (spit \\\"target/6da/r2-ledger-diff-inventory.edn\\\"\n        (with-out-str (pp/pprint\n                       {:old-projection (:digest old) :new-projection (subs (second lines) 11)\n                        :old-golden-blake3 (jing/digest-bytes :blake3 (.getBytes old-text \\\"UTF-8\\\"))\n                        :new-golden-blake3 (jing/digest-bytes :blake3 (.getBytes new-text \\\"UTF-8\\\"))\n                        :frame-count (count inventory)\n                        :classification :address-only :journal-frames changed\n                        :unchanged-frames (mapv :frame (remove :changed? inventory))})))\n  (spit f/path (f/render))\n  (println \\\"Regenerated through ledger-fixtures/render; changed journal frames:\\\" (mapv :frame changed)))\nCLJ\nclojure -Sdeps '{:paths [\\\"test\\\"]}' -M /tmp/6da-ledger-r2.clj > target/6da/r2-ledger-render.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
