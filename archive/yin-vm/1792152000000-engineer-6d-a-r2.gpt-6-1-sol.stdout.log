{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1605,1648p' src/cljc/yin/vm/engine.cljc; sed -n '1270,1315p' src/cljc/yin/vm/ucf/rows.cljc; sed -n '175,220p' test/yin/vm/ucf/rows_support.cljc; tail -6 target/6da/r2-harness-sixth.log; rg -n '\"'^FAIL|''^ERROR|actual:'\"' target/6da/r2-harness-sixth.log | head -16\"","aggregated_output":"          (recur a b)\n          [a b c])))))\n\n\n(defn- poll-link-entry\n  \"One poll of a link wait entry: a `:link-request` retries its retained\n   envelope and, appended, polls on as a `:link-response`; an `:install`\n   waits for its install. Under a custody gate a request is not retried\n   and a response is not scanned. Returns `[state waiting woken]`.\"\n  [state entry]\n  (let [gate (vm/gate-mode state)]\n    (case (:reason entry)\n      :link-request\n      (let [entry' (module/append-link-request (:resources state) entry gate)]\n        (if (= :link-response (:reason entry'))\n          (poll-link-response state entry')\n          [state entry' nil]))\n      :link-response (if (some? gate)\n                       [state entry nil]\n                       (poll-link-response state entry))\n      :install [state entry nil])))\n\n\n(defn- poll-links\n  \"Poll every link wait entry once, in wait-set order, and then step the\n   install children. Returns the state with the still-waiting link\n   entries appended to `others` and the woken ones queued.\"\n  [state links others run-child]\n  (let [[state waiting woken]\n        (reduce (fn [[state waiting woken] entry]\n                  (let [[state w k] (poll-link-entry state entry)]\n                    [state\n                     (cond-> waiting w (conj w))\n                     (cond-> woken k (conj k))]))\n                [state [] []]\n                links)]\n    (-> state\n        (assoc :wait-set (into (vec others) waiting))\n        (update :ready-queue (fnil into []) woken)\n        (advance-installs run-child))))\n\n\n(defn- require-running!\n  \"Refuse a driver apply on an ungated task (it drives itself) and in the\n        (when (contains? c :yin.k/origin) (check-origin! c)))))\n\n\n(defn- check-op-id-shape!\n  [op-id p]\n  (when-not (and (map? op-id) (= 2 (count op-id))\n                 (custody/occurrence? (get op-id :yin.k/occurrence))\n                 (contains? op-id :yin.k/seq))\n    (custody-refuse! :malformed-op-id p))\n  (when-not (custody/exact? (get op-id :yin.k/seq))\n    (custody-refuse! :inexact (conj p :yin.k/seq))))\n\n\n(defn- check-op-id!\n  \"One carried id against the root context: its shape, an origin present,\n   never the root's own occurrence, below the root counter (checkpoint.cljc's\n   check-op-id!, verbatim).\"\n  [ctx op-id p]\n  (check-op-id-shape! op-id p)\n  (when-not (contains? ctx :yin.k/origin) (custody-refuse! :op-id-without-origin p))\n  (when (cbor/content= (get op-id :yin.k/occurrence) (get ctx :yin.k/occurrence))\n    (custody-refuse! :op-id-own-occurrence p))\n  ;; a :halted root has no counter, so no id can be below it\n  (when-not (and (contains? ctx :yin.k/next-op-seq)\n                 (neg? (cbor/num-compare (get op-id :yin.k/seq) (get ctx :yin.k/next-op-seq))))\n    (custody-refuse! :op-seq-range (conj p :yin.k/seq))))\n\n\n(defn- wire-slot\n  \"A V slot as the wire holds it: a [:row n] is [:row id].\"\n  [x]\n  (if (and (vector? x) (= :row (first x))) [:row (first (emit-node (second x) {} {}))] x))\n\n\n(defn- task-ops\n  \"[path op-id intent] of every id the waits of task carry, then of each\n   install child in carried (module-name) order, in the root's context.\n   Checks each task's kind and role, each :install pending's install row,\n   and that a child's custody slot is nil.\"\n  [ctx task role path]\n  (let [[_ _ kind role' _ _ _ _ _ _ _ _ installs waits] (:slots task)\n        names (into #{} (map #(first (:slots %))) installs)]\n    (when-not (and (contains? #{:running :blocked :parked :halted} kind)\n                   (= (if (= :running kind) 1 0) (count (nth (:slots task) 17))))\n      (custody-refuse! :kind (conj path :kind)))\n    (when-not (= role role') (custody-refuse! :role (conj path :role)))\n  {:dao.stream/identity \"arbitration-1\"\n   :dao.stream/descriptor {:dao.stream/type :remote :peer \"peer-b\"}})\n\n\n(defn op-id\n  ([n] (op-id predecessor n))\n  ([occ n] {:yin.k/occurrence occ :yin.k/seq n}))\n\n\n(defn header\n  \"The custody header for the row lift: a first export when `o` is\n   nil.\"\n  ([n] (header n origin #{}))\n  ([n o enrolled]\n   (cond-> {:yin.k/occurrence occurrence\n            :yin.k/arbitration arbitration\n            :yin.k/next-op-seq n\n            :yin.k/enrolled enrolled}\n     (some? o) (assoc :yin.k/origin o))))\n\n\n(defn ring\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type ringbuffer/capacity-key capacity})))\n\n\n(defn- make-det-stream\n  []\n  (let [n (atom 0)]\n    (fn [_capacity]\n      {:dao.stream/outcome :dao.stream/ok\n       :dao.stream/handle (one-slot-stream (str \"made-\" (swap! n inc)))})))\n\n\n(def stream-modules (module/register-stream-module (module/default-registry)))\n\n\n(defn new-machine\n  ([] (new-machine {}))\n  ([opts]\n   (sr/create-vm (merge {:make-stream (make-det-stream)\n                         :capability-secret tu/secret\n                         :modules stream-modules\n                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))}\n                        opts))))\nRunning tests in #{\"test\"}\nWARNING: load already refers to: #'clojure.core/load in namespace: yin.vm.encoder, being replaced by: #'yin.vm.encoder/load\n\nTesting yin.vm.semantic.frame-test\n\nTesting yin.vm.semantic.safepoint-harness-test\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='test/yin/vm/semantic/safepoint_harness_test.cljc';s=open(p).read();a=s.index('(defn fuel-drive');s=s[:a]+'''(defn active-tree?\n  [m]\n  (or (:control m) (seq (:ready-queue m))\n      (some (fn [[_ inst]] (or (= :running (:phase inst)) (active-tree? (:vm inst)))) (:installs m))))\n\n\n'''+s[a:];s=s.replace('(if (or (:control next) (seq (:ready-queue next)))','(if (active-tree? next)');open(p,'w').write(s)\nPY\nclojure -M:test -e :slow -n yin.vm.semantic.safepoint-harness-test -n yin.vm.semantic.frame-test > target/6da/r2-harness-sixth.log 2>&1\"","aggregated_output":"","exit_code":1,"status":"failed"}}
