{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,105p' src/cljc/yin/vm/semantic/frame.cljc; sed -n '340,400p;530,580p;1430,1475p' test/yin/vm/semantic/safepoint_harness_test.cljc; sed -n '1,70p' test/yin/vm/ucf/rows_test.cljc; rg -n 'checkpoint-v3|spit|regenerat' test/yin/vm/ucf/rows*; sed -n '870,945p' src/cljc/yin/vm/debruijn/register.cljc; rg -n 'restore|wait-entry|select-keys|reason' src/cljc/yin/vm/debruijn/stack.cljc | tail -20; git log --oneline -5 -- test/resources/yin/vm/ucf/rows-checkpoint-v3.txt\"","aggregated_output":"(ns yin.vm.semantic.frame\n  \"Pure, ordered validation of decoded canonical continuation frames (§3).\"\n  (:require [dao.jing.cbor :as cbor]\n            [yin.vm :as vm]\n            [yin.vm.values :as values]\n            [yin.vm.semantic.code :as code]\n            [yin.vm.semantic.analysis :as analysis]))\n\n\n(defn- problem\n  [kind path]\n  {:yin.k/kind kind :yin.k/path path})\n\n\n(defn- closed?\n  [x required optional]\n  (and (map? x) (every? #(contains? x %) required)\n       (every? (into (set required) optional) (keys x))))\n\n\n(defn task-defect\n  \"X1, once per body, including a halted body with no frames.\"\n  [task]\n  (let [e (:free-env task)]\n    (cond\n      (not (and (map? e) (every? symbol? (keys e))))\n      (problem :free-env-shape [:free-env])\n      (some vm/reserved-name? (keys e))\n      (problem :reserved-name [:free-env]))))\n\n\n(defn- env?\n  [e]\n  (and (closed? e [:yin.k/bindings] [:yin.k/store-of])\n       (or (not (contains? e :yin.k/store-of)) (some? (:yin.k/store-of e)))\n       (map? (:yin.k/bindings e))\n       (every? symbol? (keys (:yin.k/bindings e)))))\n\n\n(defn- lexical-names\n  [v pc]\n  (let [bs (code/body-ranges v)]\n    (loop [b (code/body-index bs pc) names #{}]\n      (if-let [owner (:owner (nth bs b))]\n        (recur (code/body-index bs owner) (into names (nth (nth v owner) 2)))\n        names))))\n\n\n(defn- window-defect\n  [f v rd prefix path]\n  (let [pc (:yin.k/pc f) w (:yin.k/window f)\n        body (nth (code/parse v) (code/body-index (code/body-ranges v) pc))\n        wanted (analysis/saved (analysis/analyze v) pc rd)\n        ks (set (keys w))\n        kind (fn [s] (keyword (str prefix s)))\n        p (conj path :yin.k/window)]\n    (cond\n      (some #(>= % (:registers body)) ks) (problem (kind \"window-scope\") p)\n      (contains? w rd) (problem (kind \"window-self\") p)\n      (some #(not (contains? wanted %)) ks) (problem (kind \"window-extra\") p)\n      (some #(not (contains? w %)) wanted) (problem (kind \"window-missing\") p))))\n\n\n(defn- bindings=\n  \"Compare free bindings slotwise by encoder content, retaining host equality\n   for callables and stream, cursor or cell references as data-content= does.\"\n  [a b]\n  (let [opaque? (fn [x]\n                  (or (fn? x) (values/closure? x) (values/continuation? x)\n                      (and (map? x) (contains? #{:stream-ref :cursor-ref :cell-ref} (:type x)))))]\n    (and (= (set (keys a)) (set (keys b)))\n         (every? (fn [[k v]]\n                   (let [w (get b k)]\n                     (or (identical? v w)\n                         (if (or (opaque? v) (opaque? w))\n                           (= v w)\n                           (cbor/content= v w))))) a))))\n\n\n(defn defect\n  \"First §3 defect, or nil. Code is already well formed; task is plain\n   {:free-env map :parked-key P :ffi-call-ids set}. No engine is read.\n   Values have already passed the carrier's value-domain checks.\"\n  [frame code-map context task]\n  (let [act? (= :act (:yin.k/state frame))\n        required (if act?\n                   [:yin.k/state :yin.k/segment :yin.k/pc :yin.k/env\n                    :yin.k/window :yin.k/deliver :yin.k/k]\n                   [:yin.k/state :yin.k/segment :yin.k/site :yin.k/deliver :yin.k/k])\n        k (:yin.k/k frame)\n        returns (when (vector? k) (mapv (fn [i] [(nth k i) [:yin.k/k i]]) (range (count k))))\n        all (into [[frame []]] returns)\n        envs (if act? all returns)]\n    (or\n      ;; S1-S4, globally before any dependent read.\n      (when-not (and (contains? #{:act :tail} (:yin.k/state frame))\n                     (closed? frame required [:yin.k/pending]))\n        (problem :frame-shape []))\n      (when-not (vector? k) (problem :k-shape [:yin.k/k]))\n      (some (fn [[f p]]\n              (when-not (and (closed? f [:yin.k/frame-type :yin.k/segment :yin.k/pc\n                                         :yin.k/env :yin.k/window :yin.k/rd] [])\n                             (= :return (:yin.k/frame-type f)))\n                (problem :k-shape p))) returns)\n      (some (fn [[f p]]\n  (s/then (s/next-of (s/cursor-of {:type :stream/make :buffer 4})) (s/def! 'f (s/lam [] (s/lit 42)))))\n\n\n(defn require-op\n  [tail?]\n  (let [call (s/app (s/v 'require) (s/lit 'host.mod))]\n    (if tail? (s/app (s/lam ['u] (tail call)) (s/lit 0)) call)))\n\n\n(defn link-receiver\n  [trace]\n  (fn []\n    (let [rq (s/ring 64)]\n      {:opts {:link-request rq :link-response (s/ring 64)} :finish #(swap! trace into (tu/drain rq))})))\n\n\n(defn linking\n  \"A require parked in :link-response (or :link-request behind a full,\n   warmed request stream when retained?).\"\n  [wrap tail? retained?]\n  (let [trace (atom [])\n        request (if retained? (s/one-slot-stream \"link-request\") (s/ring 64))\n        response (s/ring 64)\n        _ (when retained? (stream/append! request :warmed))\n        m (vm/run (load-program (machine {:link-request request :link-response response})\n                                (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m)))\n        answer! #(stream/append! response (assoc (module-response plain-body #{'f}) :yin.link/id id))]\n    {:machine m :kind :blocked :reason (if retained? :link-request :link-response)\n     :surfaces #{:reader :writer} :trace trace\n     :steps (if retained? [#(stream/next request 0) answer!] [answer!])\n     :finish (if retained?\n               #(swap! trace conj (:dao.stream/value (stream/next request 0)))\n               #(swap! trace into (tu/drain request)))\n     :receiver (link-receiver trace)}))\n\n\n(defn installing\n  \"A require parked on :install beside its blocked child.\"\n  [wrap tail? phase]\n  (let [trace (atom [])\n        request (s/ring 64) response (s/ring 64)\n        m0 (vm/run (load-program (machine {:link-request request :link-response response})\n                                 (with-cat (wrap (require-op tail?)))))\n        id (:link-id (first (:wait-set m0)))\n        _ (stream/append! response (assoc (module-response blocking-body #{'f}) :yin.link/id id))\n        m1 (vm/run m0)\n        m (if phase (assoc-in m1 [:installs 'host.mod :phase] phase) m1)\n        child (get-in m [:installs 'host.mod :vm])\n        child-stream (s/stream-of child)]\n    {:machine m :kind :blocked :reason :install :trace trace\n     :steps [#(stream/append! child-stream :fed)]\n     :finish #(swap! trace into (tu/drain request))\n     :receiver (link-receiver trace)}))\n\n\n(defn module-context\n  \"Blocked inside host.mod's exported closure, whose E names store-of host.mod.\"\n  [wrap]\n  (let [request (s/ring 64) response (s/ring 64)\n        body (s/def! 'f (s/lam ['c] (s/app (s/v 'stream/next!) (s/v 'c))))\n    {:halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn served\n  \"A served table over a fresh toy: [serve! correspondence-fn].\"\n  [surfaces]\n  (let [t (s/toy) peer (s/served-peer t)]\n    {:toy t :peer peer :serve! (s/server peer (:channel t) surfaces)}))\n\n\n(defn recording-attacher\n  \"The receiver's attach!, counting attaches and recording each\n   reflection's source identity.\"\n  [t]\n  (let [base (s/remote-attacher t) origin (atom {}) n (atom 0)]\n    {:attach! (fn [d]\n                (swap! n inc)\n                (let [r (base d)]\n                  (when-let [h (:dao.stream/handle r)] (swap! origin assoc h (:dao.stream/identity d)))\n                  r))\n     :origin origin :count n}))\n\n\n(defn handed-off\n  \"Lift, lower into a fresh receiver, relift at once, then satisfy through\n   the source's streams.\"\n  [world]\n  (let [surfaces (or (:surfaces world) #{:reader})\n        {:keys [toy peer serve!]} (served surfaces)\n        wire (rows/lift-task (:machine world) serve! (lift-opts))\n        corr (into {} (map (fn [[id _]] [id id])) @(:table peer))\n        receiver ((or (:receiver world) (constantly nil)))\n        {:keys [attach! origin] n :count} (recording-attacher toy)\n        recv (rows/lower-task (machine (merge {:attach-stream attach!} (:opts receiver))) wire attach!)\n        attaches @n\n        again (served surfaces)\n        relift (rows/lift-task recv (:serve! again) (lift-opts))\n        corr2 (into {} (map (fn [[id e]] [id (get @origin (:handle e))])) @(:table (:peer again)))\n        done (satisfy world recv #(drive-peers % [peer]))\n        _ (s/serve-mirror! peer)]\n    (when-let [f (:finish world)] (f))\n    (when-let [f (:finish receiver)] (f))\n    {:wire wire :recv recv :relift relift :corr corr :corr2 corr2 :attaches attaches\n     :halted (vm/halted? done) :value (normalize (vm/value done)) :trace @(:trace world)}))\n\n\n(defn root-task\n  [wire]\n  (rows/decode wire))\n\n\n   and §4 defines no layout for install children (canonical-task refuses\n   :installs). The reference lane runs the whole matrix; these lanes are\n   removed with their kernels at phase 8.\"\n  #{7 8 9 10 11 12 17})\n\n\n(def lane-rows\n  \"The wrapped rows every lane executes: 15 of §5.2's 22.\"\n  (filterv #(not (contains? link-rows (first %))) rows))\n\n\n(defn lane-cases\n  \"§5.3's shared fragment: 15 lane rows x 4 segments, plus row 20 once:\n   [row segment expected build].\"\n  []\n  (filterv #(not (contains? link-rows (first %))) (matrix-cases)))\n\n\n(defn on-lane\n  [lane build]\n  (binding [*lane* lane] (build)))\n\n\n(defn lane-lift\n  \"The lift of §7.1 on m's own lane.\"\n  [m serve!]\n  (if (= :semantic (lane-of m))\n    (rows/lift-task m serve! (lift-opts))\n    (layout/lift-task m (kernel-space m) (on-lane :semantic machine) serve! (lift-opts))))\n\n\n(defn lane-lower\n  \"The lower of §7.2 into a fresh receiver on lane, of composition opts.\"\n  [lane opts wire attach!]\n  (let [scratch (on-lane :semantic #(machine opts))]\n    (if (= :semantic lane)\n      (rows/lower-task scratch wire attach!)\n      (layout/lower-task scratch (on-lane lane #(machine opts)) wire attach!))))\n\n\n(defn injective\n  \"names, refusing when two identities share a logical name (§5.5).\"\n  [names]\n  (when-not (= (count names) (count (distinct (vals names))))\n    (throw (ex-info \"The correspondence is not injective\" {:law-4 :injective :names names})))\n  names)\n(ns yin.vm.ucf.rows-test\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yang.python.antlr.int-contract-fixtures :as ints]\n            [yin.vm :as vm]\n            [yin.vm.module :as module]\n            [yin.vm.ucf.rows-support :as support]\n            [dao.test-slow :as slow]\n            [yin.vm.semantic.frame-test :as ft]\n            [yin.vm.values :as values]\n            [yin.vm.engine :as engine]\n            [yin.vm.ucf.rows :as rows]))\n\n\n(defn error\n  [f]\n  (try (f) nil (catch #?(:cljd Object :clj Throwable :cljs :default) e (ex-data e))))\n\n\n(defn task-node\n  [cursor-cells result]\n  (rows/node :task [3 rows/profile :halted :root 0 (rows/node :bindings [])\n                    (rows/node :store []) [] (rows/node :parked-table [])\n                    (rows/node :cursor-cells (mapcat identity cursor-cells)) {} {} [] [] nil result nil]))\n\n\n(defn cursor-cell-body\n  [stream position]\n  (rows/node :cursor-cell-body [(rows/node :stream [stream {:peer stream}]) position]))\n\n\n(defn fixture\n  [a b x y]\n  (let [payload [:row (rows/node :map\n                                 [[:lit 'both] [:row (rows/node :set [[:cursor-cell x] [:cursor-cell y]])]\n                                  [:lit 'one] [:cursor-cell x]\n                                  [:lit 'streams] [:row (rows/node :set [[:row (rows/node :stream [a {:peer a}])]\n                                                                         [:row (rows/node :stream [b {:peer b}])]])]\n                                  [:lit 'cursors] [:row (rows/node :map [[:cursor-cell x] [:lit :x] [:cursor-cell y] [:lit :y]])]])]\n        task (task-node [[x (cursor-cell-body a 0)] [y (cursor-cell-body b 0)]] [:lit nil])]\n    (rows/node :task (assoc (:slots task) 6 (rows/node :store ['payload payload])))))\n\n\n(declare portable-frame)\n\n\n(defn- encoded\n  [x]\n  (cond (and (map? x) (contains? x :yin.k/row)) [:row (:yin.k/row x)]\n        (and (map? x) (contains? x :yin.k/cursor-cell)) [:cursor-cell (:yin.k/cursor-cell x)]\n        :else [:lit x]))\n\n\n(defn- portable-value\n  [m x]\n  ;; Classify native test values into the decoded codec domain. No seals\n  ;; travel. Captures retain their entire act and K; closures retain the\n  ;; code address, binders, lexical bindings and module context.\n  (cond\n    (values/continuation? x)\n    {:yin.k/row (rows/node :reified\n                           [(rows/decode (rows/frame->rows\n                                           (portable-frame m (ft/canonical m (values/payload x) false)) encoded))])}\n    (values/closure? x)\n    (let [p (values/payload x) e (:env p)]\n      {:yin.k/row (rows/node :closure [(get-in m [:code (:segment p) :address]) (:entry p) (:params p)\n                                       (rows/node :bindings\ntest/yin/vm/ucf/rows_checkpoint_fixtures.cljc:18:   The pins live in test/resources/yin/vm/ucf/rows-checkpoint-v3.txt, one\ntest/yin/vm/ucf/rows_checkpoint_fixtures.cljc:40:  \"test/resources/yin/vm/ucf/rows-checkpoint-v3.txt\")\ntest/yin/vm/ucf/rows_checkpoint_test.cljc:4:   test/resources/yin/vm/ucf/rows-checkpoint-v3.txt records for it, and\n    (throw\n      (ex-info\n        (str \"environment is not implemented: the design defers it until a \"\n             \"frame-to-named lift exists\")\n        {:rule :not-yet-supported})))\n  (store [this] (:store this))\n  (continuation [this] (:continuation this)))\n\n\n;; =============================================================================\n;; Module kernel (yin.vm.linker.md section 7.3)\n;; =============================================================================\n;; As the stack kernel: a positional closure lifts by the offset table row\n;; holding its body pc and lowers by the receiving table's row.\n\n(defn- binding-mismatch!\n  [marker]\n  (throw (ex-info \"Closure marker of another binding discipline or format\"\n                  {:reason :binding-mismatch,\n                   :binding (:yin.k/binding marker),\n                   :format (:yin.k/format marker),\n                   :expected-format format-tag})))\n\n\n(extend-type DebruijnRegisterVM\n  module/IModuleKernel\n  (link-format [_] {:format format-tag, :contract vm/register-contract})\n  (spawn-module\n    [vm image {:keys [modules origin ancestry capability-secret]}]\n    (create-vm image\n               {:free-env (:free-env vm),\n                :primitives (:primitives vm),\n                :modules modules,\n                :make-stream (:make-stream vm),\n                :link-request (get (:resources vm)\n                                   module/link-request-resource),\n                :link-response (get (:resources vm)\n                                    module/link-response-resource),\n                :origin origin,\n                :ancestry ancestry,\n                :capability-secret capability-secret,\n                :secret-source (:secret-source vm),\n                :attach-stream (:attach-stream vm),\n                :gc-threshold (:base (:gc vm)),\n                :contract vm/register-contract}))\n  (image-identity [_ image] (rcode/register-hash image))\n  (image-holds? [_ image segment] (= segment (rcode/register-hash image)))\n  (attach-module [vm image] (attach-image vm image vm/register-contract))\n  (lift-closure [vm closure encode]\n    (let [[ident rel] (or (image-pc vm (:body-pc closure))\n                          (throw (ex-info \"Closure body in no held image\"\n                                          {:yin.k/status :yin.k/non-portable,\n                                           :yin.k/kind :unrooted-body})))]\n      (cond-> {:yin.k/tag :yin.k/closure,\n               :yin.k/binding :positional,\n               :yin.k/format format-tag,\n               :yin.k/segment ident,\n               :yin.k/entry rel,\n               :yin.k/arity (:arity closure),\n               :yin.k/frames (mapv #(mapv encode %) (:frames closure))}\n        (:store-of closure) (assoc :yin.k/store-of (:store-of closure)))))\n  (lower-closure [vm marker decode]\n    (when-not (and (= :positional (:yin.k/binding marker))\n                   (= format-tag (:yin.k/format marker)))\n      (binding-mismatch! marker))\n    (let [pc (absolute-pc vm [(:yin.k/segment marker) (:yin.k/entry marker)])]\n      (when (nil? pc)\n        (throw (ex-info \"Closure origin image is not attached\"\n                        {:reason :origin-not-attached,\n                         :segment (:yin.k/segment marker)})))\n      ;; the arity is that of a `:closure` of the attached code whose body\n      ;; this is, never the wire's\n      (when-not (some #(and (= :closure (nth % 0))\n                            (= (:yin.k/arity marker) (nth % 2))\n                            (= pc (nth % 3)))\n                      (:instructions (:segment vm)))\n567:                (ffi/response-wait-entry entry (:call-id entry)))\n574:          restored (assoc base\n583:        (return-transition restored val)\n584:        (assoc restored :stack (conj (:stack restored) val))))))\n590:   and returns them merged with `:reason` and the resource ids from the\n592:   restore function.\"\n600:                          :reason :put\n604:                           :reason :next\n633:   identical request, and `stack-restore` turns that writer into the\n661:      :dao.stream/ok (blocked (ffi/response-wait-entry regs call-id))\n666:                                       :reason :put\n767:          ;; registers are restored with the argument on the stack, as a\n770:          (stack-restore vm\n863:      ;; continuation named by the operand, through this machine's restore\n869:                                    stack-restore))\n884:   loop with this machine's step function and its restore bound into the\n891:                   #(engine/resume-from-run-queue % stack-restore)))\n909:          (engine/scheduler-round this stack-restore)\n945:                  {:reason :binding-mismatch,\n995:                        {:reason :origin-not-attached,\n19528b7c feat(yin.vm.linker): the production pipeline publishes, verifies and re-lowers from A, the semantic format record moves to :yin.semantic/code v4, and the Python harness loads through the semantic-register kernel (phase 8c; Architect ruling C and sign-off)\n95c228c0 feat(yin.vm.ucf): the holder exports row packs, recovery format 2, the driver lowers rows, install checks (phase 7b)\nb4d80e8d feat(yin.vm.ucf): custody on rows, the rows inspector and the authority's fixtures over row packs (phase 7a)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"The row carrier drops the flag, and the remote pending conversion does too. I’ll add one boolean slot to each link pending variant and preserve the existing slot positions so operation IDs and stream routing stay intact."}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat test/yin/vm/ucf/rows_checkpoint_fixtures.cljc | head -100; rg -n 'defn|spit' test/yin/vm/ucf/rows_checkpoint_fixtures.cljc | tail -20; sed -n '510,585p' src/cljc/yin/vm/debruijn/stack.cljc; rg -n 'restore|select-keys' src/cljc/yin/vm/debruijn/register.cljc | head -20; sed -n '1280,1305p' docs/design/yin.vm.linker.md; sed -n '90,115p' test/yin/vm/ucf/rows_test.cljc; sed -n '1,60p' test/yin/vm/semantic/frame_test.cljc; rg -n 'pending|reason' test/yin/vm/semantic/frame_test.cljc | head -25; sed -n '1150,1177p' src/cljc/yin/vm/engine.cljc\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat test/yin/vm/ucf/rows_checkpoint_fixtures.cljc | head -100; rg -n 'defn|spit' test/yin/vm/ucf/rows_checkpoint_fixtures.cljc | tail -20; sed -n '510,585p' src/cljc/yin/vm/debruijn/stack.cljc; rg -n 'restore|select-keys' src/cljc/yin/vm/debruijn/register.cljc | head -20; sed -n '1280,1305p' docs/design/yin.vm.linker.md; sed -n '90,115p' test/yin/vm/ucf/rows_test.cljc; sed -n '1,60p' test/yin/vm/semantic/frame_test.cljc; rg -n 'pending|reason' test/yin/vm/semantic/frame_test.cljc | head -25; sed -n '1150,1177p' src/cljc/yin/vm/engine.cljc\"","aggregated_output":"(ns yin.vm.ucf.rows-checkpoint-fixtures\n  \"The shared canonical fixtures of the rows inspector (phase 7a, plan\n   §3.3, §4 7a), pinned by their pack addresses, loaded on the JVM, Node\n   and Dart.\n\n   The five accepted bases are packs rows/lift-task itself emitted under\n   a custody header from real semantic machines\n   (yin.vm.ucf.rows-support), the old checkpoint fixtures' five bases\n   re-lifted. Nothing about a base is hand-built but its operation ids\n   (`rows-support/with-op-id`). Every other fixture is a mutation of a\n   named base: a task edit (decode, change the abstract task, `rows/emit`,\n   so every row it touches is rehashed and the pack stays canonical), or a\n   raw edit of the pack where the defect is the carrier's own (version,\n   tag, row order, a row changed without rehash, a frame root). A\n   mutation names the refusal it must draw, as a map the refusal must\n   contain, computed from its base where a path depends on it.\n\n   The pins live in test/resources/yin/vm/ucf/rows-checkpoint-v3.txt, one\n   block per fixture separated by a blank line: the name and the pack\n   address of its bytes. Three anchors (`anchors`) also keep their full\n   bytes as lowercase hex in lines of 64 digits, so the inspector reads\n   bytes this build did not produce; every other fixture's bytes are built\n   from its pack and checked against its pinned address. Regenerate the\n   file from a JVM REPL with the string `render` returns, saved to `path`;\n   the test proves on every host that the file equals `render`.\n\n   The test helpers below (`base`, `edit-task`, `edit-custody`, `enc`,\n   the wait and child accessors) are what the authority's tests use to\n   make their own packs from these bases.\"\n  (:require [clojure.string :as str]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-support :as s]))\n\n\n(def path\n  \"The fixture file, relative to the repository root.\"\n  \"test/resources/yin/vm/ucf/rows-checkpoint-v3.txt\")\n\n\n(def max-exact rows/max-exact)\n\n(def occurrence s/occurrence)\n(def predecessor s/predecessor)\n(def origin s/origin)\n(def arbitration s/arbitration)\n(def op-id s/op-id)\n\n\n;; =============================================================================\n;; Accepted bases: real lifts\n;; =============================================================================\n\n(defn- lifted\n  [machine header]\n  (let [w (s/lift machine header)]\n    (when (contains? w :yin.k/status)\n      (throw (ex-info \"A fixture base failed to lift\" w)))\n    w))\n\n\n(def ^:private base-packs\n  (delay\n    {\"first-park\" (lifted (s/parked-reader) (s/header 0 nil #{}))\n     \"successor\" (lifted (s/with-op-id (s/parked-writer) :put (op-id 0)) (s/header 3 origin #{\"s0\"}))\n     ;; a root waiting on an install whose child is blocked on a write\n     ;; drawing id 4 from the root's sequence\n     \"installs\" (lifted (assoc-in (s/parked-installer) [:installs 'host.mod :vm]\n                                  (s/with-op-id (s/parked-writer) :put (op-id 4)))\n                        (s/header 6 origin #{\"s0\"}))\n     \"parked\" (lifted (s/parked-explicit) (s/header 1))\n     \"halted-root\" (lifted (s/halted-machine) (s/header 0 origin #{}))}))\n\n\n(def base-names [\"first-park\" \"successor\" \"installs\" \"parked\" \"halted-root\"])\n\n\n(defn base\n  \"The pack of accepted base n.\"\n  [n]\n  (get @base-packs n))\n\n\n;; =============================================================================\n;; Editing packs\n;; =============================================================================\n\n(defn edit-task\n  \"wire's root task through f, re-emitted: every changed row rehashed.\"\n  [wire f]\n  (rows/emit (f (rows/decode wire))))\n\n\n(defn edit-custody\n  \"wire with its root's custody slot through f.\"\n  [wire f]\n  (edit-task wire #(update-in % [:slots 16] f)))\n\n158:(defn child\n163:(defn update-child\n168:(defn segment-address\n174:(defn enc\n188:(defn- m\n193:(defn- custody-set\n198:(defn- custody-drop\n203:(defn- undecodable\n208:(defn- put-op\n214:(defn- child-put-op\n219:(defn- edit-op-id\n359:(defn pack-of\n380:(defn base-of\n386:(defn refusal\n397:(defn patch-non-canonical\n405:(defn- built-bytes\n411:(defn- built-address\n418:(defn render\n430:(defn read-file\n445:(defn fixture\n                   :expected-format format-tag,\n                   :expected-hash (:hash base),\n                   :images (:images base)})))\n\n\n(defn- return-transition\n  \"Deliver a result through the caller's frame, or halt when K is empty.\"\n  [vm val]\n  (if-let [frame (peek (:continuation vm))]\n    (assoc vm\n           :pc (:return-pc frame)\n           :frames (:frames frame)\n           :stack (conj (subvec (:stack vm) 0 (:stack-base frame)) val)\n           :continuation (pop (:continuation vm))\n           :store-of (:store-of frame))\n    (assoc vm :halted? true :stack [val] :value val :store-of nil)))\n\n\n(defn stack-restore\n  \"This machine's one restore function, `base entry val -> state`\n   (`yin.vm.engine.md` section 2.1; design section 4.1, item 4). `base` is\n   the state after the engine has done its part; `entry` is the wait, ready,\n   or parked record; `val` is the value the parked instruction receives.\n\n   It first refuses with a qualified `:continuation-format` outcome unless\n   the entry's `:format` is `:yin.debruijn.code` and its `:image` is a row\n   of the offset table (yin.vm.linker.md section 7.3, r6): a continuation\n   from the named VM, from the register kernel, or from an image this\n   kernel does not hold is never interpreted here. `:hash` is never a\n   restore key: it changes at every `attach-image`, while the table only\n   grows, so an entry parked before an attach still names its row.\n\n   Then the FFI two-step, on the entry keys the `yin.vm.ffi` convention\n   owns, in the semantic VM's placement:\n\n   - A `:request-sent` entry is a writer whose retained request has now been\n     appended. It must not resume: its registers are re-parked as the\n     call-out reader (`ffi/response-wait-entry`) and the machine stays\n     blocked.\n   - A `:call-id` entry is a response reader. The woken value is a response\n     envelope, so `ffi/call-result` unwraps it and checks correlation, and\n     the parked call leaves `:parked` rather than accumulating.\n\n   A `:return-result` entry delivers through the return transition.\n   Otherwise the registers are written from the entry and `val` is conjed\n   onto the restored `:stack` -- the B3 obligation that every\n   value-producing opcode lands on the stack, since there is no\n   accumulator. `:segment` is never written from the entry: the code space\n   is kernel state, and since appending moves nothing, the entry's\n   absolute pcs and stack bases still name what they named.\"\n  [base entry val]\n  (when-not (and (= format-tag (:format entry))\n                 (some #(= (:image entry) (nth % 0)) (:images base)))\n    (refuse-continuation! base entry))\n  (if (:request-sent entry)\n    (-> base\n        (update :wait-set (fnil conj [])\n                (ffi/response-wait-entry entry (:call-id entry)))\n        (assoc :value :yin/blocked\n               :blocked? true\n               :halted? false))\n    (let [call-id (:call-id entry)\n          base (if call-id (update base :parked dissoc call-id) base)\n          val (if call-id (ffi/call-result val call-id) val)\n          restored (assoc base\n                          :pc (:pc entry)\n                          :frames (:frames entry)\n                          :continuation (:continuation entry)\n                          :stack (vec (:stack entry))\n                          :store-of (:store-of entry)\n                          :value val\n                          :halted? false)]\n      (if (= :return-result (:resume-mode entry))\n        (return-transition restored val)\n        (assoc restored :stack (conj (:stack restored) val))))))\n\n28:   effects tier, connecting to `yin.vm.engine` via `register-restore` and\n172:   `register-restore` refuses it.\n353:                (assoc (select-keys opts [:modules :make-stream :call-in\n400:;; Return transitions & restore\n404:  \"Unified return transition: restores caller frame from continuation if\n406:   and continuation are restored (yin.vm.linker.md section 7.3, r7): a\n418:            restored-regs (reduce (fn [acc [r v]] (assoc acc r v))\n422:                         (assoc restored-regs dest val)\n423:                         restored-regs)]\n437:  (throw (ex-info \"Cannot restore a continuation of another model or image\"\n473:          restored-regs\n478:                       (assoc restored-regs dest val)\n479:                       restored-regs)]\n490:(defn register-restore\n491:  \"The register VM's restore function, `base entry val -> state`\n494:   r6; `:hash` is never a restore key, since it changes at every\n498:   `:return-result`. The entry restores registers only and never assigns\n723:          ;; captured ones restored with the argument in the capture's\n817:        (engine/resume-continuation vm (nth inst 1) val register-restore))\n832:   loop with this machine's step function and its restore bound into the\n   - *unknown*: a response for an id no entry holds is skipped;\n   - *abandoned*: a composition that gives up on a link removes the\n     entry, calls `abandon` on the linker side, and raises the reason to\n     the program as the effect's error; the id is retired.\n   Each skip emits a telemetry diagnostic and consumes nothing but the\n   cursor position. On a matching `:ok` the scheduler runs step 5b\n   against its live state and, if discharged, starts the install child\n   (section 7.3). On a matching refusal, or a failed discharge, the\n   program resumes with the refusal raised as the effect's error, the\n   same way an `:ffi` `error` raises. The bare `try-require` primitive\n   emits `:module/try-require` through the same linker seat. Its waiter\n   resumes with refusal or loss data instead of raising, and success\n   returns `{:status :ok :module name}`. Each waiter keeps its own return\n   contract, including co-waiters on one install. On `gap` the outcome is a\n   `gap`, and the composition's policy decides.\n\nRevision r1 claimed steps 3 to 7 needed no new engine machinery. That\nwas wrong in two places: the wait entry needs the two-state shape above,\nand installation needs the child task below. Park entries, kept cursors,\n`handle-stream-block`, and `check-wait-set` are reused; `:link-request`,\n`:link-response`, and the install child are new.\n\n### 7.3 Installing a module is a scheduler child task\n\nThe linker delivers a verified image with its obligations. Installing it\nis the scheduler's, as an explicit child evaluation with its own state:\n  (let [bindings (fn [mappings] (into {} (map (fn [[k v]] [k (portable-value m v)])) mappings))\n        env #(update % :yin.k/bindings bindings)]\n    (cond-> (update f :yin.k/k #(mapv (fn [k]\n                                        (-> k (update :yin.k/env env)\n                                            (update :yin.k/window bindings))) %))\n      (= :act (:yin.k/state f)) (update :yin.k/env env)\n      (= :act (:yin.k/state f)) (update :yin.k/window bindings)\n      (contains? f :yin.k/pending) (update :yin.k/pending #(case (:yin.k/reason %)\n                                                             :next (assoc % :yin.k/cursor-cell :test/cursor)\n                                                             :put (assoc % :yin.k/stream (rows/node :stream [:fixture/w :fixture/served])\n                                                                         :yin.k/value \"v\" :yin.k/op-id nil) %)))))\n\n\n(deftest bijection\n  (doseq [fixture (ft/reference-machines)\n          {:keys [frame]} (ft/reference-frames fixture)]\n    (let [f (portable-frame (:machine fixture) frame) wire (rows/frame->rows f encoded) back (rows/rows->frame wire)]\n      (is (= f back))\n      (is (= (:yin.k/root wire) (:yin.k/root (rows/frame->rows back encoded)))))))\n\n\n(deftest row-ids-are-jing-default\n  (let [wire (rows/emit (fixture :stream/a :stream/b :source/x :source/y))]\n    (is (seq (:yin.k/rows wire)))\n    (doseq [[id & body] (:yin.k/rows wire)]\n      (is (= id (jing/segment-key (vec body))))\n(ns yin.vm.semantic.frame-test\n  (:require [clojure.test :refer [deftest is testing]]\n            #?(:cljd nil :clj [clojure.java.io :as io])\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.semantic.linearize :as linearize]\n            [yin.vm.semantic.analysis :as analysis]\n            [yin.vm.semantic.frame :as frame]\n            [yin.vm.semantic.corpus :as corpus]\n            [yin.vm.semantic.parity-test :as parity]\n            [yin.vm.ucf.rows-support :as s]\n            [dao.stream :as stream]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]))\n\n\n(def task {:free-env {} :ffi-call-ids #{}})\n\n\n(defn canonical\n  \"Reshape evaluator payload; values remain opaque to the pure validator.\"\n  [m f pending?]\n  (let [address (fn [seg] (get-in m [:code seg :address]))\n        env (fn [e]\n              (cond-> {:yin.k/bindings (engine/without-store-of e)}\n                (some? (engine/env-store-of e)) (assoc :yin.k/store-of (engine/env-store-of e))))\n        act? (contains? f :pc)]\n    (cond-> {:yin.k/state (if act? :act :tail) :yin.k/segment (address (:segment f))\n             :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd (get-in f [:deliver :rd])}\n                                {:yin.k/deliver :return})\n             :yin.k/k (mapv (fn [k]\n                              {:yin.k/frame-type :return :yin.k/segment (address (:segment k))\n                               :yin.k/pc (:pc k) :yin.k/env (env (:env k))\n                               :yin.k/window (:window k) :yin.k/rd (:rd k)}) (or (:k f) []))}\n      act? (assoc :yin.k/pc (:pc f) :yin.k/env (env (:env f)) :yin.k/window (:window f))\n      (not act?) (assoc :yin.k/site (:site f))\n      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n\n\n(defn machine-code\n  [m]\n  (into {} (map (fn [[_ image]] [(:address image) (:vector image)])) (:code m)))\n\n\n(defn- cat-of\n  [p q]\n  (s/app (s/v 'cat) p q))\n\n\n(defn- with-cat\n  [ast]\n  (s/let1 'cat (s/lam ['p 'q] (s/app (s/v 'conj) (s/v 'p) (s/v 'q))) ast))\n\n\n(defn- nest\n  [depth op]\n  (if (zero? depth) op\n      (cat-of (s/lit [depth]) (s/app (s/lam ['x] (nest (dec depth) op)) (s/lit depth)))))\n24:  [m f pending?]\n39:      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n164:   :yin.k/pending {:yin.k/reason :next :yin.k/cursor-cell :test/cursor}})\n234:                (= :wait context) (assoc :yin.k/pending {:yin.k/reason :next}))\n268:                :yin.k/k [] :yin.k/deliver {:yin.k/deliver :return} :yin.k/pending {:yin.k/reason :next :yin.k/cursor-cell :test/cursor}}\n291:              [\"P1\" :pending-presence (dissoc worked-frame :yin.k/pending) worked-code :wait task]\n292:              [\"P2\" :reason-mismatch (assoc-in worked-frame [:yin.k/pending :yin.k/reason] :bogus) worked-code :wait task]\n293:              [\"P3\" :captured-site (dissoc worked-frame :yin.k/pending) worked-code :captured task]\n294:              [\"P4\" :parked-site (dissoc tail-f :yin.k/pending) tail-c :parked task]]]\n311:    (is (nil? (kind (dissoc park-f :yin.k/pending) park-c :parked task)))\n312:    (is (nil? (kind (dissoc cc-f :yin.k/pending) cc-c :captured task)))\n318:                                 [\"P2 park\" :reason-mismatch park-f park-c]\n319:                                 [\"P2 current-continuation\" :reason-mismatch cc-f cc-c]]]\n326:        f (dissoc frame :yin.k/pending)]\n  [entry value]\n  (-> entry\n      (dissoc :envelope :request :response :cursor)\n      (assoc :value value)))\n\n\n(defn- refused-entry\n  \"Resume a try waiter with outcome data; plain require raises at resume.\"\n  [entry refusal]\n  (if (:try? entry)\n    (ready entry (cond-> refusal\n                   (= :refused (:status refusal))\n                   (assoc :module (or (:module refusal) (:name entry)))\n                   (= :lost (:status refusal))\n                   (assoc :link-id (or (:link-id refusal) (:link-id entry)))))\n    (assoc (ready entry nil) :status :link-refused :refusal refusal)))\n\n\n(defn- linked-entry\n  \"Resume an installed module, respecting each waiter's return contract.\"\n  [entry module-name]\n  (ready entry (if (:try? entry)\n                 {:status :ok, :module module-name}\n                 module-name)))\n\n\n(defn- retire\n  \"Record link `id` as retired: a response for it is afterwards a\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1855,1885p' src/cljc/yin/vm/ucf/rows.cljc; rg -n 'frame/defect|frame-defect' src/cljc/yin/vm/ucf/rows.cljc; sed -n '945,975p' docs/design/yin.vm.universal-continuation-format.md; rg -n 'link-refused|:refused|try-require' test/yin/vm/linker_test.cljc | tail -20; rg -n 'drive-peers|defn satisfy|lift-opts' test/yin/vm/semantic/safepoint_harness_test.cljc | head\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1855,1885p' src/cljc/yin/vm/ucf/rows.cljc; rg -n 'frame/defect|frame-defect' src/cljc/yin/vm/ucf/rows.cljc; sed -n '945,975p' docs/design/yin.vm.universal-continuation-format.md; rg -n 'link-refused|:refused|try-require' test/yin/vm/linker_test.cljc | tail -20; rg -n 'drive-peers|defn satisfy|lift-opts' test/yin/vm/semantic/safepoint_harness_test.cljc | head\"","aggregated_output":"                     (= (:yin.ledger/input record) (:yin.module/tree manifest))\n                     (jing/segment-matches? (:yin.ledger/output record) (:value (:image response))))\n        (outcome! :yin.k/undecodable :install-image {:yin.k/name mn})))\n    (when-not (= :blocked child-kind)\n      (outcome! :yin.k/undecodable :install-child {:yin.k/name mn :yin.k/task-kind child-kind}))))\n\n\n(defn- check-pendings!\n  \"Step 8, pending and operations: role, kind, parked id, every :install\n   pending names a carried install, every install record.\"\n  [recv task role]\n  (let [[_ _ kind role' _ _ _ _ parked _ _ _ installs waits parked-id] (:slots task)]\n    (when-not (= role role') (outcome! :yin.k/undecodable :role {:yin.k/role role'}))\n    (let [names (into #{} (map #(first (:slots %))) installs)]\n      (doseq [w waits]\n        (let [[reason n] (:slots (second (:slots w)))]\n          (when (and (= :install reason) (not (contains? names n)))\n            (outcome! :yin.k/undecodable :incomplete-install {:yin.k/name n})))))\n    (case kind\n      :halted (when (seq waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :blocked (when (empty? waits) (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n      :parked (when-not (some #(= parked-id %) (take-nth 2 (:slots parked)))\n                (outcome! :yin.k/undecodable :parked-id {}))\n      (outcome! :yin.k/undecodable :kind {:yin.k/task-kind kind}))\n    (run! #(check-install! recv %) installs)))\n\n\n(defn- check-closure!\n  \"A closure row names a :closure tuple of its carried vector: the entry\n   (:closure-origin) and that tuple's binders (:closure-binders), as\n   lower-closure will demand.\"\n1041:   This reshapes; frame/defect owns semantic validity.\"\n1101:   Semantic code/context rules remain frame/defect's responsibility.\n1123:              (when-let [d (frame/defect (decode-frame n decoded-value) code-map context context-map)]\n\n;; module link, awaiting the correlated response (request appended ok)\n{:yin.k/reason    :link-response\n :yin.k/link-id   [:t0 7]\n :yin.k/response  {:dao.stream/identity ... :dao.stream/descriptor ...}\n :yin.k/cell      :yin.k/c-31}            ; the kept cursor cell, at its kept\n                                          ; position\n\n;; module install (a matching ok discharged; the child runs)\n{:yin.k/reason    :install\n :yin.k/name      'foo}\n```\n\nFour rules fix the exchange. The link id is the pair `[origin\ncounter]`, scoped to the link pair, not to a VM: several tasks share\none response stream, `origin` is a task origin tag the scheduler mints\nfrom its own counter and never reuses, and `counter` is the task's\nengine gensym, so no two requests on one pair share an id. The response\ncursor is minted `:dao.stream/newest` before the request is appended --\nthe `dao.stream.md` *Cursors* rule for observing events caused by an\noperation -- so a response that lands before the cursor exists is not\nskipped. `:link-request` carries everything needed to rebuild the\nenvelope, `:link-response` carries the response descriptor and the kept\ncursor cell; a `full` append keeps the request state, retains the envelope\nverbatim, and retries on the next poll, the `:ffi-request` discipline.\nAnd the poll restores only on exact correlation: the entry advances\npast every response whose `:yin.link/id` is not its own, keeping its\ncursor at the first unconsumed position -- the per-cursor-cell round-order\ndiscipline section 7.5.3 already gives shared cursors -- and skips\nduplicate, late, and unknown responses, each skip a telemetry\ndiagnostic that consumes nothing but the cursor position. A matching\n1136:        (is (= {:status :refused, :reason :hash-mismatch,\n1141:        (is (= {:status :refused, :reason :hash-mismatch,\n1155:    (is (= {:status :refused, :reason :hash-mismatch,\n1263:    (is (= {:status :refused, :reason :absent, :address child-id}\n1354:    (is (= {:status :refused, :reason :parts-limit, :bound :max-bytes,\n1379:    (is (= {:status :refused, :reason :parts-limit, :bound :max-bytes,\n1425:    (is (= {:status :refused, :reason :parts-limit, :bound :max-parts,\n1581:        (is (= {:status :refused, :reason :use-before-definition, :name 'x}\n1688:        (is (= {:status :refused, :reason :use-before-definition,\n1702:        (is (= {:status :refused, :reason :unresolved-free, :name 'x}\n1719:        (is (= {:status :refused, :reason :use-before-definition,\n1732:      (is (= {:status :refused, :reason :unresolved-free, :name 'x}\n1774:        (is (= {:status :refused, :reason :unresolved-free, :name 'x}\n1815:    (is (= {:status :refused, :reason :unresolved-free, :name 'nope}\n1819:    (is (= {:status :refused, :reason :shadowed-free, :name '+}\n1865:        (is (= {:status :refused, :reason :unresolved-free, :name 'nope}\n1872:        (is (= {:status :refused, :reason :unresolved-free, :name '+}\n1886:          (is (= {:status :refused, :reason :shadowed-free, :name '+}\n1932:    (is (= {:status :refused, :reason :absent, :root 'elsewhere}\n1955:      (is (= {:status :refused, :reason :pairing-mismatch, :root 'root,\n188:(defn lift-opts\n511:(defn drive-peers\n519:(defn satisfy\n559:        wire (rows/lift-task (:machine world) serve! (lift-opts))\n566:        relift (rows/lift-task recv (:serve! again) (lift-opts))\n568:        done (satisfy world recv #(drive-peers % [peer]))\n699:            wire (rows/lift-task (:machine world) serve! (lift-opts))\n73