de :k (mapv (fn [f]\n                   (let [a (address! ctx (:segment f))]\n                     (context! ctx a (:pc f) (:env f))\n                     (node :kframe [a (:pc f) (lift-env-node ctx (:env f))\n                                    (window-node ctx (:window f)) (:rd f)])))\n                 (or k []))))\n\n\n(defn- state-node\n  \"An evaluator payload (wait entry, parked record, reified payload) as\n   its :act or :tail row; engine fields are the pending's.\"\n  [ctx p]\n  (if (contains? p :site)\n    ;; a tail state resumes through its K: its own segment never runs again\n    (node :tail [(address! ctx (:segment p)) (:site p) (k-node ctx (:k p))])\n    (let [a (address! ctx (:segment p))]\n      (context! ctx a (:pc p) (:env p))\n      (node :act [a (:pc p) (lift-env-node ctx (:env p))\n                  (window-node ctx (:window p)) (k-node ctx (:k p)) (get-in p [:deliver :rd])]))))\n\n\n(defn- pending-node\n  \"The observed wait's pending (draft §5.3): the reason is the entry's,\n   never the site's static kind.\"\n  [ctx e]\n  (let [m (:m ctx)]\n    (case (:reason e)\n      :next (if (contains? e :call-id)\n              (node :pending [:ffi (cell-for! ctx (get-in e [:cursor-ref :id])) (:call-id e) (:op e)])\n              (node :pending [:next (cell-for! ctx (get-in e [:cursor-ref :id]))]))\n      :put (if (:request-sent e)\n             (let [carried? (and (:response-cursor e) (:response-stream e))\n                   cursor (if carried? (:response-cursor e) vm/call-out-cursor-key)\n                   response (if carried? (:response-stream e) vm/call-out-stream-key)]\n               (when-not (get (:resources m) cursor) (outcome! :yin.k/unsatisfied nil {}))\n               (node :pending [:ffi-request (:call-id e) (lift-value ctx (:datom e)) (stream-row! ctx (:stream-id e))\n                               (stream-row! ctx response) (cell-for! ctx cursor) (:op-id e)]))\n             (do (when-not (contains? e :datom) (outcome! :yin.k/non-portable :incomplete-write {}))\n                 (node :pending [:put (stream-row! ctx (:stream-id e)) (lift-value ctx (:datom e)) (:op-id e)])))\n      (:link-request :link-response)\n      (let [c (cell! ctx [(:response e) (:cursor e)] (:response e) (:cursor e))\n            base [(:reason e) (:link-id e) (:name e) (stream-row! ctx (:request e)) (stream-row! ctx (:response e)) c]]\n        (node :pending (if (= :link-request (:reason e)) (conj base (:envelope e) (:op-id e)) base)))\n      :install (do (when-not (contains? (:installs m) (:name e))\n                     (outcome! :yin.k/non-portable :incomplete-install {:yin.k/name (:name e)}))\n                   (node :pending [:install (:name e)]))\n      (outcome! :yin.k/non-portable :reason-mismatch {:yin.k/reason (:reason e)}))))\n\n\n(defn- store-node\n  [ctx s]\n            (entry\n              [w]\n              (let [[state pending] (:slots w)\n                    [reason & xs] (:slots pending)\n                    p (payload state)]\n                (case reason\n                  :next (assoc p :reason :next :stream-id (cell-stream (first xs))\n                               :cursor-ref {:type :cursor-ref :id (get cell-keys (first xs))})\n                  :ffi (let [[c call-id op] xs]\n                         (cond-> (assoc p :reason :next :stream-id (cell-stream c) :call-id call-id\n                                        :cursor-ref {:type :cursor-ref :id (get cell-keys c)})\n                           (some? op) (assoc :op op)))\n                  :put (let [[s v op-id] xs]\n                         (cond-> (assoc p :reason :put :stream-id (stream-key s) :datom (value v))\n                           (some? op-id) (assoc :op-id op-id)))\n                  :ffi-request (let [[call-id envelope req resp c op-id] xs\n                                     datom (value envelope)]\n                                 (cond-> (assoc p :reason :put :stream-id (stream-key req) :datom datom\n                                                :request-sent true :call-id call-id :op (apply2/request-op datom)\n                                                :response-cursor (get cell-keys c) :response-stream (stream-key resp))\n                                   (some? op-id) (assoc :op-id op-id)))\n                  (:link-request :link-response)\n                  (let [[link-id mn _ _ c envelope op-id] xs]\n                    (cond-> (assoc p :reason reason :link-id link-id :name mn\n                                   :request module/link-request-resource :response module/link-response-resource\n                                   :cursor (second (:slots (get bodies c))))\n                      (= :link-request reason) (assoc :envelope envelope)\n                      (some? op-id) (assoc :op-id op-id)))\n                  :install (assoc p :reason :install :name (first xs)))))]\n      (let [store' (reduce (fn [s [k v]] (engine/store-put s k (value v))) {} (partition 2 (:slots store)))\n            stores (into {} (map (fn [ms]\n                                   (let [[mid s] (:slots ms)]\n                                     [mid (into {} (map (fn [[k v]] [k (value v)])) (partition 2 (:slots s)))])))\n                         module-stores)\n            parked' (into {} (map (fn [[p _]] [p (parked-record p)])) parked-index)\n            entries (mapv entry waits)\n            link (some #(let [[reason _ _ req resp] (:slots (second (:slots %)))]\n                          (when (contains? #{:link-request :link-response} reason) [req resp]))\n                       waits)\n            [base installs'] (reduce (fn [[r acc] inst]\n                                       (let [[mn phase parent response child] (:slots inst)\n   link keys on a real entry (`module/link-request-resource` and\n   `module/link-response-resource`), resolved into `:resources`, and\n   the kept `:cursor` on the response stream\n   (`module/require-handler` mints it before the envelope is appended)\n   is the response cell -- a cell like any other, at its kept\n   position. Both pair markers travel, the engine's `:link-response`\n   entry retaining its `:request` beside the response side; the\n   envelope rides verbatim on the request-in-hand variant.\"\n  [serve! resources mint codec entry]\n  (let [reason (:reason entry)\n        resp-h (get resources (:response entry))\n        req-h (get resources (:request entry))\n        kept (:cursor entry)]\n    (if-let [cid (mint codec [(:response entry) kept] resp-h kept)]\n      (let [resp (lift-marker serve! resp-h)\n            req (lift-marker serve! req-h)]\n        (if (and resp req)\n          {:pending (cond-> {:yin.k/reason reason,\n                             :yin.k/link-id (:link-id entry),\n                             :yin.k/name (:name entry),\n                             :yin.k/request req,\n                             :yin.k/response resp,\n                             :yin.k/cell cid}\n                      (= :link-request reason)\n                      (assoc :yin.k/envelope (:envelope entry))),\n           :cell? true}\n          (unsatisfied (local-identity (or req-h resp-h)))))\n      (unsatisfied (local-identity resp-h)))))\n\n\n(defn- lift-one\n  \"One pending entry of S7.4.3, lifted into `{:pending data,\n   :cell? bool}` -- `:cell?` true when the variant names a cursor\n   cell, which is what puts `:dao.stream.remote/v1` in\n   `:yin.k/cursor-profiles` -- or an outcome carrying\n   `:yin.k/status`: `:yin.k/unsatisfied` when a stream cannot be\n   served or a kept cursor does not survive the codec round trip;\n   `:yin.k/undecodable`, naming the reason, when the entry is no\n   variant at all.\"\n  [serve! resources mint codec entry]\n  (case (:reason entry)\n    :next\n    (if (:call-id entry)\n      (lift-response-wait resources mint codec entry)\n      (lift-read resources mint codec entry))\n\n    :put\n    (if (:request-sent entry)\n      (lift-retained-request serve! resources mint codec entry)\n      (lift-write serve! resources entry))\n\n    :link-request (lift-link serve! resources mint codec entry)\n\n    :link-response (lift-link serve! resources mint codec entry)\n\n    :install\n    {:pending {:yin.k/reason :install, :yin.k/name (:name entry)}}\n\n    {:yin.k/status :yin.k/undecodable, :yin.k/reason (:reason entry)}))\n\n\n                            :datom envelope,\n                            :response-cursor\n                            (cell-keys (:yin.k/response-cell pending)),\n                            :response-stream resp})}\n            (unsatisfied resp-id))\n          (unsatisfied req-id))\n        (unsatisfied req-id)))\n\n    (:link-request :link-response)\n    (let [reason (:yin.k/reason pending)\n          cid (:yin.k/cell pending)\n          sid (streams (cell-identity cells cid))\n          req (streams (get-in pending [:yin.k/request\n                                        :dao.stream/identity]))]\n      (if (and sid req)\n        {:entry (merge ctx\n                       (cond-> {:reason reason,\n                                :link-id (:yin.k/link-id pending),\n                                :name (:yin.k/name pending),\n                                :request module/link-request-resource,\n                                :response module/link-response-resource,\n                                :cursor (:yin.k/position (get cells cid))}\n                         (= :link-request reason)\n                         (assoc :envelope (:yin.k/envelope pending))))}\n        (unsatisfied (cell-identity cells cid))))\n\n    :install\n    {:entry (merge ctx\n                   {:reason :install, :name (:yin.k/name pending)})}\n\n    {:yin.k/status :yin.k/undecodable,\n     :yin.k/reason (:yin.k/reason pending)}))\n\nI-6. Phase 8 cutover records (2026-10-15; slices 8d, 8f-1, 8f-3 and\nthe documentation slice 8g, per the phase-8 plan\n`collab/1792560000000-architect-phase8-plan.report.md`). Three facts\nthis history owes its reader.\n\nFirst, the old transport **sources** died in 8f-1, not 8d. 8d removed\nthe old-codec tests (16 files, 141 deftests) and fixtures; the sources\n`src/cljc/yin/vm/ucf/handoff.cljc` (3783 lines, codec versions 0-2,\n`export-task`/`resume-task`) and `src/cljc/yin/vm/ucf/checkpoint.cljc`\nwere retained past 8d only because one other-seat C4 test still called\n`handoff/export-task`, and were deleted in 8f-1 (Architect ruling R2/R3,\n`collab/1792050511876-architect-8f1-ruling.report.md`) together with\n`yin.vm.completion`. With them the version-0/1/2 wire bytes are\nunreadable in-tree by design; the row carrier of body version 3\n(`yin.vm.ucf-transport-tuples.md`) is the one carrier, and this\ndocument's version-0/1/2 entries are the published description of those\nhistorical contracts.\n\nAlso recorded here, so the fixture history is not silent: 8c regenerated\n`test/resources/yin/vm/ucf/rows-checkpoint-v3.txt` (a phase 7a/7b fixture) although\nthe plan expected it to stay. The only content difference is its `installs` base\npack: the install child carried a `{:yin.code/contract \"v3\"}` stamp and now carries\n`\"v4\"`, so three child segment addresses moved; no format keyword, lowering\nprofile, H, R or descriptor is in any pack. A moved for exactly the one fixture\nwhose child was still a v3 image (Architect final review of `srvm-phase8`).\n\nSecond, the `\"v3\"` canonicalizer and the stack-shaped safepoint halves\nof `yin.vm.ucf` died in 8f-3, un-ported (8f-1 ruling R2, deferred\nstep 4b; commit `7b8d2a93`): no producer\nof the v3 batch survived 8e, and the register machine's validator,\nsafepoint facts and frame validator live in `yin.vm.semantic.code`,\n`yin.vm.semantic` §4 and `yin.vm.semantic.frame`. `yin.vm.ucf` is now\nonly `code-address`; the `v2` stamp carrier this document's header\nnames (`ucf.cljc:38`) is gone with it, so this file is the authority\nfor the historical stamps. `\"v4\"` (`yin.vm.semantic.code/contract`) is\nthe one semantic execution contract.\n\nThird, the design document this history referred to as \"semantic.md\" is\ndeleted: at the 2026-10-15 cutover the frozen register-shaped design\ntook the file name `docs/design/yin.vm.semantic.md` (owner ruling Q6\n(c), phase-8 plan) and the stack-shaped v3 design (\"yin.vm.semantic on\ndao.stream -- linear executable datoms\", revisions 1-2, contracts\n`\"v2\"` then `\"v3\"`) was deleted. Its revision 1 (2026-09-18; status\ncorrected 2026-09-25) published `\"v2\"`; revision 2 (2026-09-25)\npublished `\"v3\"`, adding `:define` and the reserved name `yin/def`\n(the landed contract change is I-4 above). Its §1 stance was: everything\nis a stream, with instruction fetch inside a loaded segment deliberately\nexcepted; interpretation creates semantics; code and state are datoms;\neverything is a continuation. It enforced the six invariants: no hidden\nglobal state, implicit control flow, callbacks, shared mutable state,\nlayer collapsing or assumed graphs. This stance and the revision dates\nare preserved in the new document's [history block](./yin.vm.semantic.md#history). Citations of\nits sections (2.2 the segment, 2.4 the opcode table and contract\nindex, 2.6 well-formedness, 3.x the stack-machine semantics, 5.3 the\nflattening) are historical and resolve to this entry; the `\"v4\"`\nvector, validator and transitions are the renamed design's §§2-3.\n\n","exit_code":0,"status":"completed"}}
