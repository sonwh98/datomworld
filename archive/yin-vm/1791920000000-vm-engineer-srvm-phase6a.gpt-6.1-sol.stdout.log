{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"sed -n '45,100p' test/yin/vm/semantic_register/parity_test.cljc; sed -n '165,195p' src/cljc/yin/vm/ucf/handoff.cljc; sed -n '300,330p' test/yin/vm/ucf/lift_support.cljc; sed -n '56,107p' test/yin/vm/ucf/v2_support.cljc; rg -n 'defn payload|continuation\\\\?' src/cljc/yin/vm/values.cljc\"","aggregated_output":"                   (:vector (sr-linearize/project ast)) code/contract)))\n\n\n(defn walker-machine\n  [ast]\n  (walker/vm-load-rows (tu/create-vm) (vm/ast->semantic-bytecode ast) vm/ast-contract))\n\n\n(defn outcome\n  [machine]\n  (try (let [result (vm/run machine)]\n         {:value (trace-normalize (vm/value result)) :halted? (vm/halted? result)\n          :blocked? (vm/blocked? result) :store (trace-normalize (vm/store result))})\n       (catch #?(:cljd Object :clj Throwable :cljs :default) e\n         {:error (ex-message e)})))\n\n\n(defn then\n  [a b]\n  (corpus/app (corpus/lam '[ignored] b) a))\n\n\n;; Respelled from rule-r-test/definition-programs, which is private.\n(def definition-programs\n  [[\"define then read\" (then (corpus/def! 'x (corpus/lit 1))\n                             (corpus/def! 'y (corpus/app (corpus/v '+) (corpus/v 'x) (corpus/lit 1)))) 2 {'x 1 'y 2}]\n   [\"redefine x twice reads the second value\"\n    (then (corpus/def! 'x (corpus/lit 1)) (then (corpus/def! 'x (corpus/lit 2)) (corpus/v 'x))) 2 {'x 2}]\n   [\"a definition's value is its own value\" (corpus/def! 'z (corpus/lit 9)) 9 {'z 9}]\n   [\"a stored closure is called by name\"\n    (then (corpus/def! 'f (corpus/lam '[n] (corpus/app (corpus/v '*) (corpus/v 'n) (corpus/lit 2))))\n          (then (corpus/def! 'r (corpus/app (corpus/v 'f) (corpus/lit 5))) (corpus/v 'r))) 10 {'r 10}]\n   [\"the reserved symbol as a literal value is data\" (corpus/def! 'q (corpus/lit 'yin/def)) 'yin/def {'q 'yin/def}]])\n\n\n(deftest b0-values\n  (let [rows b0/corpus]\n    (is (= 26 (count rows)))\n    (doseq [[label ast expected] rows]\n      (testing label\n        (doseq [machine [(register-machine ast) (walker-machine ast)]]\n          (let [result (vm/run machine)]\n            (is (= (trace-normalize expected) (trace-normalize (vm/value result))))\n            (is (vm/halted? result))))))))\n\n\n(deftest corpus-outcomes\n  (let [rows corpus/programs]\n    (is (= 32 (count rows)))\n    (doseq [[label ast] rows]\n      (testing label (is (= (outcome (walker-machine ast)) (outcome (register-machine ast))))))))\n\n\n(deftest rule-r-definitions\n  (is (= 5 (count definition-programs)))\n  (doseq [[label ast expected slice] definition-programs]\n\n(defn- marker-for!\n  \"The UCF stream marker for the stream resource `id` of `vm`, minted\n   through the exporter's own table (`serve!`) once per resource: the\n   descriptor serve! answers, never a handle.  A resource id the\n   private table does not hold is a forged reference; `serve!` here is\n   the keyed form `(serve! id handle)` of `export-task`, so the answer\n   is retained under the resource id, never under the handle.  A stream the\n   table cannot serve is unsatisfied, naming the identity where one is\n   known.  Two resources of one identity mint two markers that name\n   the one identity -- the lower attaches per identity, once.  Under\n   the ordering scratch the marker is seeded by the resource id and\n   nothing is asked: a sort comparison serves no stream and mints no\n   identity, exactly as it mints no cell number.\"\n  [vm serve! found id]\n  (if (:ordering @found)\n    (or (get-in @found [:markers id])\n        (let [m {:yin.k/tag :yin.k/stream\n                 :dao.stream/identity id\n                 :dao.stream/descriptor {:yin.k/hint :ordering}}]\n          (swap! found assoc-in [:markers id] m)\n          m))\n    (let [handle (get (:resources vm) id)]\n      (if (nil? handle)\n        (non-portable! :forged-resource-reference {:yin.k/hint id})\n        (or (get-in @found [:markers id])\n            (if-let [marker (ucf.remote/lift-marker (partial serve! id)\n                                                    handle)]\n              (do (swap! found assoc-in [:markers id] marker) marker)\n              (unsatisfied! (local-identity handle))))))))\n\n        m0 (vm/run (load-ast (linking-machine request response)\n                             (then (app (v 'require) (lit 'host.mod))\n                                   (app (v 'host.mod/f)))))\n        entry (first (:wait-set m0))]\n    (stream/append! response\n                    (assoc (module-response)\n                           :yin.link/id (:link-id entry)))\n    (vm/run m0)))\n\n\n(defn parked-module-store-cursors\n  \"A real machine parked at an explicit park whose module store for\n   'host.mod holds two cursor references nothing else reaches, named by\n   a module closure in the task store -- the shape a lowered module\n   closure has, its environment naming the module whose store it runs\n   against -- so the module-store snapshot's walk is the first place\n   either cell is minted.\"\n  []\n  (let [m (vm/run (load-ast (new-machine)\n                            (let1 's {:type :stream/make, :buffer 4}\n                                  (then (def! 'mod (lit 1))\n                                        (app (lam ['p] {:type :vm/park})\n                                             (v 'mod))))))\n        {:keys [c1 c2 machine]} (fresh-cursors m)\n        seg (:segment (first (vals (:parked machine))))\n        clo (values/closure (:owner machine)\n                            {:type :closure, :params [], :entry 0,\n                             :segment seg,\n                             :env {engine/store-of-key 'host.mod}})]\n    (assoc machine\n           :store (assoc (:store machine) 'mod clo)\n(defn lit\n  [x]\n  {:type :literal, :value x})\n\n\n(defn v\n  [n]\n  {:type :variable, :name n})\n\n\n(defn lam\n  [params body]\n  {:type :lambda, :params params, :body body})\n\n\n(defn app\n  [f & args]\n  {:type :application, :operator f, :operands (vec args)})\n\n\n(defn def!\n  [k val]\n  (app (v 'yin/def) (lit k) val))\n\n\n(defn then\n  [a b]\n  (app (lam ['_] b) a))\n\n\n(defn cursor-of\n  [source]\n  {:type :stream/cursor, :source source})\n\n\n(defn next-of\n  [source]\n  {:type :stream/next, :source source})\n\n\n(defn let1\n  [param init body]\n  (app (lam [param] body) init))\n\n\n;; =============================================================================\n;; One machine builder per profile\n;; =============================================================================\n\n(def ^:private semantic-vector\n  (comp :vector linearize/lower-rows vm/ast->semantic-bytecode))\n\n6:   `continuation?` are type tests, so an ordinary map is always data,\n154:(defn continuation?\n163:  (or (closure? x) (continuation? x)))\n166:(defn payload\n202:        (continuation? x) :continuation\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > test/yin/vm/semantic_register/frame_test.cljc <<'EOF'\n(ns yin.vm.semantic-register.frame-test\n  (:require [clojure.test :refer [deftest is testing]]\n            #?(:cljd [clojure.string :as str]\n               :clj [clojure.java.io :as io])\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register :as sr]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.semantic-register.frame :as frame]\n            [yin.vm.semantic-register.corpus :as corpus]\n            [yin.vm.semantic-register.parity-test :as parity]\n            [yin.vm.ucf.v2-support :as s]\n            [yin.vm.ucf.lift-support :as support]\n            [dao.stream :as stream]))\n\n\n(def task {:free-env {} :ffi-call-ids #{}})\n\n\n(defn canonical\n  \\\"Reshape evaluator payload; values remain opaque to the pure validator.\\\"\n  [m f pending?]\n  (let [address (fn [seg] (get-in m [:code seg :address]))\n        env (fn [e] (cond-> {:yin.k/bindings (engine/without-store-of e)}\n                      (some? (engine/env-store-of e)) (assoc :yin.k/store-of (engine/env-store-of e))))\n        act? (contains? f :pc)]\n    (cond-> {:yin.k/state (if act? :act :tail) :yin.k/segment (address (:segment f))\n             :yin.k/deliver (if act? {:yin.k/deliver :rd :yin.k/rd (get-in f [:deliver :rd])}\n                               {:yin.k/deliver :return})\n             :yin.k/k (mapv (fn [k] {:yin.k/frame-type :return :yin.k/segment (address (:segment k))\n                                     :yin.k/pc (:pc k) :yin.k/env (env (:env k))\n                                     :yin.k/window (:window k) :yin.k/rd (:rd k)}) (or (:k f) []))}\n      act? (assoc :yin.k/pc (:pc f) :yin.k/env (env (:env f)) :yin.k/window (:window f))\n      (not act?) (assoc :yin.k/site (:site f))\n      pending? (assoc :yin.k/pending {:yin.k/reason (:reason f)}))))\n\n\n(defn machine-code [m]\n  (into {} (map (fn [[_ image]] [(:address image) (:vector image)])) (:code m)))\n\n\n(def wrappers\n  [[:bare identity]\n   [:operand #(s/app (s/v 'conj) (s/lit [:operand]) %)]\n   [:depth-3 (fn [op]\n               (reduce (fn [body n] (s/app (s/lam ['depth] (s/app (s/v 'conj) (s/lit [n]) body)) (s/lit n))) op [3 2 1]))]\n   [:captured #(s/let1 'k (s/lit :captured)\n                      (s/let1 'f (s/lam ['y] (s/app (s/v 'conj) (s/app (s/v 'conj) (s/lit []) (s/v 'k))\n                                                   (s/app (s/v 'conj) (s/lit []) %)))\n                              (s/app (s/v 'f) (s/lit :arg))))]])\n\n\n(defn- rows-program [n]\n  (let [read (s/next-of (s/v 'c)) capture {:type :vm/current-continuation}]\n    (case n\n      1 (s/let1 'a read (s/app (s/v 'conj) (s/app (s/v 'conj) (s/lit []) (s/v 'a)) read))\n      2 {:type :stream/put :target (s/v 'w) :val (s/lit \\\"v\\\")}\n      5 (s/app (s/v 'conj) (s/lit [:ordinary]) (s/app (s/v 'stream/next\"'!) (s/v '\"'c)))\n      6 (s/app (s/lam ['u] (assoc (s/app (s/v 'stream/next\"'!) (s/v '\"'c)) :tail? true)) (s/lit 0))\n      13 {:type :vm/park}\n      14 (s/let1 'k capture (s/app (s/v 'conj) (s/app (s/v 'conj) (s/lit []) (s/v 'k)) read))\n      15 (s/let1 'k capture {:type :if :test (s/app (s/v '=) (s/v 'k) (s/lit :second))\n                            :consequent (s/lit :done) :alternate (s/let1 'r read (s/app (s/v 'k) (s/lit :second)))})\n      16 (s/let1 'k1 capture (s/let1 'k2 capture (s/app (s/v 'conj) (s/app (s/v 'conj) (s/lit []) (s/v 'k1))\n                                                        (s/app (s/v 'conj) (s/lit []) (s/app (s/v 'conj) (s/lit []) read)))))\n      18 (s/app (s/lam ['p] {:type :vm/park}) (s/lit 1))\n      19 (s/lit 42)\n      21 (s/let1 'f (s/lam [] (s/v 'x)) (s/app (s/lam ['x] (s/app (s/v 'f) read)) (s/lit 1)))\n      22 (s/app (s/lam ['p 'q] (s/app (s/v 'conj) (s/app (s/v 'conj) (s/lit []) (s/v 'p)) (s/v 'q))) (s/lit nil) read))))\n\n\n(defn reference-machines []\n  (into\n    (mapv (fn [[n [label wrap]]]\n            (let [ring (s/ring 4) cursor (vm/mint-oldest ring :frame-test)\n                  w (support/one-slot-stream (str \\\"frame-\\\" n))\n                  _ (stream/append\"'! w :warmed)\n                  env (if (= n 21) {'\"'x 99 'y 7} {})\n                  m (parity/register-machine (wrap (rows-program n)) {:env env})\n                  [cr m] (engine/attach-cursor-resource m cursor)\n                  [wr m] (engine/attach-resource m w)\n                  m (assoc m :store {'c cr 'w wr})\n                  blocked (vm/run m)\n                  blocked (if (= n 1) (do (stream/append\"'! ring \"A\") (vm/run blocked)) blocked)]\n              {:row n :wrapper label :machine blocked :task (assoc task :free-env env)}))\n          (mapcat (fn [n] (mapv #(vector n %) wrappers)) [1 2 5 6 13 14 15 16 18 19 21 22]))\n    (let [ring (s/ring 4) cursor (vm/mint-oldest ring :frame-tail)\n          m (parity/register-machine (assoc (s/app (s/v '\"'stream/next\"'!) (s/v '\"'c)) :tail? true))\n          [cr m] (engine/attach-cursor-resource m cursor)]\n      [{:row 20 :wrapper :unwrapped :machine (vm/run (assoc m :store {'c cr})) :task task}]))))\n\n\n(defn reference-frames\n  \\\"Every wait, parked payload, and capture reachable through their values.\\\"\n  [{:keys [machine task] :as fixture}]\n  (let [out (atom []) code-map (machine-code machine)]\n    (letfn [(record [f context t]\n              (let [cf (canonical machine f (= :wait context))]\n                (swap\"'! out conj {:frame cf :code code-map :context context :task t :fixture (select-keys fixture [:row :wrapper])})\n                (walk (:env f)) (walk (:window f)) (walk (:k f))))\n            (walk [x]\n              (cond\n                (values/continuation? x) (record (values/payload x) :captured task)\n                (values/closure? x) (walk (:env (values/payload x)))\n                (map? x) (doseq [[k v] x] (walk k) (walk v))\n                (coll? x) (doseq [v x] (walk v))\n                :else nil))]\n      (doseq [f (:wait-set machine)] (record f :wait task))\n      (doseq [[p f] (:parked machine)] (record f :parked (assoc task :parked-key p)))\n      (walk (:value machine)) (walk (:store machine))\n      @out)))\n\n\n(def worked-vector (:vector (linearize/project (second (first (filter #(= :worked-example (first %)) corpus/programs))))))\n(def worked-address (vm/code-address worked-vector))\n(def worked-code {worked-address worked-vector})\n(def worked-frame\n  {:yin.k/state :act :yin.k/segment worked-address :yin.k/pc 4\n   :yin.k/env {:yin.k/bindings {}} :yin.k/window {1 :f}\n   :yin.k/deliver {:yin.k/deliver :rd :yin.k/rd 2} :yin.k/k []\n   :yin.k/pending {:yin.k/reason :next}})\n\n\n(deftest contract-is-pure\n  (is (nil? (frame/defect worked-frame worked-code :wait task)))\n  #?(:cljd nil\n     :clj (let [source (slurp (io/file \"src/cljc/yin/vm/semantic_register/frame.cljc\"))\n                ns-form (first (clojure.string/split source #\"'\"\\\\n\\\\n\\\"))]\n            (is (not (re-find #\\\"yin.vm.engine|yin.vm.semantic-register\\\\s+:|yin.vm.debruijn.(stack|register)\\\" ns-form))))))\n\n\n(deftest every-reference-frame-validates\n  (let [fixtures (reference-machines)]\n    (is (= 49 (count fixtures)))\n    (doseq [fixture fixtures]\n      (testing (pr-str (select-keys fixture [:row :wrapper]))\n        (let [frames (reference-frames fixture)]\n          (if (= 19 (:row fixture))\n            (is (= 42 (vm/value (:machine fixture))))\n            (is (seq frames)))\n          (doseq [{:keys [frame code context task]} frames]\n            (is (nil? (frame/defect frame code context task)))))))))\n\n\n(defn kind [f c context t] (:yin.k/kind (frame/defect f c context t)))\n\n\n(deftest worked-example-saved\n  (is (= #{1} (analysis/saved (analysis/analyze worked-vector) 4 2)))\n  (is (nil? (kind worked-frame worked-code :wait task)))\n  (is (= :window-self (kind (assoc worked-frame :yin.k/window {1 :f 2 :x}) worked-code :wait task)))\n  (is (= :window-missing (kind (assoc worked-frame :yin.k/window {}) worked-code :wait task)))\n  (is (= :window-extra (kind (assoc worked-frame :yin.k/window {1 :f 3 :x}) worked-code :wait task))))\n\n\n(deftest nil-valued-register-is-a-member\n  (let [fixture (first (filter #(and (= 22 (:row %)) (= :bare (:wrapper %))) (reference-machines)))\n        {:keys [frame code context task]} (first (reference-frames fixture))\n        nil-key (first (keep (fn [[k v]] (when (nil? v) k)) (:yin.k/window frame)))]\n    (is (some? nil-key))\n    (is (nil? (kind frame code context task)))\n    (is (= :window-missing (kind (update frame :yin.k/window dissoc nil-key) code context task)))))\n\n\n(deftest free-env-mismatch\n  (let [fixture (first (filter #(and (= 21 (:row %)) (= :bare (:wrapper %))) (reference-machines)))\n        {:keys [frame code context task]} (first (reference-frames fixture))]\n    (is (= 1 (get-in frame [:yin.k/env :yin.k/bindings 'x])))\n    (is (nil? (kind frame code context task)))\n    (doseq [env [{'x 99 'y 8} {'x 99}]]\n      (is (= :free-env-mismatch (kind frame code context (assoc task :free-env env)))))\n    (is (= :free-env-mismatch (kind (update-in frame [:yin.k/env :yin.k/bindings] dissoc 'x) code context task)))\n    (is (nil? (kind (assoc-in frame [:yin.k/env :yin.k/bindings 'x] 98) code context task)))\n    (is (= :reserved-name (:yin.k/kind (frame/task-defect {:free-env {'yin/def 1}}))))))\n\n\n(deftest first-defect-is-structural\n  (is (= :k-shape (kind (assoc worked-frame :yin.k/k [nil] :yin.k/window nil) worked-code :wait task))))\n\n\n(deftest each-rule-refuses-its-tamper\n  (let [ret {:yin.k/frame-type :return :yin.k/segment worked-address :yin.k/pc 4\n             :yin.k/env {:yin.k/bindings {}} :yin.k/window {1 :f} :yin.k/rd 2}\n        with-k (assoc worked-frame :yin.k/k [ret])\n        tail-v [[:var 1 'f] [:call 0 1 [] true] [:halt 0]]\n        tail-a (vm/code-address tail-v) tail-c {tail-a tail-v}\n        tail-f {:yin.k/state :tail :yin.k/segment tail-a :yin.k/site 1\n                :yin.k/k [] :yin.k/deliver {:yin.k/deliver :return} :yin.k/pending {:yin.k/reason :next}}\n        boundary-v [[:closure 0 [] 2] [:halt 0] [:current-continuation 0] [:return 0]]\n        boundary-a (vm/code-address boundary-v)\n        rows [[\\\"S1\\\" :frame-shape (assoc worked-frame :extra true) worked-code :wait task]\n              [\\\"S2\\\" :k-shape (assoc worked-frame :yin.k/k [nil]) worked-code :wait task]\n              [\\\"S3\\\" :window-representation (assoc worked-frame :yin.k/window {-1 nil}) worked-code :wait task]\n              [\\\"S4\\\" :env-shape (assoc worked-frame :yin.k/env {}) worked-code :wait task]\n              [\\\"C1\\\" :segment worked-frame {} :wait task]\n              [\\\"C2-kind\\\" :pc-kind (assoc worked-frame :yin.k/pc 4.5) worked-code :wait task]\n              [\\\"C2-bounds\\\" :pc-bounds (assoc worked-frame :yin.k/pc 99) worked-code :wait task]\n              [\\\"C3\\\" :pc-body (assoc worked-frame :yin.k/segment boundary-a :yin.k/pc 2) {boundary-a boundary-v} :wait task]\n              [\\\"A1\\\" :site (assoc worked-frame :yin.k/pc 3) worked-code :wait task]\n              [\\\"A2\\\" :destination (assoc-in worked-frame [:yin.k/deliver :yin.k/rd] 0) worked-code :wait task]\n              [\\\"A3\\\" :window-scope (assoc-in worked-frame [:yin.k/window 99] nil) worked-code :wait task]\n              [\\\"A4\\\" :window-self (assoc-in worked-frame [:yin.k/window 2] nil) worked-code :wait task]\n              [\\\"A5\\\" :window-extra (assoc-in worked-frame [:yin.k/window 3] nil) worked-code :wait task]\n              [\\\"A6\\\" :window-missing (assoc worked-frame :yin.k/window {}) worked-code :wait task]\n              [\\\"T1\\\" :site (assoc tail-f :yin.k/site 0) tail-c :wait task]\n              [\\\"K1\\\" :return-site (assoc-in with-k [:yin.k/k 0 :yin.k/pc] 3) worked-code :wait task]\n              [\\\"K2\\\" :return-destination (assoc-in with-k [:yin.k/k 0 :yin.k/rd] 0) worked-code :wait task]\n              [\\\"K3\\\" :return-window-missing (assoc-in with-k [:yin.k/k 0 :yin.k/window] {}) worked-code :wait task]\n              [\\\"E1\\\" :reserved-name (assoc-in worked-frame [:yin.k/env :yin.k/bindings 'yin/def] nil) worked-code :wait task]\n              [\\\"E2\\\" :free-env-mismatch (assoc-in worked-frame [:yin.k/env :yin.k/bindings 'x] nil) worked-code :wait task]\n              [\\\"P1\\\" :pending-presence (dissoc worked-frame :yin.k/pending) worked-code :wait task]\n              [\\\"P2\\\" :reason-mismatch (assoc-in worked-frame [:yin.k/pending :yin.k/reason] :bogus) worked-code :wait task]\n              [\\\"P3\\\" :captured-site (dissoc worked-frame :yin.k/pending) worked-code :captured task]\n              [\\\"P4\\\" :parked-site (dissoc tail-f :yin.k/pending) tail-c :parked task]]]\n    (is (= 24 (count rows)))\n    (doseq [[rule expected f c ctx t] rows]\n      (testing rule\n        (let [d (frame/defect f c ctx t)]\n          (is (= expected (:yin.k/kind d))) (is (vector? (:yin.k/path d))))))\n    (is (= :free-env-shape (:yin.k/kind (frame/task-defect {:free-env {1 nil}})))))\n\n\n(deftest tail-bookkeeping-and-delivery\n  (let [fixture (last (reference-machines)) {:keys [frame code]} (first (reference-frames fixture))\n        f (dissoc frame :yin.k/pending)]\n    (is (= [] (:yin.k/k frame)))\n    (is (nil? (kind f code :parked (assoc task :parked-key :call :ffi-call-ids #{:call}))))\n    (is (= :parked-site (kind f code :parked (assoc task :parked-key :other :ffi-call-ids #{:call}))))\n    (is (= :deliver (kind (assoc frame :yin.k/deliver {:yin.k/deliver :rd :yin.k/rd 0}) code :wait task)))))\nEOF\n# Correct address helper to Jing, the existing vm namespace has no code