{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"clojure -Sdeps '{:aliases {:t {:extra-paths [\\\"test\\\"]}}}' -M:t -e '(require (quote [yang.python.antlr.linked-harness :as h]) (quote [dao.jing :as jing])) (doseq [[label pub] [[:py @h/published] [:pysp @h/published-pysp]]] (let [manifest (jing/get (:store pub) (:address pub) nil)] (assert (= (:address pub) (jing/segment-key manifest))) (prn [label (:address pub)]) (spit (str \\\"target/8ab-fix2/\\\" (name label) \\\"-manifest.edn\\\") (pr-str manifest))))' > target/8ab-fix2/live-manifests.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
