{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"sed -n '260,307p' test/yin/vm/ucf/rows_support.cljc; tail -8 /tmp/module-pins-r2d-focused-unrestricted.log; rg -n '\"'^FAIL|''^ERROR'\"' /tmp/module-pins-r2d-focused-unrestricted.log | head; sed -n '38,65p' test/yin/vm/ucf/ledger_fixtures.cljc; rg -n 'def r |def s1|def x' test/yin/vm/ucf/ledger_fixtures.cljc\"","aggregated_output":"                    (let1 's {:type :stream/make :buffer 4}\n                          (app (lam ['c] {:type :vm/park}) (cursor-of (v 's)))))))\n\n\n(defn parked-linker\n  \"Parked on a link request under the :running gate, so the entry carries\n   no :cursor: the lift refuses it (:link-cursor-not-installed).\"\n  []\n  (vm/run (-> (new-machine {:link-request (ring 8) :link-response (ring 8)})\n              (load-ast (app (v 'require) (lit 'host.mod)))\n              (assoc :yin.k/gate :running))))\n\n\n(defn linked-response\n  \"A link response as the linker answers one (yin.vm.linker/link-manifest):\n   the image of ast, the manifest naming its tree and its :yin.semantic/code\n   derivation record, and that record, from the tree to the image's A. The\n   lower checks that chain (rows/check-install!, continuation §11 Q3).\"\n  [ast module-name exports]\n  (let [image (project ast)\n        tree (jing/segment-key [:yin/tree ast])\n        record (ledger/derive-record tree (jing/segment-key image))]\n    {:status :ok\n     :image {:value image}\n     :manifest {:yin.module/name module-name :yin.module/exports exports\n                :yin.module/tree tree\n                :yin.module/derivations {:yin.semantic/code (jing/segment-key record)}}\n     :derivation record\n     :obligations []}))\n\n\n(defn module-response\n  []\n  (linked-response (let1 's {:type :stream/make :buffer 4}\n                         (then (next-of (cursor-of (v 's))) (def! 'f (lam [] (lit 42)))))\n                   'host.mod #{'f}))\n\n\n(def installer-lower-opts\n  \"Receiver admission for the composition's fixed module-response fixture;\n   never derived from a received pack.\"\n  {:yin.k/admitted-modules {'host.mod (jing/segment-key (:manifest (module-response)))}})\n\n\n(defn parked-installer\n  \"Parked at :install with a live child blocked on its own read.\"\n  []\n  (let [request (ring 64) response (ring 64)\n\nTesting yin.vm.semantic.frame-test\n\nTesting yin.vm.semantic.layout-test\n\nTesting yin.vm.semantic.safepoint-harness-test\n\nTesting yin.vm.ucf.holder.driver-test\n  \"The fixture file, relative to the repository root.\"\n  \"test/resources/yin/vm/ucf/ledger-v2.txt\")\n\n\n(def arb \"arb-c12\")\n\n(def duration {:s 30})\n\n\n;; The root, its continuation successor and a stranger occurrence.\n(def r \"0c000000-0000-4000-8000-000000000001\")\n\n(def s1 \"0c000000-0000-4000-8000-000000000002\")\n\n(def x \"0c000000-0000-4000-8000-000000000004\")\n\n\n;; =============================================================================\n;; World: the requests a holder and the composition make\n;; =============================================================================\n\n(defn header-frame\n  \"The journal header frame naming identity `i`.\"\n  ([] (header-frame arb))\n  ([i]\n   (cbor/encode {:dao.stream.journal/header {:version 1 :identity i}})))\n\n\n48:(def r \"0c000000-0000-4000-8000-000000000001\")\n50:(def s1 \"0c000000-0000-4000-8000-000000000002\")\n52:(def x \"0c000000-0000-4000-8000-000000000004\")\n","exit_code":0,"status":"completed"}}
