{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/module-pins-r2d-edit.py <<'PY'\nfrom pathlib import Path\np=Path('src/cljc/yin/vm/ucf/rows.cljc')\ns=p.read_text().replace('        installing (installing-names m)','        pins (atom {:yin.k/modules {} :yin.k/host-exports {}})\\\\n        installing (installing-names m)',1)\na=s.index('                                (and (some? (namespace sym))',s.index('(defn- discharge\"'!'\"'))\nb=s.index('        scanned ',a)\ns=s[:a]+'''                                (when (some? (namespace sym))\n                                  (when (some? (module/resolve-module (:modules m)\n                                                                    (symbol (str (namespace sym) \\\".\\\" (name sym)))))\n                                    (let [mn (symbol (namespace sym))\n                                          entry (module/resolve-module (:modules m) mn)\n                                          address (:address entry)]\n                                      (swap\"'! pins assoc-in [:yin.k/modules mn] address)\n                                      (when (nil? address)\n                                        (let [profile (module/host-export-profile (:modules m) sym)]\n                                          (when (nil? profile)\n                                            (outcome! :yin.k/non-portable :host-export-profile {:yin.k/name sym}))\n                                          (swap! pins assoc-in [:yin.k/host-exports sym] profile)))\n                                      true))))))))\n'\"'''+s[b:]\ns=s.replace(':yin.k/missing {:obligations missing}}))))',':yin.k/missing {:obligations missing}}))\\\\n    @pins))',1)\ns=s.replace('_ (discharge\"'! ctx code)'\"','pins (discharge\"'! ctx code)'\"',1).replace('requires {:yin.k/cursor-profiles','requires (merge pins {:yin.k/cursor-profiles',1).replace(':yin.k/trees (select-keys index segments)}',':yin.k/trees (select-keys index segments)})',1)\na=s.index('(defn- check-install-admission\"'!'\"');b=s.index('(defn- check-closure\"'!'\"',a)\ns=s[:a]+'''(defn- check-modules\"'!\n  \"Check every task'\"'s binding pins and collect every missing prerequisite.\n   Terminal skew wins over discovery; no stream is attached by this check.\\\"\n  [recv task opts]\n  (let [missing (atom {})]\n    (doseq [[t _] (task-tree task :root)]\n      (let [requires (nth (:slots t) 10)]\n        (doseq [[mn address] (sort-by #(str (key %)) (:yin.k/modules requires))]\n          (if-some [entry (module/resolve-module (:modules recv) mn)]\n            (when-not (= address (:address entry))\n              (outcome\"'! :yin.k/unsatisfied :module-pin-mismatch\n                        {:yin.k/name mn :yin.k/pinned address :yin.k/linked (:address entry)}))\n            (swap! missing assoc-in [:yin.k/modules mn] address)))\n        (doseq [[sym profile] (sort-by #(str (key %)) (:yin.k/host-exports requires))]\n          (if-some [held (module/host-export-profile (:modules recv) sym)]\n            (when-not (= profile held)\n              (outcome! :yin.k/unsatisfied :host-export-mismatch\n                        {:yin.k/name sym :yin.k/pinned profile :yin.k/held held}))\n            (swap! missing assoc-in [:yin.k/host-exports sym] profile))))\n      (doseq [inst (nth (:slots t) 12)]\n        (let [[mn _ _ response] (:slots inst)\n              address (jing/segment-key (:manifest response))]\n          (when-not (= address (get (:yin.k/admitted-modules opts) mn))\n            (swap! missing assoc-in [:yin.k/modules mn] address)))))\n    (when (seq @missing)\n      (outcome! :yin.k/unsatisfied nil\n                {:yin.k/discovery :complete :yin.k/missing @missing}))))\n\n\n(defn- pin-map?\n  [pins qualified? value?]\n  (and (map? pins)\n       (every? (fn [[k v]]\n                 (and (symbol? k) (= qualified? (some? (namespace k))) (value? v)))\n               pins)\n       ;; Rebuilding symbol keys must preserve cardinality on every host.\n       (= (count pins) (count (into {} (map (fn [[k v]] [(symbol (str k)) v])) pins)))))\n\n\n'\"'''+s[b:]\ns=s.replace('(and (map? requires) (= (set (:yin.k/segments requires)) (set (keys code))))','''(and (map? requires)\n                   (pin-map? (:yin.k/modules requires) false #(or (nil? %) (keyword? %)))\n                   (pin-map? (:yin.k/host-exports requires) true keyword?)\n                   (= (set (:yin.k/segments requires)) (set (keys code))))''',1)\ns=s.replace('       (doseq [[t _] (task-tree task :root)]\\\\n         (check-install-admission\"'! t opts))'\"','       (check-modules\"'! recv task opts)'\"',1)\np.write_text(s)\n# Correct the saved draft's representation and helper issues.\np=Path('test/yin/vm/ucf/rows_test.cljc');s=p.read_text().replace('\\\"linked\\\") wire)',':linked) wire)').replace(\\\"{'root.mod \\\\\\\"root\\\\\\\"}\\\",\\\"{'root.mod :root}\\\").replace(\\\"{'root.mod \\\\\\\"root\\\\\\\" 'host.mod address}\\\",\\\"{'root.mod :root 'host.mod address}\\\")\n# Use the ordinary core registry as well as this host module, since the program uses streams.\ns=s.replace(\\\"(module/register-host-module (module/empty-registry) 'host.mod\\\",\\\"(module/register-host-module (:modules (support/new-machine)) 'host.mod\\\")\ns=s.replace('(support/load-ast\\\\n            (assoc (support/new-machine) :modules registry)\\\\n            (support/then','(support/load-ast\\\\n            (support/then').replace(\\\"(support/app (support/v 'host.mod/f))))))\\\",\\\"(support/app (support/v 'host.mod/f)))\\\\n            (assoc (support/new-machine) :modules registry))))\\\")\np.write_text(s)\np=Path('test/yin/vm/malformed_rows.cljc');s=p.read_text().replace(\\\"{'host.mod :wrong}\\\",\\\"{'host.mod \\\\\\\"wrong\\\\\\\"}\\\");p.write_text(s)\nPY\npython3 /tmp/module-pins-r2d-edit.py\nclojure -M:test -e :slow -n yin.vm.ucf.rows-test -n yin.vm.malformed-rows > /tmp/module-pins-r2d-initial.log 2>&1\"",