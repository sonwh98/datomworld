pin-lower-refusal\n  [registry wire]\n  (let [{:keys [attach! count]} (support/attacher)\n        refusal (error #(rows/lower-task (assoc (support/new-machine) :modules registry) wire attach!))]\n    (is (zero? @count) \"every refusal precedes the first attach\")\n    refusal))\n\n\n(deftest lift-pins-only-registry-answered-live-names\n  (let [registry (pin-registry)\n        machine (pin-machine registry)\n        wire (support/lift machine nil)\n        profile (:yin.k/profile pin-profile)]\n    (is (= {'host.mod nil} (:yin.k/modules (pin-requires wire))))\n    (is (= {'host.mod/f profile} (:yin.k/host-exports (pin-requires wire))))\n    (doseq [m [(update-in machine [:wait-set 0 :env] assoc 'host.mod/f 42)\n               (assoc-in machine [:store 'host.mod/f] 42)\n               (-> machine\n                   (assoc-in [:wait-set 0 :env engine/store-of-key] 'context)\n                   (assoc :module-stores {'context {'host.mod/f 42}}))\n               (assoc-in machine [:primitives 'host.mod/f]\n                         (assoc pin-profile :yin.k/function (fn [] 42)))]]\n      (let [r (pin-requires (support/lift m nil))]\n\n\n(def ^:private fixtures*\n  (delay\n    (into @base-packs\n          (map (fn [{:keys [name base f]}] [name (f (get @base-packs base))]))\n          mutations)))\n\n\n(defn pack-of\n  \"Fixture n's pack (for hash-mismatch and non-canonical, the pack whose\n   bytes they change).\"\n  [n]\n  (get @fixtures* n))\n\n\n(def fixture-names\n  (into base-names (map :name) mutations))\n\n\n(def anchors\n  \"The fixtures whose full bytes the file keeps.\"\n  #{\"first-park\" \"successor\" \"installs\"})\n\n\n(def accepted\n  #{\"first-park\" \"successor\" \"installs\" \"parked\" \"halted-root\" \"variant-equal\" \"variant-other-root\"\n    \"variant-different-intent\" \"variant-counter\" \"counter-at-bound\"})\n\n\n(defn base-of\n  \"The base fixture n mutates, or nil for a base.\"\n  [n]\n  (:base (first (filter #(= n (:name %)) mutations))))\n\n