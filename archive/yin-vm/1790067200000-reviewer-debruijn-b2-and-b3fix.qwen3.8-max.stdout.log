{"type":"event","event":{"type":"tool_completed","toolCallId":"call_3af075293fa64d75bac29bbc","toolName":"read_file","result":[{"type":"text","text":"Read 1/1 file, 321 lines\n1: (ns yin.vm.debruijn.stack-test\n2:   \"B3 (docs/design/yin.vm.debruijn.stack.md, 'B3: de Bruijn VM kernel'):\n3:    completion tests for `yin.vm.debruijn.stack`.\n4: \n5:    Every program here is a hand-built instruction vector: B2 (the\n6:    named-datom lowerer) does not exist yet, so nothing here requires\n7:    `yin.vm.debruijn-code` or a real lowering pass. Parity fixtures pair a\n8:    hand-lowered instruction vector with the equivalent named AST, run each\n9:    through its own VM (a fresh instance every time -- D4, the named VM's\n10:    environment leak, is sidestepped by construction, never reused), and\n11:    compare under B0's normalizer (`yin.vm.debruijn-vm-contract-test/normalize`),\n12:    reused rather than reimplemented.\"\n13:   (:require [clojure.test :refer [deftest is testing]]\n14:             [yin.vm :as v2]\n15:             [yin.vm.debruijn.stack :as dvm]\n16:             [yin.vm.debruijn-vm-contract-test :as b0]\n17:             [yin.vm.test-utils :as tu]))\n18: \n19: \n20: ;; =============================================================================\n21: ;; Helpers\n22: ;; =============================================================================\n23: \n24: (defn- named-value\n25:   \"Run `ast` on a fresh named VM and return its normalized value.\"\n26:   [ast]\n27:   (b0/normalize (v2/value (v2/eval (tu/create-vm) ast))))\n28: \n29: \n30: (defn- debruijn-value\n31:   \"Run `segment` on a fresh de Bruijn VM (with the standard primitive\n32:    registry, matching the named VM's own default -- `yin.vm/empty-state`)\n33:    and return its normalized value.\"\n34:   ([segment] (debruijn-value segment {}))\n35:   ([segment opts]\n36:    (b0/normalize\n37:      (v2/value (v2/run (dvm/create-vm segment\n38:                                       (merge {:primitives v2/primitives}\n39:                                              opts)))))))\n40: \n41: \n42: (defn- lit\n43:   [v]\n44:   {:type :literal, :value v})\n45: \n46: \n47: (defn- variable\n48:   [n]\n49:   {:type :variable, :name n})\n50: \n51: \n52: (defn- lambda\n53:   [params body]\n54:   {:type :lambda, :params params, :body body})\n55: \n56: \n57: (defn- app\n58:   [f & args]\n59:   {:type :application, :operator f, :operands (vec args)})\n60: \n61: \n62: ;; =============================================================================\n63: ;; 1. Literals\n64: ;; =============================================================================\n65: \n66: (deftest literal-test\n67:   (testing \"a bare :const, no locals, no calls\"\n68:     (is (= (named-value (lit 42))\n69:            (debruijn-value [[:const 42] [:halt]])\n70:            42))))\n71: \n72: \n73: ;; =============================================================================\n74: ;; 2. Variable loads: bound\n75: ;; =============================================================================\n76: \n77: (deftest load-bound-identity-test\n78:   (testing \"a one-arg closure returning its own argument -- depth 0,\n79:             position 0, the innermost frame\"\n80:     (let [ast (app (lambda '[x] (variable 'x)) (lit 42))\n81:           segment [[:closure 1 4]  ; 0: closure, body at pc 4\n82:                    [:const 42]     ; 1\n83:                    [:call 1 false] ; 2\n84:                    [:halt]         ; 3\n85:                    [:load-bound 0 0]  ; 4: body\n86:                    [:return]]         ; 5\n87:           result (debruijn-value segment)]\n88:       (is (= 42 result))\n89:       (is (= (named-value ast) result)))))\n90: \n91: \n92: ;; =============================================================================\n93: ;; 3. Variable loads: free, via primitives -- and :call applying a\n94: ;;    resolved primitive host function\n95: ;; =============================================================================\n96: \n97: (deftest load-free-primitive-test\n98:   (testing \"(+ 3 4) via :load-free '+ resolved through the primitive\n99:             registry, then :call applying the resolved host function\"\n100:     (let [ast (app (variable '+) (lit 3) (lit 4))\n101:           segment [[:load-free '+]   ; 0\n102:                    [:const 3]        ; 1\n103:                    [:const 4]        ; 2\n104:                    [:call 2 false]   ; 3\n105:                    [:halt]]          ; 4\n106:           result (debruijn-value segment)]\n107:       (is (= 7 result))\n108:       (is (= (named-value ast) result)))))\n109: \n110: \n111: (deftest load-free-store-fallback-test\n112:   (testing \"a free name absent from primitives and free-env resolves\n113:             through the store -- the same env -> store -> primitives ->\n114:             module registry order `yin.vm.engine/resolve-var` already\n115:             implements for the named VM; positional locals never take this\n116:             path, only :load-free does\"\n117:     (let [segment [[:load-free 'y] [:halt]]\n118:           result (debruijn-value segment {:store {'y 55}})]\n119:       (is (= 55 result)))))\n120: \n121: \n122: ;; =============================================================================\n123: ;; 4. Closures: nested capture, multiple arities, under/over-arity calls\n124: ;; =============================================================================\n125: \n126: (deftest nested-closure-capture-test\n127:   (testing \"((fn [x] (fn [y] (- x y))) 3) 4) -- the inner closure's body\n128:             reaches the outer frame at depth 1. `-` (non-commutative) is\n129:             deliberate: a flipped-direction addressing bug would compute\n130:             (- y x) = 1 instead of (- x y) = -1, so this pins the\n131:             innermost-frame-is-last convention, not merely a result\"\n132:     (let [ast (app\n133:                 (app (lambda '[x] (lambda '[y] (app (variable '-)\n134:                                                     (variable 'x)\n135:                                                     (variable 'y))))\n136:                      (lit 3))\n137:                 (lit 4))\n138:           segment [[:closure 1 6]   ; 0: outer closure, body at 6\n139:                    [:const 3]       ; 1\n140:                    [:call 1 false]  ; 2: apply outer(3) -> inner closure\n141:                    [:const 4]       ; 3\n142:                    [:call 1 false]  ; 4: apply inner(4) -> -1\n143:                    [:halt]          ; 5\n144:                    [:closure 1 8]   ; 6: inner closure, body at 8\n145:                    [:return]        ; 7\n146:                    [:load-free '-]     ; 8: body of inner\n147:                    [:load-bound 1 0]   ; 9: x, outer frame\n148:                    [:load-bound 0 0]   ; 10: y, inner frame\n149:                    [:call 2 false]     ; 11\n150:                    [:return]]          ; 12\n151:           result (debruijn-value segment)]\n152:       (is (= -1 result))\n153:       (is (= (named-value ast) result)))))\n154: \n155: \n156: (deftest zero-arity-closure-test\n157:   (testing \"a thunk -- multiple arities coverage, arity 0\"\n158:     (let [ast (app (lambda [] (lit 99)))\n159:           segment [[:closure 0 3]   ; 0\n160:                    [:call 0 false]  ; 1\n161:                    [:halt]          ; 2\n162:                    [:const 99]      ; 3: body\n163:                    [:return]]       ; 4\n164:           result (debruijn-value segment)]\n165:       (is (= 99 result))\n166:       (is (= (named-value ast) result)))))\n167: \n168: \n169: (defn- conj-pair-ast\n170:   \"(fn [a b] (conj (conj [] a) b)) -- named AST for the two-arg closure the\n171:    under/over-arity tests below apply.\"\n172:   []\n173:   (lambda '[a b]\n174:           (app (variable 'conj)\n175:                (app (variable 'conj) (lit []) (variable 'a))\n176:                (variable 'b))))\n177: \n178: \n179: (defn- conj-pair-segment\n180:   \"The de Bruijn body for `conj-pair-ast`, laid out starting at `body-pc`\n181:    in the caller's comments (the body has no internal jump/branch targets,\n182:    so its absolute position does not affect these instructions themselves;\n183:    `body-pc` documents the intended placement at each call site rather\n184:    than being used to compute anything here): push the outer operator,\n185:    then the inner application (its own operator, [], a, call), then b,\n186:    then the outer call and return -- 'applications evaluate operator then\n187:    operands' (section 3), applied recursively.\"\n188:   [_body-pc]\n189:   [[:load-free 'conj]       ; body-pc + 0: outer operator\n190:    [:load-free 'conj]       ; body-pc + 1: inner operator\n191:    [:const []]               ; body-pc + 2\n192:    [:load-bound 0 0]         ; body-pc + 3: a\n193:    [:call 2 false]           ; body-pc + 4: conj([], a)\n194:    [:load-bound 0 1]         ; body-pc + 5: b\n195:    [:call 2 false]           ; body-pc + 6: conj(r1, b)\n196:    [:return]])                ; body-pc + 7\n197: \n198: \n199: (deftest under-arity-call-nil-fills-test\n200:   (testing \"a 2-arity closure called with 1 argument nil-fills the missing\n201:             parameter, matching engine/bind-params' zip-and-nil-fill rule\"\n202:     (let [ast (app (conj-pair-ast) (lit 1))\n203:           segment (into [[:closure 2 4]   ; 0: closure, body at 4\n204:                          [:const 1]        ; 1\n205:                          [:call 1 false]   ; 2: only 1 arg for arity 2\n206:                          [:halt]]          ; 3\n207:                         (conj-pair-segment 4))\n208:           result (debruijn-value segment)]\n209:       (is (= [1 nil] result))\n210:       (is (= (named-value ast) result)))))\n211: \n212: \n213: (deftest over-arity-call-drops-extras-test\n214:   (testing \"a 2-arity closure called with 3 arguments drops the extra,\n215:             matching engine/bind-params' zip-stops-at-shorter rule\"\n216:     (let [ast (app (conj-pair-ast) (lit 1) (lit 2) (lit 3))\n217:           segment (into [[:closure 2 6]   ; 0: closure, body at 6\n218:                          [:const 1]        ; 1\n219:                          [:const 2]        ; 2\n220:                          [:const 3]        ; 3\n221:                          [:call 3 false]   ; 4: 3 args for arity 2\n222:                          [:halt]]          ; 5\n223:                         (conj-pair-segment 6))\n224:           result (debruijn-value segment)]\n225:       (is (= [1 2] result))\n226:       (is (= (named-value ast) result)))))\n227: \n228: \n229: ;; =============================================================================\n230: ;; 5. if / :branch-false, both arms\n231: ;; =============================================================================\n232: \n233: (deftest branch-true-arm-test\n234:   (let [ast {:type :if, :test (lit true), :consequent (lit \"T\"),\n235:              :alternate (lit \"F\")}\n236:         segment [[:const true]        ; 0\n237:                  [:branch-false 4]    ; 1\n238:                  [:const \"T\"]         ; 2\n239:                  [:jump 5]            ; 3\n240:                  [:const \"F\"]         ; 4\n241:                  [:halt]]             ; 5\n242:         result (debruijn-value segment)]\n243:     (is (= \"T\" result))\n244:     (is (= (named-value ast) result))))\n245: \n246: \n247: (deftest branch-false-arm-test\n248:   (let [ast {:type :if, :test (lit false), :consequent (lit \"T\"),\n249:              :alternate (lit \"F\")}\n250:         segment [[:const false]       ; 0\n251:                  [:branch-false 4]    ; 1\n252:                  [:const \"T\"]         ; 2\n253:                  [:jump 5]            ; 3\n254:                  [:const \"F\"]         ; 4\n255:                  [:halt]]             ; 5\n256:         result (debruijn-value segment)]\n257:     (is (= \"F\" result))\n258:     (is (= (named-value ast) result))))\n259: \n260: \n261: ;; =============================================================================\n262: ;; 6. Store get/put\n263: ;; =============================================================================\n264: \n265: (deftest store-get-put-sequenced-test\n266:   (testing \"a put, then a get of the same key from inside a called\n267:             closure -- the named side sequences the two through\n268:             application operand order (operator then operands, section 3),\n269:             since the Universal AST has no explicit sequencing node\"\n270:     (let [ast (app (lambda '[ignored] {:type :vm/store-get, :key :b0/k})\n271:                    {:type :vm/store-put, :key :b0/k, :val 123})\n272:           segment [[:closure 1 4]              ; 0: body at 4\n273:                    [:store-put :b0/k 123]      ; 1\n274:                    [:call 1 false]             ; 2\n275:                    [:halt]                     ; 3\n276:                    [:store-get :b0/k]          ; 4: body, ignores its arg\n277:                    [:return]]                  ; 5\n278:           result (debruijn-value segment)]\n279:       (is (= 123 result))\n280:       (is (= (named-value ast) result)))))\n281: \n282: \n283: ;; =============================================================================\n284: ;; 7. Fresh-instance parity, not reuse\n285: ;; =============================================================================\n286: \n287: (deftest fresh-instance-per-run-test\n288:   (testing \"every comparison above ran two independent fresh VMs (one\n289:             named, one de Bruijn); this test only re-confirms that running\n290:             the same de Bruijn segment twice from two fresh instances\n291:             agrees with itself, the same self-parity shape\n292:             `named-vm-self-parity-test` in the B0 contract test uses\"\n293:     (let [segment [[:const 7] [:halt]]]\n294:       (is (= (debruijn-value segment) (debruijn-value segment) 7)))))\n295: \n296: \n297: ;; =============================================================================\n298: ;; 8. Out-of-scope opcodes fail loudly\n299: ;; =============================================================================\n300: \n301: (deftest not-yet-implemented-opcode-test\n302:   (testing \"an opcode outside B3's scope (stream ops, primitives/FFI as\n303:             effects, gensym, current-continuation, park, resume) throws a\n304:             clear :not-yet-implemented error instead of silently no-oping\"\n305:     (let [segment [[:current-continuation]]]\n306:       (is (thrown-with-msg?\n307:             #?(:clj Exception :cljs js/Error :cljd Object)\n308:             #\"Not yet implemented in B3\"\n309:             (v2/run (dvm/create-vm segment)))))))\n310: \n311: \n312: ;; =============================================================================\n313: ;; 9. environment is not implemented\n314: ;; =============================================================================\n315: \n316: (deftest environment-not-implemented-test\n317:   (testing \"point 8: vm/IVMState/environment is not implemented at all in\n318:             this phase, rather than returning the raw positional frame\n319:             vector\"\n320:     (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n321:           (v2/environment (dvm/create-vm [[:halt]]))))))"}],"deferred":false}}
