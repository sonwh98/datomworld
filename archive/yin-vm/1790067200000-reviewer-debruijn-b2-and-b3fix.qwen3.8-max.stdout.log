c (unknown)\n(ns yin.vm.debruijn-linearize\n  \"B2 (docs/design/yin.vm.debruijn.stack.md S3): the named-datom lowerer\n   adapter. Runs `yin.vm.linearize/lower` unmodified on named `:yin/*`\n   datoms, turns its `:yin.code/*` output rows into the named canonical\n   instruction vector (UCF S7.3.2 shape), rewrites `:var` and `:closure`\n   operands into this design's `:yin.debruijn.code/*` lexical-addressing\n   shapes, and supplies the lift back to `:yin.code/*`.\n\n   `adapt` does the forward direction; `lift` the reverse. Scope\n   reconstruction is a pure function of the image -- never of\n   `:yin.code/source`, which stays a diagnostic-only field -- reproducing\n   the algorithm shape of `yin.vm.completion`'s private `closure-ranges`\n   and `layout-conforms?` (each closure's body range is `[body, first\n   :return at-or-after body]`; the layout must have every body closed, no\n   body covering pc 0, and bodies pairwise disjoint) rather than calling\n   them, since they are private and operate on `:yin.code/*` vectors with\n   named `:closure` params where this file's own copy operates on either\n   named or `:yin.debruijn.code/*` vectors, both of which carry a\n   `:closure`'s body pc at tuple index 2. `yin.vm.debruijn/resolve-name`\n   is the one public helper reused from the merged dormant projection\n   namespace; every other helper here is this file's own.\n\n   `yin.vm.linearize` and named lowering semantics are unchanged: this\n   namespace only reads `yin.vm.linearize/lower`'s output and the public\n   parts of `yin.vm.code` and `yin.vm.debruijn-code`.\"\n  (:require [yin.vm.code :as code]\n            [yin.vm.debruijn :as debruijn]\n            [yin.vm.linearize :as linearize]))\n\n\n;; =============================================================================\n;; Step 1: named rows -> the named canonical instruction vector\n;; =============================================================================\n;; `yin.vm.ast-walker/vm-load-rows` (read per the collab brief) converts a\n;; DIFFERENT row shape -- `{:root id, :rows {id row}}` semantic-bytecode\n;; rows -- back into an AST, not into a canonical instruction vector; it is\n;; not the precedent this step needs. The actual named-path precedent for\n;; turning `lower`'s `:yin.code/*` datom rows into the canonical positional\n;; vector is `yin.vm.semantic/load-image`'s own local `canonical` step\n;; (index the batch by entity, sort instructions by `:yin.code/pc`, then\n;; read each entity's operands off `yin.vm.code/vector-operand-table` with\n;; every `:pc`-kind operand resolved to a position instead of an entity\n;; ref). That helper is private to a namespace this phase may only read\n;; from, so it is reimplemented here rather than called, following the\n;; same table-driven shape `yin.vm.debruijn-code`'s own opcode table\n;; already derives from `vector-operand-table`.\n\n(defn- index-batch\n  \"Entity ids in order of first appearance, and each entity's attribute\n   map. A repeated single-valued attribute keeps its last value, matching\n   every other batch indexer in this lineage.\"\n  [datoms]\n  (reduce (fn [[order attrs] [e a v]]\n            [(if (contains? attrs e) order (conj order e))\n             (assoc-in attrs [e a] v)])\n          [[] {}]\n          datoms))\n\n\n(defn named-canonical-vector\n  \"`lower`'s `:yin.code/*` datom batch turned into `{:vector v :source s}`:\n   `v` is the canonical instruction vector (UCF S7.3.2), pc-indexed,\n   `:yin.code/target`/`:yin.code/body` refs resolved to positions; `s` is\n   the parallel pc-indexed vector of each instruction's `:yin.code/source`\n   AST entity, carried only for the diagnostic side table -- never read by\n   the scope reconstruction below.\"\n  [datoms]\n  (let [[order attrs] (index-batch datoms)\n        seg (first (filter #(= :segment (get-in attrs [% :yin.code/type])) order))\n        structural #{:yin.code/segment :yin.code/pc :yin.code/op}\n        instructions (filterv (fn [e]\n                                (and (not= e seg)\n                                     (some #(contains? (get attrs e) %) structural)))\n                              order)\n        n (count instructions)\n        by-pc (into {} (map (fn [e] [(get-in attrs [e :yin.code/pc]) e])) instructions)\n        ordered (mapv by-pc (range n))\n        pc-of (zipmap ordered (range))\n        tuple (fn [e]\n                (let [ia (get attrs e)\n                      mnem (:yin.code/op ia)]\n                  (into [mnem]\n                        (map (fn [[a kind]]\n                               (if (= :pc kind)\n                                 (get pc-of (get ia a))\n                                 (get ia a)))\n                             (get code/vector-operand-table mnem)))))]\n    {:vector (mapv tuple ordered)\n     :source (mapv #(get-in attrs [% :yin.code/source]) ordered)}))\n\n\n;; =============================================================================\n;; Scope reconstruction, a pure function of the image\n;; =============================================================================\n\n(defn- closure-body-ranges\n  \"`[[c body r] ...]` for every `:closure` of vector `v`: the closure at\n   pc `c` has body `[body, r]`, `r` the first `:return` at or after\n   `body`; nil `r` when there is none. `v` may be a named vector (whose\n   `:closure` carries a parameter vector at index 1) or a de Bruijn image\n   (whose `:closure` carries an arity at index 1) -- this function only\n   ever reads index 2, the body pc, which both share. Mirrors\n   `yin.vm.completion`'s private `closure-ranges`.\"\n  [v]\n  (let [n (count v)]\n    (keep (fn [c]\n            (let [t (nth v c)]\n              (when (= :closure (nth t 0))\n                (let [body (nth t 2)]\n                  [c body (first (filter #(= :return (nth (nth v %) 0))\n                                         (range body n)))]))))\n          (range n))))\n\n\n(defn- layout-conforms?\n  \"Whether `v` has the layout `closure-body-ranges` assumes: every body\n   closed by a `:return`, no body covering pc 0 (bodies follow the main\n   code, out of line), and bodies pairwise disjoint -- never interleaved.\n   Mirrors `yin.vm.completion`'s private `layout-conforms?` exactly, over\n   either a named or a de Bruijn vector.\"\n  [v]\n  (let [ranges (closure-body-ranges v)\n        spans (distinct (map (fn [[_ b r]] [b r]) ranges))]\n    (and (every? (fn [[b r]] (and r (pos? b))) spans)\n         (= (count spans) (count (distinct (map second spans))))\n         (every? (fn [[[b1 r1] [b2 r2]]]\n                   (or (< r1 b2) (< r2 b1)))\n                 (for [x spans, y spans :when (neg? (compare x y))] [x y])))))\n\n\n(defn- body-owner\n  \"pc -> the pc of the innermost `:closure` whose body range covers it,\n   absent for a pc in the main sequence (no enclosing closure). Requires\n   `layout-conforms?`: pairwise-disjoint body ranges are what makes this\n   map well defined.\"\n  [v]\n  (into {}\n        (mapcat (fn [[c body r]]\n                  (when r (map (fn [pc] [pc c]) (range body (inc r))))))\n        (closure-body-ranges v)))\n\n\n(defn- chain-of\n  \"The enclosing-closure-pc chain of `pc`, innermost first: `owner`'s\n   parent pointers followed from `pc` outward. This is the conversion\n   section 3 requires be explicit -- the OPPOSITE order of the runtime\n   frame vector (`yin.vm.debruijn.stack`'s `:frames`, outermost first), built\n   here by walking `body-owner` rather than reversing a runtime stack.\"\n  [owner pc]\n  (loop [p pc, chain []]\n    (if-let [c (get owner p)]\n      (recur c (conj chain c))\n      chain)))\n\n\n;; =============================================================================\n;; Step 2: rewrite :var and :closure operands\n;; =============================================================================\n\n(defn rewrite\n  \"Named canonical vector `v` -> `{:debruijn image, :side-table side-\n   table}`. Every `:var` is resolved against the innermost-first stack of\n   enclosing parameter vectors (`yin.vm.debruijn/resolve-name`, the one\n   reused projection helper) into `:load-bound`/`:load-free`; every\n   `:closure`'s parameter vector becomes its arity. Every other tuple is\n   copied unchanged -- the structural comparison test asserts this holds\n   for every pc that is not a `:var` or `:closure`. The side table records\n   binder names (`:closure`'s original parameter vector) indexed by\n   instruction slot; a `:var` slot carries no name of its own because\n   `lift` derives it from the owning `:closure`'s recorded parameters at\n   the resolved position, per section 3/4 (one lossless record, never\n   two).\n\n   Public so both `adapt` and `lift`'s own round-trip check\n   (adapt-the-lifted-result-back) share one implementation, and so a test\n   can independently reconstruct the named vector for the structural\n   opcode-by-opcode comparison and the alpha-equivalence check.\"\n  [v]\n  (when-not (layout-conforms? v)\n    (throw (ex-info \"Cannot adapt a named vector with malformed closure body layout\"\n                    {:rule :layout})))\n  (let [owner (body-owner v)\n        n (count v)]\n    (reduce\n      (fn [{:keys [debruijn side-table]} pc]\n        (let [t (nth v pc), op (nth t 0)]\n          (case op\n            :var\n            (let [name (nth t 1)\n                  stack (mapv (fn [c] (nth (nth v c) 1)) (chain-of owner pc))\n                  resolution (debruijn/resolve-name stack name)]\n              {:debruijn (conj debruijn\n                               (if-let [bound (:bound resolution)]\n                                 [:load-bound (nth bound 0) (nth bound 1)]\n                                 [:load-free (:free resolution)])),\n               :side-table (assoc side-table pc {:kind :var})})\n\n            :closure\n            (let [params (nth t 1), body (nth t 2)]\n              {:debruijn (conj debruijn [:closure (count params) body]),\n               :side-table (assoc side-table pc {:kind :closure, :params params})})\n\n            {:debruijn (conj debruijn t), :side-table side-table})))\n      {:debruijn [], :side-table {}}\n      (range n))))\n\n\n;; =============================================================================\n;; adapt: named datoms -> de Bruijn image + side table\n;; =============================================================================\n\n(defn adapt\n  \"Run `yin.vm.linearize/lower` on `named-datoms` (unmodified, `opts`\n   passed through), then B2's rewrite. Returns `{:image v, :side-table\n   st}`: `v` a `:yin.debruijn.code/*`-shaped canonical instruction vector,\n   `st` the diagnostic side table indexed by pc, its `:closure` entries\n   carrying original parameter vectors and every entry carrying\n   `:source`, the original `:yin.code/source` AST entity (diagnostic\n   only, never read back by `rewrite` or the scope reconstruction above).\n\n   Throws naming the defect when the named vector `lower` produces is not\n   well formed (`yin.vm.code/well-formed-vector?`) or fails the layout\n   check `rewrite` requires -- a validation defect, not a silently wrong\n   image.\"\n  ([named-datoms] (adapt named-datoms {}))\n  ([named-datoms opts]\n   (let [named-rows (linearize/lower named-datoms opts)\n         {:keys [vector source]} (named-canonical-vector named-rows)\n         defect (code/well-formed-vector? vector)]\n     (when defect\n       (throw (ex-info (str \"Cannot adapt a malformed named vector: \" (name (:rule defect)))\n                       {:defect defect})))\n     (let [{:keys [debruijn side-table]} (rewrite vector)\n           side-table (reduce-kv (fn [st pc entry]\n                                   (assoc st pc (assoc entry :source (nth source pc))))\n                                 {}\n                                 side-table)]\n       {:image debruijn, :side-table side-table}))))\n\n\n;; =============================================================================\n;; B2's own scope validation (S3 item 1)\n;; =============================================================================\n\n(defn- count?\n  [x]\n  (and (integer? x) (not (neg? x))))\n\n\n(defn image-scope-defect\n  \"B2's own copy of S3 item 1: every `:load-bound [depth position]` of a\n   de Bruijn image `v` must address a real enclosing frame (`depth` inside\n   the chain of enclosing `:closure`s) and a real parameter inside it\n   (`position` inside that closure's declared arity). Independent from\n   `yin.vm.debruijn-code/scope-defect` (S3 item 2, B1's own copy of the\n   same check) -- both are required to admit an image, neither calls the\n   other. Returns `{:rule :scope, :pc p}` or nil; assumes `v` is otherwise\n   shape valid (defers to callers to also run `yin.vm.debruijn-code/well-\n   formed-image?`, which this function does not repeat).\"\n  [v]\n  (when (vector? v)\n    (let [owner (body-owner v)\n          n (count v)\n          defect-at\n          (fn [pc]\n            (let [t (nth v pc)]\n              (when (and (vector? t) (= :load-bound (nth t 0 nil)) (>= (count t) 3))\n                (let [depth (nth t 1), position (nth t 2)]\n                  (if-not (and (count? depth) (count? position))\n                    {:rule :scope, :pc pc}\n                    (let [chain (chain-of owner pc)]\n                      (if (>= depth (count chain))\n                        {:rule :scope, :pc pc}\n                        (let [c (nth chain depth)\n                              ct (nth v c nil)]\n                          (when (or (nil? ct) (< (count ct) 2) (not (count? (nth ct 1)))\n                                    (>= position (nth ct 1)))\n                            {:rule :scope, :pc pc})))))))))]\n      (some defect-at (range n)))))\n\n\n;; =============================================================================\n;; lift: de Bruijn image + side table -> named canonical vector\n;; =============================================================================\n\n(defn- free-names-of\n  [v]\n  (into #{} (keep (fn [t] (when (= :load-free (nth t 0)) (nth t 1)))) v))\n\n\n(defn- synthesize-name\n  \"A symbol not in `used`, distinct for `[c i]` (`c` the owning `:closure`\n   pc, `i` the parameter position) so two different binders never\n   accidentally synthesize the same spelling.\"\n  [used c i]\n  (loop [n 0]\n    (let [candidate (symbol (str \"g__\" c \"_\" i (when (pos? n) (str \"_\" n))))]\n      (if (contains? used candidate)\n        (recur (inc n))\n        candidate))))\n\n\n(defn- lift-params\n  \"pc -> parameter vector for every `:closure` of de Bruijn image `v`:\n   `side-table`'s recorded parameters when present and of matching arity,\n   else fresh names synthesized against `v`'s own free-name set and every\n   parameter already assigned -- so a synthesized name never shadows a\n   free name or collides with another synthesized binder anywhere in the\n   image. `side-table` may be nil (full synthesis).\"\n  [v side-table]\n  (let [free (free-names-of v)\n        closure-pcs (keep-indexed (fn [pc t] (when (= :closure (nth t 0)) pc)) v)]\n    (reduce\n      (fn [acc c]\n        (let [arity (nth (nth v c) 1)\n              given (get-in side-table [c :params])\n              used (into free (mapcat identity) (vals acc))\n              params (if (and given (= (count given) arity))\n                       given\n                       (mapv #(synthesize-name used c %) (range arity)))]\n          (assoc acc c params)))\n      {}\n      closure-pcs)))\n\n\n(defn- lift-once\n  \"De Bruijn image `v` -> a named canonical vector, using `lift-params`'s\n   pc -> parameter-vector map. `:load-bound [depth position]` becomes\n   `[:var name]`, `name` read from the enclosing `:closure`'s parameter\n   vector at `position` -- the same array the original `:var` occurrence's\n   name came from, per `resolve-name`'s own contract, so an occurrence\n   that resolved against the adapter's own side table reads back its\n   exact original spelling, including a rightmost-wins duplicate\n   parameter. `:load-free [name]` becomes `[:var name]` directly, the name\n   already exact in the image. `:closure`'s arity becomes its parameter\n   vector. Every other tuple is copied unchanged.\"\n  [v side-table]\n  (let [owner (body-owner v)\n        params (lift-params v side-table)]\n    (mapv (fn [pc]\n            (let [t (nth v pc), op (nth t 0)]\n              (case op\n                :load-bound\n                (let [depth (nth t 1), position (nth t 2)\n                      chain (chain-of owner pc)\n                      c (nth chain depth)]\n                  [:var (nth (get params c) position)])\n\n                :load-free [:var (nth t 1)]\n\n                :closure [:closure (get params pc) (nth t 2)]\n\n                t)))\n          (range (count v)))))\n\n\n(defn lift\n  \"The lift (section 2/3): a function of a de Bruijn image `v` and its\n   diagnostic side table `side-table` (may be nil) back to a\n   `:yin.code/*`-shaped canonical vector.\n\n   A supplied `side-table` is trusted only after it round-trips: `v`'s own\n   `lift-once` result is re-adapted (`rewrite`) and compared back to `v`\n   itself. When that holds, the lifted result is returned as is -- with\n   the adapter's OWN side table this is always exact equality to the\n   original named vector, because `lift-once` reads every bound name back\n   from the exact parameter array `resolve-name` matched it against. When\n   it does not hold (a wrong, partial, or absent side table), this falls\n   back to full synthesis (`side-table` nil), which always round-trips by\n   construction: synthesized names are pairwise distinct across the whole\n   image and fresh against every free name, so `resolve-name`'s\n   duplicate-parameter search is never accidentally triggered by a\n   collision synthesis itself introduced.\"\n  ([v] (lift v nil))\n  ([v side-table]\n   (let [attempt (lift-once v side-table)]\n     (if (and side-table (= v (:debruijn (rewrite attempt))))\n       attempt\n       (let [synthesized (lift-once v nil)]\n         (if (= v (:debruijn (rewrite synthesized)))\n           synthesized\n           (throw (ex-info \"Lift failed to round-trip even with synthesized names\"\n                           {:rule :lift-round-trip}))))))))\n\n\n// File: test/yin/vm/debruijn_linearize_test.cljc (unknown)\n(ns yin.vm.debruijn-linearize-test\n  \"B2 (docs/design/yin.vm.debruijn.stack.md, 'B2: named-datom lowerer\n   adapter'): completion tests for `yin.vm.debruijn-linearize`.\n\n   Every program below is a plain map AST run through `yin.vm/ast->datoms-\n   with-root`, then `yin.vm.linearize/lower` (unmodified) and\n   `yin.vm.debruijn-linearize/adapt`. The corpus is the same construction\n   style `yin.vm.linearize-test`'s own corpus uses, so this file needs no\n   change to that namespace and repeats none of its traversal.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [yin.vm :as vm]\n            [yin.vm.code :as code]\n            [yin.vm.debruijn-code :as dc]\n            [yin.vm.debruijn-linearize :as dl]\n            [yin.vm.debruijn.stack :as dvm]\n            [yin.vm.linearize :as linearize]))\n\n\n;; =============================================================================\n;; AST fixtures (yin.vm.linearize-test's own construction style)\n;; =============================================================================\n\n(defn- lit\n  [v]\n  {:type :literal, :value v})\n\n\n(defn- v\n  [s]\n  {:type :variable, :name s})\n\n\n(defn- lam\n  [params body]\n  {:type :lambda, :params params, :body body})\n\n\n(defn- app\n  [op & args]\n  {:type :application, :operator op, :operands (vec args)})\n\n\n(defn- tail\n  [node]\n  (assoc node :tail? true))\n\n\n(defn- if-node\n  [t c a]\n  {:type :if, :test t, :consequent c, :alternate a})\n\n\n(def ^:private worked-example\n  \"`((fn [x] (+ x 1)) 10)`, the same worked example `yin.vm.linearize-test`\n   uses -- a simple program with no duplicate parameters, no free-variable\n   surprises beyond the primitive `+`, and one level of closure nesting.\"\n  (app (lam '[x] (tail (app (v '+) (v 'x) (lit 1)))) (lit 10)))\n\n\n(def ^:private duplicate-param\n  \"`(fn [x x] x)`: `resolve-name`'s rightmost-wins duplicate-parameter\n   case, the design's own named example for the lift law.\"\n  (lam '[x x] (tail (v 'x))))\n\n\n(def ^:private free-variable\n  \"A body that references a name no enclosing closure binds: `y` lowers\n   to `:load-free`, never `:load-bound`.\"\n  (lam '[x] (tail (app (v '+) (v 'x) (v 'y)))))\n\n\n(def ^:private nested-closure\n  \"Two levels of nesting, an inner body reaching two frames outward, and a\n   duplicate binder at the outer level to exercise both features in one\n   corpus program.\"\n  (app (lam '[a a]\n            (tail (lam '[b]\n                       (tail (app (v '+) (v 'a) (v 'b))))))\n       (lit 1)))\n\n\n(def ^:private corpus\n  \"Every named mnemonic `yin.vm.code/mnemonics` declares, reached at least\n   once: :const :var :closure :push :call :return :jump :branch-false\n   :halt :gensym :store-get :store-put :stream-make :stream-put\n   :stream-cursor :stream-next :stream-close :park :resume\n   :current-continuation :ffi-call.\"\n  {:worked-example worked-example,\n   :duplicate-param duplicate-param,\n   :free-variable free-variable,\n   :nested-closure nested-closure,\n   :literal (lit 42),\n   :zero-arity-call (app (lam [] (lit 1))),\n   :if-in-tail (app (lam '[n] (if-node (app (v '<) (v 'n) (lit 1))\n                                       (lit :done)\n                                       (tail (app (v '-) (v 'n) (lit 1)))))\n                    (lit 3)),\n   :streams {:type :stream/put,\n             :target {:type :stream/make, :buffer 4},\n             :val {:type :stream/next,\n                   :source {:type :stream/cursor,\n                            :source {:type :stream/close,\n                                     :source (lit nil)}}}},\n   :ffi {:type :dao.stream.apply/call, :op :op/echo, :operands [(lit 1) (lit 2)]},\n   :ffi-no-args {:type :dao.stream.apply/call, :op :op/ping, :operands []},\n   :default-gensym {:type :vm/gensym},\n   :default-buffer {:type :stream/make},\n   :store-and-control (app (lam '[a b c d]\n                                (tail (app (v 'vector) (v 'a) (v 'b) (v 'c) (v 'd))))\n                           {:type :vm/store-put, :key 'k, :val 5}\n                           {:type :vm/store-get, :key 'k}\n                           {:type :vm/gensym, :prefix \"g\"}\n                           {:type :vm/current-continuation}),\n   :park-resume (if-node (lit false)\n                         {:type :vm/park}\n                         {:type :vm/resume, :parked-id :p1, :val (lit 7)})})\n\n\n;; =============================================================================\n;; Helpers\n;; =============================================================================\n\n(defn- ast-datoms\n  [ast]\n  (second (vm/ast->datoms-with-root ast)))\n\n\n(defn- named-vector\n  \"The named canonical vector `adapt` itself derives from `ast`, computed\n   independently here (same public step, `named-canonical-vector` ∘\n   `lower`) for the structural comparison and lift-law tests.\"\n  [ast]\n  (:vector (dl/named-canonical-vector (linearize/lower (ast-datoms ast)))))\n\n\n(defn- adapted\n  [ast]\n  (dl/adapt (ast-datoms ast)))\n\n\n;; =============================================================================\n;; Every node and opcode is handled; images are shape and scope valid\n;; =============================================================================\n\n(deftest every-corpus-program-adapts-to-a-valid-image\n  (doseq [[label ast] corpus]\n    (testing label\n      (let [{:keys [image side-table]} (adapted ast)]\n        (is (nil? (dc/well-formed-image? image)) \"B1's generic shape rule\")\n        (is (nil? (dc/image-defect image)) \"B1's full validator, including scope\")\n        (is (nil? (dl/image-scope-defect image)) \"B2's own scope check\")\n        (is (map? side-table))))))\n\n\n;; =============================================================================\n;; Deterministic output\n;; =============================================================================\n\n(deftest adapting-twice-is-byte-identical\n  (doseq [[label ast] corpus]\n    (testing label\n      (let [datoms (ast-datoms ast)\n            h1 (dc/image-hash (:image (dl/adapt datoms)))\n            h2 (dc/image-hash (:image (dl/adapt datoms)))]\n        (is (= h1 h2))))))\n\n\n;; =============================================================================\n;; Structural opcode-by-opcode comparison with the named vector\n;; =============================================================================\n\n(deftest structural-comparison-differs-only-at-var-and-closure\n  (doseq [[label ast] corpus]\n    (testing label\n      (let [nv (named-vector ast)\n            {:keys [image]} (adapted ast)]\n        (is (= (count nv) (count image)) \"same instruction count\")\n        (dotimes [pc (count nv)]\n          (let [nt (nth nv pc), dt (nth image pc)\n                nop (nth nt 0), dop (nth dt 0)]\n            (testing (str \"pc \" pc)\n              (case nop\n                :var\n                (is (contains? #{:load-bound :load-free} dop)\n                    \"a :var rewrites to :load-bound or :load-free\")\n\n                :closure\n                (do (is (= :closure dop))\n                    (is (= (count (nth nt 1)) (nth dt 1))\n                        \"arity is the original parameter vector's count\")\n                    (is (= (nth nt 2) (nth dt 2)) \"the body pc is unchanged\"))\n\n                (is (= nt dt) \"every other pc is copied unchanged\")))))))))\n\n\n;; =============================================================================\n;; Every image B2 emits round trips through B3\n;; =============================================================================\n;; `step1` (already merged, out of this file's box per the collab brief's\n;; Never list) originally had no `:push` case, so any program whose root\n;; lowers an `:application` or `:dao.stream.apply/call` -- which both wrap\n;; every operand in an extra `:push` under the named lowering's own\n;; calling convention -- would throw stepping past its first `:push`.\n;; That gap, discovered by this phase's own corpus coverage, has since\n;; been closed directly in `debruijn/stack.cljc` (a `:push` case that only\n;; advances `pc`, since this stack-native machine already conjes every\n;; produced value straight onto `:stack`); every corpus program now runs\n;; to completion.\n\n(deftest corpus-images-load-and-run-on-b3\n  (doseq [[label ast] [[:literal (:literal corpus)]\n                       [:duplicate-param duplicate-param]\n                       [:worked-example worked-example]\n                       [:zero-arity-call (:zero-arity-call corpus)]\n                       [:if-in-tail (:if-in-tail corpus)]]]\n    (testing label\n      (let [{:keys [image]} (adapted ast)]\n        (is (nil? (dc/image-defect image)))\n        (is (some? (dvm/create-vm image {:primitives vm/primitives})) \"loads\")\n        (let [result (vm/run (dvm/create-vm image {:primitives vm/primitives}))]\n          (is (= :halted (:status result))))))))\n\n\n;; =============================================================================\n;; The lift correctness law\n;; =============================================================================\n\n(def ^:private lift-law-programs\n  {:simple worked-example,\n   :duplicate-param duplicate-param,\n   :free-variable free-variable,\n   :nested-closure nested-closure})\n\n\n(deftest lift-with-the-adapters-own-side-table-is-exact\n  (doseq [[label ast] lift-law-programs]\n    (testing label\n      (let [nv (named-vector ast)\n            {:keys [image side-table]} (adapted ast)\n            lifted (dl/lift image side-table)]\n        (is (= nv lifted)\n            \"lift(adapt(lower x), side-table) = canonical-vector(lower x), exactly\")))))\n\n\n(deftest lift-with-synthesized-names-is-alpha-equivalent\n  (doseq [[label ast] lift-law-programs]\n    (testing label\n      (let [nv (named-vector ast)\n            {:keys [image]} (adapted ast)\n            lifted (dl/lift image nil)]\n        (is (not= nv lifted)\n            \"synthesized names are not the original spelling\")\n        (is (= image (:debruijn (dl/rewrite lifted)))\n            \"but re-adapting the lift reproduces the exact same de Bruijn image -- the operational definition of alpha-equivalence this bytecode form admits\")))))\n\n\n(deftest a-foreign-side-table-that-fails-to-round-trip-falls-back-to-synthesis\n  (let [{:keys [image side-table]} (adapted worked-example)\n        wrong (assoc-in side-table [0 :params] '[not-the-real-name not-the-real-name])\n        lifted (dl/lift image wrong)]\n    ;; the wrong table would not even round trip through adapt/rewrite,\n    ;; so `lift` must have fallen back rather than trusted it\n    (is (= image (:debruijn (dl/rewrite lifted))))))\n\n\n;; =============================================================================\n;; Lexical validation catches a malformed named vector before rewriting\n;; =============================================================================\n\n(deftest a-malformed-named-vector-is-rejected-before-rewriting\n  (testing \"a body that never closes with :return\"\n    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n          (dl/rewrite [[:closure ['x] 2] [:push] [:const 1]]))))\n  (testing \"interleaved bodies: two closures declaring overlapping [body r] spans\"\n    (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n          (dl/rewrite [[:closure ['x] 2]\n                       [:closure ['y] 3]\n                       [:const 1]\n                       [:return]])))))\n\n\n;; =============================================================================\n;; Hand-built out-of-range images are rejected by both validators\n;; =============================================================================\n\n(deftest hand-built-out-of-range-images-are-rejected-by-both-validators\n  (testing \"a :load-bound depth past its one-level chain\"\n    (let [image [[:closure 1 3] [:push] [:return] [:load-bound 5 0] [:return]]]\n      (is (nil? (dc/well-formed-image? image)) \"shape valid on its own\")\n      (is (= {:rule :scope, :pc 3} (dc/image-defect image)) \"B1 rejects it\")\n      (is (= {:rule :scope, :pc 3} (dl/image-scope-defect image)) \"B2 rejects it too\")))\n  (testing \"a :load-bound position past the enclosing arity\"\n    (let [image [[:closure 1 2] [:return] [:load-bound 0 3] [:return]]]\n      (is (= {:rule :scope, :pc 2} (dc/image-defect image)))\n      (is (= {:rule :scope, :pc 2} (dl/image-scope-defect image))))))\n\n\n;; =============================================================================\n;; Named lowering semantics are unchanged: `lower`'s own output is untouched\n;; =============================================================================\n\n(deftest lower-itself-is-unmodified-by-this-namespace\n  (testing \"well-formed? still judges lower's raw datom output the same way\"\n    (let [datoms (linearize/lower (ast-datoms worked-example))]\n      (is (nil? (code/well-formed? datoms))))))\n\n"}]},{"type":"tool_result","tool_use_id":"call_5dde95d5e3df40f3814d8424","content":[{"type":"text","text":"Read 1/1 file, 266 lines\n1: (ns yin.vm.debruijn.stack\n2:   \"B3 (docs/design/yin.vm.debruijn.stack.md, 'B3: de Bruijn VM kernel'): the\n3:    sibling stack VM that interprets RAW positional instruction vectors --\n4:    `[:closure arity body-pc]`, `[:load-bound depth position]`,\n5:    `[:load-free name]`, `[:const value]`, `[:call argc tail?]`, `[:return]`,\n6:    `[:jump target]`, `[:branch-false target]`, `[:halt]`, `[:store-get key]`,\n7:    `[:store-put key value]` -- whose shapes come from\n8:    `yin.vm.code/vector-operand-table` and section 2 of the design doc.\n9: \n10:    B2 (the named-datom lowerer) does not exist yet, so this namespace never\n11:    requires `yin.vm.debruijn-code`: every program used here and in its test\n12:    is a hand-built instruction vector, the same technique B1's own\n13:    standalone validator tests use.\n14: \n15:    The instruction set in scope is frames, closures, loads, calls, returns,\n16:    branches, `:const`, and `:store-get`/`:store-put` (section 4). Stream\n17:    operations, primitives-as-effects, FFI, gensym, current-continuation,\n18:    park, and resume are B4's phase; an opcode this namespace does not\n19:    recognize fails loudly with a `:not-yet-implemented` ex-info rather than\n20:    silently no-op-ing.\n21: \n22:    Applying a resolved primitive host function (via `:load-free`) is in\n23:    scope for `:call`, because `:load-free` (item 5, section 4) is\n24:    meaningless without a way to invoke what it resolves to; the pure\n25:    `(apply f args)` path below is the same one the named engine's\n26:    `apply-call` uses for a `fn?` callee, minus its effect handling, which is\n27:    an FFI concern this phase does not implement.\"\n28:   (:refer-clojure :exclude [eval])\n29:   (:require [yin.vm :as vm]\n30:             [yin.vm.engine :as engine]))\n31: \n32: \n33: ;; =============================================================================\n34: ;; State\n35: ;; =============================================================================\n36: ;; The record carries the eight fields of the design's explicit VM state\n37: ;; (:segment :pc :frames :free-env :stack :continuation :store :status)\n38: ;; plus :primitives and :modules, which are not part of that transition\n39: ;; state -- they are fixed composition values for this VM instance, the same\n40: ;; role they play alongside the SemanticVM record's own :control/:env/:stack\n41: ;; state (`yin.vm.semantic/SemanticVM`) -- but are required to give\n42: ;; `:load-free` the same `env -> store -> primitives -> module registry`\n43: ;; order `yin.vm.engine/resolve-var` already implements for the named VM.\n44: \n45: (defrecord DebruijnVM\n46:   [segment      ; vector of instructions, pc-indexed; the whole program\n47:    pc           ; program counter into segment\n48:    frames       ; positional frame stack, outermost first, innermost last\n49:    free-env     ; initial free-name environment map, fixed for this instance\n50:    stack        ; operand stack, a vector\n51:    continuation ; vector of return frames (innermost last); see step-call\n52:    store        ; heap map, keyed by whatever :store-get/:store-put use\n53:    status       ; :running or :halted\n54:    primitives   ; primitive registry, for :load-free\n55:    modules])    ; module registry, for :load-free\n56: \n57: \n58: (defn create-vm\n59:   \"Build a fresh `DebruijnVM` over `segment` (a vector of instructions).\n60: \n61:    Options: `:free-env`, `:store`, `:primitives`, `:modules` (all default to\n62:    `{}`, matching the named VM's own empty defaults except `:primitives`,\n63:    which callers pass `yin.vm/primitives` when they want the standard\n64:    registry, exactly as `yin.vm/empty-state` does for the named VM).\n65: \n66:    Always fresh: never resume or mutate a VM that has already run, per the\n67:    design's D4 fixture restriction (the named VM's environment-leak defect\n68:    is out of scope here and must not be reproduced by accident).\"\n69:   ([segment] (create-vm segment {}))\n70:   ([segment opts]\n71:    (map->DebruijnVM\n72:      {:segment segment,\n73:       :pc 0,\n74:       :frames [],\n75:       :free-env (or (:free-env opts) {}),\n76:       :stack [],\n77:       :continuation [],\n78:       :store (or (:store opts) {}),\n79:       :status :running,\n80:       :primitives (or (:primitives opts) {}),\n81:       :modules (or (:modules opts) {})})))\n82: \n83: \n84: ;; =============================================================================\n85: ;; Frame addressing\n86: ;; =============================================================================\n87: \n88: (defn- frame-value\n89:   \"Section 4: frame 0 for `:load-bound` is the INNERMOST frame, read from\n90:    the END of `:frames` -- the opposite of a naive front-of-vector reading,\n91:    and deliberate per the design. `frames` is outermost-first, so depth `d`\n92:    is `(count frames) - 1 - d`.\"\n93:   [frames depth position]\n94:   (let [n (count frames)\n95:         idx (- n 1 depth)]\n96:     (when (or (neg? idx) (>= idx n))\n97:       (throw (ex-info \"load-bound: depth out of range\"\n98:                       {:rule :load-bound-depth, :depth depth,\n99:                        :frame-count n})))\n100:     (let [frame (nth frames idx)]\n101:       (when (or (neg? position) (>= position (count frame)))\n102:         (throw (ex-info \"load-bound: position out of range\"\n103:                         {:rule :load-bound-position, :depth depth,\n104:                          :position position, :frame-arity (count frame)})))\n105:       (nth frame position))))\n106: \n107: \n108: (defn- bind-positional\n109:   \"The positional equivalent of the named `bind-params`\n110:    (`yin.vm.engine/bind-params`, which zips params with args and nil-fills):\n111:    `(vec (take arity (concat args (repeat nil))))`. Missing arguments are\n112:    nil-filled; extra arguments are dropped. Not `bind-params` itself, which\n113:    is name-keyed -- this is positional.\"\n114:   [arity args]\n115:   (vec (take arity (concat args (repeat nil)))))\n116: \n117: \n118: ;; =============================================================================\n119: ;; The step function\n120: ;; =============================================================================\n121: \n122: (defn- step1\n123:   \"Execute exactly one instruction and return the resulting VM. Assumes the\n124:    VM is not halted; callers (`step`, `run`) check that first.\"\n125:   [vm]\n126:   (let [{:keys [segment pc frames free-env stack continuation store\n127:                 primitives modules]}\n128:         vm\n129:         inst (nth segment pc)\n130:         op (nth inst 0)]\n131:     (case op\n132:       :const\n133:       (assoc vm :pc (inc pc) :stack (conj stack (nth inst 1)))\n134: \n135:       :load-bound\n136:       (let [depth (nth inst 1), position (nth inst 2)]\n137:         (assoc vm\n138:                :pc (inc pc)\n139:                :stack (conj stack (frame-value frames depth position))))\n140: \n141:       :load-free\n142:       (let [name (nth inst 1)\n143:             value (engine/resolve-var free-env store primitives modules\n144:                                       name)]\n145:         (assoc vm :pc (inc pc) :stack (conj stack value)))\n146: \n147:       ;; This positional dimension has no `:macro?` flag on `:closure` (it\n148:       ;; is named-datom-only, section 4): the instruction carries only\n149:       ;; arity and a body pc, so there is nothing here to ignore.\n150:       :closure\n151:       (let [arity (nth inst 1), body-pc (nth inst 2)]\n152:         (assoc vm\n153:                :pc (inc pc)\n154:                :stack (conj stack\n155:                             {:type :closure, :arity arity,\n156:                              :body-pc body-pc, :frames frames})))\n157: \n158:       ;; The named VM (semantic.cljc) keeps a separate `val` accumulator\n159:       ;; distinct from its operand stack `St`, so `:push` there commits\n160:       ;; `val` onto `St` (St <- St ++ [val]). This machine has no such\n161:       ;; split: every value-producing case above already conjes its\n162:       ;; result straight onto `:stack`. By the time control reaches a\n163:       ;; `:push`, the value it would push is already there -- so here\n164:       ;; it is a no-op that only advances `pc`.\n165:       :push\n166:       (assoc vm :pc (inc pc))\n167: \n168:       :call\n169:       (let [argc (nth inst 1), tail? (nth inst 2)\n170:             total (count stack)\n171:             f-pos (- total argc 1)\n172:             f (nth stack f-pos)\n173:             args (subvec stack (inc f-pos) total)\n174:             stack' (subvec stack 0 f-pos)]\n175:         (cond\n176:           (and (map? f) (= :closure (:type f)))\n177:           (let [locals (bind-positional (:arity f) args)\n178:                 body-frames (conj (:frames f) locals)\n179:                 continuation' (if tail?\n180:                                 continuation\n181:                                 (conj continuation\n182:                                       {:return-pc (inc pc), :frames frames,\n183:                                        :stack-base (count stack')}))]\n184:             (assoc vm\n185:                    :pc (:body-pc f)\n186:                    :frames body-frames\n187:                    :stack stack'\n188:                    :continuation continuation'))\n189: \n190:           (fn? f)\n191:           (assoc vm :pc (inc pc) :stack (conj stack' (apply f args)))\n192: \n193:           :else\n194:           (throw (ex-info \"Cannot apply non-function\" {:fn f}))))\n195: \n196:       :return\n197:       (let [val (peek stack)\n198:             frame (peek continuation)]\n199:         (if frame\n200:           (assoc vm\n201:                  :pc (:return-pc frame)\n202:                  :frames (:frames frame)\n203:                  :stack (conj (subvec stack 0 (:stack-base frame)) val)\n204:                  :continuation (pop continuation))\n205:           (assoc vm :status :halted, :stack [val])))\n206: \n207:       :jump\n208:       (assoc vm :pc (nth inst 1))\n209: \n210:       :branch-false\n211:       (let [val (peek stack), stack' (pop stack)]\n212:         (if val\n213:           (assoc vm :pc (inc pc) :stack stack')\n214:           (assoc vm :pc (nth inst 1) :stack stack')))\n215: \n216:       :halt\n217:       (assoc vm :status :halted)\n218: \n219:       :store-get\n220:       (let [key (nth inst 1)]\n221:         (assoc vm :pc (inc pc) :stack (conj stack (get store key))))\n222: \n223:       :store-put\n224:       (let [key (nth inst 1), value (nth inst 2)]\n225:         (assoc vm\n226:                :pc (inc pc)\n227:                :stack (conj stack value)\n228:                :store (assoc store key value)))\n229: \n230:       (throw (ex-info (str \"Not yet implemented in B3: \" op)\n231:                       {:rule :not-yet-implemented, :op op})))))\n232: \n233: \n234: ;; =============================================================================\n235: ;; IVM / IVMState\n236: ;; =============================================================================\n237: ;; No new protocol methods (section 4, point 7). `environment` is not\n238: ;; implemented at all (point 8): the design defers it until a\n239: ;; frame-to-named lift exists, and returning the raw positional frame\n240: ;; vector from it would be wrong once the method does exist.\n241: \n242: (extend-type DebruijnVM\n243:   vm/IVM\n244:   (step [this] (if (= :halted (:status this)) this (step1 this)))\n245:   (run [this]\n246:     (loop [vm this]\n247:       (if (= :halted (:status vm)) vm (recur (step1 vm)))))\n248:   (eval [_ ast]\n249:     (throw (ex-info\n250:              \"The B3 kernel executes raw instruction vectors: B2 (the named-datom lowerer) does not exist yet, so there is no AST to convert here\"\n251:              {:ast ast})))\n252:   (reset [this]\n253:     (assoc this\n254:            :pc 0, :frames [], :stack [], :continuation [], :status :running))\n255:   (halted? [this] (= :halted (:status this)))\n256:   (blocked? [_this] false)\n257:   (value [this] (peek (:stack this)))\n258: \n259:   vm/IVMState\n260:   (control [this] {:pc (:pc this)})\n261:   (environment [_this]\n262:     (throw (ex-info\n263:              \"environment is not implemented in B3: the design defers it until a frame-to-named lift exists\"\n264:              {:rule :not-yet-supported})))\n265:   (store [this] (:store this))\n266:   (continuation [this] (:continuation this)))"}]}],"meta":{"source":"tool","messageId":"12ff94f5-1174-433d-9e27-d858e60b5720"}},{"role":"assistant","content":[{"type":"thinking","thinking":"Next, I'll read the stack VM's test file, the `:push` case (opcode 22) in semantic.cljc, and sections 1–3 of the design document plus the B2 phase box.","signature":""},{"type":"text","text":"Now the stack test file and the semantic.cljc `:push` case.\n\n"},{"type":"tool_use","id":"call_3af075293fa64d75bac29bbc","name":"read_file","input":{"file_path":"/Users/sto/workspace/worktree-debruijn-b2/test/yin/vm/debruijn/stack_test.cljc"}},{"type":"tool_use","id":"call_461ab93f6100459dba745d98","name":"grep","input":{"pattern":":push","path":"/Users/sto/workspace/worktree-debruijn-b2/src/cljc/yin/vm/semantic.cljc","output_mode":"content","-n":true,"-C":10}}],"meta":{"source":"model","createdAt":1790067204854,"messageId":"35d41a25-da70-4d25-b5bc-a6e1e120c9c1"}},{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_3af075293fa64d75bac29bbc","content":[{"type":"text","text":"Read 1/1 file, 321 lines\n1: (ns yin.vm.debruijn.stack-test\n2:   \"B3 (docs/design/yin.vm.debruijn.stack.md, 'B3: de Bruijn VM kernel'):\n3:    completion tests for `yin.vm.debruijn.stack`.\n4: \n5:    Every program here is a hand-built instruction vector: B2 (the\n6:    named-datom lowerer) does not exist yet, so nothing here requires\n7:    `yin.vm.debruijn-code` or a real lowering pass. Parity fixtures pair a\n8:    hand-lowered instruction vector with the equivalent named AST, run each\n9:    through its own VM (a fresh instance every time -- D4, the named VM's\n10:    environment leak, is sidestepped by construction, never reused), and\n11:    compare under B0's normalizer (`yin.vm.debruijn-vm-contract-test/normalize`),\n12:    reused rather than reimplemented.\"\n13:   (:require [clojure.test :refer [deftest is testing]]\n14:             [yin.vm :as v2]\n15:             [yin.vm.debruijn.stack :as dvm]\n16:             [yin.vm.debruijn-vm-contract-test :as b0]\n17:             [yin.vm.test-utils :as tu]))\n18: \n19: \n20: ;; =============================================================================\n21: ;; Helpers\n22: ;; =============================================================================\n23: \n24: (defn- named-value\n25:   \"Run `ast` on a fresh named VM and return its normalized value.\"\n26:   [ast]\n27:   (b0/normalize (v2/value (v2/eval (tu/create-vm) ast))))\n28: \n29: \n30: (defn- debruijn-value\n31:   \"Run `segment` on a fresh de Bruijn VM (with the standard primitive\n32:    registry, matching the named VM's own default -- `yin.vm/empty-state`)\n33:    and return its normalized value.\"\n34:   ([segment] (debruijn-value segment {}))\n35:   ([segment opts]\n36:    (b0/normalize\n37:      (v2/value (v2/run (dvm/create-vm segment\n38:                                       (merge {:primitives v2/primitives}\n39:                                              opts)))))))\n40: \n41: \n42: (defn- lit\n43:   [v]\n44:   {:type :literal, :value v})\n45: \n46: \n47: (defn- variable\n48:   [n]\n49:   {:type :variable, :name n})\n50: \n51: \n52: (defn- lambda\n53:   [params body]\n54:   {:type :lambda, :params params, :body body})\n55: \n56: \n57: (defn- app\n58:   [f & args]\n59:   {:type :application, :operator f, :operands (vec args)})\n60: \n61: \n62: ;; =============================================================================\n63: ;; 1. Literals\n64: ;; =============================================================================\n65: \n66: (deftest literal-test\n67:   (testing \"a bare :const, no locals, no calls\"\n68:     (is (= (named-value (lit 42))\n69:            (debruijn-value [[:const 42] [:halt]])\n70:            42))))\n71: \n72: \n73: ;; =============================================================================\n74: ;; 2. Variable loads: bound\n75: ;; =============================================================================\n76: \n77: (deftest load-bound-identity-test\n78:   (testing \"a one-arg closure returning its own argument -- depth 0,\n79:             position 0, the innermost frame\"\n80:     (let [ast (app (lambda '[x] (variable 'x)) (lit 42))\n81:           segment [[:closure 1 4]  ; 0: closure, body at pc 4\n82:                    [:const 42]     ; 1\n83:                    [:call 1 false] ; 2\n84:                    [:halt]         ; 3\n85:                    [:load-bound 0 0]  ; 4: body\n86:                    [:return]]         ; 5\n87:           result (debruijn-value segment)]\n88:       (is (= 42 result))\n89:       (is (= (named-value ast) result)))))\n90: \n91: \n92: ;; =============================================================================\n93: ;; 3. Variable loads: free, via primitives -- and :call applying a\n94: ;;    resolved primitive host function\n95: ;; =============================================================================\n96: \n97: (deftest load-free-primitive-test\n98:   (testing \"(+ 3 4) via :load-free '+ resolved through the primitive\n99:             registry, then :call applying the resolved host function\"\n100:     (let [ast (app (variable '+) (lit 3) (lit 4))\n101:           segment [[:load-free '+]   ; 0\n102:                    [:const 3]        ; 1\n103:                    [:const 4]        ; 2\n104:                    [:call 2 false]   ; 3\n105:                    [:halt]]          ; 4\n106:           result (debruijn-value segment)]\n107:       (is (= 7 result))\n108:       (is (= (named-value ast) result)))))\n109: \n110: \n111: (deftest load-free-store-fallback-test\n112:   (testing \"a free name absent from primitives and free-env resolves\n113:             through the store -- the same env -> store -> primitives ->\n114:             module registry order `yin.vm.engine/resolve-var` already\n115:             implements for the named VM; positional locals never take this\n116:             path, only :load-free does\"\n117:     (let [segment [[:load-free 'y] [:halt]]\n118:           result (debruijn-value segment {:store {'y 55}})]\n119:       (is (= 55 result)))))\n120: \n121: \n122: ;; =============================================================================\n123: ;; 4. Closures: nested capture, multiple arities, under/over-arity calls\n124: ;; =============================================================================\n125: \n126: (deftest nested-closure-capture-test\n127:   (testing \"((fn [x] (fn [y] (- x y))) 3) 4) -- the inner closure's body\n128:             reaches the outer frame at depth 1. `-` (non-commutative) is\n129:             deliberate: a flipped-direction addressing bug would compute\n130:             (- y x) = 1 instead of (- x y) = -1, so this pins the\n131:             innermost-frame-is-last convention, not merely a result\"\n132:     (let [ast (app\n133:                 (app (lambda '[x] (lambda '[y] (app (variable '-)\n134:                                                     (variable 'x)\n135:                                                     (variable 'y))))\n136:                      (lit 3))\n137:                 (lit 4))\n138:           segment [[:closure 1 6]   ; 0: outer closure, body at 6\n139:                    [:const 3]       ; 1\n140:                    [:call 1 false]  ; 2: apply outer(3) -> inner closure\n141:                    [:const 4]       ; 3\n142:                    [:call 1 false]  ; 4: apply inner(4) -> -1\n143:                    [:halt]          ; 5\n144:                    [:closure 1 8]   ; 6: inner closure, body at 8\n145:                    [:return]        ; 7\n146:                    [:load-free '-]     ; 8: body of inner\n147:                    [:load-bound 1 0]   ; 9: x, outer frame\n148:                    [:load-bound 0 0]   ; 10: y, inner frame\n149:                    [:call 2 false]     ; 11\n150:                    [:return]]          ; 12\n151:           result (debruijn-value segment)]\n152:       (is (= -1 result))\n153:       (is (= (named-value ast) result)))))\n154: \n155: \n156: (deftest zero-arity-closure-test\n157:   (testing \"a thunk -- multiple arities coverage, arity 0\"\n158:     (let [ast (app (lambda [] (lit 99)))\n159:           segment [[:closure 0 3]   ; 0\n160:                    [:call 0 false]  ; 1\n161:                    [:halt]          ; 2\n162:                    [:const 99]      ; 3: body\n163:                    [:return]]       ; 4\n164:           result (debruijn-value segment)]\n165:       (is (= 99 result))\n166:       (is (= (named-value ast) result)))))\n167: \n168: \n169: (defn- conj-pair-ast\n170:   \"(fn [a b] (conj (conj [] a) b)) -- named AST for the two-arg closure the\n171:    under/over-arity tests below apply.\"\n172:   []\n173:   (lambda '[a b]\n174:           (app (variable 'conj)\n175:                (app (variable 'conj) (lit []) (variable 'a))\n176:                (variable 'b))))\n177: \n178: \n179: (defn- conj-pair-segment\n180:   \"The de Bruijn body for `conj-pair-ast`, laid out starting at `body-pc`\n181:    in the caller's comments (the body has no internal jump/branch targets,\n182:    so its absolute position does not affect these instructions themselves;\n183:    `body-pc` documents the intended placement at each call site rather\n184:    than being used to compute anything here): push the outer operator,\n185:    then the inner application (its own operator, [], a, call), then b,\n186:    then the outer call and return -- 'applications evaluate operator then\n187:    operands' (section 3), applied recursively.\"\n188:   [_body-pc]\n189:   [[:load-free 'conj]       ; body-pc + 0: outer operator\n190:    [:load-free 'conj]       ; body-pc + 1: inner operator\n191:    [:const []]               ; body-pc + 2\n192:    [:load-bound 0 0]         ; body-pc + 3: a\n193:    [:call 2 false]           ; body-pc + 4: conj([], a)\n194:    [:load-bound 0 1]         ; body-pc + 5: b\n195:    [:call 2 false]           ; body-pc + 6: conj(r1, b)\n196:    [:return]])                ; body-pc + 7\n197: \n198: \n199: (deftest under-arity-call-nil-fills-test\n200:   (testing \"a 2-arity closure called with 1 argument nil-fills the missing\n201:             parameter, matching engine/bind-params' zip-and-nil-fill rule\"\n202:     (let [ast (app (conj-pair-ast) (lit 1))\n203:           segment (into [[:closure 2 4]   ; 0: closure, body at 4\n204:                          [:const 1]        ; 1\n205:                          [:call 1 false]   ; 2: only 1 arg for arity 2\n206:                          [:halt]]          ; 3\n207:                         (conj-pair-segment 4))\n208:           result (debruijn-value segment)]\n209:       (is (= [1 nil] result))\n210:       (is (= (named-value ast) result)))))\n211: \n212: \n213: (deftest over-arity-call-drops-extras-test\n214:   (testing \"a 2-arity closure called with 3 arguments drops the extra,\n215:             matching engine/bind-params' zip-stops-at-shorter rule\"\n216:     (let [ast (app (conj-pair-ast) (lit 1) (lit 2) (lit 3))\n217:           segment (into [[:closure 2 6]   ; 0: closure, body at 6\n218:                          [:const 1]        ; 1\n219:                          [:const 2]        ; 2\n220:                          [:const 3]        ; 3\n221:                          [:call 3 false]   ; 4: 3 args for arity 2\n222:                          [:halt]]          ; 5\n223:                         (conj-pair-segment 6))\n224:           result (debruijn-value segment)]\n225:       (is (= [1 2] result))\n226:       (is (= (named-value ast) result)))))\n227: \n228: \n229: ;; =============================================================================\n230: ;; 5. if / :branch-false, both arms\n231: ;; =============================================================================\n232: \n233: (deftest branch-true-arm-test\n234:   (let [ast {:type :if, :test (lit true), :consequent (lit \"T\"),\n235:              :alternate (lit \"F\")}\n236:         segment [[:const true]        ; 0\n237:                  [:branch-false 4]    ; 1\n238:                  [:const \"T\"]         ; 2\n239:                  [:jump 5]            ; 3\n240:                  [:const \"F\"]         ; 4\n241:                  [:halt]]             ; 5\n242:         result (debruijn-value segment)]\n243:     (is (= \"T\" result))\n244:     (is (= (named-value ast) result))))\n245: \n246: \n247: (deftest branch-false-arm-test\n248:   (let [ast {:type :if, :test (lit false), :consequent (lit \"T\"),\n249:              :alternate (lit \"F\")}\n250:         segment [[:const false]       ; 0\n251:                  [:branch-false 4]    ; 1\n252:                  [:const \"T\"]         ; 2\n253:                  [:jump 5]            ; 3\n254:                  [:const \"F\"]         ; 4\n255:                  [:halt]]             ; 5\n256:         result (debruijn-value segment)]\n257:     (is (= \"F\" result))\n258:     (is (= (named-value ast) result))))\n259: \n260: \n261: ;; =============================================================================\n262: ;; 6. Store get/put\n263: ;; =============================================================================\n264: \n265: (deftest store-get-put-sequenced-test\n266:   (testing \"a put, then a get of the same key from inside a called\n267:             closure -- the named side sequences the two through\n268:             application operand order (operator then operands, section 3),\n269:             since the Universal AST has no explicit sequencing node\"\n270:     (let [ast (app (lambda '[ignored] {:type :vm/store-get, :key :b0/k})\n271:                    {:type :vm/store-put, :key :b0/k, :val 123})\n272:           segment [[:closure 1 4]              ; 0: body at 4\n273:                    [:store-put :b0/k 123]      ; 1\n274:                    [:call 1 false]             ; 2\n275:                    [:halt]                     ; 3\n276:                    [:store-get :b0/k]          ; 4: body, ignores its arg\n277:                    [:return]]                  ; 5\n278:           result (debruijn-value segment)]\n279:       (is (= 123 result))\n280:       (is (= (named-value ast) result)))))\n281: \n282: \n283: ;; =============================================================================\n284: ;; 7. Fresh-instance parity, not reuse\n285: ;; =============================================================================\n286: \n287: (deftest fresh-instance-per-run-test\n288:   (testing \"every comparison above ran two independent fresh VMs (one\n289:             named, one de Bruijn); this test only re-confirms that running\n290:             the same de Bruijn segment twice from two fresh instances\n291:             agrees with itself, the same self-parity shape\n292:             `named-vm-self-parity-test` in the B0 contract test uses\"\n293:     (let [segment [[:const 7] [:halt]]]\n294:       (is (= (debruijn-value segment) (debruijn-value segment) 7)))))\n295: \n296: \n297: ;; =============================================================================\n298: ;; 8. Out-of-scope opcodes fail loudly\n299: ;; =============================================================================\n300: \n301: (deftest not-yet-implemented-opcode-test\n302:   (testing \"an opcode outside B3's scope (stream ops, primitives/FFI as\n303:             effects, gensym, current-continuation, park, resume) throws a\n304:             clear :not-yet-implemented error instead of silently no-oping\"\n305:     (let [segment [[:current-continuation]]]\n306:       (is (thrown-with-msg?\n307:             #?(:clj Exception :cljs js/Error :cljd Object)\n308:             #\"Not yet implemented in B3\"\n309:             (v2/run (dvm/create-vm segment)))))))\n310: \n311: \n312: ;; =============================================================================\n313: ;; 9. environment is not implemented\n314: ;; =============================================================================\n315: \n316: (deftest environment-not-implemented-test\n317:   (testing \"point 8: vm/IVMState/environment is not implemented at all in\n318:             this phase, rather than returning the raw positional frame\n319:             vector\"\n320:     (is (thrown? #?(:clj Exception :cljs js/Error :cljd Object)\n321:           (v2/environment (dvm/create-vm [[:halt]]))))))"}]},{"type":"tool_result","tool_use_id":"call_461ab93f6100459dba745d98","content":[{"type":"text","text":"src/cljc/yin/vm/semantic.cljc-265-                                           (:modules vm) (nth inst 1))\n/Users/sto/workspace/worktree-debruijn-b2/src/cljc/yin/vm/semantic.cljc-266-                       St E K vm image (and fuel (dec fuel)))\nsrc/cljc/yin/vm/semantic.cljc-267-              ;; :closure — val ← clo(params, entry, seg, E) (4, :lambda)\n/Users/sto/workspace/worktree-debruijn-b2/src/cljc/yin/vm/semantic.cljc-268-              4 (recur seg (inc pc)\nsrc/cljc/yin/vm/semantic.cljc-269-                       {:type :closure,\nsrc/cljc/yin/vm/semantic.cljc-270-                        :params (nth inst 1),\nsrc/cljc/yin/vm/semantic.cljc-271-                        :entry (nth inst 2),\nsrc/cljc/yin/vm/semantic.cljc-272-                        :segment seg,\nsrc/cljc/yin/vm/semantic.cljc-273-                        :env E}\n/Users/sto/workspace/worktree-debruijn-b2/src/cljc/yin/vm/semantic.cljc-274-                       St E K vm image (and fuel (dec fuel)))\nsrc/cljc/yin/vm/semantic.cljc:275:              ;; :push — St ← St ⧺ [val] (22, :push)\n/Users/sto/workspace/worktree-debruijn-b2/src/cljc/yin/vm/semantic.cljc-276-              22 (recur seg (inc pc) val (conj St val) E K vm image\n/Users/sto/workspace/worktree-debruijn-b2/src/cljc/yin/vm/semantic.cljc-277-                        (and fuel (dec fuel)))\nsrc/cljc/yin/vm/semantic.cljc-278-              ;; :jump — pc