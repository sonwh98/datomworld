  (= owner (.-owner ^Continuation other))\n                          (= payload (.-payload ^Continuation other))))\n             cljd.core/IHash\n             (-hash [_] (hash [:continuation owner payload]))\n             cljd.core/IPrint\n             (-print [_ sink] (.write sink (:continuation marker-text)))\n414:   descriptor] position] among the census's distinct labels in bytewise\n421:        ranks (into {} (map-indexed (fn [i l] [l i]) (sort-by-key! ctx identity (distinct (vals labels)))))]\n480:      (= :set kind) (unordered! run n :set (vec slots) path)\n522:    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n564:                     :cursor-cells (vec (sort-by str (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g)))\n640:            tied-elems (set (mapcat :elems tied))\n674:          (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n781:              (set? x) [:set (set (map literal-value x))]\n793:                       :set [:set (set (map value ss))]\n811:                  (when-not (= (count decoded) (count (distinct decoded))) (bad! :duplicate-key path))))\n835:              (when-not (= (set (keys cursor-cells)) @reached) (bad! :extra-cursor-cell (conj path 9)))))]\n850:     (when-not (and (= #{:yin.k/handoff :yin.k/version :yin.k/root :yin.k/rows} (set (keys wire)))\n902:                                          (not (contains? (set (rest d)) (second (get index target)))))\n907:           (when-not (= @seen (set (keys index))) (bad! :unreachable-row [:yin.k/rows]))))\n933:             (when-not (and (= (count keys) (count (distinct keys)))\n934:                            (= (count keys) (count (distinct (map #(bytes-key (cbor/encode %)) keys)))))\n1040:   references as [:row abstract-row] or [:cursor-cell id], distinct from guest maps.\n1314:   canonical bytes, distinct from the semantic root id it carries (§3.3).\"\n1487:      (set? x) (collection-value ctx :se