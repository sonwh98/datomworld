{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^### 8.4|''^### 8.5'\"' docs/design/yin.vm.semantic-register-vm.continuation.md; sed -n '129,145p' collab/1792050511876-architect-8f1-ruling.report.md; rg -n 'semantic/|linearize/|code/' test/yin/vm/{semantic_engine_test,semantic_ffi_test,semantic_stream_observer_test,rule_r_test,test_utils}.cljc; cat src/cljc/yin/vm/semantic_register.cljc | head -100; rg -n '\"'^'\"\\\\(defn|\"'^'\"\\\\(def ' src/cljc/yin/vm/semantic_register.cljc src/cljc/yin/vm/semantic_register/linearize.cljc\"","aggregated_output":"2168:### 8.4 Phase 7's entry conditions\n2184:### 8.5 Ordering and concurrency\n\nRULING-READY\ntest/yin/vm/semantic_ffi_test.cljc:27:    (linearize/ast-loader semantic/vm-load-program)\ntest/yin/vm/semantic_ffi_test.cljc:33:  ([opts] (semantic/create-vm\ntest/yin/vm/semantic_ffi_test.cljc:331:  (let [bare (semantic/create-vm {})]\ntest/yin/vm/semantic_ffi_test.cljc:335:      (is (throws? (fn [] (semantic/create-vm {:bridge {:op/echo identity}})))))\ntest/yin/vm/test_utils.cljc:167:                          (linearize/rows-loader semantic/load-vector)\ntest/yin/vm/semantic_engine_test.cljc:23:    (linearize/ast-loader semantic/vm-load-program)\ntest/yin/vm/semantic_engine_test.cljc:29:  (semantic/create-vm {:make-stream tu/make-stream,\ntest/yin/vm/semantic_stream_observer_test.cljc:8:   `(linearize/rows-loader semantic/load-vector)` beside\ntest/yin/vm/semantic_stream_observer_test.cljc:94:  (vm/fresh-code-loader (linearize/rows-loader semantic/load-vector)\ntest/yin/vm/semantic_stream_observer_test.cljc:100:    (linearize/ast-loader semantic/vm-load-program)\ntest/yin/vm/semantic_stream_observer_test.cljc:112:   (tu/make-observer-session (semantic/create-vm {:make-stream tu/make-stream,\ntest/yin/vm/semantic_stream_observer_test.cljc:237:  (let [new-vm #(semantic/create-vm {:make-stream tu/make-stream,\ntest/yin/vm/semantic_stream_observer_test.cljc:327:                      (linearize/lower-ast (binop '* (lit 6) (lit 7))))\ntest/yin/vm/semantic_stream_observer_test.cljc:332:                                         #(semantic/vm-load-program\ntest/yin/vm/rule_r_test.cljc:86:  \"A `:yin.code/*` segment batch whose instructions are `tuples`, positional\ntest/yin/vm/rule_r_test.cljc:87:   operands named by `code/vector-operand-table` (no `:pc` operands).\"\ntest/yin/vm/rule_r_test.cljc:89:  (into [[-1 :yin.code/type :segment 0 0]\ntest/yin/vm/rule_r_test.cljc:90:         [-1 :yin.code/length (count tuples) 0 0]]\ntest/yin/vm/rule_r_test.cljc:93:                    (into [[e :yin.code/segment -1 0 0]\ntest/yin/vm/rule_r_test.cljc:94:                           [e :yin.code/pc pc 0 0]\ntest/yin/vm/rule_r_test.cljc:95:                           [e :yin.code/op (nth t 0) 0 0]]\ntest/yin/vm/rule_r_test.cljc:97:                               (get code/vector-operand-table (nth t 0))\ntest/yin/vm/rule_r_test.cljc:117:  (vm/run (semantic/vm-load-program\ntest/yin/vm/rule_r_test.cljc:118:            (semantic/create-vm {:make-stream tu/make-stream,\ntest/yin/vm/rule_r_test.cljc:120:            (linearize/lower-ast ast)\ntest/yin/vm/rule_r_test.cljc:126:  (vm/run (dvm/create-vm (:image (derive/stack-image (:vector (sr-linearize/project ast))))\ntest/yin/vm/rule_r_test.cljc:135:  (vm/run (rvm/create-vm (derive/register-image (:vector (sr-linearize/project ast)))\ntest/yin/vm/rule_r_test.cljc:271:      (is (= :reserved-name (rule-of #(linearize/lower-ast ast)))\ntest/yin/vm/rule_r_test.cljc:274:             (rule-of #(derive/stack-image (:vector (sr-linearize/project ast)))))\ntest/yin/vm/rule_r_test.cljc:299:      (is (= :reserved-name (:rule (code/well-formed-vector? v))))\ntest/yin/vm/rule_r_test.cljc:301:             (rule-of #(semantic/load-vector (semantic/create-vm) v\ntest/yin/vm/rule_r_test.cljc:311:             (rule-of #(semantic/vm-load-program\ntest/yin/vm/rule_r_test.cljc:312:                         (semantic/create-vm)\ntest/yin/vm/rule_r_test.cljc:425:             \"semantic env\" #(semantic/create-vm {:env bound}),\ntest/yin/vm/rule_r_test.cljc:426:             \"semantic registry\" #(semantic/create-vm {:primitives registry}),\ntest/yin/vm/rule_r_test.cljc:452:             \"semantic\" #(semantic/create-vm {:modules registry}),\ntest/yin/vm/rule_r_test.cljc:541:        batch (linearize/lower-ast ast)\ntest/yin/vm/rule_r_test.cljc:542:        v1 (:vector (linearize/lower-rows rows))\ntest/yin/vm/rule_r_test.cljc:543:        stack-image (:image (derive/stack-image (:vector (sr-linearize/project ast))))\ntest/yin/vm/rule_r_test.cljc:544:        register-image* (derive/register-image (:vector (sr-linearize/project ast)))\ntest/yin/vm/rule_r_test.cljc:551:         \"semantic datoms\" [#(semantic/vm-load-program (semantic/create-vm)\ntest/yin/vm/rule_r_test.cljc:554:         \"semantic vector\" [#(semantic/load-vector (semantic/create-vm) v1 %)\ntest/yin/vm/rule_r_test.cljc:585:          load-ast (linearize/ast-loader semantic/vm-load-program)\ntest/yin/vm/rule_r_test.cljc:586:          load-rows (linearize/rows-loader semantic/load-vector)\ntest/yin/vm/rule_r_test.cljc:587:          adapters {\"ast-loader\" #(load-ast (semantic/create-vm) datoms %)\ntest/yin/vm/rule_r_test.cljc:588:                    \"rows-loader\" #(load-rows (semantic/create-vm) rows %)}]\ntest/yin/vm/rule_r_test.cljc:601:                 (linearize/ast-loader semantic/vm-load-program)\ntest/yin/vm/rule_r_test.cljc:603:      (is (= 3 (vm/value (vm/run (load (semantic/create-vm)\n(ns yin.vm.semantic-register\n  \"The register-shaped canonical evaluator, phase 4b (effects, continuations, FFI and module installation).\"\n  (:require [dao.jing :as jing]\n            [dao.stream.apply :as apply2]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.ffi :as ffi]\n            [yin.vm.module :as module]\n            [yin.vm.telemetry :as telemetry]\n            [yin.vm.values :as values]\n            [yin.vm.semantic-register.code :as code]\n            [yin.vm.semantic-register.linearize :as linearize]\n            [yin.vm.semantic-register.analysis :as analysis]))\n\n\n(defrecord RegisterVM\n  [blocked?       ; boolean, true if blocked\n   bridge         ; explicit host-side FFI bridge state\n   halted?        ; boolean, true when active continuation has completed\n   k              ; continuation, a vector of frames (innermost last) or nil\n   program        ; segment id of the last loaded batch\n   control        ; {:segment id :pc n} or nil\n   env            ; persistent lexical scope map\n   free-env       ; checked initial environment, fixed for this instance\n   window         ; sparse body-local register map\n   id-counter     ; integer counter for unique IDs\n   parked         ; parked continuations map\n   primitives     ; primitive operations map\n   primitive-profiles ; portable primitive profile projection\n   primitive-canonical-names ; declared aliases for identity reverse lookup\n   modules        ; module registry value\n   make-stream    ; host-supplied stream constructor, or nil\n   call-capacity  ; declared capacity of the FFI pair\n   ready-queue    ; vector of runnable continuations\n   store          ; heap memory map\n   value          ; last computed value\n   wait-set       ; vector of continuations waiting on a transport\n   telemetry      ; telemetry config map ({:stream … :vm-id …}) or nil\n   telemetry-step ; telemetry snapshot counter\n   telemetry-t    ; telemetry transaction counter\n   telemetry-eid  ; telemetry entity-id seed, floored at datom/first-user-id\n   vm-model       ; telemetry model keyword\n   vm-id          ; telemetry instance id, minted by telemetry/install\n   code           ; {segment-id image}; built once per segment, never written\n   code-aliases   ; {address segment-id}; additive, one address one id (UCF §7.3.4)\n   gc])           ; {:since :base :threshold :pinned}: heap reclamation\n\n\n\n(defn put-registers\n  \"Materialize control, window, environment and continuation; value is exit-only.\"\n  [machine seg pc W E K]\n  (assoc machine :control (when seg {:segment seg :pc pc})\n         :window W :env E :k (when (seq K) K)\n         :halted? (and (not (:blocked? machine)) (nil? seg))))\n\n\n(defn- return-to\n  \"The one popped-frame delivery: retain exactly the saved window and write rd.\"\n  [frame value]\n  (assoc frame :window (assoc (:window frame) (:rd frame) value)))\n\n\n(defn- act-payload\n  [seg pc E W K rd facts]\n  {:segment seg :pc (inc pc) :env E\n   :window (select-keys W (analysis/saved facts (inc pc) rd))\n   :k K :deliver {:deliver :rd :rd rd}})\n\n\n(defn- entry-builders\n  [payload]\n  {:stream/put (fn [_state _effect result]\n                 (assoc payload :reason :put :stream-id (:stream-id result)))\n   :stream/next (fn [_state _effect result]\n                  (assoc payload :reason :next :cursor-ref (:cursor-ref result)\n                         :stream-id (:stream-id result)))\n   :module/require (fn [_state _effect _result] payload)})\n\n\n(defn- act-builders\n  [seg pc E W K rd facts]\n  (entry-builders (act-payload seg pc E W K rd facts)))\n\n\n(defn- tail-builders\n  [seg pc K]\n  (entry-builders {:segment seg :site pc :k K :deliver {:deliver :return}}))\n\n\n(defn- run-effect\n  [machine seg pc W E K effect builders]\n  (let [{:keys [state value blocked?]}\n        (engine/handle-effect (put-registers machine seg pc W E K) effect\n                              (when builders {:park-entry-fns builders}))]\n    (if blocked?\n      {:stop (assoc state :control nil :k nil)}\n      {:continue [state value]})))\n\n\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:27:(def unsupported\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:33:(def ^:private slot-position\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:46:(def ^:private defaults\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:55:(defn- flatten-tree\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:177:(defn- row-reader\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:188:(defn project-rows\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:217:(defn project\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:228:(defn- datom-attr\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:236:(defn- reject-host-value!\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:243:(defn- datom-reader\nsrc/cljc/yin/vm/semantic_register/linearize.cljc:283:(defn project-datoms\nsrc/cljc/yin/vm/semantic_register.cljc:50:(defn put-registers\nsrc/cljc/yin/vm/semantic_register.cljc:58:(defn- return-to\nsrc/cljc/yin/vm/semantic_register.cljc:64:(defn- act-payload\nsrc/cljc/yin/vm/semantic_register.cljc:71:(defn- entry-builders\nsrc/cljc/yin/vm/semantic_register.cljc:81:(defn- act-builders\nsrc/cljc/yin/vm/semantic_register.cljc:86:(defn- tail-builders\nsrc/cljc/yin/vm/semantic_register.cljc:91:(defn- run-effect\nsrc/cljc/yin/vm/semantic_register.cljc:101:(defn register-restore\nsrc/cljc/yin/vm/semantic_register.cljc:129:(defn- scheduler-round\nsrc/cljc/yin/vm/semantic_register.cljc:134:(defn vm-hot\nsrc/cljc/yin/vm/semantic_register.cljc:271:(defn- register-run-scheduler\nsrc/cljc/yin/vm/semantic_register.cljc:277:(defn- store-image\nsrc/cljc/yin/vm/semantic_register.cljc:286:(defn- store-alias\nsrc/cljc/yin/vm/semantic_register.cljc:295:(defn- admit-image\nsrc/cljc/yin/vm/semantic_register.cljc:303:(defn load-vector\nsrc/cljc/yin/vm/semantic_register.cljc:314:(defn attach-image\nsrc/cljc/yin/vm/semantic_register.cljc:322:(defn load-ast\nsrc/cljc/yin/vm/semantic_register.cljc:350:(defn create-vm\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"The ruling confirms that shrinking UCF would break the old kernel while it still exists. I’ll port and verify consumers first, then remove the old kernel and shrink UCF together. I’ll keep a test ledger and leave the rename, docs, and C4 manifest goldens untouched."}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2168,2185p' docs/design/yin.vm.semantic-register-vm.continuation.md; sed -n '303,350p' src/cljc/yin/vm/semantic_register.cljc; cat test/yin/vm/semantic_engine_test.cljc | head -90; sed -n '280,345p' test/yin/vm/semantic_stream_observer_test.cljc; sed -n '80,125p' test/yin/vm/rule_r_test.cljc; sed -n '255,320p' test/yin/vm/rule_r_test.cljc; rg -n 'semantic/|linearize/' src/{cljc/datomworld/demo/continuation_handoff.cljc,cljs/datomworld/demo/continuation_stream.cljs,cljd/yin/register_bench_cljd.cljd} test/bench/yin_vm_bench.cljc; command -v clj\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '2168,2185p' docs/design/yin.vm.semantic-register-vm.continuation.md; sed -n '303,350p' src/cljc/yin/vm/semantic_register.cljc; cat test/yin/vm/semantic_engine_test.cljc | head -90; sed -n '280,345p' test/yin/vm/semantic_stream_observer_test.cljc; sed -n '80,125p' test/yin/vm/rule_r_test.cljc; sed -n '255,320p' test/yin/vm/rule_r_test.cljc; rg -n 'semantic/|linearize/' src/{cljc/datomworld/demo/continuation_handoff.cljc,cljs/datomworld/demo/continuation_stream.cljs,cljd/yin/register_bench_cljd.cljd} test/bench/yin_vm_bench.cljc; command -v clj\"","aggregated_output":"### 8.4 Phase 7's entry conditions\n\n**Amended after 7 (2026-10-14)** — Reason: phases 6 and 7a-7c now provide the entry seams; 7d reports the Stage E port.\nPhase 7's entry conditions are met: the phase-6 row carrier and frame/layout\nharness are available; the holder, rows checkpoint inspector, ledger and\nauthority use packs; free-environment retention is threaded through the\nlift; recovery format 2 is based on rows. The Stage D composition uses\nsemantic-register machines and the composition's function `:source-index`\nseam. The 7d report records the corresponding Stage E world/scenario port\nand local JVM results; 7d is still in review. Entry readiness is not\ntri-host phase acceptance: Node/Dart Stage E and the killed four-pair\nJVM/Node process matrix remain the orchestrator's gates. The owner accepts\nthe REPL custody gap until phase 8. Versions 0/1/2 remain only as direct\nlegacy codecs/tests until phase 8, without compatibility or version dispatch\nin the row holder/authority path. The two backends remain as §4.6 specifies.\n\n### 8.5 Ordering and concurrency\n\n(defn load-vector\n  \"Validate and load a v4 vector; an existing address retains its local id.\"\n  ([machine v stamp] (load-vector machine v stamp {}))\n  ([machine v stamp opts]\n   (let [image (admit-image machine v stamp opts) seg (:segment image)]\n     (assoc machine :code (store-image (:code machine) image)\n            :code-aliases (store-alias (:code-aliases machine) image)\n            :program seg :control {:segment seg :pc 0} :window {} :k nil\n            :halted? false :blocked? false :value nil))))\n\n\n(defn attach-image\n  \"Attach a validated vector without changing execution fields.\"\n  [machine v stamp]\n  (let [image (admit-image machine v stamp {})]\n    (assoc machine :code (store-image (:code machine) image)\n           :code-aliases (store-alias (:code-aliases machine) image))))\n\n\n(defn load-ast\n  \"Project AST datoms through the phase-3 loader.\"\n  [machine datoms stamp]\n  (vm/check-contract! vm/ast-contract stamp)\n  (load-vector machine (:vector (linearize/project-datoms datoms)) code/contract))\n\n\n(extend-type RegisterVM\n  vm/IVM\n  (step [machine] (telemetry/emit-snapshot\n                    (if (engine/ready-for-ingress? machine) machine (vm-hot machine 1)) :step))\n  (run [machine] (ffi/maybe-run machine register-run-scheduler))\n  (eval [machine ast]\n    (when ast (throw (ex-info \"The register VM executes loaded vectors; use load-ast\" {:ast ast})))\n    (engine/restore-initial-env (:env machine) (vm/run machine)))\n  (reset [machine]\n    (assoc machine :control (when-let [seg (:program machine)] {:segment seg :pc 0})\n           :window {} :k nil :value nil :halted? (nil? (:program machine)) :blocked? false))\n  (halted? [machine] (engine/halted-with-empty-queue? machine))\n  (blocked? [machine] (engine/vm-blocked? machine))\n  (value [machine] (engine/vm-value machine))\n  vm/IVMState\n  (control [machine] (:control machine))\n  (environment [machine] (:env machine))\n  (store [machine] (:store machine))\n  (continuation [machine] (:k machine)))\n\n\n(defn create-vm\n(ns yin.vm.semantic-engine-test\n  \"The blocked-read and put cases of `engine_test.cljc`, reached through the\n   semantic VM: lowered `:stream-*` instructions dispatch the engine's effects,\n   and a read that cannot proceed parks into a pure-data wait set.\"\n  (:require [clojure.edn :as edn]\n            [clojure.test :refer [deftest is testing]]\n            [dao.stream :as stream]\n            [yin.vm :as vm]\n            [yin.vm.linearize :as linearize]\n            [yin.vm.semantic :as semantic]\n            [yin.vm.test-utils :as tu]))\n\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:clj Exception :cljs js/Error :cljd Object) _ true)))\n\n\n;; this suite is the AST's only producer: the trusted fresh path\n(def ^:private load-ast\n  (vm/fresh-code-loader\n    (linearize/ast-loader semantic/vm-load-program)\n    vm/ast-contract))\n\n\n(defn- make-vm\n  []\n  (semantic/create-vm {:make-stream tu/make-stream,\n                       :capability-secret tu/secret}))\n\n\n(defn- run-ast\n  ([ast] (run-ast (make-vm) ast))\n  ([vm ast] (vm/run (load-ast vm (vm/ast->datoms ast)))))\n\n\n(defn- lit\n  [v]\n  {:type :literal, :value v})\n\n\n(defn- var-ref\n  [n]\n  {:type :variable, :name n})\n\n\n(defn- let1\n  \"`((fn [param] body) init)`.\"\n  [param init body]\n  {:type :application,\n   :operator {:type :lambda, :params [param], :body body},\n   :operands [init]})\n\n\n(defn- read-first\n  \"Make a stream of `capacity`, mint a cursor on it, and read one value.\"\n  [capacity]\n  (let1 's\n        {:type :stream/make, :buffer capacity}\n        {:type :stream/next,\n         :source {:type :stream/cursor, :source (var-ref 's)}}))\n\n\n(defn- blocked-reader\n  \"Run `read-first` on an empty stream: the parked VM and the stream handle.\"\n  [capacity]\n  (let [parked (run-ast (read-first capacity))\n        entry (first (:wait-set parked))]\n    [parked (get (:resources parked) (:stream-id entry))]))\n\n\n(defn- host-value?\n  [x]\n  (some fn? (tree-seq coll? seq x)))\n\n\n;; =============================================================================\n;; Blocked reads\n;; =============================================================================\n\n(deftest an-empty-stream-parks-the-reader-test\n  (let [[parked handle] (blocked-reader 4)\n        entry (first (:wait-set parked))]\n    (testing \"The reader parks with one polling wait entry\"\n      (is (vm/blocked? parked))\n      (is (stream/writer? handle))\n      (is (= 1 (count (:wait-set parked))))\n      (is (= :next (:reason entry)))\n      (is (= :cursor-ref (get-in entry [:cursor-ref :type]))))\n          (is (= 5 (vm/value vm))))))\n    (testing \"A blocked program holds the next batch behind the row medium\"\n      (let [session (tu/make-encoder-session (new-vm))]\n        (stream/append! (:program session) (read-first 4))\n        (stream/append! (:program session) (lit 9))\n        (let [run (tu/run-encoder-session session)\n              parked (:consumer (:evaluator run))]\n          (is (vm/blocked? parked))\n          (is (= :blocked (:status (observer/observe-next\n                                     (:observer (:encoder run)))))\n              \"the encoder drained the program medium\")\n          (is (= :ok (:status (observer/observe-next\n                                (:observer (:evaluator run)))))\n              \"the second batch waits on the row medium, ahead of the\n                evaluator's cursor\")\n          (let [entry (first (:wait-set parked))\n                handle (get (:resources parked) (:stream-id entry))]\n            (stream/append! handle :woken)\n            (let [done (:consumer (:evaluator (tu/run-encoder-session run)))]\n              (is (vm/halted? done))\n              (is (= 9 (vm/value done)))\n              (is (= 2 (count (:code done)))))))))))\n\n\n(deftest the-datom-lane-stays-a-legal-composition-test\n  (testing \"A datom medium with the datom-lane loader still runs\"\n    (is (= 5 (vm/value (:consumer (-> (make-session)\n                                      (tu/queue-ast! (binop '+ (lit 2) (lit 3)))\n                                      (run-session load-ast))))))))\n\n\n(deftest a-malformed-row-set-is-rejected-by-the-row-fed-loader-test\n  (doseq [[name [_expected bc]] malformed/malformed-row-sets]\n    (testing (str name)\n      (let [session (make-session)]\n        (stream/append! (:stream (:observer session)) bc)\n        (let [data (throws-ex-data #(run-session session))]\n          (is (some? data))\n          (is (= (:cursor (:observer session))\n                 (:cursor (:observer (:session data))))\n              \"The carried session names the cursor before the failing batch\"))))))\n\n\n(deftest a-code-medium-needs-no-lowering-test\n  (testing \"Which form travels is the composition's choice, not the VM's\"\n    (let [session (make-session)]\n      (stream/append! (:stream (:observer session))\n                      (linearize/lower-ast (binop '* (lit 6) (lit 7))))\n      ;; the medium's one producer is the linearizer above, fresh code, so\n      ;; the composition supplies the current stamp\n      (is (= 42 (vm/value (:consumer\n                            (run-session session\n                                         #(semantic/vm-load-program\n                                            %1 %2 vm/semantic-contract)))))))))\n(defn- rule-of\n  [thunk]\n  (:rule (refusal thunk)))\n\n\n(defn- segment-batch\n  \"A `:yin.code/*` segment batch whose instructions are `tuples`, positional\n   operands named by `code/vector-operand-table` (no `:pc` operands).\"\n  [tuples]\n  (into [[-1 :yin.code/type :segment 0 0]\n         [-1 :yin.code/length (count tuples) 0 0]]\n        (mapcat (fn [pc t]\n                  (let [e (- -2 pc)]\n                    (into [[e :yin.code/segment -1 0 0]\n                           [e :yin.code/pc pc 0 0]\n                           [e :yin.code/op (nth t 0) 0 0]]\n                          (map (fn [[attr _] x] [e attr x 0 0])\n                               (get code/vector-operand-table (nth t 0))\n                               (rest t)))))\n                (range)\n                tuples)))\n\n\n(defn- register-image\n  [n instructions]\n  {:bodies [{:locals 0, :registers n, :start 0,\n             :end (dec (count instructions))}],\n   :instructions instructions})\n\n\n(defn- walker-run\n  [ast]\n  (vm/eval (tu/create-vm) ast))\n\n\n(defn- semantic-run\n  [ast]\n  (vm/run (semantic/vm-load-program\n            (semantic/create-vm {:make-stream tu/make-stream,\n                                 :capability-secret tu/secret})\n            (linearize/lower-ast ast)\n            vm/semantic-contract)))\n\n\n(defn- stack-run\n  [ast]\n\n\n(deftest reserved-roles-are-refused-by-the-walker-datom-and-row-loaders\n  (doseq [[label [ast role]] reserved-asts]\n    (testing label\n      (is (= role (:role (vm/ast-reserved-defect ast))))\n      (is (= :reserved-name\n             (rule-of #(ast-walker/vm-load-program\n                         (tu/create-vm) (vm/ast->datoms ast)\n                         vm/ast-contract)))\n          \"the walker's datom loader validates the whole tree\")\n      (is (= :reserved-name\n             (rule-of #(ast-walker/vm-load-rows\n                         (tu/create-vm) (vm/ast->semantic-bytecode ast)\n                         vm/ast-contract)))\n          \"the row loader's S7.4 validation includes Rule R\")\n      (is (= :reserved-name (rule-of #(linearize/lower-ast ast)))\n          \"the datom lane lowerer refuses\")\n      (is (= :reserved-name\n             (rule-of #(derive/stack-image (:vector (sr-linearize/project ast)))))\n          \"the semantic projection refuses before deriving the stack image\"))))\n\n\n(deftest a-shared-row-is-judged-at-every-occurrence\n  (testing \"one `[:variable yin/def]` row, legal as an operator and\n            illegal as an operand of the same tree\"\n    (let [ast (then (def! 'x (lit 1)) (app (v 'f) (v 'yin/def)))\n          d (vm/validate-rows (vm/ast->semantic-bytecode ast))]\n      (is (= :reserved-name (:rule d)))\n      (is (some? (:path d))))))\n\n\n(deftest reserved-operands-are-refused-by-the-semantic-loaders\n  (doseq [[label v] {\"a :var\" [[:var 'yin/def] [:halt]],\n                     \"the old call shape\" [[:var 'yin/def] [:push]\n                                           [:const 'x] [:push]\n                                           [:const 1] [:push]\n                                           [:call 2 false] [:halt]],\n                     \"a :define key\" [[:const 1] [:define 'yin/def] [:halt]],\n                     \"a binder\" [[:closure '[yin/def] 2] [:halt]\n                                 [:const 1] [:return]],\n                     \"a store-get key\" [[:store-get 'yin/def] [:halt]],\n                     \"a store-put key\" [[:store-put 'yin/def 1] [:halt]]}]\n    (testing label\n      (is (= :reserved-name (:rule (code/well-formed-vector? v))))\n      (is (= :reserved-name\n             (rule-of #(semantic/load-vector (semantic/create-vm) v\n                                             vm/semantic-contract)))\n          \"the vector loader\")))\n  (doseq [[label tuples] {\"a :var\" [[:var 'yin/def] [:halt]],\n                          \"a :define key\" [[:const 1] [:define 'yin/def]\n                                           [:halt]],\n                          \"a store-put key\" [[:store-put 'yin/def 1]\n                                             [:halt]]}]\n    (testing (str label \" (datom loader)\")\n      (is (= :reserved-name\n             (rule-of #(semantic/vm-load-program\n                         (semantic/create-vm)\n                         (segment-batch tuples)\n                         vm/semantic-contract)))))))\n\n\n(deftest reserved-operands-are-refused-by-the-stack-loader\n  (doseq [[label image] {\"the old call shape\" [[:load-free 'yin/def] [:push]\n                                               [:const 'x] [:push]\n                                               [:const 1] [:push]\ntest/bench/yin_vm_bench.cljc:62:  (semantic/vm-load-program (semantic/create-vm) (linearize/lower-a