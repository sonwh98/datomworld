92\t\n   793\t\n   794\t(defn- verified-tree\n   795\t  \"The packet of a macro-store value after its contract is verified\n   796\t   against `vm/ast-contract`: `:contract-missing` for a bare packet or an\n   797\t   entry without one, `:contract-mismatch` for an old stamp.\"\n   798\t  [entry]\n   799\t  (vm/check-contract! vm/ast-contract\n   800\t                      (when (map? entry) (:yin.macro/contract entry)))\n   801\t  (:yin.macro/tree entry))\n   802\t\n   803\t\n   804\t(defn- check-store!\n   805\t  \"A supplied macro store: no reserved name is a macro (Rule R), and every\n   806\t   entry carries the current AST contract. Returns `store`.\"\n   807\t  [store]\n   808\t  (vm/check-bindings! :macro store)\n   809\t  (doseq [entry (vals store)] (verified-tree entry))\n   810\t  store)\n   811\t\n   812\t\n   813\t(defn- invoke*\n   814\t  \"Run one macro body. `entry` is a macro-store value (`macro-entry`),\n   815\t   verified before anything runs. `counter` is the attempt counter, which\n   935\t;; =============================================================================\n   936\t;; Harvest and post-harvest (§3.2 steps 2, 3, 5; §3.5)\n   937\t;; =============================================================================\n   938\t\n   939\t(defn- harvest\n   940\t  \"Initial harvest: iterate definitions in ordinal order; a declared one\n   941\t   installs its lambda packet, a plain one removes the name. Last wins.\n   942\t   A reserved name is never a definition key or a macro name (Rule R).\"\n   943\t  [store index-of definitions]\n   944\t  (reduce (fn [store {:keys [tree name value declared?]}]\n   945\t            (when (vm/reserved-name? name)\n   946\t              (vm/refuse-reserved! :definition-key name))\n   947\t            (if declared?\n   948\t              (assoc store name\n   949\t                     (macro-entry (packet-of (index-of tree) value)\n   950\t                                  vm/ast-contract))\n   951\t              (dissoc store name)))\n   952\t          store\n   953\t          definitions))\n   954\t\n   975\t                  store (cond\n   976\t                          (= standin-tag (row-tag row))\n   977\t                          (let [[_ _ nm k] row\n   978\t                                entry (get catalogue k)]\n   979\t                            (if (and entry (= nm (:name entry)))\n   980\t                              (assoc store nm\n   981\t                                     (macro-entry (:macro-tree entry)\n   982\t                                                  vm/ast-contract))\n   983\t                              store))\n   984\t\n   985\t                          :else\n   986\t                          (if-let [{:keys [name]} (definition-at index a)]\n   987\t                            (dissoc store name)\n   988\t                            store))]\n   989\t              (reduce walk store (children row))))]\n   990\t    (walk store root)))\n  1196\t(defn expand-batch\n  1197\t  \"Expand one input batch against `ctx` (§3.2). Returns\n  1198\t   `{:status :ok :tree packet :log log :ctx ctx'}` or\n  1199\t   `{:status :error :error e :log log :ctx ctx'}`. Either way `ctx'` has\n  1200\t   consumed the batch (`:t` + 1) and every attempt it allocated; only\n  1201\t   success changes the store, to the post-harvest store. A context store\n  1202\t   binding a reserved name, or holding an entry without the current AST\n  1203\t   contract, is refused (Rule R): it is a composition defect, so it throws\n  1204\t   rather than returning an error.\"\n  1205\t  [batch ctx]\n  1206\t  (check-store! (:store ctx))\n  1207\t  (let [ctx (with-default-guards ctx)\n  1208\t        source-batch (:t ctx)\n  1209\t        base {:ctx ctx, :source-batch source-batch, :events [], :produced []}\n  1210\t        finish (fn [st]\n  1211\t                 (let [ctx' (update (:ctx st) :t inc)]\n  1212\t                   (if-let [e (:error st)]\n  1213\t                     {:status :error, :error e, :log (log-packet st), :ctx ctx'}\n  1214\t                     {:status :ok, :tree (:tree st), :log (log-packet st),\n  1215\t                      :ctx (assoc ctx' :store (:next-store st))})))\n  1216\t        {:keys [admitted error]} (admit batch)]\n  1217\t    (if error\n  1218\t      (let [[st counter] (allocate-attempt base)]\n  1274\t(defn make-ctx\n  1275\t  \"An expander context. The composition supplies the incarnation `token`\n  1276\t   and the opaque `source-medium` identity (S3.1); the store may be\n  1277\t   seeded with `macro-entry` values. A seeded store binding a reserved\n  1278\t   name, a macro named `yin/def`, is refused (Rule R), and so is any entry\n  1279\t   whose AST contract is absent (`:contract-missing`) or old\n  1280\t   (`:contract-mismatch`).\"\n  1281\t  [{:keys [token source-medium store guards], eval-fn :eval}]\n  1282\t  (cond-> {:store (check-store! (or store {})),\n  1283\t           :incarnation {:yin.expander/token token},\n  1284\t           :attempt 0,\n  1285\t           :source-medium source-medium,\n  1286\t           :t 0,\n  1287\t           :guards (merge default-guards guards)}\n  1288\t    eval-fn (assoc :eval eval-fn)))\n   355\t                (engine/handle-effect\n   356\t                  state\n   357\t                  effect\n   358\t                  {:restore-fn ast-walker-restore,\n   359\t                   :park-entry-fns {:stream/next\n   360\t                                    (fn [_s _e r]\n   361\t                                      {:k (:next k),\n   362\t                                       :env env,\n   363\t                                       :reason :next,\n   364\t                                       :cursor-ref (:cursor-ref r),\n   365\t                                       :stream-id (:stream-id r)})}})]\n   366\t            (if blocked?\n   367\t              (assoc state\n   368\t                     :control nil\n   369\t                    