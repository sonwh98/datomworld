t   a `DisplayKey` that prints its rendered text and orders by its rank:\n   365\t   `:type` first, then key text, then value text.\"\n   366\t  [entries]\n   367\t  (let [rows (sort display-order\n   368\t                   (map (fn [[k v]]\n   369\t                          [(if (= :type k) 0 1) (rendered-text k) (rendered-text v) v])\n   370\t                        entries))]\n   371\t    (into (sorted-map-by #(compare (.-rank ^DisplayKey %1)\n   372\t                                   (.-rank ^DisplayKey %2)))\n   373\t          (map-indexed (fn [i [_ text _ v]] [(DisplayKey. text i) v]) rows))))\n   374\t\n   375\t\n   376\t(defn- render-map\n   377\t  [typed? entries]\n   378\t  (let [ks (map first entries)]\n   379\t    (cond (and (seq entries)\n   380\t               (not (and (apply distinct? ks)\n   381\t                         (apply distinct? (map pr-str ks)))))\n   382\t          (display-map entries)\n   383\t          typed? (typed-map entries)\n   384\t          :else (into {} entries))))\n   385\t\n   386\t\n   387\t(defn- quote-symbols\n   388\t  \"`quoted?` is true inside a `(quote ...)` form: its symbols print as they\n   389\t   are, but host functions at any depth still become the marker.\"\n   390\t  [namer quoted? x]\n   391\t  (cond (symbol? x) (if quoted? x (list 'quote x))\n   392\t        (fn? x) (host-fn-marker namer x)\n   393\t        (vector? x) (mapv #(quote-symbols namer quoted? %) x)\n   394\t        (map? x)\n   395\t        (render-map\n   396\t          ;; not `contains?`: on a sorted map with non-keyword keys it throws\n   397\t          (some #(= :type (key %)) x)\n   398\t          (map (fn [[k v]]\n   399\t                 [(quote-symbols namer quoted? k)\n   400\t                  (quote-symbols namer quoted? v)])\n   401\t               x))\n   402\t        (or (list? x) (seq? x))\n   403\t        (if (= 'quote (first x))\n   404\t          (apply list (map #(quote-symbols namer true %) x))\n   405\t          (map #(quote-symbols namer quoted? %) x))\n   406\t        :else x))\n   407\t\n   408\t\n   409\t(defn format-value\n   410\t  \"Render `value` for the REPL. `namer` (see `host-fn-namer`) names host\n   411\t   functions; without one they render nameless.\"\n   412\t  ([value] (format-value value nil))\n   413\t  ([value namer]\n   414\t   (rendered-text (quote-symbols namer false value))))\n   415\t\n   416\t\n   417\t(defn format-error\n   418\t  [error]\n   419\t  (str \"Error: \"\n   420\t       #?(:cljd (or (ex-message error) (str error))\n   421\t          :cljs (or (ex-message error) (.-message error) (str error))\n   422\t          :clj (or (ex-message error) (str error)))))\n   423\t\n   424\t\n   425\t(defn- print-arg\n   575\t            (is (= [\"42\" \"5\"] (rest texts)))))))))\n   576\t\n   577\t\n   578\t(deftest a-host-function-renders-as-a-named-portable-marker\n   579\t  (doseq [vm-type (keys repl/vm-constructors)]\n   580\t    (testing (str vm-type)\n   581\t      (let [[_ [plus _ q nested alias _ closure]]\n   582\t            (results (repl/create-state {:vm-type vm-type})\n   583\t                     [\"+\"\n   584\t                      \"(require (quote dao.space.query))\"\n   585\t                      \"dao.space.query/q\"\n   586\t                      \"(conj [] + (assoc {} :f -))\"\n   587\t                      \"==\"\n   588\t                      \"(defn inc [i] (+ i 1))\"\n   589\t                      \"inc\"])]\n   590\t        (is (= \"{:type :host-fn, :name '+}\" plus))\n   591\t        (is (= \"{:type :host-fn, :name 'dao.space.query/q}\" q))\n   592\t        (is (= \"[{:type :host-fn, :name '+} {:f {:type :host-fn, :name '-}}]\"\n   593\t               nested))\n   594\t        (is (= \"{:type :host-fn, :name '=}\" alias)\n   595\t            \"an alias renders under its canonical name\")\n   596\t        (is (str/starts-with? closure \"{:type :closure\")\n   597\t            \"a data closure keeps its own rendering\")\n   598\t        (is (not-any? #(str/includes? % \"#object[\")\n   599\t                      [plus q nested alias closure]))))))\n   600\t\n   601\t\n   602\t(deftest a-typed-value-renders-in-one-key-order-on-every-host\n   603\t  ;; kept under dao.pretty's 60-column ClojureDart budget, so every host\n   604\t  ;; prints it on one line\n   605\t  (is (= \"{:type :closure, :entry 3, :params ['i], :segment -1}\"\n   606\t         (repl/format-value\n   607\t           {:type :closure, :params ['i], :entry 3, :segment -1}))\n   608\t      \":type first, then the other keys in printed order, whatever the\n   609\t       host's map iteration order\")\n   610\t  (is (= \"{:b {:type :x, :z 2}}\"\n   611\t         (repl/format-value (sorted-map :b {:z 2 :type :x})))\n   612\t      \"a typed map nested in an untyped one is ordered too\")\n   613\t  (is (= \"{1 2}\" (repl/format-value (sorted-map 1 2)))\n   614\t      \"a sorted map whose keys don't compare with :type still renders\"))\n   615\t\n   616\t\n   617\t(deftest a-host-function-without-a-known-name-renders-nameless\n   618\t  (is (= \"{:type :host-fn}\" (repl/format-value inc)))\n   619\t  (is (= \"[{:type :host-fn} 1]\" (repl/format-value [inc 1]))))\n   620\t\n   621\t\n   622\t(deftest a-host-function-inside-a-quoted-form-renders-as-the-marker\n   623\t  (is (= \"'{:type :host-fn}\" (repl/format-value (list 'quote inc))))\n   624\t  (is (= \"'[a {:type :host-fn} {:k '{:type :host-fn}}]\"\n   625\t         (repl/format-value (list 'quote ['a inc {:k (list 'quote dec)}])))\n   626\t      \"symbols inside the quote stay as they are; host functions at any\n   627\t       depth, nested quotes included, become the marker\"))\n   628\t\n   629\t\n   630\t(deftest map-entries-whose-rendered-keys-coincide-all-render\n   631\t  (is (= \"{{:type :host-fn} 1, {:type :host-fn} 2}\"\n   632\t         (repl/format-value {inc 1, dec 2}))\n   633\t      \"two distinct nameless host functions as keys\")\n   634\t  (is (= \"{:type :x, {:type :hos