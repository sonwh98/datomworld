{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E7gMQtyTpiUDPM7vtMtd7U","type":"tool_result","content":"100\t                                :yin.k/transaction {:yin.k/arbitration (get-in c [:yin.k/arbitration :dao.stream/identity])}\n101\t                                :yin.k/epoch 0}\n102\t                :yin.k/prefix {:yin.k/occurrence o :dao.lease/lease \"lease-1\" :yin.k/frontier 0 :yin.k/inputs []}\n103\t                :yin.k/enrolled enrolled}}))\n104\t\n105\t\n106\t(defn- protection-for\n107\t  [wire enrolled]\n108\t  (into {} (map (fn [i] [i (if (contains? enrolled i) :enrolled :at-least-once)])) (identities wire)))\n109\t\n110\t\n111\t(defn- lowered\n112\t  \"[machine-or-refusal attaches] of wire lowered into a fresh receiver.\"\n113\t  [wire opts]\n114\t  (let [{:keys [attach! count]} (s/attacher)\n115\t        r (try (rows/lower-task (s/receiver) wire attach! opts)\n116\t               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n117\t                 (or (ex-data e) (throw e))))]\n118\t    [r @count]))\n119\t\n120\t\n121\t(defn- exclusive-opts\n122\t  [wire enrolled]\n123\t  {:grant (grant-for wire enrolled) :protection (protection-for wire enrolled)})\n124\t\n125\t\n126\t(defn- refused\n127\t  \"The refusal of wire lowered under opts, asserting zero attachments.\"\n128\t  [wire opts]\n129\t  (let [[r n] (lowered wire opts)]\n130\t    (is (zero? n) (str \"refused before any attachment: \" (pr-str (select-keys r [:yin.k/status :yin.k/kind]))))\n131\t    r))\n132\t\n133\t\n134\t(def ^:private successor (delay (f/base \"successor\")))\n135\t\n136\t\n137\t(deftest an-exclusive-root-lowers-under-its-grant\n138\t  (let [wire @successor\n139\t        [m n] (lowered wire (exclusive-opts wire #{\"s0\"}))]\n140\t    (is (pos? n))\n141\t    (is (= {:yin.k/occurrence s/occurrence :dao.lease/lease \"lease-1\" :dao.lease/holder \"holder-a\"\n142\t            :yin.k/epoch 0 :yin.k/arbitration s/arbitration :yin.k/next-op-seq 3\n143\t            :protection {\"s0\" :enrolled}\n144\t            :input {:next 0 :prefix (get-in (grant-for wire #{\"s0\"}) [:evidence :yin.k/prefix])}\n145\t            :tenure {:bound 10}}\n146\t           (:yin.k/custody m))\n147\t        \"custody from the evidence, the counter the slot's exactly\")\n148\t    (is (= :running (:yin.k/gate m)))\n149\t    (is (= 1 (:yin.k/issued m)))\n150\t    (let [put (first (filter #(= :put (:reason %)) (:wait-set m)))]\n151\t      (is (= 0 (:yin.k/issue put)) \"retained writes are numbered in carried order\")\n152\t      (is (= (s/op-id 0) (:op-id put)) \"the id travels verbatim\"))\n153\t    (testing \"the restored task relifts to the same root under the same header\"\n154\t      (is (= (:yin.k/root wire)\n155\t             (:yin.k/root (rows/lift-task (dissoc m :yin.k/custody :yin.k/gate :yin.k/issued) (s/serve-table)\n156\t                                          (s/lift-opts (s/header 3 s/origin #{\"s0\"})))))))))\n157\t\n158\t\n159\t(deftest the-counter-is-restored-exactly\n160\t  (doseq [k [0 3 7 (dec rows/max-exact)]]\n161\t    (let [wire (f/edit-custody @successor #(assoc % :yin.k/next-op-seq (inc k)))\n162\t          wire (f/edit-task wire (fn [t] (f/update-put t #(f/set-op-id % (s/op-id k)))))\n163\t          [m _] (lowered wire (exclusive-opts wire #{\"s0\"}))]\n164\t      (is (= (inc k) (get-in m [:yin.k/custody :yin.k/next-op-seq])) (str k)))))\n165\t\n166\t\n167\t(deftest every-grant-check-refuses-before-any-attachment\n168\t  (let [wire @successor\n169\t        good (exclusive-opts wire #{\"s0\"})"}]},"parent_tool_use_id":null,"session_id":"72b4f199-a30e-42b5-b648-90d6dc2ab934","uuid":"9858dba5-b273-45be-a796-8a9447b59544","timestamp":"2026-10-13T14:01:04.796Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/rows_custody_test.cljc","content":"                                :yin.k/transaction {:yin.k/arbitration (get-in c [:yin.k/arbitration :dao.stream/identity])}\n                                :yin.k/epoch 0}\n                :yin.k/prefix {:yin.k/occurrence o :dao.lease/lease \"lease-1\" :yin.k/frontier 0 :yin.k/inputs []}\n                :yin.k/enrolled enrolled}}))\n\n\n(defn- protection-for\n  [wire enrolled]\n  (into {} (map (fn [i] [i (if (contains? enrolled i) :enrolled :at-least-once)])) (identities wire)))\n\n\n(defn- lowered\n  \"[machine-or-refusal attaches] of wire lowered into a fresh receiver.\"\n  [wire opts]\n  (let [{:keys [attach! count]} (s/attacher)\n        r (try (rows/lower-task (s/receiver) wire attach! opts)\n               (catch #?(:cljd Object :clj Throwable :cljs :default) e\n                 (or (ex-data e) (throw e))))]\n    [r @count]))\n\n\n(defn- exclusive-opts\n  [wire enrolled]\n  {:grant (grant-for wire enrolled) :protection (protection-for wire enrolled)})\n\n\n(defn- refused\n  \"The refusal of wire lowered under opts, asserting zero attachments.\"\n  [wire opts]\n  (let [[r n] (lowered wire opts)]\n    (is (zero? n) (str \"refused before any attachment: \" (pr-str (select-keys r [:yin.k/status :yin.k/kind]))))\n    r))\n\n\n(def ^:private successor (delay (f/base \"successor\")))\n\n\n(deftest an-exclusive-root-lowers-under-its-grant\n  (let [wire @successor\n        [m n] (lowered wire (exclusive-opts wire #{\"s0\"}))]\n    (is (pos? n))\n    (is (= {:yin.k/occurrence s/occurrence :dao.lease/lease \"lease-1\" :dao.lease/holder \"holder-a\"\n            :yin.k/epoch 0 :yin.k/arbitration s/arbitration :yin.k/next-op-seq 3\n            :protection {\"s0\" :enrolled}\n            :input {:next 0 :prefix (get-in (grant-for wire #{\"s0\"}) [:evidence :yin.k/prefix])}\n            :tenure {:bound 10}}\n           (:yin.k/custody m))\n        \"custody from the evidence, the counter the slot's exactly\")\n    (is (= :running (:yin.k/gate m)))\n    (is (= 1 (:yin.k/issued m)))\n    (let [put (first (filter #(= :put (:reason %)) (:wait-set m)))]\n      (is (= 0 (:yin.k/issue put)) \"retained writes are numbered in carried order\")\n      (is (= (s/op-id 0) (:op-id put)) \"the id travels verbatim\"))\n    (testing \"the restored task relifts to the same root under the same header\"\n      (is (= (:yin.k/root wire)\n             (:yin.k/root (rows/lift-task (dissoc m :yin.k/custody :yin.k/gate :yin.k/issued) (s/serve-table)\n                                          (s/lift-opts (s/header 3 s/origin #{\"s0\"})))))))))\n\n\n(deftest the-counter-is-restored-exactly\n  (doseq [k [0 3 7 (dec rows/max-exact)]]\n    (let [wire (f/edit-custody @successor #(assoc % :yin.k/next-op-seq (inc k)))\n          wire (f/edit-task wire (fn [t] (f/update-put t #(f/set-op-id % (s/op-id k)))))\n          [m _] (lowered wire (exclusive-opts wire #{\"s0\"}))]\n      (is (= (inc k) (get-in m [:yin.k/custody :yin.k/next-op-seq])) (str k)))))\n\n\n(deftest every-grant-check-refuses-before-any-attachment\n  (let [wire @successor\n        good (exclusive-opts wire #{\"s0\"})","numLines":70,"startLine":100,"totalLines":316}},"tool_result_meta":[{"id":"toolu_01E7gMQtyTpiUDPM7vtMtd7U","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
