{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GoZMMsmGk8zigj5LyPR3yG","type":"tool_result","content":"2440\t\n2441\t\n2442\t(defn- rebuilt-cell\n2443\t  \"Reconstruct only a complete fenced snapshot, never a supplied live machine.\"\n2444\t  [state folded mint]\n2445\t  (let [o (:occurrence mint)\n2446\t        [bytes fence] (fence-bytes state folded o)\n2447\t        recovery-bytes (when fence (store-get state (:record fence)))\n2448\t        _ (check! (and (some? bytes) (some? recovery-bytes)) \"complete fenced snapshot\" {})\n2449\t        recovery (cbor/decode recovery-bytes)\n2450\t        _ (check! (and (= (:address fence) (:yin.k/pack-address recovery))\n2451\t                       (= (:header mint) (:yin.k/header recovery))\n2452\t                       (jing/segment-bytes-match? (:address fence) bytes)\n2453\t                       (= (vec bytes) (vec (jing/base64->bytes (:yin.k/pack-bytes recovery)))))\n2454\t                  \"matching fenced recovery references\" {})\n2455\t        recovered (export/rehydrate-fenced (:receiver state) recovery-bytes\n2456\t                                           {:address (:record fence)\n2457\t                                            :attach (get-in state [:seams :attach!])})\n2458\t        _ (check! (= :ok (:status recovered)) \"valid fenced recovery\" recovered)\n2459\t        _ (check! (= (:address fence)\n2460\t                     (:address (export/encode (:machine recovered) (:record recovered))))\n2461\t                  \"matching fenced body\" {})\n2462\t        offer-intent (intent-of folded :yin.k/offer o)\n2463\t        offer-rid (get-in offer-intent\n2464\t                          [:yin.k/request :yin.k/request-id])]\n2465\t    (cond-> {:role (:role mint)\n2466\t             :occurrence o\n2467\t             :header (:header mint)\n2468\t             :m (:machine recovered)\n2469\t             :record (:record recovered)\n2470\t             :prepared? (some? bytes)\n2471