iginalFile":"#!/usr/bin/env python3 -I\n\"\"\"Reviewer mutants for slice 7b. Each mutant: a list of exact (old, new)\nreplacements on one source file, a test namespace list. Apply, run the\ntests in the foreground, restore from the pristine backup, verify with\n`git diff --quiet -- src`, and print one summary line.\"\"\"\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nROOT = Path(\"/Users/sto/workspace/datomworld-srvm-p7b\")\nOUT = ROOT / \"target/7b-review/mutants\"\nBACKUP = ROOT / \"target/7b-review/backup\"\nEXPORT = \"src/cljc/yin/vm/ucf/holder/export.cljc\"\nDRIVER = \"src/cljc/yin/vm/ucf/holder/driver.cljc\"\nROWS = \"src/cljc/yin/vm/ucf/rows.cljc\"\nEXPORT_T = [\"yin.vm.ucf.holder.export-test\"]\nCUSTODY_T = [\"yin.vm.ucf.rows-custody-test\"]\nDRIVER_T = [\"yin.vm.ucf.holder.driver-test\"]\n\nMUTANTS = {\n    \"M01-snapshot-body\": dict(file=EXPORT, tests=EXPORT_T, edits=[(\n        \"                      :yin.k/state (recovery-metadata machine prepared-record)}\",\n        \"                      :yin.k/state (recovery-metadata machine prepared-record)\\n\"\n        \"                      :yin.k/snapshot (jing/bytes->base64 (:bytes e))}\")]),\n    \"M02-rehydrate-runs-program\": dict(file=EXPORT, tests=EXPORT_T, edits=[(\n        \"                         {:fenced true})\\n\"\n        \"              {:keys [machine record]} (extract-recovered restored state)\",\n        \"                         {:fenced true})\\n\"\n        \"              restored (vm/run (assoc restored :yin.k/gate :running :wait-set (:yin.k/recovery-waits restored)))\\n\"\n        \"              {:keys [machine record]} (extract-recovered restored state)\")]),\n    \"M03-counter-off-by-one\": dict(file=ROWS, tests=EXPORT_T + CUSTODY_T, edits=[(\n        \"                                   :id-counter (if (:fenced? custody)\\n\"\n        \"                                                 id-counter\\n\",\n        \"                                   :id-counter (if (:fenced? custody)\\n\"\n        \"                                                 (inc id-counter)\\n\")]),\n    \"M04-parked-record-dropped\": dict(file=ROWS, tests=EXPORT_T, edits=[(\n        \"             :yin.k/recovery-parked (:parked m) :parked {})\",\n        \"             :yin.k/recovery-parked (into {} (rest (:parked m))) :parked {})\")]),\n    \"M05-abort-restart-accepted\": dict(file=EXPORT, tests=EXPORT_T, edits=[(\n        \"    (:recovered? record)\\n    (refused :restarted)\\n\\n    (not= :exporting\",\n        \"    (not= :exporting\")]),\n    \"M06-q3-link-id-check-removed\": dict(file=ROWS, tests=CUSTODY_T, edits=[(\n        \"    (when-not (and (some? parent) (= parent (:yin.link/id response)))\\n\"\n        \"      (outcome! :yin.k/undecodable :install-link-id {:yin.k/name mn}))\\n\",\n        \"\")]),\n    \"M07-q3-image-check-removed\": dict(file=ROWS, tests=CUSTODY_T, edits=[(\n        \"    (let [record (:derivation response)]\\n\"\n        \"      (when-not (and (map? record)\\n\"\n        \"                     (= (jing/segment-key record) (get-in manifest [:yin.module/derivations :yin.semantic/code]))\\n\"\n        \"                     (= (:yin.ledger/input record) (:yin.module/tree manifest))\\n\"\n        \"                     (= (:yin.ledger/output record) (jing/segment-key (:value (:image response)))))\\n\"\n        \"        (outcome! :yin.k/undecodable :install-image {:yin.k/name mn})))\\n\",\n        \"\")]),\n    \"M07a-q3-record-address-only\": dict(file=ROWS, tests=CUSTODY_T, edits=[(\n        \"                     (= (jing/segment-key record) (get-in manifest [:yin.module/derivations :yin.semantic/code]))\\n\",\n        \"\")]),\n    \"M07b-q3-tree-input-only\": dict(file=ROWS, tests=CUSTODY_T, edits=[(\n        \"                     (= (:yin.ledger/input record) (:yin.module/tree manifest))\\n\",\n        \"\")]),\n    \"M07c-q3-image-output-only\": dict(file=ROWS, tests=CUSTODY_T, edits=[(\n        \"                     (= (:yin.ledger/output record) (jing/segment-key (:value (:image response)))))\\n\",\n        \"                     )\\n\")]),\n    \"M08-source-index-ignored\": dict(file=EXPORT, tests=EXPORT_T, edits=[(\n        \"                            :source-index (:source-index record)\",\n        \"                            :source-index nil\")]),\n    \"M09-attach-before-custody\": dict(file=ROWS, tests=CUSTODY_T, edits=[(\n        \"     (let [custody (check-custody! task wire opts)]\\n\"\n        \"       (restore-task recv task (attach-streams! attach! task) custody true)))))\",\n        \"     (let [handles (attach-streams! attach! task)\\n\"\n        \"           custody (check-custody! task wire opts)]\\n\"\n        \"       (restore-task recv task handles custody true)))))\")]),\n    \"M10-make-stream-not-restored\": dict(file=ROWS, tests=EXPORT_T + DRIVER_T, edits=[(\n        \"    [(cond-> child fenced? (assoc :make-stream (:make-stream recv)))\\n\"\n        \"     (assoc recv :origins (inc n))]))\",\n        \"    [child\\n\"\n        \"     (assoc recv :origins (inc n))]))\")]),\n    \"M11-recovery-stored-after-pack\": dict(file=DRIVER, tests=DRIVER_T, edits=[(\n        \"        (if-not (and (store-object [record-address record-bytes])\\n\"\n        \"                     (store-object [address bytes]))\",\n        \"        (if-not (and (store-object [address bytes])\\n\"\n        \"                     (store-object [record-address record-bytes]))\")]),\n    \"M12a-fenced-journal-tag-renamed\": dict(file=DRIVER, tests=DRIVER_T, edits=[(\n        \"                      {:yin.k/journal :yin.k/fenced\\n\"\n        \"                       :yin.k/occurrence (:occurrence cell)\\n\"\n        \"                       :yin.k/address address\\n\"\n        \"                       :yin.k/record record-address})\",\n        \"                      {:yin.k/journal :yin.k/fence-done\\n\"\n        \"                       :yin.k/occurrence (:occurrence cell)\\n\"\n        \"                       :yin.k/address address\\n\"\n        \"                       :yin.k/record record-address})\")]),\n    \"M12b-store-action-renamed\": dict(file=DRIVER, tests=DRIVER_T, edits=[(\n        \"                (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/store\\n\",\n        \"                (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/stored\\n\")]),\n    \"M13-serve-repeated-on-retry\": dict(file=EXPORT, tests=EXPORT_T, edits=[\n        (\"  (let [table (atom (:served record))\\n\"\n         \"        by-handle (atom (seeded-by-handle machine (:served record)))\",\n         \"  (let [table (atom {})\\n\"\n         \"        by-handle (atom {})\")]),\n}\n\n\ndef run(cmd, **kw):\n    return subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True, **kw)\n\n\ndef restore(rel):\n    (ROOT / rel).write_bytes((BACKUP / Path(rel).name).read_bytes())\n    r = run([\"git\", \"diff\", \"--quiet\", \"--\", \"src\"])\n    return r.returncode == 0\n\n\ndef main(names):\n    OUT.mkdir(parents=True, exist_ok=True)\n    for name in names:\n        m = MUTANTS[name]\n        rel = m[\"file\"]\n        path = ROOT / rel\n        src = path.read_text()\n        for old, new in m[\"edits\"]:\n            if src.count(old) != 1:\n                print(f\"{name}: ANCHOR NOT UNIQUE/FOUND ({src.count(old)})\")\n                sys.exit(2)\n            src = src.replace(old, new, 1)\n        path.write_text(src)\n        (OUT / f\"{name}.diff\").write_text(run([\"git\", \"diff\", \"--\", rel]).stdout)\n        cmd = [\"clojure\", \"-M:test\", \"-e\", \":slow\"]\n        for ns in m[\"tests\"]:\n            cmd += [\"-n\", ns]\n        try:\n            r = run(cmd, timeout=1500)\n            log = r.stdout + r.stderr\n        except subprocess.TimeoutExpired as e:\n            log = (e.stdout or \"\") + (e.stderr or \"\") + \"\\nTIMEOUT\"\n        (OUT / f\"{name}.log\").write_text(log)\n        clean = restore(rel)\n        ran = re.search(r\"Ran (\\d+) tests containing (\\d+) assertions\", log)\n        fe = re.search(r\"(\\d+) failures, (\\d+) errors\", log)\n        names_hit = []\n        for kind, nm in re.findall(r\"(FAIL|ERROR) in \\(([^)]+)\\)\", log):\n            if nm not in names_hit:\n                names_hit.append(nm)\n        status = \"RESTORED\" if clean else \"RESTORE-FAILED\"\n        if fe:\n            killed = (int(fe.group(1)) + int(fe.group(2))) > 0\n            verdict = \"KILLED\" if killed else \"SURVIVED\"\n            print(f\"{name}: {verdict} ran={ran.group(1) if ran else '?'} \"\n                  f\"failures={fe.group(1)} errors={fe.group(2)} by={names_hit[:4]} {status}\")\n        else:\n            tail = log.strip().splitlines()[-3:]\n            print(f\"{name}: NO-SUMMARY (compile error or timeout => KILLED-by-crash) tail={tail} {status}\")\n        if not clean:\n            sys.exit(3)\n\n\nif __name__ == \"__main__\":\n    main(sys.argv[1:] or list(MUTANTS))\n","structuredPatch":[{"oldStart":29,"oldLines":6,"newStart":29,"newLines":21,"lines":["         \"                         {:fenced true})\\n\"","         \"              restored (vm/run (assoc restored :yin.k/gate :running :wait-set (:yin.k/recovery-waits restored)))\\n\"","         \"              {:keys [machine record]} (extract-recovered restored state)\")]),","+    \"M02b-fenced-gate-and-waits-live\": dict(file=ROWS, tests=EXPORT_T + CUSTODY_T, edits=[(","+        \"      (assoc m :yin.k/gate :exporting :yin.k/recovery-waits (:wait-set m) :wait-set []\\n\"","+        \"             :yin.k/recovery-parked (:parked m) :parked {})\",","+        \"      (assoc m :yin.k/recovery-waits (:wait-set m)\\n\"","+        \"             :yin.k/recovery-parked (:parked m) :parked {})\")]),","+    \"M02c-rehydrate-polls-waits\": dict(file=EXPORT, tests=EXPORT_T, edits=[(","+        \"                         {:fenced true})\\n\"","+        \"              {:keys [machine record]} (extract-recovered restored state)\",","+        \"                         {:fenced true})\\n\"","+        \"              restored (let [m (yin.vm.engine/check-wait-set (assoc restored :yin.k/gate :running :wait-set (:yin.k/recovery-waits restored)))]\\n\"","+        \"                         (assoc m :yin.k/gate :exporting :wait-set []))\\n\"","+        \"              {:keys [machine record]} (extract-recovered restored state)\")]),","+    \"M07a2-q3-record-address-isolated\": dict(file=ROWS, tests=CUSTODY_T, edits=[(","+        \"                     (= (jing/segment-key record) (get-in manifest [:yin.module/derivations :yin.semantic/code]))\\n\",","+        \"                     (contains? manifest :yin.module/derivations)\\n\")]),","     \"M03-counter-off-by-one\": dict(file=ROWS, tests=EXPORT_T + CUSTODY_T, edits=[(","         \"                                   :id-counter (if (:fenced? custody)\\n\"","         \"                                                 id-counter\\n\","]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01WhyBeFq2HTtspVyYe7wHXa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
