{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BrAKJNYneQBe6gtKGB8wsN","type":"tool_result","content":"1\t(ns yin.vm.ucf.holder.export-test\n2\t  \"D8 over the row carrier (UCF 7.7.4; r3 1.8 and 1.9; phase 7b): the\n3\t   exporting state, the prepare/encode split over rows/lift-task, the\n4\t   export-recovery object version 2, its fenced rehydration and the abort\n5\t   rule. Every machine is a semantic-register machine the real engine\n6\t   parked (yin.vm.ucf.rows-support); counting handles show what the gate,\n7\t   the encode and the rehydration touch.\"\n8\t  (:require [clojure.test :refer [deftest is testing]]\n9\t            [dao.jing :as jing]\n10\t            [dao.jing.cbor :as cbor]\n11\t            [dao.stream :as stream]\n12\t            [dao.stream.ringbuffer :as ringbuffer]\n13\t            [yin.vm :as vm]\n14\t            [yin.vm.engine :as engine]\n15\t            [yin.vm.module :as module]\n16\t            [yin.vm.values :as values]\n17\t            [yin.vm.test-utils :as tu]\n18\t            [yin.vm.ucf.holder.export :as export]\n19\t            [yin.vm.ucf.rows :as rows]\n20\t            [yin.vm.ucf.rows-support :as rs]))\n21\t\n22\t\n23\t;; =============================================================================\n24\t;; Machines, the exporter, the receiver's attach\n25\t;; =============================================================================\n26\t\n27\t(defn- throws?\n28\t  [thunk]\n29\t  (try (thunk) false\n30\t       (catch #?(:cljd Object :clj Throwable :cljs :default) _ true)))\n31\t\n32\t\n33\t(defn- ring\n34\t  [capacity]\n35\t  (:dao.stream/handle\n36\t    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n37\t                         ringbuffer/capacity-key capacity})))\n38\t\n39\t\n40\t(defn- index\n41\t  \"The composition's source index, as the composition reads it.\"\n42\t  []\n43\t  @rs/source-index)\n44\t\n45\t\n46\t(defn- two-streams\n47\t  \"Parks on a read of the first stream; the store also holds the second\n48\t   stream and a cursor on each, so the lift reaches two streams.\"\n49\t  []\n50\t  (rs/let1 'a {:type :stream/make :buffer 4}\n51\t           (rs/let1 'b {:type :stream/make :buffer 4}\n52\t                    (rs/then (rs/def! 'held-a (rs/cursor-of (rs/v 'a)))\n53\t                             (rs/then (rs/def! 'held-b (rs/cursor-of (rs/v 'b)))\n54\t                                      (rs/next-of (rs/v 'held-a)))))))\n55\t\n56\t\n57\t(defn- parked-machine\n58\t  []\n59\t  (vm/run (rs/load-ast (rs/new-machine) (two-streams))))\n60\t\n61\t\n62\t(defn- served-table\n63\t  \"A `serve!` that counts its calls and answers one stable identity per\n64\t   handle.\"\n65\t  []\n66\t  (let [calls (atom 0)\n67\t        table (atom {})]\n68\t    {:calls calls\n69\t     :table table\n70\t     :serve! (fn [h]\n71\t               (swap! calls inc)\n72\t               (or (get @table h)\n73\t                   (let [served {:dao.stream/identity (str \"s\" (count @table))\n74\t                                 :dao.stream/channel {:dao.stream/type :test/channel}}]\n75\t                     (swap! table assoc h served)\n76\t                     served)))}))\n77\t\n78\t\n79\t(defn- counting-handle\n80\t  [calls]\n81\t  (reify\n82\t    stream/IDaoStreamReader\n83\t\n84\t    (cursor\n85\t      [_ _]\n86\t      (swap! calls inc)\n87\t      {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor ::at})\n88\t\n89\t    (next\n90\t      [_ _]\n91\t      (swap! calls inc)\n92\t      {:dao.stream/outcome :dao.stream/blocked})\n93\t\n94\t\n95\t    stream/IDaoStreamWriter\n96\t\n97\t    (append!\n98\t      [_ _]\n99\t      (swap! calls inc)\n100\t      {:dao.stream/outcome :dao.stream/ok})\n101\t\n102\t\n103\t    stream/IDaoStreamClosable\n104\t\n105\t    (close!\n106\t      [_]\n107\t      (swap! calls inc)\n108\t      {:dao.stream/outcome :dao.stream/ok})))\n109\t\n110\t\n111\t(defn- counting-attach\n112\t  \"A receiver's attach!: a fresh counting handle per descriptor; every\n113\t   attach and every handle operation counted.\"\n114\t  []\n115\t  (let [attaches (atom 0) calls (atom 0)]\n116\t    {:attaches attaches\n117\t     :calls calls\n118\t     :attach (fn [_]\n119\t               (swap! attaches inc)\n120\t               {:dao.stream/outcome :dao.stream/ok\n121\t                :dao.stream/handle (counting-handle calls)})}))\n122\t\n123\t\n124\t(defn- frozen-of\n125\t  \"Enter, prepare under header with the composition's index, freeze:\n126\t   {:machine :record :prepared :frozen :table}.\"\n127\t  ([source] (frozen-of source nil))\n128\t  ([source header]\n129\t   (let [{:keys [machine record]} (export/enter source)\n130\t         {:keys [serve! table]} (served-table)\n131\t         prepared (export/prepare machine record serve! header (index))]\n132\t     {:machine machine :record record :prepared prepared :table table\n133\t      :frozen (when (= :ok (:status prepared)) (export/freeze machine (:record prepared)))})))\n134\t\n135\t\n136\t(defn- rehydrate\n137\t  ([frozen] (rehydrate frozen (rs/new-machine) (:attach (counting-attach))))\n138\t  ([frozen receiver attach]\n139\t   (export/rehydrate-fenced receiver (:bytes frozen) {:address (:address frozen) :attach attach})))\n140\t\n141\t\n142\t(defn- reproduces?\n143\t  [frozen restored]\n144\t  (= (vec (:pack-bytes frozen))\n145\t     (vec (:bytes (export/encode (:machine restored) (:record restored))))))\n146\t\n147\t\n148\t;; =============================================================================\n149\t;; Gated machines over counting handles (machine-level, kernel-agnostic)\n150\t;; =============================================================================\n151\t\n152\t(def ^:private park-entry-fns\n153\t  {:stream/put (fn [_s _e r] {:reason :put, :stream-id (:stream-id r)}),\n154\t   :stream/next (fn [_s _e r]\n155\t                  {:reason :next,\n156\t                   :cursor-ref (:cursor-ref r),\n157\t                   :stream-id (:stream-id r)})})\n158\t\n159\t\n160\t(def ^:private opts {:park-entry-fns park-entry-fns})\n161\t\n162\t\n163\t(defn- gated\n164\t  \"[state stream-ref cursor-ref calls] under the :running gate.\"\n165\t  []\n166\t  (let [calls (atom 0)\n167\t        [sref s0] (engine/attach-resource\n168\t                    (vm/empty-state {:make-stream tu/make-stream,\n169\t                                     :capability-secret tu/secret})\n170\t                    (counting-handle calls))\n171\t        [cref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)]\n172\t    (reset! calls 0)\n173\t    [(assoc s1 :yin.k/gate :running) sref cref calls]))\n174\t\n175\t\n176\t(defn- run-effect\n177\t  [state kind m]\n178\t  (:state (engine/handle-effect state (module/make-effect kind m) opts)))\n179\t\n180\t\n181\t;; =============================================================================\n182\t;; Entering exporting\n183\t;; =============================================================================\n184\t\n185\t(deftest enter-moves-waits-and-fences-the-machine-test\n186\t  (let [[s sref _ _] (gated)\n187\t        s (run-effect s :stream/put {:stream sref, :val 1})\n188\t        waits (:wait-set s)\n189\t        r (export/enter s)]\n190\t    (is (= :ok (:status r)) (pr-str r))\n191\t    (is (= :exporting (vm/gate-mode (:machine r))))\n192\t    (is (empty? (:wait-set (:machine r))) \"nothing left to poll\")\n193\t    (is (= waits (get-in r [:record :wait-set])) \"waits kept in order\")\n194\t    (is (= :running (get-in r [:record :gate])))\n195\t    (testing \"an exporting machine cannot enter again\"\n196\t      (is (= :yin.k/refused (:yin.k/status (export/enter (:machine r))))))))\n197\t\n198\t\n199\t(deftest exporting-appends-nothing-test\n200\t  (let [[s sref _ calls] (gated)\n201\t        s (run-effect s :stream/put {:stream sref, :val 1})\n202\t        child-calls (atom 0)\n203\t        child (vm/run (rs/load-ast (rs/new-machine\n204\t                                     {:make-stream\n205\t                                      (fn [_capacity]\n206\t                                        {:dao.stream/outcome :dao.stream/ok\n207\t                                         :dao.stream/handle (counting-handle child-calls)})})\n208\t                                   (rs/next-of (rs/cursor-of {:type :stream/make :buffer 4}))))\n209\t        s (assoc s :installs {'foo {:phase :running\n210\t                                    :vm child\n211\t                                    :parent [:t0 0]\n212\t                                    :response {}}})\n213\t        _ (reset! child-calls 0)\n214\t        {m :machine} (export/enter s)\n215\t        stamped (assoc s :parked {:parked-0 {:type :parked-continuation\n216\t                                             :id :parked-0}})]\n217\t    (testing \"polling the source\"\n218\t      (engine/check-wait-set m)\n219\t      (is (zero? @calls)))\n220\t    (testing \"ticking its install child\"\n221\t      (let [swept (engine/check-wait-set m)]\n222\t        (is (zero? @child-calls))\n223\t        (is (= child (get-in swept [:installs 'foo :vm])))))\n224\t    (testing \"a direct resume\"\n225\t      (let [restored (atom 0)]\n226\t        (is (throws? #(engine/resume-continuation\n227\t                        (assoc m :parked (:parked stamped))\n228\t                        :parked-0 1\n229\t                        (fn [st _ _] (swap! restored inc) st))))\n230\t        (is (zero? @restored))\n231\t        (is (zero? @calls))))))\n232\t\n233\t\n234\t(deftest a-non-empty-ready-queue-is-not-quiescent-test\n235\t  (let [[s _ _ _] (gated)\n236\t        r (export/enter (assoc s :ready-queue [{:id 1}]))]\n237\t    (is (= :yin.k/not-quiescent (:yin.k/status r)))\n238\t    (testing \"a child's queue too\"\n239\t      (let [r (export/enter\n240\t                (assoc s :installs {'foo {:vm (assoc (vm/empty-state {})\n241\t                                                     :ready-queue [{:id 1}])}}))]\n242\t        (is (= :yin.k/not-quiescent (:yin.k/status r)))))))\n243\t\n244\t\n245\t(defn- refused-as\n246\t  [kind r]\n247\t  (and (= :yin.k/non-portable (:yin.k/status r))\n248\t       (= :reason-mismatch (:yin.k/kind r))\n249\t       (= kind (:yin.k/hold r))))\n250\t\n251\t\n252\t(deftest each-export-refusal-fires-on-a-real-parked-machine-test\n253\t  (let [[s sref cref calls] (gated)]\n254\t    (testing \"an :observe entry\"\n255\t      (let [m (run-effect s :stream/poll {:cursor cref})]\n256\t        (is (= :observe (:reason (first (:wait-set m)))))\n257\t        (is (refused-as :observe (export/enter m)))))\n258\t    (testing \"an entry carrying :yin.k/held\"\n259\t      (let [m (run-effect s :stream/next {:cursor cref})\n260\t            m (assoc-in m [:wait-set 0 :yin.k/held] {:state :observed})]\n261\t        (is (refused-as :held (export/enter m)))))\n262\t    (testing \"an unminted cursor cell\"\n263\t      (let [m (run-effect s :stream/cursor {:stream sref})]\n264\t        (is (refused-as :unminted-cursor (export/enter m)))))\n265\t    (testing \"a pending close\"\n266\t      (let [m (run-effect s :stream/close {:stream sref})]\n267\t        (is (seq (:yin.k/closes m)))\n268\t        (is (refused-as :pending-close (export/enter m)))))\n269\t    (testing \"a link request with no response cursor\"\n270\t      (let [m (rs/parked-linker)\n271\t            entry (first (:wait-set m))]\n272\t        (is (= :link-request (:reason entry)))\n273\t        (is (not (contains? entry :cursor)))\n274\t        (is (refused-as :link-cursor-not-installed (export/enter m)))))\n275\t    (testing \"a refusal in an install child names its path\"\n276\t      (let [child (run-effect s :stream/close {:stream sref})\n277\t            m (assoc (vm/empty-state {})\n278\t                     :installs {'foo {:vm child}})\n279\t            r (export/enter m)]\n280\t        (is (refused-as :pending-close r))\n281\t        (is (= ['foo] (:yin.k/path r)))))\n282\t    (testing \"a refusal leaves the machine as it was\"\n283\t      (is (zero? @calls)))))\n284\t\n285\t\n286\t(deftest an-explicit-park-travels-in-the-record-test\n287\t  (let [m (rs/parked-explicit)\n288\t        {m' :machine record :record} (export/enter m)\n289\t        {:keys [serve!]} (served-table)\n290\t        prepared (export/prepare m' record serve! nil (index))]\n291\t    (is (seq (:parked m)) \"the source holds a parked record\")\n292\t    (is (= (:parked m) (:parked record)) \"the record holds every parked record\")\n293\t    (is (empty? (:parked m')) \"the machine's :parked holds none\")\n294\t    (is (empty? (:wait-set m')))\n295\t    (is (= :ok (:status prepared)) (pr-str prepared))\n296\t    (let [e (export/encode m' (:record prepared))]\n297\t      (is (= :ok (:status e)) (pr-str e))\n298\t      (is (= :parked (:kind e))))\n299\t    (is (= m (:machine (export/abort m' record [] nil)))\n300\t        \"abort restores machine equality\")))\n301\t\n302\t\n303\t(deftest an-install-childs-parked-records-stay-in-the-child-test\n304\t  (let [m (rs/parked-installer)\n305\t        parked {:p0 {:type :parked-continuation :id :p0}}\n306\t        m (assoc-in m [:installs 'host.mod :vm :parked] parked)\n307\t        {m' :machine record :record :as r} (export/enter m)]\n308\t    (is (= :ok (:status r)) (pr-str r))\n309\t    (is (= parked (get-in m' [:installs 'host.mod :vm :parked]))\n310\t        \"the child's parked records are not moved\")\n311\t    (is (not-any? #(contains? (:parked record) %) (keys parked)))))\n312\t\n313\t\n314\t;; =============================================================================\n315\t;; Prepare, then encode\n316\t;; =============================================================================\n317\t\n318\t(deftest prepare-serves-once-per-stream-and-encode-serves-nothing-test\n319\t  (let [m (parked-machine)\n320\t        {:keys [calls table serve!]} (served-table)\n321\t        {m' :machine record :record} (export/enter m)\n322\t        prepared (export/prepare m' record serve! nil (index))\n323\t        record' (:record prepared)\n324\t        after-prepare @calls\n325\t        e1 (export/encode m' record')\n326\t        e2 (export/encode m' record')]\n327\t    (is (= :ok (:status prepared)) (pr-str prepared))\n328\t    (is (= 2 (count @table)) \"two streams reached\")\n329\t    (is (= (count @table) after-prepare) \"serve! once per stream\")\n330\t    (is (= (count @table) (count (:served record'))))\n331\t    (is (every? (fn [[path id]] (and (= [] path) (keyword? id))) (keys (:served record')))\n332\t        \"keyed by task path and resource id\")\n333\t    (is (= after-prepare @calls) \"encode calls nothing\")\n334\t    (is (= :ok (:status e1)) (pr-str e1))\n335\t    (is (= (vec (:bytes e1)) (vec (:bytes e2))) \"deterministic bytes\")\n336\t    (is (= (:address e1) (:address e2)))\n337\t    (testing \"the encode is the row pack: its address is the bytes' BLAKE3, distinct from its root\"\n338\t      (is (jing/segment-bytes-match? (:address e1) (:bytes e1)))\n339\t      (is (= (:address e1) (rows/pack-address (cbor/decode (:bytes e1)))))\n340\t      (is (= (:root e1) (:yin.k/root (cbor/decode (:bytes e1)))))\n341\t      (is (not= (:root e1) (:address e1))))\n342\t    (testing \"preparing a prepared record again serves nothing new\"\n343\t      (export/prepare m' record' serve! nil (index))\n344\t      (is (= after-prepare @calls)))\n345\t    (testing \"an unprepared record is a defect, not a refusal\"\n346\t      (is (throws? #(export/encode m' (assoc record :source-index (index))))))))\n347\t\n348\t\n349\t(deftest the-lift-takes-trees-from-the-composition-source-index-test\n350\t  (let [m (parked-machine)\n351\t        {m' :machine record :record} (export/enter m)\n352\t        {:keys [serve!]} (served-table)\n353\t        prepared (export/prepare m' record serve! nil (index))\n354\t        wire (cbor/decode (:bytes (export/encode m' (:record prepared))))\n355\t        task (rows/decode wire)\n356\t        trees (get-in task [:slots 10 :yin.k/trees])]\n357\t    (is (= (index) (:source-index (:record prepared))) \"the record retains the index it lifted under\")\n358\t    (is (seq trees))\n359\t    (is (every? (fn [[a ts]] (= ts (get (index) a))) trees) \"every carried A names its trees from the index\")\n360\t    (testing \"without the composition's index the export refuses: the AST is never lost\"\n361\t      (let [{m2 :machine r2 :record} (export/enter (parked-machine))\n362\t            refused (export/prepare m2 r2 serve! nil {})]\n363\t        (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n364\t        (is (seq (get-in refused [:yin.k/missing :yin.k/trees])))))))\n365\t\n366\t\n367\t(deftest prepare-reaches-install-children-once-test\n368\t  (let [m (rs/parked-installer)\n369\t        {:keys [calls table serve!]} (served-table)\n370\t        {m' :machine record :record} (export/enter m)\n371\t        prepared (export/prepare m' record serve! nil (index))]\n372\t    (is (= :ok (:status prepared)) (pr-str prepared))\n373\t    (is (pos? @calls))\n374\t    (is (= @calls (count @table)) \"each stream, child's included, once\")\n375\t    (is (some (fn [[path _]] (= ['host.mod] path)) (keys (get-in prepared [:record :served])))\n376\t        \"a child's stream is keyed under the child's path\")\n377\t    (let [n @calls]\n378\t      (is (= :ok (:status (export/encode m' (:record prepared)))))\n379\t      (is (= n @calls)))))\n380\t\n381\t\n382\t(def ^:private served-answer\n383\t  {:dao.stream/identity \"s0\"\n384\t   :dao.stream/channel {:dao.stream/type :test/channel}})\n385\t\n386\t\n387\t(deftest a-refused-prepare-keeps-what-it-served-test\n388\t  (let [m (parked-machine)\n389\t        {m' :machine record :record} (export/enter m)\n390\t        first-handle (atom nil)\n391\t        ;; serves the first stream it is asked about, refuses the rest\n392\t        stingy (fn [h]\n393\t                 (compare-and-set! first-handle nil h)\n394\t                 (when (= h @first-handle) served-answer))\n395\t        refused (export/prepare m' record stingy nil (index))]\n396\t    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n397\t    (is (= 1 (count (get-in refused [:record :served]))))\n398\t    (testing \"a retry with the returned record never re-serves that stream\"\n399\t      (let [asked (atom [])\n400\t            {:keys [serve!]} (served-table)\n401\t            retry (export/prepare m' (:record refused)\n402\t                                  (fn [h]\n403\t                                    (swap! asked conj h)\n404\t                                    (serve! h))\n405\t                                  nil (index))]\n406\t        (is (= :ok (:status retry)) (pr-str retry))\n407\t        (is (not-any? #(= @first-handle %) @asked))\n408\t        (is (= 1 (count @asked)) \"only the other stream\")))))\n409\t\n410\t\n411\t(deftest a-custody-refusal-after-the-walk-keeps-what-the-walk-served-test\n412\t  ;; phase-7a D4: the row lift serves while it walks and decides the\n413\t  ;; protection and exhaustion refusals after; the record accounts for it\n414\t  (doseq [[label header expected]\n415\t          [[\"an enrolled write without an operation id\"\n416\t            (rs/header 0 rs/origin #{\"s0\"}) :unprotected-pending]\n417\t           [\"an exhausted counter\"\n418\t            (rs/header rows/max-exact rs/origin #{}) :op-seq-exhausted]]]\n419\t    (testing label\n420\t      (let [{m :machine record :record} (export/enter (rs/parked-writer))\n421\t            {:keys [calls serve!]} (served-table)\n422\t            refused (export/prepare m record serve! header (index))\n423\t            served @calls]\n424\t        (is (= :yin.k/non-portable (:yin.k/status refused)) (pr-str refused))\n425\t        (is (= expected (:yin.k/kind refused)))\n426\t        (is (pos? served) \"the walk served before the refusal\")\n427\t        (is (= served (count (get-in refused [:record :served]))) \"and the record retains every answer\")\n428\t        (export/prepare m (:record refused) serve! header (index))\n429\t        (is (= served @calls) \"a retry serves nothing twice\")))))\n430\t\n431\t\n432\t;; =============================================================================\n433\t;; Freeze: recovery version 2\n434\t;; =============================================================================\n435\t\n436\t(deftest the-recovery-object-is-the-pack-and-holder-local-state-test\n437\t  (let [{:keys [frozen prepared machine]} (frozen-of (rs/parked-explicit))\n438\t        recovery (cbor/decode (:bytes frozen))\n439\t        published (export/encode machine (:record prepared))]\n440\t    (is (= :ok (:status frozen)) (pr-str frozen))\n441\t    (is (= #{:yin.k/export-recovery :yin.k/version :yin.k/pack-address :yin.k/root\n442\t             :yin.k/pack-bytes :yin.k/header :yin.k/state}\n443\t           (set (keys recovery)))\n444\t        \"one body: no snapshot, no descriptors (the pack carries them)\")\n445\t    (is (= 2 (:yin.k/version recovery)))\n446\t    (is (= (:address published) (:pack-address frozen) (:yin.k/pack-address recovery)))\n447\t    (is (= (:root published) (:root frozen) (:yin.k/root recovery)))\n448\t    (is (= (vec (:bytes published)) (vec (:pack-bytes frozen))\n449\t           (vec (jing/base64->bytes (:yin.k/pack-bytes recovery)))))\n450\t    (is (jing/segment-bytes-match? (:address frozen) (:bytes frozen)))\n451\t    (is (= #{:gate :origins :issues :issued :children} (set (keys (:yin.k/state recovery)))))))\n452\t\n453\t\n454\t;; =============================================================================\n455\t;; Rehydrate: fenced, reproducible, without program IO\n456\t;; =============================================================================\n457\t\n458\t(deftest complete-export-recovery-is-fenced-and-reproducible-test\n459\t  (doseq [[label source header] [[\"a parked reader\" (rs/parked-reader) nil]\n460\t                                 [\"an explicit park\" (rs/parked-explicit) nil]\n461\t                                 [\"an installer\" (rs/parked-installer) nil]\n462\t                                 [\"a parked reader under a header\" (rs/parked-reader) (rs/header 0 nil #{})]\n463\t                                 [\"a halted root under a header\" (rs/halted-machine) (rs/header 0 rs/origin #{})]]]\n464\t    (testing label\n465\t      (let [{:keys [frozen record prepared]} (frozen-of source header)\n466\t            {:keys [attaches calls attach]} (counting-attach)\n467\t            restored (rehydrate frozen (rs/new-machine) attach)]\n468\t        (is (= :ok (:status frozen)) (pr-str frozen))\n469\t        (is (= :ok (:status restored)) (pr-str restored))\n470\t        (is (= :exporting (vm/gate-mode (:machine restored))))\n471\t        (is (empty? (:wait-set (:machine restored))))\n472\t        (is (empty? (:parked (:machine restored))))\n473\t        (is (= (count (:wait-set record)) (count (get-in restored [:record :wait-set]))))\n474\t        (is (= (set (keys (:parked record))) (set (keys (get-in restored [:record :parked])))))\n475\t        (is (nil? (get-in restored [:machine :yin.k/custody])) \"no custody is restored\")\n476\t        (is (zero? @calls) \"no read, write, mint or close\")\n477\t        (is (= (count (into #{} (map :dao.stream/identity) (vals (get-in prepared [:record :served]))))\n478\t               @attaches)\n479\t            \"every stream attached, once\")\n480\t        (is (reproduces? frozen restored) \"the published pack, byte for byte\")))))\n481\t\n482\t\n483\t(deftest a-restarted-abort-is-refused-test\n484\t  (let [{:keys [frozen]} (frozen-of (rs/parked-reader))\n485\t        restored (rehydrate frozen)]\n486\t    (is (= :ok (:status restored)) (pr-str restored))\n487\t    (is (true? (get-in restored [:record :recovered?])))\n488\t    (is (= [:yin.k/refused :restarted]\n489\t           ((juxt :yin.k/status :yin.k/reason)\n490\t            (export/abort (:machine restored) (:record restored) [] nil))))))\n491\t\n492\t\n493\t(deftest recovery-restores-fresh-name-state-without-receiver-contamination-test\n494\t  (let [source (assoc (rs/parked-reader) :origins 42 :id-counter 88 :yin.k/issued 77)\n495\t        {:keys [frozen]} (frozen-of source)\n496\t        restored (rehydrate frozen\n497\t                            (assoc (rs/new-machine) :origins 99 :id-counter 100\n498\t                                   :store {'receiver-local :wrong} :yin.k/issued 33\n499\t                                   :yin.k/closes [{:receiver-local true}])\n500\t                            (:attach (counting-attach)))]\n501\t    (is (= :ok (:status restored)) (pr-str restored))\n502\t    (is (= 42 (:origins (:machine restored))))\n503\t    (is (= 88 (:id-counter (:machine restored))) \"the carried counter exactly, never max(local, carried)\")\n504\t    (is (= 77 (:yin.k/issued (:machine restored))))\n505\t    (is (not (contains? (:store (:machine restored)) 'receiver-local)))\n506\t    (is (empty? (:yin.k/closes (:machine restored))))\n507\t    (is (reproduces? frozen restored))))\n508\t\n509\t\n510\t(deftest the-id-counter-is-carried-exactly-test\n511\t  (testing \"a receiver whose counter is below the carried one\"\n512\t    (let [source (assoc (rs/parked-reader) :id-counter 500)\n513\t          {:keys [frozen]} (frozen-of source)\n514\t          restored (rehydrate frozen (assoc (rs/new-machine) :id-counter 3) (:attach (counting-attach)))]\n515\t      (is (= 500 (get-in restored [:machine :id-counter])))\n516\t      (is (reproduces? frozen restored)))))\n517\t\n518\t\n519\t(deftest recovery-validation-precedes-attachment-test\n520\t  (let [{:keys [frozen]} (frozen-of (rs/parked-reader))\n521\t        recovery (cbor/decode (:bytes frozen))\n522\t        other (cbor/decode (:bytes (:frozen (frozen-of (rs/parked-explicit)))))\n523\t        pack (cbor/decode (:pack-bytes frozen))\n524\t        reordered (cbor/encode (update pack :yin.k/rows (comp vec reverse)))\n525\t        {:keys [attaches attach]} (counting-attach)]\n526\t    (doseq [[label invalid status]\n527\t            [[\"version 1\" (assoc recovery :yin.k/version 1) :yin.k/profile-mismatch]\n528\t             [\"no tag\" (dissoc recovery :yin.k/export-recovery) :yin.k/profile-mismatch]\n529\t             [\"a header the root does not carry\" (assoc recovery :yin.k/header (rs/header 0 nil #{})) :yin.k/undecodable]\n530\t             [\"a malformed header\" (assoc recovery :yin.k/header {:yin.k/enrolled #{}}) :yin.k/undecodable]\n531\t             [\"issues of another wait count\" (assoc-in recovery [:yin.k/state :issues] []) :yin.k/undecodable]\n532\t             [\"children the tree does not carry\" (assoc-in recovery [:yin.k/state :children] {'x {}}) :yin.k/undecodable]\n533\t             [\"another root id\" (assoc recovery :yin.k/root (:yin.k/root other)) :yin.k/undecodable]\n534\t             [\"another recovery's pack\" (merge recovery (select-keys other [:yin.k/pack-bytes :yin.k/pack-address :yin.k/root]))\n535\t              :yin.k/undecodable]\n536\t             [\"a pack that is not its address\" (assoc recovery :yin.k/pack-address (:yin.k/pack-address other))\n537\t              :yin.k/hash-mismatch]\n538\t             [\"the same root in another row order\"\n539\t              (assoc recovery :yin.k/pack-bytes (jing/bytes->base64 reordered)\n540\t                     :yin.k/pack-address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 reordered))))\n541\t              nil]]]\n542\t      (testing label\n543\t        (let [bytes (cbor/encode invalid)\n544\t              address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))\n545\t              before @attaches\n546\t              restored (export/rehydrate-fenced (rs/new-machine) bytes {:address address :attach attach})]\n547\t          (is (not= :ok (:status restored)) (pr-str restored))\n548\t          (is (nil? (:machine restored)))\n549\t          (when (some? status) (is (= status (:yin.k/status restored)) (pr-str restored)))\n550\t          (when (some? status) (is (= before @attaches) \"refused before any attachment\")))))\n551\t    (testing \"the recovery's own address is checked\"\n552\t      (is (= :yin.k/hash-mismatch\n553\t             (:yin.k/status (export/rehydrate-fenced (rs/new-machine) (:bytes frozen)\n554\t                                                     {:address (:pack-address frozen) :attach attach})))))\n555\t    (testing \"a pack in another row order is not the published pack: recovery is inconsistent\"\n556\t      (let [invalid (assoc recovery :yin.k/pack-bytes (jing/bytes->base64 reordered)\n557\t                           :yin.k/pack-address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 reordered))))\n558\t            bytes (cbor/encode invalid)\n559\t            restored (export/rehydrate-fenced (rs/new-machine) bytes\n560\t                                              {:address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))\n561\t                                               :attach attach})]\n562\t        (is (= [:yin.k/undecodable :recovery-inconsistent]\n563\t               ((juxt :yin.k/status :yin.k/reason) restored)))))))\n564\t\n565\t\n566\t(deftest recovery-preserves-aliases-distinct-cells-and-authentic-closures-test\n567\t  (let [source (vm/run\n568\t                 (rs/load-ast (rs/new-machine)\n569\t                              (rs/let1 's {:type :stream/make :buffer 4}\n570\t                                       (rs/let1 'c (rs/cursor-of (rs/v 's))\n571\t                                                (rs/let1 'd (rs/cursor-of (rs/v 's))\n572\t                                                         (rs/then (rs/def! 'first-c (rs/v 'c))\n573\t                                                                  (rs/then (rs/def! 'alias-c (rs/v 'c))\n574\t                                                                           (rs/then (rs/def! 'distinct-c (rs/v 'd))\n575\t                                                                                    (rs/then (rs/def! 'closure (rs/lam [] (rs/next-of (rs/v 'c))))\n576\t                                                                                             (rs/next-of (rs/v 'c)))))))))))\n577\t        {:keys [frozen]} (frozen-of source)\n578\t        {:keys [attaches calls attach]} (counting-attach)\n579\t        restored (rehydrate frozen (rs/new-machine {:origin :fresh :capability-secret \"recovery-secret\"}) attach)\n580\t        machine' (:machine restored)\n581\t        store (:store machine')\n582\t        closure (get store 'closure)\n583\t        cell-ids (:yin.k/recovery-cell-ids machine')]\n584\t    (is (= :ok (:status frozen)))\n585\t    (is (= :ok (:status restored)) (pr-str restored))\n586\t    (is (= 1 @attaches) \"one stream, one attachment\")\n587\t    (is (zero? @calls) \"no read, mint, append or close during reconstruction\")\n588\t    (is (= (get store 'first-c) (get store 'alias-c)) \"an alias stays one cursor cell\")\n589\t    (is (not= (get store 'first-c) (get store 'distinct-c)) \"two cursor cells stay two\")\n590\t    (is (= 2 (count (set (vals cell-ids)))))\n591\t    (is (not= (get cell-ids (:id (get store 'first-c))) (get cell-ids (:id (get store 'distinct-c)))))\n592\t    (is (engine/authentic-ref? machine' :cursor-ref (get store 'first-c)))\n593\t    (is (values/closure? closure))\n594\t    (is (values/owned-by? closure (:owner machine')))\n595\t    (is (not (values/owned-by? closure (:owner source))))\n596\t    (is (reproduces? frozen restored))))\n597\t\n598\t\n599\t(deftest a-halted-closure-result-is-a-recovery-root-test\n600\t  (let [source (vm/run (rs/load-ast (rs/new-machine) (rs/lam [] (rs/lit 42))))\n601\t        {:keys [frozen]} (frozen-of source (rs/header 0 rs/origin #{}))\n602\t        {:keys [calls attach]} (counting-attach)\n603\t        restored (rehydrate frozen (rs/new-machine {:origin :fresh :capability-secret \"fresh-secret\"}) attach)]\n604\t    (is (values/closure? (:value source)))\n605\t    (is (= :ok (:status frozen)) (pr-str frozen))\n606\t    (is (= :ok (:status restored)) (pr-str restored))\n607\t    (is (values/closure? (:value (:machine restored))))\n608\t    (is (= :exporting (vm/gate-mode (:machine restored))))\n609\t    (is (zero? @calls))\n610\t    (is (reproduces? frozen restored))))\n611\t\n612\t\n613\t(deftest module-store-cursors-travel-in-the-one-pack-test\n614\t  (let [source (rs/parked-module-store-cursors)\n615\t        {:keys [frozen]} (frozen-of source)\n616\t        {:keys [calls attach]} (counting-attach)\n617\t        restored (rehydrate frozen (rs/new-machine) attach)]\n618\t    (is (= :ok (:status frozen)) (pr-str frozen))\n619\t    (is (= :ok (:status restored)) (pr-str restored))\n620\t    (is (= #{'c 'd} (set (keys (get-in restored [:machine :module-stores 'host.mod])))))\n621\t    (is (zero? @calls))\n622\t    (is (reproduces? frozen restored))))\n623\t\n624\t\n625\t(deftest closure-in-blocked-environment-survives-fenced-recovery-test\n626\t  (let [source (vm/run (rs/load-ast (rs/new-machine)\n627\t                                    (rs/let1 'f (rs/lam [] (rs/lit 42))\n628\t                                             (rs/let1 'input {:type :stream/make :buffer 4}\n629\t                                                      (rs/then (rs/next-of (rs/cursor-of (rs/v 'input)))\n630\t                                                               (rs/app (rs/v 'f)))))))\n631\t        source-closure (get-in source [:wait-set 0 :env 'f])\n632\t        {:keys [frozen]} (frozen-of source)\n633\t        {:keys [calls attach]} (counting-attach)\n634\t        restored (rehydrate frozen (rs/new-machine {:origin :fresh :capability-secret \"fresh-secret\"}) attach)\n635\t        closure (get-in restored [:record :wait-set 0 :env 'f])]\n636\t    (is (values/closure? source-closure) (pr-str (:wait-set source)))\n637\t    (is (= :ok (:status restored)) (pr-str restored))\n638\t    (is (values/closure? closure))\n639\t    (is (values/owned-by? closure (:owner (:machine restored))))\n640\t    (is (not (values/owned-by? closure (:owner source))))\n641\t    (is (zero? @calls))\n642\t    (is (= :exporting (vm/gate-mode (:machine restored))))\n643\t    (is (empty? (:wait-set (:machine restored))))\n644\t    (is (reproduces? frozen restored))))\n645\t\n646\t\n647\t(deftest exclusive-recovery-retains-operation-ids-issues-and-local-enrollment-test\n648\t  (let [op-id (rs/op-id 0)\n649\t        source (-> (rs/parked-writer)\n650\t                   (assoc :yin.k/issued 10)\n651\t                   (assoc-in [:wait-set 0 :yin.k/issue] 9)\n652\t                   (rs/with-op-id :put op-id))\n653\t        header (rs/header 1 rs/origin #{\"s0\"})\n654\t        {:keys [frozen prepared]} (frozen-of source header)\n655\t        {:keys [calls attach]} (counting-attach)\n656\t        restored (rehydrate frozen (rs/new-machine) attach)\n657\t        recovery (cbor/decode (:bytes frozen))]\n658\t    (is (= :ok (:status prepared)) (pr-str prepared))\n659\t    (is (= :ok (:status restored)) (pr-str restored))\n660\t    (is (= op-id (get-in restored [:record :wait-set 0 :op-id])))\n661\t    (is (= 9 (get-in restored [:record :wait-set 0 :yin.k/issue])) \"the recovered stamp, not the lower's numbering\")\n662\t    (is (= 10 (get-in restored [:machine :yin.k/issued])))\n663\t    (is (= #{\"s0\"} (get-in restored [:record :header :yin.k/enrolled])) \"the enrolled set stays local\")\n664\t    (is (= #{\"s0\"} (get-in recovery [:yin.k/header :yin.k/enrolled])))\n665\t    (is (not (some #(= :yin.k/enrolled %) (tree-seq coll? seq (cbor/decode (:pack-bytes frozen)))))\n666\t        \"and never enters the pack\")\n667\t    (is (nil? (get-in restored [:machine :yin.k/custody])))\n668\t    (is (zero? @calls))\n669\t    (is (reproduces? frozen restored))))\n670\t\n671\t\n672\t(deftest rehydrating-an-install-child-does-not-repeat-initialization-or-io-test\n673\t  (let [initializations (atom 0)\n674\t        counting-make (fn [capacity]\n675\t                        (swap! initializations inc)\n676\t                        (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n677\t                                             ringbuffer/capacity-key capacity}))\n678\t        request (ring 64)\n679\t        response (ring 64)\n680\t        blocked (vm/run (rs/load-ast (rs/new-machine {:make-stream counting-make\n681\t                                                      :link-request request :link-response response})\n682\t                                     (rs/then (rs/app (rs/v 'require) (rs/lit 'host.mod))\n683\t                                              (rs/app (rs/v 'host.mod/f)))))\n684\t        _ (stream/append! response (assoc (rs/module-response)\n685\t                                          :yin.link/id (:link-id (first (:wait-set blocked)))))\n686\t        source (vm/run blocked)\n687\t        receiver (rs/new-machine {:make-stream counting-make})\n688\t        carried @initializations\n689\t        {:keys [frozen]} (frozen-of source)\n690\t        {:keys [calls attach]} (counting-attach)\n691\t        restored (rehydrate frozen receiver attach)]\n692\t    (is (pos? carried))\n693\t    (is (= :ok (:status restored)) (pr-str restored))\n694\t    (is (= carried @initializations) \"the child's initialization is not repeated\")\n695\t    (is (zero? @calls))\n696\t    (is (= :exporting (vm/gate-mode (get-in restored [:machine :installs 'host.mod :vm]))))\n697\t    (is (empty? (get-in restored [:machine :installs 'host.mod :vm :wait-set])))\n698\t    (is (= 1 (count (get-in restored [:record :children 'host.mod :wait-set]))))\n699\t    (is (reproduces? frozen restored))))\n700\t\n701\t\n702\t(deftest recovery-retains-a-blocked-ffi-request-and-its-response-route-test\n703\t  (let [inbound (reify\n704\t                  stream/IDaoStreamDescriptor\n705\t                  (descriptor [_] {:dao.stream/outcome :dao.stream/ok :dao.stream/identity \"full-in\"})\n706\t\n707\t\n708\t                  stream/IDaoStreamWriter\n709\t\n710\t                  (append! [_ _] {:dao.stream/outcome :dao.stream/full}))\n711\t        outbound (ring 8)\n712\t        source (vm/run (rs/load-ast\n713\t                         (rs/new-machine {:call-in inbound :call-out outbound\n714\t                                          :call-out-cursor (vm/mint-oldest outbound :test)})\n715\t                         {:type :dao.stream.apply/call :op :op/echo :operands [(rs/lit \"hello\")]}))\n716\t        _ (is (true? (:request-sent (first (:wait-set source)))) (pr-str (:wait-set source)))\n717\t        {:keys [frozen record]} (frozen-of source)\n718\t        {:keys [calls attach]} (counting-attach)\n719\t        restored (rehydrate frozen (rs/new-machine) attach)]\n720\t    (is (= :ok (:status frozen)) (pr-str frozen))\n721\t    (is (= :ok (:status restored)) (pr-str restored))\n722\t    (is (= (get-in record [:wait-set 0 :call-id])\n723\t           (get-in restored [:record :wait-set 0 :call-id])))\n724\t    (is (= (get-in record [:wait-set 0 :datom])\n725\t           (get-in restored [:record :wait-set 0 :datom])))\n726\t    (is (zero? @calls))\n727\t    (is (reproduces? frozen restored))))\n728\t\n729\t\n730\t;; =============================================================================\n731\t;; Abort\n732\t;; =============================================================================\n733\t\n734\t(defn- exporting\n735\t  [machine]\n736\t  (let [r (export/enter machine)]\n737\t    [(:machine r) (:record r) machine]))\n738\t\n739\t\n740\t(deftest abort-with-no-persisted-intent-restores-the-machine-test\n741\t  (let [[m record original] (exporting (parked-machine))\n742\t        r (export/abort m record [] nil)]\n743\t    (is (= :ok (:status r)))\n744\t    (is (= original (:machine r)) \"the old local machine, as it was\")))\n745\t\n746\t\n747\t(deftest abort-restores-the-prior-gate-test\n748\t  (let [[s sref _ _] (gated)\n749\t        s (run-effect s :stream/put {:stream sref, :val 1})\n750\t        [m record _] (exporting s)]\n751\t    (is (= s (:machine (export/abort m record [] nil))))))\n752\t\n753\t\n754\t(deftest abort-after-provably-not-appended-attempts-test\n755\t  (let [[m record original] (exporting (parked-machine))]\n756\t    (doseq [outcome [:dao.stream/full :dao.stream/invalid-value\n757\t                     :dao.stream/closed :dao.stream/refused]]\n758\t      (is (= original\n759\t             (:machine (export/abort m record\n760\t                                     [{:append outcome} {:append outcome}]\n761\t                                     nil)))\n762\t          (str outcome \" proves nothing was appended\")))))\n763\t\n764\t\n765\t(deftest abort-is-refused-when-the-offer-may-have-been-accepted-test\n766\t  (let [[m record _] (exporting (parked-machine))\n767\t        refused? (fn [attempts]\n768\t                   (let [r (export/abort m record attempts nil)]\n769\t                     (and (= :yin.k/refused (:yin.k/status r))\n770\t                          (= :offer-possibly-accepted (:yin.k/reason r)))))]\n771\t    (testing \"an unknown append (intent persisted, no outcome)\"\n772\t      (is (refused? [{}])))\n773\t    (testing \"an unknown append among provable ones\"\n774\t      (is (refused? [{:append :dao.stream/full} {}])))\n775\t    (testing \"an accepted append\"\n776\t      (is (refused? [{:append :dao.stream/ok}])))\n777\t    (testing \"a transport error is unknown delivery\"\n778\t      (is (refused? [{:append :dao.stream/transport-error}])))\n779\t    (testing \"a refusal that followed an unknown append is no evidence\"\n780\t      (is (refused? [{} {:append :dao.stream/full\n781\t                         :reply :yin.k/refused}])))\n782\t    (testing \"a refusal of one request is no evidence of the others\"\n783\t      (is (refused? [{:append :dao.stream/ok :reply :yin.k/refused}])))\n784\t    (testing \"the machine stays fenced\"\n785\t      (is (= :exporting (vm/gate-mode m))))))\n786\t\n787\t\n788\t(deftest a-holder-past-its-lease-bound-cannot-abort-test\n789\t  (let [[s sref _ _] (gated)\n790\t        s (-> (run-effect s :stream/put {:stream sref, :val 1})\n791\t              (assoc :yin.k/custody {:yin.k/occurrence \"o\"}))\n792\t        [m record original] (exporting s)\n793\t        abort (fn [tenure] (export/abort m record [] tenure))\n794\t        reason (fn [r] [(:yin.k/status r) (:yin.k/reason r)])]\n795\t    (testing \"current, ledger-confirmed tenure may abort\"\n796\t      (is (= original (:machine (abort {:now 10 :bound 20 :live true})))))\n797\t    (testing \"at the bound and past it, never\"\n798\t      (doseq [t [{:now 20 :bound 20 :live true}\n799\t                 {:now 21 :bound 20 :live true}\n800\t                 {:now 21 :bound 20}]]\n801\t        (is (= [:yin.k/refused :tenure-ended] (reason (abort t))))))\n802\t    (testing \"inside the bound with no ledger evidence is unconfirmed\"\n803\t      (doseq [t [{:now 10 :bound 20} {:now 10 :bound 20 :live false} nil]]\n804\t        (is (= [:yin.k/refused :tenure-unconfirmed] (reason (abort t))))))\n805\t    (testing \"tenure alone does not license an uncertain offer\"\n806\t      (is (= :offer-possibly-accepted\n807\t             (:yin.k/reason (export/abort m record [{}]\n808\t                                          {:now 10 :bound 20 :live true})))))))\n809\t\n810\t\n811\t(deftest abort-needs-an-exporting-machine-test\n812\t  (let [[m record _] (exporting (parked-machine))\n813\t        restored (:machine (export/abort m record [] nil))]\n814\t    (is (= :yin.k/refused\n815\t           (:yin.k/status (export/abort restored record [] nil))))))\n816\t\n817\t\n818\t;; Holder preparation checks moved from the old-codec lift suite.\n819\t\n820\t(defn- same-bytes?\n821\t  [a b]\n822\t  (= (vec a) (vec b)))\n823\t\n824\t\n825\t(defn- prepare\n826\t  [m record serve! header]\n827\t  (export/prepare m record serve! header (index)))\n828\t\n829\t\n830\t(defn- prepared\n831\t  [m header]\n832\t  (let [e (export/enter m)]\n833\t    {:machine (:machine e)\n834\t     :prepared (prepare (:machine e) (:record e) (rs/serve-table) header)}))\n835\t\n836\t\n837\t(deftest a-malformed-header-is-a-caller-defect-test\n838\t  (let [{m :machine record :record} (export/enter (rs/parked-reader))]\n839\t    (doseq [h [:x {} (dissoc (rs/header 0) :yin.k/arbitration)\n840\t               (dissoc (rs/header 0) :yin.k/next-op-seq)\n841\t               (dissoc (rs/header 0) :yin.k/enrolled)]]\n842\t      (is (throws? #(prepare m record (rs/serve-table) h))\n843\t          (pr-str h)))))\n844\t\n845\t\n846\t(deftest two-encodes-of-one-prepared-record-give-equal-bytes-test\n847\t  (doseq [[n machine h] [[\"reader\" (rs/parked-reader) (rs/header 0 nil #{})]\n848\t                         [\"installer\" (rs/parked-installer) (rs/header 6)]\n849\t                         [\"explicit\" (rs/parked-explicit) (rs/header 1)]\n850\t                         [\"fork\" (rs/parked-reader) nil]]]\n851\t    (let [{m :machine p :prepared} (prepared machine h)\n852\t          record (:record p)\n853\t          a (export/encode m record)\n854\t          b (export/encode m record)]\n855\t      (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n856\t      (is (same-bytes? (:bytes a) (:bytes b)) n)\n857\t      (is (= (:address a) (:address b)) n))))\n858\t\n859\t\n860\t(deftest the-served-table-is-plain-data-keyed-by-path-and-resource-test\n861\t  (let [{p :prepared} (prepared (rs/parked-installer) (rs/header 6))\n862\t        served (:served (:record p))]\n863\t    (is (seq served))\n864\t    (is (every? (fn [[[path id] descriptor]]\n865\t                  (and (vector? path) (some? id)\n866\t                       (string? (:dao.stream/identity descriptor))))\n867\t                served))\n868\t    (is (some (fn [[[path _] _]] (= ['host.mod] path)) served)\n869\t        \"the child's streams are keyed by its path\"))\n870\t  (testing \"one handle under two resource ids: served once, keyed twice\"\n871\t    (let [calls (atom 0)\n872\t          serve! (fn [_]\n873\t                   (swap! calls inc) {:dao.stream/identity \"s0\"\n874\t                                      :dao.stream/channel\n875\t                                      {:dao.stream/type\n876\t                                       :dao.stream.test/channel}})\n877\t          {m :machine record :record} (export/enter (rs/parked-writer-shared))\n878\t          p (prepare m record serve! (rs/header 3 rs/origin #{}))\n879\t          e (export/encode m (:record p))]\n880\t      (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n881\t      (is (= 1 @calls) \"the one handle asked once\")\n882\t      (is (= 2 (count (:served (:record p)))) \"both resource keys retained\")\n883\t      (is (= :ok (:status e)) (pr-str e))\n884\t      (is (throws? #(export/encode\n885\t                      m (update (:record p) :served\n886\t                                dissoc (ffirst (:served (:record p))))))\n887\t          \"a key the record lacks is still a defect\"))))\n888\t\n889\t\n890\t(deftest a-retry-serves-no-already-served-handle-test\n891\t  (let [served {:dao.stream/identity \"s0\"\n892\t                :dao.stream/channel {:dao.stream/type\n893\t                                     :dao.stream.test/channel}}\n894\t        seen (atom #{})\n895\t        ;; answers the first distinct handle it is asked about, and that\n896\t        ;; one whenever it is asked again; every other handle gets no\n897\t        ;; answer, so the prepare refuses once the walk reaches the\n898\t        ;; independent third stream, after the shared handle's aliases\n899\t        first-only (fn [h]\n900\t                     (when (or (contains? @seen h) (empty? @seen))\n901\t                       (swap! seen conj h)\n902\t                       served))\n903\t        {m :machine record :record} (export/enter\n904\t                                      (rs/parked-writer-shared-late))\n905\t        refused (prepare m record first-only (rs/header 3 rs/origin #{}))]\n906\t    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n907\t    (is (= 1 (count @seen)) \"exactly one handle ever answered\")\n908\t    (is (every? #(= served %) (vals (:served (:record refused))))\n909\t        \"what was served is retained\")\n910\t    (testing \"the retry resolves the shared handle's every alias from the\n911\t              retained table and the machine's bindings: the handle is\n912\t              not served again\"\n913\t      (let [calls (atom 0)\n914\t            table (atom {})\n915\t            counting (fn [h]\n916\t                       (swap! calls inc)\n917\t                       (if-some [d (get @table h)]\n918\t                         d\n919\t                         (let [d {:dao.stream/identity\n920\t                                  (str \"s\" (count @table))}]\n921\t                           (swap! table assoc h d)\n922\t                           d)))\n923\t            p (prepare m (:record refused) counting\n924\t                       (rs/header 3 rs/origin #{}))\n925\t            e (export/encode m (:record p))]\n926\t        (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n927\t        (is (= 1 @calls) \"only the never-served third stream is asked\")\n928\t        (is (= 3 (count (:served (:record p)))) \"every resource key\")\n929\t        (is (= 2 (count (distinct (vals (:served (:record p))))))\n930\t            \"one identity for the shared handle's two keys\")\n931\t        (is (= :ok (:status e)) (pr-str e))\n932\t        (is (= 1 (count @seen)) \"the first attempt served once\")))\n933\t    (testing \"a retry over a machine whose bindings moved -- a fresh\n934\t              resource alias of the served handle reached first\"\n935\t      (let [[path id :as retained] (first (keys (:served (:record refused))))\n936\t            h (get-in m (into path [:resources id]))\n937\t            _ (is (some? retained) \"one key is retained\")\n938\t            _ (is (some? h) \"the retained key resolves to its handle\")\n939\t            [alias m2] (engine/attach-resource m h)\n940\t            ;; prepare reads the record's waits, so the fresh alias rides\n941\t            ;; the record's first wait entry's environment\n942\t            record' (assoc-in (:record refused) [:wait-set 0 :env 'again]\n943\t                              alias)\n944\t            calls (atom 0)\n945\t            counting (fn [_] (swap! calls inc) served)\n946\t            p (prepare m2 record' counting (rs/header 3 rs/origin #{}))]\n947\t        (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n948\t        (is (= 1 @calls) \"only the never-served third stream is asked\")\n949\t        (is (= 4 (count (:served (:record p))))\n950\t            \"the fresh alias, the retained alias, the pending's and the\n951\t             third stream's\")\n952\t        (is (= :ok (:status (export/encode m2 (:record p))))\n953\t            \"the record encodes with no serving\")))))\n954\t\n955\t\n956\t(deftest the-record-round-trips-the-canonical-codec-test\n957\t  (let [{m :machine p :prepared} (prepared (rs/parked-explicit) (rs/header 1))\n958\t        record (:record p)\n959\t        back (cbor/decode (cbor/encode record))]\n960\t    (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n961\t    (is (same-bytes? (cbor/encode record) (cbor/encode back)))\n962\t    (is (same-bytes? (:bytes (export/encode m record))\n963\t                     (:bytes (export/encode m back)))\n964\t        \"the stored record encodes to the same bytes\")))\n965\t\n966\t\n967\t(deftest recovery-retains-every-parked-record-test\n968\t  (let [source (rs/parked-explicit)\n969\t        [active saved] (first (:parked source))\n970\t        extra :unreachable-park\n971\t        source (assoc-in source [:parked extra] (assoc saved :id extra))\n972\t        {:keys [frozen]} (frozen-of source)\n973\t        {:keys [calls attach]} (counting-attach)\n974\t        restored (rehydrate frozen (rs/new-machine) attach)]\n975\t    (is (= :ok (:status frozen)))\n976\t    (is (= :ok (:status restored)))\n977\t    (is (= #{active extra} (set (keys (get-in restored [:record :parked])))))\n978\t    (is (empty? (get-in restored [:machine :parked])))\n979\t    (is (zero? @calls))\n980\t    (is (reproduces? frozen restored))))\n981\t"}]},"parent_tool_use_id":null,"session_id":"72b4f199-a30e-42b5-b648-90d6dc2ab934","uuid":"403fe7f3-b10f-4e87-a5b1-fa818de37580","timestamp":"2026-10-13T13:58:48.692Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7b/test/yin/vm/ucf/holder/export_test.cljc","content":"(ns yin.vm.ucf.holder.export-test\n  \"D8 over the row carrier (UCF 7.7.4; r3 1.8 and 1.9; phase 7b): the\n   exporting state, the prepare/encode split over rows/lift-task, the\n   export-recovery object version 2, its fenced rehydration and the abort\n   rule. Every machine is a semantic-register machine the real engine\n   parked (yin.vm.ucf.rows-support); counting handles show what the gate,\n   the encode and the rehydration touch.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.stream :as stream]\n            [dao.stream.ringbuffer :as ringbuffer]\n            [yin.vm :as vm]\n            [yin.vm.engine :as engine]\n            [yin.vm.module :as module]\n            [yin.vm.values :as values]\n            [yin.vm.test-utils :as tu]\n            [yin.vm.ucf.holder.export :as export]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-support :as rs]))\n\n\n;; =============================================================================\n;; Machines, the exporter, the receiver's attach\n;; =============================================================================\n\n(defn- throws?\n  [thunk]\n  (try (thunk) false\n       (catch #?(:cljd Object :clj Throwable :cljs :default) _ true)))\n\n\n(defn- ring\n  [capacity]\n  (:dao.stream/handle\n    (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                         ringbuffer/capacity-key capacity})))\n\n\n(defn- index\n  \"The composition's source index, as the composition reads it.\"\n  []\n  @rs/source-index)\n\n\n(defn- two-streams\n  \"Parks on a read of the first stream; the store also holds the second\n   stream and a cursor on each, so the lift reaches two streams.\"\n  []\n  (rs/let1 'a {:type :stream/make :buffer 4}\n           (rs/let1 'b {:type :stream/make :buffer 4}\n                    (rs/then (rs/def! 'held-a (rs/cursor-of (rs/v 'a)))\n                             (rs/then (rs/def! 'held-b (rs/cursor-of (rs/v 'b)))\n                                      (rs/next-of (rs/v 'held-a)))))))\n\n\n(defn- parked-machine\n  []\n  (vm/run (rs/load-ast (rs/new-machine) (two-streams))))\n\n\n(defn- served-table\n  \"A `serve!` that counts its calls and answers one stable identity per\n   handle.\"\n  []\n  (let [calls (atom 0)\n        table (atom {})]\n    {:calls calls\n     :table table\n     :serve! (fn [h]\n               (swap! calls inc)\n               (or (get @table h)\n                   (let [served {:dao.stream/identity (str \"s\" (count @table))\n                                 :dao.stream/channel {:dao.stream/type :test/channel}}]\n                     (swap! table assoc h served)\n                     served)))}))\n\n\n(defn- counting-handle\n  [calls]\n  (reify\n    stream/IDaoStreamReader\n\n    (cursor\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok, :dao.stream/cursor ::at})\n\n    (next\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/blocked})\n\n\n    stream/IDaoStreamWriter\n\n    (append!\n      [_ _]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok})\n\n\n    stream/IDaoStreamClosable\n\n    (close!\n      [_]\n      (swap! calls inc)\n      {:dao.stream/outcome :dao.stream/ok})))\n\n\n(defn- counting-attach\n  \"A receiver's attach!: a fresh counting handle per descriptor; every\n   attach and every handle operation counted.\"\n  []\n  (let [attaches (atom 0) calls (atom 0)]\n    {:attaches attaches\n     :calls calls\n     :attach (fn [_]\n               (swap! attaches inc)\n               {:dao.stream/outcome :dao.stream/ok\n                :dao.stream/handle (counting-handle calls)})}))\n\n\n(defn- frozen-of\n  \"Enter, prepare under header with the composition's index, freeze:\n   {:machine :record :prepared :frozen :table}.\"\n  ([source] (frozen-of source nil))\n  ([source header]\n   (let [{:keys [machine record]} (export/enter source)\n         {:keys [serve! table]} (served-table)\n         prepared (export/prepare machine record serve! header (index))]\n     {:machine machine :record record :prepared prepared :table table\n      :frozen (when (= :ok (:status prepared)) (export/freeze machine (:record prepared)))})))\n\n\n(defn- rehydrate\n  ([frozen] (rehydrate frozen (rs/new-machine) (:attach (counting-attach))))\n  ([frozen receiver attach]\n   (export/rehydrate-fenced receiver (:bytes frozen) {:address (:address frozen) :attach attach})))\n\n\n(defn- reproduces?\n  [frozen restored]\n  (= (vec (:pack-bytes frozen))\n     (vec (:bytes (export/encode (:machine restored) (:record restored))))))\n\n\n;; =============================================================================\n;; Gated machines over counting handles (machine-level, kernel-agnostic)\n;; =============================================================================\n\n(def ^:private park-entry-fns\n  {:stream/put (fn [_s _e r] {:reason :put, :stream-id (:stream-id r)}),\n   :stream/next (fn [_s _e r]\n                  {:reason :next,\n                   :cursor-ref (:cursor-ref r),\n                   :stream-id (:stream-id r)})})\n\n\n(def ^:private opts {:park-entry-fns park-entry-fns})\n\n\n(defn- gated\n  \"[state stream-ref cursor-ref calls] under the :running gate.\"\n  []\n  (let [calls (atom 0)\n        [sref s0] (engine/attach-resource\n                    (vm/empty-state {:make-stream tu/make-stream,\n                                     :capability-secret tu/secret})\n                    (counting-handle calls))\n        [cref s1] (engine/handle-cursor s0 {:stream sref} :cursor-0)]\n    (reset! calls 0)\n    [(assoc s1 :yin.k/gate :running) sref cref calls]))\n\n\n(defn- run-effect\n  [state kind m]\n  (:state (engine/handle-effect state (module/make-effect kind m) opts)))\n\n\n;; =============================================================================\n;; Entering exporting\n;; =============================================================================\n\n(deftest enter-moves-waits-and-fences-the-machine-test\n  (let [[s sref _ _] (gated)\n        s (run-effect s :stream/put {:stream sref, :val 1})\n        waits (:wait-set s)\n        r (export/enter s)]\n    (is (= :ok (:status r)) (pr-str r))\n    (is (= :exporting (vm/gate-mode (:machine r))))\n    (is (empty? (:wait-set (:machine r))) \"nothing left to poll\")\n    (is (= waits (get-in r [:record :wait-set])) \"waits kept in order\")\n    (is (= :running (get-in r [:record :gate])))\n    (testing \"an exporting machine cannot enter again\"\n      (is (= :yin.k/refused (:yin.k/status (export/enter (:machine r))))))))\n\n\n(deftest exporting-appends-nothing-test\n  (let [[s sref _ calls] (gated)\n        s (run-effect s :stream/put {:stream sref, :val 1})\n        child-calls (atom 0)\n        child (vm/run (rs/load-ast (rs/new-machine\n                                     {:make-stream\n                                      (fn [_capacity]\n                                        {:dao.stream/outcome :dao.stream/ok\n                                         :dao.stream/handle (counting-handle child-calls)})})\n                                   (rs/next-of (rs/cursor-of {:type :stream/make :buffer 4}))))\n        s (assoc s :installs {'foo {:phase :running\n                                    :vm child\n                                    :parent [:t0 0]\n                                    :response {}}})\n        _ (reset! child-calls 0)\n        {m :machine} (export/enter s)\n        stamped (assoc s :parked {:parked-0 {:type :parked-continuation\n                                             :id :parked-0}})]\n    (testing \"polling the source\"\n      (engine/check-wait-set m)\n      (is (zero? @calls)))\n    (testing \"ticking its install child\"\n      (let [swept (engine/check-wait-set m)]\n        (is (zero? @child-calls))\n        (is (= child (get-in swept [:installs 'foo :vm])))))\n    (testing \"a direct resume\"\n      (let [restored (atom 0)]\n        (is (throws? #(engine/resume-continuation\n                        (assoc m :parked (:parked stamped))\n                        :parked-0 1\n                        (fn [st _ _] (swap! restored inc) st))))\n        (is (zero? @restored))\n        (is (zero? @calls))))))\n\n\n(deftest a-non-empty-ready-queue-is-not-quiescent-test\n  (let [[s _ _ _] (gated)\n        r (export/enter (assoc s :ready-queue [{:id 1}]))]\n    (is (= :yin.k/not-quiescent (:yin.k/status r)))\n    (testing \"a child's queue too\"\n      (let [r (export/enter\n                (assoc s :installs {'foo {:vm (assoc (vm/empty-state {})\n                                                     :ready-queue [{:id 1}])}}))]\n        (is (= :yin.k/not-quiescent (:yin.k/status r)))))))\n\n\n(defn- refused-as\n  [kind r]\n  (and (= :yin.k/non-portable (:yin.k/status r))\n       (= :reason-mismatch (:yin.k/kind r))\n       (= kind (:yin.k/hold r))))\n\n\n(deftest each-export-refusal-fires-on-a-real-parked-machine-test\n  (let [[s sref cref calls] (gated)]\n    (testing \"an :observe entry\"\n      (let [m (run-effect s :stream/poll {:cursor cref})]\n        (is (= :observe (:reason (first (:wait-set m)))))\n        (is (refused-as :observe (export/enter m)))))\n    (testing \"an entry carrying :yin.k/held\"\n      (let [m (run-effect s :stream/next {:cursor cref})\n            m (assoc-in m [:wait-set 0 :yin.k/held] {:state :observed})]\n        (is (refused-as :held (export/enter m)))))\n    (testing \"an unminted cursor cell\"\n      (let [m (run-effect s :stream/cursor {:stream sref})]\n        (is (refused-as :unminted-cursor (export/enter m)))))\n    (testing \"a pending close\"\n      (let [m (run-effect s :stream/close {:stream sref})]\n        (is (seq (:yin.k/closes m)))\n        (is (refused-as :pending-close (export/enter m)))))\n    (testing \"a link request with no response cursor\"\n      (let [m (rs/parked-linker)\n            entry (first (:wait-set m))]\n        (is (= :link-request (:reason entry)))\n        (is (not (contains? entry :cursor)))\n        (is (refused-as :link-cursor-not-installed (export/enter m)))))\n    (testing \"a refusal in an install child names its path\"\n      (let [child (run-effect s :stream/close {:stream sref})\n            m (assoc (vm/empty-state {})\n                     :installs {'foo {:vm child}})\n            r (export/enter m)]\n        (is (refused-as :pending-close r))\n        (is (= ['foo] (:yin.k/path r)))))\n    (testing \"a refusal leaves the machine as it was\"\n      (is (zero? @calls)))))\n\n\n(deftest an-explicit-park-travels-in-the-record-test\n  (let [m (rs/parked-explicit)\n        {m' :machine record :record} (export/enter m)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare m' record serve! nil (index))]\n    (is (seq (:parked m)) \"the source holds a parked record\")\n    (is (= (:parked m) (:parked record)) \"the record holds every parked record\")\n    (is (empty? (:parked m')) \"the machine's :parked holds none\")\n    (is (empty? (:wait-set m')))\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (let [e (export/encode m' (:record prepared))]\n      (is (= :ok (:status e)) (pr-str e))\n      (is (= :parked (:kind e))))\n    (is (= m (:machine (export/abort m' record [] nil)))\n        \"abort restores machine equality\")))\n\n\n(deftest an-install-childs-parked-records-stay-in-the-child-test\n  (let [m (rs/parked-installer)\n        parked {:p0 {:type :parked-continuation :id :p0}}\n        m (assoc-in m [:installs 'host.mod :vm :parked] parked)\n        {m' :machine record :record :as r} (export/enter m)]\n    (is (= :ok (:status r)) (pr-str r))\n    (is (= parked (get-in m' [:installs 'host.mod :vm :parked]))\n        \"the child's parked records are not moved\")\n    (is (not-any? #(contains? (:parked record) %) (keys parked)))))\n\n\n;; =============================================================================\n;; Prepare, then encode\n;; =============================================================================\n\n(deftest prepare-serves-once-per-stream-and-encode-serves-nothing-test\n  (let [m (parked-machine)\n        {:keys [calls table serve!]} (served-table)\n        {m' :machine record :record} (export/enter m)\n        prepared (export/prepare m' record serve! nil (index))\n        record' (:record prepared)\n        after-prepare @calls\n        e1 (export/encode m' record')\n        e2 (export/encode m' record')]\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (= 2 (count @table)) \"two streams reached\")\n    (is (= (count @table) after-prepare) \"serve! once per stream\")\n    (is (= (count @table) (count (:served record'))))\n    (is (every? (fn [[path id]] (and (= [] path) (keyword? id))) (keys (:served record')))\n        \"keyed by task path and resource id\")\n    (is (= after-prepare @calls) \"encode calls nothing\")\n    (is (= :ok (:status e1)) (pr-str e1))\n    (is (= (vec (:bytes e1)) (vec (:bytes e2))) \"deterministic bytes\")\n    (is (= (:address e1) (:address e2)))\n    (testing \"the encode is the row pack: its address is the bytes' BLAKE3, distinct from its root\"\n      (is (jing/segment-bytes-match? (:address e1) (:bytes e1)))\n      (is (= (:address e1) (rows/pack-address (cbor/decode (:bytes e1)))))\n      (is (= (:root e1) (:yin.k/root (cbor/decode (:bytes e1)))))\n      (is (not= (:root e1) (:address e1))))\n    (testing \"preparing a prepared record again serves nothing new\"\n      (export/prepare m' record' serve! nil (index))\n      (is (= after-prepare @calls)))\n    (testing \"an unprepared record is a defect, not a refusal\"\n      (is (throws? #(export/encode m' (assoc record :source-index (index))))))))\n\n\n(deftest the-lift-takes-trees-from-the-composition-source-index-test\n  (let [m (parked-machine)\n        {m' :machine record :record} (export/enter m)\n        {:keys [serve!]} (served-table)\n        prepared (export/prepare m' record serve! nil (index))\n        wire (cbor/decode (:bytes (export/encode m' (:record prepared))))\n        task (rows/decode wire)\n        trees (get-in task [:slots 10 :yin.k/trees])]\n    (is (= (index) (:source-index (:record prepared))) \"the record retains the index it lifted under\")\n    (is (seq trees))\n    (is (every? (fn [[a ts]] (= ts (get (index) a))) trees) \"every carried A names its trees from the index\")\n    (testing \"without the composition's index the export refuses: the AST is never lost\"\n      (let [{m2 :machine r2 :record} (export/enter (parked-machine))\n            refused (export/prepare m2 r2 serve! nil {})]\n        (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n        (is (seq (get-in refused [:yin.k/missing :yin.k/trees])))))))\n\n\n(deftest prepare-reaches-install-children-once-test\n  (let [m (rs/parked-installer)\n        {:keys [calls table serve!]} (served-table)\n        {m' :machine record :record} (export/enter m)\n        prepared (export/prepare m' record serve! nil (index))]\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (pos? @calls))\n    (is (= @calls (count @table)) \"each stream, child's included, once\")\n    (is (some (fn [[path _]] (= ['host.mod] path)) (keys (get-in prepared [:record :served])))\n        \"a child's stream is keyed under the child's path\")\n    (let [n @calls]\n      (is (= :ok (:status (export/encode m' (:record prepared)))))\n      (is (= n @calls)))))\n\n\n(def ^:private served-answer\n  {:dao.stream/identity \"s0\"\n   :dao.stream/channel {:dao.stream/type :test/channel}})\n\n\n(deftest a-refused-prepare-keeps-what-it-served-test\n  (let [m (parked-machine)\n        {m' :machine record :record} (export/enter m)\n        first-handle (atom nil)\n        ;; serves the first stream it is asked about, refuses the rest\n        stingy (fn [h]\n                 (compare-and-set! first-handle nil h)\n                 (when (= h @first-handle) served-answer))\n        refused (export/prepare m' record stingy nil (index))]\n    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n    (is (= 1 (count (get-in refused [:record :served]))))\n    (testing \"a retry with the returned record never re-serves that stream\"\n      (let [asked (atom [])\n            {:keys [serve!]} (served-table)\n            retry (export/prepare m' (:record refused)\n                                  (fn [h]\n                                    (swap! asked conj h)\n                                    (serve! h))\n                                  nil (index))]\n        (is (= :ok (:status retry)) (pr-str retry))\n        (is (not-any? #(= @first-handle %) @asked))\n        (is (= 1 (count @asked)) \"only the other stream\")))))\n\n\n(deftest a-custody-refusal-after-the-walk-keeps-what-the-walk-served-test\n  ;; phase-7a D4: the row lift serves while it walks and decides the\n  ;; protection and exhaustion refusals after; the record accounts for it\n  (doseq [[label header expected]\n          [[\"an enrolled write without an operation id\"\n            (rs/header 0 rs/origin #{\"s0\"}) :unprotected-pending]\n           [\"an exhausted counter\"\n            (rs/header rows/max-exact rs/origin #{}) :op-seq-exhausted]]]\n    (testing label\n      (let [{m :machine record :record} (export/enter (rs/parked-writer))\n            {:keys [calls serve!]} (served-table)\n            refused (export/prepare m record serve! header (index))\n            served @calls]\n        (is (= :yin.k/non-portable (:yin.k/status refused)) (pr-str refused))\n        (is (= expected (:yin.k/kind refused)))\n        (is (pos? served) \"the walk served before the refusal\")\n        (is (= served (count (get-in refused [:record :served]))) \"and the record retains every answer\")\n        (export/prepare m (:record refused) serve! header (index))\n        (is (= served @calls) \"a retry serves nothing twice\")))))\n\n\n;; =============================================================================\n;; Freeze: recovery version 2\n;; =============================================================================\n\n(deftest the-recovery-object-is-the-pack-and-holder-local-state-test\n  (let [{:keys [frozen prepared machine]} (frozen-of (rs/parked-explicit))\n        recovery (cbor/decode (:bytes frozen))\n        published (export/encode machine (:record prepared))]\n    (is (= :ok (:status frozen)) (pr-str frozen))\n    (is (= #{:yin.k/export-recovery :yin.k/version :yin.k/pack-address :yin.k/root\n             :yin.k/pack-bytes :yin.k/header :yin.k/state}\n           (set (keys recovery)))\n        \"one body: no snapshot, no descriptors (the pack carries them)\")\n    (is (= 2 (:yin.k/version recovery)))\n    (is (= (:address published) (:pack-address frozen) (:yin.k/pack-address recovery)))\n    (is (= (:root published) (:root frozen) (:yin.k/root recovery)))\n    (is (= (vec (:bytes published)) (vec (:pack-bytes frozen))\n           (vec (jing/base64->bytes (:yin.k/pack-bytes recovery)))))\n    (is (jing/segment-bytes-match? (:address frozen) (:bytes frozen)))\n    (is (= #{:gate :origins :issues :issued :children} (set (keys (:yin.k/state recovery)))))))\n\n\n;; =============================================================================\n;; Rehydrate: fenced, reproducible, without program IO\n;; =============================================================================\n\n(deftest complete-export-recovery-is-fenced-and-reproducible-test\n  (doseq [[label source header] [[\"a parked reader\" (rs/parked-reader) nil]\n                                 [\"an explicit park\" (rs/parked-explicit) nil]\n                                 [\"an installer\" (rs/parked-installer) nil]\n                                 [\"a parked reader under a header\" (rs/parked-reader) (rs/header 0 nil #{})]\n                                 [\"a halted root under a header\" (rs/halted-machine) (rs/header 0 rs/origin #{})]]]\n    (testing label\n      (let [{:keys [frozen record prepared]} (frozen-of source header)\n            {:keys [attaches calls attach]} (counting-attach)\n            restored (rehydrate frozen (rs/new-machine) attach)]\n        (is (= :ok (:status frozen)) (pr-str frozen))\n        (is (= :ok (:status restored)) (pr-str restored))\n        (is (= :exporting (vm/gate-mode (:machine restored))))\n        (is (empty? (:wait-set (:machine restored))))\n        (is (empty? (:parked (:machine restored))))\n        (is (= (count (:wait-set record)) (count (get-in restored [:record :wait-set]))))\n        (is (= (set (keys (:parked record))) (set (keys (get-in restored [:record :parked])))))\n        (is (nil? (get-in restored [:machine :yin.k/custody])) \"no custody is restored\")\n        (is (zero? @calls) \"no read, write, mint or close\")\n        (is (= (count (into #{} (map :dao.stream/identity) (vals (get-in prepared [:record :served]))))\n               @attaches)\n            \"every stream attached, once\")\n        (is (reproduces? frozen restored) \"the published pack, byte for byte\")))))\n\n\n(deftest a-restarted-abort-is-refused-test\n  (let [{:keys [frozen]} (frozen-of (rs/parked-reader))\n        restored (rehydrate frozen)]\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (true? (get-in restored [:record :recovered?])))\n    (is (= [:yin.k/refused :restarted]\n           ((juxt :yin.k/status :yin.k/reason)\n            (export/abort (:machine restored) (:record restored) [] nil))))))\n\n\n(deftest recovery-restores-fresh-name-state-without-receiver-contamination-test\n  (let [source (assoc (rs/parked-reader) :origins 42 :id-counter 88 :yin.k/issued 77)\n        {:keys [frozen]} (frozen-of source)\n        restored (rehydrate frozen\n                            (assoc (rs/new-machine) :origins 99 :id-counter 100\n                                   :store {'receiver-local :wrong} :yin.k/issued 33\n                                   :yin.k/closes [{:receiver-local true}])\n                            (:attach (counting-attach)))]\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= 42 (:origins (:machine restored))))\n    (is (= 88 (:id-counter (:machine restored))) \"the carried counter exactly, never max(local, carried)\")\n    (is (= 77 (:yin.k/issued (:machine restored))))\n    (is (not (contains? (:store (:machine restored)) 'receiver-local)))\n    (is (empty? (:yin.k/closes (:machine restored))))\n    (is (reproduces? frozen restored))))\n\n\n(deftest the-id-counter-is-carried-exactly-test\n  (testing \"a receiver whose counter is below the carried one\"\n    (let [source (assoc (rs/parked-reader) :id-counter 500)\n          {:keys [frozen]} (frozen-of source)\n          restored (rehydrate frozen (assoc (rs/new-machine) :id-counter 3) (:attach (counting-attach)))]\n      (is (= 500 (get-in restored [:machine :id-counter])))\n      (is (reproduces? frozen restored)))))\n\n\n(deftest recovery-validation-precedes-attachment-test\n  (let [{:keys [frozen]} (frozen-of (rs/parked-reader))\n        recovery (cbor/decode (:bytes frozen))\n        other (cbor/decode (:bytes (:frozen (frozen-of (rs/parked-explicit)))))\n        pack (cbor/decode (:pack-bytes frozen))\n        reordered (cbor/encode (update pack :yin.k/rows (comp vec reverse)))\n        {:keys [attaches attach]} (counting-attach)]\n    (doseq [[label invalid status]\n            [[\"version 1\" (assoc recovery :yin.k/version 1) :yin.k/profile-mismatch]\n             [\"no tag\" (dissoc recovery :yin.k/export-recovery) :yin.k/profile-mismatch]\n             [\"a header the root does not carry\" (assoc recovery :yin.k/header (rs/header 0 nil #{})) :yin.k/undecodable]\n             [\"a malformed header\" (assoc recovery :yin.k/header {:yin.k/enrolled #{}}) :yin.k/undecodable]\n             [\"issues of another wait count\" (assoc-in recovery [:yin.k/state :issues] []) :yin.k/undecodable]\n             [\"children the tree does not carry\" (assoc-in recovery [:yin.k/state :children] {'x {}}) :yin.k/undecodable]\n             [\"another root id\" (assoc recovery :yin.k/root (:yin.k/root other)) :yin.k/undecodable]\n             [\"another recovery's pack\" (merge recovery (select-keys other [:yin.k/pack-bytes :yin.k/pack-address :yin.k/root]))\n              :yin.k/undecodable]\n             [\"a pack that is not its address\" (assoc recovery :yin.k/pack-address (:yin.k/pack-address other))\n              :yin.k/hash-mismatch]\n             [\"the same root in another row order\"\n              (assoc recovery :yin.k/pack-bytes (jing/bytes->base64 reordered)\n                     :yin.k/pack-address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 reordered))))\n              nil]]]\n      (testing label\n        (let [bytes (cbor/encode invalid)\n              address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))\n              before @attaches\n              restored (export/rehydrate-fenced (rs/new-machine) bytes {:address address :attach attach})]\n          (is (not= :ok (:status restored)) (pr-str restored))\n          (is (nil? (:machine restored)))\n          (when (some? status) (is (= status (:yin.k/status restored)) (pr-str restored)))\n          (when (some? status) (is (= before @attaches) \"refused before any attachment\")))))\n    (testing \"the recovery's own address is checked\"\n      (is (= :yin.k/hash-mismatch\n             (:yin.k/status (export/rehydrate-fenced (rs/new-machine) (:bytes frozen)\n                                                     {:address (:pack-address frozen) :attach attach})))))\n    (testing \"a pack in another row order is not the published pack: recovery is inconsistent\"\n      (let [invalid (assoc recovery :yin.k/pack-bytes (jing/bytes->base64 reordered)\n                           :yin.k/pack-address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 reordered))))\n            bytes (cbor/encode invalid)\n            restored (export/rehydrate-fenced (rs/new-machine) bytes\n                                              {:address (keyword \"segment\" (str \"blake3-\" (jing/digest-bytes :blake3 bytes)))\n                                               :attach attach})]\n        (is (= [:yin.k/undecodable :recovery-inconsistent]\n               ((juxt :yin.k/status :yin.k/reason) restored)))))))\n\n\n(deftest recovery-preserves-aliases-distinct-cells-and-authentic-closures-test\n  (let [source (vm/run\n                 (rs/load-ast (rs/new-machine)\n                              (rs/let1 's {:type :stream/make :buffer 4}\n                                       (rs/let1 'c (rs/cursor-of (rs/v 's))\n                                                (rs/let1 'd (rs/cursor-of (rs/v 's))\n                                                         (rs/then (rs/def! 'first-c (rs/v 'c))\n                                                                  (rs/then (rs/def! 'alias-c (rs/v 'c))\n                                                                           (rs/then (rs/def! 'distinct-c (rs/v 'd))\n                                                                                    (rs/then (rs/def! 'closure (rs/lam [] (rs/next-of (rs/v 'c))))\n                                                                                             (rs/next-of (rs/v 'c)))))))))))\n        {:keys [frozen]} (frozen-of source)\n        {:keys [attaches calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine {:origin :fresh :capability-secret \"recovery-secret\"}) attach)\n        machine' (:machine restored)\n        store (:store machine')\n        closure (get store 'closure)\n        cell-ids (:yin.k/recovery-cell-ids machine')]\n    (is (= :ok (:status frozen)))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= 1 @attaches) \"one stream, one attachment\")\n    (is (zero? @calls) \"no read, mint, append or close during reconstruction\")\n    (is (= (get store 'first-c) (get store 'alias-c)) \"an alias stays one cursor cell\")\n    (is (not= (get store 'first-c) (get store 'distinct-c)) \"two cursor cells stay two\")\n    (is (= 2 (count (set (vals cell-ids)))))\n    (is (not= (get cell-ids (:id (get store 'first-c))) (get cell-ids (:id (get store 'distinct-c)))))\n    (is (engine/authentic-ref? machine' :cursor-ref (get store 'first-c)))\n    (is (values/closure? closure))\n    (is (values/owned-by? closure (:owner machine')))\n    (is (not (values/owned-by? closure (:owner source))))\n    (is (reproduces? frozen restored))))\n\n\n(deftest a-halted-closure-result-is-a-recovery-root-test\n  (let [source (vm/run (rs/load-ast (rs/new-machine) (rs/lam [] (rs/lit 42))))\n        {:keys [frozen]} (frozen-of source (rs/header 0 rs/origin #{}))\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine {:origin :fresh :capability-secret \"fresh-secret\"}) attach)]\n    (is (values/closure? (:value source)))\n    (is (= :ok (:status frozen)) (pr-str frozen))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (values/closure? (:value (:machine restored))))\n    (is (= :exporting (vm/gate-mode (:machine restored))))\n    (is (zero? @calls))\n    (is (reproduces? frozen restored))))\n\n\n(deftest module-store-cursors-travel-in-the-one-pack-test\n  (let [source (rs/parked-module-store-cursors)\n        {:keys [frozen]} (frozen-of source)\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine) attach)]\n    (is (= :ok (:status frozen)) (pr-str frozen))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= #{'c 'd} (set (keys (get-in restored [:machine :module-stores 'host.mod])))))\n    (is (zero? @calls))\n    (is (reproduces? frozen restored))))\n\n\n(deftest closure-in-blocked-environment-survives-fenced-recovery-test\n  (let [source (vm/run (rs/load-ast (rs/new-machine)\n                                    (rs/let1 'f (rs/lam [] (rs/lit 42))\n                                             (rs/let1 'input {:type :stream/make :buffer 4}\n                                                      (rs/then (rs/next-of (rs/cursor-of (rs/v 'input)))\n                                                               (rs/app (rs/v 'f)))))))\n        source-closure (get-in source [:wait-set 0 :env 'f])\n        {:keys [frozen]} (frozen-of source)\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine {:origin :fresh :capability-secret \"fresh-secret\"}) attach)\n        closure (get-in restored [:record :wait-set 0 :env 'f])]\n    (is (values/closure? source-closure) (pr-str (:wait-set source)))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (values/closure? closure))\n    (is (values/owned-by? closure (:owner (:machine restored))))\n    (is (not (values/owned-by? closure (:owner source))))\n    (is (zero? @calls))\n    (is (= :exporting (vm/gate-mode (:machine restored))))\n    (is (empty? (:wait-set (:machine restored))))\n    (is (reproduces? frozen restored))))\n\n\n(deftest exclusive-recovery-retains-operation-ids-issues-and-local-enrollment-test\n  (let [op-id (rs/op-id 0)\n        source (-> (rs/parked-writer)\n                   (assoc :yin.k/issued 10)\n                   (assoc-in [:wait-set 0 :yin.k/issue] 9)\n                   (rs/with-op-id :put op-id))\n        header (rs/header 1 rs/origin #{\"s0\"})\n        {:keys [frozen prepared]} (frozen-of source header)\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine) attach)\n        recovery (cbor/decode (:bytes frozen))]\n    (is (= :ok (:status prepared)) (pr-str prepared))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= op-id (get-in restored [:record :wait-set 0 :op-id])))\n    (is (= 9 (get-in restored [:record :wait-set 0 :yin.k/issue])) \"the recovered stamp, not the lower's numbering\")\n    (is (= 10 (get-in restored [:machine :yin.k/issued])))\n    (is (= #{\"s0\"} (get-in restored [:record :header :yin.k/enrolled])) \"the enrolled set stays local\")\n    (is (= #{\"s0\"} (get-in recovery [:yin.k/header :yin.k/enrolled])))\n    (is (not (some #(= :yin.k/enrolled %) (tree-seq coll? seq (cbor/decode (:pack-bytes frozen)))))\n        \"and never enters the pack\")\n    (is (nil? (get-in restored [:machine :yin.k/custody])))\n    (is (zero? @calls))\n    (is (reproduces? frozen restored))))\n\n\n(deftest rehydrating-an-install-child-does-not-repeat-initialization-or-io-test\n  (let [initializations (atom 0)\n        counting-make (fn [capacity]\n                        (swap! initializations inc)\n                        (ringbuffer/create! {:dao.stream/type ringbuffer/transport-type\n                                             ringbuffer/capacity-key capacity}))\n        request (ring 64)\n        response (ring 64)\n        blocked (vm/run (rs/load-ast (rs/new-machine {:make-stream counting-make\n                                                      :link-request request :link-response response})\n                                     (rs/then (rs/app (rs/v 'require) (rs/lit 'host.mod))\n                                              (rs/app (rs/v 'host.mod/f)))))\n        _ (stream/append! response (assoc (rs/module-response)\n                                          :yin.link/id (:link-id (first (:wait-set blocked)))))\n        source (vm/run blocked)\n        receiver (rs/new-machine {:make-stream counting-make})\n        carried @initializations\n        {:keys [frozen]} (frozen-of source)\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen receiver attach)]\n    (is (pos? carried))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= carried @initializations) \"the child's initialization is not repeated\")\n    (is (zero? @calls))\n    (is (= :exporting (vm/gate-mode (get-in restored [:machine :installs 'host.mod :vm]))))\n    (is (empty? (get-in restored [:machine :installs 'host.mod :vm :wait-set])))\n    (is (= 1 (count (get-in restored [:record :children 'host.mod :wait-set]))))\n    (is (reproduces? frozen restored))))\n\n\n(deftest recovery-retains-a-blocked-ffi-request-and-its-response-route-test\n  (let [inbound (reify\n                  stream/IDaoStreamDescriptor\n                  (descriptor [_] {:dao.stream/outcome :dao.stream/ok :dao.stream/identity \"full-in\"})\n\n\n                  stream/IDaoStreamWriter\n\n                  (append! [_ _] {:dao.stream/outcome :dao.stream/full}))\n        outbound (ring 8)\n        source (vm/run (rs/load-ast\n                         (rs/new-machine {:call-in inbound :call-out outbound\n                                          :call-out-cursor (vm/mint-oldest outbound :test)})\n                         {:type :dao.stream.apply/call :op :op/echo :operands [(rs/lit \"hello\")]}))\n        _ (is (true? (:request-sent (first (:wait-set source)))) (pr-str (:wait-set source)))\n        {:keys [frozen record]} (frozen-of source)\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine) attach)]\n    (is (= :ok (:status frozen)) (pr-str frozen))\n    (is (= :ok (:status restored)) (pr-str restored))\n    (is (= (get-in record [:wait-set 0 :call-id])\n           (get-in restored [:record :wait-set 0 :call-id])))\n    (is (= (get-in record [:wait-set 0 :datom])\n           (get-in restored [:record :wait-set 0 :datom])))\n    (is (zero? @calls))\n    (is (reproduces? frozen restored))))\n\n\n;; =============================================================================\n;; Abort\n;; =============================================================================\n\n(defn- exporting\n  [machine]\n  (let [r (export/enter machine)]\n    [(:machine r) (:record r) machine]))\n\n\n(deftest abort-with-no-persisted-intent-restores-the-machine-test\n  (let [[m record original] (exporting (parked-machine))\n        r (export/abort m record [] nil)]\n    (is (= :ok (:status r)))\n    (is (= original (:machine r)) \"the old local machine, as it was\")))\n\n\n(deftest abort-restores-the-prior-gate-test\n  (let [[s sref _ _] (gated)\n        s (run-effect s :stream/put {:stream sref, :val 1})\n        [m record _] (exporting s)]\n    (is (= s (:machine (export/abort m record [] nil))))))\n\n\n(deftest abort-after-provably-not-appended-attempts-test\n  (let [[m record original] (exporting (parked-machine))]\n    (doseq [outcome [:dao.stream/full :dao.stream/invalid-value\n                     :dao.stream/closed :dao.stream/refused]]\n      (is (= original\n             (:machine (export/abort m record\n                                     [{:append outcome} {:append outcome}]\n                                     nil)))\n          (str outcome \" proves nothing was appended\")))))\n\n\n(deftest abort-is-refused-when-the-offer-may-have-been-accepted-test\n  (let [[m record _] (exporting (parked-machine))\n        refused? (fn [attempts]\n                   (let [r (export/abort m record attempts nil)]\n                     (and (= :yin.k/refused (:yin.k/status r))\n                          (= :offer-possibly-accepted (:yin.k/reason r)))))]\n    (testing \"an unknown append (intent persisted, no outcome)\"\n      (is (refused? [{}])))\n    (testing \"an unknown append among provable ones\"\n      (is (refused? [{:append :dao.stream/full} {}])))\n    (testing \"an accepted append\"\n      (is (refused? [{:append :dao.stream/ok}])))\n    (testing \"a transport error is unknown delivery\"\n      (is (refused? [{:append :dao.stream/transport-error}])))\n    (testing \"a refusal that followed an unknown append is no evidence\"\n      (is (refused? [{} {:append :dao.stream/full\n                         :reply :yin.k/refused}])))\n    (testing \"a refusal of one request is no evidence of the others\"\n      (is (refused? [{:append :dao.stream/ok :reply :yin.k/refused}])))\n    (testing \"the machine stays fenced\"\n      (is (= :exporting (vm/gate-mode m))))))\n\n\n(deftest a-holder-past-its-lease-bound-cannot-abort-test\n  (let [[s sref _ _] (gated)\n        s (-> (run-effect s :stream/put {:stream sref, :val 1})\n              (assoc :yin.k/custody {:yin.k/occurrence \"o\"}))\n        [m record original] (exporting s)\n        abort (fn [tenure] (export/abort m record [] tenure))\n        reason (fn [r] [(:yin.k/status r) (:yin.k/reason r)])]\n    (testing \"current, ledger-confirmed tenure may abort\"\n      (is (= original (:machine (abort {:now 10 :bound 20 :live true})))))\n    (testing \"at the bound and past it, never\"\n      (doseq [t [{:now 20 :bound 20 :live true}\n                 {:now 21 :bound 20 :live true}\n                 {:now 21 :bound 20}]]\n        (is (= [:yin.k/refused :tenure-ended] (reason (abort t))))))\n    (testing \"inside the bound with no ledger evidence is unconfirmed\"\n      (doseq [t [{:now 10 :bound 20} {:now 10 :bound 20 :live false} nil]]\n        (is (= [:yin.k/refused :tenure-unconfirmed] (reason (abort t))))))\n    (testing \"tenure alone does not license an uncertain offer\"\n      (is (= :offer-possibly-accepted\n             (:yin.k/reason (export/abort m record [{}]\n                                          {:now 10 :bound 20 :live true})))))))\n\n\n(deftest abort-needs-an-exporting-machine-test\n  (let [[m record _] (exporting (parked-machine))\n        restored (:machine (export/abort m record [] nil))]\n    (is (= :yin.k/refused\n           (:yin.k/status (export/abort restored record [] nil))))))\n\n\n;; Holder preparation checks moved from the old-codec lift suite.\n\n(defn- same-bytes?\n  [a b]\n  (= (vec a) (vec b)))\n\n\n(defn- prepare\n  [m record serve! header]\n  (export/prepare m record serve! header (index)))\n\n\n(defn- prepared\n  [m header]\n  (let [e (export/enter m)]\n    {:machine (:machine e)\n     :prepared (prepare (:machine e) (:record e) (rs/serve-table) header)}))\n\n\n(deftest a-malformed-header-is-a-caller-defect-test\n  (let [{m :machine record :record} (export/enter (rs/parked-reader))]\n    (doseq [h [:x {} (dissoc (rs/header 0) :yin.k/arbitration)\n               (dissoc (rs/header 0) :yin.k/next-op-seq)\n               (dissoc (rs/header 0) :yin.k/enrolled)]]\n      (is (throws? #(prepare m record (rs/serve-table) h))\n          (pr-str h)))))\n\n\n(deftest two-encodes-of-one-prepared-record-give-equal-bytes-test\n  (doseq [[n machine h] [[\"reader\" (rs/parked-reader) (rs/header 0 nil #{})]\n                         [\"installer\" (rs/parked-installer) (rs/header 6)]\n                         [\"explicit\" (rs/parked-explicit) (rs/header 1)]\n                         [\"fork\" (rs/parked-reader) nil]]]\n    (let [{m :machine p :prepared} (prepared machine h)\n          record (:record p)\n          a (export/encode m record)\n          b (export/encode m record)]\n      (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n      (is (same-bytes? (:bytes a) (:bytes b)) n)\n      (is (= (:address a) (:address b)) n))))\n\n\n(deftest the-served-table-is-plain-data-keyed-by-path-and-resource-test\n  (let [{p :prepared} (prepared (rs/parked-installer) (rs/header 6))\n        served (:served (:record p))]\n    (is (seq served))\n    (is (every? (fn [[[path id] descriptor]]\n                  (and (vector? path) (some? id)\n                       (string? (:dao.stream/identity descriptor))))\n                served))\n    (is (some (fn [[[path _] _]] (= ['host.mod] path)) served)\n        \"the child's streams are keyed by its path\"))\n  (testing \"one handle under two resource ids: served once, keyed twice\"\n    (let [calls (atom 0)\n          serve! (fn [_]\n                   (swap! calls inc) {:dao.stream/identity \"s0\"\n                                      :dao.stream/channel\n                                      {:dao.stream/type\n                                       :dao.stream.test/channel}})\n          {m :machine record :record} (export/enter (rs/parked-writer-shared))\n          p (prepare m record serve! (rs/header 3 rs/origin #{}))\n          e (export/encode m (:record p))]\n      (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n      (is (= 1 @calls) \"the one handle asked once\")\n      (is (= 2 (count (:served (:record p)))) \"both resource keys retained\")\n      (is (= :ok (:status e)) (pr-str e))\n      (is (throws? #(export/encode\n                      m (update (:record p) :served\n                                dissoc (ffirst (:served (:record p))))))\n          \"a key the record lacks is still a defect\"))))\n\n\n(deftest a-retry-serves-no-already-served-handle-test\n  (let [served {:dao.stream/identity \"s0\"\n                :dao.stream/channel {:dao.stream/type\n                                     :dao.stream.test/channel}}\n        seen (atom #{})\n        ;; answers the first distinct handle it is asked about, and that\n        ;; one whenever it is asked again; every other handle gets no\n        ;; answer, so the prepare refuses once the walk reaches the\n        ;; independent third stream, after the shared handle's aliases\n        first-only (fn [h]\n                     (when (or (contains? @seen h) (empty? @seen))\n                       (swap! seen conj h)\n                       served))\n        {m :machine record :record} (export/enter\n                                      (rs/parked-writer-shared-late))\n        refused (prepare m record first-only (rs/header 3 rs/origin #{}))]\n    (is (= :yin.k/unsatisfied (:yin.k/status refused)) (pr-str refused))\n    (is (= 1 (count @seen)) \"exactly one handle ever answered\")\n    (is (every? #(= served %) (vals (:served (:record refused))))\n        \"what was served is retained\")\n    (testing \"the retry resolves the shared handle's every alias from the\n              retained table and the machine's bindings: the handle is\n              not served again\"\n      (let [calls (atom 0)\n            table (atom {})\n            counting (fn [h]\n                       (swap! calls inc)\n                       (if-some [d (get @table h)]\n                         d\n                         (let [d {:dao.stream/identity\n                                  (str \"s\" (count @table))}]\n                           (swap! table assoc h d)\n                           d)))\n            p (prepare m (:record refused) counting\n                       (rs/header 3 rs/origin #{}))\n            e (export/encode m (:record p))]\n        (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n        (is (= 1 @calls) \"only the never-served third stream is asked\")\n        (is (= 3 (count (:served (:record p)))) \"every resource key\")\n        (is (= 2 (count (distinct (vals (:served (:record p))))))\n            \"one identity for the shared handle's two keys\")\n        (is (= :ok (:status e)) (pr-str e))\n        (is (= 1 (count @seen)) \"the first attempt served once\")))\n    (testing \"a retry over a machine whose bindings moved -- a fresh\n              resource alias of the served handle reached first\"\n      (let [[path id :as retained] (first (keys (:served (:record refused))))\n            h (get-in m (into path [:resources id]))\n            _ (is (some? retained) \"one key is retained\")\n            _ (is (some? h) \"the retained key resolves to its handle\")\n            [alias m2] (engine/attach-resource m h)\n            ;; prepare reads the record's waits, so the fresh alias rides\n            ;; the record's first wait entry's environment\n            record' (assoc-in (:record refused) [:wait-set 0 :env 'again]\n                              alias)\n            calls (atom 0)\n            counting (fn [_] (swap! calls inc) served)\n            p (prepare m2 record' counting (rs/header 3 rs/origin #{}))]\n        (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n        (is (= 1 @calls) \"only the never-served third stream is asked\")\n        (is (= 4 (count (:served (:record p))))\n            \"the fresh alias, the retained alias, the pending's and the\n             third stream's\")\n        (is (= :ok (:status (export/encode m2 (:record p))))\n            \"the record encodes with no serving\")))))\n\n\n(deftest the-record-round-trips-the-canonical-codec-test\n  (let [{m :machine p :prepared} (prepared (rs/parked-explicit) (rs/header 1))\n        record (:record p)\n        back (cbor/decode (cbor/encode record))]\n    (is (= :ok (:status p)) (pr-str (dissoc p :record)))\n    (is (same-bytes? (cbor/encode record) (cbor/encode back)))\n    (is (same-bytes? (:bytes (export/encode m record))\n                     (:bytes (export/encode m back)))\n        \"the stored record encodes to the same bytes\")))\n\n\n(deftest recovery-retains-every-parked-record-test\n  (let [source (rs/parked-explicit)\n        [active saved] (first (:parked source))\n        extra :unreachable-park\n        source (assoc-in source [:parked extra] (assoc saved :id extra))\n        {:keys [frozen]} (frozen-of source)\n        {:keys [calls attach]} (counting-attach)\n        restored (rehydrate frozen (rs/new-machine) attach)]\n    (is (= :ok (:status frozen)))\n    (is (= :ok (:status restored)))\n    (is (= #{active extra} (set (keys (get-in restored [:record :parked])))))\n    (is (empty? (get-in restored [:machine :parked])))\n    (is (zero? @calls))\n    (is (reproduces? frozen restored))))\n","numLines":981,"startLine":1,"totalLines":981}},"tool_result_meta":[{"id":"toolu_01BrAKJNYneQBe6gtKGB8wsN","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
