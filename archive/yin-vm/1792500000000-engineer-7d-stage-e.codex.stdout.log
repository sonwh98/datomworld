{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'source-index|check-holder' src/cljc/yin/vm/ucf/compose.cljc; sed -n '714,738p' test/yin/vm/ucf/compose_test.cljc; cat collab/7a-report.md collab/1792480000000-engineer-7c-compose-fencing.report.md > /tmp/7d-prior-reports.txt; wc -l /tmp/7d-prior-reports.txt; cat test/yin/vm/ucf/stage_e_peer.cljc\"","aggregated_output":"188:  (check! (fn? (:source-index config))\n425:           clock units source-index inbound-capacity journals]}]\n435:   :source-index source-index\n525:     :source-index     (fn [] {A #{tree-address}}), the composition's\n670:   :units, :source-index, :enroll!, :journals -- is a composition seam,\n676:(defn- check-holder-config-keys!\n697:          :source-index (:source-index c)\n748:  (check-holder-config-keys! h config)\n        \"the substrate's suppliers are (fn [holder] backend)\")\n    (testing \"an exclusive composition requires the substrate: nil, empty, partial and undeclared each refuse at open\"\n      (let [refused {:yin.k/status :yin.k/unsatisfied\n                     :yin.k/reason :journals-uncapable\n                     :yin.k/policy :yin.k/exclusive}\n            refuse (fn [journals]\n                     (select-keys (exclusive! journals)\n                                  [:yin.k/status :yin.k/reason :yin.k/policy]))]\n        (is (= refused (refuse nil))\n            \"nil -- the fork default -- never silently mints the exclusive\n             composition's memory journals\")\n        (is (= refused (refuse {}))\n            \"an empty substrate supplies no supplier at all\")\n        (is (= refused (refuse {:progress-backend! memory}))\n            \"a partial substrate would journal the replies to fresh memory\n             the substrate never supplied\")\n        (is (= refused (refuse {:reply-backend! memory})))\n        (is (= refused (refuse {:progress-backend! memory\n                                :reply-backend! memory}))\n            \"a substrate that declares nothing cannot be validated against\n             the failure model\")\n        (is (nil? (::compose/composition\n                    (exclusive! {:progress-backend! memory\n                                 :reply-backend! memory})))\n            \"nothing is composed and no holder was activated\")))\n     227 /tmp/7d-prior-reports.txt\n(ns yin.vm.ucf.stage-e-peer\n  \"M-next stage E's peer: one life of a crash/partition scenario\n   (yin.vm.ucf.stage-e-world) run as its own operating-system process,\n   the process transport of linker-dht 14.1.3 for the JVM and Node.\n\n   The parent (yin.vm.ucf.stage-e-process-test) writes the life's spec\n   as EDN to a file and starts this program with that path.  Every event\n   the life emits is printed at once as one line, `E|` followed by the\n   event as EDN; the life's report arrives as {:event :done}.  When the\n   life's cut fires the peer prints {:event :cut} and blocks forever:\n   the parent destroys the process there (SIGKILL), so nothing the life\n   did after its cut ever happens and nothing it did before is undone --\n   the durable media hold exactly what a killed process leaves.\n\n   JVM: `java -cp <classpath> clojure.main -m yin.vm.ucf.stage-e-peer\n   spec.edn`.  Node: the shadow-cljs :node-script build of `main`, which\n   the parent compiles before its first Node life.\"\n  (:require #?@(:cljd []\n                :clj [[clojure.edn :as edn]]\n                :cljs [[cljs.reader :as reader]])\n            [yin.vm.ucf.stage-e-world :as world]))\n\n\n(defn- read-spec\n  [text]\n  #?(:cljd nil\n     :clj (edn/read-string text)\n     :cljs (reader/read-string text)))\n\n\n(defn- slurp-file\n  [path]\n  #?(:cljd nil\n     :clj (slurp path)\n     :cljs (.toString (.readFileSync (js/require \"fs\") path) \"utf8\")))\n\n\n(defn- write-line!\n  [line]\n  #?(:cljd nil\n     :clj (locking *out*\n            (.write *out* (str line \"\\n\"))\n            (.flush *out*))\n     ;; synchronous: a pipe write on Node may otherwise still be queued\n     ;; when the peer blocks at its cut\n     :cljs (.writeSync (js/require \"fs\") 1 (str line \"\\n\"))))\n\n\n(defn- block-forever!\n  \"Never return: the parent kills the process here.\"\n  []\n  #?(:cljd nil\n     :clj @(promise)\n     :cljs (loop []\n             (recur))))\n\n\n(defn- emit!\n  [event]\n  (write-line! (str \"E|\" (binding [*print-namespace-maps* false\n                                   *print-length* nil\n                                   *print-level* nil]\n                           (pr-str (world/->data event))))))\n\n\n(defn- host\n  []\n  #?(:cljd :dart :clj :jvm :cljs :node))\n\n\n(defn- pid\n  []\n  #?(:cljd nil\n     :clj (.pid (java.lang.ProcessHandle/current))\n     :cljs (.-pid js/process)))\n\n\n(defn run-spec!\n  \"Run the life whose spec is EDN `text`, printing its events.\"\n  [text]\n  (let [spec (read-spec text)\n        ctx (world/context {:cut (:cut spec)\n                            :fail (:fail spec)\n                            :emit! emit!\n                            :at-cut block-forever!})]\n    (emit! {:event :started :host (host) :pid (pid) :cut (:cut spec)})\n    (try\n      (let [report (if (:inspect spec)\n                     (world/inspect spec)\n                     (world/run-life ctx spec))]\n        (emit! {:event :done :report report}))\n      (catch #?(:cljd Object :clj Throwable :cljs :default) e\n        (if (world/killed? e)\n          (block-forever!)\n          (emit! {:event :error\n                  :message #?(:cljd (str e) :clj (ex-message e) :cljs (ex-message e))\n                  :data (world/->data (ex-data e))}))))))\n\n\n#?(:cljd nil\n   :clj\n   (defn -main\n     [path]\n     (run-spec! (slurp-file path))\n     (shutdown-agents)\n     (System/exit 0)))\n\n\n#?(:cljd nil\n   :cljs\n   (defn main\n     [path]\n     (run-spec! (slurp-file path))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='test/yin/vm/ucf/stage_e_world.cljc'\ns=open(p).read().replace('[yin.vm.ucf.lift-support :as s]', '[yin.vm.ucf.rows-support :as s]\\\\n            [yin.vm.ucf.rows :as rows]\\\\n            [yin.vm.ucf.rows.checkpoint :as checkpoint]')\ns=s.replace(':mode mode\\\\n           :renewal', ':mode mode\\\\n           :source-index (fn [] @s/source-index)\\\\n           :renewal')\ns=s.replace('A second encoding of the occurrence holder \"'`h` fenced: the same body'\"\\\\n   in different canonical bytes (another id counter), put in the store', 'A second encoding of the occurrence holder \"'`h` fenced: the same root'\"\\\\n   with reversed rows in different canonical bytes, put in the store')\ns=s.replace('o (get-in body [:yin.k/custody :yin.k/occurrence])\\\\n        v-bytes (cbor/encode (assoc body :yin.k/id-counter 9))', 'o (:yin.k/occurrence (checkpoint/inspect address bytes))\\\\n        v-bytes (cbor/encode (update body :yin.k/rows #(vec (reverse %))))')\ns=s.replace('v-address (keyword \\\"segment\\\" (str \\\"blake3-\\\" (jing/digest-bytes :blake3 v-bytes)))','v-address (rows/pack-address v-bytes)')\n# snapshot packs: verify re-emission bytes against original canonical sorted pack\ns=s.replace('[a (when bs (digest-of bs))]', '[a (when bs (digest-of bs))]')\nopen(p,'w').write(s)\np='test/yin/vm/ucf/handoff_v2_authority_test.cljc';s=open(p).read().replace('covered by rows-custody-test.', 'covered by authority.grant-test,\\\\n   authority.completion-test and compose-rows-test.');open(p,'w').write(s)\np='test/yin/vm/ucf/compose_test.cljc';s=open(p).read();pos=s.index('(deftest a-journal-substrate-is-checked-at-open-test');s=s[:pos]+'''(deftest a-source-index-is-checked-at-open-test\n  (doseq [mode [:fork :exclusive]\n          index [nil {}]]\n    (let [cfg {:mode mode :source-index index}]\n      (is (thrown-with-msg?\n            #?(:cljd Object :clj Exception :cljs js/Error)\n            #\\\"source index\\\"\n            (compose/open\"'! (if (nil? index) (dissoc cfg :source-index) cfg)))))))\n\n\n'\"'''+s[pos:];open(p,'w').write(s)\nPY\nclojure -M:test -e :slow -n yin.vm.ucf.stage-e-rows-test -n yin.vm.ucf.compose-test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '170,192p' src/cljc/yin/vm/ucf/compose.cljc; rg -n 'defn inspect|defn emit|defn decode' src/cljc/yin/vm/ucf/rows/checkpoint.cljc src/cljc/yin/vm/ucf/rows.cljc; cat /tmp/7d-prior-reports.txt\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '170,192p' src/cljc/yin/vm/ucf/compose.cljc; rg -n 'defn inspect|defn emit|defn decode' src/cljc/yin/vm/ucf/rows/checkpoint.cljc src/cljc/yin/vm/ucf/rows.cljc; cat /tmp/7d-prior-reports.txt\"","aggregated_output":"              (not (journal-substrate-capable? durability failure-model)))\n      {:yin.k/status :yin.k/unsatisfied\n       :yin.k/reason :journals-uncapable\n       :yin.k/policy :yin.k/exclusive\n       :yin.k/failure-model failure-model\n       :dao.stream.journal/durability durability})))\n\n\n(defn- check-common!\n  [config]\n  (check-interval! (:units config) (:renewal-interval config))\n  (check! (and (map? (:store config))\n               (fn? (:put-bytes-fn (:store config)))\n               (fn? (:get-bytes-fn (:store config))))\n          \"a content store: a dao.jing byte-store handle\" {})\n  (check! (some? (:diagnostics config)) \"a diagnostic stream: a writer\" {})\n  (check! (some? (:medium config)) \"a carrier medium name\" {})\n  (check! (fn? (:clock config)) \"a lease clock: (fn [] reading)\" {})\n  (check! (fn? (:source-index config))\n          \"a source index: (fn [] {A #{tree-address}})\" {}))\n\n\n(defn- log-handle\nsrc/cljc/yin/vm/ucf/rows/checkpoint.cljc:70:(defn inspect-pack\nsrc/cljc/yin/vm/ucf/rows/checkpoint.cljc:83:(defn inspect\nsrc/cljc/yin/vm/ucf/rows.cljc:722:(defn emit-numbered\nsrc/cljc/yin/vm/ucf/rows.cljc:733:(defn emit\nsrc/cljc/yin/vm/ucf/rows.cljc:961:(defn decode\nCreated-Local: 2026-10-13 +07\n# Slice 7a report: custody on rows, the rows inspector, the authority's fixtures (opus, engineer)\n\nWorktree `srvm-phase7a`, from `23a8caef`. Nothing committed. JVM only, all runs in the foreground (one quick-tier run of every `yin.vm.ucf.*` namespace went past the 10-minute foreground limit, finished in the background and was read from its log).\n\n## Verdict\n\n7a is done as the plan's slice section and §3.1, §3.3 and §3.4 describe it, and its own acceptance holds: the two new suites, the ledger fixture, crash cuts, the eight authority tests and the holder tests that use fixtures all pass. `rows_test` and the safepoint harness pass with **no root id moved**.\n\n**7a cannot land alone (design defect D1 below).** The plan's switch of the authority to the rows inspector makes the authority refuse every version-1/2 body. 141 deftests in six old-codec D/E suites now fail. Those suites are re-based in 7b/7c, and I proved the switch is the only cause. I did not work around it, because a fix would change semantics; the decision belongs to the orchestrator.\n\n## Verification\n\n- Lint: `clojure -M:kondo` needed approval in this session, so I used `clj -M:kondo --lint <files>`. Final run over all 22 changed `.clj[c]` files: 0 errors, 0 warnings.\n- Quick tier, new and touched namespaces plus `rows_test`, the harness, `layout_test`, the old `checkpoint_test` and `lift_v1_test` (20 namespaces): **360 tests, 7188 assertions, 0 failures, 0 errors** (`target/7a-final.log`).\n  - `rows_checkpoint_test`: 17 deftests.\n  - `rows_custody_test`: 11 deftests, 107 assertions before the M3 fix added two more.\n- Slow tier (`-i :slow`) on the same namespaces plus `rows_test` and the harness: 4 tests, 2724 assertions, 0 failures.\n- Every `yin.vm.ucf.*` namespace, quick tier (`-r 'yin\\.vm\\.ucf\\..*'`, `target/7a-ucf-quick.log`): 694 tests, 648 failures and 89 errors. They are all in six suites (see D1):\n\n  | Namespace | Failing deftests | Failing assertions |\n  |---|---|---|\n  | `holder.driver-test` | 92 | 294 |\n  | `compose-rows-test` | 35 | 335 |\n  | `compose-test` | 6 | 35 |\n  | `stage-e-rows-test` | 4 (the quick ones) | 35 |\n  | `fencing-rows-test` | 3 | 30 |\n  | `handoff-v2-authority-test` | 1 | 8 |\n\n  No other `yin.vm.ucf` namespace fails.\n- Counterfactual check: I pointed the three authority requires back at `yin.vm.ucf.checkpoint` and ran `fencing-rows-test`, `handoff-v2-authority-test` and `compose-test`: 21 tests, 332 assertions, 0 failures. I then restored the files (byte-compare verified).\n- Node and Dart were not run, as instructed. The new code follows the portability rules: no `for`, no private var access, catches with `:cljd` first, start-from-`{}` assoc, no EDN strings. The `version-float` fixture relies on Node keeping a `Float64` carrier and on Dart's `integer?` rejecting a double, both checked in the source (`rows/decode` gates on `code/reg?`), but this is unverified on those hosts.\n\n## Files\n\nCreated:\n\n| File | Lines | What |\n|---|---|---|\n| `src/cljc/yin/vm/ucf/rows/checkpoint.cljc` | 102 | The rows inspector: `inspect address bytes`, `inspect-pack wire`. Address check, canonical CBOR, `rows/decode`, a `:task` root, then `rows/custody-baseline`; adds `:yin.k/root` |\n| `test/yin/vm/ucf/rows_support.cljc` | 238 | Semantic-register machine builders mirroring `lift_support` (it reuses that namespace's AST helpers, one-slot streams, `serve-table`, header parts and `with-op-id`): `new-machine`, `project` with `source-index`, `parked-reader`, `parked-writer`, `parked-explicit`, `parked-linker`, `parked-installer`, `halted-machine`, `halted-with-cursors`, `parked-module-store-cursors`, `lift`, `attacher` (counting), `receiver` |\n| `test/yin/vm/ucf/rows_checkpoint_fixtures.cljc` | 452 | Five bases lifted under a header; 50 mutations (task edits re-emitted, raw pack edits where the defect is the carrier's own); `render`/`read-file`/`fixture`; editing helpers the authority tests use (`base`, `pack-of`, `edit-task`, `edit-custody`, `waits`, `update-put`, `set-op-id`, `update-child`, `enc`) |\n| `test/resources/yin/vm/ucf/rows-checkpoint-v3.txt` | 917 | 55 pins, 3 anchors with full bytes |\n| `test/yin/vm/ucf/rows_checkpoint_test.cljc` | 203 | 17 deftests |\n| `test/yin/vm/ucf/rows_custody_test.cljc` | 275 | 11 deftests |\n| `test/resources/yin/vm/ucf/ledger-v2.txt` | 22 | Replaces `ledger-v1.txt` (deleted with `git rm`, so the deletion is staged) |\n\nChanged:\n\n- `src/cljc/yin/vm/ucf/rows.cljc` (411 lines changed per `git diff --stat`, now 2219 lines):\n  - `pack`: rows sorted by id, used by `emit`, `emit-numbered` and `frame->rows`.\n  - The custody section: `max-exact`, `write-slots`, `custody-baseline`, `pack-address`.\n  - `lift-task :header`: `header-custody` and `protect!`, `:op-seq-exhausted`, and the grammar run before emitting.\n  - `check-custody!` rewritten as the custody stage: grammar, then fork under `:exclusive`, then `accept-grant!` ported verbatim. It runs once after the three per-tree stages and before `attach-streams!`.\n  - `with-custody` in restore: issue numbering, gate, custody state, and the fenced gate.\n- `authority/{grant,completion,admission}.cljc`: the require switched to `yin.vm.ucf.rows.checkpoint` under the same alias, so each call site is unchanged; docstrings updated.\n- Fixture bodies only:\n  - Named in the plan: `ledger_fixtures`, `ledger_fixture_test` (docstring), `grant_test`, `completion_test`, `inherited_test`, `front_test`. `crash_cut_test` needed no edit; it follows `lf/park`.\n  - Also needed (deviation 1): `admission_test`, `input_test`, `reclaim_test`, `holder/evidence_test`, `holder/reader_test`, `holder/writer_test`.\n- `test/yin/vm/semantic_register/safepoint_harness_test.cljc`: one expected value (deviation 2).\n\n## What the code does (for review)\n\n- **Custody slot (root slot 16):**\n  - nil for a fork of any kind (owner Q1).\n  - `{:yin.k/policy :yin.k/exclusive :yin.k/occurrence :yin.k/arbitration :yin.k/next-op-seq}` plus `:yin.k/origin` for blocked or parked exclusive roots.\n  - `{:yin.k/origin}` alone for a halted exclusive root.\n  - nil on every child.\n- **`custody-baseline`** is the version-1 header and op-id grammar of `checkpoint.cljc`, keyed off the slot. On top of that it:\n  - refuses any key outside the five custody keys (`:custody-key`), so lease, epoch and holder cannot enter a body;\n  - refuses a slot that is not a map (`:malformed-custody`);\n  - checks each task's kind and role, that each `:install` pending names an install row, and that every child slot is nil;\n  - refuses any op-id in a fork tree (`:fork-op-id`, closing continuation §11 Q4 for 7a).\n\n  Paths are relative to the root task: `[:custody k]`, `[:frames i :op-id …]`, and `[:installs <name> …]` inside children. The intent digest is BLAKE3 of the canonical `[:yin.k/append target-identity payload-slot]`, where `[:row n]` becomes `[:row id]`.\n- **The lift** runs the grammar over the abstract task before emitting, the same contract as the version-1 lift running its inspector over its own bytes. It does not decode its own output, which keeps continuation §7.1 step 9 true. A fork lift of a machine that carries op-ids therefore refuses `:fork-op-id`; before 7a the op-ids travelled verbatim.\n- **The lower's custody stage**, in order: grammar; then a fork under `:exclusive` is `:yin.k/profile-mismatch`; a halted exclusive root needs no grant and is gated `:ended`; `:fenced` skips the grant and gates `:exporting`, with waits moved to `:yin.k/recovery-waits`; otherwise `accept-grant!` runs. The grant's `:checkpoint` must equal `rows/pack-address` of the wire, not the root id; a test pins that the root id is refused as `:not-holder`.\n- **Restore:**\n  - `:yin.k/custody` comes from the evidence, with `:yin.k/next-op-seq` equal to the slot's value exactly.\n  - In an exclusive tree every task numbers its `:put` waits (`:yin.k/issue`, `:yin.k/issued`) and is gated `:running`, as `resume-task*` does.\n- **The two identities:**\n  - The pack address is the ledger's `:yin.k/id`, the content-store key, the grant's checkpoint and the report's result.\n  - The root id is the baseline's `:yin.k/root`.\n  - Tested in `the-pack-address-is-storage-and-the-root-id-is-semantic`: address = BLAKE3 of the bytes; root ≠ address; root = the root row's own hash; rows sorted; re-emitting a decoded pack gives the same bytes. Also tested in `a-pack-variant-of-one-root-shares-its-baseline`.\n\n## Mutation checks\n\nDriver: `target/7a-mut/{mut,run}.py`. Each mutant was applied to a backup-guarded copy, run against `rows-custody-test`, `rows-checkpoint-test`, `authority.grant-test` and `ledger-fixture-test`, then restored. Each restore was byte-compared with a clean copy; all were clean.\n\n| # | Mutant | Caught? | By |\n|---|---|---|---|\n| M1 | Custody header by kind swapped (`header-custody` branches) | yes | `the-lift-writes-the-custody-slot-by-kind`, every base (they no longer lift), 46 deftests |\n| M2 | A grant check skipped (holder vs binding) | yes | `every-grant-check-refuses-before-any-attachment` (\"another holder\") |\n| M3 | Protection, one direction dropped (an enrolled stream classed otherwise accepted) | **survived at first**; yes after the fix | The op-id presence check that follows masked it on the successor. I added the isolating case (a reader pack with no retained write) to `protection-is-checked-in-both-directions` |\n| M4 | Counter restore off by one | yes | `the-counter-is-restored-exactly`, `an-exclusive-root-lowers-under-its-grant`, `install-children-lower-…` |\n| M5 | Fork under `:exclusive` accepted | yes | `a-fork-is-refused-under-exclusive` |\n| M6 | Custody stage after attach | yes | The zero-attach assertions in 4 deftests (30 assertions) |\n| M7 | Unsorted `emit` | yes | `the-file-holds-exactly-the-declared-bytes` (anchors), `the-pack-address-…`, the ledger frames, 14 deftests |\n| M8 | Inspector accepting a mutated row (decode's row-hash check off) | yes | `each-mutation-is-refused-as-it-names` (`row-tampered`) |\n| M9 | Baseline root ignored | yes | 11 deftests, including `a-conflicting-variant-is-refused` (`variant-other-root`) and the ledger projection digest |\n| M10 (extra) | The lift skips the grammar | yes | `the-lift-refuses-what-custody-forbids` |\n\n## Deviations\n\n1. **Six more test files rebased.** `authority/{admission,input,reclaim}_test` and `holder/{evidence,reader,writer}_test` offer fixture bodies through `grant/offer!` and break without the switch. Each change is a three-to-five-line `body` helper.\n2. **One harness assertion changed.** `carrier-steps-run-in-order-over-the-tree` expected the phase-6 refusal `[:yin.k/unsupported :custody]` for slot `{:custody :exclusive}`. The plan replaces `check-custody!`, so it now expects `[:yin.k/undecodable :custody-key]`. Nothing else in the harness changed, and no root id moved.\n3. **`:fenced` is minimal.** It skips the grant and protection, gates `:exporting` on every task and moves the waits to `:yin.k/recovery-waits`. `:yin.k/recovery-cell-ids`, the exact id counter, the recovery header check and moving parked records into the record are left to 7b (plan §3.2 costs the fenced mode there).\n4. **Refusal kinds and paths are mine:**\n   - New kinds: `:custody-key`, `:malformed-custody`, `:policy` (the old inspector gave a policy mismatch no kind), `:kind`, `:role`, `:child-header`, `:fork-op-id`, `:incomplete-install`.\n   - Paths: `[:custody …]`, `[:frames i …]`, `[:installs <name> …]`.\n   - Carrier-level refusals keep `rows/decode`'s own: a missing tag is `:yin.k/profile-mismatch :version` on rows, not `:undecodable :body` as on version 1.\n5. **No op-id-on-variant fixture.** It is structurally impossible on rows: the pending table gives `:next` no op-id slot. I added fixtures the old set lacked: `frame-root`, `row-tampered`, `root-role`, `custody-epoch`, `custody-lease`, `custody-not-map`, `fork-op-id`, `variant-other-root`.\n6. **The grammar lives in `rows.cljc`** (`custody-baseline`). `rows.checkpoint` is a thin wrapper around it, because `lower-task` must run the grammar too and `rows.checkpoint` requires `rows` (a cycle otherwise). Behaviour is what plan §3.3 assigns to the inspector.\n7. **Fixture shape.** `rows_checkpoint_fixtures` takes the `refusal` map a mutation must contain, instead of the old `expected` and `place` pair.\n8. **Accessor alias kept.** The authority still calls the inspector through the alias `checkpoint`.\n\n## Design defects found (separate list)\n\n- **D1. 7a cannot land alone.** The authority switch (plan §2, §4 7a \"Change\") refuses version-1/2 bodies at `offer!`, `report!` and `accepted-baseline`. The holder, compose and Stage E paths still offer such bodies until 7b/7c, so 141 deftests in six suites fail (table above; proven by the counterfactual). The plan's 7a acceptance never mentions them.\n  - Options for the orchestrator:\n    1. Merge 7a only together with 7b and 7c.\n    2. Move the three-line authority switch out of 7a into 7c.\n    3. A temporary version dispatch in the authority. This contradicts \"no version dispatch\" and is not recommended.\n  - `handoff_v2_authority_test` (an old-codec test the plan keeps until phase 8) also breaks permanently under any option. It needs deleting or re-basing, which the plan does not list.\n- **D2. Plan §1.1 row-1 contradicts §3.3.** Row-1 wants a re-emitted id-counter variant with \"a new root id and new pack; equal baseline\". With `:yin.k/root` in the baseline, which this brief requires, such a variant's baseline differs, and the ledger refuses it as `:variant-conflict` (pinned by `grant_test` `variant-other-root`). Under sorted `emit`, the only equal-baseline variant is the same root in another row order. I used that for `variant-equal`, `completion_test` and `inherited_test`.\n  - Stage E row-1 (7d) needs a ruling: either the variant is a conflict, or the root leaves the baseline.\n  - Related: `rows/decode` accepts rows in any order, so \"one root, one pack\" holds for what `emit` makes, not for what a reader accepts. Should decode refuse unsorted packs? I left decode unchanged.\n- **D3. Draft amendments to list (no doc edited):**\n  - transport-tuples §5.5 table: fork is nil in every row (owner Q1), and the slot admits only the five custody keys.\n  - continuation §2.5, §2.6, §7.1 step 8 and §7.2's stage table: custody is not phase-6 nil-only any more; the step-10 refusal `:yin.k/unsupported :custody` is replaced by the grammar's kinds and the grant refusals; the stage runs once for the tree after the three per-tree stages.\n  - continuation §11 Q4: closed for the op-id rules (correlation agreement is still not implemented).\n  - UCF 7.11.1: the inspector citation moves from `yin.vm.ucf.checkpoint` to `yin.vm.ucf.rows.checkpoint`.\n- **D4. The lift serves streams before custody refusals.** v1 refused `:op-seq-exhausted` before lifting; rows refuses it after the walk has called `serve!`. Harmless to the lower's zero-attach law, but a holder that counts serves will see them (7b's export record).\n\n## What 7b needs from me\n\n- `rows/lift-task` with `{:header h :source-index …}` is `holder.export/prepare` and `encode`'s new path; `h` is the same header shape (`:yin.k/enrolled` stays local).\n- `rows/pack-address wire` is the storage key to store and fence. The grant's `:checkpoint` must be that address.\n- `rows/lower-task recv wire attach! {:grant g :protection p}` is the driver's `lower`; `{:exclusive true}` refuses a fork; `{:fenced true}` is the rehydration entry. Finishing fenced is 7b's: recovery-cell-ids, exact id counter, parked records into the record, the header check against `:yin.k/state`.\n- `rows.checkpoint/inspect` answers the old inspector's keys plus `:yin.k/root`; `reopen-holder` and `rebuilt-cell` can read `:yin.k/kind`, `:yin.k/occurrence` and `:yin.k/next-op-seq` from it.\n- `rows_support` builders for the driver, writer and reader tests, and `rows_checkpoint_fixtures`' editing helpers for packs.\n- D1 decides whether 7b lands together with 7a.\nCreated-Local: 2026-10-13 +07\n# Slice 7c: composition and fencing on row packs\n\nImplemented in `/Users/sto/workspace/datomworld-srvm-p7c`, branch `srvm-phase7c`. No commit. All test lanes ran serially in the foreground, JVM only. No Node, Dart, remote host, or production-code change.\n\n## Result\n\nF1 and F2 were the first edits: the driver's source fence test now asserts the journal's store intents name recovery first and the pack second; Q3's install test changes only the derivation record's profile while retaining its honest input/output. Both gaps are protected by actual killed mutants.\n\nComposition fixtures now build semantic-register receivers and source machines through `rows-support`, and every composition supplies its required `:source-index` seam. F3's smuggled holder key is `:source-index (fn [] {})`. The fresh-process plain-composition test still asserts `PHASE lifted` and `REPL-NAMESPACES []`, using a semantic-register source/receiver.\n\nFencing fixtures lift with a custody header and source index, and lower row packs with exclusive, protection, and grant options. Put, retained FFI, and retained link requests preserve their operation ids through park, pack, lower, and fenced retry. The original remote toy transport remains the attachment/observation seam; there is no new code resolver.\n\nThe composition crash tests now observe recovery v2 before the pack. They assert the cut object's identity and format, its presence/absence for after/before cuts, no fence or offer over incomplete storage, and stalled recovery with no attachments or second occurrence mint. Successor mutations decode and re-emit the abstract task/custody through the existing fixture helpers, preserving valid row hashes.\n\nA second admitted encoding reverses pack row order: it has a different pack address, the same root id, and the same baseline. A counter change modifies the root and is correctly a conflicting variant. Pack addresses remain store keys and ledger variant ids; the structural root stays inside the baseline.\n\nTwo focused controls were added: the composition must consult its supplied source index and refuse an empty index; a live composed authority must refuse an unfenced fork result report without changing its projection.\n\n## Files and line counts\n\nFinal lines and additions/deletions versus this worktree's HEAD:\n\n| File | Lines | Added | Deleted | Tests (quick / slow) |\n|---|---:|---:|---:|---:|\n| `test/yin/vm/ucf/compose_test.cljc` | 1121 | 39 | 12 | 15 / 0 |\n| `test/yin/vm/ucf/compose_rows_test.cljc` | 2597 | 50 | 11 | 40 / 1 |\n| `test/yin/vm/ucf/fencing_rows_test.cljc` | 629 | 105 | 76 | 4 / 0 |\n| `test/yin/vm/ucf/handoff_v2_authority_test.cljc` | 65 | 24 | 60 | 3 / 0 |\n| `test/yin/vm/ucf/holder/driver_test.cljc` | 4261 | 6 | 0 | 116 / 1 |\n| `test/yin/vm/ucf/rows_custody_test.cljc` | 318 | 3 | 0 | 12 / 0 |\n\nThis report is the only additional deliverable. The six touched suites contain 192 tests: 190 quick and 2 slow. `compose_rows_test` has 41 tests including its guarded slow case. No pins, resources, rows implementation, layout implementation, kernels, or REPL files were edited.\n\n## Old-codec authority disposition (7a D1)\n\nDeleted only the version-2 authority calls and their assertions from the two mixed tests. Kept all direct inspector/codec coverage, on all four existing engines: fork versus exclusive baselines, fork operation-id refusal, and halted result origin. The two mixed tests were renamed to describe their retained inspector assertions. The old inspector and codec stay untouched until phase 8; no version dispatch or compatibility shim was added. Current row authority behavior is covered by rows-custody/authority suites and the new composed unfenced-report control.\n\n## Verification\n\n- `clj -M:kondo --lint` all six changed `.cljc` files: **0 errors, 0 warnings** (`target/7c-lint-final.log`). `git diff --check` clean.\n- Every `yin.vm.ucf.*` namespace, quick tier: `clojure -M:test -e :slow -r 'yin\\.vm\\.ucf\\..*'`: **700 tests, 9340 assertions, 0 failures, 5 errors** (`target/7c-ucf-quick.log`). All five errors are in `yin.vm.ucf.stage-e-rows-test`; no other namespace fails. The five cases are `row-1-candidates-and-encodings-test`, `row-7-failure-lower-and-lost-authority-test`, `row-3-reclaim-test`, `fork-per-host-test`, and `row-5-replay-divergence-test`. Each currently refuses assembly because `stage_e_world` supplies no source index. Stage E process cases are tagged slow and excluded; no Node process/build ran.\n- Every touched namespace was selected explicitly with `-n` in both tiers. The slow run with `DATOM_SLOW_TESTS=1` passed **2 tests, 435 assertions**, including `completion-recovery-unknown-policy-transaction-is-reconciled-once-test` (46 assertions) and the driver's existing slow journal-cut case (389 assertions), zero failures/errors (`target/7c-slow.log`).\n- Final post-mutation focused quick verification, selecting the six touched suites plus rows, both safepoint harnesses, and semantic-register layout explicitly with `-n`: **260 tests, 6942 assertions, 0 failures, 0 errors** (`target/7c-final-quick.log`).\n- Final post-mutation slow verification with the same explicit namespace selection and `DATOM_SLOW_TESTS=1`: **8 tests, 5010 assertions, 0 failures, 0 errors** (`target/7c-final-slow.log`). This includes the untouched rows and both harnesses as well as both touched slow cases.\n- Rows, the UCF safepoint harness, semantic-register safepoint harness, and semantic-register layout are verified without edits. No root-id pin moved.\n\n## Mutants\n\nEach mutation was applied alone, with a `cp`-equivalent byte backup (`shutil.copy2`), saved diff, foreground JVM run, and restoration in `finally`. After each restore, `git diff --no-index --quiet <backup> <file>` and `git diff --quiet -- src` both passed. Logs, diffs, backups, and summary: `target/7c-mutants/`; reproducible driver: `target/7c-mutants.py`. Each scoped run used `-n <namespace> -v <namespace/test>` and excluded slow tests.\n\n| Mutant | Change | Catching test | Failures / errors |\n|---|---|---|---:|\n| M1 | Store pack before recovery | driver `the-source-half-mints-fences-and-offers-before-candidacy-test` (F1) | 1 / 0 |\n| M2 | Attach before deciding custody | rows-custody `every-grant-check-refuses-before-any-attachment` | 18 / 0 |\n| M3 | Skip `accept-grant!` in row lower, through compose | compose-rows `row-2-the-source-emits-nothing-until-its-own-grant-test` | 9 / 0 |\n| M4 | Fenced lower restores gate `:running` | rows-custody `an-exclusive-blocked-root-under-fenced-skips-the-grant` | 1 / 0 |\n| M5 | Offer request carries wrong pack address | compose `a-whole-exclusive-handoff-runs-on-a-file-backed-authority-test` | 12 / 0 |\n| M6 | Swap before/after meaning in content-store cut seam | compose-rows `the-wired-compositions-content-store-cuts-test` | 1 / 1 |\n| M7 | Compose driver config ignores source index | compose `fork-runs-when-selected-and-is-labelled-fork-test` and `the-source-index-is-read-from-the-composition-test` | 6 / 0 |\n| M8 | Report origin check bypassed, admitting an unfenced halted baseline | compose-rows `a-composed-authority-refuses-an-unfenced-result-report-test` | 2 / 0 |\n| M9 | Q3 record-address conjunct removed | rows-custody `the-install-response-is-verified-before-any-attachment` (F2) | 2 / 0 |\n\nAll eight requested mutants and the extra F2 mutant were killed. M6 is a mutation of the test substrate's cut interpreter, not production code: its identity assertion fails before the swapped absence also causes decode to error. The first mutation attempt used `-v` without `-n`, which made the runner load unrelated Python suites and fail on missing generated lexer classes; those runs were discarded, stored under `target/7c-mutants-unscoped/`, and are not counted above.\n\n## Deviations\n\n1. No production seam change was necessary: existing source-index, header, grant, fenced recovery, and authority contracts support meaningful composition tests as landed.\n2. Equal-baseline variant generation varies pack row order rather than task counter, because the root id is part of the baseline. Successor mismatch cases still re-emit changed tasks/custody. This follows code semantics rather than weakening authority comparisons.\n3. Added the source-index and unfenced-report controls to make those mutant obligations explicit. Preserved the existing plain-composition subprocess contract.\n4. Per the owner ruling, `yin.repl/main.cljc` is untouched. Its old semantic kernel means its `:custody` branch remains inert until phase 8; this is an accepted gap, not a live custody proof. The no-REPL test proves the standalone semantic-register composition.\n5. No commit, including for the initial F1/F2 step, per the brief's explicit instruction.\n\n## Design defects (separate list)\n\n- **No new production/design mismatch found.** The root-inclusive baseline and recovery-first publication order are honored by the tests.\n- **Inherited D1 disposition:** authority accepts row packs only; the old-codec authority assertions no longer describe a supported path and were removed while preserving direct old-codec coverage. Authority was not redirected to the old inspector.\n- **Accepted Q2 gap:** REPL custody stays inert until its phase-8 kernel switch.\n- **Existing Q3 boundary (7b F5):** install verification checks response self-consistency (parent/link id and manifest/derivation/image), while binding content to composition-known addresses remains linker's fetch/admission responsibility. No widened admission or resolver was introduced.\n\n## What 7d needs\n\nPort `stage_e_world` source and receiver builders to semantic-register/rows-support; supply `:source-index` to each composition; replace old body-key and pending accesses with row task/custody decoding. Use pack addresses for store and offers, root ids only inside baselines. Re-emit changed task/custody variants; vary pack row order when an equal-root alternative encoding is required. Keep recovery-v2-first crash-cut meanings and fenced lower's exporting gate.\n\nThen run the Stage E in-process slow cases on the specified three hosts and its separate JVM/Node process matrix after building peers. None of that Stage E host/process acceptance is claimed here. Only 7d's Stage E suite remains red in the full UCF quick lane.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\np='test/yin/vm/ucf/stage_e_world.cljc'\ns=open(p).read().replace('[yin.vm.ucf.lift-support :as s]', '[yin.vm.ucf.rows-support :as s]\\\\n            [yin.vm.ucf.rows :as rows]\\\\n            [yin.vm.ucf.rows.checkpoint :as checkpoint]')\ns=s.replace(':mode mode\\\\n           :renewal', ':mode mode\\\\n           :source-index (fn [] @s/source-index)\\\\n           :renewal')\ns=s.replace('A second encoding of the occurrence holder \"'`h` fenced: the same body'\"\\\\n   in different canonical bytes (another id counter), put in the store', 'A second encoding of the occurrence holder \"'`h` fenced: the same root'\"\\\\n   with reversed rows in different canonical bytes, put in the store')\ns=s.replace('o (get-in body [:yin.k/custody :yin.k/occurrence])\\\\n        v-bytes (cbor/encode (assoc body :yin.k/id-counter 9))', 'o (:yin.k/occurrence (checkpoint/inspect address bytes))\\\\n        v-bytes (cbor/encode (update body :yin.k/rows #(vec (reverse %))))')\ns=s.replace('v-address (keyword \\\"segment\\\" (str \\\"blake3-\\\" (jing/digest-bytes :blake3 v-bytes)))','v-address (rows/pack-address v-bytes)')\n# snapshot packs: verify re-emission bytes against original canonical sorted pack\ns=s.replace('[a (when bs (digest-of bs))]', '[a (when bs (digest-of bs))]')\nopen(p,'w').write(s)\np='test/yin/vm/ucf/handoff_v2_authority_test.cljc';s=open(p).read().replace('covered by rows-custody-test.', 'covered by authority.grant-test,\\\\n   authority.completion-test and compose-rows-test.');open(p,'w').write(s)\np='test/yin/vm/ucf/compose_test.cljc';s=open(p).read();pos=s.index('(deftest a-journal-substrate-is-checked-at-open-test');s=s[:pos]+'''(deftest a-source-index-is-checked-at-open-test\n  (doseq [mode [:fork :exclusive]\n          index [nil {}]]\n    (let [cfg {:mode mode :source-index index}]\n      (is (thrown-with-msg?\n            #?(:cljd Object :c