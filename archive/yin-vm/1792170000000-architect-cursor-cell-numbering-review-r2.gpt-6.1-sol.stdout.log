{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cat collab/numbering-probe/deps.edn; nl -ba collab/numbering-probe/src/probe/discovery.clj'","aggregated_output":"{:deps {datomworld/root {:local/root \"../..\"}}\n :paths [\"src\" \"../../test\"]}\n     1\t(ns probe.discovery\n     2\t  \"Prototype of discovery-order cursor-cell numbering (note D1-D5 as revised\n     3\t   2026-10-12 after the codex review) over the 6a abstract task representation\n     4\t   (yin.vm.ucf.rows). Not repo code; a scratch project under collab/.\n     5\t\n     6\t   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n     7\t   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n     8\t\n     9\t   Shape of the procedure (one algorithm, two uses):\n    10\t   - a RUN traverses an item (D1), numbers cursor cells on first meeting (D2),\n    11\t     sorts each :set / :map by the local keys of its elements and defers equal\n    12\t     runs to the run's worklist (D1), re-examines the worklist to a fixpoint\n    13\t     (D3), groups the surviving tied elements into components by shared\n    14\t     unnumbered cursor cells, refuses a component holding two elements of one\n    15\t     group (D5), encodes each component by a nested local run, and adopts the\n    16\t     least encoding's components (D4); repeat until the worklist is empty.\n    17\t   - the root run assigns [:n k], k = 1, 2, ...; a LOCAL run (used only to\n    18\t     compute the key of an element or of a component) starts from the\n    19\t     enclosing run's numbering and assigns [:u j] from the enclosing run's\n    20\t     local counter; its spelling with surviving ties spelled [:tie K ...] is\n    21\t     the key. Local runs are memoized on (item, numbering restricted to the\n    22\t     item's cursor cells, local counter).\"\n    23\t  (:require [dao.jing :as jing]\n    24\t            [dao.jing.cbor :as cbor]\n    25\t            [yin.vm.ucf.rows :as rows]\n    26\t            [yin.vm.ucf.rows-test :as rt]\n    27\t            [yin.vm.semantic-register.frame-test :as ft]))\n    28\t\n    29\t;; ---------------------------------------------------------------- schema\n    30\t\n    31\t(def synthetic-table\n    32\t  \"Rows that exist only inside the procedure: a :map entry as an ordered pair,\n    33\t   and a component as the ordered list of its (group-id element) pairs.\"\n    34\t  {:entry [:V :V] :component [:pairs :D :V]})\n    35\t\n    36\t(defn descriptors [kind slots]\n    37\t  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n    38\t    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n    39\t          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n    40\t          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n    41\t          :else schema)))\n    42\t\n    43\t(defn ref? [d] (and (vector? d) (= :ref (first d))))\n    44\t(defn refs? [d] (and (vector? d) (= :refs (first d))))\n    45\t(defn v? [d] (contains? #{:V :optional-V} d))\n    46\t\n    47\t(defn bytes-key [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n    48\t\n    49\t(defn compare-bytes [a b]\n    50\t  (loop [i 0]\n    51\t    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n    52\t          (= i (count b)) 1\n    53\t          (= (nth a i) (nth b i)) (recur (inc i))\n    54\t          :else (compare (nth a i) (nth b i)))))\n    55\t\n    56\t(defn by-key-bytes [f xs] (sort #(compare-bytes (f %1) (f %2)) xs))\n    57\t\n    58\t(def keyed-structural #{:bindings :store :parked-table})\n    59\t\n    60\t(defn elem-item\n    61\t  \"The item an element is entered and keyed as: a :set element is its V; a\n    62\t   :map entry [k v] is the synthetic ordered row [:entry k v], so that the\n    63\t   alias pattern across key and value is part of the key.\"\n    64\t  [kind e]\n    65\t  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n    66\t\n    67\t(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n    68\t\n    69\t(defn item-cells\n    70\t  \"Cursor cells occurring in slot (d x); census and install children excluded.\n    71\t   Memoized per procedure on the slot value.\"\n    72\t  [ctx d x]\n    73\t  (or (get @(:cells-memo ctx) [d x])\n    74\t      (let [acc (atom #{})]\n    75\t        (letfn [(slot [d x]\n    76\t                  (cond (ref? d) (node x)\n    77\t                        (refs? d) (run! node x)\n    78\t                        (= :C d) (swap! acc conj x)\n    79\t                        (v? d) (when x (case (first x)\n    80\t                                         :cursor-cell (swap! acc conj (second x))\n    81\t                                         :row (node (second x))\n    82\t                                         nil))\n    83\t                        :else nil))\n    84\t                (node [n]\n    85\t                  (let [{:keys [kind slots]} n]\n    86\t                    (when-not (or (= :cursor-cells kind) (child-task? ctx n))\n    87\t                      (dorun (map slot (descriptors kind slots) slots)))))]\n    88\t          (slot d x)\n    89\t          (swap! (:cells-memo ctx) assoc [d x] @acc)\n    90\t          @acc))))\n    91\t\n    92\t(defn body-label [ctx c]\n    93\t  (let [[stream position] (:slots (get (:bodies ctx) c))]\n    94\t    [:body (into [:stream] (:slots stream)) position]))\n    95\t\n    96\t;; ------------------------------------------------------------------ runs\n    97\t\n    98\t(def ^:dynamic *trace* false)\n    99\t\n   100\t(defn- new-run [ctx num tag next]\n   101\t  {:ctx ctx :num (atom num) :tag tag :next (atom next)\n   102\t   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n   103\t\n   104\t(defn- meet!\n   105\t  \"D2. A cursor cell met for the first time receives the run's next number.\"\n   106\t  [run c]\n   107\t  (when-not (contains? @(:num run) c)\n   108\t    (let [k @(:next run)]\n   109\t      (swap! (:num run) assoc c [(:tag run) k])\n   110\t      (swap! (:next run) inc)\n   111\t      true)))\n   112\t\n   113\t(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)\n   114\t\n   115\t(defn- enter-slot! [run d x path]\n   116\t  (cond (ref? d) (enter-node! run x path)\n   117\t        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n   118\t        (= :C d) (meet! run x)\n   119\t        (v? d) (when x (case (first x)\n   120\t                         :cursor-cell (meet! run (second x))\n   121\t                         :row (enter-node! run (second x) path)\n   122\t                         nil))\n   123\t        :else nil))\n   124\t\n   125\t(defn- enter-node!\n   126\t  \"D1. Canonical traversal: table order for slots; ordered repeated slots in\n   127\t   order; keyed structural rows in the Jing byte order of the key; :window in\n   128\t   ascending register order; installs and module stores by name; :set and\n   129\t   :map by local keys with ties deferred; census and children not entered.\"\n   130\t  [run n path]\n   131\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n   132\t    (cond\n   133\t      (= :cursor-cells kind) nil\n   134\t      (child-task? ctx n) nil\n   135\t      (= :task kind)\n   136\t      (doseq [[i d x] (map vector (range) ds slots)]\n   137\t        (if (contains? #{7 12} i)\n   138\t          (doseq [child (by-key-bytes #(bytes-key (first (:slots %))) x)]\n   139\t            (enter-node! run child (conj path i (first (:slots child)))))\n   140\t          (enter-slot! run d x (conj path i))))\n   141\t      (contains? keyed-structural kind)\n   142\t      (doseq [[k v] (by-key-bytes #(bytes-key (first %)) (partition 2 slots))]\n   143\t        (enter-slot! run (second ds) v (conj path k)))\n   144\t      (= :window kind)\n   145\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n   146\t      (= :set kind) (unordered! run :set (vec slots) path)\n   147\t      (= :map kind) (unordered! run :map (mapv vec (partition 2 slots)) path)\n   148\t      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n   149\t\n   150\t(defn- local-key [run item]\n   151\t  (let [r (local-run run item)] [(bytes-key (:spell r)) (:spell r)]))\n   152\t\n   153\t(defn- unordered!\n   154\t  \"D1 for an unordered container: key every element by a local run under the\n   155\t   numbering at this moment; enter singletons in key order; defer equal runs\n   156\t   as one tie group (deferral order = canonical order).\"\n   157\t  [run kind elems path]\n   158\t  (let [keyed (mapv (fn [[i e]] [(local-key run (elem-item kind e)) e i]) (map-indexed vector elems))\n   159\t        groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n   160\t    (when (and *trace* (= :n (:tag run)))\n   161\t      (println \"  [sort]\" path \"num\" @(:num run))\n   162\t      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n   163\t    (doseq [g groups]\n   164\t      (if (= 1 (count g))\n   165\t        (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n   166\t        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n   167\t                                   :key (second (first (first g))) :elems (mapv second g)})))))\n   168\t\n   169\t(defn- fixpoint!\n   170\t  \"D3. Re-examine every deferred group in deferral order under the current\n   171\t   numbering; repeat while a round numbers a cursor cell and groups remain.\"\n   172\t  [run]\n   173\t  (loop []\n   174\t    (let [before (count @(:num run)) groups @(:groups run)]\n   175\t      (reset! (:groups run) [])\n   176\t      (doseq [{:keys [kind elems path]} groups] (unordered! run kind elems path))\n   177\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n   178\t\n   179\t(defn- components\n   180\t  \"D4. Tied elements of all surviving groups, linked by shared unnumbered\n   181\t   cursor cells (union-find). A component is :conflict when it holds two\n   182\t   elements of one group.\"\n   183\t  [run]\n   184\t  (let [num @(:num run) ctx (:ctx run)\n   185\t        elems (vec (for [g @(:groups run) [i e] (map-indexed vector (:elems g))]\n   186\t                     {:group (:id g) :kind (:kind g) :elem e :idx i\n   187\t                      :cells (set (remove #(contains? num %) (item-cells ctx :V (elem-item (:kind g) e))))}))\n   188\t        parent (atom (vec (range (count elems))))\n   189\t        find (fn find [i] (let [p (@parent i)] (if (= p i) i (let [r (find p)] (swap! parent assoc i r) r))))\n   190\t        union (fn [i j] (let [ri (find i) rj (find j)] (when (not= ri rj) (swap! parent assoc ri rj))))\n   191\t        by-cell (reduce (fn [m [i el]] (reduce (fn [m c] (update m c (fnil conj []) i)) m (:cells el)))\n   192\t                        {} (map-indexed vector elems))]\n   193\t    (doseq [[_ is] by-cell] (doseq [j (rest is)] (union (first is) j)))\n   194\t    (->> (group-by find (range (count elems)))\n   195\t         (sort-by first)\n   196\t         (mapv (fn [[_ is]]\n   197\t                 (let [members (vec (sort-by (juxt :group :idx) (map elems is)))\n   198\t                       groups (map :group members)]\n   199\t                   {:members members\n   200\t                    :conflict (not= (count groups) (count (distinct groups)))\n   201\t                    :group (first groups)\n   202\t                    :cells (vec (sort (distinct (mapcat :cells members))))}))))))\n   203\t\n   204\t(defn- component-item [comp]\n   205\t  [:row {:kind :component\n   206\t         :slots (vec (mapcat (fn [m] [(:group m) (elem-item (:kind m) (:elem m))]) (:members comp)))}])\n   207\t\n   208\t(defn- adopt!\n   209\t  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n   210\t   receive the enclosing run's next numbers in local-index order.\"\n   211\t  [run comp]\n   212\t  (let [fresh (->> (:num (:ce comp))\n   213\t                   (remove (fn [[c _]] (contains? @(:num run) c)))\n   214\t                   (sort-by (comp second val)))]\n   215\t    (doseq [[c _] fresh] (meet! run c))))\n   216\t\n   217\t(defn- remove-elements! [run comps]\n   218\t  (let [gone (set (for [c comps m (:members c)] [(:group m) (:idx m)]))]\n   219\t    (swap! (:groups run)\n   220\t           (fn [gs] (vec (keep (fn [g]\n   221\t                                 (let [es (vec (keep-indexed (fn [i e] (when-not (gone [(:id g) i]) e)) (:elems g)))]\n   222\t                                   (when (seq es) (assoc g :elems es))))\n   223\t                               gs))))))\n   224\t\n   225\t(defn- resolve!\n   226\t  \"D3-D5 to completion. Leaves :refused set (D5) with the worklist as of the\n   227\t   last fixpoint, or the worklist empty.\"\n   228\t  [run]\n   229\t  (loop []\n   230\t    (fixpoint! run)\n   231\t    (when (and *trace* (= :n (:tag run)))\n   232\t      (println \"  [resolve] num\" @(:num run) \"groups\" (mapv (fn [g] [(:id g) (:path g) (mapv (fn [e] (if (= :cursor-cell (first e)) (second e) e)) (:elems g))]) @(:groups run))))\n   233\t    (when (seq @(:groups run))\n   234\t      (let [comps (components run)\n   235\t            conflict (first (filter :conflict comps))]\n   236\t        (if conflict\n   237\t          (if (:permissive (:ctx run))\n   238\t            ;; Diagnostic only: enter the conflicting component in listed order.\n   239\t            (do (doseq [m (:members conflict)] (enter-slot! run :V (elem-item (:kind m) (:elem m)) [:permissive]))\n   240\t                (remove-elements! run [conflict])\n   241\t                (recur))\n   242\t            (reset! (:refused run) {:kind :unresolved-cursor-cells\n   243\t                                    :path (:path (first (filter #(= (:group conflict) (:id %)) @(:groups run))))\n   244\t                                    :cursor-cells (:cells conflict)}))\n   245\t          (let [comps (mapv #(assoc % :ce (local-run run (component-item %))) comps)]\n   246\t            (if-let [bad (first (filter #(not (:complete? (:ce %))) comps))]\n   247\t              (reset! (:refused run) (assoc (:refused (:ce bad)) :kind :unresolved-cursor-cells :nested true))\n   248\t              (let [sorted (sort #(compare-bytes (bytes-key (:spell (:ce %1))) (bytes-key (:spell (:ce %2)))) comps)\n   249\t                    least (bytes-key (:spell (:ce (first sorted))))\n   250\t                    least-run (take-while #(= least (bytes-key (:spell (:ce %)))) sorted)]\n   251\t                (when (and *trace* (= :n (:tag run)))\n   252\t                  (doseq [c sorted] (println \"  [component]\" (mapv (fn [m] [(:group m) (:cells m)]) (:members c)) \"CE\" (:spell (:ce c))))\n   253\t                  (println \"  [adopt]\" (count least-run)))\n   254\t                (doseq [c least-run] (adopt! run c))\n   255\t                (remove-elements! run least-run)\n   256\t                (recur)))))))))\n   257\t\n   258\t(defn- local-run\n   259\t  \"A nested run on one item from the enclosing run's numbering, tag :u. Its\n   260\t   result is a key: the spelling under its final numbering, surviving ties\n   261\t   spelled [:tie K ...]. Memoized.\"\n   262\t  [run item]\n   263\t  (let [ctx (:ctx run)\n   264\t        cells (item-cells ctx :V item)\n   265\t        num @(:num run)\n   266\t        start (if (= :u (:tag run)) @(:next run) 0)\n   267\t        mk [item (select-keys num cells) start]]\n   268\t    (or (get @(:memo ctx) mk)\n   269\t        (let [sub (new-run ctx num :u start)]\n   270\t          (enter-slot! sub :V item [])\n   271\t          (resolve! sub)\n   272\t          (let [r {:spell (spell-slot sub :V item [])\n   273\t                   ;; Restricted to the item's own cursor cells: the result is a\n   274\t                   ;; function of the memo key, never of the enclosing context.\n   275\t                   :num (select-keys @(:num sub) cells)\n   276\t                   :complete? (and (nil? @(:refused sub)) (empty? @(:groups sub)))\n   277\t                   :refused @(:refused sub)}]\n   278\t            (swap! (:memo ctx) assoc mk r)\n   279\t            r)))))\n   280\t\n   281\t;; -------------------------------------------------------------- spelling\n   282\t\n   283\t(defn- spell-cell [run c]\n   284\t  (let [[t k] (get @(:num run) c)]\n   285\t    (case t\n   286\t      :n [:cursor-cell [:n k]]\n   287\t      :u [:cursor-cell [:u k (body-label (:ctx run) c)]]\n   288\t      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n   289\t\n   290\t(defn- spell-slot [run d x path]\n   291\t  (cond (ref? d) (spell-node run x path)\n   292\t        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n   293\t        (= :C d) (spell-cell run x)\n   294\t        (v? d) (if (nil? x) x\n   295\t                   (case (first x)\n   296\t                     :cursor-cell (spell-cell run (second x))\n   297\t                     :row [:row (spell-node run (second x) path)]\n   298\t                     x))\n   299\t        :else x))\n   300\t\n   301\t(defn- spell-node\n   302\t  \"The content encoding CE of a row under the run's final numbering.\"\n   303\t  [run n path]\n   304\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n   305\t    (cond\n   306\t      (= :cursor-cells kind) [:cursor-cells]\n   307\t      (child-task? ctx n) [:child]\n   308\t      (= :task kind)\n   309\t      (into [kind]\n   310\t            (map-indexed (fn [i [d x]]\n   311\t                           (if (contains? #{7 12} i)\n   312\t                             (vec (by-key-bytes #(bytes-key (nth % 1))\n   313\t                                                (map #(spell-node run % (conj path i (first (:slots %)))) x)))\n   314\t                             (spell-slot run d x (conj path i))))\n   315\t                         (map vector ds slots)))\n   316\t      (contains? keyed-structural kind)\n   317\t      (into [kind] (mapcat identity (by-key-bytes #(bytes-key (first %))\n   318\t                                                  (map (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n   319\t                                                       (partition 2 slots)))))\n   320\t      (= :window kind)\n   321\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n   322\t      (contains? #{:set :map} kind)\n   323\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n   324\t            tied (filter #(= path (:path %)) @(:groups run))\n   325\t            tied-elems (set (mapcat :elems tied))\n   326\t            plain (keep-indexed (fn [i e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path i)))) elems)\n   327\t            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n   328\t        (into [kind] (by-key-bytes bytes-key (concat plain ties))))\n   329\t      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n   330\t\n   331\t;; ------------------------------------------------------------- procedure\n   332\t\n   333\t(defn discovery-numbering\n   334\t  \"Returns {:numbering {src -> :yin.k/cc-n}} or {:refused {...}}. Throws when\n   335\t   the numbering is not total (a defect, never a refusal).\"\n   336\t  ([task] (discovery-numbering task {}))\n   337\t  ([task opts]\n   338\t   (let [census (nth (:slots task) 9)\n   339\t         ctx {:task task\n   340\t              :bodies (into {} (map vec) (partition 2 (:slots census)))\n   341\t              :memo (atom {}) :cells-memo (atom {})\n   342\t              :permissive (:permissive opts)}\n   343\t         run (new-run ctx {} :n 1)]\n   344\t     (enter-node! run task [])\n   345\t     (resolve! run)\n   346\t     (if-let [r @(:refused run)]\n   347\t       {:refused r}\n   348\t       (let [numbered (set (keys @(:num run))) declared (set (keys (:bodies ctx)))]\n   349\t         (when (seq @(:groups run)) (throw (ex-info \"residue after resolve\" {})))\n   350\t         (when (not= numbered declared)\n   351\t           (throw (ex-info \"numbering is not total\" {:missing (vec (remove numbered declared))\n   352\t                                                      :extra (vec (remove declared numbered))})))\n   353\t         {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))})))))\n   354\t\n   355\t;; --------------------------------------------------------------- emission\n   356\t;; 6a's emit-node with install children numbered by discovery order.\n   357\t\n   358\t(def ^:private ordered-slots @#'rows/ordered-slots)\n   359\t(def ^:private check-literal-markers! @#'rows/check-literal-markers!)\n   360\t(def ^:private byte-compare @#'rows/byte-compare)\n   361\t\n   362\t(declare emit-node*)\n   363\t\n   364\t(def ^:dynamic *numbering-opts* {})\n   365\t\n   366\t(defn- refuse-unresolved! [r path]\n   367\t  (throw (ex-info \"unresolved cursor cells\"\n   368\t                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n   369\t                   :yin.k/path (into path (:path r)) :yin.k/cursor-cells (:cursor-cells r)})))\n   370\t\n   371\t(defn- emit-slot* [d x numbering rows]\n   372\t  (when-not (or (ref? d) (refs? d) (= :C d))\n   373\t    (check-literal-markers! (if (v? d) (when (= :lit (first x)) (second x)) x)))\n   374\t  (cond\n   375\t    (ref? d) (emit-node* x numbering rows)\n   376\t    (refs? d) (reduce (fn [[out rs] n] (let [[id rs'] (emit-node* n numbering rs)] [(conj out id) rs'])) [[] rows] x)\n   377\t    (= d :C) [(get numbering x x) rows]\n   378\t    (v? d) (case (first x)\n   379\t             :row (let [[id rs] (emit-node* (second x) numbering rows)] [[:row id] rs])\n   380\t             :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n   381\t             [x rows])\n   382\t    :else [x rows]))\n   383\t\n   384\t(defn- emit-node* [n numbering rows]\n   385\t  (let [{:keys [kind slots]} n\n   386\t        [slots rows] (reduce (fn [[out rs] [d x]]\n   387\t                               (if (and (ref? d) (= :task (:kind x)))\n   388\t                                 (let [r (discovery-numbering x *numbering-opts*)\n   389\t                                       _ (when (:refused r) (refuse-unresolved! (:refused r) [:child]))\n   390\t                                       [id child-rows] (emit-node* x (:numbering r) {})]\n   391\t                                   [(conj out id) (merge rs child-rows)])\n   392\t                                 (let [[x' rs'] (emit-slot* d x numbering rs)] [(conj out x') rs'])))\n   393\t                             [[] rows] (map vector (descriptors kind slots) slots))\n   394\t        slots (if (= kind :task)\n   395\t                (-> slots\n   396\t                    (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n   397\t                    (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n   398\t                (ordered-slots kind slots))\n   399\t        body (into [kind] slots) id (jing/segment-key body)]\n   400\t    [id (assoc rows id (into [id] body))]))\n   401\t\n   402\t(defn emit*\n   403\t  \"Lift side: number by discovery order, emit; refuses :yin.k/non-portable\n   404\t   :unresolved-cursor-cells (D5).\"\n   405\t  [task]\n   406\t  (let [r (discovery-numbering task)]\n   407\t    (when (:refused r) (refuse-unresolved! (:refused r) []))\n   408\t    (let [[id rows] (emit-node* task (:numbering r) {})]\n   409\t      {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n   410\t\n   411\t(defn decode*\n   412\t  \"Receiver side: 6a's decode* with its own numbering check off (it still runs\n   413\t   6a's recompute, under a large budget), then the discovery recompute and\n   414\t   compare. Only D5 translates to :yin.k/undecodable :unresolved-cursor-cells;\n   415\t   a resource refusal propagates as itself. In the real codec this check sits\n   416\t   at carrier step 6, before validate-frames; here it runs after decode*\n   417\t   returns (a probe limitation, documented in the note).\"\n   418\t  [wire]\n   419\t  (let [task (@#'rows/decode* wire (assoc rows/default-budget :check-numbering false))\n   420\t        r (discovery-numbering task)]\n   421\t    (when (:refused r)\n   422\t      (throw (ex-info \"unresolved cursor cells\"\n   423\t                      {:yin.k/status :yin.k/undecodable :yin.k/kind :unresolved-cursor-cells\n   424\t                       :yin.k/path (into [(:yin.k/root wire)] (:path (:refused r)))})))\n   425\t    (let [[id _] (emit-node* task (:numbering r) {})]\n   426\t      (when (not= id (:yin.k/root wire))\n   427\t        (throw (ex-info \"noncanonical\" {:yin.k/status :yin.k/undecodable :yin.k/kind :noncanonical-cursor-cells\n   428\t                                        :yin.k/path [(:yin.k/root wire)]}))))\n   429\t    task))\n   430\t\n   431\t(defn error [f]\n   432\t  (try (f) nil (catch Throwable e (or (ex-data e) {:throwable (str e)}))))\n   433\t\n   434\t(defn do-root [task]\n   435\t  (let [r (discovery-numbering task)]\n   436\t    (if (:refused r)\n   437\t      r\n   438\t      (try (:yin.k/root (emit* task))\n   439\t           (catch clojure.lang.ExceptionInfo e\n   440\t             (if (= :unresolved-cursor-cells (:yin.k/kind (ex-data e))) {:refused (ex-data e)} (throw e)))))))\n   441\t\n   442\t(defn safe-6a-root [task]\n   443\t  (try (:yin.k/root (rows/emit task))\n   444\t       (catch Throwable e {:refused (select-keys (ex-data e) [:yin.k/kind :yin.k/path])})))\n   445\t\n   446\t;; ------------------------------------------------------------ generators\n   447\t\n   448\t(defn rename-and-shuffle\n   449\t  \"Rename every cursor cell by `bij` and shuffle every :set, :map and the\n   450\t   census in listed order (shuffle is rebound by callers for determinism).\"\n   451\t  [n renaming]\n   452\t  (letfn [(value [v] (case (first v)\n   453\t                       :cursor-cell [:cursor-cell (bij (second v))]\n   454\t                       :row [:row (go (second v))]\n   455\t                       v))\n   456\t          (bij [x] (get renaming x x))\n   457\t          (go [n]\n   458\t            (let [{:keys [kind slots]} n]\n   459\t              (case kind\n   460\t                :set (rows/node :set (vec (shuffle (mapv value slots))))\n   461\t                :map (rows/node :map (vec (mapcat identity (shuffle (mapv (fn [[k v]] [(value k) (value v)]) (partition 2 slots))))))\n   462\t                :cursor-cells (rows/node :cursor-cells (vec (mapcat (fn [[c b]] [(bij c) (go b)]) (shuffle (mapv vec (partition 2 slots))))))\n   463\t                (rows/node kind (mapv (fn [d x]\n   464\t                                        (cond (ref? d) (go x)\n   465\t                                              (refs? d) (mapv go x)\n   466\t                                              (= :C d) (bij x)\n   467\t                                              (v? d) (if x (value x) x)\n   468\t                                              :else x))\n   469\t                                      (descriptors kind slots) slots)))))]\n   470\t    (go n)))\n   471\t\n   472\t(defn all-census-cells\n   473\t  \"Source ids of every census in the tree (root and install children).\"\n   474\t  [task]\n   475\t  (let [acc (atom [])]\n   476\t    (letfn [(node [n] (when (map? n)\n   477\t                        (when (= :cursor-cells (:kind n)) (swap! acc into (take-nth 2 (:slots n))))\n   478\t                        (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))]\n   479\t                          (cond (ref? d) (node x) (refs? d) (run! node x)\n   480\t                                (v? d) (when (and x (= :row (first x))) (node (second x)))))))]\n   481\t      (node task) (vec @acc))))\n   482\t\n   483\t(defn seeded-shuffle [^java.util.Random r]\n   484\t  (fn [xs] (let [a (java.util.ArrayList. ^java.util.Collection (vec xs))]\n   485\t             (java.util.Collections/shuffle a r)\n   486\t             (vec a))))\n   487\t\n   488\t(defn decoded\n   489\t  \"Portable decoded equality of an abstract value (check-abstract!'s rule):\n   490\t   sets as sets, maps as maps, cursor cells by identity.\"\n   491\t  [v]\n   492\t  (case (first v)\n   493\t    :lit [:lit (second v)]\n   494\t    :cursor-cell [:identity (second v)]\n   495\t    :row (let [n (second v) ss (:slots n)]\n   496\t           (case (:kind n)\n   497\t             :vec [:seq (mapv decoded ss)]\n   498\t             :set [:set (set (map decoded ss))]\n   499\t             :map [:map (into {} (map (fn [[k x]] [(decoded k) (decoded x)])) (partition 2 ss))]\n   500\t             [:row n]))))\n   501\t\n   502\t(defn distinct-decoded [vs] (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [e] [(decoded e) e])) vs))))\n   503\t\n   504\t(defn gen-value\n   505\t  \"Random V over `cells`, depth-bounded. Shapes: literals, cursor cells,\n   506\t   vectors, sets, maps (cursor cells as keys too), sets of cursor-cell pairs\n   507\t   (edges, aliases such as [X X] included), sets of sets.\"\n   508\t  [^java.util.Random r cells depth]\n   509\t  (let [pick (fn [xs] (nth xs (.nextInt r (count xs))))\n   510\t        cc (fn [] [:cursor-cell (pick cells)])\n   511\t        k (.nextInt r (if (pos? depth) 9 3))]\n   512\t    (case k\n   513\t      0 [:lit (pick [1 2 :k \"s\" nil])]\n   514\t      1 (cc)\n   515\t      2 (cc)\n   516\t      3 (let [elems (vec (repeatedly (inc (.nextInt r 3)) #(gen-value r cells (dec depth))))]\n   517\t          (if (some #(not= :lit (first %)) elems) [:row (rows/node :vec elems)] [:lit (mapv second elems)]))\n   518\t      4 (let [elems (distinct-decoded (repeatedly (inc (.nextInt r 4)) #(gen-value r cells (dec depth))))]\n   519\t          (if (some #(not= :lit (first %)) elems) [:row (rows/node :set elems)] [:lit (set (map second elems))]))\n   520\t      5 (let [pairs (vec (vals (into (sorted-map-by #(compare (pr-str %1) (pr-str %2))) (map (fn [p] [(decoded (first p)) p]))\n   521\t                                     (repeatedly (inc (.nextInt r 3)) #(vector (gen-value r cells (dec depth)) (gen-value r cells (dec depth)))))))]\n   522\t          (if (some (fn [[a b]] (or (not= :lit (first a)) (not= :lit (first b)))) pairs)\n   523\t            [:row (rows/node :map (vec (mapcat identity pairs)))]\n   524\t            [:lit (into {} (map (fn [[a b]] [(second a) (second b)])) pairs)]))\n   525\t      (6 7) (let [edges (distinct-decoded (repeatedly (+ 2 (.nextInt r 3)) #(vector :row (rows/node :vec [(cc) (cc)]))))]\n   526\t              [:row (rows/node :set edges)])\n   527\t      8 (let [inner (distinct-decoded (repeatedly (+ 2 (.nextInt r 2))\n   528\t                                                  #(let [es (distinct-decoded (repeatedly (inc (.nextInt r 3)) cc))]\n   529\t                                                     [:row (rows/node :set es)])))]\n   530\t          [:row (rows/node :set inner)]))))\n   531\t\n   532\t(defn reached [v]\n   533\t  (let [acc (atom #{})]\n   534\t    (letfn [(w [v] (case (first v)\n   535\t                     :cursor-cell (swap! acc conj (second v))\n   536\t                     :row (doseq [s (:slots (second v))] (w s))\n   537\t                     nil))]\n   538\t      (w v) @acc)))\n   539\t\n   540\t(defn gen-task\n   541\t  \"A :halted task: 1-6 cursor cells over two bodies (ties common), 1-3 store\n   542\t   bindings and the result slot hold random values.\"\n   543\t  [seed]\n   544\t  (let [r (java.util.Random. seed)\n   545\t        k (inc (.nextInt r 6))\n   546\t        cells (mapv #(keyword \"src\" (str \"c\" %)) (range k))\n   547\t        bodies (mapv (fn [_] (rt/cursor-cell-body :s (if (zero? (.nextInt r 3)) 1 0))) cells)\n   548\t        names (vec (take (inc (.nextInt r 3)) '[a b c]))\n   549\t        vals (mapv (fn [_] (gen-value r cells 3)) names)\n   550\t        result (gen-value r cells 2)\n   551\t        used (reduce into (reached result) (map reached vals))\n   552\t        census (keep (fn [[c b]] (when (used c) [c b])) (map vector cells bodies))]\n   553\t    (if (empty? used)\n   554\t      (recur (inc seed))\n   555\t      (let [t (rt/task-node census result)]\n   556\t        (rows/node :task (assoc (:slots t) 6 (rows/node :store (vec (mapcat (fn [n v] [n v]) names vals)))))))))\n   557\t\n   558\t(defn worked-act []\n   559\t  (first (:slots (rows/decode (rows/frame->rows ft/worked-frame)))))\n   560\t\n   561\t(def park-vector [[:closure 0 [] 2] [:halt 0] [:park 0] [:return 0]])\n   562\t(def park-address (jing/segment-key park-vector))\n   563\t\n   564\t(defn frame-task\n   565\t  \"A blocked task carrying the worked code plus a park segment. The wait's\n   566\t   act holds `wait-values` in its window register 1 and in one K frame's\n   567\t   window register 1; `env-value`, when given, is bound to e0 in the free\n   568\t   environment and in every environment; the parked state (P 7) is an act\n   569\t   at the park site whose K frame holds `parked-value` in register 1.\n   570\t   Decodes under 6a's validate-frames.\"\n   571\t  [census wait-values env-value parked-value]\n   572\t  (let [base (rt/task-node (conj (vec census) [:test/cursor (rt/cursor-cell-body :s 0)]) nil)\n   573\t        [seg pc env window k rd] (:slots (worked-act))\n   574\t        [_ store-of] (:slots env)\n   575\t        bindings (rows/node :bindings (if env-value ['e0 env-value] []))\n   576\t        env (rows/node :env [bindings store-of])\n   577\t        kframe (fn [v] (rows/node :kframe [seg pc env (rows/node :window [1 v]) rd]))\n   578\t        [w1 w2] wait-values\n   579\t        wait-act (rows/node :act [seg pc env (rows/node :window [1 w1]) (rows/node :k (if w2 [(kframe w2)] [])) rd])\n   580\t        pending (second (:slots (rows/decode (rows/frame->rows ft/worked-frame))))\n   581\t        parked (rows/node :act [park-address 3 env (rows/node :window []) (rows/node :k [(kframe parked-value)]) 0])]\n   582\t    (rows/node :task (-> (:slots base) (assoc 2 :blocked) (assoc 5 bindings)\n   583\t                         (assoc 11 (merge ft/worked-code {park-address park-vector}))\n   584\t                         (assoc 8 (rows/node :parked-table (if parked-value [7 parked] [])))\n   585\t                         (assoc 13 [(rows/node :wait [wait-act pending])]) (assoc 16 {:yin.k/policy :yin.k/fork})))))\n   586\t\n   587\t(defn gen-frame-task [seed]\n   588\t  (let [r (java.util.Random. seed)\n   589\t        k (inc (.nextInt r 4))\n   590\t        cells (mapv #(keyword \"src\" (str \"f\" %)) (range k))\n   591\t        body (rt/cursor-cell-body :s 0)\n   592\t        pick (fn [] (gen-value r cells 2))\n   593\t        wait-values (vec (repeatedly (inc (.nextInt r 2)) pick))\n   594\t        env-value (when (zero? (.nextInt r 2)) (pick))\n   595\t        parked-value (when (zero? (.nextInt r 2)) (pick))\n   596\t        used (reduce into #{} (map reached (remove nil? (concat wait-values [env-value parked-value]))))]\n   597\t    (if (empty? used)\n   598\t      (recur (inc seed))\n   599\t      (frame-task (mapv #(vector % body) (filter used cells)) wait-values env-value parked-value))))\n   600\t\n   601\t(defn gen-child-task\n   602\t  \"A parent (seed) with two install children: one random child task and the\n   603\t   review counterexample as a child; the parent's own values stay random.\"\n   604\t  [seed]\n   605\t  (let [parent (gen-task seed)\n   606\t        child (rows/node :task (assoc (:slots (gen-task (+ 100000 seed))) 3 :child))]\n   607\t    (rows/node :task (assoc (:slots parent) 12 [(rows/node :install ['a :running nil {} child])\n   608\t                                                (rows/node :install ['b :running nil {} child])]))))\n   609\t\n   610\t(defn fixture-review-counterexample\n   611\t  \"'a bound to #{X Y} with equal bodies, 'b bound to X.\"\n   612\t  []\n   613\t  (let [body (rt/cursor-cell-body :s 0)\n   614\t        t (rt/task-node [[:x body] [:y body]] [:lit nil])]\n   615\t    (rows/node :task (assoc (:slots t) 6 (rows/node :store ['a [:row (rows/node :set [[:cursor-cell :x] [:cursor-cell :y]])]\n   616\t                                                             'b [:cursor-cell :x]])))))\n   617\t\n   618\t;; ------------------------------------------------------------ diagnostics\n   619\t\n   620\t(defn permissive-roots\n   621\t  \"For a refused state: run the procedure with D5 replaced by listed-order\n   622\t   entry, over `n` shuffles of every unordered container. More than one root\n   623\t   is a witness that the state is not interchangeable; one root over n\n   624\t   shuffles is not a proof.\"\n   625\t  [task n]\n   626\t  (let [r (java.util.Random. 7)]\n   627\t    (with-redefs [shuffle (seeded-shuffle r)]\n   628\t      (->> (repeatedly n #(rename-and-shuffle task identity))\n   629\t           (map (fn [t] (binding [*numbering-opts* {:permissive true}]\n   630\t                          (let [d (discovery-numbering t {:permissive true})\n   631\t                                [id _] (emit-node* t (:numbering d) {})]\n   632\t                            id))))\n   633\t           distinct count))))\n   634\t\n   635\t(defn report-fixture [name task]\n   636\t  (let [d (discovery-numbering task)]\n   637\t    (println name)\n   638\t    (println \"  DO :\" (or (:refused d) (into (sorted-map) (:numbering d))))\n   639\t    (println \"  DO root:\" (do-root task))\n   640\t    (println \"  6a root:\" (safe-6a-root task))))\n   641\t\n   642\t(defn invariance-check\n   643\t  \"Root of the state and of the state renamed and shuffled; decode of the\n   644\t   carrier. Returns a map of outcomes.\"\n   645\t  [task ^java.util.Random r]\n   646\t  (let [cells (all-census-cells task)\n   647\t        fresh (zipmap cells (map #(keyword \"other\" (str \"z\" %)) (shuffle (range (count cells)))))\n   648\t        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\n   649\t        d1 (do-root task) d2 (do-root task2)]\n   650\t    (if (map? d1)\n   651\t      {:refused (:refused d1)}\n   652\t      (cond-> {:root d1 :invariant (= d1 d2)}\n   653\t        true (assoc :decode (let [e (error #(decode* (emit* task)))]\n   654\t                              (cond (nil? e) :ok\n   655\t                                    (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\n   656\t                                    :else e)))))))\n   657\t\n   658\t(defn search [label gen seeds]\n   659\t  (let [r (java.util.Random. 11)\n   660\t        stats (atom {:numbered 0 :refused 0 :invariance-fail 0 :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\n   661\t                     :refused-witnessed-noninterchangeable 0 :refused-not-distinguished 0})]\n   662\t    (doseq [seed seeds]\n   663\t      (let [task (gen seed) o (invariance-check task r)]\n   664\t        (if (:refused o)\n   665\t          (do (swap! stats update :refused inc)\n   666\t              (if (> (permissive-roots task 12) 1)\n   667\t                (swap! stats update :refused-witnessed-noninterchangeable inc)\n   668\t                (swap! stats update :refused-not-distinguished inc)))\n   669\t          (do (swap! stats update :numbered inc)\n   670\t              (when-not (:invariant o) (swap! stats update :invariance-fail inc) (println \"INVARIANCE FAIL\" label seed))\n   671\t              (case (:decode o)\n   672\t                :ok (swap! stats update :decode-ok inc)\n   673\t                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\n   674\t                (do (swap! stats update :decode-fail inc) (println \"DECODE FAIL\" label seed (:decode o))))))))\n   675\t    (println label (count seeds) \"states:\" @stats)\n   676\t    @stats))\n   677\t\n   678\t(defn -main []\n   679\t  (let [body (rt/cursor-cell-body :s 0)\n   680\t        s (fn [es] [:row (rows/node :set es)])\n   681\t        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\n   682\t        c (fn [x] [:cursor-cell x])\n   683\t        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))]\n   684\t    (println \"== fixtures\")\n   685\t    (report-fixture \"fixture :s1 :s2 :x :y (pinned fab223...)\" (rt/fixture :s1 :s2 :x :y))\n   686\t    (report-fixture \"review counterexample 'a #{X Y}, 'b X\" (fixture-review-counterexample))\n   687\t    (report-fixture \"symmetric pair #{X Y}\" (task [:x :y] (s [(c :x) (c :y)])))\n   688\t    (report-fixture \"alias a: [x x y]\" (task [:x :y] (v [:x :x :y])))\n   689\t    (report-fixture \"alias b: [x y y]\" (task [:x :y] (v [:x :y :y])))\n   690\t    (report-fixture \"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])])))\n   691\t    (report-fixture \"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])]))\n   692\t    (report-fixture \"codex A: #{[X X] [Y Z]}\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])])))\n   693\t    (report-fixture \"codex A reversed\" (task [:x :y :z] (s [(v [:y :z]) (v [:x :x])])))\n   694\t    (report-fixture \"codex B: {X X, Y Z}\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])]))\n   695\t    (report-fixture \"codex B reversed\" (task [:x :y :z] [:row (rows/node :map [(c :y) (c :z) (c :x) (c :x)])]))\n   696\t    (report-fixture \"codex C: #{#{X Y} #{Z W}}\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])])))\n   697\t    (report-fixture \"codex C renamed\" (task [:q :r :s :t] (s [(s [(c :s) (c :t)]) (s [(c :q) (c :r)])])))\n   698\t    (report-fixture \"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]))\n   699\t    (report-fixture \"[#{X Y} X]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (c :x)])]))\n   700\t    (report-fixture \"[#{#{X Y} #{Z W}} X]\" (task [:x :y :z :w] [:row (rows/node :vec [(s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]) (c :x)])]))\n   701\t    (report-fixture \"#{[#{X Y} #{X Y}] [#{P Q} #{R S}]} (equal keys would be unsound; keys differ)\"\n   702\t                    (task [:x :y :p :q :r :s] (s [[:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])]\n   703\t                                                   [:row (rows/node :vec [(s [(c :p) (c :q)]) (s [(c :r) (c :s)])])]])))\n   704\t    (report-fixture \"loop + 2-cycle #{[L L] [A B] [B A]} (6a pinned 55ff16...)\" (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])])))\n   705\t    (report-fixture \"2-cycle #{[A B] [B A]}\" (task [:a :b] (s [(v [:a :b]) (v [:b :a])])))\n   706\t    (report-fixture \"3-cycle #{[A B] [B C] [C A]}\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])])))\n   707\t    (report-fixture \"seven-cell triangle+square\" (rt/seven-cursor-cell-triangle-square))\n   708\t    (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))]\n   709\t      (report-fixture \"ten cells in a vec\" (rt/task-node (mapv (fn [id i] [id (rt/cursor-cell-body :s i)]) ids (range))\n   710\t                                                         (v ids))))\n   711\t    (println \"\\n== refused states: permissive roots over 24 shuffles (>1 = witnessed non-interchangeable)\")\n   712\t    (doseq [[name t] [[\"loop + 2-cycle\" (task [:l :a :b] (s [(v [:l :l]) (v [:a :b]) (v [:b :a])]))]\n   713\t                      [\"2-cycle\" (task [:a :b] (s [(v [:a :b]) (v [:b :a])]))]\n   714\t                      [\"3-cycle\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c]) (v [:c :a])]))]\n   715\t                      [\"seven-cell\" (rt/seven-cursor-cell-triangle-square)]\n   716\t                      [\"path #{[A B] [B C]} (refused: A and B are not interchangeable)\" (task [:a :b :c] (s [(v [:a :b]) (v [:b :c])]))]]]\n   717\t      (println \" \" name \":\" (permissive-roots t 24) \"distinct root(s)\"))\n   718\t    (println \"\\n== invariance under element reversal + renaming/shuffling\")\n   719\t    (let [r (java.util.Random. 3)]\n   720\t      (doseq [[name t] [[\"#{[X X] [Y Y]}\" (task [:x :y] (s [(v [:x :x]) (v [:y :y])]))]\n   721\t                        [\"{X 1, Y 1}\" (task [:x :y] [:row (rows/node :map [(c :x) [:lit 1] (c :y) [:lit 1]])])]\n   722\t                        [\"#{X Y}\" (task [:x :y] (s [(c :x) (c :y)]))]\n   723\t                        [\"review counterexample\" (fixture-review-counterexample)]\n   724\t                        [\"codex A\" (task [:x :y :z] (s [(v [:x :x]) (v [:y :z])]))]\n   725\t                        [\"codex B\" (task [:x :y :z] [:row (rows/node :map [(c :x) (c :x) (c :y) (c :z)])])]\n   726\t                        [\"codex C\" (task [:x :y :z :w] (s [(s [(c :x) (c :y)]) (s [(c :z) (c :w)])]))]\n   727\t                        [\"[#{X Y} #{X Y}]\" (task [:x :y] [:row (rows/node :vec [(s [(c :x) (c :y)]) (s [(c :x) (c :y)])])])]]]\n   728\t        (let [rev (with-redefs [shuffle (comp vec reverse)] (rename-and-shuffle t identity))\n   729\t              ren (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle t (fn [x] (keyword \"q\" (clojure.core/name x)))))]\n   730\t          (println name \"DO:\" (do-root t) \"| reversed equal:\" (= (do-root t) (do-root rev))\n   731\t                   \"| renamed+shuffled equal:\" (= (do-root t) (do-root ren)) \"| decode:\" (or (error #(decode* (emit* t))) :ok)))))\n   732\t    (println \"\\n== frame-bearing fixtures (act window, K frame window, environments, parked state)\")\n   733\t    (let [t (frame-task [[:x body] [:y body]] [(c :x) (c :y)] (c :y) (s [(c :x) (c :y)]))]\n   734\t      (report-fixture \"wait window x, K window y, env y, parked K window #{x y}\" t)\n   735\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n   736\t    (let [t (frame-task [[:x body] [:y body]] [(s [(c :x) (c :y)])] nil (c :y))]\n   737\t      (report-fixture \"wait window #{x y}, parked K window y (parked table, slot 8, precedes frames, slot 13)\" t)\n   738\t      (println \"  decode:\" (or (error #(decode* (emit* t))) :ok)))\n   739\t    (println \"\\n== install children numbered by discovery order\")\n   740\t    (let [child (rows/node :task (assoc (:slots (fixture-review-counterexample)) 3 :child))\n   741\t          parent (rows/node :task (assoc (:slots (rt/task-node [[:x (rt/cursor-cell-body :root/s 1)]] (c :x))) 12\n   742\t                                         [(rows/node :install ['a :running nil {} child])\n   743\t                                          (rows/node :install ['b :running nil {} child])]))\n   744\t          wire (emit* parent)]\n   745\t      (println \"  parent root:\" (:yin.k/root wire) \"| task rows:\" (count (filter #(= :task (second %)) (:yin.k/rows wire)))\n   746\t               \"| child numbering:\" (into (sorted-map) (:numbering (discovery-numbering child)))\n   747\t               \"| decode:\" (or (error #(decode* wire)) :ok)))\n   748\t    (println \"\\n== counterexample search\")\n   749\t    (search \"random values\" gen-task (range 2000))\n   750\t    (search \"frame-bearing\" gen-frame-task (range 200))\n   751\t    (search \"with children\" gen-child-task (range 100))))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '269,445p' docs/design/yin.vm.semantic-register-vm.cursor-cell-numbering.md; sed -n '1,345p' collab/numbering-probe/src/probe/discovery.clj; cat collab/numbering-probe/deps.edn; rg --files -g '*classpath*' -g '*.cp' .; ls /Users/sto/.m2/repository/org/clojure/clojure/*/*.jar\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '269,445p' docs/design/yin.vm.semantic-register-vm.cursor-cell-numbering.md; sed -n '1,345p' collab/numbering-probe/src/probe/discovery.clj; cat collab/numbering-probe/deps.edn; rg --files -g '*classpath*' -g '*.cp' .; ls /Users/sto/.m2/repository/org/clojure/clojure/*/*.jar\"","aggregated_output":"**Memoization (implementation note, not part of the definition).** A\nlocal run's result is a function of its item, of the enclosing numbering\nrestricted to the item's cursor cells, and of the enclosing local\ncounter; an implementation may memoize on that key and must return the\nnumbering restricted to the item's own cursor cells (the prototype's one\nbug during revision was returning the whole numbering of another\nelement's context, which the decode round trip caught).\n\n**Validation and decode.** Unchanged in form: the receiver decodes, runs\nthe root run, re-emits and compares root ids (`:noncanonical-cursor-cells`\non mismatch). In 6a's `decode*` the recomputation is `emit` itself\n(`rows.cljc:570-575`); it must be wrapped so that **only** a lift-side\n`:yin.k/non-portable` of kind `:unresolved-cursor-cells` raised by the\nrecomputation is translated to `:yin.k/undecodable` kind\n`:unresolved-cursor-cells` with `:yin.k/path` prefixed by the root id;\na resource refusal (`:yin.k/unsupported :resource-limit`) propagates as\nitself; no other non-portable kind can arise there, because step 5 has\nalready checked literals and markers. The validator order stays: step 6\n(numbering) after step 5 and before `validate-frames` (`rows.cljc:576-578`;\ntest `numbering-precedes-frame-defect`, `rows_test.cljc:206`).\n\n**Work.** Let `P` be the number of expanded positions of the task (the\ntree after expanding every `[:row B]` and structural reference in place;\na shared row counts once per reference, so `P` can exceed the row count\nand the implementation must bound it, not the row count), `d` the\ncontainer nesting depth, `n` the number of cursor cells, `m` the largest\nelement count of one container. Then, with memoized local runs, the\nprocedure visits each position at most `(n + 1)` times per nesting level\n(a local run over an element is recomputed only when the numbering\nrestricted to that element's cursor cells changes, at most `n` times),\nevery encoding is linear in its element's expansion, and each container\nsort costs `O(B · log m)` compare work for `B` key bytes; so\n`W = O(P · (d + 1) · (n + 1) · log m)` positions-and-bytes, and the bytes\nmaterialized at any time are `O(W)` plus the memo, itself `O(P · (d + 1)\n· (n + 1))`. Without memoization the bound is `O(P · (n + 1)^(d+1) · log m)`.\nBoth are accounted before allocation by the budgets that stay: `:work`\nis charged one unit per position visited or spelled **and** one unit per\nliteral byte copied into a spelling (so every allocated spelling byte\nhas been paid for), `:depth` bounds `d` and the structural depth as\ntoday, `:cursor-cells` bounds `n`, `:rows` bounds the carried rows and\n`:bytes` the carried bytes, which together bound every literal a spelling\ncan copy. The `:search` and `:label-bytes` budgets disappear with the\nsearch and the growing labels. Exceeding a budget is the resource refusal\nof carrier §10.10, never a canonicality verdict.\n\n## 3. Proof of canonicality\n\nCall two configurations (abstract task, partial numbering, worklist)\n**isomorphic** when a bijection `π` of cursor cells carries one to the\nother: the structures agree up to renaming by `π` and up to the host\norder of every unordered container and of the census, numbers agree\n(`N'(π(c)) = N(c)`), and worklists correspond group by group in order.\nLet `S` be an abstract task.\n\n**Lemma A (keys are canonical).** The key of an element is the spelling\nof a local run over it, and a local run reads only structure, body\nlabels and numbers; its own listed-order inputs are (i) element order\ninside nested containers, which it never uses except through keys, by\ninduction on nesting depth, and (ii) the host order of components of\nequal encoding in its D4 step, covered by lemma C. So isomorphic items\nunder corresponding numberings have byte-identical keys, and the sorted\norder of a container's elements is a function of the configuration up\nto isomorphism.\n\n**Lemma B (ties are exactly what keys cannot separate).** By\nconstruction: elements are deferred iff their keys are equal bytes.\n\n**Lemma C (components).** At a fixpoint let `C₁ … Cₘ` be the components\nof one run of equal encodings, none holding two elements of one group,\nand let `U₁ … Uₘ` be their unnumbered cursor cells. The `Uᵢ` are\npairwise disjoint and each `Uᵢ` is confined to `Cᵢ` (every occurrence of\nan unnumbered cell lies in a tied element, hence in its own component).\nEqual, complete encodings of `[:component g₁ e₁ …]` rows are a faithful\nspelling (literals as themselves, rows expanded, every cursor cell by\nindex and body, groups by sequence number), so they exhibit, for each\npair `Cᵢ, Cⱼ`, a bijection `Uᵢ → Uⱼ` under which the components are the\nsame structure group by group. Entering the run in host order `σ` gives\nthe cells of `C_{σ(t)}` the numbers `b + (t−1)·|U| + 1 …` by local index;\nin order `σ'` the cells of `C_{σ'(t)}` receive the same numbers. The\nblock-swap bijection composed from the pairwise bijections is an\nisomorphism of the two resulting configurations: numbers agree by\nconstruction, structures agree because the swapped components are\nisomorphic and nothing outside them mentions their cells, and the\nworklists agree because the same groups remain, with the same elements\nremoved. ∎\n\n**Lemma D (refusal is invariant).** Whether a component holds two\nelements of one group depends only on which tied elements share\nunnumbered cursor cells, which is a function of the configuration up to\nisomorphism; and whether a component's local run is complete is, by\nlemma A applied to that run, likewise invariant.\n\n**Theorem.** The procedure's output on isomorphic configurations is the\nsame: both refuse at corresponding points, or both emit byte-identical\nrows. *Proof.* By induction on the number of steps. D1 and D2 decisions\nare functions of the configuration up to isomorphism (lemma A); D3 only\nrepeats D1 on deferred groups in a canonical order; D4's choice of the\nleast run is canonical (lemma A on component encodings) and its only\nlisted-order input is harmless (lemma C); D5 is invariant (lemma D).\nEmission spells cursor cells by number only and sorts every emitted\nunordered slot by canonical bytes under the final numbering (carrier §5),\nso isomorphic final configurations emit the same rows. ∎\n\nConsequences:\n\n1. *Function of structure, renaming-invariant, enumeration-invariant*:\n   the theorem with `π` a renaming, a permutation of the containers, or\n   both. No decision reads a source id or a host order except at the\n   point lemma C covers.\n2. *Terminating.* The structural edge family is acyclic (carrier §8 step\n   3), so every traversal is finite. In the root run each D3 round that\n   is not the last numbers a cursor cell; each D4 step numbers at least\n   one cursor cell or removes a duplicate group; local runs are finite\n   by the same argument one level down and there are finitely many\n   nesting levels. So the procedure ends after at most `n` numbering\n   events per run plus one terminal round, within the bound of §2 \"Work\".\n3. *Deterministic*, hence two lifts of one state are byte-identical and\n   the receiver's recomputation is well defined.\n4. *Sharing survives*: the numbering is a bijection on reached cursor\n   cells (D2 never renumbers; totality is asserted), every occurrence of\n   one cursor cell spells one number, and two cursor cells at one\n   position get two numbers.\n5. *Cross-engine law*: two engines lifting one canonical frame produce\n   abstract tasks equal up to renaming (the frame is engine-independent,\n   continuation §2.1) and therefore, by the theorem, equal rows.\n\nWhat is given up: the procedure does not number every state. D5 names\nthe refused class exactly (§1 F4); a later bounded search over that\nresidue would not change the numbering of any state D1–D4 number today,\nso the refusal can be narrowed without churning ids.\n\n## 4. Amendments\n\n**A1 — carrier §6, from \"The procedure.\" to the end of step 5.** Replace\nwith §2 above (vocabulary, the body label, the spelling, D1–D5, totality,\nwork). Keep the section's first paragraph (the counterexample) and amend\n\"What is defined, and what is not claimed\" to: \"The canonical numbering\nis defined as the output of the discovery-order procedure below, which is\na function of the state up to renaming of cursor cells and host\nenumeration of guest sets, maps and the census (proof in\n`yin.vm.semantic-register-vm.cursor-cell-numbering.md` §3). It is not the\nminimum of the root bytes over all bijections. A state in which two\nequal-keyed elements of one guest set or map are linked by shared\nunnumbered cursor cells at a fixpoint is refused (D5), not searched; the\nrefusal certifies nothing about interchangeability and can be narrowed\nlater without changing any numbering assigned today.\" State in step 2's\nreplacement that `[:n k]` is an exact CBOR integer and that `[:child]`\nreplaces `[:child <child root id>]` (reason in §2 \"Spelling\").\n\n**A2 — carrier §6 \"Validation\".** Replace the paragraph's last two\nsentences, from \"Every labeling that yields the selected commitment is\nthereby accepted, and no encounter-order tie-break ever decides validity\"\nto the end, with: \"Every labeling that yields the selected commitment is\nthereby accepted. The procedure reads the canonical traversal order of\nD1, which is a function of the state; it never reads the host's\nenumeration order of a set, map or census, and a receiver never decides\nvalidity by its own enumeration order. This is a lower-side structural\nrefusal, not a lift kind. A receiver whose work bound (§10.10) is\nexceeded before the procedure completes refuses with the structured\nresource refusal before any attachment, never labels the state\n`:noncanonical-cursor-cells`, never substitutes host enumeration order,\nand never accepts an unfinished check; a receiver that reaches D5\nrefuses `:yin.k/undecodable` kind `:unresolved-cursor-cells`.\"\n\n**A3 — carrier §5 preamble.** Replace \"The class-erased skeletons of §6\nare used only inside the numbering procedure and never decide the order\nof an emitted row\" with \"The spellings (content encodings) of §6 are\nused only inside the numbering procedure and never decide the order of\nan emitted row\".\n\n**A4 — carrier §8 step 6.** \"Recompute §6 under the work bound and\ncompare (`:yin.k/undecodable`, kind `:noncanonical-cursor-cells`;\n`:yin.k/undecodable` kind `:unresolved-cursor-cells` if D5 is reached,\ntranslated from the recomputation's lift-side refusal of that kind only;\nor the resource refusal of §10.10 if the bound is exceeded, which\npropagates untranslated).\" In the diagnostics paragraph after step 12,\nadd `:unresolved-cursor-cells` to the `:yin.k/undecodable` kinds named,\n(ns probe.discovery\n  \"Prototype of discovery-order cursor-cell numbering (note D1-D5 as revised\n   2026-10-12 after the codex review) over the 6a abstract task representation\n   (yin.vm.ucf.rows). Not repo code; a scratch project under collab/.\n\n   Vocabulary: UCF 7.5.3. A cursor cell is the VM box the carrier serializes;\n   its source id is the lift's local name; the procedure assigns :yin.k/cc-n.\n\n   Shape of the procedure (one algorithm, two uses):\n   - a RUN traverses an item (D1), numbers cursor cells on first meeting (D2),\n     sorts each :set / :map by the local keys of its elements and defers equal\n     runs to the run's worklist (D1), re-examines the worklist to a fixpoint\n     (D3), groups the surviving tied elements into components by shared\n     unnumbered cursor cells, refuses a component holding two elements of one\n     group (D5), encodes each component by a nested local run, and adopts the\n     least encoding's components (D4); repeat until the worklist is empty.\n   - the root run assigns [:n k], k = 1, 2, ...; a LOCAL run (used only to\n     compute the key of an element or of a component) starts from the\n     enclosing run's numbering and assigns [:u j] from the enclosing run's\n     local counter; its spelling with surviving ties spelled [:tie K ...] is\n     the key. Local runs are memoized on (item, numbering restricted to the\n     item's cursor cells, local counter).\"\n  (:require [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-test :as rt]\n            [yin.vm.semantic-register.frame-test :as ft]))\n\n;; ---------------------------------------------------------------- schema\n\n(def synthetic-table\n  \"Rows that exist only inside the procedure: a :map entry as an ordered pair,\n   and a component as the ordered list of its (group-id element) pairs.\"\n  {:entry [:V :V] :component [:pairs :D :V]})\n\n(defn descriptors [kind slots]\n  (let [schema (or (get rows/row-table kind) (get synthetic-table kind))]\n    (cond (= schema :pending) (into [:D] (get rows/pending-table (first slots)))\n          (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n          (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n          :else schema)))\n\n(defn ref? [d] (and (vector? d) (= :ref (first d))))\n(defn refs? [d] (and (vector? d) (= :refs (first d))))\n(defn v? [d] (contains? #{:V :optional-V} d))\n\n(defn bytes-key [x] (mapv #(bit-and (int %) 255) (seq (cbor/encode x))))\n\n(defn compare-bytes [a b]\n  (loop [i 0]\n    (cond (= i (count a)) (if (= i (count b)) 0 -1)\n          (= i (count b)) 1\n          (= (nth a i) (nth b i)) (recur (inc i))\n          :else (compare (nth a i) (nth b i)))))\n\n(defn by-key-bytes [f xs] (sort #(compare-bytes (f %1) (f %2)) xs))\n\n(def keyed-structural #{:bindings :store :parked-table})\n\n(defn elem-item\n  \"The item an element is entered and keyed as: a :set element is its V; a\n   :map entry [k v] is the synthetic ordered row [:entry k v], so that the\n   alias pattern across key and value is part of the key.\"\n  [kind e]\n  (if (= :map kind) [:row {:kind :entry :slots (vec e)}] e))\n\n(defn child-task? [ctx n] (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n\n(defn item-cells\n  \"Cursor cells occurring in slot (d x); census and install children excluded.\n   Memoized per procedure on the slot value.\"\n  [ctx d x]\n  (or (get @(:cells-memo ctx) [d x])\n      (let [acc (atom #{})]\n        (letfn [(slot [d x]\n                  (cond (ref? d) (node x)\n                        (refs? d) (run! node x)\n                        (= :C d) (swap! acc conj x)\n                        (v? d) (when x (case (first x)\n                                         :cursor-cell (swap! acc conj (second x))\n                                         :row (node (second x))\n                                         nil))\n                        :else nil))\n                (node [n]\n                  (let [{:keys [kind slots]} n]\n                    (when-not (or (= :cursor-cells kind) (child-task? ctx n))\n                      (dorun (map slot (descriptors kind slots) slots)))))]\n          (slot d x)\n          (swap! (:cells-memo ctx) assoc [d x] @acc)\n          @acc))))\n\n(defn body-label [ctx c]\n  (let [[stream position] (:slots (get (:bodies ctx) c))]\n    [:body (into [:stream] (:slots stream)) position]))\n\n;; ------------------------------------------------------------------ runs\n\n(def ^:dynamic *trace* false)\n\n(defn- new-run [ctx num tag next]\n  {:ctx ctx :num (atom num) :tag tag :next (atom next)\n   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n\n(defn- meet!\n  \"D2. A cursor cell met for the first time receives the run's next number.\"\n  [run c]\n  (when-not (contains? @(:num run) c)\n    (let [k @(:next run)]\n      (swap! (:num run) assoc c [(:tag run) k])\n      (swap! (:next run) inc)\n      true)))\n\n(declare enter-node! enter-slot! unordered! local-run resolve! spell-slot spell-node)\n\n(defn- enter-slot! [run d x path]\n  (cond (ref? d) (enter-node! run x path)\n        (refs? d) (dorun (map-indexed (fn [i n] (enter-node! run n (conj path i))) x))\n        (= :C d) (meet! run x)\n        (v? d) (when x (case (first x)\n                         :cursor-cell (meet! run (second x))\n                         :row (enter-node! run (second x) path)\n                         nil))\n        :else nil))\n\n(defn- enter-node!\n  \"D1. Canonical traversal: table order for slots; ordered repeated slots in\n   order; keyed structural rows in the Jing byte order of the key; :window in\n   ascending register order; installs and module stores by name; :set and\n   :map by local keys with ties deferred; census and children not entered.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) nil\n      (child-task? ctx n) nil\n      (= :task kind)\n      (doseq [[i d x] (map vector (range) ds slots)]\n        (if (contains? #{7 12} i)\n          (doseq [child (by-key-bytes #(bytes-key (first (:slots %))) x)]\n            (enter-node! run child (conj path i (first (:slots child)))))\n          (enter-slot! run d x (conj path i))))\n      (contains? keyed-structural kind)\n      (doseq [[k v] (by-key-bytes #(bytes-key (first %)) (partition 2 slots))]\n        (enter-slot! run (second ds) v (conj path k)))\n      (= :window kind)\n      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n      (= :set kind) (unordered! run :set (vec slots) path)\n      (= :map kind) (unordered! run :map (mapv vec (partition 2 slots)) path)\n      :else (dorun (map-indexed (fn [i [d x]] (enter-slot! run d x (conj path i))) (map vector ds slots))))))\n\n(defn- local-key [run item]\n  (let [r (local-run run item)] [(bytes-key (:spell r)) (:spell r)]))\n\n(defn- unordered!\n  \"D1 for an unordered container: key every element by a local run under the\n   numbering at this moment; enter singletons in key order; defer equal runs\n   as one tie group (deferral order = canonical order).\"\n  [run kind elems path]\n  (let [keyed (mapv (fn [[i e]] [(local-key run (elem-item kind e)) e i]) (map-indexed vector elems))\n        groups (partition-by (comp first first) (sort #(compare-bytes (first (first %1)) (first (first %2))) keyed))]\n    (when (and *trace* (= :n (:tag run)))\n      (println \"  [sort]\" path \"num\" @(:num run))\n      (doseq [g groups] (println \"    \" (if (= 1 (count g)) \"enter\" \"DEFER\") (mapv (fn [[[_ sp] e _]] [e sp]) g))))\n    (doseq [g groups]\n      (if (= 1 (count g))\n        (let [[_ e i] (first g)] (enter-slot! run :V (elem-item kind e) (conj path i)))\n        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :kind kind :path path\n                                   :key (second (first (first g))) :elems (mapv second g)})))))\n\n(defn- fixpoint!\n  \"D3. Re-examine every deferred group in deferral order under the current\n   numbering; repeat while a round numbers a cursor cell and groups remain.\"\n  [run]\n  (loop []\n    (let [before (count @(:num run)) groups @(:groups run)]\n      (reset! (:groups run) [])\n      (doseq [{:keys [kind elems path]} groups] (unordered! run kind elems path))\n      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n\n(defn- components\n  \"D4. Tied elements of all surviving groups, linked by shared unnumbered\n   cursor cells (union-find). A component is :conflict when it holds two\n   elements of one group.\"\n  [run]\n  (let [num @(:num run) ctx (:ctx run)\n        elems (vec (for [g @(:groups run) [i e] (map-indexed vector (:elems g))]\n                     {:group (:id g) :kind (:kind g) :elem e :idx i\n                      :cells (set (remove #(contains? num %) (item-cells ctx :V (elem-item (:kind g) e))))}))\n        parent (atom (vec (range (count elems))))\n        find (fn find [i] (let [p (@parent i)] (if (= p i) i (let [r (find p)] (swap! parent assoc i r) r))))\n        union (fn [i j] (let [ri (find i) rj (find j)] (when (not= ri rj) (swap! parent assoc ri rj))))\n        by-cell (reduce (fn [m [i el]] (reduce (fn [m c] (update m c (fnil conj []) i)) m (:cells el)))\n                        {} (map-indexed vector elems))]\n    (doseq [[_ is] by-cell] (doseq [j (rest is)] (union (first is) j)))\n    (->> (group-by find (range (count elems)))\n         (sort-by first)\n         (mapv (fn [[_ is]]\n                 (let [members (vec (sort-by (juxt :group :idx) (map elems is)))\n                       groups (map :group members)]\n                   {:members members\n                    :conflict (not= (count groups) (count (distinct groups)))\n                    :group (first groups)\n                    :cells (vec (sort (distinct (mapcat :cells members))))}))))))\n\n(defn- component-item [comp]\n  [:row {:kind :component\n         :slots (vec (mapcat (fn [m] [(:group m) (elem-item (:kind m) (:elem m))]) (:members comp)))}])\n\n(defn- adopt!\n  \"D4. Enter a component by adopting its local run: its fresh cursor cells\n   receive the enclosing run's next numbers in local-index order.\"\n  [run comp]\n  (let [fresh (->> (:num (:ce comp))\n                   (remove (fn [[c _]] (contains? @(:num run) c)))\n                   (sort-by (comp second val)))]\n    (doseq [[c _] fresh] (meet! run c))))\n\n(defn- remove-elements! [run comps]\n  (let [gone (set (for [c comps m (:members c)] [(:group m) (:idx m)]))]\n    (swap! (:groups run)\n           (fn [gs] (vec (keep (fn [g]\n                                 (let [es (vec (keep-indexed (fn [i e] (when-not (gone [(:id g) i]) e)) (:elems g)))]\n                                   (when (seq es) (assoc g :elems es))))\n                               gs))))))\n\n(defn- resolve!\n  \"D3-D5 to completion. Leaves :refused set (D5) with the worklist as of the\n   last fixpoint, or the worklist empty.\"\n  [run]\n  (loop []\n    (fixpoint! run)\n    (when (and *trace* (= :n (:tag run)))\n      (println \"  [resolve] num\" @(:num run) \"groups\" (mapv (fn [g] [(:id g) (:path g) (mapv (fn [e] (if (= :cursor-cell (first e)) (second e) e)) (:elems g))]) @(:groups run))))\n    (when (seq @(:groups run))\n      (let [comps (components run)\n            conflict (first (filter :conflict comps))]\n        (if conflict\n          (if (:permissive (:ctx run))\n            ;; Diagnostic only: enter the conflicting component in listed order.\n            (do (doseq [m (:members conflict)] (enter-slot! run :V (elem-item (:kind m) (:elem m)) [:permissive]))\n                (remove-elements! run [conflict])\n                (recur))\n            (reset! (:refused run) {:kind :unresolved-cursor-cells\n                                    :path (:path (first (filter #(= (:group conflict) (:id %)) @(:groups run))))\n                                    :cursor-cells (:cells conflict)}))\n          (let [comps (mapv #(assoc % :ce (local-run run (component-item %))) comps)]\n            (if-let [bad (first (filter #(not (:complete? (:ce %))) comps))]\n              (reset! (:refused run) (assoc (:refused (:ce bad)) :kind :unresolved-cursor-cells :nested true))\n              (let [sorted (sort #(compare-bytes (bytes-key (:spell (:ce %1))) (bytes-key (:spell (:ce %2)))) comps)\n                    least (bytes-key (:spell (:ce (first sorted))))\n                    least-run (take-while #(= least (bytes-key (:spell (:ce %)))) sorted)]\n                (when (and *trace* (= :n (:tag run)))\n                  (doseq [c sorted] (println \"  [component]\" (mapv (fn [m] [(:group m) (:cells m)]) (:members c)) \"CE\" (:spell (:ce c))))\n                  (println \"  [adopt]\" (count least-run)))\n                (doseq [c least-run] (adopt! run c))\n                (remove-elements! run least-run)\n                (recur)))))))))\n\n(defn- local-run\n  \"A nested run on one item from the enclosing run's numbering, tag :u. Its\n   result is a key: the spelling under its final numbering, surviving ties\n   spelled [:tie K ...]. Memoized.\"\n  [run item]\n  (let [ctx (:ctx run)\n        cells (item-cells ctx :V item)\n        num @(:num run)\n        start (if (= :u (:tag run)) @(:next run) 0)\n        mk [item (select-keys num cells) start]]\n    (or (get @(:memo ctx) mk)\n        (let [sub (new-run ctx num :u start)]\n          (enter-slot! sub :V item [])\n          (resolve! sub)\n          (let [r {:spell (spell-slot sub :V item [])\n                   ;; Restricted to the item's own cursor cells: the result is a\n                   ;; function of the memo key, never of the enclosing context.\n                   :num (select-keys @(:num sub) cells)\n                   :complete? (and (nil? @(:refused sub)) (empty? @(:groups sub)))\n                   :refused @(:refused sub)}]\n            (swap! (:memo ctx) assoc mk r)\n            r)))))\n\n;; -------------------------------------------------------------- spelling\n\n(defn- spell-cell [run c]\n  (let [[t k] (get @(:num run) c)]\n    (case t\n      :n [:cursor-cell [:n k]]\n      :u [:cursor-cell [:u k (body-label (:ctx run) c)]]\n      (throw (ex-info \"spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n\n(defn- spell-slot [run d x path]\n  (cond (ref? d) (spell-node run x path)\n        (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n        (= :C d) (spell-cell run x)\n        (v? d) (if (nil? x) x\n                   (case (first x)\n                     :cursor-cell (spell-cell run (second x))\n                     :row [:row (spell-node run (second x) path)]\n                     x))\n        :else x))\n\n(defn- spell-node\n  \"The content encoding CE of a row under the run's final numbering.\"\n  [run n path]\n  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n    (cond\n      (= :cursor-cells kind) [:cursor-cells]\n      (child-task? ctx n) [:child]\n      (= :task kind)\n      (into [kind]\n            (map-indexed (fn [i [d x]]\n                           (if (contains? #{7 12} i)\n                             (vec (by-key-bytes #(bytes-key (nth % 1))\n                                                (map #(spell-node run % (conj path i (first (:slots %)))) x)))\n                             (spell-slot run d x (conj path i))))\n                         (map vector ds slots)))\n      (contains? keyed-structural kind)\n      (into [kind] (mapcat identity (by-key-bytes #(bytes-key (first %))\n                                                  (map (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n                                                       (partition 2 slots)))))\n      (= :window kind)\n      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n      (contains? #{:set :map} kind)\n      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n            tied (filter #(= path (:path %)) @(:groups run))\n            tied-elems (set (mapcat :elems tied))\n            plain (keep-indexed (fn [i e] (when-not (tied-elems e) (spell-slot run :V (elem-item kind e) (conj path i)))) elems)\n            ties (map #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n        (into [kind] (by-key-bytes bytes-key (concat plain ties))))\n      :else (into [kind] (map-indexed (fn [i [d x]] (spell-slot run d x (conj path i))) (map vector ds slots))))))\n\n;; ------------------------------------------------------------- procedure\n\n(defn discovery-numbering\n  \"Returns {:numbering {src -> :yin.k/cc-n}} or {:refused {...}}. Throws when\n   the numbering is not total (a defect, never a refusal).\"\n  ([task] (discovery-numbering task {}))\n  ([task opts]\n   (let [census (nth (:slots task) 9)\n         ctx {:task task\n              :bodies (into {} (map vec) (partition 2 (:slots census)))\n              :memo (atom {}) :cells-memo (atom {})\n              :permissive (:permissive opts)}\n         run (new-run ctx {} :n 1)]\n     (enter-node! run task [])\n     (resolve! run)\n{:deps {datomworld/root {:local/root \"../..\"}}\n :paths [\"src\" \"../../test\"]}\n/Users/sto/.m2/repository/org/clojure/clojure/1.10.3/clojure-1.10.3.jar\n/Users/sto/.m2/repository/org/clojure/clojure/1.11.1/clojure-1.11.1.jar\n/Users/sto/.m2/repository/org/clojure/clojure/1.11.3/clojure-1.11.3.jar\n/Users/sto/.m2/repository/org/clojure/clojure/1.12.0/clojure-1.12.0.jar\n/Users/sto/.m2/repository/org/clojure/clojure/1.12.4/clojure-1.12.4.jar\n","exit_code":0,"status":"completed"}}
