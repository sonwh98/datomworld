frame-task [seed]\\n   588\\t  (let [r (java.util.Random. seed)\\n   589\\t        k (inc (.nextInt r 4))\\n   590\\t        cells (mapv #(keyword \\\"src\\\" (str \\\"f\\\" %)) (range k))\\n   591\\t        body (rt/cursor-cell-body :s 0)\\n   592\\t        pick (fn [] (gen-value r cells 2))\\n   593\\t        wait-values (vec (repeatedly (inc (.nextInt r 2)) pick))\\n   594\\t        env-value (when (zero? (.nextInt r 2)) (pick))\\n   595\\t        parked-value (when (zero? (.nextInt r 2)) (pick))\\n   596\\t        used (reduce into #{} (map reached (remove nil? (concat wait-values [env-value parked-value]))))]\\n   597\\t    (if (empty? used)\\n   598\\t      (recur (inc seed))\\n   599\\t      (frame-task (mapv #(vector % body) (filter used cells)) wait-values env-value parked-value))))\\n   600\\t\\n   601\\t(defn gen-child-task\\n   602\\t  \\\"A parent (seed) with two install children: one random child task and the\\n   603\\t   review counterexample as a child; the parent's own values stay random.\\\"\\n   604\\t  [seed]\\n   605\\t  (let [parent (gen-task seed)\\n   606\\t        child (rows/node :task (assoc (:slots (gen-task (+ 100000 seed))) 3 :child))]\\n   607\\t    (rows/node :task (assoc (:slots parent) 12 [(rows/node :install ['a :running nil {} child])\\n   608\\t                                                (rows/node :install ['b :running nil {} child])]))))\\n   609\\t\\n   610\\t(defn fixture-review-counterexample\\n   611\\t  \\\"'a bound to #{X Y} with equal bodies, 'b bound to X.\\\"\\n   612\\t  []\\n   613\\t  (let [body (rt/cursor-cell-body :s 0)\\n   614\\t        t (rt/task-node [[:x body] [:y body]] [:lit nil])]\\n   615\\t    (rows/node :task (assoc (:slots t) 6 (rows/node :store ['a [:row (rows/node :set [[:cursor-cell :x] [:cursor-cell :y]])]\\n   616\\t                                                             'b [:cursor-cell :x]])))))\\n   617\\t\\n   618\\t;; ------------------------------------------------------------ diagnostics\\n   619\\t\\n   620\\t(defn permissive-roots\\n   621\\t  \\\"For a refused state: run the procedure with D5 replaced by listed-order\\n   622\\t   entry, over `n` shuffles of every unordered container. More than one root\\n   623\\t   is a witness that the state is not interchangeable; one root over n\\n   624\\t   shuffles is not a proof.\\\"\\n   625\\t  [task n]\\n   626\\t  (let [r (java.util.Random. 7)]\\n   627\\t    (with-redefs [shuffle (seeded-shuffle r)]\\n   628\\t      (->> (repeatedly n #(rename-and-shuffle task identity))\\n   629\\t           (map (fn [t] (binding [*numbering-opts* {:permissive true}]\\n   630\\t                          (let [d (discovery-numbering t {:permissive true})\\n   631\\t                                [id _] (emit-node* t (:numbering d) {})]\\n   632\\t                            id))))\\n   633\\t           distinct count))))\\n   634\\t\\n   635\\t(defn report-fixture [name task]\\n   636\\t  (let [d (discovery-numbering task)]\\n   637\\t    (println name)\\n   638\\t    (println \\\"  DO :\\\" (or (:refused d) (into (sorted-map) (:numbering d))))\\n   639\\t    (println \\\"  DO root:\\\" (do-root task))\\n   640\\t    (println \\\"  6a root:\\\" (safe-6a-root task))))\\n   641\\t\\n   642\\t(defn invariance-check\\n   643\\t  \\\"Root of the state and of the state renamed and shuffled; decode of the\\n   644\\t   carrier. Returns a map of outcomes.\\\"\\n   645\\t  [task ^java.util.Random r]\\n   646\\t  (let [cells (all-census-cells task)\\n   647\\t        fresh (zipmap cells (map #(keyword \\\"other\\\" (str \\\"z\\\" %)) (shuffle (range (count cells)))))\\n   648\\t        task2 (with-redefs [shuffle (seeded-shuffle r)] (rename-and-shuffle task fresh))\\n   649\\t        d1 (do-root task) d2 (do-root task2)]\\n   650\\t    (if (map? d1)\\n   651\\t      {:refused (:refused d1)}\\n   652\\t      (cond-> {:root d1 :invariant (= d1 d2)}\\n   653\\t        true (assoc :decode (let [e (error #(decode* (emit* task)))]\\n   654\\t                              (cond (nil? e) :ok\\n   655\\t                                    (= :resource-limit (:yin.k/kind e)) :sixa-recompute-limit\\n   656\\t                                    :else e)))))))\\n   657\\t\\n   658\\t(defn search [label gen seeds]\\n   659\\t  (let [r (java.util.Random. 11)\\n   660\\t        stats (atom {:numbered 0 :refused 0 :invariance-fail 0 :decode-ok 0 :decode-fail 0 :decode-6a-limit 0\\n   661\\t                     :refused-witnessed-noninterchangeable 0 :refused-not-distinguished 0})]\\n   662\\t    (doseq [seed seeds]\\n   663\\t      (let [task (gen seed) o (invariance-check task r)]\\n   664\\t        (if (:refused o)\\n   665\\t          (do (swap! stats update :refused inc)\\n   666\\t              (if (> (permissive-roots task 12) 1)\\n   667\\t                (swap! stats update :refused-witnessed-noninterchangeable inc)\\n   668\\t                (swap! stats update :refused-not-distinguished inc)))\\n   669\\t          (do (swap! stats update :numbered inc)\\n   670\\t              (when-not (:invariant o) (swap! stats update :invariance-fail inc) (println \\\"INVARIANCE FAIL\\\" label seed))\\n   671\\t              (case (:decode o)\\n   672\\t                :ok (swap! stats update :decode-ok inc)\\n   673\\t                :sixa-recompute-limit (swap! stats update :decode-6a-limit inc)\\n   674\\t                (do (swap! stats update :decode-fail inc) (println \\\"DECODE FAIL\\\" label seed (:decode o))))))))\\n   675\\t    (println label (count seeds) \\\"states:\\\" @stats)\\n   676\\t    @stats))\\n   677\\t\\n   678\\t(defn -main []\\n   679\\t  (let [body (rt/cursor-cell-body :s 0)\\n   680\\t        s (fn [es] [:row (rows/node :set es)])\\n   681\\t        v (fn [cs] [:row (rows/node :vec (mapv #(vector :cursor-cell %) cs))])\\n   682\\t        c (fn [x] [:cursor-cell x])\\n   683\\t        task (fn [ids result] (rt/task-node (mapv #(vector % body) ids) result))]\\n   684\\t   