from-ten-cursor-cells\n   332\t  (let [ids (mapv #(keyword \"src\" (str \"x\" %)) (range 10))\n   333\t        task (task-node (mapv (fn [id i] [id (cursor-cell-body :s i)]) ids (range))\n   334\t                        [:row (rows/node :vec (mapv #(vector :cursor-cell %) ids))])\n   335\t        wire (rows/emit task)\n   336\t        census (first (filter #(= :cursor-cells (second %)) (:yin.k/rows wire)))]\n   337\t    (is (= (mapv #(keyword \"yin.k\" (str \"cc-\" %)) (range 1 11)) (vec (take-nth 2 (drop 2 census)))))\n   338\t    (is (= (:yin.k/root wire) (:yin.k/root (rows/emit (rows/decode wire)))))))\n   339\t\n   340\t\n   341\t(deftest marker-shaped-guest-maps-are-not-portable\n   342\t  (doseq [v [{:yin.k/row 1} {:yin.k/cursor-cell \"c\"}]]\n   343\t    (is (= :yin.k/non-portable\n   390\t\n   391\t\n   392\t(defn seven-cursor-cell-triangle-square\n   393\t  []\n   394\t  (let [ids [:a :b :c :d :e :f :g]\n   395\t        edges [[:a :b] [:b :c] [:c :a] [:d :e] [:e :f] [:f :g] [:g :d]]]\n   396\t    (task-node (mapv #(vector % (cursor-cell-body :s 0)) ids)\n   397\t               [:row (rows/node :set (mapv (fn [[a b]] [:row (rows/node :vec [[:cursor-cell a] [:cursor-cell b]])]) edges))])))\n   398\t\n   399\t\n   400\t(deftest intermediate-label-bytes-are-bounded\n   401\t  (let [d (error #(rows/canonical-numbering (seven-cursor-cell-triangle-square)))]\n   402\t    (is (= :resource-limit (:yin.k/kind d)))\n   403\t    (is (= [:label-bytes] (:yin.k/path d)))))\n   404\t\n   405\t\n   406\t(deftest input-row-bodies-do-not-spend-label-bytes\n   407\t  (let [large (vec (range 400000))\n   408\t        base (task-node [[:x (cursor-cell-body :s 0)]] [:lit large])\n   409\t        ;; Keep the census cursor cell reachable so decode also validates the carrier.\n   410\t        reachable (rows/node :task (assoc (:slots base) 5\n   411\t                                          (rows/node :bindings ['cursor [:cursor-cell :x]])))\n   412\t        custody (rows/node :task (assoc (:slots reachable) 15 [:lit nil]))\n   413\t        custody (rows/node :task (assoc (:slots custody) 16 large))]\n   414\t    (is (nil? (error #(rows/emit base))))\n   415\t    (doseq [task [reachable custody]]\n   416\t      (let [wire (rows/emit task)\n   417\t            expected (rows/node :task\n   418\t                                (-> (:slots task)\n   419\t                                    (assoc 5 (rows/node :bindings ['cursor [:cursor-cell :yin.k/cc-1]]))\n   420\t                                    (assoc 9 (rows/node :cursor-cells [:yin.k/cc-1 (cursor-cell-body :s 0)]))))]\n   421\t        (is (= expected (rows/decode wire)))))))\n   225\t\n   226\t\n   227\t(defn- gen-id\n   228\t  \"Generate a unique keyword ID from a prefix and counter value.\"\n   229\t  [prefix id-counter]\n   230\t  (keyword (str prefix \"-\" id-counter)))\n   231\t\n   311\t   general heap box. Vocabulary: UCF §7.5.3, \\\"Terminology\\\".\"\n   312\t  [resource]\n   313\t  (and (map? resource) (contains? resource :stream-id)))\n   314\t\n   315\t\n   316\t(defn issue-ref\n   317\t  \"A reference of `kind` (`:stream-ref`, `:cursor-ref`, or `:cell-ref`) to\n   318\t   resource or heap cell `id`, sealed under the task's capability secret.\n   319\t   A task composed\n   320\t   without a secret cannot issue one: it fails closed rather than issue a\n   321\t   reference anyone could forge.\"\n   322\t  [state kind id]\n   323\t  (let [secret (:capability-secret state)]\n   324\t    (when (nil? secret)\n   557\t  [state]\n   558\t  (let [n (or (:yin.k/issued state) 0)]\n   559\t    [n (assoc state :yin.k/issued (inc n))]))\n   560\t\n   561\t\n   562\t(defn handle-cursor-unminted\n   563\t  \"`handle-cursor` under a gate: verifies the stream reference, issues the\n   564\t   sealed cursor reference and installs an unminted cell, with no handle\n   565\t   call. `seq-n` is the creation order. Returns [cursor-ref updated-state].\"\n   566\t  [state effect id seq-n]\n   567\t