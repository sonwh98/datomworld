{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'v4|contract' src/cljc/yin/vm/semantic.cljc; sed -n '210,250p' src/cljc/yin/vm/code.cljc; sed -n '1,90p' src/cljc/yin/vm/semantic_register/derive.cljc; rg -n 'completion|code-facts' src/cljc/yin/vm/ucf/rows.cljc src/cljc/yin/vm/ucf/holder/export.cljc; rg -n 'golden|[0-9a-f]{64}|print-goldens' test/yang/python/antlr/{int_literal_test,float_address_test}.cljc test/yin/vm/code_test.cljc; git branch --show-current; git rev-parse --short HEAD; rg --files src/cljc/yin/vm/ucf test/yin/vm | rg '(handoff|checkpoint|lift_support|v2_support)'\"","aggregated_output":"740:   `contract` is required and compared with `vm/semantic-contract` before\n741:   the batch is judged (`:contract-missing`, `:contract-mismatch`); S2.6\n743:  [vm datoms contract]\n744:  (vm/check-contract! vm/semantic-contract contract)\n791:   `contract` is required and compared with `vm/semantic-contract` before\n793:  ([vm v contract] (load-vector vm v contract {}))\n794:  ([vm v contract opts]\n795:   (vm/check-contract! vm/semantic-contract contract)\n830:  [vm v contract]\n831:  (vm/check-contract! vm/semantic-contract contract)\n975:    {:format :yin.semantic/code, :contract vm/semantic-contract})\n995:                 vm/semantic-contract))\n998:  (attach-module [vm image] (attach-image vm image vm/semantic-contract))\n               :instructions instructions}]\n    (some #(% batch) rules)))\n\n\n;; =============================================================================\n;; The canonical instruction vector (UCF §7.3.2, §7.5)\n;; =============================================================================\n\n(def vector-operand-table\n  \"§2.4's operand table in UCF §7.3.2's positional form: mnemonic → ordered\n   `[attribute kind]` operands. Position `i` of a canonical tuple (from 1)\n   holds the operand entry `i-1` names; this one table drives the §7.5\n   validator's rules. Each kind names the\n   rule that judges it: `:data`, `:sym`, `:syms`, `:kw`, `:str`, `:bool`,\n   and `:buffer` belong to `:operand-kind` (a nil passes it and is\n   `:saturation`'s defect); `:pc` to `:target-bounds`; `:uint` to `:argc`.\"\n  {:const [[:yin.code/value :data]],\n   :var [[:yin.code/name :sym]],\n   :closure [[:yin.code/params :syms] [:yin.code/body :pc]],\n   :push [],\n   :call [[:yin.code/argc :uint] [:yin.code/tail? :bool]],\n   :return [],\n   :jump [[:yin.code/target :pc]],\n   :branch-false [[:yin.code/target :pc]],\n   :halt [],\n   :gensym [[:yin.code/prefix :str]],\n   :store-get [[:yin.code/key :data]],\n   :store-put [[:yin.code/key :data] [:yin.code/value :data]],\n   :stream-make [[:yin.code/buffer :buffer]],\n   :stream-put [],\n   :stream-cursor [],\n   :stream-next [],\n   :stream-close [],\n   :park [],\n   :resume [[:yin.code/parked-id :kw]],\n   :current-continuation [],\n   :ffi-call [[:yin.code/ffi-op :kw] [:yin.code/argc :uint]],\n   :define [[:yin.code/name :sym]]})\n\n\n(def ^:private operand-kind-checks\n(ns yin.vm.semantic-register.derive\n  \"Pure native derivations from the admitted semantic register vector A.\"\n  (:refer-clojure :exclude [resolve])\n  (:require [yin.vm.semantic-register.code :as code]\n            [yin.vm.debruijn :as db]\n            [yin.vm.semantic-register.analysis :as analysis]\n            [yin.vm.debruijn-register-code :as rcode]))\n\n\n(defn- chains\n  [v bodies]\n  (letfn [(chain\n            [i]\n            (if-let [owner (:owner (nth bodies i))]\n              (into [(nth (nth v owner) 2)]\n                    (chain (code/body-index bodies owner)))\n              []))]\n    (mapv chain (range (count bodies)))))\n\n\n(defn resolve\n  \"Rewrite only variables and closure binders. The result is an unhashed\n   stage value; pcs and virtual registers are preserved.\"\n  [v]\n  (let [bodies (code/parse v)\n        frames (chains v bodies)\n        names (volatile! {})]\n    {:vector\n     (mapv (fn [pc]\n             (let [[op rd x y :as t] (nth v pc)]\n               (case op\n                 :var (let [{:keys [bound free]}\n                            (db/resolve-name (nth frames (code/body-index bodies pc)) x)]\n                        (if bound\n                          (do (vswap! names assoc pc x)\n                              (into [:load-bound rd] bound))\n                          [:load-free rd free]))\n                 :closure [:closure rd (count x) y]\n                 t)))\n           (range (count v)))\n     :bodies bodies\n     :names @names}))\n\n\n(defn addresses\n  \"Lexical references in pc order, from A, a resolved vector or a native\n   instruction vector (register or stack). Returns a vector, no identity.\"\n  [v]\n  (let [v (if (map? v) (or (:vector v) (:instructions v)) v)\n        v (if (some #(= :var (first %)) v) (:vector (resolve v)) v)]\n    (into []\n          (keep (fn [t]\n                  (case (first t)\n                    :load-bound (into [:bound] (subvec t (- (count t) 2)))\n                    :load-free [:free (peek t)]\n                    nil)))\n          v)))\n\n\n(defn stack-image\n  \"Stackify A's parsed expressions, placing closure bodies in FIFO order.\n   Labels and diagnostics are derived solely from A.\"\n  [v]\n  (let [{rv :vector bodies :bodies} (resolve v)\n        by-start (into {} (map (juxt :start identity)) bodies)\n        image (volatile! [])\n        side (volatile! {})\n        labels (volatile! {})\n        queue (volatile! [])\n        counter (volatile! 0)\n        label! (fn [] (vswap! counter inc))\n        mark! (fn [l] (vswap! labels assoc l (count @image)))\n        emit! (fn [t] (vswap! image conj t))]\n    (letfn [(walk\n              [node]\n              (let [pc (:pc node)\n                    [op _ x y z] (nth rv pc)\n                    children (:children node)\n                    diagnostic! (fn [info] (vswap! side assoc (count @image) info))]\n                (case (:op node)\n                  :if (let [[c th el] children\n                            else (label!) end (label!)]\n                        (walk c) (emit! [:branch-false else])\n                        (walk th) (emit! [:jump end])\n                        (mark! else) (walk el) (mark! end))\n                  :closure (let [l (label!)]\n                             (vswap! queue conj [l (get by-start y)])\n                             (diagnostic! {:kind :closure :params (nth (nth v pc) 2) :source pc})\n                             (emit! [:closure x l]))\n                  :var (do (diagnostic! {:kind :var :source pc})\nsrc/cljc/yin/vm/ucf/rows.cljc:544:  \"The postponed groups to completion: the fixpoint, then the tie test on\ntest/yang/python/antlr/float_address_test.cljc:6:   every host. The goldens below were computed on the JVM; Node and Dart\ntest/yang/python/antlr/float_address_test.cljc:152:  (testing \"byte-identical on every host (JVM goldens)\"\ntest/yang/python/antlr/float_address_test.cljc:222:            host (JVM goldens; the prelude moved once with I1's module\ntest/yang/python/antlr/float_address_test.cljc:232:    (is (= :segment/blake3-2d387d0d4787a7222ad358d8d262d2d64b169162889461e84b954c1812074d08\ntest/yang/python/antlr/float_address_test.cljc:249:    (testing \"A, A' and the record: one address on every host (JVM goldens;\ntest/yang/python/antlr/float_address_test.cljc:452:    (testing \"repr, and one quiet NaN in the canonical bytes (JVM golden)\"\ntest/yang/python/antlr/int_literal_test.cljc:8:   value gives one row set, one byte string and one address (JVM goldens).\ntest/yang/python/antlr/int_literal_test.cljc:236:(def ^:private group-goldens\ntest/yang/python/antlr/int_literal_test.cljc:239:   :segment/blake3-cc540dcc7f75dd09fc505cf736e01a1227664102025c686382fc00524a02f609,\ntest/yang/python/antlr/int_literal_test.cljc:241:   :segment/blake3-b66fc53bd3f2c0258e3e5f92b430fc12447656dddb725a65fdb69f7c1f68a472,\ntest/yang/python/antlr/int_literal_test.cljc:243