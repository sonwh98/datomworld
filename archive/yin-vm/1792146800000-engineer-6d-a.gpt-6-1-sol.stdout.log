entry :bindings bindings)))))\n\n\n;; =============================================================================\n;; Link waits and the install child (yin.vm.linker.md sections 7.2 to 7.4)\n;; =============================================================================\n\n(def ^:private link-reasons\n  \"The wait reasons `require` adds: the two link states and the install.\"\n  #{:link-request :link-response :install})\n\n\n(defn- link-entry?\n  [entry]\n  (contains? link-reasons (:reason entry)))\n\n\n(defn- observe-entry?\n  \"True for a held observation (`:reason :observe`): a machine-only entry\n   the driver applies through `apply-observation`; the sweep never polls it.\"\n  [entry]\n  (= :observe (:reason entry)))\n      ;; C1-C3 across the entire continuation.\n      (some (fn [[f p]]\n              (when-not (contains? code-map (:yin.k/segment f))\n                (problem :segment (conj p :yin.k/segment)))) all)\n      (some (fn [[f p]]\n              (let [slot (if (and (empty? p) (not (or act? run?))) :yin.k/site :yin.k/pc)\n                    n (get f slot) v (get code-map (:yin.k/segment f))]\n                (cond\n                  (not (code/reg? n)) (problem :pc-kind (conj p slot))\n                  (not (and (< n (count v)) (or (= slot :yin.k/site) (and run? (empty? p)) (pos? n))))\n                  (problem :pc-bounds (conj p slot))))) all)\n","exit_code":0,"status":"completed"}}
