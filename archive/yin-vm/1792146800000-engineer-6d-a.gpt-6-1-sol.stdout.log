t lit1-id, :rows {lit1-id lit1-row, lit2-id lit2-row}}]}))\n\n\n(def malformed-ucf-row-sets\n  \"`{name [expected-refusal carrier]}` for the UCF row codec, separate\n   from the Universal AST row grammar in malformed-row-sets.\"\n  (let [task (rows/node :task\n                        [3 rows/profile :halted :root 0 (rows/node :bindings [])\n                         (rows/node :store []) [] (rows/node :parked-table [])\n                         (rows/node :cursor-cells [])\n                         {:yin.k/modules {} :yin.k/host-exports {}} {} [] [] nil\n                         [:row (rows/node :map [[:lit 1] [:lit :a]\n                                                [:lit (cbor/float64 1.0)] [:lit :b]])] nil])\n        wire (rows/emit-numbered task {})\n        id (first (first (filter #(= :map (second %)) (:yin.k/rows wire))))]\n    (into {:equality-collapse [{:yin.k/status :yin.k/undecodable\n                                :yin.k/kind :equality-collapse :yin.k/path [id]} wire]}\n          (map (fn [[label f]]\n                 (let [wire (rows/emit-numbered\n                              (-> task\n                                  (assoc-in [:slots 15] [:lit nil])\n(defn new-machine\n  ([] (new-machine {}))\n  ([opts]\n   (sr/create-vm (merge {:make-stream (make-det-stream)\n                         :capability-secret tu/secret\n                         :modules stream-modules\n                         :secret-source (fn [origin] (str tu/secret \"/\" (name origin)))}\n                        opts))))\n\n\n(defn load-ast\n  [machine ast]\n  (sr/load-vector machine (project ast) code/contract))\n\n\n;; =============================================================================\n;; Machines\n;; =============================================================================\n\n(ns yin.vm.ucf.rows-checkpoint-test\n  \"Phase 7a: the rows inspector over the shared canonical fixtures. Every\n   fixture's bytes are pinned by the pack address\n   test/resources/yin/vm/ucf/rows-checkpoint-v3.txt records for it, and\n   three anchors are read as frozen bytes, so a rule about integer kind or\n   key presence is checked on the bytes, never on a host number type. The\n   pack address (storage) and the root id (semantic) are tested apart.\"\n  (:require [clojure.test :refer [deftest is testing]]\n            [dao.jing :as jing]\n            [dao.jing.cbor :as cbor]\n            [dao.jing.cbor-fixtures :as fx]\n            [yin.vm.ucf.rows :as rows]\n            [yin.vm.ucf.rows-checkpoint-fixtures :as f]\n            [yin.vm.ucf.rows.checkpoint :as checkpoint]))\n\n\n(defn- inspect\n  [n]\n  (let [{:keys [address bytes]} (f/fixture n)]\n    (checkpoint/inspect address bytes)))\n\n\n(defn- intent-hex\n  [target payload]\n  (jing/digest-bytes :blake3 (cbor/encode [:yin.k/append target payload])))\n\n\n(defn- root-of\n  [n]\n  (:yin.k/root (f/pack-of n)))\n\n\n(deftest the-file-holds-exactly-the-declared-bytes\n  (is (= (f/render) (fx/read-path f/path))))\n\n\n;; =============================================================================\n;; Two identities: the pack address and the root id\n;; =============================================================================\n\n(deftest the-pack-address-is-storage-and-the-root-id-is-semantic\n  (doseq [n f/base-names\n          :let [{:keys [address bytes]} (f/fixture n)\n                wire (cbor/decode bytes)]]\n    (testing n\n","exit_code":0,"status":"completed"}}
