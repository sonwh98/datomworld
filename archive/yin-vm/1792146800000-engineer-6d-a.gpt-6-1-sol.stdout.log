{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/zsh -lc \"cat >> test/yin/vm/semantic/safepoint_harness_test.cljc <<'EOF'\n\n\n(defn fuel-drive\n  \\\"Drive to the next guest stop, observing each returned budget boundary.\\\"\n  [m observe]\n  (observe m)\n  (loop [m m n 0]\n    (when (> n 20000) (throw (ex-info \\\"Boundary driver failed to stop\\\" {:steps n})))\n    (let [next (sr/run-fuel m 1)]\n      (observe next)\n      (if (or (:control next) (seq (:ready-queue next)))\n        (recur next (inc n)) next))))\n\n\n(defn check-returned-boundaries\n  [cases]\n  (mapv (fn [[row segment _ build]]\n          (let [points (atom 0)\n                observe (fn [m]\n                          (swap\"'! points inc)\n                          (boundary-round-trip m))\n                expected (reference (build))\n                result (with-redefs [vm/run #(fuel-drive % observe)] (reference (build)))]\n            (is (= expected result) (str row \" \" segment))\n            [row segment @points])) cases))\n\n\n(deftest sampled-returned-boundaries\n  (let [cases (filterv #(contains? #{1 19 20 22} (first %)) (matrix-cases))\n        counts (check-returned-boundaries cases)]\n    (is (= 13 (count counts)))\n    (is (every? pos? (map #(nth % 2) counts)))))\n\n\n(deftest ''^:slow every-returned-boundary\n  (slow/guard \"every-returned-boundary\"\n    (fn []\n      (let [counts (check-returned-boundaries (matrix-cases))]\n        (is (= 89 (count counts)))\n        (println \"6d-a returned-boundary counts JVM:\" (pr-str counts))))))\nEOF\nclojure -M:test -e :slow -n yin.vm.semantic.safepoint-harness-test > /tmp/6da-boundaries.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
