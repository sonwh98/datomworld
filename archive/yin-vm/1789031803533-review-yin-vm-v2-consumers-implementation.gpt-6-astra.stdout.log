`) follow in the `yin.vm` plan; until they\n-land, asking for one is an error naming what is supported.\n+v1 defaulted to `:semantic`, until `yin.vm-consumers.implementation-plan.md`\n+deleted `:semantic`, `:register`, `:stack` and `:space` and migrated v1's\n+default to `:ast-walker` too. `:ast-walker` is now the only evaluator on\n+either REPL; asking for another is an error naming what is supported.\n \n **There is no `(telemetry)` command.** Telemetry is not part of the v2 slice\n in any form. `(telemetry)` is answered with a message naming the v1 REPL, and\ndiff --git a/test/yang/clojure_test.clj b/test/yang/clojure_test.clj\nindex 7023eb4..2f2608e 100644\n--- a/test/yang/clojure_test.clj\n+++ b/test/yang/clojure_test.clj\n@@ -311,3 +311,15 @@\n                                       (def use-f (fn [x] (f x)))\n                                       (def f (fn [x] (* x (* x x))))\n                                       (use-f 2)))))))\n+\n+\n+(deftest test-nested-defn-ast-walker\n+  (testing \"compile-program handles nested defn on the AST walker path\"\n+    (is (= 42\n+           (compile-program-and-run\n+             '((def make-adder\n+                 (fn [n]\n+                   (defn adder\n+                     [x]\n+                     (+ x n)) adder))\n+               ((make-adder 2) 40)))))))\ndiff --git a/test/yin/vm/runtime_regression_test.cljc b/test/yin/vm/runtime_regression_test.cljc\nindex 0b6b6ab..80c794e 100644\n--- a/test/yin/vm/runtime_regression_test.cljc\n+++ b/test/yin/vm/runtime_regression_test.cljc\n@@ -3,11 +3,7 @@\n             [dao.stream :as ds]\n             [dao.test-utils :as tu]\n             [yin.vm :as vm]\n-            [yin.vm.ast-walker :as ast-walker]\n             [yin.vm.engine :as engine]\n-            [yin.vm.register :as register]\n-            [yin.vm.semantic :as semantic]\n-            [yin.vm.stack :as stack]\n             [yin.vm.test-utils :as vtu]))\n \n \ndiff --git a/test/yin/vm/telemetry_test.cljc b/test/yin/vm/telemetry_test.cljc\nindex 588d451..8ef8a8c 100644\n--- a/test/yin/vm/telemetry_test.cljc\n+++ b/test/yin/vm/telemetry_test.cljc\n@@ -3,10 +3,7 @@\n             [dao.stream :as ds]\n             [dao.stream.ringbuffer]\n             [yin.vm :as vm]\n-            [yin.vm.ast-walker :as ast-walker]\n-            [yin.vm.register :as register]\n-            [yin.vm.semantic :as semantic]\n-            [yin.vm.stack :as stack]))\n+            [yin.vm.ast-walker :as ast-walker]))\n \n \n (defn- make-stream\n@@ -48,10 +45,7 @@\n \n \n (deftest eval-emits-step-and-halt-snapshots-across-cljc-vms-test\n-  (let [constructors {:ast-walker ast-walker/create-vm,\n-                      :semantic semantic/create-vm,\n-                      :stack stack/create-vm,\n-                      :register register/create-vm}]\n+  (let [constructors {:ast-walker ast-walker/create-vm}]\n     (doseq [[model create-vm] constructors]\n       (testing (str \"Telemetry covers \" model)\n         (let [telemetry-stream (make-stream)\ndiff --git a/test/yin/vm/test_utils.cljc b/test/yin/vm/test_utils.cljc\nindex b32b836..b7f45bf 100644\n--- a/test/yin/vm/test_utils.cljc\n+++ b/test/yin/vm/test_utils.cljc\n@@ -1,21 +1,13 @@\n (ns yin.vm.test-utils\n   (:require [dao.stream :as ds]\n             [yin.vm :as vm]\n-            [yin.vm.ast-walker :as ast-walker]\n-            [yin.vm.register :as register]\n-            [yin.vm.semantic :as semantic]\n-            [yin.vm.space :as space]\n-            [yin.vm.stack :as stack]))\n+            [yin.vm.ast-walker :as ast-walker]))\n \n \n (defn vm-factories\n   \"Returns a map of VM keywords to their creation functions.\"\n   []\n-  {:ast-walker ast-walker/create-vm,\n-   :semantic semantic/create-vm,\n-   :register register/create-vm,\n-   :space space/create-vm,\n-   :stack stack/create-vm})\n+  {:ast-walker ast-walker/create-vm})\n \n \n (defn run-all-vms\n12:import subprocess\n56:        res = subprocess.run(\n59:            stdout=subprocess.PIPE,\n60:            stderr=subprocess.PIPE,\n65:    except subprocess.CalledProcessError as e:\n66:        sys.stderr.write(f\"Git command failed: {' '.join(cmd)}\\nError: {e.stderr}\\n\")\n132:            r\"^\\+.*\\b(eval\\(|exec\\(|os\\.system\\(|subprocess\\.Popen\\(.*shell\\s*=\\s*True|dangerouslySetInnerHTML)\\b\",\n368:    analyze_parser.add_argument(\"--output\", help=\"Output file path (Markdown or JSON depending on format)\")\n376:        output = getattr(args, \"output\", None)\n388:            if output:\n389:                out_path = Path(output)\n390:                out_path.parent.mkdir(parents=True, exist_ok=True)\n391:                out_path.write_text(result, encoding=\"utf-8\")\n397:            sys.stderr.write(f\"Error during PR analysis: {e}\\n\")\n     1\t\n     2\t# yin.vm consumers — the deletion plan\n     3\t\n     4\tStatus: implementation plan for deleting the experimental v1 VM models\n     5\t(`yin.vm.{semantic, register, stack, space}`) and the macro engine\n     6\t(`yin.vm.macro`), with every file that requires them either deleted or\n     7\tmigrated so the build stays green. Subordinate to\n     8\t[`yin.vm.divergence-register.md`](./yin.vm.divergence-register.md),\n     9\t[`dao.runtime.implementation-plan.md`](./dao.runtime.implementation-plan.md)\n    10\tand [`dao.stream.md`](./dao.stream.md).\n    11\t\n    12\tRevised 2026-09-10, three architect rounds: r1 against a consumer sweep of\n    13\tthe tree, r2 against an independent adversarial review of r1, r3 against a\n    14\tconfirmation review of r2. The first draft named two files to check for\n    15\tstale references; the census now holds thirty-one. The revision history at\n    16\tthe end records what each round changed.\n    17\t\n    18\t## The problem and context\n    19\t\n    20\tThe divergence register scopes `yin.vm` to the ast-walker slice:\n    21\t\"`semantic`, `register`, `stack`, `space`, `macro` and `wasm` are not ported,\n    22\tso nothing here speaks for them\" (`yin.vm.divergence-register.md:20-21`).\n    23\tThe v2 corpus is macro-free by construction (its change 2), and `yin.repl`\n    24\tships one evaluator (its change 1). Porting the experimental models to\n    25\t`dao.stream` would be a rewrite of each for no consumer; they are deleted.\n    26\t\n    27\t`dao.stream.md:806-808` records the decision: \"The v1 VM lineage is deleted\n    28\trather than migrated, under `yin.vm-consumers.implementation-plan.md`,\n    29\tbecause a v2 twin already exists for every one of its consumers.\" This plan\n    30\tis the first slice of that deletion — the models that have no v2 twin and no\n    31\tplace in the ast-walker scope. It is not the whole v1 lineage; see *Boundary*.\n    32\t\n   382\t- `src/cljc/yin/vm/docs/yin.repl.md:81` (v1 REPL command table) and\n   383\t  `docs/design/yin-repl-design.md` (`:10`, `:60`, `:76`, `:121`, `:150-155`,\n   384\t  `:208`, `:249`, `:357-358`): the backend list and the `:semantic` default.\n   385\t- **[J]** `src/cljd/datomworld/demo/dao_gui.md:41`: the compile command names\n   386\t  `datomworld.main`, which does not exist; the entry namespace is\n   387\t  `datomworld.demo.main`. A one-word fix, made here because this plan's\n   388\t  verification leans on that document.\n   389\t\n   390\t**Criteria:**\n   391\t\n   392\t- `clj -M:test`, the shadow `:test` node build, and `clojure -M:cljd test`\n   393\t  all pass; the `:demo` browser build compiles.\n   394\t- `clj -M:clj-yin-repl` starts; `(vm :ast-walker)` and `(reset)` work;\n   395\t  `(vm :register)` reports the error naming `[:ast-walker]` as supported.\n   396\t- `clj -M -m yin.demo-v2` still prints 5050.\n   397\t- **Flutter startup smoke (D1 item 3) [R]:** compile the real entry point,\n   398\t  then run the app and take the picker route that reaches `start-server!`:\n   399\t  ```\n   400\t  mise exec -- clj -M:cljd compile dao.stream.ws yin.repl datomworld.demo.dao-gui datomworld.demo.main\n   401\t  flutter run\n   402\t  ```\n   403\t  In the running app, select **\"dao.gui Prototype\"** from the picker\n   404\t  (`main.cljd:40-49`); this calls `dao-gui/start!` → `start-server!`. The\n   405\t  server-status notifier must reach \"listening\"\n   406\t  (`repl/connection-status-text` with zero clients) rather than the app\n   407\t  raising \"Unknown Yin REPL VM type\". Opening the app alone does not exercise\n   408\t  the line; the selection step is the test.\n   409\t- `/demo.html#pipeline` renders the v2 pipeline with `#pipeline` still in the\n   410\t  address bar (D5); in it, a Python and a PHP example compile and run (D3).\n   411\t  The toolbar over the v2 pipeline shows only \"Datom.world\" and \"Back to\n   412\t  Demos\" — no \"Explainer Video\" button, no \"Layout\" selector.\n   413\t- All three Phase 0 sweeps return only hits under `docs/` and `collab/`, plus\n   414\t  the documented non-hits; the per-alias greps for the migrated files return\n   415\t  nothing.\n   416\t\n   417\t### Phase 2 — prose that names what was deleted\n   418\t\n   419\tHistorical documents get a one-line status note at the top, not a rewrite:\n   420\t\n   421\t- `docs/cesk-space-optimization.md` (already \"superseded\"; add that\n   422\t  `yin.vm.space` and the `:bench`/`:profile-*` aliases it cites are deleted)\n   423\t- `docs/design/yin.vm.streams-all-the-way-down.md:163,401` (names\n   424\t  `yin.vm.space` as \"closest to this shape\" and cites `clj -M:bench`)\n   425\t- `docs/cross-language-macro.md:46` (the design depends on\n   426\t  `yin.vm.macro/expand-all`, which no longer exists)\n   427\t- `docs/design/yin.vm-portability.md:217`\n   428\t- `src/cljc/yin/vm/docs/yin-defmacro.md` and `bytecode-vm-optimization.md`\n   429\t- `docs/agy-test.md:59,104` (proposes fuzzing a deleted wasm backend)\n   430\t\n      24\n(def code-examples\n  [{:name \"Clojure: Basic Math\", :lang :clojure, :code \"(+ 10 20)\"}\n   {:name \"Clojure: Closure Power\",\n    :lang :clojure,\n    :code\n    \"(defn make-power [e]\\n  (fn [b]\\n    (if (= e 0)\\n      1\\n      (* b ((make-power (- e 1)) b)))))\\n((make-power 3) 2)\"}\n   {:name \"Clojure: Factorial\",\n    :lang :clojure,\n    :code\n    \"(defn fact [n]\\n  (if (= n 0)\\n    1\\n    (* n (fact (- n 1)))))\\n(fact 5)\"}\n   {:name \"Clojure: Fibonacci\",\n    :lang :clojure,\n    :code\n    \"(defn fib [n]\\n  (if (< n 2)\\n    n\\n    (+ (fib (- n 1)) (fib (- n 2)))))\\n(fib 7)\"}\n   {:name \"Python: Basic Math\", :lang :python, :code \"10 + 20\"}\n   {:name \"Python: Closure Power\",\n    :lang :python,\n    :code\n    \"def make_power(e):\\n  return lambda b: 1 if e == 0 else b * (make_power(e - 1))(b)\\n(make_power(3))(2)\\n\"}\n   {:name \"Python: Factorial\",\n    :lang :python,\n    :code\n    \"def fact(n):\\n  if n == 0:\\n    return 1\\n  else:\\n    return n * fact(n-1)\\nfact(5)\"}\n   {:name \"Python: Fibonacci\",\n    :lang :python,\n    :code\n    \"def fib(n):\\n  if n < 2:\\n    return n\\n  else:\\n    return fib(n-1) + fib(n-2)\\nfib(7)\"}\n   {:name \"PHP: Basic Math\", :lang :php, :code \"10 + 20;\"}\n   {:name \"PHP: Closure Power\",\n    :lang :php,\n    :code\n    \"$makePower = function (int $exponent) {\\n  return function (int $base) use ($exponent): int {\\n    $result = 1;\\n    for ($i = 0; $i < $exponent; $i++) {\\n      $result *= $base;\\n    }\\n    return $result;\\n  };\\n};\\n$cube = $makePower(3);\\n$cube(2);\"}\n   {:name \"PHP: Factorial\",\n    :lang :php,\n    :code\n    \"function fact($n) {\\n  if ($n == 0) {\\n    return 1;\\n  } else {\\n    return $n * fact($n - 1);\\n  }\\n}\\nfact(5);\"}\n   {:name \"PHP: Fibonacci\",\n    :lang :php,\n    :code\n    \"function fib($n) {\\n  if ($n < 2) {\\n    return $n;\\n  } else {\\n    return fib($n - 1) + fib($n - 2);\\n  }\\n}\\nfib(7);\"}])\n\n","exit_code":0,"status":"completed"}}
