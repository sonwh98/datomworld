ion.cljc:65:(defn completed\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:73:(defn succeeded\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:81:(defn terminated\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:90:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:91:;; The report\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:92:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:94:(defn- successor-defect\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:116:(defn- refused\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:121:(defn- report-decision\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:147:(defn report!\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:178:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:179:;; Completion, in the release or policy lapse's transaction\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:180:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:182:(defn closure\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:208:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:209:;; Successor offers\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:210:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/completion.cljc:212:(defn offer-refusal\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:53:(defn- reply\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:60:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:61:;; Offers\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:62:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:64:(defn- offer-decision\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:95:(defn- store!\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:105:(defn offer!\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:140:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:141:;; The judge's writer: grants, lapses and refusals, each one transaction\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:142:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:144:(def ^:private ok {:dao.stream/outcome :dao.stream/ok})\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:146:(def ^:private invalid {:dao.stream/outcome :dao.stream/invalid-value})\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:149:(def ^:private transport-error\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:153:(def ^:private grant-terms\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:157:(defn- grant-decision\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:185:(defn- lapse-decision\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:212:(defn- refusal-decision\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:224:(defn- decision\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:240:(defn- append-fact!\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:258:(defn writer\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:283:(defn ready?\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:291:(defn- answer\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:334:(defn judge-config\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:349:(defn step!\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:356:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:357:;; Reopen (plan 1.5)\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:358:;; =============================================================================\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:360:(defn- live-leases\nsrc/cljc/yin/vm/ucf/authority/grant.cljc:369:(defn reopen!\nsrc/cljc/yin/