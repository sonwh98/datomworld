{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SBafUK74T9Ufnvy893AwMJ","type":"tool_result","content":"1\t(ns yin.vm.ucf.rows\n2\t  \"Version-3 row codec. Pure row construction, graph decoding and\n3\t   discovery-order cursor-cell numbering (design note §1), then full task\n4\t   transport for the semantic-register kernel (continuation design §7):\n5\t   lift-task walks a quiescent machine into an abstract task and emits it;\n6\t   lower-task decodes, checks and restores one into a fresh receiver.\n7\t   An abstract row is {:kind keyword :slots vector}. Structural references\n8\t   contain abstract rows; values use [:lit d], [:row abstract-row], [:cursor-cell id].\n9\t   A task's :cursor-cells row holds alternating source identities and :cursor-cell-body\n10\t   rows. Install children are separate tasks with separate cursor-cell scopes.\n11\t\n12\t   The census is ordered numerically by n (draft §3, \\\"sorted by n\\\"), so\n13\t   :yin.k/cc-10 follows :yin.k/cc-9; its keys must spell cc-N with no leading\n14\t   zero, else :slot-kind.\n15\t\n16\t   Default value markers are plain maps {:yin.k/row abstract-row} and\n17\t   {:yin.k/cursor-cell keyword}. A guest map whose sole key is :yin.k/row or\n18\t   :yin.k/cursor-cell collides with them and is not portable: on encode and decode\n19\t   every literal of that shape is refused :yin.k/non-portable. Explicit\n20\t   markers use the caller value encoder.\"\n21\t  (:require [dao.jing :as jing]\n22\t            [dao.jing.cbor :as cbor]\n23\t            [dao.stream.apply :as apply2]\n24\t            [yin.vm :as vm]\n25\t            [yin.vm.engine :as engine]\n26\t            [yin.vm.module :as module]\n27\t            [yin.vm.values :as values]\n28\t            [yin.vm.semantic-register.analysis :as analysis]\n29\t            [yin.vm.semantic-register.code :as code]\n30\t            [yin.vm.semantic-register.frame :as frame]\n31\t            [yin.vm.semantic-register.scan :as scan]\n32\t            [yin.vm.ucf.remote :as remote]))\n33\t\n34\t\n35\t(def profile {:yin.code/contract \"v4\" :yin.k/version 1})\n36\t\n37\t\n38\t(def pending-table\n39\t  {:next [:C]\n40\t   :put [[:ref :stream] :V :D]\n41\t   :ffi [:C :D :D]\n42\t   :ffi-request [:D :V [:ref :stream] [:ref :stream] :C :D]\n43\t   :link-request [:D :S [:ref :stream] [:ref :stream] :C :D :D]\n44\t   :link-response [:D :S [:ref :stream] [:ref :stream] :C]\n45\t   :install [:S]})\n46\t\n47\t\n48\t(def row-table\n49\t  \"Slot descriptors, excluding id and kind. :repeat/:pairs are variadic;\n50\t   :refs is an ordered vector of structural references. :pending is\n51\t   discriminated by pending-table. Nothing in this table is executable.\"\n52\t  {:vec [:repeat :V] :list [:repeat :V] :set [:repeat :V]\n53\t   :map [:pairs :V :V] :bindings [:pairs :S :V] :store [:pairs :D :V]\n54\t   :env [[:ref :bindings] :optional-D]\n55\t   :closure [:A :N :syms [:ref :bindings] :optional-D]\n56\t   :prim [:S] :stream [:D :D] :reified [[:ref :act]] :parked-ref [:D]\n57\t   :act [:A :N [:ref :env] [:ref :window] [:ref :k] :N]\n58\t   :tail [:A :N [:ref :k]]\n59\t   :window [:pairs :N :V] :k [:repeat [:ref :kframe]]\n60\t   :kframe [:A :N [:ref :env] [:ref :window] :N]\n61\t   :wait [[:ref :act :tail] [:ref :pending]] :pending :pending\n62\t   :module-store [:D [:ref :store]]\n63\t   :parked-table [:pairs :D [:ref :act :tail]]\n64\t   :install [:S :D :D :D [:ref :task]]\n65\t   :cursor-cells [:pairs :C [:ref :cursor-cell-body]] :cursor-cell-body [[:ref :stream] :D]\n66\t   :task [:N :D :D :D :N [:ref :bindings] [:ref :store]\n67\t          [:refs :module-store] [:ref :parked-table] [:ref :cursor-cells]\n68\t          :D :D [:refs :install] [:refs :wait] :optional-D :optional-V :optional-D]})\n69\t\n70\t\n71\t(defn node\n72\t  [kind slots]\n73\t  {:kind kind :slots (if (= :window kind)\n74\t                       (vec (mapcat identity (sort-by first (partition 2 slots))))\n75\t                       (vec slots))})\n76\t\n77\t\n78\t(defn- refuse!\n79\t  [status kind path]\n80\t  (throw (ex-info \"Row codec refused data\"\n81\t                  {:yin.k/status status :yin.k/kind kind :yin.k/path path})))\n82\t\n83\t\n84\t(defn- bad!\n85\t  [kind path]\n86\t  (refuse! :yin.k/undecodable kind path))\n87\t\n88\t\n89\t(defn- marker-shaped?\n90\t  [x]\n91\t  (and (map? x) (= 1 (count x)) (or (contains? x :yin.k/row) (contains? x :yin.k/cursor-cell))))\n92\t\n93\t\n94\t(defn- check-literal-markers!\n95\t  [x]\n96\t  (when (marker-shaped? x) (refuse! :yin.k/non-portable :marker []))\n97\t  (when (coll? x)\n98\t    (doseq [v (if (map? x) (mapcat identity x) x)] (check-literal-markers! v)))\n99\t  (when (meta x) (check-literal-markers! (meta x))))\n100\t\n101\t\n102\t(defn- bytes-key\n103\t  [bs]\n104\t  ;; Unsigned bytewise order, without a length-first comparison.\n105\t  (mapv #(bit-and (int %) 255) (seq bs)))\n106\t\n107\t\n108\t(defn- compare-bytes\n109\t  [a b]\n110\t  (loop [i 0]\n111\t    (cond\n112\t      (= i (count a)) (if (= i (count b)) 0 -1)\n113\t      (= i (count b)) 1\n114\t      (= (nth a i) (nth b i)) (recur (inc i))\n115\t      :else (compare (nth a i) (nth b i)))))\n116\t\n117\t\n118\t(defn- byte-compare\n119\t  [a b]\n120\t  (compare-bytes (bytes-key (cbor/encode a)) (bytes-key (cbor/encode b))))\n121\t\n122\t\n123\t(defn- sorted-bytes\n124\t  [xs]\n125\t  (vec (sort byte-compare xs)))\n126\t\n127\t\n128\t(defn- descriptors\n129\t  [kind slots]\n130\t  ;; :entry is the numbering's synthetic map entry [:entry k v], never a carrier row.\n131\t  (let [schema (if (= :entry kind) [:V :V] (get row-table kind))]\n132\t    (cond\n133\t      (= schema :pending) (into [:D] (get pending-table (first slots)))\n134\t      (= :repeat (first schema)) (vec (repeat (count slots) (second schema)))\n135\t      (= :pairs (first schema)) (vec (take (count slots) (cycle (rest schema))))\n136\t      :else schema)))\n137\t\n138\t\n139\t(defn- ref?\n140\t  [d]\n141\t  (and (vector? d) (= :ref (first d))))\n142\t\n143\t\n144\t(defn- refs?\n145\t  [d]\n146\t  (and (vector? d) (= :refs (first d))))\n147\t\n148\t\n149\t(def ^:private census-key #\"cc-([1-9][0-9]*)\")\n150\t\n151\t\n152\t(defn- census-order\n153\t  ;; Numeric order of cc-N without reading wire data: fewer digits first,\n154\t  ;; then the digits. Other keys (a partial emit-numbered) sort last.\n155\t  [k]\n156\t  (let [digits (when (keyword? k) (second (re-matches census-key (name k))))]\n157\t    (if digits [0 (count digits) digits] [1 0 (str k)])))\n158\t\n159\t\n160\t(defn- ordered-slots\n161\t  [kind slots]\n162\t  (cond\n163\t    (= kind :window) (vec (mapcat identity (sort-by first (partition 2 slots))))\n164\t    (= kind :cursor-cells) (vec (mapcat identity (sort-by #(census-order (first %)) (partition 2 slots))))\n165\t    (contains? #{:map :bindings :store :parked-table} kind)\n166\t    (vec (mapcat identity (sort #(byte-compare (first %1) (first %2)) (partition 2 slots))))\n167\t    (= kind :set) (sorted-bytes slots)\n168\t    :else slots))\n169\t\n170\t\n171\t(def default-budget\n172\t  \"Local resource bounds, independent of canonical bytes. :work counts the\n173\t   numbering's positions and the representation bound of every value it\n174\t   encodes for a comparison (design note §1.5).\"\n175\t  {:rows 10000 :cursor-cells 64 :depth 256 :work 4194304 :bytes 16777216})\n176\t\n177\t\n178\t(declare emit-node canonical-numbering child-numberer validate-frames)\n179\t\n180\t\n181\t(defn- emit-slot\n182\t  [d x numbering rows path number-child]\n183\t  (when-not (or (ref? d) (refs? d) (= :C d))\n184\t    (check-literal-markers! (if (contains? #{:V :optional-V} d)\n185\t                              (when (= :lit (first x)) (second x)) x)))\n186\t  (cond\n187\t    (ref? d) (emit-node x numbering rows path number-child)\n188\t    (refs? d) (reduce (fn [[out rs] [j n]]\n189\t                        (let [p (conj path (if (= :install (:kind n)) (first (:slots n)) j))\n190\t                              [id rs'] (emit-node n numbering rs p number-child)]\n191\t                          [(conj out id) rs']))\n192\t                      [[] rows] (map-indexed vector x))\n193\t    (= d :C) [(get numbering x x) rows]\n194\t    (contains? #{:V :optional-V} d)\n195\t    (case (first x)\n196\t      :row (let [[id rs] (emit-node (second x) numbering rows path number-child)] [[:row id] rs])\n197\t      :cursor-cell [[:cursor-cell (get numbering (second x) (second x))] rows]\n198\t      [x rows])\n199\t    :else [x rows]))\n200\t\n201\t\n202\t(defn- emit-node\n203\t  ;; path is the row path of n, so a child's refusal reports [12 <install name> ...].\n204\t  ([n numbering rows] (emit-node n numbering rows [] (child-numberer default-budget)))\n205\t  ([n numbering rows path number-child]\n206\t   (let [{:keys [kind slots]} n\n207\t         ;; A child is canonicalized in its own identity scope.\n208\t         [slots rows] (reduce (fn [[out rs] [i d x]]\n209\t                                (if (and (ref? d) (= :task (:kind x)))\n210\t                                  (let [[id child-rows] (emit-node x (number-child x path) {} path number-child)]\n211\t                                    [(conj out id) (merge rs child-rows)])\n212\t                                  (let [[x' rs'] (emit-slot d x numbering rs (conj path i) number-child)]\n213\t                                    [(conj out x') rs'])))\n214\t                              [[] rows] (map vector (range) (descriptors kind slots) slots))\n215\t         slots (if (= kind :task)\n216\t                 (-> slots\n217\t                     (update 7 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %)))\n218\t                     (update 12 #(vec (sort (fn [a b] (byte-compare (nth (get rows a) 2) (nth (get rows b) 2))) %))))\n219\t                 (ordered-slots kind slots))\n220\t         body (into [kind] slots) id (jing/segment-key body)]\n221\t     [id (assoc rows id (into [id] body))])))\n222\t\n223\t\n224\t(defn- spend!\n225\t  [counter budget category amount]\n226\t  (let [n (get (swap! counter update category (fnil + 0) amount) category)]\n227\t    (when (> n (get budget category))\n228\t      (refuse! :yin.k/unsupported :resource-limit [category]))))\n229\t\n230\t\n231\t;; Discovery-order cursor-cell numbering (design note\n232\t;; yin.vm.semantic-register-vm.cursor-cell-numbering.md §1). A cursor cell is\n233\t;; named by the order in which a fixed pre-order walk of the task meets it. A\n234\t;; guest :set or :map is entered as the vector of its members sorted by key:\n235\t;; the member's spelling by a key walk, numbered cursor cells by number and\n236\t;; the others by local first-occurrence index, body rank and occurrence\n237\t;; count. Members with equal keys form a tie group, postponed and re-keyed\n238\t;; until a pass numbers nothing; a surviving group is entered in host order\n239\t;; only when the tie test proves that harmless, else the lift refuses\n240\t;; :unresolved-cursor-cells.\n241\t\n242\t\n243\t(defn- work!\n244\t  [ctx amount]\n245\t  (spend! (:counter ctx) (:budget ctx) :work amount))\n246\t\n247\t\n248\t(defn- charge-representation!\n249\t  \"Charge to :work, before x is CBOR-encoded for a comparison, a conservative\n250\t   bound of its representation: 128 per node or scalar, 4 per character, 16\n251\t   plus the length per byte payload, metadata included. Iterative, against\n252\t   the budget remaining at the call: it stops as soon as its running total\n253\t   exceeds that, so it never reads to the end of a value it cannot afford.\"\n254\t  [ctx x]\n255\t  (let [{:keys [counter budget]} ctx\n256\t        remaining (- (:work budget) (get @counter :work 0))]\n257\t    (loop [stack (list (list x)) total 0 steps 0]\n258\t      (if (empty? stack)\n259\t        (do (swap! counter update :estimator-steps (fnil + 0) steps)\n260\t            (work! ctx total))\n261\t        (let [s (first stack) stack (rest stack)]\n262\t          (if (empty? s)\n263\t            (recur stack total steps)\n264\t            (let [x (first s)\n265\t                  stack (cons (rest s) stack)\n266\t                  total (+ total (cond\n267\t                                   (cbor/byte-payload? x) (+ 16 #?(:cljd (.-length x) :default (alength x)))\n268\t                                   (string? x) (+ 128 (* 4 (count x)))\n269\t                                   (or (keyword? x) (symbol? x)) (+ 128 (* 4 (count (str x))))\n270\t                                   :else 128))]\n271\t              (if (> total remaining)\n272\t                (do (swap! counter update :estimator-steps (fnil + 0) (inc steps))\n273\t                    (work! ctx total))\n274\t                (recur (cond->> stack\n275\t                         (coll? x) (cons (if (map? x) (mapcat identity x) (seq x)))\n276\t                         (meta x) (cons (list (meta x))))\n277\t                       total (inc steps))))))))))\n278\t\n279\t\n280\t(defn- key-bytes!\n281\t  \"Every comparison encoding of the numbering: charged, then encoded.\"\n282\t  [ctx x]\n283\t  (charge-representation! ctx x)\n284\t  (bytes-key (cbor/encode x)))\n285\t\n286\t\n287\t(defn- sort-by-key!\n288\t  \"xs in the bytewise order of (f x), each encoded once.\"\n289\t  [ctx f xs]\n290\t  (mapv second (sort #(compare-bytes (first %1) (first %2))\n291\t                     (mapv (fn [x] [(key-bytes! ctx (f x)) x]) xs))))\n292\t\n293\t\n294\t(def ^:private keyed-structural #{:bindings :store :parked-table})\n295\t\n296\t\n297\t(defn- value-slot?\n298\t  [d]\n299\t  (contains? #{:V :optional-V} d))\n300\t\n301\t\n302\t(defn- child-task?\n303\t  [ctx n]\n304\t  (and (= :task (:kind n)) (not (identical? n (:task ctx)))))\n305\t\n306\t\n307\t(defn- elem-item\n308\t  ;; A :set member is its V; a :map entry is the synthetic ordered row\n309\t  ;; [:entry k v], so the alias pattern across key and value is in its key.\n310\t  [kind e]\n311\t  (if (= :map kind) [:row (node :entry e)] e))\n312\t\n313\t\n314\t(defn- depth-scan!\n315\t  \"The :depth gate, before any recursive traversal of the task: one pre-order\n316\t   scan with an explicit stack over rows, members, structural and literal\n317\t   data and the census, install children skipped (each is gated by its own\n318\t   numbering). A position's depth is its slot steps from the task (a member\n319\t   step counts one, a map entry's key or value two) plus, inside data, its\n320\t   collection nesting. Each position costs one :work unit, charged when it\n321\t   is popped, before any work proportional to it.\"\n322\t  [ctx task]\n323\t  (let [limit (:depth (:budget ctx))\n324\t        row (fn [n k] [:row nil n k])\n325\t        slot (fn [d v k] [:slot d v k])\n326\t        data (fn [v k] [:data nil v k])]\n327\t    (loop [stack (list (list (row task 0)))]\n328\t      (when (seq stack)\n329\t        (let [s (first stack) stack (rest stack)]\n330\t          (if (empty? s)\n331\t            (recur stack)\n332\t            (let [[tag d x k] (first s)\n333\t                  stack (cons (rest s) stack)]\n334\t              (work! ctx 1)\n335\t              (when (> k limit) (refuse! :yin.k/unsupported :resource-limit [:depth]))\n336\t              (recur\n337\t                (cons\n338\t                  (case tag\n339\t                    :row\n340\t                    (let [{:keys [kind slots]} x k' (inc k)]\n341\t                      (when-not (child-task? ctx x)\n342\t                        (let [ds (descriptors kind slots)]\n343\t                          (cond\n344\t                            (= :task kind)\n345\t                            (mapcat (fn [i d v]\n346\t                                      (if (contains? #{7 12} i)\n347\t                                        (map (fn [child] (row child (inc k'))) v)\n348\t                                        [(slot d v k')]))\n349\t                                    (range) ds slots)\n350\t                            (contains? keyed-structural kind)\n351\t                            (mapcat (fn [[key v]] [(data key k') (slot (second ds) v k')]) (partition 2 slots))\n352\t                            (= :window kind)\n353\t                            (mapcat (fn [[r v]] [(data r k') (slot :V v k')]) (partition 2 slots))\n354\t                            (= :set kind) (map (fn [v] (slot :V v k')) slots)\n355\t                            (= :map kind)\n356\t                            (mapcat (fn [[a b]] [(slot :V a (inc k')) (slot :V b (inc k'))]) (partition 2 slots))\n357\t                            :else (map (fn [d v] (slot d v k')) ds slots)))))\n358\t                    :slot\n359\t                    (cond\n360\t                      (ref? d) [(row x k)]\n361\t                      (refs? d) (map (fn [n] (row n (inc k))) x)\n362\t                      (= :C d) nil\n363\t                      (value-slot? d) (when x\n364\t                                        (case (first x)\n365\t                                          :cursor-cell nil\n366\t                                          :row [(row (second x) k)]\n367\t                                          :lit [(data (second x) k)]\n368\t                                          [(data x k)]))\n369\t                      :else [(data x k)])\n370\t                    :data\n371\t                    (concat (when (coll? x) (map (fn [e] (data e (inc k))) (if (map? x) (mapcat identity x) x)))\n372\t                            (when (meta x) [(data (meta x) (inc k))])))\n373\t                  stack)))))))))\n374\t\n375\t\n376\t(defn- walk-cells\n377\t  \"Call f on the cursor cell at every position under slot (d x), the census\n378\t   and install children excluded; one :work unit per position. Recursive,\n379\t   so it runs only after the depth scan.\"\n380\t  [ctx d x f]\n381\t  (letfn [(slot\n382\t            [d x]\n383\t            (work! ctx 1)\n384\t            (cond\n385\t              (ref? d) (row x)\n386\t              (refs? d) (doseq [n x] (row n))\n387\t              (= :C d) (f x)\n388\t              (value-slot? d) (when x\n389\t                                (case (first x)\n390\t                                  :cursor-cell (f (second x))\n391\t                                  :row (row (second x))\n392\t                                  nil))\n393\t              :else nil))\n394\t          (row\n395\t            [n]\n396\t            (when-not (or (= :cursor-cells (:kind n)) (child-task? ctx n))\n397\t              (doseq [[d x] (map vector (descriptors (:kind n) (:slots n)) (:slots n))] (slot d x))))]\n398\t    (slot d x)))\n399\t\n400\t\n401\t(defn- item-cells\n402\t  \"The cursor cells under slot (d x), memoized per numbering on the slot.\"\n403\t  [ctx d x]\n404\t  (or (get @(:cells-memo ctx) [d x])\n405\t      (let [acc (atom #{})]\n406\t        (walk-cells ctx d x #(swap! acc conj %))\n407\t        (swap! (:cells-memo ctx) assoc [d x] @acc)\n408\t        @acc)))\n409\t\n410\t\n411\t(defn- body-ranks\n412\t  \"Cursor cell -> rank of its body label [:body [:stream identity\n413\t   descriptor] position] among the census's distinct labels in bytewise\n414\t   order, so a key never repeats a descriptor.\"\n415\t  [ctx bodies]\n416\t  (let [labels (into {} (map (fn [[c b]]\n417\t                               (let [[stream position] (:slots b)]\n418\t                                 [c [:body (into [:stream] (:slots stream)) position]])))\n419\t                     bodies)\n420\t        ranks (into {} (map-indexed (fn [i l] [l i]) (sort-by-key! ctx identity (distinct (vals labels)))))]\n421\t    (into {} (map (fn [[c l]] [c (get ranks l)])) labels)))\n422\t\n423\t\n424\t(defn- new-run\n425\t  [ctx num tag start]\n426\t  {:ctx ctx :num (atom num) :tag tag :next (atom start)\n427\t   :groups (atom []) :gid (atom 0) :refused (atom nil)})\n428\t\n429\t\n430\t(defn- meet!\n431\t  \"W2: a cursor cell met for the first time receives the run's next number.\"\n432\t  [run c]\n433\t  (when-not (contains? @(:num run) c)\n434\t    (swap! (:num run) assoc c [(:tag run) @(:next run)])\n435\t    (swap! (:next run) inc)))\n436\t\n437\t\n438\t(declare enter-node! unordered! key-walk spell-slot spell-node)\n439\t\n440\t\n441\t(defn- enter-slot!\n442\t  [run d x path]\n443\t  (let [ctx (:ctx run)]\n444\t    (work! ctx 1)\n445\t    (when (> (count path) (:depth (:budget ctx)))\n446\t      (refuse! :yin.k/unsupported :resource-limit [:depth]))\n447\t    (cond\n448\t      (ref? d) (enter-node! run x path)\n449\t      (refs? d) (doseq [[i n] (map-indexed vector x)] (enter-node! run n (conj path i)))\n450\t      (= :C d) (meet! run x)\n451\t      (value-slot? d) (when x\n452\t                        (case (first x)\n453\t                          :cursor-cell (meet! run (second x))\n454\t                          :row (enter-node! run (second x) path)\n455\t                          nil))\n456\t      :else nil)))\n457\t\n458\t\n459\t(defn- enter-node!\n460\t  \"W1: pre-order in table order; ordered repeated slots in order; keyed\n461\t   structural rows, installs and module stores in the byte order of the\n462\t   key; :window in register order; :set and :map by member keys, ties\n463\t   postponed; the census and install children are not entered.\"\n464\t  [run n path]\n465\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n466\t    (cond\n467\t      (or (= :cursor-cells kind) (child-task? ctx n)) nil\n468\t      (= :task kind)\n469\t      (doseq [[i d x] (map vector (range) ds slots)]\n470\t        (if (contains? #{7 12} i)\n471\t          (doseq [child (sort-by-key! ctx #(first (:slots %)) x)]\n472\t            (enter-node! run child (conj path i (first (:slots child)))))\n473\t          (enter-slot! run d x (conj path i))))\n474\t      (contains? keyed-structural kind)\n475\t      (doseq [[k v] (sort-by-key! ctx first (partition 2 slots))]\n476\t        (enter-slot! run (second ds) v (conj path k)))\n477\t      (= :window kind)\n478\t      (doseq [[r v] (sort-by first (partition 2 slots))] (enter-slot! run :V v (conj path r)))\n479\t      (= :set kind) (unordered! run n :set (vec slots) path)\n480\t      (= :map kind) (unordered! run n :map (mapv vec (partition 2 slots)) path)\n481\t      :else (doseq [[i d x] (map vector (range) ds slots)] (enter-slot! run d x (conj path i))))))\n482\t\n483\t\n484\t(defn- unordered!\n485\t  \"Key every member by a key walk under the numbering at this moment; enter\n486\t   members with a unique key in key order and postpone each run of equal\n487\t   keys, a tie group, to the run's queue. A member's path is the\n488\t   container's path plus :member: no index into an unordered container is\n489\t   canonical.\"\n490\t  [run container kind elems path]\n491\t  (let [ctx (:ctx run)\n492\t        keyed (mapv (fn [e]\n493\t                      ;; One unit per member keyed, so key walks and memo lookups are charged.\n494\t                      (work! ctx 1)\n495\t                      [(key-walk run (elem-item kind e) (conj path :member)) e])\n496\t                    elems)\n497\t        groups (partition-by (comp :bytes first)\n498\t                             (sort #(compare-bytes (:bytes (first %1)) (:bytes (first %2))) keyed))]\n499\t    (doseq [g groups]\n500\t      (if (= 1 (count g))\n501\t        (enter-slot! run :V (elem-item kind (second (first g))) (conj path :member))\n502\t        (swap! (:groups run) conj {:id (swap! (:gid run) inc) :container container :kind kind :path path\n503\t                                   :key (:spell (first (first g))) :complete? (:complete? (first (first g)))\n504\t                                   :elems (mapv second g)})))))\n505\t\n506\t\n507\t(defn- fixpoint!\n508\t  \"W3: re-key the postponed groups under the current numbering, in queue\n509\t   order; repeat while a pass numbers a cursor cell and groups remain.\"\n510\t  [run]\n511\t  (loop []\n512\t    (let [before (count @(:num run)) groups @(:groups run)]\n513\t      (reset! (:groups run) [])\n514\t      (doseq [{:keys [container kind elems path]} groups] (unordered! run container kind elems path))\n515\t      (when (and (seq @(:groups run)) (> (count @(:num run)) before)) (recur)))))\n516\t\n517\t\n518\t(defn- unnumbered-cells\n519\t  [run kind e]\n520\t  (let [num @(:num run)]\n521\t    (set (remove #(contains? num %) (item-cells (:ctx run) :V (elem-item kind e))))))\n522\t\n523\t\n524\t(defn- tie-failure\n525\t  \"The tie test, nil when the group passes: its common key is complete, and\n526\t   its members' unnumbered cursor cells are pairwise disjoint and occur in\n527\t   no member of another surviving group.\"\n528\t  [run groups g]\n529\t  (let [own (mapv #(unnumbered-cells run (:kind g) %) (:elems g))\n530\t        others (reduce (fn [acc h]\n531\t                         (if (= (:id h) (:id g))\n532\t                           acc\n533\t                           (reduce #(into %1 (unnumbered-cells run (:kind h) %2)) acc (:elems h))))\n534\t                       #{} groups)]\n535\t    (cond\n536\t      (not (:complete? g)) :incomplete-key\n537\t      (not= (reduce + (map count own)) (count (reduce into #{} own))) :shared-within-group\n538\t      (some (fn [cells] (some #(contains? others %) cells)) own) :shared-across-groups\n539\t      :else nil)))\n540\t\n541\t\n542\t(defn- resolve!\n543\t  \"The postponed groups to completion: the fixpoint, then the tie test on\n544\t   every surviving group. All pass: enter them in host order and repeat. Any\n545\t   fails: the root walk refuses; a key walk leaves them as [:tie ...] residue.\"\n546\t  [run]\n547\t  (loop []\n548\t    (fixpoint! run)\n549\t    (let [groups @(:groups run)]\n550\t      (when (seq groups)\n551\t        (let [failing (filterv #(tie-failure run groups %) groups)]\n552\t          (cond\n553\t            (empty? failing)\n554\t            ;; Passing groups are independent (their cursor cells are\n555\t            ;; confined), so all are entered before the next pass.\n556\t            (do (reset! (:groups run) [])\n557\t                (doseq [g groups e (:elems g)]\n558\t                  (enter-slot! run :V (elem-item (:kind g) e) (conj (:path g) :member)))\n559\t                (recur))\n560\t            (= :n (:tag run))\n561\t            (reset! (:refused run)\n562\t                    {:path (:path (first failing))\n563\t                     :cursor-cells (vec (sort-by str (distinct (mapcat (fn [g] (mapcat #(unnumbered-cells run (:kind g) %) (:elems g)))\n564\t                                                                       failing))))})\n565\t            :else nil))))))\n566\t\n567\t\n568\t(defn- key-walk\n569\t  \"A member's key: the walk over the member from the enclosing walk's\n570\t   numbering, local numbers counted on from an enclosing key walk's counter,\n571\t   spelled under its final numbering. Memoized on the member, the numbering\n572\t   of its cursor cells and the counter.\"\n573\t  [run item path]\n574\t  (let [ctx (:ctx run)\n575\t        cells (item-cells ctx :V item)\n576\t        num @(:num run)\n577\t        start (if (= :u (:tag run)) @(:next run) 0)\n578\t        memo-key [item (select-keys num cells) start]]\n579\t    (or (get @(:memo ctx) memo-key)\n580\t        (let [sub (new-run ctx num :u start)]\n581\t          (work! ctx (count cells))\n582\t          (enter-slot! sub :V item path)\n583\t          (resolve! sub)\n584\t          (let [spelling (spell-slot sub :V item path)\n585\t                k {:spell spelling :bytes (key-bytes! ctx spelling) :complete? (empty? @(:groups sub))}]\n586\t            (swap! (:memo ctx) assoc memo-key k)\n587\t            k)))))\n588\t\n589\t\n590\t(defn- spell-cell\n591\t  [run c]\n592\t  (let [ctx (:ctx run) [tag k] (get @(:num run) c)]\n593\t    (case tag\n594\t      :n [:cursor-cell [:n k]]\n595\t      :u [:cursor-cell [:u k (get (:ranks ctx) c) (get (:counts ctx) c)]]\n596\t      (throw (ex-info \"Spelling an unnumbered cursor cell\" {:cursor-cell c})))))\n597\t\n598\t\n599\t(defn- spell-slot\n600\t  [run d x path]\n601\t  (work! (:ctx run) 1)\n602\t  (cond\n603\t    (ref? d) (spell-node run x path)\n604\t    (refs? d) (vec (map-indexed (fn [i n] (spell-node run n (conj path i))) x))\n605\t    (= :C d) (spell-cell run x)\n606\t    (value-slot? d) (if (nil? x)\n607\t                      x\n608\t                      (case (first x)\n609\t                        :cursor-cell (spell-cell run (second x))\n610\t                        :row [:row (spell-node run (second x) path)]\n611\t                        x))\n612\t    :else x))\n613\t\n614\t\n615\t(defn- spell-node\n616\t  \"Literals and structural data as themselves (by reference), rows expanded\n617\t   in place, keyed rows in key order, a :set or :map as the sorted vector of\n618\t   its members' spellings with each surviving tie group as [:tie K ... K].\"\n619\t  [run n path]\n620\t  (let [{:keys [kind slots]} n ctx (:ctx run) ds (descriptors kind slots)]\n621\t    (cond\n622\t      (= :cursor-cells kind) [:cursor-cells]\n623\t      (child-task? ctx n) [:child]\n624\t      (= :task kind)\n625\t      (into [kind] (map (fn [i d x]\n626\t                          (if (contains? #{7 12} i)\n627\t                            (sort-by-key! ctx #(nth % 1) (mapv #(spell-node run % (conj path i (first (:slots %)))) x))\n628\t                            (spell-slot run d x (conj path i))))\n629\t                        (range) ds slots))\n630\t      (contains? keyed-structural kind)\n631\t      (into [kind] (mapcat identity (sort-by-key! ctx first\n632\t                                                  (mapv (fn [[k v]] [k (spell-slot run (second ds) v (conj path k))])\n633\t                                                        (partition 2 slots)))))\n634\t      (= :window kind)\n635\t      (into [kind] (mapcat (fn [[r v]] [r (spell-slot run :V v (conj path r))]) (sort-by first (partition 2 slots))))\n636\t      (contains? #{:set :map} kind)\n637\t      (let [elems (if (= :set kind) (vec slots) (mapv vec (partition 2 slots)))\n638\t            tied (filterv #(identical? n (:container %)) @(:groups run))\n639\t            tied-elems (set (mapcat :elems tied))\n640\t            plain (into [] (keep (fn [e]\n641\t                                   (when-not (contains? tied-elems e)\n642\t                                     (spell-slot run :V (elem-item kind e) (conj path :member)))))\n643\t                        elems)\n644\t            ties (mapv #(into [:tie] (repeat (count (:elems %)) (:key %))) tied)]\n645\t        (into [kind] (sort-by-key! ctx identity (into plain ties))))\n646\t      :else (into [kind] (map (fn [i d x] (spell-slot run d x (conj path i))) (range) ds slots)))))\n647\t\n648\t\n649\t(defn- discovery-numbering\n650\t  \"The root walk: {:numbering {source -> :yin.k/cc-n}}, or {:refused {:path\n651\t   :cursor-cells}} when a tie group fails the tie test. The census's pair\n652\t   count is charged first, then the depth scan runs, before anything\n653\t   recursive. Throws the resource refusal, or a defect without\n654\t   :yin.k/status when the numbering is not a bijection onto the census.\"\n655\t  [task budget counter]\n656\t  (let [budget (merge default-budget budget)\n657\t        census (:slots (nth (:slots task) 9))]\n658\t    (spend! counter budget :cursor-cells (quot (count census) 2))\n659\t    (if (empty? census)\n660\t      {:numbering {}}\n661\t      (let [ctx {:task task :budget budget :counter counter :memo (atom {}) :cells-memo (atom {})}\n662\t            _ (depth-scan! ctx task)\n663\t            bodies (into {} (map vec) (partition 2 census))\n664\t            ranks (body-ranks ctx bodies)\n665\t            counts (let [acc (atom {})]\n666\t                     (walk-cells ctx [:ref :task] task #(swap! acc update % (fnil inc 0)))\n667\t                     @acc)\n668\t            run (new-run (assoc ctx :ranks ranks :counts counts) {} :n 1)]\n669\t        (enter-node! run task [])\n670\t        (resolve! run)\n671\t        (if-let [refused @(:refused run)]\n672\t          {:refused refused}\n673\t          (let [numbered (set (keys @(:num run))) declared (set (keys bodies))]\n674\t            (when (or (seq @(:groups run)) (not= numbered declared))\n675\t              (throw (ex-info \"Cursor-cell numbering is not total\"\n676\t                              {:missing (vec (sort-by str (remove numbered declared)))\n677\t                               :extra (vec (sort-by str (remove declared numbered)))})))\n678\t            {:numbering (into {} (map (fn [[c [_ k]]] [c (keyword \"yin.k\" (str \"cc-\" k))])) @(:num run))}))))))\n679\t\n680\t\n681\t(defn- unresolved!\n682\t  [refused prefix]\n683\t  (throw (ex-info \"Row codec refused data\"\n684\t                  {:yin.k/status :yin.k/non-portable :yin.k/kind :unresolved-cursor-cells\n685\t                   :yin.k/path (into prefix (:path refused)) :yin.k/cursor-cells (:cursor-cells refused)})))\n686\t\n687\t\n688\t(defn canonical-numbering\n689\t  \"Discovery-order cursor-cell numbering (design note §1): source cursor\n690\t   cell -> :yin.k/cc-n, the n-th cursor cell the canonical walk meets.\n691\t   Refuses :yin.k/non-portable :unresolved-cursor-cells when tied members of\n692\t   a guest set or map cannot be proved interchangeable. A budget exhaustion\n693\t   is a resource refusal, never a canonicality verdict. counter, when\n694\t   supplied, is the atom the charges accumulate in.\"\n695\t  ([task] (canonical-numbering task default-budget))\n696\t  ([task budget] (canonical-numbering task budget (atom {})))\n697\t  ([task budget counter]\n698\t   (let [r (discovery-numbering task budget counter)]\n699\t     (if-let [refused (:refused r)] (unresolved! refused []) (:numbering r)))))\n700\t\n701\t\n702\t(defn- child-numberer\n703\t  \"Numbers an install child in its own scope under budget; a refusal's path\n704\t   is prefixed by the install's row path [12 <name> ...].\"\n705\t  [budget]\n706\t  (fn [child path]\n707\t    (let [r (discovery-numbering child budget (atom {}))]\n708\t      (if-let [refused (:refused r)] (unresolved! refused path) (:numbering r)))))\n709\t\n710\t\n711\t(defn emit-numbered\n712\t  \"Emit under a supplied numbering. Useful for canonicality probes;\n713\t   ordinary callers use emit, which computes the canonical numbering.\n714\t   number-child, (fn [child path] numbering), numbers install children;\n715\t   by default canonically.\"\n716\t  ([task numbering] (emit-numbered task numbering (child-numberer default-budget)))\n717\t  ([task numbering number-child]\n718\t   (let [[id rows] (emit-node task numbering {} [] number-child)]\n719\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n720\t\n721\t\n722\t(defn emit\n723\t  \"Emit an abstract task as a self-contained carrier. This is a codec,\n724\t   not lift-task: the caller supplies the complete abstract row tree.\"\n725\t  ([task] (emit task default-budget))\n726\t  ([task budget]\n727\t   (let [budget (merge default-budget budget)\n728\t         [id rows] (emit-node task (canonical-numbering task budget) {} [] (child-numberer budget))]\n729\t     {:yin.k/handoff true :yin.k/version 3 :yin.k/root id :yin.k/rows (vec (vals rows))})))\n730\t\n731\t\n732\t(defn- structural?\n733\t  [kind d x]\n734\t  (cond\n735\t    (and (= :cursor-cells kind) (= :C d)) (and (keyword? x) (some? (re-matches census-key (name x))))\n736\t    (or (ref? d) (= :C d)) (keyword? x)\n737\t    (refs? d) (and (vector? x) (every? keyword? x))\n738\t    (contains? #{:V :optional-V} d)\n739\t    (or (and (= :optional-V d) (nil? x))\n740\t        (and (vector? x) (= 2 (count x)) (contains? #{:lit :row :cursor-cell} (first x))\n741\t             (or (= :lit (first x)) (keyword? (second x)))))\n742\t    (= :N d) (and (code/reg? x) (<= x 4503599627370495))\n743\t    (= :S d) (symbol? x)\n744\t    (= :syms d) (and (vector? x) (every? symbol? x))\n745\t    (= :A d) (some? (jing/parse-segment-address x))\n746\t    :else true))\n747\t\n748\t\n749\t(defn- literal?\n750\t  [x]\n751\t  (and (not (cbor/byte-payload? x))\n752\t       (or (nil? x) (boolean? x) (string? x) (keyword? x) (symbol? x)\n753\t           (number? x)\n754\t           (and (coll? x)\n755\t                (every? literal? (if (map? x) (mapcat identity x) x))\n756\t                (or (nil? (meta x)) (literal? (meta x))))\n757\t           (try (some? (cbor/numeric-kind x))\n758\t                (catch #?(:cljd Object :clj Throwable :cljs :default) _e false)))))\n759\t\n760\t\n761\t(def value-row-kinds #{:vec :list :set :map :closure :prim :stream :reified :parked-ref})\n762\t\n763\t\n764\t(defn- check-abstract!\n765\t  [root]\n766\t  (letfn [(literal-value\n767\t            [x]\n768\t            (cond\n769\t              (map? x) [:map (into {} (map (fn [[k v]] [(literal-value k) (literal-value v)])) x)]\n770\t              (set? x) [:set (set (map literal-value x))]\n771\t              (sequential? x) [:seq (mapv literal-value x)]\n772\t              :else [:literal x]))\n773\t          (value\n774\t            [v]\n775\t            (case (first v)\n776\t              :lit (literal-value (second v))\n777\t              :cursor-cell [:identity (second v)]\n778\t              :row (let [n (second v) ss (:slots n)]\n779\t                     (case (:kind n)\n780\t                       :vec [:seq (mapv value ss)]\n781\t                       :list [:seq (mapv value ss)]\n782\t                       :set [:set (set (map value ss))]\n783\t                       :map [:map (into {} (map (fn [[k x]] [(value k) (value x)])) (partition 2 ss))]\n784\t                       [:row n]))))\n785\t          (reference?\n786\t            [v]\n787\t            (case (first v)\n788\t              :cursor-cell true\n789\t              :lit false\n790\t              :row (let [n (second v)]\n791\t                     (if (contains? #{:vec :list :set