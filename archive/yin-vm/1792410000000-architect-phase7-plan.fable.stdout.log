{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017svQW5Z95AvgitVBKHdND1","type":"tool_result","content":"780\t\n781\t\n782\t;; =============================================================================\n783\t;; The export half (r3 1.8 and 1.9; the D9 ruling): mint, prepare,\n784\t;; fence, offer\n785\t;; =============================================================================\n786\t\n787\t;; The candidate loop's reply drain and the release request live below,\n788\t;; with the halves that own them; the export and exit halves step\n789\t;; through both.\n790\t(declare drain-control release-request require-tenure! releasing end-run)\n791\t\n792\t\n793\t(defn- folded-projection\n794\t  \"The arbitration's own fold of the ledger read, or nil when the\n795\t   history is not whole (r3 1.5: complete history or nothing).\"\n796\t  [state]\n797\t  (let [records (read-ledger! state)]\n798\t    (when (some? records)\n799\t      (let [mine-records (vec (mine (:arbitration state) records))\n800\t            defect (history-defect mine-records)]\n801\t        (when (nil? defect)\n802\t          (fold (:arbitration state) mine-records))))))\n803\t\n804\t\n805\t(defn- enrolled-of\n806\t  \"The enrolled target identities of the arbitration's own fold, or nil\n807\t   with the reason the fold could not run.  Unavailable is never an\n808\t   empty enrolled set.\"\n809\t  [state]\n810\t  (let [records (read-ledger! state)]\n811\t    (if (nil? records)\n812\t      [nil :no-arbitration]\n813\t      (let [mine-records (vec (mine (:arbitration state) records))\n814\t            defect (history-defect mine-records)]\n815\t        (cond\n816\t          (some? defect) [nil defect]\n817\t          :else\n818\t          (let [p (fold (:arbitration state) mine-records)]\n819\t            (if (nil? p)\n820\t              [nil :fold-defect]\n821\t              [(set (keys (:targets p))) nil])))))))\n822\t\n823\t\n824\t(defn- export-prepare-step\n825\t  \"Prepare the export of `k`'s cell: serve each stream once, retaining\n826\t   what was served, so a refusal's retry never serves a stream twice.\n827\t   The minted occurrence is already durable in the journal.\"\n828\t  [state k]\n829\t  (when (= :exit k) (require-tenure! state))\n830\t  (let [cell (get state k)\n831\t        r (export/prepare\n832\t            (:m cell) (:record cell)\n833\t            (fn [handle]\n834\t              (let [resource (first (for [[path machine] (machines (:m cell))\n835\t                                          resource-id (sort-by str (keys (:resources machine)))\n836\t                                          :when (= handle (get (:resources machine) resource-id))]\n837\t                                      [path resource-id]))\n838\t                    request-id [:yin.k/serve (:occurrence cell) resource]\n839\t                    journaled? (some? (:occurrence cell))]\n840\t                (when journaled?\n841\t                  (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/serve\n842\t                                   :yin.k/occurrence (:occurrence cell)\n843\t                                   :yin.k/request {:yin.k/request-id request-id\n844\t                                                   :yin.k/resource resource}}))\n845\t                (when (= :exit k) (require-tenure! state))\n846\t                (let [descriptor (serve! state handle)]\n847\t                  (when (and journaled? descriptor)\n848\t                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/serve\n849\t                                     :yin.k/occurrence (:occurrence cell)\n850\t                                     :yin.k/request-id request-id :yin.k/answer descriptor}))\n851\t                  descriptor)))\n852\t            (:header cell))]\n853\t    (if (= :ok (:status r))\n854\t      (-> state\n855\t          (assoc-in [k :record] (:record r))\n856\t          (assoc-in [k :prepared?] true)\n857\t          (with-status :yin.k/ok\n858\t            {:export (:role cell) :step :prepared}))\n859\t      (-> state\n860\t          (assoc-in [k :record] (:record r))\n861\t          (unsatisfied :export-refused\n862\t                       (select-keys r [:yin.k/status :yin.k/reason\n863\t                                       :yin.k/kind :yin.k/path]))))))\n864\t\n865\t\n866\t(defn- export-fence-step\n867\t  \"Freeze the complete record and persist both addressed objects before\n868\t   journaling the fence: the recovery object first, then the body, and a\n869\t   store that refuses stops the step before the next object is\n870\t   attempted. The journal contains canonical progress only; the runtime\n871\t   environment retains composition functions and handles.\"\n872\t  [state k]\n873\t  (when (= :exit k) (require-tenure! state))\n874\t  (let [cell (get state k)\n875\t        e (export/freeze (:m cell) (:record cell))]\n876\t    (if (not= :ok (:status e))\n877\t      (unsatisfied state :export-refused\n878\t                   (select-keys e [:yin.k/status :yin.k/reason\n879\t                                   :yin.k/kind :yin.k/path]))\n880\t      (let [bytes (:body-bytes e)\n881\t            address (:body-address e)\n882\t            record-bytes (:bytes e)\n883\t            record-address (:address e)\n884\t            store-object\n885\t            (fn [[object-address object-bytes]]\n886\t              (let [request-id [:yin.k/store (:occurrence cell) object-address]]\n887\t                (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/store\n888\t                                 :yin.k/occurrence (:occurrence cell)\n889\t                                 :yin.k/request {:yin.k/request-id request-id\n890\t                                                 :yin.k/address object-address}})\n891\t                (when (= :exit k) (require-tenure! state))\n892\t                (let [stored? (store-put! state object-address object-bytes)]\n893\t                  (when stored?\n894\t                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/store\n895\t                                     :yin.k/occurrence (:occurrence cell)\n896\t                                     :yin.k/request-id request-id\n897\t                                     :yin.k/answer {:yin.k/status :stored}}))\n898\t                  stored?)))]\n899\t        (if-not (and (store-object [record-address record-bytes])\n900\t                     (store-object [address bytes]))\n901\t          (unsatisfied state :content-unavailable {:yin.k/address address})\n902\t          (do\n903\t            (journal! state\n904\t                      {:yin.k/journal :yin.k/fenced\n905\t                       :yin.k/occurrence (:occurrence cell)\n906\t                       :yin.k/address address\n907\t                       :yin.k/record record-address})\n908\t            (-> state\n909\t                (assoc-in [k :address] address)\n910\t                (assoc-in [k :record-address] record-address)\n911\t                (assoc-in [k :bytes] bytes)\n912\t                (assoc-in [k :kind] (:kind e))\n913\t                (with-status :yin.k/ok\n914\t                  {:export (:role cell) :step :fenced}))))))))\n915\t\n916\t\n917\t(defn- offer-request\n918\t  [o address medium bytes]\n919\t  {:yin.k/request :yin.k/offer\n920\t   :yin.k/request-id [:yin.k/offer o]\n921\t   :yin.k/id address\n922\t   :yin.k/bytes bytes\n923\t   :yin.k/medium medium})\n924\t\n925\t\n926\t(defn- admitted?\n927\t  [answer]\n928\t  (contains? #{:committed :replayed} (get answer :yin.k/status)))\n929\t\n930\t\n931\t(defn- export-offer-step\n932\t  \"The offer bracket of `k`'s cell: one intent record durable before\n933\t   the bracket's first send, one attempt record after each send\n934\t   carrying the append's outcome, and the acknowledgment once the\n935\t   front's authenticated reply admits the offer.  The request is\n936\t   rebuilt from the cell (the bytes from the store when the cell holds\n937\t   none), so a resend is the identical request.\"\n938\t  [state k]\n939\t  (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n940\t    (require-tenure! state))\n941\t  (let [cell (get state k)\n942\t        o (:occurrence cell)\n943\t        medium (get-in state [:seams :medium])\n944\t        offer (or (:offer cell)\n945\t                  {:request (offer-request o (:address cell) medium\n946\t                                           (or (:bytes cell)\n947\t                                               (store-get state\n948\t                                                          (:address cell))))})]\n949\t    (journal! state\n950\t              {:yin.k/journal :yin.k/intent\n951\t               :yin.k/action :yin.k/offer\n952\t               :yin.k/occurrence o\n953\t               :yin.k/request (dissoc (:request offer) :yin.k/bytes)\n954\t               :yin.k/bytes-at (:address cell)})\n955\t    (let [_ (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n956\t              (require-tenure! state))\n957\t          outcome (append-request! state (:request offer))\n958\t          offer' (assoc offer\n959\t                        :intended? true\n960\t                        :sent (or (:sent offer)\n961\t                                  (= :dao.stream/ok\n962\t                                     (:dao.stream/outcome outcome))))]\n963\t      (journal! state\n964\t                {:yin.k/journal :yin.k/attempt\n965\t                 :yin.k/action :yin.k/offer\n966\t                 :yin.k/occurrence o\n967\t                 :yin.k/append (:dao.stream/outcome outcome)})\n968\t      (-> state\n969\t          (assoc-in [k :offer] offer')\n970\t          (with-status :yin.k/ok\n971\t            {:export (:role cell) :step :offered})))))\n972\t\n973\t\n974\t(defn- offer-done?\n975\t  [cell]\n976\t  (admitted? (get-in cell [:offer :answer])))\n977\t\n978\t\n979\t(defn- source-mint\n980\t  \"The first step of a first exclusive export: enter exporting, mint\n981\t   the occurrence once, and journal it before prepare is ever called\n982\t   (the D9 ruling).  The header is the driver's: the composition's\n983\t   arbitration, next-op-seq 0, no origin, the enrolled set of the\n984\t   ledger fold.\"\n985\t  [state]\n986\t  (let [cell (:export state)\n987\t        e (export/enter (:machine cell) {:version (:export-version state)})]\n988\t    (if (not= :ok (:status e))\n989\t      (failed state e)\n990\t      (let [[enrolled reason] (enrolled-of state)]\n991\t        (if (nil? enrolled)\n992\t          (unsatisfied state reason\n993\t                       {:dao.stream/identity (:arbitration state)})\n994\t          (let [o (custody/mint-occurrence)\n995\t                header {:yin.k/occurrence o\n996\t                        :yin.k/arbitration (:arbitration cell)\n997\t                        :yin.k/next-op-seq 0\n998\t                        :yin.k/enrolled enrolled}]\n999\t            (journal! state\n1000\t                      {:yin.k/journal :yin.k/minted\n1001\t                       :yin.k/role (:role cell)\n1002\t                       :yin.k/occurrence o\n1003\t                       :yin.k/header header})\n1004\t            (-> state\n1005\t                (assoc :export (assoc cell\n1006\t                                      :occurrence o\n1007\t                                      :header header\n1008\t                                      :m (:machine e)\n1009\t                                      :record (:record e)))\n1010\t                (with-status :yin.k/ok\n1011\t                  {:export :yin.k/first :step :minted}))))))))\n1012\t\n1013\t\n1014\t(defn- fork-step\n1015\t  \"The composition's fork decision (a nil arbitration): the version-0\n1016\t   lift over the machine -- enter, prepare under a nil header, encode --\n1017\t   with no occurrence, no offer and no journal bracket.  The answer is\n1018\t   the bytes.\"\n1019\t  [state]\n1020\t  (let [cell (:export state)]\n1021\t    (cond\n1022\t      (nil? (:m cell))\n1023\t      (let [e (export/enter (:machine cell) {:version (:export-version state)})]\n1024\t        (if (= :ok (:status e))\n1025\t          (assoc state :export (assoc cell\n1026\t                                      :m (:machine e)\n1027\t                                      :record (:record e)))\n1028\t          (failed state e)))\n1029\t\n1030\t      (not (:prepared? cell))\n1031\t      (export-prepare-step state :export)\n1032\t\n1033\t      :else\n1034\t      (let [e (export/encode (:m cell) (:record cell))]\n1035\t        (if (= :ok (:status e))\n1036\t          (assoc state\n1037\t                 :phase :lifted\n1038\t                 :status :yin.k/ok\n1039\t                 :detail {:yin.k/kind (:kind e)\n1040\t                          :yin.k/address (:address e)\n1041\t                          :bytes (:bytes e)})\n1042\t          (unsatisfied state :export-refused\n1043\t                       (select-keys e [:yin.k/status :yin.k/reason\n1044\t                                       :yin.k/kind :yin.k/path])))))))\n1045\t\n1046\t\n1047\t(defn- to-candidacy\n1048\t  \"The source becomes a candidate like any other, over its own bytes.\"\n1049\t  [state]\n1050\t  (let [cell (:export state)]\n1051\t    (-> state\n1052\t        (dissoc :export)\n1053\t        (assoc :phase :proposing\n1054\t               :occurrence (:occurrence cell)\n1055\t               :arbitration (get-in cell\n1056\t                                    [:header :yin.k/arbitration\n1057\t                                     :dao.stream/identity])\n1058\t               :kind (:kind cell)\n1059\t               :bytes (:bytes cell)\n1060\t               :address (:address cell))\n1061\t        (with-status :yin.k/awaiting-grant\n1062\t          {:yin.k/occurrence (:occurrence cell)}))))\n1063\t\n1064\t\n1065\t(defn- step-exporting\n1066\t  [state]\n1067\t  (let [state (if (nil? (get-in state [:export :role])) state (drain-control state))\n1068\t        cell (:export state)]\n1069\t    (cond\n1070\t      (:inbox-unavailable? state) state\n1071\t      (nil? (:role cell)) (fork-step state)\n1072\t      (nil? (:occurrence cell)) (source-mint state)\n1073\t      (not (:prepared? cell)) (export-prepare-step state :export)\n1074\t      (nil? (:address cell)) (export-fence-step state :export)\n1075\t      (offer-done? cell) (to-candidacy state)\n1076\t      :else (export-offer-step state :export))))\n1077\t\n1078\t\n1079\t;; ============================================================================="}]},"parent_tool_use_id":null,"session_id":"23e67cb0-f183-4c2e-b3d6-2e5b6c44b814","uuid":"4cfab938-b55d-4bb5-8ada-1bd22bd914d4","timestamp":"2026-10-13T08:33:02.636Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/sto/workspace/datomworld-srvm-p7plan/src/cljc/yin/vm/ucf/holder/driver.cljc","content":"\n\n;; =============================================================================\n;; The export half (r3 1.8 and 1.9; the D9 ruling): mint, prepare,\n;; fence, offer\n;; =============================================================================\n\n;; The candidate loop's reply drain and the release request live below,\n;; with the halves that own them; the export and exit halves step\n;; through both.\n(declare drain-control release-request require-tenure! releasing end-run)\n\n\n(defn- folded-projection\n  \"The arbitration's own fold of the ledger read, or nil when the\n   history is not whole (r3 1.5: complete history or nothing).\"\n  [state]\n  (let [records (read-ledger! state)]\n    (when (some? records)\n      (let [mine-records (vec (mine (:arbitration state) records))\n            defect (history-defect mine-records)]\n        (when (nil? defect)\n          (fold (:arbitration state) mine-records))))))\n\n\n(defn- enrolled-of\n  \"The enrolled target identities of the arbitration's own fold, or nil\n   with the reason the fold could not run.  Unavailable is never an\n   empty enrolled set.\"\n  [state]\n  (let [records (read-ledger! state)]\n    (if (nil? records)\n      [nil :no-arbitration]\n      (let [mine-records (vec (mine (:arbitration state) records))\n            defect (history-defect mine-records)]\n        (cond\n          (some? defect) [nil defect]\n          :else\n          (let [p (fold (:arbitration state) mine-records)]\n            (if (nil? p)\n              [nil :fold-defect]\n              [(set (keys (:targets p))) nil])))))))\n\n\n(defn- export-prepare-step\n  \"Prepare the export of `k`'s cell: serve each stream once, retaining\n   what was served, so a refusal's retry never serves a stream twice.\n   The minted occurrence is already durable in the journal.\"\n  [state k]\n  (when (= :exit k) (require-tenure! state))\n  (let [cell (get state k)\n        r (export/prepare\n            (:m cell) (:record cell)\n            (fn [handle]\n              (let [resource (first (for [[path machine] (machines (:m cell))\n                                          resource-id (sort-by str (keys (:resources machine)))\n                                          :when (= handle (get (:resources machine) resource-id))]\n                                      [path resource-id]))\n                    request-id [:yin.k/serve (:occurrence cell) resource]\n                    journaled? (some? (:occurrence cell))]\n                (when journaled?\n                  (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/serve\n                                   :yin.k/occurrence (:occurrence cell)\n                                   :yin.k/request {:yin.k/request-id request-id\n                                                   :yin.k/resource resource}}))\n                (when (= :exit k) (require-tenure! state))\n                (let [descriptor (serve! state handle)]\n                  (when (and journaled? descriptor)\n                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/serve\n                                     :yin.k/occurrence (:occurrence cell)\n                                     :yin.k/request-id request-id :yin.k/answer descriptor}))\n                  descriptor)))\n            (:header cell))]\n    (if (= :ok (:status r))\n      (-> state\n          (assoc-in [k :record] (:record r))\n          (assoc-in [k :prepared?] true)\n          (with-status :yin.k/ok\n            {:export (:role cell) :step :prepared}))\n      (-> state\n          (assoc-in [k :record] (:record r))\n          (unsatisfied :export-refused\n                       (select-keys r [:yin.k/status :yin.k/reason\n                                       :yin.k/kind :yin.k/path]))))))\n\n\n(defn- export-fence-step\n  \"Freeze the complete record and persist both addressed objects before\n   journaling the fence: the recovery object first, then the body, and a\n   store that refuses stops the step before the next object is\n   attempted. The journal contains canonical progress only; the runtime\n   environment retains composition functions and handles.\"\n  [state k]\n  (when (= :exit k) (require-tenure! state))\n  (let [cell (get state k)\n        e (export/freeze (:m cell) (:record cell))]\n    (if (not= :ok (:status e))\n      (unsatisfied state :export-refused\n                   (select-keys e [:yin.k/status :yin.k/reason\n                                   :yin.k/kind :yin.k/path]))\n      (let [bytes (:body-bytes e)\n            address (:body-address e)\n            record-bytes (:bytes e)\n            record-address (:address e)\n            store-object\n            (fn [[object-address object-bytes]]\n              (let [request-id [:yin.k/store (:occurrence cell) object-address]]\n                (journal! state {:yin.k/journal :yin.k/intent :yin.k/action :yin.k/store\n                                 :yin.k/occurrence (:occurrence cell)\n                                 :yin.k/request {:yin.k/request-id request-id\n                                                 :yin.k/address object-address}})\n                (when (= :exit k) (require-tenure! state))\n                (let [stored? (store-put! state object-address object-bytes)]\n                  (when stored?\n                    (journal! state {:yin.k/journal :yin.k/ack :yin.k/action :yin.k/store\n                                     :yin.k/occurrence (:occurrence cell)\n                                     :yin.k/request-id request-id\n                                     :yin.k/answer {:yin.k/status :stored}}))\n                  stored?)))]\n        (if-not (and (store-object [record-address record-bytes])\n                     (store-object [address bytes]))\n          (unsatisfied state :content-unavailable {:yin.k/address address})\n          (do\n            (journal! state\n                      {:yin.k/journal :yin.k/fenced\n                       :yin.k/occurrence (:occurrence cell)\n                       :yin.k/address address\n                       :yin.k/record record-address})\n            (-> state\n                (assoc-in [k :address] address)\n                (assoc-in [k :record-address] record-address)\n                (assoc-in [k :bytes] bytes)\n                (assoc-in [k :kind] (:kind e))\n                (with-status :yin.k/ok\n                  {:export (:role cell) :step :fenced}))))))))\n\n\n(defn- offer-request\n  [o address medium bytes]\n  {:yin.k/request :yin.k/offer\n   :yin.k/request-id [:yin.k/offer o]\n   :yin.k/id address\n   :yin.k/bytes bytes\n   :yin.k/medium medium})\n\n\n(defn- admitted?\n  [answer]\n  (contains? #{:committed :replayed} (get answer :yin.k/status)))\n\n\n(defn- export-offer-step\n  \"The offer bracket of `k`'s cell: one intent record durable before\n   the bracket's first send, one attempt record after each send\n   carrying the append's outcome, and the acknowledgment once the\n   front's authenticated reply admits the offer.  The request is\n   rebuilt from the cell (the bytes from the store when the cell holds\n   none), so a resend is the identical request.\"\n  [state k]\n  (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n    (require-tenure! state))\n  (let [cell (get state k)\n        o (:occurrence cell)\n        medium (get-in state [:seams :medium])\n        offer (or (:offer cell)\n                  {:request (offer-request o (:address cell) medium\n                                           (or (:bytes cell)\n                                               (store-get state\n                                                          (:address cell))))})]\n    (journal! state\n              {:yin.k/journal :yin.k/intent\n               :yin.k/action :yin.k/offer\n               :yin.k/occurrence o\n               :yin.k/request (dissoc (:request offer) :yin.k/bytes)\n               :yin.k/bytes-at (:address cell)})\n    (let [_ (when (and (= :exit k) (:holder state) (not (get-in state [:release :carried])))\n              (require-tenure! state))\n          outcome (append-request! state (:request offer))\n          offer' (assoc offer\n                        :intended? true\n                        :sent (or (:sent offer)\n                                  (= :dao.stream/ok\n                                     (:dao.stream/outcome outcome))))]\n      (journal! state\n                {:yin.k/journal :yin.k/attempt\n                 :yin.k/action :yin.k/offer\n                 :yin.k/occurrence o\n                 :yin.k/append (:dao.stream/outcome outcome)})\n      (-> state\n          (assoc-in [k :offer] offer')\n          (with-status :yin.k/ok\n            {:export (:role cell) :step :offered})))))\n\n\n(defn- offer-done?\n  [cell]\n  (admitted? (get-in cell [:offer :answer])))\n\n\n(defn- source-mint\n  \"The first step of a first exclusive export: enter exporting, mint\n   the occurrence once, and journal it before prepare is ever called\n   (the D9 ruling).  The header is the driver's: the composition's\n   arbitration, next-op-seq 0, no origin, the enrolled set of the\n   ledger fold.\"\n  [state]\n  (let [cell (:export state)\n        e (export/enter (:machine cell) {:version (:export-version state)})]\n    (if (not= :ok (:status e))\n      (failed state e)\n      (let [[enrolled reason] (enrolled-of state)]\n        (if (nil? enrolled)\n          (unsatisfied state reason\n                       {:dao.stream/identity (:arbitration state)})\n          (let [o (custody/mint-occurrence)\n                header {:yin.k/occurrence o\n                        :yin.k/arbitration (:arbitration cell)\n                        :yin.k/next-op-seq 0\n                        :yin.k/enrolled enrolled}]\n            (journal! state\n                      {:yin.k/journal :yin.k/minted\n                       :yin.k/role (:role cell)\n                       :yin.k/occurrence o\n                       :yin.k/header header})\n            (-> state\n                (assoc :export (assoc cell\n                                      :occurrence o\n                                      :header header\n                                      :m (:machine e)\n                                      :record (:record e)))\n                (with-status :yin.k/ok\n                  {:export :yin.k/first :step :minted}))))))))\n\n\n(defn- fork-step\n  \"The composition's fork decision (a nil arbitration): the version-0\n   lift over the machine -- enter, prepare under a nil header, encode --\n   with no occurrence, no offer and no journal bracket.  The answer is\n   the bytes.\"\n  [state]\n  (let [cell (:export state)]\n    (cond\n      (nil? (:m cell))\n      (let [e (export/enter (:machine cell) {:version (:export-version state)})]\n        (if (= :ok (:status e))\n          (assoc state :export (assoc cell\n                                      :m (:machine e)\n                                      :record (:record e)))\n          (failed state e)))\n\n      (not (:prepared? cell))\n      (export-prepare-step state :export)\n\n      :else\n      (let [e (export/encode (:m cell) (:record cell))]\n        (if (= :ok (:status e))\n          (assoc state\n                 :phase :lifted\n                 :status :yin.k/ok\n                 :detail {:yin.k/kind (:kind e)\n                          :yin.k/address (:address e)\n                          :bytes (:bytes e)})\n          (unsatisfied state :export-refused\n                       (select-keys e [:yin.k/status :yin.k/reason\n                                       :yin.k/kind :yin.k/path])))))))\n\n\n(defn- to-candidacy\n  \"The source becomes a candidate like any other, over its own bytes.\"\n  [state]\n  (let [cell (:export state)]\n    (-> state\n        (dissoc :export)\n        (assoc :phase :proposing\n               :occurrence (:occurrence cell)\n               :arbitration (get-in cell\n                                    [:header :yin.k/arbitration\n                                     :dao.stream/identity])\n               :kind (:kind cell)\n               :bytes (:bytes cell)\n               :address (:address cell))\n        (with-status :yin.k/awaiting-grant\n          {:yin.k/occurrence (:occurrence cell)}))))\n\n\n(defn- step-exporting\n  [state]\n  (let [state (if (nil? (get-in state [:export :role])) state (drain-control state))\n        cell (:export state)]\n    (cond\n      (:inbox-unavailable? state) state\n      (nil? (:role cell)) (fork-step state)\n      (nil? (:occurrence cell)) (source-mint state)\n      (not (:prepared? cell)) (export-prepare-step state :export)\n      (nil? (:address cell)) (export-fence-step state :export)\n      (offer-done? cell) (to-candidacy state)\n      :else (export-offer-step state :export))))\n\n\n;; =============================================================================","numLines":300,"startLine":780,"totalLines":2918}},"tool_result_meta":[{"id":"toolu_017svQW5Z95AvgitVBKHdND1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
